import std.sys as sys
import std.parse as parse
import cpu_worker as kernel
fn worker(request:kernel.Request)->kernel.Result { kernel.run(request) }
fn show(result:kernel.Result) { print(result.checksum);print(result.last) }
fn request(job:i32,steps:i32)->kernel.Request { kernel.Request{seed:1729+i64(job)*7919,steps:steps} }
fn main() {
    capacity:=i32(parse.integer(sys.arg(1)).value);steps:=i32(parse.integer(sys.arg(2)).value)
    assert(capacity>=1&&capacity<=4&&steps>=0&&steps<=8000000)
    task scope jobs(capacity) {
        for batch in 0..8 {
            a:=spawn jobs worker(request(batch*4,steps))
            b:=spawn jobs worker(request(batch*4+1,steps))
            c:=spawn jobs worker(request(batch*4+2,steps))
            d:=spawn jobs worker(request(batch*4+3,steps))
            ra:=await jobs(a);rb:=await jobs(b);rc:=await jobs(c);rd:=await jobs(d)
            show(ra);show(rb);show(rc);show(rd)
        }
    }
}
