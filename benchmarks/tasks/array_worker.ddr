// The task boundary and ordinary value copies clone a flat primitive array.
pub struct Request { values:[]i64, passes:i32, job:i64 }
pub struct Result { checksum:i64, first:i64, last:i64 }
pub fn run(request:Request)->Result {
    var values:=request.values
    for cycle in 0..request.passes {
        for i in 0..values.len {
            values[i]=(values[i]*48271+request.job+i64(cycle))%2147483647
        }
    }
    var checksum:i64=0
    for i in 0..values.len { checksum=checksum+values[i]*i64(i+1) }
    var first:i64=0;var last:i64=0
    if values.len>0 {first=values[0];last=values[values.len-1]}
    Result{checksum:checksum,first:first,last:last}
}
