// Ordinary source: also compiled by the serial pre-task compiler for checking.
pub struct Request { seed:i64, steps:i32 }
pub struct Result { checksum:i64, last:i64 }
pub fn run(request:Request)->Result {
    var value:=request.seed;var checksum:i64=0
    for i in 0..request.steps {
        value=(value*1664525+1013904223)%2147483647
        checksum=checksum+value
    }
    Result{checksum:checksum,last:value}
}
