import std.sys as sys
import std.parse as parse
import array_worker as kernel
fn worker(request:kernel.Request)->kernel.Result { kernel.run(request) }
fn show(result:kernel.Result) {print(result.checksum);print(result.first);print(result.last)}
fn request(values:[]i64,passes:i32,job:i32)->kernel.Request {
    kernel.Request{values:values,passes:passes,job:i64(job)}
}
fn main() {
    capacity:=i32(parse.integer(sys.arg(1)).value);passes:=i32(parse.integer(sys.arg(2)).value)
    length:=i32(parse.integer(sys.arg(3)).value)
    assert(capacity>=1&&capacity<=4&&passes>=0&&passes<=8192&&length>=0&&length<=4096)
    var values:[]i64=[];for i in 0..length{values.push((i64(i)*17+1729)%1009)}
    task scope jobs(capacity) {
        for batch in 0..8 {
            a:=spawn jobs worker(request(values,passes,batch*4))
            b:=spawn jobs worker(request(values,passes,batch*4+1))
            c:=spawn jobs worker(request(values,passes,batch*4+2))
            d:=spawn jobs worker(request(values,passes,batch*4+3))
            ra:=await jobs(a);rb:=await jobs(b);rc:=await jobs(c);rd:=await jobs(d)
            show(ra);show(rb);show(rc);show(rd)
        }
    }
    var checksum:i64=0;for i in 0..values.len{checksum=checksum+values[i]*i64(i+1)}
    print(checksum)
    if values.len>0{print(values[0]);print(values[values.len-1])}else{print(0);print(0)}
}
