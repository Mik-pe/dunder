// A separate trusted ABI premise, not a register-liveness, NoModRef or terminal
// declaration. Raw MIR has no such promise. Under source ABI version1:
// - calls obey the declared source/native ABI; X25..28 are preserved hidden
//   state, never semantic arguments or observable scratch inputs;
// - the caller's private frame reservation/padding and exact incoming call SP
//   are implementation-private. Valid arguments, stack arguments and escaped
//   source objects must retain their ordinary values and observable behavior.
// This grants NO NoModRef premise for original frame cells, no preservation of
// X0..24 or flags, and no exemption from synchronization around ANY call.
// A raw callee observing call SP or incoming X25, or permanently clobbering
// X25..28, does not satisfy this contract. A complete trusted source producer
// must prove ABI-conforming callees/bridges before constructing version1.
// Frame lifetime is an INDEPENDENT promise. After each normal call return,
// the same caller activation has the same FP/SP and its original active
// ordinary frame byte ranges remain mapped, accessible and nonvolatile.
// Callees may still read/write their contents: this is not NoModRef, not an
// initialization proof, and not an exemption from register/flag clobbers.
// A consumer must separately prove a full initialized cell and valid frame
// lifetime at the actual insertion point before synthesizing a nontrapping
// read. Raw stack switching, unmapping, returns-twice and changed FP/SP do
// not satisfy this promise. Frame-only callers may observe exact incoming SP
// or frame contents; no hidden-register/private-call-SP premise is inferred.
pub opaque struct Context { source: bool, frame: bool }
pub fn conservative() -> Context { Context { source: false, frame: false } }
pub fn trusted_source_abi_v1() -> Context { Context { source: true, frame: false } }
pub fn trusted_frame_lifetime_v1() -> Context { Context { source: false, frame: true } }
pub fn trusted_source_frame_abi_v2() -> Context { Context { source: true, frame: true } }
pub fn for_source_producer(enabled: bool) -> Context {
    if enabled { return trusted_source_frame_abi_v2() }; conservative()
}
pub fn source_abi(ctx: &Context) -> bool { ctx.source }
pub fn preserves_source_frame(ctx: &Context) -> bool { ctx.frame }
pub fn policy_tag(ctx: &Context) -> string {
    if ctx.source && ctx.frame { return "mir-call-abi:source-v2" }
    if ctx.source { return "mir-call-abi:source-v1" }
    if ctx.frame { return "mir-call-abi:frame-v1" }
    "mir-call-abi:raw-v1"
}
