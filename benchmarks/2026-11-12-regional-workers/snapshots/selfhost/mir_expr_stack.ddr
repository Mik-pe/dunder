// Private expression-stack values, independent of source spelling or target.
// A persistent LIFO graph gives one node to each actual Push. CFG joins unify
// values at equal stack depth; below links make those webs flow through loops
// without block*depth matrices or an adjacent-instruction matching heuristic.
// All placement uses exact physical liveness and interfering live stack webs.
import mir
import mir_contract as contract
import mir_liveness as live
import mir_call_inputs as inputs
import mir_terminals as terminals
import mir_verify as verify

pub opaque struct Context { version: i32 }
pub fn conservative() -> Context { Context { version: 0 } }
// TRUSTED COMPLETE PRODUCER CONTRACT, expression-storage version1:
// stack_roles=1 identifies implementation-only expression storage, never
// outgoing arguments, bridge state, saved FP/LR or source-addressable memory.
// Its entire16-byte unit is private; no pointer/alias or later observer can
// read either the value or padding after its logical lifetime. Eliding this
// implementation storage and its own allocation/guard/OOB resource faults is
// permitted. This is NOT a proof that arbitrary raw stack accesses cannot
// trap. Explicit arithmetic/index/access/capacity checks in OTHER operations
// remain ordered and unchanged. Origin alone, source_objects, a call ABI or
// NoReturn never grants this independent storage-elision right.
pub fn trusted_source_expression_storage_v1() -> Context { Context { version: 1 } }
pub fn policy_tag() -> string { "mir-expression-stack:temp1-storage1-lifo-webs1" }

pub opaque struct Workspace {
    verifier: verify.Workspace,
    nodes: []i32, is_push: []bool, roots: []i32, below: []i32, levels: []i32,
    before: []i32, after: []i32, groups: []i32, group_roots: []i32, scores: []i32,
    top: []i32, depths: []i32, queue: []i32,
    overlap_a: []i32, overlap_b: []i32, edge_heads: []i32, edge_next: []i32, neighbors: []i32,
    forbidden: []i64, blocked: []bool, used: []bool, homes: []i32,
    edits: []i32, edit_dst: []i32, edit_src: []i32,
    undo_modes: []i32, undo_recipes: []i32, undo_roles: []i32, undo_rows: []i64,
    state: i32, work: i32, limit: i32, peak: i32, physical_next: i32,
    placed: i32, pushes: i32, pops: i32, moves: i32,
}
pub fn new() -> Workspace { Workspace {
    verifier: verify.new_work(), nodes: [], is_push: [], roots: [], below: [], levels: [],
    before: [], after: [], groups: [], group_roots: [], scores: [],
    top: [], depths: [], queue: [], overlap_a: [], overlap_b: [], edge_heads: [], edge_next: [], neighbors: [],
    forbidden: [], blocked: [], used: [], homes: [], edits: [], edit_dst: [], edit_src: [],
    undo_modes: [], undo_recipes: [], undo_roles: [], undo_rows: [],
    state: 0, work: 0, limit: 0, peak: 0, physical_next: 0, placed: 0, pushes: 0, pops: 0, moves: 0 } }
pub fn status(w: &Workspace) -> i32 { w.state }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn peak_depth(w: &Workspace) -> i32 { w.peak }
pub fn placed(w: &Workspace) -> i32 { if w.state == 2 { w.placed } else { 0 } }
pub fn removed_pushes(w: &Workspace) -> i32 { if w.state == 2 { w.pushes } else { 0 } }
pub fn removed_pops(w: &Workspace) -> i32 { if w.state == 2 { w.pops } else { 0 } }
pub fn copies(w: &Workspace) -> i32 { if w.state == 2 { w.moves } else { 0 } }
fn ready(w: &Workspace) -> bool { w.state == 1 || w.state == 2 }
pub fn group_count(w: &Workspace) -> i32 { if ready(&w) { w.group_roots.len } else { 0 } }
fn op_group(w: &Workspace, op: i32) -> i32 {
    if !ready(&w) || op < 0 || op >= w.nodes.len || w.nodes[op] < 0 { return -1 }
    w.groups[w.roots[w.nodes[op]]]
}
pub fn push_group(w: &Workspace, op: i32) -> i32 {
    if op < 0 || op >= w.is_push.len || !w.is_push[op] { return -1 }; op_group(&w, op)
}
pub fn pop_group(w: &Workspace, op: i32) -> i32 {
    if op < 0 || op >= w.is_push.len || w.is_push[op] { return -1 }; op_group(&w, op)
}
pub fn allowed_mask(w: &Workspace, group: i32) -> i64 {
    if !ready(&w) || group < 0 || group >= w.group_roots.len { return 0 }
    i64(262143).bit_and(w.forbidden[w.group_roots[group]].bit_not())
}
// Static accesses removed, weighted32 in actual CFG loops. No benefit is
// credited for a blocked web; allocation/copy cost remains coordinator policy.
pub fn score(w: &Workspace, group: i32) -> i32 {
    if !ready(&w) || group < 0 || group >= w.group_roots.len { return 0 }; w.scores[w.group_roots[group]]
}
pub fn conflict_count(w: &Workspace) -> i32 { if ready(&w) { w.overlap_a.len } else { 0 } }
pub fn conflict_left(w: &Workspace, edge: i32) -> i32 {
    if !ready(&w) || edge < 0 || edge >= w.overlap_a.len { return -1 }; w.overlap_a[edge]
}
pub fn conflict_right(w: &Workspace, edge: i32) -> i32 {
    if !ready(&w) || edge < 0 || edge >= w.overlap_b.len { return -1 }; w.overlap_b[edge]
}
pub fn before_head(w: &Workspace, op: i32) -> i32 {
    if !ready(&w) || op < 0 || op >= w.before.len || w.before[op] < 0 { return -1 }; w.roots[w.before[op]]
}
pub fn after_head(w: &Workspace, op: i32) -> i32 {
    if !ready(&w) || op < 0 || op >= w.after.len || w.after[op] < 0 { return -1 }; w.roots[w.after[op]]
}
pub fn head_group(w: &Workspace, node: i32) -> i32 {
    if !ready(&w) || node < 0 || node >= w.roots.len { return -1 }; w.groups[w.roots[node]]
}
pub fn head_below(w: &Workspace, node: i32) -> i32 {
    if !ready(&w) || node < 0 || node >= w.roots.len { return -1 }
    below := w.below[w.roots[node]]; if below < 0 { return -1 }; w.roots[below]
}
fn charge(w: &mut Workspace, amount: i32) -> bool {
    if amount < 0 || amount > w.limit - w.work { w.state = -3; return false }
    w.work = w.work + amount; true
}
fn reset(w: &mut Workspace, limit: i32) {
    w.nodes.clear(); w.is_push.clear(); w.roots.clear(); w.below.clear(); w.levels.clear()
    w.before.clear(); w.after.clear(); w.groups.clear(); w.group_roots.clear(); w.scores.clear()
    w.top.clear(); w.depths.clear(); w.queue.clear(); w.overlap_a.clear(); w.overlap_b.clear()
    w.edge_heads.clear(); w.edge_next.clear(); w.neighbors.clear()
    w.forbidden.clear(); w.blocked.clear(); w.used.clear(); w.homes.clear()
    w.edits.clear(); w.edit_dst.clear(); w.edit_src.clear()
    w.undo_modes.clear(); w.undo_recipes.clear(); w.undo_roles.clear(); w.undo_rows.clear()
    w.state = 0; w.work = 0; w.limit = limit; w.peak = 0; w.physical_next = 0
    w.placed = 0; w.pushes = 0; w.pops = 0; w.moves = 0
}
fn root(w: &mut Workspace, node: i32) -> i32 {
    if node < 0 || node >= w.roots.len { w.state = -1; return -1 }
    var result := node
    while true {
        if !charge(&mut w, 1) { return -1 }
        parent := w.roots[result]; if parent == result { break }
        if parent < 0 || parent >= result { w.state = -1; return -1 }
        result = parent
    }
    w.roots[node] = result; result
}
fn join(w: &mut Workspace, left: i32, right: i32, depth: i32) -> bool {
    var a := left; var b := right; var remaining := depth
    while remaining > 0 {
        x := root(&mut w, a); y := root(&mut w, b); if w.state < 0 { return false }
        if w.levels[x] != remaining || w.levels[y] != remaining { w.state = -1; return false }
        if x == y { return true }
        a = w.below[x]; b = w.below[y]
        if x < y { w.roots[y] = x } else { w.roots[x] = y }
        remaining = remaining - 1
    }
    if a != -1 || b != -1 { w.state = -1; return false }; true
}
fn reset_sp(f: &mir.Function, op: i32) -> bool {
    f.kinds[op] == 16 && f.opcodes[op] == 1 && f.dst[op] == 31 && f.a[op] == 29 && f.imm[op] == 0
}
fn last(f: &mir.Function, block: i32) -> i32 {
    var position := f.block_ends[block]
    while position > f.block_starts[block] {
        position = position - 1; op := f.order[position]; if f.modes[op] != 2 { return op }
    }; -1
}
fn initialize(w: &mut Workspace, f: &mir.Function) -> bool {
    if !charge(&mut w, f.kinds.len * 5 + f.block_starts.len * 2) { return false }
    for op in 0..f.kinds.len {
        w.nodes.push(-1); w.is_push.push(f.kinds[op] == 10); w.before.push(-1); w.after.push(-1)
        if f.modes[op] != 2 && f.kinds[op] == 10 {
            node := w.roots.len; w.nodes[op] = node
            w.roots.push(node); w.below.push(-2); w.levels.push(0)
            w.forbidden.push(0); w.blocked.push(false); w.used.push(false); w.homes.push(-1); w.edge_heads.push(-1)
            w.groups.push(-1); w.scores.push(0)
        }
    }
    for block in 0..f.block_starts.len { w.top.push(-2); w.depths.push(-1) }; true
}
fn lifo(w: &mut Workspace, f: &mir.Function, exits: &terminals.TerminalContext) -> bool {
    if f.block_starts.len == 0 { return true }
    w.top[0] = -1; w.depths[0] = 0; w.queue.push(0); var next := 0
    while next < w.queue.len {
        block := w.queue[next]; next = next + 1
        var top := w.top[block]; var depth := w.depths[block]
        for position in f.block_starts[block]..f.block_ends[block] {
            if !charge(&mut w, 1) { return false }
            op := f.order[position]; if f.modes[op] == 2 { continue }
            if f.kinds[op] == 10 {
                node := w.nodes[op]; w.below[node] = top; w.levels[node] = depth + 1
                var prefix := top
                while prefix >= 0 {
                    other := root(&mut w, prefix); if w.state < 0 { return false }
                    if !charge(&mut w, 1) { return false }
                    w.overlap_a.push(node); w.overlap_b.push(other); prefix = w.below[other]
                }
                top = node; depth = depth + 1; if depth > w.peak { w.peak = depth }
            } else if f.kinds[op] == 11 {
                if depth == 0 { w.state = -1; return false }
                node := root(&mut w, top); if w.state < 0 { return false }
                w.nodes[op] = node; top = w.below[node]; depth = depth - 1
            } else if reset_sp(&f, op) { top = -1; depth = 0 }
        }
        if !charge(&mut w, f.edge_starts[block + 1] - f.edge_starts[block]) { return false }
        for edge in f.edge_starts[block]..f.edge_starts[block + 1] {
            target := f.edge_to[edge]
            if target < 0 {
                kind := f.edge_kinds[edge]; op := last(&f, block)
                // Even a later observer at depth0 can see a scratch changed by
                // an earlier closed interval. Do not mistake NoReturn for the
                // exact unobserving terminal contract.
                if kind != 3 && !(kind == 2 && op >= 0 && terminals.allows(&exits, f.targets[op])) {
                    w.state = -2; return false
                }
            } else if w.depths[target] < 0 {
                w.depths[target] = depth; w.top[target] = top; w.queue.push(target)
            } else {
                if w.depths[target] != depth { w.state = -1; return false }
                if !join(&mut w, w.top[target], top, depth) { return false }
            }
        }
    }; true
}
fn forbid(w: &mut Workspace, top: i32, mask: i64, block: bool) -> bool {
    var at := top
    while at >= 0 {
        node := root(&mut w, at); if w.state < 0 { return false }
        w.forbidden[node] = w.forbidden[node].bit_or(mask)
        if block { w.blocked[node] = true }; at = w.below[node]
    }; true
}
fn barrier(f: &mir.Function, op: i32, frame_live: bool) -> bool {
    kind := f.kinds[op]
    if kind == 14 || kind == 0 || f.effects[op].bit_and(128) != 0 { return true }
    if f.reads[op].bit_or(f.writes[op]).bit_or(f.clobbers[op]).bit_and(mir.variable_bit(31)) != 0 { return true }
    if f.effects[op].bit_and(6) != 0 {
        return !frame_live || (kind != 7 && kind != 8) || !contract.frame_place_proven(&f, f.place[op])
    }
    false
}
fn masks(w: &mut Workspace, f: &mir.Function) -> bool {
    if !charge(&mut w, f.order.len) { return false }
    frame_live := !contract.frame_lifetime_unproven(&f)
    for block in 0..f.block_starts.len {
        if w.depths[block] < 0 { continue }; var top := w.top[block]
        for position in f.block_starts[block]..f.block_ends[block] {
            op := f.order[position]; w.before[op] = top; w.after[op] = top
            if f.modes[op] == 2 { continue }
            mask := f.reads[op].bit_or(f.writes[op]).bit_or(f.clobbers[op])
            if f.kinds[op] == 10 {
                unknown := f.stack_roles[op] != 1 || f.a[op] == 29 || f.a[op] == 30
                if !forbid(&mut w, top, mask, unknown) { return false }
                node := root(&mut w, w.nodes[op]); if w.state < 0 { return false }
                if unknown { w.blocked[node] = true }
                w.scores[node] = w.scores[node] + 1
                top = node
            } else if f.kinds[op] == 11 {
                node := root(&mut w, top); if w.state < 0 { return false }
                unknown := f.stack_roles[op] != 1 || f.dst[op] == 29 || f.dst[op] == 30
                if unknown && !forbid(&mut w, top, 0, true) { return false }
                w.used[node] = true; w.scores[node] = w.scores[node] + 1; top = w.below[node]
                if !forbid(&mut w, top, mask, false) { return false }
            } else {
                if !forbid(&mut w, top, mask, barrier(&f, op, frame_live)) { return false }
                if reset_sp(&f, op) { top = -1 }
            }
            w.after[op] = top
        }
        // A raw direct RET may carry an unconsumed stack. It is not a balanced
        // private lifetime even if another path pops that web.
        for edge in f.edge_starts[block]..f.edge_starts[block + 1] {
            if f.edge_kinds[edge] == 3 && !forbid(&mut w, top, 0, true) { return false }
        }
    }; true
}
fn publish(w: &mut Workspace) -> bool {
    // Flatten EVERY parent before exposing immutable O(1) facts. Below/head
    // references may retain a member ID; getters resolve one compressed hop.
    for node in 0..w.roots.len {
        compressed := root(&mut w, node); if w.state < 0 { return false }; w.roots[node] = compressed
    }
    for node in 0..w.roots.len {
        if !charge(&mut w, 1) { return false }
        if w.roots[node] == node && !w.blocked[node] && w.used[node] {
            w.groups[node] = w.group_roots.len; w.group_roots.push(node)
        }
    }
    var kept := 0
    for edge in 0..w.overlap_a.len {
        if !charge(&mut w, 1) { return false }
        a := w.roots[w.overlap_a[edge]]; b := w.roots[w.overlap_b[edge]]
        if a == b { w.state = -1; return false }
        left := w.groups[a]; right := w.groups[b]
        if left >= 0 && right >= 0 {
            w.overlap_a[kept] = left; w.overlap_b[kept] = right; kept = kept + 1
        }
    }
    while w.overlap_a.len > kept { removed := w.overlap_a.pop(); other := w.overlap_b.pop() }
    w.state = 1; true
}
fn connect(w: &mut Workspace, a: i32, b: i32) {
    edge := w.neighbors.len; w.neighbors.push(b); w.edge_next.push(w.edge_heads[a]); w.edge_heads[a] = edge
}
fn allocate(w: &mut Workspace) -> bool {
    for edge in 0..w.overlap_a.len {
        a := w.group_roots[w.overlap_a[edge]]; b := w.group_roots[w.overlap_b[edge]]
        if !charge(&mut w, 2) { return false }; connect(&mut w, a, b); connect(&mut w, b, a)
    }
    for node in 0..w.roots.len {
        if w.roots[node] != node || w.blocked[node] || !w.used[node] { continue }
        var mask := w.forbidden[node]; var edge := w.edge_heads[node]
        while edge >= 0 {
            if !charge(&mut w, 1) { return false }
            mask = mask.bit_or(mir.variable_bit(w.homes[w.neighbors[edge]])); edge = w.edge_next[edge]
        }
        // Only caller-save GP0..17. No new use of18, globals19..24,
        // callee-save25..28, FP/LR/SP or the conservative FP register bank.
        for offset in 0..18 {
            if !charge(&mut w, 1) { return false }
            reg := (offset + 9) % 18
            if mask.bit_and(mir.variable_bit(reg)) == 0 { w.homes[node] = reg; w.placed = w.placed + 1; break }
        }
    }; true
}
fn plan(w: &mut Workspace, f: &mir.Function) -> bool {
    if !charge(&mut w, f.order.len) { return false }
    for position in 0..f.order.len {
        op := f.order[position]
        if f.modes[op] == 2 || (f.kinds[op] != 10 && f.kinds[op] != 11) || w.nodes[op] < 0 { continue }
        node := root(&mut w, w.nodes[op]); if w.state < 0 { return false }
        home := w.homes[node]; if home < 0 { continue }
        var dst := home; var src := f.a[op]
        if f.kinds[op] == 10 { w.pushes = w.pushes + 1 }
        else { dst = f.dst[op]; src = home; w.pops = w.pops + 1 }
        w.edits.push(op); w.edit_dst.push(dst); w.edit_src.push(src)
        if dst >= 0 && dst != src { w.moves = w.moves + 1 }
    }; true
}
fn remember(w: &mut Workspace, f: &mir.Function, op: i32) {
    w.undo_modes.push(f.modes[op]); w.undo_recipes.push(f.recipes[op]); w.undo_roles.push(f.stack_roles[op])
    w.undo_rows.push(i64(f.kinds[op])); w.undo_rows.push(i64(f.opcodes[op]))
    w.undo_rows.push(i64(f.dst[op])); w.undo_rows.push(i64(f.a[op])); w.undo_rows.push(i64(f.b[op])); w.undo_rows.push(i64(f.c[op]))
    w.undo_rows.push(f.imm[op]); w.undo_rows.push(i64(f.aux[op])); w.undo_rows.push(i64(f.types[op]))
    w.undo_rows.push(i64(f.place[op])); w.undo_rows.push(i64(f.extensions[op])); w.undo_rows.push(i64(f.effects[op]))
    w.undo_rows.push(i64(f.flags[op])); w.undo_rows.push(i64(f.abi[op])); w.undo_rows.push(f.reads[op])
    w.undo_rows.push(f.writes[op]); w.undo_rows.push(f.clobbers[op]); w.undo_rows.push(i64(f.targets[op]))
    w.undo_rows.push(i64(f.reloc_kinds[op])); w.undo_rows.push(i64(f.import_ids[op]))
}
fn copy(f: &mut mir.Function, op: i32, dst: i32, src: i32) {
    f.kinds[op] = 2; f.opcodes[op] = 0; f.dst[op] = dst; f.a[op] = src; f.b[op] = -1; f.c[op] = -1
    f.imm[op] = 0; f.aux[op] = 0; f.types[op] = 2; f.place[op] = -1; f.extensions[op] = 0
    f.effects[op] = 0; f.flags[op] = 0; f.abi[op] = 0; f.reads[op] = mir.variable_bit(src)
    f.writes[op] = mir.variable_bit(dst); f.clobbers[op] = 0
    f.targets[op] = -1; f.reloc_kinds[op] = -1; f.import_ids[op] = -1
    f.recipes[op] = 0; f.stack_roles[op] = 0; f.modes[op] = 1
}
fn rollback(w: &Workspace, f: &mut mir.Function) {
    for at in 0..w.undo_modes.len {
        op := w.edits[at]; row := at * 20
        f.modes[op] = w.undo_modes[at]; f.recipes[op] = w.undo_recipes[at]; f.stack_roles[op] = w.undo_roles[at]
        f.kinds[op] = i32(w.undo_rows[row]); f.opcodes[op] = i32(w.undo_rows[row + 1])
        f.dst[op] = i32(w.undo_rows[row + 2]); f.a[op] = i32(w.undo_rows[row + 3]); f.b[op] = i32(w.undo_rows[row + 4]); f.c[op] = i32(w.undo_rows[row + 5])
        f.imm[op] = w.undo_rows[row + 6]; f.aux[op] = i32(w.undo_rows[row + 7]); f.types[op] = i32(w.undo_rows[row + 8])
        f.place[op] = i32(w.undo_rows[row + 9]); f.extensions[op] = i32(w.undo_rows[row + 10]); f.effects[op] = i32(w.undo_rows[row + 11])
        f.flags[op] = i32(w.undo_rows[row + 12]); f.abi[op] = i32(w.undo_rows[row + 13]); f.reads[op] = w.undo_rows[row + 14]
        f.writes[op] = w.undo_rows[row + 15]; f.clobbers[op] = w.undo_rows[row + 16]; f.targets[op] = i32(w.undo_rows[row + 17])
        f.reloc_kinds[op] = i32(w.undo_rows[row + 18]); f.import_ids[op] = i32(w.undo_rows[row + 19])
    }
    f.verified = true; f.optimizable = true
}
// READ-ONLY STAGED FACTS. Caller holds the exclusive Function transaction and
// has fresh physical liveness for this SAME verified snapshot, including its
// independent call-input premise. No Function mutation may occur until these
// facts have been consumed. This trusted compiler API does not authenticate
// stale or fabricated physical facts. It owns no Function/liveness references.
//
// begin builds structural/LIFO facts only; state3 hides ALL published getters.
// Feed exactly opID0..N-1, including deleted/unreachable operations, using
// fresh scalar live-after masks and actual CFG loop membership. Then finish
// publishes immutable state1, or0 when there is no eligible web. This seam
// lets a coordinator read its physical field into scalar locals BEFORE
// mutably borrowing its expression field, without relaxed root borrowing,
// physical arena clones or an additional liveness analysis.
//
// One limit spans begin/feed/finish; only expression work is charged here.
// Caller accounts the shared physical analysis separately. All failures hide
// mappings and leave Function unchanged: -1internal,-2unsupported,-3budget.
pub fn begin_analysis_budget(w: &mut Workspace, f: &mir.Function,
    context: &Context, exits: &terminals.TerminalContext, limit: i32) -> bool {
    reset(&mut w, limit)
    if !f.valid || !f.verified || f.stack_roles.len != f.kinds.len || !terminals.valid(&exits) {
        w.state = -1; return false
    }
    if context.version != 1 || !f.optimizable || f.unknown_control { w.state = -2; return false }
    if limit < 0 || f.kinds.len > 65536 || f.block_starts.len > 16384 || f.edge_to.len > 32768 { w.state = -3; return false }
    if !initialize(&mut w, &f) { return false }; if w.roots.len == 0 { return false }
    if !lifo(&mut w, &f, &exits) || !masks(&mut w, &f) { return false }
    w.state = 3; true
}
pub fn feed_physical(w: &mut Workspace, op: i32, live_after: i64, loop: bool) -> bool {
    if w.state < 0 { return false }
    if w.state != 3 || op != w.physical_next || op < 0 || op >= w.nodes.len { w.state = -1; return false }
    if !charge(&mut w, 1) { return false }
    w.physical_next = w.physical_next + 1
    if w.nodes[op] < 0 { return true }
    node := root(&mut w, w.nodes[op]); if w.state < 0 { return false }
    // A registered but unreachable Push has no structural lifetime. Its
    // physical row must be fed for ordering, but contributes no facts/score.
    if w.levels[node] == 0 { return true }
    if w.is_push[op] { w.forbidden[node] = w.forbidden[node].bit_or(live_after) }
    if loop { w.scores[node] = w.scores[node] + 31 }; true
}
pub fn finish_analysis(w: &mut Workspace) -> bool {
    if w.state < 0 { return false }
    if w.state != 3 || w.physical_next != w.nodes.len { w.state = -1; return false }
    if !publish(&mut w) { return false }
    if w.group_roots.len == 0 { w.state = 0; return false }; true
}
// Convenience wrapper over exactly the staged contract above. Independent
// roots may borrow Workspace and physical together; same-root coordinators
// use begin/feed/finish with scalar locals instead. No second analysis/copy.
pub fn analyze_with_liveness_budget(w: &mut Workspace, f: &mir.Function,
    context: &Context, exits: &terminals.TerminalContext, physical: &live.Workspace, limit: i32) -> bool {
    if live.status(&physical) != 1 { reset(&mut w, limit); w.state = -1; return false }
    if !begin_analysis_budget(&mut w, &f, &context, &exits, limit) { return false }
    for op in 0..f.kinds.len {
        after := live.live_after(&physical, op); loop := live.loop_block(&physical, f.op_blocks[op])
        if !feed_physical(&mut w, op, after, loop) { return false }
    }
    finish_analysis(&mut w)
}
// Exclusive standalone allocator/transaction for correctness probes. Production
// should consume read-only facts above in its shared Frame+Expr allocator.
// status2 committed,0 no placement,-1 internal,-2 unsupported,-3 budget.
pub fn optimize_with_liveness_budget(w: &mut Workspace, f: &mut mir.Function,
    context: &Context, exits: &terminals.TerminalContext, physical: &live.Workspace, limit: i32) -> bool {
    if !analyze_with_liveness_budget(&mut w, &f, &context, &exits, &physical, limit) { return false }
    if !allocate(&mut w) || !plan(&mut w, &f) { return false }
    if w.edits.len == 0 { w.state = 0; return false }
    // Charge sparse undo and mandatory full verification BEFORE first mutation.
    if !charge(&mut w, w.edits.len * 24 + f.kinds.len * 8 + f.raw.len + f.edge_to.len * 2 + f.block_starts.len * 4) { return false }
    for at in 0..w.edits.len {
        op := w.edits[at]; remember(&mut w, &f, op)
        dst := w.edit_dst[at]; src := w.edit_src[at]
        if dst < 0 { copy(&mut f, op, 0, -1); f.modes[op] = 2 }
        else { copy(&mut f, op, dst, src); if dst == src { f.modes[op] = 2 } }
    }
    f.verified = false
    if !verify.verify_into(&mut f, &mut w.verifier) || !f.optimizable { rollback(&w, &mut f); w.state = -1; return false }
    w.state = 2; true
}
// Standalone correctness/test wrapper. Production value allocation should reuse
// the shared-facts entry above instead of constructing a second liveness arena.
pub fn optimize_with_context_budget(w: &mut Workspace, f: &mut mir.Function,
    context: &Context, exits: &terminals.TerminalContext, call_inputs: &inputs.Context, limit: i32) -> bool {
    reset(&mut w, limit)
    if !verify.verify_into(&mut f, &mut w.verifier) { w.state = -1; return false }
    var physical := live.new()
    if !live.analyze_with_inputs_into(&mut physical, &f, &call_inputs, limit) {
        w.state = live.status(&physical); w.work = live.units(&physical); return false
    }
    cost := live.units(&physical)
    changed := optimize_with_liveness_budget(&mut w, &mut f, &context, &exits, &physical, limit - cost)
    w.work = w.work + cost; changed
}
pub fn optimize_budget(w: &mut Workspace, f: &mut mir.Function, limit: i32) -> bool {
    context := conservative(); exits := terminals.no_terminals(); calls := inputs.conservative()
    optimize_with_context_budget(&mut w, &mut f, &context, &exits, &calls, limit)
}
pub fn optimize_into(w: &mut Workspace, f: &mut mir.Function) -> bool { optimize_budget(&mut w, &mut f, 4194304) }
