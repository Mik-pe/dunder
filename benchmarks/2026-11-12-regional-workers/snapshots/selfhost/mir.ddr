// Whole-function middle representation. Arenas are reusable primitive columns;
// operation IDs survive scheduling because order contains IDs, not objects.
// Mutable variables 0..31 initially name X registers (31 is SP), 32..63 V
// registers. NZCV is a separate explicit dependency, not an integer register.
// This milestone uses precolored mutable variables only. IDs beyond 63 require
// a future virtual-variable arena and explicit use/def lists; they are rejected
// until that representation exists rather than disappearing from masks.
//
// Kinds: 0 Opaque, 1 Constant, 2 Copy, 3 Unary, 4 Binary, 5 Compare,
// 6 Select, 7 Load, 8 Store, 9 Address, 10 StackPush, 11 StackPop,
// 12 Jump, 13 CondJump, 14 Call, 15 Return, 16 Frame, 17 ImportAddress,
// 18 Nop, 19 Float, 20 Trap, 21 Abi.
// dst/a/b/c are mutable variable IDs or -1. place is a Place ID or -1.
// opcode is semantic, independent of the retained encoding. Binary opcodes:
// 1 add, 2 subtract, 3 multiply, 4 signed high multiply, 5 unsigned high
// multiply, 6 signed divide, 7 unsigned divide, 8 and, 9 or, 10 xor,
// 11 and-not, 12 or-not, 13 xor-not, 14 logical left shift, 15 logical
// right shift, 16 arithmetic right shift, 17 multiply-add, 18 multiply-sub.
// Unary: 1 signed bitfield, 2 unsigned bitfield, 3 insert immediate halfword.
// Float: 1 add, 2 sub, 3 mul, 4 div, 5 compare, 6 abs, 7 negate, 8 sqrt,
// 9 copy GP bits to FP, 10 copy FP bits to GP, 11 precision conversion,
// 12 signed GP to FP, 13 unsigned GP to FP, 14 FP to signed GP,
// 15 FP to unsigned GP, 16 nearest, 17 floor, 18 ceil, 19 truncate,
// 20 ties-away. aux packs source shift amount in bits0..5 and shift kind
// in bits6..7 (0 left, 1 logical right, 2 arithmetic right, 3 rotate).
// Bitfield aux = rotate | (top_bit << 6). Select imm is the NZCV condition.
// variant retains the original shared encoding only for the adapter/replay;
// canonical operations do not need to decode it to discover their meaning.
// flags: bit1 reads NZCV, bit2 defines NZCV. register reads/writes include
// implicit operands, SP/FP/LR, and ABI state. clobbers denotes ABI destruction
// without pretending that a call produced new SSA definitions for every
// caller-save register. Calls initially have unknown summaries and clobber all.
// effects: 1 trap, 2 memory read, 4 memory write, 8 call, 16 control,
// 32 expression stack, 64 ordered ownership/allocator, 128 unknown alias.
// abi: 0 none, 1 internal Dunder, 2 foreign C, 3 host/syscall, 4 unknown.
// Lowering mode: 0 retained exact encoding, 1 canonical synthesized operation,
// 2 deleted. Retained encoding may only be replayed when semantics unchanged;
// optimizers must switch changed operations to canonical mode.
// Retained recipes are source provenance owned by the lifter, not optimizer
// rewrite selectors: 0 raw word, 1 proven FrameLoad helper, 2 FrameStore,
// 3 FrameAddress, 4 relocation, 5 import, 6 TempPush, 7 TempPop.
// Exact helper provenance distinguishes
// validated frame access from an identical arbitrary raw load that may trap.
// Abi opcodes: 1 frame-enter save FP/LR, 2 frame-leave restore FP/LR;
// imm is the signed byte SP delta (-16/+16), roles and masks are explicit.
// Return opcode1/abi1 is internal Dunder: a=X0 raw result, b=LR, c=SP;
// mir_abi defines its caller-observable implicit live-out state precisely.
//
// Places are BYTE ranges. kind: 0 indirect memory, 1 FP-relative frame,
// 2 expression stack. offset is signed byte displacement; width is bytes;
// StackPush/Pop's kind2 Place describes the low eight-byte value cell. Both
// operations access sixteen bytes: Push writes the value then eight zero
// bytes, while Pop reads the pair and discards the upper half. Their full
// implicit memory footprint and +/-16 SP delta belong to the stack opcode.
// Per-operation extensions: 0 raw, 1 zero extend, 2 sign extend. Extension is
// not part of memory identity: two loads with different extension still alias.
// place_extensions is reserved and zero; aliasing uses byte-range overlap.
// Escaped places cannot promote. Partially overlapping frame places alias.
// Edge kinds: 0 fallthrough, 1 taken, 2 external/trap, 3 return, 4 unknown,
// 5 explicit fallthrough out of this slice (never a fabricated return).
// Unknown control is represented as an unknown edge, never guessed fallthrough.
pub struct Function {
    valid: bool, verified: bool, optimizable: bool, unknown_control: bool,
    platform: i32, first_word: i32, first_label: i32, first_reloc: i32, first_import: i32,
    source_words: i32, source_labels: i32, source_relocs: i32, source_imports: i32,
    kinds: []i32, opcodes: []i32, dst: []i32, a: []i32, b: []i32, c: []i32,
    imm: []i64, aux: []i32, variant: []i64, types: []i32, place: []i32, extensions: []i32,
    effects: []i32, flags: []i32, abi: []i32, reads: []i64, writes: []i64, clobbers: []i64,
    origins: []i32, raw_starts: []i32, widths: []i32, modes: []i32, recipes: []i32,
    // Origin only: 0=raw/argument/bridge/unspecified, 1=positively declared
    // private expression temporary. Non-stack rows require0. This neither
    // proves mapping/nontrapping nor grants NoModRef or call-SP invisibility.
    stack_roles: []i32,
    targets: []i32, reloc_kinds: []i32, import_ids: []i32, order: []i32, raw: []i64,
    place_kinds: []i32, place_offsets: []i32, place_widths: []i32, place_extensions: []i32, place_escaped: []bool,
    place_table: []i32, place_probes: i32,
    block_starts: []i32, block_ends: []i32, op_blocks: []i32,
    edge_from: []i32, edge_to: []i32, edge_kinds: []i32, edge_starts: []i32,
    label_ids: []i32, label_ops: []i32,
    // Boundary map includes the old end; pair interiors are -1. Scratch is
    // reused by lift/verification and avoids rescanning the accumulated image.
    boundaries: []i32, leaders: []bool,
    visits: i32, budget_exhausted: bool,
}
pub fn new() -> Function {
    Function { valid: false, verified: false, optimizable: true, unknown_control: false,
        platform: 0, first_word: 0, first_label: 0, first_reloc: 0, first_import: 0,
        source_words: 0, source_labels: 0, source_relocs: 0, source_imports: 0,
        kinds: [], opcodes: [], dst: [], a: [], b: [], c: [], imm: [], aux: [], variant: [], types: [], place: [], extensions: [],
        effects: [], flags: [], abi: [], reads: [], writes: [], clobbers: [], origins: [], raw_starts: [], widths: [], modes: [], recipes: [], stack_roles: [],
        targets: [], reloc_kinds: [], import_ids: [], order: [], raw: [],
        place_kinds: [], place_offsets: [], place_widths: [], place_extensions: [], place_escaped: [],
        place_table: [], place_probes: 0,
        block_starts: [], block_ends: [], op_blocks: [], edge_from: [], edge_to: [], edge_kinds: [], edge_starts: [],
        label_ids: [], label_ops: [], boundaries: [], leaders: [], visits: 0, budget_exhausted: false }
}
pub fn reset(f: &mut Function) {
    f.valid = false; f.verified = false; f.optimizable = true; f.unknown_control = false
    f.kinds.clear(); f.opcodes.clear(); f.dst.clear(); f.a.clear(); f.b.clear(); f.c.clear()
    f.imm.clear(); f.aux.clear(); f.variant.clear(); f.types.clear(); f.place.clear(); f.extensions.clear()
    f.effects.clear(); f.flags.clear(); f.abi.clear(); f.reads.clear(); f.writes.clear(); f.clobbers.clear()
    f.origins.clear(); f.raw_starts.clear(); f.widths.clear(); f.modes.clear(); f.recipes.clear(); f.stack_roles.clear()
    f.targets.clear(); f.reloc_kinds.clear(); f.import_ids.clear(); f.order.clear(); f.raw.clear()
    f.place_kinds.clear(); f.place_offsets.clear(); f.place_widths.clear(); f.place_extensions.clear(); f.place_escaped.clear()
    f.place_table.clear(); f.place_probes = 0
    f.block_starts.clear(); f.block_ends.clear(); f.op_blocks.clear()
    f.edge_from.clear(); f.edge_to.clear(); f.edge_kinds.clear(); f.edge_starts.clear(); f.label_ids.clear(); f.label_ops.clear()
    f.boundaries.clear(); f.leaders.clear(); f.visits = 0; f.budget_exhausted = false
}
pub fn variable_bit(variable: i32) -> i64 {
    if variable < 0 || variable > 63 { return 0 }; i64(1).shl(variable)
}
pub fn add(f: &mut Function, kind: i32) -> i32 {
    f.verified = false; id := f.kinds.len
    f.kinds.push(kind); f.opcodes.push(0); f.dst.push(-1); f.a.push(-1); f.b.push(-1); f.c.push(-1)
    f.imm.push(0); f.aux.push(0); f.variant.push(0); f.types.push(0); f.place.push(-1); f.extensions.push(0)
    f.effects.push(0); f.flags.push(0); f.abi.push(0); f.reads.push(0); f.writes.push(0); f.clobbers.push(0)
    f.origins.push(-1); f.raw_starts.push(-1); f.widths.push(0); f.modes.push(1); f.recipes.push(0); f.stack_roles.push(0)
    f.targets.push(-1); f.reloc_kinds.push(-1); f.import_ids.push(-1)
    f.order.push(id); f.op_blocks.push(-1); id
}
fn place_hash(kind: i32, offset: i32, width: i32, capacity: i32) -> i32 {
    var value := i64(offset).bit_xor(i64(width).shl(32)).bit_xor(i64(kind).shl(60))
    value = value.bit_xor(value.shr(30)).wrapping_mul(-4658895280553007687)
    value = value.bit_xor(value.shr(27)).wrapping_mul(-7723592293110705685)
    value = value.bit_xor(value.shr(31))
    i32(value.bit_and(i64(capacity - 1)))
}
fn grow_places(f: &mut Function) {
    var capacity := 16; if f.place_table.len > 0 { capacity = f.place_table.len * 2 }
    f.place_table.clear(); for i in 0..capacity { f.place_table.push(0) }
    for p in 0..f.place_kinds.len {
        var bucket := place_hash(f.place_kinds[p], f.place_offsets[p], f.place_widths[p], capacity)
        f.place_probes = f.place_probes + 1
        while f.place_table[bucket] != 0 {
            bucket = (bucket + 1).bit_and(capacity - 1); f.place_probes = f.place_probes + 1
        }
        f.place_table[bucket] = p + 1
    }
}
pub fn add_place(f: &mut Function, kind: i32, offset: i32, width: i32, extension: i32) -> i32 {
    // Exact byte-range interning with reusable open addressing. Load <= 50%;
    // growth rehashes each place geometrically, not once per memory access.
    if f.place_table.len == 0 || f.place_kinds.len + 1 > f.place_table.len / 2 { grow_places(&mut f) }
    capacity := f.place_table.len; var bucket := place_hash(kind, offset, width, capacity)
    f.place_probes = f.place_probes + 1
    while f.place_table[bucket] != 0 {
        p := f.place_table[bucket] - 1
        if f.place_kinds[p] == kind && f.place_offsets[p] == offset && f.place_widths[p] == width { return p }
        bucket = (bucket + 1).bit_and(capacity - 1); f.place_probes = f.place_probes + 1
    }
    p := f.place_kinds.len; f.place_kinds.push(kind); f.place_offsets.push(offset)
    f.place_widths.push(width); f.place_extensions.push(0); f.place_escaped.push(kind == 0)
    f.place_table[bucket] = p + 1; p
}
pub fn places_alias(f: &Function, left: i32, right: i32) -> bool {
    if left < 0 || right < 0 || left >= f.place_kinds.len || right >= f.place_kinds.len { return true }
    if f.place_kinds[left] == 0 || f.place_kinds[right] == 0 { return true }
    if f.place_escaped[left] || f.place_escaped[right] { return true }
    // A raw FP/SP vocabulary adapter has no normalized stack-depth proof.
    // Distinct address bases alone do not prove disjoint storage.
    if f.place_kinds[left] != f.place_kinds[right] { return true }
    a := i64(f.place_offsets[left]); b := i64(f.place_offsets[right])
    a < b + i64(f.place_widths[right]) && b < a + i64(f.place_widths[left])
}
pub fn edge(f: &mut Function, from: i32, to: i32, kind: i32) {
    f.edge_from.push(from); f.edge_to.push(to); f.edge_kinds.push(kind)
}
pub fn opaque(f: &mut Function, op: i32) {
    f.kinds[op] = 0; f.effects[op] = 255; f.flags[op] = 3; f.abi[op] = 4
    f.reads[op] = -1; f.writes[op] = -1; f.clobbers[op] = -1
    f.optimizable = false; f.unknown_control = true
}
pub fn boundary(f: &Function, word: i32) -> i32 {
    offset := word - f.first_word
    if offset < 0 || offset >= f.boundaries.len { return -1 }; f.boundaries[offset]
}
