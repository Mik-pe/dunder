// Bounded SSA frame-value placement over the complete physical MIR CFG.
// Virtual IDs live ONLY in these arenas, never in Function's physical masks.
// Original GP/FP/NZCV operations remain pinned. Frame stores remain write-through.
// Unknown entry memory stays in memory. A separately certified active-frame
// lifetime permits initialized full8B captures AFTER memory barriers.
// The first allocator coalesces a cell's phi web, then colors actual live ranges
// against complete original physical liveness; it never borrows a live register,
// grows a frame, changes SP, or creates a label/import/control-flow namespace.
import mir
import mir_contract as contract
import mir_memory as memory
import mir_liveness as live
import mir_verify as verify
import mir_ssa_cells as grouping
import mir_terminals as terminals
import mir_call_inputs as call_inputs
import mir_call_abi as call_abi
import mir_expr_stack as expr

pub opaque struct Workspace {
    expression: expr.Workspace, cells: grouping.Plan, physical: live.Workspace, verifier: verify.Workspace, candidate: mir.Function,
    pred_starts: []i32, pred_edges: []i32, fill: []i32, queue: []i32, params: []i32, param_starts: []i32, param_counts: []i32, edge_args: []i32, arg_edges: []i32, arg_params: []i32, arg_next: []i32, edge_heads: []i32, state_table: []i32, state_blocks: []i32, state_variables: []i32, state_entry: []i32, state_tail: []i32, current: []i32, current_stamps: []i32, current_touched: []i32, global_inputs: []i32, node_kind: []i32, node_group: []i32, node_block: []i32, node_op: []i32, node_physical: []i32, node_source: []i32, node_parameter: []i32, node_previous: []i32, parent: []i32, qid: []i32, op_use_start: []i32, op_use_count: []i32, op_uses: []i32, op_use_roles: []i32, op_def_start: []i32, op_def_count: []i32, op_defs: []i32, op_def_roles: []i32, op_def_kinds: []i32, frame_def_start: []i32, frame_def_count: []i32, frame_defs: []i32, load_value: []i32, store_value: []i32, position: []i32, qnodes: []i32, qgroup: []i32, qcell: []i32, web_parent: []i32, web_groups: []i32, load_web: []i32, qblock: []i32, qop: []i32, group_home: []i32, group_score: []i32, active_values: []i32, active_positions: []i32, active_groups: []i32, active_group_positions: []i32, active_counts: []i32, before_starts: []i32, before_counts: []i32, after_starts: []i32, after_counts: []i32, live_before: []i32, live_after: []i32, conflicts: []i32, assigned: []i32, saved_order: []i32, saved_starts: []i32, saved_ends: []i32, saved_labels: []i32, assembled: []i32, boundaries: []i32, undo_ops: []i32, undo_modes: []i32,
    use: []i64, define: []i64, incoming: []i64, outgoing: []i64, state_bits: []i64, allowed: []i64, register_cost: []i64, undo_rows: []i64,
    reached: []bool, needed: []bool, queued: []bool, eligible: []bool, initialized: []bool, cell_changed: []bool,
    immutable: i64, flags_immutable: bool, code: i32, work: i32, limit: i32, stride: i32, groups: i32, webs: i32, frame_webs: i32, expr_groups: i32, zero: i32, words: i32,
    old_n: i32, before_verified: bool, before_optimizable: bool, staging: bool,
    changed_cells: i32, loads: i32, moves: i32, registers_used: i32, parameter_count: i32, captures: i32, expr_placed: i32, pushes: i32, pops: i32,
}
pub fn new() -> Workspace {
    Workspace { expression: expr.new(), cells: grouping.new(), physical: live.new(), verifier: verify.new_work(), candidate: mir.new(),
        pred_starts: [], pred_edges: [], fill: [], queue: [], params: [], param_starts: [], param_counts: [], edge_args: [], arg_edges: [], arg_params: [], arg_next: [], edge_heads: [], state_table: [], state_blocks: [], state_variables: [], state_entry: [], state_tail: [], current: [], current_stamps: [], current_touched: [], global_inputs: [], node_kind: [], node_group: [], node_block: [], node_op: [], node_physical: [], node_source: [], node_parameter: [], node_previous: [], parent: [], qid: [], op_use_start: [], op_use_count: [], op_uses: [], op_use_roles: [], op_def_start: [], op_def_count: [], op_defs: [], op_def_roles: [], op_def_kinds: [], frame_def_start: [], frame_def_count: [], frame_defs: [], load_value: [], store_value: [], position: [], qnodes: [], qgroup: [], qcell: [], web_parent: [], web_groups: [], load_web: [], qblock: [], qop: [], group_home: [], group_score: [], active_values: [], active_positions: [], active_groups: [], active_group_positions: [], active_counts: [], before_starts: [], before_counts: [], after_starts: [], after_counts: [], live_before: [], live_after: [], conflicts: [], assigned: [], saved_order: [], saved_starts: [], saved_ends: [], saved_labels: [], assembled: [], boundaries: [], undo_ops: [], undo_modes: [],
        use: [], define: [], incoming: [], outgoing: [], state_bits: [], allowed: [], register_cost: [], undo_rows: [],
        reached: [], needed: [], queued: [], eligible: [], initialized: [], cell_changed: [],
        immutable: 0, flags_immutable: false, code: 0, work: 0, limit: 0, stride: 0, groups: 0, webs: 0, frame_webs: 0, expr_groups: 0, zero: -1, words: 0,
        old_n: 0, before_verified: false, before_optimizable: false, staging: false,
        changed_cells: 0, loads: 0, moves: 0, registers_used: 0, parameter_count: 0, captures: 0, expr_placed: 0, pushes: 0, pops: 0 }
}
pub fn no_terminals() -> terminals.TerminalContext { terminals.no_terminals() }
pub fn status(w: &Workspace) -> i32 { w.code }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn optimized(w: &Workspace) -> i32 { if w.code == 2 { 1 } else { 0 } }
pub fn cells(w: &Workspace) -> i32 { if w.code == 2 { w.changed_cells } else { 0 } }
pub fn values(w: &Workspace) -> i32 { if w.code == 2 { w.node_kind.len } else { 0 } }
pub fn parameters(w: &Workspace) -> i32 { if w.code == 2 { w.parameter_count } else { 0 } }
pub fn registers(w: &Workspace) -> i32 { if w.code == 2 { w.registers_used } else { 0 } }
pub fn removed_loads(w: &Workspace) -> i32 { if w.code == 2 { w.loads } else { 0 } }
pub fn captures(w: &Workspace) -> i32 { if w.code == 2 { w.captures } else { 0 } }
pub fn removed_stores(w: &Workspace) -> i32 { 0 }
pub fn stack_groups(w: &Workspace) -> i32 { if w.code == 2 { w.expr_placed } else { 0 } }
pub fn removed_pushes(w: &Workspace) -> i32 { if w.code == 2 { w.pushes } else { 0 } }
pub fn removed_pops(w: &Workspace) -> i32 { if w.code == 2 { w.pops } else { 0 } }
pub fn copies(w: &Workspace) -> i32 { if w.code == 2 { w.moves } else { 0 } }
fn charge(w: &mut Workspace, n: i32) -> bool {
    if n < 0 || n > w.limit - w.work { w.code = -3; return false }; w.work = w.work + n; true
}
fn product(w: &mut Workspace, a: i32, b: i32, scale: i32) -> bool {
    n := i64(a) * i64(b) * i64(scale)
    if n < 0 || n > i64(w.limit - w.work) { w.code = -3; return false }; charge(&mut w, i32(n))
}
fn refuse(w: &mut Workspace) -> bool { w.code = -2; false }
fn invalid(w: &mut Workspace) -> bool { w.code = -1; false }
fn reset(w: &mut Workspace, limit: i32) {
    w.pred_starts.clear(); w.pred_edges.clear(); w.fill.clear(); w.queue.clear(); w.params.clear(); w.param_starts.clear(); w.param_counts.clear(); w.edge_args.clear(); w.arg_edges.clear(); w.arg_params.clear(); w.arg_next.clear(); w.edge_heads.clear(); w.state_table.clear(); w.state_blocks.clear(); w.state_variables.clear(); w.state_entry.clear(); w.state_tail.clear(); w.current.clear(); w.current_stamps.clear(); w.current_touched.clear(); w.global_inputs.clear(); w.node_kind.clear(); w.node_group.clear(); w.node_block.clear(); w.node_op.clear(); w.node_physical.clear(); w.node_source.clear(); w.node_parameter.clear(); w.node_previous.clear(); w.parent.clear(); w.qid.clear(); w.op_use_start.clear(); w.op_use_count.clear(); w.op_uses.clear(); w.op_use_roles.clear(); w.op_def_start.clear(); w.op_def_count.clear(); w.op_defs.clear(); w.op_def_roles.clear(); w.op_def_kinds.clear(); w.frame_def_start.clear(); w.frame_def_count.clear(); w.frame_defs.clear(); w.load_value.clear(); w.store_value.clear(); w.position.clear(); w.qnodes.clear(); w.qgroup.clear(); w.qcell.clear(); w.web_parent.clear(); w.web_groups.clear(); w.load_web.clear(); w.qblock.clear(); w.qop.clear(); w.group_home.clear(); w.group_score.clear(); w.active_values.clear(); w.active_positions.clear(); w.active_groups.clear(); w.active_group_positions.clear(); w.active_counts.clear(); w.before_starts.clear(); w.before_counts.clear(); w.after_starts.clear(); w.after_counts.clear(); w.live_before.clear(); w.live_after.clear(); w.conflicts.clear(); w.assigned.clear(); w.saved_order.clear(); w.saved_starts.clear(); w.saved_ends.clear(); w.saved_labels.clear(); w.assembled.clear(); w.boundaries.clear(); w.undo_ops.clear(); w.undo_modes.clear();
    w.use.clear(); w.define.clear(); w.incoming.clear(); w.outgoing.clear(); w.state_bits.clear(); w.allowed.clear(); w.register_cost.clear(); w.undo_rows.clear();
    w.reached.clear(); w.needed.clear(); w.queued.clear(); w.eligible.clear(); w.initialized.clear(); w.cell_changed.clear();
    w.immutable = 0; w.flags_immutable = false; w.code = 0; w.work = 0; w.limit = limit; w.stride = 0; w.groups = 0; w.webs = 0; w.frame_webs = 0; w.expr_groups = 0; w.zero = -1; w.words = 0
    w.old_n = 0; w.staging = false; w.changed_cells = 0; w.loads = 0; w.moves = 0; w.registers_used = 0; w.parameter_count = 0; w.captures = 0; w.expr_placed = 0; w.pushes = 0; w.pops = 0
}
fn bit(value: i32) -> i64 { i64(1).shl(value) }
// node_physical is a state-variable ordinal for entry/parameter nodes:
// GP0..31, NZCV32, frame-cell33+. It is never an SSA ID in a physical mask.
// kind1 entry,2 block parameter,3 pinned actual GP def,4 clobber-state
// capture (NOT a semantic call result),5 pinned NZCV state update/capture,
// 6 frame-copy def,
// 7 frame-memory version after a fence,8 normalized load view,9 immutable ZR.
// Kind5 is NOT a Compare/GVN expression: an opaque Call with flags3 captures
// unknown post-call NZCV here, preserving ordering and dependence only.
fn node(w: &mut Workspace, kind: i32, group: i32, block: i32, op: i32, physical: i32, source: i32) -> i32 {
    if !charge(&mut w, 12) { return -1 }; id := w.node_kind.len
    w.node_kind.push(kind); w.node_group.push(group); w.node_block.push(block); w.node_op.push(op)
    w.node_physical.push(physical); w.node_source.push(source); w.node_parameter.push(-1); w.node_previous.push(-1); w.parent.push(id); w.qid.push(-1); w.needed.push(false); id
}
fn root(w: &mut Workspace, value: i32) -> i32 {
    if value < 0 || value >= w.parent.len { w.code = -1; return -1 }
    var at := value
    while w.parent[at] != at { if !charge(&mut w, 1) { return -1 }; at = w.parent[at] }
    var current := value
    while w.parent[current] != current { next := w.parent[current]; w.parent[current] = at; current = next }
    at
}
fn graph(w: &mut Workspace, f: &mir.Function, exits: &terminals.TerminalContext) -> bool {
    blocks := f.block_starts.len; edges := f.edge_to.len
    if !charge(&mut w, blocks * 3 + edges * 3 + f.order.len * 3 + f.kinds.len) { return false }
    for b in 0..blocks { w.reached.push(false); w.fill.push(0) }
    for op in 0..f.kinds.len { w.position.push(-1) }
    for pos in 0..f.order.len { w.position[f.order[pos]] = pos }
    w.reached[0] = true; w.queue.push(0); var next := 0
    while next < w.queue.len {
        b := w.queue[next]; next = next + 1
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to == 0 { return refuse(&mut w) }
            if to >= 0 { if !w.reached[to] { w.reached[to] = true; w.queue.push(to) } }
            else if f.edge_kinds[e] != 3 {
                // All externally observable state is pinned by default. A
                // memory-domain contract never classifies an external exit.
                var last := -1
                for pos in f.block_starts[b]..f.block_ends[b] { if f.modes[f.order[pos]] != 2 { last = f.order[pos] } }
                if f.edge_kinds[e] != 2 || last < 0 || (f.kinds[last] != 12 && f.kinds[last] != 13) ||
                    !terminals.allows(&exits, f.targets[last]) { return refuse(&mut w) }
            }
        }
    }
    for e in 0..edges { to := f.edge_to[e]; if to >= 0 && w.reached[f.edge_from[e]] { w.fill[to] = w.fill[to] + 1 } }
    w.pred_starts.push(0)
    for b in 0..blocks { w.pred_starts.push(w.pred_starts[b] + w.fill[b]); w.fill[b] = w.pred_starts[b] }
    for e in 0..w.pred_starts[blocks] { w.pred_edges.push(0) }
    for e in 0..edges { to := f.edge_to[e]; if to >= 0 && w.reached[f.edge_from[e]] { w.pred_edges[w.fill[to]] = e; w.fill[to] = w.fill[to] + 1 } }
    true
}
// This is the only GP input-mask seam. The raw API conservatively observes
// all declared call inputs; a future producer contract can refine the query.
fn physical_reads(inputs: &call_inputs.Context, f: &mir.Function, op: i32) -> i64 {
    if f.kinds[op] != 14 { return f.reads[op] }
    call_inputs.reads(&inputs, &f, op)
}
// Sparse state is keyed by (block, variable), with reusable flat columns.
// Only a local use before a definition creates an entry parameter; a local
// definition alone creates a tail binding. Predecessor transport is added
// lazily after all local blocks are complete. No block×domain/edge×domain
// initialization, no object per state, and at most32 probes per table access.
fn state_hash(block: i32, variable: i32, size: i32) -> i32 {
    hash := (i64(block) * 73856093).bit_xor(i64(variable) * 19349663)
    i32(hash.bit_xor(hash.shr(17)).bit_and(i64(size - 1)))
}
fn grow_states(w: &mut Workspace) -> bool {
    var size := w.state_table.len * 2; if size == 0 { size = 16 }
    if !charge(&mut w, size + w.state_blocks.len) { return false }
    w.state_table.clear(); for at in 0..size { w.state_table.push(0) }
    for pair in 0..w.state_blocks.len {
        var at := state_hash(w.state_blocks[pair], w.state_variables[pair], size); var placed := false
        for probe in 0..32 {
            if !charge(&mut w, 1) { return false }
            if w.state_table[at] == 0 { w.state_table[at] = pair + 1; placed = true; break }
            at = (at + 1) % size
        }
        if !placed { w.code = -3; return false }
    }
    true
}
fn state(w: &mut Workspace, block: i32, variable: i32) -> i32 {
    if w.state_table.len == 0 || w.state_blocks.len * 2 >= w.state_table.len { if !grow_states(&mut w) { return -1 } }
    var at := state_hash(block, variable, w.state_table.len)
    for probe in 0..32 {
        if !charge(&mut w, 1) { return -1 }; found := w.state_table[at] - 1
        if found < 0 {
            if !charge(&mut w, 4) { return -1 }; pair := w.state_blocks.len
            w.state_table[at] = pair + 1; w.state_blocks.push(block); w.state_variables.push(variable)
            w.state_entry.push(-1); w.state_tail.push(-1); return pair
        }
        if w.state_blocks[found] == block && w.state_variables[found] == variable { return found }
        at = (at + 1) % w.state_table.len
    }
    w.code = -3; -1
}
fn entry(w: &mut Workspace, pair: i32) -> i32 {
    if w.state_entry[pair] >= 0 { return w.state_entry[pair] }
    b := w.state_blocks[pair]; variable := w.state_variables[pair]
    var group := -1; if variable >= 33 { group = variable - 33 }
    var kind := 2; if b == 0 { kind = 1 }
    value := node(&mut w, kind, group, b, -1, variable, -1); if value < 0 { return -1 }
    if !charge(&mut w, 4) { return -1 }
    w.state_entry[pair] = value; w.node_parameter[value] = w.params.len
    w.params.push(value); w.param_starts.push(-1); w.param_counts.push(0); value
}
// A physical state that has no definition/clobber in the entire function
// is already a single entry SSA value. Sharing that actual Input is pruning,
// not treating two unknown values as equal. Return's preserved live-outs do
// not require redundant phi transport through every block.
fn immutable_variable(w: &Workspace, variable: i32) -> bool {
    if variable >= 0 && variable < 32 { return w.immutable.bit_and(bit(variable)) != 0 }
    variable == 32 && w.flags_immutable
}
fn immutable_input(w: &Workspace, value: i32) -> bool {
    w.node_kind[value] == 1 && w.node_op[value] == -1 && w.node_block[value] == 0 &&
        w.node_physical[value] >= 0 && w.node_physical[value] <= 32 && immutable_variable(&w, w.node_physical[value])
}
fn read_local(w: &mut Workspace, block: i32, variable: i32) -> i32 {
    if !charge(&mut w, 1) { return -1 }
    if immutable_variable(&w, variable) {
        if w.global_inputs[variable] < 0 {
            value := node(&mut w, 1, -1, 0, -1, variable, -1); if value < 0 { return -1 }; w.global_inputs[variable] = value
        }
        return w.global_inputs[variable]
    }
    if w.current_stamps[variable] != block {
        pair := state(&mut w, block, variable); if pair < 0 { return -1 }
        value := entry(&mut w, pair); if value < 0 { return -1 }
        if !write_local(&mut w, block, variable, value) { return -1 }
    }
    w.current[variable]
}
fn write_local(w: &mut Workspace, block: i32, variable: i32, value: i32) -> bool {
    if !charge(&mut w, 2) { return false }
    if w.current_stamps[variable] != block { w.current_stamps[variable] = block; w.current_touched.push(variable) }
    w.current[variable] = value; true
}
fn build(w: &mut Workspace, f: &mir.Function, inputs: &call_inputs.Context) -> bool {
    blocks := f.block_starts.len; n := f.kinds.len; w.stride = 33 + w.groups
    if !charge(&mut w, n * 11 + w.stride * 2 + f.edge_to.len + 33) { return false }
    var mutated: i64 = 0; w.flags_immutable = true
    for op in 0..n {
        if f.modes[op] == 2 { continue }
        mutated = mutated.bit_or(f.writes[op]).bit_or(f.clobbers[op])
        if f.flags[op].bit_and(2) != 0 { w.flags_immutable = false }
    }
    w.immutable = mutated.bit_not().bit_and(4294967295)
    for variable in 0..33 { w.global_inputs.push(-1) }
    w.zero = node(&mut w, 9, -1, 0, -1, -1, -1); if w.zero < 0 { return false }
    for op in 0..n {
        w.op_use_start.push(-1); w.op_use_count.push(0); w.op_def_start.push(-1); w.op_def_count.push(0)
        w.frame_def_start.push(-1); w.frame_def_count.push(0); w.load_value.push(-1); w.store_value.push(-1)
    }
    for variable in 0..w.stride { w.current.push(-1); w.current_stamps.push(-1) }
    for e in 0..f.edge_to.len { w.edge_heads.push(-1) }
    for b in 0..blocks {
        w.current_touched.clear()
        for pos in f.block_starts[b]..f.block_ends[b] {
            op := f.order[pos]; w.op_use_start[op] = w.op_uses.len; w.op_def_start[op] = w.op_defs.len; w.frame_def_start[op] = w.frame_defs.len
            if f.modes[op] == 2 { continue }
            if !charge(&mut w, 70) { return false }
            readmask := physical_reads(&inputs, &f, op)
            for reg in 0..32 { if readmask.bit_and(bit(reg)) != 0 {
                value := read_local(&mut w, b, reg); if value < 0 { return false }; w.op_uses.push(value); w.op_use_roles.push(reg); w.op_use_count[op] = w.op_use_count[op] + 1
            } }
            if f.flags[op].bit_and(1) != 0 { value := read_local(&mut w, b, 32); if value < 0 { return false }; w.op_uses.push(value); w.op_use_roles.push(32); w.op_use_count[op] = w.op_use_count[op] + 1 }
            group := grouping.op_group(&w.cells, op); var frame_value := -1
            if group >= 0 {
                if f.kinds[op] == 7 {
                    frame_value = read_local(&mut w, b, 33 + group); if frame_value < 0 { return false }; w.load_value[op] = frame_value
                    w.op_uses.push(frame_value); w.op_use_roles.push(33 + group); w.op_use_count[op] = w.op_use_count[op] + 1
                } else if f.kinds[op] == 8 {
                    var source := w.zero; if f.a[op] >= 0 { source = read_local(&mut w, b, f.a[op]); if source < 0 { return false } }
                    frame_value = node(&mut w, 6, group, b, op, -1, source); if frame_value < 0 { return false }
                    if w.current_stamps[33 + group] == b { w.node_previous[frame_value] = w.current[33 + group] }
                    if !write_local(&mut w, b, 33 + group, frame_value) { return false }; w.store_value[op] = frame_value
                    w.frame_defs.push(frame_value); w.frame_def_count[op] = w.frame_def_count[op] + 1
                }
            }
            for reg in 0..32 {
                var actual := f.writes[op].bit_and(bit(reg)) != 0; clobber := f.clobbers[op].bit_and(bit(reg)) != 0
                if !actual && !clobber { continue }; if clobber { actual = false }; var kind := 4; var source := -1; if actual { kind = 3 }
                if f.kinds[op] == 7 && group >= 0 && reg == f.dst[op] { kind = 8; source = frame_value; actual = true }
                value := node(&mut w, kind, -1, b, op, reg, source); if value < 0 { return false }
                if !write_local(&mut w, b, reg, value) { return false }; w.op_defs.push(value); w.op_def_roles.push(reg)
                var definition := 2; if actual { definition = 1 }; w.op_def_kinds.push(definition); w.op_def_count[op] = w.op_def_count[op] + 1
            }
            if f.flags[op].bit_and(2) != 0 {
                value := node(&mut w, 5, -1, b, op, 32, -1); if value < 0 { return false }
                if !write_local(&mut w, b, 32, value) { return false }; w.op_defs.push(value); w.op_def_roles.push(32); w.op_def_kinds.push(1); w.op_def_count[op] = w.op_def_count[op] + 1
            }
            if grouping.op_barrier(&w.cells, op) {
                if !charge(&mut w, w.groups) { return false }
                for g in 0..w.groups {
                    previous := read_local(&mut w, b, 33 + g); if previous < 0 { return false }
                    value := node(&mut w, 7, g, b, op, -1, previous); if value < 0 { return false }
                    if !write_local(&mut w, b, 33 + g, value) { return false }; w.frame_defs.push(value); w.frame_def_count[op] = w.frame_def_count[op] + 1
                }
            }
        }
        for at in 0..w.current_touched.len {
            variable := w.current_touched[at]; pair := state(&mut w, b, variable); if pair < 0 { return false }
            w.state_tail[pair] = w.current[variable]
        }
    }
    // Resolve only actual incoming uses. New transport parameters append to
    // this worklist; placeholders exist before following predecessors, so a
    // loop terminates with real cyclic block parameters, never recursion.
    var next := 0
    while next < w.params.len {
        parameter := w.params[next]; b := w.node_block[parameter]; variable := w.node_physical[parameter]
        w.param_starts[next] = w.edge_args.len
        if b != 0 && w.reached[b] {
            for p in w.pred_starts[b]..w.pred_starts[b + 1] {
                if !charge(&mut w, 6) { return false }; e := w.pred_edges[p]
                pair := state(&mut w, f.edge_from[e], variable); if pair < 0 { return false }
                var value := w.state_tail[pair]
                if value < 0 { value = entry(&mut w, pair); if value < 0 { return false }; w.state_tail[pair] = value }
                at := w.edge_args.len; w.edge_args.push(value); w.arg_edges.push(e); w.arg_params.push(parameter)
                var previous := -1
                if variable >= 33 { previous = w.edge_heads[e]; w.edge_heads[e] = at }
                w.arg_next.push(previous)
            }
        }
        w.param_counts[next] = w.edge_args.len - w.param_starts[next]; next = next + 1
    }
    true
}
// Complete block-parameter form makes cross-block dependencies explicit. Each
// local use is a block parameter or an earlier definition; only predecessor
// edge arguments transfer values between blocks, including loop backedges.
fn graph_valid(w: &mut Workspace, f: &mir.Function, inputs: &call_inputs.Context) -> bool {
    if !charge(&mut w, f.kinds.len * 8 + w.node_kind.len * 4 + w.op_uses.len * 4 + w.op_defs.len * 4 + w.edge_args.len * 2) { return false }
    for op in 0..f.kinds.len {
        if !w.reached[f.op_blocks[op]] { continue }; block := f.op_blocks[op]
        var reads: i64 = 0; var writes: i64 = 0; var flags := 0; var frame_uses := 0
        if f.modes[op] == 2 {
            if w.op_use_count[op] != 0 || w.op_def_count[op] != 0 || w.frame_def_count[op] != 0 { return invalid(&mut w) }; continue
        }
        for at in w.op_use_start[op]..w.op_use_start[op] + w.op_use_count[op] {
            value := w.op_uses[at]; role := w.op_use_roles[at]
            if value < 0 || value >= w.node_kind.len { return invalid(&mut w) }
            if w.node_block[value] != block && !immutable_input(&w, value) { return invalid(&mut w) }
            defined := w.node_op[value]; if defined >= 0 && w.position[defined] >= w.position[op] { return invalid(&mut w) }
            if role >= 0 && role < 32 {
                if reads.bit_and(bit(role)) != 0 || w.node_physical[value] != role || w.node_group[value] != -1 { return invalid(&mut w) }; reads = reads.bit_or(bit(role))
            } else if role == 32 {
                if flags.bit_and(1) != 0 || w.node_physical[value] != 32 || w.node_group[value] != -1 { return invalid(&mut w) }; flags = flags.bit_or(1)
            } else {
                if role != 33 + grouping.op_group(&w.cells, op) || w.node_group[value] != role - 33 || w.load_value[op] != value || f.kinds[op] != 7 { return invalid(&mut w) }
                frame_uses = frame_uses + 1
            }
        }
        for at in w.op_def_start[op]..w.op_def_start[op] + w.op_def_count[op] {
            value := w.op_defs[at]; role := w.op_def_roles[at]
            if w.node_op[value] != op || w.node_block[value] != block || w.node_physical[value] != role { return invalid(&mut w) }
            if role >= 0 && role < 32 {
                if writes.bit_and(bit(role)) != 0 { return invalid(&mut w) }; writes = writes.bit_or(bit(role))
                var expected := 1; if f.clobbers[op].bit_and(bit(role)) != 0 { expected = 2 }
                if f.kinds[op] == 7 && w.load_value[op] >= 0 && role == f.dst[op] { expected = 1 }
                if w.op_def_kinds[at] != expected { return invalid(&mut w) }
            } else if role == 32 {
                if flags.bit_and(2) != 0 || w.op_def_kinds[at] != 1 { return invalid(&mut w) }; flags = flags.bit_or(2)
            } else { return invalid(&mut w) }
        }
        if reads != physical_reads(&inputs, &f, op).bit_and(4294967295) || writes != f.writes[op].bit_or(f.clobbers[op]).bit_and(4294967295) || flags != f.flags[op] { return invalid(&mut w) }
        var expected := 0; if w.load_value[op] >= 0 { expected = 1 }; if frame_uses != expected { return invalid(&mut w) }
    }
    for value in 0..w.node_kind.len {
        source := w.node_source[value]; kind := w.node_kind[value]
        if kind != 6 && kind != 7 && kind != 8 { if source != -1 { return invalid(&mut w) }; continue }
        if source < 0 || source >= value { return invalid(&mut w) }
        op := w.node_op[value]
        if w.node_kind[source] != 9 {
            if w.node_block[source] != w.node_block[value] && !immutable_input(&w, source) { return invalid(&mut w) }
            defined := w.node_op[source]; if defined >= 0 && w.position[defined] >= w.position[op] { return invalid(&mut w) }
        }
        if kind == 7 {
            if !grouping.op_barrier(&w.cells, op) || w.node_group[source] != w.node_group[value] { return invalid(&mut w) }
        } else if kind == 8 {
            if w.node_group[source] != grouping.op_group(&w.cells, op) || source != w.load_value[op] { return invalid(&mut w) }
        } else if source == w.zero {
            if f.a[op] != -1 { return invalid(&mut w) }
        } else {
            var found := false
            for at in w.op_use_start[op]..w.op_use_start[op] + w.op_use_count[op] {
                if !charge(&mut w, 1) { return false }
                if w.op_use_roles[at] == f.a[op] && w.op_uses[at] == source { found = true }
            }
            if !found { return invalid(&mut w) }
        }
    }
    for p in 0..w.params.len {
        parameter := w.params[p]; b := w.node_block[parameter]; variable := w.node_physical[parameter]
        if w.node_parameter[parameter] != p || variable < 0 || variable >= w.stride ||
            (w.node_kind[parameter] != 1 && w.node_kind[parameter] != 2) { return invalid(&mut w) }
        var count := 0; if b != 0 && w.reached[b] { count = w.pred_starts[b + 1] - w.pred_starts[b] }
        if w.param_starts[p] < 0 || w.param_counts[p] != count || w.param_starts[p] > w.edge_args.len - count { return invalid(&mut w) }
        for i in 0..count {
            if !charge(&mut w, 4) { return false }; at := w.param_starts[p] + i
            e := w.arg_edges[at]; value := w.edge_args[at]
            if e != w.pred_edges[w.pred_starts[b] + i] || f.edge_to[e] != b || w.arg_params[at] != parameter ||
                value < 0 || value >= w.node_kind.len || w.node_block[value] != f.edge_from[e] { return invalid(&mut w) }
            if variable >= 33 { if w.node_group[value] != variable - 33 { return invalid(&mut w) } }
            else if w.node_physical[value] != variable || w.node_group[value] != -1 { return invalid(&mut w) }
        }
    }
    // The liveness transpose must contain each frame edge-argument exactly
    // once on its own CFG edge, and no GP/flag argument. Check both directions
    // so a dropped link cannot silently shorten an SSA live range.
    if !charge(&mut w, f.edge_to.len + w.edge_args.len * 3) { return false }
    for at in 0..w.edge_args.len { w.assigned.push(0) }
    for e in 0..f.edge_to.len {
        var at := w.edge_heads[e]
        while at >= 0 {
            if !charge(&mut w, 1) { return false }
            if at >= w.edge_args.len || w.assigned[at] != 0 || w.arg_edges[at] != e || w.node_group[w.arg_params[at]] < 0 { return invalid(&mut w) }
            w.assigned[at] = 1; at = w.arg_next[at]
        }
    }
    for at in 0..w.edge_args.len {
        if (w.node_group[w.arg_params[at]] >= 0) != (w.assigned[at] == 1) { return invalid(&mut w) }
    }
    true
}
fn simplify(w: &mut Workspace, f: &mir.Function) -> bool {
    var again := true
    while again {
        again = false
        if !charge(&mut w, w.params.len) { return false }
        for p in 0..w.params.len {
            value := w.params[p]
            if w.node_kind[value] != 2 || !w.reached[w.node_block[value]] || w.parent[value] != value { continue }
            var chosen := -1; var different := false
            for at in w.param_starts[p]..w.param_starts[p] + w.param_counts[p] {
                if !charge(&mut w, 1) { return false }; input := root(&mut w, w.edge_args[at]); if input < 0 { return false }
                if input == value { continue }; if chosen < 0 { chosen = input } else if chosen != input { different = true }
            }
            if chosen >= 0 && !different { w.parent[value] = chosen; again = true }
        }
    }
    true
}
fn mark(w: &mut Workspace, value: i32) -> bool {
    found := root(&mut w, value); if found < 0 { return false }
    if !w.needed[found] { w.needed[found] = true; w.queue.push(found) }; true
}
fn demand(w: &mut Workspace, f: &mir.Function) -> bool {
    w.queue.clear()
    if !charge(&mut w, f.kinds.len + w.node_kind.len) { return false }
    for op in 0..f.kinds.len {
        if f.modes[op] != 2 && f.kinds[op] == 7 && f.dst[op] >= 0 && w.reached[f.op_blocks[op]] && w.load_value[op] >= 0 {
            if !mark(&mut w, w.load_value[op]) { return false }
        }
    }
    var next := 0
    while next < w.queue.len {
        value := w.queue[next]; next = next + 1
        if w.node_kind[value] == 2 {
            p := w.node_parameter[value]; if p < 0 { return invalid(&mut w) }
            for at in w.param_starts[p]..w.param_starts[p] + w.param_counts[p] {
                if !charge(&mut w, 1) || !mark(&mut w, w.edge_args[at]) { return false }
            }
        }
    }
    for value in 0..w.node_kind.len {
        if w.needed[value] && w.node_group[value] >= 0 {
            w.qid[value] = w.qnodes.len; w.qnodes.push(value); w.qgroup.push(w.node_group[value]); w.qcell.push(w.node_group[value]); w.qblock.push(w.node_block[value]); w.qop.push(w.node_op[value])
            if w.node_kind[value] == 2 { w.parameter_count = w.parameter_count + 1 }
        }
    }
    w.words = (w.qnodes.len + 63) / 64; true
}
// Initialization is a separate MUST property, never value equality across
// a memory fence. Full stores initialize all8 bytes; entry memory is unknown.
// A normal returning frame-preserving call may change ANY byte, but cannot
// unmap/end the original allocation or turn its initialized bytes into an
// invalid frame lifetime. The greatest fixed point includes every predecessor.
fn initialization(w: &mut Workspace, f: &mir.Function, abi: &call_abi.Context) -> bool {
    if !call_abi.preserves_source_frame(&abi) { return true }
    if !charge(&mut w, w.qnodes.len) { return false }; var required := false
    for q in 0..w.qnodes.len { if w.node_kind[w.qnodes[q]] == 7 { required = true } }
    if !required { return true }
    if !charge(&mut w, w.node_kind.len) { return false }
    for value in 0..w.node_kind.len { w.initialized.push(w.node_group[value] >= 0 && w.node_kind[value] != 1) }
    var again := true
    while again {
        again = false
        if !charge(&mut w, w.node_kind.len) { return false }
        for value in 0..w.node_kind.len {
            if w.node_group[value] < 0 || !w.initialized[value] || w.node_kind[value] == 6 { continue }
            kind := w.node_kind[value]; var proven := false
            if kind == 7 {
                source := root(&mut w, w.node_source[value]); if source < 0 { return false }; proven = w.initialized[source]
            } else if kind == 2 {
                p := w.node_parameter[value]; proven = w.param_counts[p] > 0
                for at in w.param_starts[p]..w.param_starts[p] + w.param_counts[p] {
                    if !charge(&mut w, 1) { return false }; source := root(&mut w, w.edge_args[at]); if source < 0 { return false }
                    if !w.initialized[source] { proven = false }
                }
            }
            if !proven { w.initialized[value] = false; again = true }
        }
    }
    true
}
fn web_root(w: &mut Workspace, q: i32) -> i32 {
    var at := q
    while w.web_parent[at] != at { if !charge(&mut w, 1) { return -1 }; at = w.web_parent[at] }
    var current := q
    while w.web_parent[current] != current { next := w.web_parent[current]; w.web_parent[current] = at; current = next }
    at
}
fn web_union(w: &mut Workspace, a: i32, b: i32) -> bool {
    left := web_root(&mut w, a); right := web_root(&mut w, b); if left < 0 || right < 0 { return false }
    if w.qcell[left] != w.qcell[right] { return invalid(&mut w) }
    if left < right { w.web_parent[right] = left } else { w.web_parent[left] = right }; true
}
// Phi arguments require the same storage without new critical-edge labels.
// Consecutive Store versions have a coalescing affinity, but a memory fence
// is NEVER an equality/coalescing edge. Thus one cell may have multiple
// independently placed regions, with fresh captures after later fences.
fn regions(w: &mut Workspace, f: &mir.Function) -> bool {
    if !charge(&mut w, w.qnodes.len * 5 + f.kinds.len + w.groups) { return false }
    w.assigned.clear()
    for q in 0..w.qnodes.len { w.web_parent.push(q); w.assigned.push(-1) }
    for q in 0..w.qnodes.len {
        value := w.qnodes[q]; kind := w.node_kind[value]
        if kind == 2 {
            p := w.node_parameter[value]
            for at in w.param_starts[p]..w.param_starts[p] + w.param_counts[p] {
                if !charge(&mut w, 1) { return false }; source := root(&mut w, w.edge_args[at]); if source < 0 { return false }
                other := w.qid[source]; if other < 0 { return invalid(&mut w) }; if !web_union(&mut w, q, other) { return false }
            }
        } else if kind == 6 && w.node_previous[value] >= 0 {
            source := root(&mut w, w.node_previous[value]); if source < 0 { return false }; other := w.qid[source]
            if other >= 0 { if !web_union(&mut w, q, other) { return false } }
        }
    }
    for q in 0..w.qnodes.len {
        parent := web_root(&mut w, q); if parent < 0 { return false }
        if w.assigned[parent] < 0 { w.assigned[parent] = w.webs; w.webs = w.webs + 1; w.web_groups.push(w.qcell[q]) }
        w.qgroup[q] = w.assigned[parent]
    }
    for op in 0..f.kinds.len {
        var web := -1
        if w.load_value[op] >= 0 && f.dst[op] >= 0 && w.reached[f.op_blocks[op]] {
            value := root(&mut w, w.load_value[op]); if value < 0 { return false }; q := w.qid[value]
            if q >= 0 { web = w.qgroup[q] }
        }
        w.load_web.push(web)
    }
    for g in 0..w.groups { w.cell_changed.push(false) }; true
}
// This independent capability grants FP/SP +original frame lifetime only;
// bytes may change at every barrier. Source-object and call-input contracts
// cannot manufacture it. Entry memory and partially initialized cells refuse.
fn capture_proven(w: &Workspace, f: &mir.Function, value: i32, abi: &call_abi.Context) -> bool {
    if !call_abi.preserves_source_frame(&abi) || w.node_kind[value] != 7 ||
        w.initialized.len != w.node_kind.len || !w.initialized[value] { return false }
    op := w.node_op[value]; cell := w.node_group[value]
    if op < 0 || !w.reached[w.node_block[value]] || !grouping.op_barrier(&w.cells, op) { return false }
    place := grouping.group_place(&w.cells, cell)
    place >= 0 && f.place_widths[place] == 8 && contract.frame_place_proven(&f, place)
}
fn set_bit(a: &mut []i64, base: i32, q: i32) { at := base + q / 64; a[at] = a[at].bit_or(bit(q % 64)) }
fn has(a: &[]i64, base: i32, q: i32) -> bool { a[base + q / 64].bit_and(bit(q % 64)) != 0 }
fn liveness(w: &mut Workspace, f: &mir.Function) -> bool {
    blocks := f.block_starts.len
    if !product(&mut w, blocks, w.words, 4) || !charge(&mut w, w.words + w.qnodes.len + f.order.len + w.frame_defs.len + blocks * 3) { return false }
    for i in 0..blocks * w.words { w.use.push(0); w.define.push(0); w.incoming.push(0); w.outgoing.push(0) }
    for i in 0..w.words { w.state_bits.push(0) }
    for q in 0..w.qnodes.len { if w.qop[q] < 0 { set_bit(&mut w.define, w.qblock[q] * w.words, q) } }
    for b in 0..blocks {
        base := b * w.words
        for pos in f.block_starts[b]..f.block_ends[b] {
            op := f.order[pos]
            if w.load_value[op] >= 0 && f.dst[op] >= 0 {
                value := root(&mut w, w.load_value[op]); if value < 0 { return false }; q := w.qid[value]
                if q >= 0 && !has(&w.define, base, q) { set_bit(&mut w.use, base, q) }
            }
            for at in w.frame_def_start[op]..w.frame_def_start[op] + w.frame_def_count[op] {
                q := w.qid[w.frame_defs[at]]; if q >= 0 { set_bit(&mut w.define, base, q) }
            }
        }
    }
    w.queue.clear(); for b in 0..blocks { w.queue.push(b); w.queued.push(w.reached[b]) }
    var head := 0; var tail := 0; var pending := blocks
    // Unreachable entries are harmless empty rows but need no predecessors.
    while pending > 0 {
        b := w.queue[head]; head = (head + 1) % blocks; pending = pending - 1; w.queued[b] = false
        if !charge(&mut w, w.words * (8 + (f.edge_starts[b + 1] - f.edge_starts[b]) * 2) + 2) { return false }
        for word in 0..w.words { w.state_bits[word] = 0 }
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]; if to < 0 { continue }
            for word in 0..w.words { w.state_bits[word] = w.state_bits[word].bit_or(w.incoming[to * w.words + word]) }
            var at := w.edge_heads[e]
            while at >= 0 {
                if !charge(&mut w, 1) { return false }; parameter := w.arg_params[at]
                if w.needed[parameter] && w.parent[parameter] == parameter {
                    input := root(&mut w, w.edge_args[at]); if input < 0 { return false }
                    q := w.qid[input]; if q >= 0 { set_bit(&mut w.state_bits, 0, q) }
                }
                at = w.arg_next[at]
            }
        }
        var changed := false
        for word in 0..w.words {
            at := b * w.words + word; incoming := w.use[at].bit_or(w.state_bits[word].bit_and(w.define[at].bit_not()))
            if w.incoming[at] != incoming || w.outgoing[at] != w.state_bits[word] { changed = true }
            w.incoming[at] = incoming; w.outgoing[at] = w.state_bits[word]
        }
        if !changed { continue }
        if !charge(&mut w, w.pred_starts[b + 1] - w.pred_starts[b]) { return false }
        for p in w.pred_starts[b]..w.pred_starts[b + 1] {
            from := f.edge_from[w.pred_edges[p]]
            if !w.queued[from] { w.queue[tail] = from; tail = (tail + 1) % blocks; pending = pending + 1; w.queued[from] = true }
        }
    }
    true
}
// Active-value and active-group sets use swap deletion, never a scan over
// all static SSA versions. Only real live events and overlap pairs are saved
// or inspected. The independent allocation witness consumes those same exact
// q IDs, including the defining operation for fresh Store-bound values.
fn activate(w: &mut Workspace, q: i32) -> bool {
    if !charge(&mut w, 2) { return false }; if w.active_positions[q] >= 0 { return true }
    w.active_positions[q] = w.active_values.len; w.active_values.push(q); g := w.qgroup[q]
    if w.active_counts[g] == 0 { w.active_group_positions[g] = w.active_groups.len; w.active_groups.push(g) }
    w.active_counts[g] = w.active_counts[g] + 1
    if w.active_counts[g] > 1 { w.eligible[g] = false }; true
}
fn deactivate(w: &mut Workspace, q: i32) -> bool {
    if !charge(&mut w, 2) { return false }; at := w.active_positions[q]; if at < 0 { return true }
    last := w.active_values[w.active_values.len - 1]; w.active_values[at] = last; w.active_positions[last] = at
    old := w.active_values.pop(); w.active_positions[q] = -1; g := w.qgroup[q]; w.active_counts[g] = w.active_counts[g] - 1
    if w.active_counts[g] == 0 {
        place := w.active_group_positions[g]; last_group := w.active_groups[w.active_groups.len - 1]
        w.active_groups[place] = last_group; w.active_group_positions[last_group] = place
        removed := w.active_groups.pop(); w.active_group_positions[g] = -1
    }
    true
}
fn first_bit(mask: i64) -> i32 {
    var value := mask; var at := 0
    if value.bit_and(4294967295) == 0 { value = value.shr(32); at = at + 32 }
    if value.bit_and(65535) == 0 { value = value.shr(16); at = at + 16 }
    if value.bit_and(255) == 0 { value = value.shr(8); at = at + 8 }
    if value.bit_and(15) == 0 { value = value.shr(4); at = at + 4 }
    if value.bit_and(3) == 0 { value = value.shr(2); at = at + 2 }
    if value.bit_and(1) == 0 { at = at + 1 }; at
}
// Both value families share homes and one conflict graph. A private Temp
// head may be ineligible itself; its BELOW link still carries eligible webs.
fn cross_expression(w: &mut Workspace, op: i32, after: bool) -> bool {
    if w.expr_groups == 0 || w.active_groups.len == 0 { return true }
    var head := expr.before_head(&w.expression, op); if after { head = expr.after_head(&w.expression, op) }
    while head >= 0 {
        if !charge(&mut w, 1) { return false }; group := expr.head_group(&w.expression, head)
        if group >= 0 {
            if !charge(&mut w, w.active_groups.len * 2) { return false }; other := w.frame_webs + group
            for at in 0..w.active_groups.len {
                frame := w.active_groups[at]; w.conflicts[frame * w.webs + other] = 1; w.conflicts[other * w.webs + frame] = 1
            }
        }
        head = expr.head_below(&w.expression, head)
    }; true
}
fn overlap(w: &mut Workspace) -> bool {
    if !product(&mut w, w.active_groups.len, w.active_groups.len, 1) { return false }
    for a in 0..w.active_groups.len { for c in 0..a {
        left := w.active_groups[a]; right := w.active_groups[c]
        w.conflicts[left * w.webs + right] = 1; w.conflicts[right * w.webs + left] = 1
    } }; true
}
fn interference(w: &mut Workspace, f: &mir.Function, inputs: &call_inputs.Context, abi: &call_abi.Context) -> bool {
    n := f.kinds.len; w.frame_webs = w.webs; w.webs = w.frame_webs + w.expr_groups
    if !product(&mut w, w.webs, w.webs, 1) || !charge(&mut w, n * 4 + w.qnodes.len + w.webs * 6) { return false }
    for g in 0..w.webs {
        var allowed: i64 = 262143; var score := 0
        if g >= w.frame_webs { allowed = expr.allowed_mask(&w.expression, g - w.frame_webs); score = expr.score(&w.expression, g - w.frame_webs) }
        w.allowed.push(allowed); w.group_home.push(-1); w.group_score.push(score); w.eligible.push(true)
        w.active_group_positions.push(-1); w.active_counts.push(0)
    }
    for q in 0..w.qnodes.len { w.active_positions.push(-1) }
    for op in 0..n { w.before_starts.push(0); w.before_counts.push(0); w.after_starts.push(0); w.after_counts.push(0) }
    for i in 0..w.webs * w.webs { w.conflicts.push(0) }
    if w.expr_groups > 0 {
        if !charge(&mut w, expr.conflict_count(&w.expression) * 2) { return false }
        for edge in 0..expr.conflict_count(&w.expression) {
            left := w.frame_webs + expr.conflict_left(&w.expression, edge); right := w.frame_webs + expr.conflict_right(&w.expression, edge)
            w.conflicts[left * w.webs + right] = 1; w.conflicts[right * w.webs + left] = 1
        }
    }
    if w.frame_webs > 0 {
    for b in 0..f.block_starts.len {
        if !w.reached[b] { continue }
        while w.active_values.len > 0 { if !deactivate(&mut w, w.active_values[w.active_values.len - 1]) { return false } }
        if !charge(&mut w, w.words) { return false }
        for word in 0..w.words {
            var bits := w.outgoing[b * w.words + word]
            while bits != 0 {
                if !charge(&mut w, 6) { return false }; index := first_bit(bits); q := word * 64 + index
                if !activate(&mut w, q) { return false }; bits = bits.bit_and(bit(index).bit_not())
            }
        }
        var pos := f.block_ends[b]
        while pos > f.block_starts[b] {
            pos = pos - 1; op := f.order[pos]; after := live.live_after(&w.physical, op)
            before := physical_reads(&inputs, &f, op).bit_or(after.bit_and(f.writes[op].bit_or(f.clobbers[op]).bit_not()))
            if !charge(&mut w, w.active_values.len * 2 + w.frame_def_count[op] + 4) { return false }
            w.after_starts[op] = w.live_after.len; w.after_counts[op] = w.active_values.len
            for at in 0..w.active_values.len {
                q := w.active_values[at]; g := w.qgroup[q]; w.live_after.push(q)
                var fixed := after; if w.qop[q] != op { fixed = fixed.bit_or(f.writes[op]).bit_or(f.clobbers[op]) }
                w.allowed[g] = w.allowed[g].bit_and(fixed.bit_not())
            }
            if !overlap(&mut w) || !cross_expression(&mut w, op, true) { return false }
            for at in w.frame_def_start[op]..w.frame_def_start[op] + w.frame_def_count[op] {
                q := w.qid[w.frame_defs[at]]; if q >= 0 { if !deactivate(&mut w, q) { return false } }
            }
            if w.load_value[op] >= 0 && f.dst[op] >= 0 {
                value := root(&mut w, w.load_value[op]); if value < 0 { return false }; q := w.qid[value]
                if q >= 0 { if !activate(&mut w, q) { return false } }
            }
            if !charge(&mut w, w.active_values.len * 2) { return false }
            w.before_starts[op] = w.live_before.len; w.before_counts[op] = w.active_values.len
            for at in 0..w.active_values.len {
                q := w.active_values[at]; g := w.qgroup[q]; w.live_before.push(q)
                w.allowed[g] = w.allowed[g].bit_and(before.bit_not())
            }
            if !overlap(&mut w) || !cross_expression(&mut w, op, false) { return false }
            g := w.load_web[op]
            if g >= 0 && f.modes[op] != 2 && f.kinds[op] == 7 && f.dst[op] >= 0 {
                var weight := 1; if live.loop_block(&w.physical, b) { weight = 32 }; w.group_score[g] = w.group_score[g] + weight
                // Full mask contract, including retained span scratch where
                // c=-1. A live extra def cannot vanish with the memory read.
                extra := f.writes[op].bit_or(f.clobbers[op]).bit_and(mir.variable_bit(f.dst[op]).bit_not())
                if extra.bit_and(after) != 0 { w.eligible[g] = false }
            }
        }
    }
    }
    // Each unknown-memory version is either captured AFTER its own barrier,
    // or its entire connected allocation web stays in memory. Independent
    // regions of the same cell can still be colored. No NoModRef inference.
    if !charge(&mut w, w.qnodes.len + w.webs) { return false }; var scratch := false
    for q in 0..w.qnodes.len {
        value := w.qnodes[q]; kind := w.node_kind[value]; web := w.qgroup[q]
        if kind == 1 { w.eligible[web] = false }
        if kind == 7 {
            if !capture_proven(&w, &f, value, &abi) { w.eligible[web] = false }
            else if contract.memory_scratch(i64(grouping.group_offset(&w.cells, w.qcell[q])), 8) {
                if live.live_after(&w.physical, w.node_op[value]).bit_and(bit(9)) != 0 { w.eligible[web] = false }
                scratch = true
            }
        }
    }
    // Captures at the same barrier execute in sequence. Their explicit X9
    // address writes must not destroy an earlier newly materialized web.
    if scratch { for web in 0..w.webs { w.allowed[web] = w.allowed[web].bit_and(bit(9).bit_not()) } }
    for r in 0..18 { w.register_cost.push(0) }
    for rank in 0..w.webs {
        if !charge(&mut w, w.webs * 2 + 18 * w.webs) { return false }
        var best := -1; var score := 1
        for g in 0..w.webs { if w.eligible[g] && w.group_home[g] == -1 && w.group_score[g] > score { best = g; score = w.group_score[g] } }
        if best < 0 { break }
        var mask := w.allowed[best]
        for other in 0..w.webs {
            reg := w.group_home[other]
            if reg >= 0 && w.conflicts[best * w.webs + other] != 0 { mask = mask.bit_and(bit(reg).bit_not()) }
        }
        var home := -1
        for r in 0..18 { if mask.bit_and(bit(r)) != 0 && home < 0 { home = r } }
        if home < 0 { w.eligible[best] = false; continue }
        w.group_home[best] = home
        if best < w.frame_webs { cell := w.web_groups[best]; if !w.cell_changed[cell] { w.cell_changed[cell] = true; w.changed_cells = w.changed_cells + 1 } }
        else { w.expr_placed = w.expr_placed + 1 }
        w.register_cost[home] = 1
    }
    for r in 0..18 { if w.register_cost[r] != 0 { w.registers_used = w.registers_used + 1 } }
    true
}
// Check the placement witness separately from greedy coloring. The two live
// tables describe SSA values, while all fixed conflicts use the ORIGINAL
// physical masks, including implicit scratch writes and ABI clobbers. A fresh
// Store-bound value is materialized after that Store; every other live value
// must survive its complete physical destruction mask. No spilling/SP change.
fn allocation_valid(w: &mut Workspace, f: &mir.Function, inputs: &call_inputs.Context, abi: &call_abi.Context) -> bool {
    if !charge(&mut w, w.live_before.len * 2 + w.live_after.len * 2 + w.qnodes.len + f.kinds.len * 4) { return false }
    var scratch := false
    for q in 0..w.qnodes.len {
        g := w.qgroup[q]; value := w.qnodes[q]; kind := w.node_kind[value]
        if w.group_home[g] < 0 { continue }
        if kind != 2 && kind != 6 && kind != 7 { return invalid(&mut w) }
        if kind == 7 {
            if !capture_proven(&w, &f, value, &abi) { return invalid(&mut w) }
            if contract.memory_scratch(i64(grouping.group_offset(&w.cells, w.qcell[q])), 8) {
                if live.live_after(&w.physical, w.node_op[value]).bit_and(bit(9)) != 0 { return invalid(&mut w) }; scratch = true
            }
        }
    }
    if scratch { for g in 0..w.webs { if w.group_home[g] == 9 { return invalid(&mut w) } } }
    for op in 0..f.kinds.len {
        if !w.reached[f.op_blocks[op]] { continue }
        after := live.live_after(&w.physical, op)
        before := physical_reads(&inputs, &f, op).bit_or(after.bit_and(f.writes[op].bit_or(f.clobbers[op]).bit_not()))
        var occupied_before: i64 = 0; var occupied_after: i64 = 0
        for at in w.before_starts[op]..w.before_starts[op] + w.before_counts[op] {
            q := w.live_before[at]; home := w.group_home[w.qgroup[q]]
            if home < 0 { continue }; if home > 17 { return invalid(&mut w) }; mask := bit(home)
            if before.bit_and(mask) != 0 || occupied_before.bit_and(mask) != 0 { return invalid(&mut w) }
            occupied_before = occupied_before.bit_or(mask)
        }
        for at in w.after_starts[op]..w.after_starts[op] + w.after_counts[op] {
            q := w.live_after[at]; home := w.group_home[w.qgroup[q]]
            if home < 0 { continue }; if home > 17 { return invalid(&mut w) }; mask := bit(home)
            var fixed := after; if w.qop[q] != op { fixed = fixed.bit_or(f.writes[op]).bit_or(f.clobbers[op]) }
            if fixed.bit_and(mask) != 0 || occupied_after.bit_and(mask) != 0 { return invalid(&mut w) }
            occupied_after = occupied_after.bit_or(mask)
        }
        if !expression_occupied(&mut w, op, false, occupied_before) || !expression_occupied(&mut w, op, true, occupied_after) { return false }
        g := w.load_web[op]
        if f.modes[op] != 2 && f.kinds[op] == 7 && f.dst[op] >= 0 && g >= 0 && w.group_home[g] >= 0 {
            extra := f.writes[op].bit_or(f.clobbers[op]).bit_and(mir.variable_bit(f.dst[op]).bit_not())
            if extra.bit_and(after) != 0 { return invalid(&mut w) }
        }
    }
    true
}
fn expression_occupied(w: &mut Workspace, op: i32, after: bool, occupied: i64) -> bool {
    if w.expr_groups == 0 { return true }; var seen := occupied
    var head := expr.before_head(&w.expression, op); if after { head = expr.after_head(&w.expression, op) }
    while head >= 0 {
        if !charge(&mut w, 1) { return false }; group := expr.head_group(&w.expression, head)
        if group >= 0 {
            home := w.group_home[w.frame_webs + group]
            if home >= 0 {
                if home > 17 || expr.allowed_mask(&w.expression, group).bit_and(bit(home)) == 0 || seen.bit_and(bit(home)) != 0 { return invalid(&mut w) }
                seen = seen.bit_or(bit(home))
            }
        }
        head = expr.head_below(&w.expression, head)
    }; true
}
fn pure(w: &mut Workspace, kind: i32, destination: i32, source: i32, ty: i32) {
    w.candidate.kinds[0] = kind; w.candidate.opcodes[0] = 0; w.candidate.dst[0] = destination; w.candidate.a[0] = source
    w.candidate.b[0] = -1; w.candidate.c[0] = -1; w.candidate.imm[0] = 0; w.candidate.aux[0] = 0
    w.candidate.types[0] = ty; w.candidate.place[0] = -1; w.candidate.extensions[0] = 0
    w.candidate.effects[0] = 0; w.candidate.flags[0] = 0; w.candidate.abi[0] = 0
    w.candidate.reads[0] = mir.variable_bit(source); w.candidate.writes[0] = mir.variable_bit(destination); w.candidate.clobbers[0] = 0
    w.candidate.targets[0] = -1; w.candidate.reloc_kinds[0] = -1; w.candidate.import_ids[0] = -1
}
fn view(w: &mut Workspace, f: &mir.Function, op: i32, home: i32) -> bool {
    width := grouping.op_width(&w.cells, op); shift := grouping.op_view_shift(&w.cells, op); extension := grouping.op_extension(&w.cells, op)
    if width == 8 && shift == 0 && extension == 0 { pure(&mut w, 2, f.dst[op], home, 2) }
    else if width == 4 && shift == 0 && extension == 1 { pure(&mut w, 2, f.dst[op], home, 1) }
    else {
        var ty := 2; if extension == 1 && shift == 0 && width < 4 { ty = 1 }
        pure(&mut w, 3, f.dst[op], home, ty)
        w.candidate.opcodes[0] = 2; if extension == 2 { w.candidate.opcodes[0] = 1 }
        w.candidate.aux[0] = shift + (shift + width * 8 - 1) * 64
    }
    contract.canonical(&w.candidate, 0)
}
fn reload(w: &mut Workspace, f: &mir.Function, value: i32, home: i32, abi: &call_abi.Context) -> bool {
    if !capture_proven(&w, &f, value, &abi) { return false }
    cell := w.node_group[value]; place := grouping.group_place(&w.cells, cell); offset := grouping.group_offset(&w.cells, cell)
    pure(&mut w, 7, home, 29, 2); w.candidate.place[0] = place; w.candidate.imm[0] = i64(offset)
    w.candidate.aux[0] = 8; w.candidate.effects[0] = 2
    if contract.memory_scratch(i64(offset), 8) {
        w.candidate.c[0] = 9; w.candidate.writes[0] = w.candidate.writes[0].bit_or(bit(9)); w.candidate.clobbers[0] = bit(9)
    }
    // The row references the ORIGINAL frame/place arena. Its complete shared
    // canonical contract is checked immediately after exclusive append below,
    // then again by unconditional final verification. A detached one-row
    // candidate cannot claim an original function's frame-capacity proof.
    home >= 0 && home <= 17
}
fn expression_row(w: &mut Workspace, f: &mir.Function, op: i32) -> i32 {
    var group := expr.push_group(&w.expression, op); var push := true
    if group < 0 { group = expr.pop_group(&w.expression, op); push = false }
    if group < 0 { return 0 }; home := w.group_home[w.frame_webs + group]; if home < 0 { return 0 }
    var dst := f.dst[op]; var src := home
    if push { dst = home; src = f.a[op] }
    // A discarded Pop still removes its private stack unit. A valid canonical
    // no-op row is retained as a tombstone so no physical write is invented.
    var mode := 1; if dst < 0 || dst == src { mode = 2 }; if dst < 0 { dst = 0; src = -1 }
    pure(&mut w, 2, dst, src, 2)
    if !contract.canonical(&w.candidate, 0) { w.code = -1; return -1 }; mode
}
fn prepare(w: &mut Workspace, f: &mir.Function, abi: &call_abi.Context) -> bool {
    if !charge(&mut w, f.kinds.len * 100 + w.qnodes.len * 8) { return false }
    // Avoid canonical-row buffers on disabled/no-placement paths. The fixed
    // charge above covers initialization even when this workspace is reused,
    // keeping per-function budgets independent of workers and arena capacity.
    if w.candidate.kinds.len == 0 { row := mir.add(&mut w.candidate, 2) }
    for op in 0..f.kinds.len {
        var group := w.load_web[op]
        if f.kinds[op] == 8 && w.store_value[op] >= 0 { q := w.qid[w.store_value[op]]; if q >= 0 { group = w.qgroup[q] } }
        if group < 0 || w.group_home[group] < 0 || f.modes[op] == 2 || !w.reached[f.op_blocks[op]] { continue }
        if f.kinds[op] == 7 && f.dst[op] >= 0 {
            if !view(&mut w, &f, op, w.group_home[group]) { return refuse(&mut w) }
        }
        if f.kinds[op] == 8 && f.a[op] >= 0 && f.writes[op].bit_or(f.clobbers[op]).bit_and(mir.variable_bit(f.a[op])) != 0 {
            return refuse(&mut w)
        }
    }
    for q in 0..w.qnodes.len {
        value := w.qnodes[q]; home := w.group_home[w.qgroup[q]]
        if home >= 0 && w.node_kind[value] == 7 { if !reload(&mut w, &f, value, home, &abi) { return refuse(&mut w) } }
    }
    if w.expr_groups > 0 {
        for op in 0..f.kinds.len {
            if !charge(&mut w, 1) { return false }
            if (f.kinds[op] == 10 || f.kinds[op] == 11) && expression_row(&mut w, &f, op) < 0 { return false }
        }
    }
    true
}
// Sparse semantic-row undo plus exactly the layout columns we change. No
// Function clone/snapshot, provenance rewriting, new place/edge/label/import.
fn begin_edit(w: &mut Workspace, f: &mir.Function) -> bool {
    if !charge(&mut w, f.order.len * 2 + f.block_starts.len * 4 + f.label_ops.len * 2) { return false }
    w.old_n = f.kinds.len
    for i in 0..f.order.len { w.saved_order.push(f.order[i]) }
    for i in 0..f.block_starts.len { w.saved_starts.push(f.block_starts[i]); w.saved_ends.push(f.block_ends[i]) }
    for i in 0..f.label_ops.len { w.saved_labels.push(f.label_ops[i]) }
    w.staging = true; true
}
fn remember(w: &mut Workspace, f: &mir.Function, op: i32) -> bool {
    if !charge(&mut w, 64) { return false }; w.undo_ops.push(op); w.undo_modes.push(f.modes[op])
    w.undo_rows.push(i64(f.kinds[op]))
    w.undo_rows.push(i64(f.opcodes[op]))
    w.undo_rows.push(i64(f.dst[op]))
    w.undo_rows.push(i64(f.a[op]))
    w.undo_rows.push(i64(f.b[op]))
    w.undo_rows.push(i64(f.c[op]))
    w.undo_rows.push(i64(f.imm[op]))
    w.undo_rows.push(i64(f.aux[op]))
    w.undo_rows.push(i64(f.types[op]))
    w.undo_rows.push(i64(f.place[op]))
    w.undo_rows.push(i64(f.extensions[op]))
    w.undo_rows.push(i64(f.effects[op]))
    w.undo_rows.push(i64(f.flags[op]))
    w.undo_rows.push(i64(f.abi[op]))
    w.undo_rows.push(i64(f.reads[op]))
    w.undo_rows.push(i64(f.writes[op]))
    w.undo_rows.push(i64(f.clobbers[op]))
    w.undo_rows.push(i64(f.targets[op]))
    w.undo_rows.push(i64(f.reloc_kinds[op]))
    w.undo_rows.push(i64(f.import_ids[op])); w.undo_rows.push(i64(f.recipes[op])); w.undo_rows.push(i64(f.stack_roles[op]))
    true
}
fn put(f: &mut mir.Function, candidate: &mir.Function, op: i32) {
    f.kinds[op] = candidate.kinds[0]
    f.opcodes[op] = candidate.opcodes[0]
    f.dst[op] = candidate.dst[0]
    f.a[op] = candidate.a[0]
    f.b[op] = candidate.b[0]
    f.c[op] = candidate.c[0]
    f.imm[op] = candidate.imm[0]
    f.aux[op] = candidate.aux[0]
    f.types[op] = candidate.types[0]
    f.place[op] = candidate.place[0]
    f.extensions[op] = candidate.extensions[0]
    f.effects[op] = candidate.effects[0]
    f.flags[op] = candidate.flags[0]
    f.abi[op] = candidate.abi[0]
    f.reads[op] = candidate.reads[0]
    f.writes[op] = candidate.writes[0]
    f.clobbers[op] = candidate.clobbers[0]
    f.targets[op] = candidate.targets[0]
    f.reloc_kinds[op] = candidate.reloc_kinds[0]
    f.import_ids[op] = candidate.import_ids[0]
    f.recipes[op] = 0; f.stack_roles[op] = 0; f.modes[op] = 1; f.verified = false
}
fn rollback(w: &mut Workspace, f: &mut mir.Function) {
    if w.staging {
        for slot in 0..w.undo_ops.len {
            op := w.undo_ops[slot]; base := slot * 22; f.modes[op] = w.undo_modes[slot]
            f.kinds[op] = i32(w.undo_rows[base + 0])
            f.opcodes[op] = i32(w.undo_rows[base + 1])
            f.dst[op] = i32(w.undo_rows[base + 2])
            f.a[op] = i32(w.undo_rows[base + 3])
            f.b[op] = i32(w.undo_rows[base + 4])
            f.c[op] = i32(w.undo_rows[base + 5])
            f.imm[op] = w.undo_rows[base + 6]
            f.aux[op] = i32(w.undo_rows[base + 7])
            f.types[op] = i32(w.undo_rows[base + 8])
            f.place[op] = i32(w.undo_rows[base + 9])
            f.extensions[op] = i32(w.undo_rows[base + 10])
            f.effects[op] = i32(w.undo_rows[base + 11])
            f.flags[op] = i32(w.undo_rows[base + 12])
            f.abi[op] = i32(w.undo_rows[base + 13])
            f.reads[op] = w.undo_rows[base + 14]
            f.writes[op] = w.undo_rows[base + 15]
            f.clobbers[op] = w.undo_rows[base + 16]
            f.targets[op] = i32(w.undo_rows[base + 17])
            f.reloc_kinds[op] = i32(w.undo_rows[base + 18])
            f.import_ids[op] = i32(w.undo_rows[base + 19])
            f.recipes[op] = i32(w.undo_rows[base + 20]); f.stack_roles[op] = i32(w.undo_rows[base + 21])
        }
        while f.kinds.len > w.old_n { old := f.kinds.pop() }
        while f.opcodes.len > w.old_n { old := f.opcodes.pop() }
        while f.dst.len > w.old_n { old := f.dst.pop() }
        while f.a.len > w.old_n { old := f.a.pop() }
        while f.b.len > w.old_n { old := f.b.pop() }
        while f.c.len > w.old_n { old := f.c.pop() }
        while f.imm.len > w.old_n { old := f.imm.pop() }
        while f.aux.len > w.old_n { old := f.aux.pop() }
        while f.variant.len > w.old_n { old := f.variant.pop() }
        while f.types.len > w.old_n { old := f.types.pop() }
        while f.place.len > w.old_n { old := f.place.pop() }
        while f.extensions.len > w.old_n { old := f.extensions.pop() }
        while f.effects.len > w.old_n { old := f.effects.pop() }
        while f.flags.len > w.old_n { old := f.flags.pop() }
        while f.abi.len > w.old_n { old := f.abi.pop() }
        while f.reads.len > w.old_n { old := f.reads.pop() }
        while f.writes.len > w.old_n { old := f.writes.pop() }
        while f.clobbers.len > w.old_n { old := f.clobbers.pop() }
        while f.origins.len > w.old_n { old := f.origins.pop() }
        while f.raw_starts.len > w.old_n { old := f.raw_starts.pop() }
        while f.widths.len > w.old_n { old := f.widths.pop() }
        while f.modes.len > w.old_n { old := f.modes.pop() }
        while f.recipes.len > w.old_n { old := f.recipes.pop() }
        while f.targets.len > w.old_n { old := f.targets.pop() }
        while f.reloc_kinds.len > w.old_n { old := f.reloc_kinds.pop() }
        while f.import_ids.len > w.old_n { old := f.import_ids.pop() }
        while f.op_blocks.len > w.old_n { old := f.op_blocks.pop() }
        while f.stack_roles.len > w.old_n { old := f.stack_roles.pop() }
        f.order.clear(); for i in 0..w.saved_order.len { f.order.push(w.saved_order[i]) }
        for i in 0..w.saved_starts.len { f.block_starts[i] = w.saved_starts[i]; f.block_ends[i] = w.saved_ends[i] }
        for i in 0..w.saved_labels.len { f.label_ops[i] = w.saved_labels[i] }
    }
    f.verified = w.before_verified; f.optimizable = w.before_optimizable
}
fn append_copy(w: &mut Workspace, f: &mut mir.Function, home: i32, source: i32, anchor: i32) -> bool {
    if source == home { return true }
    if f.kinds.len >= 65536 || !charge(&mut w, 160) { w.code = -3; return false }
    var kind := 2; if source < 0 { kind = 1 }; pure(&mut w, kind, home, source, 2)
    if !contract.canonical(&w.candidate, 0) { return invalid(&mut w) }
    op := mir.add(&mut f, kind); put(&mut f, &w.candidate, op)
    f.op_blocks[op] = f.op_blocks[anchor]; f.origins[op] = f.origins[anchor]
    w.assembled.push(op); w.moves = w.moves + 1; true
}
fn append_reload(w: &mut Workspace, f: &mut mir.Function, value: i32, home: i32, abi: &call_abi.Context) -> bool {
    if f.kinds.len >= 65536 || !charge(&mut w, 220) { w.code = -3; return false }
    if !reload(&mut w, &f, value, home, &abi) { return invalid(&mut w) }
    anchor := w.node_op[value]; op := mir.add(&mut f, 7); put(&mut f, &w.candidate, op)
    f.op_blocks[op] = f.op_blocks[anchor]; f.origins[op] = f.origins[anchor]
    if !contract.canonical(&f, op) { return invalid(&mut w) }
    w.assembled.push(op); w.captures = w.captures + 1; true
}
fn stage(w: &mut Workspace, f: &mut mir.Function, abi: &call_abi.Context) -> bool {
    if !charge(&mut w, f.order.len * 2 + w.frame_defs.len) { return false }
    if !begin_edit(&mut w, &f) { return false }
    for pos in 0..w.saved_order.len {
        w.boundaries.push(w.assembled.len); op := w.saved_order[pos]
        if w.expr_groups > 0 && f.modes[op] != 2 && (f.kinds[op] == 10 || f.kinds[op] == 11) {
            kind := f.kinds[op]; mode := expression_row(&mut w, &f, op); if mode < 0 { return false }
            if mode > 0 {
                if !remember(&mut w, &f, op) { return false }; put(&mut f, &w.candidate, op); f.modes[op] = mode
                if kind == 10 { w.pushes = w.pushes + 1 } else { w.pops = w.pops + 1 }
                if mode == 1 { w.moves = w.moves + 1 }
            }
        }
        group := w.load_web[op]
        if f.modes[op] != 2 && w.reached[f.op_blocks[op]] && group >= 0 && w.group_home[group] >= 0 && f.kinds[op] == 7 && f.dst[op] >= 0 {
            if !view(&mut w, &f, op, w.group_home[group]) || !remember(&mut w, &f, op) { return false }
            put(&mut f, &w.candidate, op); w.loads = w.loads + 1
            if w.candidate.kinds[0] == 2 { w.moves = w.moves + 1 }
        }
        w.assembled.push(op)
        for at in w.frame_def_start[op]..w.frame_def_start[op] + w.frame_def_count[op] {
            value := w.frame_defs[at]; q := w.qid[value]; if q < 0 { continue }; group := w.qgroup[q]
            if !w.needed[value] || w.group_home[group] < 0 || !w.reached[f.op_blocks[op]] { continue }
            if w.node_kind[value] == 6 {
                if !append_copy(&mut w, &mut f, w.group_home[group], f.a[op], op) { return false }
            } else if w.node_kind[value] == 7 {
                if !append_reload(&mut w, &mut f, value, w.group_home[group], &abi) { return false }
            } else { return invalid(&mut w) }
        }
    }
    w.boundaries.push(w.assembled.len)
    if !charge(&mut w, w.assembled.len + f.block_starts.len * 2 + f.label_ops.len) { return false }
    f.order.clear(); for pos in 0..w.assembled.len { f.order.push(w.assembled[pos]) }
    for b in 0..f.block_starts.len { f.block_starts[b] = w.boundaries[w.saved_starts[b]]; f.block_ends[b] = w.boundaries[w.saved_ends[b]] }
    for label in 0..f.label_ops.len { old := w.saved_labels[label]; if old >= 0 { f.label_ops[label] = w.boundaries[old] } }
    if !charge(&mut w, f.kinds.len * 100 + f.raw.len) { return false }
    if !verify.verify_into(&mut f, &mut w.verifier) || !f.optimizable { return invalid(&mut w) }
    true
}
fn no_frame_maps(w: &mut Workspace, f: &mir.Function) -> bool {
    if !charge(&mut w, f.kinds.len * 5) { return false }
    for op in 0..f.kinds.len { w.frame_def_start.push(0); w.frame_def_count.push(0); w.load_value.push(-1); w.store_value.push(-1); w.load_web.push(-1) }
    true
}
fn expression_facts(w: &mut Workspace, f: &mir.Function, context: &expr.Context, exits: &terminals.TerminalContext) -> bool {
    // Reserve the coordinator's scalar query/stream work before beginning a
    // staged analysis, so both arenas share the SAME total bounded budget.
    // A denied/empty analysis never pays for a stream that did not execute.
    stream := f.kinds.len * 3
    ready := expr.begin_analysis_budget(&mut w.expression, &f, &context, &exits, w.limit - w.work - stream)
    if !ready {
        w.work = w.work + expr.units(&w.expression); state := expr.status(&w.expression)
        if state == 0 || state == -2 { return true }; w.code = state; return false
    }
    if !charge(&mut w, stream) { return false }
    for op in 0..f.kinds.len {
        // Independent scalar roots avoid borrowing two populated owned fields
        // of this Workspace in one call. No liveness arena/model is copied.
        after := live.live_after(&w.physical, op); loop := live.loop_block(&w.physical, f.op_blocks[op])
        if !expr.feed_physical(&mut w.expression, op, after, loop) { w.work = w.work + expr.units(&w.expression); w.code = expr.status(&w.expression); return false }
    }
    ready_final := expr.finish_analysis(&mut w.expression); w.work = w.work + expr.units(&w.expression)
    if !ready_final { state := expr.status(&w.expression); if state == 0 || state == -2 { return true }; w.code = state; return false }
    w.expr_groups = expr.group_count(&w.expression); true
}
fn run(w: &mut Workspace, f: &mut mir.Function, context: &memory.Context, exits: &terminals.TerminalContext, inputs: &call_inputs.Context, abi: &call_abi.Context, expression: &expr.Context, enable_expression: bool, limit: i32) -> bool {
    reset(&mut w, limit); w.before_verified = f.verified; w.before_optimizable = f.optimizable
    if !f.valid || !f.verified || !terminals.valid(&exits) { return invalid(&mut w) }
    if limit < 0 || f.kinds.len > 65536 || f.block_starts.len > 16384 { w.code = -3; return false }
    if !enable_expression && f.place_kinds.len == 0 { return false }
    if f.place.len != f.kinds.len || f.dst.len != f.kinds.len || f.modes.len != f.kinds.len || f.stack_roles.len != f.kinds.len { return invalid(&mut w) }
    if !charge(&mut w, f.kinds.len) { return false }; var frame_candidate := false; var expr_candidate := false
    for op in 0..f.kinds.len {
        place := f.place[op]
        if f.modes[op] != 2 && f.kinds[op] == 7 && f.dst[op] >= 0 && place >= 0 && place < f.place_kinds.len && f.place_kinds[place] == 1 { frame_candidate = true }
        if enable_expression && f.modes[op] != 2 && f.kinds[op] == 10 && f.stack_roles[op] == 1 { expr_candidate = true }
    }
    if !frame_candidate && !expr_candidate { return false }
    if !charge(&mut w, f.kinds.len * 100 + f.raw.len) { return false }
    if !verify.verify_into(&mut f, &mut w.verifier) { w.code = -1; rollback(&mut w, &mut f); return false }
    if !f.optimizable || f.unknown_control { w.code = -2; rollback(&mut w, &mut f); return false }
    if f.block_starts.len == 0 { return false }
    if frame_candidate {
        ready := grouping.analyze_with_context_budget(&mut w.cells, &f, &context, w.limit - w.work); w.work = w.work + grouping.units(&w.cells)
        if !ready {
            state := grouping.status(&w.cells)
            if state != -2 || !expr_candidate { w.code = state; rollback(&mut w, &mut f); return false }
        } else { w.groups = grouping.group_count(&w.cells) }
        if w.groups > 0 && !memory.source_frame_eligible(&f) {
            if !expr_candidate { w.code = -2; rollback(&mut w, &mut f); return false }; w.groups = 0
        }
    }
    if w.groups == 0 && !expr_candidate { return false }
    if !graph(&mut w, &f, &exits) { rollback(&mut w, &mut f); return false }
    analyzed := live.analyze_with_inputs_into(&mut w.physical, &f, &inputs, w.limit - w.work); w.work = w.work + live.units(&w.physical)
    if !analyzed { w.code = live.status(&w.physical); rollback(&mut w, &mut f); return false }
    if expr_candidate { if !expression_facts(&mut w, &f, &expression, &exits) { rollback(&mut w, &mut f); return false } }
    if w.groups > 0 {
        if !build(&mut w, &f, &inputs) || !graph_valid(&mut w, &f, &inputs) || !simplify(&mut w, &f) || !demand(&mut w, &f) ||
            !initialization(&mut w, &f, &abi) || !regions(&mut w, &f) || !liveness(&mut w, &f) { rollback(&mut w, &mut f); return false }
    } else { if !no_frame_maps(&mut w, &f) { rollback(&mut w, &mut f); return false } }
    if !interference(&mut w, &f, &inputs, &abi) { rollback(&mut w, &mut f); return false }
    if w.changed_cells == 0 && w.expr_placed == 0 { return false }
    if !allocation_valid(&mut w, &f, &inputs, &abi) || !prepare(&mut w, &f, &abi) || !stage(&mut w, &mut f, &abi) { rollback(&mut w, &mut f); return false }
    if w.loads == 0 && w.pushes == 0 && w.pops == 0 { w.code = 0; rollback(&mut w, &mut f); return false }
    w.code = 2; true
}
pub fn optimize_values_with_contracts_budget(w: &mut Workspace, f: &mut mir.Function, context: &memory.Context, exits: &terminals.TerminalContext, inputs: &call_inputs.Context, abi: &call_abi.Context, expression: &expr.Context, limit: i32) -> bool {
    run(&mut w, &mut f, &context, &exits, &inputs, &abi, &expression, true, limit)
}
pub fn optimize_with_frame_contracts_budget(w: &mut Workspace, f: &mut mir.Function, context: &memory.Context, exits: &terminals.TerminalContext, inputs: &call_inputs.Context, abi: &call_abi.Context, limit: i32) -> bool {
    expression := expr.conservative(); run(&mut w, &mut f, &context, &exits, &inputs, &abi, &expression, false, limit)
}
pub fn optimize_with_terminals_budget(w: &mut Workspace, f: &mut mir.Function, context: &memory.Context, exits: &terminals.TerminalContext, limit: i32) -> bool {
    inputs := call_inputs.conservative(); abi := call_abi.conservative(); expression := expr.conservative(); run(&mut w, &mut f, &context, &exits, &inputs, &abi, &expression, false, limit)
}
pub fn optimize_with_contracts_budget(w: &mut Workspace, f: &mut mir.Function, context: &memory.Context, exits: &terminals.TerminalContext, inputs: &call_inputs.Context, limit: i32) -> bool {
    abi := call_abi.conservative(); expression := expr.conservative(); run(&mut w, &mut f, &context, &exits, &inputs, &abi, &expression, false, limit)
}
pub fn optimize_with_context_budget(w: &mut Workspace, f: &mut mir.Function, context: &memory.Context, limit: i32) -> bool {
    exits := terminals.no_terminals(); inputs := call_inputs.conservative(); abi := call_abi.conservative(); expression := expr.conservative(); run(&mut w, &mut f, &context, &exits, &inputs, &abi, &expression, false, limit)
}
pub fn optimize_budget(w: &mut Workspace, f: &mut mir.Function, limit: i32) -> bool {
    context := memory.conservative(); exits := terminals.no_terminals(); inputs := call_inputs.conservative(); abi := call_abi.conservative(); expression := expr.conservative(); run(&mut w, &mut f, &context, &exits, &inputs, &abi, &expression, false, limit)
}
pub fn optimize_with_context(w: &mut Workspace, f: &mut mir.Function, context: &memory.Context) -> bool { optimize_with_context_budget(&mut w, &mut f, &context, 4194304) }
pub fn optimize_into(w: &mut Workspace, f: &mut mir.Function) -> bool { optimize_budget(&mut w, &mut f, 4194304) }
