import .motion as motion
import std.parse as parse
import sys

fn advance(points: &mut []motion.Point, dt: f32) {
    for i in 0..points.len {
        points[i].x += points[i].dx * dt
        points[i].y += points[i].dy * dt
    }
}

fn main() {
    frames := parse.value<i32>(sys.arg(1)).unwrap()
    seed := parse.value<i32>(sys.arg(2)).unwrap()
    mut points: []motion.Point = []
    for i in 0..motion.count { points.push(motion.initial(i, seed)) }
    mut checksum: i64 = 0
    for frame in 0..frames {
        dt: f32 = if frame % 3 == 1 { -2.0 } else { 1.0 }
        advance(&mut points, dt)
        i := frame % motion.count
        checksum += motion.weight(i, points[i].x, points[i].y)
    }
    for i in 0..points.len { checksum += motion.weight(i, points[i].x, points[i].y) }
    print(checksum)
}
