import .motion as motion
import std.parse as parse
import sys

struct Columns {
    x: []f32,
    y: []f32,
    dx: []f32,
    dy: []f32,
}

impl Columns {
    fn add(&mut self, point: motion.Point) {
        self.x.push(point.x)
        self.y.push(point.y)
        self.dx.push(point.dx)
        self.dy.push(point.dy)
    }

    fn positions_x(&self) -> &[]f32 { &self.x[0..self.x.len] }

    fn advance(&mut self, dt: f32) {
        for i in 0..self.x.len {
            self.x[i] += self.dx[i] * dt
            self.y[i] += self.dy[i] * dt
        }
    }
}

@test fn a_row_can_be_appended_after_the_last_column_read() {
    mut points := Columns { x: [], y: [], dx: [], dy: [] }
    points.add(motion.initial(0, 1))
    xs := points.positions_x()
    assert(xs.len == 1 && xs[0] == 1.0)
    points.add(motion.initial(1, 1))
    assert(points.positions_x().len == 2 && points.x[1] == 4.0)
}

fn main() {
    frames := parse.value<i32>(sys.arg(1)).unwrap()
    seed := parse.value<i32>(sys.arg(2)).unwrap()
    mut points := Columns { x: [], y: [], dx: [], dy: [] }
    for i in 0..motion.count { points.add(motion.initial(i, seed)) }
    mut checksum: i64 = 0
    for frame in 0..frames {
        dt: f32 = if frame % 3 == 1 { -2.0 } else { 1.0 }
        points.advance(dt)
        i := frame % motion.count
        checksum += motion.weight(i, points.x[i], points.y[i])
    }
    xs := points.positions_x()
    for i in 0..xs.len { checksum += motion.weight(i, xs[i], points.y[i]) }
    print(checksum)
}
