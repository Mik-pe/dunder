pub const count: i32 = 4099

pub struct Point {
    x: f32,
    y: f32,
    dx: f32,
    dy: f32,
}

pub fn initial(i: i32, seed: i32) -> Point {
    Point {
        x: f32((i * 3 + seed) % 127),
        y: f32((i * 5 + seed) % 61),
        dx: f32(i % 11 - 5),
        dy: f32(i % 7 - 3),
    }
}

pub fn weight(i: i32, x: f32, y: f32) -> i64 {
    i64(i % 13 + 1) * (i64(x) + 17 * i64(y))
}
