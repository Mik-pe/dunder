import std.sys as sys
import std.parse as parse
import std.array as array

fn main(){
    count:=i32(parse.integer(sys.arg(1)).value)
    seed:=parse.integer(sys.arg(2)).value
    var values:[]i64=[]
    values.reserve(256)
    var checksum:i64=0
    for repeat in 0..count{
        values.clear()
        for i in 0..256{values.push((i64(255-i)*17+seed+i64(repeat))%1009)}
        array.sort(&mut values)
        for i in 0..256{checksum=checksum+values[i]*i64(i+1)}
    }
    print(checksum)
}
