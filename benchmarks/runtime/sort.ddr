import std.array as array
import std.parse as parse
import std.sys as sys

fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    seed := parse.integer(sys.arg(2)).value
    mut values: []i64 = []
    values.reserve(256)
    mut checksum: i64 = 0
    for repeat in 0..count {
        values.clear()
        for i in 0..256 {
            values.push((i64(255 - i) * 17 + seed + i64(repeat)) % 1009)
        }
        array.sort<i64>(&mut values)
        for i in 0..256 {
            checksum += values[i] * i64(i + 1)
        }
    }
    print(checksum)
}
