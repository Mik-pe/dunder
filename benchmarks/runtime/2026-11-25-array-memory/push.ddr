capability stdio
import std.array
import std.time
fn main() {
    mut samples: []i64 = []
    mut checksum: i64 = 0
    for batch in 0..120 {
        start := time.MonotonicClock.Raw.now_ns()
        for _ in 0..32 {
            mut values: []i32 = [0]
            for i in 1..1025 { values.push(i) }
            checksum += i64(values[1024])
        }
        elapsed := time.MonotonicClock.Raw.now_ns() - start
        if batch >= 20 { samples.push(elapsed / 32) }
    }
    assert(checksum == 3932160)
    array.sort<i64>(&mut samples)
    print(f"{samples[49]} {samples[94]} {checksum}")
}
