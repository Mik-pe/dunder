capability stdio
import std.time
import std.json

fn sum(doc: &json.Doc, obj: bool) -> i64 {
    mut total: i64 = 0
    if obj {
        for member in doc.members(doc.root) { total += i64(member.0.len) + doc.as_i64(member.1).unwrap() }
    } else {
        for node in doc.children(doc.root) { total += doc.as_i64(node).unwrap() }
    }
    total
}

fn main() {
    print("collection\tchildren\trun\tns\tchecksum")
    for obj in [false, true] {
        name := if obj { "object" } else { "array" }
        for n in [1024,2048,4096] {
            mut w := json.Writer::new()
            if obj { w.object() } else { w.array() }
            mut expected: i64 = 0
            for i in 0..n {
                if obj { key := "k" + i.str(); w.key(key); expected += i64(key.len) }
                w.integer(i64(i)); expected += i64(i)
            }
            w.end()
            doc := json.Doc::parse(w.finish().unwrap()).unwrap()
            mut times: []i64 = []
            for run in 0..33 {
                start := time.monotonic_ns()
                result := sum(&doc, obj)
                elapsed := time.monotonic_ns() - start
                assert(result == expected)
                if run >= 3 { times.push(elapsed) }
            }
            for i in 0..times.len { print(f"{name}\t{n}\t{i + 1}\t{times[i]}\t{expected}") }
        }
    }
}
