import std.sys as sys
import std.parse as parse

fn step(value:i64)->i64{(value*1664525+1013904223)%2147483647}
fn main(){
    count:=i32(parse.integer(sys.arg(1)).value)
    var value:=parse.integer(sys.arg(2)).value
    var checksum:i64=0
    for i in 0..count{value=step(value);checksum=checksum+value}
    print(checksum)
}
