import std.parse as parse
import std.sys as sys

fn step(value: i64) -> i64 {
    (value * 1664525 + 1013904223) % 2147483647
}

fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    mut value := parse.integer(sys.arg(2)).value
    mut checksum: i64 = 0
    for _ in 0..count {
        value = step(value)
        checksum += value
    }
    print(checksum)
}
