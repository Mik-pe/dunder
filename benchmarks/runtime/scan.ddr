import std.sys as sys
import std.parse as parse
import std.array as array

fn main(){
    count:=i32(parse.integer(sys.arg(1)).value)
    seed:=parse.integer(sys.arg(2)).value
    var values:[]i64=[]
    for i in 0..1024{values.push((i64(i)*17+seed)%1009)}
    var checksum:i64=0
    for i in 0..count{
        values[i%1024]=i64(i)
        checksum=checksum+array.sum(&values)
    }
    print(checksum)
}
