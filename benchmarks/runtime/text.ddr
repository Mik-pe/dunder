import std.parse as parse
import std.sys as sys

fn inspect(text: string) -> i64 {
    mut words: i64 = 0
    mut characters: i64 = 0
    mut inside := false
    for scalar in text.runes() {
        characters += i64(scalar)
        if scalar == ` ` || scalar == `\n` || scalar == `\t` {
            inside = false
        } else if !inside {
            words += 1
            inside = true
        }
    }
    words * 1000000 + characters
}

fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    text := sys.arg(2)
    mut checksum: i64 = 0
    for _ in 0..count {
        checksum += inspect(text)
    }
    print(checksum)
}
