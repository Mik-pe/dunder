capability stdio
import sys
import std.time

struct Entry { column: i32, coefficient: f64 }
@c_layout
struct FlatEntry { column: i32, coefficient: f64 }

fn records() -> i64 {
    mut terms: []Entry = []
    terms.reserve(4096)
    mut sum: i64 = 0
    for pass in 0..4 {
        terms.clear()
        for i in 0..4096 { terms.push(Entry { column: i, coefficient: f64((pass + i) % 7) }) }
        for t in &terms { sum += i64(t.column) + i64(t.coefficient) }
    }
    sum
}

fn flat_records() -> i64 {
    mut terms: []FlatEntry = []
    terms.reserve(4096)
    mut sum: i64 = 0
    for pass in 0..4 {
        terms.clear()
        for i in 0..4096 { terms.push(FlatEntry { column: i, coefficient: f64((pass + i) % 7) }) }
        for t in &terms { sum += i64(t.column) + i64(t.coefficient) }
    }
    sum
}

fn plain_literal() -> i64 {
    mut sum: i64 = 0
    region storage(65536) {
        mut terms: []Entry = storage.alloc(4096)
        for pass in 0..4 {
            for i in 0..4096 {
                terms[i] = Entry { column: i, coefficient: f64((pass + i) % 7) }
            }
            for i in 0..terms.len { sum += i64(terms[i].column) + i64(terms[i].coefficient) }
        }
    }
    sum
}

fn plain_fields() -> i64 {
    mut sum: i64 = 0
    region storage(65536) {
        mut terms: []Entry = storage.alloc(4096)
        for pass in 0..4 {
            for i in 0..4096 {
                terms[i].column = i
                terms[i].coefficient = f64((pass + i) % 7)
            }
            for i in 0..terms.len { sum += i64(terms[i].column) + i64(terms[i].coefficient) }
        }
    }
    sum
}

fn flat_literal() -> i64 {
    mut sum: i64 = 0
    region storage(65536) {
        mut terms: []FlatEntry = storage.alloc(4096)
        for pass in 0..4 {
            for i in 0..4096 {
                terms[i] = FlatEntry { column: i, coefficient: f64((pass + i) % 7) }
            }
            for i in 0..terms.len { sum += i64(terms[i].column) + i64(terms[i].coefficient) }
        }
    }
    sum
}

fn flat_fields() -> i64 {
    mut sum: i64 = 0
    region storage(65536) {
        mut terms: []FlatEntry = storage.alloc(4096)
        for pass in 0..4 {
            for i in 0..4096 {
                terms[i].column = i
                terms[i].coefficient = f64((pass + i) % 7)
            }
            for i in 0..terms.len { sum += i64(terms[i].column) + i64(terms[i].coefficient) }
        }
    }
    sum
}

fn measure(mode: string) -> i64 {
    match mode {
        "plain" => records(), "flat" => flat_records(),
        "plain-literal" => plain_literal(), "plain-fields" => plain_fields(),
        "flat-literal" => flat_literal(), "flat-fields" => flat_fields(),
        _ => { return -1 },
    }
}

fn main() -> i32 {
    if sys.arg_count() != 2 { return 1 }
    selection := sys.arg(1)
    if selection == "timings" {
        modes := ["plain", "flat", "plain-literal", "plain-fields", "flat-literal", "flat-fields"]
        print("sample,mode,batch_ns")
        for round in 0..31 {
            for step in 0..modes.len {
                mode := modes[(round + step) % modes.len].clone()
                start := time.monotonic_ns()
                for _ in 0..32 { assert(measure(mode) == 33595386) }
                elapsed := time.monotonic_ns() - start
                if round > 0 { print(f"{round},{mode},{elapsed}") }
            }
        }
        return 0
    }
    checksum := measure(selection)
    assert(checksum == 33595386)
    print(checksum)
    0
}
