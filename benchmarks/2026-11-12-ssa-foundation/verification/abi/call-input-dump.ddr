import ...selfhost.arm64 as arm
import ...selfhost.runtime
import ...selfhost.mir_decode as decode
fn main(){for platform in 0..4{for profiled in [false,true]{if platform==3&&profiled{continue}
var c:=arm.new_for(platform);c.profile=profiled;r:=runtime.new(&mut c)
labels:[]i32=[arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c)]
arm.runtime(&mut c,labels[0],labels[1],labels[2],labels[3],labels[4],labels[5],labels[6],labels[7]);runtime.emit_runtime(&mut c,&r)
print("BEGIN "+platform.str()+" "+profiled.str())
if r.alloc>=0&&c.labels[r.alloc]>=0{print("ENTRY alloc "+c.labels[r.alloc].str())}
if r.string_alloc>=0&&c.labels[r.string_alloc]>=0{print("ENTRY string_alloc "+c.labels[r.string_alloc].str())}
if r.release>=0&&c.labels[r.release]>=0{print("ENTRY release "+c.labels[r.release].str())}
if r.retain>=0&&c.labels[r.retain]>=0{print("ENTRY retain "+c.labels[r.retain].str())}
if r.retain_elements>=0&&c.labels[r.retain_elements]>=0{print("ENTRY retain_elements "+c.labels[r.retain_elements].str())}
if r.release_elements>=0&&c.labels[r.release_elements]>=0{print("ENTRY release_elements "+c.labels[r.release_elements].str())}
if r.array_new>=0&&c.labels[r.array_new]>=0{print("ENTRY array_new "+c.labels[r.array_new].str())}
if r.array_clone>=0&&c.labels[r.array_clone]>=0{print("ENTRY array_clone "+c.labels[r.array_clone].str())}
if r.array_reserve>=0&&c.labels[r.array_reserve]>=0{print("ENTRY array_reserve "+c.labels[r.array_reserve].str())}
if r.array_push>=0&&c.labels[r.array_push]>=0{print("ENTRY array_push "+c.labels[r.array_push].str())}
if r.array_pop>=0&&c.labels[r.array_pop]>=0{print("ENTRY array_pop "+c.labels[r.array_pop].str())}
if r.string_concat>=0&&c.labels[r.string_concat]>=0{print("ENTRY string_concat "+c.labels[r.string_concat].str())}
if r.string_compare>=0&&c.labels[r.string_compare]>=0{print("ENTRY string_compare "+c.labels[r.string_compare].str())}
if r.string_slice>=0&&c.labels[r.string_slice]>=0{print("ENTRY string_slice "+c.labels[r.string_slice].str())}
if r.string_integer>=0&&c.labels[r.string_integer]>=0{print("ENTRY string_integer "+c.labels[r.string_integer].str())}
if r.string_bool>=0&&c.labels[r.string_bool]>=0{print("ENTRY string_bool "+c.labels[r.string_bool].str())}
if r.string_rune>=0&&c.labels[r.string_rune]>=0{print("ENTRY string_rune "+c.labels[r.string_rune].str())}
if r.valid_rune>=0&&c.labels[r.valid_rune]>=0{print("ENTRY valid_rune "+c.labels[r.valid_rune].str())}
if r.string_bytes>=0&&c.labels[r.string_bytes]>=0{print("ENTRY string_bytes "+c.labels[r.string_bytes].str())}
if r.string_runes>=0&&c.labels[r.string_runes]>=0{print("ENTRY string_runes "+c.labels[r.string_runes].str())}
if r.string_index>=0&&c.labels[r.string_index]>=0{print("ENTRY string_index "+c.labels[r.string_index].str())}
if r.string_next>=0&&c.labels[r.string_next]>=0{print("ENTRY string_next "+c.labels[r.string_next].str())}
if r.sys_arg_count>=0&&c.labels[r.sys_arg_count]>=0{print("ENTRY sys_arg_count "+c.labels[r.sys_arg_count].str())}
if r.sys_arg>=0&&c.labels[r.sys_arg]>=0{print("ENTRY sys_arg "+c.labels[r.sys_arg].str())}
if r.sys_pid>=0&&c.labels[r.sys_pid]>=0{print("ENTRY sys_pid "+c.labels[r.sys_pid].str())}
if r.sys_read_text>=0&&c.labels[r.sys_read_text]>=0{print("ENTRY sys_read_text "+c.labels[r.sys_read_text].str())}
if r.sys_metadata>=0&&c.labels[r.sys_metadata]>=0{print("ENTRY sys_metadata "+c.labels[r.sys_metadata].str())}
if r.sys_same_file>=0&&c.labels[r.sys_same_file]>=0{print("ENTRY sys_same_file "+c.labels[r.sys_same_file].str())}
if r.sys_write_bytes>=0&&c.labels[r.sys_write_bytes]>=0{print("ENTRY sys_write_bytes "+c.labels[r.sys_write_bytes].str())}
if r.sys_make_executable>=0&&c.labels[r.sys_make_executable]>=0{print("ENTRY sys_make_executable "+c.labels[r.sys_make_executable].str())}
if r.sys_rename>=0&&c.labels[r.sys_rename]>=0{print("ENTRY sys_rename "+c.labels[r.sys_rename].str())}
if r.sys_remove_file>=0&&c.labels[r.sys_remove_file]>=0{print("ENTRY sys_remove_file "+c.labels[r.sys_remove_file].str())}
if r.sys_decode_utf8>=0&&c.labels[r.sys_decode_utf8]>=0{print("ENTRY sys_decode_utf8 "+c.labels[r.sys_decode_utf8].str())}
if r.sys_write_text>=0&&c.labels[r.sys_write_text]>=0{print("ENTRY sys_write_text "+c.labels[r.sys_write_text].str())}
if r.sys_append_text>=0&&c.labels[r.sys_append_text]>=0{print("ENTRY sys_append_text "+c.labels[r.sys_append_text].str())}
if r.sys_mkdir>=0&&c.labels[r.sys_mkdir]>=0{print("ENTRY sys_mkdir "+c.labels[r.sys_mkdir].str())}
if r.sys_remove_dir>=0&&c.labels[r.sys_remove_dir]>=0{print("ENTRY sys_remove_dir "+c.labels[r.sys_remove_dir].str())}
if r.sys_stderr>=0&&c.labels[r.sys_stderr]>=0{print("ENTRY sys_stderr "+c.labels[r.sys_stderr].str())}
if r.alloc_record>=0&&c.labels[r.alloc_record]>=0{print("ENTRY alloc_record "+c.labels[r.alloc_record].str())}
if r.alloc_clone>=0&&c.labels[r.alloc_clone]>=0{print("ENTRY alloc_clone "+c.labels[r.alloc_clone].str())}
if r.profile_start>=0&&c.labels[r.profile_start]>=0{print("ENTRY profile_start "+c.labels[r.profile_start].str())}
if r.profile_report>=0&&c.labels[r.profile_report]>=0{print("ENTRY profile_report "+c.labels[r.profile_report].str())}
if r.profile_data>=0&&c.labels[r.profile_data]>=0{print("ENTRY profile_data "+c.labels[r.profile_data].str())}
for i in 0..labels.len{print("ENTRY arm_"+i.str()+" "+c.labels[labels[i]].str())}
var d:=decode.new();var relocation:=0;var at:=0
while at<c.words.len{var width:=1;var flow:= -1;var target:= -1
if relocation<c.at.len&&c.at[relocation]==at{flow=c.kinds[relocation];target=c.labels[c.target[relocation]];assert(decode.symbolic(&mut d,flow));if flow>=2{width=2};relocation=relocation+1}else{decode.word(&mut d,c.words[at],platform)}
print("OP "+at.str()+" "+width.str()+" "+d.kind.str()+" "+d.reads.str()+" "+d.writes.str()+" "+d.a.str()+" "+d.b.str()+" "+d.c.str()+" "+flow.str()+" "+target.str()+" "+c.words[at].str())
at=at+width};print("END")
}}}
