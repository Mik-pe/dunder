import ...selfhost.arm64 as arm
import ...selfhost.runtime
import ...selfhost.mir_decode as decode
import ...selfhost.mir
fn main() {
    var mask:i64=0;for reg in 25..29{mask=mask.bit_or(mir.variable_bit(reg))}
    for platform in 0..4 { for profiled in [false,true] {
        if platform==3&&profiled{continue}
        var c:=arm.new_for(platform);c.profile=profiled
        r:=runtime.new(&mut c)
        labels:[]i32=[arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c),arm.label(&mut c)]
        arm.runtime(&mut c,labels[0],labels[1],labels[2],labels[3],labels[4],labels[5],labels[6],labels[7])
        runtime.emit_runtime(&mut c,&r)
        var d:=decode.new();var relocation:=0;var at:=0;var unknown:=0;var read:i64=0;var write:i64=0
        while at<c.words.len{
            if relocation<c.at.len&&c.at[relocation]==at{
                assert(decode.symbolic(&mut d,c.kinds[relocation]));width:=1;if c.kinds[relocation]>=2{at=at+1};relocation=relocation+1
            }else{decode.word(&mut d,c.words[at],platform)}
            if d.kind==0{print("unknown "+platform.str()+" "+profiled.str()+" "+at.str()+" "+c.words[at].str());unknown=unknown+1}
            else if d.kind!=14&&d.kind!=15{
                read=read.bit_or(mir.variable_bit(d.a)).bit_or(mir.variable_bit(d.b)).bit_or(mir.variable_bit(d.c))
                write=write.bit_or(d.writes)
            }
            at=at+1
        }
        print("summary "+platform.str()+" "+profiled.str()+" words="+c.words.len.str()+" unknown="+unknown.str()+" reads="+read.bit_and(mask).str()+" writes="+write.bit_and(mask).str())
        assert(read.bit_and(mask)==0&&write.bit_and(mask)==0)
    }}
}
