capability stdio
import std.bytes as bytes
import std.text as text
import std.time as timer
import std.array as arrays
import sys

struct Cursor { start: i32, end: i32, next: i32 }

impl Cursor {
    fn new() -> Self { Self { start: 0, end: 0, next: 0 } }

    fn advance(&mut self, value: &str) -> bool {
        if self.next == value.len { return false }
        self.start = self.next
        mut end := self.start
        while end < value.len && value[end] != 10 { end += 1 }
        self.next = end
        if end < value.len {
            self.next += 1
            if end > self.start && value[end - 1] == 13 { end -= 1 }
        }
        self.end = end
        true
    }
}
fn cursor(source: &str, first: bool) -> i32 {
    mut sum := 0
    mut rows := Cursor::new()
    while rows.advance(source) {
        line := &source[rows.start..rows.end]
        sum += line.len + 1
        if first { break }
    }
    sum
}


fn standard(source: &str, first: bool) -> i32 {
    mut lines := text.lines(source)
    mut result := 0
    while lines.advance() {
        result += lines.current().len + 1
        if first { break }
    }
    result
}
fn main() -> i32 {
    if sys.arg_count() < 3 || sys.arg_count() > 4 { return 2 }
    mut data: []u8 = []
    for _ in 0..1024 { bytes.append_utf8(&mut data, "blå\r\n\n界\n") }
    bytes.append_utf8(&mut data, "a\r")
    source := bytes.decode(&data).unwrap()
    first := sys.arg(2) == "first"
    if !first && sys.arg(2) != "all" { return 2 }
    mode := sys.arg(1)
    if mode != "std" && mode != "cursor" { return 2 }
    use_std := mode == "std"
    timed := sys.arg_count() == 4
    if timed && sys.arg(3) != "time" { return 2 }
    outer := if timed { 31 } else { 1 }
    inner := if !timed { 1 } else if first { 8192 } else { 16 }
    mut samples: []i64 = []
    for _ in 0..outer {
        start := timer.MonotonicClock.Raw.now_ns()
        mut sum := 0
        for _ in 0..inner { sum += if use_std { standard(source.as_str(), first) } else { cursor(source.as_str(), first) } }
        elapsed := timer.MonotonicClock.Raw.now_ns()-start
        assert(sum == inner*(if first { 5 } else { 10243 }))
        samples.push(elapsed/i64(inner))
    }
    arrays.sort<i64>(&mut samples)
    print(samples[outer/2])
    0
}
