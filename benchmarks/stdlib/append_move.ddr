capability stdio
import std.array as arrays
import sys

fn lines(batch: i32) -> [][]i32 {
    mut result: [][]i32 = []
    for line in 0..16 {
        mut cells: []i32 = []
        for column in 0..24 { cells.push(384 * batch + 24 * line + column) }
        result.push(move cells)
    }
    move result
}

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    mode := sys.arg(1)
    if mode != "reserved" && mode != "grow" { return 2 }
    mut doc: [][]i32 = []
    if mode == "reserved" { doc.reserve(1024) }
    for i in 0..64 {
        batch := lines(i)
        arrays.append_move(&mut doc, move batch)
    }
    mut next := 0
    for row in &doc {
        for cell in row { assert(cell == next); next += 1 }
    }
    assert(next == 24576)
    print(next)
    0
}
