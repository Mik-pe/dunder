capability stdio, unsafe
import std.io as io
import std.bytes as bytes
import std.time as timer
import sys

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    mode := sys.arg(1)
    if mode == "input" {
        mut data: []u8 = []
        for i in 0..1048576 { data.push(u8(i % 256)) }
        mut out := io.stdout()
        io.write_all(&mut out, &data).unwrap()
        return 0
    }
    if mode != "direct" && mode != "queue" { return 2 }
    staged := mode == "queue"
    mut data: []u8 = []
    mut queue := bytes.ByteQueue::new()
    mut sum := 0
    mut count := 0
    start := timer.MonotonicClock.Raw.now_ns()
    while true {
        data.clear()
        n := unsafe { io.fd_read_chunk(0, &mut data, 128) }.unwrap()
        if n == 0 { break }
        if staged {
            queue.append(&data)
            for b in queue.pending() { sum += i32(b) }
            assert(queue.advance(n))
        } else {
            for b in &data { sum += i32(b) }
        }
        count += n
    }
    elapsed := timer.MonotonicClock.Raw.now_ns()-start
    assert(count == 1048576 && sum == 133693440)
    print(elapsed)
    0
}
