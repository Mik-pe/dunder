import std.parse as parse
import std.sys as sys

fn mix(value: i64, rounds: i32) -> i64 {
    mut x := value
    for i in 0..rounds {
        x = x * 2
        if x >= 1000000007 { x -= 1000000007 }
    }
    x
}

fn main() {
    print(mix(parse.integer(sys.arg(1)).value, i32(parse.integer(sys.arg(2)).value)))
}
