capability filesystem

import "../../../tools/benchmark_commands" as bench
import std.bytes as bytes
import std.fs as fs
import std.parse as parse
import std.text as text
import sys

pub struct Workload {
    name: string,
    source: string,
    expected: []u8,
    synthetic: bool,
}

pub fn workload(name: string, path: string, expected: string, synthetic: bool) -> Workload {
    Workload { name: name.clone(), source: path.clone(), expected: bench.raw(expected), synthetic: synthetic }
}

fn rewrite(input: &[]u8, module: i32, mixed: bool) -> []u8 {
    needle := "value = value + 1"
    mut out: []u8 = []
    mut at := 0
    mut from := 0
    mut assignment := 0
    replacements := ["value = value + x", "value = value - 1", "value = value + 2", "value = value - x"]
    while at <= input.len - needle.len {
        if input[at] == b'v' && bytes.equals_text(&input, at, at + needle.len, needle) {
            bytes.extend_range(&mut out, &input, from, at)
            function := module * 50 + assignment / 96
            if mixed {
                if assignment % 96 == 1 { bytes.append_utf8(&mut out, f"value = value - {function + 1}") }
                else { bytes.append_utf8(&mut out, replacements[assignment % 4]) }
            } else {
                next := if assignment % 96 == 0 { function + 1 } else { 1 }
                bytes.append_utf8(&mut out, f"value = value + {next}")
            }
            at += needle.len
            from = at
            assignment += 1
        } else { at += 1 }
    }
    if assignment != 50 * 96 { return [] }
    bytes.extend_range(&mut out, &input, from, input.len)
    out
}

pub fn shaped(work: string, same: string, mixed: bool) -> Workload {
    name := if mixed { "mixed" } else { "unique" }
    root := same[0..(same.len - "/main.ddr".len)]
    target := work + "/" + name
    result := workload(name, target + "/main.ddr", if mixed { "24000\n" } else { "1095000\n" }, true)
    if !sys.mkdir(target).ok { return workload(name, "", "", true) }
    files := fs.list_dir(root)
    if !files.ok { return workload(name, "", "", true) }
    for file in files.entries {
        if !text.ends_with(file, ".ddr") { continue }
        content := sys.read_u8(root + "/" + file)
        if !content.ok { return workload(name, "", "", true) }
        output := target + "/" + file
        if file == "main.ddr" {
            if !sys.write_u8(output, &content.value).ok { return workload(name, "", "", true) }
        } else {
            module := parse.integer(file[1..(file.len - 4)])
            if !module.ok || module.value < 0 || module.value >= 20 { return workload(name, "", "", true) }
            updated := rewrite(&content.value, i32(module.value), mixed)
            if updated.len == 0 || !sys.write_u8(output, &updated).ok { return workload(name, "", "", true) }
        }
    }
    result
}

pub fn large(work: string, binding: string) -> Workload {
    directory := work + "/large-function"
    source := directory + "/main.ddr"
    mut output: []u8 = []
    bytes.append_utf8(&mut output, f"fn compute(x: i64) -> i64 {{\n    {binding} value := x\n")
    mut value := 17
    for index in 0..4096 {
        bytes.append_utf8(&mut output, f"    value = (value * 3 + x + {index}) % 1000003\n")
        value = (value * 3 + 17 + index) % 1000003
    }
    bytes.append_utf8(&mut output, "    value\n}\nfn main() { print(compute(17)) }\n")
    if !sys.mkdir(directory).ok || !sys.write_u8(source, &output).ok { return workload("large-function", "", "", true) }
    workload("large-function", source, value.str() + "\n", true)
}

pub fn varied(work: string, binding: string, array: string, payload: string) -> Workload {
    directory := work + "/varied-calls"
    source := directory + "/main.ddr"
    mut output := bench.raw("struct Item { label: string, values: []i64 }\nenum Reading { Count(i64), Text(string) }\n" +
        "fn score(reading: Reading) -> i64 {\n    match reading { .Count(n) => n, .Text(s) => i64(s.len) }\n}\n")
    mut calls: []u8 = []
    mut expected := 0
    for index in 0..256 {
        label := f"item{index}"
        bytes.append_utf8(&mut output,
            f"fn item{index}(n: i64) -> Item {{\n    Item {{ label: \"{label}\", values: [n, n + {index}] }}\n}}\n" +
            f"fn update{index}(a: &mut []i64, text: string) -> Reading {{\n    a[0] = a[0] + {index + 1}\n" +
            "    if a[0] % 3 == 0 { return Reading.Text(" + payload + ") }\n    Reading.Count(a[1])\n}\n" +
            f"fn visit{index}(item: Item) -> i64 {{\n    {binding} a := {array}\n    reading := update{index}(&mut a, item.label)\n" +
            "    score(reading) + a[0] + item.values[0]\n}\n")
        n := index + 7
        bytes.append_utf8(&mut calls, f"    total = total + visit{index}(item{index}({n}))\n")
        updated := n + index + 1
        score := if updated % 3 == 0 { label.len } else { n + index }
        expected += score + updated + n
    }
    bytes.append_utf8(&mut output, f"fn main() {{\n    {binding} total: i64 = 0\n")
    bytes.extend(&mut output, &calls)
    bytes.append_utf8(&mut output, "    print(total)\n}\n")
    if !sys.mkdir(directory).ok || !sys.write_u8(source, &output).ok { return workload("varied-calls", "", "", true) }
    workload("varied-calls", source, expected.str() + "\n", true)
}
