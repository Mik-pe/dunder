import std.sys as sys
import std.parse as parse

fn inspect(text:string)->i64{
    var words:i64=0
    var characters:i64=0
    var inside:=false
    for scalar in text.runes(){
        characters=characters+i64(scalar)
        if scalar==` ` || scalar==`\n` || scalar==`\t`{inside=false}
        else if !inside{words=words+1;inside=true}
    }
    words*1000000+characters
}
fn main(){
    count:=i32(parse.integer(sys.arg(1)).value)
    text:=sys.arg(2)
    var checksum:i64=0
    for i in 0..count{checksum=checksum+inspect(text)}
    print(checksum)
}
