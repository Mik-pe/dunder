// Alias policy is an explicit producer assertion, never inferred from raw MIR.
// Verification proves representation/ABI facts; it cannot prove that arbitrary
// indirect pointers respect source objects or avoid walking saved frame links.
import mir
import mir_abi as abi
import mir_contract as contract

pub opaque struct Context { object_contract: i32 }
pub fn conservative() -> Context { Context { object_contract: 0 } }
// TRUSTED PRODUCER PRECONDITION, version1: valid indirect accesses obey the
// source object's lifetime/range and have NoModRef (neither read nor write) on
// unexposed cells of the current frame. An exposed address is not private.
// This context is for the complete source-object producer boundary, not a
// capability that raw instruction decoding or !escaped can establish. Calls
// have separate register/memory summaries and are NOT exempted by this policy.
pub fn trusted_source_objects_v1() -> Context { Context { object_contract: 1 } }
pub fn for_source_producer(enabled: bool) -> Context {
    if enabled { return trusted_source_objects_v1() }; conservative()
}
pub fn source_policy_tag(enabled: bool) -> string {
    if enabled { "mir-memory:source-objects-v1" } else { "mir-memory:raw-v1" }
}
pub fn source_objects(context: &Context) -> bool { context.object_contract == 1 }
pub fn policy_tag(context: &Context) -> string {
    source_policy_tag(source_objects(&context))
}
// Structural side conditions only. The caller must ALSO hold the explicit
// trusted Context. Cost <=2*operationCount, with no new arrays or graph walk.
pub fn source_frame_eligible(f: &mir.Function) -> bool {
    if !f.valid || !f.verified || !f.optimizable || f.unknown_control ||
        contract.frame_capacity(&f) < 0 || contract.frame_lifetime_unproven(&f) { return false }
    for position in 0..f.order.len {
        op := f.order[position]; if f.modes[op] == 2 { continue }; kind := f.kinds[op]
        if kind < 1 || kind > 21 || f.effects[op].bit_and(128) != 0 { return false }
        if kind == 7 || kind == 8 {
            p := f.place[op]
            if f.place_kinds[p] == 2 { return false }
            if f.place_kinds[p] == 1 {
                // Ordinary accesses may not discover/overwrite the saved FP
                // or LR. In raw MIR [FP,#0] can walk into the caller's frame.
                offset := i64(f.place_offsets[p]); width := i64(f.place_widths[p])
                if offset < 16 && offset + width > 0 { return false }
            }
        }
        if kind == 16 {
            entry := position == 1 && f.opcodes[op] == 1 && f.dst[op] == 29 && f.a[op] == 31 && f.imm[op] == 0
            reserve := (position == 2 || position == 3) && f.opcodes[op] == 2 && f.dst[op] == 31 && f.a[op] == 31
            leave := f.opcodes[op] == 1 && f.dst[op] == 31 && f.a[op] == 29 && f.imm[op] == 0
            if !entry && !reserve && !leave { return false }
        }
        if kind == 21 && !((position == 0 && f.opcodes[op] == 1) || f.opcodes[op] == 2) { return false }
        if kind != 16 && kind != 21 && kind != 10 && kind != 11 && kind != 14 &&
            !(kind == 15 && abi.internal_return_contract(&f, op)) &&
            f.reads[op].bit_or(f.writes[op]).bit_and(mir.variable_bit(31)) != 0 { return false }
    }
    true
}
// Structural cell predicate, NOT a source-object/alias certificate by itself.
// Use only after source_frame_eligible under a trusted producer Context.
// Cost <=placeCount+constant; callers must budget its use on a bounded shortlist.
pub fn private_cell(f: &mir.Function, place: i32) -> bool {
    if !f.valid || !f.verified || !f.optimizable || f.unknown_control ||
        !contract.frame_place_proven(&f, place) || f.place_widths[place] != 8 || f.place_offsets[place] % 8 != 0 { return false }
    start := i64(f.place_offsets[place]); end := start + 8
    for p in 0..f.place_kinds.len {
        if p == place || f.place_kinds[p] != 1 { continue }
        other := i64(f.place_offsets[p])
        if start < other + i64(f.place_widths[p]) && other < end { return false }
    }
    true
}
