import ../../selfhost/lexer as scanner
import std.sys as sys
import std.parse as parse

fn tag(kind: scanner.Kind) -> i32 {
    match kind {
        .End => 0, .Name => 1, .Keyword => 2, .Integer => 3, .Float => 4,
        .String => 5, .Rune => 6, .Symbol => 7, .Newline => 8,
    }
}
fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    input := sys.read_text(sys.arg(2)); assert(input.ok)
    var lengths: i64 = 0; var kinds: i64 = 0; var spans: i64 = 0; var ids: i64 = 0; var text: i64 = 0
    for round in 0..count {
        intern := round % 2 == 0
        tokens := scanner.scan(input.value, intern); assert(tokens.ok)
        var hash: i64 = 0
        lengths = lengths + i64(tokens.kinds.len)
        for i in 0..tokens.kinds.len {
            kinds = kinds + i64(tag(tokens.kinds[i])) * i64(i + 1)
            spans = spans + i64(tokens.starts[i]) * 3 + i64(tokens.ends[i]) * 5
            if intern { ids = ids + (tokens.ids[i] + 1) * i64(i + 1) }
            for byte in tokens.texts[i].bytes() { hash = (hash * 131 + i64(byte)) % 2147483647 }
        }
        text = text + hash
    }
    print(lengths); print(kinds); print(spans); print(ids); print(text)
}
