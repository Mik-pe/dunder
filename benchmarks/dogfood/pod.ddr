import std.sys as sys
import std.parse as parse

struct Packet { ok: bool, left: i64, right: i64, weight: i32 }
fn produce(value: i64, tag: i32) -> Packet {
    Packet { ok: value % 3 != 0, left: value * 17 + i64(tag), right: value - 11, weight: tag * 2 + 1 }
}
fn refine(value: Packet) -> Packet {
    var result := value
    result.left = value.left + value.right
    result.right = value.left - value.right
    result.weight = value.weight + 2
    if !value.ok { result.left = -result.left }
    result
}
fn consume(value: Packet) -> i64 {
    var answer := value.left * 3 + value.right * 5 + i64(value.weight) * 11
    if value.ok { answer = answer + 7 } else { answer = answer - 7 }
    answer
}
fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    seed := parse.integer(sys.arg(2)).value
    var original: i64 = 0; var snapshot: i64 = 0; var changed: i64 = 0; var cooked: i64 = 0
    for i in 0..count {
        source := produce(seed + i64(i % 97), i % 11)
        saved := source
        var modified := source
        modified.left = modified.left + 29
        modified.right = modified.right - 13
        modified.weight = modified.weight + 3
        modified.ok = !modified.ok
        processed := refine(source)
        // Observe every field after the other copies have been changed.
        original = original + consume(source)
        snapshot = snapshot + consume(saved)
        changed = changed + consume(modified)
        cooked = cooked + consume(processed)
    }
    print(original); print(snapshot); print(changed); print(cooked)
}
