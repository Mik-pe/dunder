import std.sys as sys
import std.parse as parse
import std.text as text
import std.map as map

fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    input := sys.read_text(sys.arg(2)); assert(input.ok)
    keys := text.split(input.value, "\n")
    var current: i64 = 0; var snapshots: i64 = 0; var lengths: i64 = 0; var removed: i64 = 0; var absent: i64 = 0
    for round in 0..count {
        var table := map.new()
        for i in 0..keys.len {
            value := i64(i) * 17 + i64(round)
            map.put(&mut table, keys[i], value)
            if i % 3 == 0 { map.put(&mut table, keys[i], -value - 7) }
        }
        saved := table
        for i in 0..keys.len {
            if i % 4 == 0 { erased := map.remove(&mut table, keys[i]); assert(erased); removed = removed + 1 }
            if i % 5 == 0 { map.put(&mut table, keys[i], i64(round) - i64(i) * 9) }
        }
        lengths = lengths + i64(map.length(&table))
        absent = absent + map.get_or(&table, "not a stored symbol!", 999983)
        for i in 0..keys.len {
            current = current + map.get_or(&table, keys[i], 999983) * i64(i + 1)
            snapshots = snapshots + map.get_or(&saved, keys[i], 999983) * i64(i + 1)
        }
    }
    print(current); print(snapshots); print(lengths); print(removed); print(absent)
}
