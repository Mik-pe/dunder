capability filesystem
import std.sys as sys
import std.parse as parse
import std.text as text

fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    input := sys.read_text(sys.arg(2)); assert(input.ok)
    keys := text.split(input.value, "\n")
    mut current: i64 = 0; mut snapshots: i64 = 0; mut lengths: i64 = 0; mut removed: i64 = 0; mut absent: i64 = 0
    for round in 0..count {
        mut table := Map<string, i64>::new()
        for i in 0..keys.len {
            value := i64(i) * 17 + i64(round)
            table.put(keys[i].clone(), value)
            if i % 3 == 0 { table.put(keys[i].clone(), -value - 7) }
        }
        saved := table.clone()
        for i in 0..keys.len {
            if i % 4 == 0 { erased := table.remove(keys[i]); assert(erased); removed = removed + 1 }
            if i % 5 == 0 { table.put(keys[i].clone(), i64(round) - i64(i) * 9) }
        }
        lengths = lengths + i64(table.len())
        absent = absent + table.get_or("not a stored symbol!", 999983)
        for i in 0..keys.len {
            current = current + table.get_or(keys[i], 999983) * i64(i + 1)
            snapshots = snapshots + saved.get_or(keys[i], 999983) * i64(i + 1)
        }
    }
    print(current); print(snapshots); print(lengths); print(removed); print(absent)
}
