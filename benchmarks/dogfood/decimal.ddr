import std.sys as sys
import std.parse as parse
import std.text as text

fn main() {
    count := i32(parse.integer(sys.arg(1)).value)
    input := sys.read_text(sys.arg(2)); assert(input.ok)
    spellings := text.split(input.value, "\n")
    var accepted: i64 = 0; var invalid: i64 = 0; var overflow: i64 = 0
    var values: i64 = 0; var weighted: i64 = 0; var errors: i64 = 0
    for round in 0..count {
        for i in 0..spellings.len {
            result := parse.integer(spellings[(i + round) % spellings.len])
            if result.ok {
                accepted = accepted + 1
                residue := result.value % 1000003
                values = values + residue
                weighted = weighted + residue * i64(i + 1)
            } else if result.error == 2 { overflow = overflow + 1 }
            else { invalid = invalid + 1 }
            errors = errors + i64(result.error) * i64(i + 1)
        }
    }
    print(accepted); print(invalid); print(overflow); print(values); print(weighted); print(errors)
}
