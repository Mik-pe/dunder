import .zlib
import std.bytes as bytes

@test fn stored_stream_and_output_limit() {
    mut encoded: []u8 = [120, 1, 1, 14, 0, 241, 255, 103, 114, 101, 101, 110, 32, 114, 101, 100, 32, 98, 108, 117, 101, 39, 95, 5, 53]
    expected := bytes.from_text("green red blue")
    actual := zlib.decompress(&encoded, expected.len).unwrap()
    assert(bytes.equal(&actual, &expected))
    assert(zlib.decompress(&encoded, expected.len - 1).is_err())
    encoded[encoded.len - 1] = encoded[encoded.len - 1].bit_xor(1)
    assert(zlib.decompress(&encoded, expected.len).is_err())
}

@test fn fixed_stream_and_output_limit() {
    mut encoded: []u8 = [120, 1, 75, 47, 74, 77, 205, 83, 40, 74, 77, 81, 72, 202, 41, 77, 5, 0, 39, 95, 5, 53]
    expected := bytes.from_text("green red blue")
    actual := zlib.decompress(&encoded, expected.len).unwrap()
    assert(bytes.equal(&actual, &expected))
    assert(zlib.decompress(&encoded, expected.len - 1).is_err())
    encoded[encoded.len - 1] = encoded[encoded.len - 1].bit_xor(1)
    assert(zlib.decompress(&encoded, expected.len).is_err())
}

@test fn dynamic_stream_and_output_limit() {
    mut encoded: []u8 = [120, 218, 237, 204, 219, 9, 192, 48, 12, 67, 209, 85, 180, 90, 30, 194, 13, 13, 54, 152, 150, 144, 237, 155, 45, 250, 163, 95, 93, 113, 44, 73, 71, 178, 163, 206, 151, 216, 156, 51, 22, 34, 139, 27, 207, 84, 218, 141, 117, 141, 135, 24, 222, 135, 5, 218, 73, 19, 150, 220, 168, 25, 203, 81, 57, 206, 211, 196, 136, 17, 35, 70, 140, 24, 49, 98, 196, 136, 17, 35, 70, 204, 159, 204, 7, 109, 235, 23, 108]
    mut expected: []u8 = []
    for _ in 0..50 { bytes.append_utf8(&mut expected, "green red blue yellow orange black white indigo coral grey brown beige ") }
    actual := zlib.decompress(&encoded, expected.len).unwrap()
    assert(bytes.equal(&actual, &expected))
    assert(zlib.decompress(&encoded, expected.len - 1).is_err())
    encoded[encoded.len - 1] = encoded[encoded.len - 1].bit_xor(1)
    assert(zlib.decompress(&encoded, expected.len).is_err())
}
@test fn empty_stream_and_invalid_limits() {
    empty: []u8 = [120, 156, 3, 0, 0, 0, 0, 1]
    assert(zlib.decompress(&empty, 0).unwrap().len == 0)
    assert(zlib.decompress(&empty, -1).is_err())
    assert(zlib.decompress(&empty[0..6], 0).is_err())
}
