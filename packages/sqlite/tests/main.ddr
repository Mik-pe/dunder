capability filesystem

import sqlite
import sys

fn must_exec(db: &sqlite.Database, sql: string, params: &[]sqlite.SqlValue) {
    result := db.exec(sql, &params)
    assert(result.is_ok())
}

fn early_abort_tx(db: &sqlite.Database, insert_name: string) -> Result<(), sqlite.SqliteError> {
    tx := db.begin()?
    none: []sqlite.SqlValue = []
    _ := tx.exec("INSERT INTO tx_items(name) VALUES (?)", &[.Text(insert_name.clone())])?
    // Trigger an intentional error via constraint / missing table so tx drops without commit()
    _ := tx.query("SELECT * FROM missing_table_trigger_abort", &none)?
    .Ok
}

fn scoped_auto_close(path: string) {
    db := sqlite.Database::open(path, false).unwrap()
    _ := db.exec("INSERT INTO tx_items(name) VALUES ('from_scoped')", &[]).unwrap()
    // db disposed automatically on scope exit without calling db.close()
}

fn main() {
    none: []sqlite.SqlValue = []
    path := sys.arg(1)
    mut db := sqlite.Database::open(path, false).unwrap()

    must_exec(&db, "CREATE TABLE items(id INTEGER PRIMARY KEY, value TEXT NOT NULL, number INTEGER, real REAL, absent TEXT)", &none)
    values: []sqlite.SqlValue = [.Text("åäö 雪\0after"), .Int(9223372036854775807), .Real(1.2345678901234567)]
    inserted := db.exec("INSERT INTO items(value,number,real) VALUES(?,?,?)", &values).unwrap()
    assert(inserted.changes == 1 && inserted.last_id == 1)

    empty: []sqlite.SqlValue = [.Text("")]
    must_exec(&db, "INSERT INTO items(value) VALUES(?)", &empty)
    malicious: []sqlite.SqlValue = [.Text("x'); DROP TABLE items; --")]
    must_exec(&db, "INSERT INTO items(value) VALUES(?)", &malicious)

    rows := db.query("SELECT id,value,number,real,absent FROM items ORDER BY id", &none).unwrap()
    assert(rows.len == 3)
    r0 := &rows[0]
    assert(r0.len() == 5)
    assert(r0.column_name(0).unwrap() == "id" && r0.column_index("real").unwrap() == 3)
    assert(r0.get_i64(0).unwrap() == 1 && r0.field_i64("id").unwrap() == 1)
    assert(r0.get_text(1).unwrap() == "åäö 雪\0after" && r0.field_text("value").unwrap() == "åäö 雪\0after")
    assert(r0.field_i64("number").unwrap() == 9223372036854775807)
    assert(r0.field_f64("real").unwrap() == 1.2345678901234567)
    assert(!r0.field_is_null("real").unwrap() && r0.field_is_null("absent").unwrap())
    assert(r0.field_i64("absent").is_err())
    assert(r0.field_text("missing").is_err())

    r1 := &rows[1]
    assert(r1.field_i64("id").unwrap() == 2 && r1.field_text("value").unwrap() == "")
    assert(r1.field_is_null("number").unwrap() && r1.field_is_null("real").unwrap())

    r2 := &rows[2]
    assert(r2.field_i64("id").unwrap() == 3 && r2.field_text("value").unwrap() == "x'); DROP TABLE items; --")

    // query_one: 0, 1, >1 rows
    q_missing := db.query_one("SELECT id FROM items WHERE id=?", &[.Int(999)]).unwrap()
    assert(q_missing.is_none())
    q_single := db.query_one("SELECT value, number FROM items WHERE id=?", &[.Int(1)]).unwrap().unwrap()
    assert(q_single.field_text("value").unwrap() == "åäö 雪\0after")
    assert(db.query_one("SELECT id FROM items", &none).is_err())

    // Null parameter binding
    must_exec(&db, "INSERT INTO items(value, number) VALUES(?, ?)", &[.Text("null-num"), .Null])
    null_row := db.query_one("SELECT number FROM items WHERE value=?", &[.Text("null-num")]).unwrap().unwrap()
    assert(null_row.field_is_null("number").unwrap())

    // Safety checks: single-statement boundary, parameter mismatch, NUL, readonly
    assert(db.exec("DELETE FROM items; DROP TABLE items", &none).is_err())
    assert(db.exec("PRAGMA cache_size=123; DELETE FROM items", &none).is_err())
    cache_row := db.query_one("PRAGMA cache_size", &none).unwrap().unwrap()
    assert(cache_row.get_i64(0).unwrap() != 123)
    assert(db.exec("DELETE FROM items WHERE value=?", &none).is_err())
    assert(db.exec("DELETE FROM items", &empty).is_err())
    assert(db.exec("DELETE FROM items\0", &none).is_err())
    assert(db.query("SELECT missing FROM items", &none).is_err())
    assert(db.query("DELETE FROM items", &none).is_err())

    total_row := db.query_one("SELECT count(*) AS total FROM items", &none).unwrap().unwrap()
    assert(total_row.field_i64("total").unwrap() == 4)

    // exec_batch multi-statement migrations & triggers & mid-batch failure rejection
    batch_sql := "-- migration batch\n" +
        "CREATE TABLE audit(value TEXT);\n" +
        "CREATE TRIGGER record_insert AFTER INSERT ON items BEGIN INSERT INTO audit(value) VALUES('semi;colon'); INSERT INTO audit(value) VALUES(new.value); END;\n" +
        "CREATE TABLE tx_items(id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE);\n"
    assert(db.exec_batch(batch_sql).is_ok())
    assert(db.exec_batch("INSERT INTO tx_items(name) VALUES ('ok_before_err'); SELECT * FROM non_existent_table;").is_err())
    assert(db.exec_batch("SELECT ?").is_err())

    must_exec(&db, "INSERT INTO items(value) VALUES('trigger'); -- trailing comment\n", &none)
    audit := db.query("SELECT value FROM audit ORDER BY rowid", &none).unwrap()
    assert(audit.len == 2 && audit[0].field_text("value").unwrap() == "semi;colon")

    // Direct BLOB binding and direct BLOB column reads without hex()/JSON
    must_exec(&db, "CREATE TABLE binary_values(label TEXT, data BLOB, suffix TEXT)", &none)
    blob_data: []u8 = [0, 1, 127, 128, 255]
    stored := db.exec("INSERT INTO binary_values(label,data,suffix) VALUES(?,?,?)", &[.Text("before"), .Blob(blob_data.clone()), .Text("after")]).unwrap()
    assert(stored.changes == 1)
    bin_row := db.query_one("SELECT label, data, suffix FROM binary_values WHERE label=?", &[.Text("before")]).unwrap().unwrap()
    got_blob := bin_row.field_blob("data").unwrap()
    assert(bin_row.field_text("label").unwrap() == "before" && bin_row.field_text("suffix").unwrap() == "after")
    assert(got_blob.len == 5 && got_blob[0] == 0 && got_blob[1] == 1 && got_blob[2] == 127 && got_blob[3] == 128 && got_blob[4] == 255)

    empty_blob: []u8 = []
    assert(db.exec("INSERT INTO binary_values(label, data) VALUES(?, ?)", &[.Text("empty"), .Blob(empty_blob)]).is_ok())
    eb_row := db.query_one("SELECT data FROM binary_values WHERE label=?", &[.Text("empty")]).unwrap().unwrap()
    assert(eb_row.field_blob("data").unwrap().len == 0)

    // Invalid UTF-8 TEXT rejection and 10,000-row limit
    assert(db.query("SELECT CAST(X'ff' AS TEXT) AS raw", &none).is_err())
    assert(db.query("WITH RECURSIVE n(x) AS(VALUES(0) UNION ALL SELECT x+1 FROM n WHERE x<10000) SELECT x FROM n", &none).is_err())

    // execute_rows RETURNING
    returned := db.execute_rows("INSERT INTO binary_values(label) VALUES('returned') RETURNING label", &none).unwrap()
    assert(returned.len == 1 && returned[0].field_text("label").unwrap() == "returned")

    // Transactions: commit, explicit rollback, auto-rollback on early ? drop, begin_immediate
    {
        mut tx1 := db.begin().unwrap()
        assert(db.begin().is_err())
        assert(db.close().is_err())
        _ := tx1.exec("INSERT INTO tx_items(name) VALUES (?)", &[.Text("committed")]).unwrap()
        assert(tx1.commit().is_ok())
        assert(tx1.commit().is_err())
    }
    assert(db.query_one("SELECT name FROM tx_items WHERE name=?", &[.Text("committed")]).unwrap().is_some())

    {
        mut tx2 := db.begin_immediate().unwrap()
        _ := tx2.exec("INSERT INTO tx_items(name) VALUES (?)", &[.Text("rolled_back")]).unwrap()
        assert(tx2.rollback().is_ok())
    }
    assert(db.query_one("SELECT name FROM tx_items WHERE name=?", &[.Text("rolled_back")]).unwrap().is_none())

    assert(early_abort_tx(&db, "auto_rolled_back").is_err())
    assert(db.query_one("SELECT name FROM tx_items WHERE name=?", &[.Text("auto_rolled_back")]).unwrap().is_none())

    // close & idempotent close & post-close rejection
    assert(db.close().is_ok() && db.close().is_ok())
    assert(db.query("SELECT 1", &none).is_err())
    assert(db.exec("SELECT 1", &none).is_err())

    // Auto-dispose on scope exit
    scoped_auto_close(path)

    // Verify scoped DB write persisted & read-only enforcement
    read_db := sqlite.Database::open(path, true).unwrap()
    assert(read_db.query_one("SELECT name FROM tx_items WHERE name=?", &[.Text("from_scoped")]).unwrap().is_some())
    assert(read_db.exec("DELETE FROM items", &none).is_err())

    bad_open := sqlite.Database::open("invalid\0path", false)
    match bad_open {
        .Ok(_) => assert(false),
        .Err(err) => {
            assert(err.code() != 0 && err.message().len > 0 && f"{err}" == err.message())
            assert(err == sqlite.SqliteError::new(err.code(), err.message()))
        },
    }
    print("sqlite ok")
}
