@thread_safe
unsafe fn sql_open_v2(path: *const ffi.c_char, db: *mut *mut Sqlite3, flags: ffi.c_int, vfs: *const ffi.c_char) -> ffi.c_int {
    if target_is("macos") || target_is("linux") { return c_open_v2(path, db, flags, vfs) }
    -1
}
