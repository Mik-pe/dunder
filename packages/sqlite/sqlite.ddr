fn c_string(value: string) -> []u8 {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, value)
    out.push(0)
    out
}

@thread_safe
unsafe fn copy_text(value: ptr, length: i32) -> string {
    mut out: []u8 = []
    if length < 0 || (length > 0 && value == ptr(0)) { return "" }
    out.reserve(length)
    for i in 0..length { out.push(load_u8(ptr(usize(value) + usize(i)))) }
    bytes.decode(&out).unwrap_or_default()
}

@thread_safe
unsafe fn copy_c_string(value: ptr) -> string {
    if value == ptr(0) { return "" }
    mut length := 0
    while length < 1048576 {
        if load_u8(ptr(usize(value) + usize(length))) == 0 { return copy_text(value, length) }
        length += 1
    }
    ""
}

@thread_safe
unsafe fn failure_error(db: ptr, fallback_code: i32) -> SqliteError {
    if db == ptr(0) {
        return SqliteError::new(if fallback_code != 0 { fallback_code } else { 1 }, "SQLite could not allocate a connection")
    }
    err := sql_errcode(db)
    code := if err != 0 { err } else if fallback_code != 0 { fallback_code } else { 1 }
    SqliteError::new(code, f"SQLite: {copy_c_string(sql_errmsg(db))}")
}

@thread_safe
unsafe fn db_state_alloc(handle: ptr) -> ptr {
    st := sql_malloc(24)
    if usize(st) == usize(0) { return ptr(0) }
    sys.atomic_store_i64(st, 1)
    sys.atomic_store_i64(ptr(usize(st) + usize(8)), i64(usize(handle)))
    sys.atomic_store_i64(ptr(usize(st) + usize(16)), 0)
    st
}

@thread_safe
unsafe fn db_state_handle(st: ptr) -> ptr {
    if usize(st) == usize(0) { return ptr(0) }
    ptr(usize(sys.atomic_load_i64(ptr(usize(st) + usize(8)))))
}

@thread_safe
unsafe fn db_state_release(st: ptr) {
    if usize(st) == usize(0) { return }
    prev := sys.atomic_fetch_add_i64(st, -1)
    if prev == 1 {
        handle := db_state_handle(st)
        if usize(handle) != usize(0) {
            _ := sql_close(handle)
        }
        sql_free(st)
    }
}

fn tail_empty(sql: string, start: i32) -> bool {
    mut i := start
    while i < sql.len {
        byte := sql[i]
        if byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 || byte == 32 || byte == 59 {
            i += 1
        } else if i + 1 < sql.len && byte == 45 && sql[i + 1] == 45 {
            i += 2
            while i < sql.len && sql[i] != 10 { i += 1 }
        } else if i + 1 < sql.len && byte == 47 && sql[i + 1] == 42 {
            i += 2
            while i + 1 < sql.len && !(sql[i] == 42 && sql[i + 1] == 47) { i += 1 }
            if i + 1 >= sql.len { return true }
            i += 2
        } else { return false }
    }
    true
}

enum SqlContext { Statement, Quoted, Bracket, LineComment, BlockComment }

@thread_safe
unsafe fn single_statement(sql: string) -> bool {
    mut prefix: []u8 = []
    prefix.reserve(sql.len + 1)
    mut context: SqlContext = .Statement
    mut quote: u8 = 0
    mut i := 0
    mut terminators := 0
    while i < sql.len {
        byte := u8(sql[i])
        prefix.push(byte)
        if context == .Quoted {
            if byte == quote {
                if i + 1 < sql.len && u8(sql[i + 1]) == quote {
                    i += 1
                    prefix.push(quote)
                } else { context = .Statement }
            }
        } else if context == .Bracket {
            if byte == b']' { context = .Statement }
        } else if context == .LineComment {
            if byte == b'\n' { context = .Statement }
        } else if context == .BlockComment {
            if byte == b'*' && i + 1 < sql.len && u8(sql[i + 1]) == b'/' {
                i += 1
                prefix.push(b'/')
                context = .Statement
            }
        } else if byte == b'\'' || byte == b'"' || byte == b'`' {
            context = .Quoted
            quote = byte
        } else if byte == b'[' { context = .Bracket }
        else if byte == b'-' && i + 1 < sql.len && u8(sql[i + 1]) == b'-' {
            context = .LineComment
        } else if byte == b'/' && i + 1 < sql.len && u8(sql[i + 1]) == b'*' {
            context = .BlockComment
        } else if byte == b';' {
            terminators += 1
            if terminators > 256 { return false }
            prefix.push(0)
            complete := sql_complete(addr(&prefix[0]))
            _ := prefix.pop()
            if complete == 1 { return tail_empty(sql, i + 1) }
        }
        i += 1
    }
    true
}

@thread_safe
unsafe fn prepare_values(db: ptr, sql: string, params: &[]SqlValue) -> Result<ptr, SqliteError> {
    if usize(db) == usize(0) { return .Err(SqliteError::new(21, "SQLite connection is closed")) }
    if sql.len > 1048576 || params.len > 1024 {
        return .Err(SqliteError::new(18, "SQLite statement or parameter count exceeds its limit"))
    }
    for byte in sql.bytes() {
        if byte == 0 { return .Err(SqliteError::new(1, "SQLite statement contains NUL")) }
    }
    if !single_statement(sql) {
        return .Err(SqliteError::new(1, "SQLite calls require one statement"))
    }
    raw := c_string(sql)
    mut statement := ptr(0)
    mut tail := ptr(0)
    code := sql_prepare_v2(db, addr(&raw[0]), raw.len, addr(&mut statement), addr(&mut tail))
    if code != 0 {
        err := failure_error(db, code)
        if usize(statement) != usize(0) { _ := sql_finalize(statement) }
        return .Err(err)
    }
    if usize(tail) != usize(0) {
        start := usize(addr(&raw[0]))
        position := usize(tail)
        if position < start || position > start + usize(sql.len) {
            if usize(statement) != usize(0) { _ := sql_finalize(statement) }
            return .Err(SqliteError::new(1, "SQLite returned an invalid statement tail"))
        }
        if !tail_empty(sql, i32(position - start)) {
            if usize(statement) != usize(0) { _ := sql_finalize(statement) }
            return .Err(SqliteError::new(1, "SQLite calls require one statement"))
        }
    }
    mut expected := 0
    if usize(statement) != usize(0) { expected = sql_bind_parameter_count(statement) }
    if expected != params.len {
        if usize(statement) != usize(0) { _ := sql_finalize(statement) }
        return .Err(SqliteError::new(25, "SQLite parameter count mismatch"))
    }
    transient := ptr(18446744073709551615)
    for i in 0..expected {
        val := &params[i]
        mut bound := 0
        match val {
            .Null => { bound = sql_bind_null(statement, i + 1) },
            .Int(n) => { bound = sql_bind_int64(statement, i + 1, n) },
            .Real(f) => { bound = sql_bind_double(statement, i + 1, f) },
            .Text(s) => {
                if s.len > 16777216 {
                    _ := sql_finalize(statement)
                    return .Err(SqliteError::new(18, "SQLite parameter exceeds its byte limit"))
                }
                encoded := c_string(s)
                bound = sql_bind_text(statement, i + 1, addr(&encoded[0]), encoded.len - 1, transient)
            },
            .Blob(data) => {
                if data.len > 67108864 {
                    _ := sql_finalize(statement)
                    return .Err(SqliteError::new(18, "SQLite parameter exceeds its byte limit"))
                }
                buffer := sql_malloc(if data.len == 0 { 1 } else { data.len })
                if usize(buffer) == 0 {
                    _ := sql_finalize(statement)
                    return .Err(SqliteError::new(7, "SQLite could not allocate blob storage"))
                }
                for byte in 0..data.len { store_u8(ptr(usize(buffer) + usize(byte)), data[byte]) }
                bound = sql_bind_blob(statement, i + 1, buffer, data.len)
            },
        }
        if bound != 0 {
            err := failure_error(db, bound)
            _ := sql_finalize(statement)
            return .Err(err)
        }
    }
    .Ok(statement)
}

@thread_safe
unsafe fn exec_with_handle(handle: ptr, sql: string, params: &[]SqlValue) -> Result<ExecInfo, SqliteError> {
    statement := prepare_values(handle, sql, &params)?
    if usize(statement) != usize(0) {
        defer { _ := sql_finalize(statement) }
        mut step := sql_step(statement)
        while step == 100 { step = sql_step(statement) }
        if step != 101 { return .Err(failure_error(handle, step)) }
    }
    .Ok(ExecInfo { changes: sql_changes64(handle), last_id: sql_last_insert_rowid(handle) })
}

@thread_safe
unsafe fn read_rows_with_handle(handle: ptr, sql: string, params: &[]SqlValue, read_only: bool) -> Result<[]Row, SqliteError> {
    statement := prepare_values(handle, sql, &params)?
    if usize(statement) == usize(0) { return .Ok([]) }
    defer { _ := sql_finalize(statement) }
    if read_only && sql_stmt_readonly(statement) == 0 {
        return .Err(SqliteError::new(1, "SQLite query requires a read-only statement; use exec for writes"))
    }
    columns := sql_column_count(statement)
    mut col_names: []string = []
    col_names.reserve(columns)
    for col in 0..columns {
        col_names.push(copy_c_string(sql_column_name(statement, col)))
    }
    mut rows: []Row = []
    mut total: i64 = 0
    mut step := sql_step(statement)
    while step == 100 {
        if rows.len >= 10000 { return .Err(SqliteError::new(18, "SQLite query exceeds 10000 rows")) }
        mut values: []SqlValue = []
        values.reserve(columns)
        for column in 0..columns {
            kind := sql_column_type(statement, column)
            if kind == 1 {
                total += 8
                values.push(.Int(sql_column_int64(statement, column)))
            } else if kind == 2 {
                total += 8
                values.push(.Real(sql_column_double(statement, column)))
            } else if kind == 3 {
                pointer := sql_column_text(statement, column)
                length := sql_column_bytes(statement, column)
                if length < 0 || length > 16777216 || (length > 0 && usize(pointer) == usize(0)) {
                    return .Err(SqliteError::new(18, "SQLite text exceeds its byte limit"))
                }
                mut raw: []u8 = []
                raw.reserve(length)
                for i in 0..length { raw.push(load_u8(ptr(usize(pointer) + usize(i)))) }
                decoded := match bytes.decode(&raw) {
                    .Ok(value) => value,
                    .Err(_) => { return .Err(SqliteError::new(1, "SQLite TEXT contains invalid UTF-8")) },
                }
                total += i64(length)
                values.push(.Text(decoded))
            } else if kind == 4 {
                pointer := sql_column_blob(statement, column)
                length := sql_column_bytes(statement, column)
                if length < 0 || length > 67108864 || (length > 0 && usize(pointer) == usize(0)) {
                    return .Err(SqliteError::new(18, "SQLite blob exceeds its byte limit"))
                }
                mut raw: []u8 = []
                raw.reserve(length)
                for i in 0..length { raw.push(load_u8(ptr(usize(pointer) + usize(i)))) }
                total += i64(length)
                values.push(.Blob(move raw))
            } else if kind == 5 {
                total += 1
                values.push(.Null)
            } else {
                return .Err(SqliteError::new(1, "SQLite unsupported column type"))
            }
        }
        if total > 67108864 { return .Err(SqliteError::new(18, "SQLite result exceeds 64 MiB")) }
        rows.push(Row { columns: col_names.clone(), values: values })
        step = sql_step(statement)
    }
    if step != 101 { return .Err(failure_error(handle, step)) }
    .Ok(rows)
}

@thread_safe
unsafe fn query_one_with_handle(handle: ptr, sql: string, params: &[]SqlValue) -> Result<Option<Row>, SqliteError> {
    mut rows := read_rows_with_handle(handle, sql, &params, true)?
    if rows.len == 0 { return .Ok(.None) }
    if rows.len > 1 { return .Err(SqliteError::new(1, "SQLite query_one returned more than one row")) }
    .Ok(.Some(rows.pop()))
}

@thread_safe
unsafe fn exec_batch_with_handle(handle: ptr, sql: string) -> Result<(), SqliteError> {
    if usize(handle) == usize(0) { return .Err(SqliteError::new(21, "SQLite connection is closed")) }
    if sql.len > 1048576 {
        return .Err(SqliteError::new(18, "SQLite statement exceeds its byte limit"))
    }
    for byte in sql.bytes() {
        if byte == 0 { return .Err(SqliteError::new(1, "SQLite statement contains NUL")) }
    }
    raw := c_string(sql)
    start_addr := usize(addr(&raw[0]))
    mut offset := 0
    mut count := 0
    while offset < sql.len {
        if tail_empty(sql, offset) { break }
        count += 1
        if count > 1024 { return .Err(SqliteError::new(18, "SQLite batch exceeds 1024 statements")) }
        mut statement := ptr(0)
        mut tail := ptr(0)
        rem_len := (raw.len - 1) - offset
        code := sql_prepare_v2(handle, ptr(start_addr + usize(offset)), rem_len, addr(&mut statement), addr(&mut tail))
        if code != 0 {
            err := failure_error(handle, code)
            if usize(statement) != usize(0) { _ := sql_finalize(statement) }
            return .Err(err)
        }
        mut next_off := sql.len
        if usize(tail) != usize(0) {
            pos := usize(tail)
            if pos < start_addr + usize(offset) || pos > start_addr + usize(sql.len) {
                if usize(statement) != usize(0) { _ := sql_finalize(statement) }
                return .Err(SqliteError::new(1, "SQLite returned an invalid statement tail"))
            }
            next_off = i32(pos - start_addr)
        }
        if usize(statement) != usize(0) {
            if sql_bind_parameter_count(statement) > 0 {
                _ := sql_finalize(statement)
                return .Err(SqliteError::new(25, "SQLite exec_batch does not accept bound parameters"))
            }
            mut step := sql_step(statement)
            while step == 100 { step = sql_step(statement) }
            fin := sql_finalize(statement)
            if step != 101 { return .Err(failure_error(handle, step)) }
            if fin != 0 { return .Err(failure_error(handle, fin)) }
        } else if next_off <= offset {
            return .Err(SqliteError::new(1, "SQLite batch failed to advance"))
        }
        offset = next_off
    }
    .Ok
}

impl Database {
    @requires(filesystem)
    @thread_safe
    pub fn open(path: string, read_only: bool) -> Result<Database, SqliteError> {
        if !target_is("native") {
            return .Err(SqliteError::new(1, "SQLite requires a native target"))
        }
        if path.len == 0 || path.len > 4096 {
            return .Err(SqliteError::new(1, "invalid SQLite path"))
        }
        for byte in path.bytes() {
            if byte == 0 {
                return .Err(SqliteError::new(1, "SQLite path contains NUL"))
            }
        }
        raw := c_string(path)
        unsafe {
            mut handle := ptr(0)
            open_readonly := 0x1
            open_readwrite := 0x2
            open_create := 0x4
            open_fullmutex := 0x10000
            access := if read_only { open_readonly } else { open_readwrite.bit_or(open_create) }
            flags := open_fullmutex.bit_or(access)
            code := sql_open_v2(addr(&raw[0]), addr(&mut handle), flags, ptr(0))
            if code != 0 {
                err := failure_error(handle, code)
                if usize(handle) != usize(0) { _ := sql_close(handle) }
                return .Err(err)
            }
            if sql_busy_timeout(handle, 5000) != 0 {
                err := failure_error(handle, 1)
                _ := sql_close(handle)
                return .Err(err)
            }
            st := db_state_alloc(handle)
            if usize(st) == usize(0) {
                _ := sql_close(handle)
                return .Err(SqliteError::new(7, "SQLite could not allocate connection state"))
            }
            if read_only {
                empty: []SqlValue = []
                res := exec_with_handle(handle, "PRAGMA query_only=ON", &empty)
                match res {
                    .Ok(_) => {},
                    .Err(err) => {
                        db_state_release(st)
                        return .Err(err)
                    },
                }
            }
            return .Ok(Self { state: st })
        }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn close(&mut self) -> Result<(), SqliteError> {
        unsafe {
            st := self.state
            if usize(st) == usize(0) { return .Ok }
            if sys.atomic_load_i64(ptr(usize(st) + usize(16))) != 0 {
                return .Err(SqliteError::new(1, "cannot close SQLite database while a transaction is active"))
            }
            handle := db_state_handle(st)
            if usize(handle) != usize(0) {
                code := sql_close(handle)
                if code != 0 { return .Err(failure_error(handle, code)) }
                sys.atomic_store_i64(ptr(usize(st) + usize(8)), 0)
            }
            self.state = ptr(0)
            db_state_release(st)
        }
        .Ok
    }

    @thread_safe
    fn dispose(&mut self) {
        unsafe {
            st := self.state
            self.state = ptr(0)
            db_state_release(st)
        }
    }

    @thread_safe
    pub fn exec(&self, sql: string, params: &[]SqlValue) -> Result<ExecInfo, SqliteError> {
        unsafe { return exec_with_handle(db_state_handle(self.state), sql, &params) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn query(&self, sql: string, params: &[]SqlValue) -> Result<[]Row, SqliteError> {
        unsafe { return read_rows_with_handle(db_state_handle(self.state), sql, &params, true) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn query_one(&self, sql: string, params: &[]SqlValue) -> Result<Option<Row>, SqliteError> {
        unsafe { return query_one_with_handle(db_state_handle(self.state), sql, &params) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn execute_rows(&self, sql: string, params: &[]SqlValue) -> Result<[]Row, SqliteError> {
        unsafe { return read_rows_with_handle(db_state_handle(self.state), sql, &params, false) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn exec_batch(&self, sql: string) -> Result<(), SqliteError> {
        unsafe { return exec_batch_with_handle(db_state_handle(self.state), sql) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    fn begin_with(&self, sql: string) -> Result<Transaction, SqliteError> {
        unsafe {
            st := self.state
            handle := db_state_handle(st)
            if usize(handle) == usize(0) {
                return .Err(SqliteError::new(21, "SQLite connection is closed"))
            }
            if sys.atomic_load_i64(ptr(usize(st) + usize(16))) != 0 {
                return .Err(SqliteError::new(1, "SQLite transaction is already active"))
            }
            empty: []SqlValue = []
            _ := exec_with_handle(handle, sql, &empty)?
            _ := sys.atomic_fetch_add_i64(st, 1)
            sys.atomic_store_i64(ptr(usize(st) + usize(16)), 1)
            return .Ok(Transaction { state: st, active: true })
        }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn begin(&self) -> Result<Transaction, SqliteError> { self.begin_with("BEGIN") }

    @thread_safe
    pub fn begin_immediate(&self) -> Result<Transaction, SqliteError> { self.begin_with("BEGIN IMMEDIATE") }
}

impl Transaction {
    @thread_safe
    fn active_handle(&self) -> Result<ptr, SqliteError> {
        if !self.active {
            return .Err(SqliteError::new(21, "SQLite transaction is no longer active"))
        }
        unsafe {
            if usize(self.state) == usize(0) {
                return .Err(SqliteError::new(21, "SQLite transaction is no longer active"))
            }
            handle := db_state_handle(self.state)
            if usize(handle) == usize(0) {
                return .Err(SqliteError::new(21, "SQLite connection is closed"))
            }
            return .Ok(handle)
        }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn exec(&self, sql: string, params: &[]SqlValue) -> Result<ExecInfo, SqliteError> {
        handle := self.active_handle()?
        unsafe { return exec_with_handle(handle, sql, &params) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn query(&self, sql: string, params: &[]SqlValue) -> Result<[]Row, SqliteError> {
        handle := self.active_handle()?
        unsafe { return read_rows_with_handle(handle, sql, &params, true) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn query_one(&self, sql: string, params: &[]SqlValue) -> Result<Option<Row>, SqliteError> {
        handle := self.active_handle()?
        unsafe { return query_one_with_handle(handle, sql, &params) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn execute_rows(&self, sql: string, params: &[]SqlValue) -> Result<[]Row, SqliteError> {
        handle := self.active_handle()?
        unsafe { return read_rows_with_handle(handle, sql, &params, false) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn exec_batch(&self, sql: string) -> Result<(), SqliteError> {
        handle := self.active_handle()?
        unsafe { return exec_batch_with_handle(handle, sql) }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn commit(&mut self) -> Result<(), SqliteError> {
        handle := self.active_handle()?
        unsafe {
            empty: []SqlValue = []
            _ := exec_with_handle(handle, "COMMIT", &empty)?
            self.active = false
            sys.atomic_store_i64(ptr(usize(self.state) + usize(16)), 0)
            return .Ok
        }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    pub fn rollback(&mut self) -> Result<(), SqliteError> {
        handle := self.active_handle()?
        unsafe {
            self.active = false
            sys.atomic_store_i64(ptr(usize(self.state) + usize(16)), 0)
            empty: []SqlValue = []
            _ := exec_with_handle(handle, "ROLLBACK", &empty)?
            return .Ok
        }
        .Err(SqliteError::new(1, "SQLite requires a native target"))
    }

    @thread_safe
    fn dispose(&mut self) {
        unsafe {
            st := self.state
            if usize(st) != usize(0) {
                if self.active {
                    self.active = false
                    sys.atomic_store_i64(ptr(usize(st) + usize(16)), 0)
                    handle := db_state_handle(st)
                    if usize(handle) != usize(0) {
                        empty: []SqlValue = []
                        _ := exec_with_handle(handle, "ROLLBACK", &empty)
                    }
                }
                self.state = ptr(0)
                db_state_release(st)
            }
        }
    }
}
