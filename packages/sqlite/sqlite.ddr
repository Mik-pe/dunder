capability filesystem, unsafe

import std.bytes as bytes
import sys

pub struct SqliteError {
    code: i32,
    message: string,
}

impl SqliteError {
    pub fn new(code: i32, message: string) -> Self {
        Self { code: code, message: message.clone() }
    }

    pub fn code(&self) -> i32 { self.code }
    pub fn message(&self) -> string { self.message.clone() }
}

impl Display for SqliteError {
    fn str(&self) -> string { self.message.clone() }
}

impl Eq for SqliteError {
    fn eq(&self, other: &Self) -> bool { self.code == other.code && self.message == other.message }
}

pub struct ExecInfo {
    changes: i64,
    last_id: i64,
}

pub enum SqlValue {
    Null,
    Int(i64),
    Real(f64),
    Text(string),
    Blob([]u8),
}

impl SqlValue {
    pub fn is_null(&self) -> bool {
        match self {
            .Null => true,
            _ => false,
        }
    }

    pub fn as_i64(&self) -> Option<i64> {
        match self {
            .Int(v) => .Some(v),
            _ => .None,
        }
    }

    pub fn as_f64(&self) -> Option<f64> {
        match self {
            .Real(v) => .Some(v),
            _ => .None,
        }
    }

    pub fn as_text(&self) -> Option<string> {
        match self {
            .Text(v) => .Some(v.clone()),
            _ => .None,
        }
    }

    pub fn as_blob(&self) -> Option<[]u8> {
        match self {
            .Blob(v) => .Some(v.clone()),
            _ => .None,
        }
    }
}

pub struct Row {
    columns: []string,
    values: []SqlValue,
}

impl Row {
    pub fn len(&self) -> i32 { self.values.len }

    pub fn column_name(&self, index: i32) -> Option<string> {
        if index < 0 || index >= self.columns.len { return .None }
        .Some(self.columns[index].clone())
    }

    pub fn column_index(&self, name: string) -> Option<i32> {
        for i in 0..self.columns.len {
            if self.columns[i] == name { return .Some(i) }
        }
        .None
    }

    pub fn value(&self, index: i32) -> Option<SqlValue> {
        if index < 0 || index >= self.values.len { return .None }
        .Some(self.values[index].clone())
    }

    pub fn by_name(&self, name: string) -> Option<SqlValue> {
        idx := self.column_index(name)?
        self.value(idx)
    }

    pub fn is_null(&self, index: i32) -> Result<bool, SqliteError> {
        if index < 0 || index >= self.values.len {
            return .Err(SqliteError::new(1, f"SQLite column index {index} out of range"))
        }
        .Ok(self.values[index].is_null())
    }

    pub fn get_i64(&self, index: i32) -> Result<i64, SqliteError> {
        if index < 0 || index >= self.values.len {
            return .Err(SqliteError::new(1, f"SQLite column index {index} out of range"))
        }
        match self.values[index].as_i64() {
            .Some(v) => .Ok(v),
            .None => .Err(SqliteError::new(1, f"SQLite column {index} is not an integer")),
        }
    }

    pub fn get_f64(&self, index: i32) -> Result<f64, SqliteError> {
        if index < 0 || index >= self.values.len {
            return .Err(SqliteError::new(1, f"SQLite column index {index} out of range"))
        }
        match self.values[index].as_f64() {
            .Some(v) => .Ok(v),
            .None => .Err(SqliteError::new(1, f"SQLite column {index} is not a real")),
        }
    }

    pub fn get_text(&self, index: i32) -> Result<string, SqliteError> {
        if index < 0 || index >= self.values.len {
            return .Err(SqliteError::new(1, f"SQLite column index {index} out of range"))
        }
        match self.values[index].as_text() {
            .Some(v) => .Ok(v),
            .None => .Err(SqliteError::new(1, f"SQLite column {index} is not text")),
        }
    }

    pub fn get_blob(&self, index: i32) -> Result<[]u8, SqliteError> {
        if index < 0 || index >= self.values.len {
            return .Err(SqliteError::new(1, f"SQLite column index {index} out of range"))
        }
        match self.values[index].as_blob() {
            .Some(v) => .Ok(v),
            .None => .Err(SqliteError::new(1, f"SQLite column {index} is not a blob")),
        }
    }

    pub fn field_is_null(&self, name: string) -> Result<bool, SqliteError> {
        match self.column_index(name.clone()) {
            .Some(idx) => self.is_null(idx),
            .None => .Err(SqliteError::new(1, "SQLite column not found: " + name)),
        }
    }

    pub fn field_i64(&self, name: string) -> Result<i64, SqliteError> {
        match self.column_index(name.clone()) {
            .Some(idx) => self.get_i64(idx),
            .None => .Err(SqliteError::new(1, "SQLite column not found: " + name)),
        }
    }

    pub fn field_f64(&self, name: string) -> Result<f64, SqliteError> {
        match self.column_index(name.clone()) {
            .Some(idx) => self.get_f64(idx),
            .None => .Err(SqliteError::new(1, "SQLite column not found: " + name)),
        }
    }

    pub fn field_text(&self, name: string) -> Result<string, SqliteError> {
        match self.column_index(name.clone()) {
            .Some(idx) => self.get_text(idx),
            .None => .Err(SqliteError::new(1, "SQLite column not found: " + name)),
        }
    }

    pub fn field_blob(&self, name: string) -> Result<[]u8, SqliteError> {
        match self.column_index(name.clone()) {
            .Some(idx) => self.get_blob(idx),
            .None => .Err(SqliteError::new(1, "SQLite column not found: " + name)),
        }
    }
}

@resource(dispose)
pub opaque struct Database { state: ptr }
impl Sendable for Database {}

@resource(dispose)
pub opaque struct Transaction { state: ptr, active: bool }

@extern("/usr/lib/libsqlite3.dylib", "sqlite3_open_v2")
@thread_safe
unsafe fn mac_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32
@extern("libsqlite3.so.0", "sqlite3_open_v2")
@thread_safe
unsafe fn linux_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32
@thread_safe
unsafe fn sql_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32 {
    if target_is("macos") { return mac_open_v2(path, db, flags, vfs) }
    if target_is("linux") { return linux_open_v2(path, db, flags, vfs) }
    -1
}

