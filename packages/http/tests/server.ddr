capability network

import http
import std.bytes as bytes
import std.net as net
import std.parse as parse
import sys

fn check_body_reader_constructor() {
    head := http.Request { ok: true, status: 200, method: "GET", target: "/", header_names: ["host", "content-length"], header_values: ["localhost", "0"], body: [], error: "" }
    huge_timeout := http.BodyReader::new(&head, 0, 9223372036854775807)
    assert(!huge_timeout.ok() && huge_timeout.status() == 500)
    negative_timeout := http.BodyReader::new(&head, 0, -1)
    assert(!negative_timeout.ok() && negative_timeout.status() == 500)
    negative_limit := http.BodyReader::new(&head, -1, 1000)
    assert(!negative_limit.ok() && negative_limit.status() == 500)
    empty := http.BodyReader::new(&head, 0, 1000)
    assert(empty.ok() && empty.count() == 0)
}

fn read(stream: &net.TcpStream, limit: i32, timeout: i64, head_only: bool, split: bool, streaming: bool) -> http.Request {
    if head_only { return http.read_head(&stream, timeout) }
    if streaming {
        mut head := http.read_head(&stream, timeout)
        if !head.ok { return head }
        mut body := http.BodyReader::new(&head, i64(limit), timeout)
        if !body.ok() { head.ok = false; head.status = body.status(); head.error = body.error(); return head }
        mut chunk: []u8 = []
        while true {
            result := body.read(&stream, &mut chunk, 3)
            if !result.ok { head.ok = false; head.status = result.status; head.error = result.error; return head }
            assert(result.count <= 3)
            if result.eof { assert(result.count == 0); assert(body.count() == i64(head.body.len)); return head }
            assert(result.count == i64(chunk.len) && result.count > 0)
            bytes.extend(&mut head.body, &chunk)
        }
    }
    if split {
        head := http.read_head(&stream, timeout)
        return http.read_body(&stream, move head, limit, timeout)
    }
    http.read_request(&stream, limit, timeout)
}

fn main() -> i32 {
    check_body_reader_constructor()
    mut limit := 16
    mut timeout: i64 = 2000
    if sys.arg_count() > 1 { limit = i32(parse.integer(sys.arg(1)).value) }
    if sys.arg_count() > 2 { timeout = parse.integer(sys.arg(2)).value }
    head_only := sys.arg_count() > 3 && sys.arg(3) == "head"
    split := sys.arg_count() > 3 && sys.arg(3) == "split"
    streaming := sys.arg_count() > 3 && sys.arg(3) == "stream"
    result := net.TcpListener::listen(net.loopback(), 0, 16)
    if !result.ok { return 1 }
    mut listener := result.listener
    defer { unused := listener.close() }
    print(listener.local_port())
    accepted := listener.accept()
    if !accepted.ok { return 2 }
    mut stream := accepted.stream
    defer { unused := stream.close() }
    request := read(&stream, limit, timeout, head_only, split, streaming)
    mut payload: []u8 = []
    mut status := request.status
    mut names: []string = ["X-Test"]
    mut values: []string = ["dunder"]
    if request.ok {
        bytes.append_utf8(&mut payload, request.method + " " + request.target + "\n" + http.header(&request, "AUTHORIZATION") + "\n")
        if request.target == "/cookies" {
            cookies := http.headers(&request, "Cookie")
            for i in 0..cookies.len {
                if i > 0 { bytes.append_utf8(&mut payload, "|") }
                bytes.append_utf8(&mut payload, cookies[i].clone())
            }
        }
        bytes.extend(&mut payload, &request.body)
        if head_only {
            assert(request.body.len == 0)
            mut poll := net.PollSet::new()
            poll.add(stream.fd(), net.poll_in())
            while true {
                ready := poll.poll(2000)
                if !ready.ok || ready.count == 0 { return 4 }
                result := stream.read_append(&mut payload, 8192)
                if result.eof { break }
                if !result.ok && !result.would_block { return 5 }
            }
        }
        status = 200
        if request.target == "/empty" { status = 204 }
        else if request.target == "/redirect-303" { status = 303; names.push("Location"); values.push("/next") }
        else if request.target == "/redirect-307" { status = 307; names.push("Location"); values.push("/next") }
        else if request.target == "/redirect-308" { status = 308; names.push("Location"); values.push("/next") }
    } else { bytes.append_utf8(&mut payload, request.error) }
    if !http.write_response(&stream, status, "application/octet-stream", &names, &values, &payload, request.method == "HEAD") { return 3 }
    0
}
