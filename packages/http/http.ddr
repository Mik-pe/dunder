capability network, unsafe

import std.base64 as base64
import std.bytes as bytes
import std.ffi as ffi
import std.net as net
import std.parse as parse
import std.sync as sync
import std.text as text
import sys

pub struct Request {
    ok: bool,
    status: i32,
    method: string,
    target: string,
    header_names: []string,
    header_values: []string,
    body: []u8,
    error: string,
}

struct Reader {
    buffer: []u8,
    offset: i32,
    deadline: i64,
    status: i32,
    error: string,
}

pub opaque struct BodyReader {
    reader: Reader,
    remaining: i64,
    chunked: bool,
    chunk_remaining: i64,
    total: i64,
    maximum: i64,
    finished: bool,
    started: bool,
    expect_continue: bool,
    valid: bool,
}

pub struct BodyResult { ok: bool, eof: bool, count: i64, status: i32, error: string }

@repr(C)
struct Timespec { seconds: i64, nanos: i64 }

@link("c")
extern "C" {
    @thread_safe
    fn clock_gettime(clock: ffi.c_int, result: *mut Timespec) -> ffi.c_int
}

@thread_safe
fn now_ms() -> i64 {
    if target_is("macos") || target_is("linux") {
        unsafe {
            mut value: Timespec = ffi.zeroed<Timespec>()
            clock: ffi.c_int = if target_is("macos") { 6 } else { 1 }
            if clock_gettime(clock, addr_of(&mut value)) == 0 {
                return value.seconds * 1000 + value.nanos / 1000000
            }
        }
    }
    sys.now_ms()
}

fn fail(status: i32, message: string) -> Request {
    Request {
        ok: false, status: status, method: "", target: "",
        header_names: [], header_values: [], body: [], error: message.clone(),
    }
}

fn token(value: string) -> bool {
    if value.len == 0 { return false }
    for b in value.bytes() {
        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) { continue }
        if b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126 { continue }
        return false
    }
    true
}

fn lower(value: string) -> string {
    mut out: []u8 = []
    out.reserve(value.len)
    for b in value.bytes() {
        if b >= 65 && b <= 90 { out.push(u8(b + 32)) }
        else { out.push(u8(b)) }
    }
    bytes.decode(&out).unwrap_or_default()
}

fn trim_ows(value: string) -> string {
    mut start := 0
    mut end := value.len
    while start < end && (value[start] == 32 || value[start] == 9) { start += 1 }
    while end > start && (value[end - 1] == 32 || value[end - 1] == 9) { end -= 1 }
    value[start..end]
}

fn valid_value(value: string) -> bool {
    for b in value.bytes() {
        if (b < 32 && b != 9) || b == 127 { return false }
    }
    true
}

fn control_header(name: string) -> bool {
    name == "host" || name == "authorization" || name == "proxy-authorization" || name == "content-length" || name == "transfer-encoding" || name == "content-type" || name == "expect" || name == "origin" || name == "connection"
}

fn singleton(name: string) -> bool {
    control_header(name) || text.starts_with(name, "x-")
}

fn control_trailer(name: string) -> bool {
    control_header(name) || (text.starts_with(name, "x-") && text.ends_with(name, "-token")) || name == "trailer" || name == "te" || name == "upgrade" || name == "keep-alive" || name == "proxy-connection"
}

fn wait_ready(stream: &net.TcpStream, events: i32, deadline: i64) -> bool {
    mut poll := net.PollSet::new()
    poll.add(stream.fd(), events)
    while true {
        remaining := deadline - now_ms()
        if remaining <= 0 { return false }
        mut delay := remaining
        if delay > 2147483647 { delay = 2147483647 }
        match poll.poll(i32(delay)) {
            .Ok(count) => { return count > 0 },
            .Err(err) => { if err != sys.IoError.Interrupted { return false } },
        }
    }
    false
}

fn fill(stream: &net.TcpStream, reader: &mut Reader, limit: i32) -> bool {
    if reader.buffer.len >= limit {
        reader.status = 431
        reader.error = "HTTP framing exceeds its limit"
        return false
    }
    while true {
        if now_ms() >= reader.deadline {
            reader.status = 408
            reader.error = "request deadline exceeded"
            return false
        }
        mut amount := limit - reader.buffer.len
        if amount > 8192 { amount = 8192 }
        match stream.read_append(&mut reader.buffer, amount) {
            .Ok(count) => {
                if count > 0 { return true }
                reader.status = 400
                reader.error = "truncated HTTP request"
                return false
            },
            .Err(err) => {
                if err == sys.IoError.Interrupted { continue }
                if !err.is_would_block() {
                    reader.status = 400
                    reader.error = "cannot read HTTP request"
                    return false
                }
            },
        }
        if !wait_ready(&stream, net.poll_in(), reader.deadline) {
            reader.status = 408
            reader.error = "request deadline exceeded"
            return false
        }
    }
    false
}

fn read_line(stream: &net.TcpStream, reader: &mut Reader, maximum: i32, limit: i32) -> Result<string, sys.IoError> {
    while true {
        end := bytes.find_crlf(&reader.buffer, reader.offset, reader.buffer.len).unwrap_or(-1)
        newline := bytes.find_byte(&reader.buffer, reader.offset, reader.buffer.len, b'\n').unwrap_or(-1)
        if newline >= 0 && (end < 0 || newline != end + 1) {
            reader.status = 400
            reader.error = "HTTP lines require CRLF"
            return .Err(.InvalidArgument)
        }
        if end >= 0 {
            if end - reader.offset > maximum || end + 2 > limit {
                reader.status = 431
                reader.error = "HTTP line exceeds its limit"
                return .Err(.InvalidArgument)
            }
            result := bytes.decode_range(&reader.buffer, reader.offset, end)
            reader.offset = end + 2
            if result.is_err() {
                reader.status = 400
                reader.error = "invalid UTF-8 in HTTP head"
            }
            return result
        }
        if reader.buffer.len - reader.offset > maximum + 1 {
            reader.status = 431
            reader.error = "HTTP line exceeds its limit"
            return .Err(.InvalidArgument)
        }
        if !fill(&stream, &mut reader, limit) {
            return .Err(.InvalidArgument)
        }
    }
    .Err(.InvalidArgument)
}

struct HeaderPart { ok: bool, name: string, value: string }

fn header_parts(line: string) -> HeaderPart {
    colon := text.find(line, ":").unwrap_or(-1)
    if colon <= 0 { return HeaderPart { ok: false, name: "", value: "" } }
    name := lower(line[0..colon])
    value := trim_ows(line[colon + 1..line.len])
    if !token(name) || !valid_value(value) { return HeaderPart { ok: false, name: "", value: "" } }
    HeaderPart { ok: true, name: name, value: value }
}

fn append_header(req: &mut Request, line: string) -> bool {
    part := header_parts(line)
    if !part.ok { return false }
    if singleton(part.name) {
        for previous in &req.header_names { if previous == part.name { return false } }
    }
    req.header_names.push(move part.name)
    req.header_values.push(move part.value)
    true
}

pub fn header(req: &Request, name: string) -> string {
    wanted := lower(name)
    for i in 0..req.header_names.len {
        if req.header_names[i] == wanted { return req.header_values[i].clone() }
    }
    ""
}

pub fn headers(req: &Request, name: string) -> []string {
    wanted := lower(name)
    mut result: []string = []
    for i in 0..req.header_names.len {
        if req.header_names[i] == wanted { result.push(req.header_values[i].clone()) }
    }
    result
}

fn has_header(req: &Request, name: string) -> bool {
    for current in &req.header_names { if current == name { return true } }
    false
}

fn decimal(value: string, maximum: i64) -> i64 {
    if value.len == 0 || value.len > 20 { return -1 }
    number := parse.u64_range(value, 0, value.len)
    if !number.ok { return -1 }
    if number.value > u64(maximum) { return -2 }
    i64(number.value)
}

fn chunk_size(value: string, maximum: i64) -> i64 {
    semicolon := text.find(value, ";").unwrap_or(-1)
    mut end := value.len
    if semicolon >= 0 { end = semicolon }
    if end == 0 || end > 16 || !valid_value(value) { return -1 }
    number := parse.hex_u64_range(value, 0, end)
    if !number.ok { return -1 }
    if number.value > u64(maximum) { return -2 }
    i64(number.value)
}

fn read_exact(stream: &net.TcpStream, reader: &mut Reader, out: &mut []u8, count: i32) -> bool {
    mut left := count
    while left > 0 {
        if reader.offset == reader.buffer.len {
            reader.buffer.clear()
            reader.offset = 0
            if !fill(&stream, &mut reader, left) { return false }
        }
        mut amount := reader.buffer.len - reader.offset
        if amount > left { amount = left }
        bytes.extend_range(&mut out, &reader.buffer, reader.offset, reader.offset + amount)
        reader.offset += amount
        left -= amount
    }
    true
}

fn parse_head(stream: &net.TcpStream, reader: &mut Reader, max_body: i64) -> Request {
    first := match read_line(&stream, &mut reader, 8192, 32768) {
        .Ok(value) => value,
        .Err(_) => { return fail(reader.status, reader.error) },
    }
    mut parts := text.split(first, " ")
    if parts.len != 3 { return fail(400, "invalid HTTP request line") }
    version := parts.pop()
    target := parts.pop()
    method := parts.pop()
    if !token(method) || (version != "HTTP/1.0" && version != "HTTP/1.1") { return fail(400, "invalid HTTP request line") }
    if !text.starts_with(target, "/") { return fail(400, "HTTP target requires origin form") }
    for b in target.bytes() {
        if b <= 32 || b == 127 || b == 35 || b == 92 { return fail(400, "invalid HTTP request target") }
    }
    mut req := Request {
        ok: true, status: 200, method: method, target: target,
        header_names: [], header_values: [], body: [], error: "",
    }
    while true {
        line := match read_line(&stream, &mut reader, 8192, 32768) {
            .Ok(value) => value,
            .Err(_) => { return fail(reader.status, reader.error) },
        }
        if line.len == 0 { break }
        if req.header_names.len >= 100 { return fail(431, "too many HTTP headers") }
        if !append_header(&mut req, line) { return fail(400, "invalid or duplicate HTTP header") }
    }
    if version == "HTTP/1.1" && header(&req, "host").len == 0 { return fail(400, "Host required") }
    transfer := lower(header(&req, "transfer-encoding"))
    has_transfer := has_header(&req, "transfer-encoding")
    has_length := has_header(&req, "content-length")
    if has_transfer && (transfer != "chunked" || has_length) { return fail(400, "ambiguous or unsupported HTTP body framing") }
    mut size: i64 = 0
    if has_length {
        size = decimal(header(&req, "content-length"), max_body)
        if size == -1 { return fail(400, "invalid Content-Length") }
        if size == -2 { return fail(413, "request body exceeds its limit") }
    }
    if has_header(&req, "expect") {
        if lower(header(&req, "expect")) != "100-continue" { return fail(417, "unsupported Expect header") }
    }
    req
}

fn compact(reader: &mut Reader) {
    if reader.offset > 0 {
        count := reader.offset
        bytes.consume_prefix(&mut reader.buffer, count)
        reader.offset = 0
    }
}

fn body_result(ok: bool, eof: bool, count: i64, status: i32, error: string) -> BodyResult {
    BodyResult { ok: ok, eof: eof, count: count, status: status, error: error.clone() }
}

impl BodyReader {
    pub fn new(head: &Request, max_bytes: i64, timeout_ms: i64) -> Self {
        mut value := Self {
            reader: Reader { buffer: [], offset: 0, deadline: 0, status: 200, error: "" },
            remaining: 0, chunked: false, chunk_remaining: 0, total: 0, maximum: max_bytes,
            finished: false, started: false, expect_continue: false, valid: true,
        }
        if max_bytes < 0 || timeout_ms <= 0 || timeout_ms > 3600000 {
            value.reject(500, "invalid HTTP reader limits"); return value
        }
        value.reader.deadline = now_ms() + timeout_ms
        if !head.ok { value.reject(head.status, head.error); return value }
        if head.body.len != 0 || head.header_names.len != head.header_values.len {
            value.reject(500, "BodyReader requires an unconsumed request head"); return value
        }
        value.chunked = has_header(&head, "transfer-encoding")
        has_length := has_header(&head, "content-length")
        if value.chunked && (lower(header(&head, "transfer-encoding")) != "chunked" || has_length) {
            value.reject(400, "ambiguous or unsupported HTTP body framing"); return value
        }
        if has_length {
            size := decimal(header(&head, "content-length"), max_bytes)
            if size == -1 { value.reject(400, "invalid Content-Length"); return value }
            if size == -2 { value.reject(413, "request body exceeds its limit"); return value }
            value.remaining = size
        }
        if has_header(&head, "expect") {
            if lower(header(&head, "expect")) != "100-continue" {
                value.reject(417, "unsupported Expect header"); return value
            }
            value.expect_continue = true
        }
        value
    }

    pub fn ok(&self) -> bool { self.valid }
    pub fn status(&self) -> i32 { self.reader.status }
    pub fn error(&self) -> string { self.reader.error.clone() }
    pub fn count(&self) -> i64 { self.total }

    fn reject(&mut self, status: i32, message: string) {
        self.valid = false
        self.reader.status = status
        self.reader.error = message.clone()
    }

    fn failed(&mut self) -> BodyResult {
        self.valid = false
        body_result(false, false, 0, self.reader.status, self.reader.error)
    }

    fn finish_trailers(&mut self, stream: &net.TcpStream) -> bool {
        mut trailer_bytes := 0; mut trailer_count := 0
        while true {
            compact(&mut self.reader)
            trailer := match read_line(&stream, &mut self.reader, 8192, 8194) {
                .Ok(value) => value,
                .Err(_) => { return false },
            }
            trailer_bytes += trailer.len + 2
            if trailer_bytes > 8192 { self.reject(431, "HTTP trailers exceed their limit"); return false }
            if trailer.len == 0 { self.finished = true; return true }
            trailer_count += 1
            if trailer_count > 20 { self.reject(431, "too many HTTP trailers"); return false }
            part := header_parts(trailer)
            if !part.ok { self.reject(400, "invalid HTTP trailer"); return false }
            if control_trailer(part.name) { self.reject(400, "HTTP control trailer refused"); return false }
        }
        false
    }

    pub fn read(&mut self, stream: &net.TcpStream, chunk: &mut []u8, max_chunk: i32) -> BodyResult {
        chunk.clear()
        if !self.valid { return self.failed() }
        if max_chunk < 1 || max_chunk > 1048576 { self.reject(500, "invalid HTTP chunk buffer limit"); return self.failed() }
        if self.finished { return body_result(true, true, 0, 200, "") }
        if !stream.set_nonblocking(true).ok { self.reject(500, "cannot configure HTTP stream"); return self.failed() }
        if !self.started {
            self.started = true
            if self.expect_continue {
                mut interim: []u8 = []
                bytes.append_utf8(&mut interim, "HTTP/1.1 100 Continue\r\n\r\n")
                remaining := self.reader.deadline - now_ms()
                if remaining <= 0 || !write_all(&stream, &interim, remaining) {
                    self.reject(408, "cannot send HTTP continue"); return self.failed()
                }
            }
        }
        if now_ms() >= self.reader.deadline { self.reject(408, "request deadline exceeded"); return self.failed() }
        if self.chunked && self.chunk_remaining == 0 {
            compact(&mut self.reader)
            line := match read_line(&stream, &mut self.reader, 1024, 1026) {
                .Ok(value) => value,
                .Err(_) => { return self.failed() },
            }
            size := chunk_size(line, self.maximum - self.total)
            if size == -1 { self.reject(400, "invalid HTTP chunk size"); return self.failed() }
            if size == -2 { self.reject(413, "request body exceeds its limit"); return self.failed() }
            if size == 0 {
                if !self.finish_trailers(&stream) { return self.failed() }
                return body_result(true, true, 0, 200, "")
            }
            self.chunk_remaining = size
        }
        mut amount := self.remaining
        if self.chunked { amount = self.chunk_remaining }
        if amount == 0 { self.finished = true; return body_result(true, true, 0, 200, "") }
        if amount > i64(max_chunk) { amount = i64(max_chunk) }
        if !read_exact(&stream, &mut self.reader, &mut chunk, i32(amount)) { chunk.clear(); return self.failed() }
        self.total += amount
        if self.chunked {
            self.chunk_remaining -= amount
            if self.chunk_remaining == 0 {
                mut ending: []u8 = []
                if !read_exact(&stream, &mut self.reader, &mut ending, 2) { chunk.clear(); return self.failed() }
                if ending.len != 2 || ending[0] != b'\r' || ending[1] != b'\n' {
                    chunk.clear(); self.reject(400, "invalid HTTP chunk ending"); return self.failed()
                }
            }
        } else { self.remaining -= amount }
        body_result(true, false, amount, 200, "")
    }
}

pub fn read_body(stream: &net.TcpStream, move head: Request, max_body: i32, timeout_ms: i64) -> Request {
    if max_body < 0 || max_body > 67108864 { return fail(500, "invalid HTTP reader limits") }
    if !head.ok { return head }
    mut reader := BodyReader::new(&head, i64(max_body), timeout_ms)
    if !reader.ok() { return fail(reader.status(), reader.error()) }
    mut req := head
    mut chunk: []u8 = []
    while true {
        result := reader.read(&stream, &mut chunk, 65536)
        if !result.ok { return fail(result.status, result.error) }
        if result.eof { return req }
        bytes.extend(&mut req.body, &chunk)
    }
    req
}

pub fn read_request(stream: &net.TcpStream, max_body: i32, timeout_ms: i64) -> Request {
    if max_body < 0 || max_body > 67108864 || timeout_ms <= 0 || timeout_ms > 3600000 { return fail(500, "invalid HTTP reader limits") }
    deadline := now_ms() + timeout_ms
    head := read_head(&stream, timeout_ms)
    if !head.ok { return head }
    remaining := deadline - now_ms()
    if remaining <= 0 { return fail(408, "request deadline exceeded") }
    read_body(&stream, move head, max_body, remaining)
}

fn partial_head_status(buffer: &[]u8) -> i32 {
    mut start := 0
    for i in 0..buffer.len {
        if buffer[i] == b'\n' {
            if i == 0 || buffer[i - 1] != b'\r' { return 400 }
            if i - 1 - start > 8192 { return 431 }
            start = i + 1
        } else if buffer[i] == b'\r' && i + 1 < buffer.len && buffer[i + 1] != b'\n' { return 400 }
    }
    remaining := buffer.len - start
    if remaining > 8192 {
        if remaining != 8193 || buffer[buffer.len - 1] != b'\r' { return 431 }
    }
    0
}

fn read_head_wire(stream: &net.TcpStream, reader: &mut Reader) -> bool {
    mut peek: []u8 = []
    while true {
        if now_ms() >= reader.deadline {
            reader.status = 408
            reader.error = "request deadline exceeded"
            return false
        }
        peek.clear()
        match stream.peek_append(&mut peek, 8192) {
            .Ok(count) => {
                if count == 0 {
                    reader.status = 400
                    reader.error = "truncated HTTP request"
                    return false
                }
            },
            .Err(err) => {
                if !err.is_would_block() {
                    reader.status = 400
                    reader.error = "cannot read HTTP request"
                    return false
                }
                if !wait_ready(&stream, net.poll_in(), reader.deadline) {
                    reader.status = 408
                    reader.error = "request deadline exceeded"
                    return false
                }
                continue
            },
        }
        mut start := reader.buffer.len - 3
        if start < 0 { start = 0 }
        suffix := reader.buffer.len - start
        mut scan: []u8 = []
        bytes.extend_range(&mut scan, &reader.buffer, start, reader.buffer.len)
        bytes.extend(&mut scan, &peek)
        boundary := bytes.find_double_crlf(&scan, 0, scan.len).unwrap_or(-1)
        mut amount := peek.len
        if boundary >= 0 { amount = boundary + 4 - suffix }
        if reader.buffer.len + amount > 32768 {
            reader.status = 431
            reader.error = "HTTP headers exceed their limit"
            return false
        }
        mut left := amount
        while left > 0 {
            match stream.read_append(&mut reader.buffer, left) {
                .Ok(count) => {
                    if count == 0 {
                        reader.status = 400
                        reader.error = "cannot consume HTTP head"
                        return false
                    }
                    left -= i32(count)
                },
                .Err(_) => {
                    reader.status = 400
                    reader.error = "cannot consume HTTP head"
                    return false
                },
            }
        }
        partial_status := partial_head_status(&reader.buffer)
        if partial_status != 0 {
            reader.status = partial_status
            reader.error = "invalid or oversized HTTP head line"
            return false
        }
        if boundary >= 0 { return true }
        if reader.buffer.len >= 32768 {
            reader.status = 431
            reader.error = "HTTP headers exceed their limit"
            return false
        }
    }
    false
}

pub fn read_head(stream: &net.TcpStream, timeout_ms: i64) -> Request {
    if timeout_ms <= 0 || timeout_ms > 3600000 { return fail(500, "invalid HTTP reader limits") }
    if !stream.set_nonblocking(true).ok { return fail(500, "cannot configure HTTP stream") }
    mut reader := Reader { buffer: [], offset: 0, deadline: now_ms() + timeout_ms, status: 400, error: "invalid HTTP request" }
    if !read_head_wire(&stream, &mut reader) { return fail(reader.status, reader.error) }
    parse_head(&stream, &mut reader, 9223372036854775807)
}

pub fn write_all(stream: &net.TcpStream, data: &[]u8, timeout_ms: i64) -> bool {
    if timeout_ms <= 0 || timeout_ms > 3600000 { return false }
    if !stream.set_nonblocking(true).ok { return false }
    deadline := now_ms() + timeout_ms
    mut offset := 0
    while offset < data.len {
        if now_ms() >= deadline { return false }
        match stream.write_range(&data, offset, data.len - offset) {
            .Ok(count) => {
                if count <= 0 { return false }
                offset += i32(count)
            },
            .Err(err) => {
                if err == sys.IoError.Interrupted { continue }
                if err.is_would_block() {
                    if !wait_ready(&stream, net.poll_out(), deadline) { return false }
                } else { return false }
            },
        }
    }
    true
}

fn reason(status: i32) -> string {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 204 { return "No Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 303 { return "See Other" }
    if status == 304 { return "Not Modified" }
    if status == 307 { return "Temporary Redirect" }
    if status == 308 { return "Permanent Redirect" }
    if status == 400 { return "Bad Request" }
    if status == 401 { return "Unauthorized" }
    if status == 403 { return "Forbidden" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 408 { return "Request Timeout" }
    if status == 409 { return "Conflict" }
    if status == 413 { return "Content Too Large" }
    if status == 417 { return "Expectation Failed" }
    if status == 429 { return "Too Many Requests" }
    if status == 431 { return "Request Header Fields Too Large" }
    if status == 500 { return "Internal Server Error" }
    if status == 502 { return "Bad Gateway" }
    if status == 503 { return "Service Unavailable" }
    "Response"
}

fn encode_response_parts(status: i32, content_type: string, extra_headers: &[]Header, body: &[]u8, head: bool, keep_alive: bool) -> Result<[]u8, string> {
    if status < 100 || status > 599 || !valid_value(content_type) {
        return .Err("invalid HTTP response status or Content-Type")
    }
    mut output: []u8 = []
    conn_val := if keep_alive { "keep-alive" } else { "close" }
    bytes.append_utf8(&mut output, f"HTTP/1.1 {status} {reason(status)}\r\nConnection: {conn_val}\r\n")
    if content_type.len > 0 { bytes.append_utf8(&mut output, f"Content-Type: {content_type}\r\n") }
    no_body := status < 200 || status == 204 || status == 205 || status == 304
    mut length := body.len
    if no_body { length = 0 }
    if status >= 200 && status != 204 && status != 304 {
        bytes.append_utf8(&mut output, f"Content-Length: {length}\r\n")
    }
    for i in 0..extra_headers.len {
        hdr := &extra_headers[i]
        name := lower(hdr.name)
        if !token(name) || !valid_value(hdr.value) || name == "content-length" || name == "transfer-encoding" || name == "connection" || name == "content-type" {
            return .Err("invalid or forbidden HTTP response header")
        }
        bytes.append_utf8(&mut output, f"{hdr.name}: {hdr.value}\r\n")
    }
    bytes.append_utf8(&mut output, "\r\n")
    if !head && !no_body && length > 0 { bytes.extend(&mut output, &body) }
    .Ok(output)
}

pub fn write_response(stream: &net.TcpStream, status: i32, content_type: string, extra_names: &[]string, extra_values: &[]string, body: &[]u8, head: bool) -> bool {
    if extra_names.len != extra_values.len { return false }
    mut extra_headers: []Header = []
    extra_headers.reserve(extra_names.len)
    for i in 0..extra_names.len {
        extra_headers.push(Header { name: extra_names[i].clone(), value: extra_values[i].clone() })
    }
    encoded := match encode_response_parts(status, content_type, &extra_headers, &body, head, false) {
        .Ok(raw) => raw,
        .Err(_) => { return false },
    }
    write_all(&stream, &encoded, 30000)
}

pub struct Header { name: string, value: string }

pub struct Response {
    status: i32,
    content_type: string,
    headers: []Header,
    body: []u8,
    keep_alive: bool,
}

impl Response {
    pub fn new(status: i32) -> Self {
        Self { status: status, content_type: "", headers: [], body: [], keep_alive: true }
    }

    pub fn ok() -> Self { Self::new(200) }

    pub fn text(status: i32, body: string) -> Self {
        mut out := Self::new(status)
        out.content_type = "text/plain; charset=utf-8"
        bytes.append_utf8(&mut out.body, body)
        out
    }

    pub fn html(status: i32, body: string) -> Self {
        mut out := Self::new(status)
        out.content_type = "text/html; charset=utf-8"
        bytes.append_utf8(&mut out.body, body)
        out
    }

    pub fn json(status: i32, body: string) -> Self {
        mut out := Self::new(status)
        out.content_type = "application/json; charset=utf-8"
        bytes.append_utf8(&mut out.body, body)
        out
    }

    pub fn bytes(status: i32, content_type: string, move body: []u8) -> Self {
        Self { status: status, content_type: content_type.clone(), headers: [], body: body, keep_alive: true }
    }

    pub fn empty(status: i32) -> Self { Self::new(status) }

    pub fn redirect(status: i32, location: string) -> Self {
        mut out := Self::new(status)
        out.header("Location", location)
        out
    }

    pub fn set_status(&mut self, status: i32) { self.status = status }
    pub fn set_content_type(&mut self, content_type: string) { self.content_type = content_type.clone() }
    pub fn header(&mut self, name: string, value: string) { self.headers.push(Header { name: name.clone(), value: value.clone() }) }
    pub fn set_keep_alive(&mut self, keep_alive: bool) { self.keep_alive = keep_alive }

    pub fn set_body_text(&mut self, body: string) {
        self.body.clear()
        bytes.append_utf8(&mut self.body, body)
    }

    pub fn set_body_bytes(&mut self, move body: []u8) { self.body = body }

    pub fn set_cookie(&mut self, cookie: &SetCookie) -> bool {
        match cookie.format() {
            .Ok(val) => {
                self.headers.push(Header { name: "Set-Cookie", value: val })
                true
            },
            .Err(_) => false,
        }
    }

    pub fn with_header(move self, name: string, value: string) -> Self {
        mut out := self
        out.header(name, value)
        out
    }

    pub fn with_content_type(move self, content_type: string) -> Self {
        mut out := self
        out.content_type = content_type.clone()
        out
    }

    pub fn with_keep_alive(move self, keep_alive: bool) -> Self {
        mut out := self
        out.keep_alive = keep_alive
        out
    }

    pub fn with_cookie(move self, cookie: &SetCookie) -> Self {
        mut out := self
        _ := out.set_cookie(&cookie)
        out
    }
}

fn has_connection_token(req: &Request, expected: string) -> bool {
    conns := headers(&req, "connection")
    for raw in &conns {
        parts := text.split(raw, ",")
        for part in &parts {
            if lower(trim_ows(part.clone())) == expected { return true }
        }
    }
    false
}

pub fn connection_wants_close(req: &Request) -> bool {
    has_connection_token(&req, "close")
}

pub fn connection_wants_keep_alive(req: &Request) -> bool {
    has_connection_token(&req, "keep-alive")
}

pub fn should_keep_alive(req: &Request, http_minor: i32) -> bool {
    if http_minor >= 1 { return !connection_wants_close(&req) }
    connection_wants_keep_alive(&req)
}

pub fn encode_response(resp: &Response, head: bool, keep_alive: bool) -> Result<[]u8, string> {
    encode_response_parts(resp.status, resp.content_type, &resp.headers, &resp.body, head, keep_alive && resp.keep_alive)
}

pub fn send_response(stream: &net.TcpStream, resp: &Response, head: bool, keep_alive: bool, timeout_ms: i64) -> bool {
    match encode_response(&resp, head, keep_alive) {
        .Ok(raw) => write_all(&stream, &raw, timeout_ms),
        .Err(_) => false,
    }
}

pub fn graceful_close(stream: &net.TcpStream, timeout_ms: i64) {
    _ := stream.shutdown_write()
    if timeout_ms <= 0 || !stream.set_nonblocking(true).ok { return }
    deadline := now_ms() + timeout_ms
    mut scratch: []u8 = []
    mut drained := 0
    while drained < 65536 {
        if now_ms() >= deadline { break }
        scratch.clear()
        match stream.read_append(&mut scratch, 4096) {
            .Ok(count) => {
                if count <= 0 { break }
                drained += i32(count)
            },
            .Err(err) => {
                if err == sys.IoError.Interrupted { continue }
                if err.is_would_block() {
                    if !wait_ready(&stream, net.poll_in(), deadline) { break }
                } else { break }
            },
        }
    }
}

fn is_unreserved(b: u8) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 46 || b == 95 || b == 126
}

fn hex_digit_upper(n: i32) -> u8 {
    if n < 10 { u8(48 + n) } else { u8(65 + n - 10) }
}

fn hex_digit_val(b: u8) -> i32 {
    if b >= 48 && b <= 57 { return i32(b) - 48 }
    if b >= 65 && b <= 70 { return i32(b) - 65 + 10 }
    if b >= 97 && b <= 102 { return i32(b) - 97 + 10 }
    -1
}

fn encode_uri_component(input: string, space_as_plus: bool) -> string {
    mut out: []u8 = []
    out.reserve(input.len)
    for b in input.bytes() {
        if is_unreserved(b) {
            out.push(b)
        } else if space_as_plus && b == 32 {
            out.push(u8(43))
        } else {
            out.push(u8(37))
            out.push(hex_digit_upper(i32(b) / 16))
            out.push(hex_digit_upper(i32(b) % 16))
        }
    }
    bytes.decode(&out).unwrap_or_default()
}

fn decode_uri_bytes(input: string, plus_as_space: bool) -> Result<[]u8, string> {
    mut out: []u8 = []
    out.reserve(input.len)
    mut i := 0
    while i < input.len {
        b := input[i]
        if plus_as_space && b == 43 {
            out.push(u8(32))
            i += 1
        } else if b == 37 {
            if i + 2 >= input.len { return .Err("truncated percent escape") }
            hi := hex_digit_val(input[i + 1])
            lo := hex_digit_val(input[i + 2])
            if hi < 0 || lo < 0 { return .Err("invalid hex digit in percent escape") }
            out.push(u8(hi * 16 + lo))
            i += 3
        } else {
            out.push(u8(b))
            i += 1
        }
    }
    .Ok(out)
}

fn decode_utf8_res(raw: &[]u8) -> Result<string, string> {
    match bytes.decode(&raw) { .Ok(value) => .Ok(value), .Err(_) => .Err("invalid UTF-8") }
}

pub fn percent_encode(input: string) -> string { encode_uri_component(input, false) }

pub fn percent_decode_bytes(input: string) -> Result<[]u8, string> { decode_uri_bytes(input, false) }

pub fn percent_decode(input: string) -> Result<string, string> {
    raw := decode_uri_bytes(input, false)?
    decode_utf8_res(&raw)
}

pub fn form_encode_component(input: string) -> string { encode_uri_component(input, true) }

pub fn form_decode(input: string) -> Result<string, string> {
    raw := decode_uri_bytes(input, true)?
    decode_utf8_res(&raw)
}

pub struct FormParam { key: string, value: string }

pub fn target_path(target: string) -> string {
    match text.find(target, "?") {
        .Some(pos) => target[0..pos],
        .None => target.clone(),
    }
}

pub fn target_query(target: string) -> string {
    match text.find(target, "?") {
        .Some(pos) => target[(pos + 1)..target.len],
        .None => "",
    }
}

fn parse_urlencoded_pairs(raw: string) -> Result<[]FormParam, string> {
    mut params: []FormParam = []
    if raw.len == 0 { return .Ok(params) }
    segments := text.split(raw, "&")
    for seg in &segments {
        if seg.len == 0 { continue }
        match text.find(seg.clone(), "=") {
            .Some(eq) => {
                k := form_decode(seg[0..eq])?
                v := form_decode(seg[(eq + 1)..seg.len])?
                params.push(FormParam { key: k, value: v })
            },
            .None => {
                k := form_decode(seg.clone())?
                params.push(FormParam { key: k, value: "" })
            },
        }
    }
    .Ok(params)
}

pub fn parse_query(query: string) -> Result<[]FormParam, string> {
    raw := if text.starts_with(query, "?") { query[1..query.len] } else { query.clone() }
    parse_urlencoded_pairs(raw)
}

pub fn parse_form_urlencoded(body: &[]u8) -> Result<[]FormParam, string> {
    txt := decode_utf8_res(&body)?
    parse_urlencoded_pairs(txt)
}

pub fn encode_form_urlencoded(params: &[]FormParam) -> string {
    mut out := ""
    for i in 0..params.len {
        if i > 0 { out = out + "&" }
        out = out + form_encode_component(params[i].key.clone()) + "=" + form_encode_component(params[i].value.clone())
    }
    out
}

pub fn param_get(params: &[]FormParam, key: string) -> Option<string> {
    for p in &params {
        if p.key == key { return .Some(p.value.clone()) }
    }
    .None
}

pub fn param_get_all(params: &[]FormParam, key: string) -> []string {
    mut out: []string = []
    for p in &params {
        if p.key == key { out.push(p.value.clone()) }
    }
    out
}

pub struct Cookie { name: string, value: string }

pub fn parse_cookies(req: &Request) -> []Cookie {
    mut out: []Cookie = []
    hdrs := headers(&req, "cookie")
    for hdr in &hdrs {
        parts := text.split(hdr, ";")
        for part in &parts {
            trimmed := trim_ows(part.clone())
            if trimmed.len == 0 { continue }
            match text.find(trimmed.clone(), "=") {
                .Some(eq) => {
                    if eq > 0 {
                        name := trim_ows(trimmed[0..eq])
                        mut val := trim_ows(trimmed[(eq + 1)..trimmed.len])
                        if val.len >= 2 && val[0] == 34 && val[val.len - 1] == 34 {
                            val = val[1..(val.len - 1)]
                        }
                        if token(name) { out.push(Cookie { name: name, value: val }) }
                    }
                },
                .None => {},
            }
        }
    }
    out
}

pub fn cookie(req: &Request, name: string) -> Option<string> {
    list := parse_cookies(&req)
    for c in &list {
        if c.name == name { return .Some(c.value.clone()) }
    }
    .None
}

pub enum SameSite { None, Lax, Strict }

pub struct SetCookie {
    name: string,
    value: string,
    path: string,
    domain: string,
    max_age: Option<i64>,
    expires: string,
    secure: bool,
    http_only: bool,
    same_site: Option<SameSite>,
}

fn valid_cookie_attr(val: string) -> bool {
    valid_value(val) && !text.contains(val, ";")
}

impl SetCookie {
    pub fn new(name: string, value: string) -> Self {
        Self {
            name: name.clone(), value: value.clone(), path: "", domain: "",
            max_age: .None, expires: "", secure: false, http_only: false, same_site: .None,
        }
    }

    pub fn format(&self) -> Result<string, string> {
        if !token(self.name) { return .Err("invalid cookie name") }
        if !valid_cookie_attr(self.value) || !valid_cookie_attr(self.path) || !valid_cookie_attr(self.domain) || !valid_cookie_attr(self.expires) {
            return .Err("invalid Set-Cookie field value")
        }
        mut out := f"{self.name}={self.value}"
        if self.path.len > 0 { out = out + f"; Path={self.path}" }
        if self.domain.len > 0 { out = out + f"; Domain={self.domain}" }
        match self.max_age {
            .Some(secs) => { out = out + f"; Max-Age={secs}" },
            .None => {},
        }
        if self.expires.len > 0 { out = out + f"; Expires={self.expires}" }
        if self.secure { out = out + "; Secure" }
        if self.http_only { out = out + "; HttpOnly" }
        match self.same_site {
            .Some(mode) => {
                label := match mode {
                    .Strict => "Strict",
                    .Lax => "Lax",
                    .None => "None",
                }
                out = out + "; SameSite=" + label
            },
            .None => {},
        }
        .Ok(out)
    }
}

pub struct BasicCredentials { username: string, password: string }

fn extract_auth_payload(req: &Request, scheme: string) -> Option<string> {
    raw := trim_ows(header(&req, "authorization"))
    if raw.len == 0 { return .None }
    match text.find(raw.clone(), " ") {
        .Some(sp) => {
            if lower(raw[0..sp]) != scheme { return .None }
            rest := trim_ows(raw[(sp + 1)..raw.len])
            if rest.len == 0 { return .None }
            .Some(rest)
        },
        .None => .None,
    }
}

pub fn parse_bearer(req: &Request) -> Option<string> {
    match extract_auth_payload(&req, "bearer") {
        .Some(tok) => {
            for b in tok.bytes() {
                if b <= 32 || b == 127 { return .None }
            }
            .Some(tok)
        },
        .None => .None,
    }
}

pub fn parse_basic(req: &Request) -> Option<BasicCredentials> {
    encoded := extract_auth_payload(&req, "basic")?
    decoded := base64.decode(encoded)
    if !decoded.ok { return .None }
    txt := bytes.decode(&decoded.value).ok()?
    match text.find(txt.clone(), ":") {
        .Some(colon) => .Some(BasicCredentials { username: txt[0..colon], password: txt[(colon + 1)..txt.len] }),
        .None => .None,
    }
}

pub fn format_bearer(token_val: string) -> string { "Bearer " + token_val }

pub fn format_basic(username: string, password: string) -> string {
    raw := bytes.from_text(username + ":" + password)
    "Basic " + base64.encode(&raw)
}

pub fn escape_html(input: string) -> string {
    mut out: []u8 = []
    out.reserve(input.len)
    for b in input.bytes() {
        if b == 38 { bytes.append_utf8(&mut out, "&amp;") }
        else if b == 60 { bytes.append_utf8(&mut out, "&lt;") }
        else if b == 62 { bytes.append_utf8(&mut out, "&gt;") }
        else if b == 34 { bytes.append_utf8(&mut out, "&quot;") }
        else if b == 39 { bytes.append_utf8(&mut out, "&#x27;") }
        else { out.push(u8(b)) }
    }
    bytes.decode(&out).unwrap_or_default()
}

pub struct ServerConfig {
    workers: i32,
    max_connections: i32,
    max_body_bytes: i32,
    read_timeout_ms: i64,
    write_timeout_ms: i64,
    keep_alive_timeout_ms: i64,
    max_requests_per_conn: i32,
    queue_capacity: i32,
    drain_timeout_ms: i64,
}

impl ServerConfig {
    pub fn default() -> Self {
        Self {
            workers: 4,
            max_connections: 1024,
            max_body_bytes: 16777216,
            read_timeout_ms: 10000,
            write_timeout_ms: 10000,
            keep_alive_timeout_ms: 30000,
            max_requests_per_conn: 1000,
            queue_capacity: 256,
            drain_timeout_ms: 200,
        }
    }
}

pub trait Handler {
    fn handle(&self, req: &Request) -> Response
}

pub struct RequestJob {
    conn_id: i32,
    generation: i64,
    request: Request,
}

pub struct ResponseJob {
    conn_id: i32,
    generation: i64,
    response: Response,
}

struct WorkerContext<H> {
    work_rx: sync.Receiver<RequestJob>,
    done_tx: sync.Sender<ResponseJob>,
    handler: H,
}

fn http_worker<H>(move ctx: WorkerContext<H>) where H: Handler + Clone + Sendable {
    while true {
        match ctx.work_rx.recv() {
            .Some(job) => {
                resp := ctx.handler.handle(&job.request)
                out := ResponseJob { conn_id: job.conn_id, generation: job.generation, response: resp }
                if !ctx.done_tx.send(move out) { break }
            },
            .None => break,
        }
    }
}

struct Conn {
    active: bool,
    fd_slot: i32,
    generation: i64,
    state: i32,
    rx: []u8,
    rx_off: i32,
    http_minor: i32,
    req: Request,
    remaining: i64,
    total_body: i64,
    chunk_remaining: i64,
    trailer_bytes: i32,
    trailer_count: i32,
    expect_continue: bool,
    continue_pending: bool,
    req_keep_alive: bool,
    req_head: bool,
    requests_handled: i32,
    pending_job: Option<RequestJob>,
    write_buf: []u8,
    write_off: i32,
    drained_bytes: i32,
    deadline: i64,
}

fn empty_req() -> Request {
    Request { ok: false, status: 400, method: "", target: "", header_names: [], header_values: [], body: [], error: "" }
}

fn new_conn() -> Conn {
    Conn {
        active: false, fd_slot: -1, generation: 0, state: 0,
        rx: [], rx_off: 0, http_minor: 1, req: empty_req(),
        remaining: 0, total_body: 0, chunk_remaining: 0,
        trailer_bytes: 0, trailer_count: 0,
        expect_continue: false, continue_pending: false,
        req_keep_alive: false, req_head: false, requests_handled: 0,
        pending_job: .None, write_buf: [], write_off: 0, drained_bytes: 0, deadline: 0,
    }
}

fn conn_reset_for_request(c: &mut Conn, timeout_ms: i64, idle: bool) {
    if c.rx_off > 0 {
        if c.rx_off >= c.rx.len { c.rx.clear() }
        else { bytes.consume_prefix(&mut c.rx, c.rx_off) }
        c.rx_off = 0
    }
    c.state = if idle && c.rx.len == 0 { 0 } else { 1 }
    c.http_minor = 1
    c.req = empty_req()
    c.remaining = 0
    c.total_body = 0
    c.chunk_remaining = 0
    c.trailer_bytes = 0
    c.trailer_count = 0
    c.expect_continue = false
    c.continue_pending = false
    c.req_keep_alive = false
    c.req_head = false
    c.pending_job = .None
    c.write_buf.clear()
    c.write_off = 0
    c.deadline = now_ms() + timeout_ms
}

fn conn_begin_error(c: &mut Conn, status: i32, msg: string, write_timeout_ms: i64) {
    resp := Response::text(status, msg)
    encoded := match encode_response(&resp, false, false) {
        .Ok(raw) => raw,
        .Err(_) => [],
    }
    c.req_keep_alive = false
    c.write_buf = move encoded
    c.write_off = 0
    c.state = 9
    c.deadline = now_ms() + write_timeout_ms
}

fn conn_close(c: &mut Conn, streams: &mut net.StreamSet) {
    if c.fd_slot >= 0 {
        _ := streams.close(c.fd_slot)
        c.fd_slot = -1
    }
    c.active = false
    c.state = 0
    c.rx.clear()
    c.rx_off = 0
    c.req = empty_req()
    c.pending_job = .None
    c.write_buf.clear()
    c.write_off = 0
}

fn conn_start_drain(c: &mut Conn, streams: &mut net.StreamSet, drain_timeout_ms: i64) {
    if drain_timeout_ms <= 0 || c.fd_slot < 0 {
        conn_close(&mut c, &mut streams)
        return
    }
    _ := streams.shutdown_write(c.fd_slot)
    c.state = 10
    c.drained_bytes = 0
    c.deadline = now_ms() + drain_timeout_ms
}

fn conn_try_parse_head(c: &mut Conn, config: &ServerConfig) -> i32 {
    // returns: 0 = need more bytes, 1 = head ready, -1 = error response started
    boundary := bytes.find_double_crlf(&c.rx, c.rx_off, c.rx.len).unwrap_or(-1)
    if boundary < 0 {
        partial := partial_head_status(&c.rx)
        if partial != 0 {
            conn_begin_error(&mut c, partial, "invalid or oversized HTTP head", config.write_timeout_ms)
            return -1
        }
        if c.rx.len - c.rx_off >= 32768 {
            conn_begin_error(&mut c, 431, "HTTP headers exceed their limit", config.write_timeout_ms)
            return -1
        }
        return 0
    }
    head_end := boundary + 4
    if head_end - c.rx_off > 32768 {
        conn_begin_error(&mut c, 431, "HTTP headers exceed their limit", config.write_timeout_ms)
        return -1
    }
    mut line_start := c.rx_off
    first_crlf := bytes.find_crlf(&c.rx, line_start, head_end).unwrap_or(-1)
    if first_crlf < 0 || first_crlf - line_start > 8192 {
        status := if first_crlf < 0 { 400 } else { 431 }
        conn_begin_error(&mut c, status, "invalid HTTP request line", config.write_timeout_ms)
        return -1
    }
    first_dec := match bytes.decode_range(&c.rx, line_start, first_crlf) {
        .Ok(line) => line,
        .Err(_) => { conn_begin_error(&mut c, 400, "invalid UTF-8 in HTTP head", config.write_timeout_ms); return -1 },
    }
    mut parts := text.split(first_dec, " ")
    if parts.len != 3 {
        conn_begin_error(&mut c, 400, "invalid HTTP request line", config.write_timeout_ms)
        return -1
    }
    version := parts.pop()
    target := parts.pop()
    method := parts.pop()
    if !token(method) || (version != "HTTP/1.0" && version != "HTTP/1.1") {
        conn_begin_error(&mut c, 400, "invalid HTTP request line", config.write_timeout_ms)
        return -1
    }
    if !text.starts_with(target, "/") {
        conn_begin_error(&mut c, 400, "HTTP target requires origin form", config.write_timeout_ms)
        return -1
    }
    for b in target.bytes() {
        if b <= 32 || b == 127 || b == 35 || b == 92 {
            conn_begin_error(&mut c, 400, "invalid HTTP request target", config.write_timeout_ms)
            return -1
        }
    }
    mut req := Request {
        ok: true, status: 200, method: method, target: target,
        header_names: [], header_values: [], body: [], error: "",
    }
    line_start = first_crlf + 2
    while line_start < boundary + 2 {
        line_crlf := bytes.find_crlf(&c.rx, line_start, head_end).unwrap_or(-1)
        if line_crlf < 0 {
            conn_begin_error(&mut c, 400, "HTTP lines require CRLF", config.write_timeout_ms)
            return -1
        }
        if line_crlf - line_start > 8192 {
            conn_begin_error(&mut c, 431, "HTTP line exceeds its limit", config.write_timeout_ms)
            return -1
        }
        line_dec := match bytes.decode_range(&c.rx, line_start, line_crlf) {
            .Ok(line) => line,
            .Err(_) => { conn_begin_error(&mut c, 400, "invalid UTF-8 in HTTP head", config.write_timeout_ms); return -1 },
        }
        line_start = line_crlf + 2
        if line_dec.len == 0 { break }
        if req.header_names.len >= 100 {
            conn_begin_error(&mut c, 431, "too many HTTP headers", config.write_timeout_ms)
            return -1
        }
        if !append_header(&mut req, line_dec) {
            conn_begin_error(&mut c, 400, "invalid or duplicate HTTP header", config.write_timeout_ms)
            return -1
        }
    }
    c.rx_off = head_end
    c.http_minor = if version == "HTTP/1.1" { 1 } else { 0 }
    if c.http_minor == 1 && header(&req, "host").len == 0 {
        conn_begin_error(&mut c, 400, "Host required", config.write_timeout_ms)
        return -1
    }
    transfer := lower(header(&req, "transfer-encoding"))
    has_transfer := has_header(&req, "transfer-encoding")
    has_length := has_header(&req, "content-length")
    if has_transfer && (transfer != "chunked" || has_length) {
        conn_begin_error(&mut c, 400, "ambiguous or unsupported HTTP body framing", config.write_timeout_ms)
        return -1
    }
    c.remaining = 0
    if has_length {
        sz := decimal(header(&req, "content-length"), i64(config.max_body_bytes))
        if sz == -1 { conn_begin_error(&mut c, 400, "invalid Content-Length", config.write_timeout_ms); return -1 }
        if sz == -2 { conn_begin_error(&mut c, 413, "request body exceeds its limit", config.write_timeout_ms); return -1 }
        c.remaining = sz
    }
    if has_header(&req, "expect") {
        if lower(header(&req, "expect")) != "100-continue" {
            conn_begin_error(&mut c, 417, "unsupported Expect header", config.write_timeout_ms)
            return -1
        }
        c.expect_continue = true
        c.continue_pending = true
    }
    keep := should_keep_alive(&req, c.http_minor) && (c.requests_handled + 1 < config.max_requests_per_conn)
    c.req_keep_alive = keep
    c.req_head = req.method == "HEAD"
    c.req = move req
    c.total_body = 0
    c.chunk_remaining = 0
    c.trailer_bytes = 0
    c.trailer_count = 0
    if has_transfer { c.state = 3 }
    else if c.remaining > 0 { c.state = 2 }
    else { c.state = 7 }
    1
}

fn conn_consume_body_step(c: &mut Conn, config: &ServerConfig) -> bool {
    // Returns true if progressed or completed cleanly without needing socket read; false if need more bytes
    if c.state == 2 {
        avail := i64(c.rx.len - c.rx_off)
        if avail <= 0 { return false }
        take := if avail < c.remaining { i32(avail) } else { i32(c.remaining) }
        bytes.extend_range(&mut c.req.body, &c.rx, c.rx_off, c.rx_off + take)
        c.rx_off += take
        c.remaining -= i64(take)
        c.total_body += i64(take)
        if c.remaining == 0 { c.state = 7 }
        return true
    }
    if c.state == 3 {
        crlf := bytes.find_crlf(&c.rx, c.rx_off, c.rx.len).unwrap_or(-1)
        nl := bytes.find_byte(&c.rx, c.rx_off, c.rx.len, b'\n').unwrap_or(-1)
        if nl >= 0 && (crlf < 0 || nl != crlf + 1) {
            conn_begin_error(&mut c, 400, "HTTP lines require CRLF", config.write_timeout_ms)
            return true
        }
        if crlf < 0 {
            if c.rx.len - c.rx_off > 1025 {
                conn_begin_error(&mut c, 431, "HTTP line exceeds its limit", config.write_timeout_ms)
                return true
            }
            return false
        }
        if crlf - c.rx_off > 1024 {
            conn_begin_error(&mut c, 431, "HTTP line exceeds its limit", config.write_timeout_ms)
            return true
        }
        dec := match bytes.decode_range(&c.rx, c.rx_off, crlf) {
            .Ok(line) => line,
            .Err(_) => { conn_begin_error(&mut c, 400, "invalid UTF-8 in chunk header", config.write_timeout_ms); return true },
        }
        c.rx_off = crlf + 2
        sz := chunk_size(dec, i64(config.max_body_bytes) - c.total_body)
        if sz == -1 { conn_begin_error(&mut c, 400, "invalid HTTP chunk size", config.write_timeout_ms); return true }
        if sz == -2 { conn_begin_error(&mut c, 413, "request body exceeds its limit", config.write_timeout_ms); return true }
        if sz == 0 {
            c.state = 6
        } else {
            c.chunk_remaining = sz
            c.state = 4
        }
        return true
    }
    if c.state == 4 {
        avail := i64(c.rx.len - c.rx_off)
        if avail <= 0 { return false }
        take := if avail < c.chunk_remaining { i32(avail) } else { i32(c.chunk_remaining) }
        bytes.extend_range(&mut c.req.body, &c.rx, c.rx_off, c.rx_off + take)
        c.rx_off += take
        c.chunk_remaining -= i64(take)
        c.total_body += i64(take)
        if c.chunk_remaining == 0 { c.state = 5 }
        return true
    }
    if c.state == 5 {
        if c.rx.len - c.rx_off < 2 { return false }
        if c.rx[c.rx_off] != b'\r' || c.rx[c.rx_off + 1] != b'\n' {
            conn_begin_error(&mut c, 400, "invalid HTTP chunk ending", config.write_timeout_ms)
            return true
        }
        c.rx_off += 2
        c.state = 3
        return true
    }
    if c.state == 6 {
        crlf := bytes.find_crlf(&c.rx, c.rx_off, c.rx.len).unwrap_or(-1)
        nl := bytes.find_byte(&c.rx, c.rx_off, c.rx.len, b'\n').unwrap_or(-1)
        if nl >= 0 && (crlf < 0 || nl != crlf + 1) {
            conn_begin_error(&mut c, 400, "HTTP lines require CRLF", config.write_timeout_ms)
            return true
        }
        if crlf < 0 {
            if c.rx.len - c.rx_off > 8193 {
                conn_begin_error(&mut c, 431, "HTTP line exceeds its limit", config.write_timeout_ms)
                return true
            }
            return false
        }
        line_len := crlf - c.rx_off
        if line_len > 8192 {
            conn_begin_error(&mut c, 431, "HTTP line exceeds its limit", config.write_timeout_ms)
            return true
        }
        c.trailer_bytes += line_len + 2
        if c.trailer_bytes > 8192 {
            conn_begin_error(&mut c, 431, "HTTP trailers exceed their limit", config.write_timeout_ms)
            return true
        }
        dec := match bytes.decode_range(&c.rx, c.rx_off, crlf) {
            .Ok(line) => line,
            .Err(_) => { conn_begin_error(&mut c, 400, "invalid UTF-8 in HTTP trailer", config.write_timeout_ms); return true },
        }
        c.rx_off = crlf + 2
        if dec.len == 0 {
            c.state = 7
            return true
        }
        c.trailer_count += 1
        if c.trailer_count > 20 {
            conn_begin_error(&mut c, 431, "too many HTTP trailers", config.write_timeout_ms)
            return true
        }
        part := header_parts(dec)
        if !part.ok {
            conn_begin_error(&mut c, 400, "invalid HTTP trailer", config.write_timeout_ms)
            return true
        }
        if control_trailer(part.name) {
            conn_begin_error(&mut c, 400, "HTTP control trailer refused", config.write_timeout_ms)
            return true
        }
        return true
    }
    false
}

fn conn_flush_continue(c: &mut Conn, streams: &mut net.StreamSet) -> bool {
    if !c.continue_pending || c.fd_slot < 0 { return true }
    mut msg: []u8 = []
    bytes.append_utf8(&mut msg, "HTTP/1.1 100 Continue\r\n\r\n")
    match streams.write_range(c.fd_slot, &msg, 0, msg.len) {
        .Ok(n) => {
            if i32(n) == msg.len {
                c.continue_pending = false
                return true
            }
            false
        },
        .Err(err) => {
            if err == sys.IoError.Interrupted || err.is_would_block() { return true }
            false
        },
    }
}

fn conn_dispatch(c: &mut Conn, cid: i32, next_gen: &mut i64, work_tx: &sync.Sender<RequestJob>, config: &ServerConfig) {
    if c.state != 7 { return }
    opt := replace(&mut c.pending_job, .None)
    mut job := match opt {
        .Some(pending) => pending,
        .None => {
            g := next_gen
            next_gen = g + 1
            c.generation = g
            req := replace(&mut c.req, empty_req())
            RequestJob { conn_id: cid, generation: g, request: req }
        },
    }
    match work_tx.try_send(move job) {
        .Ok => {
            c.pending_job = .None
            c.state = 8
        },
        .Full(returned) => {
            c.pending_job = .Some(returned)
        },
        .Closed(_) | .TimedOut(_) | .Cancelled(_) => {
            c.pending_job = .None
            conn_begin_error(&mut c, 503, "server shutting down", config.write_timeout_ms)
        },
    }
}

fn conn_advance_parse_and_dispatch(c: &mut Conn, cid: i32, next_gen: &mut i64, streams: &mut net.StreamSet, work_tx: &sync.Sender<RequestJob>, config: &ServerConfig) {
    if c.state == 0 && c.rx.len > c.rx_off { c.state = 1 }
    mut progressed := true
    while progressed && c.active {
        progressed = false
        if c.state == 1 {
            res := conn_try_parse_head(&mut c, &config)
            if res == 1 {
                if !conn_flush_continue(&mut c, &mut streams) {
                    conn_close(&mut c, &mut streams)
                    return
                }
                progressed = true
            }
        } else if c.state >= 2 && c.state <= 6 {
            if c.continue_pending {
                if !conn_flush_continue(&mut c, &mut streams) {
                    conn_close(&mut c, &mut streams)
                    return
                }
            }
            if conn_consume_body_step(&mut c, &config) { progressed = true }
        }
    }
    if c.active && c.state == 7 {
        conn_dispatch(&mut c, cid, &mut next_gen, &work_tx, &config)
    }
}

pub fn serve_channel(listener: &net.TcpListener, config: &ServerConfig, cancel: &sync.CancelToken,
    work_tx: &sync.Sender<RequestJob>, done_rx: &sync.Receiver<ResponseJob>) -> Result<(), sys.IoError> {
    if config.max_connections < 1 || config.max_body_bytes < 0 || config.read_timeout_ms <= 0 ||
        config.write_timeout_ms <= 0 || config.keep_alive_timeout_ms <= 0 || config.max_requests_per_conn < 1 {
        return .Err(.InvalidArgument)
    }
    nb := listener.set_nonblocking(true)
    if !nb.ok { return .Err(sys.IoError::from_code(nb.error)) }
    mut streams := net.StreamSet::new()
    mut poll := net.PollSet::new()
    waker := poll.waker()?
    cancel.attach_waker(&waker)
    done_rx.attach_waker(&waker)
    work_tx.attach_waker(&waker)

    mut conns: []Conn = []
    mut active_conns := 0
    mut next_gen: i64 = 1

    while true {
        while true {
            match done_rx.try_recv() {
                .Value(rjob) => {
                    cid := rjob.conn_id
                    if cid >= 0 && cid < conns.len {
                        c := &mut conns[cid]
                        if c.active && c.state == 8 && c.generation == rjob.generation {
                            head_method := c.req_head
                            keep := c.req_keep_alive && rjob.response.keep_alive && !cancel.is_cancelled()
                            c.req_keep_alive = keep
                            match encode_response(&rjob.response, head_method, keep) {
                                .Ok(raw) => {
                                    c.write_buf = move raw
                                    c.write_off = 0
                                    c.state = 9
                                    c.deadline = now_ms() + config.write_timeout_ms
                                    c.requests_handled += 1
                                },
                                .Err(err_msg) => {
                                    conn_begin_error(&mut c, 500, err_msg, config.write_timeout_ms)
                                },
                            }
                        }
                    }
                },
                .Empty => break,
                .Closed => break,
            }
        }

        now := now_ms()
        stopping := cancel.is_cancelled()
        for cid in 0..conns.len {
            c := &mut conns[cid]
            if !c.active { continue }
            if c.state == 7 {
                conn_dispatch(&mut c, cid, &mut next_gen, &work_tx, &config)
            }
            if c.active && c.state == 9 {
                while c.write_off < c.write_buf.len {
                    match streams.write_range(c.fd_slot, &c.write_buf, c.write_off, c.write_buf.len - c.write_off) {
                        .Ok(wrote) => {
                            if wrote <= 0 { conn_close(&mut c, &mut streams); active_conns -= 1; break }
                            c.write_off += i32(wrote)
                        },
                        .Err(err) => {
                            if err == sys.IoError.Interrupted { continue }
                            if err.is_would_block() { break }
                            conn_close(&mut c, &mut streams)
                            active_conns -= 1
                            break
                        },
                    }
                }
                if c.active && c.write_off >= c.write_buf.len {
                    if c.req_keep_alive && !stopping {
                        has_pipelined := c.rx_off < c.rx.len
                        tmo := if has_pipelined { config.read_timeout_ms } else { config.keep_alive_timeout_ms }
                        conn_reset_for_request(&mut c, tmo, !has_pipelined)
                        if has_pipelined {
                            conn_advance_parse_and_dispatch(&mut c, cid, &mut next_gen, &mut streams, &work_tx, &config)
                        }
                    } else {
                        conn_start_drain(&mut c, &mut streams, if stopping { 0 } else { config.drain_timeout_ms })
                        if !c.active { active_conns -= 1 }
                    }
                }
            }
            if c.active && stopping && c.state == 0 {
                conn_close(&mut c, &mut streams)
                active_conns -= 1
            } else if c.active && c.state != 8 && now >= c.deadline {
                if c.state >= 1 && c.state <= 6 {
                    conn_begin_error(&mut c, 408, "request deadline exceeded", config.write_timeout_ms)
                } else {
                    conn_close(&mut c, &mut streams)
                    active_conns -= 1
                }
            }
        }

        if stopping && active_conns == 0 { break }

        poll.clear()
        mut poll_targets: []i32 = []
        if !stopping && active_conns < config.max_connections {
            poll_targets.push(-1)
            poll.add(listener.fd(), net.poll_in())
        }
        mut min_deadline: i64 = -1
        for cid in 0..conns.len {
            c := &conns[cid]
            if !c.active { continue }
            if c.state != 8 && (min_deadline < 0 || c.deadline < min_deadline) {
                min_deadline = c.deadline
            }
            mut ev := 0
            if (c.state >= 0 && c.state <= 6) || c.state == 10 {
                ev = ev + net.poll_in()
            }
            if c.state == 9 { ev = ev + net.poll_out() }
            if ev != 0 {
                poll_targets.push(cid)
                poll.add(streams.fd(c.fd_slot), ev)
            }
        }

        mut wait_ms := 250
        if min_deadline >= 0 {
            rem := min_deadline - now_ms()
            if rem <= 0 { wait_ms = 0 }
            else if rem < i64(wait_ms) { wait_ms = i32(rem) }
        }
        mut polled := 0
        match poll.poll(wait_ms) {
            .Ok(n) => { polled = n },
            .Err(err) => {
                if err == sys.IoError.Interrupted { continue }
                return .Err(err)
            },
        }
        if polled == 0 && !poll.woken() { continue }

        for pi in 0..poll_targets.len {
            rev := poll.revents[pi]
            if rev == 0 { continue }
            target_cid := poll_targets[pi]
            if target_cid < 0 {
                // Accept incoming connections up to capacity
                while !cancel.is_cancelled() && active_conns < config.max_connections {
                    match listener.accept() {
                        .Ok(stream) => {
                            _ := stream.set_nonblocking(true)
                            _ := stream.set_nodelay(true)
                            fslot := streams.insert(move stream)
                            mut slot_idx := -1
                            for idx in 0..conns.len {
                                if !conns[idx].active { slot_idx = idx; break }
                            }
                            if slot_idx < 0 {
                                slot_idx = conns.len
                                conns.push(new_conn())
                            }
                            c := &mut conns[slot_idx]
                            c.active = true
                            c.fd_slot = fslot
                            c.requests_handled = 0
                            c.rx.clear()
                            c.rx_off = 0
                            conn_reset_for_request(&mut c, config.keep_alive_timeout_ms, true)
                            active_conns += 1
                        },
                        .Err(err) => {
                            if err == sys.IoError.Interrupted { continue }
                            break
                        },
                    }
                }
                continue
            }

            c := &mut conns[target_cid]
            if !c.active { continue }
            if c.state >= 0 && c.state <= 6 {
                if rev.bit_and(net.poll_err()) != 0 {
                    conn_close(&mut c, &mut streams)
                    active_conns -= 1
                    continue
                }
                mut eof_or_err := false
                mut read_any := false
                while c.rx.len - c.rx_off < 65536 {
                    match streams.read_append(c.fd_slot, &mut c.rx, 8192) {
                        .Ok(cnt) => {
                            if cnt <= 0 {
                                eof_or_err = true
                                break
                            }
                            read_any = true
                            if c.state == 0 {
                                c.state = 1
                                c.deadline = now_ms() + config.read_timeout_ms
                            }
                        },
                        .Err(err) => {
                            if err == sys.IoError.Interrupted { continue }
                            if err.is_would_block() { break }
                            eof_or_err = true
                            break
                        },
                    }
                }
                if read_any {
                    conn_advance_parse_and_dispatch(&mut c, target_cid, &mut next_gen, &mut streams, &work_tx, &config)
                }
                if c.active && eof_or_err {
                    if c.state == 0 && c.rx.len == c.rx_off {
                        conn_close(&mut c, &mut streams)
                        active_conns -= 1
                    } else if c.state >= 1 && c.state <= 6 {
                        conn_begin_error(&mut c, 400, "truncated HTTP request", config.write_timeout_ms)
                    }
                }
            } else if c.state == 10 {
                // Draining peer input until EOF
                mut done_drain := rev.bit_and(net.poll_err()) != 0
                mut scratch: []u8 = []
                while !done_drain && c.drained_bytes < 65536 {
                    scratch.clear()
                    match streams.read_append(c.fd_slot, &mut scratch, 4096) {
                        .Ok(cnt) => {
                            if cnt <= 0 { done_drain = true; break }
                            c.drained_bytes += i32(cnt)
                        },
                        .Err(err) => {
                            if err == sys.IoError.Interrupted { continue }
                            if err.is_would_block() { break }
                            done_drain = true
                            break
                        },
                    }
                }
                if done_drain || c.drained_bytes >= 65536 {
                    conn_close(&mut c, &mut streams)
                    active_conns -= 1
                }
            }
        }
    }
    .Ok
}

pub fn serve<H>(listener: &net.TcpListener, config: &ServerConfig, cancel: &sync.CancelToken, handler: &H) -> Result<(), sys.IoError> where H: Handler + Clone + Sendable {
    mut worker_count := config.workers
    if worker_count < 1 { worker_count = 1 }
    mut qcap := config.queue_capacity
    if qcap < 1 { qcap = worker_count * 4 }
    work_ch := sync.channel<RequestJob>(qcap)
    done_ch := sync.channel<ResponseJob>(qcap)
    work_tx := work_ch.0
    work_rx := work_ch.1
    done_tx := done_ch.0
    done_rx := done_ch.1
    mut res: Result<(), sys.IoError> = .Ok
    task scope pool(worker_count) {
        mut ids: []Task<()> = []
        for _ in 0..worker_count {
            ctx := WorkerContext<H> {
                work_rx: work_rx.clone_receiver(),
                done_tx: done_tx.clone_sender(),
                handler: handler.clone(),
            }
            ids.push(pool.spawn(http_worker<H>, move ctx))
        }
        res = serve_channel(&listener, &config, &cancel, &work_tx, &done_rx)
        work_tx.close()
        done_rx.close()
        for t in move ids { t.join() }
    }
    res
}
