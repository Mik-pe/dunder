capability network, unsafe

import std.bytes as bytes
import std.net as net
import std.parse as parse
import std.text as text
import sys

pub struct Request {
    ok: bool,
    status: i32,
    method: string,
    target: string,
    header_names: []string,
    header_values: []string,
    body: []u8,
    error: string,
}

struct Reader {
    buffer: []u8,
    offset: i32,
    deadline: i64,
    status: i32,
    error: string,
}

pub opaque struct BodyReader {
    reader: Reader,
    remaining: i64,
    chunked: bool,
    chunk_remaining: i64,
    total: i64,
    maximum: i64,
    finished: bool,
    started: bool,
    expect_continue: bool,
    valid: bool,
}

pub struct BodyResult { ok: bool, eof: bool, count: i64, status: i32, error: string }

@c_layout
struct Timespec { seconds: i64, nanos: i64 }

@extern("c", "clock_gettime")
unsafe fn clock_gettime(clock: i32, result: ptr) -> i32

fn now_ms() -> i64 {
    unsafe {
        mut value: Timespec = zeroed()
        mut clock := 1
        if target_is("macos") { clock = 6 }
        if clock_gettime(clock, addr(&mut value)) != 0 { return sys.now_ms() }
        value.seconds * 1000 + value.nanos / 1000000
    }
}

fn fail(status: i32, message: string) -> Request {
    Request {
        ok: false, status: status, method: "", target: "",
        header_names: [], header_values: [], body: [], error: message.clone(),
    }
}

fn token(value: string) -> bool {
    if value.len == 0 { return false }
    for b in value.bytes() {
        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) { continue }
        if b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126 { continue }
        return false
    }
    true
}

fn lower(value: string) -> string {
    mut out: []u8 = []
    out.reserve(value.len)
    for b in value.bytes() {
        if b >= 65 && b <= 90 { out.push(u8(b + 32)) }
        else { out.push(u8(b)) }
    }
    bytes.decode(&out).value
}

fn trim_ows(value: string) -> string {
    mut start := 0
    mut end := value.len
    while start < end && (value[start] == 32 || value[start] == 9) { start += 1 }
    while end > start && (value[end - 1] == 32 || value[end - 1] == 9) { end -= 1 }
    value[start..end]
}

fn valid_value(value: string) -> bool {
    for b in value.bytes() {
        if (b < 32 && b != 9) || b == 127 { return false }
    }
    true
}

fn control_header(name: string) -> bool {
    name == "host" || name == "authorization" || name == "proxy-authorization" || name == "content-length" || name == "transfer-encoding" || name == "content-type" || name == "expect" || name == "origin" || name == "connection"
}

fn singleton(name: string) -> bool {
    control_header(name) || text.starts_with(name, "x-")
}

fn control_trailer(name: string) -> bool {
    control_header(name) || (text.starts_with(name, "x-") && text.ends_with(name, "-token")) || name == "trailer" || name == "te" || name == "upgrade" || name == "keep-alive" || name == "proxy-connection"
}

fn wait_ready(stream: &net.TcpStream, events: i32, deadline: i64) -> bool {
    mut poll := net.PollSet::new()
    poll.add(stream.fd(), events)
    while true {
        remaining := deadline - now_ms()
        if remaining <= 0 { return false }
        mut delay := remaining
        if delay > 2147483647 { delay = 2147483647 }
        match poll.poll(i32(delay)) {
            .Ok(count) => { return count > 0 },
            .Err(err) => { if err != sys.IoError.Interrupted { return false } },
        }
    }
    false
}

fn fill(stream: &net.TcpStream, reader: &mut Reader, limit: i32) -> bool {
    if reader.buffer.len >= limit {
        reader.status = 431
        reader.error = "HTTP framing exceeds its limit"
        return false
    }
    while true {
        if now_ms() >= reader.deadline {
            reader.status = 408
            reader.error = "request deadline exceeded"
            return false
        }
        mut amount := limit - reader.buffer.len
        if amount > 8192 { amount = 8192 }
        match stream.read_append(&mut reader.buffer, amount) {
            .Ok(count) => {
                if count > 0 { return true }
                reader.status = 400
                reader.error = "truncated HTTP request"
                return false
            },
            .Err(err) => {
                if err == sys.IoError.Interrupted { continue }
                if !err.is_would_block() {
                    reader.status = 400
                    reader.error = "cannot read HTTP request"
                    return false
                }
            },
        }
        if !wait_ready(&stream, net.poll_in(), reader.deadline) {
            reader.status = 408
            reader.error = "request deadline exceeded"
            return false
        }
    }
    false
}

fn read_line(stream: &net.TcpStream, reader: &mut Reader, maximum: i32, limit: i32) -> sys.TextResult {
    while true {
        end := bytes.find_crlf(&reader.buffer, reader.offset, reader.buffer.len).unwrap_or(-1)
        newline := bytes.find_byte(&reader.buffer, reader.offset, reader.buffer.len, b'\n').unwrap_or(-1)
        if newline >= 0 && (end < 0 || newline != end + 1) {
            reader.status = 400
            reader.error = "HTTP lines require CRLF"
            return sys.TextResult { ok: false, value: "", error: 22 }
        }
        if end >= 0 {
            if end - reader.offset > maximum || end + 2 > limit {
                reader.status = 431
                reader.error = "HTTP line exceeds its limit"
                return sys.TextResult { ok: false, value: "", error: 22 }
            }
            result := bytes.decode_range(&reader.buffer, reader.offset, end)
            reader.offset = end + 2
            if !result.ok {
                reader.status = 400
                reader.error = "invalid UTF-8 in HTTP head"
            }
            return result
        }
        if reader.buffer.len - reader.offset > maximum + 1 {
            reader.status = 431
            reader.error = "HTTP line exceeds its limit"
            return sys.TextResult { ok: false, value: "", error: 22 }
        }
        if !fill(&stream, &mut reader, limit) {
            return sys.TextResult { ok: false, value: "", error: 22 }
        }
    }
    sys.TextResult { ok: false, value: "", error: 22 }
}

struct HeaderPart { ok: bool, name: string, value: string }

fn header_parts(line: string) -> HeaderPart {
    colon := text.find(line, ":").unwrap_or(-1)
    if colon <= 0 { return HeaderPart { ok: false, name: "", value: "" } }
    name := lower(line[0..colon])
    value := trim_ows(line[colon + 1..line.len])
    if !token(name) || !valid_value(value) { return HeaderPart { ok: false, name: "", value: "" } }
    HeaderPart { ok: true, name: name, value: value }
}

fn append_header(req: &mut Request, line: string) -> bool {
    part := header_parts(line)
    if !part.ok { return false }
    if singleton(part.name) {
        for previous in &req.header_names { if previous == part.name { return false } }
    }
    req.header_names.push(move part.name)
    req.header_values.push(move part.value)
    true
}

pub fn header(req: &Request, name: string) -> string {
    wanted := lower(name)
    for i in 0..req.header_names.len {
        if req.header_names[i] == wanted { return req.header_values[i].clone() }
    }
    ""
}

pub fn headers(req: &Request, name: string) -> []string {
    wanted := lower(name)
    mut result: []string = []
    for i in 0..req.header_names.len {
        if req.header_names[i] == wanted { result.push(req.header_values[i].clone()) }
    }
    result
}

fn has_header(req: &Request, name: string) -> bool {
    for current in &req.header_names { if current == name { return true } }
    false
}

fn decimal(value: string, maximum: i64) -> i64 {
    if value.len == 0 || value.len > 20 { return -1 }
    number := parse.u64_range(value, 0, value.len)
    if !number.ok { return -1 }
    if number.value > u64(maximum) { return -2 }
    i64(number.value)
}

fn chunk_size(value: string, maximum: i64) -> i64 {
    semicolon := text.find(value, ";").unwrap_or(-1)
    mut end := value.len
    if semicolon >= 0 { end = semicolon }
    if end == 0 || end > 16 || !valid_value(value) { return -1 }
    number := parse.hex_u64_range(value, 0, end)
    if !number.ok { return -1 }
    if number.value > u64(maximum) { return -2 }
    i64(number.value)
}

fn read_exact(stream: &net.TcpStream, reader: &mut Reader, out: &mut []u8, count: i32) -> bool {
    mut left := count
    while left > 0 {
        if reader.offset == reader.buffer.len {
            reader.buffer.clear()
            reader.offset = 0
            if !fill(&stream, &mut reader, left) { return false }
        }
        mut amount := reader.buffer.len - reader.offset
        if amount > left { amount = left }
        bytes.extend_range(&mut out, &reader.buffer, reader.offset, reader.offset + amount)
        reader.offset += amount
        left -= amount
    }
    true
}

fn parse_head(stream: &net.TcpStream, reader: &mut Reader, max_body: i64) -> Request {
    first := read_line(&stream, &mut reader, 8192, 32768)
    if !first.ok { return fail(reader.status, reader.error) }
    mut parts := text.split(first.value, " ")
    if parts.len != 3 { return fail(400, "invalid HTTP request line") }
    version := parts.pop()
    target := parts.pop()
    method := parts.pop()
    if !token(method) || (version != "HTTP/1.0" && version != "HTTP/1.1") { return fail(400, "invalid HTTP request line") }
    if !text.starts_with(target, "/") { return fail(400, "HTTP target requires origin form") }
    for b in target.bytes() {
        if b <= 32 || b == 127 || b == 35 || b == 92 { return fail(400, "invalid HTTP request target") }
    }
    mut req := Request {
        ok: true, status: 200, method: method, target: target,
        header_names: [], header_values: [], body: [], error: "",
    }
    while true {
        line := read_line(&stream, &mut reader, 8192, 32768)
        if !line.ok { return fail(reader.status, reader.error) }
        if line.value.len == 0 { break }
        if req.header_names.len >= 100 { return fail(431, "too many HTTP headers") }
        if !append_header(&mut req, line.value) { return fail(400, "invalid or duplicate HTTP header") }
    }
    if version == "HTTP/1.1" && header(&req, "host").len == 0 { return fail(400, "Host required") }
    transfer := lower(header(&req, "transfer-encoding"))
    has_transfer := has_header(&req, "transfer-encoding")
    has_length := has_header(&req, "content-length")
    if has_transfer && (transfer != "chunked" || has_length) { return fail(400, "ambiguous or unsupported HTTP body framing") }
    mut size: i64 = 0
    if has_length {
        size = decimal(header(&req, "content-length"), max_body)
        if size == -1 { return fail(400, "invalid Content-Length") }
        if size == -2 { return fail(413, "request body exceeds its limit") }
    }
    if has_header(&req, "expect") {
        if lower(header(&req, "expect")) != "100-continue" { return fail(417, "unsupported Expect header") }
    }
    req
}

fn compact(reader: &mut Reader) {
    if reader.offset > 0 {
        count := reader.offset
        bytes.consume_prefix(&mut reader.buffer, count)
        reader.offset = 0
    }
}

fn body_result(ok: bool, eof: bool, count: i64, status: i32, error: string) -> BodyResult {
    BodyResult { ok: ok, eof: eof, count: count, status: status, error: error.clone() }
}

impl BodyReader {
    pub fn new(head: &Request, max_bytes: i64, timeout_ms: i64) -> Self {
        mut value := Self {
            reader: Reader { buffer: [], offset: 0, deadline: 0, status: 200, error: "" },
            remaining: 0, chunked: false, chunk_remaining: 0, total: 0, maximum: max_bytes,
            finished: false, started: false, expect_continue: false, valid: true,
        }
        if max_bytes < 0 || timeout_ms <= 0 || timeout_ms > 3600000 {
            value.reject(500, "invalid HTTP reader limits"); return value
        }
        value.reader.deadline = now_ms() + timeout_ms
        if !head.ok { value.reject(head.status, head.error); return value }
        if head.body.len != 0 || head.header_names.len != head.header_values.len {
            value.reject(500, "BodyReader requires an unconsumed request head"); return value
        }
        value.chunked = has_header(&head, "transfer-encoding")
        has_length := has_header(&head, "content-length")
        if value.chunked && (lower(header(&head, "transfer-encoding")) != "chunked" || has_length) {
            value.reject(400, "ambiguous or unsupported HTTP body framing"); return value
        }
        if has_length {
            size := decimal(header(&head, "content-length"), max_bytes)
            if size == -1 { value.reject(400, "invalid Content-Length"); return value }
            if size == -2 { value.reject(413, "request body exceeds its limit"); return value }
            value.remaining = size
        }
        if has_header(&head, "expect") {
            if lower(header(&head, "expect")) != "100-continue" {
                value.reject(417, "unsupported Expect header"); return value
            }
            value.expect_continue = true
        }
        value
    }

    pub fn ok(&self) -> bool { self.valid }
    pub fn status(&self) -> i32 { self.reader.status }
    pub fn error(&self) -> string { self.reader.error.clone() }
    pub fn count(&self) -> i64 { self.total }

    fn reject(&mut self, status: i32, message: string) {
        self.valid = false
        self.reader.status = status
        self.reader.error = message.clone()
    }

    fn failed(&mut self) -> BodyResult {
        self.valid = false
        body_result(false, false, 0, self.reader.status, self.reader.error)
    }

    fn finish_trailers(&mut self, stream: &net.TcpStream) -> bool {
        mut trailer_bytes := 0; mut trailer_count := 0
        while true {
            compact(&mut self.reader)
            trailer := read_line(&stream, &mut self.reader, 8192, 8194)
            if !trailer.ok { return false }
            trailer_bytes += trailer.value.len + 2
            if trailer_bytes > 8192 { self.reject(431, "HTTP trailers exceed their limit"); return false }
            if trailer.value.len == 0 { self.finished = true; return true }
            trailer_count += 1
            if trailer_count > 20 { self.reject(431, "too many HTTP trailers"); return false }
            part := header_parts(trailer.value)
            if !part.ok { self.reject(400, "invalid HTTP trailer"); return false }
            if control_trailer(part.name) { self.reject(400, "HTTP control trailer refused"); return false }
        }
        false
    }

    pub fn read(&mut self, stream: &net.TcpStream, chunk: &mut []u8, max_chunk: i32) -> BodyResult {
        chunk.clear()
        if !self.valid { return self.failed() }
        if max_chunk < 1 || max_chunk > 1048576 { self.reject(500, "invalid HTTP chunk buffer limit"); return self.failed() }
        if self.finished { return body_result(true, true, 0, 200, "") }
        if !stream.set_nonblocking(true).ok { self.reject(500, "cannot configure HTTP stream"); return self.failed() }
        if !self.started {
            self.started = true
            if self.expect_continue {
                mut interim: []u8 = []
                bytes.append_utf8(&mut interim, "HTTP/1.1 100 Continue\r\n\r\n")
                remaining := self.reader.deadline - now_ms()
                if remaining <= 0 || !write_all(&stream, &interim, remaining) {
                    self.reject(408, "cannot send HTTP continue"); return self.failed()
                }
            }
        }
        if now_ms() >= self.reader.deadline { self.reject(408, "request deadline exceeded"); return self.failed() }
        if self.chunked && self.chunk_remaining == 0 {
            compact(&mut self.reader)
            line := read_line(&stream, &mut self.reader, 1024, 1026)
            if !line.ok { return self.failed() }
            size := chunk_size(line.value, self.maximum - self.total)
            if size == -1 { self.reject(400, "invalid HTTP chunk size"); return self.failed() }
            if size == -2 { self.reject(413, "request body exceeds its limit"); return self.failed() }
            if size == 0 {
                if !self.finish_trailers(&stream) { return self.failed() }
                return body_result(true, true, 0, 200, "")
            }
            self.chunk_remaining = size
        }
        mut amount := self.remaining
        if self.chunked { amount = self.chunk_remaining }
        if amount == 0 { self.finished = true; return body_result(true, true, 0, 200, "") }
        if amount > i64(max_chunk) { amount = i64(max_chunk) }
        if !read_exact(&stream, &mut self.reader, &mut chunk, i32(amount)) { chunk.clear(); return self.failed() }
        self.total += amount
        if self.chunked {
            self.chunk_remaining -= amount
            if self.chunk_remaining == 0 {
                mut ending: []u8 = []
                if !read_exact(&stream, &mut self.reader, &mut ending, 2) { chunk.clear(); return self.failed() }
                if ending.len != 2 || ending[0] != b'\r' || ending[1] != b'\n' {
                    chunk.clear(); self.reject(400, "invalid HTTP chunk ending"); return self.failed()
                }
            }
        } else { self.remaining -= amount }
        body_result(true, false, amount, 200, "")
    }
}

pub fn read_body(stream: &net.TcpStream, move head: Request, max_body: i32, timeout_ms: i64) -> Request {
    if max_body < 0 || max_body > 67108864 { return fail(500, "invalid HTTP reader limits") }
    if !head.ok { return head }
    mut reader := BodyReader::new(&head, i64(max_body), timeout_ms)
    if !reader.ok() { return fail(reader.status(), reader.error()) }
    mut req := head
    mut chunk: []u8 = []
    while true {
        result := reader.read(&stream, &mut chunk, 65536)
        if !result.ok { return fail(result.status, result.error) }
        if result.eof { return req }
        bytes.extend(&mut req.body, &chunk)
    }
    req
}

pub fn read_request(stream: &net.TcpStream, max_body: i32, timeout_ms: i64) -> Request {
    if max_body < 0 || max_body > 67108864 || timeout_ms <= 0 || timeout_ms > 3600000 { return fail(500, "invalid HTTP reader limits") }
    deadline := now_ms() + timeout_ms
    head := read_head(&stream, timeout_ms)
    if !head.ok { return head }
    remaining := deadline - now_ms()
    if remaining <= 0 { return fail(408, "request deadline exceeded") }
    read_body(&stream, move head, max_body, remaining)
}

fn partial_head_status(buffer: &[]u8) -> i32 {
    mut start := 0
    for i in 0..buffer.len {
        if buffer[i] == b'\n' {
            if i == 0 || buffer[i - 1] != b'\r' { return 400 }
            if i - 1 - start > 8192 { return 431 }
            start = i + 1
        } else if buffer[i] == b'\r' && i + 1 < buffer.len && buffer[i + 1] != b'\n' { return 400 }
    }
    remaining := buffer.len - start
    if remaining > 8192 {
        if remaining != 8193 || buffer[buffer.len - 1] != b'\r' { return 431 }
    }
    0
}

fn read_head_wire(stream: &net.TcpStream, reader: &mut Reader) -> bool {
    mut peek: []u8 = []
    while true {
        if now_ms() >= reader.deadline {
            reader.status = 408
            reader.error = "request deadline exceeded"
            return false
        }
        peek.clear()
        match stream.peek_append(&mut peek, 8192) {
            .Ok(count) => {
                if count == 0 {
                    reader.status = 400
                    reader.error = "truncated HTTP request"
                    return false
                }
            },
            .Err(err) => {
                if !err.is_would_block() {
                    reader.status = 400
                    reader.error = "cannot read HTTP request"
                    return false
                }
                if !wait_ready(&stream, net.poll_in(), reader.deadline) {
                    reader.status = 408
                    reader.error = "request deadline exceeded"
                    return false
                }
                continue
            },
        }
        mut start := reader.buffer.len - 3
        if start < 0 { start = 0 }
        suffix := reader.buffer.len - start
        mut scan: []u8 = []
        bytes.extend_range(&mut scan, &reader.buffer, start, reader.buffer.len)
        bytes.extend(&mut scan, &peek)
        boundary := bytes.find_double_crlf(&scan, 0, scan.len).unwrap_or(-1)
        mut amount := peek.len
        if boundary >= 0 { amount = boundary + 4 - suffix }
        if reader.buffer.len + amount > 32768 {
            reader.status = 431
            reader.error = "HTTP headers exceed their limit"
            return false
        }
        mut left := amount
        while left > 0 {
            match stream.read_append(&mut reader.buffer, left) {
                .Ok(count) => {
                    if count == 0 {
                        reader.status = 400
                        reader.error = "cannot consume HTTP head"
                        return false
                    }
                    left -= i32(count)
                },
                .Err(_) => {
                    reader.status = 400
                    reader.error = "cannot consume HTTP head"
                    return false
                },
            }
        }
        partial_status := partial_head_status(&reader.buffer)
        if partial_status != 0 {
            reader.status = partial_status
            reader.error = "invalid or oversized HTTP head line"
            return false
        }
        if boundary >= 0 { return true }
        if reader.buffer.len >= 32768 {
            reader.status = 431
            reader.error = "HTTP headers exceed their limit"
            return false
        }
    }
    false
}

pub fn read_head(stream: &net.TcpStream, timeout_ms: i64) -> Request {
    if timeout_ms <= 0 || timeout_ms > 3600000 { return fail(500, "invalid HTTP reader limits") }
    if !stream.set_nonblocking(true).ok { return fail(500, "cannot configure HTTP stream") }
    mut reader := Reader { buffer: [], offset: 0, deadline: now_ms() + timeout_ms, status: 400, error: "invalid HTTP request" }
    if !read_head_wire(&stream, &mut reader) { return fail(reader.status, reader.error) }
    parse_head(&stream, &mut reader, 9223372036854775807)
}

pub fn write_all(stream: &net.TcpStream, data: &[]u8, timeout_ms: i64) -> bool {
    if timeout_ms <= 0 || timeout_ms > 3600000 { return false }
    if !stream.set_nonblocking(true).ok { return false }
    deadline := now_ms() + timeout_ms
    mut offset := 0
    while offset < data.len {
        if now_ms() >= deadline { return false }
        match stream.write_range(&data, offset, data.len - offset) {
            .Ok(count) => {
                if count <= 0 { return false }
                offset += i32(count)
            },
            .Err(err) => {
                if err == sys.IoError.Interrupted { continue }
                if err.is_would_block() {
                    if !wait_ready(&stream, net.poll_out(), deadline) { return false }
                } else { return false }
            },
        }
    }
    true
}

fn reason(status: i32) -> string {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 204 { return "No Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 303 { return "See Other" }
    if status == 304 { return "Not Modified" }
    if status == 307 { return "Temporary Redirect" }
    if status == 308 { return "Permanent Redirect" }
    if status == 400 { return "Bad Request" }
    if status == 401 { return "Unauthorized" }
    if status == 403 { return "Forbidden" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 408 { return "Request Timeout" }
    if status == 409 { return "Conflict" }
    if status == 413 { return "Content Too Large" }
    if status == 417 { return "Expectation Failed" }
    if status == 429 { return "Too Many Requests" }
    if status == 431 { return "Request Header Fields Too Large" }
    if status == 500 { return "Internal Server Error" }
    if status == 502 { return "Bad Gateway" }
    if status == 503 { return "Service Unavailable" }
    "Response"
}

pub fn write_response(stream: &net.TcpStream, status: i32, content_type: string, extra_names: &[]string, extra_values: &[]string, body: &[]u8, head: bool) -> bool {
    if status < 100 || status > 599 || extra_names.len != extra_values.len || !valid_value(content_type) { return false }
    mut output: []u8 = []
    bytes.append_utf8(&mut output, f"HTTP/1.1 {status} {reason(status)}\r\nConnection: close\r\n")
    if content_type.len > 0 { bytes.append_utf8(&mut output, f"Content-Type: {content_type}\r\n") }
    mut length := body.len
    if status < 200 || status == 204 || status == 205 || status == 304 { length = 0 }
    if status >= 200 && status != 204 && status != 304 {
        bytes.append_utf8(&mut output, f"Content-Length: {length}\r\n")
    }
    for i in 0..extra_names.len {
        name := lower(extra_names[i])
        if !token(name) || !valid_value(extra_values[i]) || name == "content-length" || name == "transfer-encoding" || name == "connection" || name == "content-type" { return false }
        bytes.append_utf8(&mut output, f"{extra_names[i]}: {extra_values[i]}\r\n")
    }
    bytes.append_utf8(&mut output, "\r\n")
    if !head && length > 0 { bytes.extend(&mut output, &body) }
    write_all(&stream, &output, 30000)
}
