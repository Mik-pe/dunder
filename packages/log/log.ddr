import std.bytes as bytes
import std.io as io
import std.json as json
import std.text as text
import std.text.view as tv
import std.time as time
import sys

pub enum Level {
    Debug = 0,
    Info = 1,
    Warn = 2,
    Error = 3,
}

pub enum Format {
    Text,
    Json,
}

pub fn level_rank(level: Level) -> i32 {
    match level {
        .Debug => 0,
        .Info => 1,
        .Warn => 2,
        .Error => 3,
    }
}

pub fn level_name(level: Level) -> string {
    match level {
        .Debug => "DEBUG",
        .Info => "INFO",
        .Warn => "WARN",
        .Error => "ERROR",
    }
}

pub fn parse_level(raw: &str) -> Option<Level> {
    trimmed := tv.trim(raw)
    owned := text.lower(trimmed.str())
    if owned == "debug" { return .Some(.Debug) }
    if owned == "info" { return .Some(.Info) }
    if owned == "warn" || owned == "warning" { return .Some(.Warn) }
    if owned == "error" || owned == "err" { return .Some(.Error) }
    .None
}

impl Eq for Level {
    fn eq(&self, other: &Self) -> bool { level_rank(self) == level_rank(other) }
}

impl Ord for Level {
    fn cmp(&self, other: &Self) -> Ordering { level_rank(self).cmp(&level_rank(other)) }
}

impl Display for Level {
    fn str(&self) -> string { level_name(self) }
}

impl Eq for Format {
    fn eq(&self, other: &Self) -> bool {
        match self {
            .Text => match other { .Text => true, _ => false },
            .Json => match other { .Json => true, _ => false },
        }
    }
}

pub enum FieldValue {
    Str(string),
    Int(i64),
    Float(f64),
    Bool(bool),
}

pub struct Field {
    key: string,
    value: FieldValue,
}

pub fn str_field(key: &str, val: &str) -> Field {
    Field { key: key.clone(), value: .Str(val.clone()) }
}

pub fn int_field(key: &str, val: i64) -> Field {
    Field { key: key.clone(), value: .Int(val) }
}

pub fn float_field(key: &str, val: f64) -> Field {
    Field { key: key.clone(), value: .Float(val) }
}

pub fn bool_field(key: &str, val: bool) -> Field {
    Field { key: key.clone(), value: .Bool(val) }
}

pub struct BufferWriter {
    buf: []u8,
}

impl BufferWriter {
    pub fn new() -> Self { Self { buf: [] } }
    pub fn as_bytes(&self) -> &[]u8 { &self.buf }
    pub fn as_string(&self) -> string {
        dec := bytes.decode(&self.buf)
        if dec.ok { dec.value } else { "" }
    }
    pub fn clear(&mut self) { self.buf.clear() }
}

impl io.Write for BufferWriter {
    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {
        bytes.extend(&mut self.buf, data)
        .Ok(data.len)
    }

    fn flush(&mut self) -> Result<(), sys.IoError> {
        .Ok
    }
}

pub struct Logger {
    min_level: Level,
    format: Format,
    target: string,
    include_ts: bool,
    fields: []Field,
}

fn needs_quotes(val: &str) -> bool {
    if val.len == 0 { return true }
    for b in val.bytes() {
        if b <= 32 || b == b'"' || b == b'\\' || b == b'=' || b == 127 { return true }
    }
    false
}

fn append_logfmt_quoted(out: &mut []u8, val: &str) {
    out.push(b'"')
    for b in val.bytes() {
        if b == b'"' { out.push(b'\\'); out.push(b'"') }
        else if b == b'\\' { out.push(b'\\'); out.push(b'\\') }
        else if b == b'\n' { out.push(b'\\'); out.push(b'n') }
        else if b == b'\r' { out.push(b'\\'); out.push(b'r') }
        else if b == b'\t' { out.push(b'\\'); out.push(b't') }
        else { out.push(b) }
    }
    out.push(b'"')
}

fn append_logfmt_value(out: &mut []u8, val: &str) {
    if needs_quotes(val) {
        append_logfmt_quoted(&mut out, val)
    } else {
        bytes.append_utf8(&mut out, val.str())
    }
}

fn append_logfmt_field(out: &mut []u8, f: &Field) {
    out.push(b' ')
    append_logfmt_value(&mut out, f.key)
    out.push(b'=')
    match &f.value {
        .Str(s) => append_logfmt_value(&mut out, s),
        .Int(n) => bytes.append_decimal(&mut out, n),
        .Float(x) => bytes.append_utf8(&mut out, x.str()),
        .Bool(b) => bytes.append_utf8(&mut out, if b { "true" } else { "false" }),
    }
}

fn write_json_field(w: &mut json.Writer, f: &Field) {
    w.key(f.key.clone())
    match &f.value {
        .Str(s) => w.string(s.clone()),
        .Int(n) => w.integer(n),
        .Float(x) => {
            if x.is_finite() { w.decimal(x) } else { w.string(x.str()) }
        },
        .Bool(b) => w.boolean(b),
    }
}

impl Logger {
    pub fn new(min_level: Level, format: Format) -> Self {
        Self { min_level: min_level, format: format, target: "", include_ts: true, fields: [] }
    }

    pub fn with_target(move self, target: &str) -> Self {
        mut out := self
        out.target = target.clone()
        out
    }

    pub fn with_timestamps(move self, enabled: bool) -> Self {
        mut out := self
        out.include_ts = enabled
        out
    }

    pub fn add_field(&mut self, move field: Field) {
        self.fields.push(move field)
    }

    pub fn with_field(move self, move field: Field) -> Self {
        mut out := self
        out.add_field(move field)
        out
    }

    pub fn child(&self, target: &str, extra: &[]Field) -> Logger {
        mut next_fields := self.fields.clone()
        for f in extra { next_fields.push(f.clone()) }
        next_target := if target.len > 0 { target.clone() } else { self.target.clone() }
        Logger {
            min_level: self.min_level,
            format: self.format,
            target: next_target,
            include_ts: self.include_ts,
            fields: next_fields,
        }
    }

    pub fn enabled(&self, level: Level) -> bool {
        level_rank(level) >= level_rank(self.min_level)
    }

    pub fn format_record(&self, level: Level, msg: &str, fields: &[]Field, unix_ts: Option<i64>) -> string {
        match self.format {
            .Text => {
                mut out: []u8 = []
                mut need_space := false
                match unix_ts {
                    .Some(ts) => {
                        bytes.append_utf8(&mut out, "ts=" + time.format_rfc3339(ts))
                        need_space = true
                    },
                    .None => {},
                }
                if need_space { out.push(b' ') }
                bytes.append_utf8(&mut out, "level=" + level_name(level))
                if self.target.len > 0 {
                    bytes.append_utf8(&mut out, " target=")
                    append_logfmt_value(&mut out, self.target)
                }
                bytes.append_utf8(&mut out, " msg=")
                append_logfmt_quoted(&mut out, msg)
                for f in &self.fields { append_logfmt_field(&mut out, f) }
                for f in fields { append_logfmt_field(&mut out, f) }
                dec := bytes.decode(&out)
                if dec.ok { dec.value } else { "" }
            },
            .Json => {
                mut w := json.Writer::new()
                w.object()
                match unix_ts {
                    .Some(ts) => {
                        w.key("ts")
                        w.string(time.format_rfc3339(ts))
                    },
                    .None => {},
                }
                w.key("level")
                w.string(level_name(level))
                if self.target.len > 0 {
                    w.key("target")
                    w.string(self.target.clone())
                }
                w.key("msg")
                w.string(msg.clone())
                for f in &self.fields { write_json_field(&mut w, f) }
                for f in fields { write_json_field(&mut w, f) }
                w.end()
                match w.finish() {
                    .Ok(s) => s,
                    .Err(_) => "{}",
                }
            },
        }
    }

    pub fn write_record_at<W: io.Write>(&self, out: &mut W, level: Level, msg: &str, fields: &[]Field, unix_ts: Option<i64>) -> Result<bool, sys.IoError> {
        if !self.enabled(level) { return .Ok(false) }
        line := self.format_record(level, msg, fields, unix_ts) + "\n"
        out.write_str(line)?
        .Ok(true)
    }

    pub fn write_record<W: io.Write>(&self, out: &mut W, level: Level, msg: &str, fields: &[]Field) -> Result<bool, sys.IoError> {
        if !self.enabled(level) { return .Ok(false) }
        ts: Option<i64> = if self.include_ts { .Some(time.unix_now_secs()) } else { .None }
        self.write_record_at<W>(&mut out, level, msg, fields, ts)
    }

    pub fn debug<W: io.Write>(&self, out: &mut W, msg: &str, fields: &[]Field) -> Result<bool, sys.IoError> {
        self.write_record<W>(&mut out, .Debug, msg, fields)
    }

    pub fn info<W: io.Write>(&self, out: &mut W, msg: &str, fields: &[]Field) -> Result<bool, sys.IoError> {
        self.write_record<W>(&mut out, .Info, msg, fields)
    }

    pub fn warn<W: io.Write>(&self, out: &mut W, msg: &str, fields: &[]Field) -> Result<bool, sys.IoError> {
        self.write_record<W>(&mut out, .Warn, msg, fields)
    }

    pub fn error<W: io.Write>(&self, out: &mut W, msg: &str, fields: &[]Field) -> Result<bool, sys.IoError> {
        self.write_record<W>(&mut out, .Error, msg, fields)
    }
}

@test fn structured_logger_formats_text_json_and_filters_levels() {
    assert(parse_level(" debug ") == .Some(.Debug))
    assert(parse_level("WARN") == .Some(.Warn))
    assert(parse_level("bogus") == .None)

    base := Logger::new(.Info, .Text)
        .with_target("api")
        .with_field(str_field("env", "prod"))
    child := base.child("api.auth", &[int_field("worker", 2)])

    mut text_sink := BufferWriter::new()
    // Debug should be filtered out at min_level Info
    assert(child.write_record_at<BufferWriter>(&mut text_sink, .Debug, "skip", &[], .Some(0)) == .Ok(false))
    assert(text_sink.as_string() == "")

    assert(child.write_record_at<BufferWriter>(&mut text_sink, .Warn, "bad \"token\"\nok", &[bool_field("retry", false)], .Some(1700000000)) == .Ok(true))
    text_line := text_sink.as_string()
    expected := "ts=2023-11-14T22:13:20Z level=WARN target=api.auth msg=\"bad \\\"token\\\"\\nok\" env=prod worker=2 retry=false\n"
    assert(text_line == expected)

    json_log := Logger::new(.Debug, .Json)
        .with_target("db")
        .with_field(float_field("latency_ms", 12.5))
    mut json_sink := BufferWriter::new()
    assert(json_log.write_record_at<BufferWriter>(&mut json_sink, .Info, "query ok", &[int_field("rows", 3)], .Some(0)) == .Ok(true))
    doc := json.Doc::parse_text(tv.trim(json_sink.as_string()).str())
    assert(doc.ok)
    assert(doc.get_str(doc.root, "ts") == .Some("1970-01-01T00:00:00Z"))
    assert(doc.get_str(doc.root, "level") == .Some("INFO"))
    assert(doc.get_str(doc.root, "target") == .Some("db"))
    assert(doc.get_str(doc.root, "msg") == .Some("query ok"))
    assert(doc.get_i64(doc.root, "rows") == .Some(3))
    assert(doc.get_f64(doc.root, "latency_ms").unwrap_or(0.0) == 12.5)
}
