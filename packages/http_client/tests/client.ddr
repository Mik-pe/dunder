capability network
import http_client as client
import std.bytes as bytes
import sys

struct Monitor { origin: string, started: i64, renewed: bool, polls: i32 }

fn monitor_tick(state: &mut Monitor) -> bool {
    state.polls += 1
    if sys.now_ms() - state.started < 100 { return true }
    if !state.renewed {
        names: []string = []
        body: []u8 = []
        nested := client.request("GET", state.origin + "/renew", &names, &names, &body, 1000, 1024)
        assert(nested.ok && nested.status == 200)
        state.renewed = true
    }
    false
}

fn main() {
    assert(sys.arg_count() == 6)
    origin := sys.arg(1)
    tls_origin := sys.arg(2)
    ca_file := sys.arg(3)
    names: []string = ["X-Probe", "Content-Type"]
    values: []string = ["dunder", "application/octet-stream"]
    empty_names: []string = []
    empty_body: []u8 = []
    payload: []u8 = [0, 1, 2, 127, 128, 255, 0]
    for _ in 0..12 {
        reply := client.request("GET", origin + "/ok", &empty_names, &empty_names, &empty_body, 3000, 1024)
        assert(reply.ok && reply.status == 200 && reply.transport_code == 0 && reply.error == "")
        assert(bytes.decode(&reply.body).unwrap_or_default() == "hello HTTP")
    }
    methods := ["POST", "PUT", "PATCH", "DELETE"]
    for method in &methods {
        reply := client.request(method, origin + "/echo", &names, &values, &payload, 3000, 1024)
        assert(reply.ok && reply.status == 201)
        assert(reply.body.len == payload.len)
        for i in 0..payload.len { assert(reply.body[i] == payload[i]) }
    }
    rejected := client.request("GET", origin + "/status", &empty_names, &empty_names, &empty_body, 3000, 1024)
    assert(rejected.ok && rejected.status == 418)
    assert(rejected.body.len == 4 && rejected.body[1] == 0 && rejected.body[3] == 255)
    head := client.request("HEAD", origin + "/head", &empty_names, &empty_names, &empty_body, 3000, 1024)
    assert(head.ok && head.status == 200 && head.body.len == 0)
    redirect := client.request("GET", origin + "/redirect", &names, &values, &empty_body, 3000, 1024)
    assert(redirect.ok && redirect.status == 302)
    assert(bytes.decode(&redirect.body).unwrap_or_default() == "redirect")
    large := client.request("GET", origin + "/large", &empty_names, &empty_names, &empty_body, 3000, 16)
    assert(!large.ok && large.status == 200 && large.body.len <= 16)
    assert(large.error == "declared HTTP response exceeds size limit")
    chunked := client.request("GET", origin + "/chunked-large", &empty_names, &empty_names, &empty_body, 3000, 16)
    assert(!chunked.ok && chunked.error == "HTTP response exceeds its byte limit" && chunked.body.len <= 16)
    empty := client.request("GET", origin + "/empty", &empty_names, &empty_names, &empty_body, 3000, 0)
    assert(empty.ok && empty.status == 204 && empty.body.len == 0)
    slow := client.request("GET", origin + "/slow", &empty_names, &empty_names, &empty_body, 50, 1024)
    assert(!slow.ok && slow.transport_code == 28 && slow.error.len > 0)
    refused := client.request("GET", sys.arg(5), &empty_names, &empty_names, &empty_body, 3000, 1024)
    assert(!refused.ok && refused.status == 0 && refused.transport_code == 7)

    bad_names: []string = ["X-Header\r\nInjected"]
    one_value: []string = ["value"]
    bad_values: []string = ["value\r\nInjected: yes"]
    one_name: []string = ["X-Header"]
    assert(!client.request("GET\r\nPOST", origin + "/ok", &empty_names, &empty_names, &empty_body, 3000, 1024).ok)
    assert(!client.request("GET", "file:///etc/passwd", &empty_names, &empty_names, &empty_body, 3000, 1024).ok)
    assert(!client.request("GET", "http://user:pass@127.0.0.1/", &empty_names, &empty_names, &empty_body, 3000, 1024).ok)
    assert(!client.request("GET", origin + "/ok", &bad_names, &one_value, &empty_body, 3000, 1024).ok)
    assert(!client.request("GET", origin + "/ok", &one_name, &bad_values, &empty_body, 3000, 1024).ok)
    assert(!client.request("GET", origin + "/ok", &one_name, &empty_names, &empty_body, 3000, 1024).ok)
    assert(!client.request("GET", origin + "/ok", &empty_names, &empty_names, &empty_body, 0, 1024).ok)
    assert(!client.request("GET", origin + "/ok", &empty_names, &empty_names, &empty_body, 3000, -1).ok)
    assert(!client.request("HEAD", origin + "/head", &names, &values, &payload, 3000, 1024).ok)

    trusted := client.request_with_ca("GET", tls_origin + "/ok", &empty_names, &empty_names, &empty_body, 3000, 1024, ca_file)
    assert(trusted.ok && trusted.status == 200 && bytes.decode(&trusted.body).unwrap_or_default() == "hello HTTP")
    untrusted := client.request("GET", tls_origin + "/ok", &empty_names, &empty_names, &empty_body, 3000, 1024)
    assert(!untrusted.ok && untrusted.status == 0 && untrusted.error.len > 0)
    wrong_host := "https://127.0.0.1:" + tls_origin[18..tls_origin.len]
    mismatched := client.request_with_ca("GET", wrong_host + "/ok", &empty_names, &empty_names, &empty_body, 3000, 1024, ca_file)
    assert(!mismatched.ok && mismatched.status == 0)
    mut state := Monitor { origin: origin.clone(), started: sys.now_ms(), renewed: false, polls: 0 }
    cancelled := client.request_monitored("GET", origin + "/stall", &empty_names, &empty_names,
        &empty_body, 10000, 1024, fn[&mut state]() -> bool { monitor_tick(&mut state) })
    assert(!cancelled.ok && cancelled.transport_code == 42 && cancelled.error == "HTTP request cancelled")
    assert(state.renewed && state.polls > 1 && sys.now_ms() - state.started < 2500)
    mut tls_state := Monitor { origin: origin.clone(), started: sys.now_ms(), renewed: false, polls: 0 }
    tls_cancelled := client.request_monitored("GET", sys.arg(4), &empty_names, &empty_names,
        &empty_body, 10000, 1024, fn[&mut tls_state]() -> bool { monitor_tick(&mut tls_state) })
    assert(!tls_cancelled.ok && tls_cancelled.transport_code == 42 && tls_cancelled.error == "HTTP request cancelled")
    assert(tls_state.renewed && tls_state.polls > 1 && sys.now_ms() - tls_state.started < 2500)
    print("http client ok")
}
