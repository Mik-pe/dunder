capability unsafe, network
import .monitored as monitored
import std.ffi as ffi
import std.text as text
import sys

type Curl = monitored.Curl
extern type CurlSlist

@link(macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
extern "C" {
    @link_name("curl_global_init")
    @thread_safe
    fn c_global_init(flags: ffi.c_long) -> ffi.c_int

    @link_name("curl_easy_init")
    @thread_safe
    fn c_easy_init() -> *mut Curl

    @link_name("curl_easy_cleanup")
    @thread_safe
    fn c_easy_cleanup(easy: *mut Curl)

    @link_name("curl_easy_perform")
    @thread_safe
    fn c_easy_perform(easy: *mut Curl) -> ffi.c_int

    @link_name("curl_easy_setopt")
    @thread_safe
    fn c_easy_setopt(easy: *mut Curl, option: ffi.c_int, ...) -> ffi.c_int

    @link_name("curl_easy_getinfo")
    @thread_safe
    fn c_easy_getinfo(easy: *mut Curl, info: ffi.c_int, ...) -> ffi.c_int

    @link_name("curl_slist_append")
    @thread_safe
    fn c_slist_append(list: *mut CurlSlist, value: *const ffi.c_char) -> *mut CurlSlist

    @link_name("curl_slist_free_all")
    @thread_safe
    fn c_slist_free(list: *mut CurlSlist)

    @link_name("curl_easy_strerror")
    @thread_safe
    fn c_strerror(code: ffi.c_int) -> *const ffi.c_char
}

pub struct Response {
    ok: bool,
    status: i32,
    transport_code: i32,
    body: []u8,
    error: string,
}

// Explicit C-layout callback context passed to libcurl's write/header callbacks.
// Contains only FFI-safe scalar/pointer fields; body bytes are accumulated in
// raw pool storage and materialized into a Dunder []u8 after curl_easy_perform
// returns.
@repr(C)
struct CallbackContext {
    data: *mut u8,
    len: usize,
    cap: usize,
    max_bytes: i64,
    limited: i32,
    declared_limited: i32,
    alloc_failed: i32,
    head: i32,
}

@thread_safe
unsafe fn init_callback_context(max_bytes: i64, head: bool) -> CallbackContext {
    CallbackContext {
        data: ffi.null_mut<u8>(),
        len: usize(0),
        cap: usize(0),
        max_bytes: max_bytes,
        limited: 0,
        declared_limited: 0,
        alloc_failed: 0,
        head: if head { 1 } else { 0 },
    }
}

@thread_safe
unsafe fn free_callback_context(ctx: &mut CallbackContext) {
    if !ctx.data.is_null() {
        sys.pool_free(ptr(ctx.data))
        ctx.data = ffi.null_mut<u8>()
    }
    ctx.len = usize(0)
    ctx.cap = usize(0)
}

@thread_safe
unsafe fn copy_context_body(ctx: &CallbackContext) -> []u8 {
    mut out: []u8 = []
    if ctx.len == usize(0) || ctx.data.is_null() { return out }
    count := i32(ctx.len)
    out.reserve(count)
    for i in 0..count {
        out.push(ctx.data.add(usize(i)).read())
    }
    out
}

@thread_safe
fn failure(move message: string) -> Response {
    Response { ok: false, status: 0, transport_code: 0, body: [], error: message }
}

@thread_safe
fn token(value: string) -> bool {
    if value.len == 0 { return false }
    for byte in value.bytes() {
        if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) { continue }
        if byte == 33 || byte == 35 || byte == 36 || byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43 || byte == 45 || byte == 46 || byte == 94 || byte == 95 || byte == 96 || byte == 124 || byte == 126 { continue }
        return false
    }
    true
}

@thread_safe
fn valid_url(url: string) -> bool {
    mut authority := 0
    if text.starts_with(url, "http://") { authority = 7 }
    else if text.starts_with(url, "https://") { authority = 8 }
    else { return false }
    if url.len <= authority || url.len > 16384 { return false }
    mut host_end := url.len
    for i in authority..url.len {
        if url[i] == 47 || url[i] == 63 { host_end = i; break }
    }
    if host_end == authority { return false }
    for i in 0..url.len {
        byte := url[i]
        if byte <= 32 || byte == 127 || byte == 92 || byte == 35 { return false }
        if i < host_end && byte == 64 { return false }
    }
    true
}

@thread_safe
unsafe fn receive_into(ctx: &mut CallbackContext, data: *const u8, count: usize) -> usize {
    if count == usize(0) { return usize(0) }
    if data.is_null() { return usize(0) }
    if count > usize(2147483647) || i64(count) > ctx.max_bytes - i64(ctx.len) {
        ctx.limited = 1
        return usize(0)
    }
    needed := ctx.len + count
    if needed > ctx.cap {
        mut next_cap := if ctx.cap == usize(0) { usize(4096) } else { ctx.cap * usize(2) }
        while next_cap < needed {
            if next_cap > usize(1073741824) {
                next_cap = needed
                break
            }
            next_cap = next_cap * usize(2)
        }
        max_u := usize(ctx.max_bytes)
        if next_cap > max_u && max_u >= needed { next_cap = max_u }
        next_buf := ffi.from_ptr_mut<u8>(sys.pool_alloc_try(next_cap))
        if next_buf.is_null() {
            ctx.alloc_failed = 1
            return usize(0)
        }
        if ctx.len > usize(0) && !ctx.data.is_null() {
            sys.memory_copy(ptr(next_buf), ptr(ctx.data), ctx.len)
        }
        if !ctx.data.is_null() {
            sys.pool_free(ptr(ctx.data))
        }
        ctx.data = next_buf
        ctx.cap = next_cap
    }
    sys.memory_copy(ptr(ctx.data.add(ctx.len)), ptr(data), count)
    ctx.len = needed
    count
}

@thread_safe
extern "C" fn receive(data: *const ffi.c_char, size: usize, count: usize, context: *mut ffi.c_void) -> usize {
    if context.is_null() { return usize(0) }
    if size > usize(2147483647) || (size != usize(0) && count > usize(2147483647) / size) { return usize(0) }
    unsafe {
        ctx_ptr := context.cast<CallbackContext>()
        mut ctx := ctx_ptr.read()
        written := receive_into(&mut ctx, data.cast<u8>(), size * count)
        ctx_ptr.write(ctx)
        written
    }
}

@thread_safe
unsafe fn raw_matches_content_length(data: *const u8, count: usize) -> bool {
    if count < usize(15) { return false }
    expected := "content-length:"
    for i in 0..15 {
        mut b := data.add(usize(i)).read()
        if b >= u8(65) && b <= u8(90) { b = b + u8(32) }
        if b != u8(expected[i]) { return false }
    }
    true
}

@thread_safe
unsafe fn receive_header_into(ctx: &mut CallbackContext, data: *const u8, count: usize) -> usize {
    if ctx.head != 0 || count == usize(0) || count > usize(16384) { return count }
    if data.is_null() { return usize(0) }
    if !raw_matches_content_length(data, count) { return count }
    mut start := usize(15)
    while start < count {
        b := data.add(start).read()
        if b != u8(32) && b != u8(9) { break }
        start += usize(1)
    }
    mut size: i64 = 0
    while start < count {
        b := data.add(start).read()
        if b < u8(48) || b > u8(57) { break }
        digit := i64(b - u8(48))
        if size > (ctx.max_bytes - digit) / 10 || size * 10 + digit > ctx.max_bytes {
            ctx.declared_limited = 1
            return usize(0)
        }
        size = size * 10 + digit
        start += usize(1)
    }
    count
}

@thread_safe
extern "C" fn receive_header(data: *const ffi.c_char, size: usize, count: usize, context: *mut ffi.c_void) -> usize {
    if context.is_null() { return usize(0) }
    if size > usize(2147483647) || (size != usize(0) && count > usize(2147483647) / size) { return usize(0) }
    unsafe {
        ctx_ptr := context.cast<CallbackContext>()
        mut ctx := ctx_ptr.read()
        written := receive_header_into(&mut ctx, data.cast<u8>(), size * count)
        ctx_ptr.write(ctx)
        written
    }
}

@thread_safe
fn always_continue() -> bool { true }

// Process-wide atomic once-guard for libcurl global initialization.
// States: 0 = uninitialized, 1 = initializing, 2 = initialized.
// Never calls curl_global_cleanup() mid-flight so concurrent or nested
// requests cannot tear down shared libcurl state.
@thread_safe
unsafe fn curl_init_slot() -> *mut i64 {
    if target_is("macos") || target_is("linux") {
        return ffi.from_ptr_mut<i64>(static_bytes("native", 8))
    }
    ffi.null_mut<i64>()
}

@thread_safe
unsafe fn ensure_global_init() -> i32 {
    if target_is("macos") || target_is("linux") {
        slot := curl_init_slot()
        if sys.atomic_load_i64(ptr(slot)) == 2 { return 0 }
        mut spins := 0
        while true {
            state := sys.atomic_load_i64(ptr(slot))
            if state == 2 { return 0 }
            if state == 0 {
                if sys.atomic_cas_i64(ptr(slot), 0, 1) == 0 {
                    code := c_global_init(3)
                    if code == 0 {
                        sys.atomic_store_i64(ptr(slot), 2)
                    } else {
                        sys.atomic_store_i64(ptr(slot), 0)
                    }
                    return i32(code)
                }
            }
            spins += 1
            if spins >= 64 {
                sys.sleep_ms(1)
                spins = 0
            }
        }
    }
    4
}

@thread_safe
unsafe fn easy_init() -> *mut Curl {
    if target_is("macos") || target_is("linux") { return c_easy_init() }
    ffi.null_mut<Curl>()
}

@thread_safe
unsafe fn easy_cleanup(easy: *mut Curl) {
    if target_is("macos") || target_is("linux") { c_easy_cleanup(easy) }
}

@thread_safe
unsafe fn set_long(easy: *mut Curl, option: ffi.c_int, value: i64) -> bool {
    if target_is("macos") || target_is("linux") { return c_easy_setopt(easy, option, value) == 0 }
    false
}

@thread_safe
unsafe fn set_ptr(easy: *mut Curl, option: ffi.c_int, value: *const ffi.c_void) -> bool {
    if target_is("macos") || target_is("linux") { return c_easy_setopt(easy, option, value) == 0 }
    false
}

@thread_safe
unsafe fn set_writer(easy: *mut Curl) -> bool {
    if target_is("macos") || target_is("linux") { return c_easy_setopt(easy, 20011, receive) == 0 }
    false
}

@thread_safe
unsafe fn set_header_reader(easy: *mut Curl) -> bool {
    if target_is("macos") || target_is("linux") { return c_easy_setopt(easy, 20079, receive_header) == 0 }
    false
}

@thread_safe
unsafe fn slist_append(list: *mut CurlSlist, value: *const ffi.c_char) -> *mut CurlSlist {
    if target_is("macos") || target_is("linux") { return c_slist_append(list, value) }
    ffi.null_mut<CurlSlist>()
}

@thread_safe
unsafe fn slist_free(list: *mut CurlSlist) {
    if target_is("macos") || target_is("linux") { c_slist_free(list) }
}

@thread_safe
unsafe fn perform(easy: *mut Curl) -> i32 {
    if target_is("macos") || target_is("linux") { return i32(c_easy_perform(easy)) }
    4
}

@thread_safe
unsafe fn response_code(easy: *mut Curl) -> i32 {
    mut value: ffi.c_long = 0
    mut code: ffi.c_int = 4
    if target_is("macos") || target_is("linux") { code = c_easy_getinfo(easy, 0x200002, addr_of(&mut value)) }
    if code != 0 || i64(value) < 0 || i64(value) > 999 { return 0 }
    i32(value)
}

@thread_safe
unsafe fn decode_cstr_lossy(raw: *const ffi.c_char) -> Option<string> {
    ffi.from_cstr_lossy(ptr(raw))
}

@thread_safe
unsafe fn transport_error(code: i32) -> string {
    if target_is("macos") || target_is("linux") {
        return match decode_cstr_lossy(c_strerror(code)) {
            .Some(msg) => msg,
            .None => "HTTP transport failure",
        }
    }
    "HTTP transport is unavailable on this target"
}

@requires(network)
@thread_safe
pub fn request(method: string, url: string, header_names: &[]string, header_values: &[]string,
    body: &[]u8, timeout_ms: i64, max_bytes: i64) -> Response {
    request_with_ca(method, url, &header_names, &header_values, &body, timeout_ms, max_bytes, "")
}

@requires(network)
@thread_safe
pub fn request_with_ca(method: string, url: string, header_names: &[]string, header_values: &[]string,
    body: &[]u8, timeout_ms: i64, max_bytes: i64, ca_bundle: string) -> Response {
    unsafe {
        request_internal(method, url, &header_names, &header_values, &body,
            timeout_ms, max_bytes, ca_bundle, false, always_continue)
    }
}

@requires(network)
pub fn request_monitored(method: string, url: string, header_names: &[]string,
    header_values: &[]string, body: &[]u8, timeout_ms: i64,
    max_bytes: i64, monitor: &mut FnMut() -> bool) -> Response {
    unsafe {
        request_internal(method, url, &header_names, &header_values, &body,
            timeout_ms, max_bytes, "", true, monitor)
    }
}

@requires(network)
pub fn request_monitored_with_ca(method: string, url: string, header_names: &[]string,
    header_values: &[]string, body: &[]u8, timeout_ms: i64,
    max_bytes: i64, ca_bundle: string,
    monitor: &mut FnMut() -> bool) -> Response {
    unsafe {
        request_internal(method, url, &header_names, &header_values, &body,
            timeout_ms, max_bytes, ca_bundle, true, monitor)
    }
}

@thread_safe
unsafe fn request_internal(method: string, url: string, header_names: &[]string,
    header_values: &[]string, body: &[]u8, timeout_ms: i64,
    max_bytes: i64, ca_bundle: string, observe: bool,
    monitor: &mut FnMut() -> bool) -> Response {
    if !token(method) || method.len > 32 { return failure("invalid HTTP method") }
    if !valid_url(url) { return failure("expected an HTTP(S) URL without credentials or control bytes") }
    if header_names.len != header_values.len || header_names.len > 128 { return failure("invalid HTTP headers") }
    if timeout_ms < 1 || timeout_ms > 86400000 || max_bytes < 0 || max_bytes > 2147483647 {
        return failure("invalid HTTP deadline or response limit")
    }
    if method == "HEAD" && body.len != 0 { return failure("HEAD cannot include a request body") }
    ca_cstr := match ffi.CString::new(ca_bundle.clone()) {
        .Ok(c) => c,
        .Err(_) => { return failure("invalid CA bundle path") },
    }
    url_cstr := match ffi.CString::new(url) {
        .Ok(c) => c,
        .Err(_) => { return failure("expected an HTTP(S) URL without credentials or control bytes") },
    }
    method_cstr := match ffi.CString::new(method.clone()) {
        .Ok(c) => c,
        .Err(_) => { return failure("invalid HTTP method") },
    }
    mut header_bytes := 0
    for i in 0..header_names.len {
        name := &header_names[i]
        value := &header_values[i]
        if !token(name) || name.len > 256 || value.len > 8192 { return failure("invalid HTTP header") }
        for byte in value.bytes() {
            if (byte < 32 && byte != 9) || byte == 127 { return failure("invalid HTTP header value") }
        }
        header_bytes += name.len + value.len + 4
        if header_bytes > 65536 { return failure("HTTP headers exceed their limit") }
    }
    unsafe {
        initialized := ensure_global_init()
        if initialized != 0 { return failure(transport_error(initialized)) }
        easy := easy_init()
        if easy.is_null() { return failure("cannot allocate HTTP client") }
        defer { easy_cleanup(easy) }
        mut headers := ffi.null_mut<CurlSlist>()
        defer { slist_free(headers) }
        for i in 0..header_names.len {
            header := match ffi.CString::new(f"{header_names[i]}: {header_values[i]}") {
                .Ok(c) => c,
                .Err(_) => { return failure("invalid HTTP header") },
            }
            header_ptr := header.as_bytes_with_nul().as_ptr().cast<ffi.c_char>()
            next := slist_append(headers, header_ptr)
            if next.is_null() { return failure("cannot allocate HTTP headers") }
            headers = next
        }
        mut ctx := init_callback_context(max_bytes, method == "HEAD")
        defer { free_callback_context(&mut ctx) }
        mut configured := set_ptr(easy, 10002, url_cstr.as_bytes_with_nul().as_ptr().cast<ffi.c_void>())
        configured = set_ptr(easy, 10036, method_cstr.as_bytes_with_nul().as_ptr().cast<ffi.c_void>()) && configured
        configured = set_ptr(easy, 10023, headers.cast_const().cast<ffi.c_void>()) && configured
        configured = set_ptr(easy, 10001, addr_of(&mut ctx).cast_const().cast<ffi.c_void>()) && configured
        configured = set_writer(easy) && configured
        configured = set_header_reader(easy) && configured
        configured = set_ptr(easy, 10029, addr_of(&mut ctx).cast_const().cast<ffi.c_void>()) && configured
        configured = set_long(easy, 99, 1) && configured
        configured = set_long(easy, 156, 5000) && configured
        configured = set_long(easy, 155, timeout_ms) && configured
        configured = set_long(easy, 52, 0) && configured
        configured = set_long(easy, 64, 1) && configured
        configured = set_long(easy, 81, 2) && configured
        configured = set_long(easy, 181, 3) && configured
        if ca_bundle.len > 0 { configured = set_ptr(easy, 10065, ca_cstr.as_bytes_with_nul().as_ptr().cast<ffi.c_void>()) && configured }
        if method == "HEAD" { configured = set_long(easy, 44, 1) && configured }
        else if body.len > 0 || method == "POST" || method == "PUT" || method == "PATCH" {
            mut data := c"".as_ptr().cast<ffi.c_void>()
            if body.len > 0 { data = body.as_ptr().cast<ffi.c_void>() }
            configured = set_ptr(easy, 10015, data) && configured
            configured = set_long(easy, 30120, i64(body.len)) && configured
        }
        if !configured { return failure("cannot configure HTTP client") }
        code := if observe { monitored.perform(easy, monitor) } else { perform(easy) }
        status := response_code(easy)
        out_body := copy_context_body(&ctx)
        if observe && code == monitored.CANCELLED {
            return Response { ok: false, status: status, transport_code: code, body: out_body, error: "HTTP request cancelled" }
        }
        if ctx.declared_limited != 0 {
            return Response { ok: false, status: status, transport_code: code, body: out_body, error: "declared HTTP response exceeds size limit" }
        }
        if ctx.limited != 0 {
            return Response { ok: false, status: status, transport_code: code, body: out_body, error: "HTTP response exceeds its byte limit" }
        }
        if ctx.alloc_failed != 0 {
            return Response { ok: false, status: status, transport_code: code, body: out_body, error: "cannot allocate HTTP response buffer" }
        }
        if code != 0 {
            return Response { ok: false, status: status, transport_code: code, body: out_body, error: transport_error(code) }
        }
        Response { ok: true, status: status, transport_code: 0, body: out_body, error: "" }
    }
}
