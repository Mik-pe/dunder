capability unsafe

import std.ffi as ffi

pub const CANCELLED: i32 = 42
const FAILED_INIT: i32 = 2

pub extern type Curl
extern type CurlMulti

@repr(C)
struct Message { kind: ffi.c_int, easy: *mut Curl, result: ffi.c_int }

@link(macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
extern "C" {
    @link_name("curl_multi_init")
    @thread_safe
    fn c_multi_init() -> *mut CurlMulti

    @link_name("curl_multi_add_handle")
    @thread_safe
    fn c_multi_add_handle(multi: *mut CurlMulti, easy: *mut Curl) -> ffi.c_int

    @link_name("curl_multi_perform")
    @thread_safe
    fn c_multi_perform(multi: *mut CurlMulti, running: *mut ffi.c_int) -> ffi.c_int

    @link_name("curl_multi_poll")
    @thread_safe
    fn c_multi_poll(
        multi: *mut CurlMulti,
        extra: *mut ffi.c_void,
        count: ffi.c_uint,
        timeout_ms: ffi.c_int,
        ready: *mut ffi.c_int,
    ) -> ffi.c_int

    @link_name("curl_multi_info_read")
    @thread_safe
    fn c_multi_info_read(multi: *mut CurlMulti, queued: *mut ffi.c_int) -> *const Message

    @link_name("curl_multi_remove_handle")
    @thread_safe
    fn c_multi_remove_handle(multi: *mut CurlMulti, easy: *mut Curl) -> ffi.c_int

    @link_name("curl_multi_cleanup")
    @thread_safe
    fn c_multi_cleanup(multi: *mut CurlMulti) -> ffi.c_int
}

@thread_safe
fn completion(msg: &Message, easy: *mut Curl) -> i32 {
    if msg.kind == 1 && msg.easy == easy { return i32(msg.result) }
    FAILED_INIT
}

@thread_safe
pub unsafe fn perform(easy: *mut Curl, monitor: &mut FnMut() -> bool) -> i32 {
    if target_is("macos") || target_is("linux") {
        multi := c_multi_init()
        if multi.is_null() { return FAILED_INIT }
        defer { _ := c_multi_cleanup(multi) }
        if c_multi_add_handle(multi, easy) != 0 { return FAILED_INIT }
        defer { _ := c_multi_remove_handle(multi, easy) }
        mut running: ffi.c_int = 0
        while monitor() {
            if c_multi_perform(multi, addr_of(&mut running)) != 0 { return FAILED_INIT }
            if running == 0 {
                mut queued: ffi.c_int = 0
                message := c_multi_info_read(multi, addr_of(&mut queued))
                if message.is_null() { return FAILED_INIT }
                msg := message.read()
                return completion(&msg, easy)
            }
            if c_multi_poll(multi, ffi.null_mut<ffi.c_void>(), 0, 100, ffi.null_mut<ffi.c_int>()) != 0 {
                return FAILED_INIT
            }
        }
        return CANCELLED
    }
    FAILED_INIT
}
