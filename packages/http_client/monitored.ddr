capability unsafe

pub const CANCELLED: i32 = 42
const FAILED_INIT: i32 = 2

@extern("/usr/lib/libcurl.dylib", "curl_multi_init")
unsafe fn mac_init() -> ptr
@extern("/usr/lib/libcurl.dylib", "curl_multi_add_handle")
unsafe fn mac_add_handle(multi: ptr, easy: ptr) -> i32
@extern("/usr/lib/libcurl.dylib", "curl_multi_perform")
unsafe fn mac_perform(multi: ptr, running: ptr) -> i32
@extern("/usr/lib/libcurl.dylib", "curl_multi_poll")
unsafe fn mac_poll(multi: ptr, extra: ptr, count: u32, timeout_ms: i32, ready: ptr) -> i32
@extern("/usr/lib/libcurl.dylib", "curl_multi_info_read")
unsafe fn mac_info_read(multi: ptr, queued: ptr) -> ptr
@extern("/usr/lib/libcurl.dylib", "curl_multi_remove_handle")
unsafe fn mac_remove_handle(multi: ptr, easy: ptr) -> i32
@extern("/usr/lib/libcurl.dylib", "curl_multi_cleanup")
unsafe fn mac_cleanup(multi: ptr) -> i32

@extern("libcurl.so.4", "curl_multi_init")
unsafe fn linux_init() -> ptr
@extern("libcurl.so.4", "curl_multi_add_handle")
unsafe fn linux_add_handle(multi: ptr, easy: ptr) -> i32
@extern("libcurl.so.4", "curl_multi_perform")
unsafe fn linux_perform(multi: ptr, running: ptr) -> i32
@extern("libcurl.so.4", "curl_multi_poll")
unsafe fn linux_poll(multi: ptr, extra: ptr, count: u32, timeout_ms: i32, ready: ptr) -> i32
@extern("libcurl.so.4", "curl_multi_info_read")
unsafe fn linux_info_read(multi: ptr, queued: ptr) -> ptr
@extern("libcurl.so.4", "curl_multi_remove_handle")
unsafe fn linux_remove_handle(multi: ptr, easy: ptr) -> i32
@extern("libcurl.so.4", "curl_multi_cleanup")
unsafe fn linux_cleanup(multi: ptr) -> i32

struct Api {
    init: extern fn() -> ptr,
    add_handle: extern fn(ptr, ptr) -> i32,
    perform: extern fn(ptr, ptr) -> i32,
    poll: extern fn(ptr, ptr, u32, i32, ptr) -> i32,
    info_read: extern fn(ptr, ptr) -> ptr,
    remove_handle: extern fn(ptr, ptr) -> i32,
    cleanup: extern fn(ptr) -> i32,
}

unsafe fn api() -> Api {
    if target_is("macos") {
        return Api {
            init: mac_init,
            add_handle: mac_add_handle,
            perform: mac_perform,
            poll: mac_poll,
            info_read: mac_info_read,
            remove_handle: mac_remove_handle,
            cleanup: mac_cleanup
        }
    }
    Api {
        init: linux_init,
        add_handle: linux_add_handle,
        perform: linux_perform,
        poll: linux_poll,
        info_read: linux_info_read,
        remove_handle: linux_remove_handle,
        cleanup: linux_cleanup
    }
}

@c_layout
struct Message { kind: i32, easy: ptr, result: i32 }

fn completion(msg: &Message, easy: ptr) -> i32 {
    if msg.kind == 1 && msg.easy == easy { return msg.result }
    FAILED_INIT
}

pub unsafe fn perform(easy: ptr, monitor: &mut FnMut() -> bool) -> i32 {
    curl := api()
    multi := curl.init()
    if multi == ptr(0) { return FAILED_INIT }
    defer { _ := curl.cleanup(multi) }
    if curl.add_handle(multi, easy) != 0 { return FAILED_INIT }
    defer { _ := curl.remove_handle(multi, easy) }
    mut running := 0
    while monitor() {
        if curl.perform(multi, addr(&mut running)) != 0 { return FAILED_INIT }
        if running == 0 {
            mut queued := 0
            message := curl.info_read(multi, addr(&mut queued))
            if message == ptr(0) { return FAILED_INIT }
            return completion(ref_at(message), easy)
        }
        if curl.poll(multi, ptr(0), 0, 100, ptr(0)) != 0 { return FAILED_INIT }
    }
    CANCELLED
}
