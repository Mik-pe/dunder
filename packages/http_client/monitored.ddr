capability unsafe

pub const CANCELLED: i32 = 42
const FAILED_INIT: i32 = 2

@extern(symbol = "curl_multi_init", macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
@thread_safe
unsafe fn c_multi_init() -> ptr
@extern(symbol = "curl_multi_add_handle", macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
@thread_safe
unsafe fn c_multi_add_handle(multi: ptr, easy: ptr) -> i32
@extern(symbol = "curl_multi_perform", macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
@thread_safe
unsafe fn c_multi_perform(multi: ptr, running: ptr) -> i32
@extern(symbol = "curl_multi_poll", macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
@thread_safe
unsafe fn c_multi_poll(multi: ptr, extra: ptr, count: u32, timeout_ms: i32, ready: ptr) -> i32
@extern(symbol = "curl_multi_info_read", macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
@thread_safe
unsafe fn c_multi_info_read(multi: ptr, queued: ptr) -> ptr
@extern(symbol = "curl_multi_remove_handle", macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
@thread_safe
unsafe fn c_multi_remove_handle(multi: ptr, easy: ptr) -> i32
@extern(symbol = "curl_multi_cleanup", macos = "/usr/lib/libcurl.dylib", linux = "libcurl.so.4")
@thread_safe
unsafe fn c_multi_cleanup(multi: ptr) -> i32

@c_layout
struct Message { kind: i32, easy: ptr, result: i32 }

@thread_safe
fn completion(msg: &Message, easy: ptr) -> i32 {
    if msg.kind == 1 && msg.easy == easy { return msg.result }
    FAILED_INIT
}

@thread_safe
pub unsafe fn perform(easy: ptr, monitor: &mut FnMut() -> bool) -> i32 {
    if target_is("macos") || target_is("linux") {
        multi := c_multi_init()
        if multi == ptr(0) { return FAILED_INIT }
        defer { _ := c_multi_cleanup(multi) }
        if c_multi_add_handle(multi, easy) != 0 { return FAILED_INIT }
        defer { _ := c_multi_remove_handle(multi, easy) }
        mut running := 0
        while monitor() {
            if c_multi_perform(multi, addr(&mut running)) != 0 { return FAILED_INIT }
            if running == 0 {
                mut queued := 0
                message := c_multi_info_read(multi, addr(&mut queued))
                if message == ptr(0) { return FAILED_INIT }
                return completion(ref_at(message), easy)
            }
            if c_multi_poll(multi, ptr(0), 0, 100, ptr(0)) != 0 { return FAILED_INIT }
        }
        return CANCELLED
    }
    FAILED_INIT
}
