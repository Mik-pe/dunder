import std.parse as std_parse
import std.text as text
import std.text.view as tv
import sys

pub enum FlagKind {
    Bool,
    Value,
    Count,
}

impl Eq for FlagKind {
    fn eq(&self, other: &Self) -> bool {
        match self {
            .Bool => match other { .Bool => true, _ => false },
            .Value => match other { .Value => true, _ => false },
            .Count => match other { .Count => true, _ => false },
        }
    }
}

pub struct FlagSpec {
    name: string,
    long_name: string,
    short_name: string,
    kind: FlagKind,
    value_name: string,
    default_val: string,
    has_default: bool,
    required: bool,
    help: string,
}

pub struct ArgSpec {
    name: string,
    required: bool,
    multiple: bool,
    help: string,
}

pub struct Command {
    name: string,
    about: string,
    flags: []FlagSpec,
    args: []ArgSpec,
    subcommands: []Command,
}

pub struct App {
    name: string,
    version: string,
    about: string,
    flags: []FlagSpec,
    args: []ArgSpec,
    subcommands: []Command,
}

pub enum ParseError {
    UnknownFlag(string),
    MissingValue(string),
    UnexpectedValue(string),
    MissingRequired(string),
    UnknownSubcommand(string),
    InvalidInt(string),
    HelpRequested(string),
    VersionRequested(string),
}

impl Eq for ParseError {
    fn eq(&self, other: &Self) -> bool {
        match self {
            .UnknownFlag(a) => match other { .UnknownFlag(b) => a == b, _ => false },
            .MissingValue(a) => match other { .MissingValue(b) => a == b, _ => false },
            .UnexpectedValue(a) => match other { .UnexpectedValue(b) => a == b, _ => false },
            .MissingRequired(a) => match other { .MissingRequired(b) => a == b, _ => false },
            .UnknownSubcommand(a) => match other { .UnknownSubcommand(b) => a == b, _ => false },
            .InvalidInt(a) => match other { .InvalidInt(b) => a == b, _ => false },
            .HelpRequested(a) => match other { .HelpRequested(b) => a == b, _ => false },
            .VersionRequested(a) => match other { .VersionRequested(b) => a == b, _ => false },
        }
    }
}

impl Display for ParseError {
    fn str(&self) -> string { format_error(self) }
}

pub fn format_error(err: &ParseError) -> string {
    match err {
        .UnknownFlag(f) => f"unknown flag '{f}'",
        .MissingValue(f) => f"flag '{f}' requires a value",
        .UnexpectedValue(f) => f"flag '{f}' does not accept a value",
        .MissingRequired(name) => f"missing required argument '{name}'",
        .UnknownSubcommand(cmd) => f"unknown subcommand '{cmd}'",
        .InvalidInt(msg) => f"invalid integer value: {msg}",
        .HelpRequested(txt) => txt.clone(),
        .VersionRequested(txt) => txt.clone(),
    }
}

pub struct Matches {
    command: string,
    count_keys: []string,
    count_vals: []i32,
    val_keys: []string,
    val_vals: []string,
    pos_args: []string,
    sub: []Matches,
}

impl Eq for Matches {
    fn eq(&self, other: &Self) -> bool {
        if self.command != other.command ||
           self.count_keys != other.count_keys ||
           self.count_vals != other.count_vals ||
           self.val_keys != other.val_keys ||
           self.val_vals != other.val_vals ||
           self.pos_args != other.pos_args ||
           self.sub.len != other.sub.len {
            return false
        }
        for i in 0..self.sub.len {
            if self.sub[i] != other.sub[i] { return false }
        }
        true
    }
}

fn empty_matches(move command: string) -> Matches {
    Matches {
        command: move command,
        count_keys: [],
        count_vals: [],
        val_keys: [],
        val_vals: [],
        pos_args: [],
        sub: [],
    }
}

fn make_flag_spec(long_name: &str, short_name: &str, kind: FlagKind, value_name: &str, default_val: &str, has_default: bool, required: bool, help: &str) -> FlagSpec {
    canon := if long_name.len > 0 { long_name.clone() } else { short_name.clone() }
    FlagSpec {
        name: canon,
        long_name: long_name.clone(),
        short_name: short_name.clone(),
        kind: kind,
        value_name: value_name.clone(),
        default_val: default_val.clone(),
        has_default: has_default,
        required: required,
        help: help.clone(),
    }
}

impl Command {
    pub fn new(name: &str, about: &str) -> Self {
        Self { name: name.clone(), about: about.clone(), flags: [], args: [], subcommands: [] }
    }

    pub fn add_flag(&mut self, long_name: &str, short_name: &str, help: &str) {
        self.flags.push(make_flag_spec(long_name, short_name, .Bool, "", "", false, false, help))
    }

    pub fn add_count_flag(&mut self, long_name: &str, short_name: &str, help: &str) {
        self.flags.push(make_flag_spec(long_name, short_name, .Count, "", "", false, false, help))
    }

    pub fn add_option(&mut self, long_name: &str, short_name: &str, value_name: &str, default_val: &str, required: bool, help: &str) {
        has_def := default_val.len > 0
        self.flags.push(make_flag_spec(long_name, short_name, .Value, value_name, default_val, has_def, required, help))
    }

    pub fn add_option_empty_default(&mut self, long_name: &str, short_name: &str, value_name: &str, default_val: &str, help: &str) {
        self.flags.push(make_flag_spec(long_name, short_name, .Value, value_name, default_val, true, false, help))
    }

    pub fn add_arg(&mut self, name: &str, required: bool, multiple: bool, help: &str) {
        self.args.push(ArgSpec { name: name.clone(), required: required, multiple: multiple, help: help.clone() })
    }

    pub fn add_subcommand(&mut self, move cmd: Command) {
        self.subcommands.push(move cmd)
    }

    pub fn flag(move self, long_name: &str, short_name: &str, help: &str) -> Self {
        mut out := self
        out.add_flag(long_name, short_name, help)
        out
    }

    pub fn count_flag(move self, long_name: &str, short_name: &str, help: &str) -> Self {
        mut out := self
        out.add_count_flag(long_name, short_name, help)
        out
    }

    pub fn option(move self, long_name: &str, short_name: &str, value_name: &str, default_val: &str, required: bool, help: &str) -> Self {
        mut out := self
        out.add_option(long_name, short_name, value_name, default_val, required, help)
        out
    }

    pub fn arg(move self, name: &str, required: bool, multiple: bool, help: &str) -> Self {
        mut out := self
        out.add_arg(name, required, multiple, help)
        out
    }

    pub fn subcommand(move self, move cmd: Command) -> Self {
        mut out := self
        out.add_subcommand(move cmd)
        out
    }
}

impl App {
    pub fn new(name: &str, version: &str, about: &str) -> Self {
        Self { name: name.clone(), version: version.clone(), about: about.clone(), flags: [], args: [], subcommands: [] }
    }

    pub fn add_flag(&mut self, long_name: &str, short_name: &str, help: &str) {
        self.flags.push(make_flag_spec(long_name, short_name, .Bool, "", "", false, false, help))
    }

    pub fn add_count_flag(&mut self, long_name: &str, short_name: &str, help: &str) {
        self.flags.push(make_flag_spec(long_name, short_name, .Count, "", "", false, false, help))
    }

    pub fn add_option(&mut self, long_name: &str, short_name: &str, value_name: &str, default_val: &str, required: bool, help: &str) {
        has_def := default_val.len > 0
        self.flags.push(make_flag_spec(long_name, short_name, .Value, value_name, default_val, has_def, required, help))
    }

    pub fn add_arg(&mut self, name: &str, required: bool, multiple: bool, help: &str) {
        self.args.push(ArgSpec { name: name.clone(), required: required, multiple: multiple, help: help.clone() })
    }

    pub fn add_subcommand(&mut self, move cmd: Command) {
        self.subcommands.push(move cmd)
    }

    pub fn flag(move self, long_name: &str, short_name: &str, help: &str) -> Self {
        mut out := self
        out.add_flag(long_name, short_name, help)
        out
    }

    pub fn count_flag(move self, long_name: &str, short_name: &str, help: &str) -> Self {
        mut out := self
        out.add_count_flag(long_name, short_name, help)
        out
    }

    pub fn option(move self, long_name: &str, short_name: &str, value_name: &str, default_val: &str, required: bool, help: &str) -> Self {
        mut out := self
        out.add_option(long_name, short_name, value_name, default_val, required, help)
        out
    }

    pub fn arg(move self, name: &str, required: bool, multiple: bool, help: &str) -> Self {
        mut out := self
        out.add_arg(name, required, multiple, help)
        out
    }

    pub fn subcommand(move self, move cmd: Command) -> Self {
        mut out := self
        out.add_subcommand(move cmd)
        out
    }
}

impl Matches {
    pub fn has_flag(&self, name: &str) -> bool {
        self.flag_count(name) > 0
    }

    pub fn flag_count(&self, name: &str) -> i32 {
        for i in 0..self.count_keys.len {
            if self.count_keys[i] == name { return self.count_vals[i] }
        }
        0
    }

    pub fn get(&self, name: &str) -> Option<string> {
        for i in 0..self.val_keys.len {
            if self.val_keys[i] == name { return .Some(self.val_vals[i].clone()) }
        }
        .None
    }

    pub fn get_or(&self, name: &str, fallback: &str) -> string {
        for i in 0..self.val_keys.len {
            if self.val_keys[i] == name { return self.val_vals[i].clone() }
        }
        fallback.clone()
    }

    pub fn get_i64(&self, name: &str) -> Result<Option<i64>, ParseError> {
        match self.get(name) {
            .None => .Ok(.None),
            .Some(raw) => {
                parsed := std_parse.integer(raw)
                if !parsed.ok {
                    return .Err(.InvalidInt(f"--{name}='{raw}'"))
                }
                .Ok(.Some(parsed.value))
            },
        }
    }

    pub fn positionals(&self) -> &[]string {
        &self.pos_args
    }

    pub fn positional(&self, idx: i32) -> Option<string> {
        if idx < 0 || idx >= self.pos_args.len { return .None }
        .Some(self.pos_args[idx].clone())
    }

    pub fn subcommand_name(&self) -> Option<string> {
        if self.sub.len == 0 { return .None }
        .Some(self.sub[0].command.clone())
    }

    pub fn subcommand(&self) -> Option<Matches> {
        if self.sub.len == 0 { return .None }
        .Some(self.sub[0].clone())
    }
}

fn find_long_flag(flags: &[]FlagSpec, long_name: &str) -> i32 {
    for i in 0..flags.len {
        if flags[i].long_name == long_name { return i }
    }
    -1
}

fn find_short_flag(flags: &[]FlagSpec, short_name: &str) -> i32 {
    for i in 0..flags.len {
        if flags[i].short_name == short_name { return i }
    }
    -1
}

fn find_subcommand(subs: &[]Command, name: &str) -> i32 {
    for i in 0..subs.len {
        if subs[i].name == name { return i }
    }
    -1
}

fn set_count(m: &mut Matches, move name: string, delta: i32, accum: bool) {
    for i in 0..m.count_keys.len {
        if m.count_keys[i] == name {
            if accum { m.count_vals[i] += delta } else { m.count_vals[i] = delta }
            return
        }
    }
    m.count_keys.push(move name)
    m.count_vals.push(delta)
}

fn set_value(m: &mut Matches, move name: string, move value: string) {
    for i in 0..m.val_keys.len {
        if m.val_keys[i] == name {
            m.val_vals[i] = move value
            return
        }
    }
    m.val_keys.push(move name)
    m.val_vals.push(move value)
}

fn has_value_key(m: &Matches, name: &str) -> bool {
    for k in &m.val_keys {
        if k == name { return true }
    }
    false
}

fn render_spec_help(title: &str, version: &str, about: &str, flags: &[]FlagSpec, args: &[]ArgSpec, subs: &[]Command, is_root: bool) -> string {
    mut out := title.clone()
    if is_root && version.len > 0 { out = out + " " + version.clone() }
    out = out + "\n"
    if about.len > 0 { out = out + about.clone() + "\n" }
    out = out + "\nUSAGE:\n    " + title.clone()
    if flags.len > 0 || is_root { out = out + " [OPTIONS]" }
    if subs.len > 0 { out = out + " [SUBCOMMAND]" }
    for a in args {
        if a.required { out = out + " <" + a.name + ">" }
        else { out = out + " [" + a.name + "]" }
        if a.multiple { out = out + "..." }
    }
    out = out + "\n"
    if args.len > 0 {
        out = out + "\nARGS:\n"
        for a in args {
            req := if a.required { " (required)" } else { "" }
            out = out + f"    <{a.name}>    {a.help}{req}\n"
        }
    }
    out = out + "\nOPTIONS:\n"
    if find_long_flag(flags, "help") < 0 {
        out = out + "    -h, --help       Print help information\n"
    }
    if is_root && version.len > 0 && find_long_flag(flags, "version") < 0 {
        out = out + "    -V, --version    Print version information\n"
    }
    for f in flags {
        mut left := "    "
        if f.short_name.len > 0 && f.long_name.len > 0 {
            left = left + f"-{f.short_name}, --{f.long_name}"
        } else if f.long_name.len > 0 {
            left = left + f"    --{f.long_name}"
        } else {
            left = left + f"-{f.short_name}"
        }
        if f.kind == .Value {
            vname := if f.value_name.len > 0 { f.value_name.clone() } else { "VALUE" }
            left = left + f" <{vname}>"
        }
        mut line := text.pad_right(left, 28, " ")
        if f.help.len > 0 { line = line + " " + f.help.clone() }
        if f.has_default { line = line + f" [default: {f.default_val}]" }
        else if f.required { line = line + " [required]" }
        out = out + line + "\n"
    }
    if subs.len > 0 {
        out = out + "\nSUBCOMMANDS:\n"
        for s in subs {
            line := text.pad_right("    " + s.name.clone(), 20, " ") + " " + s.about.clone()
            out = out + line + "\n"
        }
    }
    out
}

pub fn render_help(app: &App) -> string {
    render_spec_help(app.name, app.version, app.about, &app.flags, &app.args, &app.subcommands, true)
}

pub fn render_command_help(app: &App, sub: &str) -> string {
    idx := find_subcommand(&app.subcommands, sub)
    if idx < 0 { return render_help(app) }
    cmd := &app.subcommands[idx]
    render_spec_help(f"{app.name} {cmd.name}", "", cmd.about, &cmd.flags, &cmd.args, &cmd.subcommands, false)
}

fn parse_level(prefix: string, name: string, version: string, about: string, flags: &[]FlagSpec, args: &[]ArgSpec, subs: &[]Command, argv: &[]string, offset: i32, is_root: bool) -> Result<Matches, ParseError> {
    mut m := empty_matches(name.clone())
    mut i := offset
    mut end_of_flags := false

    while i < argv.len {
        tok := &argv[i]
        if end_of_flags {
            m.pos_args.push(tok.clone())
            i += 1
            continue
        }
        if tok == "--" {
            end_of_flags = true
            i += 1
            continue
        }
        if text.starts_with(tok, "--") {
            rest := tv.strip_prefix(tok, "--")
            match tv.find(rest, "=") {
                .Some(eq_pos) => {
                    fname := &rest[..eq_pos]
                    fval := &rest[eq_pos + 1..]
                    fidx := find_long_flag(flags, fname)
                    if fidx < 0 { return .Err(.UnknownFlag("--" + fname.clone())) }
                    spec := &flags[fidx]
                    if spec.kind != .Value { return .Err(.UnexpectedValue("--" + fname.clone())) }
                    set_value(&mut m, spec.name.clone(), fval.clone())
                },
                .None => {
                    fidx := find_long_flag(flags, rest)
                    if fidx < 0 {
                        if rest == "help" {
                            return .Err(.HelpRequested(render_spec_help(prefix, version, about, flags, args, subs, is_root)))
                        }
                        if is_root && rest == "version" && version.len > 0 {
                            return .Err(.VersionRequested(f"{name} {version}"))
                        }
                        return .Err(.UnknownFlag(tok.clone()))
                    }
                    spec := &flags[fidx]
                    match spec.kind {
                        .Bool => { set_count(&mut m, spec.name.clone(), 1, false) },
                        .Count => { set_count(&mut m, spec.name.clone(), 1, true) },
                        .Value => {
                            if i + 1 >= argv.len { return .Err(.MissingValue("--" + rest.clone())) }
                            i += 1
                            set_value(&mut m, spec.name.clone(), argv[i].clone())
                        },
                    }
                },
            }
            i += 1
            continue
        }
        if tok.len > 1 && tok[0] == b'-' {
            mut j := 1
            while j < tok.len {
                ch := &tok[j..j + 1]
                fidx := find_short_flag(flags, ch)
                if fidx < 0 {
                    if ch == "h" {
                        return .Err(.HelpRequested(render_spec_help(prefix, version, about, flags, args, subs, is_root)))
                    }
                    if is_root && ch == "V" && version.len > 0 {
                        return .Err(.VersionRequested(f"{name} {version}"))
                    }
                    return .Err(.UnknownFlag("-" + ch.clone()))
                }
                spec := &flags[fidx]
                match spec.kind {
                    .Bool => {
                        set_count(&mut m, spec.name.clone(), 1, false)
                        j += 1
                    },
                    .Count => {
                        set_count(&mut m, spec.name.clone(), 1, true)
                        j += 1
                    },
                    .Value => {
                        if j + 1 < tok.len {
                            set_value(&mut m, spec.name.clone(), tok[j + 1..tok.len])
                        } else {
                            if i + 1 >= argv.len { return .Err(.MissingValue("-" + ch.clone())) }
                            i += 1
                            set_value(&mut m, spec.name.clone(), argv[i].clone())
                        }
                        j = tok.len
                    },
                }
            }
            i += 1
            continue
        }

        // Positional token: check subcommand before accumulating positionals if none seen yet.
        if m.pos_args.len == 0 && subs.len > 0 {
            sidx := find_subcommand(subs, tok)
            if sidx >= 0 {
                subcmd := &subs[sidx]
                sub_prefix := f"{prefix} {subcmd.name}"
                child := parse_level(sub_prefix, subcmd.name.clone(), "", subcmd.about.clone(), &subcmd.flags, &subcmd.args, &subcmd.subcommands, argv, i + 1, false)?
                m.sub.push(move child)
                break
            }
            if args.len == 0 {
                return .Err(.UnknownSubcommand(tok.clone()))
            }
        }
        m.pos_args.push(tok.clone())
        i += 1
    }

    for f in flags {
        if !has_value_key(&m, f.name) {
            if f.kind == .Value && f.has_default {
                set_value(&mut m, f.name.clone(), f.default_val.clone())
            } else if f.required && (f.kind != .Value || !has_value_key(&m, f.name)) && !m.has_flag(f.name) {
                return .Err(.MissingRequired("--" + f.name.clone()))
            }
        }
    }

    if m.sub.len == 0 {
        mut req_pos := 0
        for a in args {
            if a.required { req_pos += 1 }
        }
        if m.pos_args.len < req_pos {
            return .Err(.MissingRequired(args[m.pos_args.len].name.clone()))
        }
    }

    .Ok(m)
}

pub fn parse(app: &App, args: &[]string) -> Result<Matches, ParseError> {
    parse_level(app.name.clone(), app.name.clone(), app.version.clone(), app.about.clone(), &app.flags, &app.args, &app.subcommands, args, 0, true)
}

pub fn parse_argv(app: &App) -> Result<Matches, ParseError> {
    mut args: []string = []
    if target_is("native") {
        argc := sys.arg_count()
        mut i := 1
        while i < argc {
            args.push(sys.arg(i))
            i += 1
        }
    }
    parse(app, &args)
}

@test fn cli_parses_flags_options_subcommands_help_and_errors() {
    serve := Command::new("serve", "Start HTTP server")
        .flag("tls", "t", "Enable TLS")
        .option("port", "p", "PORT", "8080", false, "Port to bind")
        .arg("dir", true, false, "Document root")

    app := App::new("mytool", "0.8.0", "Sample CLI")
        .count_flag("verbose", "v", "Increase verbosity")
        .flag("quiet", "q", "Silence output")
        .option("config", "c", "FILE", "", false, "Config path")
        .subcommand(move serve)

    // Root flags + combined short flags + subcommand + --long=val + positional
    r1 := parse(&app, &["-vvq", "-c", "app.toml", "serve", "--tls", "--port=9090", "/srv/www"])
    assert(r1.is_ok())
    m1 := r1.unwrap()
    assert(m1.flag_count("verbose") == 2 && m1.has_flag("verbose") && m1.has_flag("quiet"))
    assert(m1.get("config") == .Some("app.toml"))
    assert(m1.subcommand_name() == .Some("serve"))
    sm1 := m1.subcommand().unwrap()
    assert(sm1.has_flag("tls") && sm1.get("port") == .Some("9090"))
    assert(sm1.get_i64("port") == .Ok(.Some(9090)))
    assert(sm1.positional(0) == .Some("/srv/www"))

    // Attached short option (-p3000) + default absence + `--` terminator
    r2 := parse(&app, &["serve", "-p3000", "--", "--not-a-flag"])
    assert(r2.is_ok())
    sm2 := r2.unwrap().subcommand().unwrap()
    assert(!sm2.has_flag("tls") && sm2.get_or("port", "0") == "3000")
    assert(sm2.positional(0) == .Some("--not-a-flag"))

    // Default option value
    r3 := parse(&app, &["serve", "."])
    assert(r3.is_ok() && r3.unwrap().subcommand().unwrap().get("port") == .Some("8080"))

    // Help and version
    h := parse(&app, &["serve", "--help"])
    match h {
        .Err(.HelpRequested(txt)) => assert(text.contains(txt, "Start HTTP server") && text.contains(txt, "--port")),
        _ => assert(false),
    }
    v := parse(&app, &["-V"])
    assert(v == .Err(.VersionRequested("mytool 0.8.0")))

    // Error cases
    assert(parse(&app, &["--bogus"]) == .Err(.UnknownFlag("--bogus")))
    assert(parse(&app, &["-c"]) == .Err(.MissingValue("-c")))
    assert(parse(&app, &["--quiet=yes"]) == .Err(.UnexpectedValue("--quiet")))
    assert(parse(&app, &["deploy"]) == .Err(.UnknownSubcommand("deploy")))
    assert(parse(&app, &["serve"]) == .Err(.MissingRequired("dir")))
    bad_int := parse(&app, &["serve", "--port=abc", "."]).unwrap().subcommand().unwrap().get_i64("port")
    assert(bad_int.is_err())
}
