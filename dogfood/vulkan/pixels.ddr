import ..graphics.vulkan as vk

fn main() {
    opened := vk.open_headless(64, 48)
    if !opened.ok { print(opened.error); assert(false) }
    window := opened.window
    name := vk.device_name(window)
    assert(name.len > 0)
    print(name)

    info := vk.poll(window)
    assert(!info.closed && info.width == 64 && info.height == 48)
    assert(info.pixel_width == 64 && info.pixel_height == 48 && info.scale == 1.0)

    var vertices: []f32 = []
    first := vk.draw(window, &vertices, 0.0, 0.0, 1.0)
    assert(first.ok && first.frames == 1)
    before := vk.pixels(window)
    assert(before.len == 64 * 48 * 4)
    for i in 0..64 * 48 {
        p := i * 4
        assert(before[p] == 0 && before[p + 1] == 0 && before[p + 2] == 255 && before[p + 3] == 255)
    }

    // A translucent red quad covers the top half of the blue framebuffer.
    vk.quad(&mut vertices, -1.0, 0.0, 2.0, 1.0, vk.rgba(1.0, 0.0, 0.0, 0.5))
    second := vk.draw(window, &vertices, 0.0, 0.0, 1.0)
    assert(second.ok && second.frames == 2)
    assert(vertices.len == 48 && vertices[0] == -1.0)
    var rgba := vk.pixels(window)
    top := (8 * 64 + 32) * 4
    bottom := (40 * 64 + 32) * 4
    assert(rgba[top] >= 127 && rgba[top] <= 128 && rgba[top + 1] == 0)
    assert(rgba[top + 2] >= 127 && rgba[top + 2] <= 128 && rgba[top + 3] == 255)
    assert(rgba[bottom] == 0 && rgba[bottom + 1] == 0 && rgba[bottom + 2] == 255)
    assert(before[top] == 0 && before[top + 2] == 255)
    rgba[bottom] = 17
    fresh := vk.pixels(window)
    assert(fresh[bottom] == 0)

    vertices.clear()
    vk.gradient_triangle(&mut vertices,
        vk.Point { x: -1.0, y: -1.0 }, vk.Point { x: 1.0, y: -1.0 }, vk.Point { x: 0.0, y: 1.0 },
        vk.rgb(1.0, 0.0, 0.0), vk.rgb(0.0, 1.0, 0.0), vk.rgb(0.0, 0.0, 1.0))
    third := vk.draw(window, &vertices, 0.0, 0.0, 0.0)
    assert(third.ok && third.frames == 3)
    gradient := vk.pixels(window)
    center := (24 * 64 + 32) * 4
    assert(gradient[center] >= 50 && gradient[center] <= 80)
    assert(gradient[center + 1] >= 50 && gradient[center + 1] <= 80)
    assert(gradient[center + 2] >= 110 && gradient[center + 2] <= 145)
    assert(gradient[0] == 0 && gradient[1] == 0 && gradient[2] == 0)
    vk.close(window)
    print("pixels ok")
}
