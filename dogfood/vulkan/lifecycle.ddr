// Headless native Vulkan lifecycle regression, suitable for lavapipe.
// Success prints lifecycle cycles=3; no desktop or SDL initialization is needed.
import ..graphics.vulkan as vulkan

fn reject_geometry(window: vulkan.Window, expected_frames: i64) {
    var malformed: []f32 = [0.0]
    partial := vulkan.draw(window, &malformed, 0.0, 0.0, 0.0)
    assert(!partial.ok && partial.error != "")
    assert(partial.frames == expected_frames)

    malformed.clear()
    // One complete vertex is not a complete triangle.
    vulkan.vertex(&mut malformed,
        vulkan.Point { x: 0.0, y: 0.0 }, vulkan.rgb(1.0, 1.0, 1.0))
    nontriangle := vulkan.draw(window, &malformed, 0.0, 0.0, 0.0)
    assert(!nontriangle.ok && nontriangle.error != "")
    assert(nontriangle.frames == expected_frames)

    malformed.clear()
    // 100002 complete vertices: divisible by three but above the 100000 cap.
    malformed.reserve(800016)
    for index in 0..800016 { malformed.push(0.0) }
    oversized := vulkan.draw(window, &malformed, 0.0, 0.0, 0.0)
    assert(!oversized.ok && oversized.error != "")
    assert(oversized.frames == expected_frames)
}

fn main() {
    zero := vulkan.open_headless(0, 48)
    negative := vulkan.open_headless(64, -1)
    excessive := vulkan.open_headless(16385, 48)
    assert(!zero.ok && zero.window.id == 0)
    assert(!negative.ok && negative.window.id == 0)
    assert(!excessive.ok && excessive.window.id == 0)

    var generation: i64 = 0
    var cycles := 0
    while cycles < 3 {
        opened := vulkan.open_headless(64, 48)
        assert(opened.ok)
        if cycles == 0 { print("device=" + vulkan.device_name(opened.window)) }
        assert(opened.window.id > generation)
        generation = opened.window.id
        occupied := vulkan.open_headless(32, 24)
        assert(!occupied.ok && occupied.window.id == 0)

        frame := vulkan.poll(opened.window)
        assert(!frame.closed)
        assert(frame.width == 64 && frame.height == 48)
        assert(frame.pixel_width > 0 && frame.pixel_height > 0)
        assert(frame.scale > 0.0 && frame.time >= 0.0)
        assert(frame.pixel_width == i32(f64(frame.width) * frame.scale))
        assert(frame.pixel_height == i32(f64(frame.height) * frame.scale))
        assert(frame.key == -1 && !frame.pointer_down)
        assert(frame.resized)

        var vertices: []f32 = []
        first := vulkan.draw(opened.window, &vertices, 0.15, 0.25, 0.35)
        assert(first.ok && first.frames == 1)
        second := vulkan.draw(opened.window, &vertices, 0.25, 0.15, 0.35)
        assert(second.ok && second.frames == first.frames + 1)
        captured := vulkan.pixels(opened.window)
        assert(captured.len == 64 * 48 * 4)
        assert(captured[3] == 255)
        reject_geometry(opened.window, second.frames)

        // Rejected geometry must leave the window and GPU submission usable.
        vulkan.triangle(&mut vertices,
            vulkan.Point { x: -0.5, y: -0.5 },
            vulkan.Point { x: 0.5, y: -0.5 },
            vulkan.Point { x: 0.0, y: 0.5 }, vulkan.rgb(0.3, 0.8, 0.6))
        recovered := vulkan.draw(opened.window, &vertices, 0.05, 0.05, 0.05)
        assert(recovered.ok && recovered.frames == second.frames + 1)
        later := vulkan.poll(opened.window)
        assert(!later.closed && later.time >= frame.time && !later.resized)

        vulkan.close(opened.window)
        vulkan.close(opened.window)
        stale := vulkan.poll(opened.window)
        assert(stale.closed && stale.key == -1)
        assert(vulkan.pixels(opened.window).len == 0)
        assert(vulkan.device_name(opened.window) == "")
        replacement := vulkan.open_headless(32, 24)
        assert(replacement.ok && replacement.window.id > generation)
        // A stale close cannot close the replacement window.
        vulkan.close(opened.window)
        current := vulkan.poll(replacement.window)
        assert(!current.closed && current.width == 32 && current.height == 24)
        replacement_first := vulkan.draw(replacement.window, &vertices, 0.0, 0.1, 0.2)
        assert(replacement_first.ok && replacement_first.frames == 1)

        rejected := vulkan.draw(opened.window, &vertices, 0.0, 0.0, 0.0)
        assert(!rejected.ok && rejected.error != "" && rejected.frames == 0)
        fabricated := vulkan.Window { id: -1 }
        vulkan.close(fabricated)
        assert(vulkan.poll(fabricated).closed)
        replacement_second := vulkan.draw(replacement.window, &vertices, 0.2, 0.1, 0.0)
        assert(replacement_second.ok && replacement_second.frames == replacement_first.frames + 1)
        vulkan.close(replacement.window)
        generation = replacement.window.id
        cycles = cycles + 1
    }
    print("lifecycle cycles=" + cycles.str())
}
