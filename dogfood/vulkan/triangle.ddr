import ..graphics.vulkan as vulkan
import sys
import options
import "../graphics/triangle" as geometry

fn main() -> i32 {
    settings := options.read()
    if !settings.ok { diagnostic := sys.eprint(settings.error); return 2 }
    var opened: vulkan.OpenResult = vulkan.OpenResult { ok: false, window: vulkan.Window { id: 0 }, error: "" }
    if settings.headless { opened = vulkan.open_headless(800, 600) }
    else { opened = vulkan.open("Dunder / Vulkan triangle - Escape to close", 800, 600) }
    if !opened.ok { diagnostic := sys.eprint(opened.error); return 1 }
    print("device=" + vulkan.device_name(opened.window))
    var vertices: []f32 = []
    for value in geometry.vertices() { vertices.push(value) }
    var frames: i64 = 0
    var width := 800
    var height := 600
    var running := true
    while running {
        frame := vulkan.poll(opened.window)
        if frame.closed || frame.key == 27 { running = false }
        else {
            drawn := vulkan.draw(opened.window, &vertices, 0.035, 0.045, 0.075)
            if !drawn.ok { diagnostic := sys.eprint(drawn.error); vulkan.close(opened.window); return 1 }
            frames = drawn.frames
            width = frame.pixel_width
            height = frame.pixel_height
            if settings.frames > 0 && frames >= settings.frames { running = false }
        }
    }
    if settings.capture != "" {
        pixels := vulkan.pixels(opened.window)
        saved := options.capture(settings.capture, width, height, &pixels)
        if !saved.ok { diagnostic := sys.eprint("capture: " + sys.error_message(saved.error)); vulkan.close(opened.window); return 1 }
    }
    vulkan.close(opened.window)
    print("triangle frames=" + frames.str())
    0
}
