import sys
import std.parse as parse
import std.bytes as bytes

pub struct Options { ok: bool, error: string, frames: i64, headless: bool, capture: string }

// Zero means interactive. Headless/capture runs finish after three frames by default.
pub fn parse_arguments(arguments: &[]string) -> Options {
    var result := Options { ok: true, error: "", frames: 0, headless: false, capture: "" }
    var index := 0
    while index < arguments.len {
        argument := arguments[index]
        if argument == "--headless" {
            result.headless = true
            index = index + 1
        } else if argument == "--frames" {
            if index + 1 >= arguments.len { result.ok = false; result.error = "--frames needs a positive integer"; return result }
            parsed := parse.integer(arguments[index + 1])
            if !parsed.ok || parsed.value <= 0 { result.ok = false; result.error = "--frames needs a positive integer"; return result }
            result.frames = parsed.value
            index = index + 2
        } else if argument == "--capture" {
            if index + 1 >= arguments.len || arguments[index + 1] == "" { result.ok = false; result.error = "--capture needs a PPM file path"; return result }
            result.capture = arguments[index + 1]
            index = index + 2
        } else {
            result.ok = false
            result.error = "unknown argument: " + argument
            return result
        }
    }
    if (result.headless || result.capture != "") && result.frames == 0 { result.frames = 3 }
    result
}

pub fn read() -> Options {
    var arguments: []string = []
    for index in 1..sys.arg_count() { arguments.push(sys.arg(index)) }
    parse_arguments(&arguments)
}

pub fn capture(path: string, width: i32, height: i32, pixels: &[]i32) -> sys.Status {
    if width <= 0 || height <= 0 || i64(width) * i64(height) * 4 != i64(pixels.len) {
        return sys.Status { ok: false, error: 22 }
    }
    var output: []i32 = []
    output.reserve(pixels.len / 4 * 3 + 64)
    bytes.append_text(&mut output, "P6\n" + width.str() + " " + height.str() + "\n255\n")
    var index := 0
    while index < pixels.len {
        output.push(pixels[index])
        output.push(pixels[index + 1])
        output.push(pixels[index + 2])
        index = index + 4
    }
    sys.write_bytes(path, &output)
}

@test fn headless_runs_are_bounded_and_capture_arguments_are_checked() {
    empty: []string = []
    parse_arguments(&empty).frames == 0
    var arguments: []string = ["--headless"]
    headless := parse_arguments(&arguments)
    headless.ok && headless.headless && headless.frames == 3
    arguments = ["--frames", "7", "--headless", "--capture", "frame.ppm"]
    explicit := parse_arguments(&arguments)
    explicit.ok && explicit.frames == 7 && explicit.capture == "frame.ppm"
    arguments = ["--capture", "frame.ppm"]
    parse_arguments(&arguments).frames == 3
    arguments = ["--frames"]
    !parse_arguments(&arguments).ok
    arguments = ["--frames", "0"]
    !parse_arguments(&arguments).ok
    arguments = ["--frames", "-1"]
    !parse_arguments(&arguments).ok
    arguments = ["--capture"]
    !parse_arguments(&arguments).ok
    arguments = ["--capture", ""]
    !parse_arguments(&arguments).ok
    arguments = ["--unknown"]
    !parse_arguments(&arguments).ok
}
