import "text/scan" as text

struct Message { body: string, marker: rune }

@test {
    (Message { body: "Hej 🌍", marker: `🌍` }) -> "🌍 Hej världen"
    original := "åäö 🌍"
    var changed := original
    snapshot := changed.runes()
    changed = "new"
    snapshot[4] == `🌍`
    original.len == 11
    original.runes().len == 5
    original[7..11] == "🌍"
}
fn render(message: Message) -> string {
    message.marker.str() + " " + text.replace(message.body, "🌍", "världen")
}

fn main() {
    content := "Hej 🌍\nDunder är här."
    print("bytes=" + content.len.str())
    print("runes=" + content.runes().len.str())
    print("words=" + text.word_count(content).str())
    print(render(Message { body: "Hej 🌍", marker: `🌍` }))
}
