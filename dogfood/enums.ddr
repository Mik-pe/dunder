import sys

enum Command { Move(i32, i32), Print(string), Stop }
struct Entry { kind: sys.FileKind, size: i64 }

@test {
    (Command.Move(20, 22)) -> 42
    (.Print("Dunder 🌍")) -> 11
    (.Stop) -> 0
}
fn evaluate(command: Command) -> i32 {
    match command {
        .Move(x, y) => x + y,
        .Print(text) => text.len,
        .Stop => 0,
    }
}

@test {
    (sys.ReadResult.Ok("hello")) -> "hello"
    (.Err(.NotFound)) -> "missing"
    (.Err(.Other(12345))) -> "OS error 12345"
}
fn describe(result: sys.ReadResult) -> string {
    match result {
        .Ok(text) => text,
        .Err(error) => {
            match error {
                .NotFound => "missing",
                .Other(code) => "OS error " + code.str(),
                _ => sys.io_error_message(error),
            }
        },
    }
}

@test fn value_enums_work_in_records_and_arrays() {
    var entry := Entry { kind: .File, size: 42 }
    entry.kind = .Directory
    entry.kind == sys.FileKind.Directory
    kinds: [sys.FileKind; 3] = [.Other, .File, .Directory]
    var sum := 0
    for kind in kinds { sum = sum + i32(kind) }
    sum == 3
    sys.file_kind(sys.metadata(".")) == .Directory
}

fn main() {
    print(evaluate(.Move(20, 22)))
    print(describe(.Ok("enums ok")))
}
