@test
fn modules_compose() {
    assert(recursion.gcd(1071, 462) == 21)
    assert(sorting.sorted_checksum([9, 1, 8, 2, 7, 3, 6, 4, 5, 0]) == 45)
    assert(arena.tree_sum() == 28)
}

@test
fn ranges_and_arrays_agree() {
    var values := [0; 8]
    for i in 0..len(values) { values[i] = i + 1 }
    var checksum := 0
    for value in values { checksum = checksum + value }
    assert(checksum == 36)
}
