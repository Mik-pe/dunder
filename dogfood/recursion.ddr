pub fn fibonacci(n: i32) -> i64 {
    if n < 2 {
        return i64(n)
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

pub fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn main() {
    print(fibonacci(20))
    print(gcd(1071, 462))
}

@test
fn recursive_return_values() {
    assert(fibonacci(10) == 55)
    assert(gcd(1071, 462) == 21)
}
