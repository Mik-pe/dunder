import geometry

@test {
    (geometry.Point { x: 3, y: 4 }) -> 32
    original := geometry.Point { x: 3, y: 4 }
    shifted_score(original) == 32
    original.x == 3
}
fn shifted_score(p: geometry.Point) -> i32 {
    var copy := p
    copy.x = copy.x + 1
    geometry.length_squared(copy)
}

fn main() {
    point := geometry.Point { x: 3, y: 4 }
    print(geometry.length_squared(point))
    print(shifted_score(point))
    print(point.x)
}
