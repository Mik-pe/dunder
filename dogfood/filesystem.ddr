import sys

fn round_trip() -> i32 {
    root := ".dunder-fs-" + sys.pid().str()
    created := sys.mkdir(root)
    assert(created.ok)
    original := root + "/å 🌍.txt"
    renamed := root + "/renamed.txt"
    assert(sys.write_text(original, "Dunder 🌍\n").ok)
    assert(sys.append_text(original, "åäö").ok)
    content := sys.read_text(original)
    assert(content.ok)
    assert(content.value == "Dunder 🌍\nåäö")
    assert(content.value.runes().len == 12)
    info := sys.metadata(original)
    assert(info.ok && info.is_file && !info.is_dir)
    assert(info.size == i64(content.value.len))
    assert(sys.metadata(root).is_dir)
    assert(sys.rename(original, renamed).ok)
    assert(sys.metadata(original).error == 2)
    assert(sys.remove_file(renamed).ok)
    assert(sys.remove_dir(root).ok)
    content.value.len
}

@test fn files_round_trip_through_the_os() { round_trip() == 18 }

@test fn errors_remain_values() {
    root := ".dunder-fs-errors-" + sys.pid().str()
    assert(sys.mkdir(root).ok)
    missing := sys.read_text(root + "/missing")
    !missing.ok
    missing.error == 2
    missing.value == ""
    sys.error_message(missing.error) == "no such file or directory"
    sys.mkdir(root).error == 17
    sys.read_text(root).error == 21
    sys.write_text(root + "\0/ignored", "bad").error == 22
    assert(sys.remove_dir(root).ok)
}

fn main() {
    print(round_trip())
    print("filesystem ok")
}
