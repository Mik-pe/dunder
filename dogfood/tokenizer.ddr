import text/scan as text

fn punctuation(r: rune) -> bool {
    r == `(` || r == `)` || r == `{` || r == `}` || r == `,` || r == `=` || r == `+`
}

// A small scanner for UTF-8 words, ASCII punctuation and quoted strings.
// Preserves token spelling; this is not the complete Dunder lexer or Unicode XID.
@test {
    ("") -> ""
    ("fn hälsa(namn) { print(\"Hej 🌍\") }") -> "fn|hälsa|(|namn|)|{|print|(|\"Hej 🌍\"|)|}"
    ("å\u{A0}ä\u{2003}ö") -> "å|ä|ö"
    ("x = \"a\\\"b\" + y") -> "x|=|\"a\\\"b\"|+|y"
    ("日本語 + κόσμος") -> "日本語|+|κόσμος"
}
pub fn tokenize(source: string) -> string {
    var result := ""
    var index := 0
    while index < source.len {
        r := text.rune_at(source, index)
        width := text.width_at(source, index)
        if text.is_space(r) { index = index + width; continue }
        start := index
        index = index + width
        if r == `"` {
            var closed := false
            while index < source.len {
                next := text.rune_at(source, index)
                index = index + text.width_at(source, index)
                if next == `\\` {
                    assert(index < source.len)
                    index = index + text.width_at(source, index)
                    continue
                }
                if next == `"` { closed = true; break }
            }
            assert(closed)
        } else if !punctuation(r) {
            while index < source.len {
                next := text.rune_at(source, index)
                if text.is_space(next) || punctuation(next) || next == `"` { break }
                index = index + text.width_at(source, index)
            }
        }
        if result.len > 0 { result = result + "|" }
        result = result + source[start..index]
    }
    result
}

fn main() {
    print(tokenize("fn hälsa(namn) { print(\"Hej 🌍\") }"))
}
