import std.map as map
import std.set as set
import std.array as array
import std.text as text
import std.bytes as bytes
import std.sha256 as sha256
import std.parse as parse

struct Stats { unique: i32, total: i64 }
fn word_stats(input: string) -> Stats {
    var counts := map.new()
    var distinct := set.new()
    words := text.split(text.trim(input), " ")
    for word in words {
        if word == "" { continue }
        previous := map.get_or(&counts, word, 0)
        map.put(&mut counts, word, previous + 1)
        added := set.insert(&mut distinct, word)
    }
    assert(map.length(&counts) == set.length(&distinct))
    var frequencies := array.ints()
    for key in map.keys(&counts) { frequencies.push(map.get_or(&counts, key, 0)) }
    array.sort(&mut frequencies)
    Stats { unique: map.length(&counts), total: array.sum(&frequencies) }
}
@test fn standard_collections_compose_in_a_utf8_word_counter() {
    stats := word_stats("dunder thunder dunder å 🌍 å")
    stats.unique == 4
    stats.total == 6
    empty := word_stats("  \t\n ")
    empty.unique == 0
    empty.total == 0
}
@test fn parsers_hashes_and_byte_encoding_are_regular_dunder_modules() {
    parsed := parse.integer("-42_000")
    parsed.ok
    parsed.value == -42000
    digest := sha256.text("abc")
    bytes.hex(&digest) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    data: []i32 = [195, 165, 0, 240, 159, 140, 141]
    decoded := bytes.utf8(&data)
    decoded.ok
    decoded.value == "å\0🌍"
    invalid: []i32 = [255]
    !bytes.utf8(&invalid).ok
}
fn main() {
    stats := word_stats("dunder thunder dunder å 🌍 å")
    print(stats.unique)
    print(stats.total)
    print("stdlib ok")
}
