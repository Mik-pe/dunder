pub fn sorted_checksum(input: [i32; 10]) -> i32 {
    var values := input
    for start in 1..len(values) {
        key := values[start]
        var i := start
        while i > 0 && values[i - 1] > key {
            values[i] = values[i - 1]
            i = i - 1
        }
        values[i] = key
    }
    var previous := -1
    var checksum := 0
    for value in values.iter() {
        assert(value >= previous)
        previous = value
        checksum = checksum + value
    }
    assert(values[0] == 0)
    assert(values[9] == 9)
    return checksum
}

fn main() {
    original := [9, 1, 8, 2, 7, 3, 6, 4, 5, 0]
    print(sorted_checksum(original))
    print(original[0])
}

@test
fn sorting_copies_its_input() {
    original := [9, 1, 8, 2, 7, 3, 6, 4, 5, 0]
    assert(sorted_checksum(original) == 45)
    assert(original[0] == 9)
}
