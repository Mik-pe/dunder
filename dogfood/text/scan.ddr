// Small text utilities written in Dunder, not compiler intrinsics.
// Space recognition intentionally covers only the listed scalar values.
pub fn is_space(r: rune) -> bool {
    r == ` ` || r == `\t` || r == `\r` || r == `\n` || r == `\u{A0}` || r == `\u{2003}`
}

pub fn is_boundary(text: string, index: i32) -> bool {
    if index < 0 || index > text.len { return false }
    if index == text.len { return true }
    byte := text[index]
    byte < 128 || byte >= 192
}

pub fn width_at(text: string, index: i32) -> i32 {
    assert(is_boundary(text, index) && index < text.len)
    byte := text[index]
    if byte < 128 { return 1 }
    if byte < 224 { return 2 }
    if byte < 240 { return 3 }
    4
}

// Decode at a byte boundary using the public byte-indexing operations.
pub fn rune_at(text: string, index: i32) -> rune {
    width := width_at(text, index)
    var value := text[index]
    if width == 2 { value = value % 32 }
    if width == 3 { value = value % 16 }
    if width == 4 { value = value % 8 }
    for i in 1..width { value = value * 64 + text[index + i] % 64 }
    rune(value)
}

@test {
    ("") -> 0
    ("Hej 🌍\nDunder är här.") -> 5
    ("å\u{A0}ä\u{2003}ö") -> 3
    (" \t \r\n ") -> 0
}
pub fn word_count(text: string) -> i32 {
    var count := 0
    var inside := false
    for r in text.runes() {
        if is_space(r) {
            inside = false
        } else {
            if !inside { count = count + 1 }
            inside = true
        }
    }
    count
}

fn matches_at(text: string, needle: string, index: i32) -> bool {
    if index < 0 || index > text.len || needle.len > text.len - index { return false }
    for j in 0..needle.len {
        if text[index + j] != needle[j] { return false }
    }
    true
}

@test {
    ("Dunder 🌍 är här", "🌍") -> 7
    ("räksmörgås", "smör") -> 4
    ("åäö", "missing") -> -1
    ("", "") -> 0
    ("a\0b", "\0") -> 1
}
pub fn find(text: string, needle: string) -> i32 {
    if needle.len > text.len { return -1 }
    for i in 0..text.len - needle.len + 1 {
        if matches_at(text, needle, i) { return i }
    }
    -1
}

@test {
    ("Hej 🌍", "🌍", "världen") -> "Hej världen"
    ("ååå", "åå", "ö") -> "öå"
    ("abc", "", "x") -> "abc"
    ("a\0b", "\0", "-") -> "a-b"
}
pub fn replace(text: string, needle: string, replacement: string) -> string {
    if needle.len == 0 { return text }
    var result := ""
    var index := 0
    while index < text.len {
        if matches_at(text, needle, index) {
            result = result + replacement
            index = index + needle.len
        } else {
            next := index + width_at(text, index)
            result = result + text[index..next]
            index = next
        }
    }
    result
}

@test fn utf8_boundaries_and_decoder_agree() {
    text := "Aå€🌍"
    var offset := 0
    for expected in text.runes() {
        assert(is_boundary(text, offset))
        assert(rune_at(text, offset) == expected)
        offset = offset + width_at(text, offset)
    }
    assert(offset == text.len)
    assert(is_boundary(text, offset))
    assert(!is_boundary(text, 2))
    assert(!is_boundary(text, -1))
    assert(!is_boundary(text, text.len + 1))
}
