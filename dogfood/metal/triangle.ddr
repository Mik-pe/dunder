import std.macos as macos
import options

fn main() {
    limit := options.frame_limit()
    opened := macos.open("Dunder / Metal triangle - Escape to close", 800, 600)
    if !opened.ok { print(opened.error); assert(false) }
    var vertices: []f32 = []
    macos.gradient_triangle(&mut vertices,
        macos.Point { x: 0.0, y: 0.72 },
        macos.Point { x: -0.72, y: -0.62 },
        macos.Point { x: 0.72, y: -0.62 },
        macos.rgb(1.0, 0.69, 0.28),
        macos.rgb(0.16, 0.87, 0.74),
        macos.rgb(0.40, 0.47, 1.0))
    var frames: i64 = 0
    var running := true
    while running {
        frame := macos.poll(opened.window)
        if frame.closed || frame.key == 53 { running = false }
        else {
            drawn := macos.draw(opened.window, &vertices, 0.035, 0.045, 0.075)
            if !drawn.ok { print(drawn.error); macos.close(opened.window); assert(false) }
            frames = frames + 1
            if limit > 0 && frames >= limit { running = false }
        }
    }
    macos.close(opened.window)
    print("triangle frames=" + frames.str())
}
