import std.macos as macos
import options
import scene

fn main() {
    limit := options.frame_limit()
    opened := macos.open("Dunder / Kinetic Atlas - drag sculpture | Space pause | C color | R reset | Esc close", 1100, 740)
    if !opened.ok { print(opened.error); assert(false) }
    var state := scene.initial()
    var vertices: []f32 = []
    vertices.reserve(40000)
    var frames: i64 = 0
    var running := true
    while running {
        frame := macos.poll(opened.window)
        if frame.closed || frame.key == 53 { running = false }
        else {
            scene.update(&mut state, frame)
            scene.render(&mut vertices, state, frame)
            drawn := macos.draw(opened.window, &vertices, 0.024, 0.047, 0.068)
            if !drawn.ok { print(drawn.error); macos.close(opened.window); assert(false) }
            frames = frames + 1
            if limit > 0 && frames >= limit { running = false }
        }
    }
    macos.close(opened.window)
    print("atlas frames=" + frames.str())
}
