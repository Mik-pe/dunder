import ..graphics.macos as macos
import math

pub enum Motion { Running = 0, Paused = 1 }
pub enum Palette { Lagoon = 0, Ember = 1, Iris = 2 }
pub struct State {
    center_x: f64,
    center_y: f64,
    time: f64,
    previous_time: f64,
    motion: Motion,
    palette: Palette,
    dragging: bool,
    previous_down: bool,
    drag_x: f64,
    drag_y: f64,
}
struct Canvas { width: f64, height: f64 }

pub fn initial() -> State {
    State { center_x: 0.60, center_y: 0.53, time: 0.0, previous_time: 0.0,
        motion: .Running, palette: .Lagoon, dragging: false, previous_down: false,
        drag_x: 0.0, drag_y: 0.0 }
}

fn next_palette(palette: Palette) -> Palette {
    match palette {
        .Lagoon => .Ember,
        .Ember => .Iris,
        .Iris => .Lagoon,
    }
}

pub fn update(state: &mut State, frame: macos.Frame) {
    delta := math.clamp(frame.time - state.previous_time, 0.0, 0.1)
    state.previous_time = frame.time
    if frame.key == 49 {
        if state.motion == .Running { state.motion = .Paused }
        else { state.motion = .Running }
    }
    if frame.key == 8 {
        state.palette = next_palette(state.palette)
    }
    if frame.key == 15 { state.center_x = 0.60; state.center_y = 0.53 }
    if state.motion == .Running { state.time = state.time + delta }
    if frame.width > 0 && frame.height > 0 {
        width := f64(frame.width)
        height := f64(frame.height)
        if frame.pointer_down && !state.previous_down {
            dx := frame.pointer_x - state.center_x * width
            dy := frame.pointer_y - state.center_y * height
            var reach := height * 0.30
            if width * 0.30 < reach { reach = width * 0.30 }
            if dx * dx + dy * dy <= reach * reach {
                state.dragging = true
                state.drag_x = state.center_x - frame.pointer_x / width
                state.drag_y = state.center_y - frame.pointer_y / height
            }
        }
        if state.dragging && frame.pointer_down {
            state.center_x = math.clamp(frame.pointer_x / width + state.drag_x, 0.15, 0.85)
            state.center_y = math.clamp(frame.pointer_y / height + state.drag_y, 0.20, 0.80)
        }
    }
    if !frame.pointer_down { state.dragging = false }
    state.previous_down = frame.pointer_down
}

fn point(canvas: Canvas, x: f64, y: f64) -> macos.Point {
    macos.Point { x: f32(x * 2.0 / canvas.width - 1.0), y: f32(1.0 - y * 2.0 / canvas.height) }
}
fn fill(vertices: &mut []f32, canvas: Canvas, x: f64, y: f64, width: f64, height: f64, color: macos.Color) {
    macos.quad(&mut vertices, f32(x * 2.0 / canvas.width - 1.0), f32(1.0 - (y + height) * 2.0 / canvas.height),
        f32(width * 2.0 / canvas.width), f32(height * 2.0 / canvas.height), color)
}
fn triangle(vertices: &mut []f32, canvas: Canvas, x: f64, y: f64, radius: f64, angle: f64, color: macos.Color) {
    a := point(canvas, x + math.cos(angle) * radius, y + math.sin(angle) * radius)
    b := point(canvas, x + math.cos(angle + 2.0943951023931953) * radius, y + math.sin(angle + 2.0943951023931953) * radius)
    c := point(canvas, x + math.cos(angle + 4.1887902047863905) * radius, y + math.sin(angle + 4.1887902047863905) * radius)
    macos.triangle(&mut vertices, a, b, c, color)
}
fn disc(vertices: &mut []f32, canvas: Canvas, x: f64, y: f64, radius: f64, color: macos.Color) {
    center := point(canvas, x, y)
    for segment in 0..32 {
        angle := f64(segment) * 0.19634954084936207
        next := angle + 0.19634954084936207
        a := point(canvas, x + math.cos(angle) * radius, y + math.sin(angle) * radius)
        b := point(canvas, x + math.cos(next) * radius, y + math.sin(next) * radius)
        macos.triangle(&mut vertices, center, a, b, color)
    }
}
fn ring(vertices: &mut []f32, canvas: Canvas, x: f64, y: f64, rx: f64, ry: f64, thickness: f64, color: macos.Color) {
    for segment in 0..96 {
        angle := f64(segment) * 0.06544984694978735
        next := angle + 0.06544984694978735
        a := point(canvas, x + math.cos(angle) * rx, y + math.sin(angle) * ry)
        b := point(canvas, x + math.cos(next) * rx, y + math.sin(next) * ry)
        c := point(canvas, x + math.cos(next) * (rx - thickness), y + math.sin(next) * (ry - thickness))
        d := point(canvas, x + math.cos(angle) * (rx - thickness), y + math.sin(angle) * (ry - thickness))
        macos.triangle(&mut vertices, a, b, c, color)
        macos.triangle(&mut vertices, a, c, d, color)
    }
}
fn tile(vertices: &mut []f32, canvas: Canvas, x: f64, y: f64, width: f64, height: f64, angle: f64, color: macos.Color) {
    cx := math.cos(angle)
    cy := math.sin(angle)
    a := point(canvas, x - width * cx - height * cy, y - width * cy + height * cx)
    b := point(canvas, x + width * cx - height * cy, y + width * cy + height * cx)
    c := point(canvas, x + width * cx + height * cy, y + width * cy - height * cx)
    d := point(canvas, x - width * cx + height * cy, y - width * cy - height * cx)
    macos.triangle(&mut vertices, a, b, c, color)
    macos.triangle(&mut vertices, a, c, d, color)
}

// A small geometric wordmark is scene content, not a native text control.
fn glyph(code: i32) -> [i32; 7] {
    if code == 68 { return [30, 17, 17, 17, 17, 17, 30] }
    if code == 85 { return [17, 17, 17, 17, 17, 17, 14] }
    if code == 78 { return [17, 25, 25, 21, 19, 19, 17] }
    if code == 69 { return [31, 16, 16, 30, 16, 16, 31] }
    if code == 82 { return [30, 17, 17, 30, 20, 18, 17] }
    if code == 77 { return [17, 27, 21, 21, 17, 17, 17] }
    if code == 84 { return [31, 4, 4, 4, 4, 4, 4] }
    if code == 65 { return [14, 17, 17, 31, 17, 17, 17] }
    if code == 76 { return [16, 16, 16, 16, 16, 16, 31] }
    if code == 73 { return [31, 4, 4, 4, 4, 4, 31] }
    if code == 86 { return [17, 17, 17, 17, 17, 10, 4] }
    if code == 72 { return [17, 17, 17, 31, 17, 17, 17] }
    if code == 79 { return [14, 17, 17, 17, 17, 17, 14] }
    [0, 0, 0, 0, 0, 0, 0]
}
fn label(vertices: &mut []f32, canvas: Canvas, x: f64, y: f64, text: string, pixel: f64, color: macos.Color) {
    for index in 0..text.len {
        rows := glyph(text[index])
        for row in 0..7 {
            for column in 0..5 {
                if rows[row].shr(4 - column).bit_and(1) == 1 {
                    fill(&mut vertices, canvas, x + f64(index * 6 + column) * pixel, y + f64(row) * pixel, pixel, pixel, color)
                }
            }
        }
    }
}

fn accent(palette: Palette) -> macos.Color {
    match palette {
        .Lagoon => macos.rgb(0.29, 0.94, 0.77),
        .Ember => macos.rgb(1.0, 0.46, 0.34),
        .Iris => macos.rgb(0.72, 0.58, 1.0),
    }
}

pub fn render(vertices: &mut []f32, state: State, frame: macos.Frame) {
    vertices.clear()
    if frame.width <= 0 || frame.height <= 0 { return }
    width := f64(frame.width)
    height := f64(frame.height)
    var unit := height / 740.0
    if width / 1100.0 < unit { unit = width / 1100.0 }
    canvas := Canvas { width: width, height: height }
    mint := accent(state.palette)
    cream := macos.rgb(0.94, 0.91, 0.79)
    gold := macos.rgb(1.0, 0.70, 0.33)
    blue := macos.rgb(0.39, 0.48, 1.0)
    muted := macos.rgb(0.34, 0.42, 0.49)
    grid := macos.rgba(0.45, 0.68, 0.72, 0.055)
    step := 48.0 * unit
    var x := 30.0 * unit
    while x < width { fill(&mut vertices, canvas, x, 0.0, 0.6 * unit, height, grid); x = x + step }
    var y := 24.0 * unit
    while y < height { fill(&mut vertices, canvas, 0.0, y, width, 0.6 * unit, grid); y = y + step }

    label(&mut vertices, canvas, 42.0 * unit, 38.0 * unit, "DUNDER", 4.5 * unit, cream)
    label(&mut vertices, canvas, 44.0 * unit, 86.0 * unit, "METAL", 1.6 * unit, muted)
    fill(&mut vertices, canvas, 44.0 * unit, 114.0 * unit, 70.0 * unit, 3.0 * unit, mint)
    if width > 580.0 {
        disc(&mut vertices, canvas, width - 134.0 * unit, 48.0 * unit, 3.5 * unit, mint)
        if state.motion == .Running {
            label(&mut vertices, canvas, width - 118.0 * unit, 42.0 * unit, "LIVE", 1.8 * unit, muted)
        } else {
            label(&mut vertices, canvas, width - 118.0 * unit, 42.0 * unit, "HOLD", 1.8 * unit, muted)
        }
    }

    cx := width * state.center_x
    cy := height * state.center_y
    t := state.time
    // Layered translucent paper tiles and orbital paths are all CPU-built geometry.
    tile(&mut vertices, canvas, cx + 10.0 * unit, cy + 18.0 * unit, 146.0 * unit, 172.0 * unit, -0.16, macos.rgba(0.04, 0.10, 0.14, 0.9))
    tile(&mut vertices, canvas, cx - 12.0 * unit, cy + 2.0 * unit, 140.0 * unit, 165.0 * unit, -0.07, macos.rgba(0.12, 0.23, 0.26, 0.9))
    tile(&mut vertices, canvas, cx, cy, 136.0 * unit, 158.0 * unit, 0.035, macos.rgb(0.075, 0.15, 0.19))
    ring(&mut vertices, canvas, cx, cy, 275.0 * unit, 120.0 * unit, 1.0 * unit, macos.rgba(0.44, 0.69, 0.70, 0.26))
    ring(&mut vertices, canvas, cx, cy, 208.0 * unit, 208.0 * unit, 0.8 * unit, macos.rgba(0.44, 0.69, 0.70, 0.12))
    ring(&mut vertices, canvas, cx, cy, 235.0 * unit, 235.0 * unit, 0.8 * unit, macos.rgba(0.44, 0.69, 0.70, 0.065))

    // Six independently shaded facets form a slowly breathing geometric sculpture.
    rotation := t * 0.18 - 1.5707963267948966
    radius := (128.0 + 5.0 * math.sin(t * 1.2)) * unit
    center := point(canvas, cx, cy)
    for facet in 0..6 {
        angle := rotation + f64(facet) * 1.0471975511965976
        next := angle + 1.0471975511965976
        a := point(canvas, cx + math.cos(angle) * radius, cy + math.sin(angle) * radius)
        b := point(canvas, cx + math.cos(next) * radius, cy + math.sin(next) * radius)
        if facet == 0 || facet == 3 { macos.gradient_triangle(&mut vertices, center, a, b, cream, mint, blue) }
        else if facet == 1 || facet == 4 { macos.gradient_triangle(&mut vertices, center, a, b, cream, blue, gold) }
        else { macos.gradient_triangle(&mut vertices, center, a, b, cream, gold, mint) }
    }
    triangle(&mut vertices, canvas, cx, cy, 35.0 * unit, -t * 0.30, macos.rgba(0.04, 0.10, 0.14, 0.80))
    triangle(&mut vertices, canvas, cx, cy, 19.0 * unit, t * 0.45, cream)

    for satellite in 0..7 {
        angle := t * 0.28 + f64(satellite) * 0.8975979010256552
        sx := cx + math.cos(angle) * 275.0 * unit
        sy := cy + math.sin(angle) * 120.0 * unit
        if satellite == 0 {
            disc(&mut vertices, canvas, sx, sy, 14.0 * unit, macos.rgba(0.29, 0.94, 0.77, 0.08))
            disc(&mut vertices, canvas, sx, sy, 5.0 * unit, mint)
        } else if satellite == 3 { triangle(&mut vertices, canvas, sx, sy, 10.0 * unit, angle, gold) }
        else { disc(&mut vertices, canvas, sx, sy, 2.5 * unit, muted) }
    }
    disc(&mut vertices, canvas, cx + math.cos(-t * 0.16 + 2.0) * 208.0 * unit,
        cy + math.sin(-t * 0.16 + 2.0) * 208.0 * unit, 7.0 * unit, blue)

    // Small print-like geometric studies balance the open left side.
    if width > 680.0 {
        lx := 65.0 * unit
        ly := height * 0.50
        triangle(&mut vertices, canvas, lx + 26.0 * unit, ly, 28.0 * unit, -1.5707963267948966, mint)
        triangle(&mut vertices, canvas, lx + 65.0 * unit, ly + 26.0 * unit, 28.0 * unit, 1.5707963267948966, gold)
        fill(&mut vertices, canvas, 44.0 * unit, ly + 96.0 * unit, 112.0 * unit, 1.0 * unit, muted)
        for mark in 0..4 {
            fill(&mut vertices, canvas, (44.0 + f64(mark) * 28.0) * unit, ly + 92.0 * unit, 1.0 * unit, 9.0 * unit, muted)
        }
    }
    fill(&mut vertices, canvas, 44.0 * unit, height - 53.0 * unit, width - 88.0 * unit, 0.8 * unit, macos.rgba(0.44, 0.69, 0.70, 0.20))
    for mark in 0..12 {
        var bar := 2.0
        if state.motion == .Running { bar = 2.0 + (math.sin(t * 2.3 + f64(mark) * 0.6) + 1.0) * 5.0 }
        fill(&mut vertices, canvas, (44.0 + f64(mark) * 5.0) * unit, height - (26.0 + bar) * unit, 2.0 * unit, bar * unit, mint)
    }
    if state.dragging { ring(&mut vertices, canvas, cx, cy, 148.0 * unit, 148.0 * unit, 2.0 * unit, mint) }
}

fn sample_frame() -> macos.Frame {
    macos.Frame { closed: false, width: 1000, height: 800, pixel_width: 2000, pixel_height: 1600,
        scale: 2.0, time: 0.05, pointer_x: 600.0, pointer_y: 424.0, pointer_down: false,
        key: -1, resized: false }
}

@test fn input_controls_pause_palette_and_drag_in_logical_points() {
    var state := initial()
    var frame := sample_frame()
    update(&mut state, frame)
    state.time == 0.05
    frame.key = 49
    frame.time = 0.10
    update(&mut state, frame)
    state.motion == .Paused
    state.time == 0.05
    frame.key = 8
    update(&mut state, frame)
    state.palette == .Ember
    frame.key = -1
    frame.pointer_down = true
    update(&mut state, frame)
    state.dragging
    frame.pointer_x = 700.0
    frame.pointer_y = 504.0
    update(&mut state, frame)
    (state.center_x - 0.70).abs() < 0.000001
    (state.center_y - 0.63).abs() < 0.000001
    frame.pointer_down = false
    update(&mut state, frame)
    !state.dragging
    frame.key = 15
    update(&mut state, frame)
    state.center_x == 0.60
    state.center_y == 0.53
}

@test fn scene_reuses_storage_and_emits_finite_triangle_geometry() {
    state := initial()
    frame := sample_frame()
    var vertices: []f32 = []
    vertices.reserve(40000)
    render(&mut vertices, state, frame)
    count := vertices.len
    count > 1000
    count % 24 == 0
    for value in vertices { value.is_finite() }
    capacity := vertices.cap()
    render(&mut vertices, state, frame)
    vertices.len == count
    vertices.cap() == capacity
    vertices[2] == 0.0
    vertices[3] == 1.0
}
