capability unsafe
import std.macos as macos
import std.macos.objc as objc

// Run in a logged-in macOS session. Events are queued on this application's
// actual NSWindow. No global event injection or accessibility permission is used.
@extern("/usr/lib/libobjc.A.dylib", "objc_msgSend")
unsafe fn post(application: ptr, method: ptr, event: ptr, at_start: u8)

@extern("/usr/lib/libobjc.A.dylib", "objc_msgSend")
unsafe fn key_event(class: ptr, method: ptr, kind: u64, location: objc.Pair, flags: u64,
                    timestamp: f64, window: i64, context: ptr, characters: ptr,
                    unmodified: ptr, repeating: u8, keycode: u16) -> ptr

@extern("/usr/lib/libobjc.A.dylib", "objc_msgSend")
unsafe fn mouse_event(class: ptr, method: ptr, kind: u64, location: objc.Pair, flags: u64,
                      timestamp: f64, window: i64, context: ptr, number: i64,
                      clicks: i64, pressure: f32) -> ptr

unsafe fn send_key(application: ptr, window: i64, text: ptr, code: u16) {
    selector := objc.selector(cstr("keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:"))
    event := key_event(objc.class_named(cstr("NSEvent")), selector, 10, objc.Pair {x: 0.0, y: 0.0},
                      0, 0.0, window, ptr(0), text, text, 0, code)
    assert(event != ptr(0))
    post(application, objc.selector(cstr("postEvent:atStart:")), event, 1)
}

unsafe fn send_mouse(application: ptr, window: i64, kind: u64, x: f64, y: f64) {
    selector := objc.selector(cstr("mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:"))
    event := mouse_event(objc.class_named(cstr("NSEvent")), selector, kind, objc.Pair {x: x, y: y},
                        0, 0.0, window, ptr(0), 1, 1, 1.0)
    assert(event != ptr(0))
    post(application, objc.selector(cstr("postEvent:atStart:")), event, 1)
}

fn main() {
    opened := macos.open("Dunder event regression", 400, 260)
    assert(opened.ok)
    initial := macos.poll(opened.window)
    assert(initial.width == 400 && initial.height == 260)
    unsafe {
        app := objc.get(objc.class_named(cstr("NSApplication")), cstr("sharedApplication"))
        window := objc.get(objc.get(app, cstr("orderedWindows")), cstr("firstObject"))
        assert(window != ptr(0))
        number := i64(objc.get_word(window, cstr("windowNumber")))
        objc.set_pair(window, cstr("setContentSize:"), objc.Pair {x: 320.0, y: 220.0})
        frame := macos.poll(opened.window)
        assert(frame.resized && frame.width == 320 && frame.height == 220)

        // postEvent:atStart: puts the last event at the head of the queue.
        send_key(app, number, objc.named_string(cstr("r")), 15)
        send_key(app, number, objc.named_string(cstr("c")), 8)
        assert(macos.poll(opened.window).key == 8)
        assert(macos.poll(opened.window).key == 15)
        send_mouse(app, number, 2, 115.0, 135.0)
        send_mouse(app, number, 6, 95.0, 125.0)
        send_mouse(app, number, 1, 45.0, 50.0)
        press := macos.poll(opened.window)
        assert(press.pointer_down && press.pointer_x == 45.0 && press.pointer_y == 170.0)
        drag := macos.poll(opened.window)
        assert(drag.pointer_down && drag.pointer_x == 95.0 && drag.pointer_y == 95.0)
        release := macos.poll(opened.window)
        assert(!release.pointer_down && release.pointer_x == 115.0 && release.pointer_y == 85.0)

        objc.action(window, cstr("close"))
        assert(macos.poll(opened.window).closed)
    }
    macos.close(opened.window)
    print("native event sequence ok")
}
