// Range reduction and a short polynomial keep this animation entirely Dunder.
pub fn sin(angle: f64) -> f64 {
    tau := 6.283185307179586
    pi := 3.141592653589793
    var x := angle - (angle / tau).floor() * tau
    if x > pi { x = x - tau }
    if x > pi / 2.0 { x = pi - x }
    if x < -pi / 2.0 { x = -pi - x }
    xx := x * x
    x * (1.0 + xx * (-1.0 / 6.0 + xx * (1.0 / 120.0 + xx * (-1.0 / 5040.0 + xx * (1.0 / 362880.0 + xx * (-1.0 / 39916800.0))))))
}
pub fn cos(angle: f64) -> f64 { sin(angle + 1.5707963267948966) }
pub fn clamp(value: f64, low: f64, high: f64) -> f64 {
    if value < low { low }
    else if value > high { high }
    else { value }
}

@test fn animation_math_reduces_both_angle_directions() {
    sin(0.0) == 0.0
    (sin(1.5707963267948966) - 1.0).abs() < 0.000001
    sin(3.141592653589793).abs() < 0.000001
    (sin(-1.5707963267948966) + 1.0).abs() < 0.000001
    (sin(6.283185307179586 + 0.3) - sin(0.3)).abs() < 0.000001
    (sin(-6.283185307179586 - 0.3) + sin(0.3)).abs() < 0.000001
    (cos(0.0) - 1.0).abs() < 0.000001
    clamp(-1.0, 0.0, 1.0) == 0.0
    clamp(0.5, 0.0, 1.0) == 0.5
    clamp(2.0, 0.0, 1.0) == 1.0
}
