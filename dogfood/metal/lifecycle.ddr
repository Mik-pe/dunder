// Manual native GUI regression: opens and closes real windows on Apple Silicon.
// Run from a logged-in macOS desktop; success prints lifecycle cycles=3.
import std.macos as macos

fn reject_geometry(window: macos.Window, expected_frames: i64) {
    var malformed: []f32 = [0.0]
    partial := macos.draw(window, &malformed, 0.0, 0.0, 0.0)
    assert(!partial.ok && partial.error != "")
    assert(partial.frames == expected_frames)

    malformed.clear()
    // One complete vertex is not a complete triangle.
    macos.vertex(&mut malformed,
        macos.Point { x: 0.0, y: 0.0 }, macos.rgb(1.0, 1.0, 1.0))
    nontriangle := macos.draw(window, &malformed, 0.0, 0.0, 0.0)
    assert(!nontriangle.ok && nontriangle.error != "")
    assert(nontriangle.frames == expected_frames)

    malformed.clear()
    // 100002 complete vertices: divisible by three but above the 100000 cap.
    malformed.reserve(800016)
    for index in 0..800016 { malformed.push(0.0) }
    oversized := macos.draw(window, &malformed, 0.0, 0.0, 0.0)
    assert(!oversized.ok && oversized.error != "")
    assert(oversized.frames == expected_frames)
}

fn main() {
    zero := macos.open("invalid zero", 0, 600)
    negative := macos.open("invalid negative", 600, -1)
    excessive := macos.open("invalid excessive", 16385, 600)
    assert(!zero.ok && zero.window.id == 0)
    assert(!negative.ok && negative.window.id == 0)
    assert(!excessive.ok && excessive.window.id == 0)

    var generation: i64 = 0
    var cycles := 0
    while cycles < 3 {
        opened := macos.open("Dunder window lifecycle", 640, 480)
        assert(opened.ok)
        assert(opened.window.id > generation)
        generation = opened.window.id
        occupied := macos.open("duplicate", 320, 240)
        assert(!occupied.ok && occupied.window.id == 0)

        frame := macos.poll(opened.window)
        assert(!frame.closed)
        assert(frame.width == 640 && frame.height == 480)
        assert(frame.pixel_width > 0 && frame.pixel_height > 0)
        assert(frame.scale > 0.0 && frame.time >= 0.0)
        assert(frame.pixel_width == i32(f64(frame.width) * frame.scale))
        assert(frame.pixel_height == i32(f64(frame.height) * frame.scale))
        assert(frame.key == -1 && !frame.pointer_down)
        assert(frame.resized)

        var vertices: []f32 = []
        first := macos.draw(opened.window, &vertices, 0.15, 0.25, 0.35)
        assert(first.ok && first.frames == 1)
        second := macos.draw(opened.window, &vertices, 0.25, 0.15, 0.35)
        assert(second.ok && second.frames == first.frames + 1)
        reject_geometry(opened.window, second.frames)

        // Rejected geometry must leave the window and GPU submission usable.
        macos.triangle(&mut vertices,
            macos.Point { x: -0.5, y: -0.5 },
            macos.Point { x: 0.5, y: -0.5 },
            macos.Point { x: 0.0, y: 0.5 }, macos.rgb(0.3, 0.8, 0.6))
        recovered := macos.draw(opened.window, &vertices, 0.05, 0.05, 0.05)
        assert(recovered.ok && recovered.frames == second.frames + 1)
        later := macos.poll(opened.window)
        assert(!later.closed && later.time >= frame.time && !later.resized)

        macos.close(opened.window)
        macos.close(opened.window)
        stale := macos.poll(opened.window)
        assert(stale.closed && stale.key == -1)
        replacement := macos.open("Dunder replacement", 320, 240)
        assert(replacement.ok && replacement.window.id > generation)
        // A stale close cannot close the replacement window.
        macos.close(opened.window)
        current := macos.poll(replacement.window)
        assert(!current.closed && current.width == 320 && current.height == 240)
        replacement_first := macos.draw(replacement.window, &vertices, 0.0, 0.1, 0.2)
        assert(replacement_first.ok && replacement_first.frames == 1)

        rejected := macos.draw(opened.window, &vertices, 0.0, 0.0, 0.0)
        assert(!rejected.ok && rejected.error != "" && rejected.frames == 0)
        fabricated := macos.Window { id: -1 }
        macos.close(fabricated)
        assert(macos.poll(fabricated).closed)
        replacement_second := macos.draw(replacement.window, &vertices, 0.2, 0.1, 0.0)
        assert(replacement_second.ok && replacement_second.frames == replacement_first.frames + 1)
        macos.close(replacement.window)
        generation = replacement.window.id
        cycles = cycles + 1
    }
    print("lifecycle cycles=" + cycles.str())
}
