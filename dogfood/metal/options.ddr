import sys
import std.parse as parse

// Zero means interactive. A positive limit makes smoke runs self-terminating.
pub fn frame_limit() -> i64 {
    var limit: i64 = 0
    var index := 1
    while index < sys.arg_count() {
        argument := sys.arg(index)
        if argument == "--frames" {
            assert(index + 1 < sys.arg_count())
            parsed := parse.integer(sys.arg(index + 1))
            assert(parsed.ok && parsed.value > 0)
            limit = parsed.value
            index = index + 2
        } else {
            print("unknown argument: " + argument)
            assert(false)
        }
    }
    limit
}
