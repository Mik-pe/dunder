// Each node occupies [value, left_handle, right_handle]. -1 is an empty link.
pub fn total(nodes: [i32; 96], root: i32) -> i32 {
    if root < 0 { return 0 }
    return nodes[root] + total(nodes, nodes[root + 1]) + total(nodes, nodes[root + 2])
}

pub fn height(nodes: [i32; 96], root: i32) -> i32 {
    if root < 0 { return 0 }
    left := height(nodes, nodes[root + 1])
    right := height(nodes, nodes[root + 2])
    if left > right { return left + 1 }
    return right + 1
}

@test
fn empty_tree_has_zero_height() {
    nodes := [0; 96]
    assert(total(nodes, -1) == 0)
    assert(height(nodes, -1) == 0)
}
