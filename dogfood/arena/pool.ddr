// Reserve a contiguous block in a fixed-capacity, index-based bump arena.
// The caller keeps the old cursor as its handle and adopts the new cursor.
pub fn reserve(used: i32, count: i32, capacity: i32) -> i32 {
    if used < 0 || count < 0 || used > capacity || count > capacity - used {
        return -1
    }
    return used + count
}

@test
fn capacity_is_checked() {
    assert(reserve(0, 3, 8) == 3)
    assert(reserve(3, 5, 8) == 8)
    assert(reserve(8, 1, 8) == -1)
    assert(reserve(0, -1, 8) == -1)
}
