import pool
import tree

pub fn tree_sum() -> i32 {
    var nodes := [0; 96]
    var used := 0
    for node in 0..7 {
        next := pool.reserve(used, 3, len(nodes))
        assert(next >= 0)
        var left := -1
        var right := -1
        if node * 2 + 1 < 7 { left = (node * 2 + 1) * 3 }
        if node * 2 + 2 < 7 { right = (node * 2 + 2) * 3 }
        nodes[used] = node + 1
        nodes[used + 1] = left
        nodes[used + 2] = right
        used = next
    }
    assert(used == 21)
    assert(tree.height(nodes, 0) == 3)
    assert(pool.reserve(used, 96, len(nodes)) == -1)
    return tree.total(nodes, 0)
}

fn main() { print(tree_sum()) }

@test
fn allocated_tree_can_be_traversed() {
    assert(tree_sum() == 28)
}
