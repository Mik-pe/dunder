import math

// Fourth-order Runge-Kutta for dx/dt = derivative(x), with typed callbacks.
pub fn integrate(derivative: fn(f64) -> f64, initial: f64, duration: f64, steps: i32) -> f64 {
    assert(steps > 0 && duration.is_finite())
    h := duration / f64(steps)
    var value := initial
    for step in 0..steps {
        k1 := derivative(value)
        k2 := derivative(value + h * k1 / 2.0)
        k3 := derivative(value + h * k2 / 2.0)
        k4 := derivative(value + h * k3)
        value = value + h * (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0
    }
    value
}

fn decay(value: f64) -> f64 { -value }

@test fn numerical_integration_converges() {
    math.near(integrate(decay, 1.0, 1.0, 100), 0.36787944117144233, 4e-11, 0.0)
    math.near(integrate(decay, 1.0, 1.0, 1000), 0.36787944117144233, 1e-14, 0.0)
    integrate(decay, 1.0, 0.0, 10) == 1.0
}
