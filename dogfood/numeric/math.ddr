pub struct Vec2 { x: f32, y: f32 }

@test {
    (Vec2 { x: 3.0, y: 4.0 }) -> 5.0
    (Vec2 { x: 0.0, y: 0.0 }) -> 0.0
}
pub fn length(v: Vec2) -> f32 {
    f32(hypot(f64(v.x), f64(v.y)))
}

pub fn near(a: f64, b: f64, absolute: f64, relative: f64) -> bool {
    assert(absolute >= 0.0 && relative >= 0.0)
    if a == b { return true }
    if !a.is_finite() || !b.is_finite() { return false }
    difference := (a - b).abs()
    if difference <= absolute { return true }
    var scale := a.abs()
    if b.abs() > scale { scale = b.abs() }
    difference / scale <= relative
}

// Rescale before squaring to avoid overflow/underflow in the intermediate.
@test {
    (3.0, 4.0) -> 5.0
    (0.0, 0.0) -> 0.0
    (-3.0, -4.0) -> 5.0
    near(hypot(1e308, 1e308), 1.4142135623730951e308, 0.0, 1e-15)
    near(hypot(1e-300, 1e-300), 1.414213562373095e-300, 0.0, 1e-15)
}
pub fn hypot(x: f64, y: f64) -> f64 {
    if x.is_infinite() || y.is_infinite() { return 1.0 / 0.0 }
    if x.is_nan() || y.is_nan() { return x + y }
    var a := x.abs()
    var b := y.abs()
    if a < b { previous := a; a = b; b = previous }
    if a == 0.0 { return 0.0 }
    ratio := b / a
    a * (1.0 + ratio * ratio).sqrt()
}

@test {
    ([1.0, 2.0, 3.0, 4.0]) -> 10.0
    ([1e16, 1.0, 1.0, -1e16]) -> 2.0
}
pub fn compensated_sum(values: [f64; 4]) -> f64 {
    var total := 0.0
    var correction := 0.0
    for value in values.iter() {
        adjusted := value - correction
        next := total + adjusted
        correction = (next - total) - adjusted
        total = next
    }
    total
}

@test fn comparisons_cover_ieee_values_and_tolerances() {
    nan := 0.0 / 0.0
    inf := 1.0 / 0.0
    !near(nan, nan, 1.0, 1.0)
    near(inf, inf, 0.0, 0.0)
    !near(inf, -inf, 1.0, 1.0)
    near(0.1 + 0.2, 0.3, 1e-15, 1e-15)
    !near(0.1 + 0.2, 0.3, 0.0, 0.0)
    near(-0.0, 0.0, 0.0, 0.0)
}
