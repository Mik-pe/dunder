import math
import ode

fn bisect(function: fn(f64) -> f64, start: f64, end: f64) -> f64 {
    var low := start
    var high := end
    var low_value := function(low)
    high_value := function(high)
    assert(low.is_finite() && high.is_finite() && low < high)
    assert((low_value <= 0.0 && high_value >= 0.0) || (low_value >= 0.0 && high_value <= 0.0))
    for iteration in 0..80 {
        middle := low + (high - low) / 2.0
        value := function(middle)
        if value == 0.0 { return middle }
        if (value < 0.0) == (low_value < 0.0) { low = middle; low_value = value }
        else { high = middle }
    }
    low + (high - low) / 2.0
}

fn square_minus_two(x: f64) -> f64 { x * x - 2.0 }

@test fn bisection_finds_a_root() {
    root := bisect(square_minus_two, 0.0, 2.0)
    math.near(root, 1.4142135623730951, 1e-15, 0.0)
    math.near(root * root, 2.0, 1e-15, 0.0)
}

@test fn precision_is_explicit() {
    narrow: f32 = 16777216.0
    wide: f64 = 16777216.0
    narrow + 1.0 == narrow
    wide + 1.0 != wide
    step := f32.from_bits(1)
    step > 0.0
    step / 2.0 == 0.0
    (-0.0).is_sign_negative()
    f32(0.1).str() == "0.1"
}

fn main() {
    point := math.Vec2 { x: 3.0, y: 4.0 }
    print(math.length(point))
    print(math.compensated_sum([1e16, 1.0, 1.0, -1e16]))
    print(math.near(bisect(square_minus_two, 0.0, 2.0), 2.0.sqrt(), 1e-15, 0.0))
}
