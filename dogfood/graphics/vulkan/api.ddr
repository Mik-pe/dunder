capability unsafe

import std.dl as dl

// Vulkan 1.0 loader entry points, resolved once before the first driver call.
@c_layout
pub struct Api {
    CreateInstance: extern fn(ptr, ptr, ptr) -> i32,
    EnumeratePhysicalDevices: extern fn(ptr, ptr, ptr) -> i32,
    GetPhysicalDeviceProperties: extern fn(ptr, ptr),
    GetPhysicalDeviceQueueFamilyProperties: extern fn(ptr, ptr, ptr),
    GetPhysicalDeviceMemoryProperties: extern fn(ptr, ptr),
    CreateDevice: extern fn(ptr, ptr, ptr, ptr) -> i32,
    GetDeviceQueue: extern fn(ptr, u32, u32, ptr),
    CreateCommandPool: extern fn(ptr, ptr, ptr, ptr) -> i32,
    AllocateCommandBuffers: extern fn(ptr, ptr, ptr) -> i32,
    CreateImage: extern fn(ptr, ptr, ptr, ptr) -> i32,
    GetImageMemoryRequirements: extern fn(ptr, ptr, ptr),
    AllocateMemory: extern fn(ptr, ptr, ptr, ptr) -> i32,
    BindImageMemory: extern fn(ptr, ptr, ptr, u64) -> i32,
    CreateImageView: extern fn(ptr, ptr, ptr, ptr) -> i32,
    CreateRenderPass: extern fn(ptr, ptr, ptr, ptr) -> i32,
    CreateFramebuffer: extern fn(ptr, ptr, ptr, ptr) -> i32,
    CreateShaderModule: extern fn(ptr, ptr, ptr, ptr) -> i32,
    CreatePipelineLayout: extern fn(ptr, ptr, ptr, ptr) -> i32,
    CreateGraphicsPipelines: extern fn(ptr, ptr, u32, ptr, ptr, ptr) -> i32,
    CreateBuffer: extern fn(ptr, ptr, ptr, ptr) -> i32,
    GetBufferMemoryRequirements: extern fn(ptr, ptr, ptr),
    BindBufferMemory: extern fn(ptr, ptr, ptr, u64) -> i32,
    MapMemory: extern fn(ptr, ptr, u64, u64, u32, ptr) -> i32,
    ResetCommandBuffer: extern fn(ptr, u32) -> i32,
    BeginCommandBuffer: extern fn(ptr, ptr) -> i32,
    CmdBeginRenderPass: extern fn(ptr, ptr, u32),
    CmdBindPipeline: extern fn(ptr, u32, ptr),
    CmdBindVertexBuffers: extern fn(ptr, u32, u32, ptr, ptr),
    CmdDraw: extern fn(ptr, u32, u32, u32, u32),
    CmdEndRenderPass: extern fn(ptr),
    CmdCopyImageToBuffer: extern fn(ptr, ptr, u32, ptr, u32, ptr),
    EndCommandBuffer: extern fn(ptr) -> i32,
    QueueSubmit: extern fn(ptr, u32, ptr, ptr) -> i32,
    QueueWaitIdle: extern fn(ptr) -> i32,
    DeviceWaitIdle: extern fn(ptr) -> i32,
    DestroyBuffer: extern fn(ptr, ptr, ptr),
    FreeMemory: extern fn(ptr, ptr, ptr),
    DestroyFramebuffer: extern fn(ptr, ptr, ptr),
    DestroyPipeline: extern fn(ptr, ptr, ptr),
    DestroyPipelineLayout: extern fn(ptr, ptr, ptr),
    DestroyShaderModule: extern fn(ptr, ptr, ptr),
    DestroyRenderPass: extern fn(ptr, ptr, ptr),
    DestroyImageView: extern fn(ptr, ptr, ptr),
    DestroyImage: extern fn(ptr, ptr, ptr),
    DestroyCommandPool: extern fn(ptr, ptr, ptr),
    DestroyDevice: extern fn(ptr, ptr),
    DestroyInstance: extern fn(ptr, ptr),
    UnmapMemory: extern fn(ptr, ptr),
    CmdPipelineBarrier: extern fn(ptr, u32, u32, u32, u32, ptr, u32, ptr, u32, ptr),
}

pub unsafe fn load(api: &mut Api, library: ptr) -> bool {
    var symbol := ptr(0)
    symbol = dl.symbol(library, cstr("vkCreateInstance"))
    if symbol == ptr(0) { return false }
    api.CreateInstance = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkEnumeratePhysicalDevices"))
    if symbol == ptr(0) { return false }
    api.EnumeratePhysicalDevices = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkGetPhysicalDeviceProperties"))
    if symbol == ptr(0) { return false }
    api.GetPhysicalDeviceProperties = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkGetPhysicalDeviceQueueFamilyProperties"))
    if symbol == ptr(0) { return false }
    api.GetPhysicalDeviceQueueFamilyProperties = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkGetPhysicalDeviceMemoryProperties"))
    if symbol == ptr(0) { return false }
    api.GetPhysicalDeviceMemoryProperties = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateDevice"))
    if symbol == ptr(0) { return false }
    api.CreateDevice = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkGetDeviceQueue"))
    if symbol == ptr(0) { return false }
    api.GetDeviceQueue = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateCommandPool"))
    if symbol == ptr(0) { return false }
    api.CreateCommandPool = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkAllocateCommandBuffers"))
    if symbol == ptr(0) { return false }
    api.AllocateCommandBuffers = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateImage"))
    if symbol == ptr(0) { return false }
    api.CreateImage = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkGetImageMemoryRequirements"))
    if symbol == ptr(0) { return false }
    api.GetImageMemoryRequirements = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkAllocateMemory"))
    if symbol == ptr(0) { return false }
    api.AllocateMemory = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkBindImageMemory"))
    if symbol == ptr(0) { return false }
    api.BindImageMemory = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateImageView"))
    if symbol == ptr(0) { return false }
    api.CreateImageView = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateRenderPass"))
    if symbol == ptr(0) { return false }
    api.CreateRenderPass = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateFramebuffer"))
    if symbol == ptr(0) { return false }
    api.CreateFramebuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateShaderModule"))
    if symbol == ptr(0) { return false }
    api.CreateShaderModule = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreatePipelineLayout"))
    if symbol == ptr(0) { return false }
    api.CreatePipelineLayout = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateGraphicsPipelines"))
    if symbol == ptr(0) { return false }
    api.CreateGraphicsPipelines = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCreateBuffer"))
    if symbol == ptr(0) { return false }
    api.CreateBuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkGetBufferMemoryRequirements"))
    if symbol == ptr(0) { return false }
    api.GetBufferMemoryRequirements = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkBindBufferMemory"))
    if symbol == ptr(0) { return false }
    api.BindBufferMemory = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkMapMemory"))
    if symbol == ptr(0) { return false }
    api.MapMemory = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkResetCommandBuffer"))
    if symbol == ptr(0) { return false }
    api.ResetCommandBuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkBeginCommandBuffer"))
    if symbol == ptr(0) { return false }
    api.BeginCommandBuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCmdBeginRenderPass"))
    if symbol == ptr(0) { return false }
    api.CmdBeginRenderPass = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCmdBindPipeline"))
    if symbol == ptr(0) { return false }
    api.CmdBindPipeline = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCmdBindVertexBuffers"))
    if symbol == ptr(0) { return false }
    api.CmdBindVertexBuffers = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCmdDraw"))
    if symbol == ptr(0) { return false }
    api.CmdDraw = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCmdEndRenderPass"))
    if symbol == ptr(0) { return false }
    api.CmdEndRenderPass = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCmdCopyImageToBuffer"))
    if symbol == ptr(0) { return false }
    api.CmdCopyImageToBuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkEndCommandBuffer"))
    if symbol == ptr(0) { return false }
    api.EndCommandBuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkQueueSubmit"))
    if symbol == ptr(0) { return false }
    api.QueueSubmit = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkQueueWaitIdle"))
    if symbol == ptr(0) { return false }
    api.QueueWaitIdle = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDeviceWaitIdle"))
    if symbol == ptr(0) { return false }
    api.DeviceWaitIdle = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyBuffer"))
    if symbol == ptr(0) { return false }
    api.DestroyBuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkFreeMemory"))
    if symbol == ptr(0) { return false }
    api.FreeMemory = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyFramebuffer"))
    if symbol == ptr(0) { return false }
    api.DestroyFramebuffer = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyPipeline"))
    if symbol == ptr(0) { return false }
    api.DestroyPipeline = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyPipelineLayout"))
    if symbol == ptr(0) { return false }
    api.DestroyPipelineLayout = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyShaderModule"))
    if symbol == ptr(0) { return false }
    api.DestroyShaderModule = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyRenderPass"))
    if symbol == ptr(0) { return false }
    api.DestroyRenderPass = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyImageView"))
    if symbol == ptr(0) { return false }
    api.DestroyImageView = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyImage"))
    if symbol == ptr(0) { return false }
    api.DestroyImage = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyCommandPool"))
    if symbol == ptr(0) { return false }
    api.DestroyCommandPool = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyDevice"))
    if symbol == ptr(0) { return false }
    api.DestroyDevice = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkDestroyInstance"))
    if symbol == ptr(0) { return false }
    api.DestroyInstance = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkUnmapMemory"))
    if symbol == ptr(0) { return false }
    api.UnmapMemory = ffi_fn(symbol)
    symbol = dl.symbol(library, cstr("vkCmdPipelineBarrier"))
    if symbol == ptr(0) { return false }
    api.CmdPipelineBarrier = ffi_fn(symbol)
    true
}
