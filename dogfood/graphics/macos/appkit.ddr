capability unsafe
import std.dl as dl
import .objc as o
import .renderer as metal

pub unsafe fn resize(s: &mut metal.State) {
    if s.view == ptr(0) || s.layer == ptr(0) { return }
    bounds := o.get_rect(s.view, cstr("bounds"))
    backing := o.convert_rect(s.view, cstr("convertRectToBacking:"), bounds)
    width := i32(bounds.w.round_ties_even())
    height := i32(bounds.h.round_ties_even())
    pixelsX := i32(backing.w.round_ties_even())
    pixelsY := i32(backing.h.round_ties_even())
    scale := o.get_double(s.window, cstr("backingScaleFactor"))
    if s.width != width || s.height != height || s.pixelWidth != pixelsX || s.pixelHeight != pixelsY || s.scale != scale { s.resized = 1 }
    s.width = width
    s.height = height
    s.pixelWidth = pixelsX
    s.pixelHeight = pixelsY
    s.logicalWidth = bounds.w
    s.logicalHeight = bounds.h
    s.scale = scale
    transaction := o.class_named(cstr("CATransaction"))
    o.action(transaction, cstr("begin"))
    o.set_flag(transaction, cstr("setDisableActions:"), 1)
    o.set_rect(s.layer, cstr("setFrame:"), bounds)
    o.set_double(s.layer, cstr("setContentsScale:"), scale)
    o.set_pair(s.layer, cstr("setDrawableSize:"), o.Pair {x: f64(pixelsX), y: f64(pixelsY)})
    o.action(transaction, cstr("commit"))
}

unsafe fn mark_closed(s: &mut metal.State) { s.closed = 1; s.down = 0 }
unsafe fn clear_pointer(s: &mut metal.State) { s.down = 0 }
unsafe fn closed(receiver: ptr, action: ptr, notice: ptr) { mark_closed(ref_at(metal.state())) }
unsafe fn resigned(receiver: ptr, action: ptr, notice: ptr) { clear_pointer(ref_at(metal.state())) }
unsafe fn terminate(receiver: ptr, action: ptr, sender: ptr) -> usize {
    mark_closed(ref_at(metal.state()))
    return 0
}
unsafe fn redraw(s: &mut metal.State) {
    if s.active == 0 || s.closed != 0 { return }
    resize(&mut s)
    if s.vertexCount != 0 { drawn := metal.render(&mut s) }
}
unsafe fn resized(receiver: ptr, action: ptr, notice: ptr) { redraw(ref_at(metal.state())) }

unsafe fn register_delegate() -> ptr {
    cls := o.allocate_class(o.class_named(cstr("NSObject")), cstr("DunderNativeWindowDelegateV1"), 0)
    if cls == ptr(0) { return ptr(0) }
    if o.add_method(cls, o.selector(cstr("windowWillClose:")), callback(closed), cstr("v@:@")) == 0 ||
        o.add_method(cls, o.selector(cstr("windowDidResize:")), callback(resized), cstr("v@:@")) == 0 ||
        o.add_method(cls, o.selector(cstr("windowDidChangeBackingProperties:")), callback(resized), cstr("v@:@")) == 0 ||
        o.add_method(cls, o.selector(cstr("windowDidResignKey:")), callback(resigned), cstr("v@:@")) == 0 ||
        o.add_method(cls, o.selector(cstr("applicationDidResignActive:")), callback(resigned), cstr("v@:@")) == 0 ||
        o.add_terminate(cls, o.selector(cstr("applicationShouldTerminate:")), callback(terminate), cstr("Q@:@")) == 0 {
        o.dispose_class(cls)
        return ptr(0)
    }
    o.register_class(cls)
    cls
}

unsafe fn submenu(root: ptr, title: ptr) -> ptr {
    item := o.new_object(cstr("NSMenuItem"))
    menu := o.new_object(cstr("NSMenu"))
    o.set_object(item, cstr("setTitle:"), o.named_string(title))
    o.set_object(item, cstr("setSubmenu:"), menu)
    o.set_object(root, cstr("addItem:"), item)
    o.release(item)
    menu
}
unsafe fn menu_item(menu: ptr, title: ptr, action: ptr, key: ptr) {
    allocated := o.get(o.class_named(cstr("NSMenuItem")), cstr("alloc"))
    item := o.three_objects(allocated, cstr("initWithTitle:action:keyEquivalent:"), o.named_string(title), o.selector(action), o.named_string(key))
    o.set_object(menu, cstr("addItem:"), item)
    o.release(item)
}
unsafe fn menus(application: ptr) {
    root := o.new_object(cstr("NSMenu"))
    app := submenu(root, cstr("Dunder"))
    menu_item(app, cstr("Quit Dunder"), cstr("terminate:"), cstr("q"))
    o.release(app)
    window := submenu(root, cstr("Window"))
    menu_item(window, cstr("Minimize"), cstr("performMiniaturize:"), cstr("m"))
    menu_item(window, cstr("Close Window"), cstr("performClose:"), cstr("w"))
    o.release(window)
    o.set_object(application, cstr("setMainMenu:"), root)
    o.release(root)
}

pub unsafe fn initialize(s: &mut metal.State) -> bool {
    if s.delegateClass != ptr(0) { return true }
    // Frameworks and the application live for the entire process. Delay their
    // loading until a valid open so headless callers can validate handles.
    appkit := dl.open(cstr("/System/Library/Frameworks/AppKit.framework/AppKit"), 2)
    if appkit == ptr(0) { return false }
    quartz := dl.open(cstr("/System/Library/Frameworks/QuartzCore.framework/QuartzCore"), 2)
    gpu := dl.open(cstr("/System/Library/Frameworks/Metal.framework/Metal"), 2)
    clock := dl.symbol(quartz, cstr("CACurrentMediaTime"))
    device := dl.symbol(gpu, cstr("MTLCreateSystemDefaultDevice"))
    mode := dl.symbol(appkit, cstr("NSDefaultRunLoopMode"))
    if quartz != ptr(0) && gpu != ptr(0) && clock != ptr(0) && device != ptr(0) && mode != ptr(0) {
        s.delegateClass = register_delegate()
    }
    if s.delegateClass == ptr(0) {
        if gpu != ptr(0) { g := dl.close(gpu) }
        if quartz != ptr(0) { q := dl.close(quartz) }
        a := dl.close(appkit)
        return false
    }
    s.now = ffi_fn(clock)
    s.createDevice = ffi_fn(device)
    s.mode = load_ptr(mode)
    s.rootPool = o.pool()
    s.application = o.get(o.get(o.class_named(cstr("NSApplication")), cstr("sharedApplication")), cstr("retain"))
    accepted := o.activation_policy(s.application, o.selector(cstr("setActivationPolicy:")), 0)
    menus(s.application)
    o.action(s.application, cstr("finishLaunching"))
    true
}

unsafe fn window_title(window: ptr, title: string) -> bool {
    var bytes: []u8 = []
    bytes.reserve(title.len + 1)
    for b in title.bytes() { bytes.push(u8(b)) }
    bytes.push(0)
    allocated := o.get(o.class_named(cstr("NSString")), cstr("alloc"))
    text := o.buffer(allocated, cstr("initWithBytes:length:encoding:"), addr(&bytes[0]), usize(title.len), 4)
    if text == ptr(0) { return false }
    o.set_object(window, cstr("setTitle:"), text)
    o.release(text)
    true
}

pub unsafe fn configure(s: &mut metal.State, title: string, width: i32, height: i32) -> bool {
    bounds := o.Rect { x: 0.0, y: 0.0, w: f64(width), h: f64(height) }
    allocated := o.get(o.class_named(cstr("NSWindow")), cstr("alloc"))
    s.window = o.new_window(allocated, cstr("initWithContentRect:styleMask:backing:defer:"), bounds, 15, 2, 0)
    if s.window == ptr(0) { return false }
    o.set_flag(s.window, cstr("setReleasedWhenClosed:"), 0)
    if !window_title(s.window, title) { return false }
    o.set_pair(s.window, cstr("setContentMinSize:"), o.Pair {x:64.0, y:64.0})
    o.set_flag(s.window, cstr("setAcceptsMouseMovedEvents:"), 1)
    view := o.get(o.class_named(cstr("NSView")), cstr("alloc"))
    s.view = o.new_view(view, cstr("initWithFrame:"), bounds)
    s.layer = o.new_object(cstr("CAMetalLayer"))
    if s.view == ptr(0) || s.layer == ptr(0) { return false }
    o.set_word(s.view, cstr("setAutoresizingMask:"), 18)
    o.set_object(s.layer, cstr("setDevice:"), s.device)
    o.set_word(s.layer, cstr("setPixelFormat:"), 80)
    o.set_flag(s.layer, cstr("setFramebufferOnly:"), 1)
    o.set_object(s.view, cstr("setLayer:"), s.layer)
    o.set_flag(s.view, cstr("setWantsLayer:"), 1)
    o.set_object(s.window, cstr("setContentView:"), s.view)
    s.delegate = o.get(s.delegateClass, cstr("new"))
    if s.delegate == ptr(0) { return false }
    o.set_object(s.window, cstr("setDelegate:"), s.delegate)
    o.set_object(s.application, cstr("setDelegate:"), s.delegate)
    s.closed = 0
    s.down = 0
    s.x = 0.0
    s.y = 0.0
    s.key = -1
    s.resized = 1
    s.frames = 0
    s.generation = s.generation + 1
    s.active = 1
    o.action(s.window, cstr("center"))
    o.set_object(s.window, cstr("makeKeyAndOrderFront:"), ptr(0))
    o.set_flag(s.application, cstr("activateIgnoringOtherApps:"), 1)
    resize(&mut s)
    s.start = s.now()
    true
}

pub unsafe fn destroy(s: &mut metal.State) {
    s.active = 0
    s.closed = 1
    s.down = 0
    o.set_object(s.application, cstr("setDelegate:"), ptr(0))
    o.set_object(s.window, cstr("setDelegate:"), ptr(0))
    o.action(s.window, cstr("close"))
    o.set_object(s.view, cstr("setLayer:"), ptr(0))
    o.release(s.buffer); s.buffer = ptr(0)
    o.release(s.pipeline); s.pipeline = ptr(0)
    o.release(s.queue); s.queue = ptr(0)
    o.release(s.device); s.device = ptr(0)
    o.release(s.window); s.window = ptr(0)
    o.release(s.view); s.view = ptr(0)
    o.release(s.layer); s.layer = ptr(0)
    o.release(s.delegate); s.delegate = ptr(0)
    s.vertexCount = 0
}

pub unsafe fn poll(s: &mut metal.State) {
    s.key = -1
    if s.closed != 0 { return }
    pool := o.pool()
    var date := o.get_date(o.class_named(cstr("NSDate")), cstr("dateWithTimeIntervalSinceNow:"), 0.008)
    for i in 0..256 {
        event := o.next_event(s.application, cstr("nextEventMatchingMask:untilDate:inMode:dequeue:"), u64(0).bit_not(), date, s.mode, 1)
        if event == ptr(0) { break }
        date = ptr(0)
        if o.get(event, cstr("window")) == s.window {
            kind := o.get_word(event, cstr("type"))
            if kind == 10 {
                if o.get_word(event, cstr("modifierFlags")).bit_and(1048576) == 0 {
                    s.key = i32(o.get_key(event, cstr("keyCode")))
                    break
                }
                chars := o.get(event, cstr("charactersIgnoringModifiers"))
                if o.get_word(chars, cstr("length")) != 0 {
                    c := o.character(chars, cstr("characterAtIndex:"), 0)
                    if c == 113 || c == 81 || c == 119 || c == 87 {
                        mark_closed(&mut s)
                        o.action(s.window, cstr("close"))
                        break
                    }
                }
            }
            if kind == 1 || kind == 2 || kind == 5 || kind == 6 {
                win := o.get_pair(event, cstr("locationInWindow"))
                p := o.convert_point(s.view, cstr("convertPoint:fromView:"), win, ptr(0))
                s.x = p.x
                s.y = s.logicalHeight - p.y
                if kind == 2 { s.down = 0 }
                if kind == 1 && s.x >= 0.0 && s.y >= 0.0 && s.x < s.logicalWidth && s.y < s.logicalHeight { s.down = 1 }
                o.set_object(s.application, cstr("sendEvent:"), event)
                if kind != 5 { break }
                continue
            }
        }
        o.set_object(s.application, cstr("sendEvent:"), event)
        if s.closed != 0 { break }
    }
    o.action(s.application, cstr("updateWindows"))
    resize(&mut s)
    o.drain(pool)
}
