// A bounded declaration catalog of already-verified scalar return expressions.
// This module neither resolves source calls nor evaluates source arguments.
// The producer excludes unsafe/foreign/test declarations and supplies models
// validated before and after optimization. Source activation is opt-in; eager
// argument evaluation and declaration resolution belong to the frontend.
import opt_ir as ir
import opt_alloc as alloc
import opt_emit as emit
import arm64 as arm
import std.bytes as bytes
import std.sha256 as sha

pub opaque struct Catalog {
    nodes: ir.Nodes, declarations: []i32, roots: []i32, firsts: []i32, counts: []i32,
    param_starts: []i32, param_counts: []i32, param_types: []i32, returns: []i32,
    body_digests: []string, costs: []i32,
    node_limit: i32, work_limit: i32, entry_limit: i32, work: i32,
    last: i32, valid: bool, sealed: bool, exhausted: bool, generation: i64, stamp: string, source_fingerprint: string,
}
pub opaque struct Workspace {
    plan: alloc.Plan, types: []i32, ready: bool, generation: i64, stamp: string,
    entry: i32, declaration: i32, root: i32, cost: i32, platform: i32, settings: emit.Options,
}
pub fn new() -> Catalog {
    Catalog { nodes: ir.new_nodes(), declarations: [], roots: [], firsts: [], counts: [],
        param_starts: [], param_counts: [], param_types: [], returns: [], body_digests: [], costs: [],
        node_limit: 4096, work_limit: 65536, entry_limit: 256, work: 0,
        last: -1, valid: true, sealed: false, exhausted: false, generation: 0, stamp: "", source_fingerprint: "" }
}
pub fn workspace() -> Workspace { Workspace { plan: alloc.new(), types: [], ready: false,
    generation: -1, stamp: "", entry: -1, declaration: -1, root: -1, cost: 0, platform: -1, settings: emit.options() } }
// Configure once per compilation. The frontend then threads only the immutable
// catalog and mutable workspace; expression emission borrows settings shared.
pub fn configure(w: &mut Workspace, const_div_enabled: bool, frame_free_enabled: bool) {
    w.settings.const_div_enabled = const_div_enabled; w.settings.frame_free_enabled = frame_free_enabled
}
pub fn reset(c: &mut Catalog, nodes: i32, work: i32, entries: i32) {
    assert(nodes >= 0 && nodes <= 4096 && work >= 0 && work <= 65536 && entries >= 0 && entries <= 256)
    ir.reset_nodes(&mut c.nodes)
    c.declarations.clear(); c.roots.clear(); c.firsts.clear(); c.counts.clear()
    c.param_starts.clear(); c.param_counts.clear(); c.param_types.clear(); c.returns.clear()
    c.body_digests.clear(); c.costs.clear()
    c.node_limit = nodes; c.work_limit = work; c.entry_limit = entries; c.work = 0
    c.last = -1; c.valid = true; c.sealed = false; c.exhausted = false
    c.generation = c.generation + 1; c.stamp = ""; c.source_fingerprint = ""
}
pub fn count(c: &Catalog) -> i32 { c.declarations.len }
pub fn node_count(c: &Catalog) -> i32 { c.nodes.kinds.len }
pub fn units(c: &Catalog) -> i32 { c.work }
pub fn exhausted(c: &Catalog) -> bool { c.exhausted }
fn begin(c: &mut Catalog, declaration: i32) -> bool {
    if !c.valid { return false }
    if c.sealed || declaration < 0 || declaration <= c.last { c.valid = false; c.stamp = ""; return false }
    c.last = declaration
    if c.work >= c.work_limit { c.exhausted = true; return false }
    c.work = c.work + 1; true
}
pub fn reject(c: &mut Catalog, declaration: i32) { advanced := begin(&mut c, declaration) }
fn expression_node(nodes: &ir.Nodes, at: i32, block: i32, returned: i32) -> bool {
    at >= 0 && at < nodes.kinds.len && at != block && at != returned
}
fn relocated(at: i32, first: i32, block: i32, returned: i32) -> i32 {
    if at < 0 { return -1 }
    var offset := at
    if at > block { offset = offset - 1 }
    if at > returned { offset = offset - 1 }
    first + offset
}
fn valid_digest(digest: string) -> bool {
    if digest == "" { return true }
    if digest.len != 64 { return false }
    for byte in digest.bytes() { if (byte < 48 || byte > 57) && (byte < 97 || byte > 102) { return false } }
    true
}
// A false result appends no nodes or entry. The declaration/order/work decision
// is still consumed, so a source model is never reparsed by retrying admission.
// The producer separately budgets source parsing and runs opt_verify before
// and after optimization; supported=true alone is not a graph certificate.
pub fn add_verified(c: &mut Catalog, declaration: i32, f: &ir.Function, body_digest: string) -> bool {
    if !begin(&mut c, declaration) { return false }
    if !valid_digest(body_digest) { return false }
    if !f.supported || f.params < 0 || f.params > 8 || f.local_types.len != f.params || f.ret < 1 || f.ret > 3 { return false }
    n := f.nodes.kinds.len
    if n < 3 || n > 34 { return false }
    charge := n + f.params
    if charge > c.work_limit - c.work { c.exhausted = true; return false }
    c.work = c.work + charge
    if c.declarations.len >= c.entry_limit || n - 2 > c.node_limit - c.nodes.kinds.len { c.exhausted = true; return false }
    if f.local_param.len != f.params || f.local_mutable.len != f.params { return false }
    for p in 0..f.params {
        if f.local_types[p] < 1 || f.local_types[p] > 3 || f.local_param[p] != p || f.local_mutable[p] { return false }
    }
    if f.nodes.types.len != n || f.nodes.left.len != n || f.nodes.right.len != n || f.nodes.third.len != n ||
        f.nodes.next.len != n || f.nodes.values.len != n || f.nodes.locals.len != n || f.nodes.starts.len != n ||
        f.nodes.effects.len != n || f.nodes.proofs.len != n { return false }
    block := f.root
    if block < 0 || block >= n || f.nodes.kinds[block] != 10 || f.nodes.next[block] != -1 { return false }
    returned := f.nodes.left[block]
    if returned < 0 || returned >= n || returned == block || f.nodes.kinds[returned] != 15 || f.nodes.next[returned] != -1 { return false }
    root := f.nodes.left[returned]
    if !expression_node(&f.nodes, root, block, returned) || f.nodes.types[root] != f.ret { return false }
    for node in 0..n {
        if node == block || node == returned { continue }
        kind := f.nodes.kinds[node]
        if kind < 1 || kind > 4 || f.nodes.types[node] < 1 || f.nodes.types[node] > 3 ||
            f.nodes.third[node] != -1 || f.nodes.next[node] != -1 || f.nodes.effects[node] < 0 || f.nodes.effects[node] > 1 ||
            f.nodes.proofs[node] < 0 || f.nodes.proofs[node] > 1 { return false }
        if kind == 3 && (f.nodes.values[node] < 1 || f.nodes.values[node] > 13) { return false }
        if kind == 4 && f.nodes.values[node] != 1 && f.nodes.values[node] != 2 { return false }
        if kind == 1 || kind == 2 {
            if f.nodes.left[node] != -1 || f.nodes.right[node] != -1 { return false }
        } else {
            if !expression_node(&f.nodes, f.nodes.left[node], block, returned) { return false }
            if kind == 3 && !expression_node(&f.nodes, f.nodes.right[node], block, returned) { return false }
            if kind == 4 && f.nodes.right[node] != -1 { return false }
        }
        if kind == 2 {
            local := f.nodes.locals[node]
            if local < 0 || local >= f.params || f.nodes.types[node] != f.local_types[local] { return false }
        } else if f.nodes.locals[node] != -1 { return false }
    }
    // The verified source graph is a tree. Count all stored expression nodes,
    // including detached folding remnants, for a conservative finite bound.
    first := c.nodes.kinds.len
    for node in 0..n {
        if node == block || node == returned { continue }
        c.nodes.kinds.push(f.nodes.kinds[node]); c.nodes.types.push(f.nodes.types[node])
        c.nodes.left.push(relocated(f.nodes.left[node], first, block, returned))
        c.nodes.right.push(relocated(f.nodes.right[node], first, block, returned))
        c.nodes.third.push(-1); c.nodes.next.push(-1); c.nodes.values.push(f.nodes.values[node])
        c.nodes.locals.push(f.nodes.locals[node]); c.nodes.starts.push(f.nodes.starts[node])
        c.nodes.effects.push(f.nodes.effects[node]); c.nodes.proofs.push(f.nodes.proofs[node])
    }
    c.declarations.push(declaration); c.roots.push(relocated(root, first, block, returned))
    c.firsts.push(first); c.counts.push(n - 2); c.param_starts.push(c.param_types.len); c.param_counts.push(f.params)
    for ty in f.local_types { c.param_types.push(ty) }
    c.returns.push(f.ret); c.body_digests.push(body_digest)
    // Each closed scalar node needs at most32 shared ARM-vocabulary words:
    // checked dynamic division is the longest path (<=24 incl i32 narrow and
    // operand saves). Constants need<=4; branch/short-circuit overhead fits.
    // Each eager-slot load+MOV+SXTW needs<=8, including large frame offsets.
    c.costs.push((n - 2) * 32 + f.params * 8)
    true
}
pub fn find(c: &Catalog, declaration: i32) -> i32 {
    if !c.valid || declaration < 0 { return -1 }
    var low := 0; var high := c.declarations.len
    while low < high { mid := low + (high - low) / 2; if c.declarations[mid] < declaration { low = mid + 1 } else { high = mid } }
    if low < c.declarations.len && c.declarations[low] == declaration { low } else { -1 }
}
fn catalog_storage(c: &Catalog) -> bool {
    entries := c.declarations.len; n := c.nodes.kinds.len
    c.valid && c.sealed && c.stamp.len == 64 && entries <= 256 && n <= 4096 &&
        c.roots.len == entries && c.firsts.len == entries && c.counts.len == entries &&
        c.param_starts.len == entries && c.param_counts.len == entries && c.returns.len == entries &&
        c.body_digests.len == entries && c.costs.len == entries && c.param_types.len <= 2048 &&
        c.nodes.types.len == n && c.nodes.left.len == n && c.nodes.right.len == n && c.nodes.third.len == n &&
        c.nodes.next.len == n && c.nodes.values.len == n && c.nodes.locals.len == n && c.nodes.starts.len == n &&
        c.nodes.effects.len == n && c.nodes.proofs.len == n
}
fn template_tree(c: &Catalog, node: i32, first: i32, seen: &mut i64, depth: i32) -> bool {
    if depth > 32 { return false }
    bit := i64(1).shl(node - first)
    if seen.bit_and(bit) != 0 { return false }
    seen = seen.bit_or(bit)
    kind := c.nodes.kinds[node]
    if kind <= 2 { return true }
    if !template_tree(&c, c.nodes.left[node], first, &mut seen, depth + 1) { return false }
    kind != 3 || template_tree(&c, c.nodes.right[node], first, &mut seen, depth + 1)
}
// A selected entry contains <=32 stored nodes, including detached folding
// remnants. Check every reference before traversing its reachable tree. The
// immutable catalog is pooled; this does not copy a Function or node record.
fn template_entry(c: &Catalog, declaration: i32) -> i32 {
    if !catalog_storage(&c) { return -1 }
    entry := find(&c, declaration)
    if entry < 0 { return -1 }
    count := c.counts[entry]; first := c.firsts[entry]; params := c.param_counts[entry]; signature := c.param_starts[entry]
    if count < 1 || count > 32 || first < 0 || first > c.nodes.kinds.len - count ||
        params < 0 || params > 8 || signature < 0 || signature > c.param_types.len - params ||
        c.returns[entry] < 1 || c.returns[entry] > 3 { return -1 }
    end := first + count; root := c.roots[entry]
    if root < first || root >= end || c.nodes.types[root] != c.returns[entry] { return -1 }
    for p in 0..params { if c.param_types[signature + p] < 1 || c.param_types[signature + p] > 3 { return -1 } }
    for node in first..end {
        kind := c.nodes.kinds[node]; ty := c.nodes.types[node]; left := c.nodes.left[node]; right := c.nodes.right[node]
        op := c.nodes.values[node]; local := c.nodes.locals[node]; proof := c.nodes.proofs[node]
        if kind < 1 || kind > 4 || ty < 1 || ty > 3 || c.nodes.third[node] != -1 || c.nodes.next[node] != -1 ||
            c.nodes.starts[node] < 0 || c.nodes.effects[node] < 0 || c.nodes.effects[node] > 1 || proof < 0 || proof > 1 { return -1 }
        if kind == 1 || kind == 2 {
            if left != -1 || right != -1 || proof != 0 { return -1 }
            if kind == 1 {
                if local != -1 || (ty == 1 && (op < -2147483648 || op > 2147483647)) || (ty == 3 && op != 0 && op != 1) { return -1 }
            } else if local < 0 || local >= params || op != 0 || ty != c.param_types[signature + local] { return -1 }
        } else {
            if local != -1 || left < first || left >= end { return -1 }
            actual := c.nodes.types[left]
            if kind == 4 {
                if right != -1 || ty != actual || (op != 1 && op != 2) { return -1 }
                if (op == 1 && ty != 1 && ty != 2) || (op == 2 && ty != 3) || (proof != 0 && op != 1) { return -1 }
            } else {
                if right < first || right >= end || op < 1 || op > 13 || c.nodes.types[right] != actual { return -1 }
                if op <= 5 { if (actual != 1 && actual != 2) || ty != actual { return -1 } }
                else if op <= 11 { if ty != 3 || ((actual != 1 && actual != 2) && !(actual == 3 && op <= 7)) { return -1 } }
                else if actual != 3 || ty != 3 { return -1 }
                if proof != 0 && op > 5 { return -1 }
            }
        }
        var required := ir.own_effects(kind, op)
        if left >= 0 { required = required.bit_or(c.nodes.effects[left]) }
        if right >= 0 { required = required.bit_or(c.nodes.effects[right]) }
        if c.nodes.effects[node].bit_and(required) != required { return -1 }
    }
    var seen: i64 = 0
    if !template_tree(&c, root, first, &mut seen, 0) { return -1 }
    entry
}
// Caller-owned storage is reused; every missing/unsealed/invalid lookup clears
// the previous signature and returns0. Catalog entries never return void.
pub fn signature_into(c: &Catalog, declaration: i32, param_types: &mut []i32) -> i32 {
    param_types.clear()
    entry := template_entry(&c, declaration)
    if entry < 0 { return 0 }
    first := c.param_starts[entry]
    for p in 0..c.param_counts[entry] { param_types.push(c.param_types[first + p]) }
    c.returns[entry]
}
fn model_index(index: i32, count: i32) -> bool { index >= -1 && index < count }
// A parser may still be assembling the caller: root=-1/supported=false and
// detached nodes are permitted. This checks storage and metadata, not graph
// ownership, scope, initialization or completed return coverage.
fn caller_storage(f: &ir.Function) -> bool {
    n := f.nodes.kinds.len; locals := f.local_types.len
    if n > 2048 || locals > 256 || f.params < 0 || f.params > 8 || f.params > locals ||
        f.ret < 0 || f.ret > 3 || f.visits < 0 || f.rewrites < 0 || !model_index(f.root, n) ||
        f.nodes.types.len != n || f.nodes.left.len != n || f.nodes.right.len != n || f.nodes.third.len != n ||
        f.nodes.next.len != n || f.nodes.values.len != n || f.nodes.locals.len != n || f.nodes.starts.len != n ||
        f.nodes.effects.len != n || f.nodes.proofs.len != n || f.local_names.len != locals ||
        f.local_mutable.len != locals || f.local_param.len != locals || f.local_at.len != locals { return false }
    for local in 0..locals {
        ty := f.local_types[local]; parameter := local < f.params
        if ((ty < 1 || ty > 3) && !ir.array_type(ty)) || f.local_names[local] == "" || f.local_at[local] < 0 { return false }
        if parameter { if f.local_param[local] != local || f.local_mutable[local] { return false } }
        else if f.local_param[local] != -1 || ir.array_type(ty) { return false }
    }
    for node in 0..n {
        kind := f.nodes.kinds[node]; proof := f.nodes.proofs[node]
        if ir.own_effects(kind, f.nodes.values[node]) < 0 || f.nodes.types[node] < 0 || f.nodes.types[node] > 3 ||
            f.nodes.starts[node] < 0 || f.nodes.effects[node] < 0 || f.nodes.effects[node] > 31 || proof < 0 || proof > 3 ||
            !model_index(f.nodes.left[node], n) || !model_index(f.nodes.right[node], n) || !model_index(f.nodes.third[node], n) ||
            !model_index(f.nodes.next[node], n) || !model_index(f.nodes.locals[node], locals) { return false }
        if proof.bit_and(1) != 0 && !((kind == 3 && f.nodes.values[node] >= 1 && f.nodes.values[node] <= 5 &&
            (f.nodes.types[node] == 1 || f.nodes.types[node] == 2)) || (kind == 4 && f.nodes.values[node] == 1 &&
            (f.nodes.types[node] == 1 || f.nodes.types[node] == 2))) { return false }
        if proof.bit_and(2) != 0 {
            local := f.nodes.locals[node]
            if local < 0 { return false }
            if kind == 6 { if f.nodes.types[node] != 2 || !ir.array_type(f.local_types[local]) { return false } }
            else if kind == 18 { if f.nodes.types[node] != 0 || !ir.writable_array(f.local_types[local]) { return false } }
            else { return false }
        }
    }
    true
}
// This is IR template instantiation, not source-call lowering. arg_local_ids
// must already name initialized, in-scope, canonical scalar snapshots captured
// in source argument order. Duplicate IDs are allowed for these existing pure
// values. No argument expression is evaluated or staged here. call_at must
// name a token in the actual caller stream; only its nonnegative bound can be
// checked without that stream. The frontend must perform its position check
// and full optimized IR verification after attaching the returned expression.
// Failure mutates no Function field; success only appends nodes. root/support,
// declaration metadata and rewrite counters remain the caller's responsibility.
pub fn append_expression_into(c: &Catalog, f: &mut ir.Function, declaration: i32,
    arg_local_ids: &[]i32, call_at: i32) -> i32 {
    entry := template_entry(&c, declaration)
    if entry < 0 || call_at < 0 || !caller_storage(&f) { return -1 }
    count := c.counts[entry]; base := f.nodes.kinds.len
    if arg_local_ids.len != c.param_counts[entry] || count > 2048 - base { return -1 }
    signature := c.param_starts[entry]
    for p in 0..arg_local_ids.len {
        local := arg_local_ids[p]
        if local < 0 || local >= f.local_types.len || f.local_types[local] != c.param_types[signature + p] { return -1 }
    }
    first := c.firsts[entry]
    for node in first..first + count {
        var left := c.nodes.left[node]; var right := c.nodes.right[node]; var local := c.nodes.locals[node]
        if left >= 0 { left = base + left - first }; if right >= 0 { right = base + right - first }
        if c.nodes.kinds[node] == 2 { local = arg_local_ids[local] }
        f.nodes.kinds.push(c.nodes.kinds[node]); f.nodes.types.push(c.nodes.types[node])
        f.nodes.left.push(left); f.nodes.right.push(right); f.nodes.third.push(-1); f.nodes.next.push(-1)
        f.nodes.values.push(c.nodes.values[node]); f.nodes.locals.push(local); f.nodes.starts.push(call_at)
        f.nodes.effects.push(c.nodes.effects[node]); f.nodes.proofs.push(c.nodes.proofs[node])
    }
    base + c.roots[entry] - first
}
pub fn set_body_digest(c: &mut Catalog, declaration: i32, digest: string) -> bool {
    entry := find(&c, declaration)
    if entry < 0 || c.sealed || !valid_digest(digest) { return false }
    c.body_digests[entry] = digest; true
}
fn hash(input: &[]u8) -> string {
    digest := sha.digest_bytes(&input); var wide: []i32 = []
    for byte in digest { wide.push(i32(byte)) }; bytes.hex(&wide)
}
fn put(raw: &mut []u8, value: i32) { bytes.append_le(&mut raw, i64(value), 4) }
fn identity(c: &Catalog, source_digests: bool) -> string {
    var raw: []u8 = []
    bytes.append_utf8(&mut raw, "dunder-inline-expression-v1")
    put(&mut raw, c.node_limit); put(&mut raw, c.work_limit); put(&mut raw, c.entry_limit)
    for entry in 0..c.declarations.len {
        put(&mut raw, c.declarations[entry]); put(&mut raw, c.roots[entry]); put(&mut raw, c.counts[entry])
        put(&mut raw, c.param_counts[entry]); put(&mut raw, c.returns[entry])
        first := c.param_starts[entry]
        for p in 0..c.param_counts[entry] { bytes.append_le(&mut raw, i64(c.param_types[first + p]), 4) }
        if source_digests {
            bytes.append_le(&mut raw, i64(c.body_digests[entry].len), 4); bytes.append_utf8(&mut raw, c.body_digests[entry])
        }
    }
    // The lifecycle seal also distinguishes independently-created catalogs
    // with different code, even when their generation counters coincide.
    for node in 0..c.nodes.kinds.len {
        put(&mut raw, c.nodes.kinds[node]); put(&mut raw, c.nodes.types[node]); put(&mut raw, c.nodes.left[node]); put(&mut raw, c.nodes.right[node])
        put(&mut raw, c.nodes.locals[node]); put(&mut raw, c.nodes.starts[node]); put(&mut raw, c.nodes.effects[node]); put(&mut raw, c.nodes.proofs[node])
        bytes.append_le(&mut raw, c.nodes.values[node], 8)
    }
    hash(&raw)
}
pub fn seal(c: &mut Catalog) -> bool {
    if !c.valid || c.sealed { return false }
    c.stamp = identity(&c, false)
    var complete := true
    for digest in c.body_digests { if digest == "" { complete = false } }
    if complete { c.source_fingerprint = identity(&c, true) }
    c.generation = c.generation + 1; c.sealed = true; true
}
pub fn digest_ready(c: &Catalog) -> bool {
    c.valid && c.sealed && c.source_fingerprint.len == 64
}
// Empty is an explicit NOT-READY result. A producer must finalize every body
// digest before activating fragment-cache context; never reuse an old context.
pub fn fingerprint(c: &Catalog) -> string { if !digest_ready(&c) { "" } else { c.source_fingerprint } }
pub fn word_estimate(w: &Workspace) -> i32 { if w.ready { w.cost } else { 0 } }
// Caller resolution supplies the actual callee-address slot. A shadowed
// function pointer is never accepted just because a global declaration shares
// its spelling/ID. Arguments are already evaluated and stored eagerly.
// The caller is the legacy frontend: live values reside in its frame/stack.
// Homes x4..7/x10..13 are call-clobbered. An allocated IR caller would first
// need its own liveness/save policy; that integration is deliberately absent.
pub fn prepare(w: &mut Workspace, c: &Catalog, declaration: i32, callee_address: i32,
    arg_types: &[]i32, result_type: i32, eager_slots: &[]i32, caller_slots: i32,
    platform: i32, available_words: i32) -> bool {
    w.ready = false; w.types.clear(); w.plan.homes.clear(); w.plan.frame_slots.clear(); w.plan.data.clear(); w.plan.length.clear()
    if !c.valid || !c.sealed || callee_address != -1 || platform < 0 || platform > 3 || caller_slots < 0 || caller_slots > 65535 { return false }
    entry := find(&c, declaration)
    if entry < 0 || arg_types.len != c.param_counts[entry] || eager_slots.len != arg_types.len || result_type != c.returns[entry] { return false }
    if available_words < c.costs[entry] { return false }
    first := c.param_starts[entry]
    for p in 0..arg_types.len {
        if arg_types[p] != c.param_types[first + p] || eager_slots[p] < 0 || eager_slots[p] >= caller_slots { return false }
    }
    for p in 0..arg_types.len {
        w.types.push(arg_types[p]); w.plan.frame_slots.push(eager_slots[p]); w.plan.data.push(-1); w.plan.length.push(-1)
        var home := 4 + p; if p >= 4 { home = 6 + p }; w.plan.homes.push(home)
    }
    w.generation = c.generation; w.stamp = c.stamp; w.entry = entry; w.declaration = declaration
    w.root = c.roots[entry]; w.cost = c.costs[entry]; w.platform = platform; w.ready = true; true
}
// False means no Code field changed. A successful preparation is single-use;
// reset, catalog corruption, different catalog contents or target invalidate it.
pub fn emit_prepared(w: &mut Workspace, code: &mut arm.Code, c: &Catalog,
    overflow: i32, zero: i32, bounds: i32, settings: &emit.Options) -> bool {
    ready := w.ready; w.ready = false
    emit_ready(&w, &mut code, &c, overflow, zero, bounds, &settings, ready)
}
pub fn emit_prepared_configured(w: &mut Workspace, code: &mut arm.Code, c: &Catalog,
    overflow: i32, zero: i32, bounds: i32) -> bool {
    ready := w.ready; w.ready = false
    emit_ready(&w, &mut code, &c, overflow, zero, bounds, &w.settings, ready)
}
fn emit_ready(w: &Workspace, code: &mut arm.Code, c: &Catalog,
    overflow: i32, zero: i32, bounds: i32, settings: &emit.Options, ready: bool) -> bool {
    if !ready || !c.valid || !c.sealed || w.generation != c.generation || w.stamp != c.stamp ||
        w.entry < 0 || w.entry >= c.declarations.len || c.declarations[w.entry] != w.declaration ||
        c.roots[w.entry] != w.root || code.platform != w.platform { return false }
    first := arm.position(&code)
    for p in 0..w.types.len {
        arm.load(&mut code, w.plan.frame_slots[p]); reg := w.plan.homes[p]
        if w.types[p] == 3 {
            arm.emit(&mut code, 3944677407); arm.emit(&mut code, 2594113504 + i64(reg)) // CMP x0,0; CSET home,NE.
        } else {
            arm.mov(&mut code, reg, 0)
            if w.types[p] == 1 { arm.emit(&mut code, 2470476800 + i64(reg) * 33) }
        }
    }
    emit.emit_expression(&mut code, &c.nodes, &w.types, &w.plan, w.root, overflow, zero, bounds, &settings)
    assert(arm.position(&code) - first <= w.cost)
    true
}
