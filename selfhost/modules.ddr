// Module loading and namespace resolution for the Dunder compiler.
// Parallel arrays deliberately keep the bootstrap data model small.
import cache_io
import test_suite
import lexer
import bundled
import std.map as map
import std.text as strings
import std.bytes as bytes
import sys

pub struct Location { path: string, source: string, offset: i32 }
pub struct Loaded {
    token_offsets: bool,
    groups: []string, calls: []string,
    ok: bool, error: string, path: string, source: string, offset: i32,
    paths: []string, sources: []string, symbols: []string,
    map_starts: []i32, map_ends: []i32, map_files: []i32, map_offsets: []i32,
}
struct Loader {
    result: Loaded, key_prefixes: []string, standard: []string, directories: []string, first: []i32, last: []i32,
    raw: lexer.Tokens, last_arm: []i32, namespace_initials: []i64,
    hidden_starts: []i32, hidden_ends: []i32, declaration_tokens: []i32, any_unsafe: bool, caps: []i32, requires_caps: []i32,
    symbols: map.Map, imports: map.Map, by_path: map.Map, by_std: map.Map, owners: []i32,
    public: []bool, records: []bool, renamed: []string,
    testing: bool, test_tags: []i32, test_targets: []i32, test_ends: []i32, next_test: i32,
}
fn key(loader: &Loader, owner: i32, name: string) -> string { loader.key_prefixes[owner] + name }
// A local only needs tracking if it can shadow a declaration or import here.
fn initial_bit(name: string) -> i64 { i64(1).shl(name[0].bit_and(63)) }
fn begins(text: string, prefix: string) -> bool {
    if text.len < prefix.len { return false }
    mut i := 0
    while i < prefix.len { if text[i] != prefix[i] { return false }; i = i + 1 }
    true
}
fn text(output: &mut []i32, value: string) {
    output.reserve(output.len + value.len)
    mut i := 0
    while i < value.len { output.push(value[i]); i = i + 1 }
}
// Interpolation segments are decoded strings anchored at zero-width source
// positions. Reconstruct their spelling when callers request flattened source.
fn string_literal(value: string) -> string {
    mut output: []i32 = [34]
    digits := "0123456789abcdef"
    for i in 0..value.len {
        byte := value[i]
        if byte == 34 || byte == 92 { output.push(92); output.push(byte) }
        else if byte < 32 || byte == 127 {
            text(&mut output, "\\x")
            output.push(digits[byte / 16]); output.push(digits[byte % 16])
        } else { output.push(byte) }
    }
    output.push(34)
    bytes.utf8(&output).value
}
pub fn normalize(path: string) -> string {
    mut parts: []string = []
    absolute := path.len > 0 && path[0] == 47
    mut start := 0
    mut i := 0
    while i <= path.len {
        if i == path.len || path[i] == 47 {
            part := path[start..i]
            if part == ".." {
                if parts.len > 0 && parts[parts.len - 1] != ".." { old := parts.pop() }
                else if !absolute { parts.push(move part) }
            } else if part != "" && part != "." { parts.push(move part) }
            start = i + 1
        }
        i = i + 1
    }
    mut output: []i32 = []
    if absolute { output.push(47) }
    i = 0
    while i < parts.len {
        if i > 0 { output.push(47) }
        text(&mut output, parts[i]); i = i + 1
    }
    if output.len == 0 { return "." }
    decoded := bytes.utf8(&output)
    decoded.value
}
fn parent(path: string) -> string {
    mut i := path.len
    while i > 0 { i = i - 1; if path[i] == 47 { if i == 0 { return "/" }; return path[0..i] } }
    "."
}
fn fail(loader: &mut Loader, owner: i32, offset: i32, message: string) {
    if !loader.result.ok { return }
    loader.result.ok = false; loader.result.error = message.clone()
    loader.result.path = loader.result.paths[owner].clone()
    loader.result.source = loader.result.sources[owner].clone()
    loader.result.offset = offset
}
fn is(loader: &Loader, at: i32, value: string) -> bool {
    if at < 0 || at >= loader.raw.texts.len { return false }
    kind := loader.raw.kinds[at]
    if kind != .Name && kind != .Keyword && kind != .Symbol { return false }
    loader.raw.texts[at] == value
}
fn check_caps(loader: &mut Loader, owner: i32, token: i32, found: i32) -> bool {
    missing := loader.requires_caps[found].bit_and(loader.caps[owner].bit_xor(7))
    if missing == 0 { return true }
    if missing.bit_and(1) != 0 {
        fail(&mut loader, owner, loader.raw.starts[token], "this function requires capability filesystem")
    } else if missing.bit_and(2) != 0 {
        fail(&mut loader, owner, loader.raw.starts[token], "this function requires capability network")
    } else {
        fail(&mut loader, owner, loader.raw.starts[token], "this function requires capability process")
    }
    false
}
fn add(loader: &mut Loader, path: string, standard: string, origin: i32, offset: i32) -> i32 {
    if standard != "" {
        existing := map.get_or(&loader.by_std, standard, -1)
        if existing >= 0 { return i32(existing) }
    }
    mut actual := normalize(path)
    mut directory := parent(actual)
    if standard == "" {
        physical := cache_io.root(path)
        if physical != "" {
            // A symbolic link may precede ".." or name the source itself.
            // Keep the requested spelling where it still identifies this file.
            if !sys.same_file(actual, physical) { actual = physical.clone() }
            if !sys.same_file(directory, parent(physical)) { directory = parent(physical) }
        } else { actual = path.clone() }
        cached := map.get_or(&loader.by_path, actual, -1)
        if cached >= 0 { return i32(cached) }
        mut i := 0
        while i < loader.result.paths.len {
            if loader.standard[i] == "" && (loader.result.paths[i] == actual || sys.same_file(loader.result.paths[i], actual)) {
                map.put(&mut loader.by_path, move actual, i64(i))
                return i
            }
            i = i + 1
        }
    }
    mut source := ""
    if standard != "" { source = bundled.source(standard) }
    else {
        read := sys.read_text(actual)
        if !read.ok {
            if origin >= 0 { fail(&mut loader, origin, offset, "cannot load module " + actual + ": " + sys.error_message(read.error)) }
            else { loader.result.ok = false; loader.result.path = actual; loader.result.error = "cannot load module: " + sys.error_message(read.error) }
            return -1
        }
        source = read.value
    }
    id := loader.result.paths.len
    loader.result.paths.push(actual.clone()); loader.result.sources.push(move source)
    loader.key_prefixes.push(id.str() + ":"); loader.namespace_initials.push(0)
    loader.directories.push(move directory); loader.standard.push(standard.clone()); loader.first.push(0); loader.last.push(0)
    if standard != "" { map.put(&mut loader.by_std, standard.clone(), i64(id)) }
    else { map.put(&mut loader.by_path, move actual, i64(id)) }
    id
}
fn skip_lines(loader: &Loader, at: i32) -> i32 {
    mut i := at
    while i < loader.raw.texts.len && loader.raw.kinds[i] == .Newline { i = i + 1 }
    i
}
fn close_block(loader: &Loader, at: i32) -> i32 {
    mut i := at
    mut depth := 0
    while i < loader.raw.texts.len {
        if is(&loader, i, "{") { depth = depth + 1 }
        if is(&loader, i, "}") { depth = depth - 1; if depth == 0 { return i + 1 } }
        i = i + 1
    }
    -1
}
fn hide(loader: &mut Loader, first: i32, last: i32) {
    loader.hidden_starts.push(first); loader.hidden_ends.push(last)
}
fn lower_bound(tokens: &[]i32, token: i32) -> i32 {
    mut lo := 0; mut hi := tokens.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if tokens[mid] < token { lo = mid + 1 } else { hi = mid }
    }
    lo
}
fn name_byte(b: i32) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128
}
fn valid_alias(alias: string) -> bool {
    if alias == "" || begins(alias, "__") || !name_byte(alias[0]) { return false }
    for idx in 0..alias.len { b := alias[idx]; if !name_byte(b) && (b < 48 || b > 57) { return false } }
    n := alias.len
    if n == 2 { return alias != "fn" && alias != "if" && alias != "in" && alias != "as" && alias != "u8" }
    if n == 3 {
        return alias != "pub" && alias != "var" && alias != "mut" && alias != "for" && alias != "i32" &&
            alias != "i64" && alias != "len" && alias != "f32" && alias != "f64" && alias != "u16" &&
            alias != "u32" && alias != "u64" && alias != "ptr"
    }
    if n == 4 { return alias != "else" && alias != "enum" && alias != "true" && alias != "move" && alias != "bool" && alias != "rune" }
    if n == 5 {
        return alias != "while" && alias != "break" && alias != "match" && alias != "false" &&
            alias != "print" && alias != "range" && alias != "usize"
    }
    if n == 6 {
        return alias != "return" && alias != "struct" && alias != "import" && alias != "assert" &&
            alias != "string" && alias != "unsafe" && alias != "extern" && alias != "TaskID"
    }
    if n == 8 { return alias != "continue" }
    if n == 10 { return alias != "capability" }
    true
}
fn bare_path(raw: string) -> string {
    if raw == "" || strings.ends_with(raw, ".ddr") { return "" }
    for b in raw.bytes() {
        if !name_byte(b) && (b < 48 || b > 57) && b != 45 && b != 46 && b != 47 { return "" }
    }
    if strings.find(raw, "/") >= 0 {
        if raw[0] == 47 || raw[raw.len-1] == 47 || strings.find(raw, "//") >= 0 || strings.ends_with(raw, "/.") || strings.ends_with(raw, "/..") { return "" }
        return raw.clone()
    }
    mut dots := 0
    while dots < raw.len && raw[dots] == 46 { dots = dots + 1 }
    if dots == raw.len { return "" }
    mut result := ""
    if dots == 1 { result = "./" }
    for i in 1..dots { result = result + "../" }
    for component in strings.split(raw[dots..raw.len], ".") {
        if component == "" { return "" }
        if result != "" && result[result.len-1] != 47 { result = result + "/" }
        result = result + component
    }
    result
}
fn import_module(loader: &mut Loader, owner: i32, at: i32) -> i32 {
    mut i := at + 1
    mut path := ""
    mut alias := ""
    if i < loader.raw.texts.len && loader.raw.kinds[i] == .String {
        path = loader.raw.texts[i].clone(); i = i + 1
    } else {
        source := loader.result.sources[owner].clone()
        first := loader.raw.starts[i]
        mut end := first
        while end < source.len && source[end] > 32 && source[end] != 59 { end = end + 1 }
        path = bare_path(source[first..end])
        if path == "" { fail(&mut loader, owner, first, "invalid module path; use a relative name without a file suffix"); return i }
        while i < loader.raw.texts.len && loader.raw.starts[i] < end { i = i + 1 }
    }
    mut component := 0
    for n in 0..path.len { if path[n] == 47 { component = n + 1 } }
    alias = path[component..path.len]
    if alias == "" || alias == "." || alias == ".." || strings.find(alias, ".") > 0 {
        fail(&mut loader, owner, loader.raw.starts[at], "import a module name without a file suffix"); return i
    }
    if is(&loader, i, "as") {
        i = i + 1
        if i >= loader.raw.texts.len || loader.raw.kinds[i] != .Name { fail(&mut loader, owner, loader.raw.starts[at], "expected an import alias"); return i }
        alias = loader.raw.texts[i].clone(); i = i + 1
    }
    if i < loader.raw.texts.len && loader.raw.kinds[i] != .Newline && loader.raw.kinds[i] != .End && !is(&loader, i, ";") {
        fail(&mut loader, owner, loader.raw.starts[i], "expected end of import"); return i
    }
    if is(&loader, i, ";") { i = i + 1 }
    if path == "" || path[0] == 47 || !valid_alias(alias) {
        fail(&mut loader, owner, loader.raw.starts[at], "import a relative module name with a non-reserved alias"); return i
    }
    mut standard := ""
    mut target := ""
    mut library := ""
    if path == "sys" { library = "sys" }
    if begins(path, "std/") { library = path[4..path.len] }
    if library != "" && bundled.contains(library) { target = "<stdlib/" + library + ".ddr>"; standard = library }
    else {
        if loader.standard[owner] != "" { fail(&mut loader, owner, loader.raw.starts[at], "bundled libraries may only import bundled modules"); return i }
        target = loader.directories[owner] + "/" + path + ".ddr"
    }
    entry := key(&loader, owner, alias)
    if map.contains(&loader.imports, entry) || map.contains(&loader.symbols, entry) { fail(&mut loader, owner, loader.raw.starts[at], "duplicate import alias '" + alias + "'"); return i }
    id := add(&mut loader, target, standard, owner, loader.raw.starts[at])
    if id >= 0 {
        map.put(&mut loader.imports, move entry, i64(id))
        loader.namespace_initials[owner] = loader.namespace_initials[owner].bit_or(initial_bit(alias))
    }
    hide(&mut loader, at, i)
    i
}
fn scan(loader: &mut Loader, owner: i32) {
    first := loader.raw.texts.len
    source := loader.result.sources[owner].clone()
    lexer.scan_into(source, &mut loader.raw)
    if !loader.raw.ok { fail(&mut loader, owner, loader.raw.error_at, loader.raw.error.clone()); return }
    last := loader.raw.texts.len
    loader.first[owner] = first
    loader.last[owner] = last
    mut i := skip_lines(&loader, first)
    mut capable := false
    mut caps := 0
    if is(&loader, i, "capability") {
        start := i; i = i + 1
        while i < last {
            if is(&loader, i, "unsafe") && !capable { capable = true; loader.any_unsafe = true }
            else if is(&loader, i, "filesystem") && caps.bit_and(1) == 0 { caps = caps.bit_or(1) }
            else if is(&loader, i, "network") && caps.bit_and(2) == 0 { caps = caps.bit_or(2) }
            else if is(&loader, i, "process") && caps.bit_and(4) == 0 { caps = caps.bit_or(4) }
            else { fail(&mut loader, owner, loader.raw.starts[i], "unknown or duplicate module capability"); return }
            i = i + 1
            if !is(&loader, i, ",") { break }
            i = i + 1
        }
        if i < last && loader.raw.kinds[i] != .Newline && loader.raw.kinds[i] != .End && !is(&loader,i,";") {
            fail(&mut loader, owner, loader.raw.starts[i], "expected end of capability declaration"); return
        }
        hide(&mut loader, start, i)
    }
    // Validate the module boundary even in omitted tests and unreachable bodies.
    // The declaration pass only needs braces inside a function body. Collect
    // those sparse positions alongside the mandatory capability check.
    mut braces: []i32 = []
    mut last_arm := -1
    for token in i..last {
        kind := loader.raw.kinds[token]
        if kind == .Name {
            name := loader.raw.texts[token].clone()
            if !capable && name == "unsafe" { fail(&mut loader,owner,loader.raw.starts[token],"module requires capability unsafe");return }
            if name == "capability" { fail(&mut loader,owner,loader.raw.starts[token],"declare capabilities at the beginning of the module");return }
        } else if kind == .Symbol {
            word := loader.raw.texts[token].clone()
            if word == "{" || word == "}" { braces.push(token) }
            else if word == "=>" { last_arm = token }
        }
    }
    loader.last_arm.push(last_arm)
    loader.caps.push(caps)
    mut brace := 0
    mut depth := 0
    mut public := false
    mut parens := 0
    mut requires_caps := 0
    while i < last && loader.result.ok {
        if depth > 0 {
            while brace < braces.len && braces[brace] < i { brace = brace + 1 }
            if brace == braces.len { break }
            i = braces[brace]; brace = brace + 1
            if loader.raw.texts[i] == "{" { depth = depth + 1 } else { depth = depth - 1 }
            i = i + 1; continue
        }
        if depth == 0 && is(&loader,i,"@") && is(&loader,i+1,"requires") {
            if !is(&loader,i+2,"(") {
                fail(&mut loader,owner,loader.raw.starts[i],"expected @requires(filesystem), @requires(network) or @requires(process)"); return
            }
            mut j := i + 3
            mut cap_mask := 0
            while j < last {
                if is(&loader,j,"filesystem") && cap_mask.bit_and(1) == 0 { cap_mask = cap_mask.bit_or(1) }
                else if is(&loader,j,"network") && cap_mask.bit_and(2) == 0 { cap_mask = cap_mask.bit_or(2) }
                else if is(&loader,j,"process") && cap_mask.bit_and(4) == 0 { cap_mask = cap_mask.bit_or(4) }
                else { fail(&mut loader,owner,loader.raw.starts[i],"expected @requires(filesystem), @requires(network) or @requires(process)"); return }
                j = j + 1
                if is(&loader,j,")") { break }
                if !is(&loader,j,",") { fail(&mut loader,owner,loader.raw.starts[i],"expected ')' after @requires capability"); return }
                j = j + 1
            }
            if j >= last || !is(&loader,j,")") || cap_mask == 0 {
                fail(&mut loader,owner,loader.raw.starts[i],"expected @requires(filesystem), @requires(network) or @requires(process)"); return
            }
            mut function := skip_lines(&loader,j+1)
            if is(&loader,function,"pub") { function=function+1 }
            if is(&loader,function,"unsafe") { function=function+1 }
            if !is(&loader,function,"fn") { fail(&mut loader,owner,loader.raw.starts[i],"@requires applies to a function"); return }
            requires_caps=requires_caps.bit_or(cap_mask);hide(&mut loader,i,j+1);i=j+1;continue
        }
        if depth == 0 && is(&loader, i, "import") { i = import_module(&mut loader, owner, i); public = false; continue }
        if depth == 0 && is(&loader, i, "@") && is(&loader, i + 1, "test") {
            tag := i
            body := skip_lines(&loader, i + 2)
            attached := is(&loader, body, "{")
            mut after := body
            if attached { after = close_block(&loader, body) }
            if after < 0 { fail(&mut loader, owner, loader.raw.starts[tag], "unterminated test block"); return }
            mut function := skip_lines(&loader, after)
            if is(&loader, function, "pub") { function = skip_lines(&loader, function + 1) }
            if !is(&loader, function, "fn") {
                fail(&mut loader, owner, loader.raw.starts[tag], "expected function after @test"); return
            }
            name := function + 1
            if name >= last || loader.raw.kinds[name] != .Name { fail(&mut loader, owner, loader.raw.starts[tag], "expected test function name"); return }
            if loader.testing {
                loader.test_tags.push(tag); loader.test_targets.push(name)
                if attached { loader.test_ends.push(after) } else { loader.test_ends.push(-1) }
                loader.result.groups.push(loader.result.paths[owner] + "::" + loader.raw.texts[name])
                // Declarations in the attached body are local to its generated function.
                if attached { i = after } else { i = body }
            } else {
                if !attached {
                    while after < last && !is(&loader, after, "{") { after = after + 1 }
                    after = close_block(&loader, after)
                    if after < 0 { fail(&mut loader, owner, loader.raw.starts[tag], "unterminated test function"); return }
                }
                hide(&mut loader, tag, after); i = after
            }
            continue
        }
        if depth == 0 && is(&loader, i, "pub") { public = true }
        if depth == 0 && parens == 0 && !is(&loader, i - 1, "extern") && ((is(&loader, i, "fn") && !is(&loader, i + 1, "(")) || is(&loader, i, "struct") || is(&loader, i, "enum")) {
            name_at := i + 1
            if name_at >= last || loader.raw.kinds[name_at] != .Name { fail(&mut loader, owner, loader.raw.starts[i], "expected declaration name"); return }
            name := loader.raw.texts[name_at].clone()
            if name == "TaskID" { fail(&mut loader, owner, loader.raw.starts[name_at], "reserved structural task type"); return }
            entry := key(&loader, owner, name)
            if map.contains(&loader.symbols, entry) || map.contains(&loader.imports, entry) {
                fail(&mut loader, owner, loader.raw.starts[name_at], "duplicate declaration '" + name + "'"); return
            }
            id := loader.result.symbols.len
            map.put(&mut loader.symbols, move entry, i64(id))
            loader.namespace_initials[owner] = loader.namespace_initials[owner].bit_or(initial_bit(name))
            if requires_caps != 0 && owner==0 && name=="main" {fail(&mut loader,owner,loader.raw.starts[name_at],"main cannot require a grant");return}
            loader.owners.push(owner); loader.public.push(public)
            loader.records.push(is(&loader, i, "struct"))
            loader.requires_caps.push(requires_caps);requires_caps=0
            mut renamed := "__dunder_module_" + id.str()
            if !loader.testing && owner == 0 && name == "main" && is(&loader, i, "fn") { renamed = "main" }
            loader.result.symbols.push(move name)
            loader.renamed.push(move renamed); loader.declaration_tokens.push(name_at)
            public = false
        }
        if is(&loader, i, "{") { depth = depth + 1 }
        if is(&loader, i, "}") { depth = depth - 1 }
        if is(&loader, i, "(") || is(&loader, i, "[") { parens = parens + 1 }
        if is(&loader, i, ")") || is(&loader, i, "]") { parens = parens - 1 }
        i = i + 1
    }
}
fn local(names: &[]string, active: &[]i32, at: i32, value: string) -> bool {
    mut i := names.len
    while i > 0 { i = i - 1; if names[i] == value && at >= active[i] { return true } }
    false
}
// Balance every delimiter, including record literals nested in calls, indexes
// and parentheses. The scratch stack is reused across headers in this module.
fn balanced_end(kinds: &[]lexer.Kind, texts: &[]string, first: i32, last: i32, stack: &mut []i32) -> i32 {
    stack.clear()
    if first < 0 || first >= last || last > kinds.len || last > texts.len || kinds[first] != .Symbol { return -1 }
    if texts[first] != "(" && texts[first] != "[" && texts[first] != "{" { return -1 }
    mut i := first
    while i < last {
        if kinds[i] == .Symbol {
            word := texts[i].clone()
            mut open := 0; mut close := 0
            if word == "(" { open = 1 } else if word == "[" { open = 2 } else if word == "{" { open = 3 }
            if word == ")" { close = 1 } else if word == "]" { close = 2 } else if word == "}" { close = 3 }
            if open != 0 { stack.push(open) }
            if close != 0 {
                if stack.len == 0 || stack[stack.len - 1] != close { return -1 }
                previous := stack.pop()
                if stack.len == 0 { return i + 1 }
            }
        }
        i = i + 1
    }
    -1
}
// The full parser chooses a record constructor only when its leading name
// resolves to a nominal record, before considering the following brace. Use
// the same module/local distinction; a local or a field can shadow a type.
fn constructor_brace(loader: &Loader, owner: i32, at: i32, names: &[]string, active: &[]i32) -> bool {
    name_at := at - 1
    if name_at < 0 || loader.raw.kinds[name_at] != .Name { return false }
    mut source := owner
    if is(&loader, name_at - 1, ".") {
        alias := name_at - 2
        if alias < 0 || loader.raw.kinds[alias] != .Name || is(&loader, alias - 1, ".") { return false }
        if local(&names, &active, alias, loader.raw.texts[alias]) { return false }
        source = i32(map.get_or(&loader.imports, key(&loader, owner, loader.raw.texts[alias]), -1))
        if source < 0 { return false }
    } else if local(&names, &active, name_at, loader.raw.texts[name_at]) { return false }
    id := i32(map.get_or(&loader.symbols, key(&loader, source, loader.raw.texts[name_at]), -1))
    id >= 0 && loader.records[id]
}
fn iterator_body(loader: &Loader, owner: i32, name: i32, last: i32, names: &[]string, active: &[]i32, stack: &mut []i32) -> i32 {
    mut i := name + 2 // Skip the iterator name and its `in` token.
    mut pending_bodies := 0
    while i < last {
        if loader.raw.kinds[i] == .End || is(&loader, i, "}") { return last }
        if is(&loader, i, "match") || is(&loader, i, "if") || (is(&loader, i, "else") && !is(&loader, i + 1, "if")) {
            pending_bodies = pending_bodies + 1
        }
        if is(&loader, i, "{") && !constructor_brace(&loader, owner, i, &names, &active) {
            if pending_bodies == 0 { return i }
            pending_bodies = pending_bodies - 1
        }
        if is(&loader, i, "(") || is(&loader, i, "[") || is(&loader, i, "{") {
            after := balanced_end(&loader.raw.kinds, &loader.raw.texts, i, last, &mut stack)
            if after < 0 { return last }; i = after
        } else { i = i + 1 }
    }
    last
}
fn binding_end(loader: &Loader, at: i32, last: i32) -> i32 {
    mut i := at + 1
    mut nested := 0
    while i < last {
        // A newline before else is part of the initializer. Its new binding
        // must stay hidden through the remaining branches and projections.
        if nested == 0 && loader.raw.kinds[i] == .Newline && is(&loader, i - 1, "}") {
            mut next := i + 1
            while next < last && loader.raw.kinds[next] == .Newline { next = next + 1 }
            if is(&loader, next, "else") { i = next }
        }
        if nested == 0 && (loader.raw.kinds[i] == .Newline || is(&loader, i, ";") || is(&loader, i, "}")) { return i }
        if is(&loader, i, "(") || is(&loader, i, "[") || is(&loader, i, "{") { nested = nested + 1 }
        if is(&loader, i, ")") || is(&loader, i, "]") || is(&loader, i, "}") { nested = nested - 1 }
        i = i + 1
    }
    i
}
fn emit(loader: &mut Loader, output: &mut []i32, owner: i32, token: i32, value: string) {
    loader.result.map_starts.push(output.len)
    text(&mut output, value)
    loader.result.map_ends.push(output.len)
    loader.result.map_files.push(owner); loader.result.map_offsets.push(loader.raw.starts[token])
    output.push(32)
}
fn argument_case_arrow(loader: &Loader, first: i32, end: i32) -> i32 {
    mut depth := 0
    for i in first..end {
        if is(&loader, i, "(") { depth = depth + 1 }
        if is(&loader, i, ")") {
            depth = depth - 1
            if depth == 0 { if is(&loader, i + 1, "->") { return i + 1 }; return -1 }
        }
    }
    -1
}

fn flat_token(tokens: &mut lexer.Tokens, kind: lexer.Kind, move value: string, position: i32) {
    tokens.kinds.push(kind); tokens.texts.push(move value); tokens.starts.push(position)
}
// A pattern spans from the start of an arm up to its guard or arrow.
// Checking both ends keeps calls in guard expressions out of pattern scope.
fn pattern_start(loader: &Loader, first: i32, end: i32) -> i32 {
    mut pos := end - 1
    if is(&loader, pos, ")") {
        mut depth := 1
        pos = pos - 1
        while pos >= first && depth > 0 {
            if is(&loader, pos, ")") { depth = depth + 1 }
            else if is(&loader, pos, "(") { depth = depth - 1 }
            else if loader.raw.kinds[pos] != .Name && !is(&loader, pos, ",") && !is(&loader, pos, ".") { return -1 }
            pos = pos - 1
        }
    }
    if pos < first || loader.raw.kinds[pos] != .Name { return -1 }
    if !is(&loader, pos, "_") && !is(&loader, pos - 1, ".") { return -1 }
    while pos > first && is(&loader, pos - 1, ".") {
        pos = pos - 1
        if pos == first || loader.raw.kinds[pos - 1] != .Name { break }
        pos = pos - 1
    }
    mut before := pos - 1
    while before >= first && (loader.raw.kinds[before] == .Newline || is(&loader, before, ";")) { before = before - 1 }
    if !is(&loader, before, "{") && !is(&loader, before, ",") { return -1 }
    pos
}
// Walk backwards from arm arrows. Only an arrow at the same delimiter
// depth can follow a guard. An ordinary statement if after a call therefore
// cannot turn that call's arguments into payload bindings.
fn match_patterns(loader: &Loader, first: i32, last: i32, starts: &mut []i32, ends: &mut []i32) {
    mut waiting := false
    mut enclosing: []bool = []
    mut i := last
    mut hidden := lower_bound(&loader.hidden_starts, last) - 1
    while i > first {
        i = i - 1
        if hidden >= 0 && i < loader.hidden_ends[hidden] {
            i = loader.hidden_starts[hidden]; hidden = hidden - 1; continue
        }
        kind := loader.raw.kinds[i]
        if kind != .Symbol && (kind != .Keyword || !waiting) { continue }
        word := loader.raw.texts[i].clone()
        if kind == .Symbol {
            if word == "}" || word == "]" || word == ")" {
                if waiting || enclosing.len > 0 { enclosing.push(waiting); waiting = false }
                continue
            }
            if word == "{" || word == "[" || word == "(" {
                waiting = false
                if enclosing.len > 0 { waiting = enclosing.pop() }
                continue
            }
            if word == "," || word == ";" { waiting = false; continue }
            if word != "=>" { continue }
            waiting = true
        } else if word != "if" { continue }
        mut end := i
        while end > first && loader.raw.kinds[end - 1] == .Newline { end = end - 1 }
        start := pattern_start(&loader, first, end)
        if start >= 0 {
            starts.push(start); ends.push(end)
            waiting = false
        }
    }
}
// Stream unmodified spans with one tight pass over the raw token columns.
fn copy_body_tokens(raw: &lexer.Tokens, output: &mut lexer.Tokens, first: i32, last: i32, offset: i32, initials: i64) -> i32 {
    mut i := first
    while i < last {
        kind := raw.kinds[i]
        value := raw.texts[i].clone()
        if kind == .Name {
            if value[0] == 95 || initials.bit_and(initial_bit(value)) != 0 { break }
        } else if kind == .Symbol {
            if value == "{" || value == "}" { break }
        } else if kind == .End { break }
        flat_token(&mut output, kind, move value, offset + raw.starts[i])
        i = i + 1
    }
    i
}
fn flatten(loader: &mut Loader, owner: i32, output: &mut []i32, tokens: &mut lexer.Tokens, start: i32) {
    if loader.result.token_offsets {
        loader.result.map_starts.push(start); loader.result.map_files.push(owner)
    }
    mut i := loader.first[owner]
    last := loader.last[owner]
    mut hidden := lower_bound(&loader.hidden_starts, i)
    mut declaration := lower_bound(&loader.declaration_tokens, i)
    mut depth := 0
    // mode: 0 top level, 1 function signature, 2 function body, 3 record, 4 enum.
    mut mode := 0
    mut locals: []string = []
    mut levels: []i32 = []
    mut active: []i32 = []
    mut brace_scopes: []bool = []; mut delimiter_stack: []i32 = []
    mut pattern_starts: []i32 = []; mut pattern_ends: []i32 = []
    if loader.last_arm[owner] >= i { match_patterns(&loader, i, loader.last_arm[owner] + 1, &mut pattern_starts, &mut pattern_ends) }
    initials := loader.namespace_initials[owner]
    mut pattern := pattern_starts.len - 1; mut enum_parens := 0
    mut arm_locals: []i32 = []; mut arm_depths: []i32 = []
    mut arm_depth := 0
    mut previous := -1
    mut case_target := ""
    mut case_end := -1
    mut case_arrow := -1
    mut expected_end := -1
    while i < last && loader.result.ok {
        while pattern >= 0 && i >= pattern_ends[pattern] { pattern = pattern - 1 }
        if loader.result.token_offsets && !loader.testing && mode == 2 && arm_depths.len == 0 {
            mut limit := last
            if pattern >= 0 { limit = pattern_starts[pattern] }
            if hidden < loader.hidden_starts.len && loader.hidden_starts[hidden] < limit { limit = loader.hidden_starts[hidden] }
            next := copy_body_tokens(&loader.raw, &mut tokens, i, limit, start, initials)
            if next > i { previous = next - 1; i = next; continue }
        }
        if hidden < loader.hidden_starts.len && i == loader.hidden_starts[hidden] {
            i = loader.hidden_ends[hidden]; hidden = hidden + 1; continue
        }
        group := loader.next_test
        if group < loader.test_tags.len && i == loader.test_tags[group] {
            loader.next_test = group + 1
            target := loader.renamed[lower_bound(&loader.declaration_tokens, loader.test_targets[group])].clone()
            case_end = loader.test_ends[group]
            if case_end >= 0 {
                wrapper := "__dunder_module_test_" + group.str()
                loader.result.calls.push(wrapper.clone()); case_target = target
                emit(&mut loader, &mut output, owner, i, "@test fn " + wrapper + "()")
                mode = 2
            } else {
                loader.result.calls.push(move target)
                emit(&mut loader, &mut output, owner, i, "@test")
            }
            i = i + 2; continue
        }
        if i < case_end && is(&loader, i, "(") && (is(&loader, previous, ";") || is(&loader, previous, "{") || (previous >= 0 && loader.raw.kinds[previous] == .Newline)) {
            arrow := argument_case_arrow(&loader, i, case_end)
            if arrow >= 0 { case_arrow = arrow; emit(&mut loader, &mut output, owner, i, case_target) }
        }
        if i == case_arrow {
            expected_end = binding_end(&loader, i, case_end)
            emit(&mut loader, &mut output, owner, i, "== ("); previous = i; i = i + 1; continue
        }
        if i == expected_end { emit(&mut loader, &mut output, owner, i, ")"); expected_end = -1 }
        kind := loader.raw.kinds[i]
        if kind == .End { i = i + 1; continue }
        if kind == .Newline {
            if loader.result.token_offsets { flat_token(&mut tokens, kind, "\n", start + loader.raw.starts[i]) } else { output.push(10) }
            previous = i; i = i + 1; continue
        }
        value := loader.raw.texts[i].clone()
        in_pattern := pattern >= 0 && i >= pattern_starts[pattern]
        if in_pattern && i == pattern_starts[pattern] && is(&loader, pattern_ends[pattern] - 1, ")") {
            if arm_depths.len == 0 { arm_depth = 0 }
            arm_depths.push(arm_depth); arm_locals.push(locals.len)
        }
        if mode == 2 && kind == .Symbol {
            if arm_depths.len > 0 {
                // A comma inside a call, array, or nested match belongs to
                // the arm expression, not to the enclosing list of patterns.
                if arm_depth == arm_depths[arm_depths.len - 1] && (value == "," || value == "}") {
                    first := arm_locals.pop(); level := arm_depths.pop()
                    while locals.len > first { name := locals.pop(); scope := levels.pop(); begin := active.pop() }
                }
                if value == "(" || value == "[" || value == "{" { arm_depth = arm_depth + 1 }
                if value == ")" || value == "]" || value == "}" { arm_depth = arm_depth - 1 }
            }
        }
        if depth == 0 && is(&loader, i, "fn") && i + 1 < last && declaration < loader.declaration_tokens.len && loader.declaration_tokens[declaration] == i + 1 { mode = 1; locals.clear(); levels.clear(); active.clear() }
        if depth == 0 && is(&loader, i, "struct") { mode = 3 }
        if depth == 0 && is(&loader, i, "enum") { mode = 4 }
        if mode == 4 && kind == .Symbol {
            if value == "(" { enum_parens = enum_parens + 1 } else if value == ")" { enum_parens = enum_parens - 1 }
        }
        mut spelling := ""
        if !loader.result.token_offsets && (kind == .String || kind == .Rune || kind == .Byte) {
            if kind == .String && loader.raw.starts[i] == loader.raw.ends[i] { spelling = string_literal(value) }
            else { spelling = loader.result.sources[owner][loader.raw.starts[i]..loader.raw.ends[i]] }
        }
        mut lexical_brace := true
        opens := kind == .Symbol && value == "{"
        if mode == 2 && opens { lexical_brace = !constructor_brace(&loader, owner, i, &locals, &active) }
        mut expression_fields := false
        if brace_scopes.len > 0 { expression_fields = !brace_scopes[brace_scopes.len - 1] }
        mut consumed := 1
        if kind == .Name {
            if begins(value, "__dunder_module_") || (begins(value, "__sys_") && loader.standard[owner] != "sys") {
                fail(&mut loader, owner, loader.raw.starts[i], "reserved compiler identifier '" + value + "'"); return
            }
        }
        if kind == .Name && initials.bit_and(initial_bit(value)) != 0 {
            field := is(&loader, i + 1, ":")
            // Bare payload names are bindings. A name in Type.Variant or
            // module.Type.Variant resolves through the type namespace.
            payload := in_pattern && (is(&loader, previous, "(") || is(&loader, previous, ",")) && (is(&loader, i + 1, ")") || is(&loader, i + 1, ","))
            mut binding := payload
            if mode == 1 && field { binding = true }
            if mode == 2 {
                if !expression_fields && (is(&loader, i + 1, ":=") || (field && (previous < 0 || loader.raw.kinds[previous] == .Newline || is(&loader, previous, "{") || is(&loader, previous, ";") || is(&loader, previous, "var") || is(&loader, previous, "mut")))) { binding = true }
                if is(&loader, previous, "for") { binding = true }
                if previous > 0 && is(&loader, previous, "scope") && is(&loader, previous - 1, "task") { binding = true }
            }
            if binding && value != "_" {
                mut level := depth
                mut visible := i
                if payload { visible = pattern_ends[pattern] }
                else if mode == 2 {
                    visible = binding_end(&loader, i, last)
                    if previous > 0 && is(&loader, previous, "scope") && is(&loader, previous - 1, "task") {
                        level = depth + 1
                        visible = balanced_end(&loader.raw.kinds, &loader.raw.texts, i + 1, last, &mut delimiter_stack)
                        if visible < 0 { visible = last }
                    }
                    if is(&loader, previous, "for") {
                        level = depth + 1
                        visible = iterator_body(&loader, owner, i, last, &locals, &active, &mut delimiter_stack)
                    }
                }
                locals.push(value.clone()); levels.push(level); active.push(visible)
            }
            after_dot := is(&loader, previous, ".")
            enum_member := mode == 4 && depth == 1 && enum_parens == 0 && (previous < 0 || loader.raw.kinds[previous] == .Newline || is(&loader, previous, "{") || is(&loader, previous, ","))
            if declaration < loader.declaration_tokens.len && loader.declaration_tokens[declaration] == i {
                spelling = loader.renamed[declaration].clone(); declaration = declaration + 1
            }
            else if !after_dot && !field && !binding && !enum_member && (in_pattern || !local(&locals, &active, i, value)) {
                entry := key(&loader, owner, value)
                mut alias := -1
                if is(&loader,i+1,".") && i+2 < last && loader.raw.kinds[i+2] == .Name { alias = i32(map.get_or(&loader.imports,entry,-1)) }
                if alias >= 0 {
                    member := loader.raw.texts[i + 2].clone()
                    found := i32(map.get_or(&loader.symbols, key(&loader, alias, member), -1))
                    if found < 0 { fail(&mut loader, owner, loader.raw.starts[i], "module '" + value + "' has no declaration '" + member + "'"); return }
                    if !loader.public[found] { fail(&mut loader, owner, loader.raw.starts[i], "'" + value + "." + member + "' is private; export it with pub"); return }
                    if !check_caps(&mut loader, owner, i, found) { return }
                    spelling = loader.renamed[found].clone(); consumed = 3
                } else {
                    found := i32(map.get_or(&loader.symbols, entry, -1))
                    if found >= 0 {
                        if !check_caps(&mut loader, owner, i, found) { return }
                        spelling = loader.renamed[found].clone()
                    }
                }
            }
        }
        closes := kind == .Symbol && value == "}"
        if spelling == "" { spelling = value }
        if loader.result.token_offsets { flat_token(&mut tokens,kind,move spelling,start + loader.raw.starts[i]) }
        else { emit(&mut loader, &mut output, owner, i, spelling) }
        if opens {
            brace_scopes.push(lexical_brace)
            depth = depth + 1
            if mode == 1 { mode = 2 }
        }
        if closes {
            mut lexical := true
            if brace_scopes.len > 0 { lexical = brace_scopes.pop() }
            if lexical {
                while levels.len > 0 && levels[levels.len - 1] >= depth && active[active.len - 1] <= i { name := locals.pop(); level := levels.pop(); begin := active.pop() }
            }
            depth = depth - 1
            if depth == 0 { mode = 0; locals.clear(); levels.clear(); active.clear() }
        }
        previous = i + consumed - 1
        i = i + consumed
    }
    if loader.result.token_offsets { flat_token(&mut tokens,.Newline,"\n",start+loader.result.sources[owner].len) }
    else { output.push(10) }
}
pub fn location(loaded: &Loaded, offset: i32) -> Location {
    mut lo := 0
    mut hi := loaded.map_starts.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if loaded.map_starts[mid] <= offset { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return Location { path: loaded.path.clone(), source: loaded.sources[0].clone(), offset: 0 } }
    index := lo - 1
    owner := loaded.map_files[index]
    if loaded.token_offsets {
        return Location { path: loaded.paths[owner].clone(), source: loaded.sources[owner].clone(), offset: offset - loaded.map_starts[index] }
    }
    Location { path: loaded.paths[owner].clone(), source: loaded.sources[owner].clone(), offset: loaded.map_offsets[index] }
}
pub fn load(path: string) -> Loaded { load_mode(path, false) }
pub fn load_mode(path: string, testing: bool) -> Loaded {
    mut unused := lexer.empty(false)
    load_for(path, testing, false, &mut unused)
}
pub fn load_for(path: string, testing: bool, token_offsets: bool, tokens: &mut lexer.Tokens) -> Loaded {
    load_group(path, testing, token_offsets, -1, false, &mut tokens)
}

pub fn load_group(path: string, testing: bool, token_offsets: bool, group: i32, wasm_suite: bool, tokens: &mut lexer.Tokens) -> Loaded {
    mut loader := Loader {
        result: Loaded { token_offsets: token_offsets, groups: [], calls: [], ok: true, error: "", path: path.clone(), source: "", offset: 0,
            paths: [], sources: [], symbols: [], map_starts: [], map_ends: [], map_files: [], map_offsets: [] },
        key_prefixes: [], standard: [], directories: [], first: [], last: [], raw: lexer.empty(false), last_arm: [], namespace_initials: [], hidden_starts: [], hidden_ends: [], declaration_tokens: [], any_unsafe: false, caps: [], requires_caps: [],
        symbols: map.new(), imports: map.new(), by_path: map.new(), by_std: map.new(), owners: [], public: [], records: [], renamed: [],
        testing: testing, test_tags: [], test_targets: [], test_ends: [], next_test: 0,
    }
    loader.raw.store_ends = !token_offsets
    root := add(&mut loader, path, "", -1, 0)
    mut owner := 0
    while owner < loader.result.paths.len && loader.result.ok { scan(&mut loader, owner); owner = owner + 1 }
    mut output: []i32 = []
    if loader.result.ok {
        if token_offsets {
            reserve_tokens := loader.raw.kinds.len + 8
            tokens.kinds.reserve(reserve_tokens); tokens.texts.reserve(reserve_tokens)
            tokens.starts.reserve(reserve_tokens)
        } else {
            mut total_bytes := 32
            for s in &loader.result.sources { total_bytes = total_bytes + s.len + 2 }
            output.reserve(total_bytes)
        }
    }
    if loader.any_unsafe {
        if token_offsets {
            flat_token(&mut tokens,.Name,"capability",0);flat_token(&mut tokens,.Name,"unsafe",0);flat_token(&mut tokens,.Newline,"\n",0)
        } else { text(&mut output,"capability unsafe\n") }
    }
    mut position := 0
    owner = 0
    while owner < loader.result.paths.len && loader.result.ok {
        flatten(&mut loader, owner, &mut output, &mut tokens, position)
        position = position + loader.result.sources[owner].len + 1; owner = owner + 1
    }
    if token_offsets && loader.result.ok {
        flat_token(&mut tokens,.End,"",position)
        return loader.result
    }
    if loader.result.ok {
        if testing {
            if group >= loader.result.calls.len {
                fail(&mut loader, 0, 0, "test group ID is out of range")
                return loader.result
            }
            if group >= 0 || wasm_suite { test_suite.direct_entry(&mut output, &loader.result.calls, group) }
            else { test_suite.entry(&mut output, &loader.result.groups, &loader.result.calls) }
        }
        decoded := bytes.utf8(&output)
        loader.result.source = decoded.value
    }
    loader.result
}

@test fn dotted_names_and_literal_slash_paths_resolve_relative_modules() {
    bare_path("...shared.value") == "../../shared/value"
    bare_path("../../libs.v1/pair-value") == "../../libs.v1/pair-value"
    bare_path("std..map") == ""
    bare_path("std.map.ddr") == ""
    !valid_alias("pair-value")
    !valid_alias("ptr")
    !valid_alias("TaskID")
    valid_alias("pair")
}

@test fn paths_collapse_components_without_losing_relative_parents() {
    normalize("./src/../main.ddr") == "main.ddr"
    normalize("../../lib/./module.ddr") == "../../lib/module.ddr"
    normalize("/../src//nested/../main.ddr") == "/src/main.ddr"
    normalize("a/..") == "."
    normalize("/") == "/"
}

@test fn diagnostics_select_original_module_and_token_offset() {
    loaded := Loaded { token_offsets: false, groups: [], calls: [],
        ok: true, error: "", path: "main.ddr", source: "fn main", offset: 0,
        paths: ["main.ddr", "lib.ddr"], symbols: [], sources: ["fn main() {}", "\nfn value() {}"],
        map_starts: [0, 3, 20], map_ends: [2, 7, 25], map_files: [0, 0, 1], map_offsets: [0, 3, 4],
    }
    first := location(&loaded, 0)
    first.path == "main.ddr"
    first.offset == 0
    last := location(&loaded, 22)
    last.path == "lib.ddr"
    last.source == "\nfn value() {}"
    last.offset == 4
}

@test fn header_delimiters_balance_nested_calls_indexes_records_and_literals() {
    tokens := lexer.scan("(read([Bound{value: step(0)}, Bound{value: 1}][0].value, \"}])\")) { body }", false)
    mut stack: []i32 = []
    after := balanced_end(&tokens.kinds, &tokens.texts, 0, tokens.kinds.len, &mut stack)
    after > 0
    tokens.texts[after] == "{"
    tokens.texts[after - 1] == ")"
    bad := lexer.scan("([)]", false)
    balanced_end(&bad.kinds, &bad.texts, 0, bad.kinds.len, &mut stack) == -1
    missing := lexer.scan("(read(Bound{value: 1})", false)
    balanced_end(&missing.kinds, &missing.texts, 0, missing.kinds.len, &mut stack) == -1
}
