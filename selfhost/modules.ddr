// Module loading and namespace resolution for the Dunder compiler.
// Parallel arrays deliberately keep the bootstrap data model small.
import cache_io
import test_suite
import lexer
import bundled
import std.map as map
import std.text as strings
import std.bytes as bytes
import sys

pub struct Location { path: string, source: string, offset: i32 }
pub struct Loaded {
    token_offsets: bool,
    groups: []string, calls: []string,
    ok: bool, error: string, path: string, source: string, offset: i32,
    paths: []string, sources: []string, symbols: []string,
    map_starts: []i32, map_ends: []i32, map_files: []i32, map_offsets: []i32,
}
struct Loader {
    result: Loaded, standard: []string, directories: []string, first: []i32, last: []i32,
    kinds: []lexer.Kind, texts: []string, starts: []i32, ends: []i32,
    omit: []bool, declared: []i32, any_unsafe: bool, filesystem: []bool, requires_fs: []bool,
    symbols: map.Map, imports: map.Map, names: []string, owners: []i32,
    public: []bool, records: []bool, renamed: []string,
    testing: bool, test_tags: []i32, test_targets: []i32, test_ends: []i32, next_test: i32,
    groups: []string, calls: []string,
}
fn key(owner: i32, name: string) -> string { owner.str() + ":" + name }
fn begins(text: string, prefix: string) -> bool {
    if text.len < prefix.len { return false }
    var i := 0
    while i < prefix.len { if text[i] != prefix[i] { return false }; i = i + 1 }
    true
}
fn text(output: &mut []i32, value: string) {
    output.reserve(output.len + value.len)
    var i := 0
    while i < value.len { output.push(value[i]); i = i + 1 }
}
pub fn normalize(path: string) -> string {
    var parts: []string = []
    absolute := path.len > 0 && path[0] == 47
    var start := 0
    var i := 0
    while i <= path.len {
        if i == path.len || path[i] == 47 {
            part := path[start..i]
            if part == ".." {
                if parts.len > 0 && parts[parts.len - 1] != ".." { old := parts.pop() }
                else if !absolute { parts.push(part) }
            } else if part != "" && part != "." { parts.push(part) }
            start = i + 1
        }
        i = i + 1
    }
    var output: []i32 = []
    if absolute { output.push(47) }
    i = 0
    while i < parts.len {
        if i > 0 { output.push(47) }
        text(&mut output, parts[i]); i = i + 1
    }
    if output.len == 0 { return "." }
    decoded := bytes.utf8(&output)
    decoded.value
}
fn parent(path: string) -> string {
    var i := path.len
    while i > 0 { i = i - 1; if path[i] == 47 { if i == 0 { return "/" }; return path[0..i] } }
    "."
}
fn fail(loader: &mut Loader, owner: i32, offset: i32, message: string) {
    if !loader.result.ok { return }
    loader.result.ok = false; loader.result.error = message
    loader.result.path = loader.result.paths[owner]
    loader.result.source = loader.result.sources[owner]
    loader.result.offset = offset
}
fn is(loader: &Loader, at: i32, value: string) -> bool {
    if at < 0 || at >= loader.texts.len { return false }
    kind := loader.kinds[at]
    if kind != .Name && kind != .Keyword && kind != .Symbol { return false }
    loader.texts[at] == value
}
fn add(loader: &mut Loader, path: string, standard: string, origin: i32, offset: i32) -> i32 {
    var actual := normalize(path)
    var directory := parent(actual)
    if standard == "" {
        physical := cache_io.root(path)
        if physical != "" {
            // A symbolic link may precede ".." or name the source itself.
            // Keep the requested spelling where it still identifies this file.
            if !sys.same_file(actual, physical) { actual = physical }
            if !sys.same_file(directory, parent(physical)) { directory = parent(physical) }
        } else { actual = path }
    }
    var i := 0
    while i < loader.result.paths.len {
        if standard != "" {
            if loader.standard[i] == standard { return i }
        } else if loader.standard[i] == "" {
            if loader.result.paths[i] == actual || sys.same_file(loader.result.paths[i], actual) { return i }
        }
        i = i + 1
    }
    var source := ""
    if standard != "" { source = bundled.source(standard) }
    else {
        read := sys.read_text(actual)
        if !read.ok {
            if origin >= 0 { fail(&mut loader, origin, offset, "cannot load module " + actual + ": " + sys.error_message(read.error)) }
            else { loader.result.ok = false; loader.result.path = actual; loader.result.error = "cannot load module: " + sys.error_message(read.error) }
            return -1
        }
        source = read.value
    }
    id := loader.result.paths.len
    loader.result.paths.push(actual); loader.result.sources.push(source)
    loader.directories.push(directory); loader.standard.push(standard); loader.first.push(0); loader.last.push(0)
    id
}
fn skip_lines(loader: &Loader, at: i32) -> i32 {
    var i := at
    while i < loader.texts.len && loader.kinds[i] == .Newline { i = i + 1 }
    i
}
fn close_block(loader: &Loader, at: i32) -> i32 {
    var i := at
    var depth := 0
    while i < loader.texts.len {
        if is(&loader, i, "{") { depth = depth + 1 }
        if is(&loader, i, "}") { depth = depth - 1; if depth == 0 { return i + 1 } }
        i = i + 1
    }
    -1
}
fn hide(loader: &mut Loader, first: i32, last: i32) {
    var i := first
    while i < last { loader.omit[i] = true; i = i + 1 }
}
fn name_byte(b: i32) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128
}
fn valid_alias(alias: string) -> bool {
    if alias == "" || begins(alias, "__") || !name_byte(alias[0]) { return false }
    for b in alias.bytes() { if !name_byte(b) && (b < 48 || b > 57) { return false } }
    for word in ["fn","pub","var","mut","if","else","while","for","in","return","break","continue","struct","enum","match","import","as","true","false","i32","i64","bool","print","len","range","assert","string","rune","f32","f64","u8","u16","u32","u64","usize","ptr","unsafe","extern","capability"] {
        if word == alias { return false }
    }
    true
}
fn bare_path(raw: string) -> string {
    if raw == "" || strings.ends_with(raw, ".ddr") { return "" }
    for b in raw.bytes() {
        if !name_byte(b) && (b < 48 || b > 57) && b != 45 && b != 46 && b != 47 { return "" }
    }
    if strings.find(raw, "/") >= 0 {
        if raw[0] == 47 || raw[raw.len-1] == 47 || strings.find(raw, "//") >= 0 || strings.ends_with(raw, "/.") || strings.ends_with(raw, "/..") { return "" }
        return raw
    }
    var dots := 0
    while dots < raw.len && raw[dots] == 46 { dots = dots + 1 }
    if dots == raw.len { return "" }
    var result := ""
    if dots == 1 { result = "./" }
    for i in 1..dots { result = result + "../" }
    for component in strings.split(raw[dots..raw.len], ".") {
        if component == "" { return "" }
        if result != "" && result[result.len-1] != 47 { result = result + "/" }
        result = result + component
    }
    result
}
fn import_module(loader: &mut Loader, owner: i32, at: i32) -> i32 {
    var i := at + 1
    var path := ""
    var alias := ""
    if i < loader.texts.len && loader.kinds[i] == .String {
        path = loader.texts[i]; i = i + 1
    } else {
        source := loader.result.sources[owner]
        first := loader.starts[i]
        var end := first
        while end < source.len && source[end] > 32 && source[end] != 59 { end = end + 1 }
        path = bare_path(source[first..end])
        if path == "" { fail(&mut loader, owner, first, "invalid module path; use a relative name without a file suffix"); return i }
        while i < loader.texts.len && loader.starts[i] < end { i = i + 1 }
    }
    var component := 0
    for n in 0..path.len { if path[n] == 47 { component = n + 1 } }
    alias = path[component..path.len]
    if alias == "" || alias == "." || alias == ".." || strings.find(alias, ".") > 0 {
        fail(&mut loader, owner, loader.starts[at], "import a module name without a file suffix"); return i
    }
    if is(&loader, i, "as") {
        i = i + 1
        if i >= loader.texts.len || loader.kinds[i] != .Name { fail(&mut loader, owner, loader.starts[at], "expected an import alias"); return i }
        alias = loader.texts[i]; i = i + 1
    }
    if i < loader.texts.len && loader.kinds[i] != .Newline && loader.kinds[i] != .End && !is(&loader, i, ";") {
        fail(&mut loader, owner, loader.starts[i], "expected end of import"); return i
    }
    if is(&loader, i, ";") { i = i + 1 }
    if path == "" || path[0] == 47 || !valid_alias(alias) {
        fail(&mut loader, owner, loader.starts[at], "import a relative module name with a non-reserved alias"); return i
    }
    var standard := ""
    var target := ""
    var library := ""
    if path == "sys" { library = "sys" }
    if begins(path, "std/") { library = path[4..path.len] }
    if library != "" && bundled.contains(library) { standard = library; target = "<stdlib/" + library + ".ddr>" }
    else {
        if loader.standard[owner] != "" { fail(&mut loader, owner, loader.starts[at], "bundled libraries may only import bundled modules"); return i }
        target = loader.directories[owner] + "/" + path + ".ddr"
    }
    entry := key(owner, alias)
    if map.contains(&loader.imports, entry) || map.contains(&loader.symbols, entry) { fail(&mut loader, owner, loader.starts[at], "duplicate import alias '" + alias + "'"); return i }
    id := add(&mut loader, target, standard, owner, loader.starts[at])
    if id >= 0 { map.put(&mut loader.imports, entry, i64(id)) }
    hide(&mut loader, at, i)
    i
}
fn scan(loader: &mut Loader, owner: i32) {
    tokens := lexer.scan(loader.result.sources[owner], false)
    if !tokens.ok { fail(&mut loader, owner, tokens.error_at, tokens.error); return }
    first := loader.texts.len
    loader.first[owner] = first
    var i := 0
    while i < tokens.texts.len {
        loader.kinds.push(tokens.kinds[i]); loader.texts.push(tokens.texts[i])
        loader.starts.push(tokens.starts[i]); loader.ends.push(tokens.ends[i])
        loader.omit.push(false); loader.declared.push(-1)
        i = i + 1
    }
    last := loader.texts.len
    loader.last[owner] = last
    i = skip_lines(&loader, first)
    var capable := false
    var filesystem := false
    if is(&loader, i, "capability") {
        start := i; i = i + 1
        while i < last {
            if is(&loader, i, "unsafe") && !capable { capable = true; loader.any_unsafe = true }
            else if is(&loader, i, "filesystem") && !filesystem { filesystem = true }
            else { fail(&mut loader, owner, loader.starts[i], "unknown or duplicate module capability"); return }
            i = i + 1
            if !is(&loader, i, ",") { break }
            i = i + 1
        }
        if i < last && loader.kinds[i] != .Newline && loader.kinds[i] != .End && !is(&loader,i,";") {
            fail(&mut loader, owner, loader.starts[i], "expected end of capability declaration"); return
        }
        hide(&mut loader, start, i)
    }
    // Validate the module boundary even in omitted tests and unreachable bodies.
    for token in i..last {
        if loader.kinds[token] == .Name {
            name := loader.texts[token]
            if !capable && name == "unsafe" { fail(&mut loader,owner,loader.starts[token],"module requires capability unsafe");return }
            if name == "capability" { fail(&mut loader,owner,loader.starts[token],"declare capabilities at the beginning of the module");return }
        }
    }
    loader.filesystem.push(filesystem)
    var depth := 0
    var public := false
    var parens := 0
    var requires_fs := false
    while i < last && loader.result.ok {
        if depth > 0 {
            if loader.kinds[i] == .Symbol {
                punctuation := loader.texts[i]
                if punctuation == "{" { depth = depth + 1 }
                else if punctuation == "}" { depth = depth - 1 }
            }
            i = i + 1; continue
        }
        if depth == 0 && is(&loader,i,"@") && is(&loader,i+1,"requires") {
            if !is(&loader,i+2,"(") || !is(&loader,i+3,"filesystem") || !is(&loader,i+4,")") {
                fail(&mut loader,owner,loader.starts[i],"expected @requires(filesystem)"); return
            }
            var function := skip_lines(&loader,i+5)
            if is(&loader,function,"pub") { function=function+1 }
            if is(&loader,function,"unsafe") { function=function+1 }
            if !is(&loader,function,"fn") { fail(&mut loader,owner,loader.starts[i],"@requires applies to a function"); return }
            requires_fs=true;hide(&mut loader,i,i+5);i=i+5;continue
        }
        if depth == 0 && is(&loader, i, "import") { i = import_module(&mut loader, owner, i); public = false; continue }
        if depth == 0 && is(&loader, i, "@") && is(&loader, i + 1, "test") {
            tag := i
            body := skip_lines(&loader, i + 2)
            attached := is(&loader, body, "{")
            var after := body
            if attached { after = close_block(&loader, body) }
            if after < 0 { fail(&mut loader, owner, loader.starts[tag], "unterminated test block"); return }
            var function := skip_lines(&loader, after)
            if is(&loader, function, "pub") { function = skip_lines(&loader, function + 1) }
            if !is(&loader, function, "fn") {
                fail(&mut loader, owner, loader.starts[tag], "expected function after @test"); return
            }
            name := function + 1
            if name >= last || loader.kinds[name] != .Name { fail(&mut loader, owner, loader.starts[tag], "expected test function name"); return }
            if loader.testing {
                loader.test_tags.push(tag); loader.test_targets.push(name)
                if attached { loader.test_ends.push(after) } else { loader.test_ends.push(-1) }
                loader.groups.push(loader.result.paths[owner] + "::" + loader.texts[name])
                // Declarations in the attached body are local to its generated function.
                if attached { i = after } else { i = body }
            } else {
                if !attached {
                    while after < last && !is(&loader, after, "{") { after = after + 1 }
                    after = close_block(&loader, after)
                    if after < 0 { fail(&mut loader, owner, loader.starts[tag], "unterminated test function"); return }
                }
                hide(&mut loader, tag, after); i = after
            }
            continue
        }
        if depth == 0 && is(&loader, i, "pub") { public = true }
        if depth == 0 && parens == 0 && !is(&loader, i - 1, "extern") && ((is(&loader, i, "fn") && !is(&loader, i + 1, "(")) || is(&loader, i, "struct") || is(&loader, i, "enum")) {
            name_at := i + 1
            if name_at >= last || loader.kinds[name_at] != .Name { fail(&mut loader, owner, loader.starts[i], "expected declaration name"); return }
            name := loader.texts[name_at]
            entry := key(owner, name)
            if map.contains(&loader.symbols, entry) || map.contains(&loader.imports, entry) {
                fail(&mut loader, owner, loader.starts[name_at], "duplicate declaration '" + name + "'"); return
            }
            id := loader.names.len
            map.put(&mut loader.symbols, entry, i64(id))
            if requires_fs && owner==0 && name=="main" {fail(&mut loader,owner,loader.starts[name_at],"main cannot require a grant");return}
            loader.names.push(name); loader.owners.push(owner); loader.public.push(public)
            loader.records.push(is(&loader, i, "struct"))
            loader.requires_fs.push(requires_fs);requires_fs=false
            var renamed := "__dunder_module_" + id.str()
            if !loader.testing && owner == 0 && name == "main" && is(&loader, i, "fn") { renamed = "main" }
            loader.renamed.push(renamed); loader.declared[name_at] = id
            public = false
        }
        if is(&loader, i, "{") { depth = depth + 1 }
        if is(&loader, i, "}") { depth = depth - 1 }
        if is(&loader, i, "(") || is(&loader, i, "[") { parens = parens + 1 }
        if is(&loader, i, ")") || is(&loader, i, "]") { parens = parens - 1 }
        i = i + 1
    }
}
fn local(names: &[]string, active: &[]i32, at: i32, value: string) -> bool {
    var i := names.len
    while i > 0 { i = i - 1; if names[i] == value && at >= active[i] { return true } }
    false
}
// Balance every delimiter, including record literals nested in calls, indexes
// and parentheses. The scratch stack is reused across headers in this module.
fn balanced_end(kinds: &[]lexer.Kind, texts: &[]string, first: i32, last: i32, stack: &mut []i32) -> i32 {
    stack.clear()
    if first < 0 || first >= last || last > kinds.len || last > texts.len || kinds[first] != .Symbol { return -1 }
    if texts[first] != "(" && texts[first] != "[" && texts[first] != "{" { return -1 }
    var i := first
    while i < last {
        if kinds[i] == .Symbol {
            word := texts[i]
            var open := 0; var close := 0
            if word == "(" { open = 1 } else if word == "[" { open = 2 } else if word == "{" { open = 3 }
            if word == ")" { close = 1 } else if word == "]" { close = 2 } else if word == "}" { close = 3 }
            if open != 0 { stack.push(open) }
            if close != 0 {
                if stack.len == 0 || stack[stack.len - 1] != close { return -1 }
                previous := stack.pop()
                if stack.len == 0 { return i + 1 }
            }
        }
        i = i + 1
    }
    -1
}
// The full parser chooses a record constructor only when its leading name
// resolves to a nominal record, before considering the following brace. Use
// the same module/local distinction; a local or a field can shadow a type.
fn constructor_brace(loader: &Loader, owner: i32, at: i32, names: &[]string, active: &[]i32) -> bool {
    name_at := at - 1
    if name_at < 0 || loader.kinds[name_at] != .Name { return false }
    var source := owner
    if is(&loader, name_at - 1, ".") {
        alias := name_at - 2
        if alias < 0 || loader.kinds[alias] != .Name || is(&loader, alias - 1, ".") { return false }
        if local(&names, &active, alias, loader.texts[alias]) { return false }
        source = i32(map.get_or(&loader.imports, key(owner, loader.texts[alias]), -1))
        if source < 0 { return false }
    } else if local(&names, &active, name_at, loader.texts[name_at]) { return false }
    id := i32(map.get_or(&loader.symbols, key(source, loader.texts[name_at]), -1))
    id >= 0 && loader.records[id]
}
fn iterator_body(loader: &Loader, owner: i32, name: i32, last: i32, names: &[]string, active: &[]i32, stack: &mut []i32) -> i32 {
    var i := name + 2 // Skip the iterator name and its `in` token.
    while i < last {
        if loader.kinds[i] == .End || is(&loader, i, "}") { return last }
        if is(&loader, i, "(") || is(&loader, i, "[") || (is(&loader, i, "{") && constructor_brace(&loader, owner, i, &names, &active)) {
            after := balanced_end(&loader.kinds, &loader.texts, i, last, &mut stack)
            if after < 0 { return last }; i = after
        } else if is(&loader, i, "{") { return i }
        else { i = i + 1 }
    }
    last
}
fn binding_end(loader: &Loader, at: i32, last: i32) -> i32 {
    var i := at + 1
    var nested := 0
    while i < last {
        if nested == 0 && (loader.kinds[i] == .Newline || is(&loader, i, ";") || is(&loader, i, "}")) { return i }
        if is(&loader, i, "(") || is(&loader, i, "[") || is(&loader, i, "{") { nested = nested + 1 }
        if is(&loader, i, ")") || is(&loader, i, "]") || is(&loader, i, "}") { nested = nested - 1 }
        i = i + 1
    }
    i
}
fn emit(loader: &mut Loader, output: &mut []i32, owner: i32, token: i32, value: string) {
    loader.result.map_starts.push(output.len)
    text(&mut output, value)
    loader.result.map_ends.push(output.len)
    loader.result.map_files.push(owner); loader.result.map_offsets.push(loader.starts[token])
    output.push(32)
}
fn argument_case_arrow(loader: &Loader, first: i32, end: i32) -> i32 {
    var depth := 0
    for i in first..end {
        if is(&loader, i, "(") { depth = depth + 1 }
        if is(&loader, i, ")") {
            depth = depth - 1
            if depth == 0 { if is(&loader, i + 1, "->") { return i + 1 }; return -1 }
        }
    }
    -1
}

fn flat_token(tokens: &mut lexer.Tokens, kind: lexer.Kind, value: string, position: i32) {
    tokens.kinds.push(kind); tokens.texts.push(value); tokens.starts.push(position)
}
fn flatten(loader: &mut Loader, owner: i32, output: &mut []i32, tokens: &mut lexer.Tokens, start: i32) {
    if loader.result.token_offsets {
        loader.result.map_starts.push(start); loader.result.map_files.push(owner)
    }
    var i := loader.first[owner]
    last := loader.last[owner]
    var depth := 0
    // mode: 0 top level, 1 function signature, 2 function body, 3 record, 4 enum.
    var mode := 0
    var locals: []string = []
    var levels: []i32 = []
    var active: []i32 = []
    var brace_scopes: []bool = []; var delimiter_stack: []i32 = []
    var previous := -1
    var case_target := ""
    var case_end := -1
    var case_arrow := -1
    var expected_end := -1
    while i < last && loader.result.ok {
        if loader.omit[i] { i = i + 1; continue }
        group := loader.next_test
        if group < loader.test_tags.len && i == loader.test_tags[group] {
            loader.next_test = group + 1
            target := loader.renamed[loader.declared[loader.test_targets[group]]]
            case_end = loader.test_ends[group]
            if case_end >= 0 {
                wrapper := "__dunder_module_test_" + group.str()
                loader.calls.push(wrapper); case_target = target
                emit(&mut loader, &mut output, owner, i, "@test fn " + wrapper + "()")
                mode = 2
            } else {
                loader.calls.push(target)
                emit(&mut loader, &mut output, owner, i, "@test")
            }
            i = i + 2; continue
        }
        if i < case_end && is(&loader, i, "(") && (is(&loader, previous, ";") || is(&loader, previous, "{") || (previous >= 0 && loader.kinds[previous] == .Newline)) {
            arrow := argument_case_arrow(&loader, i, case_end)
            if arrow >= 0 { case_arrow = arrow; emit(&mut loader, &mut output, owner, i, case_target) }
        }
        if i == case_arrow {
            expected_end = binding_end(&loader, i, case_end)
            emit(&mut loader, &mut output, owner, i, "== ("); previous = i; i = i + 1; continue
        }
        if i == expected_end { emit(&mut loader, &mut output, owner, i, ")"); expected_end = -1 }
        kind := loader.kinds[i]
        if kind == .End { i = i + 1; continue }
        if kind == .Newline {
            if loader.result.token_offsets { flat_token(&mut tokens, kind, "\n", start + loader.starts[i]) } else { output.push(10) }
            previous = i; i = i + 1; continue
        }
        value := loader.texts[i]
        if depth == 0 && is(&loader, i, "fn") && i + 1 < last && loader.declared[i + 1] >= 0 { mode = 1; locals.clear(); levels.clear(); active.clear() }
        if depth == 0 && is(&loader, i, "struct") { mode = 3 }
        if depth == 0 && is(&loader, i, "enum") { mode = 4 }
        var spelling := value
        if !loader.result.token_offsets && (kind == .String || kind == .Rune) {
            spelling = loader.result.sources[owner][loader.starts[i]..loader.ends[i]]
        }
        var lexical_brace := true
        if mode == 2 && is(&loader, i, "{") { lexical_brace = !constructor_brace(&loader, owner, i, &locals, &active) }
        var expression_fields := false
        if brace_scopes.len > 0 { expression_fields = !brace_scopes[brace_scopes.len - 1] }
        var consumed := 1
        if kind == .Name {
            if begins(value, "__dunder_module_") || (begins(value, "__sys_") && loader.standard[owner] != "sys") {
                fail(&mut loader, owner, loader.starts[i], "reserved compiler identifier '" + value + "'"); return
            }
            declaration := loader.declared[i]
            field := is(&loader, i + 1, ":")
            var binding := false
            if mode == 1 && field { binding = true }
            if mode == 2 {
                if !expression_fields && (is(&loader, i + 1, ":=") || (field && (previous < 0 || loader.kinds[previous] == .Newline || is(&loader, previous, "{") || is(&loader, previous, ";") || is(&loader, previous, "var")))) { binding = true }
                if is(&loader, previous, "for") { binding = true }
            }
            if binding {
                var level := depth
                var visible := i
                if mode == 2 {
                    visible = binding_end(&loader, i, last)
                    if is(&loader, previous, "for") {
                        level = depth + 1
                        visible = iterator_body(&loader, owner, i, last, &locals, &active, &mut delimiter_stack)
                    }
                }
                locals.push(value); levels.push(level); active.push(visible)
            }
            after_dot := is(&loader, previous, ".")
            enum_member := mode == 4 && depth == 1 && (previous < 0 || loader.kinds[previous] == .Newline || is(&loader, previous, "{") || is(&loader, previous, ","))
            if declaration >= 0 { spelling = loader.renamed[declaration] }
            else if !after_dot && !field && !binding && !enum_member && !local(&locals, &active, i, value) {
                entry := key(owner, value)
                var alias := -1
                if is(&loader,i+1,".") && i+2 < last && loader.kinds[i+2] == .Name { alias = i32(map.get_or(&loader.imports,entry,-1)) }
                if alias >= 0 {
                    member := loader.texts[i + 2]
                    found := i32(map.get_or(&loader.symbols, key(alias, member), -1))
                    if found < 0 { fail(&mut loader, owner, loader.starts[i], "module '" + value + "' has no declaration '" + member + "'"); return }
                    if !loader.public[found] { fail(&mut loader, owner, loader.starts[i], "'" + value + "." + member + "' is private; export it with pub"); return }
                    if loader.requires_fs[found] && !loader.filesystem[owner] {
                        fail(&mut loader,owner,loader.starts[i],"this function requires capability filesystem");return
                    }
                    spelling = loader.renamed[found]; consumed = 3
                } else {
                    found := i32(map.get_or(&loader.symbols, entry, -1))
                    if found >= 0 {
                        if loader.requires_fs[found] && !loader.filesystem[owner] {fail(&mut loader,owner,loader.starts[i],"this function requires capability filesystem");return}
                        spelling = loader.renamed[found]
                    }
                }
            }
        }
        if loader.result.token_offsets { flat_token(&mut tokens,kind,spelling,start + loader.starts[i]) }
        else { emit(&mut loader, &mut output, owner, i, spelling) }
        if is(&loader, i, "{") {
            brace_scopes.push(lexical_brace)
            depth = depth + 1
            if mode == 1 { mode = 2 }
        }
        if is(&loader, i, "}") {
            var lexical := true
            if brace_scopes.len > 0 { lexical = brace_scopes.pop() }
            if lexical {
                while levels.len > 0 && levels[levels.len - 1] >= depth { name := locals.pop(); level := levels.pop(); begin := active.pop() }
            }
            depth = depth - 1
            if depth == 0 { mode = 0; locals.clear(); levels.clear(); active.clear() }
        }
        previous = i + consumed - 1
        i = i + consumed
    }
    if loader.result.token_offsets { flat_token(&mut tokens,.Newline,"\n",start+loader.result.sources[owner].len) }
    else { output.push(10) }
}
pub fn location(loaded: &Loaded, offset: i32) -> Location {
    var lo := 0
    var hi := loaded.map_starts.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if loaded.map_starts[mid] <= offset { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return Location { path: loaded.path, source: loaded.sources[0], offset: 0 } }
    index := lo - 1
    owner := loaded.map_files[index]
    if loaded.token_offsets {
        return Location { path: loaded.paths[owner], source: loaded.sources[owner], offset: offset - loaded.map_starts[index] }
    }
    Location { path: loaded.paths[owner], source: loaded.sources[owner], offset: loaded.map_offsets[index] }
}
pub fn load(path: string) -> Loaded { load_mode(path, false) }
pub fn load_mode(path: string, testing: bool) -> Loaded {
    var unused := lexer.empty(false)
    load_for(path, testing, false, &mut unused)
}
pub fn load_for(path: string, testing: bool, token_offsets: bool, tokens: &mut lexer.Tokens) -> Loaded {
    load_group(path, testing, token_offsets, -1, false, &mut tokens)
}

pub fn load_group(path: string, testing: bool, token_offsets: bool, group: i32, wasm_suite: bool, tokens: &mut lexer.Tokens) -> Loaded {
    var loader := Loader {
        result: Loaded { token_offsets: token_offsets, groups: [], calls: [], ok: true, error: "", path: path, source: "", offset: 0,
            paths: [], sources: [], symbols: [], map_starts: [], map_ends: [], map_files: [], map_offsets: [] },
        standard: [], directories: [], first: [], last: [], kinds: [], texts: [], starts: [], ends: [], omit: [], declared: [], any_unsafe: false, filesystem: [], requires_fs: [],
        symbols: map.new(), imports: map.new(), names: [], owners: [], public: [], records: [], renamed: [],
        testing: testing, test_tags: [], test_targets: [], test_ends: [], next_test: 0, groups: [], calls: [],
    }
    root := add(&mut loader, path, "", -1, 0)
    var owner := 0
    while owner < loader.result.paths.len && loader.result.ok { scan(&mut loader, owner); owner = owner + 1 }
    var output: []i32 = []
    if loader.any_unsafe {
        if token_offsets {
            flat_token(&mut tokens,.Name,"capability",0);flat_token(&mut tokens,.Name,"unsafe",0);flat_token(&mut tokens,.Newline,"\n",0)
        } else { text(&mut output,"capability unsafe\n") }
    }
    var position := 0
    owner = 0
    while owner < loader.result.paths.len && loader.result.ok {
        flatten(&mut loader, owner, &mut output, &mut tokens, position)
        position = position + loader.result.sources[owner].len + 1; owner = owner + 1
    }
    if token_offsets && loader.result.ok {
        flat_token(&mut tokens,.End,"",position)
        loader.result.symbols = loader.names
        return loader.result
    }
    if loader.result.ok {
        if testing {
            if group >= loader.calls.len {
                fail(&mut loader, 0, 0, "test group ID is out of range")
                return loader.result
            }
            if group >= 0 || wasm_suite { test_suite.direct_entry(&mut output, &loader.calls, group) }
            else { test_suite.entry(&mut output, &loader.groups, &loader.calls) }
            loader.result.groups = loader.groups
            loader.result.calls = loader.calls
        }
        decoded := bytes.utf8(&output)
        loader.result.source = decoded.value
    }
    loader.result.symbols = loader.names
    loader.result
}

@test fn dotted_names_and_literal_slash_paths_resolve_relative_modules() {
    bare_path("...shared.value") == "../../shared/value"
    bare_path("../../libs.v1/pair-value") == "../../libs.v1/pair-value"
    bare_path("std..map") == ""
    bare_path("std.map.ddr") == ""
    !valid_alias("pair-value")
    !valid_alias("ptr")
    valid_alias("pair")
}

@test fn paths_collapse_components_without_losing_relative_parents() {
    normalize("./src/../main.ddr") == "main.ddr"
    normalize("../../lib/./module.ddr") == "../../lib/module.ddr"
    normalize("/../src//nested/../main.ddr") == "/src/main.ddr"
    normalize("a/..") == "."
    normalize("/") == "/"
}

@test fn diagnostics_select_original_module_and_token_offset() {
    loaded := Loaded { token_offsets: false, groups: [], calls: [],
        ok: true, error: "", path: "main.ddr", source: "fn main", offset: 0,
        paths: ["main.ddr", "lib.ddr"], symbols: [], sources: ["fn main() {}", "\nfn value() {}"],
        map_starts: [0, 3, 20], map_ends: [2, 7, 25], map_files: [0, 0, 1], map_offsets: [0, 3, 4],
    }
    first := location(&loaded, 0)
    first.path == "main.ddr"
    first.offset == 0
    last := location(&loaded, 22)
    last.path == "lib.ddr"
    last.source == "\nfn value() {}"
    last.offset == 4
}

@test fn header_delimiters_balance_nested_calls_indexes_records_and_literals() {
    tokens := lexer.scan("(read([Bound{value: step(0)}, Bound{value: 1}][0].value, \"}])\")) { body }", false)
    var stack: []i32 = []
    after := balanced_end(&tokens.kinds, &tokens.texts, 0, tokens.kinds.len, &mut stack)
    after > 0
    tokens.texts[after] == "{"
    tokens.texts[after - 1] == ")"
    bad := lexer.scan("([)]", false)
    balanced_end(&bad.kinds, &bad.texts, 0, bad.kinds.len, &mut stack) == -1
    missing := lexer.scan("(read(Bound{value: 1})", false)
    balanced_end(&missing.kinds, &missing.texts, 0, missing.kinds.len, &mut stack) == -1
}
