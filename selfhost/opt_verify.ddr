// Internal typed-model invariants. Source spelling and diagnostics belong to
// the frontend. Proof placement is checked here; proof witnesses remain the
// responsibility of the bounded analysis that produced them.
import opt_ir as ir

struct Walk { seen: []bool, active: []bool, declared: []bool, scopes: []i32, visits: i32 }
fn scalar(ty: i32) -> bool { ty >= 1 && ty <= 3 }
fn numeric(ty: i32) -> bool { ty == 1 || ty == 2 }
fn index(value: i32, count: i32) -> bool { value >= -1 && value < count }
fn covers(f: &ir.Function, node: i32, mask: i32) -> bool { f.effects[node].bit_and(mask) == mask }
fn enter(w: &mut Walk, f: &ir.Function, node: i32, depth: i32) -> bool {
    if node < 0 || node >= f.kinds.len || depth > 256 || w.visits >= 4096 { return false }
    // The reachable model is a tree. This rejects cycles and accidental
    // sharing without imposing parser allocation order on parent/child IDs.
    if w.seen[node] { return false }
    w.seen[node] = true; w.visits = w.visits + 1; true
}
fn active(w: &Walk, f: &ir.Function, local: i32) -> bool {
    local >= 0 && local < f.local_types.len && w.active[local]
}
fn array(w: &Walk, f: &ir.Function, local: i32) -> bool {
    active(&w, &f, local) && ir.array_type(f.local_types[local]) && f.local_param[local] >= 0
}
fn declare(w: &mut Walk, f: &ir.Function, local: i32) -> bool {
    if local < 0 || local >= f.local_types.len || w.declared[local] || f.local_param[local] >= 0 { return false }
    w.declared[local] = true; w.active[local] = true; w.scopes.push(local); true
}
fn leave(w: &mut Walk, height: i32) {
    while w.scopes.len > height { local := w.scopes.pop(); w.active[local] = false }
}
fn expression(w: &mut Walk, f: &ir.Function, node: i32, depth: i32) -> bool {
    if !enter(&mut w, &f, node, depth) { return false }
    kind := f.kinds[node]; ty := f.types[node]; left := f.left[node]; right := f.right[node]
    if kind < 1 || kind > 6 || !scalar(ty) || f.next[node] != -1 || f.third[node] != -1 { return false }
    var effect := ir.own_effects(kind, f.values[node])
    if kind == 1 {
        value := f.values[node]
        if left != -1 || right != -1 || f.locals[node] != -1 { return false }
        if ty == 1 && (value < -2147483648 || value > 2147483647) { return false }
        if ty == 3 && value != 0 && value != 1 { return false }
    } else if kind == 2 {
        local := f.locals[node]
        if left != -1 || right != -1 || f.values[node] != 0 || !active(&w, &f, local) { return false }
        if ty != f.local_types[local] { return false }
    } else if kind == 3 {
        op := f.values[node]
        if f.locals[node] != -1 || op < 1 || op > 13 { return false }
        if !expression(&mut w, &f, left, depth + 1) || !expression(&mut w, &f, right, depth + 1) { return false }
        actual := f.types[left]
        if f.types[right] != actual { return false }
        if op <= 5 { if !numeric(actual) || ty != actual { return false } }
        else if op <= 11 {
            if ty != 3 || (!numeric(actual) && !(actual == 3 && op <= 7)) { return false }
        } else if actual != 3 || ty != 3 { return false }
        effect = effect.bit_or(f.effects[left]).bit_or(f.effects[right])
    } else if kind == 4 {
        op := f.values[node]
        if f.locals[node] != -1 || right != -1 || (op != 1 && op != 2) { return false }
        if !expression(&mut w, &f, left, depth + 1) || f.types[left] != ty { return false }
        if (op == 1 && !numeric(ty)) || (op == 2 && ty != 3) { return false }
        effect = effect.bit_or(f.effects[left])
    } else {
        if !array(&w, &f, f.locals[node]) || f.values[node] != 0 || right != -1 { return false }
        if kind == 5 { if ty != 1 || left != -1 { return false } }
        else {
            if ty != 2 || !expression(&mut w, &f, left, depth + 1) || f.types[left] != 1 { return false }
            effect = effect.bit_or(f.effects[left])
        }
    }
    covers(&f, node, effect)
}
// Flow bits: fallthrough=1, return=2, break=4, continue=8. Validate dead
// statements too, but do not let them create reachable return coverage.
fn statement(w: &mut Walk, f: &ir.Function, node: i32, loops: i32, depth: i32) -> i32 {
    if !enter(&mut w, &f, node, depth) || f.types[node] != 0 { return -1 }
    kind := f.kinds[node]; left := f.left[node]; right := f.right[node]; third := f.third[node]
    local := f.locals[node]
    if kind < 10 || kind > 19 || f.values[node] != 0 { return -1 }
    var effect := ir.own_effects(kind, 0); var flow := 1
    if kind == 10 {
        if local != -1 || right != -1 || third != -1 { return -1 }
        height := w.scopes.len; var at := left
        while at >= 0 {
            child := statement(&mut w, &f, at, loops, depth + 1)
            if child < 0 { return -1 }
            effect = effect.bit_or(f.effects[at])
            if flow.bit_and(1) != 0 { flow = flow.bit_and(14).bit_or(child) }
            at = f.next[at]
        }
        leave(&mut w, height)
    } else if kind == 11 || kind == 12 {
        if local < 0 || right != -1 || third != -1 || !scalar(f.local_types[local]) { return -1 }
        if !expression(&mut w, &f, left, depth + 1) || f.types[left] != f.local_types[local] { return -1 }
        if kind == 11 { if !declare(&mut w, &f, local) { return -1 } }
        else if !active(&w, &f, local) || !f.local_mutable[local] { return -1 }
        effect = effect.bit_or(f.effects[left])
    } else if kind == 13 || kind == 14 {
        if local != -1 || right < 0 || f.kinds[right] != 10 || f.next[right] != -1 { return -1 }
        if !expression(&mut w, &f, left, depth + 1) || f.types[left] != 3 { return -1 }
        var nested := loops; if kind == 14 { nested = nested + 1 }
        yes := statement(&mut w, &f, right, nested, depth + 1)
        if yes < 0 { return -1 }
        effect = effect.bit_or(f.effects[left]).bit_or(f.effects[right])
        if kind == 14 {
            if third != -1 { return -1 }
            flow = yes.bit_and(2).bit_or(1)
        } else {
            var no := 1
            if third >= 0 {
                if f.kinds[third] != 10 || f.next[third] != -1 { return -1 }
                no = statement(&mut w, &f, third, loops, depth + 1)
                if no < 0 { return -1 }
                effect = effect.bit_or(f.effects[third])
            }
            flow = yes.bit_or(no)
        }
    } else if kind == 15 {
        if local != -1 || right != -1 || third != -1 { return -1 }
        if left >= 0 {
            if !expression(&mut w, &f, left, depth + 1) || f.types[left] != f.ret { return -1 }
            effect = effect.bit_or(f.effects[left])
        } else if f.ret != 0 { return -1 }
        flow = 2
    } else if kind == 16 || kind == 17 {
        if loops < 1 || local != -1 || left != -1 || right != -1 || third != -1 { return -1 }
        flow = 4; if kind == 17 { flow = 8 }
    } else if kind == 18 {
        if !array(&w, &f, local) || !ir.writable_array(f.local_types[local]) || third != -1 { return -1 }
        if !expression(&mut w, &f, left, depth + 1) || f.types[left] != 1 { return -1 }
        if !expression(&mut w, &f, right, depth + 1) || f.types[right] != 2 { return -1 }
        effect = effect.bit_or(f.effects[left]).bit_or(f.effects[right])
    } else {
        if local < 0 || f.local_types[local] != 1 || f.local_mutable[local] || third < 0 || f.kinds[third] != 10 || f.next[third] != -1 { return -1 }
        // Bounds cannot read their iterator; it comes into scope afterward.
        if !expression(&mut w, &f, left, depth + 1) || f.types[left] != 1 { return -1 }
        if !expression(&mut w, &f, right, depth + 1) || f.types[right] != 1 { return -1 }
        height := w.scopes.len
        if !declare(&mut w, &f, local) { return -1 }
        body := statement(&mut w, &f, third, loops + 1, depth + 1)
        if body < 0 { return -1 }
        leave(&mut w, height)
        effect = effect.bit_or(f.effects[left]).bit_or(f.effects[right]).bit_or(f.effects[third])
        flow = body.bit_and(2).bit_or(1)
    }
    if !covers(&f, node, effect) { return -1 }
    flow
}
pub fn validate(f: &ir.Function, optimized: bool) -> bool {
    count := f.kinds.len; locals := f.local_types.len
    if !f.supported || count < 1 || count > 2048 || locals > 256 || f.params < 0 || f.params > 8 || f.params > locals || f.ret < 0 || f.ret > 3 { return false }
    if f.types.len != count || f.left.len != count || f.right.len != count || f.third.len != count || f.next.len != count || f.values.len != count || f.locals.len != count || f.starts.len != count || f.effects.len != count || f.proofs.len != count { return false }
    if f.local_names.len != locals || f.local_mutable.len != locals || f.local_param.len != locals || f.local_at.len != locals { return false }
    if f.root < 0 || f.root >= count || f.kinds[f.root] != 10 || f.next[f.root] != -1 || f.visits < 0 || f.rewrites < 0 { return false }
    var w := Walk { seen: [], active: [], declared: [], scopes: [], visits: 0 }
    for i in 0..locals {
        ty := f.local_types[i]
        if (!scalar(ty) && !ir.array_type(ty)) || f.local_names[i] == "" || f.local_at[i] < 0 { return false }
        parameter := i < f.params
        if parameter { if f.local_param[i] != i || f.local_mutable[i] { return false } }
        else if f.local_param[i] != -1 || ir.array_type(ty) { return false }
        w.active.push(parameter); w.declared.push(parameter)
    }
    // Check all storage and references, including detached scratch nodes,
    // before any graph traversal can dereference a malformed child/local.
    for i in 0..count {
        kind := f.kinds[i]; proof := f.proofs[i]
        if ir.own_effects(kind, f.values[i]) < 0 || f.types[i] < 0 || f.types[i] > 3 || f.starts[i] < 0 || f.effects[i] < 0 || f.effects[i] > 31 || proof < 0 || proof > 3 { return false }
        if !index(f.left[i], count) || !index(f.right[i], count) || !index(f.third[i], count) || !index(f.next[i], count) || !index(f.locals[i], locals) { return false }
        if !optimized && proof != 0 { return false }
        if proof.bit_and(1) != 0 && !((kind == 3 && f.values[i] >= 1 && f.values[i] <= 5 && numeric(f.types[i])) || (kind == 4 && f.values[i] == 1 && numeric(f.types[i]))) { return false }
        if proof.bit_and(2) != 0 {
            local := f.locals[i]
            if kind != 6 || f.types[i] != 2 || local < 0 || f.local_types[local] != 20 { return false }
        }
        w.seen.push(false)
    }
    flow := statement(&mut w, &f, f.root, 0, 0)
    if flow < 0 || flow.bit_and(12) != 0 { return false }
    f.ret == 0 || flow.bit_and(1) == 0
}
