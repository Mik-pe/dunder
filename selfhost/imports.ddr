// Shared import order and AArch64 GOT fixups for the ELF and Mach-O writers.
pub struct Table { names: []string, ordinals: []i32 }
pub fn library_name(path: string, darwin: bool) -> string {
    if darwin && (path == "c" || path == "dl") { return "/usr/lib/libSystem.B.dylib" }
    if !darwin && path == "c" { return "libc.so.6" }
    if !darwin && path == "dl" { return "libdl.so.2" }
    path
}
pub fn libraries(paths: &[]string, darwin: bool) -> Table {
    var names: []string = []
    var ordinals: []i32 = []
    if darwin { names.push("/usr/lib/libSystem.B.dylib") }
    for path in paths {
        library := library_name(path, darwin)
        var index := 0
        while index < names.len && names[index] != library { index = index + 1 }
        if index == names.len { names.push(library) }
        ordinals.push(index + 1)
    }
    Table { names: names, ordinals: ordinals }
}

pub fn align(value: i32, alignment: i32) -> i32 {
    (value + alignment - 1) / alignment * alignment
}

pub fn set_le(output: &mut []u8, offset: i32, value: i64, width: i32) {
    assert(offset >= 0 && offset <= output.len - width)
    for i in 0..width { output[offset + i] = u8(value.shr(i * 8).bit_and(255)) }
}

pub fn relocate(output: &mut []u8, text: i32, text_len: i32, data: i32,
                symbols: i32, sites: &[]i32, slots: &[]i32) {
    assert(sites.len == slots.len)
    for i in 0..sites.len {
        assert(sites[i] >= 0 && sites[i] <= text_len - 8 && sites[i] % 4 == 0)
        assert(slots[i] < symbols)
        site := text + sites[i]
        var target := data
        if slots[i] < 0 { target = data + align(symbols * 8, 16) - 1 - slots[i] }
        else { target = data + slots[i] * 8 }
        pages := target / 4096 - site / 4096
        assert(pages >= 0 && pages < 1048576)
        adrp: i64 = i64(2415919120) + i64(pages % 4) * 536870912 + i64(pages / 4) * 32
        var load: i64 = i64(4181721616) + i64(target % 4096 / 8) * 1024
        if slots[i] < 0 { load = i64(2432696848) + i64(target % 4096) * 1024 } // add x16,x16,#lo12
        set_le(&mut output, site, adrp, 4)
        set_le(&mut output, site + 4, load, 4)
    }
}
