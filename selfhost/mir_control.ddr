// The complete observable ABI and effect shape of a symbolic operation must
// match its binding before canonical lowering may issue a target relocation.
import backend_row as row
import mir

pub fn valid(f: &mir.Function, op: i32) -> bool {
    reloc := f.reloc_kinds[op]; kind := f.kinds[op]
    if f.targets[op] < 0 || f.targets[op] >= f.source_labels || f.import_ids[op] != -1 ||
        f.b[op] != -1 || f.c[op] != -1 || f.place[op] != -1 || f.types[op] != 0 ||
        f.extensions[op] != 0 || f.stack_roles[op] != 0 || f.recipes[op] != 0 ||
        f.raw_starts[op] != -1 || f.widths[op] != 0 { return false }
    if reloc == 1 {
        tag := f.opcodes[op]
        if tag == 0 {
            if !row.valid_control(f.variant[op], reloc) || f.imm[op] != 0 || f.aux[op] != 0 { return false }
        } else if row.ownership_tag(tag) || row.is_task(tag) {
            if tag == row.task_tag(.ScopeClose) && f.aux[op] != 0 { return false }
            if tag == row.task_tag(.Spawn) {
                if f.variant[op] <= 0 || f.variant[op] > 2147483648 { return false }
            } else if f.variant[op] != 0 { return false }
            if f.imm[op] < 0 || f.imm[op] > 2147483647 || f.aux[op] < 0 { return false }
        } else { return false }
        return kind == 14 &&
            f.dst[op] == -1 && f.a[op] == -1 && f.abi[op] == 1 && f.effects[op] == 95 &&
            f.flags[op] == 3 && f.reads[op] == -1 && f.writes[op] == 0 && f.clobbers[op] == -1
    }
    if !row.valid_control(f.variant[op], reloc) { return false }
    if f.aux[op] != 0 || f.clobbers[op] != 0 || f.abi[op] != 0 { return false }
    if reloc == 20 {
        return kind == 9 && f.opcodes[op] == 0 && f.imm[op] == 0 &&
            f.dst[op] == 0 && f.a[op] == -1 && f.flags[op] == 0 &&
            f.effects[op] == 0 && f.reads[op] == 0 && f.writes[op] == 1
    }
    if f.dst[op] != -1 || f.effects[op] != 16 || f.writes[op] != 0 { return false }
    if reloc == 0 {
        return kind == 12 && f.opcodes[op] == 0 && f.imm[op] == 0 &&
            f.a[op] == -1 && f.flags[op] == 0 && f.reads[op] == 0
    }
    if kind != 13 { return false }
    if reloc == 18 || reloc == 19 {
        return f.opcodes[op] == reloc - 16 && f.imm[op] == 0 &&
            f.a[op] == 0 && f.flags[op] == 0 && f.reads[op] == 1
    }
    reloc >= 2 && reloc <= 17 && f.opcodes[op] == 1 && f.imm[op] == i64(reloc - 2) &&
        f.a[op] == -1 && f.flags[op] == 1 && f.reads[op] == 0
}
