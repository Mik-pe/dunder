import mir
import source_types
import mir_operation as decode
import place_operation as place

// Memory and frame operations retain the regular MIR memory/alias contract.
// The source token and referent type travel together in variant; the access
// and semantic operator travel in opcode. Optimizers may replace a proven read.
pub fn source_op(tag: i32, access: i32) -> i32 { tag + access * 128 }
pub fn memory_tag(op: i32) -> i32 { op % 128 }
pub fn memory_source(f: &mir.Function, id: i32) -> bool {
    op := f.opcodes[id]; tag := memory_tag(op)
    if op < 0 || op / 128 > 4 || f.variant[id] < 0 || f.variant[id].bit_and(2147483648) != 0 { return false }
    if !source_types.contains(&f.source_types, i32(f.variant[id].shr(32))) { return false }
    kind := f.kinds[id]
    if tag == place.tag(.Read) || tag == place.tag(.Write) {
        mut base := f.b[id]; mut value := f.a[id]
        if kind == 7 { base = f.a[id]; value = f.dst[id] }
        return f.imm[id] == 0 && f.recipes[id] == 0 && f.place_kinds[f.place[id]] == 0 &&
            value >= 0 && value < 31 && base >= 0 && base < 31 &&
            ((tag == place.tag(.Read) && kind == 7) || (tag == place.tag(.Write) && kind == 8))
    }
    if f.place_kinds[f.place[id]] != 1 || f.a[id] != 29 && kind != 8 { return false }
    if tag != place.tag(.LocalRead) && (f.aux[id] != 8 || f.extensions[id] != 0) { return false }
    if kind == 8 && f.a[id] != 0 || kind != 8 && f.dst[id] != 0 { return false }
    if tag == place.tag(.Temporary) {
        action := op / 128
        if action == i32(place.Temporary.LoadIndex) { return kind == 7 && f.recipes[id] == 1 }
        return action <= i32(place.Temporary.SaveIndex) && kind == 8 && f.recipes[id] == 2
    }
    return ((tag == place.tag(.LocalRead) || tag == place.tag(.BorrowSaved)) && kind == 7 && f.recipes[id] == 1) ||
        (tag == place.tag(.LocalWrite) && kind == 8 && f.recipes[id] == 2) ||
        (tag == place.tag(.BorrowHome) && kind == 9 && f.recipes[id] == 3)
}
pub fn set(f: &mut mir.Function, decoded: &mut decode.Decoded, id: i32, h: i64, d: i64) {
    tag := i32(h.shr(56)); form := place.form(h); parameter := place.parameter(d)
    access := place.access(h); ty := h.bit_and(2147483647); source := d.bit_and(2147483647)
    if tag == place.tag(.LocalRead) || tag == place.tag(.Read) || tag == place.tag(.Write) {
        mut base := parameter / 32; mut value := parameter % 32
        mut offset := 0; mut area := 0
        if tag == place.tag(.LocalRead) {
            base = 29; value = 0; offset = -(parameter + 1) * 8; area = 1; f.recipes[id] = 1
        }
        mut width := i32(1).shl(form); mut ext := 1
        if form == 4 { width = 4; ext = 2 } else if form == 3 { ext = 0 }
        f.aux[id] = width; f.imm[id] = i64(offset); f.types[id] = 2
        f.reads[id] = mir.variable_bit(base)
        if tag == place.tag(.Write) {
            f.kinds[id] = 8; f.a[id] = value; f.b[id] = base; ext = 0; f.effects[id] = 5
            f.reads[id] = f.reads[id].bit_or(mir.variable_bit(value))
            if width < 8 { f.types[id] = 1 }
        } else {
            f.kinds[id] = 7; f.dst[id] = value; f.a[id] = base; f.effects[id] = 3; f.extensions[id] = ext
            if ext == 1 { f.types[id] = 1 }
            f.writes[id] = mir.variable_bit(value)
            if area == 1 && parameter >= 32 { f.c[id] = 0; f.clobbers[id] = 1 }
        }
        p := mir.add_place(&mut f, area, offset, width, ext); f.place[id] = p
    } else if tag == place.tag(.BorrowHome) || tag == place.tag(.BorrowSaved) || tag == place.tag(.LocalWrite) || tag == place.tag(.Temporary) {
        mut recipe := 1; if tag == place.tag(.BorrowHome) { recipe = 3 } else if tag == place.tag(.LocalWrite) { recipe = 2 }
        if tag == place.tag(.Temporary) && access != i32(place.Temporary.LoadIndex) { recipe = 2 }
        decode.frame(&mut decoded, recipe, parameter, 0); decode.append_into(&decoded, &mut f, id)
        f.recipes[id] = recipe
        if recipe != 3 && parameter >= 32 { f.c[id] = 9 }
    } else {
        f.kinds[id] = 23; f.types[id] = i32(ty); f.aux[id] = form; f.imm[id] = i64(parameter)
        f.a[id] = 0; f.reads[id] = 1
        if tag == place.tag(.CopySetup) {
            f.dst[id] = 0
            if form == 0 { f.b[id] = 1; f.reads[id] = 3; f.writes[id] = 13 }
            else { f.writes[id] = 29; f.effects[id] = 3 }
        } else if tag == place.tag(.CopyTest) {
            f.a[id] = 3 + form; f.reads[id] = mir.variable_bit(f.a[id]); f.flags[id] = 2
        } else if tag == place.tag(.CopyPart) {
            f.effects[id] = 7; f.b[id] = 1
            if form == 0 { f.a[id] = 2; f.reads[id] = 14; f.writes[id] = 30 }
            else { f.reads[id] = 27; f.writes[id] = 51 }
        } else if tag == place.tag(.RegionWrite) || tag == place.tag(.Member) {
            f.b[id] = 1; f.reads[id] = 3; f.effects[id] = 5
            if tag == place.tag(.RegionWrite) {
                f.effects[id] = 7; f.writes[id] = 4
                if parameter > 4096 { f.writes[id] = 28 }
            } else if place.member_write(form) {
                if parameter >= 4096 { f.writes[id] = 4 }
            } else {
                f.b[id] = -1; f.dst[id] = 0; f.reads[id] = 1; f.effects[id] = 3; f.writes[id] = 1
                if parameter >= 4096 { f.writes[id] = 5 }
            }
        } else if tag == place.tag(.Field) {
            f.dst[id] = 0; f.writes[id] = 1
            if parameter >= 4096 { f.writes[id] = 5 }
        } else if tag == place.tag(.CheckIndex) {
            f.b[id] = 1; f.reads[id] = 3; f.dst[id] = 2; f.writes[id] = 4; f.flags[id] = 2; f.effects[id] = 3
        } else if tag == place.tag(.Element) {
            f.b[id] = 1; f.reads[id] = 3; f.dst[id] = 0; f.writes[id] = 1
            if form != 0 { f.writes[id] = 3; f.effects[id] = 3 }
            if form == 2 { f.writes[id] = 7 }
        }
    }
    f.opcodes[id] = source_op(tag, access); f.variant[id] = ty.shl(32).bit_or(source)
}
pub fn valid(f: &mir.Function, id: i32) -> bool {
    op := f.opcodes[id]; tag := memory_tag(op); form := f.aux[id]; param := f.imm[id]
    if !source_types.contains(&f.source_types, f.types[id]) || op < 0 || op / 128 > 4 || f.variant[id] < 0 || f.variant[id].bit_and(2147483648) != 0 ||
        i64(f.types[id]) != f.variant[id].shr(32) || form < 0 || param < 0 || param > 16777215 ||
        !place.valid(tag, form, i32(param)) || f.c[id] != -1 ||
        f.place[id] != -1 || f.recipes[id] != 0 || f.extensions[id] != 0 || f.abi[id] != 0 ||
        f.stack_roles[id] != 0 || f.clobbers[id] != 0 || f.raw_starts[id] != -1 || f.widths[id] != 0 ||
        f.reloc_kinds[id] != -1 || f.targets[id] != -1 || f.import_ids[id] != -1 { return false }
    if tag == place.tag(.CopyTest) {
        return f.a[id] == 3 + form && f.b[id] == -1 && f.dst[id] == -1 && f.reads[id] == mir.variable_bit(3 + form) &&
            f.flags[id] == 2 && f.writes[id] == 0 && f.effects[id] == 0
    }
    if tag == place.tag(.CopyPart) {
        if f.b[id] != 1 || f.dst[id] != -1 || f.flags[id] != 0 || f.effects[id] != 7 { return false }
        if form == 0 { return f.a[id] == 2 && f.reads[id] == 14 && f.writes[id] == 30 }
        return f.a[id] == 0 && f.reads[id] == 27 && f.writes[id] == 51
    }
    if f.a[id] != 0 { return false }
    if tag == place.tag(.CopySetup) {
        if f.dst[id] != 0 || f.flags[id] != 0 { return false }
        if form == 0 { return f.b[id] == 1 && f.reads[id] == 3 && f.writes[id] == 13 && f.effects[id] == 0 }
        return f.b[id] == -1 && f.reads[id] == 1 && f.writes[id] == 29 && f.effects[id] == 3
    }
    if tag == place.tag(.RegionWrite) || tag == place.tag(.Member) {
        if tag == place.tag(.Member) && !place.member_write(form) {
            mut mask: i64 = 1; if param >= 4096 { mask = 5 }
            return f.dst[id] == 0 && f.b[id] == -1 && f.flags[id] == 0 && f.reads[id] == 1 && f.writes[id] == mask && f.effects[id] == 3
        }
        if f.dst[id] != -1 || f.b[id] != 1 || f.flags[id] != 0 || f.reads[id] != 3 { return false }
        if tag == place.tag(.RegionWrite) {
            mut mask: i64 = 4; if param > 4096 { mask = 28 }; return f.effects[id] == 7 && f.writes[id] == mask
        }
        mut mask: i64 = 0; if param >= 4096 { mask = 4 }; return f.effects[id] == 5 && f.writes[id] == mask
    }
    if tag == place.tag(.CheckIndex) {
        return f.b[id] == 1 && f.dst[id] == 2 && f.effects[id] == 3 && f.flags[id] == 2 && f.reads[id] == 3 && f.writes[id] == 4
    }
    if f.flags[id] != 0 { return false }
    if tag == place.tag(.Element) {
        mut writes: i64 = 1; mut effects := 0
        if form > 0 { writes = 3; effects = 3 }; if form == 2 { writes = 7 }
        return f.b[id] == 1 && f.dst[id] == 0 && f.reads[id] == 3 && f.writes[id] == writes && f.effects[id] == effects
    }
    if f.b[id] != -1 || f.effects[id] != 0 || f.reads[id] != 1 { return false }
    if tag == place.tag(.BorrowPayload) { return f.dst[id] == -1 && f.writes[id] == 0 }
    mut writes: i64 = 1; if param >= 4096 { writes = 5 }
    tag == place.tag(.Field) && f.dst[id] == 0 && f.writes[id] == writes
}
