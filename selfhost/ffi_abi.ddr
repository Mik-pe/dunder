// Foreign C ABI lowering, @c_layout inline value transfers, GOT/import stubs,
// Wasm FFI signatures, and C-to-Dunder callback trampolines.
import arm64 as arm
import ffi_arm64 as abi
import frontend_types as ft
import imports as native_libs
import unsigned
import floats
import wasm_abi as wa

pub struct Patches { sites: []i32, slots: []i32, globals: i32 }
pub fn new_patches(globals: i32) -> Patches { Patches { sites: [], slots: [], globals: globals } }

pub struct ForeignCallSpec {
    ret: i32, ret_c_record: bool, ret_hfa: i32,
    arg_types: []i32, arg_packed: []i32, arg_c_record: []bool, arg_hfas: []i32, arg_sizes: []i32,
}

pub fn load_mem(code: &mut arm.Code, destination: i32, base: i32, offset: i32) {
    arm.emit(&mut code, 4181721088 + i64(offset / 8) * 1024 + i64(base) * 32 + i64(destination))
}

pub fn store_mem(code: &mut arm.Code, source: i32, base: i32, offset: i32) {
    arm.emit(&mut code, 4177526784 + i64(offset / 8) * 1024 + i64(base) * 32 + i64(source))
}

pub fn static_address(code: &mut arm.Code, patches: &mut Patches, offset: i32) {
    if !code.checking {
        patches.sites.push(arm.position(&code) * 4)
        patches.slots.push(-1 - offset)
    }
    arm.emit(&mut code, 0); arm.emit(&mut code, 0)
}

pub fn transfer_c(code: &mut arm.Code, ty: i32, packed: i32, reg: i32, base: i32, load: bool) {
    if load && ty == 1 {
        arm.emit(&mut code, 3112173568 + i64(base) * 32 + i64(reg)); return
    }
    var kind := 11; width := ft.foreign_width(packed)
    if width == 1 { kind = 8 }
    if width == 2 { kind = 9 }
    if width == 4 { kind = 10 }
    unsigned.transfer(&mut code, kind, reg, base, load)
}

pub fn transfer_value(code: &mut arm.Code, packed: i32, reg: i32, base: i32, load: bool) {
    unsigned.transfer(&mut code, packed, reg, base, load)
}

pub fn extract_wasm_sig(reg_types: &ft.TypeRegistry, ty: i32, args: &mut []i32, ret: &mut i32, error: &mut string) -> bool {
    r := reg_types.type_bases[ty]
    first := reg_types.type_starts[ty]
    count := reg_types.type_counts[ty]
    if reg_types.c_record[r] { error = "pass Wasm C records by pointer"; return false }
    args.reserve(count)
    for i in first..first + count {
        arg := reg_types.ffi_params[i]
        if reg_types.c_record[arg] { error = "pass Wasm C records by pointer"; return false }
        args.push(arg)
    }
    ret = r
    true
}

pub fn library_name(lib: string, macos: bool) -> string { native_libs.library_name(lib, macos) }

// x0 points at source, x1 at destination. Returns destination in x0.
pub fn copy_inline(code: &mut arm.Code, bytes: i32) {
    arm.mov(&mut code, 2, 0); arm.mov(&mut code, 0, 1)
    arm.imm(&mut code, 3, i64(bytes)); head := arm.label(&mut code); done := arm.label(&mut code)
    arm.mark(&mut code, head); arm.emit(&mut code, 4043309183); arm.branch(&mut code, done, 2)
    arm.emit(&mut code, 960495684); arm.emit(&mut code, 956301348)
    arm.emit(&mut code, 2432697377); arm.emit(&mut code, 2432697410); arm.emit(&mut code, 3506439267)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
}

pub fn zero_record(code: &mut arm.Code, alloc_record: i32, bytes: i32) {
    arm.imm(&mut code, 0, i64(bytes)); arm.branch(&mut code, alloc_record, 1)
    arm.mov(&mut code, 1, 0); arm.imm(&mut code, 2, i64(bytes))
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.emit(&mut code, 4043309151); arm.branch(&mut code, done, 2)
    arm.emit(&mut code, 956301375); arm.emit(&mut code, 2432697377); arm.emit(&mut code, 3506439234)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
}

pub fn c_offset(code: &mut arm.Code, offset: i64) {
    if offset < 4096 { arm.emit(&mut code, 2432696320 + offset * 1024) }
    else { arm.imm(&mut code, 2, offset); arm.emit(&mut code, 2332164096) }
}

fn next_slot(slots: &mut i32, error: &mut string) -> i32 {
    res := slots; slots = slots + 1
    if slots > 65535 && error == "" { error = "this compiler stage allows at most 65535 local slots per function" }
    res
}

pub fn inline_value(code: &mut arm.Code, c_record: bool, kind: i32, ty: i32, packed: i32,
    count: i32, elem_c_size: i32, slots: &mut i32, error: &mut string) {
    if c_record { return }
    if kind != 6 { transfer_c(&mut code, ty, packed, 0, 0, true); return }
    last := next_slot(&mut slots, &mut error); cap := next_slot(&mut slots, &mut error)
    length := next_slot(&mut slots, &mut error); data := next_slot(&mut slots, &mut error)
    arm.store(&mut code, data, 0); arm.imm(&mut code, 0, i64(count))
    arm.store(&mut code, length, 0); arm.store(&mut code, cap, 0)
    var shift := 0
    while i32(1).shl(shift) < elem_c_size { shift = shift + 1 }
    arm.imm(&mut code, 0, i64(shift)); arm.store(&mut code, last, 0); arm.address(&mut code, data)
}

pub fn store_inline(code: &mut arm.Code, c_record: bool, c_size: i32, kind: i32, count: i32,
    ty: i32, packed: i32, elem: i32, elem_packed: i32, elem_c_size: i32) {
    if c_record { copy_inline(&mut code, c_size); return }
    if kind == 6 {
        load_mem(&mut code, 2, 0, 24); load_mem(&mut code, 0, 0, 0)
        arm.imm(&mut code, 3, 1); arm.emit(&mut code, 2596413539) // lsl x3,x3,x2
        arm.imm(&mut code, 4, i64(count)); head := arm.label(&mut code); done := arm.label(&mut code)
        arm.mark(&mut code, head); arm.emit(&mut code, 4043309215); arm.branch(&mut code, done, 2)
        transfer_c(&mut code, elem, elem_packed, 5, 0, true); transfer_c(&mut code, elem, elem_packed, 5, 1, false)
        arm.emit(&mut code, 2332229632); arm.emit(&mut code, 2432696353 + i64(elem_c_size) * 1024)
        arm.emit(&mut code, 3506439300); arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
        return
    }
    transfer_c(&mut code, ty, packed, 0, 1, false)
}

pub fn emit_foreign_call(code: &mut arm.Code, spec: &ForeignCallSpec, callee: i32,
    values: &[]i32, locations: &[]i32, result_slot: i32, indirect_result: bool, gp: i32, fp: i32, outgoing: i32,
    has_callbacks: bool, patches: &mut Patches, float_trap: i32, overflow: i32) {
    if outgoing > 0 { arm.emit(&mut code, 3506439167 + i64(outgoing) * 1024) }
    arm.load(&mut code, callee); arm.mov(&mut code, 17, 0)
    var i := values.len - 1
    while i >= 0 {
        where := locations[i]; ty := spec.arg_types[i]
        arm.load(&mut code, values[i])
        if spec.arg_c_record[i] {
            if where < 16 { abi.hfa(&mut code, 0, where - 8, spec.arg_hfas[i], true) }
            else {
                arm.emit(&mut code, 2432697321 + i64(where - 16) * 1024)
                abi.copy(&mut code, 9, 0, spec.arg_sizes[i])
            }
        } else if where < 8 { arm.mov(&mut code, where, 0) }
        else if where < 16 {
            var opcode: i64 = 2657550336; if ty == 6 { opcode = 505872384 }
            arm.emit(&mut code, opcode + i64(where - 8))
        } else {
            arm.emit(&mut code, 2432697321 + i64(where - 16) * 1024)
            transfer_c(&mut code, ty, spec.arg_packed[i], 0, 9, false)
        }
        i = i - 1
    }
    if indirect_result { arm.load(&mut code, result_slot) }
    if has_callbacks {
        if patches.globals < 64 { patches.globals = 64 }
        static_address(&mut code, &mut patches, 0)
        abi.load(&mut code, 10, 16, 48, 8); arm.store(&mut code, callee, 10)
        abi.thread_token(&mut code); abi.store(&mut code, 10, 16, 48, 8)
        if code.platform == 2 { arm.emit(&mut code, 4194304000) }
        else { for reg in 19..25 { abi.store(&mut code, reg, 16, (reg - 19) * 8, 8) } }
    }
    if code.platform == 2 { arm.emit(&mut code, 4261412864 + i64(gp) * 65536 + i64(fp) * 256 + i64(outgoing / 16)) }
    else {
        arm.emit(&mut code, 3594453536) // blr x17
        if has_callbacks {
            static_address(&mut code, &mut patches, 0)
            for reg in 19..25 { abi.load(&mut code, reg, 16, (reg - 19) * 8, 8) }
        }
    }
    if has_callbacks {
        arm.mov(&mut code, 13, 0); arm.load(&mut code, callee)
        static_address(&mut code, &mut patches, 0)
        abi.store(&mut code, 0, 16, 48, 8); arm.mov(&mut code, 0, 13)
    }
    if outgoing > 0 { arm.emit(&mut code, 2432697343 + i64(outgoing) * 1024) }
    if spec.ret_c_record {
        arm.load(&mut code, result_slot)
        if !indirect_result { abi.hfa(&mut code, 0, 0, spec.ret_hfa, false) }
    } else if spec.ret == 1 { arm.emit(&mut code, 2470476800) }
    else if spec.ret == 6 { arm.emit(&mut code, 505806848) }
    else if spec.ret == 7 { arm.emit(&mut code, 2657484800) }
    else if unsigned.has(spec.ret) { unsigned.mask(&mut code, spec.ret) }
}

pub fn emit_callback_entry(code: &mut arm.Code, patches: &mut Patches, fn_label: i32, cb_label: i32,
    param_types: &[]i32, ret_ty: i32) {
    if patches.globals < 64 { patches.globals = 64 }
    arm.mark(&mut code, cb_label)
    if code.platform == 2 {
        static_address(&mut code, &mut patches, 0)
        arm.patch(&mut code, arm.position(&code) - 2, 4244635648)
        arm.emit(&mut code, 4227858432)
    } else { arm.emit(&mut code, 2432697326) }
    param_count := param_types.len
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, param_count)
    if code.platform != 2 {
        static_address(&mut code, &mut patches, 0)
        abi.thread_token(&mut code)
        abi.load(&mut code, 11, 16, 48, 8); arm.emit(&mut code, 3943367007)
        active := arm.label(&mut code); arm.branch(&mut code, active, 2)
        arm.exit(&mut code, 111); arm.mark(&mut code, active)
        for reg in 19..25 { arm.push(&mut code, reg); abi.load(&mut code, reg, 16, (reg - 19) * 8, 8) }
    }
    var gp := 0; var fp := 0; var stack := 0; var limit := 8
    if code.platform == 2 { limit = 6 }
    for p in 0..param_count {
        ty := param_types[p]
        if floats.has(ty) && fp < 8 { abi.fp(&mut code, fp, 10, ft.foreign_width(ty), false); fp = fp + 1 }
        else if !floats.has(ty) && gp < limit { arm.mov(&mut code, 10, gp); gp = gp + 1 }
        else {
            var size := 8; if code.platform == 0 { size = ft.foreign_width(ty) }
            stack = (stack + size - 1) / size * size
            arm.imm(&mut code, 10, i64(stack)); arm.emit(&mut code, 2332688845)
            abi.load(&mut code, 10, 13, 0, ft.foreign_width(ty)); stack = stack + size
        }
        if !floats.has(ty) && ft.foreign_width(ty) < 8 {
            var op: i64 = 3544186880; if ty == 1 { op = 2470445056 }
            arm.emit(&mut code, op + i64(ft.foreign_width(ty) * 8 - 1) * 1024 + 330)
        }
        arm.store(&mut code, p, 10)
    }
    var p := param_count - 1
    while p >= 8 { arm.load(&mut code, p); arm.push(&mut code, 0); p = p - 1 }
    while p >= 0 { arm.load(&mut code, p); arm.mov(&mut code, p, 0); p = p - 1 }
    arm.branch(&mut code, fn_label, 1)
    for extra in 8..param_count { arm.pop(&mut code, 9) }
    if floats.has(ret_ty) { abi.fp(&mut code, 0, 0, ft.foreign_width(ret_ty), true) }
    if code.platform == 2 {
        arm.emit(&mut code, 2432697279); arm.emit(&mut code, 2831252477); arm.emit(&mut code, 4211081216)
    } else {
        static_address(&mut code, &mut patches, 0)
        var reg := 24
        while reg >= 19 {
            abi.store(&mut code, reg, 16, (reg - 19) * 8, 8); arm.pop(&mut code, reg); reg = reg - 1
        }
        arm.ret(&mut code)
    }
}
