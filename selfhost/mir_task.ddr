// The isolated compiler boundary contains only owned numeric IR and policy.
// Workspaces remain local to the worker; opaque frontend/linker objects never
// cross this boundary. The parent retains source names, cache and diagnostics.
import mir
import mir_lower as lower
import mir_pipeline as pipeline

pub struct Job {
    ordinal: i32, declaration: i32, function: mir.Function,
    options: pipeline.Options, terminals: pipeline.Terminals,
}
pub struct Answer {
    ordinal: i32, declaration: i32, object: lower.ObjectData, status: pipeline.Status,
}
pub fn execute(input: Job) -> Answer {
    var function := input.function
    var workspace := pipeline.new()
    status := pipeline.run_into(&mut function, &mut workspace, &input.options, &input.terminals)
    var answer := Answer { ordinal: input.ordinal, declaration: input.declaration, object: lower.new_data(), status: status }
    if answer.status.error == 0 {
        if !lower.lower_data_into(&mut answer.object, &function) { answer.status.error = 7 }
    }
    answer
}
