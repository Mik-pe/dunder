// The isolated compiler boundary contains only owned numeric IR and policy.
// Workspaces remain local to the worker; opaque frontend/linker objects never
// cross this boundary. The parent retains source names, cache and diagnostics.
import mir
import mir_lower as lower
import mir_pipeline as pipeline

pub struct Job {
    ordinal: i32, declaration: i32, function: mir.Function,
    options: pipeline.Options, terminals: pipeline.Terminals,
}
pub struct Answer {
    ordinal: i32, declaration: i32, object: lower.ObjectData, status: pipeline.Status,
}
pub fn execute(input: Job) -> Answer {
    var function := input.function
    var status := pipeline.Status { error: 0, frame_state: 0, value_state: 0, stats: pipeline.stats() }
    if input.options.ssa {
        var workspace := pipeline.new()
        status = pipeline.run_into(&mut function, &mut workspace, &input.options, &input.terminals)
    } else {
        var core := pipeline.new_core()
        status = pipeline.run_core_into(&mut function, &mut core, &input.options, &input.terminals)
    }
    var answer := Answer { ordinal: input.ordinal, declaration: input.declaration, object: lower.new_data(), status: status }
    if answer.status.error == 0 {
        if !lower.lower_data_into(&mut answer.object, &function) { answer.status.error = 7 }
    }
    answer
}

// Batched flat primitive transport amortizes pthread spawn/join and TaskID
// snapshot cloning across multiple MIR functions while preserving strict
// per-function provenance and deterministic serial order.
pub struct Batch {
    ordinals: []i32, declarations: []i32,
    item_int_starts: []i32, item_word_starts: []i32,
    ints: []i32, words: []i64,
    options: pipeline.Options, terminals: pipeline.Terminals,
}
pub struct BatchAnswer {
    ordinals: []i32, declarations: []i32,
    item_int_starts: []i32, item_word_starts: []i32,
    ints: []i32, words: []i64,
}

fn push_bool_val(dst: &mut []i32, value: bool) {
    if value { dst.push(1) } else { dst.push(0) }
}
fn read_bool_val(src: &[]i32, pos: &mut i32) -> bool {
    v := src[pos]; pos = pos + 1; v != 0
}
fn read_i32_val(src: &[]i32, pos: &mut i32) -> i32 {
    v := src[pos]; pos = pos + 1; v
}
fn pack_i32(dst: &mut []i32, src: &[]i32) {
    dst.push(src.len)
    for i in 0..src.len { dst.push(src[i]) }
}
fn unpack_i32(src: &[]i32, pos: &mut i32, dst: &mut []i32) {
    n := src[pos]; pos = pos + 1; at := pos
    for i in 0..n { dst.push(src[at + i]) }
    pos = at + n
}
fn pack_bool(dst: &mut []i32, src: &[]bool) {
    dst.push(src.len)
    for i in 0..src.len { if src[i] { dst.push(1) } else { dst.push(0) } }
}
fn unpack_bool(src: &[]i32, pos: &mut i32, dst: &mut []bool) {
    n := src[pos]; pos = pos + 1; at := pos
    for i in 0..n { dst.push(src[at + i] != 0) }
    pos = at + n
}
fn pack_i64(dst: &mut []i64, src: &[]i64) {
    dst.push(i64(src.len))
    for i in 0..src.len { dst.push(src[i]) }
}
fn unpack_i64(src: &[]i64, pos: &mut i32, dst: &mut []i64) {
    n := i32(src[pos]); pos = pos + 1; at := pos
    for i in 0..n { dst.push(src[at + i]) }
    pos = at + n
}

pub fn new_batch(options: pipeline.Options, terminals: pipeline.Terminals) -> Batch {
    Batch {
        ordinals: [], declarations: [],
        item_int_starts: [], item_word_starts: [],
        ints: [], words: [],
        options: options, terminals: terminals,
    }
}
pub fn reset_batch(b: &mut Batch) {
    b.ordinals.clear(); b.declarations.clear()
    b.item_int_starts.clear(); b.item_word_starts.clear()
    b.ints.clear(); b.words.clear()
}
pub fn batch_len(b: &Batch) -> i32 { b.ordinals.len }

pub fn push_batch(b: &mut Batch, ordinal: i32, declaration: i32, f: &mir.Function) {
    b.ordinals.push(ordinal); b.declarations.push(declaration)
    b.item_int_starts.push(b.ints.len); b.item_word_starts.push(b.words.len)
    push_bool_val(&mut b.ints, f.valid); push_bool_val(&mut b.ints, f.verified)
    push_bool_val(&mut b.ints, f.optimizable); push_bool_val(&mut b.ints, f.unknown_control)
    b.ints.push(f.platform); b.ints.push(f.first_word); b.ints.push(f.first_label)
    b.ints.push(f.first_reloc); b.ints.push(f.first_import)
    b.ints.push(f.source_words); b.ints.push(f.source_labels)
    b.ints.push(f.source_relocs); b.ints.push(f.source_imports)
    b.ints.push(f.place_probes); b.ints.push(f.visits)
    push_bool_val(&mut b.ints, f.budget_exhausted)
    pack_i32(&mut b.ints, &f.kinds); pack_i32(&mut b.ints, &f.opcodes)
    pack_i32(&mut b.ints, &f.dst); pack_i32(&mut b.ints, &f.a)
    pack_i32(&mut b.ints, &f.b); pack_i32(&mut b.ints, &f.c)
    pack_i32(&mut b.ints, &f.aux); pack_i32(&mut b.ints, &f.types)
    pack_i32(&mut b.ints, &f.place); pack_i32(&mut b.ints, &f.extensions)
    pack_i32(&mut b.ints, &f.effects); pack_i32(&mut b.ints, &f.flags); pack_i32(&mut b.ints, &f.abi)
    pack_i32(&mut b.ints, &f.origins); pack_i32(&mut b.ints, &f.raw_starts); pack_i32(&mut b.ints, &f.widths)
    pack_i32(&mut b.ints, &f.modes); pack_i32(&mut b.ints, &f.recipes); pack_i32(&mut b.ints, &f.stack_roles)
    pack_i32(&mut b.ints, &f.targets); pack_i32(&mut b.ints, &f.reloc_kinds)
    pack_i32(&mut b.ints, &f.import_ids); pack_i32(&mut b.ints, &f.order)
    pack_i32(&mut b.ints, &f.place_kinds); pack_i32(&mut b.ints, &f.place_offsets)
    pack_i32(&mut b.ints, &f.place_widths); pack_i32(&mut b.ints, &f.place_extensions)
    pack_i32(&mut b.ints, &f.place_table)
    pack_i32(&mut b.ints, &f.block_starts); pack_i32(&mut b.ints, &f.block_ends); pack_i32(&mut b.ints, &f.op_blocks)
    pack_i32(&mut b.ints, &f.edge_from); pack_i32(&mut b.ints, &f.edge_to)
    pack_i32(&mut b.ints, &f.edge_kinds); pack_i32(&mut b.ints, &f.edge_starts)
    pack_i32(&mut b.ints, &f.label_ids); pack_i32(&mut b.ints, &f.label_ops); pack_i32(&mut b.ints, &f.boundaries)
    pack_bool(&mut b.ints, &f.place_escaped); pack_bool(&mut b.ints, &f.leaders)
    pack_i64(&mut b.words, &f.imm); pack_i64(&mut b.words, &f.variant)
    pack_i64(&mut b.words, &f.reads); pack_i64(&mut b.words, &f.writes); pack_i64(&mut b.words, &f.clobbers)
    pack_i64(&mut b.words, &f.raw)
}

fn unpack_function(b: &Batch, item: i32, f: &mut mir.Function) {
    mir.reset(&mut f)
    var pos := b.item_int_starts[item]
    f.valid = read_bool_val(&b.ints, &mut pos); f.verified = read_bool_val(&b.ints, &mut pos)
    f.optimizable = read_bool_val(&b.ints, &mut pos); f.unknown_control = read_bool_val(&b.ints, &mut pos)
    f.platform = read_i32_val(&b.ints, &mut pos); f.first_word = read_i32_val(&b.ints, &mut pos)
    f.first_label = read_i32_val(&b.ints, &mut pos); f.first_reloc = read_i32_val(&b.ints, &mut pos)
    f.first_import = read_i32_val(&b.ints, &mut pos)
    f.source_words = read_i32_val(&b.ints, &mut pos); f.source_labels = read_i32_val(&b.ints, &mut pos)
    f.source_relocs = read_i32_val(&b.ints, &mut pos); f.source_imports = read_i32_val(&b.ints, &mut pos)
    f.place_probes = read_i32_val(&b.ints, &mut pos); f.visits = read_i32_val(&b.ints, &mut pos)
    f.budget_exhausted = read_bool_val(&b.ints, &mut pos)
    unpack_i32(&b.ints, &mut pos, &mut f.kinds); unpack_i32(&b.ints, &mut pos, &mut f.opcodes)
    unpack_i32(&b.ints, &mut pos, &mut f.dst); unpack_i32(&b.ints, &mut pos, &mut f.a)
    unpack_i32(&b.ints, &mut pos, &mut f.b); unpack_i32(&b.ints, &mut pos, &mut f.c)
    unpack_i32(&b.ints, &mut pos, &mut f.aux); unpack_i32(&b.ints, &mut pos, &mut f.types)
    unpack_i32(&b.ints, &mut pos, &mut f.place); unpack_i32(&b.ints, &mut pos, &mut f.extensions)
    unpack_i32(&b.ints, &mut pos, &mut f.effects); unpack_i32(&b.ints, &mut pos, &mut f.flags)
    unpack_i32(&b.ints, &mut pos, &mut f.abi)
    unpack_i32(&b.ints, &mut pos, &mut f.origins); unpack_i32(&b.ints, &mut pos, &mut f.raw_starts)
    unpack_i32(&b.ints, &mut pos, &mut f.widths); unpack_i32(&b.ints, &mut pos, &mut f.modes)
    unpack_i32(&b.ints, &mut pos, &mut f.recipes); unpack_i32(&b.ints, &mut pos, &mut f.stack_roles)
    unpack_i32(&b.ints, &mut pos, &mut f.targets); unpack_i32(&b.ints, &mut pos, &mut f.reloc_kinds)
    unpack_i32(&b.ints, &mut pos, &mut f.import_ids); unpack_i32(&b.ints, &mut pos, &mut f.order)
    unpack_i32(&b.ints, &mut pos, &mut f.place_kinds); unpack_i32(&b.ints, &mut pos, &mut f.place_offsets)
    unpack_i32(&b.ints, &mut pos, &mut f.place_widths); unpack_i32(&b.ints, &mut pos, &mut f.place_extensions)
    unpack_i32(&b.ints, &mut pos, &mut f.place_table)
    unpack_i32(&b.ints, &mut pos, &mut f.block_starts); unpack_i32(&b.ints, &mut pos, &mut f.block_ends)
    unpack_i32(&b.ints, &mut pos, &mut f.op_blocks)
    unpack_i32(&b.ints, &mut pos, &mut f.edge_from); unpack_i32(&b.ints, &mut pos, &mut f.edge_to)
    unpack_i32(&b.ints, &mut pos, &mut f.edge_kinds); unpack_i32(&b.ints, &mut pos, &mut f.edge_starts)
    unpack_i32(&b.ints, &mut pos, &mut f.label_ids); unpack_i32(&b.ints, &mut pos, &mut f.label_ops)
    unpack_i32(&b.ints, &mut pos, &mut f.boundaries)
    unpack_bool(&b.ints, &mut pos, &mut f.place_escaped); unpack_bool(&b.ints, &mut pos, &mut f.leaders)
    var wpos := b.item_word_starts[item]
    unpack_i64(&b.words, &mut wpos, &mut f.imm); unpack_i64(&b.words, &mut wpos, &mut f.variant)
    unpack_i64(&b.words, &mut wpos, &mut f.reads); unpack_i64(&b.words, &mut wpos, &mut f.writes)
    unpack_i64(&b.words, &mut wpos, &mut f.clobbers); unpack_i64(&b.words, &mut wpos, &mut f.raw)
}

fn pack_item_answer(out: &mut BatchAnswer, ordinal: i32, declaration: i32,
    status: &pipeline.Status, data: &lower.ObjectData) {
    out.ordinals.push(ordinal); out.declarations.push(declaration)
    out.item_int_starts.push(out.ints.len); out.item_word_starts.push(out.words.len)
    out.ints.push(status.error); out.ints.push(status.frame_state); out.ints.push(status.value_state)
    out.ints.push(status.stats.operations); out.ints.push(status.stats.opaque)
    out.ints.push(status.stats.optimized); out.ints.push(status.stats.promoted)
    out.ints.push(status.stats.removed_loads); out.ints.push(status.stats.removed_stores)
    out.ints.push(status.stats.private_memory_ops); out.ints.push(status.stats.budget_refusals)
    out.ints.push(status.stats.ssa_optimized); out.ints.push(status.stats.ssa_cells)
    out.ints.push(status.stats.ssa_values); out.ints.push(status.stats.ssa_parameters)
    out.ints.push(status.stats.ssa_registers); out.ints.push(status.stats.ssa_captures)
    out.ints.push(status.stats.ssa_stack_groups); out.ints.push(status.stats.ssa_removed_loads)
    out.ints.push(status.stats.ssa_removed_stores); out.ints.push(status.stats.ssa_removed_pushes)
    out.ints.push(status.stats.ssa_removed_pops); out.ints.push(status.stats.ssa_copies)
    out.ints.push(status.stats.ssa_budget_refusals); out.ints.push(status.stats.values_optimized)
    out.ints.push(status.stats.value_rewrites); out.ints.push(status.stats.value_deleted)
    out.ints.push(status.stats.value_immediates); out.ints.push(status.stats.value_budget_refusals)
    out.words.push(status.stats.analysis_units); out.words.push(status.stats.ssa_analysis_units)
    out.words.push(status.stats.value_analysis_units)
    if status.error != 0 { out.ints.push(0); return }
    out.ints.push(1)
    out.ints.push(data.version); out.ints.push(data.output.platform)
    out.ints.push(data.first_word); out.ints.push(data.first_label)
    out.ints.push(data.first_reloc); out.ints.push(data.first_import)
    out.ints.push(data.source_words); out.ints.push(data.source_labels)
    out.ints.push(data.source_relocs); out.ints.push(data.source_imports)
    pack_i64(&mut out.words, &data.output.words)
    pack_i32(&mut out.ints, &data.output.at); pack_i32(&mut out.ints, &data.output.target)
    pack_i32(&mut out.ints, &data.output.kinds); pack_i32(&mut out.ints, &data.boundaries)
    pack_i32(&mut out.ints, &data.label_ids); pack_i32(&mut out.ints, &data.label_at)
    pack_i32(&mut out.ints, &data.import_ids); pack_i32(&mut out.ints, &data.import_at)
}

pub fn execute_batch(input: Batch) -> BatchAnswer {
    var out := BatchAnswer {
        ordinals: [], declarations: [],
        item_int_starts: [], item_word_starts: [],
        ints: [], words: [],
    }
    var function := mir.new()
    var data := lower.new_data()
    if input.options.ssa {
        var workspace := pipeline.new()
        for item in 0..input.ordinals.len {
            unpack_function(&input, item, &mut function)
            var status := pipeline.run_into(&mut function, &mut workspace, &input.options, &input.terminals)
            lower.reset_data(&mut data)
            if status.error == 0 {
                if !lower.lower_data_into(&mut data, &function) { status.error = 7 }
            }
            pack_item_answer(&mut out, input.ordinals[item], input.declarations[item], &status, &data)
        }
    } else {
        var core := pipeline.new_core()
        for item in 0..input.ordinals.len {
            unpack_function(&input, item, &mut function)
            var status := pipeline.run_core_into(&mut function, &mut core, &input.options, &input.terminals)
            lower.reset_data(&mut data)
            if status.error == 0 {
                if !lower.lower_data_into(&mut data, &function) { status.error = 7 }
            }
            pack_item_answer(&mut out, input.ordinals[item], input.declarations[item], &status, &data)
        }
    }
    out
}

pub fn answer_len(a: &BatchAnswer) -> i32 { a.ordinals.len }
pub fn answer_ordinal(a: &BatchAnswer, item: i32) -> i32 { a.ordinals[item] }
pub fn answer_declaration(a: &BatchAnswer, item: i32) -> i32 { a.declarations[item] }

pub fn unpack_answer(a: &BatchAnswer, item: i32, data: &mut lower.ObjectData, status: &mut pipeline.Status) {
    lower.reset_data(&mut data)
    var pos := a.item_int_starts[item]
    var wpos := a.item_word_starts[item]
    status.error = read_i32_val(&a.ints, &mut pos)
    status.frame_state = read_i32_val(&a.ints, &mut pos)
    status.value_state = read_i32_val(&a.ints, &mut pos)
    status.stats.operations = read_i32_val(&a.ints, &mut pos)
    status.stats.opaque = read_i32_val(&a.ints, &mut pos)
    status.stats.optimized = read_i32_val(&a.ints, &mut pos)
    status.stats.promoted = read_i32_val(&a.ints, &mut pos)
    status.stats.removed_loads = read_i32_val(&a.ints, &mut pos)
    status.stats.removed_stores = read_i32_val(&a.ints, &mut pos)
    status.stats.private_memory_ops = read_i32_val(&a.ints, &mut pos)
    status.stats.budget_refusals = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_optimized = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_cells = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_values = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_parameters = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_registers = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_captures = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_stack_groups = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_removed_loads = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_removed_stores = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_removed_pushes = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_removed_pops = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_copies = read_i32_val(&a.ints, &mut pos)
    status.stats.ssa_budget_refusals = read_i32_val(&a.ints, &mut pos)
    status.stats.values_optimized = read_i32_val(&a.ints, &mut pos)
    status.stats.value_rewrites = read_i32_val(&a.ints, &mut pos)
    status.stats.value_deleted = read_i32_val(&a.ints, &mut pos)
    status.stats.value_immediates = read_i32_val(&a.ints, &mut pos)
    status.stats.value_budget_refusals = read_i32_val(&a.ints, &mut pos)
    status.stats.analysis_units = a.words[wpos]; wpos = wpos + 1
    status.stats.ssa_analysis_units = a.words[wpos]; wpos = wpos + 1
    status.stats.value_analysis_units = a.words[wpos]; wpos = wpos + 1
    has_data := read_i32_val(&a.ints, &mut pos)
    if has_data == 0 { return }
    data.version = read_i32_val(&a.ints, &mut pos)
    data.output.platform = read_i32_val(&a.ints, &mut pos)
    data.first_word = read_i32_val(&a.ints, &mut pos)
    data.first_label = read_i32_val(&a.ints, &mut pos)
    data.first_reloc = read_i32_val(&a.ints, &mut pos)
    data.first_import = read_i32_val(&a.ints, &mut pos)
    data.source_words = read_i32_val(&a.ints, &mut pos)
    data.source_labels = read_i32_val(&a.ints, &mut pos)
    data.source_relocs = read_i32_val(&a.ints, &mut pos)
    data.source_imports = read_i32_val(&a.ints, &mut pos)
    unpack_i64(&a.words, &mut wpos, &mut data.output.words)
    unpack_i32(&a.ints, &mut pos, &mut data.output.at)
    unpack_i32(&a.ints, &mut pos, &mut data.output.target)
    unpack_i32(&a.ints, &mut pos, &mut data.output.kinds)
    unpack_i32(&a.ints, &mut pos, &mut data.boundaries)
    unpack_i32(&a.ints, &mut pos, &mut data.label_ids)
    unpack_i32(&a.ints, &mut pos, &mut data.label_at)
    unpack_i32(&a.ints, &mut pos, &mut data.import_ids)
    unpack_i32(&a.ints, &mut pos, &mut data.import_at)
}
