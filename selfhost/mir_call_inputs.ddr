// Separate trusted semantic-input premise for the COMPLETE source producer.
// This is not mir_call_abi's preserved-register/private-SP promise, a NoModRef
// declaration, a terminal contract, or a deduction from Return live-outs.
// Raw MIR keeps its canonical masks. This module only offers an effective
// read view to a caller explicitly holding this independent context.
import mir

pub opaque struct Context { version: i32 }
pub fn conservative() -> Context { Context { version: 0 } }
// TRUSTED PRODUCER PRECONDITION, source-inputs version1:
// ABI1/2/3 callees obey their declared source/native/kernel argument convention.
// Semantic GP inputs are contained in0..8,16,18..31 plus every explicit target
// operand. More than8 source arguments live on the declared stack, not9..15.
// C sret, native print tags and syscall numbers are covered by0..8/16;
// homogeneous floating aggregates use the fully conservative FP bank.
// ALL FP registers and reserved/ABI state remain conservative inputs.
//
// In particular no source-defined result, memory, flags or control decision may
// depend on incoming9..15/17 except an explicit target operand. The complete
// producer must ALSO ensure callers do not consume preserved, locally undefined
// post-call scratch as a source-defined result. MAY-clobber alone proves none
// of this. A callback may physically save/restore scratch bits; this premise
// does not claim every physical output is independent of them or define them.
// No callee may expose incoming bits as an undeclared argument or environment.
// A callback/foreign declaration alone cannot certify arbitrary machine code.
// A future internal helper using such an extra argument needs an explicit new
// convention, not accidental inheritance of this premise. ABI4 stays unknown.
//
// The current runtime's emitted public and private CALL entries were checked
// by CFG read-before-local-definition analysis. It did not assume that nested
// calls define scratch registers. Runtime copy10/11/12 and similar emitter
// fragments are inline code after local definitions, never callable entries.
// Generated clone/drop/take entries take their root in0; source parameters,
// native C arguments, callback staging and task entries use the conventions
// above. The producer must maintain these properties as those emitters evolve.
// Task scope/open/spawn/await/close entries use0..2, provider create/collect/
// discard use0, and the dedicated C worker entry takes0 plus preserved ABI
// state. Their dynamic callback targets are defined locally in17 (C imports16).
pub fn trusted_source_inputs_v1() -> Context { Context { version: 1 } }
pub fn source_inputs(ctx: &Context) -> bool { ctx.version == 1 }
pub fn policy_tag(ctx: &Context) -> string {
    if source_inputs(&ctx) { "mir-call-inputs:source-v1" } else { "mir-call-inputs:raw-v1" }
}
fn supported_call(f: &mir.Function, op: i32) -> bool {
    n := f.kinds.len
    if !f.valid || !f.verified || !f.optimizable || f.unknown_control || f.platform < 0 || f.platform > 3 ||
        f.modes.len != n || f.abi.len != n || f.a.len != n || f.b.len != n || f.c.len != n ||
        f.dst.len != n || f.writes.len != n || f.clobbers.len != n || f.flags.len != n || f.effects.len != n { return false }
    if f.kinds[op] != 14 || f.modes[op] < 0 || f.modes[op] > 1 || f.abi[op] < 1 || f.abi[op] > 3 ||
        f.reads[op] != -1 || f.writes[op] != 0 || f.clobbers[op] != -1 || f.flags[op] != 3 ||
        f.effects[op] != 95 || f.dst[op] != -1 { return false }
    // The verified snapshot supplies actual semantic roles, never variant/raw
    // instruction decoding here. In particular retained FE must reverify with
    // its published target17. Other x86 host/bridge shapes remain conservative.
    if f.abi[op] == 2 && f.platform == 2 && (f.a[op] != 17 || f.b[op] != -1 || f.c[op] != -1) { return false }
    if f.a[op] < -1 || f.a[op] > 30 || f.b[op] < -1 || f.b[op] > 30 || f.c[op] < -1 || f.c[op] > 30 { return false }
    true
}
// O(1), no allocation and no mutation. Input must remain the SAME freshly
// verified Function snapshot while this view is used. Callers charge their
// own query loops. Noncalls/unknown/noncanonical calls return canonical reads;
// malformed indices/read-column shape return the conservative all-read mask.
// This changes NO result definitions, clobbers, flags, memory or call effects.
pub fn reads(ctx: &Context, f: &mir.Function, op: i32) -> i64 {
    if op < 0 || op >= f.kinds.len || f.reads.len != f.kinds.len { return -1 }
    raw := f.reads[op]
    if !source_inputs(&ctx) || !supported_call(&f, op) { return raw }
    // Exactly the eight scratch GP registers9..15 and17 may cease being inputs.
    // Both physical register banks and all reserved state remain unchanged.
    var allowed: i64 = -196097 // bitwise complement of0x000000000002FE00
    allowed = allowed.bit_or(mir.variable_bit(f.a[op])).bit_or(mir.variable_bit(f.b[op])).bit_or(mir.variable_bit(f.c[op]))
    raw.bit_and(allowed)
}
