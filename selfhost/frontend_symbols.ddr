// Coordinator-owned machine bindings, deliberately separate from semantic
// type identity. Every discovered type retains its legacy clone/drop pair.
// No semantic type query or interning operation imports this module or Code.
pub struct TypeSymbols { clones: []i32, drops: []i32 }
pub fn new() -> TypeSymbols { TypeSymbols { clones: [], drops: [] } }
pub fn bind_pair(s: &mut TypeSymbols, ty: i32, clone: i32, drop: i32) -> bool {
    if ty != s.clones.len || s.drops.len != ty || clone < 0 || drop != clone + 1 { return false }
    s.clones.push(clone); s.drops.push(drop); true
}
