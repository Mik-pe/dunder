// Run from the repository root: dunder run selfhost/embed.ddr
// Regenerates the standard library sources carried by the Dunder compiler.
import sys
import std.bytes as bytes
import std.text as text

fn quoted(output: &mut []u8, source: string) {
    output.push(34)
    for byte in source.bytes() {
        if byte == 34 || byte == 92 { output.push(92); output.push(u8(byte)) }
        else if byte == 10 { output.push(92); output.push(110) }
        else if byte == 13 { output.push(92); output.push(114) }
        else if byte == 9 { output.push(92); output.push(116) }
        else if byte == 0 { output.push(92); output.push(48) }
        else { output.push(u8(byte)) }
    }
    output.push(34)
}

fn main() -> i32 {
    manifest := sys.read_text("stdlib/modules.txt")
    if !manifest.ok { print(sys.error_message(manifest.error)); return 1 }
    var names: []string = []
    for line in text.split(manifest.value, "\n") {
        name := text.trim(line)
        if name.len > 0 { names.push(name) }
    }
    var output: []u8 = []
    bytes.append_utf8(&mut output, "// Generated by selfhost/embed.ddr; edit stdlib/*.ddr and regenerate.\n\npub fn source(name: string) -> string {\n")
    for name in names {
        input := sys.read_text("stdlib/" + name + ".ddr")
        if !input.ok { print(sys.error_message(input.error)); return 1 }
        bytes.append_utf8(&mut output, "    if name == ")
        quoted(&mut output, name)
        bytes.append_utf8(&mut output, " { return ")
        quoted(&mut output, input.value)
        bytes.append_utf8(&mut output, " }\n")
    }
    bytes.append_utf8(&mut output, "    \"\"\n}\n\npub fn contains(name: string) -> bool {\n")
    for name in names {
        bytes.append_utf8(&mut output, "    if name == ")
        quoted(&mut output, name)
        bytes.append_utf8(&mut output, " { return true }\n")
    }
    bytes.append_utf8(&mut output, "    false\n}\n")
    // Embed the same round-trip formatter used by the Rust bootstrap.
    formatter := sys.read_text("runtime/float.ddr")
    if !formatter.ok { return 1 }
    bytes.append_utf8(&mut output, "\npub fn float_formatter() -> string { ")
    quoted(&mut output, formatter.value)
    bytes.append_utf8(&mut output, " }\n")
    result := sys.write_u8("selfhost/bundled.ddr", &output)
    if !result.ok { print(sys.error_message(result.error)); return 1 }
    0
}
