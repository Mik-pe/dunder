// Run from the repository root: dunder run selfhost/embed.ddr
// Regenerates the standard library sources carried by the Dunder compiler.
import sys
import std.bytes as bytes

fn quoted(output: &mut []i32, source: string) {
    output.push(34)
    for byte in source.bytes() {
        if byte == 34 || byte == 92 { output.push(92); output.push(byte) }
        else if byte == 10 { output.push(92); output.push(110) }
        else if byte == 13 { output.push(92); output.push(114) }
        else if byte == 9 { output.push(92); output.push(116) }
        else if byte == 0 { output.push(92); output.push(48) }
        else { output.push(byte) }
    }
    output.push(34)
}

fn main() -> i32 {
    names := ["array", "bytes", "hash", "macos", "map", "parse", "set", "sha256", "sys", "text"]
    var output: []i32 = []
    bytes.append_text(&mut output, "// Generated by selfhost/embed.ddr; edit stdlib/*.ddr and regenerate.\n\npub fn source(name: string) -> string {\n")
    for name in names {
        input := sys.read_text("stdlib/" + name + ".ddr")
        if !input.ok { print(sys.error_message(input.error)); return 1 }
        bytes.append_text(&mut output, "    if name == ")
        quoted(&mut output, name)
        bytes.append_text(&mut output, " { return ")
        quoted(&mut output, input.value)
        bytes.append_text(&mut output, " }\n")
    }
    bytes.append_text(&mut output, "    \"\"\n}\n\npub fn contains(name: string) -> bool {\n")
    for name in names {
        bytes.append_text(&mut output, "    if name == ")
        quoted(&mut output, name)
        bytes.append_text(&mut output, " { return true }\n")
    }
    bytes.append_text(&mut output, "    false\n}\n")
    result := sys.write_bytes("selfhost/bundled.ddr", &output)
    if !result.ok { print(sys.error_message(result.error)); return 1 }
    0
}
