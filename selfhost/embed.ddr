import sys
import std.bytes as bytes
import std.text as text
import frontend.lexer

fn quoted(output: &mut []u8, source: string) {
    output.push(b'"')
    for byte in source.bytes() {
        if byte == 34 || byte == 92 { output.push(b'\\'); output.push(u8(byte)) }
        else if byte == 10 { bytes.append_utf8(&mut output, "\\n") }
        else if byte == 13 { bytes.append_utf8(&mut output, "\\r") }
        else if byte == 9 { bytes.append_utf8(&mut output, "\\t") }
        else if byte == 0 { bytes.append_utf8(&mut output, "\\0") }
        else { output.push(u8(byte)) }
    }
    output.push(b'"')
}
fn exports(source: string, members: bool) -> []string {
    tokens := lexer.scan(source, false)
    mut names: []string = []; mut depth := 0
    for i in 0..tokens.kinds.len - 1 {
        word := &tokens.texts[i]
        if tokens.kinds[i] == .Symbol {
            if word == "{" { depth += 1 } else if word == "}" { depth -= 1 }
        }
        if word != "pub" || (members && depth != 1) || (!members && depth != 0) { continue }
        mut kind := i + 1
        if tokens.texts[kind] == "opaque" { kind += 1 }
        if tokens.texts[kind] != "struct" && tokens.texts[kind] != "enum" && tokens.texts[kind] != "fn" && tokens.texts[kind] != "trait" { continue }
        name := &tokens.texts[kind + 1]
        mut seen := false
        for previous in &names { if previous == name { seen = true; break } }
        if !seen { names.push(name.clone()) }
    }
    names
}

fn trait_methods(source: string) -> []string {
    tokens := lexer.scan(source, false)
    mut names: []string = []; mut depth := 0; mut in_trait := false
    for i in 0..tokens.kinds.len - 1 {
        word := &tokens.texts[i]
        if tokens.kinds[i] == .Symbol {
            if word == "{" { depth += 1 }
            else if word == "}" {
                depth -= 1
                if depth == 0 { in_trait = false }
            }
            continue
        }
        if depth == 0 && word == "trait" { in_trait = true; continue }
        if in_trait && depth == 1 && word == "fn" && i + 1 < tokens.kinds.len && tokens.kinds[i + 1] == .Name {
            name := &tokens.texts[i + 1]
            if name == "str" { continue }
            mut seen := false
            for previous in &names { if previous == name { seen = true; break } }
            if !seen { names.push(name.clone()) }
        }
    }
    names
}

fn generic_names(source: string) -> []string {
    tokens := lexer.scan(source, false)
    mut names: []string = []
    for i in 1..tokens.kinds.len - 1 {
        if tokens.kinds[i] != .Name || !lexer.symbol(&tokens, i + 1, "<") { continue }
        kind := &tokens.texts[i - 1]
        if kind == "struct" || kind == "enum" || kind == "fn" { names.push(tokens.texts[i].clone()) }
    }
    names
}

fn append_unique(target: &mut []string, items: &[]string) {
    for item in &items {
        mut seen := false
        for existing in &target { if existing == item { seen = true; break } }
        if !seen { target.push(item.clone()) }
    }
}

fn main() -> i32 {
    checking := sys.arg_count() == 2 && sys.arg(1) == "--check"
    if sys.arg_count() != 1 && !checking { _ := sys.eprint("usage: embed [--check]"); return 2 }
    manifest := sys.read_text("stdlib/modules.txt")
    if !manifest.ok { print(sys.error_message(manifest.error)); return 1 }
    mut names: []string = []
    for line in text.split(manifest.value, "\n") {
        name := text.trim(line)
        if name.len > 0 { names.push(move name) }
    }
    mut output: []u8 = []
    bytes.append_utf8(&mut output, "pub fn source(name: string) -> string {\n")
    for name in &names {
        // Map and Set are emitted once with the other prelude types.
        if name == "map" || name == "set" { continue }
        // Keep the old imports available during migration to package dependencies.
        path := if name == "http" || name == "http_client" { f"packages/{name}/{name}.ddr" } else { f"stdlib/{name}.ddr" }
        input := sys.read_text(path)
        if !input.ok { print(sys.error_message(input.error)); return 1 }
        bytes.append_utf8(&mut output, "    if name == ")
        quoted(&mut output, name)
        bytes.append_utf8(&mut output, " { return ")
        quoted(&mut output, input.value)
        bytes.append_utf8(&mut output, " }\n")
    }
    bytes.append_utf8(&mut output, "    \"\"\n}\n\npub fn contains(name: string) -> bool {\n")
    for name in &names {
        bytes.append_utf8(&mut output, "    if name == ")
        quoted(&mut output, name)
        bytes.append_utf8(&mut output, " { return true }\n")
    }
    bytes.append_utf8(&mut output, "    false\n}\n")
    formatter := sys.read_text("runtime/float.ddr")
    if !formatter.ok { return 1 }
    bytes.append_utf8(&mut output, "\npub fn float_formatter() -> string { ")
    quoted(&mut output, formatter.value)
    bytes.append_utf8(&mut output, " }\n")
    mut core := ""
    mut generic := ""
    mut initials: i64 = 0
    mut all_exports: []string = []
    bytes.append_utf8(&mut output, "\npub fn prelude_export(owner: string, name: string) -> string {\n")
    traits_decl := sys.read_text("runtime/prelude/traits.ddr")
    if !traits_decl.ok { print(sys.error_message(traits_decl.error)); return 1 }
    core = traits_decl.value + "\n"
    for symbol in exports(traits_decl.value, false) {
        initials = initials.bit_or(i64(1).shl(symbol[0].bit_and(63)))
        mut is_dup := false
        for e in &all_exports { if e == symbol { is_dup = true; break } }
        if !is_dup { all_exports.push(symbol.clone()) }
        bytes.append_utf8(&mut output, "    if name == "); quoted(&mut output, symbol)
        if symbol == "Ordering" || symbol == "Eq" || symbol == "Ord" {
            bytes.append_utf8(&mut output, " && (owner == \"\" || owner == \"traits\" || owner == \"cmp\")")
        } else if symbol == "Hash" {
            bytes.append_utf8(&mut output, " && (owner == \"\" || owner == \"traits\" || owner == \"hash\")")
        } else {
            bytes.append_utf8(&mut output, " && (owner == \"\" || owner == \"traits\")")
        }
        bytes.append_utf8(&mut output, " { return "); quoted(&mut output, "__dunder_module_prelude_" + symbol)
        bytes.append_utf8(&mut output, " }\n")
    }
    for name in ["result", "compound", "map", "set"] {
        path := if name == "map" || name == "set" { f"stdlib/{name}.ddr" } else { f"runtime/prelude/{name}.ddr" }
        decl := sys.read_text(path)
        if !decl.ok { print(sys.error_message(decl.error)); return 1 }
        generic += decl.value + "\n"
        for symbol in exports(decl.value, false) {
            initials = initials.bit_or(i64(1).shl(symbol[0].bit_and(63)))
            mut is_dup := false
            for e in &all_exports { if e == symbol { is_dup = true; break } }
            if !is_dup { all_exports.push(symbol.clone()) }
            bytes.append_utf8(&mut output, "    if name == "); quoted(&mut output, symbol)
            bytes.append_utf8(&mut output, " && (owner == \"\" || owner == "); quoted(&mut output, name)
            bytes.append_utf8(&mut output, ") { return "); quoted(&mut output, "__dunder_module_prelude_" + symbol)
            bytes.append_utf8(&mut output, " }\n")
        }
    }
    bytes.append_utf8(&mut output, "    \"\"\n}\npub fn prelude_initials() -> i64 { " + initials.str() + " }\n")
    generics := generic_names(generic)
    mut prelude_names: []string = []
    append_unique(&mut prelude_names, &all_exports)
    append_unique(&mut prelude_names, &generics)
    bytes.append_utf8(&mut output, "\npub fn prelude_name(name: string) -> string {\n")
    for name in &prelude_names {
        bytes.append_utf8(&mut output, "    if name == "); quoted(&mut output, name)
        bytes.append_utf8(&mut output, " { return "); quoted(&mut output, "__dunder_module_prelude_" + name)
        bytes.append_utf8(&mut output, " }\n")
    }
    bytes.append_utf8(&mut output, "    \"\"\n}\n")
    bytes.append_utf8(&mut output, "\npub fn prelude_generic(name: string) -> bool {\n")
    for name in &generics {
        bytes.append_utf8(&mut output, "    if name == "); quoted(&mut output, name)
        bytes.append_utf8(&mut output, " { return true }\n")
    }
    bytes.append_utf8(&mut output, "    false\n}\n")
    mut methods: []string = trait_methods(core)
    bytes.append_utf8(&mut output, "pub fn prelude_method(name: string) -> bool {\n")
    for method in &methods {
        bytes.append_utf8(&mut output, "    if name == "); quoted(&mut output, method); bytes.append_utf8(&mut output, " { return true }\n")
    }
    bytes.append_utf8(&mut output, "    false\n}\n")
    bytes.append_utf8(&mut output, "\npub fn core_prelude() -> string { ")
    quoted(&mut output, core)
    bytes.append_utf8(&mut output, " }\n\npub fn generic_prelude() -> string { ")
    quoted(&mut output, generic)
    bytes.append_utf8(&mut output, " }\n")
    path := "selfhost/bundled.ddr"
    if checking {
        current := sys.read_u8(path)
        if !current.ok { _ := sys.eprint(sys.error_message(current.error)); return 1 }
        if bytes.equal(&current.value, &output) { return 0 }
        _ := sys.eprint("selfhost/bundled.ddr is stale; regenerate it with dunder run selfhost/embed.ddr")
        return 1
    }
    result := sys.write_u8(path, &output)
    if !result.ok { print(sys.error_message(result.error)); return 1 }
    0
}
