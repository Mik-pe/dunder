// An arm is a preorder tree. A binding or wildcard has field -1. The end of
// each subtree points at the next sibling, including for nullary variants.
import frontend_types as ft

pub struct Patterns {
    fields: []i32, ends: []i32, previous: []i32,
    heads: []i32, full: []bool, wildcard: bool, remaining: i32,
}
pub fn new(count: i32) -> Patterns {
    var heads: []i32 = []
    var full: []bool = []
    for i in 0..count { heads.push(-1); full.push(false) }
    Patterns { fields: [], ends: [], previous: [], heads: heads, full: full, wildcard: false, remaining: 4000000 }
}
pub fn node(p: &mut Patterns, field: i32) -> i32 {
    id := p.fields.len
    p.fields.push(field); p.ends.push(id + 1); p.previous.push(-1)
    id
}
pub fn close(p: &mut Patterns, id: i32) { p.ends[id] = p.fields.len }

fn tag(p: &Patterns, id: i32) -> i32 {
    if id < 0 { return -1 }
    p.fields[id]
}
fn payload(p: &Patterns, id: i32, count: i32, cells: &mut []i32) {
    var child := id + 1
    concrete := tag(&p, id) >= 0
    for i in 0..count {
        if concrete { cells.push(child); child = p.ends[child] }
        else { cells.push(-1) }
    }
}
fn spend(remaining: &mut i32, cost: i64) -> bool {
    if cost > i64(remaining) { remaining = 0; return false }
    remaining = remaining - i32(cost)
    true
}

// Rows are previous arms, columns are untested payload positions. Specialize
// a column on a constructor by replacing it with its children. A wildcard row
// participates in every constructor specialization. A negative constructor
// selects only wildcard rows, without introducing any payload columns.
fn specialize(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, rows: &[]i32, query: &[]i32,
              pivot: i32, variant: i32, remaining: &mut i32, depth: i32) -> i32 {
    var arity := 0
    if variant >= 0 { arity = reg.payload_counts[variant] }
    width := types.len
    var next_types: []i32 = []
    var next_query: []i32 = []
    var next_rows: []i32 = []
    next_width := width - 1 + arity
    if !spend(&mut remaining, i64(next_width) + 1) { return -1 }
    for col in 0..width {
        if col == pivot {
            for j in 0..arity { next_types.push(reg.payload_types[reg.payload_starts[variant] + j]) }
            payload(&p, query[col], arity, &mut next_query)
        } else { next_types.push(types[col]); next_query.push(query[col]) }
    }
    var offset := 0
    while offset < rows.len {
        if !spend(&mut remaining, 1) { return -1 }
        id := rows[offset + pivot]; field := tag(&p, id)
        if field < 0 || field == variant {
            if next_width == 0 { return 0 }
            if !spend(&mut remaining, i64(next_width)) { return -1 }
            for col in 0..width {
                if col == pivot {
                    payload(&p, id, arity, &mut next_rows)
                } else { next_rows.push(rows[offset + col]) }
            }
        }
        offset = offset + width
    }
    useful(&p, &reg, &next_types, &next_rows, &next_query, &mut remaining, depth + 1)
}

// 1 means the query matches a value outside the rows, 0 means covered,
// -1 means the work or nesting budget was exceeded. Only columns tested by
// some pattern are split. This avoids expanding the inhabitants of a type.
fn useful(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, rows: &[]i32, query: &[]i32, remaining: &mut i32, depth: i32) -> i32 {
    if rows.len == 0 { return 1 }
    if depth > 128 || !spend(&mut remaining, i64(rows.len) + i64(query.len) + 1) { return -1 }
    var pivot := -1
    for col in 0..query.len {
        variant := tag(&p, query[col])
        if variant >= 0 { return specialize(&p, &reg, &types, &rows, &query, col, variant, &mut remaining, depth) }
    }
    // The candidate is unrestricted. A completely wildcard row covers it.
    var offset := 0
    while offset < rows.len {
        var first := -1
        for col in 0..types.len {
            if tag(&p, rows[offset + col]) >= 0 { first = col; break }
        }
        if first < 0 { return 0 }
        if pivot < 0 { pivot = first }
        offset = offset + types.len
    }
    ty := types[pivot]
    count := reg.declared.type_counts[ty]; start := reg.declared.type_starts[ty]
    if !spend(&mut remaining, i64(count)) { return -1 }
    var present: []bool = []
    for i in 0..count { present.push(false) }
    offset = 0; var distinct := 0
    while offset < rows.len {
        variant := tag(&p, rows[offset + pivot])
        if variant >= 0 && !present[variant - start] { present[variant - start] = true; distinct = distinct + 1 }
        offset = offset + types.len
    }
    // A missing constructor can only be covered by wildcard rows. If those
    // cover the remaining columns, they also cover every present constructor.
    if distinct < count { return specialize(&p, &reg, &types, &rows, &query, pivot, -1, &mut remaining, depth) }
    for variant in start..start + count {
        result := specialize(&p, &reg, &types, &rows, &query, pivot, variant, &mut remaining, depth)
        if result != 0 { return result }
    }
    0
}

fn variant_useful(p: &Patterns, reg: &ft.TypeRegistry, head: i32, candidate: i32, remaining: &mut i32) -> i32 {
    if head < 0 { return 1 }
    field := p.fields[head]; arity := reg.payload_counts[field]
    if arity == 0 { return 0 }
    if !spend(&mut remaining, i64(arity)) { return -1 }
    var types: []i32 = []
    var rows: []i32 = []
    var query: []i32 = []
    for j in 0..arity { types.push(reg.payload_types[reg.payload_starts[field] + j]) }
    payload(&p, candidate, arity, &mut query)
    var root := head
    while root >= 0 {
        if !spend(&mut remaining, i64(arity)) { return -1 }
        payload(&p, root, arity, &mut rows)
        root = p.previous[root]
    }
    useful(&p, &reg, &types, &rows, &query, &mut remaining, 0)
}
// A guarded wildcard is useful exactly when an unguarded fallback is still
// needed. Use the same query to check exhaustiveness after the final arm.
fn wildcard_useful(p: &mut Patterns, reg: &ft.TypeRegistry, ty: i32) -> i32 {
    if p.wildcard { return 0 }
    for i in 0..reg.declared.type_counts[ty] {
        if !p.full[i] {
            var remaining := p.remaining
            result := variant_useful(&p, &reg, p.heads[i], -1, &mut remaining)
            p.remaining = remaining
            if result != 0 { return result }
        }
    }
    0
}
pub fn add(p: &mut Patterns, reg: &ft.TypeRegistry, ty: i32, root: i32, guarded: bool) -> string {
    field := p.fields[root]
    if field < 0 {
        if !guarded { p.wildcard = true; return "" }
        result := wildcard_useful(&mut p, &reg, ty)
        if result < 0 { return "match pattern coverage limit exceeded" }
        if result == 0 { return "unreachable match pattern" }
        return ""
    }
    ordinal := field - reg.declared.type_starts[ty]
    var flat := true
    var child := root + 1
    while child < p.ends[root] {
        if p.fields[child] >= 0 { flat = false; break }
        child = p.ends[child]
    }
    if p.wildcard { return "unreachable match pattern" }
    if p.full[ordinal] {
        if flat && !guarded { return "duplicate match variant" }
        return "unreachable match pattern"
    }
    var remaining := p.remaining
    result := variant_useful(&p, &reg, p.heads[ordinal], root, &mut remaining)
    p.remaining = remaining
    if result < 0 { return "match pattern coverage limit exceeded" }
    if result == 0 { return "unreachable match pattern" }
    // A matching guard may fail, leaving precisely the same values available
    // to later arms. Only unconditional patterns extend the coverage matrix.
    if guarded { return "" }
    p.previous[root] = p.heads[ordinal]; p.heads[ordinal] = root
    // Ordinary flat matches use one direct lookup per arm.
    if flat { p.full[ordinal] = true }
    ""
}
pub fn complete(p: &mut Patterns, reg: &ft.TypeRegistry, ty: i32) -> string {
    result := wildcard_useful(&mut p, &reg, ty)
    if result < 0 { return "match pattern coverage limit exceeded" }
    if result == 1 { return "non-exhaustive match" }
    ""
}

@test fn product_patterns_agree_with_finite_domain() {
    // Pair(Bit, Bit) has four inhabitants and nine patterns with leaves
    // chosen from { Zero, One, _ }. Check every subset against direct matching.
    var reg := ft.new_registry()
    bit := ft.add_type(&mut reg, "Bit", 3, 0)
    pair := ft.add_type(&mut reg, "Pair", 7, 0)
    reg.declared.type_counts[bit] = 2
    reg.declared.type_starts[pair] = 2; reg.declared.type_counts[pair] = 1
    reg.payload_starts = [0, 0, 0]; reg.payload_counts = [0, 0, 2]
    reg.payload_types = [bit, bit]
    for subset in 0..512 {
        var patterns := new(1)
        var covered := 0
        for choice in 0..9 {
            if subset.bit_and(1.shl(choice)) == 0 { continue }
            left := choice / 3 - 1; right := choice % 3 - 1
            var mask := 0
            for point in 0..4 {
                if (left < 0 || left == point / 2) && (right < 0 || right == point % 2) {
                    mask = mask.bit_or(1.shl(point))
                }
            }
            root := node(&mut patterns, 2)
            x := node(&mut patterns, left); y := node(&mut patterns, right)
            close(&mut patterns, root)
            guarded := add(&mut patterns, &reg, pair, root, true)
            message := add(&mut patterns, &reg, pair, root, false)
            assert(guarded == message)
            if mask.bit_and(covered) == mask { assert(message == "unreachable match pattern") }
            else { assert(message == "") }
            covered = covered.bit_or(mask)
        }
        fallback := node(&mut patterns, -1)
        guarded := add(&mut patterns, &reg, pair, fallback, true)
        outcome := complete(&mut patterns, &reg, pair)
        if covered == 15 { assert(guarded == "unreachable match pattern" && outcome == "") }
        else { assert(guarded == "" && outcome == "non-exhaustive match") }
        assert(add(&mut patterns, &reg, pair, fallback, false) == "")
        assert(complete(&mut patterns, &reg, pair) == "")
    }
}
