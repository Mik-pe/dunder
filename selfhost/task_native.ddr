import arm64 as arm
import ffi_arm64 as abi
import runtime

// Each submitted job exclusively owns its isolated allocator until the group
// completes. The scope caps outstanding jobs, and libdispatch reuses threads.
// Control (80 B): state 0, dispatch group 8, input 16, result 24, arena base 32,
// parent result 40, submitted allocator cursor 48, wait error 56, unmap error
// 64, recycled arena 72. Only the worker writes result/base while running.
// States: ready 0, submitted 1, cached 4, submission failed 5, wait failed 6,
// discarded 8, unmap failed 9, cached owner consumed 10. On wait failure the
// child may still be using the arena. Keep the group, arena and control alive.
pub fn policy_tag() -> string { "native-dispatch-task2-arm64-macos" }
pub fn control_bytes() -> i32 { 80 }
pub fn pool_bytes() -> i64 { 536870912 }
pub fn supported(platform: i32, profiling: bool) -> bool { platform == 0 && !profiling }
// Clone label -1 means identity for a proven scalar-only boundary. Label0 is
// an ordinary valid label, never a sentinel. Worker must always be a label.
// All three labels use the uniform internal ABI: source/root bits in X0,
// returned root bits in X0. Clones borrow their source; worker consumes its
// owned argument and transfers the owned result to control. A fatal worker
// trap retains the existing process-fatal semantics; it is not a task error.
pub struct TaskSpec { input_clone: i32, worker: i32, result_clone: i32 }
pub struct Symbols {
    symbol_count: i32, global_queue: i32, create_group: i32, submit: i32,
    wait: i32, release_group: i32, munmap: i32,
}
pub struct Provider {
    ok: bool, error: string, create: i32, collect: i32, discard: i32, worker_entry: i32,
    import_sites: []i32, import_slots: []i32,
}
pub struct UnmapHelper {
    ok: bool, error: string, label: i32, import_sites: []i32, import_slots: []i32,
}
fn result() -> Provider {
    Provider { ok: false, error: "", create: -1, collect: -1, discard: -1, worker_entry: -1, import_sites: [], import_slots: [] }
}
fn load(c: &mut arm.Code, dst: i32, base: i32, offset: i32) { abi.load(&mut c, dst, base, offset, 8) }
fn store(c: &mut arm.Code, src: i32, base: i32, offset: i32) { abi.store(&mut c, src, base, offset, 8) }
fn compare(c: &mut arm.Code, reg: i32, value: i32) { arm.emit(&mut c, 4043309087 + i64(value) * 1024 + i64(reg) * 32) }
fn begin(c: &mut arm.Code, label: i32, slots: i32) { arm.mark(&mut c, label); at := arm.prologue(&mut c); arm.frame(&mut c, at, slots) }
fn state(c: &mut arm.Code, value: i32) { arm.imm(&mut c, 10, i64(value)); store(&mut c, 10, 1, 0) }
fn imported(c: &mut arm.Code, out: &mut Provider, slot: i32) {
    out.import_sites.push(arm.position(&c) * 4); out.import_slots.push(slot)
    arm.emit(&mut c, 0); arm.emit(&mut c, 0); arm.emit(&mut c, 3594453504) // BLR X16
}
// x0 points to fresh, unexposed control storage; x1 is a synchronously borrowed source
// root (or scalar bits). Initialization does not take/drop a managed owner.
// This must not be used to reset an existing live control.
pub fn emit_initialize(c: &mut arm.Code) {
    for slot in 0..10 { var src := 31; if slot == 2 { src = 1 }; store(&mut c, src, 0, slot * 8) }
}
pub fn emit_unmap_pool(c: &mut arm.Code, symbols: &Symbols) -> UnmapHelper {
    var out := UnmapHelper { ok: false, error: "", label: -1, import_sites: [], import_slots: [] }
    if c.platform != 0 { out.error = "isolated native tasks require ARM64/macOS"; return out }
    if c.profile { out.error = "isolated native task profiling is not supported"; return out }
    if c.checking { out.error = "isolated native task emission requires a code sink"; return out }
    if c.mir_capture { out.error = "isolated native task helpers must be outside source MIR"; return out }
    if symbols.symbol_count < 6 || symbols.munmap < 0 || symbols.munmap >= symbols.symbol_count {
        out.error = "invalid isolated native task specification"; return out
    }
    out.label = arm.label(&mut c); begin(&mut c, out.label, 1)
    done := arm.label(&mut c); arm.branch(&mut c, done, 18)
    arm.imm(&mut c, 1, pool_bytes())
    out.import_sites.push(arm.position(&c) * 4); out.import_slots.push(symbols.munmap)
    arm.emit(&mut c, 0); arm.emit(&mut c, 0); arm.emit(&mut c, 3594453504); arm.emit(&mut c, 2470476800)
    arm.mark(&mut c, done); arm.ret(&mut c)
    out.ok = true; out
}

// Clone synchronously in the destination allocator domain. The caller's
// borrowed source remains live for this call and is never sent to a worker.
fn create(c: &mut arm.Code, out: &mut Provider, spec: &TaskSpec, symbols: &Symbols) {
    begin(&mut c, out.create, 5); arm.store(&mut c, 0, 0)
    bad := arm.label(&mut c); failed := arm.label(&mut c)
    load(&mut c, 10, 0, 0); compare(&mut c, 10, 0); arm.branch(&mut c, bad, 3)
    arm.imm(&mut c, 0, 0); arm.imm(&mut c, 1, 0)
    imported(&mut c, &mut out, symbols.global_queue)
    arm.branch(&mut c, failed, 18); arm.store(&mut c, 1, 0)
    imported(&mut c, &mut out, symbols.create_group)
    arm.branch(&mut c, failed, 18)
    arm.load_into(&mut c, 0, 1); store(&mut c, 0, 1, 8)
    for reg in 19..22 { arm.store(&mut c, reg - 17, reg) }
    load(&mut c, 21, 1, 72); store(&mut c, 31, 1, 72)
    arm.imm(&mut c, 19, 0); arm.imm(&mut c, 20, 0)
    fresh := arm.label(&mut c); compare(&mut c, 21, 0); arm.branch(&mut c, fresh, 2)
    for bin in 0..32 { store(&mut c, 31, 21, bin * 8) }
    arm.emit(&mut c, 2432696320 + 256 * 1024 + 21 * 32 + 19)
    arm.imm(&mut c, 11, pool_bytes())
    arm.emit(&mut c, 2332033024 + 11 * 65536 + 21 * 32 + 20)
    arm.mark(&mut c, fresh); load(&mut c, 0, 1, 16)
    if spec.input_clone >= 0 { arm.branch(&mut c, spec.input_clone, 1) }
    arm.load_into(&mut c, 0, 1); store(&mut c, 0, 1, 16)
    store(&mut c, 19, 1, 48); store(&mut c, 21, 1, 32)
    for reg in 19..22 { arm.load_into(&mut c, reg - 17, reg) }
    arm.branch(&mut c, out.worker_entry, 20); arm.mov(&mut c, 3, 0)
    arm.load_into(&mut c, 0, 2); load(&mut c, 0, 2, 8); arm.load_into(&mut c, 1, 1)
    imported(&mut c, &mut out, symbols.submit)
    arm.load_into(&mut c, 0, 1); state(&mut c, 1); arm.imm(&mut c, 0, 0); arm.ret(&mut c)
    arm.mark(&mut c, failed); arm.load_into(&mut c, 0, 1); state(&mut c, 5)
    arm.mark(&mut c, bad); arm.imm(&mut c, 0, -1); arm.ret(&mut c)
}

// Dispatch uses the native C ABI. Preserve the thread's complete callee-save
// set and resume the allocator handed off by create, even on a reused thread.
fn entry(c: &mut arm.Code, spec: &TaskSpec, label: i32) {
    begin(&mut c, label, 20); arm.store(&mut c, 0, 0)
    for reg in 19..29 { arm.store(&mut c, 1 + reg - 19, reg) }
    for reg in 8..16 { abi.fp(&mut c, reg, 10, 8, false); arm.store(&mut c, 11 + reg - 8, 10) }
    for reg in 20..25 { arm.imm(&mut c, reg, 0) }
    load(&mut c, 19, 0, 48); load(&mut c, 21, 0, 32)
    fresh := arm.label(&mut c); compare(&mut c, 21, 0); arm.branch(&mut c, fresh, 2)
    arm.imm(&mut c, 11, pool_bytes()); arm.emit(&mut c, 2332033024 + 11 * 65536 + 21 * 32 + 20)
    arm.mark(&mut c, fresh); load(&mut c, 0, 0, 16)
    arm.branch(&mut c, spec.worker, 1)
    arm.load_into(&mut c, 0, 1); store(&mut c, 0, 1, 24); store(&mut c, 21, 1, 32)
    for reg in 8..16 { arm.load_into(&mut c, 11 + reg - 8, 10); abi.fp(&mut c, reg, 10, 8, true) }
    for reg in 19..29 { arm.load_into(&mut c, 1 + reg - 19, reg) }
    arm.imm(&mut c, 0, 0); arm.ret(&mut c)
}
fn collect(c: &mut arm.Code, out: &mut Provider, spec: &TaskSpec, symbols: &Symbols) {
    common := arm.label(&mut c)
    arm.mark(&mut c, out.collect); arm.imm(&mut c, 1, 0); arm.branch(&mut c, common, 0)
    arm.mark(&mut c, out.discard); arm.imm(&mut c, 1, 1); arm.branch(&mut c, common, 0)
    begin(&mut c, common, 2); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1)
    wait := arm.label(&mut c); discard := arm.label(&mut c)
    success := arm.label(&mut c); bad := arm.label(&mut c)
    wait_failed := arm.label(&mut c); unmap_failed := arm.label(&mut c)
    old_wait_error := arm.label(&mut c); old_unmap_error := arm.label(&mut c)
    discarded := arm.label(&mut c); finish_discard := arm.label(&mut c)
    load(&mut c, 10, 0, 0)
    compare(&mut c, 10, 1); arm.branch(&mut c, wait, 2)
    compare(&mut c, 10, 4); arm.branch(&mut c, success, 2)
    compare(&mut c, 10, 6); arm.branch(&mut c, old_wait_error, 2)
    compare(&mut c, 10, 8); arm.branch(&mut c, discarded, 2)
    compare(&mut c, 10, 9); arm.branch(&mut c, old_unmap_error, 2)
    arm.branch(&mut c, bad, 0)
    arm.mark(&mut c, wait); load(&mut c, 0, 0, 8); arm.imm(&mut c, 1, -1)
    imported(&mut c, &mut out, symbols.wait)
    arm.load_into(&mut c, 0, 1); store(&mut c, 0, 1, 56); arm.branch(&mut c, wait_failed, 19)
    load(&mut c, 0, 1, 8); imported(&mut c, &mut out, symbols.release_group)
    arm.load_into(&mut c, 0, 1); store(&mut c, 31, 1, 8); store(&mut c, 31, 1, 16)
    arm.load(&mut c, 1); arm.branch(&mut c, discard, 19)
    load(&mut c, 0, 1, 24)
    if spec.result_clone >= 0 { arm.branch(&mut c, spec.result_clone, 1) }
    arm.load_into(&mut c, 0, 1); store(&mut c, 0, 1, 40)
    load(&mut c, 10, 1, 32); store(&mut c, 10, 1, 72); state(&mut c, 4)
    cleared := arm.label(&mut c); arm.branch(&mut c, cleared, 0)
    arm.mark(&mut c, discard); load(&mut c, 0, 1, 32)
    arm.branch(&mut c, finish_discard, 18)
    arm.imm(&mut c, 1, pool_bytes()); imported(&mut c, &mut out, symbols.munmap); arm.emit(&mut c, 2470476800)
    arm.load_into(&mut c, 0, 1); store(&mut c, 0, 1, 64); arm.branch(&mut c, unmap_failed, 19)
    arm.mark(&mut c, finish_discard); state(&mut c, 8)
    arm.mark(&mut c, cleared); store(&mut c, 31, 1, 24); store(&mut c, 31, 1, 32)
    arm.mark(&mut c, success); arm.imm(&mut c, 0, 0); arm.ret(&mut c)
    arm.mark(&mut c, wait_failed); state(&mut c, 6); arm.ret(&mut c)
    arm.mark(&mut c, unmap_failed); state(&mut c, 9); arm.ret(&mut c)
    arm.mark(&mut c, old_wait_error); load(&mut c, 0, 0, 56); arm.ret(&mut c)
    arm.mark(&mut c, old_unmap_error); load(&mut c, 0, 0, 64); arm.ret(&mut c)
    arm.mark(&mut c, discarded); arm.load(&mut c, 1); arm.branch(&mut c, success, 19); arm.branch(&mut c, bad, 0)
    arm.mark(&mut c, bad); arm.imm(&mut c, 0, -1); arm.ret(&mut c)
}

fn valid_symbols(s: &Symbols) -> bool {
    slots := [s.global_queue, s.create_group, s.submit, s.wait, s.release_group, s.munmap]
    for i in 0..slots.len {
        if slots[i] < 0 || slots[i] >= s.symbol_count { return false }
        for j in 0..i { if slots[j] == slots[i] { return false } }
    }
    true
}
pub fn emit(c: &mut arm.Code, rt: &runtime.Runtime, spec: &TaskSpec, symbols: &Symbols) -> Provider {
    var out := result()
    if c.platform != 0 { out.error = "isolated native tasks require ARM64/macOS"; return out }
    if c.profile { out.error = "isolated native task profiling is not supported"; return out }
    if c.checking { out.error = "isolated native task emission requires a code sink"; return out }
    if c.mir_capture { out.error = "isolated native task helpers must be outside source MIR"; return out }
    count := arm.label_count(&c)
    if rt.alloc < 0 || rt.alloc >= count || spec.input_clone < -1 || spec.input_clone >= count ||
        spec.worker < 0 || spec.worker >= count || spec.result_clone < -1 || spec.result_clone >= count ||
        !valid_symbols(&symbols) {
        out.error = "invalid isolated native task specification"; return out
    }
    out.worker_entry = arm.label(&mut c); out.create = arm.label(&mut c); out.collect = arm.label(&mut c); out.discard = arm.label(&mut c)
    entry(&mut c, &spec, out.worker_entry); create(&mut c, &mut out, &spec, &symbols); collect(&mut c, &mut out, &spec, &symbols)
    out.ok = true; out
}
