import std.map as map
import std.bytes as bytes

pub enum Kind { End, Name, Keyword, Integer, Float, String, Rune, Symbol, Newline, Byte }
pub struct Tokens {
    intern: bool, store_ends: bool, kinds: []Kind,
    texts: []string,
    starts: []i32,
    ends: []i32,
    ids: []i64,
    symbols: map.Map,
    ok: bool,
    error: string,
    error_at: i32,
}
struct Scanner {
    source: string, cursor: i32, parens: i32, formats: i32, ok: bool, error: string, error_at: i32,
}
fn ascii_char(byte: i32) -> string {
    if byte < 48 {
        if byte < 42 {
            if byte == 33 { return "!" }
            if byte == 37 { return "%" }
            if byte == 38 { return "&" }
            if byte == 40 { return "(" }
            if byte == 41 { return ")" }
            return ""
        }
        if byte == 42 { return "*" }
        if byte == 43 { return "+" }
        if byte == 44 { return "," }
        if byte == 45 { return "-" }
        if byte == 46 { return "." }
        if byte == 47 { return "/" }
        return ""
    }
    if byte <= 57 {
        if byte <= 52 {
            if byte == 48 { return "0" }
            if byte == 49 { return "1" }
            if byte == 50 { return "2" }
            if byte == 51 { return "3" }
            return "4"
        }
        if byte == 53 { return "5" }
        if byte == 54 { return "6" }
        if byte == 55 { return "7" }
        if byte == 56 { return "8" }
        return "9"
    }
    if byte <= 64 {
        if byte == 58 { return ":" }
        if byte == 59 { return ";" }
        if byte == 60 { return "<" }
        if byte == 61 { return "=" }
        if byte == 62 { return ">" }
        if byte == 64 { return "@" }
        return ""
    }
    if byte == 91 { return "[" }
    if byte == 93 { return "]" }
    if byte == 123 { return "{" }
    if byte == 125 { return "}" }
    ""
}
// The keyword vocabulary is fixed; classification needs no hash table or heap.
fn keyword(text: string) -> bool {
    length := text.len
    if length == 2 { return text == "fn" || text == "if" || text == "in" || text == "as" }
    if length == 3 { return text == "pub" || text == "var" || text == "mut" || text == "for" }
    if length == 4 { return text == "else" || text == "enum" || text == "true" }
    if length == 5 { return text == "while" || text == "break" || text == "match" || text == "false" || text == "defer" }
    if length == 6 { return text == "return" || text == "struct" || text == "import" }
    length == 8 && text == "continue"
}
fn emit(tokens: &mut Tokens, kind: Kind, text: string, start: i32, end: i32) {
    var actual := kind
    var id: i64 = -1
    if kind == .Name {
        if keyword(text) { actual = .Keyword }
        if tokens.intern {
            id = map.get_or(&tokens.symbols, text, -1)
            if id < 0 { id = i64(map.length(&tokens.symbols)); map.put(&mut tokens.symbols, text, id) }
        }
    }
    tokens.kinds.push(actual); tokens.texts.push(text)
    tokens.starts.push(start); if tokens.store_ends { tokens.ends.push(end) }; if tokens.intern { tokens.ids.push(id) }
}
fn fail(scanner: &mut Scanner, message: string) {
    scanner.ok = false
    scanner.error = message
    scanner.error_at = scanner.cursor
}
fn digit(byte: i32) -> bool { byte >= 48 && byte <= 57 }
fn alpha(byte: i32) -> bool { (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128 }
fn hex(byte: i32) -> i32 {
    if digit(byte) { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 65 + 10 }
    if byte >= 97 && byte <= 102 { return byte - 97 + 10 }
    -1
}
fn scalar(output: &mut []i32, value: i32) -> bool {
    if value < 0 || value > 1114111 || (value >= 55296 && value <= 57343) { return false }
    if value < 128 { output.push(value) }
    else if value < 2048 { output.push(192 + value / 64); output.push(128 + value % 64) }
    else if value < 65536 { output.push(224 + value / 4096); output.push(128 + value / 64 % 64); output.push(128 + value % 64) }
    else { output.push(240 + value / 262144); output.push(128 + value / 4096 % 64); output.push(128 + value / 64 % 64); output.push(128 + value % 64) }
    true
}
// The backslash has already been consumed. Both ordinary and interpolated
// string segments use exactly the same escape and UTF-8 rules.
fn escaped(scanner: &mut Scanner, data: &mut []i32) {
    if scanner.cursor >= scanner.source.len { fail(&mut scanner, "unterminated literal"); return }
    escape := scanner.source[scanner.cursor]
    scanner.cursor = scanner.cursor + 1
    if escape == 110 { data.push(10) }
    else if escape == 114 { data.push(13) }
    else if escape == 116 { data.push(9) }
    else if escape == 48 { data.push(0) }
    else if escape == 92 || escape == 34 || escape == 39 || escape == 96 { data.push(escape) }
    else if escape == 120 {
        var value := 0
        for i in 0..2 {
            if scanner.cursor >= scanner.source.len { fail(&mut scanner, "incomplete hex escape"); return }
            n := hex(scanner.source[scanner.cursor])
            if n < 0 { fail(&mut scanner, "invalid hex escape"); return }
            value = value * 16 + n
            scanner.cursor = scanner.cursor + 1
        }
        data.push(value)
    } else if escape == 117 {
        braced := scanner.cursor < scanner.source.len && scanner.source[scanner.cursor] == 123
        if braced { scanner.cursor = scanner.cursor + 1 }
        var count := 0
        var value := 0
        var ended := false
        while scanner.cursor < scanner.source.len {
            if braced && scanner.source[scanner.cursor] == 125 { scanner.cursor = scanner.cursor + 1; ended = true; break }
            if !braced && count == 4 { ended = true; break }
            n := hex(scanner.source[scanner.cursor])
            if n < 0 || count == 6 { fail(&mut scanner, "invalid Unicode escape"); return }
            value = value * 16 + n
            count = count + 1
            scanner.cursor = scanner.cursor + 1
        }
        if !braced && count == 4 { ended = true }
        if !ended || count == 0 || !scalar(&mut data, value) { fail(&mut scanner, "invalid Unicode scalar"); return }
    } else { fail(&mut scanner, "unknown escape") }
}
fn quoted(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    quote := scanner.source[start]
    scanner.cursor = start + 1
    // Source text is already UTF-8. Plain literals can use a checked slice
    // instead of constructing and decoding a temporary byte array.
    while scanner.cursor < scanner.source.len {
        byte := scanner.source[scanner.cursor]
        if byte == quote {
            value := scanner.source[start + 1..scanner.cursor]
            scanner.cursor = scanner.cursor + 1
            var kind := Kind.String
            if quote == 96 {
                if value.runes().len != 1 { fail(&mut scanner, "rune needs one Unicode scalar"); return }
                kind = .Rune
            }
            emit(&mut tokens, kind, value, start, scanner.cursor)
            return
        }
        if byte == 92 || byte == 10 || byte == 13 { break }
        scanner.cursor = scanner.cursor + 1
    }
    var data: []i32 = []
    for i in start + 1..scanner.cursor { data.push(scanner.source[i]) }
    var closed := false
    while scanner.cursor < scanner.source.len {
        byte := scanner.source[scanner.cursor]
        scanner.cursor = scanner.cursor + 1
        if byte == quote { closed = true; break }
        if byte == 10 || byte == 13 { break }
        if byte != 92 { data.push(byte); continue }
        if scanner.cursor >= scanner.source.len { break }
        escaped(&mut scanner, &mut data)
        if !scanner.ok { return }
    }
    if !closed { fail(&mut scanner, "unterminated literal"); return }
    decoded := bytes.utf8(&data)
    if !decoded.ok { fail(&mut scanner, "literal is not valid UTF-8"); return }
    var kind := Kind.String
    if quote == 96 {
        if decoded.value.runes().len != 1 { fail(&mut scanner, "rune needs one Unicode scalar"); return }
        kind = .Rune
    }
    emit(&mut tokens, kind, decoded.value, start, scanner.cursor)
}
fn radix_digit(byte: i32, radix: i32) -> bool {
    if radix == 16 { return hex(byte) >= 0 }
    if radix == 2 { return byte == 48 || byte == 49 }
    digit(byte)
}
fn check_separators(scanner: &mut Scanner, value: string, begin: i32, radix: i32) -> bool {
    for i in begin..value.len {
        if value[i] == 95 && (i == begin || i == value.len - 1 || !radix_digit(value[i - 1], radix) || !radix_digit(value[i + 1], radix)) {
            fail(&mut scanner, "numeric separator must be between digits")
            return false
        }
    }
    true
}
fn byte_literal(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    scanner.cursor = start + 2
    if scanner.cursor >= scanner.source.len { fail(&mut scanner, "unterminated byte literal"); return }
    first := scanner.source[scanner.cursor]
    if first == 39 { fail(&mut scanner, "empty byte literal"); return }
    if first == 10 || first == 13 || first >= 128 { fail(&mut scanner, "byte literal must be a single ASCII byte"); return }
    var value := 0
    if first != 92 {
        value = first
        scanner.cursor = scanner.cursor + 1
    } else {
        scanner.cursor = scanner.cursor + 1
        if scanner.cursor >= scanner.source.len { fail(&mut scanner, "unterminated byte literal"); return }
        escape := scanner.source[scanner.cursor]
        scanner.cursor = scanner.cursor + 1
        if escape == 110 { value = 10 }
        else if escape == 114 { value = 13 }
        else if escape == 116 { value = 9 }
        else if escape == 48 { value = 0 }
        else if escape == 92 || escape == 34 || escape == 39 || escape == 96 { value = escape }
        else if escape == 120 {
            for i in 0..2 {
                if scanner.cursor >= scanner.source.len { fail(&mut scanner, "incomplete hex escape"); return }
                n := hex(scanner.source[scanner.cursor])
                if n < 0 { fail(&mut scanner, "invalid hex escape"); return }
                value = value * 16 + n
                scanner.cursor = scanner.cursor + 1
            }
        } else { fail(&mut scanner, "unknown escape"); return }
    }
    if scanner.cursor >= scanner.source.len || scanner.source[scanner.cursor] != 39 {
        fail(&mut scanner, "unterminated byte literal"); return
    }
    scanner.cursor = scanner.cursor + 1
    emit(&mut tokens, .Byte, value.str(), start, scanner.cursor)
}
fn number(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    if scanner.source[start] == 48 && start + 1 < scanner.source.len {
        prefix := scanner.source[start + 1]
        var radix := 0
        if prefix == 120 || prefix == 88 { radix = 16 }
        else if prefix == 98 || prefix == 66 { radix = 2 }
        if radix != 0 {
            scanner.cursor = start + 2
            while scanner.cursor < scanner.source.len && (radix_digit(scanner.source[scanner.cursor], radix) || scanner.source[scanner.cursor] == 95) {
                scanner.cursor = scanner.cursor + 1
            }
            if scanner.cursor == start + 2 { fail(&mut scanner, "prefixed integer literal needs digits"); return }
            value := scanner.source[start..scanner.cursor]
            if !check_separators(&mut scanner, value, 2, radix) { return }
            emit(&mut tokens, .Integer, value, start, scanner.cursor)
            return
        }
    }
    while scanner.cursor < scanner.source.len && (digit(scanner.source[scanner.cursor]) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
    var kind := Kind.Integer
    if scanner.cursor + 1 < scanner.source.len && scanner.source[scanner.cursor] == 46 && digit(scanner.source[scanner.cursor + 1]) {
        kind = .Float
        scanner.cursor = scanner.cursor + 1
        while scanner.cursor < scanner.source.len && (digit(scanner.source[scanner.cursor]) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
    }
    if scanner.cursor < scanner.source.len && (scanner.source[scanner.cursor] == 101 || scanner.source[scanner.cursor] == 69) {
        kind = .Float
        scanner.cursor = scanner.cursor + 1
        if scanner.cursor < scanner.source.len && (scanner.source[scanner.cursor] == 43 || scanner.source[scanner.cursor] == 45) { scanner.cursor = scanner.cursor + 1 }
        first := scanner.cursor
        while scanner.cursor < scanner.source.len && (digit(scanner.source[scanner.cursor]) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
        if scanner.cursor == first { fail(&mut scanner, "exponent needs digits"); return }
    }
    if scanner.cursor == start + 1 {
        emit(&mut tokens, kind, ascii_char(scanner.source[start]), start, scanner.cursor)
        return
    }
    value := scanner.source[start..scanner.cursor]
    if !check_separators(&mut scanner, value, 0, 10) { return }
    emit(&mut tokens, kind, value, start, scanner.cursor)
}
fn synthetic(tokens: &mut Tokens, kind: Kind, text: string, at: i32) {
    // A zero-width span marks generated spelling. The module loader can
    // reconstruct decoded segments without taking a slice of f-string text.
    emit(&mut tokens, kind, text, at, at)
}
fn format_segment(scanner: &mut Scanner, tokens: &mut Tokens, data: &[]i32, at: i32) {
    decoded := bytes.utf8(&data)
    if !decoded.ok { fail(&mut scanner, "literal is not valid UTF-8"); return }
    synthetic(&mut tokens, .String, decoded.value, at)
}
fn format_hole(scanner: &mut Scanner, tokens: &mut Tokens) -> i32 {
    first := tokens.kinds.len
    var closes: []string = []
    while scanner.cursor < scanner.source.len && scanner.ok {
        if scanner.source[scanner.cursor] == 125 && closes.len == 0 {
            if tokens.kinds.len == first { fail(&mut scanner, "empty interpolation expression"); return -1 }
            at := scanner.cursor
            scanner.cursor = scanner.cursor + 1
            return at
        }
        before := tokens.kinds.len
        scan_one(&mut scanner, &mut tokens)
        if !scanner.ok { return -1 }
        // Strings and comments consume their own delimiters. A recursively
        // expanded f-string emits several balanced tokens and is one lexeme.
        if tokens.kinds.len != before + 1 || tokens.kinds[before] != .Symbol { continue }
        word := tokens.texts[before]
        if word == "(" { closes.push(")") }
        else if word == "[" { closes.push("]") }
        else if word == "{" { closes.push("}") }
        else if word == ")" || word == "]" || word == "}" {
            if closes.len == 0 || closes[closes.len - 1] != word {
                scanner.cursor = tokens.starts[before]
                fail(&mut scanner, "unbalanced interpolation delimiter"); return -1
            }
            unused := closes.pop()
        }
    }
    if scanner.ok { fail(&mut scanner, "unterminated interpolation expression") }
    -1
}
fn formatted(scanner: &mut Scanner, tokens: &mut Tokens) {
    if scanner.formats >= 64 { fail(&mut scanner, "interpolated string nesting exceeds 64"); return }
    start := scanner.cursor
    quote := scanner.source[start + 1]
    scanner.formats = scanner.formats + 1
    scanner.parens = scanner.parens + 1
    scanner.cursor = start + 2
    synthetic(&mut tokens, .Symbol, "(", start)
    var segment_at := scanner.cursor
    var data: []i32 = []
    while scanner.cursor < scanner.source.len && scanner.ok {
        at := scanner.cursor
        byte := scanner.source[at]
        if byte == quote {
            format_segment(&mut scanner, &mut tokens, &data, segment_at)
            if !scanner.ok { return }
            synthetic(&mut tokens, .Symbol, ")", at)
            scanner.cursor = at + 1
            scanner.parens = scanner.parens - 1
            scanner.formats = scanner.formats - 1
            return
        }
        if byte == 10 || byte == 13 { fail(&mut scanner, "unterminated interpolated string"); return }
        if byte == 92 {
            scanner.cursor = at + 1
            escaped(&mut scanner, &mut data)
            continue
        }
        if byte == 123 || byte == 125 {
            if at + 1 < scanner.source.len && scanner.source[at + 1] == byte {
                data.push(byte); scanner.cursor = at + 2; continue
            }
            if byte == 125 { fail(&mut scanner, "single '}' in interpolated string; use '}}'"); return }
            format_segment(&mut scanner, &mut tokens, &data, segment_at)
            if !scanner.ok { return }
            synthetic(&mut tokens, .Symbol, "+", at)
            synthetic(&mut tokens, .Symbol, "(", at)
            scanner.cursor = at + 1
            close := format_hole(&mut scanner, &mut tokens)
            if !scanner.ok { return }
            synthetic(&mut tokens, .Symbol, ")", close)
            synthetic(&mut tokens, .Symbol, ".", close)
            synthetic(&mut tokens, .Name, "str", close)
            synthetic(&mut tokens, .Symbol, "(", close)
            synthetic(&mut tokens, .Symbol, ")", close)
            synthetic(&mut tokens, .Symbol, "+", close)
            data.clear(); segment_at = scanner.cursor
            continue
        }
        data.push(byte); scanner.cursor = at + 1
    }
    if scanner.ok { fail(&mut scanner, "unterminated interpolated string") }
}
// Consume one source lexeme, including whitespace or a complete comment.
// Interpolation holes reuse this scanner rather than approximating quotes,
// nested comments, byte/rune literals or the ordinary token vocabulary.
fn scan_one(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    byte := scanner.source[start]
    var next := 0
    if start + 1 < scanner.source.len { next = scanner.source[start + 1] }
    if byte == 10 {
        scanner.cursor = start + 1
        if scanner.parens == 0 { emit(&mut tokens, .Newline, "\n", start, scanner.cursor) }
    } else if byte == 32 || byte == 9 || byte == 13 {
        scanner.cursor = start + 1
        while scanner.cursor < scanner.source.len && scanner.source[scanner.cursor] == byte { scanner.cursor = scanner.cursor + 1 }
    }
    else if byte == 47 && next == 47 { while scanner.cursor < scanner.source.len && scanner.source[scanner.cursor] != 10 { scanner.cursor = scanner.cursor + 1 } }
    else if byte == 47 && next == 42 {
        scanner.cursor = start + 2
        var depth := 1
        while scanner.cursor < scanner.source.len && depth > 0 {
            pos := scanner.cursor
            if pos + 1 < scanner.source.len && scanner.source[pos] == 47 && scanner.source[pos + 1] == 42 { depth = depth + 1; scanner.cursor = pos + 2 }
            else if pos + 1 < scanner.source.len && scanner.source[pos] == 42 && scanner.source[pos + 1] == 47 { depth = depth - 1; scanner.cursor = pos + 2 }
            else {
                scanner.cursor = pos + 1
                if scanner.source[pos] == 10 && scanner.parens == 0 { emit(&mut tokens, .Newline, "\n", pos, pos + 1) }
            }
        }
        if depth != 0 { fail(&mut scanner, "unterminated block comment") }
    } else if byte == 34 || byte == 39 || byte == 96 { quoted(&mut scanner, &mut tokens) }
    else if byte == 98 && next == 39 { byte_literal(&mut scanner, &mut tokens) }
    else if byte == 102 && (next == 34 || next == 39) { formatted(&mut scanner, &mut tokens) }
    else if alpha(byte) {
        scanner.cursor = start + 1
        while scanner.cursor < scanner.source.len && (alpha(scanner.source[scanner.cursor]) || digit(scanner.source[scanner.cursor])) { scanner.cursor = scanner.cursor + 1 }
        emit(&mut tokens, .Name, scanner.source[start..scanner.cursor], start, scanner.cursor)
    } else if digit(byte) { number(&mut scanner, &mut tokens) }
    else {
        var symbol := ""
        if next == 61 {
            if byte == 58 { symbol = ":=" } else if byte == 61 { symbol = "==" } else if byte == 33 { symbol = "!=" }
            else if byte == 60 { symbol = "<=" } else if byte == 62 { symbol = ">=" } else if byte == 43 { symbol = "+=" }
            else if byte == 45 { symbol = "-=" } else if byte == 42 { symbol = "*=" } else if byte == 47 { symbol = "/=" }
            else if byte == 37 { symbol = "%=" }
        } else if next == 62 {
            if byte == 45 { symbol = "->" } else if byte == 61 { symbol = "=>" }
        } else if byte == next {
            if byte == 38 { symbol = "&&" } else if byte == 124 { symbol = "||" } else if byte == 46 { symbol = ".." }
        }
        if symbol == "" { symbol = ascii_char(byte) }
        if symbol == "" { fail(&mut scanner, "unexpected character"); return }
        if byte == 40 || byte == 91 { scanner.parens = scanner.parens + 1 }
        if (byte == 41 || byte == 93) && scanner.parens > 0 { scanner.parens = scanner.parens - 1 }
        scanner.cursor = start + symbol.len
        emit(&mut tokens, .Symbol, symbol, start, scanner.cursor)
    }
}
pub fn empty(intern: bool) -> Tokens {
    Tokens { intern: intern, store_ends: true, kinds: [], texts: [], starts: [], ends: [], ids: [],
        symbols: map.new(), ok: true, error: "", error_at: 0 }
}
pub fn lex(source: string) -> Tokens { scan(source, true) }
pub fn scan(source: string, intern: bool) -> Tokens {
    var tokens := empty(intern)
    scan_into(source, &mut tokens)
    tokens
}
// Append one file, including its End token. Byte offsets are local to the file.
pub fn scan_into(source: string, tokens: &mut Tokens) {
    if !tokens.ok { return }
    var scanner := Scanner { source: source, cursor: 0, parens: 0, formats: 0, ok: true, error: "", error_at: 0 }
    if tokens.kinds.len == 0 {
        est := source.len / 4 + 8
        tokens.kinds.reserve(est); tokens.texts.reserve(est)
        tokens.starts.reserve(est); if tokens.store_ends { tokens.ends.reserve(est) }
        if tokens.intern { tokens.ids.reserve(est) }
    }
    while scanner.cursor < source.len && scanner.ok {
        scan_one(&mut scanner, &mut tokens)
    }
    emit(&mut tokens, .End, "", scanner.cursor, scanner.cursor)
    if !scanner.ok { tokens.ok = false; tokens.error = scanner.error; tokens.error_at = scanner.error_at }
}
@test fn scan_into_appends_file_local_tokens_and_errors() {
    var tokens := empty(true)
    scan_into("name(", &mut tokens)
    scan_into("\nname /*", &mut tokens)
    tokens.kinds.len == 6
    tokens.ids.len == tokens.kinds.len
    tokens.kinds[2] == .End
    tokens.kinds[3] == .Newline
    tokens.starts[3] == 0
    tokens.starts[4] == 1
    tokens.ids[4] == tokens.ids[0]
    tokens.kinds[5] == .End
    tokens.ends[5] == 8
    !tokens.ok
    tokens.error_at == 8
    tokens.error == "unterminated block comment"
}
@test fn lexer_handles_literals_comments_ranges_symbols_and_identifier_interning() {
    tokens := lex("fn hälsa(x: i32) { /* outer /* nested */ */\n x := 20\n print(\"å \\u{1f30d}\")\n for i in 0..2 { x = x + i }\n}")
    tokens.ok
    tokens.texts[0] == "fn"
    tokens.kinds[0] == .Keyword
    tokens.texts[1] == "hälsa"
    tokens.starts[1] == 3
    map.contains(&tokens.symbols, "x")
    var found := false
    for i in 0..tokens.kinds.len { if tokens.kinds[i] == .String { tokens.texts[i] == "å 🌍"; found = true } }
    found
    !lex("\"\\xff\"").ok
    !lex("/* open").ok
    !lex("1e+").ok
    !lex("1__2").ok
    !lex("`ab`").ok
    lex("1.25e-3 42_000 `🌍`").ok
}

@test fn lexer_classifies_only_whole_keywords_without_interning() {
    tokens := scan("fn if in as pub var mut for else enum true while break match false return struct import continue defer", false)
    tokens.ok
    tokens.kinds.len == 21
    for i in 0..20 { tokens.kinds[i] == .Keyword }
    tokens.ids.len == 0
    ordinary := lex("f iffy inside assert public variable mutable format elsewhere enumeration true_value while2 breaks matcher falsehood returned structure imported continues deferred unsafe extern capability")
    ordinary.ok
    for i in 0..ordinary.kinds.len - 1 { ordinary.kinds[i] == .Name }
    ordinary.ids[0] == 0
}

@test fn lexer_handles_byte_radix_and_compound_tokens() {
    bytes := scan("b'A' b'\\r' b'\\n' b'\\t' b'\\0' b'\\\\' b'\\'' b'\\xff' b' '", false)
    bytes.ok
    bytes.kinds.len == 10
    for i in 0..9 { bytes.kinds[i] == .Byte }
    bytes.texts[0] == "65"
    bytes.texts[1] == "13"
    bytes.texts[7] == "255"
    bytes.texts[8] == "32"
    !scan("b''", false).ok
    !scan("b'ab'", false).ok
    !scan("b'å'", false).ok
    !scan("b'\\u{41}'", false).ok
    !scan("b'a", false).ok
    nums := scan("0xff 0Xdead_BEEF 0b1010_0101 0B11 0x1e", false)
    nums.ok
    nums.kinds.len == 6
    for i in 0..5 { nums.kinds[i] == .Integer }
    nums.texts[0] == "0xff"
    nums.texts[4] == "0x1e"
    !scan("0x", false).ok
    !scan("0b", false).ok
    !scan("0x_1", false).ok
    !scan("0b10_", false).ok
    !scan("0x1__2", false).ok
    ops := scan("+= -= *= /= %=", false)
    ops.ok
    ops.kinds.len == 6
    ops.texts[0] == "+="
    ops.texts[1] == "-="
    ops.texts[2] == "*="
    ops.texts[3] == "/="
    ops.texts[4] == "%="
}

@test fn plain_and_escaped_literals_preserve_utf8_spans_and_errors() {
    tokens := scan("\"å 🌍\" 'plain' `🌍` \"a\\nβ\"", false)
    tokens.ok
    tokens.kinds.len == 5
    tokens.texts[0] == "å 🌍"
    tokens.starts[0] == 0
    tokens.ends[0] == 9
    tokens.texts[1] == "plain"
    tokens.kinds[2] == .Rune
    tokens.texts[2] == "🌍"
    tokens.texts[3] == "a\nβ"
    empty := scan("\"\"", false)
    empty.ok
    empty.texts[0] == ""
    newline := scan("\"plain\n", false)
    !newline.ok
    newline.error == "unterminated literal"
    newline.error_at == 7
    !scan("`ab`", false).ok
    !scan("`🌍a`", false).ok
    !scan("\"prefix\\xff\"", false).ok
}

@test fn interpolation_expands_to_ordinary_tokens_with_original_offsets() {
    tokens := lex("f\"å {value + 2}!\"\nname")
    tokens.ok
    expected := ["(", "å ", "+", "(", "value", "+", "2", ")", ".", "str", "(", ")", "+", "!", ")", "\n", "name", ""]
    tokens.texts.len == expected.len
    for i in 0..expected.len { tokens.texts[i] == expected[i] }
    tokens.kinds[1] == .String
    tokens.kinds[4] == .Name
    tokens.kinds[6] == .Integer
    tokens.kinds[9] == .Name
    tokens.kinds[13] == .String
    tokens.kinds[15] == .Newline
    tokens.kinds[17] == .End
    tokens.starts[1] == 2 && tokens.ends[1] == 2
    tokens.starts[4] == 6 && tokens.ends[4] == 11
    tokens.starts[6] == 14 && tokens.ends[6] == 15
    tokens.starts[9] == 15 && tokens.ends[9] == 15
    tokens.starts[13] == 16 && tokens.ends[13] == 16
    tokens.starts[16] == 19 && tokens.ends[16] == 23
    tokens.ids.len == tokens.kinds.len
    map.contains(&tokens.symbols, "value")
    map.contains(&tokens.symbols, "str")
}

@test fn interpolation_escapes_and_literal_braces_do_not_change_ordinary_strings() {
    tokens := scan("f'{{\\x7b\\u{7d}}}\\n\\0å'", false)
    tokens.ok
    tokens.kinds.len == 4
    tokens.kinds[1] == .String
    tokens.texts[1] == "{{}}\n\0å"
    tokens.starts[1] == tokens.ends[1]
    empty := scan("f\"\"", false)
    empty.ok && empty.kinds.len == 4 && empty.texts[1] == ""
    plain := scan("\"{value}\" '{{}}' f \"{value}\" af\"{value}\"", false)
    plain.ok
    plain.kinds.len == 7
    plain.kinds[0] == .String && plain.texts[0] == "{value}"
    plain.kinds[1] == .String && plain.texts[1] == "{{}}"
    plain.kinds[2] == .Name && plain.texts[2] == "f"
    plain.kinds[4] == .Name && plain.texts[4] == "af"
    !scan("f\"\\xff\"", false).ok
    !scan("f\"\\xff{value}\"", false).ok
    !scan("f\"\\u{d800}\"", false).ok
}

@test fn interpolation_reuses_nested_delimiters_comments_and_recursive_strings() {
    tokens := scan("f\"{select(Point {value: 2}, [1, 2][0], \"}\") /* { /* } */ } */ + f'inner {value}'}\"\nnext", false)
    tokens.ok
    expanded := scan("(\"\" + (select(Point {value: 2}, [1, 2][0], \"}\") + (\"inner \" + (value).str() + \"\")).str() + \"\")\nnext", false)
    expanded.ok
    tokens.kinds.len == expanded.kinds.len
    for i in 0..tokens.kinds.len {
        tokens.kinds[i] == expanded.kinds[i]
        tokens.texts[i] == expanded.texts[i]
    }
    multiline := scan("f\"{ // } ignored\n 1 +\n2 }\"\nnext", false)
    multiline.ok
    var lines := 0
    for i in 0..multiline.kinds.len { if multiline.kinds[i] == .Newline { lines += 1 } }
    lines == 1
    scan("f\"{b'}' + i32(`}`)}\"", false).ok
}

@test fn interpolation_preserves_interning_optional_spans_and_file_boundaries() {
    var compact := empty(true)
    compact.store_ends = false
    scan_into("f\"{value}:{value}\"", &mut compact)
    first_file := compact.kinds.len
    scan_into("\nvalue", &mut compact)
    compact.ok
    compact.ends.len == 0
    compact.ids.len == compact.kinds.len
    compact.kinds[first_file - 1] == .End
    compact.kinds[first_file] == .Newline
    compact.starts[first_file] == 0
    value_id := map.get_or(&compact.symbols, "value", -1)
    value_id >= 0
    var occurrences := 0
    for i in 0..compact.kinds.len {
        if compact.kinds[i] == .Name && compact.texts[i] == "value" {
            compact.ids[i] == value_id
            occurrences += 1
        }
    }
    occurrences == 3
    uninterned := scan("f'{value}'", false)
    uninterned.ok && uninterned.ids.len == 0
    uninterned.starts.len == uninterned.kinds.len
    uninterned.ends.len == uninterned.kinds.len
}

@test fn interpolation_reports_original_error_offsets_and_bounds_recursion() {
    sources := ["f\"}\"", "f\"{}\"", "f\"{ /*x*/ }\"", "f\"{(1]}\"", "f\"{", "f\"plain", "f\"line\n\""]
    offsets := [2, 3, 10, 5, 3, 7, 6]
    messages := ["single '}' in interpolated string; use '}}'", "empty interpolation expression", "empty interpolation expression", "unbalanced interpolation delimiter", "unterminated interpolation expression", "unterminated interpolated string", "unterminated interpolated string"]
    for i in 0..sources.len {
        tokens := scan(sources[i], false)
        !tokens.ok
        tokens.error_at == offsets[i]
        tokens.error == messages[i]
    }
    !scan("f\"{1\"", false).ok
    !scan("f\"{ /* never closed", false).ok
    !scan("f\"\\q\"", false).ok
    var source := "1"
    for i in 0..64 { source = "f\"{" + source + "}\"" }
    scan(source, false).ok
    source = "f\"{" + source + "}\""
    deep := scan(source, false)
    !deep.ok
    deep.error == "interpolated string nesting exceeds 64"
    deep.error_at == 192
}
