import std.map as map
import std.bytes as bytes

pub enum Kind { End, Name, Keyword, Integer, Float, String, Rune, Symbol, Newline }
pub struct Tokens {
    intern: bool, kinds: []Kind,
    texts: []string,
    starts: []i32,
    ends: []i32,
    ids: []i64,
    symbols: map.Map,
    ok: bool,
    error: string,
    error_at: i32,
}
struct Scanner {
    source: string, cursor: i32, parens: i32, tokens: Tokens,
}
fn ascii_char(byte: i32) -> string {
    if byte < 48 {
        if byte < 42 {
            if byte == 33 { return "!" }
            if byte == 37 { return "%" }
            if byte == 38 { return "&" }
            if byte == 40 { return "(" }
            if byte == 41 { return ")" }
            return ""
        }
        if byte == 42 { return "*" }
        if byte == 43 { return "+" }
        if byte == 44 { return "," }
        if byte == 45 { return "-" }
        if byte == 46 { return "." }
        if byte == 47 { return "/" }
        return ""
    }
    if byte <= 57 {
        if byte <= 52 {
            if byte == 48 { return "0" }
            if byte == 49 { return "1" }
            if byte == 50 { return "2" }
            if byte == 51 { return "3" }
            return "4"
        }
        if byte == 53 { return "5" }
        if byte == 54 { return "6" }
        if byte == 55 { return "7" }
        if byte == 56 { return "8" }
        return "9"
    }
    if byte <= 64 {
        if byte == 58 { return ":" }
        if byte == 59 { return ";" }
        if byte == 60 { return "<" }
        if byte == 61 { return "=" }
        if byte == 62 { return ">" }
        if byte == 64 { return "@" }
        return ""
    }
    if byte == 91 { return "[" }
    if byte == 93 { return "]" }
    if byte == 123 { return "{" }
    if byte == 125 { return "}" }
    ""
}
// The keyword vocabulary is fixed; classification needs no hash table or heap.
fn keyword(text: string) -> bool {
    length := text.len
    if length == 2 { return text == "fn" || text == "if" || text == "in" || text == "as" }
    if length == 3 { return text == "pub" || text == "var" || text == "mut" || text == "for" }
    if length == 4 { return text == "else" || text == "enum" || text == "true" }
    if length == 5 { return text == "while" || text == "break" || text == "match" || text == "false" }
    if length == 6 { return text == "return" || text == "struct" || text == "import" }
    length == 8 && text == "continue"
}
fn emit(tokens: &mut Tokens, kind: Kind, text: string, start: i32, end: i32) {
    var actual := kind
    var id: i64 = -1
    if kind == .Name {
        if keyword(text) { actual = .Keyword }
        if tokens.intern {
            id = map.get_or(&tokens.symbols, text, -1)
            if id < 0 { id = i64(map.length(&tokens.symbols)); map.put(&mut tokens.symbols, text, id) }
        }
    }
    tokens.kinds.push(actual); tokens.texts.push(text)
    tokens.starts.push(start); tokens.ends.push(end); if tokens.intern { tokens.ids.push(id) }
}
fn fail(scanner: &mut Scanner, message: string) {
    scanner.tokens.ok = false
    scanner.tokens.error = message
    scanner.tokens.error_at = scanner.cursor
}
fn digit(byte: i32) -> bool { byte >= 48 && byte <= 57 }
fn alpha(byte: i32) -> bool { (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128 }
fn hex(byte: i32) -> i32 {
    if digit(byte) { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 65 + 10 }
    if byte >= 97 && byte <= 102 { return byte - 97 + 10 }
    -1
}
fn scalar(output: &mut []i32, value: i32) -> bool {
    if value < 0 || value > 1114111 || (value >= 55296 && value <= 57343) { return false }
    if value < 128 { output.push(value) }
    else if value < 2048 { output.push(192 + value / 64); output.push(128 + value % 64) }
    else if value < 65536 { output.push(224 + value / 4096); output.push(128 + value / 64 % 64); output.push(128 + value % 64) }
    else { output.push(240 + value / 262144); output.push(128 + value / 4096 % 64); output.push(128 + value / 64 % 64); output.push(128 + value % 64) }
    true
}
fn quoted(scanner: &mut Scanner) {
    start := scanner.cursor
    quote := scanner.source[start]
    scanner.cursor = start + 1
    // Source text is already UTF-8. Plain literals can use a checked slice
    // instead of constructing and decoding a temporary byte array.
    while scanner.cursor < scanner.source.len {
        byte := scanner.source[scanner.cursor]
        if byte == quote {
            value := scanner.source[start + 1..scanner.cursor]
            scanner.cursor = scanner.cursor + 1
            var kind := Kind.String
            if quote == 96 {
                if value.runes().len != 1 { fail(&mut scanner, "rune needs one Unicode scalar"); return }
                kind = .Rune
            }
            emit(&mut scanner.tokens, kind, value, start, scanner.cursor)
            return
        }
        if byte == 92 || byte == 10 || byte == 13 { break }
        scanner.cursor = scanner.cursor + 1
    }
    var data: []i32 = []
    for i in start + 1..scanner.cursor { data.push(scanner.source[i]) }
    var closed := false
    while scanner.cursor < scanner.source.len {
        byte := scanner.source[scanner.cursor]
        scanner.cursor = scanner.cursor + 1
        if byte == quote { closed = true; break }
        if byte == 10 || byte == 13 { break }
        if byte != 92 { data.push(byte); continue }
        if scanner.cursor >= scanner.source.len { break }
        escape := scanner.source[scanner.cursor]
        scanner.cursor = scanner.cursor + 1
        if escape == 110 { data.push(10) }
        else if escape == 114 { data.push(13) }
        else if escape == 116 { data.push(9) }
        else if escape == 48 { data.push(0) }
        else if escape == 92 || escape == 34 || escape == 39 || escape == 96 { data.push(escape) }
        else if escape == 120 {
            var value := 0
            for i in 0..2 {
                if scanner.cursor >= scanner.source.len { fail(&mut scanner, "incomplete hex escape"); return }
                n := hex(scanner.source[scanner.cursor])
                if n < 0 { fail(&mut scanner, "invalid hex escape"); return }
                value = value * 16 + n
                scanner.cursor = scanner.cursor + 1
            }
            data.push(value)
        } else if escape == 117 {
            braced := scanner.cursor < scanner.source.len && scanner.source[scanner.cursor] == 123
            if braced { scanner.cursor = scanner.cursor + 1 }
            var count := 0
            var value := 0
            var ended := false
            while scanner.cursor < scanner.source.len {
                if braced && scanner.source[scanner.cursor] == 125 { scanner.cursor = scanner.cursor + 1; ended = true; break }
                if !braced && count == 4 { ended = true; break }
                n := hex(scanner.source[scanner.cursor])
                if n < 0 || count == 6 { fail(&mut scanner, "invalid Unicode escape"); return }
                value = value * 16 + n
                count = count + 1
                scanner.cursor = scanner.cursor + 1
            }
            if !braced && count == 4 { ended = true }
            if !ended || count == 0 || !scalar(&mut data, value) { fail(&mut scanner, "invalid Unicode scalar"); return }
        } else { fail(&mut scanner, "unknown escape"); return }
    }
    if !closed { fail(&mut scanner, "unterminated literal"); return }
    decoded := bytes.utf8(&data)
    if !decoded.ok { fail(&mut scanner, "literal is not valid UTF-8"); return }
    var kind := Kind.String
    if quote == 96 {
        if decoded.value.runes().len != 1 { fail(&mut scanner, "rune needs one Unicode scalar"); return }
        kind = .Rune
    }
    emit(&mut scanner.tokens, kind, decoded.value, start, scanner.cursor)
}
fn number(scanner: &mut Scanner) {
    start := scanner.cursor
    while scanner.cursor < scanner.source.len && (digit(scanner.source[scanner.cursor]) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
    var kind := Kind.Integer
    if scanner.cursor + 1 < scanner.source.len && scanner.source[scanner.cursor] == 46 && digit(scanner.source[scanner.cursor + 1]) {
        kind = .Float
        scanner.cursor = scanner.cursor + 1
        while scanner.cursor < scanner.source.len && (digit(scanner.source[scanner.cursor]) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
    }
    if scanner.cursor < scanner.source.len && (scanner.source[scanner.cursor] == 101 || scanner.source[scanner.cursor] == 69) {
        kind = .Float
        scanner.cursor = scanner.cursor + 1
        if scanner.cursor < scanner.source.len && (scanner.source[scanner.cursor] == 43 || scanner.source[scanner.cursor] == 45) { scanner.cursor = scanner.cursor + 1 }
        first := scanner.cursor
        while scanner.cursor < scanner.source.len && (digit(scanner.source[scanner.cursor]) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
        if scanner.cursor == first { fail(&mut scanner, "exponent needs digits"); return }
    }
    var value := ""
    if scanner.cursor == start + 1 { value = ascii_char(scanner.source[start]) }
    else { value = scanner.source[start..scanner.cursor] }
    for i in 0..value.len {
        if value[i] == 95 && (i == 0 || i == value.len - 1 || !digit(value[i - 1]) || !digit(value[i + 1])) { fail(&mut scanner, "numeric separator must be between digits"); return }
    }
    emit(&mut scanner.tokens, kind, value, start, scanner.cursor)
}
pub fn empty(intern: bool) -> Tokens {
    Tokens { intern: intern, kinds: [], texts: [], starts: [], ends: [], ids: [],
        symbols: map.new(), ok: true, error: "", error_at: 0 }
}
pub fn lex(source: string) -> Tokens { scan(source, true) }
pub fn scan(source: string, intern: bool) -> Tokens {
    var scanner := Scanner { source: source, cursor: 0, parens: 0, tokens: empty(intern) }
    est := source.len / 4 + 8
    scanner.tokens.kinds.reserve(est); scanner.tokens.texts.reserve(est)
    scanner.tokens.starts.reserve(est); scanner.tokens.ends.reserve(est)
    if intern { scanner.tokens.ids.reserve(est) }
    while scanner.cursor < source.len && scanner.tokens.ok {
        start := scanner.cursor
        byte := source[start]
        var next := 0
        if start + 1 < source.len { next = source[start + 1] }
        if byte == 10 {
            scanner.cursor = start + 1
            if scanner.parens == 0 { emit(&mut scanner.tokens, .Newline, "\n", start, scanner.cursor) }
        } else if byte == 32 || byte == 9 || byte == 13 { scanner.cursor = start + 1 }
        else if byte == 47 && next == 47 { while scanner.cursor < source.len && source[scanner.cursor] != 10 { scanner.cursor = scanner.cursor + 1 } }
        else if byte == 47 && next == 42 {
            scanner.cursor = start + 2
            var depth := 1
            while scanner.cursor < source.len && depth > 0 {
                pos := scanner.cursor
                if pos + 1 < source.len && source[pos] == 47 && source[pos + 1] == 42 { depth = depth + 1; scanner.cursor = pos + 2 }
                else if pos + 1 < source.len && source[pos] == 42 && source[pos + 1] == 47 { depth = depth - 1; scanner.cursor = pos + 2 }
                else {
                    scanner.cursor = pos + 1
                    if source[pos] == 10 && scanner.parens == 0 { emit(&mut scanner.tokens, .Newline, "\n", pos, pos + 1) }
                }
            }
            if depth != 0 { fail(&mut scanner, "unterminated block comment") }
        } else if byte == 34 || byte == 39 || byte == 96 { quoted(&mut scanner) }
        else if alpha(byte) {
            scanner.cursor = start + 1
            while scanner.cursor < source.len && (alpha(source[scanner.cursor]) || digit(source[scanner.cursor])) { scanner.cursor = scanner.cursor + 1 }
            emit(&mut scanner.tokens, .Name, source[start..scanner.cursor], start, scanner.cursor)
        } else if digit(byte) { number(&mut scanner) }
        else {
            var width := 1
            if (byte == 58 && next == 61) || (byte == 45 && next == 62) || (byte == 61 && (next == 61 || next == 62)) || (byte == 33 && next == 61) || ((byte == 60 || byte == 62) && next == 61) || (byte == 38 && next == 38) || (byte == 124 && next == 124) || (byte == 46 && next == 46) { width = 2 }
            if width == 1 && byte != 40 && byte != 41 && byte != 91 && byte != 93 && byte != 123 && byte != 125 && byte != 58 && byte != 61 && byte != 44 && byte != 46 && byte != 59 && byte != 64 && byte != 43 && byte != 45 && byte != 42 && byte != 47 && byte != 37 && byte != 60 && byte != 62 && byte != 33 && byte != 38 { fail(&mut scanner, "unexpected character"); break }
            if byte == 40 || byte == 91 { scanner.parens = scanner.parens + 1 }
            if (byte == 41 || byte == 93) && scanner.parens > 0 { scanner.parens = scanner.parens - 1 }
            scanner.cursor = start + width
            var symbol := ascii_char(byte)
            if width != 1 { symbol = source[start..scanner.cursor] }
            emit(&mut scanner.tokens, .Symbol, symbol, start, scanner.cursor)
        }
    }
    emit(&mut scanner.tokens, .End, "", scanner.cursor, scanner.cursor)
    scanner.tokens
}
@test fn lexer_handles_literals_comments_ranges_symbols_and_identifier_interning() {
    tokens := lex("fn hälsa(x: i32) { /* outer /* nested */ */\n x := 20\n print(\"å \\u{1f30d}\")\n for i in 0..2 { x = x + i }\n}")
    tokens.ok
    tokens.texts[0] == "fn"
    tokens.kinds[0] == .Keyword
    tokens.texts[1] == "hälsa"
    tokens.starts[1] == 3
    map.contains(&tokens.symbols, "x")
    var found := false
    for i in 0..tokens.kinds.len { if tokens.kinds[i] == .String { tokens.texts[i] == "å 🌍"; found = true } }
    found
    !lex("\"\\xff\"").ok
    !lex("/* open").ok
    !lex("1e+").ok
    !lex("1__2").ok
    !lex("`ab`").ok
    lex("1.25e-3 42_000 `🌍`").ok
}

@test fn lexer_classifies_only_whole_keywords_without_interning() {
    tokens := scan("fn if in as pub var mut for else enum true while break match false return struct import continue", false)
    tokens.ok
    tokens.kinds.len == 20
    for i in 0..19 { tokens.kinds[i] == .Keyword }
    tokens.ids.len == 0
    ordinary := lex("f iffy inside assert public variable mutable format elsewhere enumeration true_value while2 breaks matcher falsehood returned structure imported continues unsafe extern capability")
    ordinary.ok
    for i in 0..ordinary.kinds.len - 1 { ordinary.kinds[i] == .Name }
    ordinary.ids[0] == 0
}

@test fn plain_and_escaped_literals_preserve_utf8_spans_and_errors() {
    tokens := scan("\"å 🌍\" 'plain' `🌍` \"a\\nβ\"", false)
    tokens.ok
    tokens.kinds.len == 5
    tokens.texts[0] == "å 🌍"
    tokens.starts[0] == 0
    tokens.ends[0] == 9
    tokens.texts[1] == "plain"
    tokens.kinds[2] == .Rune
    tokens.texts[2] == "🌍"
    tokens.texts[3] == "a\nβ"
    empty := scan("\"\"", false)
    empty.ok
    empty.texts[0] == ""
    newline := scan("\"plain\n", false)
    !newline.ok
    newline.error == "unterminated literal"
    newline.error_at == 7
    !scan("`ab`", false).ok
    !scan("`🌍a`", false).ok
    !scan("\"prefix\\xff\"", false).ok
}
