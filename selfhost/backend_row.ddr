// Function input uses one i64 cell per common operation. Values in the u32
// range are raw instructions. Tagged cells carry semantic operands and never
// appear in linked images. The general literal uses an additional high limb.
import float_operation as floating

pub fn kind(cell: i64) -> i32 { i32(cell.shr(56)) }
pub fn reg(cell: i64) -> i32 { i32(cell.shr(48).bit_and(31)) }
pub fn operand(cell: i64) -> i64 { cell.bit_and(281474976710655) }
fn header(kind: i32, reg: i32) -> i64 { i64(kind).shl(56).bit_or(i64(reg).shl(48)) }
pub fn literal(rows: &mut []i64, reg: i32, value: i64) {
    if value >= -140737488355328 && value < 140737488355328 {
        rows.push(header(1, reg).bit_or(value.bit_and(281474976710655)))
    } else {
        rows.push(header(2, reg).bit_or(value.bit_and(4294967295)))
        rows.push(value.shr(32).bit_and(4294967295))
    }
}
pub fn copy(dst: i32, source: i32) -> i64 { header(3, dst).bit_or(i64(source)) }
pub fn frame(tag: i32, slot: i32, reg: i32) -> i64 { header(tag, reg).bit_or(i64(slot)) }
// The relocation carries the resolved source symbol. Only the argument
// registers and source position survive ABI lowering to this call row.
pub fn source_call(arguments: i32, offset: i32) -> i64 {
    header(48, arguments).bit_or(i64(offset))
}
pub fn valid_source_call(cell: i64) -> bool {
    kind(cell) == 48 && reg(cell) <= 8 && cell.bit_and(63050394783186944) == 0 && operand(cell) <= 2147483647
}
// Ownership helpers are ordered source operations. Their symbolic relocation
// binds the helper and their second cell carries the original source offset.
pub enum Ownership { Copy, Drop, NormalizeTransfer, Clear }
pub fn ownership(action: Ownership, ty: i32) -> i64 {
    header(16 + i32(action), 0).bit_or(i64(ty))
}
pub enum OwnerStore { Install, Transfer, Vacate, Initialize }
pub fn owner_store(action: OwnerStore, ty: i32, slot: i32) -> i64 {
    header(20 + i32(action), 0).bit_or(i64(slot).shl(32)).bit_or(i64(ty))
}
pub fn owner_store_tag(tag: i32) -> bool { tag >= 20 && tag <= 23 }
pub fn owner_store_cell(cell: i64) -> bool {
    owner_store_tag(kind(cell)) && cell.bit_and(72057594037927935).shr(32) <= 65535 &&
        cell.bit_and(4294967295) <= 2147483647
}
pub fn source(offset: i32) -> i64 { header(24, 0).bit_or(i64(offset)) }
pub fn ownership_tag(tag: i32) -> bool { tag >= 16 && tag <= 19 }
pub fn owner_cell(cell: i64) -> bool {
    ownership_tag(kind(cell)) && cell.bit_and(72057594037927935) <= 2147483647
}
pub fn source_cell(cell: i64) -> bool {
    kind(cell) == 24 && cell.bit_and(72057594037927935) <= 2147483647
}
// A task operation carries its resolved result type, source byte offset and
// (for spawn) the worker declaration, independent of the bound runtime entry.
pub enum Task { ScopeOpen, ScopeClose, Spawn, Await, AwaitOnce }
pub fn task_tag(action: Task) -> i32 { 49 + i32(action) }
pub fn task(action: Task, ty: i32, worker: i32) -> i64 {
    header(task_tag(action), 0).bit_or(i64(worker).bit_and(65535).shl(32)).bit_or(i64(ty))
}
pub fn task_origin(source: i32, worker: i32) -> i64 {
    header(25, 0).bit_or(i64(worker).shr(16).shl(32)).bit_or(i64(source))
}
pub fn task_decl(cell: i64, origin: i64) -> i64 {
    operand(origin).shr(32).shl(16).bit_or(operand(cell).shr(32))
}
pub fn is_task(tag: i32) -> bool { tag >= 49 && tag <= 53 }
pub fn awaiting(tag: i32) -> bool { tag == 52 || tag == 53 }
fn task_cell(cell: i64) -> bool {
    if !is_task(kind(cell)) || cell.bit_and(71776119061217280) != 0 || operand(cell).bit_and(2147483648) != 0 { return false }
    if kind(cell) == task_tag(.ScopeClose) { return operand(cell) == 0 }
    kind(cell) == task_tag(.Spawn) || operand(cell) <= 2147483647
}
pub fn call_header(cell: i64) -> bool { owner_cell(cell) || task_cell(cell) }
pub fn call_pair(cell: i64, origin: i64) -> bool {
    if owner_cell(cell) { return source_cell(origin) }
    if !task_cell(cell) || kind(origin) != 25 || origin.bit_and(71916856549572608) != 0 ||
        operand(origin).bit_and(2147483648) != 0 { return false }
    kind(cell) == task_tag(.Spawn) || operand(origin) <= 2147483647
}
// A source edge carries its action and normalized byte offset. Relocation
// sidecars own bound symbol IDs. The generic row admits runtime transfers.
pub enum Edge { Symbolic, Jump, WhenFalse, WhenTrue, NextVariant, RangeDone, Return, Break, Continue, Assert, Bounds, Defer, Resume }

fn source_reloc(edge: i32) -> i32 {
    if edge == i32(Edge.WhenFalse) || edge == i32(Edge.Assert) { return 18 }
    if edge == i32(Edge.WhenTrue) { return 19 }
    if edge == i32(Edge.NextVariant) { return 3 }
    if edge == i32(Edge.RangeDone) { return 12 }
    if edge == i32(Edge.Bounds) { return 4 }
    if edge == i32(Edge.Resume) { return 2 }
    0
}
pub fn edge_reloc(edge: Edge) -> i32 { source_reloc(i32(edge)) }

pub fn control(edge: Edge, reloc: i32, source: i32) -> i64 {
    header(32 + i32(edge), reloc).bit_or(i64(source))
}

pub fn control_row(cell: i64) -> bool { kind(cell) >= 32 && kind(cell) <= 32 + i32(Edge.Resume) }

pub fn valid_control(cell: i64, reloc: i32) -> bool {
    tag := kind(cell)
    if !control_row(cell) || cell.bit_and(63050394783186944) != 0 || reg(cell) != reloc ||
        reloc < 0 || reloc > 20 || operand(cell) > 2147483647 { return false }
    if tag == 32 { return operand(cell) == 0 }
    reloc == source_reloc(tag - 32)
}
// Low 32 bits identify the logical frame slot, shape 0..3 reads an
// unsigned 1/2/4/8-byte value, shape 4 sign-extends four bytes.
pub fn local_read(slot: i32, shape: i32) -> i64 {
    header(11, 0).bit_or(i64(shape).shl(32)).bit_or(i64(slot))
}
pub fn stack(push: bool, temporary: bool, reg: i32) -> i64 {
    var tag := 7
    if !push { tag = tag + 1 }; if !temporary { tag = tag + 2 }
    header(tag, reg)
}
// Binary rows carry the MIR opcode, operation width and NZCV definition.
// The right operand is a register for tag 12 or an unshifted integer for 13.
pub fn binary(opcode: i32, wide: bool, flags: bool, dst: i32, lhs: i32, rhs: i32, amount: i64) -> i64 {
    var tag := 12; var right := i64(rhs)
    if amount >= 0 { tag = 13; right = amount }
    var cell := header(tag, dst).bit_or(i64(opcode).shl(40)).bit_or(i64(lhs).shl(32)).bit_or(right)
    if wide { cell = cell.bit_or(i64(1).shl(39)) }; if flags { cell = cell.bit_or(i64(1).shl(38)) }; cell
}
pub fn binary_op(cell: i64) -> i32 { i32(cell.shr(40).bit_and(255)) }
pub fn binary_wide(cell: i64) -> bool { cell.bit_and(i64(1).shl(39)) != 0 }
pub fn binary_flags(cell: i64) -> bool { cell.bit_and(i64(1).shl(38)) != 0 }
pub fn binary_left(cell: i64) -> i32 { i32(cell.shr(32).bit_and(31)) }
pub fn binary_right(cell: i64) -> i64 { cell.bit_and(4294967295) }
pub fn bitfield_signed(cell: i64) -> bool { cell.bit_and(i64(1).shl(38)) != 0 }
pub fn bitfield(signed: bool, wide: bool, dst: i32, source: i32, rotate: i32, top: i32) -> i64 {
    var cell := header(14, dst).bit_or(i64(source).shl(32)).bit_or(i64(rotate + top * 64))
    if signed { cell = cell.bit_or(i64(1).shl(38)) }; if wide { cell = cell.bit_or(i64(1).shl(39)) }; cell
}
pub fn valid(cell: i64) -> bool {
    if control_row(cell) { return valid_control(cell, reg(cell)) }
    if cell < 0 || cell.bit_and(63050394783186944) != 0 { return false }
    tag := kind(cell)
    if tag == 48 { return valid_source_call(cell) }
    if tag == 61 {
        return floating.supported(i32(operand(cell).shr(32)), reg(cell)) && cell.bit_and(2147483648) == 0
    }
    if tag == 14 {
        if reg(cell) == 31 || binary_left(cell) == 31 || binary_op(cell) != 0 || cell.bit_and(i64(1).shl(37)) != 0 { return false }
        fields := binary_right(cell); var width := 32; if binary_wide(cell) { width = 64 }
        rotate := fields.bit_and(63); top := fields / 64
        return rotate < i64(width) && top < i64(width) && (!bitfield_signed(cell) || top >= rotate)
    }
    if tag == 12 || tag == 13 {
        opcode := binary_op(cell); right := binary_right(cell)
        if reg(cell) >= 31 || binary_left(cell) >= 31 || cell.bit_and(i64(1).shl(37)) != 0 { return false }
        if tag == 13 { return (opcode == 1 || opcode == 2) && right > 0 && (right <= 4095 || (right <= 16773120 && right % 4096 == 0)) }
        return right < 31 && (opcode == 1 || opcode == 2 || (!binary_flags(cell) &&
            (opcode == 3 || (opcode >= 8 && opcode <= 10) || opcode == 14 || opcode == 15)))
    }
    if tag >= 7 && tag <= 10 { return operand(cell) == 0 }
    if tag == 11 {
        return reg(cell) == 0 && operand(cell).shr(32) <= 4 && cell.bit_and(4294967295) <= 268435454
    }
    if tag >= 4 && tag <= 6 {
        return operand(cell) <= 268435454 && (tag != 6 || reg(cell) == 0) &&
            !(tag == 5 && operand(cell) >= 32 && reg(cell) == 9)
    }
    reg(cell) < 31 && (tag == 1 || (tag == 2 && operand(cell) <= 4294967295) || (tag == 3 && operand(cell) <= 31))
}
