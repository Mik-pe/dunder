capability unsafe

import std.bytes as bytes
import std.dl as dl
import sys

// POSIX host operations for inspecting existing resources and exclusively
// creating sibling files. These operate on the build host when cross-compiling.
@extern("c", "uname")
unsafe fn uname(output: ptr) -> i32
@extern("c", "opendir")
unsafe fn open_dir(path: ptr) -> ptr
@extern("c", "readdir")
unsafe fn read_dir(directory: ptr) -> ptr
@extern("c", "closedir")
unsafe fn close_dir(directory: ptr) -> i32
@extern("c", "readlink")
unsafe fn link_target(path: ptr, buffer: ptr, capacity: usize) -> i64
@extern("c", "fopen")
unsafe fn open_file(path: ptr, mode: ptr) -> ptr
@extern("c", "fread")
unsafe fn read_file(buffer: ptr, width: usize, count: usize, file: ptr) -> usize
@extern("c", "fwrite")
unsafe fn write_file(buffer: ptr, width: usize, count: usize, file: ptr) -> usize
@extern("c", "ferror")
unsafe fn stream_error(file: ptr) -> i32
@extern("c", "fclose")
unsafe fn close_file(file: ptr) -> i32
@extern("c", "chmod")
unsafe fn chmod(path: ptr, mode: u32) -> i32

fn path_bytes(path: string) -> []u8 {
    var result: []u8 = []
    bytes.append_utf8(&mut result, path)
    result.push(0)
    result
}

pub fn is_link(path: string) -> bool {
    raw := path_bytes(path)
    var byte: u8 = 0
    unsafe { return link_target(addr(&raw[0]), addr(&mut byte), 1) >= 0 }
}

pub struct Entries { paths: []string, error: string }

pub fn entries(path: string) -> Entries {
    var result := Entries {paths: [], error: ""}
    raw := path_bytes(path)
    unsafe {
        var uts: [u64; 256] = [0; 256]
        if uname(addr(&mut uts[0])) != 0 { result.error = "cannot identify host dirent layout"; return result }
        var name_at := 19
        var errno_name := cstr("__errno_location")
        os := load_u8(addr(&uts[0]))
        if os == 68 { name_at = 21; errno_name = cstr("__error") }
        else if os != 76 { result.error = "unsupported build host"; return result }
        process := dl.open(ptr(0), 2)
        if process == ptr(0) { result.error = "cannot access host errno"; return result }
        address := dl.symbol(process, errno_name)
        if address == ptr(0) { closed := dl.close(process); result.error = "cannot resolve host errno"; return result }
        errno_location: extern fn() -> ptr = ffi_fn(address)
        errno := errno_location()
        closed := dl.close(process)
        dir := open_dir(addr(&raw[0]))
        if dir == ptr(0) { result.error = "cannot open directory " + path; return result }
        var raw_name: []u8 = []
        while true {
            store_i32(errno, 0)
            entry := read_dir(dir)
            if entry == ptr(0) {
                if load_i32(errno) != 0 { result.error = "directory read failed: " + path }
                break
            }
            // Both supported dirent layouts contain a 16-bit record length at offset 16.
            length := i32(load_u16(ptr(usize(entry) + 16)))
            raw_name.clear()
            for offset in name_at..length {
                byte := load_u8(ptr(usize(entry) + usize(offset)))
                if byte == 0 { break }
                raw_name.push(byte)
            }
            name := bytes.decode(&raw_name)
            if !name.ok || raw_name.len == 0 || raw_name.len == length - name_at {
                result.error = "invalid resource name in " + path; break
            }
            if name.value != "." && name.value != ".." { result.paths.push(name.value) }
        }
        if close_dir(dir) != 0 { result.error = "failed to read directory " + path }
    }
    result
}

pub struct File { data: []u8, error: string }

pub fn contents(path: string) -> File {
    raw := path_bytes(path)
    var data: []u8 = []
    unsafe {
        file := open_file(addr(&raw[0]), cstr("rb"))
        if file == ptr(0) { return File {data: [], error: "cannot read resource " + path} }
        var chunk: [u8; 4096] = [0; 4096]
        while true {
            count := i32(read_file(addr(&mut chunk[0]), 1, 4096, file))
            for i in 0..count { data.push(chunk[i]) }
            if count < 4096 { break }
        }
        failed := stream_error(file) != 0
        closed := close_file(file)
        if failed || closed != 0 { return File {data: [], error: "error reading resource " + path} }
    }
    File { data: data, error: "" }
}

pub fn publish(path: string, data: &[]u8, executable: bool) -> string {
    temporary := path + ".dunder-" + sys.pid().str() + ".tmp"
    raw := path_bytes(temporary)
    unsafe {
        file := open_file(addr(&raw[0]), cstr("wbx"))
        if file == ptr(0) { return "cannot exclusively create " + temporary }
        var count: usize = 0
        if data.len > 0 { count = write_file(addr(&data[0]), 1, usize(data.len), file) }
        closed := close_file(file)
        var mode: u32 = 420
        if executable { mode = 493 }
        if count != usize(data.len) || closed != 0 || chmod(addr(&raw[0]), mode) != 0 {
            removed := sys.remove_file(temporary)
            return "cannot write " + temporary
        }
    }
    status := sys.rename(temporary, path)
    if !status.ok { removed := sys.remove_file(temporary); return sys.error_message(status.error) }
    ""
}
