// This entry is built by a task-capable serial compiler, outside the frozen
// seed dependency graph. Frontend traversal and publication have one owner.
// A single bounded task scope reuses worker arenas and streams batches in
// FIFO order, releasing each snapshot and worker pool on await.
import compile as compiler
import lexer
import mir
import mir_lift
import mir_lower
import mir_link
import mir_pipeline as pipeline
import mir_task
import fragments
import record_take
import opt_ir
import opt_verify
import opt_alloc
import machine_ir
import opt_emit
import opt_range
import opt_inline

fn empty_status() -> pipeline.Status {
    pipeline.Status { error: 0, frame_state: 0, value_state: 0, stats: pipeline.stats() }
}
fn failure(message: string) -> compiler.Result {
    compiler.Result { ok: false, error: message, offset: 0, text: [],
        imports: compiler.Imports { globals: 0, libraries: [], symbols: [], sites: [], slots: [] } }
}
fn accept_batch(session: &mut compiler.Session, link: &mut mir_link.Linker,
    object: &mut mir_lower.FunctionObject, data: &mut mir_lower.ObjectData,
    status: &mut pipeline.Status, answer: &mir_task.BatchAnswer,
    ordinals: &[]i32, declarations: &[]i32, item_offset: i32) -> i32 {
    count := mir_task.answer_len(&answer)
    var cursor := item_offset
    for i in 0..count {
        if cursor >= ordinals.len { return -1 }
        expected_ordinal := ordinals[cursor]
        expected_declaration := declarations[cursor]
        cursor = cursor + 1
        mir_task.unpack_answer(&answer, i, &mut data, &mut status)
        if mir_task.answer_ordinal(&answer, i) != expected_ordinal || mir_task.answer_declaration(&answer, i) != expected_declaration {
            status.error = 8
        }
        // The task scope and ordinal/declaration sidecars authenticate each item.
        // Data import validates its complete structure; it is not a second lowering
        // or a semantic certificate for arbitrary worker-supplied executable words.
        if status.error == 0 && !mir_lower.from_data_into(&mut object, &data) { status.error = 8 }
        if !compiler.accept_into(&mut session, &mut link, expected_ordinal, &object, &status) { return -1 }
    }
    cursor
}

pub fn compile_options(tokens: &mut lexer.Tokens, platform: i32,
    module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool,
    records: &mut compiler.Bindings, directory: string, identity: string,
    config: &compiler.Configuration) -> compiler.Result {
    if config.workers < 1 || config.workers > 256 { return failure("compiler workers must be 1..256") }
    // These paths use the identical shared Session driver without scheduling:
    // check has no backend work; one worker reuses serial arenas; the existing
    // compiler profile reports partitioned wall intervals, not summed CPU time.
    if check_all || config.workers == 1 || config.profile_host >= 0 || !config.mir_enabled {
        return compiler.compile_options(&mut tokens, platform, &module_starts, &module_files,
            check_all, report, &mut records, directory, identity, &config)
    }
    var session := compiler.new_session()
    var record_takes := record_take.new()
    var model := opt_ir.new()
    var verifier := opt_verify.new()
    var plan := opt_alloc.new()
    var machine := machine_ir.new()
    var settings := opt_emit.options()
    var range_work := opt_range.new()
    var catalog := opt_inline.new()
    var inline_work := opt_inline.workspace()
    if !compiler.begin_into(&mut session, &mut tokens, platform, &module_starts, &module_files,
        report, directory, identity, &config, &mut model, &mut verifier, &mut range_work,
        &mut catalog, &mut inline_work, &mut settings, &mut record_takes) { return compiler.session_error(&session) }
    var link := mir_link.new()
    if !compiler.begin_linker(&session, &mut link) { return failure("internal compiler prefix linking failure") }
    var function := mir.new()
    var final_object := mir_lower.new_object()
    var lowered := mir_lower.new_object()
    var lifter := mir_lift.new_work()
    var restored := fragments.new_dependencies()
    var options := pipeline.options()
    var terminals := pipeline.no_terminals()
    compiler.pipeline_options_into(&session, &mut options)
    compiler.terminals_into(&session, &mut terminals)
    ordinary := empty_status()
    var backend_failed := false
    var source_failed := false
    var batch := mir_task.new_batch(options, terminals)
    var data_scratch := mir_lower.new_data()
    var status_scratch := empty_status()
    task scope jobs(config.workers) {
        var keys: []TaskID<mir_task.BatchAnswer> = []
        var item_ordinals: []i32 = []
        var item_declarations: []i32 = []
        var read := 0
        var item_read := 0
        var spawned_items := 0
        var need_spawn := false
        var flush := false
        var cached := false
        var cached_ordinal := -1
        var done := false
        while !backend_failed {
            if need_spawn && keys.len - read < config.workers {
                keys.push(spawn jobs mir_task.execute_batch(batch))
                spawned_items = spawned_items + mir_task.batch_len(&batch)
                mir_task.reset_batch(&mut batch)
                need_spawn = false
                continue
            }
            if (need_spawn || flush) && read < keys.len {
                answer := await jobs(keys[read])
                read = read + 1
                next_item := accept_batch(&mut session, &mut link, &mut lowered,
                    &mut data_scratch, &mut status_scratch, &answer,
                    &item_ordinals, &item_declarations, item_read)
                if next_item < 0 { backend_failed = true; break }
                item_read = next_item
                continue
            }
            if flush {
                if cached {
                    if !compiler.accept_into(&mut session, &mut link, cached_ordinal,
                        &final_object, &ordinary) { backend_failed = true; break }
                    cached = false
                }
                if source_failed || done || compiler.source_done(&session) { break }
                flush = false
            }
            if compiler.source_done(&session) {
                if mir_task.batch_len(&batch) > 0 { need_spawn = true }
                flush = true
                done = true
                continue
            }
            state := compiler.next_into(&mut session, &mut function, &mut final_object,
                &mut lifter, &mut model, &mut verifier, &mut plan, &mut machine, &settings,
                &mut range_work, &catalog, &mut inline_work, &mut restored)
            if state == 1 {
                ordinal := compiler.current_ordinal(&session)
                declaration := compiler.current_declaration(&session)
                item_ordinals.push(ordinal)
                item_declarations.push(declaration)
                mir_task.push_batch(&mut batch, ordinal, declaration, &function)
                var target := 2
                if spawned_items >= config.workers * 8 { target = 8 }
                if mir_task.batch_len(&batch) >= target { need_spawn = true }
            } else {
                if state == 2 { cached = true; cached_ordinal = compiler.current_ordinal(&session) }
                else {
                    if state < 0 { source_failed = true }
                    done = true
                }
                if mir_task.batch_len(&batch) > 0 && !source_failed { need_spawn = true }
                flush = true
            }
        }
    }
    if backend_failed || source_failed { return compiler.session_error(&session) }
    compiler.finish(&mut session, &mut link, &mut model, &mut verifier, &mut plan, &mut machine,
        &settings, &mut range_work, &catalog, &mut inline_work, &mut records, &mut record_takes)
}
