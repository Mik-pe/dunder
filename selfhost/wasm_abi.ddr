import wasm_bytes as w

// Slots in the public table identify a host import or a typed Dunder callback.
// Slot 0 is null. Internal Dunder functions follow these slots in the image.
pub struct Abi {
    starts: []i32, counts: []i32, results: []i32, params: []i32,
    import_modules: []string, import_names: []string, import_sigs: []i32,
    callback_labels: []i32, callback_sigs: []i32, table: []i32,
}
pub fn new() -> Abi {
    Abi { starts: [], counts: [], results: [], params: [], import_modules: [], import_names: [], import_sigs: [], callback_labels: [], callback_sigs: [], table: [] }
}

// ids above the primitive range used in this ABI are extern function pointers.
fn scalar(ty: i32) -> i32 { if ty > 13 { return 13 }; ty }
fn value_type(ty: i32) -> i32 {
    if ty == 2 || ty == 11 { return 126 }
    if ty == 6 { return 125 }; if ty == 7 { return 124 }; 127
}
pub fn signature(a: &mut Abi, args: &[]i32, result: i32) -> i32 {
    count := args.len
    for s in 0..a.starts.len {
        if a.counts[s] == count && a.results[s] == scalar(result) {
            var equal := true
            for i in 0..count { if a.params[a.starts[s] + i] != scalar(args[i]) { equal = false } }
            if equal { return s }
        }
    }
    a.starts.push(a.params.len); a.counts.push(count); a.results.push(scalar(result))
    for ty in args { a.params.push(scalar(ty)) }
    a.starts.len - 1
}
fn table_slot(a: &mut Abi, entry: i32) -> i32 {
    for i in 0..a.table.len { if a.table[i] == entry { return i + 1 } }
    a.table.push(entry); a.table.len
}
pub fn host(a: &mut Abi, library: string, name: string, sig: i32) -> i32 {
    for i in 0..a.import_sigs.len {
        if a.import_modules[i] == library && a.import_names[i] == name && a.import_sigs[i] == sig { return table_slot(&mut a, i) }
    }
    id := a.import_sigs.len; a.import_modules.push(library); a.import_names.push(name); a.import_sigs.push(sig)
    table_slot(&mut a, id)
}
pub fn callback(a: &mut Abi, label: i32, sig: i32) -> i32 {
    for i in 0..a.callback_labels.len { if a.callback_labels[i] == label { return table_slot(&mut a, -1 - i) } }
    id := a.callback_labels.len; a.callback_labels.push(label); a.callback_sigs.push(sig); table_slot(&mut a, -1 - id)
}
pub fn types(out: &mut []u8, a: &Abi) {
    for s in 0..a.starts.len {
        w.op(&mut out, 96); w.uleb(&mut out, a.counts[s])
        for i in a.starts[s]..a.starts[s] + a.counts[s] { w.op(&mut out, value_type(a.params[i])) }
        if a.results[s] == 0 { w.op(&mut out, 0) }
        else { w.op(&mut out, 1); w.op(&mut out, value_type(a.results[s])) }
    }
}
pub fn imports(out: &mut []u8, a: &Abi) {
    for i in 0..a.import_sigs.len {
        w.name(&mut out, a.import_modules[i]); w.name(&mut out, a.import_names[i]); w.op(&mut out, 0); w.uleb(&mut out, 2 + a.import_sigs[i])
    }
}
pub fn entries(out: &mut []u8, a: &Abi, first_callback: i32) {
    for id in a.table { if id >= 0 { w.uleb(&mut out, id) } else { w.uleb(&mut out, first_callback - 1 - id) } }
}
// All general registers contain 64-bit bit patterns. Only the host boundary
// converts them to/from the actual WebAssembly numeric value type.
fn to_host(out: &mut []u8, ty: i32) {
    if ty == 6 { w.op(&mut out, 167); w.op(&mut out, 190) }
    else if ty == 7 { w.op(&mut out, 191) }
    else if value_type(ty) == 127 { w.op(&mut out, 167) }
}
fn from_host(out: &mut []u8, ty: i32) {
    if ty == 6 { w.op(&mut out, 188); w.op(&mut out, 173) }
    else if ty == 7 { w.op(&mut out, 189) }
    else if value_type(ty) == 127 {
        if ty == 1 { w.op(&mut out, 172) } else { w.op(&mut out, 173) }
        if ty == 8 { w.constant(&mut out, 255); w.op(&mut out, 131) }
        if ty == 9 { w.constant(&mut out, 65535); w.op(&mut out, 131) }
    }
}
pub fn dispatch(out: &mut []u8, a: &Abi, sig: i32) {
    for i in 0..a.counts[sig] {
        if i < 8 { w.read(&mut out, i) }
        else {
            w.base(&mut out, 31); w.op(&mut out, 167); w.op(&mut out, 41); w.op(&mut out, 3); w.uleb(&mut out, (i - 8) * 16)
        }
        to_host(&mut out, a.params[a.starts[sig] + i])
    }
    w.read(&mut out, 16); w.op(&mut out, 167); w.indexed(&mut out, 17, 2 + sig); w.op(&mut out, 0)
    if a.results[sig] != 0 { from_host(&mut out, a.results[sig]); w.write(&mut out, 0) }
}
fn saved(reg: i32) -> bool { reg < 19 || reg > 21 }
pub fn callbacks(out: &mut []u8, a: &Abi, labels: &[]i32) {
    var body: []u8 = []
    for i in 0..a.callback_labels.len {
        body.clear(); sig := a.callback_sigs[i]; argc := a.counts[sig]; ret := a.results[sig]
        w.op(&mut body, 1); w.op(&mut body, 1); w.op(&mut body, 126)
        // Operand-stack values survive the Dunder invocation, including nested
        // callbacks. Its heap registers keep allocations performed by the callee.
        for reg in 0..68 { if saved(reg) { w.indexed(&mut body, 35, reg) } }
        if argc > 8 {
            w.base(&mut body, 31); w.constant(&mut body, i64(argc - 8) * 16); w.op(&mut body, 125); w.set_base(&mut body, 31)
        }
        for p in 0..argc {
            if p >= 8 { w.base(&mut body, 31); w.op(&mut body, 167) }
            w.indexed(&mut body, 32, p); from_host(&mut body, a.params[a.starts[sig] + p])
            if p < 8 { w.write(&mut body, p) }
            else { w.op(&mut body, 55); w.op(&mut body, 3); w.uleb(&mut body, (p - 8) * 16) }
        }
        w.indexed(&mut body, 16, labels[a.callback_labels[i]])
        if ret != 0 { w.read(&mut body, 0); w.indexed(&mut body, 33, argc) }
        var reg := 67
        while reg >= 0 { if saved(reg) { w.indexed(&mut body, 36, reg) }; reg = reg - 1 }
        if ret != 0 { w.indexed(&mut body, 32, argc); to_host(&mut body, ret) }
        w.op(&mut body, 11); w.blob(&mut out, &body)
    }
}
