// Binary encoding shared by the self-hosted Wasm lowering. Registers and flags
// use i64 globals. Regular operands treat register 31 as zero, base operands
// treat it as the stack pointer.
import std.bytes as bytes

pub fn op(out:&mut []u8, byte:i32) { out.push(u8(byte)) }
pub fn uleb(out:&mut []u8, value:i32) {
    var n:=value
    while n>=128 {out.push(u8(n%128+128));n=n/128}
    out.push(u8(n))
}
fn sleb(out:&mut []u8,value:i64) {
    var n:=value
    while true {
        low:=i32(n.bit_and(127));var next:=n/128
        if n<0 && low!=0 {next=next-1}
        if (next==0 && low<64) || (next == -1 && low>=64) {op(&mut out,low);return}
        op(&mut out,low+128);n=next
    }
}
pub fn indexed(out:&mut []u8,opcode:i32,index:i32) {op(&mut out,opcode);uleb(&mut out,index)}
pub fn constant(out:&mut []u8,value:i64) {op(&mut out,66);sleb(&mut out,value)}
pub fn i32_const(out:&mut []u8,value:i32) {op(&mut out,65);sleb(&mut out,i64(value))}
pub fn bits(word:i64,shift:i32,mask:i64)->i32 {i32(word.shr(shift).bit_and(mask))}
pub fn read(out:&mut []u8,reg:i32) {if reg==31 {constant(&mut out,0)}else{indexed(&mut out,35,reg)}}
pub fn write(out:&mut []u8,reg:i32) {if reg==31 {op(&mut out,26)}else{indexed(&mut out,36,reg)}}
pub fn base(out:&mut []u8,reg:i32) {indexed(&mut out,35,reg)}
pub fn set_base(out:&mut []u8,reg:i32) {
    indexed(&mut out,36,reg)
    if reg==31 {
        base(&mut out,31);base(&mut out,69);op(&mut out,84)
        base(&mut out,31);base(&mut out,68);op(&mut out,86);op(&mut out,114)
        op(&mut out,4);op(&mut out,64);op(&mut out,0);op(&mut out,11)
    }
}
pub fn append(out:&mut []u8,input:&[]u8) {for i in 0..input.len {out.push(input[i])}}
pub fn name(out:&mut []u8,value:string) {uleb(&mut out,value.len);bytes.append_utf8(&mut out,value)}
pub fn blob(out:&mut []u8,value:&[]u8) {uleb(&mut out,value.len);append(&mut out,&value)}
pub fn section(out:&mut []u8,id:i32,value:&[]u8) {op(&mut out,id);blob(&mut out,&value)}
