import lexer
import cache_io
// Shared module loading, target selection, diagnostics and atomic publication.
import bundle
import agent
import cli
import compile as compiler
import modules
import process
import receipts
import elf
import macho
import timings
import sys

fn inline_counts(options: &cli.Options, records: &compiler.Bindings) -> timings.Inlining {
    var data := timings.inlining()
    data.enabled = options.inline_opt && options.scalar_opt && !options.checking
    data.entries = records.inline_entries; data.nodes = records.inline_nodes
    data.tokens = records.inline_tokens; data.units = records.inline_units
    data.calls = records.inlined_calls; data.words = records.inlined_words
    data.estimated_words = records.inline_estimated_words
    data
}

fn backend_counts(options: &cli.Options, records: &compiler.Bindings) -> timings.Backend {
    var data := timings.backend(); data.enabled = options.mir_opt && !options.checking
    data.functions = records.mir_functions; data.operations = records.mir_operations; data.opaque = records.mir_opaque
    data.optimization_enabled = records.mir_optimization_enabled; data.optimized = records.mir_optimized; data.promoted = records.mir_promoted
    data.source_objects_enabled = records.mir_source_objects_enabled; data.private_memory_ops = records.mir_private_memory_ops
    data.removed_loads = records.mir_removed_loads; data.removed_stores = records.mir_removed_stores
    data.analysis_units = records.mir_analysis_units; data.budget_refusals = records.mir_budget_refusals
    data.ssa_enabled = records.mir_ssa_enabled
    data.ssa_optimized = records.mir_ssa_optimized
    data.ssa_cells = records.mir_ssa_cells
    data.ssa_values = records.mir_ssa_values
    data.ssa_parameters = records.mir_ssa_parameters
    data.ssa_registers = records.mir_ssa_registers
    data.ssa_removed_loads = records.mir_ssa_removed_loads
    data.ssa_removed_stores = records.mir_ssa_removed_stores
    data.ssa_removed_pushes = records.mir_ssa_removed_pushes
    data.ssa_removed_pops = records.mir_ssa_removed_pops
    data.ssa_copies = records.mir_ssa_copies
    data.ssa_analysis_units = records.mir_ssa_analysis_units
    data.ssa_budget_refusals = records.mir_ssa_budget_refusals
    data.values_enabled = records.mir_values_enabled; data.values_optimized = records.mir_values_optimized
    data.value_rewrites = records.mir_value_rewrites; data.value_deleted = records.mir_value_deleted; data.value_immediates = records.mir_value_immediates
    data.value_analysis_units = records.mir_value_analysis_units; data.value_budget_refusals = records.mir_value_budget_refusals; data
}

fn report(path: string, source: string, offset: i32, message: string) {
    var line := 1
    var column := 1
    for i in 0..offset {
        if i >= source.len { break }
        byte := source[i]
        if byte == 10 { line = line + 1; column = 1 }
        else if byte < 128 || byte >= 192 { column = column + 1 }
    }
    diagnostic := sys.eprint(path + ":" + line.str() + ":" + column.str() + ": error[E1000]: " + message)
}

fn failure(message: string) -> i32 {
    diagnostic := sys.eprint(message)
    1
}

pub fn build(default_target: i32) -> i32 {
    build_using(default_target, 1, false, compiler.compile_options)
}
// The serial seed entry depends only on ordinary Dunder. A Task-based entry
// supplies its compiler callback without becoming a dependency of this module.
pub fn build_using(default_target: i32, default_workers: i32, supports_workers: bool,
    compile_fn: fn(&mut lexer.Tokens,i32,&[]i32,&[]i32,bool,bool,&mut compiler.Bindings,string,string,&compiler.Configuration)->compiler.Result) -> i32 {
    if sys.arg_count() == 1 || sys.arg(1) == "--help" || sys.arg(1) == "-h" {
        print("dunder build [input.ddr] [-o output] [--target target] [--app] [--incremental] [--timings[=json]] [--scalar-opt=off] [--ownership-opt=off] [--const-div-opt=off] [--frame-free=off] [--range-opt=off] [--mir=off] [--mir-opt=off] [--mir-memory=off] [--mir-ssa=on|off] [--mir-values=off] [--inline-opt=off] [--profile-compiler] [--runtime-profile]")
        print("dunder run [input.ddr] [-o output] [--app] [-- program-args...]")
        print("dunder test [input.ddr] [-o directory] [--affected] [--timeout-ms N]")
        print("dunder check [input.ddr] [--agent] [--target target] [--timings[=json]] [--profile-compiler]")
        print("dunder build-tests [input.ddr] [--list | --group ID] [--target target]")
        print("dunder --list-targets")
        print("--jobs N | --jobs=N: compiler workers from 1 to 256 (default " + default_workers.str() + ")")
        if !supports_workers { print("this compiler entry supports only --jobs 1") }
        return 0
    }
    if sys.arg_count() == 2 && sys.arg(1) == "--list-targets" {
        for id in 0..4 { print(cli.target_name(id)) }
        return 0
    }
    options := cli.options_with_workers(default_target, default_workers)
    if options.error != "" {
        diagnostic := sys.eprint(options.error)
        return 2
    }
    if !supports_workers && options.workers > 1 {
        diagnostic := sys.eprint("this compiler entry supports only --jobs 1")
        return 2
    }
    platform := options.platform
    if options.runtime_profile && platform == 3 { return failure("runtime profiling requires a native target") }
    var profile_host := -1
    if options.profile_compiler { profile_host = default_target }
    if (options.run || options.run_tests) && (platform != default_target || platform == 3) {
        return failure("selected target cannot run on this host")
    }
    var output := options.output
    if options.run_tests { output = output + "/suite-" + sys.pid().str() }
    var started: i64 = 0
    if options.timings { started = process.monotonic_nanoseconds(default_target) }
    var tokens := lexer.empty(false)
    loaded := modules.load_group(options.input, options.tests, !options.tests, options.group, platform == 3, &mut tokens)
    if !loaded.ok {
        if options.agent { agent.error(loaded.path, loaded.source, loaded.offset, loaded.error) }
        else { report(loaded.path, loaded.source, loaded.offset, loaded.error) }
        return 1
    }
    if options.list_groups {
        for i in 0..loaded.groups.len { print(i.str() + " " + loaded.groups[i]) }
        return 0
    }
    if options.tests { tokens = lexer.scan(loaded.source, false) }
    var load_finished: i64 = 0
    if options.timings { load_finished = process.monotonic_nanoseconds(default_target) }
    var config := compiler.configuration()
    config.workers = options.workers
    config.scalar_enabled = options.scalar_opt; config.ownership_enabled = options.ownership_opt
    config.const_div_enabled = options.const_div_opt; config.frame_free_enabled = options.frame_free; config.range_enabled = options.range_opt; config.inline_enabled = options.inline_opt; config.mir_enabled = options.mir_opt; config.mir_opt_enabled = options.mir_pass
    config.mir_memory_enabled = options.mir_memory; config.mir_ssa_enabled = options.mir_ssa; config.mir_values_enabled = options.mir_values
    config.profile_host = profile_host; config.instrument_runtime = options.runtime_profile
    if options.checking {
        var records := compiler.bindings()
        var check_setup: i64 = 0
        if options.timings { check_setup = process.monotonic_nanoseconds(default_target) }
        checked := compile_fn(&mut tokens, platform, &loaded.map_starts, &loaded.map_files, true, options.agent, &mut records, "", "", &config)
        if !checked.ok {
            location := modules.location(&loaded, checked.offset)
            if options.agent { agent.error(location.path, location.source, location.offset, checked.error) }
            else { report(location.path, location.source, location.offset, checked.error) }
            return 1
        }
        if options.timings {
            finished := process.monotonic_nanoseconds(default_target)
            inline_data := inline_counts(&options, &records)
            backend_data := backend_counts(&options, &records)
            timings.report_profiled_backend(options.timings_json, true, platform, loaded.paths.len, records.reused, records.emitted,
                started, load_finished, check_setup, finished, finished, finished,
                options.scalar_opt, records.modeled, records.optimized, records.rewrites, records.proven_bounds, records.fallbacks, &records.profile, &inline_data, &backend_data)
        }
        if options.agent { agent.success(&loaded, &records) }
        else { print("checked " + options.input + " (" + loaded.paths.len.str() + " modules)") }
        return 0
    }
    for path in loaded.paths {
        if path.len > 0 && path[0] != 60 {
            if path == output || sys.same_file(path, output) { return failure("output must not overwrite source") }
        }
    }
    var ignored := compiler.bindings()
    var cache := ""; var identity := ""
    if options.incremental && platform != 3 {
        root := cache_io.root(options.input)
        if root != "" {
            cache = "build/.dunder-cache/selfhost/" + cache_io.digest(root + ":" + platform.str())
            if options.scalar_opt { cache = cache + "/scalar-on" } else { cache = cache + "/scalar-off" }
            if options.ownership_opt { cache = cache + "/ownership-on" } else { cache = cache + "/ownership-off" }
            if options.const_div_opt { cache = cache + "/const-div-on" } else { cache = cache + "/const-div-off" }
            if options.frame_free { cache = cache + "/frame-free" } else { cache = cache + "/frame-plain" }
            if options.range_opt { cache = cache + "/range-on" } else { cache = cache + "/range-off" }
            if options.inline_opt { cache = cache + "/inline-on" } else { cache = cache + "/inline-off" }
            if options.mir_opt { cache = cache + "/mir-physical-v4-call-flags1-promotion4-terminal1-sourceabi1-entry-load-work4194304" } else { cache = cache + "/mir-off" }
            if options.mir_pass { cache = cache + "/mir-opt-on" } else { cache = cache + "/mir-opt-off" }
            if options.mir_memory { cache = cache + "/mir-memory-source" } else { cache = cache + "/mir-memory-raw" }
            if options.mir_ssa { cache = cache + "/mir-ssa-v2-pruned-inputs1-work4194304" } else { cache = cache + "/mir-ssa-off" }
            if options.mir_values { cache = cache + "/mir-values-v4-certified-compact-terminal1" } else { cache = cache + "/mir-values-off" }
            if options.runtime_profile { cache = cache + "/runtime-profile" } else { cache = cache + "/runtime-plain" }
            identity = cache_io.compiler(default_target)
        }
    }
    var setup_finished: i64 = 0
    if options.timings { setup_finished = process.monotonic_nanoseconds(default_target) }
    result := compile_fn(&mut tokens, platform, &loaded.map_starts, &loaded.map_files, false, false, &mut ignored, cache, identity, &config)
    if !result.ok {
        location := modules.location(&loaded, result.offset)
        report(location.path, location.source, location.offset, result.error)
        return 1
    }
    var compile_finished: i64 = 0
    if options.timings { compile_finished = process.monotonic_nanoseconds(default_target) }
    var image: []u8 = []
    if platform == 3 { image = result.text }
    else if result.imports.symbols.len > 0 || result.imports.globals > 0 {
        if platform == 0 { image = macho.dynamic_storage(&result.text, &result.imports.libraries, &result.imports.symbols, &result.imports.sites, &result.imports.slots, result.imports.globals) }
        else if platform == 2 { image = elf.dynamic_storage(&result.text, &result.imports.libraries, &result.imports.symbols, &result.imports.sites, &result.imports.slots, 62, result.imports.globals) }
        else { image = elf.dynamic_storage(&result.text, &result.imports.libraries, &result.imports.symbols, &result.imports.sites, &result.imports.slots, 183, result.imports.globals) }
    }
    else if platform == 2 { image = elf.image_for(&result.text, 62) }
    else if platform == 1 { image = elf.image(&result.text) }
    else { image = macho.image(&result.text) }
    var image_finished: i64 = 0
    if options.timings { image_finished = process.monotonic_nanoseconds(default_target) }
    if options.app {
        error := bundle.publish(output, &mut image, &loaded.paths)
        if error != "" { return failure(error) }
        if options.timings {
            finished := process.monotonic_nanoseconds(default_target)
            inline_data := inline_counts(&options, &ignored)
        backend_data := backend_counts(&options, &ignored)
            timings.report_profiled_backend(options.timings_json, false, platform, loaded.paths.len, ignored.reused, ignored.emitted,
                started, load_finished, setup_finished, compile_finished, image_finished, finished,
                options.scalar_opt, ignored.modeled, ignored.optimized, ignored.rewrites, ignored.proven_bounds, ignored.fallbacks, &ignored.profile, &inline_data, &backend_data)
        }
        if options.run { return process.run(output + "/Contents/MacOS/" + bundle.executable_name(bundle.name(output)), &options.args, 0, default_target) }
        print("built " + output)
        return 0
    }
    if !cli.prepare_parent(output) { return failure("cannot create output directory") }
    temporary := output + ".dunder-" + sys.pid().str() + ".tmp"
    if sys.metadata(temporary).ok { return failure("temporary output already exists") }
    written := sys.write_u8(temporary, &image)
    if !written.ok { removed := sys.remove_file(temporary); return failure(sys.error_message(written.error)) }
    if platform != 3 {
        executable := sys.make_executable(temporary)
        if !executable.ok { removed := sys.remove_file(temporary); return failure(sys.error_message(executable.error)) }
    }
    published := sys.rename(temporary, output)
    if !published.ok { removed := sys.remove_file(temporary); return failure(sys.error_message(published.error)) }
    if options.timings {
        finished := process.monotonic_nanoseconds(default_target)
        inline_data := inline_counts(&options, &ignored)
            backend_data := backend_counts(&options, &ignored)
        timings.report_profiled_backend(options.timings_json, false, platform, loaded.paths.len, ignored.reused, ignored.emitted,
            started, load_finished, setup_finished, compile_finished, image_finished, finished,
            options.scalar_opt, ignored.modeled, ignored.optimized, ignored.rewrites, ignored.proven_bounds, ignored.fallbacks, &ignored.profile, &inline_data, &backend_data)
    }
    if options.run { return process.run(output, &options.args, 0, default_target) }
    if options.run_tests {
        var keys: []string = []
        if options.affected || sys.metadata(options.output + "/.affected").is_dir {
            var policy := receipts.policy()
            policy.scalar_enabled = options.scalar_opt; policy.ownership_enabled = options.ownership_opt; policy.runtime_profile = options.runtime_profile
            policy.const_div_enabled = options.const_div_opt; policy.frame_free_enabled = options.frame_free; policy.range_enabled = options.range_opt; policy.inline_enabled = options.inline_opt; policy.mir_enabled = options.mir_opt; policy.mir_opt_enabled = options.mir_pass
            policy.mir_memory_enabled = options.mir_memory; policy.mir_ssa_enabled = options.mir_ssa; policy.mir_values_enabled = options.mir_values
            keys = receipts.keys_configured(&loaded, options.output, platform, options.timeout_ms, &policy)
        }
        result_code := process.tests(output, &loaded.groups, &keys, options.affected, options.timeout_ms, default_target)
        removed := sys.remove_file(output)
        return result_code
    }
    print("built " + output)
    0
}
