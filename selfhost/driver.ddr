import lexer
import cache_io
// Shared module loading, target selection, diagnostics and atomic publication.
import bundle
import agent
import cli
import compile as compiler
import modules
import process
import receipts
import elf
import macho
import timings
import sys

fn report(path: string, source: string, offset: i32, message: string) {
    var line := 1
    var column := 1
    for i in 0..offset {
        if i >= source.len { break }
        byte := source[i]
        if byte == 10 { line = line + 1; column = 1 }
        else if byte < 128 || byte >= 192 { column = column + 1 }
    }
    diagnostic := sys.eprint(path + ":" + line.str() + ":" + column.str() + ": error[E1000]: " + message)
}

fn failure(message: string) -> i32 {
    diagnostic := sys.eprint(message)
    1
}

pub fn build(default_target: i32) -> i32 {
    if sys.arg_count() == 1 || sys.arg(1) == "--help" || sys.arg(1) == "-h" {
        print("dunder build [input.ddr] [-o output] [--target target] [--app] [--incremental] [--timings[=json]] [--scalar-opt=off] [--ownership-opt=off] [--const-div-opt=off] [--profile-compiler] [--runtime-profile]")
        print("dunder run [input.ddr] [-o output] [--app] [-- program-args...]")
        print("dunder test [input.ddr] [-o directory] [--affected] [--timeout-ms N]")
        print("dunder check [input.ddr] [--agent] [--target target] [--timings[=json]] [--profile-compiler]")
        print("dunder build-tests [input.ddr] [--list | --group ID] [--target target]")
        print("dunder --list-targets")
        return 0
    }
    if sys.arg_count() == 2 && sys.arg(1) == "--list-targets" {
        for id in 0..4 { print(cli.target_name(id)) }
        return 0
    }
    options := cli.options(default_target)
    if options.error != "" {
        diagnostic := sys.eprint(options.error)
        return 2
    }
    platform := options.platform
    if options.runtime_profile && platform == 3 { return failure("runtime profiling requires a native target") }
    var profile_host := -1
    if options.profile_compiler { profile_host = default_target }
    if (options.run || options.run_tests) && (platform != default_target || platform == 3) {
        return failure("selected target cannot run on this host")
    }
    var output := options.output
    if options.run_tests { output = output + "/suite-" + sys.pid().str() }
    var started: i64 = 0
    if options.timings { started = process.monotonic_nanoseconds(default_target) }
    var tokens := lexer.empty(false)
    loaded := modules.load_group(options.input, options.tests, !options.tests, options.group, platform == 3, &mut tokens)
    if !loaded.ok {
        if options.agent { agent.error(loaded.path, loaded.source, loaded.offset, loaded.error) }
        else { report(loaded.path, loaded.source, loaded.offset, loaded.error) }
        return 1
    }
    if options.list_groups {
        for i in 0..loaded.groups.len { print(i.str() + " " + loaded.groups[i]) }
        return 0
    }
    if options.tests { tokens = lexer.scan(loaded.source, false) }
    var load_finished: i64 = 0
    if options.timings { load_finished = process.monotonic_nanoseconds(default_target) }
    var config := compiler.configuration()
    config.scalar_enabled = options.scalar_opt; config.ownership_enabled = options.ownership_opt
    config.const_div_enabled = options.const_div_opt
    config.profile_host = profile_host; config.instrument_runtime = options.runtime_profile
    if options.checking {
        var records := compiler.bindings()
        var check_setup: i64 = 0
        if options.timings { check_setup = process.monotonic_nanoseconds(default_target) }
        checked := compiler.compile_options(&mut tokens, platform, &loaded.map_starts, &loaded.map_files, true, options.agent, &mut records, "", "", &config)
        if !checked.ok {
            location := modules.location(&loaded, checked.offset)
            if options.agent { agent.error(location.path, location.source, location.offset, checked.error) }
            else { report(location.path, location.source, location.offset, checked.error) }
            return 1
        }
        if options.timings {
            finished := process.monotonic_nanoseconds(default_target)
            timings.report_profiled(options.timings_json, true, platform, loaded.paths.len, records.reused, records.emitted,
                started, load_finished, check_setup, finished, finished, finished,
                options.scalar_opt, records.modeled, records.optimized, records.rewrites, records.proven_bounds, records.fallbacks, &records.profile)
        }
        if options.agent { agent.success(&loaded, &records) }
        else { print("checked " + options.input + " (" + loaded.paths.len.str() + " modules)") }
        return 0
    }
    for path in loaded.paths {
        if path.len > 0 && path[0] != 60 {
            if path == output || sys.same_file(path, output) { return failure("output must not overwrite source") }
        }
    }
    var ignored := compiler.bindings()
    var cache := ""; var identity := ""
    if options.incremental && platform != 3 {
        root := cache_io.root(options.input)
        if root != "" {
            cache = "build/.dunder-cache/selfhost/" + cache_io.digest(root + ":" + platform.str())
            if options.scalar_opt { cache = cache + "/scalar-on" } else { cache = cache + "/scalar-off" }
            if options.ownership_opt { cache = cache + "/ownership-on" } else { cache = cache + "/ownership-off" }
            if options.const_div_opt { cache = cache + "/const-div-on" } else { cache = cache + "/const-div-off" }
            if options.runtime_profile { cache = cache + "/runtime-profile" } else { cache = cache + "/runtime-plain" }
            identity = cache_io.compiler(default_target)
        }
    }
    var setup_finished: i64 = 0
    if options.timings { setup_finished = process.monotonic_nanoseconds(default_target) }
    result := compiler.compile_options(&mut tokens, platform, &loaded.map_starts, &loaded.map_files, false, false, &mut ignored, cache, identity, &config)
    if !result.ok {
        location := modules.location(&loaded, result.offset)
        report(location.path, location.source, location.offset, result.error)
        return 1
    }
    var compile_finished: i64 = 0
    if options.timings { compile_finished = process.monotonic_nanoseconds(default_target) }
    var image: []u8 = []
    if platform == 3 { image = result.text }
    else if result.imports.symbols.len > 0 || result.imports.globals > 0 {
        if platform == 0 { image = macho.dynamic_storage(&result.text, &result.imports.libraries, &result.imports.symbols, &result.imports.sites, &result.imports.slots, result.imports.globals) }
        else if platform == 2 { image = elf.dynamic_storage(&result.text, &result.imports.libraries, &result.imports.symbols, &result.imports.sites, &result.imports.slots, 62, result.imports.globals) }
        else { image = elf.dynamic_storage(&result.text, &result.imports.libraries, &result.imports.symbols, &result.imports.sites, &result.imports.slots, 183, result.imports.globals) }
    }
    else if platform == 2 { image = elf.image_for(&result.text, 62) }
    else if platform == 1 { image = elf.image(&result.text) }
    else { image = macho.image(&result.text) }
    var image_finished: i64 = 0
    if options.timings { image_finished = process.monotonic_nanoseconds(default_target) }
    if options.app {
        error := bundle.publish(output, &mut image, &loaded.paths)
        if error != "" { return failure(error) }
        if options.timings {
            finished := process.monotonic_nanoseconds(default_target)
            timings.report_profiled(options.timings_json, false, platform, loaded.paths.len, ignored.reused, ignored.emitted,
                started, load_finished, setup_finished, compile_finished, image_finished, finished,
                options.scalar_opt, ignored.modeled, ignored.optimized, ignored.rewrites, ignored.proven_bounds, ignored.fallbacks, &ignored.profile)
        }
        if options.run { return process.run(output + "/Contents/MacOS/" + bundle.executable_name(bundle.name(output)), &options.args, 0, default_target) }
        print("built " + output)
        return 0
    }
    if !cli.prepare_parent(output) { return failure("cannot create output directory") }
    temporary := output + ".dunder-" + sys.pid().str() + ".tmp"
    if sys.metadata(temporary).ok { return failure("temporary output already exists") }
    written := sys.write_u8(temporary, &image)
    if !written.ok { removed := sys.remove_file(temporary); return failure(sys.error_message(written.error)) }
    if platform != 3 {
        executable := sys.make_executable(temporary)
        if !executable.ok { removed := sys.remove_file(temporary); return failure(sys.error_message(executable.error)) }
    }
    published := sys.rename(temporary, output)
    if !published.ok { removed := sys.remove_file(temporary); return failure(sys.error_message(published.error)) }
    if options.timings {
        finished := process.monotonic_nanoseconds(default_target)
        timings.report_profiled(options.timings_json, false, platform, loaded.paths.len, ignored.reused, ignored.emitted,
            started, load_finished, setup_finished, compile_finished, image_finished, finished,
            options.scalar_opt, ignored.modeled, ignored.optimized, ignored.rewrites, ignored.proven_bounds, ignored.fallbacks, &ignored.profile)
    }
    if options.run { return process.run(output, &options.args, 0, default_target) }
    if options.run_tests {
        var keys: []string = []
        if options.affected || sys.metadata(options.output + "/.affected").is_dir {
            var policy := receipts.policy()
            policy.scalar_enabled = options.scalar_opt; policy.ownership_enabled = options.ownership_opt; policy.runtime_profile = options.runtime_profile
            policy.const_div_enabled = options.const_div_opt
            keys = receipts.keys_configured(&loaded, options.output, platform, options.timeout_ms, &policy)
        }
        result_code := process.tests(output, &loaded.groups, &keys, options.affected, options.timeout_ms, default_target)
        removed := sys.remove_file(output)
        return result_code
    }
    print("built " + output)
    0
}
