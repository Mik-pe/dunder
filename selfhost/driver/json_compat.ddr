import std.json as json
import std.bytes as bytes
import std.parse as parse

pub struct CompatStr { ok: bool, value: string }
pub struct CompatI64 { ok: bool, value: i64 }
pub struct CompatF64 { ok: bool, value: f64 }

fn hex_val(b: u8) -> i32 {
    if b >= b'0' && b <= b'9' { return i32(b - b'0') }
    if b >= b'a' && b <= b'f' { return i32(b - b'a') + 10 }
    if b >= b'A' && b <= b'F' { return i32(b - b'A') + 10 }
    -1
}

fn push_codepoint_utf8(out: &mut []u8, cp: i32) {
    if cp <= 0x7F {
        out.push(u8(cp))
    } else if cp <= 0x7FF {
        out.push(u8(0xC0.bit_or(cp.shr(6))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    } else if cp <= 0xFFFF {
        out.push(u8(0xE0.bit_or(cp.shr(12))))
        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    } else {
        out.push(u8(0xF0.bit_or(cp.shr(18))))
        out.push(u8(0x80.bit_or(cp.shr(12).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    }
}

fn unescape_span(input: &[]u8, start: i32, end: i32, has_esc: bool) -> CompatStr {
    if !has_esc {
        dec := bytes.decode_range(&input, start, end)
        return CompatStr { ok: dec.ok, value: dec.value }
    }
    mut out: []u8 = []
    out.reserve(end - start)
    mut i := start
    while i < end {
        b := input[i]
        if b != b'\\' {
            out.push(b)
            i += 1
            continue
        }
        i += 1
        esc := input[i]
        if esc == b'"' { out.push(b'"'); i += 1 }
        else if esc == b'\\' { out.push(b'\\'); i += 1 }
        else if esc == b'/' { out.push(b'/'); i += 1 }
        else if esc == b'b' { out.push(8); i += 1 }
        else if esc == b'f' { out.push(12); i += 1 }
        else if esc == b'n' { out.push(10); i += 1 }
        else if esc == b'r' { out.push(13); i += 1 }
        else if esc == b't' { out.push(9); i += 1 }
        else if esc == b'u' {
            mut cp := 0
            for k in 1..5 { cp = cp * 16 + hex_val(input[i + k]) }
            i += 5
            if cp >= 0xD800 && cp <= 0xDBFF {
                mut low := 0
                for k in 2..6 { low = low * 16 + hex_val(input[i + k]) }
                i += 6
                cp = 0x10000 + (cp - 0xD800).shl(10) + (low - 0xDC00)
            }
            push_codepoint_utf8(&mut out, cp)
        } else {
            return CompatStr { ok: false, value: "" }
        }
    }
    dec := bytes.decode(&out)
    CompatStr { ok: dec.ok, value: dec.value }
}

pub fn key_at(doc: &json.Doc, obj: i32, index: i32) -> CompatStr {
    if doc.kind(obj) != .Object || index < 0 || index >= doc.count(obj) {
        return CompatStr { ok: false, value: "" }
    }
    mut cur := doc.first_child[obj]
    for _ in 0..index { cur = doc.next_sibling[cur] }
    unescape_span(&doc.input, doc.key_starts[cur], doc.key_ends[cur], doc.key_escaped[cur])
}

pub fn as_str(doc: &json.Doc, node: i32) -> CompatStr {
    if doc.kind(node) != .String { return CompatStr { ok: false, value: "" } }
    unescape_span(&doc.input, doc.starts[node], doc.ends[node], doc.escaped[node])
}

pub fn get_str(doc: &json.Doc, obj: i32, key: string) -> CompatStr {
    as_str(&doc, doc.field(obj, key))
}

pub fn as_i64(doc: &json.Doc, node: i32) -> CompatI64 {
    if doc.kind(node) != .Number { return CompatI64 { ok: false, value: 0 } }
    span := doc.raw_span(node)
    parsed := parse.i64_range(span, 0, span.len)
    CompatI64 { ok: parsed.ok, value: parsed.value }
}

pub fn get_i64(doc: &json.Doc, obj: i32, key: string) -> CompatI64 {
    as_i64(&doc, doc.field(obj, key))
}

pub fn as_f64(doc: &json.Doc, node: i32) -> CompatF64 {
    if doc.kind(node) != .Number { return CompatF64 { ok: false, value: 0.0 } }
    parsed := parse.Float64::parse(doc.raw_span(node))
    CompatF64 { ok: parsed.ok, value: parsed.value }
}

pub fn writer_finish(w: &json.Writer) -> CompatStr {
    if w.failed || w.output.len == 0 { return CompatStr { ok: false, value: "" } }
    CompatStr { ok: true, value: json.finish_text(&w.output) }
}
