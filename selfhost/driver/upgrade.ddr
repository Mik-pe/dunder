capability filesystem, unsafe
import cache_io
import cli
import stderr
import process
import std.text as text
import sys

@extern("c","mkdtemp") unsafe fn make_temp_dir(template: ptr) -> ptr

struct Manifest { ok: bool, error: string, version: string, gz_sha: string, bin_sha: string }

fn fail(message: string) -> i32 {
    _ := stderr.eprint(message)
    1
}

fn temporary_dir(parent: string) -> string {
    if target_is("windows") {
        for sequence in 0..100 {
            path := parent + "/.dunder-upgrade-" + sys.pid().str() + "-" + sequence.str()
            created := sys.mkdir(path)
            if created.ok { return path }
            if created.error != 17 { return "" }
        }
    } else {
        mut template: []u8 = []
        name := parent + "/.dunder-upgrade-XXXXXX"
        for byte in name.bytes() { template.push(u8(byte)) }
        template.push(0)
        unsafe {
            created := make_temp_dir(addr(&mut template[0]))
            if usize(created) != 0 { return cache_io.c_string(created) }
        }
    }
    ""
}

fn parent_dir(path: string) -> string {
    mut last := -1
    for i in 0..path.len {
        if path[i] == 47 || (target_is("windows") && path[i] == 92) { last = i }
    }
    if last < 0 { return "" }
    if last == 0 { return "/" }
    path[0..last]
}

fn is_hex64(value: string) -> bool {
    if value.len != 64 { return false }
    for b in value.bytes() {
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) { return false }
    }
    true
}

fn valid_tag(tag: string) -> bool {
    if tag == "" || tag == "." || tag == ".." { return false }
    for b in tag.bytes() {
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) ||
            b == 45 || b == 46 || b == 95 || b == 43) { return false }
    }
    true
}

fn find_substr(haystack: string, needle: string) -> i32 {
    if needle.len == 0 { return 0 }
    if needle.len > haystack.len { return -1 }
    limit := haystack.len - needle.len + 1
    for i in 0..limit {
        mut ok := true
        for j in 0..needle.len {
            if haystack[i + j] != needle[j] { ok = false; break }
        }
        if ok { return i }
    }
    -1
}

fn parse_manifest(content: string, host_name: string) -> Manifest {
    mut out := Manifest { ok: false, error: "", version: "", gz_sha: "", bin_sha: "" }
    gz_key := host_name + ".gz.sha256"
    bin_key := host_name + ".sha256"
    for line in text.split(content, "\n") {
        trimmed := text.trim(line)
        if trimmed == "" || text.starts_with(trimmed, "#") { continue }
        eq := find_substr(trimmed, "=")
        if eq < 1 { continue }
        key := text.trim(trimmed[0..eq])
        value := text.trim(trimmed[eq + 1..trimmed.len])
        if key == "version" {
            if out.version != "" { out.error = "duplicate release version"; return out }
            out.version = value
        } else if key == gz_key {
            if out.gz_sha != "" { out.error = "duplicate archive checksum"; return out }
            out.gz_sha = value
        } else if key == bin_key {
            if out.bin_sha != "" { out.error = "duplicate binary checksum"; return out }
            out.bin_sha = value
        }
    }
    if !valid_tag(out.version) { out.error = "release manifest is missing a valid version"; return out }
    if host_name != "x86_64-windows" && !is_hex64(out.gz_sha) { out.error = "release manifest is missing valid " + gz_key; return out }
    if !is_hex64(out.bin_sha) { out.error = "release manifest is missing valid " + bin_key; return out }
    out.ok = true
    out
}

@test fn windows_manifest_verifies_the_raw_executable() {
    digest := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    line := "x86_64-windows.sha256=" + digest + "\n"
    manifest := "version=0.9.0\n" + line
    assert(parse_manifest(manifest, "x86_64-windows").ok)
    assert(!parse_manifest(manifest + line, "x86_64-windows").ok)
    assert(!parse_manifest("version=0.9.0\nx86_64-windows.sha256=bad", "x86_64-windows").ok)
    assert(!parse_manifest(manifest, "x86_64-linux").ok)
}

pub fn run(default_target: i32) -> i32 {
    if default_target < 0 || (default_target > 2 && default_target != 5) {
        return fail("upgrade is supported only on native host platforms")
    }
    mut check_only := false
    mut force := false
    mut tag := ""
    mut i := 2
    while i < sys.arg_count() {
        arg := sys.arg(i)
        if arg == "--check" { check_only = true }
        else if arg == "--force" { force = true }
        else if arg == "-h" || arg == "--help" {
            print("dunder upgrade [--check] [--version tag] [--force]")
            return 0
        } else if arg == "--version" || text.starts_with(arg, "--version=") {
            if tag != "" { _ := stderr.eprint("duplicate --version option"); return 2 }
            if arg == "--version" {
                i = i + 1
                if i >= sys.arg_count() { _ := stderr.eprint("--version requires a release tag"); return 2 }
                tag = sys.arg(i)
            } else {
                tag = arg[10..arg.len]
            }
            if !valid_tag(tag) { _ := stderr.eprint("invalid release tag: " + tag); return 2 }
        } else {
            _ := stderr.eprint("unknown upgrade option: " + arg)
            return 2
        }
        i = i + 1
    }

    host_name := cli.target_name(default_target)
    target_path := cache_io.self_executable(default_target)
    if target_path == "" { return fail("cannot determine dunder executable path") }
    mut release_url := cache_io.env_var("DUNDER_UPGRADE_URL")
    if release_url == "" {
        mut root := cache_io.env_var("DUNDER_RELEASES_URL")
        if root == "" { root = "https://github.com/Mik-pe/dunder/releases" }
        while root.len > 1 && text.ends_with(root, "/") { root = root[0..root.len - 1] }
        release_url = root + "/latest/download"
        if tag != "" { release_url = root + "/download/" + tag }
    }
    while release_url.len > 1 && text.ends_with(release_url, "/") { release_url = release_url[0..release_url.len - 1] }

    mut temp_parent := cache_io.env_var("TMPDIR")
    if temp_parent == "" && target_is("windows") { temp_parent = cache_io.env_var("TEMP") }
    if temp_parent == "" { temp_parent = if target_is("windows") { parent_dir(target_path) } else { "/tmp" } }
    scratch := temporary_dir(temp_parent)
    if scratch == "" { return fail("cannot create a temporary directory in " + temp_parent) }
    manifest_file := scratch + "/release.txt"
    result := check_release(default_target, host_name, target_path, tag, release_url, manifest_file, check_only, force)
    _ := sys.remove_file(manifest_file)
    _ := sys.remove_dir(scratch)
    result
}

fn fetch(url: string, output: string, timeout: i64, platform: i32) -> bool {
    args: []string = ["-q", "-gfsSL", "-o", output.clone(), "--", url.clone()]
    process.run_path("curl", &args, timeout, platform) == 0
}

fn check_release(platform: i32, host: string, target: string, tag: string, release_url: string,
    manifest_file: string, check_only: bool, force: bool) -> i32 {
    manifest_url := release_url + "/release.txt"
    if !fetch(manifest_url, manifest_file, 30000, platform) {
        return fail("failed to fetch release manifest: " + manifest_url)
    }
    content := sys.read_text(manifest_file)
    if !content.ok { return fail("cannot read release manifest") }
    manifest := parse_manifest(content.value, host)
    if !manifest.ok { return fail(manifest.error) }
    if tag != "" && tag != manifest.version && tag != "v" + manifest.version {
        return fail("release manifest version does not match requested tag " + tag)
    }
    current := cache_io.file_hash(target, platform)
    if current == "" { return fail("cannot hash the running executable at " + target) }
    if current == manifest.bin_sha && (check_only || !force) {
        if cli.compiler_version() != manifest.version {
            return fail("release manifest labels the installed binary as the wrong version")
        }
        print("dunder " + cli.compiler_version() + " (" + host + ") is already up to date (" + manifest.version + ")")
        return 0
    }
    if check_only {
        print("update available: " + cli.compiler_version() + " -> " + manifest.version + " (" + host + ")")
        return 0
    }

    stage := temporary_dir(parent_dir(target))
    if stage == "" { return fail("cannot create a staging directory beside " + target) }
    result := install(platform, target, host, release_url, stage, &manifest)
    _ := sys.remove_file(stage + "/dunder.gz")
    _ := sys.remove_file(stage + "/version.txt")
    if result != 3 {
        _ := sys.remove_file(stage + if target_is("windows") { "/dunder.exe" } else { "/dunder" })
        _ := sys.remove_dir(stage)
    }
    result
}

fn install(platform: i32, target: string, host: string, release_url: string,
    stage: string, manifest: &Manifest) -> i32 {
    candidate := stage + if target_is("windows") { "/dunder.exe" } else { "/dunder" }
    if target_is("windows") {
        url := release_url + "/" + host + ".exe"
        if !fetch(url, candidate, 120000, platform) { return fail("failed to download release executable: " + url) }
    } else {
        archive := candidate + ".gz"
        url := release_url + "/" + host + ".gz"
        if !fetch(url, archive, 120000, platform) { return fail("failed to download release archive: " + url) }
        if cache_io.file_hash(archive, platform) != manifest.gz_sha {
            return fail("SHA-256 mismatch for " + host + ".gz")
        }
        args: []string = ["-d", "--", archive]
        if process.run_path("gzip", &args, 30000, platform) != 0 {
            return fail("failed to decompress release archive")
        }
    }
    if cache_io.file_hash(candidate, platform) != manifest.bin_sha {
        return fail("SHA-256 mismatch for " + host + " executable")
    }
    if !target_is("windows") {
        executable := sys.make_executable(candidate)
        if !executable.ok { return fail(sys.error_message(executable.error)) }
    }
    probe: []string = ["--version"]
    version_file := stage + "/version.txt"
    opened := sys.write_text(version_file, "")
    if !opened.ok { return fail("cannot create version probe output") }
    if process.run_to_file(candidate, &probe, 10000, platform, version_file) != 0 {
        return fail("downloaded binary failed self-check")
    }
    version := sys.read_text(version_file)
    reported := "dunder " + manifest.version + " (" + host + ")"
    if !version.ok || (version.value != reported + "\n" && !(target_is("windows") && version.value == reported + "\r\n")) {
        return fail("downloaded binary reports the wrong version or host")
    }
    replaced := sys.rename(candidate, target)
    if !replaced.ok && target_is("windows") {
        _ := stderr.eprint("Cannot replace " + target + ": " + sys.error_message(replaced.error))
        _ := stderr.eprint("Verified replacement: " + candidate)
        _ := stderr.eprint("SHA-256: " + manifest.bin_sha)
        _ := stderr.eprint("Close Dunder and replace the installed executable with this file.")
        return 3
    }
    if !replaced.ok { return fail("failed to replace " + target + ": " + sys.error_message(replaced.error)) }
    print("upgraded " + target + " to " + manifest.version + " (" + host + ")")
    0
}
