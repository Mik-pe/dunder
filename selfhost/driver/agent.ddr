import std.bytes as bytes
import modules
import ..frontend.compile as compiler
import ..frontend.diagnostics as diag

fn quote(value: string) -> string {
    mut out: []u8 = [b'"']
    hex := "0123456789abcdef"
    for byte in value.bytes() {
        if byte == 34 || byte == 92 {
            out.push(b'\\')
            out.push(u8(byte))
        } else if byte < 32 {
            bytes.append_utf8(&mut out, "\\u00")
            out.push(u8(hex[byte / 16]))
            out.push(u8(hex[byte % 16]))
        } else {
            out.push(u8(byte))
        }
    }
    out.push(b'"')
    bytes.decode(&out).value
}

fn digit(byte: i32) -> bool { byte >= 48 && byte <= 57 }

fn identifier_start(byte: i32) -> bool {
    byte == 95 || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

pub fn public_name(ty: string, names: &[]string) -> string {
    prefix := "__dunder_module_"
    mut result: []u8 = []
    mut i := 0
    while i < ty.len {
        if ty[i] == 95 && i + prefix.len <= ty.len && ty[i..i + prefix.len] == prefix {
            mut end := i + prefix.len
            mut id := 0
            while end < ty.len && digit(ty[end]) {
                id = id * 10 + ty[end] - 48
                end += 1
            }
            if end > i + prefix.len && id < names.len {
                bytes.append_utf8(&mut result, names[id])
                i = end
                continue
            }
        }
        result.push(u8(ty[i]))
        i += 1
    }
    bytes.decode(&result).value
}

pub fn clean_debug_name(raw: string, symbols: &[]string) -> string {
    prelude := "__dunder_module_prelude_"
    if raw.len > prelude.len && raw[0..prelude.len] == prelude {
        return public_name(raw[prelude.len..raw.len], &symbols)
    }
    public_name(raw, &symbols)
}

pub fn source_for_path(loaded: &modules.Loaded, path: string) -> string {
    for i in 0..loaded.paths.len {
        if loaded.paths[i] == path && i < loaded.sources.len { return loaded.sources[i].clone() }
    }
    if path == loaded.path { return loaded.source.clone() }
    ""
}

fn resolve_raw_item(loaded: &modules.Loaded, r: &diag.RawDiagnostic) -> diag.Diagnostic {
    mut path := loaded.path.clone()
    mut src := loaded.source.clone()
    mut off := r.start
    if loaded.sources.len > 0 {
        loc := modules.location(&loaded, r.start)
        path = loc.path; src = loc.source; off = loc.offset
    }
    mut last := -1
    if r.last >= r.start && loaded.sources.len > 0 {
        end_loc := modules.location(&loaded, r.last)
        if end_loc.path == path && end_loc.offset >= off { last = end_loc.offset }
    } else if r.last >= r.start && loaded.sources.len == 0 {
        last = r.last
    }
    sp := diag.resolve_span(src, off, last)
    mut note_path := ""
    mut note_start := -1
    mut note_end := -1
    if r.note_start >= 0 && loaded.sources.len > 0 {
        nloc := modules.location(&loaded, r.note_start)
        note_path = nloc.path
        mut nlast := -1
        if r.note_last >= r.note_start {
            nend := modules.location(&loaded, r.note_last)
            if nend.path == note_path && nend.offset >= nloc.offset { nlast = nend.offset }
        }
        nsp := diag.resolve_span(nloc.source, nloc.offset, nlast)
        note_start = nsp.start
        note_end = nsp.end
    }
    code := if r.code != "" { r.code.clone() } else { diag.classify_error_code(r.message) }
    diag.Diagnostic {
        severity: r.severity,
        code: code,
        path: path,
        start: sp.start,
        end: sp.end,
        message: r.message.clone(),
        note_path: note_path,
        note_start: note_start,
        note_end: note_end,
        note_message: r.note_message.clone(),
    }
}

pub fn resolve_loader_diagnostics(loaded: &modules.Loaded) -> []diag.Diagnostic {
    mut out: []diag.Diagnostic = []
    mut saw_error := false
    for i in 0..loaded.diagnostics.len {
        d := diag.clone_diag(&loaded.diagnostics[i])
        if d.severity == .Error { saw_error = true }
        out.push(move d)
    }
    if !loaded.ok && !saw_error && loaded.error != "" {
        sp := diag.resolve_span(loaded.source, loaded.offset, -1)
        out.push(diag.Diagnostic {
            severity: .Error,
            code: diag.classify_error_code(loaded.error),
            path: loaded.path.clone(),
            start: sp.start,
            end: sp.end,
            message: loaded.error.clone(),
            note_path: "",
            note_start: -1,
            note_end: -1,
            note_message: "",
        })
    }
    diag.sort_resolved(&mut out)
    out
}

pub fn resolve_compiler_diagnostics(loaded: &modules.Loaded, raw: &[]diag.RawDiagnostic, ok: bool, fallback_offset: i32, fallback_error: string) -> []diag.Diagnostic {
    mut out: []diag.Diagnostic = []
    for i in 0..loaded.diagnostics.len { out.push(diag.clone_diag(&loaded.diagnostics[i])) }
    mut saw_error := false
    for i in 0..raw.len {
        d := resolve_raw_item(&loaded, &raw[i])
        if d.severity == .Error { saw_error = true }
        out.push(move d)
    }
    if !ok && !saw_error && fallback_error != "" {
        fb := diag.RawDiagnostic { severity: .Error, code: "", start: fallback_offset, last: -1, message: fallback_error.clone(), note_start: -1, note_last: -1, note_message: "" }
        out.push(resolve_raw_item(&loaded, &fb))
    }
    diag.sort_resolved(&mut out)
    out
}

pub fn error(path: string, source: string, start: i32, message: string) {
    sp := diag.resolve_span(source, start, -1)
    code := diag.classify_error_code(message)
    print(f'{{"kind":"error","code":{quote(code)},"path":{quote(path)},"start":{sp.start},"end":{sp.end},"message":{quote(message)}}}')
}

pub fn report_bindings(loaded: &modules.Loaded, bindings: &compiler.Bindings) {
    for i in 0..bindings.offsets.len {
        location := modules.location(&loaded, bindings.offsets[i])
        name := &bindings.names[i]
        end := location.offset + name.len
        ty := public_name(bindings.types[i], &loaded.symbols)
        print(f'{{"kind":"binding","path":{quote(location.path)},"start":{location.offset},"end":{end},"name":{quote(name)},"type":{quote(ty)}}}')
    }
}

pub fn report_diagnostic(d: &diag.Diagnostic) {
    kind := if d.severity == .Error { "error" } else { "warning" }
    mut line := f'{{"kind":{quote(kind)},"code":{quote(d.code)},"path":{quote(d.path)},"start":{d.start},"end":{d.end},"message":{quote(d.message)}'
    if d.note_message != "" {
        if d.note_path != "" && d.note_start >= 0 {
            line += f',"note_path":{quote(d.note_path)},"note_start":{d.note_start},"note_end":{d.note_end}'
        }
        line += f',"note":{quote(d.note_message)}'
    }
    line += "}"
    print(line)
}

pub fn report_result(loaded: &modules.Loaded, bindings: &compiler.Bindings, items: &[]diag.Diagnostic, ok: bool) {
    report_bindings(&loaded, &bindings)
    mut errors := 0
    mut warnings := 0
    for i in 0..items.len {
        if items[i].severity == .Error { errors += 1 } else { warnings += 1 }
        report_diagnostic(&items[i])
    }
    if ok {
        print(f'{{"kind":"ok","modules":{loaded.paths.len}}}')
    } else {
        print(f'{{"kind":"failed","modules":{loaded.paths.len},"errors":{errors},"warnings":{warnings}}}')
    }
}

pub fn success(loaded: &modules.Loaded, bindings: &compiler.Bindings) {
    report_bindings(&loaded, &bindings)
    print(f'{{"kind":"ok","modules":{loaded.paths.len}}}')
}
