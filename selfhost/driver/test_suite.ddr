import std.bytes as bytes

fn literal(output: &mut []u8, value: string) {
    output.push(34)
    for byte in value.bytes() {
        if byte == 34 || byte == 92 { output.push(92); output.push(u8(byte)) }
        else if byte == 10 { bytes.append_utf8(&mut output, "\\n") }
        else if byte == 13 { bytes.append_utf8(&mut output, "\\r") }
        else if byte == 9 { bytes.append_utf8(&mut output, "\\t") }
        else { output.push(u8(byte)) }
    }
    output.push(34)
}

pub fn entry(output: &mut []u8, groups: &[]string, calls: &[]string) {
    bytes.append_utf8(&mut output, "\nfn main() -> i32 {\nif __sys_arg_count() != 2 { return 2 }\nselected := __sys_arg(1)\n")
    bytes.append_utf8(&mut output, "if selected == \"--list\" {\n")
    for i in 0..groups.len {
        bytes.append_utf8(&mut output, "print(")
        literal(&mut output, i.str() + " " + groups[i])
        bytes.append_utf8(&mut output, ")\n")
    }
    bytes.append_utf8(&mut output, "return 0\n}\n")
    for i in 0..calls.len {
        bytes.append_utf8(&mut output, "if selected == \"" + i.str() + "\" { " + calls[i] + "(); return 0 }\n")
    }
    bytes.append_utf8(&mut output, "return 2\n}\n")
}

pub fn direct_entry(output: &mut []u8, calls: &[]string, group: i32) {
    bytes.append_utf8(&mut output, "\nfn main()->i32 {\n")
    for i in 0..calls.len {
        if group < 0 || group == i { bytes.append_utf8(&mut output, calls[i] + "()\n") }
    }
    bytes.append_utf8(&mut output, "return 0\n}\n")
}
