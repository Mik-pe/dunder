// The supported manifest subset is deliberately small: root string fields and
// one [dependencies] section with quoted paths or one-line inline tables.
import sys
import std.bytes as bytes
import std.text as text

pub struct Manifest {
    ok: bool, error: string, name: string, root: string, test_root: string,
    dep_names: []string, dep_paths: []string, dep_git: []string,
    dep_kinds: []string, dep_refs: []string, dep_lines: []i32,
}
pub fn empty() -> Manifest {
    Manifest { ok: false, error: "", name: "", root: "", test_root: "",
        dep_names: [], dep_paths: [], dep_git: [], dep_kinds: [], dep_refs: [], dep_lines: [] }
}
pub fn valid_dep_name(name: string) -> bool {
    if name == "" || name == "sys" || name == "std" { return false }
    first := name[0]
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) { return false }
    for idx in 1..name.len {
        b := name[idx]
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95) { return false }
    }
    true
}

struct Cursor { at: i32, error: string }
fn spaces(input: string, cursor: &mut Cursor) {
    while cursor.at < input.len && (input[cursor.at] == 32 || input[cursor.at] == 9 || input[cursor.at] == 13) { cursor.at = cursor.at + 1 }
}
fn uncomment(line: string) -> string {
    mut quote := 0; mut at := 0
    while at < line.len {
        b := line[at]
        if quote == 0 {
            if b == 35 { return line[0..at] }
            if b == 34 || b == 39 { quote = b }
        } else if b == quote { quote = 0 }
        else if quote == 34 && b == 92 { at = at + 1 }
        at = at + 1
    }
    line.clone()
}
fn hex_digit(b: i32) -> i32 {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 }
    if b >= 97 && b <= 102 { return b - 87 }
    -1
}
fn unicode_escape(input: string, cursor: &mut Cursor, output: &mut []u8, count: i32) {
    if count > input.len - cursor.at { cursor.error = "incomplete Unicode escape in manifest string"; return }
    mut value := 0
    for i in 0..count {
        digit := hex_digit(input[cursor.at]); cursor.at = cursor.at + 1
        if digit < 0 { cursor.error = "invalid Unicode escape in manifest string"; return }
        if value > 69631 { cursor.error = "invalid Unicode scalar in manifest string"; return }
        value = value * 16 + digit
    }
    if value > 1114111 || (value >= 55296 && value <= 57343) { cursor.error = "invalid Unicode scalar in manifest string"; return }
    bytes.append_utf8(&mut output, rune(value).str())
}
fn quoted(input: string, cursor: &mut Cursor) -> string {
    spaces(input, &mut cursor)
    if cursor.at >= input.len || (input[cursor.at] != 34 && input[cursor.at] != 39) {
        cursor.error = "manifest values must be quoted strings"; return ""
    }
    quote := input[cursor.at]; cursor.at = cursor.at + 1
    mut output: []u8 = []
    while cursor.at < input.len {
        b := input[cursor.at]; cursor.at = cursor.at + 1
        if b == quote { return bytes.decode(&output).value }
        if (b < 32 && b != 9) || b == 127 { cursor.error = "unescaped control character in manifest string"; return "" }
        if b != 92 || quote == 39 { output.push(u8(b)); continue }
        if cursor.at >= input.len { break }
        escape := input[cursor.at]; cursor.at = cursor.at + 1
        if escape == 34 || escape == 92 { output.push(u8(escape)) }
        else if escape == 98 { output.push(8) }
        else if escape == 116 { output.push(9) }
        else if escape == 110 { output.push(10) }
        else if escape == 102 { output.push(12) }
        else if escape == 114 { output.push(13) }
        else if escape == 117 || escape == 85 {
            mut count := 4; if escape == 85 { count = 8 }
            unicode_escape(input, &mut cursor, &mut output, count)
            if cursor.error != "" { return "" }
        } else { cursor.error = "unknown escape in manifest string"; return "" }
    }
    cursor.error = "unterminated manifest string"; ""
}
fn string_value(input: string, cursor: &mut Cursor) -> string {
    value := quoted(input, &mut cursor)
    if cursor.error != "" { return "" }
    spaces(input, &mut cursor)
    if cursor.at != input.len { cursor.error = "unexpected text after manifest string"; return "" }
    value
}

struct Dependency { path: string, git: string, kind: string, reference: string }
fn dependency(input: string, cursor: &mut Cursor) -> Dependency {
    mut out := Dependency { path: "", git: "", kind: "", reference: "" }
    spaces(input, &mut cursor)
    if cursor.at >= input.len || input[cursor.at] != 123 {
        out.path = string_value(input, &mut cursor)
        if cursor.error == "" && out.path == "" { cursor.error = "empty dependency path" }
        return out
    }
    cursor.at = cursor.at + 1; spaces(input, &mut cursor)
    mut seen := 0
    while cursor.at < input.len && input[cursor.at] != 125 {
        first := cursor.at
        while cursor.at < input.len && input[cursor.at] != 61 && input[cursor.at] != 44 && input[cursor.at] != 125 { cursor.at = cursor.at + 1 }
        key := text.trim(input[first..cursor.at])
        if key == "" || cursor.at >= input.len || input[cursor.at] != 61 { cursor.error = "expected an inline dependency field assignment"; return out }
        mut bit := 0
        if key == "path" { bit = 1 } else if key == "git" { bit = 2 }
        else if key == "branch" { bit = 4 } else if key == "tag" { bit = 8 } else if key == "rev" { bit = 16 }
        if bit == 0 { cursor.error = "unknown inline dependency field: " + key; return out }
        if seen.bit_and(bit) != 0 { cursor.error = "duplicate inline dependency field: " + key; return out }
        if bit >= 4 && seen.bit_and(28) != 0 { cursor.error = "dependency accepts only one of branch, tag or rev"; return out }
        seen = seen.bit_or(bit); cursor.at = cursor.at + 1
        value := quoted(input, &mut cursor)
        if cursor.error != "" { return out }
        if value == "" { cursor.error = "empty manifest value for " + key; return out }
        if bit == 1 { out.path = value }
        else if bit == 2 { out.git = value }
        else { out.kind = key; out.reference = value }
        spaces(input, &mut cursor)
        if cursor.at >= input.len { cursor.error = "unterminated inline dependency table"; return out }
        if input[cursor.at] == 125 { break }
        if input[cursor.at] != 44 { cursor.error = "expected ',' or '}' in inline dependency table"; return out }
        cursor.at = cursor.at + 1; spaces(input, &mut cursor)
        if cursor.at >= input.len || input[cursor.at] == 125 { cursor.error = "expected a field after inline dependency comma"; return out }
    }
    if cursor.at >= input.len || input[cursor.at] != 125 { cursor.error = "unterminated inline dependency table"; return out }
    cursor.at = cursor.at + 1; spaces(input, &mut cursor)
    if cursor.at != input.len { cursor.error = "unexpected text after inline dependency table"; return out }
    if out.path != "" && out.git != "" { cursor.error = "dependency cannot combine path and git" }
    else if out.path == "" && out.git == "" { cursor.error = "dependency requires path or git" }
    else if out.path != "" && out.kind != "" { cursor.error = "branch, tag and rev require a git dependency" }
    out
}

pub fn parse_text(path: string, source: string, require_name: bool) -> Manifest {
    mut out := empty()
    mut version := ""; mut in_deps := false; mut number := 0; mut name_line := 1
    for line in text.split(source, "\n") {
        number = number + 1
        field := text.trim(uncomment(line))
        if field == "" { continue }
        location := path + ":" + number.str() + ": "
        if text.starts_with(field, "[") {
            if !text.ends_with(field, "]") || field.len < 3 { out.error = location + "malformed section header: " + field; return out }
            section := text.trim(field[1..field.len - 1])
            if section != "dependencies" { out.error = location + "unknown manifest section: " + section; return out }
            if in_deps { out.error = location + "duplicate manifest section: dependencies"; return out }
            in_deps = true; continue
        }
        split := text.find(field, "=")
        if split < 1 { out.error = location + "expected a manifest field assignment"; return out }
        key := text.trim(field[0..split]); value_text := text.trim(field[split + 1..field.len])
        mut cursor := Cursor { at: 0, error: "" }
        if !in_deps {
            value := string_value(value_text, &mut cursor)
            if cursor.error != "" { out.error = location + cursor.error; return out }
            if value == "" { out.error = location + "empty manifest value for " + key; return out }
            if key == "name" && out.name == "" { out.name = value; name_line = number }
            else if key == "version" && version == "" { version = value }
            else if key == "root" && out.root == "" { out.root = value }
            else if key == "test_root" && out.test_root == "" { out.test_root = value }
            else { out.error = location + "unknown or duplicate manifest field: " + key; return out }
        } else {
            if key == "sys" || key == "std" { out.error = location + "reserved dependency name: " + key; return out }
            if !valid_dep_name(key) { out.error = location + "invalid dependency name: " + key; return out }
            for i in 0..out.dep_names.len { if out.dep_names[i] == key { out.error = location + "duplicate dependency: " + key; return out } }
            dep := dependency(value_text, &mut cursor)
            if cursor.error != "" { out.error = location + cursor.error; return out }
            out.dep_names.push(key.clone()); out.dep_paths.push(move dep.path); out.dep_git.push(move dep.git)
            out.dep_kinds.push(move dep.kind); out.dep_refs.push(move dep.reference); out.dep_lines.push(number)
        }
    }
    if require_name && out.name == "" { out.error = path + ":1: manifest requires name"; return out }
    if out.root == "" { out.error = path + ":1: manifest requires root"; return out }
    for i in 0..out.name.len {
        b := out.name[i]
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 95) {
            out.error = path + ":" + name_line.str() + ": manifest name must contain only letters, digits, '_' or '-'"; return out
        }
    }
    out.ok = true; out
}
pub fn parse(path: string, require_name: bool) -> Manifest {
    file := sys.read_text(path)
    if !file.ok { mut out := empty(); out.error = path + ": " + sys.error_message(file.error); return out }
    parse_text(path, file.value, require_name)
}

@test fn local_dependencies_preserve_manifest_fields_order_and_source_lines() {
    parsed := parse_text("dunder.toml", "# package\nname = \"my-app_2\"\nversion = \"0.2.0\"\nroot = \"src/main.ddr\"\ntest_root = \"tests/suite.ddr\"\n\n[dependencies]\nfirst = \"../first\"\nsecond = { path = \"../second, with # marks\" } # comment\n", true)
    assert(parsed.ok && parsed.error == "" && parsed.name == "my-app_2" && parsed.root == "src/main.ddr" && parsed.test_root == "tests/suite.ddr")
    assert(parsed.dep_names.len == 2 && parsed.dep_paths.len == 2 && parsed.dep_git.len == 2 && parsed.dep_kinds.len == 2 && parsed.dep_refs.len == 2 && parsed.dep_lines.len == 2)
    assert(parsed.dep_names[0] == "first" && parsed.dep_paths[0] == "../first" && parsed.dep_lines[0] == 8)
    assert(parsed.dep_names[1] == "second" && parsed.dep_paths[1] == "../second, with # marks" && parsed.dep_lines[1] == 9)
    for i in 0..2 { assert(parsed.dep_git[i] == "" && parsed.dep_kinds[i] == "" && parsed.dep_refs[i] == "") }
    assert(parse_text("sub/dunder.toml", "root = 'src/lib.ddr'\n", false).ok)
    assert(!parse_text("sub/dunder.toml", "root = 'src/lib.ddr'\n", true).ok)
}

@test fn git_dependencies_distinguish_default_branch_tag_and_revision() {
    source := "name='app'\nroot='main.ddr'\n[dependencies] # sources\n" +
        "default = { git = 'https://example.test/repo.git' }\n" +
        "branch = { branch = 'feature/a,b#c', git = 'ssh://git@example.test/repo.git' }\n" +
        "tag = { git = 'https://example.test/repo.git', tag = 'v0.2.0' }\n" +
        "revision = { rev = 'abcdef1234', git = 'file:///tmp/repo' }\n"
    parsed := parse_text("deps.toml", source, true)
    assert(parsed.ok && parsed.dep_names.len == 4)
    assert(parsed.dep_git[0] == "https://example.test/repo.git" && parsed.dep_kinds[0] == "" && parsed.dep_refs[0] == "")
    assert(parsed.dep_kinds[1] == "branch" && parsed.dep_refs[1] == "feature/a,b#c")
    assert(parsed.dep_kinds[2] == "tag" && parsed.dep_refs[2] == "v0.2.0")
    assert(parsed.dep_kinds[3] == "rev" && parsed.dep_refs[3] == "abcdef1234")
    for i in 0..4 { assert(parsed.dep_paths[i] == "" && parsed.dep_lines[i] == i + 4) }
}

@test fn manifest_strings_decode_basic_escapes_and_preserve_literal_strings() {
    source := "name = \"app\" # package\nroot = \"src/\\u00e5\\U0001F30D.ddr\"\ntest_root = 'tests\\suite.ddr'\n" +
        "[dependencies]\nquoted = { path = \"../a\\\"b\\\\c,#d\" }\n"
    parsed := parse_text("escapes.toml", source, true)
    assert(parsed.ok && parsed.root == "src/å🌍.ddr" && parsed.test_root == "tests\\suite.ddr")
    assert(parsed.dep_paths[0] == "../a\"b\\c,#d")
    escaped := parse_text("escapes.toml", "name='a'\nroot=\"a\\tb\\nc\\rd\\be\\ff\"\n", true)
    assert(escaped.ok && escaped.root == "a\tb\nc\rd\x08e\x0cf")
}

@test fn malformed_dependency_tables_never_publish_a_partial_row() {
    bad: []string = ["{}", "{ git = 'url', path = 'local' }", "{ path = 'local', branch = 'main' }",
        "{ git = 'url', tag = 'v1', branch = 'main' }", "{ git = 'url', rev = 'a', rev = 'b' }",
        "{ git = 'url', git = 'other' }", "{ url = 'url' }", "{ git = '' }", "{ path = '' }",
        "{ git = 'url', tag = '' }", "{ branch = 'main' }", "{ path = 'a'", "{ path = 'a', }",
        "{ path = 'a',, git = 'url' }", "{ path = 'a' git = 'url' }", "{ path = 'a' } trailing",
        "{ git = ['url'] }", "{ git = { path = 'x' } }", "\"a\" trailing", "\"unterminated",
        "\"bad\\q\"", "\"bad\\uD800\"", "\"bad\\UFFFFFFFF\"", "\"bad\\u12\"", "''"]
    for value in bad {
        parsed := parse_text("bad.toml", "name='app'\nroot='main.ddr'\n[dependencies]\nlib=" + value + "\n", true)
        assert(!parsed.ok && text.starts_with(parsed.error, "bad.toml:4: ") && parsed.dep_names.len == 0 && parsed.dep_paths.len == 0 && parsed.dep_git.len == 0)
    }
}

@test fn manifest_rejects_duplicate_sections_fields_names_and_missing_roots() {
    assert(valid_dep_name("skrift") && valid_dep_name("_lib_2"))
    for name in ["", "sys", "std", "1lib", "my-lib", "my.lib", "å"] { assert(!valid_dep_name(name)) }
    for source in ["name='a'\nroot='main.ddr'\nname='b'", "name='a'\nroot='main.ddr'\nversion='1'\nversion='2'",
        "name='a'\nroot='main.ddr'\n[unknown]", "name='a'\nroot='main.ddr'\n[dependencies",
        "name='a'\nroot='main.ddr'\n[dependencies]\n[dependencies]",
        "name='a'\nroot='main.ddr'\n[dependencies]\nlib='a'\nlib={git='url'}",
        "name='a'\nroot='main.ddr'\n[dependencies]\nsys='a'", "name='a'\nroot='main.ddr'\n[dependencies]\nmy-lib='a'",
        "name='a'\nroot='main.ddr'\nunknown='b'", "name='bad/name'\nroot='main.ddr'", "name='a'", "root='main.ddr'", ""] {
        parsed := parse_text("invalid.toml", source, true)
        assert(!parsed.ok && text.starts_with(parsed.error, "invalid.toml:") && parsed.error != "")
    }
}
