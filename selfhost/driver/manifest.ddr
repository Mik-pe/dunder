capability filesystem
import sys
import paths
import json_compat as jcompat
import std.json as json
import std.text as text
import std.toml as toml

pub fn package_dir(start: string, dirs: &[]string, entries: &[]string) -> string {
    if !sys.metadata(start).is_dir { return "" }
    mut dir := start.clone()
    while !sys.metadata(dir + "/dunder.toml").is_file {
        for i in 1..dirs.len {
            if entries[i] == "" && sys.same_file(dir, dirs[i]) { return dir }
        }
        parent := dir + "/.."
        if !sys.metadata(parent).is_dir || sys.same_file(dir, parent) { return "" }
        dir = parent
    }
    dir
}

pub struct NativeLibOverride {
    target: string,
    key: string,
    path: string,
    framework: string,
    soname: string,
    dll: string,
    weak: bool,
    delay: bool,
}
pub struct NativeTargetConfig {
    target: string,
    rpath: []string,
    libc: string,
}
pub struct AppConfig {
    subsystem: string,
    dpi_aware: bool,
    dpi_aware_set: bool,
    utf8: bool,
    utf8_set: bool,
    icon: string,
    bundle_id: string,
    entitlements: string,
    frameworks: []string,
}

pub fn empty_native_lib_override(target: string, key: string) -> NativeLibOverride {
    NativeLibOverride { target: target.clone(), key: key.clone(), path: "", framework: "", soname: "", dll: "", weak: false, delay: false }
}
pub fn empty_native_config(target: string) -> NativeTargetConfig {
    NativeTargetConfig { target: target.clone(), rpath: [], libc: "" }
}
pub fn empty_app_config() -> AppConfig {
    AppConfig { subsystem: "", dpi_aware: false, dpi_aware_set: false, utf8: false, utf8_set: false, icon: "", bundle_id: "", entitlements: "", frameworks: [] }
}

pub struct Manifest {
    ok: bool, error: string, name: string, version: string, root: string, test_root: string,
    dep_names: []string, dep_paths: []string, dep_git: []string,
    dep_kinds: []string, dep_refs: []string, dep_subdirs: []string, dep_caps: []i32, dep_lines: []i32,
    dep_native_lib_starts: []i32, dep_native_lib_counts: []i32, dep_native_libs: []string, dep_has_native_libs: []bool,
    example_names: []string, example_paths: []string, example_lines: []i32,
    native: NativeTargetConfig,
    native_targets: []NativeTargetConfig,
    native_libs: []NativeLibOverride,
    app: AppConfig,
}
pub fn empty() -> Manifest {
    Manifest { ok: false, error: "", name: "", version: "", root: "", test_root: "",
        dep_names: [], dep_paths: [], dep_git: [], dep_kinds: [], dep_refs: [], dep_subdirs: [], dep_caps: [], dep_lines: [],
        dep_native_lib_starts: [], dep_native_lib_counts: [], dep_native_libs: [], dep_has_native_libs: [],
        example_names: [], example_paths: [], example_lines: [],
        native: empty_native_config(""),
        native_targets: [],
        native_libs: [],
        app: empty_app_config() }
}
pub fn valid_target_key(name: string) -> bool {
    name == "macos" || name == "arm64-macos" || name == "aarch64-apple-darwin" ||
    name == "linux" || name == "arm64-linux" || name == "aarch64-unknown-linux-gnu" ||
    name == "x86_64" || name == "x86_64-linux" || name == "x86_64-unknown-linux-gnu" ||
    name == "windows" || name == "x86_64-windows" || name == "x86_64-pc-windows-msvc" ||
    name == "arm64" || name == "native" ||
    name == "wasm32" || name == "wasm32-unknown-unknown" ||
    name == "wasi" || name == "wasm32-wasi" || name == "wasm32-wasip1"
}
pub fn target_key_matches(platform: i32, key: string) -> bool {
    if key == "" { return true }
    if key == "macos" || key == "arm64-macos" || key == "aarch64-apple-darwin" { return platform == 0 }
    if key == "linux" { return platform == 1 || platform == 2 }
    if key == "arm64-linux" || key == "aarch64-unknown-linux-gnu" { return platform == 1 }
    if key == "x86_64" { return platform == 2 || platform == 5 }
    if key == "x86_64-linux" || key == "x86_64-unknown-linux-gnu" { return platform == 2 }
    if key == "windows" || key == "x86_64-windows" || key == "x86_64-pc-windows-msvc" { return platform == 5 }
    if key == "arm64" { return platform == 0 || platform == 1 }
    if key == "native" { return platform != 3 && platform != 4 }
    if key == "wasm32" { return platform == 3 || platform == 4 }
    if key == "wasm32-unknown-unknown" { return platform == 3 }
    if key == "wasi" || key == "wasm32-wasi" || key == "wasm32-wasip1" { return platform == 4 }
    false
}
pub fn target_key_priority(key: string) -> i32 {
    if key == "" { return 1 }
    if key == "macos" || key == "linux" || key == "windows" || key == "wasi" || key == "arm64" || key == "x86_64" || key == "native" || key == "wasm32" { return 2 }
    3
}
pub fn valid_native_lib_key(name: string) -> bool {
    if name == "" { return false }
    for b in name.bytes() {
        if b < 32 || b == 127 { return false }
    }
    true
}
pub fn dep_native_libs_for(parsed: &Manifest, index: i32) -> []string {
    mut out: []string = []
    if index < 0 || index >= parsed.dep_native_lib_starts.len { return out }
    start := parsed.dep_native_lib_starts[index]
    count := parsed.dep_native_lib_counts[index]
    for i in start..start + count { out.push(parsed.dep_native_libs[i].clone()) }
    out
}
pub fn native_config_for_platform(parsed: &Manifest, platform: i32) -> NativeTargetConfig {
    mut out := empty_native_config("")
    for rp in &parsed.native.rpath { out.rpath.push(rp.clone()) }
    out.libc = parsed.native.libc.clone()
    mut libc_prio := if out.libc != "" { 1 } else { 0 }
    for prio in 2..4 {
        for i in 0..parsed.native_targets.len {
            cfg := &parsed.native_targets[i]
            if target_key_matches(platform, cfg.target) && target_key_priority(cfg.target) == prio {
                for rp in &cfg.rpath { out.rpath.push(rp.clone()) }
                if cfg.libc != "" && prio >= libc_prio {
                    out.libc = cfg.libc.clone()
                    libc_prio = prio
                }
            }
        }
    }
    out
}
pub fn native_lib_override_for_platform(parsed: &Manifest, platform: i32, key: string) -> Option<NativeLibOverride> {
    mut best := -1
    mut best_prio := 0
    for i in 0..parsed.native_libs.len {
        entry := &parsed.native_libs[i]
        if entry.key == key && target_key_matches(platform, entry.target) {
            prio := target_key_priority(entry.target)
            if prio >= best_prio { best = i; best_prio = prio }
        }
    }
    if best < 0 { return .None }
    .Some(parsed.native_libs[best].clone())
}
pub fn valid_dep_name(name: string) -> bool {
    if name == "" || name == "sys" || name == "std" { return false }
    first := name[0]
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) { return false }
    for idx in 1..name.len {
        b := name[idx]
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95) { return false }
    }
    true
}
pub fn valid_example_name(name: string) -> bool {
    if name == "" || name[0] == 45 { return false }
    for idx in 0..name.len {
        b := name[idx]
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 95) { return false }
    }
    true
}
pub fn find_example(parsed: &Manifest, name: string) -> i32 {
    for i in 0..parsed.example_names.len {
        if parsed.example_names[i] == name { return i }
    }
    -1
}

fn clean_subdir(raw: string) -> string {
    if raw == "" || paths.is_absolute(raw) || (raw.len >= 2 && raw[1] == 58) { return "" }
    mut end := raw.len
    if raw[end - 1] == 47 { end -= 1 }
    if end == 0 { return "" }
    for i in 0..end {
        b := raw[i]
        if b == 0 || b == 92 { return "" }
    }
    trimmed := raw[0..end]
    for seg in text.split(trimmed, "/") {
        if seg == "" || seg == "." || seg == ".." { return "" }
    }
    trimmed
}

fn dep_cap_bit(name: string) -> i32 {
    if name == "filesystem" { return 1 }
    if name == "network" { return 2 }
    if name == "process" { return 4 }
    if name == "stdio" { return 8 }
    if name == "unsafe" { return 16 }
    0
}

fn find_substr(haystack: string, needle: string) -> i32 {
    if needle.len == 0 { return 0 }
    if needle.len > haystack.len { return -1 }
    limit := haystack.len - needle.len + 1
    for i in 0..limit {
        mut ok := true
        for j in 0..needle.len {
            if haystack[i + j] != needle[j] { ok = false; break }
        }
        if ok { return i }
    }
    -1
}

fn toml_error_line(err: string) -> i32 {
    if !text.starts_with(err, "TOML line ") { return 1 }
    mut i := 10
    mut line := 0
    while i < err.len && err[i] >= 48 && err[i] <= 57 {
        line = line * 10 + (i32(err[i]) - 48)
        i += 1
    }
    if line > 0 { line } else { 1 }
}

fn toml_error_message(err: string) -> string {
    if !text.starts_with(err, "TOML line ") { return err.clone() }
    colon := find_substr(err, ": ")
    if colon >= 0 { return err[colon + 2..err.len] }
    err.clone()
}

fn strip_line_comment(raw: string, in_multi: &mut i32) -> string {
    mut line := raw.clone()
    if line.len > 0 && line[line.len - 1] == 13 { line = line[0..line.len - 1] }
    mut out: []u8 = []
    out.reserve(line.len)
    mut quote := 0
    mut i := 0
    while i < line.len {
        b := i32(line[i])
        if in_multi != 0 {
            if b == in_multi && i + 2 < line.len && i32(line[i + 1]) == in_multi && i32(line[i + 2]) == in_multi {
                in_multi = 0
                i += 3
                continue
            }
            if in_multi == 34 && b == 92 { i += 2; continue }
            i += 1
            continue
        }
        if quote == 0 {
            if b == 35 { break }
            if (b == 34 || b == 39) && i + 2 < line.len && i32(line[i + 1]) == b && i32(line[i + 2]) == b {
                in_multi = b
                out.push(u8(b)); out.push(u8(b)); out.push(u8(b))
                i += 3
                continue
            }
            if b == 34 || b == 39 { quote = b }
        } else if b == quote {
            quote = 0
        } else if quote == 34 && b == 92 {
            if i + 1 < line.len { out.push(u8(b)); out.push(u8(line[i + 1])); i += 2; continue }
        }
        out.push(u8(b))
        i += 1
    }
    text.trim(sys.decode_u8(&out).value)
}

fn parse_key_segment(raw: string, pos: &mut i32) -> string {
    mut at := pos
    while at < raw.len && (raw[at] == 32 || raw[at] == 9) { at += 1 }
    if at >= raw.len { pos = at; return "" }
    b := i32(raw[at])
    if b == 34 || b == 39 {
        q := b
        at += 1
        mut seg: []u8 = []
        while at < raw.len && i32(raw[at]) != q {
            if q == 34 && raw[at] == 92 && at + 1 < raw.len { at += 1 }
            seg.push(u8(raw[at]))
            at += 1
        }
        if at < raw.len && i32(raw[at]) == q { at += 1 }
        pos = at
        return sys.decode_u8(&seg).value
    }
    start := at
    while at < raw.len {
        ch := raw[at]
        if !((ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 45 || ch == 95) { break }
        at += 1
    }
    pos = at
    raw[start..at]
}

fn split_key_path(raw: string) -> []string {
    mut parts: []string = []
    mut pos := 0
    while pos < raw.len {
        seg := parse_key_segment(raw, &mut pos)
        if seg == "" { break }
        parts.push(move seg)
        while pos < raw.len && (raw[pos] == 32 || raw[pos] == 9) { pos += 1 }
        if pos >= raw.len || raw[pos] != 46 { break }
        pos += 1
    }
    parts
}

fn first_unquoted_eq(line: string) -> i32 {
    mut quote := 0
    mut i := 0
    while i < line.len {
        b := i32(line[i])
        if quote == 0 {
            if b == 61 { return i }
            if b == 34 || b == 39 { quote = b }
        } else if b == quote {
            quote = 0
        } else if quote == 34 && b == 92 {
            i += 1
        }
        i += 1
    }
    -1
}

fn join_dots(parts: &[]string) -> string {
    mut out := ""
    for i in 0..parts.len {
        if i > 0 { out = out + "." }
        out = out + parts[i]
    }
    out
}

fn find_line(source: string, section: string, key: string) -> i32 {
    mut cur_section := ""
    mut in_multi := 0
    mut number := 0
    for raw in text.split(source, "\n") {
        number += 1
        was_multi := in_multi != 0
        line := strip_line_comment(raw, &mut in_multi)
        if was_multi || line == "" { continue }
        if text.starts_with(line, "[") {
            mut inner := ""
            if text.starts_with(line, "[[") && text.ends_with(line, "]]") && line.len >= 4 {
                inner = text.trim(line[2..line.len - 2])
            } else if text.ends_with(line, "]") && line.len >= 2 {
                inner = text.trim(line[1..line.len - 1])
            } else { continue }
            hdr := split_key_path(inner)
            if hdr.len == 0 { continue }
            cur_section = join_dots(&hdr)
            if section != "" && key == "" && hdr[0] == section { return number }
            if section != "" && key != "" && hdr.len >= 2 && hdr[0] == section && hdr[1] == key { return number }
            continue
        }
        eq := first_unquoted_eq(line)
        if eq < 1 { continue }
        lhs := split_key_path(text.trim(line[0..eq]))
        if lhs.len == 0 { continue }
        if section == "" {
            if cur_section == "" && lhs[0] == key { return number }
        } else if key == "" {
            if cur_section == "" && lhs[0] == section { return number }
        } else {
            if cur_section == section && lhs[0] == key { return number }
            if cur_section == "" && lhs.len >= 2 && lhs[0] == section && lhs[1] == key { return number }
        }
    }
    1
}

fn valid_version_str(value: string) -> bool {
    if value == "" { return false }
    for b in value.bytes() {
        if b < 32 || b == 127 { return false }
    }
    true
}

fn add_dependency(path: string, line: i32, key: string, doc: &json.Doc, dep_node: i32, out: &mut Manifest) -> bool {
    location := path + ":" + line.str() + ": "
    if key == "sys" || key == "std" { out.error = location + "reserved dependency name: " + key; return false }
    if !valid_dep_name(key) { out.error = location + "invalid dependency name: " + key; return false }
    for i in 0..out.dep_names.len { if out.dep_names[i] == key { out.error = location + "duplicate dependency: " + key; return false } }
    mut dep_path := ""
    mut dep_git := ""
    mut dep_kind := ""
    mut dep_ref := ""
    mut dep_subdir := ""
    mut dep_caps := 0
    mut dep_nlibs: []string = []
    mut has_nlibs := false
    k := doc.kind(dep_node)
    if k == .String {
        s := jcompat.as_str(&doc, dep_node)
        if !s.ok || s.value == "" { out.error = location + "empty dependency path"; return false }
        dep_path = s.value
    } else if k == .Object {
        mut seen := 0
        count := doc.count(dep_node)
        for i in 0..count {
            fk_res := jcompat.key_at(&doc, dep_node, i)
            if !fk_res.ok { out.error = location + "invalid dependency key"; return false }
            fk := fk_res.value
            fv := doc.val_at(dep_node, i)
            mut bit := 0
            if fk == "path" { bit = 1 } else if fk == "git" { bit = 2 }
            else if fk == "branch" { bit = 4 } else if fk == "tag" { bit = 8 } else if fk == "rev" { bit = 16 }
            else if fk == "subdir" { bit = 32 } else if fk == "capabilities" { bit = 64 }
            else if fk == "native_libs" { bit = 128 }
            if bit == 0 { out.error = location + "unknown inline dependency field: " + fk; return false }
            if bit.bit_and(28) != 0 && seen.bit_and(28) != 0 { out.error = location + "dependency accepts only one of branch, tag or rev"; return false }
            seen = seen.bit_or(bit)
            if bit == 64 {
                if doc.kind(fv) != .Array { out.error = location + "capabilities must be a string list"; return false }
                cap_count := doc.count(fv)
                for c_idx in 0..cap_count {
                    item := doc.at(fv, c_idx)
                    if doc.kind(item) != .String { out.error = location + "capabilities must be a string list"; return false }
                    cap_s := jcompat.as_str(&doc, item)
                    if !cap_s.ok { out.error = location + "capabilities must be a string list"; return false }
                    cbit := dep_cap_bit(cap_s.value)
                    if cbit == 0 { out.error = location + "unknown capability in dependency grant: " + cap_s.value; return false }
                    if dep_caps.bit_and(cbit) != 0 { out.error = location + "duplicate capability in dependency grant: " + cap_s.value; return false }
                    dep_caps = dep_caps.bit_or(cbit)
                }
            } else if bit == 128 {
                has_nlibs = true
                if doc.kind(fv) != .Array { out.error = location + "native_libs must be a string list"; return false }
                nl_count := doc.count(fv)
                for n_idx in 0..nl_count {
                    item := doc.at(fv, n_idx)
                    if doc.kind(item) != .String { out.error = location + "native_libs must be a string list"; return false }
                    nl_s := jcompat.as_str(&doc, item)
                    if !nl_s.ok || !valid_native_lib_key(nl_s.value) { out.error = location + "invalid native_libs entry"; return false }
                    for prev in &dep_nlibs {
                        if prev == nl_s.value { out.error = location + "duplicate native_libs entry: " + nl_s.value; return false }
                    }
                    dep_nlibs.push(move nl_s.value)
                }
            } else {
                if doc.kind(fv) != .String { out.error = location + "manifest values must be quoted strings"; return false }
                vs := jcompat.as_str(&doc, fv)
                if !vs.ok || vs.value == "" { out.error = location + "empty manifest value for " + fk; return false }
                if bit == 1 { dep_path = vs.value }
                else if bit == 2 { dep_git = vs.value }
                else if bit == 32 { dep_subdir = vs.value }
                else { dep_kind = fk.clone(); dep_ref = vs.value }
            }
        }
        if dep_path != "" && dep_git != "" { out.error = location + "dependency cannot combine path and git"; return false }
        if dep_path == "" && dep_git == "" { out.error = location + "dependency requires path or git"; return false }
        if dep_path != "" && dep_kind != "" { out.error = location + "branch, tag and rev require a git dependency"; return false }
        if dep_path != "" && dep_subdir != "" { out.error = location + "subdir requires a git dependency"; return false }
        if dep_subdir != "" {
            normalized_subdir := clean_subdir(dep_subdir)
            if normalized_subdir == "" { out.error = location + "invalid dependency subdir: " + dep_subdir; return false }
            dep_subdir = normalized_subdir
        }
    } else {
        out.error = location + "manifest values must be quoted strings or tables"; return false
    }
    nstart := out.dep_native_libs.len
    for lib in &dep_nlibs { out.dep_native_libs.push(lib.clone()) }
    out.dep_native_lib_starts.push(nstart)
    out.dep_native_lib_counts.push(dep_nlibs.len)
    out.dep_has_native_libs.push(has_nlibs)
    out.dep_names.push(key.clone()); out.dep_paths.push(move dep_path); out.dep_git.push(move dep_git)
    out.dep_kinds.push(move dep_kind); out.dep_refs.push(move dep_ref); out.dep_subdirs.push(move dep_subdir); out.dep_caps.push(dep_caps); out.dep_lines.push(line)
    true
}

fn parse_string_list(location: string, field_name: string, doc: &json.Doc, node: i32, reject_dups: bool, out_list: &mut []string, err: &mut string) -> bool {
    if doc.kind(node) != .Array { err = location + field_name + " must be a string list"; return false }
    count := doc.count(node)
    for idx in 0..count {
        item := doc.at(node, idx)
        if doc.kind(item) != .String { err = location + field_name + " must be a string list"; return false }
        s := jcompat.as_str(&doc, item)
        if !s.ok || !valid_native_lib_key(s.value) { err = location + "empty or invalid entry in " + field_name; return false }
        if reject_dups {
            for prev in &out_list {
                if prev == s.value { err = location + "duplicate entry in " + field_name + ": " + s.value; return false }
            }
        }
        out_list.push(move s.value)
    }
    true
}

fn parse_native_lib_override(path: string, line: i32, target: string, lib_key: string, doc: &json.Doc, node: i32, out: &mut Manifest) -> bool {
    location := path + ":" + line.str() + ": "
    if !valid_native_lib_key(lib_key) { out.error = location + "invalid native library key: " + lib_key; return false }
    if doc.kind(node) != .Object { out.error = location + "native.libs." + lib_key + " must be a table"; return false }
    mut entry := empty_native_lib_override(target, lib_key)
    count := doc.count(node)
    for i in 0..count {
        fk_res := jcompat.key_at(&doc, node, i)
        if !fk_res.ok { out.error = location + "invalid native library override key"; return false }
        fk := fk_res.value
        fv := doc.val_at(node, i)
        if fk == "path" || fk == "framework" || fk == "soname" || fk == "dll" {
            if doc.kind(fv) != .String { out.error = location + "native.libs." + lib_key + "." + fk + " must be a quoted string"; return false }
            vs := jcompat.as_str(&doc, fv)
            if !vs.ok || !valid_native_lib_key(vs.value) { out.error = location + "empty or invalid manifest value for " + fk; return false }
            if fk == "path" { entry.path = move vs.value }
            else if fk == "framework" { entry.framework = move vs.value }
            else if fk == "soname" { entry.soname = move vs.value }
            else { entry.dll = move vs.value }
        } else if fk == "weak" || fk == "delay" {
            b := doc.as_bool(fv)
            match b {
                .Some(val) => {
                    if fk == "weak" { entry.weak = val } else { entry.delay = val }
                },
                .None => {
                    out.error = location + "native.libs." + lib_key + "." + fk + " must be a boolean"; return false
                },
            }
        } else {
            out.error = location + "unknown native library override field: " + fk; return false
        }
    }
    out.native_libs.push(move entry)
    true
}

fn parse_native_table(path: string, source: string, target: string, doc: &json.Doc, node: i32, out: &mut Manifest) -> bool {
    sec_line := if target == "" { find_line(source, "native", "") } else { find_line(source, "target", target) }
    sec_loc := path + ":" + sec_line.str() + ": "
    if doc.kind(node) != .Object { out.error = sec_loc + "native must be a table"; return false }
    mut cfg := empty_native_config(target)
    count := doc.count(node)
    for i in 0..count {
        fk_res := jcompat.key_at(&doc, node, i)
        if !fk_res.ok { out.error = sec_loc + "invalid native key"; return false }
        fk := fk_res.value
        fv := doc.val_at(node, i)
        fline := if target == "" { find_line(source, "native", fk) } else { sec_line }
        location := path + ":" + fline.str() + ": "
        if fk == "rpath" {
            mut err := ""
            if !parse_string_list(location, "rpath", &doc, fv, false, &mut cfg.rpath, &mut err) { out.error = move err; return false }
        } else if fk == "libc" {
            if doc.kind(fv) != .String { out.error = location + "libc must be a quoted string"; return false }
            vs := jcompat.as_str(&doc, fv)
            if !vs.ok || (vs.value != "glibc" && vs.value != "musl") {
                out.error = location + "invalid libc value: expected \"glibc\" or \"musl\""; return false
            }
            cfg.libc = move vs.value
        } else if fk == "libs" {
            if doc.kind(fv) != .Object { out.error = location + "native.libs must be a table"; return false }
            lib_count := doc.count(fv)
            for j in 0..lib_count {
                lk := jcompat.key_at(&doc, fv, j)
                if !lk.ok { out.error = location + "invalid native.libs key"; return false }
                if !parse_native_lib_override(path, fline, target, lk.value, &doc, doc.val_at(fv, j), &mut out) { return false }
            }
        } else {
            out.error = location + "unknown native field: " + fk; return false
        }
    }
    if target == "" { out.native = move cfg }
    else { out.native_targets.push(move cfg) }
    true
}

fn parse_app_table(path: string, source: string, doc: &json.Doc, node: i32, out: &mut Manifest) -> bool {
    sec_line := find_line(source, "app", "")
    sec_loc := path + ":" + sec_line.str() + ": "
    if doc.kind(node) != .Object { out.error = sec_loc + "app must be a table"; return false }
    count := doc.count(node)
    for i in 0..count {
        fk_res := jcompat.key_at(&doc, node, i)
        if !fk_res.ok { out.error = sec_loc + "invalid app key"; return false }
        fk := fk_res.value
        fv := doc.val_at(node, i)
        fline := find_line(source, "app", fk)
        location := path + ":" + fline.str() + ": "
        if fk == "subsystem" {
            if doc.kind(fv) != .String { out.error = location + "app.subsystem must be a quoted string"; return false }
            vs := jcompat.as_str(&doc, fv)
            if !vs.ok || (vs.value != "console" && vs.value != "gui") {
                out.error = location + "invalid app.subsystem: expected \"console\" or \"gui\""; return false
            }
            out.app.subsystem = move vs.value
        } else if fk == "dpi_aware" || fk == "utf8" {
            b := doc.as_bool(fv)
            match b {
                .Some(val) => {
                    if fk == "dpi_aware" { out.app.dpi_aware = val; out.app.dpi_aware_set = true }
                    else { out.app.utf8 = val; out.app.utf8_set = true }
                },
                .None => {
                    out.error = location + "app." + fk + " must be a boolean"; return false
                },
            }
        } else if fk == "icon" || fk == "bundle_id" || fk == "entitlements" {
            if doc.kind(fv) != .String { out.error = location + "app." + fk + " must be a quoted string"; return false }
            vs := jcompat.as_str(&doc, fv)
            if !vs.ok || !valid_native_lib_key(vs.value) { out.error = location + "empty or invalid manifest value for app." + fk; return false }
            if fk == "icon" { out.app.icon = move vs.value }
            else if fk == "bundle_id" { out.app.bundle_id = move vs.value }
            else { out.app.entitlements = move vs.value }
        } else if fk == "frameworks" {
            mut err := ""
            if !parse_string_list(location, "app.frameworks", &doc, fv, true, &mut out.app.frameworks, &mut err) { out.error = move err; return false }
        } else {
            out.error = location + "unknown app field: " + fk; return false
        }
    }
    true
}

pub fn parse_text(path: string, source: string, require_name: bool) -> Manifest {
    mut out := empty()
    parsed := toml.parse(source)
    if !parsed.ok {
        line := toml_error_line(parsed.error)
        out.error = path + ":" + line.str() + ": " + toml_error_message(parsed.error)
        return out
    }
    doc := json.Doc::parse_text(parsed.json)
    if !doc.ok || doc.kind(doc.root) != .Object {
        out.error = path + ":1: invalid manifest"
        return out
    }
    mut name_line := 1
    top_count := doc.count(doc.root)
    for i in 0..top_count {
        k_res := jcompat.key_at(&doc, doc.root, i)
        if !k_res.ok { out.error = path + ":1: invalid manifest key"; return out }
        key := k_res.value
        node := doc.val_at(doc.root, i)
        if key == "name" || key == "version" || key == "root" || key == "test_root" {
            line := find_line(source, "", key)
            location := path + ":" + line.str() + ": "
            if doc.kind(node) != .String { out.error = location + "manifest values must be quoted strings"; return out }
            v := jcompat.as_str(&doc, node)
            if !v.ok || v.value == "" { out.error = location + "empty manifest value for " + key; return out }
            if key == "name" { out.name = v.value; name_line = line }
            else if key == "version" {
                if !valid_version_str(v.value) { out.error = location + "invalid manifest version"; return out }
                out.version = v.value
            } else if key == "root" { out.root = v.value }
            else { out.test_root = v.value }
        } else if key == "dependencies" {
            sec_line := find_line(source, "dependencies", "")
            if doc.kind(node) != .Object { out.error = path + ":" + sec_line.str() + ": dependencies must be a table"; return out }
            dep_count := doc.count(node)
            for j in 0..dep_count {
                dk := jcompat.key_at(&doc, node, j)
                if !dk.ok { out.error = path + ":" + sec_line.str() + ": invalid dependency key"; return out }
                dline := find_line(source, "dependencies", dk.value)
                if !add_dependency(path, dline, dk.value, &doc, doc.val_at(node, j), &mut out) { return out }
            }
        } else if key == "examples" {
            sec_line := find_line(source, "examples", "")
            if doc.kind(node) != .Object { out.error = path + ":" + sec_line.str() + ": examples must be a table"; return out }
            ex_count := doc.count(node)
            for j in 0..ex_count {
                ek := jcompat.key_at(&doc, node, j)
                if !ek.ok { out.error = path + ":" + sec_line.str() + ": invalid example key"; return out }
                ex_name := ek.value
                eline := find_line(source, "examples", ex_name)
                location := path + ":" + eline.str() + ": "
                if !valid_example_name(ex_name) { out.error = location + "invalid example name: " + ex_name; return out }
                if find_example(&out, ex_name) >= 0 { out.error = location + "duplicate example: " + ex_name; return out }
                ev_node := doc.val_at(node, j)
                if doc.kind(ev_node) != .String { out.error = location + "manifest values must be quoted strings"; return out }
                ev := jcompat.as_str(&doc, ev_node)
                if !ev.ok || ev.value == "" { out.error = location + "empty manifest value for " + ex_name; return out }
                out.example_names.push(move ex_name); out.example_paths.push(move ev.value); out.example_lines.push(eline)
            }
        } else if key == "native" {
            if !parse_native_table(path, source, "", &doc, node, &mut out) { return out }
        } else if key == "target" {
            sec_line := find_line(source, "target", "")
            if doc.kind(node) != .Object { out.error = path + ":" + sec_line.str() + ": target must be a table"; return out }
            t_count := doc.count(node)
            for j in 0..t_count {
                tk := jcompat.key_at(&doc, node, j)
                if !tk.ok { out.error = path + ":" + sec_line.str() + ": invalid target key"; return out }
                triple := tk.value
                tline := find_line(source, "target", triple)
                tloc := path + ":" + tline.str() + ": "
                if !valid_target_key(triple) { out.error = tloc + "unknown target in manifest: " + triple; return out }
                tnode := doc.val_at(node, j)
                if doc.kind(tnode) != .Object { out.error = tloc + "target." + triple + " must be a table"; return out }
                sub_count := doc.count(tnode)
                for s in 0..sub_count {
                    sk := jcompat.key_at(&doc, tnode, s)
                    if !sk.ok { out.error = tloc + "invalid key in target." + triple; return out }
                    if sk.value == "native" {
                        if !parse_native_table(path, source, triple, &doc, doc.val_at(tnode, s), &mut out) { return out }
                    } else {
                        out.error = tloc + "unknown target." + triple + " section: " + sk.value; return out
                    }
                }
            }
        } else if key == "app" {
            if !parse_app_table(path, source, &doc, node, &mut out) { return out }
        } else {
            line := find_line(source, key, "")
            out.error = path + ":" + line.str() + ": unknown manifest field or section: " + key
            return out
        }
    }
    if require_name && out.name == "" { out.error = path + ":1: manifest requires name"; return out }
    if out.root == "" { out.error = path + ":1: manifest requires root"; return out }
    for i in 0..out.name.len {
        b := out.name[i]
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 95) {
            out.error = path + ":" + name_line.str() + ": manifest name must contain only letters, digits, '_' or '-'"; return out
        }
    }
    out.ok = true; out
}
pub fn parse(path: string, require_name: bool) -> Manifest {
    file := sys.read_text(path)
    if !file.ok { mut out := empty(); out.error = path + ": " + sys.error_message(file.error); return out }
    parse_text(path, file.value, require_name)
}

@test fn local_dependencies_preserve_manifest_fields_order_and_source_lines() {
    parsed := parse_text("dunder.toml", "# package\nname = \"my-app_2\"\nversion = \"0.2.0\"\nroot = \"src/main.ddr\"\ntest_root = \"tests/suite.ddr\"\n\n[dependencies]\nfirst = \"../first\"\nsecond = { path = \"../second, with # marks\" } # comment\n", true)
    assert(parsed.ok && parsed.error == "" && parsed.name == "my-app_2" && parsed.version == "0.2.0" && parsed.root == "src/main.ddr" && parsed.test_root == "tests/suite.ddr")
    assert(parsed.dep_names.len == 2 && parsed.dep_paths.len == 2 && parsed.dep_git.len == 2 && parsed.dep_kinds.len == 2 && parsed.dep_refs.len == 2 && parsed.dep_lines.len == 2)
    assert(parsed.dep_names[0] == "first" && parsed.dep_paths[0] == "../first" && parsed.dep_lines[0] == 8)
    assert(parsed.dep_names[1] == "second" && parsed.dep_paths[1] == "../second, with # marks" && parsed.dep_lines[1] == 9)
    for i in 0..2 { assert(parsed.dep_git[i] == "" && parsed.dep_kinds[i] == "" && parsed.dep_refs[i] == "") }
    assert(parse_text("sub/dunder.toml", "root = 'src/lib.ddr'\n", false).ok)
    assert(!parse_text("sub/dunder.toml", "root = 'src/lib.ddr'\n", true).ok)
}

@test fn git_dependencies_distinguish_default_branch_tag_and_revision() {
    source := "name='app'\nroot='main.ddr'\n[dependencies] # sources\n" +
        "default = { git = 'https://example.test/repo.git' }\n" +
        "branch = { branch = 'feature/a,b#c', git = 'ssh://git@example.test/repo.git', subdir = 'packages/http/' }\n" +
        "tag = { git = 'https://example.test/repo.git', subdir = 'packages/client', tag = 'v0.2.0' }\n" +
        "revision = { rev = 'abcdef1234', git = 'file:///tmp/repo' }\n"
    parsed := parse_text("deps.toml", source, true)
    assert(parsed.ok && parsed.dep_names.len == 4)
    assert(parsed.dep_git[0] == "https://example.test/repo.git" && parsed.dep_kinds[0] == "" && parsed.dep_refs[0] == "" && parsed.dep_subdirs[0] == "")
    assert(parsed.dep_kinds[1] == "branch" && parsed.dep_refs[1] == "feature/a,b#c" && parsed.dep_subdirs[1] == "packages/http")
    assert(parsed.dep_kinds[2] == "tag" && parsed.dep_refs[2] == "v0.2.0" && parsed.dep_subdirs[2] == "packages/client")
    assert(parsed.dep_kinds[3] == "rev" && parsed.dep_refs[3] == "abcdef1234" && parsed.dep_subdirs[3] == "")
    for i in 0..4 { assert(parsed.dep_paths[i] == "" && parsed.dep_lines[i] == i + 4) }
}

@test fn manifest_strings_decode_basic_escapes_and_preserve_literal_strings() {
    source := "name = \"app\" # package\nroot = \"src/\\u00e5\\U0001F30D.ddr\"\ntest_root = 'tests\\suite.ddr'\n" +
        "[dependencies]\nquoted = { path = \"../a\\\"b\\\\c,#d\" }\n"
    parsed := parse_text("escapes.toml", source, true)
    assert(parsed.ok && parsed.root == "src/å🌍.ddr" && parsed.test_root == "tests\\suite.ddr")
    assert(parsed.dep_paths[0] == "../a\"b\\c,#d")
    escaped := parse_text("escapes.toml", "name='a'\nroot=\"a\\tb\\nc\\rd\\be\\ff\"\n", true)
    assert(escaped.ok && escaped.root == "a\tb\nc\rd\x08e\x0cf")
}

@test fn malformed_dependency_tables_never_publish_a_partial_row() {
    bad: []string = ["{}", "{ git = 'url', path = 'local' }", "{ path = 'local', branch = 'main' }",
        "{ git = 'url', tag = 'v1', branch = 'main' }", "{ git = 'url', rev = 'a', rev = 'b' }",
        "{ git = 'url', git = 'other' }", "{ url = 'url' }", "{ git = '' }", "{ path = '' }",
        "{ git = 'url', tag = '' }", "{ branch = 'main' }", "{ path = 'a'", "{ path = 'a', }",
        "{ path = 'a',, git = 'url' }", "{ path = 'a' git = 'url' }", "{ path = 'a' } trailing",
        "{ git = ['url'] }", "{ git = { path = 'x' } }", "\"a\" trailing", "\"unterminated",
        "\"bad\\q\"", "\"bad\\uD800\"", "\"bad\\UFFFFFFFF\"", "\"bad\\u12\"", "''",
        "{ path = 'local', subdir = 'packages/http' }", "{ git = 'url', subdir = '' }",
        "{ git = 'url', subdir = '/abs' }", "{ git = 'url', subdir = '../escape' }",
        "{ git = 'url', subdir = 'a/../b' }", "{ git = 'url', subdir = '.' }",
        "{ git = 'url', subdir = 'a//b' }", "{ git = 'url', subdir = 'a\\\\b' }",
        "{ git = 'url', subdir = 'a', subdir = 'b' }",
        "{ path = 'a', capabilities = 'network' }", "{ path = 'a', capabilities = ['bogus'] }",
        "{ path = 'a', capabilities = ['network', 'network'] }",
        "{ path = 'a', capabilities = ['network' }", "{ path = 'a', capabilities = ['network'], capabilities = [] }",
        "{ capabilities = ['filesystem'] }"]
    for value in bad {
        parsed := parse_text("bad.toml", "name='app'\nroot='main.ddr'\n[dependencies]\nlib=" + value + "\n", true)
        assert(!parsed.ok && text.starts_with(parsed.error, "bad.toml:4: ") && parsed.dep_names.len == 0 && parsed.dep_paths.len == 0 && parsed.dep_git.len == 0)
    }
    caps_ok := parse_text("caps.toml", "name='app'\nroot='main.ddr'\n[dependencies]\nnet={ path='../net', capabilities=['network', 'unsafe'] }\npure={ path='../pure', capabilities=[] }\ndef='..'\n", true)
    assert(caps_ok.ok && caps_ok.dep_caps.len == 3 && caps_ok.dep_caps[0] == 18 && caps_ok.dep_caps[1] == 0 && caps_ok.dep_caps[2] == 0)
}

@test fn manifest_rejects_duplicate_sections_fields_names_and_missing_roots() {
    assert(valid_dep_name("skrift") && valid_dep_name("_lib_2"))
    for name in ["", "sys", "std", "1lib", "my-lib", "my.lib", "å"] { assert(!valid_dep_name(name)) }
    for source in ["name='a'\nroot='main.ddr'\nname='b'", "name='a'\nroot='main.ddr'\nversion='1'\nversion='2'",
        "name='a'\nroot='main.ddr'\n[unknown]", "name='a'\nroot='main.ddr'\n[dependencies",
        "name='a'\nroot='main.ddr'\n[dependencies]\n[dependencies]",
        "name='a'\nroot='main.ddr'\n[dependencies]\nlib='a'\nlib={git='url'}",
        "name='a'\nroot='main.ddr'\n[dependencies]\nsys='a'", "name='a'\nroot='main.ddr'\n[dependencies]\nmy-lib='a'",
        "name='a'\nroot='main.ddr'\nunknown='b'", "name='bad/name'\nroot='main.ddr'", "name='a'", "root='main.ddr'", ""] {
        parsed := parse_text("invalid.toml", source, true)
        assert(!parsed.ok && text.starts_with(parsed.error, "invalid.toml:") && parsed.error != "")
    }
}

@test fn examples_section_parses_before_and_after_dependencies() {
    after := parse_text("dunder.toml", "name = \"app\"\nroot = \"src/main.ddr\"\n[dependencies]\nkit = \"../kit\"\n[examples]\natlas = \"examples/atlas.ddr\" # primary\nmy-demo_2 = 'examples/\\demo.ddr'\n", true)
    assert(after.ok && after.dep_names.len == 1 && after.example_names.len == 2)
    assert(after.example_names[0] == "atlas" && after.example_paths[0] == "examples/atlas.ddr" && after.example_lines[0] == 6)
    assert(after.example_names[1] == "my-demo_2" && after.example_paths[1] == "examples/\\demo.ddr" && after.example_lines[1] == 7)
    assert(find_example(&after, "atlas") == 0 && find_example(&after, "my-demo_2") == 1 && find_example(&after, "missing") == -1)

    before := parse_text("lib/dunder.toml", "root = 'src/lib.ddr'\n[examples]\n_x = \"examples/\\u00e5.ddr\"\n2d = 'examples/2d.ddr'\n[dependencies]\nhelper = '../helper'\n", false)
    assert(before.ok && before.example_names.len == 2 && before.dep_names.len == 1)
    assert(before.example_names[0] == "_x" && before.example_paths[0] == "examples/å.ddr" && before.example_lines[0] == 3)
    assert(before.example_names[1] == "2d" && before.example_paths[1] == "examples/2d.ddr" && before.example_lines[1] == 4)
}

@test fn example_names_and_malformed_sections_are_validated() {
    for name in ["atlas", "my-demo_2", "2d", "_x"] { assert(valid_example_name(name)) }
    for name in ["", "-flag", "a/b", "..", "a.b", "my demo", "å"] { assert(!valid_example_name(name)) }
    for bad in [
        "name='a'\nroot='main.ddr'\n[examples]\natlas='examples/a.ddr'\n[examples]",
        "name='a'\nroot='main.ddr'\n[examples]\natlas='examples/a.ddr'\natlas='examples/b.ddr'",
        "name='a'\nroot='main.ddr'\n[examples]\n-flag='examples/a.ddr'",
        "name='a'\nroot='main.ddr'\n[examples]\na/b='examples/a.ddr'",
        "name='a'\nroot='main.ddr'\n[examples]\natlas=''",
        "name='a'\nroot='main.ddr'\n[examples]\natlas=examples/a.ddr",
        "name='a'\nroot='main.ddr'\n[examples]\natlas={ path = 'examples/a.ddr' }",
    ] {
        parsed := parse_text("bad_examples.toml", bad, true)
        assert(!parsed.ok && text.starts_with(parsed.error, "bad_examples.toml:") && parsed.example_names.len <= 1)
    }
}

@test fn full_toml_tables_multiline_arrays_and_version_validation() {
    toml_doc := "name = \"app\"\r\nversion = \"1.2.3-beta.1\"\r\nroot = \"\"\"\r\nsrc/main.ddr\"\"\"\r\n" +
        "examples.demo = \"examples/demo.ddr\"\r\n\r\n" +
        "[dependencies.kit]\r\ngit = \"https://example.test/kit.git\"\r\ntag = \"v1.0.0\"\r\n" +
        "capabilities = [\r\n  \"network\",\r\n  \"unsafe\",\r\n]\r\n"
    parsed := parse_text("full.toml", toml_doc, true)
    assert(parsed.ok && parsed.version == "1.2.3-beta.1" && parsed.root == "src/main.ddr")
    assert(parsed.example_names.len == 1 && parsed.example_names[0] == "demo" && parsed.example_lines[0] == 5)
    assert(parsed.dep_names.len == 1 && parsed.dep_names[0] == "kit" && parsed.dep_lines[0] == 7)
    assert(parsed.dep_git[0] == "https://example.test/kit.git" && parsed.dep_kinds[0] == "tag" && parsed.dep_refs[0] == "v1.0.0" && parsed.dep_caps[0] == 18)

    bad_ver := parse_text("bad_ver.toml", "name='a'\nversion=\"1.0\\n\"\nroot='main.ddr'\n", true)
    assert(!bad_ver.ok && text.starts_with(bad_ver.error, "bad_ver.toml:2:"))
}

@test fn unicode_file_paths_keep_their_bytes_and_lines() {
    graph := parse_text("Projekt Å ä ö/dunder.toml", "name = 'program'\nroot = 'äkta.ddr'\n[dependencies]\ncalc = { path = '../Bibliotek Ö' } # åäö\n", true)
    assert(graph.ok && graph.root == "äkta.ddr" && graph.dep_paths[0] == "../Bibliotek Ö" && graph.dep_lines[0] == 4)
}
