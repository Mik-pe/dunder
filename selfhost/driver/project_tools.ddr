capability filesystem

import bundle_fs
import dependencies
import paths
import stderr
import std.fs as fs
import std.text as text
import sys

fn basename(path: string) -> string {
    mut norm := paths.normalize(path)
    while norm.len > 1 && norm[norm.len - 1] == 47 {
        norm = norm[0..norm.len - 1]
    }
    mut last_slash := -1
    for i in 0..norm.len {
        if norm[i] == 47 { last_slash = i }
    }
    if last_slash >= 0 && last_slash + 1 < norm.len {
        return norm[last_slash + 1..norm.len]
    }
    norm
}

fn valid_pkg_name(name: string) -> bool {
    if name == "" || name == "." || name == ".." || name == "sys" || name == "std" {
        return false
    }
    first := name[0]
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) {
        return false
    }
    for i in 1..name.len {
        b := name[i]
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45) {
            return false
        }
    }
    true
}

fn path_exists(path: string) -> bool {
    sys.metadata(path).ok || bundle_fs.is_link(path)
}

fn remove_entry(path: string) -> sys.Status {
    if bundle_fs.is_link(path) { return sys.remove_file(path) }
    info := sys.metadata(path)
    if !info.ok {
        if info.error == 2 { return sys.Status { ok: true, error: 0 } }
        return sys.Status { ok: false, error: info.error }
    }
    if info.is_dir { return fs.remove_all(path) }
    sys.remove_file(path)
}

fn write_checked(path: string, content: string) -> bool {
    st := sys.write_text(path, content)
    if !st.ok {
        _ := stderr.eprint("cannot write " + path + ": " + sys.error_message(st.error))
        return false
    }
    true
}

pub fn run_init() -> i32 {
    mut lib_mode := false
    mut target_arg := ""
    mut i := 2
    while i < sys.arg_count() {
        arg := sys.arg(i)
        if arg == "-h" || arg == "--help" {
            print("usage: dunder init [name] [--lib]")
            return 0
        } else if arg == "--lib" {
            lib_mode = true
        } else if text.starts_with(arg, "-") {
            _ := stderr.eprint("unknown init option: " + arg)
            return 2
        } else if target_arg == "" {
            target_arg = arg
        } else {
            _ := stderr.eprint("unexpected argument for init: " + arg)
            return 2
        }
        i += 1
    }

    mut target_dir := "."
    if target_arg != "" && target_arg != "." {
        target_dir = paths.normalize(target_arg)
        if target_dir == "" { target_dir = "." }
    }

    mut pkg_name := ""
    if target_dir == "." {
        here := fs.cwd()
        if !here.ok {
            _ := stderr.eprint("cannot determine current directory: " + sys.error_message(here.error))
            return 1
        }
        pkg_name = basename(here.value)
    } else {
        pkg_name = basename(target_dir)
    }

    if !valid_pkg_name(pkg_name) {
        _ := stderr.eprint("invalid package name: " + pkg_name)
        return 2
    }

    manifest_path := dependencies.path_in(target_dir, "dunder.toml")
    if path_exists(manifest_path) {
        _ := stderr.eprint("dunder.toml already exists in " + target_dir)
        return 1
    }

    src_dir := dependencies.path_in(target_dir, "src")
    tests_dir := dependencies.path_in(target_dir, "tests")
    entry_rel := if lib_mode { "src/lib.ddr" } else { "src/main.ddr" }
    entry_path := dependencies.path_in(target_dir, entry_rel)
    test_path := dependencies.path_in(target_dir, "tests/suite.ddr")
    gitignore_path := dependencies.path_in(target_dir, ".gitignore")

    if path_exists(entry_path) {
        _ := stderr.eprint("entry file already exists: " + entry_path)
        return 1
    }
    if path_exists(test_path) {
        _ := stderr.eprint("test file already exists: " + test_path)
        return 1
    }

    if target_dir != "." {
        mk_root := fs.mkdir_all(target_dir)
        if !mk_root.ok {
            _ := stderr.eprint("cannot create directory " + target_dir + ": " + sys.error_message(mk_root.error))
            return 1
        }
    }
    mk_src := fs.mkdir_all(src_dir)
    if !mk_src.ok {
        _ := stderr.eprint("cannot create directory " + src_dir + ": " + sys.error_message(mk_src.error))
        return 1
    }
    mk_tests := fs.mkdir_all(tests_dir)
    if !mk_tests.ok {
        _ := stderr.eprint("cannot create directory " + tests_dir + ": " + sys.error_message(mk_tests.error))
        return 1
    }

    manifest_text := "name = \"" + pkg_name + "\"\nversion = \"0.1.0\"\nroot = \"" + entry_rel + "\"\ntest_root = \"tests/suite.ddr\"\n"
    if !write_checked(manifest_path, manifest_text) { return 1 }

    if lib_mode {
        lib_text := "pub fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n"
        lib_test := "import ..src.lib as lib\n\n@test fn basic_add() {\n    assert(lib.add(2, 3) == 5)\n}\n"
        if !write_checked(entry_path, lib_text) { return 1 }
        if !write_checked(test_path, lib_test) { return 1 }
    } else {
        app_text := "pub fn main() {\n    print(\"Hello from " + pkg_name + "!\")\n}\n"
        app_test := "@test fn smoke() {\n    assert(1 + 1 == 2)\n}\n"
        if !write_checked(entry_path, app_text) { return 1 }
        if !write_checked(test_path, app_test) { return 1 }
    }

    if !path_exists(gitignore_path) {
        if !write_checked(gitignore_path, "build/\n") { return 1 }
    }

    kind := if lib_mode { "library" } else { "binary" }
    print("initialized " + kind + " package " + pkg_name + " in " + target_dir)
    0
}

pub fn run_clean() -> i32 {
    mut clean_all := false
    mut i := 2
    while i < sys.arg_count() {
        arg := sys.arg(i)
        if arg == "-h" || arg == "--help" {
            print("usage: dunder clean [--all]")
            return 0
        } else if arg == "--all" {
            clean_all = true
        } else {
            _ := stderr.eprint("unknown clean option: " + arg)
            return 2
        }
        i += 1
    }

    mut project_root := dependencies.find_manifest_dir(".")
    if project_root == "" { project_root = "." }
    build_dir := dependencies.path_in(project_root, "build")
    if !path_exists(build_dir) {
        print("clean: nothing to remove")
        return 0
    }

    if bundle_fs.is_link(build_dir) || !sys.metadata(build_dir).is_dir {
        st := remove_entry(build_dir)
        if !st.ok {
            _ := stderr.eprint("cannot remove " + build_dir + ": " + sys.error_message(st.error))
            return 1
        }
        print("cleaned " + build_dir)
        return 0
    }

    cache_dir := dependencies.path_in(build_dir, ".dunder")
    if clean_all || !path_exists(cache_dir) {
        st := fs.remove_all(build_dir)
        if !st.ok {
            _ := stderr.eprint("cannot remove " + build_dir + ": " + sys.error_message(st.error))
            return 1
        }
        print("cleaned " + build_dir)
        return 0
    }

    listing := bundle_fs.entries(build_dir)
    if listing.error != "" {
        _ := stderr.eprint("cannot inspect " + build_dir + ": " + listing.error)
        return 1
    }
    mut removed := 0
    for name in &listing.paths {
        if name == "" || name == "." || name == ".." || name == ".dunder" { continue }
        child := dependencies.path_in(build_dir, name)
        st := remove_entry(child)
        if !st.ok {
            _ := stderr.eprint("cannot remove " + child + ": " + sys.error_message(st.error))
            return 1
        }
        removed += 1
    }
    if removed == 0 {
        print("clean: nothing to remove (preserved build/.dunder)")
    } else {
        print("cleaned " + build_dir + " (preserved build/.dunder)")
    }
    0
}
