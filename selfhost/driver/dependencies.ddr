capability filesystem
import sys
import std.text as text
import cache_io
import manifest
import paths
import git_dependencies as git

pub struct Graph {
    ok: bool, error: string,
    pkg_dirs: []string, pkg_entries: []string, pkg_caps: []i32, pkg_labels: []string,
    pkg_native_lib_starts: []i32, pkg_native_lib_counts: []i32, pkg_native_libs: []string, pkg_native_lib_unrestricted: []bool,
    edge_owners: []i32, edge_names: []string, edge_targets: []i32,
}
pub fn empty_graph() -> Graph {
    Graph {
        ok: true, error: "",
        pkg_dirs: [""], pkg_entries: [""], pkg_caps: [31], pkg_labels: [""],
        pkg_native_lib_starts: [0], pkg_native_lib_counts: [0], pkg_native_libs: [], pkg_native_lib_unrestricted: [true],
        edge_owners: [], edge_names: [], edge_targets: [],
    }
}
fn list_contains(list: &[]string, target: string) -> bool {
    for item in &list {
        if item == target { return true }
    }
    false
}
fn intersect_native_libs(a_unr: bool, a_libs: &[]string, b_unr: bool, b_libs: &[]string, out_unr: &mut bool) -> []string {
    if a_unr && b_unr { out_unr = true; return [] }
    out_unr = false
    if a_unr { return b_libs.clone() }
    if b_unr { return a_libs.clone() }
    mut out: []string = []
    for item in &a_libs {
        if list_contains(&b_libs, item) { out.push(item.clone()) }
    }
    out
}
pub fn pkg_native_libs_for(graph: &Graph, pkg_id: i32) -> []string {
    mut out: []string = []
    if pkg_id < 0 || pkg_id >= graph.pkg_native_lib_starts.len { return out }
    start := graph.pkg_native_lib_starts[pkg_id]
    count := graph.pkg_native_lib_counts[pkg_id]
    for i in start..start + count { out.push(graph.pkg_native_libs[i].clone()) }
    out
}
pub fn pkg_allows_native_lib(graph: &Graph, pkg_id: i32, lib: string) -> bool {
    if pkg_id <= 0 || pkg_id >= graph.pkg_native_lib_unrestricted.len { return true }
    if graph.pkg_native_lib_unrestricted[pkg_id] { return true }
    start := graph.pkg_native_lib_starts[pkg_id]
    count := graph.pkg_native_lib_counts[pkg_id]
    for i in start..start + count {
        if graph.pkg_native_libs[i] == "*" || graph.pkg_native_libs[i] == lib { return true }
    }
    false
}
fn set_pkg_native_libs(graph: &mut Graph, pkg_id: i32, unrestricted: bool, libs: &[]string) {
    start := graph.pkg_native_libs.len
    if !unrestricted {
        for item in &libs { graph.pkg_native_libs.push(item.clone()) }
    }
    count := graph.pkg_native_libs.len - start
    if pkg_id == graph.pkg_native_lib_starts.len {
        graph.pkg_native_lib_starts.push(start)
        graph.pkg_native_lib_counts.push(count)
        graph.pkg_native_lib_unrestricted.push(unrestricted)
    } else {
        graph.pkg_native_lib_starts[pkg_id] = start
        graph.pkg_native_lib_counts[pkg_id] = count
        graph.pkg_native_lib_unrestricted[pkg_id] = unrestricted
    }
}
fn native_libs_subset(sub_unr: bool, sub_libs: &[]string, sup_unr: bool, sup_libs: &[]string) -> bool {
    if sup_unr { return true }
    if sub_unr { return false }
    for item in &sub_libs {
        if !list_contains(&sup_libs, item) { return false }
    }
    true
}
struct Walk {
    active: []i32,
    directories: []sys.Metadata,
    pkg_direct: []bool,
    visited_pkgs: []i32,
    visited_boundaries: []string,
    visited_caps: []i32,
    visited_nlib_unr: []bool,
    visited_nlib_starts: []i32,
    visited_nlib_counts: []i32,
    visited_nlibs: []string,
}

pub fn dir_of(path: string) -> string { paths.parent(path) }

fn strip_trailing_slashes(path: string) -> string {
    mut end := path.len
    while end > 1 && path[end - 1] == 47 && !(end == 3 && path[1] == 58) { end = end - 1 }
    if end == path.len { return path.clone() }
    path[0..end]
}

pub fn path_in(dir: string, child: string) -> string {
    mut rel := strip_trailing_slashes(paths.join("", child))
    if paths.is_absolute(rel) { return rel }
    while text.starts_with(rel, "./") && rel.len > 2 {
        rel = rel[2..rel.len]
    }
    base := strip_trailing_slashes(dir)
    if base == "." || base == "" { return rel }
    if rel == "." { return base }
    paths.join(base, rel)
}

fn clean_existing_path(path: string) -> string {
    norm := paths.normalize(path)
    if norm != path && sys.same_file(norm, path) { return norm }
    strip_trailing_slashes(path)
}

pub fn find_manifest_dir(start: string) -> string {
    empty: []string = []
    clean_existing_path(manifest.package_dir(start, &empty, &empty))
}


fn contained(path: string, boundary: string) -> bool {
    if boundary == "" { return true }
    canonical := cache_io.root(path)
    canonical != "" && (canonical == boundary || text.starts_with(canonical, boundary + "/"))
}

fn add_edge(graph: &mut Graph, owner_pkg: i32, dep_name: string, target_pkg: i32) {
    for i in 0..graph.edge_owners.len {
        if graph.edge_owners[i] == owner_pkg && graph.edge_names[i] == dep_name {
            graph.edge_targets[i] = target_pkg
            return
        }
    }
    graph.edge_owners.push(owner_pkg)
    graph.edge_names.push(dep_name.clone())
    graph.edge_targets.push(target_pkg)
}

fn visit(owner_pkg: i32, project_dir: string, toml_path: string, parsed: &manifest.Manifest, boundary: string,
    parent_cap: i32, parent_nlib_unr: bool, parent_nlibs: &[]string, graph: &mut Graph, store: &mut git.Store, walk: &mut Walk) {
    for i in 0..parsed.dep_names.len {
        location := toml_path + ":" + parsed.dep_lines[i].str() + ": "
        dep_name := parsed.dep_names[i].clone()
        eff_cap := parent_cap.bit_and(parsed.dep_caps[i])
        raw_edge_nlibs := manifest.dep_native_libs_for(&parsed, i)
        edge_nlib_unr := list_contains(&raw_edge_nlibs, "*")
        mut eff_nlib_unr := false
        eff_nlibs := intersect_native_libs(parent_nlib_unr, &parent_nlibs, edge_nlib_unr, &raw_edge_nlibs, &mut eff_nlib_unr)
        mut dep_path := ""
        mut dep_boundary := boundary.clone()
        if parsed.dep_git[i] != "" {
            dep_path = git.checkout(&mut store, parsed.dep_git[i], parsed.dep_kinds[i], parsed.dep_refs[i])
            if !store.ok { graph.error = location + store.error; return }
            dep_boundary = cache_io.root(dep_path)
            if dep_boundary == "" { graph.error = location + "Git dependency checkout not found: " + dep_name; return }
            if parsed.dep_subdirs[i] != "" {
                dep_path = clean_existing_path(path_in(dep_path, parsed.dep_subdirs[i]))
            }
        } else { dep_path = clean_existing_path(path_in(project_dir, parsed.dep_paths[i])) }
        directory := sys.metadata(dep_path)
        if !directory.is_dir {
            graph.error = location + "dependency directory not found: " + dep_path; return
        }
        if !contained(dep_path, dep_boundary) {
            graph.error = location + "dependency path escapes its Git checkout: " + dep_path; return
        }
        for k in 0..walk.active.len {
            active := &walk.directories[walk.active[k]]
            if active.dev == directory.dev && active.ino == directory.ino {
                graph.error = location + "dependency cycle involving '" + dep_name + "'"; return
            }
        }
        if walk.active.len >= 256 { graph.error = location + "dependency graph exceeds 256 nested packages"; return }
        mut dep_entry := ""
        mut has_sub := false
        mut sub := manifest.empty()
        dep_toml := path_in(dep_path, "dunder.toml")
        if sys.metadata(dep_toml).is_file {
            if !contained(dep_toml, dep_boundary) {
                graph.error = location + "dependency manifest escapes its Git checkout: " + dep_toml; return
            }
            sub = manifest.parse(dep_toml, false)
            if !sub.ok { graph.error = sub.error; return }
            dep_entry = clean_existing_path(path_in(dep_path, sub.root))
            dep_dir := clean_existing_path(dir_of(dep_entry))
            if !sys.metadata(dep_dir).is_dir {
                graph.error = dep_toml + ": dependency root directory not found: " + dep_dir; return
            }
            if !contained(dep_dir, dep_boundary) || (sys.metadata(dep_entry).is_file && !contained(dep_entry, dep_boundary)) {
                graph.error = dep_toml + ": dependency root escapes its Git checkout: " + dep_entry; return
            }
            has_sub = true
        }
        mut target_pkg := -1
        for k in 1..graph.pkg_dirs.len {
            known := &walk.directories[k]
            if known.dev == directory.dev && known.ino == directory.ino { target_pkg = k; break }
        }
        is_root := owner_pkg == 0
        if target_pkg >= 0 {
            if is_root {
                graph.pkg_caps[target_pkg] = eff_cap
                set_pkg_native_libs(&mut graph, target_pkg, eff_nlib_unr, &eff_nlibs)
                walk.pkg_direct[target_pkg] = true
            } else if !walk.pkg_direct[target_pkg] {
                graph.pkg_caps[target_pkg] = graph.pkg_caps[target_pkg].bit_and(eff_cap)
                prev_unr := graph.pkg_native_lib_unrestricted[target_pkg]
                prev_libs := pkg_native_libs_for(&graph, target_pkg)
                mut merged_unr := false
                merged_libs := intersect_native_libs(prev_unr, &prev_libs, eff_nlib_unr, &eff_nlibs, &mut merged_unr)
                set_pkg_native_libs(&mut graph, target_pkg, merged_unr, &merged_libs)
            }
        } else {
            target_pkg = graph.pkg_dirs.len
            walk.directories.push(directory)
            graph.pkg_dirs.push(dep_path.clone())
            graph.pkg_entries.push(move dep_entry)
            graph.pkg_caps.push(eff_cap)
            graph.pkg_labels.push(dep_name.clone())
            set_pkg_native_libs(&mut graph, target_pkg, eff_nlib_unr, &eff_nlibs)
            walk.pkg_direct.push(is_root)
        }
        add_edge(&mut graph, owner_pkg, dep_name.clone(), target_pkg)
        if has_sub && sub.dep_names.len > 0 {
            pkg_cap := graph.pkg_caps[target_pkg]
            pkg_nlib_unr := graph.pkg_native_lib_unrestricted[target_pkg]
            pkg_nlibs := pkg_native_libs_for(&graph, target_pkg)
            mut validated := false
            for k in 0..walk.visited_pkgs.len {
                if walk.visited_pkgs[k] == target_pkg && walk.visited_boundaries[k] == dep_boundary &&
                   walk.visited_caps[k].bit_and(pkg_cap) == walk.visited_caps[k] {
                    mut v_libs: []string = []
                    v_start := walk.visited_nlib_starts[k]
                    for j in v_start..v_start + walk.visited_nlib_counts[k] { v_libs.push(walk.visited_nlibs[j].clone()) }
                    if native_libs_subset(walk.visited_nlib_unr[k], &v_libs, pkg_nlib_unr, &pkg_nlibs) {
                        validated = true; break
                    }
                }
            }
            if !validated {
                walk.visited_pkgs.push(target_pkg)
                walk.visited_boundaries.push(dep_boundary.clone())
                walk.visited_caps.push(pkg_cap)
                walk.visited_nlib_unr.push(pkg_nlib_unr)
                vstart := walk.visited_nlibs.len
                if !pkg_nlib_unr {
                    for item in &pkg_nlibs { walk.visited_nlibs.push(item.clone()) }
                }
                walk.visited_nlib_starts.push(vstart)
                walk.visited_nlib_counts.push(walk.visited_nlibs.len - vstart)
                walk.active.push(target_pkg)
                visit(target_pkg, dep_path, dep_toml, &sub, dep_boundary, pkg_cap, pkg_nlib_unr, &pkg_nlibs, &mut graph, &mut store, &mut walk)
                _ := walk.active.pop()
                if graph.error != "" { return }
            }
        }
    }
}

pub fn resolve(project_dir: string, toml_path: string, parsed: &manifest.Manifest,
    offline: bool, locked: bool, update: bool, host: i32) -> Graph {
    mut graph := empty_graph()
    graph.pkg_dirs[0] = project_dir.clone()
    graph.ok = false
    mut store := git.open(project_dir, offline, locked, update, host)
    if !store.ok { graph.error = store.error.clone(); git.abort(&mut store); return graph }
    mut walk := Walk {
        active: [0], directories: [sys.metadata(project_dir)],
        pkg_direct: [true],
        visited_pkgs: [],
        visited_boundaries: [],
        visited_caps: [],
        visited_nlib_unr: [],
        visited_nlib_starts: [],
        visited_nlib_counts: [],
        visited_nlibs: [],
    }
    empty_libs: []string = []
    visit(0, project_dir, toml_path, &parsed, "", 31, true, &empty_libs, &mut graph, &mut store, &mut walk)
    if graph.error != "" { git.abort(&mut store); return graph }
    if !git.finish(&mut store) { graph.error = store.error.clone(); git.abort(&mut store); return graph }
    graph.ok = true; graph
}

@test fn dependency_paths_keep_relative_and_absolute_roots() {
    assert(dir_of("src/main.ddr") == "src")
    assert(dir_of("main.ddr") == ".")
    assert(dir_of("/main.ddr") == "/")
    assert(path_in(".", "../dunder-skrift/") == "../dunder-skrift")
    assert(path_in("..", "./src/main.ddr") == "../src/main.ddr")
    assert(paths.normalize("../depA/../depB") == "../depB")
    assert(paths.normalize("src/..") == ".")
    assert(path_in("C:/arbete", "D:/paket/källkod/") == "D:/paket/källkod")
    assert(path_in("C:/", "projekt med mellanslag") == "C:/projekt med mellanslag")
    assert(dir_of("C:/main.ddr") == "C:/")
    assert(path_in("C:/arbete", "//server/share/dep") == "//server/share/dep")
}
