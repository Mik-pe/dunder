capability filesystem, unsafe

import agent
import cli
import dependencies
import fmt
import json_compat as jcompat
import lsp_positions as positions
import manifest
import modules
import paths
import ..frontend.ast as ast
import ..frontend.compile as compiler
import ..frontend.diagnostics as diag
import ..frontend.lexer
import ..frontend.parser as parser
import std.bytes as bytes
import ...stdlib.bytes.utf8 as utf8
import std.fs as fs
import std.json as json
import std.parse as parse
import std.text as text
import sys

@link(macos = "c", linux = "c")
extern "C" {
    @link_name("read") fn read_fd(fd: i32, buf: ptr, count: usize) -> i64
    @link_name("write") fn write_fd(fd: i32, buf: ptr, count: usize) -> i64
}

@link(windows = "msvcrt")
extern "C" {
    @link_name("_setmode") fn set_mode(fd: i32, mode: i32) -> i32
    @link_name("_read") fn win_read(fd: i32, buf: ptr, count: u32) -> i32
    @link_name("_write") fn win_write(fd: i32, buf: ptr, count: u32) -> i32
}

unsafe fn frame_read(buffer: ptr, count: i32) -> i64 {
    if target_is("macos") { return read_fd(0, buffer, usize(count)) }
    else if target_is("linux") { return read_fd(0, buffer, usize(count)) }
    else { return i64(win_read(0, buffer, u32(count))) }
}

unsafe fn frame_write(buffer: ptr, count: i32) -> i64 {
    if target_is("macos") { return write_fd(1, buffer, usize(count)) }
    else if target_is("linux") { return write_fd(1, buffer, usize(count)) }
    else { return i64(win_write(1, buffer, u32(count))) }
}

struct FrameRead {
    ok: bool,
    eof: bool,
    waiting: bool,
    body: string,
}

struct HeaderSplit {
    found: bool,
    header_end: i32,
    body_start: i32,
}

struct WordInfo {
    start: i32,
    end: i32,
    word: string,
    qualifier: string,
    has_dot: bool,
}

struct Binding {
    name: string,
    type_name: string,
    module: i32,
    start: i32,
}

struct TypeLocation { module: i32, name: string }

struct ConfigInput {
    path: string,
    present: bool,
    text: string,
}

struct Analysis {
    path: string,
    project_dir: string,
    config_inputs: []ConfigInput,
    loaded: modules.Loaded,
    root: ast.Module,
    lines: positions.LineIndex,
    bindings: []Binding,
    diagnostics: []diag.Diagnostic,
}

enum CompletionScope { Plain, Dot, Static }

struct CompletionContext {
    scope: CompletionScope,
    qualifier: string,
    prefix: string,
    start: i32,
    end: i32,
}

struct CompletionEntry {
    label: string,
    kind: i32,
    detail: string,
    priority: i32,
}

struct DiagnosticSnapshot {
    inputs: []string,
    items: []diag.Diagnostic,
    loaded: bool,
}

struct State {
    default_target: i32,
    root_path: string,
    encoding: positions.Encoding,
    versioned_diagnostics: bool,
    doc_paths: []string,
    doc_uris: []string,
    doc_texts: []string,
    doc_versions: []Option<i64>,
    snapshots: []DiagnosticSnapshot,
    analysis: []Analysis,
    shutting_down: bool,
}

fn new_state(default_target: i32) -> State {
    State {
        default_target: default_target,
        root_path: "",
        encoding: .Utf16,
        versioned_diagnostics: false,
        doc_paths: [],
        doc_uris: [],
        doc_texts: [],
        doc_versions: [],
        snapshots: [],
        analysis: [],
        shutting_down: false,
    }
}

fn write_all_stdout(data: &[]u8) -> bool {
    mut off := 0
    mut retries := 0
    unsafe {
        while off < data.len {
            wrote := frame_write(addr(&data[off]), data.len - off)
            if wrote > 0 {
                off += i32(wrote)
                retries = 0
            } else if wrote < 0 {
                retries += 1
                if retries > 64 { return false }
            } else {
                return false
            }
        }
    }
    true
}

fn send_json(body: string) {
    mut body_bytes: []u8 = []
    bytes.append_utf8(&mut body_bytes, body)
    header := "Content-Length: " + body_bytes.len.str() + "\r\n\r\n"
    mut frame: []u8 = []
    frame.reserve(header.len + body_bytes.len)
    bytes.append_utf8(&mut frame, header)
    bytes.extend(&mut frame, &body_bytes)
    _ := write_all_stdout(&frame)
}

fn find_header_end(buf: &[]u8) -> HeaderSplit {
    mut i := 0
    while i + 3 < buf.len {
        if buf[i] == 13 && buf[i + 1] == 10 && buf[i + 2] == 13 && buf[i + 3] == 10 {
            return HeaderSplit { found: true, header_end: i, body_start: i + 4 }
        }
        i += 1
    }
    mut j := 0
    while j + 1 < buf.len {
        if buf[j] == 10 && buf[j + 1] == 10 {
            return HeaderSplit { found: true, header_end: j, body_start: j + 2 }
        }
        j += 1
    }
    HeaderSplit { found: false, header_end: -1, body_start: -1 }
}

fn ascii_ieq(a: string, b: string) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len {
        mut ca := a[i]
        mut cb := b[i]
        if ca >= 65 && ca <= 90 { ca += 32 }
        if cb >= 65 && cb <= 90 { cb += 32 }
        if ca != cb { return false }
    }
    true
}

fn parse_content_length(header_text: string) -> i32 {
    mut line_start := 0
    while line_start <= header_text.len {
        mut line_end := line_start
        while line_end < header_text.len && header_text[line_end] != 10 { line_end += 1 }
        mut trimmed_end := line_end
        if trimmed_end > line_start && header_text[trimmed_end - 1] == 13 { trimmed_end -= 1 }
        line := header_text[line_start..trimmed_end]
        mut colon := -1
        for k in 0..line.len {
            if line[k] == 58 { colon = k; break }
        }
        if colon > 0 {
            key := text.trim(line[0..colon])
            if ascii_ieq(key, "content-length") {
                val := text.trim(line[(colon + 1)..line.len])
                parsed := parse.integer(val)
                if parsed.ok && parsed.value >= 0 { return i32(parsed.value) }
            }
        }
        if line_end >= header_text.len { break }
        line_start = line_end + 1
    }
    -1
}

fn read_more_stdin(rx: &mut []u8) -> i32 {
    mut chunk: [u8; 4096] = [0; 4096]
    mut retries := 0
    unsafe {
        while true {
            n := frame_read(addr(&mut chunk[0]), 4096)
            if n > 0 {
                count := i32(n)
                for k in 0..count { rx.push(chunk[k]) }
                return count
            }
            if n == 0 { return 0 }
            retries += 1
            if retries > 64 { return -1 }
        }
    }
    -1
}

fn drop_prefix(rx: &mut []u8, count: i32) {
    if count >= rx.len {
        rx.clear()
        return
    }
    mut rest: []u8 = []
    rest.reserve(rx.len - count)
    for k in count..rx.len { rest.push(rx[k]) }
    rx = move rest
}

fn read_ready_stdin(rx: &mut []u8, wait: bool) -> i32 {
    if !wait {
        mut fd: []u8 = [0, 0, 0, 0, 1, 0, 0, 0]
        unsafe { if sys.fd_poll(&mut fd, 1, 0) <= 0 { return -2 } }
    }
    read_more_stdin(&mut rx)
}

fn read_frame(rx: &mut []u8, wait: bool) -> FrameRead {
    while true {
        split := find_header_end(&rx)
        if !split.found {
            n := read_ready_stdin(&mut rx, wait)
            if n == -2 { return FrameRead { ok: false, eof: false, waiting: true, body: "" } }
            if n <= 0 { return FrameRead { ok: false, eof: true, waiting: false, body: "" } }
            continue
        }
        hdr := match utf8.decode_range(&rx, 0, split.header_end) { .Ok(value) => value, .Err(_) => "" }
        content_len := parse_content_length(hdr)
        if content_len < 0 {
            drop_prefix(&mut rx, split.body_start)
            return FrameRead { ok: false, eof: false, waiting: false, body: "" }
        }
        needed := split.body_start + content_len
        while rx.len < needed {
            n := read_ready_stdin(&mut rx, wait)
            if n == -2 { return FrameRead { ok: false, eof: false, waiting: true, body: "" } }
            if n <= 0 { return FrameRead { ok: false, eof: true, waiting: false, body: "" } }
        }
        decoded := utf8.decode_range(&rx, split.body_start, needed)
        drop_prefix(&mut rx, needed)
        return match move decoded {
            .Ok(body) => FrameRead { ok: true, eof: false, waiting: false, body: body },
            .Err(_) => FrameRead { ok: false, eof: false, waiting: false, body: "" },
        }
    }
    FrameRead { ok: false, eof: true, waiting: false, body: "" }
}

fn hex_digit(b: i32) -> i32 {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 }
    if b >= 97 && b <= 102 { return b - 87 }
    -1
}

fn uri_to_path(uri: string) -> string {
    mut raw := uri.clone()
    if text.starts_with(raw, "file://localhost/") {
        raw = raw[16..raw.len]
    } else if text.starts_with(raw, "file:///") {
        raw = raw[7..raw.len]
    } else if text.starts_with(raw, "file://") {
        raw = raw[5..raw.len]
    }
    mut out: []u8 = []
    out.reserve(raw.len)
    mut i := 0
    while i < raw.len {
        if raw[i] == 37 && i + 2 < raw.len {
            hi := hex_digit(i32(raw[i + 1]))
            lo := hex_digit(i32(raw[i + 2]))
            if hi >= 0 && lo >= 0 {
                out.push(u8(hi * 16 + lo))
                i += 3
                continue
            }
        }
        out.push(u8(raw[i]))
        i += 1
    }
    decoded := match utf8.decode(&out) { .Ok(value) => value, .Err(_) => "" }
    if decoded.len >= 4 && decoded[0] == 47 && decoded[2] == 58 && paths.is_absolute(decoded[1..decoded.len]) {
        return paths.normalize(decoded[1..decoded.len])
    }
    paths.normalize(decoded)
}

fn should_keep_uri_byte(b: i32) -> bool {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) ||
        b == 45 || b == 46 || b == 95 || b == 126 || b == 47 || b == 58
}

fn path_to_uri(state: &State, path: string) -> string {
    norm := paths.normalize(path)
    for i in 0..state.doc_paths.len {
        if state.doc_paths[i] == norm || state.doc_paths[i] == path || sys.same_file(state.doc_paths[i], path) {
            return state.doc_uris[i].clone()
        }
    }
    mut abs := norm.clone()
    if !paths.is_absolute(abs) {
        rp := fs.realpath(norm)
        if rp.ok { abs = paths.normalize(rp.value) }
        else {
            wd := fs.cwd()
            if wd.ok { abs = paths.normalize(wd.value + "/" + norm) }
        }
    }
    hex := "0123456789ABCDEF"
    mut out: []u8 = []
    prefix := if text.starts_with(abs, "//") { "file:" } else if abs.len >= 3 && abs[1] == 58 { "file:///" } else { "file://" }
    bytes.append_utf8(&mut out, prefix)
    for b in abs.bytes() {
        if should_keep_uri_byte(i32(b)) {
            out.push(u8(b))
        } else {
            out.push(37)
            out.push(u8(hex[i32(b) / 16]))
            out.push(u8(hex[i32(b) % 16]))
        }
    }
    match utf8.decode(&out) { .Ok(value) => value, .Err(_) => "" }
}

fn find_doc_index(state: &State, path: string) -> i32 {
    norm := paths.normalize(path)
    for i in 0..state.doc_paths.len {
        if state.doc_paths[i] == norm || state.doc_paths[i] == path || sys.same_file(state.doc_paths[i], path) {
            return i
        }
    }
    -1
}

fn set_doc(state: &mut State, uri: string, text_val: string, version: Option<i64>) -> string {
    path := uri_to_path(uri)
    idx := find_doc_index(&state, path)
    if idx >= 0 {
        state.doc_uris[idx] = uri.clone()
        state.doc_texts[idx] = text_val.clone()
        state.doc_versions[idx] = version
        return state.doc_paths[idx].clone()
    }
    state.snapshots.push(DiagnosticSnapshot { inputs: [], items: [], loaded: false })
    state.doc_paths.push(path.clone())
    state.doc_uris.push(uri.clone())
    state.doc_texts.push(text_val.clone())
    state.doc_versions.push(version)
    path
}

fn remove_doc(state: &mut State, uri: string) -> string {
    path := uri_to_path(uri)
    idx := find_doc_index(&state, path)
    if idx < 0 { return path }
    removed := state.doc_paths[idx].clone()
    _ := state.doc_paths.remove(idx)
    _ := state.doc_uris.remove(idx)
    _ := state.doc_texts.remove(idx)
    _ := state.doc_versions.remove(idx)
    _ := state.snapshots.remove(idx)
    removed
}

fn read_position(doc: &json.Doc, node: i32, lines: &positions.LineIndex, encoding: positions.Encoding) -> i32 {
    line := jcompat.get_i64(&doc, node, "line")
    column := jcompat.get_i64(&doc, node, "character")
    if !line.ok || !column.ok { return -1 }
    positions.offset(&lines, line.value, column.value, encoding)
}

fn write_pos(w: &mut json.Writer, pos: &positions.Position) {
    w.object()
    w.key("line"); w.integer(i64(pos.line))
    w.key("character"); w.integer(i64(pos.character))
    w.end()
}

fn write_range(w: &mut json.Writer, lines: &positions.LineIndex, encoding: positions.Encoding, start_off: i32, end_off: i32) {
    start := if start_off >= 0 { start_off } else { 0 }
    end := if end_off >= start { end_off } else { start }
    sp := positions.position(&lines, start, encoding)
    ep := positions.position(&lines, end, encoding)
    w.object()
    w.key("start"); write_pos(&mut w, &sp)
    w.key("end"); write_pos(&mut w, &ep)
    w.end()
}

fn write_location(w: &mut json.Writer, state: &State, path: string, source: string, start_off: i32, end_off: i32) {
    w.object()
    w.key("uri"); w.string(path_to_uri(&state, path))
    lines := positions.index(source)
    w.key("range"); write_range(&mut w, &lines, state.encoding, start_off, end_off)
    w.end()
}

fn write_rpc_id(w: &mut json.Writer, doc: &json.Doc, id_node: i32) {
    k := doc.kind(id_node)
    if k == .Number {
        int_val := jcompat.as_i64(&doc, id_node)
        if int_val.ok { w.integer(int_val.value); return }
        flt_val := jcompat.as_f64(&doc, id_node)
        if flt_val.ok { w.decimal(flt_val.value); return }
        w.null()
    } else if k == .String {
        w.string(jcompat.as_str(&doc, id_node).value)
    } else {
        w.null()
    }
}

fn send_error(doc: &json.Doc, id_node: i32, code: i64, message: string) {
    mut w := json.Writer::new()
    w.object()
    w.key("jsonrpc"); w.string("2.0")
    w.key("id"); write_rpc_id(&mut w, &doc, id_node)
    w.key("error"); w.object()
    w.key("code"); w.integer(code)
    w.key("message"); w.string(message)
    w.end(); w.end()
    res := jcompat.writer_finish(&w)
    if res.ok { send_json(res.value) }
}

fn send_null_result(doc: &json.Doc, id_node: i32) {
    mut w := json.Writer::new()
    w.object()
    w.key("jsonrpc"); w.string("2.0")
    w.key("id"); write_rpc_id(&mut w, &doc, id_node)
    w.key("result"); w.null()
    w.end()
    res := jcompat.writer_finish(&w)
    if res.ok { send_json(res.value) }
}

fn project_dir(state: &State, doc_path: string) -> string {
    mut directory := dependencies.dir_of(doc_path)
    if directory == "" || !sys.metadata(directory).is_dir {
        if state.root_path != "" && sys.metadata(state.root_path).is_dir {
            directory = state.root_path.clone()
        }
    }
    dependencies.find_manifest_dir(directory)
}

fn config_input(path: string) -> ConfigInput {
    read := sys.read_text(path)
    ConfigInput { path: path.clone(), present: read.ok, text: read.value }
}

fn resolve_dep_graph(state: &State, directory: string, inputs: &mut []ConfigInput) -> modules.DepGraph {
    if directory == "" { return modules.empty_deps() }
    toml_path := dependencies.path_in(directory, "dunder.toml")
    inputs.push(config_input(toml_path))
    inputs.push(config_input(dependencies.path_in(directory, "dunder.lock")))
    if !inputs[0].present { return modules.empty_deps() }
    parsed := manifest.parse(toml_path, true)
    if !parsed.ok { return modules.empty_deps() }
    graph := dependencies.resolve(directory, toml_path, &parsed, true, true, false, state.default_target)
    if !graph.ok { return modules.empty_deps() }
    for i in 1..graph.pkg_dirs.len {
        inputs.push(config_input(dependencies.path_in(graph.pkg_dirs[i], "dunder.toml")))
    }
    modules.DepGraph {
        pkg_dirs: graph.pkg_dirs,
        pkg_entries: graph.pkg_entries,
        pkg_caps: graph.pkg_caps,
        pkg_labels: graph.pkg_labels,
        edge_owners: graph.edge_owners,
        edge_names: graph.edge_names,
        edge_targets: graph.edge_targets,
    }
}

fn binding_module(raw_type: string, loaded: &modules.Loaded) -> i32 {
    name := base_type_name(raw_type)
    prefix := "__dunder_module_"
    if !text.starts_with(name, prefix) { return -1 }
    id := parse.integer(name[prefix.len..name.len])
    if !id.ok || id.value < 0 || id.value >= i64(loaded.symbol_owners.len) { return -1 }
    loaded.symbol_owners[i32(id.value)]
}

fn build_analysis(state: &State, doc_path: string, directory: string) -> Analysis {
    mut inputs: []ConfigInput = []
    dep_graph := resolve_dep_graph(&state, directory, &mut inputs)
    mut lexing := modules.serial_lexing()
    lexing.symbol_owners = true
    mut session := compiler.new_session()
    mut loaded := compiler.load_group_with_overlays_into(&mut session, doc_path, .Check, -1, false,
        &dep_graph, &lexing, &state.doc_paths, &state.doc_texts)
    source := source_for(&state, &loaded, doc_path)
    root := parser.parse_source(doc_path, source)
    lines := positions.index(source)
    mut bindings: []Binding = []
    mut items: []diag.Diagnostic = []
    if loaded.ok {
        mut records := compiler.bindings()
        mut config := compiler.configuration()
        config.workers = 1
        result := compiler.compile_loaded(&mut session, state.default_target, &loaded.map_starts, &loaded.map_files,
            true, true, &mut records, "", "", &config)
        items = agent.resolve_compiler_diagnostics(&loaded, &result)
        for i in 0..records.offsets.len {
            loc := modules.location(&loaded, records.offsets[i])
            if loc.path == loaded.paths[0] {
                bindings.push(Binding { name: records.names[i].clone(),
                    type_name: agent.public_name(records.types[i], &loaded.symbols),
                    module: binding_module(records.types[i], &loaded), start: loc.offset })
            }
        }
    } else {
        items = agent.resolve_loader_diagnostics(&loaded)
    }
    // Only the source-level data survives the compiler session.
    loaded.map_starts = []
    loaded.map_files = []
    loaded.map_offsets = []
    loaded.symbols = []
    loaded.symbol_owners = []
    Analysis { path: doc_path.clone(), project_dir: directory.clone(), config_inputs: inputs,
        loaded: loaded, root: root, lines: lines, bindings: bindings, diagnostics: items }
}

fn analysis_is_current(state: &State, analysis: &Analysis, path: string, directory: string) -> bool {
    if analysis.path != path || analysis.project_dir != directory || !analysis.loaded.ok { return false }
    for input in &analysis.config_inputs {
        current := sys.read_text(input.path)
        if current.ok != input.present || current.value != input.text { return false }
    }
    for i in 0..analysis.loaded.paths.len {
        module_path := analysis.loaded.paths[i].clone()
        if !is_real_module_path(module_path) { continue }
        idx := find_doc_index(&state, module_path)
        if idx >= 0 {
            if state.doc_texts[idx] != analysis.loaded.sources[i] { return false }
        } else {
            disk := sys.read_text(module_path)
            if !disk.ok || disk.value != analysis.loaded.sources[i] { return false }
        }
    }
    true
}

fn prepare_analysis(state: &mut State, path: string) {
    directory := project_dir(&state, path)
    if state.analysis.len > 0 && analysis_is_current(&state, &state.analysis[0], path, directory) { return }
    // Features share one analysis so memory doesn't grow with the number of open documents.
    state.analysis.clear()
    analysis := build_analysis(&state, path, directory)
    state.analysis.push(move analysis)
}

fn source_for(state: &State, loaded: &modules.Loaded, path: string) -> string {
    for i in 0..loaded.paths.len {
        if (loaded.paths[i] == path || sys.same_file(loaded.paths[i], path)) && i < loaded.sources.len {
            return loaded.sources[i].clone()
        }
    }
    idx := find_doc_index(&state, path)
    if idx >= 0 { return state.doc_texts[idx].clone() }
    if path == loaded.path { return loaded.source.clone() }
    read := sys.read_text(path)
    if read.ok { return read.value }
    ""
}

fn contains_str(list: &[]string, value: string) -> bool {
    for item in list {
        if item == value { return true }
    }
    false
}

fn push_unique(list: &mut []string, value: string) {
    if !contains_str(&list, value) { list.push(value.clone()) }
}

fn publish_diagnostics_for_uri(state: &State, uri: string, source: string, items: &[]diag.Diagnostic) {
    lines := positions.index(source)
    mut w := json.Writer::new()
    w.object()
    w.key("jsonrpc"); w.string("2.0")
    w.key("method"); w.string("textDocument/publishDiagnostics")
    w.key("params"); w.object()
    w.key("uri"); w.string(uri)
    if state.versioned_diagnostics {
        idx := find_doc_index(&state, uri_to_path(uri))
        if idx >= 0 {
            version := state.doc_versions[idx]
            if version.is_some() { w.key("version"); w.integer(version.unwrap()) }
        }
    }
    w.key("diagnostics"); w.array()
    for d in &items {
        w.object()
        w.key("range"); write_range(&mut w, &lines, state.encoding, d.start, d.end)
        w.key("severity"); w.integer(if d.severity == .Error { 1 } else { 2 })
        if d.code != "" { w.key("code"); w.string(d.code) }
        w.key("source"); w.string("dunder")
        mut msg := d.message.clone()
        if d.note_message != "" { msg = msg + "\nnote: " + d.note_message }
        w.key("message"); w.string(msg)
        w.end()
    }
    w.end(); w.end(); w.end()
    res := jcompat.writer_finish(&w)
    if res.ok { send_json(res.value) }
}

fn tracks(snapshot: &DiagnosticSnapshot, changed: string) -> bool {
    if !snapshot.loaded { return true }
    for path in &snapshot.inputs {
        if path == changed || sys.same_file(path, changed) { return true }
    }
    false
}

fn snapshot_uris(state: &State, idx: i32, uris: &mut []string) {
    push_unique(&mut uris, state.doc_uris[idx])
    for d in &state.snapshots[idx].items { push_unique(&mut uris, path_to_uri(&state, d.path)) }
}

fn items_for_uri(state: &State, uri: string) -> []diag.Diagnostic {
    mut items: []diag.Diagnostic = []
    for snapshot in &state.snapshots {
        for d in &snapshot.items {
            if path_to_uri(&state, d.path) != uri { continue }
            mut found := false
            for item in &items {
                if item.start == d.start && item.end == d.end && item.code == d.code && item.message == d.message {
                    found = true; break
                }
            }
            if !found { items.push(diag.clone_diag(&d)) }
        }
    }
    diag.sort_resolved(&mut items)
    items
}

fn doc_text(state: &State, path: string) -> string {
    idx := find_doc_index(&state, path)
    if idx >= 0 { return state.doc_texts[idx].clone() }
    sys.read_text(path).value
}

fn refresh_diagnostics(state: &mut State, changed: &[]string, uris: &mut []string) {
    for i in 0..state.doc_paths.len {
        mut affected := false
        for path in &changed {
            if state.doc_paths[i] == path || tracks(&state.snapshots[i], path) { affected = true; break }
        }
        if !affected { continue }
        snapshot_uris(&state, i, &mut uris)
        root_path := state.doc_paths[i].clone()
        prepare_analysis(&mut state, root_path)
        analysis := &state.analysis[0]
        mut inputs: []string = []
        for p in &analysis.loaded.paths {
            if is_real_module_path(p) { inputs.push(p.clone()) }
        }
        mut items: []diag.Diagnostic = []
        for d in &analysis.diagnostics { items.push(diag.clone_diag(&d)) }
        state.snapshots[i] = DiagnosticSnapshot { inputs: inputs, items: items, loaded: analysis.loaded.ok }
        snapshot_uris(&state, i, &mut uris)
    }
    for uri in &uris {
        items := items_for_uri(&state, uri)
        source := if items.len > 0 { doc_text(&state, items[0].path) } else { "" }
        publish_diagnostics_for_uri(&state, uri, source, &items)
    }
}

fn word_at(source: string, offset_in: i32) -> WordInfo {
    mut off := offset_in
    if off < 0 { off = 0 }
    if off > source.len { off = source.len }
    if (off == source.len || !lexer.name_byte(i32(source[off]))) && off > 0 && lexer.name_byte(i32(source[off - 1])) {
        off -= 1
    }
    if off >= source.len || !lexer.name_byte(i32(source[off])) {
        mut has_dot := false
        mut qual := ""
        mut probe := offset_in
        if probe > source.len { probe = source.len }
        if probe > 0 && i32(source[probe - 1]) == 46 {
            has_dot = true
            mut qend := probe - 1
            mut qstart := qend
            while qstart > 0 && lexer.name_byte(i32(source[qstart - 1])) { qstart -= 1 }
            if qstart < qend { qual = source[qstart..qend] }
        }
        return WordInfo { start: offset_in, end: offset_in, word: "", qualifier: qual, has_dot: has_dot }
    }
    mut start := off
    while start > 0 && lexer.name_byte(i32(source[start - 1])) { start -= 1 }
    mut end := off + 1
    while end < source.len && lexer.name_byte(i32(source[end])) { end += 1 }
    if start < end && !lexer.name_start_byte(i32(source[start])) {
        return WordInfo { start: offset_in, end: offset_in, word: "", qualifier: "", has_dot: false }
    }
    mut has_dot := false
    mut qual := ""
    if start > 0 && i32(source[start - 1]) == 46 {
        has_dot = true
        qend := start - 1
        mut qstart := qend
        while qstart > 0 && lexer.name_byte(i32(source[qstart - 1])) { qstart -= 1 }
        if qstart < qend { qual = source[qstart..qend] }
    }
    WordInfo { start: start, end: end, word: source[start..end], qualifier: qual, has_dot: has_dot }
}

fn completion_context(source: string, offset: i32) -> CompletionContext {
    mut start := offset
    mut end := offset
    while start > 0 && lexer.name_byte(i32(source[start - 1])) { start -= 1 }
    while end < source.len && lexer.name_byte(i32(source[end])) { end += 1 }
    mut scope := CompletionScope.Plain
    mut qualifier_end := start
    if start > 0 && source[start - 1] == 46 {
        scope = .Dot
        qualifier_end = start - 1
    } else if start >= 2 && source[start - 2..start] == "::" {
        scope = .Static
        qualifier_end = start - 2
    }
    mut qualifier_start := qualifier_end
    if scope != .Plain {
        while qualifier_start > 0 && lexer.name_byte(i32(source[qualifier_start - 1])) { qualifier_start -= 1 }
        if scope == .Static && qualifier_start > 0 && source[qualifier_start - 1] == 46 {
            qualifier_start -= 1
            while qualifier_start > 0 && lexer.name_byte(i32(source[qualifier_start - 1])) { qualifier_start -= 1 }
        }
    }
    CompletionContext { scope: scope, qualifier: source[qualifier_start..qualifier_end],
        prefix: source[start..offset], start: start, end: end }
}

fn format_type(m: &ast.Module, ty_idx: i32) -> string {
    if ty_idx < 0 || ty_idx >= m.types.len { return "" }
    t := &m.types[ty_idx]
    if t.kind == .Named || t.kind == .ConstArg || t.kind == .Tuple || t.kind == .FnType {
        if t.span.start >= 0 && t.span.end > t.span.start && t.span.end <= m.source.len {
            return m.source[t.span.start..t.span.end]
        }
        return t.name.clone()
    }
    if t.kind == .Slice { return "[]" + format_type(&m, t.inner) }
    if t.kind == .FixedArray { return "[" + format_type(&m, t.inner) + "; " + t.count.str() + "]" }
    if t.kind == .Ref { return "&" + format_type(&m, t.inner) }
    if t.kind == .MutRef { return "&mut " + format_type(&m, t.inner) }
    if t.kind == .RawConst { return "*const " + format_type(&m, t.inner) }
    if t.kind == .RawMut { return "*mut " + format_type(&m, t.inner) }
    if t.kind == .Unit { return "()" }
    ""
}

fn format_item_signature(m: &ast.Module, idx: i32) -> string {
    item := &m.items[idx]
    mut out := ""
    if item.is_pub { out += "pub " }
    if item.is_unsafe { out += "unsafe " }
    if item.kind == .Fn || item.kind == .ExternFn {
        if item.kind == .ExternFn { out += "extern fn " } else { out += "fn " }
        out += item.name + "("
        for p in 0..item.param_count {
            if p > 0 { out += ", " }
            param := &m.params[item.first_param + p]
            if param.is_mut { out += "mut " }
            if param.is_move { out += "move " }
            out += param.name
            pt := format_type(&m, param.ty)
            if pt != "" { out += ": " + pt }
        }
        out += ")"
        rt := format_type(&m, item.ret_type)
        if rt != "" && rt != "()" { out += " -> " + rt }
        return out
    }
    if item.kind == .Struct {
        if item.is_opaque { out += "opaque " }
        return out + "struct " + item.name
    }
    if item.kind == .Union { return out + "union " + item.name }
    if item.kind == .TypeAlias {
        tt := format_type(&m, item.ret_type)
        return out + "type " + item.name + (if tt != "" { " = " + tt } else { "" })
    }
    if item.kind == .ExternType { return out + "extern type " + item.name }
    if item.kind == .ExternStatic {
        st := format_type(&m, item.ret_type)
        mut kw := "static "
        if item.is_mut { kw = "static mut " }
        return out + kw + item.name + (if st != "" { ": " + st } else { "" })
    }
    if item.kind == .Enum { return out + "enum " + item.name }
    if item.kind == .Trait { return out + "trait " + item.name }
    if item.kind == .Const {
        ct := format_type(&m, item.ret_type)
        return out + "const " + item.name + (if ct != "" { ": " + ct } else { "" })
    }
    if item.kind == .Impl {
        if item.trait_name != "" { return "impl " + item.trait_name + " for " + item.target_name }
        return "impl " + item.target_name
    }
    item.name.clone()
}

fn format_member_signature(m: &ast.Module, owner_idx: i32, mem_idx: i32) -> string {
    owner := &m.items[owner_idx]
    mem := &m.members[mem_idx]
    if owner.kind == .Struct || owner.kind == .Union {
        ft := format_type(&m, mem.ty)
        return owner.name + "." + mem.name + (if ft != "" { ": " + ft } else { "" })
    }
    if owner.kind == .Enum {
        return owner.name + "::" + mem.name
    }
    mut out := ""
    if mem.is_pub { out += "pub " }
    if mem.is_unsafe { out += "unsafe " }
    out += "fn " + mem.name + "("
    for i in 0..mem.param_count {
        if i > 0 { out += ", " }
        param := &m.params[mem.first_param + i]
        out += m.source[param.span.start..param.span.end]
    }
    out += ")"
    rt := format_type(&m, mem.ty)
    out + (if rt != "" && rt != "()" { " -> " + rt } else { "" })
}

fn base_type_name(raw_ty: string) -> string {
    mut s := text.trim(raw_ty)
    while s.len > 0 && (s[0] == 38 || s[0] == 91 || s[0] == 93) {
        if text.starts_with(s, "&mut ") { s = text.trim(s[5..s.len]) }
        else if text.starts_with(s, "&") { s = text.trim(s[1..s.len]) }
        else { break }
    }
    if text.starts_with(s, "[") { return s }
    mut start := 0
    mut end := s.len
    for i in 0..s.len {
        if s[i] == 60 { end = i; break }
        if s[i] == 46 { start = i + 1 }
    }
    s[start..end]
}

fn in_span(span: ast.Span, offset: i32) -> bool {
    offset >= span.start && offset < span.end
}

fn visible_at(root: &ast.Module, declaration: i32, cursor: i32) -> bool {
    for expr in &root.exprs {
        if (expr.kind == .BlockExpr || expr.kind == .UnsafeBlock || expr.kind == .Closure) &&
            in_span(expr.span, declaration) && !in_span(expr.span, cursor) { return false }
    }
    for arm in &root.match_arms {
        if in_span(arm.span, declaration) && !in_span(arm.span, cursor) { return false }
    }
    for stmt in &root.stmts {
        if stmt.kind == .For && in_span(stmt.span, declaration) && !in_span(stmt.span, cursor) { return false }
    }
    true
}

fn binding_at(analysis: &Analysis, name: string, offset: i32, enclose_start: i32, enclose_end: i32) -> i32 {
    mut latest := -1
    for i in 0..analysis.bindings.len {
        b := &analysis.bindings[i]
        if b.name != name || b.start < enclose_start || b.start > enclose_end || b.start > offset ||
            !visible_at(&analysis.root, b.start, offset) { continue }
        if latest < 0 || b.start > analysis.bindings[latest].start { latest = i }
    }
    latest
}

fn find_binding_type_at(analysis: &Analysis, name: string, offset: i32, enclose_start: i32, enclose_end: i32) -> string {
    idx := binding_at(&analysis, name, offset, enclose_start, enclose_end)
    if idx < 0 { return "" }
    analysis.bindings[idx].type_name.clone()
}

fn is_real_module_path(path: string) -> bool {
    path != "" && path[0] != 60
}

fn handle_hover(state: &mut State, doc: &json.Doc, id_node: i32, params: i32) {
    td := doc.field(params, "textDocument")
    pos_node := doc.field(params, "position")
    uri := jcompat.get_str(&doc, td, "uri").value
    line := jcompat.get_i64(&doc, pos_node, "line")
    ch := jcompat.get_i64(&doc, pos_node, "character")
    if uri == "" || !line.ok || !ch.ok { send_null_result(&doc, id_node); return }

    doc_path := uri_to_path(uri)
    prepare_analysis(&mut state, doc_path)
    analysis := &state.analysis[0]
    src := analysis.root.source.clone()
    if src == "" { send_null_result(&doc, id_node); return }

    lines := &analysis.lines
    off := positions.offset(&lines, line.value, ch.value, state.encoding)
    if off < 0 { send_null_result(&doc, id_node); return }
    w := word_at(src, off)
    if w.word == "" { send_null_result(&doc, id_node); return }

    cur_mod := &analysis.root
    enc_idx := ast.find_item_at(&cur_mod, w.start)
    mut enc_start := 0
    mut enc_end := src.len
    if enc_idx >= 0 {
        enc_start = cur_mod.items[enc_idx].span.start
        enc_end = cur_mod.items[enc_idx].span.end
    }

    mut hover_text := ""
    if w.has_dot && w.qualifier != "" {
        imported := modules.imported_module(&analysis.loaded, 0, w.qualifier)
        qual_ty := find_binding_type_at(&analysis, w.qualifier, w.start, enc_start, enc_end)
        mut qual_base := base_type_name(qual_ty)
        if qual_base == "" && imported < 0 { qual_base = w.qualifier.clone() }
        // Search struct fields, enum variants, or impl methods for receiver type
        for m_i in 0..analysis.loaded.paths.len {
            if qual_base == "" { break }
            mp := analysis.loaded.paths[m_i].clone()
            ms := analysis.loaded.sources[m_i].clone()
            parsed := parser.parse_source(mp, ms)
            for it_i in 0..parsed.items.len {
                it := &parsed.items[it_i]
                if ((it.kind == .Struct || it.kind == .Enum) && it.name == qual_base) ||
                   (it.kind == .Impl && base_type_name(it.target_name) == qual_base) {
                    for mem_k in 0..it.member_count {
                        mem_idx := it.first_member + mem_k
                        if parsed.members[mem_idx].name == w.word {
                            hover_text = format_member_signature(&parsed, it_i, mem_idx)
                            break
                        }
                    }
                    if hover_text != "" { break }
                }
            }
            if hover_text != "" { break }
        }
        if qual_ty == "" && imported >= 0 {
            parsed := parser.parse_source(analysis.loaded.paths[imported], analysis.loaded.sources[imported])
            idx := find_public_item(&parsed, w.word)
            if idx >= 0 { hover_text = format_item_signature(&parsed, idx) }
        }
    }

    if hover_text == "" && !w.has_dot {
        bty := find_binding_type_at(&analysis, w.word, w.start, enc_start, enc_end)
        if bty != "" { hover_text = w.word + ": " + bty }
    }

    if hover_text == "" && !w.has_dot {
        for it_i in 0..cur_mod.items.len {
            it := &cur_mod.items[it_i]
            if it.kind != .Import && it.kind != .Impl && it.name == w.word {
                hover_text = format_item_signature(&cur_mod, it_i)
                break
            }
        }
    }

    if hover_text == "" && !w.has_dot {
        for m_i in 0..analysis.loaded.paths.len {
            mp := analysis.loaded.paths[m_i].clone()
            if mp == doc_path { continue }
            parsed := parser.parse_source(mp, analysis.loaded.sources[m_i])
            for it_i in 0..parsed.items.len {
                it := &parsed.items[it_i]
                if it.kind != .Import && it.kind != .Impl && it.name == w.word {
                    hover_text = format_item_signature(&parsed, it_i)
                    break
                }
            }
            if hover_text != "" { break }
        }
    }

    if hover_text == "" { send_null_result(&doc, id_node); return }

    mut rw := json.Writer::new()
    rw.object()
    rw.key("jsonrpc"); rw.string("2.0")
    rw.key("id"); write_rpc_id(&mut rw, &doc, id_node)
    rw.key("result"); rw.object()
    rw.key("contents"); rw.object()
    rw.key("kind"); rw.string("markdown")
    rw.key("value"); rw.string("```dunder\n" + hover_text + "\n```")
    rw.end()
    rw.key("range"); write_range(&mut rw, &lines, state.encoding, w.start, w.end)
    rw.end(); rw.end()
    res := jcompat.writer_finish(&rw)
    if res.ok { send_json(res.value) }
}

fn find_item_def_in_module(m: &ast.Module, name: string) -> i32 {
    for i in 0..m.items.len {
        it := &m.items[i]
        if it.kind != .Import && it.kind != .Capability && it.kind != .Impl && it.name == name {
            return i
        }
    }
    -1
}

fn find_public_item(m: &ast.Module, name: string) -> i32 {
    idx := find_item_def_in_module(&m, name)
    if idx >= 0 && m.items[idx].is_pub { idx } else { -1 }
}

fn handle_definition(state: &mut State, doc: &json.Doc, id_node: i32, params: i32) {
    td := doc.field(params, "textDocument")
    pos_node := doc.field(params, "position")
    uri := jcompat.get_str(&doc, td, "uri").value
    line := jcompat.get_i64(&doc, pos_node, "line")
    ch := jcompat.get_i64(&doc, pos_node, "character")
    if uri == "" || !line.ok || !ch.ok { send_null_result(&doc, id_node); return }

    doc_path := uri_to_path(uri)
    prepare_analysis(&mut state, doc_path)
    analysis := &state.analysis[0]
    src := analysis.root.source.clone()
    if src == "" { send_null_result(&doc, id_node); return }

    lines := &analysis.lines
    off := positions.offset(&lines, line.value, ch.value, state.encoding)
    if off < 0 { send_null_result(&doc, id_node); return }
    w := word_at(src, off)
    if w.word == "" { send_null_result(&doc, id_node); return }

    cur_mod := &analysis.root
    enc_idx := ast.find_item_at(&cur_mod, w.start)
    mut enc_start := 0
    mut enc_end := src.len
    if enc_idx >= 0 {
        enc_start = cur_mod.items[enc_idx].span.start
        enc_end = cur_mod.items[enc_idx].span.end
    }

    mut found := false
    mut def_path := ""
    mut def_src := ""
    mut def_start := 0
    mut def_end := 0

    // 1. Member/impl method lookup when qualified with receiver or module alias
    if w.has_dot && w.qualifier != "" {
        imported := modules.imported_module(&analysis.loaded, 0, w.qualifier)
        qual_ty := find_binding_type_at(&analysis, w.qualifier, w.start, enc_start, enc_end)
        qual_base := base_type_name(qual_ty)
        if qual_base != "" {
            for m_i in 0..analysis.loaded.paths.len {
                mp := analysis.loaded.paths[m_i].clone()
                if !is_real_module_path(mp) { continue }
                ms := analysis.loaded.sources[m_i].clone()
                parsed := parser.parse_source(mp, ms)
                for it_i in 0..parsed.items.len {
                    it := &parsed.items[it_i]
                    if ((it.kind == .Struct || it.kind == .Enum) && it.name == qual_base) ||
                       (it.kind == .Impl && base_type_name(it.target_name) == qual_base) {
                        for mem_k in 0..it.member_count {
                            mem := &parsed.members[it.first_member + mem_k]
                            if mem.name == w.word {
                                found = true
                                def_path = mp.clone(); def_src = ms.clone()
                                def_start = mem.span.start; def_end = mem.span.end
                                break
                            }
                        }
                        if found { break }
                    }
                }
                if found { break }
            }
        }
        if qual_ty == "" && imported >= 0 && is_real_module_path(analysis.loaded.paths[imported]) {
            def_path = analysis.loaded.paths[imported].clone()
            def_src = analysis.loaded.sources[imported].clone()
            parsed := parser.parse_source(def_path, def_src)
            idx := find_public_item(&parsed, w.word)
            if idx >= 0 {
                sp := parsed.items[idx].name_span
                def_start = sp.start; def_end = sp.end; found = true
            }
        }
    }

    // 2. Local binding / parameter declaration in enclosing item
    if !found && !w.has_dot {
        // Check parameters of enclosing item first
        if enc_idx >= 0 {
            enc := &cur_mod.items[enc_idx]
            for p in 0..enc.param_count {
                param := &cur_mod.params[enc.first_param + p]
                if param.name == w.word {
                    found = true
                    def_path = doc_path.clone(); def_src = src.clone()
                    def_start = param.span.start; def_end = param.span.end
                    break
                }
            }
        }
        if !found {
            bind := binding_at(&analysis, w.word, w.start, enc_start, enc_end)
            boff := if bind >= 0 { analysis.bindings[bind].start } else { -1 }
            if boff >= 0 && (boff < w.start || boff > w.end) {
                found = true
                def_path = doc_path.clone(); def_src = src.clone()
                def_start = boff; def_end = boff + w.word.len
            }
        }
    }

    // 3. Top-level item in current file
    if !found && !w.has_dot {
        idx := find_item_def_in_module(&cur_mod, w.word)
        if idx >= 0 {
            sp := if cur_mod.items[idx].name_span.end > cur_mod.items[idx].name_span.start {
                cur_mod.items[idx].name_span
            } else { cur_mod.items[idx].span }
            found = true
            def_path = doc_path.clone(); def_src = src.clone()
            def_start = sp.start; def_end = sp.end
        }
    }

    // 4. Top-level item in loaded project modules
    if !found && !w.has_dot {
        for m_i in 0..analysis.loaded.paths.len {
            mp := analysis.loaded.paths[m_i].clone()
            if mp == doc_path || !is_real_module_path(mp) { continue }
            ms := analysis.loaded.sources[m_i].clone()
            parsed := parser.parse_source(mp, ms)
            idx := find_item_def_in_module(&parsed, w.word)
            if idx >= 0 {
                sp := if parsed.items[idx].name_span.end > parsed.items[idx].name_span.start {
                    parsed.items[idx].name_span
                } else { parsed.items[idx].span }
                found = true
                def_path = mp.clone(); def_src = ms.clone()
                def_start = sp.start; def_end = sp.end
                break
            }
        }
    }

    if !found { send_null_result(&doc, id_node); return }

    mut rw := json.Writer::new()
    rw.object()
    rw.key("jsonrpc"); rw.string("2.0")
    rw.key("id"); write_rpc_id(&mut rw, &doc, id_node)
    rw.key("result")
    write_location(&mut rw, &state, def_path, def_src, def_start, def_end)
    rw.end()
    res := jcompat.writer_finish(&rw)
    if res.ok { send_json(res.value) }
}

fn lsp_symbol_kind(kind: ast.ItemKind) -> i64 {
    if kind == .Fn || kind == .ExternFn { return 12 } // Function
    if kind == .Struct || kind == .Union || kind == .TypeAlias || kind == .ExternType { return 23 } // Struct
    if kind == .Enum { return 10 }   // Enum
    if kind == .Trait { return 11 }  // Interface
    if kind == .Const || kind == .ExternStatic { return 14 }  // Constant
    13 // Variable / other
}

fn clamped_sel_range(full: ast.Span, name_sp: ast.Span) -> ast.Span {
    if name_sp.end > name_sp.start && name_sp.start >= full.start && name_sp.end <= full.end {
        return name_sp
    }
    full
}

fn handle_document_symbol(state: &State, doc: &json.Doc, id_node: i32, params: i32) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    if uri == "" { send_null_result(&doc, id_node); return }
    doc_path := uri_to_path(uri)
    idx := find_doc_index(&state, doc_path)
    mut src := if idx >= 0 { state.doc_texts[idx].clone() } else { "" }
    if src == "" {
        read := sys.read_text(doc_path)
        if read.ok { src = read.value }
    }

    mut rw := json.Writer::new()
    rw.object()
    rw.key("jsonrpc"); rw.string("2.0")
    rw.key("id"); write_rpc_id(&mut rw, &doc, id_node)
    rw.key("result"); rw.array()
    if src != "" {
        m := parser.parse_source(doc_path, src)
        lines := positions.index(src)
        for i in 0..m.items.len {
            it := &m.items[i]
            if it.kind == .Import || it.kind == .Capability || it.kind == .ExternBlock { continue }
            mut label := it.name.clone()
            if it.kind == .Impl {
                label = if it.trait_name != "" { "impl " + it.trait_name + " for " + it.target_name } else { "impl " + it.target_name }
            }
            if label == "" { continue }
            sel := clamped_sel_range(it.span, it.name_span)
            rw.object()
            rw.key("name"); rw.string(label)
            rw.key("detail"); rw.string(format_item_signature(&m, i))
            rw.key("kind"); rw.integer(lsp_symbol_kind(it.kind))
            rw.key("range"); write_range(&mut rw, &lines, state.encoding, it.span.start, it.span.end)
            rw.key("selectionRange"); write_range(&mut rw, &lines, state.encoding, sel.start, sel.end)
            if it.member_count > 0 {
                rw.key("children"); rw.array()
                for k in 0..it.member_count {
                    mem := &m.members[it.first_member + k]
                    if mem.name == "" { continue }
                    mut mkind: i64 = 8 // Field
                    if it.kind == .Enum { mkind = 22 } // EnumMember
                    else if it.kind == .Impl || it.kind == .Trait { mkind = 6 } // Method
                    rw.object()
                    rw.key("name"); rw.string(mem.name)
                    rw.key("kind"); rw.integer(mkind)
                    rw.key("range"); write_range(&mut rw, &lines, state.encoding, mem.span.start, mem.span.end)
                    rw.key("selectionRange"); write_range(&mut rw, &lines, state.encoding, mem.span.start, mem.span.end)
                    rw.end()
                }
                rw.end()
            }
            rw.end()
        }
    }
    rw.end(); rw.end()
    res := jcompat.writer_finish(&rw)
    if res.ok { send_json(res.value) }
}

fn matches_completion(label: string, prefix: string) -> bool {
    label != "" && (prefix == "" || text.starts_with(label, prefix))
}

fn add_completion(entries: &mut []CompletionEntry, seen: &mut Set<string>, prefix: string, label: string, kind: i32, detail: string, priority: i32) {
    if !matches_completion(label, prefix) || !seen.insert(label.clone()) { return }
    entries.push(CompletionEntry { label: label.clone(), kind: kind, detail: detail.clone(), priority: priority })
}

fn completion_kind(kind: ast.ItemKind) -> i32 {
    if kind == .Fn || kind == .ExternFn { return 3 }
    if kind == .Struct || kind == .Union { return 22 }
    if kind == .Enum { return 13 }
    if kind == .TypeAlias || kind == .ExternType || kind == .Trait { return 7 }
    21
}

fn import_alias(item: &ast.Item) -> string {
    if item.name != item.target_name { return item.name.clone() }
    mut start := 0
    for i in 0..item.name.len {
        if item.name[i] == 46 || item.name[i] == 47 { start = i + 1 }
    }
    item.name[start..item.name.len]
}

fn module_completions(entries: &mut []CompletionEntry, seen: &mut Set<string>, m: &ast.Module, prefix: string, external: bool) {
    for i in 0..m.items.len {
        item := &m.items[i]
        if item.kind == .Capability || item.kind == .Impl || item.kind == .ExternBlock { continue }
        if item.kind == .Import {
            if external { continue }
            alias := import_alias(&item)
            if alias != "_" {
                kind := if item.target_name.len > 0 && alias.len > 0 && alias[0] >= 65 && alias[0] <= 90 { 7 } else { 9 }
                add_completion(&mut entries, &mut seen, prefix, alias, kind, "import " + item.target_name, 2)
            }
            continue
        }
        if (external && !item.is_pub) || !matches_completion(item.name, prefix) { continue }
        add_completion(&mut entries, &mut seen, prefix, item.name, completion_kind(item.kind), format_item_signature(&m, i), 2)
    }
}

fn declared_type(loaded: &modules.Loaded, m: &ast.Module, owner: i32, spelling: string) -> TypeLocation {
    name := base_type_name(spelling)
    if name.len < spelling.len {
        for i in 0..spelling.len {
            if spelling[i] == 60 { break }
            if spelling[i] == 46 {
                return TypeLocation { module: modules.imported_module(&loaded, owner, spelling[0..i]), name: name }
            }
        }
    }
    for item in &m.items {
        if item.kind == .Import && import_alias(&item) == name {
            original := base_type_name(item.target_name)
            imported := modules.imported_symbol_module(&loaded, owner, name, original)
            if imported >= 0 { return TypeLocation { module: imported, name: original } }
        } else if item.name == name && (item.kind == .Struct || item.kind == .Union || item.kind == .Enum || item.kind == .TypeAlias) {
            return TypeLocation { module: owner, name: name }
        }
    }
    TypeLocation { module: -1, name: name }
}

fn builtin_member_completions(entries: &mut []CompletionEntry, seen: &mut Set<string>, context: &CompletionContext, receiver: string) {
    name := base_type_name(receiver)
    if name == "string" || name == "str" {
        add_completion(&mut entries, &mut seen, context.prefix, "len", 5, "len: i32", 1)
        add_completion(&mut entries, &mut seen, context.prefix, "bytes", 2, "fn bytes() -> []u8", 1)
        add_completion(&mut entries, &mut seen, context.prefix, "runes", 2, "fn runes() -> []rune", 1)
        if name == "string" {
            add_completion(&mut entries, &mut seen, context.prefix, "as_str", 2, "fn as_str() -> &str", 1)
        } else {
            add_completion(&mut entries, &mut seen, context.prefix, "as_bytes", 2, "fn as_bytes() -> &[]u8", 1)
        }
        add_completion(&mut entries, &mut seen, context.prefix, "clone", 2, "fn clone() -> string", 1)
    } else if text.starts_with(name, "[") {
        add_completion(&mut entries, &mut seen, context.prefix, "len", 5, "len: i32", 1)
        add_completion(&mut entries, &mut seen, context.prefix, "cap", 2, "fn cap() -> i32", 1)
    } else if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "isize" ||
        name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "usize" ||
        name == "f32" || name == "f64" || name == "bool" || name == "rune" {
        add_completion(&mut entries, &mut seen, context.prefix, "str", 2, "fn str() -> string", 1)
    }
}

fn member_completions(entries: &mut []CompletionEntry, seen: &mut Set<string>, loaded: &modules.Loaded,
    m: &ast.Module, owner: i32, context: &CompletionContext, wanted: &TypeLocation, instance: bool) {
    external := owner != 0
    same_type := wanted.module < 0 || wanted.module == owner
    for i in 0..m.items.len {
        item := &m.items[i]
        fields := same_type && (item.kind == .Struct || item.kind == .Union) && item.name == wanted.name && instance
        variants := same_type && item.kind == .Enum && item.name == wanted.name && !instance && context.scope == .Dot
        mut methods := false
        if item.kind == .Impl {
            target := declared_type(&loaded, &m, owner, item.target_name)
            methods = target.name == wanted.name && (wanted.module < 0 || wanted.module == target.module)
        }
        if !fields && !variants && !methods { continue }
        if external && !methods && (!item.is_pub || item.is_opaque) { continue }
        for j in 0..item.member_count {
            member_index := item.first_member + j
            member := &m.members[member_index]
            if !matches_completion(member.name, context.prefix) { continue }
            if methods {
                has_receiver := member.param_count > 0 && m.params[member.first_param].receiver != .None
                if (external && !member.is_pub) || has_receiver != instance || (!instance && context.scope != .Static) { continue }
            }
            kind := if fields { 5 } else if variants { 20 } else { 2 }
            add_completion(&mut entries, &mut seen, context.prefix, member.name, kind, format_member_signature(&m, i, member_index), 1)
        }
    }
}

fn collect_completions(analysis: &Analysis, context: &CompletionContext, offset: i32) -> []CompletionEntry {
    mut entries: []CompletionEntry = []
    mut seen := Set<string>::new()
    root := &analysis.root
    enclosing := ast.find_item_at(&root, offset)
    if context.scope == .Plain {
        if enclosing >= 0 {
            item := &root.items[enclosing]
            mut i := analysis.bindings.len
            while i > 0 {
                i -= 1
                binding := &analysis.bindings[i]
                if binding.start >= item.span.start && binding.start < context.start &&
                    visible_at(&root, binding.start, offset) {
                    add_completion(&mut entries, &mut seen, context.prefix, binding.name, 6, binding.type_name, 1)
                }
            }
            for p in 0..item.param_count {
                param := &root.params[item.first_param + p]
                if matches_completion(param.name, context.prefix) {
                    add_completion(&mut entries, &mut seen, context.prefix, param.name, 6, format_type(&root, param.ty), 1)
                }
            }
        }
        module_completions(&mut entries, &mut seen, &root, context.prefix, false)
        for builtin in ["print", "assert", "panic", "len"] {
            add_completion(&mut entries, &mut seen, context.prefix, builtin, 3, "built-in", 3)
        }
        for keyword in ["fn", "pub", "mut", "move", "struct", "union", "enum", "trait", "impl", "if", "else",
            "while", "for", "in", "match", "return", "break", "continue", "defer", "unsafe", "import", "capability", "true", "false"] {
            add_completion(&mut entries, &mut seen, context.prefix, keyword, 14, "keyword", 4)
        }
        for primitive in ["i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize", "f32", "f64", "bool", "string", "Option", "Result"] {
            add_completion(&mut entries, &mut seen, context.prefix, primitive, 7, "type", 4)
        }
        return entries
    }

    if context.qualifier == "" { return entries }
    mut receiver := -1
    if context.scope == .Dot && enclosing >= 0 {
        sp := root.items[enclosing].span
        receiver = binding_at(&analysis, context.qualifier, context.start, sp.start, sp.end)
    }
    imported := modules.imported_module(&analysis.loaded, 0, context.qualifier)
    if context.scope == .Dot && receiver < 0 && imported >= 0 {
        module := parser.parse_source(analysis.loaded.paths[imported], analysis.loaded.sources[imported])
        module_completions(&mut entries, &mut seen, &module, context.prefix, true)
        return entries
    }
    instance := receiver >= 0
    mut spelling := context.qualifier.clone()
    if spelling == "Self" && enclosing >= 0 && root.items[enclosing].kind == .Impl {
        spelling = root.items[enclosing].target_name.clone()
    }
    mut wanted := declared_type(&analysis.loaded, &root, 0, spelling)
    if instance {
        binding := &analysis.bindings[receiver]
        wanted = TypeLocation { module: binding.module, name: base_type_name(binding.type_name) }
        if wanted.module < 0 { builtin_member_completions(&mut entries, &mut seen, &context, binding.type_name) }
    }
    member_completions(&mut entries, &mut seen, &analysis.loaded, &root, 0, &context, &wanted, instance)
    for i in 1..analysis.loaded.paths.len {
        source := &analysis.loaded.sources[i]
        if !text.contains(source, wanted.name) || (wanted.module >= 0 && i != wanted.module && !text.contains(source, "impl")) { continue }
        module := parser.parse_source(analysis.loaded.paths[i], source)
        member_completions(&mut entries, &mut seen, &analysis.loaded, &module, i, &context, &wanted, instance)
    }
    entries
}

fn handle_completion(state: &mut State, doc: &json.Doc, id_node: i32, params: i32) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    if uri == "" { send_null_result(&doc, id_node); return }
    prepare_analysis(&mut state, uri_to_path(uri))
    analysis := &state.analysis[0]
    offset := read_position(&doc, doc.field(params, "position"), &analysis.lines, state.encoding)
    if offset < 0 { send_null_result(&doc, id_node); return }
    context := completion_context(analysis.root.source, offset)
    entries := collect_completions(&analysis, &context, offset)

    mut rw := json.Writer::new()
    rw.object()
    rw.key("jsonrpc"); rw.string("2.0")
    rw.key("id"); write_rpc_id(&mut rw, &doc, id_node)
    rw.key("result"); rw.object()
    rw.key("isIncomplete"); rw.boolean(false)
    rw.key("items"); rw.array()
    for entry in &entries {
        rw.object()
        rw.key("label"); rw.string(entry.label)
        rw.key("kind"); rw.integer(i64(entry.kind))
        rw.key("sortText"); rw.string(entry.priority.str() + ":" + entry.label)
        if entry.detail != "" { rw.key("detail"); rw.string(entry.detail) }
        rw.key("textEdit"); rw.object()
        rw.key("range"); write_range(&mut rw, &analysis.lines, state.encoding, context.start, context.end)
        rw.key("newText"); rw.string(entry.label)
        rw.end(); rw.end()
    }
    rw.end(); rw.end(); rw.end()
    res := jcompat.writer_finish(&rw)
    if res.ok { send_json(res.value) }
}

fn handle_code_action(state: &State, doc: &json.Doc, id_node: i32, params: i32) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    source := doc_text(&state, uri_to_path(uri))
    action_range := doc.field(params, "range")
    lines := positions.index(source)
    start := read_position(&doc, doc.field(action_range, "start"), &lines, state.encoding)
    end := read_position(&doc, doc.field(action_range, "end"), &lines, state.encoding)
    only := doc.field(doc.field(params, "context"), "only")
    mut wanted := only < 0
    for i in 0..doc.count(only) {
        if jcompat.as_str(&doc, doc.at(only, i)).value == "quickfix" { wanted = true }
    }
    mut rw := json.Writer::new()
    rw.object(); rw.key("jsonrpc"); rw.string("2.0")
    rw.key("id"); write_rpc_id(&mut rw, &doc, id_node)
    rw.key("result"); rw.array()
    if wanted && start >= 0 && end >= start {
        items := items_for_uri(&state, uri)
        mut edits: []i32 = []
        for d in &items {
            if d.end < start || d.start > end || d.note_start < 0 || d.note_end <= d.note_start ||
                d.note_end > source.len || path_to_uri(&state, d.note_path) != uri { continue }
            name := source[d.note_start..d.note_end]
            if d.note_message != diag.immutable_binding_note(name) { continue }
            mut duplicate := false
            for off in &edits { if off == d.note_start { duplicate = true; break } }
            if duplicate { continue }
            edits.push(d.note_start)
            rw.object(); rw.key("title"); rw.string("Make '" + name + "' mutable")
            rw.key("kind"); rw.string("quickfix"); rw.key("isPreferred"); rw.boolean(true)
            rw.key("edit"); rw.object(); rw.key("changes"); rw.object(); rw.key(uri); rw.array()
            rw.object(); rw.key("range"); write_range(&mut rw, &lines, state.encoding, d.note_start, d.note_start)
            rw.key("newText"); rw.string("mut "); rw.end(); rw.end(); rw.end(); rw.end(); rw.end()
        }
    }
    rw.end(); rw.end()
    result := jcompat.writer_finish(&rw)
    if result.ok { send_json(result.value) }
}

fn handle_formatting(state: &State, doc: &json.Doc, id_node: i32, params: i32) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    mut formatted_text := ""
    mut original := ""
    mut changed := false
    if uri != "" {
        doc_path := uri_to_path(uri)
        idx := find_doc_index(&state, doc_path)
        if idx >= 0 { original = state.doc_texts[idx].clone() }
        else {
            read := sys.read_text(doc_path)
            if read.ok { original = read.value }
        }
        if original != "" {
            res := fmt.format_source(doc_path, original)
            if res.ok && res.text != original {
                formatted_text = res.text
                changed = true
            }
        }
    }

    mut rw := json.Writer::new()
    rw.object()
    rw.key("jsonrpc"); rw.string("2.0")
    rw.key("id"); write_rpc_id(&mut rw, &doc, id_node)
    rw.key("result"); rw.array()
    if changed {
        rw.object()
        lines := positions.index(original)
        rw.key("range"); write_range(&mut rw, &lines, state.encoding, 0, original.len)
        rw.key("newText"); rw.string(formatted_text)
        rw.end()
    }
    rw.end(); rw.end()
    res := jcompat.writer_finish(&rw)
    if res.ok { send_json(res.value) }
}

fn handle_initialize(state: &mut State, doc: &json.Doc, id_node: i32, params: i32) {
    caps := doc.field(params, "capabilities")
    encodings := doc.field(doc.field(caps, "general"), "positionEncodings")
    state.encoding = .Utf16
    for i in 0..doc.count(encodings) {
        offered := jcompat.as_str(&doc, doc.at(encodings, i)).value
        if offered == "utf-8" { state.encoding = .Utf8; break }
        if offered == "utf-16" { break }
        if offered == "utf-32" { state.encoding = .Utf32; break }
    }
    publish := doc.field(doc.field(caps, "textDocument"), "publishDiagnostics")
    state.versioned_diagnostics = doc.get_bool(publish, "versionSupport").unwrap_or(false)

    root_uri := jcompat.get_str(&doc, params, "rootUri")
    if root_uri.ok && root_uri.value != "" {
        state.root_path = uri_to_path(root_uri.value)
    } else {
        root_path := jcompat.get_str(&doc, params, "rootPath")
        if root_path.ok && root_path.value != "" {
            state.root_path = paths.normalize(root_path.value)
        }
    }

    mut rw := json.Writer::new()
    rw.object()
    rw.key("jsonrpc"); rw.string("2.0")
    rw.key("id"); write_rpc_id(&mut rw, &doc, id_node)
    rw.key("result"); rw.object()
    rw.key("capabilities"); rw.object()
    rw.key("positionEncoding")
    rw.string(if state.encoding == .Utf8 { "utf-8" } else if state.encoding == .Utf32 { "utf-32" } else { "utf-16" })
    rw.key("textDocumentSync"); rw.object()
    rw.key("openClose"); rw.boolean(true)
    rw.key("change"); rw.integer(2)
    rw.key("save"); rw.boolean(true)
    rw.end()
    rw.key("codeActionProvider"); rw.boolean(true)
    rw.key("hoverProvider"); rw.boolean(true)
    rw.key("definitionProvider"); rw.boolean(true)
    rw.key("documentSymbolProvider"); rw.boolean(true)
    rw.key("completionProvider"); rw.object()
    rw.key("triggerCharacters"); rw.array(); rw.string("."); rw.string(":"); rw.end()
    rw.end()
    rw.key("documentFormattingProvider"); rw.boolean(true)
    rw.end()
    rw.key("serverInfo"); rw.object()
    rw.key("name"); rw.string("dunder-lsp")
    rw.key("version"); rw.string(cli.compiler_version())
    rw.end()
    rw.end(); rw.end()
    res := jcompat.writer_finish(&rw)
    if res.ok { send_json(res.value) }
}

fn apply_change(text_in: string, doc: &json.Doc, ch_node: i32, encoding: positions.Encoding) -> Option<string> {
    new_text := jcompat.get_str(&doc, ch_node, "text")
    if !new_text.ok { return .None }
    edit_range := doc.field(ch_node, "range")
    if edit_range < 0 { return .Some(new_text.value) }
    if doc.kind(edit_range) != .Object { return .None }
    lines := positions.index(text_in)
    start := read_position(&doc, doc.field(edit_range, "start"), &lines, encoding)
    end := read_position(&doc, doc.field(edit_range, "end"), &lines, encoding)
    if start < 0 || end < start { return .None }
    .Some(text_in[0..start] + new_text.value + text_in[end..text_in.len])
}

fn handle_did_open(state: &mut State, doc: &json.Doc, params: i32) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    txt := jcompat.get_str(&doc, td, "text")
    if uri == "" || !txt.ok { return }
    path := set_doc(&mut state, uri, txt.value, doc.get_i64(td, "version"))
    mut uris: []string = []
    refresh_diagnostics(&mut state, &[path], &mut uris)
}

fn handle_did_change(state: &mut State, doc: &json.Doc, params: i32, changed: &mut []string) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    changes := doc.field(params, "contentChanges")
    if uri == "" || doc.kind(changes) != .Array || doc.count(changes) == 0 { return }
    idx := find_doc_index(&state, uri_to_path(uri))
    if idx < 0 { return }
    version := doc.get_i64(td, "version")
    previous := state.doc_versions[idx]
    if version.is_some() && previous.is_some() && version.unwrap() <= previous.unwrap() { return }
    mut current := state.doc_texts[idx].clone()
    for k in 0..doc.count(changes) {
        current = match apply_change(current, &doc, doc.at(changes, k), state.encoding) {
            .Some(updated) => move updated,
            .None => { return },
        }
    }
    state.doc_texts[idx] = move current
    if version.is_some() { state.doc_versions[idx] = version }
    push_unique(&mut changed, state.doc_paths[idx])
}

fn handle_did_save(state: &mut State, doc: &json.Doc, params: i32) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    if uri == "" { return }
    idx := find_doc_index(&state, uri_to_path(uri))
    path := if idx >= 0 { state.doc_paths[idx].clone() } else { uri_to_path(uri) }
    mut uris: []string = []
    refresh_diagnostics(&mut state, &[path], &mut uris)
}

fn handle_did_close(state: &mut State, doc: &json.Doc, params: i32) {
    td := doc.field(params, "textDocument")
    uri := jcompat.get_str(&doc, td, "uri").value
    if uri == "" { return }
    idx := find_doc_index(&state, uri_to_path(uri))
    if idx < 0 { return }
    mut uris: []string = []
    snapshot_uris(&state, idx, &mut uris)
    path := remove_doc(&mut state, uri)
    if state.analysis.len > 0 && state.analysis[0].path == path { state.analysis.clear() }
    refresh_diagnostics(&mut state, &[path], &mut uris)
}

fn configure_stdio() -> bool {
    if target_is("macos") { return true }
    else if target_is("linux") { return true }
    else { unsafe { return set_mode(0, 32768) >= 0 && set_mode(1, 32768) >= 0 } }
}

fn publish_pending(state: &mut State, changed: &mut []string) {
    if changed.len == 0 { return }
    mut uris: []string = []
    refresh_diagnostics(&mut state, &changed, &mut uris)
    changed.clear()
}

pub fn run(default_target: i32) -> i32 {
    if !configure_stdio() { return 1 }
    mut state := new_state(default_target)
    mut rx: []u8 = []
    mut changed: []string = []
    while true {
        frame := read_frame(&mut rx, changed.len == 0)
        if !frame.ok {
            if frame.eof { break }
            if frame.waiting { publish_pending(&mut state, &mut changed) }
            continue
        }
        doc := json.Doc::parse_text(frame.body)
        if !doc.ok || doc.kind(doc.root) != .Object { continue }
        method_field := jcompat.get_str(&doc, doc.root, "method")
        if !method_field.ok { continue }
        method := method_field.value
        id_node := doc.field(doc.root, "id")
        has_id := id_node >= 0
        params := doc.field(doc.root, "params")

        if method != "textDocument/didChange" {
            publish_pending(&mut state, &mut changed)
        }
        if method == "initialize" {
            handle_initialize(&mut state, &doc, id_node, params)
        } else if method == "initialized" {
            continue
        } else if method == "shutdown" {
            state.shutting_down = true
            if has_id { send_null_result(&doc, id_node) }
        } else if method == "exit" {
            return if state.shutting_down { 0 } else { 1 }
        } else if method == "textDocument/didOpen" {
            handle_did_open(&mut state, &doc, params)
        } else if method == "textDocument/didChange" {
            handle_did_change(&mut state, &doc, params, &mut changed)
        } else if method == "textDocument/didSave" {
            handle_did_save(&mut state, &doc, params)
        } else if method == "textDocument/didClose" {
            handle_did_close(&mut state, &doc, params)
        } else if method == "textDocument/codeAction" {
            if has_id { handle_code_action(&state, &doc, id_node, params) }
        } else if method == "textDocument/hover" {
            if has_id { handle_hover(&mut state, &doc, id_node, params) }
        } else if method == "textDocument/definition" {
            if has_id { handle_definition(&mut state, &doc, id_node, params) }
        } else if method == "textDocument/documentSymbol" {
            if has_id { handle_document_symbol(&state, &doc, id_node, params) }
        } else if method == "textDocument/completion" {
            if has_id { handle_completion(&mut state, &doc, id_node, params) }
        } else if method == "textDocument/formatting" {
            if has_id { handle_formatting(&state, &doc, id_node, params) }
        } else {
            if has_id { send_error(&doc, id_node, -32601, "method not found: " + method) }
        }
    }
    0
}

@test fn lsp_positions_and_uri_round_trip() {
    src := "fn main() {\n    x := 1\n}\n"
    lines := positions.index(src)
    off := positions.offset(&lines, 1, 4, .Utf16)
    assert(src[off..off + 1] == "x")
    p := positions.position(&lines, off, .Utf16)
    assert(p.line == 1 && p.character == 4)

    w := word_at("foo.bar(x)", 5)
    assert(w.word == "bar" && w.has_dot && w.qualifier == "foo")
    qualified := "mått.öka"
    qualified_lines := positions.index(qualified)
    word := word_at(qualified, positions.offset(&qualified_lines, 0, 5, .Utf16))
    assert(word.word == "öka" && word.qualifier == "mått")
    prefix := completion_context(qualified, positions.offset(&qualified_lines, 0, 6, .Utf16))
    assert(prefix.prefix == "ö" && prefix.qualifier == "mått" && prefix.end == qualified.len)

    assert(uri_to_path("file:///tmp/hello%20world/main.ddr") == "/tmp/hello world/main.ddr")
    state := new_state(5)
    drive := "C:/Å ä/ö.ddr"
    drive_uri := "file:///C:/%C3%85%20%C3%A4/%C3%B6.ddr"
    assert(path_to_uri(&state, drive) == drive_uri)
    assert(uri_to_path(drive_uri) == drive)
    assert(uri_to_path("file://localhost/C%3A/A%20B.ddr") == "C:/A B.ddr")
    share := "//testhost/share/Å ä.ddr"
    share_uri := "file://testhost/share/%C3%85%20%C3%A4.ddr"
    assert(path_to_uri(&state, share) == share_uri)
    assert(uri_to_path(share_uri) == share)
    assert(parse_content_length("Content-Type: application/vscode-jsonrpc\r\nContent-Length: 42") == 42)
}
