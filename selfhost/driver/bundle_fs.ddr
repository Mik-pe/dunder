capability filesystem

import std.fs as fs
import std.path as path
import sys

pub fn is_link(name: string) -> bool { fs.is_symlink(name) }

pub struct Entries { paths: []string, error: string }

pub fn entries(name: string) -> Entries {
    match fs.list_dir(name) {
        .Ok(names) => Entries { paths: names, error: "" },
        .Err(err) => Entries { paths: [], error: "cannot list " + name + ": " + err.message() },
    }
}

pub struct File { data: []u8, error: string }

pub fn contents(name: string) -> File {
    result := sys.read_u8(name)
    if !result.ok { return File { data: [], error: "cannot read resource " + name + ": " + sys.error_message(result.error) } }
    File { data: result.value, error: "" }
}

fn write_resource(name: string, data: &[]u8, executable: bool) -> Result<(), sys.IoError> {
    mut file := fs.temp_file(path.dirname(name), "." + path.basename(name) + "-")?
    file.write_all(&data)?
    file.set_permissions(if executable { u32(493) } else { u32(420) })?
    file.persist(name)
}

pub fn publish(name: string, data: &[]u8, executable: bool) -> string {
    match write_resource(name, &data, executable) {
        .Ok(_) => "",
        .Err(err) => "cannot write " + name + ": " + err.message(),
    }
}
