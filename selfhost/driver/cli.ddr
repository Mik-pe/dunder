// Project and target selection shared by the self-hosted compiler entrypoints.
import sys
import std.parse as decimal
import std.text as text

pub struct Options { workers: i32, workers_set: bool, group: i32, list_groups: bool, incremental: bool, timings: bool, timings_json: bool, scalar_opt: bool, ownership_opt: bool, const_div_opt: bool, frame_free: bool, range_opt: bool, inline_opt: bool, mir_opt: bool, mir_pass: bool, mir_memory: bool, mir_ssa: bool, mir_values: bool, profile_compiler: bool, runtime_profile: bool, run: bool, run_tests: bool, affected: bool, timeout_ms: i64, args: []string, error: string, input: string, output: string, platform: i32, tests: bool, app: bool, checking: bool, agent: bool, dep_names: []string, dep_dirs: []string, dep_entries: []string }
pub fn compiler_version() -> string { "0.1.0" }
pub fn target_name(platform: i32) -> string {
    if platform == 0 { return "arm64-macos" }
    if platform == 1 { return "arm64-linux" }
    if platform == 2 { return "x86_64-linux" }
    "wasm32"
}
fn target_id(name: string) -> i32 {
    for id in 0..4 { if target_name(id) == name { return id } }
    if name == "aarch64-apple-darwin" { return 0 }
    if name == "aarch64-unknown-linux-gnu" { return 1 }
    if name == "x86_64-unknown-linux-gnu" { return 2 }
    if name == "wasm32-unknown-unknown" { return 3 }
    -1
}

fn dir_of(path: string) -> string {
    mut i := path.len
    while i > 0 {
        i = i - 1
        if path[i] == 47 {
            if i == 0 { return "/" }
            return path[0..i]
        }
    }
    "."
}

fn strip_trailing_slashes(path: string) -> string {
    mut end := path.len
    while end > 1 && path[end - 1] == 47 { end = end - 1 }
    if end == path.len { return path.clone() }
    path[0..end]
}

fn path_in(dir: string, path: string) -> string {
    mut rel := strip_trailing_slashes(path)
    if text.starts_with(rel, "/") { return rel }
    while text.starts_with(rel, "./") && rel.len > 2 {
        rel = rel[2..rel.len]
    }
    base := strip_trailing_slashes(dir)
    if base == "." || base == "" { return rel }
    if rel == "." { return base }
    if base == "/" { return "/" + rel }
    base + "/" + rel
}

fn normalize_lexical(path: string) -> string {
    mut parts: []string = []
    absolute := path.len > 0 && path[0] == 47
    mut start := 0
    mut i := 0
    while i <= path.len {
        if i == path.len || path[i] == 47 {
            part := path[start..i]
            if part == ".." {
                if parts.len > 0 && parts[parts.len - 1] != ".." { old := parts.pop() }
                else if !absolute { parts.push(move part) }
            } else if part != "" && part != "." { parts.push(move part) }
            start = i + 1
        }
        i = i + 1
    }
    mut out := ""
    if absolute { out = "/" }
    for idx in 0..parts.len {
        if idx > 0 { out = out + "/" }
        out = out + parts[idx]
    }
    if out == "" { return "." }
    out
}

fn clean_existing_path(path: string) -> string {
    norm := normalize_lexical(path)
    if norm != path && sys.same_file(norm, path) { return norm }
    strip_trailing_slashes(path)
}

fn valid_dep_name(name: string) -> bool {
    if name == "" || name == "sys" || name == "std" { return false }
    first := name[0]
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) { return false }
    for idx in 1..name.len {
        b := name[idx]
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95) { return false }
    }
    true
}

struct ParsedManifest {
    ok: bool, error: string, name: string, root: string, test_root: string,
    dep_names: []string, dep_paths: []string, dep_lines: []i32,
}

fn empty_parsed() -> ParsedManifest {
    ParsedManifest { ok: false, error: "", name: "", root: "", test_root: "", dep_names: [], dep_paths: [], dep_lines: [] }
}

fn parse_manifest(path: string, require_name: bool) -> ParsedManifest {
    mut out := empty_parsed()
    file := sys.read_text(path)
    if !file.ok { out.error = path + ": " + sys.error_message(file.error); return out }
    mut name := ""
    mut version := ""
    mut root := ""
    mut tests := ""
    mut in_deps := false
    mut seen_deps := false
    mut number := 0
    for line in text.split(file.value, "\n") {
        number = number + 1
        field := text.trim(line)
        if field == "" || text.starts_with(field, "#") { continue }
        location := path + ":" + number.str() + ": "
        if text.starts_with(field, "[") {
            if !text.ends_with(field, "]") || field.len < 3 {
                out.error = location + "malformed section header: " + field; return out
            }
            section := text.trim(field[1..field.len - 1])
            if section != "dependencies" {
                out.error = location + "unknown manifest section: " + section; return out
            }
            if seen_deps {
                out.error = location + "duplicate manifest section: dependencies"; return out
            }
            in_deps = true; seen_deps = true
            continue
        }
        split := text.find(field, "=")
        if !in_deps {
            if split < 1 { out.error = location + "expected a quoted name, root or test_root assignment"; return out }
            key := text.trim(field[0..split])
            quoted := text.trim(field[split + 1..field.len])
            if quoted.len < 2 || quoted[0] != 34 || quoted[quoted.len - 1] != 34 {
                out.error = location + "manifest values must be quoted strings"; return out
            }
            value := quoted[1..quoted.len - 1]
            if value == "" { out.error = location + "empty manifest value for " + key; return out }
            if key == "name" && name == "" { name = value }
            else if key == "version" && version == "" { version = value }
            else if key == "root" && root == "" { root = value }
            else if key == "test_root" && tests == "" { tests = value }
            else { out.error = location + "unknown or duplicate manifest field: " + key; return out }
        } else {
            if split < 1 { out.error = location + "expected a quoted dependency path assignment"; return out }
            dep_name := text.trim(field[0..split])
            if dep_name == "sys" || dep_name == "std" {
                out.error = location + "reserved dependency name: " + dep_name; return out
            }
            if !valid_dep_name(dep_name) {
                out.error = location + "invalid dependency name: " + dep_name; return out
            }
            for k in 0..out.dep_names.len {
                if out.dep_names[k] == dep_name { out.error = location + "duplicate dependency: " + dep_name; return out }
            }
            quoted := text.trim(field[split + 1..field.len])
            if quoted.len < 2 || quoted[0] != 34 || quoted[quoted.len - 1] != 34 {
                out.error = location + "manifest values must be quoted strings"; return out
            }
            dep_path := quoted[1..quoted.len - 1]
            if text.find(dep_path, "\"") >= 0 {
                out.error = location + "manifest values must be quoted strings"; return out
            }
            if dep_path == "" {
                out.error = location + "empty manifest value for " + dep_name; return out
            }
            out.dep_names.push(move dep_name)
            out.dep_paths.push(move dep_path)
            out.dep_lines.push(number)
        }
    }
    if require_name && name == "" { out.error = path + ": manifest requires name"; return out }
    if root == "" { out.error = path + ": manifest requires root"; return out }
    for b in name.bytes() {
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 95) {
            out.error = path + ": manifest name must contain only letters, digits, '_' or '-'"; return out
        }
    }
    out.ok = true; out.name = name; out.root = root; out.test_root = tests
    out
}

fn find_manifest_dir(start: string) -> string {
    if !sys.metadata(start).is_dir { return "" }
    mut dir := start.clone()
    while !sys.metadata(dir + "/dunder.toml").is_file {
        parent := dir + "/.."
        if !sys.metadata(parent).is_dir || sys.same_file(dir, parent) { return "" }
        dir = parent
    }
    clean_existing_path(dir)
}

fn resolve_dependencies(manifest_dir: string, toml_path: string, parsed: &ParsedManifest, options: &mut Options, active_dirs: &mut []string) {
    for i in 0..parsed.dep_names.len {
        dep_name := parsed.dep_names[i].clone()
        raw_path := parsed.dep_paths[i].clone()
        location := toml_path + ":" + parsed.dep_lines[i].str() + ": "
        dep_path := clean_existing_path(path_in(manifest_dir, raw_path))
        if !sys.metadata(dep_path).is_dir {
            options.error = location + "dependency directory not found: " + dep_path; return
        }
        for k in 0..active_dirs.len {
            if sys.same_file(active_dirs[k], dep_path) {
                options.error = location + "dependency cycle involving '" + dep_name + "'"; return
            }
        }
        mut dep_dir := dep_path.clone()
        mut dep_entry := ""
        mut has_sub := false
        mut sub := empty_parsed()
        dep_toml := path_in(dep_path, "dunder.toml")
        if sys.metadata(dep_toml).is_file {
            sub = parse_manifest(dep_toml, false)
            if !sub.ok { options.error = sub.error; return }
            dep_entry = clean_existing_path(path_in(dep_path, sub.root))
            dep_dir = clean_existing_path(dir_of(dep_entry))
            if !sys.metadata(dep_dir).is_dir {
                options.error = dep_toml + ": dependency root directory not found: " + dep_dir; return
            }
            has_sub = true
        }
        mut existing := -1
        for k in 0..options.dep_names.len {
            if options.dep_names[k] == dep_name { existing = k; break }
        }
        if existing >= 0 {
            same_dir := options.dep_dirs[existing] == dep_dir || sys.same_file(options.dep_dirs[existing], dep_dir)
            prev_entry := options.dep_entries[existing].clone()
            same_entry := (prev_entry == "" && dep_entry == "") ||
                (prev_entry != "" && dep_entry != "" && (prev_entry == dep_entry || sys.same_file(prev_entry, dep_entry)))
            if !same_dir || !same_entry {
                options.error = location + "conflicting dependency '" + dep_name + "': " + dep_dir + " conflicts with " + options.dep_dirs[existing]; return
            }
            continue
        }
        options.dep_names.push(move dep_name)
        options.dep_dirs.push(move dep_dir)
        options.dep_entries.push(move dep_entry)
        if has_sub && sub.dep_names.len > 0 {
            active_dirs.push(dep_path.clone())
            resolve_dependencies(dep_path, dep_toml, &sub, &mut options, &mut active_dirs)
            discarded := active_dirs.pop()
            if options.error != "" { return }
        }
    }
}

fn load_manifest_deps(options: &mut Options) {
    dir := find_manifest_dir(dir_of(options.input))
    if dir == "" { return }
    path := path_in(dir, "dunder.toml")
    parsed := parse_manifest(path, true)
    if !parsed.ok { options.error = parsed.error; return }
    mut active_dirs: []string = [dir.clone()]
    resolve_dependencies(dir, path, &parsed, &mut options, &mut active_dirs)
}

fn manifest(options: &mut Options) -> string {
    dir := find_manifest_dir(".")
    if dir == "" { options.error = "no dunder.toml found"; return "" }
    path := path_in(dir, "dunder.toml")
    parsed := parse_manifest(path, true)
    if !parsed.ok { options.error = parsed.error; return "" }
    mut root := parsed.root.clone()
    if options.tests && parsed.test_root != "" { root = parsed.test_root.clone() }
    options.input = path_in(dir, root)
    mut active_dirs: []string = [dir.clone()]
    resolve_dependencies(dir, path, &parsed, &mut options, &mut active_dirs)
    if options.error != "" { return "" }
    parsed.name
}

fn stem(path: string) -> string {
    mut start := 0
    mut dot := -1
    for i in 0..path.len {
        if path[i] == 47 { start = i + 1; dot = -1 }
        if path[i] == 46 { dot = i }
    }
    if dot > start { return path[start..dot] }
    path[start..path.len]
}
pub fn options_with_workers(default_target: i32, default_workers: i32) -> Options {
    mut out := Options { workers: default_workers, workers_set: false, group: -1, list_groups: false, incremental: false, timings: false, timings_json: false, scalar_opt: true, ownership_opt: true, const_div_opt: true, frame_free: true, range_opt: true, inline_opt: true, mir_opt: true, mir_pass: true, mir_memory: true, mir_ssa: false, mir_values: true, profile_compiler: false, runtime_profile: false, run: false, run_tests: false, affected: false, timeout_ms: 5000, args: [], error: "", input: "", output: "", platform: default_target, tests: false, app: false, checking: false, agent: false, dep_names: [], dep_dirs: [], dep_entries: [] }
    if default_workers < 1 || default_workers > 256 { out.error = "default worker count must be from 1 to 256"; return out }
    command := sys.arg(1)
    out.run = command == "run"
    out.run_tests = command == "test"
    out.tests = command == "build-tests" || out.run_tests
    out.checking = command == "check"
    if command != "build" && !out.run && !out.tests && !out.checking { out.error = "expected build, build-tests or check"; return out }
    mut target_set := false
    mut workers_set := false
    mut i := 2
    while i < sys.arg_count() {
        value := sys.arg(i)
        if value == "--" && out.run {
            for arg in i+1..sys.arg_count() { out.args.push(sys.arg(arg)) }
            break
        }
        if value == "--jobs" || text.starts_with(value, "--jobs=") {
            if workers_set { out.error = "duplicate --jobs option"; return out }
            workers_set = true
            out.workers_set = true
            mut count := ""
            if value == "--jobs" {
                i = i + 1
                if i >= sys.arg_count() { out.error = "--jobs requires a worker count"; return out }
                count = sys.arg(i)
            } else { count = value[7..value.len] }
            parsed := decimal.integer(count)
            if !parsed.ok || parsed.value < 1 || parsed.value > 256 { out.error = "--jobs must be an integer from 1 to 256"; return out }
            out.workers = i32(parsed.value)
        } else if command == "build-tests" && value == "--list" {
            out.list_groups = true
        } else if command == "build-tests" && value == "--group" {
            i = i + 1
            if i >= sys.arg_count() || out.group >= 0 { out.error = "--group requires a single test ID"; return out }
            id := decimal.integer(sys.arg(i))
            if !id.ok || id.value < 0 || id.value > 2147483647 { out.error = "--group requires a nonnegative test ID"; return out }
            out.group = i32(id.value)
        } else if value == "--incremental" && !out.checking { out.incremental = true }
        else if value == "--timings" { out.timings = true; out.timings_json = false }
        else if value == "--timings=json" { out.timings = true; out.timings_json = true }
        else if value == "--profile-compiler" { out.profile_compiler = true; out.timings = true }
        else if value == "--runtime-profile" && !out.checking { out.runtime_profile = true }
        else if value == "--scalar-opt=off" { out.scalar_opt = false }
        else if value == "--scalar-opt=on" { out.scalar_opt = true }
        else if value == "--ownership-opt=off" { out.ownership_opt = false }
        else if value == "--ownership-opt=on" { out.ownership_opt = true }
        else if value == "--const-div-opt=off" { out.const_div_opt = false }
        else if value == "--const-div-opt=on" { out.const_div_opt = true }
        else if value == "--frame-free=off" { out.frame_free = false }
        else if value == "--frame-free=on" { out.frame_free = true }
        else if value == "--range-opt=off" { out.range_opt = false }
        else if value == "--range-opt=on" { out.range_opt = true }
        else if value == "--inline-opt=off" { out.inline_opt = false }
        else if value == "--inline-opt=on" { out.inline_opt = true }
        else if value == "--mir=off" { out.mir_opt = false }
        else if value == "--mir=on" { out.mir_opt = true }
        else if value == "--mir-opt=off" { out.mir_pass = false }
        else if value == "--mir-opt=on" { out.mir_pass = true }
        else if value == "--mir-memory=off" { out.mir_memory = false }
        else if value == "--mir-memory=on" { out.mir_memory = true }
        else if value == "--mir-ssa=off" { out.mir_ssa = false }
        else if value == "--mir-ssa=on" { out.mir_ssa = true }
        else if value == "--mir-values=off" { out.mir_values = false }
        else if value == "--mir-values=on" { out.mir_values = true }
        else if value == "--affected" && out.run_tests { out.affected = true }
        else if value == "--timeout-ms" && out.run_tests {
            i = i + 1
            if i >= sys.arg_count() { out.error = "--timeout-ms requires milliseconds"; return out }
            parsed := decimal.integer(sys.arg(i))
            if !parsed.ok || parsed.value <= 0 { out.error = "--timeout-ms must be a positive integer"; return out }
            out.timeout_ms = parsed.value
        } else if value == "--agent" && out.checking { out.agent = true }
        else if value == "-o" {
            if out.checking { out.error = "check does not accept an output path"; return out }
            i = i + 1
            if out.output != "" || i >= sys.arg_count() { out.error = "-o requires one output path"; return out }
            out.output = sys.arg(i)
        } else if value == "--app" {
            if out.app { out.error = "duplicate --app option"; return out }
            out.app = true
        } else if value == "--target" {
            i = i + 1
            if target_set || i >= sys.arg_count() { out.error = "--target requires one target"; return out }
            target_set = true; out.platform = target_id(sys.arg(i))
            if out.platform < 0 { out.error = "unsupported target: " + sys.arg(i); return out }
        } else if text.starts_with(value, "-") { out.error = "unknown option: " + value; return out }
        else if out.input == "" { out.input = value }
        else { out.error = "expected a single source file"; return out }
        i = i + 1
    }
    if out.list_groups && (out.group >= 0 || out.output != "") { out.error = "--list cannot select or publish a test image"; return out }
    if out.incremental && out.platform == 3 { out.error = "--incremental requires a native target"; return out }
    if out.app && (out.platform != 0 || out.tests || out.checking) { out.error = "--app requires build with target arm64-macos"; return out }
    mut name := ""
    if out.input == "" { name = manifest(&mut out) } else { load_manifest_deps(&mut out); name = stem(out.input) }
    if out.output == "" {
        if out.platform == 3 { name = name + ".wasm" }
        if out.app { name = name + ".app" }
        mut dir := "build/" + target_name(out.platform)
        if out.tests { dir = dir + "/tests" }
        out.output = dir + "/" + name
    }
    out
}
pub fn prepare_parent(output: string) -> bool {
    for i in 1..output.len {
        if output[i] == 47 && output[i-1] != 47 {
            dir := output[0..i]
            if !sys.metadata(dir).is_dir {
                created := sys.mkdir(dir)
                if !created.ok && !sys.metadata(dir).is_dir { return false }
            }
        }
    }
    true
}

@test fn manifest_dependency_identifiers_and_paths_validate() {
    assert(valid_dep_name("skrift"))
    assert(valid_dep_name("_lib_2"))
    assert(!valid_dep_name(""))
    assert(!valid_dep_name("sys"))
    assert(!valid_dep_name("std"))
    assert(!valid_dep_name("1lib"))
    assert(!valid_dep_name("my-lib"))
    assert(!valid_dep_name("my.lib"))
    assert(!valid_dep_name("å"))
    assert(dir_of("src/main.ddr") == "src")
    assert(dir_of("main.ddr") == ".")
    assert(dir_of("/main.ddr") == "/")
    assert(path_in(".", "../dunder-skrift/") == "../dunder-skrift")
    assert(path_in("..", "./src/main.ddr") == "../src/main.ddr")
    assert(normalize_lexical("../depA/../depB") == "../depB")
    assert(normalize_lexical("src/..") == ".")
}
