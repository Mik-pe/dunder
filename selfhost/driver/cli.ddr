capability filesystem
import sys
import std.parse as decimal
import std.text as text
import budget
import cache_io
import manifest
import dependencies
import paths

pub struct Options { workers: i32, workers_set: bool, group: i32, list_groups: bool, incremental: bool, timings: bool, timings_json: bool, scalar_opt: bool, ownership_opt: bool, const_div_opt: bool, frame_free: bool, range_opt: bool, inline_opt: bool, mir_opt: bool, mir_pass: bool, mir_memory: bool, mir_ssa: bool, mir_values: bool, profile_compiler: bool, runtime_profile: bool, run: bool, run_tests: bool, install: bool, install_dir: string, affected: bool, timeout_ms: i64, args: []string, error: string, input: string, output: string, example: string, platform: i32, tests: bool, app: bool, checking: bool, agent: bool, offline: bool, locked: bool, update: bool, dep_names: []string, dep_dirs: []string, dep_entries: []string, dep_caps: []i32 }
pub fn compiler_version() -> string { "0.7.0" }
pub fn target_name(platform: i32) -> string {
    if platform == 0 { return "arm64-macos" }
    if platform == 1 { return "arm64-linux" }
    if platform == 2 { return "x86_64-linux" }
    "wasm32"
}
fn target_id(name: string) -> i32 {
    for id in 0..4 { if target_name(id) == name { return id } }
    if name == "aarch64-apple-darwin" { return 0 }
    if name == "aarch64-unknown-linux-gnu" { return 1 }
    if name == "x86_64-unknown-linux-gnu" { return 2 }
    if name == "wasm32-unknown-unknown" { return 3 }
    -1
}

fn resolve_project(dir: string, path: string, parsed: &manifest.Manifest, options: &mut Options, host: i32) {
    graph := dependencies.resolve(dir, path, &parsed, options.offline, options.locked, options.update, host)
    if !graph.ok { options.error = graph.error; return }
    options.dep_names = move graph.names; options.dep_dirs = move graph.dirs; options.dep_entries = move graph.entries; options.dep_caps = move graph.caps
}

fn load_manifest_deps(options: &mut Options, host: i32) -> string {
    dir := dependencies.find_manifest_dir(dependencies.dir_of(options.input))
    if dir == "" { return "" }
    path := dependencies.path_in(dir, "dunder.toml")
    parsed := manifest.parse(path, true)
    if !parsed.ok { options.error = parsed.error; return "" }
    resolve_project(dir, path, &parsed, &mut options, host)
    if options.error != "" || parsed.name == "" { return "" }
    root_path := dependencies.path_in(dir.clone(), parsed.root)
    if paths.normalize(options.input.clone()) == paths.normalize(root_path.clone()) || sys.same_file(options.input.clone(), root_path) {
        return parsed.name.clone()
    }
    ""
}

fn project_manifest(options: &mut Options, host: i32) -> string {
    dir := dependencies.find_manifest_dir(".")
    if dir == "" { options.error = "no dunder.toml found"; return "" }
    path := dependencies.path_in(dir, "dunder.toml")
    parsed := manifest.parse(path, true)
    if !parsed.ok { options.error = parsed.error; return "" }
    mut root := parsed.root.clone()
    mut output_name := parsed.name.clone()
    if options.example != "" {
        idx := manifest.find_example(&parsed, options.example)
        if idx < 0 { options.error = path + ": unknown example '" + options.example + "'"; return "" }
        root = parsed.example_paths[idx].clone()
        output_name = options.example.clone()
    } else if options.tests && parsed.test_root != "" {
        root = parsed.test_root.clone()
    }
    options.input = dependencies.path_in(dir, root)
    resolve_project(dir, path, &parsed, &mut options, host)
    if options.error != "" { return "" }
    output_name
}

fn stem(path: string) -> string {
    mut start := 0
    mut dot := -1
    for i in 0..path.len {
        if path[i] == 47 { start = i + 1; dot = -1 }
        if path[i] == 46 { dot = i }
    }
    if dot > start { return path[start..dot] }
    path[start..path.len]
}
fn join_dir(dir: string, leaf: string) -> string {
    mut end := dir.len
    while end > 1 && dir[end - 1] == 47 { end -= 1 }
    if end == 1 && dir[0] == 47 { return "/" + leaf }
    dir[0..end] + "/" + leaf
}
pub fn options_for(default_target: i32, default_workers: i32, supports_workers: bool) -> Options {
    mut out := Options { workers: default_workers, workers_set: false, group: -1, list_groups: false, incremental: false, timings: false, timings_json: false, scalar_opt: true, ownership_opt: true, const_div_opt: true, frame_free: true, range_opt: true, inline_opt: true, mir_opt: true, mir_pass: true, mir_memory: true, mir_ssa: false, mir_values: true, profile_compiler: false, runtime_profile: false, run: false, run_tests: false, install: false, install_dir: "", affected: false, timeout_ms: 5000, args: [], error: "", input: "", output: "", example: "", platform: default_target, tests: false, app: false, checking: false, agent: false, offline: false, locked: false, update: false, dep_names: [], dep_dirs: [], dep_entries: [], dep_caps: [] }
    if default_workers < 0 || default_workers > budget.max_jobs() {
        out.error = "default worker count must be from 0 to " + budget.max_jobs().str(); return out
    }
    command := sys.arg(1)
    out.run = command == "run"
    out.run_tests = command == "test"
    out.tests = command == "build-tests" || out.run_tests
    out.checking = command == "check"
    out.install = command == "install"
    out.update = command == "update"
    if command != "build" && !out.run && !out.tests && !out.checking && !out.install && !out.update {
        out.error = "expected build, run, test, build-tests, check, install or update"; return out
    }
    mut target_set := false
    mut dir_set := false
    mut requested_workers := 0
    mut i := 2
    while i < sys.arg_count() {
        value := sys.arg(i)
        if out.update && value != "--offline" && value != "--locked" {
            out.error = "update accepts only --offline and --locked"; return out
        }
        if value == "--" && out.run {
            for arg in i+1..sys.arg_count() { out.args.push(sys.arg(arg)) }
            break
        }
        if value == "--offline" { out.offline = true }
        else if value == "--locked" { out.locked = true }
        else if value == "--jobs" || text.starts_with(value, "--jobs=") {
            if out.workers_set { out.error = "duplicate --jobs option"; return out }
            out.workers_set = true
            mut count := ""
            if value == "--jobs" {
                i = i + 1
                if i >= sys.arg_count() { out.error = "--jobs requires a worker count"; return out }
                count = sys.arg(i)
            } else { count = value[7..value.len] }
            parsed := budget.parse_jobs_flag(count)
            if !parsed.ok { out.error = parsed.error; return out }
            requested_workers = parsed.jobs
        } else if command == "build-tests" && value == "--list" {
            out.list_groups = true
        } else if command == "build-tests" && value == "--group" {
            i = i + 1
            if i >= sys.arg_count() || out.group >= 0 { out.error = "--group requires a single test ID"; return out }
            id := decimal.integer(sys.arg(i))
            if !id.ok || id.value < 0 || id.value > 2147483647 { out.error = "--group requires a nonnegative test ID"; return out }
            out.group = i32(id.value)
        } else if value == "--incremental" && !out.checking { out.incremental = true }
        else if value == "--timings" { out.timings = true; out.timings_json = false }
        else if value == "--timings=json" { out.timings = true; out.timings_json = true }
        else if value == "--profile-compiler" { out.profile_compiler = true; out.timings = true }
        else if value == "--runtime-profile" && !out.checking { out.runtime_profile = true }
        else if value == "--scalar-opt=off" { out.scalar_opt = false }
        else if value == "--scalar-opt=on" { out.scalar_opt = true }
        else if value == "--ownership-opt=off" { out.ownership_opt = false }
        else if value == "--ownership-opt=on" { out.ownership_opt = true }
        else if value == "--const-div-opt=off" { out.const_div_opt = false }
        else if value == "--const-div-opt=on" { out.const_div_opt = true }
        else if value == "--frame-free=off" { out.frame_free = false }
        else if value == "--frame-free=on" { out.frame_free = true }
        else if value == "--range-opt=off" { out.range_opt = false }
        else if value == "--range-opt=on" { out.range_opt = true }
        else if value == "--inline-opt=off" { out.inline_opt = false }
        else if value == "--inline-opt=on" { out.inline_opt = true }
        else if value == "--mir=off" { out.mir_opt = false }
        else if value == "--mir=on" { out.mir_opt = true }
        else if value == "--mir-opt=off" { out.mir_pass = false }
        else if value == "--mir-opt=on" { out.mir_pass = true }
        else if value == "--mir-memory=off" { out.mir_memory = false }
        else if value == "--mir-memory=on" { out.mir_memory = true }
        else if value == "--mir-ssa=off" { out.mir_ssa = false }
        else if value == "--mir-ssa=on" { out.mir_ssa = true }
        else if value == "--mir-values=off" { out.mir_values = false }
        else if value == "--mir-values=on" { out.mir_values = true }
        else if value == "--affected" && out.run_tests { out.affected = true }
        else if value == "--timeout-ms" && out.run_tests {
            i = i + 1
            if i >= sys.arg_count() { out.error = "--timeout-ms requires milliseconds"; return out }
            parsed := decimal.integer(sys.arg(i))
            if !parsed.ok || parsed.value <= 0 { out.error = "--timeout-ms must be a positive integer"; return out }
            out.timeout_ms = parsed.value
        } else if value == "--agent" && out.checking { out.agent = true }
        else if value == "-o" {
            if out.checking { out.error = "check does not accept an output path"; return out }
            if out.install { out.error = "install uses --dir or --prefix instead of -o"; return out }
            i = i + 1
            if out.output != "" || i >= sys.arg_count() { out.error = "-o requires one output path"; return out }
            out.output = sys.arg(i)
        } else if value == "--dir" || text.starts_with(value, "--dir=") || value == "--prefix" || text.starts_with(value, "--prefix=") {
            is_prefix := value == "--prefix" || text.starts_with(value, "--prefix=")
            flag_name := if is_prefix { "--prefix" } else { "--dir" }
            if !out.install { out.error = flag_name + " is supported only for install"; return out }
            if dir_set { out.error = "cannot combine or duplicate --dir and --prefix"; return out }
            dir_set = true
            mut selected := ""
            if value == flag_name {
                i = i + 1
                if i >= sys.arg_count() { out.error = flag_name + " requires a directory"; return out }
                selected = sys.arg(i)
            } else {
                selected = value[(flag_name.len + 1)..value.len]
            }
            if selected == "" { out.error = flag_name + " requires a non-empty directory"; return out }
            out.install_dir = if is_prefix { join_dir(selected, "bin") } else { selected }
        } else if value == "--app" {
            if out.app { out.error = "duplicate --app option"; return out }
            out.app = true
        } else if value == "--example" || text.starts_with(value, "--example=") {
            if command != "build" && !out.run && !out.checking && !out.install {
                out.error = "--example is supported only for build, run, check and install"; return out
            }
            if out.example != "" { out.error = "duplicate --example option"; return out }
            mut selected := ""
            if value == "--example" {
                i = i + 1
                if i >= sys.arg_count() { out.error = "--example requires an example name"; return out }
                selected = sys.arg(i)
                if selected == "" || text.starts_with(selected, "-") {
                    out.error = "--example requires an example name"; return out
                }
            } else {
                selected = value[10..value.len]
                if selected == "" { out.error = "--example requires an example name"; return out }
            }
            if !manifest.valid_example_name(selected) {
                out.error = "invalid example name: " + selected; return out
            }
            out.example = move selected
        } else if value == "--target" {
            i = i + 1
            if target_set || i >= sys.arg_count() { out.error = "--target requires one target"; return out }
            target_set = true; out.platform = target_id(sys.arg(i))
            if out.platform < 0 { out.error = "unsupported target: " + sys.arg(i); return out }
        } else if text.starts_with(value, "-") { out.error = "unknown option: " + value; return out }
        else if out.input == "" { out.input = value }
        else { out.error = "expected a single source file"; return out }
        i = i + 1
    }
    resolved_workers := budget.resolve_jobs(default_target, requested_workers, out.workers_set, default_workers, supports_workers)
    if !resolved_workers.ok { out.error = resolved_workers.error; return out }
    out.workers = resolved_workers.jobs
    if out.list_groups && (out.group >= 0 || out.output != "") { out.error = "--list cannot select or publish a test image"; return out }
    if out.incremental && out.platform == 3 { out.error = "--incremental requires a native target"; return out }
    if out.app && (out.platform != 0 || out.tests || out.checking || out.install) { out.error = "--app requires build with target arm64-macos"; return out }
    if out.example != "" && out.input != "" { out.error = "--example cannot be combined with a source file"; return out }
    mut name := ""
    if out.input == "" { name = project_manifest(&mut out, default_target) } else {
        manifest_name := load_manifest_deps(&mut out, default_target)
        name = if manifest_name != "" { manifest_name } else { stem(out.input) }
    }
    if out.error != "" { return out }
    if out.update { return out }
    if out.install {
        if out.install_dir == "" {
            self_path := cache_io.self_executable(default_target)
            if self_path == "" { out.error = "cannot locate dunder executable directory for install"; return out }
            out.install_dir = paths.parent(self_path)
        }
        out.output = join_dir(out.install_dir, name)
        return out
    }
    if out.output == "" {
        if out.platform == 3 { name = name + ".wasm" }
        if out.app { name = name + ".app" }
        mut dir := "build/" + target_name(out.platform)
        if out.tests { dir = dir + "/tests" }
        else if out.example != "" { dir = dir + "/examples" }
        out.output = dir + "/" + name
    }
    out
}
pub fn prepare_parent(output: string) -> bool {
    for i in 1..output.len {
        if output[i] == 47 && output[i-1] != 47 {
            dir := output[0..i]
            if !sys.metadata(dir).is_dir {
                created := sys.mkdir(dir)
                if !created.ok && !sys.metadata(dir).is_dir { return false }
            }
        }
    }
    true
}
