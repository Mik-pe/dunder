import ...stdlib.path.lexical as path

pub fn parent(p: string) -> string { path.dirname(p) }

pub fn is_absolute(p: string) -> bool { path.is_absolute(p) }
pub fn join(dir: string, child: string) -> string { path.join(dir, child) }
pub fn stem(p: string) -> string { path.stem(p) }
pub fn root(p: string) -> string { path.root(p) }

pub fn normalize(p: string) -> string {
    if p == "" { return "." }
    path.normalize(p)
}
