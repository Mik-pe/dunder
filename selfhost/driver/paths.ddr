import std.bytes as bytes

pub fn parent(path: string) -> string {
    mut end := path.len
    while end > 0 {
        end -= 1
        if path[end] == 47 {
            if end == 0 { return "/" }
            return path[0..end]
        }
    }
    "."
}

pub fn normalize(path: string) -> string {
    absolute := path.len > 0 && path[0] == 47
    mut parts: []string = []
    mut start := 0
    for end in 0..(path.len + 1) {
        if end < path.len && path[end] != 47 { continue }
        part := path[start..end]
        if part == ".." {
            if parts.len > 0 && parts[parts.len - 1] != ".." { _ := parts.pop() }
            else if !absolute { parts.push(move part) }
        } else if part != "" && part != "." { parts.push(move part) }
        start = end + 1
    }
    if parts.len == 0 { return if absolute { "/" } else { "." } }
    mut result: []u8 = []
    result.reserve(path.len)
    if absolute { result.push(b'/') }
    for i in 0..parts.len {
        if i > 0 { result.push(b'/') }
        bytes.append_utf8(&mut result, parts[i])
    }
    bytes.decode(&result).value
}
