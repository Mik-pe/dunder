import cli
import std.json as json
import stderr
import compiler_profile as profile

pub struct Inlining {
    enabled: bool, entries: i32, nodes: i32, tokens: i32, units: i32,
    calls: i32, words: i32, estimated_words: i32,
}
pub fn inlining() -> Inlining { Inlining { enabled: false, entries: 0, nodes: 0,
    tokens: 0, units: 0, calls: 0, words: 0, estimated_words: 0 } }
pub struct Backend {
    worker_scalar: i32, worker_general: i32, frontend_workers: i32, source_windows: i32,
    peak_jobs: i32, enabled: bool, functions: i32, operations: i32, opaque: i32,
    optimization_enabled: bool, source_objects_enabled: bool, private_memory_ops: i32,
    optimized: i32, promoted: i32, removed_loads: i32, removed_stores: i32, analysis_units: i64,
    budget_refusals: i32, ssa_enabled: bool, ssa_optimized: i32, ssa_cells: i32, ssa_values: i32,
    ssa_parameters: i32, ssa_registers: i32, ssa_captures: i32, ssa_stack_groups: i32,
    ssa_removed_loads: i32, ssa_removed_stores: i32, ssa_removed_pushes: i32,
    ssa_removed_pops: i32, ssa_copies: i32, ssa_analysis_units: i64, ssa_budget_refusals: i32,
    values_enabled: bool, values_optimized: i32, value_rewrites: i32, value_deleted: i32,
    value_immediates: i32, value_analysis_units: i64, value_budget_refusals: i32,
}

pub fn backend() -> Backend {
    Backend {
        worker_scalar: 0, worker_general: 0, frontend_workers: 0, source_windows: 0, peak_jobs: 0,
        enabled: false, functions: 0, operations: 0, opaque: 0, optimization_enabled: false,
        source_objects_enabled: false, private_memory_ops: 0, optimized: 0, promoted: 0,
        removed_loads: 0, removed_stores: 0, analysis_units: 0, budget_refusals: 0,
        ssa_enabled: false, ssa_optimized: 0, ssa_cells: 0, ssa_values: 0, ssa_parameters: 0,
        ssa_registers: 0, ssa_captures: 0, ssa_stack_groups: 0, ssa_removed_loads: 0,
        ssa_removed_stores: 0, ssa_removed_pushes: 0, ssa_removed_pops: 0, ssa_copies: 0,
        ssa_analysis_units: 0, ssa_budget_refusals: 0, values_enabled: false, values_optimized: 0,
        value_rewrites: 0, value_deleted: 0, value_immediates: 0, value_analysis_units: 0,
        value_budget_refusals: 0,
    }
}

fn write_backend(out: &mut []u8, first: &mut bool, data: &Backend) {
    mut field := json.begin_field_obj(&mut out, &mut first, "mir")
    json.field_bool(&mut out, &mut field, "enabled", data.enabled)
    json.field_i32(&mut out, &mut field, "functions", data.functions)
    json.field_i32(&mut out, &mut field, "operations", data.operations)
    json.field_i32(&mut out, &mut field, "opaque", data.opaque)
    json.field_bool(&mut out, &mut field, "optimization_enabled", data.optimization_enabled)
    json.field_bool(&mut out, &mut field, "source_objects_enabled", data.source_objects_enabled)
    json.field_i32(&mut out, &mut field, "private_memory_ops", data.private_memory_ops)
    json.field_i32(&mut out, &mut field, "optimized", data.optimized)
    json.field_i32(&mut out, &mut field, "promoted", data.promoted)
    json.field_i32(&mut out, &mut field, "removed_loads", data.removed_loads)
    json.field_i32(&mut out, &mut field, "removed_stores", data.removed_stores)
    json.field_i64(&mut out, &mut field, "analysis_units", data.analysis_units)
    json.field_i32(&mut out, &mut field, "budget_refusals", data.budget_refusals)
    json.field_bool(&mut out, &mut field, "ssa_enabled", data.ssa_enabled)
    json.field_i32(&mut out, &mut field, "ssa_optimized", data.ssa_optimized)
    json.field_i32(&mut out, &mut field, "ssa_cells", data.ssa_cells)
    json.field_i32(&mut out, &mut field, "ssa_values", data.ssa_values)
    json.field_i32(&mut out, &mut field, "ssa_parameters", data.ssa_parameters)
    json.field_i32(&mut out, &mut field, "ssa_registers", data.ssa_registers)
    json.field_i32(&mut out, &mut field, "ssa_captures", data.ssa_captures)
    json.field_i32(&mut out, &mut field, "ssa_stack_groups", data.ssa_stack_groups)
    json.field_i32(&mut out, &mut field, "ssa_removed_loads", data.ssa_removed_loads)
    json.field_i32(&mut out, &mut field, "ssa_removed_stores", data.ssa_removed_stores)
    json.field_i32(&mut out, &mut field, "ssa_removed_pushes", data.ssa_removed_pushes)
    json.field_i32(&mut out, &mut field, "ssa_removed_pops", data.ssa_removed_pops)
    json.field_i32(&mut out, &mut field, "ssa_copies", data.ssa_copies)
    json.field_i64(&mut out, &mut field, "ssa_analysis_units", data.ssa_analysis_units)
    json.field_i32(&mut out, &mut field, "ssa_budget_refusals", data.ssa_budget_refusals)
    json.field_bool(&mut out, &mut field, "values_enabled", data.values_enabled)
    json.field_i32(&mut out, &mut field, "values_optimized", data.values_optimized)
    json.field_i32(&mut out, &mut field, "value_rewrites", data.value_rewrites)
    json.field_i32(&mut out, &mut field, "value_deleted", data.value_deleted)
    json.field_i32(&mut out, &mut field, "value_immediates", data.value_immediates)
    json.field_i64(&mut out, &mut field, "value_analysis_units", data.value_analysis_units)
    json.field_i32(&mut out, &mut field, "value_budget_refusals", data.value_budget_refusals)
    json.end_obj(&mut out)
}

fn write_inlining(out: &mut []u8, first: &mut bool, data: &Inlining) {
    mut field := json.begin_field_obj(&mut out, &mut first, "inlining")
    json.field_bool(&mut out, &mut field, "enabled", data.enabled)
    json.field_i32(&mut out, &mut field, "entries", data.entries)
    json.field_i32(&mut out, &mut field, "nodes", data.nodes)
    json.field_i32(&mut out, &mut field, "tokens", data.tokens)
    json.field_i32(&mut out, &mut field, "units", data.units)
    json.field_i32(&mut out, &mut field, "calls", data.calls)
    json.field_i32(&mut out, &mut field, "words", data.words)
    json.field_i32(&mut out, &mut field, "estimated_words", data.estimated_words)
    json.end_obj(&mut out)
}

fn write_duration(out: &mut []u8, first: &mut bool, name: string, start: i64, end: i64) {
    if start < 0 || end < start { json.field_null(&mut out, &mut first, name) }
    else { json.field_i64(&mut out, &mut first, name, end - start) }
}

fn milliseconds(first: i64, last: i64) -> string {
    if first < 0 || last < first { return "unavailable" }
    micros := (last - first) / 1000
    fraction := (micros % 1000).str()
    padding := if fraction.len == 1 { "00" } else if fraction.len == 2 { "0" } else { "" }
    f"{micros / 1000}.{padding}{fraction} ms"
}
pub struct MirFunction { name: string, path: string, line: i32, elapsed: i64, operations: i32 }
pub fn report(json_output: bool, checking: bool, target: i32, modules: i32, reused: i32, emitted: i32,
    started: i64, loaded: i64, setup: i64, compiled: i64, image: i64, published: i64,
    enabled: bool, modeled: i32, optimized: i32, rewrites: i32, bounds: i32, fallbacks: i32, details: &profile.Profile, inline_data: &Inlining, backend_data: &Backend, slowest: &[]MirFunction) {
    valid := started >= 0 && loaded >= started && setup >= loaded && compiled >= setup && image >= compiled && published >= image
    if json_output {
        mut out: []u8 = []
        mut first := json.begin_obj(&mut out)
        json.field_str(&mut out, &mut first, "kind", "timings")
        json.field_i32(&mut out, &mut first, "version", 1)
        json.field_str(&mut out, &mut first, "operation", if checking { "check" } else { "build" })
        json.field_str(&mut out, &mut first, "scope", "compiler_pipeline")
        json.field_str(&mut out, &mut first, "clock", "monotonic")
        json.field_bool(&mut out, &mut first, "clock_ok", valid)
        json.field_str(&mut out, &mut first, "unit", "ns")
        json.field_str(&mut out, &mut first, "target", cli.target_name(target))
        json.field_i32(&mut out, &mut first, "modules", modules)

        mut functions := json.begin_field_obj(&mut out, &mut first, "functions")
        json.field_i32(&mut out, &mut functions, "reused", reused)
        json.field_i32(&mut out, &mut functions, "emitted", emitted)
        json.end_obj(&mut out)

        mut phases := json.begin_field_obj(&mut out, &mut first, "phases")
        write_duration(&mut out, &mut phases, "module_load_lex_resolve", started, loaded)
        write_duration(&mut out, &mut phases, "build_setup", loaded, setup)
        write_duration(&mut out, &mut phases, "compiler", setup, compiled)
        write_duration(&mut out, &mut phases, "image_format_sign", compiled, image)
        write_duration(&mut out, &mut phases, "publication", image, published)
        json.end_obj(&mut out)

        mut skipped := json.begin_field_arr(&mut out, &mut first, "skipped_phases")
        if checking {
            for phase in ["image_format_sign", "publication"] {
                json.sep_elem(&mut out, &mut skipped)
                json.write_str(&mut out, phase)
            }
        }
        json.end_arr(&mut out)
        write_duration(&mut out, &mut first, "total", started, published)

        mut optimizer := json.begin_field_obj(&mut out, &mut first, "optimizer")
        json.field_bool(&mut out, &mut optimizer, "enabled", enabled)
        json.field_i32(&mut out, &mut optimizer, "modeled", modeled)
        json.field_i32(&mut out, &mut optimizer, "emitted", optimized)
        json.field_i32(&mut out, &mut optimizer, "rewrites", rewrites)
        json.field_i32(&mut out, &mut optimizer, "proven_bounds", bounds)
        json.field_i32(&mut out, &mut optimizer, "fallbacks", fallbacks)
        json.end_obj(&mut out)
        mut frontend := json.begin_field_obj(&mut out, &mut first, "frontend")
        json.field_i32(&mut out, &mut frontend, "scalar_bodies", backend_data.worker_scalar)
        json.field_i32(&mut out, &mut frontend, "general_bodies", backend_data.worker_general)
        json.field_i32(&mut out, &mut frontend, "workers_used", backend_data.frontend_workers)
        json.field_i32(&mut out, &mut frontend, "windows", backend_data.source_windows)
        json.field_i32(&mut out, &mut frontend, "peak_total_jobs", backend_data.peak_jobs)
        json.end_obj(&mut out)
        write_inlining(&mut out, &mut first, &inline_data)
        write_backend(&mut out, &mut first, &backend_data)
        if details.enabled {
            mut detail := json.begin_field_obj(&mut out, &mut first, "compiler_detail")
            compiler_ns: i64 = if setup >= 0 && compiled >= setup { compiled - setup } else { -1 }
            profile.write_fields(&mut out, &mut detail, &details, compiler_ns)
            mut list := json.begin_field_arr(&mut out, &mut detail, "slowest_mir_functions")
            for item in &slowest {
                json.sep_elem(&mut out, &mut list)
                mut row := json.begin_obj(&mut out)
                json.field_str(&mut out, &mut row, "function", item.name)
                json.field_str(&mut out, &mut row, "path", item.path)
                json.field_i32(&mut out, &mut row, "line", item.line)
                json.field_i64(&mut out, &mut row, "elapsed_ns", item.elapsed)
                json.field_i32(&mut out, &mut row, "operations", item.operations)
                json.end_obj(&mut out)
            }
            json.end_arr(&mut out)
            json.end_obj(&mut out)
        }
        json.end_obj(&mut out)
        _ := stderr.eprint(json.finish_text(&out))
        return
    }
    _ := stderr.eprint(f"functions {reused} reused, {emitted} emitted")
    if enabled {
        _ := stderr.eprint(f"scalar optimizer {modeled} modeled, {optimized} emitted, {rewrites} rewrites, {bounds} proven bounds, {fallbacks} fallbacks")
    }
    if inline_data.enabled {
        _ := stderr.eprint(f"inline optimizer {inline_data.entries} entries, {inline_data.calls} calls, " +
            f"{inline_data.words} emitted words, {inline_data.estimated_words} charged words")
    }
    if backend_data.enabled {
        _ := stderr.eprint(f"MIR {backend_data.functions} functions, {backend_data.operations} operations, {backend_data.opaque} opaque barriers")
    }
    if !valid {
        _ := stderr.eprint("timings unavailable: monotonic clock failed or moved backwards")
        return
    }
    _ := stderr.eprint(f"timings module_load_lex_resolve={milliseconds(started, loaded)} build_setup={milliseconds(loaded, setup)}" +
        f" compiler={milliseconds(setup, compiled)} image_format_sign={milliseconds(compiled, image)}" +
        f" publication={milliseconds(image, published)} total={milliseconds(started, published)}")
    if details.enabled {
        for phase in 0..details.elapsed.len {
            elapsed := if details.clock_ok { milliseconds(0, details.elapsed[phase]) } else { "unavailable" }
            _ := stderr.eprint(f"compiler {profile.phase_name(phase)}={elapsed} calls={details.calls[phase]} work={details.work[phase]}")
        }
        for item in &slowest {
            _ := stderr.eprint(f"MIR {milliseconds(0, item.elapsed)}  {item.path}:{item.line}  {item.name}  {item.operations} operations")
        }
    }
}
