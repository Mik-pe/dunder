fn slowest_mir_functions(loaded: &modules.Loaded, records: &compiler.Bindings) -> []timings.MirFunction {
    mut slowest: []timings.MirFunction = []
    for sample in &records.profile.slowest {
        loc := modules.location(&loaded, sample.offset)
        line := diag.line_col(loc.source, loc.offset).line
        name := agent.clean_debug_name(sample.name, &loaded.symbols)
        slowest.push(timings.MirFunction { name: name, path: loc.path, line: line, elapsed: sample.elapsed, operations: sample.operations })
    }
    slowest
}

fn inline_counts(options: &cli.Options, records: &compiler.Bindings) -> timings.Inlining {
    mut data := timings.inlining()
    data.enabled = options.inline_opt && options.scalar_opt && !options.checking
    data.entries = records.inline_entries; data.nodes = records.inline_nodes
    data.tokens = records.inline_tokens; data.units = records.inline_units
    data.calls = records.inlined_calls; data.words = records.inlined_words
    data.estimated_words = records.inline_estimated_words
    data
}

fn backend_counts(options: &cli.Options, records: &compiler.Bindings) -> timings.Backend {
    mut data := timings.backend(); data.enabled = !options.checking
    data.worker_scalar = records.worker_scalar; data.worker_general = records.worker_general; data.frontend_workers = records.frontend_workers; data.source_windows = records.source_windows; data.peak_jobs = records.peak_jobs
    data.functions = records.mir_functions; data.operations = records.mir_operations; data.opaque = records.mir_opaque
    data.optimization_enabled = records.mir_optimization_enabled; data.optimized = records.mir_optimized; data.promoted = records.mir_promoted
    data.source_objects_enabled = records.mir_source_objects_enabled; data.private_memory_ops = records.mir_private_memory_ops
    data.removed_loads = records.mir_removed_loads; data.removed_stores = records.mir_removed_stores
    data.analysis_units = records.mir_analysis_units; data.budget_refusals = records.mir_budget_refusals
    data.ssa_enabled = records.mir_ssa_enabled
    data.ssa_optimized = records.mir_ssa_optimized
    data.ssa_cells = records.mir_ssa_cells
    data.ssa_values = records.mir_ssa_values
    data.ssa_parameters = records.mir_ssa_parameters
    data.ssa_registers = records.mir_ssa_registers
    data.ssa_captures = records.mir_ssa_captures
    data.ssa_stack_groups = records.mir_ssa_stack_groups
    data.ssa_removed_loads = records.mir_ssa_removed_loads
    data.ssa_removed_stores = records.mir_ssa_removed_stores
    data.ssa_removed_pushes = records.mir_ssa_removed_pushes
    data.ssa_removed_pops = records.mir_ssa_removed_pops
    data.ssa_copies = records.mir_ssa_copies
    data.ssa_analysis_units = records.mir_ssa_analysis_units
    data.ssa_budget_refusals = records.mir_ssa_budget_refusals
    data.values_enabled = records.mir_values_enabled; data.values_optimized = records.mir_values_optimized
    data.value_rewrites = records.mir_value_rewrites; data.value_deleted = records.mir_value_deleted; data.value_immediates = records.mir_value_immediates
    data.value_analysis_units = records.mir_value_analysis_units; data.value_budget_refusals = records.mir_value_budget_refusals; data
}

fn emit_human_diagnostics(loaded: &modules.Loaded, items: &[]diag.Diagnostic, capture: bool) -> string {
    mut messages: []string = []
    for i in 0..items.len {
        d := &items[i]
        src := agent.source_for_path(&loaded, d.path)
        note_src := if d.note_path != "" { agent.source_for_path(&loaded, d.note_path) } else { "" }
        message := diag.render_human(&d, src, note_src)
        _ := stderr.eprint(message)
        if capture { messages.push(move message) }
    }
    array.join(&messages, "\n")
}

fn build_dwarf_bundle(loaded: &modules.Loaded, dbg: &compiler.DebugData, text_len: i32, platform: i32, input_path: string, macho_text_off: i32) -> dwarf.Bundle {
    base: i64 = if platform == 0 { 4294967296 + i64(macho_text_off) } else { 4194304 + 4096 }
    mut files: []string = []
    mut file_map := Map<string, i64>::new()
    for p in &loaded.paths {
        mut chosen := p.clone()
        if chosen.len > 0 && chosen[0] != 60 {
            rp := fs.realpath(chosen)
            if rp.ok { chosen = rp.value }
        }
        mut idx := file_map.get_or(chosen, 0)
        if idx == 0 {
            files.push(chosen.clone())
            idx = i64(files.len)
            file_map.put(move chosen, idx)
        }
        if file_map.get_or(p, 0) == 0 { file_map.put(p.clone(), idx) }
    }
    if files.len == 0 {
        files.push(input_path.clone())
        file_map.put(input_path.clone(), 1)
    }
    wd := fs.cwd()
    comp_dir := if wd.ok && wd.value != "" { wd.value } else { "." }
    main_rp := fs.realpath(input_path)
    main_file := if main_rp.ok { main_rp.value } else { input_path.clone() }

    mut funcs: []dwarf.FunctionInfo = []
    for f in &dbg.functions {
        if f.end_byte <= f.start_byte || f.start_byte < 0 || f.end_byte > text_len { continue }
        loc := modules.location(&loaded, f.source_offset)
        lc := diag.line_col(loc.source, loc.offset)
        fidx := i32(file_map.get_or(loc.path, 1))
        fname := agent.clean_debug_name(f.name, &loaded.symbols)
        funcs.push(dwarf.FunctionInfo {
            name: fname,
            file_index: fidx,
            line: lc.line,
            low_pc: base + i64(f.start_byte),
            high_pc: base + i64(f.end_byte),
        })
    }

    mut lines: []dwarf.LineInfo = []
    for l in &dbg.lines {
        if l.byte_offset < 0 || l.byte_offset >= text_len { continue }
        loc := modules.location(&loaded, l.source_offset)
        lc := diag.line_col(loc.source, loc.offset)
        fidx := i32(file_map.get_or(loc.path, 1))
        lines.push(dwarf.LineInfo {
            address: base + i64(l.byte_offset),
            file_index: fidx,
            line: lc.line,
            column: lc.column,
        })
    }

    input := dwarf.Input {
        producer: "dunder " + cli.compiler_version(),
        comp_dir: comp_dir,
        main_file: main_file,
        files: files,
        low_pc: base,
        high_pc: base + i64(text_len),
        functions: funcs,
        lines: lines,
    }
    dwarf.build(&input)
}

pub struct EmitterConfig {
    macho: macho.MachoConfig,
    elf: elf.ElfConfig,
    pe: pe.PeConfig,
    bundle: bundle.BundleConfig,
}

pub fn default_emitter_config() -> EmitterConfig {
    EmitterConfig {
        macho: macho.default_config(),
        elf: elf.default_config(),
        pe: pe.default_config(),
        bundle: bundle.default_config(),
    }
}

fn resolve_project_path(project_dir: string, raw: string) -> string {
    if raw == "" || paths.is_absolute(raw) || project_dir == "" { return raw.clone() }
    paths.join(project_dir, raw)
}

fn resolve_lib_overrides(entries: &[]manifest.NativeLibOverride, platform: i32) -> []imports.LibraryOverride {
    mut keys: []string = []
    mut best_idx: []i32 = []
    mut best_prio: []i32 = []
    for i in 0..entries.len {
        entry := &entries[i]
        if !manifest.target_key_matches(platform, entry.target) { continue }
        prio := manifest.target_key_priority(entry.target)
        mut found := -1
        for k in 0..keys.len {
            if keys[k] == entry.key { found = k; break }
        }
        if found < 0 {
            keys.push(entry.key.clone())
            best_idx.push(i)
            best_prio.push(prio)
        } else if prio >= best_prio[found] {
            best_idx[found] = i
            best_prio[found] = prio
        }
    }
    mut out: []imports.LibraryOverride = []
    out.reserve(best_idx.len)
    for idx in &best_idx {
        e := &entries[idx]
        out.push(imports.LibraryOverride {
            key: e.key.clone(),
            path: e.path.clone(),
            framework: e.framework.clone(),
            soname: e.soname.clone(),
            dll: e.dll.clone(),
            weak: e.weak,
            delay: e.delay,
        })
    }
    out
}

fn build_emitter_config(options: &cli.Options, platform: i32, err: &mut string) -> EmitterConfig {
    mut cfg := default_emitter_config()
    project_dir := if options.deps.pkg_dirs.len > 0 { options.deps.pkg_dirs[0].clone() } else { "" }

    mut rpaths: []string = []
    for rp in &options.native_config.rpath { rpaths.push(rp.clone()) }
    for rp in &options.rpaths { rpaths.push(rp.clone()) }

    libc_str := if options.libc != "" { options.libc.clone() } else { options.native_config.libc.clone() }
    libc: imports.LibcAbi = if libc_str == "musl" { .Musl } else { .Glibc }

    overrides := resolve_lib_overrides(&options.native_libs, platform)

    mut entitlements_xml := ""
    if platform == 0 && options.app_config.entitlements != "" {
        ent_path := resolve_project_path(project_dir.clone(), options.app_config.entitlements.clone())
        ent_file := sys.read_text(ent_path.clone())
        if !ent_file.ok {
            err = "cannot read entitlements file " + ent_path + ": " + sys.error_message(ent_file.error)
            return cfg
        }
        entitlements_xml = ent_file.value
    }

    cfg.macho.rpaths = rpaths.clone()
    cfg.macho.entitlements = entitlements_xml.clone()
    if options.app_config.bundle_id != "" {
        cfg.macho.identifier = options.app_config.bundle_id.clone()
    }
    cfg.macho.overrides = overrides.clone()

    cfg.elf.libc = libc
    cfg.elf.rpaths = rpaths.clone()
    cfg.elf.overrides = overrides.clone()

    sub_str := if options.subsystem != "" { options.subsystem.clone() } else { options.app_config.subsystem.clone() }
    if sub_str == "gui" { cfg.pe.subsystem = pe.subsystem_gui() }
    else { cfg.pe.subsystem = pe.subsystem_console() }
    if options.app_config.dpi_aware_set { cfg.pe.dpi_aware = options.app_config.dpi_aware }
    if options.app_config.utf8_set { cfg.pe.utf8_codepage = options.app_config.utf8 }
    cfg.pe.overrides = overrides

    cfg.bundle.bundle_id = options.app_config.bundle_id.clone()
    cfg.bundle.entitlements = entitlements_xml
    for fw in &options.app_config.frameworks {
        cfg.bundle.frameworks.push(resolve_project_path(project_dir.clone(), fw.clone()))
    }
    cfg
}

fn emit_native_image(loaded: &modules.Loaded, result: &compiler.Result, platform: i32,
                     debug_info: bool, input_path: string, signer: &macho.Signer,
                     emitter: &EmitterConfig) -> []u8 {
    has_dynamic := result.imports.symbols.len > 0 || result.imports.globals > 0
    macho_dynamic := has_dynamic || emitter.macho.rpaths.len > 0 || emitter.macho.entitlements != ""
    specs := if result.imports.specs.len == result.imports.symbols.len && result.imports.specs.len > 0 {
        result.imports.specs.clone()
    } else {
        imports.from_legacy(&result.imports.libraries, &result.imports.symbols, result.imports.env_source_slot)
    }
    if debug_info {
        macho_text_off := if platform == 0 && macho_dynamic {
            macho.dynamic_text_offset_for(&specs, result.imports.globals, true, &emitter.macho)
        } else {
            macho.code_page_bytes()
        }
        dbg_bundle := build_dwarf_bundle(&loaded, &result.debug, result.text.len, platform, input_path, macho_text_off)
        if platform == 0 {
            if macho_dynamic {
                return macho.dynamic_storage_debug_configured(&result.text, &specs, &result.imports.sites, &result.imports.slots, result.imports.globals, &dbg_bundle, &emitter.macho, &signer)
            }
            return macho.image_debug_using(&result.text, &dbg_bundle, &signer)
        } else if platform == 2 {
            base_elf := if has_dynamic {
                elf.dynamic_image_configured(&result.text, &specs, &result.imports.sites, &result.imports.slots, 62, result.imports.globals, &emitter.elf)
            } else {
                elf.image_for(&result.text, 62)
            }
            return elf.attach_debug(&base_elf, result.text.len, &dbg_bundle)
        } else {
            base_elf := if has_dynamic {
                elf.dynamic_image_configured(&result.text, &specs, &result.imports.sites, &result.imports.slots, 183, result.imports.globals, &emitter.elf)
            } else {
                elf.image(&result.text)
            }
            return elf.attach_debug(&base_elf, result.text.len, &dbg_bundle)
        }
    }
    if platform == 5 {
        return pe.image_configured(&result.text, &specs, &result.imports.sites, &result.imports.slots, result.imports.globals, &emitter.pe)
    }
    if platform == 0 {
        if macho_dynamic {
            return macho.dynamic_storage_configured(&result.text, &specs, &result.imports.sites, &result.imports.slots, result.imports.globals, &emitter.macho, &signer)
        }
        return macho.image_using(&result.text, &signer)
    }
    if has_dynamic {
        if platform == 2 {
            return elf.dynamic_image_configured(&result.text, &specs, &result.imports.sites, &result.imports.slots, 62, result.imports.globals, &emitter.elf)
        }
        return elf.dynamic_image_configured(&result.text, &specs, &result.imports.sites, &result.imports.slots, 183, result.imports.globals, &emitter.elf)
    }
    if platform == 2 { return elf.image_for(&result.text, 62) }
    elf.image(&result.text)
}

struct ParseChunkIn {
    indices: []i32,
    paths: []string,
    sources: []string,
    caps: []i32,
}

struct ParseChunkOut {
    mods: []hir_body.ModuleInput,
}

fn parse_chunk_worker(move chunk: ParseChunkIn) -> ParseChunkOut {
    mut out: []hir_body.ModuleInput = []
    out.reserve(chunk.indices.len)
    for k in 0..chunk.indices.len {
        p := chunk.paths[k].clone()
        s := chunk.sources[k].clone()
        tree := parser.parse_source(p.clone(), s.clone())
        out.push(hir_body.ModuleInput {
            mod_id: chunk.indices[k],
            path: move p,
            source: move s,
            caps_mask: chunk.caps[k],
            ast: move tree,
        })
    }
    ParseChunkOut { mods: move out }
}

fn parse_v2_modules(loaded: &modules.Loaded, mods: &mut []hir_body.ModuleInput, edges: &mut []hir_body.ImportEdge, jobs: i32) {
    n := loaded.paths.len
    if jobs > 1 && n >= 16 {
        mut n_chunks := jobs * 2
        if n_chunks > n { n_chunks = n }
        mut chunks: []ParseChunkIn = []
        for _ in 0..n_chunks {
            chunks.push(ParseChunkIn { indices: [], paths: [], sources: [], caps: [] })
        }
        for i in 0..n {
            c := i % n_chunks
            chunks[c].indices.push(i)
            chunks[c].paths.push(loaded.paths[i].clone())
            chunks[c].sources.push(if i < loaded.sources.len { loaded.sources[i].clone() } else { "" })
            chunks[c].caps.push(if i < loaded.module_caps.len { loaded.module_caps[i] } else { 0 })
        }
        mut outs: []ParseChunkOut = []
        task scope parse_workers(jobs) {
            mut tasks: []Task<ParseChunkOut> = []
            for ci in 0..n_chunks {
                ch := replace(&mut chunks[ci], ParseChunkIn { indices: [], paths: [], sources: [], caps: [] })
                tasks.push(parse_workers.spawn(parse_chunk_worker, move ch))
            }
            for _ in 0..n_chunks {
                outs.push(tasks.remove(0).join())
            }
        }
        mut cursors: []i32 = []
        for _ in 0..n_chunks { cursors.push(0) }
        mods.reserve(n + 1)
        for i in 0..n {
            ci := i % n_chunks
            pos := cursors[ci]
            cursors[ci] = pos + 1
            m_in := replace(&mut outs[ci].mods[pos], hir_body.ModuleInput {
                mod_id: 0, path: "", source: "", caps_mask: 0,
                ast: parser.parse_source("", ""),
            })
            for ii in 0..m_in.ast.items.len {
                it := &m_in.ast.items[ii]
                if it.kind == .Import && it.name != "" {
                    mut alias := it.name.clone()
                    mut last_dot := -1
                    for cidx in 0..alias.len {
                        if alias[cidx] == 46 { last_dot = cidx }
                    }
                    if last_dot >= 0 && last_dot + 1 < alias.len {
                        alias = alias[(last_dot + 1)..alias.len]
                    }
                    tmod := modules.imported_module(&loaded, i, alias)
                    if tmod >= 0 {
                        edges.push(hir_body.ImportEdge {
                            owner_mod: i,
                            alias: move alias,
                            target_mod: tmod,
                        })
                    }
                }
            }
            mods.push(move m_in)
        }
    } else {
        for i in 0..n {
            path := loaded.paths[i].clone()
            source := if i < loaded.sources.len { loaded.sources[i].clone() } else { "" }
            caps := if i < loaded.module_caps.len { loaded.module_caps[i] } else { 0 }
            tree := parser.parse_source(path.clone(), source.clone())
            for ii in 0..tree.items.len {
                it := &tree.items[ii]
                if it.kind == .Import && it.name != "" {
                    mut alias := it.name.clone()
                    mut last_dot := -1
                    for ci in 0..alias.len {
                        if alias[ci] == 46 { last_dot = ci }
                    }
                    if last_dot >= 0 && last_dot + 1 < alias.len {
                        alias = alias[(last_dot + 1)..alias.len]
                    }
                    tmod := modules.imported_module(&loaded, i, alias)
                    if tmod >= 0 {
                        edges.push(hir_body.ImportEdge {
                            owner_mod: i,
                            alias: move alias,
                            target_mod: tmod,
                        })
                    }
                }
            }
            mods.push(hir_body.ModuleInput {
                mod_id: i,
                path: move path,
                source: move source,
                caps_mask: caps,
                ast: move tree,
            })
        }
    }
    imp_keys := loaded.imports.keys()
    for ki in 0..imp_keys.len {
        k := &imp_keys[ki]
        if k.len > 6 && k[0..6] == "__sym:" {
            rest := k[6..k.len]
            mut c1 := -1; mut c2 := -1
            for ci in 0..rest.len {
                if rest[ci] == 58 {
                    if c1 < 0 { c1 = ci } else if c2 < 0 { c2 = ci; break }
                }
            }
            if c1 > 0 && c2 > c1 + 1 && c2 + 1 < rest.len {
                mut own := 0
                for di in 0..c1 { own = own * 10 + i32(rest[di] - 48) }
                al_sym := "__sym:" + rest[(c1 + 1)..rest.len]
                tmod := i32(loaded.imports.get_or(k.clone(), -1))
                if tmod >= 0 {
                    edges.push(hir_body.ImportEdge {
                        owner_mod: own,
                        alias: move al_sym,
                        target_mod: tmod,
                    })
                }
            }
        }
    }
    pre_src := bundled.core_prelude()
    pre_tree := parser.parse_source("<core_prelude>", pre_src.clone())
    mods.push(hir_body.ModuleInput {
        mod_id: loaded.paths.len,
        path: "<core_prelude>",
        source: move pre_src,
        caps_mask: 0,
        ast: move pre_tree,
    })
    ff_src := bundled.float_formatter()
    ff_tree := parser.parse_source("<float_formatter>", ff_src.clone())
    mods.push(hir_body.ModuleInput {
        mod_id: loaded.paths.len + 1,
        path: "<float_formatter>",
        source: move ff_src,
        caps_mask: 0,
        ast: move ff_tree,
    })
}

fn run_check_v2(loaded: &modules.Loaded, options: &cli.Options, platform: i32, compile_jobs: i32) -> i32 {
    t0 := if options.timings { time.monotonic_ns() } else { 0 }
    mut mods: []hir_body.ModuleInput = []
    mut edges: []hir_body.ImportEdge = []
    parse_v2_modules(&loaded, &mut mods, &mut edges, compile_jobs)

    t1 := if options.timings { time.monotonic_ns() } else { 0 }
    mut prog := hir_lower.lower_modules(&mods, &edges, platform)
    t2 := if options.timings { time.monotonic_ns() } else { 0 }
    mut items: []diag.Diagnostic = []
    mut ok := prog.ok
    mut t3: i64 = t2
    mut t4: i64 = t2
    if ok {
        hir_mono.monomorphize(&mut prog)
        t3 = if options.timings { time.monotonic_ns() } else { 0 }
        res := mir_check.check_program_parallel(&prog, compile_jobs)
        t4 = if options.timings { time.monotonic_ns() } else { 0 }
        ok = res.ok
        for i in 0..res.diagnostics.len { items.push(diag.clone_diag(&res.diagnostics[i])) }
    } else {
        for i in 0..prog.diagnostics.len { items.push(diag.clone_diag(&prog.diagnostics[i])) }
    }
    if options.timings && !options.timings_json && !options.run && !options.run_tests {
        p_ms := (t1 - t0) / 1000000
        l_ms := (t2 - t1) / 1000000
        m_ms := (t3 - t2) / 1000000
        c_ms := (t4 - t3) / 1000000
        print(f"check-v2 timings: parse={p_ms}ms lower={l_ms}ms mono={m_ms}ms mir2={c_ms}ms (types={prog.types.entries.len} fns={prog.fns.len})")
    }

    if !ok {
        if options.agent {
            empty_records := compiler.bindings()
            agent.report_result(&loaded, &empty_records, &items, false)
        } else {
            _ := emit_human_diagnostics(&loaded, &items, false)
        }
        return 1
    }
    if options.agent {
        empty_records := compiler.bindings()
        agent.report_result(&loaded, &empty_records, &items, true)
    } else {
        if !options.timings_json { _ := emit_human_diagnostics(&loaded, &items, false) }
        print(f"checked (v2) {options.input} ({loaded.paths.len} modules)")
    }
    0
}

fn run_build_v2(loaded: &modules.Loaded, options: &cli.Options, platform: i32,
    default_target: i32, output_in: string, compile_jobs: i32,
    digest_pages: fn(&[]u8, i32, i32, i32) -> []u8) -> i32 {
    mut output := output_in.clone()
    is_wasm := platform == 3 || platform == 4
    t0 := if options.timings { time.monotonic_ns() } else { 0 }
    mut mods: []hir_body.ModuleInput = []
    mut edges: []hir_body.ImportEdge = []
    parse_v2_modules(&loaded, &mut mods, &mut edges, compile_jobs)

    t1 := if options.timings { time.monotonic_ns() } else { 0 }
    mut prog := hir_lower.lower_modules(&mods, &edges, platform)
    t2 := if options.timings { time.monotonic_ns() } else { 0 }
    mut items: []diag.Diagnostic = []
    if !prog.ok {
        for i in 0..prog.diagnostics.len { items.push(diag.clone_diag(&prog.diagnostics[i])) }
        if options.agent {
            empty_records := compiler.bindings()
            agent.report_result(&loaded, &empty_records, &items, false)
        } else {
            _ := emit_human_diagnostics(&loaded, &items, false)
        }
        return 1
    }
    if options.list_groups {
        for i in 0..loaded.groups.len { print(f"{i} {loaded.groups[i]}") }
        return 0
    }
    if options.tests {
        _ := hir_lower.synthesize_test_entry(&mut prog, &loaded.groups, options.group, options.group >= 0 || is_wasm)
    }
    hir_mono.monomorphize(&mut prog)
    t3 := if options.timings { time.monotonic_ns() } else { 0 }
    chk := mir_check.check_program_parallel(&prog, compile_jobs)
    t4 := if options.timings { time.monotonic_ns() } else { 0 }
    for i in 0..chk.diagnostics.len { items.push(diag.clone_diag(&chk.diagnostics[i])) }
    if !chk.ok {
        if options.agent {
            empty_records := compiler.bindings()
            agent.report_result(&loaded, &empty_records, &items, false)
        } else {
            _ := emit_human_diagnostics(&loaded, &items, false)
        }
        return 1
    }

    emitted := mir_emit.emit_program_with_jobs(&prog, &chk.bodies, platform, options.debug_info, compile_jobs)
    t5 := if options.timings { time.monotonic_ns() } else { 0 }
    if !emitted.ok {
        return failure("build-v2 emit failed: " + emitted.error)
    }

    mut dbg_data := compiler.empty_debug()
    if options.debug_info {
        mut mod_flat_base: []i32 = []
        for _ in 0..loaded.paths.len { mod_flat_base.push(0) }
        for mi in 0..loaded.map_files.len {
            mf := loaded.map_files[mi]
            if mf >= 0 && mf < mod_flat_base.len && mod_flat_base[mf] == 0 && loaded.map_starts[mi] > 0 {
                mod_flat_base[mf] = loaded.map_starts[mi]
            }
        }
        for fi in 0..emitted.debug_fn_names.len {
            fm := emitted.debug_fn_mods[fi]
            base := if fm >= 0 && fm < mod_flat_base.len { mod_flat_base[fm] } else { 0 }
            sp := if emitted.debug_fn_spans[fi] >= 0 { emitted.debug_fn_spans[fi] } else { 0 }
            dbg_data.functions.push(compiler.DebugFunction {
                name: emitted.debug_fn_names[fi].clone(),
                source_offset: base + sp,
                start_byte: emitted.debug_fn_starts[fi],
                end_byte: emitted.debug_fn_ends[fi],
            })
        }
        for li in 0..emitted.debug_line_offsets.len {
            lm := emitted.debug_line_mods[li]
            base := if lm >= 0 && lm < mod_flat_base.len { mod_flat_base[lm] } else { 0 }
            sp := if emitted.debug_line_spans[li] >= 0 { emitted.debug_line_spans[li] } else { 0 }
            dbg_data.lines.push(compiler.DebugLine {
                byte_offset: emitted.debug_line_offsets[li],
                source_offset: base + sp,
            })
        }
    }

    result := compiler.Result {
        ok: true,
        error: "",
        offset: 0,
        text: move emitted.text,
        imports: compiler.Imports {
            globals: emitted.imports_globals,
            libraries: move emitted.imports_libraries,
            symbols: move emitted.imports_symbols,
            specs: move emitted.imports_specs,
            sites: move emitted.imports_sites,
            slots: move emitted.imports_slots,
            env_source_slot: emitted.env_source_slot,
        },
        method_imports: Set<i64>::new(),
        diagnostics: [],
        debug: move dbg_data,
    }

    signer := macho.Signer { workers: compile_jobs, digest: digest_pages }
    mut emitter_err := ""
    emitter := if is_wasm { default_emitter_config() } else { build_emitter_config(&options, platform, &mut emitter_err) }
    if emitter_err != "" { return failure(emitter_err) }
    mut image: []u8 = []
    if is_wasm { image = result.text }
    else { image = emit_native_image(&loaded, &result, platform, options.debug_info, options.input, &signer, &emitter) }

    if options.app {
        error := bundle.publish_configured(output, &mut image, &loaded.paths, &signer, options.package_version, &emitter.bundle)
        if error != "" { return failure(error) }
    } else {
        if !cli.prepare_parent(output) { return failure("cannot create output directory") }
        temporary := f"{output}.dunder-{sys.pid()}.tmp"
        if sys.metadata(temporary).ok { return failure("temporary output already exists") }
        written := sys.write_u8(temporary, &image)
        if !written.ok { _ := sys.remove_file(temporary); return failure(sys.error_message(written.error)) }
        if !is_wasm && platform != 5 {
            executable := sys.make_executable(temporary)
            if !executable.ok { _ := sys.remove_file(temporary); return failure(sys.error_message(executable.error)) }
        }
        published := sys.rename(temporary, output)
        if !published.ok { _ := sys.remove_file(temporary); return failure(sys.error_message(published.error)) }
    }

    if options.timings && !options.timings_json && !options.run && !options.run_tests {
        t6 := time.monotonic_ns()
        p_ms := (t1 - t0) / 1000000
        l_ms := (t2 - t1) / 1000000
        m_ms := (t3 - t2) / 1000000
        c_ms := (t4 - t3) / 1000000
        e_ms := (t5 - t4) / 1000000
        i_ms := (t6 - t5) / 1000000
        ms := (t6 - t0) / 1000000
        print(f"build-v2 timings: parse={p_ms}ms lower={l_ms}ms mono={m_ms}ms mir2={c_ms}ms emit={e_ms}ms image={i_ms}ms total={ms}ms (types={prog.types.entries.len} fns={prog.fns.len} bodies={chk.bodies.len}; {emitted.opt_summary})")
    }
    if options.run {
        if options.app { output = output + "/Contents/MacOS/" + bundle.executable_name(bundle.name(output)) }
        return process.run(output, &options.args, 0, default_target)
    }
    if options.run_tests {
        mut keys: []string = []
        if options.affected || sys.metadata(options.output + "/.affected").is_dir {
            mut policy := receipts.policy()
            policy.scalar_enabled = options.scalar_opt; policy.ownership_enabled = options.ownership_opt; policy.runtime_profile = options.runtime_profile
            policy.const_div_enabled = options.const_div_opt; policy.frame_free_enabled = options.frame_free; policy.range_enabled = options.range_opt; policy.inline_enabled = options.inline_opt; policy.mir_opt_enabled = options.mir_opt && options.mir_pass
            policy.mir_memory_enabled = options.mir_memory; policy.mir_ssa_enabled = options.mir_ssa; policy.mir_values_enabled = options.mir_values
            keys = receipts.keys_configured(&loaded, options.output, platform, options.timeout_ms, &policy)
        }
        result_code := process.tests_parallel(output, &loaded.groups, &keys, options.affected, options.timeout_ms, default_target, options.workers)
        _ := sys.remove_file(output)
        return result_code
    }
    if options.agent {
        empty_records := compiler.bindings()
        agent.report_result(&loaded, &empty_records, &items, true)
    } else if options.install {
        if !options.timings_json { _ := emit_human_diagnostics(&loaded, &items, false) }
        print("installed " + output)
    } else {
        if !options.timings_json { _ := emit_human_diagnostics(&loaded, &items, false) }
        print("built " + output)
    }
    0
}

fn failure(message: string) -> i32 {
    _ := stderr.eprint(message)
    1
}

pub fn native_platform() -> i32 {
    if target_is("arm64-linux") { return 1 }
    if target_is("x86_64-linux") { return 2 }
    if target_is("x86_64-windows") { return 5 }
    0
}

pub fn build(default_target: i32) -> i32 {
    build_using(default_target, 1, false, compiler.compile_loaded)
}
pub fn build_using(default_target: i32, default_workers: i32, supports_workers: bool,
    compile_fn: fn(&mut compiler.Session,i32,&[]i32,&[]i32,bool,bool,&mut compiler.Bindings,string,string,&compiler.Configuration)->compiler.Result) -> i32 {
    build_configured(default_target, default_workers, supports_workers, compile_fn, macho.digest_pages, modules.scan_wave_serial)
}

pub fn build_configured(default_target: i32, default_workers: i32, supports_workers: bool,
    compile_fn: fn(&mut compiler.Session,i32,&[]i32,&[]i32,bool,bool,&mut compiler.Bindings,string,string,&compiler.Configuration)->compiler.Result,
    digest_pages: fn(&[]u8, i32, i32, i32) -> []u8,
    lex: fn(&mut modules.Loader, i32, i32, i32)) -> i32 {
    if sys.arg_count() == 1 || sys.arg(1) == "--help" || sys.arg(1) == "-h" {
        print("dunder build [input.ddr | --example name] [--build-v2] [--agent] [-o output] [--target target] [-g | --debug] [--app] [--incremental] [--timings[=json]] [--scalar-opt=off] [--ownership-opt=off] [--const-div-opt=off] [--frame-free=off] [--range-opt=off] [--mir=off] [--mir-opt=off] [--mir-memory=off] [--mir-ssa=on|off] [--mir-values=off] [--inline-opt=off] [--profile-compiler] [--runtime-profile]")
        print("dunder run [input.ddr | --example name] [--build-v2] [-o output] [-g | --debug] [--app] [-- program-args...]")
        print("dunder --list-examples  (list names from the nearest dunder.toml)")
        print("dunder shim [zsh]  (print shell integration for Tab completion)")
        print("dunder install [input.ddr | --example name] [--dir dir | --prefix dir] [-g | --debug] [--incremental] [--offline] [--locked]")
        print("dunder test [input.ddr] [-o directory] [--affected] [--timeout-ms N]")
        print("dunder check [input.ddr | --example name | --tests] [--check-v2] [--agent] [--unused-functions] [--target target] [--timings[=json]] [--profile-compiler]")
        print("dunder build-tests [input.ddr] [--list | --group ID] [--target target]")
        print("dunder update [--offline] [--locked]")
        print("--offline: use cached Git dependencies; --locked: require an unchanged dunder.lock")
        print("dunder upgrade [--check] [--version tag] [--force]")
        print("dunder fmt [--check | --stdout] [path...]")
        print("dunder init [name] [--lib]")
        print("dunder clean [--all]")
        print("dunder lsp [--stdio]")
        print("dunder --version | --list-targets")
        if default_workers == 0 && supports_workers {
            print("--jobs N | --jobs=N: compiler workers from 1 to " + budget.max_jobs().str() + " (default auto, host " + budget.host_cpus(default_target).str() + ")")
        } else {
            print("--jobs N | --jobs=N: compiler workers from 1 to " + budget.max_jobs().str() + " (default " + default_workers.str() + ")")
        }
        if !supports_workers { print("this compiler entry supports only --jobs 1") }
        return 0
    }
    if sys.arg_count() == 2 && (sys.arg(1) == "--version" || sys.arg(1) == "-V") {
        print("dunder " + cli.compiler_version() + " (" + cli.target_name(default_target) + ")")
        return 0
    }
    if sys.arg_count() >= 2 && sys.arg(1) == "upgrade" {
        return upgrade.run(default_target)
    }
    if sys.arg_count() >= 2 && sys.arg(1) == "fmt" {
        return fmt.run()
    }
    if sys.arg(1) == "shim" { return shim.run() }
    if sys.arg_count() >= 2 && sys.arg(1) == "init" {
        return project_tools.run_init()
    }
    if sys.arg_count() >= 2 && sys.arg(1) == "clean" {
        return project_tools.run_clean()
    }
    if sys.arg_count() >= 2 && sys.arg(1) == "lsp" {
        if sys.arg_count() > 3 || (sys.arg_count() == 3 && sys.arg(2) != "--stdio") {
            return failure("lsp accepts only optional --stdio")
        }
        return lsp.run(default_target)
    }
    if sys.arg_count() == 2 && sys.arg(1) == "--list-targets" {
        for id in 0..6 { print(cli.target_name(id)) }
        return 0
    }
    if sys.arg(1) == "--list-examples" {
        if sys.arg_count() != 2 { _ := stderr.eprint("--list-examples takes no arguments"); return 2 }
        return cli.list_examples()
    }
    options := cli.options_for(default_target, default_workers, supports_workers)
    if options.error != "" {
        _ := stderr.eprint(options.error)
        return 2
    }
    if options.update { print("Dependencies are up to date"); return 0 }
    platform := options.platform
    is_wasm := platform == 3 || platform == 4
    if options.runtime_profile && is_wasm { return failure("runtime profiling requires a native target") }
    mut profile_host := -1
    if options.profile_compiler { profile_host = default_target }
    if options.install && (platform != default_target || is_wasm) {
        return failure("install requires the host native target")
    }
    if (options.run || options.run_tests) && (platform != default_target || is_wasm) {
        return failure("selected target cannot run on this host")
    }
    mut output := options.output.clone()
    if options.install && sys.metadata(output).is_dir {
        return failure("install destination is a directory: " + output)
    }
    if options.run_tests { output = f"{output}/suite-{sys.pid()}" }
    mut started: i64 = 0
    if options.timings { started = time.monotonic_ns() }
    mut receipt := build_receipt.empty()
    if options.project_build && !options.incremental && !options.timings && !options.agent &&
        !options.debug_info && !options.app {
        receipt = build_receipt.prepare(&options, default_target)
        match build_receipt.lookup(&receipt, &options, output, !is_wasm && platform != 5, default_target) {
            .Some(warnings) => {
                if warnings != "" { _ := stderr.eprint(warnings) }
                print("built " + output)
                return 0
            },
            .None => {},
        }
    }
    compile_jobs := if options.profile_compiler || options.debug_info { 1 } else { options.workers }
    lexing := modules.Lexing { track_inputs: receipt.path != "", unused_functions: options.unused_functions, symbol_owners: false, jobs: compile_jobs, scan: lex }
    mut session := compiler.new_session()
    dep_graph := modules.DepGraph {
        pkg_dirs: options.deps.pkg_dirs.clone(), pkg_entries: options.deps.pkg_entries.clone(),
        pkg_caps: options.deps.pkg_caps.clone(), pkg_labels: options.deps.pkg_labels.clone(),
        edge_owners: options.deps.edge_owners.clone(), edge_names: options.deps.edge_names.clone(), edge_targets: options.deps.edge_targets.clone(),
    }
    mode: compiler.LoadMode = if options.checking { .Check } else if options.tests { .Tests } else { .Program }
    loaded := compiler.load_group_with_dep_graph_into(&mut session, options.input, mode, options.group, is_wasm, &dep_graph, &lexing)
    if !loaded.ok {
        items := agent.resolve_loader_diagnostics(&loaded)
        if options.agent {
            empty := compiler.bindings()
            agent.report_result(&loaded, &empty, &items, false)
        } else {
            _ := emit_human_diagnostics(&loaded, &items, false)
        }
        return 1
    }
    if options.list_groups {
        for i in 0..loaded.groups.len { print(f"{i} {loaded.groups[i]}") }
        return 0
    }
    if mode == .Tests { compiler.scan_into(&mut session, loaded.source) }
    mut load_finished: i64 = 0
    if options.timings { load_finished = time.monotonic_ns() }
    if options.debug_info && (is_wasm || platform == 5) { return failure("-g/--debug is not supported for wasm32 or windows targets") }
    mut config := compiler.configuration()
    config.workers = if options.debug_info { 1 } else { options.workers }
    config.scalar_enabled = options.scalar_opt && !options.debug_info
    config.ownership_enabled = options.ownership_opt
    config.const_div_enabled = options.const_div_opt; config.frame_free_enabled = options.frame_free; config.range_enabled = options.range_opt
    config.inline_enabled = options.inline_opt && !options.debug_info
    config.mir_opt_enabled = options.mir_opt && options.mir_pass
    config.mir_memory_enabled = options.mir_memory; config.mir_ssa_enabled = options.mir_ssa; config.mir_values_enabled = options.mir_values
    config.profile_host = profile_host; config.instrument_runtime = options.runtime_profile
    config.debug_info = options.debug_info
    if options.checking {
        if options.check_v2 {
            return run_check_v2(&loaded, &options, platform, compile_jobs)
        }
        mut records := compiler.bindings()
        mut check_setup: i64 = 0
        if options.timings { check_setup = time.monotonic_ns() }
        checked := compile_fn(&mut session, platform, &loaded.map_starts, &loaded.map_files, true, options.agent, &mut records, "", "", &config)
        items := agent.resolve_compiler_diagnostics(&loaded, &checked)
        if !checked.ok {
            if options.agent { agent.report_result(&loaded, &records, &items, false) }
            else { _ := emit_human_diagnostics(&loaded, &items, false) }
            return 1
        }
        if options.timings {
            finished := time.monotonic_ns()
            inline_data := inline_counts(&options, &records)
            backend_data := backend_counts(&options, &records)
            slowest := slowest_mir_functions(&loaded, &records)
            timings.report(options.timings_json, true, platform, loaded.paths.len, records.reused, records.emitted,
                started, load_finished, check_setup, finished, finished, finished,
                options.scalar_opt, records.modeled, records.optimized, records.rewrites, records.proven_bounds, records.fallbacks, &records.profile, &inline_data, &backend_data, &slowest)
        }
        if options.agent { agent.report_result(&loaded, &records, &items, true) }
        else {
            if !options.timings_json { _ := emit_human_diagnostics(&loaded, &items, false) }
            print(f"checked {options.input} ({loaded.paths.len} modules)")
        }
        return 0
    }
    for path in &loaded.paths {
        if path.len > 0 && path[0] != 60 {
            if path == output || sys.same_file(path, output) { return failure("output must not overwrite source") }
        }
    }
    if options.build_v2 {
        return run_build_v2(&loaded, &options, platform, default_target, output, compile_jobs, digest_pages)
    }
    if compiler.loaded_tokens(&session).kinds.len < 512 { receipt = build_receipt.empty() }
    mut records := compiler.bindings()
    mut cache := ""; mut identity := ""
    if options.incremental && !options.debug_info {
        root := cache_io.root(options.input)
        if root != "" {
            cache = "build/.dunder-cache/selfhost/" + cache_io.digest(root + ":" + platform.str())
            if options.scalar_opt { cache = cache + "/scalar-on" } else { cache = cache + "/scalar-off" }
            if options.ownership_opt { cache = cache + "/ownership-on" } else { cache = cache + "/ownership-off" }
            if options.const_div_opt { cache = cache + "/const-div-on" } else { cache = cache + "/const-div-off" }
            if options.frame_free { cache = cache + "/frame-free" } else { cache = cache + "/frame-plain" }
            if options.range_opt { cache = cache + "/range-on" } else { cache = cache + "/range-off" }
            if options.inline_opt { cache = cache + "/inline-on" } else { cache = cache + "/inline-off" }
            cache = cache + "/typed-function-v1/x86-mir-v1/wasm-mir-v1"
            if config.mir_opt_enabled { cache = cache + "/mir-opt-on" } else { cache = cache + "/mir-opt-off" }
            if options.mir_memory { cache = cache + "/mir-memory-source" } else { cache = cache + "/mir-memory-raw" }
            if options.mir_ssa { cache = cache + "/mir-ssa-v6-composed-regional-expression2-work4194304" } else { cache = cache + "/mir-ssa-off" }
            if options.mir_values { cache = cache + "/mir-values-v4-certified-compact-terminal1" } else { cache = cache + "/mir-values-off" }
            if options.runtime_profile { cache = cache + "/runtime-profile" } else { cache = cache + "/runtime-plain" }
            identity = cache_io.compiler(default_target)
        }
    }
    if !options.incremental && receipt.path != "" {
        cache = receipt.objects.clone()
        config.fragment_pack = true
        identity = receipt.key.clone()
    }
    mut setup_finished: i64 = 0
    if options.timings { setup_finished = time.monotonic_ns() }
    result := compile_fn(&mut session, platform, &loaded.map_starts, &loaded.map_files, false, false, &mut records, cache, identity, &config)
    items := agent.resolve_compiler_diagnostics(&loaded, &result)
    if !result.ok {
        if options.agent { agent.report_result(&loaded, &records, &items, false) }
        else { _ := emit_human_diagnostics(&loaded, &items, false) }
        return 1
    }
    mut warnings := ""
    if !options.agent && !options.timings_json { warnings = emit_human_diagnostics(&loaded, &items, receipt.path != "") }
    mut compile_finished: i64 = 0
    if options.timings { compile_finished = time.monotonic_ns() }
    signer := macho.Signer { workers: compile_jobs, digest: digest_pages }
    mut emitter_err := ""
    emitter := if is_wasm { default_emitter_config() } else { build_emitter_config(&options, platform, &mut emitter_err) }
    if emitter_err != "" { return failure(emitter_err) }
    mut image: []u8 = []
    if is_wasm { image = result.text }
    else { image = emit_native_image(&loaded, &result, platform, options.debug_info, options.input, &signer, &emitter) }
    mut image_finished: i64 = 0
    if options.timings { image_finished = time.monotonic_ns() }
    if options.app {
        error := bundle.publish_configured(output, &mut image, &loaded.paths, &signer, options.package_version, &emitter.bundle)
        if error != "" { return failure(error) }
    } else {
        if !cli.prepare_parent(output) { return failure("cannot create output directory") }
        temporary := f"{output}.dunder-{sys.pid()}.tmp"
        if sys.metadata(temporary).ok { return failure("temporary output already exists") }
        written := sys.write_u8(temporary, &image)
        if !written.ok { _ := sys.remove_file(temporary); return failure(sys.error_message(written.error)) }
        if !is_wasm && platform != 5 {
            executable := sys.make_executable(temporary)
            if !executable.ok { _ := sys.remove_file(temporary); return failure(sys.error_message(executable.error)) }
        }
        published := sys.rename(temporary, output)
        if !published.ok { _ := sys.remove_file(temporary); return failure(sys.error_message(published.error)) }
        build_receipt.record(&receipt, &loaded.build_inputs, &image, warnings, default_target)
    }
    if options.timings {
        finished := time.monotonic_ns()
        inline_data := inline_counts(&options, &records)
        backend_data := backend_counts(&options, &records)
        slowest := slowest_mir_functions(&loaded, &records)
        timings.report(options.timings_json, false, platform, loaded.paths.len, records.reused, records.emitted,
            started, load_finished, setup_finished, compile_finished, image_finished, finished,
            options.scalar_opt, records.modeled, records.optimized, records.rewrites, records.proven_bounds, records.fallbacks, &records.profile, &inline_data, &backend_data, &slowest)
    }
    if options.run {
        if options.app { output = output + "/Contents/MacOS/" + bundle.executable_name(bundle.name(output)) }
        return process.run(output, &options.args, 0, default_target)
    }
    if options.run_tests {
        mut keys: []string = []
        if options.affected || sys.metadata(options.output + "/.affected").is_dir {
            mut policy := receipts.policy()
            policy.scalar_enabled = options.scalar_opt; policy.ownership_enabled = options.ownership_opt; policy.runtime_profile = options.runtime_profile
            policy.const_div_enabled = options.const_div_opt; policy.frame_free_enabled = options.frame_free; policy.range_enabled = options.range_opt; policy.inline_enabled = options.inline_opt; policy.mir_opt_enabled = config.mir_opt_enabled
            policy.mir_memory_enabled = options.mir_memory; policy.mir_ssa_enabled = options.mir_ssa; policy.mir_values_enabled = options.mir_values
            keys = receipts.keys_configured(&loaded, options.output, platform, options.timeout_ms, &policy)
        }
        result_code := process.tests_parallel(output, &loaded.groups, &keys, options.affected, options.timeout_ms, default_target, options.workers)
        _ := sys.remove_file(output)
        return result_code
    }
    if options.agent { agent.report_result(&loaded, &records, &items, true) }
    else if options.install { print("installed " + output) }
    else { print("built " + output) }
    0
}
