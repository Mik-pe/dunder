capability unsafe
import std.bytes as bytes
import sys

@extern("c", "write")
unsafe fn c_write(fd: i32, buf: ptr, count: usize) -> i64

fn write_all_fd(fd: i32, raw: &[]u8) -> sys.Status {
    mut sent := 0
    unsafe {
        while sent < raw.len {
            n := c_write(fd, addr(&raw[sent]), usize(raw.len - sent))
            if n <= 0 { return sys.Status { ok: false, error: 5 } }
            sent += i32(n)
        }
    }
    sys.Status { ok: true, error: 0 }
}

pub fn write_stdout(message: string) -> sys.Status {
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, message)
    write_all_fd(1, &raw)
}

pub fn eprint(message: string) -> sys.Status {
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, message)
    raw.push(10)
    write_all_fd(2, &raw)
}
