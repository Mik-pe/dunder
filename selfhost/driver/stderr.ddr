capability unsafe
import std.bytes as bytes
import sys

@extern("kernel32.dll", "GetStdHandle")
unsafe fn std_handle(number: i32) -> ptr
@extern("kernel32.dll", "WriteFile")
unsafe fn write_handle(handle: ptr, data: ptr, length: u32, written: ptr, overlapped: ptr) -> i32

@extern("c", "write")
unsafe fn c_write(fd: i32, buf: ptr, count: usize) -> i64

fn write_all_fd(fd: i32, raw: &[]u8) -> sys.Status {
    mut sent := 0
    unsafe {
        while sent < raw.len {
            if target_is("windows") {
                handle := std_handle(if fd == 1 { -11 } else { -12 })
                mut count: u32 = 0
                if write_handle(handle, addr(&raw[sent]), u32(raw.len - sent), addr(&mut count), ptr(0)) == 0 || count == u32(0) {
                    return sys.Status { ok: false, error: 5 }
                }
                sent += i32(count)
            } else {
                n := c_write(fd, addr(&raw[sent]), usize(raw.len - sent))
                if n <= 0 { return sys.Status { ok: false, error: 5 } }
                sent += i32(n)
            }
        }
    }
    sys.Status { ok: true, error: 0 }
}

pub fn write_stdout(message: string) -> sys.Status {
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, message)
    write_all_fd(1, &raw)
}

pub fn eprint(message: string) -> sys.Status {
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, message)
    raw.push(10)
    write_all_fd(2, &raw)
}
