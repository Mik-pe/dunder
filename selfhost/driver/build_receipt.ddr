capability filesystem
import cache_io
import cli
import modules
import paths
import ..frontend.lexer
import std.bytes as bytes
import std.fs as fs
import std.text as text
import sys

pub struct Receipt { path: string, key: string }
pub fn empty() -> Receipt { Receipt { path: "", key: "" } }

fn number(out: &mut []u8, value: i32) { bytes.append_le(&mut out, i64(value), 4) }
fn field(out: &mut []u8, value: string) {
    number(&mut out, value.len)
    bytes.append_utf8(&mut out, value)
}
fn strings(out: &mut []u8, values: &[]string) {
    number(&mut out, values.len)
    for value in &values { field(&mut out, value) }
}
fn numbers(out: &mut []u8, values: &[]i32) {
    number(&mut out, values.len)
    for value in &values { number(&mut out, value) }
}

fn cache_directory() -> string {
    if target_is("windows") { return cache_io.env_var("LOCALAPPDATA") }
    base := cache_io.env_var("XDG_CACHE_HOME")
    if paths.is_absolute(base) { return base }
    home := cache_io.env_var("HOME")
    if !paths.is_absolute(home) { return "" }
    if target_is("macos") { return paths.join(home, "Library/Caches") }
    paths.join(home, ".cache")
}

pub fn prepare(options: &cli.Options, loaded: &modules.Loaded, tokens: &lexer.Tokens, host: i32) -> Receipt {
    home := cache_directory()
    cwd := fs.cwd()
    if !paths.is_absolute(home) || !cwd.ok { return empty() }
    identity := cache_io.compiler(host)
    if identity == "" { return empty() }
    mut raw: []u8 = []
    field(&mut raw, identity)
    number(&mut raw, options.platform)
    number(&mut raw, sys.arg_count() - 1)
    for i in 1..sys.arg_count() { field(&mut raw, sys.arg(i)) }
    field(&mut raw, options.input)
    strings(&mut raw, &loaded.paths)
    strings(&mut raw, &loaded.sources)
    strings(&mut raw, &loaded.symbols)
    strings(&mut raw, &loaded.json_symbols)
    strings(&mut raw, &loaded.embed_blob_digests)
    numbers(&mut raw, &loaded.module_caps)
    numbers(&mut raw, &loaded.map_starts)
    numbers(&mut raw, &loaded.map_files)
    numbers(&mut raw, &loaded.map_offsets)
    number(&mut raw, tokens.kinds.len)
    for i in 0..tokens.kinds.len {
        raw.push(u8(i32(tokens.kinds[i])))
        number(&mut raw, tokens.starts[i])
        field(&mut raw, tokens.texts[i])
    }
    output := paths.join(cwd.value, options.output)
    Receipt { path: paths.join(home, "dunder/builds") + "/" + cache_io.digest(output),
        key: cache_io.host_hash(&raw, host) }
}

pub fn lookup(receipt: &Receipt, output: string, native_executable: bool, host: i32) -> Option<string> {
    if receipt.path == "" { return .None }
    info := sys.metadata(output)
    if !info.is_file || fs.is_symlink(output) { return .None }
    if native_executable && !target_is("windows") && info.mode.bit_and(u32(4095)) != u32(493) { return .None }
    prefix := receipt.key + info.size.str() + "\n"
    stored := sys.read_text_limit(receipt.path, 262400)
    header_end := prefix.len + 128
    if !stored.ok || stored.value.len <= header_end || stored.value[header_end] != 10 ||
        !text.starts_with(stored.value, prefix) { return .None }
    data := sys.read_u8_limit(output, info.size)
    if !data.ok { return .None }
    warnings := stored.value[header_end + 1..stored.value.len]
    header := prefix + cache_io.host_hash(&data.value, host) + cache_io.digest(warnings)
    if !text.starts_with(stored.value, header) { return .None }
    .Some(warnings)
}

pub fn record(receipt: &Receipt, image: &[]u8, warnings: string, host: i32) {
    if receipt.path == "" || warnings.len > 262144 || !cli.prepare_parent(receipt.path) { return }
    header := receipt.key + image.len.str() + "\n" + cache_io.host_hash(&image, host) + cache_io.digest(warnings)
    _ := fs.write_private_text_atomic(receipt.path, header + "\n" + warnings)
}
