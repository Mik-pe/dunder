capability filesystem
import ..backend.arm64 as arm
import ..backend.wasm_mir
import ..backend.x86_mir
import cache_io
import cli
import ..frontend.frontend_types as types
import ..frontend.lexer
import ..mir.mir_lower as lower
import std.bytes as bytes
import sys

pub struct Start { words: i32, labels: i32, relocations: i32 }
pub fn start(code: &arm.Code) -> Start {
    Start { words: code.words.len, labels: code.labels.len, relocations: code.at.len }
}
fn tokens(output: &mut []u8, input: &lexer.Tokens, first: i32, last: i32) {
    for i in first..last {
        output.push(u8(i32(input.kinds[i])))
        spelling := &input.texts[i]
        bytes.append_le(&mut output, i64(spelling.len), 4)
        bytes.append_utf8(&mut output, spelling)
    }
}
fn integers(output: &mut []u8, values: &[]i32) {
    bytes.append_le(&mut output, i64(values.len), 4)
    for value in values { bytes.append_le(&mut output, i64(value), 4) }
}
pub fn context(input: &lexer.Tokens, starts: &[]i32, ends: &[]i32,
    owners: &[]i32, registry: &types.TypeRegistry, module_caps: &[]i32,
    platform: i32, globals: i32, callbacks: bool, identity: string) -> string {
    if identity == "" { return "" }
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, identity + ":native16:" + platform.str() + ":" + globals.str())
    if callbacks { raw.push(1) } else { raw.push(0) }
    integers(&mut raw, &owners); integers(&mut raw, &registry.opaque_owner)
    for flag in &registry.opaque_sendable { if flag { raw.push(1) } else { raw.push(0) } }
    integers(&mut raw, &registry.type_owners); integers(&mut raw, &module_caps)
    integers(&mut raw, &registry.declared.type_kinds); integers(&mut raw, &registry.declared.type_bases)
    integers(&mut raw, &registry.declared.type_starts); integers(&mut raw, &registry.declared.type_counts)
    integers(&mut raw, &registry.declared.ffi_params); integers(&mut raw, &registry.declared.callable_parameters)
    integers(&mut raw, &registry.result_success); integers(&mut raw, &registry.result_failure)
    mut position := 0
    for i in 0..starts.len {
        if starts[i] > 0 {
            tokens(&mut raw, &input, position, starts[i])
            position = ends[i]
        }
    }
    tokens(&mut raw, &input, position, input.kinds.len)
    cache_io.binary_hash(&raw)
}
pub fn has_valid_fragment(path: string, key: string) -> bool {
    if !valid_key(key) { return false }
    info := sys.metadata(path)
    if !info.is_file || info.size < 184 || info.size > 67108864 { return false }
    read := sys.read_u8(path)
    if !read.ok || read.value.len < 184 || read.value.len > 67108864 { return false }
    stored_key := &read.value[0..64]
    if !bytes.equals_text(&stored_key, 0, stored_key.len, key) { return false }
    payload := &read.value[128..read.value.len]
    signature := &read.value[64..128]
    bytes.equals_text(&signature, 0, signature.len, cache_io.digest_parts(key, &payload))
}
pub fn key(context: string, function: i32, input: &lexer.Tokens, first: i32, last: i32) -> string {
    if context == "" { return "" }
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, context)
    bytes.append_le(&mut raw, i64(function), 4)
    tokens(&mut raw, &input, first, last)
    cache_io.binary_hash(&raw)
}
fn put(output: &mut []u8, value: i64) {
    digits := "0123456789abcdef"
    for i in 0..8 { output.push(u8(digits[i32(value.shr((7 - i) * 4).bit_and(15))])) }
}
fn header_version(output: &mut []u8, version: i64, words: i32, labels: i32, relocations: i32,
    dependencies: i32, charged: i32) {
    put(&mut output, 1146439236); put(&mut output, version)
    put(&mut output, i64(words)); put(&mut output, i64(labels)); put(&mut output, i64(relocations))
    put(&mut output, i64(dependencies)); put(&mut output, i64(charged))
}
fn header(output: &mut []u8, words: i32, labels: i32, relocations: i32,
    dependencies: i32, charged: i32) {
    header_version(&mut output, 1, words, labels, relocations, dependencies, charged)
}
fn label_record(output: &mut []u8, offset: i32, words: i32) -> bool {
    if offset < -1 || offset > words { return false }
    if offset == -1 { put(&mut output, 4294967295) } else { put(&mut output, i64(offset)) }
    true
}
fn relocation_record(output: &mut []u8, at: i32, target: i32, kind: i32,
    words: i32, first_label: i32, label_end: i32, globals: i32) -> bool {
    if at < 0 || at >= words || kind < 0 || kind > 20 || (kind >= 2 && at >= words - 1) || target < 0 { return false }
    put(&mut output, i64(at))
    if target < globals { put(&mut output, 2147483648 + i64(target)) }
    else if target >= first_label && target < label_end { put(&mut output, i64(target - first_label)) }
    else { return false }
    put(&mut output, i64(kind)); true
}
fn values(source: &[]u8) -> []i64 {
    mut result: []i64 = []
    if source.len % 8 != 0 { return result }
    result.reserve(source.len / 8)
    mut value: i64 = 0
    for i in 0..source.len {
        byte := i32(source[i])
        mut digit := byte - 48
        if byte >= 97 && byte <= 102 { digit = byte - 87 }
        else if byte < 48 || byte > 57 { return [] }
        value = value * 16 + i64(digit)
        if i % 8 == 7 { result.push(value); value = 0 }
    }
    result
}
pub struct Dependencies { declarations: []i32, charged_words: i32 }
pub fn word_limit() -> i32 { 4096 }
pub fn remaining_words(dependencies: &Dependencies) -> i32 { word_limit() - dependencies.charged_words }
pub fn new_dependencies() -> Dependencies { Dependencies { declarations: [], charged_words: 0 } }
pub fn reset_dependencies(dependencies: &mut Dependencies) {
    dependencies.declarations.clear(); dependencies.charged_words = 0
}
fn valid_dependencies(dependencies: &Dependencies, declaration_limit: i32) -> bool {
    if declaration_limit < 0 || dependencies.declarations.len > 256 || dependencies.charged_words < 0 || dependencies.charged_words > word_limit() { return false }
    mut previous := -1
    for declaration in &dependencies.declarations {
        if declaration <= previous || declaration >= declaration_limit { return false }
        previous = declaration
    }
    true
}
pub fn charge_dependency_words(dependencies: &mut Dependencies, estimate: i32) -> bool {
    if !valid_dependencies(&dependencies, 2147483647) || estimate < 0 || estimate > remaining_words(&dependencies) { return false }
    dependencies.charged_words = dependencies.charged_words + estimate; true
}
pub fn record_dependency(dependencies: &mut Dependencies, declaration: i32, estimate: i32) -> bool {
    if !valid_dependencies(&dependencies, 2147483647) || declaration < 0 || declaration == 2147483647 || estimate < 0 || estimate > remaining_words(&dependencies) { return false }
    mut at := 0
    while at < dependencies.declarations.len && dependencies.declarations[at] < declaration { at = at + 1 }
    present := at < dependencies.declarations.len && dependencies.declarations[at] == declaration
    if !present && dependencies.declarations.len == 256 { return false }
    if !present {
        dependencies.declarations.push(declaration)
        mut i := dependencies.declarations.len - 1
        while i > at { dependencies.declarations[i] = dependencies.declarations[i - 1]; i = i - 1 }
        dependencies.declarations[at] = declaration
    }
    dependencies.charged_words = dependencies.charged_words + estimate; true
}
fn valid_key(key: string) -> bool {
    if key.len != 64 { return false }
    for b in key.bytes() { if !(b >= 48 && b <= 57) && !(b >= 97 && b <= 102) { return false } }
    true
}
fn publish(path: string, key: string, output: &[]u8) -> bool {
    if output.len > 67108864 - 128 || !cli.prepare_parent(path) { return false }
    payload := sys.decode_u8(&output)
    if !payload.ok { return false }
    temporary := path + "." + sys.pid().str() + ".tmp"
    signature := cache_io.digest(key + payload.value)
    written := sys.write_text(temporary, key + signature + payload.value)
    if written.ok {
        updated := sys.rename(temporary, path)
        if updated.ok { return true }
    }
    _ := sys.remove_file(temporary); false
}
pub fn save(code: &arm.Code, begin: Start, globals: i32,
    path: string, key: string, dependencies: &Dependencies, declaration_limit: i32) -> bool {
    if !valid_key(key) || !valid_dependencies(&dependencies, declaration_limit) || code.checking { return false }
    if begin.words < 0 || begin.words >= code.words.len || begin.labels < 0 || begin.labels > code.labels.len || begin.relocations < 0 || begin.relocations > code.at.len { return false }
    if globals < 0 || globals > begin.labels || code.at.len != code.target.len || code.at.len != code.kinds.len { return false }
    words := code.words.len - begin.words; labels := code.labels.len - begin.labels; relocations := code.at.len - begin.relocations
    size := i64(7) + i64(words) + i64(labels) + i64(relocations) * 3 + i64(dependencies.declarations.len)
    if size * 8 + 128 > 67108864 { return false }
    mut output: []u8 = []
    header(&mut output, words, labels, relocations, dependencies.declarations.len, dependencies.charged_words)
    for i in begin.words..code.words.len {
        word := code.words[i]
        if word < 0 || word > 4294967295 { return false }
        put(&mut output, word)
    }
    for i in begin.labels..code.labels.len {
        mut offset := code.labels[i]; if offset >= 0 { if offset < begin.words { return false }; offset = offset - begin.words }
        if !label_record(&mut output, offset, words) { return false }
    }
    for i in begin.relocations..code.at.len {
        at := code.at[i]; target := code.target[i]; kind := code.kinds[i]
        if at < begin.words || at >= code.words.len || kind < 0 || kind > 20 || (kind >= 2 && at + 1 >= code.words.len) { return false }
        if target < 0 || target >= code.labels.len { return false }
        if target >= globals && code.labels[target] < begin.words { return false }
        if !relocation_record(&mut output, at - begin.words, target, kind, words, begin.labels, code.labels.len, globals) { return false }
    }
    for declaration in &dependencies.declarations { put(&mut output, i64(declaration)) }
    publish(path, key, &output)
}
fn object_payload(output: &mut []u8, object: &lower.FunctionObject,
    first_label: i32, label_end: i32, globals: i32, count: i32, charged: i32) -> bool {
    if !lower.object_ready(&object) || first_label < 0 || label_end < first_label || globals < 0 || globals > first_label { return false }
    if lower.object_first_label(&object) != first_label || lower.object_label_end(&object) != label_end ||
        lower.object_import_count(&object) != 0 { return false }
    words := lower.object_word_count(&object); labels := label_end - first_label
    relocations := lower.object_reloc_count(&object)
    has_x86 := lower.object_has_x86(&object)
    has_wasm := lower.object_has_wasm(&object)
    if has_x86 && has_wasm { return false }
    mut extra_words: i64 = 0
    if has_x86 {
        x := lower.object_x86(&object)
        extra_words = i64(3) + i64((x.text.len + 3) / 4) + i64(labels) + i64(x.reloc_at.len) * 2 + i64(x.stack_traps.len)
    } else if has_wasm {
        w := lower.object_wasm(&object)
        extra_words = i64(6) + i64((w.body.len + 3) / 4) + i64(w.patch_at.len) * 3
    }
    size := i64(7) + i64(words) + i64(labels) + i64(relocations) * 3 + i64(count) + extra_words
    if words <= 0 || size * 8 + 128 > 67108864 { return false }
    n := lower.object_label_count(&object)
    if i64(n) < i64(labels) || i64(n) > i64(labels) + 1 { return false }
    mut first := 0
    if n > 0 && lower.object_label_id(&object, 0) < first_label { first = 1 }
    if labels > n - first { return false }
    for i in 0..labels { if lower.object_label_id(&object, first + i) != first_label + i { return false } }
    if first == 1 && lower.object_label_offset(&object, 0) != 0 { return false }
    if n > first + labels {
        if first != 0 || lower.object_label_id(&object, n - 1) < label_end || lower.object_label_offset(&object, n - 1) != 0 { return false }
    }
    version := if has_x86 { i64(2) } else if has_wasm { i64(3) } else { i64(1) }
    header_version(&mut output, version, words, labels, relocations, count, charged)
    for i in 0..words {
        word := lower.object_word(&object, i)
        if word < 0 || word > 4294967295 { return false }; put(&mut output, word)
    }
    for i in 0..labels {
        if !label_record(&mut output, lower.object_label_offset(&object, first + i), words) { return false }
    }
    for i in 0..relocations {
        target := lower.object_reloc_target(&object, i)
        if target >= globals {
            if target < first_label || target >= label_end { return false }
            if lower.object_label_offset(&object, first + target - first_label) < 0 { return false }
        }
        if !relocation_record(&mut output, lower.object_reloc_at(&object, i), target,
            lower.object_reloc_kind(&object, i), words, first_label, label_end, globals) { return false }
    }
    true
}
fn append_x86_trailer(output: &mut []u8, object: &lower.FunctionObject, first_label: i32, label_end: i32, globals: i32) -> bool {
    if !lower.object_has_x86(&object) { return true }
    x := lower.object_x86(&object)
    labels := label_end - first_label
    n := lower.object_label_count(&object)
    mut first := 0
    if n > 0 && lower.object_label_id(&object, 0) < first_label { first = 1 }
    x_bytes := x.text.len; x_words := (x_bytes + 3) / 4
    x_relocs := x.reloc_at.len; x_traps := x.stack_traps.len
    put(&mut output, i64(x_bytes)); put(&mut output, i64(x_relocs)); put(&mut output, i64(x_traps))
    for wi in 0..x_words {
        mut w: i64 = 0
        for bi in 0..4 {
            idx := wi * 4 + bi
            if idx < x_bytes { w = w.bit_or(i64(x.text[idx]).shl(bi * 8)) }
        }
        put(&mut output, w)
    }
    for i in 0..labels {
        off := x.label_bytes[first + i]
        if off < 0 { put(&mut output, 4294967295) } else { put(&mut output, i64(off)) }
    }
    for i in 0..x_relocs {
        put(&mut output, i64(x.reloc_at[i]))
        target := x.reloc_target[i]
        if target < globals { put(&mut output, 2147483648 + i64(target)) }
        else if target >= first_label && target < label_end { put(&mut output, i64(target - first_label)) }
        else { return false }
    }
    for i in 0..x_traps { put(&mut output, i64(x.stack_traps[i])) }
    true
}
fn append_wasm_trailer(output: &mut []u8, object: &lower.FunctionObject, first_label: i32, label_end: i32, globals: i32) -> bool {
    if !lower.object_has_wasm(&object) { return true }
    w := lower.object_wasm(&object)
    w_bytes := w.body.len; w_words := (w_bytes + 3) / 4
    w_patches := w.patch_at.len
    if w_bytes <= 0 || w.local_i64_count < 8 || w.prints_mask < 0 || w.prints_mask > 511 { return false }
    put(&mut output, i64(w_bytes))
    put(&mut output, i64(w.local_i64_count))
    put(&mut output, if w.needs_pc_local { 1 } else { 0 })
    put(&mut output, if w.structured { 1 } else { 0 })
    put(&mut output, i64(w.prints_mask))
    put(&mut output, i64(w_patches))
    for wi in 0..w_words {
        mut word: i64 = 0
        for bi in 0..4 {
            idx := wi * 4 + bi
            if idx < w_bytes { word = word.bit_or(i64(w.body[idx]).shl(bi * 8)) }
        }
        put(&mut output, word)
    }
    for i in 0..w_patches {
        at := w.patch_at[i]; kind := w.patch_kind[i]; target := w.patch_target[i]
        if at < 0 || at > w_bytes || kind < 0 || kind > 4 || target < 0 { return false }
        put(&mut output, i64(at))
        put(&mut output, i64(kind))
        if kind == 0 || kind == 1 || kind == 3 {
            if target < globals { put(&mut output, 2147483648 + i64(target)) }
            else if target >= first_label && target < label_end { put(&mut output, i64(target - first_label)) }
            else { return false }
        } else {
            if kind == 2 && target >= 9 { return false }
            put(&mut output, i64(target))
        }
    }
    true
}
pub fn save_object(object: &lower.FunctionObject, first_label: i32, label_end: i32,
    globals: i32, path: string, key: string, dependencies: &Dependencies, declaration_limit: i32) -> bool {
    if !valid_key(key) || !valid_dependencies(&dependencies, declaration_limit) { return false }
    mut output: []u8 = []
    if !object_payload(&mut output, &object, first_label, label_end, globals,
        dependencies.declarations.len, dependencies.charged_words) { return false }
    for declaration in &dependencies.declarations { put(&mut output, i64(declaration)) }
    if !append_x86_trailer(&mut output, &object, first_label, label_end, globals) { return false }
    if !append_wasm_trailer(&mut output, &object, first_label, label_end, globals) { return false }
    publish(path, key, &output)
}
pub fn restore(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_words: i32,
    dependencies: &mut Dependencies) -> bool {
    mut ignored := x86_mir.empty()
    mut ignored_wasm := wasm_mir.empty()
    restore_impl(&mut code, globals, entry, path, key, declaration_limit, available_words, &mut dependencies, &mut ignored, &mut ignored_wasm, false)
}
pub fn restore_with_x86(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_words: i32,
    dependencies: &mut Dependencies, out_x86: &mut x86_mir.Object) -> bool {
    mut ignored_wasm := wasm_mir.empty()
    restore_impl(&mut code, globals, entry, path, key, declaration_limit, available_words, &mut dependencies, &mut out_x86, &mut ignored_wasm, true)
}
pub fn restore_with_backends(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_words: i32,
    dependencies: &mut Dependencies, out_x86: &mut x86_mir.Object, out_wasm: &mut wasm_mir.Object) -> bool {
    restore_impl(&mut code, globals, entry, path, key, declaration_limit, available_words, &mut dependencies, &mut out_x86, &mut out_wasm, true)
}
fn restore_impl(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_words: i32,
    dependencies: &mut Dependencies, out_x86: &mut x86_mir.Object, out_wasm: &mut wasm_mir.Object,
    require_backend: bool) -> bool {
    x86_mir.reset(&mut out_x86)
    wasm_mir.reset(&mut out_wasm)
    if !valid_key(key) || declaration_limit < 0 || available_words < 0 || code.checking { return false }
    if globals < 0 || globals > code.labels.len || entry < 0 || entry >= code.labels.len || code.labels[entry] != -1 { return false }
    if code.at.len != code.target.len || code.at.len != code.kinds.len { return false }
    info := sys.metadata(path)
    if !info.is_file || info.size < 184 || info.size > 67108864 { return false }
    read := sys.read_u8(path)
    if !read.ok || read.value.len < 184 || read.value.len > 67108864 { return false }
    stored_key := &read.value[0..64]
    if !bytes.equals_text(&stored_key, 0, stored_key.len, key) { return false }
    payload := &read.value[128..read.value.len]
    signature := &read.value[64..128]
    if !bytes.equals_text(&signature, 0, signature.len, cache_io.digest_parts(key, &payload)) { return false }
    data := values(&payload)
    if data.len < 7 || data[0] != 1146439236 || (data[1] != 1 && data[1] != 2 && data[1] != 3) { return false }
    version := data[1]
    if require_backend && code.platform == 2 && version != 2 { return false }
    if require_backend && (code.platform == 3 || code.platform == 4) && version != 3 { return false }
    word_count := data[2]; label_count := data[3]; relocation_count := data[4]
    dependency_count := data[5]; charged_words := data[6]
    if word_count==0 || dependency_count>256 || charged_words>i64(word_limit()) || charged_words>i64(available_words){return false}
    size:=i64(7)+word_count+label_count+relocation_count*3+dependency_count
    if word_count>i64(2147483647-code.words.len) || label_count>i64(2147483647-code.labels.len) || relocation_count>i64(2147483647-code.at.len){return false}
    if version == 1 && size != i64(data.len) { return false }
    if version == 2 && i64(data.len) < size + 3 { return false }
    if version == 3 && i64(data.len) < size + 6 { return false }
    words:=i32(word_count);labels:=i32(label_count);relocations:=i32(relocation_count);count:=i32(dependency_count)
    label_start := 7 + words; relocation_start := label_start + labels
    declaration_start := relocation_start + relocations * 3
    mut previous: i64 = -1
    for i in 0..count {
        declaration := data[declaration_start + i]
        if declaration <= previous || declaration >= i64(declaration_limit) { return false }
        previous = declaration
    }
    for i in 0..labels {
        offset := data[label_start + i]
        if offset != 4294967295 && offset > i64(words) { return false }
    }
    for i in 0..relocations {
        at := data[relocation_start + i * 3]; target := data[relocation_start + i * 3 + 1]; kind := data[relocation_start + i * 3 + 2]
        if at >= i64(words) || kind > 20 || (kind >= 2 && at + 1 >= i64(words)) { return false }
        if target >= 2147483648 {
            if target - 2147483648 >= i64(globals) { return false }
        } else if target >= i64(labels) || data[label_start + i32(target)] == 4294967295 { return false }
    }
    mut x_bytes := 0; mut x_words := 0; mut x_relocs := 0; mut x_traps := 0
    mut x_text_start := 0; mut x_labels_start := 0; mut x_relocs_start := 0; mut x_traps_start := 0
    if version == 2 {
        x_base := i32(size)
        if data[x_base] <= 0 || data[x_base] > 67108864 || data[x_base + 1] < 0 || data[x_base + 1] > 1048576 ||
            data[x_base + 2] < 0 || data[x_base + 2] > 1048576 { return false }
        x_bytes = i32(data[x_base]); x_words = (x_bytes + 3) / 4
        x_relocs = i32(data[x_base + 1]); x_traps = i32(data[x_base + 2])
        expected := size + i64(3) + i64(x_words) + i64(labels) + i64(x_relocs) * 2 + i64(x_traps)
        if expected != i64(data.len) { return false }
        x_text_start = x_base + 3
        x_labels_start = x_text_start + x_words
        x_relocs_start = x_labels_start + labels
        x_traps_start = x_relocs_start + x_relocs * 2
        for i in 0..labels {
            off := data[x_labels_start + i]
            if off != 4294967295 && off > i64(x_bytes) { return false }
        }
        for i in 0..x_relocs {
            at := data[x_relocs_start + i * 2]; target := data[x_relocs_start + i * 2 + 1]
            if at > i64(x_bytes - 4) { return false }
            if target >= 2147483648 {
                if target - 2147483648 >= i64(globals) { return false }
            } else if target >= i64(labels) || data[x_labels_start + i32(target)] == 4294967295 { return false }
        }
        for i in 0..x_traps {
            if data[x_traps_start + i] > i64(x_bytes - 4) { return false }
        }
    }
    mut w_bytes := 0; mut w_words := 0; mut w_locals := 8; mut w_needs_pc := false
    mut w_structured := false; mut w_prints_mask := 0; mut w_patches := 0; mut w_body_start := 0; mut w_patch_start := 0
    if version == 3 {
        w_base := i32(size)
        if data[w_base] <= 0 || data[w_base] > 67108864 || data[w_base + 1] < 8 || data[w_base + 1] > 65536 ||
            (data[w_base + 2] != 0 && data[w_base + 2] != 1) || (data[w_base + 3] != 0 && data[w_base + 3] != 1) ||
            data[w_base + 4] < 0 || data[w_base + 4] > 511 || data[w_base + 5] < 0 || data[w_base + 5] > 1048576 { return false }
        w_bytes = i32(data[w_base]); w_words = (w_bytes + 3) / 4
        w_locals = i32(data[w_base + 1])
        w_needs_pc = data[w_base + 2] != 0
        w_structured = data[w_base + 3] != 0
        w_prints_mask = i32(data[w_base + 4])
        w_patches = i32(data[w_base + 5])
        expected := size + i64(6) + i64(w_words) + i64(w_patches) * 3
        if expected != i64(data.len) { return false }
        w_body_start = w_base + 6
        w_patch_start = w_body_start + w_words
        mut prev_at: i64 = 0
        for i in 0..w_patches {
            at := data[w_patch_start + i * 3]; kind := data[w_patch_start + i * 3 + 1]; target := data[w_patch_start + i * 3 + 2]
            if at < prev_at || at > i64(w_bytes) || kind > 4 { return false }
            if kind == 0 || kind == 1 || kind == 3 {
                if target >= 2147483648 {
                    if target - 2147483648 >= i64(globals) { return false }
                } else if target >= i64(labels) || data[label_start + i32(target)] == 4294967295 { return false }
            } else {
                if kind == 2 && target >= 9 { return false }
                if target >= 2147483648 { return false }
            }
            prev_at = at
        }
    }
    mut accepted := new_dependencies()
    for i in 0..count { accepted.declarations.push(i32(data[declaration_start + i])) }
    accepted.charged_words = i32(charged_words)
    base := code.words.len; first := code.labels.len
    arm.mark(&mut code, entry)
    for i in 0..words { code.words.push(data[7 + i]) }
    for i in 0..labels {
        offset := data[label_start + i]
        if offset == 4294967295 { code.labels.push(-1) } else { code.labels.push(base + i32(offset)) }
    }
    for i in 0..relocations {
        destination := data[relocation_start + i * 3 + 1]
        mut target := 0
        if destination >= 2147483648 { target = i32(destination - 2147483648) } else { target = first + i32(destination) }
        code.at.push(base + i32(data[relocation_start + i * 3])); code.kinds.push(i32(data[relocation_start + i * 3 + 2])); code.target.push(target)
    }
    if version == 2 {
        out_x86.text.reserve(x_bytes)
        for wi in 0..x_words {
            w := data[x_text_start + wi]
            for bi in 0..4 {
                if wi * 4 + bi < x_bytes { out_x86.text.push(u8(w.shr(bi * 8).bit_and(255))) }
            }
        }
        if entry < first { out_x86.label_ids.push(entry); out_x86.label_bytes.push(0) }
        for i in 0..labels {
            out_x86.label_ids.push(first + i)
            off := data[x_labels_start + i]
            if off == 4294967295 { out_x86.label_bytes.push(-1) } else { out_x86.label_bytes.push(i32(off)) }
        }
        if entry >= first + labels { out_x86.label_ids.push(entry); out_x86.label_bytes.push(0) }
        for i in 0..x_relocs {
            out_x86.reloc_at.push(i32(data[x_relocs_start + i * 2]))
            destination := data[x_relocs_start + i * 2 + 1]
            if destination >= 2147483648 { out_x86.reloc_target.push(i32(destination - 2147483648)) }
            else { out_x86.reloc_target.push(first + i32(destination)) }
        }
        for i in 0..x_traps { out_x86.stack_traps.push(i32(data[x_traps_start + i])) }
        out_x86.ready = true
    }
    if version == 3 {
        out_wasm.body.reserve(w_bytes)
        for wi in 0..w_words {
            w := data[w_body_start + wi]
            for bi in 0..4 {
                if wi * 4 + bi < w_bytes { out_wasm.body.push(u8(w.shr(bi * 8).bit_and(255))) }
            }
        }
        out_wasm.local_i64_count = w_locals
        out_wasm.needs_pc_local = w_needs_pc
        out_wasm.structured = w_structured
        out_wasm.prints_mask = w_prints_mask
        out_wasm.entry_label = entry
        for i in 0..w_patches {
            out_wasm.patch_at.push(i32(data[w_patch_start + i * 3]))
            kind := i32(data[w_patch_start + i * 3 + 1])
            out_wasm.patch_kind.push(kind)
            raw_target := data[w_patch_start + i * 3 + 2]
            if kind == 0 || kind == 1 || kind == 3 {
                if raw_target >= 2147483648 { out_wasm.patch_target.push(i32(raw_target - 2147483648)) }
                else { out_wasm.patch_target.push(first + i32(raw_target)) }
            } else {
                out_wasm.patch_target.push(i32(raw_target))
            }
        }
        out_wasm.ready = true
    }
    dependencies = accepted; true
}
