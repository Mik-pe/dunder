            if brace_scopes.len > 0 { lexical = brace_scopes.pop() }
            if lexical {
                while levels.len > 0 && levels[levels.len - 1] >= depth && active[active.len - 1] <= i { _ := locals.pop(); _ := levels.pop(); _ := active.pop() }
            }
            depth = depth - 1
            if depth == 0 {
                mode = 0; in_impl = false; in_trait = false; in_where = false; impl_type_param_count = 0; locals.clear(); levels.clear(); active.clear()
                type_params.clear(); type_end = -1; generic_params_start = -1; generic_params_end = -1; initials = namespace; for_tuple_end = -1; for_tuple_visible = -1
            }
            else if depth == 1 && in_impl {
                mode = 5; locals.clear(); levels.clear(); active.clear()
                while type_params.len > impl_type_param_count { _ := type_params.pop() }
                in_where = false; generic_params_start = -1; generic_params_end = -1; type_end = -1; for_tuple_end = -1; for_tuple_visible = -1
                if type_params.len == 0 { initials = namespace }
            }
            else if depth == 1 && in_trait { mode = 7; locals.clear(); levels.clear(); active.clear() }
        }
        previous = i + consumed - 1
        i = i + consumed
    }
    if loader.result.token_offsets { flat_token(&mut tokens,.Newline,"\n",start+loader.result.sources[owner].len) }
    else { output.push(10) }
}
pub fn location(loaded: &Loaded, offset: i32) -> Location {
    mut lo := 0
    mut hi := loaded.map_starts.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if loaded.map_starts[mid] <= offset { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return Location { path: loaded.path.clone(), source: loaded.sources[0].clone(), offset: 0 } }
    index := lo - 1
    owner := loaded.map_files[index]
    if loaded.token_offsets {
        return Location { path: loaded.paths[owner].clone(), source: loaded.sources[owner].clone(), offset: offset - loaded.map_starts[index] }
    }
    Location { path: loaded.paths[owner].clone(), source: loaded.sources[owner].clone(), offset: loaded.map_offsets[index] }
}
pub fn module_source(loader: &Loader, owner: i32) -> string { loader.result.sources[owner].clone() }
pub fn module_bytes(loader: &Loader, owner: i32) -> i32 { loader.result.sources[owner].len }

pub fn admit_tokens(loader: &mut Loader, owner: i32, packed: &lexer.Packed) -> bool {
    first := loader.raw.texts.len
    source := module_source(&loader, owner)
    lexer.append_packed(&mut loader.raw, source, &packed)
    scan_declarations(&mut loader, owner, first)
    loader.result.ok
}

pub fn scan_wave_serial(loader: &mut Loader, start: i32, stop: i32, _jobs: i32) {
    for owner in start..stop {
        first := loader.raw.texts.len
        source := module_source(&loader, owner)
        lexer.scan_into(source, &mut loader.raw)
        scan_declarations(&mut loader, owner, first)
        if !loader.result.ok { return }
    }
}

pub fn load(path: string) -> Loaded {
    mut unused := lexer.empty(false)
    load_for(path, false, false, &mut unused)
}
pub fn load_for(path: string, testing: bool, token_offsets: bool, tokens: &mut lexer.Tokens) -> Loaded {
    load_group(path, testing, token_offsets, -1, false, &mut tokens)
}

pub fn load_group(path: string, testing: bool, token_offsets: bool, group: i32, wasm_suite: bool, tokens: &mut lexer.Tokens) -> Loaded {
    empty: []string = []
    load_group_with_deps(path, testing, token_offsets, group, wasm_suite, &mut tokens, &empty, &empty, &empty, &serial_lexing())
}

fn new_loader(path: string, testing: bool, token_offsets: bool, deps: &DepGraph) -> Loader {
    Loader {
        result: Loaded { token_offsets: token_offsets, groups: [], calls: [], ok: true, error: "", path: path.clone(), source: "", offset: 0,
            paths: [], sources: [], symbols: [], module_caps: [], diagnostics: [], map_starts: [], map_files: [], map_offsets: [], json_symbols: [],
            embed_blobs: [], embed_blob_starts: [], embed_blob_counts: [], embed_blob_digests: [], embed_paths: [] },
        key_prefixes: [], standard: [], directories: [], first: [], last: [], raw: lexer.empty(false), last_arm: [], namespace_initials: [], hidden_starts: [], hidden_ends: [], declaration_tokens: [], any_unsafe: false, requires_caps: [], has_cap_header: [],
        symbols: Map<string, i64>::new(), imports: Map<string, i64>::new(), sym_imports: Map<string, i64>::new(), by_path: Map<string, i64>::new(), by_physical: Map<string, i64>::new(), by_std: Map<string, i64>::new(), owners: [],
        sym_import_owner: [], sym_import_alias: [], sym_import_module: [], sym_import_member: [], sym_import_offset: [], sym_import_symbol: [], sym_import_prelude: [], public: [], records: [], types: [], traits: [], renamed: [],
        testing: testing, test_tags: [], test_targets: [], test_ends: [], next_test: 0,
        deps: DepGraph {
            pkg_dirs: deps.pkg_dirs.clone(), pkg_entries: deps.pkg_entries.clone(),
            pkg_caps: deps.pkg_caps.clone(), pkg_labels: deps.pkg_labels.clone(),
            edge_owners: deps.edge_owners.clone(), edge_names: deps.edge_names.clone(), edge_targets: deps.edge_targets.clone(),
        },
        module_cap_limit: [], module_pkg: [], module_pkg_id: [],
        error_count: 0,
        tracked_import_owners: [], tracked_import_aliases: [], tracked_import_starts: [], tracked_import_lasts: [], tracked_import_used: [],
        tracked_import_targets: [],
        tracked_import_index: Map<string, i64>::new(),
        module_has_tests: [],
        test_hidden_owners: [], test_hidden_starts: [], test_hidden_ends: [],
        overlay_paths: [], overlay_sources: [],
    }
}

pub fn bind_source_generics(input: &mut lexer.Tokens) {
    mut found := false
    for i in 0..input.kinds.len {
        if input.kinds[i] == .Name {
            word := &input.texts[i]
            if bundled.prelude_export("", word) != "" && (!bundled.prelude_generic(word) || (i + 1 < input.kinds.len && (lexer.symbol(&input, i + 1, "<") || lexer.symbol(&input, i + 1, "::")))) {
                found = true; break
            }
        }
        if i + 2 < input.kinds.len && input.kinds[i + 1] == .Name && lexer.symbol(&input, i + 2, "<") &&
            (input.texts[i] == "fn" || input.texts[i] == "struct" || input.texts[i] == "enum" || input.texts[i] == "impl" || input.texts[i] == "for") &&
            !strings.starts_with(input.texts[i + 1], "__dunder_module_") { found = true; break }
        if i + 3 < input.kinds.len && input.texts[i] == "impl" && input.kinds[i + 1] == .Name && input.texts[i + 2] == "for" &&
            (lexer.symbol(&input, i + 3, "[") || lexer.symbol(&input, i + 3, "(")) {
            found = true; break
        }
    }
    if !found { return }
    for i in 0..input.kinds.len {
        if input.kinds[i] == .Keyword && input.texts[i] == "import" {
            input.ok = false; input.error = "imports must be loaded first"; input.error_at = input.starts[i]; return
        }
    }
    no_deps := empty_deps()
    mut loader := new_loader("<source>", true, true, &no_deps)
    loader.result.paths.push("<source>"); loader.result.sources.push(input.source.clone())
    loader.key_prefixes.push("0:"); loader.namespace_initials.push(0)
    loader.directories.push(""); loader.standard.push(""); loader.first.push(0); loader.last.push(0)
    loader.module_cap_limit.push(31); loader.module_pkg.push(""); loader.module_pkg_id.push(0); loader.module_has_tests.push(false)
    loader.raw = replace(&mut input, lexer.empty(false))
    scan_declarations(&mut loader, 0, 0)
    if loader.result.ok {
        for id in 0..loader.renamed.len {
            name := &loader.result.symbols[id]
            if !is(&loader, loader.declaration_tokens[id] + 1, "<") {
                loader.renamed[id] = name.clone()
            }
        }
        loader.test_tags.clear(); loader.hidden_starts.clear(); loader.hidden_ends.clear()
        mut bindings: []i32 = []; mut scratch_bytes: []u8 = []; mut resolved := lexer.empty(false)
        flatten(&mut loader, 0, &mut scratch_bytes, &mut bindings, &mut resolved, 0, true)
        for b in 0..bindings.len / 2 {
            loader.raw.texts[bindings[b * 2]] = resolved.texts[bindings[b * 2 + 1]].clone()
        }
    }
    input = move loader.raw
    if !loader.result.ok { input.ok = false; input.error = move loader.result.error; input.error_at = loader.result.offset }
}

pub fn load_group_with_deps(path: string, testing: bool, token_offsets: bool, group: i32, wasm_suite: bool, tokens: &mut lexer.Tokens,
    dep_names: &[]string, dep_dirs: &[]string, dep_entries: &[]string, lexing: &Lexing) -> Loaded {
    mut default_caps: []i32 = []
    for _ in 0..dep_names.len { default_caps.push(31) }
    load_group_with_deps_capped(path, testing, token_offsets, group, wasm_suite, &mut tokens, &dep_names, &dep_dirs, &dep_entries, &default_caps, &lexing)
}
pub fn load_group_with_deps_capped(path: string, testing: bool, token_offsets: bool, group: i32, wasm_suite: bool, tokens: &mut lexer.Tokens,
    dep_names: &[]string, dep_dirs: &[]string, dep_entries: &[]string, dep_caps: &[]i32, lexing: &Lexing) -> Loaded {
    mut deps := empty_deps()
    for k in 0..dep_names.len {
        pkg := deps.pkg_dirs.len
        deps.pkg_dirs.push(dep_dirs[k].clone())
        entry := if k < dep_entries.len { dep_entries[k].clone() } else { "" }
        cap := if k < dep_caps.len { dep_caps[k] } else { 31 }
        deps.pkg_entries.push(move entry)
        deps.pkg_caps.push(cap)
        deps.pkg_labels.push(dep_names[k].clone())
        deps.edge_owners.push(0)
        deps.edge_names.push(dep_names[k].clone())
        deps.edge_targets.push(pkg)
    }
    load_group_with_dep_graph(path, testing, token_offsets, group, wasm_suite, &mut tokens, &deps, &lexing)
}
pub fn load_group_with_dep_graph(path: string, testing: bool, token_offsets: bool, group: i32, wasm_suite: bool, tokens: &mut lexer.Tokens,
    deps: &DepGraph, lexing: &Lexing) -> Loaded {
    empty_ov: []string = []
    load_group_with_overlays(path, testing, token_offsets, group, wasm_suite, &mut tokens, &deps, &lexing, &empty_ov, &empty_ov)
}
pub fn load_group_with_overlays(path: string, testing: bool, token_offsets: bool, group: i32, wasm_suite: bool, tokens: &mut lexer.Tokens,
    deps: &DepGraph, lexing: &Lexing, overlay_paths: &[]string, overlay_sources: &[]string) -> Loaded {
    mut loader := new_loader(path, testing, token_offsets, &deps)
    for k in 0..overlay_paths.len {
        if k < overlay_sources.len {
            loader.overlay_paths.push(normalize(overlay_paths[k].clone()))
            loader.overlay_sources.push(overlay_sources[k].clone())
        }
    }
    loader.raw.store_ends = !token_offsets
    _ := add(&mut loader, path, "", -1, 0)
    mut owner := 0
    while owner < loader.result.paths.len && loader.result.ok {
        // Keep declaration processing in discovery order, even when the
        // already-discovered files are tokenized concurrently.
        stop := loader.result.paths.len
        if lexing.jobs > 1 && stop > owner + 1 { lexing.scan(&mut loader, owner, stop, lexing.jobs) }
        else { scan_wave_serial(&mut loader, owner, stop, 1) }
        owner = stop
    }
    if loader.result.ok { resolve_symbol_imports(&mut loader) }
    if loader.result.ok {
        jmod := i32(loader.by_std.get_or("json", -1))
        if jmod >= 0 {
            jnames: []string = ["Encode", "Decode", "Writer", "Doc", "JsonError", "Kind", "decode", "decode_field"]
            for jname in &jnames {
                jid := i32(loader.symbols.get_or(key(&loader, jmod, jname.clone()), -1))
                loader.result.json_symbols.push(if jid >= 0 { loader.renamed[jid].clone() } else { "" })
            }
        }
    }
    mut output: []u8 = []
    mut unused_bindings: []i32 = []
    if loader.result.ok {
        if token_offsets {
            reserve_tokens := loader.raw.kinds.len + 8
            tokens.kinds.reserve(reserve_tokens); tokens.texts.reserve(reserve_tokens)
            tokens.starts.reserve(reserve_tokens)
        } else {
            mut total_bytes := 32
            for s in &loader.result.sources { total_bytes = total_bytes + s.len + 2 }
            output.reserve(total_bytes)
        }
    }
    if loader.any_unsafe {
        if token_offsets {
            flat_token(&mut tokens,.Name,"capability",0);flat_token(&mut tokens,.Name,"unsafe",0);flat_token(&mut tokens,.Newline,"\n",0)
        } else { bytes.append_utf8(&mut output,"capability unsafe\n") }
    }
    mut flattened_all := false
    if loader.result.ok {
        mut position := 0
        owner = 0
        while owner < loader.result.paths.len && loader.error_count < 32 {
            flatten(&mut loader, owner, &mut output, &mut unused_bindings, &mut tokens, position, false)
            position = position + loader.result.sources[owner].len + 1; owner = owner + 1
        }
        flattened_all = owner == loader.result.paths.len
        if flattened_all { emit_unused_import_warnings(&mut loader) }
        if token_offsets && loader.result.ok {
            flat_token(&mut tokens,.End,"",position)
            return loader.result
        }
    }
    if loader.result.ok {
        if testing {
            if group >= loader.result.calls.len {
                fail(&mut loader, 0, 0, "test group ID is out of range")
                return loader.result
            }
            if group >= 0 || wasm_suite { test_suite.direct_entry(&mut output, &loader.result.calls, group) }
            else { test_suite.entry(&mut output, &loader.result.groups, &loader.result.calls) }
        }
        loader.result.source = match utf8.decode(&output) { .Ok(value) => value, .Err(_) => "" }
    }
    loader.result
}

@test fn dotted_names_and_literal_slash_paths_resolve_relative_modules() {
    bare_path("...shared.value") == "../../shared/value"
    bare_path("../../libs.v1/pair-value") == "../../libs.v1/pair-value"
    bare_path("std..map") == ""
    bare_path("std.map.ddr") == ""
    !valid_alias("pair-value")
    !valid_alias("ptr")
    !valid_alias("TaskID")
    valid_alias("pair")
    valid_alias("var")
}

@test fn paths_collapse_components_without_losing_relative_parents() {
    normalize("./src/../main.ddr") == "main.ddr"
    normalize("../../lib/./module.ddr") == "../../lib/module.ddr"
    normalize("/../src//nested/../main.ddr") == "/src/main.ddr"
    normalize("a/..") == "."
    normalize("/") == "/"
}

@test fn diagnostics_select_original_module_and_token_offset() {
    loaded := Loaded { token_offsets: false, groups: [], calls: [],
        ok: true, error: "", path: "main.ddr", source: "fn main", offset: 0,
        paths: ["main.ddr", "lib.ddr"], symbols: [], module_caps: [], diagnostics: [], sources: ["fn main() {}", "\nfn value() {}"],
        map_starts: [0, 3, 20], map_files: [0, 0, 1], map_offsets: [0, 3, 4], json_symbols: [],
        embed_blobs: [], embed_blob_starts: [], embed_blob_counts: [], embed_blob_digests: [], embed_paths: [],
    }
    first := location(&loaded, 0)
    first.path == "main.ddr"
    first.offset == 0
    last := location(&loaded, 22)
    last.path == "lib.ddr"
    last.source == "\nfn value() {}"
    last.offset == 4
}

@test fn header_delimiters_balance_nested_calls_indexes_records_and_literals() {
    tokens := lexer.scan("(read([Bound{value: step(0)}, Bound{value: 1}][0].value, \"}])\")) { body }", false)
    mut stack: []i32 = []
    after := balanced_end(&tokens.kinds, &tokens.texts, 0, tokens.kinds.len, &mut stack)
    after > 0
    tokens.texts[after] == "{"
    tokens.texts[after - 1] == ")"
    bad := lexer.scan("([)]", false)
    balanced_end(&bad.kinds, &bad.texts, 0, bad.kinds.len, &mut stack) == -1
    missing := lexer.scan("(read(Bound{value: 1})", false)
    balanced_end(&missing.kinds, &missing.texts, 0, missing.kinds.len, &mut stack) == -1
}

@test fn dependency_paths_resolve_entries_and_submodules() {
    mut deps := empty_deps()
    deps.pkg_dirs.push("../dunder-skrift/src"); deps.pkg_entries.push("../dunder-skrift/src/skrift.ddr"); deps.pkg_caps.push(31); deps.pkg_labels.push("skrift")
    deps.pkg_dirs.push("../plain"); deps.pkg_entries.push(""); deps.pkg_caps.push(31); deps.pkg_labels.push("plain")
    deps.pkg_dirs.push("/"); deps.pkg_entries.push(""); deps.pkg_caps.push(31); deps.pkg_labels.push("rootdir")
    deps.pkg_dirs.push("../other-plain"); deps.pkg_entries.push(""); deps.pkg_caps.push(31); deps.pkg_labels.push("plain")
    deps.edge_owners = [0, 0, 0, 2]
    deps.edge_names = ["skrift", "plain", "rootdir", "plain"]
    deps.edge_targets = [1, 2, 3, 4]
    dep_target(&deps, 0, "skrift").target == "../dunder-skrift/src/skrift.ddr"
    dep_target(&deps, 0, "skrift/ttf").target == "../dunder-skrift/src/ttf.ddr"
    dep_target(&deps, 0, "skrift/sub/glyph").target == "../dunder-skrift/src/sub/glyph.ddr"
    dep_target(&deps, 0, "plain").target == "../plain/plain.ddr"
    dep_target(&deps, 0, "plain/helper").target == "../plain/helper.ddr"
    dep_target(&deps, 2, "plain").target == "../other-plain/plain.ddr"
    dep_target(&deps, 2, "skrift").target == ""
    dep_target(&deps, 0, "rootdir").target == "/rootdir.ddr"
    dep_target(&deps, 0, "rootdir/sub").target == "/sub.ddr"
    dep_target(&deps, 0, "missing").target == ""
    dep_target(&deps, 0, "missing/sub").target == ""
}

@test fn capability_diagnostic_messages_guide_fixes() {
    assert(capability_bit("filesystem") == 1)
    assert(capability_bit("network") == 2)
    assert(capability_bit("process") == 4)
    assert(capability_bit("stdio") == 8)
    assert(capability_bit("unsafe") == 16)
    assert(capability_bit("io") == 0)

    assert(capability_suggestion("io") == "stdio")
    assert(capability_suggestion("IO") == "stdio")
    assert(capability_suggestion("fs") == "filesystem")
    assert(capability_suggestion("net") == "network")
    assert(capability_suggestion("proc") == "process")
    assert(capability_suggestion("ffi") == "unsafe")
    assert(capability_suggestion("unknown_cap") == "")

    assert(invalid_module_capability_message(.Name, "io") ==
        "unknown module capability 'io'; did you mean 'stdio'? (valid capabilities: unsafe, filesystem, network, process, stdio)")
    assert(invalid_module_capability_message(.Name, "banana") ==
        "unknown module capability 'banana' (valid capabilities: unsafe, filesystem, network, process, stdio)")
    assert(invalid_module_capability_message(.Newline, "\n") ==
        "expected a module capability name (valid capabilities: unsafe, filesystem, network, process, stdio)")
    assert(invalid_module_capability_message(.End, "") ==
        "expected a module capability name (valid capabilities: unsafe, filesystem, network, process, stdio)")

    assert(duplicate_module_capability_message("stdio") == "duplicate module capability 'stdio'")
    assert(end_of_capability_message(.Name) ==
        "expected ',' or newline after module capability; separate multiple capabilities with commas (e.g. 'capability filesystem, stdio')")
    assert(end_of_capability_message(.Integer) ==
        "expected end of capability declaration; separate multiple capabilities with commas")
    assert(misplaced_capability_message(false) ==
        "declare capabilities at the beginning of the module, before imports and declarations (e.g. 'capability stdio')")
    assert(misplaced_capability_message(true) ==
        "declare capabilities once at the beginning of the module; combine multiple capabilities with commas (e.g. 'capability filesystem, stdio')")

    assert(missing_capability_names(1) == "filesystem")
    assert(missing_capability_names(9) == "filesystem, stdio")
    assert(missing_capability_message(8, false) ==
        "this function requires capability stdio; add 'capability stdio' at the top of this module")
    assert(missing_capability_message(8, true) ==
        "this function requires capability stdio; add 'stdio' to the 'capability' declaration at the top of this module")
    assert(missing_capability_message(9, true) ==
        "this function requires capability filesystem, stdio; add 'filesystem, stdio' to the 'capability' declaration at the top of this module")

    assert(missing_unsafe_message(false) ==
        "module requires capability unsafe; add 'capability unsafe' at the top of this module")
    assert(missing_unsafe_message(true) ==
        "module requires capability unsafe; add 'unsafe' to the 'capability' declaration at the top of this module")

    assert(invalid_requires_message(.Name, "unsafe", 0) ==
        "@requires does not accept 'unsafe'; mark the function 'unsafe fn' instead (valid @requires capabilities: filesystem, network, process, stdio)")
    assert(invalid_requires_message(.Name, "stdio", 8) ==
        "duplicate @requires capability 'stdio'")
    assert(invalid_requires_message(.Name, "io", 0) ==
        "unknown @requires capability 'io'; did you mean 'stdio'? (expected filesystem, network, process or stdio)")
    assert(invalid_requires_message(.Symbol, ")", 0) ==
        "expected @requires(filesystem), @requires(network), @requires(process) or @requires(stdio)")
}
