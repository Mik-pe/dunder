capability filesystem
import paths
import cache_io
import test_suite
import ..frontend.closures
import ..frontend.diagnostics as diag
import ..frontend.lexer
import ..frontend.type_syntax as syntax
import ..frontend.scalar_rules as rules
import ..bundled
import std.text as strings
import std.bytes as bytes
import ...stdlib.bytes.utf8 as utf8
import sys

pub struct Lexing { jobs: i32, scan: fn(&mut Loader, i32, i32, i32) }
pub fn serial_lexing() -> Lexing { Lexing { jobs: 1, scan: scan_wave_serial } }

pub struct DepGraph {
    pkg_dirs: []string, pkg_entries: []string, pkg_caps: []i32, pkg_labels: []string,
    edge_owners: []i32, edge_names: []string, edge_targets: []i32,
}
pub fn empty_deps() -> DepGraph {
    DepGraph {
        pkg_dirs: [""], pkg_entries: [""], pkg_caps: [31], pkg_labels: [""],
        edge_owners: [], edge_names: [], edge_targets: [],
    }
}

pub struct Location { path: string, source: string, offset: i32 }
pub struct Loaded {
    token_offsets: bool,
    groups: []string, calls: []string,
    ok: bool, error: string, path: string, source: string, offset: i32,
    paths: []string, sources: []string, symbols: []string, module_caps: []i32, diagnostics: []diag.Diagnostic,
    map_starts: []i32, map_files: []i32, map_offsets: []i32, json_symbols: []string,
    embed_blobs: []u8, embed_blob_starts: []i32, embed_blob_counts: []i32, embed_blob_digests: []string, embed_paths: []string,
}
pub opaque struct Loader {
    result: Loaded, key_prefixes: []string, standard: []string, directories: []string, first: []i32, last: []i32,
    raw: lexer.Tokens, last_arm: []i32, namespace_initials: []i64,
    hidden_starts: []i32, hidden_ends: []i32, declaration_tokens: []i32, any_unsafe: bool, requires_caps: []i32, has_cap_header: []bool,
    symbols: Map<string, i64>, imports: Map<string, i64>, sym_imports: Map<string, i64>, by_path: Map<string, i64>, by_physical: Map<string, i64>, by_std: Map<string, i64>, owners: []i32,
    sym_import_owner: []i32, sym_import_alias: []string, sym_import_module: []i32, sym_import_member: []string, sym_import_offset: []i32, sym_import_symbol: []i32, sym_import_prelude: []string,
    public: []bool, records: []bool, types: []bool, traits: []bool, renamed: []string,
    testing: bool, test_tags: []i32, test_targets: []i32, test_ends: []i32, next_test: i32,
    deps: DepGraph,
    module_cap_limit: []i32, module_pkg: []string, module_pkg_id: []i32,
    error_count: i32,
    tracked_import_owners: []i32, tracked_import_aliases: []string, tracked_import_starts: []i32, tracked_import_lasts: []i32, tracked_import_used: []bool,
    tracked_import_targets: []i32,
    tracked_import_index: Map<string, i64>,
    module_has_tests: []bool,
    test_hidden_owners: []i32, test_hidden_starts: []i32, test_hidden_ends: []i32,
    overlay_paths: []string, overlay_sources: []string,
}
fn key(loader: &Loader, owner: i32, name: string) -> string { loader.key_prefixes[owner] + name }
fn initial_bit(name: string) -> i64 { i64(1).shl(i32(name[0]).bit_and(63)) }
fn find_substr(haystack: string, needle: string) -> i32 {
    if needle.len == 0 { return 0 }
    if needle.len > haystack.len { return -1 }
    limit := haystack.len - needle.len + 1
    for i in 0..limit {
        mut ok := true
        for j in 0..needle.len {
            if haystack[i + j] != needle[j] { ok = false; break }
        }
        if ok { return i }
    }
    -1
}
fn string_literal(value: string) -> string {
    mut output: []u8 = [34]
    digits := "0123456789abcdef"
    for i in 0..value.len {
        byte := i32(value[i])
        if byte == 34 || byte == 92 { output.push(92); output.push(u8(byte)) }
        else if byte < 32 || byte == 127 {
            bytes.append_utf8(&mut output, "\\x")
            output.push(u8(digits[byte / 16])); output.push(u8(digits[byte % 16]))
        } else { output.push(u8(byte)) }
    }
    output.push(34)
    match utf8.decode(&output) { .Ok(value) => value, .Err(_) => "" }
}
pub fn normalize(path: string) -> string { paths.normalize(path) }
fn find_overlay(loader: &Loader, candidate: string) -> i32 {
    if loader.overlay_paths.len == 0 || candidate == "" { return -1 }
    norm := normalize(candidate)
    for i in 0..loader.overlay_paths.len {
        if loader.overlay_paths[i] == norm || loader.overlay_paths[i] == candidate || sys.same_file(loader.overlay_paths[i], candidate) {
            return i
        }
    }
    -1
}
fn push_diagnostic(loader: &mut Loader, severity: diag.Severity, code: string, path: string, start: i32, end: i32, message: string) {
    for idx in 0..loader.result.diagnostics.len {
        existing := &loader.result.diagnostics[idx]
        if existing.severity == severity && existing.path == path && existing.start == start && existing.message == message {
            return
        }
    }
    loader.result.diagnostics.push(diag.Diagnostic {
        severity: severity,
        code: code.clone(),
        path: path.clone(),
        start: start,
        end: end,
        message: message.clone(),
        note_path: "",
        note_start: -1,
        note_end: -1,
        note_message: "",
    })
}
fn fail_span(loader: &mut Loader, owner: i32, start_in: i32, last_in: i32, message: string) {
    if loader.result.ok {
        loader.result.ok = false; loader.result.error = message.clone()
        loader.result.path = loader.result.paths[owner].clone()
        loader.result.source = loader.result.sources[owner].clone()
        loader.result.offset = start_in
    }
    if loader.error_count >= 32 { return }
    sp := diag.resolve_span(loader.result.sources[owner], start_in, last_in)
    code := diag.classify_error_code(message)
    path := loader.result.paths[owner].clone()
    before := loader.result.diagnostics.len
    push_diagnostic(&mut loader, .Error, code, path, sp.start, sp.end, message.clone())
    if loader.result.diagnostics.len > before { loader.error_count += 1 }
}
fn fail(loader: &mut Loader, owner: i32, offset: i32, message: string) {
    fail_span(&mut loader, owner, offset, -1, message)
}
fn track_import(loader: &mut Loader, owner: i32, alias: string, start_off: i32, last_off: i32, target_mod: i32) {
    if loader.standard[owner] != "" { return }
    entry := key(&loader, owner, alias)
    if loader.tracked_import_index.contains(entry) { return }
    idx := loader.tracked_import_owners.len
    loader.tracked_import_owners.push(owner)
    loader.tracked_import_aliases.push(alias.clone())
    loader.tracked_import_starts.push(start_off)
    loader.tracked_import_lasts.push(last_off)
    loader.tracked_import_used.push(false)
    loader.tracked_import_targets.push(target_mod)
    loader.tracked_import_index.put(move entry, i64(idx))
}
fn mark_import_used(loader: &mut Loader, owner: i32, alias: string) {
    entry := key(&loader, owner, alias)
    idx := i32(loader.tracked_import_index.get_or(entry, -1))
    if idx >= 0 && idx < loader.tracked_import_used.len {
        loader.tracked_import_used[idx] = true
    }
}
fn emit_unused_import_warnings(loader: &mut Loader) {
    if loader.tracked_import_owners.len == 0 { return }
    mut has_tests: []bool = []
    if loader.testing {
        has_tests = loader.module_has_tests.clone()
        mut changed := true
        while changed {
            changed = false
            for idx in 0..loader.tracked_import_owners.len {
                owner := loader.tracked_import_owners[idx]
                target := loader.tracked_import_targets[idx]
                if owner >= 0 && owner < has_tests.len && target >= 0 && target < has_tests.len && has_tests[target] && !has_tests[owner] {
                    has_tests[owner] = true
                    changed = true
                }
            }
        }
    }
    for h in 0..loader.test_hidden_owners.len {
        owner := loader.test_hidden_owners[h]
        mut has_unused := false
        for idx in 0..loader.tracked_import_owners.len {
            if loader.tracked_import_owners[idx] == owner && !loader.tracked_import_used[idx] {
                has_unused = true; break
            }
        }
        if !has_unused { continue }
        start_tok := loader.test_hidden_starts[h]
        end_tok := loader.test_hidden_ends[h]
        for t in start_tok..end_tok {
            if loader.raw.kinds[t] != .Name { continue }
            if t > start_tok && is(&loader, t - 1, ".") { continue }
            used_name := loader.raw.texts[t].clone()
            mark_import_used(&mut loader, owner, used_name)
        }
    }
    for idx in 0..loader.tracked_import_owners.len {
        if loader.tracked_import_used[idx] { continue }
        target := loader.tracked_import_targets[idx]
        if loader.testing && target >= 0 && target < has_tests.len && has_tests[target] { continue }
        owner := loader.tracked_import_owners[idx]
        if owner < 0 || owner >= loader.result.paths.len { continue }
        if loader.standard[owner] != "" { continue }
        if loader.result.paths[owner].len == 0 || loader.result.paths[owner][0] == 60 { continue }
        if loader.tracked_import_aliases[idx].len == 0 || loader.tracked_import_aliases[idx][0] == 95 { continue }
        path := loader.result.paths[owner].clone()
        alias := loader.tracked_import_aliases[idx].clone()
        sp := diag.resolve_span(loader.result.sources[owner], loader.tracked_import_starts[idx], loader.tracked_import_lasts[idx])
        push_diagnostic(&mut loader, .Warning, "W1002", path, sp.start, sp.end, "unused import '" + alias + "'")
    }
}
fn is(loader: &Loader, at: i32, value: string) -> bool {
    if at < 0 || at >= loader.raw.texts.len { return false }
    kind := loader.raw.kinds[at]
    if kind != .Name && kind != .Keyword && kind != .Symbol { return false }
    loader.raw.texts[at] == value
}
pub fn capability_bit(name: string) -> i32 {
    if name == "filesystem" { return 1 }
    if name == "network" { return 2 }
    if name == "process" { return 4 }
    if name == "stdio" { return 8 }
    if name == "unsafe" { return 16 }
    0
}
fn lower_ascii(text: string) -> string {
    mut has_upper := false
    for i in 0..text.len {
        b := text[i]
        if b >= 65 && b <= 90 { has_upper = true; break }
    }
    if !has_upper { return text.clone() }
    mut out: []u8 = []
    out.reserve(text.len)
    for i in 0..text.len {
        mut b := text[i]
        if b >= 65 && b <= 90 { b = b + 32 }
        out.push(u8(b))
    }
    match utf8.decode(&out) { .Ok(value) => value, .Err(_) => "" }
}
pub fn capability_suggestion(name: string) -> string {
    lower := lower_ascii(name)
    if capability_bit(lower) != 0 { return lower }
    if lower == "io" || lower == "stdin" || lower == "stdout" || lower == "stderr" || lower == "console" || lower == "std_io" { return "stdio" }
    if lower == "fs" || lower == "file" || lower == "files" || lower == "disk" || lower == "path" || lower == "std_fs" { return "filesystem" }
    if lower == "net" || lower == "socket" || lower == "sockets" || lower == "tcp" || lower == "udp" || lower == "http" || lower == "std_net" { return "network" }
    if lower == "proc" || lower == "exec" || lower == "cmd" || lower == "command" || lower == "env" || lower == "shell" || lower == "std_process" { return "process" }
    if lower == "ffi" || lower == "ptr" || lower == "raw" || lower == "memory" || lower == "dl" || lower == "extern" { return "unsafe" }
    ""
}
pub fn invalid_module_capability_message(kind: lexer.Kind, text: string) -> string {
    if kind != .Name {
        return "expected a module capability name (valid capabilities: unsafe, filesystem, network, process, stdio)"
    }
    hint := capability_suggestion(text)
    if hint != "" {
        return "unknown module capability '" + text + "'; did you mean '" + hint + "'? (valid capabilities: unsafe, filesystem, network, process, stdio)"
    }
    "unknown module capability '" + text + "' (valid capabilities: unsafe, filesystem, network, process, stdio)"
}
pub fn duplicate_module_capability_message(name: string) -> string {
    "duplicate module capability '" + name + "'"
}
pub fn end_of_capability_message(kind: lexer.Kind) -> string {
    if kind == .Name {
        return "expected ',' or newline after module capability; separate multiple capabilities with commas (e.g. 'capability filesystem, stdio')"
    }
    "expected end of capability declaration; separate multiple capabilities with commas"
}
pub fn misplaced_capability_message(already_declared: bool) -> string {
    if already_declared {
        return "declare capabilities once at the beginning of the module; combine multiple capabilities with commas (e.g. 'capability filesystem, stdio')"
    }
    "declare capabilities at the beginning of the module, before imports and declarations (e.g. 'capability stdio')"
}
fn append_cap(out: string, name: string) -> string {
    if out == "" { return name.clone() }
    out + ", " + name
}
pub fn missing_capability_names(mask: i32) -> string {
    mut out := ""
    if mask.bit_and(1) != 0 { out = append_cap(out, "filesystem") }
    if mask.bit_and(2) != 0 { out = append_cap(out, "network") }
    if mask.bit_and(4) != 0 { out = append_cap(out, "process") }
    if mask.bit_and(8) != 0 { out = append_cap(out, "stdio") }
    out
}
pub fn missing_capability_message(missing_mask: i32, has_any_cap: bool) -> string {
    caps := missing_capability_names(missing_mask)
    if has_any_cap {
        return "this function requires capability " + caps + "; add '" + caps + "' to the 'capability' declaration at the top of this module"
    }
    "this function requires capability " + caps + "; add 'capability " + caps + "' at the top of this module"
}
pub fn missing_unsafe_message(has_other_caps: bool) -> string {
    if has_other_caps {
        return "module requires capability unsafe; add 'unsafe' to the 'capability' declaration at the top of this module"
    }
    "module requires capability unsafe; add 'capability unsafe' at the top of this module"
}
pub fn invalid_requires_message(kind: lexer.Kind, text: string, mask: i32) -> string {
    if kind == .Name && text == "unsafe" {
        return "@requires does not accept 'unsafe'; mark the function 'unsafe fn' instead (valid @requires capabilities: filesystem, network, process, stdio)"
    }
    if kind == .Name {
        bit := capability_bit(text)
        if bit != 0 && bit != 16 && mask.bit_and(bit) != 0 {
            return "duplicate @requires capability '" + text + "'"
        }
        hint := capability_suggestion(text)
        if hint != "" && hint != "unsafe" {
            return "unknown @requires capability '" + text + "'; did you mean '" + hint + "'? (expected filesystem, network, process or stdio)"
        }
        return "unknown @requires capability '" + text + "' (expected @requires(filesystem), @requires(network), @requires(process) or @requires(stdio))"
    }
    "expected @requires(filesystem), @requires(network), @requires(process) or @requires(stdio)"
}
fn check_caps_span(loader: &mut Loader, owner: i32, start_tok: i32, last_tok: i32, found: i32) -> bool {
    missing := loader.requires_caps[found].bit_and(loader.result.module_caps[owner].bit_xor(15))
    if missing == 0 { return true }
    has_header := owner >= 0 && owner < loader.has_cap_header.len && loader.has_cap_header[owner]
    last_off := if last_tok >= start_tok { loader.raw.starts[last_tok] } else { -1 }
    fail_span(&mut loader, owner, loader.raw.starts[start_tok], last_off, missing_capability_message(missing, has_header))
    false
}
fn add(loader: &mut Loader, path: string, standard: string, origin: i32, offset: i32) -> i32 {
    add_with_dep(&mut loader, path, standard, origin, offset, -1)
}
fn add_with_dep(loader: &mut Loader, path: string, standard: string, origin: i32, offset: i32, dep_idx: i32) -> i32 {
    mut cap_limit := 31
    mut pkg_name := ""
    mut pkg_id := -1
    if standard == "" {
        pkg_id = 0
        if dep_idx >= 0 && dep_idx < loader.deps.pkg_caps.len {
            cap_limit = loader.deps.pkg_caps[dep_idx]
            pkg_name = loader.deps.pkg_labels[dep_idx].clone()
            pkg_id = dep_idx
        } else if origin >= 0 && origin < loader.module_cap_limit.len {
            cap_limit = loader.module_cap_limit[origin]
            pkg_name = loader.module_pkg[origin].clone()
            pkg_id = loader.module_pkg_id[origin]
        }
    }
    if standard != "" {
        existing := loader.by_std.get_or(standard, -1)
        if existing >= 0 { return i32(existing) }
    }
    mut actual := normalize(path)
    mut directory := paths.parent(actual)
    mut physical := ""
    if standard == "" {
        early := loader.by_path.get_or(actual, -1)
        if early >= 0 { return i32(early) }
        if actual != path {
            raw_hit := loader.by_path.get_or(path, -1)
            if raw_hit >= 0 {
                loader.by_path.put(move actual, raw_hit)
                return i32(raw_hit)
            }
        }
        physical = cache_io.root(path)
        if physical != "" {
            phys_hit := loader.by_physical.get_or(physical, -1)
            if phys_hit >= 0 {
                loader.by_path.put(move actual, phys_hit)
                return i32(phys_hit)
            }
            if !sys.same_file(actual, physical) { actual = physical.clone() }
            if !sys.same_file(directory, paths.parent(physical)) { directory = paths.parent(physical) }
            cached := loader.by_path.get_or(actual, -1)
            if cached >= 0 {
                loader.by_physical.put(move physical, cached)
                return i32(cached)
            }
        } else {
            actual = path.clone()
            for i in 0..loader.result.paths.len {
                if loader.standard[i] == "" && (loader.result.paths[i] == actual || sys.same_file(loader.result.paths[i], actual)) {
                    loader.by_path.put(move actual, i64(i))
                    return i
                }
            }
        }
    }
    mut source := ""
    if standard != "" { source = bundled.source(standard) }
    else {
        mut ov := find_overlay(&loader, actual)
        if ov < 0 && actual != path { ov = find_overlay(&loader, path) }
        if ov >= 0 {
            source = loader.overlay_sources[ov].clone()
        } else {
            read := sys.read_text(actual)
            if !read.ok {
                if origin >= 0 { fail(&mut loader, origin, offset, "cannot load module " + actual + ": " + sys.error_message(read.error)) }
                else {
                    msg := "cannot load module: " + sys.error_message(read.error)
                    loader.result.ok = false; loader.result.path = actual.clone(); loader.result.error = msg.clone()
                    push_diagnostic(&mut loader, .Error, "E2001", actual, 0, 0, msg)
                    loader.error_count += 1
                }
                return -1
            }
            source = read.value
        }
    }
    id := loader.result.paths.len
    loader.result.paths.push(actual.clone()); loader.result.sources.push(move source)
    loader.key_prefixes.push(id.str() + ":"); loader.namespace_initials.push(0)
    loader.directories.push(move directory); loader.standard.push(standard.clone()); loader.first.push(0); loader.last.push(0)
    loader.module_cap_limit.push(cap_limit); loader.module_pkg.push(move pkg_name); loader.module_pkg_id.push(pkg_id); loader.module_has_tests.push(false)
    if standard != "" { loader.by_std.put(standard.clone(), i64(id)) }
    else {
        loader.by_path.put(move actual, i64(id))
        if physical != "" { loader.by_physical.put(move physical, i64(id)) }
    }
    id
}
fn skip_lines(loader: &Loader, at: i32) -> i32 {
    mut i := at
    while i < loader.raw.texts.len && lexer.is_newline(loader.raw.kinds[i]) { i = i + 1 }
    i
}
fn skip_lines_in(loader: &Loader, at: i32, last: i32) -> i32 {
    mut i := at
    while i < last && lexer.is_newline(loader.raw.kinds[i]) { i += 1 }
    i
}
fn resolve_embed_path(loader: &mut Loader, owner: i32, at: i32, rel: string, form: string) -> string {
    if loader.standard[owner] != "" {
        fail(&mut loader, owner, at, "@" + form + " is not allowed in bundled stdlib modules")
        return ""
    }
    pid := if owner >= 0 && owner < loader.module_pkg_id.len { loader.module_pkg_id[owner] } else { -1 }
    mut pkg_root := ""
    if pid >= 0 && pid < loader.deps.pkg_dirs.len && loader.deps.pkg_dirs[pid] != "" {
        pkg_root = loader.deps.pkg_dirs[pid].clone()
    } else if loader.directories.len > 0 && loader.directories[0] != "" {
        pkg_root = loader.directories[0].clone()
    } else {
        fail(&mut loader, owner, at, "@" + form + " requires a package directory")
        return ""
    }
    if rel.len == 0 {
        fail(&mut loader, owner, at, "embed path must not be empty")
        return ""
    }
    if rel[0] == 47 || (rel.len >= 2 && rel[1] == 58) {
        fail(&mut loader, owner, at, "embed path must be relative to the package root")
        return ""
    }
    for i in 0..rel.len {
        if rel[i] == 0 || rel[i] == 92 {
            fail(&mut loader, owner, at, "embed path must be relative to the package root")
            return ""
        }
    }
    norm := paths.normalize(rel)
    if norm == "." || norm == ".." || strings.starts_with(norm, "../") {
        fail(&mut loader, owner, at, "embed path must stay within the package root")
        return ""
    }
    full := if pkg_root == "." { norm.clone() } else if pkg_root == "/" { "/" + norm } else { pkg_root + "/" + norm }
    meta := sys.metadata(full)
    if !meta.ok {
        fail(&mut loader, owner, at, "cannot embed '" + rel + "': file not found")
        return ""
    }
    if !meta.is_file {
        fail(&mut loader, owner, at, "cannot embed '" + rel + "': path is not a regular file")
        return ""
    }
    if meta.size > 67108864 {
        fail(&mut loader, owner, at, "cannot embed '" + rel + "': file exceeds 64 MiB limit")
        return ""
    }
    canon_root := cache_io.root(pkg_root)
    canon_file := cache_io.root(full)
    if canon_root == "" || canon_file == "" || !((canon_root == "/" && strings.starts_with(canon_file, "/")) || strings.starts_with(canon_file, canon_root + "/")) {
        fail(&mut loader, owner, at, "embed path '" + rel + "' escapes the package root")
        return ""
    }
    full
}
fn add_embed_blob(loader: &mut Loader, data: &[]u8, digest: string) -> i32 {
    for i in 0..loader.result.embed_blob_digests.len {
        if loader.result.embed_blob_digests[i] == digest { return i }
    }
    id := loader.result.embed_blob_starts.len
    first := loader.result.embed_blobs.len
    bytes.extend(&mut loader.result.embed_blobs, &data)
    loader.result.embed_blob_starts.push(first)
    loader.result.embed_blob_counts.push(data.len)
    loader.result.embed_blob_digests.push(digest.clone())
    id
}
fn record_embed_path(loader: &mut Loader, full: string) {
    for p in &loader.result.embed_paths {
        if p == full { return }
    }
    loader.result.embed_paths.push(full.clone())
}
fn raw_string_spelling_needed(source: string, first: i32) -> bool {
    if first < 0 || first >= source.len { return false }
    b := source[first]
    if b == 114 { return true }
    b == 34 && first + 2 < source.len && source[first + 1] == 34 && source[first + 2] == 34
}
fn close_block(loader: &Loader, at: i32) -> i32 {
    mut i := at
    mut depth := 0
    while i < loader.raw.texts.len {
        if is(&loader, i, "{") { depth = depth + 1 }
        if is(&loader, i, "}") { depth = depth - 1; if depth == 0 { return i + 1 } }
        i = i + 1
    }
    -1
}
fn hide(loader: &mut Loader, first: i32, last: i32) {
    loader.hidden_starts.push(first); loader.hidden_ends.push(last)
}
fn lower_bound(tokens: &[]i32, token: i32) -> i32 {
    mut lo := 0; mut hi := tokens.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if tokens[mid] < token { lo = mid + 1 } else { hi = mid }
    }
    lo
}
fn name_byte(b: i32) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128
}
fn valid_alias(alias: string) -> bool {
    if alias == "" || strings.starts_with(alias, "__") || !name_byte(i32(alias[0])) { return false }
    for idx in 0..alias.len { b := i32(alias[idx]); if !name_byte(b) && (b < 48 || b > 57) { return false } }
    n := alias.len
    if n == 2 { return alias != "fn" && alias != "if" && alias != "in" && alias != "as" && alias != "u8" }
    if n == 3 {
        return alias != "pub" && alias != "mut" && alias != "for" && alias != "i32" &&
            alias != "i16" && alias != "i64" && alias != "len" && alias != "f32" && alias != "f64" && alias != "u16" &&
            alias != "u32" && alias != "u64" && alias != "ptr"
    }
    if n == 4 { return alias != "else" && alias != "enum" && alias != "true" && alias != "move" && alias != "impl" && alias != "self" && alias != "Self" && alias != "bool" && alias != "rune" && alias != "Copy" }
    if n == 5 {
        return alias != "while" && alias != "break" && alias != "match" && alias != "false" &&
            alias != "const" && alias != "print" && alias != "range" && alias != "usize" && alias != "trait" && alias != "Clone"
    }
    if n == 6 {
        return alias != "return" && alias != "struct" && alias != "import" && alias != "assert" &&
            alias != "string" && alias != "unsafe" && alias != "extern" && alias != "TaskID"
    }
    if n == 8 { return alias != "continue" && alias != "Sendable" && alias != "Storable" && alias != "Iterator" }
    if n == 10 { return alias != "capability" }
    true
}
fn bare_path(raw: string) -> string {
    if raw == "" || strings.ends_with(raw, ".ddr") { return "" }
    for b in raw.bytes() {
        if !name_byte(i32(b)) && (b < 48 || b > 57) && b != 45 && b != 46 && b != 47 { return "" }
    }
    if find_substr(raw, "/") >= 0 {
        if raw[0] == 47 || raw[raw.len-1] == 47 || find_substr(raw, "//") >= 0 || strings.ends_with(raw, "/.") || strings.ends_with(raw, "/..") { return "" }
        return raw.clone()
    }
    mut dots := 0
    while dots < raw.len && raw[dots] == 46 { dots = dots + 1 }
    if dots == raw.len { return "" }
    mut result := ""
    if dots == 1 { result = "./" }
    for _ in 1..dots { result = result + "../" }
    for component in strings.split(raw[dots..raw.len], ".") {
        if component == "" { return "" }
        if result != "" && result[result.len-1] != 47 { result = result + "/" }
        result = result + component
    }
    result
}
struct ResolvedImport { target: string, dep: i32 }
fn dep_target(deps: &DepGraph, owner_pkg: i32, path: string) -> ResolvedImport {
    if owner_pkg < 0 { return ResolvedImport { target: "", dep: -1 } }
    slash := find_substr(path, "/")
    mut head := path.clone()
    mut rest := ""
    if slash >= 0 {
        head = path[0..slash]
        rest = path[slash + 1..path.len]
    }
    for e in 0..deps.edge_owners.len {
        if deps.edge_owners[e] == owner_pkg && deps.edge_names[e] == head {
            pkg := deps.edge_targets[e]
            dir := deps.pkg_dirs[pkg].clone()
            mut target := ""
            if rest != "" {
                if dir == "." { target = rest + ".ddr" }
                else if dir == "/" { target = "/" + rest + ".ddr" }
                else { target = dir + "/" + rest + ".ddr" }
            } else if deps.pkg_entries[pkg] != "" {
                target = deps.pkg_entries[pkg].clone()
            } else if dir == "." {
                target = head + ".ddr"
            } else if dir == "/" {
                target = "/" + head + ".ddr"
            } else {
                target = dir + "/" + head + ".ddr"
            }
            return ResolvedImport { target: move target, dep: pkg }
        }
    }
    ResolvedImport { target: "", dep: -1 }
}
fn resolve_local_or_dep_info(loader: &Loader, owner: i32, path: string, quoted: bool, bare_raw: string) -> ResolvedImport {
    local_target := loader.directories[owner] + "/" + path + ".ddr"
    if sys.metadata(local_target).is_file { return ResolvedImport { target: move local_target, dep: -1 } }
    if quoted || loader.deps.edge_owners.len == 0 || bare_raw == "" || bare_raw[0] == 46 || find_substr(bare_raw, "/") >= 0 {
        return ResolvedImport { target: move local_target, dep: -1 }
    }
    owner_pkg := if owner >= 0 && owner < loader.module_pkg_id.len { loader.module_pkg_id[owner] } else { -1 }
    resolved := dep_target(&loader.deps, owner_pkg, path)
    if resolved.target != "" { return resolved }
    ResolvedImport { target: move local_target, dep: -1 }
}
fn register_sym_import(loader: &mut Loader, owner: i32, alias: string, mod_id: i32, member: string, offset: i32) {
    entry := key(&loader, owner, alias)
    idx := loader.sym_import_owner.len
    loader.sym_imports.put(move entry, i64(idx))
    loader.sym_import_owner.push(owner); loader.sym_import_alias.push(alias.clone())
    loader.sym_import_module.push(mod_id); loader.sym_import_member.push(member.clone())
    loader.sym_import_offset.push(offset); loader.sym_import_symbol.push(-1); loader.sym_import_prelude.push("")
    loader.namespace_initials[owner] = loader.namespace_initials[owner].bit_or(initial_bit(alias))
}
fn resolve_symbol_imports(loader: &mut Loader) {
    for si in 0..loader.sym_import_owner.len {
        owner := loader.sym_import_owner[si]
        alias := loader.sym_import_alias[si].clone()
        mod_id := loader.sym_import_module[si]
        member := loader.sym_import_member[si].clone()
        off := loader.sym_import_offset[si]
        entry := key(&loader, owner, alias)
        if loader.symbols.contains(entry) || loader.imports.contains(entry) {
            fail(&mut loader, owner, off, "duplicate import alias '" + alias + "'"); continue
        }
        if mod_id == -2 {
            loader.sym_import_prelude[si] = bundled.prelude_export("", member)
            continue
        }
        found := i32(loader.symbols.get_or(key(&loader, mod_id, member), -1))
        if loader.standard[mod_id] != "" {
            pre := bundled.prelude_export(loader.standard[mod_id], member)
            if pre != "" && (found < 0 || bundled.prelude_generic(member)) {
                loader.sym_import_prelude[si] = pre
                continue
            }
        }
        if found < 0 {
            fail(&mut loader, owner, off, "module has no declaration '" + member + "'"); continue
        }
        if !loader.public[found] {
            fail(&mut loader, owner, off, "'" + member + "' is private; export it with pub"); continue
        }
        loader.sym_import_symbol[si] = found
    }
}
fn trim_last_component(raw: string) -> string {
    mut split := -1
    for j in 0..raw.len {
        if raw[j] == 46 || raw[j] == 47 { split = j }
    }
    if split <= 0 { return "" }
    raw[0..split]
}
fn import_module(loader: &mut Loader, owner: i32, at: i32) -> i32 {
    mut i := at + 1
    mut path := ""
    mut alias := ""
    mut quoted := false
    mut bare_raw := ""
    if i < loader.raw.texts.len && loader.raw.kinds[i] == .String {
        path = loader.raw.texts[i].clone(); i = i + 1; quoted = true
    } else {
        source := loader.result.sources[owner].clone()
        first := loader.raw.starts[i]
        mut end := first
        while end < source.len && source[end] > 32 && source[end] != 59 { end = end + 1 }
        bare_raw = source[first..end]
        path = bare_path(bare_raw)
        if path == "" { fail(&mut loader, owner, first, "invalid module path; use a relative name without a file suffix"); return i }
        while i < loader.raw.texts.len && loader.raw.starts[i] < end { i = i + 1 }
    }
    mut component := 0
    for n in 0..path.len { if path[n] == 47 { component = n + 1 } }
    alias = path[component..path.len]
    if alias == "" || alias == "." || alias == ".." || find_substr(alias, ".") > 0 {
        fail(&mut loader, owner, loader.raw.starts[at], "import a module name without a file suffix"); return i
    }
    if is(&loader, i, "as") {
        i = i + 1
        if i >= loader.raw.texts.len || loader.raw.kinds[i] != .Name { fail(&mut loader, owner, loader.raw.starts[at], "expected an import alias"); return i }
        alias = loader.raw.texts[i].clone(); i = i + 1
    }
    if i < loader.raw.texts.len && !lexer.is_newline(loader.raw.kinds[i]) && loader.raw.kinds[i] != .End && !is(&loader, i, ";") {
        fail(&mut loader, owner, loader.raw.starts[i], "expected end of import"); return i
    }
    mut last_tok := i - 1
    if last_tok < at { last_tok = at }
    if is(&loader, i, ";") { i = i + 1 }
    import_start_off := loader.raw.starts[at]
    import_last_off := loader.raw.starts[last_tok]
    if path == "" || path[0] == 47 || !valid_alias(alias) {
        fail_span(&mut loader, owner, import_start_off, import_last_off, "import a relative module name with a non-reserved alias"); return i
    }
    entry := key(&loader, owner, alias)
    if loader.imports.contains(entry) || loader.sym_imports.contains(entry) || loader.symbols.contains(entry) {
        fail_span(&mut loader, owner, import_start_off, import_last_off, "duplicate import alias '" + alias + "'"); return i
    }
    mut standard := ""
    mut target := ""
    mut library := ""
    if path == "sys" { library = "sys" }
    if strings.starts_with(path, "std/") { library = path[4..path.len] }
    mut matched_dep := -1
    if library != "" && bundled.contains(library.clone()) {
        target = "<stdlib/" + library + ".ddr>"; standard = library
    } else if !quoted && component > 0 && path[0..component - 1] == "std" && bundled.prelude_export("", path[component..path.len]) != "" {
        register_sym_import(&mut loader, owner, alias, -2, path[component..path.len], import_start_off)
        track_import(&mut loader, owner, alias, import_start_off, import_last_off, -1)
        hide(&mut loader, at, i)
        return i
    } else {
        mut local_candidate := ""
        if loader.standard[owner] == "" {
            resolved := resolve_local_or_dep_info(&loader, owner, path.clone(), quoted, bare_raw.clone())
            local_candidate = resolved.target
            if local_candidate != "" && sys.metadata(local_candidate).is_file {
                target = local_candidate.clone()
                matched_dep = resolved.dep
            }
        }
        if target == "" && !quoted && component > 0 {
            member := path[component..path.len]
            if member.len > 0 && member[0] >= 65 && member[0] <= 90 {
                parent_path := path[0..component - 1]
                mut parent_std := ""
                if parent_path == "sys" { parent_std = "sys" }
                else if strings.starts_with(parent_path, "std/") { parent_std = parent_path[4..parent_path.len] }
                if parent_std != "" && bundled.contains(parent_std.clone()) {
                    mod_id := add(&mut loader, "<stdlib/" + parent_std + ".ddr>", parent_std, owner, import_start_off)
                    if mod_id >= 0 {
                        register_sym_import(&mut loader, owner, alias, mod_id, member, import_start_off)
                        track_import(&mut loader, owner, alias, import_start_off, import_last_off, -1)
                    }
                    hide(&mut loader, at, i)
                    return i
                }
                if loader.standard[owner] == "" {
                    parent_bare := trim_last_component(bare_raw)
                    parent_resolved := resolve_local_or_dep_info(&loader, owner, parent_path, false, parent_bare)
                    if sys.metadata(parent_resolved.target).is_file {
                        mod_id := add_with_dep(&mut loader, parent_resolved.target, "", owner, import_start_off, parent_resolved.dep)
                        if mod_id >= 0 {
                            register_sym_import(&mut loader, owner, alias, mod_id, member, import_start_off)
                            track_import(&mut loader, owner, alias, import_start_off, import_last_off, -1)
                        }
                        hide(&mut loader, at, i)
                        return i
                    }
                }
            }
        }
        if target == "" {
            if loader.standard[owner] != "" { fail_span(&mut loader, owner, import_start_off, import_last_off, "bundled libraries may only import bundled modules"); return i }
            if !quoted && strings.starts_with(path, "std/") {
                if component > 4 {
                    parent_path := path[0..component - 1]
                    parent_std := parent_path[4..parent_path.len]
                    if bundled.contains(parent_std) {
                        fail_span(&mut loader, owner, import_start_off, import_last_off, "cannot import '" + bare_raw + "' directly; import '" + trim_last_component(bare_raw) + "' and access its functions via the module alias"); return i
                    }
                }
                fail_span(&mut loader, owner, import_start_off, import_last_off, "unknown standard library module '" + bare_raw + "' (not bundled in this compiler, and no local file " + local_candidate + ")"); return i
            }
            target = move local_candidate
        }
    }
    id := add_with_dep(&mut loader, target, standard, owner, import_start_off, matched_dep)
    if id >= 0 {
        track_import(&mut loader, owner, alias, import_start_off, import_last_off, id)
        loader.imports.put(move entry, i64(id))
        loader.namespace_initials[owner] = loader.namespace_initials[owner].bit_or(initial_bit(alias))
    }
    hide(&mut loader, at, i)
    i
}
fn scan_requires(loader: &mut Loader, owner: i32, i: i32, last: i32, caps_out: &mut i32) -> i32 {
    if !is(&loader, i + 2, "(") {
        at := if i + 2 < last { i + 2 } else { i }
        fail(&mut loader, owner, loader.raw.starts[at], "expected @requires(filesystem), @requires(network), @requires(process) or @requires(stdio)"); return -1
    }
    mut j := i + 3
    mut cap_mask := 0
    while j < last {
        kind := loader.raw.kinds[j]
        word := loader.raw.texts[j].clone()
        bit := if kind == .Name { capability_bit(word) } else { 0 }
        if bit != 0 && bit != 16 && cap_mask.bit_and(bit) == 0 {
            cap_mask = cap_mask.bit_or(bit)
        } else {
            fail(&mut loader, owner, loader.raw.starts[j], invalid_requires_message(kind, word, cap_mask)); return -1
        }
        j = j + 1
        if is(&loader, j, ")") { break }
        if !is(&loader, j, ",") {
            at := if j < last { j } else { j - 1 }
            fail(&mut loader, owner, loader.raw.starts[at], "expected ')' or ',' after @requires capability"); return -1
        }
        j = j + 1
    }
    if j >= last || !is(&loader, j, ")") || cap_mask == 0 {
        at := if j < last { j } else { i }
        fail(&mut loader, owner, loader.raw.starts[at], "expected @requires(filesystem), @requires(network), @requires(process) or @requires(stdio)"); return -1
    }
    mut function := skip_lines(&loader, j + 1)
    while function < last && is(&loader, function, "@") {
        function = function + 2
        if function < last && is(&loader, function, "(") {
            mut p := 1; function = function + 1
            while function < last && p > 0 {
                if is(&loader, function, "(") { p = p + 1 } else if is(&loader, function, ")") { p = p - 1 }
                function = function + 1
            }
        }
        function = skip_lines(&loader, function)
    }
    if is(&loader, function, "pub") { function = function + 1 }
    if is(&loader, function, "unsafe") { function = function + 1 }
    if !is(&loader, function, "fn") { fail(&mut loader, owner, loader.raw.starts[i], "@requires applies to a function"); return -1 }
    caps_out = caps_out.bit_or(cap_mask)
    j + 1
}

fn scan_declarations(loader: &mut Loader, owner: i32, first: i32) {
    if !loader.raw.ok { fail(&mut loader, owner, loader.raw.error_at, loader.raw.error.clone()); return }
    last := loader.raw.texts.len
    loader.first[owner] = first
    loader.last[owner] = last
    mut i := skip_lines(&loader, first)
    mut capable := false
    mut caps := 0
    mut has_header := false
    cap_limit := if owner >= 0 && owner < loader.module_cap_limit.len { loader.module_cap_limit[owner] } else { 31 }
    pkg_name := if owner >= 0 && owner < loader.module_pkg.len { loader.module_pkg[owner].clone() } else { "" }
    if is(&loader, i, "capability") {
        has_header = true
        start := i; i = i + 1
        if i >= last {
            fail(&mut loader, owner, loader.raw.starts[start], invalid_module_capability_message(.End, ""))
            return
        }
        while i < last {
            kind := loader.raw.kinds[i]
            word := loader.raw.texts[i].clone()
            bit := if kind == .Name { capability_bit(word) } else { 0 }
            if bit != 0 && pkg_name != "" && cap_limit.bit_and(bit) == 0 {
                fail(&mut loader, owner, loader.raw.starts[i], "dependency '" + pkg_name + "' requests capability '" + word + "', which is not granted in dunder.toml"); return
            }
            if bit == 16 {
                if capable { fail(&mut loader, owner, loader.raw.starts[i], duplicate_module_capability_message(word)); return }
                capable = true; loader.any_unsafe = true
            } else if bit != 0 {
                if caps.bit_and(bit) != 0 { fail(&mut loader, owner, loader.raw.starts[i], duplicate_module_capability_message(word)); return }
                caps = caps.bit_or(bit)
            } else {
                fail(&mut loader, owner, loader.raw.starts[i], invalid_module_capability_message(kind, word)); return
            }
            i = i + 1
            if !is(&loader, i, ",") { break }
            i = i + 1
            if i >= last {
                fail(&mut loader, owner, loader.raw.starts[i - 1], invalid_module_capability_message(.End, ""))
                return
            }
        }
        if i < last && !lexer.is_newline(loader.raw.kinds[i]) && loader.raw.kinds[i] != .End && !is(&loader,i,";") {
            fail(&mut loader, owner, loader.raw.starts[i], end_of_capability_message(loader.raw.kinds[i])); return
        }
        hide(&mut loader, start, i)
    }
    mut braces: []i32 = []
    mut last_arm := -1
    for token in i..last {
        kind := loader.raw.kinds[token]
        if kind == .Name {
            name := loader.raw.texts[token].clone()
            if !capable && name == "unsafe" { fail(&mut loader,owner,loader.raw.starts[token],missing_unsafe_message(has_header));return }
            if name == "capability" { fail(&mut loader,owner,loader.raw.starts[token],misplaced_capability_message(has_header));return }
        } else if kind == .Symbol {
            word := loader.raw.texts[token].clone()
            if word == "{" || word == "}" { braces.push(token) }
            else if word == "=>" { last_arm = token }
        }
    }
    loader.last_arm.push(last_arm)
    loader.result.module_caps.push(caps)
    loader.has_cap_header.push(has_header)
    mut brace := 0
    mut depth := 0
    mut public := false
    mut parens := 0
    mut requires_caps := 0
    mut in_impl := false
    mut impl_pub := false
    mut impl_unsafe := false
    mut impl_thread_safe := false
    mut top_thread_safe := false
    mut in_impl_sig := false
    mut impl_targets: []i32 = []
    mut scan_stack: []i32 = []
    while i < last && loader.result.ok {
        if depth > 1 || (depth > 0 && !in_impl) {
            while brace < braces.len && braces[brace] < i { brace = brace + 1 }
            if brace == braces.len { break }
            i = braces[brace]; brace = brace + 1
            if loader.raw.texts[i] == "{" { depth = depth + 1 } else { depth = depth - 1 }
            i = i + 1; continue
        }
        if depth == 1 && in_impl {
            if in_impl_sig {
                if is(&loader, i, "{") { depth = depth + 1; in_impl_sig = false; i = i + 1; continue }
                if is(&loader, i, "}") { fail(&mut loader, owner, loader.raw.starts[i], "expected method body '{'"); return }
                if is(&loader, i, "(") || is(&loader, i, "[") { parens = parens + 1 }
                if is(&loader, i, ")") || is(&loader, i, "]") { parens = parens - 1 }
                i = i + 1; continue
            }
            if lexer.is_newline(loader.raw.kinds[i]) || is(&loader, i, ";") { i = i + 1; continue }
            if is(&loader, i, "}") {
                if impl_pub || impl_unsafe || impl_thread_safe || requires_caps != 0 {
                    fail(&mut loader, owner, loader.raw.starts[i], "expected 'fn' after method modifier"); return
                }
                depth = depth - 1; in_impl = false; i = i + 1; continue
            }
            if is(&loader, i, "@") && is(&loader, i + 1, "requires") {
                next := scan_requires(&mut loader, owner, i, last, &mut requires_caps)
                if next < 0 { return }
                i = next; continue
            }
            if is(&loader, i, "@") && is(&loader, i + 1, "thread_safe") {
                if !capable { fail(&mut loader, owner, loader.raw.starts[i], missing_unsafe_message(has_header)); return }
                if impl_thread_safe { fail(&mut loader, owner, loader.raw.starts[i], "duplicate '@thread_safe'"); return }
                impl_thread_safe = true; i = i + 2; continue
            }
            if is(&loader, i, "@") && is(&loader, i + 1, "test") {
                fail(&mut loader, owner, loader.raw.starts[i], "@test is not allowed inside impl blocks"); return
            }
            if is(&loader, i, "pub") {
                if impl_pub { fail(&mut loader, owner, loader.raw.starts[i], "duplicate 'pub'"); return }
                impl_pub = true; i = i + 1; continue
            }
            if is(&loader, i, "unsafe") {
                if impl_unsafe { fail(&mut loader, owner, loader.raw.starts[i], "duplicate 'unsafe'"); return }
                impl_unsafe = true; i = i + 1; continue
            }
            if is(&loader, i, "fn") {
                name_at := i + 1
                if name_at >= last || loader.raw.kinds[name_at] != .Name { fail(&mut loader, owner, loader.raw.starts[i], "expected method name"); return }
                mname := loader.raw.texts[name_at].clone()
                if mname == "TaskID" || mname == "self" || mname == "Self" { fail(&mut loader, owner, loader.raw.starts[name_at], "reserved identifier '" + mname + "'"); return }
                impl_pub = false; impl_unsafe = false; impl_thread_safe = false; requires_caps = 0; in_impl_sig = true
                i = name_at + 1; continue
            }
            fail(&mut loader, owner, loader.raw.starts[i], "expected 'fn' inside impl block"); return
        }
        if depth == 0 && parens == 0 && is(&loader, i, "@") && is(&loader, i + 1, "thread_safe") {
            if !capable { fail(&mut loader, owner, loader.raw.starts[i], missing_unsafe_message(has_header)); return }
            if top_thread_safe { fail(&mut loader, owner, loader.raw.starts[i], "duplicate '@thread_safe'"); return }
            top_thread_safe = true; i = i + 2; continue
        }
        if depth == 0 && parens == 0 && top_thread_safe && is(&loader, i, "@") && (is(&loader, i + 1, "resource") || is(&loader, i + 1, "derive")) {
            fail(&mut loader, owner, loader.raw.starts[i], "@thread_safe can only be applied to functions"); return
        }
        if depth == 0 && parens == 0 && loader.standard[owner] != "json" && is(&loader, i, "@") && is(&loader, i + 1, "derive") && is(&loader, i + 2, "(") {
            mut pdepth := 1
            mut dpos := i + 3
            while dpos < last && pdepth > 0 {
                if is(&loader, dpos, "(") { pdepth += 1 }
                else if is(&loader, dpos, ")") { pdepth -= 1 }
                else if pdepth == 1 && loader.raw.kinds[dpos] == .Name && (loader.raw.texts[dpos] == "Encode" || loader.raw.texts[dpos] == "Decode") {
                    _ := add(&mut loader, "<stdlib/json.ddr>", "json", owner, loader.raw.starts[dpos])
                }
                dpos += 1
            }
        }
        if depth == 0 && is(&loader,i,"@") && is(&loader,i+1,"requires") {
            next := scan_requires(&mut loader, owner, i, last, &mut requires_caps)
            if next < 0 { return }
            i = next; continue
        }
        if depth == 0 && is(&loader, i, "import") {
            if top_thread_safe { fail(&mut loader, owner, loader.raw.starts[i], "expected 'fn' after '@thread_safe'"); return }
            i = import_module(&mut loader, owner, i); public = false; continue
        }
        if depth == 0 && is(&loader, i, "@") && is(&loader, i + 1, "test") {
            if top_thread_safe { fail(&mut loader, owner, loader.raw.starts[i], "expected 'fn' after '@thread_safe'"); return }
            tag := i
            body := skip_lines(&loader, i + 2)
            attached := is(&loader, body, "{")
            mut after := body
            if attached { after = close_block(&loader, body) }
            if after < 0 { fail(&mut loader, owner, loader.raw.starts[tag], "unterminated test block"); return }
            mut function := skip_lines(&loader, after)
            if is(&loader, function, "pub") { function = skip_lines(&loader, function + 1) }
            if !is(&loader, function, "fn") {
                fail(&mut loader, owner, loader.raw.starts[tag], "expected function after @test"); return
            }
            name := function + 1
            if name >= last || loader.raw.kinds[name] != .Name { fail(&mut loader, owner, loader.raw.starts[tag], "expected test function name"); return }
            if loader.testing && loader.standard[owner] == "" {
                loader.module_has_tests[owner] = true
                loader.test_tags.push(tag); loader.test_targets.push(name)
                if attached { loader.test_ends.push(after) } else { loader.test_ends.push(-1) }
                loader.result.groups.push(loader.result.paths[owner] + "::" + loader.raw.texts[name])
                if attached { i = after } else { i = body }
            } else {
                if !attached {
                    while after < last && !is(&loader, after, "{") { after = after + 1 }
                    after = close_block(&loader, after)
                    if after < 0 { fail(&mut loader, owner, loader.raw.starts[tag], "unterminated test function"); return }
                }
                if loader.standard[owner] == "" {
                    loader.test_hidden_owners.push(owner); loader.test_hidden_starts.push(tag); loader.test_hidden_ends.push(after)
                }
                hide(&mut loader, tag, after); i = after
            }
            continue
        }
        if depth == 0 && is(&loader, i, "pub") { public = true }
        if depth == 0 && parens == 0 && is(&loader, i, "impl") {
            if top_thread_safe { fail(&mut loader, owner, loader.raw.starts[i], "@thread_safe can only be applied to functions"); return }
            if public { fail(&mut loader, owner, loader.raw.starts[i], "impl block cannot be public; mark individual methods with pub"); return }
            name_at := i + 1
            if name_at >= last || loader.raw.kinds[name_at] != .Name { fail(&mut loader, owner, loader.raw.starts[i], "expected type or trait name after impl"); return }
            mut head_end := name_at
            if head_end + 2 < last && is(&loader, head_end + 1, ".") && loader.raw.kinds[head_end + 2] == .Name { head_end += 2 }
            after_head := skip_lines(&loader, head_end + 1)
            if is(&loader, after_head, "for") {
                target_at := skip_lines(&loader, after_head + 1)
                mut brace_at := target_at
                if is(&loader, target_at, "[") {
                    if !is(&loader, target_at + 1, "]") { fail(&mut loader, owner, loader.raw.starts[target_at], "expected target type after 'for'"); return }
                    mut target_end := target_at + 2
                    if target_end >= last || loader.raw.kinds[target_end] != .Name { fail(&mut loader, owner, loader.raw.starts[target_at], "expected target type after 'for'"); return }
                    if target_end + 2 < last && is(&loader, target_end + 1, ".") && loader.raw.kinds[target_end + 2] == .Name { target_end += 2 }
                    brace_at = skip_lines(&loader, target_end + 1)
                } else if is(&loader, target_at, "(") {
                    close_paren := balanced_end(&loader.raw.kinds, &loader.raw.texts, target_at, last, &mut scan_stack)
                    if close_paren < 0 { fail(&mut loader, owner, loader.raw.starts[target_at], "expected target type after 'for'"); return }
                    brace_at = skip_lines(&loader, close_paren)
                } else {
                    if target_at >= last || loader.raw.kinds[target_at] != .Name { fail(&mut loader, owner, loader.raw.starts[after_head], "expected target type after 'for'"); return }
                    mut target_end := target_at
                    if target_end + 2 < last && is(&loader, target_end + 1, ".") && loader.raw.kinds[target_end + 2] == .Name { target_end += 2 }
                    brace_at = skip_lines(&loader, target_end + 1)
                    if is(&loader, brace_at, "<") {
                        params := syntax.parameters(&loader.raw, target_end)
                        if params.error != "" { fail(&mut loader, owner, loader.raw.starts[params.after], params.error); return }
                        brace_at = skip_lines(&loader, params.after)
                    }
                }
                if is(&loader, brace_at, "where") {
                    while brace_at < last && !is(&loader, brace_at, "{") { brace_at += 1 }
                }
                if !is(&loader, brace_at, "{") { fail(&mut loader, owner, loader.raw.starts[target_at], "expected '{' after impl target"); return }
                in_impl = true; depth = depth + 1; i = brace_at + 1; continue
            }
            if is(&loader, name_at + 1, ".") { fail(&mut loader, owner, loader.raw.starts[name_at], "cannot implement methods for an imported type"); return }
            mut brace_at := after_head
            if is(&loader, brace_at, "<") {
                params := syntax.parameters(&loader.raw, name_at)
                if params.error != "" { fail(&mut loader, owner, loader.raw.starts[params.after], params.error); return }
                brace_at = skip_lines(&loader, params.after)
                if is(&loader, brace_at, "where") {
                    while brace_at < last && !is(&loader, brace_at, "{") { brace_at += 1 }
                }
            }
            if !is(&loader, brace_at, "{") { fail(&mut loader, owner, loader.raw.starts[name_at], "expected '{' after impl type name"); return }
            impl_targets.push(name_at)
            in_impl = true; depth = depth + 1; i = brace_at + 1; continue
        }
        if depth == 0 && parens == 0 && !is(&loader, i - 1, "extern") && ((is(&loader, i, "fn") && !is(&loader, i + 1, "(")) || is(&loader, i, "struct") || is(&loader, i, "enum") || is(&loader, i, "trait") || is(&loader, i, "const")) {
            if top_thread_safe && !is(&loader, i, "fn") { fail(&mut loader, owner, loader.raw.starts[i], "@thread_safe can only be applied to functions"); return }
            if is(&loader, i, "fn") { top_thread_safe = false }
            name_at := i + 1
            if name_at >= last || loader.raw.kinds[name_at] != .Name { fail(&mut loader, owner, loader.raw.starts[i], "expected declaration name"); return }
            name := loader.raw.texts[name_at].clone()
            if name == "TaskID" || name == "Sendable" || name == "Storable" || name == "Clone" || name == "Copy" || name == "Iterator" { fail(&mut loader, owner, loader.raw.starts[name_at], "reserved compiler type or trait name '" + name + "'"); return }
            if name == "self" || name == "Self" { fail(&mut loader, owner, loader.raw.starts[name_at], "reserved identifier '" + name + "'"); return }
            entry := key(&loader, owner, name)
            if loader.symbols.contains(entry) || loader.imports.contains(entry) {
                fail(&mut loader, owner, loader.raw.starts[name_at], "duplicate declaration '" + name + "'"); return
            }
            id := loader.result.symbols.len
            loader.symbols.put(move entry, i64(id))
            loader.namespace_initials[owner] = loader.namespace_initials[owner].bit_or(initial_bit(name))
            if requires_caps != 0 && owner==0 && name=="main" {fail(&mut loader,owner,loader.raw.starts[name_at],"main cannot require a grant; declare needed capabilities with 'capability ...' at the top of the module");return}
            loader.owners.push(owner); loader.public.push(public)
            loader.records.push(is(&loader, i, "struct"))
            loader.types.push(is(&loader, i, "struct") || is(&loader, i, "enum"))
            loader.traits.push(is(&loader, i, "trait"))
            loader.requires_caps.push(requires_caps);requires_caps=0
            mut renamed := "__dunder_module_" + id.str()
            if (!loader.testing || loader.result.token_offsets) && owner == 0 && name == "main" && is(&loader, i, "fn") { renamed = "main" }
            loader.result.symbols.push(move name)
            loader.renamed.push(move renamed); loader.declaration_tokens.push(name_at)
            public = false
        }
        if is(&loader, i, "{") { depth = depth + 1 }
        if is(&loader, i, "}") { depth = depth - 1 }
        if is(&loader, i, "(") || is(&loader, i, "[") { parens = parens + 1 }
        if is(&loader, i, ")") || is(&loader, i, "]") { parens = parens - 1 }
        i = i + 1
    }
    if in_impl { fail(&mut loader, owner, loader.raw.starts[last - 1], "unterminated impl block"); return }
    if top_thread_safe { fail(&mut loader, owner, loader.raw.starts[last - 1], "expected 'fn' after '@thread_safe'"); return }
    for target in &impl_targets {
        tname := loader.raw.texts[target].clone()
        found := i32(loader.symbols.get_or(key(&loader, owner, tname), -1))
        if tname == "Self" || found < 0 || !loader.types[found] {
            fail(&mut loader, owner, loader.raw.starts[target], "impl target '" + tname + "' must be a struct or enum declared in this module"); return
        }
    }
}
fn local(names: &[]string, active: &[]i32, at: i32, value: string) -> bool {
    mut i := names.len
    while i > 0 { i = i - 1; if names[i] == value && at >= active[i] { return true } }
    false
}
fn balanced_end(kinds: &[]lexer.Kind, texts: &[]string, first: i32, last: i32, stack: &mut []i32) -> i32 {
    stack.clear()
    if first < 0 || first >= last || last > kinds.len || last > texts.len || kinds[first] != .Symbol { return -1 }
    if texts[first] != "(" && texts[first] != "[" && texts[first] != "{" { return -1 }
    mut i := first
    while i < last {
        if kinds[i] == .Symbol {
            word := texts[i].clone()
            mut open := 0; mut close := 0
            if word == "(" { open = 1 } else if word == "[" { open = 2 } else if word == "{" { open = 3 }
            if word == ")" { close = 1 } else if word == "]" { close = 2 } else if word == "}" { close = 3 }
            if open != 0 { stack.push(open) }
            if close != 0 {
                if stack.len == 0 || stack[stack.len - 1] != close { return -1 }
                _ := stack.pop()
                if stack.len == 0 { return i + 1 }
            }
        }
        i = i + 1
    }
    -1
}
fn generic_name(loader: &Loader, owner: i32, at: i32, names: &[]string, active: &[]i32) -> bool {
    if at < 0 || loader.raw.kinds[at] != .Name { return false }
    name := &loader.raw.texts[at]
    mut module := owner
    if is(&loader, at - 1, ".") {
        if at < 2 || loader.raw.kinds[at - 2] != .Name { return false }
        alias := &loader.raw.texts[at - 2]
        if local(&names, &active, at - 2, alias) { return false }
        module = i32(loader.imports.get_or(key(&loader, owner, alias), -1))
        if module < 0 { return false }
        if loader.standard[module] != "" && bundled.prelude_generic(name) && bundled.prelude_export(loader.standard[module], name) != "" { return true }
    } else {
        if local(&names, &active, at, name) { return false }
        si := i32(loader.sym_imports.get_or(key(&loader, owner, name), -1))
        if si >= 0 {
            if loader.sym_import_prelude[si] != "" { return bundled.prelude_generic(loader.sym_import_member[si]) }
            sym_id := loader.sym_import_symbol[si]
            return sym_id >= 0 && is(&loader, loader.declaration_tokens[sym_id] + 1, "<")
        }
        if bundled.prelude_generic(name) && bundled.prelude_export("", name) != "" { return true }
    }
    id := i32(loader.symbols.get_or(key(&loader, module, name), -1))
    id >= 0 && is(&loader, loader.declaration_tokens[id] + 1, "<")
}
fn constructor_brace(loader: &Loader, owner: i32, at: i32, names: &[]string, active: &[]i32, in_impl: bool) -> bool {
    mut name_at := at - 1
    if is(&loader, name_at, ">") {
        mut angles := 1
        while name_at > 0 && angles > 0 {
            name_at -= 1
            if is(&loader, name_at, "<") { angles -= 1 }
            else if is(&loader, name_at, ">") { angles += 1 }
            else if is(&loader, name_at, "{") || is(&loader, name_at, "}") { return false }
        }
        name_at -= 1
    }
    if name_at < 0 || loader.raw.kinds[name_at] != .Name { return false }
    if in_impl && loader.raw.texts[name_at] == "Self" && !is(&loader, name_at - 1, ".") { return true }
    mut source := owner
    if is(&loader, name_at - 1, ".") {
        alias := name_at - 2
        if alias < 0 || loader.raw.kinds[alias] != .Name || is(&loader, alias - 1, ".") { return false }
        if local(&names, &active, alias, loader.raw.texts[alias]) { return false }
        source = i32(loader.imports.get_or(key(&loader, owner, loader.raw.texts[alias]), -1))
        if source < 0 { return false }
    } else if local(&names, &active, name_at, loader.raw.texts[name_at]) {
        return false
    } else {
        si := i32(loader.sym_imports.get_or(key(&loader, owner, loader.raw.texts[name_at]), -1))
        if si >= 0 {
            sym_id := loader.sym_import_symbol[si]
            return sym_id >= 0 && loader.records[sym_id]
        }
    }
    id := i32(loader.symbols.get_or(key(&loader, source, loader.raw.texts[name_at]), -1))
    id >= 0 && loader.records[id]
}
fn iterator_body(loader: &Loader, owner: i32, name: i32, last: i32, names: &[]string, active: &[]i32, stack: &mut []i32, in_impl: bool) -> i32 {
    mut i := name + 2
    mut pending_bodies := 0
    while i < last {
        if loader.raw.kinds[i] == .End || is(&loader, i, "}") { return last }
        if is(&loader, i, "match") || is(&loader, i, "if") || (is(&loader, i, "else") && !is(&loader, i + 1, "if")) {
            pending_bodies = pending_bodies + 1
        }
        if is(&loader, i, "{") && !constructor_brace(&loader, owner, i, &names, &active, in_impl) {
            if pending_bodies == 0 { return i }
            pending_bodies = pending_bodies - 1
        }
        if is(&loader, i, "(") || is(&loader, i, "[") || is(&loader, i, "{") {
            after := balanced_end(&loader.raw.kinds, &loader.raw.texts, i, last, &mut stack)
            if after < 0 { return last }; i = after
        } else { i = i + 1 }
    }
    last
}
fn binding_end(loader: &Loader, at: i32, last: i32) -> i32 {
    mut i := at + 1
    mut nested := 0
    while i < last {
        if nested == 0 && lexer.is_newline(loader.raw.kinds[i]) && is(&loader, i - 1, "}") {
            mut next := i + 1
            while next < last && lexer.is_newline(loader.raw.kinds[next]) { next = next + 1 }
            if is(&loader, next, "else") { i = next }
        }
        if nested == 0 && (lexer.is_newline(loader.raw.kinds[i]) || is(&loader, i, ";") || is(&loader, i, "}")) { return i }
        if is(&loader, i, "(") || is(&loader, i, "[") || is(&loader, i, "{") { nested = nested + 1 }
        if is(&loader, i, ")") || is(&loader, i, "]") || is(&loader, i, "}") { nested = nested - 1 }
        i = i + 1
    }
    i
}
fn emit(loader: &mut Loader, output: &mut []u8, owner: i32, token: i32, value: string) {
    loader.result.map_starts.push(output.len)
    bytes.append_utf8(&mut output, value)
    loader.result.map_files.push(owner); loader.result.map_offsets.push(loader.raw.starts[token])
    output.push(32)
}
fn argument_case_arrow(loader: &Loader, first: i32, end: i32) -> i32 {
    mut depth := 0
    for i in first..end {
        if is(&loader, i, "(") { depth = depth + 1 }
        if is(&loader, i, ")") {
            depth = depth - 1
            if depth == 0 { if is(&loader, i + 1, "->") { return i + 1 }; return -1 }
        }
    }
    -1
}

fn flat_token(tokens: &mut lexer.Tokens, kind: lexer.Kind, move value: string, position: i32) {
    tokens.kinds.push(kind); tokens.texts.push(move value); tokens.starts.push(position)
}
fn emit_test_code(loader: &mut Loader, output: &mut []u8, tokens: &mut lexer.Tokens, owner: i32, token: i32, start: i32, source: string) {
    if !loader.result.token_offsets { emit(&mut loader, &mut output, owner, token, source); return }
    fragment := lexer.scan(source, false)
    for i in 0..fragment.kinds.len - 1 {
        flat_token(&mut tokens, fragment.kinds[i], fragment.texts[i].clone(), start + loader.raw.starts[token])
    }
}
fn pattern_start(loader: &Loader, first: i32, end: i32) -> i32 {
    mut pos := end - 1
    if is(&loader, pos, ")") {
        mut depth := 1
        pos = pos - 1
        while pos >= first && depth > 0 {
            if is(&loader, pos, ")") { depth = depth + 1 }
            else if is(&loader, pos, "(") { depth = depth - 1 }
            else if loader.raw.kinds[pos] != .Name && !is(&loader, pos, ",") && !is(&loader, pos, ".") && !is(&loader, pos, "mut") { return -1 }
            pos = pos - 1
        }
    }
    if pos < first || loader.raw.kinds[pos] != .Name { return -1 }
    if !is(&loader, pos, "_") && !is(&loader, pos - 1, ".") { return -1 }
    while pos > first && is(&loader, pos - 1, ".") {
        pos = pos - 1
        if pos == first || loader.raw.kinds[pos - 1] != .Name { break }
        pos = pos - 1
    }
    mut before := pos - 1
    while before >= first && (lexer.is_newline(loader.raw.kinds[before]) || is(&loader, before, ";")) { before = before - 1 }
    if !is(&loader, before, "{") && !is(&loader, before, ",") { return -1 }
    pos
}
fn match_patterns(loader: &Loader, first: i32, last: i32, starts: &mut []i32, ends: &mut []i32) {
    mut waiting := false
    mut enclosing: []bool = []
    mut i := last
    mut hidden := lower_bound(&loader.hidden_starts, last) - 1
    while i > first {
        i = i - 1
        if hidden >= 0 && i < loader.hidden_ends[hidden] {
            i = loader.hidden_starts[hidden]; hidden = hidden - 1; continue
        }
        kind := loader.raw.kinds[i]
        if kind != .Symbol && (kind != .Keyword || !waiting) { continue }
        word := loader.raw.texts[i].clone()
        if kind == .Symbol {
            if word == "}" || word == "]" || word == ")" {
                if waiting || enclosing.len > 0 { enclosing.push(waiting); waiting = false }
                continue
            }
            if word == "{" || word == "[" || word == "(" {
                waiting = false
                if enclosing.len > 0 { waiting = enclosing.pop() }
                continue
            }
            if word == "," || word == ";" { waiting = false; continue }
            if word != "=>" { continue }
            waiting = true
        } else if word != "if" { continue }
        mut end := i
        while end > first && lexer.is_newline(loader.raw.kinds[end - 1]) { end = end - 1 }
        start := pattern_start(&loader, first, end)
        if start >= 0 {
            starts.push(start); ends.push(end)
            waiting = false
        }
    }
}
fn copy_body_tokens(raw: &lexer.Tokens, output: &mut lexer.Tokens, first: i32, last: i32, offset: i32, initials: i64, shadowed: bool) -> i32 {
    mut i := first
    while i < last {
        kind := raw.kinds[i]
        value := raw.texts[i].clone()
        if kind == .Name {
            if value[0] == 95 || initials.bit_and(initial_bit(value)) != 0 { break }
        } else if kind == .Symbol {
            if value == "@" || value == "{" || value == "}" || (shadowed && (value == ":" || value == "->" || value == "<")) ||
                (value == "(" && lexer.tuple_binding_end(&raw, i, last) >= 0) { break }
        } else if kind == .End || (kind == .Keyword && (value == "fn" || (value == "for" && i + 1 < last && raw.kinds[i + 1] == .Symbol && raw.texts[i + 1] == "("))) { break }
        flat_token(&mut output, kind, move value, offset + raw.starts[i])
        i = i + 1
    }
    i
}
fn borrow_source_marker(loader: &Loader, at: i32, last: i32, header: bool, trait_header: bool) -> bool {
    if at + 1 >= last { return false }
    if loader.raw.kinds[at + 1] == .Integer { return true }
    if (!header && !trait_header) || loader.raw.kinds[at + 1] != .Name { return false }
    if trait_header {
        next := at + 2
        return next >= last || lexer.is_newline(loader.raw.kinds[next]) || is(&loader, next, ";") || is(&loader, next, "{") || is(&loader, next, "}")
    }
    mut next := at + 2
    while next < last && lexer.is_newline(loader.raw.kinds[next]) { next += 1 }
    is(&loader, next, "{")
}
// Closure parameters and capture bindings shadow module names in the body.
// Keep the signature's own type names in the surrounding namespace.
fn closure_bindings(loader: &Loader, at: i32, last: i32, depth: i32, initials: i64,
    locals: &mut []string, levels: &mut []i32, active: &mut []i32, stack: &mut []i32) {
    mut params := at + 1
    if is(&loader, params, "[") {
        params = balanced_end(&loader.raw.kinds, &loader.raw.texts, params, last, &mut stack)
    }
    if params < 0 || !is(&loader, params, "(") { return }
    after := balanced_end(&loader.raw.kinds, &loader.raw.texts, params, last, &mut stack)
    if after < 0 { return }
    body := closures.body_start(&loader.raw, after, last)
    if body < 0 { return }
    for i in at + 2..after {
        if loader.raw.kinds[i] == .Name && is(&loader, i + 1, ":") {
            word := loader.raw.texts[i].clone()
            if initials.bit_and(initial_bit(word)) != 0 {
                locals.push(move word); levels.push(depth + 1); active.push(body)
            }
        }
    }
}
fn is_known_compound_type(loader: &Loader, owner: i32, word: string) -> bool {
    if word == "TaskID" || word == "Sendable" || word == "Storable" || word == "Clone" || word == "Copy" || word == "Iterator" || word == "Self" ||
        word == "Fn" || word == "FnMut" || word == "FnOnce" { return true }
    for primitive in rules.primitive_types() { if word == primitive { return true } }
    if loader.symbols.contains(key(&loader, owner, word)) || loader.sym_imports.contains(key(&loader, owner, word)) { return true }
    bundled.prelude_export("", word) != ""
}
fn flatten(loader: &mut Loader, owner: i32, output: &mut []u8, bindings: &mut []i32, tokens: &mut lexer.Tokens, start: i32, record_names: bool) {
    if loader.result.token_offsets {
        loader.result.map_starts.push(start); loader.result.map_files.push(owner)
    }
    mut i := loader.first[owner]
    last := loader.last[owner]
    mut hidden := lower_bound(&loader.hidden_starts, i)
    mut declaration := lower_bound(&loader.declaration_tokens, i)
    mut depth := 0
    mut mode := 0
    mut in_impl := false
    mut in_trait := false
    mut in_requires := false
    mut scope_with_start := -1
    mut scope_with_until := -1
    mut scope_arena_tok := -1
    mut locals: []string = []
    mut levels: []i32 = []
    mut active: []i32 = []
    mut brace_scopes: []bool = []; mut delimiter_stack: []i32 = []
    mut pattern_starts: []i32 = []; mut pattern_ends: []i32 = []
    if loader.last_arm[owner] >= i { match_patterns(&loader, i, loader.last_arm[owner] + 1, &mut pattern_starts, &mut pattern_ends) }
    namespace := loader.namespace_initials[owner].bit_or(bundled.prelude_initials())
    mut initials := namespace
    mut type_params: []string = []
    mut impl_type_param_count := 0
    mut type_end := -1
    mut generic_params_start := -1
    mut generic_params_end := -1
    mut in_where := false
    mut pattern := pattern_starts.len - 1; mut enum_parens := 0
    mut arm_locals: []i32 = []; mut arm_depths: []i32 = []
    mut arm_depth := 0
    mut previous := -1
    mut case_target := ""
    mut case_end := -1
    mut case_arrow := -1
    mut expected_end := -1
    mut tuple_assignment := -1; mut tuple_visible := -1
