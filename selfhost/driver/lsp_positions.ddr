pub enum Encoding { Utf8, Utf16, Utf32 }

pub struct Position { line: i32, character: i32 }

pub struct LineIndex {
    source: string,
    starts: []i32,
    ends: []i32,
}

pub fn index(source: string) -> LineIndex {
    mut starts: []i32 = [0]
    mut ends: []i32 = []
    mut offset := 0
    while offset < source.len {
        byte := source[offset]
        if byte == 10 || byte == 13 {
            ends.push(offset)
            if byte == 13 && offset + 1 < source.len && source[offset + 1] == 10 { offset += 1 }
            starts.push(offset + 1)
        }
        offset += 1
    }
    ends.push(source.len)
    LineIndex { source: source.clone(), starts: starts, ends: ends }
}

fn scalar_width(byte: u8) -> i32 {
    if byte >= 240 { return 4 }
    if byte >= 224 { return 3 }
    if byte >= 192 { return 2 }
    1
}

fn character_width(width: i32, encoding: Encoding) -> i32 {
    if encoding == .Utf8 { return width }
    if encoding == .Utf16 && width == 4 { return 2 }
    1
}

pub fn position(lines: &LineIndex, offset: i32, encoding: Encoding) -> Position {
    limit := if offset < 0 { 0 } else if offset > lines.source.len { lines.source.len } else { offset }
    mut lo := 0
    mut hi := lines.starts.len
    while lo + 1 < hi {
        mid := lo + (hi - lo) / 2
        if lines.starts[mid] <= limit { lo = mid } else { hi = mid }
    }
    end := if limit < lines.ends[lo] { limit } else { lines.ends[lo] }
    mut byte := lines.starts[lo]
    mut character := 0
    while byte < end {
        width := scalar_width(lines.source[byte])
        if width > end - byte { break }
        character += character_width(width, encoding)
        byte += width
    }
    Position { line: lo, character: character }
}

pub fn offset(lines: &LineIndex, line: i64, character: i64, encoding: Encoding) -> i32 {
    if line < 0 || line >= i64(lines.starts.len) || character < 0 || character > 2147483647 { return -1 }
    mut byte := lines.starts[i32(line)]
    end := lines.ends[i32(line)]
    mut column: i64 = 0
    while byte < end && column < character {
        width := scalar_width(lines.source[byte])
        column += i64(character_width(width, encoding))
        if column > character { return -1 }
        byte += width
    }
    byte
}

@test fn lsp_line_index_encodings_and_newlines() {
    lines := index("a🦔ö\r\nb\rc\n")
    assert(position(&lines, 7, .Utf8).character == 7)
    assert(position(&lines, 7, .Utf16).character == 4)
    assert(position(&lines, 7, .Utf32).character == 3)
    assert(position(&lines, 8, .Utf16).character == 4)
    assert(position(&lines, 9, .Utf16).line == 1)
    assert(offset(&lines, 2, 0, .Utf16) == 11)
    assert(offset(&lines, 3, 99, .Utf16) == lines.source.len)
    assert(offset(&lines, 4, 0, .Utf16) == -1)
    assert(offset(&lines, 0, 2, .Utf16) == -1)
    assert(offset(&lines, 0, 2, .Utf8) == -1)
    assert(offset(&lines, 0, 2, .Utf32) == 5)
    assert(offset(&lines, 0, 99, .Utf8) == 7)
}
