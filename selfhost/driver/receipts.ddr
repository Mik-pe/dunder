capability filesystem
import cache_io
import ..bundled
import cli
import ..frontend.lexer
import ..frontend.scalar_rules as rules
import modules
import std.bytes as bytes
import std.text as text
import sys
import ..mir.mir_memory

struct Graph {
    ids: Map<string, i64>, same_next: []i32, body: []string, observable: []bool,
    first: []i32, code_start: []i32, end: []i32, edge_start: []i32, edges: []i32,
    context: string, ok: bool,
}
fn symbol(t: &lexer.Tokens, i: i32, s: string) -> bool { t.kinds[i] == .Symbol && t.texts[i] == s }

fn add_references(g: &mut Graph, name: string, caller: i32, seen: &mut []i32) {
    mut dep := i32(g.ids.get_or(name, -1))
    while dep >= 0 && seen[dep] != caller {
        seen[dep] = caller
        g.edges.push(dep)
        dep = g.same_next[dep]
    }
}

fn graph(source: string) -> Graph {
    mut g := Graph { ids: Map<string, i64>::new(), same_next: [], body: [], observable: [], first: [], code_start: [], end: [],
        edge_start: [], edges: [], context: "", ok: false }
    t := lexer.scan(source, false)
    if !t.ok { return g }
    mut shared: []u8 = []
    mut pos := 0
    mut i := 0
    mut in_extern := false
    mut extern_depth := 0
    mut resource := -1
    while i + 1 < t.kinds.len {
        if !in_extern && t.kinds[i] == .Name && t.texts[i] == "extern" && t.texts[i + 1] != "type" {
            mut k := i + 1
            if k < t.kinds.len && t.kinds[k] == .String { k += 1 }
            while k < t.kinds.len && lexer.is_newline(t.kinds[k]) { k += 1 }
            if k < t.kinds.len && symbol(&t, k, "{") {
                in_extern = true; extern_depth = 1; i = k + 1; continue
            }
        }
        if in_extern {
            if symbol(&t, i, "{") { extern_depth += 1; i += 1; continue }
            if symbol(&t, i, "}") {
                extern_depth -= 1
                if extern_depth == 0 { in_extern = false }
                i += 1; continue
            }
        }
        if symbol(&t, i, "@") && t.texts[i + 1] == "resource" { resource = i }
        is_type := !in_extern && t.kinds[i] == .Keyword && (t.texts[i] == "struct" || t.texts[i] == "enum")
        if (!is_type && (t.kinds[i] != .Keyword || t.texts[i] != "fn")) || t.kinds[i + 1] != .Name { i += 1; continue }
        mut open := i + 2
        if !in_extern {
            while open < t.kinds.len && !symbol(&t, open, "{") && !symbol(&t, open, "}") &&
                !(t.kinds[open] == .Keyword && t.texts[open] == "fn" && open + 1 < t.kinds.len && t.kinds[open + 1] == .Name) { open += 1 }
            if open >= t.kinds.len { return g }
            if !symbol(&t, open, "{") { i = open; continue }
        }
        name := t.texts[i + 1].clone()
        prev := i32(g.ids.get_or(name, -1))
        g.same_next.push(prev)
        g.ids.put(move name, i64(g.body.len))
        if in_extern {
            g.first.push(0)
            g.code_start.push(0)
            g.end.push(0)
            g.body.push("")
            g.observable.push(true)
            i += 2
            continue
        }
        mut end := open + 1
        mut depth := 1
        mut effects := i > 0 && t.texts[i - 1] == "unsafe"
        while end < t.kinds.len && depth > 0 {
            if symbol(&t, end, "{") { depth += 1 }
            if symbol(&t, end, "}") { depth -= 1 }
            if t.kinds[end] == .Name {
                word := &t.texts[end]
                if word == "unsafe" || word == "ptr" || word == "ffi_fn" || text.starts_with(word, "__sys_") { effects = true }
            }
            end += 1
        }
        if depth != 0 { return g }
        if is_type {
            g.body.push("")
            g.first.push(if resource >= 0 { resource } else { i + 2 })
            g.code_start.push(end)
            resource = -1
        } else {
            bytes.append_utf8(&mut shared, source[pos..t.ends[open]])
            pos = t.starts[end - 1]
            g.body.push(cache_io.digest(source[t.starts[open]..t.ends[end - 1]]))
            g.first.push(i + 2)
            g.code_start.push(open + 1)
        }
        g.end.push(end - 1)
        g.observable.push(effects)
        i = end
    }
    bytes.append_utf8(&mut shared, source[pos..source.len])
    g.context = cache_io.binary_hash(&shared)
    mut seen: []i32 = []; for _ in 0..g.body.len { seen.push(-1) }
    for f in 0..g.body.len {
        g.edge_start.push(g.edges.len)
        for token in g.first[f]..g.end[f] {
            if t.kinds[token] == .Name {
                add_references(&mut g, t.texts[token], f, &mut seen)
                if t.texts[token] == "print" { add_references(&mut g, "str", f, &mut seen) }
            } else if token < g.code_start[f] { continue }
            else if t.kinds[token] == .Symbol {
                op := rules.opcode(t.texts[token])
                if op >= 6 && op <= 11 { add_references(&mut g, rules.comparison_method(op), f, &mut seen) }
            } else if t.kinds[token] == .Keyword && t.texts[token] == "for" {
                add_references(&mut g, "next", f, &mut seen)
            }
        }
    }
    g.edge_start.push(g.edges.len)
    g.ok = true
    g
}
fn closure(g: &Graph, name: string, identity: string) -> string {
    root := i32(g.ids.get_or(name, -1))
    if root < 0 { return "" }
    mut visited: []bool = []
    for _ in 0..g.body.len { visited.push(false) }
    mut queue: []i32 = [root]
    mut next := 0
    visited[root] = true
    while next < queue.len {
        f := queue[next]
        if g.observable[f] { return "" }
        for e in g.edge_start[f]..g.edge_start[f + 1] {
            child := g.edges[e]
            if !visited[child] {
                visited[child] = true
                queue.push(child)
            }
        }
        next += 1
    }
    mut input: []u8 = []
    bytes.append_utf8(&mut input, identity + g.context)
    for i in 0..visited.len {
        if visited[i] { bytes.append_utf8(&mut input, f"{i}:{g.body[i]}") }
    }
    cache_io.binary_hash(&input)
}
pub struct Policy {
    scalar_enabled: bool, ownership_enabled: bool, const_div_enabled: bool, frame_free_enabled: bool,
    range_enabled: bool, inline_enabled: bool, mir_opt_enabled: bool, mir_memory_enabled: bool,
    mir_ssa_enabled: bool, mir_values_enabled: bool, runtime_profile: bool,
}

pub fn policy() -> Policy {
    Policy {
        scalar_enabled: true, ownership_enabled: true, const_div_enabled: true, frame_free_enabled: true,
        range_enabled: true, inline_enabled: true, mir_opt_enabled: true, mir_memory_enabled: true,
        mir_ssa_enabled: true, mir_values_enabled: true, runtime_profile: false,
    }
}

fn on_off(enabled: bool) -> string { if enabled { "on" } else { "off" } }

fn policy_tag(config: &Policy) -> string {
    ssa := if config.mir_ssa_enabled { "v6-composed-regional-expression2-work4194304" } else { "off" }
    values := if config.mir_values_enabled { "v4-certified-compact-terminal1-work4194304" } else { "off" }
    runtime := if config.runtime_profile { "profile" } else { "plain" }
    f"scalar:{on_off(config.scalar_enabled)}:ownership:{on_off(config.ownership_enabled)}:" +
        f"const-div:{on_off(config.const_div_enabled)}:frame-free:{on_off(config.frame_free_enabled)}:" +
        f"range:{on_off(config.range_enabled)}:inline:{on_off(config.inline_enabled)}:typed-function-v1:pod-values-v2:x86-mir-v1:wasm-mir-v1:inline-whole-v1:" +
        f"mir-opt:{on_off(config.mir_opt_enabled)}:{mir_memory.source_policy_tag(config.mir_memory_enabled)}:" +
        f"mir-ssa:{ssa}:mir-values:{values}:runtime:{runtime}:"
}

pub fn keys_configured(loaded: &modules.Loaded, output: string, platform: i32, timeout_ms: i64, config: &Policy) -> []string {
    mut keys: []string = []
    for _ in &loaded.groups { keys.push("") }
    if keys.len == 0 || loaded.calls.len != keys.len { return keys }
    root := cache_io.root(loaded.paths[0]); if root == "" { return keys }
    compiler := cache_io.compiler(platform); if compiler == "" { return keys }
    g := graph(bundled.core_prelude() + "\n" + bundled.generic_prelude() + "\n" + bundled.combinators_prelude() + "\n" + loaded.source)
    if !g.ok { return keys }
    mut caps := loaded.module_caps.len.str()
    for cap in &loaded.module_caps { caps += f",{cap}" }
    env := f"dunder-passes-v2:{compiler}:{platform}:{timeout_ms}:caps={caps}:{policy_tag(&config)}"
    for i in 0..keys.len {
        id := cache_io.digest(f"{root.len}:{root}{loaded.groups[i]}")
        hash := closure(&g, loaded.calls[i], env)
        if hash != "" { keys[i] = f"{output}/.affected/{id}.pass{hash}" }
    }
    keys
}
pub fn seen(key: string) -> bool {
    if key.len <= 64 { return false }
    n := key.len - 64
    receipt := sys.read_text(key[0..n])
    receipt.ok && receipt.value == key[n..key.len]
}
pub fn update(key: string, passed: bool) {
    if key.len <= 64 { return }
    n := key.len - 64
    path := key[0..n]
    if !passed { _ := sys.remove_file(path); return }
    if !cli.prepare_parent(path) { return }
    temp := f"{path}.{sys.pid()}.tmp"
    written := sys.write_text(temp, key[n..key.len])
    if written.ok { if sys.rename(temp, path).ok { return } }
    _ := sys.remove_file(temp)
}
@test fn dependency_closure_follows_function_values_and_ignores_other_bodies() {
    source := "fn helper()->i32 { 1 } fn unused()->i32 { 2 } fn test() { f := helper; assert(f() == 1) }"
    a := graph(source)
    b := graph("fn helper()->i32 { 1 } fn unused()->i32 { 9 } fn test() { f := helper; assert(f() == 1) }")
    c := graph("fn helper()->i32 { 0 } fn unused()->i32 { 2 } fn test() { f := helper; assert(f() == 1) }")
    a.ok && b.ok && c.ok
    closure(&a,"test","x") != ""
    closure(&a,"test","x") == closure(&b,"test","x")
    closure(&a,"test","x") != closure(&c,"test","x")
    d := graph("@link(\"c\") extern \"C\" { @link_name(\"getpid\") fn external()->i32 }\nfn wrapper()->i32 { external() }")
    closure(&d,"wrapper","x") == ""
}
