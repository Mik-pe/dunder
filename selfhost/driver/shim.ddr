capability process

import std.path as path
import std.process as process
import stderr
import sys

pub fn run() -> i32 {
    usage := "usage: dunder shim [zsh]"
    if sys.arg_count() > 3 { _ := stderr.eprint(usage); return 2 }
    if sys.arg_count() == 3 && (sys.arg(2) == "--help" || sys.arg(2) == "-h") {
        print(usage)
        print("Enable Tab completion in zsh with: eval \"$(dunder shim zsh)\"")
        return 0
    }
    shell := if sys.arg_count() == 3 { sys.arg(2) } else { path.basename(process.env_or("SHELL", "")) }
    if shell != "zsh" {
        _ := stderr.eprint("dunder shim supports zsh. To generate its integration, run 'dunder shim zsh'.")
        return 2
    }
    print(r#"""
        if (( ! $+functions[compdef] )); then
            autoload -Uz compinit && compinit
        fi
        _dunder() {
            if (( CURRENT == 2 )); then
                compadd -- build build-tests check clean fmt init install lsp run shim test update upgrade --help --version --list-examples --list-targets
                return
            fi
            case $words[2] in
                run|build|check|install)
                    _arguments -S '--example=:example:($(dunder --list-examples 2>/dev/null))' '*:file:_files' ;;
                shim) (( CURRENT == 3 )) && compadd -- zsh --help ;;
                *) _files ;;
            esac
        }
        compdef _dunder dunder
        """#)
    0
}
