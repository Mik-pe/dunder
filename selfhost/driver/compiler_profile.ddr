import native_clock as monotonic
import std.json as writer
import std.text as text

pub struct Profile { enabled: bool, host: i32, clock_ok: bool, elapsed: []i64, calls: []i64, work: []i64 }
pub fn new(host: i32) -> Profile {
    mut p := Profile { enabled: host >= 0 && host <= 2, host: host, clock_ok: true, elapsed: [], calls: [], work: [] }
    if p.enabled { for i in 0..12 { p.elapsed.push(0); p.calls.push(0); p.work.push(0) } }
    p
}
pub fn phase_name(phase: i32) -> string {
    if phase == 0 { return "declarations" }
    if phase == 1 { return "model_parse" }
    if phase == 2 { return "verify_pre" }
    if phase == 3 { return "simplify" }
    if phase == 4 { return "verify_post" }
    if phase == 5 { return "allocation" }
    if phase == 6 { return "scalar_emit" }
    if phase == 7 { return "legacy_body" }
    if phase == 8 { return "fragment_cache" }
    if phase == 9 { return "finalize" }
    if phase == 11 { return "mir_pipeline" }
    "range_analysis"
}
fn unit_name(phase: i32) -> string {
    if phase == 0 { return "functions" }
    if phase == 1 || phase == 7 { return "tokens" }
    if phase == 2 || phase == 4 { return "nodes" }
    if phase == 3 { return "visits" }
    if phase == 5 { return "frame_values" }
    if phase == 6 { return "words" }
    if phase == 8 || phase == 10 || phase == 11 { return "operations" }
    "bytes"
}
pub fn clock(host: i32) -> i64 { monotonic.nanoseconds(host) }
pub fn begin(p: &Profile) -> i64 {
    if !p.enabled { return -1 }
    clock(p.host)
}
pub fn record(p: &mut Profile, phase: i32, first: i64, last: i64, work: i64) {
    if !p.enabled { return }
    if phase < 0 || phase >= 12 || work < 0 { p.clock_ok = false; return }
    p.calls[phase] += 1
    p.work[phase] += work
    if first < 0 || last < first { p.clock_ok = false; return }
    p.elapsed[phase] = p.elapsed[phase] + last - first
}
pub fn finish(p: &mut Profile, phase: i32, first: i64, work: i64) {
    if !p.enabled { return }
    last := clock(p.host)
    record(&mut p, phase, first, last, work)
}
pub fn write_fields(out: &mut []u8, first: &mut bool, p: &Profile, compiler_ns: i64) {
    writer.field_bool(&mut out, &mut first, "enabled", p.enabled)
    if !p.enabled { return }
    mut total: i64 = 0
    for elapsed in &p.elapsed { total += elapsed }
    valid := p.clock_ok && compiler_ns >= total
    writer.field_bool(&mut out, &mut first, "clock_ok", valid)
    writer.field_str(&mut out, &mut first, "unit", "ns")
    if valid {
        writer.field_i64(&mut out, &mut first, "covered", total)
        writer.field_i64(&mut out, &mut first, "other", compiler_ns - total)
    } else {
        writer.field_null(&mut out, &mut first, "covered")
        writer.field_null(&mut out, &mut first, "other")
    }
    mut phases := writer.begin_field_obj(&mut out, &mut first, "phases")
    for phase in 0..p.elapsed.len {
        name := phase_name(phase)
        if valid { writer.field_i64(&mut out, &mut phases, name, p.elapsed[phase]) }
        else { writer.field_null(&mut out, &mut phases, name) }
    }
    writer.end_obj(&mut out)
    mut calls := writer.begin_field_obj(&mut out, &mut first, "calls")
    for phase in 0..p.calls.len {
        writer.field_i64(&mut out, &mut calls, phase_name(phase), p.calls[phase])
    }
    writer.end_obj(&mut out)
    mut work := writer.begin_field_obj(&mut out, &mut first, "work")
    for phase in 0..p.work.len {
        key := f"{phase_name(phase)}_{unit_name(phase)}"
        writer.field_i64(&mut out, &mut work, key, p.work[phase])
    }
    writer.end_obj(&mut out)
}

pub fn json(p: &Profile, compiler_ns: i64) -> string {
    mut out: []u8 = []
    mut first := writer.begin_obj(&mut out)
    write_fields(&mut out, &mut first, &p, compiler_ns)
    writer.end_obj(&mut out)
    writer.finish_text(&out)
}

fn find_substr(haystack: string, needle: string) -> i32 {
    if needle.len == 0 { return 0 }
    if needle.len > haystack.len { return -1 }
    limit := haystack.len - needle.len + 1
    for i in 0..limit {
        mut ok := true
        for j in 0..needle.len {
            if haystack[i + j] != needle[j] { ok = false; break }
        }
        if ok { return i }
    }
    -1
}

@test fn compiler_profile_accounts_intervals_and_preserves_missing_clock_data() {
    mut off := new(-1)
    record(&mut off, 3, 1, 4, 9)
    off.calls.len == 0
    json(&off, 100) == "{\"enabled\":false}"
    mut p := new(0)
    record(&mut p, 1, 10, 30, 42); record(&mut p, 1, 40, 50, 3)
    p.elapsed[1] == 30
    p.calls[1] == 2
    p.work[1] == 45
    find_substr(json(&p, 100), "\"covered\":30,\"other\":70") >= 0
    find_substr(json(&p, 20), "\"clock_ok\":true") < 0
    record(&mut p, 2, -1, 40, 8)
    !p.clock_ok
    find_substr(json(&p, 100), "\"covered\":null,\"other\":null") >= 0
    p.calls[2] == 1
    p.work[2] == 8
}
