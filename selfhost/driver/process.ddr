capability unsafe
import std.bytes as buffer
import budget
import receipts
import native_clock as monotonic
import ...stdlib.sys.winpath as wide
import ...stdlib.sys.winprocess as win
import sys

@extern("c","fork") unsafe fn child_process() -> i32
@extern("c","execv") unsafe fn execute(path: ptr, argv: ptr) -> i32
@extern("c","execve") unsafe fn execute_env(path: ptr, argv: ptr, envp: ptr) -> i32
@extern("c","execvp") unsafe fn execute_path(path: ptr, argv: ptr) -> i32
@extern("c","_NSGetEnviron") unsafe fn c_ns_get_environ() -> ptr
@extern("c","open") unsafe fn open_file(path: ptr, flags: i32) -> i32
@extern("c","dup2") unsafe fn duplicate_fd(oldfd: i32, newfd: i32) -> i32
@extern("c","close") unsafe fn close_fd(fd: i32) -> i32
@extern("c","_exit") unsafe fn exit_child(code: i32)
@extern("c","waitpid") unsafe fn wait_child(pid: i32, status: ptr, options: i32) -> i32
@extern("c","kill") unsafe fn signal_child(pid: i32, signal: i32) -> i32
@extern("c","setpgid") unsafe fn process_group(pid: i32, group: i32) -> i32
@extern("c","usleep") unsafe fn sleep_us(interval: u32) -> i32
@extern("c","pipe") unsafe fn make_pipe(fds: ptr) -> i32
@extern("c","poll") unsafe fn poll_fds(fds: ptr, nfds: u32, timeout: i32) -> i32
@extern("c","read") unsafe fn read_fd(fd: i32, buf: ptr, count: usize) -> i64
@extern("c","write") unsafe fn write_fd(fd: i32, buf: ptr, count: usize) -> i64
@extern("c","flock") unsafe fn lock_descriptor(fd: i32, operation: i32) -> i32

unsafe fn host_environ() -> ptr {
    if target_is("macos") {
        cell := c_ns_get_environ()
        if usize(cell) != 0 { return load_ptr(cell) }
        return ptr(0)
    } else if target_is("linux") {
        return sys.envp()
    }
    ptr(0)
}

fn entry_matches_prefix(buf: &[]u8, eq: i32, name: string) -> bool {
    if eq != name.len { return false }
    for i in 0..name.len {
        if i32(buf[i]) != i32(name[i]) { return false }
    }
    true
}

fn append_c_entry(blob: &mut []u8, offsets: &mut []i32, entry: string) {
    offsets.push(blob.len)
    for b in entry.bytes() {
        if b != 0 { blob.push(u8(b)) }
    }
    blob.push(0)
}

unsafe fn prepare_test_env(child_jobs: i32, env_blob: &mut []u8, env_offsets: &mut []i32) {
    key := budget.child_jobs_env()
    envp_parent := host_environ()
    if usize(envp_parent) != 0 {
        mut idx: usize = 0
        mut entry_buf: []u8 = []
        while idx < 16384 {
            ep := load_ptr(ptr(usize(envp_parent) + idx * size_of(ptr)))
            if usize(ep) == 0 { break }
            entry_buf.clear()
            mut eq := -1
            mut j: usize = 0
            while j < 1048576 {
                b := load_u8(ptr(usize(ep) + j))
                if b == 0 { break }
                if b == 61 && eq < 0 { eq = i32(j) }
                entry_buf.push(b)
                j += 1
            }
            if eq > 0 && !entry_matches_prefix(&entry_buf, eq, key) {
                env_offsets.push(env_blob.len)
                buffer.extend(&mut env_blob, &entry_buf)
                env_blob.push(0)
            }
            idx += 1
        }
    }
    append_c_entry(&mut env_blob, &mut env_offsets, f"{key}={child_jobs}")
}

pub fn monotonic_nanoseconds(platform: i32) -> i64 {
    monotonic.nanoseconds(platform)
}
unsafe fn milliseconds(platform: i32) -> i64 {
    now := monotonic_nanoseconds(platform)
    if now < 0 { return -1 }
    now / 1000000
}
fn append_arg(bytes: &mut []u8, offsets: &mut []i32, arg: string) -> bool {
    offsets.push(bytes.len)
    for b in arg.bytes() {
        if b == 0 { return false }
        bytes.push(u8(b))
    }
    bytes.push(0)
    true
}

unsafe fn terminate_group(pid: i32) {
    if signal_child(-pid, 9) != 0 {
        _ := signal_child(pid, 9)
        _ := signal_child(-pid, 9)
    }
}

fn run_impl(path: string, args: &[]string, timeout_ms: i64, platform: i32, search_path: bool, stdout_path: string) -> i32 {
    if target_is("windows") {
        streams := win.Streams { input: 0, output: if stdout_path.len > 0 { 3 } else { 0 }, error_output: 0, output_path: stdout_path.clone() }
        env: []u16 = []
        unsafe {
            child := win.start(path, path, &args, "", &env, &streams, search_path, wide.path)
            if child.error != 0 { return if child.error == 2 { 127 } else { 126 } }
            defer { win.close(child.process); win.close(child.job) }
            mut code := 126
            waited := win.wait(child.process, if timeout_ms > 0 { timeout_ms } else { -1 }, &mut code)
            if waited == 1 { return code }
            _ := win.kill(child.job, 124); _ := win.wait(child.process, -1, &mut code)
            return if waited == 0 { 124 } else { 126 }
        }
    } else { return run_posix(path, &args, timeout_ms, platform, search_path, stdout_path) }
    126
}

fn run_posix(path: string, args: &[]string, timeout_ms: i64, platform: i32, search_path: bool, stdout_path: string) -> i32 {
    mut bytes: []u8 = []
    mut offsets: []i32 = []
    if !append_arg(&mut bytes, &mut offsets, path) { return 126 }
    for arg in &args { if !append_arg(&mut bytes, &mut offsets, arg) { return 126 } }
    mut redirect: []u8 = []
    for b in stdout_path.bytes() { if b == 0 { return 126 }; redirect.push(u8(b)) }
    redirect.push(0)
    unsafe {
        mut argv: []ptr = []
        for offset in &offsets { argv.push(addr(&bytes[offset])) }
        argv.push(ptr(0))
        executable := argv[0]
        arguments := addr(&argv[0])
        mut status := 0
        status_ptr := addr(&mut status)
        mut start: i64 = 0
        if timeout_ms > 0 { start = milliseconds(platform); if start < 0 { return 126 } }
        mut pid := child_process()
        mut fork_tries := 0
        while pid < 0 && fork_tries < 200 {
            _ := sleep_us(5000)
            pid = child_process()
            fork_tries += 1
        }
        if pid < 0 { return 126 }
        if pid == 0 {
            if timeout_ms > 0 && process_group(0, 0) != 0 { exit_child(126); return 126 }
            if redirect[0] != 0 {
                fd := open_file(addr(&redirect[0]), 1)
                if fd < 0 { exit_child(126); return 126 }
                duped := duplicate_fd(fd, 1)
                if duped < 0 { exit_child(126); return 126 }
                if fd > 2 { _ := close_fd(fd) }
            }
            if search_path { _ := execute_path(executable, arguments) }
            else { _ := execute(executable, arguments) }
            exit_child(127)
            return 127
        }
        mut wait_flags := if timeout_ms > 0 { 1 } else { 0 }
        mut timed_out := false
        while true {
            result := wait_child(pid, status_ptr, wait_flags)
            if result == pid { break }
            if result < 0 {
                if signal_child(pid, 0) != 0 { return 126 }
            }
            if wait_flags != 0 {
                current := milliseconds(platform)
                if current < 0 || current - start >= timeout_ms {
                    terminate_group(pid)
                    timed_out = true
                    wait_flags = 0
                } else { _ := sleep_us(250) }
            }
        }
        if timed_out { return 124 }
        return status_exit_code(status)
    }
    126
}

pub fn run(path: string, args: &[]string, timeout_ms: i64, platform: i32) -> i32 {
    run_impl(path, &args, timeout_ms, platform, false, "")
}
pub fn run_to_file(path: string, args: &[]string, timeout_ms: i64, platform: i32, output: string) -> i32 {
    run_impl(path, &args, timeout_ms, platform, false, output)
}
pub fn run_path(program: string, args: &[]string, timeout_ms: i64, platform: i32) -> i32 {
    run_impl(program, &args, timeout_ms, platform, true, "")
}

pub fn acquire_file_lock(path: string, timeout_ms: i64, platform: i32) -> i32 {
    if target_is("windows") {
        name := wide.path(path)
        unsafe { return win.lock_file(&name, timeout_ms) }
    } else { return posix_lock(path, timeout_ms, platform) }
    -1
}
fn posix_lock(path: string, timeout_ms: i64, platform: i32) -> i32 {
    mut bytes: []u8 = []; mut offsets: []i32 = []
    if !append_arg(&mut bytes, &mut offsets, path) { return -1 }
    unsafe {
        read_write_close_on_exec := if platform == 0 { 16777218 } else { 524290 }
        fd := open_file(addr(&bytes[0]), read_write_close_on_exec)
        if fd < 0 { return -1 }
        started := milliseconds(platform)
        if started < 0 { _ := close_fd(fd); return -1 }
        while lock_descriptor(fd, 6) != 0 {
            current := milliseconds(platform)
            if current < 0 || timeout_ms <= 0 || current - started >= timeout_ms { _ := close_fd(fd); return -1 }
            _ := sleep_us(10000)
        }
        return fd
    }
    -1
}
pub fn release_file_lock(fd: i32) {
    if fd < 0 { return }
    unsafe {
        if target_is("windows") { _ := win.close_fd(fd) }
        else { _ := lock_descriptor(fd, 8); _ := close_fd(fd) }
    }
}

fn status_exit_code(status: i32) -> i32 {
    signal := status.bit_and(127)
    if signal != 0 { return 128 + signal }
    status.shr(8).bit_and(255)
}

struct GroupOutput {
    data: []u8, offsets: []i32, lengths: []i32, next: []i32,
    head: []i32, tail: []i32,
}

fn append_chunk(output: &mut GroupOutput, group: i32, buf: &[u8; 4096], count: i32) {
    chunk := output.offsets.len
    output.offsets.push(output.data.len)
    output.lengths.push(count)
    output.next.push(-1)
    buffer.extend(&mut output.data, &buf[..count])
    if output.head[group] < 0 { output.head[group] = chunk }
    else { output.next[output.tail[group]] = chunk }
    output.tail[group] = chunk
}

unsafe fn drain_pipe_ready(fd: i32, group: i32, output: &mut GroupOutput) {
    mut buf: [u8; 4096] = [0; 4096]
    while true {
        mut pollfd: [i32; 2] = [fd, 1]
        ready := poll_fds(addr(&mut pollfd[0]), 1, 0)
        if ready <= 0 || pollfd[1].shr(16).bit_and(65535) == 0 { break }
        count := read_fd(fd, addr(&mut buf[0]), 4096)
        if count <= 0 { break }
        append_chunk(&mut output, group, &buf, i32(count))
    }
}

fn flush_group_output(output: &GroupOutput, group: i32) {
    mut chunk := output.head[group]
    while chunk >= 0 {
        mut offset := output.offsets[chunk]
        end := offset + output.lengths[chunk]
        unsafe {
            while offset < end {
                mut count := i64(0)
                if target_is("windows") { count = win.write(1, addr(&output.data[offset]), usize(end - offset)) }
                else { count = write_fd(1, addr(&output.data[offset]), usize(end - offset)) }
                if count <= 0 { break }
                offset += i32(count)
            }
        }
        chunk = output.next[chunk]
    }
}

pub fn tests_parallel(path: string, groups: &[]string, keys: &[]string, affected: bool, timeout_ms: i64, platform: i32, max_jobs: i32) -> i32 {
    if target_is("windows") { return tests_windows(path, &groups, &keys, affected, timeout_ms, platform, max_jobs) }
    else { return tests_posix(path, &groups, &keys, affected, timeout_ms, platform, max_jobs) }
}

fn tests_posix(path: string, groups: &[]string, keys: &[]string, affected: bool, timeout_ms: i64, platform: i32, max_jobs: i32) -> i32 {
    total := groups.len
    mut skipped := 0
    mut passed := 0
    mut failed := 0
    mut done: []bool = []
    mut skipped_flag: []bool = []
    mut codes: []i32 = []
    mut output := GroupOutput {data: [], offsets: [], lengths: [], next: [], head: [], tail: []}
    mut queue: []i32 = []
    for i in 0..total {
        codes.push(0)
        output.head.push(-1)
        output.tail.push(-1)
        if affected && i < keys.len && receipts.seen(keys[i]) {
            skipped += 1
            done.push(true)
            skipped_flag.push(true)
        } else {
            done.push(false)
            skipped_flag.push(false)
            queue.push(i)
        }
    }
    if queue.len == 0 {
        if affected { print(f"{skipped} unaffected") }
        print("0 passed, 0 failed")
        return 0
    }
    resolved_jobs := if max_jobs > 0 { max_jobs } else { budget.resolve_jobs(platform, 0, false, 0, true).jobs }
    max_slots := budget.test_process_slots(resolved_jobs, queue.len)
    child_jobs := budget.nested_child_jobs(resolved_jobs, max_slots)

    mut env_blob: []u8 = []
    mut env_offsets: []i32 = []
    mut env_ptrs: []ptr = []
    unsafe {
        prepare_test_env(child_jobs, &mut env_blob, &mut env_offsets)
        for off in &env_offsets { env_ptrs.push(addr(&env_blob[off])) }
        env_ptrs.push(ptr(0))
    }

    mut slot_pid: [i32; 64] = [-1; 64]
    mut slot_rfd: [i32; 64] = [-1; 64]
    mut slot_group: [i32; 64] = [-1; 64]
    mut slot_start: [i64; 64] = [0; 64]

    mut read_buf: [u8; 4096] = [0; 4096]

    mut active := 0
    mut next_q := 0
    mut cursor := 0

    while cursor < total {
        mut spawn_deferred := false
        for s in 0..max_slots {
            if slot_pid[s] >= 0 || next_q >= queue.len { continue }
            g := queue[next_q]
            next_q += 1
            mut arg_bytes: []u8 = []
            mut arg_offsets: []i32 = []
            if !append_arg(&mut arg_bytes, &mut arg_offsets, path) || !append_arg(&mut arg_bytes, &mut arg_offsets, g.str()) {
                codes[g] = 126
                done[g] = true
                continue
            }
            unsafe {
                mut pipe_fds: [i32; 2] = [-1; 2]
                mut pipe_rc := make_pipe(addr(&mut pipe_fds[0]))
                mut pipe_tries := 0
                while pipe_rc != 0 && active == 0 && pipe_tries < 200 {
                    _ := sleep_us(5000)
                    pipe_rc = make_pipe(addr(&mut pipe_fds[0]))
                    pipe_tries += 1
                }
                if pipe_rc != 0 {
                    if active > 0 {
                        spawn_deferred = true
                        next_q -= 1
                        break
                    }
                    codes[g] = 126
                    done[g] = true
                    continue
                }
                mut start_ms: i64 = 0
                if timeout_ms > 0 {
                    start_ms = milliseconds(platform)
                    if start_ms < 0 {
                        _ := close_fd(pipe_fds[0])
                        _ := close_fd(pipe_fds[1])
                        codes[g] = 126
                        done[g] = true
                        continue
                    }
                }
                mut argv: []ptr = []
                for offset in &arg_offsets { argv.push(addr(&arg_bytes[offset])) }
                argv.push(ptr(0))
                executable := argv[0]
                arguments := addr(&argv[0])
                mut pid := child_process()
                mut spawn_tries := 0
                while pid < 0 && active == 0 && spawn_tries < 200 {
                    _ := sleep_us(5000)
                    pid = child_process()
                    spawn_tries += 1
                }
                if pid < 0 {
                    _ := close_fd(pipe_fds[0])
                    _ := close_fd(pipe_fds[1])
                    if active > 0 {
                        spawn_deferred = true
                        next_q -= 1
                        break
                    }
                    codes[g] = 126
                    done[g] = true
                    continue
                }
                if pid == 0 {
                    if timeout_ms > 0 && process_group(0, 0) != 0 { exit_child(126) }
                    _ := close_fd(pipe_fds[0])
                    for k in 0..max_slots {
                        if slot_rfd[k] >= 0 { _ := close_fd(slot_rfd[k]) }
                    }
                    mut duped := duplicate_fd(pipe_fds[1], 1)
                    mut dup_tries := 0
                    while duped < 0 && dup_tries < 5 {
                        duped = duplicate_fd(pipe_fds[1], 1)
                        dup_tries += 1
                    }
                    if pipe_fds[1] > 2 { _ := close_fd(pipe_fds[1]) }
                    if duped < 0 { exit_child(126) }
                    _ := execute_env(executable, arguments, addr(&env_ptrs[0]))
                    exit_child(127)
                }
                _ := close_fd(pipe_fds[1])
                slot_pid[s] = pid
                slot_rfd[s] = pipe_fds[0]
                slot_group[s] = g
                slot_start[s] = start_ms
                active += 1
            }
        }

        while cursor < total && done[cursor] {
            if !skipped_flag[cursor] {
                code := codes[cursor]
                if cursor < keys.len { receipts.update(keys[cursor], code == 0) }
                flush_group_output(&output, cursor)
                if code == 0 {
                    passed += 1
                    print(f"PASS {groups[cursor]}")
                } else {
                    failed += 1
                    print(f"FAIL {groups[cursor]} (exit {code})")
                }
            }
            cursor += 1
        }
        if cursor == total { break }

        unsafe {
            mut pfds: [i32; 128] = [0; 128]
            mut pfd_slot: [i32; 64] = [0; 64]
            mut nfds := 0
            mut has_closed_pipe := false
            mut poll_ms := -1
            if timeout_ms > 0 {
                now_poll := milliseconds(platform)
                if now_poll < 0 { poll_ms = 0 }
                else {
                    for s in 0..max_slots {
                        if slot_pid[s] >= 0 {
                            rem := timeout_ms - (now_poll - slot_start[s])
                            mut rem32 := 0
                            if rem > 0 {
                                if rem > 60000 { rem32 = 60000 } else { rem32 = i32(rem) }
                            }
                            if poll_ms < 0 || rem32 < poll_ms { poll_ms = rem32 }
                        }
                    }
                    if poll_ms < 0 { poll_ms = 0 }
                }
            }
            for s in 0..max_slots {
                if slot_pid[s] >= 0 {
                    if slot_rfd[s] >= 0 {
                        pfds[nfds * 2] = slot_rfd[s]
                        pfds[nfds * 2 + 1] = 1
                        pfd_slot[nfds] = s
                        nfds += 1
                    } else {
                        has_closed_pipe = true
                    }
                }
            }
            if spawn_deferred && (poll_ms < 0 || poll_ms > 5) { poll_ms = 5 }
            if has_closed_pipe && (poll_ms < 0 || poll_ms > 1) { poll_ms = 1 }
            if nfds > 0 {
                _ := poll_fds(addr(&mut pfds[0]), u32(nfds), poll_ms)
                for pi in 0..nfds {
                    rev := pfds[pi * 2 + 1].shr(16).bit_and(65535)
                    if rev != 0 {
                        s := pfd_slot[pi]
                        g := slot_group[s]
                        n := read_fd(slot_rfd[s], addr(&mut read_buf[0]), 4096)
                        if n > 0 {
                            append_chunk(&mut output, g, &read_buf, i32(n))
                        } else if n == 0 {
                            _ := close_fd(slot_rfd[s])
                            slot_rfd[s] = -1
                        }
                    }
                }
            } else if poll_ms > 0 {
                _ := sleep_us(u32(poll_ms * 1000))
            }

            for s in 0..max_slots {
                if slot_pid[s] < 0 { continue }
                pid := slot_pid[s]
                g := slot_group[s]
                mut status := 0
                mut reaped := wait_child(pid, addr(&mut status), 1)
                if reaped == 0 && slot_rfd[s] < 0 {
                    _ := sleep_us(50)
                    reaped = wait_child(pid, addr(&mut status), 1)
                }
                if reaped == pid {
                    codes[g] = status_exit_code(status)
                } else if reaped < 0 {
                    if signal_child(pid, 0) == 0 { continue }
                    codes[g] = 126
                } else {
                    if timeout_ms <= 0 { continue }
                    now := milliseconds(platform)
                    if now >= 0 && now - slot_start[s] < timeout_ms { continue }
                    terminate_group(pid)
                    while true {
                        result := wait_child(pid, addr(&mut status), 0)
                        if result == pid || (result < 0 && signal_child(pid, 0) != 0) { break }
                    }
                    codes[g] = 124
                }
                if slot_rfd[s] >= 0 {
                    if reaped >= 0 { drain_pipe_ready(slot_rfd[s], g, &mut output) }
                    _ := close_fd(slot_rfd[s])
                    slot_rfd[s] = -1
                }
                done[g] = true
                slot_pid[s] = -1
                slot_group[s] = -1
                active -= 1
            }
        }
    }

    if affected { print(f"{skipped} unaffected") }
    print(f"{passed} passed, {failed} failed")
    if failed > 0 { return 1 }
    0
}

fn tests_windows(path: string, groups: &[]string, keys: &[]string, affected: bool, timeout_ms: i64, platform: i32, requested: i32) -> i32 {
    mut queue: []i32 = []; mut result: []i32 = []
    mut output := GroupOutput {data: [], offsets: [], lengths: [], next: [], head: [], tail: []}
    for i in 0..groups.len {
        output.head.push(-1); output.tail.push(-1)
        if affected && i < keys.len && receipts.seen(keys[i]) { result.push(-1) }
        else { queue.push(i); result.push(126) }
    }
    total := if requested > 0 { requested } else { budget.resolve_jobs(platform, 0, false, 0, true).jobs }
    slots := budget.test_process_slots(total, queue.len)
    mut cursor := 0
    if slots > 0 {
        mut active := 0
        mut group: [i32; 64] = [-1; 64]
        mut pipes: [i32; 64] = [-1; 64]; mut starts: [i64; 64] = [0; 64]
        names: []string = [budget.child_jobs_env()]
        values: []string = [budget.nested_child_jobs(total, slots).str()]
        unset: []bool = [false]
        streams := win.Streams { input: 0, output: 1, error_output: 0, output_path: "" }
        unsafe {
            mut processes: [ptr; 64] = [ptr(0); 64]; mut jobs: [ptr; 64] = [ptr(0); 64]
            env := win.environment(&names, &values, &unset, true, wide.path)
            mut buf: [u8; 4096] = [0; 4096]
            while cursor < queue.len || active > 0 {
                for s in 0..slots {
                    if group[s] >= 0 || cursor >= queue.len { continue }
                    g := queue[cursor]; cursor += 1
                    args: []string = [g.str()]
                    child := win.start(path, path, &args, "", &env, &streams, false, wide.path)
                    if child.error != 0 { continue }
                    group[s] = g; processes[s] = child.process; jobs[s] = child.job; pipes[s] = child.output
                    starts[s] = win.ticks(); active += 1
                }
                mut progress := false
                for s in 0..slots {
                    g := group[s]; if g < 0 { continue }
                    mut code := 126
                    mut waited := win.wait(processes[s], 0, &mut code)
                    if waited == 0 && timeout_ms > 0 && win.ticks() - starts[s] >= timeout_ms {
                        _ := win.kill(jobs[s], 124); _ := win.wait(processes[s], -1, &mut code)
                        code = 124; waited = 1
                    }
                    while true {
                        count := win.read(pipes[s], addr(&mut buf[0]), 4096)
                        if count <= 0 { break }
                        append_chunk(&mut output, g, &buf, i32(count)); progress = true
                        if waited == 0 { break }
                    }
                    if waited != 0 {
                        if waited > 0 { result[g] = code }
                        _ := win.close_fd(pipes[s]); win.close(processes[s]); win.close(jobs[s])
                        group[s] = -1; active -= 1; progress = true
                    }
                }
                if active > 0 && !progress { win.sleep(1) }
            }
        }
    }
    mut passed := 0; mut failed := 0
    for g in 0..groups.len {
        if result[g] == -1 { continue }
        if g < keys.len { receipts.update(keys[g], result[g] == 0) }
        flush_group_output(&output, g)
        if result[g] == 0 { passed += 1; print(f"PASS {groups[g]}") }
        else { failed += 1; print(f"FAIL {groups[g]} (exit {result[g]})") }
    }
    if affected { print(f"{groups.len - queue.len} unaffected") }
    print(f"{passed} passed, {failed} failed")
    if failed > 0 { 1 } else { 0 }
}
