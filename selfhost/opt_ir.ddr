// A temporary typed model for one scalar function. Node indices are stable
// until reset; source positions refer to the original token stream.
pub struct Function {
    supported: bool, root: i32, ret: i32, params: i32,
    kinds: []i32, types: []i32, left: []i32, right: []i32, third: []i32, next: []i32,
    values: []i64, locals: []i32, starts: []i32, effects: []i32, proofs: []i32,
    local_names: []string, local_types: []i32, local_mutable: []bool,
    local_param: []i32, local_at: []i32,
    visits: i32, rewrites: i32, budget_exhausted: bool,
}
pub fn new() -> Function {
    Function { supported: false, root: -1, ret: 0, params: 0,
        kinds: [], types: [], left: [], right: [], third: [], next: [], values: [],
        locals: [], starts: [], effects: [], proofs: [], local_names: [],
        local_types: [], local_mutable: [], local_param: [], local_at: [],
        visits: 0, rewrites: 0, budget_exhausted: false }
}
pub fn reset(f: &mut Function) {
    f.supported = false; f.root = -1; f.ret = 0; f.params = 0
    f.kinds.clear(); f.types.clear(); f.left.clear(); f.right.clear(); f.third.clear()
    f.next.clear(); f.values.clear(); f.locals.clear(); f.starts.clear()
    f.effects.clear(); f.proofs.clear(); f.local_names.clear(); f.local_types.clear()
    f.local_mutable.clear(); f.local_param.clear(); f.local_at.clear()
    f.visits = 0; f.rewrites = 0; f.budget_exhausted = false
}
