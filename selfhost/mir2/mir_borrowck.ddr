// Pass 2: Polonius-Lite CFG Borrow & Origin Checker over packed []u64 bitsets.
// Implements:
// - Backward MirLocal liveness with dropck (Drop(x) keeps O(x) live iff TF_DISPOSE; plain types may_dangle)
// - Bidirectional invariance (O_a <-> O_b) for nested origins behind &mut T / &mut FnMut
// - BB-entry-only contains[bb_entry][O] + intra-block streaming scratch matrix (fast compile guardrail)
// - Origin kill on full overwrite of non-borrowed mut local (mut r: &T rebinding)
// - Deref-chain alias & reborrow resolution (fixes S-3 & Cliff 1)
// - TwoPhaseMut reserve-vs-Call-activation conflict re-check
// - Ban on overwriting stored-borrow fields through &mut function parameters
// - Return `from` & RegionExit escape checks (fixes S-1, S-3, S-4, S-6, C-1, C-2, C-3).

import ..frontend.diagnostics as diag
import ..hir.hir_types as ht
import ..hir.hir_body as hb
import mir_body as mb
import mir_init as mi

enum AccessKind { Read, Write, Move, SharedRef, MutRef, TwoPhaseReserve }

fn bs_get(bits: &[]u64, base: i32, idx: i32) -> bool {
    bits[base + (idx / 64)].bit_and(u64(1).shl(idx % 64)) != u64(0)
}

fn bs_set(bits: &mut []u64, base: i32, idx: i32) {
    bits[base + (idx / 64)] = bits[base + (idx / 64)].bit_or(u64(1).shl(idx % 64))
}

fn bs_clear(bits: &mut []u64, base: i32, idx: i32) {
    bits[base + (idx / 64)] = bits[base + (idx / 64)].bit_and(u64(1).shl(idx % 64).bit_not())
}

fn bs_or_changed(dst: &mut []u64, dst_base: i32, src: &[]u64, src_base: i32, words: i32) -> bool {
    mut ch := false
    for w in 0..words {
        old := dst[dst_base + w]
        nw := old.bit_or(src[src_base + w])
        if nw != old { dst[dst_base + w] = nw; ch = true }
    }
    ch
}

fn bs_zero(bits: &mut []u64, base: i32, words: i32) {
    for w in 0..words { bits[base + w] = u64(0) }
}

fn bs_copy(dst: &mut []u64, dst_base: i32, src: &[]u64, src_base: i32, words: i32) {
    for w in 0..words { dst[dst_base + w] = src[src_base + w] }
}

fn has_any_nonempty(bits: &[]u64, words: i32) -> bool {
    for w in 0..words {
        if bits[w] != u64(0) { return true }
    }
    false
}

fn bs_copy_self(arr: &mut []u64, dst_base: i32, src_base: i32, words: i32) {
    for w in 0..words { arr[dst_base + w] = arr[src_base + w] }
}

fn bs_or_self_changed(arr: &mut []u64, dst_base: i32, src_base: i32, words: i32) -> bool {
    mut ch := false
    for w in 0..words {
        old := arr[dst_base + w]
        nw := old.bit_or(arr[src_base + w])
        if nw != old { arr[dst_base + w] = nw; ch = true }
    }
    ch
}

fn add_op_use(body: &mb.MirBody, op_id: i32, live: &mut []u64, base: i32) {
    if op_id < 0 || op_id >= body.ops.len { return }
    op := body.ops[op_id]
    if op.kind == .Const { return }
    add_place_use(&body, op.id, &mut live, base)
}

fn add_place_use(body: &mb.MirBody, place_id: i32, live: &mut []u64, base: i32) {
    if place_id < 0 || place_id >= body.places.len { return }
    pl := body.places[place_id]
    bs_set(&mut live, base, pl.local)
    for i in 0..pl.proj_len {
        pr := body.projs[pl.proj_start + i]
        if pr.kind == .Index && pr.index >= 0 && pr.index < body.locals.len {
            bs_set(&mut live, base, pr.index)
        }
    }
}

fn add_rvalue_uses(body: &mb.MirBody, rv_id: i32, live: &mut []u64, base: i32) {
    if rv_id < 0 || rv_id >= body.rvalues.len { return }
    rv := body.rvalues[rv_id]
    if rv.kind == .Use || rv.kind == .Unary || rv.kind == .Cast || rv.kind == .Len || rv.kind == .Discriminant {
        add_op_use(&body, rv.a, &mut live, base)
    } else if rv.kind == .Binary {
        add_op_use(&body, rv.a, &mut live, base)
        add_op_use(&body, rv.b, &mut live, base)
    } else if rv.kind == .Ref {
        add_place_use(&body, body.loans[rv.a].place, &mut live, base)
    } else if rv.kind == .Slice || rv.kind == .BytesView {
        add_place_use(&body, body.loans[rv.a].place, &mut live, base)
        for i in 0..rv.op_len { add_op_use(&body, body.call_args[rv.op_start + i], &mut live, base) }
    } else if rv.kind == .AddrOf {
        add_place_use(&body, rv.a, &mut live, base)
    } else if rv.kind == .Aggregate || rv.kind == .Closure {
        for i in 0..rv.op_len { add_op_use(&body, body.call_args[rv.op_start + i], &mut live, base) }
    }
}

fn step_liveness_stmt_back(body: &mb.MirBody, st: mb.MirStmt, live: &mut []u64, base: i32) {
    if st.kind == .Assign {
        pl := body.places[st.place]
        if pl.proj_len == 0 {
            bs_clear(&mut live, base, pl.local)
        } else {
            add_place_use(&body, st.place, &mut live, base)
        }
        add_rvalue_uses(&body, st.rvalue, &mut live, base)
    } else if st.kind == .StorageDead || st.kind == .SetDeferActive || st.kind == .SetUnwindTarget {
        bs_clear(&mut live, base, st.place)
    } else if st.kind == .SetDiscriminant {
        add_place_use(&body, st.place, &mut live, base)
    }
}

fn step_liveness_term_back(types: &ht.TypeTable, body: &mb.MirBody, tm: mb.MirTerm, live: &mut []u64, base: i32) {
    if tm.kind == .Return {
        bs_set(&mut live, base, 0)
    } else if tm.kind == .SwitchInt {
        add_op_use(&body, tm.place_or_op, &mut live, base)
    } else if tm.kind == .Call {
        dest := body.places[tm.place_or_op]
        if dest.proj_len == 0 { bs_clear(&mut live, base, dest.local) }
        else { add_place_use(&body, tm.place_or_op, &mut live, base) }
        if tm.call_kind == .Indirect { add_op_use(&body, tm.callee, &mut live, base) }
        for i in 0..tm.arg_len { add_op_use(&body, body.call_args[tm.arg_start + i], &mut live, base) }
    } else if tm.kind == .Drop {
        // dropck: Drop(x) marks O(x) live IFF ty(x) transitively has TF_DISPOSE.
        // Plain structs/views without TF_DISPOSE are may_dangle!
        pl := body.places[tm.place_or_op]
        if ht.has_dispose(&types, pl.ty) {
            bs_set(&mut live, base, pl.local)
        }
    }
}

struct Liveness {
    words: i32,
    live_in: []u64,
    live_out: []u64,
}

fn compute_liveness(types: &ht.TypeTable, body: &mb.MirBody) -> Liveness {
    n_bbs := body.blocks.len
    words := (body.locals.len + 63) / 64
    mut live_in: []u64 = []
    mut live_out: []u64 = []
    for _ in 0..(n_bbs * words) { live_in.push(u64(0)); live_out.push(u64(0)) }

    mut cur: []u64 = []
    for _ in 0..words { cur.push(u64(0)) }
    mut succs: []i32 = []

    mut changed := true
    while changed {
        changed = false
        mut bb := n_bbs - 1
        while bb >= 0 {
            base := bb * words
            bs_zero(&mut cur, 0, words)
            mb.term_succs(&body, bb, &mut succs)
            for si in 0..succs.len {
                _ := bs_or_changed(&mut cur, 0, &live_in, succs[si] * words, words)
            }
            if bs_or_changed(&mut live_out, base, &cur, 0, words) { changed = true }
            bs_copy(&mut cur, 0, &live_out, base, words)
            blk := body.blocks[bb]
            step_liveness_term_back(&types, &body, body.terms[blk.term_id], &mut cur, 0)
            mut si := blk.stmt_end - 1
            while si >= blk.stmt_start {
                step_liveness_stmt_back(&body, body.stmts[si], &mut cur, 0)
                si -= 1
            }
            if bs_or_changed(&mut live_in, base, &cur, 0, words) { changed = true }
            bb -= 1
        }
    }
    Liveness { words: words, live_in: move live_in, live_out: move live_out }
}

// Resolve the starting origin slot (within place.local's local_origins) for a place.
// Returns (origin_start_in_local, origin_count_of_place).
struct PlaceOriginSlice {
    start_slot: i32,
    count: i32,
}

fn place_origin_slice(types: &ht.TypeTable, body: &mb.MirBody, place_id: i32) -> PlaceOriginSlice {
    pl := body.places[place_id]
    mut cur_ty := body.locals[pl.local].ty
    mut slot := 0
    mut downcast_var := -1
    for i in 0..pl.proj_len {
        pr := body.projs[pl.proj_start + i]
        if pr.kind == .Deref {
            k := types.entries[cur_ty].kind
            if k == .Ref || k == .MutRef {
                // Slot 0 is the reference's own origin; slots 1.. are the pointee's origins!
                slot += 1
                cur_ty = types.entries[cur_ty].inner_a
            } else {
                return PlaceOriginSlice { start_slot: -1, count: 0 }
            }
            downcast_var = -1
        } else if pr.kind == .Downcast {
            downcast_var = pr.index
        } else if pr.kind == .Field {
            if downcast_var >= 0 {
                v := &types.variants[types.entries[cur_ty].inner_a + downcast_var]
                fslot := types.fields[v.payload_start + pr.index].origin_slot
                cur_ty = types.fields[v.payload_start + pr.index].ty
                downcast_var = -1
                if fslot < 0 { return PlaceOriginSlice { start_slot: -1, count: 0 } }
                slot += fslot
            } else {
                fslot := ht.field_origin_slot(&types, cur_ty, pr.index)
                cur_ty = ht.field_type(&types, cur_ty, pr.index)
                if fslot < 0 { return PlaceOriginSlice { start_slot: -1, count: 0 } }
                slot += fslot
            }
        } else if pr.kind == .Index {
            k := types.entries[cur_ty].kind
            if k == .FatSlice || k == .RegionSlice {
                slot += 1
                cur_ty = types.entries[cur_ty].inner_a
            } else if k == .Array || k == .FixedArr {
                cur_ty = types.entries[cur_ty].inner_a
            } else {
                return PlaceOriginSlice { start_slot: -1, count: 0 }
            }
            downcast_var = -1
        }
    }
    PlaceOriginSlice { start_slot: slot, count: ht.origin_count(&types, pl.ty) }
}

fn push_edge(edges: &mut []mb.OutlivesEdge, from_o: i32, to_o: i32, bb: i32, stmt_idx: i32, bidir: bool) {
    if from_o < 0 || to_o < 0 || from_o == to_o { return }
    edges.push(mb.OutlivesEdge {
        from_origin: from_o,
        to_origin: to_o,
        bb: bb,
        stmt_idx: stmt_idx,
        bidirectional: bidir,
    })
}

fn emit_place_to_place_edges(types: &ht.TypeTable, body: &mb.MirBody,
    src_place: i32, dst_place: i32, bb: i32, stmt_idx: i32, edges: &mut []mb.OutlivesEdge) {
    src_sl := place_origin_slice(&types, &body, src_place)
    dst_sl := place_origin_slice(&types, &body, dst_place)
    if src_sl.start_slot < 0 || dst_sl.start_slot < 0 { return }
    cnt := if src_sl.count < dst_sl.count { src_sl.count } else { dst_sl.count }
    dst_ty := body.places[dst_place].ty
    invar := ht.is_invariant_container(&types, dst_ty)
    for k in 0..cnt {
        so := mb.local_origin_at(&body, body.places[src_place].local, src_sl.start_slot + k)
        do := mb.local_origin_at(&body, body.places[dst_place].local, dst_sl.start_slot + k)
        // Slot 0 of &mut T is covariant (ref lifetime itself); slots >= 1 inside &mut T are INVARIANT!
        bidir := invar && k >= 1
        push_edge(&mut edges, so, do, bb, stmt_idx, bidir)
    }
}

fn collect_reborrow_dep_origins(types: &ht.TypeTable, body: &mb.MirBody, place_id: i32, include_final_slice: bool) -> []i32 {
    mut deps: []i32 = []
    pl := body.places[place_id]
    mut cur_ty := body.locals[pl.local].ty
    mut slot := 0
    mut downcast_var := -1
    mut slot_valid := true
    for i in 0..pl.proj_len {
        pr := body.projs[pl.proj_start + i]
        if pr.kind == .Deref {
            k := types.entries[cur_ty].kind
            if k == .Ref {
                // Shared Ref is Copy: dereferencing reborrows from its own referent origin!
                deps.clear()
                if slot_valid {
                    o := mb.local_origin_at(&body, pl.local, slot)
                    if o >= 0 { deps.push(o) }
                }
                slot += 1
                cur_ty = types.entries[cur_ty].inner_a
            } else if k == .MutRef {
                // MutRef is non-Copy: reborrow transitively depends on this origin and any outer indirections!
                if slot_valid {
                    o := mb.local_origin_at(&body, pl.local, slot)
                    if o >= 0 { deps.push(o) }
                }
                slot += 1
                cur_ty = types.entries[cur_ty].inner_a
            } else {
                slot_valid = false
                break
            }
            downcast_var = -1
        } else if pr.kind == .Downcast {
            downcast_var = pr.index
        } else if pr.kind == .Field {
            if downcast_var >= 0 {
                v := &types.variants[types.entries[cur_ty].inner_a + downcast_var]
                fslot := types.fields[v.payload_start + pr.index].origin_slot
                cur_ty = types.fields[v.payload_start + pr.index].ty
                downcast_var = -1
                if fslot < 0 { slot_valid = false }
                else if slot_valid { slot += fslot }
            } else {
                fslot := ht.field_origin_slot(&types, cur_ty, pr.index)
                cur_ty = ht.field_type(&types, cur_ty, pr.index)
                if fslot < 0 { slot_valid = false }
                else if slot_valid { slot += fslot }
            }
        } else if pr.kind == .Index {
            k := types.entries[cur_ty].kind
            if k == .FatSlice || k == .RegionSlice {
                deps.clear()
                if slot_valid {
                    o := mb.local_origin_at(&body, pl.local, slot)
                    if o >= 0 { deps.push(o) }
                }
                slot += 1
                cur_ty = types.entries[cur_ty].inner_a
            } else if k == .FatStr {
                deps.clear()
                if slot_valid {
                    o := mb.local_origin_at(&body, pl.local, slot)
                    if o >= 0 { deps.push(o) }
                }
                slot_valid = false
                cur_ty = ht.TY_U8
            } else if k == .Array || k == .FixedArr {
                cur_ty = types.entries[cur_ty].inner_a
            } else if k == .String {
                cur_ty = ht.TY_U8
            } else {
                slot_valid = false
                break
            }
            downcast_var = -1
        }
    }
    if include_final_slice && slot_valid {
        k := types.entries[cur_ty].kind
        if k == .FatSlice || k == .FatStr || k == .RegionSlice {
            deps.clear()
            o := mb.local_origin_at(&body, pl.local, slot)
            if o >= 0 { deps.push(o) }
        }
    }
    deps
}

fn collect_all_edges(types: &ht.TypeTable, body: &mb.MirBody) -> []mb.OutlivesEdge {
    mut edges: []mb.OutlivesEdge = []
    for i in 0..body.outlives.len { edges.push(body.outlives[i]) }

    for bb in 0..body.blocks.len {
        blk := body.blocks[bb]
        for si in blk.stmt_start..blk.stmt_end {
            rel := si - blk.stmt_start
            st := body.stmts[si]
            if st.kind != .Assign { continue }
            rv := body.rvalues[st.rvalue]
            dst_pl := st.place
            dst_sl := place_origin_slice(&types, &body, dst_pl)
            dst_loc := body.places[dst_pl].local
            if rv.kind == .Use || rv.kind == .Cast {
                op := body.ops[rv.a]
                if op.kind != .Const {
                    emit_place_to_place_edges(&types, &body, op.id, dst_pl, bb, rel, &mut edges)
                }
            } else if rv.kind == .Ref {
                ln := body.loans[rv.a]
                if dst_sl.start_slot >= 0 && dst_sl.count > 0 {
                    do0 := mb.local_origin_at(&body, dst_loc, dst_sl.start_slot)
                    push_edge(&mut edges, ln.origin, do0, bb, rel, false)
                    // V2-S2: Transitively propagate dereferenced/indexed source origin(s) into new borrow!
                    deps := collect_reborrow_dep_origins(&types, &body, ln.place, false)
                    for di in 0..deps.len {
                        push_edge(&mut edges, deps[di], do0, bb, rel, false)
                    }
                    // Propagate nested origins of borrowed place into slots 1.. of dst (&T covariant, &mut T INVARIANT!).
                    src_sl := place_origin_slice(&types, &body, ln.place)
                    if src_sl.start_slot >= 0 && src_sl.count > 0 {
                        invar := ht.is_invariant_container(&types, body.places[dst_pl].ty)
                        for k in 0..src_sl.count {
                            if 1 + k < dst_sl.count {
                                so := mb.local_origin_at(&body, body.places[ln.place].local, src_sl.start_slot + k)
                                do_k := mb.local_origin_at(&body, dst_loc, dst_sl.start_slot + 1 + k)
                                push_edge(&mut edges, so, do_k, bb, rel, invar)
                            }
                        }
                    }
                }
            } else if rv.kind == .Slice || rv.kind == .BytesView {
                ln := body.loans[rv.a]
                if dst_sl.start_slot >= 0 && dst_sl.count > 0 {
                    do0 := mb.local_origin_at(&body, dst_loc, dst_sl.start_slot)
                    push_edge(&mut edges, ln.origin, do0, bb, rel, false)
                    // V2-S2: Transitively propagate dereferenced/sliced source origin(s) into new slice/view!
                    deps := collect_reborrow_dep_origins(&types, &body, ln.place, true)
                    for di in 0..deps.len {
                        push_edge(&mut edges, deps[di], do0, bb, rel, false)
                    }
                }
            } else if rv.kind == .Aggregate {
                agg_ty := rv.ty
                ak := types.entries[agg_ty].kind
                if dst_sl.start_slot >= 0 && (ak == .Struct || ak == .Tuple || ak == .Enum) {
                    for i in 0..rv.op_len {
                        op := body.ops[body.call_args[rv.op_start + i]]
                        if op.kind == .Const { continue }
                        fslot := if ak == .Enum {
                            types.fields[types.variants[types.entries[agg_ty].inner_a + rv.a].payload_start + i].origin_slot
                        } else {
                            ht.field_origin_slot(&types, agg_ty, i)
                        }
                        if fslot < 0 { continue }
                        src_sl := place_origin_slice(&types, &body, op.id)
                        if src_sl.start_slot < 0 { continue }
                        for k in 0..src_sl.count {
                            so := mb.local_origin_at(&body, body.places[op.id].local, src_sl.start_slot + k)
                            do_k := mb.local_origin_at(&body, dst_loc, dst_sl.start_slot + fslot + k)
                            push_edge(&mut edges, so, do_k, bb, rel, false)
                        }
                    }
                }
            } else if rv.kind == .Closure {
                cl_ty := rv.ty
                if dst_sl.start_slot >= 0 {
                    borrowed := ht.has_flag(&types, cl_ty, ht.TF_CLOSURE_BORROWED)
                    invar := ht.is_invariant_container(&types, cl_ty)
                    for i in 0..rv.op_len {
                        op := body.ops[body.call_args[rv.op_start + i]]
                        if op.kind == .Const { continue }
                        src_sl := place_origin_slice(&types, &body, op.id)
                        if src_sl.start_slot < 0 { continue }
                        fslot := ht.field_origin_slot(&types, cl_ty, i)
                        for k in 0..src_sl.count {
                            so := mb.local_origin_at(&body, body.places[op.id].local, src_sl.start_slot + k)
                            if borrowed && dst_sl.count > 0 {
                                do0 := mb.local_origin_at(&body, dst_loc, dst_sl.start_slot)
                                push_edge(&mut edges, so, do0, bb, rel, invar)
                            }
                            if fslot >= 0 && fslot + k < dst_sl.count {
                                do_k := mb.local_origin_at(&body, dst_loc, dst_sl.start_slot + fslot + k)
                                push_edge(&mut edges, so, do_k, bb, rel, invar)
                            }
                        }
                    }
                }
            }
        }

        // Terminator Call `from_edges` (including PARAM_ENV for closures returning borrows!)
        tm := body.terms[blk.term_id]
        if tm.kind == .Call && tm.sig_ty >= 0 && tm.sig_ty < types.entries.len {
            sig := &types.entries[tm.sig_ty]
            dst_pl := tm.place_or_op
            dst_sl := place_origin_slice(&types, &body, dst_pl)
            dst_loc := body.places[dst_pl].local
            if dst_sl.start_slot >= 0 && dst_sl.count > 0 {
                for fi in 0..sig.from_len {
                    fe := types.from_edges[sig.from_start + fi]
                    mut src_op_id := -1
                    if fe.param_idx == ht.PARAM_ENV && tm.call_kind == .Indirect {
                        src_op_id = tm.callee
                    } else if fe.param_idx >= 0 && fe.param_idx < tm.arg_len {
                        src_op_id = body.call_args[tm.arg_start + fe.param_idx]
                    }
                    if src_op_id < 0 || src_op_id >= body.ops.len { continue }
                    op := body.ops[src_op_id]
                    if op.kind == .Const { continue }
                    src_sl := place_origin_slice(&types, &body, op.id)
                    if src_sl.start_slot < 0 { continue }
                    do_r := mb.local_origin_at(&body, dst_loc, dst_sl.start_slot + fe.ret_slot)
                    if fe.field_slot >= 0 {
                        // Project specific field origin slot (e.g. `from self.text` on Graphemes::next(&mut self)):
                        // If arg is &mut Self / &Self, Self's field slot is at 1 + field_slot!
                        arg_ty := body.places[op.id].ty
                        offset := if types.entries[arg_ty].kind == .Ref || types.entries[arg_ty].kind == .MutRef {
                            1 + fe.field_slot
                        } else {
                            fe.field_slot
                        }
                        if offset < src_sl.count {
                            so := mb.local_origin_at(&body, body.places[op.id].local, src_sl.start_slot + offset)
                            push_edge(&mut edges, so, do_r, bb, -1, false)
                        }
                    } else {
                        for k in 0..src_sl.count {
                            so := mb.local_origin_at(&body, body.places[op.id].local, src_sl.start_slot + k)
                            push_edge(&mut edges, so, do_r, bb, -1, false)
                        }
                    }
                }
            }
        }
    }
    edges
}

fn close_edges(cur: &mut []u64, nonempty: &mut []u64, bb_edges: &[]mb.OutlivesEdge,
    edge_start: i32, edge_end: i32, stmt_idx: i32, loan_words: i32,
    bidir_edges: &[]mb.OutlivesEdge) {
    if edge_start >= edge_end && bidir_edges.len == 0 { return }
    mut changed := true
    while changed {
        changed = false
        for i in edge_start..edge_end {
            e := bb_edges[i]
            if e.stmt_idx == stmt_idx {
                if bs_get(&nonempty, 0, e.from_origin) {
                    if bs_or_self_changed(&mut cur, e.to_origin * loan_words, e.from_origin * loan_words, loan_words) {
                        bs_set(&mut nonempty, 0, e.to_origin)
                        changed = true
                    }
                }
                if e.bidirectional && bs_get(&nonempty, 0, e.to_origin) {
                    if bs_or_self_changed(&mut cur, e.from_origin * loan_words, e.to_origin * loan_words, loan_words) {
                        bs_set(&mut nonempty, 0, e.from_origin)
                        changed = true
                    }
                }
            }
        }
        // Always propagate across previously established bidirectional invariance equalities!
        for i in 0..bidir_edges.len {
            e := bidir_edges[i]
            if bs_get(&nonempty, 0, e.from_origin) {
                if bs_or_self_changed(&mut cur, e.to_origin * loan_words, e.from_origin * loan_words, loan_words) {
                    bs_set(&mut nonempty, 0, e.to_origin)
                    changed = true
                }
            }
            if bs_get(&nonempty, 0, e.to_origin) {
                if bs_or_self_changed(&mut cur, e.from_origin * loan_words, e.to_origin * loan_words, loan_words) {
                    bs_set(&mut nonempty, 0, e.from_origin)
                    changed = true
                }
            }
        }
    }
}

fn copy_sparse_rows(dst: &mut []u64, dst_nonempty: &mut []u64,
    src: &[]u64, src_mat_base: i32, src_nonempty: &[]u64, src_ne_base: i32,
    origin_words: i32, loan_words: i32) {
    for w in 0..origin_words {
        // Clear any rows currently set in dst that won't be overwritten
        mut clr := dst_nonempty[w].bit_and(src_nonempty[src_ne_base + w].bit_not())
        if clr != u64(0) {
            base_o := w * 64
            mut b := 0
            while clr != u64(0) {
                if clr.bit_and(u64(1)) != u64(0) {
                    bs_zero(&mut dst, (base_o + b) * loan_words, loan_words)
                }
                clr = clr.shr(1); b += 1
            }
        }
        mut cp := src_nonempty[src_ne_base + w]
        dst_nonempty[w] = cp
        if cp != u64(0) {
            base_o := w * 64
            mut b := 0
            while cp != u64(0) {
                if cp.bit_and(u64(1)) != u64(0) {
                    off := (base_o + b) * loan_words
                    bs_copy(&mut dst, off, &src, src_mat_base + off, loan_words)
                }
                cp = cp.shr(1); b += 1
            }
        }
    }
}

fn merge_sparse_rows_changed(dst: &mut []u64, dst_mat_base: i32, dst_nonempty: &mut []u64, dst_ne_base: i32,
    src: &[]u64, src_nonempty: &[]u64, origin_words: i32, loan_words: i32) -> bool {
    mut ch := false
    for w in 0..origin_words {
        mut bits := src_nonempty[w]
        if bits == u64(0) { continue }
        dst_nonempty[dst_ne_base + w] = dst_nonempty[dst_ne_base + w].bit_or(bits)
        base_o := w * 64
        mut b := 0
        while bits != u64(0) {
            if bits.bit_and(u64(1)) != u64(0) {
                off := (base_o + b) * loan_words
                if bs_or_changed(&mut dst, dst_mat_base + off, &src, off, loan_words) {
                    ch = true
                }
            }
            bits = bits.shr(1); b += 1
        }
    }
    ch
}

fn prune_dead_origins(cur: &mut []u64, nonempty: &mut []u64, live_origins: &[]u64,
    origin_words: i32, loan_words: i32) {
    for w in 0..origin_words {
        mut dead := nonempty[w].bit_and(live_origins[w].bit_not())
        if dead == u64(0) { continue }
        nonempty[w] = nonempty[w].bit_and(live_origins[w])
        base_o := w * 64
        mut b := 0
        while dead != u64(0) {
            if dead.bit_and(u64(1)) != u64(0) {
                bs_zero(&mut cur, (base_o + b) * loan_words, loan_words)
            }
            dead = dead.shr(1)
            b += 1
        }
    }
}

// Two places overlap if they share the same root local and neither diverges on distinct struct fields
// or distinct enum variants. Index(*) conservatively overlaps all sibling indices.
fn places_overlap(body: &mb.MirBody, pa_id: i32, pb_id: i32) -> bool {
    pa := body.places[pa_id]
    pb := body.places[pb_id]
    if pa.local != pb.local { return false }
    min_len := if pa.proj_len < pb.proj_len { pa.proj_len } else { pb.proj_len }
    for i in 0..min_len {
        a := body.projs[pa.proj_start + i]
        b := body.projs[pb.proj_start + i]
        if a.kind == .Field && b.kind == .Field {
            if a.index != b.index { return false }
        } else if a.kind == .Downcast && b.kind == .Downcast {
            if a.index != b.index { return false }
        } else if a.kind == .Index || b.kind == .Index {
            // Wildcard index conservatively overlaps
            return true
        }
    }
    true
}

fn is_mut_ref_local(types: &ht.TypeTable, body: &mb.MirBody, local: i32) -> bool {
    if local < 0 || local >= body.locals.len { return false }
    types.entries[body.locals[local].ty].kind == .MutRef
}

fn starts_with_deref(body: &mb.MirBody, place_id: i32) -> bool {
    pl := body.places[place_id]
    pl.proj_len > 0 && body.projs[pl.proj_start].kind == .Deref
}

fn is_write_access(k: AccessKind) -> bool {
    k == .Write || k == .Move || k == .MutRef || k == .TwoPhaseReserve
}

fn compute_live_origins(body: &mb.MirBody, origin_locals: &[]i32, live_locals: &[]u64, local_base: i32,
    ext_origins: &[]u64, origin_words: i32, out_origins: &mut []u64) {
    bs_copy(&mut out_origins, 0, &ext_origins, 0, origin_words)
    for idx in 0..origin_locals.len {
        l := origin_locals[idx]
        if bs_get(&live_locals, local_base, l) {
            o_start := body.locals[l].origin_start
            o_len := body.locals[l].origin_len
            for k in 0..o_len {
                bs_set(&mut out_origins, 0, body.local_origins[o_start + k])
            }
        }
    }
}

fn compute_active_loans(cur_contains: &[]u64, nonempty: &[]u64, live_origins: &[]u64,
    origin_words: i32, loan_words: i32, out_loans: &mut []u64) {
    bs_zero(&mut out_loans, 0, loan_words)
    for w in 0..origin_words {
        mut bits := live_origins[w].bit_and(nonempty[w])
        if bits == u64(0) { continue }
        base_o := w * 64
        mut b := 0
        while bits != u64(0) {
            if bits.bit_and(u64(1)) != u64(0) {
                _ := bs_or_changed(&mut out_loans, 0, &cur_contains, (base_o + b) * loan_words, loan_words)
            }
            bits = bits.shr(1)
            b += 1
        }
    }
}

fn check_single_access(types: &ht.TypeTable, body: &mb.MirBody, cur_contains: &[]u64,
    active_loans: &[]u64, live_origins: &[]u64, loan_def_origin: &[]i32,
    loan_words: i32, bb: i32, activating_two_phase: i32,
    access_place: i32, kind: AccessKind, span_s: i32, span_e: i32,
    diags: &mut []diag.Diagnostic) -> bool {
    n_loans := body.loans.len
    if n_loans == 0 { return true }
    ap := body.places[access_place]
    mut ok := true

    // Determine if access_place dereferences a &mut local `r` (reborrow / write through *r)
    deref_mut := starts_with_deref(&body, access_place) && is_mut_ref_local(&types, &body, ap.local)
    // Determine if access_place passes/mutates a &mut local `r` directly (e.g. grow(&mut r) — S-3!)
    direct_mut_alias := !deref_mut && is_mut_ref_local(&types, &body, ap.local) && is_write_access(kind)
    r_origin := if deref_mut || direct_mut_alias { mb.local_origin_at(&body, ap.local, 0) } else { -1 }

    for lw in 0..loan_words {
        mut aw := active_loans[lw]
        if aw == u64(0) { continue }
        base_li := lw * 64
        mut lb := 0
        while aw != u64(0) {
            bit_set := aw.bit_and(u64(1)) != u64(0)
            aw = aw.shr(1)
            li := base_li + lb
            lb += 1
            if !bit_set || li >= n_loans { continue }
            if li == activating_two_phase { continue }
            ln := body.loans[li]

        // If `r` holds loan `li`:
        if r_origin >= 0 && bs_get(&cur_contains, r_origin * loan_words, li) {
            if deref_mut {
                // Reborrowing or mutating through `*r` (its own &mut loan) is ALLOWED (Cliff 1)!
                if ln.kind == .Shared && is_write_access(kind) {
                    hb.push_error(&mut diags, "E4003", body.path, span_s, span_e,
                        "cannot mutate through shared borrow")
                    ok = false
                }
                continue
            }
            if direct_mut_alias {
                // Passing `&mut r` (e.g. `grow(&mut r)`) does NOT conflict with `r`'s own underlying loan `li`,
                // BUT we check `li.place` against ALL OTHER active loans below!
                continue
            }
        }

        // Compute effective overlap: direct place overlap OR alias-target overlap (S-3)!
        mut overlaps := places_overlap(&body, access_place, ln.place)
        if !overlaps && r_origin >= 0 {
            // Check whether ANY loan held by `r` overlaps `ln.place`!
            for rli in 0..n_loans {
                if bs_get(&cur_contains, r_origin * loan_words, rli) {
                    if places_overlap(&body, body.loans[rli].place, ln.place) {
                        overlaps = true
                        break
                    }
                }
            }
        }
        // Also check reverse: if `ln.place` itself starts with Deref of a &mut local `q`,
        // does `access_place` overlap any loan held by `q` (e.g. `ln` is `&r[0]` and `access_place` is `v`)?
        if !overlaps && starts_with_deref(&body, ln.place) && is_mut_ref_local(&types, &body, body.places[ln.place].local) {
            q_origin := mb.local_origin_at(&body, body.places[ln.place].local, 0)
            if q_origin >= 0 {
                for qli in 0..n_loans {
                    if bs_get(&cur_contains, q_origin * loan_words, qli) {
                        if places_overlap(&body, access_place, body.loans[qli].place) {
                            overlaps = true
                            break
                        }
                    }
                }
            }
        }

        if !overlaps { continue }

        // TwoPhaseMut rules: strictly while the reserving arg temp is still live (before Call activation),
        // Read & SharedRef are allowed; Write, Move, MutRef, and a second TwoPhaseReserve are REJECTED!
        // Once the Call activates and its arg temp dies, any surviving loan is a full exclusive Mut loan.
        if ln.kind == .TwoPhaseMut && activating_two_phase < 0 &&
            li < loan_def_origin.len && loan_def_origin[li] >= 0 && bs_get(&live_origins, 0, loan_def_origin[li]) {
            if kind == .Read || kind == .SharedRef { continue }
            hb.push_error(&mut diags, "E4003", body.path, span_s, span_e,
                "cannot mutate or borrow mutably while two-phase mutable borrow is reserved")
            ok = false
            continue
        }

        // Standard conflict rule: exclusive loan conflicts with any access; shared loan conflicts with write/move/mut-ref.
        if ln.kind == .Mut || ln.kind == .TwoPhaseMut || is_write_access(kind) {
            hb.push_error(&mut diags, "E4003", body.path, span_s, span_e,
                "cannot access or mutate '" + body.locals[ap.local].name + "' while it is borrowed")
            ok = false
        }
        }
    }
    ok
}

fn check_operand_access(types: &ht.TypeTable, body: &mb.MirBody, cur_contains: &[]u64,
    active_loans: &[]u64, live_origins: &[]u64, loan_def_origin: &[]i32,
    loan_words: i32, bb: i32, op_id: i32,
    span_s: i32, span_e: i32, diags: &mut []diag.Diagnostic) -> bool {
    if op_id < 0 || op_id >= body.ops.len { return true }
    op := body.ops[op_id]
    if op.kind == .Const { return true }
    ak: AccessKind = if op.kind == .Move && !ht.is_copy(&types, body.places[op.id].ty) { .Move } else { .Read }
    check_single_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, -1, op.id, ak, span_s, span_e, &mut diags)
}

struct SynParamLoan {
    param_idx: i32,     // 0..param_count-1, or ht.PARAM_ENV (-1) for closure captures
    field_slot: i32,    // -1 for whole param/ref, or stored-borrow field origin slot (>= 0)
    origin: i32,
}

fn check_place_mutable(types: &ht.TypeTable, body: &mb.MirBody, place_id: i32, is_write_stmt: bool) -> bool {
    pl := body.places[place_id]
    mut cur_ty := body.locals[pl.local].ty
    mut saw_deref := false
    mut downcast_var := -1
    for i in 0..pl.proj_len {
        pr := body.projs[pl.proj_start + i]
        if pr.kind == .Deref {
            k := types.entries[cur_ty].kind
            if k == .Ref || k == .RawConst { return false }
            saw_deref = true
            cur_ty = types.entries[cur_ty].inner_a
            downcast_var = -1
        } else if pr.kind == .Downcast {
            downcast_var = pr.index
        } else if pr.kind == .Field {
            if downcast_var >= 0 {
                cur_ty = ht.variant_payload_type(&types, cur_ty, downcast_var, pr.index)
                downcast_var = -1
            } else {
                cur_ty = ht.field_type(&types, cur_ty, pr.index)
            }
        } else if pr.kind == .Index {
            k := types.entries[cur_ty].kind
            if k == .FatSlice || k == .FatStr { return false }
            if k == .Array || k == .FixedArr || k == .RegionSlice {
                cur_ty = types.entries[cur_ty].inner_a
            } else if k == .String {
                cur_ty = ht.TY_U8
            }
            downcast_var = -1
        }
    }
    if saw_deref { return true }
    if pl.local == 0 { return true }
    fl := body.locals[pl.local].flags
    if fl.bit_and(mb.LF_MUT) != 0 || fl.bit_and(mb.LF_TEMP) != 0 ||
        fl.bit_and(mb.LF_DROP_FLAG) != 0 || fl.bit_and(mb.LF_DEFER_FLAG) != 0 {
        return true
    }
    if !is_write_stmt && pl.proj_len == 0 && cur_ty >= 0 && cur_ty < types.entries.len &&
        types.entries[cur_ty].kind == .ClosureEnv && ht.has_flag(&types, cur_ty, ht.TF_CLOSURE_MUT) {
        return true
    }
    if is_write_stmt {
        if pl.proj_len > 0 { return false }
        if fl.bit_and(mb.LF_PARAM) != 0 { return false }
        return true
    }
    false
}

fn match_from_edges(types: &ht.TypeTable, body: &mb.MirBody, param_idx: i32, field_slot: i32,
    ret_slot: i32, borrow_param_count: i32, single_borrow_param: i32) -> bool {
    if body.sig_ty >= 0 && body.sig_ty < types.entries.len {
        sig := &types.entries[body.sig_ty]
        if sig.from_len > 0 {
            mut has_explicit_ret := false
            for fi in 0..sig.from_len {
                if types.from_edges[sig.from_start + fi].ret_slot > 0 { has_explicit_ret = true; break }
            }
            for fi in 0..sig.from_len {
                fe := types.from_edges[sig.from_start + fi]
                if fe.param_idx != param_idx { continue }
                if fe.field_slot >= 0 && fe.field_slot != field_slot { continue }
                if has_explicit_ret && fe.ret_slot != ret_slot { continue }
                return true
            }
            return false
        }
    }
    // Elision with no explicit `from`: ONLY valid when there is at most one borrow-bearing parameter!
    if param_idx == ht.PARAM_ENV { return false }
    borrow_param_count == 1 && param_idx == single_borrow_param
}

fn is_allowed_return_real_loan(types: &ht.TypeTable, body: &mb.MirBody, loan_id: i32,
    ret_slot: i32, borrow_param_count: i32, single_borrow_param: i32) -> bool {
    ln := body.loans[loan_id]
    root := body.places[ln.place].local
    if root < 1 || root > body.param_count { return false }
    fl := body.locals[root].flags
    if fl.bit_and(mb.LF_PARAM) == 0 { return false }
    // V2-S4: Never allow borrowing a Copy or Move by-value stack parameter slot!
    if fl.bit_and(mb.LF_MOVE_PARAM) != 0 { return false }
    if ht.is_copy(&types, body.locals[root].ty) { return false }
    match_from_edges(&types, &body, root - 1, -1, ret_slot, borrow_param_count, single_borrow_param)
}

pub fn check_borrows(types: &ht.TypeTable, body: &mb.MirBody, init: &mi.InitState, diags: &mut []diag.Diagnostic) -> bool {
    n_bbs := body.blocks.len
    n_origins := body.origin_count
    n_loans := body.loans.len

    // V2-S1: Always enforce place mutability even when a function has 0 origins and 0 loans!
    if n_origins == 0 && n_loans == 0 {
        mut ok0 := true
        for bb in 0..n_bbs {
            if !init.reachable[bb] { continue }
            blk := body.blocks[bb]
            for si in blk.stmt_start..blk.stmt_end {
                st := body.stmts[si]
                if st.kind == .Assign && !check_place_mutable(&types, &body, st.place, true) {
                    hb.push_error(&mut diags, "E4002", body.path, st.span_start, st.span_end,
                        "cannot mutate immutable binding, field, or shared borrow")
                    ok0 = false
                }
            }
            tm := body.terms[blk.term_id]
            if tm.kind == .Call && !check_place_mutable(&types, &body, tm.place_or_op, true) {
                hb.push_error(&mut diags, "E4002", body.path, tm.span_start, tm.span_end,
                    "cannot mutate immutable binding, field, or shared borrow")
                ok0 = false
            }
        }
        return ok0
    }

    // V2-S3: Build synthetic parameter loans for every borrow-bearing parameter (and field origin slots),
    // plus PARAM_ENV loans for closure capture locals!
    mut syn_loans: []SynParamLoan = []
    mut borrow_param_count := 0
    mut single_borrow_param := -1
    for p in 0..body.param_count {
        loc := p + 1
        if loc >= body.locals.len { break }
        pty := body.locals[loc].ty
        fl := body.locals[loc].flags
        o_len := body.locals[loc].origin_len
        if o_len > 0 || (!ht.is_copy(&types, pty) && fl.bit_and(mb.LF_MOVE_PARAM) == 0) {
            borrow_param_count += 1
            single_borrow_param = p
        }
        if o_len > 0 {
            pk := types.entries[pty].kind
            is_ind := pk == .Ref || pk == .MutRef || pk == .FatSlice || pk == .FatStr || pk == .RegionSlice
            for slot in 0..o_len {
                oid := mb.local_origin_at(&body, loc, slot)
                if oid < 0 { continue }
                fslot := if is_ind { if slot == 0 { -1 } else { slot - 1 } } else { slot }
                syn_loans.push(SynParamLoan { param_idx: p, field_slot: fslot, origin: oid })
            }
        }
    }
    if body.sig_ty >= 0 && body.sig_ty < types.entries.len && types.entries[body.sig_ty].kind == .ClosureEnv {
        cap_cnt := types.entries[body.sig_ty].count
        for ci in 0..cap_cnt {
            loc := body.param_count + 1 + ci
            if loc >= body.locals.len { break }
            o_len := body.locals[loc].origin_len
            for slot in 0..o_len {
                oid := mb.local_origin_at(&body, loc, slot)
                if oid < 0 { continue }
                syn_loans.push(SynParamLoan { param_idx: ht.PARAM_ENV, field_slot: -1, origin: oid })
            }
        }
    }

    // Mark which real loans are reborrows (whose underlying provenance flows via V2-S2 outlives edges),
    // and record the defining arg-temp origin for TwoPhaseMut reservation-window precision.
    mut is_reborrow: []bool = []
    mut loan_def_origin: []i32 = []
    for _ in 0..n_loans { is_reborrow.push(false); loan_def_origin.push(-1) }
    for bb in 0..n_bbs {
        blk := body.blocks[bb]
        for si in blk.stmt_start..blk.stmt_end {
            st := body.stmts[si]
            if st.kind != .Assign { continue }
            rv := body.rvalues[st.rvalue]
            if rv.kind == .Ref {
                deps := collect_reborrow_dep_origins(&types, &body, body.loans[rv.a].place, false)
                if deps.len > 0 { is_reborrow[rv.a] = true }
                if rv.a >= 0 && rv.a < n_loans {
                    loan_def_origin[rv.a] = mb.local_origin_at(&body, body.places[st.place].local, 0)
                }
            } else if rv.kind == .Slice || rv.kind == .BytesView {
                deps := collect_reborrow_dep_origins(&types, &body, body.loans[rv.a].place, true)
                if deps.len > 0 { is_reborrow[rv.a] = true }
            }
        }
    }

    total_loans := n_loans + syn_loans.len
    loan_words := if total_loans == 0 { 1 } else { (total_loans + 63) / 64 }
    origin_words := if n_origins == 0 { 1 } else { (n_origins + 63) / 64 }
    mat_words := n_origins * loan_words

    // Step A: Backward MirLocal liveness with dropck
    live := compute_liveness(&types, &body)

    // Pre-index locals that own at least one origin (skipping 95%+ non-borrowing locals in compute_live_origins)
    mut origin_locals: []i32 = []
    for l in 0..body.locals.len {
        if body.locals[l].origin_len > 0 { origin_locals.push(l) }
    }

    // External origins O_ext = return local 0's origins (must survive to Return!)
    mut ext_origins: []u64 = []
    for _ in 0..origin_words { ext_origins.push(u64(0)) }
    for k in 0..body.locals[0].origin_len {
        bs_set(&mut ext_origins, 0, body.local_origins[body.locals[0].origin_start + k])
    }

    // Step B: Collect all outlives & bidirectional invariance edges, bucketed by BB for O(1) lookup!
    raw_edges := collect_all_edges(&types, &body)
    mut bidir_edges: []mb.OutlivesEdge = []
    mut bb_edge_cnt: []i32 = []
    for _ in 0..n_bbs { bb_edge_cnt.push(0) }
    for i in 0..raw_edges.len {
        eb := raw_edges[i].bb
        if eb >= 0 && eb < n_bbs { bb_edge_cnt[eb] += 1 }
        if raw_edges[i].bidirectional { bidir_edges.push(raw_edges[i]) }
    }
    mut bb_edge_start: []i32 = []
    mut bb_edge_end: []i32 = []
    mut bb_edge_cur: []i32 = []
    mut e_off := 0
    for bb in 0..n_bbs {
        bb_edge_start.push(e_off)
        bb_edge_cur.push(e_off)
        e_off += bb_edge_cnt[bb]
        bb_edge_end.push(e_off)
    }
    mut bb_edges: []mb.OutlivesEdge = []
    for _ in 0..e_off {
        bb_edges.push(mb.OutlivesEdge { from_origin: 0, to_origin: 0, bb: 0, stmt_idx: 0, bidirectional: false })
    }
    for i in 0..raw_edges.len {
        eb := raw_edges[i].bb
        if eb >= 0 && eb < n_bbs {
            bb_edges[bb_edge_cur[eb]] = raw_edges[i]
            bb_edge_cur[eb] += 1
        }
    }

    // Bucket loans by def_bb and TwoPhaseMut loans by activate_bb!
    mut bb_loan_cnt: []i32 = []
    mut bb_tp_cnt: []i32 = []
    for _ in 0..n_bbs { bb_loan_cnt.push(0); bb_tp_cnt.push(0) }
    for li in 0..n_loans {
        db := body.loans[li].def_bb
        if db >= 0 && db < n_bbs { bb_loan_cnt[db] += 1 }
        if body.loans[li].kind == .TwoPhaseMut {
            ab := body.loans[li].activate_bb
            if ab >= 0 && ab < n_bbs { bb_tp_cnt[ab] += 1 }
        }
    }
    mut bb_loan_start: []i32 = []
    mut bb_loan_end: []i32 = []
    mut bb_loan_cur: []i32 = []
    mut l_off := 0
    mut bb_tp_start: []i32 = []
    mut bb_tp_end: []i32 = []
    mut bb_tp_cur: []i32 = []
    mut tp_off := 0
    for bb in 0..n_bbs {
        bb_loan_start.push(l_off); bb_loan_cur.push(l_off); l_off += bb_loan_cnt[bb]; bb_loan_end.push(l_off)
        bb_tp_start.push(tp_off); bb_tp_cur.push(tp_off); tp_off += bb_tp_cnt[bb]; bb_tp_end.push(tp_off)
    }
    mut bb_loans: []i32 = []
    for _ in 0..l_off { bb_loans.push(0) }
    mut bb_tp: []i32 = []
    for _ in 0..tp_off { bb_tp.push(0) }
    for li in 0..n_loans {
        db := body.loans[li].def_bb
        if db >= 0 && db < n_bbs { bb_loans[bb_loan_cur[db]] = li; bb_loan_cur[db] += 1 }
        if body.loans[li].kind == .TwoPhaseMut {
            ab := body.loans[li].activate_bb
            if ab >= 0 && ab < n_bbs { bb_tp[bb_tp_cur[ab]] = li; bb_tp_cur[ab] += 1 }
        }
    }

    // Step C: BB-entry-only forward fixpoint for contains[bb_entry][O]
    mut bb_contains: []u64 = []
    for _ in 0..(n_bbs * mat_words) { bb_contains.push(u64(0)) }
    mut bb_nonempty: []u64 = []
    for _ in 0..(n_bbs * origin_words) { bb_nonempty.push(u64(0)) }

    // Seed synthetic parameter loans at BB 0 entry!
    for si in 0..syn_loans.len {
        bs_set(&mut bb_contains, syn_loans[si].origin * loan_words, n_loans + si)
        bs_set(&mut bb_nonempty, 0, syn_loans[si].origin)
    }

    mut cur_contains: []u64 = []
    for _ in 0..mat_words { cur_contains.push(u64(0)) }
    mut cur_nonempty: []u64 = []
    for _ in 0..origin_words { cur_nonempty.push(u64(0)) }

    mut live_origins: []u64 = []
    for _ in 0..origin_words { live_origins.push(u64(0)) }
    mut active_loans: []u64 = []
    for _ in 0..loan_words { active_loans.push(u64(0)) }

    mut work: []i32 = [0]
    mut work_head := 0
    mut in_work: []bool = []
    mut visited: []bool = []
    for _ in 0..n_bbs { in_work.push(false); visited.push(false) }
    in_work[0] = true
    visited[0] = true

    mut succs: []i32 = []
    mut stmt_live_after: []u64 = []
    mut stmt_live_before: []u64 = []

    while work_head < work.len {
        bb := work[work_head]
        work_head += 1
        in_work[bb] = false
        if !init.reachable[bb] { continue }

        blk := body.blocks[bb]
        s_count := blk.stmt_end - blk.stmt_start

        // Precompute per-stmt live_after within this single BB (streamed backward).
        stmt_live_after.clear()
        for _ in 0..((s_count + 1) * live.words) { stmt_live_after.push(u64(0)) }
        bs_copy(&mut stmt_live_after, s_count * live.words, &live.live_out, bb * live.words, live.words)
        step_liveness_term_back(&types, &body, body.terms[blk.term_id], &mut stmt_live_after, s_count * live.words)
        mut k := s_count - 1
        while k >= 0 {
            bs_copy_self(&mut stmt_live_after, k * live.words, (k + 1) * live.words, live.words)
            if k < s_count - 1 {
                step_liveness_stmt_back(&body, body.stmts[blk.stmt_start + k + 1], &mut stmt_live_after, k * live.words)
            }
            k -= 1
        }

        copy_sparse_rows(&mut cur_contains, &mut cur_nonempty, &bb_contains, bb * mat_words, &bb_nonempty, bb * origin_words, origin_words, loan_words)
        es := bb_edge_start[bb]
        ee := bb_edge_end[bb]
        ls := bb_loan_start[bb]
        le := bb_loan_end[bb]
        for rel in 0..s_count {
            st := body.stmts[blk.stmt_start + rel]
            // Kill previous origin contents on full overwrite of a non-borrowed mut local (`mut r: &T` rebinding).
            if st.kind == .Assign && has_any_nonempty(&cur_nonempty, origin_words) {
                dst := body.places[st.place]
                if dst.proj_len == 0 && body.locals[dst.local].origin_len > 0 &&
                    body.locals[dst.local].flags.bit_and(mb.LF_MUT) != 0 {
                    // Only kill if no active loan borrows dst.local itself.
                    compute_live_origins(&body, &origin_locals, &stmt_live_after, rel * live.words, &ext_origins, origin_words, &mut live_origins)
                    compute_active_loans(&cur_contains, &cur_nonempty, &live_origins, origin_words, loan_words, &mut active_loans)
                    mut borrowed_self := false
                    for lw in 0..loan_words {
                        mut aw := active_loans[lw]
                        if aw == u64(0) { continue }
                        mut lb := 0
                        while aw != u64(0) {
                            if aw.bit_and(u64(1)) != u64(0) {
                                li := lw * 64 + lb
                                if li < n_loans && body.places[body.loans[li].place].local == dst.local {
                                    borrowed_self = true; break
                                }
                            }
                            aw = aw.shr(1); lb += 1
                        }
                        if borrowed_self { break }
                    }
                    if !borrowed_self {
                        for oi in 0..body.locals[dst.local].origin_len {
                            o := body.local_origins[body.locals[dst.local].origin_start + oi]
                            bs_zero(&mut cur_contains, o * loan_words, loan_words)
                            bs_clear(&mut cur_nonempty, 0, o)
                        }
                    }
                }
            }
            // Seed any loans defined at (bb, rel)
            for lidx in ls..le {
                li := bb_loans[lidx]
                if body.loans[li].def_stmt == rel {
                    lo := body.loans[li].origin
                    bs_set(&mut cur_contains, lo * loan_words, li)
                    bs_set(&mut cur_nonempty, 0, lo)
                }
            }
            if has_any_nonempty(&cur_nonempty, origin_words) {
                // Close over outlives & bidirectional invariance edges at (bb, rel)
                close_edges(&mut cur_contains, &mut cur_nonempty, &bb_edges, es, ee, rel, loan_words, &bidir_edges)
                // Prune dead origins (not live after stmt and not in O_ext)
                compute_live_origins(&body, &origin_locals, &stmt_live_after, rel * live.words, &ext_origins, origin_words, &mut live_origins)
                prune_dead_origins(&mut cur_contains, &mut cur_nonempty, &live_origins, origin_words, loan_words)
            }
        }
        // Close over terminator outlives edges (e.g. Call `from_edges`)
        if has_any_nonempty(&cur_nonempty, origin_words) {
            close_edges(&mut cur_contains, &mut cur_nonempty, &bb_edges, es, ee, -1, loan_words, &bidir_edges)
        }

        mb.term_succs(&body, bb, &mut succs)
        for si in 0..succs.len {
            s := succs[si]
            mut ch := !visited[s]
            visited[s] = true
            if merge_sparse_rows_changed(&mut bb_contains, s * mat_words, &mut bb_nonempty, s * origin_words, &cur_contains, &cur_nonempty, origin_words, loan_words) {
                ch = true
            }
            if ch && !in_work[s] { in_work[s] = true; work.push(s) }
        }
    }

    // Step D: Single streaming conflict & escape pass per reachable BB
    mut ok := true
    for bb in 0..n_bbs {
        if !init.reachable[bb] { continue }
        blk := body.blocks[bb]
        s_count := blk.stmt_end - blk.stmt_start

        stmt_live_after.clear()
        stmt_live_before.clear()
        for _ in 0..((s_count + 1) * live.words) {
            stmt_live_after.push(u64(0))
            stmt_live_before.push(u64(0))
        }
        bs_copy(&mut stmt_live_after, s_count * live.words, &live.live_out, bb * live.words, live.words)
        bs_copy(&mut stmt_live_before, s_count * live.words, &live.live_out, bb * live.words, live.words)
        step_liveness_term_back(&types, &body, body.terms[blk.term_id], &mut stmt_live_before, s_count * live.words)
        mut k := s_count - 1
        while k >= 0 {
            bs_copy(&mut stmt_live_after, k * live.words, &stmt_live_before, (k + 1) * live.words, live.words)
            bs_copy(&mut stmt_live_before, k * live.words, &stmt_live_after, k * live.words, live.words)
            step_liveness_stmt_back(&body, body.stmts[blk.stmt_start + k], &mut stmt_live_before, k * live.words)
            k -= 1
        }

        copy_sparse_rows(&mut cur_contains, &mut cur_nonempty, &bb_contains, bb * mat_words, &bb_nonempty, bb * origin_words, origin_words, loan_words)
        es := bb_edge_start[bb]
        ee := bb_edge_end[bb]
        ls := bb_loan_start[bb]
        le := bb_loan_end[bb]

        for rel in 0..s_count {
            st := body.stmts[blk.stmt_start + rel]
            has_ne := has_any_nonempty(&cur_nonempty, origin_words)
            if has_ne {
                compute_live_origins(&body, &origin_locals, &stmt_live_before, rel * live.words, &ext_origins, origin_words, &mut live_origins)
                compute_active_loans(&cur_contains, &cur_nonempty, &live_origins, origin_words, loan_words, &mut active_loans)
            } else {
                bs_zero(&mut active_loans, 0, loan_words)
            }

            if st.kind == .Assign {
                // Ban overwriting stored-borrow fields through &mut function parameters in 1.0!
                dst := body.places[st.place]
                if starts_with_deref(&body, st.place) &&
                    body.locals[dst.local].flags.bit_and(mb.LF_PARAM) != 0 &&
                    is_mut_ref_local(&types, &body, dst.local) &&
                    ht.origin_count(&types, dst.ty) > 0 {
                    hb.push_error(&mut diags, "E4003", body.path, st.span_start, st.span_end,
                        "cannot overwrite stored borrow through '&mut' parameter '" + body.locals[dst.local].name + "'")
                    ok = false
                }

                // Check RHS accesses
                rv := body.rvalues[st.rvalue]
                if rv.kind == .Ref {
                    ln := body.loans[rv.a]
                    if ln.kind != .Shared && !check_place_mutable(&types, &body, ln.place, false) {
                        hb.push_error(&mut diags, "E4002", body.path, st.span_start, st.span_end,
                            "cannot take '&mut' borrow of immutable binding or shared reference")
                        ok = false
                    }
                    if has_ne {
                        ak: AccessKind = if ln.kind == .Shared { .SharedRef } else if ln.kind == .TwoPhaseMut { .TwoPhaseReserve } else { .MutRef }
                        if !check_single_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, -1, ln.place, ak, st.span_start, st.span_end, &mut diags) { ok = false }
                    }
                } else if rv.kind == .Slice || rv.kind == .BytesView {
                    ln := body.loans[rv.a]
                    if ln.kind != .Shared && !check_place_mutable(&types, &body, ln.place, false) {
                        hb.push_error(&mut diags, "E4002", body.path, st.span_start, st.span_end,
                            "cannot take mutable slice of immutable binding or shared reference")
                        ok = false
                    }
                    if has_ne {
                        ak: AccessKind = if ln.kind == .Shared { .SharedRef } else { .MutRef }
                        if !check_single_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, -1, ln.place, ak, st.span_start, st.span_end, &mut diags) { ok = false }
                        for i in 0..rv.op_len {
                            if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, body.call_args[rv.op_start + i], st.span_start, st.span_end, &mut diags) { ok = false }
                        }
                    }
                } else if has_ne {
                    if rv.kind == .Use || rv.kind == .Unary || rv.kind == .Cast || rv.kind == .Len || rv.kind == .Discriminant {
                        if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, rv.a, st.span_start, st.span_end, &mut diags) { ok = false }
                    } else if rv.kind == .Binary {
                        if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, rv.a, st.span_start, st.span_end, &mut diags) { ok = false }
                        if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, rv.b, st.span_start, st.span_end, &mut diags) { ok = false }
                    } else if rv.kind == .Aggregate || rv.kind == .Closure {
                        for i in 0..rv.op_len {
                            if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, body.call_args[rv.op_start + i], st.span_start, st.span_end, &mut diags) { ok = false }
                        }
                    }
                }

                // Check LHS write mutability & borrow access
                if !check_place_mutable(&types, &body, st.place, true) {
                    hb.push_error(&mut diags, "E4002", body.path, st.span_start, st.span_end,
                        "cannot mutate immutable binding, field, or shared borrow")
                    ok = false
                }
                if has_ne {
                    if !check_single_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, -1, st.place, .Write, st.span_start, st.span_end, &mut diags) {
                        ok = false
                    }

                    // Origin kill on full overwrite of non-borrowed mut local
                    if dst.proj_len == 0 && body.locals[dst.local].origin_len > 0 &&
                        body.locals[dst.local].flags.bit_and(mb.LF_MUT) != 0 {
                        mut borrowed_self := false
                        for lw in 0..loan_words {
                            mut aw := active_loans[lw]
                            if aw == u64(0) { continue }
                            mut lb := 0
                            while aw != u64(0) {
                                if aw.bit_and(u64(1)) != u64(0) {
                                    li := lw * 64 + lb
                                    if li < n_loans && body.places[body.loans[li].place].local == dst.local {
                                        borrowed_self = true; break
                                    }
                                }
                                aw = aw.shr(1); lb += 1
                            }
                            if borrowed_self { break }
                        }
                        if !borrowed_self {
                            for oi in 0..body.locals[dst.local].origin_len {
                                o := body.local_origins[body.locals[dst.local].origin_start + oi]
                                bs_zero(&mut cur_contains, o * loan_words, loan_words)
                                bs_clear(&mut cur_nonempty, 0, o)
                            }
                        }
                    }
                }
            } else if st.kind == .StorageDead && has_ne {
                // StorageDead invalidates stack storage: no active loan may still borrow this local!
                compute_live_origins(&body, &origin_locals, &stmt_live_after, rel * live.words, &ext_origins, origin_words, &mut live_origins)
                compute_active_loans(&cur_contains, &cur_nonempty, &live_origins, origin_words, loan_words, &mut active_loans)
                for lw in 0..loan_words {
                    mut aw := active_loans[lw]
                    if aw == u64(0) { continue }
                    mut lb := 0
                    while aw != u64(0) {
                        if aw.bit_and(u64(1)) != u64(0) {
                            li := lw * 64 + lb
                            if li < n_loans && body.places[body.loans[li].place].local == st.place {
                                hb.push_error(&mut diags, "E4003", body.path, st.span_start, st.span_end,
                                    "'" + body.locals[st.place].name + "' does not live long enough; still borrowed when exiting scope")
                                ok = false
                            }
                        }
                        aw = aw.shr(1); lb += 1
                    }
                }
            }

            // Advance cur_contains through stmt
            for lidx in ls..le {
                li := bb_loans[lidx]
                if body.loans[li].def_stmt == rel {
                    lo := body.loans[li].origin
                    bs_set(&mut cur_contains, lo * loan_words, li)
                    bs_set(&mut cur_nonempty, 0, lo)
                }
            }
            if has_any_nonempty(&cur_nonempty, origin_words) {
                close_edges(&mut cur_contains, &mut cur_nonempty, &bb_edges, es, ee, rel, loan_words, &bidir_edges)
                compute_live_origins(&body, &origin_locals, &stmt_live_after, rel * live.words, &ext_origins, origin_words, &mut live_origins)
                prune_dead_origins(&mut cur_contains, &mut cur_nonempty, &live_origins, origin_words, loan_words)
            }
        }

        // Terminator checks
        tm := body.terms[blk.term_id]
        compute_live_origins(&body, &origin_locals, &stmt_live_before, s_count * live.words, &ext_origins, origin_words, &mut live_origins)
        compute_active_loans(&cur_contains, &cur_nonempty, &live_origins, origin_words, loan_words, &mut active_loans)

        if tm.kind == .SwitchInt {
            if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, tm.place_or_op, tm.span_start, tm.span_end, &mut diags) { ok = false }
        } else if tm.kind == .Call {
            if tm.call_kind == .Indirect {
                if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, tm.callee, tm.span_start, tm.span_end, &mut diags) { ok = false }
            }
            for i in 0..tm.arg_len {
                if !check_operand_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, body.call_args[tm.arg_start + i], tm.span_start, tm.span_end, &mut diags) { ok = false }
            }
            // Activate any TwoPhaseMut loans targeting this Call terminator: re-check full Mut against all other active loans!
            for tidx in bb_tp_start[bb]..bb_tp_end[bb] {
                li := bb_tp[tidx]
                if bs_get(&active_loans, 0, li) {
                    if !check_single_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, li,
                        body.loans[li].place, .MutRef, tm.span_start, tm.span_end, &mut diags) {
                        ok = false
                    }
                }
            }
            // Also check pairwise aliasing across call arguments (e.g. Option<&mut T> + &T passed together — S-1!):
            // Any exclusive loan present in arg i's origin(s) cannot overlap any loan in arg j's origin(s) (j != i)!
            for i in 0..tm.arg_len {
                op_i := body.ops[body.call_args[tm.arg_start + i]]
                if op_i.kind == .Const { continue }
                sl_i := place_origin_slice(&types, &body, op_i.id)
                if sl_i.start_slot < 0 || sl_i.count == 0 { continue }
                for j in (i + 1)..tm.arg_len {
                    op_j := body.ops[body.call_args[tm.arg_start + j]]
                    if op_j.kind == .Const { continue }
                    sl_j := place_origin_slice(&types, &body, op_j.id)
                    if sl_j.start_slot < 0 || sl_j.count == 0 { continue }
                    mut conflict := false
                    for ki in 0..sl_i.count {
                        oi := mb.local_origin_at(&body, body.places[op_i.id].local, sl_i.start_slot + ki)
                        if oi < 0 || !bs_get(&cur_nonempty, 0, oi) { continue }
                        for w_i in 0..loan_words {
                            mut wi := cur_contains[oi * loan_words + w_i]
                            if wi == u64(0) { continue }
                            mut bi := 0
                            while wi != u64(0) {
                                b_set_i := wi.bit_and(u64(1)) != u64(0)
                                wi = wi.shr(1)
                                li := w_i * 64 + bi
                                bi += 1
                                if !b_set_i || li >= n_loans { continue }
                                for kj in 0..sl_j.count {
                                    oj := mb.local_origin_at(&body, body.places[op_j.id].local, sl_j.start_slot + kj)
                                    if oj < 0 || !bs_get(&cur_nonempty, 0, oj) { continue }
                                    for w_j in 0..loan_words {
                                        mut wj := cur_contains[oj * loan_words + w_j]
                                        if wj == u64(0) { continue }
                                        mut bj := 0
                                        while wj != u64(0) {
                                            b_set_j := wj.bit_and(u64(1)) != u64(0)
                                            wj = wj.shr(1)
                                            lj := w_j * 64 + bj
                                            bj += 1
                                            if !b_set_j || lj >= n_loans { continue }
                                            if (body.loans[li].kind != .Shared || body.loans[lj].kind != .Shared) &&
                                                places_overlap(&body, body.loans[li].place, body.loans[lj].place) {
                                                conflict = true
                                                break
                                            }
                                        }
                                        if conflict { break }
                                    }
                                    if conflict { break }
                                }
                                if conflict { break }
                            }
                            if conflict { break }
                        }
                        if conflict { break }
                    }
                    if conflict {
                        hb.push_error(&mut diags, "E4003", body.path, tm.span_start, tm.span_end,
                            "mutable borrow argument must not alias another borrow in the same call")
                        ok = false
                    }
                }
            }
            // Check write to Call dest_place AFTER the call returns (using live_after, so temporary
            // call arguments like `items[j] = clone_diag(&items[j - 1])` are already released!).
            compute_live_origins(&body, &origin_locals, &stmt_live_after, s_count * live.words, &ext_origins, origin_words, &mut live_origins)
            compute_active_loans(&cur_contains, &cur_nonempty, &live_origins, origin_words, loan_words, &mut active_loans)
            if !check_single_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, -1, tm.place_or_op, .Write, tm.span_start, tm.span_end, &mut diags) {
                ok = false
            }
        } else if tm.kind == .Drop {
            // Drop(x) destroys x; conflicts if ANY active loan borrows x!
            // With dropck, if an outer/later TF_DISPOSE guard holds &x, its origin is still live here -> E4003!
            // If a plain struct without TF_DISPOSE holds &x and is no longer used, its origin is dead -> allowed (may_dangle)!
            if !check_single_access(&types, &body, &cur_contains, &active_loans, &live_origins, &loan_def_origin, loan_words, bb, -1, tm.place_or_op, .Write, tm.span_start, tm.span_end, &mut diags) {
                ok = false
            }
        } else if tm.kind == .Return {
            for oi in 0..body.locals[0].origin_len {
                o := body.local_origins[body.locals[0].origin_start + oi]
                if !bs_get(&cur_nonempty, 0, o) { continue }
                for li in 0..total_loans {
                    if !bs_get(&cur_contains, o * loan_words, li) { continue }
                    if li < n_loans {
                        if is_reborrow[li] { continue }
                        if !is_allowed_return_real_loan(&types, &body, li, oi, borrow_param_count, single_borrow_param) {
                            hb.push_error(&mut diags, "E4003", body.path, tm.span_start, tm.span_end,
                                "cannot return borrow of local value, by-value parameter, or undeclared parameter")
                            ok = false
                        }
                    } else {
                        syn := syn_loans[li - n_loans]
                        if !match_from_edges(&types, &body, syn.param_idx, syn.field_slot, oi, borrow_param_count, single_borrow_param) {
                            hb.push_error(&mut diags, "E4003", body.path, tm.span_start, tm.span_end,
                                "returned borrow does not match declared 'from' contract")
                            ok = false
                        }
                    }
                }
            }
        } else if tm.kind == .RegionExit {
            compute_live_origins(&body, &origin_locals, &stmt_live_after, s_count * live.words, &ext_origins, origin_words, &mut live_origins)
            compute_active_loans(&cur_contains, &cur_nonempty, &live_origins, origin_words, loan_words, &mut active_loans)
            scope_id := tm.callee
            for lw in 0..loan_words {
                mut aw := active_loans[lw]
                if aw == u64(0) { continue }
                mut lb := 0
                while aw != u64(0) {
                    if aw.bit_and(u64(1)) != u64(0) {
                        li := lw * 64 + lb
                        if li < n_loans && body.loans[li].region_scope == scope_id {
                            hb.push_error(&mut diags, "E4005", body.path, tm.span_start, tm.span_end,
                                "borrow from scratch region cannot escape region block")
                            ok = false
                        }
                    }
                    aw = aw.shr(1); lb += 1
                }
            }
        }
    }
    ok
}
