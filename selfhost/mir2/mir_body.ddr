// High-Level Typed CFG MIR (HL-MIR) flat i32-indexed arena structures for Dunder 1.0.
// Strictly target-independent: carries exact TypeIds, StackSlot sizes/aligns, Loans, Origins, and Scopes.

import ..hir.hir_types as ht

// MirLocal.flags bitmask (i64)
pub const LF_MUT: i64        = 1
pub const LF_PARAM: i64      = 2
pub const LF_MOVE_PARAM: i64 = 4
pub const LF_TEMP: i64       = 8
pub const LF_USER: i64       = 16
pub const LF_ADDR_TAKEN: i64 = 32
pub const LF_DROP_FLAG: i64  = 64
pub const LF_DEFER_FLAG: i64 = 128

// Built-in intrinsic callee IDs for TermKind.Call(CallKind.Intrinsic)
pub const INTRINSIC_DROP: i32    = -100
pub const INTRINSIC_REPLACE: i32 = -101
pub const INTRINSIC_SWAP: i32    = -102

pub struct MirLocal {
    name: string,
    ty: i32,
    size: i32,
    align: i32,
    scope: i32,
    flags: i64,
    origin_start: i32,
    origin_len: i32,
    span_start: i32,
    span_end: i32,
}

pub enum ProjKind { Deref, Field, Index, Downcast }

pub struct PlaceProj {
    kind: ProjKind,
    index: i32,         // field_idx / variant_idx / index_local
}

pub struct MirPlace {
    local: i32,
    proj_start: i32,
    proj_len: i32,
    ty: i32,
}

pub enum BorrowKind { Shared, Mut, TwoPhaseMut }

pub struct Loan {
    place: i32,         // PlaceId
    kind: BorrowKind,
    origin: i32,        // OriginId created by this borrow
    def_bb: i32,
    def_stmt: i32,
    region_scope: i32,  // -1 or ScopeId of enclosing `region R`
    activate_bb: i32,   // for TwoPhaseMut: Call terminator BB (-1 otherwise)
    span_start: i32,
    span_end: i32,
}

pub enum ScopeKind { Lexical, Defer, Region, TaskScope }

pub struct ScopeNode {
    parent: i32,
    kind: ScopeKind,
    cleanup_bb: i32,        // shared defer_bb / task_scope join / region exit
    active_flag_local: i32, // -1 or bool local reset at loop-body entry
    depth: i32,
}

pub enum OpKind { Copy, Move, Const }

pub struct Operand {
    kind: OpKind,
    id: i32,            // PlaceId for Copy/Move, ConstId for Const
}

pub struct ConstVal {
    ty: i32,
    int_val: i64,
    text: string,
}

pub enum StmtKind {
    Assign,
    StorageLive,
    StorageDead,
    SetDiscriminant,
    SetDeferActive,
    SetUnwindTarget,
    Nop,
}

pub enum RvalueKind {
    Use, Ref, Slice, BytesView,
    Binary, Unary, Cast,
    Aggregate, Closure,
    Len, Discriminant,
    AddrOf,
}

pub enum CallKind { Direct, Indirect, Extern, Intrinsic }

pub enum TermKind {
    Goto, SwitchInt,
    Call,
    Drop,
    TaskScopeEnter, TaskScopeJoin,
    RegionEnter, RegionExit,
    Return, Trap,
}

pub struct MirStmt {
    kind: StmtKind,
    place: i32,         // Assign dst / StorageLive|Dead local / SetDiscriminant place / SetDeferActive flag_local
    rvalue: i32,        // index into MirBody.rvalues (-1 if N/A)
    aux: i32,           // variant_idx / defer bool (0|1) / unwind route id
    in_unsafe: bool,
    span_start: i32,
    span_end: i32,
}

pub struct MirRvalue {
    kind: RvalueKind,
    ty: i32,
    a: i32,             // op_id / place_id / loan_id / fn_id / binop_code / variant_idx
    b: i32,             // second op_id / closure_env_ty / agg_kind
    op_start: i32,
    op_len: i32,
}

pub struct MirTerm {
    kind: TermKind,
    call_kind: CallKind,
    target_bb: i32,     // Goto / Call normal_bb / Drop next_bb / SwitchInt otherwise_bb / Enter|Join|Exit next_bb
    place_or_op: i32,   // Drop place / SwitchInt discr_op / Call dest_place
    callee: i32,        // FnId / Operand / TrapKind / ScopeId
    sig_ty: i32,        // Call callee signature TypeId (-1 if N/A)
    arg_start: i32,     // Call args slice in MirBody.call_args, OR SwitchInt slice in switch_vals/switch_bbs
    arg_len: i32,
    in_unsafe: bool,
    span_start: i32,
    span_end: i32,
}

pub struct BasicBlock {
    stmt_start: i32,
    stmt_end: i32,
    term_id: i32,
    pred_start: i32,
    pred_end: i32,
    scope: i32,
}

pub struct OutlivesEdge {
    from_origin: i32,
    to_origin: i32,
    bb: i32,
    stmt_idx: i32,      // statement index within bb, or -1 for terminator
    bidirectional: bool,// true for invariant origins behind &mut T / &mut FnMut
}

pub struct MirBody {
    fn_id: i32,
    owner_mod: i32,
    fn_name: string,
    path: string,
    sig_ty: i32,
    ret_ty: i32,
    param_count: i32,
    is_unsafe: bool,
    locals: []MirLocal,
    places: []MirPlace,
    projs: []PlaceProj,
    loans: []Loan,
    scopes: []ScopeNode,
    stmts: []MirStmt,
    rvalues: []MirRvalue,
    ops: []Operand,
    consts: []ConstVal,
    call_args: []i32,   // indices into MirBody.ops
    terms: []MirTerm,
    blocks: []BasicBlock,
    preds: []i32,
    switch_vals: []i64,
    switch_bbs: []i32,
    local_origins: []i32,
    outlives: []OutlivesEdge,
    origin_count: i32,
    post_drop: bool,
}

pub fn new_body(fn_id: i32, owner_mod: i32, fn_name: string, path: string,
    sig_ty: i32, ret_ty: i32, param_count: i32, is_unsafe: bool) -> MirBody {
    mut b := MirBody {
        fn_id: fn_id,
        owner_mod: owner_mod,
        fn_name: fn_name.clone(),
        path: path.clone(),
        sig_ty: sig_ty,
        ret_ty: ret_ty,
        param_count: param_count,
        is_unsafe: is_unsafe,
        locals: [],
        places: [],
        projs: [],
        loans: [],
        scopes: [],
        stmts: [],
        rvalues: [],
        ops: [],
        consts: [],
        call_args: [],
        terms: [],
        blocks: [],
        preds: [],
        switch_vals: [],
        switch_bbs: [],
        local_origins: [],
        outlives: [],
        origin_count: 0,
        post_drop: false,
    }
    // Root lexical scope 0
    b.scopes.push(ScopeNode { parent: -1, kind: .Lexical, cleanup_bb: -1, active_flag_local: -1, depth: 0 })
    b
}

pub fn alloc_origin(b: &mut MirBody) -> i32 {
    id := b.origin_count
    b.origin_count += 1
    id
}

pub fn add_local(b: &mut MirBody, types: &ht.TypeTable, name: string, ty: i32,
    scope: i32, flags: i64, start: i32, end: i32) -> i32 {
    id := b.locals.len
    oc := ht.origin_count(&types, ty)
    o_start := b.local_origins.len
    for _ in 0..oc {
        oid := alloc_origin(&mut b)
        b.local_origins.push(oid)
    }
    sz := if ty >= 0 && ty < types.entries.len { types.entries[ty].size } else { 0 }
    al := if ty >= 0 && ty < types.entries.len { types.entries[ty].align } else { 1 }
    b.locals.push(MirLocal {
        name: name.clone(),
        ty: ty,
        size: sz,
        align: al,
        scope: scope,
        flags: flags,
        origin_start: o_start,
        origin_len: oc,
        span_start: start,
        span_end: end,
    })
    id
}

pub fn add_place(b: &mut MirBody, local: i32, projs: &[]PlaceProj, ty: i32) -> i32 {
    p_start := b.projs.len
    for i in 0..projs.len { b.projs.push(projs[i]) }
    id := b.places.len
    b.places.push(MirPlace { local: local, proj_start: p_start, proj_len: projs.len, ty: ty })
    id
}

pub fn add_local_place(b: &mut MirBody, local: i32) -> i32 {
    empty: []PlaceProj = []
    ty := b.locals[local].ty
    add_place(&mut b, local, &empty, ty)
}

pub fn add_projected_place(b: &mut MirBody, base_place: i32, kind: ProjKind, index: i32, ty: i32) -> i32 {
    base := b.places[base_place]
    mut ps: []PlaceProj = []
    for i in 0..base.proj_len { ps.push(b.projs[base.proj_start + i]) }
    ps.push(PlaceProj { kind: kind, index: index })
    add_place(&mut b, base.local, &ps, ty)
}

pub fn add_const(b: &mut MirBody, ty: i32, int_val: i64, text: string) -> i32 {
    id := b.consts.len
    b.consts.push(ConstVal { ty: ty, int_val: int_val, text: text.clone() })
    id
}

pub fn add_op(b: &mut MirBody, kind: OpKind, id: i32) -> i32 {
    oid := b.ops.len
    b.ops.push(Operand { kind: kind, id: id })
    oid
}

pub fn add_rvalue(b: &mut MirBody, kind: RvalueKind, ty: i32, a: i32, b_arg: i32, ops: &[]i32) -> i32 {
    op_start := b.call_args.len
    for i in 0..ops.len { b.call_args.push(ops[i]) }
    id := b.rvalues.len
    b.rvalues.push(MirRvalue { kind: kind, ty: ty, a: a, b: b_arg, op_start: op_start, op_len: ops.len })
    id
}

pub fn add_scope(b: &mut MirBody, parent: i32, kind: ScopeKind, cleanup_bb: i32, active_flag_local: i32) -> i32 {
    depth := if parent >= 0 { b.scopes[parent].depth + 1 } else { 0 }
    id := b.scopes.len
    b.scopes.push(ScopeNode {
        parent: parent,
        kind: kind,
        cleanup_bb: cleanup_bb,
        active_flag_local: active_flag_local,
        depth: depth,
    })
    id
}

pub fn add_loan(b: &mut MirBody, place: i32, kind: BorrowKind, def_bb: i32, def_stmt: i32,
    region_scope: i32, activate_bb: i32, start: i32, end: i32) -> i32 {
    oid := alloc_origin(&mut b)
    id := b.loans.len
    b.loans.push(Loan {
        place: place,
        kind: kind,
        origin: oid,
        def_bb: def_bb,
        def_stmt: def_stmt,
        region_scope: region_scope,
        activate_bb: activate_bb,
        span_start: start,
        span_end: end,
    })
    id
}

pub fn add_block(b: &mut MirBody, scope: i32) -> i32 {
    id := b.blocks.len
    b.blocks.push(BasicBlock {
        stmt_start: 0,
        stmt_end: 0,
        term_id: -1,
        pred_start: 0,
        pred_end: 0,
        scope: scope,
    })
    id
}

pub fn push_stmt(b: &mut MirBody, bb: i32, stmt: MirStmt) -> i32 {
    // Note: callers populate blocks sequentially OR call pack_block_stmts.
    // For flat contiguous storage, push to b.stmts; if block was empty, set stmt_start.
    idx := b.stmts.len
    b.stmts.push(stmt)
    if b.blocks[bb].stmt_end == b.blocks[bb].stmt_start {
        b.blocks[bb].stmt_start = idx
        b.blocks[bb].stmt_end = idx + 1
    } else if b.blocks[bb].stmt_end == idx {
        b.blocks[bb].stmt_end = idx + 1
    } else {
        // Non-contiguous append: relocate block's existing statements contiguously to tail.
        old_s := b.blocks[bb].stmt_start
        old_e := b.blocks[bb].stmt_end
        count := old_e - old_s
        new_s := b.stmts.len - 1
        last := b.stmts[new_s]
        b.stmts[new_s] = b.stmts[old_s]
        for k in 1..count { b.stmts.push(b.stmts[old_s + k]) }
        b.stmts.push(last)
        b.blocks[bb].stmt_start = new_s
        b.blocks[bb].stmt_end = b.stmts.len
    }
    b.blocks[bb].stmt_end - b.blocks[bb].stmt_start - 1
}

pub fn set_term(b: &mut MirBody, bb: i32, term: MirTerm) -> i32 {
    tid := b.terms.len
    b.terms.push(term)
    b.blocks[bb].term_id = tid
    tid
}

pub fn push_call_args(b: &mut MirBody, args: &[]i32) -> i32 {
    start := b.call_args.len
    for i in 0..args.len { b.call_args.push(args[i]) }
    start
}

pub fn push_switch_targets(b: &mut MirBody, vals: &[]i64, bbs: &[]i32) -> i32 {
    start := b.switch_vals.len
    for i in 0..vals.len {
        b.switch_vals.push(vals[i])
        b.switch_bbs.push(bbs[i])
    }
    start
}

pub fn add_outlives(b: &mut MirBody, from_origin: i32, to_origin: i32, bb: i32, stmt_idx: i32, bidirectional: bool) {
    if from_origin < 0 || to_origin < 0 || from_origin == to_origin { return }
    b.outlives.push(OutlivesEdge {
        from_origin: from_origin,
        to_origin: to_origin,
        bb: bb,
        stmt_idx: stmt_idx,
        bidirectional: bidirectional,
    })
}

pub fn local_origin_at(b: &MirBody, local: i32, slot: i32) -> i32 {
    if local < 0 || local >= b.locals.len { return -1 }
    if slot < 0 || slot >= b.locals[local].origin_len { return -1 }
    b.local_origins[b.locals[local].origin_start + slot]
}

pub fn term_succs(b: &MirBody, bb: i32, out: &mut []i32) {
    out.clear()
    tid := b.blocks[bb].term_id
    if tid < 0 || tid >= b.terms.len { return }
    t := b.terms[tid]
    if t.kind == .Goto || t.kind == .Call || t.kind == .Drop ||
        t.kind == .TaskScopeEnter || t.kind == .TaskScopeJoin ||
        t.kind == .RegionEnter || t.kind == .RegionExit {
        if t.target_bb >= 0 { out.push(t.target_bb) }
    } else if t.kind == .SwitchInt {
        for i in 0..t.arg_len {
            out.push(b.switch_bbs[t.arg_start + i])
        }
        if t.target_bb >= 0 { out.push(t.target_bb) }
    }
}

pub fn compute_preds(b: &mut MirBody) {
    n := b.blocks.len
    mut counts: []i32 = []
    for _ in 0..n { counts.push(0) }
    mut succs: []i32 = []
    for bb in 0..n {
        term_succs(&b, bb, &mut succs)
        for i in 0..succs.len {
            s := succs[i]
            if s >= 0 && s < n { counts[s] += 1 }
        }
    }
    b.preds.clear()
    mut total := 0
    for bb in 0..n {
        b.blocks[bb].pred_start = total
        b.blocks[bb].pred_end = total
        total += counts[bb]
    }
    for _ in 0..total { b.preds.push(-1) }
    for bb in 0..n {
        term_succs(&b, bb, &mut succs)
        for i in 0..succs.len {
            s := succs[i]
            if s >= 0 && s < n {
                pos := b.blocks[s].pred_end
                b.preds[pos] = bb
                b.blocks[s].pred_end = pos + 1
            }
        }
    }
}
