// Wave 2B `@link extern "C"` call adapter over sealed ht.TypeTable.
// Supports arm64-macos / arm64-linux (AAPCS64), x86_64-linux (SysV), and x86_64-windows (Win64).
// Zero imports of selfhost/frontend/compile.ddr or selfhost/frontend/frontend_types.ddr.

import ..backend.arm64 as arm
import ..backend.ffi_arm64 as abi
import ..backend.foreign_operation as fop
import ..backend.imports as native_imports
import ..hir.hir_types as ht
import ..hir.hir_body as hb
import mir_emit_helpers as helpers

pub struct FfiState {
    libraries: []string,
    symbols: []string,
    specs: []native_imports.SymbolSpec,
    sites: []i32,
    slots: []i32,
    globals: i32,
    sym_map: Map<string, i64>,
}

pub fn new_ffi() -> FfiState {
    FfiState {
        libraries: [],
        symbols: [],
        specs: [],
        sites: [],
        slots: [],
        globals: 0,
        sym_map: Map<string, i64>::new(),
    }
}

pub fn ensure_import(ffi: &mut FfiState, platform: i32, raw_lib: string, sym: string,
    is_data: bool, weak: bool, delay: bool) -> i32 {
    lib_in := if raw_lib == "" { "c" } else { raw_lib.clone() }
    resolved := native_imports.resolve_library(lib_in, platform, .Glibc)
    key := resolved.name + "\u{0000}" + sym
    existing := ffi.sym_map.get_or(key, -1)
    if existing >= 0 { return i32(existing) }

    slot := ffi.symbols.len
    mut spec := if is_data {
        native_imports.data_symbol_spec(resolved.name.clone(), sym.clone())
    } else {
        native_imports.symbol_spec(resolved.name.clone(), sym.clone())
    }
    spec.weak = weak || resolved.weak
    spec.delay = delay || resolved.delay
    ffi.libraries.push(resolved.name.clone())
    ffi.symbols.push(sym.clone())
    ffi.specs.push(move spec)
    ffi.sym_map.put(move key, i64(slot))
    slot
}

pub fn emit_import_addr(code: &mut arm.Code, ffi: &mut FfiState, slot: i32, dst_reg: i32) {
    if !code.checking {
        ffi.sites.push(arm.position(&code) * 4)
        ffi.slots.push(slot)
    }
    arm.native_address(&mut code, dst_reg)
}

fn c_arg_is_float(ty: i32) -> bool {
    ty == ht.TY_F32 || ty == ht.TY_F64
}

fn c_arg_width(types: &ht.TypeTable, ty: i32) -> i32 {
    if ty == ht.TY_BOOL || ty == ht.TY_I8 || ty == ht.TY_U8 { return 1 }
    if ty == ht.TY_I16 || ty == ht.TY_U16 { return 2 }
    if ty == ht.TY_I32 || ty == ht.TY_U32 || ty == ht.TY_F32 || ty == ht.TY_RUNE { return 4 }
    if ty >= 0 && ty < types.entries.len {
        sz := types.entries[ty].size
        if sz > 0 && sz <= 8 { return sz }
    }
    8
}

// Emits a Wave 2B C ABI foreign call.
// `arg_slots[i]` holds the frame slot where argument `i`'s 8-byte scalar/pointer/float value (or struct ptr) was materialized.
// On return, scalar/float result is left in `x0` (or written to `sret_slot` if large C struct).
pub fn emit_extern_call(code: &mut arm.Code, types: &ht.TypeTable, ffi: &mut FfiState,
    ext_fn: &hb.HirFn, arg_tys: &[]i32, arg_slots: &[]i32, ret_ty: i32) {
    platform := code.platform
    sym_name := if ext_fn.extern_symbol != "" { ext_fn.extern_symbol.clone() } else { ext_fn.name.clone() }
    slot := ensure_import(&mut ffi, platform, ext_fn.extern_lib.clone(), sym_name, false, ext_fn.link_weak, ext_fn.link_delay)

    if platform == 2 || platform == 5 {
        fop.emit(&mut code, .SaveRuntime, 0, 0, 0)
    }

    max_gp := if platform == 5 { 4 } else if platform == 2 { 6 } else { 8 }
    max_fp := if platform == 5 { 4 } else { 8 }
    is_win := platform == 5
    is_var := ext_fn.variadic_fixed >= 0
    fixed_cnt := if is_var { ext_fn.variadic_fixed } else { arg_tys.len }

    // Plan GP / FP / stack assignment for each argument
    mut arg_kind: []i32 = [] // 0 = GP reg, 1 = FP reg, 2 = stack offset
    mut arg_loc: []i32 = []
    mut gp_used := 0
    mut fp_used := 0
    mut stack_bytes := 0

    for i in 0..arg_tys.len {
        aty := arg_tys[i]
        is_fp := c_arg_is_float(aty)
        if is_win {
            // Win64: unified positional slots 0..3 in GP/XMM, rest on stack
            if i < 4 {
                if is_fp {
                    arg_kind.push(1); arg_loc.push(i)
                    if i + 1 > fp_used { fp_used = i + 1 }
                    if is_var && i + 1 > gp_used { gp_used = i + 1 }
                } else {
                    arg_kind.push(0); arg_loc.push(i)
                    if i + 1 > gp_used { gp_used = i + 1 }
                }
            } else {
                arg_kind.push(2); arg_loc.push(stack_bytes)
                stack_bytes += 8
            }
        } else if platform == 0 && is_var && i >= fixed_cnt {
            // Darwin ARM64 variadic args always spill to 8-byte aligned stack slots
            arg_kind.push(2); arg_loc.push(stack_bytes)
            stack_bytes += 8
        } else if is_fp {
            if fp_used < max_fp {
                arg_kind.push(1); arg_loc.push(fp_used)
                fp_used += 1
            } else {
                arg_kind.push(2); arg_loc.push(stack_bytes)
                stack_bytes += 8
            }
        } else {
            if gp_used < max_gp {
                arg_kind.push(0); arg_loc.push(gp_used)
                gp_used += 1
            } else {
                arg_kind.push(2); arg_loc.push(stack_bytes)
                stack_bytes += 8
            }
        }
    }

    aligned_stack := ((stack_bytes + 15) / 16) * 16
    if aligned_stack > 0 {
        fop.emit(&mut code, .Reserve, 0, 0, aligned_stack)
    }

    // 1. Spill stack arguments
    for i in 0..arg_tys.len {
        if arg_kind[i] != 2 { continue }
        arm.load_into(&mut code, arg_slots[i], 0)
        fop.emit(&mut code, .StackAddress, 10, 0, arg_loc[i])
        helpers.store_mem(&mut code, 0, 10, 0)
    }

    // 2. Load FP register arguments
    for i in 0..arg_tys.len {
        if arg_kind[i] != 1 { continue }
        w := if arg_tys[i] == ht.TY_F32 { 4 } else { 8 }
        arm.load_into(&mut code, arg_slots[i], 10)
        abi.fp(&mut code, arg_loc[i], 10, w, true)
        if is_win && is_var && arg_loc[i] < 4 {
            arm.mov(&mut code, arg_loc[i], 10)
        }
    }

    // 3. Load GP register arguments
    for i in 0..arg_tys.len {
        if arg_kind[i] != 0 { continue }
        arm.load_into(&mut code, arg_slots[i], arg_loc[i])
    }

    // 4. Load target symbol address (imports.relocate_at patches adrp+ldr into x16) -> move to x17 and invoke
    emit_import_addr(&mut code, &mut ffi, slot, 16)
    arm.mov(&mut code, 17, 16)
    fop.emit(&mut code, .Invoke, gp_used, fp_used, aligned_stack)

    if aligned_stack > 0 {
        fop.emit(&mut code, .Release, 0, 0, aligned_stack)
    }

    // 5. Normalize return value into x0
    if ret_ty == ht.TY_F32 {
        abi.fp(&mut code, 0, 0, 4, false)
    } else if ret_ty == ht.TY_F64 {
        abi.fp(&mut code, 0, 0, 8, false)
    } else if ret_ty == ht.TY_BOOL {
        arm.bitfield(&mut code, false, true, 0, 0, 0, 7)
        arm.compare_immediate(&mut code, 0, 0, false)
        arm.set_condition(&mut code, 0, 1)
    } else if helpers.is_int_ty(ret_ty) {
        w := c_arg_width(&types, ret_ty)
        if w < 8 {
            arm.bitfield(&mut code, helpers.is_signed_int(ret_ty), true, 0, 0, 0, w * 8 - 1)
        }
    }
}
