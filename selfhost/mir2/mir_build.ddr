// HIR -> High-Level Typed CFG MIR builder (`mir_build.ddr`).
// Guarantees by construction:
// - Strict left-to-right evaluation into explicit MIR temporaries (fixes S-1, S-3, S-6)
// - Explicit ForIter desugaring keeping iterator origin live across the loop CFG (fixes S-4)
// - One shared defer_bb per defer with SetUnwindTarget + SwitchInt routing
// - Loop-body-entry SetDeferActive(flag, false) reset for conditional defers in loops
// - Unified LIFO ScopeNode stack ensuring TaskScopeJoin precedes outer Defer/Drop (fixes S-5, S-8)
// - TwoPhaseMut loan emitted for implicit `&mut self` method receivers.

import ..frontend.diagnostics as diag
import ..hir.hir_types as ht
import ..hir.hir_body as hb
import mir_body as mb

struct DeferInfo {
    scope_id: i32,
    hir_stmt: i32,
    flag_local: i32,
    unwind_local: i32,
    entry_bb: i32,
    exit_bb: i32,
    route_vals: []i64,
    route_bbs: []i32,
    route_run_bbs: []i32,
    loop_depth: i32,
}

struct LoopInfo {
    continue_bb: i32,
    break_bb: i32,
    scope_depth: i32,
    defer_flags_start: i32,
}

struct Builder {
    body: mb.MirBody,
    cur_bb: i32,
    terminated: bool,
    hir_to_mir: []i32,
    scope_stack: []i32,
    scope_owned_starts: []i32,
    scope_owned_locals: []i32,
    scope_all_starts: []i32,
    scope_all_locals: []i32,
    defers: []DeferInfo,
    loops: []LoopInfo,
    loop_defer_flags: []i32,
    guard_lock_locals: []i32,
    guard_lock_depths: []i32,
    cur_region_scope: i32,
    in_unsafe: bool,
}

fn cur_scope(b: &Builder) -> i32 {
    if b.scope_stack.len == 0 { return 0 }
    b.scope_stack[b.scope_stack.len - 1]
}

fn push_scope(b: &mut Builder, kind: mb.ScopeKind, cleanup_bb: i32, flag_local: i32) -> i32 {
    parent := cur_scope(&b)
    sid := mb.add_scope(&mut b.body, parent, kind, cleanup_bb, flag_local)
    b.scope_stack.push(sid)
    b.scope_owned_starts.push(b.scope_owned_locals.len)
    b.scope_all_starts.push(b.scope_all_locals.len)
    sid
}

fn pop_scope(b: &mut Builder) {
    if b.scope_stack.len <= 1 { return }
    _ := b.scope_stack.pop()
    start := b.scope_owned_starts.pop()
    while b.scope_owned_locals.len > start { _ := b.scope_owned_locals.pop() }
    all_start := b.scope_all_starts.pop()
    while b.scope_all_locals.len > all_start { _ := b.scope_all_locals.pop() }
}

fn new_temp(b: &mut Builder, types: &ht.TypeTable, ty: i32, start: i32, end: i32) -> i32 {
    loc := mb.add_local(&mut b.body, &types, "_t" + b.body.locals.len.str(), ty, cur_scope(&b), mb.LF_TEMP, start, end)
    _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
        kind: .StorageLive, place: loc, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe, span_start: start, span_end: end,
    })
    loc
}

fn register_owned_local(b: &mut Builder, types: &ht.TypeTable, loc: i32) {
    ty := b.body.locals[loc].ty
    if ty >= 0 && ty < types.entries.len && types.entries[ty].kind == .MutRef { return }
    if !ht.is_copy(&types, ty) || ht.has_dispose(&types, ty) {
        b.scope_owned_locals.push(loc)
    }
}

fn register_scope_local(b: &mut Builder, types: &ht.TypeTable, loc: i32) {
    b.scope_all_locals.push(loc)
    register_owned_local(&mut b, &types, loc)
}

fn emit_goto(b: &mut Builder, target: i32, start: i32, end: i32) {
    if b.terminated { return }
    _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
        kind: .Goto, call_kind: .Direct, target_bb: target, place_or_op: -1, callee: -1, sig_ty: -1,
        arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: start, span_end: end,
    })
    b.terminated = true
}

fn find_defer_for_scope(b: &Builder, scope_id: i32) -> i32 {
    for i in 0..b.defers.len {
        if b.defers[i].scope_id == scope_id { return i }
    }
    -1
}

// Walk scope_stack from top down to `stop_depth` (exclusive), emitting Drop, TaskScopeJoin,
// RegionExit, and shared Defer routing strictly inner-to-outer (LIFO).
fn emit_unwind_to(b: &mut Builder, types: &ht.TypeTable, stop_depth: i32, final_bb: i32, start: i32, end: i32) {
    if b.terminated { return }
    // Keep any active match-guard borrow locks live along diverging unwind edges (return/break/continue/?).
    if b.guard_lock_locals.len > 0 {
        empty_ops: []i32 = []
        mut gi := b.guard_lock_locals.len - 1
        while gi >= 0 {
            if b.guard_lock_depths[gi] >= stop_depth {
                lk := b.guard_lock_locals[gi]
                lk_ty := b.body.locals[lk].ty
                sink_tmp := new_temp(&mut b, &types, lk_ty, start, end)
                sink_pl := mb.add_local_place(&mut b.body, sink_tmp)
                lk_pl := mb.add_local_place(&mut b.body, lk)
                lk_op := mb.add_op(&mut b.body, .Copy, lk_pl)
                lk_rv := mb.add_rvalue(&mut b.body, .Use, lk_ty, lk_op, -1, &empty_ops)
                _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                    kind: .Assign, place: sink_pl, rvalue: lk_rv, aux: 0, in_unsafe: b.in_unsafe,
                    span_start: start, span_end: end,
                })
                _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                    kind: .StorageDead, place: sink_tmp, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
                    span_start: start, span_end: end,
                })
                _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                    kind: .StorageDead, place: lk, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
                    span_start: start, span_end: end,
                })
            }
            gi -= 1
        }
    }
    mut depth := b.scope_stack.len - 1
    while depth >= stop_depth {
        sid := b.scope_stack[depth]
        sc := b.body.scopes[sid]
        // Drop owned locals and end storage of all scope locals in strict reverse declaration order (LIFO).
        own_start := b.scope_owned_starts[depth]
        own_end := if depth + 1 < b.scope_owned_starts.len { b.scope_owned_starts[depth + 1] } else { b.scope_owned_locals.len }
        all_start := b.scope_all_starts[depth]
        all_end := if depth + 1 < b.scope_all_starts.len { b.scope_all_starts[depth + 1] } else { b.scope_all_locals.len }
        mut ai := all_end - 1
        while ai >= all_start {
            loc := b.scope_all_locals[ai]
            mut is_owned := false
            for ci in own_start..own_end {
                if b.scope_owned_locals[ci] == loc { is_owned = true; break }
            }
            if is_owned {
                ty := b.body.locals[loc].ty
                needs_drop := !(ty >= 0 && ty < types.entries.len && types.entries[ty].kind == .MutRef) &&
                    (!ht.is_copy(&types, ty) || ht.has_dispose(&types, ty))
                if needs_drop {
                    pl := mb.add_local_place(&mut b.body, loc)
                    next_bb := mb.add_block(&mut b.body, sid)
                    _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                        kind: .Drop, call_kind: .Direct, target_bb: next_bb, place_or_op: pl, callee: -1, sig_ty: -1,
                        arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: start, span_end: end,
                    })
                    b.cur_bb = next_bb
                }
            }
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .StorageDead, place: loc, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe, span_start: start, span_end: end,
            })
            ai -= 1
        }
        // Also drop any owned temps registered directly via register_owned_local (not in scope_all_locals).
        mut oi := own_end - 1
        while oi >= own_start {
            loc := b.scope_owned_locals[oi]
            mut already := false
            for ci in all_start..all_end {
                if b.scope_all_locals[ci] == loc { already = true; break }
            }
            if !already {
                ty := b.body.locals[loc].ty
                needs_drop := !(ty >= 0 && ty < types.entries.len && types.entries[ty].kind == .MutRef) &&
                    (!ht.is_copy(&types, ty) || ht.has_dispose(&types, ty))
                if needs_drop {
                    pl := mb.add_local_place(&mut b.body, loc)
                    next_bb := mb.add_block(&mut b.body, sid)
                    _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                        kind: .Drop, call_kind: .Direct, target_bb: next_bb, place_or_op: pl, callee: -1, sig_ty: -1,
                        arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: start, span_end: end,
                    })
                    b.cur_bb = next_bb
                }
            }
            oi -= 1
        }
        if sc.kind == .TaskScope {
            next_bb := mb.add_block(&mut b.body, if sc.parent >= 0 { sc.parent } else { 0 })
            _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                kind: .TaskScopeJoin, call_kind: .Direct, target_bb: next_bb, place_or_op: -1, callee: sid, sig_ty: -1,
                arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: start, span_end: end,
            })
            b.cur_bb = next_bb
        } else if sc.kind == .Region {
            next_bb := mb.add_block(&mut b.body, if sc.parent >= 0 { sc.parent } else { 0 })
            _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                kind: .RegionExit, call_kind: .Direct, target_bb: next_bb, place_or_op: -1, callee: sid, sig_ty: -1,
                arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: start, span_end: end,
            })
            b.cur_bb = next_bb
        } else if sc.kind == .Defer {
            di := find_defer_for_scope(&b, sid)
            if di >= 0 {
                resume_bb := mb.add_block(&mut b.body, if sc.parent >= 0 { sc.parent } else { 0 })
                run_bb := mb.add_block(&mut b.body, sid)
                route_id := b.defers[di].route_vals.len
                b.defers[di].route_vals.push(i64(route_id))
                b.defers[di].route_bbs.push(resume_bb)
                b.defers[di].route_run_bbs.push(run_bb)
                flag_pl := mb.add_local_place(&mut b.body, b.defers[di].flag_local)
                flag_op := mb.add_op(&mut b.body, .Copy, flag_pl)
                vals: []i64 = [1]
                bbs: []i32 = [run_bb]
                sw_start := mb.push_switch_targets(&mut b.body, &vals, &bbs)
                _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                    kind: .SwitchInt, call_kind: .Direct, target_bb: resume_bb, place_or_op: flag_op,
                    callee: -1, sig_ty: -1, arg_start: sw_start, arg_len: 1,
                    in_unsafe: b.in_unsafe, span_start: start, span_end: end,
                })
                // In run_bb: set unwind_target = route_id and reset flag; terminator is wired when lowering defer!
                _ := mb.push_stmt(&mut b.body, run_bb, mb.MirStmt {
                    kind: .SetDeferActive, place: b.defers[di].flag_local, rvalue: -1, aux: 0,
                    in_unsafe: b.in_unsafe, span_start: start, span_end: end,
                })
                _ := mb.push_stmt(&mut b.body, run_bb, mb.MirStmt {
                    kind: .SetUnwindTarget, place: b.defers[di].unwind_local, rvalue: -1, aux: route_id,
                    in_unsafe: b.in_unsafe, span_start: start, span_end: end,
                })
                b.cur_bb = resume_bb
            }
        }
        depth -= 1
    }
    if final_bb >= 0 {
        emit_goto(&mut b, final_bb, start, end)
    }
}

fn lower_place(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn, expr_id: i32) -> i32 {
    e := &f.exprs[expr_id]
    if e.kind == .LocalRef {
        ml := b.hir_to_mir[e.a]
        return mb.add_local_place(&mut b.body, ml)
    }
    if e.kind == .Deref {
        base := lower_place(&mut b, &prog, &f, e.a)
        return mb.add_projected_place(&mut b.body, base, .Deref, 0, e.ty)
    }
    if e.kind == .Field {
        base := lower_place(&mut b, &prog, &f, e.a)
        return mb.add_projected_place(&mut b.body, base, .Field, e.b, e.ty)
    }
    if e.kind == .Index {
        base := lower_place(&mut b, &prog, &f, e.a)
        idx_op := lower_expr_to_op(&mut b, &prog, &f, e.b)
        mut idx_loc := -1
        if b.body.ops[idx_op].kind != .Const {
            idx_loc = b.body.places[b.body.ops[idx_op].id].local
        } else {
            idx_ty := b.body.consts[b.body.ops[idx_op].id].ty
            idx_loc = new_temp(&mut b, &prog.types, idx_ty, e.span_start, e.span_end)
            idx_pl := mb.add_local_place(&mut b.body, idx_loc)
            empty_ops: []i32 = []
            rv := mb.add_rvalue(&mut b.body, .Use, idx_ty, idx_op, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: idx_pl, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
                span_start: e.span_start, span_end: e.span_end,
            })
        }
        return mb.add_projected_place(&mut b.body, base, .Index, idx_loc, e.ty)
    }
    // Fallback: materialize expression into a temp local and return its place.
    tmp := new_temp(&mut b, &prog.types, e.ty, e.span_start, e.span_end)
    pl := mb.add_local_place(&mut b.body, tmp)
    lower_expr_into(&mut b, &prog, &f, expr_id, pl)
    pl
}

fn lower_expr_to_op(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn, expr_id: i32) -> i32 {
    e := &f.exprs[expr_id]
    if e.kind == .FnRef {
        cid := mb.add_const(&mut b.body, e.ty, i64(e.a), e.text)
        return mb.add_op(&mut b.body, .Const, cid)
    }
    if e.kind == .LitInt || e.kind == .LitBool || e.kind == .LitRune || e.kind == .LitByte || e.kind == .LitFloat ||
        e.kind == .ConstRef || e.kind == .Error {
        cid := mb.add_const(&mut b.body, e.ty, e.int_val, e.text)
        return mb.add_op(&mut b.body, .Const, cid)
    }
    if e.kind == .LitStr || e.kind == .LitCStr || e.kind == .LitWStr {
        cid := mb.add_const(&mut b.body, e.ty, 0, e.text)
        return mb.add_op(&mut b.body, .Const, cid)
    }
    if e.kind == .LocalRef || (e.kind == .Field && e.b >= 0) || e.kind == .Deref || e.kind == .Index {
        pl := lower_place(&mut b, &prog, &f, expr_id)
        if ht.is_copy(&prog.types, e.ty) { return mb.add_op(&mut b.body, .Copy, pl) }
        return mb.add_op(&mut b.body, .Move, pl)
    }
    if e.kind == .Move {
        pl := lower_place(&mut b, &prog, &f, e.a)
        return mb.add_op(&mut b.body, .Move, pl)
    }
    // Evaluate strictly left-to-right into a fresh temp local.
    tmp := new_temp(&mut b, &prog.types, e.ty, e.span_start, e.span_end)
    register_owned_local(&mut b, &prog.types, tmp)
    pl := mb.add_local_place(&mut b.body, tmp)
    lower_expr_into(&mut b, &prog, &f, expr_id, pl)
    if ht.is_copy(&prog.types, e.ty) { mb.add_op(&mut b.body, .Copy, pl) }
    else { mb.add_op(&mut b.body, .Move, pl) }
}

// Non-moving borrowed read operand (used for Binary ops like string `==`/`+` and SharedBorrow call args).
fn lower_expr_to_read_op(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn, expr_id: i32) -> i32 {
    e := &f.exprs[expr_id]
    if e.kind == .Move {
        return lower_expr_to_op(&mut b, &prog, &f, expr_id)
    }
    if e.kind == .LocalRef || (e.kind == .Field && e.b >= 0) || e.kind == .Deref || e.kind == .Index {
        pl := lower_place(&mut b, &prog, &f, expr_id)
        return mb.add_op(&mut b.body, .Copy, pl)
    }
    lower_expr_to_op(&mut b, &prog, &f, expr_id)
}

fn param_is_shared_read(types: &ht.TypeTable, sig_ty: i32, arg_idx: i32) -> bool {
    if sig_ty < 0 || sig_ty >= types.entries.len { return false }
    p_cnt := ht.callable_param_count(&types, sig_ty)
    if arg_idx < 0 || arg_idx >= p_cnt { return false }
    p_start := ht.callable_param_start(&types, sig_ty)
    m := types.params[p_start + arg_idx].mode
    m == .SharedBorrow || m == .BorrowOrCopy
}

fn lower_expr_into(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn, expr_id: i32, dest_place: i32) {
    if b.terminated { return }
    e := &f.exprs[expr_id]
    prev_unsafe := b.in_unsafe
    if e.in_unsafe { b.in_unsafe = true }
    empty_ops: []i32 = []

    if e.kind == .LitInt || e.kind == .LitBool || e.kind == .LitStr || e.kind == .LitCStr ||
        e.kind == .LitWStr || e.kind == .LitRune || e.kind == .LitByte || e.kind == .LitFloat ||
        e.kind == .FnRef || e.kind == .ConstRef || e.kind == .Error ||
        e.kind == .LocalRef || (e.kind == .Field && e.b >= 0) || e.kind == .Deref || e.kind == .Index || e.kind == .Move {
        op := lower_expr_to_op(&mut b, &prog, &f, expr_id)
        rv := mb.add_rvalue(&mut b.body, .Use, e.ty, op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .Field && e.b < 0 {
        // Builtin `.len` on array/slice/string/str -> non-moving RvalueKind.Len read!
        pl := lower_place(&mut b, &prog, &f, e.a)
        op := mb.add_op(&mut b.body, .Copy, pl)
        rv := mb.add_rvalue(&mut b.body, .Len, e.ty, op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .Ref || e.kind == .MutRef {
        target_pl := lower_place(&mut b, &prog, &f, e.a)
        bk: mb.BorrowKind = if e.kind == .MutRef { .Mut } else { .Shared }
        rel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
        ln := mb.add_loan(&mut b.body, target_pl, bk, b.cur_bb, rel, b.cur_region_scope, -1, e.span_start, e.span_end)
        rv := mb.add_rvalue(&mut b.body, .Ref, e.ty, ln, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .Slice || e.kind == .BytesView {
        target_pl := lower_place(&mut b, &prog, &f, e.a)
        // If slicing with bound expressions, hold a live Shared borrow of target_pl while evaluating bounds (S-3!).
        mut guard_op := -1
        if e.kind == .Slice && e.arg_len > 0 {
            guard_tmp := new_temp(&mut b, &prog.types, e.ty, e.span_start, e.span_end)
            guard_pl := mb.add_local_place(&mut b.body, guard_tmp)
            g_rel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
            g_ln := mb.add_loan(&mut b.body, target_pl, .Shared, b.cur_bb, g_rel, b.cur_region_scope, -1, e.span_start, e.span_end)
            g_rv := mb.add_rvalue(&mut b.body, .Slice, e.ty, g_ln, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: guard_pl, rvalue: g_rv, aux: 0, in_unsafe: b.in_unsafe,
                span_start: e.span_start, span_end: e.span_end,
            })
            guard_op = mb.add_op(&mut b.body, .Copy, guard_pl)
        }
        mut ops: []i32 = []
        for i in 0..e.arg_len { ops.push(lower_expr_to_op(&mut b, &prog, &f, f.expr_list[e.arg_start + i])) }
        if guard_op >= 0 { ops.push(guard_op) }
        rel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
        ln := mb.add_loan(&mut b.body, target_pl, .Shared, b.cur_bb, rel, b.cur_region_scope, -1, e.span_start, e.span_end)
        rk: mb.RvalueKind = if e.kind == .Slice { .Slice } else { .BytesView }
        rv := mb.add_rvalue(&mut b.body, rk, e.ty, ln, -1, &ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .AddrOf {
        target_pl := lower_place(&mut b, &prog, &f, e.a)
        loc_id := b.body.places[target_pl].local
        b.body.locals[loc_id].flags = b.body.locals[loc_id].flags.bit_or(mb.LF_ADDR_TAKEN)
        rv := mb.add_rvalue(&mut b.body, .AddrOf, e.ty, target_pl, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .Binary {
        // Short-circuit `&&` (14) and `||` (15) with explicit CFG blocks so RHS moves only run when reached!
        if e.c == 14 || e.c == 15 {
            lhs_op := lower_expr_to_read_op(&mut b, &prog, &f, e.a)
            rhs_bb := mb.add_block(&mut b.body, cur_scope(&b))
            short_bb := mb.add_block(&mut b.body, cur_scope(&b))
            join_bb := mb.add_block(&mut b.body, cur_scope(&b))
            vals: []i64 = [if e.c == 14 { 1 } else { 0 }]
            bbs: []i32 = [rhs_bb]
            sw_start := mb.push_switch_targets(&mut b.body, &vals, &bbs)
            _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                kind: .SwitchInt, call_kind: .Direct, target_bb: short_bb, place_or_op: lhs_op,
                callee: -1, sig_ty: -1, arg_start: sw_start, arg_len: 1,
                in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end,
            })
            b.cur_bb = short_bb; b.terminated = false
            short_val := mb.add_const(&mut b.body, ht.TY_BOOL, if e.c == 14 { 0 } else { 1 }, "")
            short_op := mb.add_op(&mut b.body, .Const, short_val)
            rv_s := mb.add_rvalue(&mut b.body, .Use, ht.TY_BOOL, short_op, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: dest_place, rvalue: rv_s, aux: 0, in_unsafe: b.in_unsafe,
                span_start: e.span_start, span_end: e.span_end,
            })
            emit_goto(&mut b, join_bb, e.span_start, e.span_end)

            b.cur_bb = rhs_bb; b.terminated = false
            lower_expr_into(&mut b, &prog, &f, e.b, dest_place)
            if !b.terminated { emit_goto(&mut b, join_bb, e.span_start, e.span_end) }
            b.cur_bb = join_bb; b.terminated = false
        } else {
            // Strict left-to-right: materialize LHS into a temp before evaluating RHS (fixes S-6!).
            lhs_op := lower_expr_to_read_op(&mut b, &prog, &f, e.a)
            rhs_op := lower_expr_to_read_op(&mut b, &prog, &f, e.b)
            rv := mb.add_rvalue(&mut b.body, .Binary, e.ty, lhs_op, rhs_op, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: dest_place, rvalue: rv, aux: e.c, in_unsafe: b.in_unsafe,
                span_start: e.span_start, span_end: e.span_end,
            })
        }
    } else if e.kind == .Unary || e.kind == .Cast {
        op := lower_expr_to_op(&mut b, &prog, &f, e.a)
        rk: mb.RvalueKind = if e.kind == .Unary { .Unary } else { .Cast }
        rv := mb.add_rvalue(&mut b.body, rk, e.ty, op, e.b, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .StructLit || e.kind == .EnumLit || e.kind == .TupleLit || e.kind == .ArrayLit {
        mut ops: []i32 = []
        for i in 0..e.arg_len { ops.push(lower_expr_to_op(&mut b, &prog, &f, f.expr_list[e.arg_start + i])) }
        rv := mb.add_rvalue(&mut b.body, .Aggregate, e.ty, e.a, 0, &ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .Closure {
        mut ops: []i32 = []
        for i in 0..e.arg_len { ops.push(lower_expr_to_op(&mut b, &prog, &f, f.expr_list[e.arg_start + i])) }
        rv := mb.add_rvalue(&mut b.body, .Closure, e.ty, e.a, 0, &ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .Call || e.kind == .MethodCall {
        // Strict left-to-right argument lowering; `&mut self` and direct `&mut place` call arguments use TwoPhaseMut!
        mut arg_ops: []i32 = []
        mut two_phase_loans: []i32 = []
        mut call_kind: mb.CallKind = .Direct
        mut callee_id := e.a
        mut sig_ty := e.b

        if e.kind == .MethodCall && e.c == 1 && e.arg_len > 0 {
            if callee_id < 0 {
                call_kind = .Intrinsic
                if callee_id == -1 && e.text != "" { callee_id = hb.intrinsic_id_for_name(e.text) }
            }
            // Receiver (arg 0) is implicit `&mut self` -> emit TwoPhaseMut loan!
            recv_expr := f.expr_list[e.arg_start]
            recv_pl := lower_place(&mut b, &prog, &f, recv_expr)
            mut_ty := prog.types.params[ht.callable_param_start(&prog.types, sig_ty)].ty
            recv_tmp := new_temp(&mut b, &prog.types, mut_ty, e.span_start, e.span_end)
            recv_tmp_pl := mb.add_local_place(&mut b.body, recv_tmp)
            rel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
            tp_loan := mb.add_loan(&mut b.body, recv_pl, .TwoPhaseMut, b.cur_bb, rel, b.cur_region_scope, -1, e.span_start, e.span_end)
            two_phase_loans.push(tp_loan)
            rv := mb.add_rvalue(&mut b.body, .Ref, mut_ty, tp_loan, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: recv_tmp_pl, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
                span_start: e.span_start, span_end: e.span_end,
            })
            arg_ops.push(mb.add_op(&mut b.body, .Move, recv_tmp_pl))
            for i in 1..e.arg_len {
                ae := f.expr_list[e.arg_start + i]
                if f.exprs[ae].kind == .MutRef {
                    apl := lower_place(&mut b, &prog, &f, f.exprs[ae].a)
                    atmp := new_temp(&mut b, &prog.types, f.exprs[ae].ty, f.exprs[ae].span_start, f.exprs[ae].span_end)
                    atmp_pl := mb.add_local_place(&mut b.body, atmp)
                    arel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
                    al := mb.add_loan(&mut b.body, apl, .TwoPhaseMut, b.cur_bb, arel, b.cur_region_scope, -1, f.exprs[ae].span_start, f.exprs[ae].span_end)
                    two_phase_loans.push(al)
                    arv := mb.add_rvalue(&mut b.body, .Ref, f.exprs[ae].ty, al, -1, &empty_ops)
                    _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                        kind: .Assign, place: atmp_pl, rvalue: arv, aux: 0, in_unsafe: b.in_unsafe,
                        span_start: f.exprs[ae].span_start, span_end: f.exprs[ae].span_end,
                    })
                    arg_ops.push(mb.add_op(&mut b.body, .Move, atmp_pl))
                } else if param_is_shared_read(&prog.types, sig_ty, i) {
                    arg_ops.push(lower_expr_to_read_op(&mut b, &prog, &f, ae))
                } else {
                    arg_ops.push(lower_expr_to_op(&mut b, &prog, &f, ae))
                }
            }
        } else {
            if e.kind == .Call && e.c == 1 {
                // Indirect call: e.a is callee expr! Only FnOnce consumes the closure; Fn/FnMut/FnPtr borrow/read it.
                call_kind = .Indirect
                if ht.has_flag(&prog.types, f.exprs[e.a].ty, ht.TF_CLOSURE_ONCE) {
                    callee_id = lower_expr_to_op(&mut b, &prog, &f, e.a)
                } else {
                    callee_id = lower_expr_to_read_op(&mut b, &prog, &f, e.a)
                }
            } else if e.kind == .Call && e.c == 2 {
                call_kind = .Extern
            } else if e.kind == .Call && e.c == 3 {
                call_kind = .Intrinsic
                if callee_id == -1 && e.text != "" { callee_id = hb.intrinsic_id_for_name(e.text) }
            } else if e.kind == .MethodCall && callee_id < 0 {
                call_kind = .Intrinsic
                if callee_id == -1 && e.text != "" { callee_id = hb.intrinsic_id_for_name(e.text) }
            }
            for i in 0..e.arg_len {
                ae := f.expr_list[e.arg_start + i]
                if f.exprs[ae].kind == .MutRef {
                    apl := lower_place(&mut b, &prog, &f, f.exprs[ae].a)
                    atmp := new_temp(&mut b, &prog.types, f.exprs[ae].ty, f.exprs[ae].span_start, f.exprs[ae].span_end)
                    atmp_pl := mb.add_local_place(&mut b.body, atmp)
                    arel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
                    al := mb.add_loan(&mut b.body, apl, .TwoPhaseMut, b.cur_bb, arel, b.cur_region_scope, -1, f.exprs[ae].span_start, f.exprs[ae].span_end)
                    two_phase_loans.push(al)
                    arv := mb.add_rvalue(&mut b.body, .Ref, f.exprs[ae].ty, al, -1, &empty_ops)
                    _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                        kind: .Assign, place: atmp_pl, rvalue: arv, aux: 0, in_unsafe: b.in_unsafe,
                        span_start: f.exprs[ae].span_start, span_end: f.exprs[ae].span_end,
                    })
                    arg_ops.push(mb.add_op(&mut b.body, .Move, atmp_pl))
                } else if call_kind == .Intrinsic || param_is_shared_read(&prog.types, sig_ty, i) {
                    arg_ops.push(lower_expr_to_read_op(&mut b, &prog, &f, ae))
                } else {
                    arg_ops.push(lower_expr_to_op(&mut b, &prog, &f, ae))
                }
            }
        }
        for tpi in 0..two_phase_loans.len { b.body.loans[two_phase_loans[tpi]].activate_bb = b.cur_bb }
        a_start := mb.push_call_args(&mut b.body, &arg_ops)
        next_bb := mb.add_block(&mut b.body, cur_scope(&b))
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .Call, call_kind: call_kind, target_bb: next_bb, place_or_op: dest_place,
            callee: callee_id, sig_ty: sig_ty, arg_start: a_start, arg_len: arg_ops.len,
            in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end,
        })
        b.cur_bb = next_bb
    } else if e.kind == .If {
        cond_op := lower_expr_to_op(&mut b, &prog, &f, e.a)
        then_bb := mb.add_block(&mut b.body, cur_scope(&b))
        else_bb := mb.add_block(&mut b.body, cur_scope(&b))
        vals: []i64 = [1]
        bbs: []i32 = [then_bb]
        sw_start := mb.push_switch_targets(&mut b.body, &vals, &bbs)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .SwitchInt, call_kind: .Direct, target_bb: else_bb, place_or_op: cond_op,
            callee: -1, sig_ty: -1, arg_start: sw_start, arg_len: 1,
            in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end,
        })
        b.cur_bb = then_bb; b.terminated = false
        lower_expr_into(&mut b, &prog, &f, e.b, dest_place)
        then_done := b.terminated
        then_end_bb := b.cur_bb

        b.cur_bb = else_bb; b.terminated = false
        if e.c >= 0 { lower_expr_into(&mut b, &prog, &f, e.c, dest_place) }
        else_done := b.terminated
        else_end_bb := b.cur_bb

        if then_done && else_done {
            b.terminated = true
        } else {
            join_bb := mb.add_block(&mut b.body, cur_scope(&b))
            if !then_done {
                b.cur_bb = then_end_bb; b.terminated = false
                emit_goto(&mut b, join_bb, e.span_start, e.span_end)
            }
            if !else_done {
                b.cur_bb = else_end_bb; b.terminated = false
                emit_goto(&mut b, join_bb, e.span_start, e.span_end)
            }
            b.cur_bb = join_bb; b.terminated = false
        }
    } else if e.kind == .Block {
        lower_block_stmt_with_tail(&mut b, &prog, &f, e.a, e.b, dest_place)
    } else if e.kind == .Match {
        // e.a = subject expr, e.b = is_move (1/0), e.c = arm_count
        // expr_list[arg_start + i*3 + 0..2] = (pat_id, guard_expr_id, body_expr_id)
        mut subj_pl := -1
        if e.b == 1 && f.exprs[e.a].kind == .Move {
            // `match move x` -> evaluate into a fresh temp via Move so `x` is moved cleanly
            subj_tmp := new_temp(&mut b, &prog.types, f.exprs[e.a].ty, e.span_start, e.span_end)
            subj_pl = mb.add_local_place(&mut b.body, subj_tmp)
            lower_expr_into(&mut b, &prog, &f, e.a, subj_pl)
        } else {
            subj_pl = lower_place(&mut b, &prog, &f, e.a)
        }
        subj_ty := b.body.places[subj_pl].ty
        is_enum := subj_ty >= 0 && subj_ty < prog.types.entries.len && prog.types.entries[subj_ty].kind == .Enum
        mut discr_op := -1
        if is_enum {
            discr_loc := new_temp(&mut b, &prog.types, ht.TY_I32, e.span_start, e.span_end)
            discr_pl := mb.add_local_place(&mut b.body, discr_loc)
            s_op := mb.add_op(&mut b.body, .Copy, subj_pl)
            rv_d := mb.add_rvalue(&mut b.body, .Discriminant, ht.TY_I32, s_op, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: discr_pl, rvalue: rv_d, aux: 0, in_unsafe: b.in_unsafe,
                span_start: e.span_start, span_end: e.span_end,
            })
            discr_op = mb.add_op(&mut b.body, .Copy, discr_pl)
        }
        join_bb := mb.add_block(&mut b.body, cur_scope(&b))
        arm_count := e.c
        for ai in 0..arm_count {
            pat_id := f.expr_list[e.arg_start + ai * 3]
            guard_e := f.expr_list[e.arg_start + ai * 3 + 1]
            body_e := f.expr_list[e.arg_start + ai * 3 + 2]
            arm_bb := mb.add_block(&mut b.body, cur_scope(&b))
            next_arm_bb := if ai + 1 < arm_count { mb.add_block(&mut b.body, cur_scope(&b)) } else { join_bb }
            pat := &f.pats[pat_id]
            is_last_arm := ai + 1 >= arm_count
            if is_last_arm && guard_e < 0 {
                emit_goto(&mut b, arm_bb, pat.span_start, pat.span_end)
            } else if is_enum && pat.kind == .Variant && discr_op >= 0 {
                vals: []i64 = [i64(pat.tag)]
                bbs: []i32 = [arm_bb]
                sw := mb.push_switch_targets(&mut b.body, &vals, &bbs)
                _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                    kind: .SwitchInt, call_kind: .Direct, target_bb: next_arm_bb, place_or_op: discr_op,
                    callee: -1, sig_ty: -1, arg_start: sw, arg_len: 1,
                    in_unsafe: b.in_unsafe, span_start: pat.span_start, span_end: pat.span_end,
                })
            } else if pat.kind == .Lit {
                s_op := mb.add_op(&mut b.body, .Copy, subj_pl)
                vals: []i64 = [i64(pat.tag)]
                bbs: []i32 = [arm_bb]
                sw := mb.push_switch_targets(&mut b.body, &vals, &bbs)
                _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                    kind: .SwitchInt, call_kind: .Direct, target_bb: next_arm_bb, place_or_op: s_op,
                    callee: -1, sig_ty: -1, arg_start: sw, arg_len: 1,
                    in_unsafe: b.in_unsafe, span_start: pat.span_start, span_end: pat.span_end,
                })
            } else {
                emit_goto(&mut b, arm_bb, pat.span_start, pat.span_end)
            }
            b.cur_bb = arm_bb; b.terminated = false
            sid := push_scope(&mut b, .Lexical, -1, -1)
            arm_depth := b.scope_stack.len - 1
            if guard_e >= 0 && e.b == 1 {
                // Guard on `match move`: read bindings under a Shared borrow lock until the guard succeeds!
                lower_pat_bind(&mut b, &prog, &f, pat_id, subj_pl, false, true, false)
                lock_start := push_match_guard_locks(&mut b, &prog, &f, pat_id, arm_depth, pat.span_start, pat.span_end)
                g_op := lower_expr_to_op(&mut b, &prog, &f, guard_e)
                release_match_guard_locks(&mut b, &prog.types, lock_start, pat.span_start, pat.span_end)
                body_bb := mb.add_block(&mut b.body, sid)
                g_fail_bb := mb.add_block(&mut b.body, sid)
                g_vals: []i64 = [1]
                g_bbs: []i32 = [body_bb]
                g_sw := mb.push_switch_targets(&mut b.body, &g_vals, &g_bbs)
                _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                    kind: .SwitchInt, call_kind: .Direct, target_bb: g_fail_bb, place_or_op: g_op,
                    callee: -1, sig_ty: -1, arg_start: g_sw, arg_len: 1,
                    in_unsafe: b.in_unsafe, span_start: pat.span_start, span_end: pat.span_end,
                })
                b.cur_bb = g_fail_bb; b.terminated = false
                emit_unwind_to(&mut b, &prog.types, arm_depth, next_arm_bb, pat.span_start, pat.span_end)
                b.cur_bb = body_bb; b.terminated = false
                lower_pat_bind(&mut b, &prog, &f, pat_id, subj_pl, true, false, true)
            } else {
                lower_pat_bind(&mut b, &prog, &f, pat_id, subj_pl, e.b == 1, false, false)
                if guard_e >= 0 {
                    lock_start := push_match_guard_locks(&mut b, &prog, &f, pat_id, arm_depth, pat.span_start, pat.span_end)
                    g_op := lower_expr_to_op(&mut b, &prog, &f, guard_e)
                    release_match_guard_locks(&mut b, &prog.types, lock_start, pat.span_start, pat.span_end)
                    body_bb := mb.add_block(&mut b.body, sid)
                    g_fail_bb := mb.add_block(&mut b.body, sid)
                    g_vals: []i64 = [1]
                    g_bbs: []i32 = [body_bb]
                    g_sw := mb.push_switch_targets(&mut b.body, &g_vals, &g_bbs)
                    _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                        kind: .SwitchInt, call_kind: .Direct, target_bb: g_fail_bb, place_or_op: g_op,
                        callee: -1, sig_ty: -1, arg_start: g_sw, arg_len: 1,
                        in_unsafe: b.in_unsafe, span_start: pat.span_start, span_end: pat.span_end,
                    })
                    b.cur_bb = g_fail_bb; b.terminated = false
                    emit_unwind_to(&mut b, &prog.types, arm_depth, next_arm_bb, pat.span_start, pat.span_end)
                    b.cur_bb = body_bb; b.terminated = false
                }
            }
            if body_e >= 0 {
                lower_expr_into(&mut b, &prog, &f, body_e, dest_place)
            }
            if !b.terminated {
                emit_unwind_to(&mut b, &prog.types, arm_depth, join_bb, pat.span_start, pat.span_end)
            }
            pop_scope(&mut b)
            b.cur_bb = next_arm_bb; b.terminated = false
        }
        if !b.terminated && b.cur_bb != join_bb {
            emit_goto(&mut b, join_bb, e.span_start, e.span_end)
        }
        b.cur_bb = join_bb; b.terminated = false
    } else if e.kind == .Replace {
        // replace(place, new_val) -> old_val (strict L-to-R: evaluate new_val before atomic replace!)
        target_pl := lower_place(&mut b, &prog, &f, e.a)
        new_tmp := new_temp(&mut b, &prog.types, e.ty, e.span_start, e.span_end)
        new_tmp_pl := mb.add_local_place(&mut b.body, new_tmp)
        lower_expr_into(&mut b, &prog, &f, e.b, new_tmp_pl)
        op_k: mb.OpKind = if ht.is_copy(&prog.types, e.ty) { .Copy } else { .Move }
        old_op := mb.add_op(&mut b.body, op_k, target_pl)
        rv_old := mb.add_rvalue(&mut b.body, .Use, e.ty, old_op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv_old, aux: 1, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
        new_op := mb.add_op(&mut b.body, op_k, new_tmp_pl)
        rv_new := mb.add_rvalue(&mut b.body, .Use, e.ty, new_op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: target_pl, rvalue: rv_new, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    } else if e.kind == .Swap {
        pl_a := lower_place(&mut b, &prog, &f, e.a)
        pl_b := lower_place(&mut b, &prog, &f, e.b)
        aty := b.body.places[pl_a].ty
        tmp := new_temp(&mut b, &prog.types, aty, e.span_start, e.span_end)
        tmp_pl := mb.add_local_place(&mut b.body, tmp)
        op_k: mb.OpKind = if ht.is_copy(&prog.types, aty) { .Copy } else { .Move }
        op_a := mb.add_op(&mut b.body, op_k, pl_a)
        rv_t := mb.add_rvalue(&mut b.body, .Use, aty, op_a, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt { kind: .Assign, place: tmp_pl, rvalue: rv_t, aux: 1, in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end })
        op_b := mb.add_op(&mut b.body, op_k, pl_b)
        rv_a := mb.add_rvalue(&mut b.body, .Use, aty, op_b, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt { kind: .Assign, place: pl_a, rvalue: rv_a, aux: 1, in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end })
        op_t := mb.add_op(&mut b.body, op_k, tmp_pl)
        rv_b := mb.add_rvalue(&mut b.body, .Use, aty, op_t, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt { kind: .Assign, place: pl_b, rvalue: rv_b, aux: 0, in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end })
    } else if e.kind == .Try {
        // Early-return `?` on Result/Option: unwinds all scopes LIFO on Err/None branch!
        sub_ty := f.exprs[e.a].ty
        sub_tmp := new_temp(&mut b, &prog.types, sub_ty, e.span_start, e.span_end)
        sub_pl := mb.add_local_place(&mut b.body, sub_tmp)
        lower_expr_into(&mut b, &prog, &f, e.a, sub_pl)
        discr_loc := new_temp(&mut b, &prog.types, ht.TY_I32, e.span_start, e.span_end)
        discr_pl := mb.add_local_place(&mut b.body, discr_loc)
        sub_copy_op := mb.add_op(&mut b.body, .Copy, sub_pl)
        rv := mb.add_rvalue(&mut b.body, .Discriminant, ht.TY_I32, sub_copy_op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: discr_pl, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
        ok_bb := mb.add_block(&mut b.body, cur_scope(&b))
        err_bb := mb.add_block(&mut b.body, cur_scope(&b))
        d_op := mb.add_op(&mut b.body, .Copy, discr_pl)
        vals: []i64 = [0]
        bbs: []i32 = [ok_bb]
        sw_start := mb.push_switch_targets(&mut b.body, &vals, &bbs)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .SwitchInt, call_kind: .Direct, target_bb: err_bb, place_or_op: d_op,
            callee: -1, sig_ty: -1, arg_start: sw_start, arg_len: 1,
            in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end,
        })
        // Err path: assign _ret and unwind all scopes LIFO -> Return
        b.cur_bb = err_bb; b.terminated = false
        ret_pl := mb.add_local_place(&mut b.body, 0)
        if b.body.ret_ty == sub_ty {
            sub_mv_op := mb.add_op(&mut b.body, if ht.is_copy(&prog.types, sub_ty) { .Copy } else { .Move }, sub_pl)
            rv_err := mb.add_rvalue(&mut b.body, .Use, b.body.ret_ty, sub_mv_op, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: ret_pl, rvalue: rv_err, aux: 0, in_unsafe: b.in_unsafe,
                span_start: e.span_start, span_end: e.span_end,
            })
        } else if b.body.ret_ty >= 0 && b.body.ret_ty < prog.types.entries.len &&
            prog.types.entries[b.body.ret_ty].kind == .Enum &&
            prog.types.entries[b.body.ret_ty].count >= 2 {
            // Repackage Err(err_payload) or None into caller's Result<T2, E> / Option<T2>!
            ret_v1 := &prog.types.variants[prog.types.entries[b.body.ret_ty].inner_a + 1]
            mut err_ops: []i32 = []
            if ret_v1.payload_count == 1 && sub_ty >= 0 && sub_ty < prog.types.entries.len &&
                prog.types.entries[sub_ty].kind == .Enum && prog.types.entries[sub_ty].count >= 2 {
                sub_err_ty := ht.variant_payload_type(&prog.types, sub_ty, 1, 0)
                ret_err_ty := ht.variant_payload_type(&prog.types, b.body.ret_ty, 1, 0)
                if sub_err_ty >= 0 && sub_err_ty == ret_err_ty {
                    dc_e := mb.add_projected_place(&mut b.body, sub_pl, .Downcast, 1, sub_ty)
                    pay_e := mb.add_projected_place(&mut b.body, dc_e, .Field, 0, sub_err_ty)
                    err_ops.push(mb.add_op(&mut b.body, if ht.is_copy(&prog.types, sub_err_ty) { .Copy } else { .Move }, pay_e))
                }
            }
            if err_ops.len == ret_v1.payload_count {
                rv_err := mb.add_rvalue(&mut b.body, .Aggregate, b.body.ret_ty, 1, 0, &err_ops)
                _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                    kind: .Assign, place: ret_pl, rvalue: rv_err, aux: 0, in_unsafe: b.in_unsafe,
                    span_start: e.span_start, span_end: e.span_end,
                })
            }
        }
        ret_bb := mb.add_block(&mut b.body, 0)
        emit_unwind_to(&mut b, &prog.types, 0, ret_bb, e.span_start, e.span_end)
        _ := mb.set_term(&mut b.body, ret_bb, mb.MirTerm {
            kind: .Return, call_kind: .Direct, target_bb: -1, place_or_op: -1, callee: -1, sig_ty: -1,
            arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: e.span_start, span_end: e.span_end,
        })
        // Ok path: extract payload 0 into dest_place
        b.cur_bb = ok_bb; b.terminated = false
        dc := mb.add_projected_place(&mut b.body, sub_pl, .Downcast, 0, sub_ty)
        pay := mb.add_projected_place(&mut b.body, dc, .Field, 0, e.ty)
        p_op := mb.add_op(&mut b.body, if ht.is_copy(&prog.types, e.ty) { .Copy } else { .Move }, pay)
        rv_ok := mb.add_rvalue(&mut b.body, .Use, e.ty, p_op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dest_place, rvalue: rv_ok, aux: 0, in_unsafe: b.in_unsafe,
            span_start: e.span_start, span_end: e.span_end,
        })
    }
    b.in_unsafe = prev_unsafe
}

fn collect_pat_bind_locals(b: &Builder, f: &hb.HirFn, pat_id: i32, out: &mut []i32) {
    if pat_id < 0 || pat_id >= f.pats.len { return }
    pat := &f.pats[pat_id]
    if pat.kind == .Bind && pat.local_id >= 0 && pat.local_id < b.hir_to_mir.len {
        out.push(b.hir_to_mir[pat.local_id])
    } else if pat.kind == .Variant || pat.kind == .Tuple || pat.kind == .Struct {
        for i in 0..pat.child_len {
            collect_pat_bind_locals(&b, &f, f.pat_list[pat.child_start + i], &mut out)
        }
    }
}

fn push_match_guard_locks(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn,
    pat_id: i32, arm_depth: i32, span_s: i32, span_e: i32) -> i32 {
    start := b.guard_lock_locals.len
    mut bound: []i32 = []
    collect_pat_bind_locals(&b, &f, pat_id, &mut bound)
    empty_ops: []i32 = []
    for i in 0..bound.len {
        ml := bound[i]
        pty := b.body.locals[ml].ty
        if ht.is_copy(&prog.types, pty) && b.body.locals[ml].flags.bit_and(mb.LF_MUT) == 0 {
            continue
        }
        ref_ty := ht.find_ref(&prog.types, pty)
        if ref_ty < 0 { continue }
        lock_tmp := new_temp(&mut b, &prog.types, ref_ty, span_s, span_e)
        lock_pl := mb.add_local_place(&mut b.body, lock_tmp)
        ml_pl := mb.add_local_place(&mut b.body, ml)
        rel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
        ln := mb.add_loan(&mut b.body, ml_pl, .Shared, b.cur_bb, rel, b.cur_region_scope, -1, span_s, span_e)
        rv := mb.add_rvalue(&mut b.body, .Ref, ref_ty, ln, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: lock_pl, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: span_s, span_end: span_e,
        })
        b.guard_lock_locals.push(lock_tmp)
        b.guard_lock_depths.push(arm_depth)
    }
    start
}

fn release_match_guard_locks(b: &mut Builder, types: &ht.TypeTable, lock_start: i32, span_s: i32, span_e: i32) {
    empty_ops: []i32 = []
    if !b.terminated {
        mut i := b.guard_lock_locals.len - 1
        while i >= lock_start {
            lk := b.guard_lock_locals[i]
            lk_ty := b.body.locals[lk].ty
            sink_tmp := new_temp(&mut b, &types, lk_ty, span_s, span_e)
            sink_pl := mb.add_local_place(&mut b.body, sink_tmp)
            lk_pl := mb.add_local_place(&mut b.body, lk)
            lk_op := mb.add_op(&mut b.body, .Copy, lk_pl)
            lk_rv := mb.add_rvalue(&mut b.body, .Use, lk_ty, lk_op, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: sink_pl, rvalue: lk_rv, aux: 0, in_unsafe: b.in_unsafe,
                span_start: span_s, span_end: span_e,
            })
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .StorageDead, place: sink_tmp, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
                span_start: span_s, span_end: span_e,
            })
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .StorageDead, place: lk, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
                span_start: span_s, span_end: span_e,
            })
            i -= 1
        }
    }
    while b.guard_lock_locals.len > lock_start {
        _ := b.guard_lock_locals.pop()
        _ := b.guard_lock_depths.pop()
    }
}

fn lower_pat_bind(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn, pat_id: i32, subj_pl: i32, is_move: bool, for_guard: bool, commit_only: bool) {
    if pat_id < 0 || pat_id >= f.pats.len { return }
    pat := &f.pats[pat_id]
    empty_ops: []i32 = []
    if pat.kind == .Bind && pat.local_id >= 0 && pat.local_id < b.hir_to_mir.len {
        ml := b.hir_to_mir[pat.local_id]
        dst_pl := mb.add_local_place(&mut b.body, ml)
        pty := b.body.places[subj_pl].ty
        do_move := !for_guard && (is_move || pat.is_move_bind) && !ht.is_copy(&prog.types, pty)
        if commit_only {
            if !do_move { return }
            op := mb.add_op(&mut b.body, .Move, subj_pl)
            rv := mb.add_rvalue(&mut b.body, .Use, pty, op, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: dst_pl, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
                span_start: pat.span_start, span_end: pat.span_end,
            })
            return
        }
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .StorageLive, place: ml, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
            span_start: pat.span_start, span_end: pat.span_end,
        })
        op_k: mb.OpKind = if do_move { .Move } else { .Copy }
        op := mb.add_op(&mut b.body, op_k, subj_pl)
        rv := mb.add_rvalue(&mut b.body, .Use, pty, op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: dst_pl, rvalue: rv, aux: 0, in_unsafe: b.in_unsafe,
            span_start: pat.span_start, span_end: pat.span_end,
        })
        if do_move {
            register_scope_local(&mut b, &prog.types, ml)
        } else {
            b.scope_all_locals.push(ml)
        }
    } else if pat.kind == .Variant {
        subj_ty := b.body.places[subj_pl].ty
        if subj_ty >= 0 && subj_ty < prog.types.entries.len && prog.types.entries[subj_ty].kind == .Enum {
            dc := mb.add_projected_place(&mut b.body, subj_pl, .Downcast, pat.tag, subj_ty)
            for i in 0..pat.child_len {
                cid := f.pat_list[pat.child_start + i]
                pty := ht.variant_payload_type(&prog.types, subj_ty, pat.tag, i)
                if pty >= 0 {
                    pay := mb.add_projected_place(&mut b.body, dc, .Field, i, pty)
                    lower_pat_bind(&mut b, &prog, &f, cid, pay, is_move, for_guard, commit_only)
                }
            }
        }
    } else if pat.kind == .Tuple {
        subj_ty := b.body.places[subj_pl].ty
        for i in 0..pat.child_len {
            cid := f.pat_list[pat.child_start + i]
            fty := ht.field_type(&prog.types, subj_ty, i)
            if fty >= 0 {
                fpl := mb.add_projected_place(&mut b.body, subj_pl, .Field, i, fty)
                lower_pat_bind(&mut b, &prog, &f, cid, fpl, is_move, for_guard, commit_only)
            }
        }
    } else if pat.kind == .Struct {
        subj_ty := b.body.places[subj_pl].ty
        for i in 0..pat.child_len {
            cid := f.pat_list[pat.child_start + i]
            fidx := f.pats[cid].tag
            fty := ht.field_type(&prog.types, subj_ty, fidx)
            if fty >= 0 {
                fpl := mb.add_projected_place(&mut b.body, subj_pl, .Field, fidx, fty)
                lower_pat_bind(&mut b, &prog, &f, cid, fpl, is_move, for_guard, commit_only)
            }
        }
    }
}

fn lower_block_stmt_with_tail(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn,
    stmt_id: i32, tail_expr_id: i32, dest_place: i32) {
    if b.terminated || stmt_id < 0 || stmt_id >= f.stmts.len { return }
    st := &f.stmts[stmt_id]
    prev_unsafe := b.in_unsafe
    if st.in_unsafe || st.kind == .UnsafeBlock { b.in_unsafe = true }

    sid := push_scope(&mut b, .Lexical, -1, -1)
    depth := b.scope_stack.len - 1
    // Pre-allocate Defer flags (initialized to 0 at block entry for loop reset) & shared defer_bbs,
    // while pushing each Defer scope AT its lexical statement position so LIFO drop order matches source!
    mut block_defers: []i32 = []
    for i in 0..st.stmt_len {
        child_id := f.stmt_list[st.stmt_start + i]
        if f.stmts[child_id].kind == .Defer {
            flag_loc := mb.add_local(&mut b.body, &prog.types, "_defer_flag_" + b.defers.len.str(),
                ht.TY_BOOL, sid, mb.LF_DEFER_FLAG.bit_or(mb.LF_MUT), st.span_start, st.span_end)
            unwind_loc := mb.add_local(&mut b.body, &prog.types, "_defer_route_" + b.defers.len.str(),
                ht.TY_I32, sid, mb.LF_TEMP.bit_or(mb.LF_MUT), st.span_start, st.span_end)
            entry_bb := mb.add_block(&mut b.body, sid)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .SetDeferActive, place: flag_loc, rvalue: -1, aux: 0,
                in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
            })
            if b.loops.len > 0 { b.loop_defer_flags.push(flag_loc) }
            di := b.defers.len
            b.defers.push(DeferInfo {
                scope_id: -1,
                hir_stmt: child_id,
                flag_local: flag_loc,
                unwind_local: unwind_loc,
                entry_bb: entry_bb,
                exit_bb: -1,
                route_vals: [],
                route_bbs: [],
                route_run_bbs: [],
                loop_depth: b.loops.len,
            })
            block_defers.push(di)
        }
    }
    for i in 0..st.stmt_len {
        if b.terminated { break }
        child_id := f.stmt_list[st.stmt_start + i]
        if f.stmts[child_id].kind == .Defer {
            for di_idx in 0..block_defers.len {
                di := block_defers[di_idx]
                if b.defers[di].hir_stmt == child_id {
                    _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                        kind: .SetDeferActive, place: b.defers[di].flag_local, rvalue: -1, aux: 1,
                        in_unsafe: b.in_unsafe, span_start: f.stmts[child_id].span_start, span_end: f.stmts[child_id].span_end,
                    })
                    d_sid := push_scope(&mut b, .Defer, b.defers[di].entry_bb, b.defers[di].flag_local)
                    b.defers[di].scope_id = d_sid
                    _ := push_scope(&mut b, .Lexical, -1, -1)
                }
            }
        } else {
            lower_stmt(&mut b, &prog, &f, child_id)
        }
    }
    // Evaluate trailing block expression INSIDE the block scope BEFORE unwinding locals!
    if tail_expr_id >= 0 && !b.terminated {
        lower_expr_into(&mut b, &prog, &f, tail_expr_id, dest_place)
    }
    fell_through := !b.terminated
    mut after_bb := -1
    if fell_through {
        after_bb = mb.add_block(&mut b.body, if b.scope_stack.len > 1 { b.scope_stack[depth - 1] } else { 0 })
        emit_unwind_to(&mut b, &prog.types, depth, after_bb, st.span_start, st.span_end)
    }
    // Lower each defer body per route so init/borrow analysis stays path-sensitive across normal vs early returns!
    for di_idx in 0..block_defers.len {
        di := block_defers[di_idx]
        saved_bb := b.cur_bb; saved_term := b.terminated
        d_stmt := &f.stmts[b.defers[di].hir_stmt]
        r_cnt := b.defers[di].route_bbs.len
        if r_cnt == 0 {
            b.cur_bb = b.defers[di].entry_bb
            b.terminated = false
            for j in 0..d_stmt.stmt_len {
                lower_stmt(&mut b, &prog, &f, f.stmt_list[d_stmt.stmt_start + j])
            }
            if !b.terminated {
                _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
                    kind: .Return, call_kind: .Direct, target_bb: -1, place_or_op: -1, callee: -1, sig_ty: -1,
                    arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: d_stmt.span_start, span_end: d_stmt.span_end,
                })
            }
        } else {
            for ri in 0..r_cnt {
                d_bb := if ri == 0 { b.defers[di].entry_bb } else { mb.add_block(&mut b.body, sid) }
                run_bb := b.defers[di].route_run_bbs[ri]
                res_bb := b.defers[di].route_bbs[ri]
                _ := mb.set_term(&mut b.body, run_bb, mb.MirTerm {
                    kind: .Goto, call_kind: .Direct, target_bb: d_bb, place_or_op: -1,
                    callee: -1, sig_ty: -1, arg_start: 0, arg_len: 0,
                    in_unsafe: b.in_unsafe, span_start: d_stmt.span_start, span_end: d_stmt.span_end,
                })
                b.cur_bb = d_bb
                b.terminated = false
                for j in 0..d_stmt.stmt_len {
                    lower_stmt(&mut b, &prog, &f, f.stmt_list[d_stmt.stmt_start + j])
                }
                if !b.terminated { emit_goto(&mut b, res_bb, d_stmt.span_start, d_stmt.span_end) }
            }
        }
        b.cur_bb = saved_bb; b.terminated = saved_term
    }
    while b.scope_stack.len > depth { pop_scope(&mut b) }
    if fell_through {
        b.cur_bb = after_bb
        b.terminated = false
    } else {
        b.terminated = true
    }
    b.in_unsafe = prev_unsafe
}

fn lower_stmt(b: &mut Builder, prog: &hb.HirProgram, f: &hb.HirFn, stmt_id: i32) {
    if b.terminated || stmt_id < 0 || stmt_id >= f.stmts.len { return }
    st := &f.stmts[stmt_id]
    prev_unsafe := b.in_unsafe
    if st.in_unsafe { b.in_unsafe = true }

    if st.kind == .Block || st.kind == .UnsafeBlock {
        lower_block_stmt_with_tail(&mut b, &prog, &f, stmt_id, -1, -1)
    } else if st.kind == .Let {
        ml := b.hir_to_mir[st.local_id]
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .StorageLive, place: ml, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
            span_start: st.span_start, span_end: st.span_end,
        })
        pl := mb.add_local_place(&mut b.body, ml)
        if st.expr_a >= 0 { lower_expr_into(&mut b, &prog, &f, st.expr_a, pl) }
        register_scope_local(&mut b, &prog.types, ml)
    } else if st.kind == .Assign {
        lhs_pl := lower_place(&mut b, &prog, &f, st.expr_a)
        lower_expr_into(&mut b, &prog, &f, st.expr_b, lhs_pl)
    } else if st.kind == .Expr {
        if st.expr_a >= 0 {
            ety := f.exprs[st.expr_a].ty
            tmp := new_temp(&mut b, &prog.types, ety, st.span_start, st.span_end)
            register_owned_local(&mut b, &prog.types, tmp)
            pl := mb.add_local_place(&mut b.body, tmp)
            lower_expr_into(&mut b, &prog, &f, st.expr_a, pl)
        }
    } else if st.kind == .Return {
        if st.expr_a >= 0 {
            ret_pl := mb.add_local_place(&mut b.body, 0)
            lower_expr_into(&mut b, &prog, &f, st.expr_a, ret_pl)
        }
        ret_bb := mb.add_block(&mut b.body, 0)
        emit_unwind_to(&mut b, &prog.types, 0, ret_bb, st.span_start, st.span_end)
        _ := mb.set_term(&mut b.body, ret_bb, mb.MirTerm {
            kind: .Return, call_kind: .Direct, target_bb: -1, place_or_op: -1, callee: -1, sig_ty: -1,
            arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
        })
        b.terminated = true
    } else if st.kind == .TaskScope {
        sid := push_scope(&mut b, .TaskScope, -1, -1)
        depth := b.scope_stack.len - 1
        body_bb := mb.add_block(&mut b.body, sid)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .TaskScopeEnter, call_kind: .Direct, target_bb: body_bb, place_or_op: -1,
            callee: sid, sig_ty: -1, arg_start: 0, arg_len: 0,
            in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
        })
        b.cur_bb = body_bb; b.terminated = false
        for i in 0..st.stmt_len { lower_stmt(&mut b, &prog, &f, f.stmt_list[st.stmt_start + i]) }
        after_bb := mb.add_block(&mut b.body, b.scope_stack[depth - 1])
        if !b.terminated { emit_unwind_to(&mut b, &prog.types, depth, after_bb, st.span_start, st.span_end) }
        pop_scope(&mut b)
        b.cur_bb = after_bb; b.terminated = false
    } else if st.kind == .RegionBlock {
        cap_op := if st.expr_a >= 0 { lower_expr_to_op(&mut b, &prog, &f, st.expr_a) } else { -1 }
        prev_reg := b.cur_region_scope
        sid := push_scope(&mut b, .Region, -1, -1)
        b.cur_region_scope = sid
        depth := b.scope_stack.len - 1
        body_bb := mb.add_block(&mut b.body, sid)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .RegionEnter, call_kind: .Direct, target_bb: body_bb, place_or_op: cap_op,
            callee: sid, sig_ty: -1, arg_start: 0, arg_len: 0,
            in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
        })
        b.cur_bb = body_bb; b.terminated = false
        for i in 0..st.stmt_len { lower_stmt(&mut b, &prog, &f, f.stmt_list[st.stmt_start + i]) }
        after_bb := mb.add_block(&mut b.body, b.scope_stack[depth - 1])
        if !b.terminated { emit_unwind_to(&mut b, &prog.types, depth, after_bb, st.span_start, st.span_end) }
        pop_scope(&mut b)
        b.cur_region_scope = prev_reg
        b.cur_bb = after_bb; b.terminated = false
    } else if st.kind == .While {
        head_bb := mb.add_block(&mut b.body, cur_scope(&b))
        body_bb := mb.add_block(&mut b.body, cur_scope(&b))
        exit_bb := mb.add_block(&mut b.body, cur_scope(&b))
        emit_goto(&mut b, head_bb, st.span_start, st.span_end)

        b.cur_bb = head_bb; b.terminated = false
        cond_op := lower_expr_to_op(&mut b, &prog, &f, st.expr_a)
        vals: []i64 = [1]
        bbs: []i32 = [body_bb]
        sw_start := mb.push_switch_targets(&mut b.body, &vals, &bbs)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .SwitchInt, call_kind: .Direct, target_bb: exit_bb, place_or_op: cond_op,
            callee: -1, sig_ty: -1, arg_start: sw_start, arg_len: 1,
            in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
        })

        b.loops.push(LoopInfo { continue_bb: head_bb, break_bb: exit_bb, scope_depth: b.scope_stack.len, defer_flags_start: b.loop_defer_flags.len })
        b.cur_bb = body_bb; b.terminated = false
        for i in 0..st.stmt_len { lower_stmt(&mut b, &prog, &f, f.stmt_list[st.stmt_start + i]) }
        if !b.terminated { emit_goto(&mut b, head_bb, st.span_start, st.span_end) }
        lp := b.loops.pop()
        // Note: any defer inside body_bb already emits SetDeferActive(flag, 0) at block entry on EVERY iteration!
        while b.loop_defer_flags.len > lp.defer_flags_start { _ := b.loop_defer_flags.pop() }
        b.cur_bb = exit_bb; b.terminated = false
    } else if st.kind == .ForIter {
        // Explicit ForIter desugaring (fixes S-4!):
        // mut iter_tmp = expr_a; loop { opt = next(&mut iter_tmp); switch discr(opt) { 0 => x = payload; body; goto head, _ => exit } }
        sid := push_scope(&mut b, .Lexical, -1, -1)
        depth := b.scope_stack.len - 1
        iter_ty := f.exprs[st.expr_a].ty
        iter_loc := mb.add_local(&mut b.body, &prog.types, "_iter", iter_ty, sid, mb.LF_MUT.bit_or(mb.LF_TEMP), st.span_start, st.span_end)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .StorageLive, place: iter_loc, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
            span_start: st.span_start, span_end: st.span_end,
        })
        iter_pl := mb.add_local_place(&mut b.body, iter_loc)
        lower_expr_into(&mut b, &prog, &f, st.expr_a, iter_pl)
        register_owned_local(&mut b, &prog.types, iter_loc)

        head_bb := mb.add_block(&mut b.body, sid)
        body_bb := mb.add_block(&mut b.body, sid)
        exit_bb := mb.add_block(&mut b.body, sid)
        emit_goto(&mut b, head_bb, st.span_start, st.span_end)

        b.cur_bb = head_bb; b.terminated = false
        next_fn := st.expr_b
        next_sig := if next_fn >= 0 && next_fn < prog.fns.len { prog.fns[next_fn].sig_ty } else { -1 }
        opt_ty := if next_sig >= 0 { ht.callable_ret(&prog.types, next_sig) } else { ht.TY_UNIT }
        mut_iter_ty := if next_sig >= 0 && ht.callable_param_count(&prog.types, next_sig) > 0 {
            prog.types.params[ht.callable_param_start(&prog.types, next_sig)].ty
        } else { iter_ty }

        empty_ops: []i32 = []
        mut call_args: []i32 = []
        if iter_ty >= 0 && iter_ty < prog.types.entries.len && prog.types.entries[iter_ty].kind == .MutRef {
            // `for v in &mut it`: reborrow `&mut *iter_pl` each iteration!
            deref_pl := mb.add_projected_place(&mut b.body, iter_pl, .Deref, 0, prog.types.entries[iter_ty].inner_a)
            ref_tmp := new_temp(&mut b, &prog.types, mut_iter_ty, st.span_start, st.span_end)
            ref_pl := mb.add_local_place(&mut b.body, ref_tmp)
            rel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
            ln := mb.add_loan(&mut b.body, deref_pl, .Mut, b.cur_bb, rel, b.cur_region_scope, -1, st.span_start, st.span_end)
            rv_ref := mb.add_rvalue(&mut b.body, .Ref, mut_iter_ty, ln, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: ref_pl, rvalue: rv_ref, aux: 0, in_unsafe: b.in_unsafe,
                span_start: st.span_start, span_end: st.span_end,
            })
            call_args.push(mb.add_op(&mut b.body, .Move, ref_pl))
        } else {
            ref_tmp := new_temp(&mut b, &prog.types, mut_iter_ty, st.span_start, st.span_end)
            ref_pl := mb.add_local_place(&mut b.body, ref_tmp)
            rel := b.body.blocks[b.cur_bb].stmt_end - b.body.blocks[b.cur_bb].stmt_start
            ln := mb.add_loan(&mut b.body, iter_pl, .Mut, b.cur_bb, rel, b.cur_region_scope, -1, st.span_start, st.span_end)
            rv_ref := mb.add_rvalue(&mut b.body, .Ref, mut_iter_ty, ln, -1, &empty_ops)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: ref_pl, rvalue: rv_ref, aux: 0, in_unsafe: b.in_unsafe,
                span_start: st.span_start, span_end: st.span_end,
            })
            call_args.push(mb.add_op(&mut b.body, .Move, ref_pl))
        }
        opt_tmp := new_temp(&mut b, &prog.types, opt_ty, st.span_start, st.span_end)
        opt_pl := mb.add_local_place(&mut b.body, opt_tmp)
        a_start := mb.push_call_args(&mut b.body, &call_args)
        check_bb := mb.add_block(&mut b.body, sid)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .Call, call_kind: .Direct, target_bb: check_bb, place_or_op: opt_pl,
            callee: next_fn, sig_ty: next_sig, arg_start: a_start, arg_len: 1,
            in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
        })
        b.cur_bb = check_bb
        discr_loc := new_temp(&mut b, &prog.types, ht.TY_I32, st.span_start, st.span_end)
        discr_pl := mb.add_local_place(&mut b.body, discr_loc)
        opt_copy_op := mb.add_op(&mut b.body, .Copy, opt_pl)
        rv_d := mb.add_rvalue(&mut b.body, .Discriminant, ht.TY_I32, opt_copy_op, -1, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: discr_pl, rvalue: rv_d, aux: 0, in_unsafe: b.in_unsafe,
            span_start: st.span_start, span_end: st.span_end,
        })
        d_op := mb.add_op(&mut b.body, .Copy, discr_pl)
        vals: []i64 = [0]
        bbs: []i32 = [body_bb]
        sw_start := mb.push_switch_targets(&mut b.body, &vals, &bbs)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .SwitchInt, call_kind: .Direct, target_bb: exit_bb, place_or_op: d_op,
            callee: -1, sig_ty: -1, arg_start: sw_start, arg_len: 1,
            in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
        })

        b.loops.push(LoopInfo { continue_bb: head_bb, break_bb: exit_bb, scope_depth: b.scope_stack.len, defer_flags_start: b.loop_defer_flags.len })
        b.cur_bb = body_bb; b.terminated = false
        if st.local_id >= 0 {
            x_loc := b.hir_to_mir[st.local_id]
            x_ty := b.body.locals[x_loc].ty
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .StorageLive, place: x_loc, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
                span_start: st.span_start, span_end: st.span_end,
            })
            dc := mb.add_projected_place(&mut b.body, opt_pl, .Downcast, 0, opt_ty)
            pay := mb.add_projected_place(&mut b.body, dc, .Field, 0, x_ty)
            p_op := mb.add_op(&mut b.body, if ht.is_copy(&prog.types, x_ty) { .Copy } else { .Move }, pay)
            rv_x := mb.add_rvalue(&mut b.body, .Use, x_ty, p_op, -1, &empty_ops)
            x_pl := mb.add_local_place(&mut b.body, x_loc)
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .Assign, place: x_pl, rvalue: rv_x, aux: 0, in_unsafe: b.in_unsafe,
                span_start: st.span_start, span_end: st.span_end,
            })
        }
        for i in 0..st.stmt_len { lower_stmt(&mut b, &prog, &f, f.stmt_list[st.stmt_start + i]) }
        if !b.terminated { emit_goto(&mut b, head_bb, st.span_start, st.span_end) }
        lp := b.loops.pop()
        while b.loop_defer_flags.len > lp.defer_flags_start { _ := b.loop_defer_flags.pop() }

        b.cur_bb = exit_bb; b.terminated = false
        after_bb := mb.add_block(&mut b.body, b.scope_stack[depth - 1])
        emit_unwind_to(&mut b, &prog.types, depth, after_bb, st.span_start, st.span_end)
        pop_scope(&mut b)
        b.cur_bb = after_bb; b.terminated = false
    } else if st.kind == .ForRange {
        sid := push_scope(&mut b, .Lexical, -1, -1)
        depth := b.scope_stack.len - 1
        mut idx_loc := -1
        mut idx_ty := ht.TY_I32
        if st.local_id >= 0 && st.local_id < b.hir_to_mir.len {
            idx_loc = b.hir_to_mir[st.local_id]
            idx_ty = b.body.locals[idx_loc].ty
            _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
                kind: .StorageLive, place: idx_loc, rvalue: -1, aux: 0, in_unsafe: b.in_unsafe,
                span_start: st.span_start, span_end: st.span_end,
            })
        } else {
            idx_loc = new_temp(&mut b, &prog.types, ht.TY_I32, st.span_start, st.span_end)
        }
        idx_pl := mb.add_local_place(&mut b.body, idx_loc)
        if st.expr_a >= 0 { lower_expr_into(&mut b, &prog, &f, st.expr_a, idx_pl) }
        end_tmp := new_temp(&mut b, &prog.types, idx_ty, st.span_start, st.span_end)
        end_pl := mb.add_local_place(&mut b.body, end_tmp)
        if st.expr_b >= 0 { lower_expr_into(&mut b, &prog, &f, st.expr_b, end_pl) }
        register_scope_local(&mut b, &prog.types, idx_loc)

        head_bb := mb.add_block(&mut b.body, sid)
        body_bb := mb.add_block(&mut b.body, sid)
        step_bb := mb.add_block(&mut b.body, sid)
        exit_bb := mb.add_block(&mut b.body, sid)
        emit_goto(&mut b, head_bb, st.span_start, st.span_end)

        b.cur_bb = head_bb; b.terminated = false
        cond_tmp := new_temp(&mut b, &prog.types, ht.TY_BOOL, st.span_start, st.span_end)
        cond_pl := mb.add_local_place(&mut b.body, cond_tmp)
        empty_ops: []i32 = []
        lhs_op := mb.add_op(&mut b.body, .Copy, idx_pl)
        rhs_op := mb.add_op(&mut b.body, .Copy, end_pl)
        rv_cmp := mb.add_rvalue(&mut b.body, .Binary, ht.TY_BOOL, lhs_op, rhs_op, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: cond_pl, rvalue: rv_cmp, aux: 10, in_unsafe: b.in_unsafe,
            span_start: st.span_start, span_end: st.span_end,
        })
        c_op := mb.add_op(&mut b.body, .Copy, cond_pl)
        vals: []i64 = [1]
        bbs: []i32 = [body_bb]
        sw_start := mb.push_switch_targets(&mut b.body, &vals, &bbs)
        _ := mb.set_term(&mut b.body, b.cur_bb, mb.MirTerm {
            kind: .SwitchInt, call_kind: .Direct, target_bb: exit_bb, place_or_op: c_op,
            callee: -1, sig_ty: -1, arg_start: sw_start, arg_len: 1,
            in_unsafe: b.in_unsafe, span_start: st.span_start, span_end: st.span_end,
        })

        b.loops.push(LoopInfo { continue_bb: step_bb, break_bb: exit_bb, scope_depth: b.scope_stack.len, defer_flags_start: b.loop_defer_flags.len })
        b.cur_bb = body_bb; b.terminated = false
        for i in 0..st.stmt_len { lower_stmt(&mut b, &prog, &f, f.stmt_list[st.stmt_start + i]) }
        if !b.terminated { emit_goto(&mut b, step_bb, st.span_start, st.span_end) }
        lp := b.loops.pop()
        while b.loop_defer_flags.len > lp.defer_flags_start { _ := b.loop_defer_flags.pop() }

        b.cur_bb = step_bb; b.terminated = false
        one_c := mb.add_const(&mut b.body, idx_ty, 1, "")
        one_op := mb.add_op(&mut b.body, .Const, one_c)
        cur_op := mb.add_op(&mut b.body, .Copy, idx_pl)
        rv_inc := mb.add_rvalue(&mut b.body, .Binary, idx_ty, cur_op, one_op, &empty_ops)
        _ := mb.push_stmt(&mut b.body, b.cur_bb, mb.MirStmt {
            kind: .Assign, place: idx_pl, rvalue: rv_inc, aux: 1, in_unsafe: b.in_unsafe,
            span_start: st.span_start, span_end: st.span_end,
        })
        emit_goto(&mut b, head_bb, st.span_start, st.span_end)

        b.cur_bb = exit_bb; b.terminated = false
        after_bb := mb.add_block(&mut b.body, b.scope_stack[depth - 1])
        emit_unwind_to(&mut b, &prog.types, depth, after_bb, st.span_start, st.span_end)
        pop_scope(&mut b)
        b.cur_bb = after_bb; b.terminated = false
    } else if st.kind == .Break {
        if b.loops.len > 0 {
            lp := b.loops[b.loops.len - 1]
            emit_unwind_to(&mut b, &prog.types, lp.scope_depth, lp.break_bb, st.span_start, st.span_end)
        }
    } else if st.kind == .Continue {
        if b.loops.len > 0 {
            lp := b.loops[b.loops.len - 1]
            emit_unwind_to(&mut b, &prog.types, lp.scope_depth, lp.continue_bb, st.span_start, st.span_end)
        }
    }
    b.in_unsafe = prev_unsafe
}

pub fn build_body(prog: &hb.HirProgram, fn_id: i32, diags: &mut []diag.Diagnostic) -> mb.MirBody {
    f := &prog.fns[fn_id]
    path := if f.owner_mod >= 0 && f.owner_mod < prog.mod_paths.len { prog.mod_paths[f.owner_mod].clone() } else { "" }
    mut body := mb.new_body(f.id, f.owner_mod, f.name, path, f.sig_ty, f.ret_ty, f.param_count, f.is_unsafe)

    // Local 0 is always _ret
    _ := mb.add_local(&mut body, &prog.types, "_ret", f.ret_ty, 0, mb.LF_MUT, f.span_start, f.span_end)

    mut hir_to_mir: []i32 = []
    for i in 0..f.locals.len {
        hl := &f.locals[i]
        mut fl: i64 = mb.LF_USER
        if hl.is_mut { fl = fl.bit_or(mb.LF_MUT) }
        if hl.is_param { fl = fl.bit_or(mb.LF_PARAM) }
        if hl.mode == .MoveVal { fl = fl.bit_or(mb.LF_MOVE_PARAM) }
        ml := mb.add_local(&mut body, &prog.types, hl.name, hl.ty, 0, fl, hl.span_start, hl.span_end)
        hir_to_mir.push(ml)
    }

    entry_bb := mb.add_block(&mut body, 0)
    mut b := Builder {
        body: move body,
        cur_bb: entry_bb,
        terminated: false,
        hir_to_mir: move hir_to_mir,
        scope_stack: [0],
        scope_owned_starts: [0],
        scope_owned_locals: [],
        scope_all_starts: [0],
        scope_all_locals: [],
        defers: [],
        loops: [],
        loop_defer_flags: [],
        guard_lock_locals: [],
        guard_lock_depths: [],
        cur_region_scope: -1,
        in_unsafe: f.is_unsafe,
    }
    // Register move-params in root scope 0 for cleanup on exit.
    for i in 0..f.param_count {
        if i < f.locals.len && f.locals[i].mode == .MoveVal {
            register_owned_local(&mut b, &prog.types, b.hir_to_mir[i])
        }
    }

    if f.body_stmt >= 0 {
        lower_stmt(&mut b, &prog, &f, f.body_stmt)
    }
    if !b.terminated {
        ret_bb := mb.add_block(&mut b.body, 0)
        emit_unwind_to(&mut b, &prog.types, 0, ret_bb, f.span_start, f.span_end)
        _ := mb.set_term(&mut b.body, ret_bb, mb.MirTerm {
            kind: .Return, call_kind: .Direct, target_bb: -1, place_or_op: -1, callee: -1, sig_ty: -1,
            arg_start: 0, arg_len: 0, in_unsafe: b.in_unsafe, span_start: f.span_start, span_end: f.span_end,
        })
    }

    mb.compute_preds(&mut b.body)
    _ := diags.len
    b.body
}
