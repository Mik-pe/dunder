// Shared source-language rules used by both the full compiler and the
// bounded typed-model parser. Keep diagnostics at the calling source parser.
import std.parse as integers

// Reuse the parser's existing result. Returning another record would allocate
// an extra owned aggregate for every literal in both compilation paths.
pub fn validate_signed(parsed: &mut integers.Integer, expected: i32) -> i32 {
    var ty := 1; if expected == 2 { ty = 2 }
    if parsed.ok && ty == 1 && (parsed.value < -2147483648 || parsed.value > 2147483647) {
        parsed.ok = false; parsed.error = 2
    }
    ty
}
fn radix_digit(byte: i32, radix: i32) -> i32 {
    if byte >= 48 && byte <= 57 {
        d := byte - 48
        if d < radix { return d }
        return -1
    }
    if radix == 16 {
        if byte >= 65 && byte <= 70 { return byte - 55 }
        if byte >= 97 && byte <= 102 { return byte - 87 }
    }
    -1
}
// Parse a signed decimal, hex (0x/0X), or binary (0b/0B) integer literal.
pub fn literal_integer(text: string) -> integers.Integer {
    if text.len == 0 { return integers.Integer { ok: false, value: 0, error: 1 } }
    var cursor := 0
    var negative := false
    if text[0] == 45 || text[0] == 43 { negative = text[0] == 45; cursor = 1 }
    if cursor + 1 < text.len && text[cursor] == 48 {
        prefix := text[cursor + 1]
        var radix := 0
        if prefix == 120 || prefix == 88 { radix = 16 }
        else if prefix == 98 || prefix == 66 { radix = 2 }
        if radix != 0 {
            cursor = cursor + 2
            if cursor >= text.len { return integers.Integer { ok: false, value: 0, error: 1 } }
            var limit: i64 = -9223372036854775807
            if negative { limit = -9223372036854775808 }
            var value: i64 = 0
            var previous_digit := false
            while cursor < text.len {
                byte := text[cursor]
                if byte == 95 {
                    if !previous_digit || cursor + 1 == text.len || radix_digit(text[cursor + 1], radix) < 0 {
                        return integers.Integer { ok: false, value: 0, error: 1 }
                    }
                    previous_digit = false
                } else {
                    d := radix_digit(byte, radix)
                    if d < 0 { return integers.Integer { ok: false, value: 0, error: 1 } }
                    if value < limit / i64(radix) { return integers.Integer { ok: false, value: 0, error: 2 } }
                    value = value * i64(radix)
                    if value < limit + i64(d) { return integers.Integer { ok: false, value: 0, error: 2 } }
                    value = value - i64(d)
                    previous_digit = true
                }
                cursor = cursor + 1
            }
            if !previous_digit { return integers.Integer { ok: false, value: 0, error: 1 } }
            if !negative { value = -value }
            return integers.Integer { ok: true, value: value, error: 0 }
        }
    }
    integers.integer(text)
}
pub fn reserved(name: string) -> bool {
    name == "TaskID" || name == "print" || name == "assert" || name == "i32" || name == "i64" || name == "bool" || name == "string" || name == "len" || name == "f32" || name == "f64" || name == "rune" || name == "range" || name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "usize"
}
pub fn identifier(name: string) -> bool {
    if name == "" { return false }
    for i in 0..name.len {
        byte := name[i]
        letter := (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
        if !letter && !(i > 0 && byte >= 48 && byte <= 57) { return false }
    }
    true
}
pub fn precedence(word: string) -> i32 {
    if word == "||" { return 1 }; if word == "&&" { return 2 }
    if word == "==" || word == "!=" { return 3 }
    if word == "<" || word == "<=" || word == ">" || word == ">=" { return 4 }
    if word == "+" || word == "-" { return 5 }
    if word == "*" || word == "/" || word == "%" { return 6 }; 0
}
pub fn opcode(word: string) -> i32 {
    if word == "+" { return 1 }; if word == "-" { return 2 }; if word == "*" { return 3 }
    if word == "/" { return 4 }; if word == "%" { return 5 }; if word == "==" { return 6 }
    if word == "!=" { return 7 }; if word == "<" { return 8 }; if word == "<=" { return 9 }
    if word == ">" { return 10 }; if word == ">=" { return 11 }
    if word == "&&" { return 12 }; if word == "||" { return 13 }; 0
}
@test fn shared_scalar_rules_preserve_width_names_and_operator_order() {
    for expected in [0, 1, 3] {
        var limit := integers.integer("2147483647")
        validate_signed(&mut limit, expected) == 1
        limit.ok
        limit.value == 2147483647
        limit.error == 0
        var too_wide := integers.integer("2147483648")
        validate_signed(&mut too_wide, expected) == 1
        !too_wide.ok
        too_wide.value == 2147483648
        too_wide.error == 2
        var minimum := integers.integer("-2147483648")
        validate_signed(&mut minimum, expected) == 1
        minimum.ok
        var too_negative := integers.integer("-2147483649")
        validate_signed(&mut too_negative, expected) == 1
        !too_negative.ok
        too_negative.value == -2147483649
        too_negative.error == 2
    }
    var wide := integers.integer("2147483648")
    validate_signed(&mut wide, 2) == 2
    wide.ok
    wide.error == 0
    var minimum := integers.integer("-9223372036854775808")
    validate_signed(&mut minimum, 2) == 2
    minimum.ok
    minimum.value == -9223372036854775808
    var separated := integers.integer("1_024")
    validate_signed(&mut separated, 1) == 1
    separated.ok
    separated.value == 1024
    // Failed decimal parsing retains its exact value/error metadata, even if
    // the stored value would also fail the later width check.
    for spelling in ["9223372036854775808", "-9223372036854775809", "1__2", "", "+", " 2"] {
        for expected in [1, 2, 3] {
            var parsed := integers.integer(spelling)
            old_value := parsed.value; old_error := parsed.error
            chosen := validate_signed(&mut parsed, expected)
            if expected == 2 { chosen == 2 } else { chosen == 1 }
            !parsed.ok
            parsed.value == old_value
            parsed.error == old_error
        }
    }
    var failed := integers.Integer { ok: false, value: 2147483648, error: 77 }
    validate_signed(&mut failed, 1) == 1
    !failed.ok
    failed.value == 2147483648
    failed.error == 77
    identifier("value_42")
    identifier("i32")
    reserved("i32")
    !identifier("42value")
    !identifier("hälsa")
    !identifier("")
    precedence("||") < precedence("&&")
    precedence("+") < precedence("*")
    precedence("..") == 0
    opcode("%") == 5
    opcode("||") == 13
    opcode("unknown") == 0
    literal_integer("0xff").value == 255
    literal_integer("-0xff").value == -255
    literal_integer("0X7fff_ffff_ffff_ffff").value == 9223372036854775807
    literal_integer("-0x8000_0000_0000_0000").value == -9223372036854775808
    literal_integer("0x8000_0000_0000_0000").error == 2
    literal_integer("0b1010_0101").value == 165
    literal_integer("-0B101").value == -5
    !literal_integer("0x").ok
    !literal_integer("0b").ok
    !literal_integer("0x_1").ok
    !literal_integer("0b10_").ok
    literal_integer("1_024").value == 1024
}
