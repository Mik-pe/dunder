    if label=="negate" {ins=140}else if label=="ceil" {ins=141}else if label=="floor" {ins=142}
    else if label=="trunc" {ins=143}else if label=="round_ties_even" {ins=144}else if label=="sqrt" {ins=145}
    decode_fp(&mut c,ty);if ty==7 {ins=ins+14};op(&mut c,ins);encode_fp(&mut c,ty)
