    }
    if label=="round" {
        // Compare the fractional magnitude with exactly 0.5 before adding a
        // unit. Adding 0.5 to the original first can round across the tie.
        var shift:=0; var half:i64=1056964608; var one:i64=1065353216
        if ty==7 {shift=14;half=4602678819172646912;one=4607182418800017408}
        set(&mut c,c.temp)
        get(&mut c,c.temp);decode_fp(&mut c,ty);op(&mut c,139+shift)
        op(&mut c,142+shift);encode_fp(&mut c,ty);set(&mut c,c.temp+1)
        get(&mut c,c.temp);decode_fp(&mut c,ty);op(&mut c,139+shift)
        get(&mut c,c.temp+1);decode_fp(&mut c,ty);op(&mut c,147+shift)
        constant(&mut c,half);decode_fp(&mut c,ty)
        if ty==6 {op(&mut c,96)}else{op(&mut c,102)}
        op(&mut c,4);if ty==6 {op(&mut c,125)}else{op(&mut c,124)}
        get(&mut c,c.temp+1);decode_fp(&mut c,ty);constant(&mut c,one);decode_fp(&mut c,ty);op(&mut c,146+shift)
        op(&mut c,5);get(&mut c,c.temp+1);decode_fp(&mut c,ty);op(&mut c,11)
        get(&mut c,c.temp);decode_fp(&mut c,ty);op(&mut c,152+shift);encode_fp(&mut c,ty);return
    }
