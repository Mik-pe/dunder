pub fn short_begin(c:&mut Code,sign:string) {
    to_bool(&mut c);op(&mut c,4);op(&mut c,126)
    if sign=="||" {constant(&mut c,1);op(&mut c,5)}
}
pub fn short_end(c:&mut Code,sign:string) {
    if sign=="&&" {op(&mut c,5);constant(&mut c,0)}
    op(&mut c,11)
}
pub fn begin(c:&mut Code,kind:i32) {op(&mut c,kind);op(&mut c,64);c.depth=c.depth+1}
pub fn end(c:&mut Code) {op(&mut c,11);c.depth=c.depth-1}
pub fn loop_start(c:&mut Code,is_range:bool) {
    begin(&mut c,2);c.breaks.push(c.depth);begin(&mut c,3)
    c.continues.push(c.depth)
    if is_range {begin(&mut c,2);c.continues[c.continues.len-1]=c.depth}
}
pub fn loop_jump(c:&mut Code,again:bool,conditional:bool) {
    var level:=c.breaks[c.breaks.len-1];if again {level=c.continues[c.continues.len-1]}
    var instruction:=12;if conditional {instruction=13}
    indexed(&mut c,instruction,c.depth-level)
}
pub fn loop_end(c:&mut Code) {
    indexed(&mut c,12,0);end(&mut c);end(&mut c)
    old_break:=c.breaks.pop();old_next:=c.continues.pop()
}
pub fn invoke(c:&mut Code,id:i32) {op(&mut c,16);op(&mut c,-8-id)}
pub fn print_value(c:&mut Code,ty:i32) {
