fn value_type(ty:i32)->i32 { if ty==0 {return 0};if ty==6 {return 125};if ty==7 {return 124}; if ty==2 || ty==11 {return 126}; 127 }
pub fn host_arg(c:&mut Code,ty:i32) { if ty==6 || ty==7 {decode_fp(&mut c,ty)}else if value_type(ty)==127 {op(&mut c,167)} }
fn imported(c:&mut Code,id:i32)->i32 {
    for i in 0..c.imports.len { if c.imports[i]==id {return i} }
    c.imports.push(id);c.imports.len-1
