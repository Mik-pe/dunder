pub fn binary(c:&mut Code, sign:string, ty:i32) {
    a:=c.temp; b:=a+1; result:=b+1
    set(&mut c,b);set(&mut c,a);get(&mut c,a);get(&mut c,b)
    var instruction:=81
    if sign=="!=" {instruction=82} else if sign=="<" {instruction=83} else if sign==">" {instruction=85}
    else if sign=="<=" {instruction=87} else if sign==">=" {instruction=89}
    else if sign=="+" {instruction=124} else if sign=="-" {instruction=125} else if sign=="*" {instruction=126}
    else if sign=="/" {instruction=127} else if sign=="%" {instruction=129}
    if unsigned.has(ty) {
        if instruction==83 || instruction==85 || instruction==87 || instruction==89 || instruction==127 || instruction==129 {instruction=instruction+1}
        op(&mut c,instruction)
        if instruction<100 {op(&mut c,173);return}
        if sign=="/" || sign=="%" {return}
        set(&mut c,result)
        if sign=="+" {get(&mut c,result);get(&mut c,a);op(&mut c,84);check(&mut c)}
        else if sign=="-" {get(&mut c,a);get(&mut c,b);op(&mut c,84);check(&mut c)}
        else if width(ty)==64 {
            get(&mut c,b);op(&mut c,80);begin(&mut c,4);op(&mut c,5)
            get(&mut c,result);get(&mut c,b);op(&mut c,128);get(&mut c,a);op(&mut c,82);check(&mut c);end(&mut c)
        }
        get(&mut c,result)
        if width(ty)<64 {convert(&mut c,11,ty)}
        return
    }
    // The language traps for both MIN/-1 and MIN%-1, also for i32.
    if sign=="/" || sign=="%" {
        get(&mut c,a)
        if ty==1 {constant(&mut c,-2147483648)} else {constant(&mut c,-9223372036854775808)}
        op(&mut c,81);get(&mut c,b);constant(&mut c,-1);op(&mut c,81);op(&mut c,113);check(&mut c)
    }
    op(&mut c,instruction)
    if instruction<100 {op(&mut c,173);return}
    if ty==1 {narrow(&mut c);return}
    if sign=="/" || sign=="%" {return}
    set(&mut c,result)
    if sign=="*" {
        get(&mut c,b);op(&mut c,80);op(&mut c,4);op(&mut c,64);op(&mut c,5)
        get(&mut c,result);get(&mut c,b);op(&mut c,127);get(&mut c,a);op(&mut c,82);check(&mut c);op(&mut c,11)
    } else {
        get(&mut c,a)
        if sign=="+" {get(&mut c,result)} else {get(&mut c,b)}
        op(&mut c,133)
        if sign=="+" {get(&mut c,b)} else {get(&mut c,a)}
        get(&mut c,result);op(&mut c,133);op(&mut c,131);constant(&mut c,0);op(&mut c,83);check(&mut c)
