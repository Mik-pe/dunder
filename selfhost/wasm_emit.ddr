// Structured Wasm emitter for the scalar subset of the self-hosted checker.
// Internal expression values are i64. The public main and print imports use
// their source widths. Negative entries are symbolic calls, resolved after
// reachable bodies and host imports have been collected.
import std.bytes as bytes
import unsigned

pub struct Code {
    ops: []i32, starts: []i32, ids: []i32, locals: []i32, arities: []i32, results: []i32,
    imports: []i32, data: []i32, sigs: []i32, sig_starts: []i32, prints: []bool, temp: i32, depth: i32, breaks: []i32, continues: []i32,
}
pub fn new() -> Code {
    Code { ops: [], starts: [], ids: [], locals: [], arities: [], results: [],
           imports: [], data: [0], sigs: [], sig_starts: [], prints: [false, false, false, false, false, false, false], temp: 0, depth: 0, breaks: [], continues: [] }
}
pub fn scalar(ty:i32)->bool { ty==0 || ty==1 || ty==2 || ty==3 || ty==6 || ty==7 || unsigned.has(ty) || ty==13 }
pub fn start(c:&mut Code, id:i32, args:i32, ret:i32) {
    c.starts.push(c.ops.len); c.ids.push(id); c.arities.push(args); c.results.push(ret)
    c.temp=args; c.depth=0
}
pub fn finish_fn(c:&mut Code, slots:i32, ret:i32) {
    if ret!=0 { c.ops.push(0) }
    c.ops.push(11); c.locals.push(slots-c.temp)
}
fn uleb(out:&mut []i32, value:i32) {
    var n:=value
    while n>=128 { out.push(n%128+128); n=n/128 }
    out.push(n)
}
pub fn op(c:&mut Code, byte:i32) { c.ops.push(byte) }
pub fn indexed(c:&mut Code, byte:i32, index:i32) { c.ops.push(byte); uleb(&mut c.ops,index) }
pub fn constant(c:&mut Code,value:i64) {
    c.ops.push(66)
    var n:=value
    while true {
        low:=i32(n.bit_and(127))
        var next:=n/128
        if n<0 && low!=0 { next=next-1 }
        if (next==0 && low<64) || (next == -1 && low>=64) { c.ops.push(low); break }
        c.ops.push(low+128); n=next
    }
}
fn get(c:&mut Code,i:i32) { indexed(&mut c,32,i) }
fn set(c:&mut Code,i:i32) { indexed(&mut c,33,i) }
pub fn check(c:&mut Code) { c.ops.push(4);c.ops.push(64);c.ops.push(0);c.ops.push(11) }
pub fn to_bool(c:&mut Code) { c.ops.push(80);c.ops.push(69) }
pub fn narrow(c:&mut Code) {
    indexed(&mut c,34,c.temp)
    op(&mut c,167); op(&mut c,172)
