pub fn image(c:&Code,main_id:i32,libraries:&[]string,symbols:&[]string,starts:&[]i32,counts:&[]i32,params:&[]i32,rets:&[]i32)->[]u8 {
    var out:[]i32=[0,97,115,109,1,0,0,0]
    var b:[]i32=[];var imports:=0;var print_ids:[]i32=[]
    for used in c.prints {print_ids.push(imports);if used {imports=imports+1}}
    print_count:=imports; imports=imports+c.imports.len
    var ids:[]i32=[];for f in 0..libraries.len {ids.push(-1)}
    var main:=0
    uleb(&mut b,imports+c.ids.len+1+c.sig_starts.len)
    for tag in 0..7 {if c.prints[tag] {var val:=127;if tag==1 || tag==4 {val=126};if tag==5 {val=125};if tag==6 {val=124};sig(&mut b,1,val,0)}}
    for i in 0..c.imports.len {
