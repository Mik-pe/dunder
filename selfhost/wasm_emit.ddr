        for i in 0..7 {
            if c.prints[i] {
                name(&mut b,"dunder")
                if i==0 {name(&mut b,"print_i32")}else if i==1 {name(&mut b,"print_i64")}else if i==2 {name(&mut b,"print_bool")}else if i==3 {name(&mut b,"print_u32")}else if i==4 {name(&mut b,"print_u64")}else if i==5 {name(&mut b,"print_f32")}else{name(&mut b,"print_f64")}
