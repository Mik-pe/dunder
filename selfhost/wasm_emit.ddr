fn name(out:&mut []i32,s:string) {uleb(&mut out,s.len);bytes.append_text(&mut out,s)}
fn section(out:&mut []i32,kind:i32,payload:&[]i32) {
    out.push(kind);uleb(&mut out,payload.len);bytes.append(&mut out,&payload)
