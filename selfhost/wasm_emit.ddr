        }
        section(&mut out,2,&b)
    }
    b.clear();uleb(&mut b,c.ids.len+1)
    for i in 0..c.ids.len+1 {uleb(&mut b,imports+i)}
    section(&mut out,3,&b)
    b.clear();b.push(1);b.push(112);b.push(0);uleb(&mut b,c.imports.len+1);section(&mut out,4,&b)
    b.clear();b.push(1);b.push(0);uleb(&mut b,(c.data.len+65535)/65536);section(&mut out,5,&b)
    b.clear();b.push(3);name(&mut b,"main");b.push(0);uleb(&mut b,imports+c.ids.len)
    name(&mut b,"memory");b.push(2);b.push(0)
    name(&mut b,"__indirect_function_table");b.push(1);b.push(0);section(&mut out,7,&b)
    if c.imports.len>0 {
        b.clear();b.push(1);b.push(0);b.push(65);b.push(1);b.push(11);uleb(&mut b,c.imports.len)
        for id in c.imports {uleb(&mut b,ids[id])};section(&mut out,9,&b)
    }
    b.clear();uleb(&mut b,c.ids.len+1);var body:[]i32=[]
