fn max_unsigned(ty:i32)->i64 {
    if ty==12 {return 4294967295}
    unsigned.maximum(ty)
}
fn width(ty:i32)->i32 {
    if ty==1 || ty==12 || ty==13 {return 32}
    if ty==2 {return 64}
    unsigned.width(ty)
}
pub fn convert(c:&mut Code, from:i32, to:i32) {
    if from==to {return}
    if !unsigned.has(from) && unsigned.has(to) {
        indexed(&mut c,34,c.temp);constant(&mut c,0);op(&mut c,83);check(&mut c);get(&mut c,c.temp)
    }
    var max:i64= -1
    if unsigned.has(to) {max=max_unsigned(to)}
    else if unsigned.has(from) && to==1 {max=2147483647}
    else if unsigned.has(from) && to==2 {max=9223372036854775807}
    if max>=0 {
        indexed(&mut c,34,c.temp);constant(&mut c,max);op(&mut c,86);check(&mut c);get(&mut c,c.temp)
    }
    if to==1 {narrow(&mut c)}
}
pub fn method(c:&mut Code, label:string, ty:i32) {
    if label=="bit_not" {constant(&mut c,-1);op(&mut c,133)}
    else if label=="bit_and" {op(&mut c,131)}
    else if label=="bit_or" {op(&mut c,132)}
    else if label=="bit_xor" {op(&mut c,133)}
    else if label=="wrapping_add" {op(&mut c,124)}
    else if label=="wrapping_sub" {op(&mut c,125)}
    else if label=="wrapping_mul" {op(&mut c,126)}
    else {
        set(&mut c,c.temp);get(&mut c,c.temp);constant(&mut c,i64(width(ty)));op(&mut c,90);check(&mut c)
        if label=="shr" && ty==1 {op(&mut c,167);op(&mut c,173)}
        get(&mut c,c.temp);if label=="shl" {op(&mut c,134)}else{op(&mut c,136)}
    }
