    op(&mut c,81);check(&mut c);constant(&mut c,0);get(&mut c,c.temp);op(&mut c,125)
    if ty==1 {narrow(&mut c)}
}
fn decode_fp(c:&mut Code,ty:i32) { if ty==6 {op(&mut c,167);op(&mut c,190)}else{op(&mut c,191)} }
fn encode_fp(c:&mut Code,ty:i32) { if ty==6 {op(&mut c,188);op(&mut c,173)}else{op(&mut c,189)} }
pub fn float_cast(c:&mut Code,from:i32,to:i32) {
    if from==to {return}
    if from!=6 && from!=7 {
        var ins:=180;if to==7 {ins=185};if unsigned.has(from) {ins=ins+1}
        op(&mut c,ins);encode_fp(&mut c,to);return
    }
    decode_fp(&mut c,from)
    if to==6 || to==7 {if to==6 {op(&mut c,182)}else{op(&mut c,187)};encode_fp(&mut c,to);return}
    var ins:=174;if from==7 {ins=176};if unsigned.has(to) {ins=ins+1}
    op(&mut c,ins)
    if unsigned.has(to) {convert(&mut c,11,to)}else if to==1 {narrow(&mut c)}
}
pub fn float_binary(c:&mut Code,label:string,ty:i32) {
    set(&mut c,c.temp);decode_fp(&mut c,ty);get(&mut c,c.temp);decode_fp(&mut c,ty)
    var ins:=91
    if label=="!=" {ins=92}else if label=="<" {ins=93}else if label==">" {ins=94}
    else if label=="<=" {ins=95}else if label==">=" {ins=96}
    else if label=="+" {ins=146}else if label=="-" {ins=147}else if label=="*" {ins=148}else if label=="/" {ins=149}
    if ins<100 {if ty==7 {ins=ins+6};op(&mut c,ins);op(&mut c,173)}
    else {if ty==7 {ins=ins+14};op(&mut c,ins);encode_fp(&mut c,ty)}
}
pub fn float_method(c:&mut Code,label:string,ty:i32) {
    if label=="to_bits" {if ty==6 {op(&mut c,167);op(&mut c,172)};return}
    if label=="is_sign_negative" {if ty==6 {constant(&mut c,31)}else{constant(&mut c,63)};op(&mut c,136);return}
    if label=="is_nan" {
        set(&mut c,c.temp);get(&mut c,c.temp);decode_fp(&mut c,ty);get(&mut c,c.temp);decode_fp(&mut c,ty)
        if ty==6 {op(&mut c,92)}else{op(&mut c,98)};op(&mut c,173);return
    }
