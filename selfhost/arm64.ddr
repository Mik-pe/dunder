import std/bytes as bytes

pub struct Code { words: []i64, labels: []i32, at: []i32, target: []i32, kinds: []i32 }
pub fn new() -> Code { Code { words: [], labels: [], at: [], target: [], kinds: [] } }
pub fn emit(code: &mut Code, word: i64) { assert(word >= 0 && word <= 4294967295); code.words.push(word) }
pub fn label(code: &mut Code) -> i32 { value := code.labels.len; code.labels.push(-1); value }
pub fn mark(code: &mut Code, target: i32) { assert(code.labels[target] == -1); code.labels[target] = code.words.len }
// 0=B, 1=BL, 2..17=B.cond (condition+2), 18=CBZ x0, 19=CBNZ x0, 20=address x0.
pub fn branch(code: &mut Code, target: i32, kind: i32) {
    code.at.push(code.words.len); code.target.push(target); code.kinds.push(kind)
    emit(&mut code, 0)
    if kind >= 2 { emit(&mut code, 3573751839) }
}
pub fn imm(code: &mut Code, reg: i32, value: i64) {
    emit(&mut code, 3531603968 + value.bit_and(65535) * 32 + i64(reg))
    for part in 1..4 {
        bits := value.shr(part * 16).bit_and(65535)
        if bits != 0 { emit(&mut code, 4068474880 + i64(part) * 2097152 + bits * 32 + i64(reg)) }
    }
}
pub fn mov(code: &mut Code, destination: i32, source: i32) { emit(&mut code, 2852127712 + i64(source) * 65536 + i64(destination)) }
pub fn push(code: &mut Code, reg: i32) { emit(&mut code, 2847899616 + i64(reg)) }
pub fn pop(code: &mut Code, reg: i32) { emit(&mut code, 2831253472 + i64(reg)) }
pub fn load(code: &mut Code, slot: i32) {
    imm(&mut code, 9, i64(slot + 1) * 8)
    emit(&mut code, 3406365609); emit(&mut code, 4181721376)
}
pub fn store(code: &mut Code, slot: i32, reg: i32) {
    imm(&mut code, 9, i64(slot + 1) * 8)
    emit(&mut code, 3406365609); emit(&mut code, 4177527072 + i64(reg))
}
pub fn prologue(code: &mut Code) -> i32 {
    emit(&mut code, 2847898621); emit(&mut code, 2432697341)
    at := code.words.len
    emit(&mut code, 3506439167)
    at
}
pub fn frame(code: &mut Code, at: i32, slots: i32) {
    size := (slots * 8 + 15) / 16 * 16
    assert(size <= 4080)
    code.words[at] = 3506439167 + i64(size) * 1024
}
pub fn ret(code: &mut Code) { emit(&mut code, 2432697279); emit(&mut code, 2831252477); emit(&mut code, 3596551104) }
pub fn exit(code: &mut Code, status: i32) {
    imm(&mut code, 0, i64(status)); imm(&mut code, 16, 33554433); emit(&mut code, 3556773889); emit(&mut code, 3558866944)
}
pub fn finish(code: &mut Code) -> []i32 {
    for i in 0..code.at.len {
        at := code.at[i]; target := code.labels[code.target[i]]; kind := code.kinds[i]
        assert(target >= 0)
        delta := i64(target - at)
        if kind == 20 {
            from := 432 + at * 4; destination := 432 + target * 4
            pages := i64(destination / 4096 - from / 4096).bit_and(2097151)
            code.words[at] = 2415919104 + pages.bit_and(3) * 536870912 + pages.shr(2) * 32
            code.words[at + 1] = 2432696320 + i64(destination % 4096) * 1024
        } else if kind < 2 {
            assert(delta >= -33554432 && delta < 33554432)
            var base: i64 = 335544320
            if kind == 1 { base = 2483027968 }
            code.words[at] = base + delta.bit_and(67108863)
        } else {
            var base: i64 = 1409286144
            var inverse: i64 = 0
            if kind == 18 { base = 3019898880; inverse = 16777216 }
            else if kind == 19 { base = 3036676096; inverse = 16777216 }
            else { base = base + i64(kind - 2); inverse = 1 }
            if delta >= -262144 && delta < 262144 { code.words[at] = base + delta.bit_and(524287) * 32 }
            else {
                code.words[at] = base.bit_xor(inverse) + 64
                code.words[at + 1] = 335544320 + (delta - 1).bit_and(67108863)
            }
        }
    }
    var output: []i32 = []
    output.reserve(code.words.len * 4)
    for word in code.words { bytes.u32le(&mut output, word) }
    output
}
// Signed decimal formatting, bool/string output, short-write loops and traps.
pub fn runtime(code: &mut Code, integer: i32, boolean: i32, text_label: i32, write: i32, overflow: i32, zero: i32, assertion: i32, io: i32) {
    mark(&mut code, integer)
    frame_at := prologue(&mut code); frame(&mut code, frame_at, 8)
    emit(&mut code, 2432761825); imm(&mut code, 9, 10); emit(&mut code, 956301353)
    imm(&mut code, 2, 1); mov(&mut code, 3, 0); imm(&mut code, 4, 10); imm(&mut code, 7, 0)
    emit(&mut code, 3944677407)
    magnitude := label(&mut code); branch(&mut code, magnitude, 12)
    imm(&mut code, 7, 1); emit(&mut code, 3405972451)
    mark(&mut code, magnitude)
    digit := label(&mut code); mark(&mut code, digit)
    emit(&mut code, 2596538469); emit(&mut code, 2600766630); emit(&mut code, 285262022)
    emit(&mut code, 3506439201); emit(&mut code, 956301350); emit(&mut code, 2432697410); mov(&mut code, 3, 5)
    // CBNZ x3; use a generic comparison to keep branch relocations uniform.
    emit(&mut code, 4043309183); branch(&mut code, digit, 3)
    signed := label(&mut code); emit(&mut code, 4043309311); branch(&mut code, signed, 2)
    emit(&mut code, 3506439201); imm(&mut code, 9, 45); emit(&mut code, 956301353); emit(&mut code, 2432697410)
    mark(&mut code, signed); branch(&mut code, write, 1); ret(&mut code)

    mark(&mut code, boolean)
    bool_frame := prologue(&mut code); frame(&mut code, bool_frame, 2)
    falsity := label(&mut code); output := label(&mut code); branch(&mut code, falsity, 18)
    imm(&mut code, 9, 44651868788); imm(&mut code, 2, 5); branch(&mut code, output, 0)
    mark(&mut code, falsity); imm(&mut code, 9, 11430844457318); imm(&mut code, 2, 6)
    mark(&mut code, output); emit(&mut code, 4177527785); emit(&mut code, 2432697313); branch(&mut code, write, 1); ret(&mut code)

    mark(&mut code, text_label)
    string_frame := prologue(&mut code); frame(&mut code, string_frame, 2)
    emit(&mut code, 4181721090); emit(&mut code, 2432704513)
    empty := label(&mut code); emit(&mut code, 4043309151); branch(&mut code, empty, 2); branch(&mut code, write, 1)
    mark(&mut code, empty); imm(&mut code, 9, 10); emit(&mut code, 4177527785); emit(&mut code, 2432697313); imm(&mut code, 2, 1); branch(&mut code, write, 1); ret(&mut code)

    mark(&mut code, write)
    again := label(&mut code); mark(&mut code, again)
    imm(&mut code, 0, 1); imm(&mut code, 16, 33554436); emit(&mut code, 3556773889)
    branch(&mut code, io, 4); branch(&mut code, io, 18)
    emit(&mut code, 3405774914); emit(&mut code, 2332033057); emit(&mut code, 4043309151); branch(&mut code, again, 3); emit(&mut code, 3596551104)
    mark(&mut code, overflow); exit(&mut code, 101)
    mark(&mut code, zero); exit(&mut code, 102)
    mark(&mut code, assertion); exit(&mut code, 104)
    mark(&mut code, io); exit(&mut code, 74)
}
