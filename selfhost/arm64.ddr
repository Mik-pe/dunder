pub struct Code {
    words: []i64, labels: []i32, at: []i32, target: []i32, kinds: []i32, platform: i32,
    checking: bool, virtual_words: i32, virtual_labels: i32,
    profile: bool, effect_epoch: i64, effect_depth: i32,
}
pub fn new() -> Code { new_for(0) }
// Platform 0 is Darwin; platform 1 is Linux. Relocations use the image's text offset.
pub fn new_for(platform: i32) -> Code {
    Code { words: [], labels: [], at: [], target: [], kinds: [], platform: platform,
        checking: false, virtual_words: 0, virtual_labels: 0, profile: false, effect_epoch: 0, effect_depth: 0 }
}
// Semantic validation still walks the lowering helpers, but keeps no machine
// words, label positions or relocations. Virtual counters keep patch sites
// deterministic without allocating output for check-only or unreachable bodies.
pub fn new_check(platform: i32) -> Code { var code := new_for(platform); code.checking = true; code }
pub fn position(code: &Code) -> i32 { if code.checking { code.virtual_words } else { code.words.len } }
pub fn label_count(code: &Code) -> i32 { if code.checking { code.virtual_labels } else { code.labels.len } }
// Monotonic semantic evidence for frontend ownership proofs. Calls are barriers
// even when their implementation is currently pure; inline source writes and
// pointer exposures use this same hook. Rewriting code never rolls it back.
pub fn barrier(code: &mut Code) { if code.effect_depth > 0 { code.effect_epoch = code.effect_epoch + 1 } }
pub fn begin_effects(code: &mut Code) -> i64 { code.effect_depth = code.effect_depth + 1; code.effect_epoch }
pub fn end_effects(code: &mut Code, epoch: i64) -> bool {
    assert(code.effect_depth > 0)
    code.effect_depth = code.effect_depth - 1
    code.effect_epoch == epoch
}
pub fn emit(code: &mut Code, word: i64) {
    // Keep classification inline in this hot helper, with no per-word call.
    // Outside a string RHS there is no live ownership proof to invalidate.
    if code.effect_depth > 0 {
        family := word.shr(24)
        if word.bit_and(4227858432) == 2483027968 || // Native BL immediate.
            word.bit_and(4294966303) == 3594452992 || // BLR, any register.
            word.bit_and(4292870175) == 3556769793 || // SVC, any immediate.
            family == 251 || family == 252 || family == 254 { // Target call/host vocabulary.
            code.effect_epoch = code.effect_epoch + 1
        }
    }
    if code.checking { code.virtual_words = code.virtual_words + 1; return }
    assert(word >= 0 && word <= 4294967295); code.words.push(word)
}
pub fn patch(code: &mut Code, at: i32, word: i64) {
    // A patch can introduce an executable effect after its original emission.
    // Conservatively invalidate proofs instead of inferring the old opcode.
    barrier(&mut code)
    if code.checking { assert(at >= 0 && at < code.virtual_words); return }
    assert(word >= 0 && word <= 4294967295); code.words[at] = word
}
pub fn label(code: &mut Code) -> i32 {
    if code.checking { value := code.virtual_labels; code.virtual_labels = value + 1; return value }
    value := code.labels.len; code.labels.push(-1); value
}
pub fn mark(code: &mut Code, target: i32) {
    if code.checking { assert(target >= 0 && target < code.virtual_labels); return }
    assert(code.labels[target] == -1); code.labels[target] = code.words.len
}
// 0=B, 1=BL, 2..17=B.cond (condition+2), 18=CBZ x0, 19=CBNZ x0, 20=address x0.
pub fn branch(code: &mut Code, target: i32, kind: i32) {
    // The direct call is symbolic until finish_for patches its placeholder.
    if kind == 1 { barrier(&mut code) }
    if !code.checking { code.at.push(code.words.len); code.target.push(target); code.kinds.push(kind) }
    emit(&mut code, 0)
    if kind >= 2 { emit(&mut code, 3573751839) }
}
pub fn imm(code: &mut Code, reg: i32, value: i64) {
    emit(&mut code, 3531603968 + value.bit_and(65535) * 32 + i64(reg))
    for part in 1..4 {
        bits := value.shr(part * 16).bit_and(65535)
        if bits != 0 { emit(&mut code, 4068474880 + i64(part) * 2097152 + bits * 32 + i64(reg)) }
    }
}
pub fn mov(code: &mut Code, destination: i32, source: i32) {
    if destination != source { emit(&mut code, 2852127712 + i64(source) * 65536 + i64(destination)) }
}
pub fn push(code: &mut Code, reg: i32) { emit(&mut code, 2847899616 + i64(reg)) }
pub fn pop(code: &mut Code, reg: i32) { emit(&mut code, 2831253472 + i64(reg)) }
pub fn load(code: &mut Code, slot: i32) {
    // LDUR addresses the first 256 bytes directly relative to the frame pointer.
    if slot < 32 {
        emit(&mut code, 4164944800 + i64(-(slot + 1) * 8).bit_and(511) * 4096)
        return
    }
    if slot < 511 {
        emit(&mut code, 3506439081 + i64(slot + 1) * 8192)
        emit(&mut code, 4181721376)
        return
    }
    imm(&mut code, 9, i64(slot + 1) * 8)
    emit(&mut code, 3406365609); emit(&mut code, 4181721376)
}
pub fn store(code: &mut Code, slot: i32, reg: i32) {
    if slot < 32 {
        emit(&mut code, 4160750496 + i64(-(slot + 1) * 8).bit_and(511) * 4096 + i64(reg))
        return
    }
    if slot < 511 {
        emit(&mut code, 3506439081 + i64(slot + 1) * 8192)
        emit(&mut code, 4177527072 + i64(reg))
        return
    }
    imm(&mut code, 9, i64(slot + 1) * 8)
    emit(&mut code, 3406365609); emit(&mut code, 4177527072 + i64(reg))
}
pub fn prologue(code: &mut Code) -> i32 {
    emit(&mut code, 2847898621); emit(&mut code, 2432697341)
    at := position(&code)
    emit(&mut code, 3506439167)
    emit(&mut code, 3573751839)
    at
}
pub fn frame(code: &mut Code, at: i32, slots: i32) {
    size := (slots * 8 + 15) / 16 * 16
    assert(slots >= 0)
    assert(size <= 16777200)
    patch(&mut code, at, 3510633471 + i64(size / 4096) * 1024)
    patch(&mut code, at + 1, 3506439167 + i64(size % 4096) * 1024)
}
pub fn ret(code: &mut Code) { emit(&mut code, 2432697279); emit(&mut code, 2831252477); emit(&mut code, 3596551104) }
pub fn syscall(code: &mut Code, darwin: i64, linux: i64) {
    if code.platform != 0 { imm(&mut code, 8, linux); emit(&mut code, 3556769793) }
    else { imm(&mut code, 16, darwin); emit(&mut code, 3556773889) }
}
pub fn exit(code: &mut Code, status: i32) {
    imm(&mut code, 0, i64(status)); syscall(&mut code, 33554433, 94); emit(&mut code, 3558866944)
}
pub fn finish(code: &mut Code) -> []u8 { return finish_for(&mut code, false) }
pub fn finish_for(code: &mut Code, dynamic: bool) -> []u8 {
    assert(!code.checking)
    var text_offset: i32 = 432
    if code.platform != 0 { text_offset = 4096 } else if dynamic { text_offset = 16384 }
    for i in 0..code.at.len {
        at := code.at[i]; target := code.labels[code.target[i]]; kind := code.kinds[i]
        assert(target >= 0)
        delta := i64(target - at)
        if kind == 20 {
            from := text_offset + at * 4; destination := text_offset + target * 4
            pages := i64(destination / 4096 - from / 4096).bit_and(2097151)
            code.words[at] = 2415919104 + pages.bit_and(3) * 536870912 + pages.shr(2) * 32
            code.words[at + 1] = 2432696320 + i64(destination % 4096) * 1024
        } else if kind < 2 {
            assert(delta >= -33554432 && delta < 33554432)
            var base: i64 = 335544320
            if kind == 1 { base = 2483027968 }
            code.words[at] = base + delta.bit_and(67108863)
        } else {
            var base: i64 = 1409286144
            var inverse: i64 = 0
            if kind == 18 { base = 3019898880; inverse = 16777216 }
            else if kind == 19 { base = 3036676096; inverse = 16777216 }
            else { base = base + i64(kind - 2); inverse = 1 }
            if delta >= -262144 && delta < 262144 { code.words[at] = base + delta.bit_and(524287) * 32 }
            else {
                code.words[at] = base.bit_xor(inverse) + 64
                code.words[at + 1] = 335544320 + (delta - 1).bit_and(67108863)
            }
        }
    }
    var output: []u8 = []
    output.reserve(code.words.len * 4)
    var word: i32 = 0
    while word < code.words.len {
        value := code.words[word]
        output.push(u8(value.bit_and(255)))
        output.push(u8(value.shr(8).bit_and(255)))
        output.push(u8(value.shr(16).bit_and(255)))
        output.push(u8(value.shr(24).bit_and(255)))
        word = word + 1
    }
    output
}
// Signed decimal formatting, bool/string output, short-write loops and traps.
pub fn runtime(code: &mut Code, integer: i32, boolean: i32, text_label: i32, write: i32, overflow: i32, zero: i32, assertion: i32, io: i32) {
    mark(&mut code, integer)
    frame_at := prologue(&mut code); frame(&mut code, frame_at, 8)
    emit(&mut code, 2432761825); imm(&mut code, 9, 10); emit(&mut code, 956301353)
    imm(&mut code, 2, 1); mov(&mut code, 3, 0); imm(&mut code, 4, 10); imm(&mut code, 7, 0)
    magnitude := label(&mut code); emit(&mut code, 4043309343); branch(&mut code, magnitude, 3) // unsigned formatting
    emit(&mut code, 3944677407); branch(&mut code, magnitude, 12)
    imm(&mut code, 7, 1); emit(&mut code, 3405972451)
    mark(&mut code, magnitude)
    digit := label(&mut code); mark(&mut code, digit)
    emit(&mut code, 2596538469); emit(&mut code, 2600766630); emit(&mut code, 285262022)
    emit(&mut code, 3506439201); emit(&mut code, 956301350); emit(&mut code, 2432697410); mov(&mut code, 3, 5)
    // CBNZ x3; use a generic comparison to keep branch relocations uniform.
    emit(&mut code, 4043309183); branch(&mut code, digit, 3)
    signed := label(&mut code); emit(&mut code, 4043309311); branch(&mut code, signed, 2)
    emit(&mut code, 3506439201); imm(&mut code, 9, 45); emit(&mut code, 956301353); emit(&mut code, 2432697410)
    mark(&mut code, signed); branch(&mut code, write, 1); ret(&mut code)

    mark(&mut code, boolean)
    bool_frame := prologue(&mut code); frame(&mut code, bool_frame, 2)
    falsity := label(&mut code); output := label(&mut code); branch(&mut code, falsity, 18)
    imm(&mut code, 9, 44651868788); imm(&mut code, 2, 5); branch(&mut code, output, 0)
    mark(&mut code, falsity); imm(&mut code, 9, 11430844457318); imm(&mut code, 2, 6)
    mark(&mut code, output); emit(&mut code, 4177527785); emit(&mut code, 2432697313); branch(&mut code, write, 1); ret(&mut code)

    mark(&mut code, text_label)
    string_frame := prologue(&mut code); frame(&mut code, string_frame, 2)
    emit(&mut code, 4181721090); emit(&mut code, 2432704513)
    empty := label(&mut code); emit(&mut code, 4043309151); branch(&mut code, empty, 2); branch(&mut code, write, 1)
    mark(&mut code, empty); imm(&mut code, 9, 10); emit(&mut code, 4177527785); emit(&mut code, 2432697313); imm(&mut code, 2, 1); branch(&mut code, write, 1); ret(&mut code)

    mark(&mut code, write)
    again := label(&mut code); mark(&mut code, again)
    imm(&mut code, 0, 1); syscall(&mut code, 33554436, 64)
    if code.platform != 0 {
        // Linux returns negative errno; Darwin reports an error through carry.
        emit(&mut code, 4043309087); branch(&mut code, io, 13)
    } else { branch(&mut code, io, 4) }
    branch(&mut code, io, 18)
    emit(&mut code, 3405774914); emit(&mut code, 2332033057); emit(&mut code, 4043309151); branch(&mut code, again, 3); emit(&mut code, 3596551104)
    mark(&mut code, overflow); exit(&mut code, 101)
    mark(&mut code, zero); exit(&mut code, 102)
    mark(&mut code, assertion); exit(&mut code, 104)
    mark(&mut code, io); exit(&mut code, 74)
}

@test fn effect_epochs_cover_the_shared_call_vocabulary() {
    var code := new()
    destination := label(&mut code)
    initial := begin_effects(&mut code)
    emit(&mut code, 3573751839); branch(&mut code, destination, 0)
    branch(&mut code, destination, 18); branch(&mut code, destination, 20)
    code.effect_epoch == initial
    branch(&mut code, destination, 1)
    code.effect_epoch == initial + 1
    emit(&mut code, 2483027968); emit(&mut code, 2550136831)
    code.effect_epoch == initial + 3
    for reg in 0..32 { emit(&mut code, 3594452992 + i64(reg) * 32) }
    code.effect_epoch == initial + 35
    emit(&mut code, 3556769793); emit(&mut code, 3556773889); emit(&mut code, 3558866913)
    code.effect_epoch == initial + 38
    words: []i64 = [4211081216, 4227858432, 4261412864]
    for word in words {
        emit(&mut code, word); emit(&mut code, word + 16777215)
    }
    code.effect_epoch == initial + 44
    barrier(&mut code); code.effect_epoch == initial + 45
    patch(&mut code, 0, 3573751839); code.effect_epoch == initial + 46
    !end_effects(&mut code, initial)
    code.effect_depth == 0
}
@test fn checking_calls_keep_effect_evidence_without_words() {
    var code := new_check(3)
    initial := begin_effects(&mut code)
    destination := label(&mut code)
    branch(&mut code, destination, 1); emit(&mut code, 4211081223); syscall(&mut code, 1, 2)
    code.effect_epoch == 3
    code.words.len == 0
    !end_effects(&mut code, initial)
}
@test fn nested_effect_observation_keeps_outer_evidence_and_ignores_unobserved_calls() {
    var code := new()
    destination := label(&mut code)
    branch(&mut code, destination, 1); emit(&mut code, 3594453504)
    code.effect_epoch == 0
    outer := begin_effects(&mut code)
    branch(&mut code, destination, 1) // Inner lease setup invalidates the outer proof.
    inner := begin_effects(&mut code)
    emit(&mut code, 3573751839)
    end_effects(&mut code, inner)
    !end_effects(&mut code, outer)
    code.effect_depth == 0
    after := code.effect_epoch
    barrier(&mut code); syscall(&mut code, 1, 2); patch(&mut code, 0, 3573751839)
    code.effect_epoch == after
}
@test fn linux_uses_its_syscall_register_and_page_aligned_text() {
    var code := new_for(1)
    destination := label(&mut code)
    branch(&mut code, destination, 20)
    mark(&mut code, destination)
    exit(&mut code, 37)
    text := finish(&mut code)
    assert(text.len == 24)
    assert(code.words[0] == 2415919104)
    assert(code.words[1] == 2432704512)
    assert(code.words[3] == 3531606984) // mov x8,94: exit_group
    assert(code.words[4] == 3556769793)
}

@test fn darwin_retains_its_text_offset_and_syscall_abi() {
    var code := new()
    destination := label(&mut code)
    branch(&mut code, destination, 20)
    mark(&mut code, destination)
    exit(&mut code, 37)
    text := finish(&mut code)
    assert(text.len == 28)
    assert(code.words[0] == 2415919104)
    assert(code.words[1] == 2433146880)
    assert(code.words[5] == 3556773889)
}

@test fn linux_frames_cover_large_compiler_functions() {
    var code := new_for(1)
    at := prologue(&mut code)
    frame(&mut code, at, 65535)
    assert(code.words.len == 4)
    assert(code.words[at] == 3510764543)
    assert(code.words[at + 1] == 3506439167)
}

@test fn checking_counts_positions_without_retaining_machine_output() {
    for platform in 0..4 {
        var code := new_check(platform)
        entry := label(&mut code); done := label(&mut code)
        mark(&mut code, entry)
        at := prologue(&mut code)
        frame(&mut code, at, 65535)
        for i in 0..4096 { imm(&mut code, 0, i64(i)); branch(&mut code, done, 18) }
        mark(&mut code, done); ret(&mut code)
        patch(&mut code, at, 3510633471)
        position(&code) == 12295
        label_count(&code) == 2
        code.words.len == 0
        code.labels.len == 0
        code.at.len == 0
        code.target.len == 0
        code.kinds.len == 0
    }
}
