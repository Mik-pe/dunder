// x0 contains the element count. Scratch descriptors remain in the current
// call frame. The area slot owns one runtime allocation for all of them.
import arm64 as arm

pub fn allocate(c:&mut arm.Code, area:i32, descriptor:i32, width:i32, align:i32, bounds:i32, shift:i32) {
    arm.mov(&mut c,5,0) // count
    arm.emit(&mut c,4043309087);arm.branch(&mut c,bounds,13) // count < 0
    arm.load(&mut c,area+1) // cursor in bytes
    if align>1 {
        arm.emit(&mut c,2432696320+i64(align-1)*1024)
        arm.imm(&mut c,1,-i64(align));arm.emit(&mut c,2315321344) // and x0,x0,x1
    }
    arm.mov(&mut c,4,0)
    arm.imm(&mut c,1,i64(width))
    arm.emit(&mut c,2600565922) // mul x2,x5,x1
    arm.emit(&mut c,2332164227) // add x3,x4,x2
    arm.load(&mut c,area+2);arm.emit(&mut c,3942645887) // cmp x3,x0
    arm.branch(&mut c,bounds,10) // unsigned higher
    arm.store(&mut c,area+1,3)
    arm.load(&mut c,area);arm.emit(&mut c,2332295172) // add x4,x0,x4
    arm.imm(&mut c,0,i64(descriptor+1)*8);arm.emit(&mut c,3405775776) // sub x0,x29,x0
    arm.emit(&mut c,4177526788);arm.emit(&mut c,4177527813);arm.emit(&mut c,4177528837)
    arm.imm(&mut c,1,i64(shift));arm.emit(&mut c,4177529857)
    head:=arm.label(&mut c);done:=arm.label(&mut c);arm.mark(&mut c,head)
    arm.emit(&mut c,4043309151);arm.branch(&mut c,done,2)
    arm.emit(&mut c,956301471);arm.emit(&mut c,2432697476) // strb wzr,[x4]; add x4,x4,#1
    arm.emit(&mut c,3506439234);arm.branch(&mut c,head,0);arm.mark(&mut c,done)
}

pub fn index(c:&mut arm.Code, width:i32, bounds:i32) {
    // x0=index; x1=slice descriptor. Bounds are checked before scaling.
    arm.emit(&mut c,4181722146);arm.emit(&mut c,3942776863);arm.branch(&mut c,bounds,4)
    arm.emit(&mut c,4181721121);arm.imm(&mut c,2,i64(width))
    arm.emit(&mut c,2600600576) // madd x0,x0,x2,x1
}

// x0 is inline arena storage and x1 points to an ordinary flat POD record.
pub fn store_record(c: &mut arm.Code, fields: i32) {
    for i in 0..fields {
        arm.emit(&mut c, 4181721122 + i64(i) * 1024) // ldr x2,[x1,#field]
        arm.emit(&mut c, 4177526786 + i64(i) * 1024) // str x2,[x0,#field]
    }
}

// Parameter IDs are stable across functions. Edges point back to parameters
// that forwarded a borrow, so recursion is handled once per parameter.
pub struct Loans {
    active: bool, first_parameter: i32,
    heads: []i32, sources: []i32, next: []i32, raw: []bool, pending: []i32,
    parameters: []i32, offsets: []i32, indirect: []i32, taken: []bool
}

pub fn loans() -> Loans {
    Loans { active: false, first_parameter: 0, heads: [], sources: [], next: [],
        raw: [], pending: [], parameters: [], offsets: [], indirect: [], taken: [] }
}

pub fn prepare(graph: &mut Loans, count: i32, functions: i32) {
    for i in 0..functions { graph.taken.push(false) }
    for i in 0..count { graph.heads.push(-1); graph.raw.push(false) }
}

pub fn expose(graph: &mut Loans, parameter: i32) {
    if !graph.raw[parameter] {
        graph.raw[parameter] = true
        graph.pending.push(parameter)
    }
}

// A negative source denotes a region view instead of a function parameter.
pub fn forward(graph: &mut Loans, source: i32, target: i32, offset: i32) {
    if source < 0 {
        graph.parameters.push(target); graph.offsets.push(offset)
    } else {
        graph.next.push(graph.heads[target])
        graph.sources.push(source)
        graph.heads[target] = graph.sources.len - 1
    }
}

// Each deferred call records source, callable signature, parameter, and source
// position. Only functions actually taken as values can receive its argument.
pub fn indirect(graph: &mut Loans, source: i32, signature: i32, parameter: i32, at: i32) {
    graph.indirect.push(source); graph.indirect.push(signature)
    graph.indirect.push(parameter); graph.indirect.push(at)
}

pub fn resolve(graph: &mut Loans, signatures: &[]i32, starts: &[]i32) {
    if graph.indirect.len == 0 { return }
    for f in 0..graph.taken.len {
        if graph.taken[f] {
            var call := 0
            while call < graph.indirect.len {
                if signatures[f] == graph.indirect[call + 1] {
                    forward(&mut graph, graph.indirect[call], starts[f] + graph.indirect[call + 2],
                            graph.indirect[call + 3])
                }
                call = call + 4
            }
        }
    }
}

pub fn escaping_offset(graph: &mut Loans) -> i32 {
    while graph.pending.len > 0 {
        target := graph.pending.pop()
        var edge := graph.heads[target]
        while edge >= 0 {
            expose(&mut graph, graph.sources[edge])
            edge = graph.next[edge]
        }
    }
    for i in 0..graph.parameters.len {
        if graph.raw[graph.parameters[i]] { return graph.offsets[i] }
    }
    -1
}
