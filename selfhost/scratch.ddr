// x0 contains the element count. Scratch descriptors remain in the current
// call frame. The area slot owns one runtime allocation for all of them.
import arm64 as arm

pub fn allocate(c:&mut arm.Code, area:i32, descriptor:i32, width:i32, align:i32, bounds:i32, shift:i32) {
    arm.mov(&mut c,5,0) // count
    arm.emit(&mut c,4043309087);arm.branch(&mut c,bounds,13) // count < 0
    arm.load(&mut c,area+1) // cursor in bytes
    if align>1 {
        arm.emit(&mut c,2432696320+i64(align-1)*1024)
        arm.imm(&mut c,1,-i64(align));arm.emit(&mut c,2315321344) // and x0,x0,x1
    }
    arm.mov(&mut c,4,0)
    arm.imm(&mut c,1,i64(width))
    arm.emit(&mut c,2600565922) // mul x2,x5,x1
    arm.emit(&mut c,2332164227) // add x3,x4,x2
    arm.load(&mut c,area+2);arm.emit(&mut c,3942645887) // cmp x3,x0
    arm.branch(&mut c,bounds,10) // unsigned higher
    arm.store(&mut c,area+1,3)
    arm.load(&mut c,area);arm.emit(&mut c,2332295172) // add x4,x0,x4
    arm.imm(&mut c,0,i64(descriptor+1)*8);arm.emit(&mut c,3405775776) // sub x0,x29,x0
    arm.emit(&mut c,4177526788);arm.emit(&mut c,4177527813);arm.emit(&mut c,4177528837)
    arm.imm(&mut c,1,i64(shift));arm.emit(&mut c,4177529857)
    head:=arm.label(&mut c);done:=arm.label(&mut c);arm.mark(&mut c,head)
    arm.emit(&mut c,4043309151);arm.branch(&mut c,done,2)
    arm.emit(&mut c,956301471);arm.emit(&mut c,2432697476) // strb wzr,[x4]; add x4,x4,#1
    arm.emit(&mut c,3506439234);arm.branch(&mut c,head,0);arm.mark(&mut c,done)
}

pub fn index(c:&mut arm.Code, width:i32, bounds:i32) {
    // x0=index; x1=slice descriptor. Bounds are checked before scaling.
    arm.emit(&mut c,4181722146);arm.emit(&mut c,3942776863);arm.branch(&mut c,bounds,4)
    arm.emit(&mut c,4181721121);arm.imm(&mut c,2,i64(width))
    arm.emit(&mut c,2600600576) // madd x0,x0,x2,x1
}
