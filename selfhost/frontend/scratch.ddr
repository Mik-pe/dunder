// x0 contains the element count. Scratch descriptors remain in the current
// call frame. The area slot owns one runtime allocation for all of them.
import ..backend.arm64 as arm

import region_operation as region

pub fn allocate(code: &mut arm.Code, area: i32, descriptor: i32, element: i32, width: i32,
    align: i32, bounds: i32, shift: i32, source: i32) {
    arm.mov(&mut code, 5, 0); arm.compare_immediate(&mut code, 0, 0, false)
    arm.source_edge(&mut code, bounds, .NegativeCount, source)
    arm.load(&mut code, area + 1); region.emit(&mut code, .Layout, element, align, width, source)
    arm.load(&mut code, area + 2); arm.compare_register(&mut code, 3, 0)
    arm.source_edge(&mut code, bounds, .RegionFull, source)
    arm.store(&mut code, area + 1, 3); arm.load(&mut code, area); arm.add_scaled(&mut code, 4, 0, 4, 0)
    arm.address(&mut code, descriptor); region.emit(&mut code, .Install, element, shift, 0, source)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.compare_immediate(&mut code, 2, 0, false); arm.branch(&mut code, done, 2)
    arm.transfer(&mut code, false, 31, 4, 0, 0)
    arm.integer_binary(&mut code, 1, true, false, 4, 4, -1, 1)
    arm.integer_binary(&mut code, 2, true, false, 2, 2, -1, 1)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
}

// x0 is inline arena storage and x1 points to an ordinary flat POD record.
pub fn store_record(c: &mut arm.Code, fields: i32) {
    mut block := 0
    while block < fields {
        mut destination := 0; mut source := 1
        if block > 0 {
            arm.imm(&mut c, 2, i64(block) * 8)
            arm.integer_binary(&mut c, 1, true, false, 3, 0, 2, -1); arm.integer_binary(&mut c, 1, true, false, 4, 1, 2, -1)
            destination = 3; source = 4
        }
        mut count := fields - block; if count > 4096 { count = 4096 }
        for i in 0..count {
            arm.emit(&mut c, 4181721090 + i64(source) * 32 + i64(i) * 1024)
            arm.emit(&mut c, 4177526786 + i64(destination) * 32 + i64(i) * 1024)
        }
        block = block + count
    }
}

// Parameter IDs are stable across functions. Edges point back to parameters
// that forwarded a borrow, so recursion is handled once per parameter.
pub struct Loans {
    active: bool,
    heads: []i32, sources: []i32, next: []i32, raw: []bool, pending: []i32,
    parameters: []i32, offsets: []i32, origins: []i32, indirect: []i32, taken: []bool
}

pub fn loans() -> Loans {
    Loans { active: false, heads: [], sources: [], next: [],
        raw: [], pending: [], parameters: [], offsets: [], origins: [], indirect: [], taken: [] }
}

pub fn prepare(graph: &mut Loans, count: i32, functions: i32) {
    for i in 0..functions { graph.taken.push(false) }
    for i in 0..count { graph.heads.push(-1); graph.raw.push(false) }
}

pub fn expose(graph: &mut Loans, parameter: i32) {
    if !graph.raw[parameter] {
        graph.raw[parameter] = true
        graph.pending.push(parameter)
    }
}

// Negative sources retain their constrained storage kind: -2 for a region,
// -3 for a lexical loan, view or call temporary, instead of a parameter ID.
pub fn forward(graph: &mut Loans, source: i32, target: i32, offset: i32) {
    if source < 0 {
        graph.parameters.push(target); graph.offsets.push(offset); graph.origins.push(source)
    } else {
        graph.next.push(graph.heads[target])
        graph.sources.push(source)
        graph.heads[target] = graph.sources.len - 1
    }
}

pub fn resolve(graph: &mut Loans, signatures: &[]i32, starts: &[]i32) {
    if graph.indirect.len == 0 { return }
    for f in 0..graph.taken.len {
        if graph.taken[f] {
            mut call := 0
            while call < graph.indirect.len {
                if signatures[f] == graph.indirect[call + 1] {
                    forward(&mut graph, graph.indirect[call], starts[f] + graph.indirect[call + 2],
                            graph.indirect[call + 3])
                }
                call = call + 4
            }
        }
    }
}

pub fn escaping_offset(graph: &mut Loans) -> i32 {
    while graph.pending.len > 0 {
        target := graph.pending.pop()
        mut edge := graph.heads[target]
        while edge >= 0 {
            expose(&mut graph, graph.sources[edge])
            edge = graph.next[edge]
        }
    }
    for i in 0..graph.parameters.len {
        if graph.raw[graph.parameters[i]] { return graph.offsets[i] }
    }
    -1
}

// Query after escaping_offset has propagated raw exposure to a fixed point.
// Use the same edge order so the storage kind belongs to the reported offset;
// a preceding constrained edge that never reaches raw storage does not count.
pub fn escaping_origin(graph: &Loans) -> i32 {
    for i in 0..graph.parameters.len {
        if graph.raw[graph.parameters[i]] { return graph.origins[i] }
    }
    -1
}

@test fn region_escape_preserves_the_first_actual_source_kind_and_offset() {
    mut graph := loans(); prepare(&mut graph, 3, 0)
    forward(&mut graph, -2, 0, 10); forward(&mut graph, -3, 1, 20)
    forward(&mut graph, 0, 2, 30)
    assert(escaping_offset(&mut graph) == -1 && escaping_origin(&graph) == -1)
    expose(&mut graph, 2); expose(&mut graph, 1)
    assert(escaping_offset(&mut graph) == 10 && escaping_origin(&graph) == -2)
    assert(escaping_offset(&mut graph) == 10 && escaping_origin(&graph) == -2)
}
@test fn scoped_escape_skips_unexposed_region_edges_and_follows_recursive_relays() {
    mut graph := loans(); prepare(&mut graph, 3, 0)
    forward(&mut graph, -2, 0, 40); forward(&mut graph, -3, 1, 50)
    forward(&mut graph, 1, 2, 60); forward(&mut graph, 2, 1, 70)
    expose(&mut graph, 2)
    assert(escaping_origin(&graph) == -1)
    assert(escaping_offset(&mut graph) == 50 && escaping_origin(&graph) == -3)
    assert(!graph.raw[0] && graph.raw[1] && graph.raw[2] && graph.pending.len == 0)
}
@test fn indirect_constrained_edges_keep_their_kind_for_taken_matching_functions() {
    mut graph := loans(); prepare(&mut graph, 2, 2)
    graph.taken[0] = true
    graph.indirect.push(-3); graph.indirect.push(7); graph.indirect.push(0); graph.indirect.push(80)
    graph.indirect.push(-2); graph.indirect.push(8); graph.indirect.push(0); graph.indirect.push(90)
    signatures: []i32 = [7, 8]; starts: []i32 = [0, 1]
    resolve(&mut graph, &signatures, &starts)
    assert(graph.parameters.len == 1 && graph.offsets.len == 1 && graph.origins.len == 1)
    expose(&mut graph, 0)
    assert(escaping_offset(&mut graph) == 80 && escaping_origin(&graph) == -3)
}
