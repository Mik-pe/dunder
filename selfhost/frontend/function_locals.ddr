pub struct Table {
    names: []string, types: []i32, mutable: []bool, scopes: []i32,
    tokens: []i32, fresh_move: []bool, active: []i32,
    used: []bool, is_param: []bool, warned: []bool,
}
pub fn new() -> Table {
    Table { names: [], types: [], mutable: [], scopes: [], tokens: [], fresh_move: [], active: [], used: [], is_param: [], warned: [] }
}
pub fn clear(t: &mut Table) {
    t.names.clear(); t.types.clear(); t.mutable.clear(); t.scopes.clear()
    t.tokens.clear(); t.fresh_move.clear(); t.active.clear()
    t.used.clear(); t.is_param.clear(); t.warned.clear()
}
pub fn add(t: &mut Table, move name: string, ty: i32, mutable: bool, scope: i32, token: i32) -> i32 {
    id := t.names.len
    t.names.push(move name); t.types.push(ty); t.mutable.push(mutable)
    t.scopes.push(scope); t.tokens.push(token); t.fresh_move.push(false); t.active.push(id)
    t.used.push(false); t.is_param.push(false); t.warned.push(false)
    id
}
pub fn add_param(t: &mut Table, move name: string, ty: i32, mutable: bool, scope: i32, token: i32) -> i32 {
    id := add(&mut t, move name, ty, mutable, scope, token)
    t.is_param[id] = true
    t.used[id] = true
    id
}
pub fn mark_used(t: &mut Table, id: i32) {
    if id >= 0 && id < t.used.len { t.used[id] = true }
}
pub fn resolve(t: &Table, name: string) -> i32 {
    if name == "_" { return -1 }
    mut i := t.active.len
    while i > 0 {
        i = i - 1; id := t.active[i]
        if t.names[id] == name { return id }
    }
    -1
}
pub fn first_in_scope(t: &Table, limit: i32, scope: i32) -> i32 {
    mut first := t.active.len
    while first > limit && t.scopes[t.active[first - 1]] == scope { first = first - 1 }
    first
}

@test fn leaving_a_scope_keeps_its_local_ids_and_restores_shadowed_names() {
    mut t := new()
    outer := add(&mut t, "value", 3, false, 0, 1)
    inner := add(&mut t, "value", 1, true, 1, 8)
    assert(resolve(&t, "value") == inner && first_in_scope(&t, 0, 1) == 1)
    _ := t.active.pop()
    assert(resolve(&t, "value") == outer)
    next := add(&mut t, "value", 4, false, 1, 23)
    assert(next != inner && resolve(&t, "value") == next)
    assert(t.types[inner] == 1 && t.mutable[inner] && t.tokens[inner] == 8)
    assert(!t.used[inner] && !t.is_param[inner])
    mark_used(&mut t, inner)
    assert(t.used[inner])
    p := add_param(&mut t, "arg", 1, false, 0, 0)
    assert(t.is_param[p] && t.used[p])
    clear(&mut t)
    assert(resolve(&t, "value") == -1 && add(&mut t, "x", 2, false, 0, 0) == 0)
}
