import source_types
pub enum Projection { Field, TextIndex, ArrayIndex, RegionIndex }
pub struct Arena { locals: []i64, nodes: []i64 }
pub fn new() -> Arena { Arena { locals: [], nodes: [] } }
pub fn reset(g: &mut Arena) { g.locals.clear(); g.nodes.clear() }
fn pair(high: i32, low: i32) -> i64 {
    i64(high).shl(32).bit_or(i64(low).bit_and(4294967295))
}
pub fn local(g: &mut Arena, home: i32, ty: i32, shape: i32, deref: i32) {
    g.locals.push(pair(ty, home.bit_and(65535).bit_or(shape.shl(16)).bit_or(deref.shl(20))))
}
pub fn local_home(cell: i64) -> i32 { i32(cell.bit_and(65535)) }
pub fn local_type(cell: i64) -> i32 { i32(cell.shr(32)) }
pub fn local_shape(cell: i64) -> i32 { i32(cell.shr(16).bit_and(15)) }
pub fn deref(cell: i64) -> i32 { i32(cell.shr(20).bit_and(3)) }
pub fn place_type(g: &Arena, first_local: i32, first_node: i32, id: i32) -> i32 {
    if id < 0 { return local_type(g.locals[first_local - (id + 1)]) }
    i32(g.nodes[first_node + 3 * (id - 1) + 1].bit_and(2147483647))
}
pub fn layout(kind: Projection, parameter: i32, shape: i32) -> i32 {
    parameter.bit_or(i32(kind).shl(20)).bit_or(shape.shl(24))
}
pub fn project(g: &mut Arena, parent: i32, selector: i32, receiver: i32, ty: i32, storage: i32, source: i32) -> i32 {
    g.nodes.push(pair(parent, selector)); g.nodes.push(pair(receiver, ty)); g.nodes.push(pair(storage, source)); g.nodes.len / 3
}
fn signed(word: i64) -> i32 {
    value := word.bit_and(4294967295)
    if value > 2147483647 { return i32(value - 4294967296) }
    i32(value)
}
pub fn parent(cell: i64) -> i32 { signed(cell.shr(32)) }
pub fn selector(cell: i64) -> i32 { i32(cell.bit_and(65535)) }
pub fn address(cell: i64) -> i32 { i32(cell.shr(16).bit_and(65535)) - 1 }
pub fn save_home(g: &mut Arena, id: i32, home: i32) {
    row := 3 * (id - 1); assert(home >= 0 && home < 65535 && address(g.nodes[row]) < 0)
    g.nodes[row] = g.nodes[row].bit_or(i64(home + 1).shl(16))
}
pub fn receiver(cell: i64) -> i32 { i32(cell.shr(32)) }
pub fn storage(cell: i64) -> i32 { i32(cell.shr(32)) }
pub fn kind(storage: i32) -> i32 { storage.shr(20).bit_and(15) }
pub fn max_parameter() -> i32 { 1048575 }
pub fn parameter(storage: i32) -> i32 { storage.bit_and(max_parameter()) }
pub fn shape(storage: i32) -> i32 { storage.shr(24) }
pub fn source(cell: i64) -> i32 { i32(cell.bit_and(2147483647)) }
pub fn valid(g: &Arena, l: i32, le: i32, n: i32, ne: i32, types: &[]i32) -> bool {
    if l < 0 || le < l || le > g.locals.len || n < 0 || ne < n || ne > g.nodes.len || (ne - n) % 3 != 0 { return false }
    if !source_types.valid(&types) { return false }
    for j in l..le {
        v := g.locals[j]
        if v < 0 || !source_types.contains(&types, local_type(v)) || v.bit_and(4290772992) != 0 || local_shape(v) > 4 || deref(v) > 2 || local_home(v) >= 65535 { return false }
    }
    mut row := n
    while row < ne {
        path := g.nodes[row]; ty := g.nodes[row+1]; origin := g.nodes[row+2]
        prev := parent(path); id := (row - n) / 3 + 1; form := storage(origin)
        if prev >= id || prev < -(le-l) || ty < 0 || ty.bit_and(2147483648) != 0 ||
            !source_types.contains(&types, receiver(ty)) || !source_types.contains(&types, i32(ty.bit_and(2147483647))) ||
            origin < 0 || origin.bit_and(2147483648) != 0 || shape(form) > 4 || kind(form) > 3 ||
            (prev != 0 && receiver(ty) != place_type(&g, l, n, prev)) { return false }
        if kind(form) != i32(Projection.Field) {
            if kind(form) == i32(Projection.TextIndex) && parameter(form) != 0 { return false }
            if kind(form) == i32(Projection.ArrayIndex) && parameter(form) > 16 { return false }
            if kind(form) == i32(Projection.RegionIndex) && parameter(form) == 0 { return false }
        }
        row = row + 3
    }
    true
}
