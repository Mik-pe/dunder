import ..backend.arm64 as arm
import ..backend.backend_row as row
import source_types
import ..mir.mir

pub enum Stage { Layout, Install }
fn valid_shape(op: i32, ty: i32, parameter: i32, width: i64) -> bool {
    if ty < 1 { return false }
    if op == i32(Stage.Layout) {
        return width > 0 && width <= 2147483647 && (parameter == 1 || parameter == 2 || parameter == 4 || parameter == 8)
    }
    op == i32(Stage.Install) && parameter >= 0 && parameter <= 3 && width == 0
}
pub fn pair(h: i64, site: i64) -> bool {
    row.kind(h) == 101 && h.bit_and(63050394783186944) == 0 && h.bit_and(2147483648) == 0 &&
        site >= 0 && site.bit_and(2147483648) == 0 &&
        valid_shape(row.reg(h), i32(h.bit_and(2147483647)), i32(row.operand(h).shr(32)), site.shr(32))
}
pub fn emit(code: &mut arm.Code, stage: Stage, ty: i32, parameter: i32, width: i32, source: i32) {
    if code.mir_capture {
        code.words.push(i64(101).shl(56).bit_or(i64(i32(stage)).shl(48)).bit_or(i64(parameter).shl(32)).bit_or(i64(ty)))
        code.words.push(i64(width).shl(32).bit_or(i64(source)))
    } else { lower(&mut code, i32(stage), parameter, i64(width)) }
}
pub fn lower(code: &mut arm.Code, stage: i32, parameter: i32, width: i64) {
    if stage == i32(Stage.Layout) {
        if parameter > 1 {
            arm.integer_binary(&mut code, 1, true, false, 0, 0, -1, i64(parameter - 1))
            arm.imm(&mut code, 1, -i64(parameter)); arm.integer_binary(&mut code, 8, true, false, 0, 0, 1, -1)
        }
        arm.mov(&mut code, 4, 0); arm.imm(&mut code, 1, width)
        arm.integer_binary(&mut code, 3, true, false, 2, 5, 1, -1)
        arm.add_scaled(&mut code, 3, 4, 2, 0)
    } else {
        arm.transfer(&mut code, false, 4, 0, 3, 0)
        arm.transfer(&mut code, false, 5, 0, 3, 8); arm.transfer(&mut code, false, 5, 0, 3, 16)
        arm.imm(&mut code, 1, i64(parameter)); arm.transfer(&mut code, false, 1, 0, 3, 24)
        arm.transfer(&mut code, false, 31, 0, 3, 32); arm.transfer(&mut code, false, 31, 0, 3, 40)
    }
}
fn writes(stage: i32, parameter: i32) -> i64 {
    if stage == i32(Stage.Install) { return 2 }
    if parameter == 1 { return 30 }; 31
}
pub fn set(f: &mut mir.Function, id: i32, h: i64, site: i64) {
    stage := row.reg(h); parameter := i32(row.operand(h).shr(32))
    f.opcodes[id] = stage; f.aux[id] = parameter; f.types[id] = i32(h.bit_and(2147483647))
    f.imm[id] = site.shr(32); f.variant[id] = site.bit_and(2147483647)
    f.writes[id] = writes(stage, parameter)
    if stage == i32(Stage.Layout) { f.reads[id] = 33 }
    else { f.reads[id] = 49; f.effects[id] = 5 }
}
pub fn valid(f: &mir.Function, id: i32) -> bool {
    stage := f.opcodes[id]; parameter := f.aux[id]
    if !source_types.contains(&f.source_types, f.types[id]) || !valid_shape(stage, f.types[id], parameter, f.imm[id]) ||
        f.variant[id] < 0 || f.variant[id] > 2147483647 || f.raw_starts[id] != -1 || f.widths[id] != 0 ||
        f.dst[id] != -1 || f.a[id] != -1 || f.b[id] != -1 || f.c[id] != -1 || f.flags[id] != 0 || f.clobbers[id] != 0 ||
        f.place[id] != -1 || f.abi[id] != 0 || f.recipes[id] != 0 || f.extensions[id] != 0 || f.stack_roles[id] != 0 ||
        f.reloc_kinds[id] != -1 || f.targets[id] != -1 || f.import_ids[id] != -1 || f.writes[id] != writes(stage, parameter) { return false }
    if stage == i32(Stage.Layout) { return f.reads[id] == 33 && f.effects[id] == 0 }
    f.reads[id] == 49 && f.effects[id] == 5
}
