import ..opt.scalar_rules as rules
import frontend_types as ft
import function_locals as locals
import lexer

pub fn read_only_index(tokens: &lexer.Tokens, first: i32) -> bool {
    mut depth := 0; mut pos := first
    while pos < tokens.kinds.len && pos - first < 24 {
        kind := tokens.kinds[pos]
        if kind != .Integer && kind != .Byte && kind != .Name {
            if kind != .Symbol { return false }
            op := &tokens.texts[pos]
            if op == "]" {
                if depth == 0 { return true }; depth -= 1
            } else if op == "[" { depth += 1 }
            else if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" && op != "." && op != ".." { return false }
        }
        pos += 1
    }
    false
}

fn condition_constructor(tokens: &lexer.Tokens, closes: &[]i32, types: &ft.TypeRegistry, locals_table: &locals.Table, open: i32) -> bool {
    if open == 0 || tokens.kinds[open - 1] != .Name || closes[open] < 0 { return false }
    if open > 1 && tokens.kinds[open - 2] == .Symbol && tokens.texts[open - 2] == "." { return false }
    name := &tokens.texts[open - 1]
    if locals.resolve(&locals_table, name) >= 0 { return false }
    nominal := if name == "Self" { types.self_type } else { ft.type_id(&types, name) }
    nominal >= 0 && ft.type_kind(&types, nominal) == 2
}

pub fn group_end(tokens: &lexer.Tokens, closes: &[]i32, start: i32, depth: i32) -> i32 {
    if depth > 128 { return tokens.texts.len }
    close := if tokens.texts[start] == "[" { "]" } else { ")" }
    mut pos := start + 1
    while pos < tokens.texts.len {
        if tokens.kinds[pos] == .End { break }
        if tokens.kinds[pos] == .Symbol {
            word := &tokens.texts[pos]
            if word == close { return pos + 1 }
            if word == "{" && closes[pos] >= 0 { pos = closes[pos] + 1; continue }
            if word == "(" || word == "[" { pos = group_end(&tokens, &closes, pos, depth + 1); continue }
            if word == ")" || word == "]" || word == "{" || word == "}" { break }
        }
        pos += 1
    }
    tokens.texts.len
}

fn condition_body(tokens: &lexer.Tokens, closes: &[]i32, types: &ft.TypeRegistry, locals_table: &locals.Table, start: i32, depth: i32) -> i32 {
    if depth > 128 { return tokens.texts.len }
    mut pos := start
    while pos < tokens.texts.len {
        if tokens.kinds[pos] == .End { break }
        if tokens.kinds[pos] == .Keyword && tokens.texts[pos] == "if" {
            pos = conditional_end_at(&tokens, &closes, &types, &locals_table, pos + 1, depth + 1); continue
        }
        if tokens.kinds[pos] == .Keyword && tokens.texts[pos] == "match" {
            pos = match_end(&tokens, &closes, &types, &locals_table, pos + 1, depth + 1); continue
        }
        if tokens.kinds[pos] == .Symbol {
            word := &tokens.texts[pos]
            if word == "{" {
                if condition_constructor(&tokens, &closes, &types, &locals_table, pos) { pos = closes[pos] + 1; continue }
                return pos
            }
            if word == "(" || word == "[" { pos = group_end(&tokens, &closes, pos, depth + 1); continue }
            if word == ")" || word == "]" || word == "}" { break }
        }
        pos += 1
    }
    tokens.texts.len
}

pub fn match_end(tokens: &lexer.Tokens, closes: &[]i32, types: &ft.TypeRegistry, locals_table: &locals.Table, start: i32, depth: i32) -> i32 {
    body := condition_body(&tokens, &closes, &types, &locals_table, start, depth)
    if body >= tokens.texts.len || closes[body] < 0 { return tokens.texts.len - 1 }
    closes[body] + 1
}

pub fn continues_expression(tokens: &lexer.Tokens, pos: i32) -> bool {
    if tokens.kinds[pos] != .Symbol { return false }
    next := &tokens.texts[pos]
    rules.precedence(next) != 0 || next == ".." || next == "." || next == "::" || next == "[" || next == "(" || next == "?"
}

pub fn conditional_end(tokens: &lexer.Tokens, closes: &[]i32, types: &ft.TypeRegistry, locals_table: &locals.Table, start: i32) -> i32 {
    conditional_end_at(&tokens, &closes, &types, &locals_table, start, 0)
}

fn conditional_end_at(tokens: &lexer.Tokens, closes: &[]i32, types: &ft.TypeRegistry, locals_table: &locals.Table, start: i32, depth: i32) -> i32 {
    if depth > 128 { return tokens.texts.len - 1 }
    mut pos := start
    while pos < tokens.texts.len {
        pos = condition_body(&tokens, &closes, &types, &locals_table, pos, depth)
        if pos >= tokens.texts.len || closes[pos] < 0 { return tokens.texts.len - 1 }
        after := closes[pos] + 1
        pos = after
        while pos < tokens.texts.len && lexer.is_newline(tokens.kinds[pos]) { pos += 1 }
        if pos >= tokens.texts.len || tokens.kinds[pos] != .Keyword || tokens.texts[pos] != "else" { return after }
        pos += 1
        if pos < tokens.texts.len && tokens.kinds[pos] == .Keyword && tokens.texts[pos] == "if" { pos += 1; continue }
        if pos < tokens.texts.len && tokens.kinds[pos] == .Symbol && tokens.texts[pos] == "{" && closes[pos] >= 0 { return closes[pos] + 1 }
        return pos
    }
    tokens.texts.len - 1
}
