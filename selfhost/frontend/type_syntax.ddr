import lexer
import ..opt.scalar_rules as rules

pub enum Form { Name, Apply, Shared, Exclusive, Array, Fixed, Tuple, Function, Foreign, Consume }
pub struct Tree {
    forms: []Form, names: []string, values: []i32, positions: []i32,
    children: []i32, starts: []i32,
}
pub fn tree() -> Tree { Tree {forms:[], names:[], values:[], positions:[], children:[], starts:[0]} }
pub struct Cursor { at: i32, end: i32, assignment: i32, error: string, error_at: i32 }
pub fn cursor(first: i32, end: i32) -> Cursor { Cursor {at:first, end:end, assignment:-1, error:"", error_at:first} }
fn fail(r: &mut Cursor, message: string) -> i32 {
    if r.error == "" { r.error = message.clone(); r.error_at = r.at }
    -1
}
fn is(r: &Cursor, t: &lexer.Tokens, word: string) -> bool {
    if r.at >= r.end { return false }
    kind := t.kinds[r.at]
    (kind == .Name || kind == .Keyword || kind == .Symbol) && t.texts[r.at] == word
}
fn eat(r: &mut Cursor, t: &lexer.Tokens, word: string) -> bool {
    if !is(&r, &t, word) { return false }
    r.at += 1; true
}
fn lines(r: &mut Cursor, t: &lexer.Tokens) {
    while r.at < r.end && lexer.is_newline(t.kinds[r.at]) { r.at += 1 }
}
fn node(s: &mut Tree, form: Form, at: i32, name: string, value: i32, children: &[]i32) -> i32 {
    id := s.forms.len
    s.forms.push(form); s.names.push(name.clone()); s.values.push(value); s.positions.push(at)
    for child in &children { s.children.push(child) }
    s.starts.push(s.children.len); id
}
fn function_type(s: &mut Tree, r: &mut Cursor, t: &lexer.Tokens, first: i32, foreign: bool, depth: i32) -> i32 {
    if !eat(&mut r, &t, "fn") || !eat(&mut r, &t, "(") { return fail(&mut r, "expected function type") }
    mut children: []i32 = []; mut source := -1
    while r.error == "" && !is(&r, &t, ")") {
        at := r.at
        consumes := eat(&mut r, &t, "move")
        mut arg := parse(&mut s, &mut r, &t, depth + 1)
        if arg < 0 { return -1 }
        if consumes { arg = node(&mut s, .Consume, at, "", 0, &[arg]) }
        children.push(arg)
        if !eat(&mut r, &t, ",") { break }
    }
    if !eat(&mut r, &t, ")") { return fail(&mut r, "expected ')'") }
    mut result := -1
    if eat(&mut r, &t, "->") {
        result = parse(&mut s, &mut r, &t, depth + 1)
        if result < 0 { return -1 }
        if !foreign && is(&r, &t, "from") && r.at + 1 < r.end && t.kinds[r.at + 1] != .Name {
            r.at += 1
            if t.kinds[r.at] != .Integer { return fail(&mut r, "expected a one-based source parameter number after 'from'") }
            n := rules.literal_integer(t.texts[r.at])
            if !n.ok || n.value < 1 || n.value > i64(children.len) { return fail(&mut r, "returned borrow source parameter number is out of range") }
            source = i32(n.value) - 1; r.at += 1
        }
    } else { result = node(&mut s, .Name, first, "()", 0, &[]) }
    children.push(result)
    form := if foreign { Form.Foreign } else { Form.Function }
    node(&mut s, form, first, "", source, &children)
}
pub fn parse(s: &mut Tree, r: &mut Cursor, t: &lexer.Tokens, depth: i32) -> i32 {
    if depth >= 128 { return fail(&mut r, "type nesting exceeds 128") }
    if r.at >= r.end { return fail(&mut r, "expected a type") }
    first := r.at
    if is(&r, &t, "&&") { return fail(&mut r, "reference a value type: nested borrows are not supported") }
    foreign := eat(&mut r, &t, "extern")
    if foreign || is(&r, &t, "fn") { return function_type(&mut s, &mut r, &t, first, foreign, depth) }
    if eat(&mut r, &t, "&") {
        form := if eat(&mut r, &t, "mut") { Form.Exclusive } else { Form.Shared }
        base := parse(&mut s, &mut r, &t, depth + 1)
        if base < 0 { return -1 }; return node(&mut s, form, first, "", 0, &[base])
    }
    if eat(&mut r, &t, "[") {
        if eat(&mut r, &t, "]") {
            base := parse(&mut s, &mut r, &t, depth + 1)
            if base < 0 { return -1 }; return node(&mut s, .Array, first, "", 0, &[base])
        }
        base := parse(&mut s, &mut r, &t, depth + 1)
        if base < 0 { return -1 }
        if !eat(&mut r, &t, ";") { return fail(&mut r, "expected ';'") }
        if r.at >= r.end || t.kinds[r.at] != .Integer { return fail(&mut r, "expected nonnegative array length") }
        length := rules.literal_integer(t.texts[r.at])
        if !length.ok || length.value < 0 || length.value > 1048576 { return fail(&mut r, "array length out of range") }
        r.at += 1
        if !eat(&mut r, &t, "]") { return fail(&mut r, "expected ']'") }
        return node(&mut s, .Fixed, first, "", i32(length.value), &[base])
    }
    if eat(&mut r, &t, "(") {
        if eat(&mut r, &t, ")") { return node(&mut s, .Name, first, "()", 0, &[]) }
        mut parts: []i32 = []; lines(&mut r, &t)
        while !is(&r, &t, ")") {
            child := parse(&mut s, &mut r, &t, depth + 1)
            if child < 0 { return -1 }
            parts.push(child); lines(&mut r, &t)
            if !eat(&mut r, &t, ",") { break }; lines(&mut r, &t)
        }
        if !eat(&mut r, &t, ")") { return fail(&mut r, "expected ')'") }
        return node(&mut s, .Tuple, first, "", 0, &parts)
    }
    if t.kinds[r.at] != .Name { return fail(&mut r, "expected a type") }
    mut name := t.texts[r.at].clone(); r.at += 1
    if is(&r, &t, ".") && r.at + 1 < r.end && t.kinds[r.at + 1] == .Name {
        name += "." + t.texts[r.at + 1]; r.at += 2
    }
    if !eat(&mut r, &t, "<") { return node(&mut s, .Name, first, name, 0, &[]) }
    mut args: []i32 = []
    while r.error == "" {
        lines(&mut r, &t)
        arg := parse(&mut s, &mut r, &t, depth + 1)
        if arg < 0 { return -1 }; args.push(arg); lines(&mut r, &t)
        if !eat(&mut r, &t, ",") { break }
    }
    if eat(&mut r, &t, ">=") { r.assignment = r.at - 1 }
    else if !eat(&mut r, &t, ">") { return fail(&mut r, "expected '>'") }
    node(&mut s, .Apply, first, name, 0, &args)
}
