pub enum Symbol { Import, Static, TaskCoordinator, CallbackStorage, CallbackEntry, WasmImport, WasmCallback, WasmCall }

pub struct IntegerTable { label: i32, data: []u8 }

pub struct Facts {
    first_word: i32, sites: []i32, symbols: []Symbol, operands: []i32, tokens: []i32,
    needed: []i32, taken: []i32, effects: i64, effect_at: i32, calls: []i32, call_offsets: []i32, first_task: i32,
    workers: []i32, worker_tokens: []i32, worker_allowed: []i64, worker_has_input: []bool, factories: []i32, factory_tokens: []i32, factory_allowed: []i64, shared: []i32, shared_tokens: []i32, exposed: []i32,
    forwards: []i32, indirect: []i32, literal_tokens: []i32, literal_labels: []i32,
    assert_tokens: []i32, assert_begins: []i32, assert_ends: []i32, assert_labels: []i32,
    binding_tokens: []i32, binding_types: []i32,
    const_string_ids: []i32, const_string_labels: []i32, const_blob_ids: []i32, const_blob_labels: []i32,
    integer_tables: []IntegerTable,
    embed_blob_ids: []i32, embed_blob_labels: []i32,
}
pub fn new() -> Facts {
    Facts { first_word: 0, sites: [], symbols: [], operands: [], tokens: [], needed: [], taken: [], effects: 0, effect_at: -1, calls: [], call_offsets: [], first_task: -1,
        workers: [], worker_tokens: [], worker_allowed: [], worker_has_input: [], factories: [], factory_tokens: [], factory_allowed: [], shared: [], shared_tokens: [], exposed: [], forwards: [], indirect: [],
        literal_tokens: [], literal_labels: [], assert_tokens: [], assert_begins: [], assert_ends: [], assert_labels: [], binding_tokens: [], binding_types: [],
        const_string_ids: [], const_string_labels: [], const_blob_ids: [], const_blob_labels: [],
        integer_tables: [], embed_blob_ids: [], embed_blob_labels: [] }
}
pub fn reset(f: &mut Facts, first_word: i32) {
    f.first_word = first_word; f.sites.clear(); f.symbols.clear(); f.operands.clear(); f.tokens.clear()
    f.needed.clear(); f.taken.clear(); f.effects = 0; f.effect_at = -1; f.calls.clear(); f.call_offsets.clear(); f.first_task = -1
    f.shared.clear(); f.shared_tokens.clear(); f.factories.clear(); f.factory_tokens.clear(); f.factory_allowed.clear(); f.workers.clear(); f.worker_tokens.clear(); f.worker_allowed.clear(); f.worker_has_input.clear(); f.exposed.clear()
    f.forwards.clear(); f.indirect.clear(); f.literal_tokens.clear(); f.literal_labels.clear()
    f.assert_tokens.clear(); f.assert_begins.clear(); f.assert_ends.clear(); f.assert_labels.clear()
    f.binding_tokens.clear(); f.binding_types.clear()
    f.const_string_ids.clear(); f.const_string_labels.clear(); f.const_blob_ids.clear(); f.const_blob_labels.clear()
    f.integer_tables.clear(); f.embed_blob_ids.clear(); f.embed_blob_labels.clear()
}
pub fn forward(f: &mut Facts, source: i32, parameter: i32, at: i32) {
    f.forwards.push(source); f.forwards.push(parameter); f.forwards.push(at)
}
pub fn indirect(f: &mut Facts, source: i32, signature: i32, parameter: i32, at: i32) {
    f.indirect.push(source); f.indirect.push(signature); f.indirect.push(parameter); f.indirect.push(at)
}
pub fn binding(f: &mut Facts, at: i32, ty: i32) {
    f.binding_tokens.push(at); f.binding_types.push(ty)
}

pub fn symbol(f: &mut Facts, kind: Symbol, word: i32, operand: i32, at: i32) {
    mut site := -1
    if word >= 0 { site = (word - f.first_word) * 4 }
    f.sites.push(site); f.symbols.push(kind); f.operands.push(operand); f.tokens.push(at)
}
