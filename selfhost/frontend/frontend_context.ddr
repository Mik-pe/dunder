// World-level immutable declaration state, per-function lowering context,
// and pure inline/operator predicates shared by frontend compilation passes.
import std.map as map
import ..driver.fragments
import ..opt.scalar_rules as rules
import borrows
import deferred_blocks as deferred
import function_facts as facts
import function_locals as locals
import lexer
import ownership_state as ownership
import local_borrows

pub struct DeclarationWorld {
    tokens: lexer.Tokens, closes: []i32, test_functions: []bool, unsafe_capable: bool,
    source_end: i32, param_tokens: []i32, functions: map.Map, methods: map.Map, names: []string, starts: []i32,
    ends: []i32, returns: []i32, param_starts: []i32, param_counts: []i32,
    param_names: []string, param_types: []i32, libraries: []string, symbols: []string,
    unsafe_functions: []bool, function_owners: []i32, ffi_types: []i32,
    impl_types: []i32, impl_public: []bool, impl_has_self: []bool, impl_self_mut: []bool,
    impl_names: []string, requires_caps: []i32, module_caps: []i32,
}

pub fn new_world() -> DeclarationWorld {
    DeclarationWorld {
        tokens: lexer.empty(false), closes: [], test_functions: [], unsafe_capable: false,
        source_end: 0, param_tokens: [], functions: map.new(), methods: map.new(), names: [], starts: [], ends: [],
        returns: [], param_starts: [], param_counts: [], param_names: [], param_types: [],
        libraries: [], symbols: [], unsafe_functions: [], function_owners: [], ffi_types: [],
        impl_types: [], impl_public: [], impl_has_self: [], impl_self_mut: [],
        impl_names: [], requires_caps: [], module_caps: [],
    }
}

pub struct ExprState {
    owner: i32, ty: i32, move_projection: i32, move_temporary: i32,
    untyped_exit: bool,
}

pub fn new_expr() -> ExprState {
    ExprState { owner: -1, ty: -1, move_projection: -1, move_temporary: -1, untyped_exit: false }
}

pub fn clear_expr(e: &mut ExprState) {
    e.owner = -1; e.ty = -1; e.move_projection = -1; e.move_temporary = -1; e.untyped_exit = false
}

pub fn clear_expr_value(e: &mut ExprState) {
    e.owner = -1; e.ty = -1
}

pub fn produce_owner(e: &mut ExprState, slot: i32, ty: i32) {
    e.owner = slot; e.ty = ty
}

pub struct PlaceState {
    address: i32, scratch: i32, writable: bool, direct: bool, inline_storage: bool, taking_address: bool,
}

pub fn new_place_state() -> PlaceState {
    PlaceState { address: -1, scratch: 0, writable: false, direct: false, inline_storage: false, taking_address: false }
}

pub fn reset_place_state(p: &mut PlaceState) {
    p.address = -1; p.scratch = 0; p.writable = false; p.direct = false; p.inline_storage = false; p.taking_address = false
}

pub fn clear_rvalue_place(p: &mut PlaceState) {
    p.address = -1; p.writable = false
}

pub fn clear_place_eval(p: &mut PlaceState) {
    p.address = -1; p.scratch = 0; p.writable = false; p.direct = false; p.inline_storage = false
}

pub struct LoanState {
    path: i32, root: i32, origin: i32, home: i32, depth: i32, constrained: bool,
}

pub fn new_loan_state() -> LoanState {
    LoanState { path: -1, root: -1, origin: -1, home: -1, depth: -1, constrained: false }
}

pub fn reset_loan_state(l: &mut LoanState) {
    l.path = -1; l.root = -1; l.origin = -1; l.home = -1; l.depth = -1; l.constrained = false
}

pub fn clear_loan_eval(l: &mut LoanState) {
    l.path = -1; l.root = -1; l.origin = -1; l.home = -1; l.constrained = false
}

// The closing token identifies the block whose last expression fills the join
// slot. Ordinary nested blocks and deferred bodies have different end tokens.
pub struct ValueBlock { end: i32, home: i32, expected: i32, ty: i32, match_arm: bool }
fn no_value_block() -> ValueBlock {
    ValueBlock { end: -1, home: -1, expected: 0, ty: 0, match_arm: false }
}

// Values already transferred into an unfinished constructor or call. Their
// slots require cleanup only on a control edge which abandons the expression.
pub enum PendingKind { Argument, Storage, Field, Array }
pub struct PendingOwners { slots: []i32, kinds: []PendingKind, types: []i32, members: []i32 }

pub fn finish_pending(p: &mut PendingOwners, floor: i32) {
    while p.slots.len > floor {
        _ := p.slots.pop(); _ := p.kinds.pop(); _ := p.types.pop(); _ := p.members.pop()
    }
}

pub struct FunctionContext {
    pending: PendingOwners,
    ownership: ownership.State, local_loans: local_borrows.Table,
    expr: ExprState, place: PlaceState, loan: LoanState,
    move_defer_locks: []i32, move_defer_limits: []i32, pattern_borrowed: []i32,
    facts: facts.Facts,
    block_base: i32, task_handles: []i32, loop_task_locals: []i32, first_parameter: i32, return_borrow_origin: i32, scratch_returns: []i32,
    block_end: i32, tail: bool, value_block: ValueBlock, block_depth: i32, cursor: i32, testing: bool, mutations: []i32,
    places: borrows.Places, for_locks: []i32, stream_depth: i32,
    stream_kind: i32, current_owner: i32, unsafe_scope: bool, locals: locals.Table,
    cleanup: i32, owned_slots: []i32, owned_types: []i32, owner_temps: []bool,
    loop_owners: []i32, defers: deferred.Blocks, loop_defers: []i32, loop_operands: []i32, loop_pending: []i32,
    in_defer: bool, defer_loop_floor: i32, reenter_owners: bool, scope: i32,
    slots: i32, ret_type: i32, view_result_destination: i32, depth: i32, loop_heads: []i32, loop_ends: []i32,
    inline_deps: fragments.Dependencies, scalar_function: bool, observing_lease: bool,
    lease_generation: i64, scalar_names: []string, scalar_types: []i32, scalar_tokens: []i32,
    self_type: i32, has_self: bool,
}

pub fn new_body() -> FunctionContext {
    FunctionContext {
        pending: PendingOwners { slots: [], kinds: [], types: [], members: [] },
        ownership: ownership.new(), local_loans: local_borrows.new(),
        expr: new_expr(), place: new_place_state(), loan: new_loan_state(),
        move_defer_locks: [], move_defer_limits: [], pattern_borrowed: [],
        facts: facts.new(),
        block_base: 0, task_handles: [], loop_task_locals: [], first_parameter: 0, return_borrow_origin: -1, scratch_returns: [],
        block_end: 0, tail: false, value_block: no_value_block(), block_depth: 0, cursor: 0, testing: false, mutations: [],
        places: borrows.places(), for_locks: [], stream_depth: -1,
        stream_kind: 0, current_owner: 0, unsafe_scope: false, locals: locals.new(), cleanup: 0,
        owned_slots: [], owned_types: [], owner_temps: [], loop_owners: [],
        defers: deferred.new(), loop_defers: [], loop_operands: [], loop_pending: [], in_defer: false, defer_loop_floor: 0,
        reenter_owners: false, scope: 0, slots: 0, ret_type: 0, view_result_destination: -1, depth: 0,
        loop_heads: [], loop_ends: [], inline_deps: fragments.new_dependencies(),
        scalar_function: false, observing_lease: false, lease_generation: 0, scalar_names: [],
        scalar_types: [], scalar_tokens: [], self_type: -1, has_self: false,
    }
}

// Preserve array capacities across bodies. No function-local owner or pending
// cleanup survives a transition to the next declaration.
pub fn reset_body(body: &mut FunctionContext) {
    finish_pending(&mut body.pending, 0)
    body.task_handles.clear(); body.loop_task_locals.clear()
    locals.clear(&mut body.locals); ownership.clear(&mut body.ownership)
    local_borrows.clear(&mut body.local_loans)
    clear_expr(&mut body.expr); reset_place_state(&mut body.place); reset_loan_state(&mut body.loan)
    body.move_defer_locks.clear(); body.move_defer_limits.clear(); body.pattern_borrowed.clear()
    body.owned_slots.clear(); body.owned_types.clear(); body.owner_temps.clear(); body.mutations.clear()
    borrows.clear(&mut body.places); body.for_locks.clear()
    deferred.reset(&mut body.defers); body.loop_defers.clear(); body.loop_operands.clear(); body.loop_pending.clear()
    body.in_defer = false; body.defer_loop_floor = 0
    body.observing_lease = false; body.lease_generation = 0
    body.loop_heads.clear(); body.loop_ends.clear(); body.loop_owners.clear()
    body.scratch_returns.clear(); body.view_result_destination = -1
    body.depth = 0; body.block_depth = 0
    body.value_block.end = -1
    body.stream_depth = -1; body.stream_kind = 0
    body.self_type = -1; body.has_self = false
}

pub fn local(body: &FunctionContext, name: string) -> i32 {
    locals.resolve(&body.locals, name)
}

pub fn pattern_loan(body: &FunctionContext, id: i32) -> bool {
    for i in 0..body.pattern_borrowed.len { if body.pattern_borrowed[i] == id { return true } }
    false
}

pub fn valid_foreign_name(value: string) -> bool {
    if value.len == 0 { return false }
    for i in 0..value.len { if value[i] == 0 { return false } }
    true
}

pub fn source_owner(offset: i32, starts: &[]i32, files: &[]i32) -> i32 {
    mut lo := 0; mut hi := starts.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if starts[mid] <= offset { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return 0 }; files[lo - 1]
}

pub fn assign_operator(op: string) -> string {
    if op == "+=" { return "+" }
    if op == "-=" { return "-" }
    if op == "*=" { return "*" }
    if op == "/=" { return "/" }
    if op == "%=" { return "%" }
    ""
}

// This is a cheap refusal gate, never a source-language acceptance rule.
// Closed expression verification later rejects calls, locals and control flow.
pub fn inline_signature(world: &DeclarationWorld, f: i32) -> bool {
    if world.libraries[f] != "" || world.test_functions[f] || world.unsafe_functions[f] ||
        world.param_counts[f] > 8 || world.returns[f] < 1 || world.returns[f] > 3 || world.ends[f] - world.starts[f] + 2 > 128 { return false }
    first := world.param_starts[f]
    for p in 0..world.param_counts[f] { if world.param_types[first + p] < 1 || world.param_types[first + p] > 3 { return false } }
    true
}

pub fn inline_expression_bound(world: &DeclarationWorld, f: i32) -> i32 {
    mut nodes := 0; mut returned := false; mut ended := false
    for token in world.starts[f]..world.ends[f] {
        kind := world.tokens.kinds[token]; word := world.tokens.texts[token].clone()
        if lexer.is_newline(kind) { continue }
        if kind == .Symbol && word == ";" { ended = true; continue }
        if ended { return 0 }
        if kind == .Name {
            if world.tokens.texts[token + 1] == "(" { return 0 }
            mut found := false
            first := world.param_starts[f]
            for p in first..first + world.param_counts[f] { if world.param_names[p] == word { found = true; break } }
            if !found { return 0 }
        } else if kind == .Symbol {
            if word == "(" || word == ")" { continue }
            if rules.opcode(word) == 0 && word != "!" { return 0 }
        } else if kind == .Keyword {
            if word == "return" { if returned || nodes != 0 { return 0 }; returned = true; continue }
            if word != "true" && word != "false" { return 0 }
        } else if kind != .Integer { return 0 }
        nodes = nodes + 1; if nodes > 32 { return 0 }
    }
    nodes
}
