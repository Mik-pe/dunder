import ..driver.fragments
import borrows
import deferred_blocks as deferred
import function_facts as facts
import function_locals as locals
import ownership_state as ownership
import local_borrows

pub struct SubjectLock { path: i32, match_at: i32 }

pub struct ExprState {
    owner: i32, ty: i32, move_projection: i32, move_temporary: i32,
    untyped_exit: bool, static_value: bool,
}

pub fn new_expr() -> ExprState {
    ExprState { owner: -1, ty: -1, move_projection: -1, move_temporary: -1, untyped_exit: false, static_value: false }
}

pub fn clear_expr(e: &mut ExprState) {
    e.owner = -1; e.ty = -1; e.move_projection = -1; e.move_temporary = -1; e.untyped_exit = false; e.static_value = false
}

pub fn clear_expr_value(e: &mut ExprState) {
    e.owner = -1; e.ty = -1; e.static_value = false
}

pub fn produce_owner(e: &mut ExprState, slot: i32, ty: i32) {
    e.owner = slot; e.ty = ty
}

pub struct PlaceState {
    address: i32, scratch: i32, writable: bool, direct: bool, inline_storage: bool, taking_address: bool,
}

pub fn new_place_state() -> PlaceState {
    PlaceState { address: -1, scratch: 0, writable: false, direct: false, inline_storage: false, taking_address: false }
}

pub fn reset_place_state(p: &mut PlaceState) {
    p.address = -1; p.scratch = 0; p.writable = false; p.direct = false; p.inline_storage = false; p.taking_address = false
}

pub fn clear_rvalue_place(p: &mut PlaceState) {
    p.address = -1; p.writable = false
}

pub fn clear_place_eval(p: &mut PlaceState) {
    p.address = -1; p.scratch = 0; p.writable = false; p.direct = false; p.inline_storage = false
}

pub struct LoanState {
    path: i32, root: i32, origin: i32, parent: i32, home: i32, depth: i32, constrained: bool, frame_view: bool,
    closure_paths: []i32, closure_roots: []i32, closure_exclusives: []bool, closure_tokens: []i32,
}

pub fn new_loan_state() -> LoanState {
    LoanState { path: -1, root: -1, origin: -1, parent: -1, home: -1, depth: -1, constrained: false, frame_view: false,
        closure_paths: [], closure_roots: [], closure_exclusives: [], closure_tokens: [] }
}

pub fn reset_loan_state(l: &mut LoanState) {
    l.path = -1; l.root = -1; l.origin = -1; l.parent = -1; l.home = -1; l.depth = -1; l.constrained = false; l.frame_view = false
    l.closure_paths.clear(); l.closure_roots.clear(); l.closure_exclusives.clear(); l.closure_tokens.clear()
}

pub fn clear_loan_eval(l: &mut LoanState) {
    l.path = -1; l.root = -1; l.origin = -1; l.parent = -1; l.home = -1; l.constrained = false; l.frame_view = false
    l.closure_paths.clear(); l.closure_roots.clear(); l.closure_exclusives.clear(); l.closure_tokens.clear()
}

pub struct ValueBlock { end: i32, home: i32, expected: i32, ty: i32, match_arm: bool }
fn no_value_block() -> ValueBlock {
    ValueBlock { end: -1, home: -1, expected: 0, ty: 0, match_arm: false }
}

pub enum AssertEnd { Statement, Paren, MatchArm }
pub struct AssertOperands { first: i32, end: AssertEnd, ty: i32, left: i32, right: i32 }
pub fn no_assert_operands() -> AssertOperands {
    AssertOperands { first: -1, end: .Statement, ty: 0, left: -1, right: -1 }
}

pub enum PendingKind { Argument, Storage, Field, Array }
pub struct PendingOwners { slots: []i32, kinds: []PendingKind, types: []i32, members: []i32 }

pub fn finish_pending(p: &mut PendingOwners, floor: i32) {
    while p.slots.len > floor {
        _ := p.slots.pop(); _ := p.kinds.pop(); _ := p.types.pop(); _ := p.members.pop()
    }
}

pub struct PatternLoans {
    locals: []i32, subject_places: []i32, parent_slots: []i32, offsets: []i32, lock_indices: []i32,
}
fn empty_pattern_loans() -> PatternLoans {
    PatternLoans { locals: [], subject_places: [], parent_slots: [], offsets: [], lock_indices: [] }
}

pub struct LoopScope {
    header_token: i32,
    continue_target: i32, break_target: i32,
    owner_limit: i32, defer_depth: i32, operand_depth: i32, pending_limit: i32, local_limit: i32,
}

pub struct FunctionContext {
    pending: PendingOwners,
    ownership: ownership.State, local_loans: local_borrows.Table,
    expr: ExprState, place: PlaceState, loan: LoanState, assert_operands: AssertOperands,
    pattern_borrowed: []i32, pattern_loans: PatternLoans,
    facts: facts.Facts,
    block_base: i32, task_handles: []i32, task_scope_caps: []i64, first_parameter: i32, return_borrow_origin: i32, return_field: i32, scratch_returns: []i32,
    block_end: i32, tail: bool, value_block: ValueBlock, choice_source: local_borrows.Source, choice_scope: i32, block_depth: i32, cursor: i32, testing: bool, mutations: []i32, mutation_paths: []i32,
    places: borrows.Places, for_locks: []SubjectLock, borrowed_carriers: []i32, static_tables: []i32, stream_depth: i32,
    stream_kind: i32, for_enumerate: bool, current_owner: i32, unsafe_scope: bool, locals: locals.Table,
    cleanup: i32, owned_slots: []i32, owned_types: []i32, owner_temps: []bool,
    loops: []LoopScope, defers: deferred.Blocks,
    defer_loop_floor: i32, reenter_owners: bool, scope: i32,
    slots: i32, free_arg_slots: []i32, ret_type: i32, view_result_destination: i32, pod_result_destination: i32, depth: i32,
    inline_deps: fragments.Dependencies, scalar_function: bool, observing_lease: bool,
    lease_generation: i64, scalar_names: []string, scalar_types: []i32, scalar_tokens: []i32,
    self_type: i32, has_self: bool, current_fn: i32,
    last_expr_start: i32, last_expr_end: i32,
}

pub fn new_body() -> FunctionContext {
    FunctionContext {
        pending: PendingOwners { slots: [], kinds: [], types: [], members: [] },
        ownership: ownership.new(), local_loans: local_borrows.new(),
        expr: new_expr(), place: new_place_state(), loan: new_loan_state(), assert_operands: no_assert_operands(),
        pattern_borrowed: [], pattern_loans: empty_pattern_loans(),
        facts: facts.new(),
        block_base: 0, task_handles: [], task_scope_caps: [], first_parameter: 0, return_borrow_origin: -1, return_field: -1, scratch_returns: [],
        block_end: 0, tail: false, value_block: no_value_block(), choice_source: local_borrows.empty_source(), choice_scope: -1, block_depth: 0, cursor: 0, testing: false, mutations: [], mutation_paths: [],
        places: borrows.places(), for_locks: [], borrowed_carriers: [], static_tables: [], stream_depth: -1,
        stream_kind: 0, for_enumerate: false, current_owner: 0, unsafe_scope: false, locals: locals.new(), cleanup: 0,
        owned_slots: [], owned_types: [], owner_temps: [], loops: [],
        defers: deferred.new(), defer_loop_floor: -1,
        reenter_owners: false, scope: 0, slots: 0, free_arg_slots: [], ret_type: 0, view_result_destination: -1, pod_result_destination: -1, depth: 0,
        inline_deps: fragments.new_dependencies(),
        scalar_function: false, observing_lease: false, lease_generation: 0, scalar_names: [],
        scalar_types: [], scalar_tokens: [], self_type: -1, has_self: false, current_fn: -1,
        last_expr_start: -1, last_expr_end: -1,
    }
}

pub fn truncate_owners(body: &mut FunctionContext, count: i32) {
    body.owned_slots.truncate(count); body.owned_types.truncate(count); body.owner_temps.truncate(count)
}

pub fn reset_body(body: &mut FunctionContext) {
    finish_pending(&mut body.pending, 0)
    body.task_handles.clear(); body.task_scope_caps.clear()
    locals.clear(&mut body.locals); ownership.clear(&mut body.ownership)
    local_borrows.clear(&mut body.local_loans)
    clear_expr(&mut body.expr); reset_place_state(&mut body.place); reset_loan_state(&mut body.loan)
    body.assert_operands.first = -1
    body.pattern_borrowed.clear()
    body.pattern_loans.locals.clear(); body.pattern_loans.subject_places.clear()
    body.pattern_loans.parent_slots.clear(); body.pattern_loans.offsets.clear(); body.pattern_loans.lock_indices.clear()
    truncate_owners(&mut body, 0); body.mutations.clear(); body.mutation_paths.clear()
    borrows.clear(&mut body.places); body.for_locks.clear(); body.borrowed_carriers.clear(); body.static_tables.clear()
    deferred.reset(&mut body.defers)
    body.defer_loop_floor = -1
    body.observing_lease = false; body.lease_generation = 0
    body.loops.clear()
    body.scratch_returns.clear(); body.view_result_destination = -1; body.pod_result_destination = -1
    body.depth = 0; body.block_depth = 0
    body.value_block.end = -1; body.choice_scope = -1; body.choice_source = local_borrows.empty_source()
    body.stream_depth = -1; body.stream_kind = 0; body.for_enumerate = false
    body.free_arg_slots.clear()
    body.self_type = -1; body.has_self = false; body.current_fn = -1
    body.last_expr_start = -1; body.last_expr_end = -1
}

pub fn local(body: &FunctionContext, name: string) -> i32 {
    locals.resolve(&body.locals, name)
}

pub fn pattern_loan_index(body: &FunctionContext, id: i32) -> i32 {
    for i in 0..body.pattern_loans.locals.len {
        if body.pattern_loans.locals[i] == id { return i }
    }
    -1
}

pub fn pattern_loan(body: &FunctionContext, id: i32) -> bool {
    for i in 0..body.pattern_borrowed.len { if body.pattern_borrowed[i] == id { return true } }
    pattern_loan_index(&body, id) >= 0
}

pub fn static_table(body: &FunctionContext, id: i32) -> bool {
    for item in &body.static_tables { if item == id { return true } }
    false
}
