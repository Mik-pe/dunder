import frontend_context as fc
import deferred_blocks as deferred
import ownership_state as ownership
import lexer

pub struct Checkpoint {
    scope: i32, block_depth: i32, expr_depth: i32, operand_depth: i32,
    loops: i32, ownership_loops: i32, for_locks: i32, defers: i32,
    owners: i32, pending: i32, free_args: i32, defer_loop_floor: i32,
    reenter_owners: bool, stream_depth: i32, stream_kind: i32,
}

pub fn checkpoint(body: &fc.FunctionContext, operand_depth: i32) -> Checkpoint {
    Checkpoint {
        scope: body.scope, block_depth: body.block_depth, expr_depth: body.depth, operand_depth: operand_depth,
        loops: body.loops.len, ownership_loops: ownership.loop_depth(&body.ownership), for_locks: body.for_locks.len,
        defers: body.defers.stack.len, owners: body.owned_slots.len, pending: body.pending.slots.len,
        free_args: body.free_arg_slots.len, defer_loop_floor: body.defer_loop_floor,
        reenter_owners: body.reenter_owners, stream_depth: body.stream_depth, stream_kind: body.stream_kind,
    }
}

pub fn restore(body: &mut fc.FunctionContext, mark: &Checkpoint) {
    ownership.pop_loops_to(&mut body.ownership, mark.ownership_loops)
    ownership.resume(&mut body.ownership)
    body.block_depth = mark.block_depth
    body.depth = mark.expr_depth
    body.defer_loop_floor = mark.defer_loop_floor
    body.reenter_owners = mark.reenter_owners
    body.stream_depth = mark.stream_depth
    body.stream_kind = mark.stream_kind
    body.for_locks.truncate(mark.for_locks)
    body.loops.truncate(mark.loops)
    deferred.discard_to(&mut body.defers, mark.defers)
    fc.finish_pending(&mut body.pending, mark.pending)
    fc.truncate_owners(&mut body, mark.owners)
    body.free_arg_slots.truncate(mark.free_args)
}

pub fn next_statement(tokens: &lexer.Tokens, stmt_start: i32, failure: i32, limit: i32) -> i32 {
    // Start at the failed statement so separators inside its arguments and blocks are skipped.
    mut depth := 0
    for at in stmt_start..limit {
        kind := tokens.kinds[at]
        can_resume := at > stmt_start && at >= failure && depth == 0
        if kind == .End || (can_resume && lexer.is_newline(kind)) { return at }
        if kind == .Symbol {
            word := &tokens.texts[at]
            if word == "(" || word == "[" || word == "{" { depth += 1 }
            else if word == ")" || word == "]" || word == "}" {
                if can_resume { return at }
                if depth > 0 { depth -= 1 }
            } else if can_resume && word == ";" { return at }
        }
    }
    limit
}
