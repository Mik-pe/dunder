import ast
import diagnostics as diag
import lexer

struct Parser {
    tokens: &lexer.Tokens,
    closes: []i32,
    at: i32,
    depth: i32,
    module: ast.Module,
}

fn new_parser(path: string, tokens: &lexer.Tokens) -> Parser from tokens {
    closes := lexer.delimiter_ends(&tokens, tokens.kinds.len)
    Parser {
        tokens: tokens,
        closes: closes,
        at: 0,
        depth: 0,
        module: ast.new_module(path, tokens.source.clone()),
    }
}

fn at_end(p: &Parser) -> bool {
    p.at >= p.tokens.kinds.len || p.tokens.kinds[p.at] == .End
}

fn kind(p: &Parser) -> lexer.Kind {
    if p.at >= p.tokens.kinds.len { return .End }
    p.tokens.kinds[p.at]
}

fn text(p: &Parser) -> string {
    if p.at >= p.tokens.texts.len { return "" }
    p.tokens.texts[p.at].clone()
}

fn start_off(p: &Parser, tok: i32) -> i32 {
    if tok >= 0 && tok < p.tokens.starts.len { return p.tokens.starts[tok] }
    p.tokens.source.len
}

fn end_off(p: &Parser, tok: i32) -> i32 {
    if tok < 0 || tok >= p.tokens.starts.len { return p.tokens.source.len }
    if p.tokens.store_ends && tok < p.tokens.ends.len && p.tokens.ends[tok] >= p.tokens.starts[tok] {
        return p.tokens.ends[tok]
    }
    sp := diag.resolve_span(p.tokens.source, p.tokens.starts[tok], -1)
    sp.end
}

fn is_word(p: &Parser, word: string) -> bool {
    is_word_at(&p, p.at, word)
}

fn is_word_at(p: &Parser, idx: i32, word: string) -> bool {
    if idx < 0 || idx >= p.tokens.kinds.len { return false }
    k := p.tokens.kinds[idx]
    (k == .Name || k == .Keyword || k == .Symbol) && p.tokens.texts[idx] == word
}

fn is_sym(p: &Parser, sym: string) -> bool {
    kind(&p) == .Symbol && p.tokens.texts[p.at] == sym
}

fn is_nl(p: &Parser) -> bool {
    lexer.is_newline(kind(&p))
}

fn is_sep(p: &Parser) -> bool {
    is_nl(&p) || is_sym(&p, ";") || at_end(&p)
}

fn skip_return_source(p: &mut Parser) {
    if eat(&mut p, "from") && !at_end(&p) {
        if eat(&mut p, "(") {
            while !at_end(&p) && !is_sym(&p, ")") { skip(&mut p) }
            _ := expect(&mut p, ")"); return
        }
        skip(&mut p)
        if eat(&mut p, ".") && !at_end(&p) { skip(&mut p) }
    }
}
fn skip(p: &mut Parser) {
    if p.at < p.tokens.kinds.len - 1 { p.at += 1 }
    else { p.at = p.tokens.kinds.len }
}

fn skip_newlines(p: &mut Parser) {
    while !at_end(&p) && is_nl(&p) { skip(&mut p) }
}

fn skip_seps(p: &mut Parser) {
    while !at_end(&p) && (is_nl(&p) || is_sym(&p, ";")) { skip(&mut p) }
}

fn eat(p: &mut Parser, word: string) -> bool {
    if is_word(&p, word) { skip(&mut p); return true }
    false
}

fn record_error(p: &mut Parser, code: string, first_tok: i32, last_tok: i32, message: string) {
    p.module.ok = false
    if p.module.diagnostics.len >= 32 { return }
    s := start_off(&p, first_tok)
    mut e := if last_tok >= first_tok { end_off(&p, last_tok) } else { end_off(&p, first_tok) }
    if e < s { e = s }
    for i in 0..p.module.diagnostics.len {
        prev := &p.module.diagnostics[i]
        if prev.start == s && prev.message == message { return }
    }
    p.module.diagnostics.push(diag.Diagnostic {
        severity: .Error,
        code: code.clone(),
        path: p.module.path.clone(),
        start: s,
        end: e,
        message: message.clone(),
        note_path: "",
        note_start: -1,
        note_end: -1,
        note_message: "",
    })
}

fn fail_here(p: &mut Parser, message: string) {
    record_error(&mut p, "E1002", p.at, -1, message)
}

fn expect(p: &mut Parser, word: string) -> bool {
    if eat(&mut p, word) { return true }
    fail_here(&mut p, "expected '" + word + "'")
    false
}

fn enter_depth(p: &mut Parser) -> bool {
    if p.depth >= 128 {
        record_error(&mut p, "E1003", p.at, -1, "expression nesting exceeds 128")
        return false
    }
    p.depth += 1
    true
}

fn leave_depth(p: &mut Parser) {
    if p.depth > 0 { p.depth -= 1 }
}

fn skip_balanced(p: &mut Parser, open: string, close: string) {
    if !is_sym(&p, open) { return }
    if p.at < p.closes.len && p.closes[p.at] > p.at {
        p.at = p.closes[p.at] + 1
        return
    }
    mut d := 0
    while !at_end(&p) {
        if is_sym(&p, open) { d += 1 }
        else if is_sym(&p, close) {
            d -= 1
            if d == 0 { skip(&mut p); return }
        }
        skip(&mut p)
    }
}

fn top_level_keyword(p: &Parser) -> bool {
    if is_sym(&p, "@") { return true }
    is_word(&p, "pub") || is_word(&p, "unsafe") || is_word(&p, "opaque") ||
    is_word(&p, "capability") || is_word(&p, "import") || is_word(&p, "const") ||
    is_word(&p, "struct") || is_word(&p, "enum") || is_word(&p, "trait") ||
    is_word(&p, "impl") || is_word(&p, "fn") || is_word(&p, "extern")
}

fn sync_top_level(p: &mut Parser) {
    while !at_end(&p) {
        if top_level_keyword(&p) { return }
        if is_sym(&p, "{") { skip_balanced(&mut p, "{", "}"); continue }
        skip(&mut p)
    }
}

fn sync_stmt(p: &mut Parser) {
    while !at_end(&p) && !is_sep(&p) && !is_sym(&p, "}") {
        if is_sym(&p, "{") { skip_balanced(&mut p, "{", "}"); return }
        if is_sym(&p, "(") { skip_balanced(&mut p, "(", ")"); continue }
        if is_sym(&p, "[") { skip_balanced(&mut p, "[", "]"); continue }
        skip(&mut p)
    }
    if is_sep(&p) { skip_seps(&mut p) }
}

fn skip_generic_params(p: &mut Parser) {
    if !is_sym(&p, "<") { return }
    skip(&mut p)
    mut depth := 1
    while !at_end(&p) && depth > 0 {
        if is_sym(&p, "<") { depth += 1 }
        else if is_sym(&p, ">") { depth -= 1 }
        else if is_sym(&p, "(") { skip_balanced(&mut p, "(", ")"); continue }
        else if is_sym(&p, "[") { skip_balanced(&mut p, "[", "]"); continue }
        else if is_sym(&p, "{") { return }
        skip(&mut p)
    }
}

fn skip_where_clause(p: &mut Parser) {
    skip_newlines(&mut p)
    if !eat(&mut p, "where") { return }
    while !at_end(&p) && !is_sym(&p, "{") && !is_nl(&p) && !is_sym(&p, ";") {
        if is_sym(&p, "(") { skip_balanced(&mut p, "(", ")"); continue }
        if is_sym(&p, "<") { skip_generic_params(&mut p); continue }
        skip(&mut p)
    }
}

fn parse_type_args(p: &mut Parser) {
    if !is_sym(&p, "<") { return }
    skip(&mut p)
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, ">") {
        before := p.at
        _ := parse_type(&mut p)
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, ">")
}

fn qualified_name(p: &mut Parser) -> string {
    mut full := text(&p)
    skip(&mut p)
    while eat(&mut p, ".") {
        if kind(&p) == .Name {
            full = full + "." + text(&p)
            skip(&mut p)
        } else {
            fail_here(&mut p, "expected type name after '.'")
            break
        }
    }
    full
}

fn parse_type(p: &mut Parser) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_type(&mut p.module, ast.TypeNode { kind: .Error, name: "", inner: -1, count: 0, span: ast.span(start_off(&p, p.at), start_off(&p, p.at)) })
    }
    first := p.at
    mut out := -1
    if eat(&mut p, "&") {
        is_mut := eat(&mut p, "mut")
        inner := parse_type(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        k := if is_mut { ast.TypeKind.MutRef } else { ast.TypeKind.Ref }
        out = ast.add_type(&mut p.module, ast.TypeNode { kind: k, name: "", inner: inner, count: 0, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if eat(&mut p, "[") {
        if eat(&mut p, "]") {
            inner := parse_type(&mut p)
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_type(&mut p.module, ast.TypeNode { kind: .Slice, name: "", inner: inner, count: 0, span: ast.span(start_off(&p, first), end_off(&p, last)) })
        } else {
            inner := parse_type(&mut p)
            _ := expect(&mut p, ";")
            _ := parse_expr(&mut p, false)
            _ := expect(&mut p, "]")
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_type(&mut p.module, ast.TypeNode { kind: .FixedArray, name: "", inner: inner, count: 0, span: ast.span(start_off(&p, first), end_off(&p, last)) })
        }
    } else if is_sym(&p, "(") {
        skip(&mut p)
        skip_newlines(&mut p)
        if eat(&mut p, ")") {
            out = ast.add_type(&mut p.module, ast.TypeNode { kind: .Unit, name: "()", inner: -1, count: 0, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        } else {
            mut count := 0
            mut last_inner := -1
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                last_inner = parse_type(&mut p)
                count += 1
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
            out = ast.add_type(&mut p.module, ast.TypeNode { kind: .Tuple, name: "", inner: last_inner, count: count, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        }
    } else if is_word(&p, "extern") || is_word(&p, "fn") || ((is_word(&p, "Fn") || is_word(&p, "FnMut") || is_word(&p, "FnOnce")) && is_word_at(&p, p.at + 1, "(")) {
        _ := eat(&mut p, "extern")
        mut fn_name := "fn"
        if is_word(&p, "fn") || is_word(&p, "Fn") || is_word(&p, "FnMut") || is_word(&p, "FnOnce") {
            fn_name = text(&p)
            skip(&mut p)
        } else {
            _ := expect(&mut p, "fn")
        }
        if is_sym(&p, "[") { skip_balanced(&mut p, "[", "]") }
        mut param_count := 0
        if expect(&mut p, "(") {
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                _ := eat(&mut p, "move") || eat(&mut p, "mut")
                _ := parse_type(&mut p)
                param_count += 1
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
        }
        mut ret := -1
        if eat(&mut p, "->") {
            ret = parse_type(&mut p)
            skip_return_source(&mut p)
        }
        out = ast.add_type(&mut p.module, ast.TypeNode { kind: .FnType, name: fn_name, inner: ret, count: param_count, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
    } else if kind(&p) == .Name || is_word(&p, "Self") {
        full := qualified_name(&mut p)
        if is_sym(&p, "<") { parse_type_args(&mut p) }
        out = ast.add_type(&mut p.module, ast.TypeNode { kind: .Named, name: full, inner: -1, count: 0, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
    } else {
        fail_here(&mut p, "expected type name")
        out = ast.add_type(&mut p.module, ast.TypeNode { kind: .Error, name: "", inner: -1, count: 0, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    leave_depth(&mut p)
    out
}

fn parse_type_full(p: &mut Parser) -> i32 {
    parse_type(&mut p)
}

fn looks_like_struct_literal(p: &Parser) -> bool {
    if !is_sym(&p, "{") { return false }
    mut k := p.at + 1
    while k < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[k]) { k += 1 }
    if k >= p.tokens.kinds.len { return false }
    if p.tokens.texts[k] == "}" && p.tokens.kinds[k] == .Symbol { return true }
    if p.tokens.kinds[k] == .Name {
        if is_word_at(&p, k + 1, ":") { return true }
        if is_word_at(&p, k + 1, ",") || is_word_at(&p, k + 1, "}") { return true }
    }
    false
}

fn looks_like_struct_pattern(p: &Parser) -> bool {
    mut i := p.at
    if i >= p.tokens.kinds.len || p.tokens.kinds[i] != .Name { return false }
    i += 1
    if is_word_at(&p, i, ".") && i + 1 < p.tokens.kinds.len && p.tokens.kinds[i + 1] == .Name {
        i += 2
    }
    if is_word_at(&p, i, "<") { return false }
    if !is_word_at(&p, i, "{") { return false }
    // Look after `{` for `}` or `<Name> ... :=`
    if i < p.closes.len && p.closes[i] > i {
        after := p.closes[i] + 1
        return is_word_at(&p, after, ":=")
    }
    false
}

fn looks_like_generic_call(p: &Parser) -> bool {
    if !is_sym(&p, "<") { return false }
    mut i := p.at + 1
    mut depth := 1
    while i < p.tokens.kinds.len && depth > 0 {
        if p.tokens.kinds[i] == .End || p.tokens.kinds[i] == .Newline || is_word_at(&p, i, ";") { return false }
        if is_word_at(&p, i, "<") { depth += 1 }
        else if is_word_at(&p, i, ">") { depth -= 1 }
        else if is_word_at(&p, i, "{") || is_word_at(&p, i, "=") { return false }
        i += 1
    }
    if depth != 0 { return false }
    is_word_at(&p, i, "(") || is_word_at(&p, i, "::") || is_word_at(&p, i, "{")
}

fn parse_match_pattern(p: &mut Parser) {
    if !enter_depth(&mut p) { return }
    mut more := true
    while more && !at_end(&p) {
        more = false
        if eat(&mut p, "-") {
            if kind(&p) == .Integer || kind(&p) == .Float { skip(&mut p) }
            else { fail_here(&mut p, "expected number after '-' in pattern") }
        } else if eat(&mut p, ".") {
            if kind(&p) == .Name { skip(&mut p) }
            else { fail_here(&mut p, "expected variant name after '.' in pattern") }
            if eat(&mut p, "(") {
                skip_newlines(&mut p)
                while !at_end(&p) && !is_sym(&p, ")") {
                    before := p.at
                    if eat(&mut p, "..") {
                        // trailing rest pattern
                    } else {
                        _ := eat(&mut p, "mut")
                        parse_match_pattern(&mut p)
                    }
                    skip_newlines(&mut p)
                    if !eat(&mut p, ",") { break }
                    skip_newlines(&mut p)
                    if p.at == before { skip(&mut p) }
                }
                _ := expect(&mut p, ")")
            }
        } else if eat(&mut p, "(") {
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                _ := eat(&mut p, "mut")
                parse_match_pattern(&mut p)
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
        } else if kind(&p) == .Integer || kind(&p) == .Float || kind(&p) == .String || kind(&p) == .Rune || kind(&p) == .Byte || is_word(&p, "true") || is_word(&p, "false") {
            skip(&mut p)
        } else if kind(&p) == .Name {
            skip(&mut p)
            if is_sym(&p, "<") && looks_like_generic_call(&p) { parse_type_args(&mut p) }
            if eat(&mut p, ".") {
                if kind(&p) == .Name { skip(&mut p) }
                else { fail_here(&mut p, "expected variant name after '.'") }
                if eat(&mut p, "(") {
                    skip_newlines(&mut p)
                    while !at_end(&p) && !is_sym(&p, ")") {
                        before := p.at
                        if eat(&mut p, "..") {
                        } else {
                            _ := eat(&mut p, "mut")
                            parse_match_pattern(&mut p)
                        }
                        skip_newlines(&mut p)
                        if !eat(&mut p, ",") { break }
                        skip_newlines(&mut p)
                        if p.at == before { skip(&mut p) }
                    }
                    _ := expect(&mut p, ")")
                }
            }
        } else {
            fail_here(&mut p, "expected match pattern")
        }
        if eat(&mut p, "|") {
            skip_newlines(&mut p)
            more = true
        }
    }
    leave_depth(&mut p)
}

fn parse_block(p: &mut Parser) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Error, text: "", op: "", left: -1, right: -1, span: ast.span(start_off(&p, p.at), start_off(&p, p.at)) })
    }
    first := p.at
    if !expect(&mut p, "{") {
        leave_depth(&mut p)
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Error, text: "", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), start_off(&p, first)) })
    }
    skip_seps(&mut p)
    while !at_end(&p) && !is_sym(&p, "}") {
        before := p.at
        _ := parse_stmt(&mut p)
        skip_seps(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, "}")
    last := if p.at > first { p.at - 1 } else { first }
    leave_depth(&mut p)
    ast.add_expr(&mut p.module, ast.ExprNode { kind: .BlockExpr, text: "", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, last)) })
}

fn parse_if_expr(p: &mut Parser) -> i32 {
    first := p.at
    _ := expect(&mut p, "if")
    _ := parse_expr(&mut p, false)
    skip_newlines(&mut p)
    _ := parse_block(&mut p)
    mut else_at := p.at
    while else_at < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[else_at]) {
        else_at += 1
    }
    if is_word_at(&p, else_at, "else") {
        p.at = else_at + 1
        skip_newlines(&mut p)
        if is_word(&p, "if") {
            _ := parse_if_expr(&mut p)
        } else {
            _ := parse_block(&mut p)
        }
    }
    last := if p.at > first { p.at - 1 } else { first }
    ast.add_expr(&mut p.module, ast.ExprNode { kind: .IfExpr, text: "if", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, last)) })
}

fn parse_match_expr(p: &mut Parser) -> i32 {
    first := p.at
    _ := expect(&mut p, "match")
    _ := parse_expr(&mut p, false)
    skip_newlines(&mut p)
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            parse_match_pattern(&mut p)
            if eat(&mut p, "if") { _ := parse_expr(&mut p, false) }
            skip_newlines(&mut p)
            _ := expect(&mut p, "=>")
            skip_newlines(&mut p)
            if is_sym(&p, "{") {
                _ := parse_block(&mut p)
            } else if eat(&mut p, "return") {
                if !is_sep(&p) && !is_sym(&p, "}") && !is_sym(&p, ",") { _ := parse_expr(&mut p, true) }
            } else if eat(&mut p, "break") {
                if !is_sep(&p) && !is_sym(&p, "}") && !is_sym(&p, ",") { _ := parse_expr(&mut p, true) }
            } else if eat(&mut p, "continue") {
            } else if !at_end(&p) && !is_sym(&p, "}") {
                _ := parse_expr(&mut p, true)
            }
            _ := eat(&mut p, ",")
            skip_seps(&mut p)
            if p.at == before { sync_stmt(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    last := if p.at > first { p.at - 1 } else { first }
    ast.add_expr(&mut p.module, ast.ExprNode { kind: .MatchExpr, text: "match", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, last)) })
}

fn parse_closure_expr(p: &mut Parser) -> i32 {
    first := p.at
    _ := eat(&mut p, "move")
    _ := expect(&mut p, "fn")
    if eat(&mut p, "[") {
        skip_newlines(&mut p)
        while !at_end(&p) && !is_sym(&p, "]") {
            before := p.at
            _ := eat(&mut p, "&")
            _ := eat(&mut p, "mut")
            _ := eat(&mut p, "move")
            if kind(&p) == .Name { skip(&mut p) }
            else { fail_here(&mut p, "expected capture name"); break }
            if eat(&mut p, ":") { _ := parse_type_full(&mut p) }
            if eat(&mut p, "=") { _ := parse_expr(&mut p, true) }
            skip_newlines(&mut p)
            if !eat(&mut p, ",") { break }
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "]")
    }
    if expect(&mut p, "(") {
        skip_newlines(&mut p)
        while !at_end(&p) && !is_sym(&p, ")") {
            before := p.at
            _ := eat(&mut p, "move") || eat(&mut p, "mut")
            if kind(&p) == .Name { skip(&mut p) }
            else { fail_here(&mut p, "expected closure parameter name"); break }
            if eat(&mut p, ":") { _ := parse_type_full(&mut p) }
            skip_newlines(&mut p)
            if !eat(&mut p, ",") { break }
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, ")")
    }
    if eat(&mut p, "->") {
        _ := parse_type_full(&mut p)
        skip_return_source(&mut p)
    }
    skip_newlines(&mut p)
    _ := parse_block(&mut p)
    last := if p.at > first { p.at - 1 } else { first }
    ast.add_expr(&mut p.module, ast.ExprNode { kind: .Closure, text: "fn", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, last)) })
}

fn parse_struct_lit_fields(p: &mut Parser) {
    _ := expect(&mut p, "{")
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, "}") {
        before := p.at
        if kind(&p) != .Name { fail_here(&mut p, "expected struct field name"); break }
        skip(&mut p)
        if eat(&mut p, ":") {
            _ := parse_expr(&mut p, true)
        }
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { skip_newlines(&mut p); break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, "}")
}

fn parse_arg_list(p: &mut Parser) {
    _ := expect(&mut p, "(")
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, ")") {
        before := p.at
        if !(is_word(&p, "move") && is_word_at(&p, p.at + 1, "fn")) { _ := eat(&mut p, "move") }
        _ := parse_expr(&mut p, true)
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, ")")
}

fn parse_primary(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    first := p.at
    k := kind(&p)
    if k == .Integer {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Int, text: w, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    if k == .Float {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Float, text: w, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    if k == .String {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .String, text: w, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    if k == .Rune {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Rune, text: w, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    if k == .Byte {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Byte, text: w, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    if is_word(&p, "true") || is_word(&p, "false") {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Bool, text: w, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    if is_word(&p, "if") { return parse_if_expr(&mut p) }
    if is_word(&p, "match") { return parse_match_expr(&mut p) }
    if is_word(&p, "fn") || (is_word(&p, "move") && is_word_at(&p, p.at + 1, "fn")) { return parse_closure_expr(&mut p) }
    if is_word(&p, "unsafe") && is_word_at(&p, p.at + 1, "{") {
        skip(&mut p)
        return parse_block(&mut p)
    }
    if is_sym(&p, "@") {
        skip(&mut p)
        mut attr := ""
        if !at_end(&p) && kind(&p) == .Name {
            attr = text(&p)
            skip(&mut p)
        }
        if is_sym(&p, "(") { parse_arg_list(&mut p) }
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Call, text: "@" + attr, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
    }
    if is_sym(&p, "(") {
        skip(&mut p)
        skip_newlines(&mut p)
        if eat(&mut p, ")") {
            return ast.add_expr(&mut p.module, ast.ExprNode { kind: .TupleLit, text: "()", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        }
        inner := parse_expr(&mut p, true)
        skip_newlines(&mut p)
        if eat(&mut p, ",") {
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                _ := parse_expr(&mut p, true)
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
            return ast.add_expr(&mut p.module, ast.ExprNode { kind: .TupleLit, text: "", op: "", left: inner, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        }
        _ := expect(&mut p, ")")
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Group, text: "", op: "", left: inner, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
    }
    if is_sym(&p, "[") {
        skip(&mut p)
        skip_newlines(&mut p)
        if !is_sym(&p, "]") {
            _ := parse_expr(&mut p, true)
            skip_newlines(&mut p)
            if eat(&mut p, ";") {
                skip_newlines(&mut p)
                _ := parse_expr(&mut p, true)
            } else {
                while eat(&mut p, ",") {
                    skip_newlines(&mut p)
                    if is_sym(&p, "]") { break }
                    before := p.at
                    _ := parse_expr(&mut p, true)
                    skip_newlines(&mut p)
                    if p.at == before { skip(&mut p) }
                }
            }
            skip_newlines(&mut p)
        }
        _ := expect(&mut p, "]")
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .ArrayLit, text: "[]", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
    }
    if is_sym(&p, "{") {
        return parse_block(&mut p)
    }
    if is_sym(&p, ".") {
        // Variant shorthand `.Ok(...)` or `.None`
        skip(&mut p)
        if kind(&p) == .Name {
            vname := text(&p); skip(&mut p)
            if is_sym(&p, "(") { parse_arg_list(&mut p) }
            return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Ident, text: "." + vname, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        }
        fail_here(&mut p, "expected variant name after '.'")
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Error, text: "", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    }
    if k == .Name || is_word(&p, "Self") || is_word(&p, "len") {
        w := text(&p); skip(&mut p)
        mut node := ast.add_expr(&mut p.module, ast.ExprNode { kind: .Ident, text: w, op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
        if is_sym(&p, "<") && looks_like_generic_call(&p) {
            parse_type_args(&mut p)
        }
        if allow_struct_lit && looks_like_struct_literal(&p) {
            parse_struct_lit_fields(&mut p)
            node = ast.add_expr(&mut p.module, ast.ExprNode { kind: .StructLit, text: "", op: "", left: node, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        }
        return node
    }
    fail_here(&mut p, "expected expression")
    ast.add_expr(&mut p.module, ast.ExprNode { kind: .Error, text: "", op: "", left: -1, right: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
}

fn parse_postfix(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    first := p.at
    mut expr := parse_primary(&mut p, allow_struct_lit)
    while !at_end(&p) {
        if is_sym(&p, "(") {
            parse_arg_list(&mut p)
            expr = ast.add_expr(&mut p.module, ast.ExprNode { kind: .Call, text: "", op: "()", left: expr, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        } else if eat(&mut p, "::") {
            if kind(&p) == .Name {
                mname := text(&p); skip(&mut p)
                if is_sym(&p, "<") && looks_like_generic_call(&p) { parse_type_args(&mut p) }
                if allow_struct_lit && looks_like_struct_literal(&p) { parse_struct_lit_fields(&mut p) }
                expr = ast.add_expr(&mut p.module, ast.ExprNode { kind: .Field, text: mname, op: "::", left: expr, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
            } else {
                fail_here(&mut p, "expected identifier after '::'")
                break
            }
        } else if eat(&mut p, ".") {
            if kind(&p) == .Name || kind(&p) == .Integer {
                mname := text(&p); skip(&mut p)
                if is_sym(&p, "<") && looks_like_generic_call(&p) { parse_type_args(&mut p) }
                if is_sym(&p, "(") {
                    parse_arg_list(&mut p)
                    expr = ast.add_expr(&mut p.module, ast.ExprNode { kind: .MethodCall, text: mname, op: ".", left: expr, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
                } else if allow_struct_lit && looks_like_struct_literal(&p) {
                    parse_struct_lit_fields(&mut p)
                    expr = ast.add_expr(&mut p.module, ast.ExprNode { kind: .StructLit, text: mname, op: ".", left: expr, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
                } else {
                    expr = ast.add_expr(&mut p.module, ast.ExprNode { kind: .Field, text: mname, op: ".", left: expr, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
                }
            } else {
                fail_here(&mut p, "expected field or method name after '.'")
                break
            }
        } else if eat(&mut p, "[") {
            skip_newlines(&mut p)
            if eat(&mut p, "..") || eat(&mut p, "..=") {
                _ := eat(&mut p, "=")
                if !is_sym(&p, "]") { _ := parse_expr(&mut p, true) }
            } else {
                _ := parse_expr(&mut p, true)
                if eat(&mut p, "..") || eat(&mut p, "..=") {
                    _ := eat(&mut p, "=")
                    if !is_sym(&p, "]") { _ := parse_expr(&mut p, true) }
                }
            }
            skip_newlines(&mut p)
            _ := expect(&mut p, "]")
            expr = ast.add_expr(&mut p.module, ast.ExprNode { kind: .Index, text: "[]", op: "", left: expr, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        } else if eat(&mut p, "?") {
            expr = ast.add_expr(&mut p.module, ast.ExprNode { kind: .Try, text: "?", op: "?", left: expr, right: -1, span: ast.span(start_off(&p, first), end_off(&p, p.at - 1)) })
        } else {
            break
        }
    }
    expr
}

fn parse_unary(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Error, text: "", op: "", left: -1, right: -1, span: ast.span(start_off(&p, p.at), start_off(&p, p.at)) })
    }
    first := p.at
    mut out := -1
    if is_sym(&p, "-") || is_sym(&p, "!") || is_sym(&p, "&") || is_word(&p, "move") {
        mut op := text(&p)
        skip(&mut p)
        if op == "&" && eat(&mut p, "mut") { op = "&mut" }
        rhs := parse_unary(&mut p, allow_struct_lit)
        k := if op == "move" { ast.ExprKind.Move } else { ast.ExprKind.Unary }
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_expr(&mut p.module, ast.ExprNode { kind: k, text: "", op: op, left: rhs, right: -1, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else {
        out = parse_postfix(&mut p, allow_struct_lit)
    }
    leave_depth(&mut p)
    out
}

fn infix_precedence(p: &Parser) -> i32 {
    if is_sym(&p, "*") || is_sym(&p, "/") || is_sym(&p, "%") { return 6 }
    if is_sym(&p, "+") || is_sym(&p, "-") { return 5 }
    if is_sym(&p, "==") || is_sym(&p, "!=") || is_sym(&p, "<") || is_sym(&p, "<=") || is_sym(&p, ">") || is_sym(&p, ">=") { return 4 }
    if is_sym(&p, "&&") { return 3 }
    if is_sym(&p, "||") { return 2 }
    if is_sym(&p, "..") || is_sym(&p, "..=") { return 1 }
    0
}

fn parse_binary(p: &mut Parser, min_prec: i32, allow_struct_lit: bool) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_expr(&mut p.module, ast.ExprNode { kind: .Error, text: "", op: "", left: -1, right: -1, span: ast.span(start_off(&p, p.at), start_off(&p, p.at)) })
    }
    mut lhs := parse_unary(&mut p, allow_struct_lit)
    while !at_end(&p) {
        prec := infix_precedence(&p)
        if prec < min_prec || prec == 0 { break }
        mut op := text(&p)
        skip(&mut p)
        if op == ".." && eat(&mut p, "=") { op = "..=" }
        if is_nl(&p) { skip_newlines(&mut p) }
        rhs := parse_binary(&mut p, prec + 1, allow_struct_lit)
        lspan := p.module.exprs[lhs].span
        rspan := p.module.exprs[rhs].span
        kind_node := if op == ".." || op == "..=" { ast.ExprKind.Range } else { ast.ExprKind.Binary }
        lhs = ast.add_expr(&mut p.module, ast.ExprNode { kind: kind_node, text: "", op: op, left: lhs, right: rhs, span: ast.span(lspan.start, rspan.end) })
    }
    leave_depth(&mut p)
    lhs
}

fn parse_expr(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    parse_binary(&mut p, 1, allow_struct_lit)
}

fn assignment_op(p: &Parser) -> bool {
    is_sym(&p, "=") || is_sym(&p, "+=") || is_sym(&p, "-=") || is_sym(&p, "*=") || is_sym(&p, "/=") || is_sym(&p, "%=")
}

fn looks_like_region_stmt(p: &Parser) -> bool {
    if !is_word(&p, "region") { return false }
    if p.at + 1 >= p.tokens.kinds.len || p.tokens.kinds[p.at + 1] != .Name { return false }
    mut k := p.at + 2
    while k < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[k]) { k += 1 }
    is_word_at(&p, k, "{")
}

fn parse_stmt(p: &mut Parser) -> i32 {
    if !enter_depth(&mut p) {
        sync_stmt(&mut p)
        return -1
    }
    first := p.at
    mut out := -1
    if eat(&mut p, "return") {
        mut val := -1
        if !is_sep(&p) && !is_sym(&p, "}") { val = parse_expr(&mut p, true) }
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Return, name: "", is_mut: false, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if eat(&mut p, "break") {
        mut val := -1
        if !is_sep(&p) && !is_sym(&p, "}") { val = parse_expr(&mut p, true) }
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Break, name: "", is_mut: false, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if eat(&mut p, "continue") {
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Continue, name: "", is_mut: false, expr: -1, span: ast.span(start_off(&p, first), end_off(&p, first)) })
    } else if eat(&mut p, "defer") {
        mut val := -1
        if is_sym(&p, "{") { val = parse_block(&mut p) } else { val = parse_expr(&mut p, true) }
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Defer, name: "", is_mut: false, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if eat(&mut p, "while") {
        cond := parse_expr(&mut p, false)
        skip_newlines(&mut p)
        _ := parse_block(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .While, name: "", is_mut: false, expr: cond, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if eat(&mut p, "for") {
        mut name := "_"
        if is_sym(&p, "(") {
            skip_balanced(&mut p, "(", ")")
        } else if kind(&p) == .Name {
            name = text(&p); skip(&mut p)
        } else {
            fail_here(&mut p, "expected loop variable name")
        }
        _ := expect(&mut p, "in")
        _ := eat(&mut p, "move")
        iter := parse_expr(&mut p, false)
        skip_newlines(&mut p)
        _ := parse_block(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .For, name: name, is_mut: false, expr: iter, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if looks_like_region_stmt(&p) && eat(&mut p, "region") {
        mut rname := ""
        if kind(&p) == .Name { rname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected region name") }
        skip_newlines(&mut p)
        blk := parse_block(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Region, name: rname, is_mut: false, expr: blk, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if is_word(&p, "task") && is_word_at(&p, p.at + 1, "scope") {
        skip(&mut p); skip(&mut p)
        mut sname := ""
        if kind(&p) == .Name { sname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected task scope name") }
        if eat(&mut p, "(") {
            skip_newlines(&mut p)
            _ := eat(&mut p, "shared")
            _ := parse_expr(&mut p, true)
            while eat(&mut p, ",") {
                skip_newlines(&mut p)
                _ := eat(&mut p, "shared")
                if !is_sym(&p, ")") { _ := parse_expr(&mut p, true) }
            }
            _ := expect(&mut p, ")")
        }
        skip_newlines(&mut p)
        while is_word(&p, "with") || is_word(&p, "arena") {
            if eat(&mut p, "with") {
                skip_newlines(&mut p)
                if expect(&mut p, "(") {
                    skip_newlines(&mut p)
                    while !at_end(&p) && !is_sym(&p, ")") {
                        skip(&mut p)
                        if !eat(&mut p, ",") { break }
                        skip_newlines(&mut p)
                    }
                    _ := expect(&mut p, ")")
                }
            } else if eat(&mut p, "arena") {
                skip_newlines(&mut p)
                _ := parse_expr(&mut p, false)
            }
            skip_newlines(&mut p)
        }
        blk := parse_block(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .TaskScope, name: sname, is_mut: false, expr: blk, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if eat(&mut p, "mut") {
        if looks_like_struct_pattern(&p) {
            if kind(&p) == .Name { skip(&mut p) }
            if eat(&mut p, ".") && kind(&p) == .Name { skip(&mut p) }
            skip_balanced(&mut p, "{", "}")
            _ := expect(&mut p, ":=")
            val := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Let, name: "", is_mut: true, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
        } else if is_sym(&p, "(") {
            skip_balanced(&mut p, "(", ")")
            _ := expect(&mut p, ":=")
            val := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Let, name: "", is_mut: true, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
        } else {
            mut bname := "_"
            if kind(&p) == .Name { bname = text(&p); skip(&mut p) }
            else { fail_here(&mut p, "expected variable name after 'mut'") }
            if eat(&mut p, ":") {
                _ := parse_type_full(&mut p)
                _ := expect(&mut p, "=")
            } else {
                _ := expect(&mut p, ":=")
            }
            val := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Let, name: bname, is_mut: true, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
        }
    } else if kind(&p) == .Name && is_word_at(&p, p.at + 1, ":=") {
        bname := text(&p); skip(&mut p); skip(&mut p)
        val := parse_expr(&mut p, true)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Let, name: bname, is_mut: false, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if kind(&p) == .Name && is_word_at(&p, p.at + 1, ":") {
        bname := text(&p); skip(&mut p); skip(&mut p)
        _ := parse_type_full(&mut p)
        _ := expect(&mut p, "=")
        val := parse_expr(&mut p, true)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Let, name: bname, is_mut: false, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if looks_like_struct_pattern(&p) {
        if kind(&p) == .Name { skip(&mut p) }
        if eat(&mut p, ".") && kind(&p) == .Name { skip(&mut p) }
        skip_balanced(&mut p, "{", "}")
        _ := expect(&mut p, ":=")
        val := parse_expr(&mut p, true)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Let, name: "", is_mut: false, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else if is_sym(&p, "(") && p.at < p.closes.len && p.closes[p.at] > p.at && is_word_at(&p, p.closes[p.at] + 1, ":=") {
        skip_balanced(&mut p, "(", ")")
        _ := expect(&mut p, ":=")
        val := parse_expr(&mut p, true)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Let, name: "", is_mut: false, expr: val, span: ast.span(start_off(&p, first), end_off(&p, last)) })
    } else {
        expr := parse_expr(&mut p, true)
        if assignment_op(&p) {
            skip(&mut p)
            rhs := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Assign, name: "", is_mut: false, expr: rhs, span: ast.span(start_off(&p, first), end_off(&p, last)) })
        } else {
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_stmt(&mut p.module, ast.StmtNode { kind: .Expr, name: "", is_mut: false, expr: expr, span: ast.span(start_off(&p, first), end_off(&p, last)) })
        }
    }
    if !is_sep(&p) && !is_sym(&p, "}") {
        fail_here(&mut p, "expected newline or ';' after statement")
        sync_stmt(&mut p)
    }
    leave_depth(&mut p)
    out
}

fn parse_param_list(p: &mut Parser, allow_self: bool, first_out: &mut i32, count_out: &mut i32) {
    first_out = p.module.params.len
    count_out = 0
    if !expect(&mut p, "(") { return }
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, ")") {
        before := p.at
        pstart := p.at
        mut is_mut := eat(&mut p, "mut")
        is_move := eat(&mut p, "move")
        if !is_mut && eat(&mut p, "mut") { is_mut = true }
        mut pname := ""
        mut pty := -1
        if eat(&mut p, "&") {
            _ := eat(&mut p, "mut")
            if allow_self && eat(&mut p, "self") {
                pname = "self"
            } else {
                fail_here(&mut p, "expected 'self' after '&' in parameter")
            }
        } else if allow_self && eat(&mut p, "self") {
            pname = "self"
            if eat(&mut p, ":") { pty = parse_type_full(&mut p) }
        } else if kind(&p) == .Name {
            pname = text(&p); skip(&mut p)
            _ := expect(&mut p, ":")
            pty = parse_type_full(&mut p)
        } else {
            fail_here(&mut p, "expected parameter name")
            break
        }
        plast := if p.at > pstart { p.at - 1 } else { pstart }
        p.module.params.push(ast.Param {
            name: pname,
            is_mut: is_mut,
            is_move: is_move,
            ty: pty,
            span: ast.span(start_off(&p, pstart), end_off(&p, plast)),
        })
        count_out += 1
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, ")")
}

fn parse_struct_item(p: &mut Parser, item_start: i32, is_pub: bool, is_opaque: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // struct
    name_tok := p.at
    mut sname := ""
    if kind(&p) == .Name { sname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected struct name") }
    if is_sym(&p, "<") { skip_generic_params(&mut p) }
    skip_where_clause(&mut p)
    skip_newlines(&mut p)
    first_member := p.module.members.len
    mut member_count := 0
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            fstart := p.at
            mut fname := ""
            mut fty := -1
            if kind(&p) == .Name {
                fname = text(&p); skip(&mut p)
                if expect(&mut p, ":") { fty = parse_type_full(&mut p) }
            } else {
                fail_here(&mut p, "expected struct field name")
                sync_stmt(&mut p)
            }
            flast := if p.at > fstart { p.at - 1 } else { fstart }
            if fname != "" {
                p.module.members.push(ast.Member {
                    name: fname, is_pub: false, is_unsafe: false, ty: fty,
                    span: ast.span(start_off(&p, fstart), end_off(&p, flast)),
                    body_span: ast.span(0, 0),
                })
                member_count += 1
            }
            _ := eat(&mut p, ",")
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    p.module.items.push(ast.Item {
        kind: .Struct, name: sname, target_name: "", trait_name: "",
        is_pub: is_pub, is_unsafe: false, is_opaque: is_opaque, is_test: false,
        span: ast.span(start_off(&p, item_start), end_off(&p, last)),
        name_span: ast.span(start_off(&p, name_tok), end_off(&p, name_tok)),
        body_span: ast.span(start_off(&p, body_tok), end_off(&p, last)),
        first_param: 0, param_count: 0,
        first_member: first_member, member_count: member_count,
        first_attr: first_attr, attr_count: attr_count, ret_type: -1,
    })
}

fn parse_enum_item(p: &mut Parser, item_start: i32, is_pub: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // enum
    name_tok := p.at
    mut ename := ""
    if kind(&p) == .Name { ename = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected enum name") }
    if is_sym(&p, "<") { skip_generic_params(&mut p) }
    skip_where_clause(&mut p)
    skip_newlines(&mut p)
    first_member := p.module.members.len
    mut member_count := 0
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            vstart := p.at
            mut vname := ""
            if kind(&p) == .Name {
                vname = text(&p); skip(&mut p)
                if eat(&mut p, "(") {
                    skip_newlines(&mut p)
                    while !at_end(&p) && !is_sym(&p, ")") {
                        b2 := p.at
                        _ := parse_type_full(&mut p)
                        skip_newlines(&mut p)
                        if !eat(&mut p, ",") { break }
                        skip_newlines(&mut p)
                        if p.at == b2 { skip(&mut p) }
                    }
                    _ := expect(&mut p, ")")
                }
                if eat(&mut p, "=") {
                    _ := eat(&mut p, "-")
                    if kind(&p) == .Integer { skip(&mut p) } else { fail_here(&mut p, "expected integer tag") }
                }
            } else {
                fail_here(&mut p, "expected enum variant name")
                sync_stmt(&mut p)
            }
            vlast := if p.at > vstart { p.at - 1 } else { vstart }
            if vname != "" {
                p.module.members.push(ast.Member {
                    name: vname, is_pub: false, is_unsafe: false, ty: -1,
                    span: ast.span(start_off(&p, vstart), end_off(&p, vlast)),
                    body_span: ast.span(0, 0),
                })
                member_count += 1
            }
            _ := eat(&mut p, ",")
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    p.module.items.push(ast.Item {
        kind: .Enum, name: ename, target_name: "", trait_name: "",
        is_pub: is_pub, is_unsafe: false, is_opaque: false, is_test: false,
        span: ast.span(start_off(&p, item_start), end_off(&p, last)),
        name_span: ast.span(start_off(&p, name_tok), end_off(&p, name_tok)),
        body_span: ast.span(start_off(&p, body_tok), end_off(&p, last)),
        first_param: 0, param_count: 0,
        first_member: first_member, member_count: member_count,
        first_attr: first_attr, attr_count: attr_count, ret_type: -1,
    })
}

fn parse_fn_item(p: &mut Parser, item_start: i32, is_pub: bool, is_unsafe: bool, is_test: bool, is_extern: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // fn
    name_tok := p.at
    mut fname := ""
    if kind(&p) == .Name { fname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected function name") }
    if is_sym(&p, "<") { skip_generic_params(&mut p) }
    mut fp := 0; mut fc := 0
    parse_param_list(&mut p, false, &mut fp, &mut fc)
    mut ret := -1
    if eat(&mut p, "->") {
        ret = parse_type_full(&mut p)
        skip_return_source(&mut p)
    }
    skip_where_clause(&mut p)
    skip_newlines(&mut p)
    mut body_span := ast.span(0, 0)
    mut k := ast.ItemKind.Fn
    if is_extern {
        k = .ExternFn
        if is_sym(&p, "{") { fail_here(&mut p, "external declaration cannot have a body") }
    } else {
        bexpr := parse_block(&mut p)
        body_span = p.module.exprs[bexpr].span
    }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    p.module.items.push(ast.Item {
        kind: k, name: fname, target_name: "", trait_name: "",
        is_pub: is_pub, is_unsafe: is_unsafe, is_opaque: false, is_test: is_test,
        span: ast.span(start_off(&p, item_start), end_off(&p, last)),
        name_span: ast.span(start_off(&p, name_tok), end_off(&p, name_tok)),
        body_span: body_span,
        first_param: fp, param_count: fc,
        first_member: 0, member_count: 0,
        first_attr: first_attr, attr_count: attr_count, ret_type: ret,
    })
}

fn parse_trait_item(p: &mut Parser, item_start: i32, is_pub: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // trait
    name_tok := p.at
    mut tname := ""
    if kind(&p) == .Name { tname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected trait name") }
    if is_sym(&p, "<") { skip_generic_params(&mut p) }
    if eat(&mut p, ":") {
        while !at_end(&p) {
            skip_newlines(&mut p)
            if kind(&p) == .Name { skip(&mut p) } else { fail_here(&mut p, "expected supertrait name"); break }
            if !eat(&mut p, "+") { break }
        }
    }
    skip_where_clause(&mut p)
    skip_newlines(&mut p)
    first_member := p.module.members.len
    mut member_count := 0
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            mstart := p.at
            m_unsafe := eat(&mut p, "unsafe")
            if !expect(&mut p, "fn") { sync_stmt(&mut p) }
            else {
                mut mname := ""
                if kind(&p) == .Name { mname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected trait method name") }
                if is_sym(&p, "<") { skip_generic_params(&mut p) }
                mut mp := 0; mut mc := 0
                parse_param_list(&mut p, true, &mut mp, &mut mc)
                mut mty := -1
                if eat(&mut p, "->") {
                    mty = parse_type_full(&mut p)
                    skip_return_source(&mut p)
                }
                skip_where_clause(&mut p)
                skip_newlines(&mut p)
                mut bspan := ast.span(0, 0)
                if is_sym(&p, "{") {
                    bexpr := parse_block(&mut p)
                    bspan = p.module.exprs[bexpr].span
                }
                mlast := if p.at > mstart { p.at - 1 } else { mstart }
                p.module.members.push(ast.Member {
                    name: mname, is_pub: false, is_unsafe: m_unsafe, ty: mty,
                    span: ast.span(start_off(&p, mstart), end_off(&p, mlast)),
                    body_span: bspan,
                })
                member_count += 1
            }
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    p.module.items.push(ast.Item {
        kind: .Trait, name: tname, target_name: "", trait_name: "",
        is_pub: is_pub, is_unsafe: false, is_opaque: false, is_test: false,
        span: ast.span(start_off(&p, item_start), end_off(&p, last)),
        name_span: ast.span(start_off(&p, name_tok), end_off(&p, name_tok)),
        body_span: ast.span(start_off(&p, body_tok), end_off(&p, last)),
        first_param: 0, param_count: 0,
        first_member: first_member, member_count: member_count,
        first_attr: first_attr, attr_count: attr_count, ret_type: -1,
    })
}

fn parse_impl_item(p: &mut Parser, item_start: i32, first_attr: i32, attr_count: i32) {
    skip(&mut p) // impl
    if is_sym(&p, "<") { skip_generic_params(&mut p) }
    mut first_name := ""
    name_tok := p.at
    mut target_tok := name_tok
    mut trait_name := ""
    mut target_name := ""
    if kind(&p) == .Name { first_name = qualified_name(&mut p) }
    else { fail_here(&mut p, "expected type or trait name after 'impl'") }
    if is_sym(&p, "<") { skip_generic_params(&mut p) }
    skip_newlines(&mut p)
    if eat(&mut p, "for") {
        trait_name = first_name
        skip_newlines(&mut p)
        target_tok = p.at
        if is_sym(&p, "[") || is_sym(&p, "(") {
            _ := parse_type_full(&mut p)
            target_name = "compound"
        } else if kind(&p) == .Name {
            target_name = qualified_name(&mut p)
            if is_sym(&p, "<") { skip_generic_params(&mut p) }
        } else {
            fail_here(&mut p, "expected target type after 'for'")
        }
    } else {
        target_name = first_name
    }
    skip_where_clause(&mut p)
    skip_newlines(&mut p)
    first_member := p.module.members.len
    mut member_count := 0
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            mstart := p.at
            while eat(&mut p, "@") {
                if kind(&p) == .Name { skip(&mut p) }
                if is_sym(&p, "(") { skip_balanced(&mut p, "(", ")") }
                skip_newlines(&mut p)
            }
            m_pub := eat(&mut p, "pub")
            m_unsafe := eat(&mut p, "unsafe")
            if !expect(&mut p, "fn") {
                sync_stmt(&mut p)
            } else {
                mut mname := ""
                if kind(&p) == .Name { mname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected method name") }
                if is_sym(&p, "<") { skip_generic_params(&mut p) }
                mut mp := 0; mut mc := 0
                parse_param_list(&mut p, true, &mut mp, &mut mc)
                mut mty := -1
                if eat(&mut p, "->") {
                    mty = parse_type_full(&mut p)
                    skip_return_source(&mut p)
                }
                skip_where_clause(&mut p)
                skip_newlines(&mut p)
                bexpr := parse_block(&mut p)
                bspan := p.module.exprs[bexpr].span
                mlast := if p.at > mstart { p.at - 1 } else { mstart }
                p.module.members.push(ast.Member {
                    name: mname, is_pub: m_pub, is_unsafe: m_unsafe, ty: mty,
                    span: ast.span(start_off(&p, mstart), end_off(&p, mlast)),
                    body_span: bspan,
                })
                member_count += 1
            }
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    p.module.items.push(ast.Item {
        kind: .Impl, name: target_name.clone(), target_name: target_name, trait_name: trait_name,
        is_pub: false, is_unsafe: false, is_opaque: false, is_test: false,
        span: ast.span(start_off(&p, item_start), end_off(&p, last)),
        name_span: ast.span(start_off(&p, target_tok), end_off(&p, target_tok)),
        body_span: ast.span(start_off(&p, body_tok), end_off(&p, last)),
        first_param: 0, param_count: 0,
        first_member: first_member, member_count: member_count,
        first_attr: first_attr, attr_count: attr_count, ret_type: -1,
    })
}

fn parse_top_item(p: &mut Parser) {
    item_start := p.at
    if is_word(&p, "capability") {
        skip(&mut p)
        while !at_end(&p) && !is_sep(&p) {
            if kind(&p) == .Name { skip(&mut p) } else { fail_here(&mut p, "expected capability name"); break }
            if !eat(&mut p, ",") { break }
        }
        last := if p.at > item_start { p.at - 1 } else { item_start }
        p.module.items.push(ast.Item {
            kind: .Capability, name: "capability", target_name: "", trait_name: "",
            is_pub: false, is_unsafe: false, is_opaque: false, is_test: false,
            span: ast.span(start_off(&p, item_start), end_off(&p, last)),
            name_span: ast.span(start_off(&p, item_start), end_off(&p, item_start)),
            body_span: ast.span(0, 0), first_param: 0, param_count: 0,
            first_member: 0, member_count: 0, first_attr: 0, attr_count: 0, ret_type: -1,
        })
        return
    }
    if is_word(&p, "import") {
        skip(&mut p)
        name_tok := p.at
        mut ipath := ""
        while !at_end(&p) && !is_sep(&p) && !is_word(&p, "as") {
            ipath = ipath + text(&p)
            skip(&mut p)
        }
        mut alias := ipath.clone()
        if eat(&mut p, "as") {
            if kind(&p) == .Name { alias = text(&p); skip(&mut p) }
            else { fail_here(&mut p, "expected import alias after 'as'") }
        }
        last := if p.at > item_start { p.at - 1 } else { item_start }
        p.module.items.push(ast.Item {
            kind: .Import, name: alias, target_name: ipath, trait_name: "",
            is_pub: false, is_unsafe: false, is_opaque: false, is_test: false,
            span: ast.span(start_off(&p, item_start), end_off(&p, last)),
            name_span: ast.span(start_off(&p, name_tok), end_off(&p, last)),
            body_span: ast.span(0, 0), first_param: 0, param_count: 0,
            first_member: 0, member_count: 0, first_attr: 0, attr_count: 0, ret_type: -1,
        })
        return
    }

    first_attr := p.module.attrs.len
    mut attr_count := 0
    mut is_test := false
    mut is_extern := false
    while eat(&mut p, "@") {
        astart := p.at - 1
        mut aname := ""
        if kind(&p) == .Name { aname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected attribute name"); break }
        if aname == "test" { is_test = true }
        if aname == "extern" { is_extern = true }
        if is_sym(&p, "(") { skip_balanced(&mut p, "(", ")") }
        skip_newlines(&mut p)
        if aname == "test" && is_sym(&p, "{") { skip_balanced(&mut p, "{", "}"); skip_newlines(&mut p) }
        alast := if p.at > astart { p.at - 1 } else { astart }
        p.module.attrs.push(ast.Attr { name: aname, span: ast.span(start_off(&p, astart), end_off(&p, alast)) })
        attr_count += 1
    }

    is_pub := eat(&mut p, "pub")
    is_unsafe := eat(&mut p, "unsafe")
    is_opaque := eat(&mut p, "opaque")

    if is_word(&p, "const") {
        skip(&mut p)
        name_tok := p.at
        mut cname := ""
        if kind(&p) == .Name { cname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected constant name") }
        mut cty := -1
        if eat(&mut p, ":") { cty = parse_type_full(&mut p) }
        if expect(&mut p, "=") { _ := parse_expr(&mut p, true) }
        last := if p.at > item_start { p.at - 1 } else { item_start }
        p.module.items.push(ast.Item {
            kind: .Const, name: cname, target_name: "", trait_name: "",
            is_pub: is_pub, is_unsafe: false, is_opaque: false, is_test: false,
            span: ast.span(start_off(&p, item_start), end_off(&p, last)),
            name_span: ast.span(start_off(&p, name_tok), end_off(&p, name_tok)),
            body_span: ast.span(0, 0), first_param: 0, param_count: 0,
            first_member: 0, member_count: 0, first_attr: first_attr, attr_count: attr_count, ret_type: cty,
        })
        return
    }
    if is_word(&p, "struct") { parse_struct_item(&mut p, item_start, is_pub, is_opaque, first_attr, attr_count); return }
    if is_word(&p, "enum") { parse_enum_item(&mut p, item_start, is_pub, first_attr, attr_count); return }
    if is_word(&p, "trait") { parse_trait_item(&mut p, item_start, is_pub, first_attr, attr_count); return }
    if is_word(&p, "impl") { parse_impl_item(&mut p, item_start, first_attr, attr_count); return }
    if is_word(&p, "fn") { parse_fn_item(&mut p, item_start, is_pub, is_unsafe, is_test, is_extern, first_attr, attr_count); return }

    fail_here(&mut p, "expected declaration (fn, struct, enum, trait, impl, const, import or capability)")
    sync_top_level(&mut p)
}

pub fn parse_tokens(path: string, tokens: &lexer.Tokens) -> ast.Module {
    mut p := new_parser(path, &tokens)
    if !tokens.ok {
        record_error(&mut p, "E1001", 0, -1, tokens.error.clone())
        if p.module.diagnostics.len > 0 {
            sp := diag.resolve_span(tokens.source, tokens.error_at, -1)
            p.module.diagnostics[0].start = sp.start
            p.module.diagnostics[0].end = sp.end
        }
        return p.module
    }
    skip_seps(&mut p)
    while !at_end(&p) && p.module.diagnostics.len < 32 {
        before := p.at
        parse_top_item(&mut p)
        skip_seps(&mut p)
        if p.at == before { skip(&mut p) }
    }
    p.module
}

pub fn parse_source(path: string, source: string) -> ast.Module {
    tokens := lexer.scan(source, false)
    parse_tokens(path, &tokens)
}

@test fn parser_handles_declarations_expressions_and_generics() {
    src := "capability filesystem\nimport std.text as text\nconst LIMIT: i32 = 16\n" +
    "@derive(Eq)\nstruct Box<T> { val: T, tag: i32 }\n" +
    "enum Msg { Empty, Pair(i32, string) }\n" +
    "trait Show { fn show(&self) -> string }\n" +
    "impl Show for Box<i32> { fn show(&self) -> string { f\"box:{self.tag}\" } }\n" +
    "fn work(mut a: []i32, f: fn(i32) -> i32) -> i32 {\n" +
    "    x := Box<i32> { val: 1, tag: 2 }\n" +
    "    res := match x.tag { 0 => 10, 1 | 2 if a.len > 0 => f(a[0]), _ => 0 }\n" +
    "    for i in 0..=4 { a.push(i) }\n" +
    "    res\n" +
    "}\n"
    m := parse_source("sample.ddr", src)
    assert(m.ok && m.diagnostics.len == 0)
    assert(ast.item_count(&m) == 8)
    assert(m.items[4].kind == .Enum && m.items[4].name == "Msg" && m.items[4].member_count == 2)
    assert(m.items[7].kind == .Fn && m.items[7].name == "work" && m.items[7].param_count == 2)
    assert(ast.find_item_at(&m, m.items[7].name_span.start) == 7)
}

@test fn parser_recovers_multiple_errors_across_functions() {
    src := "fn broken_one( { x := 1 }\nfn valid(a: i32) -> i32 { a + 1 }\nfn broken_two() { y := ; }\n"
    m := parse_source("broken.ddr", src)
    assert(!m.ok && m.diagnostics.len >= 2)
    mut saw_valid := false
    for it in &m.items {
        if it.kind == .Fn && it.name == "valid" { saw_valid = true }
    }
    assert(saw_valid)
}

@test fn parser_parses_closures_tasks_and_regions() {
    src := "fn runner(n: i32) -> i32 {\n" +
    "    base := 10\n" +
    "    f := fn[base](x: i32) -> i32 { x + base }\n" +
    "    mut total := 0\n" +
    "    region scratch { total = f(n) }\n" +
    "    total\n" +
    "}\n"
    m := parse_source("closures.ddr", src)
    assert(m.ok && m.items.len == 1 && m.items[0].name == "runner")
}
