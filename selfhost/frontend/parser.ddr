import ast
import diagnostics as diag
import lexer

struct Parser {
    tokens: &lexer.Tokens,
    closes: []i32,
    at: i32,
    depth: i32,
    pending_eq: bool,
    in_test_block: bool,
    module: ast.Module,
}

fn new_parser(path: string, tokens: &lexer.Tokens) -> Parser from tokens {
    closes := lexer.delimiter_ends(&tokens, tokens.kinds.len)
    Parser {
        tokens: tokens,
        closes: closes,
        at: 0,
        depth: 0,
        pending_eq: false,
        in_test_block: false,
        module: ast.new_module(path, tokens.source.clone()),
    }
}

fn at_end(p: &Parser) -> bool {
    p.at >= p.tokens.kinds.len || p.tokens.kinds[p.at] == .End
}

fn kind(p: &Parser) -> lexer.Kind {
    if p.at >= p.tokens.kinds.len { return .End }
    p.tokens.kinds[p.at]
}

fn text(p: &Parser) -> string {
    if p.at >= p.tokens.texts.len { return "" }
    p.tokens.texts[p.at].clone()
}

fn start_off(p: &Parser, tok: i32) -> i32 {
    if tok >= 0 && tok < p.tokens.starts.len { return p.tokens.starts[tok] }
    p.tokens.source.len
}

fn end_off(p: &Parser, tok: i32) -> i32 {
    if tok < 0 || tok >= p.tokens.starts.len { return p.tokens.source.len }
    if p.tokens.store_ends && tok < p.tokens.ends.len && p.tokens.ends[tok] >= p.tokens.starts[tok] {
        return p.tokens.ends[tok]
    }
    sp := diag.resolve_span(p.tokens.source, p.tokens.starts[tok], -1)
    sp.end
}

fn is_word(p: &Parser, word: string) -> bool {
    is_word_at(&p, p.at, word)
}

fn is_word_at(p: &Parser, idx: i32, word: string) -> bool {
    if idx < 0 || idx >= p.tokens.kinds.len { return false }
    k := p.tokens.kinds[idx]
    (k == .Name || k == .Keyword || k == .Symbol) && p.tokens.texts[idx] == word
}

fn is_sym(p: &Parser, sym: string) -> bool {
    if p.pending_eq && sym == "=" { return true }
    kind(&p) == .Symbol && p.tokens.texts[p.at] == sym
}

fn is_nl(p: &Parser) -> bool {
    lexer.is_newline(kind(&p))
}

fn is_sep(p: &Parser) -> bool {
    is_nl(&p) || is_sym(&p, ";") || at_end(&p)
}

fn skip(p: &mut Parser) {
    if p.at < p.tokens.kinds.len - 1 { p.at += 1 }
    else { p.at = p.tokens.kinds.len }
}

fn skip_newlines(p: &mut Parser) {
    while !at_end(&p) && is_nl(&p) { skip(&mut p) }
}

fn skip_seps(p: &mut Parser) {
    while !at_end(&p) && (is_nl(&p) || is_sym(&p, ";")) { skip(&mut p) }
}

fn eat(p: &mut Parser, word: string) -> bool {
    if p.pending_eq && word == "=" { p.pending_eq = false; return true }
    if is_word(&p, word) { skip(&mut p); return true }
    false
}

fn record_error(p: &mut Parser, code: string, first_tok: i32, last_tok: i32, message: string) {
    p.module.ok = false
    if p.module.diagnostics.len >= 32 { return }
    s := start_off(&p, first_tok)
    mut e := if last_tok >= first_tok { end_off(&p, last_tok) } else { end_off(&p, first_tok) }
    if e < s { e = s }
    for i in 0..p.module.diagnostics.len {
        prev := &p.module.diagnostics[i]
        if prev.start == s && prev.message == message { return }
    }
    p.module.diagnostics.push(diag.Diagnostic {
        severity: .Error,
        code: code.clone(),
        path: p.module.path.clone(),
        start: s,
        end: e,
        message: message.clone(),
        note_path: "",
        note_start: -1,
        note_end: -1,
        note_message: "",
    })
}

fn fail_here(p: &mut Parser, message: string) {
    record_error(&mut p, "E1002", p.at, -1, message)
}

fn expect(p: &mut Parser, word: string) -> bool {
    if eat(&mut p, word) { return true }
    fail_here(&mut p, "expected '" + word + "'")
    false
}

fn enter_depth(p: &mut Parser) -> bool {
    if p.depth >= 128 {
        record_error(&mut p, "E1003", p.at, -1, "expression nesting exceeds 128")
        return false
    }
    p.depth += 1
    true
}

fn leave_depth(p: &mut Parser) {
    if p.depth > 0 { p.depth -= 1 }
}

fn skip_balanced(p: &mut Parser, open: string, close: string) {
    if !is_sym(&p, open) { return }
    if p.at < p.closes.len && p.closes[p.at] > p.at {
        p.at = p.closes[p.at] + 1
        return
    }
    mut d := 0
    while !at_end(&p) {
        if is_sym(&p, open) { d += 1 }
        else if is_sym(&p, close) {
            d -= 1
            if d == 0 { skip(&mut p); return }
        }
        skip(&mut p)
    }
}

fn top_level_keyword(p: &Parser) -> bool {
    if is_sym(&p, "@") { return true }
    is_word(&p, "pub") || is_word(&p, "unsafe") || is_word(&p, "opaque") ||
    is_word(&p, "capability") || is_word(&p, "import") || is_word(&p, "const") ||
    is_word(&p, "struct") || is_word(&p, "union") || is_word(&p, "enum") || is_word(&p, "trait") ||
    is_word(&p, "impl") || is_word(&p, "fn") || is_word(&p, "extern") || is_word(&p, "type")
}

fn sync_top_level(p: &mut Parser) {
    while !at_end(&p) {
        if top_level_keyword(&p) { return }
        if is_sym(&p, "{") { skip_balanced(&mut p, "{", "}"); continue }
        skip(&mut p)
    }
}

fn sync_stmt(p: &mut Parser) {
    while !at_end(&p) && !is_sep(&p) && !is_sym(&p, "}") {
        if is_sym(&p, "{") { skip_balanced(&mut p, "{", "}"); return }
        if is_sym(&p, "(") { skip_balanced(&mut p, "(", ")"); continue }
        if is_sym(&p, "[") { skip_balanced(&mut p, "[", "]"); continue }
        skip(&mut p)
    }
    if is_sep(&p) { skip_seps(&mut p) }
}

// --- Node constructor helpers (zero boilerplate) ---

fn make_expr(kind: ast.ExprKind, text: string, op: string, left: i32, right: i32, span: ast.Span) -> ast.ExprNode {
    ast.ExprNode {
        kind: kind, text: text.clone(), op: op.clone(), left: left, right: right, span: span,
        extra: -1, first_child: 0, child_count: 0, first_ty_arg: 0, ty_arg_count: 0, ty: -1, flags: 0,
    }
}

fn make_stmt(kind: ast.StmtKind, name: string, is_mut: bool, expr: i32, span: ast.Span) -> ast.StmtNode {
    ast.StmtNode {
        kind: kind, name: name.clone(), is_mut: is_mut, expr: expr, span: span,
        ty: -1, pat: -1, lhs: -1, op: "", body: -1, is_move: false, cap_expr: -1, clause_idx: -1, has_semi: false,
    }
}

fn make_type(kind: ast.TypeKind, name: string, inner: i32, count: i32, span: ast.Span) -> ast.TypeNode {
    ast.TypeNode {
        kind: kind, name: name.clone(), inner: inner, count: count, span: span,
        abi: "", is_extern: false, is_variadic: false, first_arg: 0, arg_count: 0, len_expr: -1,
        first_from: 0, from_count: 0,
    }
}

fn make_pat(kind: ast.PatKind, name: string, span: ast.Span) -> ast.PatNode {
    ast.PatNode {
        kind: kind, name: name.clone(), op: "", is_mut: false, is_move: false, neg: false,
        left: -1, right: -1, first_child: 0, child_count: 0, first_ty_arg: 0, ty_arg_count: 0, span: span,
    }
}

fn make_item(kind: ast.ItemKind, name: string, span: ast.Span, name_span: ast.Span) -> ast.Item {
    ast.Item {
        kind: kind, name: name.clone(), target_name: "", trait_name: "",
        is_pub: false, is_unsafe: false, is_opaque: false, is_test: false,
        span: span, name_span: name_span, body_span: ast.span(0, 0),
        first_param: 0, param_count: 0, first_member: 0, member_count: 0,
        first_attr: 0, attr_count: 0, ret_type: -1,
        abi: "", is_mut: false, is_extern: false, parent_item: -1,
        first_gen: 0, gen_count: 0, first_where: 0, where_count: 0,
        first_from: 0, from_count: 0, body_expr: -1, target_ty: -1, trait_ty: -1,
        first_child: 0, child_count: 0, first_name: 0, name_count: 0,
    }
}

fn make_member(name: string, span: ast.Span) -> ast.Member {
    ast.Member {
        name: name.clone(), is_pub: false, is_unsafe: false, ty: -1,
        span: span, body_span: ast.span(0, 0),
        first_gen: 0, gen_count: 0, first_where: 0, where_count: 0,
        first_param: 0, param_count: 0, first_from: 0, from_count: 0,
        first_attr: 0, attr_count: 0, body_expr: -1,
        first_payload: 0, payload_count: 0, discriminant_expr: -1,
    }
}

fn parse_simple_int(s: string) -> i32 {
    if s.len == 0 { return 0 }
    mut v: i32 = 0
    for i in 0..s.len {
        b := s[i]
        if b == 95 { continue } // '_'
        if b < 48 || b > 57 { return 0 }
        v = v * 10 + i32(b - 48)
    }
    v
}

// --- Return borrow sources (`from p`, `from self.field`, `from (a, b.c)`) ---

fn parse_one_from_source(p: &mut Parser) -> ast.FromSource {
    first := p.at
    mut root := ""
    mut field := ""
    if kind(&p) == .Name || is_word(&p, "self") || kind(&p) == .Integer {
        root = text(&p)
        skip(&mut p)
        while eat(&mut p, ".") {
            if kind(&p) == .Name || kind(&p) == .Integer {
                if field == "" { field = text(&p) } else { field = field + "." + text(&p) }
                skip(&mut p)
            } else {
                fail_here(&mut p, "expected field name after '.' in 'from' clause")
                break
            }
        }
    } else {
        fail_here(&mut p, "expected borrow source name in 'from' clause")
        if !at_end(&p) && !is_sym(&p, ")") && !is_sym(&p, ",") && !is_sym(&p, "{") { skip(&mut p) }
    }
    last := if p.at > first { p.at - 1 } else { first }
    ast.FromSource { root_name: root, field_name: field, span: ast.span(start_off(&p, first), end_off(&p, last)) }
}

fn parse_return_source(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    first_out = 0
    count_out = 0
    if !eat(&mut p, "from") { return }
    mut srcs: []ast.FromSource = []
    if eat(&mut p, "(") {
        skip_newlines(&mut p)
        while !at_end(&p) && !is_sym(&p, ")") {
            before := p.at
            srcs.push(parse_one_from_source(&mut p))
            skip_newlines(&mut p)
            if !eat(&mut p, ",") { break }
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, ")")
    } else if !at_end(&p) {
        srcs.push(parse_one_from_source(&mut p))
    }
    first_out = p.module.from_sources.len
    count_out = srcs.len
    for s in move srcs { p.module.from_sources.push(move s) }
}

// --- Attributes (`@repr(C, packed(2))`, `@link(macos = "...", weak = true)`, `@test { ... }`) ---

fn parse_attr_args(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    first_out = 0
    count_out = 0
    if !expect(&mut p, "(") { return }
    mut local_args: []ast.AttrArg = []
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, ")") {
        before := p.at
        astart := p.at
        if kind(&p) == .Name || kind(&p) == .Keyword {
            w := text(&p); skip(&mut p)
            skip_newlines(&mut p)
            if eat(&mut p, "=") {
                skip_newlines(&mut p)
                mut val := ""
                if eat(&mut p, "-") {
                    if kind(&p) == .Integer || kind(&p) == .Float { val = "-" + text(&p); skip(&mut p) }
                    else { fail_here(&mut p, "expected number after '-' in attribute argument") }
                } else if kind(&p) == .String || kind(&p) == .Integer || kind(&p) == .Float ||
                          kind(&p) == .Rune || kind(&p) == .Byte || kind(&p) == .Name || kind(&p) == .Keyword {
                    val = text(&p); skip(&mut p)
                } else {
                    fail_here(&mut p, "expected value in attribute argument")
                }
                alast := if p.at > astart { p.at - 1 } else { astart }
                local_args.push(ast.AttrArg {
                    kind: .Named, key: w, value: val, first_arg: 0, arg_count: 0,
                    span: ast.span(start_off(&p, astart), end_off(&p, alast)),
                })
            } else if is_sym(&p, "(") {
                mut sub_first := 0; mut sub_count := 0
                parse_attr_args(&mut p, &mut sub_first, &mut sub_count)
                alast := if p.at > astart { p.at - 1 } else { astart }
                local_args.push(ast.AttrArg {
                    kind: .Call, key: w, value: "", first_arg: sub_first, arg_count: sub_count,
                    span: ast.span(start_off(&p, astart), end_off(&p, alast)),
                })
            } else {
                alast := if p.at > astart { p.at - 1 } else { astart }
                local_args.push(ast.AttrArg {
                    kind: .Positional, key: "", value: w, first_arg: 0, arg_count: 0,
                    span: ast.span(start_off(&p, astart), end_off(&p, alast)),
                })
            }
        } else if eat(&mut p, "-") {
            mut val := "-"
            if kind(&p) == .Integer || kind(&p) == .Float { val = "-" + text(&p); skip(&mut p) }
            alast := if p.at > astart { p.at - 1 } else { astart }
            local_args.push(ast.AttrArg {
                kind: .Positional, key: "", value: val, first_arg: 0, arg_count: 0,
                span: ast.span(start_off(&p, astart), end_off(&p, alast)),
            })
        } else if kind(&p) == .String || kind(&p) == .Integer || kind(&p) == .Float || kind(&p) == .Rune || kind(&p) == .Byte {
            val := text(&p); skip(&mut p)
            alast := if p.at > astart { p.at - 1 } else { astart }
            local_args.push(ast.AttrArg {
                kind: .Positional, key: "", value: val, first_arg: 0, arg_count: 0,
                span: ast.span(start_off(&p, astart), end_off(&p, alast)),
            })
        } else {
            val := text(&p); skip(&mut p)
            alast := if p.at > astart { p.at - 1 } else { astart }
            local_args.push(ast.AttrArg {
                kind: .Positional, key: "", value: val, first_arg: 0, arg_count: 0,
                span: ast.span(start_off(&p, astart), end_off(&p, alast)),
            })
        }
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, ")")
    first_out = p.module.attr_args.len
    count_out = local_args.len
    for a in move local_args { p.module.attr_args.push(move a) }
}

fn parse_test_table_block(p: &mut Parser) -> i32 {
    prev := p.in_test_block
    p.in_test_block = true
    blk := parse_block(&mut p)
    p.in_test_block = prev
    blk
}

fn parse_attr_list(p: &mut Parser, allow_test_block: bool, first_out: &mut i32, count_out: &mut i32, is_test_out: &mut bool) {
    mut local_attrs: []ast.Attr = []
    while eat(&mut p, "@") {
        astart := p.at - 1
        mut aname := ""
        if kind(&p) == .Name || kind(&p) == .Keyword { aname = text(&p); skip(&mut p) }
        else { fail_here(&mut p, "expected attribute name"); break }
        if aname == "test" { is_test_out = true }
        mut fa := 0; mut ac := 0
        if is_sym(&p, "(") { parse_attr_args(&mut p, &mut fa, &mut ac) }
        skip_newlines(&mut p)
        mut bexpr := -1
        if allow_test_block && aname == "test" && is_sym(&p, "{") {
            bexpr = parse_test_table_block(&mut p)
            skip_newlines(&mut p)
        }
        alast := if p.at > astart { p.at - 1 } else { astart }
        local_attrs.push(ast.Attr {
            name: aname,
            span: ast.span(start_off(&p, astart), end_off(&p, alast)),
            first_arg: fa,
            arg_count: ac,
            body_expr: bexpr,
        })
    }
    first_out = p.module.attrs.len
    count_out = local_attrs.len
    for a in move local_attrs { p.module.attrs.push(move a) }
}

// --- Generics (`<T: Bound1 + Bound2, const N: usize>`) & `where` clauses ---

fn parse_generic_params(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    first_out = 0
    count_out = 0
    if !is_sym(&p, "<") { return }
    skip(&mut p)
    skip_newlines(&mut p)
    mut local_gps: []ast.GenericParam = []
    while !at_end(&p) && !is_sym(&p, ">") {
        before := p.at
        gstart := p.at
        if eat(&mut p, "const") {
            mut gname := ""
            if kind(&p) == .Name { gname = text(&p); skip(&mut p) }
            else { fail_here(&mut p, "expected const generic parameter name") }
            mut cty := -1
            if expect(&mut p, ":") { cty = parse_type(&mut p) }
            glast := if p.at > gstart { p.at - 1 } else { gstart }
            local_gps.push(ast.GenericParam {
                name: gname, is_const: true, const_ty: cty,
                first_bound: 0, bound_count: 0,
                span: ast.span(start_off(&p, gstart), end_off(&p, glast)),
            })
        } else if kind(&p) == .Name {
            gname := text(&p); skip(&mut p)
            mut bounds: []i32 = []
            if eat(&mut p, ":") {
                while !at_end(&p) {
                    skip_newlines(&mut p)
                    bounds.push(parse_type(&mut p))
                    skip_newlines(&mut p)
                    if !eat(&mut p, "+") { break }
                }
            }
            fb := ast.add_id_list(&mut p.module, &bounds)
            glast := if p.at > gstart { p.at - 1 } else { gstart }
            local_gps.push(ast.GenericParam {
                name: gname, is_const: false, const_ty: -1,
                first_bound: fb, bound_count: bounds.len,
                span: ast.span(start_off(&p, gstart), end_off(&p, glast)),
            })
        } else {
            fail_here(&mut p, "expected generic parameter")
            break
        }
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, ">")
    first_out = p.module.generic_params.len
    count_out = local_gps.len
    for gp in move local_gps { p.module.generic_params.push(move gp) }
}

fn parse_where_clause(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    first_out = 0
    count_out = 0
    mut k := p.at
    while k < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[k]) { k += 1 }
    if !is_word_at(&p, k, "where") { return }
    p.at = k + 1
    mut local_preds: []ast.WherePred = []
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, "{") && !is_sym(&p, ";") {
        before := p.at
        wstart := p.at
        tty := parse_type(&mut p)
        mut bounds: []i32 = []
        if expect(&mut p, ":") {
            while !at_end(&p) {
                skip_newlines(&mut p)
                bounds.push(parse_type(&mut p))
                if !eat(&mut p, "+") { break }
            }
        }
        fb := ast.add_id_list(&mut p.module, &bounds)
        wlast := if p.at > wstart { p.at - 1 } else { wstart }
        local_preds.push(ast.WherePred {
            target_ty: tty, first_bound: fb, bound_count: bounds.len,
            span: ast.span(start_off(&p, wstart), end_off(&p, wlast)),
        })
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    first_out = p.module.where_preds.len
    count_out = local_preds.len
    for i in 0..local_preds.len { p.module.where_preds.push(local_preds[i]) }
}

fn parse_type_args(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    first_out = 0
    count_out = 0
    if !is_sym(&p, "<") { return }
    skip(&mut p)
    skip_newlines(&mut p)
    mut ids: []i32 = []
    while !at_end(&p) && !is_sym(&p, ">") && !is_sym(&p, ">=") {
        before := p.at
        if kind(&p) == .Integer || kind(&p) == .Rune || kind(&p) == .Byte ||
           is_word(&p, "true") || is_word(&p, "false") || is_sym(&p, "-") {
            cfirst := p.at
            ce := parse_unary(&mut p, false)
            clast := if p.at > cfirst { p.at - 1 } else { cfirst }
            mut ctext := ""
            if ce >= 0 && ce < p.module.exprs.len { ctext = p.module.exprs[ce].text.clone() }
            mut cnode := make_type(.ConstArg, ctext, -1, 0, ast.span(start_off(&p, cfirst), end_off(&p, clast)))
            cnode.len_expr = ce
            ids.push(ast.add_type(&mut p.module, move cnode))
        } else {
            ids.push(parse_type(&mut p))
        }
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    if is_sym(&p, ">=") {
        skip(&mut p)
        p.pending_eq = true
    } else {
        _ := expect(&mut p, ">")
    }
    first_out = ast.add_id_list(&mut p.module, &ids)
    count_out = ids.len
}

fn qualified_name(p: &mut Parser) -> string {
    mut full := text(&p)
    skip(&mut p)
    while eat(&mut p, ".") {
        if kind(&p) == .Name {
            full = full + "." + text(&p)
            skip(&mut p)
        } else {
            fail_here(&mut p, "expected type name after '.'")
            break
        }
    }
    full
}

fn type_display_name(m: &ast.Module, ty_idx: i32) -> string {
    if ty_idx < 0 || ty_idx >= m.types.len { return "" }
    t := &m.types[ty_idx]
    if t.kind == .Named { return t.name.clone() }
    if t.kind == .Slice { return "[]" + type_display_name(&m, t.inner) }
    if t.kind == .FixedArray { return "[" + type_display_name(&m, t.inner) + "; " + t.count.str() + "]" }
    if t.kind == .Ref { return "&" + type_display_name(&m, t.inner) }
    if t.kind == .MutRef { return "&mut " + type_display_name(&m, t.inner) }
    if t.kind == .RawConst { return "*const " + type_display_name(&m, t.inner) }
    if t.kind == .RawMut { return "*mut " + type_display_name(&m, t.inner) }
    if t.kind == .Unit { return "()" }
    if t.kind == .Tuple {
        mut s := "("
        for i in 0..t.arg_count {
            if i > 0 { s += ", " }
            s += type_display_name(&m, m.id_lists[t.first_arg + i])
        }
        return s + ")"
    }
    if t.kind == .FnType { return t.name.clone() }
    ""
}

// --- Types ---

fn parse_type(p: &mut Parser) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_type(&mut p.module, make_type(.Error, "", -1, 0, ast.span(start_off(&p, p.at), start_off(&p, p.at))))
    }
    first := p.at
    mut out := -1
    if eat(&mut p, "&") {
        is_mut := eat(&mut p, "mut")
        inner := parse_type(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        k := if is_mut { ast.TypeKind.MutRef } else { ast.TypeKind.Ref }
        out = ast.add_type(&mut p.module, make_type(k, "", inner, 0, ast.span(start_off(&p, first), end_off(&p, last))))
    } else if eat(&mut p, "*") {
        is_mut := eat(&mut p, "mut")
        if !is_mut { _ := eat(&mut p, "const") }
        inner := parse_type(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        k := if is_mut { ast.TypeKind.RawMut } else { ast.TypeKind.RawConst }
        out = ast.add_type(&mut p.module, make_type(k, if is_mut { "*mut" } else { "*const" }, inner, 0, ast.span(start_off(&p, first), end_off(&p, last))))
    } else if eat(&mut p, "[") {
        if eat(&mut p, "]") {
            inner := parse_type(&mut p)
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_type(&mut p.module, make_type(.Slice, "", inner, 0, ast.span(start_off(&p, first), end_off(&p, last))))
        } else {
            inner := parse_type(&mut p)
            _ := expect(&mut p, ";")
            len_e := parse_expr(&mut p, false)
            _ := expect(&mut p, "]")
            last := if p.at > first { p.at - 1 } else { first }
            mut lit_len := 0
            if len_e >= 0 && len_e < p.module.exprs.len && p.module.exprs[len_e].kind == .Int {
                lit_len = parse_simple_int(p.module.exprs[len_e].text)
            }
            mut node := make_type(.FixedArray, "", inner, lit_len, ast.span(start_off(&p, first), end_off(&p, last)))
            node.len_expr = len_e
            out = ast.add_type(&mut p.module, move node)
        }
    } else if is_sym(&p, "(") {
        skip(&mut p)
        skip_newlines(&mut p)
        if eat(&mut p, ")") {
            out = ast.add_type(&mut p.module, make_type(.Unit, "()", -1, 0, ast.span(start_off(&p, first), end_off(&p, p.at - 1))))
        } else {
            mut elems: []i32 = []
            mut last_inner := -1
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                last_inner = parse_type(&mut p)
                elems.push(last_inner)
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
            fa := ast.add_id_list(&mut p.module, &elems)
            mut node := make_type(.Tuple, "", last_inner, elems.len, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
            node.first_arg = fa
            node.arg_count = elems.len
            out = ast.add_type(&mut p.module, move node)
        }
    } else if is_word(&p, "extern") || is_word(&p, "fn") || ((is_word(&p, "Fn") || is_word(&p, "FnMut") || is_word(&p, "FnOnce")) && is_word_at(&p, p.at + 1, "(")) {
        was_extern := eat(&mut p, "extern")
        mut abi := ""
        if was_extern && kind(&p) == .String { abi = text(&p); skip(&mut p) }
        mut fn_name := "fn"
        if is_word(&p, "fn") || is_word(&p, "Fn") || is_word(&p, "FnMut") || is_word(&p, "FnOnce") {
            fn_name = text(&p)
            skip(&mut p)
        } else {
            _ := expect(&mut p, "fn")
        }
        if is_sym(&p, "[") { skip_balanced(&mut p, "[", "]") }
        mut local_params: []ast.FnParamType = []
        mut is_var := false
        if expect(&mut p, "(") {
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                pstart := p.at
                if is_sym(&p, "...") {
                    skip(&mut p)
                    is_var = true
                    local_params.push(ast.FnParamType {
                        ty: -1, is_mut: false, is_move: false, is_variadic: true,
                        span: ast.span(start_off(&p, pstart), end_off(&p, pstart)),
                    })
                } else {
                    mut pm := eat(&mut p, "mut")
                    pmove := eat(&mut p, "move")
                    if !pm && eat(&mut p, "mut") { pm = true }
                    pty := parse_type(&mut p)
                    plast := if p.at > pstart { p.at - 1 } else { pstart }
                    local_params.push(ast.FnParamType {
                        ty: pty, is_mut: pm, is_move: pmove, is_variadic: false,
                        span: ast.span(start_off(&p, pstart), end_off(&p, plast)),
                    })
                }
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
        }
        mut ret := -1
        mut ff := 0; mut fc := 0
        if eat(&mut p, "->") {
            ret = parse_type(&mut p)
            parse_return_source(&mut p, &mut ff, &mut fc)
        }
        fa := p.module.fn_param_types.len
        fpc := local_params.len
        for i in 0..local_params.len { p.module.fn_param_types.push(local_params[i]) }
        mut node := make_type(.FnType, fn_name, ret, fpc, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
        node.abi = abi
        node.is_extern = was_extern
        node.is_variadic = is_var
        node.first_arg = fa
        node.arg_count = fpc
        node.first_from = ff
        node.from_count = fc
        out = ast.add_type(&mut p.module, move node)
    } else if kind(&p) == .Name || is_word(&p, "Self") {
        full := qualified_name(&mut p)
        mut fa := 0; mut ac := 0
        if is_sym(&p, "<") { parse_type_args(&mut p, &mut fa, &mut ac) }
        mut node := make_type(.Named, full, -1, 0, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
        node.first_arg = fa
        node.arg_count = ac
        out = ast.add_type(&mut p.module, move node)
    } else {
        fail_here(&mut p, "expected type name")
        out = ast.add_type(&mut p.module, make_type(.Error, "", -1, 0, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    leave_depth(&mut p)
    out
}

fn parse_type_full(p: &mut Parser) -> i32 {
    parse_type(&mut p)
}

// --- Lookahead helpers ---

fn looks_like_struct_literal(p: &Parser) -> bool {
    if !is_sym(&p, "{") { return false }
    mut k := p.at + 1
    while k < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[k]) { k += 1 }
    if k >= p.tokens.kinds.len { return false }
    if p.tokens.texts[k] == "}" && p.tokens.kinds[k] == .Symbol { return true }
    if is_word_at(&p, k, "..") { return true }
    if p.tokens.kinds[k] == .Name {
        mut n := k + 1
        while n < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[n]) { n += 1 }
        if is_word_at(&p, n, ":") || is_word_at(&p, n, ",") || is_word_at(&p, n, "}") { return true }
    }
    false
}

fn looks_like_struct_literal_with_continuation(p: &Parser) -> bool {
    if !looks_like_struct_literal(&p) { return false }
    if p.at >= p.closes.len || p.closes[p.at] <= p.at { return false }
    after := p.closes[p.at] + 1
    is_word_at(&p, after, ".") || is_word_at(&p, after, "(") || is_word_at(&p, after, "[") ||
    is_word_at(&p, after, "==") || is_word_at(&p, after, "!=") || is_word_at(&p, after, "&&") ||
    is_word_at(&p, after, "||") || is_word_at(&p, after, "?") || is_word_at(&p, after, "..") ||
    is_word_at(&p, after, "..=")
}

fn skip_angle_lookahead(p: &Parser, start: i32) -> i32 {
    if !is_word_at(&p, start, "<") { return start }
    mut i := start + 1
    mut depth := 1
    mut bdepth := 0
    while i < p.tokens.kinds.len && depth > 0 {
        if p.tokens.kinds[i] == .End || p.tokens.kinds[i] == .Newline || (bdepth == 0 && is_word_at(&p, i, ";")) { return -1 }
        if is_word_at(&p, i, "[") { bdepth += 1 }
        else if is_word_at(&p, i, "]") && bdepth > 0 { bdepth -= 1 }
        else if is_word_at(&p, i, "<") { depth += 1 }
        else if is_word_at(&p, i, ">") { depth -= 1 }
        else if is_word_at(&p, i, "{") || is_word_at(&p, i, "=") || is_word_at(&p, i, "||") ||
                is_word_at(&p, i, "&&") || is_word_at(&p, i, "==") || is_word_at(&p, i, "!=") ||
                is_word_at(&p, i, "<=") || is_word_at(&p, i, ">=") || is_word_at(&p, i, "+") ||
                is_word_at(&p, i, "/") || is_word_at(&p, i, "%") || is_word_at(&p, i, "!") ||
                is_word_at(&p, i, "..") || is_word_at(&p, i, "..=") { return -1 }
        i += 1
    }
    if depth != 0 { return -1 }
    i
}

fn looks_like_struct_pattern(p: &Parser) -> bool {
    mut i := p.at
    if i >= p.tokens.kinds.len || p.tokens.kinds[i] != .Name { return false }
    i += 1
    while is_word_at(&p, i, ".") && i + 1 < p.tokens.kinds.len && p.tokens.kinds[i + 1] == .Name {
        i += 2
    }
    if is_word_at(&p, i, "<") {
        after_gen := skip_angle_lookahead(&p, i)
        if after_gen < 0 { return false }
        i = after_gen
    }
    if !is_word_at(&p, i, "{") { return false }
    if i < p.closes.len && p.closes[i] > i {
        after := p.closes[i] + 1
        return is_word_at(&p, after, ":=")
    }
    false
}

fn looks_like_generic_call(p: &Parser) -> bool {
    after := skip_angle_lookahead(&p, p.at)
    if after <= p.at { return false }
    is_word_at(&p, after, "(") || is_word_at(&p, after, "::") || is_word_at(&p, after, "{") ||
    is_word_at(&p, after, ".") || is_word_at(&p, after, ",") || is_word_at(&p, after, ")") || is_word_at(&p, after, "]")
}

// --- Patterns ---

fn parse_struct_field_pats(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    _ := expect(&mut p, "{")
    mut local_fps: []ast.FieldPat = []
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, "}") {
        before := p.at
        fstart := p.at
        if eat(&mut p, "..") {
            local_fps.push(ast.FieldPat {
                name: "..", pat: -1, is_mut: false, is_rest: true,
                span: ast.span(start_off(&p, fstart), end_off(&p, fstart)),
            })
        } else {
            f_mut := eat(&mut p, "mut")
            if kind(&p) == .Name {
                fname := text(&p); skip(&mut p)
                mut fpat := -1
                if eat(&mut p, ":") { fpat = parse_pat(&mut p, false) }
                flast := if p.at > fstart { p.at - 1 } else { fstart }
                local_fps.push(ast.FieldPat {
                    name: fname, pat: fpat, is_mut: f_mut, is_rest: false,
                    span: ast.span(start_off(&p, fstart), end_off(&p, flast)),
                })
            } else {
                fail_here(&mut p, "expected field pattern name")
                break
            }
        }
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { skip_newlines(&mut p); break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, "}")
    first_out = p.module.field_pats.len
    count_out = local_fps.len
    for fp in move local_fps { p.module.field_pats.push(move fp) }
}

fn parse_pat_atom(p: &mut Parser) -> i32 {
    first := p.at
    if eat(&mut p, "..") {
        return ast.add_pat(&mut p.module, make_pat(.Rest, "..", ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if eat(&mut p, "-") {
        if kind(&p) == .Integer || kind(&p) == .Float {
            lk := if kind(&p) == .Integer { "int" } else { "float" }
            val := text(&p); skip(&mut p)
            mut node := make_pat(.Literal, val, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
            node.op = lk
            node.neg = true
            return ast.add_pat(&mut p.module, move node)
        }
        fail_here(&mut p, "expected number after '-' in pattern")
        return ast.add_pat(&mut p.module, make_pat(.Error, "", ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if eat(&mut p, ".") {
        mut vname := ""
        if kind(&p) == .Name { vname = text(&p); skip(&mut p) }
        else { fail_here(&mut p, "expected variant name after '.' in pattern") }
        mut children: []i32 = []
        if eat(&mut p, "(") {
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                children.push(parse_pat(&mut p, true))
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
        }
        fc := ast.add_id_list(&mut p.module, &children)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_pat(.Variant, "." + vname, ast.span(start_off(&p, first), end_off(&p, last)))
        node.first_child = fc
        node.child_count = children.len
        return ast.add_pat(&mut p.module, move node)
    }
    if eat(&mut p, "(") {
        mut elems: []i32 = []
        skip_newlines(&mut p)
        while !at_end(&p) && !is_sym(&p, ")") {
            before := p.at
            elems.push(parse_pat(&mut p, true))
            skip_newlines(&mut p)
            if !eat(&mut p, ",") { break }
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, ")")
        fc := ast.add_id_list(&mut p.module, &elems)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_pat(.Tuple, "", ast.span(start_off(&p, first), end_off(&p, last)))
        node.first_child = fc
        node.child_count = elems.len
        return ast.add_pat(&mut p.module, move node)
    }
    k := kind(&p)
    if k == .Integer || k == .Float || k == .String || k == .CString || k == .WString || k == .Rune || k == .Byte || is_word(&p, "true") || is_word(&p, "false") {
        val := text(&p); skip(&mut p)
        mut tag := "bool"
        if k == .Integer { tag = "int" }
        else if k == .Float { tag = "float" }
        else if k == .String { tag = "string" }
        else if k == .CString { tag = "cstring" }
        else if k == .WString { tag = "wstring" }
        else if k == .Rune { tag = "rune" }
        else if k == .Byte { tag = "byte" }
        mut node := make_pat(.Literal, val, ast.span(start_off(&p, first), end_off(&p, first)))
        node.op = tag
        return ast.add_pat(&mut p.module, move node)
    }
    if is_word(&p, "mut") || is_word(&p, "move") {
        mut is_mut := eat(&mut p, "mut")
        is_move := eat(&mut p, "move")
        if !is_mut && eat(&mut p, "mut") { is_mut = true }
        if kind(&p) == .Name {
            bname := text(&p); skip(&mut p)
            mut node := make_pat(.Binding, bname, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
            node.is_mut = is_mut
            node.is_move = is_move
            return ast.add_pat(&mut p.module, move node)
        }
        fail_here(&mut p, "expected binding name in pattern")
        return ast.add_pat(&mut p.module, make_pat(.Error, "", ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .Name {
        mut full := text(&p); skip(&mut p)
        if full == "_" && !is_sym(&p, ".") && !is_sym(&p, "{") {
            return ast.add_pat(&mut p.module, make_pat(.Wildcard, "_", ast.span(start_off(&p, first), end_off(&p, first))))
        }
        mut fta := 0; mut tac := 0
        if is_sym(&p, "<") && looks_like_generic_call(&p) {
            parse_type_args(&mut p, &mut fta, &mut tac)
        }
        mut had_dot := false
        while eat(&mut p, ".") || eat(&mut p, "::") {
            had_dot = true
            if kind(&p) == .Name {
                full = full + "." + text(&p); skip(&mut p)
                if is_sym(&p, "<") && looks_like_generic_call(&p) {
                    parse_type_args(&mut p, &mut fta, &mut tac)
                }
            } else {
                fail_here(&mut p, "expected variant or type name after '.'")
                break
            }
        }
        if is_sym(&p, "(") {
            skip(&mut p)
            mut children: []i32 = []
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                children.push(parse_pat(&mut p, true))
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
            fc := ast.add_id_list(&mut p.module, &children)
            last := if p.at > first { p.at - 1 } else { first }
            mut node := make_pat(.Variant, full, ast.span(start_off(&p, first), end_off(&p, last)))
            node.first_child = fc
            node.child_count = children.len
            node.first_ty_arg = fta
            node.ty_arg_count = tac
            return ast.add_pat(&mut p.module, move node)
        }
        if is_sym(&p, "{") && looks_like_struct_pattern_body(&p) {
            mut ffp := 0; mut fpc := 0
            parse_struct_field_pats(&mut p, &mut ffp, &mut fpc)
            last := if p.at > first { p.at - 1 } else { first }
            mut node := make_pat(.Struct, full, ast.span(start_off(&p, first), end_off(&p, last)))
            node.first_child = ffp
            node.child_count = fpc
            node.first_ty_arg = fta
            node.ty_arg_count = tac
            return ast.add_pat(&mut p.module, move node)
        }
        last := if p.at > first { p.at - 1 } else { first }
        pk := if had_dot || tac > 0 { ast.PatKind.Path } else { ast.PatKind.Binding }
        mut node := make_pat(pk, full, ast.span(start_off(&p, first), end_off(&p, last)))
        node.first_ty_arg = fta
        node.ty_arg_count = tac
        return ast.add_pat(&mut p.module, move node)
    }
    fail_here(&mut p, "expected match pattern")
    ast.add_pat(&mut p.module, make_pat(.Error, "", ast.span(start_off(&p, first), end_off(&p, first))))
}

fn looks_like_struct_pattern_body(p: &Parser) -> bool {
    if !is_sym(&p, "{") { return false }
    // Inside match patterns or let patterns, `{` after a type name is a struct pattern
    // unless we're in `for x in ... {` (where `parse_pat` is called before `in`, never at `{`)
    // or at `match x {` (never calls `parse_pat` on `x`).
    // Still guard against `Name {` in `if` guard or error recovery by checking first token inside `{`.
    mut k := p.at + 1
    while k < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[k]) { k += 1 }
    if k >= p.tokens.kinds.len { return false }
    is_word_at(&p, k, "}") || is_word_at(&p, k, "..") || is_word_at(&p, k, "mut") || p.tokens.kinds[k] == .Name
}

fn parse_pat_range(p: &mut Parser) -> i32 {
    first := p.at
    lhs := parse_pat_atom(&mut p)
    if is_sym(&p, "..") || is_sym(&p, "..=") {
        mut op := text(&p); skip(&mut p)
        if op == ".." && eat(&mut p, "=") { op = "..=" }
        rhs := parse_pat_atom(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_pat(.Range, "", ast.span(start_off(&p, first), end_off(&p, last)))
        node.op = op
        node.left = lhs
        node.right = rhs
        return ast.add_pat(&mut p.module, move node)
    }
    lhs
}

fn parse_pat(p: &mut Parser, allow_or: bool) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_pat(&mut p.module, make_pat(.Error, "", ast.span(start_off(&p, p.at), start_off(&p, p.at))))
    }
    first := p.at
    head := parse_pat_range(&mut p)
    mut out := head
    if allow_or && is_sym(&p, "|") {
        mut alts: []i32 = [head]
        while eat(&mut p, "|") {
            skip_newlines(&mut p)
            alts.push(parse_pat_range(&mut p))
        }
        fc := ast.add_id_list(&mut p.module, &alts)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_pat(.Or, "|", ast.span(start_off(&p, first), end_off(&p, last)))
        node.first_child = fc
        node.child_count = alts.len
        out = ast.add_pat(&mut p.module, move node)
    }
    leave_depth(&mut p)
    out
}

// --- Blocks, control flow & closures ---

fn parse_block_kind(p: &mut Parser, is_unsafe: bool) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_expr(&mut p.module, make_expr(.Error, "", "", -1, -1, ast.span(start_off(&p, p.at), start_off(&p, p.at))))
    }
    first := p.at
    if !expect(&mut p, "{") {
        leave_depth(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.Error, "", "", -1, -1, ast.span(start_off(&p, first), start_off(&p, first))))
    }
    mut stmts: []i32 = []
    skip_seps(&mut p)
    while !at_end(&p) && !is_sym(&p, "}") {
        before := p.at
        sid := parse_stmt(&mut p)
        if sid >= 0 { stmts.push(sid) }
        skip_seps(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, "}")
    last := if p.at > first { p.at - 1 } else { first }
    mut tail_expr := -1
    if stmts.len > 0 {
        last_sid := stmts[stmts.len - 1]
        if last_sid >= 0 && last_sid < p.module.stmts.len {
            ls := &p.module.stmts[last_sid]
            if ls.kind == .Expr && !ls.has_semi {
                tail_expr = ls.expr
                _ := stmts.pop()
            }
        }
    }
    fc := ast.add_id_list(&mut p.module, &stmts)
    k := if is_unsafe { ast.ExprKind.UnsafeBlock } else { ast.ExprKind.BlockExpr }
    mut node := make_expr(k, if is_unsafe { "unsafe" } else { "" }, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, last)))
    node.extra = tail_expr
    node.first_child = fc
    node.child_count = stmts.len
    if is_unsafe { node.flags = 1 }
    leave_depth(&mut p)
    ast.add_expr(&mut p.module, move node)
}

fn parse_block(p: &mut Parser) -> i32 {
    parse_block_kind(&mut p, false)
}

fn parse_if_expr(p: &mut Parser) -> i32 {
    first := p.at
    _ := expect(&mut p, "if")
    cond := parse_expr(&mut p, false)
    skip_newlines(&mut p)
    then_blk := parse_block(&mut p)
    mut else_expr := -1
    mut else_at := p.at
    while else_at < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[else_at]) {
        else_at += 1
    }
    if is_word_at(&p, else_at, "else") {
        p.at = else_at + 1
        skip_newlines(&mut p)
        if is_word(&p, "if") {
            else_expr = parse_if_expr(&mut p)
        } else {
            else_expr = parse_block(&mut p)
        }
    }
    last := if p.at > first { p.at - 1 } else { first }
    mut node := make_expr(.IfExpr, "if", "", cond, then_blk, ast.span(start_off(&p, first), end_off(&p, last)))
    node.extra = else_expr
    ast.add_expr(&mut p.module, move node)
}

fn parse_match_expr(p: &mut Parser) -> i32 {
    first := p.at
    _ := expect(&mut p, "match")
    subject := parse_expr(&mut p, false)
    mut is_move_subj := false
    if subject >= 0 && subject < p.module.exprs.len && p.module.exprs[subject].kind == .Move {
        is_move_subj = true
    }
    mut local_arms: []ast.MatchArm = []
    skip_newlines(&mut p)
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            arm_start := p.at
            pat := parse_pat(&mut p, true)
            skip_newlines(&mut p)
            mut guard := -1
            if eat(&mut p, "if") { guard = parse_expr(&mut p, false) }
            skip_newlines(&mut p)
            _ := expect(&mut p, "=>")
            skip_newlines(&mut p)
            mut body := -1
            body_start := p.at
            if is_sym(&p, "{") {
                body = parse_block(&mut p)
            } else if eat(&mut p, "return") {
                mut rval := -1
                if !is_sep(&p) && !is_sym(&p, "}") && !is_sym(&p, ",") { rval = parse_expr(&mut p, true) }
                rlast := if p.at > body_start { p.at - 1 } else { body_start }
                body = ast.add_expr(&mut p.module, make_expr(.ReturnExpr, "return", "", rval, -1, ast.span(start_off(&p, body_start), end_off(&p, rlast))))
            } else if eat(&mut p, "break") {
                mut bval := -1
                if !is_sep(&p) && !is_sym(&p, "}") && !is_sym(&p, ",") { bval = parse_expr(&mut p, true) }
                blast := if p.at > body_start { p.at - 1 } else { body_start }
                body = ast.add_expr(&mut p.module, make_expr(.BreakExpr, "break", "", bval, -1, ast.span(start_off(&p, body_start), end_off(&p, blast))))
            } else if eat(&mut p, "continue") {
                body = ast.add_expr(&mut p.module, make_expr(.ContinueExpr, "continue", "", -1, -1, ast.span(start_off(&p, body_start), end_off(&p, body_start))))
            } else if !at_end(&p) && !is_sym(&p, "}") {
                body = parse_expr(&mut p, true)
            }
            arm_last := if p.at > arm_start { p.at - 1 } else { arm_start }
            local_arms.push(ast.MatchArm {
                pat: pat, guard: guard, body: body,
                span: ast.span(start_off(&p, arm_start), end_off(&p, arm_last)),
            })
            _ := eat(&mut p, ",")
            skip_seps(&mut p)
            if p.at == before { sync_stmt(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    fa := p.module.match_arms.len
    ac := local_arms.len
    for i in 0..local_arms.len { p.module.match_arms.push(local_arms[i]) }
    last := if p.at > first { p.at - 1 } else { first }
    mut node := make_expr(.MatchExpr, "match", "", subject, -1, ast.span(start_off(&p, first), end_off(&p, last)))
    node.first_child = fa
    node.child_count = ac
    if is_move_subj { node.flags = 1 }
    ast.add_expr(&mut p.module, move node)
}

fn parse_closure_expr(p: &mut Parser) -> i32 {
    first := p.at
    is_move := eat(&mut p, "move")
    _ := expect(&mut p, "fn")
    mut local_caps: []ast.CaptureItem = []
    if eat(&mut p, "[") {
        skip_newlines(&mut p)
        while !at_end(&p) && !is_sym(&p, "]") {
            before := p.at
            cstart := p.at
            c_ref := eat(&mut p, "&")
            mut c_mut := eat(&mut p, "mut")
            c_move := eat(&mut p, "move")
            if !c_mut && eat(&mut p, "mut") { c_mut = true }
            mut cname := ""
            if kind(&p) == .Name { cname = text(&p); skip(&mut p) }
            else { fail_here(&mut p, "expected capture name"); break }
            mut cty := -1
            mut cinit := -1
            if eat(&mut p, ":") { cty = parse_type_full(&mut p) }
            if eat(&mut p, "=") { cinit = parse_expr(&mut p, true) }
            clast := if p.at > cstart { p.at - 1 } else { cstart }
            local_caps.push(ast.CaptureItem {
                name: cname, is_ref: c_ref, is_mut: c_mut, is_move: c_move,
                ty: cty, init_expr: cinit,
                span: ast.span(start_off(&p, cstart), end_off(&p, clast)),
            })
            skip_newlines(&mut p)
            if !eat(&mut p, ",") { break }
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "]")
    }
    mut local_params: []ast.Param = []
    if expect(&mut p, "(") {
        skip_newlines(&mut p)
        while !at_end(&p) && !is_sym(&p, ")") {
            before := p.at
            pstart := p.at
            mut p_mut := eat(&mut p, "mut")
            p_move := eat(&mut p, "move")
            if !p_mut && eat(&mut p, "mut") { p_mut = true }
            mut pname := ""
            if kind(&p) == .Name { pname = text(&p); skip(&mut p) }
            else { fail_here(&mut p, "expected closure parameter name"); break }
            mut pty := -1
            if eat(&mut p, ":") { pty = parse_type_full(&mut p) }
            plast := if p.at > pstart { p.at - 1 } else { pstart }
            local_params.push(ast.Param {
                name: pname, is_mut: p_mut, is_move: p_move, ty: pty,
                span: ast.span(start_off(&p, pstart), end_off(&p, plast)),
                receiver: .None, is_variadic: false,
            })
            skip_newlines(&mut p)
            if !eat(&mut p, ",") { break }
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, ")")
    }
    mut ret_ty := -1
    mut ff := 0; mut fc := 0
    if eat(&mut p, "->") {
        ret_ty = parse_type_full(&mut p)
        parse_return_source(&mut p, &mut ff, &mut fc)
    }
    skip_newlines(&mut p)
    body := parse_block(&mut p)
    first_cap := p.module.captures.len
    cap_count := local_caps.len
    for c in move local_caps { p.module.captures.push(move c) }
    first_param := p.module.params.len
    param_count := local_params.len
    for prm in move local_params { p.module.params.push(move prm) }
    last := if p.at > first { p.at - 1 } else { first }
    sp := ast.span(start_off(&p, first), end_off(&p, last))
    cidx := ast.add_closure(&mut p.module, ast.ClosureData {
        is_move: is_move, first_cap: first_cap, cap_count: cap_count,
        first_param: first_param, param_count: param_count,
        ret_ty: ret_ty, first_from: ff, from_count: fc, body: body, span: sp,
    })
    mut node := make_expr(.Closure, "fn", "", -1, -1, sp)
    node.extra = cidx
    if is_move { node.flags = 1 }
    ast.add_expr(&mut p.module, move node)
}

fn parse_struct_lit_fields(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    _ := expect(&mut p, "{")
    mut local_fields: []ast.FieldInit = []
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, "}") {
        before := p.at
        fstart := p.at
        if eat(&mut p, "..") {
            rest_e := parse_expr(&mut p, true)
            flast := if p.at > fstart { p.at - 1 } else { fstart }
            local_fields.push(ast.FieldInit {
                name: "..", expr: rest_e, is_shorthand: false, is_rest: true,
                span: ast.span(start_off(&p, fstart), end_off(&p, flast)),
            })
        } else if kind(&p) == .Name {
            fname := text(&p); skip(&mut p)
            mut fval := -1
            mut is_short := true
            if eat(&mut p, ":") {
                is_short = false
                fval = parse_expr(&mut p, true)
            } else {
                fval = ast.add_expr(&mut p.module, make_expr(.Ident, fname.clone(), "", -1, -1, ast.span(start_off(&p, fstart), end_off(&p, fstart))))
            }
            flast := if p.at > fstart { p.at - 1 } else { fstart }
            local_fields.push(ast.FieldInit {
                name: fname, expr: fval, is_shorthand: is_short, is_rest: false,
                span: ast.span(start_off(&p, fstart), end_off(&p, flast)),
            })
        } else {
            fail_here(&mut p, "expected struct field name")
            break
        }
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { skip_newlines(&mut p); break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, "}")
    first_out = p.module.field_inits.len
    count_out = local_fields.len
    for fi in move local_fields { p.module.field_inits.push(move fi) }
}

fn parse_arg_list(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    _ := expect(&mut p, "(")
    mut local_args: []ast.CallArg = []
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, ")") {
        before := p.at
        astart := p.at
        mut is_move := false
        if !(is_word(&p, "move") && is_word_at(&p, p.at + 1, "fn")) {
            is_move = eat(&mut p, "move")
        }
        arg_e := parse_expr(&mut p, true)
        alast := if p.at > astart { p.at - 1 } else { astart }
        local_args.push(ast.CallArg {
            expr: arg_e, is_move: is_move,
            span: ast.span(start_off(&p, astart), end_off(&p, alast)),
        })
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, ")")
    first_out = p.module.call_args.len
    count_out = local_args.len
    for i in 0..local_args.len { p.module.call_args.push(local_args[i]) }
}

// --- Expressions ---

fn parse_primary(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    first := p.at
    k := kind(&p)
    if k == .Integer {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.Int, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .Float {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.Float, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .String {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.String, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .CString {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.CString, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .WString {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.WString, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .Rune {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.Rune, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .Byte {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.Byte, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if is_word(&p, "true") || is_word(&p, "false") {
        w := text(&p); skip(&mut p)
        return ast.add_expr(&mut p.module, make_expr(.Bool, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if is_word(&p, "if") { return parse_if_expr(&mut p) }
    if is_word(&p, "match") { return parse_match_expr(&mut p) }
    if is_word(&p, "fn") || (is_word(&p, "move") && is_word_at(&p, p.at + 1, "fn")) { return parse_closure_expr(&mut p) }
    if is_word(&p, "unsafe") && is_word_at(&p, p.at + 1, "{") {
        skip(&mut p)
        return parse_block_kind(&mut p, true)
    }
    if is_sym(&p, "@") {
        skip(&mut p)
        mut attr := ""
        if !at_end(&p) && kind(&p) == .Name {
            attr = text(&p)
            skip(&mut p)
        }
        mut fa := 0; mut ac := 0
        if is_sym(&p, "(") { parse_arg_list(&mut p, &mut fa, &mut ac) }
        mut node := make_expr(.Call, "@" + attr, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
        node.first_child = fa
        node.child_count = ac
        return ast.add_expr(&mut p.module, move node)
    }
    if is_sym(&p, "(") {
        skip(&mut p)
        skip_newlines(&mut p)
        if eat(&mut p, ")") {
            return ast.add_expr(&mut p.module, make_expr(.TupleLit, "()", "", -1, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1))))
        }
        inner := parse_expr(&mut p, true)
        skip_newlines(&mut p)
        if eat(&mut p, ",") {
            mut elems: []i32 = [inner]
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                elems.push(parse_expr(&mut p, true))
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
            fc := ast.add_id_list(&mut p.module, &elems)
            mut node := make_expr(.TupleLit, "", "", inner, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
            node.first_child = fc
            node.child_count = elems.len
            return ast.add_expr(&mut p.module, move node)
        }
        _ := expect(&mut p, ")")
        return ast.add_expr(&mut p.module, make_expr(.Group, "", "", inner, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1))))
    }
    if is_sym(&p, "[") {
        skip(&mut p)
        skip_newlines(&mut p)
        if eat(&mut p, "]") {
            return ast.add_expr(&mut p.module, make_expr(.ArrayLit, "[]", "", -1, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1))))
        }
        first_elem := parse_expr(&mut p, true)
        skip_newlines(&mut p)
        if eat(&mut p, ";") {
            skip_newlines(&mut p)
            count_e := parse_expr(&mut p, true)
            skip_newlines(&mut p)
            _ := expect(&mut p, "]")
            return ast.add_expr(&mut p.module, make_expr(.ArrayRepeat, "[]", ";", first_elem, count_e, ast.span(start_off(&p, first), end_off(&p, p.at - 1))))
        }
        mut elems: []i32 = [first_elem]
        while eat(&mut p, ",") {
            skip_newlines(&mut p)
            if is_sym(&p, "]") { break }
            before := p.at
            elems.push(parse_expr(&mut p, true))
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
        skip_newlines(&mut p)
        _ := expect(&mut p, "]")
        fc := ast.add_id_list(&mut p.module, &elems)
        mut node := make_expr(.ArrayLit, "[]", "", -1, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
        node.first_child = fc
        node.child_count = elems.len
        return ast.add_expr(&mut p.module, move node)
    }
    if is_sym(&p, "{") {
        return parse_block(&mut p)
    }
    if is_sym(&p, ".") {
        // Variant shorthand `.Ok(...)` or `.None`
        skip(&mut p)
        if kind(&p) == .Name {
            vname := text(&p); skip(&mut p)
            mut fa := 0; mut ac := 0
            mut has_parens := 0
            if is_sym(&p, "(") {
                has_parens = 1
                parse_arg_list(&mut p, &mut fa, &mut ac)
            }
            mut node := make_expr(.VariantShorthand, vname, ".", -1, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
            node.first_child = fa
            node.child_count = ac
            node.flags = has_parens
            return ast.add_expr(&mut p.module, move node)
        }
        fail_here(&mut p, "expected variant name after '.'")
        return ast.add_expr(&mut p.module, make_expr(.Error, "", "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    }
    if k == .Name || is_word(&p, "Self") || is_word(&p, "self") || is_word(&p, "len") {
        w := text(&p); skip(&mut p)
        mut fta := 0; mut tac := 0
        if is_sym(&p, "<") && looks_like_generic_call(&p) {
            parse_type_args(&mut p, &mut fta, &mut tac)
        }
        mut id_node := make_expr(.Ident, w, "", -1, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
        id_node.first_ty_arg = fta
        id_node.ty_arg_count = tac
        mut node := ast.add_expr(&mut p.module, move id_node)
        if (allow_struct_lit && looks_like_struct_literal(&p)) || looks_like_struct_literal_with_continuation(&p) {
            mut ff := 0; mut fc := 0
            parse_struct_lit_fields(&mut p, &mut ff, &mut fc)
            mut snode := make_expr(.StructLit, "", "", node, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
            snode.first_child = ff
            snode.child_count = fc
            snode.first_ty_arg = fta
            snode.ty_arg_count = tac
            node = ast.add_expr(&mut p.module, move snode)
        }
        return node
    }
    fail_here(&mut p, "expected expression")
    ast.add_expr(&mut p.module, make_expr(.Error, "", "", -1, -1, ast.span(start_off(&p, first), end_off(&p, first))))
}

fn parse_type_builtin_args(p: &mut Parser, first_out: &mut i32, count_out: &mut i32) {
    _ := expect(&mut p, "(")
    mut local_args: []ast.CallArg = []
    skip_newlines(&mut p)
    if !at_end(&p) && !is_sym(&p, ")") {
        astart := p.at
        t_id := parse_type_full(&mut p)
        alast := if p.at > astart { p.at - 1 } else { astart }
        sp := ast.span(start_off(&p, astart), end_off(&p, alast))
        mut te := make_expr(.TypeExpr, type_display_name(&p.module, t_id), "", -1, -1, sp)
        te.ty = t_id
        te_id := ast.add_expr(&mut p.module, move te)
        local_args.push(ast.CallArg { expr: te_id, is_move: false, span: sp })
        skip_newlines(&mut p)
        while eat(&mut p, ",") {
            skip_newlines(&mut p)
            if is_sym(&p, ")") { break }
            before := p.at
            bstart := p.at
            arg_e := parse_expr(&mut p, true)
            blast := if p.at > bstart { p.at - 1 } else { bstart }
            local_args.push(ast.CallArg {
                expr: arg_e, is_move: false,
                span: ast.span(start_off(&p, bstart), end_off(&p, blast)),
            })
            skip_newlines(&mut p)
            if p.at == before { skip(&mut p) }
        }
    }
    _ := expect(&mut p, ")")
    first_out = p.module.call_args.len
    count_out = local_args.len
    for i in 0..local_args.len { p.module.call_args.push(local_args[i]) }
}

fn is_type_arg_builtin(m: &ast.Module, expr_id: i32) -> bool {
    if expr_id < 0 || expr_id >= m.exprs.len { return false }
    e := &m.exprs[expr_id]
    e.kind == .Ident && (e.text == "size_of" || e.text == "align_of" || e.text == "offset_of")
}

fn parse_postfix(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    first := p.at
    mut expr := parse_primary(&mut p, allow_struct_lit)
    while !at_end(&p) {
        if is_sym(&p, "(") {
            mut fa := 0; mut ac := 0
            if is_type_arg_builtin(&p.module, expr) {
                parse_type_builtin_args(&mut p, &mut fa, &mut ac)
            } else {
                parse_arg_list(&mut p, &mut fa, &mut ac)
            }
            mut node := make_expr(.Call, "", "()", expr, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
            node.first_child = fa
            node.child_count = ac
            expr = ast.add_expr(&mut p.module, move node)
        } else if eat(&mut p, "::") {
            if kind(&p) == .Name {
                mname := text(&p); skip(&mut p)
                mut fta := 0; mut tac := 0
                if is_sym(&p, "<") && looks_like_generic_call(&p) { parse_type_args(&mut p, &mut fta, &mut tac) }
                if (allow_struct_lit && looks_like_struct_literal(&p)) || looks_like_struct_literal_with_continuation(&p) {
                    mut ff := 0; mut fc := 0
                    parse_struct_lit_fields(&mut p, &mut ff, &mut fc)
                    mut snode := make_expr(.StructLit, mname, "::", expr, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
                    snode.first_child = ff
                    snode.child_count = fc
                    snode.first_ty_arg = fta
                    snode.ty_arg_count = tac
                    expr = ast.add_expr(&mut p.module, move snode)
                } else {
                    mut fnode := make_expr(.Field, mname, "::", expr, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
                    fnode.first_ty_arg = fta
                    fnode.ty_arg_count = tac
                    expr = ast.add_expr(&mut p.module, move fnode)
                }
            } else {
                fail_here(&mut p, "expected identifier after '::'")
                break
            }
        } else if eat(&mut p, ".") {
            if kind(&p) == .Name || kind(&p) == .Integer {
                mname := text(&p); skip(&mut p)
                mut fta := 0; mut tac := 0
                if is_sym(&p, "<") && looks_like_generic_call(&p) { parse_type_args(&mut p, &mut fta, &mut tac) }
                if is_sym(&p, "(") {
                    mut fa := 0; mut ac := 0
                    parse_arg_list(&mut p, &mut fa, &mut ac)
                    mut mnode := make_expr(.MethodCall, mname, ".", expr, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
                    mnode.first_child = fa
                    mnode.child_count = ac
                    mnode.first_ty_arg = fta
                    mnode.ty_arg_count = tac
                    expr = ast.add_expr(&mut p.module, move mnode)
                } else if (allow_struct_lit && looks_like_struct_literal(&p)) || looks_like_struct_literal_with_continuation(&p) {
                    mut ff := 0; mut fc := 0
                    parse_struct_lit_fields(&mut p, &mut ff, &mut fc)
                    mut snode := make_expr(.StructLit, mname, ".", expr, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
                    snode.first_child = ff
                    snode.child_count = fc
                    snode.first_ty_arg = fta
                    snode.ty_arg_count = tac
                    expr = ast.add_expr(&mut p.module, move snode)
                } else {
                    mut fnode := make_expr(.Field, mname, ".", expr, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
                    fnode.first_ty_arg = fta
                    fnode.ty_arg_count = tac
                    expr = ast.add_expr(&mut p.module, move fnode)
                }
            } else {
                fail_here(&mut p, "expected field or method name after '.'")
                break
            }
        } else if eat(&mut p, "[") {
            skip_newlines(&mut p)
            mut is_slice := false
            mut range_op := ""
            mut start_e := -1
            mut end_e := -1
            if is_sym(&p, "..") || is_sym(&p, "..=") {
                is_slice = true
                range_op = text(&p); skip(&mut p)
                if range_op == ".." && eat(&mut p, "=") { range_op = "..=" }
                if !is_sym(&p, "]") { end_e = parse_expr(&mut p, true) }
            } else {
                start_e = parse_expr(&mut p, true)
                if is_sym(&p, "..") || is_sym(&p, "..=") {
                    is_slice = true
                    range_op = text(&p); skip(&mut p)
                    if range_op == ".." && eat(&mut p, "=") { range_op = "..=" }
                    if !is_sym(&p, "]") { end_e = parse_expr(&mut p, true) }
                } else if start_e >= 0 && start_e < p.module.exprs.len && p.module.exprs[start_e].kind == .Range {
                    // `a[0..n]` parsed as Range inside `[...]` -> normalize to Slice
                    is_slice = true
                    range_op = p.module.exprs[start_e].op.clone()
                    end_e = p.module.exprs[start_e].right
                    start_e = p.module.exprs[start_e].left
                }
            }
            skip_newlines(&mut p)
            _ := expect(&mut p, "]")
            if is_slice {
                mut snode := make_expr(.Slice, "[]", range_op, expr, start_e, ast.span(start_off(&p, first), end_off(&p, p.at - 1)))
                snode.extra = end_e
                if range_op == "..=" { snode.flags = 1 }
                expr = ast.add_expr(&mut p.module, move snode)
            } else {
                expr = ast.add_expr(&mut p.module, make_expr(.Index, "[]", "", expr, start_e, ast.span(start_off(&p, first), end_off(&p, p.at - 1))))
            }
        } else if eat(&mut p, "?") {
            expr = ast.add_expr(&mut p.module, make_expr(.Try, "?", "?", expr, -1, ast.span(start_off(&p, first), end_off(&p, p.at - 1))))
        } else {
            break
        }
    }
    expr
}

fn parse_unary(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_expr(&mut p.module, make_expr(.Error, "", "", -1, -1, ast.span(start_off(&p, p.at), start_off(&p, p.at))))
    }
    first := p.at
    mut out := -1
    if is_sym(&p, "-") || is_sym(&p, "!") || is_sym(&p, "&") || is_word(&p, "move") {
        if is_word(&p, "move") && is_word_at(&p, p.at + 1, "fn") {
            out = parse_postfix(&mut p, allow_struct_lit)
        } else {
            mut op := text(&p)
            skip(&mut p)
            if op == "&" && eat(&mut p, "mut") { op = "&mut" }
            rhs := parse_unary(&mut p, allow_struct_lit)
            k := if op == "move" { ast.ExprKind.Move } else { ast.ExprKind.Unary }
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_expr(&mut p.module, make_expr(k, "", op, rhs, -1, ast.span(start_off(&p, first), end_off(&p, last))))
        }
    } else {
        out = parse_postfix(&mut p, allow_struct_lit)
    }
    leave_depth(&mut p)
    out
}

fn infix_precedence(p: &Parser) -> i32 {
    if is_sym(&p, "*") || is_sym(&p, "/") || is_sym(&p, "%") { return 7 }
    if is_sym(&p, "+") || is_sym(&p, "-") { return 6 }
    if is_sym(&p, "<") || is_sym(&p, "<=") || is_sym(&p, ">") || is_sym(&p, ">=") { return 5 }
    if is_sym(&p, "==") || is_sym(&p, "!=") { return 4 }
    if is_sym(&p, "&&") { return 3 }
    if is_sym(&p, "||") { return 2 }
    if is_sym(&p, "..") || is_sym(&p, "..=") { return 1 }
    0
}

fn parse_binary(p: &mut Parser, min_prec: i32, allow_struct_lit: bool) -> i32 {
    if !enter_depth(&mut p) {
        return ast.add_expr(&mut p.module, make_expr(.Error, "", "", -1, -1, ast.span(start_off(&p, p.at), start_off(&p, p.at))))
    }
    mut lhs := parse_unary(&mut p, allow_struct_lit)
    while !at_end(&p) {
        prec := infix_precedence(&p)
        if prec < min_prec || prec == 0 { break }
        mut op := text(&p)
        op_tok := p.at
        skip(&mut p)
        if op == ".." && eat(&mut p, "=") { op = "..=" }
        if (op == ".." || op == "..=") && (is_sym(&p, "]") || is_sym(&p, ")") || is_sym(&p, ",") || is_sym(&p, ";") || is_sym(&p, "}")) {
            lspan := p.module.exprs[lhs].span
            lhs = ast.add_expr(&mut p.module, make_expr(.Range, "", op, lhs, -1, ast.span(lspan.start, end_off(&p, op_tok))))
            continue
        }
        if is_nl(&p) { skip_newlines(&mut p) }
        rhs := parse_binary(&mut p, prec + 1, allow_struct_lit)
        lspan := p.module.exprs[lhs].span
        rspan := p.module.exprs[rhs].span
        kind_node := if op == ".." || op == "..=" { ast.ExprKind.Range } else { ast.ExprKind.Binary }
        lhs = ast.add_expr(&mut p.module, make_expr(kind_node, "", op, lhs, rhs, ast.span(lspan.start, rspan.end)))
    }
    leave_depth(&mut p)
    lhs
}

fn parse_expr(p: &mut Parser, allow_struct_lit: bool) -> i32 {
    parse_binary(&mut p, 1, allow_struct_lit)
}

// --- Statements ---

fn assignment_op(p: &Parser) -> bool {
    is_sym(&p, "=") || is_sym(&p, "+=") || is_sym(&p, "-=") || is_sym(&p, "*=") || is_sym(&p, "/=") || is_sym(&p, "%=")
}

fn looks_like_region_stmt(p: &Parser) -> bool {
    if !is_word(&p, "region") { return false }
    if p.at + 1 >= p.tokens.kinds.len || p.tokens.kinds[p.at + 1] != .Name { return false }
    mut k := p.at + 2
    if is_word_at(&p, k, "(") && k < p.closes.len && p.closes[k] > k {
        k = p.closes[k] + 1
    }
    while k < p.tokens.kinds.len && lexer.is_newline(p.tokens.kinds[k]) { k += 1 }
    is_word_at(&p, k, "{")
}

fn parse_stmt(p: &mut Parser) -> i32 {
    if !enter_depth(&mut p) {
        sync_stmt(&mut p)
        return -1
    }
    first := p.at
    mut out := -1
    if eat(&mut p, "return") {
        mut val := -1
        if !is_sep(&p) && !is_sym(&p, "}") { val = parse_expr(&mut p, true) }
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, make_stmt(.Return, "", false, val, ast.span(start_off(&p, first), end_off(&p, last))))
    } else if eat(&mut p, "break") {
        mut val := -1
        if !is_sep(&p) && !is_sym(&p, "}") { val = parse_expr(&mut p, true) }
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, make_stmt(.Break, "", false, val, ast.span(start_off(&p, first), end_off(&p, last))))
    } else if eat(&mut p, "continue") {
        out = ast.add_stmt(&mut p.module, make_stmt(.Continue, "", false, -1, ast.span(start_off(&p, first), end_off(&p, first))))
    } else if eat(&mut p, "defer") {
        mut val := -1
        if is_sym(&p, "{") { val = parse_block(&mut p) } else { val = parse_expr(&mut p, true) }
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_stmt(.Defer, "", false, val, ast.span(start_off(&p, first), end_off(&p, last)))
        node.body = val
        out = ast.add_stmt(&mut p.module, move node)
    } else if eat(&mut p, "while") {
        cond := parse_expr(&mut p, false)
        skip_newlines(&mut p)
        blk := parse_block(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_stmt(.While, "", false, cond, ast.span(start_off(&p, first), end_off(&p, last)))
        node.body = blk
        out = ast.add_stmt(&mut p.module, move node)
    } else if eat(&mut p, "for") {
        pat := parse_pat(&mut p, false)
        mut name := "_"
        if pat >= 0 && pat < p.module.pats.len && (p.module.pats[pat].kind == .Binding || p.module.pats[pat].kind == .Wildcard) {
            name = p.module.pats[pat].name.clone()
        }
        _ := expect(&mut p, "in")
        is_mv := eat(&mut p, "move")
        iter := parse_expr(&mut p, false)
        skip_newlines(&mut p)
        blk := parse_block(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_stmt(.For, name, false, iter, ast.span(start_off(&p, first), end_off(&p, last)))
        node.pat = pat
        node.is_move = is_mv
        node.body = blk
        out = ast.add_stmt(&mut p.module, move node)
    } else if looks_like_region_stmt(&p) && eat(&mut p, "region") {
        mut rname := ""
        if kind(&p) == .Name { rname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected region name") }
        mut cap_e := -1
        if eat(&mut p, "(") {
            skip_newlines(&mut p)
            if !is_sym(&p, ")") { cap_e = parse_expr(&mut p, true) }
            skip_newlines(&mut p)
            _ := expect(&mut p, ")")
        }
        skip_newlines(&mut p)
        blk := parse_block(&mut p)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_stmt(.Region, rname, false, blk, ast.span(start_off(&p, first), end_off(&p, last)))
        node.body = blk
        node.cap_expr = cap_e
        out = ast.add_stmt(&mut p.module, move node)
    } else if is_word(&p, "task") && is_word_at(&p, p.at + 1, "scope") {
        skip(&mut p); skip(&mut p)
        mut sname := ""
        if kind(&p) == .Name { sname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected task scope name") }
        mut shared_args: []ast.TaskSharedArg = []
        if eat(&mut p, "(") {
            skip_newlines(&mut p)
            while !at_end(&p) && !is_sym(&p, ")") {
                before := p.at
                astart := p.at
                is_sh := eat(&mut p, "shared")
                e := parse_expr(&mut p, true)
                alast := if p.at > astart { p.at - 1 } else { astart }
                shared_args.push(ast.TaskSharedArg {
                    is_shared: is_sh, expr: e,
                    span: ast.span(start_off(&p, astart), end_off(&p, alast)),
                })
                skip_newlines(&mut p)
                if !eat(&mut p, ",") { break }
                skip_newlines(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, ")")
        }
        mut cap_names: []string = []
        mut arena_e := -1
        skip_newlines(&mut p)
        while is_word(&p, "with") || is_word(&p, "arena") {
            if eat(&mut p, "with") {
                skip_newlines(&mut p)
                if expect(&mut p, "(") {
                    skip_newlines(&mut p)
                    while !at_end(&p) && !is_sym(&p, ")") {
                        before := p.at
                        cap_names.push(text(&p))
                        skip(&mut p)
                        skip_newlines(&mut p)
                        if !eat(&mut p, ",") { break }
                        skip_newlines(&mut p)
                        if p.at == before { skip(&mut p) }
                    }
                    _ := expect(&mut p, ")")
                }
            } else if eat(&mut p, "arena") {
                skip_newlines(&mut p)
                arena_e = parse_expr(&mut p, false)
            }
            skip_newlines(&mut p)
        }
        blk := parse_block(&mut p)
        first_sh := p.module.task_shared_args.len
        sh_cnt := shared_args.len
        for i in 0..shared_args.len { p.module.task_shared_args.push(shared_args[i]) }
        first_cap := ast.add_name_list(&mut p.module, &cap_names)
        cidx := ast.add_task_clause(&mut p.module, ast.TaskClause {
            first_shared: first_sh, shared_count: sh_cnt,
            first_cap: first_cap, cap_count: cap_names.len,
            arena_expr: arena_e,
        })
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_stmt(.TaskScope, sname, false, blk, ast.span(start_off(&p, first), end_off(&p, last)))
        node.body = blk
        node.clause_idx = cidx
        out = ast.add_stmt(&mut p.module, move node)
    } else if eat(&mut p, "mut") {
        if looks_like_struct_pattern(&p) || is_sym(&p, "(") {
            pat := parse_pat(&mut p, false)
            _ := expect(&mut p, ":=")
            val := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            mut node := make_stmt(.Let, "", true, val, ast.span(start_off(&p, first), end_off(&p, last)))
            node.pat = pat
            out = ast.add_stmt(&mut p.module, move node)
        } else {
            mut bname := "_"
            if kind(&p) == .Name { bname = text(&p); skip(&mut p) }
            else { fail_here(&mut p, "expected variable name after 'mut'") }
            mut bty := -1
            if eat(&mut p, ":") {
                bty = parse_type_full(&mut p)
                _ := expect(&mut p, "=")
            } else {
                _ := expect(&mut p, ":=")
            }
            val := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            mut node := make_stmt(.Let, bname, true, val, ast.span(start_off(&p, first), end_off(&p, last)))
            node.ty = bty
            out = ast.add_stmt(&mut p.module, move node)
        }
    } else if kind(&p) == .Name && is_word_at(&p, p.at + 1, ":=") {
        bname := text(&p); skip(&mut p); skip(&mut p)
        val := parse_expr(&mut p, true)
        last := if p.at > first { p.at - 1 } else { first }
        out = ast.add_stmt(&mut p.module, make_stmt(.Let, bname, false, val, ast.span(start_off(&p, first), end_off(&p, last))))
    } else if kind(&p) == .Name && is_word_at(&p, p.at + 1, ":") {
        bname := text(&p); skip(&mut p); skip(&mut p)
        bty := parse_type_full(&mut p)
        _ := expect(&mut p, "=")
        val := parse_expr(&mut p, true)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_stmt(.Let, bname, false, val, ast.span(start_off(&p, first), end_off(&p, last)))
        node.ty = bty
        out = ast.add_stmt(&mut p.module, move node)
    } else if looks_like_struct_pattern(&p) || (is_sym(&p, "(") && p.at < p.closes.len && p.closes[p.at] > p.at && is_word_at(&p, p.closes[p.at] + 1, ":=")) {
        pat := parse_pat(&mut p, false)
        _ := expect(&mut p, ":=")
        val := parse_expr(&mut p, true)
        last := if p.at > first { p.at - 1 } else { first }
        mut node := make_stmt(.Let, "", false, val, ast.span(start_off(&p, first), end_off(&p, last)))
        node.pat = pat
        out = ast.add_stmt(&mut p.module, move node)
    } else {
        expr := parse_expr(&mut p, true)
        if assignment_op(&p) {
            op := text(&p); skip(&mut p)
            rhs := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            mut node := make_stmt(.Assign, "", false, rhs, ast.span(start_off(&p, first), end_off(&p, last)))
            node.lhs = expr
            node.op = op
            out = ast.add_stmt(&mut p.module, move node)
        } else if p.in_test_block && eat(&mut p, "->") {
            rhs := parse_expr(&mut p, true)
            last := if p.at > first { p.at - 1 } else { first }
            sp := ast.span(start_off(&p, first), end_off(&p, last))
            arrow := ast.add_expr(&mut p.module, make_expr(.Binary, "", "->", expr, rhs, sp))
            out = ast.add_stmt(&mut p.module, make_stmt(.Expr, "", false, arrow, sp))
        } else {
            last := if p.at > first { p.at - 1 } else { first }
            out = ast.add_stmt(&mut p.module, make_stmt(.Expr, "", false, expr, ast.span(start_off(&p, first), end_off(&p, last))))
        }
    }
    if is_sym(&p, ";") {
        if out >= 0 && out < p.module.stmts.len { p.module.stmts[out].has_semi = true }
    } else if !is_sep(&p) && !is_sym(&p, "}") && !(p.at > first && is_word_at(&p, p.at - 1, "}")) {
        fail_here(&mut p, "expected newline or ';' after statement")
        sync_stmt(&mut p)
    }
    leave_depth(&mut p)
    out
}

// --- Parameters ---

fn parse_param_list(p: &mut Parser, allow_self: bool, first_out: &mut i32, count_out: &mut i32) {
    first_out = p.module.params.len
    count_out = 0
    if !expect(&mut p, "(") { return }
    mut local_params: []ast.Param = []
    skip_newlines(&mut p)
    while !at_end(&p) && !is_sym(&p, ")") {
        before := p.at
        pstart := p.at
        mut is_mut := eat(&mut p, "mut")
        is_move := eat(&mut p, "move")
        if !is_mut && eat(&mut p, "mut") { is_mut = true }
        mut pname := ""
        mut pty := -1
        mut recv := ast.ReceiverKind.None
        mut is_var := false
        if is_sym(&p, "...") {
            pname = "..."
            is_var = true
            skip(&mut p)
        } else if eat(&mut p, "&") {
            ref_mut := eat(&mut p, "mut")
            if allow_self && eat(&mut p, "self") {
                pname = "self"
                recv = if ref_mut { ast.ReceiverKind.MutRef } else { ast.ReceiverKind.SharedRef }
                if ref_mut { is_mut = true }
            } else {
                fail_here(&mut p, "expected 'self' after '&' in parameter")
            }
        } else if allow_self && eat(&mut p, "self") {
            pname = "self"
            recv = .Owned
            if eat(&mut p, ":") { pty = parse_type_full(&mut p) }
        } else if kind(&p) == .Name {
            pname = text(&p); skip(&mut p)
            _ := expect(&mut p, ":")
            pty = parse_type_full(&mut p)
        } else {
            fail_here(&mut p, "expected parameter name")
            break
        }
        plast := if p.at > pstart { p.at - 1 } else { pstart }
        local_params.push(ast.Param {
            name: pname,
            is_mut: is_mut,
            is_move: is_move,
            ty: pty,
            span: ast.span(start_off(&p, pstart), end_off(&p, plast)),
            receiver: recv,
            is_variadic: is_var,
        })
        skip_newlines(&mut p)
        if !eat(&mut p, ",") { break }
        skip_newlines(&mut p)
        if p.at == before { skip(&mut p) }
    }
    _ := expect(&mut p, ")")
    first_out = p.module.params.len
    count_out = local_params.len
    for prm in move local_params { p.module.params.push(move prm) }
}

// --- Top-level items ---

fn parse_struct_item(p: &mut Parser, item_kind: ast.ItemKind, item_start: i32, is_pub: bool, is_opaque: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // struct or union
    name_tok := p.at
    mut sname := ""
    if kind(&p) == .Name { sname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected struct or union name") }
    mut fg := 0; mut gc := 0
    if is_sym(&p, "<") { parse_generic_params(&mut p, &mut fg, &mut gc) }
    mut fw := 0; mut wc := 0
    parse_where_clause(&mut p, &mut fw, &mut wc)
    skip_newlines(&mut p)
    mut local_members: []ast.Member = []
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            fstart := p.at
            f_pub := eat(&mut p, "pub")
            mut fname := ""
            mut fty := -1
            if kind(&p) == .Name {
                fname = text(&p); skip(&mut p)
                if expect(&mut p, ":") { fty = parse_type_full(&mut p) }
            } else {
                fail_here(&mut p, "expected struct field name")
                sync_stmt(&mut p)
            }
            flast := if p.at > fstart { p.at - 1 } else { fstart }
            if fname != "" {
                mut mem := make_member(fname, ast.span(start_off(&p, fstart), end_off(&p, flast)))
                mem.is_pub = f_pub
                mem.ty = fty
                local_members.push(move mem)
            }
            _ := eat(&mut p, ",")
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    first_member := p.module.members.len
    member_count := local_members.len
    for m in move local_members { p.module.members.push(move m) }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    mut it := make_item(item_kind, sname, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
    it.is_pub = is_pub
    it.is_opaque = is_opaque
    it.body_span = ast.span(start_off(&p, body_tok), end_off(&p, last))
    it.first_member = first_member
    it.member_count = member_count
    it.first_attr = first_attr
    it.attr_count = attr_count
    it.first_gen = fg
    it.gen_count = gc
    it.first_where = fw
    it.where_count = wc
    p.module.items.push(move it)
}

fn parse_enum_item(p: &mut Parser, item_start: i32, is_pub: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // enum
    name_tok := p.at
    mut ename := ""
    if kind(&p) == .Name { ename = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected enum name") }
    mut fg := 0; mut gc := 0
    if is_sym(&p, "<") { parse_generic_params(&mut p, &mut fg, &mut gc) }
    mut fw := 0; mut wc := 0
    parse_where_clause(&mut p, &mut fw, &mut wc)
    skip_newlines(&mut p)
    mut local_members: []ast.Member = []
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            vstart := p.at
            mut vname := ""
            mut payloads: []i32 = []
            mut disc_e := -1
            if kind(&p) == .Name {
                vname = text(&p); skip(&mut p)
                if eat(&mut p, "(") {
                    skip_newlines(&mut p)
                    while !at_end(&p) && !is_sym(&p, ")") {
                        b2 := p.at
                        payloads.push(parse_type_full(&mut p))
                        skip_newlines(&mut p)
                        if !eat(&mut p, ",") { break }
                        skip_newlines(&mut p)
                        if p.at == b2 { skip(&mut p) }
                    }
                    _ := expect(&mut p, ")")
                }
                if eat(&mut p, "=") {
                    dstart := p.at
                    neg := eat(&mut p, "-")
                    if kind(&p) == .Integer {
                        lit := text(&p); skip(&mut p)
                        num_e := ast.add_expr(&mut p.module, make_expr(.Int, lit, "", -1, -1, ast.span(start_off(&p, p.at - 1), end_off(&p, p.at - 1))))
                        if neg {
                            disc_e = ast.add_expr(&mut p.module, make_expr(.Unary, "", "-", num_e, -1, ast.span(start_off(&p, dstart), end_off(&p, p.at - 1))))
                        } else {
                            disc_e = num_e
                        }
                    } else {
                        fail_here(&mut p, "expected integer tag")
                    }
                }
            } else {
                fail_here(&mut p, "expected enum variant name")
                sync_stmt(&mut p)
            }
            vlast := if p.at > vstart { p.at - 1 } else { vstart }
            if vname != "" {
                fp := ast.add_id_list(&mut p.module, &payloads)
                mut mem := make_member(vname, ast.span(start_off(&p, vstart), end_off(&p, vlast)))
                mem.first_payload = fp
                mem.payload_count = payloads.len
                mem.discriminant_expr = disc_e
                local_members.push(move mem)
            }
            _ := eat(&mut p, ",")
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    first_member := p.module.members.len
    member_count := local_members.len
    for m in move local_members { p.module.members.push(move m) }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    mut it := make_item(.Enum, ename, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
    it.is_pub = is_pub
    it.body_span = ast.span(start_off(&p, body_tok), end_off(&p, last))
    it.first_member = first_member
    it.member_count = member_count
    it.first_attr = first_attr
    it.attr_count = attr_count
    it.first_gen = fg
    it.gen_count = gc
    it.first_where = fw
    it.where_count = wc
    p.module.items.push(move it)
}

fn parse_fn_item(p: &mut Parser, item_start: i32, is_pub: bool, is_unsafe: bool, is_test: bool, is_extern_decl: bool, is_extern_abi: bool, abi: string, parent_item: i32, first_attr: i32, attr_count: i32) -> i32 {
    skip(&mut p) // fn
    name_tok := p.at
    mut fname := ""
    if kind(&p) == .Name { fname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected function name") }
    mut fg := 0; mut gc := 0
    if is_sym(&p, "<") { parse_generic_params(&mut p, &mut fg, &mut gc) }
    mut fp := 0; mut fc := 0
    parse_param_list(&mut p, false, &mut fp, &mut fc)
    mut ret := -1
    mut ff := 0; mut fcnt := 0
    if eat(&mut p, "->") {
        ret = parse_type_full(&mut p)
        parse_return_source(&mut p, &mut ff, &mut fcnt)
    }
    mut fw := 0; mut wc := 0
    parse_where_clause(&mut p, &mut fw, &mut wc)
    skip_newlines(&mut p)
    mut body_span := ast.span(0, 0)
    mut body_expr := -1
    mut k := ast.ItemKind.Fn
    if is_extern_decl {
        k = .ExternFn
        if is_sym(&p, "{") { fail_here(&mut p, "external declaration cannot have a body") }
    } else {
        body_expr = parse_block(&mut p)
        body_span = p.module.exprs[body_expr].span
    }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    mut it := make_item(k, fname, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
    it.is_pub = is_pub
    it.is_unsafe = is_unsafe
    it.is_test = is_test
    it.body_span = body_span
    it.body_expr = body_expr
    it.first_param = fp
    it.param_count = fc
    it.first_attr = first_attr
    it.attr_count = attr_count
    it.ret_type = ret
    it.abi = abi.clone()
    it.is_extern = is_extern_decl || is_extern_abi
    it.parent_item = parent_item
    it.first_gen = fg
    it.gen_count = gc
    it.first_where = fw
    it.where_count = wc
    it.first_from = ff
    it.from_count = fcnt
    idx := p.module.items.len
    p.module.items.push(move it)
    idx
}

fn parse_trait_item(p: &mut Parser, item_start: i32, is_pub: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // trait
    name_tok := p.at
    mut tname := ""
    if kind(&p) == .Name { tname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected trait name") }
    mut fg := 0; mut gc := 0
    if is_sym(&p, "<") { parse_generic_params(&mut p, &mut fg, &mut gc) }
    mut supers: []i32 = []
    if eat(&mut p, ":") {
        while !at_end(&p) {
            skip_newlines(&mut p)
            supers.push(parse_type_full(&mut p))
            if !eat(&mut p, "+") { break }
        }
    }
    mut fw := 0; mut wc := 0
    parse_where_clause(&mut p, &mut fw, &mut wc)
    skip_newlines(&mut p)
    mut local_members: []ast.Member = []
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            mstart := p.at
            mut m_fa := 0; mut m_ac := 0; mut m_test := false
            parse_attr_list(&mut p, false, &mut m_fa, &mut m_ac, &mut m_test)
            m_unsafe := eat(&mut p, "unsafe")
            if !expect(&mut p, "fn") { sync_stmt(&mut p) }
            else {
                mut mname := ""
                if kind(&p) == .Name { mname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected trait method name") }
                mut mfg := 0; mut mgc := 0
                if is_sym(&p, "<") { parse_generic_params(&mut p, &mut mfg, &mut mgc) }
                mut mp := 0; mut mc := 0
                parse_param_list(&mut p, true, &mut mp, &mut mc)
                mut mty := -1
                mut mff := 0; mut mfc := 0
                if eat(&mut p, "->") {
                    mty = parse_type_full(&mut p)
                    parse_return_source(&mut p, &mut mff, &mut mfc)
                }
                mut mfw := 0; mut mwc := 0
                parse_where_clause(&mut p, &mut mfw, &mut mwc)
                skip_newlines(&mut p)
                mut bspan := ast.span(0, 0)
                mut bexpr := -1
                if is_sym(&p, "{") {
                    bexpr = parse_block(&mut p)
                    bspan = p.module.exprs[bexpr].span
                }
                mlast := if p.at > mstart { p.at - 1 } else { mstart }
                mut mem := make_member(mname, ast.span(start_off(&p, mstart), end_off(&p, mlast)))
                mem.is_unsafe = m_unsafe
                mem.ty = mty
                mem.body_span = bspan
                mem.body_expr = bexpr
                mem.first_gen = mfg
                mem.gen_count = mgc
                mem.first_where = mfw
                mem.where_count = mwc
                mem.first_param = mp
                mem.param_count = mc
                mem.first_from = mff
                mem.from_count = mfc
                mem.first_attr = m_fa
                mem.attr_count = m_ac
                local_members.push(move mem)
            }
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    first_member := p.module.members.len
    member_count := local_members.len
    for m in move local_members { p.module.members.push(move m) }
    first_super := ast.add_id_list(&mut p.module, &supers)
    last := if p.at > item_start { p.at - 1 } else { item_start }
    mut it := make_item(.Trait, tname, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
    it.is_pub = is_pub
    it.body_span = ast.span(start_off(&p, body_tok), end_off(&p, last))
    it.first_member = first_member
    it.member_count = member_count
    it.first_attr = first_attr
    it.attr_count = attr_count
    it.first_gen = fg
    it.gen_count = gc
    it.first_where = fw
    it.where_count = wc
    it.first_child = first_super
    it.child_count = supers.len
    p.module.items.push(move it)
}

fn parse_impl_item(p: &mut Parser, item_start: i32, is_unsafe: bool, first_attr: i32, attr_count: i32) {
    skip(&mut p) // impl
    mut fg := 0; mut gc := 0
    if is_sym(&p, "<") { parse_generic_params(&mut p, &mut fg, &mut gc) }
    name_tok := p.at
    mut target_tok := name_tok
    first_ty := parse_type_full(&mut p)
    mut trait_ty := -1
    mut target_ty := -1
    mut trait_name := ""
    mut target_name := ""
    skip_newlines(&mut p)
    if eat(&mut p, "for") {
        trait_ty = first_ty
        trait_name = type_display_name(&p.module, first_ty)
        skip_newlines(&mut p)
        target_tok = p.at
        target_ty = parse_type_full(&mut p)
        target_name = type_display_name(&p.module, target_ty)
    } else {
        target_ty = first_ty
        target_name = type_display_name(&p.module, first_ty)
    }
    mut fw := 0; mut wc := 0
    parse_where_clause(&mut p, &mut fw, &mut wc)
    skip_newlines(&mut p)
    mut local_members: []ast.Member = []
    body_tok := p.at
    if expect(&mut p, "{") {
        skip_seps(&mut p)
        while !at_end(&p) && !is_sym(&p, "}") {
            before := p.at
            mstart := p.at
            mut m_fa := 0; mut m_ac := 0; mut m_test := false
            parse_attr_list(&mut p, false, &mut m_fa, &mut m_ac, &mut m_test)
            m_pub := eat(&mut p, "pub")
            m_unsafe := eat(&mut p, "unsafe")
            if !expect(&mut p, "fn") {
                sync_stmt(&mut p)
            } else {
                mut mname := ""
                if kind(&p) == .Name { mname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected method name") }
                mut mfg := 0; mut mgc := 0
                if is_sym(&p, "<") { parse_generic_params(&mut p, &mut mfg, &mut mgc) }
                mut mp := 0; mut mc := 0
                parse_param_list(&mut p, true, &mut mp, &mut mc)
                mut mty := -1
                mut mff := 0; mut mfc := 0
                if eat(&mut p, "->") {
                    mty = parse_type_full(&mut p)
                    parse_return_source(&mut p, &mut mff, &mut mfc)
                }
                mut mfw := 0; mut mwc := 0
                parse_where_clause(&mut p, &mut mfw, &mut mwc)
                skip_newlines(&mut p)
                bexpr := parse_block(&mut p)
                bspan := p.module.exprs[bexpr].span
                mlast := if p.at > mstart { p.at - 1 } else { mstart }
                mut mem := make_member(mname, ast.span(start_off(&p, mstart), end_off(&p, mlast)))
                mem.is_pub = m_pub
                mem.is_unsafe = m_unsafe
                mem.ty = mty
                mem.body_span = bspan
                mem.body_expr = bexpr
                mem.first_gen = mfg
                mem.gen_count = mgc
                mem.first_where = mfw
                mem.where_count = mwc
                mem.first_param = mp
                mem.param_count = mc
                mem.first_from = mff
                mem.from_count = mfc
                mem.first_attr = m_fa
                mem.attr_count = m_ac
                local_members.push(move mem)
            }
            skip_seps(&mut p)
            if p.at == before { skip(&mut p) }
        }
        _ := expect(&mut p, "}")
    }
    first_member := p.module.members.len
    member_count := local_members.len
    for m in move local_members { p.module.members.push(move m) }
    last := if p.at > item_start { p.at - 1 } else { item_start }
    mut it := make_item(.Impl, target_name.clone(), ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, target_tok), end_off(&p, target_tok)))
    it.target_name = target_name
    it.trait_name = trait_name
    it.target_ty = target_ty
    it.trait_ty = trait_ty
    it.is_unsafe = is_unsafe
    it.body_span = ast.span(start_off(&p, body_tok), end_off(&p, last))
    it.first_member = first_member
    it.member_count = member_count
    it.first_attr = first_attr
    it.attr_count = attr_count
    it.first_gen = fg
    it.gen_count = gc
    it.first_where = fw
    it.where_count = wc
    p.module.items.push(move it)
}

fn parse_top_item(p: &mut Parser) {
    item_start := p.at
    if is_word(&p, "capability") {
        skip(&mut p)
        mut caps: []string = []
        while !at_end(&p) && !is_sep(&p) {
            if kind(&p) == .Name || kind(&p) == .Keyword {
                caps.push(text(&p)); skip(&mut p)
            } else {
                fail_here(&mut p, "expected capability name"); break
            }
            if !eat(&mut p, ",") { break }
        }
        fn_idx := ast.add_name_list(&mut p.module, &caps)
        last := if p.at > item_start { p.at - 1 } else { item_start }
        mut it := make_item(.Capability, "capability", ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, item_start), end_off(&p, item_start)))
        it.first_name = fn_idx
        it.name_count = caps.len
        p.module.items.push(move it)
        return
    }
    if is_word(&p, "import") {
        skip(&mut p)
        name_tok := p.at
        mut ipath := ""
        mut segs: []string = []
        while !at_end(&p) && !is_sep(&p) && !is_word(&p, "as") {
            tok_txt := text(&p)
            ipath = ipath + tok_txt
            segs.push(move tok_txt)
            skip(&mut p)
        }
        mut alias := ipath.clone()
        if eat(&mut p, "as") {
            if kind(&p) == .Name { alias = text(&p); skip(&mut p) }
            else { fail_here(&mut p, "expected import alias after 'as'") }
        }
        fn_idx := ast.add_name_list(&mut p.module, &segs)
        last := if p.at > item_start { p.at - 1 } else { item_start }
        mut it := make_item(.Import, alias, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, last)))
        it.target_name = ipath
        it.first_name = fn_idx
        it.name_count = segs.len
        p.module.items.push(move it)
        return
    }

    mut first_attr := 0; mut attr_count := 0; mut is_test := false
    parse_attr_list(&mut p, true, &mut first_attr, &mut attr_count, &mut is_test)

    is_pub := eat(&mut p, "pub")
    is_unsafe := eat(&mut p, "unsafe")
    is_opaque := eat(&mut p, "opaque")

    if is_word(&p, "const") {
        skip(&mut p)
        name_tok := p.at
        mut cname := ""
        if kind(&p) == .Name { cname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected constant name") }
        mut cty := -1
        if eat(&mut p, ":") { cty = parse_type_full(&mut p) }
        mut init_e := -1
        if expect(&mut p, "=") { init_e = parse_expr(&mut p, true) }
        last := if p.at > item_start { p.at - 1 } else { item_start }
        mut it := make_item(.Const, cname, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
        it.is_pub = is_pub
        it.first_attr = first_attr
        it.attr_count = attr_count
        it.ret_type = cty
        it.body_expr = init_e
        p.module.items.push(move it)
        return
    }
    if is_word(&p, "extern") && is_word_at(&p, p.at + 1, "type") {
        skip(&mut p); skip(&mut p)
        name_tok := p.at
        mut tname := ""
        if kind(&p) == .Name { tname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected extern type name") }
        last := if p.at > item_start { p.at - 1 } else { item_start }
        mut it := make_item(.ExternType, tname, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
        it.is_pub = is_pub
        it.is_opaque = true
        it.is_extern = true
        it.first_attr = first_attr
        it.attr_count = attr_count
        p.module.items.push(move it)
        return
    }
    if is_word(&p, "extern") {
        skip(&mut p)
        mut abi := ""
        if kind(&p) == .String { abi = text(&p); skip(&mut p) }
        skip_newlines(&mut p)
        if is_sym(&p, "{") {
            body_tok := p.at
            block_idx := p.module.items.len
            mut blk_it := make_item(.ExternBlock, "", ast.span(start_off(&p, item_start), start_off(&p, item_start)), ast.span(start_off(&p, item_start), start_off(&p, item_start)))
            blk_it.is_pub = is_pub
            blk_it.is_unsafe = is_unsafe
            blk_it.is_extern = true
            blk_it.abi = abi.clone()
            blk_it.first_attr = first_attr
            blk_it.attr_count = attr_count
            p.module.items.push(move blk_it)

            skip(&mut p)
            skip_seps(&mut p)
            mut child_ids: []i32 = []
            while !at_end(&p) && !is_sym(&p, "}") {
                before := p.at
                mstart := p.at
                mut m_fa := 0; mut m_ac := 0; mut m_test := false
                parse_attr_list(&mut p, false, &mut m_fa, &mut m_ac, &mut m_test)
                m_pub := eat(&mut p, "pub")
                m_unsafe := eat(&mut p, "unsafe")
                if is_word(&p, "fn") {
                    cid := parse_fn_item(&mut p, mstart, m_pub, true || m_unsafe, false, true, true, abi.clone(), block_idx, m_fa, m_ac)
                    child_ids.push(cid)
                } else if is_word(&p, "static") {
                    skip(&mut p)
                    s_mut := eat(&mut p, "mut")
                    name_tok := p.at
                    mut sname := ""
                    if kind(&p) == .Name { sname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected extern static name") }
                    mut sty := -1
                    if expect(&mut p, ":") { sty = parse_type_full(&mut p) }
                    slast := if p.at > mstart { p.at - 1 } else { mstart }
                    mut sit := make_item(.ExternStatic, sname, ast.span(start_off(&p, mstart), end_off(&p, slast)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
                    sit.is_pub = m_pub
                    sit.is_unsafe = true || m_unsafe
                    sit.is_mut = s_mut
                    sit.is_extern = true
                    sit.abi = abi.clone()
                    sit.parent_item = block_idx
                    sit.first_attr = m_fa
                    sit.attr_count = m_ac
                    sit.ret_type = sty
                    cid := p.module.items.len
                    p.module.items.push(move sit)
                    child_ids.push(cid)
                } else {
                    fail_here(&mut p, "expected 'fn' or 'static' inside extern block")
                    sync_stmt(&mut p)
                }
                skip_seps(&mut p)
                if p.at == before { skip(&mut p) }
            }
            _ := expect(&mut p, "}")
            last := if p.at > item_start { p.at - 1 } else { item_start }
            fc := ast.add_id_list(&mut p.module, &child_ids)
            p.module.items[block_idx].span = ast.span(start_off(&p, item_start), end_off(&p, last))
            p.module.items[block_idx].body_span = ast.span(start_off(&p, body_tok), end_off(&p, last))
            p.module.items[block_idx].first_child = fc
            p.module.items[block_idx].child_count = child_ids.len
            return
        }
        ext_unsafe := eat(&mut p, "unsafe")
        if is_word(&p, "fn") {
            _ := parse_fn_item(&mut p, item_start, is_pub, is_unsafe || ext_unsafe, is_test, false, true, abi, -1, first_attr, attr_count)
            return
        }
        fail_here(&mut p, "expected '{', 'fn', or 'type' after 'extern'")
        sync_top_level(&mut p)
        return
    }
    if is_word(&p, "type") {
        skip(&mut p)
        name_tok := p.at
        mut tname := ""
        if kind(&p) == .Name { tname = text(&p); skip(&mut p) } else { fail_here(&mut p, "expected type alias name") }
        mut fg := 0; mut gc := 0
        if is_sym(&p, "<") { parse_generic_params(&mut p, &mut fg, &mut gc) }
        mut tty := -1
        if expect(&mut p, "=") { tty = parse_type_full(&mut p) }
        last := if p.at > item_start { p.at - 1 } else { item_start }
        mut it := make_item(.TypeAlias, tname, ast.span(start_off(&p, item_start), end_off(&p, last)), ast.span(start_off(&p, name_tok), end_off(&p, name_tok)))
        it.is_pub = is_pub
        it.first_attr = first_attr
        it.attr_count = attr_count
        it.first_gen = fg
        it.gen_count = gc
        it.ret_type = tty
        p.module.items.push(move it)
        return
    }
    if is_word(&p, "struct") { parse_struct_item(&mut p, .Struct, item_start, is_pub, is_opaque, first_attr, attr_count); return }
    if is_word(&p, "union") { parse_struct_item(&mut p, .Union, item_start, is_pub, is_opaque, first_attr, attr_count); return }
    if is_word(&p, "enum") { parse_enum_item(&mut p, item_start, is_pub, first_attr, attr_count); return }
    if is_word(&p, "trait") { parse_trait_item(&mut p, item_start, is_pub, first_attr, attr_count); return }
    if is_word(&p, "impl") { parse_impl_item(&mut p, item_start, is_unsafe, first_attr, attr_count); return }
    if is_word(&p, "fn") { _ := parse_fn_item(&mut p, item_start, is_pub, is_unsafe, is_test, false, false, "", -1, first_attr, attr_count); return }

    fail_here(&mut p, "expected declaration (fn, struct, enum, trait, impl, const, import or capability)")
    sync_top_level(&mut p)
}

pub fn parse_tokens(path: string, tokens: &lexer.Tokens) -> ast.Module {
    mut p := new_parser(path, &tokens)
    if !tokens.ok {
        record_error(&mut p, "E1001", 0, -1, tokens.error.clone())
        if p.module.diagnostics.len > 0 {
            sp := diag.resolve_span(tokens.source, tokens.error_at, -1)
            p.module.diagnostics[0].start = sp.start
            p.module.diagnostics[0].end = sp.end
        }
        return p.module
    }
    skip_seps(&mut p)
    while !at_end(&p) && p.module.diagnostics.len < 32 {
        before := p.at
        parse_top_item(&mut p)
        skip_seps(&mut p)
        if p.at == before { skip(&mut p) }
    }
    p.module
}

pub fn parse_source(path: string, source: string) -> ast.Module {
    tokens := lexer.scan(source, false)
    parse_tokens(path, &tokens)
}

@test fn parser_handles_declarations_expressions_and_generics() {
    src := "capability filesystem\nimport std.text as text\nconst LIMIT: i32 = 16\n" +
    "@derive(Eq)\nstruct Box<T> { val: T, tag: i32 }\n" +
    "enum Msg { Empty, Pair(i32, string) }\n" +
    "trait Show { fn show(&self) -> string }\n" +
    "impl Show for Box<i32> { fn show(&self) -> string { f\"box:{self.tag}\" } }\n" +
    "fn work(mut a: []i32, f: fn(i32) -> i32) -> i32 {\n" +
    "    x := Box<i32> { val: 1, tag: 2 }\n" +
    "    res := match x.tag { 0 => 10, 1 | 2 if a.len > 0 => f(a[0]), _ => 0 }\n" +
    "    for i in 0..=4 { a.push(i) }\n" +
    "    res\n" +
    "}\n"
    m := parse_source("sample.ddr", src)
    assert(m.ok && m.diagnostics.len == 0)
    assert(ast.item_count(&m) == 8)
    assert(m.items[0].kind == .Capability && m.items[0].name_count == 1 && m.name_lists[m.items[0].first_name] == "filesystem")
    assert(m.items[2].kind == .Const && m.items[2].body_expr >= 0 && m.exprs[m.items[2].body_expr].kind == .Int)
    assert(m.items[3].kind == .Struct && m.items[3].gen_count == 1 && m.generic_params[m.items[3].first_gen].name == "T")
    assert(m.items[3].attr_count == 1 && m.attrs[m.items[3].first_attr].arg_count == 1)
    assert(m.items[4].kind == .Enum && m.items[4].name == "Msg" && m.items[4].member_count == 2)
    assert(m.members[m.items[4].first_member + 1].payload_count == 2)
    assert(m.items[5].kind == .Trait && m.members[m.items[5].first_member].param_count == 1)
    assert(m.params[m.members[m.items[5].first_member].first_param].receiver == .SharedRef)
    assert(m.items[6].kind == .Impl && m.items[6].trait_ty >= 0 && m.items[6].target_ty >= 0)
    assert(m.members[m.items[6].first_member].body_expr >= 0)
    assert(m.items[7].kind == .Fn && m.items[7].name == "work" && m.items[7].param_count == 2 && m.items[7].body_expr >= 0)
    work_blk := &m.exprs[m.items[7].body_expr]
    assert(work_blk.kind == .BlockExpr && work_blk.child_count == 3 && work_blk.extra >= 0)
    assert(m.exprs[work_blk.extra].kind == .Ident && m.exprs[work_blk.extra].text == "res")
    assert(ast.find_item_at(&m, m.items[7].name_span.start) == 7)
}

@test fn parser_recovers_multiple_errors_across_functions() {
    src := "fn broken_one( { x := 1 }\nfn valid(a: i32) -> i32 { a + 1 }\nfn broken_two() { y := ; }\n"
    m := parse_source("broken.ddr", src)
    assert(!m.ok && m.diagnostics.len >= 2)
    mut saw_valid := false
    for it in &m.items {
        if it.kind == .Fn && it.name == "valid" { saw_valid = true }
    }
    assert(saw_valid)
}

@test fn parser_preserves_wave2b_ffi_and_regions() {
    src := "capability unsafe\n" +
    "pub extern type HandleA\n" +
    "pub type Word = u64\n" +
    "@repr(C, packed(2))\nstruct Padded { tag: u8, big: i64 }\n" +
    "@repr(C)\nunion Val { i: i32, f: f32 }\n" +
    "@repr(i32)\nenum Status { Ok = 0, Err = -1 }\n" +
    "@link(macos = \"objc\", weak = true)\nextern \"C\" {\n" +
    "    @link_name(\"strlen\")\n    fn c_len(s: *const u8, ...) -> usize\n" +
    "    pub static mut counter: i32\n" +
    "}\n" +
    "extern \"C\" fn cb(x: i32) -> i32 { x + 1 }\n" +
    "fn demo(xs: &[]i32) -> &i32 from xs {\n" +
    "    p := Padded { tag: 1, ..zeroed() }\n" +
    "    region scratch(4096) { _ := p.tag; _ := c\"hi\"; _ := w\"hi\" }\n" +
    "    &xs[0]\n" +
    "}\n"
    m := parse_source("ffi_demo.ddr", src)
    assert(m.ok && m.diagnostics.len == 0)
    assert(m.items[1].kind == .ExternType && m.items[1].is_opaque && m.items[1].is_extern)
    assert(m.items[2].kind == .TypeAlias && m.items[2].ret_type >= 0)
    assert(m.items[3].kind == .Struct && m.attrs[m.items[3].first_attr].arg_count == 2)
    assert(m.items[4].kind == .Union && m.items[4].member_count == 2)
    assert(m.items[5].kind == .Enum && m.members[m.items[5].first_member + 1].discriminant_expr >= 0)
    assert(m.items[6].kind == .ExternBlock && m.items[6].abi == "C" && m.items[6].child_count == 2)
    ext_fn_id := m.id_lists[m.items[6].first_child]
    ext_st_id := m.id_lists[m.items[6].first_child + 1]
    assert(m.items[ext_fn_id].kind == .ExternFn && m.items[ext_fn_id].parent_item == 6 && m.params[m.items[ext_fn_id].first_param + 1].is_variadic)
    assert(m.types[m.params[m.items[ext_fn_id].first_param].ty].kind == .RawConst)
    assert(m.items[ext_st_id].kind == .ExternStatic && m.items[ext_st_id].is_mut && m.items[ext_st_id].parent_item == 6)
    cb_idx := ext_st_id + 1
    assert(m.items[cb_idx].kind == .Fn && m.items[cb_idx].is_extern && m.items[cb_idx].abi == "C" && m.items[cb_idx].body_expr >= 0)
    demo_idx := cb_idx + 1
    assert(m.items[demo_idx].from_count == 1 && m.from_sources[m.items[demo_idx].first_from].root_name == "xs")
    demo_blk := &m.exprs[m.items[demo_idx].body_expr]
    assert(demo_blk.child_count == 2 && demo_blk.extra >= 0)
    reg_stmt := &m.stmts[m.id_lists[demo_blk.first_child + 1]]
    assert(reg_stmt.kind == .Region && reg_stmt.name == "scratch" && reg_stmt.cap_expr >= 0)
}
