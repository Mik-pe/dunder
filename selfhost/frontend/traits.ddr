import frontend_types as ft
import ..tasks.task_data as task_data
import ..tasks.task_certify as tc

pub fn sendable_id() -> i32 { 0 }
pub fn storable_id() -> i32 { 1 }
pub fn clone_id() -> i32 { 2 }
pub fn copy_id() -> i32 { 3 }
pub fn iterator_id() -> i32 { 4 }
pub fn builtin_count() -> i32 { 5 }
pub fn is_builtin(id: i32) -> bool { id >= 0 && id < builtin_count() }

pub struct Table {
    by_name: Map<string, i64>,
    names: []string,
    owners: []i32,
    public: []bool,
    sites: []i32,
    super_starts: []i32,
    super_counts: []i32,
    super_tokens: []i32,
    super_ids: []i32,
    method_starts: []i32,
    method_counts: []i32,
    method_names: []string,
    method_sig_starts: []i32,
    method_sig_ends: []i32,
    method_body_starts: []i32,
    method_body_ends: []i32,
    method_sites: []i32,
    method_unsafe: []bool,

    impl_trait_names: []string,
    impl_trait_tokens: []i32,
    impl_trait_ids: []i32,
    impl_target_tokens: []i32,
    impl_types: []i32,
    impl_owners: []i32,
    impl_sites: []i32,
    impl_conditional: []bool,
    impl_active: []bool,
    impl_fn_starts: []i32,
    impl_fn_counts: []i32,
    impl_fns: []i32,

    impl_cond_starts: []i32,
    impl_cond_counts: []i32,
    cond_types: []i32,
    cond_traits: []string,

    conformances: Map<string, i64>,
    conformance_traits: []i32,
    conformance_types: []i32,
    sendable_ok: []bool,
    sendable_reasons: []i32,
}

pub fn new() -> Table {
    mut by_name := Map<string, i64>::new()
    by_name.put("Sendable", 0)
    by_name.put("Storable", 1)
    by_name.put("Clone", 2)
    by_name.put("Copy", 3)
    by_name.put("Iterator", 4)
    Table {
        by_name: by_name,
        names: ["Sendable", "Storable", "Clone", "Copy", "Iterator"],
        owners: [-1, -1, -1, -1, -1],
        public: [true, true, true, true, true],
        sites: [0, 0, 0, 0, 0],
        super_starts: [0, 0, 0, 0, 0],
        super_counts: [0, 0, 0, 0, 0],
        super_tokens: [],
        super_ids: [],
        method_starts: [0, 0, 0, 0, 0],
        method_counts: [0, 0, 0, 0, 0],
        method_names: [],
        method_sig_starts: [],
        method_sig_ends: [],
        method_body_starts: [],
        method_body_ends: [],
        method_sites: [],
        method_unsafe: [],
        impl_trait_names: [],
        impl_trait_tokens: [],
        impl_trait_ids: [],
        impl_target_tokens: [],
        impl_types: [],
        impl_owners: [],
        impl_sites: [],
        impl_conditional: [],
        impl_active: [],
        impl_fn_starts: [],
        impl_fn_counts: [],
        impl_fns: [],
        impl_cond_starts: [],
        impl_cond_counts: [],
        cond_types: [],
        cond_traits: [],
        conformances: Map<string, i64>::new(),
        conformance_traits: [],
        conformance_types: [],
        sendable_ok: [],
        sendable_reasons: [],
    }
}

pub fn lookup(t: &Table, name: string) -> i32 {
    i32(t.by_name.get_or(name, -1))
}

pub fn add_trait(t: &mut Table, move name: string, owner: i32, public: bool, site: i32) -> i32 {
    id := t.names.len
    t.by_name.put(name.clone(), i64(id))
    t.names.push(move name)
    t.owners.push(owner)
    t.public.push(public)
    t.sites.push(site)
    t.super_starts.push(t.super_tokens.len)
    t.super_counts.push(0)
    t.method_starts.push(t.method_names.len)
    t.method_counts.push(0)
    id
}

pub fn add_super_token(t: &mut Table, trait_id: i32, token: i32) {
    t.super_tokens.push(token)
    t.super_ids.push(-1)
    t.super_counts[trait_id] = t.super_counts[trait_id] + 1
}

pub fn has_method_name(t: &Table, trait_id: i32, name: string) -> bool {
    first := t.method_starts[trait_id]
    for i in first..first + t.method_counts[trait_id] {
        if t.method_names[i] == name { return true }
    }
    false
}

pub fn add_method(t: &mut Table, trait_id: i32, move name: string, sig_start: i32, sig_end: i32, body_start: i32, body_end: i32, site: i32, is_unsafe: bool) {
    t.method_names.push(move name)
    t.method_sig_starts.push(sig_start)
    t.method_sig_ends.push(sig_end)
    t.method_body_starts.push(body_start)
    t.method_body_ends.push(body_end)
    t.method_sites.push(site)
    t.method_unsafe.push(is_unsafe)
    t.method_counts[trait_id] = t.method_counts[trait_id] + 1
}

pub fn add_impl(t: &mut Table, move trait_name: string, trait_token: i32, target_token: i32,
    owner: i32, site: i32, conditional: bool) -> i32 {
    id := t.impl_trait_names.len
    t.impl_trait_names.push(move trait_name)
    t.impl_trait_tokens.push(trait_token)
    t.impl_trait_ids.push(-1)
    t.impl_target_tokens.push(target_token)
    t.impl_types.push(-1)
    t.impl_owners.push(owner)
    t.impl_sites.push(site)
    t.impl_conditional.push(conditional)
    t.impl_active.push(false)
    t.impl_fn_starts.push(t.impl_fns.len)
    t.impl_fn_counts.push(0)
    t.impl_cond_starts.push(t.cond_types.len)
    t.impl_cond_counts.push(0)
    id
}

pub fn add_impl_fn(t: &mut Table, impl_id: i32, fn_id: i32) {
    t.impl_fns.push(fn_id)
    t.impl_fn_counts[impl_id] = t.impl_fn_counts[impl_id] + 1
}

pub fn add_impl_cond(t: &mut Table, impl_id: i32, ty: i32, move trait_name: string) {
    t.cond_types.push(ty)
    t.cond_traits.push(move trait_name)
    t.impl_cond_counts[impl_id] = t.impl_cond_counts[impl_id] + 1
}

pub fn conformance_key(trait_id: i32, ty: i32) -> string {
    trait_id.str() + ":" + ty.str()
}

pub fn record_conformance(t: &mut Table, trait_id: i32, ty: i32, impl_id: i32) -> bool {
    key := conformance_key(trait_id, ty)
    if t.conformances.contains(key) { return false }
    t.conformances.put(move key, i64(impl_id))
    t.conformance_traits.push(trait_id)
    t.conformance_types.push(ty)
    true
}

pub struct SendableState { ok: bool, accepted: []bool, reasons: []i32 }
pub fn compute_sendable(reg: &ft.TypeRegistry) -> SendableState {
    mut ws := task_data.new()
    if !tc.analyze_sendable(&reg, &mut ws) { return SendableState { ok: false, accepted: [], reasons: [] } }
    n := reg.declared.type_kinds.len + reg.body.type_kinds.len
    mut accepted: []bool = []; mut reasons: []i32 = []
    accepted.reserve(n); reasons.reserve(n)
    for ty in 0..n {
        accepted.push(task_data.is_data(&ws, ty))
        reasons.push(task_data.reason(&ws, ty))
    }
    SendableState { ok: true, accepted: accepted, reasons: reasons }
}
pub fn apply_sendable(t: &mut Table, move state: SendableState) -> bool {
    if !state.ok { return false }
    t.sendable_ok = move state.accepted
    t.sendable_reasons = move state.reasons
    true
}

pub fn satisfies(t: &Table, reg: &ft.TypeRegistry, trait_id: i32, ty: i32) -> bool {
    if trait_id == 0 {
        return ty >= 0 && ty < t.sendable_ok.len && t.sendable_ok[ty]
    }
    if trait_id == 1 {
        return ft.array_element(&reg, ty)
    }
    if trait_id == 2 {
        return ft.array_element(&reg, ty) && ft.cloneable(&reg, ty)
    }
    if trait_id == 3 {
        return ft.array_element(&reg, ty) && !ft.move_only(&reg, ty) && !ft.has_closure(&reg, ty)
    }
    t.conformances.contains(conformance_key(trait_id, ty))
}

pub fn sendable_reason(t: &Table, ty: i32) -> string {
    if ty >= 0 && ty < t.sendable_reasons.len {
        text := task_data.reason_text(t.sendable_reasons[ty])
        if text != "" { return text }
    }
    "type is not Sendable"
}

pub fn has_super_cycle(t: &Table) -> i32 {
    n := t.names.len
    mut state: []i32 = []
    for _ in 0..n { state.push(0) }
    for start in builtin_count()..n {
        if state[start] != 0 { continue }
        mut stack_node: []i32 = [start]
        mut stack_edge: []i32 = [0]
        state[start] = 1
        while stack_node.len > 0 {
            top := stack_node.len - 1
            node := stack_node[top]
            edge := stack_edge[top]
            if edge >= t.super_counts[node] {
                state[node] = 2
                _ := stack_node.pop(); _ := stack_edge.pop()
                continue
            }
            stack_edge[top] = edge + 1
            next := t.super_ids[t.super_starts[node] + edge]
            if next < 0 { continue }
            if state[next] == 1 { return start }
            if state[next] == 0 {
                state[next] = 1
                stack_node.push(next); stack_edge.push(0)
            }
        }
    }
    -1
}
