// The argument slots contain already evaluated, type-checked values. Borrow
// refresh and ownership transfer precede this boundary in source order.
import ..backend.arm64 as arm
import ..backend.backend_row as row

// The saved frame pointer and link precede incoming 16-byte argument slots.
// Large argument lists exceed the unsigned 12-bit scaled load displacement.
pub fn load_stack_argument(code: &mut arm.Code, index: i32) {
    offset := 16 + index * 16
    if offset <= 32760 { arm.transfer(&mut code, true, 0, 29, 3, offset) }
    else {
        arm.imm(&mut code, 0, i64(offset))
        arm.integer_binary(&mut code, 1, true, false, 0, 29, 0, -1)
        arm.transfer(&mut code, true, 0, 0, 3, 0)
    }
}

pub fn lower(code: &mut arm.Code, label: i32, address_slot: i32, wasm_signature: i32,
    arguments: &[]i32, signature: i32, result: i32, source_offset: i32) {
    if code.checking { return }
    if code.mir_capture {
        arm.barrier(&mut code)
        if address_slot < 0 { code.at.push(code.words.len); code.target.push(label); code.kinds.push(1) }
        code.words.push(row.callable(address_slot >= 0, arguments.len, source_offset))
        code.words.push(i64(signature).shl(32).bit_or(i64(result)))
        if address_slot >= 0 { code.words.push(i64(wasm_signature + 1).shl(32).bit_or(i64(address_slot))) }
        mut packed: i64 = 0
        for arg in 0..arguments.len {
            packed = packed.bit_or(i64(arguments[arg]).shl((arg % 4) * 16))
            if arg % 4 == 3 || arg + 1 == arguments.len { code.words.push(packed); packed = 0 }
        }
        return
    }
    mut count := arguments.len
    while count > 8 {
        count = count - 1
        arm.load(&mut code, arguments[count]); arm.push(&mut code, 0)
    }
    if address_slot >= 0 { arm.load_into(&mut code, address_slot, 16) }
    for i in 0..count { arm.load_into(&mut code, arguments[i], i) }
    if wasm_signature >= 0 { arm.emit(&mut code, 4211081216 + i64(wasm_signature)) }
    else if address_slot >= 0 { arm.emit(&mut code, 3594453504) }
    else { arm.branch(&mut code, label, 1) }
    for i in 8..arguments.len { arm.pop(&mut code, 9) }
}
