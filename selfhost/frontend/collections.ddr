import lexer
import ..bundled
import ..opt.scalar_rules as rules
import std.bytes as bytes
import std.map as map

pub struct Layout { first: i32, starts: []i32, positions: []i32, end: i32 }
pub fn layout() -> Layout { Layout {first:-1, starts:[], positions:[], end:-1} }
pub fn generated(layout: &Layout, position: i32) -> bool {
    layout.first >= 0 && position >= layout.first && position < layout.end
}
pub fn origin(layout: &Layout, position: i32) -> i32 {
    if !generated(&layout, position) { return position }
    mut index := layout.starts.len - 1
    while index > 0 && layout.starts[index] > position { index -= 1 }
    layout.positions[index]
}

struct Plan {
    index: map.Map, names: []string, backings: []string, positions: []i32,
    args: lexer.Tokens, keys: []i32, values: []i32, ends: []i32, error: string, at: i32,
}
struct Use { comma: i32, end: i32, assignment: bool }

fn symbol(input: &lexer.Tokens, at: i32, spelling: string) -> bool {
    at >= 0 && at < input.kinds.len && input.kinds[at] == .Symbol && input.texts[at] == spelling
}
fn candidate(input: &lexer.Tokens, at: i32) -> bool {
    input.kinds[at] == .Name && (input.texts[at] == "Map" || input.texts[at] == "Set") && symbol(&input, at + 1, "<")
}
fn arguments(input: &lexer.Tokens, first: i32, limit: i32) -> Use {
    missing := Use { comma: -1, end: -1, assignment: false }
    mut groups := 0
    mut angles := 0
    mut comma := -1
    for at in first..limit {
        if input.kinds[at] != .Symbol { continue }
        word := &input.texts[at]
        if word == "(" || word == "[" { groups += 1 }
        else if word == ")" || word == "]" {
            if groups == 0 { return missing }
            groups -= 1
        } else if word == "<" { angles += 1 }
        else if word == ">" || word == ">=" {
            if angles == 0 && groups == 0 { return Use {comma:comma, end:at, assignment:word == ">="} }
            if angles > 0 && word == ">" { angles -= 1 } else { return missing }
        } else if word == "," && angles == 0 && groups == 0 {
            comma = if comma == -1 { at } else { -2 }
        } else if word == "{" || word == "}" || word == "=" || word == ":=" || (word == ";" && groups == 0) {
            return missing
        }
    }
    missing
}

fn token(out: &mut lexer.Tokens, kind: lexer.Kind, spelling: string, position: i32) {
    out.kinds.push(kind); out.texts.push(spelling.clone()); out.starts.push(position)
}
fn parameter_borrows(input: &lexer.Tokens, at: i32) -> bool {
    if symbol(&input, at, "[") { return true }
    if input.kinds[at] != .Name { return false }
    word := &input.texts[at]
    if word == "string" { return true }
    for value in ["i32", "i64", "u8", "u16", "u32", "u64", "usize", "bool", "rune", "f32", "f64", "ptr", "range", "TaskID", "extern"] {
        if word == value { return false }
    }
    true
}
fn closing(input: &lexer.Tokens, first: i32, end: i32, open: string, close: string) -> i32 {
    mut depth := 1
    for i in first + 1..end {
        if symbol(&input, i, open) { depth += 1 }
        if symbol(&input, i, close) {
            depth -= 1
            if depth == 0 { return i }
        }
    }
    end
}
fn type_end(input: &lexer.Tokens, first: i32, end: i32, depth: i32) -> i32 {
    if first >= end || depth >= 128 { return first }
    if symbol(&input, first, "&") {
        base := if first + 1 < end && input.texts[first + 1] == "mut" { first + 2 } else { first + 1 }
        return type_end(&input, base, end, depth + 1)
    }
    if symbol(&input, first, "[") {
        close := closing(&input, first, end, "[", "]")
        if close == first + 1 { return type_end(&input, close + 1, end, depth + 1) }
        return if close < end { close + 1 } else { end }
    }
    if symbol(&input, first, "(") && symbol(&input, first + 1, ")") { return first + 2 }
    call := if input.texts[first] == "extern" { first + 1 } else { first }
    if call < end && input.texts[call] == "fn" && symbol(&input, call + 1, "(") {
        close := closing(&input, call + 1, end, "(", ")")
        if close >= end { return end }
        if !symbol(&input, close + 1, "->") { return close + 1 }
        result := type_end(&input, close + 2, end, depth + 1)
        if result + 1 < end && input.texts[result] == "from" && input.kinds[result + 1] == .Integer { return result + 2 }
        return result
    }
    if symbol(&input, first + 1, "<") {
        close := closing(&input, first + 1, end, "<", ">")
        return if close < end { close + 1 } else { end }
    }
    first + 1
}
// Collection identity uses the same implicit read parameters as ordinary
// Dunder callables. Keep the original spelling for the generated declaration.
fn callable(out: &mut []u8, input: &lexer.Tokens, fn_at: i32, end: i32, foreign: bool) -> i32 {
    close := closing(&input, fn_at + 1, end, "(", ")")
    if close >= end { return fn_at }
    mut cursor := fn_at + 2
    mut parts: []string = []
    mut shared := -1
    while cursor < close {
        moving := input.texts[cursor] == "move"
        first := if moving { cursor + 1 } else { cursor }
        after := type_end(&input, first, close, 0)
        if after <= first || (after < close && !symbol(&input, after, ",")) { return fn_at }
        mut prefix := ""
        implicit := !foreign && parameter_borrows(&input, first)
        by_ref := symbol(&input, first, "&")
        if moving && (implicit || foreign || by_ref) { prefix = "move " }
        else if !moving && implicit { prefix = "& " }
        if !moving && (implicit || (by_ref && input.texts[first + 1] != "mut")) {
            shared = if shared == -1 { parts.len + 1 } else { -2 }
        }
        parts.push(prefix + spelling(&input, first, after))
        cursor = after + 1
    }
    mut result := "()"
    mut next := close + 1
    mut source := ""
    if symbol(&input, next, "->") {
        first := next + 1
        next = type_end(&input, first, end, 0)
        if next <= first { return fn_at }
        if !(next == first + 2 && symbol(&input, first, "(") && symbol(&input, first + 1, ")")) {
            result = spelling(&input, first, next)
        }
        if !foreign && symbol(&input, first, "&") {
            if next + 1 < end && input.texts[next] == "from" && input.kinds[next + 1] == .Integer {
                source = input.texts[next + 1].clone()
                next += 2
            } else if shared > 0 { source = shared.str() }
        }
    }
    bytes.append_utf8(&mut out, "fn(")
    for i in 0..parts.len {
        if i > 0 { bytes.append_utf8(&mut out, ", ") }
        bytes.append_utf8(&mut out, parts[i])
    }
    bytes.append_utf8(&mut out, ") -> " + result)
    if source != "" { bytes.append_utf8(&mut out, " from " + source) }
    next
}
fn spelling(input: &lexer.Tokens, first: i32, end: i32) -> string {
    mut out: []u8 = []
    mut i := first
    while i < end {
        if i > first { out.push(32) }
        if input.texts[i] == "fn" && symbol(&input, i + 1, "(") {
            foreign := i > first && input.texts[i - 1] == "extern"
            next := callable(&mut out, &input, i, end, foreign)
            if next > i { i = next; continue }
        }
        bytes.append_utf8(&mut out, input.texts[i])
        i += 1
    }
    bytes.decode(&out).value
}
fn copy_tokens(out: &mut lexer.Tokens, input: &lexer.Tokens) {
    for i in 0..input.kinds.len { token(&mut out, input.kinds[i], input.texts[i], input.starts[i]) }
}
fn intern(plan: &mut Plan, family: string, key: &lexer.Tokens, value: &lexer.Tokens, position: i32) -> string {
    key_name := spelling(&key, 0, key.kinds.len)
    mut name := family + "<" + key_name
    if family == "Map" { name = name + ", " + spelling(&value, 0, value.kinds.len) }
    name += ">"
    if plan.index.contains(name) { return name }
    mut backing := ""
    if family == "Set" {
        mut boolean := lexer.empty(false)
        token(&mut boolean, .Name, "bool", position)
        backing = intern(&mut plan, "Map", &key, &boolean, position)
    }
    plan.index.put(name.clone(), i64(plan.names.len))
    plan.names.push(name.clone()); plan.backings.push(move backing); plan.positions.push(position)
    plan.keys.push(plan.args.kinds.len); copy_tokens(&mut plan.args, &key)
    plan.values.push(plan.args.kinds.len); copy_tokens(&mut plan.args, &value)
    plan.ends.push(plan.args.kinds.len)
    name
}
fn rewrite_use(input: &lexer.Tokens, out: &mut lexer.Tokens, plan: &mut Plan, at: i32, limit: i32,
    self_type: string, depth: i32) -> i32 {
    use := arguments(&input, at + 2, limit)
    if use.end < 0 { return at }
    family := &input.texts[at]
    position := input.starts[at]
    if depth >= 128 {
        plan.error = "collection type nesting exceeds 128"; plan.at = position; return limit
    }
    mut key_end := use.end
    if use.comma >= 0 { key_end = use.comma }
    if use.comma == -2 || (use.comma >= 0) != (family == "Map") || key_end == at + 2 || use.comma + 1 == use.end {
        plan.error = if family == "Map" { "Map expects a key and a value type" } else { "Set expects one element type" }
        plan.at = position
        return limit
    }
    key := normalize(&input, &mut plan, at + 2, key_end, self_type, depth + 1)
    mut value := lexer.empty(false)
    if family == "Map" { value = normalize(&input, &mut plan, use.comma + 1, use.end, self_type, depth + 1) }
    if key.kinds.len == 0 || (family == "Map" && value.kinds.len == 0) {
        plan.error = "collection type arguments must be types"; plan.at = position; return limit
    }
    if symbol(&key, 0, "&") || symbol(&value, 0, "&") ||
        (symbol(&key, 0, "(") && symbol(&key, 1, ")")) || (symbol(&value, 0, "(") && symbol(&value, 1, ")")) {
        plan.error = "collection keys and values must be storable values"; plan.at = position; return limit
    }
    name := intern(&mut plan, family, &key, &value, position)
    token(&mut out, .Name, name, position)
    if use.assignment { token(&mut out, .Symbol, "=", input.starts[use.end] + 1) }
    use.end + 1
}
fn normalize(input: &lexer.Tokens, plan: &mut Plan, first: i32, end: i32, self_type: string, depth: i32) -> lexer.Tokens {
    mut out := lexer.empty(false)
    mut at := first
    while at < end && plan.error == "" {
        if candidate(&input, at) {
            after := rewrite_use(&input, &mut out, &mut plan, at, end, self_type, depth)
            if after > at { at = after; continue }
        }
        kind := input.kinds[at]
        if !lexer.is_newline(kind) {
            mut word := input.texts[at].clone()
            if kind == .Name && word == "Self" && self_type != "" { word = self_type.clone() }
            if kind == .Integer {
                integer := rules.literal_integer(word)
                if integer.ok { word = integer.value.str() }
            }
            token(&mut out, kind, word, input.starts[at])
        }
        at += 1
    }
    out
}

fn hash_helpers(key: string) -> string {
    header := "fn spec_hash(key: SpecKey) -> u64 { "
    equal := "\nfn spec_equal(a: SpecKey, b: SpecKey) -> bool { a == b }\n"
    if key == "string" {
        return header + "mut hash: u64 = 0; for byte in key.bytes() { hash = hash.wrapping_mul(131).wrapping_add(u64(byte)) }; hash }" + equal
    }
    if key == "bool" { return header + "if key { 1 } else { 0 } }" + equal }
    mut integer := ""
    if key == "i32" || key == "i64" { integer = "u64(i64(key).bit_and(9223372036854775807))" }
    else if key == "rune" { integer = "u64(i32(key))" }
    else if key == "u8" || key == "u16" || key == "u32" || key == "u64" || key == "usize" { integer = "u64(key)" }
    if integer != "" {
        return header + "n := " + integer + "; mixed := n.bit_xor(n.shr(32)).wrapping_mul(11400714819323198485); mixed.bit_xor(mixed.shr(32)) }" + equal
    }
    header + "key.key_hash() }\nfn spec_equal(a: SpecKey, b: SpecKey) -> bool { a.key_eq(b) }\n"
}
fn argument(out: &mut lexer.Tokens, input: &lexer.Tokens, first: i32, end: i32, position: &mut i32) {
    for i in first..end {
        token(&mut out, input.kinds[i], input.texts[i], position)
        position += 1
    }
}
fn instantiate(out: &mut lexer.Tokens, plan: &Plan, serial: i32, position: &mut i32) {
    key := plan.keys[serial]; value := plan.values[serial]
    mut source := bundled.collection_template("set")
    if plan.backings[serial] == "" {
        source = hash_helpers(spelling(&plan.args, key, value)) + bundled.collection_template("map")
    }
    body := lexer.scan(source, false)
    assert(body.ok)
    suffix := serial.str()
    for i in 0..body.kinds.len - 1 {
        mut word := body.texts[i].clone()
        if body.kinds[i] == .Name {
            if word == "SpecKey" { argument(&mut out, &plan.args, key, value, &mut position); continue }
            if word == "SpecValue" { argument(&mut out, &plan.args, value, plan.ends[serial], &mut position); continue }
            if word == "SpecEntry" { word = "__dunder_module_collection_entry_" + suffix }
            else if word == "SpecBacking" { word = plan.backings[serial].clone() }
            else if word == "SpecMap" || word == "SpecSet" { word = plan.names[serial].clone() }
            else if word == "spec_hash" || word == "spec_equal" { word = "__dunder_module_collection_" + word + suffix }
        }
        token(&mut out, body.kinds[i], word, position)
        position += 1
    }
}

pub fn specialize(input: &mut lexer.Tokens) -> Layout {
    mut result := layout()
    eof := input.kinds.len - 1
    mut first := 0
    while first < eof && !candidate(&input, first) { first += 1 }
    if first == eof { return result }
    mut plan := Plan {index:map.new(), names:[], backings:[], positions:[], args:lexer.empty(false),
        keys:[], values:[], ends:[], error:"", at:0}
    mut output := lexer.empty(false)
    mut at := 0
    mut level := 0
    mut self_type := ""
    while at < eof && plan.error == "" {
        if level == 0 && input.kinds[at] == .Keyword && input.texts[at] == "impl" && input.kinds[at + 1] == .Name {
            self_type = input.texts[at + 1].clone()
        }
        if symbol(&input, at, "{") { level += 1 }
        if symbol(&input, at, "}") { level -= 1; if level == 0 { self_type = "" } }
        if candidate(&input, at) {
            next := rewrite_use(&input, &mut output, &mut plan, at, eof, self_type, 0)
            if next > at { at = next; continue }
        }
        token(&mut output, input.kinds[at], input.texts[at], input.starts[at])
        at += 1
    }
    if plan.error != "" {
        input.ok = false; input.error = plan.error.clone(); input.error_at = plan.at
        return result
    }
    if plan.names.len == 0 { return result }
    mut position := input.starts[eof] + 1
    result.first = position
    for i in 0..plan.names.len {
        result.starts.push(position); result.positions.push(plan.positions[i])
        token(&mut output, .Newline, "\n", position)
        position += 1
        instantiate(&mut output, &plan, i, &mut position)
    }
    result.end = position
    token(&mut output, .End, "", position)
    input.kinds = move output.kinds; input.texts = move output.texts; input.starts = move output.starts
    input.ends.clear(); input.ids.clear(); input.intern = false; input.store_ends = false
    result
}
