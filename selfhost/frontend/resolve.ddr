import ..driver.modules
import declarations as decl
import frontend_types as ft
import generics
import lexer
import target_cond as tc_eval
import traits

pub struct ExternBinding {
    prio: i32,
    library: string,
    symbol: string,
    error: string,
}

pub struct LinkSpec {
    prio: i32,
    library: string,
    weak: bool,
    delay: bool,
    version: string,
    error: string,
}

pub fn valid_extern_abi(abi: string) -> bool {
    abi == "C" || abi == "system" || abi == "sysv64" || abi == "win64" || abi == "msvc-com"
}

fn empty_link(error: string) -> LinkSpec {
    LinkSpec { prio: 0, library: "", weak: false, delay: false, version: "", error: error.clone() }
}

pub fn parse_link_attr(tokens: &lexer.Tokens, platform: i32, cursor: &mut i32) -> LinkSpec {
    if !is_tok(&tokens, cursor, "(") { return empty_link("expected '(' after @link") }
    cursor += 1
    skip_nls(&tokens, &mut cursor)
    if cursor >= tokens.kinds.len { return empty_link("unexpected end of @link attribute") }
    mut lib := ""
    mut prio := 0
    mut weak := false
    mut delay := false
    mut version := ""
    mut seen_weak := false
    mut seen_delay := false
    mut seen_version := false
    mut seen_source := false
    while cursor < tokens.kinds.len && !is_tok(&tokens, cursor, ")") {
        k := tokens.kinds[cursor]
        is_kv := (k == .Name || k == .String) && cursor + 1 < tokens.kinds.len && tokens.texts[cursor + 1] == "="
        if !is_kv {
            if k != .String { return empty_link("expected library name or option in @link") }
            val := tokens.texts[cursor].clone(); cursor += 1
            if !valid_foreign_name(val) { return empty_link("invalid library name in @link") }
            seen_source = true
            if 1 > prio { prio = 1; lib = move val }
            else if 1 == prio { return empty_link("duplicate library specification in @link") }
        } else {
            key := tokens.texts[cursor].clone(); cursor += 2
            if cursor >= tokens.kinds.len { return empty_link("expected value in @link") }
            if key == "weak" {
                if seen_weak { return empty_link("duplicate 'weak' in @link") }
                seen_weak = true
                if tokens.texts[cursor] == "true" { weak = true }
                else if tokens.texts[cursor] == "false" { weak = false }
                else { return empty_link("'weak' in @link requires true or false") }
                cursor += 1
            } else if key == "delay" {
                if seen_delay { return empty_link("duplicate 'delay' in @link") }
                seen_delay = true
                if tokens.texts[cursor] == "true" { delay = true }
                else if tokens.texts[cursor] == "false" { delay = false }
                else { return empty_link("'delay' in @link requires true or false") }
                cursor += 1
            } else if key == "version" {
                if seen_version { return empty_link("duplicate 'version' in @link") }
                seen_version = true
                if tokens.kinds[cursor] != .String { return empty_link("'version' in @link requires a string") }
                val := tokens.texts[cursor].clone(); cursor += 1
                if !valid_foreign_name(val) { return empty_link("invalid version in @link") }
                version = move val
            } else if key == "framework" {
                if tokens.kinds[cursor] != .String { return empty_link("'framework' in @link requires a string") }
                val := tokens.texts[cursor].clone(); cursor += 1
                if !valid_foreign_name(val) { return empty_link("invalid framework name in @link") }
                seen_source = true
                if platform == 0 {
                    if 2 > prio { prio = 2; lib = "framework:" + val }
                    else if 2 == prio { return empty_link("duplicate @link binding for this target") }
                }
            } else if key == "default" {
                if tokens.kinds[cursor] != .String { return empty_link("'default' in @link requires a string") }
                val := tokens.texts[cursor].clone(); cursor += 1
                if !valid_foreign_name(val) { return empty_link("invalid library name in @link") }
                seen_source = true
                if 1 > prio { prio = 1; lib = move val }
                else if 1 == prio { return empty_link("duplicate 'default' in @link") }
            } else {
                matched := tc_eval.target_match(platform, key)
                if matched < 0 { return empty_link("unknown @link option or target '" + key + "'") }
                if tokens.kinds[cursor] != .String { return empty_link("expected string value in @link for target '" + key + "'") }
                val := tokens.texts[cursor].clone(); cursor += 1
                if !valid_foreign_name(val) { return empty_link("invalid library name in @link") }
                seen_source = true
                if matched == 1 {
                    p := extern_target_priority(key)
                    if p > prio { prio = p; lib = move val }
                    else if p == prio { return empty_link("duplicate @link binding for this target") }
                }
            }
        }
        skip_nls(&tokens, &mut cursor)
        if !is_tok(&tokens, cursor, ",") { break }
        cursor += 1
        skip_nls(&tokens, &mut cursor)
    }
    if !is_tok(&tokens, cursor, ")") { return empty_link("expected ')'") }
    cursor += 1
    if !seen_source { return empty_link("@link requires a library key, framework, or target mapping") }
    LinkSpec { prio: prio, library: move lib, weak: weak, delay: delay, version: move version, error: "" }
}

pub struct RequiresResult {
    ok: bool,
    mask: i32,
    error: string,
}

fn valid_foreign_name(value: string) -> bool {
    if value.len == 0 { return false }
    for i in 0..value.len { if value[i] == 0 { return false } }
    true
}

fn empty_extern(error: string) -> ExternBinding {
    ExternBinding { prio: 0, library: "", symbol: "", error: error.clone() }
}

pub fn extern_target_priority(target: string) -> i32 {
    if target == "macos" || target == "linux" || target == "windows" || target == "wasi" || target == "arm64" || target == "x86_64" || target == "native" { return 2 }
    3
}

fn is_tok(tokens: &lexer.Tokens, cursor: i32, word: string) -> bool {
    cursor < tokens.kinds.len && tokens.texts[cursor] == word
}

fn skip_nls(tokens: &lexer.Tokens, cursor: &mut i32) {
    while cursor < tokens.kinds.len && lexer.is_newline(tokens.kinds[cursor]) {
        cursor += 1
    }
}

pub fn parse_extern_attr(tokens: &lexer.Tokens, platform: i32, cursor: &mut i32) -> ExternBinding {
    if !is_tok(&tokens, cursor, "(") { return empty_extern("expected '('") }
    cursor += 1
    skip_nls(&tokens, &mut cursor)
    tok := cursor
    if tok >= tokens.kinds.len { return empty_extern("unexpected end of @extern attribute") }
    kind := tokens.kinds[tok]
    is_map := kind == .Name || (kind == .String && tok + 1 < tokens.kinds.len && tokens.texts[tok + 1] == "=")
    if !is_map {
        if kind != .String { return empty_extern("expected an extern library") }
        first_str := tokens.texts[cursor].clone(); cursor += 1
        if !is_tok(&tokens, cursor, ",") { return empty_extern("expected ','") }
        cursor += 1
        if cursor >= tokens.kinds.len || tokens.kinds[cursor] != .String {
            return empty_extern("expected an extern symbol")
        }
        second_str := tokens.texts[cursor].clone(); cursor += 1
        if is_tok(&tokens, cursor, ",") {
            cursor += 1
            if cursor >= tokens.kinds.len || tokens.kinds[cursor] != .String {
                return empty_extern("expected an extern symbol")
            }
            third_str := tokens.texts[cursor].clone(); cursor += 1
            if !is_tok(&tokens, cursor, ")") { return empty_extern("expected ')'") }
            cursor += 1
            matched := tc_eval.target_match(platform, first_str)
            if matched < 0 { return empty_extern("unknown @extern target '" + first_str + "'") }
            if !valid_foreign_name(second_str) || !valid_foreign_name(third_str) {
                return empty_extern("invalid external library or symbol")
            }
            if matched == 0 { return empty_extern("") }
            return ExternBinding {
                prio: extern_target_priority(first_str),
                library: move second_str,
                symbol: move third_str,
                error: "",
            }
        }
        if !is_tok(&tokens, cursor, ")") { return empty_extern("expected ')'") }
        cursor += 1
        if !valid_foreign_name(first_str) || !valid_foreign_name(second_str) {
            return empty_extern("invalid external library or symbol")
        }
        return ExternBinding { prio: 1, library: move first_str, symbol: move second_str, error: "" }
    }
    mut map_sym := ""; mut map_lib := ""; mut map_prio := 0; mut has_symbol := false
    while cursor < tokens.kinds.len && !is_tok(&tokens, cursor, ")") {
        k := tokens.kinds[cursor]
        if k != .Name && k != .String { return empty_extern("expected @extern key") }
        key := tokens.texts[cursor].clone(); cursor += 1
        if !is_tok(&tokens, cursor, "=") { return empty_extern("expected '='") }
        cursor += 1
        if cursor >= tokens.kinds.len || tokens.kinds[cursor] != .String {
            return empty_extern("expected string value in @extern")
        }
        val := tokens.texts[cursor].clone(); cursor += 1
        if key == "symbol" {
            if has_symbol { return empty_extern("duplicate 'symbol' in @extern") }
            has_symbol = true
            if !valid_foreign_name(val) { return empty_extern("invalid external library or symbol") }
            map_sym = move val
        } else if key == "default" {
            if !valid_foreign_name(val) { return empty_extern("invalid external library or symbol") }
            if 1 > map_prio { map_prio = 1; map_lib = move val }
            else if 1 == map_prio { return empty_extern("duplicate 'default' in @extern") }
        } else {
            matched := tc_eval.target_match(platform, key)
            if matched < 0 { return empty_extern("unknown @extern target '" + key + "'") }
            if !valid_foreign_name(val) { return empty_extern("invalid external library or symbol") }
            if matched == 1 {
                prio := extern_target_priority(key)
                if prio > map_prio { map_prio = prio; map_lib = move val }
                else if prio == map_prio { return empty_extern("duplicate @extern binding for this target") }
            }
        }
        skip_nls(&tokens, &mut cursor)
        if !is_tok(&tokens, cursor, ",") { break }
        cursor += 1
        skip_nls(&tokens, &mut cursor)
    }
    if !is_tok(&tokens, cursor, ")") { return empty_extern("expected ')'") }
    cursor += 1
    if !has_symbol { return empty_extern("@extern map requires 'symbol'") }
    if map_prio == 0 { return empty_extern("") }
    ExternBinding { prio: map_prio, library: move map_lib, symbol: move map_sym, error: "" }
}

pub fn parse_requires(tokens: &lexer.Tokens, cursor: &mut i32) -> RequiresResult {
    if !is_tok(&tokens, cursor, "(") {
        return RequiresResult { ok: false, mask: 0, error: "expected '('" }
    }
    cursor += 1
    mut cap_mask := 0
    while cursor < tokens.kinds.len {
        kind := tokens.kinds[cursor]
        word := tokens.texts[cursor].clone()
        bit := if kind == .Name { modules.capability_bit(word) } else { 0 }
        if bit != 0 && bit != 16 && cap_mask.bit_and(bit) == 0 {
            cap_mask = cap_mask.bit_or(bit)
            cursor += 1
        } else {
            return RequiresResult { ok: false, mask: 0, error: modules.invalid_requires_message(kind, word, cap_mask) }
        }
        if is_tok(&tokens, cursor, ")") {
            cursor += 1
            return RequiresResult { ok: true, mask: cap_mask, error: "" }
        }
        if !is_tok(&tokens, cursor, ",") {
            return RequiresResult { ok: false, mask: 0, error: "expected ')' or ',' after @requires capability" }
        }
        cursor += 1
    }
    RequiresResult { ok: false, mask: 0, error: "expected ')'" }
}

pub fn declaration_owner(world: &decl.World, specs: &generics.Layout, offset: i32,
    starts: &[]i32, owners: &[]i32) -> i32 {
    if generics.generated(&specs, offset) { return world.module_caps.len }
    mut lo := 0; mut hi := starts.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if starts[mid] <= offset { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return 0 }; owners[lo - 1]
}

pub fn valid_trait_target(types: &ft.TypeRegistry, ty: i32) -> bool {
    if ty < 1 { return false }
    if ty < 13 || ty == 15 || ty == 16 || ty == 17 || ty == 18 { return true }
    kind := ft.type_kind(&types, ty)
    kind == 1 || kind == 2 || kind == 3 || kind == 6 || kind == 7
}

pub fn check_function_caps_msg(world: &decl.World, current_owner: i32, f: i32) -> string {
    req := world.requires_caps[f]
    if req == 0 { return "" }
    mut granted := 0
    if current_owner >= 0 && current_owner < world.module_caps.len {
        granted = world.module_caps[current_owner]
    }
    missing := req.bit_and(granted.bit_xor(15))
    if missing == 0 { return "" }
    modules.missing_capability_message(missing, granted != 0)
}

pub fn check_impl_access_msg(world: &decl.World, types: &ft.TypeRegistry, current_owner: i32, f: i32) -> string {
    if ft.cleanup_method(&types, world.impl_types[f]) == f {
        return "resource cleanup methods are called automatically"
    }
    if !world.impl_public[f] && world.function_owners[f] != current_owner {
        return "method '" + world.impl_names[f] + "' is private; export it with pub"
    }
    check_function_caps_msg(&world, current_owner, f)
}

pub fn opaque_access_msg(types: &ft.TypeRegistry, current_owner: i32, ty: i32) -> string {
    owner := ft.declaring_owner(&types, ty)
    if owner >= 0 && owner != current_owner {
        return "an opaque struct can only be constructed or opened by its defining module"
    }
    ""
}

pub fn trait_method_mismatch_msg(world: &decl.World, types: &ft.TypeRegistry, req_name: string,
    found: i32, expected_has_self: bool, expected_sig: i32, req_unsafe: bool) -> string {
    if expected_sig < 0 || world.impl_has_self[found] != expected_has_self || world.ffi_types[found] != expected_sig {
        exp_text := if expected_sig >= 0 { ft.type_spelling(&types, expected_sig) } else { "trait requirement" }
        return "trait method '" + req_name + "' signature does not match trait requirement " + exp_text
    }
    if world.unsafe_functions[found] != req_unsafe {
        if req_unsafe {
            return "trait method '" + req_name + "' must be declared unsafe"
        }
        return "trait method '" + req_name + "' must be safe"
    }
    ""
}

pub fn satisfies_trait_cond(trait_table: &traits.Table, t: &ft.TypeRegistry, arg_ty: i32, trait_name: string) -> bool {
    cid := traits.lookup(&trait_table, trait_name)
    cid >= 0 && traits.satisfies(&trait_table, &t, cid, arg_ty)
}
