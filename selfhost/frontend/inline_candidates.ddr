import declarations as decl
import frontend_types as ft
import lexer
import scalar_rules as rules

pub fn signature(world: &decl.World, types: &ft.TypeRegistry, f: i32) -> bool {
    if world.libraries[f] != "" || world.test_functions[f] || world.unsafe_functions[f] ||
        world.param_counts[f] > 8 || world.returns[f] < 0 || world.returns[f] > 3 || world.ends[f] - world.starts[f] + 2 > 192 {
        return false
    }
    first := world.param_starts[f]
    for p in 0..world.param_counts[f] {
        if world.param_mutable[first + p] || (p == 0 && world.impl_self_mut[f]) { return false }
        if ft.scalar_type(&types, world.param_types[first + p]) < 1 { return false }
    }
    true
}

pub fn body_bound(tokens: &lexer.Tokens, first: i32, end: i32) -> i32 {
    mut nodes := 0
    mut prev_dot := false
    for token in first..end {
        kind := tokens.kinds[token]
        if lexer.is_newline(kind) { continue }
        word := &tokens.texts[token]
        if kind == .Integer {
            if prev_dot { return 0 }
            nodes += 1
        } else if kind == .Keyword {
            if prev_dot { return 0 }
            if word == "return" || word == "true" || word == "false" || word == "if" || word == "while" ||
                word == "for" || word == "break" || word == "continue" {
                nodes += 1
            } else if word != "mut" && word != "else" && word != "in" && word != "i8" && word != "i16" && word != "i32" && word != "i64" && word != "isize" && word != "bool" {
                return 0
            }
        } else if kind == .Name {
            next := &tokens.texts[token + 1]
            if next == "(" || next == "::" { return 0 }
            if prev_dot {
                if word != "len" { return 0 }
                prev_dot = false
            }
            nodes += 1
        } else if kind == .Symbol {
            if prev_dot { return 0 }
            if word == "." { prev_dot = true }
            else if word == "[" { nodes += 1 }
            else if word == ":=" || word == "=" || word == "+=" || word == "-=" || word == "*=" || word == "/=" || word == "%=" {
                nodes += 2
            } else if word == "(" || word == ")" || word == "{" || word == "}" || word == ";" || word == ":" || word == "]" || word == ".." {
                continue
            } else if word == "!" || rules.opcode(word.clone()) != 0 {
                nodes += 1
            } else { return 0 }
        } else { return 0 }
        if nodes > 126 { return 0 }
    }
    if prev_dot || nodes <= 0 { return 0 }
    nodes + 2
}

fn next_token(t: &lexer.Tokens, cursor: &mut i32, end: i32) -> i32 {
    while cursor < end && lexer.is_newline(t.kinds[cursor]) { cursor += 1 }
    at := cursor
    if cursor < end { cursor += 1 }
    at
}

fn consume(t: &lexer.Tokens, cursor: &mut i32, end: i32, kind: lexer.Kind, word: string) -> bool {
    at := next_token(&t, &mut cursor, end)
    at < end && t.kinds[at] == kind && t.texts[at] == word
}

pub fn enum_predicate(world: &decl.World, types: &ft.TypeRegistry, f: i32) -> i32 {
    if !world.impl_has_self[f] || world.param_counts[f] != 1 || world.returns[f] != 3 || world.unsafe_functions[f] { return 0 }
    ty := world.impl_types[f]
    if ft.type_kind(&types, ty) != 7 || ft.is_npo_option(&types, ty) || ft.type_kind(&types, world.param_types[world.param_starts[f]]) != 4 { return 0 }
    mut i := world.starts[f]
    end := world.ends[f]
    t := &world.tokens
    if end - i > 42 || !consume(t, &mut i, end, .Keyword, "match") || !consume(t, &mut i, end, .Name, "self") ||
        !consume(t, &mut i, end, .Symbol, "{") || !consume(t, &mut i, end, .Symbol, ".") { return 0 }
    member := next_token(t, &mut i, end)
    if member >= end || t.kinds[member] != .Name || !consume(t, &mut i, end, .Symbol, "=>") { return 0 }
    yes := next_token(t, &mut i, end)
    if yes >= end || t.kinds[yes] != .Keyword || !consume(t, &mut i, end, .Symbol, ",") ||
        !consume(t, &mut i, end, .Name, "_") || !consume(t, &mut i, end, .Symbol, "=>") { return 0 }
    no := next_token(t, &mut i, end)
    if no >= end || t.kinds[no] != .Keyword { return 0 }
    mut close := next_token(t, &mut i, end)
    if lexer.symbol(t, close, ",") { close = next_token(t, &mut i, end) }
    if close >= end || !lexer.symbol(t, close, "}") || next_token(t, &mut i, end) != end { return 0 }
    field := ft.field(&types, ty, t.texts[member])
    if field < 0 || types.payload_counts[field] != 0 { return 0 }
    if t.texts[yes] == "true" && t.texts[no] == "false" { return field + 1 }
    if t.texts[yes] == "false" && t.texts[no] == "true" { return -(field + 1) }
    0
}

fn integer_type_name(ty: i32) -> string {
    if ty == 1 { return "i32" }
    if ty == 2 { return "i64" }
    if ty == 8 { return "u8" }
    if ty == 9 { return "u16" }
    if ty == 10 { return "u32" }
    if ty == 11 { return "u64" }
    if ty == 12 { return "usize" }
    if ty == 16 { return "i16" }
    if ty == 17 { return "i8" }
    if ty == 18 { return "isize" }
    ""
}

fn enum_fits_integer(types: &ft.TypeRegistry, enum_ty: i32, target_ty: i32) -> bool {
    if ft.is_c_enum(&types, enum_ty) { return false }
    first := ft.type_start(&types, enum_ty)
    count := ft.type_count(&types, enum_ty)
    for i in first..first + count {
        v := types.field_values[i]
        if target_ty == 8 && (v < 0 || v > 255) { return false }
        if target_ty == 9 && (v < 0 || v > 65535) { return false }
        if target_ty == 16 && (v < -32768 || v > 32767) { return false }
        if target_ty == 17 && (v < -128 || v > 127) { return false }
        if (target_ty == 10 || target_ty == 11 || target_ty == 12) && v < 0 { return false }
    }
    true
}

pub fn enum_converter(world: &decl.World, types: &ft.TypeRegistry, f: i32) -> i32 {
    if world.libraries[f] != "" || world.test_functions[f] || world.unsafe_functions[f] || world.param_counts[f] != 1 {
        return 0
    }
    first := world.param_starts[f]
    if world.param_mutable[first] || world.impl_self_mut[f] { return 0 }
    pty := world.param_types[first]
    if ft.type_kind(&types, pty) != 3 { return 0 }
    rty := world.returns[f]
    rname := integer_type_name(rty)
    if rname == "" || !enum_fits_integer(&types, pty, rty) { return 0 }
    mut i := world.starts[f]
    end := world.ends[f]
    t := &world.tokens
    if end - i > 20 { return 0 }
    mut tok := next_token(t, &mut i, end)
    if tok < end && t.kinds[tok] == .Keyword && t.texts[tok] == "return" {
        tok = next_token(t, &mut i, end)
    }
    if tok >= end || t.kinds[tok] != .Name { return 0 }
    pname := &world.param_names[first]
    if rty == 1 {
        if t.texts[tok] != "i32" || !consume(t, &mut i, end, .Symbol, "(") { return 0 }
        arg := next_token(t, &mut i, end)
        if arg >= end || t.kinds[arg] != .Name || t.texts[arg] != pname || !consume(t, &mut i, end, .Symbol, ")") { return 0 }
    } else {
        if t.texts[tok] != rname || !consume(t, &mut i, end, .Symbol, "(") ||
            !consume(t, &mut i, end, .Name, "i32") || !consume(t, &mut i, end, .Symbol, "(") { return 0 }
        arg := next_token(t, &mut i, end)
        if arg >= end || t.kinds[arg] != .Name || t.texts[arg] != pname ||
            !consume(t, &mut i, end, .Symbol, ")") || !consume(t, &mut i, end, .Symbol, ")") { return 0 }
    }
    mut tail := next_token(t, &mut i, end)
    if tail < end && lexer.symbol(t, tail, ";") { tail = next_token(t, &mut i, end) }
    if tail != end { return 0 }
    rty
}
