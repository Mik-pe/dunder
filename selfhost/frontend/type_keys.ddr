pub struct Index {
    declarations: []i32, starts: []i32, arguments: []i32, values: []i32, buckets: []i32,
}

pub fn new() -> Index { Index { declarations: [], starts: [0], arguments: [], values: [], buckets: [] } }

fn hash(declaration: i32, arguments: &[]i32, first: i32, end: i32) -> u32 {
    mut value := u32(declaration).wrapping_add(2166136261)
    for i in first..end { value = value.bit_xor(u32(arguments[i])).wrapping_mul(16777619) }
    value.bit_xor(value.shr(16))
}

fn bucket(index: &Index, declaration: i32, args: &[]i32) -> i32 {
    mask := index.buckets.len - 1
    mut slot := i32(hash(declaration, &args, 0, args.len).bit_and(u32(mask)))
    while index.buckets[slot] != 0 {
        entry := index.buckets[slot] - 1
        first := index.starts[entry]
        if index.declarations[entry] == declaration && index.starts[entry + 1] - first == args.len {
            mut same := true
            for i in 0..args.len { if index.arguments[first + i] != args[i] { same = false; break } }
            if same { return slot }
        }
        slot = (slot + 1).bit_and(mask)
    }
    slot
}

pub fn find(index: &Index, declaration: i32, args: &[]i32) -> i32 {
    if index.buckets.len == 0 { return -1 }
    entry := index.buckets[bucket(&index, declaration, &args)] - 1
    if entry >= 0 { index.values[entry] } else { -1 }
}

pub fn insert(index: &mut Index, declaration: i32, args: &[]i32, value: i32) {
    if (index.values.len + 1) * 2 > index.buckets.len {
        mut size := index.buckets.len * 2
        if size == 0 { size = 16 }
        index.buckets.clear()
        for _ in 0..size { index.buckets.push(0) }
        for i in 0..index.values.len {
            h := hash(index.declarations[i], &index.arguments, index.starts[i], index.starts[i + 1])
            mut slot := i32(h.bit_and(u32(size - 1)))
            while index.buckets[slot] != 0 { slot = (slot + 1).bit_and(size - 1) }
            index.buckets[slot] = i + 1
        }
    }
    slot := bucket(&index, declaration, &args)
    assert(index.buckets[slot] == 0)
    index.declarations.push(declaration); index.values.push(value)
    for arg in &args { index.arguments.push(arg) }
    index.starts.push(index.arguments.len); index.buckets[slot] = index.values.len
}
