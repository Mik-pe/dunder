import lexer
import frontend_types as ft
import type_syntax as syntax

pub fn parameter_mode(reg: &mut ft.TypeRegistry, ty: i32, consume: bool, foreign: bool) -> i32 {
    kind := ft.type_kind(&reg, ty)
    if consume {
        if foreign || kind == 4 || kind == 5 { ft.set_error(&mut reg, move "move parameters require an owned Dunder type") }
        return ty
    }
    if !foreign && (ft.owned(&reg, ty) || kind == 3) { return compound(&mut reg, 4, ty) }
    ty
}
pub fn borrow_source(reg: &mut ft.TypeRegistry, args: &[]i32) -> i32 {
    mut source := -1
    for i in 0..args.len {
        if ft.type_kind(&reg, args[i]) == 4 {
            if source >= 0 {
                ft.set_error(&mut reg, move "ambiguous returned borrow: select one shared input with 'from'")
                return -1
            }
            source = i
        }
    }
    source
}
pub fn compound(reg: &mut ft.TypeRegistry, kind: i32, base: i32) -> i32 {
    found := ft.find_or_check_compound(&mut reg, kind, base)
    if found >= 0 { return found }
    if found == -2 { return 0 }
    ft.insert_compound(&mut reg, kind, base)
}
pub fn fixed(reg: &mut ft.TypeRegistry, platform: i32, base: i32, length: i32) -> i32 {
    found := ft.find_or_check_fixed(&mut reg, platform, base, length)
    if found >= 0 { return found }
    if found == -2 { return 0 }
    ft.insert_fixed(&mut reg, base, length)
}
pub fn callable(reg: &mut ft.TypeRegistry, args: &[]i32, result: i32, kind: i32, source: i32) -> i32 {
    found := ft.find_or_check_callable_abi(&mut reg, &args, result, kind, source)
    if found >= 0 { return found }
    if found == -2 { return 0 }
    ft.insert_callable_abi(&mut reg, &args, result, kind, source)
}
pub fn resolve(reg: &mut ft.TypeRegistry, expr: &syntax.Tree, id: i32, types: &[]i32, platform: i32) -> i32 {
    match expr.forms[id] {
        .Name => {
            word := &expr.names[id]
            ty := if word == "Self" { reg.self_type } else { ft.type_id(&reg, word) }
            if ty >= 0 { return ty }
            if word == "Self" { ft.set_error(&mut reg, move "Self is only valid inside an impl block") }
            else { ft.set_error(&mut reg, move ("unknown type '" + word + "'")) }
        },
        .Apply => {
            if expr.names[id] == "TaskID" && types.len == 1 { return compound(&mut reg, 22, types[0]) }
            ft.set_error(&mut reg, move ("unknown generic type '" + expr.names[id] + "'"))
        },
        .Tuple => { return ft.tuple_type(&mut reg, &types) },
        .Shared => { return compound(&mut reg, 4, types[0]) },
        .Exclusive => { return compound(&mut reg, 5, types[0]) },
        .Array => { return compound(&mut reg, 1, types[0]) },
        .Fixed => {
            mut len := expr.values[id]
            if len < 0 {
                v := reg.const_lengths.get_or(expr.names[id], -1)
                if v < 0 || v > 1048576 {
                    ft.set_error(&mut reg, move ("unknown array length constant '" + expr.names[id] + "'"))
                    return 0
                }
                len = i32(v)
            }
            return fixed(&mut reg, platform, types[0], len)
        },
        .Consume => { return types[0] },
        _ => {
            foreign := expr.forms[id] == .Foreign
            first := expr.starts[id]; result := types[types.len - 1]
            mut args: []i32 = []
            for i in 0..types.len - 1 {
                consumes := expr.forms[expr.children[first + i]] == .Consume
                args.push(parameter_mode(&mut reg, types[i], consumes, foreign))
            }
            mut source := expr.values[id]
            if !foreign && source < 0 && ft.type_kind(&reg, result) == 4 { source = borrow_source(&mut reg, &args) }
            if reg.error == "" { return callable(&mut reg, &args, result, if foreign { 8 } else { 9 }, source) }
        },
    }
    0
}
pub fn read(r: &mut syntax.Cursor, reg: &mut ft.TypeRegistry, t: &lexer.Tokens, platform: i32) -> i32 {
    mut expr := syntax.tree()
    root := syntax.parse(&mut expr, &mut r, &t, 0)
    if root < 0 { return 0 }
    mut resolved: []i32 = []; mut children: []i32 = []
    for node in 0..expr.forms.len {
        children.clear()
        for i in expr.starts[node]..expr.starts[node + 1] { children.push(resolved[expr.children[i]]) }
        resolved.push(resolve(&mut reg, &expr, node, &children, platform))
        if reg.error != "" { r.error_at = expr.positions[node]; r.error = replace(&mut reg.error, ""); return 0 }
    }
    resolved[root]
}
