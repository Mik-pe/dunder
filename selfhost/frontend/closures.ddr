// Lift function literals before declarations are frozen. Generated tokens retain
// the original module offsets, including tokens copied into a lifted body.
import lexer

fn symbol(t: &lexer.Tokens, at: i32, s: string) -> bool {
    at >= 0 && at < t.kinds.len && t.kinds[at] == .Symbol && t.texts[at] == s
}
fn token(out: &mut lexer.Tokens, kind: lexer.Kind, word: string, pos: i32) {
    out.kinds.push(kind); out.texts.push(word.clone()); out.starts.push(pos)
}
fn punct(out: &mut lexer.Tokens, word: string, pos: i32) { token(&mut out, .Symbol, word, pos) }
fn name(out: &mut lexer.Tokens, word: string, pos: i32) { token(&mut out, .Name, word, pos) }
fn copy(src: &lexer.Tokens, out: &mut lexer.Tokens, first: i32, end: i32) {
    for i in first..end { token(&mut out, src.kinds[i], src.texts[i], src.starts[i]) }
}

pub fn candidate(t: &lexer.Tokens, i: i32) -> bool {
    if t.kinds[i] != .Keyword || t.texts[i] != "fn" { return false }
    if symbol(&t, i + 1, "[") { return true }
    if !symbol(&t, i + 1, "(") { return false }
    if symbol(&t, i - 1, "->") || symbol(&t, i - 1, "]") || symbol(&t, i - 1, "&") { return false }
    if i > 0 && t.texts[i - 1] == "extern" { return false }
    // Named parameters distinguish a literal from a structural function type.
    if !symbol(&t, i + 2, ")") {
        mut p := i + 2
        if p < t.kinds.len && t.texts[p] == "mut" { p += 1 }
        if p < t.kinds.len && t.texts[p] == "move" { p += 1 }
        if p < t.kinds.len && t.texts[p] == "mut" { p += 1 }
        return p + 1 < t.kinds.len && t.kinds[p] == .Name && symbol(&t, p + 1, ":")
    }
    true
}
// Scan just the return type, leaving its syntax and semantics to headers().
pub fn body_start(t: &lexer.Tokens, after: i32, last: i32) -> i32 {
    mut i := after
    if symbol(&t, i, "->") {
        i += 1
        mut depth := 0
        mut angles := 0
        while i < last {
            if symbol(&t, i, "{") || symbol(&t, i, "}") { break }
            if symbol(&t, i, "(") || symbol(&t, i, "[") { depth += 1 }
            else if symbol(&t, i, ")") || symbol(&t, i, "]") {
                if depth == 0 { return -1 }
                depth -= 1
            } else if symbol(&t, i, "<") { angles += 1 }
            else if symbol(&t, i, ">") {
                if angles == 0 && depth == 0 { return -1 }
                if angles > 0 { angles -= 1 }
            } else if symbol(&t, i, ",") && depth == 0 && angles == 0 {
                return -1
            } else if depth == 0 && angles == 0 && t.kinds[i] != .Name && t.kinds[i] != .Keyword && t.kinds[i] != .Integer &&
                !symbol(&t, i, ".") && !symbol(&t, i, "->") && !symbol(&t, i, "&") { break }
            i += 1
        }
        if depth != 0 || angles != 0 { return -1 }
    }
    while i < last && lexer.is_newline(t.kinds[i]) { i += 1 }
    if i < last && symbol(&t, i, "{") { return i }
    -1
}

// Columnar storage keeps the pass buildable by the frozen bootstrap compiler.
struct Pass {
    starts: []i32, params: []i32, bodies: []i32, impl_type_starts: []i32, impl_type_ends: []i32, ids: []i32,
    capture_starts: []i32, names: []i32, type_ends: []i32,
}
fn invalid(t: &mut lexer.Tokens, at: i32, message: string) {
    t.ok = false; t.error_at = t.starts[at]; t.error = message.clone()
}
fn captures(t: &mut lexer.Tokens, ends: &[]i32, start: i32, pass: &mut Pass) {
    mut i := start + 2
    until := ends[start + 1]; first := pass.names.len
    while i < until {
        if t.kinds[i] != .Name || !symbol(&t, i + 1, ":") {
            invalid(&mut t, i, "expected a closure capture of the form 'name: Type'"); return
        }
        for n in first..pass.names.len {
            if t.texts[pass.names[n]] == t.texts[i] { invalid(&mut t, i, "duplicate closure capture"); return }
        }
        pass.names.push(i); i += 2
        if i >= until || symbol(&t, i, ",") { invalid(&mut t, i, "expected closure capture type"); return }
        if symbol(&t, i, "&") { invalid(&mut t, i, "a closure cannot store a borrowed reference"); return }
        while i < until && !symbol(&t, i, ",") {
            if ends[i] > i { i = ends[i] }
            i += 1
        }
        pass.type_ends.push(i); i += 1
    }
}
fn body_name(id: i32) -> string { "__dunder_module_lambda_" + id.str() }
fn env_name(id: i32) -> string { "__dunder_module_environment_" + id.str() }
pub fn header() -> string { "__dunder_module_callable" }
fn header_fields(out: &mut lexer.Tokens, pos: i32, initialize: bool) {
    for field in ["__dunder_module_entry", "__dunder_module_drop"] {
        name(&mut out, field, pos); punct(&mut out, ":", pos)
        if initialize { token(&mut out, .Integer, "0", pos) } else { name(&mut out, "i64", pos) }
        punct(&mut out, ",", pos)
    }
}
fn replacement(t: &lexer.Tokens, out: &mut lexer.Tokens, pass: &Pass, id: i32) {
    pos := t.starts[pass.starts[id]]
    first := pass.capture_starts[id]; last := pass.capture_starts[id + 1]
    if first == last { name(&mut out, body_name(id), pos); return }
    name(&mut out, "__dunder_module_bind", pos); punct(&mut out, "(", pos)
    name(&mut out, body_name(id), pos); punct(&mut out, ",", pos)
    name(&mut out, env_name(id), pos); punct(&mut out, "{", pos); header_fields(&mut out, pos, true)
    for idx in first..last {
        at := pass.names[idx]
        copy(&t, &mut out, at, at + 2); copy(&t, &mut out, at, at + 1)
        punct(&mut out, ",", t.starts[at])
    }
    punct(&mut out, "}", pos); punct(&mut out, ")", pos)
}
fn span(t: &lexer.Tokens, out: &mut lexer.Tokens, pass: &Pass, ends: &[]i32, first: i32, end: i32) {
    mut i := first
    while i < end {
        id := pass.ids[i]
        if id >= 0 {
            replacement(&t, &mut out, &pass, id)
            i = ends[pass.bodies[id]] + 1
        } else { copy(&t, &mut out, i, i + 1); i += 1 }
    }
}
fn emit_declaration(t: &lexer.Tokens, out: &mut lexer.Tokens, pass: &Pass, id: i32, ends: &[]i32) {
    pos := t.starts[pass.starts[id]]; params := pass.params[id]; body := pass.bodies[id]
    first := pass.capture_starts[id]; last := pass.capture_starts[id + 1]
    if last > first {
        token(&mut out, .Keyword, "struct", pos); name(&mut out, env_name(id), pos); punct(&mut out, "{", pos)
        header_fields(&mut out, pos, false)
        for n in first..last { copy(&t, &mut out, pass.names[n], pass.type_ends[n]); punct(&mut out, ",", pos) }
        punct(&mut out, "}", pos); token(&mut out, .Newline, "\n", pos)
    }
    token(&mut out, .Keyword, "fn", pos); name(&mut out, body_name(id), pos)
    close := ends[params]; copy(&t, &mut out, params, close)
    if last > first {
        if close > params + 1 && !symbol(&t, close - 1, ",") { punct(&mut out, ",", pos) }
        name(&mut out, "__dunder_module_env", pos); punct(&mut out, ":", pos)
        punct(&mut out, "&", pos); name(&mut out, env_name(id), pos)
    }
    copy(&t, &mut out, close, body + 1)
    for idx in first..last {
        at := pass.names[idx]
        here := t.starts[at]
        copy(&t, &mut out, at, at + 1); punct(&mut out, ":=", here); punct(&mut out, "&", here)
        name(&mut out, "__dunder_module_env", here); punct(&mut out, ".", here)
        copy(&t, &mut out, at, at + 1); punct(&mut out, ";", here)
    }
    span(&t, &mut out, &pass, &ends, body + 1, ends[body] + 1)
    token(&mut out, .Newline, "\n", t.starts[ends[body]])
}
fn declaration(t: &lexer.Tokens, out: &mut lexer.Tokens, pass: &Pass, id: i32, ends: &[]i32) {
    impl_start := pass.impl_type_starts[id]; impl_end_tok := pass.impl_type_ends[id]
    if impl_start < 0 || impl_end_tok <= impl_start {
        emit_declaration(&t, &mut out, &pass, id, &ends)
        return
    }
    first := pass.capture_starts[id]; last := pass.capture_starts[id + 1]
    mut receiver := false
    for idx in first..last { if t.texts[pass.names[idx]] == "self" { receiver = true } }
    mut buf := lexer.empty(false)
    emit_declaration(&t, &mut buf, &pass, id, &ends)
    for at in 0..buf.kinds.len {
        if buf.kinds[at] == .Name && buf.texts[at] == "Self" {
            for k in impl_start..impl_end_tok {
                token(&mut out, t.kinds[k], t.texts[k], buf.starts[at])
            }
        } else if receiver && buf.kinds[at] == .Name && buf.texts[at] == "self" && !symbol(&buf, at - 1, ".") && !symbol(&buf, at + 1, ":") {
            name(&mut out, "__dunder_module_captured_self", buf.starts[at])
        } else {
            token(&mut out, buf.kinds[at], buf.texts[at], buf.starts[at])
        }
    }
}
pub fn lift(t: &mut lexer.Tokens) {
    mut first := 0
    while first < t.kinds.len && !candidate(&t, first) { first += 1 }
    if first == t.kinds.len { return }
    ends := lexer.delimiter_ends(&t, t.kinds.len)
    mut pass := Pass { starts: [], params: [], bodies: [], impl_type_starts: [], impl_type_ends: [], ids: [], capture_starts: [0], names: [], type_ends: [] }
    for i in 0..t.kinds.len { pass.ids.push(-1) }
    mut impl_start := -1; mut impl_end_tok := -1; mut impl_close := -1
    for i in 0..t.kinds.len {
        if i >= impl_close { impl_start = -1; impl_end_tok = -1 }
        if t.kinds[i] == .Keyword && t.texts[i] == "impl" {
            mut scan := i + 1
            while scan < t.kinds.len && lexer.is_newline(t.kinds[scan]) { scan += 1 }
            mut target_start := scan
            mut open := -1
            mut angles := 0
            while scan < t.kinds.len {
                if ends[scan] > scan {
                    if symbol(&t, scan, "{") && angles == 0 { open = scan; break }
                    scan = ends[scan] + 1
                    continue
                }
                if symbol(&t, scan, "<") { angles += 1 }
                else if symbol(&t, scan, ">") && angles > 0 { angles -= 1 }
                else if angles == 0 && t.kinds[scan] == .Keyword && t.texts[scan] == "for" {
                    scan += 1
                    while scan < t.kinds.len && lexer.is_newline(t.kinds[scan]) { scan += 1 }
                    target_start = scan
                    continue
                } else if angles == 0 && (symbol(&t, scan, "}") || symbol(&t, scan, ";") ||
                    (t.kinds[scan] == .Keyword && (t.texts[scan] == "fn" || t.texts[scan] == "struct" || t.texts[scan] == "enum" ||
                    t.texts[scan] == "impl" || t.texts[scan] == "trait" || t.texts[scan] == "const" || t.texts[scan] == "import"))) {
                    break
                }
                scan += 1
            }
            if open >= 0 && ends[open] > open {
                mut target_end := target_start
                mut tangles := 0
                while target_end < open {
                    if ends[target_end] > target_end {
                        target_end = ends[target_end] + 1
                        continue
                    }
                    if symbol(&t, target_end, "<") { tangles += 1 }
                    else if symbol(&t, target_end, ">") && tangles > 0 { tangles -= 1 }
                    else if tangles == 0 && (((t.kinds[target_end] == .Name || t.kinds[target_end] == .Keyword) && t.texts[target_end] == "where") || lexer.is_newline(t.kinds[target_end])) {
                        break
                    }
                    target_end += 1
                }
                if target_end > target_start {
                    impl_start = target_start; impl_end_tok = target_end; impl_close = ends[open]
                }
            }
        }
        if i < first || !candidate(&t, i) { continue }
        mut params := i + 1
        explicit := symbol(&t, params, "[")
        if explicit {
            params = ends[params] + 1
            if !symbol(&t, params, "(") { invalid(&mut t, i, "expected closure parameters after capture list"); return }
        }
        if ends[params] < 0 { continue }
        body := body_start(&t, ends[params] + 1, t.kinds.len)
        if body < 0 || ends[body] < 0 {
            if explicit { invalid(&mut t, i, "expected a closure body"); return }
            continue
        }
        if explicit { captures(&mut t, &ends, i, &mut pass); if !t.ok { return } }
        pass.capture_starts.push(pass.names.len)
        pass.ids[i] = pass.starts.len; pass.starts.push(i); pass.params.push(params); pass.bodies.push(body)
        pass.impl_type_starts.push(impl_start); pass.impl_type_ends.push(impl_end_tok)
    }
    if pass.starts.len == 0 { return }
    mut out := lexer.empty(false)
    eof := t.kinds.len - 1; pos := t.starts[eof]
    span(&t, &mut out, &pass, &ends, 0, eof)
    token(&mut out, .Newline, "\n", pos)
    if pass.names.len > 0 {
        token(&mut out, .Keyword, "struct", pos); name(&mut out, header(), pos)
        punct(&mut out, "{", pos); header_fields(&mut out, pos, false); punct(&mut out, "}", pos)
        token(&mut out, .Newline, "\n", pos)
    }
    for id in 0..pass.starts.len { declaration(&t, &mut out, &pass, id, &ends) }
    copy(&t, &mut out, eof, eof + 1)
    t.kinds = move out.kinds; t.texts = move out.texts; t.starts = move out.starts
    t.ids.clear(); t.ends.clear(); t.intern = false; t.store_ends = false
}
