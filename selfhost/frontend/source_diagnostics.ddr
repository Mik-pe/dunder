import ..driver.modules
import std.text as text
import ..driver.paths as path
import std.bytes as bytes
import ...stdlib.bytes.utf8 as utf8
import lexer
import diagnostics as diag

pub struct Sources {
    token_offsets: bool, paths: []string, texts: []string, symbols: []string,
    starts: []i32, files: []i32, offsets: []i32, json_symbols: []string,
}
pub fn new() -> Sources {
    Sources { token_offsets: true, paths: [], texts: [], symbols: [], starts: [], files: [], offsets: [], json_symbols: [] }
}
fn find_substr(haystack: string, needle: string) -> i32 {
    if needle.len == 0 { return 0 }
    if needle.len > haystack.len { return -1 }
    limit := haystack.len - needle.len + 1
    for i in 0..limit {
        mut ok := true
        for j in 0..needle.len {
            if haystack[i + j] != needle[j] { ok = false; break }
        }
        if ok { return i }
    }
    -1
}
fn path_parts(path: string) -> []string {
    mut parts: []string = []
    for part in text.split(modules.normalize(path), "/") { if part != "" && part != "." { parts.push(part.clone()) } }
    parts
}
fn relative_path(base: string, path: string) -> string {
    from := path_parts(base); to := path_parts(path)
    mut shared := 0
    while shared < from.len && shared < to.len && from[shared] == to[shared] { shared = shared + 1 }
    mut result := ""
    for _ in shared..from.len { result = result + "../" }
    for i in shared..to.len {
        if i > shared { result = result + "/" }
        result = result + to[i]
    }
    if result == "" { return "." }
    result
}
pub fn from_loaded(loaded: &modules.Loaded) -> Sources {
    mut paths := loaded.paths.clone()
    if loaded.path != "" && !path.is_absolute(loaded.path) && paths.len > 0 && path.is_absolute(paths[0]) {
        canonical := path.parent(paths[0]); requested := path.parent(loaded.path)
        for i in 0..paths.len {
            if path.is_absolute(paths[i]) && path.root(canonical) == path.root(paths[i]) {
                paths[i] = modules.normalize(requested + "/" + relative_path(canonical, paths[i]))
            }
        }
    }
    Sources { token_offsets: loaded.token_offsets, paths: paths, texts: loaded.sources.clone(), symbols: loaded.symbols.clone(),
        starts: loaded.map_starts.clone(), files: loaded.map_files.clone(), offsets: loaded.map_offsets.clone(), json_symbols: loaded.json_symbols.clone() }
}
pub fn from_text(source: string) -> Sources {
    if source == "" { return new() }
    Sources { token_offsets: true, paths: ["<source>"], texts: [source.clone()], symbols: [], starts: [0], files: [0], offsets: [], json_symbols: [] }
}
pub fn display_symbol(sources: &Sources, name: string) -> string {
    if text.starts_with(name, "__dunder_module_prelude_") {
        return name[24..name.len]
    }
    if text.starts_with(name, "__dunder_module_") {
        rest := name[16..name.len]
        mut digits := 0
        while digits < rest.len && i32(rest[digits]) >= 48 && i32(rest[digits]) <= 57 { digits += 1 }
        if digits == rest.len && digits > 0 {
            mut id := 0
            for i in 0..digits { id = id * 10 + (i32(rest[i]) - 48) }
            if id >= 0 && id < sources.symbols.len && sources.symbols[id] != "" {
                return sources.symbols[id].clone()
            }
        }
    }
    name.clone()
}

pub fn display_type(sources: &Sources, spelling: string) -> string {
    if !text.contains(spelling, "__dunder_module_") { return spelling.clone() }
    tokens := lexer.scan(spelling, false)
    mut shown := ""
    mut start := 0
    for i in 0..tokens.kinds.len {
        if tokens.kinds[i] != .Name { continue }
        shown += spelling[start..tokens.starts[i]] + display_symbol(&sources, tokens.texts[i])
        start = tokens.ends[i]
    }
    shown + spelling[start..spelling.len]
}

pub fn display_message(sources: &Sources, message: string) -> string {
    prefix := "__dunder_module_"
    if !text.contains(message, prefix) { return message.clone() }
    mut start := 0
    mut result := ""
    while true {
        at := match text.find(message[start..message.len], prefix) { .Some(i) => start + i, .None => break }
        mut end := at + prefix.len
        while end < message.len && lexer.name_byte(i32(message[end])) { end += 1 }
        result += message[start..at] + display_symbol(&sources, message[at..end])
        start = end
    }
    result + message[start..message.len]
}

struct Point { owner: i32, offset: i32, exact: bool }
fn upper_bound(values: &[]i32, key: i32) -> i32 {
    mut lo := 0; mut hi := values.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if values[mid] <= key { lo = mid + 1 } else { hi = mid }
    }
    lo
}
fn locate(sources: &Sources, position: i32) -> Point {
    unknown := Point { owner: -1, offset: 0, exact: false }
    if position < 0 || sources.starts.len != sources.files.len { return unknown }
    lo := upper_bound(&sources.starts, position)
    if lo == 0 { return unknown }
    index := lo - 1; owner := sources.files[index]
    if owner < 0 || owner >= sources.paths.len || owner >= sources.texts.len { return unknown }
    mut offset := position - sources.starts[index]
    if !sources.token_offsets {
        if index >= sources.offsets.len { return unknown }
        offset = sources.offsets[index]
    }
    if offset < 0 || offset > sources.texts[owner].len { return unknown }
    Point { owner: owner, offset: offset, exact: sources.token_offsets || position == sources.starts[index] }
}
fn source_line(source: string, offset: i32) -> string {
    mut first := offset; mut end := offset
    while first > 0 && i32(source[first - 1]) != 10 { first = first - 1 }
    while end < source.len && i32(source[end]) != 10 { end = end + 1 }
    text.trim(source[first..end])
}
pub fn location_text(sources: &Sources, offset: i32) -> string {
    at := locate(&sources, offset)
    if at.owner < 0 { return "<source> at byte " + offset.str() }
    lc := diag.line_col(sources.texts[at.owner], at.offset)
    sources.paths[at.owner] + ":" + lc.line.str() + ":" + lc.column.str()
}

pub struct LineTable { starts: []i32 }
pub fn indexed_location(sources: &Sources, tables: &mut []LineTable, offset: i32) -> string {
    at := locate(&sources, offset)
    if at.owner < 0 { return "<source> at byte " + offset.str() }
    while tables.len <= at.owner { tables.push(LineTable { starts: [] }) }
    source := &sources.texts[at.owner]
    if tables[at.owner].starts.len == 0 {
        mut lines: []i32 = [0]
        for i in 0..source.len { if source[i] == 10 { lines.push(i + 1) } }
        tables[at.owner].starts = move lines
    }
    starts := &tables[at.owner].starts
    line := upper_bound(&starts, at.offset)
    mut column := 1
    for i in starts[line - 1]..at.offset {
        if source[i] < 128 || source[i] >= 192 { column += 1 }
    }
    sources.paths[at.owner] + ":" + line.str() + ":" + column.str()
}

fn quoted(value: string, quote: string) -> string {
    mut out: []u8 = [u8(quote[0])]; digits := "0123456789abcdef"
    for byte in value.bytes() {
        if byte == 92 || byte == quote[0] { out.push(92); out.push(u8(byte)) }
        else if byte == 10 { bytes.append_utf8(&mut out, "\\n") }
        else if byte == 13 { bytes.append_utf8(&mut out, "\\r") }
        else if byte == 9 { bytes.append_utf8(&mut out, "\\t") }
        else if byte < 32 || byte == 127 {
            bytes.append_utf8(&mut out, "\\x"); out.push(u8(digits[i32(byte) / 16])); out.push(u8(digits[i32(byte) % 16]))
        } else { out.push(u8(byte)) }
    }
    out.push(u8(quote[0])); match utf8.decode(&out) { .Ok(value) => value, .Err(_) => "" }
}

pub fn expression(tokens: &lexer.Tokens, first: i32, end: i32) -> string {
    if first < 0 || end < first || end > tokens.kinds.len || end > tokens.texts.len { return "" }
    mut out := ""; mut previous := ""; mut previous_kind: lexer.Kind = .End
    for i in first..end {
        kind := tokens.kinds[i]
        if lexer.is_newline(kind) || kind == .End { continue }
        mut word := tokens.texts[i].clone()
        if kind == .String { word = quoted(word, "\"") }
        else if kind == .Rune { word = quoted(word, "`") }
        else if kind == .Byte { word = "u8(" + word + ")" }
        separate := out.len > 0 && word != ")" && word != "]" && word != "}" && word != "," && word != ";" && word != "." && word != "::" && word != ":" &&
            previous != "(" && previous != "[" && previous != "." && previous != "::" &&
            !(word == "(" && (previous_kind == .Name || previous == ")" || previous == "]")) && !(word == "[" && previous_kind == .Name)
        if separate { out = out + " " }
        out = out + word; previous = tokens.texts[i].clone(); previous_kind = kind
    }
    out
}

pub fn render(sources: &Sources, site: i32, begin: i32, end: i32, fallback: string) -> string {
    at := locate(&sources, site)
    if at.owner < 0 { return f"<source>: assertion failed: {text.trim(fallback)}\n" }
    source := &sources.texts[at.owner]
    mut line := 1
    for i in 0..at.offset { if source[i] == 10 { line = line + 1 } }
    first := locate(&sources, begin); last := locate(&sources, end)
    mut expression := ""
    if first.owner == at.owner && last.owner == at.owner && first.exact && last.exact && last.offset >= first.offset &&
        (sources.token_offsets || begin == end || last.offset > first.offset) {
        finish := lexer.span_end(source, first.offset, last.offset)
        if finish > first.offset { expression = text.trim(source[first.offset..finish]) }
    }
    if expression == "" { expression = source_line(source, at.offset) }
    if expression == "" { expression = text.trim(fallback) }
    f"{sources.paths[at.owner]}:{line}: assertion failed: {expression}\n"
}

@test fn assertion_diagnostics_map_module_offsets_to_original_unicode_source() {
    original := "\n\nfn check() { assert(å == 2) }\n"
    mut sources := new()
    sources.paths = ["main.ddr", "helpers/å.ddr"]; sources.texts = ["fn main() {}", original.clone()]
    sources.starts = [0, 200]; sources.files = [0, 1]
    site := find_substr(original, "assert"); begin := find_substr(original, "å =="); end := find_substr(original, "2)")
    assert(render(&sources, 200 + site, 200 + begin, 200 + end, "rewritten") == "helpers/å.ddr:3: assertion failed: å == 2\n")
    direct := from_text("\nassert(false)\n")
    assert(render(&direct, 1, 8, 8, "rewritten") == "<source>:2: assertion failed: false\n")
    unknown := new()
    assert(render(&unknown, 0, 0, 0, " false ") == "<source>: assertion failed: false\n")
}

@test fn assertion_diagnostics_use_original_lines_for_generated_or_ambiguous_spans() {
    original := "\n  assert(source_name == 2)\n"
    loaded := modules.Loaded { imports: Map<string, i64>::new(), token_offsets: false, groups: [], calls: [], ok: true, error: "", path: "lib.ddr", source: "rewritten", offset: 0,
        paths: ["lib.ddr"], sources: [original.clone()], symbols: [], module_caps: [], diagnostics: [], unused_namespaces: Map<i32, i64>::new(),
        map_starts: [100, 107, 149, 150], map_files: [0, 0, 0, 0],
        map_offsets: [find_substr(original, "assert"), find_substr(original, "source_name"), find_substr(original, "2)"), find_substr(original, "source_name")], json_symbols: [],
        embed_blobs: [], embed_blob_starts: [], embed_blob_counts: [], embed_blob_digests: [], embed_paths: [], build_inputs: modules.build_inputs() }
    sources := from_loaded(&loaded)
    assert(render(&sources, 100, 107, 149, "__dunder_module_name == 2") == "lib.ddr:2: assertion failed: source_name == 2\n")
    assert(render(&sources, 100, 107, 150, "rewritten") == "lib.ddr:2: assertion failed: assert(source_name == 2)\n")
    assert(render(&sources, 100, -1, 10000, "rewritten") == "lib.ddr:2: assertion failed: assert(source_name == 2)\n")
}

@test fn assertion_token_fallback_preserves_literal_quotes_and_utf8() {
    spelling := "has(\"å\\n\\\"\\\\\", `🌍`)"
    tokens := lexer.scan(spelling, false)
    assert(tokens.ok)
    assert(expression(&tokens, 0, tokens.kinds.len - 1) == spelling)
    direct := from_text("\nassert((\n    long_name ==\n    \"å\\n\"\n))\n")
    original := &direct.texts[0]
    assert(render(&direct, 1, find_substr(original, "long_name"), find_substr(original, "\"å"), "rewritten") == "<source>:2: assertion failed: long_name ==\n    \"å\\n\"\n")
}

@test fn assertion_display_paths_are_reproducible_for_relative_builds_and_preserve_explicit_absolute_roots() {
    mut loaded := modules.Loaded { imports: Map<string, i64>::new(), token_offsets: true, groups: [], calls: [], ok: true, error: "", path: "selfhost/main.ddr", source: "", offset: 0,
        paths: ["/tmp/first-checkout/selfhost/main.ddr", "/tmp/first-checkout/selfhost/frontend/compile.ddr", "/tmp/first-checkout/stdlib/bytes.ddr", "<stdlib/sys.ddr>"],
        sources: ["", "\nassert(false)", "", ""], symbols: [], module_caps: [], diagnostics: [], unused_namespaces: Map<i32, i64>::new(),
        map_starts: [0, 100], map_files: [0, 1], map_offsets: [], json_symbols: [],
        embed_blobs: [], embed_blob_starts: [], embed_blob_counts: [], embed_blob_digests: [], embed_paths: [], build_inputs: modules.build_inputs() }
    first := from_loaded(&loaded)
    assert(first.paths[0] == "selfhost/main.ddr")
    assert(first.paths[1] == "selfhost/frontend/compile.ddr")
    assert(first.paths[2] == "stdlib/bytes.ddr")
    assert(first.paths[3] == "<stdlib/sys.ddr>")
    diagnostic := render(&first, 101, 108, 108, "rewritten")
    assert(diagnostic == "selfhost/frontend/compile.ddr:2: assertion failed: false\n")
    loaded.paths[0] = "/tmp/second-checkout/selfhost/main.ddr"
    loaded.paths[1] = "/tmp/second-checkout/selfhost/frontend/compile.ddr"
    loaded.paths[2] = "/tmp/second-checkout/stdlib/bytes.ddr"
    second := from_loaded(&loaded)
    assert(render(&second, 101, 108, 108, "rewritten") == diagnostic)
    loaded.path = "/tmp/second-checkout/selfhost/main.ddr"
    absolute := from_loaded(&loaded)
    assert(render(&absolute, 101, 108, 108, "rewritten") == "/tmp/second-checkout/selfhost/frontend/compile.ddr:2: assertion failed: false\n")
}

@test fn assertion_diagnostics_preserve_rhs_interpolation_and_exclude_later_string_literals() {
    original := "assert(\"2\" == f\"{x}\"); print(\"later\")"
    sources := from_text(original)
    assert(render(&sources, 0, find_substr(original, "\"2\""), find_substr(original, "}\"") + 1, "rewritten") == "<source>:1: assertion failed: \"2\" == f\"{x}\"\n")
    implicit := "\n@test fn works() {\n    \"2\" == f\"{x}\"\n    print(\"later\")\n}\n"
    tests := from_text(implicit); first := find_substr(implicit, "\"2\"")
    assert(render(&tests, first, first, find_substr(implicit, "}\"") + 1, "rewritten") == "<source>:3: assertion failed: \"2\" == f\"{x}\"\n")
}
