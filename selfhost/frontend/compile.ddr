            if model.probing && decline_projection(&mut c, &mut model) { break }
            if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
            if ft.type_kind(&c.types, ty) == 8 { ty = foreign_call(&mut c, ty, &catalog, &mut inline_work, &mut model) }
            else if ft.type_kind(&c.types, ty) == 9 {
                callee := slot(&mut c); arm.store(&mut c.code, callee, 0); ty = invoke(&mut c, ty, callee, -1, -1, &catalog, &mut inline_work, &mut model)
            } else { fail(&mut c, "this value is not callable for the selected target"); return 0 }
            ty = call_result(&mut c, ty); place = 0; fc.clear_rvalue_place(&mut c.body.place)
        } else if eat(&mut c, "[") {
            subscript_at := c.body.cursor - 1
            array_id := model.array
            if model.probing && (!model.recording || array_id < 0) && decline_projection(&mut c, &mut model) { break }
            if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
            packed := c.body.place.inline_storage && ft.type_kind(&c.types, ty) == 6
            writable := c.body.place.writable
            view := c.body.loan.depth == c.body.depth
            source_path := owner_path(&c, place); source_root_id := source_root(&c, place); source_origin := loan_origin(&c, place)
            if ty == 4 && !view && !lookahead.read_only_index(&c.world.tokens, c.body.cursor) { copy_value(&mut c, ty); saved_text := temporary(&mut c, ty) }
            arm.push_temp(&mut c.code, 0)
            effects := c.body.mutations.len
            previous_address := c.body.place.taking_address; c.body.place.taking_address = false
            if view && is(&c, "..") { arm.imm(&mut c.code, 0, 0) }
            else { index_type := expression(&mut c, 1, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, index_type) }
