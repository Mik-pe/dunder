        if !c.ok { break }
        target_tok := declaration_impl_targets[d]
        if target_tok < 0 { continue }
        f := declaration_fns[d]
        target_name := c.world.tokens.texts[target_tok].clone()
        target_ty := parse_impl_target_at(&mut c, target_tok)
        if !c.ok { break }
        if declaration_trait_impls[d] >= 0 {
