    if c.world.module_caps.len == 0 { c.world.module_caps.push(file_caps) }
    while c.ok && c.world.tokens.kinds[c.body.cursor] != .End {
        mut library := ""; mut symbol := ""; mut has_extern := false; mut extern_prio := 0; mut layout := false; mut test := false; mut resource := false; mut req_caps := 0; mut skip_test_block := false
        mut c_variadic := -1
        mut resource_method := -1
        while c.ok && eat(&mut c, "@") {
            annotation := advance(&mut c)
            if annotation == "extern" {
                has_extern = true
                mut cur := c.body.cursor
                pick := resolve.parse_extern_attr(&c.world.tokens, c.code.platform, &mut cur)
                c.body.cursor = cur
                if pick.error != "" { fail(&mut c, pick.error); break }
                if pick.prio > extern_prio {
                    extern_prio = pick.prio; library = move pick.library; symbol = move pick.symbol
                } else if pick.prio > 0 && pick.prio == extern_prio {
                    fail(&mut c, "duplicate @extern binding for this target"); break
