                    if parens == 0 && brackets == 0 {
                        if lexer.is_newline(c.world.tokens.kinds[c.body.cursor]) || is(&c, ";") || is(&c, "}") { break }
                        if is(&c, "{") {
                            body_start = c.body.cursor + 1
                            body_end = c.world.closes[c.body.cursor]
                            if body_end < 0 || body_end >= block_end { fail(&mut c, "unterminated default trait method body"); break }
                            break
                        }
                    }
                    if is(&c, "(") { parens = parens + 1 } else if is(&c, ")") { parens = parens - 1 }
                    else if is(&c, "[") { brackets = brackets + 1 } else if is(&c, "]") { brackets = brackets - 1 }
                    skip_token(&mut c)
                }
                if !c.ok { break }
                sig_end := c.body.cursor
