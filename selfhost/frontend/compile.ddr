pub fn configuration() -> Configuration { Configuration { workers: 1, scalar_enabled: true, ownership_enabled: true, const_div_enabled: true, frame_free_enabled: true, range_enabled: true, inline_enabled: true, mir_opt_enabled: true, mir_memory_enabled: true, mir_ssa_enabled: false, mir_values_enabled: true, profile_host: -1, instrument_runtime: false } }
pub opaque struct Session {
    world: fc.DeclarationWorld, body: fc.FunctionContext,
    sources: diagnostics.Sources,
    validation_spellings: []string, validation_tokens: []i32, worker_kinds: []i32,
    jobs: cs.JobLog,
    tasks: tc.TaskGraph,
    closure_header: i32, closure_drop: i32, boxed_signatures: []bool, types: ft.TypeRegistry, helper_labels: []i32, array_helpers: i32,
    ok: bool, error: string, error_at: i32,
    specializations: generics.Layout,
    validating_dead: bool, validated_through: i32, report: bool, bindings: Bindings,
    wasm_abi: wa.Abi, code: arm.Code, fn_labels: []i32, needed: []bool, runtime: runtime.Runtime,
    imports: Imports,
    callback_labels: []i32, has_callbacks: bool,
    loans: scratch.Loans,
    array_take: i32, record_take_labels: []i32,
    mir_opt_enabled: bool, mir_memory_enabled: bool, mir_ssa_enabled: bool, mir_values_enabled: bool, scalar_enabled: bool, ownership_enabled: bool, range_enabled: bool, inline_enabled: bool,
    scalar_templates: opt_templates.Cache,
    strings: []string, string_labels: []i32,
    print_int: i32, print_bool: i32, print_text: i32, write: i32,
    float_source: bool, float_trap: i32, unicode_trap: i32, overflow: i32, zero: i32, assertion: i32, io: i32, bounds: i32,
}
fn task_effect(c: &mut Session, bits: i64) {
    if c.tasks.program { c.body.facts.effects = c.body.facts.effects.bit_or(bits) }
}
fn task_edge(c: &mut Session, callee: i32) {
    if c.tasks.program { c.body.facts.calls.push(callee) }
}
fn task_use(c: &mut Session, at: i32) {
    task_effect(&mut c, 1024)
    if c.body.facts.first_task < 0 { c.body.facts.first_task = at }
}
fn task_certify(c: &mut Session, certificate: &mut tc.TaskCertificate) -> bool {
    mut at := c.body.cursor
    err := tc.certify(&c.tasks, &c.types, &c.world.tokens.starts, c.world.names.len, &c.world.param_starts,
        &c.world.param_counts, &c.world.param_types, &c.world.returns, &mut certificate, &mut at)
    if err != "" { c.body.cursor = at; fail(&mut c, err); return false }
    true
}
fn import_c(c: &mut Session, symbol: string) -> i32 {
    for i in 0..c.imports.symbols.len {
        if c.imports.libraries[i] == "c" && c.imports.symbols[i] == symbol { return i }
    }
    index := c.imports.symbols.len; c.imports.libraries.push("c"); c.imports.symbols.push(symbol.clone()); index
}
fn bind_task_runtime(c: &mut Session, rt: &runtime.Runtime, certificate: &tc.TaskCertificate) {
    plan := tc.build_prefix_plan(&certificate, &c.types, &c.helper_labels, &c.world.param_starts, &c.world.param_types, &c.world.returns, &c.fn_labels)
    mut symbols := task_native.posix_symbols(0, -1, -1, -1)
    if c.jobs.platform == 0 {
        queue := import_c(&mut c, "dispatch_get_global_queue")
        create := import_c(&mut c, "dispatch_group_create")
        submit := import_c(&mut c, "dispatch_group_async_f")
        wait := import_c(&mut c, "dispatch_group_wait")
        release := import_c(&mut c, "dispatch_release")
        unmap := import_c(&mut c, "munmap")
        symbols = task_native.Symbols { symbol_count: c.imports.symbols.len, global_queue: queue,
            create_group: create, submit: submit, wait: wait, release_group: release, munmap: unmap }
    } else {
        create := import_c(&mut c, "pthread_create")
        join := import_c(&mut c, "pthread_join")
        unmap := import_c(&mut c, "munmap")
        symbols = task_native.posix_symbols(c.imports.symbols.len, create, join, unmap)
    }
    out := tc.emit_prefix(&mut c.code, &rt, &plan, &symbols, c.imports.globals)
    if !out.ok { fail(&mut c, out.error); return }
    c.code.labels[c.tasks.open] = c.code.labels[out.open]
    c.code.labels[c.tasks.await_result] = c.code.labels[out.await_result]
    c.code.labels[c.tasks.close] = c.code.labels[out.close]
    c.imports.globals = out.import_globals
    for w in 0..plan.worker_ids.len { c.code.labels[c.tasks.spawners[plan.worker_ids[w]]] = c.code.labels[out.spawners[w]] }
    for i in 0..out.import_sites.len { c.imports.sites.push(out.import_sites[i]); c.imports.slots.push(out.import_slots[i]) }
}

fn task_close_slot(c: &mut Session, index: i32) {
    if c.code.checking { return }
    done := arm.label(&mut c.code); arm.load(&mut c.code, index); arm.branch(&mut c.code, done, 18)
    arm.task_call(&mut c.code, c.tasks.close, .ScopeClose, 0, 0, c.world.tokens.starts[c.body.cursor]); arm.store(&mut c.code, index, 31); arm.mark(&mut c.code, done)
}
fn task_close_locals(c: &mut Session, first: i32) {
    mut i := c.body.locals.active.len - 1
    while i >= first {
        id := c.body.locals.active[i]
        if ft.type_kind(&c.types, c.body.locals.types[id]) == 23 { task_close_slot(&mut c, places.local_home(c.body.places.arena.locals[id])) }
        i = i - 1
    }
}
fn task_capability(c: &mut Session) -> i32 {
    at := c.body.cursor; name := advance(&mut c); binding := local(&c.body, name)
    if binding < 0 { fail(&mut c, "expected a live task scope capability"); c.error_at = c.world.tokens.starts[at]; return -1 }
    if ft.type_kind(&c.types, c.body.locals.types[binding]) != 23 { fail(&mut c, "expected a live task scope capability"); return -1 }
    binding
}
fn task_scope_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "task"); expect(&mut c, "scope")
    name_at := c.body.cursor; name := advance(&mut c); expect(&mut c, "(")
    actual := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, actual)
    mut factory := -1; mut workspace := 0
    mut shared := -1; mut shared_slot := -1
    if eat(&mut c, ",") {
        mut freeze := is(&c, "shared") && c.world.tokens.texts[c.body.cursor + 1] != ")" && c.world.tokens.texts[c.body.cursor + 1] != ","
        if !freeze {
            factory_at := c.body.cursor; target := advance(&mut c); factory = i32(map.get_or(&c.world.functions, target, -1))
            if factory < 0 || local(&c.body, target) >= 0 || c.world.libraries[factory] != "" || c.world.unsafe_functions[factory] || c.world.param_counts[factory] != 0 {
                fail(&mut c, "task workspace requires a named safe initializer without parameters"); return false
            }
            workspace = c.world.returns[factory]
            if ft.type_kind(&c.types, workspace) != 2 || c.types.c_record[workspace] {
                fail(&mut c, "task workspace initializer must return an owned record"); return false
            }
            c.body.facts.needed.push(factory)
            c.body.facts.factories.push(factory); c.body.facts.factory_tokens.push(factory_at)
            freeze = eat(&mut c, ",")
        }
        if freeze {
            value_at := c.body.cursor; expect(&mut c, "shared")
            cap_slot := slot(&mut c); arm.store(&mut c.code, cap_slot, 0)
            shared = expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
            if !c.ok { return false }
            if ft.type_kind(&c.types, shared) != 2 || ft.is_c_record(&c.types, shared) {
                fail(&mut c, "shared task input requires an owned record of isolated Data"); return false
            }
            c.body.facts.shared.push(tc.shared_data_type(&c.types, shared)); c.body.facts.shared_tokens.push(value_at)
            if c.body.expr.owner >= 0 { take_value(&mut c, shared) } else { copy_value(&mut c, shared) }
            if !c.code.checking { shared_slot = slot(&mut c); arm.store(&mut c.code, shared_slot, 0) }
            arm.load(&mut c.code, cap_slot)
        }
    }
    expect(&mut c, ")")
    mut cap := 0
    if shared >= 0 {
        params: []i32 = [shared]; cap = callable_type(&mut c, &params, workspace, 23)
    } else { cap = compound(&mut c, 23, workspace) }
    handle := slot(&mut c); c.body.task_handles.push(handle)
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.push_temp(&mut c.code, 0)
        if factory >= 0 { arm.branch(&mut c.code, c.fn_labels[factory], 20); arm.mov(&mut c.code, 2, 0) }
        else { arm.imm(&mut c.code, 2, 0) }
        if shared >= 0 {
            drop := type_helper(&mut c, shared, true)
            arm.branch(&mut c.code, drop, 20); arm.mov(&mut c.code, 4, 0)
            arm.load_into(&mut c.code, shared_slot, 3)
        } else { arm.imm(&mut c.code, 3, 0); arm.imm(&mut c.code, 4, 0) }
        static_address(&mut c, .TaskCoordinator, 0); arm.mov(&mut c.code, 1, 16); arm.pop_temp(&mut c.code, 0)
        arm.task_call(&mut c.code, c.tasks.open, .ScopeOpen, cap, 0, c.world.tokens.starts[at])
    }
    arm.store(&mut c.code, handle, 0)
    enter(&mut c); bind(&mut c, &mut model, move name, cap, false, handle, name_at)
    scoped_body(&mut c, &catalog, &mut inline_work, &mut model)
}
fn task_spawn(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "spawn"); cap := task_capability(&mut c)
    worker_at := c.body.cursor; name := advance(&mut c); worker := i32(map.get_or(&c.world.functions, name, -1))
    if cap < 0 { return 0 }
    if local(&c.body, name) >= 0 || worker < 0 { fail(&mut c, "spawn requires a named Dunder worker function"); return 0 }
    scope_type := c.body.locals.types[cap]; workspace := ft.type_base(&c.types, scope_type)
    has_shared := ft.type_count(&c.types, scope_type) == 1
    count := c.world.param_counts[worker]; first := c.world.param_starts[worker]
    if c.world.libraries[worker] != "" || c.world.unsafe_functions[worker] || (workspace == 0 && !has_shared && count != 1) {
        fail(&mut c, "spawn requires one safe by-value worker argument"); return 0
    }
    mut next := 1
    if workspace != 0 {
        if next >= count || ft.type_kind(&c.types, c.world.param_types[first + next]) != 5 ||
            ft.type_base(&c.types, c.world.param_types[first + next]) != workspace {
            fail(&mut c, "task worker requires a mutable parameter for this workspace"); return 0
        }
        next = next + 1
    }
    if has_shared {
        shared := ft.parameter_type(&c.types, ft.type_start(&c.types, scope_type))
        if next >= count || ft.type_kind(&c.types, c.world.param_types[first + next]) != 4 ||
            ft.type_base(&c.types, c.world.param_types[first + next]) != shared {
            fail(&mut c, "task worker requires a read-only parameter for this shared input"); return 0
        }
        next = next + 1
    }
    if count != next { fail(&mut c, "worker parameters must match its task scope"); return 0 }
    declared_input := c.world.param_types[c.world.param_starts[worker]]; input_kind := ft.type_kind(&c.types, declared_input)
    if input_kind == 5 { fail(&mut c, "task input cannot borrow mutable parent storage"); return 0 }
    mut input := declared_input; if input_kind == 4 { input = ft.type_base(&c.types, declared_input) }
    expect(&mut c, "("); consuming := eat(&mut c, "move")
    if consuming && input_kind == 4 { fail(&mut c, "move argument requires a consuming task parameter"); return 0 }
    actual := expression(&mut c, 0, input, &catalog, &mut inline_work, &mut model); same(&mut c, input, actual); expect(&mut c, ")")
    if input_kind != 4 {
        if ft.move_only(&c.types, input) && c.body.expr.owner < 0 && !consuming { fail(&mut c, "consuming task parameter requires 'move value' or a fresh owned expression"); return 0 }
        take_value(&mut c, input); input_owner := temporary(&mut c, input)
    }
    c.body.facts.needed.push(worker)
    if c.tasks.program {
        c.body.facts.workers.push(worker); c.body.facts.worker_tokens.push(worker_at)
    }
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[cap]))
        arm.task_call(&mut c.code, c.tasks.spawners[worker], .Spawn, c.world.returns[worker], worker, c.world.tokens.starts[at])
    }
    fc.clear_rvalue_place(&mut c.body.place)
    compound(&mut c, 22, c.world.returns[worker])
}
fn task_await_expression(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "await")
    consume := eat(&mut c, "!"); cap := task_capability(&mut c); expect(&mut c, "(")
    key := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
    if cap < 0 { return 0 }
    if ft.type_kind(&c.types, key) != 22 { fail(&mut c, "await requires a typed TaskID result key"); return 0 }
    result := ft.type_base(&c.types, key)
    if ft.move_only(&c.types, result) && !consume { fail(&mut c, "move-only task results require await!"); return 0 }
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[cap]))
        mut action: row.Task = .Await; if consume { action = .AwaitOnce }
        arm.task_call(&mut c.code, c.tasks.await_result, action, result, 0, c.world.tokens.starts[at])
    }
    fc.clear_rvalue_place(&mut c.body.place); temporary(&mut c, result)
}

fn peek(c: &Session) -> string { c.world.tokens.texts[c.body.cursor].clone() }
fn is(c: &Session, word: string) -> bool {
    kind := c.world.tokens.kinds[c.body.cursor]
    kind != .String && kind != .Rune && kind != .Byte && c.world.tokens.texts[c.body.cursor] == word
}
fn fail(c: &mut Session, message: string) { if c.ok { c.ok = false; c.error = message.clone(); c.error_at = c.world.tokens.starts[c.body.cursor] } }
fn skip_token(c: &mut Session) {
    if c.body.cursor + 1 < c.world.tokens.texts.len { c.body.cursor = c.body.cursor + 1 }
}
fn advance(c: &mut Session) -> string { value := peek(&c); skip_token(&mut c); value }
fn eat(c: &mut Session, word: string) -> bool { if is(&c, word) { skip_token(&mut c); return true }; false }
fn expect(c: &mut Session, word: string) { if !eat(&mut c, word) { fail(&mut c, "expected '" + word + "'") } }
fn separators(c: &mut Session) {
    while c.ok {
        kind := c.world.tokens.kinds[c.body.cursor]
        if !lexer.is_newline(kind) && (kind != .Symbol || c.world.tokens.texts[c.body.cursor] != ";") { break }
        skip_token(&mut c)
    }
}
fn newlines(c: &mut Session) { while c.ok && lexer.is_newline(c.world.tokens.kinds[c.body.cursor]) { skip_token(&mut c) } }
fn check_type_error(c: &mut Session) {
    if c.types.error != "" { fail(&mut c, c.types.error.clone()); c.types.error = "" }
}
fn add_type(c: &mut Session, name: string, kind: i32, base: i32) -> i32 {
    ft.add_type(&mut c.types, name, kind, base)
}
fn scalar_element(c: &Session, ty: i32) -> bool { ft.scalar_element(&c.types, ty) }
fn scalar_bytes(c: &Session, ty: i32) -> i32 { ft.scalar_bytes(&c.types, ty, c.code.platform) }
fn compound(c: &mut Session, kind: i32, base: i32) -> i32 {
    ty := type_reader.compound(&mut c.types, kind, base); check_type_error(&mut c); ty
}
fn collection(c: &Session, ty: i32) -> bool { ft.collection(&c.types, ty) }
fn length_literal(c: &mut Session) -> i32 {
    if c.world.tokens.kinds[c.body.cursor] != .Integer { fail(&mut c, "expected nonnegative array length"); return 0 }
    length := rules.literal_integer(advance(&mut c))
    if !length.ok || length.value < 0 || length.value > 1048576 { fail(&mut c, "array length out of range"); return 0 }
    i32(length.value)
}
fn fixed(c: &mut Session, base: i32, length: i32) -> i32 {
    ty := type_reader.fixed(&mut c.types, c.code.platform, base, length); check_type_error(&mut c); ty
}
fn type_id(c: &Session, name: string) -> i32 { ft.type_id(&c.types, name) }
fn resolve_type_name(c: &Session, name: string) -> i32 {
    if name == "Self" { return c.types.self_type }
    type_id(&c, name)
}
fn foreign_type(c: &mut Session, args: &[]i32, result: i32) -> i32 { callable_type(&mut c, &args, result, 8) }
fn foreign_variadic_type(c: &mut Session, args: &[]i32, result: i32, fixed: i32) -> i32 {
    if fixed < 0 { return foreign_type(&mut c, &args, result) }
    if c.code.platform == 3 { fail(&mut c, "C variadic declarations require a native target"); return 0 }
    callable_with_parameter(&mut c, &args, result, 8, fixed)
}
fn callable_type(c: &mut Session, args: &[]i32, result: i32, kind: i32) -> i32 {
    callable_with_parameter(&mut c, &args, result, kind, -1)
}
fn callable_with_parameter(c: &mut Session, args: &[]i32, result: i32, kind: i32, parameter: i32) -> i32 {
    ty := type_reader.callable(&mut c.types, &args, result, kind, parameter); check_type_error(&mut c); ty
}
fn result_parameter(c: &mut Session, args: &[]i32, result: i32, first_name: i32) -> i32 {
    if ft.type_kind(&c.types, result) != 4 {
        if first_name >= 0 && is(&c, "from") { fail(&mut c, "only a shared returned borrow can specify a source parameter") }
        return -1
    }
    if is(&c, "from") && (first_name >= 0 || c.world.tokens.kinds[c.body.cursor + 1] != .Name) {
        skip_token(&mut c)
        at := c.body.cursor
        if first_name < 0 {
            if c.world.tokens.kinds[at] != .Integer { fail(&mut c, "expected a one-based source parameter number after 'from'"); return -1 }
            number := rules.literal_integer(advance(&mut c))
            if number.ok && number.value >= 1 && number.value <= i64(args.len) { return i32(number.value) - 1 }
            fail(&mut c, "returned borrow source parameter number is out of range")
        } else {
            if c.world.tokens.kinds[at] != .Name { fail(&mut c, "expected a source parameter name after 'from'"); return -1 }
            name := advance(&mut c)
            for i in 0..args.len { if c.world.param_names[first_name + i] == name { return i } }
            fail(&mut c, "unknown returned borrow source parameter '" + name + "'")
        }
        c.error_at = c.world.tokens.starts[at]; return -1
    }
    source := type_reader.borrow_source(&mut c.types, &args); check_type_error(&mut c); source
}
fn parameter_mode(c: &mut Session, ty: i32, consume: bool, foreign: bool) -> i32 {
    mode := type_reader.parameter_mode(&mut c.types, ty, consume, foreign); check_type_error(&mut c); mode
}
fn type_name(c: &mut Session) -> i32 {
    if !c.ok { return 0 }
    at := c.body.cursor
    if c.world.tokens.kinds[at] == .Name {
        named := resolve_type_name(&c, c.world.tokens.texts[at])
        if named >= 0 { skip_token(&mut c); return named }
    }
    tokens := replace(&mut c.world.tokens, lexer.empty(false))
    mut input := syntax.cursor(at, tokens.kinds.len - 1)
    platform := c.code.platform
    ty := type_reader.read(&mut input, &mut c.types, &tokens, platform)
    c.world.tokens = move tokens
    c.body.cursor = input.at
    if input.error != "" { c.body.cursor = input.error_at; fail(&mut c, input.error) }
    check_type_error(&mut c); ty
}
// Register concrete aggregate types from annotations and qualified constructors
// before workers receive the immutable declaration registry.
fn prepare_structural_types(c: &mut Session) {
    for f in 0..c.world.names.len {
        c.types.self_type = c.world.impl_types[f]
        for at in c.world.starts[f]..c.world.ends[f] {
            kind := c.world.tokens.kinds[at]
            if kind == .Symbol && c.world.tokens.texts[at] == ":" {
                next := c.world.tokens.texts[at + 1].clone()
                if next != "(" && next != "[" && next != "&" && next != "fn" && next != "extern" && next != "TaskID" { continue }
                c.body.cursor = at + 1
                _ := type_name(&mut c)
            } else { continue }
            if !c.ok {
                // A field initializer or a comparison can resemble a type.
                c.ok = true; c.error = ""; c.error_at = 0
            }
        }
    }
    c.types.self_type = -1
    ft.finish_tuples(&mut c.types)
}
fn same(c: &mut Session, expected: i32, actual: i32) {
    if expected == actual { return }
    if c.ok { fail(&mut c, "type mismatch: " + ft.type_spelling(&c.types, expected) + " / " + ft.type_spelling(&c.types, actual)) }
}
fn field(c: &Session, ty: i32, name: string) -> i32 { ft.field(&c.types, ty, name) }
fn load_mem(c: &mut Session, destination: i32, base: i32, offset: i32) { fa.load_mem(&mut c.code, destination, base, offset) }
fn store_mem(c: &mut Session, source: i32, base: i32, offset: i32) { fa.store_mem(&mut c.code, source, base, offset) }
fn save_address(c: &mut Session, id: i32, token: i32) {
    mut home := places.address(c.body.places.arena.nodes[3 * (id - 1)])
    if home < 0 {
        home = slot(&mut c); if !c.ok { return }
        places.save_home(&mut c.body.places.arena, id, home)
    }
    c.body.place.inline_storage = false; c.body.place.direct = false; c.body.place.address = home
    bound_place(&mut c, .Temporary, id, i32(place_op.Temporary.SaveAddress), token)
}
fn place_address(c: &mut Session, id: i32, direct: bool, token: i32) {
    mut op := place_op.Op.BorrowSaved; if direct { op = .BorrowHome }
    bound_place(&mut c, op, id, i32(borrows.Access.Address), token)
}
fn place_step(c: &mut Session, op: place_op.Op, ty: i32, access: i32, form: i32, parameter: i32, token: i32) {
    place_emit.emit(&mut c.code, op, ty, access, form, parameter, c.world.tokens.starts[token])
}
fn read_shape(c: &Session, ty: i32, packed: bool) -> i32 {
    storage := storage_type(&c, ty)
    mut form := unsigned.shift(storage)
    if packed {
        width := ft.foreign_width(storage)
        form = 0; while i32(1).shl(form) < width { form = form + 1 }
    }
    if (packed && ty == 1) || (!packed && storage == 1) { form = 4 }
    form
}
fn bound_place(c: &mut Session, op: place_op.Op, place: i32, access: i32, token: i32) {
    if c.code.checking && !c.code.prefixing { return }
    source := c.world.tokens.starts[token]
    row := place_op.bound_header(op, place, access, source)
    arm.operand(&mut c.code, row)
    if place_op.wide(row) { arm.operand(&mut c.code, place_op.location(0, source)) }
}
fn place_transfer(c: &mut Session, ty: i32, reg: i32, base: i32, load: bool, packed: bool, access: i32, token: i32) {
    mut form := read_shape(&c, ty, packed); if !load && form == 4 { form = 2 }
    mut op := place_op.Op.Write; if load { op = .Read }
    place_step(&mut c, op, ty, access, form, base * 32 + reg, token)
}
fn boxed_function(c: &Session, ty: i32) -> bool {
    ty >= 0 && ty < c.boxed_signatures.len && c.boxed_signatures[ty]
}
fn prepare_closures(c: &mut Session) {
    c.closure_header = type_id(&c, closures.header())
    if c.closure_header < 0 { return }
    for _ in 0..c.types.declared.type_kinds.len { c.boxed_signatures.push(false) }
    for f in 0..c.world.ffi_types.len {
        last := c.world.param_starts[f] + c.world.param_counts[f] - 1
        if c.world.param_counts[f] > 0 && c.world.param_names[last] == "__dunder_module_env" {
            c.boxed_signatures[c.world.ffi_types[f]] = true
        }
    }
}
fn owned(c: &Session, ty: i32) -> bool { ft.owned(&c.types, ty) || boxed_function(&c, ty) }
fn require_cleanup(c: &mut Session, ty: i32) {
    if !c.types.has_cleanup || c.validating_dead || !ft.owned(&c.types, ty) || ty == 4 { return }
    mut pending: []i32 = [ty]
    mut seen: []i32 = []
    while pending.len > 0 {
        current := pending.pop()
        if current == 4 || !ft.owned(&c.types, current) { continue }
        mut visited := false
        for prior in &seen { if prior == current { visited = true; break } }
        if visited { continue }
        seen.push(current)
        hook := ft.cleanup_method(&c.types, current)
        if hook >= 0 {
            c.body.facts.needed.push(hook)
            task_edge(&mut c, hook)
        }
        kind := ft.type_kind(&c.types, current)
        if collection(&c, current) {
            pending.push(ft.type_base(&c.types, current))
        } else {
            first := ft.type_start(&c.types, current)
            for member in first..first + ft.type_count(&c.types, current) {
                if kind == 2 {
                    pending.push(c.types.field_types[member])
                } else {
                    start := c.types.payload_starts[member]
                    for p in start..start + c.types.payload_counts[member] { pending.push(c.types.payload_types[p]) }
                }
            }
        }
    }
}
fn bind_type_helpers(c: &mut Session) {
    if c.code.checking { return }
    c.array_helpers = arm.label(&mut c.code)
    for i in 1..4 { reserved := arm.label(&mut c.code) }
    for ty in 0..c.types.declared.type_kinds.len {
        mut label := -1
        if collection(&c, ty) {
            label = c.array_helpers
            if c.types.declared.type_bases[ty] == 4 { label = label + 2 }
        } else if ty != 4 && ft.owned(&c.types, ty) {
            label = arm.label(&mut c.code)
            drop_label := arm.label(&mut c.code)
        }
        c.helper_labels.push(label)
    }
}
fn type_helper(c: &mut Session, ty: i32, drop: bool) -> i32 {
    if c.code.checking { return -1 }
    mut label := c.array_helpers
    if ty < c.helper_labels.len { label = c.helper_labels[ty] }
    else {
        assert(collection(&c, ty))
        if ft.type_base(&c.types, ty) == 4 { label = label + 2 }
    }
    if drop { return label + 1 }
    label
}
fn owner_store(c: &mut Session, action: row.OwnerStore, ty: i32, index: i32) {
    if c.code.checking { return }
    source := c.world.tokens.starts[c.body.cursor]
    arm.owner_store(&mut c.code, action, ty, index, source)
}
fn ownership_call(c: &mut Session, action: row.Ownership, ty: i32, target: i32) {
    may_invalidate_operand(&mut c)
    if c.code.checking { return }
    mut source := 0
    if c.code.mir_capture { source = c.world.tokens.starts[c.body.cursor] }
    arm.ownership_call(&mut c.code, target, action, ty, source)
}
fn copy_value(c: &mut Session, ty: i32) {
    if ft.type_kind(&c.types, ty)==21 || ft.type_kind(&c.types, ty)==20 {fail(&mut c,"scratch values cannot escape the region");return}
    if ty == 4 || boxed_function(&c, ty) || (ft.type_kind(&c.types, ty) == 7 && !ft.move_only(&c.types, ty)) { ownership_call(&mut c, .Copy, ty, c.runtime.retain) }
    else if owned(&c, ty) { label := type_helper(&mut c, ty, false); ownership_call(&mut c, .Copy, ty, label) }
}
fn array_element_helpers(c: &mut Session, base: i32) {
    if c.code.checking || !owned(&c, base) { return }
    mut clone_label := c.runtime.retain
    if base != 4 && !boxed_function(&c, base) && !(ft.type_kind(&c.types, base) == 7 && !ft.move_only(&c.types, base)) {
        clone_label = type_helper(&mut c, base, false)
    }
    drop_label := drop_target(&mut c, base)
    arm.push_temp(&mut c.code, 0)
    arm.branch(&mut c.code, clone_label, 20)
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 32)
    arm.push_temp(&mut c.code, 1)
    arm.branch(&mut c.code, drop_label, 20)
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 40)
    arm.mov(&mut c.code, 0, 1)
}
fn can_take(c: &Session, ty: i32) -> bool {
    if ty == 4 || boxed_function(&c, ty) || collection(&c, ty) || ft.type_kind(&c.types, ty) == 7 || ft.is_c_record(&c.types, ty) { return true }
    ft.type_kind(&c.types, ty) == 2 && !c.code.checking && ty < c.record_take_labels.len && c.record_take_labels[ty] >= -1
}
fn owner_path(c: &Session, place: i32) -> i32 {
    if place < 0 {
        binding := borrows.root(&c.body.places, place)
        alias := local_borrows.path(&c.body.local_loans, binding)
        if alias >= 0 { return alias }
        return ownership.root_id(&c.body.ownership, binding)
    }
    if place > 0 { return c.body.places.owners[place - 1] }
    -1
}
fn source_root(c: &Session, place: i32) -> i32 {
    binding := borrows.root(&c.body.places, place)
    alias := local_borrows.root(&c.body.local_loans, binding)
    if alias >= 0 || local_borrows.is_transient(&c.body.local_loans, binding) { return alias }
    binding
}
fn writable_loan(c: &mut Session, place: i32) -> bool {
    path := owner_path(&c, place)
    captured := local_borrows.conflict(&c.body.local_loans, &c.body.ownership, path)
    if captured < 0 { return true }
    fail(&mut c, "cannot mutate, replace or move a value while it is borrowed")
    false
}
fn constrain_borrow(c: &mut Session) -> bool {
    if !c.loans.active { fail(&mut c, "scoped borrow analysis was not prepared"); return false }
    c.body.loan.constrained = true
    true
}
fn move_place(c: &mut Session, place: i32, at: i32) -> bool {
    if c.types.has_cleanup {
        mut projected := place
        while projected > 0 {
            row := (projected - 1) * 3
            receiver := places.receiver(c.body.places.arena.nodes[row + 1])
            if ft.cleanup_method(&c.types, receiver) >= 0 {
                fail(&mut c, "cannot move out of a resource with automatic cleanup; use replace to leave a valid field")
                return false
            }
            projected = places.parent(c.body.places.arena.nodes[row])
        }
    }
    binding := borrows.root(&c.body.places, place)
    kind := ft.type_kind(&c.types, c.body.locals.types[binding])
    if kind == 4 || kind == 5 { fail(&mut c, "cannot move out of a borrowed value; use .clone()"); return false }
    for i in 0..c.body.pattern_borrowed.len {
        if c.body.pattern_borrowed[i] == binding { fail(&mut c, "cannot move a borrowed pattern binding; use .clone()"); return false }
    }
    if !writable_loan(&mut c, place) { return false }
    path := owner_path(&c, place)
    if !ownership.available(&c.body.ownership, path) { fail(&mut c, "use of moved value '" + c.body.locals.names[binding] + "'"); return false }
    if is_for_locked(&c, binding) { fail(&mut c, "cannot move a collection while iterating over it"); return false }
    for i in 0..c.body.move_defer_locks.len {
        if c.body.move_defer_locks[i] == binding { fail(&mut c, "cannot move a value captured by defer; use .clone() or move it after the deferred scope"); return false }
    }
    ownership.consume(&mut c.body.ownership, path, at); c.body.mutations.push(binding)
    true
}
fn move_binding(c: &mut Session, binding: i32, at: i32) -> bool {
    move_place(&mut c, borrows.local_id(binding), at)
}
fn take_value(c: &mut Session, ty: i32) {
    if ft.move_only(&c.types, ty) {
        if c.body.expr.owner >= 0 && c.body.expr.ty == ty {
            owner_store(&mut c, .Transfer, ty, c.body.expr.owner)
        } else {
            place := c.body.places.current; mut at := c.body.places.source; if at < 0 { at = c.body.cursor }
            if place < 0 {
                binding := borrows.root(&c.body.places, place)
                if !move_binding(&mut c, binding, at) { return }
                owner_store(&mut c, .Transfer, ty, places.local_home(c.body.places.arena.locals[binding]))
            } else {
                mut address := c.body.expr.move_projection
                if place > 0 {
                    if borrows.has_index(&c.body.places, place) { fail(&mut c, "cannot move out of an indexed element; use .pop() or .clone()"); return }
                    binding := borrows.root(&c.body.places, place)
                    if binding < 0 { fail(&mut c, "cannot transfer this projection; use .clone()"); return }
                    lower_place(&mut c, place, 0, .ValueAndAddress, at)
                    if c.body.place.inline_storage { fail(&mut c, "inline C fields require .clone() when extracted"); return }
                    address = c.body.place.address
                    if !move_place(&mut c, place, at) { return }
                } else if c.body.expr.move_temporary < 0 || address < 0 || c.body.place.inline_storage {
                    fail(&mut c, "cannot move out of this borrowed or inline projection; use .clone()"); return
                }
                arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, address)
                store_mem(&mut c, 31, 0, 0); arm.pop_temp(&mut c.code, 0)
            }
        }
        fc.clear_expr(&mut c.body.expr); return
    }
    if c.body.expr.owner >= 0 && c.body.expr.ty == ty && can_take(&c, ty) {
        if collection(&c, ty) { ownership_call(&mut c, .NormalizeTransfer, ty, c.array_take) }
        else if ft.type_kind(&c.types, ty) == 2 && ty < c.record_take_labels.len && c.record_take_labels[ty] >= 0 {
            ownership_call(&mut c, .NormalizeTransfer, ty, c.record_take_labels[ty])
        }
        owner_store(&mut c, .Transfer, ty, c.body.expr.owner)
    } else { copy_value(&mut c, ty) }
    fc.clear_expr_value(&mut c.body.expr)
}
fn take_inline(c: &mut Session, ty: i32) {
    if !ft.move_only(&c.types, ty) { return }
    if c.body.expr.owner >= 0 && c.body.expr.ty == ty { return }
    place := c.body.places.current; mut at := c.body.places.source
    if at < 0 { at = c.body.cursor }
    if place != 0 {
        if borrows.has_index(&c.body.places, place) { fail(&mut c, "cannot move out of an indexed element; use .pop() or .clone()"); return }
        binding := borrows.root(&c.body.places, place)
        if binding >= 0 { moved := move_place(&mut c, place, at); return }
    }
    if c.body.expr.move_temporary < 0 { fail(&mut c, "cannot move out of this borrowed or inline projection; use .clone()") }
}
fn drop_target(c: &mut Session, ty: i32) -> i32 {
    if boxed_function(&c, ty) { return c.closure_drop }
    if ty == 4 { return c.runtime.release }
    if owned(&c, ty) { return type_helper(&mut c, ty, true) }
    -1
}
fn drop_value(c: &mut Session, ty: i32) {
    target := drop_target(&mut c, ty)
    if target >= 0 { ownership_call(&mut c, .Drop, ty, target) }
}
fn remember_owner(c: &mut Session, index: i32, ty: i32, temporary: bool) {
    if !temporary { require_cleanup(&mut c, ty) }
    c.body.owned_slots.push(index); c.body.owned_types.push(ty); c.body.owner_temps.push(temporary)
}
fn clear_owner_at(c: &mut Session, index: i32, ty: i32, source: i32) {
    target := drop_target(&mut c, ty)
    arm.load(&mut c.code, index)
    if target >= 0 {
        may_invalidate_operand(&mut c)
        arm.ownership_call(&mut c.code, target, .Clear, ty, source)
    }
    arm.owner_store(&mut c.code, .Vacate, ty, index, source)
}
fn emitting(c: &Session) -> bool { !c.code.checking }
fn clear_owner(c: &mut Session, index: i32, ty: i32) {
    if emitting(&c) { clear_owner_at(&mut c, index, ty, c.world.tokens.starts[c.body.cursor]) }
}
fn save_owner(c: &mut Session, index: i32, ty: i32, temporary: bool) {
    if !emitting(&c) { return }
    remember_owner(&mut c, index, ty, temporary)
    install_owner(&mut c, index, ty, c.world.tokens.starts[c.body.cursor])
}
fn install_owner(c: &mut Session, index: i32, ty: i32, source: i32) {
    if c.body.reenter_owners {
        arm.push_temp(&mut c.code, 0); clear_owner_at(&mut c, index, ty, source); arm.pop_temp(&mut c.code, 0)
    }
    arm.owner_store(&mut c.code, .Install, ty, index, source)
}
fn temporary(c: &mut Session, ty: i32) -> i32 {
    require_cleanup(&mut c, ty)
    fc.clear_expr_value(&mut c.body.expr)
    c.body.expr.untyped_exit = false
    fc.clear_loan_eval(&mut c.body.loan)
    if owned(&c, ty) { index := slot(&mut c); save_owner(&mut c, index, ty, true); fc.produce_owner(&mut c.body.expr, index, ty) }
    ty
}
fn call_result(c: &mut Session, ty: i32) -> i32 {
    if ft.type_kind(&c.types, ty) != 4 { return temporary(&mut c, ty) }
    fc.clear_expr(&mut c.body.expr)
    ty
}
fn cleanup_from(c: &mut Session, first: i32, only_temps: bool) {
    mut i := c.body.owned_slots.len - 1
    while i >= first {
        if c.body.owned_slots[i] >= 0 && (!only_temps || c.body.owner_temps[i]) { clear_owner(&mut c, c.body.owned_slots[i], c.body.owned_types[i]) }
        i = i - 1
    }
}
fn stage_owner(c: &mut Session, kind: fc.PendingKind, home: i32, ty: i32, member: i32) {
    if c.code.checking { return }
    if (kind == .Argument || kind == .Field) && !owned(&c, ty) { return }
    c.body.pending.slots.push(home); c.body.pending.kinds.push(kind)
    c.body.pending.types.push(ty); c.body.pending.members.push(member)
}
fn cleanup_pending(c: &mut Session, floor: i32) {
    if !c.ok || c.code.checking { return }
    mut i := c.body.pending.slots.len - 1
    while i >= floor {
        kind := c.body.pending.kinds[i]; ty := c.body.pending.types[i]
        arm.load(&mut c.code, c.body.pending.slots[i])
        if kind == .Storage {
            ownership_call(&mut c, .Drop, ty, c.runtime.release)
        } else if kind == .Array {
            if ty != 0 { array_element_helpers(&mut c, ty) }
            arm.branch(&mut c.code, c.runtime.array_drop, 1)
        } else {
            if kind == .Field { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), c.body.pending.members[i], c.body.cursor) }
            drop_value(&mut c, ty)
        }
        i = i - 1
    }
}
fn may_invalidate_operand(c: &mut Session) {
    if c.body.observing_lease { c.body.lease_generation = c.body.lease_generation + 1 }
}
fn skip_body(c: &mut Session) { expect(&mut c, "{"); c.body.cursor = c.world.closes[c.body.cursor - 1] + 1 }
fn foreign_scalar(c: &Session, ty: i32) -> bool { ft.foreign_scalar(&c.types, ty) }
fn opaque_access(c: &mut Session, ty: i32) {
    if ft.declaring_owner(&c.types, ty) >= 0 && ft.declaring_owner(&c.types, ty) != c.body.current_owner {
        fail(&mut c, "an opaque struct can only be constructed or opened by its defining module")
    }
}
fn parse_requires(c: &mut Session) -> i32 {
    expect(&mut c, "(")
    mut cap_mask := 0
    while c.ok {
        if eat(&mut c, "filesystem") && cap_mask.bit_and(1) == 0 { cap_mask = cap_mask.bit_or(1) }
        else if eat(&mut c, "network") && cap_mask.bit_and(2) == 0 { cap_mask = cap_mask.bit_or(2) }
        else if eat(&mut c, "process") && cap_mask.bit_and(4) == 0 { cap_mask = cap_mask.bit_or(4) }
        else { fail(&mut c, "expected @requires(filesystem), @requires(network) or @requires(process)"); return 0 }
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")")
    if cap_mask == 0 { fail(&mut c, "expected @requires(filesystem), @requires(network) or @requires(process)"); return 0 }
    cap_mask
}
fn check_function_caps(c: &mut Session, f: i32, token: i32) {
    req := c.world.requires_caps[f]
    if req == 0 { return }
    mut granted := 0
    if c.body.current_owner >= 0 && c.body.current_owner < c.world.module_caps.len {
        granted = c.world.module_caps[c.body.current_owner]
    }
    missing := req.bit_and(granted.bit_xor(7))
    if missing == 0 { return }
    if missing.bit_and(1) != 0 { fail(&mut c, "this function requires capability filesystem") }
    else if missing.bit_and(2) != 0 { fail(&mut c, "this function requires capability network") }
    else { fail(&mut c, "this function requires capability process") }
    c.error_at = c.world.tokens.starts[token]
}
fn impl_method(c: &Session, ty: i32, name: string) -> i32 {
    if ty < 0 { return -1 }
    i32(map.get_or(&c.world.methods, ty.str() + ":" + name, -1))
}
fn check_impl_access(c: &mut Session, f: i32, token: i32) -> bool {
    if ft.cleanup_method(&c.types, c.world.impl_types[f]) == f {
        fail(&mut c, "resource cleanup methods are called automatically")
        c.error_at = c.world.tokens.starts[token]
        return false
    }
    if !c.world.impl_public[f] && c.world.function_owners[f] != c.body.current_owner {
        fail(&mut c, "method '" + c.world.impl_names[f] + "' is private; export it with pub")
        c.error_at = c.world.tokens.starts[token]
        return false
    }
    check_function_caps(&mut c, f, token)
    c.ok
}
fn declaration_owner(c: &Session, offset: i32, starts: &[]i32, owners: &[]i32) -> i32 {
    if generics.generated(&c.specializations, offset) { return c.world.module_caps.len }
    fc.source_owner(offset, &starts, &owners)
}
fn headers(c: &mut Session, module_starts: &[]i32, module_files: &[]i32) {
    mut stack: []i32 = []
    for i in 0..c.world.tokens.kinds.len {
        if c.world.tokens.kinds[i] == .Symbol {
            if c.world.tokens.texts[i] == "{" { stack.push(i) }
            if c.world.tokens.texts[i] == "}" { if stack.len == 0 { fail(&mut c, "unexpected closing brace"); return }; open := stack.pop(); c.world.closes[open] = i }
        }
    }
    if stack.len != 0 { fail(&mut c, "unterminated body"); return }
    mut declarations: []i32 = []; mut declaration_types: []i32 = []
    mut declaration_fns: []i32 = []; mut declaration_impl_targets: []i32 = []; mut declaration_impl_owners: []i32 = []
    mut declaration_c_variadic: []i32 = []
    mut resource_types: []i32 = []; mut resource_methods: []i32 = []
    separators(&mut c)
    mut file_caps := 0
    if eat(&mut c, "capability") {
        while c.ok {
            if eat(&mut c, "unsafe") && !c.world.unsafe_capable { c.world.unsafe_capable = true }
            else if eat(&mut c, "filesystem") && file_caps.bit_and(1) == 0 { file_caps = file_caps.bit_or(1) }
            else if eat(&mut c, "network") && file_caps.bit_and(2) == 0 { file_caps = file_caps.bit_or(2) }
            else if eat(&mut c, "process") && file_caps.bit_and(4) == 0 { file_caps = file_caps.bit_or(4) }
            else { fail(&mut c, "unknown or duplicate module capability"); break }
            if !eat(&mut c, ",") { break }
        }
        separators(&mut c)
    }
    if c.world.module_caps.len == 0 { c.world.module_caps.push(file_caps) }
    while c.ok && c.world.tokens.kinds[c.body.cursor] != .End {
        mut library := ""; mut symbol := ""; mut layout := false; mut test := false; mut resource := false; mut req_caps := 0; mut skip_test_block := false
        mut c_variadic := -1
        mut resource_method := -1
        while c.ok && eat(&mut c, "@") {
            annotation := advance(&mut c)
            if annotation == "extern" {
                expect(&mut c, "(")
                if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "expected an extern library") }
                library = advance(&mut c); expect(&mut c, ",")
                if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "expected an extern symbol") }
                symbol = advance(&mut c); expect(&mut c, ")")
                if !fc.valid_foreign_name(library) || !fc.valid_foreign_name(symbol) { fail(&mut c, "invalid external library or symbol") }
            } else if annotation == "c_variadic" {
                if c_variadic >= 0 { fail(&mut c, "duplicate @c_variadic attribute"); break }
                expect(&mut c, "(")
                if c.world.tokens.kinds[c.body.cursor] != .Integer { fail(&mut c, "@c_variadic requires a nonnegative fixed parameter count"); break }
                parsed := rules.literal_integer(advance(&mut c))
                if !parsed.ok || parsed.value < 0 || parsed.value > 65535 { fail(&mut c, "invalid C variadic fixed parameter count"); break }
                c_variadic = i32(parsed.value); expect(&mut c, ")")
            } else if annotation == "c_layout" { layout = true }
            else if annotation == "resource" {
                if resource { fail(&mut c, "duplicate @resource attribute"); break }
                resource = true
                if eat(&mut c, "(") {
                    if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected a resource cleanup method name"); break }
                    resource_method = c.body.cursor
                    skip_token(&mut c); expect(&mut c, ")")
                }
            }
            else if annotation == "requires" { req_caps = req_caps.bit_or(parse_requires(&mut c)) }
            else if annotation == "test" { test = true }
            else { fail(&mut c, "unknown declaration attribute"); break }
            newlines(&mut c)
            if test && is(&c, "{") { skip_body(&mut c); separators(&mut c); skip_test_block = true; break }
        }
        if skip_test_block { continue }
        if !c.ok { break }
        public := eat(&mut c, "pub")
        unchecked := eat(&mut c, "unsafe")
        if unchecked && !c.world.unsafe_capable { fail(&mut c, "module requires capability unsafe"); break }
        if library != "" && !unchecked { fail(&mut c, "@extern requires unsafe fn"); break }
        if c_variadic >= 0 && library == "" { fail(&mut c, "@c_variadic requires an @extern unsafe fn declaration"); break }
        opaque := eat(&mut c, "opaque")
        owner := declaration_owner(&c, c.world.tokens.starts[c.body.cursor], &module_starts, &module_files)
        if is(&c, "impl") {
            if public { fail(&mut c, "impl block cannot be public; mark individual methods with pub"); break }
            if unchecked || opaque || layout || resource || test || library != "" || req_caps != 0 || c_variadic >= 0 {
                fail(&mut c, "invalid declaration attribute"); break
            }
            skip_token(&mut c)
            target_tok := c.body.cursor
            if c.world.tokens.kinds[target_tok] != .Name { fail(&mut c, "expected type name after impl"); break }
            target_name := advance(&mut c)
            newlines(&mut c); expect(&mut c, "{"); if !c.ok { break }
            block_end := c.world.closes[c.body.cursor - 1]
            separators(&mut c)
            while c.ok && !is(&c, "}") {
                mut m_caps := 0
                while c.ok && eat(&mut c, "@") {
                    ann := advance(&mut c)
                    if ann == "requires" { m_caps = m_caps.bit_or(parse_requires(&mut c)); newlines(&mut c) }
                    else if ann == "test" { fail(&mut c, "@test is not allowed inside impl blocks"); break }
                    else { fail(&mut c, "unknown declaration attribute"); break }
                }
                if !c.ok { break }
                m_pub := eat(&mut c, "pub")
                m_unsafe := eat(&mut c, "unsafe")
                if m_unsafe && !c.world.unsafe_capable { fail(&mut c, "module requires capability unsafe"); break }
                expect(&mut c, "fn"); if !c.ok { break }
                m_owner := declaration_owner(&c, c.world.tokens.starts[c.body.cursor], &module_starts, &module_files)
                if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected method name"); break }
                m_name := advance(&mut c)
                if m_name == "self" || m_name == "Self" || m_name == "TaskID" { fail(&mut c, "duplicate or reserved function name"); break }
                fn_id := c.world.names.len
                declarations.push(c.body.cursor); declaration_types.push(-1); declaration_fns.push(fn_id)
                declaration_c_variadic.push(-1)
                declaration_impl_targets.push(target_tok); declaration_impl_owners.push(m_owner)
                c.world.function_owners.push(m_owner); c.world.test_functions.push(false)
                c.world.libraries.push(""); c.world.symbols.push(""); c.world.unsafe_functions.push(m_unsafe)
                c.world.impl_types.push(-2); c.world.impl_public.push(m_pub)
                c.world.impl_has_self.push(false); c.world.impl_self_mut.push(false)
                c.world.impl_names.push(m_name.clone()); c.world.requires_caps.push(m_caps)
                c.world.names.push(target_name + "::" + m_name)
                while c.ok && !is(&c, "{") {
                    if c.world.tokens.kinds[c.body.cursor] == .End || c.body.cursor >= block_end { fail(&mut c, "missing declaration body"); break }
                    skip_token(&mut c)
                }
                if c.ok { skip_body(&mut c); separators(&mut c) }
            }
            if c.ok { expect(&mut c, "}"); separators(&mut c) }
            continue
        }
        what := advance(&mut c)
        if opaque && what != "struct" { fail(&mut c, "expected opaque struct"); break }
        if what != "fn" && what != "struct" && what != "enum" { fail(&mut c, "expected fn, struct, enum or impl (imports must be loaded first)"); break }
        if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected declaration name"); break }
        name := advance(&mut c)
        if ((layout || resource) && what != "struct") || (unchecked && what != "fn") || (req_caps != 0 && what != "fn") || (c_variadic >= 0 && what != "fn") { fail(&mut c, "invalid declaration attribute"); break }
        if layout && resource { fail(&mut c, "@resource cannot be combined with @c_layout"); break }
        declarations.push(c.body.cursor)
        declaration_c_variadic.push(c_variadic)
        declaration_impl_targets.push(-1); declaration_impl_owners.push(owner)
        mut ty := -1
        if what != "fn" {
            reserved := c.specializations.reserved.remove(name)
            if !reserved && type_id(&c, name) >= 0 { fail(&mut c, "duplicate type") }
            else if name == "TaskID" || rules.reserved(name) { fail(&mut c, "reserved type name") }
            mut kind := 2; if what == "enum" { kind = 3 }
            if reserved { ty = type_id(&c, name) } else { ty = add_type(&mut c, name, kind, 0) }
            c.types.type_owners[ty] = owner
            c.types.c_record[ty] = layout; c.types.resource[ty] = resource; if opaque { c.types.opaque_owner[ty] = owner }
            if resource_method >= 0 { resource_types.push(ty); resource_methods.push(resource_method) }
            declaration_fns.push(-1)
        } else {
            if map.contains(&c.world.functions, name) || rules.reserved(name) { fail(&mut c, "duplicate or reserved function name") }
            fn_id := c.world.names.len
            c.world.function_owners.push(owner); c.world.test_functions.push(test)
            c.world.libraries.push(library.clone()); c.world.symbols.push(symbol.clone()); c.world.unsafe_functions.push(unchecked)
            c.world.impl_types.push(-1); c.world.impl_public.push(public)
            c.world.impl_has_self.push(false); c.world.impl_self_mut.push(false)
            c.world.impl_names.push(""); c.world.requires_caps.push(req_caps)
            map.put(&mut c.world.functions, name.clone(), i64(fn_id)); c.world.names.push(move name)
            declaration_fns.push(fn_id)
        }
        declaration_types.push(ty)
        if library != "" {
            while c.ok && !is(&c, "\n") && !is(&c, ";") && c.world.tokens.kinds[c.body.cursor] != .End {
                if is(&c, "{") { fail(&mut c, "external declaration cannot have a body"); break }
                skip_token(&mut c)
            }
            separators(&mut c); continue
        }
        while c.ok && !is(&c, "{") { if c.world.tokens.kinds[c.body.cursor] == .End { fail(&mut c, "missing declaration body"); break }; skip_token(&mut c) }
        if c.ok { skip_body(&mut c); separators(&mut c) }
    }
    for d in 0..declarations.len {
        if !c.ok { break }
        target_tok := declaration_impl_targets[d]
        if target_tok < 0 { continue }
        f := declaration_fns[d]
        target_name := c.world.tokens.texts[target_tok].clone()
        target_ty := type_id(&c, target_name)
        prelude_scalar := target_ty > 0 && target_ty < 13 && generics.generated(&c.specializations, c.world.tokens.starts[target_tok])
        if !prelude_scalar && (target_ty < 0 || (c.types.declared.type_kinds[target_ty] != 2 && c.types.declared.type_kinds[target_ty] != 3)) {
            c.body.cursor = target_tok
            fail(&mut c, "impl target must be a struct or enum declared in this module"); break
        }
        if !prelude_scalar && c.types.type_owners[target_ty] != declaration_impl_owners[d] {
            c.body.cursor = target_tok
            fail(&mut c, "cannot implement methods for an imported type"); break
        }
        m_name := c.world.impl_names[f].clone()
        method_key := target_ty.str() + ":" + m_name
        if map.contains(&c.world.methods, method_key) {
            c.body.cursor = declarations[d] - 1
            fail(&mut c, "duplicate method '" + m_name + "' on type"); break
        }
        c.world.impl_types[f] = target_ty
        map.put(&mut c.world.methods, move method_key, i64(f))
    }
    for d in 0..declarations.len {
        if !c.ok { break }
        c.body.cursor = declarations[d]; ty := declaration_types[d]
        if ty >= 0 {
            expect(&mut c, "{"); c.types.declared.type_starts[ty] = c.types.field_names.len; separators(&mut c)
            mut tag: i64 = 0
            while c.ok && !is(&c, "}") {
                if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected field or variant name"); break }
                name := advance(&mut c); mut ft := 0; payload := c.types.payload_types.len
                if c.types.declared.type_kinds[ty] == 2 {
                    for prior in c.types.declared.type_starts[ty]..c.types.field_names.len {
                        if c.types.field_names[prior] == name { fail(&mut c, "duplicate struct field '" + name + "'") }
                    }
                    expect(&mut c, ":"); ft = type_name(&mut c)
                    if c.types.declared.type_kinds[ft] == 4 || c.types.declared.type_kinds[ft] == 5 { fail(&mut c, "a field cannot store a borrow") }
                }
                else {
                    if eat(&mut c, "(") {
                        c.types.declared.type_kinds[ty] = 7
                        while c.ok {
                            pt := type_name(&mut c)
                            if pt == 0 && c.types.payload_types.len == payload && is(&c, ")") { break }
                            if pt == 0 || c.types.declared.type_kinds[pt] == 4 || c.types.declared.type_kinds[pt] == 5 { fail(&mut c, "invalid payload type") }
                            c.types.payload_types.push(pt)
                            if !eat(&mut c, ",") { break }
                        }
                        expect(&mut c, ")")
                    }
                    if eat(&mut c, "=") {
                        mut sign := ""; if eat(&mut c, "-") { sign = "-" }
                        value := rules.literal_integer(sign + advance(&mut c)); tag = value.value
                        if !value.ok { fail(&mut c, "invalid enum tag") }
                    }
                    if tag < -2147483648 || tag > 2147483647 { fail(&mut c, "enum tag out of range") }
                    for prior in c.types.declared.type_starts[ty]..c.types.field_names.len {
                        if c.types.field_names[prior] == name || c.types.field_values[prior] == tag { fail(&mut c, "duplicate enum variant or tag") }
                    }
                }
                c.types.payload_starts.push(payload); c.types.payload_counts.push(c.types.payload_types.len - payload)
                c.types.field_names.push(move name); c.types.field_types.push(ft); c.types.field_values.push(tag); tag = tag + 1
                if !eat(&mut c, ",") { separators(&mut c); if !is(&c, "}") { fail(&mut c, "expected field comma") } }; separators(&mut c)
            }
            c.types.declared.type_counts[ty] = c.types.field_names.len - c.types.declared.type_starts[ty]
            if c.types.declared.type_kinds[ty] == 3 && c.types.declared.type_counts[ty] == 0 { fail(&mut c, "enum requires at least one variant") }
        } else {
            fn_id := declaration_fns[d]
            c.types.self_type = c.world.impl_types[fn_id]
            expect(&mut c, "("); first := c.world.param_names.len
            while c.ok && !is(&c, ")") {
                param_index := c.world.param_names.len - first
                consuming := eat(&mut c, "move")
                if !consuming && eat(&mut c, "&") {
                    is_mut := eat(&mut c, "mut")
                    param_tok := c.body.cursor
                    if !eat(&mut c, "self") { fail(&mut c, "expected 'self' after '&' in receiver parameter"); break }
                    if c.types.self_type < 0 { fail(&mut c, "'self' parameter is only valid inside an impl block"); break }
                    if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of an impl method"); break }
                    c.world.impl_has_self[fn_id] = true
                    mut ref_kind := 4; if is_mut { ref_kind = 5 }
                    mode := compound(&mut c, ref_kind, c.types.self_type)
                    c.world.param_tokens.push(param_tok); c.world.param_names.push("self"); c.world.param_types.push(mode)
                } else {
                    is_mut := eat(&mut c, "mut")
                    if is_mut && !is(&c, "self") { fail(&mut c, "expected 'self' after 'mut' in receiver parameter"); break }
                    if is(&c, "self") {
                        param_tok := c.body.cursor; parameter := advance(&mut c)
                        if c.types.self_type < 0 { fail(&mut c, "'self' parameter is only valid inside an impl block"); break }
                        if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of an impl method"); break }
                        c.world.impl_has_self[fn_id] = true
                        c.world.impl_self_mut[fn_id] = is_mut
                        mut mode := parameter_mode(&mut c, c.types.self_type, true, false)
                        if eat(&mut c, ":") {
                            if is_mut { fail(&mut c, "cannot combine 'mut self' with an explicit ': Type'"); break }
                            pt := type_name(&mut c)
                            if pt == c.types.self_type {
                                mode = parameter_mode(&mut c, pt, true, false)
                            } else if (ft.type_kind(&c.types, pt) == 4 || ft.type_kind(&c.types, pt) == 5) && ft.type_base(&c.types, pt) == c.types.self_type {
                                if consuming { fail(&mut c, "move argument requires a consuming parameter"); break }
                                mode = parameter_mode(&mut c, pt, false, false)
                            } else {
                                fail(&mut c, "self parameter must have type Self, &Self or &mut Self"); break
                            }
                        }
                        c.world.param_tokens.push(param_tok); c.world.param_names.push(move parameter); c.world.param_types.push(mode)
                    } else {
                        c.world.param_tokens.push(c.body.cursor); parameter := advance(&mut c); expect(&mut c, ":"); pt := type_name(&mut c)
                        mode := parameter_mode(&mut c, pt, consuming, c.world.libraries[c.world.returns.len] != "")
                        c.world.param_names.push(move parameter); c.world.param_types.push(mode)
                    }
                }
                if !eat(&mut c, ",") { break }
            }
            expect(&mut c, ")"); c.world.param_starts.push(first); c.world.param_counts.push(c.world.param_names.len - first)
            mut ret := 0; if eat(&mut c, "->") { ret = type_name(&mut c) }; c.world.returns.push(ret)
            c.types.self_type = -1
            f := c.world.returns.len - 1
            if c.world.test_functions[f] && (c.world.param_counts[f] != 0 || ret != 0) { fail(&mut c, "@test function must take no parameters and return ()") }
            if c.world.libraries[f] != "" {
                mut args: []i32 = []
                for p in first..c.world.param_names.len { args.push(c.world.param_types[p]) }
                ft := foreign_variadic_type(&mut c, &args, ret, declaration_c_variadic[d]); c.world.ffi_types.push(ft)
                if !is(&c,"\n") && !is(&c,";") && c.world.tokens.kinds[c.body.cursor] != .End { fail(&mut c,"unexpected token after external declaration") }
                c.world.starts.push(0); c.world.ends.push(0); continue
            }
            mut ordinary_args: []i32 = []
            for p in first..c.world.param_names.len {
                if c.world.param_names[p] != "__dunder_module_env" { ordinary_args.push(c.world.param_types[p]) }
            }
            source := result_parameter(&mut c, &ordinary_args, ret, first)
            signature := callable_with_parameter(&mut c, &ordinary_args, ret, 9, source); c.world.ffi_types.push(signature)
            newlines(&mut c); expect(&mut c, "{"); c.world.starts.push(c.body.cursor); c.world.ends.push(c.world.closes[c.body.cursor - 1])
            if ret != 0 { newlines(&mut c); if is(&c, "}") { fail(&mut c, "function can finish without returning a value") } }
        }
    }
    for i in 0..resource_types.len {
        if !c.ok { break }
        ty := resource_types[i]; c.body.cursor = resource_methods[i]
        hook := impl_method(&c, ty, c.world.tokens.texts[c.body.cursor])
        if hook < 0 || c.world.impl_public[hook] || c.world.unsafe_functions[hook] || c.world.requires_caps[hook] != 0 ||
            !c.world.impl_has_self[hook] || c.world.param_counts[hook] != 1 || c.world.returns[hook] != 0 ||
            ft.type_kind(&c.types, c.world.param_types[c.world.param_starts[hook]]) != 4 {
            fail(&mut c, "@resource cleanup requires a private safe method taking only &self and returning ()")
            break
        }
        c.types.cleanup_methods[ty] = hook
        c.types.has_cleanup = true
    }
    for i in 0..c.specializations.requirements.methods.len {
        if !c.ok { break }
        name := c.specializations.requirements.methods[i].clone()
        expected := c.specializations.requirements.signatures[i]
        f := impl_method(&c, c.specializations.requirements.receivers[i], name)
        if f < 0 { c.error = "unknown method '" + name + "' required by generic declaration" }
        else if !c.world.impl_public[f] || !c.world.impl_has_self[f] || c.world.unsafe_functions[f] ||
            c.world.requires_caps[f] != 0 || c.world.ffi_types[f] != expected {
            c.error = "required method '" + name + "' must be public and safe with signature " + ft.type_spelling(&c.types, expected)
        }
        if c.error != "" { c.ok = false; c.error_at = c.specializations.requirements.sites[i] }
    }
}
fn slot(c: &mut Session) -> i32 {
    result := c.body.slots; c.body.slots = c.body.slots + 1
    if c.body.slots > 65535 { fail(&mut c, "this compiler stage allows at most 65535 local slots per function") }
    result
}
fn local(body: &fc.FunctionContext, name: string) -> i32 {
    fc.local(&body, name)
}
fn type_spelling(c: &Session, ty: i32) -> string { ft.type_spelling(&c.types, ty) }
fn bind(c: &mut Session, model: &mut opt_ir.Function, move name: string, ty: i32, mutable: bool, index: i32, at: i32) {
    if c.report && at >= 0 && name != "__dunder_module_env" && c.world.tokens.starts[at] < c.world.source_end {
        facts.binding(&mut c.body.facts, at, ty)
    }
    if !rules.identifier(name) { fail(&mut c, "this compiler stage supports ASCII identifiers") }
    if rules.reserved(name) && name != "len" && !(name == "self" && c.body.has_self && c.body.locals.names.len == 0) {
        fail(&mut c, "reserved local name")
    }
    prior := locals.resolve(&c.body.locals, name)
    if prior >= 0 && c.body.locals.scopes[prior] == c.body.scope { fail(&mut c, "duplicate local name") }
    id := locals.add(&mut c.body.locals, move name, ty, mutable, c.body.scope, at)
    local_storage(&mut c, id, index, ty)
    if model.recording {
        mut param := -1
        if id < model.params { param = id }
        typed.local(&mut model, &c.body.locals, id, ft.scalar_type(&c.types, ty), param)
    }
}
fn local_storage(c: &mut Session, id: i32, index: i32, ty: i32) {
    ownership.add(&mut c.body.ownership, id)
    local_borrows.add_local(&mut c.body.local_loans, id)
    mut referent := ty; mut deref := 0; kind := ft.type_kind(&c.types, ty)
    if kind == 4 || kind == 5 { referent = ft.type_base(&c.types, ty); deref = kind - 3 }
    places.local(&mut c.body.places.arena, index, referent, read_shape(&c, referent, false), deref)
}
fn returned_place(c: &mut Session, ty: i32, token: i32) -> i32 {
    home := slot(&mut c); arm.store(&mut c.code, home, 0)
    id := locals.add(&mut c.body.locals, "_", ty, false, c.body.scope, token)
    _ := c.body.locals.active.pop()
    local_storage(&mut c, id, home, ty)
    local_borrows.transient(&mut c.body.local_loans, id, c.body.loan.path, c.body.loan.root, c.body.loan.origin)
    fc.clear_loan_eval(&mut c.body.loan)
    borrows.local_id(id)
}
fn read_returned(c: &mut Session, ty: i32, token: i32) -> i32 {
    place := returned_place(&mut c, ty, token)
    lower_place(&mut c, place, 0, .Value, token)
    c.body.places.current = place; c.body.places.source = token
    ft.type_base(&c.types, ty)
}
fn read_scalar_result(c: &mut Session, ty: i32, token: i32) -> i32 {
    if ft.type_kind(&c.types, ty) == 4 && ft.scalar_element(&c.types, ft.type_base(&c.types, ty)) {
        return read_returned(&mut c, ty, token)
    }
    ty
}
fn drop_locals_to(c: &mut Session, limit: i32, scope: i32) {
    first := locals.first_in_scope(&c.body.locals, limit, scope)
    if c.tasks.program { task_close_locals(&mut c, first) }
    while c.body.locals.active.len > first {
        id := c.body.locals.active.pop(); ty := c.body.locals.types[id]
        local_borrows.release_local(&mut c.body.local_loans, id)
        if owned(&c, ty) && !fc.pattern_loan(&c.body, id) { clear_owner(&mut c, places.local_home(c.body.places.arena.locals[id]), ty) }
    }
}
fn enter(c: &mut Session) { c.body.scope = c.body.scope + 1 }
fn leave(c: &mut Session) {
    drop_locals_to(&mut c, 0, c.body.scope)
    c.body.scope = c.body.scope - 1
}
fn narrow(c: &mut Session) {
    integers.check_i32(&mut c.code, c.overflow)
}
fn float_literal(c: &mut Session, spelling: string, expected: i32) -> i32 {
    mut ty := 7; if expected == 6 { ty = 6 }
    value := decimal.decode(spelling, ty == 6)
    if !value.ok { fail(&mut c, "floating literal is outside the finite range") }
    arm.imm(&mut c.code, 0, value.bits); ty
}
fn format_float(c: &mut Session, ty: i32, source: i32) {
    id := i32(map.get_or(&c.world.functions, "__dunder_module_format_float_bits", -1))
    task_edge(&mut c, id)
    if c.validating_dead { return }
    if id < 0 { fail(&mut c, "missing floating formatter"); return }
    c.body.facts.needed.push(id)
    arm.intrinsic_call(&mut c.code, c.fn_labels[id], .Format, ty, 4, source)
}
fn integer_literal(c: &mut Session, spelling: string, ty: i32) -> i64 {
    if unsigned.has(ty) {
        number := unsigned.literal(spelling, ty)
        if !number.ok { fail(&mut c, "unsigned integer literal out of range") }
        else if c.code.platform == 3 && ty == 12 && (number.value < 0 || number.value > 4294967295) { fail(&mut c, "usize literal exceeds wasm32 pointer width") }
        return number.value
    }
    mut value := rules.literal_integer(spelling)
    checked := rules.validate_signed(&mut value, ty)
    if !value.ok { fail(&mut c, "integer literal out of range") }
    value.value
}
fn literal(c: &mut Session, model: &mut opt_ir.Function, spelling: string, expected: i32) -> i32 {
    if floats.has(expected) { return float_literal(&mut c, spelling, expected) }
    mut ty := expected
    if !unsigned.has(ty) && ty != 2 { ty = 1 }
    value := integer_literal(&mut c, spelling, ty)
    if model.recording {
        if ty != 1 && ty != 2 { model.recording = false }
        else { _ := typed.node(&mut model, 1, ty, -1, -1, -1, value, -1, c.body.cursor - 1) }
    }
    if !c.code.checking || c.code.prefixing { arm.imm(&mut c.code, 0, value) }
    ty
}
fn intrinsic(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    mut covered := false
    result := intrinsic_dispatch(&mut c, name, expected, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
fn intrinsic_dispatch(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    raw_memory := name == "__sys_memory_copy" || name == "__sys_memory_equal"
    byte_buffer := name == "__sys_bytes_extend" || name == "__sys_bytes_append_text"
    if byte_buffer || name == "__sys_decode_utf8" || name == "__sys_decode_u8" || name == "__sys_decode_u8_range" { covered = true; task_effect(&mut c, 13) }
    else { task_effect(&mut c, 256) }
    mut target := -1; mut ret := expected
    if name == "__sys_arg_count" { covered = true; target = c.runtime.sys_arg_count; ret = 1 }
    else if name == "__sys_memory_copy" { covered = true; require_unsafe(&mut c); target = c.runtime.memory_copy; ret = 0 }
    else if name == "__sys_memory_equal" { covered = true; require_unsafe(&mut c); target = c.runtime.memory_equal; ret = 3 }
    else if name == "__sys_bytes_extend" { covered = true; target = c.runtime.bytes_extend; ret = 0 }
    else if name == "__sys_bytes_append_text" { covered = true; target = c.runtime.bytes_append_text; ret = 0 }
    else if name == "__sys_envp" { covered = true; require_unsafe(&mut c); target = c.runtime.sys_envp; ret = 13 }
    else if name == "__sys_linux_syscall" { covered = true; require_unsafe(&mut c); target = c.runtime.sys_linux_syscall; ret = 2 }
    else if name == "__sys_arg" { covered = true; target = c.runtime.sys_arg; ret = 4 }
    else if name == "__sys_pid" { covered = true; target = c.runtime.sys_pid; ret = 1 }
    else if name == "__sys_read_text" { covered = true; target = c.runtime.sys_read_text }
    else if name == "__sys_read_u8" { covered = true; target = c.runtime.sys_read_u8 }
    else if name == "__sys_metadata" { covered = true; target = c.runtime.sys_metadata }
    else if name == "__sys_same_file" { covered = true; target = c.runtime.sys_same_file; ret = 3 }
    else if name == "__sys_write_bytes" || name == "__sys_write_u8" { covered = true; target = c.runtime.sys_write_bytes }
    else if name == "__sys_make_executable" { covered = true; target = c.runtime.sys_make_executable }
    else if name == "__sys_rename" { covered = true; target = c.runtime.sys_rename }
    else if name == "__sys_remove_file" { covered = true; target = c.runtime.sys_remove_file }
    else if name == "__sys_decode_utf8" || name == "__sys_decode_u8" { covered = true; target = c.runtime.sys_decode_utf8 }
    else if name == "__sys_decode_u8_range" { covered = true; target = c.runtime.sys_decode_u8_range }
    else if name == "__sys_write_stderr" { covered = true; target = c.runtime.sys_stderr }
    else if name == "__sys_write_text" { covered = true; target = c.runtime.sys_write_text }
    else if name == "__sys_append_text" { covered = true; target = c.runtime.sys_append_text }
    else if name == "__sys_mkdir" { covered = true; target = c.runtime.sys_mkdir }
    else if name == "__sys_remove_dir" { covered = true; target = c.runtime.sys_remove_dir }
    else if name == "__sys_now_ms" { covered = true; target = c.runtime.sys_now_ms; ret = 2 }
    else if name == "__sys_net_listen" { covered = true; target = c.runtime.sys_net_listen; ret = 2 }
    else if name == "__sys_net_accept" { covered = true; target = c.runtime.sys_net_accept; ret = 2 }
    else if name == "__sys_net_connect" { covered = true; target = c.runtime.sys_net_connect; ret = 2 }
    else if name == "__sys_net_read" { covered = true; target = c.runtime.sys_net_read; ret = 2 }
    else if name == "__sys_net_write" { covered = true; target = c.runtime.sys_net_write; ret = 2 }
    else if name == "__sys_net_poll" { covered = true; target = c.runtime.sys_net_poll; ret = 2 }
    else if name == "__sys_net_set_nonblocking" { covered = true; target = c.runtime.sys_net_set_nonblocking; ret = 2 }
    else if name == "__sys_net_set_nodelay" { covered = true; target = c.runtime.sys_net_set_nodelay; ret = 2 }
    else if name == "__sys_net_local_port" { covered = true; target = c.runtime.sys_net_local_port; ret = 2 }
    else if name == "__sys_net_shutdown_write" { covered = true; target = c.runtime.sys_net_shutdown_write; ret = 2 }
    else if name == "__sys_net_close" { covered = true; target = c.runtime.sys_net_close; ret = 2 }
    if target < 0 { fail(&mut c, "unsupported intrinsic '" + name + "'"); return 0 }
    mut count := 0
    while c.ok && !is(&c, ")") {
        mut want := 0
        mut elem := 0; mut ref_kind := 4
        if raw_memory {
            want = 13; if count == 2 { want = 12 }
        } else if byte_buffer {
            if count == 0 { elem = 8; ref_kind = 5 }
            else if count == 1 && name == "__sys_bytes_extend" { elem = 8 }
            else if count == 1 { want = 4 }
            else { want = 1 }
        } else if count == 1 && (name == "__sys_write_bytes" || name == "__sys_write_u8" || name == "__sys_net_write") {
            elem = 1; if name != "__sys_write_bytes" { elem = 8 }
        } else if count == 0 && (name == "__sys_decode_utf8" || name == "__sys_decode_u8" || name == "__sys_decode_u8_range") {
            elem = 1; if name != "__sys_decode_utf8" { elem = 8 }
        } else if (count == 1 && (name == "__sys_read_u8" || name == "__sys_net_read")) || (count == 0 && name == "__sys_net_poll") {
            elem = 8; ref_kind = 5
        }
        if elem != 0 {
            if elem == 8 { covered = true }
            array := compound(&mut c, 1, elem); want = compound(&mut c, ref_kind, array)
        }
        mut arg_want := want
        if name == "__sys_linux_syscall" { arg_want = 2 }
        argument := c.body.cursor; ty := expression(&mut c, 0, arg_want, &catalog, &mut inline_work, &mut model)
        if arg_want != 0 { same(&mut c, arg_want, ty) }
        if elem != 0 { place_step(&mut c, .Read, ft.type_base(&c.types, want), ref_kind - 1, 3, 0, argument) }
        arm.push_temp(&mut c.code, 0); count = count + 1
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")")
    if name == "__sys_envp" && count != 0 { fail(&mut c, "__sys_envp expects no arguments"); return 0 }
    if name == "__sys_linux_syscall" && count != 7 { fail(&mut c, "__sys_linux_syscall expects 7 arguments"); return 0 }
    if raw_memory && count != 3 { fail(&mut c, name + " expects 3 arguments"); return 0 }
    if name == "__sys_bytes_extend" && count != 4 { fail(&mut c, name + " expects 4 arguments"); return 0 }
    if name == "__sys_bytes_append_text" && count != 2 { fail(&mut c, name + " expects 2 arguments"); return 0 }
    mut i := count - 1; while i >= 0 { arm.pop_temp(&mut c.code, i); i = i - 1 }
    arm.branch(&mut c.code, target, 1); ret
}
fn length_value(c: &mut Session, ty: i32, token: i32) -> i32 {
    if collection(&c, ty) || ft.type_kind(&c.types, ty) == 21 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Length), 1, token) }
    else if ty == 4 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Length), 0, token) }
    else { fail(&mut c, "len expects an array or string") }
    1
}
fn import_address(c: &mut Session, f: i32) {
    task_effect(&mut c, 32)
    if c.validating_dead { return }
    if c.code.platform == 3 {
        if !wasm_type(&mut c, c.world.ffi_types[f]) { return }
        request_symbol(&mut c, .WasmImport, f); arm.imm(&mut c.code, 0, 0); return
    }
    request_symbol(&mut c, .Import, f)
    arm.native_address(&mut c.code, 16); arm.mov(&mut c.code, 0, 16)
}
fn hfa(c: &Session, ty: i32, depth: i32) -> i32 { ft.hfa(&c.types, ty, depth) }
fn request_symbol(c: &mut Session, kind: facts.Symbol, operand: i32) {
    mut word := -1
    if !c.code.checking { word = arm.position(&c.code) }
    facts.symbol(&mut c.body.facts, kind, word, operand, c.body.cursor)
}
fn static_address(c: &mut Session, kind: facts.Symbol, operand: i32) {
    task_effect(&mut c, 64); request_symbol(&mut c, kind, operand)
    arm.native_address(&mut c.code, 16)
}
fn foreign_width(ty: i32) -> i32 { ft.foreign_width(ty) }
fn storage_type(c: &Session, ty: i32) -> i32 { ft.storage_type(&c.types, ty, c.code.platform) }
fn wasm_type(c: &mut Session, ty: i32) -> bool {
    if ft.is_c_record(&c.types, ft.type_base(&c.types, ty)) { fail(&mut c, "pass Wasm C records by pointer"); return false }
    first := ft.type_start(&c.types, ty)
    for p in first..(first + ft.type_count(&c.types, ty)) {
        if ft.is_c_record(&c.types, ft.parameter_type(&c.types, p)) { fail(&mut c, "pass Wasm C records by pointer"); return false }
    }
    true
}
fn wasm_signature(c: &mut Session, ty: i32) -> i32 {
    first := ft.type_start(&c.types, ty); count := ft.type_count(&c.types, ty)
    mut args: []i32 = []; args.reserve(count)
    for p in first..(first + count) { args.push(ft.parameter_type(&c.types, p)) }
    ret := ft.type_base(&c.types, ty)
    wa.signature(&mut c.wasm_abi, &args, ret)
}
fn foreign_call(c: &mut Session, sig: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    task_effect(&mut c, 32)
    if !c.body.unsafe_scope { fail(&mut c, "foreign call requires unsafe"); return 0 }
    callee := slot(&mut c); arm.store(&mut c.code, callee, 0)
    if c.code.platform == 3 {
        if !wasm_type(&mut c, sig) { return 0 }
        return invoke(&mut c, sig, callee, -1, 0, &catalog, &mut inline_work, &mut model)
    }
    first := ft.type_start(&c.types, sig); count := ft.type_count(&c.types, sig)
    variadic_fixed := ft.c_variadic_fixed(&c.types, sig)
    mut values: []i32 = []; mut locations: []i32 = []
    mut gp_limit := 8; if c.code.platform == 2 { gp_limit = 6 }
    ret := ft.type_base(&c.types, sig); ret_c_record := ft.is_c_record(&c.types, ret); mut ret_hfa := 0
    mut result_slot := -1; mut indirect_result := false
    if ret_c_record {
        ret_hfa = hfa(&c, ret, 0)
        if ret_hfa == 0 { fail(&mut c, "unsupported foreign aggregate result"); return 0 }
        result_slot = slot(&mut c)
        indirect_result = c.code.platform == 2 && ft.c_size(&c.types, ret) > 16
    }
    mut spec := fa.ForeignCallSpec { ret: ret, ret_c_record: ret_c_record, ret_hfa: ret_hfa,
        arg_types: [], arg_packed: [], arg_c_record: [], arg_hfas: [], arg_sizes: [] }
    mut gp := 0; if indirect_result { gp = 1 }; mut fp := 0; mut outgoing := 0
    while c.ok && !is(&c, ")") {
        if values.len == count { fail(&mut c, "too many C call arguments"); return 0 }
        is_variadic := variadic_fixed >= 0 && values.len >= variadic_fixed
        want := ft.parameter_type(&c.types, first + values.len)
        actual := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, actual)
        aggregate := ft.is_c_record(&c.types, want)
        if aggregate {
            if hfa(&c, want, 0) == 0 { fail(&mut c, "unsupported foreign aggregate parameter"); return 0 }
            take_value(&mut c, want); temp := temporary(&mut c, want)
        }
        value := slot(&mut c); arm.store(&mut c.code, value, 0); values.push(value)
        shape := hfa(&c, want, 0); mut need := shape; if shape < 0 { need = -shape }
        spec.arg_types.push(want); spec.arg_packed.push(storage_type(&c, want))
        spec.arg_c_record.push(aggregate); spec.arg_hfas.push(shape); spec.arg_sizes.push(ft.c_size(&c.types, want))
        if aggregate && c.code.platform == 2 {
            need = (ft.c_size(&c.types, want) + 7) / 8
            if need > 2 { need = 9 }
        }
        if c.code.platform == 0 && is_variadic {
            outgoing = (outgoing + 7) / 8 * 8
            locations.push(16 + outgoing); outgoing = outgoing + 8
        }
        else if need > 0 && fp + need <= 8 { locations.push(8 + fp); fp = fp + need }
        else if need == 0 && gp < gp_limit { locations.push(gp); gp = gp + 1 }
        else {
            if need > 0 && c.code.platform != 2 { fp = 8 }
            mut alignment := 8; mut width := 8
            if c.code.platform == 0 { alignment = foreign_width(want); width = alignment }
            if aggregate {
                width = ft.c_size(&c.types, want)
                if c.code.platform == 0 { alignment = ft.c_align(&c.types, want) } else { width = (width + 7) / 8 * 8 }
            }
            outgoing = (outgoing + alignment - 1) / alignment * alignment
            locations.push(16 + outgoing); outgoing = outgoing + width
        }
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")"); if count != values.len { fail(&mut c, "wrong C argument count"); return 0 }
    outgoing = (outgoing + 15) / 16 * 16
    if outgoing > 4080 { fail(&mut c, "C argument frame exceeds direct stack offset"); return 0 }
    if c.code.checking { return ret }
    if ret_c_record {
        arm.imm(&mut c.code, 0, i64(ft.c_size(&c.types, ret))); arm.branch(&mut c.code, c.runtime.alloc_record, 1)
        arm.store(&mut c.code, result_slot, 0)
    }
    mut patches := fa.new_patches(0)
    fa.emit_foreign_call(&mut c.code, &spec, callee, &values, &locations,
        result_slot, indirect_result, gp, fp, outgoing, c.has_callbacks,
        &mut patches, c.float_trap, c.overflow)
    for i in 0..patches.sites.len {
        facts.symbol(&mut c.body.facts, .CallbackStorage, patches.sites[i] / 4, -1 - patches.slots[i], c.body.cursor)
    }
    ret
}
fn c_layout(c: &mut Session, ty: i32) {
    if !c.ok { return }
    ft.c_layout(&mut c.types, c.code.platform, ty)
    check_type_error(&mut c)
}
fn validate_layouts(c: &mut Session) {
    if !c.ok { return }
    ft.validate_layouts(&mut c.types, c.code.platform)
    check_type_error(&mut c)
}
fn copy_inline(c: &mut Session, bytes: i32) { fa.copy_inline(&mut c.code, bytes) }
fn zero_record(c: &mut Session, ty: i32, at: i32) {
    bytes := ft.c_size(&c.types, ty)
    arm.allocate_value(&mut c.code, c.runtime.alloc_record, .CRecord, ty, bytes, c.world.tokens.starts[at])
    fa.clear_record(&mut c.code, bytes)
}
fn fixed_pod(c: &Session, ty: i32) -> bool { ft.fixed_pod(&c.types, ty) }
fn inline_value(c: &mut Session, ty: i32, access: borrows.Access, token: i32) {
    if ft.is_c_record(&c.types, ty) { return }
    if ft.type_kind(&c.types, ty) != 6 { place_transfer(&mut c, ty, 0, 0, true, true, i32(access), token); return }
    if !fixed_pod(&c, ty) { fail(&mut c, "inline C arrays require scalar elements"); return }
    elem := ft.type_base(&c.types, ty)
    mut local_slots := c.body.slots; mut err := ""
    fa.inline_descriptor(&mut c.code, ft.type_count(&c.types, ty), ft.c_size(&c.types, elem), &mut local_slots, &mut err)
    c.body.slots = local_slots
    if err != "" { fail(&mut c, err) }
}
fn store_inline(c: &mut Session, ty: i32, token: i32) {
    access := i32(borrows.Access.Address); kind := ft.type_kind(&c.types, ty)
    if !ft.is_c_record(&c.types, ty) && kind != 6 { place_transfer(&mut c, ty, 0, 1, false, true, access, token); return }
    if kind == 6 && !fixed_pod(&c, ty) { fail(&mut c, "inline C arrays require scalar elements"); return }
    mut fixed := 0; mut count := ft.c_size(&c.types, ty); mut stride := 1; mut part := 0
    if kind == 6 {
        fixed = 1; count = ft.type_count(&c.types, ty); elem := ft.type_base(&c.types, ty)
        stride = ft.c_size(&c.types, elem); mut width := 0
        while i32(1).shl(width) < ft.foreign_width(storage_type(&c, elem)) { width = width + 1 }
        if elem == 1 { width = 4 }; part = width + 1
    }
    place_step(&mut c, .CopySetup, ty, access, fixed, count, token)
    head := arm.label(&mut c.code); done := arm.label(&mut c.code)
    arm.mark(&mut c.code, head); place_step(&mut c, .CopyTest, ty, access, fixed, 0, token); arm.branch(&mut c.code, done, 2)
    place_step(&mut c, .CopyPart, ty, access, part, stride, token)
    arm.branch(&mut c.code, head, 0); arm.mark(&mut c.code, done)
}
fn callback_entry(c: &mut Session, id: i32) {
    mut ptypes: []i32 = []
    first := c.world.param_starts[id]; count := c.world.param_counts[id]
    ptypes.reserve(count)
    for p in 0..count { ptypes.push(c.world.param_types[first + p]) }
    mut patches := fa.new_patches(c.imports.globals)
    fa.emit_callback_entry(&mut c.code, &mut patches, c.fn_labels[id], c.callback_labels[id], &ptypes, c.world.returns[id])
    c.imports.globals = patches.globals
    for i in 0..patches.sites.len { c.imports.sites.push(patches.sites[i]); c.imports.slots.push(patches.slots[i]) }
}

fn require_unsafe(c: &mut Session) {
    task_effect(&mut c, 16)
    if !c.body.unsafe_scope { fail(&mut c, "operation requires unsafe function or block") }
}
fn raw_memory_type(c: &Session, name: string, start: i32) -> i32 {
    if name.len <= start { return -1 }
    ty := type_id(&c, name[start..name.len])
    if ty < 0 || !foreign_scalar(&c, ty) { return -1 }; ty
}
fn call(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    mut covered := false
    result := call_dispatch(&mut c, name, expected, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
// The first two words of every environment are its entry and its typed destructor.
fn install_callable(c: &mut Session, f: i32, env: i32) {
    arm.push_temp(&mut c.code, 0)
    arm.branch(&mut c.code, c.fn_labels[f], 20)
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 0)
    arm.push_temp(&mut c.code, 1)
    if !c.code.checking { drop := type_helper(&mut c, env, true); arm.branch(&mut c.code, drop, 20) }
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 8); arm.mov(&mut c.code, 0, 1)
}
fn function_value(c: &mut Session, f: i32, token: i32) -> i32 {
    if c.loans.active { c.body.facts.taken.push(f) }
    may_invalidate_operand(&mut c); c.body.facts.needed.push(f)
    sig := c.world.ffi_types[f]
    if !boxed_function(&c, sig) { arm.branch(&mut c.code, c.fn_labels[f], 20); return sig }
    arm.allocate_value(&mut c.code, c.runtime.alloc_record, .Record, c.closure_header, 16, c.world.tokens.starts[token])
    install_callable(&mut c, f, c.closure_header)
    temporary(&mut c, sig)
}
fn bind_closure(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    target := advance(&mut c); f := i32(map.get_or(&c.world.functions, target, -1))
    if f < 0 || c.closure_header < 0 || c.world.param_counts[f] == 0 { fail(&mut c, "invalid closure target"); return 0 }
    count := c.world.param_counts[f] - 1; first := c.world.param_starts[f]
    if c.world.param_names[first + count] != "__dunder_module_env" { fail(&mut c, "invalid closure environment"); return 0 }
    env := ft.type_base(&c.types, c.world.param_types[first + count])
    expect(&mut c, ",")
    actual := expression(&mut c, 0, env, &catalog, &mut inline_work, &mut model); same(&mut c, env, actual)
    if !c.ok { return 0 }
    expect(&mut c, ")")
    if c.body.expr.owner < 0 { fail(&mut c, "closure requires a fresh environment"); return 0 }
    owner_store(&mut c, .Transfer, env, c.body.expr.owner)
    fc.clear_expr(&mut c.body.expr)
    c.body.facts.needed.push(f)
    if c.loans.active { c.body.facts.taken.push(f) }
    install_callable(&mut c, f, env)
    c.world.ffi_types[f]
}
fn call_dispatch(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    expect(&mut c, "(")
    if name == "__dunder_module_bind" {
        covered = true
        return bind_closure(&mut c, &catalog, &mut inline_work, &mut model)
    }
    if name == "replace" && map.get_or(&c.world.functions, name, -1) < 0 { covered = true;
        return replace_value(&mut c, &catalog, &mut inline_work, &mut model)
    }
    if c.code.platform == 3 && name.len >= 6 && name[0..6] == "__sys_" && name != "__sys_decode_utf8" && name != "__sys_decode_u8" && name != "__sys_decode_u8_range" && name != "__sys_memory_copy" && name != "__sys_memory_equal" && name != "__sys_bytes_extend" && name != "__sys_bytes_append_text" { fail(&mut c, "native system calls need a native target"); return 0 }
    if name == "target_is" { covered = true;
        if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "target_is requires a target literal"); return 0 }
        target := advance(&mut c); expect(&mut c, ")")
        matched := tc_eval.target_match(c.code.platform, target)
        if matched < 0 { fail(&mut c, "unknown target '" + target + "'"); return 0 }
        arm.imm(&mut c.code, 0, i64(matched)); return 3
    }
    if name == "size_of" || name == "align_of" { covered = true;
        ty := type_name(&mut c); c_layout(&mut c, ty); expect(&mut c, ")")
        if name == "size_of" { arm.imm(&mut c.code, 0, i64(ft.c_size(&c.types, ty))) } else { arm.imm(&mut c.code, 0, i64(ft.c_align(&c.types, ty))) }
        return 12
    }
    if name == "zeroed" { covered = true;
        require_unsafe(&mut c); expect(&mut c, ")")
        if !ft.is_c_record(&c.types, expected) { fail(&mut c, "zeroed requires a C record"); return 0 }
        zero_record(&mut c, expected, c.body.cursor - 3); return expected
    }
    if name == "callback" { covered = true;
        task_effect(&mut c, 128)
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c)
        symbol := advance(&mut c); expect(&mut c, ")")
        id := i32(map.get_or(&c.world.functions, symbol, -1))
        if id < 0 || c.world.libraries[id] != "" { fail(&mut c, "callback requires a named Dunder function"); return 0 }
        mut params: []i32 = []
        for i in c.world.param_starts[id]..c.world.param_starts[id] + c.world.param_counts[id] {
            ty := c.world.param_types[i]
            if !foreign_scalar(&c, ty) { fail(&mut c, "callbacks require C scalar parameters"); return 0 }
            params.push(ty)
        }
        if c.world.returns[id] != 0 && !foreign_scalar(&c, c.world.returns[id]) { fail(&mut c, "callbacks require a C scalar return"); return 0 }
        if c.code.platform == 3 {
            ty := foreign_type(&mut c, &params, c.world.returns[id])
            c.body.facts.needed.push(id); request_symbol(&mut c, .WasmCallback, id)
            arm.imm(&mut c.code, 0, 0); return ty
        }
        if c.validating_dead { return foreign_type(&mut c, &params, c.world.returns[id]) }
        c.body.facts.needed.push(id); request_symbol(&mut c, .CallbackEntry, id)
        arm.branch(&mut c.code, c.fn_labels[id], 20)
        return foreign_type(&mut c, &params, c.world.returns[id])
    }
    if name == "static_bytes" { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c)
        if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "static storage requires a platform literal"); return 0 }
        platform := advance(&mut c); expect(&mut c, ",")
        if c.world.tokens.kinds[c.body.cursor] != .Integer { fail(&mut c, "static storage requires a positive constant size"); return 0 }
        length := rules.literal_integer(advance(&mut c)); expect(&mut c, ")")
        if !length.ok || length.value < 1 || length.value > 16777216 { fail(&mut c, "static byte count must be 1..16777216"); return 0 }
        if platform != "native" && platform != "macos" && platform != "linux" { fail(&mut c, "unknown static storage platform"); return 0 }
        if !c.validating_dead && (c.code.platform == 3 || (platform == "macos" && c.code.platform != 0) || (platform == "linux" && c.code.platform == 0)) {
            fail(&mut c, "static storage requires the selected native platform"); return 0
        }
        static_address(&mut c, .Static, i32(length.value)); arm.mov(&mut c.code, 0, 16); return 13
    }
    if name == "cstr" { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c)
        if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "cstr needs a string literal"); return 0 }
        value := peek(&c); for i in 0..value.len { if value[i] == 0 { fail(&mut c, "cstr contains an embedded NUL") } }
        mut place := 0; mut at := -1; mut pending := false
        arg := primary_inner(&mut c, 4, &catalog, &mut inline_work, &mut model, &mut place, &mut at, &mut pending); expect(&mut c, ")")
        arm.integer_binary(&mut c.code, 1, true, false, 0, 0, -1, 8); return 13
    }
    if name == "addr" { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c); token := c.body.cursor; expect(&mut c, "&"); write := eat(&mut c, "mut")
        previous_address := c.body.place.taking_address; c.body.place.taking_address = true
        ty := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
        c.body.place.taking_address = previous_address
        base := borrows.root(&c.body.places, c.body.places.current)
        if base < 0 { fail(&mut c, "addr requires a stored place"); return 0 }
        if write && is_for_locked(&c, base) { fail(&mut c, "cannot mutably borrow a collection while iterating over it"); return 0 }
        if write && !writable_loan(&mut c, c.body.places.current) { return 0 }
        if write { c.body.mutations.push(base) }
        if c.loans.active {
            origin := loan_origin(&c, c.body.places.current)
            if origin == -2 { fail(&mut c, "scratch storage cannot become a raw address"); return 0 }
            if origin >= 0 { c.body.facts.exposed.push(origin) }
        }
        if c.body.place.address < 0 || (write && !c.body.place.writable) { fail(&mut c, "addr requires a matching stored place"); return 0 }
        mut intent := 3; if write { intent = 4 }
        if ft.is_c_record(&c.types, ty) { place_step(&mut c, .BorrowPayload, ty, intent, 0, 0, token) }
        else if ft.type_kind(&c.types, ty) == 6 { place_step(&mut c, .Read, ty, intent, 3, 0, token) }
        else if c.body.place.direct && c.body.places.current < 0 { bound_place(&mut c, .BorrowHome, c.body.places.current, intent, token) }
        else { bound_place(&mut c, .BorrowSaved, c.body.places.current, intent, token) }
        expect(&mut c, ")"); return 13
    }
    if name == "ptr" || name == "ffi_fn" || name == "ref_at" { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c); mut want := 13; if name == "ptr" { want = 12 }
        ty := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, ty); expect(&mut c, ")")
        if name == "ptr" { return 13 }
        if name == "ffi_fn" { if ft.type_kind(&c.types, expected) != 8 { fail(&mut c,"ffi_fn needs an extern fn type") }; return expected }
        if ft.type_kind(&c.types, expected) != 4 && ft.type_kind(&c.types, expected) != 5 { fail(&mut c,"ref_at needs a reference parameter type"); return 0 }
        fc.clear_loan_eval(&mut c.body.loan)
        return expected
    }
    if name.len > 5 && name[0..5] == "load_" && raw_memory_type(&c, name, 5) >= 0 { covered = true;
        require_unsafe(&mut c); token := c.body.cursor - 2; ty := raw_memory_type(&c, name, 5)
        a := expression(&mut c, 0, 13, &catalog, &mut inline_work, &mut model); same(&mut c, 13, a); expect(&mut c, ")"); place_transfer(&mut c, ty, 0, 0, true, true, 0, token); return ty
    }
    if name.len > 6 && name[0..6] == "store_" && raw_memory_type(&c, name, 6) >= 0 { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c); token := c.body.cursor - 2; ty := raw_memory_type(&c, name, 6)
        a := expression(&mut c, 0, 13, &catalog, &mut inline_work, &mut model); same(&mut c, 13, a); expect(&mut c, ","); arm.push_temp(&mut c.code, 0)
        b := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, b); expect(&mut c, ")")
        arm.pop_temp(&mut c.code, 1); place_transfer(&mut c, ty, 0, 1, false, true, 1, token); return 0
    }
    if name.len >= 6 && name[0..6] == "__sys_" { covered = true; return intrinsic(&mut c, name, expected, &catalog, &mut inline_work, &mut model) }
    if name == "len" { covered = true;
        token := c.body.cursor - 2; mut ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
        expect(&mut c, ")")
        if ft.type_kind(&c.types, ty) == 4 { ty = read_returned(&mut c, ty, token) }
        return length_value(&mut c, ty, token)
    }
    if name == "print" { covered = true; token := c.body.cursor - 2; source := c.world.tokens.starts[token]
        task_effect(&mut c, 256)
        value := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
        ty := read_scalar_result(&mut c, value, token)
        if c.code.platform == 3 {
            if ty < 1 || ty > 12 { fail(&mut c, "print requires a scalar value"); return 0 }
            arm.intrinsic_call(&mut c.code, -1, .Print, ty, 0, source); return 0
        }
        mut target := c.print_int; mut input := ty
        if ty == 3 { target = c.print_bool } else if ty == 4 { target = c.print_text }
        else if floats.has(ty) { format_float(&mut c, ty, source); input = 4; saved_float := temporary(&mut c, 4); target = c.print_text }
        else if ty == 5 { arm.intrinsic_call(&mut c.code, c.runtime.string_rune, .Format, ty, 4, source); input = 4; saved_rune := temporary(&mut c, 4); target = c.print_text }
        else if ty != 1 && ty != 2 && ty != 5 && !unsigned.has(ty) { fail(&mut c, "print requires a scalar value") }
        arm.intrinsic_call(&mut c.code, target, .Print, input, 0, source); return 0
    }
    if name == "assert" {
        call_at := c.body.cursor - 2; first := c.body.cursor; covered = true
        previous := c.body.assert_operands
        c.body.assert_operands = assert_operands(&c, first, true)
        ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty)
        operands := c.body.assert_operands; c.body.assert_operands = previous
        last := c.body.cursor - 1; expect(&mut c, ")")
        assert_value(&mut c, call_at, first, last, &operands); return 0
    }
    if name == "i32" || name == "i64" || name == "rune" || floats.has(type_id(&c, name)) || unsigned.has(type_id(&c, name)) { covered = true;
        hint := type_id(&c, name)
        mut argument_hint := 0
        token := c.body.cursor - 2; offset := c.world.tokens.starts[token]
        mut literal_at := c.body.cursor; if is(&c, "-") { literal_at = literal_at + 1 }
        if (c.world.tokens.kinds[literal_at] == .Integer || c.world.tokens.kinds[literal_at] == .Float) && c.world.tokens.texts[literal_at + 1] == ")" {
            if floats.has(hint) || c.world.tokens.kinds[literal_at] == .Integer { argument_hint = hint }
        }
        value := expression(&mut c, 0, argument_hint, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
        ty := read_scalar_result(&mut c, value, token)
        if floats.has(ty) || floats.has(hint) {
            if (!floats.has(ty) && ty != 1 && ty != 2 && !unsigned.has(ty)) || hint == 5 { fail(&mut c, "expected a numeric conversion"); return hint }
            floats.cast(&mut c.code, ty, hint, c.float_trap, offset); return hint
        }
        if ty == 13 && hint == 12 { require_unsafe(&mut c); return 12 }
        if ty != 1 && ty != 2 && ty != 5 && !unsigned.has(ty) && ft.type_kind(&c.types, ty) != 3 { fail(&mut c, "integer conversion requires an integer") }
        if hint == 5 { arm.intrinsic_call(&mut c.code, c.runtime.valid_rune, .CheckRune, ty, hint, offset) }
        unsigned.cast(&mut c.code, ty, hint, c.overflow)
        if hint == 1 { narrow(&mut c) }; return hint
    }
    covered = true
    f := i32(map.get_or(&c.world.functions, name, -1)); callee := local(&c.body, name)
    mut signature := -1; mut address := -1
    if callee >= 0 {
        signature = c.body.locals.types[callee]
        if ft.type_kind(&c.types, signature) != 9 { fail(&mut c, "local value is not callable"); return 0 }
        address = slot(&mut c); arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[callee])); arm.store(&mut c.code, address, 0)
    } else {
        if f < 0 { fail(&mut c, "unknown function '" + name + "'"); c.error_at = c.world.tokens.starts[c.body.cursor - 2]; return 0 }
        check_function_caps(&mut c, f, c.body.cursor - 2)
        if !c.ok { return 0 }
        if c.world.unsafe_functions[f] && !c.body.unsafe_scope { fail(&mut c, "call requires unsafe"); return 0 }
        if c.world.libraries[f] != "" { import_address(&mut c, f); return foreign_call(&mut c, c.world.ffi_types[f], &catalog, &mut inline_work, &mut model) }
        c.body.facts.needed.push(f); signature = c.world.ffi_types[f]
    }
    invoke(&mut c, signature, address, f, -1, &catalog, &mut inline_work, &mut model)
}
fn scoped_borrow_body(c: &Session, f: i32) -> bool {
    for i in c.world.starts[f]..c.world.ends[f] {
        if c.world.tokens.kinds[i] != .Symbol || c.world.tokens.texts[i] != "&" || c.world.tokens.texts[i + 1] == "mut" { continue }
        mut before := i - 1
        while before >= c.world.starts[f] && (lexer.is_newline(c.world.tokens.kinds[before]) || c.world.tokens.texts[before] == "(") { before -= 1 }
        if before >= 0 && (c.world.tokens.texts[before] == ":=" || c.world.tokens.texts[before] == "=") { return true }
        mut at := i + 1
        if c.world.tokens.kinds[at] != .Name { return true }
        if c.world.tokens.texts[at] == "await" || c.world.tokens.texts[at] == "spawn" { return true }
        if map.get_or(&c.world.functions, c.world.tokens.texts[at], -1) >= 0 || resolve_type_name(&c, c.world.tokens.texts[at]) >= 0 { return true }
        at += 1
        while at < c.world.ends[f] {
            token := c.world.tokens.texts[at].clone()
            if token == "(" || token == "{" || token == "::" { return true }
            if token == "." {
                if c.world.tokens.texts[at + 1] == "len" { return true }
                at += 2
            } else if token == "[" {
                mut depth := 1; at += 1
                while at < c.world.ends[f] && depth > 0 {
                    if c.world.tokens.texts[at] == ".." { return true }
                    if c.world.tokens.texts[at] == "[" { depth += 1 }
                    if c.world.tokens.texts[at] == "]" { depth -= 1 }
                    at += 1
                }
            } else { break }
        }
    }
    false
}
fn needs_loan_analysis(c: &Session, f: i32) -> bool {
    if !c.loans.active { return false }
    for p in c.world.param_starts[f]..c.world.param_starts[f] + c.world.param_counts[f] {
        kind := ft.type_kind(&c.types, c.world.param_types[p])
        if kind == 4 || kind == 5 { return true }
    }
    for i in c.world.starts[f]..c.world.ends[f] {
        if c.world.tokens.kinds[i] == .Name && c.world.tokens.texts[i] == "region" && c.world.tokens.kinds[i + 1] == .Name { return true }
    }
    scoped_borrow_body(&c, f)
}
fn loan_origin(c: &Session, place: i32) -> i32 {
    binding := borrows.root(&c.body.places, place)
    if binding < 0 { return -1 }
    if local_borrows.shared(&c.body.local_loans, binding) { return local_borrows.origin(&c.body.local_loans, binding) }
    kind := ft.type_kind(&c.types, c.body.locals.types[binding])
    if kind == 21 { return -2 }
    if c.body.locals.scopes[binding] == 0 && (kind == 4 || kind == 5) {
        return c.body.first_parameter + binding
    }
    -1
}
fn forward_loan(c: &mut Session, origin: i32, f: i32, signature: i32, parameter: i32, at: i32) {
    if origin == -1 { return }
    if f >= 0 {
        facts.forward(&mut c.body.facts, origin, c.world.param_starts[f] + parameter, at)
    } else if signature < c.types.declared.type_kinds.len {
        facts.indirect(&mut c.body.facts, origin, signature, parameter, at)
    }
}
fn forward_argument_loan(c: &mut Session, origin: i32, constrained: bool, f: i32, signature: i32, parameter: i32, at: i32) {
    forward_loan(&mut c, origin, f, signature, parameter, at)
    if constrained && origin != -3 { forward_loan(&mut c, -3, f, signature, parameter, at) }
}
fn charge_inline(c: &mut Session, declaration: i32, estimate: i32, first_word: i32) -> bool {
    actual := arm.position(&c.code) - first_word
    if first_word < 0 || declaration >= c.world.names.len || estimate < 0 || actual < 0 || actual > estimate {
        fail(&mut c, "internal inline growth accounting failure"); return false
    }
    mut recorded := false
    if declaration >= 0 { recorded = fragments.record_dependency(&mut c.body.inline_deps, declaration, estimate) }
    else { recorded = fragments.charge_dependency_words(&mut c.body.inline_deps, estimate) }
    if !recorded { fail(&mut c, "internal inline dependency admission failure"); return false }
    c.bindings.inlined_calls = c.bindings.inlined_calls + 1; c.bindings.inlined_words = c.bindings.inlined_words + actual
    c.bindings.inline_estimated_words = c.bindings.inline_estimated_words + estimate
    true
}
fn inline_rune_stream(c: &mut Session, values: i32, cursor: i32, source: i32) -> bool {
    estimate := runtime.utf8_next_word_estimate() + 16
    if !c.inline_enabled || c.validating_dead || c.code.checking ||
        fragments.remaining_words(&c.body.inline_deps) < estimate { return false }
    first := arm.position(&c.code)
    arm.load(&mut c.code, values)
    iteration.rune(&mut c.code, source)
    arm.store(&mut c.code, cursor, 1)
    charged := charge_inline(&mut c, -1, estimate, first)
    true
}
fn starts_borrow(c: &Session) -> bool {
    mut at := c.body.cursor
    while at < c.world.tokens.kinds.len && c.world.tokens.kinds[at] == .Symbol && c.world.tokens.texts[at] == "(" { at = at + 1 }
    if at >= c.world.tokens.kinds.len { return false }
    if c.world.tokens.kinds[at] == .Symbol && c.world.tokens.texts[at] == "&" { return true }
    c.world.tokens.kinds[at] == .Name && c.world.tokens.texts[at] == "ref_at" &&
        local(&c.body, "ref_at") < 0 && at + 1 < c.world.tokens.kinds.len &&
        c.world.tokens.kinds[at + 1] == .Symbol && c.world.tokens.texts[at + 1] == "("
}
fn read_argument(c: &mut Session, ty: i32, token: i32) {
    place := c.body.places.current
    if place != 0 {
        lower_place(&mut c, place, 0, .ValueAndAddress, token)
        borrow_address(&mut c, ty, false, token, place)
    } else if ft.is_c_record(&c.types, ty) || fixed_pod(&c, ty) {
        borrow_address(&mut c, ty, false, token, 0)
    } else {
        home := slot(&mut c); arm.store(&mut c.code, home, 0); place_step(&mut c, .BorrowHome, ty, 3, 0, home, token)
    }
    c.body.loan.path = owner_path(&c, place); c.body.loan.root = source_root(&c, place)
    c.body.loan.origin = loan_origin(&c, place)
    binding := borrows.root(&c.body.places, place)
    c.body.loan.constrained = local_borrows.shared(&c.body.local_loans, binding)
}
fn invoke(c: &mut Session, signature: i32, address: i32, f: i32, wasm_sig: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    empty_ints: []i32 = []
    invoke_with_args(&mut c, signature, address, f, wasm_sig, &empty_ints, &empty_ints, &empty_ints, &empty_ints, &empty_ints, c.body.scratch_returns.len, c.body.cursor - 1, &catalog, &mut inline_work, &mut model)
}
fn returns_array_view(c: &Session, ty: i32) -> bool {
    ft.type_kind(&c.types, ty) == 4 && ft.type_kind(&c.types, ft.type_base(&c.types, ty)) == 1
}
fn invoke_with_args(c: &mut Session, signature: i32, address: i32, f: i32, wasm_sig: i32,
    args_in: &[]i32, starts_in: &[]i32, places_in: &[]i32, sources_in: &[]i32, effects_in: &[]i32, first_writeback: i32, call_token: i32,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    source_offset := c.world.tokens.starts[call_token]
    boxed := address >= 0 && wasm_sig < 0 && boxed_function(&c, signature)
    if boxed {
        // Argument evaluation may replace the source binding.
        arm.load(&mut c.code, address); copy_value(&mut c, signature)
        pin := slot(&mut c); save_owner(&mut c, pin, signature, true)
    }
    if address >= 0 || wasm_sig >= 0 { task_edge(&mut c, -1) } else { task_edge(&mut c, f) }
    first := ft.type_start(&c.types, signature); count := ft.type_count(&c.types, signature)
    source_parameter := ft.return_borrow_parameter(&c.types, signature)
    mut result_origin := -1
    mut provided := args_in.len
    pending := c.body.pending.slots.len
    for arg in 0..provided { stage_owner(&mut c, .Argument, args_in[arg], ft.parameter_type(&c.types, first + arg), 0) }
    mut args: []i32 = []; mut arg_starts: []i32 = []; mut arg_sources: []i32 = []; mut effects: []i32 = []
    mut arg_roots: []i32 = []; mut arg_paths: []i32 = []
    for v in &args_in { args.push(v) }
    for v in &starts_in { arg_starts.push(v) }
    for v in &places_in { arg_roots.push(source_root(&c, v)); arg_paths.push(owner_path(&c, v)) }
    if source_parameter >= 0 && source_parameter < provided { result_origin = loan_origin(&c, places_in[source_parameter]) }
    for v in &sources_in { arg_sources.push(v) }
    for v in &effects_in { effects.push(v) }
    while c.ok && !is(&c, ")") {
        if provided >= count { fail(&mut c, "too many arguments"); break }
        argument := c.body.cursor; consuming := eat(&mut c, "move")
        arg_starts.push(argument); effects.push(c.body.mutations.len)
        want := ft.parameter_type(&c.types, first + provided); want_kind := ft.type_kind(&c.types, want)
        implicit_borrow := want_kind == 4 && !starts_borrow(&c)
        mut context := want; if implicit_borrow { context = ft.type_base(&c.types, want) }
        if consuming && (want_kind == 4 || want_kind == 5) { fail(&mut c, "move argument requires a consuming parameter"); return 0 }
        previous_address := c.body.place.taking_address; c.body.place.taking_address = implicit_borrow
        mut ty := expression(&mut c, 0, context, &catalog, &mut inline_work, &mut model)
        c.body.place.taking_address = previous_address
        if implicit_borrow {
            if ty != want {
                same(&mut c, context, ty); if !c.ok { return 0 }
                read_argument(&mut c, ty, argument); ty = want
            }
        } else {
            same(&mut c, want, ty)
            if ft.move_only(&c.types, want) && c.body.expr.owner < 0 && !consuming { fail(&mut c, "consuming parameter requires 'move value' or a fresh owned expression"); return 0 }
            take_value(&mut c, ty)
        }
        if provided == source_parameter {
            result_origin = c.body.loan.origin
            if c.body.loan.root < 0 { c.body.loan.constrained = true }
        }
        if c.loans.active && (ft.type_kind(&c.types, want) == 4 || ft.type_kind(&c.types, want) == 5) {
            origin := c.body.loan.origin
            mut callee := f; if address >= 0 { callee = -1 }
            forward_argument_loan(&mut c, origin, c.body.loan.constrained, callee, signature, provided, c.world.tokens.starts[argument])
            record := ft.type_base(&c.types, want)
            if origin == -2 && c.body.place.scratch == 1 && ft.type_kind(&c.types, want) == 5 && ft.type_kind(&c.types, record) == 2 && !ft.is_c_record(&c.types, record) {
                place_step(&mut c, .Read, record, 4, 3, 0, argument)
                destination := slot(&mut c); arm.store(&mut c.code, destination, 0)
                copy_value(&mut c, record)
                owner := slot(&mut c); save_owner(&mut c, owner, record, true)
                c.body.scratch_returns.push(destination); c.body.scratch_returns.push(owner)
                c.body.scratch_returns.push(record); c.body.scratch_returns.push(argument)
                place_step(&mut c, .BorrowHome, record, 4, 0, owner, argument)
            }
        }
        index := slot(&mut c); arm.store(&mut c.code, index, 0); args.push(index)
        stage_owner(&mut c, .Argument, index, want, 0)
        mut root := source_root(&c, c.body.places.current); mut path := owner_path(&c, c.body.places.current)
        if c.body.loan.root >= 0 { root = c.body.loan.root; path = c.body.loan.path }
        arg_roots.push(root); arg_paths.push(path)
        mut source := c.body.places.source; if source < 0 { source = argument }
        arg_sources.push(source); provided = provided + 1
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")"); if provided != count { fail(&mut c, "wrong argument count") }
    fc.finish_pending(&mut c.body.pending, pending)
    if !c.ok { return 0 }
    effects.push(c.body.mutations.len)
    for arg in 0..provided {
        want := ft.parameter_type(&c.types, first + arg)
        if ft.type_kind(&c.types, want) != 4 && ft.type_kind(&c.types, want) != 5 { continue }
        root := arg_roots[arg]
        if root < 0 { continue }
        if !ownership.available(&c.body.ownership, arg_paths[arg]) { fail(&mut c, "cannot move a value while it is borrowed by another argument"); c.error_at = c.world.tokens.starts[arg_starts[arg]]; return 0 }
        for sibling in 0..provided {
            if sibling == arg { continue }
            sibling_kind := ft.type_kind(&c.types, ft.parameter_type(&c.types, first + sibling))
            if (sibling_kind == 4 || sibling_kind == 5) && arg_roots[sibling] == root &&
                (ft.type_kind(&c.types, want) == 5 || sibling_kind == 5) {
                fail(&mut c, "mutable arguments must not alias another borrow in the same call")
                c.error_at = c.world.tokens.starts[arg_sources[sibling]]; return 0
            }
            if sibling > arg && borrows.changed(&c.body.mutations, effects[sibling], effects[sibling + 1], root) {
                fail(&mut c, "cannot mutate a value while it is borrowed by another argument")
                c.error_at = c.world.tokens.starts[arg_starts[sibling]]; return 0
            }
        }
    }
    if source_parameter < 0 && c.inline_enabled && !c.validating_dead && !c.code.checking && f >= 0 && address < 0 && wasm_sig < 0 &&
        fragments.remaining_words(&c.body.inline_deps) > 0 && opt_inline.find_view(&catalog, f) >= 0 {
        mut arg_types: []i32 = []
        for p in 0..provided { arg_types.push(ft.parameter_type(&c.types, first + p)) }
        budget := fragments.remaining_words(&c.body.inline_deps)
        if opt_inline.prepare_view(&mut inline_work, &catalog, f, address, &arg_types, ft.type_base(&c.types, signature), &args, c.body.slots, c.code.platform, budget) {
            estimate := opt_inline.word_estimate(&inline_work)
            first_word := arm.position(&c.code)
            if opt_inline.emit_view(&mut inline_work, &mut c.code, &catalog, c.overflow, c.zero, c.bounds) {
                if !charge_inline(&mut c, f, estimate, first_word) { return 0 }
                return ft.type_base(&c.types, signature)
            }
        }
    }
    mut label := -1
    if f >= 0 { label = c.fn_labels[f] }
    if wasm_sig >= 0 { request_symbol(&mut c, .WasmCall, signature) }
    result := ft.type_base(&c.types, signature)
    mut entry := address
    if boxed {
        entry = slot(&mut c)
        arm.load(&mut c.code, address); load_mem(&mut c, 0, 0, 0); arm.store(&mut c.code, entry, 0)
        arm.address(&mut c.code, address); arm.push(&mut c.code, 0)
    }
    view := returns_array_view(&c, result)
    if view {
        for _ in 0..6 { _ := slot(&mut c) }
        holder := slot(&mut c)
        borrowed_view.pass_result(&mut c.code, holder)
    }
    source_call.lower(&mut c.code, label, entry, wasm_sig, &args, signature, result, source_offset)
    if view { arm.pop(&mut c.code, 9) }
    if boxed { arm.pop(&mut c.code, 9) }
    if c.body.scratch_returns.len > first_writeback {
        arm.push_temp(&mut c.code, 0)
        while c.body.scratch_returns.len > first_writeback {
            argument := c.body.scratch_returns.pop(); record := c.body.scratch_returns.pop()
            owner := c.body.scratch_returns.pop(); destination := c.body.scratch_returns.pop()
            arm.load(&mut c.code, owner); arm.mov(&mut c.code, 1, 0)
            arm.load(&mut c.code, destination); place_step(&mut c, .RegionWrite, record, 4, 0, ft.type_count(&c.types, record), argument)
        }
        arm.pop_temp(&mut c.code, 0)
    }
    fc.clear_loan_eval(&mut c.body.loan)
    if source_parameter >= 0 {
        c.body.loan.path = arg_paths[source_parameter]; c.body.loan.root = arg_roots[source_parameter]
        c.body.loan.origin = result_origin; c.body.loan.constrained = true
    }
    result
}
fn primary(c: &mut Session, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "expression nesting exceeds 128"); c.body.depth = c.body.depth - 1; return 0 }
    fc.clear_rvalue_place(&mut c.body.place); c.body.place.scratch = 0
    fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
    first_token := c.body.cursor
    mut place := 0; mut at := -1; mut pending := false
    mut ty := primary_inner(&mut c, expected, &catalog, &mut inline_work, &mut model, &mut place, &mut at, &mut pending)
    mut materialized := 0; mut projection_address := c.body.expr.move_projection
    mut temporary_root := c.body.expr.owner; if temporary_root < 0 { temporary_root = c.body.expr.move_temporary }
    while c.ok {
        if c.world.tokens.kinds[c.body.cursor] == .GroupedNewline && ty != 0 {
            next := c.world.tokens.texts[c.body.cursor + 1].clone()
            mut receiver := ty; if ft.type_kind(&c.types, ty) == 4 { receiver = ft.type_base(&c.types, ty) }
            kind := ft.type_kind(&c.types, receiver)
            if next == "(" && kind != 8 && kind != 9 { break }
            if next == "[" && receiver != 4 && !collection(&c, receiver) { break }
            skip_token(&mut c)
        }
        if c.world.tokens.kinds[c.body.cursor] != .Symbol { break }
        postfix := c.world.tokens.texts[c.body.cursor].clone()
        if postfix.len != 1 { break }
        first := postfix[0]
        if first != 46 && first != 91 && first != 40 && first != 63 { break }
        if first == 63 {
            if model.probing && decline_projection(&mut c, &mut model) { break }
            question := c.body.cursor
            skip_token(&mut c)
            if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
            c.body.places.current = place; c.body.places.source = at
            c.body.expr.move_projection = projection_address; c.body.expr.move_temporary = temporary_root
            if place == 0 && temporary_root >= 0 && projection_address < 0 { fc.produce_owner(&mut c.body.expr, temporary_root, ty) }
            ty = propagate_result(&mut c, ty, question)
            place = 0; materialized = 0; at = -1
            temporary_root = c.body.expr.owner; projection_address = -1
            fc.clear_rvalue_place(&mut c.body.place)
            continue
        }
        if ft.type_kind(&c.types, ty) == 4 {
            place = returned_place(&mut c, ty, first_token)
            ty = ft.type_base(&c.types, ty); at = first_token; pending = true; materialized = 0
        }
        fc.clear_expr_value(&mut c.body.expr)
