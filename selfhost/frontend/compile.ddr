            if public { fail(&mut c, "impl block cannot be public; mark individual methods with pub"); break }
            if unchecked || opaque || layout || resource || test || library != "" || req_caps != 0 || c_variadic >= 0 {
                fail(&mut c, "invalid declaration attribute"); break
            }
            skip_token(&mut c)
            mut trait_impl_id := -1
            mut target_tok := c.body.cursor
            mut target_name := ""
            if c.world.tokens.kinds[target_tok] != .Name { fail(&mut c, "expected type or trait name after impl"); break }
            first_name := advance(&mut c)
            newlines(&mut c)
            if eat(&mut c, "for") {
                newlines(&mut c)
                target_tok = c.body.cursor
