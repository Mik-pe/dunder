        }
        if skip_test_block { continue }
        if !c.ok { break }
        if has_extern && library == "" { library = "__unavailable__" }
        public := eat(&mut c, "pub")
        unchecked := eat(&mut c, "unsafe")
        if unchecked && !c.world.unsafe_capable { fail(&mut c, modules.missing_unsafe_message(file_caps != 0)); break }
        if library != "" && !unchecked { fail(&mut c, "@extern requires unsafe fn"); break }
        if c_variadic >= 0 && library == "" { fail(&mut c, "@c_variadic requires an @extern unsafe fn declaration"); break }
        opaque := eat(&mut c, "opaque")
        owner := declaration_owner(&c, c.world.tokens.starts[c.body.cursor], &module_starts, &module_files)
        if is(&c, "trait") {
            if unchecked || opaque || layout || resource || test || library != "" || req_caps != 0 || c_variadic >= 0 {
                fail(&mut c, "invalid declaration attribute"); break
