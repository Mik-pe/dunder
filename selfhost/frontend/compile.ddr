                if is(&c, "pub") { fail(&mut c, "trait methods cannot have 'pub'; visibility follows the trait"); break }
                m_unsafe := eat(&mut c, "unsafe")
                if m_unsafe && !c.world.unsafe_capable { fail(&mut c, modules.missing_unsafe_message(file_caps != 0)); break }
                expect(&mut c, "fn"); if !c.ok { break }
                m_tok := c.body.cursor
                if c.world.tokens.kinds[m_tok] != .Name { fail(&mut c, "expected trait method name"); break }
                m_name := advance(&mut c)
                if m_name == "self" || m_name == "Self" || m_name == "TaskID" || m_name == "Sendable" || m_name == "Storable" || m_name == "Iterator" {
                    c.body.cursor = m_tok; fail(&mut c, "duplicate or reserved function name"); break
                }
                if traits.has_method_name(&c.traits, tid, m_name) {
                    c.body.cursor = m_tok; fail(&mut c, "duplicate method '" + m_name + "' in trait"); break
                }
                sig_start := c.body.cursor
                if !is(&c, "(") { fail(&mut c, "expected '(' in trait method signature"); break }
