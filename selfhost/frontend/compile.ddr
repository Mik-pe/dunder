        name := advance(&mut c)
        if ((layout || resource) && what != "struct") || (unchecked && what != "fn") || (req_caps != 0 && what != "fn") || (c_variadic >= 0 && what != "fn") { fail(&mut c, "invalid declaration attribute"); break }
        if layout && resource { fail(&mut c, "@resource cannot be combined with @c_layout"); break }
