                expect(&mut c, "fn"); if !c.ok { break }
                m_owner := declaration_owner(&c, c.world.tokens.starts[c.body.cursor], &module_starts, &module_files)
                if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected method name"); break }
                m_name := advance(&mut c)
                if m_name == "self" || m_name == "Self" || m_name == "TaskID" { fail(&mut c, "duplicate or reserved function name"); break }
                fn_id := c.world.names.len
