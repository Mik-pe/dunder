}
fn strip_generic_suffix(name: string) -> string {
    for i in 0..name.len {
        if name[i..i + 1] == "<" { return name[0..i] }
    }
    name.clone()
}
fn generic_method_base(c: &Session, ty: i32) -> string {
    if ty <= 0 || ty >= c.types.type_names.len { return "" }
    strip_generic_suffix(c.types.type_names[ty])
}
fn generic_method_lookup(c: &Session, ty: i32, mname: string, has_self: bool) -> i32 {
    base := generic_method_base(&c, ty)
    if base == "" { return -1 }
    gfn := i32(c.specializations.generic_fns.defs.get_or(base + "::" + mname, -1))
    if gfn < 0 || gfn >= c.specializations.generic_fns.has_self.len { return -1 }
    if c.specializations.generic_fns.has_self[gfn] != has_self { return -1 }
    gfn
}
fn record_inferred_site(c: &mut Session, site_tok: i32, move spec: string) {
    inst := enclosing_generic_instance(&c)
    lkey := inst.str() + "@" + c.world.tokens.starts[site_tok].str()
    ikey := c.specializations.inferred_lookup.get_or(lkey, "")
    if ikey != "" && !c.demanded_inferred_keys.contains(ikey) {
        c.demanded_inferred_keys.put(ikey.clone(), i64(c.demanded_inferred_args.len))
        c.demanded_inferred_args.push(move spec)
    }
}
fn try_generic_method_call(c: &mut Session, gfn: i32, receiver_ty: i32, raw_base: string, mname: string,
    owner_tok: i32, mname_tok: i32, expected: i32, has_self: bool,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    base := if raw_base != "" { raw_base.clone() } else { generic_method_base(&c, receiver_ty) }
    shown_base := diagnostics.display_symbol(&c.sources, base)
    shown := shown_base + "::" + mname
    if !c.code.checking || !c.specializations.generic_fns.valid[gfn] {
        if eat(&mut c, "<") {
            mut d := 1
            while c.ok && d > 0 {
                if eat(&mut c, "<") { d += 1 }
                else if eat(&mut c, ">") { d -= 1 }
                else if c.world.tokens.kinds[c.body.cursor] == .End { break }
                else { skip_token(&mut c) }
            }
        }
        if eat(&mut c, "(") {
            mut d := 1
            while c.ok && d > 0 {
                if eat(&mut c, "(") { d += 1 }
                else if eat(&mut c, ")") { d -= 1 }
                else if c.world.tokens.kinds[c.body.cursor] == .End { break }
                else { skip_token(&mut c) }
            }
        }
        fail(&mut c, "cannot specialize generic method '" + shown + "'")
        set_error_at(&mut c, c.world.tokens.starts[mname_tok])
        return 0
    }
    tcount := c.specializations.generic_fns.type_param_counts[gfn]
    otcount := c.specializations.generic_fns.owner_tcounts[gfn]
    self_def := c.specializations.generic_fns.catalog_defs[gfn]
    pstart := c.specializations.generic_fns.param_starts[gfn]
    pcount := c.specializations.generic_fns.param_counts[gfn]
    mut inferred: []i32 = []
    for _ in 0..tcount { inferred.push(-1) }
    if otcount > 0 && receiver_ty > 0 && receiver_ty < c.specializations.type_instance_def.len &&
        c.specializations.type_instance_def[receiver_ty] >= 0 {
        if c.specializations.type_instance_arg_counts[receiver_ty] == otcount {
            astart := c.specializations.type_instance_arg_starts[receiver_ty]
            for oi in 0..otcount { inferred[oi] = c.specializations.type_instance_args[astart + oi] }
        }
    }
    if eat(&mut c, "<") {
        mut explicit: []i32 = []
        while c.ok && !is(&c, ">") {
            explicit.push(type_name(&mut c))
            if !eat(&mut c, ",") { break }
        }
        expect(&mut c, ">")
        if !c.ok { return 0 }
        want_m := tcount - otcount
        if explicit.len != want_m {
            fail(&mut c, "wrong number of type arguments for generic method '" + shown + "': expected " + want_m.str() + ", got " + explicit.len.str())
            set_error_at(&mut c, c.world.tokens.starts[mname_tok])
            return 0
        }
        for mi in 0..want_m { inferred[otcount + mi] = explicit[mi] }
    }
    expect(&mut c, "(")
    if !c.ok { return 0 }
    mut provided := 0
    while c.ok && !is(&c, ")") {
        if provided >= pcount { fail(&mut c, "too many arguments"); break }
        arg_tok := c.body.cursor; consuming := eat(&mut c, "move")
        pexpr := c.specializations.generic_fns.param_exprs[pstart + provided]
        pform := c.specializations.generic_fns.exprs.forms[pexpr]
        implicit_borrow := pform == .Shared && !starts_borrow(&c)
        mut target_expr := pexpr
        if implicit_borrow {
            s := c.specializations.generic_fns.exprs.starts[pexpr]
            if s < c.specializations.generic_fns.exprs.starts[pexpr + 1] {
                target_expr = c.specializations.generic_fns.exprs.children[s]
            }
        }
        if consuming && (pform == .Shared || pform == .Exclusive) {
            fail(&mut c, "move argument requires a consuming parameter"); return 0
        }
        mut context := substitute_generic_type(&mut c, target_expr, &inferred, self_def, receiver_ty)
        if context < 0 { context = 0 }
        prev_addr := c.body.place.taking_address
        c.body.place.taking_address = implicit_borrow
        actual := expression(&mut c, 0, context, &catalog, &mut inline_work, &mut model)
        c.body.place.taking_address = prev_addr
        if !c.ok { return 0 }
        if !unify_generic_type(&c, target_expr, actual, &mut inferred, self_def, receiver_ty) {
            want_ty := substitute_generic_type(&mut c, target_expr, &inferred, self_def, receiver_ty)
            if want_ty >= 0 {
                same(&mut c, want_ty, actual)
                return 0
            }
            fail(&mut c, "cannot unify argument " + (provided + 1).str() + " for generic method '" + shown + "' (got '" + ft.type_spelling(&c.types, actual) + "')")
            set_error_at(&mut c, c.world.tokens.starts[arg_tok])
            return 0
        }
        provided = provided + 1
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")")
    if !c.ok { return 0 }
    if provided != pcount { fail(&mut c, "wrong argument count"); return 0 }
    fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan); fc.clear_rvalue_place(&mut c.body.place)
    ret_expr := c.specializations.generic_fns.ret_exprs[gfn]
    if expected > 0 && ret_expr >= 0 {
        _ := unify_generic_type(&c, ret_expr, expected, &mut inferred, self_def, receiver_ty)
    }
    mut missing := false
    mut spec := base + "::" + mname
    mut owner_spec := ""
    for p in 0..tcount {
        if inferred[p] < 0 { missing = true; break }
        tname := ft.canonical_spelling(&c.types, inferred[p])
        spec = spec + "\n" + tname
        if p < otcount {
            if p > 0 { owner_spec = owner_spec + "\n" }
            owner_spec = owner_spec + tname
        }
    }
    if missing {
        fail(&mut c, "cannot infer type arguments for generic method '" + shown + "'; pass explicit type arguments")
        set_error_at(&mut c, c.world.tokens.starts[mname_tok])
        return 0
    }
    prev_demanded := c.demanded_inferred_args.len
    if owner_tok >= 0 && otcount > 0 && receiver_ty < 0 {
        record_inferred_site(&mut c, owner_tok, move owner_spec)
    }
    record_inferred_site(&mut c, mname_tok, move spec)
    if ret_expr < 0 { return 0 }
    ret_ty := substitute_generic_type(&mut c, ret_expr, &inferred, self_def, receiver_ty)
    if ret_ty >= 0 {
        if owned(&c, ret_ty) { return temporary(&mut c, ret_ty) }
        return ret_ty
    }
    if expected > 0 { return expected }
    if c.demanded_inferred_args.len > prev_demanded { return 1 }
    fail(&mut c, "resolving inferred return type for generic method '" + shown + "'")
    set_error_at(&mut c, c.world.tokens.starts[mname_tok])
    0
}
fn call_dispatch(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
