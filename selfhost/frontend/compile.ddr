                rhs := c.code.words.len; first_reloc := c.code.at.len; first_label := c.code.labels.len; first_import := c.body.facts.sites.len
                mut owner := -1; mut index := -1
                previous := c.body.observing_lease; generation := c.body.lease_generation
                if observe {
