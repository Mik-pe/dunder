fn comparison_value(c: &mut Session, operator: string) {
    condition := integers.relation(rules.opcode(operator))
    arm.set_condition(&mut c.code, 0, condition)
}
fn binary(c: &mut Session, operator: string, ty: i32, token: i32) -> i32 {
    fc.clear_loan_eval(&mut c.body.loan)
    if ty == 13 && (operator == "==" || operator == "!=") { return arm.unsigned_binary(&mut c.code, operator, 12, c.overflow, c.zero) }
    if floats.has(ty) {
        if operator == "%" { fail(&mut c, "remainder requires integers"); return ty }
        return arm.float_binary(&mut c.code, operator, ty, c.world.tokens.starts[token])
    }
    if unsigned.has(ty) { return arm.unsigned_binary(&mut c.code, operator, ty, c.overflow, c.zero) }
    if ty == 4 {
        arm.mov(&mut c.code, 2, 0); arm.mov(&mut c.code, 0, 1); arm.mov(&mut c.code, 1, 2)
        if operator == "+" { arm.intrinsic_call(&mut c.code, c.runtime.string_concat, .Concat, 4, 4, c.world.tokens.starts[token]); return 4 }
        arm.intrinsic_call(&mut c.code, c.runtime.string_compare, .Compare, 4, 1, c.world.tokens.starts[token]); arm.mov(&mut c.code, 1, 0); arm.imm(&mut c.code, 0, 0)
    }
    opcode := rules.opcode(operator); numeric := ty == 1 || ty == 2; ordered := numeric || ty == 5
    if opcode <= 5 {
        if !numeric { fail(&mut c, "arithmetic requires matching integer types"); return ty }
    } else if !ordered && !((ty == 3 || ft.type_kind(&c.types, ty) == 3) && (opcode == 6 || opcode == 7)) && ty != 4 {
        fail(&mut c, "comparison requires integers or bool equality")
    }
    if c.code.prefixing { arm.pending_operator(&mut c.code, opcode, ty, token) }
    else if c.ok && !c.code.checking { arm.signed_binary(&mut c.code, opcode, ty, c.overflow, c.zero) }
    if opcode <= 5 { ty } else { 3 }
}
fn float_context(c: &Session, expected: i32) -> i32 {
    if !c.float_source || expected == 1 || expected == 2 || unsigned.has(expected) || floats.has(expected) { return expected }
    mut pos := c.body.cursor
    while pos < c.world.tokens.kinds.len && (c.world.tokens.kinds[pos] == .Name || c.world.tokens.kinds[pos] == .Keyword) && c.world.tokens.texts[pos] == "move" { pos = pos + 1 }
    if pos >= c.world.tokens.kinds.len { return expected }
    first := c.world.tokens.kinds[pos]; first_word := c.world.tokens.texts[pos].clone()
    if first != .Integer && first != .Float && first_word != "(" && first_word != "-" { return expected }
    mut depth := 0
    mut decimal_seen := false
    mut literal_seen := false
    while pos < c.world.tokens.kinds.len {
        kind := c.world.tokens.kinds[pos]; word := c.world.tokens.texts[pos].clone()
        if kind == .Float { decimal_seen = true; literal_seen = true }
        else if kind == .Integer { literal_seen = true }
        else if (kind == .Name || kind == .Keyword) && word == "move" { }
        else if kind == .Name {
            index := local(&c.body, word)
            if index >= 0 {
                mut ty := c.body.locals.types[index]
                shape := ft.type_kind(&c.types, ty)
                if shape == 4 || shape == 5 { ty = ft.type_base(&c.types, ty) }
                if floats.has(ty) { return ty }
                break
            }
            if word == "f32" { return 6 }
            if word == "f64" { return 7 }
            mut called := -1
            if pos + 2 < c.world.tokens.kinds.len && c.world.tokens.kinds[pos + 1] == .Symbol && c.world.tokens.texts[pos + 1] == "::" {
                ty := resolve_type_name(&c, word)
                called = impl_method(&c, ty, c.world.tokens.texts[pos + 2])
            } else { called = i32(c.world.functions.get_or(word, -1)) }
            if called >= 0 {
                mut result := c.world.returns[called]
                if literal_seen && ft.type_kind(&c.types, result) == 4 { result = ft.type_base(&c.types, result) }
                if floats.has(result) { return result }
            }
            break
        } else if word == "(" { depth = depth + 1 }
        else if word == ")" {
            if depth == 0 { break }; depth = depth - 1
        } else if word == "." {
            if pos + 3 >= c.world.tokens.kinds.len || c.world.tokens.texts[pos + 2] != "(" || c.world.tokens.texts[pos + 3] != ")" { break }
            name := c.world.tokens.texts[pos + 1].clone()
            if name == "str" || name == "to_bits" || name == "is_nan" || name == "is_finite" || name == "is_infinite" || name == "is_sign_negative" { break }
            pos = pos + 3
        } else if word != "+" && word != "-" && word != "*" && word != "/" { break }
        pos = pos + 1
    }
    if decimal_seen { return 7 }
    expected
}
fn register_rhs(c: &Session, priority: i32) -> bool {
    mut last := c.body.cursor
    kind := c.world.tokens.kinds[last]
    if kind == .Name {
        found := local(&c.body, c.world.tokens.texts[last])
        if found < 0 { return false }
        ty := c.body.locals.types[found]
        if !scalar_element(&c, ty) || ty == 4 { return false }
    } else if kind != .Integer && kind != .Float && kind != .Rune && kind != .Byte {
        if !is(&c, "true") && !is(&c, "false") { return false }
    }
    rhs_ends_at(&c, last + 1, priority)
}
fn rhs_ends_at(c: &Session, next_at: i32, priority: i32) -> bool {
    if next_at >= c.world.tokens.kinds.len { return false }
    next := c.world.tokens.texts[next_at].clone()
    if next == "." || next == "[" || next == "(" || next == "?" { return false }
    rules.precedence(next) <= priority
}
fn signed_immediate_rhs(c: &mut Session, ty: i32, priority: i32, operator: string) -> bool {
    if (ty != 1 && ty != 2 && (ty != 5 || priority == 5)) || priority < 3 || priority > 5 || c.body.depth > 126 { return false }
    mut at := c.body.cursor
    mut negative := false
    if ty == 5 {
        if c.world.tokens.kinds[at] != .Rune { return false }
    } else if c.world.tokens.kinds[at] != .Integer {
        if !is(&c, "-") { return false }
        negative = true; at = at + 1
        if at >= c.world.tokens.kinds.len || c.world.tokens.kinds[at] != .Integer { return false }
    }
    if !rhs_ends_at(&c, at + 1, priority) { return false }
    mut magnitude: i64 = 0
    if ty == 5 { magnitude = i64(i32(c.world.tokens.texts[at].runes()[0])) }
    else {
        n := rules.literal_integer(c.world.tokens.texts[at])
        if !n.ok || n.value < 0 { return false }
        magnitude = n.value
    }
    field := arm.add_sub_field(magnitude)
    if field < 0 { return false }
    c.body.cursor = at + 1
    if priority == 5 {
        if field != 0 {
            arm.signed_add_sub(&mut c.code, ty, (operator == "-") != negative, true, c.overflow, 0, 0, -1, magnitude)
        }
    } else {
        arm.compare_immediate(&mut c.code, 0, magnitude, negative && magnitude != 0)
        comparison_value(&mut c, operator)
    }
    fc.clear_rvalue_place(&mut c.body.place); c.body.place.scratch = 0
    fc.clear_expr_value(&mut c.body.expr)
    fc.clear_loan_eval(&mut c.body.loan)
    true
}
fn immediate_div_rem_rhs(c: &mut Session, ty: i32, priority: i32, operator: string) -> bool {
    if !c.const_div_enabled || c.code.prefixing || (operator != "/" && operator != "%") || c.body.depth > 126 { return false }
    if ty == 1 || ty == 2 {
        mut at := c.body.cursor
        mut negative := false
        if c.world.tokens.kinds[at] != .Integer {
            if !is(&c, "-") { return false }
            negative = true; at = at + 1
            if at >= c.world.tokens.kinds.len || c.world.tokens.kinds[at] != .Integer { return false }
        }
        if !rhs_ends_at(&c, at + 1, priority) { return false }
        n := rules.literal_integer(c.world.tokens.texts[at])
        if !n.ok { return false }
        mut divisor: i64 = 0
        if negative {
            max_mag: i64 = if ty == 1 { 2147483648 } else { 9223372036854775807 }
            if n.value < 2 || n.value > max_mag { return false }
            divisor = i64(0).wrapping_sub(n.value)
        } else {
            if n.value < 1 || (ty == 1 && n.value > 2147483647) { return false }
            divisor = n.value
        }
        width := if ty == 1 { 32 } else { 64 }
        if c.code.platform == 3 && !const_div.cheap(divisor, width) { return false }
        mut plan := const_div.new()
        if !const_div.prepare_into(&mut plan, divisor, width) { return false }
        c.body.cursor = at + 1
        if !c.code.checking {
            if divisor == 1 {
                if operator == "%" { arm.imm(&mut c.code, 0, 0) }
            } else {
                const_div.emit(&mut c.code, &plan, operator == "%", c.overflow, c.zero)
            }
        }
        fc.clear_rvalue_place(&mut c.body.place); c.body.place.scratch = 0
        fc.clear_expr_value(&mut c.body.expr)
        fc.clear_loan_eval(&mut c.body.loan)
        return true
    }
    if unsigned.has(ty) {
        at := c.body.cursor
        if c.world.tokens.kinds[at] != .Integer || !rhs_ends_at(&c, at + 1, priority) { return false }
        u := unsigned.literal(c.world.tokens.texts[at], ty)
        if !u.ok || u.value == 0 { return false }
        width := unsigned.width_for(ty, c.code.platform)
        mut shift := 0
        if u.value == -9223372036854775808 {
            if width != 64 { return false }
            shift = 63
        } else if u.value > 0 && u.value.bit_and(u.value - 1) == 0 {
            mut tmp := u.value
            while tmp > 1 { tmp = tmp.shr(1); shift = shift + 1 }
        } else { return false }
        if shift < 0 || shift >= width { return false }
        c.body.cursor = at + 1
        if !c.code.checking {
            if shift == 0 {
                if operator == "%" { arm.imm(&mut c.code, 0, 0) }
            } else if operator == "/" {
                arm.bitfield(&mut c.code, false, true, 0, 0, shift, width - 1)
            } else {
                arm.bitfield(&mut c.code, false, true, 0, 0, 0, shift - 1)
            }
        }
        fc.clear_rvalue_place(&mut c.body.place); c.body.place.scratch = 0
        fc.clear_expr_value(&mut c.body.expr)
        fc.clear_loan_eval(&mut c.body.loan)
        return true
    }
    false
}
fn skip_balanced_parens(c: &mut Session) {
    expect(&mut c, "(")
    mut parens := 1
    while c.ok && parens > 0 && c.body.cursor < c.world.tokens.kinds.len {
        if c.world.tokens.kinds[c.body.cursor] == .End { fail(&mut c, "expected ')'"); return }
        if is(&c, "(") { parens += 1 }
        else if is(&c, ")") { parens -= 1 }
        skip_token(&mut c)
    }
}
fn demand_compound_method(c: &mut Session, ty: i32, name: string) -> i32 {
    if !c.discovering_compounds || !bundled.prelude_method(name) { return -1 }
    if ft.type_kind(&c.types, ty) != 1 && !ft.is_tuple(&c.types, ty) { return -1 }
    mut dummy := -1
    if name == "eq" || name == "ne" || name == "lt" || name == "le" || name == "gt" || name == "ge" { dummy = 3 }
    else if name == "hash" { dummy = 11 }
    else if name == "cmp" {
        dummy = resolve_type_name(&c, "__dunder_module_prelude_Ordering")
        if dummy < 0 { return -1 }
    } else if name == "str" { dummy = 4 }
    else if name == "default" { dummy = ty }
    else { return -1 }
    canonical := ft.canonical_spelling(&c.types, ty)
    if c.known_compounds.contains(canonical) { return -1 }
    c.demanded_compounds.put(move canonical, 1)
    dummy
}
fn is_builtin_comparison(c: &Session, ty: i32, opcode: i32) -> bool {
    if opcode < 6 || opcode > 11 { return false }
    if ty == 1 || ty == 2 || ty == 4 || ty == 5 || floats.has(ty) || unsigned.has(ty) { return true }
    if opcode == 6 || opcode == 7 {
        return ty == 3 || ty == 13 || ft.type_kind(&c.types, ty) == 3
    }
    false
}
fn set_expr_span(c: &mut Session, first_tok: i32) {
    mut start := first_tok
    mut end := c.body.cursor - 1
    while end > start && lexer.is_newline(c.world.tokens.kinds[end]) { end -= 1 }
    if end >= start && start >= 0 {
        c.body.last_expr_start = start
        c.body.last_expr_end = end
    }
}
fn expression(c: &mut Session, minimum: i32, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "expression nesting exceeds 128"); c.body.depth = c.body.depth - 1; return 0 }
    first_token := c.body.cursor; context := float_context(&c, expected)
    mut ty := primary(&mut c, context, &catalog, &mut inline_work, &mut model)
    set_expr_span(&mut c, first_token)
    if ft.type_kind(&c.types, ty) == 4 {
        mut operand := minimum > 1
        if c.world.tokens.kinds[c.body.cursor] == .Symbol {
            priority := rules.priority(rules.opcode(c.world.tokens.texts[c.body.cursor]))
            operand = operand || (priority > 0 && priority >= minimum) || (minimum == 0 && (is(&c, "..") || is(&c, "..=")))
        }
        if operand || (!c.body.place.taking_address && expected == ft.type_base(&c.types, ty)) {
