    }
    if name.len > 6 && name[0..6] == "store_" && raw_memory_type(&c, name, 6) >= 0 { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c); token := c.body.cursor - 2; ty := raw_memory_type(&c, name, 6)
        a := expression(&mut c, 0, 13, &catalog, &mut inline_work, &mut model); same(&mut c, 13, a); expect(&mut c, ","); arm.push_temp(&mut c.code, 0)
        b := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, b); expect(&mut c, ")")
        arm.pop_temp(&mut c.code, 1); place_transfer(&mut c, ty, 0, 1, false, true, 1, token); return 0
    }
    if name.len >= 6 && name[0..6] == "__sys_" { covered = true; return intrinsic(&mut c, name, expected, &catalog, &mut inline_work, &mut model) }
    if name == "len" { covered = true;
        token := c.body.cursor - 2; mut ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
        expect(&mut c, ")")
        if ft.type_kind(&c.types, ty) == 4 { ty = read_returned(&mut c, ty, token) }
        return length_value(&mut c, ty, token)
    }
    if name == "print" { covered = true; token := c.body.cursor - 2; source := c.world.tokens.starts[token]
        task_effect_at(&mut c, 256, token)
        value := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
        ty := read_scalar_result(&mut c, value, token)
        if ty >= 1 && ty <= 12 {
            if c.code.platform == 3 {
                arm.intrinsic_call(&mut c.code, -1, .Print, ty, 0, source); return 0
            }
            mut target := c.print_int; mut input := ty
            if ty == 3 { target = c.print_bool } else if ty == 4 { target = c.print_text }
            else if floats.has(ty) { format_float(&mut c, ty, source); input = 4; _ := temporary(&mut c, 4); target = c.print_text }
            else if ty == 5 { arm.intrinsic_call(&mut c.code, c.runtime.string_rune, .Format, ty, 4, source); input = 4; _ := temporary(&mut c, 4); target = c.print_text }
            arm.intrinsic_call(&mut c.code, target, .Print, input, 0, source); return 0
        }
        mut val_ty := ty
        ref_arg := ft.type_kind(&c.types, ty) == 4
        if ref_arg { val_ty = ft.type_base(&c.types, ty) }
        display_tid := traits.lookup(&c.traits, "__dunder_module_prelude_Display")
        if display_tid < 0 || !traits.satisfies(&c.traits, &c.types, display_tid, val_ty) {
            fail(&mut c, "print requires a scalar value or Display implementation")
            set_error_at(&mut c, source); return 0
        }
        str_fn := impl_method(&c, val_ty, "str")
        if str_fn < 0 {
            fail(&mut c, "print requires a scalar value or Display implementation")
            set_error_at(&mut c, source); return 0
        }
        if !check_impl_access(&mut c, str_fn, token) { return 0 }
        if !ref_arg { read_argument(&mut c, val_ty, token) }
        if c.loans.active {
            forward_argument_loan(&mut c, c.body.loan.origin, c.body.loan.constrained, str_fn, c.world.ffi_types[str_fn], 0, source)
        }
        recv_slot := alloc_arg_slot(&mut c); arm.store(&mut c.code, recv_slot, 0)
        args: []i32 = [recv_slot]
        c.body.facts.needed.push(str_fn)
        task_edge(&mut c, str_fn, source)
        arm.lower_call(&mut c.code, c.fn_labels[str_fn], -1, -1, &args, c.world.ffi_types[str_fn], 4, source)
        release_arg_slots(&mut c, &args)
        _ := temporary(&mut c, 4)
        fc.clear_loan_eval(&mut c.body.loan); fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr)
        if c.code.platform == 3 {
            arm.intrinsic_call(&mut c.code, -1, .Print, 4, 0, source); return 0
        }
        arm.intrinsic_call(&mut c.code, c.print_text, .Print, 4, 0, source); return 0
    }
    if name == "assert" {
        call_at := c.body.cursor - 2; first := c.body.cursor; covered = true
        previous := c.body.assert_operands
        c.body.assert_operands = assert_operands(&c, first, true)
        ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty)
        operands := c.body.assert_operands; c.body.assert_operands = previous
        last := c.body.cursor - 1; expect(&mut c, ")")
        assert_value(&mut c, call_at, first, last, &operands); return 0
    }
    if name == "panic" {
        call_at := c.body.cursor - 2; covered = true
        ty := expression(&mut c, 0, 4, &catalog, &mut inline_work, &mut model); same(&mut c, 4, ty)
        expect(&mut c, ")")
        if !c.ok { return 0 }
        source := c.world.tokens.starts[call_at]
        if !c.code.checking && c.code.platform != 3 {
            arm.intrinsic_call(&mut c.code, c.runtime.assert_report, .Print, 4, 0, source)
        }
        trap_edge(&mut c, c.assertion, .Jump, call_at)
        fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan); fc.clear_rvalue_place(&mut c.body.place)
        ownership.terminate(&mut c.body.ownership)
        out := temporary(&mut c, expected); c.body.expr.untyped_exit = true
        return out
    }
    if name == "i32" || name == "i64" || name == "rune" || floats.has(type_id(&c, name)) || unsigned.has(type_id(&c, name)) { covered = true;
        hint := type_id(&c, name)
        mut argument_hint := 0
        token := c.body.cursor - 2; offset := c.world.tokens.starts[token]
        mut literal_at := c.body.cursor; if is(&c, "-") { literal_at = literal_at + 1 }
        if (c.world.tokens.kinds[literal_at] == .Integer || c.world.tokens.kinds[literal_at] == .Float) && c.world.tokens.texts[literal_at + 1] == ")" {
            if floats.has(hint) || c.world.tokens.kinds[literal_at] == .Integer { argument_hint = hint }
        }
        value := expression(&mut c, 0, argument_hint, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
        ty := read_scalar_result(&mut c, value, token)
        if floats.has(ty) || floats.has(hint) {
            if (!floats.has(ty) && ty != 1 && ty != 2 && !unsigned.has(ty)) || hint == 5 { fail(&mut c, "expected a numeric conversion"); return hint }
            arm.float_cast(&mut c.code, ty, hint, c.float_trap, offset); return hint
        }
        if ty == 13 && hint == 12 { require_unsafe(&mut c); return 12 }
        if ty != 1 && ty != 2 && ty != 5 && !unsigned.has(ty) && ft.type_kind(&c.types, ty) != 3 { fail(&mut c, "integer conversion requires an integer") }
        if hint == 5 { arm.intrinsic_call(&mut c.code, c.runtime.valid_rune, .CheckRune, ty, hint, offset) }
        arm.unsigned_cast(&mut c.code, ty, hint, c.overflow)
        if hint == 1 { narrow(&mut c) }; return hint
    }
    covered = true
    f := i32(c.world.functions.get_or(name, -1)); callee := local(&c.body, name)
    mut signature := -1; mut address := -1
    if callee >= 0 {
        locals.mark_used(&mut c.body.locals, callee)
        signature = local_value_type(&mut c, callee)
        if ft.type_kind(&c.types, signature) != 8 && !ft.is_dunder_callable_kind(ft.type_kind(&c.types, signature)) &&
            !ft.is_borrowed_closure(&c.types, signature) {
            fail(&mut c, "local value is not callable"); return 0
        }
        return call_loaded_callable(&mut c, signature, borrows.local_id(callee), 0, true, c.body.cursor - 2, c.body.cursor - 2, &catalog, &mut inline_work, &mut model)
    } else {
        call_token := c.body.cursor - 2
        if f < 0 {
            gfn := i32(c.specializations.generic_fns.defs.get_or(name, -1))
            if gfn >= 0 {
                return infer_generic_call(&mut c, gfn, name, "", call_token, expected, -1, &catalog, &mut inline_work, &mut model)
            }
            fail(&mut c, "unknown function '" + diagnostics.display_symbol(&c.sources, name) + "'"); set_error_at(&mut c, c.world.tokens.starts[call_token]); return 0
        }
        check_function_caps(&mut c, f, c.body.cursor - 2)
        if !c.ok { return 0 }
        if c.world.unsafe_functions[f] && !c.body.unsafe_scope { fail(&mut c, "call requires unsafe"); return 0 }
        if c.world.libraries[f] != "" { import_address(&mut c, f); return foreign_call(&mut c, c.world.ffi_types[f], &catalog, &mut inline_work, &mut model) }
        c.body.facts.needed.push(f); signature = c.world.ffi_types[f]
    }
    invoke(&mut c, signature, address, f, -1, &catalog, &mut inline_work, &mut model)
}
fn scoped_borrow_body(c: &Session, f: i32) -> bool {
    ownership_check.scoped_borrow_body(&c.world, &c.types, c.body.self_type, f)
}
fn needs_loan_analysis(c: &Session, f: i32) -> bool {
    ownership_check.needs_loan_analysis(&c.world, &c.types, c.loans.active, c.body.self_type, f)
}
fn loan_origin(c: &Session, place: i32) -> i32 {
    ownership_check.loan_origin(&c.body, &c.types, place)
}
fn forward_loan(c: &mut Session, origin: i32, f: i32, signature: i32, parameter: i32, at: i32) {
    if origin == -1 { return }
    if f >= 0 {
        facts.forward(&mut c.body.facts, origin, c.world.param_starts[f] + parameter, at)
    } else if signature < c.types.declared.type_kinds.len {
        facts.indirect(&mut c.body.facts, origin, signature, parameter, at)
    }
}
fn forward_argument_loan(c: &mut Session, origin: i32, constrained: bool, f: i32, signature: i32, parameter: i32, at: i32) {
    forward_loan(&mut c, origin, f, signature, parameter, at)
    if constrained && origin != -3 { forward_loan(&mut c, -3, f, signature, parameter, at) }
}
fn charge_inline(c: &mut Session, declaration: i32, estimate: i32, first_word: i32) -> bool {
    actual := arm.position(&c.code) - first_word
    if first_word < 0 || declaration >= c.world.names.len || estimate < 0 || actual < 0 || actual > estimate {
        fail(&mut c, "internal inline growth accounting failure"); return false
    }
    mut recorded := false
    if declaration >= 0 { recorded = fragments.record_dependency(&mut c.body.inline_deps, declaration, estimate) }
    else { recorded = fragments.charge_dependency_words(&mut c.body.inline_deps, estimate) }
    if !recorded { fail(&mut c, "internal inline dependency admission failure"); return false }
    c.bindings.inlined_calls = c.bindings.inlined_calls + 1; c.bindings.inlined_words = c.bindings.inlined_words + actual
    c.bindings.inline_estimated_words = c.bindings.inline_estimated_words + estimate
    true
}
fn inline_rune_stream(c: &mut Session, values: i32, cursor: i32, source: i32) -> bool {
    estimate := runtime.utf8_next_word_estimate() + 16
    if !c.inline_enabled || c.validating_dead || c.code.checking ||
        fragments.remaining_words(&c.body.inline_deps) < estimate { return false }
    first := arm.position(&c.code)
    arm.load(&mut c.code, values)
    arm.iter_rune(&mut c.code, source)
    arm.store(&mut c.code, cursor, 1)
    _ := charge_inline(&mut c, -1, estimate, first)
    true
}
fn starts_borrow(c: &Session) -> bool {
    mut at := c.body.cursor
    while at < c.world.tokens.kinds.len && c.world.tokens.kinds[at] == .Symbol && c.world.tokens.texts[at] == "(" { at = at + 1 }
    if at >= c.world.tokens.kinds.len { return false }
    if c.world.tokens.kinds[at] == .Symbol && c.world.tokens.texts[at] == "&" { return true }
    if c.world.tokens.kinds[at] == .Name && c.world.tokens.texts[at] == "bytes_view" &&
        local(&c.body, "bytes_view") < 0 && at + 1 < c.world.tokens.kinds.len &&
        c.world.tokens.kinds[at + 1] == .Symbol && c.world.tokens.texts[at + 1] == "(" { return true }
    c.world.tokens.kinds[at] == .Name && c.world.tokens.texts[at] == "ref_at" &&
        local(&c.body, "ref_at") < 0 && at + 1 < c.world.tokens.kinds.len &&
        c.world.tokens.kinds[at + 1] == .Symbol && c.world.tokens.texts[at + 1] == "("
}
fn read_argument(c: &mut Session, ty: i32, token: i32) {
    place := c.body.places.current
    if place != 0 {
        lower_place(&mut c, place, 0, .ValueAndAddress, token)
        borrow_address(&mut c, ty, false, token, place)
    } else if ft.is_c_record(&c.types, ty) || fixed_pod(&c, ty) {
        borrow_address(&mut c, ty, false, token, 0)
    } else {
        home := slot(&mut c); arm.store(&mut c.code, home, 0); place_step(&mut c, .BorrowHome, ty, 3, 0, home, token)
    }
    c.body.loan.path = owner_path(&c, place); c.body.loan.root = source_root(&c, place)
    c.body.loan.origin = loan_origin(&c, place); c.body.loan.parent = borrow_parent(&c, place)
    binding := borrows.root(&c.body.places, place)
    c.body.loan.constrained = local_borrows.shared(&c.body.local_loans, binding)
}
struct InvokeCallee {
    has_env: bool, pin_rc: bool,
    loan_paths: []i32, loan_roots: []i32, loan_exclusives: []bool, loan_tokens: []i32,
}
fn plain_callee() -> InvokeCallee {
    InvokeCallee { has_env: false, pin_rc: false, loan_paths: [], loan_roots: [], loan_exclusives: [], loan_tokens: [] }
}
fn invoke(c: &mut Session, signature: i32, address: i32, f: i32, wasm_sig: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    callee := plain_callee()
    empty_ints: []i32 = []
    invoke_with_args(&mut c, signature, address, f, wasm_sig, &callee, &empty_ints, &empty_ints, &empty_ints, &empty_ints, &empty_ints, c.body.scratch_returns.len, c.body.cursor - 1, &catalog, &mut inline_work, &mut model)
}
fn invoke_callee(c: &mut Session, signature: i32, address: i32, f: i32, wasm_sig: i32, callee: &InvokeCallee,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    empty_ints: []i32 = []
    invoke_with_args(&mut c, signature, address, f, wasm_sig, &callee, &empty_ints, &empty_ints, &empty_ints, &empty_ints, &empty_ints, c.body.scratch_returns.len, c.body.cursor - 1, &catalog, &mut inline_work, &mut model)
}
fn call_loaded_callable(c: &mut Session, sig: i32, place: i32, materialized: i32, pending: bool,
    at: i32, call_token: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    if ft.type_kind(&c.types, sig) == 8 {
        if pending { lower_place(&mut c, place, materialized, .Value, at) }
        return foreign_call(&mut c, sig, &catalog, &mut inline_work, &mut model)
    }
    if ft.is_borrowed_closure(&c.types, sig) {
        if pending { lower_place(&mut c, place, materialized, .Value, at) }
        mut callee := plain_callee(); callee.has_env = true
        if c.body.loan.closure_paths.len > 0 {
            for k in 0..c.body.loan.closure_paths.len {
                callee.loan_paths.push(c.body.loan.closure_paths[k])
                callee.loan_roots.push(c.body.loan.closure_roots[k])
                callee.loan_exclusives.push(c.body.loan.closure_exclusives[k])
                callee.loan_tokens.push(c.body.loan.closure_tokens[k])
            }
        } else if c.body.loan.path >= 0 && c.body.loan.root >= 0 {
            callee.loan_paths.push(c.body.loan.path)
            callee.loan_roots.push(c.body.loan.root)
            callee.loan_exclusives.push(ft.type_kind(&c.types, sig) == 5)
            callee.loan_tokens.push(call_token)
        }
        load_mem(&mut c, 0, 0, 0)
        addr := slot(&mut c); arm.store(&mut c.code, addr, 0)
        return invoke_callee(&mut c, ft.type_base(&c.types, sig), addr, -1, -1, &callee, &catalog, &mut inline_work, &mut model)
    }
    skind := ft.type_kind(&c.types, sig)
    if skind == 9 {
        if pending { lower_place(&mut c, place, materialized, .Value, at) }
        addr := slot(&mut c); arm.store(&mut c.code, addr, 0)
        return invoke(&mut c, sig, addr, -1, -1, &catalog, &mut inline_work, &mut model)
    }
    if skind == 11 {
        if pending { lower_place(&mut c, place, materialized, .Value, at) }
        addr := slot(&mut c); arm.store(&mut c.code, addr, 0)
        mut callee := plain_callee(); callee.has_env = true; callee.pin_rc = true
        return invoke_callee(&mut c, sig, addr, -1, -1, &callee, &catalog, &mut inline_work, &mut model)
    }
    if skind == 12 {
        mut callee := plain_callee(); callee.has_env = true
        if place != 0 {
            lower_place(&mut c, place, materialized, .ValueAndAddress, at)
            base := borrows.root(&c.body.places, place)
            if !c.body.place.writable {
                fail_immutable_binding(&mut c, "calling an FnMut closure requires 'mut' or '&mut'", base)
                return 0
            }
            if base >= 0 {
                if !writable_loan(&mut c, place) { return 0 }
                record_mutation(&mut c, base, owner_path(&c, place))
                callee.loan_paths.push(owner_path(&c, place))
                callee.loan_roots.push(source_root(&c, place))
                callee.loan_exclusives.push(true)
                callee.loan_tokens.push(call_token)
            }
        }
        addr := slot(&mut c); arm.store(&mut c.code, addr, 0)
        return invoke_callee(&mut c, sig, addr, -1, -1, &callee, &catalog, &mut inline_work, &mut model)
    }
    if skind == 13 {
        mut callee := plain_callee(); callee.has_env = true
        if place != 0 {
            if place < 0 { lower_place(&mut c, place, materialized, .Value, at) }
            c.body.places.current = place; c.body.places.source = at
            take_value(&mut c, sig)
            if !c.ok { return 0 }
            addr := slot(&mut c); arm.store(&mut c.code, addr, 0); _ := temporary(&mut c, sig)
            return invoke_callee(&mut c, sig, addr, -1, -1, &callee, &catalog, &mut inline_work, &mut model)
        }
        addr := slot(&mut c); arm.store(&mut c.code, addr, 0)
        return invoke_callee(&mut c, sig, addr, -1, -1, &callee, &catalog, &mut inline_work, &mut model)
    }
    fail(&mut c, "this value is not callable for the selected target"); 0
}
fn returns_array_view(c: &Session, ty: i32) -> bool {
    ft.type_kind(&c.types, ty) == 4 && ft.type_kind(&c.types, ft.type_base(&c.types, ty)) == 1
}
fn returns_pod_struct(c: &Session, ty: i32) -> bool {
    is_pod(&c, ty)
}
fn uses_hidden_return(c: &Session, ty: i32) -> bool {
    returns_array_view(&c, ty) || returns_pod_struct(&c, ty)
}
fn borrows_overlap(c: &Session, pa: i32, ra: i32, pb: i32, rb: i32) -> bool {
    if ra < 0 || rb < 0 { return false }
    if pa >= 0 && pb >= 0 { return ownership.overlaps(&c.body.ownership, pa, pb) }
    ra == rb
}
fn invoke_with_args(c: &mut Session, signature: i32, address: i32, f: i32, wasm_sig: i32, callee: &InvokeCallee,
    args_in: &[]i32, starts_in: &[]i32, places_in: &[]i32, sources_in: &[]i32, effects_in: &[]i32, first_writeback: i32, call_token: i32,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    source_offset := c.world.tokens.starts[call_token]
    has_env := address >= 0 && wasm_sig < 0 && callee.has_env
    if has_env && callee.pin_rc {
        // Argument evaluation may replace the source binding.
        arm.load(&mut c.code, address); copy_value(&mut c, signature)
        pin := slot(&mut c); save_owner(&mut c, pin, signature, true)
    }
    if address >= 0 || wasm_sig >= 0 { task_edge(&mut c, -1, c.world.tokens.starts[call_token]) } else { task_edge(&mut c, f, c.world.tokens.starts[call_token]) }
    first := ft.type_start(&c.types, signature); count := ft.type_count(&c.types, signature)
    source_parameter := ft.return_borrow_parameter(&c.types, signature)
    mut result_origin := -1
    mut provided := args_in.len
    pending := c.body.pending.slots.len
    for arg in 0..provided { stage_owner(&mut c, .Argument, args_in[arg], ft.parameter_type(&c.types, first + arg), 0) }
    mut args: []i32 = []; mut own_args: []i32 = []; mut arg_starts: []i32 = []; mut arg_sources: []i32 = []; mut effects: []i32 = []
    mut arg_roots: []i32 = []; mut arg_paths: []i32 = []; mut arg_parents: []i32 = []
    mut cl_starts: []i32 = [0]; mut cl_paths: []i32 = []; mut cl_roots: []i32 = []; mut cl_exclusives: []bool = []
    for v in &args_in { args.push(v) }
    for v in &starts_in { arg_starts.push(v) }
    for v in &places_in { arg_roots.push(source_root(&c, v)); arg_paths.push(owner_path(&c, v)); arg_parents.push(borrow_parent(&c, v)); cl_starts.push(0) }
    if source_parameter >= 0 && source_parameter < provided { result_origin = loan_origin(&c, places_in[source_parameter]) }
    for v in &sources_in { arg_sources.push(v) }
    eff_before_args := c.body.mutations.len
    for v in &effects_in { effects.push(v) }
    while c.ok && !is(&c, ")") {
        if provided >= count { fail(&mut c, "too many arguments"); break }
        argument := c.body.cursor; consuming := eat(&mut c, "move")
        arg_starts.push(argument); effects.push(c.body.mutations.len)
        want := ft.parameter_type(&c.types, first + provided); want_kind := ft.type_kind(&c.types, want)
        implicit_borrow := want_kind == 4 && !ft.is_borrowed_closure(&c.types, want) && !starts_borrow(&c)
        mut context := want; if implicit_borrow { context = ft.type_base(&c.types, want) }
        if consuming && (want_kind == 4 || want_kind == 5) { fail(&mut c, "move argument requires a consuming parameter"); return 0 }
        previous_address := c.body.place.taking_address; c.body.place.taking_address = implicit_borrow
        mut ty := expression(&mut c, 0, context, &catalog, &mut inline_work, &mut model)
        c.body.place.taking_address = previous_address
        if implicit_borrow {
            if ty != want {
                same_or_coerce(&mut c, context, ty, argument); if !c.ok { return 0 }
                read_argument(&mut c, context, argument); ty = want
            }
        } else {
            ty = coerce_callable(&mut c, want, ty, argument)
            same(&mut c, want, ty)
            if !c.ok && want != ty && ft.type_kind(&c.types, want) == 5 && ft.type_base(&c.types, want) == ty && c.error_note == "" {
                binding := borrows.root(&c.body.places, c.body.places.current)
                mut note_at := -1
                mut note_msg := ""
                if binding >= 0 && binding < c.body.locals.names.len {
                    bname := c.body.locals.names[binding].clone()
                    decl_tok := c.body.locals.tokens[binding]
                    if decl_tok >= 0 && decl_tok < c.world.tokens.starts.len { note_at = c.world.tokens.starts[decl_tok] }
                    if ft.type_kind(&c.types, c.body.locals.types[binding]) == 5 {
                        note_msg = "'" + bname + "' is a '&mut' parameter that auto-dereferences; pass '&mut " + bname + "' to forward it"
                    } else if c.body.locals.mutable[binding] {
                        note_msg = "pass '&mut " + bname + "' for a mutable borrow parameter"
                    } else {
