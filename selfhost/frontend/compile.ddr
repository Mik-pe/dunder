            if c.types.declared.type_kinds[ty] == 3 && c.types.declared.type_counts[ty] == 0 { fail(&mut c, "enum requires at least one variant") }
            if !c.ok {
                if !decl_failed {
                    first_decl_err = c.error.clone(); first_decl_at = c.error_at; first_decl_last = c.error_last
                    first_decl_code = c.error_code.clone(); first_decl_note = c.error_note.clone()
                    first_decl_note_at = c.error_note_at; first_decl_note_last = c.error_note_last
                }
                decl_failed = true
                c.ok = true; c.error = ""; c.error_last = -1; c.error_code = ""; c.error_note = ""; c.error_note_at = -1; c.error_note_last = -1; c.types.error = ""
            }
        } else {
            fn_id := declaration_fns[d]
            c.types.self_type = c.world.impl_types[fn_id]
            expect(&mut c, "("); first := c.world.param_names.len
            while c.ok && !is(&c, ")") {
                param_index := c.world.param_names.len - first
                mut is_mut := eat(&mut c, "mut")
                consuming := eat(&mut c, "move")
                if !is_mut && eat(&mut c, "mut") { is_mut = true }
                if !consuming && !is_mut && eat(&mut c, "&") {
                    ref_mut := eat(&mut c, "mut")
                    param_tok := c.body.cursor
                    if !eat(&mut c, "self") { fail(&mut c, "expected 'self' after '&' in receiver parameter"); break }
                    if c.types.self_type < 0 { fail(&mut c, "'self' parameter is only valid inside an impl block"); break }
                    if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of an impl method"); break }
                    c.world.impl_has_self[fn_id] = true
                    mut ref_kind := 4; if ref_mut { ref_kind = 5 }
                    mode := compound(&mut c, ref_kind, c.types.self_type)
                    c.world.param_tokens.push(param_tok); c.world.param_names.push("self"); c.world.param_types.push(mode); c.world.param_mutable.push(false)
                } else if is(&c, "&") {
                    fail(&mut c, "cannot combine 'move' or 'mut' with '&' in receiver parameter"); break
                } else {
                    if is(&c, "self") {
                        param_tok := c.body.cursor; parameter := advance(&mut c)
                        if c.types.self_type < 0 { fail(&mut c, "'self' parameter is only valid inside an impl block"); break }
                        if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of an impl method"); break }
                        c.world.impl_has_self[fn_id] = true
                        c.world.impl_self_mut[fn_id] = is_mut
                        mut mode := parameter_mode(&mut c, c.types.self_type, true, false)
                        if eat(&mut c, ":") {
                            if is_mut { fail(&mut c, "cannot combine 'mut self' with an explicit ': Type'"); break }
                            pt := type_name(&mut c)
                            if pt == c.types.self_type {
                                mode = parameter_mode(&mut c, pt, true, false)
                            } else if (ft.type_kind(&c.types, pt) == 4 || ft.type_kind(&c.types, pt) == 5) && ft.type_base(&c.types, pt) == c.types.self_type {
                                if consuming { fail(&mut c, "move argument requires a consuming parameter"); break }
                                mode = parameter_mode(&mut c, pt, false, false)
                            } else {
                                fail(&mut c, "self parameter must have type Self, &Self or &mut Self"); break
                            }
                        }
                        c.world.param_tokens.push(param_tok); c.world.param_names.push(move parameter); c.world.param_types.push(mode); c.world.param_mutable.push(is_mut)
                    } else {
                        if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected parameter name"); break }
                        c.world.param_tokens.push(c.body.cursor); parameter := advance(&mut c); expect(&mut c, ":"); pt := type_name(&mut c)
                        is_foreign := c.world.libraries[fn_id] != ""
                        mode := parameter_mode(&mut c, pt, consuming, is_foreign)
                        if is_mut && (is_foreign || ft.type_kind(&c.types, mode) == 4 || ft.type_kind(&c.types, mode) == 5) {
                            fail(&mut c, "mutable parameter requires 'mut move' or '&mut'"); break
                        }
                        c.world.param_names.push(move parameter); c.world.param_types.push(mode); c.world.param_mutable.push(is_mut)
                    }
                }
                if !eat(&mut c, ",") { break }
            }
            expect(&mut c, ")"); c.world.param_starts.push(first); c.world.param_counts.push(c.world.param_names.len - first)
            mut ret := 0; if eat(&mut c, "->") { ret = type_name(&mut c) }; c.world.returns.push(ret)
            c.types.self_type = -1
            if c.world.test_functions[fn_id] && (c.world.param_counts[fn_id] != 0 || ret != 0) { fail(&mut c, "@test function must take no parameters and return ()") }
            if c.world.libraries[fn_id] != "" {
                mut args: []i32 = []
                for p in first..c.world.param_names.len { args.push(c.world.param_types[p]) }
                ft := foreign_variadic_type(&mut c, &args, ret, declaration_c_variadic[d]); c.world.ffi_types.push(ft)
                if !is(&c,"\n") && !is(&c,";") && c.world.tokens.kinds[c.body.cursor] != .End { fail(&mut c,"unexpected token after external declaration") }
                c.world.starts.push(0); c.world.ends.push(0)
            } else {
                mut ordinary_args: []i32 = []
                for p in first..c.world.param_names.len {
                    if c.world.param_names[p] != "__dunder_module_env" { ordinary_args.push(c.world.param_types[p]) }
                }
                source := result_parameter(&mut c, &ordinary_args, ret, first)
                signature := callable_with_parameter(&mut c, &ordinary_args, ret, 9, source); c.world.ffi_types.push(signature)
                newlines(&mut c); expect(&mut c, "{"); c.world.starts.push(c.body.cursor); c.world.ends.push(c.world.closes[c.body.cursor - 1])
                if c.ok && ret != 0 && !c.specializations.pending.contains(c.world.names[fn_id]) && c.specializations.definition_checks.get_or(c.world.names[fn_id], 0) == 0 {
                    newlines(&mut c); if is(&c, "}") { fail(&mut c, "function can finish without returning a value") }
                }
            }
            if !c.ok {
                if !decl_failed {
                    first_decl_err = c.error.clone(); first_decl_at = c.error_at; first_decl_last = c.error_last
                    first_decl_code = c.error_code.clone(); first_decl_note = c.error_note.clone()
                    first_decl_note_at = c.error_note_at; first_decl_note_last = c.error_note_last
                }
                decl_failed = true
                c.ok = true; c.error = ""; c.error_last = -1; c.error_code = ""; c.error_note = ""; c.error_note_at = -1; c.error_note_last = -1; c.types.error = ""
            }
        }
    }
    if decl_failed {
        c.ok = false; c.has_errors = true
        c.error = move first_decl_err; c.error_at = first_decl_at; c.error_last = first_decl_last
        c.error_code = move first_decl_code; c.error_note = move first_decl_note
        c.error_note_at = first_decl_note_at; c.error_note_last = first_decl_note_last
        return
    }
    for i in 0..resource_types.len {
        if !c.ok { break }
        ty := resource_types[i]; c.body.cursor = resource_methods[i]
        hook := impl_method(&c, ty, c.world.tokens.texts[c.body.cursor])
        if hook < 0 || c.world.impl_public[hook] || c.world.unsafe_functions[hook] || c.world.requires_caps[hook] != 0 ||
            !c.world.impl_has_self[hook] || c.world.param_counts[hook] != 1 || c.world.returns[hook] != 0 ||
            (ft.type_kind(&c.types, c.world.param_types[c.world.param_starts[hook]]) != 4 &&
             ft.type_kind(&c.types, c.world.param_types[c.world.param_starts[hook]]) != 5) {
            fail(&mut c, "@resource cleanup requires a private safe method taking only &self or &mut self and returning ()")
            break
        }
        c.types.cleanup_methods[ty] = hook
        c.types.has_cleanup = true
    }
    if c.ok { resolve_traits(&mut c) }
    mut req_failed := false
    if c.ok {
        for i in 0..c.specializations.requirements.trait_names.len {
            if diag.limit_reached(&c.diag_bag) { break }
            name := c.specializations.requirements.trait_names[i].clone()
            receiver := c.specializations.requirements.trait_receivers[i]
            tid := traits.lookup(&c.traits, name)
            mut req_err := ""
            if tid < 0 { req_err = "unknown trait '" + trait_display_name(name) + "' required by generic declaration" }
            else if !traits.satisfies(&c.traits, &c.types, tid, receiver) {
                if tid == traits.sendable_id() {
                    req_err = "type '" + ft.type_spelling(&c.types, receiver) + "' does not satisfy Sendable (" + traits.sendable_reason(&c.traits, receiver) + ")"
                } else if tid == traits.clone_id() {
                    req_err = "type '" + ft.type_spelling(&c.types, receiver) + "' is a resource or non-cloneable type"
                } else if tid == traits.copy_id() {
                    req_err = "type '" + ft.type_spelling(&c.types, receiver) + "' is move-only and does not satisfy Copy"
                } else {
                    req_err = "type '" + ft.type_spelling(&c.types, receiver) + "' does not implement required trait '" + trait_display_name(name) + "'"
                }
            }
            if req_err != "" {
                req_failed = true
                fail_span(&mut c, "", c.specializations.requirements.trait_sites[i], -1, req_err)
                c.ok = true
            }
        }
        for i in 0..c.specializations.requirements.methods.len {
            if diag.limit_reached(&c.diag_bag) { break }
            name := c.specializations.requirements.methods[i].clone()
            expected := c.specializations.requirements.signatures[i]
            f := impl_method(&c, c.specializations.requirements.receivers[i], name)
            mut meth_err := ""
            if f < 0 { meth_err = "unknown method '" + name + "' required by generic declaration" }
            else if !c.world.impl_public[f] || !c.world.impl_has_self[f] || c.world.unsafe_functions[f] ||
                c.world.requires_caps[f] != 0 || c.world.ffi_types[f] != expected {
                meth_err = "required method '" + name + "' must be public and safe with signature " + ft.type_spelling(&c.types, expected)
            }
            if meth_err != "" {
                req_failed = true
                fail_span(&mut c, "", c.specializations.requirements.sites[i], -1, meth_err)
                c.ok = true
            }
        }
    }
    if req_failed { c.ok = false; c.has_errors = true }
}
fn slot(c: &mut Session) -> i32 {
    result := c.body.slots; c.body.slots = c.body.slots + 1
    if c.body.slots > 65535 { fail(&mut c, "this compiler stage allows at most 65535 local slots per function") }
    result
}
fn alloc_arg_slot(c: &mut Session) -> i32 {
    if c.body.slots >= 16 && c.body.free_arg_slots.len > 0 { return c.body.free_arg_slots.pop() }
    slot(&mut c)
}
fn release_arg_slots(c: &mut Session, slots: &[]i32) {
    mut i := slots.len - 1
    while i >= 0 {
        c.body.free_arg_slots.push(slots[i])
        i = i - 1
    }
}
fn local(body: &fc.FunctionContext, name: string) -> i32 {
    fc.local(&body, name)
}
fn type_spelling(c: &Session, ty: i32) -> string { ft.type_spelling(&c.types, ty) }
fn bind(c: &mut Session, model: &mut opt_ir.Function, move name: string, ty: i32, mutable: bool, index: i32, at: i32) {
    if c.report && at >= 0 && name != "__dunder_module_env" && c.world.tokens.starts[at] < c.world.source_end {
        facts.binding(&mut c.body.facts, at, ty)
    }
    if !rules.identifier(name) { fail(&mut c, "this compiler stage supports ASCII identifiers") }
    if rules.reserved(name) && name != "len" && !(name == "self" && c.body.has_self && c.body.locals.names.len == 0) {
        fail(&mut c, "reserved local name")
    }
    prior := locals.resolve(&c.body.locals, name)
    if prior >= 0 && c.body.locals.scopes[prior] == c.body.scope { fail(&mut c, "duplicate local name") }
    id := locals.add(&mut c.body.locals, move name, ty, mutable, c.body.scope, at)
    if at < 0 || at >= c.world.tokens.starts.len || c.world.tokens.starts[at] >= c.world.source_end ||
        generics.generated(&c.specializations, c.world.tokens.starts[at]) ||
        c.body.locals.names[id].len == 0 || c.body.locals.names[id][0] == 95 {
        locals.mark_used(&mut c.body.locals, id)
    }
    local_storage(&mut c, id, index, ty)
    if model.recording {
        mut param := -1
        if id < model.params { param = id }
        typed.local(&mut model, &c.body.locals, id, ft.scalar_type(&c.types, ty), param)
    }
}
fn local_storage(c: &mut Session, id: i32, index: i32, ty: i32) {
    ownership.add(&mut c.body.ownership, id)
    local_borrows.add_local(&mut c.body.local_loans, id)
    mut referent := ty; mut deref := 0; kind := ft.type_kind(&c.types, ty)
    if kind == 4 || kind == 5 { referent = ft.type_base(&c.types, ty); deref = kind - 3 }
    places.local(&mut c.body.places.arena, index, referent, read_shape(&c, referent, false), deref)
}
fn returned_place(c: &mut Session, ty: i32, token: i32) -> i32 {
    home := slot(&mut c); arm.store(&mut c.code, home, 0)
    id := locals.add(&mut c.body.locals, "_", ty, false, c.body.scope, token)
    _ := c.body.locals.active.pop()
    local_storage(&mut c, id, home, ty)
    local_borrows.transient_with_parent(&mut c.body.local_loans, id, c.body.loan.path, c.body.loan.root, c.body.loan.origin, c.body.loan.parent, ft.type_kind(&c.types, ty) == 5)
    fc.clear_loan_eval(&mut c.body.loan)
    borrows.local_id(id)
}
fn read_returned(c: &mut Session, ty: i32, token: i32) -> i32 {
    place := returned_place(&mut c, ty, token)
    lower_place(&mut c, place, 0, .Value, token)
    c.body.places.current = place; c.body.places.source = token
    ft.type_base(&c.types, ty)
}
fn read_scalar_result(c: &mut Session, ty: i32, token: i32) -> i32 {
    kind := ft.type_kind(&c.types, ty)
    if (kind == 4 || kind == 5) && ft.scalar_element(&c.types, ft.type_base(&c.types, ty)) {
        return read_returned(&mut c, ty, token)
    }
    ty
}
fn drop_locals_to(c: &mut Session, limit: i32, scope: i32) {
    first := locals.first_in_scope(&c.body.locals, limit, scope)
    if c.tasks.program { task_close_locals(&mut c, first) }
    while c.body.locals.active.len > first {
        id := c.body.locals.active.pop(); ty := c.body.locals.types[id]
        local_borrows.release_local(&mut c.body.local_loans, id)
        if frame_owned(&c, ty) && !fc.pattern_loan(&c.body, id) { clear_owner(&mut c, places.local_home(c.body.places.arena.locals[id]), ty) }
    }
}
fn enter(c: &mut Session) { c.body.scope = c.body.scope + 1 }
fn leave(c: &mut Session) {
    drop_locals_to(&mut c, 0, c.body.scope)
    c.body.scope = c.body.scope - 1
}
fn narrow(c: &mut Session) {
    arm.check_i32(&mut c.code, c.overflow)
}
fn float_literal(c: &mut Session, spelling: string, expected: i32) -> i32 {
    mut ty := 7; if expected == 6 { ty = 6 }
    value := decimal.decode(spelling, ty == 6)
    if !value.ok { fail(&mut c, "floating literal is outside the finite range") }
    arm.imm(&mut c.code, 0, value.bits); ty
}
fn format_float(c: &mut Session, ty: i32, source: i32) {
    id := i32(c.world.functions.get_or("__dunder_module_format_float_bits", -1))
    task_edge(&mut c, id, source)
    if c.validating_dead { return }
    if id < 0 { fail(&mut c, "missing floating formatter"); return }
    c.body.facts.needed.push(id)
    arm.intrinsic_call(&mut c.code, c.fn_labels[id], .Format, ty, 4, source)
}
fn integer_literal(c: &mut Session, spelling: string, ty: i32) -> i64 {
    if unsigned.has(ty) {
        number := unsigned.literal(spelling, ty)
        if !number.ok { fail(&mut c, "unsigned integer literal out of range") }
        else if c.code.platform == 3 && ty == 12 && (number.value < 0 || number.value > 4294967295) { fail(&mut c, "usize literal exceeds wasm32 pointer width") }
        return number.value
    }
    mut value := rules.literal_integer(spelling)
    _ := rules.validate_signed(&mut value, ty)
    if !value.ok { fail(&mut c, "integer literal out of range") }
    value.value
}
fn literal(c: &mut Session, model: &mut opt_ir.Function, spelling: string, expected: i32) -> i32 {
    if floats.has(expected) { return float_literal(&mut c, spelling, expected) }
    mut ty := expected
    if !unsigned.has(ty) && ty != 2 { ty = 1 }
    value := integer_literal(&mut c, spelling, ty)
    if model.recording {
        if ty != 1 && ty != 2 { model.recording = false }
        else { _ := typed.node(&mut model, 1, ty, -1, -1, -1, value, -1, c.body.cursor - 1) }
    }
    if !c.code.checking || c.code.prefixing { arm.imm(&mut c.code, 0, value) }
    ty
}
fn intrinsic(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    mut covered := false
    result := intrinsic_dispatch(&mut c, name, expected, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
fn intrinsic_dispatch(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    raw_memory := name == "__sys_memory_copy" || name == "__sys_memory_equal"
    byte_buffer := name == "__sys_bytes_extend" || name == "__sys_bytes_append_text"
    if byte_buffer || name == "__sys_decode_utf8" || name == "__sys_decode_u8" || name == "__sys_decode_u8_range" { covered = true; task_effect(&mut c, 13) }
    else { task_effect(&mut c, 256) }
    mut target := -1; mut ret := expected
    if name == "__sys_arg_count" { covered = true; target = c.runtime.sys_arg_count; ret = 1 }
    else if name == "__sys_memory_copy" { covered = true; require_unsafe(&mut c); target = c.runtime.memory_copy; ret = 0 }
    else if name == "__sys_memory_equal" { covered = true; require_unsafe(&mut c); target = c.runtime.memory_equal; ret = 3 }
    else if name == "__sys_memory_zero" { covered = true; require_unsafe(&mut c); target = c.runtime.memory_zero; ret = 0 }
    else if name == "__sys_pool_alloc_try" { covered = true; require_unsafe(&mut c); target = c.runtime.pool_alloc_try; ret = 13 }
    else if name == "__sys_pool_free" { covered = true; require_unsafe(&mut c); target = c.runtime.release; ret = 0 }
    else if name == "__sys_bytes_extend" { covered = true; target = c.runtime.bytes_extend; ret = 0 }
    else if name == "__sys_bytes_append_text" { covered = true; target = c.runtime.bytes_append_text; ret = 0 }
    else if name == "__sys_envp" { covered = true; require_unsafe(&mut c); target = c.runtime.sys_envp; ret = 13 }
    else if name == "__sys_linux_syscall" { covered = true; require_unsafe(&mut c); target = c.runtime.sys_linux_syscall; ret = 2 }
    else if name == "__sys_arg" { covered = true; target = c.runtime.sys_arg; ret = 4 }
    else if name == "__sys_pid" { covered = true; target = c.runtime.sys_pid; ret = 1 }
    else if name == "__sys_read_text" { covered = true; target = c.runtime.sys_read_text }
    else if name == "__sys_read_u8" { covered = true; target = c.runtime.sys_read_u8 }
    else if name == "__sys_metadata" { covered = true; target = c.runtime.sys_metadata }
    else if name == "__sys_same_file" { covered = true; target = c.runtime.sys_same_file; ret = 3 }
    else if name == "__sys_write_bytes" || name == "__sys_write_u8" { covered = true; target = c.runtime.sys_write_bytes }
    else if name == "__sys_make_executable" { covered = true; target = c.runtime.sys_make_executable }
    else if name == "__sys_rename" { covered = true; target = c.runtime.sys_rename }
    else if name == "__sys_remove_file" { covered = true; target = c.runtime.sys_remove_file }
    else if name == "__sys_decode_utf8" || name == "__sys_decode_u8" { covered = true; target = c.runtime.sys_decode_utf8 }
    else if name == "__sys_decode_u8_range" { covered = true; target = c.runtime.sys_decode_u8_range }
    else if name == "__sys_write_stderr" { covered = true; target = c.runtime.sys_stderr }
    else if name == "__sys_write_text" { covered = true; target = c.runtime.sys_write_text }
    else if name == "__sys_append_text" { covered = true; target = c.runtime.sys_append_text }
    else if name == "__sys_mkdir" { covered = true; target = c.runtime.sys_mkdir }
    else if name == "__sys_remove_dir" { covered = true; target = c.runtime.sys_remove_dir }
    else if name == "__sys_now_ms" { covered = true; target = c.runtime.sys_now_ms; ret = 2 }
    else if name == "__sys_net_listen" { covered = true; target = c.runtime.sys_net_listen; ret = 2 }
    else if name == "__sys_net_accept" { covered = true; target = c.runtime.sys_net_accept; ret = 2 }
    else if name == "__sys_net_connect" { covered = true; target = c.runtime.sys_net_connect; ret = 2 }
    else if name == "__sys_net_read" { covered = true; target = c.runtime.sys_net_read; ret = 2 }
    else if name == "__sys_net_peek" { covered = true; target = c.runtime.sys_net_peek; ret = 2 }
    else if name == "__sys_net_write" { covered = true; target = c.runtime.sys_net_write; ret = 2 }
    else if name == "__sys_fd_write" { covered = true; target = c.runtime.sys_fd_write; ret = 2 }
    else if name == "__sys_net_poll" { covered = true; target = c.runtime.sys_net_poll; ret = 2 }
    else if name == "__sys_net_set_nonblocking" { covered = true; target = c.runtime.sys_net_set_nonblocking; ret = 2 }
    else if name == "__sys_net_set_nodelay" { covered = true; target = c.runtime.sys_net_set_nodelay; ret = 2 }
