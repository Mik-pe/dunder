    else if name == "__sys_net_close" { covered = true; target = c.runtime.sys_net_close; ret = 2 }
    if !covered || (!c.code.forbid_emit && target < 0) { fail(&mut c, "unsupported intrinsic '" + name + "'"); return 0 }
