fn enum_type(c: &Session, ty: i32) -> bool { ft.enum_type(&c.types, ty) }
fn extract_result(c: &mut Session, ty: i32, value: i32, box: i32, at: i32) {
    mut payload := -1
    if value != 0 {
        payload = slot(&mut c)
        arm.load(&mut c.code, box)
        place_step(&mut c, .Member, value, 0, i32(place_op.Member.Payload), 1, at)
        if owned(&c, value) && !ft.move_only(&c.types, ty) { copy_value(&mut c, value) }
        arm.store(&mut c.code, payload, 0)
        if owned(&c, value) && ft.move_only(&c.types, ty) {
            arm.load(&mut c.code, box)
            store_mem(&mut c, 31, 0, 8)
        }
    }
    arm.load(&mut c.code, box)
    drop_value(&mut c, ty)
    if payload >= 0 { arm.load(&mut c.code, payload) }
}
fn propagate_result(c: &mut Session, ty: i32, question: i32) -> i32 {
    if !c.ok { return 0 }
    if !ft.is_result(&c.types, ty) || !ft.is_result(&c.types, c.body.ret_type) {
        fail(&mut c, "'?' requires a Result operand and a function returning Result")
        c.error_at = c.world.tokens.starts[question]; return 0
    }
    failure := c.types.result_failure[ty]
    if failure != c.types.result_failure[c.body.ret_type] || c.body.in_defer {
        message := if c.body.in_defer { "'?' is not allowed inside defer" } else { "'?' requires the same error type as the enclosing Result" }
        fail(&mut c, message)
        c.error_at = c.world.tokens.starts[question]; return 0
    }
    take_value(&mut c, ty)
    if !c.ok { return 0 }
    success := c.types.result_success[ty]
    if c.code.checking { return temporary(&mut c, success) }
    box := slot(&mut c); arm.store(&mut c.code, box, 0)
    place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Tag), 0, question)
    ok := new_block(&mut c)
    source_edge(&mut c, ok, .WhenFalse, question)
    continuing := ownership.snapshot(&c.body.ownership)
    if ty == c.body.ret_type {
        arm.load(&mut c.code, box)
    } else {
        extract_result(&mut c, ty, failure, box, question)
        if failure != 0 { arm.push_temp(&mut c.code, 0) }
        size := if failure == 0 { 8 } else { 16 }
        source := c.world.tokens.starts[question]
        arm.allocate_value(&mut c.code, c.runtime.alloc, .EnumPayload, c.body.ret_type, size, source)
        arm.enum_value(&mut c.code, 1, c.body.ret_type, 1, 1, source)
        place_step(&mut c, .Member, c.body.ret_type, i32(borrows.Access.Address), i32(place_op.Member.TagWrite), 0, question)
        if failure != 0 {
            arm.pop_temp(&mut c.code, 1)
            place_step(&mut c, .Member, failure, i32(borrows.Access.Address), i32(place_op.Member.Initialize), 1, question)
        }
    }
    return_from_body(&mut c, question)
    ownership.restore(&mut c.body.ownership, &continuing)
    bind_block(&mut c, ok)
    extract_result(&mut c, ty, success, box, question)
    temporary(&mut c, success)
}
fn enumeration(c: &mut Session, ty: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    name := advance(&mut c)
    if !enum_type(&c, ty) { fail(&mut c, "enum variant needs a type"); return 0 }
    found := field(&c, ty, name)
    if found < 0 { fail(&mut c, "unknown enum variant"); return ty }
    variant_at := c.body.cursor - 1; source := c.world.tokens.starts[variant_at]
    variant := found - ft.type_start(&c.types, ty)
    if ft.type_kind(&c.types, ty) == 3 {
        arm.enum_value(&mut c.code, 0, ty, variant, c.types.field_values[found], source); return ty
    }
    count := c.types.payload_counts[found]
    arm.allocate_value(&mut c.code, c.runtime.alloc, .EnumPayload, ty, (count + 1) * 8, source)
    index := slot(&mut c); arm.store(&mut c.code, index, 0); arm.enum_value(&mut c.code, 1, ty, variant, c.types.field_values[found], source)
    place_step(&mut c, .Member, ty, i32(borrows.Access.Address), i32(place_op.Member.TagWrite), 0, variant_at)
    pending := c.body.pending.slots.len
    stage_owner(&mut c, .Storage, index, ty, 0)
    if count > 0 {
        expect(&mut c, "(")
        for i in 0..count {
            if i > 0 { expect(&mut c, ",") }
            payload_at := c.body.cursor; pt := c.types.payload_types[c.types.payload_starts[found] + i]
            actual := expression(&mut c, 0, pt, &catalog, &mut inline_work, &mut model); same(&mut c, pt, actual); take_value(&mut c, pt)
            arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, index)
            place_step(&mut c, .Member, pt, i32(borrows.Access.Address), i32(place_op.Member.Initialize), i + 1, payload_at)
            stage_owner(&mut c, .Field, index, pt, i + 1)
        }
        expect(&mut c, ")")
    }
    fc.finish_pending(&mut c.body.pending, pending)
    arm.load(&mut c.code, index); fc.clear_rvalue_place(&mut c.body.place); temporary(&mut c, ty)
}
fn new_block(c: &mut Session) -> i32 {
    arm.label(&mut c.code) - c.body.block_base
}
fn bind_block(c: &mut Session, id: i32) { arm.mark(&mut c.code, c.body.block_base + id) }
fn source_edge(c: &mut Session, id: i32, action: row.Edge, token: i32) {
    arm.source_edge(&mut c.code, c.body.block_base + id, action, c.world.tokens.starts[token])
}
fn trap_edge(c: &mut Session, label: i32, action: row.Edge, token: i32) {
    arm.source_edge(&mut c.code, label, action, c.world.tokens.starts[token])
}
fn statement_separator(c: &Session, pos: i32) -> bool {
    lexer.is_newline(c.world.tokens.kinds[pos]) || c.world.tokens.kinds[pos] == .End ||
        c.world.tokens.texts[pos] == ";" || c.world.tokens.texts[pos] == "}"
}
fn assert_end(c: &Session, closing_paren: bool, pos: i32) -> bool {
    if closing_paren { return c.world.tokens.kinds[pos] == .Symbol && c.world.tokens.texts[pos] == ")" }
    statement_separator(&c, pos)
}
fn assert_operands(c: &Session, first: i32, closing_paren: bool) -> fc.AssertOperands {
    mut operands := fc.no_assert_operands()
    if c.code.checking || c.code.platform == 3 || !c.ok { return operands }
    operands.first = first; operands.closing_paren = closing_paren
    // Parentheses enclosing the entire condition do not change its root operator.
    while c.world.tokens.kinds[operands.first] == .Symbol && c.world.tokens.texts[operands.first] == "(" {
        after := lookahead.group_end(&c.world.tokens, &c.world.closes, operands.first, 0)
        if after >= c.world.tokens.kinds.len || !assert_end(&c, operands.closing_paren, after) { break }
        operands.first += 1; operands.closing_paren = true
    }
    operands
}
fn capture_assert_operands(c: &mut Session, ty: i32) {
    mut display := ty
    if ft.type_kind(&c.types, ty) == 3 { display = 1 }
    // A computed rune can be outside the Unicode scalar range.
    if ty == 5 { display = 2 }
    if ty == 13 { display = 12 }
    if display < 1 || display > 12 { return }
    left := slot(&mut c); right := slot(&mut c)
    arm.store(&mut c.code, left, 1); arm.store(&mut c.code, right, 0)
    c.body.assert_operands.ty = display; c.body.assert_operands.left = left; c.body.assert_operands.right = right
}
fn format_assert_operand(c: &mut Session, home: i32, ty: i32, source: i32) {
    arm.load(&mut c.code, home)
    if ty == 4 { return }
    if floats.has(ty) { format_float(&mut c, ty, source); return }
    mut target := c.runtime.string_integer
    if ty == 3 { target = c.runtime.string_bool }
    arm.intrinsic_call(&mut c.code, target, .Format, ty, 4, source)
}
fn assert_value(c: &mut Session, token: i32, first: i32, last: i32, operands: &fc.AssertOperands) {
    if !c.ok { return }
    if c.code.checking || c.code.platform == 3 {
        trap_edge(&mut c, c.assertion, .Assert, token); return
    }
    failed := arm.label(&mut c.code); done := arm.label(&mut c.code)
    trap_edge(&mut c, failed, .Assert, token)
    trap_edge(&mut c, done, .Jump, token)
    arm.mark(&mut c.code, failed)
    message := arm.label(&mut c.code)
    c.body.facts.assert_tokens.push(token); c.body.facts.assert_begins.push(first)
    c.body.facts.assert_ends.push(last); c.body.facts.assert_labels.push(message)
    source := c.world.tokens.starts[token]
    if operands.ty != 0 {
        format_assert_operand(&mut c, operands.left, operands.ty, source)
        arm.push_temp(&mut c.code, 0)
        format_assert_operand(&mut c, operands.right, operands.ty, source)
        arm.mov(&mut c.code, 2, 0); arm.pop_temp(&mut c.code, 1)
        arm.branch(&mut c.code, message, 20); arm.branch(&mut c.code, c.runtime.assert_values, 1)
    } else {
        arm.branch(&mut c.code, message, 20)
        arm.intrinsic_call(&mut c.code, c.runtime.assert_report, .Print, 4, 0, source)
    }
    trap_edge(&mut c, c.assertion, .Jump, token)
    arm.mark(&mut c.code, done)
}
fn arm_error(c: &mut Session, match_arm: bool, message: string) {
    if match_arm { fail(&mut c, "match arm " + message) } else { fail(&mut c, "if branch " + message) }
}
fn take_return_value(c: &mut Session, ty: i32, at: i32) {
    if !c.ok { return }
    if ft.type_kind(&c.types, ty) != 4 { take_value(&mut c, ty); return }
    if c.body.expr.untyped_exit && !ownership.falls_through(&c.body.ownership) { return }
    source := c.body.return_borrow_origin
    if source < 0 || c.body.loan.origin != source || c.body.loan.path < 0 || c.body.loan.root < 0 {
        mut message := "returned borrow must come from its declared shared parameter"
        if source >= 0 { message = message + " '" + c.world.param_names[source] + "'" }
        fail(&mut c, message)
        c.error_at = c.world.tokens.starts[at]
    }
}
fn yield_value(c: &mut Session, ty: i32, home: i32, match_arm: bool) {
    if !c.ok { return }
    if ty == 0 { arm_error(&mut c, match_arm, "must produce a value"); return }
    kind := ft.type_kind(&c.types, ty)
    if kind == 5 || (kind == 4 && c.body.return_borrow_origin < 0) { arm_error(&mut c, match_arm, "cannot return a borrow"); return }
    take_return_value(&mut c, ty, c.body.cursor)
    arm.store(&mut c.code, home, 0)
}
fn branch_value(c: &mut Session, expected: i32, home: i32, match_arm: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    if match_arm && !is(&c, "{") {
        live := ownership.falls_through(&c.body.ownership)
        ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
        if (ty == 0 && c.body.expr.untyped_exit) || (live && !ownership.falls_through(&c.body.ownership)) { return 0 }
        yield_value(&mut c, ty, home, match_arm)
        return ty
    }
    if !is(&c, "{") { fail(&mut c, "expected '{'"); return 0 }
    previous := c.body.value_block; end := c.world.closes[c.body.cursor]
    c.body.value_block = fc.ValueBlock { end: end, home: home, expected: expected, ty: 0, match_arm: match_arm }
    ends := block(&mut c, false, &catalog, &mut inline_work, &mut model)
    ty := c.body.value_block.ty
    c.body.value_block = previous
    if ends { return 0 }
    if c.ok && ty == 0 {
        arm_error(&mut c, match_arm, "must produce a value")
        c.error_at = c.world.tokens.starts[end]
    }
    return ty
}
fn if_arms(c: &mut Session, expected: i32, home: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    done := new_block(&mut c)
    mut result := 0
    mut context := expected
    mut outcomes := ownership.new(); ownership.terminate(&mut outcomes)
    mut outcome_seen := false
    mut falling_through := false
    while c.ok {
        condition_at := c.body.cursor
        condition := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model)
        same(&mut c, 3, condition)
        before_arm := ownership.snapshot(&c.body.ownership)
        otherwise := new_block(&mut c)
        source_edge(&mut c, otherwise, .WhenFalse, condition_at)
        ty := branch_value(&mut c, context, home, false, &catalog, &mut inline_work, &mut model)
        if ty != 0 {
            if result == 0 { result = ty; context = ty } else { same(&mut c, result, ty) }
        }
        accepted := ownership.snapshot(&c.body.ownership); prior := ownership.snapshot(&outcomes)
        if outcome_seen { join_statement_outcomes(&mut outcomes, &prior, !falling_through, &accepted, ty == 0) }
        else { ownership.restore(&mut outcomes, &accepted); outcome_seen = true }
        falling_through = falling_through || ty != 0
        ownership.restore(&mut c.body.ownership, &before_arm)
        source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, otherwise)
        newlines(&mut c); expect(&mut c, "else")
        if !eat(&mut c, "if") { break }
    }
    if !c.ok { return 0 }
    last := branch_value(&mut c, context, home, false, &catalog, &mut inline_work, &mut model)
    if result == 0 { result = last } else if last != 0 { same(&mut c, result, last) }
    last_state := ownership.snapshot(&c.body.ownership)
    join_statement_outcomes(&mut c.body.ownership, &outcomes, !falling_through, &last_state, last == 0)
    bind_block(&mut c, done)
    result
}
fn choice_arms(c: &mut Session, expected: i32, home: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    if eat(&mut c, "if") { return if_arms(&mut c, expected, home, &catalog, &mut inline_work, &mut model) }
    expect(&mut c, "match")
    mut result := 0
    _ := match_arms(&mut c, expected, home, &mut result, &catalog, &mut inline_work, &mut model)
    result
}
struct ArrayIntegerPrefix { end: i32, default_type: i32 }
fn array_integer_prefix(c: &Session, first: i32) -> ArrayIntegerPrefix {
    mut pos := first; mut default_type := 1
    mut element := lookahead.IntegerElement { token: -1, end: -1, negative: false }
    while lookahead.integer_element(&c.world.tokens, pos, &mut element) {
        if default_type == 1 {
            mut spelling := c.world.tokens.texts[element.token].clone()
            if element.negative { spelling = "-" + spelling }
            mut number := rules.literal_integer(spelling)
            _ := rules.validate_signed(&mut number, 1)
            if !number.ok { default_type = 2 }
        }
        pos = element.end
        if c.world.tokens.texts[pos] != "," { break }
        pos += 1
    }
    ArrayIntegerPrefix { end: pos, default_type: default_type }
}
fn initialize_array_element(c: &mut Session, array: i32, ty: i32, source: i32) {
    arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, array); arm.pop_temp(&mut c.code, 1)
    arm.intrinsic_call(&mut c.code, c.runtime.array_push, .ArrayInitializeElement, ty, 0, source)
}
fn initialize_integer_prefix(c: &mut Session, array: i32, first: i32, last: i32, ty: i32,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    // The anchor is scalar and the prefix contains constants only. Hold the anchor
    // while filling the leading slots, so every nonliteral expression runs in source order.
    after := c.body.cursor; c.body.cursor = first
    arm.push_temp(&mut c.code, 0)
    mut count := 0
    while c.ok && c.body.cursor < last {
        token := c.body.cursor
        literal_type := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model)
        same(&mut c, ty, literal_type); expect(&mut c, ",")
        if !c.ok { c.error_at = c.world.tokens.starts[token]; break }
        initialize_array_element(&mut c, array, ty, c.world.tokens.starts[token]); count += 1
    }
    c.body.cursor = after; arm.pop_temp(&mut c.code, 0)
    count
}
fn array_literal(c: &mut Session, token: i32, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    first := c.body.cursor
    mut base := 0
    mut default_type := 1
    if collection(&c, expected) { base = ft.type_base(&c.types, expected) }
    else {
        prefix := array_integer_prefix(&c, first)
        if prefix.end > first {
            default_type = prefix.default_type
            end := &c.world.tokens.texts[prefix.end]
            if end == "]" || end == ";" { base = default_type }
            else { c.body.cursor = prefix.end }
        }
    }
    anchor := c.body.cursor
    mut count := 0; mut repeated := false
    allocation := arm.position(&c.code); source := c.world.tokens.starts[token]
    arm.intrinsic_call(&mut c.code, c.runtime.array_new, .ArrayNew, base, expected, source)
    saved := slot(&mut c); arm.store(&mut c.code, saved, 0)
    pending := c.body.pending.slots.len
    stage_owner(&mut c, .Array, saved, base, 0)
    while c.ok && !is(&c, "]") {
        element := c.body.cursor; element_source := c.world.tokens.starts[element]
        mut ty := expression(&mut c, 0, base, &catalog, &mut inline_work, &mut model)
        if !c.ok { return 0 }
        if element == anchor && anchor > first {
            if c.body.expr.untyped_exit { ty = default_type }
            else { ty = read_scalar_result(&mut c, ty, element) }
            if ty != 1 && ty != 2 && !unsigned.has(ty) && !floats.has(ty) {
                same(&mut c, default_type, ty)
                return 0
            }
            count = initialize_integer_prefix(&mut c, saved, first, anchor, ty, &catalog, &mut inline_work, &mut model)
            if !c.ok { return 0 }
            if c.body.pending.slots.len > pending { c.body.pending.types[pending] = ty }
        }
        if base == 0 { base = ty } else { same(&mut c, base, ty) }
        if count == 0 && c.body.pending.slots.len > pending { c.body.pending.types[pending] = base }
        if count == 0 && eat(&mut c, ";") {
            repeated = true; count = length_literal(&mut c)
            if !ft.cloneable(&c.types, ty) { fail(&mut c, "resource values cannot be repeated or cloned"); return 0 }
            take_value(&mut c, ty)
            item := slot(&mut c); left := slot(&mut c)
            if owned(&c, ty) { save_owner(&mut c, item, ty, true) } else { arm.store(&mut c.code, item, 0) }
            arm.imm(&mut c.code, 0, i64(count)); arm.store(&mut c.code, left, 0)
            head := arm.label(&mut c.code); done := arm.label(&mut c.code)
            arm.mark(&mut c.code, head); arm.load(&mut c.code, left); arm.branch(&mut c.code, done, 18)
            arm.integer_binary(&mut c.code, 2, true, false, 0, 0, -1, 1); arm.store(&mut c.code, left, 0)
            arm.load(&mut c.code, item); copy_value(&mut c, ty); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, saved)
            arm.intrinsic_call(&mut c.code, c.runtime.array_push, .ArrayInitializeElement, ty, 0, element_source)
            arm.branch(&mut c.code, head, 0); arm.mark(&mut c.code, done)
            break
        }
        count += 1; take_value(&mut c, ty)
        initialize_array_element(&mut c, saved, ty, element_source)
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, "]"); arm.load(&mut c.code, saved); fc.clear_rvalue_place(&mut c.body.place)
    if base == 0 { fail(&mut c, "empty array needs an element type") }
    fc.finish_pending(&mut c.body.pending, pending)
    mut ty := compound(&mut c, 1, base); if repeated || ft.type_kind(&c.types, expected) != 1 { ty = fixed(&mut c, base, count) }
    arm.finish_array_literal(&mut c.code, allocation, base, ty, unsigned.shift(storage_type(&c, base)), source)
    array_element_helpers(&mut c, base)
    temporary(&mut c, ty)
}
fn tuple_literal(c: &mut Session, ty: i32, at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    first := ft.type_start(&c.types, ty); count := ft.type_count(&c.types, ty)
    home := slot(&mut c)
    arm.allocate_value(&mut c.code, c.runtime.alloc_record, .Record, ty, count * 8, c.world.tokens.starts[at])
    arm.store(&mut c.code, home, 0)
    pending := c.body.pending.slots.len
    stage_owner(&mut c, .Storage, home, ty, 0)
    for i in 0..count {
        if !c.ok { break }
        newlines(&mut c)
        if i > 0 && !is(&c, ")") { expect(&mut c, ","); newlines(&mut c) }
        if is(&c, ")") { fail(&mut c, "too few components in tuple literal"); break }
        component := c.body.cursor
        field_type := c.types.field_types[first + i]
        actual := expression(&mut c, 0, field_type, &catalog, &mut inline_work, &mut model)
        same(&mut c, field_type, actual)
        if !c.ok { break }
        take_value(&mut c, field_type)
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, home)
        place_step(&mut c, .Member, field_type, i32(borrows.Access.Address), i32(place_op.Member.Initialize), i, component)
        stage_owner(&mut c, .Field, home, field_type, i)
    }
    newlines(&mut c)
    if eat(&mut c, ",") { newlines(&mut c) }
    if !eat(&mut c, ")") { fail(&mut c, "too many components in tuple literal") }
    fc.finish_pending(&mut c.body.pending, pending)
    if !c.ok { return 0 }
    arm.load(&mut c.code, home); fc.clear_rvalue_place(&mut c.body.place)
    temporary(&mut c, ty)
}
fn primary_inner(c: &mut Session, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, place: &mut i32, at: &mut i32, pending: &mut bool) -> i32 {
    if !c.ok { return 0 }
    token := c.body.cursor; kind := c.world.tokens.kinds[token]
    if model.probing {
        if !model.recording && decline_projection(&mut c, &mut model) { return 0 }
        model.value = -1; model.array = -1
        if kind != .Name && kind != .Integer {
            word := c.world.tokens.texts[token].clone()
            symbol := kind == .Symbol && (word == "-" || word == "!" || word == "(")
            boolean := kind == .Keyword && (word == "true" || word == "false")
            if !symbol && !boolean && model.probing && decline_projection(&mut c, &mut model) { return 0 }
        }
    }
    if eat(&mut c, "move") {
        value := primary(&mut c, expected, &catalog, &mut inline_work, &mut model)
        take_value(&mut c, value); place = 0; return temporary(&mut c, value)
    }
    if kind == .Float { spelling := advance(&mut c); return float_literal(&mut c, spelling, expected) }
    if kind == .Integer { spelling := advance(&mut c); return literal(&mut c, &mut model, spelling, expected) }
    if kind == .Byte { text := advance(&mut c); parsed := parse.integer(text); assert(parsed.ok && parsed.value >= 0 && parsed.value <= 255); arm.imm(&mut c.code, 0, parsed.value); return 8 }
    if kind == .String || kind == .Rune {
        text := advance(&mut c)
        if kind == .Rune { scalar := text.runes()[0]; arm.imm(&mut c.code, 0, i64(i32(scalar))); return 5 }
        target := arm.label(&mut c.code)
        if !c.code.checking { c.body.facts.literal_tokens.push(token); c.body.facts.literal_labels.push(target) }
        arm.branch(&mut c.code, target, 20)
        return temporary(&mut c, 4)
    }
    if kind == .Name {
        next := c.world.tokens.kinds[token + 1]
        if next == .Name || (next == .Symbol && c.world.tokens.texts[token + 1] == "!") {
            if next == .Name && is(&c, "spawn") {
                if model.probing && decline_projection(&mut c, &mut model) { return 0 }
                return task_spawn(&mut c, &catalog, &mut inline_work, &mut model)
            }
            if is(&c, "await") {
                if model.probing && decline_projection(&mut c, &mut model) { return 0 }
                return task_await_expression(&mut c, &catalog, &mut inline_work, &mut model)
            }
        }
        c.body.cursor = token + 1
        found := local(&c.body, c.world.tokens.texts[token])
        if found >= 0 && (next != .Symbol || (c.world.tokens.texts[token + 1] != "(" && c.world.tokens.texts[token + 1] != "::")) {
            if model.recording { typed.read(&mut model, found, token) }
            place = borrows.local_id(found); at = c.body.cursor - 1
            pending = true
            return local_value_type(&mut c, found)
        }
        if model.probing && decline_projection(&mut c, &mut model) { return 0 }
        name := c.world.tokens.texts[token].clone()
        mut nominal := -1
        if found < 0 || (next == .Symbol && c.world.tokens.texts[token + 1] == "::") { nominal = resolve_type_name(&c, name) }
        if eat(&mut c, "::") {
            if nominal < 0 {
                if name == "Self" { fail(&mut c, "Self is only valid inside an impl block") }
                else { fail(&mut c, "unknown type '" + name + "'") }
                c.error_at = c.world.tokens.starts[token]; return 0
            }
            if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected method name after '::'"); return 0 }
            method_tok := c.body.cursor; method_name := advance(&mut c)
            f := impl_method(&c, nominal, method_name)
            if f < 0 {
                fail(&mut c, "unknown associated function '" + type_spelling(&c, nominal) + "::" + method_name + "'")
                c.error_at = c.world.tokens.starts[method_tok]; return 0
            }
            if !check_impl_access(&mut c, f, method_tok) { return 0 }
            if eat(&mut c, "(") {
                if c.world.unsafe_functions[f] && !c.body.unsafe_scope { fail(&mut c, "call requires unsafe"); return 0 }
                c.body.facts.needed.push(f)
                result := invoke(&mut c, c.world.ffi_types[f], -1, f, -1, &catalog, &mut inline_work, &mut model)
                fc.clear_rvalue_place(&mut c.body.place)
                return call_result(&mut c, result)
            }
            if c.world.unsafe_functions[f] { fail(&mut c, "unsafe function requires a foreign function pointer"); return 0 }
            return function_value(&mut c, f, token)
        }
        if floats.has(nominal) && eat(&mut c, ".") {
            expect(&mut c, "from_bits"); expect(&mut c, "(")
            mut bits := 2; if nominal == 6 { bits = 1 }
            actual := expression(&mut c, 0, bits, &catalog, &mut inline_work, &mut model); same(&mut c, bits, actual); expect(&mut c, ")")
            if nominal == 6 { arm.integer_binary(&mut c.code, 9, false, false, 0, 31, 0, -1) }
            return nominal
        }
        if enum_type(&c, nominal) && eat(&mut c, ".") { return enumeration(&mut c, nominal, &catalog, &mut inline_work, &mut model) }
        if enum_type(&c, nominal) && eat(&mut c, "(") {
            if ft.type_kind(&c.types, nominal) != 3 { fail(&mut c, "a data enum requires a variant"); return nominal }
            actual := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, actual); expect(&mut c, ")")
            valid := arm.label(&mut c.code)
            first := ft.type_start(&c.types, nominal)
            for field in first..first+ft.type_count(&c.types, nominal) {
                arm.imm(&mut c.code, 2, c.types.field_values[field])
                arm.compare_register(&mut c.code, 0, 2)
                arm.branch(&mut c.code, valid, 2)
            }
            arm.fail_source(&mut c.code, .InvalidEnum, c.world.tokens.starts[token]); arm.mark(&mut c.code, valid)
            fc.clear_rvalue_place(&mut c.body.place)
            return nominal
        }
        if nominal >= 0 && ft.type_kind(&c.types, nominal) == 2 && eat(&mut c, "{") {
            opaque_access(&mut c, nominal)
            if ft.is_c_record(&c.types, nominal) { zero_record(&mut c, nominal, token) }
            else { arm.allocate_value(&mut c.code, c.runtime.alloc_record, .Record, nominal, ft.type_count(&c.types, nominal) * 8, c.world.tokens.starts[token]) }
            saved := slot(&mut c); arm.store(&mut c.code, saved, 0); mut provided: []bool = []
            pending := c.body.pending.slots.len
            stage_owner(&mut c, .Storage, saved, nominal, 0)
            for i in 0..ft.type_count(&c.types, nominal) { provided.push(false) }; separators(&mut c)
            while c.ok && !is(&c, "}") {
                member_at := c.body.cursor; member := advance(&mut c); expect(&mut c, ":"); found := field(&c, nominal, member)
                if found < 0 { fail(&mut c, "unknown constructor field"); break }
                offset := found - ft.type_start(&c.types, nominal)
                if provided[offset] { fail(&mut c, "duplicate constructor field") }; provided[offset] = true
                ty := expression(&mut c, 0, c.types.field_types[found], &catalog, &mut inline_work, &mut model); same(&mut c, c.types.field_types[found], ty)
                if ft.is_c_record(&c.types, nominal) {
                    take_inline(&mut c, ty)
                    arm.push_temp(&mut c.code,0); arm.load(&mut c.code,saved); place_step(&mut c, .Field, ty, i32(borrows.Access.Address), 0, i32(c.types.field_values[found]), member_at)
                    arm.mov(&mut c.code,1,0); arm.pop_temp(&mut c.code,0); store_inline(&mut c, ty, member_at)
                } else {
                    take_value(&mut c, ty); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, saved); place_step(&mut c, .Member, ty, i32(borrows.Access.Address), i32(place_op.Member.Initialize), offset, member_at)
                    stage_owner(&mut c, .Field, saved, ty, offset)
                }
                if !eat(&mut c, ",") { break }; separators(&mut c)
            }
            separators(&mut c); expect(&mut c, "}")
            for present in provided { if !present { fail(&mut c, "missing constructor field") } }
            fc.finish_pending(&mut c.body.pending, pending)
            arm.load(&mut c.code, saved); fc.clear_rvalue_place(&mut c.body.place); return temporary(&mut c, nominal)
        }
        if is(&c, "(") {
            if found >= 0 {
                sig := local_value_type(&mut c, found); callable_kind := ft.type_kind(&c.types, sig)
                if callable_kind != 8 && callable_kind != 9 { fail(&mut c, "local value is not callable"); return 0 }
                expect(&mut c, "(")
                if sig == c.body.locals.types[found] { arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[found])) }
                else { load_binding(&mut c, found, .Value, token, true) }
                if callable_kind == 8 {
                    result := foreign_call(&mut c, sig, &catalog, &mut inline_work, &mut model)
                    return temporary(&mut c, result)
                }
                callee := slot(&mut c); arm.store(&mut c.code, callee, 0)
                result := invoke(&mut c, sig, callee, -1, -1, &catalog, &mut inline_work, &mut model)
                fc.clear_rvalue_place(&mut c.body.place); return call_result(&mut c, result)
            }
            result := call(&mut c, name, expected, &catalog, &mut inline_work, &mut model); fc.clear_rvalue_place(&mut c.body.place); return call_result(&mut c, result) }
        if found < 0 {
            f := i32(map.get_or(&c.world.functions, name, -1))
            if f >= 0 && c.world.libraries[f] != "" { may_invalidate_operand(&mut c); import_address(&mut c, f); return c.world.ffi_types[f] }
        }
        if found < 0 {
            if name == "Self" { fail(&mut c, "expected 'Self::...', 'Self { ... }', or 'Self.Variant'"); c.error_at = c.world.tokens.starts[token]; return 0 }
            f := i32(map.get_or(&c.world.functions, name, -1))
            if f < 0 { fail(&mut c, "unknown local '" + name + "'"); c.error_at = c.world.tokens.starts[c.body.cursor - 1]; return 0 }
            check_function_caps(&mut c, f, c.body.cursor - 1)
            if !c.ok { return 0 }
            if c.world.unsafe_functions[f] { fail(&mut c, "unsafe function requires a foreign function pointer"); return 0 }
            return function_value(&mut c, f, token)
        }
        fail(&mut c, "expected expression"); return 0
    }
    if is(&c, "if") || is(&c, "match") {
        home := slot(&mut c)
        result := choice_arms(&mut c, expected, home, &catalog, &mut inline_work, &mut model)
        if !c.ok { return 0 }
        fc.clear_place_eval(&mut c.body.place)
        if result == 0 {
            ty := temporary(&mut c, expected); c.body.expr.untyped_exit = true
            return ty
        }
        arm.load(&mut c.code, home)
        if ft.type_kind(&c.types, result) == 4 {
            fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
            binding := c.body.return_borrow_origin - c.body.first_parameter
            c.body.loan.root = binding; c.body.loan.origin = c.body.return_borrow_origin
            c.body.loan.path = ownership.root_id(&c.body.ownership, binding); c.body.loan.constrained = true
            return result
        }
        return temporary(&mut c, result)
    }
    if eat(&mut c, "&") {
        may_invalidate_operand(&mut c)
        mutable := eat(&mut c, "mut")
        mut kind := 4; if mutable { kind = 5 }
        if expected != 0 && ft.type_kind(&c.types, expected) != kind { fail(&mut c, "use & for a shared parameter or &mut for a mutable parameter"); return 0 }
        previous_address := c.body.place.taking_address; c.body.place.taking_address = true
        previous_depth := c.body.loan.depth
        if !mutable { c.body.loan.depth = c.body.depth + 1 }
        mut context := 0; if expected != 0 { context = ft.type_base(&c.types, expected) }
        mut ty := primary(&mut c, context, &catalog, &mut inline_work, &mut model)
        c.body.loan.depth = previous_depth
        c.body.place.taking_address = previous_address
        place = c.body.places.current; at = c.body.places.source
        if ft.type_kind(&c.types, ty) == 4 {
            if mutable { fail(&mut c, "cannot mutably borrow a shared reference"); return 0 }
            fc.clear_rvalue_place(&mut c.body.place); return ty
        }
        if c.body.loan.home >= 0 {
            if mutable { fail(&mut c, "borrowed ranges are read-only"); return 0 }
            home := c.body.loan.home; place_step(&mut c, .BorrowHome, ty, 3, 0, home, token)
            if !constrain_borrow(&mut c) { return 0 }
            fc.clear_rvalue_place(&mut c.body.place)
            return compound(&mut c, 4, ty)
        }
        base := borrows.root(&c.body.places, place)
        if base < 0 {
            if mutable { fail(&mut c, "mutable borrow requires a named variable, field or array element"); return 0 }
            read_argument(&mut c, ty, token)
            if !constrain_borrow(&mut c) { return 0 }
            fc.clear_rvalue_place(&mut c.body.place)
            return compound(&mut c, 4, ty)
        }
        if mutable && is_for_locked(&c, base) { fail(&mut c, "cannot mutably borrow a collection while iterating over it"); return 0 }
        if mutable && !writable_loan(&mut c, place) { return 0 }
        if mutable { c.body.mutations.push(base) }
        if ft.type_kind(&c.types, ty)==21 {
            elem:=ft.type_base(&c.types, ty)
            if mutable || ft.type_kind(&c.types, expected)!=4 || ft.type_kind(&c.types, ft.type_base(&c.types, expected))!=1 || ft.type_base(&c.types, ft.type_base(&c.types, expected))!=elem || !ft.scalar_element(&c.types, elem) || i32(1).shl(unsigned.shift(storage_type(&c, elem)))!=scratch_width(&c,elem) {fail(&mut c,"scratch slice needs a shared, representation-compatible parameter");return 0}
            ty=ft.type_base(&c.types, expected)
        }else if c.body.place.scratch==1 && ft.type_kind(&c.types, ty)!=2 && i32(1).shl(unsigned.shift(storage_type(&c, ty)))!=scratch_width(&c,ty) {
            fail(&mut c,"borrow a value-compatible scratch element or record field");return 0
        }
        if c.body.place.address < 0 { fail(&mut c, "borrow requires a stored value"); return 0 }
        if mutable && !c.body.place.writable { fail(&mut c, "mutable borrow requires mut or &mut") }
        c.body.loan.path = owner_path(&c, place); c.body.loan.root = source_root(&c, place)
        c.body.loan.origin = loan_origin(&c, place)
        c.body.loan.constrained = local_borrows.shared(&c.body.local_loans, base)
        borrow_address(&mut c, ty, mutable, token, place); fc.clear_rvalue_place(&mut c.body.place)
        return compound(&mut c, kind, ty)
    }
    if eat(&mut c, "-") {
        if c.world.tokens.kinds[c.body.cursor] == .Integer { spelling := "-" + advance(&mut c); return literal(&mut c, &mut model, spelling, expected) }
        value := primary(&mut c, expected, &catalog, &mut inline_work, &mut model)
        ty := read_scalar_result(&mut c, value, token)
        if model.recording { _ := typed.node(&mut model, 4, ty, model.value, -1, -1, 1, -1, token) }
        if floats.has(ty) { result := floats.method(&mut c.code, ty, "negate", c.world.tokens.starts[token]); fc.clear_rvalue_place(&mut c.body.place); return result }
        if ty != 1 && ty != 2 { fail(&mut c, "minus requires a signed number") }
        arm.integer_binary(&mut c.code, 2, true, true, 0, 31, 0, -1); arm.branch(&mut c.code, c.overflow, 8); if ty == 1 { narrow(&mut c) }; fc.clear_rvalue_place(&mut c.body.place); return ty
    }
    if eat(&mut c, "!") {
        value := primary(&mut c, 3, &catalog, &mut inline_work, &mut model)
        ty := read_scalar_result(&mut c, value, token); same(&mut c, 3, ty)
        if model.recording { _ := typed.node(&mut model, 4, 3, model.value, -1, -1, 2, -1, token) }
        arm.compare_register(&mut c.code, 0, 31); arm.set_condition(&mut c.code, 0, 0); fc.clear_rvalue_place(&mut c.body.place); return 3
    }
    if eat(&mut c, "(") {
        if ft.is_tuple(&c.types, expected) && lookahead.tuple_group(&c.world.tokens, &c.world.closes, c.body.cursor) {
            return tuple_literal(&mut c, expected, token, &catalog, &mut inline_work, &mut model)
        }
        previous_depth := c.body.loan.depth
        if c.body.loan.depth == c.body.depth { c.body.loan.depth = c.body.depth + 1 }
        ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
        c.body.loan.depth = previous_depth
        if is(&c, ",") { fail(&mut c, "tuple literal requires a tuple type in this context") }
        expect(&mut c, ")"); place = c.body.places.current; at = c.body.places.source; return ty
    }
    if eat(&mut c, "true") { if model.recording { _ := typed.node(&mut model, 1, 3, -1, -1, -1, 1, -1, token) }; arm.imm(&mut c.code, 0, 1); return 3 }
    if eat(&mut c, "false") { if model.recording { _ := typed.node(&mut model, 1, 3, -1, -1, -1, 0, -1, token) }; arm.imm(&mut c.code, 0, 0); return 3 }
    if eat(&mut c, ".") { return enumeration(&mut c, expected, &catalog, &mut inline_work, &mut model) }
    if eat(&mut c, "[") { return array_literal(&mut c, token, expected, &catalog, &mut inline_work, &mut model) }
    fail(&mut c, "expected expression"); 0
}
fn local_value_type(c: &mut Session, found: i32) -> i32 {
    ty := c.body.locals.types[found]; local_kind := ft.type_kind(&c.types, ty)
    if local_kind == 23 { fail(&mut c, "task scope capability is only valid with spawn or await"); return 0 }
    if local_kind == 20 { fail(&mut c, "region is only valid in an allocation"); return 0 }
    if local_kind == 4 || local_kind == 5 { return ft.type_base(&c.types, ty) }
    ty
}
fn load_binding(c: &mut Session, found: i32, access: borrows.Access, token: i32, whole: bool) {
    path := owner_path(&c, borrows.local_id(found))
    mut initialized := ownership.present(&c.body.ownership, path)
    if whole { initialized = ownership.available(&c.body.ownership, path) }
    if access != .Address && !initialized {
        fail(&mut c, "use of moved value '" + c.body.locals.names[found] + "'")
        c.error_at = c.world.tokens.starts[token]; return
    }
    local_type := c.body.locals.types[found]; kind := ft.type_kind(&c.types, local_type)
    home := places.local_home(c.body.places.arena.locals[found])
    c.body.place.scratch = 0; c.body.place.inline_storage = false
    if kind == 21 { c.body.place.scratch = 3 }
    if kind == 4 || kind == 5 {
        c.body.place.writable = kind == 5
        ty := ft.type_base(&c.types, local_type)
        c.body.place.address = home; c.body.place.direct = false
        if access != .Address { bound_place(&mut c, .BorrowSaved, borrows.local_id(found), i32(access), token) }
        if ft.is_c_record(&c.types, ty) || fixed_pod(&c, ty) {
            c_layout(&mut c, ty); c.body.place.inline_storage = true
            if access != .Address { inline_value(&mut c, ty, access, token) }
        } else if access != .Address { bound_place(&mut c, .Read, borrows.local_id(found), i32(access), token) }
    } else {
        c.body.place.writable = c.body.locals.mutable[found]; c.body.place.direct = true; c.body.place.address = home
        if access != .Address && (!c.code.checking || c.code.prefixing) { bound_place(&mut c, .LocalRead, borrows.local_id(found), i32(access), token) }
    }
}
fn field_offset(c: &Session, receiver: i32, member: i32) -> i32 {
    if ft.is_c_record(&c.types, receiver) { return i32(c.types.field_values[member]) }
    (member - ft.type_start(&c.types, receiver)) * 8
}
fn field_place(c: &mut Session, parent: i32, receiver: i32, member: i32, token: i32) -> i32 {
    ty := c.types.field_types[member]; packed := ft.is_c_record(&c.types, receiver)
    layout := places.layout(.Field, field_offset(&c, receiver, member), read_shape(&c, ty, packed))
    ordinal := member - ft.type_start(&c.types, receiver)
    mut owner := owner_path(&c, parent)
    if owner >= 0 && !borrows.has_index(&c.body.places, parent) && !local_borrows.shared(&c.body.local_loans, borrows.root(&c.body.places, parent)) {
        owner = ownership.project(&mut c.body.ownership, owner, ordinal)
    }
    return borrows.project(&mut c.body.places, parent, receiver, ordinal, ty, layout, token, c.world.tokens.starts[token], owner)
}
fn index_place(c: &mut Session, parent: i32, receiver: i32, packed: bool, index: i32, token: i32) -> i32 {
    mut ty := 1; mut kind := places.Projection.TextIndex; mut parameter := 0; mut shape := 0
    if receiver != 4 {
        if ft.type_kind(&c.types, receiver) != 21 && (!collection(&c, receiver) || ft.type_kind(&c.types, receiver) == 10) { return 0 }
        ty = ft.type_base(&c.types, receiver)
        if ty < 0 { return 0 }
        if ft.type_kind(&c.types, receiver) == 21 {
            kind = .RegionIndex; parameter = scratch_width(&c, ty); shape = read_shape(&c, ty, true)
        } else {
            kind = .ArrayIndex; parameter = unsigned.shift(storage_type(&c, ty)); shape = read_shape(&c, ty, packed)
            if packed && ft.is_c_record(&c.types, ty) {
                parameter = 0; while i32(1).shl(parameter) < ft.c_size(&c.types, ty) { parameter = parameter + 1 }
            }
        }
    }
    owner := owner_path(&c, parent)
    return borrows.project(&mut c.body.places, parent, receiver, index+1, ty, places.layout(kind, parameter, shape), token, c.world.tokens.starts[token], owner)
}
fn load_field(c: &mut Session, receiver: i32, member: i32, access: borrows.Access, token: i32, id: i32) -> i32 {
    if c.body.place.scratch != 0 { c.body.place.scratch = 2 }
    ty := c.types.field_types[member]; packed := ft.is_c_record(&c.types, receiver)
    bound_place(&mut c, .Field, id, i32(access), token)
    if access != .Value { save_address(&mut c, id, token) } else { c.body.place.address = -1; c.body.place.direct = false }
    c.body.place.inline_storage = packed
    if access != .Address {
        if packed && (ft.is_c_record(&c.types, ty) || ft.type_kind(&c.types, ty) == 6) { inline_value(&mut c, ty, access, token) }
        else { bound_place(&mut c, .Read, id, i32(access), token) }
    }
    ty
}
fn load_index(c: &mut Session, receiver: i32, packed: bool, writable: bool, access: borrows.Access, source_at: i32, id: i32) -> i32 {
    ty := places.place_type(&c.body.places.arena, 0, 0, id)
    bound_place(&mut c, .CheckIndex, id, i32(access), source_at)
    trap_edge(&mut c, c.bounds, .Bounds, source_at)
    bound_place(&mut c, .Element, id, i32(access), source_at)
    if receiver == 4 {
        bound_place(&mut c, .Read, id, i32(access), source_at)
        fc.clear_rvalue_place(&mut c.body.place); return ty
    }
    if access != .Value { save_address(&mut c, id, source_at) } else { c.body.place.address = -1; c.body.place.direct = false }
    region := ft.type_kind(&c.types, receiver) == 21
    c.body.place.scratch = 0; c.body.place.inline_storage = packed; c.body.place.writable = writable
    if region { c.body.place.scratch = 1; c.body.place.inline_storage = ft.is_c_record(&c.types, ty) }
    if access != .Address && !(region && ft.type_kind(&c.types, ty) == 2) {
        bound_place(&mut c, .Read, id, i32(access), source_at)
    }
    ty
}
fn borrow_address(c: &mut Session, ty: i32, mutable: bool, token: i32, place: i32) {
    mut intent := 3; if mutable { intent = 4 }
    if c.body.place.scratch == 1 && ft.type_kind(&c.types, ty) == 2 && !ft.is_c_record(&c.types, ty) {
        bound_place(&mut c, .BorrowHome, place, intent, token)
    } else if ft.is_c_record(&c.types, ty) {
        place_step(&mut c, .BorrowPayload, ty, intent, 0, 0, token)
    } else if fixed_pod(&c, ty) {
        place_step(&mut c, .Read, ty, intent, 3, 0, token)
    } else if c.body.place.inline_storage && ft.type_kind(&c.types, ty) == 6 {
        backing := slot(&mut c); arm.store(&mut c.code,backing,0); place_step(&mut c, .BorrowHome, ty, intent, 0, backing, token)
    } else if c.body.place.direct && place < 0 { bound_place(&mut c, .BorrowHome, place, intent, token) }
    else { bound_place(&mut c, .BorrowSaved, place, intent, token) }
}
fn lower_place(c: &mut Session, place: i32, base: i32, access: borrows.Access, root_at: i32) {
    if place < 0 { load_binding(&mut c, borrows.root(&c.body.places, place), access, root_at, true); return }
    path := owner_path(&c, place)
    if path >= 0 {
        mut initialized := true
        if access != .Address || borrows.has_index(&c.body.places, place) { initialized = ownership.available(&c.body.ownership, path) }
        else { initialized = ownership.parent_present(&c.body.ownership, path) }
        if !initialized {
            binding := borrows.root(&c.body.places, place)
            fail(&mut c, "use of moved value '" + c.body.locals.names[binding] + "'")
            c.error_at = c.world.tokens.starts[root_at]; return
        }
    }
    mut p := place
    c.body.places.path.clear()
    while p > 0 && p != base { c.body.places.path.push(p - 1); p = places.parent(c.body.places.arena.nodes[3 * (p - 1)]) }
    if base == 0 {
        if p >= 0 { fail(&mut c, "internal missing place root"); return }
        load_binding(&mut c, borrows.root(&c.body.places, p), .Value, root_at, false)
    } else if p != base { fail(&mut c, "internal inconsistent place path"); return }
    while c.body.places.path.len > 0 {
        node := c.body.places.path.pop()
        receiver := places.receiver(c.body.places.arena.nodes[3*node+1]); selector := places.selector(c.body.places.arena.nodes[3*node])
        mut need := borrows.Access.Value
        if c.body.places.path.len == 0 { need = access }
        if places.kind(places.storage(c.body.places.arena.nodes[3*node+2])) == i32(places.Projection.Field) {
            field_type := load_field(&mut c, receiver, ft.type_start(&c.types, receiver) + selector, need, c.body.places.tokens[node], node + 1)
        }
        else {
            if selector == 0 { fail(&mut c, "internal missing evaluated index"); return }
            writable := c.body.place.writable; packed := c.body.place.inline_storage && ft.type_kind(&c.types, receiver) == 6
            arm.mov(&mut c.code, 1, 0); bound_place(&mut c, .Temporary, node + 1, i32(place_op.Temporary.LoadIndex), c.body.places.tokens[node])
            element := load_index(&mut c, receiver, packed, writable, need, c.body.places.tokens[node], node + 1)
        }
    }
}
fn method_impl(c: &mut Session, f: i32, ty: i32, place: i32, materialized: i32, pending: bool,
    receiver_at: i32, temporary_root: i32, projection_address: i32,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    expect(&mut c, "(")
    call_token := c.body.cursor - 1
    method_tok := call_token - 1
    mut recv_tok := receiver_at; if recv_tok < 0 { recv_tok = method_tok }
    if !check_impl_access(&mut c, f, method_tok) { return 0 }
    if c.world.unsafe_functions[f] && !c.body.unsafe_scope { fail(&mut c, "call requires unsafe"); return 0 }
    if !c.world.impl_has_self[f] {
        fail(&mut c, "associated function '" + c.world.impl_names[f] + "' has no self parameter; call it as '" + type_spelling(&c, ty) + "::" + c.world.impl_names[f] + "'")
        c.error_at = c.world.tokens.starts[method_tok]
        return 0
    }
    signature := c.world.ffi_types[f]
    want := ft.parameter_type(&c.types, ft.type_start(&c.types, signature))
    want_kind := ft.type_kind(&c.types, want)
    first_writeback := c.body.scratch_returns.len
    mut args: []i32 = []; mut arg_starts: []i32 = []; mut arg_places: []i32 = []; mut arg_sources: []i32 = []; mut effects: []i32 = []
    effects.push(c.body.mutations.len)
    arg_starts.push(recv_tok); arg_places.push(place); arg_sources.push(recv_tok)
    if want_kind == 4 {
        if place != 0 {
            lower_place(&mut c, place, 0, .ValueAndAddress, recv_tok)
            borrow_address(&mut c, ty, false, recv_tok, place)
        } else if ft.is_c_record(&c.types, ty) || fixed_pod(&c, ty) {
            borrow_address(&mut c, ty, false, recv_tok, 0)
        } else {
            home := slot(&mut c); arm.store(&mut c.code, home, 0); place_step(&mut c, .BorrowHome, ty, 3, 0, home, recv_tok)
        }
        if c.loans.active {
            origin := loan_origin(&c, place)
            binding := borrows.root(&c.body.places, place)
            constrained := local_borrows.shared(&c.body.local_loans, binding) ||
                (ft.return_borrow_parameter(&c.types, signature) == 0 && source_root(&c, place) < 0)
            forward_argument_loan(&mut c, origin, constrained, f, signature, 0, c.world.tokens.starts[recv_tok])
        }
    } else if want_kind == 5 {
        if place == 0 { fail(&mut c, "mutable method requires a stored variable, field or array element"); c.error_at = c.world.tokens.starts[method_tok]; return 0 }
        lower_place(&mut c, place, 0, .ValueAndAddress, recv_tok)
        base := borrows.root(&c.body.places, place)
        if base < 0 { fail(&mut c, "mutable method requires a stored variable, field or array element"); c.error_at = c.world.tokens.starts[method_tok]; return 0 }
        if is_for_locked(&c, base) { fail(&mut c, "cannot mutate a collection while iterating over it"); c.error_at = c.world.tokens.starts[method_tok]; return 0 }
        if c.body.place.address < 0 { fail(&mut c, "borrow requires a stored value"); c.error_at = c.world.tokens.starts[method_tok]; return 0 }
        if !c.body.place.writable { fail(&mut c, "mutable method requires mut or &mut"); c.error_at = c.world.tokens.starts[method_tok]; return 0 }
        if !writable_loan(&mut c, place) { return 0 }
        if !ownership.available(&c.body.ownership, owner_path(&c, place)) { fail(&mut c, "cannot borrow a moved value"); c.error_at = c.world.tokens.starts[method_tok]; return 0 }
        c.body.mutations.push(base)
        borrow_address(&mut c, ty, true, recv_tok, place)
        if c.loans.active {
            origin := loan_origin(&c, place)
            forward_argument_loan(&mut c, origin, false, f, signature, 0, c.world.tokens.starts[recv_tok])
            if origin == -2 && c.body.place.scratch == 1 && ft.type_kind(&c.types, ty) == 2 && !ft.is_c_record(&c.types, ty) {
                place_step(&mut c, .Read, ty, 4, 3, 0, recv_tok)
                destination := slot(&mut c); arm.store(&mut c.code, destination, 0)
                copy_value(&mut c, ty)
                owner := slot(&mut c); save_owner(&mut c, owner, ty, true)
                c.body.scratch_returns.push(destination); c.body.scratch_returns.push(owner)
                c.body.scratch_returns.push(ty); c.body.scratch_returns.push(recv_tok)
                place_step(&mut c, .BorrowHome, ty, 4, 0, owner, recv_tok)
            }
        }
    } else {
        if pending && !(ft.move_only(&c.types, ty) && place > 0) {
            lower_place(&mut c, place, materialized, .Value, recv_tok)
        }
        c.body.places.current = place; c.body.places.source = recv_tok
        c.body.expr.move_projection = projection_address; c.body.expr.move_temporary = temporary_root
        if place == 0 && projection_address < 0 && temporary_root >= 0 {
            fc.produce_owner(&mut c.body.expr, temporary_root, ty)
        }
        take_value(&mut c, ty)
    }
    if !c.ok { return 0 }
    recv_slot := slot(&mut c); arm.store(&mut c.code, recv_slot, 0)
    args.push(recv_slot)
    c.body.facts.needed.push(f)
    fc.clear_rvalue_place(&mut c.body.place)
    invoke_with_args(&mut c, signature, -1, f, -1, &args, &arg_starts, &arg_places, &arg_sources, &effects, first_writeback, call_token, &catalog, &mut inline_work, &mut model)
}
fn method(c: &mut Session, ty: i32, name: string, place: i32, receiver_at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    mut covered := false
    result := method_dispatch(&mut c, ty, name, place, receiver_at, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
fn replace_value(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    token := c.body.cursor
    expect(&mut c, "&"); expect(&mut c, "mut")
    previous_address := c.body.place.taking_address; c.body.place.taking_address = true
    ty := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
    c.body.place.taking_address = previous_address
    if !c.ok { return 0 }
    place := c.body.places.current; root := borrows.root(&c.body.places, place)
    if root < 0 || c.body.place.address < 0 { fail(&mut c, "replace requires a named variable, field or array element"); return 0 }
    if !c.body.place.writable { fail(&mut c, "replace requires mutable storage"); return 0 }
    if !writable_loan(&mut c, place) { return 0 }
    if is_for_locked(&c, root) { fail(&mut c, "cannot replace a collection while iterating over it"); return 0 }
    if c.body.place.scratch != 0 || ft.type_kind(&c.types, ty) == 20 || ft.type_kind(&c.types, ty) == 21 {
        fail(&mut c, "replace does not support region-backed storage"); return 0
    }
    direct := c.body.place.direct; packed := c.body.place.inline_storage
    inline := packed && (ft.is_c_record(&c.types, ty) || ft.type_kind(&c.types, ty) == 6)
    destination := slot(&mut c); place_address(&mut c, place, direct, token); arm.store(&mut c.code, destination, 0)
    expect(&mut c, ",")
    effects := c.body.mutations.len
    consuming := eat(&mut c, "move")
    actual := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, actual)
    if ft.move_only(&c.types, ty) && c.body.expr.owner < 0 && !consuming {
        fail(&mut c, "replace requires 'move value', .clone(), or a fresh owned expression"); return 0
    }
    if inline { take_inline(&mut c, ty) } else { take_value(&mut c, ty) }
    expect(&mut c, ")")
    if !c.ok { return 0 }
    if borrows.changed(&c.body.mutations, effects, c.body.mutations.len, root) {
        fail(&mut c, "cannot mutate or move a value while it is borrowed by replace"); return 0
    }
    replacement := slot(&mut c); arm.store(&mut c.code, replacement, 0)
    previous := slot(&mut c)
    arm.load(&mut c.code, destination)
    if inline {
        inline_value(&mut c, ty, .Value, token); copy_value(&mut c, ty)
    } else { place_transfer(&mut c, ty, 0, 0, true, packed, i32(borrows.Access.Value), token) }
    arm.store(&mut c.code, previous, 0)
    arm.load(&mut c.code, replacement); arm.push_temp(&mut c.code, 0)
    arm.load(&mut c.code, destination); arm.mov(&mut c.code, 1, 0); arm.pop_temp(&mut c.code, 0)
    if inline { store_inline(&mut c, ty, token) }
    else { place_transfer(&mut c, ty, 0, 1, false, packed, i32(borrows.Access.Address), token) }
    c.body.mutations.push(root)
    arm.load(&mut c.code, previous)
    c.body.places.current = 0; c.body.places.source = -1
    fc.clear_expr_value(&mut c.body.expr)
    fc.clear_rvalue_place(&mut c.body.place)
    ty
}
fn integer_method(c: &mut Session, ty: i32, name: string, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    op := integers.method(name)
    covered = op != .Unknown
    if op == .Not {
        expect(&mut c, ")"); integers.complement(&mut c.code, ty); return ty
    }
    mut want := ty; if integers.is_shift(op) { want = 1 }
    if covered && c.body.depth < 128 && c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.kinds[c.body.cursor] == .Integer &&
        c.world.tokens.kinds[c.body.cursor + 1] == .Symbol && c.world.tokens.texts[c.body.cursor + 1] == ")" {
        spelling := advance(&mut c)
        value := integer_literal(&mut c, spelling, want)
        expect(&mut c, ")"); integers.immediate(&mut c.code, op, ty, value, c.bounds); return ty
    }
    arm.push_temp(&mut c.code, 0)
    right := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, right)
    expect(&mut c, ")"); arm.pop_temp(&mut c.code, 1)
    if !covered { fail(&mut c, "unknown integer method '" + name + "'"); return ty }
    integers.dynamic(&mut c.code, op, ty, c.bounds); ty
}
fn swap_address(c: &mut Session, ty: i32, place: i32, packed: bool, values: i32, index: i32, token: i32) -> i32 {
    arm.load_into(&mut c.code, values, 1); arm.load(&mut c.code, index)
    element := index_place(&mut c, place, ty, packed, index, token)
    ignored := load_index(&mut c, ty, packed, true, .Address, token, element)
    c.body.place.address
}
fn swap_array(c: &mut Session, ty: i32, place: i32, receiver_at: i32, writable: bool,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    root := borrows.root(&c.body.places, place)
    if root < 0 { fail(&mut c, "swap requires a stored array"); return 0 }
    if !writable { fail(&mut c, "swap requires mut or &mut"); return 0 }
    if !writable_loan(&mut c, place) { return 0 }
    if is_for_locked(&c, root) { fail(&mut c, "cannot mutate a collection while iterating over it"); return 0 }
    c.body.mutations.push(root)
    effects := c.body.mutations.len
    packed := c.body.place.inline_storage && ft.type_kind(&c.types, ty) == 6
    values := slot(&mut c); arm.store(&mut c.code, values, 0)
    first_at := c.body.cursor; first := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, first)
    first_slot := slot(&mut c); arm.store(&mut c.code, first_slot, 0); expect(&mut c, ",")
    second_at := c.body.cursor; second := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, second)
    second_slot := slot(&mut c); arm.store(&mut c.code, second_slot, 0); expect(&mut c, ")")
    if borrows.changed(&c.body.mutations, effects, c.body.mutations.len, root) {
        lower_place(&mut c, place, 0, .Value, receiver_at); arm.store(&mut c.code, values, 0)
    }
    left := swap_address(&mut c, ty, place, packed, values, first_slot, first_at)
    right := swap_address(&mut c, ty, place, packed, values, second_slot, second_at)
    base := ft.type_base(&c.types, ty)
    arm.load(&mut c.code, left); place_transfer(&mut c, base, 0, 0, true, packed, 0, first_at)
    saved := slot(&mut c); arm.store(&mut c.code, saved, 0)
    arm.load(&mut c.code, right); place_transfer(&mut c, base, 1, 0, true, packed, 0, second_at)
    arm.load(&mut c.code, left); place_transfer(&mut c, base, 1, 0, false, packed, 1, first_at)
    arm.load_into(&mut c.code, saved, 1); arm.load(&mut c.code, right); place_transfer(&mut c, base, 1, 0, false, packed, 1, second_at)
    0
}
fn method_dispatch(c: &mut Session, ty: i32, name: string, place: i32, receiver_at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    mut effects := c.body.mutations.len
    source := c.world.tokens.starts[c.body.cursor - 1]
    writable := c.body.place.writable; expect(&mut c, "(")
    if name == "__dunder_module_format_integer" {
        covered = true
        spec_at := c.body.cursor
        if c.world.tokens.kinds[spec_at] != .String { fail(&mut c, "expected integer interpolation format"); return 0 }
        spec := lexer.integer_format(advance(&mut c))
        expect(&mut c, ")")
        value := read_scalar_result(&mut c, ty, spec_at)
        if !spec.valid || (value != 1 && value != 2 && !unsigned.has(value)) {
            fail(&mut c, "integer interpolation format requires an integer")
            c.error_at = source
            return 0
        }
        arm.imm(&mut c.code, 1, i64(spec.width)); arm.imm(&mut c.code, 3, i64(spec.radix))
        arm.imm(&mut c.code, 4, i64(spec.letter_offset)); arm.imm(&mut c.code, 5, i64(spec.padding))
        arm.intrinsic_call(&mut c.code, c.runtime.string_formatted_integer, .FormatInteger, value, 4, source)
        return 4
    }
    if name == "clone" {
        covered = true; expect(&mut c, ")")
        if ft.type_kind(&c.types, ty) == 20 || ft.type_kind(&c.types, ty) == 21 { fail(&mut c, "scratch values cannot be cloned out of their region"); return 0 }
        if !ft.cloneable(&c.types, ty) { fail(&mut c, "resource values cannot be cloned"); return 0 }
        copy_value(&mut c, ty); return ty
    }
    if ty == 4 && name == "str" {
        covered = true; expect(&mut c, ")")
        copy_value(&mut c, ty); return 4
    }
    if floats.has(ty) {
        expect(&mut c, ")")
        if name == "str" { covered = true; format_float(&mut c, ty, source); return 4 }
        if name == "negate" { fail(&mut c, "unknown float method"); return ty }
        if name == "to_bits" || name == "is_sign_negative" || name == "abs" || name == "sqrt" || name == "floor" || name == "ceil" || name == "round" || name == "round_ties_even" || name == "trunc" || name == "is_nan" || name == "is_finite" || name == "is_infinite" { covered = true }
        actual := floats.method(&mut c.code, ty, name, c.world.tokens.starts[c.body.cursor - 3])
        if actual < 0 { fail(&mut c, "unknown float method"); return ty }
        return actual
    }
    if name == "len" { covered = true; expect(&mut c, ")"); return length_value(&mut c, ty, c.body.cursor - 3) }
    if name == "cap" && ft.type_kind(&c.types, ty) == 1 { covered = true; expect(&mut c, ")"); place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Capacity), 2, c.body.cursor - 3); return 1 }
    if name == "swap" && (ft.type_kind(&c.types, ty) == 1 || ft.type_kind(&c.types, ty) == 6) {
        covered = true; return swap_array(&mut c, ty, place, receiver_at, writable, &catalog, &mut inline_work, &mut model)
    }
    if ty == 4 && c.body.depth == c.body.stream_depth && (name == "bytes" || name == "runes") && is(&c, ")") && c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.kinds[c.body.cursor + 1] == .Symbol && c.world.tokens.texts[c.body.cursor + 1] == "{" {
        covered = true
        expect(&mut c, ")"); copy_value(&mut c, 4)
        c.body.stream_kind = 1; if name == "runes" { covered = true; c.body.stream_kind = 5 }
        return 4
    }
    if name != "str" && (ty == 1 || ty == 2 || unsigned.has(ty)) { return integer_method(&mut c, ty, name, &catalog, &mut inline_work, &mut model, &mut covered) }
    if ty == 4 { copy_value(&mut c, ty); saved_text := temporary(&mut c, ty) }
    arm.push_temp(&mut c.code, 0)
    mut target := -1; mut ret := ty; mut count := 0; mut operation: ri.Operation = .Format
    if name == "iter" && collection(&c, ty) { covered = true;
        if place != 0 && c.body.depth == c.body.stream_depth && is(&c, ")") && c.world.tokens.texts[c.body.cursor + 1] == "{" {
            expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0); c.body.stream_kind = 10; return ty
        }
        if place != 0 { fail(&mut c, "stored iterators require (move values).iter() or values.clone().iter()"); return 0 }
        expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0)
        c.body.places.current = place; c.body.places.source = receiver_at
        if c.body.expr.move_projection < 0 && c.body.expr.move_temporary >= 0 { fc.produce_owner(&mut c.body.expr, c.body.expr.move_temporary, ty) }
        take_value(&mut c, ty)
        return compound(&mut c, 10, ft.type_base(&c.types, ty))
    }
    if ft.type_kind(&c.types, ty) == 1 {
        may_invalidate_operand(&mut c)
        receiver := borrows.root(&c.body.places, place)
        if receiver < 0 { fail(&mut c, "array mutation requires a stored place"); return 0 }
        if !writable_loan(&mut c, place) { return 0 }
        if is_for_locked(&c, receiver) { fail(&mut c, "cannot mutate a collection while iterating over it"); return 0 }
        c.body.mutations.push(receiver); effects = c.body.mutations.len
        if !writable { fail(&mut c, "array mutation requires mut or &mut") }
        if name == "push" { covered = true;
            if !writable { fail(&mut c, "push requires mutable array") }
            base := ft.type_base(&c.types, ty)
            consuming := eat(&mut c, "move")
            value := expression(&mut c, 0, base, &catalog, &mut inline_work, &mut model); same(&mut c, base, value)
            if ft.move_only(&c.types, base) && c.body.expr.owner < 0 && !consuming { fail(&mut c, "push requires 'move value', .clone(), or a fresh owned expression"); return 0 }
            take_value(&mut c, value)
            operation = .ArrayPush; target = c.runtime.typed_push[unsigned.shift(storage_type(&c, base))]; count = 1; ret = 0
        } else if name == "reserve" { covered = true; value := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, value); count = 1; operation = .ArrayReserve; target = c.runtime.array_reserve; ret = 0 }
        else if name == "pop" { covered = true; operation = .ArrayPop; target = c.runtime.array_pop; ret = ft.type_base(&c.types, ty) }
        else if name == "remove" {
            covered = true
            index := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, index)
            count = 1; operation = .ArrayRemove; target = c.runtime.array_remove; ret = ft.type_base(&c.types, ty)
        }
        else if name == "clear" { covered = true; expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0); arm.intrinsic_call(&mut c.code, c.runtime.array_clear, .ArrayClear, ty, 0, source); return 0 }
    } else if name == "str" { covered = true;
        if ty != 1 && ty != 2 && ty != 3 && ty != 5 && !unsigned.has(ty) { fail(&mut c, "str requires an integer, bool or rune") }
        ret = 4; target = c.runtime.string_integer
        if ty == 3 { target = c.runtime.string_bool }; if ty == 5 { target = c.runtime.string_rune }
    } else if ty == 4 {
        if name == "bytes" { covered = true; operation = .Bytes; target = c.runtime.string_bytes; ret = compound(&mut c, 1, 1) }
        else if name == "runes" { covered = true; operation = .Runes; target = c.runtime.string_runes; ret = compound(&mut c, 1, 5) }
        else if name == "slice" { covered = true;
            first := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, first); arm.push_temp(&mut c.code, 0); expect(&mut c, ",")
            last := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, last); arm.mov(&mut c.code, 2, 0); arm.pop_temp(&mut c.code, 1); arm.pop_temp(&mut c.code, 0)
            expect(&mut c, ")"); arm.intrinsic_call(&mut c.code, c.runtime.string_slice, .Slice, ty, 4, source); return 4
        }
    }
    if target < 0 { fail(&mut c, "unknown method '" + name + "'"); return 0 }
    expect(&mut c, ")")
    if count == 1 { arm.mov(&mut c.code, 1, 0) }; arm.pop_temp(&mut c.code, 0)
    if count == 1 && ri.mutates_receiver(operation) {
        root := borrows.root(&c.body.places, place)
        if borrows.changed(&c.body.mutations, effects, c.body.mutations.len, root) {
            arm.push_temp(&mut c.code, 1); lower_place(&mut c, place, 0, .Value, receiver_at); arm.pop_temp(&mut c.code, 1)
        }
    }
    arm.intrinsic_call(&mut c.code, target, operation, ty, ret, source)
    if (operation == .ArrayPop || operation == .ArrayRemove) && storage_type(&c, ret) == 1 { arm.sign_extend_i32(&mut c.code, 0, 0) }
    ret
}
fn comparison_value(c: &mut Session, operator: string) {
    condition := integers.relation(rules.opcode(operator))
    arm.set_condition(&mut c.code, 0, condition)
}
fn binary(c: &mut Session, operator: string, ty: i32, token: i32) -> i32 {
    fc.clear_loan_eval(&mut c.body.loan)
    if ty == 13 && (operator == "==" || operator == "!=") { return unsigned.binary(&mut c.code, operator, 12, c.overflow, c.zero) }
    if floats.has(ty) {
        if operator == "%" { fail(&mut c, "remainder requires integers"); return ty }
        return floats.binary(&mut c.code, operator, ty, c.world.tokens.starts[token])
    }
    if unsigned.has(ty) { return unsigned.binary(&mut c.code, operator, ty, c.overflow, c.zero) }
    if ty == 4 {
        arm.mov(&mut c.code, 2, 0); arm.mov(&mut c.code, 0, 1); arm.mov(&mut c.code, 1, 2)
        if operator == "+" { arm.intrinsic_call(&mut c.code, c.runtime.string_concat, .Concat, 4, 4, c.world.tokens.starts[token]); return 4 }
        arm.intrinsic_call(&mut c.code, c.runtime.string_compare, .Compare, 4, 1, c.world.tokens.starts[token]); arm.mov(&mut c.code, 1, 0); arm.imm(&mut c.code, 0, 0)
    }
    opcode := rules.opcode(operator); numeric := ty == 1 || ty == 2 || ty == 5
    if opcode <= 5 {
        if !numeric { fail(&mut c, "arithmetic requires matching integer types"); return ty }
    } else if !numeric && !((ty == 3 || ft.type_kind(&c.types, ty) == 3) && (opcode == 6 || opcode == 7)) && ty != 4 {
        fail(&mut c, "comparison requires integers or bool equality")
    }
    if c.code.prefixing { arm.pending_operator(&mut c.code, opcode, ty, token) }
    else if c.ok && !c.code.checking { integers.signed_binary(&mut c.code, opcode, ty, c.overflow, c.zero) }
    if opcode <= 5 { ty } else { 3 }
}
fn float_context(c: &Session, expected: i32) -> i32 {
    if !c.float_source || expected == 1 || expected == 2 || unsigned.has(expected) || floats.has(expected) { return expected }
    mut pos := c.body.cursor
    while pos < c.world.tokens.kinds.len && (c.world.tokens.kinds[pos] == .Name || c.world.tokens.kinds[pos] == .Keyword) && c.world.tokens.texts[pos] == "move" { pos = pos + 1 }
    if pos >= c.world.tokens.kinds.len { return expected }
    first := c.world.tokens.kinds[pos]; first_word := c.world.tokens.texts[pos].clone()
    if first != .Integer && first != .Float && first_word != "(" && first_word != "-" { return expected }
    mut depth := 0
    mut decimal_seen := false
    mut literal_seen := false
    while pos < c.world.tokens.kinds.len {
        kind := c.world.tokens.kinds[pos]; word := c.world.tokens.texts[pos].clone()
        if kind == .Float { decimal_seen = true; literal_seen = true }
        else if kind == .Integer { literal_seen = true }
        else if (kind == .Name || kind == .Keyword) && word == "move" { }
        else if kind == .Name {
            index := local(&c.body, word)
            if index >= 0 {
                mut ty := c.body.locals.types[index]
                shape := ft.type_kind(&c.types, ty)
                if shape == 4 || shape == 5 { ty = ft.type_base(&c.types, ty) }
                if floats.has(ty) { return ty }
                break
            }
            if word == "f32" { return 6 }
            if word == "f64" { return 7 }
            mut called := -1
            if pos + 2 < c.world.tokens.kinds.len && c.world.tokens.kinds[pos + 1] == .Symbol && c.world.tokens.texts[pos + 1] == "::" {
                ty := resolve_type_name(&c, word)
                called = impl_method(&c, ty, c.world.tokens.texts[pos + 2])
            } else { called = i32(map.get_or(&c.world.functions, word, -1)) }
            if called >= 0 {
                mut result := c.world.returns[called]
                if literal_seen && ft.type_kind(&c.types, result) == 4 { result = ft.type_base(&c.types, result) }
                if floats.has(result) { return result }
            }
            break
        } else if word == "(" { depth = depth + 1 }
        else if word == ")" {
            if depth == 0 { break }; depth = depth - 1
        } else if word == "." {
            if pos + 3 >= c.world.tokens.kinds.len || c.world.tokens.texts[pos + 2] != "(" || c.world.tokens.texts[pos + 3] != ")" { break }
            name := c.world.tokens.texts[pos + 1].clone()
            if name == "str" || name == "to_bits" || name == "is_nan" || name == "is_finite" || name == "is_infinite" || name == "is_sign_negative" { break }
            pos = pos + 3
        } else if word != "+" && word != "-" && word != "*" && word != "/" { break }
        pos = pos + 1
    }
    if decimal_seen { return 7 }
    expected
}
fn register_rhs(c: &Session, priority: i32) -> bool {
    mut last := c.body.cursor
    kind := c.world.tokens.kinds[last]
    if kind == .Name {
        found := local(&c.body, c.world.tokens.texts[last])
        if found < 0 { return false }
        ty := c.body.locals.types[found]
        if !scalar_element(&c, ty) || ty == 4 { return false }
    } else if kind != .Integer && kind != .Float && kind != .Rune && kind != .Byte {
        if !is(&c, "true") && !is(&c, "false") { return false }
    }
    rhs_ends_at(&c, last + 1, priority)
}
fn rhs_ends_at(c: &Session, next_at: i32, priority: i32) -> bool {
    if next_at >= c.world.tokens.kinds.len { return false }
    next := c.world.tokens.texts[next_at].clone()
    if next == "." || next == "[" || next == "(" || next == "?" { return false }
    rules.precedence(next) <= priority
}
fn signed_immediate_rhs(c: &mut Session, ty: i32, priority: i32, operator: string) -> bool {
    if (ty != 1 && ty != 2 && ty != 5) || priority < 3 || priority > 5 || c.body.depth > 126 { return false }
    mut at := c.body.cursor
    mut negative := false
    if ty == 5 {
        if c.world.tokens.kinds[at] != .Rune { return false }
    } else if c.world.tokens.kinds[at] != .Integer {
        if !is(&c, "-") { return false }
        negative = true; at = at + 1
        if at >= c.world.tokens.kinds.len || c.world.tokens.kinds[at] != .Integer { return false }
    }
    if !rhs_ends_at(&c, at + 1, priority) { return false }
    mut magnitude: i64 = 0
    if ty == 5 { magnitude = i64(i32(c.world.tokens.texts[at].runes()[0])) }
    else {
        n := rules.literal_integer(c.world.tokens.texts[at])
        if !n.ok || n.value < 0 { return false }
        magnitude = n.value
    }
    field := arm.add_sub_field(magnitude)
    if field < 0 { return false }
    c.body.cursor = at + 1
    if priority == 5 {
        if field != 0 {
            integers.signed_add_sub(&mut c.code, ty, (operator == "-") != negative, true, c.overflow, 0, 0, -1, magnitude)
        }
    } else {
        arm.compare_immediate(&mut c.code, 0, magnitude, negative && magnitude != 0)
        comparison_value(&mut c, operator)
    }
    fc.clear_rvalue_place(&mut c.body.place); c.body.place.scratch = 0
    fc.clear_expr_value(&mut c.body.expr)
    fc.clear_loan_eval(&mut c.body.loan)
    true
}
fn expression(c: &mut Session, minimum: i32, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "expression nesting exceeds 128"); c.body.depth = c.body.depth - 1; return 0 }
    first_token := c.body.cursor; context := float_context(&c, expected)
    mut ty := primary(&mut c, context, &catalog, &mut inline_work, &mut model)
    if ft.type_kind(&c.types, ty) == 4 {
        mut operand := minimum > 1
        if c.world.tokens.kinds[c.body.cursor] == .Symbol {
            priority := rules.priority(rules.opcode(c.world.tokens.texts[c.body.cursor]))
            operand = operand || (priority > 0 && priority >= minimum) || (minimum == 0 && is(&c, ".."))
        }
        if operand || (!c.body.place.taking_address && expected == ft.type_base(&c.types, ty)) {
            ty = read_scalar_result(&mut c, ty, first_token)
        }
    }
    mut place := c.body.places.current; at := c.body.places.source
    while c.ok && c.world.tokens.kinds[c.body.cursor] == .Symbol {
        op_at := c.body.cursor; opcode := rules.opcode(c.world.tokens.texts[op_at])
        priority := rules.priority(opcode)
        if priority == 0 || priority < minimum { break }
        operator := c.world.tokens.texts[op_at].clone(); left_node := model.value
        place = 0; skip_token(&mut c); newlines(&mut c)
        observe := c.body.assert_operands.first == first_token && minimum == 0 && opcode >= 6 && opcode <= 11
        if !observe && !model.recording && signed_immediate_rhs(&mut c, ty, priority, operator) {
            if priority != 5 { ty = 3 }
            continue
        }
        if opcode == 12 || opcode == 13 {
            same(&mut c, 3, ty)
            done := new_block(&mut c)
            if operator == "&&" { source_edge(&mut c, done, .WhenFalse, op_at) } else { source_edge(&mut c, done, .WhenTrue, op_at) }
            fallthrough := new_block(&mut c); bind_block(&mut c, fallthrough)
            skipped := ownership.snapshot(&c.body.ownership)
            right := expression(&mut c, priority + 1, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, right)
            evaluated := ownership.snapshot(&c.body.ownership); ownership.join(&mut c.body.ownership, &skipped, &evaluated)
            bind_block(&mut c, done); ty = 3; fc.clear_rvalue_place(&mut c.body.place)
        } else {
            if ty == 4 {
                borrowed := c.body.expr.owner < 0 || c.body.expr.ty != ty
                observe := borrowed && c.ownership_enabled && !c.code.checking && !c.validating_dead
                rhs := c.code.words.len; first_reloc := c.code.at.len; first_label := c.code.labels.len; first_import := c.body.facts.sites.len
                mut owner := -1; mut index := -1
                previous := c.body.observing_lease; generation := c.body.lease_generation
                if observe {
                    index = slot(&mut c); owner = c.body.owned_slots.len
                    remember_owner(&mut c, index, 4, true)
                    c.body.observing_lease = true
                } else if borrowed {
                    copy_value(&mut c, ty); saved_left := temporary(&mut c, ty)
                }
                arm.push_temp(&mut c.code, 0)
                right := expression(&mut c, priority + 1, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, right)
                if observe {
                    c.body.observing_lease = previous
                    if c.body.lease_generation == generation {
                        if owner == c.body.owned_slots.len - 1 {
                            unused_slot := c.body.owned_slots.pop(); unused_ty := c.body.owned_types.pop(); unused_temp := c.body.owner_temps.pop()
                        } else { c.body.owned_slots[owner] = -1 }
                    }
                    else if c.ok {
                        setup := c.code.words.len; reloc := c.code.at.len
                        source := c.world.tokens.starts[op_at]
                        arm.ownership_call(&mut c.code, c.runtime.retain, .Copy, ty, source)
                        install_owner(&mut c, index, ty, source)
                        width := lease.insert(&mut c.code, rhs, setup, first_label, first_reloc, reloc)
                        for i in first_import..c.body.facts.sites.len { c.body.facts.sites[i] = c.body.facts.sites[i] + width * 4 }
                    }
                }
                arm.pop_temp(&mut c.code, 1)
            } else {
                mut spilled := false; mut pending_save := -1
                if c.code.prefixing {
                    pending_save = c.code.prefix.len; spilled = true
                    arm.push_temp(&mut c.code, 0)
                } else if !c.code.checking {
                    spilled = !register_rhs(&c, priority)
                    if spilled { arm.push_temp(&mut c.code, 0) } else { arm.mov(&mut c.code, 1, 0) }
                }
                right := expression(&mut c, priority + 1, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, right)
                if pending_save >= 0 && c.code.prefixing && model.recording && model.value >= 0 {
                    kind := model.nodes.kinds[model.value]
                    if kind == 1 || kind == 2 {
                        arm.replace_temp_push(&mut c.code, pending_save, 1, 0); spilled = false
                    }
                }
                if spilled { arm.pop_temp(&mut c.code, 1) }
            }
            if observe && c.ok && assert_end(&c, c.body.assert_operands.closing_paren, c.body.cursor) {
                capture_assert_operands(&mut c, ty)
            }
            result := binary(&mut c, operator, ty, op_at); ty = temporary(&mut c, result); fc.clear_rvalue_place(&mut c.body.place)
        }
        if model.recording {
            if left_node < 0 || model.value < 0 { model.recording = false }
            else { _ := typed.node(&mut model, 3, ty, left_node, model.value, -1, i64(opcode), -1, op_at) }
        }
    }
    if minimum == 0 && c.world.tokens.kinds[c.body.cursor] == .Symbol && eat(&mut c, "..") {
        range_source := c.world.tokens.starts[c.body.cursor - 1]; model.recording = false
        place = 0; same(&mut c, 1, ty); arm.push_temp(&mut c.code, 0)
        high := expression(&mut c, 1, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, high); arm.pop_temp(&mut c.code, 1)
        iteration.emit(&mut c.code, .PackRange, .Range, 1, range_source)
        ty = 14; fc.clear_rvalue_place(&mut c.body.place)
    }
    if model.probing && ty > 3 && !is(&c, ")") && owned(&c, ty) {
        declined := decline_projection(&mut c, &mut model)
    }
    c.body.places.current = place; c.body.places.source = at
    c.body.depth = c.body.depth - 1
    ty
}
fn place_access(c: &Session) -> borrows.Access {
    if c.body.place.taking_address { return .ValueAndAddress }
    mut at := c.body.cursor
    while at < c.world.tokens.kinds.len && c.world.tokens.kinds[at] == .Symbol && c.world.tokens.texts[at] == ")" { at = at + 1 }
    if at >= c.world.tokens.kinds.len || c.world.tokens.kinds[at] != .Symbol { return .Value }
    next := c.world.tokens.texts[at].clone()
    if next == "=" { return .Address }
    if next.len == 2 && fc.assign_operator(next) != "" { return .ValueAndAddress }
    .Value
}
fn is_for_locked(c: &Session, base: i32) -> bool {
    for i in 0..c.body.for_locks.len { if c.body.for_locks[i] == base { return true } }
    false
}
fn move_loop_begin(c: &mut Session) {
    ownership.loop_begin(&mut c.body.ownership)
}
fn move_loop_backedge(c: &mut Session) {
    path := ownership.loop_backedge(&mut c.body.ownership)
    if path >= 0 {
        root := ownership.local_root(&c.body.ownership, path)
        fail(&mut c, "moved value '" + c.body.locals.names[root] + "' must be reinitialized before the next loop iteration")
    }
}
fn move_loop_break(c: &mut Session) {
    ownership.loop_break(&mut c.body.ownership)
}
fn move_loop_end(c: &mut Session, exit: &ownership.State) {
    ownership.loop_end(&mut c.body.ownership, &exit)
}
fn begin_loop_scope(c: &mut Session, head: i32, end: i32) {
    c.body.loop_heads.push(head); c.body.loop_ends.push(end)
    c.body.loop_owners.push(c.body.owned_slots.len); c.body.loop_defers.push(c.body.defers.bodies.len)
    c.body.loop_operands.push(c.code.operand_depth); c.body.loop_pending.push(c.body.pending.slots.len)
    if c.tasks.program { c.body.loop_task_locals.push(c.body.locals.active.len) }
}
fn end_loop_scope(c: &mut Session) {
    _ := c.body.loop_heads.pop(); _ := c.body.loop_ends.pop()
    _ := c.body.loop_owners.pop(); _ := c.body.loop_defers.pop()
    _ := c.body.loop_operands.pop(); _ := c.body.loop_pending.pop()
    if c.tasks.program { _ := c.body.loop_task_locals.pop() }
}
fn unwind_exit(c: &mut Session, floor: i32, target_depth: i32) {
    if !c.ok || c.code.checking { return }
    mut cleaned_to := c.body.owned_slots.len
    mut depth := c.code.operand_depth
    mut d := c.body.defers.bodies.len - 1
    while d >= floor {
        limit := c.body.defers.owner_limits[d]
        mut i := cleaned_to - 1
        while i >= limit {
            if c.body.owned_slots[i] >= 0 { clear_owner(&mut c, c.body.owned_slots[i], c.body.owned_types[i]) }
            i = i - 1
        }
        cleaned_to = limit
        arm.discard_operands(&mut c.code, depth, c.body.defers.operand_depths[d])
        depth = c.body.defers.operand_depths[d]
        if c.body.defers.selector < 0 { c.body.defers.selector = slot(&mut c) }
        if c.body.defers.entries[d] < 0 { entry := new_block(&mut c); c.body.defers.entries[d] = entry }
        resume := new_block(&mut c)
        edge := deferred.add_exit(&mut c.body.defers, d, resume)
        arm.imm(&mut c.code, 0, i64(edge) + 1); arm.store(&mut c.code, c.body.defers.selector, 0)
        source_edge(&mut c, c.body.defers.entries[d], .Defer, c.body.defers.bodies[d]); bind_block(&mut c, resume)
        d = d - 1
    }
    arm.discard_operands(&mut c.code, depth, target_depth)
}
fn return_from_body(c: &mut Session, at: i32) {
    if c.body.view_result_destination >= 0 { borrowed_view.return_to(&mut c.code, c.body.view_result_destination) }
    preserve := !c.code.checking && (c.body.defers.bodies.len > 0 || c.body.pending.slots.len > 0)
    if preserve && c.body.ret_type != 0 {
        if c.body.defers.return_slot < 0 { c.body.defers.return_slot = slot(&mut c) }
        arm.store(&mut c.code, c.body.defers.return_slot, 0)
    }
    unwind_exit(&mut c, 0, 0)
    if preserve {
        cleanup_pending(&mut c, 0)
        if c.body.ret_type != 0 { arm.load(&mut c.code, c.body.defers.return_slot) }
        else { arm.imm(&mut c.code, 0, 0) }
    }
    source_edge(&mut c, c.body.cleanup, .Return, at)
    ownership.terminate(&mut c.body.ownership)
}
fn resume_defer_exit(c: &mut Session, head: i32) {
    if head < 0 { return }
    arm.load(&mut c.code, c.body.defers.selector)
    mut edge := head
    while c.body.defers.previous[edge] >= 0 {
        arm.imm(&mut c.code, 2, i64(edge) + 1)
        arm.compare_register(&mut c.code, 0, 2)
        source_edge(&mut c, c.body.defers.targets[edge], .Resume, c.body.cursor)
        edge = c.body.defers.previous[edge]
    }
    source_edge(&mut c, c.body.defers.targets[edge], .WhenTrue, c.body.cursor)
}
fn block(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    enter(&mut c)
    block_body(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
}
fn scoped_body(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    end := c.world.closes[c.body.cursor]; enclosing := c.body.value_block.end
    allowed := c.body.tail && terminal(&c, end + 1, true)
    if ends_value_block(&c, end + 1) { c.body.value_block.end = end }
    exits := block_body(&mut c, allowed, &catalog, &mut inline_work, &mut model)
    c.body.value_block.end = enclosing
    exits
}
fn block_body(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    if !c.ok { return false }
    c.body.block_depth = c.body.block_depth + 1
    if c.body.block_depth > 128 { fail(&mut c, "block nesting exceeds 128"); c.body.block_depth = c.body.block_depth - 1; return false }
    previous_end := c.body.block_end; previous_tail := c.body.tail
    c.body.block_end = c.world.closes[c.body.cursor]; c.body.tail = tail_allowed
    mut body := -1; mut previous := -1
    if model.recording { body = typed.node(&mut model, 10, 0, -1, -1, -1, 0, -1, c.body.cursor) }
    expect(&mut c, "{"); separators(&mut c)
    mut returns := false
    live_entry := ownership.falls_through(&c.body.ownership)
    while c.ok && !is(&c, "}") {
        if c.world.tokens.kinds[c.body.cursor] == .End { fail(&mut c, "unterminated block"); break }
        first_owner := c.body.owned_slots.len
        model.value = -1
        ends := statement(&mut c, &catalog, &mut inline_work, &mut model); returns = returns || ends
        if model.recording { previous = typed.append(&mut model, body, previous) }
        cleanup_from(&mut c, first_owner, true)
        separators(&mut c)
    }
    while c.ok && c.body.defers.scopes.len > 0 && c.body.defers.scopes[c.body.defers.scopes.len - 1] == c.body.scope {
        body := c.body.defers.bodies.pop(); scope := c.body.defers.scopes.pop()
        owners := c.body.defers.owner_limits.pop(); locals := c.body.defers.local_limits.pop()
        entry := c.body.defers.entries.pop(); exits := c.body.defers.exits.pop()
        _ := c.body.defers.operand_depths.pop()
        drop_locals_to(&mut c, locals, c.body.scope)
        if entry >= 0 {
            arm.store(&mut c.code, c.body.defers.selector, 31); bind_block(&mut c, entry)
        }
        saved := c.body.cursor; c.body.cursor = body
        c.body.in_defer = true; c.body.defer_loop_floor = c.body.loop_heads.len
        ignored := block(&mut c, false, &catalog, &mut inline_work, &mut model)
        c.body.in_defer = false; c.body.cursor = saved
        lock_limit := c.body.move_defer_limits.pop()
        while c.body.move_defer_locks.len > lock_limit { _ := c.body.move_defer_locks.pop() }
        resume_defer_exit(&mut c, exits)
    }
    expect(&mut c, "}"); leave(&mut c)
    model.value = body
    c.body.block_end = previous_end; c.body.tail = previous_tail; c.body.block_depth = c.body.block_depth - 1
    returns || (live_entry && !ownership.falls_through(&c.body.ownership))
}
fn terminal(c: &Session, after: i32, semicolons: bool) -> bool {
    mut pos := after
    while pos < c.world.tokens.texts.len && (lexer.is_newline(c.world.tokens.kinds[pos]) || (semicolons && c.world.tokens.texts[pos] == ";")) { pos = pos + 1 }
    pos == c.body.block_end
}
fn end_statement(c: &mut Session) {
    if c.ok && !is(&c, "\n") && !is(&c, ";") && !is(&c, "}") && c.world.tokens.kinds[c.body.cursor] != .End { fail(&mut c, "expected newline or semicolon") }
}
fn ends_value_block(c: &Session, after: i32) -> bool {
    c.body.value_block.end == c.body.block_end && terminal(&c, after, false)
}
fn nested_choice_tail(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    expected := c.body.value_block.expected; home := c.body.value_block.home
    ty := choice_arms(&mut c, expected, home, &catalog, &mut inline_work, &mut model)
    c.body.value_block.ty = ty
    ty == 0
}
fn join_statement_outcomes(state: &mut ownership.State, left: &ownership.State, left_terminal: bool,
    right: &ownership.State, right_terminal: bool) {
    if left_terminal && !right_terminal { ownership.restore(&mut state, &right) }
    else if !left_terminal && right_terminal { ownership.restore(&mut state, &left) }
    else { ownership.join(&mut state, &left, &right) }
}
fn conditional(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "conditional nesting exceeds 128"); c.body.depth = c.body.depth - 1; return false }
    result := conditional_inner(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
    c.body.depth = c.body.depth - 1
    result
}
fn conditional_inner(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor - 1
    mut cond_end := c.body.cursor
    folded := tc_eval.eval_target_or(&c.world.tokens, &c.body.locals, c.code.platform, c.body.cursor, &mut cond_end)
    if folded >= 0 && cond_end < c.world.tokens.kinds.len && tc_eval.tok_is(&c.world.tokens, cond_end, "{") {
        c.body.cursor = cond_end
        if folded == 1 {
            taken := block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
            newlines(&mut c)
            if eat(&mut c, "else") {
                if eat(&mut c, "if") { c.body.cursor = lookahead.conditional_end(&c.world.tokens, &c.world.closes, &c.types, &c.body.locals, c.body.cursor) }
                else { skip_body(&mut c) }
            }
            return taken
        }
        skip_body(&mut c)
        newlines(&mut c)
        if eat(&mut c, "else") {
            if eat(&mut c, "if") { return conditional(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model) }
            return block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
        }
        if model.recording { _ := typed.node(&mut model, 10, 0, -1, -1, -1, 0, -1, at) }
        return false
    }
    condition_at := c.body.cursor; ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty)
    condition := model.value
    before_branch := ownership.snapshot(&c.body.ownership)
    otherwise := new_block(&mut c); done := new_block(&mut c)
    source_edge(&mut c, otherwise, .WhenFalse, condition_at)
    then_block := new_block(&mut c); bind_block(&mut c, then_block)
    left := block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model); source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, otherwise)
    yes := model.value
    left_state := ownership.snapshot(&c.body.ownership)
    ownership.restore(&mut c.body.ownership, &before_branch)
    newlines(&mut c)
    mut right := false; mut no := -1
    if eat(&mut c, "else") {
        if eat(&mut c, "if") {
            right = conditional(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
            if model.recording { no = typed.node(&mut model, 10, 0, model.value, -1, -1, 0, -1, at) }
        } else { right = block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model); no = model.value }
    }
    if model.recording { _ := typed.node(&mut model, 13, 0, condition, yes, no, 0, -1, at) }
    right_state := ownership.snapshot(&c.body.ownership)
    join_statement_outcomes(&mut c.body.ownership, &left_state, left, &right_state, right)
    bind_block(&mut c, done)
    left && right
}
struct PatternBindings { tokens: []i32, types: []i32, parents: []i32, offsets: []i32, locals: []i32 }
fn match_pattern(c: &mut Session, patterns: &mut coverage.Patterns, bindings: &mut PatternBindings, ty: i32, parent: i32, offset: i32, next: i32, depth: i32) -> i32 {
    if depth > 128 { fail(&mut c, "match pattern nesting exceeds 128"); return -1 }
    if eat(&mut c, "_") { return coverage.node(&mut patterns, -1) }
    if depth > 0 && c.world.tokens.kinds[c.body.cursor] == .Name && c.world.tokens.texts[c.body.cursor + 1] != "." {
        bindings.tokens.push(c.body.cursor); bindings.types.push(ty)
        bindings.parents.push(parent); bindings.offsets.push(offset)
        skip_token(&mut c)
        return coverage.node(&mut patterns, -1)
    }
    if !enum_type(&c, ty) { fail(&mut c, "match pattern requires an enum"); return -1 }
    if !is(&c, ".") {
        mut actual := -1
        if c.world.tokens.kinds[c.body.cursor] == .Name {
            name := advance(&mut c)
            actual = resolve_type_name(&c, name)
        }
        if !c.ok || actual != ty {
            fail(&mut c, "wrong enum in match pattern"); return -1
        }
    }
    expect(&mut c, ".")
    if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected enum variant in match pattern"); return -1 }
    found := field(&c, ty, peek(&c))
    if found < 0 { fail(&mut c, "unknown match variant"); return -1 }
    pattern_at := c.body.cursor; name := advance(&mut c)
    root := coverage.node(&mut patterns, found)
    count := c.types.payload_counts[found]
    mut payload := parent
    arm.load(&mut c.code, parent)
    if offset != 0 {
        place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), offset / 8, pattern_at)
        if count > 0 { payload = slot(&mut c); arm.store(&mut c.code, payload, 0) }
    }
    if ft.type_kind(&c.types, ty) == 7 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Tag), 0, pattern_at) }
    arm.imm(&mut c.code, 1, c.types.field_values[found])
    arm.compare_register(&mut c.code, 0, 1); source_edge(&mut c, next, .NextVariant, pattern_at)
    if count > 0 {
        expect(&mut c, "(")
        for i in 0..count {
            if !c.ok { return -1 }
            if i > 0 { expect(&mut c, ",") }
            pt := c.types.payload_types[c.types.payload_starts[found] + i]
            child := match_pattern(&mut c, &mut patterns, &mut bindings, pt, payload, (i + 1) * 8, next, depth + 1)
        }
        expect(&mut c, ")")
    }
    coverage.close(&mut patterns, root)
    root
}
fn transfer_pattern(c: &mut Session, bindings: &PatternBindings, i: i32) {
    at := bindings.tokens[i]; ty := bindings.types[i]; id := bindings.locals[i]
    arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[id]))
    arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, bindings.parents[i])
    store_mem(&mut c, 31, 0, bindings.offsets[i]); arm.pop_temp(&mut c.code, 0)
    owner_store(&mut c, .Vacate, ty, places.local_home(c.body.places.arena.locals[id]))
    save_owner(&mut c, places.local_home(c.body.places.arena.locals[id]), ty, false)
}
fn bind_pattern(c: &mut Session, model: &mut opt_ir.Function, bindings: &mut PatternBindings, guarded: bool, borrowed: bool) {
    for i in 0..bindings.tokens.len {
        at := bindings.tokens[i]; ty := bindings.types[i]; index := slot(&mut c)
        bind(&mut c, &mut model, c.world.tokens.texts[at].clone(), ty, false, index, at)
        id := c.body.locals.types.len - 1; bindings.locals.push(id)
        arm.load(&mut c.code, bindings.parents[i]); place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), bindings.offsets[i] / 8, at)
        if (borrowed && owned(&c, ty)) || ft.move_only(&c.types, ty) {
            arm.store(&mut c.code, index, 0)
            if guarded || borrowed { c.body.pattern_borrowed.push(id) }
            else { transfer_pattern(&mut c, &bindings, i) }
        } else {
            copy_value(&mut c, ty)
            if owned(&c, ty) { save_owner(&mut c, index, ty, false) } else { arm.store(&mut c.code, index, 0) }
        }
    }
}
fn match_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    mut unused_type := 0
    match_arms(&mut c, -1, -1, &mut unused_type, &catalog, &mut inline_work, &mut model)
}
fn match_guard(c: &mut Session, first_owner: i32, first_borrow: i32, next: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) {
    newlines(&mut c)
    condition_at := c.body.cursor; condition := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model)
    same(&mut c, 3, condition)
    if !c.ok { return }
    if first_owner == c.body.owned_slots.len && first_borrow == c.body.pattern_borrowed.len { source_edge(&mut c, next, .WhenFalse, condition_at); return }
    accepted := new_block(&mut c)
    source_edge(&mut c, accepted, .WhenTrue, condition_at)
    cleanup_from(&mut c, first_owner, false)
    for i in first_borrow..c.body.pattern_borrowed.len {
        id := c.body.pattern_borrowed[i]
        owner_store(&mut c, .Vacate, c.body.locals.types[id], places.local_home(c.body.places.arena.locals[id]))
    }
    source_edge(&mut c, next, .Jump, condition_at); bind_block(&mut c, accepted)
}
fn match_arms(c: &mut Session, context: i32, home: i32, result_type: &mut i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    consuming := eat(&mut c, "move")
    subject_at := c.body.cursor
    mut ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
    if ft.type_kind(&c.types, ty) == 4 { ty = read_returned(&mut c, ty, subject_at) }
    if !enum_type(&c, ty) { fail(&mut c, "match requires an enum"); return false }
    subject_place := c.body.places.current
    subject_root := source_root(&c, subject_place)
    borrowed_subject := !consuming && c.body.expr.owner < 0 && subject_place != 0
    saved := slot(&mut c)
    if borrowed_subject {
        arm.store(&mut c.code, saved, 0)
        if subject_root >= 0 { c.body.for_locks.push(subject_root) }
    } else {
        take_value(&mut c, ty)
        if owned(&c, ty) { save_owner(&mut c, saved, ty, true) } else { arm.store(&mut c.code, saved, 0) }
    }
    if !is(&c, "{") { fail(&mut c, "expected match arms"); return false }
    tail := context < 0 && c.body.tail && terminal(&c, c.world.closes[c.body.cursor] + 1, true)
    expect(&mut c, "{"); separators(&mut c)
    mut patterns := coverage.new(ft.type_count(&c.types, ty))
    mut fallback := false; mut returns := true
    done := new_block(&mut c)
    mut continuing := ownership.snapshot(&c.body.ownership)
    mut outcomes := ownership.new(); ownership.terminate(&mut outcomes)
    mut outcome_seen := false; mut falling_through := false
    while !is(&c, "}") && c.ok {
        ownership.restore(&mut c.body.ownership, &continuing)
        if fallback { fail(&mut c, "wildcard must be the final match arm"); return false }
        next := new_block(&mut c); enter(&mut c)
        wildcard := is(&c, "_")
        mut bindings := PatternBindings { tokens: [], types: [], parents: [], offsets: [], locals: [] }
        root := match_pattern(&mut c, &mut patterns, &mut bindings, ty, saved, 0, next, 0)
        if !c.ok { return false }
        newlines(&mut c)
        guarded := eat(&mut c, "if")
        fallback = wildcard && !guarded
        error := coverage.add(&mut patterns, &c.types, ty, root, guarded)
        if error != "" { fail(&mut c, error); return false }
        first_owner := c.body.owned_slots.len
        marker_floor := c.body.pattern_borrowed.len
        bind_pattern(&mut c, &mut model, &mut bindings, guarded, borrowed_subject)
        if guarded {
            match_guard(&mut c, first_owner, marker_floor, next, &catalog, &mut inline_work, &mut model); newlines(&mut c)
            guarded_state := ownership.snapshot(&c.body.ownership); skipped := ownership.snapshot(&continuing)
            ownership.join(&mut continuing, &skipped, &guarded_state)
            if !borrowed_subject {
                for i in 0..bindings.tokens.len { if ft.move_only(&c.types, bindings.types[i]) { transfer_pattern(&mut c, &bindings, i) } }
                while c.body.pattern_borrowed.len > marker_floor { _ := c.body.pattern_borrowed.pop() }
            }
        }
        expect(&mut c, "=>"); newlines(&mut c); mut ends := false
        if context >= 0 {
            mut expected := context
            if result_type != 0 { expected = result_type }
            value := branch_value(&mut c, expected, home, true, &catalog, &mut inline_work, &mut model)
            if !c.ok { return false }
            ends = value == 0
            if !ends {
                if result_type == 0 { result_type = value } else { same(&mut c, result_type, value) }
            }
        } else if is(&c, "{") { ends = block(&mut c, tail, &catalog, &mut inline_work, &mut model) }
        else {
            arm_at := c.body.cursor; mut expected := 0; if tail { expected = c.body.ret_type }
            value := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
            if tail && expected != 0 {
                if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
                same(&mut c, expected, value); take_return_value(&mut c, value, arm_at)
                return_from_body(&mut c, arm_at); ends = true
            } else if value != 0 { fail(&mut c, "unused match arm value") }
        }
        returns = returns && ends
        leave(&mut c)
        while c.body.pattern_borrowed.len > marker_floor { _ := c.body.pattern_borrowed.pop() }
        arm_state := ownership.snapshot(&c.body.ownership); prior := ownership.snapshot(&outcomes)
        if outcome_seen { join_statement_outcomes(&mut outcomes, &prior, !falling_through, &arm_state, ends) }
        else { ownership.restore(&mut outcomes, &arm_state); outcome_seen = true }
        falling_through = falling_through || !ends
        source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, next)
        separators(&mut c); if !eat(&mut c, ",") && !is(&c, "}") { fail(&mut c, "expected comma between match arms") }; separators(&mut c)
    }
    expect(&mut c, "}"); bind_block(&mut c, done)
    if c.ok && !fallback {
        error := coverage.complete(&mut patterns, &c.types, ty)
        if error != "" { fail(&mut c, error) }
    }
    ownership.restore(&mut c.body.ownership, &outcomes)
    if borrowed_subject && subject_root >= 0 { _ := c.body.for_locks.pop() }
    returns
}
fn scratch_width(c: &Session, ty: i32) -> i32 { ft.scratch_width(&c.types, ty, c.code.platform) }
fn scratch_block(c:&mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function)->bool {
    name_at := c.body.cursor; name:=advance(&mut c)
    if eat(&mut c,"(") { ty:=expression(&mut c,0,1, &catalog, &mut inline_work, &mut model);same(&mut c,1,ty);expect(&mut c,")") }
    else {arm.imm(&mut c.code,0,65536)}
    area:=slot(&mut c);cursor:=slot(&mut c);limit:=slot(&mut c)
    arm.store(&mut c.code,limit,0);arm.store(&mut c.code,cursor,31)
    valid:=arm.label(&mut c.code);arm.compare_immediate(&mut c.code, 0, 0, false);arm.branch(&mut c.code,valid,12)
    arm.fail_source(&mut c.code, .InvalidRegion, c.world.tokens.starts[name_at]);arm.mark(&mut c.code,valid)
    token:=compound(&mut c,20,0)
    arm.intrinsic_call(&mut c.code, c.runtime.alloc, .RegionNew, 1, token, c.world.tokens.starts[name_at])
    save_owner(&mut c,area,4,false)
    enter(&mut c);bind(&mut c, &mut model,move name,token,false,area, name_at)
    if !is(&c,"{"){fail(&mut c,"expected region body");return false}
    ends:=scoped_body(&mut c, &catalog, &mut inline_work, &mut model)
    clear_owner(&mut c,area,4)
    ends
}
fn scratch_declaration(c:&mut Session, name:string, mutable:bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function)->bool {
    start:=c.body.cursor
    if start+8>=c.world.tokens.texts.len || c.world.tokens.texts[start]!=":" || c.world.tokens.texts[start+1]!="[" || c.world.tokens.texts[start+2]!="]" || c.world.tokens.texts[start+4]!="=" {return false}
    region:=local(&c.body,c.world.tokens.texts[start+5])
    if region<0 || ft.type_kind(&c.types, c.body.locals.types[region])!=20 {return false}
    area:=places.local_home(c.body.places.arena.locals[region])
    c.body.cursor=start+3;elem:=type_name(&mut c);width:=scratch_width(&c,elem)
    if width==0{fail(&mut c,"scratch elements must be numeric, bool, rune or plain value records");return true}
    expect(&mut c,"=");receiver:=advance(&mut c);expect(&mut c,".");expect(&mut c,"alloc");expect(&mut c,"(")
    actual:=expression(&mut c,0,1, &catalog, &mut inline_work, &mut model);same(&mut c,1,actual);expect(&mut c,")")
    mut align:=width;if ft.is_c_record(&c.types, elem) {align=ft.c_align(&c.types, elem)} else if ft.type_kind(&c.types, elem)==2{align=8}
    view:=compound(&mut c,21,elem);binding:=slot(&mut c)
    for unused in 0..5 { slot_for_descriptor:=slot(&mut c) }
    descriptor:=slot(&mut c)
    stride := unsigned.shift(storage_type(&c, elem))
    scratch.allocate(&mut c.code,area,descriptor,elem,width,align,c.bounds,stride,c.world.tokens.starts[start + 7])
    arm.store(&mut c.code,binding,0);bind(&mut c, &mut model,name.clone(),view,mutable,binding,start - 1);end_statement(&mut c)
    true
}

fn statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor
    kind := c.world.tokens.kinds[at]; word := c.world.tokens.texts[at].clone()
    if kind == .Name && word != "region" && word != "task" && word != "unsafe" && word != "mut" {
        return value_statement(&mut c, &catalog, &mut inline_work, &mut model)
    }
    if model.probing && (!model.recording || is(&c, "task") || is(&c, "region") || is(&c, "unsafe") || is(&c, "match") || is(&c, "defer")) && decline_projection(&mut c, &mut model) {
        return false
    }
    if is(&c, "task") && c.world.tokens.texts[c.body.cursor + 1] == "scope" { return task_scope_statement(&mut c, &catalog, &mut inline_work, &mut model) }
    if is(&c,"region") && c.world.tokens.kinds[c.body.cursor+1]==.Name {skipped:=advance(&mut c); return scratch_block(&mut c, &catalog, &mut inline_work, &mut model)}
    if eat(&mut c, "unsafe") {
        task_effect(&mut c, 16)
        if !c.world.unsafe_capable { fail(&mut c, "module requires capability unsafe"); return false }
        previous := c.body.unsafe_scope; c.body.unsafe_scope = true
        enter(&mut c)
        result := scoped_body(&mut c, &catalog, &mut inline_work, &mut model); c.body.unsafe_scope = previous; return result
    }
    if is(&c, "match") {
        after := lookahead.match_end(&c.world.tokens, &c.world.closes, &c.types, &c.body.locals, c.body.cursor + 1, 0)
        if ends_value_block(&c, after) { return nested_choice_tail(&mut c, &catalog, &mut inline_work, &mut model) }
        if !lookahead.continues_expression(&c.world.tokens, after) {
            c.body.cursor = c.body.cursor + 1
            return match_statement(&mut c, &catalog, &mut inline_work, &mut model)
        }
    }
    if eat(&mut c, "return") {
        if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
        if is(&c, "\n") || is(&c, ";") || is(&c, "}") {
            if c.body.ret_type != 0 { fail(&mut c, "missing return value") }; arm.imm(&mut c.code, 0, 0)
        } else { ty := expression(&mut c, 0, c.body.ret_type, &catalog, &mut inline_work, &mut model); same(&mut c, c.body.ret_type, ty) }
        end_statement(&mut c)
        if model.recording { _ := typed.node(&mut model, 15, 0, model.value, -1, -1, 0, -1, at) }
        take_return_value(&mut c, c.body.ret_type, at)
        return_from_body(&mut c, at)
        return true
    }
    if is(&c, "if") {
        after := lookahead.conditional_end(&c.world.tokens, &c.world.closes, &c.types, &c.body.locals, c.body.cursor + 1)
        if ends_value_block(&c, after) { return nested_choice_tail(&mut c, &catalog, &mut inline_work, &mut model) }
        if !lookahead.continues_expression(&c.world.tokens, after) {
            c.body.cursor = c.body.cursor + 1
            allowed := c.body.tail && terminal(&c, after, true)
            return conditional(&mut c, allowed, &catalog, &mut inline_work, &mut model)
        }
    }
    if eat(&mut c, "while") {
        move_loop_begin(&mut c)
        previous_reentry := c.body.reenter_owners; c.body.reenter_owners = true
        condition_at := c.body.cursor
        head := new_block(&mut c); done := new_block(&mut c); bind_block(&mut c, head)
        begin_loop_scope(&mut c, head, done)
        ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty); source_edge(&mut c, done, .WhenFalse, condition_at); body := new_block(&mut c); bind_block(&mut c, body)
        condition := model.value
        loop_exit := ownership.snapshot(&c.body.ownership)
        ends := block(&mut c, false, &catalog, &mut inline_work, &mut model)
        end_loop_scope(&mut c)
        move_loop_backedge(&mut c); move_loop_end(&mut c, &loop_exit)
        source_edge(&mut c, head, .Jump, c.body.cursor); bind_block(&mut c, done)
        c.body.reenter_owners = previous_reentry
        if model.recording { _ := typed.node(&mut model, 14, 0, condition, model.value, -1, 0, -1, at) }
        return false
    }
    if eat(&mut c, "for") {
        name_at := c.body.cursor; name := advance(&mut c); expect(&mut c, "in")
        previous_stream := c.body.stream_depth; c.body.stream_depth = c.body.depth + 2; c.body.stream_kind = 0
        consuming_for := eat(&mut c, "move")
        mut borrowed_for := eat(&mut c, "&")
        if consuming_for && borrowed_for { fail(&mut c, "move iteration requires an owned array"); return false }
        if borrowed_for && model.probing && decline_projection(&mut c, &mut model) { return false }
        mut low := 0
        mut place_base := -1
        mut locked_local := -1
        if borrowed_for {
            c.body.stream_depth = previous_stream; c.body.stream_kind = 0
            if eat(&mut c, "mut") { fail(&mut c, "for loop requires & rather than &mut"); return false }
            previous_address := c.body.place.taking_address; c.body.place.taking_address = false
            low = primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
            c.body.place.taking_address = previous_address
        } else {
            low = expression(&mut c, 1, 1, &catalog, &mut inline_work, &mut model)
        }
        if ft.type_kind(&c.types, low) == 4 {
            if consuming_for { fail(&mut c, "move iteration requires an owned array"); return false }
            low = read_returned(&mut c, low, name_at); borrowed_for = true
        }
        array_place := c.body.places.current
        if borrowed_for {
            if !collection(&c, low) { fail(&mut c, "for borrow requires an array"); return false }
            if array_place == 0 { fail(&mut c, "for borrow requires a stored array"); return false }
        } else if !consuming_for && c.body.stream_kind == 0 && !is(&c, "..") && collection(&c, low) && c.body.expr.owner < 0 {
            borrowed_for = array_place != 0
        }
        if c.body.stream_kind == 10 {
            c.body.stream_kind = 0; borrowed_for = array_place != 0 && !consuming_for
        }
        if borrowed_for { place_base = source_root(&c, array_place) }
        low_node := model.value; mut high_node := -1
        if model.probing && !is(&c, "..") && decline_projection(&mut c, &mut model) {
            c.body.stream_depth = previous_stream; c.body.stream_kind = 0; return false
        }
        stream := c.body.stream_kind; c.body.stream_depth = previous_stream; c.body.stream_kind = 0
        cursor := slot(&mut c); limit := slot(&mut c); values := slot(&mut c); binding := slot(&mut c)
        mut kind: iteration.Kind = .Range; source := c.world.tokens.starts[at]
        mut base := 1; mut array := false
        mut borrow_elem := false
        if stream != 0 {
            same(&mut c, 4, low); base = stream
            kind = .Bytes; if stream == 5 { kind = .Runes }
            take_value(&mut c, 4); save_owner(&mut c, values, 4, true)
            _ := length_value(&mut c, low, name_at); arm.store(&mut c.code, limit, 0)
            arm.imm(&mut c.code, 0, 0); arm.store(&mut c.code, cursor, 0)
        } else if !borrowed_for && eat(&mut c, "..") {
            same(&mut c, 1, low); arm.store(&mut c.code, cursor, 0)
            high := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, high); arm.store(&mut c.code, limit, 0); high_node = model.value
        } else if !borrowed_for && low == 14 {
            arm.mov(&mut c.code, 1, 0); iteration.emit(&mut c.code, .RangeStart, kind, base, source); arm.store(&mut c.code, cursor, 0)
            iteration.emit(&mut c.code, .RangeLimit, kind, base, source); arm.store(&mut c.code, limit, 0)
        } else {
            if !collection(&c, low) { fail(&mut c, "for requires a range or array"); return false }
            array = true; base = ft.type_base(&c.types, low); kind = .Array; if ft.type_kind(&c.types, low) == 6 { kind = .Fixed }
            if borrowed_for {
                arm.store(&mut c.code, values, 0)
                locked_local = place_base
                if owned(&c, base) { borrow_elem = true }
            } else {
                take_value(&mut c, low); save_owner(&mut c, values, low, true)
            }
            _ := length_value(&mut c, low, name_at); arm.store(&mut c.code, limit, 0); arm.imm(&mut c.code, 0, 0); arm.store(&mut c.code, cursor, 0)
        }
        move_loop_begin(&mut c); loop_exit := ownership.snapshot(&c.body.ownership)
        head := new_block(&mut c); next := new_block(&mut c); done := new_block(&mut c)
        enter(&mut c)
        if array || stream != 0 {
            mut bind_type := base
            if borrow_elem { bind_type = compound(&mut c, 4, base) }
            bind(&mut c, &mut model, move name, bind_type, false, binding, name_at)
            if borrow_elem {
                id := c.body.locals.names.len - 1
                path := owner_path(&c, array_place); origin := loan_origin(&c, array_place)
                local_borrows.transient(&mut c.body.local_loans, id, path, place_base, origin)
            }
        } else { bind(&mut c, &mut model, move name, 1, false, cursor, name_at) }
        iterator := model.local_types.len - 1
        previous_reentry := c.body.reenter_owners; c.body.reenter_owners = true
        bind_block(&mut c, head); arm.load(&mut c.code, cursor); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, limit)
        iteration.emit(&mut c.code, .Test, kind, base, source); source_edge(&mut c, done, .RangeDone, name_at)
        if stream != 0 {
            mut expanded := false
            if stream == 5 { expanded = inline_rune_stream(&mut c, values, cursor, source) }
            if !expanded {
                if stream == 1 {
                    arm.load(&mut c.code, values); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, cursor)
                    place_step(&mut c, .Element, 1, 0, 0, 0, name_at)
                    place_step(&mut c, .Read, 1, 0, 0, 0, name_at)
                } else {
                    arm.load(&mut c.code, cursor); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, values)
                    arm.intrinsic_call(&mut c.code, c.runtime.string_next, .NextRune, 4, 5, c.world.tokens.starts[name_at]); arm.store(&mut c.code, cursor, 1)
                }
            }
            arm.store(&mut c.code, binding, 0)
        } else if array {
            arm.load(&mut c.code, values); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, cursor)
            shift := unsigned.shift(storage_type(&c, base))
            mut access := 0; if borrow_elem { access = 3 }; place_step(&mut c, .Element, base, access, 1, shift, name_at)
            if borrow_elem {
                if ft.is_c_record(&c.types, base) || fixed_pod(&c, base) { place_transfer(&mut c, base, 0, 0, true, false, access, name_at) }
                if fixed_pod(&c, base) { place_transfer(&mut c, base, 0, 0, true, false, access, name_at) }
                arm.store(&mut c.code, binding, 0)
            } else if borrowed_for {
                place_transfer(&mut c, base, 0, 0, true, false, access, name_at); arm.store(&mut c.code, binding, 0)
            } else {
                if ft.move_only(&c.types, base) {
                    address := slot(&mut c); arm.store(&mut c.code, address, 0)
                    place_transfer(&mut c, base, 0, 0, true, false, access, name_at)
                    arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, address); store_mem(&mut c, 31, 0, 0); arm.pop_temp(&mut c.code, 0)
                } else { place_transfer(&mut c, base, 0, 0, true, false, access, name_at); copy_value(&mut c, base) }
                if owned(&c, base) { save_owner(&mut c, binding, base, false) } else { arm.store(&mut c.code, binding, 0) }
            }
        }
        if locked_local >= 0 { c.body.for_locks.push(locked_local) }
        begin_loop_scope(&mut c, next, done)
        ends := block(&mut c, false, &catalog, &mut inline_work, &mut model)
        end_loop_scope(&mut c)
        if model.recording { _ := typed.node(&mut model, 19, 0, low_node, high_node, model.value, 0, iterator, at) }
        if locked_local >= 0 { unlocked := c.body.for_locks.pop() }
        bind_block(&mut c, next)
        if stream != 5 { arm.load(&mut c.code, cursor); iteration.emit(&mut c.code, .Advance, kind, base, source); arm.store(&mut c.code, cursor, 0) }
        move_loop_backedge(&mut c); move_loop_end(&mut c, &loop_exit)
        source_edge(&mut c, head, .Jump, c.body.cursor); bind_block(&mut c, done); leave(&mut c)
        c.body.reenter_owners = previous_reentry; return false
    }
    if is(&c, "break") || is(&c, "continue") {
        exit_at := c.body.cursor; name := advance(&mut c)
        if c.body.loop_heads.len == 0 { fail(&mut c, "break or continue requires a loop"); return false }
        if c.body.in_defer && c.body.loop_heads.len <= c.body.defer_loop_floor { fail(&mut c, "break or continue cannot exit defer"); return false }
        mut target := c.body.loop_ends[c.body.loop_ends.len - 1]
        mut action := row.Edge.Break
        if name == "continue" { action = .Continue; target = c.body.loop_heads[c.body.loop_heads.len - 1] }
        if model.recording { mut kind := 16; if name == "continue" { kind = 17 }; _ := typed.node(&mut model, kind, 0, -1, -1, -1, 0, -1, at) }
        if name == "continue" { move_loop_backedge(&mut c) } else { move_loop_break(&mut c) }
        loop := c.body.loop_heads.len - 1
        unwind_exit(&mut c, c.body.loop_defers[loop], c.body.loop_operands[loop])
        cleanup_pending(&mut c, c.body.loop_pending[loop])
        if c.tasks.program { task_close_locals(&mut c, c.body.loop_task_locals[c.body.loop_task_locals.len - 1]) }
        cleanup_from(&mut c, c.body.loop_owners[c.body.loop_owners.len - 1], false); source_edge(&mut c, target, action, exit_at)
        ownership.terminate(&mut c.body.ownership)
        end_statement(&mut c)
        return true
    }
    if eat(&mut c, "defer") {
        if c.body.in_defer { fail(&mut c, "cannot nest defer blocks"); return false }
        if !is(&c, "{") { fail(&mut c, "expected block after defer"); return false }
        c.body.move_defer_limits.push(c.body.move_defer_locks.len)
        for token in (c.body.cursor + 1)..c.world.closes[c.body.cursor] {
            if c.world.tokens.kinds[token] == .Name {
                captured := local(&c.body, c.world.tokens.texts[token])
                if captured >= 0 {
                    mut ty := c.body.locals.types[captured]; kind := ft.type_kind(&c.types, ty)
                    if kind == 4 || kind == 5 { ty = ft.type_base(&c.types, ty) }
                    if ft.move_only(&c.types, ty) { c.body.move_defer_locks.push(captured) }
                }
            }
        }
        deferred.register(&mut c.body.defers, c.body.cursor, c.body.scope, c.body.owned_slots.len, c.body.locals.active.len, c.code.operand_depth)
        skip_body(&mut c)
        end_statement(&mut c)
        return false
    }
    if is(&c, "{") {
        enter(&mut c); return scoped_body(&mut c, &catalog, &mut inline_work, &mut model)
    }
    value_statement(&mut c, &catalog, &mut inline_work, &mut model)
}
fn test_statement_value(c: &mut Session, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    at := c.body.cursor; previous := c.body.assert_operands
    c.body.assert_operands = assert_operands(&c, at, false)
    ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
    operands := c.body.assert_operands; c.body.assert_operands = previous
    if ty == 3 && statement_separator(&c, c.body.cursor) && !ends_value_block(&c, c.body.cursor) {
        assert_value(&mut c, at, at, c.body.cursor - 1, &operands)
        return 0
    }
    ty
}
fn bind_tuple(c: &mut Session, assignment: i32, mutable: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) {
    if model.probing && decline_projection(&mut c, &mut model) { return }
    first := c.body.cursor + 1; end := assignment - 1
    c.body.cursor = assignment + 1
    ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
    if !c.ok { return }
    if !ft.is_tuple(&c.types, ty) { fail(&mut c, "tuple binding requires an owned tuple value"); return }
    mut names := 0
    for token in first..end { if c.world.tokens.kinds[token] == .Name { names += 1 } }
    if names != ft.type_count(&c.types, ty) { fail(&mut c, "tuple binding must name or discard each component"); return }

    take_value(&mut c, ty)
    if !c.ok { return }
    box := slot(&mut c); arm.store(&mut c.code, box, 0)
    fields := ft.type_start(&c.types, ty)
    mut ordinal := 0
    for token in first..end {
        if c.world.tokens.kinds[token] != .Name { continue }
        part := ordinal; ordinal += 1
        name := c.world.tokens.texts[token].clone()
        if name == "_" { continue }
        field_type := c.types.field_types[fields + part]
        index := slot(&mut c); bind(&mut c, &mut model, move name, field_type, mutable, index, token)
        if !c.ok { return }
        arm.load(&mut c.code, box)
        place_step(&mut c, .Member, field_type, 0, i32(place_op.Member.Payload), part, token)
        if owned(&c, field_type) {
            arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, box)
            store_mem(&mut c, 31, 0, part * 8); arm.pop_temp(&mut c.code, 0)
            save_owner(&mut c, index, field_type, false)
        } else { arm.store(&mut c.code, index, 0) }
    }
    arm.load(&mut c.code, box); drop_value(&mut c, ty)
    end_statement(&mut c)
}
fn value_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor
    mut mutable := false
    if eat(&mut c, "mut") { mutable = true }
    assignment := lexer.tuple_binding_end(&c.world.tokens, c.body.cursor, c.world.tokens.kinds.len)
    if assignment >= 0 {
        bind_tuple(&mut c, assignment, mutable, &catalog, &mut inline_work, &mut model)
        return false
    }
    if c.world.tokens.kinds[c.body.cursor] == .Name && (c.world.tokens.texts[c.body.cursor + 1] == ":=" || c.world.tokens.texts[c.body.cursor + 1] == ":") {
        name_at := c.body.cursor; name := advance(&mut c); mut expected := 0
        if model.probing && is(&c, ":") {
            name := c.world.tokens.texts[c.body.cursor + 1].clone()
            if name != "i32" && name != "i64" && name != "bool" && decline_projection(&mut c, &mut model) { return false }
        }
        if scratch_declaration(&mut c,name,mutable, &catalog, &mut inline_work, &mut model) {return false}
        if eat(&mut c, ":") { expected = type_name(&mut c); expect(&mut c, "=") } else { expect(&mut c, ":=") }
        ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
        if expected != 0 { same(&mut c, expected, ty) }
        if ty == 0 {
            if c.body.expr.untyped_exit { fail(&mut c, "cannot infer a value type when every branch exits") }
            else { fail(&mut c, "local requires a value") }
            return false
        }
        kind := ft.type_kind(&c.types, ty)
        path := c.body.loan.path; root := c.body.loan.root; origin := c.body.loan.origin
        if kind == 5 { fail(&mut c, "local mutable borrows are not supported"); return false }
        if kind == 4 {
            if !c.loans.active { fail(&mut c, "scoped borrow analysis was not prepared"); return false }
            if mutable { fail(&mut c, "local read borrows are immutable"); return false }
            if path < 0 || root < 0 { fail(&mut c, "local borrow requires a named owner; temporary borrows are limited to calls"); return false }
            if origin == -2 { fail(&mut c, "local borrows of scratch storage are not supported"); return false }
        }
        take_value(&mut c, ty); index := slot(&mut c); bind(&mut c, &mut model, move name, ty, mutable, index, name_at)
        if kind == 4 {
            mut source := origin; if source == -1 { source = -3 }
            local_borrows.bind_shared(&mut c.body.local_loans, c.body.locals.names.len - 1, path, root, source, name_at)
        }
        if model.recording { _ := typed.node(&mut model, 11, 0, model.value, -1, -1, 0, model.local_types.len - 1, at) }
        if owned(&c, ty) { save_owner(&mut c, index, ty, false) } else { arm.store(&mut c.code, index, 0) }
        end_statement(&mut c)
        return false
    }
    if mutable { fail(&mut c, "expected declaration after mut"); return false }
    mut binding := -1
    if c.world.tokens.kinds[at] == .Name && c.world.tokens.texts[at + 1] == "=" && c.body.depth <= 126 {
        binding = local(&c.body, c.world.tokens.texts[at])
    }
    mut ty := 0; mut place := 0
    if binding >= 0 && c.world.tokens.kinds[at + 2] == .Name && c.world.tokens.texts[at + 2] == c.world.tokens.texts[at] &&
        (lexer.is_newline(c.world.tokens.kinds[at + 3]) || c.world.tokens.texts[at + 3] == ";" || c.world.tokens.texts[at + 3] == "}") {
        if !c.body.locals.mutable[binding] && ft.type_kind(&c.types, c.body.locals.types[binding]) != 5 { fail(&mut c, "assignment requires a mutable stored value"); return false }
        if !ownership.available(&c.body.ownership, ownership.root_id(&c.body.ownership, binding)) { fail(&mut c, "use of moved value '" + c.body.locals.names[binding] + "'"); return false }
        c.body.cursor = at + 3
        if model.recording { _ := typed.node(&mut model, 10, 0, -1, -1, -1, 0, -1, at) }
        end_statement(&mut c); return false
    }
    if binding >= 0 {
        c.body.cursor = at + 1
        ty = local_value_type(&mut c, binding); if !c.ok { return false }
        place = borrows.local_id(binding); load_binding(&mut c, binding, .Address, at, true)
        fc.clear_expr_value(&mut c.body.expr)
        if model.recording { typed.read(&mut model, binding, at) }
    } else {
