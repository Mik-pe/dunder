            }
            m_fn := impl_method(&c, val_ty, method_name)
            if m_fn < 0 {
                fail(&mut c, "unknown method '" + method_name + "' on type '" + type_spelling(&c, val_ty) + "'")
                set_error_at(&mut c, c.world.tokens.starts[op_at]); break
            }
