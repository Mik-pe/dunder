fn task_effect_at(c: &mut Session, bits: i64, tok: i32) {
    if c.tasks.program {
        c.body.facts.effects = c.body.facts.effects.bit_or(bits)
        if bits.bit_and(i64(15).bit_not()) != 0 && c.body.facts.effect_at < 0 &&
            tok >= 0 && tok < c.world.tokens.starts.len {
            c.body.facts.effect_at = c.world.tokens.starts[tok]
        }
    }
}
fn task_effect(c: &mut Session, bits: i64) {
    mut tok := c.body.cursor - 2
    if tok < 0 { tok = c.body.cursor }
    task_effect_at(&mut c, bits, tok)
}
fn task_edge(c: &mut Session, callee: i32, offset: i32) {
    if c.tasks.program { c.body.facts.calls.push(callee); c.body.facts.call_offsets.push(offset) }
}
fn task_use(c: &mut Session, at: i32) {
    task_effect_at(&mut c, 1024, at)
    if c.body.facts.first_task < 0 { c.body.facts.first_task = at }
}
fn task_certify(c: &mut Session, certificate: &mut tc.TaskCertificate) -> bool {
    mut at := c.body.cursor
    mut bad_chain: []i32 = []
    mut bad_sites: []i32 = []
    err := tc.certify(&c.tasks, &c.types, &c.world.tokens.starts, c.world.names.len, &c.world.param_starts,
        &c.world.param_counts, &c.world.param_types, &c.world.returns, &mut certificate, &mut at,
        &mut bad_chain, &mut bad_sites)
    if err != "" {
        c.body.cursor = at; fail(&mut c, err)
        if bad_chain.len > 0 {
            leaf := bad_chain[bad_chain.len - 1]
            leaf_site := bad_sites[bad_sites.len - 1]
            leaf_name := diagnostics.display_symbol(&c.sources, c.world.names[leaf].clone())
            if bad_chain.len == 1 {
                set_error_note(&mut c, leaf_site, "offending operation in '" + leaf_name + "'")
            } else {
                mut chain := ""
                for idx in 0..bad_chain.len {
                    if idx > 0 { chain += " -> " }
                    chain += diagnostics.display_symbol(&c.sources, c.world.names[bad_chain[idx]].clone())
                    if idx + 1 < bad_chain.len && idx < bad_sites.len && bad_sites[idx] >= 0 {
                        chain += " (" + diagnostics.location_text(&c.sources, generics.origin(&c.specializations, bad_sites[idx])) + ")"
                    }
                }
                set_error_note(&mut c, leaf_site, "call chain: " + chain)
            }
        }
        return false
    }
    true
}
fn import_c(c: &mut Session, symbol: string) -> i32 {
    for i in 0..c.imports.symbols.len {
        if c.imports.libraries[i] == "c" && c.imports.symbols[i] == symbol { return i }
    }
    index := c.imports.symbols.len; c.imports.libraries.push("c"); c.imports.symbols.push(symbol.clone()); index
}
fn bind_task_runtime(c: &mut Session, rt: &runtime.Runtime, certificate: &tc.TaskCertificate) {
    mut iso_labels: []i32 = []; mut drop_labels: []i32 = []
    iso_labels.reserve(c.types.declared.type_kinds.len); drop_labels.reserve(c.types.declared.type_kinds.len)
    for ty in 0..c.types.declared.type_kinds.len {
        mut iso := -1; mut drop := -1
        if ft.owned(&c.types, ty) {
            if ty < c.task_iso_labels.len && c.task_iso_labels[ty] >= 0 { iso = c.task_iso_labels[ty] }
            else { iso = type_helper(&mut c, ty, false) }
            if ty == 4 { drop = rt.release }
            else { drop = type_helper(&mut c, ty, true) }
        }
        iso_labels.push(iso); drop_labels.push(drop)
    }
    plan := tc.build_prefix_plan(&certificate, &c.types, &iso_labels, &drop_labels, &c.world.param_starts, &c.world.param_counts, &c.world.param_types, &c.world.returns, &c.fn_labels)
    mut symbols := task_native.posix_symbols(0, -1, -1, -1)
    if c.jobs.platform == 0 {
        queue := import_c(&mut c, "dispatch_get_global_queue")
        create := import_c(&mut c, "dispatch_group_create")
        submit := import_c(&mut c, "dispatch_group_async_f")
        wait := import_c(&mut c, "dispatch_group_wait")
        release := import_c(&mut c, "dispatch_release")
        unmap := import_c(&mut c, "munmap")
        symbols = task_native.Symbols { symbol_count: c.imports.symbols.len, global_queue: queue,
            create_group: create, submit: submit, wait: wait, release_group: release, munmap: unmap }
    } else {
        create := import_c(&mut c, "pthread_create")
        join := import_c(&mut c, "pthread_join")
        unmap := import_c(&mut c, "munmap")
        symbols = task_native.posix_symbols(c.imports.symbols.len, create, join, unmap)
    }
    out := tc.emit_prefix(&mut c.code, &rt, &plan, &symbols, c.imports.globals)
    if !out.ok { fail(&mut c, out.error); return }
    c.code.labels[c.tasks.open] = c.code.labels[out.open]
    c.code.labels[c.tasks.await_result] = c.code.labels[out.await_result]
    c.code.labels[c.tasks.close] = c.code.labels[out.close]
    c.imports.globals = out.import_globals
    for w in 0..plan.worker_ids.len { c.code.labels[c.tasks.spawners[plan.worker_ids[w]]] = c.code.labels[out.spawners[w]] }
    for i in 0..out.import_sites.len { c.imports.sites.push(out.import_sites[i]); c.imports.slots.push(out.import_slots[i]) }
}

fn task_close_slot(c: &mut Session, index: i32) {
    if c.code.checking { return }
    done := arm.label(&mut c.code); arm.load(&mut c.code, index); arm.branch(&mut c.code, done, 18)
    arm.task_call(&mut c.code, c.tasks.close, .ScopeClose, 0, 0, c.world.tokens.starts[c.body.cursor]); arm.store(&mut c.code, index, 31); arm.mark(&mut c.code, done)
}
fn task_close_locals(c: &mut Session, first: i32) {
    mut i := c.body.locals.active.len - 1
    while i >= first {
        id := c.body.locals.active[i]
        if ft.type_kind(&c.types, c.body.locals.types[id]) == 23 { task_close_slot(&mut c, places.local_home(c.body.places.arena.locals[id])) }
        i = i - 1
    }
}
fn task_capability(c: &mut Session) -> i32 {
    at := c.body.cursor; name := advance(&mut c); binding := local(&c.body, name)
    if binding < 0 { fail(&mut c, "expected a live task scope capability"); set_error_at(&mut c, c.world.tokens.starts[at]); return -1 }
    if ft.type_kind(&c.types, c.body.locals.types[binding]) != 23 { fail(&mut c, "expected a live task scope capability"); return -1 }
    locals.mark_used(&mut c.body.locals, binding)
    binding
}
fn task_scope_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "task"); expect(&mut c, "scope")
    name_at := c.body.cursor; name := advance(&mut c); expect(&mut c, "(")
    actual := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, actual)
    mut factory := -1; mut workspace := 0
    mut shared := -1; mut shared_slot := -1
    if eat(&mut c, ",") {
        mut freeze := is(&c, "shared") && c.world.tokens.texts[c.body.cursor + 1] != ")" && c.world.tokens.texts[c.body.cursor + 1] != ","
        if !freeze {
            factory_at := c.body.cursor; target := advance(&mut c); factory = i32(c.world.functions.get_or(target, -1))
            if factory < 0 || local(&c.body, target) >= 0 || c.world.libraries[factory] != "" || c.world.unsafe_functions[factory] || c.world.param_counts[factory] != 0 {
                fail(&mut c, "task workspace requires a named safe initializer without parameters"); return false
            }
            workspace = c.world.returns[factory]
            if ft.type_kind(&c.types, workspace) != 2 || c.types.c_record[workspace] {
                fail(&mut c, "task workspace initializer must return an owned record"); return false
            }
            c.body.facts.needed.push(factory)
            c.body.facts.factories.push(factory); c.body.facts.factory_tokens.push(factory_at)
            freeze = eat(&mut c, ",")
        }
        if freeze {
            value_at := c.body.cursor; expect(&mut c, "shared")
            cap_slot := slot(&mut c); arm.store(&mut c.code, cap_slot, 0)
            shared = expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
            if !c.ok { return false }
            if ft.type_kind(&c.types, shared) != 2 || ft.is_c_record(&c.types, shared) {
                fail(&mut c, "shared task input requires an owned record of isolated Data"); return false
            }
            c.body.facts.shared.push(tc.shared_data_type(&c.types, shared)); c.body.facts.shared_tokens.push(value_at)
            if shared < c.task_shared_prepare_labels.len && c.task_shared_prepare_labels[shared] >= 0 {
                ownership_call(&mut c, .Copy, shared, c.task_shared_prepare_labels[shared])
                c.body.expr.owner = -1
            } else if is_pod(&c, shared) { box_pod_for_container(&mut c, shared) }
            else if c.body.expr.owner >= 0 { take_value(&mut c, shared) } else { copy_value(&mut c, shared) }
            if !c.code.checking { shared_slot = slot(&mut c); arm.store(&mut c.code, shared_slot, 0) }
            arm.load(&mut c.code, cap_slot)
        }
    }
    expect(&mut c, ")")
    mut cap := 0
    if shared >= 0 {
        params: []i32 = [shared]; cap = callable_type(&mut c, &params, workspace, 23)
    } else { cap = compound(&mut c, 23, workspace) }
    handle := slot(&mut c); c.body.task_handles.push(handle)
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.push_temp(&mut c.code, 0)
        if factory >= 0 { arm.branch(&mut c.code, c.fn_labels[factory], 20); arm.mov(&mut c.code, 2, 0) }
        else { arm.imm(&mut c.code, 2, 0) }
        if shared >= 0 {
            mut drop := type_helper(&mut c, shared, true)
            if shared < c.task_shared_drop_labels.len && c.task_shared_drop_labels[shared] >= 0 {
                drop = c.task_shared_drop_labels[shared]
            }
            arm.branch(&mut c.code, drop, 20); arm.mov(&mut c.code, 4, 0)
            arm.load_into(&mut c.code, shared_slot, 3)
        } else { arm.imm(&mut c.code, 3, 0); arm.imm(&mut c.code, 4, 0) }
        static_address(&mut c, .TaskCoordinator, 0); arm.mov(&mut c.code, 1, 16); arm.pop_temp(&mut c.code, 0)
        arm.task_call(&mut c.code, c.tasks.open, .ScopeOpen, cap, 0, c.world.tokens.starts[at])
    }
    arm.store(&mut c.code, handle, 0)
    enter(&mut c); bind(&mut c, &mut model, move name, cap, false, handle, name_at)
    scoped_body(&mut c, &catalog, &mut inline_work, &mut model)
}
fn task_spawn(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "spawn"); cap := task_capability(&mut c)
    worker_at := c.body.cursor; name := advance(&mut c); worker := i32(c.world.functions.get_or(name, -1))
    if cap < 0 { return 0 }
    if local(&c.body, name) >= 0 || worker < 0 { fail(&mut c, "spawn requires a named Dunder worker function"); return 0 }
    scope_type := c.body.locals.types[cap]; workspace := ft.type_base(&c.types, scope_type)
    has_shared := ft.type_count(&c.types, scope_type) == 1
    count := c.world.param_counts[worker]; first := c.world.param_starts[worker]
    if c.world.libraries[worker] != "" || c.world.unsafe_functions[worker] || (workspace == 0 && !has_shared && count != 1) {
        fail(&mut c, "spawn requires one safe by-value worker argument"); return 0
    }
    mut next := 1
    if workspace != 0 {
        if next >= count || ft.type_kind(&c.types, c.world.param_types[first + next]) != 5 ||
            ft.type_base(&c.types, c.world.param_types[first + next]) != workspace {
            fail(&mut c, "task worker requires a mutable parameter for this workspace"); return 0
        }
        next = next + 1
    }
    if has_shared {
        shared := ft.parameter_type(&c.types, ft.type_start(&c.types, scope_type))
        if next >= count || ft.type_kind(&c.types, c.world.param_types[first + next]) != 4 ||
            ft.type_base(&c.types, c.world.param_types[first + next]) != shared {
            fail(&mut c, "task worker requires a read-only parameter for this shared input"); return 0
        }
        next = next + 1
    }
    if count != next { fail(&mut c, "worker parameters must match its task scope"); return 0 }
    declared_input := c.world.param_types[c.world.param_starts[worker]]; input_kind := ft.type_kind(&c.types, declared_input)
    if input_kind == 5 { fail(&mut c, "task input cannot borrow mutable parent storage"); return 0 }
    mut input := declared_input; if input_kind == 4 { input = ft.type_base(&c.types, declared_input) }
    expect(&mut c, "("); consuming := eat(&mut c, "move")
    if consuming && input_kind == 4 { fail(&mut c, "move argument requires a consuming task parameter"); return 0 }
    actual := expression(&mut c, 0, input, &catalog, &mut inline_work, &mut model); same(&mut c, input, actual); expect(&mut c, ")")
    if input_kind != 4 {
        if ft.move_only(&c.types, input) && !is_fresh_owned(&c) && !consuming { fail(&mut c, "consuming task parameter requires 'move value' or a fresh owned expression"); return 0 }
        take_value(&mut c, input); _ := temporary(&mut c, input)
    }
    c.body.facts.needed.push(worker)
    if c.tasks.program {
        c.body.facts.workers.push(worker); c.body.facts.worker_tokens.push(worker_at)
    }
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[cap]))
        arm.task_call(&mut c.code, c.tasks.spawners[worker], .Spawn, c.world.returns[worker], worker, c.world.tokens.starts[at])
    }
    fc.clear_rvalue_place(&mut c.body.place)
    compound(&mut c, 22, c.world.returns[worker])
}
fn task_await_expression(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "await")
    consume := eat(&mut c, "!"); cap := task_capability(&mut c); expect(&mut c, "(")
    key := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
    if cap < 0 { return 0 }
    if ft.type_kind(&c.types, key) != 22 { fail(&mut c, "await requires a typed TaskID result key"); return 0 }
    result := ft.type_base(&c.types, key)
    if ft.move_only(&c.types, result) && !consume { fail(&mut c, "move-only task results require await!"); return 0 }
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[cap]))
        mut action: row.Task = .Await; if consume { action = .AwaitOnce }
        arm.task_call(&mut c.code, c.tasks.await_result, action, result, 0, c.world.tokens.starts[at])
        if is_pod(&c, result) { unbox_pod_to_stack(&mut c, result, at) }
    }
    fc.clear_rvalue_place(&mut c.body.place); temporary(&mut c, result)
}

fn peek(c: &Session) -> string { c.world.tokens.texts[c.body.cursor].clone() }
fn is(c: &Session, word: string) -> bool {
    kind := c.world.tokens.kinds[c.body.cursor]
    kind != .String && kind != .Rune && kind != .Byte && c.world.tokens.texts[c.body.cursor] == word
}
fn record_diag_error(c: &mut Session, code: string, start_off: i32, last_off: i32, message: string) {
    if c.suppress_diagnostics || c.discovering { return }
    c.has_errors = true
    diag.push_error(&mut c.diag_bag, code, start_off, last_off, message, -1, -1, "")
}
fn fail_span(c: &mut Session, code: string, start_off: i32, last_off: i32, message: string) {
    if !c.ok { return }
    c.ok = false; c.error = message.clone(); c.error_at = start_off; c.error_last = last_off; c.error_code = code.clone()
    record_diag_error(&mut c, code, start_off, last_off, message)
}
fn fail(c: &mut Session, message: string) {
    fail_span(&mut c, "", c.world.tokens.starts[c.body.cursor], -1, message)
}
fn set_error_at(c: &mut Session, offset: i32) {
    c.error_at = offset
    c.error_last = -1
    if c.suppress_diagnostics || c.discovering { return }
    mut i := c.diag_bag.items.len - 1
    while i >= 0 {
        if c.diag_bag.items[i].severity == .Error {
            c.diag_bag.items[i].start = offset
            c.diag_bag.items[i].last = -1
            return
        }
        i -= 1
    }
}
fn set_error_note(c: &mut Session, offset: i32, message: string) {
    c.error_note = message.clone()
    c.error_note_at = offset
    c.error_note_last = -1
    if !c.suppress_diagnostics && !c.discovering {
        diag.attach_note_last(&mut c.diag_bag, offset, -1, message)
    }
}
pub fn limit_reached(c: &Session) -> bool { diag.limit_reached(&c.diag_bag) }
pub fn has_errors(c: &Session) -> bool { !c.ok || c.has_errors || c.diag_bag.error_count > 0 }
fn first_bag_error(c: &Session, from: i32) -> i32 {
    for i in from..c.diag_bag.items.len {
        if c.diag_bag.items[i].severity == .Error { return i }
    }
    -1
}
fn backfill_primary_error(c: &mut Session, from: i32) {
    if c.error != "" { return }
    idx := first_bag_error(&c, from)
    if idx < 0 { return }
    item := &c.diag_bag.items[idx]
    c.error = item.message.clone()
    c.error_at = item.start
    c.error_last = item.last
    c.error_code = item.code.clone()
    c.error_note = item.note_message.clone()
    c.error_note_at = item.note_start
    c.error_note_last = item.note_last
}
fn instantiation_suffix(c: &Session) -> string {
    mut suffix := ""
    f := c.specializations.error_function
    if f >= 0 && f < c.specializations.function_instances.len {
        mut instance := c.specializations.function_instances[f]
        while instance >= 0 {
            suffix += "\n  instantiated at " + diagnostics.location_text(&c.sources, c.specializations.sites[instance])
            instance = c.specializations.parents[instance]
        }
    }
    suffix
}
fn finalize_diagnostics(c: &Session) -> []diag.RawDiagnostic {
    mut out: []diag.RawDiagnostic = []
    out.reserve(c.diag_bag.items.len)
    mut saw_error := false
    suffix := instantiation_suffix(&c)
    for i in 0..c.diag_bag.items.len {
        item := &c.diag_bag.items[i]
        generated := generics.generated(&c.specializations, item.start)
        start := generics.origin(&c.specializations, item.start)
        last := if item.last >= item.start && !generated { generics.origin(&c.specializations, item.last) } else { -1 }
        note_start := if item.note_start >= 0 { generics.origin(&c.specializations, item.note_start) } else { -1 }
        note_last := if item.note_last >= item.note_start && item.note_start >= 0 && !generics.generated(&c.specializations, item.note_start) { generics.origin(&c.specializations, item.note_last) } else { -1 }
        mut msg := item.message.clone()
        if item.severity == .Error {
            saw_error = true
            if suffix != "" && item.start == c.error_at && item.message == c.error {
                msg += suffix
            }
        }
        out.push(diag.RawDiagnostic {
            severity: item.severity,
            code: item.code.clone(),
            start: start,
            last: last,
            message: move msg,
            note_start: note_start,
            note_last: note_last,
            note_message: item.note_message.clone(),
        })
    }
    if (!c.ok || c.has_errors) && !saw_error && c.error != "" {
        start := generics.origin(&c.specializations, c.error_at)
        generated := generics.generated(&c.specializations, c.error_at)
        last := if c.error_last >= c.error_at && !generated { generics.origin(&c.specializations, c.error_last) } else { -1 }
        note_start := if c.error_note_at >= 0 { generics.origin(&c.specializations, c.error_note_at) } else { -1 }
        note_last := if c.error_note_last >= c.error_note_at && c.error_note_at >= 0 && !generics.generated(&c.specializations, c.error_note_at) { generics.origin(&c.specializations, c.error_note_last) } else { -1 }
        mut msg := c.error.clone()
        if suffix != "" { msg += suffix }
        out.push(diag.RawDiagnostic {
            severity: .Error,
            code: if c.error_code != "" { c.error_code.clone() } else { diag.classify_error_code(c.error) },
            start: start,
            last: last,
            message: move msg,
            note_start: note_start,
            note_last: note_last,
            note_message: c.error_note.clone(),
        })
    }
    out
}
fn skip_token(c: &mut Session) {
    if c.body.cursor + 1 < c.world.tokens.texts.len { c.body.cursor = c.body.cursor + 1 }
}
fn advance(c: &mut Session) -> string { value := peek(&c); skip_token(&mut c); value }
fn eat(c: &mut Session, word: string) -> bool { if is(&c, word) { skip_token(&mut c); return true }; false }
fn expect(c: &mut Session, word: string) { if !eat(&mut c, word) { fail(&mut c, "expected '" + word + "'") } }
fn separators(c: &mut Session) {
    while c.ok {
        kind := c.world.tokens.kinds[c.body.cursor]
        if !lexer.is_newline(kind) && (kind != .Symbol || c.world.tokens.texts[c.body.cursor] != ";") { break }
        skip_token(&mut c)
    }
}
fn newlines(c: &mut Session) { while c.ok && lexer.is_newline(c.world.tokens.kinds[c.body.cursor]) { skip_token(&mut c) } }
fn check_type_error(c: &mut Session) {
    if c.types.error != "" { fail(&mut c, c.types.error.clone()); c.types.error = "" }
}
fn add_type(c: &mut Session, name: string, kind: i32, base: i32) -> i32 {
    ft.add_type(&mut c.types, name, kind, base)
}
fn scalar_element(c: &Session, ty: i32) -> bool { ft.scalar_element(&c.types, ty) }
fn scalar_bytes(c: &Session, ty: i32) -> i32 { ft.scalar_bytes(&c.types, ty, c.code.platform) }
fn compound(c: &mut Session, kind: i32, base: i32) -> i32 {
    ty := type_reader.compound(&mut c.types, kind, base); check_type_error(&mut c); ty
}
fn collection(c: &Session, ty: i32) -> bool { ft.collection(&c.types, ty) }
fn length_literal(c: &mut Session) -> i32 {
    if c.world.tokens.kinds[c.body.cursor] == .Name {
        v := c.types.const_lengths.get_or(peek(&c), -1)
        if v >= 0 && v <= 1048576 { _ := advance(&mut c); return i32(v) }
    }
    if c.world.tokens.kinds[c.body.cursor] != .Integer { fail(&mut c, "expected nonnegative array length"); return 0 }
    length := rules.literal_integer(advance(&mut c))
    if !length.ok || length.value < 0 || length.value > 1048576 { fail(&mut c, "array length out of range"); return 0 }
    i32(length.value)
}
fn fixed(c: &mut Session, base: i32, length: i32) -> i32 {
    ty := type_reader.fixed(&mut c.types, c.code.platform, base, length); check_type_error(&mut c); ty
}
fn type_id(c: &Session, name: string) -> i32 { ft.type_id(&c.types, name) }
fn resolve_type_name(c: &Session, name: string) -> i32 {
    if name == "Self" { return c.types.self_type }
    type_id(&c, name)
}
fn foreign_type(c: &mut Session, args: &[]i32, result: i32) -> i32 { callable_type(&mut c, &args, result, 8) }
fn foreign_variadic_type(c: &mut Session, args: &[]i32, result: i32, fixed: i32) -> i32 {
    if fixed < 0 { return foreign_type(&mut c, &args, result) }
    if c.code.platform == 3 { fail(&mut c, "C variadic declarations require a native target"); return 0 }
    callable_with_parameter(&mut c, &args, result, 8, fixed)
}
fn callable_type(c: &mut Session, args: &[]i32, result: i32, kind: i32) -> i32 {
    callable_with_parameter(&mut c, &args, result, kind, -1)
}
fn callable_with_parameter(c: &mut Session, args: &[]i32, result: i32, kind: i32, parameter: i32) -> i32 {
    ty := type_reader.callable(&mut c.types, &args, result, kind, parameter); check_type_error(&mut c); ty
}
fn result_parameter(c: &mut Session, args: &[]i32, result: i32, first_name: i32) -> i32 {
    result_kind := ft.type_kind(&c.types, result)
    if result_kind != 4 && result_kind != 5 {
        if first_name >= 0 && is(&c, "from") { fail(&mut c, "only a returned borrow can specify a source parameter") }
        return -1
    }
    if is(&c, "from") && (first_name >= 0 || c.world.tokens.kinds[c.body.cursor + 1] != .Name) {
        skip_token(&mut c)
        at := c.body.cursor
        if first_name < 0 {
            if c.world.tokens.kinds[at] != .Integer { fail(&mut c, "expected a one-based source parameter number after 'from'"); return -1 }
            number := rules.literal_integer(advance(&mut c))
            if number.ok && number.value >= 1 && number.value <= i64(args.len) { return i32(number.value) - 1 }
            fail(&mut c, "returned borrow source parameter number is out of range")
        } else {
            if c.world.tokens.kinds[at] != .Name { fail(&mut c, "expected a source parameter name after 'from'"); return -1 }
            name := advance(&mut c)
            for i in 0..args.len { if c.world.param_names[first_name + i] == name { return i } }
            fail(&mut c, "unknown returned borrow source parameter '" + name + "'")
        }
        set_error_at(&mut c, c.world.tokens.starts[at]); return -1
    }
    source := type_reader.borrow_source_for(&mut c.types, &args, result_kind == 5); check_type_error(&mut c); source
}
fn parameter_mode(c: &mut Session, ty: i32, consume: bool, foreign: bool) -> i32 {
    mode := type_reader.parameter_mode(&mut c.types, ty, consume, foreign); check_type_error(&mut c); mode
}
fn type_name(c: &mut Session) -> i32 {
    if !c.ok { return 0 }
    at := c.body.cursor
    if c.world.tokens.kinds[at] == .Name {
        named := resolve_type_name(&c, c.world.tokens.texts[at])
        if named >= 0 { skip_token(&mut c); return named }
    }
    tokens := replace(&mut c.world.tokens, lexer.empty(false))
    mut input := syntax.cursor(at, tokens.kinds.len - 1)
    platform := c.code.platform
    ty := type_reader.read(&mut input, &mut c.types, &tokens, platform)
    c.world.tokens = move tokens
    c.body.cursor = input.at
    if input.error != "" { c.body.cursor = input.error_at; fail(&mut c, input.error) }
    check_type_error(&mut c); ty
}
// Register concrete aggregate types from annotations and qualified constructors
// before workers receive the immutable declaration registry.
fn prepare_structural_types(c: &mut Session) {
    prev_sup := c.suppress_diagnostics
    c.suppress_diagnostics = true
    for f in 0..c.world.names.len {
        c.types.self_type = c.world.impl_types[f]
        for at in c.world.starts[f]..c.world.ends[f] {
            kind := c.world.tokens.kinds[at]
            if kind == .Symbol && c.world.tokens.texts[at] == ":" {
                next := c.world.tokens.texts[at + 1].clone()
                if next != "(" && next != "[" && next != "&" && next != "fn" && next != "Fn" && next != "FnMut" && next != "FnOnce" && next != "extern" && next != "TaskID" { continue }
                c.body.cursor = at + 1
                _ := type_name(&mut c)
            } else { continue }
            if !c.ok {
                // A field initializer or a comparison can resemble a type.
                c.ok = true; c.error = ""; c.error_at = 0; c.error_note = ""; c.error_note_at = -1
            }
        }
    }
    c.suppress_diagnostics = prev_sup
    c.types.self_type = -1
    ft.finish_tuples(&mut c.types)
}
fn fail_immutable_binding(c: &mut Session, message: string, base: i32) {
    had_error := !c.ok
    fail(&mut c, message)
    if had_error || base < 0 || base >= c.body.locals.names.len || c.error_note != "" { return }
    name := c.body.locals.names[base].clone()
    decl_tok := c.body.locals.tokens[base]
    decl_off := if decl_tok >= 0 && decl_tok < c.world.tokens.starts.len { c.world.tokens.starts[decl_tok] } else { -1 }
    ty := c.body.locals.types[base]
    mut note := ""
    if fc.pattern_loan(&c.body, base) {
        note = with_clone_hint(&c, ty, "pattern binding '" + name + "' borrows from the match subject; match with 'move'", " or clone") + " to mutate it"
    } else if ft.type_kind(&c.types, ty) == 4 {
        note = "'" + name + "' is a shared borrow ('" + ft.type_spelling(&c.types, ty) + "') declared"
    } else {
        note = "'" + name + "' was declared immutable (add 'mut' to make it mutable)"
    }
    set_error_note(&mut c, decl_off, note)
}
fn note_callable_mismatch(c: &mut Session, expected: i32, actual: i32) {
    if expected == 0 || expected == actual || c.error_note != "" { return }
    ekind := ft.type_kind(&c.types, expected)
    akind := ft.type_kind(&c.types, actual)
    if ekind == 9 && (ft.is_closure_kind(akind) || ft.is_borrowed_closure(&c.types, actual)) {
        set_error_note(&mut c, -1, "capturing closures cannot convert to raw function pointers 'fn(...)'; use 'Fn(...)', '&Fn(...)', or '&mut FnMut(...)'")
    } else if ft.is_closure_kind(ekind) && ft.is_borrowed_closure(&c.types, actual) {
        set_error_note(&mut c, -1, "borrowed closure cannot escape into an owned closure type (it may borrow local stack variables)")
    }
}
fn same(c: &mut Session, expected: i32, actual: i32) {
    if expected == actual { return }
    if !c.ok { return }
    msg := "type mismatch: expected " + ft.type_spelling(&c.types, expected) + ", got " + ft.type_spelling(&c.types, actual)
    if c.body.last_expr_start >= 0 && c.body.last_expr_end >= c.body.last_expr_start &&
        c.body.last_expr_end < c.body.cursor && c.body.cursor - c.body.last_expr_end <= 2 {
        start_off := c.world.tokens.starts[c.body.last_expr_start]
        last_off := c.world.tokens.starts[c.body.last_expr_end]
        fail_span(&mut c, "E3001", start_off, last_off, msg)
    } else {
        fail_span(&mut c, "E3001", c.world.tokens.starts[c.body.cursor], -1, msg)
    }
    note_callable_mismatch(&mut c, expected, actual)
}
fn field(c: &Session, ty: i32, name: string) -> i32 { ft.field(&c.types, ty, name) }
fn load_mem(c: &mut Session, destination: i32, base: i32, offset: i32) { arm.load_mem(&mut c.code, destination, base, offset) }
fn store_mem(c: &mut Session, source: i32, base: i32, offset: i32) { arm.store_mem(&mut c.code, source, base, offset) }
fn save_address(c: &mut Session, id: i32, token: i32) {
    mut home := places.address(c.body.places.arena.nodes[3 * (id - 1)])
    if home < 0 {
        home = slot(&mut c); if !c.ok { return }
        places.save_home(&mut c.body.places.arena, id, home)
    }
    c.body.place.inline_storage = false; c.body.place.direct = false; c.body.place.address = home
    bound_place(&mut c, .Temporary, id, i32(place_op.Temporary.SaveAddress), token)
}
fn place_address(c: &mut Session, id: i32, direct: bool, token: i32) {
    mut op := place_op.Op.BorrowSaved; if direct { op = .BorrowHome }
    bound_place(&mut c, op, id, i32(borrows.Access.Address), token)
}
fn place_step(c: &mut Session, op: place_op.Op, ty: i32, access: i32, form: i32, parameter: i32, token: i32) {
    arm.place_emit_op(&mut c.code, op, ty, access, form, parameter, c.world.tokens.starts[token])
}
fn read_shape(c: &Session, ty: i32, packed: bool) -> i32 {
    storage := storage_type(&c, ty)
    mut form := unsigned.shift(storage)
    if packed {
        width := ft.foreign_width(storage)
        form = 0; while i32(1).shl(form) < width { form = form + 1 }
    }
    if (packed && ty == 1) || (!packed && storage == 1) { form = 4 }
    form
}
fn bound_place(c: &mut Session, op: place_op.Op, place: i32, access: i32, token: i32) {
    if c.code.checking && !c.code.prefixing { return }
    source := c.world.tokens.starts[token]
    row := place_op.bound_header(op, place, access, source)
    arm.operand(&mut c.code, row)
    if place_op.wide(row) { arm.operand(&mut c.code, place_op.location(0, source)) }
}
fn place_transfer(c: &mut Session, ty: i32, reg: i32, base: i32, load: bool, packed: bool, access: i32, token: i32) {
    mut form := read_shape(&c, ty, packed); if !load && form == 4 { form = 2 }
    mut op := place_op.Op.Write; if load { op = .Read }
    place_step(&mut c, op, ty, access, form, base * 32 + reg, token)
}
fn closure_signature(c: &mut Session, sig: i32, kind: i32) -> i32 {
    first := ft.type_start(&c.types, sig); count := ft.type_count(&c.types, sig)
    ret := ft.type_base(&c.types, sig); source := ft.return_borrow_parameter(&c.types, sig)
    mut params: []i32 = []; params.reserve(count)
    for i in 0..count { params.push(ft.parameter_type(&c.types, first + i)) }
    callable_with_parameter(&mut c, &params, ret, kind, source)
}
fn prepare_closures(c: &mut Session) {
    c.closure_header = type_id(&c, closures.header())
    if c.closure_header < 0 || c.types.sealed { return }
    // Pre-register closure callable variants before ft.seal() so parallel workers
    // resolve all bindings and coercions from the shared declared type registry.
    for f in 0..c.world.ffi_types.len {
        last := c.world.param_starts[f] + c.world.param_counts[f] - 1
        if c.world.param_counts[f] > 0 && c.world.param_names[last] == "__dunder_module_env" {
            sig := c.world.ffi_types[f]
            c_fn := closure_signature(&mut c, sig, 11)
            c_mut := closure_signature(&mut c, sig, 12)
            _ := closure_signature(&mut c, sig, 13)
            _ := compound(&mut c, 4, c_fn)
            _ := compound(&mut c, 5, c_mut)
        }
    }
    n_decl := c.types.declared.type_kinds.len
    for ty in 0..n_decl {
        if ft.is_dunder_callable_kind(c.types.declared.type_kinds[ty]) {
            c_fn := closure_signature(&mut c, ty, 11)
            c_mut := closure_signature(&mut c, ty, 12)
            _ := closure_signature(&mut c, ty, 13)
            _ := compound(&mut c, 4, c_fn)
            _ := compound(&mut c, 5, c_mut)
        }
    }
}
fn owned(c: &Session, ty: i32) -> bool { ft.owned(&c.types, ty) }
fn is_pod(c: &Session, ty: i32) -> bool { ft.is_pod_struct(&c.types, ty) }
fn frame_owned(c: &Session, ty: i32) -> bool { owned(&c, ty) && !is_pod(&c, ty) }
fn alloc_pod_buffer(c: &mut Session, ty: i32) -> i32 {
    count := ft.type_count(&c.types, ty)
    for _ in 0..(count - 1) { _ := slot(&mut c) }
    slot(&mut c)
}
fn copy_pod_to_stack(c: &mut Session, ty: i32, token: i32) -> i32 {
    base := alloc_pod_buffer(&mut c, ty)
    arm.mov(&mut c.code, 1, 0); place_step(&mut c, .BorrowHome, ty, i32(borrows.Access.Address), 0, base, token)
    place_step(&mut c, .RegionWrite, ty, i32(borrows.Access.Address), 0, ft.type_count(&c.types, ty), token)
    base
}
fn copy_pod_into_addr(c: &mut Session, ty: i32, dst_slot: i32, token: i32) {
    arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, dst_slot)
    place_step(&mut c, .RegionWrite, ty, i32(borrows.Access.Address), 0, ft.type_count(&c.types, ty), token)
}
fn box_pod_for_container(c: &mut Session, ty: i32) {
    label := type_helper(&mut c, ty, false); ownership_call(&mut c, .Copy, ty, label)
}
fn unbox_pod_to_stack(c: &mut Session, ty: i32, token: i32) {
    box := slot(&mut c); arm.store(&mut c.code, box, 0)
    _ := copy_pod_to_stack(&mut c, ty, token)
    arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, box); drop_value(&mut c, ty); arm.pop_temp(&mut c.code, 0)
}
fn take_value_boxed(c: &mut Session, ty: i32) {
    if c.body.expr.untyped_exit && !ownership.falls_through(&c.body.ownership) {
        fc.clear_expr(&mut c.body.expr); return
    }
    if is_pod(&c, ty) { box_pod_for_container(&mut c, ty); fc.clear_expr_value(&mut c.body.expr); return }
    take_value(&mut c, ty)
}
fn require_cleanup(c: &mut Session, ty: i32) {
    if !c.types.has_cleanup || c.validating_dead || !ft.owned(&c.types, ty) || ty == 4 { return }
    mut pending: []i32 = [ty]
    mut seen: []i32 = []
    while pending.len > 0 {
        current := pending.pop()
        if current == 4 || !ft.owned(&c.types, current) { continue }
        mut visited := false
        for prior in &seen { if prior == current { visited = true; break } }
        if visited { continue }
        seen.push(current)
        hook := ft.cleanup_method(&c.types, current)
        if hook >= 0 {
            c.body.facts.needed.push(hook)
            task_edge(&mut c, hook, c.world.tokens.starts[c.body.cursor])
        }
        kind := ft.type_kind(&c.types, current)
        if collection(&c, current) {
            pending.push(ft.type_base(&c.types, current))
        } else if kind == 2 || kind == 7 {
            first := ft.type_start(&c.types, current)
            for member in first..first + ft.type_count(&c.types, current) {
                if kind == 2 {
                    pending.push(c.types.field_types[member])
                } else {
                    start := c.types.payload_starts[member]
                    for p in start..start + c.types.payload_counts[member] { pending.push(c.types.payload_types[p]) }
                }
            }
        }
    }
}
fn bind_type_helpers(c: &mut Session) {
    if c.code.checking { return }
    c.array_helpers = arm.label(&mut c.code)
    for _ in 1..4 { _ := arm.label(&mut c.code) }
    for ty in 0..c.types.declared.type_kinds.len {
        mut label := -1
        if collection(&c, ty) {
            label = c.array_helpers
            if c.types.declared.type_bases[ty] == 4 { label = label + 2 }
        } else if ty != 4 && ft.owned(&c.types, ty) && !ft.is_closure_kind(ft.type_kind(&c.types, ty)) {
            label = arm.label(&mut c.code)
            _ := arm.label(&mut c.code)
        }
        c.helper_labels.push(label)
    }
}
fn type_helper(c: &mut Session, ty: i32, drop: bool) -> i32 {
    if c.code.checking { return -1 }
    mut label := c.array_helpers
    if ty < c.helper_labels.len { label = c.helper_labels[ty] }
    else {
        assert(collection(&c, ty))
        if ft.type_base(&c.types, ty) == 4 { label = label + 2 }
    }
    if drop { return label + 1 }
    label
}
fn owner_store(c: &mut Session, action: row.OwnerStore, ty: i32, index: i32) {
    if c.code.checking { return }
    source := c.world.tokens.starts[c.body.cursor]
    arm.owner_store(&mut c.code, action, ty, index, source)
}
fn ownership_call(c: &mut Session, action: row.Ownership, ty: i32, target: i32) {
    may_invalidate_operand(&mut c)
    if c.code.checking { return }
    mut source := 0
    if c.code.mir_capture { source = c.world.tokens.starts[c.body.cursor] }
    arm.ownership_call(&mut c.code, target, action, ty, source)
}
fn copy_value(c: &mut Session, ty: i32) {
    if ft.type_kind(&c.types, ty)==21 || ft.type_kind(&c.types, ty)==20 {fail(&mut c,"scratch values cannot escape the region");return}
    if is_pod(&c, ty) { _ := copy_pod_to_stack(&mut c, ty, c.body.cursor); return }
    kind := ft.type_kind(&c.types, ty)
    if ty == 4 || kind == 11 || (kind == 7 && !ft.move_only(&c.types, ty)) { ownership_call(&mut c, .Copy, ty, c.runtime.retain) }
    else if owned(&c, ty) { label := type_helper(&mut c, ty, false); ownership_call(&mut c, .Copy, ty, label) }
}
fn array_element_helpers(c: &mut Session, base: i32) {
    if c.code.checking || !owned(&c, base) { return }
    mut clone_label := c.runtime.retain
    bkind := ft.type_kind(&c.types, base)
    if base != 4 && bkind != 11 && !(bkind == 7 && !ft.move_only(&c.types, base)) && !ft.is_closure_kind(bkind) {
        clone_label = type_helper(&mut c, base, false)
    }
    drop_label := drop_target(&mut c, base)
    arm.push_temp(&mut c.code, 0)
    arm.branch(&mut c.code, clone_label, 20)
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 32)
    arm.push_temp(&mut c.code, 1)
    arm.branch(&mut c.code, drop_label, 20)
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 40)
    arm.mov(&mut c.code, 0, 1)
}
fn can_take(c: &Session, ty: i32) -> bool {
    if ty == 4 || ft.is_closure_kind(ft.type_kind(&c.types, ty)) || collection(&c, ty) || ft.type_kind(&c.types, ty) == 7 || ft.is_c_record(&c.types, ty) { return true }
    ft.type_kind(&c.types, ty) == 2 && !c.code.checking && ty < c.record_take_labels.len && c.record_take_labels[ty] >= -1
}
fn owner_path(c: &Session, place: i32) -> i32 { ownership_check.owner_path(&c.body, place) }
fn source_root(c: &Session, place: i32) -> i32 { ownership_check.source_root(&c.body, place) }
fn borrow_parent(c: &Session, place: i32) -> i32 { ownership_check.borrow_parent(&c.body, place) }
fn record_mutation(c: &mut Session, binding: i32, path: i32) { ownership_check.record_mutation(&mut c.body, binding, path) }
fn mutated_overlap(c: &Session, first: i32, last: i32, root: i32, path: i32) -> bool { ownership_check.mutated_overlap(&c.body, first, last, root, path) }
fn with_clone_hint(c: &Session, ty: i32, base: string, clone_suffix: string) -> string { ownership_check.with_clone_hint(&c.types, ty, base, clone_suffix) }
fn has_cleanup_ancestor(c: &Session, place: i32) -> bool { ownership_check.has_cleanup_ancestor(&c.body, &c.types, place) }
fn local_name_used_later(c: &Session, name: string, from: i32, limit: i32) -> bool { ownership_check.local_name_used_later(&c.world.tokens, name, from, limit) }
fn is_fresh_owned(c: &Session) -> bool { ownership_check.is_fresh_owned(&c.body) }
fn writable_loan(c: &mut Session, place: i32) -> bool {
    while true {
        loan := ownership_check.check_loan_step(&c.body, &c.world.tokens, place, false)
        if loan == -1 { return true }
        if loan >= 0 { local_borrows.release_local(&mut c.body.local_loans, loan); continue }
        fail(&mut c, "cannot mutate, replace or move a value while it is borrowed")
        return false
    }
    false
}
fn readable_loan(c: &mut Session, place: i32) -> bool {
    while true {
        loan := ownership_check.check_loan_step(&c.body, &c.world.tokens, place, true)
        if loan == -1 { return true }
        if loan >= 0 { local_borrows.release_local(&mut c.body.local_loans, loan); continue }
        fail(&mut c, "cannot read or borrow a value while it is mutably borrowed")
        return false
    }
    false
}
fn constrain_borrow(c: &mut Session) -> bool {
    if !c.loans.active { fail(&mut c, "scoped borrow analysis was not prepared"); return false }
    c.body.loan.constrained = true
    true
}
fn move_place(c: &mut Session, place: i32, ty: i32, at: i32) -> bool {
    while true {
        step := ownership_check.plan_move_step(&c.body, &c.world.tokens, &c.types, place, ty)
        if step.status == 1 { local_borrows.release_local(&mut c.body.local_loans, step.release_loan); continue }
        if step.status != 0 { fail(&mut c, step.error); return false }
        ownership_check.apply_move(&mut c.body, &step, at)
        return true
    }
    false
}
fn move_binding(c: &mut Session, binding: i32, ty: i32, at: i32) -> bool {
    move_place(&mut c, borrows.local_id(binding), ty, at)
}
fn take_value(c: &mut Session, ty: i32) {
    if c.body.expr.untyped_exit && !ownership.falls_through(&c.body.ownership) {
        fc.clear_expr(&mut c.body.expr); return
    }
    if is_pod(&c, ty) { _ := copy_pod_to_stack(&mut c, ty, c.body.cursor); fc.clear_expr_value(&mut c.body.expr); return }
    if ft.move_only(&c.types, ty) {
        if c.body.expr.const_array {
            copy_value(&mut c, ty); fc.clear_expr(&mut c.body.expr); return
        }
        if c.body.expr.owner >= 0 && c.body.expr.ty == ty {
            owner_store(&mut c, .Transfer, ty, c.body.expr.owner)
        } else {
            place := c.body.places.current; mut at := c.body.places.source; if at < 0 { at = c.body.cursor }
            if place < 0 {
                binding := borrows.root(&c.body.places, place)
                if !move_binding(&mut c, binding, ty, at) { return }
                owner_store(&mut c, .Transfer, ty, places.local_home(c.body.places.arena.locals[binding]))
                pl_idx := fc.pattern_loan_index(&c.body, binding)
                if pl_idx >= 0 {
                    arm.push_temp(&mut c.code, 0)
                    arm.load(&mut c.code, c.body.pattern_loans.parent_slots[pl_idx])
                    store_mem(&mut c, 31, 0, c.body.pattern_loans.offsets[pl_idx])
                    arm.pop_temp(&mut c.code, 0)
                }
            } else {
                mut address := c.body.expr.move_projection
                if place > 0 {
                    if borrows.has_index(&c.body.places, place) {
                        fail(&mut c, with_clone_hint(&c, ty, "cannot move out of an indexed element; use .pop()", " or .clone()"))
                        return
                    }
                    binding := borrows.root(&c.body.places, place)
                    if binding < 0 {
                        fail(&mut c, with_clone_hint(&c, ty, "cannot transfer this projection", "; use .clone()"))
                        return
                    }
                    lower_place(&mut c, place, 0, .ValueAndAddress, at)
                    if c.body.place.inline_storage {
                        if ty > 0 && ft.cloneable(&c.types, ty) { fail(&mut c, "inline C fields require .clone() when extracted") }
                        else { fail(&mut c, "cannot move out of inline C storage") }
                        return
                    }
                    address = c.body.place.address
                    if !move_place(&mut c, place, ty, at) { return }
                } else if c.body.expr.move_temporary < 0 || address < 0 || c.body.place.inline_storage {
                    fail(&mut c, with_clone_hint(&c, ty, "cannot move out of this borrowed or inline projection", "; use .clone()"))
                    return
                }
                arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, address)
                store_mem(&mut c, 31, 0, 0); arm.pop_temp(&mut c.code, 0)
            }
        }
        fc.clear_expr(&mut c.body.expr); return
    }
    if c.body.expr.owner >= 0 && c.body.expr.ty == ty && can_take(&c, ty) {
        if collection(&c, ty) { ownership_call(&mut c, .NormalizeTransfer, ty, c.array_take) }
        else if ft.type_kind(&c.types, ty) == 2 && ty < c.record_take_labels.len && c.record_take_labels[ty] >= 0 {
            ownership_call(&mut c, .NormalizeTransfer, ty, c.record_take_labels[ty])
        }
        owner_store(&mut c, .Transfer, ty, c.body.expr.owner)
    } else { copy_value(&mut c, ty) }
    fc.clear_expr_value(&mut c.body.expr)
}
fn take_inline(c: &mut Session, ty: i32) {
    if !ft.move_only(&c.types, ty) { return }
    if c.body.expr.const_array { fc.clear_expr(&mut c.body.expr); return }
    if c.body.expr.owner >= 0 && c.body.expr.ty == ty { return }
    place := c.body.places.current; mut at := c.body.places.source
    if at < 0 { at = c.body.cursor }
    if place != 0 {
        if borrows.has_index(&c.body.places, place) {
            fail(&mut c, with_clone_hint(&c, ty, "cannot move out of an indexed element; use .pop()", " or .clone()"))
            return
        }
        binding := borrows.root(&c.body.places, place)
        if binding >= 0 { _ := move_place(&mut c, place, ty, at); return }
    }
    if c.body.expr.move_temporary < 0 {
        fail(&mut c, with_clone_hint(&c, ty, "cannot move out of this borrowed or inline projection", "; use .clone()"))
    }
}
fn drop_target(c: &mut Session, ty: i32) -> i32 {
    if ft.is_closure_kind(ft.type_kind(&c.types, ty)) { return c.closure_drop }
    if ty == 4 { return c.runtime.release }
    if owned(&c, ty) { return type_helper(&mut c, ty, true) }
    -1
}
fn drop_value(c: &mut Session, ty: i32) {
    target := drop_target(&mut c, ty)
    if target >= 0 { ownership_call(&mut c, .Drop, ty, target) }
}
fn remember_owner(c: &mut Session, index: i32, ty: i32, temporary: bool) {
    if !temporary { require_cleanup(&mut c, ty) }
    c.body.owned_slots.push(index); c.body.owned_types.push(ty); c.body.owner_temps.push(temporary)
}
fn clear_owner_at(c: &mut Session, index: i32, ty: i32, source: i32) {
    target := drop_target(&mut c, ty)
    arm.load(&mut c.code, index)
    if target >= 0 {
        may_invalidate_operand(&mut c)
        arm.ownership_call(&mut c.code, target, .Clear, ty, source)
    }
    arm.owner_store(&mut c.code, .Vacate, ty, index, source)
}
fn emitting(c: &Session) -> bool { !c.code.checking }
fn clear_owner(c: &mut Session, index: i32, ty: i32) {
    if emitting(&c) { clear_owner_at(&mut c, index, ty, c.world.tokens.starts[c.body.cursor]) }
}
fn save_owner(c: &mut Session, index: i32, ty: i32, temporary: bool) {
    if !emitting(&c) { return }
    remember_owner(&mut c, index, ty, temporary)
    install_owner(&mut c, index, ty, c.world.tokens.starts[c.body.cursor])
}
fn install_owner(c: &mut Session, index: i32, ty: i32, source: i32) {
    if c.body.reenter_owners {
        arm.push_temp(&mut c.code, 0); clear_owner_at(&mut c, index, ty, source); arm.pop_temp(&mut c.code, 0)
    }
    arm.owner_store(&mut c.code, .Install, ty, index, source)
}
fn temporary(c: &mut Session, ty: i32) -> i32 {
    require_cleanup(&mut c, ty)
    fc.clear_expr_value(&mut c.body.expr)
    c.body.expr.untyped_exit = false
    fc.clear_loan_eval(&mut c.body.loan)
    if frame_owned(&c, ty) { index := slot(&mut c); save_owner(&mut c, index, ty, true); fc.produce_owner(&mut c.body.expr, index, ty) }
    ty
}
fn call_result(c: &mut Session, ty: i32) -> i32 {
    kind := ft.type_kind(&c.types, ty)
    if kind != 4 && kind != 5 { return temporary(&mut c, ty) }
    fc.clear_expr(&mut c.body.expr)
    ty
}
fn cleanup_from(c: &mut Session, first: i32, only_temps: bool) {
    mut i := c.body.owned_slots.len - 1
    while i >= first {
        if c.body.owned_slots[i] >= 0 && (!only_temps || c.body.owner_temps[i]) { clear_owner(&mut c, c.body.owned_slots[i], c.body.owned_types[i]) }
        i = i - 1
    }
}
fn stage_owner(c: &mut Session, kind: fc.PendingKind, home: i32, ty: i32, member: i32) {
    if c.code.checking { return }
    if kind == .Argument && !frame_owned(&c, ty) { return }
    if kind == .Field && !owned(&c, ty) { return }
    c.body.pending.slots.push(home); c.body.pending.kinds.push(kind)
    c.body.pending.types.push(ty); c.body.pending.members.push(member)
}
fn cleanup_pending(c: &mut Session, floor: i32) {
    if !c.ok || c.code.checking { return }
    mut i := c.body.pending.slots.len - 1
    while i >= floor {
        kind := c.body.pending.kinds[i]; ty := c.body.pending.types[i]
        arm.load(&mut c.code, c.body.pending.slots[i])
        if kind == .Storage {
            ownership_call(&mut c, .Drop, ty, c.runtime.release)
        } else if kind == .Array {
            if ty != 0 { array_element_helpers(&mut c, ty) }
            arm.branch(&mut c.code, c.runtime.array_drop, 1)
        } else {
            if kind == .Field { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), c.body.pending.members[i], c.body.cursor) }
            drop_value(&mut c, ty)
        }
        i = i - 1
    }
}
fn may_invalidate_operand(c: &mut Session) {
    if c.body.observing_lease { c.body.lease_generation = c.body.lease_generation + 1 }
}
fn skip_body(c: &mut Session) { expect(&mut c, "{"); c.body.cursor = c.world.closes[c.body.cursor - 1] + 1 }
fn foreign_scalar(c: &Session, ty: i32) -> bool { ft.foreign_scalar(&c.types, ty) }
fn opaque_access(c: &mut Session, ty: i32) {
    msg := resolve.opaque_access_msg(&c.types, c.body.current_owner, ty)
    if msg != "" { fail(&mut c, msg) }
}
fn parse_requires(c: &mut Session) -> i32 {
    mut cur := c.body.cursor
    res := resolve.parse_requires(&c.world.tokens, &mut cur)
    c.body.cursor = cur
    if !res.ok { fail(&mut c, res.error); return 0 }
    res.mask
}
fn check_function_caps(c: &mut Session, f: i32, token: i32) {
    msg := resolve.check_function_caps_msg(&c.world, c.body.current_owner, f)
    if msg == "" { return }
    fail(&mut c, msg)
    set_error_at(&mut c, c.world.tokens.starts[token])
}
fn impl_method(c: &Session, ty: i32, name: string) -> i32 {
    fc.find_method(&c.world, ty, name)
}
fn check_impl_access(c: &mut Session, f: i32, token: i32) -> bool {
    msg := resolve.check_impl_access_msg(&c.world, &c.types, c.body.current_owner, f)
    if msg == "" { return c.ok }
    fail(&mut c, msg)
    set_error_at(&mut c, c.world.tokens.starts[token])
    false
}
fn declaration_owner(c: &Session, offset: i32, starts: &[]i32, owners: &[]i32) -> i32 {
    resolve.declaration_owner(&c.world, &c.specializations, offset, &starts, &owners)
}
struct TraitMethodSig { has_self: bool, signature: i32 }
fn trait_generic_type(c: &mut Session, validating_trait: bool, sig_end: i32) -> i32 {
    family := advance(&mut c)
    expect(&mut c, "<")
    mut spec := family + "<"
    mut count := 0
    while c.ok && c.body.cursor < sig_end && !is(&c, ">") {
        if count > 0 { spec += ", " }
        arg_ty := type_name_in_trait(&mut c, validating_trait, sig_end)
        spec += ft.type_spelling(&c.types, arg_ty)
        count += 1
        if !eat(&mut c, ",") { break }
    }
    if c.ok { expect(&mut c, ">") }
    if !c.ok { return 0 }
    spec += ">"
    found := type_id(&c, spec)
    if found >= 0 { return found }
    if validating_trait { return c.types.self_type }
    -1
}
fn type_name_in_trait(c: &mut Session, validating_trait: bool, sig_end: i32) -> i32 {
    if !c.ok { return 0 }
    if is(&c, "&") {
        skip_token(&mut c)
        mut ref_kind := 4
        if eat(&mut c, "mut") { ref_kind = 5 }
        base := type_name_in_trait(&mut c, validating_trait, sig_end)
        return compound(&mut c, ref_kind, base)
    }
    if is(&c, "[") {
        skip_token(&mut c)
        if eat(&mut c, "]") {
            base := type_name_in_trait(&mut c, validating_trait, sig_end)
            return compound(&mut c, 1, base)
        }
        base := type_name_in_trait(&mut c, validating_trait, sig_end)
        expect(&mut c, ";")
        len := length_literal(&mut c)
        expect(&mut c, "]")
        return fixed(&mut c, base, len)
    }
    if is(&c, "(") {
        skip_token(&mut c)
        if eat(&mut c, ")") { return 0 }
        mut parts: []i32 = []
        while c.ok && c.body.cursor < sig_end && !is(&c, ")") {
            parts.push(type_name_in_trait(&mut c, validating_trait, sig_end))
            if !eat(&mut c, ",") { break }
        }
        expect(&mut c, ")")
        ty := ft.tuple_type(&mut c.types, &parts); check_type_error(&mut c); return ty
    }
    at := c.body.cursor
    if c.world.tokens.kinds[at] == .Name && at + 1 < sig_end &&
        c.world.tokens.kinds[at + 1] == .Symbol && c.world.tokens.texts[at + 1] == "<" {
        return trait_generic_type(&mut c, validating_trait, sig_end)
    }
    type_name(&mut c)
}
fn parse_trait_method_sig(c: &mut Session, sig_start: i32, sig_end: i32, self_ty: i32, validating_trait: bool) -> TraitMethodSig {
    saved_cursor := c.body.cursor; saved_self := c.types.self_type
    saved_names := c.world.param_names.len
    c.body.cursor = sig_start; c.types.self_type = self_ty
    mut has_self := false
    mut args: []i32 = []
    mut unresolved := false
    expect(&mut c, "(")
    while c.ok && !is(&c, ")") && c.body.cursor < sig_end {
        param_index := args.len
        mut is_mut := eat(&mut c, "mut")
        consuming := eat(&mut c, "move")
        if !is_mut && eat(&mut c, "mut") { is_mut = true }
        if !consuming && !is_mut && eat(&mut c, "&") {
            ref_mut := eat(&mut c, "mut")
            if !eat(&mut c, "self") { fail(&mut c, "expected 'self' after '&' in trait method receiver"); break }
            if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of a trait method"); break }
            has_self = true
            mut ref_kind := 4; if ref_mut { ref_kind = 5 }
            mode := compound(&mut c, ref_kind, self_ty)
            c.world.param_names.push("self"); args.push(mode)
        } else if is(&c, "&") {
            fail(&mut c, "cannot combine 'move' or 'mut' with '&' in trait method receiver"); break
        } else {
            if is(&c, "self") {
                _ := advance(&mut c)
                if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of a trait method"); break }
                has_self = true
                mut mode := parameter_mode(&mut c, self_ty, true, false)
                if eat(&mut c, ":") {
                    if is_mut { fail(&mut c, "cannot combine 'mut self' with an explicit ': Type'"); break }
                    pt := type_name_in_trait(&mut c, validating_trait, sig_end)
                    if pt < 0 { unresolved = true }
                    else if pt == self_ty { mode = parameter_mode(&mut c, pt, true, false) }
                    else if (ft.type_kind(&c.types, pt) == 4 || ft.type_kind(&c.types, pt) == 5) && ft.type_base(&c.types, pt) == self_ty {
                        if consuming { fail(&mut c, "move argument requires a consuming parameter"); break }
                        mode = parameter_mode(&mut c, pt, false, false)
                    } else { fail(&mut c, "self parameter must have type Self, &Self or &mut Self"); break }
                }
                c.world.param_names.push("self"); args.push(mode)
            } else {
                if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected parameter name in trait method"); break }
                pname := advance(&mut c); expect(&mut c, ":"); pt := type_name_in_trait(&mut c, validating_trait, sig_end)
                if pt < 0 { unresolved = true }
                mut mode := 0
                if pt >= 0 {
                    mode = parameter_mode(&mut c, pt, consuming, false)
                    if is_mut && (ft.type_kind(&c.types, mode) == 4 || ft.type_kind(&c.types, mode) == 5) {
                        fail(&mut c, "mutable parameter requires 'mut move' or '&mut'"); break
                    }
                }
                c.world.param_names.push(move pname); args.push(mode)
            }
        }
        if !eat(&mut c, ",") { break }
    }
    if c.ok { expect(&mut c, ")") }
    mut ret := 0
    if c.ok && eat(&mut c, "->") {
        ret = type_name_in_trait(&mut c, validating_trait, sig_end)
        if ret < 0 { unresolved = true }
    }
    mut signature := -1
    if c.ok {
        source := result_parameter(&mut c, &args, if ret < 0 { 0 } else { ret }, saved_names)
        if c.ok && c.body.cursor != sig_end { fail(&mut c, "unexpected token in trait method signature") }
        if c.ok && !unresolved { signature = callable_with_parameter(&mut c, &args, ret, 9, source) }
    }
    while c.world.param_names.len > saved_names { _ := c.world.param_names.pop() }
    c.body.cursor = saved_cursor; c.types.self_type = saved_self
    TraitMethodSig { has_self: has_self, signature: signature }
}
fn valid_trait_target(c: &Session, ty: i32) -> bool {
    resolve.valid_trait_target(&c.types, ty)
}
fn trait_display_name(name: string) -> string {
    resolve.trait_display_name(name)
}
fn parse_impl_target_at(c: &mut Session, target_tok: i32) -> i32 {
    if c.world.tokens.kinds[target_tok] == .Name {
        return type_id(&c, c.world.tokens.texts[target_tok])
    }
    saved := c.body.cursor
    c.body.cursor = target_tok
    ty := type_name(&mut c)
    c.body.cursor = saved
    ty
}
fn synthesize_trait_method(c: &mut Session, tid: i32, m: i32, target_ty: i32) -> i32 {
    saved_cursor := c.body.cursor; saved_self := c.types.self_type
    c.body.cursor = c.traits.method_sig_starts[m]; c.types.self_type = target_ty
    sig_end := c.traits.method_sig_ends[m]
    m_name := c.traits.method_names[m].clone()
    fn_id := c.world.names.len
    mut has_self := false; mut self_mut := false
    mut param_tokens: []i32 = []; mut param_names: []string = []; mut param_types: []i32 = []; mut param_mutable: []bool = []
    expect(&mut c, "(")
    while c.ok && !is(&c, ")") && c.body.cursor < sig_end {
        param_index := param_types.len
        mut is_mut := eat(&mut c, "mut")
        consuming := eat(&mut c, "move")
        if !is_mut && eat(&mut c, "mut") { is_mut = true }
        if !consuming && !is_mut && eat(&mut c, "&") {
            ref_mut := eat(&mut c, "mut")
            ptok := c.body.cursor
            if !eat(&mut c, "self") { fail(&mut c, "expected 'self' after '&' in trait method receiver"); break }
            if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of a trait method"); break }
            has_self = true
            mut ref_kind := 4; if ref_mut { ref_kind = 5 }
            mode := compound(&mut c, ref_kind, target_ty)
            param_tokens.push(ptok); param_names.push("self"); param_types.push(mode); param_mutable.push(false)
        } else if is(&c, "&") {
            fail(&mut c, "cannot combine 'move' or 'mut' with '&' in trait method receiver"); break
        } else {
            if is(&c, "self") {
                ptok := c.body.cursor; parameter := advance(&mut c)
                if param_index != 0 { fail(&mut c, "'self' parameter is only valid as the first parameter of a trait method"); break }
                has_self = true; self_mut = is_mut
                mut mode := parameter_mode(&mut c, target_ty, true, false)
                if eat(&mut c, ":") {
                    if is_mut { fail(&mut c, "cannot combine 'mut self' with an explicit ': Type'"); break }
                    pt := type_name_in_trait(&mut c, false, sig_end)
                    if pt < 0 { fail(&mut c, "unresolved type in synthesized trait method"); break }
                    if pt == target_ty { mode = parameter_mode(&mut c, pt, true, false) }
                    else if (ft.type_kind(&c.types, pt) == 4 || ft.type_kind(&c.types, pt) == 5) && ft.type_base(&c.types, pt) == target_ty {
                        if consuming { fail(&mut c, "move argument requires a consuming parameter"); break }
                        mode = parameter_mode(&mut c, pt, false, false)
                    } else { fail(&mut c, "self parameter must have type Self, &Self or &mut Self"); break }
                }
                param_tokens.push(ptok); param_names.push(move parameter); param_types.push(mode); param_mutable.push(is_mut)
            } else {
                if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected parameter name in trait method"); break }
                ptok := c.body.cursor; pname := advance(&mut c); expect(&mut c, ":"); pt := type_name_in_trait(&mut c, false, sig_end)
                if pt < 0 { fail(&mut c, "unresolved type in synthesized trait method"); break }
                mode := parameter_mode(&mut c, pt, consuming, false)
                if is_mut && (ft.type_kind(&c.types, mode) == 4 || ft.type_kind(&c.types, mode) == 5) {
                    fail(&mut c, "mutable parameter requires 'mut move' or '&mut'"); break
                }
                param_tokens.push(ptok); param_names.push(move pname); param_types.push(mode); param_mutable.push(is_mut)
            }
        }
        if !eat(&mut c, ",") { break }
    }
    if c.ok { expect(&mut c, ")") }
    mut ret := 0
    if c.ok && eat(&mut c, "->") {
        ret = type_name_in_trait(&mut c, false, sig_end)
        if ret < 0 { fail(&mut c, "unresolved return type in synthesized trait method") }
    }
    mut signature := 0
    if c.ok {
        if c.body.cursor != sig_end { fail(&mut c, "unexpected token in trait method signature") }
        first := c.world.param_names.len
        for i in 0..param_names.len {
            c.world.param_tokens.push(param_tokens[i])
            c.world.param_names.push(param_names[i].clone())
            c.world.param_types.push(param_types[i])
            c.world.param_mutable.push(param_mutable[i])
        }
        source := result_parameter(&mut c, &param_types, ret, first)
        signature = callable_with_parameter(&mut c, &param_types, ret, 9, source)
        if c.ok {
            c.world.function_owners.push(c.traits.owners[tid])
            c.world.test_functions.push(false)
            c.world.libraries.push(""); c.world.symbols.push("")
            c.world.unsafe_functions.push(c.traits.method_unsafe[m])
            c.world.impl_types.push(target_ty)
            c.world.impl_public.push(c.traits.public[tid])
            c.world.impl_has_self.push(has_self)
            c.world.impl_self_mut.push(self_mut)
            c.world.impl_names.push(m_name.clone())
            c.world.requires_caps.push(0)
            c.world.names.push(ft.type_spelling(&c.types, target_ty) + "::" + m_name)
            c.world.param_starts.push(first)
            c.world.param_counts.push(param_types.len)
            c.world.returns.push(ret)
            c.world.ffi_types.push(signature)
            c.world.starts.push(c.traits.method_body_starts[m])
            c.world.ends.push(c.traits.method_body_ends[m])
        }
    }
    c.body.cursor = saved_cursor; c.types.self_type = saved_self
    if !c.ok { return -1 }
    fn_id
}
fn activate_trait_impl(c: &mut Session, k: i32) -> bool {
    tid := c.traits.impl_trait_ids[k]
    target_ty := c.traits.impl_types[k]
    site := c.traits.impl_sites[k]
    fn_start := c.traits.impl_fn_starts[k]
    fn_count := c.traits.impl_fn_counts[k]
    if tid == traits.sendable_id() {
        if fn_count != 0 { fail_span(&mut c, "", site, -1, "Sendable is a marker trait and cannot contain methods"); return false }
        if !traits.record_conformance(&mut c.traits, tid, target_ty, k) {
            fail_span(&mut c, "", site, -1, "duplicate implementation of trait 'Sendable' for '" + ft.type_spelling(&c.types, target_ty) + "'"); return false
        }
        if target_ty < c.types.opaque_owner.len && c.types.opaque_owner[target_ty] >= 0 {
            c.types.opaque_sendable[target_ty] = true
            state := traits.compute_sendable(&c.types)
            if !traits.apply_sendable(&mut c.traits, move state) { fail_span(&mut c, "", site, -1, "internal Sendable metadata failure"); return false }
        }
        c.traits.impl_active[k] = true; return true
    }
    if tid == traits.storable_id() {
        if fn_count != 0 { fail_span(&mut c, "", site, -1, "Storable is a marker trait and cannot contain methods"); return false }
        if !ft.array_element(&c.types, target_ty) {
            fail_span(&mut c, "", site, -1, "type '" + ft.type_spelling(&c.types, target_ty) + "' cannot implement Storable"); return false
        }
        if !traits.record_conformance(&mut c.traits, tid, target_ty, k) {
            fail_span(&mut c, "", site, -1, "duplicate implementation of trait 'Storable' for '" + ft.type_spelling(&c.types, target_ty) + "'"); return false
        }
        c.traits.impl_active[k] = true; return true
    }
    if tid == traits.clone_id() || tid == traits.copy_id() {
        fail_span(&mut c, "", site, -1, "'" + c.traits.names[tid] + "' is a structural built-in trait and cannot be manually implemented")
        return false
    }
    if tid == traits.iterator_id() {
        if !traits.record_conformance(&mut c.traits, tid, target_ty, k) {
            fail_span(&mut c, "", site, -1, "duplicate implementation of trait 'Iterator' for '" + ft.type_spelling(&c.types, target_ty) + "'"); return false
        }
        mut next_fn := -1
        for i in fn_start..fn_start + fn_count {
            f := c.traits.impl_fns[i]
            m_name := c.world.impl_names[f].clone()
            if m_name != "next" {
                fail_span(&mut c, "", site, -1, "method '" + m_name + "' is not a member of trait 'Iterator'"); return false
            }
            if next_fn >= 0 {
                fail_span(&mut c, "", site, -1, "duplicate method 'next' in Iterator implementation"); return false
            }
            next_fn = f
        }
        if next_fn < 0 {
            fail_span(&mut c, "", site, -1, "missing trait method 'next' in Iterator implementation for '" + ft.type_spelling(&c.types, target_ty) + "'")
            return false
        }
        if c.world.unsafe_functions[next_fn] {
            fail_span(&mut c, "", site, -1, "Iterator::next must be safe"); return false
        }
        if !c.world.impl_has_self[next_fn] || c.world.param_counts[next_fn] != 1 {
            fail_span(&mut c, "", site, -1, "Iterator::next must take only '&mut self'"); return false
        }
        self_pt := c.world.param_types[c.world.param_starts[next_fn]]
        if ft.type_kind(&c.types, self_pt) != 5 || ft.type_base(&c.types, self_pt) != target_ty {
            fail_span(&mut c, "", site, -1, "Iterator::next receiver must be '&mut self'"); return false
        }
        ret_ty := c.world.returns[next_fn]
        if !ft.is_option(&c.types, ret_ty) {
            fail_span(&mut c, "", site, -1, "Iterator::next must return 'Option<T>'"); return false
        }
        c.world.impl_public[next_fn] = true
        if !fc.put_method(&mut c.world, target_ty, "next", next_fn) {
            fail_span(&mut c, "", site, -1, "duplicate method 'next' on type"); return false
        }
        c.traits.impl_active[k] = true
        return true
    }
    if !traits.record_conformance(&mut c.traits, tid, target_ty, k) {
        fail_span(&mut c, "", site, -1, "duplicate implementation of trait for '" + ft.type_spelling(&c.types, target_ty) + "'"); return false
    }
    // Check no extra methods
    for i in fn_start..fn_start + fn_count {
        f := c.traits.impl_fns[i]
        m_name := c.world.impl_names[f].clone()
        if !traits.has_method_name(&c.traits, tid, m_name) {
            fail_span(&mut c, "", site, -1, "method '" + m_name + "' is not a member of this trait"); return false
        }
    }
    // Check all required trait methods are present with exact matching signature
    m_start := c.traits.method_starts[tid]; m_count := c.traits.method_counts[tid]
    mut synth_fns: []i32 = []
    for m in m_start..m_start + m_count {
        req_name := c.traits.method_names[m].clone()
        expected := parse_trait_method_sig(&mut c, c.traits.method_sig_starts[m], c.traits.method_sig_ends[m], target_ty, false)
        if !c.ok { return false }
        mut found := -1
        for i in fn_start..fn_start + fn_count {
            f := c.traits.impl_fns[i]
            if c.world.impl_names[f] == req_name { found = f; break }
        }
        if found < 0 {
            if c.traits.method_body_starts[m] >= 0 {
                synth := synthesize_trait_method(&mut c, tid, m, target_ty)
                if synth < 0 { return false }
                synth_fns.push(synth)
                continue
            }
            fail_span(&mut c, "", site, -1, "missing trait method '" + req_name + "' in implementation for '" + ft.type_spelling(&c.types, target_ty) + "'")
            return false
        }
        mismatch := resolve.trait_method_mismatch_msg(&c.world, &c.types, req_name, found, expected.has_self, expected.signature, c.traits.method_unsafe[m])
        if mismatch != "" {
            fail_span(&mut c, "", site, -1, mismatch)
            return false
        }
    }
    // Register validated methods on target_ty
    for i in fn_start..fn_start + fn_count {
        f := c.traits.impl_fns[i]
        m_name := c.world.impl_names[f].clone()
        c.world.impl_public[f] = c.traits.public[tid]
        if !fc.put_method(&mut c.world, target_ty, m_name, f) {
            fail_span(&mut c, "", site, -1, "duplicate method '" + m_name + "' on type"); return false
        }
    }
    for f in &synth_fns {
        m_name := c.world.impl_names[f].clone()
        if !fc.put_method(&mut c.world, target_ty, m_name, f) {
            fail_span(&mut c, "", site, -1, "duplicate method '" + m_name + "' on type"); return false
        }
    }
    c.traits.impl_active[k] = true
    true
}
fn resolve_traits(c: &mut Session) {
    // 1. Validate user trait definitions: supertraits, cycles, method signatures
    for tid in traits.builtin_count()..c.traits.names.len {
        if !c.ok { return }
        s_start := c.traits.super_starts[tid]; s_count := c.traits.super_counts[tid]
        for s in s_start..s_start + s_count {
            tok := c.traits.super_tokens[s]
            sname := c.world.tokens.texts[tok].clone()
            sid := traits.lookup(&c.traits, sname)
            if sid < 0 { fail_span(&mut c, "", c.world.tokens.starts[tok], -1, "unknown supertrait '" + sname + "'"); return }
            c.traits.super_ids[s] = sid
        }
    }
    cycle := traits.has_super_cycle(&c.traits)
    if cycle >= 0 { fail_span(&mut c, "", c.traits.sites[cycle], -1, "cyclic trait supertrait inheritance"); return }
    for tid in traits.builtin_count()..c.traits.names.len {
        if !c.ok { return }
        m_start := c.traits.method_starts[tid]; m_count := c.traits.method_counts[tid]
        for m in m_start..m_start + m_count {
            _ := parse_trait_method_sig(&mut c, c.traits.method_sig_starts[m], c.traits.method_sig_ends[m], 1, true)
            if !c.ok { return }
        }
    }
    // 2. Resolve trait IDs, targets, coherence, and unconditional Sendable opt-ins
    for k in 0..c.traits.impl_trait_names.len {
        if !c.ok { return }
        tname := c.traits.impl_trait_names[k].clone()
        tid := traits.lookup(&c.traits, tname)
        site := c.traits.impl_sites[k]
        if tid < 0 { fail_span(&mut c, "", site, -1, "unknown trait '" + trait_display_name(tname) + "'"); return }
        target_tok := c.traits.impl_target_tokens[k]
        target_name := c.world.tokens.texts[target_tok].clone()
        target_ty := parse_impl_target_at(&mut c, target_tok)
        if !c.ok { return }
        if !valid_trait_target(&c, target_ty) {
            fail_span(&mut c, "", c.world.tokens.starts[target_tok], -1, "invalid trait implementation target '" + target_name + "'"); return
        }
        c.traits.impl_trait_ids[k] = tid; c.traits.impl_types[k] = target_ty
        prelude_gen := generics.generated(&c.specializations, site)
        if !prelude_gen {
            impl_owner := c.traits.impl_owners[k]
            trait_owner := c.traits.owners[tid]
            target_owner := if target_ty < c.types.type_owners.len { c.types.type_owners[target_ty] } else { -1 }
            if traits.is_builtin(tid) {
                if target_ty < 13 || target_owner != impl_owner {
                    fail_span(&mut c, "", site, -1, "cannot implement built-in trait '" + c.traits.names[tid] + "' for an imported or primitive type"); return
                }
            } else if trait_owner != impl_owner && (target_owner < 0 || target_owner != impl_owner) {
                fail_span(&mut c, "", site, -1, "cannot implement an imported trait for an imported or primitive type"); return
            }
        }
        if tid == traits.sendable_id() && !c.traits.impl_conditional[k] {
            if target_ty < c.types.opaque_owner.len && c.types.opaque_owner[target_ty] >= 0 {
                c.types.opaque_sendable[target_ty] = true
            }
        }
    }
    // 3. Initial Sendable analysis & activate unconditional impls
    initial_sendable := traits.compute_sendable(&c.types)
    if !traits.apply_sendable(&mut c.traits, move initial_sendable) { fail_span(&mut c, "", c.error_at, -1, "internal Sendable metadata failure"); return }
    for k in 0..c.traits.impl_trait_names.len {
        if !c.ok { return }
        if !c.traits.impl_conditional[k] {
            if !activate_trait_impl(&mut c, k) { return }
        }
    }
    // 4. Fixed-point activation of conditional trait impls
    mut changed := true
    while changed && c.ok {
        changed = false
        for k in 0..c.traits.impl_trait_names.len {
            if !c.traits.impl_conditional[k] || c.traits.impl_active[k] { continue }
            c_start := c.traits.impl_cond_starts[k]; c_count := c.traits.impl_cond_counts[k]
            mut satisfied := true
            for ci in c_start..c_start + c_count {
                arg_ty := c.traits.cond_types[ci]
                if !resolve.satisfies_trait_cond_method(&c.world, &c.traits, &c.types, arg_ty, c.traits.cond_traits[ci], c.traits.cond_methods[ci], c.traits.cond_sigs[ci]) {
                    satisfied = false; break
                }
            }
            if satisfied {
                if !activate_trait_impl(&mut c, k) { return }
                changed = true
            }
        }
    }
    // Mark methods of inactive conditional impls so dead-code checking ignores them.
    for k in 0..c.traits.impl_trait_names.len {
        if !c.traits.impl_active[k] {
            fn_start := c.traits.impl_fn_starts[k]; fn_count := c.traits.impl_fn_counts[k]
            for i in fn_start..fn_start + fn_count {
                c.world.impl_types[c.traits.impl_fns[i]] = -2
            }
        }
    }
    // 5. Verify Sendable proofs and supertraits on all activated trait impls
    final_sendable := traits.compute_sendable(&c.types)
    if !traits.apply_sendable(&mut c.traits, move final_sendable) { fail_span(&mut c, "", c.error_at, -1, "internal Sendable metadata failure"); return }
    for k in 0..c.traits.impl_trait_names.len {
        if !c.ok { return }
        if !c.traits.impl_active[k] { continue }
        tid := c.traits.impl_trait_ids[k]
        target_ty := c.traits.impl_types[k]
        if tid == traits.sendable_id() {
            if !traits.satisfies(&c.traits, &c.types, 0, target_ty) {
                fail_span(&mut c, "", c.traits.impl_sites[k], -1, "type '" + ft.type_spelling(&c.types, target_ty) + "' cannot implement Sendable: " + traits.sendable_reason(&c.traits, target_ty))
                return
            }
            continue
        }
        if traits.is_builtin(tid) { continue }
        s_start := c.traits.super_starts[tid]; s_count := c.traits.super_counts[tid]
        for s in s_start..s_start + s_count {
            sup := c.traits.super_ids[s]
            if !traits.satisfies(&c.traits, &c.types, sup, target_ty) {
                fail_span(&mut c, "", c.traits.impl_sites[k], -1, "trait implementation for '" + ft.type_spelling(&c.types, target_ty) + "' requires supertrait '" + trait_display_name(c.traits.names[sup].clone()) + "'")
                return
            }
        }
    }
}
fn eval_pending_const(c: &mut Session, cid: i32, ptypes: &[]i32, pexprs: &[]i32, pends: &[]i32, states: &mut []i32, site_tok: i32) -> bool {
    if states[cid] == 2 { return true }
    if states[cid] == 1 {
        c.body.cursor = site_tok
        fail(&mut c, "cyclic constant definition '" + diagnostics.display_symbol(&c.sources, c.world.const_names[cid].clone()) + "'")
        return false
    }
    states[cid] = 1
    saved_cursor := c.body.cursor
    mut expected := 0
    if ptypes[cid] >= 0 {
        mut scan := ptypes[cid]
        while scan < pexprs[cid] {
            if c.world.tokens.kinds[scan] == .Name && scan > ptypes[cid] && c.world.tokens.texts[scan - 1] == ";" {
                dep := i32(c.world.const_map.get_or(c.world.tokens.texts[scan], -1))
                if dep >= 0 && !eval_pending_const(&mut c, dep, &ptypes, &pexprs, &pends, &mut states, scan) {
                    return false
                }
            }
            scan = scan + 1
        }
        c.body.cursor = ptypes[cid]
        expected = type_name(&mut c)
        if !c.ok { return false }
        if !const_eval.scalar_value_type(expected) && expected != 4 &&
            !(collection(&c, expected) && const_eval.scalar_value_type(ft.type_base(&c.types, expected))) {
            c.body.cursor = ptypes[cid]
            fail(&mut c, "unsupported constant type '" + ft.type_spelling(&c.types, expected) + "'")
            return false
        }
    }
    mut val := const_eval.empty_val()
    mut p := pexprs[cid]
    while true {
        p = pexprs[cid]
        val = const_eval.eval_expr(&c.world, &c.types, &c.sources, c.code.platform, &states, &mut p, pends[cid], expected)
        if !val.ok && val.need_const >= 0 {
            if !eval_pending_const(&mut c, val.need_const, &ptypes, &pexprs, &pends, &mut states, val.error_tok) {
                return false
            }
            continue
        }
        break
    }
    if !val.ok {
        c.body.cursor = if val.error_tok >= 0 { val.error_tok } else { pexprs[cid] }
        fail(&mut c, val.error)
        return false
    }
    if p != pends[cid] {
        c.body.cursor = p
        fail(&mut c, "unexpected trailing token in constant expression")
        return false
    }
    mut final_ty := val.ty
    if val.kind == 2 && final_ty == 0 { final_ty = compound(&mut c, 1, val.arr_elem) }
    if expected != 0 {
        if val.kind == 2 && !collection(&c, expected) {
            c.body.cursor = pexprs[cid]
            fail(&mut c, "type mismatch: expected " + ft.type_spelling(&c.types, expected) + ", got constant array")
            return false
        }
        if expected != val.ty {
            c.body.cursor = pexprs[cid]
            fail(&mut c, "type mismatch: expected " + ft.type_spelling(&c.types, expected) + ", got " + ft.type_spelling(&c.types, val.ty))
            return false
        }
        final_ty = expected
    }
    if val.kind == 2 && ft.type_kind(&c.types, final_ty) == 6 && val.arr_ints.len != ft.type_count(&c.types, final_ty) {
        c.body.cursor = pexprs[cid]
        fail(&mut c, "constant fixed array length mismatch: expected " + ft.type_count(&c.types, final_ty).str() + ", got " + val.arr_ints.len.str())
        return false
    }
    c.world.const_types[cid] = final_ty
    c.world.const_kinds[cid] = val.kind
    if val.kind == 0 {
        c.world.const_ints[cid] = val.int_val
        if const_eval.int_type(final_ty) && !(unsigned.has(final_ty) && val.int_val < 0) && val.int_val >= 0 && val.int_val <= 1048576 {
            c.types.const_lengths.put(c.world.const_names[cid].clone(), val.int_val)
        }
    } else if val.kind == 1 {
        c.world.const_strings[cid] = val.str_val.clone()
    } else {
        c.world.const_ints[cid] = i64(val.arr_ints.len)
        first := c.world.const_blobs.len
        shift := unsigned.shift(storage_type(&c, val.arr_elem))
        stride := i32(1).shl(shift)
        for v in &val.arr_ints {
            mut bits := v
            for _ in 0..stride {
                c.world.const_blobs.push(u8(bits.bit_and(255)))
                bits = bits.shr(8)
            }
        }
        c.world.const_blob_starts[cid] = first
        c.world.const_blob_counts[cid] = c.world.const_blobs.len - first
    }
    states[cid] = 2
    c.body.cursor = saved_cursor
    true
}
fn headers(c: &mut Session, module_starts: &[]i32, module_files: &[]i32) {
    mut stack: []i32 = []
    for i in 0..c.world.tokens.kinds.len {
        if c.world.tokens.kinds[i] == .Symbol {
            if c.world.tokens.texts[i] == "{" { stack.push(i) }
            if c.world.tokens.texts[i] == "}" { if stack.len == 0 { fail(&mut c, "unexpected closing brace"); return }; open := stack.pop(); c.world.closes[open] = i }
        }
    }
    if stack.len != 0 { fail(&mut c, "unterminated body"); return }
    mut declarations: []i32 = []; mut declaration_types: []i32 = []
    mut declaration_fns: []i32 = []; mut declaration_impl_targets: []i32 = []; mut declaration_impl_owners: []i32 = []
    mut declaration_trait_impls: []i32 = []
    mut declaration_c_variadic: []i32 = []
    mut resource_types: []i32 = []; mut resource_methods: []i32 = []
    mut pending_const_type_toks: []i32 = []; mut pending_const_expr_toks: []i32 = []; mut pending_const_end_toks: []i32 = []
    mut matched_cond: []bool = []
    for _ in 0..c.specializations.conditional_impls.impl_types.len { matched_cond.push(false) }
    separators(&mut c)
    mut file_caps := 0
    if eat(&mut c, "capability") {
        while c.ok {
            tok := c.body.cursor
            kind := c.world.tokens.kinds[tok]
            word := c.world.tokens.texts[tok].clone()
            bit := if kind == .Name { modules.capability_bit(word) } else { 0 }
            if bit == 16 {
                if c.world.unsafe_capable { fail(&mut c, modules.duplicate_module_capability_message(word)); break }
                c.world.unsafe_capable = true
                skip_token(&mut c)
            } else if bit != 0 {
                if file_caps.bit_and(bit) != 0 { fail(&mut c, modules.duplicate_module_capability_message(word)); break }
                file_caps = file_caps.bit_or(bit)
                skip_token(&mut c)
            } else {
                fail(&mut c, modules.invalid_module_capability_message(kind, word)); break
            }
            if !eat(&mut c, ",") { break }
        }
        if c.ok {
            kind := c.world.tokens.kinds[c.body.cursor]
