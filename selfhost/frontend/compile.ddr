                if c_variadic >= 0 { fail(&mut c, "duplicate @c_variadic attribute"); break }
                expect(&mut c, "(")
                if c.world.tokens.kinds[c.body.cursor] != .Integer { fail(&mut c, "@c_variadic requires a nonnegative fixed parameter count"); break }
                parsed := rules.literal_integer(advance(&mut c))
                if !parsed.ok || parsed.value < 0 || parsed.value > 65535 { fail(&mut c, "invalid C variadic fixed parameter count"); break }
                c_variadic = i32(parsed.value); expect(&mut c, ")")
            } else if annotation == "c_layout" { layout = true }
            else if annotation == "resource" {
                if resource { fail(&mut c, "duplicate @resource attribute"); break }
                resource = true
