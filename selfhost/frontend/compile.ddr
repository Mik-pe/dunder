    }
    mut place := c.body.places.current; at := c.body.places.source
    while c.ok && c.world.tokens.kinds[c.body.cursor] == .Symbol {
        op_at := c.body.cursor; opcode := rules.opcode(c.world.tokens.texts[op_at])
        priority := rules.priority(opcode)
        if priority == 0 || priority < minimum { break }
        operator := c.world.tokens.texts[op_at].clone(); left_node := model.value
        lhs_place := place; lhs_at := if at >= 0 { at } else { first_token }
        place = 0; skip_token(&mut c); newlines(&mut c)
        observe := c.body.assert_operands.first == first_token && minimum == 0 && opcode >= 6 && opcode <= 11
        if opcode >= 6 && opcode <= 11 && !is_builtin_comparison(&c, ty, opcode) {
            mut val_ty := ty
            lhs_is_ref := ft.type_kind(&c.types, ty) == 4
            if lhs_is_ref { val_ty = ft.type_base(&c.types, ty) }
            is_eq := opcode == 6 || opcode == 7
            trait_sym := if is_eq { "__dunder_module_prelude_Eq" } else { "__dunder_module_prelude_Ord" }
            method_name := if opcode == 6 { "eq" } else if opcode == 7 { "ne" } else if opcode == 8 { "lt" } else if opcode == 9 { "le" } else if opcode == 10 { "gt" } else { "ge" }
            tid := traits.lookup(&c.traits, trait_sym)
            has_trait := tid >= 0 && traits.satisfies(&c.traits, &c.types, tid, val_ty)
            if !has_trait && c.discovering_compounds && (ft.type_kind(&c.types, val_ty) == 1 || ft.is_tuple(&c.types, val_ty)) {
                canonical := ft.canonical_spelling(&c.types, val_ty)
                if !c.known_compounds.contains(canonical) {
                    c.demanded_compounds.put(move canonical, 1)
