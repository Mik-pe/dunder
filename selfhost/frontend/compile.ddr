                c.body.expr.move_projection = projection_address; c.body.expr.move_temporary = temporary_root
                prim_str := name == "str" && ty >= 1 && ty <= 12
                impl_fn := if prim_str || is_gen_method_call { -1 } else { impl_method(&c, ty, name) }
                mut result := 0
                if impl_fn >= 0 {
                    result = method_impl(&mut c, impl_fn, ty, place, materialized, pending, at, temporary_root, projection_address, &catalog, &mut inline_work, &mut model)
                    pending = false
                } else {
                    gfn := generic_method_lookup(&c, ty, name, true)
                    if gfn >= 0 {
                        if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
                        result = try_generic_method_call(&mut c, gfn, ty, "", name, -1, method_tok, expected, true, &catalog, &mut inline_work, &mut model)
                    } else {
                        dummy := demand_compound_method(&mut c, ty, name)
                        if dummy >= 0 {
                            skip_balanced_parens(&mut c); result = dummy; pending = false
                        } else {
                            if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
                            result = method(&mut c, ty, name, place, at, &catalog, &mut inline_work, &mut model)
                        }
                    }
                }
                if c.body.stream_kind >= 10 || (c.body.stream_kind > 0 && is(&c, ".")) { ty = result }
                else { place = 0; ty = call_result(&mut c, result); temporary_root = c.body.expr.owner; projection_address = -1; fc.clear_rvalue_place(&mut c.body.place) }
            } else if name == "len" && (ty == 4 || collection(&c, ty) || ft.type_kind(&c.types, ty) == 21) {
                if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
                ty = length_value(&mut c, ty, c.body.cursor - 1); place = 0; fc.clear_rvalue_place(&mut c.body.place)
            } else if ft.type_kind(&c.types, ty) == 2 {
                if member < 0 {
                    if !fail_method_without_parens(&mut c, ty, name, c.body.cursor - 1) {
                        opaque_access(&mut c, ty)
                        fail(&mut c, "unknown field '" + name + "'")
                    }
                } else {
                    opaque_access(&mut c, ty)
                    if place == 0 {
                        if ft.cleanup_method(&c.types, ty) >= 0 { temporary_root = -1 }
                        projected := field_place(&mut c, 0, ty, member, c.body.cursor - 1)
                        ty = load_field(&mut c, ty, member, .ValueAndAddress, c.body.cursor - 1, projected)
                        projection_address = c.body.place.address
                    } else {
                        if !pending { materialized = place; pending = true }
                        place = field_place(&mut c, place, ty, member, c.body.cursor - 1)
                        ty = c.types.field_types[member]
                    }
                }
            } else if !fail_method_without_parens(&mut c, ty, name, c.body.cursor - 1) {
                fail(&mut c, "unknown member '" + name + "'")
            }
        }
    }
    if pending && c.ok {
        binding := borrows.root(&c.body.places, place)
        if place < 0 && ft.type_kind(&c.types, expected) == 4 && c.body.locals.types[binding] == expected {
            if !readable_loan(&mut c, place) { return 0 }
            arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[binding]))
            c.body.loan.path = owner_path(&c, place); c.body.loan.root = source_root(&c, place)
            c.body.loan.origin = loan_origin(&c, place); c.body.loan.parent = borrow_parent(&c, place)
            c.body.loan.constrained = local_borrows.path(&c.body.local_loans, binding) >= 0
            if ft.is_borrowed_closure(&c.types, expected) {
                mut cp: []i32 = []; mut cr: []i32 = []; mut ce: []bool = []; mut ct: []i32 = []
                if c.body.loan.path >= 0 {
                    cp.push(c.body.loan.path); cr.push(c.body.loan.root)
                    ce.push(local_borrows.is_exclusive(&c.body.local_loans, binding)); ct.push(at)
                }
                local_borrows.append_local_extra_loans(&c.body.local_loans, binding, &mut cp, &mut cr, &mut ce, &mut ct)
                c.body.loan.closure_paths = move cp; c.body.loan.closure_roots = move cr
                c.body.loan.closure_exclusives = move ce; c.body.loan.closure_tokens = move ct
            }
            fc.clear_rvalue_place(&mut c.body.place); ty = expected
        } else { lower_place(&mut c, place, materialized, place_access(&c), at) }
    }
    if !owned(&c, ty) { fc.clear_expr_value(&mut c.body.expr); projection_address = -1; temporary_root = -1 }
    c.body.expr.move_projection = projection_address; c.body.expr.move_temporary = temporary_root
    c.body.places.current = place; c.body.places.source = at
    c.body.depth = c.body.depth - 1; ty
}
fn fail_method_without_parens(c: &mut Session, ty: i32, name: string, tok: i32) -> bool {
    impl_fn := impl_method(&c, ty, name)
    if impl_fn >= 0 {
        if !c.world.impl_has_self[impl_fn] {
            fail(&mut c, "'" + name + "' is an associated function on '" + ft.type_spelling(&c.types, ty) + "', not a field; call '" + ft.type_spelling(&c.types, ty) + "::" + name + "(...)'")
        } else {
            fail(&mut c, "cannot access method '" + name + "' without calling it; use '." + name + "()'")
        }
        set_error_at(&mut c, c.world.tokens.starts[tok])
        return true
    }
    kind := ft.type_kind(&c.types, ty)
    mut is_builtin := name == "clone" && (ty == 4 || collection(&c, ty) || kind == 2 || kind == 3 || kind == 6 || kind == 7 || ft.is_dunder_callable_kind(kind))
    if !is_builtin && ty == 4 {
        is_builtin = name == "str" || name == "bytes" || name == "as_bytes" || name == "runes" || name == "slice"
    } else if !is_builtin && ty == 3 {
        is_builtin = name == "str"
    } else if !is_builtin && floats.has(ty) {
        is_builtin = name == "str" || name == "to_bits" || name == "is_sign_negative" || name == "abs" || name == "sqrt" ||
            name == "floor" || name == "ceil" || name == "round" || name == "round_ties_even" || name == "trunc" ||
            name == "is_nan" || name == "is_finite" || name == "is_infinite"
    } else if !is_builtin && (ty == 1 || ty == 2 || ty == 5 || unsigned.has(ty)) {
        is_builtin = name == "str" || integers.method(name) != .Unknown
    } else if !is_builtin && kind == 1 {
        is_builtin = name == "cap" || name == "swap" || name == "iter" || name == "push" || name == "reserve" ||
            name == "pop" || name == "remove" || name == "clear" || name == "truncate" || bundled.prelude_method(name)
    } else if !is_builtin && kind == 6 {
        is_builtin = name == "swap" || name == "iter" || bundled.prelude_method(name)
    } else if !is_builtin && ft.is_tuple(&c.types, ty) {
        is_builtin = bundled.prelude_method(name)
    }
    if is_builtin {
        fail(&mut c, "cannot access method '" + name + "' without calling it; use '." + name + "()'")
        set_error_at(&mut c, c.world.tokens.starts[tok])
        return true
    }
    false
}
fn enum_type(c: &Session, ty: i32) -> bool { ft.enum_type(&c.types, ty) }
fn extract_result(c: &mut Session, ty: i32, value: i32, box: i32, at: i32) {
    mut payload := -1
    if value != 0 {
        payload = slot(&mut c)
        arm.load(&mut c.code, box)
        place_step(&mut c, .Member, value, 0, i32(place_op.Member.Payload), 1, at)
        if is_pod(&c, value) { _ := copy_pod_to_stack(&mut c, value, at) }
        else if owned(&c, value) && !ft.move_only(&c.types, ty) { copy_value(&mut c, value) }
        arm.store(&mut c.code, payload, 0)
        if !is_pod(&c, value) && owned(&c, value) && ft.move_only(&c.types, ty) {
            arm.load(&mut c.code, box)
            store_mem(&mut c, 31, 0, 8)
        }
    }
    arm.load(&mut c.code, box)
    drop_value(&mut c, ty)
    if payload >= 0 { arm.load(&mut c.code, payload) }
}
fn propagate_result(c: &mut Session, ty: i32, question: i32) -> i32 {
    if !c.ok { return 0 }
    if ft.is_option(&c.types, ty) {
        if !ft.is_option(&c.types, c.body.ret_type) || c.body.in_defer {
            message := if c.body.in_defer { "'?' is not allowed inside defer" } else { "'?' on Option requires a function returning Option" }
            fail(&mut c, message)
            set_error_at(&mut c, c.world.tokens.starts[question]); return 0
        }
        take_value(&mut c, ty)
        if !c.ok { return 0 }
        inner := c.types.option_inner[ty]
        if c.code.checking { return temporary(&mut c, inner) }
        box := slot(&mut c); arm.store(&mut c.code, box, 0)
        place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Tag), 0, question)
        ok := new_block(&mut c)
        source_edge(&mut c, ok, .WhenFalse, question)
        continuing := ownership.checkpoint(&c.body.ownership)
        if ty == c.body.ret_type {
            arm.load(&mut c.code, box)
        } else {
            arm.load(&mut c.code, box); drop_value(&mut c, ty)
            source := c.world.tokens.starts[question]
            arm.allocate_value(&mut c.code, c.runtime.alloc, .EnumPayload, c.body.ret_type, 8, source)
            arm.enum_value(&mut c.code, 1, c.body.ret_type, 1, 1, source)
            place_step(&mut c, .Member, c.body.ret_type, i32(borrows.Access.Address), i32(place_op.Member.TagWrite), 0, question)
        }
        return_from_body(&mut c, question)
        ownership.restore_checkpoint(&mut c.body.ownership, &continuing)
        bind_block(&mut c, ok)
        extract_result(&mut c, ty, inner, box, question)
        return temporary(&mut c, inner)
    }
    if !ft.is_result(&c.types, ty) || !ft.is_result(&c.types, c.body.ret_type) {
        fail(&mut c, "'?' requires a Result operand and a function returning Result")
        set_error_at(&mut c, c.world.tokens.starts[question]); return 0
    }
    failure := c.types.result_failure[ty]
    if failure != c.types.result_failure[c.body.ret_type] || c.body.in_defer {
        message := if c.body.in_defer { "'?' is not allowed inside defer" } else { "'?' requires the same error type as the enclosing Result" }
        fail(&mut c, message)
        set_error_at(&mut c, c.world.tokens.starts[question]); return 0
    }
    take_value(&mut c, ty)
    if !c.ok { return 0 }
    success := c.types.result_success[ty]
    if c.code.checking { return temporary(&mut c, success) }
    box := slot(&mut c); arm.store(&mut c.code, box, 0)
    place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Tag), 0, question)
    ok := new_block(&mut c)
    source_edge(&mut c, ok, .WhenFalse, question)
    continuing := ownership.checkpoint(&c.body.ownership)
    if ty == c.body.ret_type {
        arm.load(&mut c.code, box)
    } else {
        extract_result(&mut c, ty, failure, box, question)
        if failure != 0 && is_pod(&c, failure) { box_pod_for_container(&mut c, failure) }
        if failure != 0 { arm.push_temp(&mut c.code, 0) }
        size := if failure == 0 { 8 } else { 16 }
        source := c.world.tokens.starts[question]
        arm.allocate_value(&mut c.code, c.runtime.alloc, .EnumPayload, c.body.ret_type, size, source)
        arm.enum_value(&mut c.code, 1, c.body.ret_type, 1, 1, source)
        place_step(&mut c, .Member, c.body.ret_type, i32(borrows.Access.Address), i32(place_op.Member.TagWrite), 0, question)
        if failure != 0 {
            arm.pop_temp(&mut c.code, 1)
            place_step(&mut c, .Member, failure, i32(borrows.Access.Address), i32(place_op.Member.Initialize), 1, question)
        }
    }
    return_from_body(&mut c, question)
    ownership.restore_checkpoint(&mut c.body.ownership, &continuing)
    bind_block(&mut c, ok)
    extract_result(&mut c, ty, success, box, question)
    temporary(&mut c, success)
}
fn enumeration(c: &mut Session, ty: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    name := advance(&mut c)
    if !enum_type(&c, ty) { fail(&mut c, "enum variant needs a type"); return 0 }
    found := field(&c, ty, name)
    if found < 0 { fail(&mut c, "unknown enum variant"); return ty }
    variant_at := c.body.cursor - 1; source := c.world.tokens.starts[variant_at]
    variant := found - ft.type_start(&c.types, ty)
    if ft.type_kind(&c.types, ty) == 3 {
        arm.enum_value(&mut c.code, 0, ty, variant, c.types.field_values[found], source); return ty
    }
    count := c.types.payload_counts[found]
    arm.allocate_value(&mut c.code, c.runtime.alloc, .EnumPayload, ty, (count + 1) * 8, source)
    index := slot(&mut c); arm.store(&mut c.code, index, 0); arm.enum_value(&mut c.code, 1, ty, variant, c.types.field_values[found], source)
    place_step(&mut c, .Member, ty, i32(borrows.Access.Address), i32(place_op.Member.TagWrite), 0, variant_at)
    pending := c.body.pending.slots.len
    stage_owner(&mut c, .Storage, index, ty, 0)
    if count > 0 {
        if !eat(&mut c, "(") {
            fail(&mut c, "variant '." + name + "' requires " + count.str() + " payload argument(s); write '." + name + "(...)'")
            set_error_at(&mut c, source); return ty
        }
        for i in 0..count {
            if i > 0 { expect(&mut c, ",") }
            payload_at := c.body.cursor; pt := c.types.payload_types[c.types.payload_starts[found] + i]
            actual := expression(&mut c, 0, pt, &catalog, &mut inline_work, &mut model)
            coerced := coerce_callable(&mut c, pt, actual, payload_at); same(&mut c, pt, coerced); take_value_boxed(&mut c, pt)
            arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, index)
            place_step(&mut c, .Member, pt, i32(borrows.Access.Address), i32(place_op.Member.Initialize), i + 1, payload_at)
            stage_owner(&mut c, .Field, index, pt, i + 1)
        }
        expect(&mut c, ")")
    }
    fc.finish_pending(&mut c.body.pending, pending)
    arm.load(&mut c.code, index); fc.clear_rvalue_place(&mut c.body.place); temporary(&mut c, ty)
}
fn new_block(c: &mut Session) -> i32 {
    if c.code.forbid_emit { return 0 }
    arm.label(&mut c.code) - c.body.block_base
}
fn bind_block(c: &mut Session, id: i32) { arm.mark(&mut c.code, c.body.block_base + id) }
fn source_edge(c: &mut Session, id: i32, action: row.Edge, token: i32) {
    arm.source_edge(&mut c.code, c.body.block_base + id, action, c.world.tokens.starts[token])
}
fn trap_edge(c: &mut Session, label: i32, action: row.Edge, token: i32) {
    arm.source_edge(&mut c.code, label, action, c.world.tokens.starts[token])
}
fn statement_separator(c: &Session, pos: i32) -> bool {
    lexer.is_newline(c.world.tokens.kinds[pos]) || c.world.tokens.kinds[pos] == .End ||
        c.world.tokens.texts[pos] == ";" || c.world.tokens.texts[pos] == "}"
}
fn assert_end(c: &Session, closing_paren: bool, pos: i32) -> bool {
    if closing_paren { return c.world.tokens.kinds[pos] == .Symbol && c.world.tokens.texts[pos] == ")" }
    statement_separator(&c, pos)
}
fn assert_operands(c: &Session, first: i32, closing_paren: bool) -> fc.AssertOperands {
    mut operands := fc.no_assert_operands()
    if c.code.checking || c.code.platform == 3 || !c.ok { return operands }
    operands.first = first; operands.closing_paren = closing_paren
    // Parentheses enclosing the entire condition do not change its root operator.
    while c.world.tokens.kinds[operands.first] == .Symbol && c.world.tokens.texts[operands.first] == "(" {
        after := lookahead.group_end(&c.world.tokens, &c.world.closes, operands.first, 0)
        if after >= c.world.tokens.kinds.len || !assert_end(&c, operands.closing_paren, after) { break }
        operands.first += 1; operands.closing_paren = true
    }
    operands
}
fn capture_assert_operands(c: &mut Session, ty: i32) {
    mut display := ty
    if ft.type_kind(&c.types, ty) == 3 { display = 1 }
    // A computed rune can be outside the Unicode scalar range.
    if ty == 5 { display = 2 }
    if ty == 13 { display = 12 }
    if display < 1 || display > 12 { return }
    left := slot(&mut c); right := slot(&mut c)
    arm.store(&mut c.code, left, 1); arm.store(&mut c.code, right, 0)
    c.body.assert_operands.ty = display; c.body.assert_operands.left = left; c.body.assert_operands.right = right
}
fn format_assert_operand(c: &mut Session, home: i32, ty: i32, source: i32) {
    arm.load(&mut c.code, home)
    if ty == 4 { return }
    if floats.has(ty) { format_float(&mut c, ty, source); return }
    mut target := c.runtime.string_integer
    if ty == 3 { target = c.runtime.string_bool }
    arm.intrinsic_call(&mut c.code, target, .Format, ty, 4, source)
}
fn assert_value(c: &mut Session, token: i32, first: i32, last: i32, operands: &fc.AssertOperands) {
    if !c.ok { return }
    if c.code.checking || c.code.platform == 3 {
        trap_edge(&mut c, c.assertion, .Assert, token); return
    }
    failed := arm.label(&mut c.code); done := arm.label(&mut c.code)
    trap_edge(&mut c, failed, .Assert, token)
    trap_edge(&mut c, done, .Jump, token)
    arm.mark(&mut c.code, failed)
    message := arm.label(&mut c.code)
    c.body.facts.assert_tokens.push(token); c.body.facts.assert_begins.push(first)
    c.body.facts.assert_ends.push(last); c.body.facts.assert_labels.push(message)
    source := c.world.tokens.starts[token]
    if operands.ty != 0 {
        format_assert_operand(&mut c, operands.left, operands.ty, source)
        arm.push_temp(&mut c.code, 0)
        format_assert_operand(&mut c, operands.right, operands.ty, source)
        arm.mov(&mut c.code, 2, 0); arm.pop_temp(&mut c.code, 1)
        arm.branch(&mut c.code, message, 20); arm.branch(&mut c.code, c.runtime.assert_values, 1)
    } else {
        arm.branch(&mut c.code, message, 20)
        arm.intrinsic_call(&mut c.code, c.runtime.assert_report, .Print, 4, 0, source)
    }
    trap_edge(&mut c, c.assertion, .Jump, token)
    arm.mark(&mut c.code, done)
}
fn arm_error(c: &mut Session, match_arm: bool, message: string) {
    if match_arm { fail(&mut c, "match arm " + message) } else { fail(&mut c, "if branch " + message) }
}
fn take_return_value(c: &mut Session, ty: i32, at: i32) {
    if !c.ok { return }
    kind := ft.type_kind(&c.types, ty)
    if kind != 4 && kind != 5 { take_value(&mut c, ty); return }
    if c.body.expr.untyped_exit && !ownership.falls_through(&c.body.ownership) { return }
    source := c.body.return_borrow_origin
    if source < 0 || c.body.loan.origin != source || c.body.loan.path < 0 || c.body.loan.root < 0 {
        mut message := "returned borrow must come from its declared shared parameter"
        if kind == 5 { message = "returned borrow must come from its declared mutable parameter" }
        if source >= 0 { message = message + " '" + c.world.param_names[source] + "'" }
        fail(&mut c, message)
        set_error_at(&mut c, c.world.tokens.starts[at])
    }
}
fn yield_value(c: &mut Session, ty: i32, home: i32, match_arm: bool, expected: i32) -> i32 {
    if !c.ok { return 0 }
    cty := coerce_callable(&mut c, expected, ty, c.body.cursor)
    if cty == 0 { arm_error(&mut c, match_arm, "must produce a value"); return 0 }
    kind := ft.type_kind(&c.types, cty)
    if (kind == 4 || kind == 5) && c.body.return_borrow_origin < 0 { arm_error(&mut c, match_arm, "cannot return a borrow"); return 0 }
    take_return_value(&mut c, cty, c.body.cursor)
    arm.store(&mut c.code, home, 0)
    cty
}
fn branch_value(c: &mut Session, expected: i32, home: i32, match_arm: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    if match_arm && !is(&c, "{") {
        if is(&c, "return") || is(&c, "break") || is(&c, "continue") {
            prev_tail := c.body.tail; c.body.tail = false
            enter(&mut c)
            _ := statement(&mut c, &catalog, &mut inline_work, &mut model)
            leave(&mut c)
            c.body.tail = prev_tail
            return 0
        }
        live := ownership.falls_through(&c.body.ownership)
        ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
        if (ty == 0 && c.body.expr.untyped_exit) || (live && !ownership.falls_through(&c.body.ownership)) { return 0 }
        return yield_value(&mut c, ty, home, match_arm, expected)
    }
    if !is(&c, "{") { fail(&mut c, "expected '{'"); return 0 }
    previous := c.body.value_block; end := c.world.closes[c.body.cursor]
    c.body.value_block = fc.ValueBlock { end: end, home: home, expected: expected, ty: 0, match_arm: match_arm }
    ends := block(&mut c, false, &catalog, &mut inline_work, &mut model)
    ty := c.body.value_block.ty
    c.body.value_block = previous
    if ends { return 0 }
    if c.ok && ty == 0 {
        arm_error(&mut c, match_arm, "must produce a value")
        set_error_at(&mut c, c.world.tokens.starts[end])
    }
    return ty
}
fn if_arms(c: &mut Session, expected: i32, home: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    done := new_block(&mut c)
    mut result := 0
    mut context := expected
    mut outcomes := ownership.empty_checkpoint()
    mut outcome_seen := false
    mut falling_through := false
    while c.ok {
        condition_at := c.body.cursor
        condition := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model)
        same(&mut c, 3, condition)
        before_arm := ownership.checkpoint(&c.body.ownership)
        otherwise := new_block(&mut c)
        source_edge(&mut c, otherwise, .WhenFalse, condition_at)
        ty := branch_value(&mut c, context, home, false, &catalog, &mut inline_work, &mut model)
        if ty != 0 {
            if result == 0 { result = ty; context = ty } else { same(&mut c, result, ty) }
        }
        accepted := ownership.checkpoint(&c.body.ownership)
        if outcome_seen { ownership.combine_checkpoints(&c.body.ownership, &mut outcomes, !falling_through, &accepted, ty == 0) }
        else { ownership.copy_checkpoint(&mut outcomes, &accepted); outcome_seen = true }
        falling_through = falling_through || ty != 0
        ownership.restore_checkpoint(&mut c.body.ownership, &before_arm)
        source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, otherwise)
        newlines(&mut c); expect(&mut c, "else")
        if !eat(&mut c, "if") { break }
    }
    if !c.ok { return 0 }
    last := branch_value(&mut c, context, home, false, &catalog, &mut inline_work, &mut model)
    if result == 0 { result = last } else if last != 0 { same(&mut c, result, last) }
    last_state := ownership.checkpoint(&c.body.ownership)
    ownership.combine_checkpoints(&c.body.ownership, &mut outcomes, !falling_through, &last_state, last == 0)
    ownership.restore_checkpoint(&mut c.body.ownership, &outcomes)
    bind_block(&mut c, done)
    result
}
fn choice_arms(c: &mut Session, expected: i32, home: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    if eat(&mut c, "if") { return if_arms(&mut c, expected, home, &catalog, &mut inline_work, &mut model) }
    expect(&mut c, "match")
    mut result := 0
    _ := match_arms(&mut c, expected, home, &mut result, &catalog, &mut inline_work, &mut model)
    result
}
struct ArrayIntegerPrefix { end: i32, default_type: i32 }
fn array_integer_prefix(c: &Session, first: i32) -> ArrayIntegerPrefix {
    mut pos := first; mut default_type := 1
    mut element := lookahead.IntegerElement { token: -1, end: -1, negative: false }
    while lookahead.integer_element(&c.world.tokens, pos, &mut element) {
        if default_type == 1 {
            mut spelling := c.world.tokens.texts[element.token].clone()
            if element.negative { spelling = "-" + spelling }
            mut number := rules.literal_integer(spelling)
            _ := rules.validate_signed(&mut number, 1)
            if !number.ok { default_type = 2 }
        }
        pos = element.end
        if c.world.tokens.texts[pos] != "," { break }
        pos += 1
    }
    ArrayIntegerPrefix { end: pos, default_type: default_type }
}
fn initialize_array_element(c: &mut Session, array: i32, ty: i32, source: i32) {
    arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, array); arm.pop_temp(&mut c.code, 1)
    arm.intrinsic_call(&mut c.code, c.runtime.array_push, .ArrayInitializeElement, ty, 0, source)
}
fn initialize_integer_prefix(c: &mut Session, array: i32, first: i32, last: i32, ty: i32,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    // The anchor is scalar and the prefix contains constants only. Hold the anchor
    // while filling the leading slots, so every nonliteral expression runs in source order.
    after := c.body.cursor; c.body.cursor = first
    arm.push_temp(&mut c.code, 0)
    mut count := 0
    while c.ok && c.body.cursor < last {
        token := c.body.cursor
        literal_type := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model)
        same(&mut c, ty, literal_type); expect(&mut c, ",")
        if !c.ok { set_error_at(&mut c, c.world.tokens.starts[token]); break }
        initialize_array_element(&mut c, array, ty, c.world.tokens.starts[token]); count += 1
    }
    c.body.cursor = after; arm.pop_temp(&mut c.code, 0)
    count
}
fn array_literal(c: &mut Session, token: i32, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    first := c.body.cursor
    mut base := 0
    mut default_type := 1
    if collection(&c, expected) { base = ft.type_base(&c.types, expected) }
    else {
        prefix := array_integer_prefix(&c, first)
        if prefix.end > first {
            default_type = prefix.default_type
            end := &c.world.tokens.texts[prefix.end]
            if end == "]" || end == ";" { base = default_type }
            else { c.body.cursor = prefix.end }
        }
    }
    anchor := c.body.cursor
    mut count := 0; mut repeated := false
    allocation := arm.position(&c.code); source := c.world.tokens.starts[token]
    arm.intrinsic_call(&mut c.code, c.runtime.array_new, .ArrayNew, base, expected, source)
    saved := slot(&mut c); arm.store(&mut c.code, saved, 0)
    pending := c.body.pending.slots.len
    stage_owner(&mut c, .Array, saved, base, 0)
    while c.ok && !is(&c, "]") {
        element := c.body.cursor; element_source := c.world.tokens.starts[element]
        mut ty := expression(&mut c, 0, base, &catalog, &mut inline_work, &mut model)
        if !c.ok { return 0 }
        if element == anchor && anchor > first {
            if c.body.expr.untyped_exit { ty = default_type }
            else { ty = read_scalar_result(&mut c, ty, element) }
            if ty != 1 && ty != 2 && !unsigned.has(ty) && !floats.has(ty) {
                same_or_coerce(&mut c, default_type, ty, element)
                return 0
            }
            count = initialize_integer_prefix(&mut c, saved, first, anchor, ty, &catalog, &mut inline_work, &mut model)
            if !c.ok { return 0 }
            if c.body.pending.slots.len > pending { c.body.pending.types[pending] = ty }
        }
        if base == 0 { base = ty } else { ty = coerce_callable(&mut c, base, ty, element); same(&mut c, base, ty) }
        if count == 0 && c.body.pending.slots.len > pending { c.body.pending.types[pending] = base }
        if count == 0 && eat(&mut c, ";") {
            repeated = true; count = length_literal(&mut c)
            if !ft.cloneable(&c.types, ty) { fail(&mut c, "resource values cannot be repeated or cloned"); return 0 }
            take_value(&mut c, ty)
            item := slot(&mut c); left := slot(&mut c)
            if frame_owned(&c, ty) { save_owner(&mut c, item, ty, true) } else { arm.store(&mut c.code, item, 0) }
            arm.imm(&mut c.code, 0, i64(count)); arm.store(&mut c.code, left, 0)
            head := arm.label(&mut c.code); done := arm.label(&mut c.code)
            arm.mark(&mut c.code, head); arm.load(&mut c.code, left); arm.branch(&mut c.code, done, 18)
            arm.integer_binary(&mut c.code, 2, true, false, 0, 0, -1, 1); arm.store(&mut c.code, left, 0)
            arm.load(&mut c.code, item)
            if is_pod(&c, ty) { box_pod_for_container(&mut c, ty) } else { copy_value(&mut c, ty) }
            arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, saved)
            arm.intrinsic_call(&mut c.code, c.runtime.array_push, .ArrayInitializeElement, ty, 0, element_source)
            arm.branch(&mut c.code, head, 0); arm.mark(&mut c.code, done)
            break
        }
        count += 1; take_value_boxed(&mut c, ty)
        initialize_array_element(&mut c, saved, ty, element_source)
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, "]"); arm.load(&mut c.code, saved); fc.clear_rvalue_place(&mut c.body.place)
    if base == 0 { fail(&mut c, "empty array needs an element type") }
    fc.finish_pending(&mut c.body.pending, pending)
    mut ty := compound(&mut c, 1, base); if repeated || ft.type_kind(&c.types, expected) != 1 { ty = fixed(&mut c, base, count) }
    arm.finish_array_literal(&mut c.code, allocation, base, ty, unsigned.shift(storage_type(&c, base)), source)
    array_element_helpers(&mut c, base)
    temporary(&mut c, ty)
}
fn tuple_literal(c: &mut Session, ty: i32, at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    first := ft.type_start(&c.types, ty); count := ft.type_count(&c.types, ty)
    home := slot(&mut c)
    arm.allocate_value(&mut c.code, c.runtime.alloc_record, .Record, ty, count * 8, c.world.tokens.starts[at])
    arm.store(&mut c.code, home, 0)
    pending := c.body.pending.slots.len
    stage_owner(&mut c, .Storage, home, ty, 0)
    for i in 0..count {
        if !c.ok { break }
        newlines(&mut c)
        if i > 0 && !is(&c, ")") { expect(&mut c, ","); newlines(&mut c) }
        if is(&c, ")") { fail(&mut c, "too few components in tuple literal"); break }
        component := c.body.cursor
        field_type := c.types.field_types[first + i]
        actual := expression(&mut c, 0, field_type, &catalog, &mut inline_work, &mut model)
        same_or_coerce(&mut c, field_type, actual, component)
        if !c.ok { break }
        take_value_boxed(&mut c, field_type)
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, home)
        place_step(&mut c, .Member, field_type, i32(borrows.Access.Address), i32(place_op.Member.Initialize), i, component)
        stage_owner(&mut c, .Field, home, field_type, i)
    }
    newlines(&mut c)
    if eat(&mut c, ",") { newlines(&mut c) }
    if !eat(&mut c, ")") { fail(&mut c, "too many components in tuple literal") }
    fc.finish_pending(&mut c.body.pending, pending)
    if !c.ok { return 0 }
    arm.load(&mut c.code, home); fc.clear_rvalue_place(&mut c.body.place)
    temporary(&mut c, ty)
}
fn primary_inner(c: &mut Session, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, place: &mut i32, at: &mut i32, pending: &mut bool) -> i32 {
    if !c.ok { return 0 }
    token := c.body.cursor; kind := c.world.tokens.kinds[token]
    if model.probing {
        if !model.recording && decline_projection(&mut c, &mut model) { return 0 }
        model.value = -1; model.array = -1
        if kind != .Name && kind != .Integer {
            word := c.world.tokens.texts[token].clone()
            symbol := kind == .Symbol && (word == "-" || word == "!" || word == "(")
            boolean := kind == .Keyword && (word == "true" || word == "false")
            if !symbol && !boolean && model.probing && decline_projection(&mut c, &mut model) { return 0 }
        }
    }
    if eat(&mut c, "move") {
        value := primary(&mut c, expected, &catalog, &mut inline_work, &mut model)
        take_value(&mut c, value); place = 0; return temporary(&mut c, value)
    }
    if kind == .Float { spelling := advance(&mut c); return float_literal(&mut c, spelling, expected) }
    if kind == .Integer { spelling := advance(&mut c); return literal(&mut c, &mut model, spelling, expected) }
    if kind == .Byte { text := advance(&mut c); parsed := parse.integer(text); assert(parsed.ok && parsed.value >= 0 && parsed.value <= 255); arm.imm(&mut c.code, 0, parsed.value); return 8 }
    if kind == .String || kind == .Rune {
        text := advance(&mut c)
        if kind == .Rune { scalar := text.runes()[0]; arm.imm(&mut c.code, 0, i64(i32(scalar))); return 5 }
        target := arm.label(&mut c.code)
        if !c.code.checking { c.body.facts.literal_tokens.push(token); c.body.facts.literal_labels.push(target) }
        arm.branch(&mut c.code, target, 20)
        return temporary(&mut c, 4)
    }
    if is(&c, "unsafe") && c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.texts[c.body.cursor + 1] == "{" {
        if model.probing && decline_projection(&mut c, &mut model) { return 0 }
        skip_token(&mut c)
        task_effect_at(&mut c, 16, token)
        if !c.world.unsafe_capable {
            has_other := c.body.current_owner >= 0 && c.body.current_owner < c.world.module_caps.len && c.world.module_caps[c.body.current_owner] != 0
            fail(&mut c, modules.missing_unsafe_message(has_other)); return 0
        }
        end := c.world.closes[c.body.cursor]
        home := slot(&mut c)
        previous_unsafe := c.body.unsafe_scope; c.body.unsafe_scope = true
        previous_vb := c.body.value_block
        c.body.value_block = fc.ValueBlock { end: end, home: home, expected: expected, ty: 0, match_arm: false }
        ends := block(&mut c, false, &catalog, &mut inline_work, &mut model)
        ty := c.body.value_block.ty
        c.body.value_block = previous_vb
        c.body.unsafe_scope = previous_unsafe
        if !c.ok { return 0 }
        fc.clear_place_eval(&mut c.body.place)
        if ends {
            out := temporary(&mut c, expected); c.body.expr.untyped_exit = true
            return out
        }
        if ty == 0 { return 0 }
        arm.load(&mut c.code, home)
        if ft.type_kind(&c.types, ty) == 4 || ft.type_kind(&c.types, ty) == 5 {
            fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
            binding := c.body.return_borrow_origin - c.body.first_parameter
            c.body.loan.root = binding; c.body.loan.origin = c.body.return_borrow_origin
            c.body.loan.path = ownership.root_id(&c.body.ownership, binding); c.body.loan.constrained = true
            return ty
        }
        return temporary(&mut c, ty)
    }
    if kind == .Name {
        next := c.world.tokens.kinds[token + 1]
        if next == .Name || (next == .Symbol && c.world.tokens.texts[token + 1] == "!") {
            if next == .Name && is(&c, "spawn") {
                if model.probing && decline_projection(&mut c, &mut model) { return 0 }
                return task_spawn(&mut c, &catalog, &mut inline_work, &mut model)
            }
            if is(&c, "await") {
                if model.probing && decline_projection(&mut c, &mut model) { return 0 }
                return task_await_expression(&mut c, &catalog, &mut inline_work, &mut model)
            }
        }
        c.body.cursor = token + 1
        found := local(&c.body, c.world.tokens.texts[token])
        if found >= 0 && (next != .Symbol || (c.world.tokens.texts[token + 1] != "(" && c.world.tokens.texts[token + 1] != "::")) {
            if model.recording { typed.read(&mut model, found, token) }
            place = borrows.local_id(found); at = c.body.cursor - 1
            pending = true
            return local_value_type(&mut c, found)
        }
        if model.probing && decline_projection(&mut c, &mut model) { return 0 }
        name := c.world.tokens.texts[token].clone()
        mut nominal := -1
        if found < 0 || (next == .Symbol && c.world.tokens.texts[token + 1] == "::") { nominal = resolve_type_name(&c, name) }
        if eat(&mut c, "::") {
            if nominal < 0 {
                if c.world.tokens.kinds[c.body.cursor] == .Name {
                    method_tok := c.body.cursor
                    mname := c.world.tokens.texts[method_tok].clone()
                    gfn := i32(c.specializations.generic_fns.defs.get_or(name + "::" + mname, -1))
                    if gfn >= 0 {
                        _ := advance(&mut c)
                        if gfn < c.specializations.generic_fns.has_self.len &&
                            !c.specializations.generic_fns.has_self[gfn] &&
                            c.specializations.generic_fns.owner_tcounts[gfn] < c.specializations.generic_fns.type_param_counts[gfn] &&
                            (is(&c, "(") || is(&c, "<")) {
                            result := try_generic_method_call(&mut c, gfn, -1, name, mname, token, method_tok, expected, false, &catalog, &mut inline_work, &mut model)
                            fc.clear_rvalue_place(&mut c.body.place)
                            return call_result(&mut c, result)
                        }
                        shown_base := diagnostics.display_symbol(&c.sources, name)
                        if !eat(&mut c, "(") {
                            fail(&mut c, "cannot infer type arguments for '" + shown_base + "::" + mname + "'; requires explicit type arguments, e.g. '" + shown_base + "<...>::" + mname + "'")
                            set_error_at(&mut c, c.world.tokens.starts[token]); return 0
                        }
                        self_def := c.specializations.generic_fns.catalog_defs[gfn]
                        return infer_generic_call(&mut c, gfn, name, mname, token, expected, self_def, &catalog, &mut inline_work, &mut model)
                    }
                }
                if name == "Self" { fail(&mut c, "Self is only valid inside an impl block") }
                else { fail(&mut c, "unknown type '" + diagnostics.display_symbol(&c.sources, name) + "'") }
                set_error_at(&mut c, c.world.tokens.starts[token]); return 0
            }
            if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected method name after '::'"); return 0 }
            method_tok := c.body.cursor; method_name := advance(&mut c)
            is_explicit_gen := is(&c, "<")
            mut f := -1
            if !is_explicit_gen { f = impl_method(&c, nominal, method_name) }
            if f < 0 {
                gfn := generic_method_lookup(&c, nominal, method_name, false)
                if gfn >= 0 && (is_explicit_gen || is(&c, "(")) {
                    result := try_generic_method_call(&mut c, gfn, nominal, "", method_name, -1, method_tok, expected, false, &catalog, &mut inline_work, &mut model)
                    fc.clear_rvalue_place(&mut c.body.place)
                    return call_result(&mut c, result)
                }
                fail(&mut c, "unknown associated function '" + type_spelling(&c, nominal) + "::" + method_name + "'")
                set_error_at(&mut c, c.world.tokens.starts[method_tok]); return 0
            }
            if !check_impl_access(&mut c, f, method_tok) { return 0 }
            if eat(&mut c, "(") {
                if c.world.unsafe_functions[f] && !c.body.unsafe_scope { fail(&mut c, "call requires unsafe"); return 0 }
                c.body.facts.needed.push(f)
                result := invoke(&mut c, c.world.ffi_types[f], -1, f, -1, &catalog, &mut inline_work, &mut model)
                fc.clear_rvalue_place(&mut c.body.place)
                return call_result(&mut c, result)
            }
            if c.world.unsafe_functions[f] { fail(&mut c, "unsafe function requires a foreign function pointer"); return 0 }
            return function_value(&mut c, f, token)
        }
        if floats.has(nominal) && eat(&mut c, ".") {
            expect(&mut c, "from_bits"); expect(&mut c, "(")
            mut bits := 2; if nominal == 6 { bits = 1 }
            actual := expression(&mut c, 0, bits, &catalog, &mut inline_work, &mut model); same(&mut c, bits, actual); expect(&mut c, ")")
            if nominal == 6 { arm.integer_binary(&mut c.code, 9, false, false, 0, 31, 0, -1) }
            return nominal
        }
        if enum_type(&c, nominal) && eat(&mut c, ".") { return enumeration(&mut c, nominal, &catalog, &mut inline_work, &mut model) }
        if enum_type(&c, nominal) && eat(&mut c, "(") {
            if ft.type_kind(&c.types, nominal) != 3 { fail(&mut c, "a data enum requires a variant"); return nominal }
            actual := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, actual); expect(&mut c, ")")
            valid := arm.label(&mut c.code)
            first := ft.type_start(&c.types, nominal)
            for field in first..first+ft.type_count(&c.types, nominal) {
                arm.imm(&mut c.code, 2, c.types.field_values[field])
                arm.compare_register(&mut c.code, 0, 2)
                arm.branch(&mut c.code, valid, 2)
            }
            arm.fail_source(&mut c.code, .InvalidEnum, c.world.tokens.starts[token]); arm.mark(&mut c.code, valid)
            fc.clear_rvalue_place(&mut c.body.place)
            return nominal
        }
        if nominal >= 0 && ft.type_kind(&c.types, nominal) == 2 && eat(&mut c, "{") {
            opaque_access(&mut c, nominal)
            pod := is_pod(&c, nominal)
            saved := slot(&mut c)
            if ft.is_c_record(&c.types, nominal) { zero_record(&mut c, nominal, token) }
            else if pod { base := alloc_pod_buffer(&mut c, nominal); place_step(&mut c, .BorrowHome, nominal, i32(borrows.Access.Address), 0, base, token) }
            else { arm.allocate_value(&mut c.code, c.runtime.alloc_record, .Record, nominal, ft.type_count(&c.types, nominal) * 8, c.world.tokens.starts[token]) }
            arm.store(&mut c.code, saved, 0); mut provided: []bool = []
            pending := c.body.pending.slots.len
            if !pod { stage_owner(&mut c, .Storage, saved, nominal, 0) }
            for _ in 0..ft.type_count(&c.types, nominal) { provided.push(false) }; separators(&mut c)
            while c.ok && !is(&c, "}") {
                member_at := c.body.cursor; member := advance(&mut c); found := field(&c, nominal, member)
                if found < 0 { fail(&mut c, "unknown constructor field"); break }
                offset := found - ft.type_start(&c.types, nominal)
                if provided[offset] { fail(&mut c, "duplicate constructor field") }; provided[offset] = true
                mut ty := 0
                if eat(&mut c, ":") {
                    ty = expression(&mut c, 0, c.types.field_types[found], &catalog, &mut inline_work, &mut model)
                } else {
                    if !is(&c, ",") && !is(&c, "}") && !lexer.is_newline(c.world.tokens.kinds[c.body.cursor]) {
                        fail(&mut c, "expected ':' or ',' in struct literal"); break
                    }
                    c.body.cursor = member_at
                    ty = expression(&mut c, 0, c.types.field_types[found], &catalog, &mut inline_work, &mut model)
                }
                ty = coerce_callable(&mut c, c.types.field_types[found], ty, member_at)
                same(&mut c, c.types.field_types[found], ty)
                if ft.is_c_record(&c.types, nominal) {
                    take_inline(&mut c, ty)
                    arm.push_temp(&mut c.code,0); arm.load(&mut c.code,saved); place_step(&mut c, .Field, ty, i32(borrows.Access.Address), 0, i32(c.types.field_values[found]), member_at)
                    arm.mov(&mut c.code,1,0); arm.pop_temp(&mut c.code,0); store_inline(&mut c, ty, member_at)
                } else if pod {
                    arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, saved); place_step(&mut c, .Member, ty, i32(borrows.Access.Address), i32(place_op.Member.Initialize), offset, member_at)
                } else {
                    take_value_boxed(&mut c, ty); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, saved); place_step(&mut c, .Member, ty, i32(borrows.Access.Address), i32(place_op.Member.Initialize), offset, member_at)
                    stage_owner(&mut c, .Field, saved, ty, offset)
                }
                if !eat(&mut c, ",") { break }; separators(&mut c)
            }
            separators(&mut c); expect(&mut c, "}")
            for present in provided { if !present { fail(&mut c, "missing constructor field") } }
            fc.finish_pending(&mut c.body.pending, pending)
            arm.load(&mut c.code, saved); fc.clear_rvalue_place(&mut c.body.place); return temporary(&mut c, nominal)
        }
        if is(&c, "(") {
            if found >= 0 {
                locals.mark_used(&mut c.body.locals, found)
                sig := local_value_type(&mut c, found); callable_kind := ft.type_kind(&c.types, sig)
                if callable_kind != 8 && !ft.is_dunder_callable_kind(callable_kind) && !ft.is_borrowed_closure(&c.types, sig) {
                    fail(&mut c, "local value is not callable"); return 0
                }
                expect(&mut c, "(")
                result := call_loaded_callable(&mut c, sig, borrows.local_id(found), 0, true, token, c.body.cursor - 1, &catalog, &mut inline_work, &mut model)
                fc.clear_rvalue_place(&mut c.body.place); return call_result(&mut c, result)
            }
            result := call(&mut c, name, expected, &catalog, &mut inline_work, &mut model); fc.clear_rvalue_place(&mut c.body.place); return call_result(&mut c, result) }
        if found < 0 {
            f := i32(c.world.functions.get_or(name, -1))
            if f >= 0 && c.world.libraries[f] != "" { may_invalidate_operand(&mut c); import_address(&mut c, f); return c.world.ffi_types[f] }
        }
        if found < 0 {
            cid := i32(c.world.const_map.get_or(name, -1))
            if cid >= 0 {
                ckind := c.world.const_kinds[cid]; cty := c.world.const_types[cid]
                if ckind == 0 {
                    if model.recording {
                        if cty != 1 && cty != 2 { model.recording = false }
                        else { _ := typed.node(&mut model, 1, cty, -1, -1, -1, c.world.const_ints[cid], -1, token) }
                    }
                    if !c.code.checking || c.code.prefixing { arm.imm(&mut c.code, 0, c.world.const_ints[cid]) }
                    place = 0; fc.clear_rvalue_place(&mut c.body.place); return cty
                }
                if ckind == 1 {
                    if model.probing && decline_projection(&mut c, &mut model) { return 0 }
                    target := arm.label(&mut c.code)
                    if !c.code.checking { c.body.facts.const_string_ids.push(cid); c.body.facts.const_string_labels.push(target) }
                    arm.branch(&mut c.code, target, 20)
                    place = 0; fc.clear_rvalue_place(&mut c.body.place); return temporary(&mut c, 4)
                }
                if model.probing && decline_projection(&mut c, &mut model) { return 0 }
                may_invalidate_operand(&mut c)
                target := arm.label(&mut c.code)
                if !c.code.checking { c.body.facts.const_blob_ids.push(cid); c.body.facts.const_blob_labels.push(target) }
                for _ in 0..5 { _ := slot(&mut c) }
                data_home := slot(&mut c)
                arm.branch(&mut c.code, target, 20); arm.store(&mut c.code, data_home, 0)
                arm.imm(&mut c.code, 0, c.world.const_ints[cid]); arm.store(&mut c.code, data_home - 1, 0); arm.store(&mut c.code, data_home - 2, 0)
                elem_ty := ft.type_base(&c.types, cty)
                shift := unsigned.shift(storage_type(&c, elem_ty))
                arm.imm(&mut c.code, 0, i64(shift)); arm.store(&mut c.code, data_home - 3, 0)
                arm.store(&mut c.code, data_home - 4, 31); arm.store(&mut c.code, data_home - 5, 31)
                arm.address(&mut c.code, data_home)
                place = 0; fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr)
                c.body.expr.const_array = true
                return cty
            }
            if name == "Self" { fail(&mut c, "expected 'Self::...', 'Self { ... }', or 'Self.Variant'"); set_error_at(&mut c, c.world.tokens.starts[token]); return 0 }
            f := i32(c.world.functions.get_or(name, -1))
            if f < 0 {
                if c.specializations.generic_fns.defs.contains(name) {
                    shown := diagnostics.display_symbol(&c.sources, name)
                    fail(&mut c, "generic function '" + shown + "' requires explicit type arguments")
                } else {
                    fail(&mut c, "unknown local '" + diagnostics.display_symbol(&c.sources, name) + "'")
                }
                set_error_at(&mut c, c.world.tokens.starts[token]); return 0
            }
            check_function_caps(&mut c, f, c.body.cursor - 1)
            if !c.ok { return 0 }
            if c.world.unsafe_functions[f] { fail(&mut c, "unsafe function requires a foreign function pointer"); return 0 }
            return function_value(&mut c, f, token)
        }
        fail(&mut c, "expected expression"); return 0
    }
    if is(&c, "if") || is(&c, "match") {
        home := slot(&mut c)
        result := choice_arms(&mut c, expected, home, &catalog, &mut inline_work, &mut model)
        if !c.ok { return 0 }
        fc.clear_place_eval(&mut c.body.place)
        if result == 0 {
            ty := temporary(&mut c, expected); c.body.expr.untyped_exit = true
            return ty
        }
        arm.load(&mut c.code, home)
        if ft.type_kind(&c.types, result) == 4 || ft.type_kind(&c.types, result) == 5 {
            fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
            binding := c.body.return_borrow_origin - c.body.first_parameter
            c.body.loan.root = binding; c.body.loan.origin = c.body.return_borrow_origin
            c.body.loan.path = ownership.root_id(&c.body.ownership, binding); c.body.loan.constrained = true
            return result
        }
        return temporary(&mut c, result)
    }
    if eat(&mut c, "&") {
        may_invalidate_operand(&mut c)
        mutable := eat(&mut c, "mut")
        mut kind := 4; if mutable { kind = 5 }
        if expected != 0 && ft.type_kind(&c.types, expected) != kind { fail(&mut c, "use & for a shared parameter or &mut for a mutable parameter"); return 0 }
        previous_address := c.body.place.taking_address; c.body.place.taking_address = true
        previous_depth := c.body.loan.depth
        if !mutable { c.body.loan.depth = c.body.depth + 1 }
        mut context := 0; if expected != 0 { context = ft.type_base(&c.types, expected) }
        mut ty := primary(&mut c, context, &catalog, &mut inline_work, &mut model)
        c.body.loan.depth = previous_depth
        c.body.place.taking_address = previous_address
        place = c.body.places.current; at = c.body.places.source
        if ft.type_kind(&c.types, ty) == 4 {
            if mutable { fail(&mut c, "cannot mutably borrow a shared reference"); return 0 }
            fc.clear_rvalue_place(&mut c.body.place); return ty
        }
        if ft.type_kind(&c.types, ty) == 5 {
            if mutable { fc.clear_rvalue_place(&mut c.body.place); return ty }
            place = returned_place(&mut c, ty, token)
            ty = ft.type_base(&c.types, ty)
            lower_place(&mut c, place, 0, .ValueAndAddress, token)
        }
        if c.body.loan.home >= 0 {
            if mutable { fail(&mut c, "borrowed ranges are read-only"); return 0 }
            home := c.body.loan.home; place_step(&mut c, .BorrowHome, ty, 3, 0, home, token)
            if !constrain_borrow(&mut c) { return 0 }
            fc.clear_rvalue_place(&mut c.body.place)
            return compound(&mut c, 4, ty)
        }
        base := borrows.root(&c.body.places, place)
        if base < 0 {
            if mutable { fail(&mut c, "mutable borrow requires a named variable, field or array element"); return 0 }
            read_argument(&mut c, ty, token)
            if !constrain_borrow(&mut c) { return 0 }
            fc.clear_rvalue_place(&mut c.body.place)
            return compound(&mut c, 4, ty)
        }
        if mutable && is_for_locked(&c, owner_path(&c, place)) { fail(&mut c, "cannot mutably borrow a collection while iterating over it"); return 0 }
        if mutable && !writable_loan(&mut c, place) { return 0 }
        if !mutable && !readable_loan(&mut c, place) { return 0 }
        if mutable { record_mutation(&mut c, base, owner_path(&c, place)) }
        if ft.type_kind(&c.types, ty)==21 {
            elem:=ft.type_base(&c.types, ty)
            if mutable || ft.type_kind(&c.types, expected)!=4 || ft.type_kind(&c.types, ft.type_base(&c.types, expected))!=1 || ft.type_base(&c.types, ft.type_base(&c.types, expected))!=elem || !ft.scalar_element(&c.types, elem) || i32(1).shl(unsigned.shift(storage_type(&c, elem)))!=scratch_width(&c,elem) {fail(&mut c,"scratch slice needs a shared, representation-compatible parameter");return 0}
            ty=ft.type_base(&c.types, expected)
        }else if c.body.place.scratch==1 && ft.type_kind(&c.types, ty)!=2 && i32(1).shl(unsigned.shift(storage_type(&c, ty)))!=scratch_width(&c,ty) {
            fail(&mut c,"borrow a value-compatible scratch element or record field");return 0
        }
        if c.body.place.address < 0 { fail(&mut c, "borrow requires a stored value"); return 0 }
        if mutable && !c.body.place.writable { fail_immutable_binding(&mut c, "mutable borrow requires mut or &mut", base) }
        c.body.loan.path = owner_path(&c, place); c.body.loan.root = source_root(&c, place)
        c.body.loan.origin = loan_origin(&c, place); c.body.loan.parent = borrow_parent(&c, place)
        c.body.loan.constrained = local_borrows.shared(&c.body.local_loans, base)
        borrow_address(&mut c, ty, mutable, token, place); fc.clear_rvalue_place(&mut c.body.place)
        return compound(&mut c, kind, ty)
    }
    if eat(&mut c, "-") {
        if c.world.tokens.kinds[c.body.cursor] == .Integer { spelling := "-" + advance(&mut c); return literal(&mut c, &mut model, spelling, expected) }
        value := primary(&mut c, expected, &catalog, &mut inline_work, &mut model)
        ty := read_scalar_result(&mut c, value, token)
        if model.recording { _ := typed.node(&mut model, 4, ty, model.value, -1, -1, 1, -1, token) }
        if floats.has(ty) { result := arm.float_method(&mut c.code, ty, "negate", c.world.tokens.starts[token]); fc.clear_rvalue_place(&mut c.body.place); return result }
        if ty != 1 && ty != 2 { fail(&mut c, "minus requires a signed number") }
        arm.integer_binary(&mut c.code, 2, true, true, 0, 31, 0, -1); arm.branch(&mut c.code, c.overflow, 8); if ty == 1 { narrow(&mut c) }; fc.clear_rvalue_place(&mut c.body.place); return ty
    }
    if eat(&mut c, "!") {
        value := primary(&mut c, 3, &catalog, &mut inline_work, &mut model)
        ty := read_scalar_result(&mut c, value, token); same(&mut c, 3, ty)
        if model.recording { _ := typed.node(&mut model, 4, 3, model.value, -1, -1, 2, -1, token) }
        arm.compare_register(&mut c.code, 0, 31); arm.set_condition(&mut c.code, 0, 0); fc.clear_rvalue_place(&mut c.body.place); return 3
    }
    if eat(&mut c, "(") {
        if ft.is_tuple(&c.types, expected) && lookahead.tuple_group(&c.world.tokens, &c.world.closes, c.body.cursor) {
            return tuple_literal(&mut c, expected, token, &catalog, &mut inline_work, &mut model)
        }
        previous_depth := c.body.loan.depth
        if c.body.loan.depth == c.body.depth { c.body.loan.depth = c.body.depth + 1 }
        ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
        c.body.loan.depth = previous_depth
        if is(&c, ",") { fail(&mut c, "tuple literal requires a tuple type in this context") }
        expect(&mut c, ")"); place = c.body.places.current; at = c.body.places.source; return ty
    }
    if eat(&mut c, "true") { if model.recording { _ := typed.node(&mut model, 1, 3, -1, -1, -1, 1, -1, token) }; arm.imm(&mut c.code, 0, 1); return 3 }
    if eat(&mut c, "false") { if model.recording { _ := typed.node(&mut model, 1, 3, -1, -1, -1, 0, -1, token) }; arm.imm(&mut c.code, 0, 0); return 3 }
    if eat(&mut c, ".") { return enumeration(&mut c, expected, &catalog, &mut inline_work, &mut model) }
    if eat(&mut c, "[") { return array_literal(&mut c, token, expected, &catalog, &mut inline_work, &mut model) }
    fail(&mut c, "expected expression"); 0
}
fn local_value_type(c: &mut Session, found: i32) -> i32 {
    ty := c.body.locals.types[found]; local_kind := ft.type_kind(&c.types, ty)
    if local_kind == 23 { fail(&mut c, "task scope capability is only valid with spawn or await"); return 0 }
    if local_kind == 20 { fail(&mut c, "region is only valid in an allocation"); return 0 }
    if ft.is_borrowed_closure(&c.types, ty) { return ty }
    if local_kind == 4 || local_kind == 5 { return ft.type_base(&c.types, ty) }
    ty
}
fn load_binding(c: &mut Session, found: i32, access: borrows.Access, token: i32, whole: bool) {
    path := owner_path(&c, borrows.local_id(found))
    mut initialized := ownership.present(&c.body.ownership, path)
    if whole { initialized = ownership.available(&c.body.ownership, path) }
    if access != .Address && !initialized {
        fail(&mut c, "use of moved value '" + c.body.locals.names[found] + "'")
        set_error_at(&mut c, c.world.tokens.starts[token]); return
    }
    if access != .Address && whole && !readable_loan(&mut c, borrows.local_id(found)) { return }
    local_type := c.body.locals.types[found]; kind := ft.type_kind(&c.types, local_type)
    if access != .Address || kind == 5 { locals.mark_used(&mut c.body.locals, found) }
    home := places.local_home(c.body.places.arena.locals[found])
    c.body.place.scratch = 0; c.body.place.inline_storage = false
    if kind == 21 { c.body.place.scratch = 3 }
    if ft.is_borrowed_closure(&c.types, local_type) {
        c.body.place.writable = false
        c.body.place.direct = false; c.body.place.address = home
        if access != .Address && (!c.code.checking || c.code.prefixing) {
            bound_place(&mut c, .BorrowSaved, borrows.local_id(found), i32(access), token)
        }
        fc.clear_loan_eval(&mut c.body.loan)
        lpath := local_borrows.path(&c.body.local_loans, found)
        lroot := local_borrows.root(&c.body.local_loans, found)
        lorigin := local_borrows.origin(&c.body.local_loans, found)
        lparent := local_borrows.parent(&c.body.local_loans, found)
        p_origin := loan_origin(&c, borrows.local_id(found))
        c.body.loan.constrained = lpath >= 0
        c.body.loan.origin = if lorigin != -1 { lorigin } else if p_origin != -1 { p_origin } else { -3 }
        if lpath >= 0 {
            c.body.loan.path = lpath; c.body.loan.root = lroot
            c.body.loan.parent = if lparent >= 0 { lparent } else { found }
            mut cp: []i32 = []; mut cr: []i32 = []; mut ce: []bool = []; mut ct: []i32 = []
            cp.push(lpath); cr.push(lroot); ce.push(local_borrows.is_exclusive(&c.body.local_loans, found)); ct.push(token)
            local_borrows.append_local_extra_loans(&c.body.local_loans, found, &mut cp, &mut cr, &mut ce, &mut ct)
            c.body.loan.closure_paths = move cp; c.body.loan.closure_roots = move cr
            c.body.loan.closure_exclusives = move ce; c.body.loan.closure_tokens = move ct
        }
    } else if kind == 4 || kind == 5 {
        c.body.place.writable = kind == 5
        ty := ft.type_base(&c.types, local_type)
        c.body.place.address = home; c.body.place.direct = false
        if access != .Address { bound_place(&mut c, .BorrowSaved, borrows.local_id(found), i32(access), token) }
        if ft.is_c_record(&c.types, ty) || fixed_pod(&c, ty) {
            c_layout(&mut c, ty); c.body.place.inline_storage = true
            if access != .Address { inline_value(&mut c, ty, access, token) }
        } else if access != .Address { bound_place(&mut c, .Read, borrows.local_id(found), i32(access), token) }
    } else {
        c.body.place.writable = c.body.locals.mutable[found] && !fc.pattern_loan(&c.body, found)
        c.body.place.direct = true; c.body.place.address = home
        if access != .Address && (!c.code.checking || c.code.prefixing) { bound_place(&mut c, .LocalRead, borrows.local_id(found), i32(access), token) }
    }
}
fn field_offset(c: &Session, receiver: i32, member: i32) -> i32 {
    if ft.is_c_record(&c.types, receiver) { return i32(c.types.field_values[member]) }
    (member - ft.type_start(&c.types, receiver)) * 8
}
fn field_place(c: &mut Session, parent: i32, receiver: i32, member: i32, token: i32) -> i32 {
    ty := c.types.field_types[member]; packed := ft.is_c_record(&c.types, receiver)
    layout := places.layout(.Field, field_offset(&c, receiver, member), read_shape(&c, ty, packed))
    ordinal := member - ft.type_start(&c.types, receiver)
    mut owner := owner_path(&c, parent)
    if owner >= 0 && !borrows.has_index(&c.body.places, parent) && !local_borrows.is_transient(&c.body.local_loans, borrows.root(&c.body.places, parent)) {
        owner = ownership.project(&mut c.body.ownership, owner, ordinal)
    }
    return borrows.project(&mut c.body.places, parent, receiver, ordinal, ty, layout, token, c.world.tokens.starts[token], owner)
}
fn index_place(c: &mut Session, parent: i32, receiver: i32, packed: bool, index: i32, token: i32) -> i32 {
    mut ty := 1; mut kind := places.Projection.TextIndex; mut parameter := 0; mut shape := 0
    if receiver != 4 {
        if ft.type_kind(&c.types, receiver) != 21 && (!collection(&c, receiver) || ft.type_kind(&c.types, receiver) == 10) { return 0 }
        ty = ft.type_base(&c.types, receiver)
        if ty < 0 { return 0 }
        if ft.type_kind(&c.types, receiver) == 21 {
            kind = .RegionIndex; parameter = scratch_width(&c, ty); shape = read_shape(&c, ty, true)
        } else {
            kind = .ArrayIndex; parameter = unsigned.shift(storage_type(&c, ty)); shape = read_shape(&c, ty, packed)
            if packed && ft.is_c_record(&c.types, ty) {
                parameter = 0; while i32(1).shl(parameter) < ft.c_size(&c.types, ty) { parameter = parameter + 1 }
            }
        }
    }
    owner := owner_path(&c, parent)
    return borrows.project(&mut c.body.places, parent, receiver, index+1, ty, places.layout(kind, parameter, shape), token, c.world.tokens.starts[token], owner)
}
fn load_field(c: &mut Session, receiver: i32, member: i32, access: borrows.Access, token: i32, id: i32) -> i32 {
    if c.body.place.scratch != 0 { c.body.place.scratch = 2 }
    ty := c.types.field_types[member]; packed := ft.is_c_record(&c.types, receiver)
    bound_place(&mut c, .Field, id, i32(access), token)
    if access != .Value { save_address(&mut c, id, token) } else { c.body.place.address = -1; c.body.place.direct = false }
    c.body.place.inline_storage = packed
    if access != .Address {
        if packed && (ft.is_c_record(&c.types, ty) || ft.type_kind(&c.types, ty) == 6) { inline_value(&mut c, ty, access, token) }
        else { bound_place(&mut c, .Read, id, i32(access), token) }
    }
    ty
}
fn load_index(c: &mut Session, receiver: i32, packed: bool, writable: bool, access: borrows.Access, source_at: i32, id: i32) -> i32 {
    ty := places.place_type(&c.body.places.arena, 0, 0, id)
    bound_place(&mut c, .CheckIndex, id, i32(access), source_at)
    trap_edge(&mut c, c.bounds, .Bounds, source_at)
    bound_place(&mut c, .Element, id, i32(access), source_at)
    if receiver == 4 {
        bound_place(&mut c, .Read, id, i32(access), source_at)
        fc.clear_rvalue_place(&mut c.body.place); return ty
    }
    if access != .Value { save_address(&mut c, id, source_at) } else { c.body.place.address = -1; c.body.place.direct = false }
    region := ft.type_kind(&c.types, receiver) == 21
    c.body.place.scratch = 0; c.body.place.inline_storage = packed; c.body.place.writable = writable
    if region { c.body.place.scratch = 1; c.body.place.inline_storage = ft.is_c_record(&c.types, ty) }
    if access != .Address && !(region && ft.type_kind(&c.types, ty) == 2) {
        bound_place(&mut c, .Read, id, i32(access), source_at)
    }
    ty
}
fn borrow_address(c: &mut Session, ty: i32, mutable: bool, token: i32, place: i32) {
    mut intent := 3; if mutable { intent = 4 }
    if c.body.place.scratch == 1 && ft.type_kind(&c.types, ty) == 2 && !ft.is_c_record(&c.types, ty) {
        bound_place(&mut c, .BorrowHome, place, intent, token)
    } else if ft.is_c_record(&c.types, ty) {
        place_step(&mut c, .BorrowPayload, ty, intent, 0, 0, token)
    } else if fixed_pod(&c, ty) {
        place_step(&mut c, .Read, ty, intent, 3, 0, token)
    } else if c.body.place.inline_storage && ft.type_kind(&c.types, ty) == 6 {
        backing := slot(&mut c); arm.store(&mut c.code,backing,0); place_step(&mut c, .BorrowHome, ty, intent, 0, backing, token)
    } else if c.body.place.direct && place < 0 { bound_place(&mut c, .BorrowHome, place, intent, token) }
    else { bound_place(&mut c, .BorrowSaved, place, intent, token) }
}
fn lower_place(c: &mut Session, place: i32, base: i32, access: borrows.Access, root_at: i32) {
    if place < 0 { load_binding(&mut c, borrows.root(&c.body.places, place), access, root_at, true); return }
    path := owner_path(&c, place)
    if path >= 0 {
        mut initialized := true
        if access != .Address || borrows.has_index(&c.body.places, place) { initialized = ownership.available(&c.body.ownership, path) }
        else { initialized = ownership.parent_present(&c.body.ownership, path) }
        if !initialized {
            binding := borrows.root(&c.body.places, place)
            fail(&mut c, "use of moved value '" + c.body.locals.names[binding] + "'")
            set_error_at(&mut c, c.world.tokens.starts[root_at]); return
        }
    }
    if access != .Address && !readable_loan(&mut c, place) { return }
    mut p := place
    c.body.places.path.clear()
    while p > 0 && p != base { c.body.places.path.push(p - 1); p = places.parent(c.body.places.arena.nodes[3 * (p - 1)]) }
    if base == 0 {
        if p >= 0 { fail(&mut c, "internal missing place root"); return }
        load_binding(&mut c, borrows.root(&c.body.places, p), .Value, root_at, false)
    } else if p != base { fail(&mut c, "internal inconsistent place path"); return }
    while c.body.places.path.len > 0 {
        node := c.body.places.path.pop()
        receiver := places.receiver(c.body.places.arena.nodes[3*node+1]); selector := places.selector(c.body.places.arena.nodes[3*node])
        mut need := borrows.Access.Value
        if c.body.places.path.len == 0 { need = access }
        if places.kind(places.storage(c.body.places.arena.nodes[3*node+2])) == i32(places.Projection.Field) {
            _ := load_field(&mut c, receiver, ft.type_start(&c.types, receiver) + selector, need, c.body.places.tokens[node], node + 1)
        }
        else {
            if selector == 0 { fail(&mut c, "internal missing evaluated index"); return }
            writable := c.body.place.writable; packed := c.body.place.inline_storage && ft.type_kind(&c.types, receiver) == 6
            arm.mov(&mut c.code, 1, 0); bound_place(&mut c, .Temporary, node + 1, i32(place_op.Temporary.LoadIndex), c.body.places.tokens[node])
            _ := load_index(&mut c, receiver, packed, writable, need, c.body.places.tokens[node], node + 1)
        }
    }
}
fn method_impl(c: &mut Session, f: i32, ty: i32, place: i32, materialized: i32, pending: bool,
    receiver_at: i32, temporary_root: i32, projection_address: i32,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    expect(&mut c, "(")
    call_token := c.body.cursor - 1
    method_tok := call_token - 1
    mut recv_tok := receiver_at; if recv_tok < 0 { recv_tok = method_tok }
    if !check_impl_access(&mut c, f, method_tok) { return 0 }
    if c.world.unsafe_functions[f] && !c.body.unsafe_scope { fail(&mut c, "call requires unsafe"); return 0 }
    if !c.world.impl_has_self[f] {
        fail(&mut c, "associated function '" + c.world.impl_names[f] + "' has no self parameter; call it as '" + type_spelling(&c, ty) + "::" + c.world.impl_names[f] + "'")
        set_error_at(&mut c, c.world.tokens.starts[method_tok])
        return 0
    }
    signature := c.world.ffi_types[f]
    want := ft.parameter_type(&c.types, ft.type_start(&c.types, signature))
    want_kind := ft.type_kind(&c.types, want)
    first_writeback := c.body.scratch_returns.len
    mut args: []i32 = []; mut arg_starts: []i32 = []; mut arg_places: []i32 = []; mut arg_sources: []i32 = []; mut effects: []i32 = []
    effects.push(c.body.mutations.len)
    arg_starts.push(recv_tok); arg_places.push(place); arg_sources.push(recv_tok)
    if want_kind == 4 {
        if place != 0 {
            lower_place(&mut c, place, 0, .ValueAndAddress, recv_tok)
            borrow_address(&mut c, ty, false, recv_tok, place)
        } else if ft.is_c_record(&c.types, ty) || fixed_pod(&c, ty) {
            borrow_address(&mut c, ty, false, recv_tok, 0)
        } else {
            home := slot(&mut c); arm.store(&mut c.code, home, 0); place_step(&mut c, .BorrowHome, ty, 3, 0, home, recv_tok)
        }
        if c.loans.active {
            origin := loan_origin(&c, place)
            binding := borrows.root(&c.body.places, place)
            constrained := local_borrows.shared(&c.body.local_loans, binding) ||
                (ft.return_borrow_parameter(&c.types, signature) == 0 && source_root(&c, place) < 0)
            forward_argument_loan(&mut c, origin, constrained, f, signature, 0, c.world.tokens.starts[recv_tok])
        }
    } else if want_kind == 5 {
        if place == 0 { fail(&mut c, "mutable method requires a stored variable, field or array element"); set_error_at(&mut c, c.world.tokens.starts[method_tok]); return 0 }
        lower_place(&mut c, place, 0, .ValueAndAddress, recv_tok)
        base := borrows.root(&c.body.places, place)
        if base < 0 { fail(&mut c, "mutable method requires a stored variable, field or array element"); set_error_at(&mut c, c.world.tokens.starts[method_tok]); return 0 }
        if is_for_locked(&c, owner_path(&c, place)) { fail(&mut c, "cannot mutate a collection while iterating over it"); set_error_at(&mut c, c.world.tokens.starts[method_tok]); return 0 }
        if c.body.place.address < 0 { fail(&mut c, "borrow requires a stored value"); set_error_at(&mut c, c.world.tokens.starts[method_tok]); return 0 }
        if !c.body.place.writable { fail_immutable_binding(&mut c, "mutable method requires mut or &mut", base); set_error_at(&mut c, c.world.tokens.starts[method_tok]); return 0 }
        if !writable_loan(&mut c, place) { return 0 }
        if !ownership.available(&c.body.ownership, owner_path(&c, place)) { fail(&mut c, "cannot borrow a moved value"); set_error_at(&mut c, c.world.tokens.starts[method_tok]); return 0 }
        record_mutation(&mut c, base, owner_path(&c, place))
        borrow_address(&mut c, ty, true, recv_tok, place)
        if c.loans.active {
            origin := loan_origin(&c, place)
            forward_argument_loan(&mut c, origin, false, f, signature, 0, c.world.tokens.starts[recv_tok])
            if origin == -2 && c.body.place.scratch == 1 && ft.type_kind(&c.types, ty) == 2 && !ft.is_c_record(&c.types, ty) {
                place_step(&mut c, .Read, ty, 4, 3, 0, recv_tok)
                destination := slot(&mut c); arm.store(&mut c.code, destination, 0)
                copy_value(&mut c, ty)
                owner := slot(&mut c)
                if frame_owned(&c, ty) { save_owner(&mut c, owner, ty, true) } else { arm.store(&mut c.code, owner, 0) }
                c.body.scratch_returns.push(destination); c.body.scratch_returns.push(owner)
                c.body.scratch_returns.push(ty); c.body.scratch_returns.push(recv_tok)
                place_step(&mut c, .BorrowHome, ty, 4, 0, owner, recv_tok)
            }
        }
    } else {
        if pending && !(ft.move_only(&c.types, ty) && place > 0) {
            lower_place(&mut c, place, materialized, .Value, recv_tok)
        }
        c.body.places.current = place; c.body.places.source = recv_tok
        c.body.expr.move_projection = projection_address; c.body.expr.move_temporary = temporary_root
        if place == 0 && projection_address < 0 && temporary_root >= 0 {
            fc.produce_owner(&mut c.body.expr, temporary_root, ty)
        }
        take_value(&mut c, ty)
    }
    if !c.ok { return 0 }
    recv_slot := slot(&mut c); arm.store(&mut c.code, recv_slot, 0)
    args.push(recv_slot)
    c.body.facts.needed.push(f)
    fc.clear_rvalue_place(&mut c.body.place)
    callee := plain_callee()
    invoke_with_args(&mut c, signature, -1, f, -1, &callee, &args, &arg_starts, &arg_places, &arg_sources, &effects, first_writeback, call_token, &catalog, &mut inline_work, &mut model)
}
fn method(c: &mut Session, ty: i32, name: string, place: i32, receiver_at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    mut covered := false
    result := method_dispatch(&mut c, ty, name, place, receiver_at, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
fn replace_value(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    token := c.body.cursor
    expect(&mut c, "&"); expect(&mut c, "mut")
    previous_address := c.body.place.taking_address; c.body.place.taking_address = true
    ty := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
    c.body.place.taking_address = previous_address
    if !c.ok { return 0 }
    place := c.body.places.current; root := borrows.root(&c.body.places, place)
    if root < 0 || c.body.place.address < 0 { fail(&mut c, "replace requires a named variable, field or array element"); return 0 }
    if !c.body.place.writable { fail_immutable_binding(&mut c, "replace requires mutable storage", root); return 0 }
    if !writable_loan(&mut c, place) { return 0 }
    if is_for_locked(&c, owner_path(&c, place)) { fail(&mut c, "cannot replace a collection while iterating over it"); return 0 }
    if c.body.place.scratch != 0 || ft.type_kind(&c.types, ty) == 20 || ft.type_kind(&c.types, ty) == 21 {
        fail(&mut c, "replace does not support region-backed storage"); return 0
    }
    direct := c.body.place.direct; packed := c.body.place.inline_storage
    inline := packed && (ft.is_c_record(&c.types, ty) || ft.type_kind(&c.types, ty) == 6)
    destination := slot(&mut c); place_address(&mut c, place, direct, token); arm.store(&mut c.code, destination, 0)
    expect(&mut c, ",")
    effects := c.body.mutations.len
    consuming := eat(&mut c, "move")
    actual_raw := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model)
    actual := coerce_callable(&mut c, ty, actual_raw, token); same(&mut c, ty, actual)
    if ft.move_only(&c.types, ty) && !is_fresh_owned(&c) && !consuming {
        fail(&mut c, with_clone_hint(&c, ty, "replace requires 'move value'", ", .clone(),") + " or a fresh owned expression"); return 0
    }
    if inline { take_inline(&mut c, ty) } else { take_value(&mut c, ty) }
    expect(&mut c, ")")
    if !c.ok { return 0 }
    if mutated_overlap(&c, effects, c.body.mutations.len, root, owner_path(&c, place)) {
        fail(&mut c, "cannot mutate or move a value while it is borrowed by replace"); return 0
    }
    if is_pod(&c, ty) {
        replacement := slot(&mut c); arm.store(&mut c.code, replacement, 0)
        arm.load(&mut c.code, destination)
        place_transfer(&mut c, ty, 0, 0, true, false, i32(borrows.Access.Value), token)
        dst_ptr := slot(&mut c); arm.store(&mut c.code, dst_ptr, 0)
        previous := slot(&mut c); _ := copy_pod_to_stack(&mut c, ty, token); arm.store(&mut c.code, previous, 0)
        arm.load_into(&mut c.code, replacement, 1); arm.load(&mut c.code, dst_ptr)
        place_step(&mut c, .RegionWrite, ty, i32(borrows.Access.Address), 0, ft.type_count(&c.types, ty), token)
        record_mutation(&mut c, root, owner_path(&c, place))
        arm.load(&mut c.code, previous)
        c.body.places.current = 0; c.body.places.source = -1
        fc.clear_expr_value(&mut c.body.expr)
        fc.clear_rvalue_place(&mut c.body.place)
        return ty
    }
    replacement := slot(&mut c); arm.store(&mut c.code, replacement, 0)
    previous := slot(&mut c)
    arm.load(&mut c.code, destination)
    if inline {
        inline_value(&mut c, ty, .Value, token); copy_value(&mut c, ty)
    } else { place_transfer(&mut c, ty, 0, 0, true, packed, i32(borrows.Access.Value), token) }
    arm.store(&mut c.code, previous, 0)
    arm.load(&mut c.code, replacement); arm.push_temp(&mut c.code, 0)
    arm.load(&mut c.code, destination); arm.mov(&mut c.code, 1, 0); arm.pop_temp(&mut c.code, 0)
    if inline { store_inline(&mut c, ty, token) }
    else { place_transfer(&mut c, ty, 0, 1, false, packed, i32(borrows.Access.Address), token) }
    record_mutation(&mut c, root, owner_path(&c, place))
    arm.load(&mut c.code, previous)
    c.body.places.current = 0; c.body.places.source = -1
    fc.clear_expr_value(&mut c.body.expr)
    fc.clear_rvalue_place(&mut c.body.place)
    ty
}
fn integer_method(c: &mut Session, ty: i32, name: string, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    op := integers.method(name)
    covered = op != .Unknown
    if op == .Not {
        expect(&mut c, ")"); arm.int_complement(&mut c.code, ty); return ty
    }
    mut want := ty; if integers.is_shift(op) { want = 1 }
    if covered && c.body.depth < 128 && c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.kinds[c.body.cursor] == .Integer &&
        c.world.tokens.kinds[c.body.cursor + 1] == .Symbol && c.world.tokens.texts[c.body.cursor + 1] == ")" {
        spelling := advance(&mut c)
        value := integer_literal(&mut c, spelling, want)
        expect(&mut c, ")"); arm.int_immediate(&mut c.code, op, ty, value, c.bounds); return ty
    }
    arm.push_temp(&mut c.code, 0)
    right := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, right)
    expect(&mut c, ")"); arm.pop_temp(&mut c.code, 1)
    if !covered { fail(&mut c, "unknown integer method '" + name + "'"); return ty }
    arm.int_dynamic(&mut c.code, op, ty, c.bounds); ty
}
fn swap_address(c: &mut Session, ty: i32, place: i32, packed: bool, values: i32, index: i32, token: i32) -> i32 {
    arm.load_into(&mut c.code, values, 1); arm.load(&mut c.code, index)
    element := index_place(&mut c, place, ty, packed, index, token)
    _ := load_index(&mut c, ty, packed, true, .Address, token, element)
    c.body.place.address
}
fn swap_array(c: &mut Session, ty: i32, place: i32, receiver_at: i32, writable: bool,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    root := borrows.root(&c.body.places, place)
    if root < 0 { fail(&mut c, "swap requires a stored array"); return 0 }
    if !writable { fail_immutable_binding(&mut c, "swap requires mut or &mut", root); return 0 }
    if !writable_loan(&mut c, place) { return 0 }
    if is_for_locked(&c, owner_path(&c, place)) { fail(&mut c, "cannot mutate a collection while iterating over it"); return 0 }
    record_mutation(&mut c, root, owner_path(&c, place))
    effects := c.body.mutations.len
    packed := c.body.place.inline_storage && ft.type_kind(&c.types, ty) == 6
    values := slot(&mut c); arm.store(&mut c.code, values, 0)
    first_at := c.body.cursor; first := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, first)
    first_slot := slot(&mut c); arm.store(&mut c.code, first_slot, 0); expect(&mut c, ",")
    second_at := c.body.cursor; second := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, second)
    second_slot := slot(&mut c); arm.store(&mut c.code, second_slot, 0); expect(&mut c, ")")
    if mutated_overlap(&c, effects, c.body.mutations.len, root, owner_path(&c, place)) {
        lower_place(&mut c, place, 0, .Value, receiver_at); arm.store(&mut c.code, values, 0)
    }
    left := swap_address(&mut c, ty, place, packed, values, first_slot, first_at)
    right := swap_address(&mut c, ty, place, packed, values, second_slot, second_at)
    base := ft.type_base(&c.types, ty)
    arm.load(&mut c.code, left); place_transfer(&mut c, base, 0, 0, true, packed, 0, first_at)
    saved := slot(&mut c); arm.store(&mut c.code, saved, 0)
    arm.load(&mut c.code, right); place_transfer(&mut c, base, 1, 0, true, packed, 0, second_at)
    arm.load(&mut c.code, left); place_transfer(&mut c, base, 1, 0, false, packed, 1, first_at)
    arm.load_into(&mut c.code, saved, 1); arm.load(&mut c.code, right); place_transfer(&mut c, base, 1, 0, false, packed, 1, second_at)
    0
}
fn safe_borrowed_string_stream(c: &Session, place: i32) -> bool {
    if place >= 0 || c.body.cursor + 1 >= c.world.tokens.kinds.len { return false }
    binding := borrows.root(&c.body.places, place)
    if binding < 0 || binding >= c.body.locals.types.len || binding >= c.body.locals.mutable.len || binding >= c.body.locals.names.len { return false }
    if c.body.locals.mutable[binding] || c.body.locals.types[binding] != 4 { return false }
    mut pos := c.body.cursor + 2
    mut brace_depth := 1
    while pos < c.world.tokens.kinds.len && brace_depth > 0 {
        kind := c.world.tokens.kinds[pos]
        if kind == .Symbol {
            if c.world.tokens.texts[pos] == "{" { brace_depth = brace_depth + 1 }
            else if c.world.tokens.texts[pos] == "}" { brace_depth = brace_depth - 1 }
        } else if (kind == .Keyword || kind == .Name) && c.world.tokens.texts[pos] == "move" {
            mut next := pos + 1
            while next < c.world.tokens.kinds.len && c.world.tokens.kinds[next] == .Symbol && c.world.tokens.texts[next] == "(" {
                next = next + 1
            }
            if next < c.world.tokens.kinds.len && c.world.tokens.kinds[next] == .Name &&
                c.world.tokens.texts[next] == c.body.locals.names[binding] {
                return false
            }
        }
        pos = pos + 1
    }
    brace_depth == 0
}
fn ends_for_header(c: &Session, at: i32) -> bool {
    if at >= c.world.tokens.kinds.len || c.world.tokens.kinds[at] != .Symbol { return false }
    if c.world.tokens.texts[at] == "{" { return true }
    at + 4 < c.world.tokens.kinds.len && c.world.tokens.texts[at] == "." &&
        c.world.tokens.texts[at + 1] == "enumerate" && c.world.tokens.texts[at + 2] == "(" &&
        c.world.tokens.texts[at + 3] == ")" && c.world.tokens.kinds[at + 4] == .Symbol &&
        c.world.tokens.texts[at + 4] == "{"
}
fn method_dispatch(c: &mut Session, ty: i32, name: string, place: i32, receiver_at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    mut effects := c.body.mutations.len
    source := c.world.tokens.starts[c.body.cursor - 1]
    writable := c.body.place.writable; expect(&mut c, "(")
    if name == "__dunder_module_format_integer" {
        covered = true
        spec_at := c.body.cursor
        if c.world.tokens.kinds[spec_at] != .String { fail(&mut c, "expected integer interpolation format"); return 0 }
        spec := lexer.integer_format(advance(&mut c))
        expect(&mut c, ")")
        value := read_scalar_result(&mut c, ty, spec_at)
        if !spec.valid || (value != 1 && value != 2 && !unsigned.has(value)) {
            fail(&mut c, "integer interpolation format requires an integer")
            set_error_at(&mut c, source)
            return 0
        }
        arm.imm(&mut c.code, 1, i64(spec.width)); arm.imm(&mut c.code, 3, i64(spec.radix))
        arm.imm(&mut c.code, 4, i64(spec.letter_offset)); arm.imm(&mut c.code, 5, i64(spec.padding))
        arm.intrinsic_call(&mut c.code, c.runtime.string_formatted_integer, .FormatInteger, value, 4, source)
        return 4
    }
    if name == "__dunder_module_format_string" {
        covered = true
        spec_at := c.body.cursor
        if c.world.tokens.kinds[spec_at] != .String { fail(&mut c, "expected string interpolation format"); return 0 }
        spec := lexer.string_format(advance(&mut c))
        expect(&mut c, ")")
        if !spec.valid || ty != 4 {
            if !spec.valid { fail(&mut c, "invalid string interpolation format") }
            else { fail(&mut c, "string interpolation format requires a string") }
            set_error_at(&mut c, source)
            return 0
        }
        arm.imm(&mut c.code, 1, i64(spec.width)); arm.imm(&mut c.code, 2, i64(spec.align))
        arm.intrinsic_call(&mut c.code, c.runtime.string_formatted_string, .FormatString, 4, 4, source)
        return 4
    }
    if name == "clone" {
        covered = true; expect(&mut c, ")")
        ck := ft.type_kind(&c.types, ty)
        if ck == 20 || ck == 21 { fail(&mut c, "scratch values cannot be cloned out of their region"); return 0 }
        if ft.is_borrowed_closure(&c.types, ty) { fail(&mut c, "borrowed closure cannot be cloned"); return 0 }
        if !ft.cloneable(&c.types, ty) {
            if ft.is_closure_kind(ck) { fail(&mut c, "FnMut/FnOnce closures cannot be cloned"); return 0 }
            fail(&mut c, "resource values cannot be cloned"); return 0
        }
        copy_value(&mut c, ty); return ty
    }
    if ty == 4 && name == "str" {
        covered = true; expect(&mut c, ")")
        copy_value(&mut c, ty); return 4
    }
    if floats.has(ty) {
        expect(&mut c, ")")
        if name == "str" { covered = true; format_float(&mut c, ty, source); return 4 }
        if name == "negate" { fail(&mut c, "unknown float method"); return ty }
        if name == "to_bits" || name == "is_sign_negative" || name == "abs" || name == "sqrt" || name == "floor" || name == "ceil" || name == "round" || name == "round_ties_even" || name == "trunc" || name == "is_nan" || name == "is_finite" || name == "is_infinite" { covered = true }
        actual := arm.float_method(&mut c.code, ty, name, c.world.tokens.starts[c.body.cursor - 3])
        if actual < 0 { fail(&mut c, "unknown float method"); return ty }
        return actual
    }
    if name == "len" { covered = true; expect(&mut c, ")"); return length_value(&mut c, ty, c.body.cursor - 3) }
    if name == "cap" && ft.type_kind(&c.types, ty) == 1 { covered = true; expect(&mut c, ")"); place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Capacity), 2, c.body.cursor - 3); return 1 }
    if name == "swap" && (ft.type_kind(&c.types, ty) == 1 || ft.type_kind(&c.types, ty) == 6) {
        covered = true; return swap_array(&mut c, ty, place, receiver_at, writable, &catalog, &mut inline_work, &mut model)
    }
    if ty == 4 && c.body.depth == c.body.stream_depth && (name == "bytes" || name == "runes") && is(&c, ")") && ends_for_header(&c, c.body.cursor + 1) {
        covered = true
        if safe_borrowed_string_stream(&c, place) {
            expect(&mut c, ")")
            c.body.stream_kind = 11; if name == "runes" { covered = true; c.body.stream_kind = 15 }
        } else {
            expect(&mut c, ")"); copy_value(&mut c, 4)
            c.body.stream_kind = 1; if name == "runes" { covered = true; c.body.stream_kind = 5 }
        }
        return 4
    }
    if name == "enumerate" && c.body.depth == c.body.stream_depth && is(&c, ")") &&
        c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.kinds[c.body.cursor + 1] == .Symbol && c.world.tokens.texts[c.body.cursor + 1] == "{" {
        if ft.is_map(&c.types, ty) {
            fail(&mut c, "enumerate() is not supported directly on Map; use 'for (k, v) in &map'"); return 0
        }
        can_enum := c.body.stream_kind != 0 || ty == 14 || collection(&c, ty) || ft.is_set(&c.types, ty) ||
            traits.satisfies(&c.traits, &c.types, traits.iterator_id(), ty)
        if !can_enum {
            fail(&mut c, "enumerate() requires a range, array, Set, string stream, or Iterator"); return 0
        }
        covered = true; expect(&mut c, ")")
        c.body.for_enumerate = true
        if place == 0 && c.body.stream_kind == 0 && c.body.expr.move_projection < 0 && c.body.expr.move_temporary >= 0 {
            fc.produce_owner(&mut c.body.expr, c.body.expr.move_temporary, ty)
        }
        if c.body.stream_kind == 0 { c.body.stream_kind = 10 }
        return ty
    }
    if ty == 4 && name == "as_bytes" {
        covered = true; expect(&mut c, ")")
        source_path := owner_path(&c, place); source_root_id := source_root(&c, place); source_origin := loan_origin(&c, place); source_parent := borrow_parent(&c, place)
        source_home := slot(&mut c); arm.store(&mut c.code, source_home, 0)
        for _ in 0..5 { _ := slot(&mut c) }
        data_home := slot(&mut c)
        arm.borrowed_emit_string_bytes(&mut c.code, source_home, data_home)
        holder := slot(&mut c); arm.store(&mut c.code, holder, 0)
        arr_u8 := compound(&mut c, 1, 8)
        place_step(&mut c, .BorrowHome, arr_u8, 3, 0, holder, c.body.cursor - 2)
        c.body.loan.home = holder; c.body.loan.path = source_path
        c.body.loan.root = source_root_id; c.body.loan.origin = source_origin; c.body.loan.parent = source_parent; c.body.loan.constrained = true
        if !constrain_borrow(&mut c) { return 0 }
        return compound(&mut c, 4, arr_u8)
    }
    if name != "str" && (ty == 1 || ty == 2 || unsigned.has(ty)) { return integer_method(&mut c, ty, name, &catalog, &mut inline_work, &mut model, &mut covered) }
    if ty == 4 { copy_value(&mut c, ty); _ := temporary(&mut c, ty) }
    arm.push_temp(&mut c.code, 0)
    mut target := -1; mut ret := ty; mut count := 0; mut operation: ri.Operation = .Format
    if name == "iter" && collection(&c, ty) { covered = true;
        if place != 0 && c.body.depth == c.body.stream_depth && is(&c, ")") && ends_for_header(&c, c.body.cursor + 1) {
            expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0); c.body.stream_kind = 10; return ty
        }
        if place != 0 { fail(&mut c, with_clone_hint(&c, ty, "stored iterators require (move values).iter()", " or values.clone().iter()")); return 0 }
        expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0)
        c.body.places.current = place; c.body.places.source = receiver_at
        if c.body.expr.move_projection < 0 && c.body.expr.move_temporary >= 0 { fc.produce_owner(&mut c.body.expr, c.body.expr.move_temporary, ty) }
        take_value(&mut c, ty)
        return compound(&mut c, 10, ft.type_base(&c.types, ty))
    }
    if ft.type_kind(&c.types, ty) == 1 {
        may_invalidate_operand(&mut c)
        receiver := borrows.root(&c.body.places, place)
        if receiver < 0 { fail(&mut c, "array mutation requires a stored place"); return 0 }
        if !writable_loan(&mut c, place) { return 0 }
        if is_for_locked(&c, owner_path(&c, place)) { fail(&mut c, "cannot mutate a collection while iterating over it"); return 0 }
        record_mutation(&mut c, receiver, owner_path(&c, place)); effects = c.body.mutations.len
        if !writable { fail_immutable_binding(&mut c, "array mutation requires mut or &mut", receiver) }
        if name == "push" { covered = true;
            if !writable { fail_immutable_binding(&mut c, "push requires mutable array", receiver) }
            base := ft.type_base(&c.types, ty)
            consuming := eat(&mut c, "move")
            raw_val := expression(&mut c, 0, base, &catalog, &mut inline_work, &mut model)
            value := coerce_callable(&mut c, base, raw_val, c.body.cursor); same(&mut c, base, value)
            if ft.move_only(&c.types, base) && !is_fresh_owned(&c) && !consuming { fail(&mut c, with_clone_hint(&c, base, "push requires 'move value'", ", .clone(),") + " or a fresh owned expression"); return 0 }
            take_value_boxed(&mut c, value)
            operation = .ArrayPush; target = c.runtime.typed_push[unsigned.shift(storage_type(&c, base))]; count = 1; ret = 0
        } else if name == "reserve" { covered = true; value := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, value); count = 1; operation = .ArrayReserve; target = c.runtime.array_reserve; ret = 0 }
        else if name == "pop" { covered = true; operation = .ArrayPop; target = c.runtime.array_pop; ret = ft.type_base(&c.types, ty) }
        else if name == "remove" {
            covered = true
            index := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, index)
            count = 1; operation = .ArrayRemove; target = c.runtime.array_remove; ret = ft.type_base(&c.types, ty)
        }
        else if name == "clear" { covered = true; expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0); arm.intrinsic_call(&mut c.code, c.runtime.array_clear, .ArrayClear, ty, 0, source); return 0 }
        else if name == "truncate" { covered = true; value := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, value); count = 1; operation = .ArrayTruncate; target = c.runtime.array_truncate; ret = 0 }
    } else if name == "str" { covered = true;
        if ty != 1 && ty != 2 && ty != 3 && ty != 5 && !unsigned.has(ty) { fail(&mut c, "str requires an integer, bool or rune") }
        ret = 4; target = c.runtime.string_integer
        if ty == 3 { target = c.runtime.string_bool }; if ty == 5 { target = c.runtime.string_rune }
    } else if ty == 4 {
        if name == "bytes" { covered = true; operation = .Bytes; target = c.runtime.string_bytes; ret = compound(&mut c, 1, 1) }
        else if name == "runes" { covered = true; operation = .Runes; target = c.runtime.string_runes; ret = compound(&mut c, 1, 5) }
        else if name == "slice" { covered = true;
            first := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, first); arm.push_temp(&mut c.code, 0); expect(&mut c, ",")
            last := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, last); arm.mov(&mut c.code, 2, 0); arm.pop_temp(&mut c.code, 1); arm.pop_temp(&mut c.code, 0)
