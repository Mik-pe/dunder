            skip_token(&mut c)
            name_tok := c.body.cursor
            if c.world.tokens.kinds[name_tok] != .Name { fail(&mut c, "expected trait name"); break }
            t_name := advance(&mut c)
            if traits.lookup(&c.traits, t_name) >= 0 || type_id(&c, t_name) >= 0 || c.world.functions.contains(t_name) || rules.reserved(t_name) {
                c.body.cursor = name_tok; fail(&mut c, "duplicate or reserved trait name"); break
            }
            tid := traits.add_trait(&mut c.traits, move t_name, owner, public, c.world.tokens.starts[name_tok])
            if eat(&mut c, ":") {
                while c.ok {
                    newlines(&mut c)
                    sup_tok := c.body.cursor
                    if c.world.tokens.kinds[sup_tok] != .Name { fail(&mut c, "expected supertrait name"); break }
                    skip_token(&mut c); traits.add_super_token(&mut c.traits, tid, sup_tok)
                    newlines(&mut c)
                    if !eat(&mut c, "+") { break }
                }
            }
            if !c.ok { break }
            newlines(&mut c); expect(&mut c, "{"); if !c.ok { break }
            block_end := c.world.closes[c.body.cursor - 1]
