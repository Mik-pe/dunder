            if (!reserved && type_id(&c, name) >= 0) || c.world.const_map.contains(name) || traits.lookup(&c.traits, name) >= 0 { fail(&mut c, "duplicate type") }
            else if name == "TaskID" || rules.reserved(name) { fail(&mut c, "reserved type name") }
