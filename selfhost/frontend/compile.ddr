                right := expression(&mut c, priority + 1, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, right)
                if observe {
                    c.body.observing_lease = previous
                    if c.body.lease_generation == generation {
                        if owner == c.body.owned_slots.len - 1 {
                            _ := c.body.owned_slots.pop(); _ := c.body.owned_types.pop(); _ := c.body.owner_temps.pop()
                        } else { c.body.owned_slots[owner] = -1 }
                    }
                    else if c.ok {
                        setup := c.code.words.len; reloc := c.code.at.len
                        source := c.world.tokens.starts[op_at]
                        arm.ownership_call(&mut c.code, c.runtime.retain, .Copy, ty, source)
                        install_owner(&mut c, index, ty, source)
                        width := lease.insert(&mut c.code, rhs, setup, first_label, first_reloc, reloc)
                        for i in first_import..c.body.facts.sites.len { c.body.facts.sites[i] = c.body.facts.sites[i] + width * 4 }
                    }
                }
                arm.pop_temp(&mut c.code, 1)
            } else {
                mut spilled := false; mut pending_save := -1
                if c.code.prefixing {
                    pending_save = c.code.prefix.len; spilled = true
                    arm.push_temp(&mut c.code, 0)
                } else if !c.code.checking {
                    spilled = !register_rhs(&c, priority)
                    if spilled { arm.push_temp(&mut c.code, 0) } else { arm.mov(&mut c.code, 1, 0) }
                }
                right := expression(&mut c, priority + 1, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, right)
                if pending_save >= 0 && c.code.prefixing && model.recording && model.value >= 0 {
                    kind := model.nodes.kinds[model.value]
                    if kind == 1 || kind == 2 {
                        arm.replace_temp_push(&mut c.code, pending_save, 1, 0); spilled = false
                    }
                }
                if spilled { arm.pop_temp(&mut c.code, 1) }
            }
            if observe && c.ok && assert_end(&c, c.body.assert_operands.closing_paren, c.body.cursor) {
                capture_assert_operands(&mut c, ty)
            }
            result := binary(&mut c, operator, ty, op_at); ty = temporary(&mut c, result); fc.clear_rvalue_place(&mut c.body.place)
        }
        if model.recording {
            if left_node < 0 || model.value < 0 { model.recording = false }
            else { _ := typed.node(&mut model, 3, ty, left_node, model.value, -1, i64(opcode), -1, op_at) }
        }
    }
    inclusive_range := is(&c, "..=")
    if minimum == 0 && c.world.tokens.kinds[c.body.cursor] == .Symbol && (eat(&mut c, "..") || eat(&mut c, "..=")) {
        range_source := c.world.tokens.starts[c.body.cursor - 1]; range_tok := c.body.cursor - 1; model.recording = false
        place = 0; same(&mut c, 1, ty); arm.push_temp(&mut c.code, 0)
        high := expression(&mut c, 1, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, high)
        if inclusive_range { arm.imm(&mut c.code, 1, 1); _ := binary(&mut c, "+", 1, range_tok) }
        arm.pop_temp(&mut c.code, 1)
        arm.iter_emit(&mut c.code, .PackRange, .Range, 1, range_source)
        ty = 14; fc.clear_rvalue_place(&mut c.body.place)
    }
    if model.probing && ty > 3 && !is(&c, ")") && owned(&c, ty) {
        _ := decline_projection(&mut c, &mut model)
    }
    c.body.places.current = place; c.body.places.source = at
    set_expr_span(&mut c, first_token)
    c.body.depth = c.body.depth - 1
    ty
}
fn place_access(c: &Session) -> borrows.Access {
    if c.body.place.taking_address { return .ValueAndAddress }
    mut at := c.body.cursor
    while at < c.world.tokens.kinds.len && c.world.tokens.kinds[at] == .Symbol && c.world.tokens.texts[at] == ")" { at = at + 1 }
    if at >= c.world.tokens.kinds.len || c.world.tokens.kinds[at] != .Symbol { return .Value }
    next := c.world.tokens.texts[at].clone()
    if next == "=" { return .Address }
    if next.len == 2 && fc.assign_operator(next) != "" { return .ValueAndAddress }
    .Value
}
fn is_for_locked_except(c: &Session, path: i32, skip: i32) -> bool {
    ownership_check.is_for_locked_except(&c.body, path, skip)
}
fn is_for_locked(c: &Session, path: i32) -> bool {
    ownership_check.is_for_locked(&c.body, path)
}
fn move_loop_begin(c: &mut Session) {
    ownership.loop_begin(&mut c.body.ownership)
}
fn move_loop_backedge(c: &mut Session) {
    path := ownership.loop_backedge(&mut c.body.ownership)
    if path >= 0 {
        root := ownership.local_root(&c.body.ownership, path)
        fail(&mut c, "moved value '" + c.body.locals.names[root] + "' must be reinitialized before the next loop iteration")
    }
}
fn move_loop_break(c: &mut Session) {
    ownership.loop_break(&mut c.body.ownership)
}
fn move_loop_end(c: &mut Session, exit: &ownership.Checkpoint) {
    ownership.loop_end_checkpoint(&mut c.body.ownership, &exit)
}
fn begin_loop_scope(c: &mut Session, head: i32, end: i32) {
    c.body.loop_heads.push(head); c.body.loop_ends.push(end)
    c.body.loop_owners.push(c.body.owned_slots.len); c.body.loop_defers.push(c.body.defers.bodies.len)
    c.body.loop_operands.push(c.code.operand_depth); c.body.loop_pending.push(c.body.pending.slots.len)
    if c.tasks.program { c.body.loop_task_locals.push(c.body.locals.active.len) }
}
fn end_loop_scope(c: &mut Session) {
    _ := c.body.loop_heads.pop(); _ := c.body.loop_ends.pop()
    _ := c.body.loop_owners.pop(); _ := c.body.loop_defers.pop()
    _ := c.body.loop_operands.pop(); _ := c.body.loop_pending.pop()
    if c.tasks.program { _ := c.body.loop_task_locals.pop() }
}
fn unwind_exit(c: &mut Session, floor: i32, target_depth: i32) {
    if !c.ok || c.code.checking { return }
    mut cleaned_to := c.body.owned_slots.len
    mut depth := c.code.operand_depth
    mut d := c.body.defers.bodies.len - 1
    while d >= floor {
        limit := c.body.defers.owner_limits[d]
        mut i := cleaned_to - 1
        while i >= limit {
            if c.body.owned_slots[i] >= 0 { clear_owner(&mut c, c.body.owned_slots[i], c.body.owned_types[i]) }
            i = i - 1
        }
        cleaned_to = limit
        arm.discard_operands(&mut c.code, depth, c.body.defers.operand_depths[d])
        depth = c.body.defers.operand_depths[d]
        if c.body.defers.selector < 0 { c.body.defers.selector = slot(&mut c) }
        if c.body.defers.entries[d] < 0 { entry := new_block(&mut c); c.body.defers.entries[d] = entry }
        resume := new_block(&mut c)
        edge := deferred.add_exit(&mut c.body.defers, d, resume)
        arm.imm(&mut c.code, 0, i64(edge) + 1); arm.store(&mut c.code, c.body.defers.selector, 0)
        source_edge(&mut c, c.body.defers.entries[d], .Defer, c.body.defers.bodies[d]); bind_block(&mut c, resume)
        d = d - 1
    }
    arm.discard_operands(&mut c.code, depth, target_depth)
}
fn return_from_body(c: &mut Session, at: i32) {
    if c.body.view_result_destination >= 0 { arm.borrowed_return_to(&mut c.code, c.body.view_result_destination) }
    else if c.body.pod_result_destination >= 0 { copy_pod_into_addr(&mut c, c.body.ret_type, c.body.pod_result_destination, at) }
    preserve := !c.code.checking && (c.body.defers.bodies.len > 0 || c.body.pending.slots.len > 0)
    if preserve && c.body.ret_type != 0 {
        if c.body.defers.return_slot < 0 { c.body.defers.return_slot = slot(&mut c) }
        arm.store(&mut c.code, c.body.defers.return_slot, 0)
    }
    unwind_exit(&mut c, 0, 0)
    if preserve {
        cleanup_pending(&mut c, 0)
        if c.body.ret_type != 0 { arm.load(&mut c.code, c.body.defers.return_slot) }
        else { arm.imm(&mut c.code, 0, 0) }
    }
    source_edge(&mut c, c.body.cleanup, .Return, at)
    ownership.terminate(&mut c.body.ownership)
}
fn resume_defer_exit(c: &mut Session, head: i32) {
    if head < 0 { return }
    arm.load(&mut c.code, c.body.defers.selector)
    mut edge := head
    while c.body.defers.previous[edge] >= 0 {
        arm.imm(&mut c.code, 2, i64(edge) + 1)
        arm.compare_register(&mut c.code, 0, 2)
        source_edge(&mut c, c.body.defers.targets[edge], .Resume, c.body.cursor)
        edge = c.body.defers.previous[edge]
    }
    source_edge(&mut c, c.body.defers.targets[edge], .WhenTrue, c.body.cursor)
}
fn block(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    enter(&mut c)
    block_body(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
}
fn scoped_body(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    end := c.world.closes[c.body.cursor]; enclosing := c.body.value_block.end
    allowed := c.body.tail && terminal(&c, end + 1, true)
    if ends_value_block(&c, end + 1) { c.body.value_block.end = end }
    exits := block_body(&mut c, allowed, &catalog, &mut inline_work, &mut model)
    c.body.value_block.end = enclosing
    exits
}
fn sync_to_next_statement(c: &mut Session, stmt_start: i32, limit: i32) {
    mut depth := 0
    mut i := stmt_start
    while i < c.body.cursor && i < limit {
        k := c.world.tokens.kinds[i]
        if k == .Symbol {
            w := &c.world.tokens.texts[i]
            if w == "(" || w == "[" || w == "{" { depth += 1 }
            else if w == ")" || w == "]" || w == "}" {
                if depth > 0 { depth -= 1 }
            }
        }
        i += 1
    }
    if c.body.cursor <= stmt_start && c.body.cursor < limit {
        k := c.world.tokens.kinds[c.body.cursor]
        if k == .Symbol {
            w := &c.world.tokens.texts[c.body.cursor]
            if w == "(" || w == "[" || w == "{" { depth += 1 }
        }
        c.body.cursor += 1
    }
    while c.body.cursor < limit {
        k := c.world.tokens.kinds[c.body.cursor]
        if k == .End { break }
        if depth == 0 && (lexer.is_newline(k) || (k == .Symbol && (c.world.tokens.texts[c.body.cursor] == ";" || c.world.tokens.texts[c.body.cursor] == "}"))) {
            break
        }
        if k == .Symbol {
            w := &c.world.tokens.texts[c.body.cursor]
            if w == "(" || w == "[" || w == "{" { depth += 1 }
            else if w == ")" || w == "]" || w == "}" {
                if depth > 0 { depth -= 1 }
                else { break }
            }
        }
        c.body.cursor += 1
    }
    if c.body.cursor > limit { c.body.cursor = limit }
}
fn block_body(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    if !c.ok { return false }
    c.body.block_depth = c.body.block_depth + 1
    if c.body.block_depth > 128 { fail(&mut c, "block nesting exceeds 128"); c.body.block_depth = c.body.block_depth - 1; return false }
    previous_end := c.body.block_end; previous_tail := c.body.tail
    this_end := c.world.closes[c.body.cursor]
    c.body.block_end = this_end; c.body.tail = tail_allowed
    mut body := -1; mut previous := -1
    if model.recording { body = typed.node(&mut model, 10, 0, -1, -1, -1, 0, -1, c.body.cursor) }
    expect(&mut c, "{"); separators(&mut c)
    mut returns := false
    live_entry := ownership.falls_through(&c.body.ownership)
    while c.ok && !is(&c, "}") {
        if c.world.tokens.kinds[c.body.cursor] == .End { fail(&mut c, "unterminated block"); break }
        stmt_start := c.body.cursor
        first_owner := c.body.owned_slots.len
        saved_scope := c.body.scope
        saved_block_depth := c.body.block_depth
        saved_expr_depth := c.body.depth
        saved_op_depth := c.code.operand_depth
        saved_locks := c.body.for_locks.len
        saved_loops := c.body.loop_heads.len
        saved_ow_loops := ownership.loop_depth(&c.body.ownership)
        saved_defers := c.body.defers.bodies.len
        saved_pending := c.body.pending.slots.len
        saved_free_args := c.body.free_arg_slots.len
        saved_in_defer := c.body.in_defer
        saved_reenter := c.body.reenter_owners
        saved_addr := c.body.place.taking_address
        saved_stream_depth := c.body.stream_depth
        saved_stream_kind := c.body.stream_kind
        saved_vblock_end := c.body.value_block.end
        saved_vblock_home := c.body.value_block.home
        saved_vblock_exp := c.body.value_block.expected
        saved_vblock_ty := c.body.value_block.ty
        saved_vblock_arm := c.body.value_block.match_arm
        model.value = -1
        ends := statement(&mut c, &catalog, &mut inline_work, &mut model); returns = returns || ends
        if !c.ok {
            c.body_had_error = true
            c.has_errors = true
            if c.suppress_diagnostics || c.discovering || c.code.prefixing || model.probing || diag.limit_reached(&c.diag_bag) || this_end < 0 {
                break
            }
            if !c.code.checking {
                c.code.checking = true; c.code.forbid_emit = true; c.code.mir_capture = false
            }
            ownership.pop_loops_to(&mut c.body.ownership, saved_ow_loops)
            ownership.resume(&mut c.body.ownership)
            c.body.block_end = this_end
            c.body.tail = tail_allowed
            c.body.block_depth = saved_block_depth
            c.body.depth = saved_expr_depth
            c.code.operand_depth = saved_op_depth
            c.body.in_defer = saved_in_defer
            c.body.reenter_owners = saved_reenter
            c.body.place.taking_address = saved_addr
            c.body.stream_depth = saved_stream_depth
            c.body.stream_kind = saved_stream_kind
            c.body.value_block.end = saved_vblock_end
            c.body.value_block.home = saved_vblock_home
            c.body.value_block.expected = saved_vblock_exp
            c.body.value_block.ty = saved_vblock_ty
            c.body.value_block.match_arm = saved_vblock_arm
            while c.body.for_locks.len > saved_locks { _ := c.body.for_locks.pop() }
            while c.body.loop_heads.len > saved_loops {
                _ := c.body.loop_heads.pop(); _ := c.body.loop_ends.pop()
                _ := c.body.loop_owners.pop(); _ := c.body.loop_defers.pop()
                _ := c.body.loop_operands.pop(); _ := c.body.loop_pending.pop()
                if c.tasks.program && c.body.loop_task_locals.len > saved_loops { _ := c.body.loop_task_locals.pop() }
            }
            while c.body.defers.bodies.len > saved_defers {
                _ := c.body.defers.bodies.pop(); _ := c.body.defers.scopes.pop()
                _ := c.body.defers.owner_limits.pop(); _ := c.body.defers.local_limits.pop()
                _ := c.body.defers.entries.pop(); _ := c.body.defers.exits.pop()
                _ := c.body.defers.operand_depths.pop()
            }
            fc.finish_pending(&mut c.body.pending, saved_pending)
            while c.body.owned_slots.len > first_owner {
                _ := c.body.owned_slots.pop(); _ := c.body.owned_types.pop(); _ := c.body.owner_temps.pop()
            }
            while c.body.free_arg_slots.len > saved_free_args { _ := c.body.free_arg_slots.pop() }
            while c.body.scope > saved_scope { leave(&mut c) }
            fc.clear_expr(&mut c.body.expr); fc.reset_place_state(&mut c.body.place); fc.reset_loan_state(&mut c.body.loan)
            c.body.last_expr_start = -1; c.body.last_expr_end = -1
            sync_to_next_statement(&mut c, stmt_start, this_end)
            c.ok = true; c.error = ""; c.error_note = ""; c.error_note_at = -1; c.types.error = ""
            returns = true
            separators(&mut c)
            continue
        }
        if model.recording { previous = typed.append(&mut model, body, previous) }
        cleanup_from(&mut c, first_owner, true)
        separators(&mut c)
    }
    while c.ok && c.body.defers.scopes.len > 0 && c.body.defers.scopes[c.body.defers.scopes.len - 1] == c.body.scope {
        body := c.body.defers.bodies.pop(); _ := c.body.defers.scopes.pop()
        _ := c.body.defers.owner_limits.pop(); locals := c.body.defers.local_limits.pop()
        entry := c.body.defers.entries.pop(); exits := c.body.defers.exits.pop()
        _ := c.body.defers.operand_depths.pop()
        drop_locals_to(&mut c, locals, c.body.scope)
        if entry >= 0 {
            arm.store(&mut c.code, c.body.defers.selector, 31); bind_block(&mut c, entry)
        }
        saved := c.body.cursor; c.body.cursor = body
        c.body.in_defer = true; c.body.defer_loop_floor = c.body.loop_heads.len
        _ := block(&mut c, false, &catalog, &mut inline_work, &mut model)
        c.body.in_defer = false; c.body.cursor = saved
        lock_limit := c.body.move_defer_limits.pop()
        while c.body.move_defer_locks.len > lock_limit { _ := c.body.move_defer_locks.pop() }
        resume_defer_exit(&mut c, exits)
    }
    expect(&mut c, "}"); leave(&mut c)
    model.value = body
    c.body.block_end = previous_end; c.body.tail = previous_tail; c.body.block_depth = c.body.block_depth - 1
    returns || (live_entry && !ownership.falls_through(&c.body.ownership))
}
fn terminal(c: &Session, after: i32, semicolons: bool) -> bool {
    mut pos := after
    while pos < c.world.tokens.texts.len && (lexer.is_newline(c.world.tokens.kinds[pos]) || (semicolons && c.world.tokens.texts[pos] == ";")) { pos = pos + 1 }
    pos == c.body.block_end
}
fn end_statement(c: &mut Session) {
    if c.ok && !is(&c, "\n") && !is(&c, ";") && !is(&c, "}") && c.world.tokens.kinds[c.body.cursor] != .End { fail(&mut c, "expected newline or semicolon") }
}
fn ends_value_block(c: &Session, after: i32) -> bool {
    c.body.value_block.end == c.body.block_end && terminal(&c, after, false)
}
fn nested_choice_tail(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    expected := c.body.value_block.expected; home := c.body.value_block.home
    ty := choice_arms(&mut c, expected, home, &catalog, &mut inline_work, &mut model)
    c.body.value_block.ty = ty
    ty == 0
}
fn join_statement_outcomes(state: &mut ownership.State, left: &ownership.Checkpoint, left_terminal: bool,
    right: &ownership.Checkpoint, right_terminal: bool) {
    if left_terminal && !right_terminal { ownership.restore_checkpoint(&mut state, &right) }
    else if !left_terminal && right_terminal { ownership.restore_checkpoint(&mut state, &left) }
    else { ownership.join_checkpoints(&mut state, &left, &right) }
}
fn conditional(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "conditional nesting exceeds 128"); c.body.depth = c.body.depth - 1; return false }
    result := conditional_inner(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
    c.body.depth = c.body.depth - 1
    result
}
fn conditional_inner(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor - 1
    mut cond_end := c.body.cursor
    folded := tc_eval.eval_target_or(&c.world.tokens, &c.body.locals, c.code.platform, c.body.cursor, &mut cond_end)
    if folded >= 0 && cond_end < c.world.tokens.kinds.len && tc_eval.tok_is(&c.world.tokens, cond_end, "{") {
        c.body.cursor = cond_end
        if folded == 1 {
            taken := block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
            newlines(&mut c)
            if eat(&mut c, "else") {
                if eat(&mut c, "if") { c.body.cursor = lookahead.conditional_end(&c.world.tokens, &c.world.closes, &c.types, &c.body.locals, c.body.cursor) }
                else { skip_body(&mut c) }
            }
            return taken
        }
        skip_body(&mut c)
        newlines(&mut c)
        if eat(&mut c, "else") {
            if eat(&mut c, "if") { return conditional(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model) }
            return block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
        }
        if model.recording { _ := typed.node(&mut model, 10, 0, -1, -1, -1, 0, -1, at) }
        return false
    }
    condition_at := c.body.cursor; ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty)
    condition := model.value
    before_branch := ownership.checkpoint(&c.body.ownership)
    otherwise := new_block(&mut c); done := new_block(&mut c)
    source_edge(&mut c, otherwise, .WhenFalse, condition_at)
    then_block := new_block(&mut c); bind_block(&mut c, then_block)
    left := block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model); source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, otherwise)
    yes := model.value
    left_state := ownership.checkpoint(&c.body.ownership)
    ownership.restore_checkpoint(&mut c.body.ownership, &before_branch)
    newlines(&mut c)
    mut right := false; mut no := -1
    if eat(&mut c, "else") {
        if eat(&mut c, "if") {
            right = conditional(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
            if model.recording { no = typed.node(&mut model, 10, 0, model.value, -1, -1, 0, -1, at) }
        } else { right = block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model); no = model.value }
    }
    if model.recording { _ := typed.node(&mut model, 13, 0, condition, yes, no, 0, -1, at) }
    right_state := ownership.checkpoint(&c.body.ownership)
    join_statement_outcomes(&mut c.body.ownership, &left_state, left, &right_state, right)
    bind_block(&mut c, done)
    left && right
}
struct PatternBindings {
    tokens: []i32, types: []i32, parents: []i32, offsets: []i32,
    locals: []i32, mutable: []bool, or_sources: []i32,
}
fn empty_pattern_bindings() -> PatternBindings {
    PatternBindings { tokens: [], types: [], parents: [], offsets: [], locals: [], mutable: [], or_sources: [] }
}
fn matchable_subject(c: &Session, ty: i32) -> bool {
    enum_type(&c, ty) || ty == 1 || ty == 2 || unsigned.has(ty) || ty == 3 || ty == 4 || ty == 5 || ft.is_tuple(&c.types, ty)
}
fn has_or_alternative(tokens: &lexer.Tokens, start: i32) -> bool {
    mut at := start; mut depth := 0
    while at < tokens.kinds.len {
        kind := tokens.kinds[at]; word := &tokens.texts[at]
        if kind == .End { return false }
        if kind == .Symbol {
            if word == "(" || word == "[" || word == "{" { depth += 1 }
            else if word == ")" || word == "]" || word == "}" {
                if depth == 0 { return false }
                depth -= 1
            } else if depth == 0 {
                if word == "=>" || word == "," || word == ";" { return false }
                if word == "|" { return true }
            }
        } else if depth == 0 && kind == .Keyword && word == "if" {
            return false
        }
        at += 1
    }
    false
}
fn rest_trailing_count(c: &Session, start: i32) -> i32 {
    mut at := start
    while at < c.world.tokens.kinds.len && lexer.is_newline(c.world.tokens.kinds[at]) { at += 1 }
    if at < c.world.tokens.kinds.len && c.world.tokens.texts[at] == "," { at += 1 }
    mut depth := 0; mut count := 0; mut has_item := false
    while at < c.world.tokens.kinds.len {
        kind := c.world.tokens.kinds[at]; word := &c.world.tokens.texts[at]
        if kind == .End { break }
        if kind == .Symbol && (word == "(" || word == "[" || word == "{") {
            has_item = true; depth += 1
        } else if kind == .Symbol && (word == ")" || word == "]" || word == "}") {
            if depth == 0 {
                if has_item { count += 1 }
                break
            }
            depth -= 1; has_item = true
        } else if depth == 0 && kind == .Symbol && word == "," {
            if has_item { count += 1; has_item = false }
        } else if !lexer.is_newline(kind) {
            has_item = true
        }
        at += 1
    }
    count
}
fn load_pattern_subject(c: &mut Session, ty: i32, parent: i32, member_index: i32, token: i32) {
    arm.load(&mut c.code, parent)
    if member_index >= 0 {
        place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), member_index, token)
    }
}
fn match_pattern(c: &mut Session, patterns: &mut coverage.Patterns, bindings: &mut PatternBindings,
                 ty: i32, parent: i32, member_index: i32, next: i32, depth: i32) -> i32 {
    if depth > 128 { fail(&mut c, "match pattern nesting exceeds 128"); return -1 }
    if !has_or_alternative(&c.world.tokens, c.body.cursor) {
        return match_pattern_single(&mut c, &mut patterns, &mut bindings, ty, parent, member_index, next, depth)
    }
    joined := new_block(&mut c)
    root := coverage.or_node(&mut patterns)
    mut first_branch := true
    mut alt_start := 0
    while c.ok {
        newlines(&mut c)
        more := has_or_alternative(&c.world.tokens, c.body.cursor)
        mut branch_next := next
        if more { branch_next = new_block(&mut c) }
        mut alt := empty_pattern_bindings()
        _ := match_pattern_single(&mut c, &mut patterns, &mut alt, ty, parent, member_index, branch_next, depth + 1)
        if !c.ok { return -1 }
        if first_branch {
            alt_start = bindings.tokens.len
            mut seen_names: []string = []
            for i in 0..alt.tokens.len {
                bname := c.world.tokens.texts[alt.tokens[i]].clone()
                for prev in &seen_names {
                    if prev == bname { fail(&mut c, "duplicate binding '" + bname + "' in pattern"); return -1 }
                }
                seen_names.push(move bname)
                shared := slot(&mut c); src_slot := slot(&mut c)
                bindings.tokens.push(alt.tokens[i]); bindings.types.push(alt.types[i])
                bindings.parents.push(shared); bindings.offsets.push(-1)
                bindings.mutable.push(alt.mutable[i]); bindings.or_sources.push(src_slot)
            }
            first_branch = false
        }
        expected_count := bindings.tokens.len - alt_start
        if alt.tokens.len != expected_count {
            fail(&mut c, "or-pattern alternatives must bind the same names with the same types"); return -1
        }
        mut matched: []bool = []
        for _ in 0..expected_count { matched.push(false) }
        for i in 0..alt.tokens.len {
            bname := c.world.tokens.texts[alt.tokens[i]].clone()
            mut idx := -1
            for k in 0..expected_count {
                if c.world.tokens.texts[bindings.tokens[alt_start + k]] == bname { idx = k; break }
            }
            if idx < 0 || matched[idx] {
                fail(&mut c, "or-pattern alternatives must bind the same names with the same types"); return -1
            }
            if bindings.types[alt_start + idx] != alt.types[i] || bindings.mutable[alt_start + idx] != alt.mutable[i] {
                fail(&mut c, "or-pattern alternatives must bind the same names with the same types"); return -1
            }
            matched[idx] = true
            arm.load(&mut c.code, alt.parents[i])
            if alt.offsets[i] >= 0 {
                if ft.move_only(&c.types, alt.types[i]) {
                    arm.integer_binary(&mut c.code, 1, true, false, 0, 0, -1, i64(alt.offsets[i]))
                    arm.store(&mut c.code, bindings.or_sources[alt_start + idx], 0)
                    arm.load(&mut c.code, alt.parents[i])
                } else {
                    arm.store(&mut c.code, bindings.or_sources[alt_start + idx], 31)
                }
                place_step(&mut c, .Member, alt.types[i], 0, i32(place_op.Member.Payload), alt.offsets[i] / 8, alt.tokens[i])
            } else {
                arm.store(&mut c.code, bindings.or_sources[alt_start + idx], 31)
            }
            arm.store(&mut c.code, bindings.parents[alt_start + idx], 0)
        }
        newlines(&mut c)
        source_edge(&mut c, joined, .Jump, c.body.cursor)
        if !more { break }
        expect(&mut c, "|")
        bind_block(&mut c, branch_next)
    }
    bind_block(&mut c, joined)
    coverage.close(&mut patterns, root)
    root
}
fn match_pattern_single(c: &mut Session, patterns: &mut coverage.Patterns, bindings: &mut PatternBindings,
                        ty: i32, parent: i32, member_index: i32, next: i32, depth: i32) -> i32 {
    if depth > 128 { fail(&mut c, "match pattern nesting exceeds 128"); return -1 }
    newlines(&mut c)
    if eat(&mut c, "_") { return coverage.node(&mut patterns, -1) }
    pat_at := c.body.cursor; pat_kind := c.world.tokens.kinds[pat_at]
    if eat(&mut c, "true") || eat(&mut c, "false") {
        if ty != 3 { fail(&mut c, "bool pattern requires a bool"); return -1 }
        val := c.world.tokens.texts[pat_at] == "true"
        load_pattern_subject(&mut c, 3, parent, member_index, pat_at)
        arm.imm(&mut c.code, 1, if val { 1 } else { 0 })
        arm.compare_register(&mut c.code, 0, 1); source_edge(&mut c, next, .NextVariant, pat_at)
        return coverage.bool_node(&mut patterns, val)
    }
    if pat_kind == .Integer || (is(&c, "-") && pat_at + 1 < c.world.tokens.kinds.len && c.world.tokens.kinds[pat_at + 1] == .Integer) {
        if ty != 1 && ty != 2 && !unsigned.has(ty) { fail(&mut c, "integer pattern requires an integer type"); return -1 }
        neg := eat(&mut c, "-")
        if neg && unsigned.has(ty) { fail(&mut c, "negative integer pattern is invalid for unsigned type"); return -1 }
        lit := advance(&mut c)
        spelling := if neg { "-" + lit } else { lit }
        val := integer_literal(&mut c, spelling, ty)
        if !c.ok { return -1 }
        load_pattern_subject(&mut c, ty, parent, member_index, pat_at)
        if ty == 1 { arm.sign_extend_i32(&mut c.code, 0, 0) }
        arm.imm(&mut c.code, 1, val)
        arm.compare_register(&mut c.code, 0, 1); source_edge(&mut c, next, .NextVariant, pat_at)
        return coverage.int_node(&mut patterns, val)
    }
    if pat_kind == .Rune {
        if ty != 5 { fail(&mut c, "rune pattern requires a rune"); return -1 }
        text := advance(&mut c)
        scalar := text.runes()[0]
        load_pattern_subject(&mut c, 5, parent, member_index, pat_at)
        arm.imm(&mut c.code, 1, i64(i32(scalar)))
        arm.compare_register(&mut c.code, 0, 1); source_edge(&mut c, next, .NextVariant, pat_at)
        return coverage.int_node(&mut patterns, i64(i32(scalar)))
    }
    if pat_kind == .String {
        if ty != 4 { fail(&mut c, "string pattern requires a string"); return -1 }
        text := advance(&mut c)
        load_pattern_subject(&mut c, 4, parent, member_index, pat_at)
        arm.push_temp(&mut c.code, 0)
        lit_label := arm.label(&mut c.code)
        if !c.code.checking { c.body.facts.literal_tokens.push(pat_at); c.body.facts.literal_labels.push(lit_label) }
        arm.branch(&mut c.code, lit_label, 20)
        arm.mov(&mut c.code, 1, 0); arm.pop_temp(&mut c.code, 0)
        arm.intrinsic_call(&mut c.code, c.runtime.string_compare, .Compare, 4, 1, c.world.tokens.starts[pat_at])
        arm.imm(&mut c.code, 1, 0)
        arm.compare_register(&mut c.code, 0, 1); source_edge(&mut c, next, .NextVariant, pat_at)
        return coverage.string_node(&mut patterns, move text)
    }
    if eat(&mut c, "(") {
        if !ft.is_tuple(&c.types, ty) { fail(&mut c, "tuple pattern requires a tuple"); return -1 }
        root := coverage.tuple_node(&mut patterns)
        count := ft.type_count(&c.types, ty)
        first := ft.type_start(&c.types, ty)
        mut payload := parent
        if member_index >= 0 {
            load_pattern_subject(&mut c, ty, parent, member_index, pat_at)
            payload = slot(&mut c); arm.store(&mut c.code, payload, 0)
        }
        newlines(&mut c)
        mut idx := 0; mut saw_rest := false
        while c.ok && !is(&c, ")") {
            if c.world.tokens.kinds[c.body.cursor] == .Symbol && c.world.tokens.texts[c.body.cursor] == ".." {
                if saw_rest { fail(&mut c, "only one '..' wildcard is allowed per pattern"); return -1 }
                saw_rest = true; skip_token(&mut c)
                trailing := rest_trailing_count(&c, c.body.cursor)
                skip := count - trailing - idx
                if skip < 0 { fail(&mut c, "too many elements in tuple pattern"); return -1 }
                for _ in 0..skip { _ := coverage.node(&mut patterns, -1) }
                idx += skip
            } else {
                if idx >= count { fail(&mut c, "tuple pattern expects " + count.str() + " elements"); return -1 }
                et := c.types.field_types[first + idx]
                _ := match_pattern(&mut c, &mut patterns, &mut bindings, et, payload, idx, next, depth + 1)
                if !c.ok { return -1 }
                idx += 1
            }
            newlines(&mut c)
            if !eat(&mut c, ",") { break }
            newlines(&mut c)
        }
        if !c.ok { return -1 }
        expect(&mut c, ")")
        if !saw_rest && idx != count {
            fail(&mut c, "tuple pattern expects " + count.str() + " elements"); return -1
        }
        coverage.close(&mut patterns, root)
        return root
    }
    if ((is(&c, "mut") && c.world.tokens.kinds[c.body.cursor + 1] == .Name &&
            c.world.tokens.texts[c.body.cursor + 1] != "_" &&
            c.world.tokens.texts[c.body.cursor + 2] != ".") ||
        (c.world.tokens.kinds[c.body.cursor] == .Name && c.world.tokens.texts[c.body.cursor + 1] != ".")) {
        is_mut := eat(&mut c, "mut")
        bindings.tokens.push(c.body.cursor); bindings.types.push(ty)
        bindings.parents.push(parent)
        bindings.offsets.push(if member_index < 0 { -1 } else { member_index * 8 })
        bindings.mutable.push(is_mut); bindings.or_sources.push(-1)
        skip_token(&mut c)
        return coverage.node(&mut patterns, -1)
    }
    if !enum_type(&c, ty) { fail(&mut c, "match pattern requires an enum"); return -1 }
    if !is(&c, ".") {
        mut actual := -1
        if c.world.tokens.kinds[c.body.cursor] == .Name {
            name := advance(&mut c)
            actual = resolve_type_name(&c, name)
        }
        if !c.ok || actual != ty {
            fail(&mut c, "wrong enum in match pattern"); return -1
        }
    }
    expect(&mut c, ".")
    if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected enum variant in match pattern"); return -1 }
    found := field(&c, ty, peek(&c))
    if found < 0 { fail(&mut c, "unknown match variant"); return -1 }
    pattern_at := c.body.cursor; name := advance(&mut c)
    root := coverage.node(&mut patterns, found)
    count := c.types.payload_counts[found]
    mut payload := parent
    arm.load(&mut c.code, parent)
    if member_index >= 0 {
        place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), member_index, pattern_at)
        if count > 0 { payload = slot(&mut c); arm.store(&mut c.code, payload, 0) }
    }
    if ft.type_kind(&c.types, ty) == 7 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Tag), 0, pattern_at) }
    arm.imm(&mut c.code, 1, c.types.field_values[found])
    arm.compare_register(&mut c.code, 0, 1); source_edge(&mut c, next, .NextVariant, pattern_at)
    if count > 0 {
        if !eat(&mut c, "(") {
            if count == 1 {
                fail(&mut c, "variant '." + name + "' carries a payload; write '." + name + "(v)' or '." + name + "(_)'")
            } else {
                fail(&mut c, "variant '." + name + "' requires " + count.str() + " payload bindings; write '." + name + "(...)'")
            }
            set_error_at(&mut c, c.world.tokens.starts[pattern_at]); return -1
        }
        newlines(&mut c)
        mut idx := 0; mut saw_rest := false
        while c.ok && !is(&c, ")") {
            if c.world.tokens.kinds[c.body.cursor] == .Symbol && c.world.tokens.texts[c.body.cursor] == ".." {
                if saw_rest { fail(&mut c, "only one '..' wildcard is allowed per pattern"); return -1 }
                saw_rest = true; skip_token(&mut c)
                trailing := rest_trailing_count(&c, c.body.cursor)
                skip := count - trailing - idx
                if skip < 0 { fail(&mut c, "too many payload bindings for variant '." + name + "'"); return -1 }
                for _ in 0..skip { _ := coverage.node(&mut patterns, -1) }
                idx += skip
            } else {
                if idx >= count { fail(&mut c, "too many payload bindings for variant '." + name + "'"); return -1 }
                pt := c.types.payload_types[c.types.payload_starts[found] + idx]
                _ := match_pattern(&mut c, &mut patterns, &mut bindings, pt, payload, idx + 1, next, depth + 1)
                if !c.ok { return -1 }
                idx += 1
            }
            newlines(&mut c)
            if !eat(&mut c, ",") { break }
            newlines(&mut c)
        }
        if !c.ok { return -1 }
        expect(&mut c, ")")
        if !saw_rest && idx != count {
            fail(&mut c, "variant '." + name + "' requires " + count.str() + " payload bindings; write '." + name + "(...)'")
            set_error_at(&mut c, c.world.tokens.starts[pattern_at]); return -1
        }
    } else if ft.is_result(&c.types, ty) && eat(&mut c, "(") {
        expect(&mut c, "_"); expect(&mut c, ")")
    }
    coverage.close(&mut patterns, root)
    root
}
fn transfer_pattern(c: &mut Session, bindings: &PatternBindings, i: i32) {
    ty := bindings.types[i]; id := bindings.locals[i]
    home := places.local_home(c.body.places.arena.locals[id])
    if bindings.or_sources[i] >= 0 {
        zero_done := arm.label(&mut c.code)
        arm.load(&mut c.code, bindings.or_sources[i])
        arm.branch(&mut c.code, zero_done, 18)
        store_mem(&mut c, 31, 0, 0)
        arm.mark(&mut c.code, zero_done)
    } else if bindings.offsets[i] >= 0 {
        arm.load(&mut c.code, home)
        arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, bindings.parents[i])
        store_mem(&mut c, 31, 0, bindings.offsets[i]); arm.pop_temp(&mut c.code, 0)
    } else {
        owner_store(&mut c, .Vacate, ty, bindings.parents[i])
    }
    owner_store(&mut c, .Vacate, ty, home)
    save_owner(&mut c, home, ty, false)
}
fn push_pattern_loan(c: &mut Session, local: i32, subject_place: i32, parent: i32, offset: i32, lock_index: i32) {
    c.body.pattern_loans.locals.push(local)
    c.body.pattern_loans.subject_places.push(subject_place)
    c.body.pattern_loans.parent_slots.push(parent)
    c.body.pattern_loans.offsets.push(offset)
    c.body.pattern_loans.lock_indices.push(lock_index)
}
fn bind_pattern(c: &mut Session, model: &mut opt_ir.Function, bindings: &mut PatternBindings, guarded: bool, borrowed: bool, subject_movable: bool, subject_place: i32, lock_index: i32) {
    for i in 0..bindings.tokens.len {
        at := bindings.tokens[i]; ty := bindings.types[i]; index := slot(&mut c)
        bind(&mut c, &mut model, c.world.tokens.texts[at].clone(), ty, bindings.mutable[i], index, at)
        id := c.body.locals.types.len - 1; bindings.locals.push(id)
        arm.load(&mut c.code, bindings.parents[i])
        if bindings.offsets[i] >= 0 {
            place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), bindings.offsets[i] / 8, at)
        }
        if (borrowed && owned(&c, ty)) || ft.move_only(&c.types, ty) {
            arm.store(&mut c.code, index, 0)
            if !guarded && borrowed && subject_movable && ft.move_only(&c.types, ty) && bindings.offsets[i] >= 0 && bindings.or_sources[i] < 0 {
                push_pattern_loan(&mut c, id, subject_place, bindings.parents[i], bindings.offsets[i], lock_index)
            } else if guarded || borrowed {
                c.body.pattern_borrowed.push(id)
            } else {
                transfer_pattern(&mut c, &bindings, i)
            }
        } else {
            copy_value(&mut c, ty)
            if frame_owned(&c, ty) { save_owner(&mut c, index, ty, false) } else { arm.store(&mut c.code, index, 0) }
        }
    }
}
fn match_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    mut unused_type := 0
    match_arms(&mut c, -1, -1, &mut unused_type, &catalog, &mut inline_work, &mut model)
}
fn match_guard(c: &mut Session, first_owner: i32, first_borrow: i32, next: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) {
    newlines(&mut c)
    condition_at := c.body.cursor; condition := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model)
    same(&mut c, 3, condition)
    if !c.ok { return }
    if first_owner == c.body.owned_slots.len && first_borrow == c.body.pattern_borrowed.len { source_edge(&mut c, next, .WhenFalse, condition_at); return }
    accepted := new_block(&mut c)
    source_edge(&mut c, accepted, .WhenTrue, condition_at)
    cleanup_from(&mut c, first_owner, false)
    for i in first_borrow..c.body.pattern_borrowed.len {
        id := c.body.pattern_borrowed[i]
        owner_store(&mut c, .Vacate, c.body.locals.types[id], places.local_home(c.body.places.arena.locals[id]))
    }
    source_edge(&mut c, next, .Jump, condition_at); bind_block(&mut c, accepted)
}
fn emit_loop_exit(c: &mut Session, name: string, exit_at: i32, model: &mut opt_ir.Function) -> bool {
    if c.body.loop_heads.len == 0 { fail(&mut c, "break or continue requires a loop"); return false }
    if c.body.in_defer && c.body.loop_heads.len <= c.body.defer_loop_floor { fail(&mut c, "break or continue cannot exit defer"); return false }
    mut target := c.body.loop_ends[c.body.loop_ends.len - 1]
    mut action := row.Edge.Break
    if name == "continue" { action = .Continue; target = c.body.loop_heads[c.body.loop_heads.len - 1] }
    if model.recording { mut kind := 16; if name == "continue" { kind = 17 }; _ := typed.node(&mut model, kind, 0, -1, -1, -1, 0, -1, exit_at) }
    if name == "continue" { move_loop_backedge(&mut c) } else { move_loop_break(&mut c) }
    loop := c.body.loop_heads.len - 1
    unwind_exit(&mut c, c.body.loop_defers[loop], c.body.loop_operands[loop])
    cleanup_pending(&mut c, c.body.loop_pending[loop])
    if c.tasks.program { task_close_locals(&mut c, c.body.loop_task_locals[c.body.loop_task_locals.len - 1]) }
    cleanup_from(&mut c, c.body.loop_owners[c.body.loop_owners.len - 1], false); source_edge(&mut c, target, action, exit_at)
    ownership.terminate(&mut c.body.ownership)
    true
}
fn diverging_match_arm(c: &mut Session, tail: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, handled: &mut bool) -> bool {
    arm_at := c.body.cursor
    if eat(&mut c, "return") {
        handled = true
        if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
        if is(&c, "\n") || is(&c, ";") || is(&c, "}") || is(&c, ",") {
            if c.body.ret_type != 0 { fail(&mut c, "missing return value") }; arm.imm(&mut c.code, 0, 0)
        } else {
            ty := expression(&mut c, 0, c.body.ret_type, &catalog, &mut inline_work, &mut model)
            same_or_coerce(&mut c, c.body.ret_type, ty, arm_at)
        }
        take_return_value(&mut c, c.body.ret_type, arm_at)
        return_from_body(&mut c, arm_at)
        return true
    }
    if is(&c, "break") || is(&c, "continue") {
        handled = true
        name := advance(&mut c)
        return emit_loop_exit(&mut c, name, arm_at, &mut model)
    }
    if is(&c, "unsafe") && c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.texts[c.body.cursor + 1] == "{" &&
        !lookahead.continues_expression(&c.world.tokens, c.world.closes[c.body.cursor + 1] + 1) {
        handled = true
        skip_token(&mut c)
        task_effect_at(&mut c, 16, arm_at)
        if !c.world.unsafe_capable {
            has_other := c.body.current_owner >= 0 && c.body.current_owner < c.world.module_caps.len && c.world.module_caps[c.body.current_owner] != 0
            fail(&mut c, modules.missing_unsafe_message(has_other)); return false
        }
        previous := c.body.unsafe_scope; c.body.unsafe_scope = true
        res := block(&mut c, tail, &catalog, &mut inline_work, &mut model)
        c.body.unsafe_scope = previous
        return res
    }
    false
}
fn match_arms(c: &mut Session, context: i32, home: i32, result_type: &mut i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    consuming := eat(&mut c, "move")
    subject_at := c.body.cursor
    mut ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
    if ft.type_kind(&c.types, ty) == 4 { ty = read_returned(&mut c, ty, subject_at) }
    if !matchable_subject(&c, ty) { fail(&mut c, "match requires an enum, integer, bool, rune, string, or tuple"); return false }
    subject_place := c.body.places.current
    borrowed_subject := !consuming && c.body.expr.owner < 0 && subject_place != 0
    mut match_lock_index := -1
    mut subject_movable := false
    saved := slot(&mut c)
    if borrowed_subject {
        arm.store(&mut c.code, saved, 0)
        subject_path := owner_path(&c, subject_place)
        if subject_path >= 0 {
            match_lock_index = c.body.for_locks.len
            c.body.for_locks.push(subject_path)
        }
        subject_binding := borrows.root(&c.body.places, subject_place)
        if subject_binding >= 0 && !borrows.has_index(&c.body.places, subject_place) &&
            !c.body.place.inline_storage && !fc.pattern_loan(&c.body, subject_binding) &&
            !local_borrows.shared(&c.body.local_loans, subject_binding) {
            sb_kind := ft.type_kind(&c.types, c.body.locals.types[subject_binding])
            if sb_kind != 4 && sb_kind != 5 { subject_movable = true }
        }
    } else {
        take_value(&mut c, ty)
        if frame_owned(&c, ty) { save_owner(&mut c, saved, ty, true) } else { arm.store(&mut c.code, saved, 0) }
    }
    if !is(&c, "{") { fail(&mut c, "expected match arms"); return false }
    tail := context < 0 && c.body.tail && terminal(&c, c.world.closes[c.body.cursor] + 1, true)
    expect(&mut c, "{"); separators(&mut c)
    mut patterns := coverage.new(ft.type_count(&c.types, ty))
    mut fallback := false; mut returns := true
    done := new_block(&mut c)
    mut continuing := ownership.checkpoint(&c.body.ownership)
    mut outcomes := ownership.empty_checkpoint()
    mut outcome_seen := false; mut falling_through := false
    while !is(&c, "}") && c.ok {
        ownership.restore_checkpoint(&mut c.body.ownership, &continuing)
        if fallback { fail(&mut c, "wildcard must be the final match arm"); return false }
        next := new_block(&mut c); enter(&mut c)
        wildcard := is(&c, "_") && !has_or_alternative(&c.world.tokens, c.body.cursor)
        mut bindings := empty_pattern_bindings()
        root := match_pattern(&mut c, &mut patterns, &mut bindings, ty, saved, -1, next, 0)
        if !c.ok { return false }
        newlines(&mut c)
        guarded := eat(&mut c, "if")
        fallback = wildcard && !guarded
        error := coverage.add(&mut patterns, &c.types, ty, root, guarded)
        if error != "" { fail(&mut c, error); return false }
        first_owner := c.body.owned_slots.len
        marker_floor := c.body.pattern_borrowed.len
        loan_floor := c.body.pattern_loans.locals.len
        bind_pattern(&mut c, &mut model, &mut bindings, guarded, borrowed_subject, subject_movable, subject_place, match_lock_index)
        if guarded {
            match_guard(&mut c, first_owner, marker_floor, next, &catalog, &mut inline_work, &mut model); newlines(&mut c)
            guarded_state := ownership.checkpoint(&c.body.ownership)
            ownership.join_checkpoint_in_place(&c.body.ownership, &mut continuing, &guarded_state)
            if !borrowed_subject {
                for i in 0..bindings.tokens.len { if ft.move_only(&c.types, bindings.types[i]) { transfer_pattern(&mut c, &bindings, i) } }
                while c.body.pattern_borrowed.len > marker_floor { _ := c.body.pattern_borrowed.pop() }
            } else if subject_movable {
                while c.body.pattern_borrowed.len > marker_floor { _ := c.body.pattern_borrowed.pop() }
                for i in 0..bindings.tokens.len {
                    bty := bindings.types[i]; bid := bindings.locals[i]
                    if ft.move_only(&c.types, bty) {
                        push_pattern_loan(&mut c, bid, subject_place, bindings.parents[i], bindings.offsets[i], match_lock_index)
                    } else if frame_owned(&c, bty) {
                        c.body.pattern_borrowed.push(bid)
                    }
                }
            }
        }
        expect(&mut c, "=>"); newlines(&mut c); mut ends := false
        if context >= 0 {
            mut expected := context
            if result_type != 0 { expected = result_type }
            value := branch_value(&mut c, expected, home, true, &catalog, &mut inline_work, &mut model)
            if !c.ok { return false }
            ends = value == 0
            if !ends {
                if result_type == 0 { result_type = value } else { same(&mut c, result_type, value) }
            }
        } else if is(&c, "{") { ends = block(&mut c, tail, &catalog, &mut inline_work, &mut model) }
        else {
            mut handled := false
            diverged := diverging_match_arm(&mut c, tail, &catalog, &mut inline_work, &mut model, &mut handled)
            if handled {
                ends = diverged
            } else {
                arm_at := c.body.cursor; mut expected := 0; if tail { expected = c.body.ret_type }
                value := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
                if c.body.expr.untyped_exit || !ownership.falls_through(&c.body.ownership) {
                    ends = true
                } else if tail && expected != 0 {
                    if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
                    cty := coerce_callable(&mut c, expected, value, arm_at)
                    same(&mut c, expected, cty); take_return_value(&mut c, cty, arm_at)
                    return_from_body(&mut c, arm_at); ends = true
                } else if value != 0 { fail(&mut c, "unused match arm value") }
            }
        }
        returns = returns && ends
        leave(&mut c)
        while c.body.pattern_borrowed.len > marker_floor { _ := c.body.pattern_borrowed.pop() }
        while c.body.pattern_loans.locals.len > loan_floor {
            _ := c.body.pattern_loans.locals.pop()
            _ := c.body.pattern_loans.subject_places.pop()
            _ := c.body.pattern_loans.parent_slots.pop()
            _ := c.body.pattern_loans.offsets.pop()
            _ := c.body.pattern_loans.lock_indices.pop()
        }
        arm_state := ownership.checkpoint(&c.body.ownership)
        if outcome_seen { ownership.combine_checkpoints(&c.body.ownership, &mut outcomes, !falling_through, &arm_state, ends) }
        else { ownership.copy_checkpoint(&mut outcomes, &arm_state); outcome_seen = true }
        falling_through = falling_through || !ends
        source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, next)
        separators(&mut c); if !eat(&mut c, ",") && !is(&c, "}") { fail(&mut c, "expected comma between match arms") }; separators(&mut c)
    }
    expect(&mut c, "}"); bind_block(&mut c, done)
    if c.ok && !fallback {
        error := coverage.complete(&mut patterns, &c.types, ty)
        if error != "" { fail(&mut c, error) }
    }
    ownership.restore_checkpoint(&mut c.body.ownership, &outcomes)
    if match_lock_index >= 0 { _ := c.body.for_locks.pop() }
    returns
}
fn scratch_width(c: &Session, ty: i32) -> i32 { ft.scratch_width(&c.types, ty, c.code.platform) }
fn scratch_block(c:&mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function)->bool {
    name_at := c.body.cursor; name:=advance(&mut c)
    if eat(&mut c,"(") { ty:=expression(&mut c,0,1, &catalog, &mut inline_work, &mut model);same(&mut c,1,ty);expect(&mut c,")") }
    else {arm.imm(&mut c.code,0,65536)}
    area:=slot(&mut c);cursor:=slot(&mut c);limit:=slot(&mut c)
    arm.store(&mut c.code,limit,0);arm.store(&mut c.code,cursor,31)
    valid:=arm.label(&mut c.code);arm.compare_immediate(&mut c.code, 0, 0, false);arm.branch(&mut c.code,valid,12)
    arm.fail_source(&mut c.code, .InvalidRegion, c.world.tokens.starts[name_at]);arm.mark(&mut c.code,valid)
    token:=compound(&mut c,20,0)
    arm.intrinsic_call(&mut c.code, c.runtime.alloc, .RegionNew, 1, token, c.world.tokens.starts[name_at])
    save_owner(&mut c,area,4,false)
    enter(&mut c);bind(&mut c, &mut model,move name,token,false,area, name_at)
    if !is(&c,"{"){fail(&mut c,"expected region body");return false}
    ends:=scoped_body(&mut c, &catalog, &mut inline_work, &mut model)
    clear_owner(&mut c,area,4)
    ends
}
fn scratch_declaration(c:&mut Session, name:string, mutable:bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function)->bool {
    start:=c.body.cursor
    if start+8>=c.world.tokens.texts.len || c.world.tokens.texts[start]!=":" || c.world.tokens.texts[start+1]!="[" || c.world.tokens.texts[start+2]!="]" || c.world.tokens.texts[start+4]!="=" {return false}
    region:=local(&c.body,c.world.tokens.texts[start+5])
    if region<0 || ft.type_kind(&c.types, c.body.locals.types[region])!=20 {return false}
    locals.mark_used(&mut c.body.locals, region)
    area:=places.local_home(c.body.places.arena.locals[region])
    c.body.cursor=start+3;elem:=type_name(&mut c);width:=scratch_width(&c,elem)
    if width==0{fail(&mut c,"scratch elements must be numeric, bool, rune or plain value records");return true}
    expect(&mut c,"=");_ := advance(&mut c);expect(&mut c,".");expect(&mut c,"alloc");expect(&mut c,"(")
    actual:=expression(&mut c,0,1, &catalog, &mut inline_work, &mut model);same(&mut c,1,actual);expect(&mut c,")")
    mut align:=width;if ft.is_c_record(&c.types, elem) {align=ft.c_align(&c.types, elem)} else if ft.type_kind(&c.types, elem)==2{align=8}
    view:=compound(&mut c,21,elem);binding:=slot(&mut c)
    for _ in 0..5 { _ := slot(&mut c) }
    descriptor:=slot(&mut c)
    stride := unsigned.shift(storage_type(&c, elem))
    arm.scratch_allocate(&mut c.code,area,descriptor,elem,width,align,c.bounds,stride,c.world.tokens.starts[start + 7])
    arm.store(&mut c.code,binding,0);bind(&mut c, &mut model,name.clone(),view,mutable,binding,start - 1);end_statement(&mut c)
    true
}

fn for_bind_local(c: &mut Session, model: &mut opt_ir.Function, move name: string, tok: i32,
    raw_ty: i32, is_borrowed: bool, is_fresh_move: bool, array_place: i32, place_base: i32) -> i32 {
    slot_idx := slot(&mut c)
    mut bind_ty := raw_ty
    if is_borrowed { bind_ty = compound(&mut c, 4, raw_ty) }
    bind(&mut c, &mut model, move name, bind_ty, false, slot_idx, tok)
    id := c.body.locals.names.len - 1
    if is_borrowed {
        path := owner_path(&c, array_place); origin := loan_origin(&c, array_place)
        local_borrows.transient(&mut c.body.local_loans, id, path, place_base, origin)
    } else if is_fresh_move && owned(&c, raw_ty) {
        c.body.locals.fresh_move[id] = true
    }
    slot_idx
}
fn for_emit_borrowed_field(c: &mut Session, box: i32, part: i32, fty: i32, tok: i32, dst_slot: i32) {
    arm.load(&mut c.code, box)
    if owned(&c, fty) {
        place_step(&mut c, .Field, fty, 3, 0, part * 8, tok)
        if ft.is_c_record(&c.types, fty) || fixed_pod(&c, fty) {
            place_transfer(&mut c, fty, 0, 0, true, false, 3, tok)
        }
        if fixed_pod(&c, fty) {
            place_transfer(&mut c, fty, 0, 0, true, false, 3, tok)
        }
        arm.store(&mut c.code, dst_slot, 0)
    } else {
        place_step(&mut c, .Member, fty, 0, i32(place_op.Member.Payload), part, tok)
        arm.store(&mut c.code, dst_slot, 0)
    }
}
fn for_emit_owned_field(c: &mut Session, box: i32, part: i32, fty: i32, tok: i32, dst_slot: i32, zero_non_move_only: bool) {
    arm.load(&mut c.code, box)
    place_step(&mut c, .Member, fty, 0, i32(place_op.Member.Payload), part, tok)
    if is_pod(&c, fty) {
        _ := copy_pod_to_stack(&mut c, fty, tok)
        arm.store(&mut c.code, dst_slot, 0)
    } else if owned(&c, fty) {
        if ft.move_only(&c.types, fty) || zero_non_move_only {
            arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, box)
            store_mem(&mut c, 31, 0, part * 8); arm.pop_temp(&mut c.code, 0)
        } else {
            copy_value(&mut c, fty)
        }
        save_owner(&mut c, dst_slot, fty, false)
    } else {
        arm.store(&mut c.code, dst_slot, 0)
    }
}
fn for_unpack_tuple(c: &mut Session, elem_ty: i32, borrowed: bool, const_elems: bool, is_owned_src: bool,
    pat_names: &[]string, pat_tokens: &[]i32, bind_slots: &[]i32) {
    tuple_box := slot(&mut c); arm.store(&mut c.code, tuple_box, 0)
    fields := ft.type_start(&c.types, elem_ty)
    for part in 0..pat_names.len {
        if pat_names[part] == "_" { continue }
        fty := c.types.field_types[fields + part]
        if borrowed {
            for_emit_borrowed_field(&mut c, tuple_box, part, fty, pat_tokens[part], bind_slots[part])
        } else if const_elems {
            arm.load(&mut c.code, tuple_box)
            place_step(&mut c, .Member, fty, 0, i32(place_op.Member.Payload), part, pat_tokens[part])
            arm.store(&mut c.code, bind_slots[part], 0)
        } else {
            for_emit_owned_field(&mut c, tuple_box, part, fty, pat_tokens[part], bind_slots[part], is_owned_src)
        }
    }
    if !borrowed && !const_elems {
        arm.load(&mut c.code, tuple_box); drop_value(&mut c, elem_ty)
    }
}

fn statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    c.body.last_expr_start = -1; c.body.last_expr_end = -1
    at := c.body.cursor
    kind := c.world.tokens.kinds[at]; word := c.world.tokens.texts[at].clone()
    if kind == .CheckOperand {
        skip_token(&mut c); _ := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
        end_statement(&mut c); return false
    }
    if kind == .Name && word != "region" && word != "task" && word != "unsafe" && word != "mut" {
        return value_statement(&mut c, &catalog, &mut inline_work, &mut model)
    }
    if model.probing && (!model.recording || is(&c, "task") || is(&c, "region") || is(&c, "unsafe") || is(&c, "match") || is(&c, "defer")) && decline_projection(&mut c, &mut model) {
        return false
    }
    if is(&c, "task") && c.world.tokens.texts[c.body.cursor + 1] == "scope" { return task_scope_statement(&mut c, &catalog, &mut inline_work, &mut model) }
    if is(&c,"region") && c.world.tokens.kinds[c.body.cursor+1]==.Name {_ := advance(&mut c); return scratch_block(&mut c, &catalog, &mut inline_work, &mut model)}
    if is(&c, "unsafe") {
        if c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.texts[c.body.cursor + 1] == "{" {
            after := c.world.closes[c.body.cursor + 1] + 1
            if lookahead.continues_expression(&c.world.tokens, after) {
                return value_statement(&mut c, &catalog, &mut inline_work, &mut model)
            }
        }
        skip_token(&mut c)
        task_effect_at(&mut c, 16, c.body.cursor - 1)
        if !c.world.unsafe_capable {
            has_other := c.body.current_owner >= 0 && c.body.current_owner < c.world.module_caps.len && c.world.module_caps[c.body.current_owner] != 0
            fail(&mut c, modules.missing_unsafe_message(has_other)); return false
        }
        previous := c.body.unsafe_scope; c.body.unsafe_scope = true
        enter(&mut c)
        result := scoped_body(&mut c, &catalog, &mut inline_work, &mut model); c.body.unsafe_scope = previous; return result
    }
    if is(&c, "match") {
        after := lookahead.match_end(&c.world.tokens, &c.world.closes, &c.types, &c.body.locals, c.body.cursor + 1, 0)
        if ends_value_block(&c, after) { return nested_choice_tail(&mut c, &catalog, &mut inline_work, &mut model) }
        if !lookahead.continues_expression(&c.world.tokens, after) {
            c.body.cursor = c.body.cursor + 1
            return match_statement(&mut c, &catalog, &mut inline_work, &mut model)
        }
    }
    if eat(&mut c, "return") {
        if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
        if is(&c, "\n") || is(&c, ";") || is(&c, "}") {
            if c.body.ret_type != 0 { fail(&mut c, "missing return value") }; arm.imm(&mut c.code, 0, 0)
            end_statement(&mut c)
            if model.recording { _ := typed.node(&mut model, 15, 0, model.value, -1, -1, 0, -1, at) }
            take_return_value(&mut c, c.body.ret_type, at)
        } else {
            raw_ty := expression(&mut c, 0, c.body.ret_type, &catalog, &mut inline_work, &mut model)
            cty := coerce_callable(&mut c, c.body.ret_type, raw_ty, at)
            same(&mut c, c.body.ret_type, cty)
            end_statement(&mut c)
            if model.recording { _ := typed.node(&mut model, 15, 0, model.value, -1, -1, 0, -1, at) }
            take_return_value(&mut c, cty, at)
        }
        return_from_body(&mut c, at)
        return true
    }
    if is(&c, "if") {
        after := lookahead.conditional_end(&c.world.tokens, &c.world.closes, &c.types, &c.body.locals, c.body.cursor + 1)
        if ends_value_block(&c, after) { return nested_choice_tail(&mut c, &catalog, &mut inline_work, &mut model) }
        if !lookahead.continues_expression(&c.world.tokens, after) {
            c.body.cursor = c.body.cursor + 1
            allowed := c.body.tail && terminal(&c, after, true)
            return conditional(&mut c, allowed, &catalog, &mut inline_work, &mut model)
        }
    }
    if eat(&mut c, "while") {
        move_loop_begin(&mut c)
        previous_reentry := c.body.reenter_owners; c.body.reenter_owners = true
        condition_at := c.body.cursor
        head := new_block(&mut c); done := new_block(&mut c); bind_block(&mut c, head)
        begin_loop_scope(&mut c, head, done)
        ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty); source_edge(&mut c, done, .WhenFalse, condition_at); body := new_block(&mut c); bind_block(&mut c, body)
        condition := model.value
        loop_exit := ownership.checkpoint(&c.body.ownership)
        _ := block(&mut c, false, &catalog, &mut inline_work, &mut model)
        end_loop_scope(&mut c)
        move_loop_backedge(&mut c); move_loop_end(&mut c, &loop_exit)
        source_edge(&mut c, head, .Jump, c.body.cursor); bind_block(&mut c, done)
        c.body.reenter_owners = previous_reentry
        if model.recording { _ := typed.node(&mut model, 14, 0, condition, model.value, -1, 0, -1, at) }
        return false
    }
    if eat(&mut c, "for") {
        mut pat_names: []string = []
        mut pat_tokens: []i32 = []
        mut is_tuple_pat := false
        if eat(&mut c, "(") {
            is_tuple_pat = true
            newlines(&mut c)
            while c.ok && !is(&c, ")") {
                if c.world.tokens.kinds[c.body.cursor] != .Name {
                    fail(&mut c, "expected variable name in for loop pattern"); return false
                }
                pat_tokens.push(c.body.cursor); pat_names.push(advance(&mut c))
                newlines(&mut c)
                if !eat(&mut c, ",") { break }
                newlines(&mut c)
            }
            expect(&mut c, ")")
            if !c.ok { return false }
            if pat_names.len < 2 { fail(&mut c, "for tuple pattern requires at least two bindings"); return false }
        } else {
            if c.world.tokens.kinds[c.body.cursor] != .Name {
                fail(&mut c, "expected loop variable name"); return false
            }
            pat_tokens.push(c.body.cursor); pat_names.push(advance(&mut c))
        }
        name_at := pat_tokens[0]
        expect(&mut c, "in")
        if !c.ok { return false }
        previous_stream := c.body.stream_depth; previous_enum := c.body.for_enumerate
        c.body.stream_depth = c.body.depth + 2; c.body.stream_kind = 0; c.body.for_enumerate = false
        consuming_for := eat(&mut c, "move")
        mut borrowed_for := eat(&mut c, "&")
        mut borrowed_mut_for := false
        mut returned_mut_ref := false
        if consuming_for && borrowed_for {
            c.body.stream_depth = previous_stream; c.body.stream_kind = 0; c.body.for_enumerate = previous_enum
            fail(&mut c, "move iteration requires an owned value"); return false
        }
        mut low := 0
        if borrowed_for {
            borrowed_mut_for = eat(&mut c, "mut")
            if model.probing && decline_projection(&mut c, &mut model) {
                c.body.stream_depth = previous_stream; c.body.stream_kind = 0; c.body.for_enumerate = previous_enum
                return false
            }
            c.body.stream_depth = previous_stream; c.body.stream_kind = 0; c.body.for_enumerate = false
            previous_address := c.body.place.taking_address; c.body.place.taking_address = borrowed_mut_for
            low = primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
            c.body.place.taking_address = previous_address
            if !c.ok { c.body.for_enumerate = previous_enum; return false }
            if ft.type_kind(&c.types, low) == 4 {
                low = read_returned(&mut c, low, name_at); borrowed_for = true
            } else if ft.type_kind(&c.types, low) == 5 {
                low = ft.type_base(&c.types, low); borrowed_for = true; borrowed_mut_for = true; returned_mut_ref = true
            }
        } else {
            low = expression(&mut c, 1, 0, &catalog, &mut inline_work, &mut model)
            if !c.ok {
                c.body.stream_depth = previous_stream; c.body.stream_kind = 0; c.body.for_enumerate = previous_enum
                return false
            }
            if ft.type_kind(&c.types, low) == 4 {
                if consuming_for {
                    c.body.stream_depth = previous_stream; c.body.stream_kind = 0; c.body.for_enumerate = previous_enum
                    fail(&mut c, "move iteration requires an owned value"); return false
                }
                low = read_returned(&mut c, low, name_at); borrowed_for = true
            } else if ft.type_kind(&c.types, low) == 5 {
                if consuming_for {
                    c.body.stream_depth = previous_stream; c.body.stream_kind = 0; c.body.for_enumerate = previous_enum
                    fail(&mut c, "move iteration requires an owned value"); return false
                }
                low = ft.type_base(&c.types, low); borrowed_for = true; borrowed_mut_for = true; returned_mut_ref = true
            }
        }
        array_place := c.body.places.current
        is_range_tok := is(&c, "..") || is(&c, "..=")
        is_iterable_coll := collection(&c, low) || ft.is_map(&c.types, low) || ft.is_set(&c.types, low)
        const_tbl := c.body.expr.const_array && !consuming_for && c.body.stream_kind == 0 && !is_range_tok && collection(&c, low)
        if !borrowed_for && !consuming_for && c.body.stream_kind == 0 && !is_range_tok && is_iterable_coll && c.body.expr.owner < 0 {
            borrowed_for = array_place != 0
        }
        if c.body.stream_kind == 10 {
            c.body.stream_kind = 0
            if !consuming_for && array_place != 0 {
                if traits.satisfies(&c.traits, &c.types, traits.iterator_id(), low) {
                    ap_root := borrows.root(&c.body.places, array_place)
                    if ap_root >= 0 && local_borrows.is_exclusive(&c.body.local_loans, ap_root) {
                        borrowed_for = true; borrowed_mut_for = true
                    }
                } else if is_iterable_coll {
                    borrowed_for = true
                }
            }
        }
        mut place_base := -1
        mut locked_path := -1
        if borrowed_mut_for {
            if !traits.satisfies(&c.traits, &c.types, traits.iterator_id(), low) {
                c.body.stream_depth = previous_stream; c.body.stream_kind = 0; c.body.for_enumerate = previous_enum
                if is_iterable_coll { fail(&mut c, "for loop requires & rather than &mut") }
                else {
                    fail(&mut c, "for &mut requires a type implementing Iterator")
                    if impl_method(&c, low, "next") >= 0 {
                        tname := ft.type_spelling(&c.types, low)
                        set_error_note(&mut c, c.world.tokens.starts[name_at],
                            "type '" + tname + "' defines 'next' but does not implement Iterator; move 'next' into 'impl Iterator for " + tname + "'")
                    }
                }
                return false
            }
            if !returned_mut_ref {
                if array_place == 0 {
