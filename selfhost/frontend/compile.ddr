        mut context := substitute_generic_type(&mut c, target_expr, &inferred, self_def, -1)
        if context < 0 { context = 0 }
        prev_addr := c.body.place.taking_address
        c.body.place.taking_address = implicit_borrow
        actual := expression(&mut c, 0, context, &catalog, &mut inline_work, &mut model)
        c.body.place.taking_address = prev_addr
        if !c.ok { return 0 }
        if !unify_generic_type(&c, target_expr, actual, &mut inferred, self_def, -1) {
