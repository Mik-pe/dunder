                    arm.mov(&mut c.code, 1, 0); arm.pop_temp(&mut c.code, 0); arm.push_temp(&mut c.code, 1)
                    lower_place(&mut c, place, 0, .Value, at)
                    arm.pop_temp(&mut c.code, 1); arm.push_temp(&mut c.code, 0); arm.mov(&mut c.code, 0, 1)
                }
            }
            if model.recording { _ := typed.node(&mut model, 6, 2, model.value, -1, -1, 0, array_id, first_token) }
            if eat(&mut c, "..") {
                if model.probing && decline_projection(&mut c, &mut model) { c.body.place.taking_address = previous_address; break }
                if view {
                    if ty != 4 && (!collection(&c, ty) || ft.type_kind(&c.types, ty) == 10) {
                        fail(&mut c, "borrowed range requires an array or string"); c.body.place.taking_address = previous_address; break
                    }
                    first_home := slot(&mut c); arm.store(&mut c.code, first_home, 0)
                    source_home := slot(&mut c); arm.pop_temp(&mut c.code, 0); arm.store(&mut c.code, source_home, 0)
                    if is(&c, "]") {
                        mut offset := 8; if ty == 4 { offset = 0 }
                        arm.transfer(&mut c.code, true, 0, 0, 3, offset)
                    } else { last_type := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, last_type) }
                    last_home := slot(&mut c); arm.store(&mut c.code, last_home, 0); expect(&mut c, "]")
                    c.body.place.taking_address = previous_address
                    if borrows.changed(&c.body.mutations, effects, c.body.mutations.len, source_root_id) {
                        fail(&mut c, "cannot mutate or move an owner while constructing a borrowed range"); break
                    }
                    text := ty == 4; mut base := 8
                    if !text { base = ft.type_base(&c.types, ty) }
                    result := compound(&mut c, 1, base)
                    mut shift := 0; if !text { shift = unsigned.shift(storage_type(&c, base)) }
                    for field in 0..5 { reserved := slot(&mut c) }
                    data_home := slot(&mut c)
                    borrowed_view.emit(&mut c.code, source_home, first_home, last_home, data_home, text, shift, c.bounds, c.unicode_trap, c.world.tokens.starts[subscript_at])
                    holder := slot(&mut c); arm.store(&mut c.code, holder, 0)
                    c.body.loan.home = holder; c.body.loan.path = source_path
                    c.body.loan.root = source_root_id; c.body.loan.origin = source_origin; c.body.loan.constrained = true
                    ty = result; place = 0; fc.clear_rvalue_place(&mut c.body.place)
                    fc.clear_expr_value(&mut c.body.expr); projection_address = -1; temporary_root = -1
                    break
                }
                if ty != 4 { c.body.place.taking_address = previous_address; fail(&mut c, "slice requires a string") }
                arm.push_temp(&mut c.code, 0); last := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, last); expect(&mut c, "]")
                c.body.place.taking_address = previous_address
                arm.mov(&mut c.code, 2, 0); arm.pop_temp(&mut c.code, 1); arm.pop_temp(&mut c.code, 0); arm.intrinsic_call(&mut c.code, c.runtime.string_slice, .Slice, 4, 4, c.world.tokens.starts[subscript_at]); saved_string := temporary(&mut c, 4)
                place = 0; fc.clear_rvalue_place(&mut c.body.place); continue
            }
            expect(&mut c, "]"); c.body.place.taking_address = previous_address; arm.pop_temp(&mut c.code, 1)
            mut index := -1
            if place != 0 && ty != 4 && ft.type_base(&c.types, ty) >= 0 {
                kind := ft.type_kind(&c.types, ft.type_base(&c.types, ty))
                if c.body.place.taking_address || kind == 1 || kind == 2 || kind == 3 || kind == 6 || kind == 7 { index = slot(&mut c) }
            }
            indexed := index_place(&mut c, place, ty, packed, index, subscript_at)
            if indexed == 0 { fail(&mut c, "index requires an array or string"); return 0 }
            if index >= 0 { bound_place(&mut c, .Temporary, indexed, i32(place_op.Temporary.SaveIndex), subscript_at) }
            if ty == 4 { place = 0 } else if place != 0 { place = indexed }
            ty = load_index(&mut c, ty, packed, writable, place_access(&c), subscript_at, indexed)
            fc.clear_expr_value(&mut c.body.expr)
        } else {
            expect(&mut c, "."); name := advance(&mut c)
            if model.probing {
                if !model.recording || name != "len" || is(&c, "(") || model.array < 0 { if decline_projection(&mut c, &mut model) { break } }
                else { _ := typed.node(&mut model, 5, 1, -1, -1, -1, 0, model.array, first_token) }
            }
            mut member := -1; mut callable_field := false
            if ft.type_kind(&c.types, ty) == 2 {
                member = field(&c, ty, name)
                if member >= 0 {
                    type_owner := ft.declaring_owner(&c.types, ty)
                    fk := ft.type_kind(&c.types, c.types.field_types[member])
                    if (type_owner < 0 || type_owner == c.body.current_owner) && (fk == 8 || fk == 9) { callable_field = true }
                }
            }
            if is(&c, "(") && !callable_field {
