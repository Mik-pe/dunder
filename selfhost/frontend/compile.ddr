                        while c.ok {
                            pt := type_name(&mut c)
                            if pt == 0 && c.types.payload_types.len == payload && is(&c, ")") { break }
                            if !ft.array_element(&c.types, pt) { fail(&mut c, "enum payloads must be storable values or a single ()") }
                            c.types.payload_types.push(pt)
                            if !eat(&mut c, ",") { break }
