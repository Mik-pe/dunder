            fn_id := c.world.names.len
            c.world.function_owners.push(owner); c.world.test_functions.push(test)
            c.world.libraries.push(library.clone()); c.world.symbols.push(symbol.clone()); c.world.unsafe_functions.push(unchecked)
            c.world.impl_types.push(-1); c.world.impl_public.push(public)
