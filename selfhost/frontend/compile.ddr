        return replace_value(&mut c, &catalog, &mut inline_work, &mut model)
    }
    if c.code.platform == 3 && name.len >= 6 && name[0..6] == "__sys_" && name != "__sys_decode_utf8" && name != "__sys_decode_u8" && name != "__sys_decode_u8_range" && name != "__sys_memory_copy" && name != "__sys_memory_equal" && name != "__sys_memory_zero" && name != "__sys_pool_alloc_try" && name != "__sys_pool_free" && name != "__sys_bytes_extend" && name != "__sys_bytes_append_text" { fail(&mut c, "native system calls need a native target"); return 0 }
