            want = 13; if count == 2 { want = 12 }
        } else if name == "__sys_memory_zero" {
            want = 13; if count == 1 { want = 12 }
        } else if name == "__sys_pool_alloc_try" {
            want = 12
        } else if name == "__sys_pool_free" {
            want = 13
        } else if byte_buffer {
            if count == 0 { elem = 8; ref_kind = 5 }
            else if count == 1 && name == "__sys_bytes_extend" { elem = 8 }
            else if count == 1 { want = 4 }
            else { want = 1 }
        } else if count == 1 && (name == "__sys_write_bytes" || name == "__sys_write_u8" || name == "__sys_net_write" || name == "__sys_fd_write") {
            elem = 1; if name != "__sys_write_bytes" { elem = 8 }
        } else if count == 0 && (name == "__sys_decode_utf8" || name == "__sys_decode_u8" || name == "__sys_decode_u8_range") {
            elem = 1; if name != "__sys_decode_utf8" { elem = 8 }
