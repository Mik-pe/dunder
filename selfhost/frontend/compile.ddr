    mut decl_failed := false
    mut first_decl_err := ""
    mut first_decl_at := 0
    mut first_decl_last := -1
    mut first_decl_code := ""
    mut first_decl_note := ""
    mut first_decl_note_at := -1
    mut first_decl_note_last := -1
    for d in 0..declarations.len {
        if diag.limit_reached(&c.diag_bag) { break }
        c.body.cursor = declarations[d]; ty := declaration_types[d]
        if ty >= 0 {
            expect(&mut c, "{"); c.types.declared.type_starts[ty] = c.types.field_names.len; separators(&mut c)
            mut tag: i64 = 0
            while c.ok && !is(&c, "}") {
                if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected field or variant name"); break }
                name := advance(&mut c); mut field_type := 0; payload := c.types.payload_types.len
                if c.types.declared.type_kinds[ty] == 2 {
                    for prior in c.types.declared.type_starts[ty]..c.types.field_names.len {
                        if c.types.field_names[prior] == name { fail(&mut c, "duplicate struct field '" + name + "'") }
                    }
                    expect(&mut c, ":"); field_type = type_name(&mut c)
                    if c.types.declared.type_kinds[field_type] == 4 || c.types.declared.type_kinds[field_type] == 5 { fail(&mut c, "a field cannot store a borrow") }
                }
                else {
