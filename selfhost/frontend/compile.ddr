        }
    }
    if !covered || (!c.code.forbid_emit && target < 0) { fail(&mut c, "unknown method '" + name + "'"); return 0 }
    expect(&mut c, ")")
    if count == 1 { arm.mov(&mut c.code, 1, 0) }; arm.pop_temp(&mut c.code, 0)
    if count == 1 && ri.mutates_receiver(operation) {
        root := borrows.root(&c.body.places, place)
        if mutated_overlap(&c, effects, c.body.mutations.len, root, owner_path(&c, place)) {
