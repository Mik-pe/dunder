                c.types.field_names.push(move name); c.types.field_types.push(field_type); c.types.field_values.push(tag); tag = tag + 1
                if !eat(&mut c, ",") { separators(&mut c); if !is(&c, "}") { fail(&mut c, "expected field comma") } }; separators(&mut c)
            }
