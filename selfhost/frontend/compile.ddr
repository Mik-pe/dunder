        }
        mut arg_want := want
        if name == "__sys_linux_syscall" { arg_want = 2 }
        argument := c.body.cursor; ty := expression(&mut c, 0, arg_want, &catalog, &mut inline_work, &mut model)
        if arg_want != 0 { same(&mut c, arg_want, ty) }
        if elem != 0 { place_step(&mut c, .Read, ft.type_base(&c.types, want), ref_kind - 1, 3, 0, argument) }
        arm.push_temp(&mut c.code, 0); count = count + 1
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")")
    if name == "__sys_envp" && count != 0 { fail(&mut c, "__sys_envp expects no arguments"); return 0 }
    if name == "__sys_linux_syscall" && count != 7 { fail(&mut c, "__sys_linux_syscall expects 7 arguments"); return 0 }
    if raw_memory && count != 3 { fail(&mut c, name + " expects 3 arguments"); return 0 }
    if name == "__sys_memory_zero" && count != 2 { fail(&mut c, "__sys_memory_zero expects 2 arguments"); return 0 }
    if name == "__sys_pool_alloc_try" && count != 1 { fail(&mut c, "__sys_pool_alloc_try expects 1 argument"); return 0 }
    if name == "__sys_pool_free" && count != 1 { fail(&mut c, "__sys_pool_free expects 1 argument"); return 0 }
    if name == "__sys_fd_write" && count != 4 { fail(&mut c, "__sys_fd_write expects 4 arguments"); return 0 }
    if name == "__sys_bytes_extend" && count != 4 { fail(&mut c, name + " expects 4 arguments"); return 0 }
    if name == "__sys_bytes_append_text" && count != 2 { fail(&mut c, name + " expects 2 arguments"); return 0 }
    mut i := count - 1; while i >= 0 { arm.pop_temp(&mut c.code, i); i = i - 1 }
    arm.branch(&mut c.code, target, 1); ret
}
fn length_value(c: &mut Session, ty: i32, token: i32) -> i32 {
    if collection(&c, ty) || ft.type_kind(&c.types, ty) == 21 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Length), 1, token) }
    else if ty == 4 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Length), 0, token) }
    else { fail(&mut c, "len expects an array or string") }
    1
}
fn import_address(c: &mut Session, f: i32) {
    task_effect(&mut c, 32)
    if c.validating_dead { return }
    if c.world.libraries[f] == "__unavailable__" {
        fail(&mut c, "external function '" + diagnostics.display_symbol(&c.sources, c.world.names[f].clone()) + "' has no @extern binding for this target")
        return
    }
    if c.code.platform == 3 {
        if !wasm_type(&mut c, c.world.ffi_types[f]) { return }
        request_symbol(&mut c, .WasmImport, f); arm.imm(&mut c.code, 0, 0); return
    }
    request_symbol(&mut c, .Import, f)
    arm.native_address(&mut c.code, 16); arm.mov(&mut c.code, 0, 16)
}
fn hfa(c: &Session, ty: i32, depth: i32) -> i32 { ft.hfa(&c.types, ty, depth) }
fn request_symbol(c: &mut Session, kind: facts.Symbol, operand: i32) {
    mut word := -1
    if !c.code.checking { word = arm.position(&c.code) }
    facts.symbol(&mut c.body.facts, kind, word, operand, c.body.cursor)
}
fn static_address(c: &mut Session, kind: facts.Symbol, operand: i32) {
    task_effect(&mut c, 64); request_symbol(&mut c, kind, operand)
    arm.native_address(&mut c.code, 16)
}
fn foreign_width(ty: i32) -> i32 { ft.foreign_width(ty) }
fn storage_type(c: &Session, ty: i32) -> i32 { ft.storage_type(&c.types, ty, c.code.platform) }
fn wasm_type(c: &mut Session, ty: i32) -> bool {
    if ft.is_c_record(&c.types, ft.type_base(&c.types, ty)) { fail(&mut c, "pass Wasm C records by pointer"); return false }
    first := ft.type_start(&c.types, ty)
    for p in first..(first + ft.type_count(&c.types, ty)) {
        if ft.is_c_record(&c.types, ft.parameter_type(&c.types, p)) { fail(&mut c, "pass Wasm C records by pointer"); return false }
    }
    true
}
fn wasm_signature(c: &mut Session, ty: i32) -> i32 {
    first := ft.type_start(&c.types, ty); count := ft.type_count(&c.types, ty)
    mut args: []i32 = []; args.reserve(count)
    for p in first..(first + count) { args.push(ft.parameter_type(&c.types, p)) }
    ret := ft.type_base(&c.types, ty)
    wa.signature(&mut c.wasm_abi, &args, ret)
}
fn foreign_call(c: &mut Session, sig: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    task_effect(&mut c, 32)
    if !c.body.unsafe_scope { fail(&mut c, "foreign call requires unsafe"); return 0 }
    callee := slot(&mut c); arm.store(&mut c.code, callee, 0)
    if c.code.platform == 3 {
        if !wasm_type(&mut c, sig) { return 0 }
        return invoke(&mut c, sig, callee, -1, 0, &catalog, &mut inline_work, &mut model)
    }
    first := ft.type_start(&c.types, sig); count := ft.type_count(&c.types, sig)
    variadic_fixed := ft.c_variadic_fixed(&c.types, sig)
    mut values: []i32 = []; mut locations: []i32 = []
    mut gp_limit := 8; if c.code.platform == 2 { gp_limit = 6 }
    ret := ft.type_base(&c.types, sig); ret_c_record := ft.is_c_record(&c.types, ret); mut ret_hfa := 0
    mut result_slot := -1; mut indirect_result := false
    if ret_c_record {
        ret_hfa = hfa(&c, ret, 0)
        if ret_hfa == 0 { fail(&mut c, "unsupported foreign aggregate result"); return 0 }
        result_slot = slot(&mut c)
        indirect_result = c.code.platform == 2 && ft.c_size(&c.types, ret) > 16
    }
    mut spec := fa.ForeignCallSpec { ret: ret, ret_c_record: ret_c_record, ret_hfa: ret_hfa,
        arg_types: [], arg_packed: [], arg_c_record: [], arg_hfas: [], arg_sizes: [] }
    mut gp := 0; if indirect_result { gp = 1 }; mut fp := 0; mut outgoing := 0
    while c.ok && !is(&c, ")") {
        if values.len == count { fail(&mut c, "too many C call arguments"); return 0 }
        is_variadic := variadic_fixed >= 0 && values.len >= variadic_fixed
        want := ft.parameter_type(&c.types, first + values.len)
        actual := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, actual)
        aggregate := ft.is_c_record(&c.types, want)
        if aggregate {
            if hfa(&c, want, 0) == 0 { fail(&mut c, "unsupported foreign aggregate parameter"); return 0 }
            take_value(&mut c, want); _ := temporary(&mut c, want)
        }
        value := slot(&mut c); arm.store(&mut c.code, value, 0); values.push(value)
        shape := hfa(&c, want, 0); mut need := shape; if shape < 0 { need = -shape }
        spec.arg_types.push(want); spec.arg_packed.push(storage_type(&c, want))
        spec.arg_c_record.push(aggregate); spec.arg_hfas.push(shape); spec.arg_sizes.push(ft.c_size(&c.types, want))
        if aggregate && c.code.platform == 2 {
            need = (ft.c_size(&c.types, want) + 7) / 8
            if need > 2 { need = 9 }
        }
        if c.code.platform == 0 && is_variadic {
            outgoing = (outgoing + 7) / 8 * 8
            locations.push(16 + outgoing); outgoing = outgoing + 8
        }
        else if need > 0 && fp + need <= 8 { locations.push(8 + fp); fp = fp + need }
        else if need == 0 && gp < gp_limit { locations.push(gp); gp = gp + 1 }
        else {
            if need > 0 && c.code.platform != 2 { fp = 8 }
            mut alignment := 8; mut width := 8
            if c.code.platform == 0 { alignment = foreign_width(want); width = alignment }
            if aggregate {
                width = ft.c_size(&c.types, want)
                if c.code.platform == 0 { alignment = ft.c_align(&c.types, want) } else { width = (width + 7) / 8 * 8 }
            }
            outgoing = (outgoing + alignment - 1) / alignment * alignment
            locations.push(16 + outgoing); outgoing = outgoing + width
        }
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")"); if count != values.len { fail(&mut c, "wrong C argument count"); return 0 }
    outgoing = (outgoing + 15) / 16 * 16
    if outgoing > 4080 { fail(&mut c, "C argument frame exceeds direct stack offset"); return 0 }
    if c.code.checking { return ret }
    if ret_c_record {
        arm.imm(&mut c.code, 0, i64(ft.c_size(&c.types, ret))); arm.branch(&mut c.code, c.runtime.alloc_record, 1)
        arm.store(&mut c.code, result_slot, 0)
    }
    mut patches := fa.new_patches(0)
    arm.emit_foreign_call(&mut c.code, &spec, callee, &values, &locations,
        result_slot, indirect_result, gp, fp, outgoing, c.has_callbacks,
        &mut patches, c.float_trap, c.overflow)
    for i in 0..patches.sites.len {
        facts.symbol(&mut c.body.facts, .CallbackStorage, patches.sites[i] / 4, -1 - patches.slots[i], c.body.cursor)
    }
    ret
}
fn c_layout(c: &mut Session, ty: i32) {
    if !c.ok { return }
    ft.c_layout(&mut c.types, c.code.platform, ty)
    check_type_error(&mut c)
}
fn validate_layouts(c: &mut Session) {
    if !c.ok { return }
    ft.validate_layouts(&mut c.types, c.code.platform)
    check_type_error(&mut c)
}
fn copy_inline(c: &mut Session, bytes: i32) { arm.copy_inline(&mut c.code, bytes) }
fn zero_record(c: &mut Session, ty: i32, at: i32) {
    bytes := ft.c_size(&c.types, ty)
    arm.allocate_value(&mut c.code, c.runtime.alloc_record, .CRecord, ty, bytes, c.world.tokens.starts[at])
    arm.clear_record(&mut c.code, bytes)
}
fn fixed_pod(c: &Session, ty: i32) -> bool { ft.fixed_pod(&c.types, ty) }
fn inline_value(c: &mut Session, ty: i32, access: borrows.Access, token: i32) {
    if ft.is_c_record(&c.types, ty) { return }
    if ft.type_kind(&c.types, ty) != 6 { place_transfer(&mut c, ty, 0, 0, true, true, i32(access), token); return }
    if !fixed_pod(&c, ty) { fail(&mut c, "inline C arrays require scalar elements"); return }
    elem := ft.type_base(&c.types, ty)
    mut local_slots := c.body.slots; mut err := ""
    arm.inline_descriptor(&mut c.code, ft.type_count(&c.types, ty), ft.c_size(&c.types, elem), &mut local_slots, &mut err)
    c.body.slots = local_slots
    if err != "" { fail(&mut c, err) }
}
fn store_inline(c: &mut Session, ty: i32, token: i32) {
    access := i32(borrows.Access.Address); kind := ft.type_kind(&c.types, ty)
    if !ft.is_c_record(&c.types, ty) && kind != 6 { place_transfer(&mut c, ty, 0, 1, false, true, access, token); return }
    if kind == 6 && !fixed_pod(&c, ty) { fail(&mut c, "inline C arrays require scalar elements"); return }
    mut fixed := 0; mut count := ft.c_size(&c.types, ty); mut stride := 1; mut part := 0
    if kind == 6 {
        fixed = 1; count = ft.type_count(&c.types, ty); elem := ft.type_base(&c.types, ty)
        stride = ft.c_size(&c.types, elem); mut width := 0
        while i32(1).shl(width) < ft.foreign_width(storage_type(&c, elem)) { width = width + 1 }
        if elem == 1 { width = 4 }; part = width + 1
    }
    place_step(&mut c, .CopySetup, ty, access, fixed, count, token)
    head := arm.label(&mut c.code); done := arm.label(&mut c.code)
    arm.mark(&mut c.code, head); place_step(&mut c, .CopyTest, ty, access, fixed, 0, token); arm.branch(&mut c.code, done, 2)
    place_step(&mut c, .CopyPart, ty, access, part, stride, token)
    arm.branch(&mut c.code, head, 0); arm.mark(&mut c.code, done)
}
fn callback_entry(c: &mut Session, id: i32) {
    mut ptypes: []i32 = []
    first := c.world.param_starts[id]; count := c.world.param_counts[id]
    ptypes.reserve(count)
    for p in 0..count { ptypes.push(c.world.param_types[first + p]) }
    mut patches := fa.new_patches(c.imports.globals)
    arm.emit_callback_entry(&mut c.code, &mut patches, c.fn_labels[id], c.callback_labels[id], &ptypes, c.world.returns[id])
    c.imports.globals = patches.globals
    for i in 0..patches.sites.len { c.imports.sites.push(patches.sites[i]); c.imports.slots.push(patches.slots[i]) }
}

fn require_unsafe(c: &mut Session) {
    task_effect(&mut c, 16)
    if !c.body.unsafe_scope { fail(&mut c, "operation requires unsafe function or block") }
}
fn raw_memory_type(c: &Session, name: string, start: i32) -> i32 {
    if name.len <= start { return -1 }
    ty := type_id(&c, name[start..name.len])
    if ty < 0 || !foreign_scalar(&c, ty) { return -1 }; ty
}
fn enclosing_generic_instance(c: &Session) -> i32 {
    if c.body.current_fn >= 0 && c.body.current_fn < c.specializations.function_instances.len {
        return c.specializations.function_instances[c.body.current_fn]
    }
    -1
}
fn unify_generic_type(c: &Session, expr_id: i32, actual: i32, inferred: &mut []i32, self_def: i32, self_ty: i32) -> bool {
    if expr_id < 0 || actual < 0 { return false }
    gf := &c.specializations.generic_fns
    form := gf.exprs.forms[expr_id]; val := gf.exprs.values[expr_id]
    if form == .Name {
        if val == -1 {
            if self_def >= 0 {
                if actual <= 0 || actual >= c.specializations.type_instance_def.len { return false }
                if c.specializations.type_instance_def[actual] != self_def { return false }
                acount := c.specializations.type_instance_arg_counts[actual]
                if acount > inferred.len { return false }
                astart := c.specializations.type_instance_arg_starts[actual]
                for i in 0..acount {
                    arg_ty := c.specializations.type_instance_args[astart + i]
                    if inferred[i] < 0 { inferred[i] = arg_ty }
                    else if inferred[i] != arg_ty { return false }
                }
                return true
            }
            if self_ty > 0 { return actual == self_ty }
            return false
        }
        if val <= -2 {
            p := -2 - val
            if p < 0 || p >= inferred.len { return false }
            if inferred[p] < 0 { inferred[p] = actual; return true }
            return inferred[p] == actual
        }
        if val == -1000 {
            concrete := type_id(&c, gf.exprs.names[expr_id])
            return concrete >= 0 && concrete == actual
        }
        return val == actual
    }
    cstart := gf.exprs.starts[expr_id]; ccount := gf.exprs.starts[expr_id + 1] - cstart
    if actual <= 0 && form != .Tuple { return false }
    akind := ft.type_kind(&c.types, actual)
    if form == .Shared {
        if akind == 4 && ccount == 1 && unify_generic_type(&c, gf.exprs.children[cstart], ft.type_base(&c.types, actual), &mut inferred, self_def, self_ty) { return true }
        if ccount == 1 && gf.exprs.forms[gf.exprs.children[cstart]] == .FnClosure &&
            (ft.is_dunder_callable_kind(akind) || ft.is_borrowed_closure(&c.types, actual)) {
            target := if akind == 4 || akind == 5 { ft.type_base(&c.types, actual) } else { actual }
            return unify_generic_type(&c, gf.exprs.children[cstart], target, &mut inferred, self_def, self_ty)
        }
        return false
    }
    if form == .Exclusive {
        if akind == 5 && ccount == 1 && unify_generic_type(&c, gf.exprs.children[cstart], ft.type_base(&c.types, actual), &mut inferred, self_def, self_ty) { return true }
        if ccount == 1 && gf.exprs.forms[gf.exprs.children[cstart]] == .FnMutClosure &&
            (ft.is_dunder_callable_kind(akind) || ft.is_borrowed_closure(&c.types, actual)) {
            target := if akind == 4 || akind == 5 { ft.type_base(&c.types, actual) } else { actual }
            return unify_generic_type(&c, gf.exprs.children[cstart], target, &mut inferred, self_def, self_ty)
        }
        return false
    }
    if form == .Array { return akind == 1 && ccount == 1 && unify_generic_type(&c, gf.exprs.children[cstart], ft.type_base(&c.types, actual), &mut inferred, self_def, self_ty) }
    if form == .Fixed {
        if akind != 6 || ccount != 1 { return false }
        mut want_len := val
        if want_len < 0 { want_len = i32(c.types.const_lengths.get_or(gf.exprs.names[expr_id], -1)) }
        return want_len >= 0 && ft.type_count(&c.types, actual) == want_len &&
            unify_generic_type(&c, gf.exprs.children[cstart], ft.type_base(&c.types, actual), &mut inferred, self_def, self_ty)
    }
    if form == .Consume { return ccount == 1 && unify_generic_type(&c, gf.exprs.children[cstart], actual, &mut inferred, self_def, self_ty) }
    if form == .Tuple {
        if !ft.is_tuple(&c.types, actual) || ft.type_count(&c.types, actual) != ccount { return false }
        fstart := ft.type_start(&c.types, actual)
        for i in 0..ccount {
            if !unify_generic_type(&c, gf.exprs.children[cstart + i], c.types.field_types[fstart + i], &mut inferred, self_def, self_ty) { return false }
        }
        return true
    }
    if form == .Function || form == .Foreign || form == .FnClosure || form == .FnMutClosure || form == .FnOnceClosure {
        if form == .Foreign { if akind != 8 { return false } }
        else if form == .Function { if akind != 9 { return false } }
        else if !ft.is_dunder_callable_kind(akind) { return false }
        if ccount == 0 { return false }
        pcount := ccount - 1
        if ft.type_count(&c.types, actual) != pcount { return false }
        astart := ft.type_start(&c.types, actual)
        for i in 0..pcount {
            pchild := gf.exprs.children[cstart + i]
            param_ty := ft.parameter_type(&c.types, astart + i)
            if unify_generic_type(&c, pchild, param_ty, &mut inferred, self_def, self_ty) { continue }
            pform := gf.exprs.forms[pchild]
            if form != .Foreign && pform != .Consume && pform != .Shared && pform != .Exclusive &&
                ft.type_kind(&c.types, param_ty) == 4 {
                base_ty := ft.type_base(&c.types, param_ty)
                if !ft.is_closure_kind(ft.type_kind(&c.types, base_ty)) &&
                    (ft.owned(&c.types, base_ty) || ft.type_kind(&c.types, base_ty) == 3) &&
                    unify_generic_type(&c, pchild, base_ty, &mut inferred, self_def, self_ty) {
                    continue
                }
            }
            return false
        }
        return unify_generic_type(&c, gf.exprs.children[cstart + pcount], ft.type_base(&c.types, actual), &mut inferred, self_def, self_ty)
    }
    if val == -1 {
        return akind == 22 && ccount == 1 && unify_generic_type(&c, gf.exprs.children[cstart], ft.type_base(&c.types, actual), &mut inferred, self_def, self_ty)
    }
    if actual >= c.specializations.type_instance_def.len || c.specializations.type_instance_def[actual] != val { return false }
    if c.specializations.type_instance_arg_counts[actual] != ccount { return false }
    astart := c.specializations.type_instance_arg_starts[actual]
    for i in 0..ccount {
        if !unify_generic_type(&c, gf.exprs.children[cstart + i], c.specializations.type_instance_args[astart + i], &mut inferred, self_def, self_ty) { return false }
    }
    true
}
fn substitute_generic_type(c: &mut Session, expr_id: i32, inferred: &[]i32, self_def: i32, self_ty: i32) -> i32 {
    if expr_id < 0 { return 0 }
    form := c.specializations.generic_fns.exprs.forms[expr_id]
    val := c.specializations.generic_fns.exprs.values[expr_id]
    if form == .Name {
        if val == -1 {
            if self_def >= 0 {
                for t in 0..c.specializations.type_instance_def.len {
                    if c.specializations.type_instance_def[t] != self_def { continue }
                    acount := c.specializations.type_instance_arg_counts[t]
                    if acount > inferred.len { continue }
                    astart := c.specializations.type_instance_arg_starts[t]
                    mut ok := true
                    for i in 0..acount {
                        if inferred[i] < 0 || c.specializations.type_instance_args[astart + i] != inferred[i] { ok = false; break }
                    }
                    if ok { return t }
                }
                return -1
            }
            if self_ty > 0 { return self_ty }
            return -1
        }
        if val <= -2 {
            p := -2 - val
            if p < 0 || p >= inferred.len || inferred[p] < 0 { return -1 }
            return inferred[p]
        }
        if val == -1000 {
            cname := c.specializations.generic_fns.exprs.names[expr_id].clone()
            return type_id(&c, cname)
        }
        return val
    }
    cstart := c.specializations.generic_fns.exprs.starts[expr_id]
    ccount := c.specializations.generic_fns.exprs.starts[expr_id + 1] - cstart
    if form == .Consume {
        if ccount != 1 { return -1 }
        child := c.specializations.generic_fns.exprs.children[cstart]
        return substitute_generic_type(&mut c, child, &inferred, self_def, self_ty)
    }
    if form == .Shared || form == .Exclusive || form == .Array || form == .Fixed {
        if ccount != 1 { return -1 }
        child := c.specializations.generic_fns.exprs.children[cstart]
        base := substitute_generic_type(&mut c, child, &inferred, self_def, self_ty)
        if base <= 0 { return -1 }
        if form == .Shared { return compound(&mut c, 4, base) }
        if form == .Exclusive { return compound(&mut c, 5, base) }
        if form == .Array {
            if !ft.array_element(&c.types, base) { return -1 }
            return compound(&mut c, 1, base)
        }
        mut want_len := val
        if want_len < 0 {
            lname := c.specializations.generic_fns.exprs.names[expr_id].clone()
            want_len = i32(c.types.const_lengths.get_or(lname, -1))
        }
        if want_len < 0 { return -1 }
        return fixed(&mut c, base, want_len)
    }
    if form == .Tuple {
        mut fields: []i32 = []
        for i in 0..ccount {
            child := c.specializations.generic_fns.exprs.children[cstart + i]
            fty := substitute_generic_type(&mut c, child, &inferred, self_def, self_ty)
            if fty <= 0 || !ft.array_element(&c.types, fty) { return -1 }
            fields.push(fty)
        }
        ty := ft.tuple_type(&mut c.types, &fields)
        if c.types.error != "" { c.types.error = ""; return -1 }
        ft.finish_tuples(&mut c.types)
        return ty
    }
    if form == .Function || form == .Foreign || form == .FnClosure || form == .FnMutClosure || form == .FnOnceClosure {
        if ccount == 0 { return -1 }
        pcount := ccount - 1
        mut params: []i32 = []
        foreign := form == .Foreign
        for i in 0..pcount {
            child := c.specializations.generic_fns.exprs.children[cstart + i]
            pty := substitute_generic_type(&mut c, child, &inferred, self_def, self_ty)
            if pty <= 0 { return -1 }
            consumes := c.specializations.generic_fns.exprs.forms[child] == .Consume
            mode_ty := type_reader.parameter_mode(&mut c.types, pty, consumes, foreign)
            if c.types.error != "" { c.types.error = ""; return -1 }
            params.push(mode_ty)
        }
        rchild := c.specializations.generic_fns.exprs.children[cstart + pcount]
        ret := substitute_generic_type(&mut c, rchild, &inferred, self_def, self_ty)
        if ret < 0 { return -1 }
        mut source := -1
        ret_kind := ft.type_kind(&c.types, ret)
        if !foreign && (ret_kind == 4 || ret_kind == 5) {
            source = type_reader.borrow_source_for(&mut c.types, &params, ret_kind == 5)
            if c.types.error != "" { c.types.error = ""; return -1 }
        }
        mut kind := 9
        if foreign { kind = 8 }
        else if form == .FnClosure { kind = 11 }
        else if form == .FnMutClosure { kind = 12 }
        else if form == .FnOnceClosure { kind = 13 }
        return callable_with_parameter(&mut c, &params, ret, kind, source)
    }
    if val == -1 {
        if ccount != 1 { return -1 }
        child := c.specializations.generic_fns.exprs.children[cstart]
        base := substitute_generic_type(&mut c, child, &inferred, self_def, self_ty)
        if base <= 0 { return -1 }
        return compound(&mut c, 22, base)
    }
    mut spec := c.specializations.generic_fns.exprs.names[expr_id] + "<"
    for i in 0..ccount {
        if i > 0 { spec = spec + ", " }
        child := c.specializations.generic_fns.exprs.children[cstart + i]
        aty := substitute_generic_type(&mut c, child, &inferred, self_def, self_ty)
        if aty < 0 { return -1 }
        spec = spec + ft.type_spelling(&c.types, aty)
    }
    spec = spec + ">"
    type_id(&c, spec)
}
fn call(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    mut covered := false
    result := call_dispatch(&mut c, name, expected, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
// The first two words of every environment are its entry and its typed destructor.
fn install_callable(c: &mut Session, f: i32, env: i32) {
    arm.push_temp(&mut c.code, 0)
    arm.branch(&mut c.code, c.fn_labels[f], 20)
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 0)
    arm.push_temp(&mut c.code, 1)
    if !c.code.checking { drop := type_helper(&mut c, env, true); arm.branch(&mut c.code, drop, 20) }
    arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 8); arm.mov(&mut c.code, 0, 1)
}
fn function_value(c: &mut Session, f: i32, token: i32) -> i32 {
    if c.loans.active { c.body.facts.taken.push(f) }
    may_invalidate_operand(&mut c); c.body.facts.needed.push(f)
    sig := c.world.ffi_types[f]
    arm.branch(&mut c.code, c.fn_labels[f], 20)
    sig
}
fn coerce_callable(c: &mut Session, expected: i32, actual: i32, token: i32) -> i32 {
    if !c.ok || expected == 0 || expected == actual { return actual }
    ekind := ft.type_kind(&c.types, expected)
    akind := ft.type_kind(&c.types, actual)
    // 1. Raw fn -> &Fn or &mut FnMut (2-word stack thunk, zero heap alloc)
    if akind == 9 && ft.is_borrowed_closure(&c.types, expected) &&
        ft.same_callable_signature(&c.types, actual, ft.type_base(&c.types, expected)) {
        _ := slot(&mut c); thunk := slot(&mut c)
        arm.store(&mut c.code, thunk, 0); arm.store(&mut c.code, thunk - 1, 31)
        holder := slot(&mut c); arm.address(&mut c.code, thunk); arm.store(&mut c.code, holder, 0)
        arm.address(&mut c.code, holder)
        fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
        c.body.loan.constrained = false; c.body.loan.origin = -1
        return expected
    }
    // 2. Raw fn -> owned Fn / FnMut / FnOnce (on-demand 16-byte heap wrapper)
    if akind == 9 && ft.is_closure_kind(ekind) && ft.same_callable_signature(&c.types, actual, expected) {
        if c.closure_header < 0 { fail(&mut c, "missing closure header"); return actual }
        fn_slot := slot(&mut c); arm.store(&mut c.code, fn_slot, 0)
        arm.allocate_value(&mut c.code, c.runtime.alloc_record, .Record, c.closure_header, 16, c.world.tokens.starts[token])
        arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, fn_slot); arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 0)
        arm.push_temp(&mut c.code, 1)
        if !c.code.checking { drop := type_helper(&mut c, c.closure_header, true); arm.branch(&mut c.code, drop, 20) }
        arm.pop_temp(&mut c.code, 1); store_mem(&mut c, 0, 1, 8); arm.mov(&mut c.code, 0, 1)
        fc.clear_rvalue_place(&mut c.body.place); fc.clear_loan_eval(&mut c.body.loan)
        return temporary(&mut c, expected)
    }
    // 3. Owned Fn -> &Fn or &mut FnMut (implicit borrow, zero heap alloc)
    if akind == 11 && ft.is_borrowed_closure(&c.types, expected) &&
        ft.same_callable_signature(&c.types, actual, ft.type_base(&c.types, expected)) {
        was_temp := c.body.places.current == 0 && c.body.expr.owner >= 0
        read_argument(&mut c, actual, token)
        if was_temp { c.body.loan.origin = -4 }
        return expected
    }
    // 4. Fresh temporary FnMut -> &mut FnMut (address of temporary owner slot, zero extra alloc)
    if akind == 12 && ekind == 5 && ft.type_kind(&c.types, ft.type_base(&c.types, expected)) == 12 &&
        ft.same_callable_signature(&c.types, actual, ft.type_base(&c.types, expected)) && is_fresh_owned(&c) {
        arm.address(&mut c.code, c.body.expr.owner)
        fc.clear_rvalue_place(&mut c.body.place); fc.clear_loan_eval(&mut c.body.loan)
        c.body.loan.constrained = true; c.body.loan.origin = -4
        return expected
    }
    // 5. &Fn -> &mut FnMut (identical &holder representation, zero instructions)
    if akind == 4 && ft.type_kind(&c.types, ft.type_base(&c.types, actual)) == 11 &&
        ekind == 5 && ft.type_kind(&c.types, ft.type_base(&c.types, expected)) == 12 &&
        ft.same_callable_signature(&c.types, ft.type_base(&c.types, actual), ft.type_base(&c.types, expected)) {
        return expected
    }
    // 6. Owned Fn -> FnOnce
    if akind == 11 && ekind == 13 && ft.same_callable_signature(&c.types, actual, expected) {
        if is_fresh_owned(&c) { c.body.expr.ty = expected; return expected }
        copy_value(&mut c, actual)
        fc.clear_rvalue_place(&mut c.body.place)
        return temporary(&mut c, expected)
    }
    // 7. Owned FnMut -> FnOnce
    if akind == 12 && ekind == 13 && ft.same_callable_signature(&c.types, actual, expected) {
        if c.body.expr.owner >= 0 { c.body.expr.ty = expected }
        return expected
    }
    actual
}
fn same_or_coerce(c: &mut Session, expected: i32, actual: i32, token: i32) {
    coerced := coerce_callable(&mut c, expected, actual, token)
    same(&mut c, expected, coerced)
}
fn bind_closure(c: &mut Session, target_kind: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    target := advance(&mut c); f := i32(c.world.functions.get_or(target, -1))
    if f < 0 || c.closure_header < 0 || c.world.param_counts[f] == 0 { fail(&mut c, "invalid closure target"); return 0 }
    count := c.world.param_counts[f] - 1; first := c.world.param_starts[f]
    if c.world.param_names[first + count] != "__dunder_module_env" { fail(&mut c, "invalid closure environment"); return 0 }
    env := ft.type_base(&c.types, c.world.param_types[first + count])
    expect(&mut c, ",")
    actual := expression(&mut c, 0, env, &catalog, &mut inline_work, &mut model); same(&mut c, env, actual)
    if !c.ok { return 0 }
    expect(&mut c, ")")
    if c.body.expr.owner < 0 { fail(&mut c, "closure requires a fresh environment"); return 0 }
    owner_store(&mut c, .Transfer, env, c.body.expr.owner)
    fc.clear_expr(&mut c.body.expr)
    c.body.facts.needed.push(f)
    if c.loans.active { c.body.facts.taken.push(f) }
    install_callable(&mut c, f, env)
    closure_signature(&mut c, c.world.ffi_types[f], target_kind)
}
fn bind_stack_closure(c: &mut Session, is_mut: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    target := advance(&mut c); f := i32(c.world.functions.get_or(target, -1))
    if f < 0 || c.world.param_counts[f] == 0 { fail(&mut c, "invalid closure target"); return 0 }
    count := c.world.param_counts[f] - 1; first := c.world.param_starts[f]
    if c.world.param_names[first + count] != "__dunder_module_env" { fail(&mut c, "invalid closure environment"); return 0 }
    c.body.facts.needed.push(f)
    if c.loans.active { c.body.facts.taken.push(f) }
    mut cap_slots: []i32 = []
    mut l_paths: []i32 = []; mut l_roots: []i32 = []; mut l_origins: []i32 = []; mut l_parents: []i32 = []
    mut l_exclusives: []bool = []; mut l_constrained: []bool = []; mut l_tokens: []i32 = []; mut l_eff_starts: []i32 = []; mut l_eff_ends: []i32 = []
    while c.ok && eat(&mut c, ",") {
        arg_tok := c.body.cursor
        eff_start := c.body.mutations.len
        borrow_arg := starts_borrow(&c)
        prev_addr := c.body.place.taking_address
        if !borrow_arg { c.body.place.taking_address = true }
        cap_ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
        c.body.place.taking_address = prev_addr
        eff_end := c.body.mutations.len
        if !c.ok { return 0 }
        mut cap_path := -1; mut cap_root := -1; mut cap_origin := -1; mut cap_parent := -1; mut cap_excl := false; mut cap_constrained := false
        if borrow_arg {
            cap_path = c.body.loan.path; cap_root = c.body.loan.root
            cap_origin = c.body.loan.origin; cap_parent = c.body.loan.parent; cap_constrained = c.body.loan.constrained
            cap_excl = ft.type_kind(&c.types, cap_ty) == 5
        } else if owned(&c, cap_ty) {
            place := c.body.places.current
            if place != 0 && !readable_loan(&mut c, place) { return 0 }
            read_argument(&mut c, cap_ty, arg_tok)
            cap_path = c.body.loan.path; cap_root = c.body.loan.root
            cap_origin = c.body.loan.origin; cap_parent = c.body.loan.parent; cap_constrained = c.body.loan.constrained
        }
        cs := slot(&mut c); arm.store(&mut c.code, cs, 0); cap_slots.push(cs)
        l_paths.push(cap_path); l_roots.push(cap_root); l_origins.push(cap_origin); l_parents.push(cap_parent)
        l_exclusives.push(cap_excl); l_constrained.push(cap_constrained); l_tokens.push(arg_tok)
        l_eff_starts.push(eff_start); l_eff_ends.push(eff_end)
    }
    expect(&mut c, ")")
    if !c.ok { return 0 }
    for i in 0..cap_slots.len {
        if l_roots[i] < 0 { continue }
        if !ownership.available(&c.body.ownership, l_paths[i]) {
            fail(&mut c, "cannot move a value while it is borrowed by another capture"); set_error_at(&mut c, c.world.tokens.starts[l_tokens[i]]); return 0
        }
        for j in 0..cap_slots.len {
            if j == i { continue }
            if (l_exclusives[i] || l_exclusives[j]) && l_roots[j] >= 0 {
                overlap := if l_paths[i] >= 0 && l_paths[j] >= 0 {
                    ownership.overlaps(&c.body.ownership, l_paths[i], l_paths[j])
                } else { l_roots[j] == l_roots[i] }
                if overlap {
                    fail(&mut c, "mutable closure capture must not alias another capture in the same closure")
                    set_error_at(&mut c, c.world.tokens.starts[l_tokens[j]]); return 0
                }
            }
            if j > i && mutated_overlap(&c, l_eff_starts[j], l_eff_ends[j], l_roots[i], l_paths[i]) {
                fail(&mut c, "cannot mutate a value while it is borrowed by another capture")
                set_error_at(&mut c, c.world.tokens.starts[l_tokens[j]]); return 0
            }
        }
    }
    total := 2 + cap_slots.len
    for _ in 0..(total - 1) { _ := slot(&mut c) }
    env_home := slot(&mut c)
    arm.branch(&mut c.code, c.fn_labels[f], 20); arm.store(&mut c.code, env_home, 0)
    arm.store(&mut c.code, env_home - 1, 31)
    for k in 0..cap_slots.len {
        arm.load(&mut c.code, cap_slots[k]); arm.store(&mut c.code, env_home - 2 - k, 0)
    }
    holder := slot(&mut c); arm.address(&mut c.code, env_home); arm.store(&mut c.code, holder, 0); arm.address(&mut c.code, holder)
    fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
    mut cl_origin := -1
    mut cl_constrained := false
    for i in 0..cap_slots.len {
        lo := l_origins[i]
        if lo == -2 { cl_origin = -2; cl_constrained = true }
        else if lo == -3 || lo == -4 {
            if cl_origin != -2 { cl_origin = -3 }
            cl_constrained = true
        } else if lo >= 0 {
            if cl_origin == -1 { cl_origin = lo }
        }
        if l_constrained[i] { cl_constrained = true }
    }
    c.body.loan.constrained = cl_constrained; c.body.loan.origin = cl_origin
    mut primary_idx := -1
    for i in 0..cap_slots.len {
        if l_roots[i] >= 0 && l_paths[i] >= 0 {
            if primary_idx < 0 || (!l_exclusives[primary_idx] && l_exclusives[i]) { primary_idx = i }
        }
    }
    if primary_idx >= 0 {
        c.body.loan.path = l_paths[primary_idx]; c.body.loan.root = l_roots[primary_idx]; c.body.loan.parent = l_parents[primary_idx]
        c.body.loan.closure_paths.push(l_paths[primary_idx]); c.body.loan.closure_roots.push(l_roots[primary_idx])
        c.body.loan.closure_exclusives.push(l_exclusives[primary_idx]); c.body.loan.closure_tokens.push(l_tokens[primary_idx])
    }
    for i in 0..cap_slots.len {
        if i != primary_idx && l_roots[i] >= 0 && l_paths[i] >= 0 {
            c.body.loan.closure_paths.push(l_paths[i]); c.body.loan.closure_roots.push(l_roots[i])
            c.body.loan.closure_exclusives.push(l_exclusives[i]); c.body.loan.closure_tokens.push(l_tokens[i])
        }
    }
    base_sig := closure_signature(&mut c, c.world.ffi_types[f], if is_mut { 12 } else { 11 })
    compound(&mut c, if is_mut { 5 } else { 4 }, base_sig)
}
fn cap_val_closure(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    token := c.body.cursor
    previous_address := c.body.place.taking_address; c.body.place.taking_address = true
    ty := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
    c.body.place.taking_address = previous_address
    expect(&mut c, ")")
    if !c.ok { return 0 }
    if !owned(&c, ty) { fc.clear_rvalue_place(&mut c.body.place); return ty }
    if ft.type_kind(&c.types, ty) == 11 {
        copy_value(&mut c, ty); fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr_value(&mut c.body.expr); return ty
    }
    place := c.body.places.current
    path := owner_path(&c, place); root := source_root(&c, place); parent := borrow_parent(&c, place)
    borrow_address(&mut c, ty, false, token, place)
    fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
    c.body.loan.path = path; c.body.loan.root = root; c.body.loan.origin = -3; c.body.loan.parent = parent; c.body.loan.constrained = true
    compound(&mut c, 4, ty)
}
fn cap_borrowed_closure(c: &mut Session, is_mut: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    previous_address := c.body.place.taking_address; c.body.place.taking_address = true
    _ := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
    c.body.place.taking_address = previous_address
    expect(&mut c, ",")
    target := type_name(&mut c); expect(&mut c, ")")
    if !c.ok { return 0 }
    place := c.body.places.current
    path := owner_path(&c, place); root := source_root(&c, place); parent := borrow_parent(&c, place)
    fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
    c.body.loan.path = path; c.body.loan.root = root; c.body.loan.origin = -3; c.body.loan.parent = parent; c.body.loan.constrained = true
    compound(&mut c, if is_mut { 5 } else { 4 }, target)
}
fn cap_stack_val_closure(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    previous_address := c.body.place.taking_address; c.body.place.taking_address = true
    _ := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
    c.body.place.taking_address = previous_address
    expect(&mut c, ",")
    target := type_name(&mut c); expect(&mut c, ")")
    if !c.ok { return 0 }
    place := c.body.places.current
    if owned(&c, target) {
        path := owner_path(&c, place); root := source_root(&c, place); parent := borrow_parent(&c, place)
        fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
        c.body.loan.path = path; c.body.loan.root = root; c.body.loan.origin = -3; c.body.loan.parent = parent; c.body.loan.constrained = true
        return compound(&mut c, 4, target)
    }
    fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr)
    target
}
fn cap_stack_mut_closure(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    token := c.body.cursor
    previous_address := c.body.place.taking_address; c.body.place.taking_address = true
    _ := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
    c.body.place.taking_address = previous_address
    expect(&mut c, ",")
    target := type_name(&mut c); expect(&mut c, ")")
    if !c.ok { return 0 }
    if owned(&c, target) { fail(&mut c, "owned 'mut' capture cannot be combined with borrowed '&' captures; capture '&mut' instead"); return 0 }
    place := c.body.places.current
    path := owner_path(&c, place); root := source_root(&c, place); parent := borrow_parent(&c, place)
    borrow_address(&mut c, 2, true, token, place)
    fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
    c.body.loan.path = path; c.body.loan.root = root; c.body.loan.origin = -3; c.body.loan.parent = parent; c.body.loan.constrained = true
    compound(&mut c, 5, target)
}
fn cap_take_closure(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    token := c.body.cursor
    previous_address := c.body.place.taking_address; c.body.place.taking_address = true
    ty := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
    c.body.place.taking_address = previous_address
    expect(&mut c, ")")
    if !c.ok { return 0 }
    place := c.body.places.current; direct := c.body.place.direct
    if owned(&c, ty) {
        val_slot := slot(&mut c); arm.store(&mut c.code, val_slot, 0)
        place_address(&mut c, place, direct, token)
        store_mem(&mut c, 31, 0, 0)
        arm.load(&mut c.code, val_slot)
        if is_pod(&c, ty) { unbox_pod_to_stack(&mut c, ty, token) }
        fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr)
        return ty
    }
    fc.clear_rvalue_place(&mut c.body.place)
    ty
}
fn closure_probe_call(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    id_tok := c.body.cursor
    if c.world.tokens.kinds[id_tok] != .Integer { fail(&mut c, "invalid closure probe id"); return 0 }
    probe_id := advance(&mut c)
    expect(&mut c, ",")
    target_ty := type_name(&mut c)
    mut cap_idx := 0
    while c.ok && eat(&mut c, ",") {
        prev_addr := c.body.place.taking_address; c.body.place.taking_address = true
        mut cap_ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
        c.body.place.taking_address = prev_addr
        if c.ok && cap_ty > 0 {
            ck := ft.type_kind(&c.types, cap_ty)
            if (ck == 4 || ck == 5) && !ft.is_borrowed_closure(&c.types, cap_ty) {
                cap_ty = ft.type_base(&c.types, cap_ty)
            }
            sp := ft.canonical_spelling(&c.types, cap_ty)
            key := probe_id + ":" + cap_idx.str()
            if !c.closure_probe_keys.contains(key) {
                idx := c.closure_probe_types.len
                c.closure_probe_types.push(move sp)
                c.closure_probe_keys.put(move key, i64(idx))
            }
        }
        cap_idx += 1
    }
    expect(&mut c, ")")
    fc.clear_rvalue_place(&mut c.body.place); fc.clear_expr(&mut c.body.expr); fc.clear_loan_eval(&mut c.body.loan)
    target_ty
}
fn infer_generic_call(c: &mut Session, gfn: i32, raw_name: string, mname: string, site_tok: i32, expected: i32, self_def: i32,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    shown_base := diagnostics.display_symbol(&c.sources, raw_name)
    shown := if mname != "" { shown_base + "::" + mname } else { shown_base.clone() }
    if !c.code.checking || !c.specializations.generic_fns.valid[gfn] {
        while c.ok && !is(&c, ")") { skip_token(&mut c) }
        _ := eat(&mut c, ")")
        if mname != "" {
            fail(&mut c, "cannot infer type arguments for '" + shown + "'; requires explicit type arguments, e.g. '" + shown_base + "<...>::" + mname + "(...)'")
        } else {
            fail(&mut c, "cannot infer type arguments for generic function '" + shown + "'; pass explicit type arguments like '" + shown + "<...>'")
        }
        set_error_at(&mut c, c.world.tokens.starts[site_tok])
        return 0
    }
    tcount := c.specializations.generic_fns.type_param_counts[gfn]
    pstart := c.specializations.generic_fns.param_starts[gfn]
    pcount := c.specializations.generic_fns.param_counts[gfn]
    mut inferred: []i32 = []
    for _ in 0..tcount { inferred.push(-1) }
    mut provided := 0
    while c.ok && !is(&c, ")") {
        if provided >= pcount { fail(&mut c, "too many arguments"); break }
        arg_tok := c.body.cursor; consuming := eat(&mut c, "move")
        pexpr := c.specializations.generic_fns.param_exprs[pstart + provided]
        pform := c.specializations.generic_fns.exprs.forms[pexpr]
        implicit_borrow := pform == .Shared && !starts_borrow(&c)
        mut target_expr := pexpr
        if implicit_borrow {
