import ..backend.arm64 as arm
import std.parse as parse

pub fn has(ty: i32) -> bool { ty >= 8 && ty <= 12 }
pub fn shift(ty: i32) -> i32 {
    if ty == 3 || ty == 17 { return 0 }
    if ty == 16 { return 1 }
    if ty == 1 || ty == 5 || ty == 6 { return 2 }
    if ty >= 8 && ty <= 10 { return ty - 8 }
    3
}
pub fn width(ty: i32) -> i32 { i32(8).shl(shift(ty)) }
pub fn maximum(ty: i32) -> i64 {
    if ty == 8 { return 255 }
    if ty == 9 { return 65535 }
    if ty == 10 { return 4294967295 }
    -1
}

pub fn shift_for(ty: i32, platform: i32) -> i32 {
    if (platform == 3 || platform == 4) && (ty == 12 || ty == 13 || ty == 18) { return 2 }
    shift(ty)
}
pub fn width_for(ty: i32, platform: i32) -> i32 { i32(8).shl(shift_for(ty, platform)) }
fn max_for(ty: i32, platform: i32) -> i64 {
    if ty == 12 && (platform == 3 || platform == 4) { return 4294967295 }
    maximum(ty)
}

fn parse_radix_u64(text: string, begin: i32, radix: i32, ty: i32) -> parse.Integer {
    mut max_div: i64 = 1844674407370955161
    mut max_rem: i64 = 5
    if radix == 16 { max_div = 1152921504606846975; max_rem = 15 }
    else if radix == 2 { max_div = 9223372036854775807; max_rem = 1 }
    mut acc: i64 = 0
    mut previous := false
    for i in begin..text.len {
        byte := i32(text[i])
        if byte == 95 {
            if !previous { return parse.Integer { ok:false, value:0, error:1 } }
            previous = false
        } else {
            mut d := -1
            if radix == 10 {
                if byte >= 48 && byte <= 57 { d = byte - 48 }
            } else if radix == 16 {
                if byte >= 48 && byte <= 57 { d = byte - 48 }
                else if byte >= 65 && byte <= 70 { d = byte - 55 }
                else if byte >= 97 && byte <= 102 { d = byte - 87 }
            } else {
                if byte == 48 || byte == 49 { d = byte - 48 }
            }
            if d < 0 { return parse.Integer { ok:false, value:0, error:1 } }
            digit := i64(d)
            if acc < 0 || acc > max_div || (acc == max_div && digit > max_rem) {
                return parse.Integer { ok:false, value:0, error:2 }
            }
            acc = acc.wrapping_mul(i64(radix)).wrapping_add(digit)
            previous = true
        }
    }
    if !previous { return parse.Integer { ok:false, value:0, error:1 } }
    if width(ty) < 64 && (acc < 0 || acc > maximum(ty)) {
        return parse.Integer { ok:false, value:0, error:2 }
    }
    parse.Integer { ok:true, value:acc, error:0 }
}

pub fn literal(text: string, ty: i32) -> parse.Integer {
    if text.len >= 2 && text[0] == 48 {
        if text[1] == 120 || text[1] == 88 { return parse_radix_u64(text, 2, 16, ty) }
        if text[1] == 98 || text[1] == 66 { return parse_radix_u64(text, 2, 2, ty) }
    }
    parse_radix_u64(text, 0, 10, ty)
}

pub fn check_max(code: &mut arm.Code, max: i64, trap: i32) {
    arm.imm(&mut code, 2, max)
    arm.compare_register(&mut code, 0, 2)
    arm.branch(&mut code, trap, 10)
}
pub fn mask(code: &mut arm.Code, ty: i32) {
    if width_for(ty, code.platform) < 64 { arm.bitfield(&mut code, false, true, 0, 0, 0, width_for(ty, code.platform) - 1) }
}
pub fn check_i8(code: &mut arm.Code, reg: i32, trap: i32) {
    arm.bitfield(&mut code, true, true, 2, reg, 0, 7)
    arm.compare_register(&mut code, reg, 2); arm.branch(&mut code, trap, 3)
}
pub fn check_i16(code: &mut arm.Code, reg: i32, trap: i32) {
    arm.bitfield(&mut code, true, true, 2, reg, 0, 15)
    arm.compare_register(&mut code, reg, 2); arm.branch(&mut code, trap, 3)
}
pub fn cast(code: &mut arm.Code, from: i32, to: i32, trap: i32) {
    if to == 17 {
        if has(from) { check_max(&mut code, 127, trap) }
        else if from != 17 { check_i8(&mut code, 0, trap) }
    } else if to == 16 {
        if has(from) { check_max(&mut code, 32767, trap) }
        else if from != 16 && from != 17 { check_i16(&mut code, 0, trap) }
    } else if to == 18 {
        if code.platform == 3 || code.platform == 4 {
            if has(from) { check_max(&mut code, 2147483647, trap) }
            else if from != 18 && from != 1 && from != 16 && from != 17 {
                arm.sign_extend_i32(&mut code, 2, 0); arm.compare_register(&mut code, 0, 2); arm.branch(&mut code, trap, 3)
            }
        } else if has(from) {
            check_max(&mut code, 9223372036854775807, trap)
        }
    } else if has(to) {
        if !has(from) {
            arm.compare_immediate(&mut code, 0, 0, false)
            arm.branch(&mut code, trap, 13)
        }
        if width_for(to, code.platform) < 64 { check_max(&mut code, max_for(to, code.platform), trap) }
    } else if has(from) {
        if to == 1 { check_max(&mut code, 2147483647, trap) }
        if to == 2 { check_max(&mut code, 9223372036854775807, trap) }
    }
}

pub fn binary(code: &mut arm.Code, op: string, ty: i32, trap: i32, zero: i32) -> i32 {
    if op == "+" {
        arm.integer_binary(&mut code, 1, true, true, 0, 1, 0, -1)
        if width_for(ty, code.platform) == 64 { arm.branch(&mut code, trap, 4) }
        else { check_max(&mut code, max_for(ty, code.platform), trap) }
    } else if op == "-" {
        arm.integer_binary(&mut code, 2, true, true, 0, 1, 0, -1); arm.branch(&mut code, trap, 5)
    } else if op == "*" {
        if width_for(ty, code.platform) == 64 {
            arm.integer_binary(&mut code, 5, true, false, 2, 1, 0, -1)
            arm.compare_immediate(&mut code, 2, 0, false); arm.branch(&mut code, trap, 3)
        }
        arm.integer_binary(&mut code, 3, true, false, 0, 1, 0, -1)
        if width_for(ty, code.platform) < 64 { check_max(&mut code, max_for(ty, code.platform), trap) }
    } else if op == "/" || op == "%" {
        arm.branch(&mut code, zero, 18); arm.integer_binary(&mut code, 7, true, false, 2, 1, 0, -1)
        if op == "/" { arm.mov(&mut code, 0, 2) } else { arm.multiply_subtract(&mut code, 0, 2, 0, 1) }
    } else {
        mut cond := 0
        if op == "!=" { cond = 1 }
        if op == "<" { cond = 3 }
        if op == "<=" { cond = 9 }
        if op == ">" { cond = 8 }
        if op == ">=" { cond = 2 }
        arm.compare_register(&mut code, 1, 0)
        arm.set_condition(&mut code, 0, cond)
        return 3
    }
    ty
}
pub fn transfer(code: &mut arm.Code, ty: i32, reg: i32, base: i32, load: bool) {
    mut shape := 3
    if ty == 3 || ty == 8 || ty == 17 { shape = 0 }
    if ty == 9 || ty == 16 { shape = 1 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 || ((code.platform == 3 || code.platform == 4) && (ty == 12 || ty == 13 || ty == 18)) { shape = 2 }
    if load && (ty == 1 || ((code.platform == 3 || code.platform == 4) && ty == 18)) { shape = 4 }
    arm.transfer(&mut code, load, reg, base, shape, 0)
    if load && ty == 16 { arm.bitfield(&mut code, true, true, reg, reg, 0, 15) }
    if load && ty == 17 { arm.bitfield(&mut code, true, true, reg, reg, 0, 7) }
}
