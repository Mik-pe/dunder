pub fn inline_descriptor(code: &mut raw.Code, count: i32, elem_c_size: i32, slots: &mut i32, error: &mut string) {
    if code.forbid_emit {
        slots = slots + 6
        if slots > 65535 && error == "" {
            error = "this compiler stage allows at most 65535 local slots per function"
        }
        return
    }
    fa.inline_descriptor(&mut code, count, elem_c_size, &mut slots, &mut error)
}

pub fn emit_foreign_call(code: &mut raw.Code, spec: &fa.ForeignCallSpec, callee: i32,
    values: &[]i32, locations: &[]i32, result_slot: i32, indirect_result: bool, gp: i32, fp: i32, outgoing: i32,
    has_callbacks: bool, patches: &mut fa.Patches, float_trap: i32, overflow: i32) {
    if code.forbid_emit { return }
    fa.emit_foreign_call(&mut code, &spec, callee, &values, &locations, result_slot, indirect_result, gp, fp, outgoing, has_callbacks, &mut patches, float_trap, overflow)
}

