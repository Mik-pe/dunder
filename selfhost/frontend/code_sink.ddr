    unsigned.cast(&mut code, from, to, trap)
}

pub fn unsigned_binary(code: &mut raw.Code, op: string, ty: i32, trap: i32, zero: i32) -> i32 {
    if code.forbid_emit {
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return 3 }
        return ty
    }
    unsigned.binary(&mut code, op, ty, trap, zero)
}

