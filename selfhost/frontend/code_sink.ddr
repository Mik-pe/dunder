pub fn float_binary(code: &mut raw.Code, op: string, ty: i32, offset: i32) -> i32 {
    if code.forbid_emit { return float_op.result(rules.opcode(op), ty) }
    floats.binary(&mut code, op, ty, offset)
}

pub fn float_method(code: &mut raw.Code, ty: i32, name: string, offset: i32) -> i32 {
    if code.forbid_emit {
        op := float_op.method(name)
        if op == 0 { return -1 }
        return float_op.result(op, ty)
    }
    floats.method(&mut code, ty, name, offset)
}

pub fn float_cast(code: &mut raw.Code, from: i32, to: i32, trap: i32, offset: i32) {
    if code.forbid_emit { return }
