@test fn no_emit_sink_produces_zero_words_and_labels() {
    mut code := new_no_emit(0)
    lbl := label(&mut code)
    fr := prologue(&mut code)
    mark(&mut code, lbl)
    imm(&mut code, 0, 42)
    store(&mut code, 0, 0)
    branch(&mut code, lbl, 0)
    frame(&mut code, fr, 2)
    ret(&mut code)
    assert(code.forbid_emit && code.checking)
    assert(position(&code) == 0 && label_count(&code) == 0)
    assert(code.words.len == 0 && code.labels.len == 0 && code.virtual_words == 0 && code.virtual_labels == 0)
}
