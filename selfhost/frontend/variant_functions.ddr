import declarations as decl
import frontend_types as ft
import lexer
import type_reader

pub fn key(ty: i32, field: i32) -> string { f"#variant:{ty}:{field}" }

fn declaring_type(world: &decl.World, types: &ft.TypeRegistry, site: i32) -> i32 {
    name := &world.tokens.texts[site]
    if name != "Self" { return ft.type_id(&types, name) }
    for f in 0..world.names.len {
        if world.starts[f] <= site && site < world.ends[f] { return world.impl_types[f] }
    }
    -1
}

fn register(world: &mut decl.World, types: &mut ft.TypeRegistry, ty: i32, field: i32, site: i32) {
    name := key(ty, field)
    if world.functions.contains(name) { return }
    mut args: []i32 = []
    mut body := "{ ." + types.field_names[field] + "("
    start := types.payload_starts[field]
    for i in 0..types.payload_counts[field] {
        pt := types.payload_types[start + i]
        args.push(pt)
        if i > 0 { body += "," }
        if ft.owned(&types, pt) { body += "move " }
        body += f"item{i}"
    }
    mut origin := -1
    if ft.lends(&types, ty) {
        for i in 0..args.len {
            if ft.lends(&types, args[i]) {
                if origin >= 0 { return }
                origin = i
            }
        }
        if origin < 0 { return }
    }
    sig := type_reader.callable(&mut types, &args, ty, 9, origin)
    generated := lexer.scan(body + ") }", false)
    first := world.tokens.kinds.len - 1
    for i in 0..generated.kinds.len {
        if i == 0 {
            world.tokens.kinds[first] = .Symbol; world.tokens.texts[first] = "{"
            world.tokens.starts[first] = world.tokens.starts[site]
        } else {
            world.tokens.kinds.push(generated.kinds[i])
            world.tokens.texts.push(generated.texts[i].clone())
            world.tokens.starts.push(world.tokens.starts[site])
            world.closes.push(-1)
        }
    }
    end := world.tokens.kinds.len - 2
    world.closes[first] = end
    world.functions.put(name.clone(), i64(world.names.len))
    world.names.push(move name)
    world.param_starts.push(world.param_names.len); world.param_counts.push(args.len)
    for i in 0..args.len {
        world.param_names.push(f"item{i}"); world.param_tokens.push(first)
        world.param_types.push(args[i]); world.param_mutable.push(false)
    }
    world.starts.push(first + 1); world.ends.push(end)
    world.returns.push(ty); world.return_fields.push(-1); world.ffi_types.push(sig)
    world.test_functions.push(false); world.unsafe_functions.push(false); world.thread_safe.push(false)
    world.libraries.push(""); world.symbols.push(""); world.function_owners.push(types.type_owners[ty])
    world.impl_types.push(-1); world.impl_public.push(false); world.impl_has_self.push(false)
    world.impl_self_mut.push(false); world.impl_names.push(""); world.requires_caps.push(0)
    decl.push_default_extern_meta(&mut world)
}

pub fn prepare(world: &mut decl.World, types: &mut ft.TypeRegistry, sites: &[]i32) {
    for site in &sites {
        ty := declaring_type(&world, &types, site)
        if ty < 0 || ft.type_kind(&types, ty) != 7 { continue }
        field := ft.field(&types, ty, world.tokens.texts[site + 2])
        if field >= 0 && types.payload_counts[field] > 0 { register(&mut world, &mut types, ty, field, site) }
    }
}
