import frontend_types as ft

pub struct Patterns {
    kinds: []i32, fields: []i32, ints: []i64, strings: []string, ends: []i32, previous: []i32,
    heads: []i32, full: []bool, roots: []i32, wildcard: bool, remaining: i32,
}
pub fn new(count: i32) -> Patterns {
    mut heads: []i32 = []
    mut full: []bool = []
    for _ in 0..count { heads.push(-1); full.push(false) }
    Patterns { kinds: [], fields: [], ints: [], strings: [], ends: [], previous: [], heads: heads, full: full, roots: [], wildcard: false, remaining: 4000000 }
}
fn push_node(p: &mut Patterns, kind: i32, field: i32, int_val: i64, move str_val: string) -> i32 {
    id := p.kinds.len
    p.kinds.push(kind); p.fields.push(field); p.ints.push(int_val); p.strings.push(move str_val)
    p.ends.push(id + 1); p.previous.push(-1)
    id
}
pub fn node(p: &mut Patterns, field: i32) -> i32 {
    kind := if field < 0 { 0 } else { 1 }
    push_node(&mut p, kind, field, 0, "")
}
pub fn tuple_node(p: &mut Patterns) -> i32 { push_node(&mut p, 2, -1, 0, "") }
pub fn bool_node(p: &mut Patterns, value: bool) -> i32 {
    v: i64 = if value { 1 } else { 0 }
    push_node(&mut p, 3, -1, v, "")
}
pub fn int_node(p: &mut Patterns, value: i64) -> i32 { push_node(&mut p, 4, -1, value, "") }
pub fn string_node(p: &mut Patterns, move value: string) -> i32 { push_node(&mut p, 5, -1, 0, move value) }
pub fn or_node(p: &mut Patterns) -> i32 { push_node(&mut p, 6, -1, 0, "") }
pub fn close(p: &mut Patterns, id: i32) { p.ends[id] = p.kinds.len }

fn node_kind(p: &Patterns, id: i32) -> i32 {
    if id < 0 { return 0 }
    p.kinds[id]
}
fn spend(remaining: &mut i32, cost: i64) -> bool {
    if cost > i64(remaining) { remaining = 0; return false }
    remaining = remaining - i32(cost)
    true
}
fn subpatterns(p: &Patterns, id: i32, arity: i32, cells: &mut []i32) {
    kind := node_kind(&p, id)
    if kind == 0 {
        for _ in 0..arity { cells.push(-1) }
        return
    }
    mut child := id + 1
    for _ in 0..arity {
        cells.push(child)
        child = p.ends[child]
    }
}
fn constructor_arity(p: &Patterns, reg: &ft.TypeRegistry, ty: i32, qid: i32) -> i32 {
    kind := node_kind(&p, qid)
    if kind == 1 { return reg.payload_counts[p.fields[qid]] }
    if kind == 2 { return ft.type_count(&reg, ty) }
    0
}
fn push_constructor_types(p: &Patterns, reg: &ft.TypeRegistry, ty: i32, qid: i32, out: &mut []i32) {
    kind := node_kind(&p, qid)
    if kind == 1 {
        variant := p.fields[qid]
        arity := reg.payload_counts[variant]
        start := reg.payload_starts[variant]
        for j in 0..arity { out.push(reg.payload_types[start + j]) }
    } else if kind == 2 {
        arity := ft.type_count(&reg, ty)
        start := ft.type_start(&reg, ty)
        for j in 0..arity { out.push(reg.field_types[start + j]) }
    }
}
fn matches_node(p: &Patterns, a: i32, b: i32) -> bool {
    ka := node_kind(&p, a); kb := node_kind(&p, b)
    if ka != kb { return false }
    if ka == 1 { return p.fields[a] == p.fields[b] }
    if ka == 2 { return true }
    if ka == 3 || ka == 4 { return p.ints[a] == p.ints[b] }
    if ka == 5 { return p.strings[a] == p.strings[b] }
    false
}
fn append_expanded_cell(p: &Patterns, id: i32, width: i32, pivot: i32, rows: &[]i32, offset: i32, out: &mut []i32, remaining: &mut i32, depth: i32) -> bool {
    if depth > 64 { return false }
    if node_kind(&p, id) == 6 {
        mut ch := id + 1
        while ch < p.ends[id] {
            if !append_expanded_cell(&p, ch, width, pivot, &rows, offset, &mut out, &mut remaining, depth + 1) { return false }
            ch = p.ends[ch]
        }
        return true
    }
    if !spend(&mut remaining, i64(width)) { return false }
    for col in 0..width {
        if col == pivot { out.push(id) } else { out.push(rows[offset + col]) }
    }
    true
}
fn expand_col(p: &Patterns, rows: &[]i32, width: i32, pivot: i32, out: &mut []i32, remaining: &mut i32) -> bool {
    mut offset := 0
    while offset < rows.len {
        id := rows[offset + pivot]
        if node_kind(&p, id) == 6 {
            if !append_expanded_cell(&p, id, width, pivot, &rows, offset, &mut out, &mut remaining, 0) { return false }
        } else {
            if !spend(&mut remaining, i64(width)) { return false }
            for col in 0..width { out.push(rows[offset + col]) }
        }
        offset = offset + width
    }
    true
}
fn row_has_non_wildcard(p: &Patterns, rows: &[]i32, offset: i32, width: i32) -> i32 {
    for col in 0..width {
        if node_kind(&p, rows[offset + col]) != 0 { return col }
    }
    -1
}

fn specialize_enum(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, rows: &[]i32, query: &[]i32,
                   pivot: i32, variant: i32, remaining: &mut i32, depth: i32) -> i32 {
    arity := reg.payload_counts[variant]
    width := types.len
    next_width := width - 1 + arity
    if !spend(&mut remaining, i64(next_width) + 1) { return -1 }
    mut next_types: []i32 = []; mut next_query: []i32 = []; mut next_rows: []i32 = []
    for col in 0..width {
        if col == pivot {
            start := reg.payload_starts[variant]
            for j in 0..arity { next_types.push(reg.payload_types[start + j]) }
            subpatterns(&p, query[col], arity, &mut next_query)
        } else { next_types.push(types[col]); next_query.push(query[col]) }
    }
    mut expanded: []i32 = []
    if !expand_col(&p, &rows, width, pivot, &mut expanded, &mut remaining) { return -1 }
    mut offset := 0
    mut any_matched := false
    while offset < expanded.len {
        if !spend(&mut remaining, 1) { return -1 }
        id := expanded[offset + pivot]; kind := node_kind(&p, id)
        if kind == 0 || (kind == 1 && p.fields[id] == variant) {
            any_matched = true
            if next_width == 0 { return 0 }
            if !spend(&mut remaining, i64(next_width)) { return -1 }
            for col in 0..width {
                if col == pivot { subpatterns(&p, id, arity, &mut next_rows) }
                else { next_rows.push(expanded[offset + col]) }
            }
        }
        offset = offset + width
    }
    if next_width == 0 { if any_matched { return 0 } else { return 1 } }
    useful(&p, &reg, &next_types, &next_rows, &next_query, &mut remaining, depth + 1)
}

fn specialize_node(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, rows: &[]i32, query: &[]i32,
                   pivot: i32, qid: i32, remaining: &mut i32, depth: i32) -> i32 {
    arity := constructor_arity(&p, &reg, types[pivot], qid)
    width := types.len
    next_width := width - 1 + arity
    if !spend(&mut remaining, i64(next_width) + 1) { return -1 }
    mut next_types: []i32 = []; mut next_query: []i32 = []; mut next_rows: []i32 = []
    for col in 0..width {
        if col == pivot {
            push_constructor_types(&p, &reg, types[pivot], qid, &mut next_types)
            subpatterns(&p, qid, arity, &mut next_query)
        } else { next_types.push(types[col]); next_query.push(query[col]) }
    }
    mut expanded: []i32 = []
    if !expand_col(&p, &rows, width, pivot, &mut expanded, &mut remaining) { return -1 }
    mut offset := 0
    mut any_matched := false
    while offset < expanded.len {
        if !spend(&mut remaining, 1) { return -1 }
        id := expanded[offset + pivot]
        if node_kind(&p, id) == 0 || matches_node(&p, id, qid) {
            any_matched = true
            if next_width == 0 { return 0 }
            if !spend(&mut remaining, i64(next_width)) { return -1 }
            for col in 0..width {
                if col == pivot { subpatterns(&p, id, arity, &mut next_rows) }
                else { next_rows.push(expanded[offset + col]) }
            }
        }
        offset = offset + width
    }
    if next_width == 0 { if any_matched { return 0 } else { return 1 } }
    useful(&p, &reg, &next_types, &next_rows, &next_query, &mut remaining, depth + 1)
}

fn specialize_bool(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, expanded: &[]i32, query: &[]i32,
                   pivot: i32, target: i64, remaining: &mut i32, depth: i32) -> i32 {
    width := types.len; next_width := width - 1
    if !spend(&mut remaining, i64(next_width) + 1) { return -1 }
    mut next_types: []i32 = []; mut next_query: []i32 = []; mut next_rows: []i32 = []
    for col in 0..width {
        if col != pivot { next_types.push(types[col]); next_query.push(query[col]) }
    }
    mut offset := 0; mut any_matched := false
    while offset < expanded.len {
        id := expanded[offset + pivot]; kind := node_kind(&p, id)
        if kind == 0 || (kind == 3 && p.ints[id] == target) {
            any_matched = true
            if next_width == 0 { return 0 }
            if !spend(&mut remaining, i64(next_width)) { return -1 }
            for col in 0..width {
                if col != pivot { next_rows.push(expanded[offset + col]) }
            }
        }
        offset = offset + width
    }
    if next_width == 0 { if any_matched { return 0 } else { return 1 } }
    useful(&p, &reg, &next_types, &next_rows, &next_query, &mut remaining, depth + 1)
}

fn specialize_default(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, expanded: &[]i32, query: &[]i32,
                      pivot: i32, remaining: &mut i32, depth: i32) -> i32 {
    width := types.len; next_width := width - 1
    if !spend(&mut remaining, i64(next_width) + 1) { return -1 }
    mut next_types: []i32 = []; mut next_query: []i32 = []; mut next_rows: []i32 = []
    for col in 0..width {
        if col != pivot { next_types.push(types[col]); next_query.push(query[col]) }
    }
    mut offset := 0; mut any_matched := false
    while offset < expanded.len {
        id := expanded[offset + pivot]
        if node_kind(&p, id) == 0 {
            any_matched = true
            if next_width == 0 { return 0 }
            if !spend(&mut remaining, i64(next_width)) { return -1 }
            for col in 0..width {
                if col != pivot { next_rows.push(expanded[offset + col]) }
            }
        }
        offset = offset + width
    }
    if next_width == 0 { if any_matched { return 0 } else { return 1 } }
    useful(&p, &reg, &next_types, &next_rows, &next_query, &mut remaining, depth + 1)
}

fn useful(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, rows: &[]i32, query: &[]i32, remaining: &mut i32, depth: i32) -> i32 {
    if rows.len == 0 { return 1 }
    if types.len == 0 { return 0 }
    if depth > 128 || !spend(&mut remaining, i64(rows.len) + i64(query.len) + 1) { return -1 }
    for col in 0..query.len {
        if node_kind(&p, query[col]) == 6 {
            qid := query[col]
            mut sub_query: []i32 = []
            for j in 0..query.len { sub_query.push(query[j]) }
            mut ch := qid + 1
            while ch < p.ends[qid] {
                sub_query[col] = ch
                res := useful(&p, &reg, &types, &rows, &sub_query, &mut remaining, depth + 1)
                if res != 0 { return res }
                ch = p.ends[ch]
            }
            return 0
        }
    }
    for col in 0..query.len {
        if node_kind(&p, query[col]) != 0 {
            return specialize_node(&p, &reg, &types, &rows, &query, col, query[col], &mut remaining, depth)
        }
    }
    mut pivot := -1
    mut offset := 0
    while offset < rows.len {
        first := row_has_non_wildcard(&p, &rows, offset, types.len)
        if first < 0 { return 0 }
        if pivot < 0 { pivot = first }
        offset = offset + types.len
    }
    mut expanded: []i32 = []
    if !expand_col(&p, &rows, types.len, pivot, &mut expanded, &mut remaining) { return -1 }
    offset = 0
    while offset < expanded.len {
        if row_has_non_wildcard(&p, &expanded, offset, types.len) < 0 { return 0 }
        offset = offset + types.len
    }
    ty := types[pivot]
    if ft.is_tuple(&reg, ty) {
        return specialize_tuple(&p, &reg, &types, &expanded, &query, pivot, &mut remaining, depth)
    }
    if ty == 3 {
        mut has_false := false; mut has_true := false
        offset = 0
        while offset < expanded.len {
            id := expanded[offset + pivot]
            if node_kind(&p, id) == 3 {
                if p.ints[id] == 0 { has_false = true } else { has_true = true }
            }
            offset = offset + types.len
        }
        if has_false && has_true {
            r0 := specialize_bool(&p, &reg, &types, &expanded, &query, pivot, 0, &mut remaining, depth)
            if r0 != 0 { return r0 }
            return specialize_bool(&p, &reg, &types, &expanded, &query, pivot, 1, &mut remaining, depth)
        }
        return specialize_default(&p, &reg, &types, &expanded, &query, pivot, &mut remaining, depth)
    }
    if reg.declared.type_kinds[ty] == 3 || reg.declared.type_kinds[ty] == 7 {
        count := reg.declared.type_counts[ty]; start := reg.declared.type_starts[ty]
        if !spend(&mut remaining, i64(count)) { return -1 }
        mut present: []bool = []
        for _ in 0..count { present.push(false) }
        offset = 0; mut distinct := 0
        while offset < expanded.len {
            id := expanded[offset + pivot]
            if node_kind(&p, id) == 1 {
                variant := p.fields[id]
                if !present[variant - start] { present[variant - start] = true; distinct = distinct + 1 }
            }
            offset = offset + types.len
        }
        if distinct == count {
            for variant in start..start + count {
                result := specialize_enum(&p, &reg, &types, &expanded, &query, pivot, variant, &mut remaining, depth)
                if result != 0 { return result }
            }
            return 0
        }
    }
    specialize_default(&p, &reg, &types, &expanded, &query, pivot, &mut remaining, depth)
}
fn specialize_tuple(p: &Patterns, reg: &ft.TypeRegistry, types: &[]i32, expanded: &[]i32, query: &[]i32,
                    pivot: i32, remaining: &mut i32, depth: i32) -> i32 {
    ty := types[pivot]
    arity := ft.type_count(&reg, ty)
    start := ft.type_start(&reg, ty)
    width := types.len
    next_width := width - 1 + arity
    if !spend(&mut remaining, i64(next_width) + 1) { return -1 }
    mut next_types: []i32 = []; mut next_query: []i32 = []; mut next_rows: []i32 = []
    for col in 0..width {
        if col == pivot {
            for j in 0..arity { next_types.push(reg.field_types[start + j]) }
            for _ in 0..arity { next_query.push(-1) }
        } else { next_types.push(types[col]); next_query.push(query[col]) }
    }
    mut offset := 0
    while offset < expanded.len {
        if !spend(&mut remaining, i64(next_width) + 1) { return -1 }
        id := expanded[offset + pivot]
        for col in 0..width {
            if col == pivot { subpatterns(&p, id, arity, &mut next_rows) }
            else { next_rows.push(expanded[offset + col]) }
        }
        offset = offset + width
    }
    useful(&p, &reg, &next_types, &next_rows, &next_query, &mut remaining, depth + 1)
}

pub fn add(p: &mut Patterns, reg: &ft.TypeRegistry, ty: i32, root: i32, guarded: bool) -> string {
    if p.wildcard { return "unreachable match pattern" }
    if p.kinds[root] == 0 && !guarded {
        p.roots.push(root)
        p.wildcard = true
        return ""
    }
    is_enum := reg.declared.type_kinds[ty] == 3 || reg.declared.type_kinds[ty] == 7
    mut flat := true
    mut ordinal := -1
    if is_enum && p.kinds[root] == 1 {
        ordinal = p.fields[root] - reg.declared.type_starts[ty]
        mut child := root + 1
        while child < p.ends[root] {
            if p.kinds[child] != 0 { flat = false; break }
            child = p.ends[child]
        }
        if p.full[ordinal] {
            if flat && !guarded { return "duplicate match variant" }
            return "unreachable match pattern"
        }
    }
    mut remaining := p.remaining
    ts: []i32 = [ty]; qs: []i32 = [root]
    result := useful(&p, &reg, &ts, &p.roots, &qs, &mut remaining, 0)
    p.remaining = remaining
    if result < 0 { return "match pattern coverage limit exceeded" }
    if result == 0 { return "unreachable match pattern" }
    if guarded { return "" }
    p.roots.push(root)
    if p.kinds[root] == 0 { p.wildcard = true }
    if is_enum && p.kinds[root] == 1 && flat { p.full[ordinal] = true }
    ""
}
pub fn complete(p: &mut Patterns, reg: &ft.TypeRegistry, ty: i32) -> string {
    if p.wildcard { return "" }
    mut remaining := p.remaining
    ts: []i32 = [ty]; qs: []i32 = [-1]
    result := useful(&p, &reg, &ts, &p.roots, &qs, &mut remaining, 0)
    p.remaining = remaining
    if result < 0 { return "match pattern coverage limit exceeded" }
    if result == 1 { return "non-exhaustive match" }
    ""
}

@test fn product_patterns_agree_with_finite_domain() {
    mut reg := ft.new_registry()
    bit := ft.add_type(&mut reg, "Bit", 3, 0)
    pair := ft.add_type(&mut reg, "Pair", 7, 0)
    reg.declared.type_counts[bit] = 2
    reg.declared.type_starts[pair] = 2; reg.declared.type_counts[pair] = 1
    reg.payload_starts = [0, 0, 0]; reg.payload_counts = [0, 0, 2]
    reg.payload_types = [bit, bit]
    for subset in 0..512 {
        mut patterns := new(1)
        mut covered := 0
        for choice in 0..9 {
            if subset.bit_and(1.shl(choice)) == 0 { continue }
            left := choice / 3 - 1; right := choice % 3 - 1
            mut mask := 0
            for point in 0..4 {
                if (left < 0 || left == point / 2) && (right < 0 || right == point % 2) {
                    mask = mask.bit_or(1.shl(point))
                }
            }
            root := node(&mut patterns, 2)
            _ := node(&mut patterns, left); _ := node(&mut patterns, right)
            close(&mut patterns, root)
            guarded := add(&mut patterns, &reg, pair, root, true)
            message := add(&mut patterns, &reg, pair, root, false)
            assert(guarded == message)
            if mask.bit_and(covered) == mask { assert(message == "unreachable match pattern") }
            else { assert(message == "") }
            covered = covered.bit_or(mask)
        }
        fallback := node(&mut patterns, -1)
        guarded := add(&mut patterns, &reg, pair, fallback, true)
        outcome := complete(&mut patterns, &reg, pair)
        if covered == 15 { assert(guarded == "unreachable match pattern" && outcome == "") }
        else { assert(guarded == "" && outcome == "non-exhaustive match") }
        assert(add(&mut patterns, &reg, pair, fallback, false) == "")
        assert(complete(&mut patterns, &reg, pair) == "")
    }
}
