import ..backend.ffi_arm64 as abi
import type_keys
import typed_places as places

pub struct Shapes {
    type_kinds: []i32, type_bases: []i32, type_starts: []i32, type_counts: []i32,
    ffi_params: []i32, callable_parameters: []i32, c_sizes: []i32, c_aligns: []i32,
    compound_buckets: []i32, compound_count: i32, fixed_buckets: []i32, fixed_count: i32,
    callable_buckets: []i32, callable_count: i32,
}
fn shapes() -> Shapes {
    Shapes {
        type_kinds: [], type_bases: [], type_starts: [], type_counts: [],
        ffi_params: [], callable_parameters: [], c_sizes: [], c_aligns: [],
        compound_buckets: [], compound_count: 0, fixed_buckets: [], fixed_count: 0,
        callable_buckets: [], callable_count: 0,
    }
}

pub struct TypeRegistry {
    declared: Shapes, body: Shapes, sealed: bool,
    type_names: []string, field_names: []string, field_types: []i32, field_values: []i64,
    payload_starts: []i32, payload_counts: []i32, payload_types: []i32,
    opaque_owner: []i32, opaque_sendable: []bool, type_owners: []i32, c_record: []bool, resource: []bool,
    cleanup_methods: []i32, has_cleanup: bool, self_type: i32, named_map: Map<string, i64>, error: string,
    result_success: []i32, result_failure: []i32, option_inner: []i32,
    map_key: []i32, map_value: []i32, set_elem: []i32,
    tuples: type_keys.Index, pending_tuples: i32, tuple_sites: Map<string, i64>, bound_arguments: []i32, const_lengths: Map<string, i64>,
    declared_flags: []i32,
}
pub fn new_registry() -> TypeRegistry {
    mut named := Map<string, i64>::new(); named.reserve(64)
    TypeRegistry {
        declared: shapes(), body: shapes(), sealed: false, named_map: named,
        type_names: [], field_names: [], field_types: [], field_values: [],
        payload_starts: [], payload_counts: [], payload_types: [],
        opaque_owner: [], opaque_sendable: [], type_owners: [], c_record: [], resource: [],
        cleanup_methods: [], has_cleanup: false, self_type: -1, error: "",
        result_success: [], result_failure: [], option_inner: [],
        map_key: [], map_value: [], set_elem: [],
        tuples: type_keys.new(), pending_tuples: 0, tuple_sites: Map<string, i64>::new(), bound_arguments: [],
        const_lengths: Map<string, i64>::new(),
        declared_flags: [],
    }
}
pub fn reset_body(reg: &mut TypeRegistry) {
    if reg.body.type_kinds.len == 0 { return }
    reg.body.type_kinds.clear(); reg.body.type_bases.clear()
    reg.body.type_starts.clear(); reg.body.type_counts.clear(); reg.body.ffi_params.clear(); reg.body.callable_parameters.clear()
    reg.body.c_sizes.clear(); reg.body.c_aligns.clear()
    reg.body.compound_buckets.clear(); reg.body.compound_count = 0
    reg.body.fixed_buckets.clear(); reg.body.fixed_count = 0
    reg.body.callable_buckets.clear(); reg.body.callable_count = 0
}
pub fn restore_shapes(reg: &mut TypeRegistry, table: &[]i32) {
    reset_body(&mut reg)
    assert(table.len >= 2 && table[0] == reg.declared.type_kinds.len)
    count := table[1]
    for i in 0..count {
        at := 2 + i * 5
        reg.body.type_kinds.push(table[at]); reg.body.type_bases.push(table[at + 1])
        reg.body.type_starts.push(table[at + 2]); reg.body.type_counts.push(table[at + 3])
        reg.body.callable_parameters.push(table[at + 4])
    }
    for i in (2 + count * 5)..table.len { reg.body.ffi_params.push(table[i]) }
}
pub fn set_error(reg: &mut TypeRegistry, move message: string) {
    if reg.error == "" { reg.error = message }
}

fn append_shape(arena: &mut Shapes, kind: i32, base: i32) -> i32 {
    index := arena.type_kinds.len
    arena.type_kinds.push(kind); arena.type_bases.push(base)
    arena.type_starts.push(0); arena.type_counts.push(0)
    arena.callable_parameters.push(-1)
    arena.c_sizes.push(0); arena.c_aligns.push(0)
    index
}
fn declared_row(reg: &mut TypeRegistry, move name: string) {
    reg.opaque_owner.push(-1); reg.opaque_sendable.push(false); reg.type_owners.push(-1); reg.c_record.push(false); reg.resource.push(false)
    reg.cleanup_methods.push(-1); reg.type_names.push(move name)
    reg.result_success.push(-1); reg.result_failure.push(-1); reg.option_inner.push(-1)
    reg.map_key.push(-1); reg.map_value.push(-1); reg.set_elem.push(-1)
}
pub fn add_type(reg: &mut TypeRegistry, name: string, kind: i32, base: i32) -> i32 {
    assert(!reg.sealed)
    id := append_shape(&mut reg.declared, kind, base)
    declared_row(&mut reg, move name.clone())
    if name != "" && !reg.named_map.contains(name) {
        reg.named_map.put(name.clone(), i64(id))
    }
    id
}
pub fn type_id(reg: &TypeRegistry, name: string) -> i32 {
    if name == "" { return -1 }
    i32(reg.named_map.get_or(name, -1))
}
pub fn argument_name(reg: &mut TypeRegistry, ty: i32) -> string {
    if reg.type_names[ty] != "" { return reg.type_names[ty].clone() }
    name := "$" + ty.str()
    if !reg.named_map.contains(name) { reg.named_map.put(name.clone(), i64(ty)); reg.bound_arguments.push(ty) }
    name
}

pub fn is_result(reg: &TypeRegistry, ty: i32) -> bool {
    ty >= 0 && ty < reg.result_success.len && reg.result_success[ty] >= 0
}
pub fn is_option(reg: &TypeRegistry, ty: i32) -> bool {
    ty >= 0 && ty < reg.option_inner.len && reg.option_inner[ty] >= 0
}
pub fn is_map(reg: &TypeRegistry, ty: i32) -> bool {
    ty >= 0 && ty < reg.map_key.len && reg.map_key[ty] >= 0
}
pub fn is_set(reg: &TypeRegistry, ty: i32) -> bool {
    ty >= 0 && ty < reg.set_elem.len && reg.set_elem[ty] >= 0
}
pub fn is_tuple(reg: &TypeRegistry, ty: i32) -> bool {
    if ty < 0 || ty >= reg.type_names.len || reg.declared.type_kinds[ty] != 2 { return false }
    name := &reg.type_names[ty]
    name.len > 0 && name[0] == 40
}
pub fn find_tuple(reg: &TypeRegistry, fields: &[]i32) -> i32 {
    type_keys.find(&reg.tuples, 0, &fields)
}
pub fn tuple_type(reg: &mut TypeRegistry, fields: &[]i32) -> i32 {
    if fields.len < 2 { set_error(&mut reg, move "a tuple type requires at least two components"); return 0 }
    known := find_tuple(&reg, &fields)
    if known >= 0 { return known }
    mut spelling := "("
    for i in 0..fields.len {
        ty := fields[i]
        if !array_element(&reg, ty) { set_error(&mut reg, move "tuple components must be storable values"); return 0 }
        if i != 0 { spelling = spelling + ", " }
        spelling = spelling + type_spelling(&reg, ty)
    }
    spelling = spelling + ")"
    if reg.sealed { set_error(&mut reg, move "tuple type was not registered before body checking"); return 0 }
    ty := add_type(&mut reg, spelling, 2, 0)
    type_keys.insert(&mut reg.tuples, 0, &fields, ty)
    ty
}
pub fn finish_tuples(reg: &mut TypeRegistry) {
    for entry in reg.pending_tuples..reg.tuples.values.len {
        ty := reg.tuples.values[entry]; first := reg.tuples.starts[entry]
        count := reg.tuples.starts[entry + 1] - first
        reg.declared.type_starts[ty] = reg.field_types.len
        reg.declared.type_counts[ty] = count
        for i in 0..count {
            reg.field_names.push(i.str()); reg.field_types.push(reg.tuples.arguments[first + i]); reg.field_values.push(i64(i))
            reg.payload_starts.push(reg.payload_types.len); reg.payload_counts.push(0)
        }
    }
    reg.pending_tuples = reg.tuples.values.len
}

pub fn type_kind(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_kinds[ty] }
    reg.body.type_kinds[ty - prefix]
}
pub fn type_base(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_bases[ty] }
    reg.body.type_bases[ty - prefix]
}
pub fn type_count(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_counts[ty] }
    reg.body.type_counts[ty - prefix]
}
fn callable_parameter(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.callable_parameters[ty] }
    reg.body.callable_parameters[ty - prefix]
}
pub fn c_variadic_fixed(reg: &TypeRegistry, ty: i32) -> i32 {
    if type_kind(&reg, ty) != 8 { return -1 }
    callable_parameter(&reg, ty)
}
pub fn return_borrow_parameter(reg: &TypeRegistry, ty: i32) -> i32 {
    if !is_dunder_callable_kind(type_kind(&reg, ty)) { return -1 }
    callable_parameter(&reg, ty)
}
pub fn type_start(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_starts[ty] }
    reg.declared.ffi_params.len + reg.body.type_starts[ty - prefix]
}
pub fn parameter_type(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.ffi_params.len
    if ty < prefix { return reg.declared.ffi_params[ty] }
    reg.body.ffi_params[ty - prefix]
}
pub fn c_size(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.c_sizes[ty] }
    reg.body.c_sizes[ty - prefix]
}
pub fn c_align(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.c_aligns[ty] }
    reg.body.c_aligns[ty - prefix]
}
pub fn declared_name(reg: &TypeRegistry, ty: i32) -> string {
    if ty >= reg.type_names.len { return "" }
    reg.type_names[ty].clone()
}
pub fn is_c_record(reg: &TypeRegistry, ty: i32) -> bool {
    if ty >= reg.c_record.len { return false }
    reg.c_record[ty]
}
pub fn declaring_owner(reg: &TypeRegistry, ty: i32) -> i32 {
    if ty >= reg.opaque_owner.len { return -1 }
    reg.opaque_owner[ty]
}
pub fn cleanup_method(reg: &TypeRegistry, ty: i32) -> i32 {
    if !reg.has_cleanup || ty < 0 || ty >= reg.cleanup_methods.len { return -1 }
    reg.cleanup_methods[ty]
}
pub fn scalar_element(reg: &TypeRegistry, ty: i32) -> bool {
    if (ty >= 1 && ty <= 13) || ty == 16 { return true }
    kind := type_kind(&reg, ty); kind == 3 || kind == 22
}

pub fn is_closure_kind(kind: i32) -> bool {
    kind == 11 || kind == 12 || kind == 13
}

pub fn is_dunder_callable_kind(kind: i32) -> bool {
    kind == 9 || is_closure_kind(kind)
}

pub fn is_borrowed_closure(reg: &TypeRegistry, ty: i32) -> bool {
    kind := type_kind(&reg, ty)
    if kind != 4 && kind != 5 { return false }
    base_kind := type_kind(&reg, type_base(&reg, ty))
    (kind == 4 && base_kind == 11) || (kind == 5 && base_kind == 12)
}

pub fn same_callable_signature(reg: &TypeRegistry, a: i32, b: i32) -> bool {
    if !is_dunder_callable_kind(type_kind(&reg, a)) || !is_dunder_callable_kind(type_kind(&reg, b)) {
        return false
    }
    if type_base(&reg, a) != type_base(&reg, b) || type_count(&reg, a) != type_count(&reg, b) {
        return false
    }
    if return_borrow_parameter(&reg, a) != return_borrow_parameter(&reg, b) {
        return false
    }
    sa := type_start(&reg, a)
    sb := type_start(&reg, b)
    for i in 0..type_count(&reg, a) {
        if parameter_type(&reg, sa + i) != parameter_type(&reg, sb + i) { return false }
    }
    true
}

pub fn array_element(reg: &TypeRegistry, ty: i32) -> bool {
    if ty <= 0 || ty >= reg.declared.type_kinds.len + reg.body.type_kinds.len { return false }
    if stores_borrow(&reg, ty) { return false }
    kind := type_kind(&reg, ty)
    if kind == 0 { return ty <= 13 || ty == 16 }
    kind == 1 || kind == 2 || kind == 3 || kind == 6 || kind == 7 || kind == 8 || is_dunder_callable_kind(kind) || kind == 22
}

pub fn foreign_scalar(reg: &TypeRegistry, ty: i32) -> bool {
    ty == 16 || ty == 1 || ty == 2 || (ty >= 6 && ty <= 13) || type_kind(&reg, ty) == 8
}

pub fn stores_borrow(reg: &TypeRegistry, ty: i32) -> bool {
    ty >= 0 && ty < reg.declared_flags.len && reg.declared_flags[ty].bit_and(32) != 0 &&
        type_kind(&reg, ty) != 4
}

pub fn lends(reg: &TypeRegistry, ty: i32) -> bool {
    k := type_kind(&reg, ty)
    k == 4 || k == 5 || stores_borrow(&reg, ty)
}

pub fn foreign_width(ty: i32) -> i32 { abi.width(ty) }

pub fn storage_type(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    kind := type_kind(&reg, ty)
    if kind == 3 { return 1 }
    if (platform == 3 || platform == 4) && (ty == 12 || ty == 13 || kind == 8 || is_dunder_callable_kind(kind)) { return 10 }
    ty
}

pub fn scalar_bytes(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    if ty == 3 || ty == 8 { return 1 }
    if ty == 9 || ty == 16 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 || type_kind(&reg, ty) == 3 { return 4 }
    if (platform == 3 || platform == 4) && (ty == 12 || ty == 13 || type_kind(&reg, ty) == 8) { return 4 }
    8
}

fn collection_kind(kind: i32) -> bool { kind == 1 || kind == 6 || kind == 10 }
pub fn collection(reg: &TypeRegistry, ty: i32) -> bool {
    collection_kind(type_kind(&reg, ty))
}

pub fn owned(reg: &TypeRegistry, ty: i32) -> bool {
    if ty == 4 { return true }
    kind := type_kind(&reg, ty); kind == 2 || kind == 7 || is_closure_kind(kind) || collection_kind(kind)
}
fn seen_contains(seen: &[]i32, value: i32) -> bool {
    for i in 0..seen.len { if seen[i] == value { return true } }
    false
}
fn mark_seen(seen: &mut []i32, dense: &mut []bool, count: i32, value: i32) -> bool {
    if dense.len > 0 {
        if dense[value] { return false }
        dense[value] = true
        return true
    }
    if seen_contains(&seen, value) { return false }
    seen.push(value)
    if seen.len >= 64 {
        dense.reserve(count)
        for _ in 0..count { dense.push(false) }
        for i in 0..seen.len { dense[seen[i]] = true }
    }
    true
}
fn propagate_declared_flag(flags: &mut []i32, rev_starts: &[]i32, rev_parents: &[]i32, rev_kinds: &[]i32, queue: &mut []i32, bit: i32, max_edge_kind: i32) {
    mut head := 0
    while head < queue.len {
        child := queue[head]; head += 1
        for e in rev_starts[child]..rev_starts[child + 1] {
            if rev_kinds[e] > max_edge_kind { continue }
            parent := rev_parents[e]
            if flags[parent].bit_and(bit) == 0 {
                flags[parent] = flags[parent].bit_or(bit)
                queue.push(parent)
            }
        }
    }
}
pub fn compute_declared_flags(reg: &mut TypeRegistry) {
    n := reg.declared.type_kinds.len
    mut flags: []i32 = []; flags.reserve(n)
    mut rev_counts: []i32 = []; rev_counts.reserve(n)
    for _ in 0..n { flags.push(0); rev_counts.push(0) }
    mut total_edges := 0
    for parent in 0..n {
        kind := reg.declared.type_kinds[parent]
        if kind == 2 {
            first := reg.declared.type_starts[parent]
            for m in first..first + reg.declared.type_counts[parent] {
                child := reg.field_types[m]
                if child >= 0 && child < n { rev_counts[child] = rev_counts[child] + 1; total_edges += 1 }
                else { flags[parent] = flags[parent].bit_or(16) }
            }
        } else if kind == 7 {
            first := reg.declared.type_starts[parent]
            for v in first..first + reg.declared.type_counts[parent] {
                ps := reg.payload_starts[v]
                for p in ps..ps + reg.payload_counts[v] {
                    child := reg.payload_types[p]
                    if child >= 0 && child < n { rev_counts[child] = rev_counts[child] + 1; total_edges += 1 }
                    else { flags[parent] = flags[parent].bit_or(16) }
                }
            }
        } else if kind == 1 || kind == 6 || kind == 10 {
            child := reg.declared.type_bases[parent]
            if child >= 0 && child < n { rev_counts[child] = rev_counts[child] + 1; total_edges += 1 }
            else { flags[parent] = flags[parent].bit_or(16) }
        }
    }
    mut rev_starts: []i32 = []; rev_starts.reserve(n + 1)
    mut rev_fill: []i32 = []; rev_fill.reserve(n)
    mut offset := 0
    for i in 0..n {
        rev_starts.push(offset); rev_fill.push(offset)
        offset += rev_counts[i]
    }
    rev_starts.push(offset)
    mut rev_parents: []i32 = []; rev_parents.reserve(total_edges)
    mut rev_kinds: []i32 = []; rev_kinds.reserve(total_edges)
    for _ in 0..total_edges { rev_parents.push(0); rev_kinds.push(0) }
    for parent in 0..n {
        kind := reg.declared.type_kinds[parent]
        if kind == 2 {
            first := reg.declared.type_starts[parent]
            for m in first..first + reg.declared.type_counts[parent] {
                child := reg.field_types[m]
                if child >= 0 && child < n {
                    at := rev_fill[child]; rev_fill[child] = at + 1
                    rev_parents[at] = parent; rev_kinds[at] = 1
                }
            }
        } else if kind == 7 {
            first := reg.declared.type_starts[parent]
            for v in first..first + reg.declared.type_counts[parent] {
                ps := reg.payload_starts[v]
                for p in ps..ps + reg.payload_counts[v] {
                    child := reg.payload_types[p]
                    if child >= 0 && child < n {
                        at := rev_fill[child]; rev_fill[child] = at + 1
                        rev_parents[at] = parent; rev_kinds[at] = 1
                    }
                }
            }
        } else if kind == 1 || kind == 6 || kind == 10 {
            child := reg.declared.type_bases[parent]
            if child >= 0 && child < n {
                at := rev_fill[child]; rev_fill[child] = at + 1
                rev_parents[at] = parent; rev_kinds[at] = if kind == 10 { 3 } else { 2 }
            }
        }
    }
    mut queue: []i32 = []; queue.reserve(n)
    // Bit 1: move_only (propagates through struct/enum fields, edge kind 1)
    for t in 0..n {
        kind := reg.declared.type_kinds[t]
        if t == 4 || (t < reg.resource.len && reg.resource[t]) ||
            kind == 1 || kind == 6 || kind == 10 || is_closure_kind(kind) {
            flags[t] = flags[t].bit_or(1); queue.push(t)
        }
    }
    propagate_declared_flag(&mut flags, &rev_starts, &rev_parents, &rev_kinds, &mut queue, 1, 1)
    // Bit 2: has_shared_rc (propagates through struct/enum/slice/fixed, edge kind <= 2)
    queue.clear()
    for t in 0..n {
        kind := reg.declared.type_kinds[t]
        if t == 4 || kind == 11 || (kind == 7 && flags[t].bit_and(1) == 0 && !is_pod_struct(&reg, t)) {
            flags[t] = flags[t].bit_or(2); queue.push(t)
        }
    }
    propagate_declared_flag(&mut flags, &rev_starts, &rev_parents, &rev_kinds, &mut queue, 2, 2)
    // Bit 4: contains_resource (propagates through struct/enum/slice/fixed, edge kind <= 2)
    queue.clear()
    for t in 0..n {
        if t < reg.resource.len && reg.resource[t] {
            flags[t] = flags[t].bit_or(4); queue.push(t)
        }
    }
    propagate_declared_flag(&mut flags, &rev_starts, &rev_parents, &rev_kinds, &mut queue, 4, 2)
    // Bit 8: has_closure (propagates through struct/enum/collections, edge kind <= 3)
    queue.clear()
    for t in 0..n {
        if is_closure_kind(reg.declared.type_kinds[t]) {
            flags[t] = flags[t].bit_or(8); queue.push(t)
        }
    }
    propagate_declared_flag(&mut flags, &rev_starts, &rev_parents, &rev_kinds, &mut queue, 8, 3)
    // Bit 16: non_cloneable (propagates through struct/enum/collections, edge kind <= 3)
    queue.clear()
    for t in 0..n {
        kind := reg.declared.type_kinds[t]
        if flags[t].bit_and(16) != 0 || (t < reg.resource.len && reg.resource[t]) || kind == 12 || kind == 13 {
            flags[t] = flags[t].bit_or(16); queue.push(t)
        }
    }
    propagate_declared_flag(&mut flags, &rev_starts, &rev_parents, &rev_kinds, &mut queue, 16, 3)
    queue.clear()
    for t in 0..n {
        if reg.declared.type_kinds[t] == 4 {
            flags[t] = flags[t].bit_or(32); queue.push(t)
        }
    }
    propagate_declared_flag(&mut flags, &rev_starts, &rev_parents, &rev_kinds, &mut queue, 32, 1)
    reg.declared_flags = move flags
}

pub fn has_shared_rc(reg: &TypeRegistry, ty: i32) -> bool {
    n := reg.declared.type_kinds.len
    count := n + reg.body.type_kinds.len
    if ty < 0 || ty >= count { return false }
    if reg.sealed && reg.declared_flags.len == n {
        mut cur := ty
        while cur >= n {
            kind := type_kind(&reg, cur)
            if kind == 11 { return true }
            if kind == 1 || kind == 6 { cur = type_base(&reg, cur); continue }
            return false
        }
        if cur < 0 { return false }
        return reg.declared_flags[cur].bit_and(2) != 0
    }
    mut seen: []i32 = []; mut dense: []bool = []
    mut pending: []i32 = [ty]
    while pending.len > 0 {
        current := pending.pop()
        if current < 0 || current >= count || !mark_seen(&mut seen, &mut dense, count, current) { continue }
        if current == 4 { return true }
        kind := type_kind(&reg, current)
        if kind == 11 { return true }
        if kind == 7 && !move_only(&reg, current) && !is_pod_struct(&reg, current) { return true }
        if kind == 1 || kind == 6 { pending.push(type_base(&reg, current)) }
        else if kind == 2 {
            first := type_start(&reg, current)
            for m in first..first + type_count(&reg, current) { pending.push(reg.field_types[m]) }
        } else if kind == 7 {
            first := type_start(&reg, current)
            for v in first..first + type_count(&reg, current) {
                ps := reg.payload_starts[v]
                for p in ps..ps + reg.payload_counts[v] { pending.push(reg.payload_types[p]) }
            }
        }
    }
    false
}
pub fn contains_resource(reg: &TypeRegistry, ty: i32) -> bool {
    n := reg.declared.type_kinds.len
    count := n + reg.body.type_kinds.len
    if ty < 0 || ty >= count { return false }
    if reg.sealed && reg.declared_flags.len == n {
        mut cur := ty
        while cur >= n {
            kind := type_kind(&reg, cur)
            if kind == 1 || kind == 6 { cur = type_base(&reg, cur); continue }
            return false
        }
        if cur < 0 { return false }
        return reg.declared_flags[cur].bit_and(4) != 0
    }
    mut seen: []i32 = []; mut dense: []bool = []
    mut pending: []i32 = [ty]
    while pending.len > 0 {
        current := pending.pop()
        if current < 0 || current >= count || !mark_seen(&mut seen, &mut dense, count, current) { continue }
        if current < reg.resource.len && reg.resource[current] { return true }
        kind := type_kind(&reg, current)
        if kind == 1 || kind == 6 { pending.push(type_base(&reg, current)) }
        else if kind == 2 {
            first := type_start(&reg, current)
            for m in first..first + type_count(&reg, current) { pending.push(reg.field_types[m]) }
        } else if kind == 7 {
            first := type_start(&reg, current)
            for v in first..first + type_count(&reg, current) {
                ps := reg.payload_starts[v]
                for p in ps..ps + reg.payload_counts[v] { pending.push(reg.payload_types[p]) }
            }
        }
    }
    false
}

pub fn move_only(reg: &TypeRegistry, ty: i32) -> bool {
    n := reg.declared.type_kinds.len
    if reg.sealed && reg.declared_flags.len == n {
        if ty < 0 { return false }
        if ty < n { return reg.declared_flags[ty].bit_and(1) != 0 }
        if ty >= n + reg.body.type_kinds.len { return false }
        kind := type_kind(&reg, ty)
        return kind == 1 || kind == 6 || kind == 10 || is_closure_kind(kind)
    }
    move_only_at(&reg, ty, 0)
}
fn move_only_at(reg: &TypeRegistry, ty: i32, depth: i32) -> bool {
    if ty < reg.resource.len && reg.resource[ty] { return true }
    if ty == 4 { return true }
    if depth >= 128 { return true }
    kind := type_kind(&reg, ty)
    if kind == 1 || kind == 6 || kind == 10 || is_closure_kind(kind) { return true }
    if kind != 2 && kind != 7 { return false }
    first := type_start(&reg, ty)
    for member in first..first + type_count(&reg, ty) {
        if kind == 2 {
            if move_only_at(&reg, reg.field_types[member], depth + 1) { return true }
        } else {
            payload := reg.payload_starts[member]
            for item in 0..reg.payload_counts[member] {
                if move_only_at(&reg, reg.payload_types[payload + item], depth + 1) { return true }
            }
        }
    }
    false
}

pub fn has_closure(reg: &TypeRegistry, ty: i32) -> bool {
    n := reg.declared.type_kinds.len
    count := n + reg.body.type_kinds.len
    if ty < 0 || ty >= count { return false }
    if reg.sealed && reg.declared_flags.len == n {
        mut cur := ty
        while cur >= n {
            kind := type_kind(&reg, cur)
            if is_closure_kind(kind) { return true }
            if collection_kind(kind) { cur = type_base(&reg, cur); continue }
            return false
        }
        if cur < 0 { return false }
        return reg.declared_flags[cur].bit_and(8) != 0
    }
    mut seen: []i32 = []; mut dense: []bool = []
    mut pending: []i32 = [ty]
    while pending.len > 0 {
        current := pending.pop()
        if current < 0 || current >= count || !mark_seen(&mut seen, &mut dense, count, current) { continue }
        kind := type_kind(&reg, current)
        if is_closure_kind(kind) { return true }
        if collection_kind(kind) { pending.push(type_base(&reg, current)) }
        else if kind == 2 || kind == 7 {
            first := type_start(&reg, current)
            for member in first..first + type_count(&reg, current) {
                if kind == 2 { pending.push(reg.field_types[member]) }
                else {
                    payload := reg.payload_starts[member]
                    for item in 0..reg.payload_counts[member] { pending.push(reg.payload_types[payload + item]) }
                }
            }
        }
    }
    false
}

pub fn cloneable(reg: &TypeRegistry, ty: i32) -> bool {
    n := reg.declared.type_kinds.len
    count := n + reg.body.type_kinds.len
    if ty < 0 || ty >= count { return false }
    if reg.sealed && reg.declared_flags.len == n {
        mut cur := ty
        while cur >= n {
            kind := type_kind(&reg, cur)
            if kind == 12 || kind == 13 { return false }
            if collection_kind(kind) { cur = type_base(&reg, cur); continue }
            return true
        }
        if cur < 0 { return false }
        return reg.declared_flags[cur].bit_and(16) == 0
    }
    mut seen: []i32 = []; mut dense: []bool = []
    mut pending: []i32 = [ty]
    while pending.len > 0 {
        current := pending.pop()
        if current < 0 || current >= count { return false }
        if !mark_seen(&mut seen, &mut dense, count, current) { continue }
        if current < reg.resource.len && reg.resource[current] { return false }
        kind := type_kind(&reg, current)
        if kind == 12 || kind == 13 { return false }
        if collection_kind(kind) { pending.push(type_base(&reg, current)) }
        else if kind == 2 || kind == 7 {
            first := type_start(&reg, current)
            for member in first..first + type_count(&reg, current) {
                if kind == 2 { pending.push(reg.field_types[member]) }
                else {
                    payload := reg.payload_starts[member]
                    for item in 0..reg.payload_counts[member] { pending.push(reg.payload_types[payload + item]) }
                }
            }
        }
    }
    true
}

pub fn enum_type(reg: &TypeRegistry, ty: i32) -> bool {
    if ty < 0 { return false }
    kind := type_kind(&reg, ty); kind == 3 || kind == 7
}

pub fn inline_record(reg: &TypeRegistry, ty: i32) -> bool {
    is_c_record(&reg, ty) && !reg.resource[ty] && cleanup_method(&reg, ty) < 0
}

pub fn fixed_pod(reg: &TypeRegistry, ty: i32) -> bool {
    if type_kind(&reg, ty) != 6 { return false }
    base := type_base(&reg, ty); base == 3 || foreign_scalar(&reg, base) || inline_record(&reg, base)
}

pub fn c_field_error(reg: &TypeRegistry, ty: i32) -> string {
    if type_kind(&reg, ty) == 6 {
        if !fixed_pod(&reg, ty) { return "C record fields require fixed arrays of unmanaged scalars or C records" }
    } else if !foreign_scalar(&reg, ty) && ty != 3 && !is_c_record(&reg, ty) {
        return "C layouts can contain only unmanaged C fields"
    }
    ""
}

fn is_pod_scalar(reg: &TypeRegistry, ty: i32) -> bool {
    fk := type_kind(&reg, ty)
    (fk == 0 && ((ty >= 1 && ty <= 13 && ty != 4) || ty == 16)) || fk == 3 || fk == 8 || fk == 9
}

fn pod_words_at(reg: &TypeRegistry, ty: i32, depth: i32) -> i32 {
    if ty < 0 || depth > 16 { return 0 }
    kind := type_kind(&reg, ty)
    if kind != 2 && kind != 7 { return 0 }
    if is_c_record(&reg, ty) { return 0 }
    if ty < reg.resource.len && reg.resource[ty] { return 0 }
    if cleanup_method(&reg, ty) >= 0 { return 0 }
    if is_map(&reg, ty) || is_set(&reg, ty) { return 0 }
    if kind == 2 {
        if ty < reg.type_names.len {
            name := &reg.type_names[ty]
            if name == "__dunder_module_callable" { return 0 }
            if name.len >= 28 && name[0..28] == "__dunder_module_environment_" { return 0 }
        }
        count := type_count(&reg, ty)
        if count <= 0 || count > 16 { return 0 }
        first := type_start(&reg, ty)
        if reg.field_names[first] == "__dunder_module_entry" { return 0 }
        mut total := 0
        for m in first..first + count {
            fty := reg.field_types[m]
            mut w := 0
            if is_pod_scalar(&reg, fty) { w = 1 }
            else { w = pod_words_at(&reg, fty, depth + 1) }
            if w <= 0 { return 0 }
            total = total + w
            if total > 16 { return 0 }
        }
        return total
    }
    count := type_count(&reg, ty)
    if count <= 0 { return 0 }
    first := type_start(&reg, ty)
    mut max_payload := 0
    for v in first..first + count {
        ps := reg.payload_starts[v]
        pc := reg.payload_counts[v]
        mut vw := 0
        for p in ps..ps + pc {
            pt := reg.payload_types[p]
            mut w := 0
            if is_pod_scalar(&reg, pt) { w = 1 }
            else { w = pod_words_at(&reg, pt, depth + 1) }
            if w <= 0 { return 0 }
            vw = vw + w
            if 1 + vw > 16 { return 0 }
        }
        if vw > max_payload { max_payload = vw }
    }
    1 + max_payload
}

pub fn pod_words(reg: &TypeRegistry, ty: i32) -> i32 { pod_words_at(&reg, ty, 0) }

pub fn is_pod_struct(reg: &TypeRegistry, ty: i32) -> bool { pod_words(&reg, ty) > 0 }

pub fn pod_member_word_offset(reg: &TypeRegistry, ty: i32, ordinal: i32) -> i32 {
    first := type_start(&reg, ty)
    mut off := 0
    for i in 0..ordinal {
        fty := reg.field_types[first + i]
        w := pod_words(&reg, fty)
        off = off + if w > 0 { w } else { 1 }
    }
    off
}

pub fn pod_payload_word_offset(reg: &TypeRegistry, ty: i32, variant_found: i32, item_idx: i32) -> i32 {
    ps := reg.payload_starts[variant_found]
    mut off := 1
    for i in 0..item_idx {
        pt := reg.payload_types[ps + i]
        w := pod_words(&reg, pt)
        off = off + if w > 0 { w } else { 1 }
    }
    off
}

pub fn field(reg: &TypeRegistry, ty: i32, name: string) -> i32 {
    first := type_start(&reg, ty)
    for i in first..first + type_count(&reg, ty) {
        if reg.field_names[i] == name { return i }
    }
    -1
}

pub fn scalar_type(reg: &TypeRegistry, ty: i32) -> i32 {
    if ty >= 0 && ty <= 3 { return ty }
    kind := type_kind(&reg, ty)
    if kind == 4 || kind == 5 {
        array := type_base(&reg, ty)
        if type_kind(&reg, array) == 1 {
            elem := type_base(&reg, array)
            if elem == 2 {
                if kind == 5 { return 21 }
                return 20
            }
            if elem == 1 {
                if kind == 5 { return 23 }
                return 22
            }
        }
    }
    -1
}

fn hash2(a: i32, b: i32, capacity: i32) -> i32 {
    mut value := i64(a).bit_xor(i64(b).shl(32))
    value = value.bit_xor(value.shr(30)).wrapping_mul(-4658895280553007687)
    value = value.bit_xor(value.shr(27)).wrapping_mul(-7723592293110705685)
    value = value.bit_xor(value.shr(31))
    i32(value.bit_and(i64(capacity - 1)))
}

fn callable_hash(kind: i32, result: i32, args: &[]i32, parameter: i32, capacity: i32) -> i32 {
    mut value := i64(kind).wrapping_mul(1000003).bit_xor(i64(result).wrapping_mul(2654435761))
    value = value.bit_xor(i64(parameter + 1).wrapping_mul(7046029254386353131))
    value = value.bit_xor(i64(args.len).wrapping_mul(-4658895280553007687))
    for arg in args {
        value = value.wrapping_mul(131).bit_xor(i64(arg) + 1)
    }
    value = value.bit_xor(value.shr(30)).wrapping_mul(-7723592293110705685)
    value = value.bit_xor(value.shr(31))
    i32(value.bit_and(i64(capacity - 1)))
}

fn grow_compound(reg: &mut Shapes) {
    mut capacity := 64
    if reg.compound_buckets.len > 0 { capacity = reg.compound_buckets.len * 2 }
    mut fresh: []i32 = []
    fresh.reserve(capacity)
    for _ in 0..capacity { fresh.push(0) }
    for i in 0..reg.compound_buckets.len {
        entry := reg.compound_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        mut slot := hash2(reg.type_kinds[ty], reg.type_bases[ty], capacity)
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.compound_buckets = fresh
}

fn grow_fixed(reg: &mut Shapes) {
    mut capacity := 32
    if reg.fixed_buckets.len > 0 { capacity = reg.fixed_buckets.len * 2 }
    mut fresh: []i32 = []
    fresh.reserve(capacity)
    for _ in 0..capacity { fresh.push(0) }
    for i in 0..reg.fixed_buckets.len {
        entry := reg.fixed_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        mut slot := hash2(reg.type_bases[ty], reg.type_counts[ty], capacity)
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.fixed_buckets = fresh
}

fn grow_callable(reg: &mut Shapes) {
    mut capacity := 32
    if reg.callable_buckets.len > 0 { capacity = reg.callable_buckets.len * 2 }
    mut fresh: []i32 = []
    fresh.reserve(capacity)
    for _ in 0..capacity { fresh.push(0) }
    for i in 0..reg.callable_buckets.len {
        entry := reg.callable_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        mut value := i64(reg.type_kinds[ty]).wrapping_mul(1000003).bit_xor(i64(reg.type_bases[ty]).wrapping_mul(2654435761))
        value = value.bit_xor(i64(reg.callable_parameters[ty] + 1).wrapping_mul(7046029254386353131))
        count := reg.type_counts[ty]
        value = value.bit_xor(i64(count).wrapping_mul(-4658895280553007687))
        first := reg.type_starts[ty]
        for p in 0..count { value = value.wrapping_mul(131).bit_xor(i64(reg.ffi_params[first + p]) + 1) }
        value = value.bit_xor(value.shr(30)).wrapping_mul(-7723592293110705685)
        value = value.bit_xor(value.shr(31))
        mut slot := i32(value.bit_and(i64(capacity - 1)))
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.callable_buckets = fresh
}

pub fn find_or_check_compound(reg: &mut TypeRegistry, kind: i32, base: i32) -> i32 {
    if (kind == 4 || kind == 5) && (base == 0 || type_kind(&reg, base) == 4 || type_kind(&reg, base) == 5) {
        set_error(&mut reg, move "reference a value type"); return -2
    }
    if kind == 5 && base == 15 {
        set_error(&mut reg, move "cannot mutably borrow UTF-8 string view '&str'; UTF-8 views are immutable"); return -2
    }
    if kind == 22 && (type_kind(&reg, base) == 4 || type_kind(&reg, base) == 5) {
        set_error(&mut reg, move "task worker result must be isolated Data and cannot be a returned borrow"); return -2
    }
    if kind == 1 && !array_element(&reg, base) {
        set_error(&mut reg, move "array elements must be storable values (not (), borrows, ranges, iterators, scratch or task scopes)"); return -2
    }
    known := find_compound(&reg.declared, kind, base)
    if known >= 0 || !reg.sealed { return known }
    local := find_compound(&reg.body, kind, base)
    if local < 0 { return -1 }
    reg.declared.type_kinds.len + local
}
fn find_compound(reg: &Shapes, kind: i32, base: i32) -> i32 {
    if reg.compound_buckets.len > 0 {
        cap := reg.compound_buckets.len
        mut slot := hash2(kind, base, cap)
        while reg.compound_buckets[slot] != 0 {
            ty := reg.compound_buckets[slot] - 1
            if reg.type_kinds[ty] == kind && reg.type_bases[ty] == base { return ty }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_compound(reg: &mut TypeRegistry, kind: i32, base: i32) -> i32 {
    if reg.sealed {
        local := append_compound(&mut reg.body, kind, base)
        return reg.declared.type_kinds.len + local
    }
    declared_row(&mut reg, move "")
    append_compound(&mut reg.declared, kind, base)
}
fn append_compound(reg: &mut Shapes, kind: i32, base: i32) -> i32 {
    if reg.compound_buckets.len == 0 || (reg.compound_count + 1) * 2 > reg.compound_buckets.len {
        grow_compound(&mut reg)
    }
    id := append_shape(&mut reg, kind, base)
    cap := reg.compound_buckets.len
    mut slot := hash2(kind, base, cap)
    while reg.compound_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.compound_buckets[slot] = id + 1
    reg.compound_count = reg.compound_count + 1
    id
}

fn array_storage_width(reg: &TypeRegistry, base: i32, platform: i32) -> i32 {
    if !inline_record(&reg, base) { return scalar_bytes(&reg, base, platform) }
    width := c_size(&reg, base)
    if width > 0 { return width }
    1
}

pub fn find_or_check_fixed(reg: &mut TypeRegistry, platform: i32, base: i32, length: i32) -> i32 {
    if !array_element(&reg, base) {
        set_error(&mut reg, move "array elements must be storable values (not (), borrows, ranges, iterators, scratch or task scopes)"); return -2
    }
    if length < 0 {
        set_error(&mut reg, move "fixed array length must be nonnegative"); return -2
    }
    if length > places.max_parameter() / array_storage_width(&reg, base, platform) {
        set_error(&mut reg, move "fixed array exceeds 1048575 bytes"); return -2
    }
    known := find_fixed(&reg.declared, base, length)
    if known >= 0 || !reg.sealed { return known }
    local := find_fixed(&reg.body, base, length)
    if local < 0 { return -1 }
    reg.declared.type_kinds.len + local
}
fn find_fixed(reg: &Shapes, base: i32, length: i32) -> i32 {
    if reg.fixed_buckets.len > 0 {
        cap := reg.fixed_buckets.len
        mut slot := hash2(base, length, cap)
        while reg.fixed_buckets[slot] != 0 {
            ty := reg.fixed_buckets[slot] - 1
            if reg.type_kinds[ty] == 6 && reg.type_bases[ty] == base && reg.type_counts[ty] == length { return ty }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_fixed(reg: &mut TypeRegistry, base: i32, length: i32) -> i32 {
    if reg.sealed {
        local := append_fixed(&mut reg.body, base, length)
        return reg.declared.type_kinds.len + local
    }
    declared_row(&mut reg, move "")
    append_fixed(&mut reg.declared, base, length)
}
fn append_fixed(reg: &mut Shapes, base: i32, length: i32) -> i32 {
    if reg.fixed_buckets.len == 0 || (reg.fixed_count + 1) * 2 > reg.fixed_buckets.len {
        grow_fixed(&mut reg)
    }
    ty := append_shape(&mut reg, 6, base)
    reg.type_counts[ty] = length
    cap := reg.fixed_buckets.len
    mut slot := hash2(base, length, cap)
    while reg.fixed_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.fixed_buckets[slot] = ty + 1
    reg.fixed_count = reg.fixed_count + 1
    ty
}

pub fn find_or_check_callable(reg: &mut TypeRegistry, args: &[]i32, result: i32, kind: i32) -> i32 {
    find_or_check_callable_abi(&mut reg, &args, result, kind, -1)
}
pub fn find_or_check_callable_abi(reg: &mut TypeRegistry, args: &[]i32, result: i32, kind: i32, parameter: i32) -> i32 {
    if is_dunder_callable_kind(kind) {
        if type_kind(&reg, result) == 5 {
            if parameter < 0 || parameter >= args.len || type_kind(&reg, args[parameter]) != 5 {
                set_error(&mut reg, move "a returned mutable borrow requires a mutable input parameter"); return -2
            }
        } else if type_kind(&reg, result) == 4 || stores_borrow(&reg, result) {
            if (parameter != -1 || !stores_borrow(&reg, result)) && (parameter < 0 || parameter >= args.len ||
                (type_kind(&reg, args[parameter]) != 4 && type_kind(&reg, args[parameter]) != 5 && !stores_borrow(&reg, args[parameter]))) {
                set_error(&mut reg, move "a returned borrow requires a borrowed input parameter"); return -2
            }
        } else if parameter != -1 {
            set_error(&mut reg, move "only a returned borrow can specify a source parameter"); return -2
        }
    } else if parameter < -1 || parameter > args.len || (parameter >= 0 && kind != 8) {
        set_error(&mut reg, move "invalid C variadic fixed parameter count"); return -2
    }
    if kind == 8 && lends(&reg, result) {
        set_error(&mut reg, move "C calls cannot return a Dunder borrow"); return -2
    }
    for i in 0..args.len {
        ty := args[i]
        if kind == 8 && parameter >= 0 && i >= parameter && (ty == 6 || ty == 8 || ty == 9 || ty == 16 || !foreign_scalar(&reg, ty)) {
            set_error(&mut reg, move "C variadic parameters require promoted scalar types (i32, u32, i64, u64, usize, ptr, f64 or extern fn)"); return -2
        }
        if kind == 8 && !foreign_scalar(&reg, ty) && !is_c_record(&reg, ty) {
            set_error(&mut reg, move "C calls require scalar parameters or a record pointer"); return -2
        }
    }
    if kind == 8 && result != 0 && !foreign_scalar(&reg, result) && !is_c_record(&reg, result) {
        set_error(&mut reg, move "C calls require scalar return types"); return -2
    }
    known := find_callable(&reg.declared, &args, result, kind, parameter)
    if known >= 0 || !reg.sealed { return known }
    local := find_callable(&reg.body, &args, result, kind, parameter)
    if local < 0 { return -1 }
    reg.declared.type_kinds.len + local
}
fn find_callable(reg: &Shapes, args: &[]i32, result: i32, kind: i32, parameter: i32) -> i32 {
    if reg.callable_buckets.len > 0 {
        cap := reg.callable_buckets.len
        mut slot := callable_hash(kind, result, &args, parameter, cap)
        while reg.callable_buckets[slot] != 0 {
            t := reg.callable_buckets[slot] - 1
            if reg.type_kinds[t] == kind && reg.type_bases[t] == result && reg.type_counts[t] == args.len && reg.callable_parameters[t] == parameter {
                mut equal := true
                first := reg.type_starts[t]
                for i in 0..args.len {
                    if reg.ffi_params[first + i] != args[i] { equal = false; break }
                }
                if equal { return t }
            }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_callable(reg: &mut TypeRegistry, args: &[]i32, result: i32, kind: i32) -> i32 {
    insert_callable_abi(&mut reg, &args, result, kind, -1)
}
pub fn insert_callable_abi(reg: &mut TypeRegistry, args: &[]i32, result: i32, kind: i32, parameter: i32) -> i32 {
    if reg.sealed {
        local := append_callable(&mut reg.body, &args, result, kind, parameter)
        return reg.declared.type_kinds.len + local
    }
    declared_row(&mut reg, move "")
    append_callable(&mut reg.declared, &args, result, kind, parameter)
}
fn append_callable(reg: &mut Shapes, args: &[]i32, result: i32, kind: i32, parameter: i32) -> i32 {
    if reg.callable_buckets.len == 0 || (reg.callable_count + 1) * 2 > reg.callable_buckets.len {
        grow_callable(&mut reg)
    }
    t := append_shape(&mut reg, kind, result)
    reg.type_starts[t] = reg.ffi_params.len; reg.type_counts[t] = args.len
    reg.callable_parameters[t] = parameter
    for arg in args { reg.ffi_params.push(arg) }
    cap := reg.callable_buckets.len
    mut slot := callable_hash(kind, result, &args, parameter, cap)
    while reg.callable_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.callable_buckets[slot] = t + 1
    reg.callable_count = reg.callable_count + 1
    t
}

fn callable_keyword(kind: i32) -> string {
    if kind == 8 { return "extern fn" }
    if kind == 11 { return "Fn" }
    if kind == 12 { return "FnMut" }
    if kind == 13 { return "FnOnce" }
    "fn"
}

pub fn type_spelling(reg: &TypeRegistry, ty: i32) -> string {
    if is_result(&reg, ty) {
        return "Result<" + type_spelling(&reg, reg.result_success[ty]) + ", " + type_spelling(&reg, reg.result_failure[ty]) + ">"
    }
    if is_option(&reg, ty) {
        return "Option<" + type_spelling(&reg, reg.option_inner[ty]) + ">"
    }
    kind := type_kind(&reg, ty)
    if declared_name(&reg, ty) != "" { return declared_name(&reg, ty) }
    if kind == 8 || is_dunder_callable_kind(kind) {
        mut args := ""
        for i in 0..type_count(&reg, ty) {
            if i > 0 { args = args + ", " }
            args = args + type_spelling(&reg, parameter_type(&reg, type_start(&reg, ty) + i))
        }
        mut fn_name := callable_keyword(kind)
        if c_variadic_fixed(&reg, ty) >= 0 { fn_name = "@c_variadic(" + c_variadic_fixed(&reg, ty).str() + ") " + fn_name }
        mut signature := fn_name + "(" + args + ") -> " + type_spelling(&reg, type_base(&reg, ty))
        source := return_borrow_parameter(&reg, ty)
        if source >= 0 { signature = signature + " from " + (source + 1).str() }
        return signature
    }
    if kind == 20 { return "region" }
    if kind == 22 { return "TaskID<" + type_spelling(&reg, type_base(&reg, ty)) + ">" }
    if kind == 23 { return "task scope" }
    base := type_spelling(&reg, type_base(&reg, ty))
    if kind == 1 || kind == 21 { return "[]" + base }
    if kind == 6 { return "[" + base + "; " + type_count(&reg, ty).str() + "]" }
    if kind == 4 { return "&" + base }
    if kind == 5 { return "&mut " + base }
    if kind == 10 { return "iter<" + base + ">" }
    base
}

pub fn canonical_spelling(reg: &TypeRegistry, ty: i32) -> string {
    if is_tuple(&reg, ty) {
        mut s := "("
        count := type_count(&reg, ty)
        if count > 0 {
            first := type_start(&reg, ty)
            for i in 0..count {
                if i > 0 { s = s + ", " }
                s = s + canonical_spelling(&reg, reg.field_types[first + i])
            }
            return s + ")"
        }
        for e in 0..reg.tuples.values.len {
            if reg.tuples.values[e] == ty {
                first := reg.tuples.starts[e]
                last := reg.tuples.starts[e + 1]
                for i in first..last {
                    if i > first { s = s + ", " }
                    s = s + canonical_spelling(&reg, reg.tuples.arguments[i])
                }
                return s + ")"
            }
        }
        return "()"
    }
    name := declared_name(&reg, ty)
    if name != "" { return name }
    kind := type_kind(&reg, ty)
    if kind == 8 || is_dunder_callable_kind(kind) {
        mut args := ""
        for i in 0..type_count(&reg, ty) {
            if i > 0 { args = args + ", " }
            args = args + canonical_spelling(&reg, parameter_type(&reg, type_start(&reg, ty) + i))
        }
        mut fn_name := callable_keyword(kind)
        if c_variadic_fixed(&reg, ty) >= 0 { fn_name = "@c_variadic(" + c_variadic_fixed(&reg, ty).str() + ") " + fn_name }
        mut signature := fn_name + "(" + args + ") -> " + canonical_spelling(&reg, type_base(&reg, ty))
        source := return_borrow_parameter(&reg, ty)
        if source >= 0 { signature = signature + " from " + (source + 1).str() }
        return signature
    }
    if kind == 20 { return "region" }
    if kind == 22 { return "TaskID<" + canonical_spelling(&reg, type_base(&reg, ty)) + ">" }
    if kind == 23 { return "task scope" }
    base := canonical_spelling(&reg, type_base(&reg, ty))
    if kind == 1 || kind == 21 { return "[]" + base }
    if kind == 6 { return "[" + base + "; " + type_count(&reg, ty).str() + "]" }
    if kind == 4 { return "&" + base }
    if kind == 5 { return "&mut " + base }
    if kind == 10 { return "iter<" + base + ">" }
    base
}

pub fn hfa(reg: &TypeRegistry, ty: i32, depth: i32) -> i32 {
    if depth > 64 { return 0 }
    if ty == 6 { return 1 }
    if ty == 7 { return -1 }
    if type_kind(&reg, ty) == 6 {
        count := type_count(&reg, ty); if count > 4 { return 0 }
        return count * hfa(&reg, type_base(&reg, ty), depth + 1)
    }
    if !is_c_record(&reg, ty) { return 0 }
    mut shape := 0
    for index in type_start(&reg, ty)..type_start(&reg, ty) + type_count(&reg, ty) {
        part := hfa(&reg, reg.field_types[index], depth + 1)
        if part == 0 || (shape > 0 && part < 0) || (shape < 0 && part > 0) { return 0 }
        shape = shape + part
        if shape < -4 || shape > 4 { return 0 }
    }
    shape
}

pub fn seal(reg: &mut TypeRegistry, platform: i32) {
    for ty in 0..reg.declared.type_kinds.len {
        mut eligible := foreign_scalar(&reg, ty) || ty == 3 || reg.c_record[ty]
        if reg.declared.type_kinds[ty] == 6 {
            child := reg.declared.type_bases[ty]
            eligible = foreign_scalar(&reg, child) || child == 3 || reg.c_record[child]
        }
        if eligible { c_layout(&mut reg, platform, ty) }
    }
    compute_declared_flags(&mut reg)
    reg.sealed = true
}
pub fn c_layout(reg: &mut TypeRegistry, platform: i32, ty: i32) {
    prefix := reg.declared.type_kinds.len
    if reg.error != "" || c_align(&reg, ty) > 0 { return }
    if c_align(&reg, ty) < 0 { set_error(&mut reg, move "recursive C layout"); return }
    if ty < prefix {
        if reg.sealed { set_error(&mut reg, move "C layouts can contain only unmanaged C fields"); return }
        reg.declared.c_aligns[ty] = -1
    } else { reg.body.c_aligns[ty - prefix] = -1 }
    mut size := 0; mut alignment := 1
    if is_c_record(&reg, ty) {
        first := reg.declared.type_starts[ty]
        for field_index in first..first + type_count(&reg, ty) {
            ft := reg.field_types[field_index]
            message := c_field_error(&reg, ft)
            if message != "" { set_error(&mut reg, move message); return }
            c_layout(&mut reg, platform, ft)
            if reg.error != "" { return }
            child := reg.declared.c_aligns[ft]
            size = (size + child - 1) / child * child
            if reg.declared.c_sizes[ft] > places.max_parameter() - size {
                set_error(&mut reg, move "C record exceeds 1048575 bytes"); return
            }
            reg.field_values[field_index] = i64(size)
            if child > alignment { alignment = child }
            size = size + reg.declared.c_sizes[ft]
        }
        if size == 0 { set_error(&mut reg, move "empty C record"); return }
        size = (size + alignment - 1) / alignment * alignment
        if size > places.max_parameter() { set_error(&mut reg, move "C record exceeds 1048575 bytes"); return }
    } else if type_kind(&reg, ty) == 6 {
        child := type_base(&reg, ty); c_layout(&mut reg, platform, child)
        if reg.error != "" { return }
        if c_size(&reg, child) > 0 && type_count(&reg, ty) > 2147483647 / c_size(&reg, child) {
            set_error(&mut reg, move "C array layout exceeds supported size"); return
        }
        alignment = c_align(&reg, child); size = type_count(&reg, ty) * c_size(&reg, child)
    } else if foreign_scalar(&reg, ty) || ty == 3 {
        alignment = foreign_width(ty); size = alignment
        if (platform == 3 || platform == 4) && (ty == 12 || ty == 13 || type_kind(&reg, ty) == 8) { size = 4; alignment = 4 }
    } else {
        set_error(&mut reg, move "C layouts can contain only unmanaged C fields"); return
    }
    if ty < prefix {
        reg.declared.c_aligns[ty] = alignment; reg.declared.c_sizes[ty] = size
    } else {
        reg.body.c_aligns[ty - prefix] = alignment; reg.body.c_sizes[ty - prefix] = size
    }
}

pub fn layout_bytes(reg: &mut TypeRegistry, platform: i32, ty: i32, depth: i32, sizes: &mut []i32) -> i32 {
    if reg.error != "" { return 1 }
    if sizes[ty] < 0 || depth >= 128 {
        set_error(&mut reg, move "recursive or excessively nested inline value type"); return 1
    }
    if sizes[ty] > 0 { return sizes[ty] }
    kind := reg.declared.type_kinds[ty]
    if kind == 1 { return 24 }
    if kind == 6 {
        count := reg.declared.type_counts[ty]; base := reg.declared.type_bases[ty]
        width := array_storage_width(&reg, base, platform)
        if count < 0 || count > places.max_parameter() / width {
            set_error(&mut reg, move "fixed array exceeds 1048575 bytes"); return 1
        }
        sizes[ty] = -1
        if count > 0 {
            _ := layout_bytes(&mut reg, platform, base, depth + 1, &mut sizes)
            if reg.error != "" { return 1 }
        }
        mut bytes := count * width
        if bytes == 0 { bytes = 1 }
        sizes[ty] = bytes; return bytes
    }
    if kind != 2 && kind != 7 {
        if ty == 0 || ty == 14 || ty == 15 || kind == 10 { set_error(&mut reg, move "invalid stored field type"); return 1 }
        return scalar_bytes(&reg, ty, platform)
    }
    if reg.c_record[ty] { return reg.declared.c_sizes[ty] }
    sizes[ty] = -1
    mut size := 0
    mut max_align := 1
    for member in reg.declared.type_starts[ty]..reg.declared.type_starts[ty] + reg.declared.type_counts[ty] {
        mut offset := size
        mut items := 1
        if kind == 7 { offset = 8; items = reg.payload_counts[member]; max_align = 8 }
        for item in 0..items {
            mut ft := reg.field_types[member]
            if kind == 7 { ft = reg.payload_types[reg.payload_starts[member] + item] }
            width := layout_bytes(&mut reg, platform, ft, depth + 1, &mut sizes)
            if reg.error != "" { return 1 }
            mut alignment := scalar_bytes(&reg, ft, platform)
            field_kind := reg.declared.type_kinds[ft]
            if field_kind == 1 || field_kind == 2 || field_kind == 6 || field_kind == 7 { alignment = 8 }
            offset = (offset + alignment - 1) / alignment * alignment + width
            if offset > 65536 { set_error(&mut reg, move "inline value exceeds 65536 bytes"); return 1 }
            if alignment > max_align { max_align = alignment }
        }
        if size < offset { size = offset }
    }
    if size == 0 { size = 1 }
    size = (size + max_align - 1) / max_align * max_align
    sizes[ty] = size
    size
}

pub fn validate_layouts(reg: &mut TypeRegistry, platform: i32) {
    mut sizes: []i32 = []
    sizes.reserve(reg.declared.type_kinds.len)
    for _ in reg.declared.type_kinds { sizes.push(0) }
    for ty in 0..sizes.len {
        if reg.error != "" { return }
        kind := reg.declared.type_kinds[ty]
        if (kind == 1 || kind == 6) && !array_element(&reg, reg.declared.type_bases[ty]) {
            set_error(&mut reg, move "array elements must be storable values (not (), borrows, ranges, iterators, scratch or task scopes)"); return
        }
        if kind == 2 || kind == 7 || kind == 6 {
            _ := layout_bytes(&mut reg, platform, ty, 0, &mut sizes)
        }
    }
}

pub fn scratch_c_value(reg: &TypeRegistry, ty: i32) -> bool {
    if is_c_record(&reg, ty) {
        for f in type_start(&reg, ty)..type_start(&reg, ty) + type_count(&reg, ty) {
            if !scratch_c_value(&reg, reg.field_types[f]) { return false }
        }
        return true
    }
    if type_kind(&reg, ty) == 6 { return scratch_c_value(&reg, type_base(&reg, ty)) }
    (ty >= 1 && ty <= 12 && ty != 4) || ty == 16
}

pub fn scratch_width(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    if ty < reg.resource.len && reg.resource[ty] { return 0 }
    if type_kind(&reg, ty) == 2 {
        if is_c_record(&reg, ty) {
            if scratch_c_value(&reg, ty) { return c_size(&reg, ty) }
            return 0
        }
        for f in type_start(&reg, ty)..type_start(&reg, ty) + type_count(&reg, ty) {
            ft := reg.field_types[f]
            if ft < 1 || (ft > 12 && ft != 16) || ft == 4 { return 0 }
        }
        if type_count(&reg, ty) == 0 { return 1 }
        return type_count(&reg, ty) * 8
    }
    if ty < 1 || (ty > 12 && ty != 16) || ty == 4 { return 0 }
    foreign_width(storage_type(&reg, ty, platform))
}

fn array_test_registry() -> TypeRegistry {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr", "range", "str", "i16"] {
        _ := add_type(&mut reg, name, 0, 0)
    }
    reg
}
fn array_test_fields(reg: &mut TypeRegistry, ty: i32, fields: &[]i32) {
    reg.declared.type_starts[ty] = reg.field_types.len; reg.declared.type_counts[ty] = fields.len
    for i in 0..fields.len {
        reg.field_names.push("field_" + i.str()); reg.field_types.push(fields[i]); reg.field_values.push(0)
        reg.payload_starts.push(reg.payload_types.len); reg.payload_counts.push(0)
    }
}

@test fn aggregate_array_elements_are_storable_without_extending_task_data_or_c_pod() {
    mut reg := array_test_registry()
    record := add_type(&mut reg, "Record", 2, 0)
    array_test_fields(&mut reg, record, &[1])
    tag := add_type(&mut reg, "Tag", 3, 0)
    payload := add_type(&mut reg, "Payload", 7, 0)
    dynamic := insert_compound(&mut reg, 1, record)
    fixed := insert_fixed(&mut reg, record, 3)
    nested := insert_fixed(&mut reg, dynamic, 2)
    args: []i32 = [1]
    native_fn := insert_callable(&mut reg, &args, record, 9)
    foreign_fn := insert_callable(&mut reg, &args, 1, 8)
    task := insert_compound(&mut reg, 22, record)
    for ty in [1, 3, 4, 13, record, tag, payload, dynamic, fixed, nested, native_fn, foreign_fn, task] {
        assert(array_element(&reg, ty))
        assert(find_or_check_compound(&mut reg, 1, ty) != -2 && reg.error == "")
        assert(find_or_check_fixed(&mut reg, 0, ty, 2) != -2 && reg.error == "")
    }
    assert(!scalar_element(&reg, record) && !scalar_element(&reg, payload) && !scalar_element(&reg, dynamic))
    assert(!scalar_element(&reg, native_fn) && !scalar_element(&reg, foreign_fn) && scalar_element(&reg, task))
    assert(!fixed_pod(&reg, fixed) && !fixed_pod(&reg, nested))
    fixed_native_fn := insert_fixed(&mut reg, native_fn, 2)
    assert(!fixed_pod(&reg, fixed_native_fn))
    fixed_c_fn := insert_fixed(&mut reg, foreign_fn, 2)
    fixed_scalar := insert_fixed(&mut reg, 2, 2)
    assert(fixed_pod(&reg, fixed_c_fn) && fixed_pod(&reg, fixed_scalar))
}

@test fn array_elements_reject_nonstorable_lifetimes_in_declarations_and_body_arenas() {
    mut reg := array_test_registry()
    shared := insert_compound(&mut reg, 4, 1); exclusive := insert_compound(&mut reg, 5, 1)
    iterator := insert_compound(&mut reg, 10, 1)
    region := insert_compound(&mut reg, 20, 1); scratch := insert_compound(&mut reg, 21, 1)
    scope := insert_compound(&mut reg, 23, 1)
    str_view := insert_compound(&mut reg, 4, 15)
    assert(str_view != -2 && reg.error == "")
    assert(find_or_check_compound(&mut reg, 5, 15) == -2)
    assert(reg.error == "cannot mutably borrow UTF-8 string view '&str'; UTF-8 views are immutable")
    reg.error = ""
    for ty in [0, 14, 15, str_view, shared, exclusive, iterator, region, scratch, scope] {
        assert(!array_element(&reg, ty))
        assert(find_or_check_compound(&mut reg, 1, ty) == -2)
        assert(reg.error == "array elements must be storable values (not (), borrows, ranges, iterators, scratch or task scopes)")
        reg.error = ""
        assert(find_or_check_fixed(&mut reg, 0, ty, 0) == -2)
        reg.error = ""
    }
    seal(&mut reg, 0); assert(reg.error == "")
    local_reference := insert_compound(&mut reg, 4, 4)
    assert(!array_element(&reg, local_reference))
    assert(find_or_check_compound(&mut reg, 1, local_reference) == -2)
    reg.error = ""
    assert(find_or_check_fixed(&mut reg, 0, 2, -1) == -2 && reg.error == "fixed array length must be nonnegative")
    reg.error = ""
    assert(find_or_check_fixed(&mut reg, 0, 2, 131072) == -2 && reg.error == "fixed array exceeds 1048575 bytes")
    mut restored := array_test_registry()
    borrow := insert_compound(&mut restored, 4, 1)
    invalid := insert_compound(&mut restored, 1, borrow)
    _ := insert_compound(&mut restored, 1, invalid)
    validate_layouts(&mut restored, 0)
    assert(restored.error == "array elements must be storable values (not (), borrows, ranges, iterators, scratch or task scopes)")
}

@test fn recursive_collection_cloneability_visits_all_reachable_resources_once() {
    mut reg := array_test_registry()
    node := add_type(&mut reg, "Node", 2, 0)
    children := insert_compound(&mut reg, 1, node)
    array_test_fields(&mut reg, node, &[children])
    unused := add_type(&mut reg, "UnusedResource", 2, 0); reg.resource[unused] = true
    array_test_fields(&mut reg, unused, &[1])
    assert(cloneable(&reg, node) && cloneable(&reg, children) && move_only(&reg, node))
    validate_layouts(&mut reg, 0); assert(reg.error == "")
    resource_first := reg.field_types.len
    array_test_fields(&mut reg, node, &[unused, children])
    assert(reg.declared.type_starts[node] == resource_first)
    assert(!cloneable(&reg, node) && !cloneable(&reg, children))
    reference := insert_compound(&mut reg, 4, node)
    args: []i32 = [reference]
    function := insert_callable(&mut reg, &args, node, 9)
    assert(cloneable(&reg, reference) && cloneable(&reg, function))
    result := add_type(&mut reg, "Result", 7, 0)
    reg.declared.type_starts[result] = reg.field_types.len; reg.declared.type_counts[result] = 1
    reg.field_names.push("Value"); reg.field_types.push(0); reg.field_values.push(0)
    reg.payload_starts.push(reg.payload_types.len); reg.payload_counts.push(1); reg.payload_types.push(node)
    assert(!cloneable(&reg, result))
    mut deep := 1
    for _ in 0..256 { deep = insert_compound(&mut reg, 1, deep) }
    assert(cloneable(&reg, deep))
    mut deep_resource := unused
    for _ in 0..256 { deep_resource = insert_compound(&mut reg, 1, deep_resource) }
    assert(!cloneable(&reg, deep_resource))
}

@test fn positive_fixed_array_lengths_cannot_hide_inline_value_cycles() {
    mut recursive := array_test_registry()
    node := add_type(&mut recursive, "Node", 2, 0)
    children := insert_fixed(&mut recursive, node, 1)
    array_test_fields(&mut recursive, node, &[children])
    validate_layouts(&mut recursive, 0)
    assert(recursive.error == "recursive or excessively nested inline value type")

    mut empty := array_test_registry()
    terminal := add_type(&mut empty, "Terminal", 2, 0)
    zero_children := insert_fixed(&mut empty, terminal, 0)
    array_test_fields(&mut empty, terminal, &[zero_children])
    validate_layouts(&mut empty, 0)
    assert(empty.error == "" && cloneable(&empty, terminal))

    mut boxed := array_test_registry()
    record := add_type(&mut boxed, "Record", 2, 0)
    array_test_fields(&mut boxed, record, &[2, 2])
    records := insert_fixed(&mut boxed, record, 8192)
    validate_layouts(&mut boxed, 0); assert(boxed.error == "")
    mut sizes: []i32 = []; for _ in boxed.declared.type_kinds { sizes.push(0) }
    assert(layout_bytes(&mut boxed, 0, records, 0, &mut sizes) == 65536)
}

@test fn c_record_arrays_use_element_layout_in_values_and_fields() {
    mut reg := array_test_registry()
    record := add_type(&mut reg, "CRecord", 2, 0); reg.c_record[record] = true
    array_test_fields(&mut reg, record, &[2])
    records := insert_fixed(&mut reg, record, 3)
    assert(array_element(&reg, record) && fixed_pod(&reg, records))
    seal(&mut reg, 0)
    assert(reg.error == "" && c_size(&reg, records) == 24 && c_align(&reg, records) == 8)
    validate_layouts(&mut reg, 0); assert(reg.error == "")

    mut inline_reg := array_test_registry()
    child := add_type(&mut inline_reg, "Child", 2, 0); inline_reg.c_record[child] = true
    array_test_fields(&mut inline_reg, child, &[2])
    elements := insert_fixed(&mut inline_reg, child, 2)
    parent := add_type(&mut inline_reg, "Parent", 2, 0); inline_reg.c_record[parent] = true
    array_test_fields(&mut inline_reg, parent, &[elements])
    seal(&mut inline_reg, 0)
    assert(inline_reg.error == "" && c_size(&inline_reg, parent) == 16 && c_align(&inline_reg, parent) == 8)

    mut scalar_reg := array_test_registry()
    floats := insert_fixed(&mut scalar_reg, 6, 4)
    vector := add_type(&mut scalar_reg, "Vector", 2, 0); scalar_reg.c_record[vector] = true
    array_test_fields(&mut scalar_reg, vector, &[floats])
    seal(&mut scalar_reg, 0)
    assert(scalar_reg.error == "" && c_size(&scalar_reg, vector) == 16 && hfa(&scalar_reg, vector, 0) == 4)
}

@test fn function_type_references_expire_without_extending_declarations() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string"] { _ := add_type(&mut reg, name, 0, 0) }
    array := insert_compound(&mut reg, 1, 2)
    seal(&mut reg, 0)
    declared := reg.declared.type_kinds.len
    assert(find_or_check_compound(&mut reg, 1, 2) == array)
    fixed := insert_fixed(&mut reg, 2, 7); reference := insert_compound(&mut reg, 4, fixed)
    assert(move_only(&reg, fixed) && !move_only(&reg, reference))
    params: []i32 = [array, reference]
    sig := insert_callable(&mut reg, &params, fixed, 9)
    assert(type_spelling(&reg, sig) == "fn([]i64, &[i64; 7]) -> [i64; 7]")
    c_layout(&mut reg, 0, fixed)
    assert(reg.error == "" && c_size(&reg, fixed) == 56 && c_align(&reg, fixed) == 8)
    assert(find_or_check_callable(&mut reg, &params, fixed, 9) == sig)
    reset_body(&mut reg)
    assert(reg.declared.type_kinds.len == declared && reg.body.type_kinds.len == 0)
    assert(find_or_check_fixed(&mut reg, 0, 2, 7) == -1)
    other := insert_compound(&mut reg, 5, array)
    assert(other == fixed && type_spelling(&reg, other) == "&mut []i64")
}

@test fn callable_identity_keeps_variadic_boundaries_through_growth_and_body_reset() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr"] {
        _ := add_type(&mut reg, name, 0, 0)
    }
    args: []i32 = [1, 2]
    plain := insert_callable(&mut reg, &args, 1, 8)
    first := insert_callable_abi(&mut reg, &args, 1, 8, 1)
    second := insert_callable_abi(&mut reg, &args, 1, 8, 2)
    assert(plain != first && first != second && c_variadic_fixed(&reg, plain) == -1)
    for count in 0..40 {
        mut params: []i32 = []
        for _ in 0..count { params.push(1) }
        _ := insert_callable_abi(&mut reg, &params, 1, 8, count)
    }
    assert(find_or_check_callable(&mut reg, &args, 1, 8) == plain)
    assert(find_or_check_callable_abi(&mut reg, &args, 1, 8, 1) == first)
    assert(find_or_check_callable_abi(&mut reg, &args, 1, 8, 2) == second)
    assert(type_spelling(&reg, first) == "@c_variadic(1) extern fn(i32, i64) -> i32")
    seal(&mut reg, 0)
    local := insert_callable_abi(&mut reg, &args, 2, 8, 0)
    assert(c_variadic_fixed(&reg, local) == 0)
    reset_body(&mut reg)
    assert(reg.body.callable_parameters.len == 0 && c_variadic_fixed(&reg, second) == 2)
}

@test fn returned_borrow_source_is_part_of_a_dunder_function_type() {
    mut reg := array_test_registry()
    reference := insert_compound(&mut reg, 4, 1)
    args: []i32 = [reference, reference]
    first := insert_callable_abi(&mut reg, &args, reference, 9, 0)
    second := insert_callable_abi(&mut reg, &args, reference, 9, 1)
    for count in 0..32 {
        mut parameters: []i32 = []
        for _ in 0..count { parameters.push(1) }
        _ := insert_callable(&mut reg, &parameters, 1, 9)
    }
    seal(&mut reg, 0)
    assert(first != second && return_borrow_parameter(&reg, first) == 0 && return_borrow_parameter(&reg, second) == 1)
    assert(find_or_check_callable_abi(&mut reg, &args, reference, 9, 1) == second)
    assert(type_spelling(&reg, second) == "fn(&i32, &i32) -> &i32 from 2")
    assert(c_variadic_fixed(&reg, first) == -1)
    local := insert_callable_abi(&mut reg, &[reference], reference, 9, 0)
    assert(return_borrow_parameter(&reg, local) == 0)
    reset_body(&mut reg)
    assert(find_or_check_callable_abi(&mut reg, &[reference], reference, 9, 0) == -1)
    assert(find_or_check_callable_abi(&mut reg, &[1], reference, 9, 0) == -2)
}

@test fn array_ownership_is_recursive_and_independent_of_runtime_cleanup() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr"] {
        _ := add_type(&mut reg, name, 0, 0)
    }
    array := insert_compound(&mut reg, 1, 1)
    fixed := insert_fixed(&mut reg, 1, 4)
    iterator := insert_compound(&mut reg, 10, 1)
    shared := insert_compound(&mut reg, 4, array)
    exclusive := insert_compound(&mut reg, 5, array)
    region_view := insert_compound(&mut reg, 21, 1)
    assert(move_only(&reg, array) && move_only(&reg, fixed) && move_only(&reg, iterator))
    assert(!move_only(&reg, shared) && !move_only(&reg, exclusive) && !move_only(&reg, region_view))
    assert(owned(&reg, 4) && move_only(&reg, 4) && !move_only(&reg, 1))

    pod := add_type(&mut reg, "Pod", 2, 0)
    reg.declared.type_starts[pod] = reg.field_types.len
    reg.declared.type_counts[pod] = 2
    reg.field_types.push(1); reg.field_types.push(2)
    assert(owned(&reg, pod) && !move_only(&reg, pod))
    text_box := add_type(&mut reg, "TextBox", 2, 0)
    reg.declared.type_starts[text_box] = reg.field_types.len
    reg.declared.type_counts[text_box] = 1; reg.field_types.push(4)
    assert(move_only(&reg, text_box))
    packet := add_type(&mut reg, "Packet", 2, 0)
    reg.declared.type_starts[packet] = reg.field_types.len
    reg.declared.type_counts[packet] = 2
    reg.field_types.push(pod); reg.field_types.push(array)
    outer := add_type(&mut reg, "Outer", 2, 0)
    reg.declared.type_starts[outer] = reg.field_types.len
    reg.declared.type_counts[outer] = 1; reg.field_types.push(packet)
    assert(move_only(&reg, packet) && move_only(&reg, outer))

    c_record := add_type(&mut reg, "CRecord", 2, 0)
    reg.c_record[c_record] = true
    reg.declared.type_starts[c_record] = reg.field_types.len
    reg.declared.type_counts[c_record] = 1; reg.field_types.push(fixed)
    assert(move_only(&reg, c_record))
}
@test fn enum_payload_ownership_checks_every_variant_and_nested_record() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string"] { _ := add_type(&mut reg, name, 0, 0) }
    array := insert_compound(&mut reg, 1, 1)
    packet := add_type(&mut reg, "Packet", 2, 0)
    reg.declared.type_starts[packet] = 0; reg.declared.type_counts[packet] = 1
    reg.field_types.push(array)
    reg.payload_starts.push(0); reg.payload_counts.push(0)
    plain := add_type(&mut reg, "Plain", 7, 0)
    reg.declared.type_starts[plain] = reg.field_types.len; reg.declared.type_counts[plain] = 2
    reg.field_types.push(0); reg.payload_starts.push(0); reg.payload_counts.push(0)
    reg.field_types.push(0); reg.payload_starts.push(0); reg.payload_counts.push(2)
    reg.payload_types.push(1); reg.payload_types.push(2)
    assert(owned(&reg, plain) && !move_only(&reg, plain))
    reg.payload_types[1] = 4
    assert(move_only(&reg, plain))
    reg.payload_types[1] = 2
    assert(!move_only(&reg, plain))
    data := add_type(&mut reg, "Data", 7, 0)
    reg.declared.type_starts[data] = reg.field_types.len; reg.declared.type_counts[data] = 2
    reg.field_types.push(0); reg.payload_starts.push(2); reg.payload_counts.push(1)
    reg.payload_types.push(plain)
    reg.field_types.push(0); reg.payload_starts.push(3); reg.payload_counts.push(2)
    reg.payload_types.push(4); reg.payload_types.push(packet)
    assert(move_only(&reg, data))
    wrapper := add_type(&mut reg, "Wrapper", 2, 0)
    reg.declared.type_starts[wrapper] = reg.field_types.len; reg.declared.type_counts[wrapper] = 1
    reg.field_types.push(data)
    assert(move_only(&reg, wrapper))
    reference := insert_compound(&mut reg, 4, data)
    assert(!move_only(&reg, reference))
}
@test fn recursive_unvalidated_types_are_conservatively_noncopyable() {
    mut reg := new_registry()
    _ := add_type(&mut reg, "()", 0, 0)
    node := add_type(&mut reg, "Node", 2, 0)
    reg.declared.type_starts[node] = 0; reg.declared.type_counts[node] = 1
    reg.field_types.push(node)
    assert(move_only(&reg, node))
}
@test fn explicit_resources_are_nonduplicable_through_records_and_enums() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string"] { _ := add_type(&mut reg, name, 0, 0) }
    handle := add_type(&mut reg, "Handle", 2, 0)
    reg.declared.type_starts[handle] = 0; reg.declared.type_counts[handle] = 1
    reg.field_types.push(1); reg.resource[handle] = true
    assert(move_only(&reg, handle) && !cloneable(&reg, handle))
    wrapper := add_type(&mut reg, "Wrapper", 2, 0)
    reg.declared.type_starts[wrapper] = 1; reg.declared.type_counts[wrapper] = 1
    reg.field_types.push(handle)
    assert(move_only(&reg, wrapper) && !cloneable(&reg, wrapper))
    ordinary := add_type(&mut reg, "OpaqueValue", 2, 0)
    reg.opaque_owner[ordinary] = 0
    reg.declared.type_starts[ordinary] = 0; reg.declared.type_counts[ordinary] = 1
    assert(!move_only(&reg, ordinary) && cloneable(&reg, ordinary))
    enumeration := add_type(&mut reg, "Result", 7, 0)
    reg.declared.type_starts[enumeration] = 0; reg.declared.type_counts[enumeration] = 1
    reg.payload_starts.push(0); reg.payload_counts.push(1); reg.payload_types.push(wrapper)
    assert(move_only(&reg, enumeration) && !cloneable(&reg, enumeration))
}
