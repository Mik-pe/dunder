// Frontend type registry, layout validation, and O(1) type indexing.
// Owns all nominal, compound, fixed-array, callable, and C-layout tables
// without circularly depending on the compiler Session or AST/parser state.
import ..backend.ffi_arm64 as abi
import std.map as map

pub struct Shapes {
    type_kinds: []i32, type_bases: []i32, type_starts: []i32, type_counts: []i32,
    ffi_params: []i32, c_sizes: []i32, c_aligns: []i32,
    compound_buckets: []i32, compound_count: i32, fixed_buckets: []i32, fixed_count: i32,
    callable_buckets: []i32, callable_count: i32,
}
fn shapes() -> Shapes {
    Shapes {
        type_kinds: [], type_bases: [], type_starts: [], type_counts: [],
        ffi_params: [], c_sizes: [], c_aligns: [],
        compound_buckets: [], compound_count: 0, fixed_buckets: [], fixed_count: 0,
        callable_buckets: [], callable_count: 0,
    }
}

pub struct TypeRegistry {
    declared: Shapes, body: Shapes, sealed: bool,
    type_names: []string, field_names: []string, field_types: []i32, field_values: []i64,
    payload_starts: []i32, payload_counts: []i32, payload_types: []i32,
    opaque_owner: []i32, c_record: []bool, resource: []bool, named_map: map.Map, error: string,
}
pub fn new_registry() -> TypeRegistry {
    mut named := map.new(); map.reserve(&mut named, 64)
    TypeRegistry {
        declared: shapes(), body: shapes(), sealed: false, named_map: named,
        type_names: [], field_names: [], field_types: [], field_values: [],
        payload_starts: [], payload_counts: [], payload_types: [],
        opaque_owner: [], c_record: [], resource: [], error: "",
    }
}
// A type reference below the frozen prefix is a program identity. All other
// references name a row in the current body's arena and expire at reset.
pub fn reset_body(reg: &mut TypeRegistry) {
    if reg.body.type_kinds.len == 0 { return }
    reg.body.type_kinds.clear(); reg.body.type_bases.clear()
    reg.body.type_starts.clear(); reg.body.type_counts.clear(); reg.body.ffi_params.clear()
    reg.body.c_sizes.clear(); reg.body.c_aligns.clear()
    reg.body.compound_buckets.clear(); reg.body.compound_count = 0
    reg.body.fixed_buckets.clear(); reg.body.fixed_count = 0
    reg.body.callable_buckets.clear(); reg.body.callable_count = 0
}
// A finished worker body has already interned and validated these rows. The
// coordinator consumes them for its ABI bindings before resetting the arena.
// Hash indexes are function-private and are not transported.
pub fn restore_shapes(reg: &mut TypeRegistry, table: &[]i32) {
    reset_body(&mut reg)
    assert(table.len >= 2 && table[0] == reg.declared.type_kinds.len)
    count := table[1]
    for i in 0..count {
        at := 2 + i * 4
        reg.body.type_kinds.push(table[at]); reg.body.type_bases.push(table[at + 1])
        reg.body.type_starts.push(table[at + 2]); reg.body.type_counts.push(table[at + 3])
    }
    for i in (2 + count * 4)..table.len { reg.body.ffi_params.push(table[i]) }
}
pub fn set_error(reg: &mut TypeRegistry, move message: string) {
    if reg.error == "" { reg.error = message }
}

fn append_shape(arena: &mut Shapes, kind: i32, base: i32) -> i32 {
    index := arena.type_kinds.len
    arena.type_kinds.push(kind); arena.type_bases.push(base)
    arena.type_starts.push(0); arena.type_counts.push(0)
    arena.c_sizes.push(0); arena.c_aligns.push(0)
    index
}
fn declared_row(reg: &mut TypeRegistry, move name: string) {
    reg.opaque_owner.push(-1); reg.c_record.push(false); reg.resource.push(false); reg.type_names.push(move name)
}
pub fn add_type(reg: &mut TypeRegistry, name: string, kind: i32, base: i32) -> i32 {
    assert(!reg.sealed)
    id := append_shape(&mut reg.declared, kind, base)
    declared_row(&mut reg, move name.clone())
    if name != "" && !map.contains(&reg.named_map, name) {
        map.put(&mut reg.named_map, name.clone(), i64(id))
    }
    id
}
pub fn type_id(reg: &TypeRegistry, name: string) -> i32 {
    if name == "" { return -1 }
    i32(map.get_or(&reg.named_map, name, -1))
}

pub fn type_kind(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_kinds[ty] }
    reg.body.type_kinds[ty - prefix]
}
pub fn type_base(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_bases[ty] }
    reg.body.type_bases[ty - prefix]
}
pub fn type_count(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_counts[ty] }
    reg.body.type_counts[ty - prefix]
}
pub fn type_start(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.type_starts[ty] }
    reg.declared.ffi_params.len + reg.body.type_starts[ty - prefix]
}
pub fn parameter_type(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.ffi_params.len
    if ty < prefix { return reg.declared.ffi_params[ty] }
    reg.body.ffi_params[ty - prefix]
}
pub fn c_size(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.c_sizes[ty] }
    reg.body.c_sizes[ty - prefix]
}
pub fn c_align(reg: &TypeRegistry, ty: i32) -> i32 {
    prefix := reg.declared.type_kinds.len
    if ty < prefix { return reg.declared.c_aligns[ty] }
    reg.body.c_aligns[ty - prefix]
}
pub fn declared_name(reg: &TypeRegistry, ty: i32) -> string {
    if ty >= reg.type_names.len { return "" }
    reg.type_names[ty].clone()
}
pub fn is_c_record(reg: &TypeRegistry, ty: i32) -> bool {
    if ty >= reg.c_record.len { return false }
    reg.c_record[ty]
}
pub fn declaring_owner(reg: &TypeRegistry, ty: i32) -> i32 {
    if ty >= reg.opaque_owner.len { return -1 }
    reg.opaque_owner[ty]
}
pub fn scalar_element(reg: &TypeRegistry, ty: i32) -> bool {
    if ty >= 1 && ty <= 13 { return true }
    kind := type_kind(&reg, ty); kind == 3 || kind == 22
}

pub fn foreign_scalar(reg: &TypeRegistry, ty: i32) -> bool {
    ty == 1 || ty == 2 || (ty >= 6 && ty <= 13) || type_kind(&reg, ty) == 8
}

pub fn foreign_width(ty: i32) -> i32 { abi.width(ty) }

pub fn storage_type(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    kind := type_kind(&reg, ty)
    if kind == 3 { return 1 }
    if platform == 3 && (ty == 12 || ty == 13 || kind == 8 || kind == 9) { return 10 }
    ty
}

pub fn scalar_bytes(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    if ty == 3 || ty == 8 { return 1 }
    if ty == 9 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 || type_kind(&reg, ty) == 3 { return 4 }
    if platform == 3 && (ty == 12 || ty == 13 || type_kind(&reg, ty) == 8) { return 4 }
    8
}

fn collection_kind(kind: i32) -> bool { kind == 1 || kind == 6 || kind == 10 }
pub fn collection(reg: &TypeRegistry, ty: i32) -> bool {
    collection_kind(type_kind(&reg, ty))
}

pub fn owned(reg: &TypeRegistry, ty: i32) -> bool {
    if ty == 4 { return true }
    kind := type_kind(&reg, ty); kind == 2 || kind == 7 || collection_kind(kind)
}

// Source copying is separate from storage cleanup: boxed POD records need
// dropping but remain implicitly copyable. Strings and all array containers
// are move-only; references/scratch views do not own their referents.
pub fn move_only(reg: &TypeRegistry, ty: i32) -> bool {
    move_only_at(&reg, ty, 0)
}
fn move_only_at(reg: &TypeRegistry, ty: i32, depth: i32) -> bool {
    if ty < reg.resource.len && reg.resource[ty] { return true }
    if ty == 4 { return true }
    // Layout validation rejects this depth for inline values. Keep malformed
    // or not-yet-validated recursive metadata conservative rather than Copy.
    if depth >= 128 { return true }
    kind := type_kind(&reg, ty)
    if kind == 1 || kind == 6 || kind == 10 { return true }
    if kind != 2 && kind != 7 { return false }
    first := type_start(&reg, ty)
    for member in first..first + type_count(&reg, ty) {
        if kind == 2 {
            if move_only_at(&reg, reg.field_types[member], depth + 1) { return true }
        } else {
            payload := reg.payload_starts[member]
            for item in 0..reg.payload_counts[member] {
                if move_only_at(&reg, reg.payload_types[payload + item], depth + 1) { return true }
            }
        }
    }
    false
}

// Resource markers describe external identities (fd, pid, device handle),
// which a byte/field clone cannot duplicate. Containers inherit the restriction.
pub fn cloneable(reg: &TypeRegistry, ty: i32) -> bool { cloneable_at(&reg, ty, 0) }
fn cloneable_at(reg: &TypeRegistry, ty: i32, depth: i32) -> bool {
    if ty < reg.resource.len && reg.resource[ty] { return false }
    if depth >= 128 { return false }
    kind := type_kind(&reg, ty)
    if kind == 1 || kind == 6 || kind == 10 { return cloneable_at(&reg, type_base(&reg, ty), depth + 1) }
    if kind != 2 && kind != 7 { return true }
    first := type_start(&reg, ty)
    for member in first..first + type_count(&reg, ty) {
        if kind == 2 {
            if !cloneable_at(&reg, reg.field_types[member], depth + 1) { return false }
        } else {
            payload := reg.payload_starts[member]
            for item in 0..reg.payload_counts[member] {
                if !cloneable_at(&reg, reg.payload_types[payload + item], depth + 1) { return false }
            }
        }
    }
    true
}

pub fn enum_type(reg: &TypeRegistry, ty: i32) -> bool {
    if ty < 0 { return false }
    kind := type_kind(&reg, ty); kind == 3 || kind == 7
}

pub fn fixed_pod(reg: &TypeRegistry, ty: i32) -> bool {
    if type_kind(&reg, ty) != 6 { return false }
    base := type_base(&reg, ty); base == 3 || foreign_scalar(&reg, base)
}

pub fn field(reg: &TypeRegistry, ty: i32, name: string) -> i32 {
    first := type_start(&reg, ty)
    for i in first..first + type_count(&reg, ty) {
        if reg.field_names[i] == name { return i }
    }
    -1
}

pub fn scalar_type(reg: &TypeRegistry, ty: i32) -> i32 {
    if ty >= 0 && ty <= 3 { return ty }
    kind := type_kind(&reg, ty)
    if kind == 4 || kind == 5 {
        array := type_base(&reg, ty)
        if type_kind(&reg, array) == 1 && type_base(&reg, array) == 2 {
            if kind == 5 { return 21 }
            return 20
        }
    }
    -1
}

fn hash2(a: i32, b: i32, capacity: i32) -> i32 {
    mut value := i64(a).bit_xor(i64(b).shl(32))
    value = value.bit_xor(value.shr(30)).wrapping_mul(-4658895280553007687)
    value = value.bit_xor(value.shr(27)).wrapping_mul(-7723592293110705685)
    value = value.bit_xor(value.shr(31))
    i32(value.bit_and(i64(capacity - 1)))
}

fn callable_hash(kind: i32, result: i32, args: &[]i32, capacity: i32) -> i32 {
    mut value := i64(kind).wrapping_mul(1000003).bit_xor(i64(result).wrapping_mul(2654435761))
    value = value.bit_xor(i64(args.len).wrapping_mul(-4658895280553007687))
    for arg in args {
        value = value.wrapping_mul(131).bit_xor(i64(arg) + 1)
    }
    value = value.bit_xor(value.shr(30)).wrapping_mul(-7723592293110705685)
    value = value.bit_xor(value.shr(31))
    i32(value.bit_and(i64(capacity - 1)))
}

fn grow_compound(reg: &mut Shapes) {
    mut capacity := 64
    if reg.compound_buckets.len > 0 { capacity = reg.compound_buckets.len * 2 }
    mut fresh: []i32 = []
    fresh.reserve(capacity)
    for i in 0..capacity { fresh.push(0) }
    for i in 0..reg.compound_buckets.len {
        entry := reg.compound_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        mut slot := hash2(reg.type_kinds[ty], reg.type_bases[ty], capacity)
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.compound_buckets = fresh
}

fn grow_fixed(reg: &mut Shapes) {
    mut capacity := 32
    if reg.fixed_buckets.len > 0 { capacity = reg.fixed_buckets.len * 2 }
    mut fresh: []i32 = []
    fresh.reserve(capacity)
    for i in 0..capacity { fresh.push(0) }
    for i in 0..reg.fixed_buckets.len {
        entry := reg.fixed_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        mut slot := hash2(reg.type_bases[ty], reg.type_counts[ty], capacity)
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.fixed_buckets = fresh
}

fn grow_callable(reg: &mut Shapes) {
    mut capacity := 32
    if reg.callable_buckets.len > 0 { capacity = reg.callable_buckets.len * 2 }
    mut fresh: []i32 = []
    fresh.reserve(capacity)
    for i in 0..capacity { fresh.push(0) }
    for i in 0..reg.callable_buckets.len {
        entry := reg.callable_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        mut value := i64(reg.type_kinds[ty]).wrapping_mul(1000003).bit_xor(i64(reg.type_bases[ty]).wrapping_mul(2654435761))
        count := reg.type_counts[ty]
        value = value.bit_xor(i64(count).wrapping_mul(-4658895280553007687))
        first := reg.type_starts[ty]
        for p in 0..count { value = value.wrapping_mul(131).bit_xor(i64(reg.ffi_params[first + p]) + 1) }
        value = value.bit_xor(value.shr(30)).wrapping_mul(-7723592293110705685)
        value = value.bit_xor(value.shr(31))
        mut slot := i32(value.bit_and(i64(capacity - 1)))
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.callable_buckets = fresh
}

pub fn find_or_check_compound(reg: &mut TypeRegistry, kind: i32, base: i32) -> i32 {
    if (kind == 4 || kind == 5) && (base == 0 || type_kind(&reg, base) == 4 || type_kind(&reg, base) == 5) {
        set_error(&mut reg, move "reference a value type"); return -2
    }
    if kind == 1 && !scalar_element(&reg, base) {
        set_error(&mut reg, move "arrays of aggregate elements are not supported by this compiler")
    }
    known := find_compound(&reg.declared, kind, base)
    if known >= 0 || !reg.sealed { return known }
    local := find_compound(&reg.body, kind, base)
    if local < 0 { return -1 }
    reg.declared.type_kinds.len + local
}
fn find_compound(reg: &Shapes, kind: i32, base: i32) -> i32 {
    if reg.compound_buckets.len > 0 {
        cap := reg.compound_buckets.len
        mut slot := hash2(kind, base, cap)
        while reg.compound_buckets[slot] != 0 {
            ty := reg.compound_buckets[slot] - 1
            if reg.type_kinds[ty] == kind && reg.type_bases[ty] == base { return ty }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_compound(reg: &mut TypeRegistry, kind: i32, base: i32) -> i32 {
    if reg.sealed {
        local := append_compound(&mut reg.body, kind, base)
        return reg.declared.type_kinds.len + local
    }
    declared_row(&mut reg, move "")
    append_compound(&mut reg.declared, kind, base)
}
fn append_compound(reg: &mut Shapes, kind: i32, base: i32) -> i32 {
    if reg.compound_buckets.len == 0 || (reg.compound_count + 1) * 2 > reg.compound_buckets.len {
        grow_compound(&mut reg)
    }
    id := append_shape(&mut reg, kind, base)
    cap := reg.compound_buckets.len
    mut slot := hash2(kind, base, cap)
    while reg.compound_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.compound_buckets[slot] = id + 1
    reg.compound_count = reg.compound_count + 1
    id
}

pub fn find_or_check_fixed(reg: &mut TypeRegistry, platform: i32, base: i32, length: i32) -> i32 {
    if !scalar_element(&reg, base) {
        set_error(&mut reg, move "arrays of aggregate elements are not supported by this compiler")
    }
    if length > 65536 / scalar_bytes(&reg, base, platform) {
        set_error(&mut reg, move "fixed array exceeds 65536 bytes"); return -2
    }
    known := find_fixed(&reg.declared, base, length)
    if known >= 0 || !reg.sealed { return known }
    local := find_fixed(&reg.body, base, length)
    if local < 0 { return -1 }
    reg.declared.type_kinds.len + local
}
fn find_fixed(reg: &Shapes, base: i32, length: i32) -> i32 {
    if reg.fixed_buckets.len > 0 {
        cap := reg.fixed_buckets.len
        mut slot := hash2(base, length, cap)
        while reg.fixed_buckets[slot] != 0 {
            ty := reg.fixed_buckets[slot] - 1
            if reg.type_kinds[ty] == 6 && reg.type_bases[ty] == base && reg.type_counts[ty] == length { return ty }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_fixed(reg: &mut TypeRegistry, base: i32, length: i32) -> i32 {
    if reg.sealed {
        local := append_fixed(&mut reg.body, base, length)
        return reg.declared.type_kinds.len + local
    }
    declared_row(&mut reg, move "")
    append_fixed(&mut reg.declared, base, length)
}
fn append_fixed(reg: &mut Shapes, base: i32, length: i32) -> i32 {
    if reg.fixed_buckets.len == 0 || (reg.fixed_count + 1) * 2 > reg.fixed_buckets.len {
        grow_fixed(&mut reg)
    }
    ty := append_shape(&mut reg, 6, base)
    reg.type_counts[ty] = length
    cap := reg.fixed_buckets.len
    mut slot := hash2(base, length, cap)
    while reg.fixed_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.fixed_buckets[slot] = ty + 1
    reg.fixed_count = reg.fixed_count + 1
    ty
}

pub fn find_or_check_callable(reg: &mut TypeRegistry, args: &[]i32, result: i32, kind: i32) -> i32 {
    for ty in args {
        if kind == 8 && !foreign_scalar(&reg, ty) && !is_c_record(&reg, ty) {
            set_error(&mut reg, move "C calls require scalar parameters or a record pointer"); return -2
        }
    }
    if kind == 8 && result != 0 && !foreign_scalar(&reg, result) && !is_c_record(&reg, result) {
        set_error(&mut reg, move "C calls require scalar return types"); return -2
    }
    known := find_callable(&reg.declared, &args, result, kind)
    if known >= 0 || !reg.sealed { return known }
    local := find_callable(&reg.body, &args, result, kind)
    if local < 0 { return -1 }
    reg.declared.type_kinds.len + local
}
fn find_callable(reg: &Shapes, args: &[]i32, result: i32, kind: i32) -> i32 {
    if reg.callable_buckets.len > 0 {
        cap := reg.callable_buckets.len
        mut slot := callable_hash(kind, result, &args, cap)
        while reg.callable_buckets[slot] != 0 {
            t := reg.callable_buckets[slot] - 1
            if reg.type_kinds[t] == kind && reg.type_bases[t] == result && reg.type_counts[t] == args.len {
                mut equal := true
                first := reg.type_starts[t]
                for i in 0..args.len {
                    if reg.ffi_params[first + i] != args[i] { equal = false; break }
                }
                if equal { return t }
            }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_callable(reg: &mut TypeRegistry, args: &[]i32, result: i32, kind: i32) -> i32 {
    if reg.sealed {
        local := append_callable(&mut reg.body, &args, result, kind)
        return reg.declared.type_kinds.len + local
    }
    declared_row(&mut reg, move "")
    append_callable(&mut reg.declared, &args, result, kind)
}
fn append_callable(reg: &mut Shapes, args: &[]i32, result: i32, kind: i32) -> i32 {
    if reg.callable_buckets.len == 0 || (reg.callable_count + 1) * 2 > reg.callable_buckets.len {
        grow_callable(&mut reg)
    }
    t := append_shape(&mut reg, kind, result)
    reg.type_starts[t] = reg.ffi_params.len; reg.type_counts[t] = args.len
    for arg in args { reg.ffi_params.push(arg) }
    cap := reg.callable_buckets.len
    mut slot := callable_hash(kind, result, &args, cap)
    while reg.callable_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.callable_buckets[slot] = t + 1
    reg.callable_count = reg.callable_count + 1
    t
}

pub fn type_spelling(reg: &TypeRegistry, ty: i32) -> string {
    kind := type_kind(&reg, ty)
    if declared_name(&reg, ty) != "" { return declared_name(&reg, ty) }
    if kind == 8 || kind == 9 {
        mut args := ""
        for i in 0..type_count(&reg, ty) {
            if i > 0 { args = args + ", " }
            args = args + type_spelling(&reg, parameter_type(&reg, type_start(&reg, ty) + i))
        }
        mut fn_name := "fn"; if kind == 8 { fn_name = "extern fn" }
        return fn_name + "(" + args + ") -> " + type_spelling(&reg, type_base(&reg, ty))
    }
    if kind == 20 { return "region" }
    if kind == 22 { return "TaskID<" + type_spelling(&reg, type_base(&reg, ty)) + ">" }
    if kind == 23 { return "task scope" }
    base := type_spelling(&reg, type_base(&reg, ty))
    if kind == 1 || kind == 21 { return "[]" + base }
    if kind == 6 { return "[" + base + "; " + type_count(&reg, ty).str() + "]" }
    if kind == 4 { return "&" + base }
    if kind == 5 { return "&mut " + base }
    if kind == 10 { return "iter<" + base + ">" }
    base
}

// Positive counts denote homogeneous f32 members, negative counts homogeneous f64.
pub fn hfa(reg: &TypeRegistry, ty: i32, depth: i32) -> i32 {
    if depth > 64 { return 0 }
    if ty == 6 { return 1 }
    if ty == 7 { return -1 }
    if type_kind(&reg, ty) == 6 {
        count := type_count(&reg, ty); if count > 4 { return 0 }
        return count * hfa(&reg, type_base(&reg, ty), depth + 1)
    }
    if !is_c_record(&reg, ty) { return 0 }
    mut shape := 0
    for index in type_start(&reg, ty)..type_start(&reg, ty) + type_count(&reg, ty) {
        part := hfa(&reg, reg.field_types[index], depth + 1)
        if part == 0 || (shape > 0 && part < 0) || (shape < 0 && part > 0) { return 0 }
        shape = shape + part
        if shape < -4 || shape > 4 { return 0 }
    }
    shape
}

// Layout is evaluated once for eligible declared types. Body-only C arrays
// and callable pointers use the same layout rules in the local arena.
pub fn seal(reg: &mut TypeRegistry, platform: i32) {
    for ty in 0..reg.declared.type_kinds.len {
        mut eligible := foreign_scalar(&reg, ty) || ty == 3 || reg.c_record[ty]
        if reg.declared.type_kinds[ty] == 6 {
            child := reg.declared.type_bases[ty]
            eligible = foreign_scalar(&reg, child) || child == 3 || reg.c_record[child]
        }
        if eligible { c_layout(&mut reg, platform, ty) }
    }
    reg.sealed = true
}
pub fn c_layout(reg: &mut TypeRegistry, platform: i32, ty: i32) {
    prefix := reg.declared.type_kinds.len
    if reg.error != "" || c_align(&reg, ty) > 0 { return }
    if c_align(&reg, ty) < 0 { set_error(&mut reg, move "recursive C layout"); return }
    if ty < prefix {
        if reg.sealed { set_error(&mut reg, move "C layouts can contain only unmanaged C fields"); return }
        reg.declared.c_aligns[ty] = -1
    } else { reg.body.c_aligns[ty - prefix] = -1 }
    mut size := 0; mut alignment := 1
    if is_c_record(&reg, ty) {
        first := reg.declared.type_starts[ty]
        for field_index in first..first + type_count(&reg, ty) {
            ft := reg.field_types[field_index]; c_layout(&mut reg, platform, ft)
            if reg.error != "" { return }
            child := reg.declared.c_aligns[ft]
            if size > 2147483647 - child || reg.declared.c_sizes[ft] > 2147483647 - child - size {
                set_error(&mut reg, move "C record layout exceeds supported size"); return
            }
            size = (size + child - 1) / child * child
            reg.field_values[field_index] = i64(size)
            if child > alignment { alignment = child }
            size = size + reg.declared.c_sizes[ft]
        }
        if size == 0 { set_error(&mut reg, move "empty C record"); return }
        size = (size + alignment - 1) / alignment * alignment
    } else if type_kind(&reg, ty) == 6 {
        child := type_base(&reg, ty); c_layout(&mut reg, platform, child)
        if reg.error != "" { return }
        if c_size(&reg, child) > 0 && type_count(&reg, ty) > 2147483647 / c_size(&reg, child) {
            set_error(&mut reg, move "C array layout exceeds supported size"); return
        }
        alignment = c_align(&reg, child); size = type_count(&reg, ty) * c_size(&reg, child)
    } else if foreign_scalar(&reg, ty) || ty == 3 {
        alignment = foreign_width(ty); size = alignment
        if platform == 3 && (ty == 12 || ty == 13 || type_kind(&reg, ty) == 8) { size = 4; alignment = 4 }
    } else {
        set_error(&mut reg, move "C layouts can contain only unmanaged C fields"); return
    }
    if ty < prefix {
        reg.declared.c_aligns[ty] = alignment; reg.declared.c_sizes[ty] = size
    } else {
        reg.body.c_aligns[ty - prefix] = alignment; reg.body.c_sizes[ty - prefix] = size
    }
}

pub fn layout_bytes(reg: &mut TypeRegistry, platform: i32, ty: i32, depth: i32, sizes: &mut []i32) -> i32 {
    if reg.error != "" { return 1 }
    if sizes[ty] < 0 || depth >= 128 {
        set_error(&mut reg, move "recursive or excessively nested inline value type"); return 1
    }
    if sizes[ty] > 0 { return sizes[ty] }
    kind := reg.declared.type_kinds[ty]
    if kind == 1 { return 24 }
    if kind == 6 {
        bytes := reg.declared.type_counts[ty] * scalar_bytes(&reg, reg.declared.type_bases[ty], platform)
        if bytes == 0 { return 1 }; return bytes
    }
    if kind != 2 && kind != 7 {
        if ty == 0 || ty == 14 || kind == 10 { set_error(&mut reg, move "invalid stored field type"); return 1 }
        return scalar_bytes(&reg, ty, platform)
    }
    if reg.c_record[ty] { return reg.declared.c_sizes[ty] }
    sizes[ty] = -1
    mut size := 0
    mut max_align := 1
    for member in reg.declared.type_starts[ty]..reg.declared.type_starts[ty] + reg.declared.type_counts[ty] {
        mut offset := size
        mut items := 1
        if kind == 7 { offset = 8; items = reg.payload_counts[member]; max_align = 8 }
        for item in 0..items {
            mut ft := reg.field_types[member]
            if kind == 7 { ft = reg.payload_types[reg.payload_starts[member] + item] }
            width := layout_bytes(&mut reg, platform, ft, depth + 1, &mut sizes)
            if reg.error != "" { return 1 }
            mut alignment := scalar_bytes(&reg, ft, platform)
            field_kind := reg.declared.type_kinds[ft]
            if field_kind == 1 || field_kind == 2 || field_kind == 6 || field_kind == 7 { alignment = 8 }
            offset = (offset + alignment - 1) / alignment * alignment + width
            if offset > 65536 { set_error(&mut reg, move "inline value exceeds 65536 bytes"); return 1 }
            if alignment > max_align { max_align = alignment }
        }
        if size < offset { size = offset }
    }
    if size == 0 { size = 1 }
    size = (size + max_align - 1) / max_align * max_align
    sizes[ty] = size
    size
}

pub fn validate_layouts(reg: &mut TypeRegistry, platform: i32) {
    mut sizes: []i32 = []
    sizes.reserve(reg.declared.type_kinds.len)
    for ty in reg.declared.type_kinds { sizes.push(0) }
    for ty in 0..sizes.len {
        if reg.error != "" { return }
        kind := reg.declared.type_kinds[ty]
        if (kind == 1 || kind == 6) && !scalar_element(&reg, reg.declared.type_bases[ty]) {
            set_error(&mut reg, move "arrays of aggregate elements are not supported by this compiler"); return
        }
        if kind == 2 || kind == 7 {
            size := layout_bytes(&mut reg, platform, ty, 0, &mut sizes)
            if size > 65536 { set_error(&mut reg, move "inline value exceeds 65536 bytes") }
        }
    }
}

pub fn scratch_c_value(reg: &TypeRegistry, ty: i32) -> bool {
    if is_c_record(&reg, ty) {
        for f in type_start(&reg, ty)..type_start(&reg, ty) + type_count(&reg, ty) {
            if !scratch_c_value(&reg, reg.field_types[f]) { return false }
        }
        return true
    }
    if type_kind(&reg, ty) == 6 { return scratch_c_value(&reg, type_base(&reg, ty)) }
    ty >= 1 && ty <= 12 && ty != 4
}

pub fn scratch_width(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    if type_kind(&reg, ty) == 2 {
        if is_c_record(&reg, ty) {
            if scratch_c_value(&reg, ty) { return c_size(&reg, ty) }
            return 0
        }
        for f in type_start(&reg, ty)..type_start(&reg, ty) + type_count(&reg, ty) {
            ft := reg.field_types[f]
            if ft < 1 || ft > 12 || ft == 4 { return 0 }
        }
        if type_count(&reg, ty) == 0 { return 1 }
        return type_count(&reg, ty) * 8
    }
    if ty < 1 || ty > 12 || ty == 4 { return 0 }
    foreign_width(storage_type(&reg, ty, platform))
}

@test fn function_type_references_expire_without_extending_declarations() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string"] { added := add_type(&mut reg, name, 0, 0) }
    array := insert_compound(&mut reg, 1, 2)
    seal(&mut reg, 0)
    declared := reg.declared.type_kinds.len
    assert(find_or_check_compound(&mut reg, 1, 2) == array)
    fixed := insert_fixed(&mut reg, 2, 7); reference := insert_compound(&mut reg, 4, fixed)
    assert(move_only(&reg, fixed) && !move_only(&reg, reference))
    params: []i32 = [array, reference]
    sig := insert_callable(&mut reg, &params, fixed, 9)
    assert(type_spelling(&reg, sig) == "fn([]i64, &[i64; 7]) -> [i64; 7]")
    c_layout(&mut reg, 0, fixed)
    assert(reg.error == "" && c_size(&reg, fixed) == 56 && c_align(&reg, fixed) == 8)
    assert(find_or_check_callable(&mut reg, &params, fixed, 9) == sig)
    reset_body(&mut reg)
    assert(reg.declared.type_kinds.len == declared && reg.body.type_kinds.len == 0)
    assert(find_or_check_fixed(&mut reg, 0, 2, 7) == -1)
    other := insert_compound(&mut reg, 5, array)
    assert(other == fixed && type_spelling(&reg, other) == "&mut []i64")
}

@test fn array_ownership_is_recursive_and_independent_of_runtime_cleanup() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr"] {
        _ := add_type(&mut reg, name, 0, 0)
    }
    array := insert_compound(&mut reg, 1, 1)
    fixed := insert_fixed(&mut reg, 1, 4)
    iterator := insert_compound(&mut reg, 10, 1)
    shared := insert_compound(&mut reg, 4, array)
    exclusive := insert_compound(&mut reg, 5, array)
    region_view := insert_compound(&mut reg, 21, 1)
    assert(move_only(&reg, array) && move_only(&reg, fixed) && move_only(&reg, iterator))
    assert(!move_only(&reg, shared) && !move_only(&reg, exclusive) && !move_only(&reg, region_view))
    assert(owned(&reg, 4) && move_only(&reg, 4) && !move_only(&reg, 1))

    pod := add_type(&mut reg, "Pod", 2, 0)
    reg.declared.type_starts[pod] = reg.field_types.len
    reg.declared.type_counts[pod] = 2
    reg.field_types.push(1); reg.field_types.push(2)
    assert(owned(&reg, pod) && !move_only(&reg, pod))
    text_box := add_type(&mut reg, "TextBox", 2, 0)
    reg.declared.type_starts[text_box] = reg.field_types.len
    reg.declared.type_counts[text_box] = 1; reg.field_types.push(4)
    assert(move_only(&reg, text_box))
    packet := add_type(&mut reg, "Packet", 2, 0)
    reg.declared.type_starts[packet] = reg.field_types.len
    reg.declared.type_counts[packet] = 2
    reg.field_types.push(pod); reg.field_types.push(array)
    outer := add_type(&mut reg, "Outer", 2, 0)
    reg.declared.type_starts[outer] = reg.field_types.len
    reg.declared.type_counts[outer] = 1; reg.field_types.push(packet)
    assert(move_only(&reg, packet) && move_only(&reg, outer))

    c_record := add_type(&mut reg, "CRecord", 2, 0)
    reg.c_record[c_record] = true
    reg.declared.type_starts[c_record] = reg.field_types.len
    reg.declared.type_counts[c_record] = 1; reg.field_types.push(fixed)
    assert(move_only(&reg, c_record))
}
@test fn enum_payload_ownership_checks_every_variant_and_nested_record() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string"] { _ := add_type(&mut reg, name, 0, 0) }
    array := insert_compound(&mut reg, 1, 1)
    packet := add_type(&mut reg, "Packet", 2, 0)
    reg.declared.type_starts[packet] = 0; reg.declared.type_counts[packet] = 1
    reg.field_types.push(array)
    // Enum variant entries share the field-index domain. Prefix the payload
    // columns for the existing struct field before adding the variants.
    reg.payload_starts.push(0); reg.payload_counts.push(0)
    plain := add_type(&mut reg, "Plain", 7, 0)
    reg.declared.type_starts[plain] = reg.field_types.len; reg.declared.type_counts[plain] = 2
    reg.field_types.push(0); reg.payload_starts.push(0); reg.payload_counts.push(0)
    reg.field_types.push(0); reg.payload_starts.push(0); reg.payload_counts.push(2)
    reg.payload_types.push(1); reg.payload_types.push(2)
    assert(owned(&reg, plain) && !move_only(&reg, plain))
    reg.payload_types[1] = 4
    assert(move_only(&reg, plain))
    reg.payload_types[1] = 2
    assert(!move_only(&reg, plain))
    data := add_type(&mut reg, "Data", 7, 0)
    reg.declared.type_starts[data] = reg.field_types.len; reg.declared.type_counts[data] = 2
    reg.field_types.push(0); reg.payload_starts.push(2); reg.payload_counts.push(1)
    reg.payload_types.push(plain)
    reg.field_types.push(0); reg.payload_starts.push(3); reg.payload_counts.push(2)
    reg.payload_types.push(4); reg.payload_types.push(packet)
    assert(move_only(&reg, data))
    wrapper := add_type(&mut reg, "Wrapper", 2, 0)
    reg.declared.type_starts[wrapper] = reg.field_types.len; reg.declared.type_counts[wrapper] = 1
    reg.field_types.push(data)
    assert(move_only(&reg, wrapper))
    reference := insert_compound(&mut reg, 4, data)
    assert(!move_only(&reg, reference))
}
@test fn recursive_unvalidated_types_are_conservatively_noncopyable() {
    mut reg := new_registry()
    _ := add_type(&mut reg, "()", 0, 0)
    node := add_type(&mut reg, "Node", 2, 0)
    reg.declared.type_starts[node] = 0; reg.declared.type_counts[node] = 1
    reg.field_types.push(node)
    assert(move_only(&reg, node))
}
@test fn explicit_resources_are_nonduplicable_through_records_and_enums() {
    mut reg := new_registry()
    for name in ["()", "i32", "i64", "bool", "string"] { _ := add_type(&mut reg, name, 0, 0) }
    handle := add_type(&mut reg, "Handle", 2, 0)
    reg.declared.type_starts[handle] = 0; reg.declared.type_counts[handle] = 1
    reg.field_types.push(1); reg.resource[handle] = true
    assert(move_only(&reg, handle) && !cloneable(&reg, handle))
    wrapper := add_type(&mut reg, "Wrapper", 2, 0)
    reg.declared.type_starts[wrapper] = 1; reg.declared.type_counts[wrapper] = 1
    reg.field_types.push(handle)
    assert(move_only(&reg, wrapper) && !cloneable(&reg, wrapper))
    // Opacity alone hides representation; it does not promise unique ownership.
    ordinary := add_type(&mut reg, "OpaqueValue", 2, 0)
    reg.opaque_owner[ordinary] = 0
    reg.declared.type_starts[ordinary] = 0; reg.declared.type_counts[ordinary] = 1
    assert(!move_only(&reg, ordinary) && cloneable(&reg, ordinary))
    enumeration := add_type(&mut reg, "Result", 7, 0)
    reg.declared.type_starts[enumeration] = 0; reg.declared.type_counts[enumeration] = 1
    reg.payload_starts.push(0); reg.payload_counts.push(1); reg.payload_types.push(wrapper)
    assert(move_only(&reg, enumeration) && !cloneable(&reg, enumeration))
}
