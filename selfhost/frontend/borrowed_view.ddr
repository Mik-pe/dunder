import ..backend.arm64 as arm

fn outside(home: i32, data: i32) -> bool { home < data - 5 || home > data }

pub fn pass_result(code: &mut arm.Code, holder: i32) {
    arm.address(&mut code, holder - 1)
    arm.store(&mut code, holder, 0)
    arm.address(&mut code, holder)
    arm.push(&mut code, 0)
}

pub fn return_to(code: &mut arm.Code, destination: i32) {
    arm.transfer(&mut code, true, 0, 0, 3, 0)
    arm.load_into(&mut code, destination, 1)
    for word in 0..6 {
        arm.transfer(&mut code, true, 2, 0, 3, word * 8)
        arm.transfer(&mut code, false, 2, 1, 3, (word + 1) * 8)
    }
    arm.mov(&mut code, 0, 1)
}

fn boundary(code: &mut arm.Code, source: i32, index: i32, unicode: i32, source_offset: i32) {
    done := arm.label(&mut code)
    arm.load(&mut code, source)
    arm.transfer(&mut code, true, 2, 0, 3, 0)
    arm.load_into(&mut code, index, 1)
    arm.compare_register(&mut code, 1, 2)
    arm.branch(&mut code, done, 2)
    arm.integer_binary(&mut code, 1, true, false, 2, 0, 1, -1)
    arm.transfer(&mut code, true, 0, 2, 0, 8)
    arm.bitfield(&mut code, false, true, 0, 0, 6, 7)
    arm.compare_immediate(&mut code, 0, 2, false)
    arm.set_condition(&mut code, 0, 0)
    arm.source_edge(&mut code, unicode, .WhenTrue, source_offset)
    arm.mark(&mut code, done)
}

pub fn emit(code: &mut arm.Code, source: i32, first: i32, last: i32, data_home: i32,
    text: bool, shift: i32, bounds: i32, unicode: i32, source_offset: i32) {
    assert(source >= 0 && source < 65535 && first >= 0 && first < 65535 && last >= 0 && last < 65535)
    assert(data_home >= 5 && data_home < 65535 && shift >= 0 && shift <= 3)
    assert(source != first && source != last && outside(source, data_home) && outside(first, data_home) && outside(last, data_home))
    assert(bounds >= 0 && bounds < arm.label_count(&code) && source_offset >= 0)
    if text { assert(shift == 0 && unicode >= 0 && unicode < arm.label_count(&code)) }

    arm.load(&mut code, source)
    mut length_offset := 8; if text { length_offset = 0 }
    arm.transfer(&mut code, true, 2, 0, 3, length_offset)
    arm.integer_binary(&mut code, 1, true, false, 2, 2, -1, 1)
    arm.load_into(&mut code, last, 1)
    arm.compare_register(&mut code, 1, 2)
    arm.source_edge(&mut code, bounds, .Bounds, source_offset)
    arm.integer_binary(&mut code, 1, true, false, 2, 1, -1, 1)
    arm.load(&mut code, first)
    arm.compare_register(&mut code, 0, 2)
    arm.source_edge(&mut code, bounds, .Bounds, source_offset)

    if text {
        boundary(&mut code, source, first, unicode, source_offset)
        boundary(&mut code, source, last, unicode, source_offset)
    }
    arm.load(&mut code, source)
    if text { arm.integer_binary(&mut code, 1, true, false, 0, 0, -1, 8) }
    else { arm.transfer(&mut code, true, 0, 0, 3, 0) }
    arm.load_into(&mut code, first, 1)
    if shift > 0 {
        arm.imm(&mut code, 2, i64(shift))
        arm.integer_binary(&mut code, 14, true, false, 1, 1, 2, -1)
    }
    arm.integer_binary(&mut code, 1, true, false, 0, 0, 1, -1)
    arm.store(&mut code, data_home, 0)
    arm.load(&mut code, last); arm.load_into(&mut code, first, 1)
    arm.integer_binary(&mut code, 2, true, false, 0, 0, 1, -1)
    arm.store(&mut code, data_home - 1, 0); arm.store(&mut code, data_home - 2, 0)
    arm.imm(&mut code, 0, i64(shift)); arm.store(&mut code, data_home - 3, 0)
    if text {
        arm.store(&mut code, data_home - 4, 31); arm.store(&mut code, data_home - 5, 31)
    } else {
        arm.load(&mut code, source)
        arm.transfer(&mut code, true, 1, 0, 3, 32); arm.store(&mut code, data_home - 4, 1)
        arm.transfer(&mut code, true, 1, 0, 3, 40); arm.store(&mut code, data_home - 5, 1)
    }
    arm.address(&mut code, data_home)
}

pub fn emit_raw(code: &mut arm.Code, base_home: i32, len_home: i32, data_home: i32, bounds: i32, source_offset: i32) {
    assert(base_home >= 0 && base_home < 65535 && len_home >= 0 && len_home < 65535)
    assert(data_home >= 5 && data_home < 65535 && outside(base_home, data_home) && outside(len_home, data_home))
    assert(bounds >= 0 && bounds < arm.label_count(&code) && source_offset >= 0)

    arm.load_into(&mut code, len_home, 1)
    arm.imm(&mut code, 2, 2147483648)
    arm.compare_register(&mut code, 1, 2)
    arm.source_edge(&mut code, bounds, .Bounds, source_offset)

    base_ok := arm.label(&mut code)
    arm.load(&mut code, len_home)
    arm.source_edge(&mut code, base_ok, .WhenFalse, source_offset)
    arm.load(&mut code, base_home)
    arm.compare_immediate(&mut code, 0, 0, false)
    arm.set_condition(&mut code, 0, 0)
    arm.source_edge(&mut code, bounds, .WhenTrue, source_offset)
    arm.mark(&mut code, base_ok)

    arm.load(&mut code, base_home); arm.store(&mut code, data_home, 0)
    arm.load(&mut code, len_home); arm.store(&mut code, data_home - 1, 0); arm.store(&mut code, data_home - 2, 0)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, data_home - 3, 0)
    arm.store(&mut code, data_home - 4, 31); arm.store(&mut code, data_home - 5, 31)
    arm.address(&mut code, data_home)
}

fn boundary_view(code: &mut arm.Code, source: i32, index: i32, unicode: i32, source_offset: i32) {
    done := arm.label(&mut code)
    arm.load(&mut code, source)
    arm.transfer(&mut code, true, 2, 0, 3, 8)
    arm.load_into(&mut code, index, 1)
    arm.compare_register(&mut code, 1, 2)
    arm.branch(&mut code, done, 2)
    arm.transfer(&mut code, true, 0, 0, 3, 0)
    arm.integer_binary(&mut code, 1, true, false, 2, 0, 1, -1)
    arm.transfer(&mut code, true, 0, 2, 0, 0)
    arm.bitfield(&mut code, false, true, 0, 0, 6, 7)
    arm.compare_immediate(&mut code, 0, 2, false)
    arm.set_condition(&mut code, 0, 0)
    arm.source_edge(&mut code, unicode, .WhenTrue, source_offset)
    arm.mark(&mut code, done)
}

pub fn emit_str_slice(code: &mut arm.Code, source: i32, first: i32, last: i32, data_home: i32,
    bounds: i32, unicode: i32, source_offset: i32) {
    assert(source >= 0 && source < 65535 && first >= 0 && first < 65535 && last >= 0 && last < 65535)
    assert(data_home >= 5 && data_home < 65535)
    assert(source != first && source != last && outside(source, data_home) && outside(first, data_home) && outside(last, data_home))
    assert(bounds >= 0 && bounds < arm.label_count(&code) && unicode >= 0 && unicode < arm.label_count(&code) && source_offset >= 0)

    arm.load(&mut code, source)
    arm.transfer(&mut code, true, 2, 0, 3, 8)
    arm.integer_binary(&mut code, 1, true, false, 2, 2, -1, 1)
    arm.load_into(&mut code, last, 1)
    arm.compare_register(&mut code, 1, 2)
    arm.source_edge(&mut code, bounds, .Bounds, source_offset)
    arm.integer_binary(&mut code, 1, true, false, 2, 1, -1, 1)
    arm.load(&mut code, first)
    arm.compare_register(&mut code, 0, 2)
    arm.source_edge(&mut code, bounds, .Bounds, source_offset)

    boundary_view(&mut code, source, first, unicode, source_offset)
    boundary_view(&mut code, source, last, unicode, source_offset)

    arm.load(&mut code, source)
    arm.transfer(&mut code, true, 0, 0, 3, 0)
    arm.load_into(&mut code, first, 1)
    arm.integer_binary(&mut code, 1, true, false, 0, 0, 1, -1)
    arm.store(&mut code, data_home, 0)
    arm.load(&mut code, last); arm.load_into(&mut code, first, 1)
    arm.integer_binary(&mut code, 2, true, false, 0, 0, 1, -1)
    arm.store(&mut code, data_home - 1, 0); arm.store(&mut code, data_home - 2, 0)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, data_home - 3, 0)
    arm.store(&mut code, data_home - 4, 31); arm.store(&mut code, data_home - 5, 31)
    arm.address(&mut code, data_home)
}

pub fn emit_string_bytes(code: &mut arm.Code, source: i32, data_home: i32) {
    assert(source >= 0 && source < 65535 && data_home >= 5 && data_home < 65535 && outside(source, data_home))
    arm.load(&mut code, source)
    arm.integer_binary(&mut code, 1, true, false, 0, 0, -1, 8)
    arm.store(&mut code, data_home, 0)
    arm.load(&mut code, source)
    arm.transfer(&mut code, true, 0, 0, 3, 0)
    arm.store(&mut code, data_home - 1, 0)
    arm.store(&mut code, data_home - 2, 0)
    arm.imm(&mut code, 0, 0)
    arm.store(&mut code, data_home - 3, 0)
    arm.store(&mut code, data_home - 4, 31)
    arm.store(&mut code, data_home - 5, 31)
    arm.address(&mut code, data_home)
}
