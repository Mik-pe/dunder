pub enum Op { Field, CheckIndex, Element, Read, Write, BorrowHome, BorrowSaved, BorrowPayload, LocalRead, LocalWrite, CopySetup, CopyTest, CopyPart, RegionWrite, Member, Temporary }
pub enum Temporary { SaveAddress, SaveIndex, LoadIndex }
pub enum Member { Initialize, Payload, Length, Capacity, ClearLength, Tag, TagWrite }
pub fn member_write(form: i32) -> bool { form == i32(Member.Initialize) || form == i32(Member.ClearLength) || form == i32(Member.TagWrite) }
pub fn tag(op: Op) -> i32 { if op == .Temporary { return 123 }; 80 + i32(op) }
pub fn head(cell: i64) -> bool { k := i32(cell.shr(56)); k >= 80 && k <= 94 }
pub fn detail(cell: i64) -> bool { i32(cell.shr(56)) == 95 && cell.bit_and(2147483648) == 0 }
pub fn header(op: Op, ty: i32, access: i32, form: i32) -> i64 {
    i64(tag(op)).shl(56).bit_or(i64(access).shl(50)).bit_or(i64(form).shl(32)).bit_or(i64(ty))
}
pub fn location(parameter: i32, source: i32) -> i64 {
    i64(95).shl(56).bit_or(i64(parameter).shl(32)).bit_or(i64(source))
}
pub fn valid(k: i32, form: i32, parameter: i32) -> bool {
    if form < 0 || parameter < 0 { return false }
    if k == tag(.Temporary) { return form == 0 && parameter < 65535 }
    if k == tag(.CopySetup) { return form <= 1 && parameter <= places.max_parameter() }
    if k == tag(.CopyTest) { return form <= 1 && parameter == 0 }
    if k == tag(.CopyPart) { return (form == 0 && parameter == 1) || (form > 0 && form <= 5 && parameter > 0 && parameter <= 8) }
    if k == tag(.RegionWrite) { return form == 0 && parameter <= 65536 }
    if k == tag(.Member) {
        if form == i32(Member.Length) { return parameter <= 1 }
        if form == i32(Member.Capacity) { return parameter == 2 }
        if form == i32(Member.ClearLength) { return parameter == 1 }
        if form == i32(Member.Tag) || form == i32(Member.TagWrite) { return parameter == 0 }
        return (form == i32(Member.Initialize) || form == i32(Member.Payload)) && parameter < 65536
    }
    if k == tag(.Field) { return form == 0 && parameter <= places.max_parameter() }
    if k == tag(.CheckIndex) { return form <= 1 && parameter == 0 }
    if k == tag(.Element) {
        return (form == 0 && parameter == 0) || (form == 1 && parameter <= 16) ||
            (form == 2 && parameter > 0 && parameter <= places.max_parameter())
    }
    if k == tag(.Read) || k == tag(.Write) { return form <= 4 && parameter <= 1023 && parameter / 32 < 31 && parameter % 32 < 31 }
    if k == tag(.BorrowPayload) { return form == 0 && parameter == 0 }
    if k == tag(.BorrowHome) || k == tag(.BorrowSaved) || k == tag(.LocalWrite) {
        return form == 0 && parameter < 65535
    }
    k == tag(.LocalRead) && form <= 4 && parameter < 65535
}
pub fn form(cell: i64) -> i32 { i32(cell.shr(32).bit_and(262143)) }
pub fn access(cell: i64) -> i32 { i32(cell.shr(50).bit_and(63)) }
pub fn parameter(cell: i64) -> i32 { i32(cell.shr(32).bit_and(16777215)) }
pub fn pair(h: i64, d: i64) -> bool {
    head(h) && detail(d) && h.bit_and(2147483648) == 0 && access(h) <= 4 &&
        valid(i32(h.shr(56)), form(h), parameter(d))
}

pub fn bound(h: i64) -> bool { (head(h) || i32(h.shr(56)) == 123) && h.bit_and(i64(1).shl(55)) != 0 }
pub fn wide(h: i64) -> bool { h.bit_and(i64(1).shl(54)) != 0 }
pub fn local_ref(h: i64) -> bool { h.bit_and(i64(1).shl(53)) != 0 }
pub fn bound_access(h: i64) -> i32 { i32(h.shr(50).bit_and(7)) }
pub fn bound_id(h: i64) -> i32 {
    if wide(h) { return i32(h.bit_and(2147483647)) }; i32(h.shr(31).bit_and(524287))
}
pub fn bound_header(op: Op, id: i32, access: i32, source: i32) -> i64 {
    mut h := i64(tag(op)).shl(56).bit_or(i64(1).shl(55)).bit_or(i64(access).shl(50))
    mut index := id - 1
    if id < 0 { h = h.bit_or(i64(1).shl(53)); index = -(id + 1) }
    if index > 524287 { return h.bit_or(i64(1).shl(54)).bit_or(i64(index)) }
    h.bit_or(i64(index).shl(31)).bit_or(i64(source))
}

import typed_places as places
pub fn resolve(h: i64, source: i32, g: &places.Arena, l: i32, le: i32, n: i32, ne: i32,
    operation: &mut i64, origin: &mut i64) -> bool {
    id := bound_id(h); access := bound_access(h); k := i32(h.shr(56)); local := local_ref(h)
    if access > 4 || (wide(h) && h.shr(31).bit_and(524287) != 0) { return false }
    mut ty := 0; mut parameter := 0; mut form := 0
    if local {
        if id >= le - l { return false }
        cell := g.locals[l + id]; ty = places.local_type(cell); parameter = places.local_home(cell)
        if k == tag(.LocalRead) || k == tag(.LocalWrite) || k == tag(.BorrowHome) {
            if places.deref(cell) != 0 { return false }
            if k == tag(.LocalRead) { form = places.local_shape(cell) }
        } else if k == tag(.Read) || k == tag(.BorrowSaved) {
            if places.deref(cell) == 0 { return false }
            if k == tag(.Read) { parameter = 0; form = places.local_shape(cell) }
        } else { return false }
    } else {
        if id >= (ne - n) / 3 { return false }
        row := n + id * 3; layout := places.storage(g.nodes[row + 2]); kind := places.kind(layout)
        ty = i32(g.nodes[row + 1].bit_and(2147483647))
        if k == tag(.Temporary) || k == tag(.BorrowHome) || k == tag(.BorrowSaved) {
            parameter = places.address(g.nodes[row])
            if k == tag(.Temporary) && access != i32(Temporary.SaveAddress) {
                if kind == i32(places.Projection.Field) || access > i32(Temporary.LoadIndex) { return false }
                parameter = places.selector(g.nodes[row]) - 1; ty = 1
            }
        } else if k == tag(.Field) {
            if kind != i32(places.Projection.Field) { return false }
            parameter = places.parameter(layout)
        } else if k == tag(.CheckIndex) || k == tag(.Element) {
            if kind == i32(places.Projection.Field) { return false }
            if k == tag(.CheckIndex) {
                ty = places.receiver(g.nodes[row + 1]); if kind != i32(places.Projection.TextIndex) { form = 1 }
            } else {
                form = kind - 1; parameter = places.parameter(layout)
            }
        } else if k == tag(.Read) || k == tag(.Write) {
            form = places.shape(layout)
            if k == tag(.Write) { parameter = 1; if form == 4 { form = 2 } }
        } else { return false }
    }
    if !valid(k, form, parameter) { return false }
    operation = i64(k).shl(56).bit_or(i64(access).shl(50)).bit_or(i64(form).shl(32)).bit_or(i64(ty))
    origin = location(parameter, source); true
}
