import ownership_state as ownership

pub opaque struct Table {
    paths: []i32, roots: []i32, origins: []i32, tokens: []i32,
    scope_ends: []i32, loop_depths: []i32, pinned: []bool,
    positions: []i32, active: []i32,
}
pub fn new() -> Table {
    Table { paths: [], roots: [], origins: [], tokens: [], scope_ends: [], loop_depths: [], pinned: [], positions: [], active: [] }
}
pub fn clear(t: &mut Table) {
    t.paths.clear(); t.roots.clear(); t.origins.clear(); t.tokens.clear()
    t.scope_ends.clear(); t.loop_depths.clear(); t.pinned.clear()
    t.positions.clear(); t.active.clear()
}
pub fn add_local(t: &mut Table, local: i32) {
    assert(local == t.paths.len)
    t.paths.push(-1); t.roots.push(-1); t.origins.push(-1); t.tokens.push(-1)
    t.scope_ends.push(-1); t.loop_depths.push(-1); t.pinned.push(false)
    t.positions.push(-1)
}
pub fn bind_shared_scoped(t: &mut Table, local: i32, path: i32, root: i32, origin: i32, token: i32, scope_end: i32, loop_depth: i32) {
    assert(local >= 0 && local < t.paths.len && t.paths[local] < 0)
    assert(path >= 0 && root >= 0 && token >= 0 && (origin >= 0 || origin == -3 || origin == -2))
    t.paths[local] = path; t.roots[local] = root; t.origins[local] = origin; t.tokens[local] = token
    t.scope_ends[local] = scope_end; t.loop_depths[local] = loop_depth; t.pinned[local] = false
    t.positions[local] = t.active.len; t.active.push(local)
}
pub fn bind_shared(t: &mut Table, local: i32, path: i32, root: i32, origin: i32, token: i32) {
    bind_shared_scoped(&mut t, local, path, root, origin, token, -1, -1)
}
pub fn transient(t: &mut Table, local: i32, path: i32, root: i32, origin: i32) {
    t.paths[local] = path; t.roots[local] = root; t.origins[local] = origin
    t.positions[local] = -2
}
pub fn is_transient(t: &Table, local: i32) -> bool {
    local >= 0 && local < t.positions.len && t.positions[local] == -2
}
pub fn shared(t: &Table, local: i32) -> bool {
    local >= 0 && local < t.paths.len && (t.paths[local] >= 0 || t.positions[local] == -2)
}
pub fn path(t: &Table, local: i32) -> i32 {
    if local < 0 || local >= t.paths.len { return -1 }
    t.paths[local]
}
pub fn root(t: &Table, local: i32) -> i32 {
    if local < 0 || local >= t.roots.len { return -1 }
    t.roots[local]
}
pub fn origin(t: &Table, local: i32) -> i32 {
    if local < 0 || local >= t.origins.len { return -1 }
    t.origins[local]
}
pub fn release_local(t: &mut Table, local: i32) {
    assert(local >= 0 && local < t.paths.len)
    position := t.positions[local]
    if position < 0 { return }
    last := t.active.pop()
    if position < t.active.len { t.active[position] = last; t.positions[last] = position }
    t.positions[local] = -1
}
pub fn pin(t: &mut Table, local: i32) {
    if local >= 0 && local < t.pinned.len { t.pinned[local] = true }
}
pub fn is_pinned(t: &Table, local: i32) -> bool {
    local >= 0 && local < t.pinned.len && t.pinned[local]
}
pub fn scope_end(t: &Table, local: i32) -> i32 {
    if local < 0 || local >= t.scope_ends.len { return -1 }
    t.scope_ends[local]
}
pub fn loop_depth(t: &Table, local: i32) -> i32 {
    if local < 0 || local >= t.loop_depths.len { return -1 }
    t.loop_depths[local]
}
pub fn active_conflict_local(t: &Table, state: &ownership.State, path: i32) -> i32 {
    if path < 0 { return -1 }
    for local in &t.active {
        if ownership.overlaps(&state, t.paths[local], path) { return local }
    }
    -1
}
pub fn conflict(t: &Table, state: &ownership.State, path: i32) -> i32 {
    local := active_conflict_local(&t, &state, path)
    if local < 0 { return -1 }
    t.tokens[local]
}

@test fn field_loans_conflict_with_their_ancestors_but_allow_siblings() {
    mut state := ownership.new(); ownership.add(&mut state, 0)
    left := ownership.project(&mut state, 0, 0); right := ownership.project(&mut state, 0, 1)
    nested := ownership.project(&mut state, left, 0)
    ownership.add(&mut state, 1); other := ownership.root_id(&state, 1)
    mut table := new(); for local in 0..3 { add_local(&mut table, local) }
    bind_shared(&mut table, 2, nested, 0, -3, 10)
    assert(path(&table, 2) == nested && root(&table, 2) == 0 && origin(&table, 2) == -3)
    assert(conflict(&table, &state, nested) == 10 && conflict(&table, &state, left) == 10)
    assert(conflict(&table, &state, 0) == 10 && conflict(&table, &state, right) == -1)
    assert(conflict(&table, &state, other) == -1 && conflict(&table, &state, -1) == -1)
    assert(path(&table, 0) == -1 && root(&table, 0) == -1 && origin(&table, 0) == -1)
}
@test fn releasing_an_alias_keeps_a_derived_loan_and_its_original_provenance() {
    mut state := ownership.new(); ownership.add(&mut state, 0)
    array := ownership.project(&mut state, 0, 0)
    mut table := new(); for local in 0..4 { add_local(&mut table, local) }
    bind_shared(&mut table, 1, array, 0, 7, 20)
    bind_shared(&mut table, 2, path(&table, 1), root(&table, 1), origin(&table, 1), 21)
    assert(conflict(&table, &state, array) == 20)
    release_local(&mut table, 1)
    assert(conflict(&table, &state, array) == 21)
    assert(path(&table, 1) == array && origin(&table, 1) == 7)
    release_local(&mut table, 2); release_local(&mut table, 2); release_local(&mut table, 3)
    assert(conflict(&table, &state, 0) == -1 && path(&table, 2) == array)
}
@test fn releasing_out_of_order_loans_keeps_the_active_index_consistent() {
    mut state := ownership.new(); ownership.add(&mut state, 0)
    left := ownership.project(&mut state, 0, 0); right := ownership.project(&mut state, 0, 1)
    mut table := new(); for local in 0..4 { add_local(&mut table, local) }
    bind_shared(&mut table, 1, left, 0, -2, 30)
    bind_shared(&mut table, 2, right, 0, -3, 31)
    bind_shared(&mut table, 3, left, 0, -2, 32)
    release_local(&mut table, 1)
    assert(conflict(&table, &state, left) == 32 && conflict(&table, &state, right) == 31)
    release_local(&mut table, 3)
    assert(conflict(&table, &state, left) == -1 && conflict(&table, &state, right) == 31)
    release_local(&mut table, 2); assert(conflict(&table, &state, 0) == -1)
}
@test fn reset_discards_alias_metadata_and_reuses_local_ordinals() {
    mut state := ownership.new(); ownership.add(&mut state, 0)
    mut table := new(); add_local(&mut table, 0); add_local(&mut table, 1)
    bind_shared(&mut table, 1, 0, 0, -3, 40)
    assert(conflict(&table, &state, 0) == 40)
    clear(&mut table)
    assert(path(&table, 1) == -1 && root(&table, -1) == -1 && origin(&table, 0) == -1)
    assert(conflict(&table, &state, 0) == -1)
    add_local(&mut table, 0); add_local(&mut table, 1)
    bind_shared_scoped(&mut table, 1, 0, 0, -2, 41, 90, 2)
    assert(conflict(&table, &state, 0) == 41 && origin(&table, 1) == -2)
    assert(active_conflict_local(&table, &state, 0) == 1 && scope_end(&table, 1) == 90 && loop_depth(&table, 1) == 2 && !is_pinned(&table, 1))
    pin(&mut table, 1)
    assert(is_pinned(&table, 1))
}
