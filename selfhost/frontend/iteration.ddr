// Source iteration lowers with a known element type and container kind. The
// UTF-8 operations run only at scalar boundaries of a retained valid string.
import ..backend.arm64 as arm
import ..backend.backend_row as row

pub enum Kind { Range, Array, Fixed, Bytes, Runes }
pub enum Step { Test, Advance, PackRange, RangeStart, RangeLimit, RuneLead, RuneTwo, RuneThree, RuneFour, RuneTail }

pub fn valid(step: i32, kind: i32, element: i32) -> bool {
    if kind < 0 || kind > i32(Kind.Runes) || element <= 0 { return false }
    if (kind == i32(Kind.Range) || kind == i32(Kind.Bytes)) && element != 1 { return false }
    if kind == i32(Kind.Runes) && element != 5 { return false }
    if step == i32(Step.Test) { return true }
    if step == i32(Step.Advance) { return kind != i32(Kind.Runes) }
    if step >= i32(Step.PackRange) && step <= i32(Step.RangeLimit) { return kind == i32(Kind.Range) }
    kind == i32(Kind.Runes) && step >= i32(Step.RuneLead) && step <= i32(Step.RuneTail)
}
pub fn pair(h: i64, source: i64) -> bool {
    row.kind(h) == 99 && row.source_cell(source) && h.bit_and(63050394783186944) == 0 &&
        h.bit_and(2147483648) == 0 && valid(row.reg(h), i32(row.operand(h).shr(32)), i32(h.bit_and(2147483647)))
}
pub fn emit(code: &mut arm.Code, step: Step, kind: Kind, element: i32, source: i32) {
    if code.mir_capture || code.prefixing {
        arm.operand(&mut code, i64(99).shl(56).bit_or(i64(i32(step)).shl(48)).bit_or(i64(i32(kind)).shl(32)).bit_or(i64(element)))
        arm.operand(&mut code, row.source(source))
    } else { lower(&mut code, i32(step)) }
}
pub fn lower(code: &mut arm.Code, step: i32) {
    if step == i32(Step.Test) { arm.compare_register(&mut code, 1, 0) }
    else if step == i32(Step.Advance) { arm.integer_binary(&mut code, 1, true, false, 0, 0, -1, 1) }
    else if step == i32(Step.PackRange) {
        arm.emit(&mut code, 704709601); arm.emit(&mut code, 2852159520)
    } else if step == i32(Step.RangeStart) { arm.sign_extend_i32(&mut code, 0, 0) }
    else if step == i32(Step.RangeLimit) { arm.bitfield(&mut code, true, true, 0, 1, 32, 63) }
    else if step == i32(Step.RuneLead) {
        arm.add_scaled(&mut code, 10, 0, 1, 0); arm.integer_binary(&mut code, 1, true, false, 10, 10, -1, 8)
        arm.emit(&mut code, 960495616 + 10 * 32)
        arm.integer_binary(&mut code, 1, true, false, 10, 10, -1, 1)
        arm.integer_binary(&mut code, 1, true, false, 1, 1, -1, 1)
    } else if step == i32(Step.RuneTail) {
        arm.bitfield(&mut code, false, true, 0, 0, 58, 57)
        arm.emit(&mut code, 960495616 + 10 * 32 + 12); arm.integer_binary(&mut code, 2, true, false, 12, 12, -1, 128)
        arm.add_scaled(&mut code, 0, 0, 12, 0); arm.integer_binary(&mut code, 1, true, false, 10, 10, -1, 1)
        arm.integer_binary(&mut code, 1, true, false, 1, 1, -1, 1)
        arm.integer_binary(&mut code, 2, true, false, 11, 11, -1, 1)
    } else {
        mut prefix: i64 = 192; mut tail: i64 = 1
        if step == i32(Step.RuneThree) { prefix = 224; tail = 2 }
        if step == i32(Step.RuneFour) { prefix = 240; tail = 3 }
        arm.integer_binary(&mut code, 2, true, false, 0, 0, -1, prefix); arm.imm(&mut code, 11, tail)
    }
}
pub fn rune(code: &mut arm.Code, source: i32) {
    emit(&mut code, .RuneLead, .Runes, 5, source)
    done := arm.label(&mut code); three := arm.label(&mut code); four := arm.label(&mut code); decode := arm.label(&mut code)
    arm.compare_immediate(&mut code, 0, 128, false); arm.branch(&mut code, done, 5)
    arm.compare_immediate(&mut code, 0, 224, false); arm.branch(&mut code, three, 4)
    emit(&mut code, .RuneTwo, .Runes, 5, source); arm.branch(&mut code, decode, 0)
    arm.mark(&mut code, three); arm.compare_immediate(&mut code, 0, 240, false); arm.branch(&mut code, four, 4)
    emit(&mut code, .RuneThree, .Runes, 5, source); arm.branch(&mut code, decode, 0)
    arm.mark(&mut code, four); emit(&mut code, .RuneFour, .Runes, 5, source)
    arm.mark(&mut code, decode); emit(&mut code, .RuneTail, .Runes, 5, source)
    arm.compare_immediate(&mut code, 11, 0, false); arm.branch(&mut code, decode, 3)
    arm.mark(&mut code, done)
}
