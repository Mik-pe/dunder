import lexer
import std.hash as hashing

// Occupied slots hold function IDs. Their keys live in World.impl_types and World.impl_names.
pub opaque struct MethodIndex { slots: []i32, count: i32 }
impl Sendable for MethodIndex {}

pub struct World {
    tokens: lexer.Tokens, closes: []i32, test_functions: []bool, unsafe_capable: bool,
    source_end: i32, param_tokens: []i32, functions: Map<string, i64>,
    methods: MethodIndex,
    names: []string, starts: []i32,
    ends: []i32, returns: []i32, return_fields: []i32, param_starts: []i32, param_counts: []i32,
    param_names: []string, param_types: []i32, param_mutable: []bool, libraries: []string, symbols: []string,
    unsafe_functions: []bool, thread_safe: []bool, function_owners: []i32, ffi_types: []i32,
    impl_types: []i32, impl_public: []bool, impl_has_self: []bool, impl_self_mut: []bool,
    impl_names: []string, requires_caps: []i32, module_caps: []i32,
    const_map: Map<string, i64>, const_names: []string, const_types: []i32, const_kinds: []i32,
    const_ints: []i64, const_strings: []string, const_blob_starts: []i32, const_blob_counts: []i32, const_blobs: []u8,
    embed_blob_starts: []i32, embed_blob_counts: []i32, embed_blobs: []u8,
}

pub fn new() -> World {
    World {
        tokens: lexer.empty(false), closes: [], test_functions: [], unsafe_capable: false,
        source_end: 0, param_tokens: [], functions: Map<string, i64>::new(),
        methods: MethodIndex { slots: [], count: 0 },
        names: [], starts: [], ends: [],
        returns: [], return_fields: [], param_starts: [], param_counts: [], param_names: [], param_types: [], param_mutable: [],
        libraries: [], symbols: [], unsafe_functions: [], thread_safe: [], function_owners: [], ffi_types: [],
        impl_types: [], impl_public: [], impl_has_self: [], impl_self_mut: [],
        impl_names: [], requires_caps: [], module_caps: [],
        const_map: Map<string, i64>::new(), const_names: [], const_types: [], const_kinds: [],
        const_ints: [], const_strings: [], const_blob_starts: [], const_blob_counts: [], const_blobs: [],
        embed_blob_starts: [], embed_blob_counts: [], embed_blobs: [],
    }
}

fn method_slot(w: &World, slots: &[]i32, ty: i32, name: string) -> i32 {
    mask := slots.len - 1
    hash := (i64(ty) * 1000003).bit_xor(hashing.hash(name))
    mut slot := i32(hash.bit_and(i64(mask)))
    while slots[slot] >= 0 {
        f := slots[slot]
        if w.impl_types[f] == ty && w.impl_names[f] == name { break }
        slot = (slot + 1).bit_and(mask)
    }
    slot
}

fn grow_methods(w: &mut World) {
    capacity := if w.methods.slots.len == 0 { 8 } else { w.methods.slots.len * 2 }
    mut slots: []i32 = []
    slots.reserve(capacity)
    for _ in 0..capacity { slots.push(-1) }
    for f in &w.methods.slots {
        if f < 0 { continue }
        slot := method_slot(&w, &slots, w.impl_types[f], w.impl_names[f])
        slots[slot] = f
    }
    w.methods.slots = move slots
}

pub fn find_method(w: &World, ty: i32, name: string) -> i32 {
    if ty < 0 || w.methods.count == 0 { return -1 }
    slot := method_slot(&w, &w.methods.slots, ty, name)
    w.methods.slots[slot]
}

pub fn register_method(w: &mut World, f: i32) -> bool {
    if (i64(w.methods.count) + 1) * 10 >= i64(w.methods.slots.len) * 7 { grow_methods(&mut w) }
    slot := method_slot(&w, &w.methods.slots, w.impl_types[f], w.impl_names[f])
    if w.methods.slots[slot] >= 0 { return false }
    w.methods.slots[slot] = f
    w.methods.count += 1
    true
}

@test fn method_lookup_keeps_function_ids_across_collisions_and_growth() {
    mut world := new()
    assert(find_method(&world, 0, "read") == -1)
    for i in 0..32 {
        // The receivers share their low hash bits. Each has both method names.
        for name in ["read", "write"] {
            f := world.impl_types.len
            world.impl_types.push(i * 256); world.impl_names.push(name.clone())
            assert(register_method(&mut world, f))
        }
    }
    world.impl_types.push(0); world.impl_names.push("read")
    assert(!register_method(&mut world, world.impl_types.len - 1))
    for i in 0..32 {
        assert(find_method(&world, i * 256, "read") == i * 2)
        assert(find_method(&world, i * 256, "write") == i * 2 + 1)
    }
    assert(find_method(&world, 1, "read") == -1 && find_method(&world, 0, "missing") == -1)
}
