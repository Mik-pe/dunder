import function_locals as locals
import lexer

fn flag(value: bool) -> i32 { if value { 1 } else { 0 } }

pub fn target_match(platform: i32, name: string) -> i32 {
    if name == "macos" || name == "arm64-macos" || name == "aarch64-apple-darwin" { return flag(platform == 0) }
    if name == "linux" { return flag(platform == 1 || platform == 2) }
    if name == "arm64-linux" || name == "aarch64-unknown-linux-gnu" { return flag(platform == 1) }
    if name == "x86_64" { return flag(platform == 2 || platform == 5) }
    if name == "x86_64-linux" || name == "x86_64-unknown-linux-gnu" { return flag(platform == 2) }
    if name == "windows" || name == "x86_64-windows" || name == "x86_64-pc-windows-msvc" { return flag(platform == 5) }
    if name == "arm64" { return flag(platform == 0 || platform == 1) }
    if name == "native" { return flag(platform != 3 && platform != 4) }
    if name == "wasm32" { return flag(platform == 3 || platform == 4) }
    if name == "wasm32-unknown-unknown" { return flag(platform == 3) }
    if name == "wasi" || name == "wasm32-wasi" || name == "wasm32-wasip1" { return flag(platform == 4) }
    -1
}

pub fn tok_is(tokens: &lexer.Tokens, pos: i32, text: string) -> bool {
    pos >= 0 && pos < tokens.kinds.len && tokens.kinds[pos] != .String && tokens.kinds[pos] != .Rune && tokens.kinds[pos] != .Byte && tokens.texts[pos] == text
}

fn skip_newlines(tokens: &lexer.Tokens, pos: i32) -> i32 {
    mut i := pos
    while i < tokens.kinds.len && lexer.is_newline(tokens.kinds[i]) { i += 1 }
    i
}

fn eval_target_atom(tokens: &lexer.Tokens, locals_table: &locals.Table, platform: i32, pos: i32, end: &mut i32) -> i32 {
    if tok_is(&tokens, pos, "!") {
        inner := eval_target_atom(&tokens, &locals_table, platform, pos + 1, &mut end)
        if inner < 0 { return -1 }
        return 1 - inner
    }
    if tok_is(&tokens, pos, "(") {
        inner := eval_target_or(&tokens, &locals_table, platform, skip_newlines(&tokens, pos + 1), &mut end)
        closed := skip_newlines(&tokens, end)
        if inner < 0 || !tok_is(&tokens, closed, ")") { return -1 }
        end = closed + 1
        return inner
    }
    if pos + 3 < tokens.kinds.len && tokens.kinds[pos] == .Name && tokens.texts[pos] == "target_is" && locals.resolve(&locals_table, "target_is") < 0 && tok_is(&tokens, pos + 1, "(") && tokens.kinds[pos + 2] == .String && tok_is(&tokens, pos + 3, ")") {
        v := target_match(platform, tokens.texts[pos + 2])
        if v < 0 { return -1 }
        end = pos + 4
        return v
    }
    -1
}

fn eval_target_and(tokens: &lexer.Tokens, locals_table: &locals.Table, platform: i32, pos: i32, end: &mut i32) -> i32 {
    mut v := eval_target_atom(&tokens, &locals_table, platform, pos, &mut end)
    if v < 0 { return -1 }
    while tok_is(&tokens, end, "&&") {
        mut right_end := 0
        rhs := eval_target_atom(&tokens, &locals_table, platform, skip_newlines(&tokens, end + 1), &mut right_end)
        if rhs < 0 { return -1 }
        if rhs == 0 { v = 0 }
        end = right_end
    }
    v
}

pub fn eval_target_or(tokens: &lexer.Tokens, locals_table: &locals.Table, platform: i32, pos: i32, end: &mut i32) -> i32 {
    mut v := eval_target_and(&tokens, &locals_table, platform, pos, &mut end)
    if v < 0 { return -1 }
    while tok_is(&tokens, end, "||") {
        mut right_end := 0
        rhs := eval_target_and(&tokens, &locals_table, platform, skip_newlines(&tokens, end + 1), &mut right_end)
        if rhs < 0 { return -1 }
        if rhs == 1 { v = 1 }
        end = right_end
    }
    v
}
