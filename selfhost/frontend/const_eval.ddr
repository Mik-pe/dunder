import ...stdlib.parse.decimal as decimal
import scalar_rules as rules
import declarations as decl
import frontend_types as ft
import lexer
import source_diagnostics as diagnostics
import std.parse as parse
import token_lookahead as lookahead

pub struct ConstVal {
    ok: bool,
    kind: i32,
    ty: i32,
    int_val: i64,
    str_val: string,
    arr_elem: i32,
    arr_ints: []i64,
    embed_blob: i32,
    error: string,
    error_tok: i32,
    need_const: i32,
}

pub fn empty_val() -> ConstVal {
    ConstVal {
        ok: false, kind: 0, ty: 0, int_val: 0, str_val: "",
        arr_elem: 0, arr_ints: [], embed_blob: -1, error: "", error_tok: -1, need_const: -1,
    }
}

pub fn const_fail(tok: i32, msg: string) -> ConstVal {
    ConstVal {
        ok: false, kind: 0, ty: 0, int_val: 0, str_val: "",
        arr_elem: 0, arr_ints: [], embed_blob: -1, error: msg.clone(), error_tok: tok, need_const: -1,
    }
}

fn const_need(other: i32, tok: i32) -> ConstVal {
    ConstVal {
        ok: false, kind: 0, ty: 0, int_val: 0, str_val: "",
        arr_elem: 0, arr_ints: [], embed_blob: -1, error: "", error_tok: tok, need_const: other,
    }
}

pub fn const_ok_int(ty: i32, value: i64) -> ConstVal {
    ConstVal {
        ok: true, kind: 0, ty: ty, int_val: value, str_val: "",
        arr_elem: 0, arr_ints: [], embed_blob: -1, error: "", error_tok: -1, need_const: -1,
    }
}

pub fn const_ok_str(value: string) -> ConstVal {
    ConstVal {
        ok: true, kind: 1, ty: 4, int_val: 0, str_val: value.clone(),
        arr_elem: 0, arr_ints: [], embed_blob: -1, error: "", error_tok: -1, need_const: -1,
    }
}

pub fn const_ok_arr(ty: i32, elem: i32, move ints: []i64) -> ConstVal {
    ConstVal {
        ok: true, kind: 2, ty: ty, int_val: i64(ints.len), str_val: "",
        arr_elem: elem, arr_ints: move ints, embed_blob: -1, error: "", error_tok: -1, need_const: -1,
    }
}

fn is_float(ty: i32) -> bool { ty == 6 || ty == 7 }
fn is_unsigned(ty: i32) -> bool { ty >= 8 && ty <= 12 }

fn unsigned_maximum(ty: i32) -> i64 {
    if ty == 8 { return 255 }
    if ty == 9 { return 65535 }
    if ty == 10 { return 4294967295 }
    -1
}

fn unsigned_width(ty: i32) -> i32 {
    if ty == 8 { return 8 }
    if ty == 9 { return 16 }
    if ty == 10 { return 32 }
    64
}

fn parse_radix_u64(text: string, begin: i32, radix: i32, ty: i32) -> parse.Integer {
    mut max_div: i64 = 1844674407370955161
    mut max_rem: i64 = 5
    if radix == 16 { max_div = 1152921504606846975; max_rem = 15 }
    else if radix == 2 { max_div = 9223372036854775807; max_rem = 1 }
    mut acc: i64 = 0
    mut previous := false
    for i in begin..text.len {
        byte := i32(text[i])
        if byte == 95 {
            if !previous { return parse.Integer { ok: false, value: 0, error: 1 } }
            previous = false
        } else {
            mut d := -1
            if radix == 10 {
                if byte >= 48 && byte <= 57 { d = byte - 48 }
            } else if radix == 16 {
                if byte >= 48 && byte <= 57 { d = byte - 48 }
                else if byte >= 65 && byte <= 70 { d = byte - 55 }
                else if byte >= 97 && byte <= 102 { d = byte - 87 }
            } else {
                if byte == 48 || byte == 49 { d = byte - 48 }
            }
            if d < 0 { return parse.Integer { ok: false, value: 0, error: 1 } }
            digit := i64(d)
            if acc < 0 || acc > max_div || (acc == max_div && digit > max_rem) {
                return parse.Integer { ok: false, value: 0, error: 2 }
            }
            acc = acc.wrapping_mul(i64(radix)).wrapping_add(digit)
            previous = true
        }
    }
    if !previous { return parse.Integer { ok: false, value: 0, error: 1 } }
    if unsigned_width(ty) < 64 && (acc < 0 || acc > unsigned_maximum(ty)) {
        return parse.Integer { ok: false, value: 0, error: 2 }
    }
    parse.Integer { ok: true, value: acc, error: 0 }
}

fn unsigned_literal(text: string, ty: i32) -> parse.Integer {
    if text.len >= 2 && text[0] == 48 {
        if text[1] == 120 || text[1] == 88 { return parse_radix_u64(text, 2, 16, ty) }
        if text[1] == 98 || text[1] == 66 { return parse_radix_u64(text, 2, 2, ty) }
    }
    parse_radix_u64(text, 0, 10, ty)
}

pub fn scalar_value_type(ty: i32) -> bool {
    rules.signed_integer(ty) || ty == 3 || ty == 5 || is_float(ty) || is_unsigned(ty)
}

pub fn int_type(ty: i32) -> bool {
    rules.signed_integer(ty) || is_unsigned(ty)
}

fn const_u64_lt(a: i64, b: i64) -> bool {
    if (a < 0) != (b < 0) { return b < 0 }
    a < b
}

fn const_u64_divmod(a: i64, b: i64, mod_op: bool) -> i64 {
    if a >= 0 && b >= 0 {
        if mod_op { return a % b }
        return a / b
    }
    if b < 0 {
        if const_u64_lt(a, b) {
            return if mod_op { a } else { 0 }
        }
        return if mod_op { a.wrapping_sub(b) } else { 1 }
    }
    mut q: i64 = 0
    mut r: i64 = 0
    mut i := 63
    while i >= 0 {
        bit := a.shr(i).bit_and(1)
        r = r.shl(1).bit_or(bit)
        if !const_u64_lt(r, b) {
            r = r.wrapping_sub(b)
            q = q.bit_or(i64(1).shl(i))
        }
        i = i - 1
    }
    if mod_op { r } else { q }
}

fn const_u64_mul_checked(a: i64, b: i64, overflow: &mut bool) -> i64 {
    if a == 0 || b == 0 { return 0 }
    mut acc: i64 = 0
    mut lhs := a
    mut rhs := b
    mut step := 0
    while rhs != 0 && step < 64 {
        if rhs.bit_and(1) != 0 {
            next := acc.wrapping_add(lhs)
            if const_u64_lt(next, acc) { overflow = true; return 0 }
            acc = next
        }
        rhs = rhs.shr(1).bit_and(9223372036854775807)
        if rhs != 0 {
            if lhs < 0 { overflow = true; return 0 }
            lhs = lhs.shl(1)
        }
        step = step + 1
    }
    if rhs != 0 { overflow = true }
    acc
}

pub fn expr_end(t: &lexer.Tokens, first: i32) -> i32 {
    mut at := first
    mut parens := 0; mut brackets := 0; mut braces := 0
    while at < t.kinds.len {
        kind := t.kinds[at]
        if kind == .End { break }
        if parens == 0 && brackets == 0 && braces == 0 {
            if lexer.is_newline(kind) || (kind == .Symbol && t.texts[at] == ";") { break }
        }
        if kind == .Symbol {
            word := &t.texts[at]
            if word == "(" { parens = parens + 1 }
            else if word == ")" { if parens == 0 { break }; parens = parens - 1 }
            else if word == "[" { brackets = brackets + 1 }
            else if word == "]" { if brackets == 0 { break }; brackets = brackets - 1 }
            else if word == "{" { braces = braces + 1 }
            else if word == "}" { if braces == 0 { break }; braces = braces - 1 }
        }
        at = at + 1
    }
    at
}

pub fn pre_eval(t: &lexer.Tokens, lengths: &Map<string, i64>, pos: &mut i32, end: i32, depth: i32) -> (bool, i64) {
    if depth > 64 { return (false, 0) }
    pre_const_add(&t, &lengths, &mut pos, end, depth)
}

fn pre_const_add(t: &lexer.Tokens, lengths: &Map<string, i64>, pos: &mut i32, end: i32, depth: i32) -> (bool, i64) {
    first := pre_const_mul(&t, &lengths, &mut pos, end, depth)
    if !first.0 { return first }
    mut acc := first.1
    while pos < end {
        op := &t.texts[pos]
        if t.kinds[pos] != .Symbol || (op != "+" && op != "-") { break }
        pos = pos + 1
        rhs := pre_const_mul(&t, &lengths, &mut pos, end, depth)
        if !rhs.0 { return rhs }
        if op == "+" {
            if (rhs.1 > 0 && acc > 9223372036854775807 - rhs.1) || (rhs.1 < 0 && acc < -9223372036854775807 - 1 - rhs.1) { return (false, 0) }
            acc = acc + rhs.1
        } else {
            if (rhs.1 < 0 && acc > 9223372036854775807 + rhs.1) || (rhs.1 > 0 && acc < -9223372036854775807 - 1 + rhs.1) { return (false, 0) }
            acc = acc - rhs.1
        }
    }
    (true, acc)
}

fn signed_product(a: i64, b: i64) -> (bool, i64) {
    if a == 0 { return (true, 0) }
    if a == -1 {
        if b == -9223372036854775808 { return (false, 0) }
        return (true, -b)
    }
    value := a.wrapping_mul(b)
    (value / a == b, value)
}

fn pre_const_mul(t: &lexer.Tokens, lengths: &Map<string, i64>, pos: &mut i32, end: i32, depth: i32) -> (bool, i64) {
    first := pre_const_atom(&t, &lengths, &mut pos, end, depth)
    if !first.0 { return first }
    mut acc := first.1
    while pos < end {
        op := &t.texts[pos]
        if t.kinds[pos] != .Symbol || (op != "*" && op != "/" && op != "%") { break }
        pos = pos + 1
        rhs := pre_const_atom(&t, &lengths, &mut pos, end, depth)
        if !rhs.0 { return rhs }
        if op == "*" {
            product := signed_product(acc, rhs.1)
            if !product.0 { return (false, 0) }
            acc = product.1
        } else {
            if rhs.1 == 0 || (acc == -9223372036854775808 && rhs.1 == -1) { return (false, 0) }
            if op == "/" { acc = acc / rhs.1 } else { acc = acc % rhs.1 }
        }
    }
    (true, acc)
}

fn pre_const_atom(t: &lexer.Tokens, lengths: &Map<string, i64>, pos: &mut i32, end: i32, depth: i32) -> (bool, i64) {
    if pos >= end { return (false, 0) }
    if t.kinds[pos] == .Symbol && t.texts[pos] == "-" {
        pos = pos + 1
        if pos < end && t.kinds[pos] == .Integer {
            p := rules.literal_integer("-" + t.texts[pos]); pos = pos + 1
            return (p.ok, p.value)
        }
        v := pre_const_atom(&t, &lengths, &mut pos, end, depth + 1)
        if !v.0 || v.1 == (-9223372036854775807 - 1) { return (false, 0) }
        return (true, -v.1)
    }
    if t.kinds[pos] == .Symbol && t.texts[pos] == "(" {
        pos = pos + 1
        v := pre_eval(&t, &lengths, &mut pos, end, depth + 1)
        if !v.0 || pos >= end || t.texts[pos] != ")" { return (false, 0) }
        pos = pos + 1; return v
    }
    if t.kinds[pos] == .Integer {
        p := rules.literal_integer(t.texts[pos]); pos = pos + 1
        return (p.ok, p.value)
    }
    if t.kinds[pos] == .Name {
        name := t.texts[pos].clone(); pos = pos + 1
        if pos < end && t.kinds[pos] == .Symbol && t.texts[pos] == "(" &&
        (name == "i16" || name == "i32" || name == "i64" || name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "usize") {
            pos = pos + 1
            v := pre_eval(&t, &lengths, &mut pos, end, depth + 1)
            if !v.0 || pos >= end || t.texts[pos] != ")" { return (false, 0) }
            pos = pos + 1; return v
        }
        if lengths.contains(name) { return (true, lengths.get_or(name, -1)) }
        return (false, 0)
    }
    (false, 0)
}

pub fn pre_register_int_consts(t: &lexer.Tokens, lengths: &mut Map<string, i64>) {
    mut depth := 0; mut parens := 0
    mut i := 0
    while i < t.kinds.len {
        if t.kinds[i] == .Symbol {
            w := &t.texts[i]
            if w == "{" { depth = depth + 1 }
            else if w == "}" { if depth > 0 { depth = depth - 1 } }
            else if w == "(" || w == "[" { parens = parens + 1 }
            else if (w == ")" || w == "]") && parens > 0 { parens = parens - 1 }
        }
        if depth == 0 && parens == 0 && t.kinds[i] == .Name && t.texts[i] == "const" &&
        i + 1 < t.kinds.len && t.kinds[i + 1] == .Name {
            cname := t.texts[i + 1].clone()
            mut j := i + 2
            while j < t.kinds.len && !lexer.is_newline(t.kinds[j]) && t.texts[j] != ";" && t.texts[j] != "=" { j = j + 1 }
            if j < t.kinds.len && t.texts[j] == "=" {
                expr_start := j + 1
                end_pos := expr_end(&t, expr_start)
                mut p := expr_start
                val := pre_eval(&t, &lengths, &mut p, end_pos, 0)
                if val.0 && p == end_pos && val.1 >= 0 && val.1 <= 1048576 {
                    lengths.put(move cname, val.1)
                }
                i = end_pos; continue
            }
        }
        i = i + 1
    }
}

fn check_int_range(platform: i32, ty: i32, v: i64, tok: i32) -> ConstVal {
    if ty == 1 {
        if v < -2147483648 || v > 2147483647 { return const_fail(tok, "constant integer out of i32 range") }
        return const_ok_int(1, v)
    }
    if ty == 16 {
        if v < -32768 || v > 32767 { return const_fail(tok, "constant integer out of i16 range") }
        return const_ok_int(ty, v)
    }
    if ty == 2 { return const_ok_int(2, v) }
    if is_unsigned(ty) {
        mut maxv := unsigned_maximum(ty)
        if ty == 12 && (platform == 3 || platform == 4) { maxv = 4294967295 }
        if maxv >= 0 && (v < 0 || v > maxv) { return const_fail(tok, "constant value out of unsigned range") }
        return const_ok_int(ty, v)
    }
    const_fail(tok, "invalid constant integer type")
}

fn f32_value(bits: i64) -> f32 {
    word := if bits >= 2147483648 { bits - 4294967296 } else { bits }
    f32.from_bits(i32(word))
}

fn float_to_integer(platform: i32, target: i32, input: f64, tok: i32) -> ConstVal {
    if !input.is_finite() { return const_fail(tok, "cannot convert non-finite float to integer in constant expression") }
    value := input.trunc()
    if is_unsigned(target) {
        if value < 0.0 || value >= 18446744073709551616.0 { return const_fail(tok, "constant value out of unsigned range") }
        if value >= 9223372036854775808.0 {
            bits := i64(value - 9223372036854775808.0).bit_or(-9223372036854775808)
            return check_int_range(platform, target, bits, tok)
        }
    } else if value < -9223372036854775808.0 || value >= 9223372036854775808.0 {
        return const_fail(tok, "constant float conversion out of signed integer range")
    }
    check_int_range(platform, target, i64(value), tok)
}

fn cast_value(platform: i32, target: i32, move src: ConstVal, tok: i32) -> ConstVal {
    if !src.ok { return src }
    if target == 5 {
        if src.ty == 5 { return src }
        if !int_type(src.ty) { return const_fail(tok, "integer conversion requires an integer") }
        if src.int_val < 0 || src.int_val > 1114111 || (src.int_val >= 55296 && src.int_val <= 57343) {
            return const_fail(tok, "constant rune value out of Unicode scalar range")
        }
        return const_ok_int(5, src.int_val)
    }
    if is_float(target) {
        if is_float(src.ty) {
            if src.ty == target { return src }
            if src.ty == 6 && target == 7 {
                d := f64(f32_value(src.int_val))
                return const_ok_int(7, d.to_bits())
            }
            if src.ty == 7 && target == 6 {
                f := f32(f64.from_bits(src.int_val))
                return const_ok_int(6, i64(f.to_bits()).bit_and(4294967295))
            }
        }
        if rules.signed_integer(src.ty) {
            if target == 6 { return const_ok_int(6, i64(f32(src.int_val).to_bits()).bit_and(4294967295)) }
            return const_ok_int(7, f64(src.int_val).to_bits())
        }
        if is_unsigned(src.ty) {
            mut value := u64(src.int_val.bit_and(9223372036854775807))
            if src.int_val < 0 { value = value.bit_or(9223372036854775808) }
            if target == 6 { return const_ok_int(6, i64(f32(value).to_bits()).bit_and(4294967295)) }
            return const_ok_int(7, f64(value).to_bits())
        }
        return const_fail(tok, "expected a numeric conversion")
    }
    if is_float(src.ty) {
        value := if src.ty == 6 { f64(f32_value(src.int_val)) } else { f64.from_bits(src.int_val) }
        return float_to_integer(platform, target, value, tok)
    }
    if !int_type(src.ty) && src.ty != 5 { return const_fail(tok, "integer conversion requires an integer") }
    if is_unsigned(src.ty) && src.int_val < 0 {
        if rules.signed_integer(target) { return const_fail(tok, "constant conversion out of signed integer range") }
        if target == 11 || (target == 12 && platform != 3 && platform != 4) { return const_ok_int(target, src.int_val) }
        return const_fail(tok, "constant value out of unsigned range")
    }
    if target == 11 || (target == 12 && platform != 3 && platform != 4) {
        if src.int_val < 0 { return const_fail(tok, "constant value out of unsigned range") }
        return const_ok_int(target, src.int_val)
    }
    check_int_range(platform, target, src.int_val, tok)
}

fn infer_array_default(t: &lexer.Tokens, first: i32) -> (i32, i32) {
    mut pos := first
    mut default_type := 1
    mut element := lookahead.IntegerElement { token: -1, end: -1, negative: false }
    while lookahead.integer_element(&t, pos, &mut element) {
        if default_type == 1 {
            mut spelling := t.texts[element.token].clone()
            if element.negative { spelling = "-" + spelling }
            mut number := rules.literal_integer(spelling)
            _ := rules.validate_signed(&mut number, 1)
            if !number.ok { default_type = 2 }
        }
        pos = element.end
        if t.texts[pos] != "," { break }
        pos += 1
    }
    (pos, default_type)
}

pub fn eval_expr(world: &decl.World, types: &ft.TypeRegistry, sources: &diagnostics.Sources,
    platform: i32, states: &[]i32, pos: &mut i32, end: i32, expected: i32) -> ConstVal {
    eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, expected, 0, 1, true)
}

fn literal_context(world: &decl.World, types: &ft.TypeRegistry, pos: i32, end: i32, expected: i32) -> i32 {
    if pos >= end || (expected != 0 && expected != 3) { return expected }
    first := world.tokens.kinds[pos]
    if first != .Integer && first != .Float && world.tokens.texts[pos] != "-" && world.tokens.texts[pos] != "(" { return expected }
    mut parens := 0
    mut decimal_seen := false
    for i in pos..end {
        kind := world.tokens.kinds[i]
        word := &world.tokens.texts[i]
        if kind == .Float { decimal_seen = true }
        else if kind == .Integer { continue }
        else if kind == .Name {
            ty := ft.type_id(&types, word)
            if int_type(ty) || is_float(ty) { return ty }
            id := i32(world.const_map.get_or(word, -1))
            if id >= 0 && id < world.const_types.len {
                named := world.const_types[id]
                if int_type(named) || is_float(named) { return named }
            }
            break
        } else if word == "(" { parens += 1 }
        else if word == ")" {
            if parens == 0 { break }
            parens -= 1
        } else if word != "+" && word != "-" && word != "*" && word != "/" && word != "%" { break }
    }
    if decimal_seen { 7 } else { expected }
}

fn eval_binary(world: &decl.World, types: &ft.TypeRegistry, sources: &diagnostics.Sources,
    platform: i32, states: &[]i32, pos: &mut i32, end: i32, expected: i32, depth: i32, minimum: i32, active: bool) -> ConstVal {
    if depth > 64 { return const_fail(pos, "constant expression nesting exceeds 64") }
    hint := literal_context(&world, &types, pos, end, expected)
    mut left := eval_unary(&world, &types, &sources, platform, &states, &mut pos, end, hint, depth, active)
    while left.ok && pos < end && world.tokens.kinds[pos] == .Symbol {
        op_tok := pos
        op := &world.tokens.texts[pos]
        code := rules.opcode(op)
        priority := rules.priority(code)
        if priority < minimum { break }
        pos += 1
        eval_right := active && !(code == 12 && left.int_val == 0) && !(code == 13 && left.int_val != 0)
        right := eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, left.ty, depth, priority + 1, eval_right)
        if !right.ok { return right }
        if code >= 12 {
            if left.ty != 3 || right.ty != 3 { return const_fail(op_tok, "logical " + op + " requires bool operands") }
            condition := if code == 12 { left.int_val != 0 && right.int_val != 0 } else { left.int_val != 0 || right.int_val != 0 }
            left = const_ok_int(3, if condition { 1 } else { 0 })
        } else if code >= 6 { left = compare_constants(&left, &right, op, op_tok) }
        else { left = arithmetic(&left, &right, op, op_tok, platform, active) }
    }
    left
}

fn compare_constants(left: &ConstVal, right: &ConstVal, op: string, op_tok: i32) -> ConstVal {
    if left.ty != right.ty { return const_fail(op_tok, "constant comparison requires matching types") }
    if left.kind == 2 { return const_fail(op_tok, "constant array comparison is not supported in constant expressions") }
    if left.kind == 1 {
        if op != "==" && op != "!=" { return const_fail(op_tok, "strings only support == and != comparisons") }
        eq := left.str_val == right.str_val
        return const_ok_int(3, if (op == "==" && eq) || (op == "!=" && !eq) { 1 } else { 0 })
    }
    if left.ty == 3 && op != "==" && op != "!=" { return const_fail(op_tok, "bool only supports == and != comparisons") }
    mut out := false
    if is_float(left.ty) {
        if left.ty == 6 {
            a := f32_value(left.int_val); b := f32_value(right.int_val)
            out = if op == "==" { a == b } else if op == "!=" { a != b } else if op == "<" { a < b } else if op == "<=" { a <= b } else if op == ">" { a > b } else { a >= b }
        } else {
            a := f64.from_bits(left.int_val); b := f64.from_bits(right.int_val)
            out = if op == "==" { a == b } else if op == "!=" { a != b } else if op == "<" { a < b } else if op == "<=" { a <= b } else if op == ">" { a > b } else { a >= b }
        }
    } else if is_unsigned(left.ty) {
        a := left.int_val; b := right.int_val
        out = if op == "==" { a == b } else if op == "!=" { a != b } else if op == "<" { const_u64_lt(a, b) } else if op == "<=" { a == b || const_u64_lt(a, b) } else if op == ">" { const_u64_lt(b, a) } else { a == b || const_u64_lt(b, a) }
    } else {
        a := left.int_val; b := right.int_val
        out = if op == "==" { a == b } else if op == "!=" { a != b } else if op == "<" { a < b } else if op == "<=" { a <= b } else if op == ">" { a > b } else { a >= b }
    }
    const_ok_int(3, if out { 1 } else { 0 })
}

fn arithmetic(left: &ConstVal, right: &ConstVal, op: string, op_tok: i32, platform: i32, active: bool) -> ConstVal {
    if left.ty != right.ty { return const_fail(op_tok, "constant arithmetic requires matching types") }
    if left.kind == 1 && op == "+" { return const_ok_str(if active { left.str_val + right.str_val } else { "" }) }
    if !int_type(left.ty) && !is_float(left.ty) { return const_fail(op_tok, "invalid constant operator") }
    if is_float(left.ty) && op == "%" { return const_fail(op_tok, "float constants do not support %") }
    if !active { return const_ok_int(left.ty, 0) }
    if left.ty == 6 {
        a := f32_value(left.int_val); b := f32_value(right.int_val)
        value := if op == "+" { a + b } else if op == "-" { a - b } else if op == "*" { a * b } else { a / b }
        return const_ok_int(6, i64(value.to_bits()).bit_and(4294967295))
    }
    if left.ty == 7 {
        a := f64.from_bits(left.int_val); b := f64.from_bits(right.int_val)
        value := if op == "+" { a + b } else if op == "-" { a - b } else if op == "*" { a * b } else { a / b }
        return const_ok_int(7, value.to_bits())
    }
    a := left.int_val; b := right.int_val
    if (op == "/" || op == "%") && b == 0 { return const_fail(op_tok, "division by zero in constant expression") }
    mut value: i64 = 0
    if is_unsigned(left.ty) {
        if op == "+" {
            value = a.wrapping_add(b)
            if const_u64_lt(value, a) { return const_fail(op_tok, "unsigned constant addition overflows") }
        } else if op == "-" {
            if const_u64_lt(a, b) { return const_fail(op_tok, "unsigned constant subtraction underflows") }
            value = a.wrapping_sub(b)
        } else if op == "*" {
            mut overflow := false
            value = const_u64_mul_checked(a, b, &mut overflow)
            if overflow { return const_fail(op_tok, "unsigned constant multiplication overflows") }
        } else { value = const_u64_divmod(a, b, op == "%") }
    } else if op == "+" {
        if (b > 0 && a > 9223372036854775807 - b) || (b < 0 && a < -9223372036854775808 - b) {
            return const_fail(op_tok, "constant addition overflows")
        }
        value = a + b
    } else if op == "-" {
        if (b < 0 && a > 9223372036854775807 + b) || (b > 0 && a < -9223372036854775808 + b) {
            return const_fail(op_tok, "constant subtraction overflows")
        }
        value = a - b
    } else if op == "*" {
        product := signed_product(a, b)
        if !product.0 { return const_fail(op_tok, "constant multiplication overflows") }
        value = product.1
    } else {
        minimum := if left.ty == 16 { i64(-32768) } else if left.ty == 1 { i64(-2147483648) } else { i64(-9223372036854775808) }
        if a == minimum && b == -1 {
            return const_fail(op_tok, if op == "/" { "constant division overflows" } else { "constant remainder overflows" })
        }
        value = if op == "/" { a / b } else { a % b }
    }
    check_int_range(platform, left.ty, value, op_tok)
}

fn eval_unary(world: &decl.World, types: &ft.TypeRegistry, sources: &diagnostics.Sources,
    platform: i32, states: &[]i32, pos: &mut i32, end: i32, expected: i32, depth: i32, active: bool) -> ConstVal {
    if pos < end && world.tokens.kinds[pos] == .Symbol && world.tokens.texts[pos] == "-" {
        op_tok := pos; pos = pos + 1
        if pos < end && world.tokens.kinds[pos] == .Integer {
            spelling := "-" + world.tokens.texts[pos]; pos = pos + 1
            if is_float(expected) {
                dec := decimal.decode(spelling, expected == 6)
                if !dec.ok { return const_fail(op_tok, "floating literal is outside the finite range") }
                return const_ok_int(expected, dec.bits)
            }
            mut ty := expected
            if !rules.signed_integer(ty) && !is_unsigned(ty) { ty = 1 }
            if is_unsigned(ty) { return const_fail(op_tok, "unsigned constant cannot be negative") }
            mut parsed := rules.literal_integer(spelling)
            _ := rules.validate_signed(&mut parsed, ty)
            if !parsed.ok { return const_fail(op_tok, "integer literal out of range") }
            return const_ok_int(ty, parsed.value)
        }
        if pos < end && world.tokens.kinds[pos] == .Float {
            spelling := "-" + world.tokens.texts[pos]; pos = pos + 1
            mut ty := 7; if expected == 6 { ty = 6 }
            dec := decimal.decode(spelling, ty == 6)
            if !dec.ok { return const_fail(op_tok, "floating literal is outside the finite range") }
            return const_ok_int(ty, dec.bits)
        }
        val := eval_unary(&world, &types, &sources, platform, &states, &mut pos, end, expected, depth + 1, active)
        if !val.ok { return val }
        if val.ty == 6 { return const_ok_int(6, val.int_val.bit_xor(2147483648)) }
        if val.ty == 7 { return const_ok_int(7, val.int_val.bit_xor(i64(-1).shl(63))) }
        if !rules.signed_integer(val.ty) { return const_fail(op_tok, "unary '-' requires signed numeric constant") }
        if !active { return const_ok_int(val.ty, 0) }
        if val.int_val == (-9223372036854775807 - 1) || (val.ty == 1 && val.int_val == -2147483648) || (val.ty == 16 && val.int_val == -32768) {
            return const_fail(op_tok, "constant negation overflows")
        }
        return const_ok_int(val.ty, -val.int_val)
    }
    if pos < end && world.tokens.kinds[pos] == .Symbol && world.tokens.texts[pos] == "!" {
        op_tok := pos; pos = pos + 1
        val := eval_unary(&world, &types, &sources, platform, &states, &mut pos, end, 3, depth + 1, active)
        if !val.ok { return val }
        if val.ty != 3 { return const_fail(op_tok, "unary '!' requires bool constant") }
        return const_ok_int(3, if val.int_val == 0 { 1 } else { 0 })
    }
    eval_primary(&world, &types, &sources, platform, &states, &mut pos, end, expected, depth, active)
}

fn eval_primary(world: &decl.World, types: &ft.TypeRegistry, sources: &diagnostics.Sources,
    platform: i32, states: &[]i32, pos: &mut i32, end: i32, expected: i32, depth: i32, active: bool) -> ConstVal {
    if pos >= end { return const_fail(pos, "expected constant expression") }
    tok := pos; kind := world.tokens.kinds[pos]
    if kind == .Symbol && world.tokens.texts[pos] == "(" {
        pos = pos + 1
        val := eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, expected, depth + 1, 1, active)
        if !val.ok { return val }
        if pos >= end || world.tokens.texts[pos] != ")" { return const_fail(pos, "expected ')' in constant expression") }
        pos = pos + 1; return val
    }
    if kind == .Symbol && world.tokens.texts[pos] == "[" {
        pos = pos + 1
        while pos < end && lexer.is_newline(world.tokens.kinds[pos]) { pos = pos + 1 }
        mut elem_hint := 0
        if expected > 0 && ft.collection(&types, expected) { elem_hint = ft.type_base(&types, expected) }
        if elem_hint != 0 && !scalar_value_type(elem_hint) {
            return const_fail(tok, "constant arrays only support scalar elements")
        }
        arr_ty := expected
        if pos < end && world.tokens.texts[pos] == "]" {
            pos = pos + 1
            if elem_hint == 0 { return const_fail(tok, "empty constant array requires a type annotation") }
            return const_ok_arr(arr_ty, elem_hint, [])
        }
        if elem_hint == 0 {
            prefix := infer_array_default(&world.tokens, pos)
            if prefix.0 > pos {
                wend := world.tokens.texts[prefix.0].clone()
                if wend == "]" || wend == ";" { elem_hint = prefix.1 }
            }
        }
        first_tok := pos
        first := eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, elem_hint, depth + 1, 1, active)
        if !first.ok { return first }
        if !scalar_value_type(first.ty) { return const_fail(first_tok, "constant arrays only support scalar elements") }
        elem_ty := if elem_hint != 0 { elem_hint } else { first.ty }
        if first.ty != elem_ty { return const_fail(first_tok, "constant array element type mismatch") }
        if pos < end && world.tokens.texts[pos] == ";" {
            pos = pos + 1
            while pos < end && lexer.is_newline(world.tokens.kinds[pos]) { pos = pos + 1 }
            count_tok := pos
            cnt := eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, 1, depth + 1, 1, active)
            if !cnt.ok { return cnt }
            if !int_type(cnt.ty) || (is_unsigned(cnt.ty) && cnt.int_val < 0) || cnt.int_val < 0 || cnt.int_val > 1048576 {
                return const_fail(count_tok, "constant array repeat count out of range (0..1048576)")
            }
            while pos < end && lexer.is_newline(world.tokens.kinds[pos]) { pos = pos + 1 }
            if pos >= end || world.tokens.texts[pos] != "]" { return const_fail(pos, "expected ']'") }
            pos = pos + 1
            mut vals: []i64 = []; n := i32(cnt.int_val); vals.reserve(n)
            for _ in 0..n { vals.push(first.int_val) }
            return const_ok_arr(arr_ty, elem_ty, move vals)
        }
        mut vals: []i64 = [first.int_val]
        while pos < end {
            while pos < end && lexer.is_newline(world.tokens.kinds[pos]) { pos = pos + 1 }
            if pos < end && world.tokens.texts[pos] == "," {
                pos = pos + 1
                while pos < end && lexer.is_newline(world.tokens.kinds[pos]) { pos = pos + 1 }
                if pos < end && world.tokens.texts[pos] == "]" { break }
                etok := pos
                ev := eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, elem_ty, depth + 1, 1, active)
                if !ev.ok { return ev }
                if ev.ty != elem_ty { return const_fail(etok, "constant array element type mismatch") }
                vals.push(ev.int_val)
            } else { break }
        }
        while pos < end && lexer.is_newline(world.tokens.kinds[pos]) { pos = pos + 1 }
        if pos >= end || world.tokens.texts[pos] != "]" { return const_fail(pos, "expected ']'") }
        pos = pos + 1
        return const_ok_arr(arr_ty, elem_ty, move vals)
    }
    if kind == .Integer {
        spelling := world.tokens.texts[pos].clone(); pos = pos + 1
        if is_float(expected) {
            dec := decimal.decode(spelling, expected == 6)
            if !dec.ok { return const_fail(tok, "floating literal is outside the finite range") }
            return const_ok_int(expected, dec.bits)
        }
        mut ty := expected
        if !is_unsigned(ty) && !rules.signed_integer(ty) { ty = 1 }
        if is_unsigned(ty) {
            num := unsigned_literal(spelling, ty)
            if !num.ok { return const_fail(tok, "unsigned integer literal out of range") }
            if (platform == 3 || platform == 4) && ty == 12 && (num.value < 0 || num.value > 4294967295) { return const_fail(tok, "usize literal exceeds wasm32 pointer width") }
            return const_ok_int(ty, num.value)
        }
        mut parsed := rules.literal_integer(spelling)
        _ := rules.validate_signed(&mut parsed, ty)
        if !parsed.ok { return const_fail(tok, "integer literal out of range") }
        return const_ok_int(ty, parsed.value)
    }
    if kind == .Float {
        spelling := world.tokens.texts[pos].clone(); pos = pos + 1
        mut ty := 7; if expected == 6 { ty = 6 }
        dec := decimal.decode(spelling, ty == 6)
        if !dec.ok { return const_fail(tok, "floating literal is outside the finite range") }
        return const_ok_int(ty, dec.bits)
    }
    if kind == .Byte {
        parsed := parse.integer(world.tokens.texts[pos]); pos = pos + 1
        return const_ok_int(8, parsed.value)
    }
    if kind == .Rune {
        scalar := world.tokens.texts[pos].runes()[0]; pos = pos + 1
        return const_ok_int(5, i64(i32(scalar)))
    }
    if kind == .String {
        s := world.tokens.texts[pos].clone(); pos = pos + 1
        return const_ok_str(s)
    }
    if world.tokens.kinds[pos] == .Symbol && world.tokens.texts[pos] == "@" {
        if pos + 6 < end && world.tokens.texts[pos + 1] == "__dunder_module_embed_bytes" &&
            world.tokens.texts[pos + 2] == "(" && world.tokens.kinds[pos + 3] == .Integer &&
            world.tokens.texts[pos + 4] == "," && world.tokens.kinds[pos + 5] == .String &&
            world.tokens.texts[pos + 6] == ")" {
            parsed := parse.integer(world.tokens.texts[pos + 3])
            pos = pos + 7
            bid := i32(parsed.value)
            if !parsed.ok || bid < 0 || bid >= world.embed_blob_counts.len {
                return const_fail(tok, "embedded blob id out of range")
            }
            if expected != 0 && !((ft.type_kind(&types, expected) == 1 || ft.type_kind(&types, expected) == 6) && ft.type_base(&types, expected) == 8) {
                return const_fail(tok, "type mismatch: @embed_bytes produces []u8 or [u8; N]")
            }
            return ConstVal {
                ok: true, kind: 2, ty: expected, int_val: i64(world.embed_blob_counts[bid]), str_val: "",
                arr_elem: 8, arr_ints: [], embed_blob: bid, error: "", error_tok: -1, need_const: -1,
            }
        }
        return const_fail(tok, "unsupported '@' in constant expression")
    }
    if world.tokens.texts[pos] == "true" { pos = pos + 1; return const_ok_int(3, 1) }
    if world.tokens.texts[pos] == "false" { pos = pos + 1; return const_ok_int(3, 0) }
    if kind == .Name {
        name := world.tokens.texts[pos].clone(); pos = pos + 1
        cast_ty := ft.type_id(&types, name)
        if (rules.signed_integer(cast_ty) || cast_ty == 5 || is_float(cast_ty) || is_unsigned(cast_ty)) &&
        pos < end && world.tokens.texts[pos] == "(" {
            pos = pos + 1
            mut arg_hint := 0
            mut lit_at := pos; if lit_at < end && world.tokens.texts[lit_at] == "-" { lit_at = lit_at + 1 }
            if lit_at + 1 < end && (world.tokens.kinds[lit_at] == .Integer || world.tokens.kinds[lit_at] == .Float) &&
            world.tokens.texts[lit_at + 1] == ")" {
                if is_float(cast_ty) || world.tokens.kinds[lit_at] == .Integer { arg_hint = cast_ty }
            }
            mut inner := eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, arg_hint, depth + 1, 1, active)
            if !inner.ok { return inner }
            if pos >= end || world.tokens.texts[pos] != ")" { return const_fail(pos, "expected ')' in constant cast") }
            pos = pos + 1
            if !active { inner.int_val = 0 }
            return cast_value(platform, cast_ty, move inner, tok)
        }
        if is_float(cast_ty) && pos + 2 < end && world.tokens.texts[pos] == "." &&
        world.tokens.texts[pos + 1] == "from_bits" && world.tokens.texts[pos + 2] == "(" {
            pos = pos + 3
            bits_ty := if cast_ty == 6 { 1 } else { 2 }
            inner := eval_binary(&world, &types, &sources, platform, &states, &mut pos, end, bits_ty, depth + 1, 1, active)
            if !inner.ok { return inner }
            if inner.ty != bits_ty { return const_fail(tok, "from_bits constant type mismatch") }
            if pos >= end || world.tokens.texts[pos] != ")" { return const_fail(pos, "expected ')'") }
            pos = pos + 1
            if cast_ty == 6 { return const_ok_int(6, inner.int_val.bit_and(4294967295)) }
            return const_ok_int(7, inner.int_val)
        }
        other := i32(world.const_map.get_or(name, -1))
        if other >= 0 {
            if states[other] == 0 { return const_need(other, tok) }
            if states[other] == 1 {
                return const_fail(tok, "cyclic constant definition '" + diagnostics.display_symbol(&sources, world.const_names[other].clone()) + "'")
            }
            okind := world.const_kinds[other]; oty := world.const_types[other]
            if pos + 1 < end && world.tokens.texts[pos] == "." && world.tokens.texts[pos + 1] == "len" {
                pos = pos + 2
                if okind == 1 { return const_ok_int(1, i64(world.const_strings[other].len)) }
                if okind == 2 { return const_ok_int(1, world.const_ints[other]) }
                return const_fail(tok, "len expects a constant array or string")
            }
            if okind == 0 { return const_ok_int(oty, world.const_ints[other]) }
            if okind == 1 { return const_ok_str(world.const_strings[other].clone()) }
            return const_fail(tok, "nested constant array reference is not supported inside constant arrays")
        }
        return const_fail(tok, "unknown or non-constant identifier '" + diagnostics.display_symbol(&sources, name) + "'")
    }
    const_fail(tok, "unsupported token in constant expression")
}

@test fn const_eval_handles_arithmetic_unsigned_and_pre_eval() {
    mut world := decl.new()
    world.tokens = lexer.scan("const N = 4 + 2 * 3\nconst U = 250 + 5", false)
    mut lengths := Map<string, i64>::new()
    pre_register_int_consts(&world.tokens, &mut lengths)
    assert(lengths.get_or("N", -1) == 10)

    types := ft.new_registry()
    sources := diagnostics.new()
    states: []i32 = []
    mut pos := 3
    end_n := expr_end(&world.tokens, pos)
    val := eval_expr(&world, &types, &sources, 0, &states, &mut pos, end_n, 1)
    assert(val.ok && val.ty == 1 && val.int_val == 10 && pos == end_n)

    mut u_pos := end_n + 4
    end_u := expr_end(&world.tokens, u_pos)
    uval := eval_expr(&world, &types, &sources, 0, &states, &mut u_pos, end_u, 8)
    assert(uval.ok && uval.ty == 8 && uval.int_val == 255)
}
