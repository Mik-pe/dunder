import ownership_state as ownership

pub struct Block {
    body: i32, scope: i32, owner_limit: i32, local_limit: i32, operand_depth: i32,
    first_lock: i32, entry: i32, last_exit: i32,
    exit_state: ownership.Checkpoint, has_exit: bool,
}

pub struct Exit { target: i32, previous: i32 }

pub struct Blocks {
    stack: []Block, locked_locals: []i32, exits: []Exit,
    selector: i32, return_slot: i32,
}

pub fn new() -> Blocks {
    Blocks { stack: [], locked_locals: [], exits: [], selector: -1, return_slot: -1 }
}

pub fn reset(b: &mut Blocks) {
    b.stack.clear(); b.locked_locals.clear(); b.exits.clear()
    b.selector = -1; b.return_slot = -1
}

pub fn register(b: &mut Blocks, body: i32, scope: i32, owners: i32, locals: i32, operand_depth: i32) {
    b.stack.push(Block {
        body: body, scope: scope, owner_limit: owners, local_limit: locals, operand_depth: operand_depth,
        first_lock: b.locked_locals.len, entry: -1, last_exit: -1,
        exit_state: ownership.empty_checkpoint(), has_exit: false,
    })
}

pub fn record_exit(b: &mut Blocks, floor: i32, state: &ownership.State) {
    if !ownership.falls_through(&state) { return }
    snap := ownership.checkpoint(&state)
    mut d := b.stack.len - 1
    while d >= floor {
        if !b.stack[d].has_exit {
            ownership.copy_checkpoint(&mut b.stack[d].exit_state, &snap)
            b.stack[d].has_exit = true
        } else {
            ownership.join_checkpoint_in_place(&state, &mut b.stack[d].exit_state, &snap)
        }
        d = d - 1
    }
}

pub fn discard_to(b: &mut Blocks, depth: i32) {
    if depth < b.stack.len {
        b.locked_locals.truncate(b.stack[depth].first_lock)
        b.stack.truncate(depth)
    }
}

pub fn add_exit(b: &mut Blocks, block: i32, resume: i32) -> i32 {
    edge := b.exits.len
    b.exits.push(Exit { target: resume, previous: b.stack[block].last_exit })
    b.stack[block].last_exit = edge
    edge
}
