// Body-owned structural types share the frozen declaration prefix. The table
// stores only the locally interned rows plus their callable parameter lists.
// Row IDs preserve insertion order, so nested shapes always refer backwards.
// Raw backend inputs have no source type table.
pub fn append(out: &mut []i32, prefix: i32, kinds: &[]i32, bases: &[]i32, starts: &[]i32,
    counts: &[]i32, variadic_fixed: &[]i32, params: &[]i32) {
    assert(variadic_fixed.len == kinds.len)
    out.reserve(out.len + 2 + kinds.len * 5 + params.len)
    out.push(prefix); out.push(kinds.len)
    for i in 0..kinds.len {
        out.push(kinds[i]); out.push(bases[i]); out.push(starts[i]); out.push(counts[i]); out.push(variadic_fixed[i])
    }
    for p in &params { out.push(p) }
}
pub fn valid(table: &[]i32) -> bool {
    if table.len == 0 { return true }
    if table.len < 2 { return false }
    prefix := table[0]; count := table[1]
    if prefix < 1 || count < 0 || count > (table.len - 2) / 5 || count > 2147483647 - prefix { return false }
    parameters := 2 + 5 * count; mut used := 0
    for i in 0..count {
        at := 2 + 5 * i; kind := table[at]; base := table[at + 1]; start := table[at + 2]; n := table[at + 3]; fixed := table[at + 4]
        if base < 0 || base >= prefix + i || n < 0 { return false }
        if fixed < -1 || (fixed >= 0 && (kind != 8 || fixed > n)) { return false }
        if kind == 8 || kind == 9 || (kind == 23 && n == 1) {
            if start != used || n > table.len - parameters - used { return false }
            for j in used..(used + n) {
                ty := table[parameters + j]; if ty < 0 || ty >= prefix + i { return false }
            }
            used = used + n
        } else {
            if kind != 1 && kind != 4 && kind != 5 && kind != 6 && kind != 10 && (kind < 20 || kind > 23) { return false }
            if start != 0 || (kind != 6 && n != 0) { return false }
        }
    }
    used == table.len - parameters
}
pub fn contains(table: &[]i32, ty: i32) -> bool {
    ty >= 0 && (table.len == 0 || ty < table[0] + table[1])
}
pub fn callable(table: &[]i32, sig: i32, result: i32, register_args: i32) -> bool {
    if !contains(&table, sig) || !contains(&table, result) { return false }
    if table.len == 0 || sig < table[0] { return true }
    at := 2 + 5 * (sig - table[0]); mut n := table[at + 3]
    if n > 8 { n = 8 }
    (table[at] == 8 || table[at] == 9) && table[at + 1] == result && n == register_args
}

pub fn owner(table: &[]i32, ty: i32) -> bool {
    if !contains(&table, ty) { return false }
    if table.len == 0 || ty < table[0] { return true }
    kind := table[2 + (ty - table[0]) * 5]
    kind == 1 || kind == 6 || kind == 10
}
@test fn callable_and_shared_scope_shapes_keep_nested_local_parameters() {
    mut types: []i32 = []
    kinds: []i32 = [6, 4, 9, 23]; bases: []i32 = [1, 14, 14, 0]
    starts: []i32 = [0, 0, 0, 2]; counts: []i32 = [42, 0, 2, 1]; params: []i32 = [15, 2, 14]
    variadic_fixed: []i32 = [-1, -1, -1, -1]
    append(&mut types, 14, &kinds, &bases, &starts, &counts, &variadic_fixed, &params)
    assert(valid(&types)); assert(callable(&types, 16, 14, 2)); assert(!callable(&types, 16, 2, 2))
    assert(owner(&types, 14) && !owner(&types, 15)); assert(!contains(&types, 18))
    types[22] = 16
    assert(!valid(&types))
}

@test fn c_variadic_boundary_is_explicit_and_validated_in_body_shape_transport() {
    mut types: []i32 = []
    kinds: []i32 = [8]; bases: []i32 = [1]; starts: []i32 = [0]; counts: []i32 = [2]
    fixed: []i32 = [1]; params: []i32 = [1, 2]
    append(&mut types, 14, &kinds, &bases, &starts, &counts, &fixed, &params)
    assert(valid(&types) && types[6] == 1 && callable(&types, 14, 1, 2))
    types[6] = 3; assert(!valid(&types))
    types[6] = 1; types[2] = 9; assert(!valid(&types))
    types[6] = -1; assert(valid(&types))
}
