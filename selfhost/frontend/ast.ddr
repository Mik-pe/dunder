import diagnostics as diag

pub struct Span { start: i32, end: i32 }

pub fn span(start: i32, end: i32) -> Span {
    fixed_end := if end >= start { end } else { start }
    Span { start: start, end: fixed_end }
}

pub enum ItemKind {
    Capability, Import, Const, Struct, Union, Enum, Trait, Impl,
    Fn, ExternFn, TypeAlias, ExternType, ExternStatic, ExternBlock,
}

pub enum ReceiverKind { None, Owned, SharedRef, MutRef }

pub enum AttrArgKind { Positional, Named, Call }

pub struct AttrArg {
    kind: AttrArgKind,
    key: string,
    value: string,
    first_arg: i32,
    arg_count: i32,
    span: Span,
}

pub struct Attr {
    name: string,
    span: Span,
    first_arg: i32,
    arg_count: i32,
    body_expr: i32,
}

pub struct GenericParam {
    name: string,
    is_const: bool,
    const_ty: i32,
    first_bound: i32,
    bound_count: i32,
    span: Span,
}

pub struct WherePred {
    target_ty: i32,
    first_bound: i32,
    bound_count: i32,
    span: Span,
}

pub struct FromSource {
    root_name: string,
    field_name: string,
    span: Span,
}

pub struct Item {
    kind: ItemKind,
    name: string,
    target_name: string,
    trait_name: string,
    is_pub: bool,
    is_unsafe: bool,
    is_opaque: bool,
    is_test: bool,
    span: Span,
    name_span: Span,
    body_span: Span,
    first_param: i32,
    param_count: i32,
    first_member: i32,
    member_count: i32,
    first_attr: i32,
    attr_count: i32,
    ret_type: i32,
    abi: string,
    is_mut: bool,
    is_extern: bool,
    parent_item: i32,
    first_gen: i32,
    gen_count: i32,
    first_where: i32,
    where_count: i32,
    first_from: i32,
    from_count: i32,
    body_expr: i32,
    target_ty: i32,
    trait_ty: i32,
    first_child: i32,
    child_count: i32,
    first_name: i32,
    name_count: i32,
}

pub struct Param {
    name: string,
    is_mut: bool,
    is_move: bool,
    ty: i32,
    span: Span,
    receiver: ReceiverKind,
    is_variadic: bool,
}

pub struct Member {
    name: string,
    is_pub: bool,
    is_unsafe: bool,
    ty: i32,
    span: Span,
    body_span: Span,
    first_gen: i32,
    gen_count: i32,
    first_where: i32,
    where_count: i32,
    first_param: i32,
    param_count: i32,
    first_from: i32,
    from_count: i32,
    first_attr: i32,
    attr_count: i32,
    body_expr: i32,
    first_payload: i32,
    payload_count: i32,
    discriminant_expr: i32,
}

pub enum TypeKind {
    Named, Slice, FixedArray, Ref, MutRef, RawConst, RawMut,
    Tuple, FnType, Unit, ConstArg, Error,
}

pub struct FnParamType {
    ty: i32,
    is_mut: bool,
    is_move: bool,
    is_variadic: bool,
    span: Span,
}

pub struct TypeNode {
    kind: TypeKind,
    name: string,
    inner: i32,
    count: i32,
    span: Span,
    abi: string,
    is_extern: bool,
    is_variadic: bool,
    first_arg: i32,
    arg_count: i32,
    len_expr: i32,
    first_from: i32,
    from_count: i32,
}

pub enum PatKind {
    Wildcard, Binding, Literal, Path, Variant, Tuple, Struct, Range, Or, Rest, Error,
}

pub struct FieldPat {
    name: string,
    pat: i32,
    is_mut: bool,
    is_rest: bool,
    span: Span,
}

pub struct PatNode {
    kind: PatKind,
    name: string,
    op: string,
    is_mut: bool,
    is_move: bool,
    neg: bool,
    left: i32,
    right: i32,
    first_child: i32,
    child_count: i32,
    first_ty_arg: i32,
    ty_arg_count: i32,
    span: Span,
}

pub struct TaskSharedArg {
    is_shared: bool,
    expr: i32,
    span: Span,
}

pub struct TaskClause {
    first_shared: i32,
    shared_count: i32,
    first_cap: i32,
    cap_count: i32,
    arena_expr: i32,
}

pub enum StmtKind {
    Let, Assign, Expr, Return, If, While, For, Match, Defer, Unsafe,
    Region, TaskScope, Break, Continue, Block,
}

pub struct StmtNode {
    kind: StmtKind,
    name: string,
    is_mut: bool,
    expr: i32,
    span: Span,
    ty: i32,
    pat: i32,
    lhs: i32,
    op: string,
    body: i32,
    is_move: bool,
    cap_expr: i32,
    clause_idx: i32,
    has_semi: bool,
}

pub struct CallArg {
    expr: i32,
    is_move: bool,
    span: Span,
}

pub struct FieldInit {
    name: string,
    expr: i32,
    is_shorthand: bool,
    is_rest: bool,
    span: Span,
}

pub struct MatchArm {
    pat: i32,
    guard: i32,
    body: i32,
    span: Span,
}

pub struct CaptureItem {
    name: string,
    is_ref: bool,
    is_mut: bool,
    is_move: bool,
    ty: i32,
    init_expr: i32,
    span: Span,
}

pub struct ClosureData {
    is_move: bool,
    first_cap: i32,
    cap_count: i32,
    first_param: i32,
    param_count: i32,
    ret_ty: i32,
    first_from: i32,
    from_count: i32,
    body: i32,
    span: Span,
}

pub enum ExprKind {
    Int, Float, Bool, String, CString, WString, Rune, Byte, Ident,
    Binary, Unary, Call, MethodCall, Field, Index, Slice,
    StructLit, ArrayLit, ArrayRepeat, TupleLit, Closure,
    IfExpr, MatchExpr, BlockExpr, UnsafeBlock, VariantShorthand,
    Move, Range, Cast, Try, Group, TypeExpr, ReturnExpr, BreakExpr, ContinueExpr, Error,
}

pub struct ExprNode {
    kind: ExprKind,
    text: string,
    op: string,
    left: i32,
    right: i32,
    span: Span,
    extra: i32,
    first_child: i32,
    child_count: i32,
    first_ty_arg: i32,
    ty_arg_count: i32,
    ty: i32,
    flags: i32,
}

pub struct Module {
    path: string,
    source: string,
    items: []Item,
    params: []Param,
    members: []Member,
    attrs: []Attr,
    attr_args: []AttrArg,
    generic_params: []GenericParam,
    where_preds: []WherePred,
    from_sources: []FromSource,
    fn_param_types: []FnParamType,
    types: []TypeNode,
    pats: []PatNode,
    field_pats: []FieldPat,
    task_shared_args: []TaskSharedArg,
    task_clauses: []TaskClause,
    stmts: []StmtNode,
    call_args: []CallArg,
    field_inits: []FieldInit,
    match_arms: []MatchArm,
    captures: []CaptureItem,
    closures: []ClosureData,
    exprs: []ExprNode,
    id_lists: []i32,
    name_lists: []string,
    diagnostics: []diag.Diagnostic,
    ok: bool,
}

pub fn new_module(path: string, source: string) -> Module {
    Module {
        path: path.clone(),
        source: source.clone(),
        items: [],
        params: [],
        members: [],
        attrs: [],
        attr_args: [],
        generic_params: [],
        where_preds: [],
        from_sources: [],
        fn_param_types: [],
        types: [],
        pats: [],
        field_pats: [],
        task_shared_args: [],
        task_clauses: [],
        stmts: [],
        call_args: [],
        field_inits: [],
        match_arms: [],
        captures: [],
        closures: [],
        exprs: [],
        id_lists: [],
        name_lists: [],
        diagnostics: [],
        ok: true,
    }
}

pub fn add_type(m: &mut Module, move node: TypeNode) -> i32 {
    id := m.types.len
    m.types.push(move node)
    id
}

pub fn add_stmt(m: &mut Module, move node: StmtNode) -> i32 {
    id := m.stmts.len
    m.stmts.push(move node)
    id
}

pub fn add_expr(m: &mut Module, move node: ExprNode) -> i32 {
    id := m.exprs.len
    m.exprs.push(move node)
    id
}

pub fn add_pat(m: &mut Module, move node: PatNode) -> i32 {
    id := m.pats.len
    m.pats.push(move node)
    id
}

pub fn add_closure(m: &mut Module, data: ClosureData) -> i32 {
    id := m.closures.len
    m.closures.push(data)
    id
}

pub fn add_task_clause(m: &mut Module, clause: TaskClause) -> i32 {
    id := m.task_clauses.len
    m.task_clauses.push(clause)
    id
}

pub fn add_id_list(m: &mut Module, ids: &[]i32) -> i32 {
    first := m.id_lists.len
    for i in 0..ids.len { m.id_lists.push(ids[i]) }
    first
}

pub fn add_name_list(m: &mut Module, names: &[]string) -> i32 {
    first := m.name_lists.len
    for i in 0..names.len { m.name_lists.push(names[i].clone()) }
    first
}

pub fn find_item_at(m: &Module, offset: i32) -> i32 {
    mut best := -1
    mut best_size := 2147483647
    for i in 0..m.items.len {
        sp := m.items[i].span
        if offset >= sp.start && offset <= sp.end {
            size := sp.end - sp.start
            if size <= best_size {
                best = i
                best_size = size
            }
        }
    }
    best
}

pub fn item_count(m: &Module) -> i32 {
    m.items.len
}

pub fn total_node_count(m: &Module) -> i32 {
    m.items.len + m.params.len + m.members.len + m.attrs.len + m.attr_args.len +
    m.generic_params.len + m.where_preds.len + m.from_sources.len + m.fn_param_types.len +
    m.types.len + m.pats.len + m.field_pats.len + m.task_shared_args.len + m.task_clauses.len +
    m.stmts.len + m.call_args.len + m.field_inits.len + m.match_arms.len +
    m.captures.len + m.closures.len + m.exprs.len
}
