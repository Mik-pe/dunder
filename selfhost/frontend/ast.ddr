import diagnostics as diag

pub struct Span { start: i32, end: i32 }

pub fn span(start: i32, end: i32) -> Span {
    fixed_end := if end >= start { end } else { start }
    Span { start: start, end: fixed_end }
}

pub enum ItemKind { Capability, Import, Const, Struct, Enum, Trait, Impl, Fn, ExternFn }

pub struct Item {
    kind: ItemKind,
    name: string,
    target_name: string,
    trait_name: string,
    is_pub: bool,
    is_unsafe: bool,
    is_opaque: bool,
    is_test: bool,
    span: Span,
    name_span: Span,
    body_span: Span,
    first_param: i32,
    param_count: i32,
    first_member: i32,
    member_count: i32,
    first_attr: i32,
    attr_count: i32,
    ret_type: i32,
}

pub struct Param {
    name: string,
    is_mut: bool,
    is_move: bool,
    ty: i32,
    span: Span,
}

pub struct Member {
    name: string,
    is_pub: bool,
    is_unsafe: bool,
    ty: i32,
    span: Span,
    body_span: Span,
}

pub struct Attr {
    name: string,
    span: Span,
}

pub enum TypeKind { Named, Slice, FixedArray, Ref, MutRef, Tuple, FnType, Unit, Error }

pub struct TypeNode {
    kind: TypeKind,
    name: string,
    inner: i32,
    count: i32,
    span: Span,
}

pub enum StmtKind { Let, Assign, Expr, Return, If, While, For, Match, Defer, Unsafe, Region, TaskScope, Break, Continue, Block }

pub struct StmtNode {
    kind: StmtKind,
    name: string,
    is_mut: bool,
    expr: i32,
    span: Span,
}

pub enum ExprKind {
    Int, Float, Bool, String, Rune, Byte, Ident, Binary, Unary, Call, MethodCall,
    Field, Index, StructLit, ArrayLit, TupleLit, Closure, IfExpr, MatchExpr,
    BlockExpr, Spawn, Await, Move, Range, Cast, Try, Group, Error
}

pub struct ExprNode {
    kind: ExprKind,
    text: string,
    op: string,
    left: i32,
    right: i32,
    span: Span,
}

pub struct Module {
    path: string,
    source: string,
    items: []Item,
    params: []Param,
    members: []Member,
    attrs: []Attr,
    types: []TypeNode,
    stmts: []StmtNode,
    exprs: []ExprNode,
    diagnostics: []diag.Diagnostic,
    ok: bool,
}

pub fn new_module(path: string, source: string) -> Module {
    Module {
        path: path.clone(),
        source: source.clone(),
        items: [],
        params: [],
        members: [],
        attrs: [],
        types: [],
        stmts: [],
        exprs: [],
        diagnostics: [],
        ok: true,
    }
}

pub fn add_type(m: &mut Module, move node: TypeNode) -> i32 {
    id := m.types.len
    m.types.push(move node)
    id
}

pub fn add_stmt(m: &mut Module, move node: StmtNode) -> i32 {
    id := m.stmts.len
    m.stmts.push(move node)
    id
}

pub fn add_expr(m: &mut Module, move node: ExprNode) -> i32 {
    id := m.exprs.len
    m.exprs.push(move node)
    id
}

pub fn find_item_at(m: &Module, offset: i32) -> i32 {
    mut best := -1
    mut best_size := 2147483647
    for i in 0..m.items.len {
        sp := m.items[i].span
        if offset >= sp.start && offset <= sp.end {
            size := sp.end - sp.start
            if size <= best_size {
                best = i
                best_size = size
            }
        }
    }
    best
}

pub fn item_count(m: &Module) -> i32 {
    m.items.len
}
