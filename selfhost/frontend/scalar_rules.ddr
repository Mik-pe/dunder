import std.parse as integers

pub fn signed_integer(ty: i32) -> bool { ty == 1 || ty == 2 || ty == 16 }

pub fn validate_signed(parsed: &mut integers.Integer, expected: i32) -> i32 {
    ty := if signed_integer(expected) { expected } else { 1 }
    if parsed.ok && ty == 16 && (parsed.value < -32768 || parsed.value > 32767) {
        parsed.ok = false; parsed.error = 2
    }
    if parsed.ok && ty == 1 && (parsed.value < -2147483648 || parsed.value > 2147483647) {
        parsed.ok = false; parsed.error = 2
    }
    ty
}
fn radix_digit(byte: u8, radix: i32) -> i32 {
    if byte >= b'0' && byte <= b'9' {
        digit := i32(byte - b'0')
        return if digit < radix { digit } else { -1 }
    }
    if radix == 16 {
        if byte >= b'A' && byte <= b'F' { return 10 + i32(byte - b'A') }
        if byte >= b'a' && byte <= b'f' { return 10 + i32(byte - b'a') }
    }
    -1
}

pub fn literal_integer(text: string) -> integers.Integer {
    if text.len == 0 { return integers.integer(text) }
    sign := u8(text[0])
    negative := sign == b'-'
    start := if negative || sign == b'+' { 1 } else { 0 }
    if start + 1 >= text.len || u8(text[start]) != b'0' { return integers.integer(text) }
    prefix := u8(text[start + 1])
    radix := if prefix == b'x' || prefix == b'X' { 16 }
        else if prefix == b'b' || prefix == b'B' { 2 }
        else { 0 }
    if radix == 0 { return integers.integer(text) }

    limit: i64 = if negative { -9223372036854775808 } else { -9223372036854775807 }
    cutoff := limit / i64(radix)
    mut value: i64 = 0
    mut previous_digit := false
    for i in start + 2..text.len {
        byte := u8(text[i])
        if byte == b'_' {
            if !previous_digit { return integers.Integer { ok: false, value: 0, error: 1 } }
            previous_digit = false
        } else {
            digit := radix_digit(byte, radix)
            if digit < 0 { return integers.Integer { ok: false, value: 0, error: 1 } }
            if value < cutoff { return integers.Integer { ok: false, value: 0, error: 2 } }
            value *= i64(radix)
            if value < limit + i64(digit) { return integers.Integer { ok: false, value: 0, error: 2 } }
            value -= i64(digit)
            previous_digit = true
        }
    }
    if !previous_digit { return integers.Integer { ok: false, value: 0, error: 1 } }
    if !negative { value = -value }
    integers.Integer { ok: true, value: value, error: 0 }
}

pub fn reserved(name: string) -> bool {
    name == "TaskID" || name == "Sendable" || name == "Storable" || name == "Clone" || name == "Copy" || name == "Iterator" || name == "trait" ||
        name == "const" || name == "move" || name == "impl" || name == "self" || name == "Self" ||
        name == "print" || name == "assert" || name == "i16" || name == "i32" || name == "i64" || name == "bool" ||
        name == "string" || name == "len" || name == "f32" || name == "f64" || name == "rune" ||
        name == "range" || name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "usize"
}
pub fn primitive_types() -> []string {
    ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr", "range", "str", "i16"]
}
pub fn builtin_call(name: string) -> bool {
    if reserved(name) { return true }
    for word in ["panic", "replace", "swap", "target_is", "size_of", "align_of", "zeroed", "callback", "static_bytes", "cstr", "addr", "ptr", "ffi_fn", "ref_at", "bytes_view", "__sync_needs_pool", "__sync_pack", "__sync_freeze", "__sync_unpack", "__sync_drop_packed", "__sync_borrow_ref"] {
        if name == word { return true }
    }
    mut first := 0
    if name.len > 5 && name[0..5] == "load_" { first = 5 }
    if name.len > 6 && name[0..6] == "store_" { first = 6 }
    if first > 0 {
        part := name[first..name.len]
        for word in ["i16", "i32", "i64", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr"] { if part == word { return true } }
    }
    false
}
pub fn precedence(word: string) -> i32 { priority(opcode(word)) }
pub fn priority(op: i32) -> i32 {
    if op == 0 { return 0 }
    if op <= 2 { return 5 }; if op <= 5 { return 6 }
    if op <= 7 { return 3 }; if op <= 11 { return 4 }
    if op == 12 { return 2 }; 1
}
pub fn assign_operator(op: string) -> string {
    if op == "+=" { return "+" }
    if op == "-=" { return "-" }
    if op == "*=" { return "*" }
    if op == "/=" { return "/" }
    if op == "%=" { return "%" }
    ""
}

pub fn opcode(word: string) -> i32 {
    if word.len == 1 {
        byte := u8(word[0])
        if byte == b'+' { return 1 }; if byte == b'-' { return 2 }; if byte == b'*' { return 3 }
        if byte == b'/' { return 4 }; if byte == b'%' { return 5 }
        if byte == b'<' { return 8 }; if byte == b'>' { return 10 }
    } else if word.len == 2 {
        first := u8(word[0]); last := u8(word[1])
        if last == b'=' {
            if first == b'=' { return 6 }; if first == b'!' { return 7 }
            if first == b'<' { return 9 }; if first == b'>' { return 11 }
        } else if first == last {
            if first == b'&' { return 12 }; if first == b'|' { return 13 }
        }
    }
    0
}
@test fn shared_scalar_rules_preserve_width_names_and_operator_order() {
    for expected in [0, 1, 3] {
        mut limit := integers.integer("2147483647")
        validate_signed(&mut limit, expected) == 1
        limit.ok
        limit.value == 2147483647
        limit.error == 0
        mut too_wide := integers.integer("2147483648")
        validate_signed(&mut too_wide, expected) == 1
        !too_wide.ok
        too_wide.value == 2147483648
        too_wide.error == 2
        mut minimum := integers.integer("-2147483648")
        validate_signed(&mut minimum, expected) == 1
        minimum.ok
        mut too_negative := integers.integer("-2147483649")
        validate_signed(&mut too_negative, expected) == 1
        !too_negative.ok
        too_negative.value == -2147483649
        too_negative.error == 2
    }
    mut wide := integers.integer("2147483648")
    validate_signed(&mut wide, 2) == 2
    wide.ok
    wide.error == 0
    mut minimum := integers.integer("-9223372036854775808")
    validate_signed(&mut minimum, 2) == 2
    minimum.ok
    minimum.value == -9223372036854775808
    mut separated := integers.integer("1_024")
    validate_signed(&mut separated, 1) == 1
    separated.ok
    separated.value == 1024
    for spelling in ["9223372036854775808", "-9223372036854775809", "1__2", "", "+", " 2"] {
        for expected in [1, 2, 3] {
            mut parsed := integers.integer(spelling)
            old_value := parsed.value; old_error := parsed.error
            chosen := validate_signed(&mut parsed, expected)
            if expected == 2 { chosen == 2 } else { chosen == 1 }
            !parsed.ok
            parsed.value == old_value
            parsed.error == old_error
        }
    }
    mut failed := integers.Integer { ok: false, value: 2147483648, error: 77 }
    validate_signed(&mut failed, 1) == 1
    !failed.ok
    failed.value == 2147483648
    failed.error == 77
    reserved("i32")
    reserved("impl")
    reserved("self")
    reserved("Self")
    precedence("||") < precedence("&&")
    precedence("+") < precedence("*")
    precedence("..") == 0
    opcode("%") == 5
    opcode("||") == 13
    opcode("unknown") == 0
    literal_integer("0xff").value == 255
    literal_integer("-0xff").value == -255
    literal_integer("0X7fff_ffff_ffff_ffff").value == 9223372036854775807
    literal_integer("-0x8000_0000_0000_0000").value == -9223372036854775808
    literal_integer("0x8000_0000_0000_0000").error == 2
    literal_integer("0b1010_0101").value == 165
    literal_integer("-0B101").value == -5
    !literal_integer("0x").ok
    !literal_integer("0b").ok
    !literal_integer("0x_1").ok
    !literal_integer("0b10_").ok
    literal_integer("1_024").value == 1024
}
