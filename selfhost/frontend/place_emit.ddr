import ..backend.arm64 as arm
import place_operation as place
import ..backend.place_lower

pub fn emit(code: &mut arm.Code, op: place.Op, ty: i32, access: i32, form: i32, parameter: i32, source: i32) {
    if code.mir_capture || code.prefixing {
        arm.operand(&mut code, place.header(op, ty, access, form))
        arm.operand(&mut code, place.location(parameter, source))
    } else { place_lower.lower(&mut code, place.tag(op), form, parameter) }
}
