import lexer
import source_diagnostics as diagnostics
import ..bundled

struct FieldDef {
    name: string,
    ty_first: i32,
    ty_end: i32,
}

struct VariantDef {
    name: string,
    payload_start: i32,
    payload_count: i32,
}

struct TypeSpan {
    first: i32,
    end: i32,
}

fn tok(out: &mut lexer.Tokens, kind: lexer.Kind, spelling: string, site: i32) {
    out.kinds.push(kind)
    out.texts.push(spelling.clone())
    out.starts.push(site)
}

fn fail_tok(t: &mut lexer.Tokens, pos: i32, message: string) {
    if !t.ok { return }
    t.ok = false
    t.error = message.clone()
    t.error_at = if pos >= 0 && pos < t.starts.len { t.starts[pos] } else { 0 }
}

fn has_derive(t: &lexer.Tokens) -> bool {
    mut i := 0
    while i + 1 < t.kinds.len {
        if t.kinds[i] == .Symbol && t.texts[i] == "@" && t.kinds[i + 1] == .Name && t.texts[i + 1] == "derive" {
            return true
        }
        i += 1
    }
    false
}

fn skip_newlines(t: &lexer.Tokens, start: i32, limit: i32) -> i32 {
    mut at := start
    while at < limit && lexer.is_newline(t.kinds[at]) { at += 1 }
    at
}

fn closing_delims(t: &lexer.Tokens, open: i32, limit: i32, left: string, right: string) -> i32 {
    if open >= limit || t.texts[open] != left { return -1 }
    mut depth := 1
    mut at := open + 1
    while at < limit {
        w := &t.texts[at]
        if w == left { depth += 1 }
        else if w == right {
            depth -= 1
            if depth == 0 { return at }
        }
        at += 1
    }
    -1
}

fn trim_type_range(t: &lexer.Tokens, first_in: i32, end_in: i32, first_out: &mut i32, end_out: &mut i32) {
    mut first := skip_newlines(&t, first_in, end_in)
    mut end := end_in
    while end > first && lexer.is_newline(t.kinds[end - 1]) { end -= 1 }
    first_out = first
    end_out = end
}

fn emit_range(t: &lexer.Tokens, first: i32, end: i32, out: &mut lexer.Tokens, site: i32) {
    for i in first..end {
        tok(&mut out, t.kinds[i], t.texts[i], site)
    }
}

fn emit_where(out: &mut lexer.Tokens, t: &lexer.Tokens, trait_pre: string, param_names: &[]string,
              inline_bounds: &[]TypeSpan, where_first: i32, where_end: i32, site: i32) {
    has_orig := where_end > where_first || inline_bounds.len > 0
    if param_names.len == 0 && !has_orig { return }
    tok(&mut out, .Keyword, "where", site)
    mut need_comma := false
    if where_end > where_first {
        mut wf := skip_newlines(&t, where_first, where_end)
        mut we := where_end
        while we > wf && lexer.is_newline(t.kinds[we - 1]) { we -= 1 }
        if we > wf && t.texts[we - 1] == "," { we -= 1 }
        if we > wf {
            emit_range(&t, wf, we, &mut out, site)
            need_comma = true
        }
    }
    mut bi := 0
    while bi < inline_bounds.len {
        if need_comma { tok(&mut out, .Symbol, ",", site) }
        p_tok := inline_bounds[bi].first
        tok(&mut out, .Name, t.texts[p_tok], site)
        tok(&mut out, .Symbol, ":", site)
        emit_range(&t, inline_bounds[bi].first + 2, inline_bounds[bi].end, &mut out, site)
        need_comma = true
        bi += 1
    }
    for p in param_names {
        if need_comma { tok(&mut out, .Symbol, ",", site) }
        tok(&mut out, .Name, p, site)
        tok(&mut out, .Symbol, ":", site)
        tok(&mut out, .Name, trait_pre, site)
        need_comma = true
    }
}

fn emit_impl_open(out: &mut lexer.Tokens, t: &lexer.Tokens, trait_short: string, raw_name: string,
                  param_names: &[]string, inline_bounds: &[]TypeSpan, where_first: i32, where_end: i32, site: i32) {
    trait_pre := bundled.prelude_name(trait_short)
    tok(&mut out, .Newline, "\n", site)
    tok(&mut out, .Keyword, "impl", site)
    tok(&mut out, .Name, trait_pre, site)
    tok(&mut out, .Keyword, "for", site)
    tok(&mut out, .Name, raw_name, site)
    if param_names.len > 0 {
        tok(&mut out, .Symbol, "<", site)
        for i in 0..param_names.len {
            if i > 0 { tok(&mut out, .Symbol, ",", site) }
            tok(&mut out, .Name, param_names[i], site)
        }
        tok(&mut out, .Symbol, ">", site)
    }
    emit_where(&mut out, &t, trait_pre, &param_names, &inline_bounds, where_first, where_end, site)
    tok(&mut out, .Symbol, "{", site)
}

fn emit_default_expr(t: &lexer.Tokens, raw_first: i32, raw_end: i32, out: &mut lexer.Tokens, site: i32) {
    mut first := 0; mut end := 0
    trim_type_range(&t, raw_first, raw_end, &mut first, &mut end)
    if first >= end { return }
    if end - first >= 2 && t.texts[first] == "(" && t.texts[end - 1] == ")" {
        if closing_delims(&t, first, end, "(", ")") == end - 1 {
            mut commas := 0
            mut depth := 0
            mut split_starts: []i32 = [first + 1]
            mut split_ends: []i32 = []
            for i in first + 1..end - 1 {
                w := &t.texts[i]
                if w == "(" || w == "[" || w == "{" || w == "<" { depth += 1 }
                else if w == ")" || w == "]" || w == "}" || w == ">" { if depth > 0 { depth -= 1 } }
                else if depth == 0 && w == "," {
                    split_ends.push(i); split_starts.push(i + 1); commas += 1
                }
            }
            split_ends.push(end - 1)
            if commas == 0 {
                emit_default_expr(&t, first + 1, end - 1, &mut out, site)
                return
            }
            tok(&mut out, .Symbol, "(", site)
            for k in 0..split_starts.len {
                if k > 0 { tok(&mut out, .Symbol, ",", site) }
                emit_default_expr(&t, split_starts[k], split_ends[k], &mut out, site)
            }
            tok(&mut out, .Symbol, ")", site)
            return
        }
    }
    if end - first >= 2 && t.texts[first] == "[" && t.texts[first + 1] == "]" {
        tok(&mut out, .Symbol, "[", site); tok(&mut out, .Symbol, "]", site)
        return
    }
    if end - first >= 4 && t.texts[first] == "[" && t.texts[end - 1] == "]" {
        mut semi := -1; mut depth := 0
        for i in first + 1..end - 1 {
            w := &t.texts[i]
            if w == "(" || w == "[" || w == "{" || w == "<" { depth += 1 }
            else if w == ")" || w == "]" || w == "}" || w == ">" { if depth > 0 { depth -= 1 } }
            else if depth == 0 && w == ";" { semi = i; break }
        }
        if semi > first + 1 && semi + 2 == end - 1 && t.kinds[semi + 1] == .Integer {
            mut count: i32 = 0
            len_s := &t.texts[semi + 1]
            mut valid_len := len_s.len > 0 && len_s.len <= 3
            if valid_len {
                for ci in 0..len_s.len {
                    d := len_s[ci..ci + 1]
                    if d < "0" || d > "9" { valid_len = false; break }
                    count = count * 10 + (i32(len_s[ci]) - 48)
                }
            }
            if valid_len && count > 0 && count <= 64 {
                tok(&mut out, .Symbol, "[", site)
                for k in 0..count {
                    if k > 0 { tok(&mut out, .Symbol, ",", site) }
                    emit_default_expr(&t, first + 1, semi, &mut out, site)
                }
                tok(&mut out, .Symbol, "]", site)
                return
            }
        }
    }
    emit_range(&t, first, end, &mut out, site)
    tok(&mut out, .Symbol, "::", site)
    tok(&mut out, .Name, "default", site)
    tok(&mut out, .Symbol, "(", site)
    tok(&mut out, .Symbol, ")", site)
}

fn emit_eq_struct(out: &mut lexer.Tokens, fields: &[]FieldDef, site: i32) {
    tok(&mut out, .Keyword, "fn", site); tok(&mut out, .Name, "eq", site)
    tok(&mut out, .Symbol, "(", site)
    tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "self", site)
    tok(&mut out, .Symbol, ",", site)
    tok(&mut out, .Name, "other", site); tok(&mut out, .Symbol, ":", site)
    tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "Self", site)
    tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Symbol, "->", site); tok(&mut out, .Name, "bool", site)
    tok(&mut out, .Symbol, "{", site)
    tok(&mut out, .Keyword, "true", site)
    for f in fields {
        tok(&mut out, .Symbol, "&&", site)
        tok(&mut out, .Name, "self", site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, f.name, site)
        tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "eq", site); tok(&mut out, .Symbol, "(", site)
        tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "other", site); tok(&mut out, .Symbol, ".", site)
        tok(&mut out, .Name, f.name, site); tok(&mut out, .Symbol, ")", site)
    }
    tok(&mut out, .Symbol, "}", site)
    tok(&mut out, .Symbol, "}", site)
}

fn emit_eq_enum(out: &mut lexer.Tokens, variants: &[]VariantDef, is_data: bool, site: i32) {
    tok(&mut out, .Keyword, "fn", site); tok(&mut out, .Name, "eq", site)
    tok(&mut out, .Symbol, "(", site)
    tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "self", site)
    tok(&mut out, .Symbol, ",", site)
    tok(&mut out, .Name, "other", site); tok(&mut out, .Symbol, ":", site)
    tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "Self", site)
    tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Symbol, "->", site); tok(&mut out, .Name, "bool", site)
    tok(&mut out, .Symbol, "{", site)
    if !is_data {
        tok(&mut out, .Name, "self", site); tok(&mut out, .Symbol, "==", site); tok(&mut out, .Name, "other", site)
        tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
        return
    }
    tok(&mut out, .Keyword, "match", site); tok(&mut out, .Name, "self", site); tok(&mut out, .Symbol, "{", site)
    for v in variants {
        tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, v.name, site)
        if v.payload_count > 0 {
            tok(&mut out, .Symbol, "(", site)
            for p in 0..v.payload_count {
                if p > 0 { tok(&mut out, .Symbol, ",", site) }
                tok(&mut out, .Name, "__a" + p.str(), site)
            }
            tok(&mut out, .Symbol, ")", site)
        }
        tok(&mut out, .Symbol, "=>", site)
        tok(&mut out, .Keyword, "match", site); tok(&mut out, .Name, "other", site); tok(&mut out, .Symbol, "{", site)
        tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, v.name, site)
        if v.payload_count > 0 {
            tok(&mut out, .Symbol, "(", site)
            for p in 0..v.payload_count {
                if p > 0 { tok(&mut out, .Symbol, ",", site) }
                tok(&mut out, .Name, "__b" + p.str(), site)
            }
            tok(&mut out, .Symbol, ")", site)
        }
        tok(&mut out, .Symbol, "=>", site); tok(&mut out, .Keyword, "true", site)
        for p in 0..v.payload_count {
            tok(&mut out, .Symbol, "&&", site)
            tok(&mut out, .Name, "__a" + p.str(), site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "eq", site)
            tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "__b" + p.str(), site)
            tok(&mut out, .Symbol, ")", site)
        }
        tok(&mut out, .Symbol, ",", site)
        if variants.len > 1 {
            tok(&mut out, .Name, "_", site); tok(&mut out, .Symbol, "=>", site); tok(&mut out, .Keyword, "false", site)
            tok(&mut out, .Symbol, ",", site)
        }
        tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, ",", site)
    }
    tok(&mut out, .Symbol, "}", site)
    tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
}

fn emit_hash_mix(out: &mut lexer.Tokens, expr_kind: i32, name_or_tag: string, site: i32) {
    tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, "=", site)
    tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "bit_xor", site)
    tok(&mut out, .Symbol, "(", site)
    if expr_kind == 0 {
        tok(&mut out, .Name, "self", site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, name_or_tag, site)
        tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "hash", site); tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, ")", site)
    } else if expr_kind == 1 {
        tok(&mut out, .Name, "u64", site); tok(&mut out, .Symbol, "(", site); tok(&mut out, .Integer, name_or_tag, site); tok(&mut out, .Symbol, ")", site)
    } else {
        tok(&mut out, .Name, name_or_tag, site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "hash", site)
        tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, ")", site)
    }
    tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "wrapping_mul", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Name, "u64", site); tok(&mut out, .Symbol, "(", site)
    tok(&mut out, .Integer, "16777619", site); tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Newline, "\n", site)
}

fn emit_hash_struct(out: &mut lexer.Tokens, fields: &[]FieldDef, site: i32) {
    tok(&mut out, .Keyword, "fn", site); tok(&mut out, .Name, "hash", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "self", site)
    tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, "->", site); tok(&mut out, .Name, "u64", site)
    tok(&mut out, .Symbol, "{", site)
    tok(&mut out, .Keyword, "mut", site); tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, ":", site)
    tok(&mut out, .Name, "u64", site); tok(&mut out, .Symbol, "=", site)
    tok(&mut out, .Name, "u64", site); tok(&mut out, .Symbol, "(", site); tok(&mut out, .Integer, "2166136261", site); tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Newline, "\n", site)
    for f in fields { emit_hash_mix(&mut out, 0, f.name, site) }
    tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "bit_xor", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, ".", site)
    tok(&mut out, .Name, "shr", site); tok(&mut out, .Symbol, "(", site); tok(&mut out, .Integer, "32", site)
    tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
}

fn emit_hash_enum(out: &mut lexer.Tokens, variants: &[]VariantDef, site: i32) {
    tok(&mut out, .Keyword, "fn", site); tok(&mut out, .Name, "hash", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "self", site)
    tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, "->", site); tok(&mut out, .Name, "u64", site)
    tok(&mut out, .Symbol, "{", site)
    tok(&mut out, .Keyword, "mut", site); tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, ":", site)
    tok(&mut out, .Name, "u64", site); tok(&mut out, .Symbol, "=", site)
    tok(&mut out, .Name, "u64", site); tok(&mut out, .Symbol, "(", site); tok(&mut out, .Integer, "2166136261", site); tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Newline, "\n", site)
    tok(&mut out, .Keyword, "match", site); tok(&mut out, .Name, "self", site); tok(&mut out, .Symbol, "{", site)
    for vi in 0..variants.len {
        v := &variants[vi]
        tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, v.name, site)
        if v.payload_count > 0 {
            tok(&mut out, .Symbol, "(", site)
            for p in 0..v.payload_count {
                if p > 0 { tok(&mut out, .Symbol, ",", site) }
                tok(&mut out, .Name, "__v" + p.str(), site)
            }
            tok(&mut out, .Symbol, ")", site)
        }
        tok(&mut out, .Symbol, "=>", site); tok(&mut out, .Symbol, "{", site)
        emit_hash_mix(&mut out, 1, vi.str(), site)
        for p in 0..v.payload_count { emit_hash_mix(&mut out, 2, "__v" + p.str(), site) }
        tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, ",", site)
    }
    tok(&mut out, .Symbol, "}", site); tok(&mut out, .Newline, "\n", site)
    tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "bit_xor", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Name, "__h", site); tok(&mut out, .Symbol, ".", site)
    tok(&mut out, .Name, "shr", site); tok(&mut out, .Symbol, "(", site); tok(&mut out, .Integer, "32", site)
    tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
}

fn emit_display_struct(out: &mut lexer.Tokens, shown: string, fields: &[]FieldDef, site: i32) {
    tok(&mut out, .Keyword, "fn", site); tok(&mut out, .Name, "str", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "self", site)
    tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, "->", site); tok(&mut out, .Name, "string", site)
    tok(&mut out, .Symbol, "{", site)
    if fields.len == 0 {
        tok(&mut out, .String, shown + " {}", site)
        tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
        return
    }
    tok(&mut out, .Keyword, "mut", site); tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, ":=", site)
    tok(&mut out, .String, shown + " { ", site); tok(&mut out, .Newline, "\n", site)
    for fi in 0..fields.len {
        fname := &fields[fi].name
        tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, "=", site)
        tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, "+", site)
        prefix := if fi > 0 { ", " + fname + ": " } else { fname + ": " }
        tok(&mut out, .String, prefix, site); tok(&mut out, .Symbol, "+", site)
        tok(&mut out, .Name, "self", site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, fname, site)
        tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "str", site); tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, ")", site)
        tok(&mut out, .Newline, "\n", site)
    }
    tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, "+", site); tok(&mut out, .String, " }", site)
    tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
}

fn emit_display_enum(out: &mut lexer.Tokens, variants: &[]VariantDef, site: i32) {
    tok(&mut out, .Keyword, "fn", site); tok(&mut out, .Name, "str", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, "&", site); tok(&mut out, .Name, "self", site)
    tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, "->", site); tok(&mut out, .Name, "string", site)
    tok(&mut out, .Symbol, "{", site)
    tok(&mut out, .Keyword, "match", site); tok(&mut out, .Name, "self", site); tok(&mut out, .Symbol, "{", site)
    for v in variants {
        tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, v.name, site)
        if v.payload_count == 0 {
            tok(&mut out, .Symbol, "=>", site); tok(&mut out, .String, v.name, site); tok(&mut out, .Symbol, ",", site)
            continue
        }
        tok(&mut out, .Symbol, "(", site)
        for p in 0..v.payload_count {
            if p > 0 { tok(&mut out, .Symbol, ",", site) }
            tok(&mut out, .Name, "__v" + p.str(), site)
        }
        tok(&mut out, .Symbol, ")", site); tok(&mut out, .Symbol, "=>", site); tok(&mut out, .Symbol, "{", site)
        tok(&mut out, .Keyword, "mut", site); tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, ":=", site)
        tok(&mut out, .String, v.name + "(", site); tok(&mut out, .Newline, "\n", site)
        for p in 0..v.payload_count {
            tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, "=", site)
            tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, "+", site)
            if p > 0 { tok(&mut out, .String, ", ", site); tok(&mut out, .Symbol, "+", site) }
            tok(&mut out, .Name, "__v" + p.str(), site); tok(&mut out, .Symbol, ".", site); tok(&mut out, .Name, "str", site)
            tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, ")", site); tok(&mut out, .Newline, "\n", site)
        }
        tok(&mut out, .Name, "__s", site); tok(&mut out, .Symbol, "+", site); tok(&mut out, .String, ")", site)
        tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, ",", site)
    }
    tok(&mut out, .Symbol, "}", site)
    tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
}

fn emit_default_struct(out: &mut lexer.Tokens, t: &lexer.Tokens, fields: &[]FieldDef, site: i32) {
    tok(&mut out, .Keyword, "fn", site); tok(&mut out, .Name, "default", site)
    tok(&mut out, .Symbol, "(", site); tok(&mut out, .Symbol, ")", site)
    tok(&mut out, .Symbol, "->", site); tok(&mut out, .Name, "Self", site)
    tok(&mut out, .Symbol, "{", site)
    tok(&mut out, .Name, "Self", site); tok(&mut out, .Symbol, "{", site)
    for fi in 0..fields.len {
        if fi > 0 { tok(&mut out, .Symbol, ",", site) }
        tok(&mut out, .Name, fields[fi].name, site); tok(&mut out, .Symbol, ":", site)
        emit_default_expr(&t, fields[fi].ty_first, fields[fi].ty_end, &mut out, site)
    }
    tok(&mut out, .Symbol, "}", site)
    tok(&mut out, .Symbol, "}", site); tok(&mut out, .Symbol, "}", site)
}

fn parse_struct_fields(t: &lexer.Tokens, open: i32, close: i32, fields: &mut []FieldDef) {
    mut at := skip_newlines(&t, open + 1, close)
    while at < close {
        if t.kinds[at] != .Name || at + 1 >= close || t.texts[at + 1] != ":" {
            at += 1; continue
        }
        fname := t.texts[at].clone()
        at += 2
        ty_first := at
        mut depth := 0
        while at < close {
            w := &t.texts[at]
            if w == "(" || w == "[" || w == "{" || w == "<" { depth += 1 }
            else if w == ")" || w == "]" || w == "}" || w == ">" { if depth > 0 { depth -= 1 } }
            else if depth == 0 && (w == "," || lexer.is_newline(t.kinds[at])) { break }
            at += 1
        }
        fields.push(FieldDef { name: move fname, ty_first: ty_first, ty_end: at })
        while at < close && (t.texts[at] == "," || lexer.is_newline(t.kinds[at])) { at += 1 }
    }
}

fn parse_enum_variants(t: &lexer.Tokens, open: i32, close: i32, variants: &mut []VariantDef, is_data: &mut bool) {
    mut at := skip_newlines(&t, open + 1, close)
    while at < close {
        if t.kinds[at] != .Name { at += 1; continue }
        vname := t.texts[at].clone(); at += 1
        mut pcount := 0
        if at < close && t.texts[at] == "(" {
            pclose := closing_delims(&t, at, close, "(", ")")
            if pclose > at {
                is_data = true
                mut pat := skip_newlines(&t, at + 1, pclose)
                mut depth := 0
                mut saw_tok := false
                while pat < pclose {
                    w := &t.texts[pat]
                    if w == "(" || w == "[" || w == "{" || w == "<" { saw_tok = true; depth += 1 }
                    else if w == ")" || w == "]" || w == "}" || w == ">" { saw_tok = true; if depth > 0 { depth -= 1 } }
                    else if depth == 0 && w == "," { if saw_tok { pcount += 1; saw_tok = false } }
                    else if !lexer.is_newline(t.kinds[pat]) { saw_tok = true }
                    pat += 1
                }
                if saw_tok { pcount += 1 }
                at = pclose + 1
            }
        }
        variants.push(VariantDef { name: move vname, payload_start: 0, payload_count: pcount })
        mut depth := 0
        while at < close {
            w := &t.texts[at]
            if w == "(" || w == "[" || w == "{" { depth += 1 }
            else if w == ")" || w == "]" || w == "}" { if depth > 0 { depth -= 1 } }
            else if depth == 0 && (w == "," || lexer.is_newline(t.kinds[at])) { break }
            at += 1
        }
        while at < close && (t.texts[at] == "," || lexer.is_newline(t.kinds[at])) { at += 1 }
    }
}

fn parse_generic_params(t: &lexer.Tokens, after_name: i32, limit: i32,
                        param_names: &mut []string, inline_bounds: &mut []TypeSpan) -> i32 {
    if after_name >= limit || t.texts[after_name] != "<" { return after_name }
    close := closing_delims(&t, after_name, limit, "<", ">")
    if close < 0 { return after_name }
    mut at := skip_newlines(&t, after_name + 1, close)
    while at < close {
        if t.kinds[at] == .Name {
            p_tok := at
            param_names.push(t.texts[at].clone())
            at += 1
            at = skip_newlines(&t, at, close)
            if at < close && t.texts[at] == ":" {
                at += 1
                mut bstart := at
                mut depth := 0
                while at < close {
                    w := &t.texts[at]
                    if w == "(" || w == "[" || w == "{" || w == "<" { depth += 1 }
                    else if w == ")" || w == "]" || w == "}" || w == ">" { if depth > 0 { depth -= 1 } }
                    else if depth == 0 && (w == "+" || w == ",") {
                        if at > bstart {
                            inline_bounds.push(TypeSpan { first: p_tok, end: at })
                        }
                        if w == "+" { at += 1; bstart = at; continue }
                        break
                    }
                    at += 1
                }
                if at > bstart { inline_bounds.push(TypeSpan { first: p_tok, end: at }) }
            }
        } else {
            at += 1
        }
        while at < close && (t.texts[at] == "," || lexer.is_newline(t.kinds[at])) { at += 1 }
    }
    close + 1
}

pub fn expand(tokens: &mut lexer.Tokens, sources: &diagnostics.Sources) {
    if !tokens.ok || !has_derive(&tokens) { return }
    eq_pre := bundled.prelude_name("Eq")
    hash_pre := bundled.prelude_name("Hash")
    disp_pre := bundled.prelude_name("Display")
    def_pre := bundled.prelude_name("Default")
    last := tokens.kinds.len - 1
    mut out := lexer.empty(false)
    mut i := 0
    mut depth := 0
    while i < last && tokens.ok {
        if tokens.kinds[i] == .Symbol && tokens.texts[i] == "@" && i + 1 < last &&
            tokens.kinds[i + 1] == .Name && tokens.texts[i + 1] == "derive" {
            if depth != 0 {
                fail_tok(&mut tokens, i, "@derive is only valid on top-level struct or enum declarations")
                return
            }
            mut derives: []string = []
            mut derive_tok := i
            mut cur := i
            while cur < last && tokens.kinds[cur] == .Symbol && tokens.texts[cur] == "@" && cur + 1 < last && tokens.texts[cur + 1] == "derive" {
                d_tok := cur
                cur += 2
                if cur >= last || tokens.texts[cur] != "(" {
                    fail_tok(&mut tokens, d_tok, "expected '(' after '@derive'")
                    return
                }
                cur += 1
                cur = skip_newlines(&tokens, cur, last)
                if cur < last && tokens.texts[cur] == ")" {
                    fail_tok(&mut tokens, cur, "expected at least one trait in '@derive(...)'")
                    return
                }
                while cur < last && tokens.texts[cur] != ")" {
                    if tokens.kinds[cur] != .Name {
                        fail_tok(&mut tokens, cur, "expected trait name in '@derive(...)'")
                        return
                    }
                    raw_trait := tokens.texts[cur].clone()
                    mut canonical := ""
                    if raw_trait == "Eq" || raw_trait == eq_pre { canonical = "Eq" }
                    else if raw_trait == "Hash" || raw_trait == hash_pre { canonical = "Hash" }
                    else if raw_trait == "Display" || raw_trait == disp_pre { canonical = "Display" }
                    else if raw_trait == "Default" || raw_trait == def_pre { canonical = "Default" }
                    else {
                        fail_tok(&mut tokens, cur, "unknown derive trait '" + raw_trait + "' (expected Eq, Hash, Display, or Default)")
                        return
                    }
                    for prev in &derives {
                        if prev == canonical {
                            fail_tok(&mut tokens, cur, "duplicate trait '" + canonical + "' in '@derive'")
                            return
                        }
                    }
                    derives.push(move canonical)
                    cur += 1
                    cur = skip_newlines(&tokens, cur, last)
                    if cur < last && tokens.texts[cur] == "," {
                        cur += 1
                        cur = skip_newlines(&tokens, cur, last)
                    } else { break }
                }
                if cur >= last || tokens.texts[cur] != ")" {
                    fail_tok(&mut tokens, d_tok, "expected ')' closing '@derive'")
                    return
                }
                cur += 1
                cur = skip_newlines(&tokens, cur, last)
                while cur < last {
                    if tokens.kinds[cur] == .Symbol && tokens.texts[cur] == "@" && cur + 1 < last && tokens.texts[cur + 1] != "derive" {
                        tok(&mut out, tokens.kinds[cur], tokens.texts[cur], tokens.starts[cur])
                        cur += 1
                        tok(&mut out, tokens.kinds[cur], tokens.texts[cur], tokens.starts[cur])
                        cur += 1
                        if cur < last && tokens.texts[cur] == "(" {
                            ac := closing_delims(&tokens, cur, last, "(", ")")
                            if ac < 0 { fail_tok(&mut tokens, cur, "unclosed attribute"); return }
                            for k in cur..ac + 1 { tok(&mut out, tokens.kinds[k], tokens.texts[k], tokens.starts[k]) }
                            cur = ac + 1
                        }
                        cur = skip_newlines(&tokens, cur, last)
                    } else if tokens.texts[cur] == "pub" || tokens.texts[cur] == "opaque" {
                        tok(&mut out, tokens.kinds[cur], tokens.texts[cur], tokens.starts[cur])
                        cur = skip_newlines(&tokens, cur + 1, last)
                    } else { break }
                }
            }
            if cur + 1 >= last || (tokens.texts[cur] != "struct" && tokens.texts[cur] != "enum") || tokens.kinds[cur + 1] != .Name {
                fail_tok(&mut tokens, derive_tok, "@derive can only be applied to a struct or enum")
                return
            }
            kw_tok := cur
            is_enum := tokens.texts[kw_tok] == "enum"
            decl_site := tokens.starts[kw_tok]
            raw_name := tokens.texts[kw_tok + 1].clone()
            mut param_names: []string = []
            mut inline_bounds: []TypeSpan = []
            after_params := parse_generic_params(&tokens, kw_tok + 2, last, &mut param_names, &mut inline_bounds)
            mut open := skip_newlines(&tokens, after_params, last)
            mut where_first := open; mut where_end := open
            if open < last && tokens.texts[open] == "where" {
                where_first = open + 1
                mut at := where_first
                while at < last && tokens.texts[at] != "{" { at += 1 }
                where_end = at
                open = at
            }
            if open >= last || tokens.texts[open] != "{" {
                fail_tok(&mut tokens, kw_tok, "expected '{' in derived type declaration")
                return
            }
            close := closing_delims(&tokens, open, last, "{", "}")
            if close < 0 {
                fail_tok(&mut tokens, open, "unterminated declaration body in '@derive'")
                return
            }
            for k in kw_tok..close + 1 {
                tok(&mut out, tokens.kinds[k], tokens.texts[k], tokens.starts[k])
            }
            mut has_default := false
            for dt in &derives { if dt == "Default" { has_default = true } }
            if is_enum && has_default {
                fail_tok(&mut tokens, derive_tok, "cannot derive Default for enum; implement Default manually")
                return
            }
            mut fields: []FieldDef = []
            mut variants: []VariantDef = []
            mut is_data := false
            if is_enum {
                parse_enum_variants(&tokens, open, close, &mut variants, &mut is_data)
            } else {
                parse_struct_fields(&tokens, open, close, &mut fields)
            }
            shown := diagnostics.display_symbol(&sources, raw_name.clone())
            for dt in &derives {
                emit_impl_open(&mut out, &tokens, dt, raw_name, &param_names, &inline_bounds, where_first, where_end, decl_site)
                if dt == "Eq" {
                    if is_enum { emit_eq_enum(&mut out, &variants, is_data, decl_site) }
                    else { emit_eq_struct(&mut out, &fields, decl_site) }
                } else if dt == "Hash" {
                    if is_enum { emit_hash_enum(&mut out, &variants, decl_site) }
                    else { emit_hash_struct(&mut out, &fields, decl_site) }
                } else if dt == "Display" {
                    if is_enum { emit_display_enum(&mut out, &variants, decl_site) }
                    else { emit_display_struct(&mut out, shown.clone(), &fields, decl_site) }
                } else if dt == "Default" {
                    emit_default_struct(&mut out, &tokens, &fields, decl_site)
                }
            }
            i = close + 1
            continue
        }
        w := &tokens.texts[i]
        if tokens.kinds[i] == .Symbol {
            if w == "{" { depth += 1 }
            else if w == "}" { depth -= 1 }
        }
        tok(&mut out, tokens.kinds[i], tokens.texts[i], tokens.starts[i])
        i += 1
    }
    tok(&mut out, .End, "", tokens.starts[last])
    tokens.kinds = move out.kinds
    tokens.texts = move out.texts
    tokens.starts = move out.starts
}
