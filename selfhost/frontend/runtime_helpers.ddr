// Emission of immortal string literal pool entries and shared collection
// clone/drop runtime helpers linked into native and Wasm images.
import ..backend.arm64 as arm
import ..backend.ffi_abi as fa
import ..runtime.runtime

pub fn emit_literal(code: &mut arm.Code, text: string, label: i32) {
    if code.words.len % 2 != 0 { arm.emit(&mut code, 0) }
    arm.emit(&mut code, 0); arm.emit(&mut code, 0) // immortal literal reference count
    arm.mark(&mut code, label)
    arm.emit(&mut code, i64(text.len)); arm.emit(&mut code, 0)
    mut cursor := 0
    while cursor < text.len {
        mut word: i64 = 0; mut factor: i64 = 1
        for j in 0..4 {
            if cursor < text.len { word = word + i64(text[cursor]) * factor; cursor = cursor + 1 }
            factor = factor * 256
        }
        arm.emit(&mut code, word)
    }
    if text.len % 4 == 0 { arm.emit(&mut code, 0) }
}

fn emit_collection_helper(code: &mut arm.Code, rt: &runtime.Runtime, label: i32, strings: bool) {
    arm.mark(&mut code, label)
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    arm.branch(&mut code, rt.array_clone, 1)
    if strings {
        // Older explicit string producers have no descriptor callbacks.
        // Managed producers already retained their elements in array_clone.
        managed := arm.label(&mut code)
        fa.load_mem(&mut code, 1, 0, 32); arm.compare_register(&mut code, 1, 31)
        arm.branch(&mut code, managed, 3); arm.branch(&mut code, rt.retain_elements, 1)
        arm.mark(&mut code, managed)
    }
    arm.ret(&mut code)
    arm.mark(&mut code, label + 1)
    drop_frame := arm.prologue(&mut code); mut slots := 0; if strings { slots = 1 }
    arm.frame(&mut code, drop_frame, slots)
    if strings {
        done := arm.label(&mut code); managed := arm.label(&mut code)
        arm.branch(&mut code, done, 18); arm.store(&mut code, 0, 0)
        fa.load_mem(&mut code, 1, 0, 40); arm.compare_register(&mut code, 1, 31)
        arm.branch(&mut code, managed, 3); arm.branch(&mut code, rt.release_elements, 1)
        arm.mark(&mut code, managed); arm.load(&mut code, 0); arm.branch(&mut code, rt.array_drop, 1)
        arm.mark(&mut code, done)
    } else { arm.branch(&mut code, rt.array_drop, 1) }
    arm.ret(&mut code)
}

pub fn emit_array_helpers(code: &mut arm.Code, rt: &runtime.Runtime, array_helpers: i32) {
    // Detached cached bodies can be the only users of a collection shape.
    // Include calls from nominal clone/drop helpers emitted above.
    mut raw := false; mut strings := false
    for label in code.target {
        delta := label - array_helpers
        if delta == 0 || delta == 1 { raw = true }
        if delta == 2 || delta == 3 { strings = true }
        if raw && strings { break }
    }
    if raw { emit_collection_helper(&mut code, &rt, array_helpers, false) }
    if strings { emit_collection_helper(&mut code, &rt, array_helpers + 2, true) }
}
