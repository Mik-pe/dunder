import lexer
import open_bodies
import ..bundled
import type_keys
import type_reader
import type_syntax as syntax
import frontend_types as ft
import std.map as map
import std.text as text

fn token(out: &mut lexer.Tokens, kind: lexer.Kind, spelling: string, position: i32) {
    out.kinds.push(kind); out.texts.push(spelling.clone()); out.starts.push(position)
}

pub struct Layout {
    first: i32, starts: []i32, positions: []i32, end: i32,
    reserved: map.Map, requirements: Requirements, instance_ids: map.Map, function_instances: []i32,
    sites: []i32, parents: []i32, error_function: i32, pending: map.Map, definition_checks: map.Map,
}
pub struct Requirements { receivers: []i32, methods: []string, signatures: []i32, sites: []i32 }
fn requirements() -> Requirements { Requirements {receivers:[], methods:[], signatures:[], sites:[]} }
pub fn layout() -> Layout { Layout {first:-1, starts:[], positions:[], end:-1, reserved:map.new(), requirements:requirements(), instance_ids:map.new(), function_instances:[], sites:[], parents:[], error_function:-1, pending:map.new(), definition_checks:map.new()} }
pub fn generated(layout: &Layout, position: i32) -> bool {
    layout.first >= 0 && position >= layout.first && position < layout.end
}
pub fn origin(layout: &Layout, position: i32) -> i32 {
    if !generated(&layout, position) { return position }
    mut i := layout.starts.len - 1
    while i > 0 && layout.starts[i] > position { i -= 1 }
    layout.positions[i]
}

struct Catalog {
    definitions: map.Map, names: []string, methods: []bool, next_impl: []i32, builtin: []bool,
    counts: []i32, kinds: []i32, c_layout: []bool, result: i32,
    bodies: lexer.Tokens, slots: []i32, starts: []i32, ends: []i32,
    removed: []i32, resume: []i32, constraints: Constraints, constraint_starts: []i32,
}
struct Constraints { parameters: []i32, methods: []string, signatures: lexer.Tokens, starts: []i32, slots: []i32 }
struct Instances {
    index: type_keys.Index, definitions: []i32, names: []string, sites: []i32, parents: []i32,
    depths: []i32, type_depths: []i32,
    arguments: []string, types: []i32, starts: []i32, reserved: map.Map, platform: i32,
    requirements: Requirements, pending: map.Map, error: string, at: i32,
}
fn argument_depth(plan: &Instances, types: &[]i32) -> i32 {
    mut depth := 0
    for ty in &types { if ty >= 0 && ty < plan.type_depths.len && plan.type_depths[ty] > depth { depth = plan.type_depths[ty] } }
    depth
}
fn structural_depth(plan: &mut Instances, ty: i32, depth: i32) {
    while ty >= plan.type_depths.len { plan.type_depths.push(0) }
    plan.type_depths[ty] = depth
}

fn reject(plan: &mut Instances, at: i32, message: string) {
    if plan.error == "" { plan.at = at; plan.error = message.clone() }
}
fn declaration(word: string) -> bool {
    word == "fn" || word == "struct" || word == "enum" || word == "impl"
}
fn prefix(input: &lexer.Tokens, keyword: i32) -> i32 {
    mut first := keyword
    while first > 0 {
        mut p := first - 1
        while p >= 0 && lexer.is_newline(input.kinds[p]) { p -= 1 }
        if p < 0 { break }
        word := &input.texts[p]
        if (word == "pub" || word == "opaque" || word == "unsafe") && p == first - 1 { first = p; continue }
        if lexer.symbol(&input, p, ")") {
            while p > 0 && !lexer.symbol(&input, p, "(") { p -= 1 }
            p -= 1
        }
        if lexer.symbol(&input, p - 1, "@") { first = p - 1; continue }
        break
    }
    first
}
fn signature_end(input: &lexer.Tokens, keyword: i32, after: i32, last: i32) -> i32 {
    mut at := after
    if input.texts[keyword] == "fn" {
        if !lexer.symbol(&input, at, "(") { return last }
        at = lexer.closing(&input, at, last, "(", ")") + 1
        if lexer.symbol(&input, at, "->") {
            at = syntax.type_end(&input, at + 1, last)
            if at + 1 < last && input.texts[at] == "from" { at += 2 }
        }
    }
    while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
    at
}
fn parameter_index(params: &[]string, word: string) -> i32 {
    for i in 0..params.len { if params[i] == word { return i } }
    -1
}
fn constraints(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, params: &[]string, first: i32, last: i32) -> i32 {
    mut at := first
    if input.texts[at] != "where" { return at }
    at += 1
    while at < last {
        while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
        if at >= last { reject(&mut plan, input.starts[last], "expected a where requirement"); return last }
        storage := input.texts[at] == "storable" && lexer.symbol(&input, at + 1, "(")
        if storage { at += 2 }
        if at >= last { reject(&mut plan, input.starts[last], "expected a type parameter in where clause"); return last }
        parameter := parameter_index(&params, input.texts[at])
        if parameter < 0 { reject(&mut plan, input.starts[at], "expected a type parameter in where clause"); return last }
        at += 1
        mut method := ""
        if storage {
            if !lexer.symbol(&input, at, ")") { reject(&mut plan, input.starts[at], "expected ')' in storable requirement"); return last }
            at += 1
        } else {
            if at + 3 >= last || !lexer.symbol(&input, at, ".") || input.kinds[at + 1] != .Name ||
                !lexer.symbol(&input, at + 2, ":") || input.texts[at + 3] != "fn" {
                reject(&mut plan, input.starts[at], "expected a method name and function type in where clause"); return last
            }
            method = input.texts[at + 1].clone(); at += 3
            end := syntax.type_end(&input, at, last)
            if end <= at { reject(&mut plan, input.starts[at], "invalid required function type"); return last }
            for i in at..end {
                token(&mut catalog.constraints.signatures, input.kinds[i], input.texts[i], input.starts[i])
                catalog.constraints.slots.push(parameter_index(&params, input.texts[i]))
            }
            at = end
        }
        catalog.constraints.methods.push(move method); catalog.constraints.parameters.push(parameter)
        catalog.constraints.starts.push(catalog.constraints.slots.len)
        if !lexer.symbol(&input, at, ",") { break }
        at += 1
    }
    at
}
fn capture(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, keyword: i32, builtin: bool) -> i32 {
    last := input.kinds.len - 1
    name := &input.texts[keyword + 1]
    site := input.starts[keyword + 1]
    method := input.texts[keyword] == "impl"
    first := prefix(&input, keyword)
    params := syntax.parameters(&input, keyword + 1)
    if params.error != "" { reject(&mut plan, input.starts[params.after], params.error); return last }
    after := constraints(&mut catalog, &mut plan, &input, &params.names, params.after, last)
    if plan.error != "" { return last }
    mut open := signature_end(&input, keyword, after, last)
    mut trailing := last; mut resume := last
    if open < last && input.texts[open] == "where" {
        trailing = open; resume = constraints(&mut catalog, &mut plan, &input, &params.names, trailing, last)
        open = resume
        while open < last && lexer.is_newline(input.kinds[open]) { open += 1 }
    }
    if !lexer.symbol(&input, open, "{") { open = last }
    catalog.constraint_starts.push(catalog.constraints.methods.len)
    close := lexer.closing(&input, open, last, "{", "}")
    if close == last { reject(&mut plan, site, "expected a generic declaration body"); return last }
    if !method {
        if catalog.definitions.contains(name) { reject(&mut plan, site, "duplicate generic declaration"); return last }
        catalog.definitions.put(name.clone(), i64(catalog.names.len))
    }
    catalog.names.push(name.clone()); catalog.methods.push(method); catalog.next_impl.push(-1); catalog.builtin.push(builtin)
    if builtin && !method && name == bundled.prelude_export("result", "Result") { catalog.result = catalog.names.len - 1 }
    kind := if input.texts[keyword] == "struct" { 2 } else if input.texts[keyword] == "enum" { 3 } else { 0 }
    catalog.kinds.push(kind); catalog.counts.push(params.names.len)
    mut c_layout := false
    for i in first..keyword { if input.texts[i] == "c_layout" { c_layout = true } }
    catalog.c_layout.push(c_layout)
    catalog.starts.push(catalog.slots.len)
    for i in first..close + 1 {
        if (i >= keyword + 2 && i < after) || (i >= trailing && i < resume) { continue }
        mut slot := -1
        if i == keyword + 1 { slot = -2 }
        else if input.kinds[i] == .Name && !lexer.symbol(&input, i - 1, ".") && !lexer.symbol(&input, i - 1, "::") &&
            !lexer.symbol(&input, i + 1, ":") {
            for p in 0..params.names.len {
                if input.texts[i] == params.names[p] { slot = p; break }
            }
        }
        catalog.slots.push(slot)
        token(&mut catalog.bodies, input.kinds[i], input.texts[i], input.starts[i])
    }
    catalog.ends.push(catalog.slots.len)
    if !builtin { catalog.removed.push(first); catalog.resume.push(close + 1) }
    close + 1
}
fn collect(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, builtin: bool, reg: &mut ft.TypeRegistry) {
    mut i := 0
    mut level := 0
    while i + 2 < input.kinds.len && plan.error == "" {
        if level == 0 && declaration(input.texts[i]) && input.kinds[i + 1] == .Name && lexer.symbol(&input, i + 2, "<") {
            i = capture(&mut catalog, &mut plan, &input, i, builtin); continue
        }
        if level == 0 && (input.texts[i] == "struct" || input.texts[i] == "enum") && input.kinds[i + 1] == .Name {
            name := &input.texts[i + 1]
            if ft.type_id(&reg, name) >= 0 { reject(&mut plan, input.starts[i + 1], "duplicate type"); return }
            kind := if input.texts[i] == "struct" { 2 } else { 3 }
            ty := ft.add_type(&mut reg, name, kind, 0); plan.reserved.put(name.clone(), i64(ty))
            for attr in prefix(&input, i)..i { if input.texts[attr] == "c_layout" { reg.c_record[ty] = true } }
        }
        if lexer.symbol(&input, i, "{") { level += 1 }
        else if lexer.symbol(&input, i, "}") { level -= 1 }
        i += 1
    }
}

fn request(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry, def: i32, types: &[]i32, site: i32, parent: i32) -> i32 {
    family := &catalog.names[def]
    known := type_keys.find(&plan.index, def, &types)
    if known >= 0 { return known }
    instance := plan.names.len
    depth := argument_depth(&plan, &types)
    mut repeats := 0; mut ancestor := parent; mut previous_depth := depth
    while ancestor >= 0 {
        if plan.definitions[ancestor] == def && plan.depths[ancestor] < previous_depth {
            repeats += 1; previous_depth = plan.depths[ancestor]
            if repeats >= 64 {
                reject(&mut plan, site, "generic specialization nesting limit: recurring declaration with growing arguments, previous instance " + plan.names[ancestor])
                return -1
            }
        }
        ancestor = plan.parents[ancestor]
    }
    if instance >= 65536 { reject(&mut plan, site, "generic instance count exceeds 65536"); return -1 }
    mut name := family + "<"
    for i in 0..types.len {
        if i > 0 { name += ", " }
        name += ft.type_spelling(&reg, types[i])
        if name.len > 65536 { reject(&mut plan, site, "generic type exceeds compiler resource limit"); return -1 }
    }
    name += ">"
    type_keys.insert(&mut plan.index, def, &types, instance)
    plan.names.push(name.clone()); plan.definitions.push(def); plan.sites.push(site); plan.parents.push(parent); plan.depths.push(depth)
    plan.starts.push(plan.arguments.len)
    for ty in &types { plan.arguments.push(ft.argument_name(&mut reg, ty)) }
    mut nominal := -1
    if catalog.kinds[def] != 0 {
        ty := ft.add_type(&mut reg, name, catalog.kinds[def], 0)
        structural_depth(&mut plan, ty, depth + 1)
        reg.c_record[ty] = catalog.c_layout[def]
        nominal = ty
        plan.reserved.put(name.clone(), i64(ty))
        if def == catalog.result {
            reg.result_success[ty] = types[0]; reg.result_failure[ty] = types[1]
        }
    }
    plan.types.push(nominal)
    require_arguments(&catalog, &source, &mut plan, &mut reg, def, instance, site)
    instance
}
fn require_arguments(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    def: i32, instance: i32, site: i32) {
    for b in catalog.constraint_starts[def]..catalog.constraint_starts[def + 1] {
        bounds_table := &catalog.constraints
        receiver := plan.index.arguments[plan.index.starts[instance] + bounds_table.parameters[b]]
        if bounds_table.methods[b] == "" {
            if !ft.array_element(&reg, receiver) { reject(&mut plan, site, "type argument must be a storable value"); return }
        } else {
            nominal := plan.types[instance]
            required := evaluate(&catalog, &source, &mut plan, &mut reg, source.requirements[b], instance, nominal, site, false)
            if plan.error != "" { return }
            plan.requirements.receivers.push(receiver); plan.requirements.methods.push(bounds_table.methods[b].clone())
            plan.requirements.signatures.push(required); plan.requirements.sites.push(site)
        }
    }
}

struct BoundSource {
    tokens: lexer.Tokens, slots: []i32, applications: []i32, receivers: []i32,
    starts: []i32, ends: []i32, expressions: syntax.Tree, requirements: []i32, method_names: []i32, method_ends: []i32,
}
fn bound_token(source: &mut BoundSource, kind: lexer.Kind, word: string, at: i32, slot: i32, application: i32, receiver: i32) {
    token(&mut source.tokens, kind, word, at); source.slots.push(slot)
    source.applications.push(application); source.receivers.push(receiver)
    source.method_names.push(-1); source.method_ends.push(-1)
}
fn bind_methods(source: &mut BoundSource, first: i32, end: i32) {
    mut at := first
    while at < end {
        if source.tokens.texts[at] != "fn" || source.tokens.kinds[at + 1] != .Name { at += 1; continue }
        name := at + 1; at += 2
        while at < end && !lexer.symbol(&source.tokens, at, "{") { at += 1 }
        if at == end { return }
        close := lexer.closing(&source.tokens, at, end, "{", "}")
        if close == end { return }
        source.method_names[at] = name; source.method_ends[at] = close; at = close + 1
    }
}
fn bind_types(catalog: &Catalog, plan: &mut Instances, reg: &ft.TypeRegistry, tree: &mut syntax.Tree,
    input: &lexer.Tokens, slots: &[]i32, begin: i32, expr: i32, allow_function: bool) {
    for i in begin..expr + 1 {
        form := tree.forms[i]; name := &tree.names[i]
        index := tree.positions[i]
        if form == .Name {
            param := if slots.len == 0 { -1 } else { slots[index] }
            if param >= 0 { tree.values[i] = -2 - param }
            else if name == "Self" { tree.values[i] = -1 }
            else {
                ty := ft.type_id(&reg, name)
                if ty < 0 { reject(&mut plan, input.starts[index], "unknown type '" + name + "'"); return }
                tree.values[i] = ty
            }
        } else if form == .Apply {
            decl := i32(catalog.definitions.get_or(name, -1)); count := tree.starts[i + 1] - tree.starts[i]
            if decl < 0 {
                if name != "TaskID" { reject(&mut plan, input.starts[index], "unknown generic type '" + name + "'"); return }
                if count != 1 { reject(&mut plan, input.starts[index], "TaskID expects one type argument"); return }
            } else if count != catalog.counts[decl] {
                reject(&mut plan, input.starts[index], "wrong number of type arguments: expected " + catalog.counts[decl].str() + ", got " + count.str()); return
            } else if (!allow_function || i != expr) && catalog.kinds[decl] == 0 {
                reject(&mut plan, input.starts[index], "expected a generic type"); return
            }
            tree.values[i] = decl
        }
    }
}
fn bind(catalog: &Catalog, plan: &mut Instances, reg: &ft.TypeRegistry, source: &mut BoundSource,
    input: &lexer.Tokens, first: i32, end: i32, root: bool) {
    mut at := first; mut removed := 0; mut depth := 0; mut receiver := -1
    while at < end && plan.error == "" {
        if root && removed < catalog.removed.len && at == catalog.removed[removed] {
            at = catalog.resume[removed]; removed += 1; continue
        }
        word := &input.texts[at]; kind := input.kinds[at]; site := input.starts[at]
        if root && depth == 0 && word == "impl" && at + 1 < end { receiver = ft.type_id(&reg, input.texts[at + 1]) }
        if lexer.symbol(&input, at, "{") { depth += 1 }
        else if lexer.symbol(&input, at, "}") { depth -= 1; if depth == 0 { receiver = -1 } }
        slot := if root { -1 } else { catalog.slots[at] }
        if kind != .Name || slot != -1 || !lexer.symbol(&input, at + 1, "<") || !catalog.definitions.contains(word) {
            bound_token(&mut source, kind, word, site, slot, -1, receiver); at += 1; continue
        }
        mut cursor := syntax.cursor(at, end)
        begin := source.expressions.forms.len
        expr := syntax.parse(&mut source.expressions, &mut cursor, &input, 0)
        if expr < 0 { reject(&mut plan, site, cursor.error); return }
        if root {
            bind_types(&catalog, &mut plan, &reg, &mut source.expressions, &input, &[], begin, expr, true)
        } else {
            bind_types(&catalog, &mut plan, &reg, &mut source.expressions, &input, &catalog.slots, begin, expr, true)
        }
        if plan.error != "" { return }
        bound_token(&mut source, kind, word, site, slot, expr, receiver)
        if cursor.assignment >= 0 { bound_token(&mut source, .Symbol, "=", input.starts[cursor.assignment] + 1, -1, -1, -1) }
        at = cursor.at
    }
}
fn evaluate(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    id: i32, parent: i32, receiver: i32, site: i32, application: bool) -> i32 {
    tree := &source.expressions
    form := tree.forms[id]; value := tree.values[id]
    if form == .Name {
        if value >= 0 { return value }
        if value == -1 {
            if receiver < 0 { reject(&mut plan, site, "Self is only valid inside an impl block") }
            return receiver
        }
        return plan.index.arguments[plan.index.starts[parent] - 2 - value]
    }
    mut types: []i32 = []
    for i in tree.starts[id]..tree.starts[id + 1] {
        ty := evaluate(&catalog, &source, &mut plan, &mut reg, tree.children[i], parent, receiver, site, false)
        if plan.error != "" { return -1 }
        types.push(ty)
    }
    if form == .Apply && value >= 0 {
        instance := request(&catalog, &source, &mut plan, &mut reg, value, &types, site, parent)
        if instance < 0 || application { return instance }
        return plan.types[instance]
    }
    ty := type_reader.resolve(&mut reg, &tree, id, &types, plan.platform)
    if reg.error != "" { reject(&mut plan, site, reg.error) }
    else if form != .Consume { depth := argument_depth(&plan, &types); structural_depth(&mut plan, ty, depth + 1) }
    ty
}
fn lower(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry, source: &BoundSource,
    output: &mut lexer.Tokens, first: i32, end: i32, instance: i32, builtin: bool, position: &mut i32, wanted: &map.Map) {
    mut cursor := first
    while cursor < end {
        at := cursor; cursor += 1
        mut site := source.tokens.starts[at]
        if builtin { site = position; position += 1 }
        method := source.method_names[at]
        if method >= 0 {
            key := plan.names[instance] + "::" + source.tokens.texts[method]
            if !wanted.contains(key) {
                plan.pending.put(move key, 1)
                token(&mut output, .Symbol, "{", site)
                cursor = source.method_ends[at] + 1
                token(&mut output, .Symbol, "}", if builtin { site } else { source.tokens.starts[cursor - 1] })
                continue
            }
        }
        slot := source.slots[at]; app := source.applications[at]
        if app >= 0 {
            receiver := if instance >= 0 { plan.types[instance] } else { source.receivers[at] }
            target := evaluate(&catalog, &source, &mut plan, &mut reg, app, instance, receiver, site, true)
            if plan.error != "" { return }
            token(&mut output, .Name, plan.names[target], site)
        } else if slot == -2 {
            token(&mut output, .Name, plan.names[instance], site)
        } else if slot >= 0 {
            token(&mut output, .Name, plan.arguments[plan.starts[instance] + slot], site)
        } else {
            token(&mut output, source.tokens.kinds[at], source.tokens.texts[at], site)
        }
    }
}

pub fn needed(input: &lexer.Tokens) -> bool {
    for i in 0..input.kinds.len - 1 {
        if input.kinds[i] != .Name { continue }
        word := &input.texts[i]
        if bundled.primitive_method(word) { return true }
        if !lexer.symbol(&input, i + 1, "<") { continue }
        if text.starts_with(word, "__dunder_module_prelude_") || (i > 0 && declaration(input.texts[i - 1])) { return true }
    }
    false
}
pub struct Program { catalog: Catalog, source: BoundSource, root: i32, checks_start: i32, checks: map.Map, end: i32, reserved: map.Map }
fn definition_checks(catalog: &Catalog, source: &mut BoundSource, plan: &mut Instances) -> map.Map {
    mut view := open_bodies.view()
    mut end := 0; mut methods := map.new()
    for d in 0..catalog.names.len { if !catalog.builtin[d] { end = source.ends[d] } }
    if end == 0 { return move view.names }
    analysis := open_bodies.analyze(&source.tokens, &source.expressions, &source.slots, &source.applications, end)
    for d in 0..catalog.names.len {
        if catalog.builtin[d] { continue }
        first := source.starts[d]; end := source.ends[d]
        if catalog.methods[d] {
            for at in first..end {
                if source.method_names[at] >= 0 {
                    method := source.method_names[at]; key := catalog.names[d] + "::" + source.tokens.texts[method]
                    if methods.contains(key) {
                        reject(&mut plan, source.tokens.starts[method], "duplicate method '" + source.tokens.texts[method] + "' on type")
                        return move view.names
                    }
                    methods.put(move key, 1)
                    open_bodies.function(&mut view, &source.tokens, &analysis,
                        source.method_names[at], at, source.method_ends[at])
                }
            }
        } else {
            mut name := first
            while name < end && source.slots[name] != -2 { name += 1 }
            if name == end { continue }
            if catalog.kinds[d] != 0 { open_bodies.aggregate(&mut view, &source.tokens, &analysis, name, end, catalog.c_layout[d]) }
            else {
                body := signature_end(&source.tokens, name - 1, name + 1, end)
                if body < end { open_bodies.function(&mut view, &source.tokens, &analysis, name, body, end - 1) }
            }
        }
        if !view.tokens.ok { reject(&mut plan, view.tokens.error_at, view.tokens.error); return move view.names }
    }
    for i in 0..view.origins.len {
        origin := view.origins[i]
        app := if origin < 0 { -1 } else { source.applications[origin] }
        bound_token(&mut source, view.tokens.kinds[i], view.tokens.texts[i], view.tokens.starts[i], -1, app, -1)
    }
    move view.names
}
fn instances(platform: i32, move reserved: map.Map) -> Instances {
    Instances { index:type_keys.new(), definitions:[], names:[], sites:[], parents:[], depths:[], type_depths:[], arguments:[], types:[],
        starts:[], reserved:move reserved, platform:platform, requirements:requirements(), pending:map.new(), error:"", at:0 }
}
pub fn bind_program(input: &mut lexer.Tokens, reg: &mut ft.TypeRegistry, platform: i32) -> Program {
    mut catalog := Catalog { definitions:map.new(), names:[], methods:[], next_impl:[], builtin:[], counts:[], kinds:[], c_layout:[], result:-1,
        bodies:lexer.empty(false), slots:[], starts:[], ends:[], removed:[], resume:[],
        constraints:Constraints {parameters:[], methods:[], signatures:lexer.empty(false), starts:[0], slots:[]}, constraint_starts:[0] }
    mut plan := instances(platform, move map.new())
    mut prelude := lexer.scan(bundled.generic_prelude(), false)
    for i in 0..prelude.kinds.len - 1 {
        if prelude.kinds[i] == .Name && lexer.symbol(&prelude, i + 1, "<") {
            exported := bundled.prelude_export("", prelude.texts[i])
            if exported != "" { prelude.texts[i] = move exported }
        }
    }
    collect(&mut catalog, &mut plan, &prelude, true, &mut reg)
    collect(&mut catalog, &mut plan, &input, false, &mut reg)
    for i in 0..catalog.names.len {
        d := catalog.names.len - 1 - i
        if !catalog.methods[d] { continue }
        target := i32(catalog.definitions.get_or(catalog.names[d], -1))
        if target < 0 || catalog.counts[target] != catalog.counts[d] {
            reject(&mut plan, catalog.bodies.starts[catalog.starts[d]], "generic impl must match its type's parameters")
        } else {
            catalog.next_impl[d] = catalog.next_impl[target]
            catalog.next_impl[target] = d
        }
    }
    mut source := BoundSource {tokens:lexer.empty(false), slots:[], applications:[], receivers:[], starts:[], ends:[], expressions:syntax.tree(), requirements:[], method_names:[], method_ends:[]}
    for d in 0..catalog.names.len {
        source.starts.push(source.slots.len)
        bind(&catalog, &mut plan, &reg, &mut source, &catalog.bodies, catalog.starts[d], catalog.ends[d], false)
        source.ends.push(source.slots.len)
        if catalog.methods[d] {
            first := source.starts[d]; end := source.ends[d]
            bind_methods(&mut source, first, end)
        }
    }
    for b in 0..catalog.constraints.methods.len {
        mut expression := -1
        if catalog.constraints.methods[b] != "" && plan.error == "" {
            mut r := syntax.cursor(catalog.constraints.starts[b], catalog.constraints.starts[b + 1])
            first := source.expressions.forms.len
            expression = syntax.parse(&mut source.expressions, &mut r, &catalog.constraints.signatures, 0)
            if expression < 0 { reject(&mut plan, catalog.constraints.signatures.starts[catalog.constraints.starts[b]], r.error) }
            else { bind_types(&catalog, &mut plan, &reg, &mut source.expressions, &catalog.constraints.signatures, &catalog.constraints.slots, first, expression, false) }
        }
        source.requirements.push(expression)
    }
    root := source.slots.len
    bind(&catalog, &mut plan, &reg, &mut source, &input, 0, input.kinds.len - 1, true)
    checks_start := source.slots.len
    mut checks := map.new()
    if plan.error == "" { checks = definition_checks(&catalog, &mut source, &mut plan) }
    if plan.error != "" { input.ok = false; input.error = plan.error.clone(); input.error_at = plan.at }
    catalog.bodies = lexer.empty(false); catalog.slots.clear(); catalog.removed.clear(); catalog.resume.clear()
    Program {catalog:move catalog, source:move source, root:root, checks_start:checks_start, checks:move checks, end:input.starts[input.kinds.len - 1], reserved:move plan.reserved}
}
pub fn materialize(program: &Program, input: &mut lexer.Tokens, reg: &mut ft.TypeRegistry, platform: i32, wanted: &map.Map, definitions: bool) -> Layout {
    mut layout := layout()
    catalog := &program.catalog; source := &program.source; root := program.root
    mut plan := instances(platform, move program.reserved.clone())
    mut output := lexer.empty(false)
    mut position := program.end + 1
    end := if definitions { source.slots.len } else { program.checks_start }
    if definitions { layout.definition_checks = program.checks.clone() }
    lower(&catalog, &mut plan, &mut reg, &source, &mut output, root, end, -1, false, &mut position, &wanted)
    layout.first = position
    mut instance := 0
    while instance < plan.names.len && plan.error == "" {
        def := plan.definitions[instance]
        mut d := def
        while d >= 0 && plan.error == "" {
            site := origin(&layout, plan.sites[instance])
            if catalog.methods[d] && catalog.constraint_starts[d] < catalog.constraint_starts[d + 1] {
                for at in source.starts[d]..source.ends[d] {
                    method := source.method_names[at]
                    if method >= 0 && wanted.contains(plan.names[instance] + "::" + source.tokens.texts[method]) {
                        require_arguments(&catalog, &source, &mut plan, &mut reg, d, instance, site); break
                    }
                }
            }
            if catalog.builtin[d] { layout.starts.push(position); layout.positions.push(site) }
            token(&mut output, .Newline, "\n", site)
            lower(&catalog, &mut plan, &mut reg, &source, &mut output, source.starts[d], source.ends[d], instance, catalog.builtin[d], &mut position, &wanted)
            layout.end = position
            d = catalog.next_impl[d]
        }
        instance += 1
    }
    if plan.error != "" {
        input.ok = false; input.error = plan.error.clone(); input.error_at = origin(&layout, plan.at)
        return layout
    }
    for i in 0..output.kinds.len {
        if plan.requirements.methods.len == 0 && (output.kinds[i] != .Name || !bundled.primitive_method(output.texts[i])) { continue }
        keys := lexer.scan(bundled.primitive_keys(), false)
        site := origin(&layout, output.starts[i])
        layout.starts.push(position); layout.positions.push(site)
        token(&mut output, .Newline, "\n", position); position += 1
        for k in 0..keys.kinds.len - 1 {
            token(&mut output, keys.kinds[k], keys.texts[k], position); position += 1
        }
        layout.end = position
        break
    }
    layout.reserved = move plan.reserved
    layout.pending = move plan.pending
    layout.requirements = move plan.requirements
    for i in 0..plan.names.len {
        layout.instance_ids.put(plan.names[i].clone(), i64(i)); layout.sites.push(origin(&layout, plan.sites[i]))
    }
    layout.parents = move plan.parents
    token(&mut output, .End, "", position)
    input.kinds = move output.kinds; input.texts = move output.texts; input.starts = move output.starts
    input.ends.clear(); input.ids.clear(); input.intern = false; input.store_ends = false
    layout
}
