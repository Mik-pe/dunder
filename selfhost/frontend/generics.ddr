import lexer
import open_bodies
import ..bundled
import type_keys
import type_reader
import type_syntax as syntax
import frontend_types as ft
import std.text as text

fn token(out: &mut lexer.Tokens, kind: lexer.Kind, spelling: string, position: i32) {
    out.kinds.push(kind); out.texts.push(spelling.clone()); out.starts.push(position)
}

pub struct ConditionalImpls {
    impl_types: []string, impl_traits: []string, impl_sites: []i32,
    cond_starts: []i32, cond_counts: []i32,
    cond_receivers: []i32, cond_traits: []string,
}
fn conditional_impls() -> ConditionalImpls {
    ConditionalImpls { impl_types:[], impl_traits:[], impl_sites:[], cond_starts:[], cond_counts:[],
        cond_receivers:[], cond_traits:[] }
}
pub struct GenericFns {
    defs: Map<string, i64>, catalog_defs: []i32, type_param_counts: []i32,
    owner_tcounts: []i32, has_self: []bool,
    param_starts: []i32, param_counts: []i32, param_exprs: []i32, ret_exprs: []i32,
    valid: []bool, exprs: syntax.Tree,
}
fn empty_generic_fns() -> GenericFns {
    GenericFns {
        defs: Map<string, i64>::new(), catalog_defs: [], type_param_counts: [],
        owner_tcounts: [], has_self: [],
        param_starts: [], param_counts: [], param_exprs: [], ret_exprs: [],
        valid: [], exprs: syntax.tree(),
    }
}
pub struct Layout {
    first: i32, starts: []i32, positions: []i32, end: i32,
    reserved: Map<string, i64>, requirements: Requirements, conditional_impls: ConditionalImpls,
    instance_ids: Map<string, i64>, function_instances: []i32,
    sites: []i32, parents: []i32, error_function: i32, pending: Map<string, i64>, definition_checks: Map<string, i64>,
    generic_fns: GenericFns,
    type_instance_def: []i32, type_instance_arg_starts: []i32, type_instance_arg_counts: []i32, type_instance_args: []i32,
    inferred_lookup: Map<string, string>,
}
pub struct Requirements {
    trait_receivers: []i32, trait_names: []string, trait_sites: []i32,
}
fn requirements() -> Requirements { Requirements {trait_receivers:[], trait_names:[], trait_sites:[]} }
pub fn layout() -> Layout {
    Layout {first:-1, starts:[], positions:[], end:-1, reserved:Map<string, i64>::new(), requirements:requirements(), conditional_impls:conditional_impls(), instance_ids:Map<string, i64>::new(), function_instances:[], sites:[], parents:[], error_function:-1, pending:Map<string, i64>::new(), definition_checks:Map<string, i64>::new(),
        generic_fns:empty_generic_fns(), type_instance_def:[], type_instance_arg_starts:[], type_instance_arg_counts:[], type_instance_args:[],
        inferred_lookup:Map<string, string>::new()}
}
pub fn generated(layout: &Layout, position: i32) -> bool {
    layout.first >= 0 && position >= layout.first && position < layout.end
}
pub fn origin(layout: &Layout, position: i32) -> i32 {
    if !generated(&layout, position) { return position }
    mut i := layout.starts.len - 1
    while i > 0 && layout.starts[i] > position { i -= 1 }
    layout.positions[i]
}

struct Catalog {
    definitions: Map<string, i64>, names: []string, methods: []bool, impl_traits: []string, next_impl: []i32, builtin: []bool,
    counts: []i32, kinds: []i32, target_shapes: []i32, c_layout: []bool, result: i32, option: i32, map: i32, set: i32, compound_impls: []i32, lazy_impls: []i32,
    method_owner_counts: []i32, method_targets: []string, method_names: []string, generic_method_names: Map<string, i64>,
    bodies: lexer.Tokens, slots: []i32, starts: []i32, ends: []i32,
    removed: []i32, resume: []i32, constraints: Constraints, constraint_starts: []i32,
}
struct Constraints { parameters: []i32, traits: []string }
struct Instances {
    index: type_keys.Index, definitions: []i32, names: []string, sites: []i32, parents: []i32,
    depths: []i32, type_depths: []i32,
    arguments: []string, types: []i32, starts: []i32, reserved: Map<string, i64>, platform: i32,
    method_impl_targets: []string,
    requirements: Requirements, conditional_impls: ConditionalImpls, pending: Map<string, i64>, error: string, at: i32,
    has_inferred_calls: bool, inferred_lookup: Map<string, string>,
}
fn argument_depth(plan: &Instances, types: &[]i32) -> i32 {
    mut depth := 0
    for ty in &types { if ty >= 0 && ty < plan.type_depths.len && plan.type_depths[ty] > depth { depth = plan.type_depths[ty] } }
    depth
}
fn structural_depth(plan: &mut Instances, ty: i32, depth: i32) {
    while ty >= plan.type_depths.len { plan.type_depths.push(0) }
    plan.type_depths[ty] = depth
}

fn reject(plan: &mut Instances, at: i32, message: string) {
    if plan.error == "" { plan.at = at; plan.error = message.clone() }
}
fn declaration(word: string) -> bool {
    word == "fn" || word == "struct" || word == "enum" || word == "impl"
}
fn prefix(input: &lexer.Tokens, keyword: i32) -> i32 {
    mut first := keyword
    while first > 0 {
        mut p := first - 1
        while p >= 0 && lexer.is_newline(input.kinds[p]) { p -= 1 }
        if p < 0 { break }
        word := &input.texts[p]
        if (word == "pub" || word == "opaque" || word == "unsafe") && p == first - 1 { first = p; continue }
        if lexer.symbol(&input, p, ")") {
            while p > 0 && !lexer.symbol(&input, p, "(") { p -= 1 }
            p -= 1
        }
        if lexer.symbol(&input, p - 1, "@") { first = p - 1; continue }
        break
    }
    first
}
fn signature_end(input: &lexer.Tokens, keyword: i32, after: i32, last: i32) -> i32 {
    mut at := after
    if input.texts[keyword] == "fn" {
        if !lexer.symbol(&input, at, "(") { return last }
        at = lexer.closing(&input, at, last, "(", ")") + 1
        if lexer.symbol(&input, at, "->") {
            at = syntax.type_end(&input, at + 1, last)
            if at + 1 < last && input.texts[at] == "from" {
                if lexer.symbol(&input, at + 1, "(") { at = lexer.closing(&input, at + 1, last, "(", ")") + 1 }
                else { at += 2; if at + 1 < last && lexer.symbol(&input, at, ".") { at += 2 } }
            }
        }
    }
    while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
    at
}
fn parameter_index(params: &[]string, word: string) -> i32 {
    for i in 0..params.len { if params[i] == word { return i } }
    -1
}
fn constraints(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, params: &[]string, first: i32, last: i32) -> i32 {
    mut at := first
    if input.texts[at] != "where" { return at }
    at += 1
    while at < last {
        while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
        if at >= last { reject(&mut plan, input.starts[last], "expected a where requirement"); return last }
        if input.texts[at] == "storable" && lexer.symbol(&input, at + 1, "(") {
            reject(&mut plan, input.starts[at], "legacy 'where storable(T)' is removed; use 'where T: Storable'")
            return last
        }
        parameter := parameter_index(&params, input.texts[at])
        if parameter < 0 { reject(&mut plan, input.starts[at], "expected a type parameter in where clause"); return last }
        at += 1
        if at < last && lexer.symbol(&input, at, ":") {
            at += 1
            mut expect_trait := true
            while at < last {
                while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
                if at >= last { reject(&mut plan, input.starts[last], "expected a trait name in where clause"); return last }
                if expect_trait {
                    if input.kinds[at] != .Name { reject(&mut plan, input.starts[at], "expected a trait name in where clause"); return last }
                    catalog.constraints.traits.push(input.texts[at].clone())
                    catalog.constraints.parameters.push(parameter)
                    at += 1; expect_trait = false
                } else if lexer.symbol(&input, at, "+") {
                    at += 1; expect_trait = true
                } else { break }
            }
            if expect_trait { reject(&mut plan, input.starts[at], "expected a trait name after '+'"); return last }
        } else if at < last && lexer.symbol(&input, at, ".") {
            reject(&mut plan, input.starts[at], "method requirements in where clauses are removed; use a trait bound like 'T: Trait'")
            return last
        } else {
            reject(&mut plan, input.starts[at], "expected ': Trait' bound in where clause")
            return last
        }
        if !lexer.symbol(&input, at, ",") { break }
        at += 1
    }
    at
}
fn generic_method_fn_tok(input: &lexer.Tokens, at: i32, limit: i32) -> i32 {
    mut cur := at
    if cur < limit && input.texts[cur] == "pub" { cur += 1 }
    if cur < limit && input.texts[cur] == "unsafe" { cur += 1 }
    if cur + 2 < limit && input.texts[cur] == "fn" && input.kinds[cur + 1] == .Name && lexer.symbol(&input, cur + 2, "<") {
        return cur
    }
    -1
}
fn copy_owner_constraints(catalog: &mut Catalog, owner_def: i32) {
    if owner_def < 0 { return }
    for c in catalog.constraint_starts[owner_def]..catalog.constraint_starts[owner_def + 1] {
        catalog.constraints.traits.push(catalog.constraints.traits[c].clone())
        catalog.constraints.parameters.push(catalog.constraints.parameters[c])
    }
}
fn capture_generic_method(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens,
                          mfirst: i32, fn_tok: i32, limit: i32, target_name: string,
                          impl_params: &[]string, owner_def: i32, builtin: bool) -> i32 {
    name_at := fn_tok + 1
    mname := &input.texts[name_at]
    site := input.starts[name_at]
    mparams := syntax.parameters(&input, name_at)
    if mparams.error != "" { reject(&mut plan, input.starts[mparams.after], mparams.error); return limit }
    mut all_params: []string = []
    for ip in impl_params { all_params.push(ip.clone()) }
    for mp in &mparams.names { all_params.push(mp.clone()) }
    copy_owner_constraints(&mut catalog, owner_def)
    for b in 0..mparams.bound_params.len {
        catalog.constraints.traits.push(input.texts[mparams.bound_tokens[b]].clone())
        catalog.constraints.parameters.push(impl_params.len + mparams.bound_params[b])
    }
    after := constraints(&mut catalog, &mut plan, &input, &all_params, mparams.after, limit)
    if plan.error != "" { return limit }
    mut open := signature_end(&input, fn_tok, after, limit)
    mut trailing := limit; mut resume := limit
    if open < limit && input.texts[open] == "where" {
        trailing = open; resume = constraints(&mut catalog, &mut plan, &input, &all_params, trailing, limit)
        if plan.error != "" { return limit }
        open = resume
        while open < limit && lexer.is_newline(input.kinds[open]) { open += 1 }
    }
    if !lexer.symbol(&input, open, "{") {
        reject(&mut plan, site, "expected a generic method body"); return limit
    }
    close := lexer.closing(&input, open, limit, "{", "}")
    if close >= limit { reject(&mut plan, site, "expected a generic method body"); return limit }
    key := target_name + "::" + mname
    if catalog.definitions.contains(key) {
        reject(&mut plan, site, "duplicate generic method '" + key + "'"); return limit
    }
    catalog.constraint_starts.push(catalog.constraints.traits.len)
    mdef := catalog.names.len
    catalog.definitions.put(move key, i64(mdef))
    catalog.generic_method_names.put(mname.clone(), 1)
    catalog.names.push(mname.clone()); catalog.methods.push(false); catalog.impl_traits.push("")
    catalog.next_impl.push(-1); catalog.builtin.push(builtin)
    catalog.kinds.push(4); catalog.counts.push(all_params.len); catalog.target_shapes.push(0)
    catalog.c_layout.push(false)
    catalog.method_owner_counts.push(impl_params.len)
    catalog.method_targets.push(target_name.clone())
    catalog.method_names.push(mname.clone())
    catalog.starts.push(catalog.slots.len)
    hdr_site := input.starts[mfirst]
    catalog.slots.push(-1); token(&mut catalog.bodies, .Keyword, "impl", hdr_site)
    catalog.slots.push(-3); token(&mut catalog.bodies, .Name, target_name, hdr_site)
    catalog.slots.push(-1); token(&mut catalog.bodies, .Symbol, "{", hdr_site)
    for i in mfirst..close + 1 {
        if (i >= name_at + 1 && i < after) || (i >= trailing && i < resume) { continue }
        mut slot := -1
        if i == name_at { slot = -2 }
        else if input.kinds[i] == .Name && !lexer.symbol(&input, i - 1, ".") && !lexer.symbol(&input, i - 1, "::") &&
            !lexer.symbol(&input, i + 1, ":") {
            mut p := all_params.len - 1
            while p >= 0 {
                if input.texts[i] == all_params[p] { slot = p; break }
                p -= 1
            }
        }
        catalog.slots.push(slot)
        token(&mut catalog.bodies, input.kinds[i], input.texts[i], input.starts[i])
    }
    catalog.slots.push(-1); token(&mut catalog.bodies, .Symbol, "}", input.starts[close])
    catalog.ends.push(catalog.slots.len)
    close
}
fn capture(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, keyword: i32, builtin: bool) -> i32 {
    last := input.kinds.len - 1
    is_trait_impl := input.texts[keyword] == "impl" && keyword + 3 < last && input.texts[keyword + 2] == "for"
    mut impl_trait := ""
    mut name_at := keyword + 1
    if is_trait_impl { impl_trait = input.texts[keyword + 1].clone(); name_at = keyword + 3 }
    name := &input.texts[name_at]
    site := input.starts[name_at]
    method := input.texts[keyword] == "impl"
    first := prefix(&input, keyword)
    params := syntax.parameters(&input, name_at)
    if params.error != "" { reject(&mut plan, input.starts[params.after], params.error); return last }
    for b in 0..params.bound_params.len {
        catalog.constraints.traits.push(input.texts[params.bound_tokens[b]].clone())
        catalog.constraints.parameters.push(params.bound_params[b])
    }
    after := constraints(&mut catalog, &mut plan, &input, &params.names, params.after, last)
    if plan.error != "" { return last }
    mut open := signature_end(&input, keyword, after, last)
    mut trailing := last; mut resume := last
    if open < last && input.texts[open] == "where" {
        trailing = open; resume = constraints(&mut catalog, &mut plan, &input, &params.names, trailing, last)
        open = resume
        while open < last && lexer.is_newline(input.kinds[open]) { open += 1 }
    }
    if !lexer.symbol(&input, open, "{") { open = last }
    catalog.constraint_starts.push(catalog.constraints.traits.len)
    close := lexer.closing(&input, open, last, "{", "}")
    if close == last { reject(&mut plan, site, "expected a generic declaration body"); return last }
    if !method {
        if catalog.definitions.contains(name) { reject(&mut plan, site, "duplicate generic declaration"); return last }
        catalog.definitions.put(name.clone(), i64(catalog.names.len))
    }
    def_id := catalog.names.len
    catalog.names.push(name.clone()); catalog.methods.push(method); catalog.impl_traits.push(move impl_trait); catalog.next_impl.push(-1); catalog.builtin.push(builtin)
    if builtin && !method && name == bundled.prelude_export("result", "Result") { catalog.result = catalog.names.len - 1 }
    if builtin && !method && name == bundled.prelude_export("option", "Option") { catalog.option = catalog.names.len - 1 }
    if builtin && !method && name == bundled.prelude_export("map", "Map") { catalog.map = catalog.names.len - 1 }
    if builtin && !method && name == bundled.prelude_export("set", "Set") { catalog.set = catalog.names.len - 1 }
    kind := if input.texts[keyword] == "struct" { 2 } else if input.texts[keyword] == "enum" { 3 } else { 0 }
    catalog.kinds.push(kind); catalog.counts.push(params.names.len); catalog.target_shapes.push(0)
    mut c_layout := false
    for i in first..keyword { if input.texts[i] == "c_layout" { c_layout = true } }
    catalog.c_layout.push(c_layout)
    catalog.method_owner_counts.push(0); catalog.method_targets.push(""); catalog.method_names.push("")
    catalog.starts.push(catalog.slots.len)
    mut found_methods: []i32 = []
    mut bdepth := 0
    mut i := first
    while i <= close {
        if (i >= name_at + 1 && i < after) || (i >= trailing && i < resume) { i += 1; continue }
        if method && bdepth == 1 {
            fn_tok := generic_method_fn_tok(&input, i, close)
            if fn_tok >= 0 && (i == open + 1 || lexer.is_newline(input.kinds[i - 1]) || lexer.symbol(&input, i - 1, ";") || lexer.symbol(&input, i - 1, "{") || lexer.symbol(&input, i - 1, "}")) {
                mut mop := fn_tok + 3
                while mop < close && !lexer.symbol(&input, mop, "{") { mop += 1 }
                if mop < close {
                    mclose := lexer.closing(&input, mop, close, "{", "}")
                    if mclose < close {
                        found_methods.push(i); found_methods.push(fn_tok)
                        i = mclose + 1; continue
                    }
                }
            }
        }
        if lexer.symbol(&input, i, "{") { bdepth += 1 }
        else if lexer.symbol(&input, i, "}") { bdepth -= 1 }
        mut slot := -1
        if i == name_at { slot = -2 }
        else if input.kinds[i] == .Name && !lexer.symbol(&input, i - 1, ".") && !lexer.symbol(&input, i - 1, "::") &&
            !lexer.symbol(&input, i + 1, ":") {
            for p in 0..params.names.len {
                if input.texts[i] == params.names[p] { slot = p; break }
            }
        }
        catalog.slots.push(slot)
        token(&mut catalog.bodies, input.kinds[i], input.texts[i], input.starts[i])
        i += 1
    }
    catalog.ends.push(catalog.slots.len)
    if !builtin { catalog.removed.push(first); catalog.resume.push(close + 1) }
    mut mi := 0
    while mi < found_methods.len && plan.error == "" {
        _ := capture_generic_method(&mut catalog, &mut plan, &input, found_methods[mi], found_methods[mi + 1], close, name.clone(), &params.names, def_id, builtin)
        mi += 2
    }
    close + 1
}
fn capture_compound(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, keyword: i32, builtin: bool) -> i32 {
    last := input.kinds.len - 1
    mut impl_trait := input.texts[keyword + 1].clone()
    target_first := keyword + 3
    site := input.starts[target_first]
    first := prefix(&input, keyword)
    mut shape := 0
    mut target_end := target_first
    mut length_name := ""
    mut param_names: []string = []
    if lexer.symbol(&input, target_first, "[") {
        if lexer.symbol(&input, target_first + 1, "]") && input.kinds[target_first + 2] == .Name {
            shape = 1
            param_names.push(input.texts[target_first + 2].clone())
            target_end = target_first + 3
        } else if target_first + 4 < last && input.kinds[target_first + 1] == .Name &&
            lexer.symbol(&input, target_first + 2, ";") && input.kinds[target_first + 3] == .Name && lexer.symbol(&input, target_first + 4, "]") {
            shape = -1
            param_names.push(input.texts[target_first + 1].clone())
            length_name = input.texts[target_first + 3].clone()
            if length_name == param_names[0] { reject(&mut plan, site, "array length and element parameters must be distinct"); return last }
            target_end = target_first + 5
        } else { reject(&mut plan, site, "expected '[]T' or '[T; N]' in compound trait target"); return last }
    } else if lexer.symbol(&input, target_first, "(") {
        mut at := target_first + 1
        while at < last && !lexer.symbol(&input, at, ")") {
            while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
            if input.kinds[at] != .Name { reject(&mut plan, input.starts[at], "expected type parameter in compound tuple target"); return last }
            pname := &input.texts[at]
            for existing in &param_names {
                if existing == pname { reject(&mut plan, input.starts[at], "duplicate type parameter in compound target"); return last }
            }
            param_names.push(pname.clone()); at += 1
            while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
            if !lexer.symbol(&input, at, ",") { break }
            at += 1
        }
        if !lexer.symbol(&input, at, ")") || param_names.len < 2 {
            reject(&mut plan, site, "expected tuple type parameters in compound trait target"); return last
        }
        shape = param_names.len
        target_end = at + 1
    } else {
        reject(&mut plan, site, "expected compound trait target"); return last
    }
    mut after := target_end
    while after < last && lexer.is_newline(input.kinds[after]) { after += 1 }
    mut open := after
    mut trailing := last; mut resume := last
    if open < last && input.texts[open] == "where" {
        trailing = open
        resume = constraints(&mut catalog, &mut plan, &input, &param_names, trailing, last)
        if plan.error != "" { return last }
        open = resume
        while open < last && lexer.is_newline(input.kinds[open]) { open += 1 }
    }
    if !lexer.symbol(&input, open, "{") { open = last }
    catalog.constraint_starts.push(catalog.constraints.traits.len)
    close := lexer.closing(&input, open, last, "{", "}")
    if close == last { reject(&mut plan, site, "expected a generic declaration body"); return last }
    def := catalog.names.len
    mut desc := "__compound_slice_"
    if shape == -1 { desc = "__compound_fixed_" }
    if shape >= 2 { desc = "__compound_tuple_" + shape.str() + "_" }
    catalog.names.push(desc + impl_trait); catalog.methods.push(true); catalog.impl_traits.push(move impl_trait); catalog.next_impl.push(-1); catalog.builtin.push(builtin)
    catalog.kinds.push(0); catalog.counts.push(param_names.len); catalog.target_shapes.push(shape); catalog.c_layout.push(false)
    catalog.method_owner_counts.push(0); catalog.method_targets.push(""); catalog.method_names.push("")
    catalog.compound_impls.push(def)
    catalog.starts.push(catalog.slots.len)
    for i in first..close + 1 {
        if (i >= target_first + 1 && i < after) || (i >= trailing && i < resume) { continue }
        mut slot := -1
        if i == target_first { slot = -2 }
        else if input.kinds[i] == .Name && !lexer.symbol(&input, i - 1, ".") && !lexer.symbol(&input, i - 1, "::") &&
            !lexer.symbol(&input, i + 1, ":") {
            if length_name != "" && input.texts[i] == length_name { slot = -6 }
            for p in 0..param_names.len {
                if input.texts[i] == param_names[p] { slot = p; break }
            }
        }
        catalog.slots.push(slot)
        token(&mut catalog.bodies, input.kinds[i], input.texts[i], input.starts[i])
    }
    catalog.ends.push(catalog.slots.len)
    if !builtin { catalog.removed.push(first); catalog.resume.push(close + 1) }
    close + 1
}
fn is_compound_impl_at(input: &lexer.Tokens, at: i32, builtin: bool) -> bool {
    last := input.kinds.len - 1
    if at + 5 >= last || input.texts[at] != "impl" || input.kinds[at + 1] != .Name || input.texts[at + 2] != "for" { return false }
    target := at + 3
    if lexer.symbol(&input, target, "[") && lexer.symbol(&input, target + 1, "]") && input.kinds[target + 2] == .Name {
        if builtin { return true }
        mut next := target + 3
        while next < last && lexer.is_newline(input.kinds[next]) { next += 1 }
        return next < last && input.texts[next] == "where"
    }
    if lexer.symbol(&input, target, "[") && input.kinds[target + 1] == .Name && lexer.symbol(&input, target + 2, ";") &&
        target + 4 < last && input.kinds[target + 3] == .Name && lexer.symbol(&input, target + 4, "]") {
        mut next := target + 5
        while next < last && lexer.is_newline(input.kinds[next]) { next += 1 }
        return next < last && input.texts[next] == "where"
    }
    if lexer.symbol(&input, target, "(") {
        if builtin { return true }
        close := lexer.closing(&input, target, last, "(", ")")
        mut next := close + 1
        while next < last && lexer.is_newline(input.kinds[next]) { next += 1 }
        return next < last && input.texts[next] == "where"
    }
    false
}
fn collect(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, builtin: bool, reg: &mut ft.TypeRegistry) {
    mut i := 0
    mut level := 0
    while i + 2 < input.kinds.len && plan.error == "" {
        if level == 0 && is_compound_impl_at(&input, i, builtin) {
            i = capture_compound(&mut catalog, &mut plan, &input, i, builtin); continue
        }
        if level == 0 && input.texts[i] == "impl" && i + 4 < input.kinds.len &&
            input.kinds[i + 1] == .Name && input.texts[i + 2] == "for" &&
            input.kinds[i + 3] == .Name && lexer.symbol(&input, i + 4, "<") {
            i = capture(&mut catalog, &mut plan, &input, i, builtin); continue
        }
        if level == 0 && declaration(input.texts[i]) && input.kinds[i + 1] == .Name && lexer.symbol(&input, i + 2, "<") {
            i = capture(&mut catalog, &mut plan, &input, i, builtin); continue
        }
        if level == 0 && input.texts[i] == "impl" && i + 2 < input.kinds.len {
            mut target_tok := i + 1
            if i + 4 < input.kinds.len && input.kinds[i + 1] == .Name && input.texts[i + 2] == "for" &&
                input.kinds[i + 3] == .Name && !lexer.symbol(&input, i + 4, "<") {
                target_tok = i + 3
            }
            if input.kinds[target_tok] == .Name && !lexer.symbol(&input, target_tok + 1, "<") {
                mut open := target_tok + 1
                while open < input.kinds.len - 1 && !lexer.symbol(&input, open, "{") { open += 1 }
                if open < input.kinds.len - 1 {
                    close := lexer.closing(&input, open, input.kinds.len - 1, "{", "}")
                    if close < input.kinds.len - 1 {
                        tname := input.texts[target_tok].clone()
                        no_params: []string = []
                        mut bd := 1
                        mut k := open + 1
                        while k < close && plan.error == "" {
                            if bd == 1 {
                                fn_tok := generic_method_fn_tok(&input, k, close)
                                if fn_tok >= 0 && (k == open + 1 || lexer.is_newline(input.kinds[k - 1]) || lexer.symbol(&input, k - 1, ";") || lexer.symbol(&input, k - 1, "{") || lexer.symbol(&input, k - 1, "}")) {
                                    mclose := capture_generic_method(&mut catalog, &mut plan, &input, k, fn_tok, close, tname.clone(), &no_params, -1, builtin)
                                    if mclose >= close { break }
                                    if !builtin { catalog.removed.push(k); catalog.resume.push(mclose + 1) }
                                    k = mclose + 1; continue
                                }
                            }
                            if lexer.symbol(&input, k, "{") { bd += 1 }
                            else if lexer.symbol(&input, k, "}") { bd -= 1 }
                            k += 1
                        }
                        i = close + 1; continue
                    }
                }
            }
        }
        if level == 0 && (input.texts[i] == "struct" || input.texts[i] == "enum") && input.kinds[i + 1] == .Name {
            name := &input.texts[i + 1]
            if ft.type_id(&reg, name) >= 0 { reject(&mut plan, input.starts[i + 1], "duplicate type"); return }
            kind := if input.texts[i] == "struct" { 2 } else { 3 }
            ty := ft.add_type(&mut reg, name, kind, 0); plan.reserved.put(name.clone(), i64(ty))
            for attr in prefix(&input, i)..i { if input.texts[attr] == "c_layout" { reg.c_record[ty] = true } }
        }
        if lexer.symbol(&input, i, "{") { level += 1 }
        else if lexer.symbol(&input, i, "}") { level -= 1 }
        i += 1
    }
}

fn request(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry, def: i32, types: &[]i32, site: i32, parent: i32) -> i32 {
    family := &catalog.names[def]
    known := type_keys.find(&plan.index, def, &types)
    if known >= 0 { return known }
    instance := plan.names.len
    depth := argument_depth(&plan, &types)
    mut repeats := 0; mut ancestor := parent; mut previous_depth := depth
    while ancestor >= 0 {
        if plan.definitions[ancestor] == def && plan.depths[ancestor] < previous_depth {
            repeats += 1; previous_depth = plan.depths[ancestor]
            if repeats >= 64 {
                reject(&mut plan, site, "generic specialization nesting limit: recurring declaration with growing arguments, previous instance " + plan.names[ancestor])
                return -1
            }
        }
        ancestor = plan.parents[ancestor]
    }
    if instance >= 65536 { reject(&mut plan, site, "generic instance count exceeds 65536"); return -1 }
    is_gen_method := catalog.kinds[def] == 4
    mut name := if is_gen_method { catalog.method_names[def].clone() } else { family.clone() }
    name += "<"
    first_arg := if is_gen_method { catalog.method_owner_counts[def] } else { 0 }
    for i in first_arg..types.len {
        if i > first_arg { name += ", " }
        name += ft.type_spelling(&reg, types[i])
        if name.len > 65536 { reject(&mut plan, site, "generic type exceeds compiler resource limit"); return -1 }
    }
    name += ">"
    type_keys.insert(&mut plan.index, def, &types, instance)
    plan.names.push(name.clone()); plan.definitions.push(def); plan.sites.push(site); plan.parents.push(parent); plan.depths.push(depth)
    plan.starts.push(plan.arguments.len)
    for ty in &types { plan.arguments.push(ft.argument_name(&mut reg, ty)) }
    plan.types.push(-1)
    plan.method_impl_targets.push("")
    mut impl_target := ""
    mut nominal := -1
    if is_gen_method {
        owner_tcount := catalog.method_owner_counts[def]
        if owner_tcount > 0 {
            owner_def := i32(catalog.definitions.get_or(catalog.method_targets[def], -1))
            if owner_def >= 0 {
                mut owner_types: []i32 = []
                for oi in 0..owner_tcount { owner_types.push(types[oi]) }
                owner_inst := request(&catalog, &source, &mut plan, &mut reg, owner_def, &owner_types, site, instance)
                if plan.error == "" && owner_inst >= 0 {
                    impl_target = plan.names[owner_inst].clone()
                    nominal = plan.types[owner_inst]
                }
            }
        } else {
            impl_target = catalog.method_targets[def].clone()
            nominal = ft.type_id(&reg, impl_target)
        }
    } else if catalog.kinds[def] == 2 || catalog.kinds[def] == 3 {
        ty := ft.add_type(&mut reg, name, catalog.kinds[def], 0)
        structural_depth(&mut plan, ty, depth + 1)
        reg.c_record[ty] = catalog.c_layout[def]
        nominal = ty
        plan.reserved.put(name.clone(), i64(ty))
        if def == catalog.result {
            reg.result_success[ty] = types[0]; reg.result_failure[ty] = types[1]
        }
        if def == catalog.option {
            reg.option_inner[ty] = types[0]
        }
        if def == catalog.map {
            reg.map_key[ty] = types[0]; reg.map_value[ty] = types[1]
        }
        if def == catalog.set {
            reg.set_elem[ty] = types[0]
        }
    }
    plan.types[instance] = nominal
    plan.method_impl_targets[instance] = move impl_target
    require_arguments(&catalog, &mut plan, &reg, def, instance, site)
    instance
}
fn require_arguments(catalog: &Catalog, plan: &mut Instances, reg: &ft.TypeRegistry,
    def: i32, instance: i32, site: i32) {
    for b in catalog.constraint_starts[def]..catalog.constraint_starts[def + 1] {
        bounds_table := &catalog.constraints
        receiver := plan.index.arguments[plan.index.starts[instance] + bounds_table.parameters[b]]
        trait_name := &bounds_table.traits[b]
        if trait_name == "Storable" {
            if !ft.array_element(&reg, receiver) { reject(&mut plan, site, "type argument must be a storable value"); return }
        } else {
            plan.requirements.trait_receivers.push(receiver)
            plan.requirements.trait_names.push(trait_name.clone())
            plan.requirements.trait_sites.push(site)
        }
    }
}
fn record_conditional_impl(catalog: &Catalog, plan: &mut Instances,
    def: i32, instance: i32, site: i32) {
    start := plan.conditional_impls.cond_receivers.len
    mut count := 0
    for b in catalog.constraint_starts[def]..catalog.constraint_starts[def + 1] {
        bounds_table := &catalog.constraints
        receiver := plan.index.arguments[plan.index.starts[instance] + bounds_table.parameters[b]]
        plan.conditional_impls.cond_receivers.push(receiver)
        plan.conditional_impls.cond_traits.push(bounds_table.traits[b].clone())
        count += 1
    }
    plan.conditional_impls.impl_types.push(plan.names[instance].clone())
    plan.conditional_impls.impl_traits.push(catalog.impl_traits[def].clone())
    plan.conditional_impls.impl_sites.push(site)
    plan.conditional_impls.cond_starts.push(start)
    plan.conditional_impls.cond_counts.push(count)
}

struct BoundSource {
    tokens: lexer.Tokens, slots: []i32, applications: []i32, receivers: []i32,
    starts: []i32, ends: []i32, expressions: syntax.Tree, method_names: []i32, method_ends: []i32,
}
fn bound_token(source: &mut BoundSource, kind: lexer.Kind, word: string, at: i32, slot: i32, application: i32, receiver: i32) {
    token(&mut source.tokens, kind, word, at); source.slots.push(slot)
    source.applications.push(application); source.receivers.push(receiver)
    source.method_names.push(-1); source.method_ends.push(-1)
}
fn consuming_type_slot(source: &BoundSource, at: i32, limit: i32) -> i32 {
    if at + 3 < limit && source.tokens.texts[at] == "move" && lexer.symbol(&source.tokens, at + 2, ":") {
        return source.slots[at + 3]
    }
    -1
}
fn bind_methods(source: &mut BoundSource, first: i32, end: i32) {
    mut at := first
    while at < end {
        if source.tokens.texts[at] != "fn" || source.tokens.kinds[at + 1] != .Name { at += 1; continue }
        name := at + 1; at += 2
        while at < end && !lexer.symbol(&source.tokens, at, "{") { at += 1 }
        if at == end { return }
        close := lexer.closing(&source.tokens, at, end, "{", "}")
        if close == end { return }
        for param in name + 1..at {
            if consuming_type_slot(&source, param, at) >= 0 {
                first_token := if name >= 2 && source.tokens.texts[name - 2] == "pub" { name - 2 } else { name - 1 }
                source.slots[first_token] = -7
                source.method_ends[first_token] = at
                break
            }
        }
        source.method_names[at] = name; source.method_ends[at] = close; at = close + 1
    }
}
fn bind_types(catalog: &Catalog, plan: &mut Instances, reg: &ft.TypeRegistry, tree: &mut syntax.Tree,
    input: &lexer.Tokens, slots: &[]i32, begin: i32, expr: i32, allow_function: bool) {
    for i in begin..expr + 1 {
        form := tree.forms[i]; name := &tree.names[i]
        index := tree.positions[i]
        if form == .Name {
            param := if slots.len == 0 { -1 } else { slots[index] }
            if param >= 0 { tree.values[i] = -2 - param }
            else if name == "Self" { tree.values[i] = -1 }
            else {
                ty := ft.type_id(&reg, name)
                if ty < 0 { reject(&mut plan, input.starts[index], "unknown type '" + name + "'"); return }
                tree.values[i] = ty
            }
        } else if form == .Fixed && tree.values[i] < 0 && slots.len > 0 {
            length_at := syntax.type_end(&input, index + 1, input.kinds.len - 1) + 1
            if length_at < slots.len && slots[length_at] == -6 { tree.values[i] = -2 }
        } else if form == .Apply {
            decl := i32(catalog.definitions.get_or(name, -1)); count := tree.starts[i + 1] - tree.starts[i]
            if decl < 0 {
                if name != "Task" { reject(&mut plan, input.starts[index], "unknown generic type '" + name + "'"); return }
                if count != 1 { reject(&mut plan, input.starts[index], name + " expects one type argument"); return }
            } else if count != catalog.counts[decl] {
                reject(&mut plan, input.starts[index], "wrong number of type arguments: expected " + catalog.counts[decl].str() + ", got " + count.str()); return
            } else if (!allow_function || i != expr) && catalog.kinds[decl] == 0 {
                reject(&mut plan, input.starts[index], "expected a generic type"); return
            }
            tree.values[i] = decl
        }
    }
}
fn bind(catalog: &Catalog, plan: &mut Instances, reg: &ft.TypeRegistry, source: &mut BoundSource,
    input: &lexer.Tokens, first: i32, end: i32, root: bool) {
    mut at := first; mut removed := 0; mut depth := 0; mut receiver := -1; mut in_trait := false
    while at < end && plan.error == "" {
        if root && removed < catalog.removed.len && at == catalog.removed[removed] {
            at = catalog.resume[removed]; removed += 1; continue
        }
        word := &input.texts[at]; kind := input.kinds[at]; site := input.starts[at]
        if root && depth == 0 && word == "trait" { in_trait = true }
        if root && depth == 0 && word == "impl" && at + 1 < end {
            if at + 3 < end && input.texts[at + 2] == "for" { receiver = ft.type_id(&reg, input.texts[at + 3]) }
            else { receiver = ft.type_id(&reg, input.texts[at + 1]) }
        }
        if lexer.symbol(&input, at, "{") { depth += 1 }
        else if lexer.symbol(&input, at, "}") { depth -= 1; if depth == 0 { receiver = -1; in_trait = false } }
        slot := if root { -1 } else { catalog.slots[at] }
        mut out_slot := slot
        if kind == .Name && slot == -1 && at > first &&
            (lexer.symbol(&input, at - 1, ".") || lexer.symbol(&input, at - 1, "::")) &&
            catalog.generic_method_names.contains(word) {
            plan.has_inferred_calls = true
            out_slot = -4
        }
        if kind == .Name && slot == -1 && !lexer.symbol(&input, at + 1, "<") && catalog.definitions.contains(word) {
            decl := i32(catalog.definitions.get_or(word, -1))
            if decl >= 0 && !catalog.methods[decl] && (catalog.kinds[decl] == 0 || lexer.symbol(&input, at + 1, "::")) &&
                (at == first || (!lexer.symbol(&input, at - 1, ".") && !lexer.symbol(&input, at - 1, "::"))) {
                plan.has_inferred_calls = true
                out_slot = -5
            }
        }
        if kind != .Name || slot != -1 || !lexer.symbol(&input, at + 1, "<") || !catalog.definitions.contains(word) {
            bound_token(&mut source, kind, word, site, out_slot, -1, receiver); at += 1; continue
        }
        mut cursor := syntax.cursor(at, end)
        begin := source.expressions.forms.len
        expr := syntax.parse(&mut source.expressions, &mut cursor, &input, 0)
        if expr < 0 { reject(&mut plan, site, cursor.error); return }
        if root {
            bind_types(&catalog, &mut plan, &reg, &mut source.expressions, &input, &[], begin, expr, true)
        } else {
            bind_types(&catalog, &mut plan, &reg, &mut source.expressions, &input, &catalog.slots, begin, expr, true)
        }
        if plan.error != "" { return }
        if root && in_trait {
            mut uses_self := false
            for node in begin..expr + 1 {
                if source.expressions.forms[node] == .Name && source.expressions.names[node] == "Self" {
                    uses_self = true; break
                }
            }
            if uses_self {
                bound_token(&mut source, kind, word, site, slot, -1, receiver); at += 1; continue
            }
        }
        bound_token(&mut source, kind, word, site, slot, expr, receiver)
        if cursor.assignment >= 0 { bound_token(&mut source, .Symbol, "=", input.starts[cursor.assignment] + 1, -1, -1, -1) }
        at = cursor.at
    }
}
fn evaluate(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    id: i32, parent: i32, receiver: i32, site: i32, application: bool) -> i32 {
    tree := &source.expressions
    form := tree.forms[id]; value := tree.values[id]
    if form == .Name {
        if value >= 0 { return value }
        if value == -1 {
            if receiver < 0 { reject(&mut plan, site, "Self is only valid inside an impl block") }
            return receiver
        }
        return plan.index.arguments[plan.index.starts[parent] - 2 - value]
    }
    mut types: []i32 = []
    for i in tree.starts[id]..tree.starts[id + 1] {
        ty := evaluate(&catalog, &source, &mut plan, &mut reg, tree.children[i], parent, receiver, site, false)
        if plan.error != "" { return -1 }
        types.push(ty)
    }
    if form == .Apply && value >= 0 {
        instance := request(&catalog, &source, &mut plan, &mut reg, value, &types, site, parent)
        if instance < 0 || application { return instance }
        return plan.types[instance]
    }
    mut ty := 0
    if form == .Fixed && value == -2 {
        ty = type_reader.fixed(&mut reg, plan.platform, types[0], ft.type_count(&reg, receiver))
    } else { ty = type_reader.resolve(&mut reg, &tree, id, &types, plan.platform) }
    if reg.error != "" { reject(&mut plan, site, reg.error) }
    else if form != .Consume { depth := argument_depth(&plan, &types); structural_depth(&mut plan, ty, depth + 1) }
    ty
}
fn skip_type_args(tokens: &lexer.Tokens, start: i32, end: i32) -> i32 {
    if start >= end || !lexer.symbol(&tokens, start, "<") { return start }
    mut at := start + 1; mut angles := 1; mut parens := 0
    while at < end && angles > 0 {
        if tokens.kinds[at] == .Symbol {
            w := &tokens.texts[at]
            if w == "(" || w == "[" { parens += 1 }
            else if w == ")" || w == "]" { if parens > 0 { parens -= 1 } }
            else if parens == 0 && w == "<" { angles += 1 }
            else if parens == 0 && w == ">" { angles -= 1 }
        }
        at += 1
    }
    at
}
fn lower(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry, source: &BoundSource,
    output: &mut lexer.Tokens, first: i32, end: i32, instance: i32, builtin: bool, position: &mut i32, wanted: &Map<string, i64>,
    inferred_keys: &Map<string, i64>, inferred_args: &[]string) {
    owner_tag := if instance < 0 { "__root__" } else if plan.method_impl_targets[instance] != "" {
        plan.method_impl_targets[instance] + "::" + plan.names[instance]
    } else { plan.names[instance].clone() }
    mut cursor := first
    while cursor < end {
        while cursor < end && source.slots[cursor] == -1 && source.applications[cursor] < 0 && source.method_names[cursor] < 0 {
            site := if builtin { position } else { source.tokens.starts[cursor] }
            output.kinds.push(source.tokens.kinds[cursor])
            output.texts.push(source.tokens.texts[cursor].clone())
            output.starts.push(site)
            if builtin { position += 1 }
            cursor += 1
        }
        if cursor == end { break }
        at := cursor; cursor += 1
        mut site := source.tokens.starts[at]
        if builtin { site = position; position += 1 }
        method := source.method_names[at]
        if method >= 0 {
            key := plan.names[instance] + "::" + source.tokens.texts[method]
            if !wanted.contains(key) {
                plan.pending.put(move key, 1)
                token(&mut output, .Symbol, "{", site)
                cursor = source.method_ends[at] + 1
                token(&mut output, .Symbol, "}", if builtin { site } else { source.tokens.starts[cursor - 1] })
                continue
            }
        }
        slot := source.slots[at]; app := source.applications[at]
        if app >= 0 {
            receiver := if instance >= 0 { plan.types[instance] } else { source.receivers[at] }
            target := evaluate(&catalog, &source, &mut plan, &mut reg, app, instance, receiver, site, true)
            if plan.error != "" { return }
            token(&mut output, .Name, plan.names[target], site)
        } else if slot == -7 {
            body := source.method_ends[at]
            name := source.method_names[body]
            mut unavailable := false
            for param in name + 1..body {
                param_slot := consuming_type_slot(&source, param, body)
                if param_slot >= 0 {
                    arg := plan.index.arguments[plan.index.starts[instance] + param_slot]
                    if ft.type_kind(&reg, arg) == 5 { unavailable = true; break }
                }
            }
            if unavailable { cursor = source.method_ends[body] + 1 }
            else { token(&mut output, source.tokens.kinds[at], source.tokens.texts[at], site) }
        } else if slot == -6 {
            token(&mut output, .Integer, ft.type_count(&reg, plan.types[instance]).str(), site)
        } else if slot == -3 {
            token(&mut output, .Name, plan.method_impl_targets[instance], site)
        } else if slot == -2 {
            token(&mut output, .Name, plan.names[instance], site)
        } else if slot >= 0 {
            token(&mut output, .Name, plan.arguments[plan.starts[instance] + slot], site)
        } else if slot == -4 || slot == -5 {
            mut emitted_generic := false
            if slot == -4 {
                ikey := owner_tag + ":" + at.str()
                found_inf := i32(inferred_keys.get_or(ikey, -1))
                if found_inf >= 0 {
                    parts := text.split(inferred_args[found_inf], "\n")
                    if parts.len > 0 {
                        decl_key := &parts[0]
                        decl := i32(catalog.definitions.get_or(decl_key, -1))
                        if decl >= 0 && catalog.kinds[decl] == 4 {
                            mut itypes: []i32 = []
                            mut parse_ok := true
                            for pi in 1..parts.len {
                                if parts[pi] == "" { continue }
                                ty := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, parts[pi], site, instance)
                                if ty < 0 { parse_ok = false; break }
                                itypes.push(ty)
                            }
                            if parse_ok && itypes.len == catalog.counts[decl] {
                                target := request(&catalog, &source, &mut plan, &mut reg, decl, &itypes, site, instance)
                                if plan.error != "" { return }
                                token(&mut output, .Name, plan.names[target], site)
                                cursor = skip_type_args(&source.tokens, cursor, end)
                                emitted_generic = true
                            }
                        }
                    }
                } else {
                    plan.inferred_lookup.put(instance.str() + "@" + site.str(), ikey.clone())
                }
            } else {
                decl := i32(catalog.definitions.get_or(source.tokens.texts[at], -1))
                if decl >= 0 && !catalog.methods[decl] && (catalog.kinds[decl] == 0 || (at + 1 < end && lexer.symbol(&source.tokens, at + 1, "::"))) {
                    ikey := owner_tag + ":" + at.str()
                    found_inf := i32(inferred_keys.get_or(ikey, -1))
                    if found_inf >= 0 {
                        mut itypes: []i32 = []
                        mut parse_ok := true
                        for part in text.split(inferred_args[found_inf], "\n") {
                            if part == "" { continue }
                            ty := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, part, site, instance)
                            if ty < 0 { parse_ok = false; break }
                            itypes.push(ty)
                        }
                        if parse_ok && itypes.len == catalog.counts[decl] {
                            target := request(&catalog, &source, &mut plan, &mut reg, decl, &itypes, site, instance)
                            if plan.error != "" { return }
                            token(&mut output, .Name, plan.names[target], site)
                            emitted_generic = true
                        }
                    } else {
                        plan.inferred_lookup.put(instance.str() + "@" + site.str(), ikey.clone())
                    }
                }
            }
            if !emitted_generic { token(&mut output, source.tokens.kinds[at], source.tokens.texts[at], site) }
        } else {
            token(&mut output, source.tokens.kinds[at], source.tokens.texts[at], site)
        }
    }
}

fn scalar_comparison_rhs(input: &lexer.Tokens, operator: i32) -> bool {
    at := operator + 1
    if at + 1 >= input.kinds.len { return false }
    kind := input.kinds[at]
    if kind != .Integer && kind != .Float && kind != .Rune && kind != .Byte { return false }
    next := input.kinds[at + 1]
    if next == .End { return true }
    if next != .Symbol { return false }
    word := &input.texts[at + 1]
    word == "{" || word == "}" || word == "," || word == ";" || word == ")" || word == "]" || word == "&&" || word == "||"
}
fn compound_syntax(input: &lexer.Tokens, tuples_only: bool, require_comparison: bool) -> bool {
    mut parens: []bool = []
    mut comparison := !require_comparison
    mut compound := false
    for i in 0..input.kinds.len {
        if input.kinds[i] != .Symbol { continue }
        word := &input.texts[i]
        if !comparison && (word == "==" || word == "!=" || word == "<" || word == "<=" || word == ">" || word == ">=") &&
            !scalar_comparison_rhs(&input, i) { comparison = true }
        if !compound {
            if word == "[" && !tuples_only { compound = true }
            else if word == "(" {
                call := i > 0 && (input.kinds[i - 1] == .Name || input.texts[i - 1] == "fn")
                parens.push(!call)
            } else if word == "[" || word == "{" { parens.push(false) }
            else if word == ")" || word == "]" || word == "}" {
                if parens.len > 0 { _ := parens.pop() }
            } else if word == "," && parens.len > 0 && parens[parens.len - 1] { compound = true }
        }
        if compound && comparison { return true }
    }
    false
}
pub fn has_tuple_syntax(input: &lexer.Tokens) -> bool { compound_syntax(&input, true, false) }
fn has_compound_ops(input: &lexer.Tokens) -> bool { compound_syntax(&input, false, true) }
fn needs_compound_probe(input: &lexer.Tokens, has_custom_compound: bool) -> bool {
    if has_compound_ops(&input) { return true }
    if !compound_syntax(&input, false, false) { return false }
    for i in 0..input.kinds.len {
        if input.kinds[i] == .Symbol {
            if has_custom_compound && input.texts[i] == "." { return true }
        } else if input.kinds[i] == .Name && bundled.prelude_method(input.texts[i]) {
            return true
        }
    }
    false
}
pub fn needed(input: &lexer.Tokens) -> bool {
    for i in 0..input.kinds.len - 1 {
        word := &input.texts[i]
        if i + 3 < input.kinds.len && word == "impl" && input.kinds[i + 1] == .Name && input.texts[i + 2] == "for" &&
            (lexer.symbol(&input, i + 3, "[") || lexer.symbol(&input, i + 3, "(")) { return true }
        if input.kinds[i] != .Name { continue }
        if bundled.prelude_method(word) { return true }
        if text.starts_with(word, "__dunder_module_prelude_") { return true }
        if lexer.symbol(&input, i + 1, "<") && i > 0 && (declaration(input.texts[i - 1]) || input.texts[i - 1] == "for") { return true }
    }
    has_compound_ops(&input)
}
pub struct Program { catalog: Catalog, source: BoundSource, root: i32, checks_start: i32, checks: Map<string, i64>, end: i32, reserved: Map<string, i64>, core: lexer.Tokens, has_compound_ops: bool, generic_fns: GenericFns, has_inferred_calls: bool }
fn definition_checks(catalog: &Catalog, source: &mut BoundSource, plan: &mut Instances) -> Map<string, i64> {
    mut view := open_bodies.view()
    mut end := 0; mut methods := Map<string, i64>::new()
    for d in 0..catalog.names.len { if !catalog.builtin[d] && catalog.target_shapes[d] == 0 { end = source.ends[d] } }
    if end == 0 { return move view.names }
    analysis := open_bodies.analyze(&source.tokens, &source.expressions, &source.slots, &source.applications, end)
    for d in 0..catalog.names.len {
        if catalog.builtin[d] || catalog.target_shapes[d] != 0 || catalog.kinds[d] == 4 { continue }
        first := source.starts[d]; end := source.ends[d]
        if catalog.methods[d] {
            for at in first..end {
                if source.method_names[at] >= 0 {
                    method := source.method_names[at]; key := catalog.names[d] + "::" + catalog.impl_traits[d] + "::" + source.tokens.texts[method]
                    if methods.contains(key) {
                        reject(&mut plan, source.tokens.starts[method], "duplicate method '" + source.tokens.texts[method] + "' on type")
                        return move view.names
                    }
                    methods.put(move key, 1)
                    open_bodies.function(&mut view, &source.tokens, &analysis,
                        source.method_names[at], at, source.method_ends[at])
                }
            }
        } else {
            mut name := first
            while name < end && source.slots[name] != -2 { name += 1 }
            if name == end { continue }
            if catalog.kinds[d] != 0 { open_bodies.aggregate(&mut view, &source.tokens, &analysis, name, end, catalog.c_layout[d]) }
            else {
                body := signature_end(&source.tokens, name - 1, name + 1, end)
                if body < end { open_bodies.function(&mut view, &source.tokens, &analysis, name, body, end - 1) }
            }
        }
        if !view.tokens.ok { reject(&mut plan, view.tokens.error_at, view.tokens.error); return move view.names }
    }
    for i in 0..view.origins.len {
        origin := view.origins[i]
        app := if origin < 0 { -1 } else { source.applications[origin] }
        orig_slot := if origin >= 0 && (source.slots[origin] == -4 || source.slots[origin] == -5) { source.slots[origin] } else { -1 }
        bound_token(&mut source, view.tokens.kinds[i], view.tokens.texts[i], view.tokens.starts[i], orig_slot, app, -1)
    }
    move view.names
}
fn instances(platform: i32, move reserved: Map<string, i64>) -> Instances {
    Instances { index:type_keys.new(), definitions:[], names:[], sites:[], parents:[], depths:[], type_depths:[], arguments:[], types:[],
        starts:[], reserved:move reserved, platform:platform, method_impl_targets:[], requirements:requirements(), conditional_impls:conditional_impls(), pending:Map<string, i64>::new(), error:"", at:0,
        has_inferred_calls:false, inferred_lookup:Map<string, string>::new() }
}
fn capture_fn_signature(catalog: &Catalog, reg: &ft.TypeRegistry, platform: i32,
    gf: &mut GenericFns, key: string, target_def: i32, type_param_count: i32, owner_tcount: i32, has_self: bool, paren_at: i32, end: i32) {
    if gf.defs.contains(key) { return }
    m := gf.catalog_defs.len
    gf.defs.put(key.clone(), i64(m))
    gf.catalog_defs.push(target_def); gf.type_param_counts.push(type_param_count)
    gf.owner_tcounts.push(owner_tcount); gf.has_self.push(has_self)
    pstart := gf.param_exprs.len; gf.param_starts.push(pstart)
    mut cursor := syntax.cursor(paren_at + 1, end)
    if has_self {
        while cursor.at < end && !lexer.symbol(&catalog.bodies, cursor.at, ",") && !lexer.symbol(&catalog.bodies, cursor.at, ")") {
            cursor.at += 1
        }
        if cursor.at < end && lexer.symbol(&catalog.bodies, cursor.at, ",") { cursor.at += 1 }
    }
    mut ok := true
    mut temp_plan := instances(platform, Map<string, i64>::new())
    while ok {
        while cursor.at < end && lexer.is_newline(catalog.bodies.kinds[cursor.at]) { cursor.at += 1 }
        if cursor.at >= end || lexer.symbol(&catalog.bodies, cursor.at, ")") { break }
        if catalog.bodies.texts[cursor.at] == "mut" { cursor.at += 1 }
        if cursor.at < end && catalog.bodies.texts[cursor.at] == "move" { cursor.at += 1 }
        if cursor.at < end && catalog.bodies.texts[cursor.at] == "mut" { cursor.at += 1 }
        if cursor.at + 1 >= end || catalog.bodies.kinds[cursor.at] != .Name || !lexer.symbol(&catalog.bodies, cursor.at + 1, ":") {
            ok = false; break
        }
        cursor.at += 2
        begin := gf.exprs.forms.len
        pexpr := syntax.parse(&mut gf.exprs, &mut cursor, &catalog.bodies, 0)
        if pexpr < 0 { ok = false; break }
        bind_types(&catalog, &mut temp_plan, &reg, &mut gf.exprs, &catalog.bodies, &catalog.slots, begin, pexpr, true)
        if temp_plan.error != "" { ok = false; break }
        gf.param_exprs.push(pexpr)
        while cursor.at < end && lexer.is_newline(catalog.bodies.kinds[cursor.at]) { cursor.at += 1 }
        if cursor.at < end && lexer.symbol(&catalog.bodies, cursor.at, ",") { cursor.at += 1 }
        else { break }
    }
    if ok && cursor.at < end && lexer.symbol(&catalog.bodies, cursor.at, ")") { cursor.at += 1 } else { ok = false }
    mut rexpr := -1
    while ok && cursor.at < end && lexer.is_newline(catalog.bodies.kinds[cursor.at]) { cursor.at += 1 }
    if ok && cursor.at < end && lexer.symbol(&catalog.bodies, cursor.at, "->") {
        cursor.at += 1
        begin := gf.exprs.forms.len
        rexpr = syntax.parse(&mut gf.exprs, &mut cursor, &catalog.bodies, 0)
        if rexpr < 0 { ok = false }
        else {
            bind_types(&catalog, &mut temp_plan, &reg, &mut gf.exprs, &catalog.bodies, &catalog.slots, begin, rexpr, true)
            if temp_plan.error != "" { ok = false }
        }
    }
    gf.param_counts.push(gf.param_exprs.len - pstart)
    gf.ret_exprs.push(rexpr)
    gf.valid.push(ok)
}
fn is_self_method(tokens: &lexer.Tokens, after_paren: i32, end: i32) -> bool {
    mut p := after_paren
    while p < end && lexer.is_newline(tokens.kinds[p]) { p += 1 }
    if p >= end { return false }
    if tokens.texts[p] == "&" {
        p += 1
        if p < end && tokens.texts[p] == "mut" { p += 1 }
        return p < end && tokens.texts[p] == "self"
    }
    if tokens.texts[p] == "mut" { p += 1 }
    if p < end && tokens.texts[p] == "move" { p += 1 }
    if p < end && tokens.texts[p] == "mut" { p += 1 }
    p < end && tokens.texts[p] == "self"
}
fn capture_generic_fns(catalog: &Catalog, reg: &ft.TypeRegistry, platform: i32) -> GenericFns {
    mut gf := empty_generic_fns()
    for d in 0..catalog.names.len {
        if catalog.methods[d] || catalog.kinds[d] != 0 { continue }
        first := catalog.starts[d]; end := catalog.ends[d]
        mut at := first
        while at < end && catalog.slots[at] != -2 { at += 1 }
        at += 1
        if at >= end || !lexer.symbol(&catalog.bodies, at, "(") {
            key := catalog.names[d].clone()
            if !gf.defs.contains(key) {
                gf.defs.put(move key, i64(gf.catalog_defs.len))
                gf.catalog_defs.push(d); gf.type_param_counts.push(catalog.counts[d])
                gf.owner_tcounts.push(0); gf.has_self.push(false)
                gf.param_starts.push(gf.param_exprs.len); gf.param_counts.push(0); gf.ret_exprs.push(-1); gf.valid.push(false)
            }
            continue
        }
        capture_fn_signature(&catalog, &reg, platform, &mut gf, catalog.names[d].clone(), d, catalog.counts[d], 0, false, at, end)
    }
    for d in 0..catalog.names.len {
        if catalog.kinds[d] != 4 { continue }
        first := catalog.starts[d]; end := catalog.ends[d]
        mut at := first
        while at < end && catalog.slots[at] != -2 { at += 1 }
        at += 1
        if at >= end || !lexer.symbol(&catalog.bodies, at, "(") { continue }
        paren_at := at
        self_m := is_self_method(&catalog.bodies, paren_at + 1, end)
        mut sig_end := paren_at + 1; mut pdepth := 1
        while sig_end < end && pdepth > 0 {
            if lexer.symbol(&catalog.bodies, sig_end, "(") { pdepth += 1 }
            else if lexer.symbol(&catalog.bodies, sig_end, ")") { pdepth -= 1 }
            sig_end += 1
        }
        while sig_end < end && !lexer.symbol(&catalog.bodies, sig_end, "{") { sig_end += 1 }
        if pdepth == 0 && sig_end < end {
            owner_def := i32(catalog.definitions.get_or(catalog.method_targets[d], -1))
            key := catalog.method_targets[d] + "::" + catalog.method_names[d]
            capture_fn_signature(&catalog, &reg, platform, &mut gf, key, owner_def, catalog.counts[d], catalog.method_owner_counts[d], self_m, paren_at, sig_end)
        }
    }
    for d in 0..catalog.names.len {
        if !catalog.methods[d] || catalog.target_shapes[d] != 0 { continue }
        target := i32(catalog.definitions.get_or(catalog.names[d], -1))
        if target < 0 { continue }
        mut at := catalog.starts[d]; end := catalog.ends[d]
        while at < end && !lexer.symbol(&catalog.bodies, at, "{") { at += 1 }
        if at >= end { continue }
        at += 1
        mut depth := 1
        while at < end && depth > 0 {
            if lexer.symbol(&catalog.bodies, at, "{") { depth += 1; at += 1; continue }
            if lexer.symbol(&catalog.bodies, at, "}") { depth -= 1; at += 1; continue }
            if depth == 1 && catalog.bodies.texts[at] == "fn" && at + 2 < end &&
                catalog.bodies.kinds[at + 1] == .Name && lexer.symbol(&catalog.bodies, at + 2, "(") {
                mname := catalog.bodies.texts[at + 1].clone()
                paren_at := at + 2
                self_m := is_self_method(&catalog.bodies, paren_at + 1, end)
                mut sig_end := paren_at + 1
                mut pdepth := 1
                while sig_end < end && pdepth > 0 {
                    if lexer.symbol(&catalog.bodies, sig_end, "(") { pdepth += 1 }
                    else if lexer.symbol(&catalog.bodies, sig_end, ")") { pdepth -= 1 }
                    sig_end += 1
                }
                while sig_end < end && !lexer.symbol(&catalog.bodies, sig_end, "{") { sig_end += 1 }
                if !self_m && pdepth == 0 {
                    capture_fn_signature(&catalog, &reg, platform, &mut gf, catalog.names[d] + "::" + mname, target, catalog.counts[target], catalog.counts[target], false, paren_at, sig_end)
                }
                at = sig_end
                continue
            }
            at += 1
        }
    }
    gf
}
fn rename_prelude_tokens(tokens: &mut lexer.Tokens) {
    for i in 0..tokens.kinds.len - 1 {
        if tokens.kinds[i] != .Name { continue }
        if i > 0 && (lexer.symbol(&tokens, i - 1, ".") || lexer.symbol(&tokens, i - 1, "::")) { continue }
        if bundled.prelude_generic(tokens.texts[i]) && !lexer.symbol(&tokens, i + 1, "<") && !lexer.symbol(&tokens, i + 1, "::") { continue }
        bound := bundled.prelude_name(tokens.texts[i])
        if bound != "" { tokens.texts[i] = move bound }
    }
}
pub fn bind_program(input: &mut lexer.Tokens, reg: &mut ft.TypeRegistry, platform: i32) -> Program {
    mut catalog := Catalog { definitions:Map<string, i64>::new(), names:[], methods:[], impl_traits:[], next_impl:[], builtin:[], counts:[], kinds:[], target_shapes:[], c_layout:[], result:-1, option:-1, map:-1, set:-1, compound_impls:[], lazy_impls:[],
        method_owner_counts:[], method_targets:[], method_names:[], generic_method_names:Map<string, i64>::new(),
        bodies:lexer.empty(false), slots:[], starts:[], ends:[], removed:[], resume:[],
        constraints:Constraints {parameters:[], traits:[]}, constraint_starts:[0] }
    mut plan := instances(platform, move Map<string, i64>::new())
    mut core := lexer.scan(bundled.core_prelude(), false)
    rename_prelude_tokens(&mut core)
    collect(&mut catalog, &mut plan, &core, true, &mut reg)
    mut prelude := lexer.scan(bundled.generic_prelude(), false)
    rename_prelude_tokens(&mut prelude)
    collect(&mut catalog, &mut plan, &prelude, true, &mut reg)
    mut comb := lexer.scan(bundled.combinators_prelude(), false)
    rename_prelude_tokens(&mut comb)
    collect(&mut catalog, &mut plan, &comb, true, &mut reg)
    collect(&mut catalog, &mut plan, &input, false, &mut reg)
    for i in 0..catalog.names.len {
        d := catalog.names.len - 1 - i
        if !catalog.methods[d] || catalog.target_shapes[d] != 0 { continue }
        target := i32(catalog.definitions.get_or(catalog.names[d], -1))
        if target < 0 || catalog.counts[target] != catalog.counts[d] {
            reject(&mut plan, catalog.bodies.starts[catalog.starts[d]], "generic impl must match its type's parameters")
        } else if !catalog.builtin[d] && catalog.impl_traits[d] != "" && catalog.builtin[target] {
            catalog.lazy_impls.push(d)
        } else {
            catalog.next_impl[d] = catalog.next_impl[target]
            catalog.next_impl[target] = d
        }
    }
    mut source := BoundSource {tokens:lexer.empty(false), slots:[], applications:[], receivers:[], starts:[], ends:[], expressions:syntax.tree(), method_names:[], method_ends:[]}
    for d in 0..catalog.names.len {
        source.starts.push(source.slots.len)
        bind(&catalog, &mut plan, &reg, &mut source, &catalog.bodies, catalog.starts[d], catalog.ends[d], false)
        source.ends.push(source.slots.len)
        if catalog.methods[d] {
            first := source.starts[d]; end := source.ends[d]
            bind_methods(&mut source, first, end)
        }
    }
    root := source.slots.len
    bind(&catalog, &mut plan, &reg, &mut source, &input, 0, input.kinds.len - 1, true)
    checks_start := source.slots.len
    mut checks := Map<string, i64>::new()
    if plan.error == "" { checks = definition_checks(&catalog, &mut source, &mut plan) }
    if plan.error != "" { input.ok = false; input.error = plan.error.clone(); input.error_at = plan.at }
    mut has_custom_compound := false
    for def in &catalog.compound_impls {
        if !catalog.builtin[def] { has_custom_compound = true; break }
    }
    probe_compounds := needs_compound_probe(&input, has_custom_compound) || catalog.lazy_impls.len > 0
    gf := capture_generic_fns(&catalog, &reg, platform)
    catalog.bodies = lexer.empty(false); catalog.slots.clear(); catalog.removed.clear(); catalog.resume.clear()
    Program {catalog:move catalog, source:move source, root:root, checks_start:checks_start, checks:move checks, end:input.starts[input.kinds.len - 1], reserved:move plan.reserved, core:move core, has_compound_ops:probe_compounds, generic_fns:move gf, has_inferred_calls:plan.has_inferred_calls}
}
fn parse_decimal_len(s: string) -> i32 {
    if s.len == 0 || s.len > 8 { return -1 }
    mut v: i64 = 0
    for i in 0..s.len {
        b := s[i]
        if b < 48 || b > 57 { return -1 }
        v = v * 10 + i64(b - 48)
    }
    if v < 0 || v > 1048576 { return -1 }
    i32(v)
}
fn resolve_canonical_type(spec: string, reg: &mut ft.TypeRegistry, platform: i32) -> i32 {
    trimmed := text.trim(spec)
    if trimmed == "" { return -1 }
    direct := ft.type_id(&reg, trimmed)
    if direct >= 0 { return direct }
    if trimmed.len >= 2 && trimmed[0] == 91 && trimmed[1] == 93 {
        base := resolve_canonical_type(trimmed[2..trimmed.len], &mut reg, platform)
        if base <= 0 || !ft.array_element(&reg, base) { return -1 }
        ty := type_reader.compound(&mut reg, 1, base)
        if reg.error != "" { reg.error = ""; return -1 }
        return ty
    }
    if trimmed.len >= 5 && trimmed[0] == 38 && trimmed[1] == 109 && trimmed[2] == 117 && trimmed[3] == 116 && trimmed[4] == 32 {
        base := resolve_canonical_type(trimmed[5..trimmed.len], &mut reg, platform)
        if base <= 0 { return -1 }
        ty := type_reader.compound(&mut reg, 5, base)
        if reg.error != "" { reg.error = ""; return -1 }
        return ty
    }
    if trimmed.len >= 2 && trimmed[0] == 38 {
        base := resolve_canonical_type(trimmed[1..trimmed.len], &mut reg, platform)
        if base <= 0 { return -1 }
        ty := type_reader.compound(&mut reg, 4, base)
        if reg.error != "" { reg.error = ""; return -1 }
        return ty
    }
    if trimmed.len >= 4 && trimmed[0] == 91 && trimmed[trimmed.len - 1] == 93 {
        mut parens := 0; mut brackets := 0; mut angles := 0; mut sep := -1
        for i in 1..trimmed.len - 1 {
            b := trimmed[i]
            if b == 40 { parens += 1 } else if b == 41 { parens -= 1 }
            else if b == 91 { brackets += 1 } else if b == 93 { brackets -= 1 }
            else if b == 60 { angles += 1 } else if b == 62 && trimmed[i - 1] != 45 { angles -= 1 }
            else if b == 59 && parens == 0 && brackets == 0 && angles == 0 { sep = i; break }
        }
        if sep > 1 {
            base := resolve_canonical_type(trimmed[1..sep], &mut reg, platform)
            count := parse_decimal_len(text.trim(trimmed[sep + 1..trimmed.len - 1]))
            if base > 0 && count >= 0 {
                ty := type_reader.fixed(&mut reg, platform, base, count)
                if reg.error != "" { reg.error = ""; return -1 }
                return ty
            }
        }
        return -1
    }
    if trimmed.len >= 4 && trimmed[0] == 40 && trimmed[trimmed.len - 1] == 41 {
        mut parts: []string = []
        mut start := 1
        mut parens := 0; mut brackets := 0; mut angles := 0
        for i in 1..trimmed.len - 1 {
            b := trimmed[i]
            if b == 40 { parens += 1 } else if b == 41 { parens -= 1 }
            else if b == 91 { brackets += 1 } else if b == 93 { brackets -= 1 }
            else if b == 60 { angles += 1 } else if b == 62 && trimmed[i - 1] != 45 { angles -= 1 }
            else if b == 44 && parens == 0 && brackets == 0 && angles == 0 {
                parts.push(trimmed[start..i]); start = i + 1
            }
        }
        parts.push(trimmed[start..trimmed.len - 1])
        if parts.len >= 2 {
            mut fields: []i32 = []
            for part in &parts {
                fty := resolve_canonical_type(part, &mut reg, platform)
                if fty <= 0 { return -1 }
                fields.push(fty)
            }
            ty := ft.tuple_type(&mut reg, &fields)
            if reg.error != "" { reg.error = ""; return -1 }
            ft.finish_tuples(&mut reg)
            return ty
        }
    }
    -1
}
fn resolve_inferred_type(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    spec: string, site: i32, parent: i32) -> i32 {
    trimmed := text.trim(spec)
    if trimmed == "" { return -1 }
    if trimmed == "()" { return 0 }
    direct := resolve_canonical_type(trimmed, &mut reg, plan.platform)
    if direct >= 0 { return direct }
    if trimmed.len >= 2 && trimmed[0] == 91 && trimmed[1] == 93 {
        base := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, trimmed[2..trimmed.len], site, parent)
        if base <= 0 || !ft.array_element(&reg, base) { return -1 }
        ty := type_reader.compound(&mut reg, 1, base)
        if reg.error != "" { reg.error = ""; return -1 }
        return ty
    }
    if trimmed.len >= 5 && trimmed[0] == 38 && trimmed[1] == 109 && trimmed[2] == 117 && trimmed[3] == 116 && trimmed[4] == 32 {
        base := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, trimmed[5..trimmed.len], site, parent)
        if base <= 0 { return -1 }
        ty := type_reader.compound(&mut reg, 5, base)
        if reg.error != "" { reg.error = ""; return -1 }
        return ty
    }
    if trimmed.len >= 2 && trimmed[0] == 38 {
        base := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, trimmed[1..trimmed.len], site, parent)
        if base <= 0 { return -1 }
        ty := type_reader.compound(&mut reg, 4, base)
        if reg.error != "" { reg.error = ""; return -1 }
        return ty
    }
    if trimmed.len >= 4 && trimmed[0] == 91 && trimmed[trimmed.len - 1] == 93 {
        mut parens := 0; mut brackets := 0; mut angles := 0; mut sep := -1
        for i in 1..trimmed.len - 1 {
            b := trimmed[i]
            if b == 40 { parens += 1 } else if b == 41 { parens -= 1 }
            else if b == 91 { brackets += 1 } else if b == 93 { brackets -= 1 }
            else if b == 60 { angles += 1 } else if b == 62 && trimmed[i - 1] != 45 { angles -= 1 }
            else if b == 59 && parens == 0 && brackets == 0 && angles == 0 { sep = i; break }
        }
        if sep > 1 {
            base := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, trimmed[1..sep], site, parent)
            count := parse_decimal_len(text.trim(trimmed[sep + 1..trimmed.len - 1]))
            if base > 0 && count >= 0 {
                ty := type_reader.fixed(&mut reg, plan.platform, base, count)
                if reg.error != "" { reg.error = ""; return -1 }
                return ty
            }
        }
        return -1
    }
    if trimmed.len >= 4 && trimmed[0] == 40 && trimmed[trimmed.len - 1] == 41 {
        mut parts: []string = []
        mut start := 1
        mut parens := 0; mut brackets := 0; mut angles := 0
        for i in 1..trimmed.len - 1 {
            b := trimmed[i]
            if b == 40 { parens += 1 } else if b == 41 { parens -= 1 }
            else if b == 91 { brackets += 1 } else if b == 93 { brackets -= 1 }
            else if b == 60 { angles += 1 } else if b == 62 && trimmed[i - 1] != 45 { angles -= 1 }
            else if b == 44 && parens == 0 && brackets == 0 && angles == 0 {
                parts.push(trimmed[start..i]); start = i + 1
            }
        }
        parts.push(trimmed[start..trimmed.len - 1])
        if parts.len >= 2 {
            mut fields: []i32 = []
            for p in &parts {
                fty := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, p, site, parent)
                if fty <= 0 || !ft.array_element(&reg, fty) { return -1 }
                fields.push(fty)
            }
            ty := ft.tuple_type(&mut reg, &fields)
            if reg.error != "" { reg.error = ""; return -1 }
            ft.finish_tuples(&mut reg)
            return ty
        }
        return -1
    }
    mut fn_prefix := -1; mut callable_kind := 0
    mut variadic_fixed := -1
    if text.starts_with(trimmed, "fn(") { fn_prefix = 3; callable_kind = 9 }
    else if text.starts_with(trimmed, "Fn(") { fn_prefix = 3; callable_kind = 11 }
    else if text.starts_with(trimmed, "FnMut(") { fn_prefix = 6; callable_kind = 12 }
    else if text.starts_with(trimmed, "FnOnce(") { fn_prefix = 7; callable_kind = 13 }
    else if text.starts_with(trimmed, "extern fn(") { fn_prefix = "extern fn(".len; callable_kind = 8 }
    else if text.starts_with(trimmed, "@c_variadic(") {
        suffix := ") extern fn("
        end := text.find(trimmed, suffix).unwrap_or(-1)
        if end < "@c_variadic(".len { return -1 }
        variadic_fixed = parse_decimal_len(trimmed["@c_variadic(".len..end])
        if variadic_fixed < 0 { return -1 }
        fn_prefix = end + suffix.len
        callable_kind = 8
    }
    if fn_prefix > 0 {
        mut parens := 1; mut close := -1
        for i in fn_prefix..trimmed.len {
            if trimmed[i] == 40 { parens += 1 }
            else if trimmed[i] == 41 { parens -= 1; if parens == 0 { close = i; break } }
        }
        if close >= fn_prefix {
            mut args: []i32 = []
            inner := text.trim(trimmed[fn_prefix..close])
            if inner != "" {
                mut start := 0; mut p := 0; mut br := 0; mut ag := 0
                for i in 0..inner.len {
                    b := inner[i]
                    if b == 40 { p += 1 } else if b == 41 { p -= 1 }
                    else if b == 91 { br += 1 } else if b == 93 { br -= 1 }
                    else if b == 60 { ag += 1 } else if b == 62 && (i == 0 || inner[i - 1] != 45) { ag -= 1 }
                    else if b == 44 && p == 0 && br == 0 && ag == 0 {
                        aty := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, inner[start..i], site, parent)
                        if aty <= 0 { return -1 }
                        args.push(aty); start = i + 1
                    }
                }
                aty := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, inner[start..inner.len], site, parent)
                if aty <= 0 { return -1 }
                args.push(aty)
            }
            rest := text.trim(trimmed[close + 1..trimmed.len])
            mut ret := 0; mut borrow_src := -1
            if text.starts_with(rest, "->") {
                mut ret_part := text.trim(rest[2..rest.len])
                mut fidx := -1; mut fp := 0; mut fbr := 0; mut fag := 0
                for i in 0..ret_part.len {
                    b := ret_part[i]
                    if b == 40 { fp += 1 } else if b == 41 { fp -= 1 }
                    else if b == 91 { fbr += 1 } else if b == 93 { fbr -= 1 }
                    else if b == 60 { fag += 1 } else if b == 62 && (i == 0 || ret_part[i - 1] != 45) { fag -= 1 }
                    else if fp == 0 && fbr == 0 && fag == 0 && text.starts_with(ret_part[i..ret_part.len], " from ") {
                        fidx = i
                    }
                }
                if fidx >= 0 {
                    src_n := parse_decimal_len(text.trim(ret_part[fidx + 6..ret_part.len]))
                    if src_n < 1 || src_n > args.len { return -1 }
                    borrow_src = src_n - 1
                    ret_part = text.trim(ret_part[0..fidx])
                }
                ret = resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, ret_part, site, parent)
                if ret < 0 { return -1 }
            } else if rest != "" { return -1 }
            abi_parameter := if callable_kind == 8 { variadic_fixed } else { borrow_src }
            ty := type_reader.callable(&mut reg, &args, ret, callable_kind, abi_parameter)
            if reg.error != "" { reg.error = ""; return -1 }
            return ty
        }
        return -1
    }
    mut lt := -1; mut parens := 0; mut brackets := 0; mut angles := 0
    for i in 0..trimmed.len {
        b := trimmed[i]
        if b == 40 { parens += 1 } else if b == 41 { parens -= 1 }
        else if b == 91 { brackets += 1 } else if b == 93 { brackets -= 1 }
        else if b == 60 && parens == 0 && brackets == 0 {
            if angles == 0 { lt = i }
            angles += 1
        } else if b == 62 && (i == 0 || trimmed[i - 1] != 45) && parens == 0 && brackets == 0 {
            angles -= 1
        }
    }
    if lt > 0 && trimmed[trimmed.len - 1] == 62 && angles == 0 {
        base_name := text.trim(trimmed[0..lt])
        mut parts: []string = []
        mut start := lt + 1
        parens = 0; brackets = 0; angles = 0
        for i in (lt + 1)..(trimmed.len - 1) {
            b := trimmed[i]
            if b == 40 { parens += 1 } else if b == 41 { parens -= 1 }
            else if b == 91 { brackets += 1 } else if b == 93 { brackets -= 1 }
            else if b == 60 { angles += 1 } else if b == 62 && trimmed[i - 1] != 45 { angles -= 1 }
            else if b == 44 && parens == 0 && brackets == 0 && angles == 0 {
                parts.push(trimmed[start..i]); start = i + 1
            }
        }
        parts.push(trimmed[start..trimmed.len - 1])
        mut sub_types: []i32 = []
        for p in &parts {
            sub_ty := resolve_inferred_type(&catalog, &source, &mut plan, &mut reg, p, site, parent)
            if sub_ty < 0 { return -1 }
            sub_types.push(sub_ty)
        }
        if base_name == "Task" && sub_types.len == 1 {
            ty := type_reader.compound(&mut reg, 24, sub_types[0])
            if reg.error != "" { reg.error = ""; return -1 }
            return ty
        }
        decl := i32(catalog.definitions.get_or(base_name, -1))
        if decl >= 0 && !catalog.methods[decl] && (catalog.kinds[decl] == 2 || catalog.kinds[decl] == 3) && sub_types.len == catalog.counts[decl] {
            inst := request(&catalog, &source, &mut plan, &mut reg, decl, &sub_types, site, parent)
            if plan.error != "" || inst < 0 { return -1 }
            return plan.types[inst]
        }
    }
    -1
}
fn request_compound(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    def: i32, types: &[]i32, target_ty: i32, target_name: string, site: i32, parent: i32) {
    known := type_keys.find(&plan.index, def, &types)
    if known >= 0 { return }
    instance := plan.names.len
    if instance >= 65536 { reject(&mut plan, site, "generic instance count exceeds 65536"); return }
    depth := argument_depth(&plan, &types)
    type_keys.insert(&mut plan.index, def, &types, instance)
    plan.names.push(target_name.clone()); plan.definitions.push(def); plan.sites.push(site); plan.parents.push(parent); plan.depths.push(depth)
    plan.starts.push(plan.arguments.len)
    for ty in &types { plan.arguments.push(ft.argument_name(&mut reg, ty)) }
    plan.types.push(target_ty)
    plan.method_impl_targets.push("")
}
fn request_compound_impls(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    ty: i32, seen: &mut Map<string, i64>, site: i32, parent: i32) {
    if ty <= 0 || ty >= reg.declared.type_kinds.len + reg.body.type_kinds.len { return }
    mut shape := 0
    if ft.type_kind(&reg, ty) == 1 { shape = 1 }
    else if ft.type_kind(&reg, ty) == 6 { shape = -1 }
    else if ft.is_tuple(&reg, ty) {
        ft.finish_tuples(&mut reg)
        shape = ft.type_count(&reg, ty)
    }
    if shape == 0 { return }
    key := ty.str()
    if seen.contains(key) { return }
    seen.put(move key, 1)
    mut elem_types: []i32 = []
    if shape == -1 {
        elem_types.push(ft.type_base(&reg, ty))
        elem_types.push(ty)
    } else if shape == 1 { elem_types.push(ft.type_base(&reg, ty)) }
    else {
        first := ft.type_start(&reg, ty)
        for i in 0..shape { elem_types.push(reg.field_types[first + i]) }
    }
    target_name := ft.canonical_spelling(&reg, ty)
    if !reg.named_map.contains(target_name) { reg.named_map.put(target_name.clone(), i64(ty)) }
    for def in &catalog.compound_impls {
        if catalog.target_shapes[def] == shape {
            request_compound(&catalog, &mut plan, &mut reg, def, &elem_types, ty, target_name, site, parent)
            if plan.error != "" { return }
        }
    }
}
fn drain_compound_demands(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    compounds: &Map<string, i64>, seen: &mut Map<string, i64>, platform: i32,
    arg_at: &mut i32, req_at: &mut i32, cond_at: &mut i32) {
    for i in 0..compounds.len() {
        ty := resolve_canonical_type(compounds.key_at(i), &mut reg, platform)
        if ty > 0 { request_compound_impls(&catalog, &mut plan, &mut reg, ty, &mut seen, 0, -1) }
        if plan.error != "" { return }
    }
    while arg_at < plan.index.arguments.len || req_at < plan.requirements.trait_receivers.len || cond_at < plan.conditional_impls.cond_receivers.len {
        while arg_at < plan.index.arguments.len {
            ty := plan.index.arguments[arg_at]; arg_at += 1
            request_compound_impls(&catalog, &mut plan, &mut reg, ty, &mut seen, 0, -1)
            if plan.error != "" { return }
        }
        while req_at < plan.requirements.trait_receivers.len {
            ty := plan.requirements.trait_receivers[req_at]; site := plan.requirements.trait_sites[req_at]; req_at += 1
            request_compound_impls(&catalog, &mut plan, &mut reg, ty, &mut seen, site, -1)
            if plan.error != "" { return }
        }
        while cond_at < plan.conditional_impls.cond_receivers.len {
            ty := plan.conditional_impls.cond_receivers[cond_at]; cond_at += 1
            request_compound_impls(&catalog, &mut plan, &mut reg, ty, &mut seen, 0, -1)
            if plan.error != "" { return }
        }
    }
}
fn lazy_impl_has_method(source: &BoundSource, d: i32, method_name: string) -> bool {
    for at in source.starts[d]..source.ends[d] {
        m := source.method_names[at]
        if m >= 0 && source.tokens.texts[m] == method_name { return true }
    }
    false
}
fn split_last_double_colon(key: string) -> i32 {
    if key.len < 2 { return -1 }
    mut i := key.len - 2
    while i >= 0 {
        if key[i] == 58 && key[i + 1] == 58 { return i }
        i -= 1
    }
    -1
}
fn emit_lazy_impl(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    layout: &mut Layout, output: &mut lexer.Tokens, position: &mut i32, wanted: &Map<string, i64>,
    inferred_keys: &Map<string, i64>, inferred_args: &[]string, seen_lazy: &mut Map<string, i64>,
    inst: i32, d: i32) {
    lkey := inst.str() + ":" + d.str()
    if seen_lazy.contains(lkey) { return }
    seen_lazy.put(move lkey, 1)
    site := origin(&layout, plan.sites[inst])
    if catalog.constraint_starts[d] < catalog.constraint_starts[d + 1] {
        record_conditional_impl(&catalog, &mut plan, d, inst, site)
    }
    token(&mut output, .Newline, "\n", site)
    lower(&catalog, &mut plan, &mut reg, &source, &mut output, source.starts[d], source.ends[d], inst, false, &mut position, &wanted, &inferred_keys, &inferred_args)
    layout.end = position
}
fn drain_lazy_impls(catalog: &Catalog, source: &BoundSource, plan: &mut Instances, reg: &mut ft.TypeRegistry,
    layout: &mut Layout, output: &mut lexer.Tokens, position: &mut i32, wanted: &Map<string, i64>,
    inferred_keys: &Map<string, i64>, inferred_args: &[]string, compounds: &Map<string, i64>,
    seen_lazy: &mut Map<string, i64>, inst_by_ty: &mut Map<string, i64>, inst_by_name: &mut Map<string, i64>,
    tracked_inst: &mut i32, lazy_req_at: &mut i32, lazy_cond_at: &mut i32) {
    while tracked_inst < plan.names.len {
        idx := tracked_inst
        tracked_inst += 1
        def_i := plan.definitions[idx]
        if !catalog.methods[def_i] && (catalog.kinds[def_i] == 2 || catalog.kinds[def_i] == 3) {
            ty_id := plan.types[idx]
            if ty_id >= 0 {
                inst_by_ty.put(ty_id.str(), i64(idx))
                inst_by_name.put(plan.names[idx].clone(), i64(idx))
            }
        }
    }
    for i in 0..compounds.len() {
        if plan.error != "" { return }
        key := compounds.key_at(i)
        sep := split_last_double_colon(key)
        if sep <= 0 { continue }
        ty_name := key[0..sep]
        m_name := key[sep + 2..key.len]
        inst := i32(inst_by_name.get_or(ty_name, -1))
        if inst < 0 { continue }
        fam := &catalog.names[plan.definitions[inst]]
        for d in &catalog.lazy_impls {
            if catalog.names[d] == fam && lazy_impl_has_method(&source, d, m_name) {
                emit_lazy_impl(&catalog, &source, &mut plan, &mut reg, &mut layout, &mut output, &mut position, &wanted, &inferred_keys, &inferred_args, &mut seen_lazy, inst, d)
                if plan.error != "" { return }
            }
        }
    }
    while lazy_req_at < plan.requirements.trait_receivers.len && plan.error == "" {
        idx := lazy_req_at
        lazy_req_at += 1
        ty := plan.requirements.trait_receivers[idx]
        tr := plan.requirements.trait_names[idx].clone()
        inst := i32(inst_by_ty.get_or(ty.str(), -1))
        if inst < 0 { continue }
        fam := &catalog.names[plan.definitions[inst]]
        for d in &catalog.lazy_impls {
            if catalog.names[d] == fam && catalog.impl_traits[d] == tr {
                emit_lazy_impl(&catalog, &source, &mut plan, &mut reg, &mut layout, &mut output, &mut position, &wanted, &inferred_keys, &inferred_args, &mut seen_lazy, inst, d)
                if plan.error != "" { return }
            }
        }
    }
    while lazy_cond_at < plan.conditional_impls.cond_receivers.len && plan.error == "" {
        idx := lazy_cond_at
        lazy_cond_at += 1
        tr := plan.conditional_impls.cond_traits[idx].clone()
        if tr == "" { continue }
        ty := plan.conditional_impls.cond_receivers[idx]
        inst := i32(inst_by_ty.get_or(ty.str(), -1))
        if inst < 0 { continue }
        fam := &catalog.names[plan.definitions[inst]]
        for d in &catalog.lazy_impls {
            if catalog.names[d] == fam && catalog.impl_traits[d] == tr {
                emit_lazy_impl(&catalog, &source, &mut plan, &mut reg, &mut layout, &mut output, &mut position, &wanted, &inferred_keys, &inferred_args, &mut seen_lazy, inst, d)
                if plan.error != "" { return }
            }
        }
    }
}
fn expand_self_methods(source: &BoundSource, d: i32, inst_name: string, wanted: &mut Map<string, i64>) {
    if wanted.len() == 0 { return }
    first := source.starts[d]; end := source.ends[d]
    mut mnames: []string = []; mut mstarts: []i32 = []; mut mends: []i32 = []
    mut mindex := Map<string, i64>::new()
    mut at := first
    while at < end {
        m := source.method_names[at]
        if m >= 0 {
            mn := source.tokens.texts[m].clone()
            me := source.method_ends[at]
            idx := mnames.len
            mnames.push(mn.clone()); mstarts.push(at); mends.push(me)
            mindex.put(move mn, i64(idx))
            at = me + 1
            continue
        }
        at += 1
    }
    if mnames.len < 2 { return }
    mut queued: []bool = []; mut work: []i32 = []
    for i in 0..mnames.len {
        if wanted.contains(inst_name + "::" + mnames[i]) {
            queued.push(true); work.push(i)
        } else {
            queued.push(false)
        }
    }
    mut head := 0
    while head < work.len {
        mi := work[head]; head += 1
        mut k := mstarts[mi]
        limit := mends[mi]
        while k + 3 <= limit {
            if (source.tokens.texts[k] == "self" && lexer.symbol(&source.tokens, k + 1, ".")) ||
               (source.tokens.texts[k] == "Self" && lexer.symbol(&source.tokens, k + 1, "::")) {
                if source.tokens.kinds[k + 2] == .Name &&
                    (lexer.symbol(&source.tokens, k + 3, "(") || lexer.symbol(&source.tokens, k + 3, "<")) {
                    target := i32(mindex.get_or(source.tokens.texts[k + 2], -1))
                    if target >= 0 && !queued[target] {
                        queued[target] = true
                        work.push(target)
                        wanted.put(inst_name + "::" + mnames[target], 1)
                    }
                }
                k += 3
                continue
            }
            k += 1
        }
    }
}
pub fn materialize(program: &Program, input: &mut lexer.Tokens, reg: &mut ft.TypeRegistry, platform: i32, wanted: &Map<string, i64>, compounds: &Map<string, i64>, inferred_keys: &Map<string, i64>, inferred_args: &[]string, definitions: bool) -> Layout {
    mut layout := layout()
    catalog := &program.catalog; source := &program.source; root := program.root
    mut plan := instances(platform, move program.reserved.clone())
    mut effective_wanted := wanted.clone()
    mut output := lexer.empty(false)
    mut position := program.end + 1
    end := if definitions { source.slots.len } else { program.checks_start }
    est_cap := end - root + program.core.kinds.len + 4096
    output.kinds.reserve(est_cap); output.texts.reserve(est_cap); output.starts.reserve(est_cap)
    if definitions { layout.definition_checks = program.checks.clone() }
    lower(&catalog, &mut plan, &mut reg, &source, &mut output, root, end, -1, false, &mut position, &effective_wanted, &inferred_keys, &inferred_args)
    layout.first = position
    if program.core.kinds.len > 1 {
        layout.starts.push(position); layout.positions.push(0)
        token(&mut output, .Newline, "\n", position); position += 1
        for k in 0..program.core.kinds.len - 1 {
            token(&mut output, program.core.kinds[k], program.core.texts[k], position); position += 1
        }
        layout.end = position
    }
    mut seen_compounds := Map<string, i64>::new()
    mut arg_at := 0; mut req_at := 0; mut cond_at := 0
    drain_compound_demands(&catalog, &mut plan, &mut reg, &compounds, &mut seen_compounds, platform, &mut arg_at, &mut req_at, &mut cond_at)
    mut seen_lazy := Map<string, i64>::new()
    mut inst_by_ty := Map<string, i64>::new()
    mut inst_by_name := Map<string, i64>::new()
    mut tracked_inst := 0
    mut lazy_req_at := 0
    mut lazy_cond_at := 0
    mut instance := 0
    while (instance < plan.names.len || (catalog.lazy_impls.len > 0 && (tracked_inst < plan.names.len || lazy_req_at < plan.requirements.trait_receivers.len || lazy_cond_at < plan.conditional_impls.cond_receivers.len))) && plan.error == "" {
        while instance < plan.names.len && plan.error == "" {
            def := plan.definitions[instance]
            mut d := def
            while d >= 0 && plan.error == "" {
                mut applicable := true
                if catalog.methods[d] && catalog.impl_traits[d] == "" {
                    for b in catalog.constraint_starts[d]..catalog.constraint_starts[d + 1] {
                        if catalog.constraints.traits[b] == "Storable" {
                            receiver := plan.index.arguments[plan.index.starts[instance] + catalog.constraints.parameters[b]]
                            if !ft.array_element(&reg, receiver) { applicable = false; break }
                        }
                    }
                }
                if !applicable { d = catalog.next_impl[d]; continue }
                site := origin(&layout, plan.sites[instance])
                if catalog.methods[d] { expand_self_methods(&source, d, plan.names[instance], &mut effective_wanted) }
                if catalog.methods[d] && catalog.constraint_starts[d] < catalog.constraint_starts[d + 1] {
                    if catalog.impl_traits[d] != "" {
                        record_conditional_impl(&catalog, &mut plan, d, instance, site)
                    } else {
                        for at in source.starts[d]..source.ends[d] {
                            method := source.method_names[at]
                            if method >= 0 && effective_wanted.contains(plan.names[instance] + "::" + source.tokens.texts[method]) {
                                require_arguments(&catalog, &mut plan, &reg, d, instance, site); break
                            }
                        }
                    }
                }
                if catalog.builtin[d] { layout.starts.push(position); layout.positions.push(site) }
                token(&mut output, .Newline, "\n", site)
                lower(&catalog, &mut plan, &mut reg, &source, &mut output, source.starts[d], source.ends[d], instance, catalog.builtin[d], &mut position, &effective_wanted, &inferred_keys, &inferred_args)
                layout.end = position
                d = catalog.next_impl[d]
            }
            drain_compound_demands(&catalog, &mut plan, &mut reg, &compounds, &mut seen_compounds, platform, &mut arg_at, &mut req_at, &mut cond_at)
            instance += 1
        }
        if plan.error == "" && catalog.lazy_impls.len > 0 {
            drain_lazy_impls(&catalog, &source, &mut plan, &mut reg, &mut layout, &mut output, &mut position, &effective_wanted, &inferred_keys, &inferred_args, &compounds, &mut seen_lazy, &mut inst_by_ty, &mut inst_by_name, &mut tracked_inst, &mut lazy_req_at, &mut lazy_cond_at)
            drain_compound_demands(&catalog, &mut plan, &mut reg, &compounds, &mut seen_compounds, platform, &mut arg_at, &mut req_at, &mut cond_at)
        }
    }
    if plan.error != "" {
        input.ok = false; input.error = plan.error.clone(); input.error_at = origin(&layout, plan.at)
        return layout
    }
    layout.reserved = move plan.reserved
    layout.pending = move plan.pending
    layout.requirements = move plan.requirements
    layout.conditional_impls = move plan.conditional_impls
    for i in 0..plan.names.len {
        id_key := if catalog.kinds[plan.definitions[i]] == 4 { plan.method_impl_targets[i] + "::" + plan.names[i] } else { plan.names[i].clone() }
        layout.instance_ids.put(move id_key, i64(i)); layout.sites.push(origin(&layout, plan.sites[i]))
    }
    layout.parents = move plan.parents
    layout.generic_fns = program.generic_fns.clone()
    layout.inferred_lookup = move plan.inferred_lookup
    mut max_ty := -1
    for i in 0..plan.types.len { if plan.types[i] > max_ty { max_ty = plan.types[i] } }
    for _ in 0..max_ty + 1 {
        layout.type_instance_def.push(-1); layout.type_instance_arg_starts.push(0); layout.type_instance_arg_counts.push(0)
    }
    for i in 0..plan.types.len {
        ty := plan.types[i]
        if ty >= 0 && (catalog.kinds[plan.definitions[i]] == 2 || catalog.kinds[plan.definitions[i]] == 3) && !catalog.methods[plan.definitions[i]] {
            layout.type_instance_def[ty] = plan.definitions[i]
            first_arg := plan.index.starts[i]
            arg_count := if i + 1 < plan.index.starts.len { plan.index.starts[i + 1] - first_arg } else { plan.index.arguments.len - first_arg }
            layout.type_instance_arg_starts[ty] = layout.type_instance_args.len
            layout.type_instance_arg_counts[ty] = arg_count
            for k in 0..arg_count { layout.type_instance_args.push(plan.index.arguments[first_arg + k]) }
        }
    }
    token(&mut output, .End, "", position)
    input.kinds = move output.kinds; input.texts = move output.texts; input.starts = move output.starts
    input.ends.clear(); input.ids.clear(); input.intern = false; input.store_ends = false
    layout
}
