import lexer
import generic_arguments as args
import ..bundled
import type_keys
import type_reader
import type_syntax as syntax
import frontend_types as ft
import std.map as map

pub struct Layout {
    first: i32, starts: []i32, positions: []i32, end: i32,
    reserved: map.Map, requirements: Requirements, instance_ids: map.Map, function_instances: []i32,
    sites: []i32, parents: []i32, error_function: i32,
}
pub struct Requirements { receivers: []i32, methods: []string, signatures: []i32, sites: []i32 }
fn requirements() -> Requirements { Requirements {receivers:[], methods:[], signatures:[], sites:[]} }
pub fn layout() -> Layout { Layout {first:-1, starts:[], positions:[], end:-1, reserved:map.new(), requirements:requirements(), instance_ids:map.new(), function_instances:[], sites:[], parents:[], error_function:-1} }
pub fn generated(layout: &Layout, position: i32) -> bool {
    layout.first >= 0 && position >= layout.first && position < layout.end
}
pub fn origin(layout: &Layout, position: i32) -> i32 {
    if !generated(&layout, position) { return position }
    mut i := layout.starts.len - 1
    while i > 0 && layout.starts[i] > position { i -= 1 }
    layout.positions[i]
}

struct Catalog {
    definitions: map.Map, names: []string, methods: []bool, next_impl: []i32, builtin: []bool,
    counts: []i32, kinds: []i32, result: i32,
    bodies: lexer.Tokens, slots: []i32, starts: []i32, ends: []i32,
    removed: []i32, resume: []i32, constraints: Constraints, constraint_starts: []i32,
}
struct Constraints { parameters: []i32, methods: []string, signatures: lexer.Tokens, starts: []i32, slots: []i32 }
struct Instances {
    index: type_keys.Index, definitions: []i32, names: []string, sites: []i32, parents: []i32,
    arguments: []string, types: []i32, starts: []i32, reserved: map.Map, platform: i32,
    requirements: Requirements, error: string, at: i32,
}

fn reject(plan: &mut Instances, at: i32, message: string) {
    if plan.error == "" { plan.at = at; plan.error = message.clone() }
}
fn declaration(word: string) -> bool {
    word == "fn" || word == "struct" || word == "enum" || word == "impl"
}
fn prefix(input: &lexer.Tokens, keyword: i32) -> i32 {
    mut first := keyword
    while first > 0 {
        mut p := first - 1
        while p >= 0 && lexer.is_newline(input.kinds[p]) { p -= 1 }
        if p < 0 { break }
        word := &input.texts[p]
        if (word == "pub" || word == "opaque" || word == "unsafe") && p == first - 1 { first = p; continue }
        if args.symbol(&input, p, ")") {
            while p > 0 && !args.symbol(&input, p, "(") { p -= 1 }
            p -= 1
        }
        if args.symbol(&input, p - 1, "@") { first = p - 1; continue }
        break
    }
    first
}
fn body_open(input: &lexer.Tokens, keyword: i32, after: i32, last: i32) -> i32 {
    mut at := after
    if input.texts[keyword] == "fn" {
        if !args.symbol(&input, at, "(") { return last }
        at = args.closing(&input, at, last, "(", ")") + 1
        if args.symbol(&input, at, "->") {
            at = args.type_end(&input, at + 1, last, 0)
            if at + 1 < last && input.texts[at] == "from" { at += 2 }
        }
    }
    while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
    if args.symbol(&input, at, "{") { at } else { last }
}
fn parameter_index(params: &[]string, word: string) -> i32 {
    for i in 0..params.len { if params[i] == word { return i } }
    -1
}
fn constraints(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, params: &[]string, first: i32, last: i32) -> i32 {
    mut at := first
    if input.texts[at] != "where" { return at }
    at += 1
    while at < last {
        while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
        if at >= last { reject(&mut plan, input.starts[last], "expected a where requirement"); return last }
        storage := input.texts[at] == "storable" && args.symbol(&input, at + 1, "(")
        if storage { at += 2 }
        if at >= last { reject(&mut plan, input.starts[last], "expected a type parameter in where clause"); return last }
        parameter := parameter_index(&params, input.texts[at])
        if parameter < 0 { reject(&mut plan, input.starts[at], "expected a type parameter in where clause"); return last }
        at += 1
        mut method := ""
        if storage {
            if !args.symbol(&input, at, ")") { reject(&mut plan, input.starts[at], "expected ')' in storable requirement"); return last }
            at += 1
        } else {
            if at + 3 >= last || !args.symbol(&input, at, ".") || input.kinds[at + 1] != .Name ||
                !args.symbol(&input, at + 2, ":") || input.texts[at + 3] != "fn" {
                reject(&mut plan, input.starts[at], "expected a method name and function type in where clause"); return last
            }
            method = input.texts[at + 1].clone(); at += 3
            end := args.type_end(&input, at, last, 0)
            if end <= at { reject(&mut plan, input.starts[at], "invalid required function type"); return last }
            for i in at..end {
                args.token(&mut catalog.constraints.signatures, input.kinds[i], input.texts[i], input.starts[i])
                catalog.constraints.slots.push(parameter_index(&params, input.texts[i]))
            }
            at = end
        }
        catalog.constraints.methods.push(move method); catalog.constraints.parameters.push(parameter)
        catalog.constraints.starts.push(catalog.constraints.slots.len)
        if !args.symbol(&input, at, ",") { break }
        at += 1
    }
    at
}
fn capture(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, keyword: i32, builtin: bool) -> i32 {
    last := input.kinds.len - 1
    name := &input.texts[keyword + 1]
    site := input.starts[keyword + 1]
    method := input.texts[keyword] == "impl"
    first := prefix(&input, keyword)
    params := args.parameters(&input, keyword + 1)
    if params.error != "" { reject(&mut plan, input.starts[params.after], params.error); return last }
    after := constraints(&mut catalog, &mut plan, &input, &params.names, params.after, last)
    if plan.error != "" { return last }
    catalog.constraint_starts.push(catalog.constraints.methods.len)
    open := body_open(&input, keyword, after, last)
    close := args.closing(&input, open, last, "{", "}")
    if close == last { reject(&mut plan, site, "expected a generic declaration body"); return last }
    if !method {
        if catalog.definitions.contains(name) { reject(&mut plan, site, "duplicate generic declaration"); return last }
        catalog.definitions.put(name.clone(), i64(catalog.names.len))
    }
    catalog.names.push(name.clone()); catalog.methods.push(method); catalog.next_impl.push(-1); catalog.builtin.push(builtin)
    if builtin && !method && name == args.prelude_binding("Result") { catalog.result = catalog.names.len - 1 }
    kind := if input.texts[keyword] == "struct" { 2 } else if input.texts[keyword] == "enum" { 3 } else { 0 }
    catalog.kinds.push(kind); catalog.counts.push(params.names.len)
    catalog.starts.push(catalog.slots.len)
    for i in first..close + 1 {
        if i >= keyword + 2 && i < after { continue }
        mut slot := -1
        if i == keyword + 1 { slot = -2 }
        else if input.kinds[i] == .Name && !args.symbol(&input, i - 1, ".") && !args.symbol(&input, i - 1, "::") &&
            !args.symbol(&input, i + 1, ":") {
            for p in 0..params.names.len {
                if input.texts[i] == params.names[p] { slot = p; break }
            }
        }
        catalog.slots.push(slot)
        args.token(&mut catalog.bodies, input.kinds[i], input.texts[i], input.starts[i])
    }
    catalog.ends.push(catalog.slots.len)
    if !builtin { catalog.removed.push(first); catalog.resume.push(close + 1) }
    close + 1
}
fn collect(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, builtin: bool, reg: &mut ft.TypeRegistry) {
    mut i := 0
    mut level := 0
    while i + 2 < input.kinds.len && plan.error == "" {
        if level == 0 && declaration(input.texts[i]) && input.kinds[i + 1] == .Name && args.symbol(&input, i + 2, "<") {
            i = capture(&mut catalog, &mut plan, &input, i, builtin); continue
        }
        if level == 0 && (input.texts[i] == "struct" || input.texts[i] == "enum") && input.kinds[i + 1] == .Name {
            name := &input.texts[i + 1]
            if ft.type_id(&reg, name) >= 0 { reject(&mut plan, input.starts[i + 1], "duplicate type"); return }
            kind := if input.texts[i] == "struct" { 2 } else { 3 }
            ty := ft.add_type(&mut reg, name, kind, 0); plan.reserved.put(name.clone(), i64(ty))
            for attr in prefix(&input, i)..i { if input.texts[attr] == "c_layout" { reg.c_record[ty] = true } }
        }
        if args.symbol(&input, i, "{") { level += 1 }
        else if args.symbol(&input, i, "}") { level -= 1 }
        i += 1
    }
}

fn request(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry, def: i32, types: &[]i32, site: i32, parent: i32) -> i32 {
    family := &catalog.names[def]
    known := type_keys.find(&plan.index, def, &types)
    if known >= 0 { return known }
    instance := plan.names.len
    mut repeats := 0; mut ancestor := parent
    while ancestor >= 0 {
        if plan.definitions[ancestor] == def {
            repeats += 1
            if repeats >= 64 {
                reject(&mut plan, site, "generic specialization nesting limit: recurring declaration with changing arguments, previous instance " + plan.names[ancestor])
                return -1
            }
        }
        ancestor = plan.parents[ancestor]
    }
    if instance >= 65536 { reject(&mut plan, site, "generic instance count exceeds 65536"); return -1 }
    mut name := family + "<"
    for i in 0..types.len {
        if i > 0 { name += ", " }
        name += ft.type_spelling(&reg, types[i])
        if name.len > 65536 { reject(&mut plan, site, "generic type exceeds compiler resource limit"); return -1 }
    }
    name += ">"
    type_keys.insert(&mut plan.index, def, &types, instance)
    plan.names.push(name.clone()); plan.definitions.push(def); plan.sites.push(site); plan.parents.push(parent)
    plan.starts.push(plan.arguments.len)
    for ty in &types { plan.arguments.push(ft.argument_name(&mut reg, ty)) }
    for b in catalog.constraint_starts[def]..catalog.constraint_starts[def + 1] {
        bounds_table := &catalog.constraints; receiver := types[bounds_table.parameters[b]]
        if bounds_table.methods[b] == "" {
            if !ft.array_element(&reg, receiver) { reject(&mut plan, site, "type argument must be a storable value"); return -1 }
        } else {
            mut signature := lexer.empty(false)
            for i in bounds_table.starts[b]..bounds_table.starts[b + 1] {
                slot := bounds_table.slots[i]
                word := if slot >= 0 { plan.arguments[plan.starts[instance] + slot].clone() } else { bounds_table.signatures.texts[i].clone() }
                args.token(&mut signature, bounds_table.signatures.kinds[i], word, bounds_table.signatures.starts[i])
            }
            mut reader := syntax.cursor(0, signature.kinds.len)
            required := type_reader.read(&mut reader, &mut reg, &signature, plan.platform)
            if reader.error != "" { reject(&mut plan, site, reader.error); return -1 }
            if reg.error != "" { reject(&mut plan, site, reg.error); return -1 }
            plan.requirements.receivers.push(receiver); plan.requirements.methods.push(bounds_table.methods[b].clone())
            plan.requirements.signatures.push(required); plan.requirements.sites.push(site)
        }
    }
    mut nominal := -1
    if catalog.kinds[def] != 0 {
        ty := ft.add_type(&mut reg, name, catalog.kinds[def], 0)
        nominal = ty
        plan.reserved.put(name.clone(), i64(ty))
        if def == catalog.result {
            for arg in &types {
                if arg != 0 && !ft.array_element(&reg, arg) { reject(&mut plan, site, "Result type arguments must be storable values or ()"); return -1 }
            }
            reg.result_success[ty] = types[0]; reg.result_failure[ty] = types[1]
        }
    }
    plan.types.push(nominal)
    instance
}

struct BoundSource {
    tokens: lexer.Tokens, slots: []i32, applications: []i32, receivers: []i32,
    starts: []i32, ends: []i32, expressions: syntax.Tree,
}
fn bound_token(source: &mut BoundSource, kind: lexer.Kind, word: string, at: i32, slot: i32, application: i32, receiver: i32) {
    args.token(&mut source.tokens, kind, word, at); source.slots.push(slot)
    source.applications.push(application); source.receivers.push(receiver)
}
fn bind(catalog: &Catalog, plan: &mut Instances, reg: &ft.TypeRegistry, source: &mut BoundSource,
    input: &lexer.Tokens, first: i32, end: i32, root: bool) {
    mut at := first; mut removed := 0; mut depth := 0; mut receiver := -1
    while at < end && plan.error == "" {
        if root && removed < catalog.removed.len && at == catalog.removed[removed] {
            at = catalog.resume[removed]; removed += 1; continue
        }
        word := &input.texts[at]; kind := input.kinds[at]; site := input.starts[at]
        if root && depth == 0 && word == "impl" && at + 1 < end { receiver = ft.type_id(&reg, input.texts[at + 1]) }
        if args.symbol(&input, at, "{") { depth += 1 }
        else if args.symbol(&input, at, "}") { depth -= 1; if depth == 0 { receiver = -1 } }
        slot := if root { -1 } else { catalog.slots[at] }
        if kind != .Name || slot != -1 || !args.symbol(&input, at + 1, "<") || !catalog.definitions.contains(word) {
            bound_token(&mut source, kind, word, site, slot, -1, receiver); at += 1; continue
        }
        mut cursor := syntax.cursor(at, end)
        begin := source.expressions.forms.len
        expr := syntax.parse(&mut source.expressions, &mut cursor, &input, 0)
        if expr < 0 { reject(&mut plan, site, cursor.error); return }
        for i in begin..expr + 1 {
            form := source.expressions.forms[i]; name := &source.expressions.names[i]
            index := source.expressions.positions[i]
            if form == .Name {
                param := if root { -1 } else { catalog.slots[index] }
                if param >= 0 { source.expressions.values[i] = -2 - param }
                else if name == "Self" { source.expressions.values[i] = -1 }
                else {
                    ty := ft.type_id(&reg, name)
                    if ty < 0 { reject(&mut plan, input.starts[index], "unknown type '" + name + "'"); return }
                    source.expressions.values[i] = ty
                }
            } else if form == .Apply {
                decl := i32(catalog.definitions.get_or(name, -1)); count := source.expressions.starts[i + 1] - source.expressions.starts[i]
                if decl < 0 {
                    if name != "TaskID" { reject(&mut plan, input.starts[index], "unknown generic type '" + name + "'"); return }
                    if count != 1 { reject(&mut plan, input.starts[index], "TaskID expects one type argument"); return }
                } else if count != catalog.counts[decl] {
                    reject(&mut plan, input.starts[index], "wrong number of type arguments: expected " + catalog.counts[decl].str() + ", got " + count.str()); return
                } else if i != expr && catalog.kinds[decl] == 0 {
                    reject(&mut plan, input.starts[index], "expected a generic type"); return
                }
                source.expressions.values[i] = decl
            }
        }
        bound_token(&mut source, kind, word, site, slot, expr, receiver)
        if cursor.assignment >= 0 { bound_token(&mut source, .Symbol, "=", input.starts[cursor.assignment] + 1, -1, -1, -1) }
        at = cursor.at
    }
}
fn evaluate(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry, tree: &syntax.Tree,
    id: i32, parent: i32, receiver: i32, site: i32, application: bool) -> i32 {
    form := tree.forms[id]; value := tree.values[id]
    if form == .Name {
        if value >= 0 { return value }
        if value == -1 {
            if receiver < 0 { reject(&mut plan, site, "Self is only valid inside an impl block") }
            return receiver
        }
        return plan.index.arguments[plan.index.starts[parent] - 2 - value]
    }
    mut types: []i32 = []
    for i in tree.starts[id]..tree.starts[id + 1] {
        ty := evaluate(&catalog, &mut plan, &mut reg, &tree, tree.children[i], parent, receiver, site, false)
        if plan.error != "" { return -1 }
        types.push(ty)
    }
    if form == .Apply && value >= 0 {
        instance := request(&catalog, &mut plan, &mut reg, value, &types, site, parent)
        if instance < 0 || application { return instance }
        return plan.types[instance]
    }
    ty := type_reader.resolve(&mut reg, &tree, id, &types, plan.platform)
    if reg.error != "" { reject(&mut plan, site, reg.error) }
    ty
}
fn lower(catalog: &Catalog, plan: &mut Instances, reg: &mut ft.TypeRegistry, source: &BoundSource,
    output: &mut lexer.Tokens, first: i32, end: i32, instance: i32, builtin: bool, position: &mut i32) {
    for at in first..end {
        mut site := source.tokens.starts[at]
        if builtin { site = position; position += 1 }
        slot := source.slots[at]; app := source.applications[at]
        if app >= 0 {
            receiver := if instance >= 0 { plan.types[instance] } else { source.receivers[at] }
            target := evaluate(&catalog, &mut plan, &mut reg, &source.expressions, app, instance, receiver, site, true)
            if plan.error != "" { return }
            args.token(&mut output, .Name, plan.names[target], site)
        } else if slot == -2 {
            args.token(&mut output, .Name, plan.names[instance], site)
        } else if slot >= 0 {
            args.token(&mut output, .Name, plan.arguments[plan.starts[instance] + slot], site)
        } else {
            args.token(&mut output, source.tokens.kinds[at], source.tokens.texts[at], site)
        }
    }
}

pub fn specialize(input: &mut lexer.Tokens, reg: &mut ft.TypeRegistry, platform: i32) -> Layout {
    mut layout := layout()
    mut needed := false
    for i in 0..input.kinds.len - 1 {
        if input.kinds[i] != .Name { continue }
        word := &input.texts[i]
        if word == "key_hash" || word == "key_eq" { needed = true; break }
        if !args.symbol(&input, i + 1, "<") { continue }
        if word == args.prelude_binding("Map") || word == args.prelude_binding("Set") || word == args.prelude_binding("Result") || (i > 0 && declaration(input.texts[i - 1])) { needed = true; break }
    }
    if !needed { return layout }
    mut catalog := Catalog { definitions:map.new(), names:[], methods:[], next_impl:[], builtin:[], counts:[], kinds:[], result:-1,
        bodies:lexer.empty(false), slots:[], starts:[], ends:[], removed:[], resume:[],
        constraints:Constraints {parameters:[], methods:[], signatures:lexer.empty(false), starts:[0], slots:[]}, constraint_starts:[0] }
    mut plan := Instances { index:type_keys.new(), definitions:[], names:[], sites:[], parents:[], arguments:[], types:[],
        starts:[], reserved:map.new(), platform:platform, requirements:requirements(), error:"", at:0 }
    mut prelude := lexer.scan(bundled.generic_prelude(), false)
    for i in 0..prelude.kinds.len - 1 {
        if prelude.kinds[i] == .Name && args.prelude_type(prelude.texts[i]) && args.symbol(&prelude, i + 1, "<") {
            prelude.texts[i] = args.prelude_binding(prelude.texts[i])
        }
    }
    collect(&mut catalog, &mut plan, &prelude, true, &mut reg)
    collect(&mut catalog, &mut plan, &input, false, &mut reg)
    for i in 0..catalog.names.len {
        d := catalog.names.len - 1 - i
        if !catalog.methods[d] { continue }
        target := i32(catalog.definitions.get_or(catalog.names[d], -1))
        if target < 0 || catalog.counts[target] != catalog.counts[d] {
            reject(&mut plan, catalog.bodies.starts[catalog.starts[d]], "generic impl must match its type's parameters")
        } else {
            catalog.next_impl[d] = catalog.next_impl[target]
            catalog.next_impl[target] = d
        }
    }
    mut source := BoundSource {tokens:lexer.empty(false), slots:[], applications:[], receivers:[], starts:[], ends:[], expressions:syntax.tree()}
    for d in 0..catalog.names.len {
        source.starts.push(source.slots.len)
        bind(&catalog, &mut plan, &reg, &mut source, &catalog.bodies, catalog.starts[d], catalog.ends[d], false)
        source.ends.push(source.slots.len)
    }
    root := source.slots.len
    bind(&catalog, &mut plan, &reg, &mut source, &input, 0, input.kinds.len - 1, true)
    mut output := lexer.empty(false)
    mut position := input.starts[input.kinds.len - 1] + 1
    if plan.error == "" { lower(&catalog, &mut plan, &mut reg, &source, &mut output, root, source.slots.len, -1, false, &mut position) }
    layout.first = position
    mut instance := 0
    while instance < plan.names.len && plan.error == "" {
        def := plan.definitions[instance]
        mut d := def
        while d >= 0 && plan.error == "" {
            site := origin(&layout, plan.sites[instance])
            if catalog.builtin[d] { layout.starts.push(position); layout.positions.push(site) }
            args.token(&mut output, .Newline, "\n", site)
            lower(&catalog, &mut plan, &mut reg, &source, &mut output, source.starts[d], source.ends[d], instance, catalog.builtin[d], &mut position)
            layout.end = position
            d = catalog.next_impl[d]
        }
        instance += 1
    }
    if plan.error != "" {
        input.ok = false; input.error = plan.error.clone(); input.error_at = origin(&layout, plan.at)
        return layout
    }
    for i in 0..output.kinds.len {
        if output.kinds[i] != .Name || (output.texts[i] != "key_hash" && output.texts[i] != "key_eq") { continue }
        keys := lexer.scan(bundled.primitive_keys(), false)
        site := origin(&layout, output.starts[i])
        layout.starts.push(position); layout.positions.push(site)
        args.token(&mut output, .Newline, "\n", position); position += 1
        for k in 0..keys.kinds.len - 1 {
            args.token(&mut output, keys.kinds[k], keys.texts[k], position); position += 1
        }
        layout.end = position
        break
    }
    layout.reserved = move plan.reserved
    layout.requirements = move plan.requirements
    for i in 0..plan.names.len {
        layout.instance_ids.put(plan.names[i].clone(), i64(i)); layout.sites.push(origin(&layout, plan.sites[i]))
    }
    layout.parents = move plan.parents
    args.token(&mut output, .End, "", position)
    input.kinds = move output.kinds; input.texts = move output.texts; input.starts = move output.starts
    input.ends.clear(); input.ids.clear(); input.intern = false; input.store_ends = false
    layout
}
