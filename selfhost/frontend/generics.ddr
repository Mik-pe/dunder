import lexer
import generic_arguments as args
import ..bundled
import ..opt.scalar_rules as rules
import std.map as map

pub struct Layout {
    first: i32, starts: []i32, positions: []i32, end: i32,
    arguments: lexer.Tokens, argument_ends: []i32, result_names: []string, result_arguments: []i32,
}
pub fn layout() -> Layout { Layout {first:-1, starts:[], positions:[], end:-1, arguments:lexer.empty(false), argument_ends:[], result_names:[], result_arguments:[]} }
pub fn generated(layout: &Layout, position: i32) -> bool {
    layout.first >= 0 && position >= layout.first && position < layout.end
}
pub fn origin(layout: &Layout, position: i32) -> i32 {
    if !generated(&layout, position) { return position }
    mut i := layout.starts.len - 1
    while i > 0 && layout.starts[i] > position { i -= 1 }
    layout.positions[i]
}

struct Catalog {
    definitions: map.Map, names: []string, methods: []bool, next_impl: []i32, builtin: []bool,
    counts: []i32,
    bodies: lexer.Tokens, slots: []i32, starts: []i32, ends: []i32,
    removed: []i32, resume: []i32,
}
struct Instances {
    index: map.Map, definitions: []i32, names: []string, sites: []i32, depths: []i32,
    arguments: lexer.Tokens, ranges: []i32, starts: []i32,
    error: string, at: i32,
}

fn reject(plan: &mut Instances, at: i32, message: string) {
    if plan.error == "" { plan.at = at; plan.error = message.clone() }
}
fn declaration(word: string) -> bool {
    word == "fn" || word == "struct" || word == "enum" || word == "impl"
}
fn prefix(input: &lexer.Tokens, keyword: i32) -> i32 {
    mut first := keyword
    while first > 0 {
        mut p := first - 1
        while p >= 0 && lexer.is_newline(input.kinds[p]) { p -= 1 }
        if p < 0 { break }
        word := &input.texts[p]
        if (word == "pub" || word == "opaque" || word == "unsafe") && p == first - 1 { first = p; continue }
        if args.symbol(&input, p, ")") {
            while p > 0 && !args.symbol(&input, p, "(") { p -= 1 }
            p -= 1
        }
        if args.symbol(&input, p - 1, "@") { first = p - 1; continue }
        break
    }
    first
}
fn body_open(input: &lexer.Tokens, keyword: i32, after: i32, last: i32) -> i32 {
    mut at := after
    if input.texts[keyword] == "fn" {
        if !args.symbol(&input, at, "(") { return last }
        at = args.closing(&input, at, last, "(", ")") + 1
        if args.symbol(&input, at, "->") {
            at = args.type_end(&input, at + 1, last, 0)
            if at + 1 < last && input.texts[at] == "from" { at += 2 }
        }
    }
    while at < last && lexer.is_newline(input.kinds[at]) { at += 1 }
    if args.symbol(&input, at, "{") { at } else { last }
}
fn capture(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, keyword: i32, builtin: bool) -> i32 {
    last := input.kinds.len - 1
    name := &input.texts[keyword + 1]
    site := input.starts[keyword + 1]
    method := input.texts[keyword] == "impl"
    first := prefix(&input, keyword)
    params := args.parameters(&input, keyword + 1)
    if params.error != "" { reject(&mut plan, input.starts[params.after], params.error); return last }
    after := params.after
    open := body_open(&input, keyword, after, last)
    close := args.closing(&input, open, last, "{", "}")
    if close == last { reject(&mut plan, site, "expected a generic declaration body"); return last }
    if !method {
        if catalog.definitions.contains(name) { reject(&mut plan, site, "duplicate generic declaration"); return last }
        catalog.definitions.put(name.clone(), i64(catalog.names.len))
    }
    catalog.names.push(name.clone()); catalog.methods.push(method); catalog.next_impl.push(-1); catalog.builtin.push(builtin)
    catalog.counts.push(params.names.len)
    catalog.starts.push(catalog.slots.len)
    for i in first..close + 1 {
        if i >= keyword + 2 && i < after { continue }
        mut slot := -1
        if i == keyword + 1 { slot = -2 }
        else if input.kinds[i] == .Name && !args.symbol(&input, i - 1, ".") && !args.symbol(&input, i - 1, "::") &&
            !args.symbol(&input, i + 1, ":") {
            for p in 0..params.names.len {
                if input.texts[i] == params.names[p] { slot = p; break }
            }
        }
        catalog.slots.push(slot)
        args.token(&mut catalog.bodies, input.kinds[i], input.texts[i], input.starts[i])
    }
    catalog.ends.push(catalog.slots.len)
    if !builtin { catalog.removed.push(first); catalog.resume.push(close + 1) }
    close + 1
}
fn collect(catalog: &mut Catalog, plan: &mut Instances, input: &lexer.Tokens, builtin: bool) {
    mut i := 0
    mut level := 0
    while i + 2 < input.kinds.len && plan.error == "" {
        if level == 0 && declaration(input.texts[i]) && input.kinds[i + 1] == .Name && args.symbol(&input, i + 2, "<") {
            i = capture(&mut catalog, &mut plan, &input, i, builtin); continue
        }
        if args.symbol(&input, i, "{") { level += 1 }
        else if args.symbol(&input, i, "}") { level -= 1 }
        i += 1
    }
}

fn intern(catalog: &Catalog, plan: &mut Instances, def: i32, input: &lexer.Tokens, bounds: &[]i32, site: i32, depth: i32) -> string {
    family := &catalog.names[def]
    mut name := family + "<"
    count := bounds.len - 1
    if count != catalog.counts[def] {
        mut message := "wrong number of type arguments: expected " + catalog.counts[def].str() + ", got " + count.str()
        if family == "Map" { message = "Map expects a key and a value type" }
        if family == "Set" { message = "Set expects one element type" }
        reject(&mut plan, site, message); return ""
    }
    for i in 0..count {
        start := bounds[i]; end := bounds[i + 1]
        if start == end { reject(&mut plan, site, "expected a type argument"); return "" }
        if args.type_end(&input, start, end, 0) != end {
            reject(&mut plan, site, "invalid type argument"); return ""
        }
        unit := args.symbol(&input, start, "(") && args.symbol(&input, start + 1, ")")
        if (family == "Map" || family == "Set") && (unit || args.symbol(&input, start, "&")) {
            reject(&mut plan, site, "collection keys and values must be storable values"); return ""
        }
        if i > 0 { name += ", " }
        name += args.spelling(&input, start, end)
    }
    name += ">"
    if plan.index.contains(name) { return name }
    if depth > 64 || name.len > 65536 { reject(&mut plan, site, "generic specialization nesting limit exceeded"); return "" }
    plan.index.put(name.clone(), i64(plan.names.len))
    plan.names.push(name.clone()); plan.definitions.push(def); plan.sites.push(site); plan.depths.push(depth)
    plan.starts.push(plan.ranges.len)
    for bound in bounds { plan.ranges.push(plan.arguments.kinds.len + bound) }
    for i in 0..input.kinds.len { args.token(&mut plan.arguments, input.kinds[i], input.texts[i], input.starts[i]) }
    name
}

fn application(catalog: &Catalog, plan: &mut Instances, input: &lexer.Tokens, output: &mut lexer.Tokens,
    at: i32, last: i32, self_type: string, depth: i32) -> i32 {
    site := input.starts[at]
    if depth > 64 { reject(&mut plan, site, "generic specialization nesting limit exceeded"); return last }
    def := i32(catalog.definitions.get_or(input.texts[at], -1))
    if def < 0 { return at }
    mut types := lexer.empty(false)
    mut bounds: []i32 = [0]
    mut parens := 0
    mut brackets := 0
    mut angles := 0
    mut i := at + 2
    while i < last && plan.error == "" {
        kind := input.kinds[i]
        word := &input.texts[i]
        if kind == .Symbol {
            if parens == 0 && brackets == 0 && angles == 0 {
                if word == ">" || word == ">=" {
                    bounds.push(types.kinds.len)
                    name := intern(&catalog, &mut plan, def, &types, &bounds, site, depth)
                    args.token(&mut output, .Name, name, site)
                    if word == ">=" { args.token(&mut output, .Symbol, "=", input.starts[i] + 1) }
                    return i + 1
                }
                if word == "," { bounds.push(types.kinds.len); i += 1; continue }
            }
            if word == "(" { parens += 1 } else if word == ")" { parens -= 1 }
            else if word == "[" { brackets += 1 } else if word == "]" { brackets -= 1 }
            else if word == "<" { angles += 1 } else if word == ">" { angles -= 1 }
            if parens < 0 || brackets < 0 || angles < 0 || word == "{" || word == "}" { break }
        }
        if kind == .Name && args.symbol(&input, i + 1, "<") {
            next := application(&catalog, &mut plan, &input, &mut types, i, last, self_type, depth + 1)
            if next > i { i = next; continue }
        }
        if !lexer.is_newline(kind) {
            mut value := word.clone()
            if kind == .Name && word == "Self" && self_type != "" { value = self_type.clone() }
            if kind == .Integer {
                integer := rules.literal_integer(word)
                if integer.ok { value = integer.value.str() }
            }
            args.token(&mut types, kind, value, input.starts[i])
        }
        i += 1
    }
    at
}

fn expand(catalog: &Catalog, plan: &mut Instances, input: &lexer.Tokens, output: &mut lexer.Tokens, root: bool, depth: i32) {
    mut i := 0; mut removed := 0
    mut self_type := ""; mut braces := 0
    last := input.kinds.len - 1
    while i < last && plan.error == "" {
        if root && removed < catalog.removed.len && i == catalog.removed[removed] {
            i = catalog.resume[removed]; removed += 1; continue
        }
        if input.kinds[i] == .Name && args.symbol(&input, i + 1, "<") {
            next := application(&catalog, &mut plan, &input, &mut output, i, last, self_type, depth)
            if next > i { i = next; continue }
        }
        if braces == 0 && input.texts[i] == "impl" && input.kinds[i + 1] == .Name { self_type = input.texts[i + 1].clone() }
        if args.symbol(&input, i, "{") { braces += 1 }
        if args.symbol(&input, i, "}") { braces -= 1; if braces == 0 { self_type = "" } }
        args.token(&mut output, input.kinds[i], input.texts[i], input.starts[i])
        i += 1
    }
}

fn instantiate(catalog: &Catalog, plan: &Instances, def: i32, instance: i32, position: &mut i32) -> lexer.Tokens {
    mut body := lexer.empty(false)
    first := plan.starts[instance]
    for i in catalog.starts[def]..catalog.ends[def] {
        mut at := catalog.bodies.starts[i]
        if catalog.builtin[def] { at = position; position += 1 }
        slot := catalog.slots[i]
        if slot == -2 { args.token(&mut body, .Name, plan.names[instance], at) }
        else if slot >= 0 {
            for j in plan.ranges[first + slot]..plan.ranges[first + slot + 1] {
                args.token(&mut body, plan.arguments.kinds[j], plan.arguments.texts[j], at)
            }
        } else { args.token(&mut body, catalog.bodies.kinds[i], catalog.bodies.texts[i], at) }
    }
    args.token(&mut body, .End, "", position)
    body
}

pub fn specialize(input: &mut lexer.Tokens) -> Layout {
    mut layout := layout()
    mut needed := false
    for i in 0..input.kinds.len - 1 {
        if input.kinds[i] != .Name { continue }
        word := &input.texts[i]
        if word == "key_hash" || word == "key_eq" { needed = true; break }
        if !args.symbol(&input, i + 1, "<") { continue }
        if args.prelude_type(word) || (i > 0 && declaration(input.texts[i - 1])) { needed = true; break }
    }
    if !needed { return layout }
    mut catalog := Catalog { definitions:map.new(), names:[], methods:[], next_impl:[], builtin:[], counts:[],
        bodies:lexer.empty(false), slots:[], starts:[], ends:[], removed:[], resume:[] }
    mut plan := Instances { index:map.new(), names:[], definitions:[], sites:[], depths:[], arguments:lexer.empty(false),
        ranges:[], starts:[], error:"", at:0 }
    prelude := lexer.scan(bundled.generic_prelude(), false)
    collect(&mut catalog, &mut plan, &prelude, true)
    collect(&mut catalog, &mut plan, &input, false)
    for i in 0..catalog.names.len {
        d := catalog.names.len - 1 - i
        if !catalog.methods[d] { continue }
        target := i32(catalog.definitions.get_or(catalog.names[d], -1))
        if target < 0 || catalog.counts[target] != catalog.counts[d] {
            reject(&mut plan, catalog.bodies.starts[catalog.starts[d]], "generic impl must match its type's parameters")
        } else {
            catalog.next_impl[d] = catalog.next_impl[target]
            catalog.next_impl[target] = d
        }
    }
    mut output := lexer.empty(false)
    expand(&catalog, &mut plan, &input, &mut output, true, 0)
    mut position := input.starts[input.kinds.len - 1] + 1
    layout.first = position
    mut instance := 0
    while instance < plan.names.len && plan.error == "" {
        def := plan.definitions[instance]
        first := plan.starts[instance]
        if catalog.builtin[def] && catalog.names[def] == "Result" {
            layout.result_names.push(plan.names[instance].clone())
            layout.result_arguments.push(layout.argument_ends.len)
        }
        for p in 1..catalog.counts[def] + 1 { layout.argument_ends.push(plan.ranges[first + p]) }
        mut d := def
        while d >= 0 && plan.error == "" {
            site := origin(&layout, plan.sites[instance])
            if catalog.builtin[d] { layout.starts.push(position); layout.positions.push(site) }
            body := instantiate(&catalog, &plan, d, instance, &mut position)
            level := plan.depths[instance] + 1
            args.token(&mut output, .Newline, "\n", body.starts[0])
            expand(&catalog, &mut plan, &body, &mut output, false, level)
            layout.end = position
            d = catalog.next_impl[d]
        }
        instance += 1
    }
    if plan.error != "" {
        input.ok = false; input.error = plan.error.clone(); input.error_at = origin(&layout, plan.at)
        return layout
    }
    for i in 0..output.kinds.len {
        if output.kinds[i] != .Name || (output.texts[i] != "key_hash" && output.texts[i] != "key_eq") { continue }
        keys := lexer.scan(bundled.primitive_keys(), false)
        site := origin(&layout, output.starts[i])
        layout.starts.push(position); layout.positions.push(site)
        args.token(&mut output, .Newline, "\n", position); position += 1
        for k in 0..keys.kinds.len - 1 {
            args.token(&mut output, keys.kinds[k], keys.texts[k], position); position += 1
        }
        layout.end = position
        break
    }
    layout.arguments = move plan.arguments
    args.token(&mut layout.arguments, .End, "", position)
    args.token(&mut output, .End, "", position)
    input.kinds = move output.kinds; input.texts = move output.texts; input.starts = move output.starts
    input.ends.clear(); input.ids.clear(); input.intern = false; input.store_ends = false
    layout
}
