import lexer
import std.bytes as bytes
import ...stdlib.bytes.utf8 as utf8

pub fn module_pair(owner: i32, provider: i32) -> i64 {
    i64(owner).shl(32).bit_or(i64(provider))
}

pub enum Severity { Error, Warning }

pub fn immutable_binding_note(name: string) -> string {
    "'" + name + "' was declared immutable (add 'mut' to make it mutable)"
}

pub struct Span { start: i32, end: i32 }
pub struct LineCol { line: i32, column: i32 }

pub struct RawDiagnostic {
    severity: Severity,
    code: string,
    start: i32,
    last: i32,
    message: string,
    note_start: i32,
    note_last: i32,
    note_message: string,
}

pub struct Diagnostic {
    severity: Severity,
    code: string,
    path: string,
    start: i32,
    end: i32,
    message: string,
    note_path: string,
    note_start: i32,
    note_end: i32,
    note_message: string,
}

pub struct Bag {
    items: []RawDiagnostic,
    error_count: i32,
    warning_count: i32,
    max_errors: i32,
}

pub fn new_bag() -> Bag {
    Bag { items: [], error_count: 0, warning_count: 0, max_errors: 32 }
}

pub fn clear(bag: &mut Bag) {
    bag.items.clear()
    bag.error_count = 0
    bag.warning_count = 0
}

pub fn clone_raw(r: &RawDiagnostic) -> RawDiagnostic {
    RawDiagnostic {
        severity: r.severity,
        code: r.code.clone(),
        start: r.start,
        last: r.last,
        message: r.message.clone(),
        note_start: r.note_start,
        note_last: r.note_last,
        note_message: r.note_message.clone(),
    }
}

pub fn clone_diag(d: &Diagnostic) -> Diagnostic {
    Diagnostic {
        severity: d.severity,
        code: d.code.clone(),
        path: d.path.clone(),
        start: d.start,
        end: d.end,
        message: d.message.clone(),
        note_path: d.note_path.clone(),
        note_start: d.note_start,
        note_end: d.note_end,
        note_message: d.note_message.clone(),
    }
}

pub fn limit_reached(bag: &Bag) -> bool {
    bag.error_count >= bag.max_errors
}

fn has_sub(haystack: string, needle: string) -> bool {
    if needle.len == 0 { return true }
    if needle.len > haystack.len { return false }
    limit := haystack.len - needle.len + 1
    for i in 0..limit {
        mut ok := true
        for j in 0..needle.len {
            if haystack[i + j] != needle[j] { ok = false; break }
        }
        if ok { return true }
    }
    false
}

pub fn classify_error_code(message: string) -> string {
    // E1001: lexer / unterminated / malformed literals
    if has_sub(message, "unterminated") || has_sub(message, "unclosed attribute") ||
        has_sub(message, "unbalanced interpolation") || has_sub(message, "not valid UTF-8") ||
        has_sub(message, "unexpected character") || has_sub(message, "literal needs") ||
        has_sub(message, "exponent needs") || has_sub(message, "invalid escape") ||
        has_sub(message, "invalid fixed precision format") || has_sub(message, "invalid string interpolation") || has_sub(message, "invalid integer interpolation") ||
        has_sub(message, "single '}' in interpolated") || has_sub(message, "empty interpolation") ||
        has_sub(message, "byte literal must be") || has_sub(message, "invalid rune") ||
        has_sub(message, "invalid integer") || has_sub(message, "invalid float") {
        return "E1001"
    }
    // E1003: nesting limits
    if has_sub(message, "nesting exceeds") { return "E1003" }
    // E1004 capability declaration placement/syntax before E5002
    if has_sub(message, "declare capabilities") || has_sub(message, "end of capability") ||
        has_sub(message, "expected a module capability") || has_sub(message, "duplicate module capability") {
        if has_sub(message, "duplicate ") { return "E2005" }
        if has_sub(message, "expected ") { return "E1002" }
        return "E1004"
    }
    // E5001: unsafe requirements
    if has_sub(message, "unsafe") && !has_sub(message, "duplicate 'unsafe'") && !has_sub(message, "@requires") {
        return "E5001"
    }
    // E5002: capabilities / grants / @requires
    if has_sub(message, "capability") || has_sub(message, "@requires") ||
        has_sub(message, "not granted in dunder.toml") || has_sub(message, "cannot require a grant") {
        if has_sub(message, "cannot require a grant") { return "E2006" }
        return "E5002"
    }
    // E5003: FFI / C layout / extern / wasm / unavailable
    if has_sub(message, "C layout") || has_sub(message, "C record") || has_sub(message, "C variadic") ||
        has_sub(message, "foreign") || has_sub(message, "extern") || has_sub(message, "callback") ||
        has_sub(message, "__unavailable__") || has_sub(message, "unavailable on") ||
        has_sub(message, "wasm") || has_sub(message, "non-homogeneous C") {
        return "E5003"
    }
    // E5004: tasks / spawn / await / Sendable / Storable / isolated
    if has_sub(message, "task") || has_sub(message, "spawn") || has_sub(message, "await") ||
        has_sub(message, "Sendable") || has_sub(message, "Storable") || has_sub(message, "isolated") {
        return "E5004"
    }
    // E4005: scoped / scratch borrow escapes
    if has_sub(message, "reaches a raw address") || has_sub(message, "cannot escape the region") ||
        has_sub(message, "scratch borrow") || has_sub(message, "scoped borrow") ||
        has_sub(message, "scratch storage") {
        return "E4005"
    }
    // E4004: resources / dispose / Copy / drop
    if has_sub(message, "resource") || has_sub(message, "dispose") ||
        has_sub(message, "must be consumed") || has_sub(message, "cannot drop") ||
        has_sub(message, "cannot copy") || has_sub(message, "not Copy") ||
        has_sub(message, "automatic cleanup") {
        return "E4004"
    }
    // E4003: specific borrow / aliasing conflicts before E4001/E4002
    if has_sub(message, "while it is borrowed") || has_sub(message, "while it is mutably borrowed") ||
        has_sub(message, "while iterating") || has_sub(message, "borrowed value") ||
        has_sub(message, "borrowed pattern") || has_sub(message, "for loop requires &") {
        return "E4003"
    }
    // E4001: moves / use of moved value
    if has_sub(message, "use of moved") || has_sub(message, "already moved") ||
        has_sub(message, "moved value") || has_sub(message, "cannot move") ||
        has_sub(message, "requires 'move") || has_sub(message, "requires move") ||
        has_sub(message, "move iteration") || has_sub(message, "move argument") {
        return "E4001"
    }
    // E4002: immutability / mutability / rebinding
    if has_sub(message, "immutable") || has_sub(message, "cannot mutate") ||
        has_sub(message, "not mutable") || has_sub(message, "cannot rebind") ||
        has_sub(message, "cannot be rebound") || has_sub(message, "mutable stored value") ||
        has_sub(message, "mutable parameter") || has_sub(message, "cannot be reassigned") ||
        has_sub(message, "cannot combine 'mut") {
        return "E4002"
    }
    // E2001: modules / imports
    if has_sub(message, "cannot load module") || has_sub(message, "unknown module") ||
        has_sub(message, "unknown standard library") || has_sub(message, "cannot import") ||
        has_sub(message, "invalid module path") || has_sub(message, "import a ") ||
        has_sub(message, "bundled libraries may only import") || has_sub(message, "circular import") ||
        has_sub(message, "module cycle") || has_sub(message, "imports must be loaded") ||
        has_sub(message, "expected an import alias") || has_sub(message, "expected end of import") {
        return "E2001"
    }
    // E2004: visibility / private
    if has_sub(message, "is private") || has_sub(message, "export it with pub") {
        return "E2004"
    }
    // E2005: duplicates
    if has_sub(message, "duplicate ") { return "E2005" }
    // E2002: unknown names / functions / declarations
    if has_sub(message, "has no declaration") || has_sub(message, "unknown identifier") ||
        has_sub(message, "unknown function") || has_sub(message, "unknown local") ||
        has_sub(message, "unknown variable") || has_sub(message, "unknown symbol") ||
        has_sub(message, "unknown name") || has_sub(message, "undefined") ||
        has_sub(message, "unknown returned borrow source") {
        return "E2002"
    }
    // E4003: other borrow rule errors
    if has_sub(message, "borrow") { return "E4003" }
    // E2003: unknown types / traits / variants / fields / methods
    if has_sub(message, "unknown type") || has_sub(message, "unknown trait") ||
        has_sub(message, "unknown variant") || has_sub(message, "unknown field") ||
        has_sub(message, "unknown method") || has_sub(message, "has no field") ||
        has_sub(message, "has no method") || has_sub(message, "has no variant") ||
        has_sub(message, "unresolved type") {
        return "E2003"
    }
    // E2006: reserved names / main / impl target / opaque / unused value
    if has_sub(message, "reserved ") || has_sub(message, "program needs main") ||
        has_sub(message, "main must") || has_sub(message, "impl target") ||
        has_sub(message, "imported type") || has_sub(message, "opaque struct") ||
        has_sub(message, "unused value") {
        return "E2006"
    }
    // E3001: type mismatches / operators
    if has_sub(message, "type mismatch") || has_sub(message, "cannot assign") ||
        has_sub(message, "cannot compare") || has_sub(message, "cannot apply") ||
        has_sub(message, "requires bool") || has_sub(message, "requires integer") ||
        has_sub(message, "requires numeric") || has_sub(message, "only support") {
        return "E3001"
    }
    // E3002: return / missing return value
    if has_sub(message, "function can finish without returning") ||
        has_sub(message, "missing return value") || has_sub(message, "requires a value") {
        return "E3002"
    }
    // E3003: calls / arity / method access / indexing
    if has_sub(message, "argument") || has_sub(message, "arity") ||
        has_sub(message, "not callable") || has_sub(message, "cannot call") ||
        has_sub(message, "cannot access method") || has_sub(message, "cannot index") {
        return "E3003"
    }
    // E3004: traits / derives
    if has_sub(message, "does not implement") || has_sub(message, "@derive") ||
        has_sub(message, "trait method") || has_sub(message, "cannot derive") ||
        has_sub(message, "derive trait") {
        return "E3004"
    }
    // E3005: generics
    if has_sub(message, "generic") || has_sub(message, "type argument") ||
        has_sub(message, "type parameter") || has_sub(message, "cannot infer") ||
        has_sub(message, "monomorph") || has_sub(message, "where") {
        return "E3005"
    }
    // E3006: patterns / match
    if has_sub(message, "non-exhaustive") || has_sub(message, "exhaustive") ||
        has_sub(message, "unreachable pattern") || has_sub(message, "pattern") ||
        has_sub(message, "match ") || has_sub(message, " match") {
        return "E3006"
    }
    // E3007: const / overflow / div-zero / range / casts
    if has_sub(message, "const") || has_sub(message, "compile-time") ||
        has_sub(message, "overflow") || has_sub(message, "division by zero") ||
        has_sub(message, "out of range") || has_sub(message, "invalid cast") ||
        has_sub(message, "cannot cast") || has_sub(message, "array length") {
        return "E3007"
    }
    // E1005: misplaced control flow / block structure
    if has_sub(message, "inside defer") || has_sub(message, "inside impl") ||
        has_sub(message, "outside loop") || has_sub(message, "outside a loop") {
        return "E1005"
    }
    // E1002: expected token / syntax
    if has_sub(message, "expected ") { return "E1002" }
    // E1004: other syntax/attribute placement
    if has_sub(message, "invalid ") || has_sub(message, "unexpected ") ||
        has_sub(message, "impl block cannot be public") || has_sub(message, "attribute") ||
        has_sub(message, "parameter name") {
        return "E1004"
    }
    "E3099"
}

fn contains_raw(bag: &Bag, sev: Severity, code: string, start: i32, message: string) -> bool {
    for i in 0..bag.items.len {
        item := &bag.items[i]
        if item.severity == sev && item.start == start && item.message == message && (code == "" || item.code == code) {
            return true
        }
    }
    false
}

pub fn push_error(bag: &mut Bag, code_in: string, start: i32, last: i32, message: string, note_start: i32, note_last: i32, note_message: string) {
    if limit_reached(&bag) { return }
    mut code := code_in.clone()
    if code == "" { code = classify_error_code(message) }
    if contains_raw(&bag, .Error, code, start, message) { return }
    bag.items.push(RawDiagnostic {
        severity: .Error,
        code: move code,
        start: start,
        last: last,
        message: message.clone(),
        note_start: note_start,
        note_last: note_last,
        note_message: note_message.clone(),
    })
    bag.error_count += 1
}

pub fn push_warning(bag: &mut Bag, code: string, start: i32, last: i32, message: string) {
    if bag.warning_count >= 128 { return }
    if contains_raw(&bag, .Warning, code, start, message) { return }
    bag.items.push(RawDiagnostic {
        severity: .Warning,
        code: code.clone(),
        start: start,
        last: last,
        message: message.clone(),
        note_start: -1,
        note_last: -1,
        note_message: "",
    })
    bag.warning_count += 1
}

pub fn attach_note_last(bag: &mut Bag, note_start: i32, note_last: i32, note_message: string) {
    if note_message == "" { return }
    mut i := bag.items.len - 1
    while i >= 0 {
        if bag.items[i].severity == .Error {
            if bag.items[i].note_message == "" {
                bag.items[i].note_start = note_start
                bag.items[i].note_last = note_last
                bag.items[i].note_message = note_message.clone()
            }
            return
        }
        i -= 1
    }
}

pub fn extend(dst: &mut Bag, src: &Bag) {
    for i in 0..src.items.len {
        item := &src.items[i]
        if item.severity == .Error {
            push_error(&mut dst, item.code, item.start, item.last, item.message, item.note_start, item.note_last, item.note_message)
        } else {
            push_warning(&mut dst, item.code, item.start, item.last, item.message)
        }
    }
}

fn push_utf8_len(data: &mut []u8, text_in: string) -> i32 {
    before := data.len
    if text_in != "" { bytes.append_utf8(&mut data, text_in) }
    data.len - before
}

pub fn pack_into(bag: &Bag, meta: &mut []i32, data: &mut []u8) {
    meta.clear(); data.clear()
    for i in 0..bag.items.len {
        item := &bag.items[i]
        sev := if item.severity == .Error { 0 } else { 1 }
        code_len := push_utf8_len(&mut data, item.code)
        msg_len := push_utf8_len(&mut data, item.message)
        note_len := push_utf8_len(&mut data, item.note_message)
        meta.push(sev); meta.push(item.start); meta.push(item.last)
        meta.push(item.note_start); meta.push(item.note_last)
        meta.push(code_len); meta.push(msg_len); meta.push(note_len)
    }
}

fn read_utf8_slice(data: &[]u8, offset: &mut i32, count: i32) -> string {
    if count <= 0 || offset < 0 || offset + count > data.len { return "" }
    mut chunk: []u8 = []
    chunk.reserve(count)
    for i in offset..(offset + count) { chunk.push(data[i]) }
    offset = offset + count
    match utf8.decode(&chunk) { .Ok(value) => value, .Err(_) => "" }
}

pub fn unpack_into(meta: &[]i32, data: &[]u8, dst: &mut Bag) {
    mut p := 0
    mut dpos := 0
    while p + 7 < meta.len {
        sev := meta[p]; start := meta[p + 1]; last := meta[p + 2]
        note_start := meta[p + 3]; note_last := meta[p + 4]
        code_len := meta[p + 5]; msg_len := meta[p + 6]; note_len := meta[p + 7]
        p += 8
        code := read_utf8_slice(&data, &mut dpos, code_len)
        message := read_utf8_slice(&data, &mut dpos, msg_len)
        note_message := read_utf8_slice(&data, &mut dpos, note_len)
        if sev == 0 {
            push_error(&mut dst, code, start, last, message, note_start, note_last, note_message)
        } else {
            push_warning(&mut dst, code, start, last, message)
        }
    }
}

pub fn resolve_span(source: string, start_in: i32, last_in: i32) -> Span {
    if source.len == 0 { return Span { start: 0, end: 0 } }
    mut start := start_in
    if start < 0 { start = 0 }
    if start > source.len { start = source.len }
    if start == source.len { return Span { start: start, end: start } }
    mut end := start
    if last_in >= start && last_in < source.len {
        end = lexer.span_end(source, start, last_in)
    } else {
        end = lexer.token_end(source, start)
    }
    if end <= start {
        end = start + 1
        while end < source.len && source[end] >= 128 && source[end] < 192 { end += 1 }
    }
    if end > source.len { end = source.len }
    if end < start { end = start }
    Span { start: start, end: end }
}

pub fn line_col(source: string, offset_in: i32) -> LineCol {
    mut offset := offset_in
    if offset < 0 { offset = 0 }
    if offset > source.len { offset = source.len }
    mut line := 1; mut column := 1
    for i in 0..offset {
        b := source[i]
        if b == 10 { line += 1; column = 1 }
        else if b < 128 || b >= 192 { column += 1 }
    }
    LineCol { line: line, column: column }
}

fn utf8_count(source: string, first_in: i32, last_in: i32) -> i32 {
    mut first := first_in
    mut last := last_in
    if first < 0 { first = 0 }
    if last > source.len { last = source.len }
    mut count := 0
    for i in first..last {
        b := source[i]
        if b < 128 || b >= 192 { count += 1 }
    }
    count
}

fn repeat_char(ch: string, count: i32) -> string {
    mut out := ""
    for _ in 0..count { out += ch }
    out
}

fn render_snippet(source: string, start_in: i32, end_in: i32) -> string {
    if source.len == 0 || start_in < 0 || start_in > source.len { return "" }
    lc := line_col(source, start_in)
    mut line_start := start_in
    while line_start > 0 && source[line_start - 1] != 10 { line_start -= 1 }
    mut line_end := start_in
    while line_end < source.len && source[line_end] != 10 { line_end += 1 }
    mut display_end := line_end
    if display_end > line_start && source[display_end - 1] == 13 { display_end -= 1 }
    line_text := source[line_start..display_end]
    mut span_end := end_in
    if span_end < start_in { span_end = start_in }
    if span_end > display_end { span_end = display_end }
    mut caret_len := utf8_count(source, start_in, span_end)
    if caret_len < 1 { caret_len = 1 }

    line_num := lc.line.str()
    gutter_pad := repeat_char(" ", line_num.len)
    mut indent := ""
    mut p := line_start
    while p < start_in && p < display_end {
        b := source[p]
        if b == 9 { indent += "\t"; p += 1 }
        else {
            if b < 128 || b >= 192 { indent += " " }
            p += 1
        }
    }
    carets := repeat_char("^", caret_len)
    line_num + " | " + line_text + "\n" + gutter_pad + " | " + indent + carets
}

pub fn render_human(d: &Diagnostic, source: string, note_source: string) -> string {
    sev := if d.severity == .Error { "error" } else { "warning" }
    lc := line_col(source, d.start)
    mut out := f"{d.path}:{lc.line}:{lc.column}: {sev}[{d.code}]: {d.message}"
    snippet := render_snippet(source, d.start, d.end)
    if snippet != "" { out += "\n" + snippet }
    if d.note_message != "" {
        if d.note_path != "" && d.note_start >= 0 {
            nlc := line_col(note_source, d.note_start)
            out += f"\n{d.note_path}:{nlc.line}:{nlc.column}: note: {d.note_message}"
            nsnip := render_snippet(note_source, d.note_start, d.note_end)
            if nsnip != "" { out += "\n" + nsnip }
        } else {
            out += "\n  note: " + d.note_message
        }
    }
    out
}

fn str_less(a: string, b: string) -> bool {
    limit := if a.len < b.len { a.len } else { b.len }
    for i in 0..limit {
        if a[i] != b[i] { return a[i] < b[i] }
    }
    a.len < b.len
}

fn diag_less(a: &Diagnostic, b: &Diagnostic) -> bool {
    if a.path != b.path { return str_less(a.path, b.path) }
    if a.start != b.start { return a.start < b.start }
    if a.end != b.end { return a.end < b.end }
    sa := if a.severity == .Error { 0 } else { 1 }
    sb := if b.severity == .Error { 0 } else { 1 }
    if sa != sb { return sa < sb }
    if a.code != b.code { return str_less(a.code, b.code) }
    str_less(a.message, b.message)
}

fn diag_same(a: &Diagnostic, b: &Diagnostic) -> bool {
    a.severity == b.severity && a.code == b.code && a.path == b.path &&
        a.start == b.start && a.end == b.end && a.message == b.message
}

pub fn sort_resolved(items: &mut []Diagnostic) {
    if items.len <= 1 { return }
    for i in 1..items.len {
        mut j := i
        while j > 0 && diag_less(&items[j], &items[j - 1]) {
            tmp := clone_diag(&items[j])
            items[j] = clone_diag(&items[j - 1])
            items[j - 1] = move tmp
            j -= 1
        }
    }
    mut unique: []Diagnostic = []
    unique.reserve(items.len)
    for i in 0..items.len {
        if unique.len == 0 || !diag_same(&unique[unique.len - 1], &items[i]) {
            unique.push(clone_diag(&items[i]))
        }
    }
    items.clear()
    for i in 0..unique.len { items.push(clone_diag(&unique[i])) }
}

@test fn error_codes_classify_and_never_return_e1000() {
    assert(classify_error_code("type mismatch: expected i32, got bool") == "E3001")
    assert(classify_error_code("function can finish without returning a value") == "E3002")
    assert(classify_error_code("use of moved value 's'") == "E4001")
    assert(classify_error_code("assignment requires a mutable stored value") == "E4002")
    assert(classify_error_code("cannot mutate, replace or move a value while it is borrowed") == "E4003")
    assert(classify_error_code("use of resource 'r' after dispose") == "E4004")
    assert(classify_error_code("scoped borrow reaches a raw address") == "E4005")
    assert(classify_error_code("this function requires capability stdio") == "E5002")
    assert(classify_error_code("module requires capability unsafe") == "E5001")
    assert(classify_error_code("C layouts can contain only unmanaged C fields") == "E5003")
    assert(classify_error_code("spawn requires a named Dunder worker function") == "E5004")
    assert(classify_error_code("expected '}'") == "E1002")
    assert(classify_error_code("expression nesting exceeds 128") == "E1003")
    assert(classify_error_code("unterminated string") == "E1001")
    assert(classify_error_code("unknown type 'Foo'") == "E2003")
    assert(classify_error_code("'m.secret' is private; export it with pub") == "E2004")
    assert(classify_error_code("duplicate declaration 'foo'") == "E2005")
    assert(classify_error_code("completely unknown internal fallback") != "E1000")
}

@test fn resolve_span_and_human_render_handle_multi_token_and_utf8() {
    src := "fn f() -> i32 {\n    åäö + \"x\"\n}\n"
    // Locate "åäö + \"x\""
    start := 20
    last := start + 9 // '"' at \"x\"
    sp := resolve_span(src, start, last)
    assert(sp.start == start)
    assert(src[sp.start..sp.end] == "åäö + \"x\"")
    d := Diagnostic {
        severity: .Error,
        code: "E3001",
        path: "test.ddr",
        start: sp.start,
        end: sp.end,
        message: "cannot add string",
        note_path: "",
        note_start: -1,
        note_end: -1,
        note_message: "",
    }
    rendered := render_human(&d, src, "")
    assert(rendered == "test.ddr:2:5: error[E3001]: cannot add string\n2 |     åäö + \"x\"\n  |     ^^^^^^^^^")
}

@test fn bag_pack_unpack_and_sort_roundtrip() {
    mut b := new_bag()
    push_warning(&mut b, "W1001", 20, 20, "unused variable 'y'")
    push_error(&mut b, "", 5, 10, "type mismatch: expected i32, got bool", 1, 2, "declared here")
    push_error(&mut b, "", 5, 10, "type mismatch: expected i32, got bool", 1, 2, "declared here")
    assert(b.error_count == 1)
    assert(b.warning_count == 1)
    mut meta: []i32 = []; mut data: []u8 = []
    pack_into(&b, &mut meta, &mut data)
    mut out := new_bag()
    unpack_into(&meta, &data, &mut out)
    assert(out.items.len == 2)
    assert(out.items[0].code == "W1001")
    assert(out.items[1].code == "E3001")
    assert(out.items[1].note_message == "declared here")
}
