import frontend_types as ft
import type_keys
import lexer
import std.bytes as bytes

pub struct Spellings { starts: []i32, bytes: []u8 }
pub struct Types {
    tuples: type_keys.Index, bound_arguments: []i32,
    declared: ft.Shapes, names: []i32, fields: []i32, field_types: []i32, field_values: []i64,
    payload_starts: []i32, payload_counts: []i32, payload_types: []i32, opaque_owner: []i32, opaque_sendable: []bool, type_owners: []i32, c_record: []bool, resource: []bool,
    cleanup_methods: []i32, has_cleanup: bool,
    result_success: []i32, result_failure: []i32, option_inner: []i32,
    map_key: []i32, map_value: []i32, set_elem: []i32,
}
pub struct Tokens {
    kinds: []lexer.Kind, words: []i32, positions: []i32, closes: []i32,
    starts: []i32, ends: []i32, origins: []i32, following_positions: []i32,
}
pub struct World {
    spellings: Spellings, types: Types, tokens: Tokens,
    names: []i32, parameter_names: []i32, libraries: []i32, symbols: []i32, returns: []i32,
    param_starts: []i32, param_counts: []i32, param_types: []i32, param_mutable: []bool, param_tokens: []i32, param_offsets: []i32,
    unsafe_functions: []bool, thread_safe: []bool, test_functions: []bool, function_owners: []i32, ffi_types: []i32,
    impl_types: []i32, impl_public: []bool, impl_has_self: []bool, impl_self_mut: []bool,
    impl_names: []i32, requires_caps: []i32, module_caps: []i32,
    source_end: i32, unsafe_capable: bool, tasks: bool, loans: bool, report: bool,
    globals: i32, fn_labels: []i32, spawners: []i32, detached_spawners: []i32, await_any: i32,
    warn_unused: []bool, gen_first: i32, gen_end: i32,
    trait_names: []i32, conformance_traits: []i32, conformance_types: []i32,
    const_names: []i32, const_types: []i32, const_kinds: []i32, const_ints: []i64,
    const_strings: []i32, const_blob_starts: []i32, const_blob_counts: []i32, const_blobs: []u8,
}
pub fn spellings() -> Spellings { Spellings { starts: [0], bytes: [] } }
pub fn intern(s: &mut Spellings, index: &mut Map<string, i64>, word: string) -> i32 {
    existing := index.get_or(word, -1)
    if existing >= 0 { return i32(existing) }
    id := s.starts.len - 1
    bytes.append_utf8(&mut s.bytes, word); s.starts.push(s.bytes.len)
    index.put(word.clone(), i64(id)); id
}
pub fn intern_list(s: &mut Spellings, index: &mut Map<string, i64>, words: &[]string) -> []i32 {
    mut ids: []i32 = []; ids.reserve(words.len)
    for word in &words { ids.push(intern(&mut s, &mut index, word)) }
    ids
}
pub fn read(s: &Spellings, cache: &mut []string, id: i32) -> string {
    if cache[id] == "" && s.starts[id] != s.starts[id + 1] {
        value := bytes.decode(&s.bytes[s.starts[id]..s.starts[id + 1]])
        assert(value.ok); cache[id] = value.value
    }
    cache[id].clone()
}
pub fn read_list(s: &Spellings, cache: &mut []string, ids: &[]i32) -> []string {
    mut words: []string = []; words.reserve(ids.len)
    for id in &ids { words.push(read(&s, &mut cache, id)) }
    words
}
pub fn pack_types(s: &mut Spellings, index: &mut Map<string, i64>, reg: &ft.TypeRegistry) -> Types {
    names := intern_list(&mut s, &mut index, &reg.type_names)
    fields := intern_list(&mut s, &mut index, &reg.field_names)
    Types { declared: reg.declared.clone(), tuples: reg.tuples.clone(), bound_arguments: reg.bound_arguments.clone(), names: names, fields: fields, field_types: reg.field_types.clone(), field_values: reg.field_values.clone(),
        payload_starts: reg.payload_starts.clone(), payload_counts: reg.payload_counts.clone(), payload_types: reg.payload_types.clone(),
        opaque_owner: reg.opaque_owner.clone(), opaque_sendable: reg.opaque_sendable.clone(), type_owners: reg.type_owners.clone(), c_record: reg.c_record.clone(), resource: reg.resource.clone(),
        cleanup_methods: reg.cleanup_methods.clone(), has_cleanup: reg.has_cleanup,
        result_success: reg.result_success.clone(), result_failure: reg.result_failure.clone(), option_inner: reg.option_inner.clone(),
        map_key: reg.map_key.clone(), map_value: reg.map_value.clone(), set_elem: reg.set_elem.clone() }
}
pub fn unpack_types(s: &Spellings, cache: &mut []string, t: &Types, reg: &mut ft.TypeRegistry) {
    reg.declared = t.declared.clone(); reg.sealed = true
    reg.tuples = t.tuples.clone(); reg.pending_tuples = reg.tuples.values.len
    reg.type_names = read_list(&s, &mut cache, &t.names)
    reg.field_names = read_list(&s, &mut cache, &t.fields)
    reg.field_types = t.field_types.clone(); reg.field_values = t.field_values.clone()
    reg.payload_starts = t.payload_starts.clone(); reg.payload_counts = t.payload_counts.clone(); reg.payload_types = t.payload_types.clone()
    reg.opaque_owner = t.opaque_owner.clone(); reg.opaque_sendable = t.opaque_sendable.clone(); reg.type_owners = t.type_owners.clone(); reg.c_record = t.c_record.clone(); reg.resource = t.resource.clone()
    reg.cleanup_methods = t.cleanup_methods.clone(); reg.has_cleanup = t.has_cleanup
    reg.result_success = t.result_success.clone(); reg.result_failure = t.result_failure.clone(); reg.option_inner = t.option_inner.clone()
    reg.map_key = t.map_key.clone(); reg.map_value = t.map_value.clone(); reg.set_elem = t.set_elem.clone()
    for id in 0..reg.type_names.len {
        word := reg.type_names[id].clone()
        if word != "" && !reg.named_map.contains(word) { reg.named_map.put(move word, i64(id)) }
    }
    for id in &t.bound_arguments { _ := ft.argument_name(&mut reg, id) }
}
pub fn pack_bodies(s: &mut Spellings, index: &mut Map<string, i64>, declarations: &[]i32, source: &lexer.Tokens,
    starts: &[]i32, ends: &[]i32, closes: &[]i32) -> Tokens {
    mut t := Tokens { kinds: [], words: [], positions: [], closes: [], starts: [], ends: [], origins: [], following_positions: [] }
    for start in &starts { t.starts.push(-1); t.ends.push(-1); t.origins.push(start - 1); t.following_positions.push(-1) }
    for f in &declarations {
        open := starts[f] - 1
        t.starts[f] = t.kinds.len
        for at in open..ends[f] + 1 {
            t.kinds.push(source.kinds[at]); t.words.push(intern(&mut s, &mut index, source.texts[at]))
            t.positions.push(source.starts[at])
            mut close := -1; if closes[at] >= 0 { close = closes[at] - open }
            t.closes.push(close)
        }
        t.ends[f] = t.kinds.len
        t.following_positions[f] = source.starts[ends[f] + 1]
    }
    t
}

@test fn worker_type_metadata_preserves_explicit_resource_identity() {
    mut original := ft.new_registry()
    handle := ft.add_type(&mut original, "Handle", 2, 0)
    original.resource[handle] = true
    original.cleanup_methods[handle] = 42
    original.has_cleanup = true
    original.opaque_owner[handle] = 7
    mut words := spellings(); mut index := Map<string, i64>::new()
    packed := pack_types(&mut words, &mut index, &original)
    mut cache: []string = []; for _ in 0..words.starts.len - 1 { cache.push("") }
    mut restored := ft.new_registry()
    unpack_types(&words, &mut cache, &packed, &mut restored)
    assert(restored.resource[handle] && restored.opaque_owner[handle] == 7)
    assert(ft.cleanup_method(&restored, handle) == 42)
    assert(ft.move_only(&restored, handle) && !ft.cloneable(&restored, handle))
}
