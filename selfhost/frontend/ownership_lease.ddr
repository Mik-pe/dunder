import ..backend.arm64 as arm

fn reverse_words(words: &mut []i64, first: i32, end: i32) {
    mut left := first; mut right := end - 1
    while left < right {
        words.swap(left, right)
        left += 1
        right -= 1
    }
}
fn reverse_relocs(code: &mut arm.Code, first: i32, end: i32) {
    mut left := first; mut right := end - 1
    while left < right {
        code.at.swap(left, right)
        code.target.swap(left, right)
        code.kinds.swap(left, right)
        left += 1
        right -= 1
    }
}
pub fn insert(code: &mut arm.Code, rhs: i32, setup: i32, first_label: i32, first_reloc: i32, setup_reloc: i32) -> i32 {
    end := code.words.len; count := end - setup
    assert(!code.checking && rhs >= 0 && rhs < setup && count > 0)
    reverse_words(&mut code.words, rhs, setup)
    reverse_words(&mut code.words, setup, end)
    reverse_words(&mut code.words, rhs, end)
    for i in first_label..code.labels.len {
        if code.labels[i] >= 0 { assert(code.labels[i] >= rhs && code.labels[i] <= setup); code.labels[i] = code.labels[i] + count }
    }
    for i in first_reloc..setup_reloc { code.at[i] = code.at[i] + count }
    for i in setup_reloc..code.at.len { code.at[i] = rhs + (code.at[i] - setup) }
    reverse_relocs(&mut code, first_reloc, setup_reloc)
    reverse_relocs(&mut code, setup_reloc, code.at.len)
    reverse_relocs(&mut code, first_reloc, code.at.len)
    count
}
