import lexer
import closures
import type_syntax as syntax
import ..opt.scalar_rules as rules

pub struct View { tokens: lexer.Tokens, origins: []i32, names: Map<string, i64> }
pub fn view() -> View { View {tokens:lexer.empty(false), origins:[], names:Map<string, i64>::new()} }
fn invalid(out: &mut View, t: &lexer.Tokens, at: i32, message: string) {
    if !out.tokens.ok { return }
    out.tokens.ok = false; out.tokens.error = message.clone(); out.tokens.error_at = t.starts[at]
}
fn append(out: &mut View, kind: lexer.Kind, word: string, position: i32, origin: i32) {
    out.tokens.kinds.push(kind); out.tokens.texts.push(word.clone()); out.tokens.starts.push(position)
    out.origins.push(origin)
}
fn copy(out: &mut View, input: &lexer.Tokens, first: i32, end: i32) {
    for i in first..end { append(&mut out, input.kinds[i], input.texts[i], input.starts[i], i) }
}
pub struct Analysis { ends: []i32, open: []bool }
pub fn analyze(input: &lexer.Tokens, tree: &syntax.Tree, slots: &[]i32, apps: &[]i32, end: i32) -> Analysis {
    mut nodes: []bool = []
    for i in 0..tree.forms.len {
        mut dependent := tree.forms[i] == .Name && tree.values[i] < 0
        for p in tree.starts[i]..tree.starts[i + 1] { if nodes[tree.children[p]] { dependent = true; break } }
        nodes.push(dependent)
    }
    mut open: []bool = []
    for i in 0..end { open.push(slots[i] >= 0 || (apps[i] >= 0 && nodes[apps[i]])) }
    Analysis {ends:lexer.delimiter_ends(&input, end), open:move open}
}
fn depends(input: &lexer.Tokens, a: &Analysis, locals: &Map<string, i64>, first: i32, end: i32) -> bool {
    for i in first..end {
        if a.open[i] { return true }
        if input.kinds[i] == .Name && !lexer.symbol(&input, i - 1, ".") && !lexer.symbol(&input, i - 1, "::") &&
            (input.texts[i] == "Self" || input.texts[i] == "self" || locals.contains(input.texts[i])) { return true }
    }
    false
}
fn separator(t: &lexer.Tokens, i: i32) -> bool { lexer.is_newline(t.kinds[i]) || lexer.symbol(&t, i, ";") }
fn next(t: &lexer.Tokens, a: &Analysis, first: i32, end: i32, list: bool) -> i32 {
    mut at := first
    while at < end {
        if a.ends[at] > at { at = a.ends[at] + 1; continue }
        if list && lexer.symbol(&t, at, ",") { break }
        if !list && separator(&t, at) {
            mut after := at + 1
            while after < end && separator(&t, after) { after += 1 }
            if after == end || (t.texts[after] != "else" && rules.precedence(t.texts[at - 1]) == 0) { break }
        }
        at += 1
    }
    at
}
fn binding(t: &lexer.Tokens, first: i32, end: i32) -> i32 {
    mut at := first
    if t.texts[at] == "mut" { at += 1 }
    if at + 1 < end && t.kinds[at] == .Name && (lexer.symbol(&t, at + 1, ":=") || lexer.symbol(&t, at + 1, ":")) { return at }
    -1
}
fn declarations(t: &lexer.Tokens, locals: &mut Map<string, i64>, first: i32, end: i32, dependent: bool) {
    name := binding(&t, first, end)
    stop := lexer.tuple_binding_end(&t, first, end)
    if name < 0 && stop < 0 { return }
    begin := if name < 0 { first + 1 } else { name }
    until := if name < 0 { stop } else { name + 1 }
    for i in begin..until {
        if t.kinds[i] != .Name || t.texts[i] == "_" { continue }
        if dependent { locals.put(t.texts[i].clone(), 1) } else { _ := locals.remove(t.texts[i]) }
    }
}
fn line(out: &mut View, position: i32) { append(&mut out, .Newline, "\n", position, -1) }
fn known_operand(t: &lexer.Tokens, first: i32, end: i32) -> bool {
    if first >= end { return false }
    for i in first..end {
        if lexer.symbol(&t, i, "?") || t.texts[i] == "callback" || t.kinds[i] == .Keyword && t.texts[i] == "fn" { return false }
    }
    kind := t.kinds[first]; word := &t.texts[first]
    kind == .String || kind == .Byte || kind == .Rune || word == "true" || word == "false" ||
        (kind == .Name && word != "move" && word != "mut" && word != "Self")
}
fn operands(out: &mut View, t: &lexer.Tokens, a: &Analysis, locals: &Map<string, i64>, start: i32, limit: i32, depth: i32) {
    if depth > 128 { return }
    mut first := start; mut end := limit
    while first < end && lexer.is_newline(t.kinds[first]) { first += 1 }
    while first < end && lexer.is_newline(t.kinds[end - 1]) { end -= 1 }
    if first >= end { return }
    if closures.candidate(&t, first) { return }
    if lexer.symbol(&t, first, "(") && a.ends[first] == end - 1 {
        operands(&mut out, &t, &a, &locals, first + 1, end - 1, depth + 1); return
    }
    mut at := first; mut split := -1; mut priority := 100
    while at < end {
        if a.ends[at] > at { at = a.ends[at] + 1; continue }
        if t.kinds[at] == .Symbol && at > first {
            op := rules.precedence(t.texts[at])
            if op > 0 && op <= priority { split = at; priority = op }
            if lexer.symbol(&t, at, ",") { split = at; priority = 0 }
        }
        at += 1
    }
    open := depends(&t, &a, &locals, first, end)
    if !open && priority != 0 && known_operand(&t, first, end) {
        site := t.starts[first]
        append(&mut out, .CheckOperand, "", site, -1)
        copy(&mut out, &t, first, end); line(&mut out, site); return
    }
    if split >= 0 {
        operands(&mut out, &t, &a, &locals, first, split, depth + 1)
        operands(&mut out, &t, &a, &locals, split + 1, end, depth + 1); return
    }
    at = first
    while at < end {
        close := a.ends[at]
        if close <= at || close >= end { at += 1; continue }
        if lexer.symbol(&t, at, "(") || lexer.symbol(&t, at, "[") {
            operands(&mut out, &t, &a, &locals, at + 1, close, depth + 1)
        }
        at = close + 1
    }
}
enum Tail { Statement, Function, ReturnValue, Operand }
fn control_body(t: &lexer.Tokens, a: &Analysis, first: i32, end: i32) -> i32 {
    mut at := first
    while at < end {
        close := a.ends[at]
        if close > at {
            if lexer.symbol(&t, at, "{") {
                mut after := close + 1
                while after < end && lexer.is_newline(t.kinds[after]) { after += 1 }
                if after == end || t.texts[after] == "else" { return at }
            }
            at = close + 1
        } else { at += 1 }
    }
    end
}
fn match_sections(out: &mut View, t: &lexer.Tokens, a: &Analysis, locals: &Map<string, i64>, first: i32, body: i32,
    open_return: bool, tail: Tail, depth: i32) {
    end := a.ends[body]; mut arm := body + 1; mut count := 0
    mut symbolic := depends(&t, &a, &locals, first + 1, body)
    while arm < end && !symbolic {
        mut arrow := arm
        while arrow < end && !lexer.symbol(&t, arrow, "=>") { arrow += 1 }
        symbolic = depends(&t, &a, &locals, arm, arrow)
        arm = next(&t, &a, arrow + 1, end, true) + 1
    }
    if !symbolic { copy(&mut out, &t, first, body + 1) }
    arm = body + 1
    while arm < end {
        if separator(&t, arm) || lexer.symbol(&t, arm, ",") { arm += 1; continue }
        mut arrow := arm; mut guard := -1
        while arrow < end && !lexer.symbol(&t, arrow, "=>") {
            if t.kinds[arrow] == .Keyword && t.texts[arrow] == "if" { guard = arrow }
            arrow += 1
        }
        if arrow == end { break }
        mut nested := locals.clone()
        if symbolic {
            stop := if guard < 0 { arrow } else { guard }
            for i in arm..stop {
                if t.kinds[i] == .Name && !lexer.symbol(&t, i - 1, ".") && !lexer.symbol(&t, i + 1, ".") {
                    nested.put(t.texts[i].clone(), 1)
                }
            }
            if count > 0 { append(&mut out, .Keyword, "else", t.starts[arm], -1) }
            append(&mut out, .Keyword, "if", t.starts[arm], -1)
            if guard >= 0 && !depends(&t, &a, &nested, guard + 1, arrow) { copy(&mut out, &t, guard + 1, arrow) }
            else { append(&mut out, .Keyword, "true", t.starts[arm], -1) }
        } else { copy(&mut out, &t, arm, arrow + 1) }
        mut value := arrow + 1
        while value < end && lexer.is_newline(t.kinds[value]) { value += 1 }
        stop := next(&t, &a, value, end, true)
        append(&mut out, .Symbol, "{", t.starts[arrow], -1)
        if lexer.symbol(&t, value, "{") && a.ends[value] > value {
            sections(&mut out, &t, &a, &mut nested, value + 1, a.ends[value], open_return, tail, depth + 1)
        } else {
            sections(&mut out, &t, &a, &mut nested, value, stop, open_return, tail, depth + 1)
        }
        append(&mut out, .Symbol, "}", t.starts[arrow], -1)
        if !symbolic { append(&mut out, .Symbol, ",", t.starts[arrow], -1) }
        count += 1; arm = stop + 1
    }
    if !symbolic { copy(&mut out, &t, end, end + 1) }
}
fn control(out: &mut View, t: &lexer.Tokens, a: &Analysis, locals: &Map<string, i64>, first: i32, end: i32,
    open_return: bool, tail: Tail, depth: i32) -> bool {
    mut branch := first
    while branch < end {
        word := &t.texts[branch]
        if word != "if" && word != "else" && word != "while" && word != "for" && word != "match" &&
            word != "region" && word != "task" && word != "unsafe" && word != "defer" && !lexer.symbol(&t, branch, "{") { break }
        body := control_body(&t, &a, branch, end)
        if body == end { break }
        if word == "match" { match_sections(&mut out, &t, &a, &locals, branch, body, open_return, tail, depth); return true }
        if word == "else" && branch + 1 < body && t.texts[branch + 1] == "if" {
            copy(&mut out, &t, branch, branch + 1); branch += 1
        }
        mut nested := locals.clone()
        mut inner := tail
        head_open := depends(&t, &a, &locals, branch + 1, body)
        if word == "for" && head_open {
            if branch + 1 < body { nested.put(t.texts[branch + 1].clone(), 1) }
            append(&mut out, .Keyword, "while", t.starts[branch], -1)
            append(&mut out, .Keyword, "true", t.starts[branch], -1)
        } else if (t.texts[branch] == "if" || word == "while") && head_open {
            copy(&mut out, &t, branch, branch + 1); append(&mut out, .Keyword, "true", t.starts[branch], -1)
        } else if head_open { return false }
        else { copy(&mut out, &t, branch, body) }
        if word == "while" || word == "for" || word == "defer" { inner = .Statement }
        copy(&mut out, &t, body, body + 1)
        if head_open {
            if t.texts[branch] == "if" || word == "while" {
                operands(&mut out, &t, &a, &locals, branch + 1, body, 0)
            } else if word == "for" {
                operands(&mut out, &t, &a, &locals, branch + 3, body, 0)
            }
        }
        close := a.ends[body]
        sections(&mut out, &t, &a, &mut nested, body + 1, close, open_return, inner, depth + 1)
        copy(&mut out, &t, close, close + 1)
        branch = close + 1
        while branch < end && lexer.is_newline(t.kinds[branch]) { branch += 1 }
    }
    branch > first
}
fn sections(out: &mut View, t: &lexer.Tokens, a: &Analysis, locals: &mut Map<string, i64>, first: i32, end: i32,
    open_return: bool, tail: Tail, depth: i32) {
    if depth > 128 { return }
    mut at := first
    while at < end {
        if separator(&t, at) { at += 1; continue }
        stop := next(&t, &a, at, end, false)
        mut after := stop
        while after < end && separator(&t, after) { after += 1 }
        last := after == end && (stop == end || !lexer.symbol(&t, stop, ";"))
        word := &t.texts[at]
        open := depends(&t, &a, &locals, at, stop)
        mut context := last && tail == .Operand && binding(&t, at, stop) < 0
        if open_return {
            for i in at..stop { if t.texts[i] == "return" || lexer.symbol(&t, i, "?") { context = true; break } }
            if last && (tail == .Function || tail == .ReturnValue) && binding(&t, at, stop) < 0 { context = true }
        }
        if !open && !context {
            if last && tail == .ReturnValue && word != "return" { append(&mut out, .Keyword, "return", t.starts[at], -1) }
            copy(&mut out, &t, at, stop)
        }
        else {
            mut value := at
            if word == "return" { value += 1 }
            name := binding(&t, at, stop)
            if name >= 0 {
                value = name + 2
                if lexer.symbol(&t, name + 1, ":") {
                    while value < stop && !lexer.symbol(&t, value, "=") { value += 1 }
                    value += 1
                }
            }
            mut inner := Tail.Statement
            if value > at && word != "return" { inner = .Operand }
            else if word == "return" { inner = .ReturnValue }
            else if last { inner = tail }
            if !control(&mut out, &t, &a, &locals, value, stop, open_return, inner, depth) {
                if word != "for" && word != "match" && word != "task" && word != "region" &&
                    lexer.tuple_binding_end(&t, at, stop) < 0 {
                    mut assign := value
                    while assign < stop && !lexer.symbol(&t, assign, "=") {
                        if a.ends[assign] > assign { assign = a.ends[assign] + 1 } else { assign += 1 }
                    }
                    if assign < stop { value = assign + 1 }
                    operands(&mut out, &t, &a, &locals, value, stop, 0)
                }
                append(&mut out, .Symbol, "{", t.starts[at], -1); append(&mut out, .Symbol, "}", t.starts[at], -1)
            }
        }
        declarations(&t, &mut locals, at, stop, open || context)
        if stop < end && lexer.symbol(&t, stop, ";") { copy(&mut out, &t, stop, stop + 1) }
        line(&mut out, t.starts[at])
        at = after
    }
}
fn check_body(out: &mut View, t: &lexer.Tokens, a: &Analysis, name: i32, params: i32, body: i32, end: i32) {
    close := a.ends[params]
    if close < params || close >= body { return }
    mut locals := Map<string, i64>::new(); mut parameters: []i32 = []
    if params > name + 1 {
        mut capture := name + 2
        while capture < params - 1 {
            if t.kinds[capture] == .Name { locals.put(t.texts[capture].clone(), 1) }
            capture = next(&t, &a, capture, params - 1, true) + 1
        }
    }
    mut names := Map<string, i64>::new(); mut p := params + 1
    while p < close {
        stop := next(&t, &a, p, close, true)
        for i in p..stop {
            if lexer.symbol(&t, i + 1, ":") {
                if names.contains(t.texts[i]) { invalid(&mut out, &t, i, "duplicate parameter '" + t.texts[i] + "'"); return }
                names.put(t.texts[i].clone(), 1)
                if syntax.type_end(&t, i + 2, stop) != stop { invalid(&mut out, &t, i, "invalid parameter type"); return }
                break
            }
        }
        if depends(&t, &a, &locals, p, stop) {
            for i in p..stop { if lexer.symbol(&t, i + 1, ":") { locals.put(t.texts[i].clone(), 1); break } }
        } else { parameters.push(p); parameters.push(stop) }
        p = stop + 1
    }
    open_return := depends(&t, &a, &locals, close + 1, body)
    entire := !open_return && !depends(&t, &a, &locals, body + 1, end)
    site := t.starts[name]
    line(&mut out, site)
    if name >= 2 && t.texts[name - 2] == "unsafe" { copy(&mut out, &t, name - 2, name - 1) }
    append(&mut out, .Keyword, "fn", site, -1)
    label := "__dunder_module_definition_check_" + out.names.len().str()
    append(&mut out, .Name, label, site, -1)
    out.names.put(move label, if entire { 0 } else { 1 })
    append(&mut out, .Symbol, "(", site, -1)
    for i in 0..parameters.len / 2 {
        if i > 0 { append(&mut out, .Symbol, ",", site, -1) }
        copy(&mut out, &t, parameters[i * 2], parameters[i * 2 + 1])
    }
    append(&mut out, .Symbol, ")", site, -1)
    if !open_return { copy(&mut out, &t, close + 1, body) }
    copy(&mut out, &t, body, body + 1)
    if entire { copy(&mut out, &t, body + 1, end) }
    else { sections(&mut out, &t, &a, &mut locals, body + 1, end, open_return, .Function, 0) }
    copy(&mut out, &t, end, end + 1)
}
pub fn aggregate(out: &mut View, t: &lexer.Tokens, a: &Analysis, name: i32, end: i32, c_layout: bool) {
    site := t.starts[name]; record := t.texts[name - 1] == "struct"
    line(&mut out, site)
    if c_layout {
        append(&mut out, .Symbol, "@", site, -1); append(&mut out, .Name, "c_layout", site, -1)
    }
    copy(&mut out, &t, name - 1, name)
    label := "__dunder_module_definition_type_" + out.names.len().str()
    append(&mut out, .Name, label, site, -1); out.names.put(move label, 0)
    mut at := name + 1; mut payload := false
    empty := Map<string, i64>::new()
    while at < end {
        if (record && lexer.symbol(&t, at, ":")) || (!record && !payload && lexer.symbol(&t, at, "(")) ||
            (payload && lexer.symbol(&t, at, ",")) {
            if !record { payload = true }
            copy(&mut out, &t, at, at + 1); at += 1
            stop := syntax.type_end(&t, at, end)
            if stop <= at { invalid(&mut out, &t, at, "expected a field or payload type"); return }
            if depends(&t, &a, &empty, at, stop) { append(&mut out, .Name, "i32", t.starts[at], -1) }
            else { copy(&mut out, &t, at, stop) }
            at = stop; continue
        }
        if payload && lexer.symbol(&t, at, ")") { payload = false }
        copy(&mut out, &t, at, at + 1); at += 1
    }
}
pub fn function(out: &mut View, t: &lexer.Tokens, a: &Analysis, name: i32, body: i32, end: i32) {
    check_body(&mut out, &t, &a, name, name + 1, body, end)
    for i in body + 1..end {
        if !closures.candidate(&t, i) { continue }
        mut params := i + 1
        if lexer.symbol(&t, params, "[") { params = a.ends[params] + 1 }
        if params < i || params >= end || !lexer.symbol(&t, params, "(") || a.ends[params] < params { continue }
        block := closures.body_start(&t, a.ends[params] + 1, end)
        if block >= 0 && a.ends[block] > block { check_body(&mut out, &t, &a, i, params, block, a.ends[block]) }
    }
}
