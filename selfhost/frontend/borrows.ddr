import typed_places as place
pub enum Access { Value, Address, ValueAndAddress }

pub struct Places {
    current: i32, source: i32, arena: place.Arena, roots: []i32, owners: []i32, tokens: []i32, indexed: []bool, path: []i32,
}
pub fn places() -> Places { Places { current: 0, source: -1, arena: place.new(), roots: [], owners: [], tokens: [], indexed: [], path: [] } }
pub fn clear(p: &mut Places) {
    p.current = 0; p.source = -1; place.reset(&mut p.arena); p.roots.clear(); p.owners.clear(); p.tokens.clear(); p.indexed.clear(); p.path.clear()
}
pub fn local_id(binding: i32) -> i32 { -1 - binding }
pub fn root(p: &Places, id: i32) -> i32 {
    if id <= 0 { return -1 - id }
    p.roots[id - 1]
}
pub fn has_index(p: &Places, id: i32) -> bool { id > 0 && p.indexed[id - 1] }
pub fn project(p: &mut Places, parent: i32, receiver: i32, selector: i32, ty: i32, storage: i32, token: i32, source: i32, owner: i32) -> i32 {
    binding := root(&p, parent); indexed := place.kind(storage) != i32(place.Projection.Field) || has_index(&p, parent)
    p.tokens.push(token); p.roots.push(binding); p.owners.push(owner); p.indexed.push(indexed)
    place.project(&mut p.arena, parent, selector, receiver, ty, storage, source)
}
pub fn changed(mutations: &[]i32, first: i32, last: i32, local: i32) -> bool {
    for i in first..last { if mutations[i] == local { return true } }
    false
}
