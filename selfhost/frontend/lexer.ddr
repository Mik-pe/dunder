fn synthetic(tokens: &mut Tokens, kind: Kind, move text: string, at: i32) {
    emit(&mut tokens, kind, move text, at, at)
}
fn format_segment(scanner: &mut Scanner, tokens: &mut Tokens, data: &[]u8, at: i32) {
    decoded := match utf8.decode(&data) {
        .Ok(value) => value,
        .Err(_) => { fail(&mut scanner, "literal is not valid UTF-8"); return },
    }
    synthetic(&mut tokens, .String, move decoded, at)
}
pub struct IntegerFormat { valid: bool, width: i32, radix: i32, letter_offset: i32, padding: i32 }
pub fn integer_format(spec: string) -> IntegerFormat {
    mut result := IntegerFormat { valid: false, width: 0, radix: 10, letter_offset: 87, padding: 32 }
    if spec.len == 0 { return result }
    if spec[0] == 48 { result.padding = 48 }
    mut width: i64 = 0
    mut at := 0
    while at < spec.len && digit(i32(spec[at])) {
        width = width * 10 + i64(i32(spec[at]) - 48)
        if width > 2147483647 { return result }
        at += 1
    }
    if at < spec.len {
        code := spec[at]
        if at + 1 != spec.len || (code != 100 && code != 120 && code != 88) { return result }
        if code != 100 { result.radix = 16 }
        if code == 88 { result.letter_offset = 55 }
    }
    result.width = i32(width); result.valid = true
    result
}
pub fn fixed_precision(spec: string) -> i32 {
    if spec.len < 3 || spec[0] != 46 || spec[spec.len - 1] != 102 { return -1 }
    mut places := 0
    for i in 1..spec.len - 1 {
        if !digit(i32(spec[i])) { return -1 }
        places = places * 10 + i32(spec[i]) - 48
        if places > 1074 { return -1 }
    }
    places
}
pub struct StringFormat { valid: bool, align: i32, width: i32 }
pub fn string_format(spec: string) -> StringFormat {
    mut result := StringFormat { valid: false, align: 0, width: 0 }
    if spec.len < 2 { return result }
    if spec[0] == 60 { result.align = 0 }
    else if spec[0] == 62 { result.align = 1 }
    else { return result }
    mut width: i64 = 0
    for at in 1..spec.len {
        if !digit(i32(spec[at])) { return result }
        width = width * 10 + i64(i32(spec[at]) - 48)
        if width > 2147483647 { return result }
    }
    result.width = i32(width); result.valid = true
    result
}
fn format_hole(scanner: &mut Scanner, tokens: &mut Tokens) -> i32 {
    first := tokens.kinds.len
    mut closes: []string = []
    while scanner.cursor < scanner.source.len && scanner.ok {
        at := scanner.cursor; byte := scanner.source[at]
        // An associated function or assignment uses a whole token instead of a format separator.
        colon := byte == 58 && (at + 1 >= scanner.source.len ||
            (scanner.source[at + 1] != 58 && scanner.source[at + 1] != 61))
        if closes.len == 0 && (byte == 125 || colon) {
            if tokens.kinds.len == first { fail(&mut scanner, "empty interpolation expression"); return -1 }
            return at
        }
        before := tokens.kinds.len
        scan_one(&mut scanner, &mut tokens)
        if !scanner.ok { return -1 }
        if tokens.kinds.len != before + 1 || tokens.kinds[before] != .Symbol { continue }
        word := &tokens.texts[before]
        if word == "(" { closes.push(")") }
        else if word == "[" { closes.push("]") }
        else if word == "{" { closes.push("}") }
        else if word == ")" || word == "]" || word == "}" {
            if closes.len == 0 || closes[closes.len - 1] != word {
                scanner.cursor = tokens.starts[before]
                fail(&mut scanner, "unbalanced interpolation delimiter"); return -1
            }
            _ := closes.pop()
        }
    }
    if scanner.ok { fail(&mut scanner, "unterminated interpolation expression") }
    -1
}
fn format_hole_suffix(scanner: &mut Scanner, tokens: &mut Tokens, delimiter: i32) {
    synthetic(&mut tokens, .Symbol, ")", delimiter)
    synthetic(&mut tokens, .Symbol, ".", delimiter)
    if scanner.source[delimiter] == 125 {
        synthetic(&mut tokens, .Name, "str", delimiter)
        synthetic(&mut tokens, .Symbol, "(", delimiter)
    } else {
        first := delimiter + 1
        mut end := first
        while end < scanner.source.len && (digit(i32(scanner.source[end])) || alpha(i32(scanner.source[end])) ||
            scanner.source[end] == 60 || scanner.source[end] == 62 || scanner.source[end] == 46) { end += 1 }
        spec := scanner.source[first..end]
        mut method := "__dunder_module_format_integer"
        if spec.len > 0 && spec[0] == 46 {
            if end >= scanner.source.len || scanner.source[end] != 125 || fixed_precision(spec) < 0 {
                scanner.cursor = first; fail(&mut scanner, "invalid fixed precision format; expected :.Nf with 0 to 1074 decimal places"); return
            }
            method = "__dunder_module_format_fixed"
        } else if spec.len > 0 && (spec[0] == 60 || spec[0] == 62) {
            if end >= scanner.source.len || scanner.source[end] != 125 || !string_format(spec).valid {
                scanner.cursor = first; fail(&mut scanner, "invalid string interpolation format; expected a format such as :<10 or :>10"); return
            }
            method = "__dunder_module_format_string"
        } else if end >= scanner.source.len || scanner.source[end] != 125 || !integer_format(spec).valid {
            scanner.cursor = first; fail(&mut scanner, "invalid integer interpolation format; expected a format such as :04x"); return
        }
        synthetic(&mut tokens, .Name, move method, first)
        synthetic(&mut tokens, .Symbol, "(", first)
        synthetic(&mut tokens, .String, move spec, first)
        scanner.cursor = end
    }
    close := scanner.cursor
    synthetic(&mut tokens, .Symbol, ")", close)
    synthetic(&mut tokens, .Symbol, "+", close)
    scanner.cursor += 1
}
fn formatted(scanner: &mut Scanner, tokens: &mut Tokens) {
    if scanner.formats >= 64 { fail(&mut scanner, "interpolated string nesting exceeds 64"); return }
    start := scanner.cursor
    quote := scanner.source[start + 1]
    scanner.formats = scanner.formats + 1
    scanner.parens = scanner.parens + 1
    scanner.cursor = start + 2
    synthetic(&mut tokens, .Symbol, "(", start)
    mut segment_at := scanner.cursor
    mut data: []u8 = []
    while scanner.cursor < scanner.source.len && scanner.ok {
        at := scanner.cursor
        byte := scanner.source[at]
        if byte == quote {
            format_segment(&mut scanner, &mut tokens, &data, segment_at)
            if !scanner.ok { return }
            synthetic(&mut tokens, .Symbol, ")", at)
            scanner.cursor = at + 1
            scanner.parens = scanner.parens - 1
            scanner.formats = scanner.formats - 1
            return
        }
        if byte == 10 || byte == 13 { fail(&mut scanner, "unterminated interpolated string"); return }
        if byte == 92 {
            scanner.cursor = at + 1
            escaped(&mut scanner, &mut data)
            continue
        }
        if byte == 123 || byte == 125 {
            if at + 1 < scanner.source.len && scanner.source[at + 1] == byte {
                data.push(u8(byte)); scanner.cursor = at + 2; continue
            }
            if byte == 125 { fail(&mut scanner, "single '}' in interpolated string; use '}}'"); return }
            format_segment(&mut scanner, &mut tokens, &data, segment_at)
            if !scanner.ok { return }
            synthetic(&mut tokens, .Symbol, "+", at)
            synthetic(&mut tokens, .Symbol, "(", at)
            scanner.cursor = at + 1
            delimiter := format_hole(&mut scanner, &mut tokens)
            if !scanner.ok { return }
            format_hole_suffix(&mut scanner, &mut tokens, delimiter)
            if !scanner.ok { return }
            data.clear(); segment_at = scanner.cursor
            continue
        }
        data.push(u8(byte)); scanner.cursor = at + 1
    }
    if scanner.ok { fail(&mut scanner, "unterminated interpolated string") }
}
struct FormatPart { token: i32, start: i32, end: i32 }

fn triple_indent_end(scanner: &mut Scanner, start: i32, limit: i32, indent: string) -> i32 {
    mut end := start
    while end < limit && scanner.source[end] != 10 { end += 1 }
    if end > start && scanner.source[end - 1] == 13 { end -= 1 }
    strip_block_indent(&mut scanner, start, end, indent)
}

fn finish_triple_parts(scanner: &mut Scanner, tokens: &mut Tokens, parts: &[]FormatPart, body_start: i32, body_end: i32, last_nl: i32) {
    mut start := body_start
    mut end := body_end
    mut indent := ""
    if start < end && scanner.source[start] == 13 && start + 1 < end && scanner.source[start + 1] == 10 { start += 1 }
    if start < end && scanner.source[start] == 10 {
        start += 1
        mut ws := last_nl + 1
        while ws < end && (scanner.source[ws] == 32 || scanner.source[ws] == 9) { ws += 1 }
        if ws == end {
            indent = scanner.source[last_nl + 1..end]
            end = last_nl
            if end > start && scanner.source[end - 1] == 13 { end -= 1 }
        }
    }
    if indent.len > 0 && start < end { start = triple_indent_end(&mut scanner, start, end, indent) }
    if !scanner.ok { return }
    tokens.starts[parts[0].token] = start
    if tokens.store_ends { tokens.ends[parts[0].token] = start }
    mut data: []u8 = []
    for part in parts {
        data.clear()
        scanner.cursor = if part.start < start { start } else { part.start }
        limit := if part.end < end { part.end } else { end }
        while scanner.cursor < limit {
            at := scanner.cursor
            byte := scanner.source[at]
            scanner.cursor += 1
            if byte == 92 {
                escaped(&mut scanner, &mut data)
                if !scanner.ok { return }
            } else if byte == 10 || (byte == 13 && scanner.cursor < limit && scanner.source[scanner.cursor] == 10) {
                if byte == 13 { scanner.cursor += 1 }
                data.push(10)
                if indent.len > 0 && scanner.cursor < end {
                    next := scanner.cursor
                    scanner.cursor = triple_indent_end(&mut scanner, next, end, indent)
                    if !scanner.ok { return }
                }
            } else {
                data.push(byte)
                if byte == 123 || byte == 125 { scanner.cursor += 1 }
            }
        }
        tokens.texts[part.token] = match utf8.decode(&data) {
            .Ok(value) => value,
            .Err(_) => { fail(&mut scanner, "literal is not valid UTF-8"); return },
        }
    }
}

fn formatted_triple(scanner: &mut Scanner, tokens: &mut Tokens) {
    if scanner.formats >= 64 { fail(&mut scanner, "interpolated string nesting exceeds 64"); return }
    start := scanner.cursor
    body_start := start + 4
    scanner.formats += 1
    scanner.parens += 1
    scanner.cursor = body_start
    synthetic(&mut tokens, .Symbol, "(", start)
    mut parts: []FormatPart = []
    mut segment := body_start
    mut last_nl := -1
    mut escape: []u8 = []
    while scanner.cursor < scanner.source.len && scanner.ok {
        at := scanner.cursor
        byte := scanner.source[at]
        if byte == 92 {
            scanner.cursor += 1
            escape.clear()
            escaped(&mut scanner, &mut escape)
        } else if byte == 34 && at + 2 < scanner.source.len && scanner.source[at + 1] == 34 && scanner.source[at + 2] == 34 {
            mut close := at
            while close < at + 2 && close + 3 < scanner.source.len && scanner.source[close + 3] == 34 { close += 1 }
            parts.push(FormatPart { token: tokens.kinds.len, start: segment, end: close })
            synthetic(&mut tokens, .String, "", segment)
            finish_triple_parts(&mut scanner, &mut tokens, &parts, body_start, close, last_nl)
            if !scanner.ok { return }
            synthetic(&mut tokens, .Symbol, ")", close)
            scanner.cursor = close + 3
            scanner.parens -= 1
            scanner.formats -= 1
            return
        } else if byte == 123 || byte == 125 {
            if at + 1 < scanner.source.len && scanner.source[at + 1] == byte { scanner.cursor += 2; continue }
            if byte == 125 { fail(&mut scanner, "single '}' in interpolated string; use '}}'"); return }
            parts.push(FormatPart { token: tokens.kinds.len, start: segment, end: at })
            synthetic(&mut tokens, .String, "", segment)
            synthetic(&mut tokens, .Symbol, "+", at)
            synthetic(&mut tokens, .Symbol, "(", at)
            scanner.cursor += 1
            delimiter := format_hole(&mut scanner, &mut tokens)
            if !scanner.ok { return }
            format_hole_suffix(&mut scanner, &mut tokens, delimiter)
            if !scanner.ok { return }
            segment = scanner.cursor
        } else {
            if byte == 10 { last_nl = at }
            scanner.cursor += 1
        }
    }
    if scanner.ok { fail(&mut scanner, "unterminated interpolated string") }
}
fn scan_one(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    byte := i32(scanner.source[start])
    mut next := 0
    if start + 1 < scanner.source.len { next = i32(scanner.source[start + 1]) }
    if byte == 10 {
        scanner.cursor = start + 1
        if statement_lines(&scanner, &tokens) { emit(&mut tokens, .Newline, "\n", start, scanner.cursor) }
    } else if byte == 32 || byte == 9 || byte == 13 {
        scanner.cursor = start + 1
        while scanner.cursor < scanner.source.len && i32(scanner.source[scanner.cursor]) == byte { scanner.cursor = scanner.cursor + 1 }
    }
    else if byte == 47 && next == 47 { while scanner.cursor < scanner.source.len && scanner.source[scanner.cursor] != 10 { scanner.cursor = scanner.cursor + 1 } }
    else if byte == 47 && next == 42 {
        scanner.cursor = start + 2
        mut depth := 1
        while scanner.cursor < scanner.source.len && depth > 0 {
            pos := scanner.cursor
            if pos + 1 < scanner.source.len && scanner.source[pos] == 47 && scanner.source[pos + 1] == 42 { depth = depth + 1; scanner.cursor = pos + 2 }
            else if pos + 1 < scanner.source.len && scanner.source[pos] == 42 && scanner.source[pos + 1] == 47 { depth = depth - 1; scanner.cursor = pos + 2 }
            else {
                scanner.cursor = pos + 1
                if scanner.source[pos] == 10 && statement_lines(&scanner, &tokens) { emit(&mut tokens, .Newline, "\n", pos, pos + 1) }
            }
        }
        if depth != 0 { fail(&mut scanner, "unterminated block comment") }
    } else if byte == 34 {
        if start + 2 < scanner.source.len && next == 34 && scanner.source[start + 2] == 34 {
            triple_quoted(&mut scanner, &mut tokens, false, 0)
        } else {
            quoted(&mut scanner, &mut tokens)
        }
    } else if byte == 39 || byte == 96 { quoted(&mut scanner, &mut tokens) }
    else if byte == 98 && next == 39 { byte_literal(&mut scanner, &mut tokens) }
    else if byte == 102 && (next == 34 || next == 39) {
        if next == 34 && start + 3 < scanner.source.len && scanner.source[start + 2] == 34 && scanner.source[start + 3] == 34 {
            formatted_triple(&mut scanner, &mut tokens)
        } else {
            formatted(&mut scanner, &mut tokens)
        }
    } else if byte == 114 && raw_prefix_hashes(scanner.source, start) != -1 {
        hashes := raw_prefix_hashes(scanner.source, start)
        if hashes == -2 { fail(&mut scanner, "raw string delimiter exceeds 64 '#' characters"); return }
        qpos := start + 1 + hashes
        quote := i32(scanner.source[qpos])
        if quote == 34 && qpos + 2 < scanner.source.len && scanner.source[qpos + 1] == 34 && scanner.source[qpos + 2] == 34 {
            triple_quoted(&mut scanner, &mut tokens, true, hashes)
        } else {
            raw_quoted(&mut scanner, &mut tokens, quote, hashes)
        }
    }
    else if alpha(byte) {
        scanner.cursor = start + 1
        while scanner.cursor < scanner.source.len && (alpha(i32(scanner.source[scanner.cursor])) || digit(i32(scanner.source[scanner.cursor]))) { scanner.cursor = scanner.cursor + 1 }
        emit(&mut tokens, .Name, scanner.source[start..scanner.cursor], start, scanner.cursor)
        if scanner.parens == 0 && scanner.brace_lines.len > 0 && scanner.brace_lines[scanner.brace_lines.len - 1] == .Expression {
            at := tokens.kinds.len - 1
            word := &tokens.texts[at]
            if word == "return" || word == "break" || word == "continue" || word == "mut" || word == "defer" || word == "for" || word == "while" ||
                (at > 0 && tokens.kinds[at - 1] == .Newline && word != "if" && word != "else") {
                scanner.brace_lines[scanner.brace_lines.len - 1] = .Statements
            }
        }
    } else if digit(byte) { number(&mut scanner, &mut tokens) }
    else {
        mut symbol := ""
        if byte == 46 && next == 46 && start + 2 < scanner.source.len && scanner.source[start + 2] == 61 {
            symbol = "..="
        } else if next == 61 {
            if byte == 58 { symbol = ":=" } else if byte == 61 { symbol = "==" } else if byte == 33 { symbol = "!=" }
            else if byte == 60 { symbol = "<=" } else if byte == 62 { symbol = ">=" } else if byte == 43 { symbol = "+=" }
            else if byte == 45 { symbol = "-=" } else if byte == 42 { symbol = "*=" } else if byte == 47 { symbol = "/=" }
            else if byte == 37 { symbol = "%=" }
        } else if next == 62 {
            if byte == 45 { symbol = "->" } else if byte == 61 { symbol = "=>" }
        } else if byte == next {
            if byte == 38 { symbol = "&&" } else if byte == 124 { symbol = "||" } else if byte == 46 { symbol = ".." } else if byte == 58 { symbol = "::" }
        }
        if symbol == "" { symbol = ascii_char(byte) }
        if symbol == "" { fail(&mut scanner, "unexpected character"); return }
        if scanner.brace_parens.len > 0 || (byte == 123 && scanner.parens > 0) { grouped_brace(&mut scanner, &mut tokens, symbol) }
        if byte == 46 && next != 46 && tokens.kinds.len > 0 && tokens.kinds[tokens.kinds.len - 1] == .Newline { continue_member(&mut scanner, &mut tokens) }
        if byte == 40 || byte == 91 { scanner.parens = scanner.parens + 1 }
        if (byte == 41 || byte == 93) && scanner.parens > 0 { scanner.parens = scanner.parens - 1 }
        scanner.cursor = start + symbol.len
        emit(&mut tokens, .Symbol, move symbol, start, scanner.cursor)
    }
}
pub fn empty(intern: bool) -> Tokens {
    Tokens { intern: intern, store_ends: true, source: "", kinds: [], texts: [], starts: [], ends: [], ids: [],
        symbols: Map<string, i64>::new(), ok: true, error: "", error_at: 0 }
}
pub fn lex(source: string) -> Tokens { scan(source, true) }
pub fn scan(source: string, intern: bool) -> Tokens {
    mut tokens := empty(intern)
    scan_into(source, &mut tokens)
    tokens
}
fn scanner_at(source: string, offset: i32) -> Scanner {
    Scanner {
        source: source.clone(), cursor: offset, parens: 0, formats: 0, ok: true, error: "", error_at: 0,
        chain_dot: -1, chain_indent: 0, brace_parens: [], brace_lines: [], closed_record: false,
    }
}
pub fn span_end(source: string, first: i32, last: i32) -> i32 {
    if first < 0 || first >= source.len || last < first || last >= source.len || (source[first] >= 128 && source[first] < 192) { return first }
    mut scanner := scanner_at(source, first)
    mut tokens := empty(false)
    while scanner.cursor <= last && scanner.ok { scan_one(&mut scanner, &mut tokens) }
    if !scanner.ok { return first }
    scanner.cursor
}
pub fn token_end(source: string, at: i32) -> i32 { span_end(source, at, at) }
pub fn scan_into(source: string, tokens: &mut Tokens) {
    if !tokens.ok { return }
    if tokens.kinds.len == 0 { tokens.source = source.clone() } else { tokens.source = "" }
    mut scanner := scanner_at(source, 0)
    if tokens.kinds.len == 0 {
        est := source.len / 4 + 8
        tokens.kinds.reserve(est); tokens.texts.reserve(est)
        tokens.starts.reserve(est); if tokens.store_ends { tokens.ends.reserve(est) }
        if tokens.intern { tokens.ids.reserve(est) }
    }
    while scanner.cursor < source.len && scanner.ok {
        scan_one(&mut scanner, &mut tokens)
    }
    emit(&mut tokens, .End, "", scanner.cursor, scanner.cursor)
    if !scanner.ok { tokens.ok = false; tokens.error_at = scanner.error_at; tokens.error = scanner.error }
}
pub struct Packed {
    kinds: []Kind, starts: []i32, ends: []i32,
    spelling_tokens: []i32, spelling_ends: []i32, spellings: []u8,
    ok: bool, error: []u8, error_at: i32,
}

pub fn scan_packed(source: string) -> Packed {
    tokens := scan(source, false)
    mut out := Packed { kinds: [], starts: [], ends: [], spelling_tokens: [], spelling_ends: [], spellings: [],
        ok: tokens.ok, error: [], error_at: tokens.error_at }
    if !tokens.ok { bytes.append_utf8(&mut out.error, tokens.error); return out }
    // Ordinary tokens keep only their source span. Literals and tokens
    // synthesized by interpolation also need their decoded spelling.
    for i in 0..tokens.kinds.len {
        kind := tokens.kinds[i]
        if kind == .String || kind == .Rune || kind == .Byte || (kind != .End && tokens.starts[i] == tokens.ends[i]) {
            out.spelling_tokens.push(i)
            bytes.append_utf8(&mut out.spellings, tokens.texts[i])
            out.spelling_ends.push(out.spellings.len)
        }
    }
    out.kinds = move tokens.kinds; out.starts = move tokens.starts; out.ends = move tokens.ends
    out
}

pub fn append_packed(tokens: &mut Tokens, source: string, packed: &Packed) {
    assert(!tokens.intern && tokens.ok)
    if tokens.kinds.len == 0 { tokens.source = source.clone() } else { tokens.source = "" }
    if !packed.ok {
        tokens.ok = false; tokens.error = match utf8.decode(&packed.error) { .Ok(value) => value, .Err(_) => "" }; tokens.error_at = packed.error_at
        return
    }
    mut spelling := 0; mut offset := 0
    size := tokens.kinds.len + packed.kinds.len
    tokens.kinds.reserve(size); tokens.starts.reserve(size); tokens.texts.reserve(size)
    if tokens.store_ends { tokens.ends.reserve(size) }
    for i in 0..packed.kinds.len {
        kind := packed.kinds[i]; first := packed.starts[i]; close := packed.ends[i]
        mut word := ""
        if spelling < packed.spelling_tokens.len && packed.spelling_tokens[spelling] == i {
            stop := packed.spelling_ends[spelling]
            word = match utf8.decode_range(&packed.spellings, offset, stop) { .Ok(value) => value, .Err(_) => "" }
            offset = stop; spelling += 1
        } else if is_newline(kind) { word = "\n" }
        else if (kind == .Symbol || kind == .Integer) && close == first + 1 {
            word = ascii_char(i32(source[first]))
        } else if kind != .End { word = source[first..close] }
        tokens.kinds.push(kind); tokens.starts.push(first); tokens.texts.push(move word)
        if tokens.store_ends { tokens.ends.push(close) }
    }
}

@test fn scan_into_appends_file_local_tokens_and_errors() {
    mut tokens := empty(true)
    scan_into("name(", &mut tokens)
    tokens.source == "name("
    scan_into("\nname /*", &mut tokens)
    tokens.source == ""
    tokens.kinds.len == 6
    tokens.ids.len == tokens.kinds.len
    tokens.kinds[2] == .End
    tokens.kinds[3] == .Newline
    tokens.starts[3] == 0
    tokens.starts[4] == 1
    tokens.ids[4] == tokens.ids[0]
    tokens.kinds[5] == .End
    tokens.ends[5] == 8
    !tokens.ok
    tokens.error_at == 8
    tokens.error == "unterminated block comment"
}
@test fn token_end_finds_one_original_spelling_at_any_byte_offset() {
    token_end("  å_name == 42", 2) == 9
    token_end("  å_name == 42", 10) == 12
    token_end("prefix \"å\\n\" suffix", 7) == 13
    token_end("prefix `🌍` suffix", 7) == 13
    token_end("prefix f\"{42} å\" suffix", 7) == 17
    token_end("\"unterminated", 0) == 0
    token_end("å", 1) == 1
    token_end("", 0) == 0
    token_end("name", -1) == -1
}
@test fn leading_dots_keep_source_spans_and_statement_boundaries() {
    source := "    input\r\n\t.link() /* left\nright */\n        .value\n    .variant;\n            .separate\n        ..limit"
    tokens := lex(source)
    expected := ["input", ".", "link", "(", ")", ".", "value", "\n", ".", "variant", ";", "\n", ".", "separate", "\n", "..", "limit", ""]
    tokens.ok && tokens.kinds.len == expected.len
    tokens.starts.len == expected.len && tokens.ends.len == expected.len && tokens.ids.len == expected.len
    for i in 0..expected.len {
        tokens.texts[i] == expected[i]
        source[tokens.starts[i]..tokens.ends[i]] == expected[i]
    }
    mut compact := empty(false); compact.store_ends = false
    scan_into("first\n", &mut compact)
    scan_into("\n        .new_file", &mut compact)
    compact.kinds[2] == .End && compact.kinds[3] == .Newline
    compact.kinds[4] == .Symbol && compact.starts[4] == 9
    compact.ends.len == 0 && compact.ids.len == 0
}
@test fn grouped_braces_keep_statement_lines_and_restore_surrounding_whitespace() {
    source := "f([if v { a: i32 = 1\na } else { 0 }\n, r { x\n:\ng\n(0)\n+ 1\n, y: if q { b := 2/*\n*/b } else { 0 }\n }\n])\n"
    tokens := lex(source)
    tokens.ok
    mut lines := 0
    for i in 0..tokens.kinds.len {
        if tokens.kinds[i] == .Newline {
            lines += 1
            if lines == 1 { tokens.texts[i - 1] == "1" && tokens.texts[i + 1] == "a" }
            if lines == 2 { tokens.texts[i - 1] == "2" && tokens.texts[i + 1] == "b" }
        }
    }
    lines == 3
}
@test fn span_end_keeps_interpolated_literals_whole_and_stops_before_later_strings() {
    source := "\"2\" == f\"{x}\"; print(\"later\")"
    span_end(source, 0, 12) == 13
    span_end("f\"å {x}\"; print(\"later\")", 0, 8) == 9
    span_end("x /* comment */ == \"å\"; later", 0, 19) == 23
    span_end("x == \"unterminated", 0, 6) == 0
    span_end("value", 2, 1) == 2
}
@test fn lexer_handles_literals_comments_ranges_symbols_and_identifier_interning() {
    tokens := lex("fn hälsa(x: i32) { /* outer /* nested */ */\n x := 20\n print(\"å \\u{1f30d}\")\n for i in 0..2 { x = x + i }\n}")
    tokens.ok
    tokens.texts[0] == "fn"
    tokens.kinds[0] == .Keyword
    tokens.texts[1] == "hälsa"
    tokens.starts[1] == 3
    tokens.symbols.contains("x")
    mut found := false
    for i in 0..tokens.kinds.len { if tokens.kinds[i] == .String { tokens.texts[i] == "å 🌍"; found = true } }
    found
    !lex("\"\\xff\"").ok
    !lex("/* open").ok
    !lex("1e+").ok
    !lex("1__2").ok
    !lex("`ab`").ok
    lex("1.25e-3 42_000 `🌍`").ok
}

@test fn lexer_classifies_only_whole_keywords_without_interning() {
    tokens := scan("fn if in as pub mut for else enum true while break match false return struct import continue defer impl", false)
    tokens.ok
    tokens.kinds.len == 21
    for i in 0..20 { tokens.kinds[i] == .Keyword }
    tokens.ids.len == 0
    ordinary := lex("f iffy inside assert public var variable mutable format elsewhere enumeration true_value while2 breaks matcher falsehood returned structure imported continues deferred unsafe extern capability implemented self Self")
    ordinary.ok
    for i in 0..ordinary.kinds.len - 1 { ordinary.kinds[i] == .Name }
    ordinary.ids[0] == 0
    bridge := scan("mut move movement moved", false)
    bridge.ok && bridge.kinds.len == 5
    bridge.kinds[0] == .Keyword && bridge.kinds[1] == .Keyword
    bridge.kinds[2] == .Name && bridge.kinds[3] == .Name
}

@test fn lexer_handles_byte_radix_and_compound_tokens() {
    bytes := scan("b'A' b'\\r' b'\\n' b'\\t' b'\\0' b'\\\\' b'\\'' b'\\xff' b' '", false)
    bytes.ok
    bytes.kinds.len == 10
    for i in 0..9 { bytes.kinds[i] == .Byte }
    bytes.texts[0] == "65"
    bytes.texts[1] == "13"
    bytes.texts[7] == "255"
    bytes.texts[8] == "32"
    !scan("b''", false).ok
    !scan("b'ab'", false).ok
    !scan("b'å'", false).ok
    !scan("b'\\u{41}'", false).ok
    !scan("b'a", false).ok
    nums := scan("0xff 0Xdead_BEEF 0b1010_0101 0B11 0x1e", false)
    nums.ok
    nums.kinds.len == 6
    for i in 0..5 { nums.kinds[i] == .Integer }
    nums.texts[0] == "0xff"
    nums.texts[4] == "0x1e"
    !scan("0x", false).ok
    !scan("0b", false).ok
    !scan("0x_1", false).ok
    !scan("0b10_", false).ok
    !scan("0x1__2", false).ok
    ops := scan("+= -= *= /= %= :: :", false)
    ops.ok
    ops.kinds.len == 8
    ops.texts[0] == "+="
    ops.texts[1] == "-="
    ops.texts[2] == "*="
    ops.texts[3] == "/="
    ops.texts[4] == "%="
    ops.texts[5] == "::" && ops.kinds[5] == .Symbol
    ops.texts[6] == ":" && ops.kinds[6] == .Symbol
}

@test fn plain_and_escaped_literals_preserve_utf8_spans_and_errors() {
    tokens := scan("\"å 🌍\" 'plain' `🌍` \"a\\nβ\"", false)
    tokens.ok
    tokens.kinds.len == 5
    tokens.texts[0] == "å 🌍"
    tokens.starts[0] == 0
    tokens.ends[0] == 9
    tokens.texts[1] == "plain"
    tokens.kinds[2] == .Rune
    tokens.texts[2] == "🌍"
    tokens.texts[3] == "a\nβ"
    empty := scan("\"\"", false)
    empty.ok
    empty.texts[0] == ""
    newline := scan("\"plain\n", false)
    !newline.ok
    newline.error == "unterminated literal"
    newline.error_at == 7
    !scan("`ab`", false).ok
    !scan("`🌍a`", false).ok
    !scan("\"prefix\\xff\"", false).ok
}

@test fn interpolation_expands_to_ordinary_tokens_with_original_offsets() {
    tokens := lex("f\"å {value + 2}!\"\nname")
    tokens.ok
    expected := ["(", "å ", "+", "(", "value", "+", "2", ")", ".", "str", "(", ")", "+", "!", ")", "\n", "name", ""]
    tokens.texts.len == expected.len
    for i in 0..expected.len { tokens.texts[i] == expected[i] }
    tokens.kinds[1] == .String
    tokens.kinds[4] == .Name
    tokens.kinds[6] == .Integer
    tokens.kinds[9] == .Name
    tokens.kinds[13] == .String
    tokens.kinds[15] == .Newline
    tokens.kinds[17] == .End
    tokens.starts[1] == 2 && tokens.ends[1] == 2
    tokens.starts[4] == 6 && tokens.ends[4] == 11
    tokens.starts[6] == 14 && tokens.ends[6] == 15
    tokens.starts[9] == 15 && tokens.ends[9] == 15
    tokens.starts[13] == 16 && tokens.ends[13] == 16
    tokens.starts[16] == 19 && tokens.ends[16] == 23
    tokens.ids.len == tokens.kinds.len
    tokens.symbols.contains("value")
    tokens.symbols.contains("str")
}

@test fn interpolation_escapes_and_literal_braces_do_not_change_ordinary_strings() {
    tokens := scan("f'{{\\x7b\\u{7d}}}\\n\\0å'", false)
    tokens.ok
    tokens.kinds.len == 4
    tokens.kinds[1] == .String
    tokens.texts[1] == "{{}}\n\0å"
    tokens.starts[1] == tokens.ends[1]
    empty := scan("f\"\"", false)
    empty.ok && empty.kinds.len == 4 && empty.texts[1] == ""
    plain := scan("\"{value}\" '{{}}' f \"{value}\" af\"{value}\"", false)
    plain.ok
    plain.kinds.len == 7
    plain.kinds[0] == .String && plain.texts[0] == "{value}"
    plain.kinds[1] == .String && plain.texts[1] == "{{}}"
    plain.kinds[2] == .Name && plain.texts[2] == "f"
    plain.kinds[4] == .Name && plain.texts[4] == "af"
    !scan("f\"\\xff\"", false).ok
    !scan("f\"\\xff{value}\"", false).ok
    !scan("f\"\\u{d800}\"", false).ok
}

@test fn interpolation_reuses_nested_delimiters_comments_and_recursive_strings() {
    tokens := scan("f\"{select(Point {value: 2}, [1, 2][0], \"}\") /* { /* } */ } */ + f'inner {value}'}\"\nnext", false)
    tokens.ok
    expanded := scan("(\"\" + (select(Point {value: 2}, [1, 2][0], \"}\") + (\"inner \" + (value).str() + \"\")).str() + \"\")\nnext", false)
    expanded.ok
    tokens.kinds.len == expanded.kinds.len
    for i in 0..tokens.kinds.len {
        tokens.kinds[i] == expanded.kinds[i]
        tokens.texts[i] == expanded.texts[i]
    }
    multiline := scan("f\"{ // } ignored\n 1 +\n2 }\"\nnext", false)
    multiline.ok
    mut lines := 0
    for i in 0..multiline.kinds.len { if multiline.kinds[i] == .Newline { lines += 1 } }
    lines == 1
    scan("f\"{b'}' + i32(`}`)}\"", false).ok
}

@test fn interpolation_preserves_interning_optional_spans_and_file_boundaries() {
    mut compact := empty(true)
    compact.store_ends = false
    scan_into("f\"{value}:{value}\"", &mut compact)
    first_file := compact.kinds.len
    scan_into("\nvalue", &mut compact)
    compact.ok
    compact.ends.len == 0
    compact.ids.len == compact.kinds.len
    compact.kinds[first_file - 1] == .End
    compact.kinds[first_file] == .Newline
    compact.starts[first_file] == 0
    value_id := compact.symbols.get_or("value", -1)
    value_id >= 0
    mut occurrences := 0
    for i in 0..compact.kinds.len {
        if compact.kinds[i] == .Name && compact.texts[i] == "value" {
            compact.ids[i] == value_id
            occurrences += 1
        }
    }
    occurrences == 3
    uninterned := scan("f'{value}'", false)
    uninterned.ok && uninterned.ids.len == 0
    uninterned.starts.len == uninterned.kinds.len
    uninterned.ends.len == uninterned.kinds.len
}

@test fn interpolation_reports_original_error_offsets_and_bounds_recursion() {
    sources := ["f\"}\"", "f\"{}\"", "f\"{ /*x*/ }\"", "f\"{(1]}\"", "f\"{", "f\"plain", "f\"line\n\""]
    offsets := [2, 3, 10, 5, 3, 7, 6]
    messages := ["single '}' in interpolated string; use '}}'", "empty interpolation expression", "empty interpolation expression", "unbalanced interpolation delimiter", "unterminated interpolation expression", "unterminated interpolated string", "unterminated interpolated string"]
    for i in 0..sources.len {
        tokens := scan(sources[i], false)
        !tokens.ok
        tokens.error_at == offsets[i]
        tokens.error == messages[i]
    }
    !scan("f\"{1\"", false).ok
    !scan("f\"{ /* never closed", false).ok
    !scan("f\"\\q\"", false).ok
    for quote in ["\"", "\"\"\""] {
        mut source := "1"
        for _ in 0..64 { source = "f" + quote + "{" + source + "}" + quote }
        assert(scan(source, false).ok)
        deep := scan("f" + quote + "{" + source + "}" + quote, false)
        assert(!deep.ok && deep.error == "interpolated string nesting exceeds 64")
        assert(deep.error_at == 64 * (quote.len + 2))
    }
}

@test fn raw_and_multiline_strings_dedent_and_report_errors() {
    r1 := scan("r\"a\\nb\\t\" r'a\\b' r#\"a \"b\"\"# r##\"r#\"inner\"#\"##", false)
    r1.ok
    r1.kinds.len == 5
    r1.texts[0] == "a\\nb\\t"
    r1.texts[1] == "a\\b"
    r1.texts[2] == "a \"b\""
    r1.texts[3] == "r#\"inner\"#"

    m_inline := scan("\"\"\"hello\\n \"world\"\"\"\" \"\"\"say \"hi\"\"\"\"\"", false)
    m_inline.ok
    m_inline.kinds.len == 3
    m_inline.texts[0] == "hello\n \"world\""
    m_inline.texts[1] == "say \"hi\"\""

    m_block := scan("\"\"\"\n    first\n      second\n\n    \\u{41}\"\"\"", false)
    m_block.ok && m_block.texts[0] == "    first\n      second\n\n    A"

    m_empty_block := scan("\"\"\"\n    \"\"\"", false)
    m_empty_block.ok && m_empty_block.texts[0] == ""

    m_dedent := scan("\"\"\"\n        alpha\n          beta\n\n        gamma\n    \"\"\"", false)
    m_dedent.ok && m_dedent.texts[0] == "    alpha\n      beta\n\n    gamma"

    r_multi := scan("r#\"\"\"\n    a\\nb \"\"\"\n    c\n\"\"\"#", false)
    r_multi.ok && r_multi.texts[0] == "    a\\nb \"\"\"\n    c"

    f_multi := scan("f\"\"\"\n    hi {name}\n    bye\n    \"\"\"", false)
    f_multi.ok
    mut str_parts: []string = []
    for i in 0..f_multi.kinds.len {
        if f_multi.kinds[i] == .String { str_parts.push(f_multi.texts[i].clone()) }
    }
    str_parts.len == 2 && str_parts[0] == "hi " && str_parts[1] == "\nbye"

    bad_indent := scan("\"\"\"\n  under\n    \"\"\"", false)
    !bad_indent.ok && bad_indent.error == "multiline string line is indented less than closing delimiter"
    bad_raw := scan("r#\"unclosed\"", false)
    !bad_raw.ok && bad_raw.error == "unterminated raw string literal"
    bad_triple := scan("\"\"\"unclosed", false)
    !bad_triple.ok && bad_triple.error == "unterminated multiline string literal"
    mut many_hashes := "r"
    for _ in 0..65 { many_hashes = many_hashes + "#" }
    many_hashes = many_hashes + "\"\""
    !scan(many_hashes, false).ok
}
