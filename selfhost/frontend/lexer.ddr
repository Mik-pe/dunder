import std.bytes as bytes
import ...stdlib.bytes.utf8 as utf8

pub enum Kind { End, Name, Keyword, Integer, Float, String, Rune, Symbol, Newline, Byte, GroupedNewline, CheckOperand }
pub fn is_newline(kind: Kind) -> bool { kind == .Newline || kind == .GroupedNewline }
enum BraceLines { Expression, Statements, Fields, Arms }
pub struct Tokens {
    intern: bool, store_ends: bool, source: string, kinds: []Kind,
    texts: []string,
    starts: []i32,
    ends: []i32,
    ids: []i64,
    symbols: Map<string, i64>,
    ok: bool,
    error: string,
    error_at: i32,
}

pub fn symbol(input: &Tokens, at: i32, spelling: string) -> bool {
    at >= 0 && at < input.kinds.len && input.kinds[at] == .Symbol && input.texts[at] == spelling
}

pub fn closing(input: &Tokens, first: i32, end: i32, open: string, close: string) -> i32 {
    mut depth := 1
    for i in first + 1..end {
        if symbol(&input, i, open) { depth += 1 }
        if symbol(&input, i, close) {
            depth -= 1
            if depth == 0 { return i }
        }
    }
    end
}

pub fn delimiter_ends(t: &Tokens, end: i32) -> []i32 {
    mut ends: []i32 = []; mut stack: []i32 = []
    for i in 0..end {
        ends.push(-1)
        if t.kinds[i] != .Symbol { continue }
        word := &t.texts[i]
        if word == "(" || word == "[" || word == "{" { stack.push(i) }
        if (word == ")" || word == "]" || word == "}") && stack.len > 0 {
            at := stack.pop()
            if (word == ")" && symbol(&t, at, "(")) || (word == "]" && symbol(&t, at, "[")) || (word == "}" && symbol(&t, at, "{")) { ends[at] = i }
        }
    }
    ends
}

// Returns the assignment token of a flat tuple binding, or -1 for an ordinary group.
pub fn tuple_binding_end(tokens: &Tokens, first: i32, limit: i32) -> i32 {
    if first + 1 >= limit || tokens.kinds[first] != .Symbol || tokens.texts[first] != "(" { return -1 }
    mut at := first + 1
    mut count := 0
    while at < limit && tokens.kinds[at] == .Name {
        count += 1; at += 1
        if at >= limit || tokens.kinds[at] != .Symbol || tokens.texts[at] != "," { break }
        at += 1
    }
    if count >= 2 && at + 1 < limit && tokens.kinds[at] == .Symbol && tokens.texts[at] == ")" &&
        tokens.kinds[at + 1] == .Symbol && tokens.texts[at + 1] == ":=" { return at + 1 }
    -1
}
struct Scanner {
    source: string, cursor: i32, parens: i32, formats: i32, ok: bool, error: string, error_at: i32,
    chain_dot: i32, chain_indent: i32, brace_parens: []i32, brace_lines: []BraceLines, closed_record: bool,
}
fn ascii_char(byte: i32) -> string {
    if byte < 48 {
        if byte < 42 {
            if byte == 33 { return "!" }
            if byte == 37 { return "%" }
            if byte == 38 { return "&" }
            if byte == 40 { return "(" }
            if byte == 41 { return ")" }
            return ""
        }
        if byte == 42 { return "*" }
        if byte == 43 { return "+" }
        if byte == 44 { return "," }
        if byte == 45 { return "-" }
        if byte == 46 { return "." }
        if byte == 47 { return "/" }
        return ""
    }
    if byte <= 57 {
        if byte <= 52 {
            if byte == 48 { return "0" }
            if byte == 49 { return "1" }
            if byte == 50 { return "2" }
            if byte == 51 { return "3" }
            return "4"
        }
        if byte == 53 { return "5" }
        if byte == 54 { return "6" }
        if byte == 55 { return "7" }
        if byte == 56 { return "8" }
        return "9"
    }
    if byte <= 64 {
        if byte == 58 { return ":" }
        if byte == 59 { return ";" }
        if byte == 60 { return "<" }
        if byte == 61 { return "=" }
        if byte == 62 { return ">" }
        if byte == 63 { return "?" }
        if byte == 64 { return "@" }
        return ""
    }
    if byte == 91 { return "[" }
    if byte == 93 { return "]" }
    if byte == 123 { return "{" }
    if byte == 124 { return "|" }
    if byte == 125 { return "}" }
    ""
}
fn keyword(text: string) -> bool {
    length := text.len
    if length == 2 { return text == "fn" || text == "if" || text == "in" || text == "as" }
    if length == 3 { return text == "pub" || text == "mut" || text == "for" }
    if length == 4 { return text == "else" || text == "enum" || text == "true" || text == "move" || text == "impl" }
    if length == 5 { return text == "while" || text == "break" || text == "match" || text == "false" || text == "defer" || text == "trait" }
    if length == 6 { return text == "return" || text == "struct" || text == "import" }
    length == 8 && text == "continue"
}
fn emit(tokens: &mut Tokens, kind: Kind, move text: string, start: i32, end: i32) {
    mut actual := kind
    mut id: i64 = -1
    if kind == .Name {
        if keyword(text) { actual = .Keyword }
        if tokens.intern {
            id = tokens.symbols.get_or(text, -1)
            if id < 0 { id = i64(tokens.symbols.len()); tokens.symbols.put(text.clone(), id) }
        }
    }
    tokens.kinds.push(actual); tokens.texts.push(move text)
    tokens.starts.push(start); if tokens.store_ends { tokens.ends.push(end) }; if tokens.intern { tokens.ids.push(id) }
}
fn fail(scanner: &mut Scanner, move message: string) {
    scanner.ok = false
    scanner.error = message
    scanner.error_at = scanner.cursor
}
fn digit(byte: i32) -> bool { byte >= 48 && byte <= 57 }
fn alpha(byte: i32) -> bool { (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128 }
fn indentation(source: string, at: i32) -> i32 {
    mut start := at
    while start > 0 && source[start - 1] != 10 { start -= 1 }
    mut width := 0
    for i in start..at {
        if source[i] == 32 { width += 1 }
        else if source[i] == 9 { width += 8 - width % 8 }
        else { break }
    }
    width
}
fn can_end_receiver(tokens: &Tokens, at: i32) -> bool {
    kind := tokens.kinds[at]
    if kind == .Keyword { return tokens.texts[at] == "true" || tokens.texts[at] == "false" }
    if kind == .Symbol { return tokens.texts[at] == ")" || tokens.texts[at] == "]" || tokens.texts[at] == "}" }
    kind == .Name || kind == .Integer || kind == .Float || kind == .String || kind == .Byte || kind == .Rune
}
fn before_newlines(tokens: &Tokens, end: i32) -> i32 {
    mut at := end
    while at > 0 && is_newline(tokens.kinds[at - 1]) { at -= 1 }
    at
}
fn discard_trailing_newlines(tokens: &mut Tokens, end: i32) {
    while tokens.kinds.len > end {
        _ := tokens.kinds.pop(); _ := tokens.texts.pop(); _ := tokens.starts.pop()
        if tokens.store_ends { _ := tokens.ends.pop() }
        if tokens.intern { _ := tokens.ids.pop() }
    }
}
fn continue_member(scanner: &mut Scanner, tokens: &mut Tokens) {
    end := before_newlines(&tokens, tokens.kinds.len)
    if end == tokens.kinds.len { return }
    if end == 0 || !can_end_receiver(&tokens, end - 1) { return }
    mut first := end - 1
    while first > 0 && first > scanner.chain_dot {
        kind := tokens.kinds[first - 1]
        if is_newline(kind) || kind == .End || (kind == .Symbol && tokens.texts[first - 1] == ";") { break }
        first -= 1
    }
    mut base := scanner.chain_indent
    if first != scanner.chain_dot { base = indentation(scanner.source, tokens.starts[first]) }
    if indentation(scanner.source, scanner.cursor) <= base { return }
    discard_trailing_newlines(&mut tokens, end)
    scanner.chain_dot = end; scanner.chain_indent = base
}
fn statement_lines(scanner: &Scanner, tokens: &Tokens) -> bool {
    if scanner.parens != 0 { return false }
    if scanner.brace_lines.len == 0 { return true }
    lines := scanner.brace_lines[scanner.brace_lines.len - 1]
    if lines == .Statements { return true }
    if lines == .Fields || lines == .Arms || tokens.kinds.len == 0 { return false }
    last := tokens.kinds.len - 1
    is_newline(tokens.kinds[last]) || can_end_receiver(&tokens, last)
}
fn grouped_brace(scanner: &mut Scanner, tokens: &mut Tokens, symbol: string) {
    top := scanner.brace_lines.len - 1
    if top >= 0 && scanner.parens == 0 && scanner.brace_lines[top] == .Expression {
        if symbol != "!" && symbol != "&" && tokens.kinds.len > 0 && tokens.kinds[tokens.kinds.len - 1] == .Newline {
            end := before_newlines(&tokens, tokens.kinds.len)
            ambiguous := symbol == "(" || symbol == "[" || symbol == "-" || symbol == "."
            mut previous := ""
            if end > 0 && tokens.kinds[end - 1] == .Symbol { previous = tokens.texts[end - 1].clone() }
            if ambiguous && previous == ")" {
                discard_trailing_newlines(&mut tokens, end + 1); tokens.kinds[end] = .GroupedNewline
            } else if symbol != "." || previous != "}" || scanner.closed_record {
                discard_trailing_newlines(&mut tokens, end)
            }
        }
    }
    if symbol == "{" {
        if scanner.parens > 0 || scanner.brace_parens.len > 0 {
            scanner.brace_parens.push(scanner.parens); scanner.brace_lines.push(.Expression)
            scanner.parens = 0
        }
        return
    }
    if scanner.brace_parens.len == 0 { return }
    if symbol == "}" {
        scanner.closed_record = scanner.brace_lines[top] == .Fields
        scanner.parens = scanner.brace_parens.pop(); _ := scanner.brace_lines.pop()
        return
    }
    if scanner.parens != 0 { return }
    if symbol == "=" || symbol == ":=" || symbol == "+=" || symbol == "-=" || symbol == "*=" || symbol == "/=" || symbol == "%=" || symbol == ";" {
        scanner.brace_lines[top] = .Statements
    } else if symbol == "=>" {
        scanner.brace_lines[top] = .Arms
    } else if symbol == ":" && scanner.brace_lines[top] == .Expression {
        end := before_newlines(&tokens, tokens.kinds.len)
        if end == 0 || (tokens.kinds[end - 1] != .Name && tokens.kinds[end - 1] != .Keyword) { return }
        open := before_newlines(&tokens, end - 1)
        if open > 0 && tokens.kinds[open - 1] == .Symbol && tokens.texts[open - 1] == "{" {
            discard_trailing_newlines(&mut tokens, end); scanner.brace_lines[top] = .Fields
        }
    }
}
fn hex(byte: i32) -> i32 {
    if digit(byte) { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 65 + 10 }
    if byte >= 97 && byte <= 102 { return byte - 97 + 10 }
    -1
}
fn scalar(output: &mut []u8, value: i32) -> bool {
    if value < 0 || value > 1114111 || (value >= 55296 && value <= 57343) { return false }
    if value < 128 { output.push(u8(value)) }
    else if value < 2048 { output.push(u8(192 + value / 64)); output.push(u8(128 + value % 64)) }
    else if value < 65536 { output.push(u8(224 + value / 4096)); output.push(u8(128 + value / 64 % 64)); output.push(u8(128 + value % 64)) }
    else { output.push(u8(240 + value / 262144)); output.push(u8(128 + value / 4096 % 64)); output.push(u8(128 + value / 64 % 64)); output.push(u8(128 + value % 64)) }
    true
}
fn escaped_byte(scanner: &mut Scanner, escape: i32) -> i32 {
    if escape == 110 { return 10 }
    if escape == 114 { return 13 }
    if escape == 116 { return 9 }
    if escape == 48 { return 0 }
    if escape == 92 || escape == 34 || escape == 39 || escape == 96 { return escape }
    if escape == 120 {
        mut value := 0
        for _ in 0..2 {
            if scanner.cursor >= scanner.source.len { fail(&mut scanner, "incomplete hex escape"); return -1 }
            n := hex(i32(scanner.source[scanner.cursor]))
            if n < 0 { fail(&mut scanner, "invalid hex escape"); return -1 }
            value = value * 16 + n
            scanner.cursor = scanner.cursor + 1
        }
        return value
    }
    fail(&mut scanner, "unknown escape")
    -1
}

fn escaped(scanner: &mut Scanner, data: &mut []u8) {
    if scanner.cursor >= scanner.source.len { fail(&mut scanner, "unterminated literal"); return }
    escape := i32(scanner.source[scanner.cursor])
    scanner.cursor = scanner.cursor + 1
    if escape == 117 {
        braced := scanner.cursor < scanner.source.len && scanner.source[scanner.cursor] == 123
        if braced { scanner.cursor = scanner.cursor + 1 }
        mut count := 0
        mut value := 0
        mut ended := false
        while scanner.cursor < scanner.source.len {
            if braced && scanner.source[scanner.cursor] == 125 { scanner.cursor = scanner.cursor + 1; ended = true; break }
            if !braced && count == 4 { ended = true; break }
            n := hex(i32(scanner.source[scanner.cursor]))
            if n < 0 || count == 6 { fail(&mut scanner, "invalid Unicode escape"); return }
            value = value * 16 + n
            count = count + 1
            scanner.cursor = scanner.cursor + 1
        }
        if !braced && count == 4 { ended = true }
        if !ended || count == 0 || !scalar(&mut data, value) { fail(&mut scanner, "invalid Unicode scalar"); return }
    } else {
        value := escaped_byte(&mut scanner, escape)
        if value >= 0 { data.push(u8(value)) }
    }
}
fn quoted(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    quote := scanner.source[start]
    scanner.cursor = start + 1
    while scanner.cursor < scanner.source.len {
        byte := scanner.source[scanner.cursor]
        if byte == quote {
            value := scanner.source[start + 1..scanner.cursor]
            scanner.cursor = scanner.cursor + 1
            mut kind := Kind.String
            if quote == 96 {
                if value.runes().len != 1 { fail(&mut scanner, "rune needs one Unicode scalar"); return }
                kind = .Rune
            }
            emit(&mut tokens, kind, move value, start, scanner.cursor)
            return
        }
        if byte == 92 || byte == 10 || byte == 13 { break }
        scanner.cursor = scanner.cursor + 1
    }
    mut data: []u8 = []
    for i in start + 1..scanner.cursor { data.push(u8(scanner.source[i])) }
    mut closed := false
    while scanner.cursor < scanner.source.len {
        byte := scanner.source[scanner.cursor]
        scanner.cursor = scanner.cursor + 1
        if byte == quote { closed = true; break }
        if byte == 10 || byte == 13 { break }
        if byte != 92 { data.push(u8(byte)); continue }
        if scanner.cursor >= scanner.source.len { break }
        escaped(&mut scanner, &mut data)
        if !scanner.ok { return }
    }
    if !closed { fail(&mut scanner, "unterminated literal"); return }
    decoded := match utf8.decode(&data) {
        .Ok(value) => value,
        .Err(_) => { fail(&mut scanner, "literal is not valid UTF-8"); return },
    }
    mut kind := Kind.String
    if quote == 96 {
        if decoded.runes().len != 1 { fail(&mut scanner, "rune needs one Unicode scalar"); return }
        kind = .Rune
    }
    emit(&mut tokens, kind, move decoded, start, scanner.cursor)
}
fn raw_prefix_hashes(source: string, start: i32) -> i32 {
    mut p := start + 1
    mut hashes := 0
    while p < source.len && source[p] == 35 {
        hashes += 1
        if hashes > 64 { return -2 }
        p += 1
    }
    if p < source.len && (source[p] == 34 || source[p] == 39) { return hashes }
    -1
}
fn has_hashes(source: string, at: i32, hashes: i32) -> bool {
    if at + hashes > source.len { return false }
    for i in 0..hashes {
        if source[at + i] != 35 { return false }
    }
    true
}
fn raw_quoted(scanner: &mut Scanner, tokens: &mut Tokens, quote: i32, hashes: i32) {
    start := scanner.cursor
    mut pos := start + 1 + hashes + 1
    mut data: []u8 = []
    mut closed := false
    while pos < scanner.source.len {
        byte := i32(scanner.source[pos])
        if byte == quote && has_hashes(scanner.source, pos + 1, hashes) {
            scanner.cursor = pos + 1 + hashes
            closed = true
            break
        }
        if byte == 13 && pos + 1 < scanner.source.len && scanner.source[pos + 1] == 10 {
            data.push(10)
            pos += 2
            continue
        }
        data.push(u8(byte))
        pos += 1
    }
    if !closed { scanner.cursor = pos; fail(&mut scanner, "unterminated raw string literal"); return }
    decoded := match utf8.decode(&data) {
        .Ok(value) => value,
        .Err(_) => { scanner.cursor = start; fail(&mut scanner, "literal is not valid UTF-8"); return },
    }
    emit(&mut tokens, .String, move decoded, start, scanner.cursor)
}
fn append_triple_line(scanner: &mut Scanner, data: &mut []u8, first: i32, last: i32, raw: bool) -> bool {
    if raw {
        for i in first..last { data.push(u8(scanner.source[i])) }
        return true
    }
    mut p := first
    while p < last {
        byte := scanner.source[p]
        if byte != 92 {
            data.push(u8(byte))
            p += 1
            continue
        }
        if p + 1 >= last {
            scanner.cursor = p
            fail(&mut scanner, "unknown escape")
            return false
        }
        scanner.cursor = p + 1
        escaped(&mut scanner, &mut data)
        if !scanner.ok { return false }
        if scanner.cursor > last {
            scanner.cursor = p
            fail(&mut scanner, "invalid escape in multiline string")
            return false
        }
        p = scanner.cursor
    }
    true
}
fn strip_block_indent(scanner: &mut Scanner, at: i32, line_end: i32, indent: string) -> i32 {
    mut only_ws := true
    for i in at..line_end {
        b := scanner.source[i]
        if b != 32 && b != 9 { only_ws = false; break }
    }
    if only_ws && line_end - at < indent.len { return line_end }
    if indent.len == 0 { return at }
    if line_end - at < indent.len {
        scanner.cursor = at
        fail(&mut scanner, "multiline string line is indented less than closing delimiter")
        return -1
    }
    for i in 0..indent.len {
        if scanner.source[at + i] != indent[i] {
            scanner.cursor = at
            fail(&mut scanner, "multiline string line is indented less than closing delimiter")
            return -1
        }
    }
    at + indent.len
}
fn triple_quoted(scanner: &mut Scanner, tokens: &mut Tokens, raw: bool, hashes: i32) {
    start := scanner.cursor
    open_len := (if raw { 1 + hashes } else { 0 }) + 3
    body_start := start + open_len
    mut p := body_start
    mut body_end := -1
    mut close_after := -1
    while p < scanner.source.len {
        b := scanner.source[p]
        if !raw && b == 92 {
            p += if p + 1 < scanner.source.len { 2 } else { 1 }
            continue
        }
        if p + 2 < scanner.source.len && b == 34 && scanner.source[p + 1] == 34 && scanner.source[p + 2] == 34 {
            if hashes == 0 {
                mut extra := 0
                while extra < 2 && p + 3 < scanner.source.len && scanner.source[p + 3] == 34 {
                    p += 1
                    extra += 1
                }
                body_end = p
                close_after = p + 3
                break
            } else {
                mut extra := 0
                while !has_hashes(scanner.source, p + 3, hashes) && extra < 2 && p + 3 < scanner.source.len && scanner.source[p + 3] == 34 {
                    p += 1
                    extra += 1
                }
                if has_hashes(scanner.source, p + 3, hashes) {
                    body_end = p
                    close_after = p + 3 + hashes
                    break
                }
            }
        }
        p += 1
    }
    if body_end < 0 {
        scanner.cursor = scanner.source.len
        fail(&mut scanner, "unterminated multiline string literal")
        return
    }
    mut data: []u8 = []
    is_block := body_start < body_end && (scanner.source[body_start] == 10 || (scanner.source[body_start] == 13 && body_start + 1 < body_end && scanner.source[body_start + 1] == 10))
    if !is_block {
        mut cur := body_start
        while cur < body_end {
            mut line_end := cur
            while line_end < body_end && scanner.source[line_end] != 10 { line_end += 1 }
            raw_end := if line_end > cur && scanner.source[line_end - 1] == 13 { line_end - 1 } else { line_end }
            if !append_triple_line(&mut scanner, &mut data, cur, raw_end, raw) { return }
            if line_end < body_end {
                data.push(10)
                cur = line_end + 1
            } else {
                cur = line_end
            }
        }
    } else {
        content_start := body_start + (if scanner.source[body_start] == 13 { 2 } else { 1 })
        mut last_nl := body_start
        for i in body_start..body_end {
            if scanner.source[i] == 10 { last_nl = i }
        }
        mut close_ws_only := true
        for i in (last_nl + 1)..body_end {
            wb := scanner.source[i]
            if wb != 32 && wb != 9 { close_ws_only = false; break }
        }
        mut indent := ""
        mut content_end := body_end
        mut empty_block := false
        if close_ws_only {
            indent = scanner.source[last_nl + 1..body_end]
            if last_nl < content_start {
                empty_block = true
            } else {
                content_end = if scanner.source[last_nl - 1] == 13 { last_nl - 1 } else { last_nl }
                if content_end < content_start { content_end = content_start }
            }
        }
        if !empty_block {
            mut cur := content_start
            while cur <= content_end {
                mut line_end := cur
                while line_end < content_end && scanner.source[line_end] != 10 { line_end += 1 }
                raw_end := if line_end > cur && scanner.source[line_end - 1] == 13 { line_end - 1 } else { line_end }
                stripped := strip_block_indent(&mut scanner, cur, raw_end, indent)
                if stripped < 0 { return }
                if !append_triple_line(&mut scanner, &mut data, stripped, raw_end, raw) { return }
                if line_end < content_end {
                    data.push(10)
                    cur = line_end + 1
                } else {
                    break
                }
            }
        }
    }
    scanner.cursor = close_after
    decoded := match utf8.decode(&data) {
        .Ok(value) => value,
        .Err(_) => { scanner.cursor = start; fail(&mut scanner, "literal is not valid UTF-8"); return },
    }
    emit(&mut tokens, .String, move decoded, start, scanner.cursor)
}
fn radix_digit(byte: i32, radix: i32) -> bool {
    if radix == 16 { return hex(byte) >= 0 }
    if radix == 2 { return byte == 48 || byte == 49 }
    digit(byte)
}
fn check_separators(scanner: &mut Scanner, value: string, begin: i32, radix: i32) -> bool {
    for i in begin..value.len {
        if value[i] == 95 && (i == begin || i == value.len - 1 || !radix_digit(i32(value[i - 1]), radix) || !radix_digit(i32(value[i + 1]), radix)) {
            fail(&mut scanner, "numeric separator must be between digits")
            return false
        }
    }
    true
}
fn byte_literal(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    scanner.cursor = start + 2
    if scanner.cursor >= scanner.source.len { fail(&mut scanner, "unterminated byte literal"); return }
    first := i32(scanner.source[scanner.cursor])
    if first == 39 { fail(&mut scanner, "empty byte literal"); return }
    if first == 10 || first == 13 || first >= 128 { fail(&mut scanner, "byte literal must be a single ASCII byte"); return }
    mut value := first
    scanner.cursor = scanner.cursor + 1
    if first == 92 {
        if scanner.cursor >= scanner.source.len { fail(&mut scanner, "unterminated byte literal"); return }
        escape := i32(scanner.source[scanner.cursor])
        scanner.cursor = scanner.cursor + 1
        value = escaped_byte(&mut scanner, escape)
        if value < 0 { return }
    }
    if scanner.cursor >= scanner.source.len || scanner.source[scanner.cursor] != 39 {
        fail(&mut scanner, "unterminated byte literal"); return
    }
    scanner.cursor = scanner.cursor + 1
    emit(&mut tokens, .Byte, value.str(), start, scanner.cursor)
}
fn number(scanner: &mut Scanner, tokens: &mut Tokens) {
    start := scanner.cursor
    previous := tokens.kinds.len - 1
    if previous >= 0 && tokens.kinds[previous] == .Symbol && tokens.texts[previous] == "." {
        // Tuple projections can chain without turning 0.1 into a float token.
        while scanner.cursor < scanner.source.len && digit(i32(scanner.source[scanner.cursor])) { scanner.cursor += 1 }
        emit(&mut tokens, .Integer, scanner.source[start..scanner.cursor], start, scanner.cursor)
        return
    }
    if scanner.source[start] == 48 && start + 1 < scanner.source.len {
        prefix := scanner.source[start + 1]
        mut radix := 0
        if prefix == 120 || prefix == 88 { radix = 16 }
        else if prefix == 98 || prefix == 66 { radix = 2 }
        if radix != 0 {
            scanner.cursor = start + 2
            while scanner.cursor < scanner.source.len && (radix_digit(i32(scanner.source[scanner.cursor]), radix) || scanner.source[scanner.cursor] == 95) {
                scanner.cursor = scanner.cursor + 1
            }
            if scanner.cursor == start + 2 { fail(&mut scanner, "prefixed integer literal needs digits"); return }
            value := scanner.source[start..scanner.cursor]
            if !check_separators(&mut scanner, value, 2, radix) { return }
            emit(&mut tokens, .Integer, move value, start, scanner.cursor)
            return
        }
    }
    while scanner.cursor < scanner.source.len && (digit(i32(scanner.source[scanner.cursor])) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
    mut kind := Kind.Integer
    if scanner.cursor + 1 < scanner.source.len && scanner.source[scanner.cursor] == 46 && digit(i32(scanner.source[scanner.cursor + 1])) {
        kind = .Float
        scanner.cursor = scanner.cursor + 1
        while scanner.cursor < scanner.source.len && (digit(i32(scanner.source[scanner.cursor])) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
    }
    if scanner.cursor < scanner.source.len && (scanner.source[scanner.cursor] == 101 || scanner.source[scanner.cursor] == 69) {
        kind = .Float
        scanner.cursor = scanner.cursor + 1
        if scanner.cursor < scanner.source.len && (scanner.source[scanner.cursor] == 43 || scanner.source[scanner.cursor] == 45) { scanner.cursor = scanner.cursor + 1 }
        first := scanner.cursor
        while scanner.cursor < scanner.source.len && (digit(i32(scanner.source[scanner.cursor])) || scanner.source[scanner.cursor] == 95) { scanner.cursor = scanner.cursor + 1 }
        if scanner.cursor == first { fail(&mut scanner, "exponent needs digits"); return }
    }
    if scanner.cursor == start + 1 {
        emit(&mut tokens, kind, ascii_char(i32(scanner.source[start])), start, scanner.cursor)
