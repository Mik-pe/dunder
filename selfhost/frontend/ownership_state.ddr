// Definite ownership of canonical function-local places. Each direct state
// describes one root or field; children inherit unavailable ancestors. The
// schema is append-only and checkpoints share its stable IDs by prefix.
// Runtime owner storage and cleanup remain separate frontend concerns.
pub opaque struct State {
    states: []i32, moves: []i32, reachable: bool,
    local_ids: []i32, parents: []i32, selectors: []i32, roots: []i32,
    first_children: []i32, next_siblings: []i32, flow: Loops,
}
// states: 0 initialized, 1 moved on every incoming path, 2 maybe moved.
// A field discovered after a checkpoint has direct state zero there, while
// its ancestors still determine whether the field can actually be accessed.
pub fn new() -> State {
    State { states: [], moves: [], reachable: true, local_ids: [], parents: [],
        selectors: [], roots: [], first_children: [], next_siblings: [], flow: loops() }
}
pub fn clear(s: &mut State) {
    s.states.clear(); s.moves.clear(); s.local_ids.clear(); s.parents.clear()
    s.selectors.clear(); s.roots.clear(); s.first_children.clear(); s.next_siblings.clear()
    s.reachable = true; clear_loops(&mut s.flow)
}
fn append(s: &mut State, parent: i32, selector: i32, root: i32) -> i32 {
    id := s.states.len
    s.states.push(0); s.moves.push(-1); s.parents.push(parent)
    s.selectors.push(selector); s.roots.push(root); s.first_children.push(-1)
    mut sibling := -1
    if parent >= 0 { sibling = s.first_children[parent]; s.first_children[parent] = id }
    s.next_siblings.push(sibling)
    id
}
pub fn add(s: &mut State, local: i32) {
    assert(local == s.local_ids.len)
    id := append(&mut s, -1, -1, local); s.local_ids.push(id)
}
pub fn root_id(s: &State, local: i32) -> i32 {
    assert(local >= 0 && local < s.local_ids.len)
    s.local_ids[local]
}
pub fn local_root(s: &State, id: i32) -> i32 {
    assert(id >= 0 && id < s.states.len)
    s.roots[id]
}
pub fn terminate(s: &mut State) { s.reachable = false }
pub fn project(s: &mut State, parent: i32, field: i32) -> i32 {
    assert(parent >= 0 && parent < s.states.len && field >= 0)
    mut child := s.first_children[parent]
    while child >= 0 {
        if s.selectors[child] == field { return child }
        child = s.next_siblings[child]
    }
    append(&mut s, parent, field, s.roots[parent])
}
// Places overlap when either owns storage containing the other. The query
// uses only canonical identity, independently of their initialization states.
// Indexed borrows name their containing collection's canonical place, so no
// dynamic-index disjointness is assumed here.
pub fn overlaps(s: &State, left: i32, right: i32) -> bool {
    assert(left >= 0 && left < s.states.len && right >= 0 && right < s.states.len)
    if s.roots[left] != s.roots[right] { return false }
    mut current := left
    while current >= 0 {
        if current == right { return true }
        current = s.parents[current]
    }
    current = right
    while current >= 0 {
        if current == left { return true }
        current = s.parents[current]
    }
    false
}
// Follow a subtree without recursion or scanning unrelated local places.
fn next(s: &State, id: i32, root: i32) -> i32 {
    if s.first_children[id] >= 0 { return s.first_children[id] }
    mut current := id
    while current != root {
        if s.next_siblings[current] >= 0 { return s.next_siblings[current] }
        current = s.parents[current]
    }
    -1
}
pub fn present(s: &State, id: i32) -> bool {
    assert(id >= 0 && id < s.states.len)
    mut current := id
    while current >= 0 {
        if s.states[current] != 0 { return false }
        current = s.parents[current]
    }
    true
}
// A field assignment may restore its own absent value, but cannot traverse
// storage whose parent has been moved. Root assignments need no traversal.
pub fn parent_present(s: &State, id: i32) -> bool {
    assert(id >= 0 && id < s.states.len)
    parent := s.parents[id]
    parent < 0 || present(&s, parent)
}
fn unavailable(s: &State, id: i32) -> i32 {
    assert(id >= 0 && id < s.states.len)
    mut ancestor := id
    while ancestor >= 0 {
        if s.states[ancestor] != 0 { return ancestor }
        ancestor = s.parents[ancestor]
    }
    mut child := s.first_children[id]
    while child >= 0 {
        if s.states[child] != 0 { return child }
        child = next(&s, child, id)
    }
    -1
}
pub fn available(s: &State, id: i32) -> bool { unavailable(&s, id) < 0 }
pub fn moved_at(s: &State, id: i32) -> i32 {
    cause := unavailable(&s, id)
    if cause < 0 { return -1 }
    s.moves[cause]
}
pub fn consume(s: &mut State, id: i32, token: i32) {
    assert(id >= 0 && id < s.states.len && token >= 0)
    s.states[id] = 1; s.moves[id] = token
}
pub fn initialize(s: &mut State, id: i32) {
    assert(id >= 0 && id < s.states.len)
    mut current := id
    while current >= 0 {
        s.states[current] = 0; s.moves[current] = -1
        current = next(&s, current, id)
    }
}
// Checkpoints may have a shorter schema but cannot assign a different place
// to an existing ID. Rebuild child links while extending, so restoring an old
// checkpoint never discards paths discovered on another predecessor.
fn extend(s: &mut State, saved: &State) {
    mut common := s.states.len
    if saved.states.len < common { common = saved.states.len }
    for i in 0..common {
        assert(s.parents[i] == saved.parents[i] && s.selectors[i] == saved.selectors[i] && s.roots[i] == saved.roots[i])
    }
    for i in s.states.len..saved.states.len {
        parent := saved.parents[i]; root := saved.roots[i]
        id := append(&mut s, parent, saved.selectors[i], root)
        if parent < 0 { assert(root == s.local_ids.len); s.local_ids.push(id) }
    }
}
pub fn snapshot(s: &State) -> State {
    mut out := new(); extend(&mut out, &s)
    for i in 0..s.states.len { out.states[i] = s.states[i]; out.moves[i] = s.moves[i] }
    out.reachable = s.reachable
    out
}
pub fn restore(s: &mut State, saved: &State) {
    extend(&mut s, &saved)
    for i in 0..s.states.len {
        if i < saved.states.len { s.states[i] = saved.states[i]; s.moves[i] = saved.moves[i] }
        else { s.states[i] = 0; s.moves[i] = -1 }
    }
    s.reachable = saved.reachable
}
fn merged(left: i32, right: i32) -> i32 {
    if left == 0 && right == 0 { return 0 }
    if left == 1 && right == 1 { return 1 }
    2
}
pub fn join(s: &mut State, left: &State, right: &State) {
    extend(&mut s, &left); extend(&mut s, &right)
    // A terminating predecessor contributes no requirements to a live edge.
    // If both terminate, conservatively keep checking subsequent dead source.
    if !left.reachable && right.reachable { restore(&mut s, &right); return }
    if left.reachable && !right.reachable { restore(&mut s, &left); return }
    for i in 0..s.states.len {
        root := s.roots[i]
        if root >= left.local_ids.len || root >= right.local_ids.len {
            // A new local root belongs to just one predecessor's inner scope.
            s.states[i] = 0; s.moves[i] = -1
        } else {
            mut l := 0; mut r := 0; mut cause := -1
            if i < left.states.len { l = left.states[i]; cause = left.moves[i] }
            if i < right.states.len { r = right.states[i]; if l == 0 { cause = right.moves[i] } }
            state := merged(l, r); s.states[i] = state
            if state == 0 { cause = -1 }
            s.moves[i] = cause
        }
    }
    s.reachable = left.reachable || right.reachable
}

// Loop checkpoints use flat, nested stacks. Only the active top can grow;
// fields discovered after loop entry have direct state zero at that entry.
// Their captured ancestors preserve already-partial or wholly-moved roots.
struct Loops {
    offsets: []i32, lengths: []i32, local_counts: []i32, reachable: []bool,
    states: []i32, break_states: []i32, break_moves: []i32, break_seen: []bool,
}
fn loops() -> Loops {
    Loops { offsets: [], lengths: [], local_counts: [], reachable: [], states: [],
        break_states: [], break_moves: [], break_seen: [] }
}
fn clear_loops(l: &mut Loops) {
    l.offsets.clear(); l.lengths.clear(); l.local_counts.clear(); l.reachable.clear()
    l.states.clear(); l.break_states.clear(); l.break_moves.clear(); l.break_seen.clear()
}
// The checkpoint stack lives with its State so source callers need only one
// exclusive borrow, including compilers whose alias model locks whole roots.
// Checkpoints created by snapshot deliberately start with an empty flow stack;
// restore/join change place validity without replacing the active flow stack.
pub fn loop_begin(s: &mut State) {
    s.flow.offsets.push(s.flow.states.len); s.flow.lengths.push(s.states.len)
    s.flow.local_counts.push(s.local_ids.len); s.flow.reachable.push(s.reachable); s.flow.break_seen.push(false)
    for i in 0..s.states.len {
        s.flow.states.push(s.states[i]); s.flow.break_states.push(0); s.flow.break_moves.push(-1)
    }
}
fn grow(s: &mut State) {
    top := s.flow.lengths.len - 1; assert(top >= 0)
    while s.flow.lengths[top] < s.states.len {
        s.flow.states.push(0); s.flow.break_states.push(0); s.flow.break_moves.push(-1)
        s.flow.lengths[top] += 1
    }
}
pub fn loop_backedge(s: &mut State) -> i32 {
    grow(&mut s)
    top := s.flow.offsets.len - 1; start := s.flow.offsets[top]
    if !s.reachable || !s.flow.reachable[top] { return -1 }
    for i in 0..s.states.len {
        if s.roots[i] >= s.flow.local_counts[top] || s.states[i] == 0 { continue }
        // Test direct states against entry ancestors, rather than requiring a
        // whole root to have been available. Its initialized siblings matter
        // even when a different child was moved before entering the loop.
        mut ancestor := i; mut required := true
        while ancestor >= 0 {
            if s.flow.states[start + ancestor] != 0 { required = false; break }
            ancestor = s.parents[ancestor]
        }
        if required { return i }
    }
    -1
}
pub fn loop_break(s: &mut State) {
    grow(&mut s)
    if !s.reachable { return }
    top := s.flow.offsets.len - 1; start := s.flow.offsets[top]
    for i in 0..s.states.len {
        previous := s.flow.break_states[start + i]; current := s.states[i]
        if !s.flow.break_seen[top] {
            s.flow.break_states[start + i] = current; s.flow.break_moves[start + i] = s.moves[i]
        } else {
            s.flow.break_states[start + i] = merged(previous, current)
            if previous == 0 { s.flow.break_moves[start + i] = s.moves[i] }
        }
    }
    s.flow.break_seen[top] = true
}
pub fn loop_end(s: &mut State, exit: &State) {
    restore(&mut s, &exit); grow(&mut s)
    top := s.flow.offsets.len - 1; start := s.flow.offsets[top]
    if s.flow.break_seen[top] {
        for i in 0..s.states.len {
            if s.roots[i] < s.flow.local_counts[top] {
                previous := s.states[i]; current := s.flow.break_states[start + i]
                if !exit.reachable { s.states[i] = current; s.moves[i] = s.flow.break_moves[start + i] }
                else {
                    s.states[i] = merged(previous, current)
                    if previous == 0 { s.moves[i] = s.flow.break_moves[start + i] }
                }
            }
        }
        s.reachable = true
    }
    while s.flow.states.len > start {
        _ := s.flow.states.pop(); _ := s.flow.break_states.pop(); _ := s.flow.break_moves.pop()
    }
    _ := s.flow.offsets.pop(); _ := s.flow.lengths.pop(); _ := s.flow.local_counts.pop()
    _ := s.flow.reachable.pop(); _ := s.flow.break_seen.pop()
}

@test fn checkpoints_are_independent_and_restore_stable_local_ids() {
    mut s := new(); add(&mut s, 0); add(&mut s, 1)
    saved := snapshot(&s)
    consume(&mut s, 0, 7); add(&mut s, 2); consume(&mut s, 2, 9)
    assert(available(&saved, 0) && !available(&s, 0) && moved_at(&s, 0) == 7)
    restore(&mut s, &saved)
    assert(s.states.len == 3 && available(&s, 0) && available(&s, 2))
    assert(moved_at(&s, 0) == -1 && moved_at(&s, 2) == -1)
    add(&mut s, 3)
    assert(s.states.len == 4 && available(&s, 3))
    clear(&mut s); assert(s.states.len == 0 && s.moves.len == 0 && s.reachable)
    add(&mut s, 0); assert(available(&s, 0))
}
@test fn joins_require_initialization_on_every_reachable_predecessor() {
    mut base := new(); add(&mut base, 0); add(&mut base, 1)
    mut left := snapshot(&base); mut right := snapshot(&base)
    consume(&mut left, 0, 10)
    join(&mut base, &left, &right)
    assert(!available(&base, 0) && base.states[0] == 2 && moved_at(&base, 0) == 10)
    assert(available(&base, 1))
    consume(&mut right, 0, 20)
    join(&mut base, &left, &right)
    assert(base.states[0] == 1 && moved_at(&base, 0) == 10)
    initialize(&mut left, 0); initialize(&mut right, 0)
    join(&mut base, &left, &right)
    assert(available(&base, 0) && moved_at(&base, 0) == -1)
}
@test fn terminated_paths_do_not_contaminate_live_fallthrough() {
    mut base := new(); add(&mut base, 0)
    mut left := snapshot(&base); mut right := snapshot(&base)
    consume(&mut left, 0, 31); add(&mut left, 1); left.reachable = false
    join(&mut base, &left, &right)
    assert(base.reachable && available(&base, 0) && base.states.len == 2)
    assert(available(&base, 1))
    join(&mut base, &right, &left)
    assert(base.reachable && available(&base, 0))
    right.reachable = false
    join(&mut base, &left, &right)
    assert(!base.reachable && !available(&base, 0) && moved_at(&base, 0) == 31)
}
@test fn branch_only_local_ids_remain_stable_and_inactive_after_join() {
    mut base := new(); add(&mut base, 0)
    mut left := snapshot(&base); mut right := snapshot(&base)
    add(&mut left, 1); consume(&mut left, 1, 44)
    join(&mut base, &left, &right)
    assert(base.states.len == 2 && available(&base, 0) && available(&base, 1))
    assert(moved_at(&base, 1) == -1)
    add(&mut base, 2); assert(base.states.len == 3)
}
@test fn canonical_fields_preserve_siblings_and_parent_storage() {
    mut s := new(); add(&mut s, 0)
    left := project(&mut s, 0, 0); right := project(&mut s, 0, 1)
    text := project(&mut s, left, 0); other := project(&mut s, left, 1)
    assert(project(&mut s, 0, 0) == left && project(&mut s, left, 0) == text)
    consume(&mut s, text, 60)
    assert(present(&s, 0) && present(&s, left) && !available(&s, 0) && !available(&s, left))
    assert(available(&s, right) && available(&s, other) && moved_at(&s, left) == 60)
    consume(&mut s, right, 61); initialize(&mut s, left)
    assert(available(&s, left) && !available(&s, right))
    initialize(&mut s, 0); assert(available(&s, 0))
    consume(&mut s, left, 62); initialize(&mut s, text)
    assert(!present(&s, text) && !available(&s, text) && moved_at(&s, text) == 62)
    add(&mut s, 1); assert(root_id(&s, 1) == 5 && s.roots[text] == 0)
}
@test fn fields_discovered_in_a_branch_join_with_zero_direct_state() {
    mut s := new(); add(&mut s, 0)
    before := snapshot(&s)
    field := project(&mut s, 0, 7); consume(&mut s, field, 70)
    left := snapshot(&s); restore(&mut s, &before)
    assert(project(&mut s, 0, 7) == field && available(&s, field))
    sibling := project(&mut s, 0, 8); right := snapshot(&s)
    join(&mut s, &left, &right)
    assert(!available(&s, field) && s.states[field] == 2 && present(&s, 0))
    assert(available(&s, sibling) && moved_at(&s, 0) == 70)
    initialize(&mut s, field); assert(available(&s, 0))
    consume(&mut s, 0, 71); missing := snapshot(&s)
    nested := project(&mut s, sibling, 0); restore(&mut s, &missing)
    assert(s.states[nested] == 0 && !present(&s, nested) && moved_at(&s, nested) == 71)
}
@test fn loop_backedges_require_restoration_and_ignore_new_locals() {
    mut s := new(); add(&mut s, 0); add(&mut s, 1)
    consume(&mut s, 1, 50)
    loop_begin(&mut s)
    consume(&mut s, 0, 51)
    assert(loop_backedge(&mut s) == 0)
    initialize(&mut s, 0); add(&mut s, 2); consume(&mut s, 2, 52)
    assert(loop_backedge(&mut s) == -1)
    consume(&mut s, 0, 53); s.reachable = false
    assert(loop_backedge(&mut s) == -1)
    clear_loops(&mut s.flow); assert(s.flow.states.len == 0 && s.flow.offsets.len == 0)
}
@test fn late_loop_fields_are_required_even_with_a_partial_entry() {
    mut s := new(); add(&mut s, 0)
    missing := project(&mut s, 0, 0); consume(&mut s, missing, 80)
    loop_begin(&mut s)
    live := project(&mut s, 0, 1); consume(&mut s, live, 81)
    assert(loop_backedge(&mut s) == live)
    initialize(&mut s, live); assert(loop_backedge(&mut s) == -1)
    hidden := project(&mut s, missing, 0); consume(&mut s, hidden, 82)
    assert(loop_backedge(&mut s) == -1)
    initialize(&mut s, 0); consume(&mut s, 0, 83)
    assert(loop_backedge(&mut s) == 0)
}
@test fn break_joins_include_late_fields_and_ignore_branch_local_roots() {
    mut s := new(); add(&mut s, 0)
    exit := snapshot(&s); loop_begin(&mut s)
    loop_break(&mut s)
    field := project(&mut s, 0, 2); consume(&mut s, field, 90)
    loop_break(&mut s); add(&mut s, 1)
    local := root_id(&s, 1); consume(&mut s, local, 91)
    loop_end(&mut s, &exit)
    assert(s.reachable && s.states[field] == 2 && !available(&s, 0))
    assert(available(&s, local) && s.flow.states.len == 0 && s.flow.offsets.len == 0)
}
@test fn nested_loops_preserve_outer_entry_and_break_snapshots() {
    mut s := new(); add(&mut s, 0)
    exit := snapshot(&s); loop_begin(&mut s); loop_break(&mut s)
    loop_begin(&mut s)
    field := project(&mut s, 0, 3); consume(&mut s, field, 100)
    assert(loop_backedge(&mut s) == field)
    loop_break(&mut s); loop_end(&mut s, &exit)
    assert(s.flow.offsets.len == 1 && loop_backedge(&mut s) == field)
    initialize(&mut s, field); loop_end(&mut s, &exit)
    assert(available(&s, 0) && s.flow.states.len == 0)
}

@test fn roots_registered_after_fields_keep_local_identity_across_checkpoints() {
    mut s := new(); add(&mut s, 0)
    field := project(&mut s, 0, 4); before := snapshot(&s)
    add(&mut s, 1); local := root_id(&s, 1)
    child := project(&mut s, local, 0); consume(&mut s, child, 110)
    consume(&mut s, field, 111); left := snapshot(&s)
    restore(&mut s, &before); right := snapshot(&before)
    join(&mut s, &left, &right)
    assert(local == 2 && root_id(&s, 1) == local && s.roots[child] == 1)
    assert(available(&s, local) && !available(&s, field))
    initialize(&mut s, 0); exit := snapshot(&s)
    loop_begin(&mut s)
    late := project(&mut s, 0, 5); add(&mut s, 2)
    loop_local := root_id(&s, 2); consume(&mut s, loop_local, 112)
    assert(loop_backedge(&mut s) == -1)
    consume(&mut s, late, 113); assert(loop_backedge(&mut s) == late)
    loop_break(&mut s); loop_end(&mut s, &exit)
    assert(available(&s, loop_local) && !available(&s, late))
}
@test fn terminating_loop_exits_preserve_only_reachable_break_states() {
    mut s := new(); add(&mut s, 0)
    loop_begin(&mut s)
    field := project(&mut s, 0, 0); consume(&mut s, field, 120)
    loop_break(&mut s)
    s.reachable = false; exit := snapshot(&s)
    loop_end(&mut s, &exit)
    assert(s.reachable && s.states[field] == 1 && moved_at(&s, field) == 120)
    loop_begin(&mut s); s.reachable = false; loop_break(&mut s)
    dead := snapshot(&s); loop_end(&mut s, &dead)
    assert(!s.reachable && s.states[field] == 1)
}

@test fn checkpoints_do_not_copy_or_replace_the_active_loop_stack() {
    mut s := new(); add(&mut s, 0); loop_begin(&mut s)
    entry := snapshot(&s)
    assert(entry.flow.offsets.len == 0 && s.flow.offsets.len == 1)
    field := project(&mut s, 0, 9); consume(&mut s, field, 130)
    left := snapshot(&s); restore(&mut s, &entry)
    assert(s.flow.offsets.len == 1 && available(&s, field))
    right := snapshot(&s); join(&mut s, &left, &right)
    assert(s.flow.offsets.len == 1 && loop_backedge(&mut s) == field)
    initialize(&mut s, field); loop_end(&mut s, &entry)
    assert(s.flow.offsets.len == 0 && available(&s, 0))
    loop_begin(&mut s); clear(&mut s)
    assert(s.flow.offsets.len == 0 && s.flow.states.len == 0 && s.states.len == 0)
}

@test fn canonical_overlap_follows_ancestors_and_keeps_siblings_independent() {
    mut s := new(); add(&mut s, 0)
    left := project(&mut s, 0, 0); right := project(&mut s, 0, 1)
    nested := project(&mut s, left, 0)
    add(&mut s, 1); other := root_id(&s, 1)
    assert(overlaps(&s, 0, nested) && overlaps(&s, nested, 0))
    assert(overlaps(&s, left, nested) && overlaps(&s, nested, left))
    assert(overlaps(&s, nested, nested) && !overlaps(&s, left, right))
    assert(!overlaps(&s, right, nested) && !overlaps(&s, nested, other))
    consume(&mut s, nested, 140)
    assert(overlaps(&s, left, nested) && !overlaps(&s, right, nested))
}
