pub enum SymbolKind {
    Local,
    Param,
    Fn,
    Struct,
    Enum,
    Variant,
    Trait,
    Const,
    Field,
    Method,
}

pub struct Symbol {
    kind: SymbolKind,
    name: string,
    module_id: i32,
    start: i32,
    end: i32,
    type_id: i32,
    type_name: string,
}

pub struct RefSite {
    symbol: i32,
    module_id: i32,
    start: i32,
    end: i32,
}

pub struct FunctionSummary {
    decl_id: i32,
    name: string,
    start: i32,
    end: i32,
    ret_type: i32,
    first_local: i32,
    local_count: i32,
    effects: i64,
}

pub struct Program {
    recording: bool,
    symbols: []Symbol,
    refs: []RefSite,
    functions: []FunctionSummary,
}

pub fn new_program() -> Program {
    Program { recording: false, symbols: [], refs: [], functions: [] }
}

pub fn reset(p: &mut Program) {
    p.symbols.clear()
    p.refs.clear()
    p.functions.clear()
}

pub fn record_symbol(p: &mut Program, kind: SymbolKind, move name: string, module_id: i32,
    start: i32, end: i32, type_id: i32, move type_name: string) -> i32 {
    id := p.symbols.len
    p.symbols.push(Symbol {
        kind: kind,
        name: move name,
        module_id: module_id,
        start: start,
        end: end,
        type_id: type_id,
        type_name: move type_name,
    })
    id
}

pub fn record_ref(p: &mut Program, symbol: i32, module_id: i32, start: i32, end: i32) {
    if symbol < 0 || symbol >= p.symbols.len { return }
    p.refs.push(RefSite { symbol: symbol, module_id: module_id, start: start, end: end })
}

pub fn record_function(p: &mut Program, decl_id: i32, move name: string, start: i32, end: i32,
    ret_type: i32, first_local: i32, local_count: i32, effects: i64) {
    p.functions.push(FunctionSummary {
        decl_id: decl_id,
        name: move name,
        start: start,
        end: end,
        ret_type: ret_type,
        first_local: first_local,
        local_count: local_count,
        effects: effects,
    })
}

pub fn find_symbol_at(p: &Program, offset: i32) -> i32 {
    mut best := -1
    mut best_size := 2147483647
    for i in 0..p.symbols.len {
        s := p.symbols[i].start
        e := p.symbols[i].end
        if offset >= s && offset <= e {
            size := e - s
            if size <= best_size {
                best_size = size
                best = i
            }
        }
    }
    best
}

pub fn find_ref_at(p: &Program, offset: i32) -> i32 {
    mut best := -1
    mut best_size := 2147483647
    for i in 0..p.refs.len {
        s := p.refs[i].start
        e := p.refs[i].end
        if offset >= s && offset <= e {
            size := e - s
            if size <= best_size {
                best_size = size
                best = i
            }
        }
    }
    best
}

pub fn definition_span_at(p: &Program, offset: i32) -> i32 {
    ref_idx := find_ref_at(&p, offset)
    if ref_idx >= 0 { return p.refs[ref_idx].symbol }
    find_symbol_at(&p, offset)
}

@test fn hir_tracks_symbols_refs_and_definitions() {
    mut prog := new_program()
    prog.recording = true
    fn_id := record_symbol(&mut prog, .Fn, "compute", 0, 10, 17, 1, "i32")
    param_id := record_symbol(&mut prog, .Param, "x", 0, 18, 19, 1, "i32")
    loc_id := record_symbol(&mut prog, .Local, "total", 0, 32, 37, 1, "i32")
    record_ref(&mut prog, param_id, 0, 40, 41)
    record_function(&mut prog, 0, "compute", 10, 50, 1, param_id, 2, 0)
    assert(prog.symbols.len == 3 && prog.refs.len == 1 && prog.functions.len == 1)
    assert(find_symbol_at(&prog, 12) == fn_id)
    assert(definition_span_at(&prog, 40) == param_id)
    assert(prog.symbols[loc_id].type_name == "i32")
    reset(&mut prog)
    assert(prog.symbols.len == 0 && prog.refs.len == 0 && prog.functions.len == 0)
}
