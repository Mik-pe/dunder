    if wasm_sig >= 0 { request_symbol(&mut c, .WasmCall, signature) }
    source_call.lower(&mut c.code, label, address, wasm_sig, &args, signature, ft.type_base(&c.types, signature), source_offset)
    if c.body.scratch_returns.len > first_writeback {
        arm.push_temp(&mut c.code, 0)
        while c.body.scratch_returns.len > first_writeback {
            argument := c.body.scratch_returns.pop(); record := c.body.scratch_returns.pop()
            owner := c.body.scratch_returns.pop(); destination := c.body.scratch_returns.pop()
            arm.load(&mut c.code, owner); arm.mov(&mut c.code, 1, 0)
            arm.load(&mut c.code, destination); place_step(&mut c, .RegionWrite, record, 4, 0, ft.type_count(&c.types, record), argument)
        }
        arm.pop_temp(&mut c.code, 0)
    }
    ft.type_base(&c.types, signature)
}
// An index made only of scalar loads and arithmetic cannot invalidate the
// receiver. Calls (including callbacks and methods) take the retained path.
fn read_only_index(tokens: &lexer.Tokens, first: i32) -> bool {
    var depth := 0; var pos := first
    while pos < tokens.kinds.len && pos - first < 24 {
        kind := tokens.kinds[pos]
        if kind != .Integer && kind != .Byte && kind != .Name {
            if kind != .Symbol { return false }
            op := tokens.texts[pos]
            if op == "]" {
                if depth == 0 { return true }; depth = depth - 1
            } else if op == "[" { depth = depth + 1 }
            else if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" && op != "." && op != ".." { return false }
        }
        pos = pos + 1
    }
    false
}
fn primary(c: &mut Session, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "expression nesting exceeds 128"); c.body.depth = c.body.depth - 1; return 0 }
    c.body.address = -1; c.body.writable = false; c.body.scratch_place = 0; c.body.expr_owner = -1; c.body.expr_type = -1
    first_token := c.body.cursor
    var place := 0; var at := -1; var pending := false
    var ty := primary_inner(&mut c, expected, &catalog, &mut inline_work, &mut model, &mut place, &mut at, &mut pending)
    var materialized := 0
    while c.ok && c.world.tokens.kinds[c.body.cursor] == .Symbol {
        postfix := c.world.tokens.texts[c.body.cursor]
        if postfix.len != 1 { break }
        first := postfix[0]
        if first != 46 && first != 91 && first != 40 { break }
        // Projection results borrow their receiver's storage. A call or slice
        // below may establish a new complete temporary of its own.
        c.body.expr_owner = -1; c.body.expr_type = -1
        if eat(&mut c, "(") {
            if model.probing && decline_projection(&mut c, &mut model) { break }
            if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
            if ft.type_kind(&c.types, ty) == 8 { ty = foreign_call(&mut c, ty, &catalog, &mut inline_work, &mut model) }
            else if ft.type_kind(&c.types, ty) == 9 {
                callee := slot(&mut c); arm.store(&mut c.code, callee, 0); ty = invoke(&mut c, ty, callee, -1, -1, &catalog, &mut inline_work, &mut model)
            } else { fail(&mut c, "this value is not callable for the selected target"); return 0 }
            ty = temporary(&mut c, ty); place = 0; c.body.address = -1; c.body.writable = false
        } else if eat(&mut c, "[") {
            subscript_at := c.body.cursor - 1
            array_id := model.array
            if model.probing && (!model.recording || array_id < 0) && decline_projection(&mut c, &mut model) { break }
            if pending { lower_place(&mut c, place, materialized, .Value, at); pending = false }
            packed := c.body.inline_place && ft.type_kind(&c.types, ty) == 6
            writable := c.body.writable
            if ty == 4 && !read_only_index(&c.world.tokens, c.body.cursor) { copy_value(&mut c, ty); saved_text := temporary(&mut c, ty) }
            arm.push_temp(&mut c.code, 0)
            effects := c.body.mutations.len
            previous_address := c.body.taking_address; c.body.taking_address = false
            index_type := expression(&mut c, 1, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, index_type)
            if collection(&c, ty) {
                base := borrows.root(&c.body.places, place)
