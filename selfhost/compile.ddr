}
// Keep the subject as the owner of all projected payloads. A failed test
// jumps straight to the next arm, before any arm-local copy is created.
struct PatternBindings { tokens: []i32, types: []i32, parents: []i32, offsets: []i32 }
fn match_pattern(c: &mut Session, patterns: &mut coverage.Patterns, bindings: &mut PatternBindings, ty: i32, parent: i32, offset: i32, next: i32, depth: i32) -> i32 {
    if depth > 128 { fail(&mut c, "match pattern nesting exceeds 128"); return -1 }
    if eat(&mut c, "_") { return coverage.node(&mut patterns, -1) }
    if depth > 0 && c.world.tokens.kinds[c.body.cursor] == .Name && c.world.tokens.texts[c.body.cursor + 1] != "." {
        bindings.tokens.push(c.body.cursor); bindings.types.push(ty)
        bindings.parents.push(parent); bindings.offsets.push(offset)
        skip_token(&mut c)
        return coverage.node(&mut patterns, -1)
    }
    if !enum_type(&c, ty) { fail(&mut c, "match pattern requires an enum"); return -1 }
    if !is(&c, ".") {
        if c.world.tokens.kinds[c.body.cursor] != .Name || type_id(&c, peek(&c)) != ty {
            fail(&mut c, "wrong enum in match pattern"); return -1
        }
        skip_token(&mut c)
    }
    expect(&mut c, ".")
    if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected enum variant in match pattern"); return -1 }
    found := field(&c, ty, peek(&c))
    if found < 0 { fail(&mut c, "unknown match variant"); return -1 }
    pattern_at := c.body.cursor; name := advance(&mut c)
    root := coverage.node(&mut patterns, found)
    count := c.types.payload_counts[found]
    var payload := parent
    arm.load(&mut c.code, parent)
    if offset != 0 {
        place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), offset / 8, pattern_at)
        if count > 0 { payload = slot(&mut c); arm.store(&mut c.code, payload, 0) }
    }
    if ft.type_kind(&c.types, ty) == 7 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Tag), 0, pattern_at) }
    arm.imm(&mut c.code, 1, c.types.field_values[found])
    arm.compare_register(&mut c.code, 0, 1); source_edge(&mut c, next, .NextVariant, pattern_at)
    if count > 0 {
        expect(&mut c, "(")
        for i in 0..count {
            if !c.ok { return -1 }
            if i > 0 { expect(&mut c, ",") }
            pt := c.types.payload_types[c.types.payload_starts[found] + i]
            child := match_pattern(&mut c, &mut patterns, &mut bindings, pt, payload, (i + 1) * 8, next, depth + 1)
        }
        expect(&mut c, ")")
    }
    coverage.close(&mut patterns, root)
    root
}
fn bind_pattern(c: &mut Session, model: &mut opt_ir.Function, bindings: &PatternBindings) {
    for i in 0..bindings.tokens.len {
        at := bindings.tokens[i]; ty := bindings.types[i]; index := slot(&mut c)
        bind(&mut c, &mut model, c.world.tokens.texts[at], ty, false, index, at)
        arm.load(&mut c.code, bindings.parents[i]); place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Payload), bindings.offsets[i] / 8, at)
        copy_value(&mut c, ty)
        if owned(&c, ty) { save_owner(&mut c, index, ty, false) } else { arm.store(&mut c.code, index, 0) }
    }
}
fn match_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    var unused_type := 0
    match_arms(&mut c, -1, &mut unused_type, &catalog, &mut inline_work, &mut model)
}
fn match_guard(c: &mut Session, first_owner: i32, next: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) {
    newlines(&mut c)
    condition_at := c.body.cursor; condition := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model)
    same(&mut c, 3, condition)
    if !c.ok { return }
    if first_owner == c.body.owned_slots.len { source_edge(&mut c, next, .WhenFalse, condition_at); return }
    // A tag mismatch skips the bindings. A failed guard has already created
    // them and its own temporaries, so release both before testing the next arm.
    accepted := new_block(&mut c)
    source_edge(&mut c, accepted, .WhenTrue, condition_at)
    cleanup_from(&mut c, first_owner, false)
    source_edge(&mut c, next, .Jump, condition_at); bind_block(&mut c, accepted)
}
// A nonnegative context requests an expression. Its first arm sets the type
// for the remaining arms. Statement matches keep their block and return rules.
fn match_arms(c: &mut Session, context: i32, result_type: &mut i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
    if !enum_type(&c, ty) { fail(&mut c, "match requires an enum"); return false }
    saved := slot(&mut c); take_value(&mut c, ty)
    if owned(&c, ty) { save_owner(&mut c, saved, ty, true) } else { arm.store(&mut c.code, saved, 0) }
    if !is(&c, "{") { fail(&mut c, "expected match arms"); return false }
    var value_slot := -1
    if context >= 0 { value_slot = slot(&mut c) }
    tail := context < 0 && c.body.tail && terminal(&c, c.world.closes[c.body.cursor] + 1, true)
    expect(&mut c, "{"); separators(&mut c)
    var patterns := coverage.new(ft.type_count(&c.types, ty))
    var fallback := false; var returns := true
    done := new_block(&mut c)
    while !is(&c, "}") && c.ok {
        if fallback { fail(&mut c, "wildcard must be the final match arm"); return false }
        next := new_block(&mut c); enter(&mut c)
        wildcard := is(&c, "_")
        var bindings := PatternBindings { tokens: [], types: [], parents: [], offsets: [] }
        root := match_pattern(&mut c, &mut patterns, &mut bindings, ty, saved, 0, next, 0)
        if !c.ok { return false }
        newlines(&mut c)
        guarded := eat(&mut c, "if")
        fallback = wildcard && !guarded
        error := coverage.add(&mut patterns, &c.types, ty, root, guarded)
        if error != "" { fail(&mut c, error); return false }
        first_owner := c.body.owned_slots.len
        bind_pattern(&mut c, &mut model, &bindings)
        if guarded { match_guard(&mut c, first_owner, next, &catalog, &mut inline_work, &mut model); newlines(&mut c) }
        expect(&mut c, "=>"); newlines(&mut c); var ends := false
        if context >= 0 {
            var expected := context
            if result_type != 0 { expected = result_type }
            braced := is(&c, "{")
            value := branch_value(&mut c, expected, braced, "match arm", &catalog, &mut inline_work, &mut model)
            if !c.ok { return false }
            if result_type == 0 { result_type = value } else { same(&mut c, result_type, value) }
            // Dropping pattern bindings can clobber the result register.
            arm.store(&mut c.code, value_slot, 0)
        } else if is(&c, "{") { ends = block(&mut c, tail, &catalog, &mut inline_work, &mut model) }
        else {
            arm_at := c.body.cursor; var expected := 0; if tail { expected = c.body.ret_type }
            value := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
            if tail && expected != 0 {
                if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
                same(&mut c, expected, value); take_value(&mut c, value)
                return_from_body(&mut c, arm_at); ends = true
            } else if value != 0 { fail(&mut c, "unused match arm value") }
        }
        returns = returns && ends
        leave(&mut c); source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, next)
        separators(&mut c); if !eat(&mut c, ",") && !is(&c, "}") { fail(&mut c, "expected comma between match arms") }; separators(&mut c)
    }
    expect(&mut c, "}"); bind_block(&mut c, done)
    if c.ok && !fallback {
        error := coverage.complete(&mut patterns, &c.types, ty)
        if error != "" { fail(&mut c, error) }
    }
    if context >= 0 && c.ok { arm.load(&mut c.code, value_slot) }
    returns
}
// C layouts are already resolved by the header pass. Only value fields may
// inhabit scratch storage, including fixed arrays and nested packed records.
fn scratch_width(c: &Session, ty: i32) -> i32 { ft.scratch_width(&c.types, ty, c.code.platform) }
fn scratch_block(c:&mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function)->bool {
    name_at := c.body.cursor; name:=advance(&mut c)
    if eat(&mut c,"(") { ty:=expression(&mut c,0,1, &catalog, &mut inline_work, &mut model);same(&mut c,1,ty);expect(&mut c,")") }
    else {arm.imm(&mut c.code,0,65536)}
    area:=slot(&mut c);cursor:=slot(&mut c);limit:=slot(&mut c)
    arm.store(&mut c.code,limit,0);arm.store(&mut c.code,cursor,31)
    valid:=arm.label(&mut c.code);arm.compare_immediate(&mut c.code, 0, 0, false);arm.branch(&mut c.code,valid,12)
    arm.fail_source(&mut c.code, .InvalidRegion, c.world.tokens.starts[name_at]);arm.mark(&mut c.code,valid)
    token:=compound(&mut c,20,0)
    arm.intrinsic_call(&mut c.code, c.runtime.alloc, .RegionNew, 1, token, c.world.tokens.starts[name_at])
    // Raw allocator blocks and strings share the runtime's retain/release header.
    save_owner(&mut c,area,4,false)
    enter(&mut c);bind(&mut c, &mut model,name,token,false,area, name_at)
    if !is(&c,"{"){fail(&mut c,"expected region body");return false}
    after:=c.world.closes[c.body.cursor]+1;allowed:=c.body.tail && terminal(&c,after,true)
    ends:=block_body(&mut c,allowed, &catalog, &mut inline_work, &mut model)
    clear_owner(&mut c,area,4)
    ends
}
// Recognize a declaration using the region in scope. A user-defined module
// with a function called alloc continues through ordinary name resolution.
fn scratch_declaration(c:&mut Session, name:string, mutable:bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function)->bool {
    start:=c.body.cursor
    if start+8>=c.world.tokens.texts.len || c.world.tokens.texts[start]!=":" || c.world.tokens.texts[start+1]!="[" || c.world.tokens.texts[start+2]!="]" || c.world.tokens.texts[start+4]!="=" {return false}
    region:=local(&c.body,c.world.tokens.texts[start+5])
    if region<0 || ft.type_kind(&c.types, c.body.locals.types[region])!=20 {return false}
    area:=places.local_home(c.body.places.arena.locals[region])
    c.body.cursor=start+3;elem:=type_name(&mut c);width:=scratch_width(&c,elem)
    if width==0{fail(&mut c,"scratch elements must be numeric, bool, rune or plain value records");return true}
    expect(&mut c,"=");receiver:=advance(&mut c);expect(&mut c,".");expect(&mut c,"alloc");expect(&mut c,"(")
    actual:=expression(&mut c,0,1, &catalog, &mut inline_work, &mut model);same(&mut c,1,actual);expect(&mut c,")")
    var align:=width;if ft.is_c_record(&c.types, elem) {align=ft.c_align(&c.types, elem)} else if ft.type_kind(&c.types, elem)==2{align=8}
    view:=compound(&mut c,21,elem);binding:=slot(&mut c)
    for unused in 0..3 { slot_for_descriptor:=slot(&mut c) }
    descriptor:=slot(&mut c)
    stride := unsigned.shift(storage_type(&c, elem))
    scratch.allocate(&mut c.code,area,descriptor,elem,width,align,c.bounds,stride,c.world.tokens.starts[start + 7])
    arm.store(&mut c.code,binding,0);bind(&mut c, &mut model,name,view,mutable,binding,start - 1);end_statement(&mut c)
    true
}

fn statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor
    kind := c.world.tokens.kinds[at]; word := c.world.tokens.texts[at]
    if kind == .Name && word != "region" && word != "task" && word != "unsafe" {
        return value_statement(&mut c, &catalog, &mut inline_work, &mut model)
    }
    if model.probing && (!model.recording || is(&c, "task") || is(&c, "region") || is(&c, "unsafe") || is(&c, "match") || is(&c, "defer")) && decline_projection(&mut c, &mut model) {
        return false
    }
    if is(&c, "task") && c.world.tokens.texts[c.body.cursor + 1] == "scope" { return task_scope_statement(&mut c, &catalog, &mut inline_work, &mut model) }
    if is(&c,"region") && c.world.tokens.kinds[c.body.cursor+1]==.Name {skipped:=advance(&mut c); return scratch_block(&mut c, &catalog, &mut inline_work, &mut model)}
    if eat(&mut c, "unsafe") {
        task_effect(&mut c, 16)
        if !c.world.unsafe_capable { fail(&mut c, "module requires capability unsafe"); return false }
        previous := c.body.unsafe_scope; c.body.unsafe_scope = true
        after := c.world.closes[c.body.cursor] + 1; allowed := c.body.tail && terminal(&c, after, true)
        result := block(&mut c, allowed, &catalog, &mut inline_work, &mut model); c.body.unsafe_scope = previous; return result
    }
    if is(&c, "match") && !continues_expression(&c, match_end(&c, c.body.cursor + 1, 0)) {
        c.body.cursor = c.body.cursor + 1
        return match_statement(&mut c, &catalog, &mut inline_work, &mut model)
    }
    if eat(&mut c, "return") {
        if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
        if is(&c, "\n") || is(&c, ";") || is(&c, "}") {
            if c.body.ret_type != 0 { fail(&mut c, "missing return value") }; arm.imm(&mut c.code, 0, 0)
        } else { ty := expression(&mut c, 0, c.body.ret_type, &catalog, &mut inline_work, &mut model); same(&mut c, c.body.ret_type, ty) }
        end_statement(&mut c)
        if model.recording { _ := typed.node(&mut model, 15, 0, model.value, -1, -1, 0, -1, at) }
        take_value(&mut c, c.body.ret_type)
        return_from_body(&mut c, at)
        return true
    }
    if is(&c, "if") {
        after := conditional_end(&c, c.body.cursor + 1)
        if !continues_expression(&c, after) {
            c.body.cursor = c.body.cursor + 1
            allowed := c.body.tail && terminal(&c, after, true)
            return conditional(&mut c, allowed, &catalog, &mut inline_work, &mut model)
        }
    }
    if eat(&mut c, "while") {
        previous_reentry := c.body.reenter_owners; c.body.reenter_owners = true
        condition_at := c.body.cursor
        head := new_block(&mut c); done := new_block(&mut c); bind_block(&mut c, head)
        ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty); source_edge(&mut c, done, .WhenFalse, condition_at)
        condition := model.value
        if c.tasks.program { c.body.loop_task_locals.push(c.body.locals.active.len) }
        c.body.loop_heads.push(head); c.body.loop_ends.push(done); c.body.loop_owners.push(c.body.owned_slots.len); c.body.loop_defers.push(c.body.defers.bodies.len)
        ends := block(&mut c, false, &catalog, &mut inline_work, &mut model); old_defers := c.body.loop_defers.pop(); old_owners := c.body.loop_owners.pop(); old_head := c.body.loop_heads.pop(); old_end := c.body.loop_ends.pop(); if c.tasks.program { task_boundary := c.body.loop_task_locals.pop() }
        source_edge(&mut c, head, .Jump, c.body.cursor); bind_block(&mut c, done)
        c.body.reenter_owners = previous_reentry
        if model.recording { _ := typed.node(&mut model, 14, 0, condition, model.value, -1, 0, -1, at) }
        return false
    }
    if eat(&mut c, "for") {
        name_at := c.body.cursor; name := advance(&mut c); expect(&mut c, "in")
        previous_stream := c.body.stream_depth; c.body.stream_depth = c.body.depth + 2; c.body.stream_kind = 0
        borrowed_for := eat(&mut c, "&")
        if borrowed_for && model.probing && decline_projection(&mut c, &mut model) { return false }
        var low := 0
        var place_base := -1
        var locked_local := -1
        if borrowed_for {
            c.body.stream_depth = previous_stream; c.body.stream_kind = 0
            if eat(&mut c, "mut") { fail(&mut c, "for loop requires & rather than &mut"); return false }
            previous_address := c.body.taking_address; c.body.taking_address = false
            low = primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
            c.body.taking_address = previous_address
            place_base = borrows.root(&c.body.places, c.body.places.current)
            if !collection(&c, low) { fail(&mut c, "for borrow requires an array"); return false }
            if place_base < 0 { fail(&mut c, "for borrow requires a stored array"); return false }
        } else {
            low = expression(&mut c, 1, 1, &catalog, &mut inline_work, &mut model)
            if c.body.stream_kind == 0 && !is(&c, "..") && low != 14 && collection(&c, low) && c.body.expr_owner < 0 && !c.body.writable {
                place_base = borrows.root(&c.body.places, c.body.places.current)
            }
        }
        low_node := model.value; var high_node := -1
        if model.probing && !is(&c, "..") && decline_projection(&mut c, &mut model) {
            c.body.stream_depth = previous_stream; c.body.stream_kind = 0; return false
        }
        stream := c.body.stream_kind; c.body.stream_depth = previous_stream; c.body.stream_kind = 0
        cursor := slot(&mut c); limit := slot(&mut c); values := slot(&mut c); binding := slot(&mut c)
        var kind: iteration.Kind = .Range; source := c.world.tokens.starts[at]
        var base := 1; var array := false
        var borrow_elem := false
        if stream != 0 {
            same(&mut c, 4, low); base = stream
            kind = .Bytes; if stream == 5 { kind = .Runes }
            take_value(&mut c, 4); save_owner(&mut c, values, 4, true)
            _ := length_value(&mut c, low, name_at); arm.store(&mut c.code, limit, 0)
            arm.imm(&mut c.code, 0, 0); arm.store(&mut c.code, cursor, 0)
        } else if !borrowed_for && eat(&mut c, "..") {
            same(&mut c, 1, low); arm.store(&mut c.code, cursor, 0)
            high := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, high); arm.store(&mut c.code, limit, 0); high_node = model.value
        } else if !borrowed_for && low == 14 {
            arm.mov(&mut c.code, 1, 0); iteration.emit(&mut c.code, .RangeStart, kind, base, source); arm.store(&mut c.code, cursor, 0)
            iteration.emit(&mut c.code, .RangeLimit, kind, base, source); arm.store(&mut c.code, limit, 0)
        } else {
            if !collection(&c, low) { fail(&mut c, "for requires a range or array"); return false }
            array = true; base = ft.type_base(&c.types, low); kind = .Array; if ft.type_kind(&c.types, low) == 6 { kind = .Fixed }
            if borrowed_for {
                arm.store(&mut c.code, values, 0)
                locked_local = place_base
                if owned(&c, base) { borrow_elem = true }
            } else if place_base >= 0 && c.body.expr_owner < 0 && !c.body.writable {
                arm.store(&mut c.code, values, 0)
                locked_local = place_base
            } else {
                take_value(&mut c, low); save_owner(&mut c, values, low, true)
            }
            _ := length_value(&mut c, low, name_at); arm.store(&mut c.code, limit, 0); arm.imm(&mut c.code, 0, 0); arm.store(&mut c.code, cursor, 0)
        }
        head := new_block(&mut c); next := new_block(&mut c); done := new_block(&mut c)
        enter(&mut c)
        if array || stream != 0 {
            var bind_type := base
            if borrow_elem { bind_type = compound(&mut c, 4, base) }
            bind(&mut c, &mut model, name, bind_type, false, binding, name_at)
        } else { bind(&mut c, &mut model, name, 1, false, cursor, name_at) }
        iterator := model.local_types.len - 1
        previous_reentry := c.body.reenter_owners; c.body.reenter_owners = true
        bind_block(&mut c, head); arm.load(&mut c.code, cursor); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, limit)
        iteration.emit(&mut c.code, .Test, kind, base, source); source_edge(&mut c, done, .RangeDone, name_at)
        if stream != 0 {
            var expanded := false
            if stream == 5 { expanded = inline_rune_stream(&mut c, values, cursor, source) }
            if !expanded {
                if stream == 1 {
                    arm.load(&mut c.code, values); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, cursor)
                    place_step(&mut c, .Element, 1, 0, 0, 0, name_at)
                    place_step(&mut c, .Read, 1, 0, 0, 0, name_at)
                } else {
                    arm.load(&mut c.code, cursor); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, values)
                    arm.intrinsic_call(&mut c.code, c.runtime.string_next, .NextRune, 4, 5, c.world.tokens.starts[name_at]); arm.store(&mut c.code, cursor, 1)
                }
            }
            arm.store(&mut c.code, binding, 0)
        } else if array {
            arm.load(&mut c.code, values); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, cursor)
            shift := unsigned.shift(storage_type(&c, base))
            var access := 0; if borrow_elem { access = 3 }; place_step(&mut c, .Element, base, access, 1, shift, name_at)
            if borrow_elem {
                if ft.is_c_record(&c.types, base) || fixed_pod(&c, base) { place_transfer(&mut c, base, 0, 0, true, false, access, name_at) }
                arm.store(&mut c.code, binding, 0)
            } else if borrowed_for {
                place_transfer(&mut c, base, 0, 0, true, false, access, name_at); arm.store(&mut c.code, binding, 0)
            } else {
                place_transfer(&mut c, base, 0, 0, true, false, access, name_at); copy_value(&mut c, base); if owned(&c, base) { save_owner(&mut c, binding, base, false) } else { arm.store(&mut c.code, binding, 0) }
            }
        }
        if locked_local >= 0 { c.body.for_locks.push(locked_local) }
        if c.tasks.program { c.body.loop_task_locals.push(c.body.locals.active.len) }
        c.body.loop_heads.push(next); c.body.loop_ends.push(done); c.body.loop_owners.push(c.body.owned_slots.len); c.body.loop_defers.push(c.body.defers.bodies.len)
        ends := block(&mut c, false, &catalog, &mut inline_work, &mut model); old_defers := c.body.loop_defers.pop(); old_owners := c.body.loop_owners.pop(); old_head := c.body.loop_heads.pop(); old_end := c.body.loop_ends.pop(); if c.tasks.program { task_boundary := c.body.loop_task_locals.pop() }
        if model.recording { _ := typed.node(&mut model, 19, 0, low_node, high_node, model.value, 0, iterator, at) }
        if locked_local >= 0 { unlocked := c.body.for_locks.pop() }
        bind_block(&mut c, next)
        if stream != 5 { arm.load(&mut c.code, cursor); iteration.emit(&mut c.code, .Advance, kind, base, source); arm.store(&mut c.code, cursor, 0) }
        source_edge(&mut c, head, .Jump, c.body.cursor); bind_block(&mut c, done); leave(&mut c)
        c.body.reenter_owners = previous_reentry; return false
    }
    if is(&c, "break") || is(&c, "continue") {
        exit_at := c.body.cursor; name := advance(&mut c)
        if c.body.loop_heads.len == 0 { fail(&mut c, "break or continue requires a loop"); return false }
        if c.body.in_defer && c.body.loop_heads.len <= c.body.defer_loop_floor { fail(&mut c, "break or continue cannot exit defer"); return false }
        var target := c.body.loop_ends[c.body.loop_ends.len - 1]
        var action := row.Edge.Break
        if name == "continue" { action = .Continue; target = c.body.loop_heads[c.body.loop_heads.len - 1] }
        if model.recording { var kind := 16; if name == "continue" { kind = 17 }; _ := typed.node(&mut model, kind, 0, -1, -1, -1, 0, -1, at) }
        unwind_defers(&mut c, c.body.loop_defers[c.body.loop_defers.len - 1])
        if c.tasks.program { task_close_locals(&mut c, c.body.loop_task_locals[c.body.loop_task_locals.len - 1]) }
        cleanup_from(&mut c, c.body.loop_owners[c.body.loop_owners.len - 1], false); source_edge(&mut c, target, action, exit_at)
        end_statement(&mut c)
        return false
    }
    if eat(&mut c, "defer") {
        if c.body.in_defer { fail(&mut c, "cannot nest defer blocks"); return false }
        if !is(&c, "{") { fail(&mut c, "expected block after defer"); return false }
        deferred.register(&mut c.body.defers, c.body.cursor, c.body.scope, c.body.owned_slots.len, c.body.locals.active.len)
        skip_body(&mut c)
        end_statement(&mut c)
        return false
    }
    if is(&c, "{") { after := c.world.closes[c.body.cursor] + 1; allowed := c.body.tail && terminal(&c, after, true); return block(&mut c, allowed, &catalog, &mut inline_work, &mut model) }
    value_statement(&mut c, &catalog, &mut inline_work, &mut model)
}
fn value_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor
    var mutable := false
    if eat(&mut c, "var") { mutable = true }
    if c.world.tokens.kinds[c.body.cursor] == .Name && (c.world.tokens.texts[c.body.cursor + 1] == ":=" || c.world.tokens.texts[c.body.cursor + 1] == ":") {
        name_at := c.body.cursor; name := advance(&mut c); var expected := 0
        if model.probing && is(&c, ":") {
            name := c.world.tokens.texts[c.body.cursor + 1]
            if name != "i32" && name != "i64" && name != "bool" && decline_projection(&mut c, &mut model) { return false }
        }
        if scratch_declaration(&mut c,name,mutable, &catalog, &mut inline_work, &mut model) {return false}
        if eat(&mut c, ":") { expected = type_name(&mut c); expect(&mut c, "=") } else { expect(&mut c, ":=") }
        ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model)
        if expected != 0 { same(&mut c, expected, ty) }
        if ty == 0 { fail(&mut c, "local requires a value") }
        if ft.type_kind(&c.types, ty) == 4 || ft.type_kind(&c.types, ty) == 5 { fail(&mut c, "borrows are limited to function parameters") }
        take_value(&mut c, ty); index := slot(&mut c); bind(&mut c, &mut model, name, ty, mutable, index, name_at)
        if model.recording { _ := typed.node(&mut model, 11, 0, model.value, -1, -1, 0, model.local_types.len - 1, at) }
        if owned(&c, ty) { save_owner(&mut c, index, ty, false) } else { arm.store(&mut c.code, index, 0) }
        end_statement(&mut c)
        return false
    }
    if mutable { fail(&mut c, "expected declaration after var"); return false }
    var binding := -1
    if c.world.tokens.kinds[at] == .Name && c.world.tokens.texts[at + 1] == "=" && c.body.depth <= 126 {
        binding = local(&c.body, c.world.tokens.texts[at])
    }
    var ty := 0; var place := 0
    if binding >= 0 {
        // A bare local destination has no expression operands or projections.
        // Resolve the same type, mutability and address as a grouped local.
        c.body.cursor = at + 1
        ty = local_value_type(&mut c, binding); if !c.ok { return false }
        place = borrows.local_id(binding); load_binding(&mut c, binding, .Address, at)
        c.body.expr_owner = -1; c.body.expr_type = -1
        if model.recording { typed.read(&mut model, binding, at) }
    } else {
        ty = expression(&mut c, 0, c.body.ret_type, &catalog, &mut inline_work, &mut model)
        place = c.body.places.current
    }
    var compound_op := ""
    if c.world.tokens.kinds[c.body.cursor] == .Symbol { compound_op = assign_operator(peek(&c)) }
    assignment_at := c.body.cursor
    if eat(&mut c, "=") || compound_op != "" {
        lhs := model.value
        if compound_op != "" { skip_token(&mut c) }
        may_invalidate_operand(&mut c) // Source assignment is an effect even for scalars.
        var direct := c.body.direct_place; writable := c.body.writable; packed := c.body.inline_place; scratch_target := c.body.scratch_place
        if ft.type_kind(&c.types, ty) == 21 || ft.type_kind(&c.types, ty) == 20 { fail(&mut c, "scratch bindings cannot be reassigned"); return false }
        if c.body.address < 0 || !writable { fail(&mut c, "assignment requires a mutable stored value"); return false }
        effects := c.body.mutations.len
        if compound_op == "" {
            value := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, value)
        } else if ty == 4 {
            if compound_op != "+" { fail(&mut c, "strings only support +="); return false }
            copy_value(&mut c, 4); saved_left := temporary(&mut c, 4)
            arm.push_temp(&mut c.code, 0)
            right := expression(&mut c, 0, 4, &catalog, &mut inline_work, &mut model); same(&mut c, 4, right)
            arm.pop_temp(&mut c.code, 1)
            computed := binary(&mut c, "+", 4, assignment_at); same(&mut c, 4, computed); res := temporary(&mut c, computed)
        } else {
            in_register := register_rhs(&c, 0)
            if in_register { arm.mov(&mut c.code, 1, 0) } else { arm.push_temp(&mut c.code, 0) }
            right := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, right)
            if !in_register { arm.pop_temp(&mut c.code, 1) }
            computed := binary(&mut c, compound_op, ty, assignment_at); same(&mut c, ty, computed); res := temporary(&mut c, computed)
        }
        if model.recording { typed.set(&mut model, lhs, model.value, rules.opcode(compound_op), at) }
        result_owner := c.body.expr_owner; result_type := c.body.expr_type
        base := borrows.root(&c.body.places, place)
        if base < 0 { fail(&mut c, "assignment requires a named variable, field or array element"); return false }
        if is_for_locked(&c, base) { fail(&mut c, "cannot assign to a collection while iterating over it"); return false }
        if place > 0 && borrows.changed(&c.body.mutations, effects, c.body.mutations.len, base) {
            if borrows.has_index(&c.body.places, place) { fail(&mut c, "compute mutations before assigning an array element"); return false }
            // A call on the right can replace a heap-backed record. Resolve the
            // pure field chain again so the write lands in its current storage.
            arm.push_temp(&mut c.code, 0); lower_place(&mut c, place, 0, .Address, at)
            direct = c.body.direct_place; arm.pop_temp(&mut c.code, 0)
        }
        c.body.expr_owner = result_owner; c.body.expr_type = result_type
        if scratch_target==1 && !ft.is_c_record(&c.types, ty) {
            arm.mov(&mut c.code,1,0);place_address(&mut c, place, direct, assignment_at)
            if ft.type_kind(&c.types, ty)==2 {
                place_step(&mut c, .RegionWrite, ty, i32(borrows.Access.Address), 0, ft.type_count(&c.types, ty), assignment_at)
            }else{place_transfer(&mut c, ty, 1, 0, false, true, i32(borrows.Access.Address), assignment_at)}
            end_statement(&mut c);return false
        }
        if packed {
            arm.push_temp(&mut c.code,0); place_address(&mut c, place, direct, assignment_at); arm.mov(&mut c.code,1,0); arm.pop_temp(&mut c.code,0)
            store_inline(&mut c, ty, assignment_at); end_statement(&mut c); return false
        }
        take_value(&mut c, ty)
        if !owned(&c, ty) {
            if direct { bound_place(&mut c, .LocalWrite, place, i32(borrows.Access.Address), assignment_at) }
            else {
                arm.mov(&mut c.code, 1, 0); place_address(&mut c, place, false, assignment_at)
                if place > 0 { bound_place(&mut c, .Write, place, i32(borrows.Access.Address), assignment_at) }
                else { place_transfer(&mut c, ty, 1, 0, false, false, i32(borrows.Access.Address), assignment_at) }
            }
            end_statement(&mut c); return false
        }
        arm.push_temp(&mut c.code, 0)
        if owned(&c, ty) { place_address(&mut c, place, direct, assignment_at); place_transfer(&mut c, ty, 0, 0, true, false, 2, assignment_at); drop_value(&mut c, ty) }
        place_address(&mut c, place, direct, assignment_at); arm.pop_temp(&mut c.code, 1); place_transfer(&mut c, ty, 1, 0, false, false, i32(borrows.Access.Address), assignment_at)
        end_statement(&mut c); return false
    }
    if c.body.tail && terminal(&c, c.body.cursor, false) && c.body.ret_type != 0 {
        if c.body.in_defer { fail(&mut c, "return is not allowed inside defer") }
        same(&mut c, c.body.ret_type, ty); take_value(&mut c, ty)
        if model.recording { _ := typed.node(&mut model, 15, 0, model.value, -1, -1, 0, -1, at) }
        return_from_body(&mut c, at); return true
    }
    model.recording = false
    if ty == 3 && c.body.testing {
        trap_edge(&mut c, c.assertion, .Assert, at)
    } else if ty != 0 { fail(&mut c, "unused value; bind it or return it") }
    end_statement(&mut c)
    false
}
fn literals(c: &mut Session) {
    for i in 0..c.strings.len {
        if c.code.words.len % 2 != 0 { arm.emit(&mut c.code, 0) }
        arm.emit(&mut c.code, 0); arm.emit(&mut c.code, 0) // immortal literal reference count
        arm.mark(&mut c.code, c.string_labels[i])
        text := c.strings[i]
        arm.emit(&mut c.code, i64(text.len)); arm.emit(&mut c.code, 0)
        var cursor := 0
        while cursor < text.len {
            var word: i64 = 0; var factor: i64 = 1
            for j in 0..4 {
                if cursor < text.len { word = word + i64(text[cursor]) * factor; cursor = cursor + 1 }
                factor = factor * 256
            }
            arm.emit(&mut c.code, word)
        }
        if text.len % 4 == 0 { arm.emit(&mut c.code, 0) }
    }
}
fn clones(c: &mut Session) {
    for ty in 0..c.types.type_names.len {
        if !owned(&c, ty) || ty == 4 || collection(&c, ty) { continue }
        arm.mark(&mut c.code, c.helper_labels[ty]); frame := arm.prologue(&mut c.code); arm.frame(&mut c.code, frame, 2)
        if c.types.c_record[ty] {
            arm.push(&mut c.code,0); arm.imm(&mut c.code,0,i64(c.types.declared.c_sizes[ty])); arm.branch(&mut c.code,c.runtime.alloc_clone,1)
            arm.mov(&mut c.code,1,0); arm.pop(&mut c.code,0); copy_inline(&mut c,c.types.declared.c_sizes[ty])
        } else if c.types.declared.type_kinds[ty] == 7 { arm.branch(&mut c.code, c.runtime.retain, 1) }
        else {
            arm.store(&mut c.code, 0, 0); arm.imm(&mut c.code, 0, i64(c.types.declared.type_counts[ty]) * 8); arm.branch(&mut c.code, c.runtime.alloc_clone, 1); arm.store(&mut c.code, 1, 0)
            first := c.types.declared.type_starts[ty]
            for i in 0..c.types.declared.type_counts[ty] {
                arm.load(&mut c.code, 0); load_mem(&mut c, 0, 0, i * 8); copy_value(&mut c, c.types.field_types[first + i])
                arm.push(&mut c.code, 0); arm.load(&mut c.code, 1); arm.pop(&mut c.code, 1); store_mem(&mut c, 1, 0, i * 8)
            }
            arm.load(&mut c.code, 1)
        }
        arm.ret(&mut c.code)
        arm.mark(&mut c.code, c.helper_labels[ty] + 1); drop_frame := arm.prologue(&mut c.code); arm.frame(&mut c.code, drop_frame, 1)
        done := arm.label(&mut c.code); arm.branch(&mut c.code, done, 18); arm.store(&mut c.code, 0, 0)
        if c.types.declared.type_kinds[ty] == 7 {
            shared := arm.label(&mut c.code)
            arm.emit(&mut c.code, 4167008257); arm.imm(&mut c.code, 2, 1); arm.compare_register(&mut c.code, 1, 2); arm.branch(&mut c.code, shared, 3)
            for v in c.types.declared.type_starts[ty]..c.types.declared.type_starts[ty] + c.types.declared.type_counts[ty] {
                next := arm.label(&mut c.code); arm.load(&mut c.code, 0); load_mem(&mut c, 0, 0, 0)
                arm.imm(&mut c.code, 1, c.types.field_values[v]); arm.compare_register(&mut c.code, 0, 1); arm.branch(&mut c.code, next, 3)
                for i in 0..c.types.payload_counts[v] {
                    pt := c.types.payload_types[c.types.payload_starts[v] + i]
                    if owned(&c, pt) { arm.load(&mut c.code, 0); load_mem(&mut c, 0, 0, (i + 1) * 8); drop_value(&mut c, pt) }
                }
                arm.branch(&mut c.code, shared, 0); arm.mark(&mut c.code, next)
            }
            arm.mark(&mut c.code, shared)
        } else if !c.types.c_record[ty] {
            first := c.types.declared.type_starts[ty]
            for i in 0..c.types.declared.type_counts[ty] {
                field_ty := c.types.field_types[first + i]
                if owned(&c, field_ty) { arm.load(&mut c.code, 0); load_mem(&mut c, 0, 0, i * 8); drop_value(&mut c, field_ty) }
            }
        }
        arm.load(&mut c.code, 0); arm.branch(&mut c.code, c.runtime.release, 1); arm.mark(&mut c.code, done); arm.ret(&mut c.code)
    }
    // Detached cached bodies can be the only users of a collection shape.
    // Include calls from nominal clone/drop helpers emitted above.
    var raw := false; var strings := false
    for label in c.code.target {
        delta := label - c.array_helpers
        if delta == 0 || delta == 1 { raw = true }
        if delta == 2 || delta == 3 { strings = true }
        if raw && strings { break }
    }
    if raw { collection_helpers(&mut c, c.array_helpers, false) }
    if strings { collection_helpers(&mut c, c.array_helpers + 2, true) }
}
fn collection_helpers(c: &mut Session, label: i32, strings: bool) {
    arm.mark(&mut c.code, label)
    frame := arm.prologue(&mut c.code); arm.frame(&mut c.code, frame, 0)
    arm.branch(&mut c.code, c.runtime.array_clone, 1)
    if strings { arm.branch(&mut c.code, c.runtime.retain_elements, 1) }
    arm.ret(&mut c.code)
    arm.mark(&mut c.code, label + 1)
    drop_frame := arm.prologue(&mut c.code); arm.frame(&mut c.code, drop_frame, 1)
    done := arm.label(&mut c.code); arm.branch(&mut c.code, done, 18); arm.store(&mut c.code, 0, 0)
    if strings { arm.branch(&mut c.code, c.runtime.release_elements, 1) }
    load_mem(&mut c, 0, 0, 0); arm.branch(&mut c.code, c.runtime.release, 1)
    arm.load(&mut c.code, 0); arm.branch(&mut c.code, c.runtime.release, 1)
    arm.mark(&mut c.code, done); arm.ret(&mut c.code)
}
pub fn compile(source: string) -> Result { compile_for(source, 0) }
pub fn compile_for(source: string, platform: i32) -> Result {
    none: []i32 = []
    compile_modules(source, platform, &none, &none)
}
pub fn compile_modules(source: string, platform: i32, module_starts: &[]i32, module_files: &[]i32) -> Result {
    var ignored := bindings()
    compile_mode(source, platform, &module_starts, &module_files, false, false, &mut ignored)
}
pub fn compile_mode(source: string, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings) -> Result {
    var c := new_session(); scan_into(&mut c, source); config := configuration()
    compile_loaded(&mut c, platform, &module_starts, &module_files, check_all, report, &mut records, "", "", &config)
}
pub fn compile_tokens(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings) -> Result {
    compile_cached(&mut tokens,platform,&module_starts,&module_files,check_all,report,&mut records,"","")
}
pub fn compile_cached(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string) -> Result {
    compile_configured(&mut tokens, platform, &module_starts, &module_files, check_all, report, &mut records, directory, identity, true)
}
pub fn compile_configured(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string, scalar_enabled: bool) -> Result {
    compile_profiled(&mut tokens, platform, &module_starts, &module_files, check_all, report, &mut records, directory, identity, scalar_enabled, -1, false)
}
pub fn compile_profiled(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string, scalar_enabled: bool, profile_host: i32, instrument_runtime: bool) -> Result {
    var config := configuration()
    config.scalar_enabled = scalar_enabled; config.profile_host = profile_host; config.instrument_runtime = instrument_runtime
    compile_options(&mut tokens, platform, &module_starts, &module_files, check_all, report, &mut records, directory, identity, &config)
}
// Empty construction copies no populated compiler/source/function arena.
// Existing typed-parser arenas remain explicit independent roots in this API.
pub fn new_session() -> Session {
    config := configuration()
    var code := arm.new(); rt := runtime.new(&mut code); array_take := arm.label(&mut code)
    report := false; uses_float := false
    scalar_enabled := true; check_all := false
    Session {
        world: new_world(), body: new_body(), validation_spellings: [], validation_tokens: [], worker_kinds: [],
        jobs: cs.new_job_log(),
        tasks: tc.new_graph(),
        types: ft.new_registry(), helper_labels: [], array_helpers: -1,
        ok: true, error: "", error_at: 0,
        validating_dead: false, validated_through: -1, report: report, bindings: bindings(),
        wasm_abi: wa.new(), imports: imports(), callback_labels: [], has_callbacks: false,
        code: code, runtime: rt, needed: [], loans: scratch.loans(),
        fn_labels: [],
        array_take: array_take, record_take_labels: [],
        mir_opt_enabled: config.mir_opt_enabled, mir_memory_enabled: config.mir_memory_enabled, mir_ssa_enabled: config.mir_ssa_enabled, mir_values_enabled: config.mir_values_enabled, scalar_enabled: scalar_enabled, ownership_enabled: config.ownership_enabled, range_enabled: config.range_enabled, inline_enabled: config.inline_enabled && scalar_enabled && !check_all, scalar_templates: opt_templates.new(),
        strings: [], string_labels: [], print_int: 0, print_bool: 0, print_text: 0, write: 0, float_source: uses_float, float_trap: 0, overflow: 0, zero: 0, assertion: 0, io: 0, bounds: 0,
    }
}
// The CLI loads normalized module tokens directly into the declaration world.
// File maps stay with the caller for diagnostics and publication.
pub fn load_group_into(c: &mut Session, path: string, testing: bool, group: i32, wasm_suite: bool) -> modules.Loaded {
    modules.load_group(path, testing, !testing, group, wasm_suite, &mut c.world.tokens)
}
pub fn freeze_validation_world(c: &Session, declarations: &[]i32) -> frozen.World {
    var s := frozen.spellings(); var index := map.new()
    names := frozen.intern_list(&mut s, &mut index, &c.world.names)
    parameter_names := frozen.intern_list(&mut s, &mut index, &c.world.param_names)
    libraries := frozen.intern_list(&mut s, &mut index, &c.world.libraries)
    symbols := frozen.intern_list(&mut s, &mut index, &c.world.symbols)
    types := frozen.pack_types(&mut s, &mut index, &c.types)
    tokens := frozen.pack_bodies(&mut s, &mut index, &declarations, &c.world.tokens, &c.world.starts, &c.world.ends, &c.world.closes)
    var offsets: []i32 = []; offsets.reserve(c.world.param_tokens.len)
    for at in c.world.param_tokens { offsets.push(c.world.tokens.starts[at]) }
    frozen.World { spellings: s, tokens: tokens, types: types, names: names, parameter_names: parameter_names,
        libraries: libraries, symbols: symbols, returns: c.world.returns, param_starts: c.world.param_starts,
        param_counts: c.world.param_counts, param_types: c.world.param_types, param_tokens: c.world.param_tokens,
        param_offsets: offsets, unsafe_functions: c.world.unsafe_functions, test_functions: c.world.test_functions,
        function_owners: c.world.function_owners, ffi_types: c.world.ffi_types, source_end: c.world.source_end,
        unsafe_capable: c.world.unsafe_capable, tasks: c.tasks.program, loans: c.loans.active, report: c.report,
        globals: c.jobs.globals, fn_labels: c.fn_labels, spawners: c.tasks.spawners }
}
pub fn hydrate_validation_worker(c: &mut Session, src: &frozen.World) {
    var cache: []string = []; cache.reserve(src.spellings.starts.len - 1)
    for i in 0..src.spellings.starts.len - 1 { cache.push("") }
    c.world.names = frozen.read_list(&src.spellings, &mut cache, &src.names)
    c.world.param_names = frozen.read_list(&src.spellings, &mut cache, &src.parameter_names)
    c.world.libraries = frozen.read_list(&src.spellings, &mut cache, &src.libraries)
    c.world.symbols = frozen.read_list(&src.spellings, &mut cache, &src.symbols)
    frozen.unpack_types(&src.spellings, &mut cache, &src.types, &mut c.types)
    c.validation_spellings = cache
    map.reserve(&mut c.world.functions, src.names.len)
    for f in 0..src.names.len {
        map.put(&mut c.world.functions, c.world.names[f], i64(f))
        c.world.starts.push(0); c.world.ends.push(0)
    }
    c.world.returns = src.returns; c.world.param_starts = src.param_starts; c.world.param_counts = src.param_counts
    c.world.param_types = src.param_types; c.world.param_tokens = src.param_tokens
    c.world.function_owners = src.function_owners; c.world.ffi_types = src.ffi_types
    c.world.unsafe_functions = src.unsafe_functions; c.world.test_functions = src.test_functions
    c.world.unsafe_capable = src.unsafe_capable; c.world.source_end = src.source_end
    c.tasks.program = src.tasks; c.tasks.spawners = src.spawners; c.loans.active = src.loans
    c.fn_labels = src.fn_labels; c.jobs.globals = src.globals; c.code.checking = true
    c.code.platform = 0; c.code.virtual_labels = src.globals; c.validating_dead = true
    c.scalar_enabled = false; c.inline_enabled = false; c.report = src.report
}
pub fn load_validation_body(c: &mut Session, src: &frozen.World, f: i32) {
    load_lexical_span(&mut c, &src, f, &src.tokens, f, &src.spellings, false)
}
pub struct SourceJob { declaration: i32, project: bool, spellings: frozen.Spellings, tokens: frozen.Tokens }
pub fn source_job(c: &Session, f: i32) -> SourceJob {
    var spellings := frozen.spellings(); var names := map.new()
    starts: []i32 = [c.world.starts[f]]; ends: []i32 = [c.world.ends[f]]; ids: []i32 = [0]
    tokens := frozen.pack_bodies(&mut spellings, &mut names, &ids, &c.world.tokens, &starts, &ends, &c.world.closes)
    SourceJob { declaration: f, project: c.worker_kinds[f] == 1, spellings: spellings, tokens: tokens }
}
pub fn load_job(c: &mut Session, src: &frozen.World, job: &SourceJob) {
    load_lexical_span(&mut c, &src, job.declaration, &job.tokens, 0, &job.spellings, true)
}
fn load_lexical_span(c: &mut Session, src: &frozen.World, f: i32, tokens: &frozen.Tokens, slot: i32,
    spellings: &frozen.Spellings, local: bool) {
    c.world.tokens.texts.clear(); c.world.tokens.kinds.clear(); c.world.tokens.starts.clear()
    c.validation_tokens.clear(); c.world.closes.clear()
    first := src.param_starts[f]
    for p in first..first + src.param_counts[f] {
        c.world.param_tokens[p] = c.validation_tokens.len; c.validation_tokens.push(src.param_tokens[p])
        c.world.tokens.texts.push(c.world.param_names[p]); c.world.tokens.starts.push(src.param_offsets[p])
        c.world.tokens.kinds.push(.Name); c.world.closes.push(-1)
    }
    var local_names: []string = []
    if local { for i in 0..spellings.starts.len - 1 { local_names.push("") } }
    base := c.validation_tokens.len; start := tokens.starts[slot]
    c.world.starts[f] = base + 1
    for i in start..tokens.ends[slot] {
        id := tokens.words[i]
        var word := ""
        if local { word = frozen.read(&spellings, &mut local_names, id) }
        else { word = frozen.read(&spellings, &mut c.validation_spellings, id) }
        c.world.tokens.texts.push(word); c.world.tokens.kinds.push(tokens.kinds[i]); c.world.tokens.starts.push(tokens.positions[i])
        var close := tokens.closes[i]; if close >= 0 { close = close + base }
        c.world.closes.push(close); c.validation_tokens.push(tokens.origins[slot] + i - start)
    }
    c.world.ends[f] = c.validation_tokens.len - 1
    c.world.tokens.texts.push(""); c.world.tokens.kinds.push(.End); c.world.tokens.starts.push(tokens.following_positions[slot])
    c.world.closes.push(-1); c.validation_tokens.push(tokens.origins[slot] + tokens.ends[slot] - start)
}
pub fn validation_token(c: &Session, local: i32) -> i32 {
    if local < 0 { return local }; c.validation_tokens[local]
}
pub fn scan_into(c: &mut Session, source: string) { lexer.scan_into(source, &mut c.world.tokens) }
// record_takes is this Session's exclusive external plan from begin through
// finish; callers must neither reset it nor lend it to another active Session.
pub fn begin_into(c: &mut Session, tokens: &mut lexer.Tokens, platform: i32,
    module_starts: &[]i32, module_files: &[]i32, report: bool, directory: string, identity: string,
    config: &Configuration, scalar_model: &mut opt_ir.Function, scalar_work: &mut opt_verify.Workspace,
    range_work: &mut opt_range.Workspace, catalog: &mut opt_inline.Catalog,
    inline_work: &mut opt_inline.Workspace, emit_settings: &mut opt_emit.Options, record_takes: &mut record_take.Plan) -> bool {
    if c.jobs.phase != 0 { return false }
    c.world.tokens = tokens
    begin_loaded(&mut c, platform, &module_starts, &module_files, false, report, directory, identity,
        &config, &mut scalar_model, &mut scalar_work, &mut range_work, &mut catalog, &mut inline_work, &mut emit_settings, &mut record_takes)
}
pub fn begin_linker(c: &Session, link: &mut mir_link.Linker) -> bool {
    if !c.ok || c.jobs.phase != 1 || c.jobs.checking || c.jobs.declarations.len != 0 { return false }
    mir_link.begin(&mut link, &c.code, &c.imports.sites)
}
fn session_fail_at(c: &mut Session, message: string, offset: i32) -> bool {
    c.ok = false; c.error = message; c.error_at = offset; c.jobs.phase = -1; false
}
pub fn session_error(c: &Session) -> Result { Result { ok: false, error: c.error, offset: c.error_at, text: [], imports: imports() } }
pub fn current_ordinal(c: &Session) -> i32 { c.jobs.declarations.len - 1 }
pub fn current_declaration(c: &Session) -> i32 { if c.jobs.declarations.len == 0 { return -1 }; c.jobs.declarations[c.jobs.declarations.len - 1] }
pub fn current_source_offset(c: &Session) -> i32 { f := current_declaration(&c); if f < 0 { return 0 }; c.world.tokens.starts[c.world.starts[f]] }
pub fn source_done(c: &Session) -> bool { c.jobs.phase == 2 }
pub fn pipeline_options_into(c: &Session, options: &mut mir_pipeline.Options) {
    options.optimize = c.mir_opt_enabled; options.source_objects = c.mir_memory_enabled; options.ssa = c.mir_ssa_enabled; options.values = c.mir_values_enabled
    // Complete source emission obeys the language call ABI independently of
    // whether the caller selected the stronger source-object memory policy.
    options.source_abi = true
    // Separate complete-source premise about semantic call inputs and their
    // continuations; this never changes canonical raw call masks or clobbers.
    options.source_inputs = true
    // Positive Temp origins may elide only private implementation storage.
    // Outgoing arguments and bridge saves retain raw origins and accesses.
    options.source_temporaries = true
    options.frame_budget = 4194304; options.ssa_budget = 4194304; options.value_budget = 4194304
}
pub fn terminals_into(c: &Session, terminals: &mut mir_pipeline.Terminals) {
    terminals.version = 1; terminals.overflow = c.overflow; terminals.zero = c.zero
    terminals.assertion = c.assertion; terminals.io = c.io; terminals.bounds = c.bounds; terminals.float_trap = c.float_trap
}
pub fn begin_loaded(c: &mut Session, platform: i32, module_starts: &[]i32, module_files: &[]i32,
    check_all: bool, report: bool, directory: string, identity: string, config: &Configuration,
    scalar_model: &mut opt_ir.Function,
    scalar_work: &mut opt_verify.Workspace, range_work: &mut opt_range.Workspace,
    catalog: &mut opt_inline.Catalog, inline_work: &mut opt_inline.Workspace, emit_settings: &mut opt_emit.Options, record_takes: &mut record_take.Plan) -> bool {
    if c.jobs.phase != 0 { return false }
    scalar_enabled := config.scalar_enabled; profile_host := config.profile_host; instrument_runtime := config.instrument_runtime
    if profile_host > 2 { return session_fail_at(&mut c, "compiler profiling requires a native host", 0) }
    if instrument_runtime && platform == 3 && !check_all { return session_fail_at(&mut c, "runtime profiling requires a native target", 0) }
    var declarations_started: i64 = -1
    if profile_host >= 0 { declarations_started = profile.clock(profile_host) }
    source_end := c.world.tokens.starts[c.world.tokens.starts.len - 1]
    // Tokenize the formatter only for programs that mention floating values.
    var uses_float := false
    for i in 0..c.world.tokens.kinds.len {
        if c.world.tokens.kinds[i] == .Float || (c.world.tokens.kinds[i] == .Name && (c.world.tokens.texts[i] == "f32" || c.world.tokens.texts[i] == "f64")) { uses_float = true; break }
    }
    if uses_float && c.world.tokens.ok {
        fragment := lexer.scan("\n" + bundled.float_formatter(), false)
        // Replace EOF with a separator and append tokens without lexing the
        // user's original modules again. The loader reserves the runtime name.
        last := c.world.tokens.kinds.len - 1
        c.world.tokens.kinds[last] = .Newline; c.world.tokens.texts[last] = "\n"
        for i in 0..fragment.kinds.len {
            var value := fragment.texts[i]
            if value == "format_float_bits" { value = "__dunder_module_format_float_bits" }
            c.world.tokens.kinds.push(fragment.kinds[i]); c.world.tokens.texts.push(value)
            c.world.tokens.starts.push(source_end + 1 + fragment.starts[i])
        }
    }
    if !c.world.tokens.ok { return session_fail_at(&mut c, c.world.tokens.error, c.world.tokens.error_at) }
    var code := arm.new_for(platform)
    if check_all { code = arm.new_check(platform) }
    code.profile = instrument_runtime && !check_all
    rt := runtime.new(&mut code)
    array_take := arm.label(&mut code)
    c.code = code; c.runtime = rt; c.array_take = array_take
    c.report = report; c.world.source_end = source_end; c.float_source = uses_float
    c.scalar_enabled = scalar_enabled; c.ownership_enabled = config.ownership_enabled
    c.range_enabled = config.range_enabled; c.inline_enabled = config.inline_enabled && scalar_enabled && !check_all
    c.mir_opt_enabled = config.mir_opt_enabled
    c.mir_memory_enabled = config.mir_memory_enabled; c.mir_ssa_enabled = config.mir_ssa_enabled; c.mir_values_enabled = config.mir_values_enabled

    c.bindings.mir_optimization_enabled = config.mir_opt_enabled && !check_all
    c.bindings.mir_source_objects_enabled = c.bindings.mir_optimization_enabled && config.mir_memory_enabled
    c.bindings.mir_ssa_enabled = c.bindings.mir_optimization_enabled && config.mir_ssa_enabled
    c.bindings.mir_values_enabled = c.bindings.mir_optimization_enabled && config.mir_values_enabled
    if profile_host >= 0 { c.bindings.profile = profile.new(profile_host) }
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr", "range"] { added := add_type(&mut c, name, 0, 0) }
    for i in 0..c.world.tokens.kinds.len {
        c.world.closes.push(-1)
        if c.world.tokens.kinds[i] == .Name && c.world.tokens.texts[i] == "task" && c.world.tokens.texts[i + 1] == "scope" { c.tasks.program = true }
        if c.world.tokens.kinds[i] == .Name && c.world.tokens.texts[i] == "region" && c.world.tokens.kinds[i + 1] == .Name { c.loans.active = true }
        if c.world.tokens.kinds[i] == .Name && c.world.tokens.texts[i] == "callback" { c.has_callbacks = true }
    }
    headers(&mut c, &module_starts, &module_files)
    if c.tasks.program {
        for f in 0..c.world.names.len { tc.add_function(&mut c.tasks, c.world.libraries[f] != "") }
    }
    for t in 0..c.types.type_names.len { if c.types.c_record[t] { c_layout(&mut c, t) } }
    validate_layouts(&mut c)
    if c.loans.active { scratch.prepare(&mut c.loans, c.world.param_types.len, c.world.names.len) }
    // Forward record declarations acquire their field types during headers().
    // Check all foreign signatures once the layout of every record is known.
    for sig in 0..c.types.declared.type_kinds.len {
        if c.types.declared.type_kinds[sig] == 8 {
            ret := c.types.declared.type_bases[sig]
            if c.types.c_record[ret] && hfa(&c, ret, 0) == 0 { fail(&mut c, "pass non-homogeneous C records by pointer") }
            for i in c.types.declared.type_starts[sig]..c.types.declared.type_starts[sig] + c.types.declared.type_counts[sig] {
                ty := c.types.declared.ffi_params[i]
                if c.types.c_record[ty] && hfa(&c, ty, 0) == 0 { fail(&mut c, "pass non-homogeneous C records by pointer") }
            }
        }
    }
    entry := map.get_or(&c.world.functions, "main", -1)
    if entry < 0 { fail(&mut c, "program needs main") }
    if !c.ok { return session_fail_at(&mut c, c.error, c.error_at) }
    main_id := i32(entry)
    ft.seal(&mut c.types, platform); check_type_error(&mut c)
    if c.world.param_counts[main_id] != 0 || (c.world.returns[main_id] != 0 && c.world.returns[main_id] != 1) { fail(&mut c, "main must take no arguments and return i32 or ()") }
    for f in 0..c.world.names.len {
        label := arm.label(&mut c.code)
        c.fn_labels.push(label); c.needed.push(false)
    }
    bind_type_helpers(&mut c)
    c.print_int = arm.label(&mut c.code); c.print_bool = arm.label(&mut c.code); c.print_text = arm.label(&mut c.code); c.write = arm.label(&mut c.code)
    c.float_trap = arm.label(&mut c.code)
    c.overflow = arm.label(&mut c.code); c.zero = arm.label(&mut c.code); c.assertion = arm.label(&mut c.code); c.io = arm.label(&mut c.code); c.bounds = arm.label(&mut c.code)
    // The runtime owns x19/x20 (arena), x23/x24 (process arguments).
    arm.imm(&mut c.code, 19, 0); arm.imm(&mut c.code, 20, 0)
    if platform != 0 { arm.emit(&mut c.code, 4181722103); arm.emit(&mut c.code, 2432705528) }
    else { arm.mov(&mut c.code, 23, 0); arm.mov(&mut c.code, 24, 1) }
    runtime.emit_profile_start(&mut c.code, &rt)
    arm.branch(&mut c.code, c.fn_labels[main_id], 1)
    runtime.emit_profile_report(&mut c.code, &rt)
    arm.syscall(&mut c.code, 33554433, 94); arm.emit(&mut c.code, 3558866944)
    c.needed[main_id] = true
    for f in 0..c.world.names.len { c.jobs.compiled.push(false); c.jobs.checked_effects.push(-1); c.callback_labels.push(-1) }
    if c.tasks.program && !check_all {
        c.tasks.open = arm.label(&mut c.code)
        c.tasks.await_result = arm.label(&mut c.code)
        c.tasks.close = arm.label(&mut c.code)
        for f in 0..c.world.names.len {
            count := c.world.param_counts[f]
            if (count >= 1 && count <= 3) && c.world.libraries[f] == "" && !c.world.unsafe_functions[f] {
                spawner := arm.label(&mut c.code); c.tasks.spawners[f] = spawner
            }
        }
    }
    if !c.ok { return session_fail_at(&mut c, c.error, c.error_at) }
    // Nominal record fields are sealed now. Later compound/callable type rows
    // cannot change these layouts. Reserve helper IDs in the global namespace;
    // emit only demanded bodies after all source MIR/cached fragments finish.
    // Check-only has no backend plan/labels. A bounded optimization refusal is
    // ordinary copying, never a refusal of an otherwise valid source program.
    if !check_all {
        prepared := record_take.prepare(&mut record_takes, &c.types.declared.type_kinds, &c.types.declared.type_bases, &c.types.declared.type_starts,
            &c.types.declared.type_counts, &c.types.field_types, &c.types.c_record)
        if !prepared && record_take.status(&record_takes) != -2 {
            return session_fail_at(&mut c, "internal record-take metadata failure", 0)
        }
        if prepared && !record_take.reserve(&mut c.code, &mut record_takes) {
            return session_fail_at(&mut c, "internal record-take reservation failure", 0)
        }
        // Primitive selection only: the external Plan is the sole demand and
        // helper-emission authority. No Plan/Schema arena is copied into Session.
        for ty in 0..c.types.declared.type_kinds.len {
            var selected := -2
            if c.types.declared.type_kinds[ty] == 2 && record_take.eligible(&record_takes, ty) {
                selected = -1
                if record_take.needs_helper(&record_takes, ty) { selected = record_take.helper_label(&record_takes, ty) }
            }
            c.record_take_labels.push(selected)
        }
    }
    globals := arm.label_count(&c.code)
    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 0, declarations_started, i64(c.world.names.len)) }
    emit_settings.const_div_enabled = config.const_div_enabled; emit_settings.frame_free_enabled = config.frame_free_enabled
    if c.inline_enabled {
        opt_inline.configure(&mut inline_work, config.const_div_enabled, config.frame_free_enabled)
        inline_catalog(&mut c, &mut catalog, &mut scalar_model, &mut scalar_work, &mut range_work, directory != "" && identity != "" && platform != 3)
        if !c.ok { return session_fail_at(&mut c, c.error, c.error_at) }
    }
    var cache := ""
    if !c.tasks.program && !check_all && platform != 3 && directory != "" && (!c.inline_enabled || opt_inline.digest_ready(&catalog)) {
        var policy := identity
        if policy != "" {
            if scalar_enabled { policy = policy + ":scalar:on" } else { policy = policy + ":scalar:off" }
            if config.ownership_enabled { policy = policy + ":ownership4:on" } else { policy = policy + ":ownership4:off" }
            policy = policy + ":" + record_take.policy_tag()
            if config.const_div_enabled { policy = policy + ":const-div:on" } else { policy = policy + ":const-div:off" }
            if config.frame_free_enabled { policy = policy + ":frame-free:on" } else { policy = policy + ":frame-free:off" }
            if config.range_enabled { policy = policy + ":range:on" } else { policy = policy + ":range:off" }
            if c.inline_enabled { policy = policy + ":inline-expression-v3:dependencies1:tokens128-32768:caller4096:utf8-v1-staging48:" + opt_inline.fingerprint(&catalog) } else { policy = policy + ":inline:off" }
            policy = policy + ":typed-function-v1"
            if config.mir_opt_enabled { policy = policy + ":mir-opt:on" } else { policy = policy + ":mir-opt:off" }
            policy = policy + ":" + mir_memory.source_policy_tag(config.mir_memory_enabled)
            if config.mir_ssa_enabled { policy = policy + ":mir-ssa:v3-regional-expression1-work4194304" } else { policy = policy + ":mir-ssa:off" }
            if config.mir_values_enabled { policy = policy + ":mir-values:v4-certified-compact-terminal1-work4194304" } else { policy = policy + ":mir-values:off" }
            if instrument_runtime { policy = policy + ":runtime:profile" } else { policy = policy + ":runtime:plain" }
        }
        var started: i64 = -1
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        cache = fragments.context(&c.world.tokens,&c.world.starts,&c.world.ends,&c.world.function_owners,&c.types.opaque_owner,platform,globals,c.has_callbacks,policy)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 8, started, 1) }
    }
    c.jobs.globals = globals; c.jobs.main_id = main_id; c.jobs.platform = platform
    c.jobs.checking = check_all; c.jobs.instrument_runtime = instrument_runtime
    c.jobs.directory = directory; c.jobs.cache = cache
    c.jobs.phase = 1
    true
}
pub fn compile_options(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string, config: &Configuration) -> Result {
    var c := new_session()
    c.world.tokens = tokens
    compile_loaded(&mut c, platform, &module_starts, &module_files, check_all, report, &mut records, directory, identity, &config)
}
pub fn compile_loaded(c: &mut Session, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string, config: &Configuration) -> Result {
    var record_takes := record_take.new(); var scalar_model := opt_ir.new(); var scalar_work := opt_verify.new()
    var scalar_plan := opt_alloc.new(); var range_work := opt_range.new()
    var emit_settings := opt_emit.options(); var catalog := opt_inline.new(); var inline_work := opt_inline.workspace()
    if !begin_loaded(&mut c, platform, &module_starts, &module_files, check_all, report, directory, identity, &config,
        &mut scalar_model, &mut scalar_work, &mut range_work, &mut catalog, &mut inline_work, &mut emit_settings, &mut record_takes) { return session_error(&c) }
    view := opt_inline.emission_view(&catalog)
    if check_all {
        check_sources(&mut c, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings, &mut range_work, &view, &mut inline_work)
        return session_tail(&mut c, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings, &mut range_work, &view, &mut inline_work, &mut records, &mut record_takes)
    }
    var function := mir.new(); var object := mir_lower.new_object(); var lifter := mir_lift.new_work(); var batch := mir_source.new(); var link := mir_link.new()
    var restored := fragments.new_dependencies(); var options := mir_pipeline.options(); var exits := mir_pipeline.no_terminals()
    pipeline_options_into(&c, &mut options); terminals_into(&c, &mut exits)
    if !begin_linker(&c, &mut link) { failed := session_fail_at(&mut c, "internal session prefix failure", 0); return session_error(&c) }
    if options.ssa {
        var backend := mir_pipeline.new()
        while c.ok {
            step := next_into(&mut c, &mut function, &mut object, &mut lifter, &mut batch, &mut scalar_model, &mut scalar_work,
                &mut scalar_plan, &emit_settings, &mut range_work, &view, &mut inline_work, &mut restored)
            if step <= 0 { break }
            var status := mir_pipeline.Status { error: 0, frame_state: 0, value_state: 0, stats: mir_pipeline.stats() }
            if step == 1 {
                status = mir_pipeline.run_into(&mut function, &mut backend, &options, &exits)
                if status.error == 0 && !mir_lower.lower_into(&mut object, &function) { status.error = 7 }
            }
            ordinal := current_ordinal(&c)
            if !accept_into(&mut c, &mut link, ordinal, &object, &status) { break }
        }
    } else {
        var core := mir_pipeline.new_core()
        while c.ok {
            step := next_into(&mut c, &mut function, &mut object, &mut lifter, &mut batch, &mut scalar_model, &mut scalar_work,
                &mut scalar_plan, &emit_settings, &mut range_work, &view, &mut inline_work, &mut restored)
            if step <= 0 { break }
            var status := mir_pipeline.Status { error: 0, frame_state: 0, value_state: 0, stats: mir_pipeline.stats() }
            if step == 1 {
                status = mir_pipeline.run_core_into(&mut function, &mut core, &options, &exits)
                if status.error == 0 && !mir_lower.lower_into(&mut object, &function) { status.error = 7 }
            }
            ordinal := current_ordinal(&c)
            if !accept_into(&mut c, &mut link, ordinal, &object, &status) { break }
        }
    }
    finish(&mut c, &mut link, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings,
        &mut range_work, &view, &mut inline_work, &mut records, &mut record_takes)
}

// Only dead declarations enter this path. Reachability has been closed and no
// machine output is retained. All diagnostic precedence follows declaration order.
pub struct Validation { declaration: i32, at: i32, error: []u8, effects: i64, first_task: i32, observations: []i32 }

// Target and runtime symbols are fixed once for the whole compilation.
// Workers allocate private labels above this immutable prefix.
pub struct BackendBindings {
    runtime: runtime.Runtime, platform: i32, globals: i32, instrumented: bool, helper_labels: []i32, record_take_labels: []i32,
    array_helpers: i32, array_take: i32, print_int: i32, print_bool: i32,
    print_text: i32, write: i32, float_trap: i32, overflow: i32,
    zero: i32, assertion: i32, io: i32, bounds: i32,
    open: i32, close: i32, await_result: i32,
    float_source: bool, has_callbacks: bool, ownership_enabled: bool, inline_enabled: bool,
}
pub fn freeze_backend(c: &Session) -> BackendBindings {
    BackendBindings { runtime: c.runtime, platform: c.jobs.platform, globals: c.jobs.globals, instrumented: c.code.profile,
        helper_labels: c.helper_labels, record_take_labels: c.record_take_labels,
        array_helpers: c.array_helpers, array_take: c.array_take, print_int: c.print_int,
        print_bool: c.print_bool, print_text: c.print_text, write: c.write,
        float_trap: c.float_trap, overflow: c.overflow, zero: c.zero,
        assertion: c.assertion, io: c.io, bounds: c.bounds,
        open: c.tasks.open, close: c.tasks.close, await_result: c.tasks.await_result,
        float_source: c.float_source, has_callbacks: c.has_callbacks, ownership_enabled: c.ownership_enabled,
        inline_enabled: c.inline_enabled,
    }
}
pub fn prepare_emitter(c: &mut Session, bindings: &BackendBindings) {
    c.runtime = bindings.runtime; c.code.platform = bindings.platform; c.code.profile = bindings.instrumented; c.code.checking = false
    c.validating_dead = false; c.helper_labels = bindings.helper_labels
    c.record_take_labels = bindings.record_take_labels; c.code.labels.clear()
    for i in 0..bindings.globals { c.code.labels.push(-1) }
    c.array_helpers = bindings.array_helpers; c.array_take = bindings.array_take
    c.print_int = bindings.print_int; c.print_bool = bindings.print_bool
    c.print_text = bindings.print_text; c.write = bindings.write
    c.float_trap = bindings.float_trap; c.overflow = bindings.overflow
    c.zero = bindings.zero; c.assertion = bindings.assertion
    c.io = bindings.io; c.bounds = bindings.bounds
    c.tasks.open = bindings.open; c.tasks.close = bindings.close
    c.tasks.await_result = bindings.await_result
    c.float_source = bindings.float_source; c.has_callbacks = bindings.has_callbacks
    c.ownership_enabled = bindings.ownership_enabled; c.inline_enabled = bindings.inline_enabled
}
pub struct EmittedBody {
    declaration: i32, at: i32, error: []u8,
    words: []i64, labels: []i32, at_words: []i32, targets: []i32, reloc_kinds: []i32,
    facts: facts.Facts, types: []i32, places: places.Arena, dependencies: fragments.Dependencies,
    inlined_calls: i32, inlined_words: i32, estimated_words: i32,
}
pub fn empty_emission() -> EmittedBody {
    EmittedBody { declaration: -1, at: 0, error: [], words: [], labels: [], at_words: [], targets: [],
        reloc_kinds: [], facts: facts.new(), types: [], places: places.new(), dependencies: fragments.new_dependencies(),
        inlined_calls: 0, inlined_words: 0, estimated_words: 0 }
}
pub fn can_emit_general(c: &mut Session, f: i32) -> bool { !scalar_signature(&mut c, f) }
fn restore_tokens(c: &Session, tokens: &mut []i32) {
    for i in 0..tokens.len { tokens[i] = validation_token(&c, tokens[i]) }
}
pub fn emit_isolated(c: &mut Session, f: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace) -> EmittedBody {
    var model := opt_ir.new()
    emit_isolated_into(&mut c, f, &catalog, &mut inline_work, &mut model, false)
}
pub fn emit_isolated_into(c: &mut Session, f: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace,
    model: &mut opt_ir.Function, project: bool) -> EmittedBody {
    var out := empty_emission(); out.declaration = f
    c.ok = true; c.error = ""; c.error_at = 0; c.types.error = ""
    ft.reset_body(&mut c.types); facts.reset(&mut c.body.facts, 0)
    c.code.words.clear(); c.code.at.clear(); c.code.target.clear(); c.code.kinds.clear()
    assert(c.code.labels.len == c.jobs.globals)
    c.body.reenter_owners = false; c.body.scalar_function = false
    if c.tasks.program && c.world.unsafe_functions[f] { task_effect(&mut c, 16) }
    c.bindings.inlined_calls = 0; c.bindings.inlined_words = 0; c.bindings.inline_estimated_words = 0
    arm.begin_mir(&mut c.code, true)
    model.recording = false; model.probing = false; model.supported = false
    if project { begin_projection(&mut c, f, &mut model) }
    type_body(&mut c, f, &mut model, &catalog, &mut inline_work)
    if project && finish_projection(&mut c, &mut model) {
        restore_tokens(&c, &mut model.nodes.starts); restore_tokens(&c, &mut model.local_at)
    }
    arm.end_mir(&mut c.code)
    if !c.ok { out.at = c.error_at; validation_bytes.append_utf8(&mut out.error, c.error) }
    out.facts = c.body.facts
    restore_tokens(&c, &mut out.facts.tokens); restore_tokens(&c, &mut out.facts.worker_tokens)
    restore_tokens(&c, &mut out.facts.factory_tokens); restore_tokens(&c, &mut out.facts.shared_tokens)
    restore_tokens(&c, &mut out.facts.literal_tokens); restore_tokens(&c, &mut out.facts.binding_tokens)
    if out.facts.first_task >= 0 { out.facts.first_task = validation_token(&c, out.facts.first_task) }
    capture_source_types(&c, &mut out.types)
    if !model.supported { out.places = c.body.places.arena }
    out.dependencies = c.body.inline_deps; out.inlined_calls = c.bindings.inlined_calls
    out.inlined_words = c.bindings.inlined_words; out.estimated_words = c.bindings.inline_estimated_words
    out.words = c.code.words; out.at_words = c.code.at; out.targets = c.code.target; out.reloc_kinds = c.code.kinds
    for label in c.jobs.globals..c.code.labels.len { out.labels.push(c.code.labels[label]) }
    while c.code.labels.len > c.jobs.globals { _ := c.code.labels.pop() }
    c.code.labels[c.fn_labels[f]] = -1
    out
}
// Rebase worker-local symbols into the linker's declaration-order namespace.
// Word coordinates start at zero in both source arenas. Published external
// labels keep their identity, regardless of the worker that emitted the body.
pub fn install_emitted(c: &mut Session, f: i32, out: &EmittedBody) -> bool {
    if out.declaration != f || c.code.words.len != 0 || !c.ok { return false }
    delta := c.code.labels.len - c.jobs.globals
    assert(delta >= 0 && c.code.labels[c.fn_labels[f]] == -1)
    c.code.labels[c.fn_labels[f]] = 0
    for label in out.labels { c.code.labels.push(label) }
    c.code.words = out.words; c.code.at = out.at_words; c.code.kinds = out.reloc_kinds
    c.code.target.clear(); c.code.target.reserve(out.targets.len)
    for label in out.targets {
        var target := label; if target >= c.jobs.globals { target = target + delta }
        c.code.target.push(target)
    }
    c.body.facts = out.facts
    for i in 0..c.body.facts.literal_labels.len { c.body.facts.literal_labels[i] = c.body.facts.literal_labels[i] + delta }
    ft.restore_shapes(&mut c.types, &out.types); c.body.places.arena = out.places
    c.body.scalar_function = false; c.body.inline_deps = out.dependencies
    c.bindings.inlined_calls = c.bindings.inlined_calls + out.inlined_calls
    c.bindings.inlined_words = c.bindings.inlined_words + out.inlined_words
    c.bindings.inline_estimated_words = c.bindings.inline_estimated_words + out.estimated_words
    if out.error.len > 0 { message := validation_bytes.decode(&out.error); c.ok = false; c.error = message.value; c.error_at = out.at }
    if c.body.facts.sites.len > 0 { bind_symbols(&mut c) }
    if c.ok { accept_facts(&mut c, f) }
    c.ok
}

pub struct FrontendBody {
    source: EmittedBody, project: bool, supported: bool, first: bool, root: i32, result: i32, params: i32,
    nodes: opt_ir.Nodes, locals: []i32, types: []i32, mutable: []bool, parameters: []i32,
}
pub fn empty_frontend() -> FrontendBody {
    FrontendBody { source: empty_emission(), project: false, supported: false, first: false, root: -1, result: 0,
        params: 0, nodes: opt_ir.new_nodes(), locals: [], types: [], mutable: [], parameters: [] }
}
pub fn enable_frontend(c: &mut Session) -> bool {
    if c.jobs.cache != "" || c.report || c.world.names.len < 2 { return false }
    c.worker_kinds.reserve(c.world.names.len)
    for f in 0..c.world.names.len { c.worker_kinds.push(0) }
    true
}
fn source_candidate(c: &mut Session, f: i32, catalog: &opt_inline.View) -> i32 {
    if c.worker_kinds[f] != 0 { return c.worker_kinds[f] }
    var kind := -1
    if opt_inline.find_view(&catalog, f) < 0 {
        kind = 2
        if scalar_signature(&mut c, f) {
            kind = 1
            if !c.tasks.program && opt_templates.probe(&c.scalar_templates, &c.world.tokens, c.world.starts[f] - 1,
                c.world.ends[f], &c.body.scalar_names, &c.body.scalar_types, &c.body.scalar_tokens, c.world.returns[f]) == .Reused { kind = -1 }
        }
    }
    c.worker_kinds[f] = kind; kind
}
pub fn next_frontend(c: &Session) -> i32 {
    if c.worker_kinds.len == 0 || c.jobs.phase != 1 { return -1 }
    var scan := c.jobs.scan; var can_wrap := c.jobs.more
    while true {
        if scan == c.world.names.len {
            if !can_wrap { return -1 }; scan = 0; can_wrap = false
        }
        f := scan; scan = scan + 1
        if c.needed[f] && !c.jobs.compiled[f] && c.world.libraries[f] == "" { return f }
    }
    -1
}
pub fn observe_jobs(c: &mut Session, outstanding: i32, capacity: i32, source_window: bool) {
    if source_window { c.bindings.source_windows = c.bindings.source_windows + 1 }
    assert(outstanding <= capacity)
    if outstanding > c.bindings.peak_jobs { c.bindings.peak_jobs = outstanding }
}
pub fn frontend_window(c: &mut Session, catalog: &opt_inline.View, first: i32, capacity: i32, coordinator: bool, ids: &mut []i32) {
    ids.clear()
    if capacity <= 0 || first < 0 || source_candidate(&mut c, first, &catalog) < 0 { return }
    // Bound speculative scanning for long call chains with one reachable successor.
    var end := first + 32 + capacity * 8; if end > c.world.names.len { end = c.world.names.len }
    var previous := -1; var next := first
    if coordinator {
        // While the workers check ready siblings, the coordinator checks the
        // first declaration using its existing function arena and native inputs.
        next = first + 1; if c.worker_kinds[first] == 1 { previous = first }
    }
    for f in next..end {
        if !c.needed[f] || c.jobs.compiled[f] || c.world.libraries[f] != "" { continue }
        kind := source_candidate(&mut c, f, &catalog); if kind < 0 { continue }
        if kind == 1 && previous >= 0 {
            length := c.world.ends[f] - c.world.starts[f] + 2
            if length == c.world.ends[previous] - c.world.starts[previous] + 2 &&
                opt_templates.same_body(&c.world.tokens, c.world.starts[f] - 1, c.world.starts[previous] - 1, length) { continue }
        }
        ids.push(f)
        if ids.len == capacity { return }
        if kind == 1 { previous = f } else { previous = -1 }
    }
    if ids.len < 2 && !coordinator { ids.clear() }
}
pub fn worker_model(c: &Session, result: &FrontendBody, model: &mut opt_ir.Function) {
    opt_ir.reset(&mut model); model.root = result.root; model.ret = result.result; model.params = result.params
    model.nodes = result.nodes; model.local_at = result.locals; model.local_types = result.types
    model.local_mutable = result.mutable; model.local_param = result.parameters; model.supported = true
    for at in result.locals { model.local_names.push(c.world.tokens.texts[at]) }
}
pub fn validation_plan(c: &Session, workers: i32) -> []i32 {
    var ids: []i32 = []
    if workers < 2 || !c.ok || c.jobs.phase != 2 || c.report { return ids }
    // Header spans are already available. A small tail stays on the current
    // Session, avoiding UTF-8 packing, worker setup and per-job dispatch.
    var tokens: i64 = 0; var largest: i64 = 0
    for f in (c.validated_through + 1)..c.world.names.len {
        if f == c.jobs.invalid_declaration { break }
        if !c.jobs.compiled[f] && c.world.libraries[f] == "" && c.jobs.checked_effects[f] < 0 {
            size := i64(c.world.ends[f] - c.world.starts[f] + 2)
            tokens = tokens + size; ids.push(f)
            if size > largest { largest = size }
        }
    }
    // Short bodies cost more to dispatch than to check in the existing
    // arena. At least two lanes need substantial independent source work.
    if tokens < 65536 + i64(ids.len) * 256 || tokens - largest < 16384 { ids.clear() }
    ids
}
fn pack_observation(out: &mut []i32, values: &[]i32, column: i32) {
    if values.len == 0 { return }
    out.push(column); out.push(values.len)
    for value in values { out.push(value) }
}
pub fn check_isolated(c: &mut Session, f: i32) -> Validation {
    assert(c.validating_dead && c.code.checking && !c.report)
    var model := opt_ir.new(); catalog := opt_inline.empty_view(); var inline_work := opt_inline.workspace()
    ft.reset_body(&mut c.types); facts.reset(&mut c.body.facts, 0)
    c.ok = true; c.error = ""; c.error_at = 0; c.types.error = ""
    c.code.virtual_words = 0; c.code.virtual_labels = c.jobs.globals
    c.body.reenter_owners = false; c.body.scalar_function = false
    if c.tasks.program && c.world.unsafe_functions[f] { task_effect(&mut c, 16) }
    type_body(&mut c, f, &mut model, &catalog, &mut inline_work)
    var result := Validation { declaration: f, at: c.error_at, error: [], effects: c.body.facts.effects,
        first_task: -1, observations: [] }
    if !c.ok { validation_bytes.append_utf8(&mut result.error, c.error); return result }
    if c.body.facts.first_task >= 0 { result.first_task = validation_token(&c, c.body.facts.first_task) }
    for i in 0..c.body.facts.worker_tokens.len { c.body.facts.worker_tokens[i] = validation_token(&c, c.body.facts.worker_tokens[i]) }
    for i in 0..c.body.facts.factory_tokens.len { c.body.facts.factory_tokens[i] = validation_token(&c, c.body.facts.factory_tokens[i]) }
    for i in 0..c.body.facts.shared_tokens.len { c.body.facts.shared_tokens[i] = validation_token(&c, c.body.facts.shared_tokens[i]) }
    pack_observation(&mut result.observations, &c.body.facts.needed, 0)
    pack_observation(&mut result.observations, &c.body.facts.taken, 1)
    pack_observation(&mut result.observations, &c.body.facts.calls, 2)
    pack_observation(&mut result.observations, &c.body.facts.workers, 3)
    pack_observation(&mut result.observations, &c.body.facts.worker_tokens, 4)
    pack_observation(&mut result.observations, &c.body.facts.factories, 5)
    pack_observation(&mut result.observations, &c.body.facts.factory_tokens, 6)
    pack_observation(&mut result.observations, &c.body.facts.shared, 7)
    pack_observation(&mut result.observations, &c.body.facts.shared_tokens, 8)
    pack_observation(&mut result.observations, &c.body.facts.exposed, 9)
    pack_observation(&mut result.observations, &c.body.facts.forwards, 10)
    pack_observation(&mut result.observations, &c.body.facts.indirect, 11)
    result
}
pub fn accept_validation(c: &mut Session, result: &Validation) -> bool {
    if !c.ok || c.jobs.phase != 2 || c.report { return false }
    var f := c.validated_through + 1
    while f < c.world.names.len {
        if !c.jobs.compiled[f] && c.world.libraries[f] == "" {
            if c.jobs.checked_effects[f] < 0 { break }
            facts.reset(&mut c.body.facts, 0); c.body.facts.effects = c.jobs.checked_effects[f]; accept_facts(&mut c, f)
        }
        f = f + 1
    }
    if f >= c.world.names.len || result.declaration != f { return false }
    if result.error.len > 0 {
        message := validation_bytes.decode(&result.error)
        c.ok = false; c.error_at = result.at; c.error = message.value; return false
    }
    facts.reset(&mut c.body.facts, 0)
    c.body.facts.effects = result.effects; c.body.facts.first_task = result.first_task
    var p := 0
    while p < result.observations.len {
        column := result.observations[p]; count := result.observations[p + 1]; p = p + 2
        for i in p..(p + count) {
            value := result.observations[i]
            if column == 0 { c.body.facts.needed.push(value) }
            else if column == 1 { c.body.facts.taken.push(value) }
            else if column == 2 { c.body.facts.calls.push(value) }
            else if column == 3 { c.body.facts.workers.push(value) }
            else if column == 4 { c.body.facts.worker_tokens.push(value) }
            else if column == 5 { c.body.facts.factories.push(value) }
            else if column == 6 { c.body.facts.factory_tokens.push(value) }
            else if column == 7 { c.body.facts.shared.push(value) }
            else if column == 8 { c.body.facts.shared_tokens.push(value) }
            else if column == 9 { c.body.facts.exposed.push(value) }
            else if column == 10 { c.body.facts.forwards.push(value) }
            else if column == 11 { c.body.facts.indirect.push(value) }
        }
        p = p + count
    }
    accept_facts(&mut c, f); c.validated_through = f; true
}

fn session_tail(c: &mut Session, scalar_model: &mut opt_ir.Function, scalar_work: &mut opt_verify.Workspace,
    scalar_plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options,
    range_work: &mut opt_range.Workspace, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace,
    records: &mut Bindings, record_takes: &mut record_take.Plan) -> Result {
    // Runtime is a scalar-only ABI record; this bounded copy is not an arena.
    rt := c.runtime
    if !c.ok { return Result { ok: false, error: c.error, offset: c.error_at, text: [], imports: imports() } }
    // The image owns only reachable code and data. Check the remaining
    // bodies against the same language rules without retaining machine output.
    live_platform := c.code.platform
    globals := c.imports.globals
    if c.tasks.program { for f in 0..c.world.names.len { c.tasks.reachable.push(c.jobs.compiled[f]) } }
    c.validating_dead = true
    c.code.checking = true; c.code.platform = 0
    c.code.virtual_words = 0; c.code.virtual_labels = c.jobs.globals
    c.imports.globals = 0
    for f in (c.validated_through + 1)..c.world.names.len {
        if !c.jobs.compiled[f] && c.world.libraries[f] == "" { compile_body(&mut c, f, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings, &mut range_work, &catalog, &mut inline_work) }
        if !c.ok { return Result { ok: false, error: c.error, offset: c.error_at, text: [], imports: imports() } }
    }
    if c.loans.active {
        if c.loans.indirect.len > 0 {
            signatures := c.world.ffi_types; starts := c.world.param_starts
            scratch.resolve(&mut c.loans, &signatures, &starts)
        }
        offset := scratch.escaping_offset(&mut c.loans)
        if offset >= 0 { return Result { ok: false, error: "scratch borrow reaches a raw address", offset: offset, text: [], imports: imports() } }
    }
    c.validating_dead = false
    c.code.checking = c.jobs.checking; c.code.platform = live_platform
    c.imports.globals = globals
    var certificate := tc.task_certificate()
    if c.tasks.program && !task_certify(&mut c, &mut certificate) { return session_error(&c) }
    if certificate.runtime && (c.jobs.platform != 0 || c.jobs.instrument_runtime) {
        return Result { ok: false, error: "isolated tasks require ARM64/macOS without runtime profiling", offset: certificate.at, text: [], imports: imports() }
    }
    var result := Result { ok: true, error: "", offset: 0, text: [], imports: imports() }
    if !c.jobs.checking {
        var started: i64 = -1
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        if certificate.runtime { bind_task_runtime(&mut c, &rt, &certificate); if !c.ok { return session_error(&c) } }
        result = finish_image(&mut c, c.jobs.platform, c.jobs.main_id, &rt, &mut record_takes)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 9, started, i64(result.text.len)) }
        if !result.ok { return result }
    }
    records.reused = c.bindings.reused; records.emitted = c.bindings.emitted
    records.worker_scalar = c.bindings.worker_scalar; records.worker_general = c.bindings.worker_general; records.frontend_workers = c.bindings.frontend_workers; records.source_windows = c.bindings.source_windows; records.peak_jobs = c.bindings.peak_jobs
    records.scalar_model_hits = c.bindings.scalar_model_hits; records.modeled = c.bindings.modeled; records.optimized = c.bindings.optimized
    records.rewrites = c.bindings.rewrites; records.proven_bounds = c.bindings.proven_bounds; records.fallbacks = c.bindings.fallbacks
    records.inline_entries = c.bindings.inline_entries; records.inline_nodes = c.bindings.inline_nodes
    records.inline_tokens = c.bindings.inline_tokens; records.inline_units = c.bindings.inline_units
    records.inlined_calls = c.bindings.inlined_calls; records.inlined_words = c.bindings.inlined_words
    records.inline_estimated_words = c.bindings.inline_estimated_words
    records.mir_functions = c.bindings.mir_functions; records.mir_operations = c.bindings.mir_operations; records.mir_opaque = c.bindings.mir_opaque
    records.mir_optimization_enabled = c.bindings.mir_optimization_enabled
    records.mir_source_objects_enabled = c.bindings.mir_source_objects_enabled; records.mir_private_memory_ops = c.bindings.mir_private_memory_ops
    records.mir_optimized = c.bindings.mir_optimized; records.mir_promoted = c.bindings.mir_promoted
    records.mir_removed_loads = c.bindings.mir_removed_loads; records.mir_removed_stores = c.bindings.mir_removed_stores
    records.mir_analysis_units = c.bindings.mir_analysis_units; records.mir_budget_refusals = c.bindings.mir_budget_refusals
    records.mir_ssa_enabled = c.bindings.mir_ssa_enabled
    records.mir_ssa_optimized = c.bindings.mir_ssa_optimized
    records.mir_ssa_cells = c.bindings.mir_ssa_cells
    records.mir_ssa_values = c.bindings.mir_ssa_values
    records.mir_ssa_parameters = c.bindings.mir_ssa_parameters
    records.mir_ssa_registers = c.bindings.mir_ssa_registers
    records.mir_ssa_captures = c.bindings.mir_ssa_captures
    records.mir_ssa_stack_groups = c.bindings.mir_ssa_stack_groups
    records.mir_ssa_removed_loads = c.bindings.mir_ssa_removed_loads
    records.mir_ssa_removed_stores = c.bindings.mir_ssa_removed_stores
    records.mir_ssa_removed_pushes = c.bindings.mir_ssa_removed_pushes
    records.mir_ssa_removed_pops = c.bindings.mir_ssa_removed_pops
    records.mir_ssa_copies = c.bindings.mir_ssa_copies
    records.mir_ssa_analysis_units = c.bindings.mir_ssa_analysis_units
    records.mir_ssa_budget_refusals = c.bindings.mir_ssa_budget_refusals
    records.mir_values_enabled = c.bindings.mir_values_enabled; records.mir_values_optimized = c.bindings.mir_values_optimized
    records.mir_value_rewrites = c.bindings.mir_value_rewrites; records.mir_value_deleted = c.bindings.mir_value_deleted; records.mir_value_immediates = c.bindings.mir_value_immediates
    records.mir_value_analysis_units = c.bindings.mir_value_analysis_units; records.mir_value_budget_refusals = c.bindings.mir_value_budget_refusals
    if c.bindings.profile.enabled { records.profile = c.bindings.profile }
    if c.report { records = c.bindings }
    result
}
// Check-only preserves the existing reachable-function validation order, but
// never constructs backend arenas, captures machine spans or enters lowering.
fn check_sources(c: &mut Session, scalar_model: &mut opt_ir.Function,
    scalar_work: &mut opt_verify.Workspace, scalar_plan: &mut opt_alloc.Plan,
    emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace) {
    var more := true
    while c.ok && more {
        more = false
        for f in 0..c.world.names.len {
            if !c.ok { break }; if !c.needed[f] || c.jobs.compiled[f] || c.world.libraries[f] != "" { continue }
            c.jobs.compiled[f] = true; more = true
            compile_body(&mut c, f, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings, &mut range_work, &catalog, &mut inline_work)
        }
    }
}
// Append an owned typed body (1) or restore a cached final object (2).
// Source operations, local layout and jump bindings remain valid when the
// frontend advances. Zero ends the sequence and -1 reports a diagnostic.
pub fn next_typed_into(c: &mut Session, batch: &mut mir_source.Batch, object: &mut mir_lower.FunctionObject,
    scalar_model: &mut opt_ir.Function, scalar_work: &mut opt_verify.Workspace,
    scalar_plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options,
    range_work: &mut opt_range.Workspace, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace,
    restored_deps: &mut fragments.Dependencies, prepared: &FrontendBody) -> i32 {
    if !c.ok { return -1 }; if c.jobs.phase == 2 { return 0 }
    if c.jobs.phase != 1 || c.jobs.checking { return -1 }
    while c.ok {
        if c.jobs.scan == c.world.names.len {
            if !c.jobs.more { c.jobs.phase = 2; return 0 }
            c.jobs.scan = 0; c.jobs.more = false
        }
        f := c.jobs.scan; c.jobs.scan = c.jobs.scan + 1
        if !c.needed[f] || c.jobs.compiled[f] || c.world.libraries[f] != "" { continue }
        c.jobs.compiled[f] = true; c.jobs.more = true
        // The linker owns the prefix and every accepted object. Reuse the
        // frontend arena for one body, retaining only the symbol namespace.
        c.code.words.clear(); c.code.at.clear(); c.code.target.clear(); c.code.kinds.clear()
        begin := fragments.start(&c.code)
        strings_before := c.strings.len; sites_before := c.imports.sites.len; globals_before := c.imports.globals
        var fingerprint := ""; var path := ""
        if c.jobs.cache != "" && !needs_loan_analysis(&c, f) {
            var started: i64 = -1
            if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
            fingerprint = fragments.key(c.jobs.cache, f, &c.world.tokens, c.world.starts[f], c.world.ends[f])
            path = c.jobs.directory + "/" + f.str() + ".fn"
            var restored := false
            if c.inline_enabled {
                fragments.reset_dependencies(&mut restored_deps)
                restored = fragments.restore_cached_with_dependencies(&mut c.code, c.jobs.globals, c.fn_labels[f], path,
                    fingerprint, c.world.names.len, fragments.word_limit(), &mut restored_deps)
            } else { restored = fragments.restore(&mut c.code, c.jobs.globals, c.fn_labels[f], path, fingerprint) }
            if restored {
                c.bindings.reused = c.bindings.reused + 1
                if c.inline_enabled {
                    for i in 0..restored_deps.declarations.len { c.needed[restored_deps.declarations[i]] = true }
                    c.bindings.inline_estimated_words = c.bindings.inline_estimated_words + restored_deps.charged_words
                }
                for r in begin.relocations..c.code.target.len {
                    label := c.code.target[r]
                    if label < c.jobs.globals { for id in 0..c.fn_labels.len {
                        if c.fn_labels[id] == label {
                            c.needed[id] = true
                            if c.loans.active && c.code.kinds[r] == 20 { c.loans.taken[id] = true }; break
                        }
                    } }
                }
                cs.record_job(&mut c.jobs, c.code.words.len, c.code.labels.len, c.code.at.len, f, begin.words, begin.labels, begin.relocations, sites_before, c.imports.sites.len, true, fingerprint, path, false, c.inline_enabled, c.body.scalar_function, -1)
                fragment := cs.job_range(&c.jobs, current_ordinal(&c), &c.fn_labels)
                if !mir_lower.capture_cached_function(&mut object, &c.code, &c.imports.sites, &fragment) {
                    c.body.cursor = c.world.starts[f]; fail(&mut c, "internal final cache object capture failure")
                }
                if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 8, started, 1) }
                if !c.ok { c.jobs.error_ordinal = current_ordinal(&c); return -1 }; return 2
            }
            if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 8, started, 1) }
        }
        c.bindings.emitted = c.bindings.emitted + 1
        arm.begin_mir(&mut c.code, true)
        if prepared.source.declaration >= 0 {
            assert(prepared.source.declaration == f)
            install_frontend(&mut c, f, &prepared, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings, &mut range_work)
        } else {
            compile_body(&mut c, f, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings, &mut range_work, &catalog, &mut inline_work)
        }
        arm.end_mir(&mut c.code)
        if !c.ok { c.jobs.error_ordinal = c.jobs.declarations.len; c.jobs.phase = -1; return -1 }
        eligible := fingerprint != "" && !c.has_callbacks && c.strings.len == strings_before &&
            c.imports.sites.len == sites_before && c.imports.globals == globals_before
        var started: i64 = -1
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        cs.record_job(&mut c.jobs, c.code.words.len, c.code.labels.len, c.code.at.len, f, begin.words, begin.labels, begin.relocations, sites_before, c.imports.sites.len, false, fingerprint, path, eligible, c.inline_enabled, c.body.scalar_function, started)
        if c.inline_enabled && !c.body.scalar_function {
            ordinal := c.jobs.declarations.len - 1
            for i in 0..c.body.inline_deps.declarations.len { c.jobs.deps.push(c.body.inline_deps.declarations[i]) }
            c.jobs.deps_end[ordinal] = c.jobs.deps.len; c.jobs.charged[ordinal] = c.body.inline_deps.charged_words
        }
        if !capture_current(&mut c, &mut batch) { return -1 }
        return 1
    }
    -1
}
// A structural reference belongs to the same function as its uses.
fn capture_source_types(c: &Session, out: &mut []i32) {
    source_types.append(&mut out, c.types.declared.type_kinds.len, &c.types.body.type_kinds, &c.types.body.type_bases,
        &c.types.body.type_starts, &c.types.body.type_counts, &c.types.body.ffi_params)
}
fn capture_current(c: &mut Session, batch: &mut mir_source.Batch) -> bool {
    ordinal := current_ordinal(&c)
    if !c.ok || c.jobs.phase != 1 || ordinal < c.jobs.accepted || c.jobs.restored[ordinal] { return false }
    r := cs.job_range(&c.jobs, ordinal, &c.fn_labels)
    if mir_source.finish_function(&mut batch, &c.code, r.first_label,
        &c.imports.sites, r.first_import, r.entry) {
        mir_source.attach_places(&mut batch, &c.body.places.arena)
        capture_source_types(&c, &mut batch.types); batch.type_ends.push(batch.types.len); return true
    }
    backend_error(&mut c, ordinal, 10)
    false
}
// Serial compilation consumes the same owned function as a worker.
pub fn next_into(c: &mut Session, function: &mut mir.Function, object: &mut mir_lower.FunctionObject,
    lifter: &mut mir_lift.Workspace, batch: &mut mir_source.Batch, scalar_model: &mut opt_ir.Function, scalar_work: &mut opt_verify.Workspace,
    scalar_plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options,
    range_work: &mut opt_range.Workspace, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace,
    restored_deps: &mut fragments.Dependencies) -> i32 {
    mir_source.reset(&mut batch)
    plain := empty_frontend()
    state := next_typed_into(&mut c, &mut batch, &mut object, &mut scalar_model, &mut scalar_work,
        &mut scalar_plan, &emit_settings, &mut range_work, &catalog,
        &mut inline_work, &mut restored_deps, &plain)
    if state != 1 { return state }
    ordinal := current_ordinal(&c)
    error := mir_lift.lift_item(&mut function, &mut lifter, &batch, 0)
    if error != 0 { backend_error(&mut c, ordinal, error); return -1 }
    1
}
fn backend_error(c: &mut Session, ordinal: i32, code: i32) {
    if ordinal > c.jobs.error_ordinal { return }
    var message := "internal whole-function MIR verification failure"
    if code == 2 { message = "internal whole-function MIR post-pass verification failure" }
    else if code == 3 { message = "internal whole-function MIR analysis failure" }
    else if code == 4 { message = "internal whole-function MIR value commit failure" }
    else if code == 5 { message = "internal whole-function MIR value analysis failure" }
    else if code == 6 { message = "internal whole-function MIR terminal configuration failure" }
    else if code == 7 { message = "internal whole-function MIR lowering failure" }
    else if code == 8 { message = "internal ordered function object failure" }
    else if code == 9 { message = "internal whole-function MIR SSA failure" }
    else if code == 10 { message = "internal whole-function MIR lift failure" }
    else if code == 11 { message = "internal whole-function MIR entry failure" }
    c.ok = false; c.error = message; c.error_at = c.world.tokens.starts[c.world.starts[c.jobs.declarations[ordinal]]]
    c.jobs.error_ordinal = ordinal; c.jobs.phase = -1
}
// Trusted-backend precondition: this object must derive from this exact
// Session's yielded Function/final fragment. Structural origin bounds are not
// authentication against same-shaped objects from another Session. The queue
// owner must preserve that provenance across suspension and worker completion.
// Accept only the next ordinal, even if a later source failure was discovered
// while it ran. An earlier delayed backend failure keeps old serial priority.
pub fn accept_into(c: &mut Session, link: &mut mir_link.Linker, ordinal: i32,
    object: &mir_lower.FunctionObject, status: &mir_pipeline.Status) -> bool {
    if ordinal != c.jobs.accepted || ordinal < 0 || ordinal >= c.jobs.declarations.len { return false }
    if status.error != 0 { backend_error(&mut c, ordinal, status.error); return false }
    if !cs.job_object_matches(&c.jobs, &object, ordinal, &c.fn_labels) || !mir_link.reserve_namespace(&mut link, c.code.labels.len, c.imports.sites.len) || !mir_link.append(&mut link, &object, ordinal) {
        backend_error(&mut c, ordinal, 8); return false
    }
    if !c.jobs.restored[ordinal] {
        c.bindings.mir_functions = c.bindings.mir_functions + 1
        c.bindings.mir_operations = c.bindings.mir_operations + status.stats.operations
        c.bindings.mir_opaque = c.bindings.mir_opaque + status.stats.opaque
        c.bindings.mir_optimized = c.bindings.mir_optimized + status.stats.optimized
        c.bindings.mir_promoted = c.bindings.mir_promoted + status.stats.promoted
        c.bindings.mir_removed_loads = c.bindings.mir_removed_loads + status.stats.removed_loads
        c.bindings.mir_removed_stores = c.bindings.mir_removed_stores + status.stats.removed_stores
        c.bindings.mir_private_memory_ops = c.bindings.mir_private_memory_ops + status.stats.private_memory_ops
        c.bindings.mir_analysis_units = c.bindings.mir_analysis_units + status.stats.analysis_units
        c.bindings.mir_budget_refusals = c.bindings.mir_budget_refusals + status.stats.budget_refusals
        c.bindings.mir_ssa_optimized = c.bindings.mir_ssa_optimized + status.stats.ssa_optimized
        c.bindings.mir_ssa_cells = c.bindings.mir_ssa_cells + status.stats.ssa_cells
        c.bindings.mir_ssa_values = c.bindings.mir_ssa_values + status.stats.ssa_values
        c.bindings.mir_ssa_parameters = c.bindings.mir_ssa_parameters + status.stats.ssa_parameters
        c.bindings.mir_ssa_registers = c.bindings.mir_ssa_registers + status.stats.ssa_registers
        c.bindings.mir_ssa_captures = c.bindings.mir_ssa_captures + status.stats.ssa_captures
        c.bindings.mir_ssa_stack_groups = c.bindings.mir_ssa_stack_groups + status.stats.ssa_stack_groups
        c.bindings.mir_ssa_removed_loads = c.bindings.mir_ssa_removed_loads + status.stats.ssa_removed_loads
        c.bindings.mir_ssa_removed_stores = c.bindings.mir_ssa_removed_stores + status.stats.ssa_removed_stores
        c.bindings.mir_ssa_removed_pushes = c.bindings.mir_ssa_removed_pushes + status.stats.ssa_removed_pushes
        c.bindings.mir_ssa_removed_pops = c.bindings.mir_ssa_removed_pops + status.stats.ssa_removed_pops
        c.bindings.mir_ssa_copies = c.bindings.mir_ssa_copies + status.stats.ssa_copies
        c.bindings.mir_ssa_analysis_units = c.bindings.mir_ssa_analysis_units + status.stats.ssa_analysis_units
        c.bindings.mir_ssa_budget_refusals = c.bindings.mir_ssa_budget_refusals + status.stats.ssa_budget_refusals
        c.bindings.mir_values_optimized = c.bindings.mir_values_optimized + status.stats.values_optimized
        c.bindings.mir_value_rewrites = c.bindings.mir_value_rewrites + status.stats.value_rewrites
        c.bindings.mir_value_deleted = c.bindings.mir_value_deleted + status.stats.value_deleted
        c.bindings.mir_value_immediates = c.bindings.mir_value_immediates + status.stats.value_immediates
        c.bindings.mir_value_analysis_units = c.bindings.mir_value_analysis_units + status.stats.value_analysis_units
        c.bindings.mir_value_budget_refusals = c.bindings.mir_value_budget_refusals + status.stats.value_budget_refusals
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 11, c.jobs.started[ordinal], i64(status.stats.operations)) }
    }
    c.jobs.accepted = c.jobs.accepted + 1
    // A later frontend error may be discovered while this earlier job runs.
    // Preserve the successful prefix fragments the serial driver already
    // published, but never publish the failed ordinal or anything after it.
    if (c.ok || ordinal < c.jobs.error_ordinal) && c.jobs.eligible[ordinal] {
        var started: i64 = -1
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        cs.save_accepted_object(&c.jobs, ordinal, &object, c.world.names.len)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 8, started, 1) }
    }
    true
}
pub fn finish(c: &mut Session, link: &mut mir_link.Linker, scalar_model: &mut opt_ir.Function,
    scalar_work: &mut opt_verify.Workspace, scalar_plan: &mut opt_alloc.Plan,
    emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace, catalog: &opt_inline.View,
    inline_work: &mut opt_inline.Workspace, records: &mut Bindings, record_takes: &mut record_take.Plan) -> Result {
    if !c.ok { return session_error(&c) }
    if c.jobs.phase != 2 || c.jobs.accepted != c.jobs.declarations.len ||
        !mir_link.reserve_namespace(&mut link, c.code.labels.len, c.imports.sites.len) ||
        !mir_link.seal_namespace(&mut link, c.jobs.declarations.len) || !mir_link.finalize(&mut link) {
        failed := session_fail_at(&mut c, "internal unfinished compiler session", 0); return session_error(&c)
    }
    // The linker now owns the ordered target image and all resolved offsets.
    c.code = arm.new_for(c.jobs.platform); c.imports.sites.clear()
    mir_link.export_code(&mut link, &mut c.code); mir_link.export_import_sites(&mut link, &mut c.imports.sites)
    // Final symbolic calls are the single source of helper demand, including
    // restored objects. Normalization's own nested calls use Plan's closure;
    // source/runtime/clone emitters add no later record-take dependencies.
    for r in 0..c.code.target.len { requested := record_take.request_label(&mut record_takes, c.code.target[r]) }
    c.jobs.phase = 3
    session_tail(&mut c, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &emit_settings,
        &mut range_work, &catalog, &mut inline_work, &mut records, &mut record_takes)
}

// The model handles unowned scalars and stable-shape i64-array borrows.
// Other operations continue through the same source checker and function backend.
fn scalar_type(c: &Session, ty: i32) -> i32 { ft.scalar_type(&c.types, ty) }
// This is a cheap refusal gate, never a source-language acceptance rule.
// Closed expression verification below rejects calls, locals and control flow.
fn inline_signature(c: &Session, f: i32) -> bool {
    if c.world.libraries[f] != "" || c.world.test_functions[f] || c.world.unsafe_functions[f] ||
        c.world.param_counts[f] > 8 || c.world.returns[f] < 1 || c.world.returns[f] > 3 || c.world.ends[f] - c.world.starts[f] + 2 > 128 { return false }
    first := c.world.param_starts[f]
    for p in 0..c.world.param_counts[f] { if c.world.param_types[first + p] < 1 || c.world.param_types[first + p] > 3 { return false } }
    true
}
fn inline_expression_bound(c: &Session, f: i32) -> i32 {
    var nodes := 0; var returned := false; var ended := false
    for token in c.world.starts[f]..c.world.ends[f] {
        kind := c.world.tokens.kinds[token]; word := c.world.tokens.texts[token]
        if kind == .Newline { continue }
        if kind == .Symbol && word == ";" { ended = true; continue }
        if ended { return 0 }
        if kind == .Name {
            if c.world.tokens.texts[token + 1] == "(" { return 0 }
            var found := false
            first := c.world.param_starts[f]
            for p in first..first + c.world.param_counts[f] { if c.world.param_names[p] == word { found = true; break } }
            if !found { return 0 }
        } else if kind == .Symbol {
            if word == "(" || word == ")" { continue }
            if rules.opcode(word) == 0 && word != "!" { return 0 }
        } else if kind == .Keyword {
            if word == "return" { if returned || nodes != 0 { return 0 }; returned = true; continue }
            if word != "true" && word != "false" { return 0 }
        } else if kind != .Integer { return 0 }
        nodes = nodes + 1; if nodes > 32 { return 0 }
    }
    nodes
}
fn inline_catalog(c: &mut Session, catalog: &mut opt_inline.Catalog, model: &mut opt_ir.Function,
    work: &mut opt_verify.Workspace, range_work: &mut opt_range.Workspace, source_digests: bool) {
    var remaining := 32768
    var inline_work := opt_inline.workspace()
    // Declaration order makes both admission and budget exhaustion reproducible.
    // The token budget covers the structural refusal walk as well as parsing,
    // independently of the catalog's verified-node budget. Diagnostics are
    // reported in normal declaration traversal order.
    inactive := opt_inline.empty_view()
    for f in 0..c.world.names.len {
        if !c.ok || !opt_inline.room_for(&catalog, 1, 0) { break }
        if !inline_signature(&c, f) { opt_inline.reject(&mut catalog, f); continue }
        charge := c.world.ends[f] - c.world.starts[f] + 2
        if charge > remaining { break }
        remaining = remaining - charge
        bound := inline_expression_bound(&c, f)
        if !opt_inline.room_for(&catalog, bound, c.world.param_counts[f]) { opt_inline.reject(&mut catalog, f); continue }
        // Resolve each prospective expression with the same binder, literal
        // widths, expression parser and return checks as its out-of-line body.
        // The identifier gate above confines this probe to parameter reads.
        facts.reset(&mut c.body.facts, 0)
        if !typed_body_into(&mut c, f, &mut model, &inactive, &mut inline_work) {
            opt_inline.reject(&mut catalog, f)
            if c.error != "" {
                // A reachable error may precede this one. Publish it when its
                // declaration's turn arrives, with the original byte offset.
                c.jobs.invalid_declaration = f; c.jobs.invalid_offset = c.error_at; c.jobs.invalid_message = c.error
                c.ok = true; c.error = ""; c.error_at = 0; break
            }
            continue
        }
        if !optimize_scalar(&mut c, f, &mut model, &mut work, &mut range_work) || !c.ok { return }
        // Only accepted entries need source identities. Missing identities
        // deliberately make the catalog unsuitable for a fragment context.
        admitted := opt_inline.add_verified(&mut catalog, f, &model, "")
        if admitted { c.jobs.checked_effects[f] = c.body.facts.effects }
        if admitted && source_digests {
            digest := fragments.key("inline-body:v1", f, &c.world.tokens, c.world.starts[f] - 1, c.world.ends[f])
            if !opt_inline.set_body_digest(&mut catalog, f, digest) { fail(&mut c, "internal inline body identity failure"); return }
        }
    }
    if !opt_inline.seal_mode(&mut catalog, source_digests) { fail(&mut c, "internal inline catalog invariant failure"); return }
    c.bindings.inline_entries = opt_inline.count(&catalog); c.bindings.inline_nodes = opt_inline.node_count(&catalog)
    c.bindings.inline_tokens = 32768 - remaining; c.bindings.inline_units = opt_inline.units(&catalog)
}
fn scalar_signature(c: &mut Session, f: i32) -> bool {
    if !c.scalar_enabled || c.world.test_functions[f] || c.world.unsafe_functions[f] || needs_loan_analysis(&c, f) { return false }
    if c.world.param_counts[f] > 8 || c.world.returns[f] > 3 || c.world.ends[f] - c.world.starts[f] > 8192 { return false }
    c.body.scalar_names.clear(); c.body.scalar_types.clear(); c.body.scalar_tokens.clear()
    first := c.world.param_starts[f]
    for p in 0..c.world.param_counts[f] {
        ty := scalar_type(&c, c.world.param_types[first + p])
        if ty < 1 { return false }
        c.body.scalar_names.push(c.world.param_names[first + p]); c.body.scalar_types.push(ty); c.body.scalar_tokens.push(c.world.param_tokens[first + p])
    }
    true
}
fn optimize_scalar(c: &mut Session, f: i32, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace, range_work: &mut opt_range.Workspace) -> bool {
    var started: i64 = -1
    if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
    var positions_ok := true
    for i in 0..model.nodes.starts.len {
        if model.nodes.starts[i] < 0 || model.nodes.starts[i] >= c.world.tokens.starts.len { positions_ok = false }
    }
    for i in 0..model.local_at.len {
        if model.local_at[i] < 0 || model.local_at[i] >= c.world.tokens.starts.len { positions_ok = false }
    }
    before_ok := positions_ok && opt_verify.validate_into(&mut work, &model, false)
    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 2, started, i64(model.nodes.kinds.len)) }
    if !before_ok {
        c.body.cursor = c.world.starts[f]
        fail(&mut c, "internal scalar model invariant failure before optimization")
        return true
    }
    if !c.code.checking {
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        opt_pass.run(&mut model)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 3, started, i64(model.visits)) }
        if c.range_enabled {
            // Skip graph analysis unless the model can gain bounds or i32
            // arithmetic proofs. This gate makes no safety decision: the
            // analyzer still validates every admitted model independently.
            var candidate := false
            for local in 0..model.params { if opt_ir.array_type(model.local_types[local]) { candidate = true } }
            if !candidate {
                for node in 0..model.nodes.kinds.len {
                    if model.nodes.types[node] != 1 || model.nodes.proofs[node].bit_and(1) != 0 { continue }
                    kind := model.nodes.kinds[node]; op := model.nodes.values[node]
                    if (kind == 3 && op >= 1 && op <= 3) || (kind == 4 && op == 1) { candidate = true; break }
                }
            }
            if candidate {
                if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
                ready := opt_range.analyze_into(&mut range_work, &model)
                if ready { opt_range.apply(&mut range_work, &mut model) }
                if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 10, started, i64(opt_range.units(&range_work))) }
                if !ready && opt_range.status(&range_work) == 4 {
                    c.body.cursor = c.world.starts[f]
                    fail(&mut c, "internal scalar range invariant failure")
                    return true
                }
                // Resource exhaustion leaves all existing proofs unchanged.
            }
        }
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        after_ok := opt_verify.validate_into(&mut work, &model, true)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 4, started, i64(model.nodes.kinds.len)) }
        if !after_ok {
            c.body.cursor = c.world.starts[f]
            fail(&mut c, "internal scalar model invariant failure after optimization")
            return true
        }
    }
    true
}
fn emit_scalar(c: &mut Session, f: i32, model: &opt_ir.Function, plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options) {
    var started: i64 = -1
    c.bindings.modeled = c.bindings.modeled + 1
    if c.report {
        for local in 0..model.local_names.len {
            at := model.local_at[local]
            if at >= 0 && c.world.tokens.starts[at] < c.world.source_end {
                var ty := model.local_types[local]
                if ty == 20 || ty == 21 {
                    array := compound(&mut c, 1, 2)
                    var kind := 4; if ty == 21 { kind = 5 }
                    ty = compound(&mut c, kind, array)
                }
                facts.binding(&mut c.body.facts, at, ty)
            }
        }
    }
    if !c.code.checking {
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        opt_alloc.allocate_into(&mut plan, &model)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 5, started, i64(plan.homes.len)) }
        var words := 0
        if c.bindings.profile.enabled { words = arm.position(&c.code) }
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        opt_emit.emit_prepared_configured(&mut c.code, &model, &plan, c.fn_labels[f], c.overflow, c.zero, c.bounds, &emit_settings)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 6, started, i64(arm.position(&c.code) - words)) }
        c.bindings.optimized = c.bindings.optimized + 1
        c.bindings.rewrites = c.bindings.rewrites + model.rewrites
        for node in 0..model.nodes.kinds.len {
            if (model.nodes.kinds[node] == 6 || model.nodes.kinds[node] == 18) && model.nodes.proofs[node].bit_and(2) != 0 { c.bindings.proven_bounds = c.bindings.proven_bounds + 1 }
        }
    }
}
// Preserve array capacities across bodies. No function-local owner or pending
// cleanup survives a transition to the next declaration.
fn reset_body(body: &mut FunctionContext) {
    body.task_handles.clear(); body.loop_task_locals.clear()
    locals.clear(&mut body.locals)
    body.owned_slots.clear(); body.owned_types.clear(); body.owner_temps.clear(); body.mutations.clear()
    borrows.clear(&mut body.places)
    body.for_locks.clear(); body.taking_address = false
    deferred.reset(&mut body.defers); body.loop_defers.clear()
    body.in_defer = false; body.defer_loop_floor = 0
    body.observing_lease = false; body.lease_generation = 0
    body.loop_heads.clear(); body.loop_ends.clear(); body.loop_owners.clear()
    body.scratch_returns.clear()
    body.expr_owner = -1; body.expr_type = -1; body.address = -1
    body.direct_place = false; body.inline_place = false; body.scratch_place = 0
    body.writable = false; body.depth = 0; body.block_depth = 0
    body.stream_depth = -1; body.stream_kind = 0
}
// Continue from the current parser frame and cursor. Prefix labels retain
// their IDs across the transition, including loop edges still to be bound.
fn decline_projection(c: &mut Session, model: &mut opt_ir.Function) -> bool {
    model.recording = false; model.probing = false
    if !c.code.prefixing { c.ok = false; return true }
    arm.end_prefix(&mut c.code)
    while c.code.labels.len < c.code.virtual_labels { reserved := arm.label(&mut c.code) }
    var i := 0
    while i < c.code.prefix.len {
        cell := c.code.prefix[i]; i = i + 1
        if cell < 0 && cell.bit_and(i64(1).shl(56)) == 0 { arm.mark(&mut c.code, i32(row.operand(cell))) }
        else if cell < 0 {
            lower_operator(&mut c, row.reg(cell), i32(cell.shr(32).bit_and(65535)))
        } else if row.control_row(cell) {
            target := i32(c.code.prefix[i]); i = i + 1; arm.resume_edge(&mut c.code, cell, target)
        } else { c.code.words.push(cell) }
    }
    c.code.prefix.clear(); false
}
// Collect the resolved body before optimization. A declined operation leaves
// the session ready for ordinary lowering. A source diagnostic belongs to
// session_error. The caller supplies the same arenas used by the scheduler.
pub fn typed_body_into(c: &mut Session, f: i32, model: &mut opt_ir.Function,
    catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace) -> bool {
    if !c.ok || c.code.checking || f < 0 || f >= c.world.returns.len || c.world.libraries[f] != "" { return false }
    if c.world.test_functions[f] || c.world.unsafe_functions[f] || c.world.returns[f] > 3 || c.world.param_counts[f] > 8 { return false }
    typed.begin(&mut model, c.world.returns[f], c.world.param_counts[f])
    capture := c.code.mir_capture; reporting := c.report
    c.code.checking = true; c.code.mir_capture = false; c.report = false
    c.code.virtual_words = 0; c.code.virtual_labels = c.code.labels.len
    walk_body(&mut c, f, &mut model, &catalog, &mut inline_work)
    c.code.checking = false; c.code.mir_capture = capture; c.report = reporting
    model.probing = false
    if !model.recording {
        if c.error == "" { c.ok = true; c.error_at = 0 }
        return false
    }
    model.recording = false
    if !c.ok { return false }
    model.root = model.value; model.supported = true
    true
}
// Source sites acquire their image-wide symbol, thunk or dispatch identity
// in declaration order. Check-only imports participate in ELF diagnostics.
fn bind_symbols(c: &mut Session) {
    for i in 0..c.body.facts.symbols.len {
        kind := c.body.facts.symbols[i]; operand := c.body.facts.operands[i]; var slot := 0
        site := c.body.facts.sites[i]; word := c.body.facts.first_word + site / 4
        if kind == .CallbackEntry {
            if site < 0 { continue }
            var low := 0; var high := c.code.at.len
            while low < high {
                mid := low + (high - low) / 2
                if c.code.at[mid] < word { low = mid + 1 } else { high = mid }
            }
            assert(low < c.code.at.len && c.code.at[low] == word && c.code.kinds[low] == 20)
            if c.callback_labels[operand] < 0 { label := arm.label(&mut c.code); c.callback_labels[operand] = label }
            c.code.target[low] = c.callback_labels[operand]; continue
        }
        if kind == .WasmImport || kind == .WasmCallback || kind == .WasmCall {
            if site < 0 { continue }
            if kind == .WasmCall {
                signature := wasm_signature(&mut c, operand)
                assert(row.kind(c.code.words[word]) == 62)
                c.code.words[word + 2] = i64(signature + 1).shl(32).bit_or(c.code.words[word + 2].bit_and(4294967295))
            } else {
                signature := wasm_signature(&mut c, c.world.ffi_types[operand]); var entry := 0
                if kind == .WasmImport { entry = wa.host(&mut c.wasm_abi, c.world.libraries[operand], c.world.symbols[operand], signature) }
                else { entry = wa.callback(&mut c.wasm_abi, c.fn_labels[operand], signature) }
                assert(row.kind(c.code.words[word]) == 1 && row.operand(c.code.words[word]) == 0)
                c.code.words[word] = c.code.words[word].bit_or(i64(entry))
            }
            continue
        }
        if kind == .Import {
            library := fa.library_name(c.world.libraries[operand], c.code.platform == 0)
            name := c.world.symbols[operand]
            while slot < c.imports.symbols.len {
                if c.imports.symbols[slot] == name {
                    if c.imports.libraries[slot] == library { break }
                    if c.code.platform != 0 {
                        c.ok = false
                        c.error = "ELF cannot bind one symbol to two libraries; select a handle with std.dl"
                        c.error_at = c.world.tokens.starts[c.body.facts.tokens[i]]
                        return
                    }
                }
                slot = slot + 1
            }
            if slot == c.imports.symbols.len { c.imports.libraries.push(library); c.imports.symbols.push(name) }
        } else if kind == .Static {
            var offset := (c.imports.globals + 15) / 16 * 16
            if offset < 64 { offset = 64 }
            c.imports.globals = offset + operand; slot = -1 - offset
        } else if kind == .TaskCoordinator {
            if c.tasks.coordinator < 0 {
                c.tasks.coordinator = tc.coordinator_offset(c.imports.globals)
                c.imports.globals = tc.after_coordinator(c.tasks.coordinator)
            }
            slot = -1 - c.tasks.coordinator
        } else {
            if c.imports.globals < 64 { c.imports.globals = 64 }
            slot = -1 - operand
        }
        if site >= 0 { c.imports.sites.push(c.body.facts.first_word * 4 + site); c.imports.slots.push(slot) }
    }
}
// This is the only publication of per-body semantic observations. Ordinal
// traversal determines reachability, effect-graph order and diagnostic output.
fn accept_facts(c: &mut Session, declaration: i32) {
    for target in c.body.facts.needed { c.needed[target] = true }
    if c.tasks.program {
        c.tasks.direct[declaration] = c.body.facts.effects; c.tasks.complete[declaration] = true
        for target in c.body.facts.calls {
            c.tasks.edges_from.push(declaration); c.tasks.edges_to.push(target)
        }
        at := c.body.facts.first_task
        c.tasks.uses[declaration] = at >= 0; c.tasks.use_ats[declaration] = at
        for i in 0..c.body.facts.shared.len { tc.record_shared(&mut c.tasks, c.body.facts.shared[i], c.body.facts.shared_tokens[i]) }
        for i in 0..c.body.facts.factories.len { tc.record_workspace(&mut c.tasks, c.body.facts.factories[i], c.body.facts.factory_tokens[i]) }
        for i in 0..c.body.facts.workers.len {
            c.tasks.spawn_workers.push(c.body.facts.workers[i]); c.tasks.spawn_callers.push(declaration)
            c.tasks.spawn_ats.push(c.body.facts.worker_tokens[i])
        }
    }
    if c.loans.active {
        for target in c.body.facts.taken { c.loans.taken[target] = true }
        for parameter in c.body.facts.exposed { scratch.expose(&mut c.loans, parameter) }
        var i := 0
        while i < c.body.facts.forwards.len {
            scratch.forward(&mut c.loans, c.body.facts.forwards[i],
                c.body.facts.forwards[i + 1], c.body.facts.forwards[i + 2]); i = i + 3
        }
        for value in c.body.facts.indirect { c.loans.indirect.push(value) }
    }
    for i in 0..c.body.facts.literal_tokens.len {
        c.strings.push(c.world.tokens.texts[c.body.facts.literal_tokens[i]])
        c.string_labels.push(c.body.facts.literal_labels[i])
    }
    for i in 0..c.body.facts.binding_tokens.len {
        at := c.body.facts.binding_tokens[i]
        c.bindings.offsets.push(c.world.tokens.starts[at]); c.bindings.names.push(c.world.tokens.texts[at])
        c.bindings.types.push(type_spelling(&c, c.body.facts.binding_types[i]))
    }
}
fn compile_body(c: &mut Session, f: i32, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace, plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace) {
    origin := arm.position(&c.code); facts.reset(&mut c.body.facts, origin)
    produce_body(&mut c, f, &mut model, &mut work, &mut plan,
        &emit_settings, &mut range_work, &catalog, &mut inline_work)
    if c.body.scalar_function { borrows.clear(&mut c.body.places) }
    if c.body.facts.sites.len > 0 { bind_symbols(&mut c) }
    if c.ok { accept_facts(&mut c, f) }
}
fn begin_projection(c: &mut Session, f: i32, model: &mut opt_ir.Function) {
    typed.begin(&mut model, c.world.returns[f], c.world.param_counts[f])
    arm.begin_prefix(&mut c.code)
}
fn finish_projection(c: &mut Session, model: &mut opt_ir.Function) -> bool {
    if c.code.prefixing { arm.end_prefix(&mut c.code); c.code.prefix.clear() }
    if !c.ok || !model.recording { return false }
    model.root = model.value; model.supported = true; model.recording = false; model.probing = false
    true
}
fn produce_body(c: &mut Session, f: i32, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace, plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace) {
    if c.jobs.invalid_declaration == f {
        c.ok = false; c.error = c.jobs.invalid_message; c.error_at = c.jobs.invalid_offset; return
    }
    if c.jobs.checked_effects[f] >= 0 {
        c.body.facts.effects = c.jobs.checked_effects[f]
        if c.code.checking && !c.report { return }
    }
    ft.reset_body(&mut c.types)
    c.body.reenter_owners = false
    if c.tasks.program && c.world.unsafe_functions[f] { task_effect(&mut c, 16) }
    c.body.scalar_function = false; model.recording = false; model.probing = false
    if c.scalar_enabled && opt_inline.restore_view_body(&catalog, f, &mut model, &c.world.param_names, &c.world.param_tokens, c.world.param_starts[f]) {
        c.body.scalar_function = true
        emit_scalar(&mut c, f, &model, &mut plan, &emit_settings)
        return
    }
    var reuse: opt_templates.Decision = .Miss
    eligible := !c.code.checking && scalar_signature(&mut c, f)
    if eligible {
        reuse = scalar_reuse(&mut c, f, &mut model)
        if reuse == .Reused { emit_scalar(&mut c, f, &model, &mut plan, &emit_settings); return }
    }
    if !eligible {
        walk_body(&mut c, f, &mut model, &catalog, &mut inline_work)
        return
    }

    begin_projection(&mut c, f, &mut model)
    walk_body(&mut c, f, &mut model, &catalog, &mut inline_work)
    if !finish_projection(&mut c, &mut model) {
        if c.ok { c.bindings.fallbacks = c.bindings.fallbacks + 1 }
        return
    }
    emit_checked_scalar(&mut c, f, &mut model, &mut work, &mut plan, &emit_settings, &mut range_work, reuse)
}
fn scalar_reuse(c: &mut Session, f: i32, model: &mut opt_ir.Function) -> opt_templates.Decision {
    var reuse: opt_templates.Decision = .Miss
    if !c.tasks.program {
        reuse = opt_templates.probe(&c.scalar_templates, &c.world.tokens, c.world.starts[f] - 1, c.world.ends[f],
            &c.body.scalar_names, &c.body.scalar_types, &c.body.scalar_tokens, c.world.returns[f])
    }
    if reuse == .Reused {
        opt_templates.restore(&c.scalar_templates, &mut model, c.world.starts[f] - 1, &c.body.scalar_tokens)
        c.bindings.scalar_model_hits = c.bindings.scalar_model_hits + 1; c.body.scalar_function = true
    } else { opt_templates.observe(&mut c.scalar_templates, c.world.starts[f] - 1, c.world.ends[f]) }
    reuse
}
fn install_frontend(c: &mut Session, f: i32, prepared: &FrontendBody, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace,
    plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace) {
    if prepared.first { c.bindings.frontend_workers = c.bindings.frontend_workers + 1 }
    var reuse: opt_templates.Decision = .Miss
    if prepared.project {
        eligible := scalar_signature(&mut c, f); assert(eligible)
        reuse = scalar_reuse(&mut c, f, &mut model)
    }
    if prepared.supported || reuse == .Reused {
        c.body.facts = prepared.source.facts; ft.restore_shapes(&mut c.types, &prepared.source.types)
        borrows.clear(&mut c.body.places)
        if reuse == .Reused { emit_scalar(&mut c, f, &model, &mut plan, &emit_settings) }
        else {
            worker_model(&c, &prepared, &mut model)
            emit_checked_scalar(&mut c, f, &mut model, &mut work, &mut plan, &emit_settings, &mut range_work, reuse)
        }
        c.bindings.worker_scalar = c.bindings.worker_scalar + 1
        if c.ok { accept_facts(&mut c, f) }
    } else {
        if prepared.project && prepared.source.error.len == 0 { c.bindings.fallbacks = c.bindings.fallbacks + 1 }
        installed := install_emitted(&mut c, f, &prepared.source)
        c.bindings.worker_general = c.bindings.worker_general + 1
    }
}
fn emit_checked_scalar(c: &mut Session, f: i32, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace,
    plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace, reuse: opt_templates.Decision) {
    if !optimize_scalar(&mut c, f, &mut model, &mut work, &mut range_work) || !c.ok { return }
    if reuse == .Admit { opt_templates.save(&mut c.scalar_templates, &model, c.world.starts[f] - 1, c.world.ends[f]) }
    c.body.scalar_function = true
    reporting := c.report; c.report = false
    emit_scalar(&mut c, f, &model, &mut plan, &emit_settings)
    c.report = reporting
}
fn walk_body(c: &mut Session, f: i32, model: &mut opt_ir.Function, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace) {
    var started: i64 = -1
    if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
    type_body(&mut c, f, &mut model, &catalog, &mut inline_work)
    if c.bindings.profile.enabled {
        var phase := 7
        if model.probing { phase = 1 }
        profile.finish(&mut c.bindings.profile, phase, started, i64(c.body.cursor - c.world.starts[f] + 1))
    }
}

fn type_body(c: &mut Session, f: i32, model: &mut opt_ir.Function, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace) {
    if c.inline_enabled { fragments.reset_dependencies(&mut c.body.inline_deps) }
    reset_body(&mut c.body)
    c.body.current_owner = c.world.function_owners[f]
    c.body.testing = c.world.test_functions[f]
    c.body.unsafe_scope = c.world.unsafe_functions[f]
    c.body.block_base = arm.label_count(&c.code); c.body.cleanup = new_block(&mut c)
    c.body.slots = 0; c.body.scope = 0; c.body.ret_type = c.world.returns[f]; c.body.cursor = c.world.starts[f] - 1
    arm.mark(&mut c.code, c.fn_labels[f]); frame := arm.prologue(&mut c.code)
    first := c.world.param_starts[f]
    c.body.first_parameter = first
    for p in 0..c.world.param_counts[f] {
        index := slot(&mut c); bind(&mut c, &mut model, c.world.param_names[first + p], c.world.param_types[first + p], false, index, c.world.param_tokens[first + p])
        if owned(&c, c.world.param_types[first + p]) { remember_owner(&mut c, index, c.world.param_types[first + p], false) }
        if p < 8 { arm.store(&mut c.code, index, p) }
        else { load_mem(&mut c, 0, 29, 16 + (p - 8) * 16); arm.store(&mut c.code, index, 0) }
    }
    param_owners := c.body.owned_slots.len
    initialize := arm.label(&mut c.code); body := arm.label(&mut c.code)
    arm.branch(&mut c.code, initialize, 0); arm.mark(&mut c.code, body)
    c.body.scope = -1
    returns := block(&mut c, true, &catalog, &mut inline_work, &mut model)
    if c.ok && c.code.prefixing && !model.recording { declined := decline_projection(&mut c, &mut model) }
    if c.body.ret_type != 0 && !returns { fail(&mut c, "function can finish without returning a value") }
    arm.imm(&mut c.code, 0, 0); bind_block(&mut c, c.body.cleanup); arm.push_temp(&mut c.code, 0)
    var task_cleanup := c.body.task_handles.len - 1
    while task_cleanup >= 0 { task_close_slot(&mut c, c.body.task_handles[task_cleanup]); task_cleanup = task_cleanup - 1 }
    cleanup_from(&mut c, 0, false); arm.pop_temp(&mut c.code, 0); arm.ret(&mut c.code)
    arm.mark(&mut c.code, initialize)
    for t in 0..c.body.task_handles.len { arm.store(&mut c.code, c.body.task_handles[t], 31) }
    for o in param_owners..c.body.owned_slots.len { if c.body.owned_slots[o] >= 0 { owner_store(&mut c, .Initialize, c.body.owned_types[o], c.body.owned_slots[o]) } }
    arm.branch(&mut c.code, body, 0)
    if c.ok { arm.frame(&mut c.code, frame, c.body.slots) }
}

fn finish_image(c: &mut Session, platform: i32, main_id: i32, rt: &runtime.Runtime, record_takes: &mut record_take.Plan) -> Result {
    for id in 0..c.callback_labels.len { if c.callback_labels[id] >= 0 { callback_entry(&mut c, id) } }
    arm.mark(&mut c.code, c.float_trap); arm.exit(&mut c.code, 107)
    arm.mark(&mut c.code, c.bounds); arm.exit(&mut c.code, 103)
    assert(record_take.emit_array_take(&mut c.code, c.array_take))
    if record_take.status(&record_takes) == 2 { assert(record_take.emit_helpers(&mut c.code, &mut record_takes, c.array_take)) }
    clones(&mut c)
    arm.runtime(&mut c.code, c.print_int, c.print_bool, c.print_text, c.write, c.overflow, c.zero, c.assertion, c.io)
    runtime.emit_runtime(&mut c.code, &rt)
    data_start := c.code.words.len
    literals(&mut c)
    runtime.emit_profile_data(&mut c.code, &rt)
    var text: []u8 = []
    if platform == 3 {
        image := cs.assemble_wasm(&c.code, data_start, c.fn_labels[main_id], c.world.returns[main_id], &c.wasm_abi)
        if !image.ok { return Result { ok: false, error: image.error, offset: 0, text: [], imports: c.imports } }
        text = image.text
    } else if platform == 2 {
        native := cs.assemble_x86(&c.code, data_start, &c.imports.sites, &c.imports.slots)
        if !native.ok { return Result { ok: false, error: native.error, offset: 0, text: [], imports: c.imports } }
        c.imports.sites = native.imports
        text = native.text
    } else {
        text = arm.finish_for(&mut c.code, c.imports.symbols.len > 0 || c.imports.globals > 0)
    }
    var out_imports := c.imports
    if platform == 3 { out_imports = imports() }
    Result { ok: true, error: "", offset: 0, text: text, imports: out_imports }
}
fn ownership_test_compile(source: string, platform: i32, enabled: bool, checking: bool) -> Result {
    none: []i32 = []; var records := bindings(); var config := configuration()
    config.ownership_enabled = enabled
    var tokens := lexer.scan(source, false)
    compile_options(&mut tokens, platform, &none, &none, checking, false, &mut records, "", "", &config)
}
@test fn ordered_import_conflict_precedes_a_later_body_error() {
    source := "capability unsafe\n@extern(\"first\",\"collide\") unsafe fn one()\n@extern(\"second\",\"collide\") unsafe fn two()\nfn main(){unsafe { one(); two() }; unused := missing}\n"
    none: []i32 = []
    for checking in [false, true] {
        var records := bindings()
        result := compile_mode(source, 1, &none, &none, checking, false, &mut records)
        assert(!result.ok && result.error == "ELF cannot bind one symbol to two libraries; select a handle with std.dl")
    }
}
@test fn caller_tokens_survive_repeated_floating_compilations() {
    var input := lexer.scan("fn main() { x: f64 = 1.5; print(x.str()) }", false)
    count := input.kinds.len; last := input.starts[count - 1]
    var records := bindings(); none: []i32 = []
    first := compile_tokens(&mut input, 0, &none, &none, false, false, &mut records)
    assert(first.ok && input.kinds.len == count && input.starts[count - 1] == last)
    again := compile_tokens(&mut input, 0, &none, &none, false, false, &mut records)
    assert(again.ok && input.kinds.len == count)
    assert(first.text.len == again.text.len)
    for i in 0..first.text.len { assert(first.text[i] == again.text[i]) }
}

@test fn string_operand_leases_are_removed_only_across_effect_free_rhs() {
    for platform in 0..4 {
        pure := "fn main(){left:=\"a\";right:=\"b\";print(left==right);print(left+right)}"
        before := ownership_test_compile(pure, platform, false, false)
        after := ownership_test_compile(pure, platform, true, false)
        before.ok
        after.ok
        after.text.len < before.text.len
        calls := "fn rhs()->string{\"b\"} fn main(){print(\"a\"==rhs())}"
        kept := ownership_test_compile(calls, platform, true, false)
        original := ownership_test_compile(calls, platform, false, false)
        kept.ok
        original.ok
        kept.text.len == original.text.len
        for i in 0..kept.text.len { kept.text[i] == original.text[i] }
    }
}
@test fn ownership_proofs_do_not_change_validation_or_binding_records() {
    none: []i32 = []
    for platform in 0..4 {
        for source in ["fn main(){print(\"a\"==true)}", "fn unused()->string{true} fn main(){print(\"a\"==\"b\")}", "fn main(){value:=\"a\";value=\"b\"}"] {
            off := ownership_test_compile(source, platform, false, false)
            on := ownership_test_compile(source, platform, true, false)
            checked := ownership_test_compile(source, platform, true, true)
            !off.ok
            !on.ok
            !checked.ok
            off.error == on.error
            off.offset == on.offset
            on.error == checked.error
            on.offset == checked.offset
        }
        source := "fn main(){left:=\"a\";right:=\"b\";print(left==right)}"
        var off_tokens := lexer.scan(source, false); var on_tokens := lexer.scan(source, false)
        var off_records := bindings(); var on_records := bindings()
        var config := configuration(); config.ownership_enabled = false
        off := compile_options(&mut off_tokens, platform, &none, &none, true, true, &mut off_records, "", "", &config)
        config.ownership_enabled = true
        on := compile_options(&mut on_tokens, platform, &none, &none, true, true, &mut on_records, "", "", &config)
        off.ok
        on.ok
        off.text.len == 0 && on.text.len == 0
        off_records.offsets.len == on_records.offsets.len
        for i in 0..off_records.offsets.len {
            off_records.offsets[i] == on_records.offsets[i]
            off_records.names[i] == on_records.names[i]
            off_records.types[i] == on_records.types[i]
        }
    }
}
@test fn rune_literals_emit_the_same_code_as_scalar_constants() {
    for platform in 0..4 {
        runes := compile_for("fn main(){print(`\\0` == `\\u{0}`);print(`å` == `\\u{e5}`);print(`🌍` == `\\u{1f30d}`)}", platform)
        integers := compile_for("fn main(){print(0 == 0);print(229 == 229);print(127757 == 127757)}", platform)
        runes.ok
        integers.ok
        // Equal machine code proves there is no literal-only conversion call,
        // allocation, cleanup or embedded UTF-8 string left in the runtime path.
        runes.text.len == integers.text.len
        for i in 0..runes.text.len { runes.text[i] == integers.text[i] }
    }
}
@test fn compiler_checks_types_before_emitting_an_image() {
    none: []i32 = []
    for platform in 0..4 {
        var records := bindings()
        checked := compile_mode("fn unused()->i32{values: [u8;4]=[7;4];i32(values[0])} fn main(){print(42)}", platform, &none, &none, true, false, &mut records)
        checked.ok
        checked.text.len == 0
        records.emitted == 0
        invalid := "fn unused()->i32{true} fn main(){print(42)}"
        rejected := compile_mode(invalid, platform, &none, &none, true, false, &mut records)
        built := compile_for(invalid, platform)
        !rejected.ok
        rejected.error == built.error
        rejected.offset == built.offset
        // Direct token clients have the same lexical value/type shadowing
        // rule as file/module clients, independently of optimization mode.
        for source in [
            "enum Values{Other} fn size(Values:&[]i64)->i32{Values.len} fn main(){values:[]i64=[1,2];print(size(&values))}",
            "struct Bound{} fn count(Bound:i32)->i32{var result:=0;for i in 0..Bound{result=result+1};result} fn main(){print(count(3))}",
            "enum Values{Other} fn update(Values:&mut []i64){for i in 0..Values.len{Values[i]=Values[i]+1}} fn main(){var values:[]i64=[1,2];update(&mut values);print(values[0])}"
        ] {
            for enabled in [false, true] {
                var tokens := lexer.scan(source, false)
                result := compile_configured(&mut tokens, platform, &none, &none, true, false, &mut records, "", "", enabled)
                result.ok
            }
        }
    }
    compile("fn add(x:i32,y:i32)->i32{x+y} fn main(){print(add(20,22))}").ok
    !compile("fn main(){x:=1;x=2}").ok
    !compile("fn main(){var x:=1;x=true}").ok
    !compile("fn f(x:i32)->i32{} fn main(){}").ok
    !compile("fn unused()->i32{true} fn main(){print(42)}").ok
    !compile("fn main(){print(unknown)}").ok
    !compile("fn main(){print(2147483648)}").ok
    !compile("fn main(){if 1 {}}").ok
    !compile("fn main(){for i in 0..2{i=3}}").ok
    !compile("import sys\nfn main(){}").ok
}

@test fn native_compiler_rejects_unsupported_aggregate_shapes_and_immutable_mutation() {
    compile_for("fn main(){var a:[i32;2]=[1,2]}", 1).ok
    !compile_for("fn main(){var a:[i32;2]=[1]}", 1).ok
    !compile_for("struct Box{value:i32} fn main(){var a:[]Box=[]}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];a.clear()}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];a.reserve(8)}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];x:=a.pop()}", 1).ok
    !compile_for("fn f(x:i32)->i32{x} fn main(){var a:=1;f(a)=2}", 1).ok
    !compile_for("fn f()->i32{42} fn main(){f:=1;print(f())}", 1).ok
    !compile_for("fn main(){var a:=true;(!a)=false}", 1).ok
    !compile_for("fn main(){var a:=1;(-a)=2}", 1).ok
    compile_for("enum K{A,B} struct Box{values:[]i32,tag:K} fn main(){var b:=Box{values:[1,2],tag:.A};b.values.push(3);b.tag=.B;print(b.values.len)}", 1).ok
}
@test fn target_is_folds_at_compile_time_and_prunes_dead_extern_branches() {
    gated := "capability unsafe\n@extern(\"c\", \"unused_mac\")\nunsafe fn c_mac() -> i32\nfn pick() -> i32 {\n    if target_is(\"macos\") {\n        unsafe { _ := c_mac(); _ := static_bytes(\"macos\", 16) }\n        return 1\n    } else if target_is(\"linux\") {\n        return 2\n    } else {\n        return 3\n    }\n}\nfn main() { _ := pick() }\n"
    r0 := compile_for(gated, 0)
    r1 := compile_for(gated, 1)
    r2 := compile_for(gated, 2)
    r3 := compile_for(gated, 3)
    assert(r0.ok && r0.imports.symbols.len == 1 && r0.imports.symbols[0] == "unused_mac" && r0.imports.globals == 80)
    assert(r1.ok && r1.imports.symbols.len == 0 && r1.imports.globals == 0)
    assert(r2.ok && r2.imports.symbols.len == 0 && r2.imports.globals == 0)
    assert(r3.ok)

    predicates := [
        "macos", "arm64-macos", "aarch64-apple-darwin",
        "linux", "arm64-linux", "aarch64-unknown-linux-gnu",
        "x86_64-linux", "x86_64-unknown-linux-gnu",
        "arm64", "x86_64", "native",
        "wasm32", "wasm32-unknown-unknown"
    ]
    expected_bits := [
        "1110000010100",
        "0001110010100",
        "0001001101100",
        "0000000000011"
    ]
    for platform in 0..4 {
        for i in 0..predicates.len {
            p := predicates[i]
            taken := "fn main() { if target_is(\"" + p + "\") { } else { missing_branch_symbol } }"
            assert(compile_for(taken, platform).ok == (expected_bits[platform][i..i + 1] == "1"))
        }
        compound := "fn main() { if !target_is(\"wasm32\") && (target_is(\"arm64\") || target_is(\"x86_64\")) { } else { missing_branch_symbol } }"
        assert(compile_for(compound, platform).ok == (platform != 3))
        if platform == 3 {
            assert(!compile_for("capability unsafe\nfn main() { if target_is(\"wasm32\") { unsafe { _ := static_bytes(\"native\", 16) } } }", platform).ok)
            assert(compile_for("capability unsafe\nfn main() { if target_is(\"native\") { unsafe { _ := static_bytes(\"native\", 16) } } }", platform).ok)
        } else {
            assert(compile_for("capability unsafe\nfn main() { if target_is(\"wasm32\") { unsafe { _ := static_bytes(\"native\", 16) } } }", platform).ok)
        }
    }
    assert(!compile_for("fn main() { if target_is(\"plan9\") { } }", 0).ok)
    assert(!compile_for("fn main() { x := \"linux\"; if target_is(x) { } }", 0).ok)
}

fn inline_test_compile(source: string, platform: i32, enabled: bool, scalar: bool, checking: bool, report: bool, records: &mut Bindings) -> Result {
    none: []i32 = []; var tokens := lexer.scan(source, false); var settings := configuration()
    settings.inline_enabled = enabled; settings.scalar_enabled = scalar
    compile_options(&mut tokens, platform, &none, &none, checking, report, &mut records, "", "", &settings)
}
@test fn inline_producer_preserves_authoritative_diagnostics_and_scalar_off_behavior() {
    for platform in 0..4 {
        for source in [
            "fn step(x:i32)->i32{x+1} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{var y:=x;y=y+1;y} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{if x>0{return x};-x} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+1} fn main(){step:=1;print(step(2))}",
            "fn step(x:i32)->i32{x=2;x} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+2147483648} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+missing} fn main(){}",
            "fn step(x:i32)->i32{if false{return true};x} fn main(){}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step(true))}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step(1,2))}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step())}"
        ] {
            for checking in [false, true] {
                var before := bindings(); var after := bindings()
                old := inline_test_compile(source, platform, false, true, checking, false, &mut before)
                current := inline_test_compile(source, platform, true, true, checking, false, &mut after)
                assert(old.ok == current.ok && old.error == current.error && old.offset == current.offset)
                assert(before.modeled == after.modeled && before.optimized == after.optimized && before.emitted == after.emitted && before.fallbacks == after.fallbacks)
            }
        }
        var before := bindings(); var after := bindings()
        source := "fn step(x:i32)->i32{x+1} fn main(){print(step(2))}"
        old := inline_test_compile(source, platform, false, false, false, false, &mut before)
        disabled := inline_test_compile(source, platform, true, false, false, false, &mut after)
        assert(old.ok && disabled.ok && old.text.len == disabled.text.len)
        for at in 0..old.text.len { assert(old.text[at] == disabled.text[at]) }
    }
}
@test fn a_deferred_local_has_one_binding_across_all_exit_edges() {
    source := "fn run(n:i32)->i32{defer {saved:=n;print(saved)};if n==1{return 1};if n==2{return 2};3} fn main(){print(run(2))}"
    none: []i32 = []
    for checking in [true, false] {
        var records := bindings()
        result := compile_mode(source, 0, &none, &none, checking, true, &mut records)
        assert(result.ok)
        var reports := 0
        for name in records.names { if name == "saved" { reports = reports + 1 } }
        assert(reports == 1)
    }
}
@test fn inline_producer_does_not_duplicate_source_binding_reports() {
    source := "fn step(x:i32)->i32{x+1} fn main(){value:=3;print(step(value))}"
    for platform in 0..4 {
        var before := bindings(); var after := bindings()
        old := inline_test_compile(source, platform, false, true, false, true, &mut before)
        current := inline_test_compile(source, platform, true, true, false, true, &mut after)
        assert(old.ok && current.ok && before.offsets.len == after.offsets.len && before.modeled == after.modeled)
        assert(before.optimized == after.optimized && before.emitted == after.emitted)
        assert(before.inline_entries == 0 && before.inlined_calls == 0 && before.inline_tokens == 0)
        assert(after.inline_entries == 1 && after.inline_nodes == 3 && after.inline_units > 0 && after.inline_tokens > 0 && after.inline_tokens <= 32768)
        assert(after.inlined_calls == 1 && after.inlined_words > 0 && after.inlined_words <= after.inline_estimated_words && after.inline_estimated_words <= 65536)
        for at in 0..before.offsets.len {
            assert(before.offsets[at] == after.offsets[at] && before.names[at] == after.names[at] && before.types[at] == after.types[at])
        }
    }
}

fn inline_cache_test_compile(source: string, platform: i32, directory: string, records: &mut Bindings) -> Result {
    none: []i32 = []; var tokens := lexer.scan(source, false); var settings := configuration()
    settings.inline_enabled = true
    compile_options(&mut tokens, platform, &none, &none, false, false, &mut records, directory, "inline-dependencies-test:v2", &settings)
}
fn same_test_image(left: &Result, right: &Result) -> bool {
    if !left.ok || !right.ok || left.text.len != right.text.len { return false }
    for at in 0..left.text.len { if left.text[at] != right.text[at] { return false } }
    true
}
@test fn inline_fragments_restore_backward_dependencies_charges_and_private_body_identity() {
    for platform in 0..3 {
        directory := "build/inline-dependency-unit/" + platform.str()
        for source in ["fn step(x:i32)->i32{x+1} fn main(){print(step(8))}", "fn step(x:i32)->i32{x+2} fn main(){print(step(8))}"] {
            var fresh := bindings(); var first := bindings(); var warm := bindings()
            reference := inline_cache_test_compile(source, platform, "", &mut fresh)
            initial := inline_cache_test_compile(source, platform, directory, &mut first)
            restored := inline_cache_test_compile(source, platform, directory, &mut warm)
            assert(same_test_image(&reference, &initial) && same_test_image(&reference, &restored))
            assert(warm.reused == 2 && warm.emitted == 0 && warm.modeled == 0 && warm.optimized == 0 && warm.fallbacks == 0)
            assert(warm.inlined_calls == 0 && warm.inlined_words == 0 && warm.inline_estimated_words == fresh.inline_estimated_words)
            assert(fresh.inlined_calls == 1 && fresh.inline_estimated_words > 0)
        }
        // Empty dependency/charge payloads are legitimate legacy fragments.
        source := "fn main(){print(42)}"
        var fresh := bindings(); var first := bindings(); var warm := bindings()
        reference := inline_cache_test_compile(source, platform, "", &mut fresh)
        initial := inline_cache_test_compile(source, platform, directory, &mut first)
        restored := inline_cache_test_compile(source, platform, directory, &mut warm)
        assert(same_test_image(&reference, &initial) && same_test_image(&reference, &restored))
        assert(warm.reused == 1 && warm.emitted == 0 && warm.inline_estimated_words == 0)
    }
}
fn inline_budget_test_source(first_count: i32) -> string {
    var source := "fn step(x:i32)->i32{x+1} "
    for function in 0..20 {
        source = source + "fn consume" + function.str() + "()->i32{var sum:=0;"
        var count := 100; if function == 0 { count = first_count }
        for call in 0..count { source = source + "sum=sum+step(1);" }
        source = source + "sum} "
    }
    source = source + "fn main(){var total:=0;"
    for function in 0..20 { source = source + "total=total+consume" + function.str() + "();" }
    source + "print(total)}"
}
@test fn inline_budget_is_local_to_each_caller_across_partial_cache_hits() {
    directory := "build/inline-frontier-unit"
    // Changing the first caller may change its own charge. The remaining
    // callers keep their budget and can reuse their cached expansions.
    var previous_count := -1
    for count in [100, 5, 100] {
        source := inline_budget_test_source(count)
        var fresh := bindings(); var mixed := bindings(); var warm := bindings()
        reference := inline_cache_test_compile(source, 0, "", &mut fresh)
        partial := inline_cache_test_compile(source, 0, directory, &mut mixed)
        restored := inline_cache_test_compile(source, 0, directory, &mut warm)
        assert(same_test_image(&reference, &partial) && same_test_image(&reference, &restored))
        assert(warm.reused == 22 && warm.emitted == 0 && warm.modeled == 0 && warm.fallbacks == 0)
        if previous_count >= 0 { assert(mixed.reused == 21) }
        previous_count = count
        assert(fresh.inline_estimated_words > 65536 && mixed.inline_estimated_words == fresh.inline_estimated_words && warm.inline_estimated_words == fresh.inline_estimated_words)
        assert(warm.inlined_calls == 0 && warm.inlined_words == 0 && fresh.inlined_calls > 0)
    }
}

@test fn all_emitted_source_functions_use_mir_without_changing_diagnostics_or_bindings() {
    none: []i32 = []
    for platform in 0..4 {
        for source in [
            "fn inc(x:i32)->i32{x+1} fn main(){print(inc(3))}",
            "fn inc(x:i32)->i32{x+1} fn main(){var text:=\"x\";var sum:=0;for i in 0..8{sum=sum+inc(i);text=text+\"z\"};print(text);print(sum)}",
            "fn change(values:&mut []i64){for i in 0..values.len{values[i]=values[i]+1}} fn main(){var values:[]i64=[1,2];change(&mut values);print(values[0])}",
            "fn recurse(x:i32)->i32{if x==0{return 1};x*recurse(x-1)} fn main(){print(recurse(4))}"
        ] {
            for checking in [false, true] {
                var plain := configuration(); plain.mir_opt_enabled = false; optimized := configuration()
                var before := bindings(); var after := bindings(); var left := lexer.scan(source, false); var right := lexer.scan(source, false)
                a := compile_options(&mut left, platform, &none, &none, checking, true, &mut before, "", "", &plain)
                b := compile_options(&mut right, platform, &none, &none, checking, true, &mut after, "", "", &optimized)
                assert(a.ok && b.ok && a.offset == b.offset && a.error == b.error && before.offsets.len == after.offsets.len)
                for at in 0..before.offsets.len { assert(before.offsets[at] == after.offsets[at] && before.names[at] == after.names[at] && before.types[at] == after.types[at]) }
                assert(before.mir_functions == after.mir_functions && before.mir_functions == before.emitted)
                if checking { assert(before.mir_operations == 0 && after.mir_operations == 0) }
                else { assert(before.mir_functions > 0 && before.mir_operations >= before.mir_functions && after.mir_operations >= after.mir_functions) }
            }
        }
    }
}

@test fn whole_function_optimizer_policy_and_actual_counters_follow_pass_execution() {
    source := "fn next(x:i32)->i32{x+1} fn main(){var sum:=0;for i in 0..12{sum=sum+next(i)};print(sum)}"
    none: []i32 = []
    for platform in 0..4 {
        for mode in 0..3 {
            var config := configuration(); config.mir_opt_enabled = mode != 0
            checking := mode == 2
            var records := bindings(); var tokens := lexer.scan(source, false)
            result := compile_options(&mut tokens, platform, &none, &none, checking, false, &mut records, "", "", &config)
            assert(result.ok)
            if mode != 1 {
                assert(!records.mir_optimization_enabled && records.mir_optimized == 0 && records.mir_promoted == 0)
                assert(records.mir_removed_loads == 0 && records.mir_removed_stores == 0 && records.mir_analysis_units == 0 && records.mir_budget_refusals == 0)
            } else {
                assert(records.mir_optimization_enabled && records.mir_functions == records.emitted && records.mir_functions > 0)
                assert(records.mir_analysis_units > 0)
                if records.mir_optimized > 0 { assert(records.mir_promoted > 0 && records.mir_removed_loads > 0 && records.mir_removed_stores > 0) }
                else { assert(records.mir_promoted == 0 && records.mir_removed_loads == 0 && records.mir_removed_stores == 0) }
            }
        }
    }
}
