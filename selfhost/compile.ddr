// operand. Names with known types take precedence over a default decimal.
fn float_context(c: &Compiler, expected: i32) -> i32 {
    if !c.float_source || expected == 1 || expected == 2 || unsigned.has(expected) || floats.has(expected) { return expected }
    first := c.tokens.kinds[c.cursor]
    if first != .Integer && first != .Float && !is(&c, "(") && !is(&c, "-") { return expected }
    var pos := c.cursor
    var depth := 0
    var decimal_seen := false
    while pos < c.tokens.kinds.len {
        kind := c.tokens.kinds[pos]; word := c.tokens.texts[pos]
        if kind == .Float { decimal_seen = true }
        else if kind == .Name {
            index := local(&c, word)
            if index >= 0 {
                ty := c.local_types[index]
                if floats.has(ty) { return ty }
