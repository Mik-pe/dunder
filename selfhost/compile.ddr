        var count := 0; var repeated := false
        allocation := arm.position(&c.code); source := c.world.tokens.starts[token]
        arm.intrinsic_call(&mut c.code, c.runtime.array_new, .ArrayNew, base, expected, source)
        saved := slot(&mut c); arm.store(&mut c.code, saved, 0)
        while c.ok && !is(&c, "]") {
            element_source := c.world.tokens.starts[c.body.cursor]
            ty := expression(&mut c, 0, base, &catalog, &mut inline_work, &mut model); if base == 0 { base = ty } else { same(&mut c, base, ty) }
            if count == 0 && eat(&mut c, ";") {
                repeated = true; count = length_literal(&mut c)
                item := slot(&mut c); left := slot(&mut c); arm.store(&mut c.code, item, 0)
                arm.imm(&mut c.code, 0, i64(count)); arm.store(&mut c.code, left, 0)
                head := arm.label(&mut c.code); done := arm.label(&mut c.code)
                arm.mark(&mut c.code, head); arm.load(&mut c.code, left); arm.branch(&mut c.code, done, 18)
                arm.integer_binary(&mut c.code, 2, true, false, 0, 0, -1, 1); arm.store(&mut c.code, left, 0)
                arm.load(&mut c.code, item); copy_value(&mut c, ty); arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, saved)
                arm.intrinsic_call(&mut c.code, c.runtime.array_push, .ArrayInitializeElement, ty, 0, element_source); arm.branch(&mut c.code, head, 0); arm.mark(&mut c.code, done)
                break
            }
            count = count + 1; take_value(&mut c, ty)
            arm.push_temp(&mut c.code, 0); arm.load(&mut c.code, saved); arm.pop_temp(&mut c.code, 1); arm.intrinsic_call(&mut c.code, c.runtime.array_push, .ArrayInitializeElement, ty, 0, element_source)
            if !eat(&mut c, ",") { break }
        }
        expect(&mut c, "]"); arm.load(&mut c.code, saved); c.body.address = -1; c.body.writable = false
