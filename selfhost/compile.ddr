        }
        if model.probing && decline_projection(&mut c, &mut model) { return 0 }
        name := c.world.tokens.texts[token]
        // Value expressions resolve lexical bindings first, as module name
        // resolution does. Type annotations still use the type namespace.
        var nominal := -1
        if found < 0 { nominal = type_id(&c, name) }
