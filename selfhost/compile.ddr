fn condition_constructor(c: &Compiler, open: i32) -> bool {
    if open == 0 || c.tokens.kinds[open - 1] != .Name || c.closes[open] < 0 { return false }
    if open > 1 && c.tokens.kinds[open - 2] == .Symbol && c.tokens.texts[open - 2] == "." { return false }
