        if ft.type_kind(&c.types, want) != 4 && ft.type_kind(&c.types, want) != 5 { continue }
        place := arg_places[arg]; root := borrows.root(&c.body.places, place)
        if root < 0 { continue }
        element := borrows.has_index(&c.body.places, place)
        var refresh := false
        for sibling in 0..provided {
            if sibling == arg { continue }
            sibling_kind := ft.type_kind(&c.types, ft.parameter_type(&c.types, first + sibling))
            if (sibling_kind == 4 || sibling_kind == 5) && borrows.root(&c.body.places, arg_places[sibling]) == root &&
                (ft.type_kind(&c.types, want) == 5 || sibling_kind == 5) {
                fail(&mut c, "mutable arguments must not alias another borrow in the same call")
                c.error_at = c.world.tokens.starts[arg_sources[sibling]]; return 0
            }
            if borrows.changed(&c.body.mutations, effects[sibling], effects[sibling + 1], root) {
                if element { fail(&mut c, "compute mutations before borrowing an array element"); c.error_at = c.world.tokens.starts[arg_starts[sibling]]; return 0 }
                if sibling > arg { refresh = true }
            }
        }
        // A later argument may have replaced a heap-backed record. Re-resolve
        // the pure field borrow after it, as the source-level place is stable.
        if refresh {
            lower_place(&mut c, place, 0, .ValueAndAddress, arg_sources[arg])
            borrow_address(&mut c, ft.type_base(&c.types, want), ft.type_kind(&c.types, want) == 5, arg_starts[arg], place)
            arm.store(&mut c.code, args[arg], 0)
        }
    }
    if c.inline_enabled && !c.validating_dead && !c.code.checking && f >= 0 && address < 0 && wasm_sig < 0 &&
        fragments.remaining_words(&c.body.inline_deps) > 0 && opt_inline.find_view(&catalog, f) >= 0 {
        var arg_types: []i32 = []
        for p in 0..provided { arg_types.push(ft.parameter_type(&c.types, first + p)) }
        budget := fragments.remaining_words(&c.body.inline_deps)
        if opt_inline.prepare_view(&mut inline_work, &catalog, f, address, &arg_types, ft.type_base(&c.types, signature), &args, c.body.slots, c.code.platform, budget) {
            estimate := opt_inline.word_estimate(&inline_work)
            first_word := arm.position(&c.code)
            if opt_inline.emit_view(&mut inline_work, &mut c.code, &catalog, c.overflow, c.zero, c.bounds) {
                // Admission follows successful, bounded emission. An impossible
                // metadata failure aborts compilation before publishing code.
                if !charge_inline(&mut c, f, estimate, first_word) { return 0 }
