}
// Check-only preserves the existing reachable-function validation order, but
// never constructs backend arenas, captures machine spans or enters lowering.
fn check_sources(c: &mut Compiler, compiled: &mut []bool, scalar_model: &mut opt_ir.Function,
    scalar_work: &mut opt_verify.Workspace, scalar_plan: &mut opt_alloc.Plan, machine_work: &mut machine_ir.Workspace,
    emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace, catalog: &opt_inline.Catalog, inline_work: &mut opt_inline.Workspace) {
    var more := true
    while c.ok && more {
        more = false
        for f in 0..c.names.len {
            if !c.ok { break }; if !c.needed[f] || compiled[f] || c.libraries[f] != "" { continue }
            compiled[f] = true; more = true
            compile_body(&mut c, f, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &mut machine_work, &emit_settings, &mut range_work, &catalog, &mut inline_work)
        }
    }
}
// Every newly emitted source function, from either source lowering path, has
// the same whole-function MIR boundary. Cached objects are already final code.
fn emit_sources(c: &mut Compiler, compiled: &mut []bool, cache: string, directory: string, globals: i32,
    scalar_model: &mut opt_ir.Function, scalar_work: &mut opt_verify.Workspace, scalar_plan: &mut opt_alloc.Plan,
    machine_work: &mut machine_ir.Workspace, emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace,
    catalog: &opt_inline.Catalog, inline_work: &mut opt_inline.Workspace) {
    var function := mir.new(); var lifter := mir_lift.new_work(); var verifier := mir_verify.new_work(); var backend := mir_lower.new(); var optimizer := mir_opt.new(); var values := mir_value_prop.new(); var value_plan := mir.new(); var restored_deps := fragments.new_dependencies()
    // Only this complete, semantically checked source producer may assert the
    // object-memory contract. Arbitrary raw MIR keeps its conservative API.
    var memory_context := mir_memory.for_source_producer(c.mir_memory_enabled)
    // These producer-owned targets overwrite the exit status and terminate
    // without reading incoming GP/FP/NZCV values. No ordinary call receives
    // this contract; a merely nonreturning target could still observe them.
    var value_exits := mir_value_prop.context(1)
    assert(mir_value_prop.declare_unobserving_terminal(&mut value_exits, c.overflow))
    assert(mir_value_prop.declare_unobserving_terminal(&mut value_exits, c.zero))
    assert(mir_value_prop.declare_unobserving_terminal(&mut value_exits, c.assertion))
    assert(mir_value_prop.declare_unobserving_terminal(&mut value_exits, c.io))
    assert(mir_value_prop.declare_unobserving_terminal(&mut value_exits, c.bounds))
    assert(mir_value_prop.declare_unobserving_terminal(&mut value_exits, c.float_trap))
    var more := true
    while c.ok && more {
        more = false
        for f in 0..c.names.len {
            if !c.ok { break }; if !c.needed[f] || compiled[f] || c.libraries[f] != "" { continue }
            compiled[f] = true; more = true
            begin := fragments.start(&c.code); types_before := c.type_names.len
            strings_before := c.strings.len; sites_before := c.imports.sites.len
            globals_before := c.imports.globals
            var fingerprint := ""; var path := ""
            if cache != "" && !needs_loan_analysis(&c, f) {
                var started: i64 = -1
                if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
                var context := cache
                if c.inline_enabled {
                    // A previously partial fragment must not suppress fresh
                    // opportunities when earlier callers consume less budget.
                    // Choices depend on min(global remaining, caller limit).
                    var frontier := c.inline_global_words
                    if frontier > 4096 { frontier = 4096 }
                    context = context + ":inline-frontier:" + frontier.str()
                }
                fingerprint = fragments.key(context,f,&c.tokens,c.starts[f],c.ends[f])
                path = directory + "/" + f.str() + ".fn"
                var restored := false
                if c.inline_enabled {
                    // The output buffer is an external root: mutable code and
                    // mutable dependency fields must not alias Compiler.
                    fragments.reset_dependencies(&mut restored_deps)
                    restored = fragments.restore_cached_with_dependencies(&mut c.code, globals, c.fn_labels[f], path, fingerprint, c.names.len, c.inline_global_words, &mut restored_deps)
                } else { restored = fragments.restore(&mut c.code,globals,c.fn_labels[f],path,fingerprint) }
                if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 8, started, 1) }
                if restored {
                    c.bindings.reused = c.bindings.reused + 1
                    if c.inline_enabled {
                        // Both bounds and metadata were validated before Code
                        // commit. Restore reachability and the global frontier
                        // before another function can consume inline budget.
                        for declaration in restored_deps.declarations { c.needed[declaration] = true }
                        c.inline_global_words = c.inline_global_words - restored_deps.charged_words
                        c.bindings.inline_estimated_words = c.bindings.inline_estimated_words + restored_deps.charged_words
                    }
                    for r in begin.relocations..c.code.target.len {
                        label := c.code.target[r]
                        if label < globals { for id in 0..c.fn_labels.len {
                            if c.fn_labels[id] == label {
                                c.needed[id] = true
                                if c.loans.active && c.code.kinds[r] == 20 { c.loans.taken[id] = true }
                                break
                            }
                        } }
                    }
                    continue
                }
            }
            if !c.code.checking { c.bindings.emitted = c.bindings.emitted + 1 }
            arm.begin_mir(&mut c.code, c.mir_enabled)
            compile_body(&mut c, f, &mut scalar_model, &mut scalar_work, &mut scalar_plan, &mut machine_work, &emit_settings, &mut range_work, &catalog, &mut inline_work)
            arm.end_mir(&mut c.code)
            if c.ok && c.mir_enabled { lower_source_function(&mut c, f, &begin, sites_before, &mut function, &mut backend, &mut verifier, &mut lifter, &mut optimizer, &memory_context, &mut values, &mut value_plan, &value_exits) }
            if c.ok {
                if fingerprint != "" && !c.has_callbacks && c.type_names.len == types_before && c.strings.len == strings_before && c.imports.sites.len == sites_before && c.imports.globals == globals_before {
                    var started: i64 = -1
                    if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
                    if c.inline_enabled && !c.scalar_function {
                        saved := fragments.save_with_dependencies(&c.code, begin, globals, path, fingerprint, &c.inline_deps, c.names.len)
                    } else { fragments.save(&c.code,begin,globals,path,fingerprint) }
                    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 8, started, 1) }
                }
            }
        }
    }
}
fn lower_source_function(c: &mut Compiler, f: i32, begin: &fragments.Start, first_import: i32,
    function: &mut mir.Function, backend: &mut mir_lower.Workspace, verifier: &mut mir_verify.Workspace, lifter: &mut mir_lift.Workspace, optimizer: &mut mir_opt.Workspace, memory_context: &mir_memory.Context, values: &mut mir_value_prop.Workspace, value_plan: &mut mir.Function, value_exits: &mir_value_prop.Context) {
    var started: i64 = -1
    if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
    lifted := mir_lift.lift_spans_into(&mut function, &mut lifter, &c.code, begin.words, begin.labels, begin.relocations, &c.imports.sites, first_import,
        &c.code.mir_starts, &c.code.mir_ends, &c.code.mir_kinds, &c.code.mir_a, &c.code.mir_b)
    if !lifted { c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR lift failure"); return }
    if !mir_lift.own_entry(&mut function, &c.code, c.fn_labels[f]) { c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR entry failure"); return }
    if !mir_verify.verify_into(&mut function, &mut verifier) { c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR verification failure"); return }
    if c.mir_opt_enabled {
        ready := mir_opt.analyze_with_context(&mut optimizer, &function, &memory_context)
        c.bindings.mir_analysis_units = c.bindings.mir_analysis_units + i64(mir_opt.units(&optimizer))
        if ready {
            mir_opt.apply(&mut optimizer, &mut function)
            if !mir_verify.verify_into(&mut function, &mut verifier) {
                c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR post-pass verification failure"); return
            }
            c.bindings.mir_optimized = c.bindings.mir_optimized + 1
            c.bindings.mir_promoted = c.bindings.mir_promoted + mir_opt.promoted(&optimizer)
            c.bindings.mir_removed_loads = c.bindings.mir_removed_loads + mir_opt.removed_loads(&optimizer)
            c.bindings.mir_removed_stores = c.bindings.mir_removed_stores + mir_opt.removed_stores(&optimizer)
            c.bindings.mir_private_memory_ops = c.bindings.mir_private_memory_ops + mir_opt.private_memory_ops(&optimizer)
        } else {
            state := mir_opt.status(&optimizer)
            if state == -3 { c.bindings.mir_budget_refusals = c.bindings.mir_budget_refusals + 1 }
            else if state != -2 { c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR analysis failure"); return }
            // Unsupported shapes/no profitable place and work-budget refusal
            // leave the verified Function untouched, in the normal pipeline.
        }
    }
    if c.mir_opt_enabled && c.mir_values_enabled {
        ready := mir_value_prop.analyze_with_context(&mut values, &mut value_plan, &function, &value_exits)
        c.bindings.mir_value_analysis_units = c.bindings.mir_value_analysis_units + i64(mir_value_prop.units(&values))
        if ready {
            if !mir_value_prop.apply(&mut values, &value_plan, &mut function) || !function.verified {
                c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR value commit failure"); return
            }
            c.bindings.mir_values_optimized = c.bindings.mir_values_optimized + 1
            c.bindings.mir_value_rewrites = c.bindings.mir_value_rewrites + mir_value_prop.rewritten(&values)
            c.bindings.mir_value_deleted = c.bindings.mir_value_deleted + mir_value_prop.deleted(&values)
            c.bindings.mir_value_immediates = c.bindings.mir_value_immediates + mir_value_prop.constant_immediates(&values)
        } else {
            state := mir_value_prop.status(&values)
            if state == -3 { c.bindings.mir_value_budget_refusals = c.bindings.mir_value_budget_refusals + 1 }
            else if state != 0 && state != -2 { c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR value analysis failure"); return }
        }
    }
    if !mir_lower.prepare(&mut backend, &function, &c.code, &c.imports.sites) {
        c.cursor = c.starts[f]; fail(&mut c, "internal whole-function MIR lowering failure"); return
    }
    mir_lower.commit_code(&mut backend, &mut c.code); mir_lower.commit_imports(&mut backend, &mut c.imports.sites)
    c.bindings.mir_functions = c.bindings.mir_functions + 1
    c.bindings.mir_operations = c.bindings.mir_operations + function.order.len
    for op in 0..function.kinds.len { if function.kinds[op] == 0 { c.bindings.mir_opaque = c.bindings.mir_opaque + 1 } }
    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 11, started, i64(function.order.len)) }
}
// The model handles unowned scalars and stable-shape i64-array borrows.
// Unsupported signatures or bodies leave legacy compiler state and code intact.
fn scalar_type(c: &Compiler, ty: i32) -> i32 {
    if ty >= 0 && ty <= 3 { return ty }
    if c.type_kinds[ty] == 4 || c.type_kinds[ty] == 5 {
        array := c.type_bases[ty]
        if c.type_kinds[array] == 1 && c.type_bases[array] == 2 {
            if c.type_kinds[ty] == 5 { return 21 }
            return 20
        }
    }
    -1
}
// This is a cheap refusal gate, never a source-language acceptance rule.
// Closed expression verification below rejects calls, locals and control flow.
fn inline_signature(c: &Compiler, f: i32) -> bool {
    if c.libraries[f] != "" || c.test_functions[f] || c.unsafe_functions[f] ||
        c.param_counts[f] > 8 || c.returns[f] < 1 || c.returns[f] > 3 || c.ends[f] - c.starts[f] + 2 > 128 { return false }
    first := c.param_starts[f]
    for p in 0..c.param_counts[f] { if c.param_types[first + p] < 1 || c.param_types[first + p] > 3 { return false } }
    true
}
fn inline_candidate(c: &Compiler, f: i32) -> bool {
    for token in c.starts[f]..c.ends[f] {
        kind := c.tokens.kinds[token]
        if kind == .String || kind == .Rune { return false }
        word := c.tokens.texts[token]
        if word == "{" || word == "}" || word == ":=" || word == "=" || word == "var" || word == "if" || word == "else" ||
            word == "for" || word == "while" || word == "match" || word == "break" || word == "continue" || word == "unsafe" || word == "region" { return false }
    }
    true
}
fn inline_catalog(c: &mut Compiler, catalog: &mut opt_inline.Catalog, model: &mut opt_ir.Function,
    work: &mut opt_verify.Workspace, range_work: &mut opt_range.Workspace, source_digests: bool) {
    var remaining := 32768
    // Declaration order makes both admission and budget exhaustion reproducible.
    // The token budget covers the structural refusal walk as well as parsing,
    // independently of the catalog's verified-node budget. Refused models
    // produce no source diagnostic and use legacy parsing.
    for f in 0..c.names.len {
        if !c.ok || opt_inline.exhausted(&catalog) { break }
        if !inline_signature(&c, f) { opt_inline.reject(&mut catalog, f); continue }
        charge := c.ends[f] - c.starts[f] + 2
        if charge > remaining { break }
        remaining = remaining - charge
        if !inline_candidate(&c, f) { opt_inline.reject(&mut catalog, f); continue }
        supported := scalar_prepare(&mut c, f, &mut model, &mut work, &mut range_work, false)
        if !c.ok { return }
        if !supported { opt_inline.reject(&mut catalog, f); continue }
        // Only accepted entries need source identities. Missing identities
        // deliberately make the catalog unsuitable for a fragment context.
        admitted := opt_inline.add_verified(&mut catalog, f, &model, "")
        if admitted && source_digests {
            digest := fragments.key("inline-body:v1", f, &c.tokens, c.starts[f] - 1, c.ends[f])
            if !opt_inline.set_body_digest(&mut catalog, f, digest) { fail(&mut c, "internal inline body identity failure"); return }
        }
    }
    if !opt_inline.seal(&mut catalog) { fail(&mut c, "internal inline catalog invariant failure"); return }
    c.bindings.inline_entries = opt_inline.count(&catalog); c.bindings.inline_nodes = opt_inline.node_count(&catalog)
    c.bindings.inline_tokens = 32768 - remaining; c.bindings.inline_units = opt_inline.units(&catalog)
}
fn scalar_prepare(c: &mut Compiler, f: i32, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace, range_work: &mut opt_range.Workspace, count_fallback: bool) -> bool {
    if !c.scalar_enabled || c.test_functions[f] || c.unsafe_functions[f] || needs_loan_analysis(&c, f) { return false }
    if c.param_counts[f] > 8 || c.returns[f] > 3 || c.ends[f] - c.starts[f] > 8192 { return false }
    c.scalar_names.clear(); c.scalar_types.clear(); c.scalar_tokens.clear()
    first := c.param_starts[f]
    for p in 0..c.param_counts[f] {
        ty := scalar_type(&c, c.param_types[first + p])
        if ty < 1 { return false }
        c.scalar_names.push(c.param_names[first + p]); c.scalar_types.push(ty); c.scalar_tokens.push(c.param_tokens[first + p])
    }
    var started: i64 = -1
    if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
    supported := opt_parse.parse(&mut model, &c.tokens, c.starts[f] - 1, c.ends[f],
        &c.scalar_names, &c.scalar_types, &c.scalar_tokens, c.returns[f])
    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 1, started, i64(c.ends[f] - c.starts[f] + 1)) }
    if !supported {
        if count_fallback { c.bindings.fallbacks = c.bindings.fallbacks + 1 }
        return false
    }
    if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
    var positions_ok := true
    for i in 0..model.nodes.starts.len {
        if model.nodes.starts[i] < 0 || model.nodes.starts[i] >= c.tokens.starts.len { positions_ok = false }
    }
    for i in 0..model.local_at.len {
        if model.local_at[i] < 0 || model.local_at[i] >= c.tokens.starts.len { positions_ok = false }
    }
    before_ok := positions_ok && opt_verify.validate_into(&mut work, &model, false)
    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 2, started, i64(model.nodes.kinds.len)) }
    if !before_ok {
        c.cursor = c.starts[f]
        fail(&mut c, "internal scalar model invariant failure before optimization")
        return true
    }
    if !c.code.checking {
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        opt_pass.run(&mut model)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 3, started, i64(model.visits)) }
        if c.range_enabled {
            // Skip graph analysis unless the model can gain bounds or i32
            // arithmetic proofs. This gate makes no safety decision: the
            // analyzer still validates every admitted model independently.
            var candidate := false
            for local in 0..model.params { if opt_ir.array_type(model.local_types[local]) { candidate = true } }
            if !candidate {
                for node in 0..model.nodes.kinds.len {
                    if model.nodes.types[node] != 1 || model.nodes.proofs[node].bit_and(1) != 0 { continue }
                    kind := model.nodes.kinds[node]; op := model.nodes.values[node]
                    if (kind == 3 && op >= 1 && op <= 3) || (kind == 4 && op == 1) { candidate = true; break }
                }
            }
            if candidate {
                if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
                ready := opt_range.analyze_into(&mut range_work, &model)
                if ready { opt_range.apply(&mut range_work, &mut model) }
                if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 10, started, i64(opt_range.units(&range_work))) }
                if !ready && opt_range.status(&range_work) == 4 {
                    c.cursor = c.starts[f]
                    fail(&mut c, "internal scalar range invariant failure")
                    return true
                }
                // Resource exhaustion leaves all existing proofs unchanged.
            }
        }
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        after_ok := opt_verify.validate_into(&mut work, &model, true)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 4, started, i64(model.nodes.kinds.len)) }
        if !after_ok {
            c.cursor = c.starts[f]
            fail(&mut c, "internal scalar model invariant failure after optimization")
            return true
        }
    }
    true
}
fn scalar_body(c: &mut Compiler, f: i32, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace, plan: &mut opt_alloc.Plan, emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace) -> bool {
    if !scalar_prepare(&mut c, f, &mut model, &mut work, &mut range_work, true) { return false }
    if !c.ok { return true }
    var started: i64 = -1
    c.bindings.modeled = c.bindings.modeled + 1
    if c.report {
        for local in 0..model.local_names.len {
            at := model.local_at[local]
            if at >= 0 && c.tokens.starts[at] < c.source_end {
                ty := model.local_types[local]
                var spelling := "&[]i64"
                if ty == 1 { spelling = "i32" } else if ty == 2 { spelling = "i64" } else if ty == 3 { spelling = "bool" }
                else if ty == 21 { spelling = "&mut []i64" }
                c.bindings.offsets.push(c.tokens.starts[at]); c.bindings.names.push(model.local_names[local]); c.bindings.types.push(spelling)
            }
        }
    }
    if !c.code.checking {
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        opt_alloc.allocate_into(&mut plan, &model)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 5, started, i64(plan.homes.len)) }
        var words := 0
        if c.bindings.profile.enabled { words = arm.position(&c.code) }
        if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
        opt_emit.emit_prepared_configured(&mut c.code, &model, &plan, c.fn_labels[f], c.overflow, c.zero, c.bounds, &emit_settings)
        if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 6, started, i64(arm.position(&c.code) - words)) }
        c.bindings.optimized = c.bindings.optimized + 1
        c.bindings.rewrites = c.bindings.rewrites + model.rewrites
        for node in 0..model.nodes.kinds.len {
            if (model.nodes.kinds[node] == 6 || model.nodes.kinds[node] == 18) && model.nodes.proofs[node].bit_and(2) != 0 { c.bindings.proven_bounds = c.bindings.proven_bounds + 1 }
        }
    }
    return true
}
fn remap_mir_spans(code: &mut arm.Code, work: &machine_ir.Workspace) -> bool {
    if !code.mir_capture { return true }
    count := code.mir_starts.len
    if code.mir_ends.len != count || code.mir_kinds.len != count || code.mir_a.len != count || code.mir_b.len != count { return false }
    for span in 0..count {
        first := machine_ir.boundary(&work, code.mir_starts[span]); last := machine_ir.boundary(&work, code.mir_ends[span])
        if first < 0 || last < first || (last != first && last - first != code.mir_ends[span] - code.mir_starts[span]) { return false }
    }
    var kept := 0
    for span in 0..count {
        first := machine_ir.boundary(&work, code.mir_starts[span]); last := machine_ir.boundary(&work, code.mir_ends[span])
        if first == last { continue }
        code.mir_starts[kept] = first; code.mir_ends[kept] = last
        code.mir_kinds[kept] = code.mir_kinds[span]; code.mir_a[kept] = code.mir_a[span]; code.mir_b[kept] = code.mir_b[span]; kept = kept + 1
    }
    while code.mir_starts.len > kept {
        a := code.mir_starts.pop(); b := code.mir_ends.pop(); c := code.mir_kinds.pop(); d := code.mir_a.pop(); e := code.mir_b.pop()
    }
    true
}
fn compile_body(c: &mut Compiler, f: i32, model: &mut opt_ir.Function, work: &mut opt_verify.Workspace, plan: &mut opt_alloc.Plan, machine_work: &mut machine_ir.Workspace, emit_settings: &opt_emit.Options, range_work: &mut opt_range.Workspace, catalog: &opt_inline.Catalog, inline_work: &mut opt_inline.Workspace) {
    c.scalar_function = scalar_body(&mut c, f, &mut model, &mut work, &mut plan, &emit_settings, &mut range_work)
    if c.scalar_function { return }
    c.inline_caller_words = 4096
    if c.inline_enabled { fragments.reset_dependencies(&mut c.inline_deps) }
    var started: i64 = -1
    if c.bindings.profile.enabled { started = profile.begin(&c.bindings.profile) }
    c.local_names.clear(); c.local_types.clear(); c.local_slots.clear(); c.local_scopes.clear(); c.local_mutable.clear()
    c.owned_slots.clear(); c.owned_types.clear(); c.owner_temps.clear(); c.owner_elided.clear(); c.mutations.clear()
    c.lease_starts.clear(); c.lease_ends.clear()
    first_word := arm.position(&c.code); first_label := arm.label_count(&c.code)
    first_reloc := c.code.at.len; first_import := c.imports.sites.len
    c.current_owner = c.function_owners[f]
    c.testing = c.test_functions[f]
    c.unsafe_scope = c.unsafe_functions[f]
    c.cleanup = arm.label(&mut c.code)
    c.slots = 0; c.scope = 0; c.ret_type = c.returns[f]; c.cursor = c.starts[f] - 1
    arm.mark(&mut c.code, c.fn_labels[f]); frame := arm.prologue(&mut c.code)
    first := c.param_starts[f]
    c.loans.first_parameter = first
    for p in 0..c.param_counts[f] {
        index := slot(&mut c); bind(&mut c, c.param_names[first + p], c.param_types[first + p], false, index, c.param_tokens[first + p])
        if owned(&c, c.param_types[first + p]) { remember_owner(&mut c, index, c.param_types[first + p], false) }
        if p < 8 { arm.store(&mut c.code, index, p) }
        else { load_mem(&mut c, 0, 29, 16 + (p - 8) * 16); arm.store(&mut c.code, index, 0) }
    }
    param_owners := c.owned_slots.len
    initialize := arm.label(&mut c.code); body := arm.label(&mut c.code)
    arm.branch(&mut c.code, initialize, 0); arm.mark(&mut c.code, body)
    c.scope = -1
    returns := block(&mut c, true, &catalog, &mut inline_work)
    if c.ret_type != 0 && !returns { fail(&mut c, "function can finish without returning a value") }
    arm.imm(&mut c.code, 0, 0); arm.mark(&mut c.code, c.cleanup); arm.push(&mut c.code, 0)
    cleanup_from(&mut c, 0, false); arm.pop(&mut c.code, 0); arm.ret(&mut c.code)
    arm.mark(&mut c.code, initialize)
    for o in param_owners..c.owned_slots.len { if !c.owner_elided[o] { arm.store(&mut c.code, c.owned_slots[o], 31) } }
    arm.branch(&mut c.code, body, 0)
    if c.ok { arm.frame(&mut c.code, frame, c.slots) }
    if c.ok && c.lease_starts.len > 0 {
        machine_ir.reset(&mut machine_work)
        for i in 0..c.lease_starts.len {
            if !machine_ir.add_range(&mut machine_work, c.lease_starts[i], c.lease_ends[i]) { fail(&mut c, "internal ownership rewrite range") }
        }
        if c.ok && !machine_ir.prepare(&mut machine_work, &c.code, first_word, first_label, first_reloc, &c.imports.sites, first_import) {
            fail(&mut c, "internal ownership rewrite validation")
        }
        // Failure is a compilation error: restoring only setup would leave
        // elided owner slots without initialization or balanced cleanup.
        if c.ok && !remap_mir_spans(&mut c.code, &machine_work) { fail(&mut c, "internal MIR frame span rewrite failure") }
        if c.ok { machine_ir.commit_code(&mut machine_work, &mut c.code); machine_ir.commit_imports(&mut machine_work, &mut c.imports.sites) }
    }
    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 7, started, i64(c.ends[f] - c.starts[f] + 1)) }
}

fn finish_image(c: &mut Compiler, platform: i32, main_id: i32, rt: &runtime.Runtime) -> Result {
    for id in 0..c.callback_labels.len { if c.callback_labels[id] >= 0 { callback_entry(&mut c, id) } }
    arm.mark(&mut c.code, c.float_trap); arm.exit(&mut c.code, 107)
    arm.mark(&mut c.code, c.bounds); arm.exit(&mut c.code, 103)
    // array_clone exposes capacity 0 for empty arrays and max(8,len) otherwise.
    // Reusing a temporary's larger backing allocation must preserve that value.
    arm.mark(&mut c.code, c.array_take); load_mem(&mut c, 1, 0, 8)
    ready := arm.label(&mut c.code)
    arm.emit(&mut c.code, 4043309119); arm.branch(&mut c.code, ready, 2)
    arm.emit(&mut c.code, 4043317311); arm.branch(&mut c.code, ready, 4)
    arm.imm(&mut c.code, 1, 8)
    arm.mark(&mut c.code, ready); store_mem(&mut c, 1, 0, 16); arm.emit(&mut c.code, 3596551104)
    clones(&mut c)
    arm.runtime(&mut c.code, c.print_int, c.print_bool, c.print_text, c.write, c.overflow, c.zero, c.assertion, c.io)
    runtime.emit_runtime(&mut c.code, &rt)
    data_start := c.code.words.len
    literals(&mut c)
    runtime.emit_profile_data(&mut c.code, &rt)
    if platform == 3 {
        image := wasm.image(&c.code, data_start, c.fn_labels[main_id], c.returns[main_id], &c.wasm_abi)
        return Result { ok: image.ok, error: image.error, offset: 0, text: image.text, imports: imports() }
    }
    if platform == 2 {
        native := x86.finish(&c.code, data_start, &c.imports.sites, &c.imports.slots)
        c.imports.sites = native.imports
        return Result { ok: native.ok, error: native.error, offset: 0, text: native.text, imports: c.imports }
    }
    text := arm.finish_for(&mut c.code, c.imports.symbols.len > 0 || c.imports.globals > 0)
    Result { ok: true, error: "", offset: 0, text: text, imports: c.imports }
}
fn ownership_test_compile(source: string, platform: i32, enabled: bool, checking: bool) -> Result {
    none: []i32 = []; var records := bindings(); var config := configuration()
    config.ownership_enabled = enabled
    var tokens := lexer.scan(source, false)
    compile_options(&mut tokens, platform, &none, &none, checking, false, &mut records, "", "", &config)
}
@test fn string_operand_leases_are_removed_only_across_effect_free_rhs() {
    for platform in 0..4 {
        pure := "fn main(){left:=\"a\";right:=\"b\";print(left==right);print(left+right)}"
        before := ownership_test_compile(pure, platform, false, false)
        after := ownership_test_compile(pure, platform, true, false)
        before.ok
        after.ok
        after.text.len < before.text.len
        calls := "fn rhs()->string{\"b\"} fn main(){print(\"a\"==rhs())}"
        kept := ownership_test_compile(calls, platform, true, false)
        original := ownership_test_compile(calls, platform, false, false)
        kept.ok
        original.ok
        kept.text.len == original.text.len
        for i in 0..kept.text.len { kept.text[i] == original.text[i] }
    }
}
@test fn ownership_proofs_do_not_change_validation_or_binding_records() {
    none: []i32 = []
    for platform in 0..4 {
        for source in ["fn main(){print(\"a\"==true)}", "fn unused()->string{true} fn main(){print(\"a\"==\"b\")}", "fn main(){value:=\"a\";value=\"b\"}"] {
            off := ownership_test_compile(source, platform, false, false)
            on := ownership_test_compile(source, platform, true, false)
            checked := ownership_test_compile(source, platform, true, true)
            !off.ok
            !on.ok
            !checked.ok
            off.error == on.error
            off.offset == on.offset
            on.error == checked.error
            on.offset == checked.offset
        }
        source := "fn main(){left:=\"a\";right:=\"b\";print(left==right)}"
        var off_tokens := lexer.scan(source, false); var on_tokens := lexer.scan(source, false)
        var off_records := bindings(); var on_records := bindings()
        var config := configuration(); config.ownership_enabled = false
        off := compile_options(&mut off_tokens, platform, &none, &none, true, true, &mut off_records, "", "", &config)
        config.ownership_enabled = true
        on := compile_options(&mut on_tokens, platform, &none, &none, true, true, &mut on_records, "", "", &config)
        off.ok
        on.ok
        off.text.len == 0 && on.text.len == 0
        off_records.offsets.len == on_records.offsets.len
        for i in 0..off_records.offsets.len {
            off_records.offsets[i] == on_records.offsets[i]
            off_records.names[i] == on_records.names[i]
            off_records.types[i] == on_records.types[i]
        }
    }
}
@test fn rune_literals_emit_the_same_code_as_scalar_constants() {
    for platform in 0..4 {
        runes := compile_for("fn main(){print(`\\0` == `\\u{0}`);print(`å` == `\\u{e5}`);print(`🌍` == `\\u{1f30d}`)}", platform)
        integers := compile_for("fn main(){print(0 == 0);print(229 == 229);print(127757 == 127757)}", platform)
        runes.ok
        integers.ok
        // Equal machine code proves there is no literal-only conversion call,
        // allocation, cleanup or embedded UTF-8 string left in the runtime path.
        runes.text.len == integers.text.len
        for i in 0..runes.text.len { runes.text[i] == integers.text[i] }
    }
}
@test fn compiler_checks_types_before_emitting_an_image() {
    none: []i32 = []
    for platform in 0..4 {
        var records := bindings()
        checked := compile_mode("fn unused()->i32{values: [u8;4]=[7;4];i32(values[0])} fn main(){print(42)}", platform, &none, &none, true, false, &mut records)
        checked.ok
        checked.text.len == 0
        records.emitted == 0
        invalid := "fn unused()->i32{true} fn main(){print(42)}"
        rejected := compile_mode(invalid, platform, &none, &none, true, false, &mut records)
        built := compile_for(invalid, platform)
        !rejected.ok
        rejected.error == built.error
        rejected.offset == built.offset
        // Direct token clients have the same lexical value/type shadowing
        // rule as file/module clients, independently of optimization mode.
        for source in [
            "enum Values{Other} fn size(Values:&[]i64)->i32{Values.len} fn main(){values:[]i64=[1,2];print(size(&values))}",
            "struct Bound{} fn count(Bound:i32)->i32{var result:=0;for i in 0..Bound{result=result+1};result} fn main(){print(count(3))}",
            "enum Values{Other} fn update(Values:&mut []i64){for i in 0..Values.len{Values[i]=Values[i]+1}} fn main(){var values:[]i64=[1,2];update(&mut values);print(values[0])}"
        ] {
            for enabled in [false, true] {
                var tokens := lexer.scan(source, false)
                result := compile_configured(&mut tokens, platform, &none, &none, true, false, &mut records, "", "", enabled)
                result.ok
            }
        }
    }
    compile("fn add(x:i32,y:i32)->i32{x+y} fn main(){print(add(20,22))}").ok
    !compile("fn main(){x:=1;x=2}").ok
    !compile("fn main(){var x:=1;x=true}").ok
    !compile("fn f(x:i32)->i32{} fn main(){}").ok
    !compile("fn unused()->i32{true} fn main(){print(42)}").ok
    !compile("fn main(){print(unknown)}").ok
    !compile("fn main(){print(2147483648)}").ok
    !compile("fn main(){if 1 {}}").ok
    !compile("fn main(){for i in 0..2{i=3}}").ok
    !compile("import sys\nfn main(){}").ok
}

@test fn native_compiler_rejects_unsupported_aggregate_shapes_and_immutable_mutation() {
    compile_for("fn main(){var a:[i32;2]=[1,2]}", 1).ok
    !compile_for("fn main(){var a:[i32;2]=[1]}", 1).ok
    !compile_for("struct Box{value:i32} fn main(){var a:[]Box=[]}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];a.clear()}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];a.reserve(8)}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];x:=a.pop()}", 1).ok
    !compile_for("fn f(x:i32)->i32{x} fn main(){var a:=1;f(a)=2}", 1).ok
    !compile_for("fn f()->i32{42} fn main(){f:=1;print(f())}", 1).ok
    !compile_for("fn main(){var a:=true;(!a)=false}", 1).ok
    !compile_for("fn main(){var a:=1;(-a)=2}", 1).ok
    compile_for("enum K{A,B} struct Box{values:[]i32,tag:K} fn main(){var b:=Box{values:[1,2],tag:.A};b.values.push(3);b.tag=.B;print(b.values.len)}", 1).ok
}

fn inline_test_compile(source: string, platform: i32, enabled: bool, scalar: bool, checking: bool, report: bool, records: &mut Bindings) -> Result {
    none: []i32 = []; var tokens := lexer.scan(source, false); var settings := configuration()
    settings.inline_enabled = enabled; settings.scalar_enabled = scalar
    compile_options(&mut tokens, platform, &none, &none, checking, report, &mut records, "", "", &settings)
}
@test fn inline_producer_preserves_authoritative_diagnostics_and_scalar_off_behavior() {
    for platform in 0..4 {
        for source in [
            "fn step(x:i32)->i32{x+1} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{var y:=x;y=y+1;y} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{if x>0{return x};-x} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+1} fn main(){step:=1;print(step(2))}",
            "fn step(x:i32)->i32{x=2;x} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+2147483648} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+missing} fn main(){}",
            "fn step(x:i32)->i32{if false{return true};x} fn main(){}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step(true))}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step(1,2))}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step())}"
        ] {
            for checking in [false, true] {
                var before := bindings(); var after := bindings()
                old := inline_test_compile(source, platform, false, true, checking, false, &mut before)
                current := inline_test_compile(source, platform, true, true, checking, false, &mut after)
                assert(old.ok == current.ok && old.error == current.error && old.offset == current.offset)
                assert(before.modeled == after.modeled && before.optimized == after.optimized && before.emitted == after.emitted && before.fallbacks == after.fallbacks)
            }
        }
        var before := bindings(); var after := bindings()
        source := "fn step(x:i32)->i32{x+1} fn main(){print(step(2))}"
        old := inline_test_compile(source, platform, false, false, false, false, &mut before)
        disabled := inline_test_compile(source, platform, true, false, false, false, &mut after)
        assert(old.ok && disabled.ok && old.text.len == disabled.text.len)
        for at in 0..old.text.len { assert(old.text[at] == disabled.text[at]) }
    }
}
@test fn inline_producer_does_not_duplicate_source_binding_reports() {
    source := "fn step(x:i32)->i32{x+1} fn main(){value:=3;print(step(value))}"
    for platform in 0..4 {
        var before := bindings(); var after := bindings()
        old := inline_test_compile(source, platform, false, true, false, true, &mut before)
        current := inline_test_compile(source, platform, true, true, false, true, &mut after)
        assert(old.ok && current.ok && before.offsets.len == after.offsets.len && before.modeled == after.modeled)
        assert(before.optimized == after.optimized && before.emitted == after.emitted)
        assert(before.inline_entries == 0 && before.inlined_calls == 0 && before.inline_tokens == 0)
        assert(after.inline_entries == 1 && after.inline_nodes == 3 && after.inline_units > 0 && after.inline_tokens > 0 && after.inline_tokens <= 32768)
        assert(after.inlined_calls == 1 && after.inlined_words > 0 && after.inlined_words <= after.inline_estimated_words && after.inline_estimated_words <= 65536)
        for at in 0..before.offsets.len {
            assert(before.offsets[at] == after.offsets[at] && before.names[at] == after.names[at] && before.types[at] == after.types[at])
        }
    }
}

fn inline_cache_test_compile(source: string, platform: i32, directory: string, records: &mut Bindings) -> Result {
    none: []i32 = []; var tokens := lexer.scan(source, false); var settings := configuration()
    settings.inline_enabled = true
    compile_options(&mut tokens, platform, &none, &none, false, false, &mut records, directory, "inline-dependencies-test:v2", &settings)
}
fn same_test_image(left: &Result, right: &Result) -> bool {
    if !left.ok || !right.ok || left.text.len != right.text.len { return false }
    for at in 0..left.text.len { if left.text[at] != right.text[at] { return false } }
    true
}
@test fn inline_fragments_restore_backward_dependencies_charges_and_private_body_identity() {
    for platform in 0..3 {
        directory := "build/inline-dependency-unit/" + platform.str()
        for source in ["fn step(x:i32)->i32{x+1} fn main(){print(step(8))}", "fn step(x:i32)->i32{x+2} fn main(){print(step(8))}"] {
            var fresh := bindings(); var first := bindings(); var warm := bindings()
            reference := inline_cache_test_compile(source, platform, "", &mut fresh)
            initial := inline_cache_test_compile(source, platform, directory, &mut first)
            restored := inline_cache_test_compile(source, platform, directory, &mut warm)
            assert(same_test_image(&reference, &initial) && same_test_image(&reference, &restored))
            assert(warm.reused == 2 && warm.emitted == 0 && warm.modeled == 0 && warm.optimized == 0 && warm.fallbacks == 0)
            assert(warm.inlined_calls == 0 && warm.inlined_words == 0 && warm.inline_estimated_words == fresh.inline_estimated_words)
            assert(fresh.inlined_calls == 1 && fresh.inline_estimated_words > 0)
        }
        // Empty dependency/charge payloads are legitimate legacy fragments.
        source := "fn main(){print(42)}"
        var fresh := bindings(); var first := bindings(); var warm := bindings()
        reference := inline_cache_test_compile(source, platform, "", &mut fresh)
        initial := inline_cache_test_compile(source, platform, directory, &mut first)
        restored := inline_cache_test_compile(source, platform, directory, &mut warm)
        assert(same_test_image(&reference, &initial) && same_test_image(&reference, &restored))
        assert(warm.reused == 1 && warm.emitted == 0 && warm.inline_estimated_words == 0)
    }
}
fn inline_budget_test_source(first_count: i32) -> string {
    var source := "fn step(x:i32)->i32{x+1} "
    for function in 0..20 {
        source = source + "fn consume" + function.str() + "()->i32{var sum:=0;"
        var count := 100; if function == 0 { count = first_count }
        for call in 0..count { source = source + "sum=sum+step(1);" }
        source = source + "sum} "
    }
    source = source + "fn main(){var total:=0;"
    for function in 0..20 { source = source + "total=total+consume" + function.str() + "();" }
    source + "print(total)}"
}
@test fn inline_fragment_keys_preserve_cold_growth_frontiers_across_partial_cache_hits() {
    directory := "build/inline-frontier-unit"
    // Decreasing an earlier charge lets a previously partial later caller
    // inline more. Increasing it must refuse fragments that spent more budget.
    // A per-function key records the effective incoming caller budget in both
    // directions, while ordinary full-budget scalar hits avoid source parsing.
    for count in [100, 5, 100] {
        source := inline_budget_test_source(count)
        var fresh := bindings(); var mixed := bindings(); var warm := bindings()
        reference := inline_cache_test_compile(source, 0, "", &mut fresh)
        partial := inline_cache_test_compile(source, 0, directory, &mut mixed)
        restored := inline_cache_test_compile(source, 0, directory, &mut warm)
        assert(same_test_image(&reference, &partial) && same_test_image(&reference, &restored))
        assert(warm.reused == 22 && warm.emitted == 0 && warm.modeled == 0 && warm.fallbacks == 0)
        assert(fresh.inline_estimated_words == 65520 && mixed.inline_estimated_words == fresh.inline_estimated_words && warm.inline_estimated_words == fresh.inline_estimated_words)
        assert(warm.inlined_calls == 0 && warm.inlined_words == 0 && fresh.inlined_calls > 0)
    }
}

@test fn mir_frame_span_compaction_is_atomic_and_preserves_complete_helpers() {
    var code := arm.new(); arm.begin_mir(&mut code, true); arm.imm(&mut code, 0, 42)
    arm.load(&mut code, 620); arm.store(&mut code, 621, 31); arm.address(&mut code, 621)
    first := code.mir_starts[0]; last := code.mir_ends[0]; words := code.words.len
    none: []i32 = []; var sites: []i32 = []; var work := machine_ir.new()
    assert(machine_ir.add_range(&mut work, first + 1, first + 2))
    assert(machine_ir.prepare(&mut work, &code, 0, 0, 0, &none, 0))
    assert(!remap_mir_spans(&mut code, &work))
    assert(code.words.len == words && code.mir_starts.len == 3 && code.mir_starts[0] == first && code.mir_ends[0] == last)
    machine_ir.reset(&mut work); assert(machine_ir.add_range(&mut work, first, last))
    assert(machine_ir.prepare(&mut work, &code, 0, 0, 0, &none, 0))
    assert(remap_mir_spans(&mut code, &work))
    machine_ir.commit_code(&mut work, &mut code); machine_ir.commit_imports(&mut work, &mut sites); arm.end_mir(&mut code)
    assert(code.mir_starts.len == 2 && code.mir_starts[0] == first && code.mir_kinds[0] == 2 && code.mir_b[0] == 31)
    var function := mir.new()
    assert(mir_lift.lift_spans(&mut function, &code, 0, 0, 0, &none, 0, &code.mir_starts, &code.mir_ends, &code.mir_kinds, &code.mir_a, &code.mir_b))
    assert(mir_verify.verify(&mut function))
    assert(function.kinds[1] == 8 && function.a[1] == -1 && function.kinds[2] == 9)
}
@test fn all_emitted_source_functions_use_mir_without_changing_diagnostics_or_bindings() {
    none: []i32 = []
    for platform in 0..4 {
        for source in [
            "fn inc(x:i32)->i32{x+1} fn main(){print(inc(3))}",
            "fn inc(x:i32)->i32{x+1} fn main(){var text:=\"x\";var sum:=0;for i in 0..8{sum=sum+inc(i);text=text+\"z\"};print(text);print(sum)}",
            "fn change(values:&mut []i64){for i in 0..values.len{values[i]=values[i]+1}} fn main(){var values:[]i64=[1,2];change(&mut values);print(values[0])}",
            "fn recurse(x:i32)->i32{if x==0{return 1};x*recurse(x-1)} fn main(){print(recurse(4))}"
        ] {
            for checking in [false, true] {
                var off := configuration(); off.mir_enabled = false; var on := configuration(); on.mir_enabled = true; on.mir_opt_enabled = false
                var before := bindings(); var after := bindings(); var left := lexer.scan(source, false); var right := lexer.scan(source, false)
                old := compile_options(&mut left, platform, &none, &none, checking, true, &mut before, "", "", &off)
                current := compile_options(&mut right, platform, &none, &none, checking, true, &mut after, "", "", &on)
                assert(old.ok && current.ok && old.text.len == current.text.len && before.offsets.len == after.offsets.len)
                for at in 0..old.text.len { assert(old.text[at] == current.text[at]) }
                for at in 0..before.offsets.len { assert(before.offsets[at] == after.offsets[at] && before.names[at] == after.names[at] && before.types[at] == after.types[at]) }
                assert(before.mir_functions == 0 && before.mir_operations == 0 && before.mir_opaque == 0)
                if checking { assert(after.mir_functions == 0 && after.mir_operations == 0 && after.mir_opaque == 0) }
                else { assert(after.mir_functions == after.emitted && after.mir_functions > 0 && after.mir_operations >= after.mir_functions) }
            }
        }
    }
}

@test fn whole_function_optimizer_policy_and_actual_counters_follow_pass_execution() {
    source := "fn next(x:i32)->i32{x+1} fn main(){var sum:=0;for i in 0..12{sum=sum+next(i)};print(sum)}"
    none: []i32 = []
    for platform in 0..4 {
        for mode in 0..4 {
            var config := configuration(); config.mir_opt_enabled = mode != 0
            if mode == 3 { config.mir_enabled = false }
            checking := mode == 2
            var records := bindings(); var tokens := lexer.scan(source, false)
            result := compile_options(&mut tokens, platform, &none, &none, checking, false, &mut records, "", "", &config)
            assert(result.ok)
            if mode != 1 {
                assert(!records.mir_optimization_enabled && records.mir_optimized == 0 && records.mir_promoted == 0)
                assert(records.mir_removed_loads == 0 && records.mir_removed_stores == 0 && records.mir_analysis_units == 0 && records.mir_budget_refusals == 0)
            } else {
                assert(records.mir_optimization_enabled && records.mir_functions == records.emitted && records.mir_functions > 0)
                assert(records.mir_analysis_units > 0)
                if records.mir_optimized > 0 { assert(records.mir_promoted > 0 && records.mir_removed_loads > 0 && records.mir_removed_stores > 0) }
                else { assert(records.mir_promoted == 0 && records.mir_removed_loads == 0 && records.mir_removed_stores == 0) }
            }
        }
    }
}
