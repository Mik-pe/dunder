}
// Record only referenced imports and leave one page-relative GOT load for the image writer.
fn import_address(c: &mut Compiler, f: i32) {
    if c.code.platform == 3 {
        ty := c.ffi_types[f]; sig := wasm_signature(&mut c, ty)
        entry := wa.host(&mut c.wasm_abi, c.libraries[f], c.symbols[f], sig)
        arm.imm(&mut c.code, 0, i64(entry)); return
    }
    library := native_libs.library_name(c.libraries[f], c.code.platform == 0); symbol := c.symbols[f]
    var index := 0
    while index < c.imports.symbols.len {
        if c.imports.symbols[index] == symbol {
            if c.imports.libraries[index] == library { break }
            if c.code.platform != 0 { fail(&mut c, "ELF cannot bind one symbol to two libraries; select a handle with std.dl"); return }
        }
        index = index + 1
    }
    if index == c.imports.symbols.len { c.imports.libraries.push(library); c.imports.symbols.push(symbol) }
    if !c.code.checking { c.imports.sites.push(arm.position(&c.code) * 4); c.imports.slots.push(index) }
    arm.emit(&mut c.code, 0); arm.emit(&mut c.code, 0); arm.mov(&mut c.code, 0, 16)
}
// Positive counts denote homogeneous f32 members, negative counts homogeneous f64.
fn hfa(c: &Compiler, ty: i32, depth: i32) -> i32 {
    if depth > 64 { return 0 }
    if ty == 6 { return 1 }; if ty == 7 { return -1 }
    if c.type_kinds[ty] == 6 {
        count := c.type_counts[ty]; if count > 4 { return 0 }
        return count * hfa(&c, c.type_bases[ty], depth + 1)
    }
    if !c.c_record[ty] { return 0 }
    var shape := 0
    for index in c.type_starts[ty]..c.type_starts[ty] + c.type_counts[ty] {
        part := hfa(&c, c.field_types[index], depth + 1)
        if part == 0 || (shape > 0 && part < 0) || (shape < 0 && part > 0) { return 0 }
        shape = shape + part
        if shape < -4 || shape > 4 { return 0 }
    }
    shape
}
// Negative relocation slots indicate byte offsets in writable process storage.
fn static_address(c: &mut Compiler, offset: i32) {
    if !c.code.checking { c.imports.sites.push(arm.position(&c.code) * 4); c.imports.slots.push(-1 - offset) }
    arm.emit(&mut c.code, 0); arm.emit(&mut c.code, 0)
}
fn foreign_width(ty: i32) -> i32 { abi.width(ty) }
fn transfer_c(c: &mut Compiler, ty: i32, reg: i32, base: i32, load: bool) {
    if load && ty == 1 { arm.emit(&mut c.code, 3112173568 + i64(base) * 32 + i64(reg)); return }
    var packed := 11; width := foreign_width(storage_type(&c, ty))
    if width == 1 { packed = 8 }; if width == 2 { packed = 9 }; if width == 4 { packed = 10 }
    unsigned.transfer(&mut c.code, packed, reg, base, load)
}
fn storage_type(c: &Compiler, ty: i32) -> i32 {
    if c.type_kinds[ty] == 3 { return 1 }
    if c.code.platform == 3 && (ty == 12 || ty == 13 || c.type_kinds[ty] == 8 || c.type_kinds[ty] == 9) { return 10 }
    ty
}
fn transfer_value(c: &mut Compiler, ty: i32, reg: i32, base: i32, load: bool) {
    packed := storage_type(&c, ty)
    unsigned.transfer(&mut c.code, packed, reg, base, load)
}
fn wasm_signature(c: &mut Compiler, ty: i32) -> i32 {
    ret := c.type_bases[ty]; first := c.type_starts[ty]; count := c.type_counts[ty]
    if c.c_record[ret] { fail(&mut c, "pass Wasm C records by pointer"); return 0 }
    var args: []i32 = []
    for i in first..first + count {
        arg := c.ffi_params[i]
        if c.c_record[arg] { fail(&mut c, "pass Wasm C records by pointer"); return 0 }
        args.push(arg)
    }
    wa.signature(&mut c.wasm_abi, &args, ret)
}
// The callee address is in x0. Stage arguments in frame slots before populating
// the independent scalar and float register banks, then the aligned stack.
fn foreign_call(c: &mut Compiler, sig: i32, catalog: &opt_inline.Catalog, inline_work: &mut opt_inline.Workspace) -> i32 {
    if !c.unsafe_scope { fail(&mut c, "foreign call requires unsafe"); return 0 }
    callee := slot(&mut c); arm.store(&mut c.code, callee, 0)
    if c.code.platform == 3 {
        index := wasm_signature(&mut c, sig)
        return invoke(&mut c, sig, callee, -1, index, &catalog, &mut inline_work)
    }
    first := c.type_starts[sig]; count := c.type_counts[sig]
    var values: []i32 = []; var locations: []i32 = []
    var gp_limit := 8; if c.code.platform == 2 { gp_limit = 6 }
    ret := c.type_bases[sig]
    var result_slot := -1; var indirect_result := false
    if c.c_record[ret] {
        if hfa(&c, ret, 0) == 0 { fail(&mut c, "unsupported foreign aggregate result"); return 0 }
        arm.imm(&mut c.code, 0, i64(c.c_sizes[ret])); arm.branch(&mut c.code, c.runtime.alloc_record, 1)
        result_slot = slot(&mut c); arm.store(&mut c.code, result_slot, 0)
        indirect_result = c.code.platform == 2 && c.c_sizes[ret] > 16
    }
    var gp := 0; if indirect_result { gp = 1 }; var fp := 0; var outgoing := 0
    while c.ok && !is(&c, ")") {
        if values.len == count { fail(&mut c, "too many C call arguments"); return 0 }
        want := c.ffi_params[first + values.len]
        actual := expression(&mut c, 0, want, &catalog, &mut inline_work); same(&mut c, want, actual)
        aggregate := c.c_record[want]
        if aggregate {
            if hfa(&c, want, 0) == 0 { fail(&mut c, "unsupported foreign aggregate parameter"); return 0 }
            copy_value(&mut c, want); temp := temporary(&mut c, want)
        }
        value := slot(&mut c); arm.store(&mut c.code, value, 0); values.push(value)
        shape := hfa(&c, want, 0); var need := shape; if shape < 0 { need = -shape }
        if aggregate && c.code.platform == 2 {
            need = (c.c_sizes[want] + 7) / 8
            if need > 2 { need = 9 }
        }
        if need > 0 && fp + need <= 8 { locations.push(8 + fp); fp = fp + need }
        else if need == 0 && gp < gp_limit { locations.push(gp); gp = gp + 1 }
        else {
            if need > 0 && c.code.platform != 2 { fp = 8 }
            var alignment := 8; var width := 8
            if c.code.platform == 0 { alignment = foreign_width(want); width = alignment }
            if aggregate {
                width = c.c_sizes[want]
                if c.code.platform == 0 { alignment = c.c_aligns[want] } else { width = (width + 7) / 8 * 8 }
            }
            outgoing = (outgoing + alignment - 1) / alignment * alignment
            locations.push(16 + outgoing); outgoing = outgoing + width
        }
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")"); if count != values.len { fail(&mut c, "wrong C argument count"); return 0 }
    outgoing = (outgoing + 15) / 16 * 16
    if outgoing > 4080 { fail(&mut c, "C argument frame exceeds direct stack offset"); return 0 }
    if outgoing > 0 { arm.emit(&mut c.code, 3506439167 + i64(outgoing) * 1024) }
    arm.load(&mut c.code, callee); arm.mov(&mut c.code, 17, 0)
    var i := values.len - 1
    while i >= 0 {
        where := locations[i]; ty := c.ffi_params[first + i]
        arm.load(&mut c.code, values[i])
        if c.c_record[ty] {
            if where < 16 { abi.hfa(&mut c.code, 0, where - 8, hfa(&c, ty, 0), true) }
            else {
                arm.emit(&mut c.code, 2432697321 + i64(where - 16) * 1024)
                abi.copy(&mut c.code, 9, 0, c.c_sizes[ty])
            }
        } else if where < 8 { arm.mov(&mut c.code, where, 0) }
        else if where < 16 {
            var opcode: i64 = 2657550336; if ty == 6 { opcode = 505872384 }
            arm.emit(&mut c.code, opcode + i64(where - 8))
        } else { arm.emit(&mut c.code, 2432697321 + i64(where - 16) * 1024); transfer_c(&mut c, ty, 0, 9, false) }
        i = i - 1
    }
    if indirect_result { arm.load(&mut c.code, result_slot) }
    if c.has_callbacks {
        if c.imports.globals < 64 { c.imports.globals = 64 }
        static_address(&mut c, 0)
        abi.load(&mut c.code, 10, 16, 48, 8); arm.store(&mut c.code, callee, 10)
        abi.thread_token(&mut c.code); abi.store(&mut c.code, 10, 16, 48, 8)
        if c.code.platform == 2 { arm.emit(&mut c.code, 4194304000) } // store suspended x86 register bank
        else { for reg in 19..25 { abi.store(&mut c.code, reg, 16, (reg - 19) * 8, 8) } }
    }
    if c.code.platform == 2 { arm.emit(&mut c.code, 4261412864 + i64(gp) * 65536 + i64(fp) * 256 + i64(outgoing / 16)) }
    else {
        arm.emit(&mut c.code, 3594453536) // blr x17
        if c.has_callbacks {
            static_address(&mut c, 0)
            for reg in 19..25 { abi.load(&mut c.code, reg, 16, (reg - 19) * 8, 8) }
        }
    }
    if c.has_callbacks {
        arm.mov(&mut c.code, 13, 0); arm.load(&mut c.code, callee); static_address(&mut c, 0)
        abi.store(&mut c.code, 0, 16, 48, 8); arm.mov(&mut c.code, 0, 13)
    }
    if outgoing > 0 { arm.emit(&mut c.code, 2432697343 + i64(outgoing) * 1024) }
    if c.c_record[ret] {
        arm.load(&mut c.code, result_slot)
        if !indirect_result { abi.hfa(&mut c.code, 0, 0, hfa(&c, ret, 0), false) }
    } else if ret == 1 { arm.emit(&mut c.code, 2470476800) }
    else if ret == 6 { arm.emit(&mut c.code, 505806848) }
    else if ret == 7 { arm.emit(&mut c.code, 2657484800) }
    else if unsigned.has(ret) { unsigned.mask(&mut c.code, ret) }
    ret
}
// Inline C values have platform field alignment. Ordinary records keep their
// boxed eight-byte fields and the existing ownership representation.
fn c_layout(c: &mut Compiler, ty: i32) {
    if !c.ok || c.c_aligns[ty] > 0 { return }
    if c.c_aligns[ty] < 0 { fail(&mut c, "recursive C layout"); return }
    c.c_aligns[ty] = -1
    var size := 0; var alignment := 1
    if c.c_record[ty] {
        first := c.type_starts[ty]
        for field_index in first..first + c.type_counts[ty] {
            ft := c.field_types[field_index]; c_layout(&mut c, ft)
            if !c.ok { return }
            child := c.c_aligns[ft]
            if size > 2147483647 - child || c.c_sizes[ft] > 2147483647 - child - size { fail(&mut c,"C record layout exceeds supported size"); return }
            size = (size + child - 1) / child * child
            c.field_values[field_index] = i64(size)
            if child > alignment { alignment = child }
            size = size + c.c_sizes[ft]
        }
        if size == 0 { fail(&mut c, "empty C record"); return }
        size = (size + alignment - 1) / alignment * alignment
    } else if c.type_kinds[ty] == 6 {
        child := c.type_bases[ty]; c_layout(&mut c, child)
        if !c.ok { return }
        if c.c_sizes[child] > 0 && c.type_counts[ty] > 2147483647 / c.c_sizes[child] { fail(&mut c,"C array layout exceeds supported size"); return }
        alignment = c.c_aligns[child]; size = c.type_counts[ty] * c.c_sizes[child]
    } else if foreign_scalar(&c, ty) || ty == 3 {
        alignment = foreign_width(ty); size = alignment
        if c.code.platform == 3 && (ty == 12 || ty == 13 || c.type_kinds[ty] == 8) { size = 4; alignment = 4 }
    } else { fail(&mut c, "C layouts can contain only unmanaged C fields"); return }
    c.c_aligns[ty] = alignment; c.c_sizes[ty] = size
}
// Validate nominal inline value layouts independently of the boxed native
// representation. A negative memo entry denotes a type on the current path.
fn layout_bytes(c: &mut Compiler, ty: i32, depth: i32, sizes: &mut []i32) -> i32 {
    if !c.ok { return 1 }
    if sizes[ty] < 0 || depth >= 128 { fail(&mut c, "recursive or excessively nested inline value type"); return 1 }
    if sizes[ty] > 0 { return sizes[ty] }
    kind := c.type_kinds[ty]
    if kind == 1 { return 24 }
    if kind == 6 {
        bytes := c.type_counts[ty] * scalar_bytes(&c, c.type_bases[ty])
        if bytes == 0 { return 1 }; return bytes
    }
    if kind != 2 && kind != 7 {
        if ty == 0 || ty == 14 || kind == 10 { fail(&mut c, "invalid stored field type"); return 1 }
        return scalar_bytes(&c, ty)
    }
