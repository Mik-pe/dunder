}
@test fn compiler_checks_types_before_emitting_an_image() {
    compile("fn add(x:i32,y:i32)->i32{x+y} fn main(){print(add(20,22))}").ok
    !compile("fn main(){x:=1;x=2}").ok
    !compile("fn main(){var x:=1;x=true}").ok
    !compile("fn f(x:i32)->i32{} fn main(){}").ok
    !compile("fn main(){print(unknown)}").ok
    !compile("fn main(){print(2147483648)}").ok
    !compile("fn main(){if 1 {}}").ok
    !compile("fn main(){for i in 0..2{i=3}}").ok
    !compile("import sys\nfn main(){}").ok
}

@test fn native_compiler_rejects_unsupported_aggregate_shapes_and_immutable_mutation() {
    !compile_for("fn main(){var a:[i32;2]=[1,2]}", 1).ok
    !compile_for("struct Box{value:i32} fn main(){var a:[]Box=[]}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];a.clear()}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];a.reserve(8)}", 1).ok
    !compile_for("fn main(){a:[]i32=[1];x:=a.pop()}", 1).ok
    !compile_for("fn f(x:i32)->i32{x} fn main(){var a:=1;f(a)=2}", 1).ok
    !compile_for("fn f()->i32{42} fn main(){f:=1;print(f())}", 1).ok
    !compile_for("fn main(){var a:=true;(!a)=false}", 1).ok
    !compile_for("fn main(){var a:=1;(-a)=2}", 1).ok
    compile_for("enum K{A,B} struct Box{values:[]i32,tag:K} fn main(){var b:=Box{values:[1,2],tag:.A};b.values.push(3);b.tag=.B;print(b.values.len)}", 1).ok
}
