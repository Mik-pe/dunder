                    // The index ran once. Load the current descriptor before
                    // checking its bounds and locating the element.
                    arm.mov(&mut c.code, 1, 0); arm.pop_temp(&mut c.code, 0); arm.push_temp(&mut c.code, 1)
                    lower_place(&mut c, place, 0, .Value, at)
                    arm.pop_temp(&mut c.code, 1); arm.push_temp(&mut c.code, 0); arm.mov(&mut c.code, 0, 1)
                }
            }
            if model.recording { _ := typed.node(&mut model, 6, 2, model.value, -1, -1, 0, array_id, first_token) }
            if eat(&mut c, "..") {
                if model.probing && decline_projection(&mut c, &mut model) { c.body.taking_address = previous_address; break }
                if ty != 4 { c.body.taking_address = previous_address; fail(&mut c, "slice requires a string") }
                arm.push_temp(&mut c.code, 0); last := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, last); expect(&mut c, "]")
                c.body.taking_address = previous_address
                arm.mov(&mut c.code, 2, 0); arm.pop_temp(&mut c.code, 1); arm.pop_temp(&mut c.code, 0); arm.intrinsic_call(&mut c.code, c.runtime.string_slice, .Slice, 4, 4, c.world.tokens.starts[subscript_at]); saved_string := temporary(&mut c, 4)
                place = 0; c.body.address = -1; c.body.writable = false; continue
            }
            expect(&mut c, "]"); c.body.taking_address = previous_address; arm.pop_temp(&mut c.code, 1)
            var index := -1
            if place != 0 && ty != 4 && ft.type_base(&c.types, ty) >= 0 {
                kind := ft.type_kind(&c.types, ft.type_base(&c.types, ty))
                if kind == 1 || kind == 2 || kind == 6 { index = slot(&mut c) }
            }
            indexed := index_place(&mut c, place, ty, packed, index, subscript_at)
            if indexed == 0 { fail(&mut c, "index requires an array or string"); return 0 }
            if index >= 0 { bound_place(&mut c, .Temporary, indexed, i32(place_op.Temporary.SaveIndex), subscript_at) }
            if place != 0 { place = indexed }
            ty = load_index(&mut c, ty, packed, writable, place_access(&c), subscript_at, indexed)
            c.body.expr_owner = -1; c.body.expr_type = -1
        } else {
            expect(&mut c, "."); name := advance(&mut c)
