    }
    if name == "addr" { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c); token := c.body.cursor; expect(&mut c, "&"); write := eat(&mut c, "mut")
        previous_address := c.body.taking_address; c.body.taking_address = true
        ty := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
        c.body.taking_address = previous_address
        base := borrows.root(&c.body.places, c.body.places.current)
        if base < 0 { fail(&mut c, "addr requires a stored place"); return 0 }
        if write && is_for_locked(&c, base) { fail(&mut c, "cannot mutably borrow a collection while iterating over it"); return 0 }
        if write { c.body.mutations.push(base) }
        if c.loans.active {
            origin := loan_origin(&c, c.body.places.current)
            if origin == -2 { fail(&mut c, "scratch storage cannot become a raw address"); return 0 }
            if origin >= 0 { c.body.facts.exposed.push(origin) }
        }
        if c.body.address < 0 || (write && !c.body.writable) { fail(&mut c, "addr requires a matching stored place"); return 0 }
        var intent := 3; if write { intent = 4 }
        if ft.is_c_record(&c.types, ty) { place_step(&mut c, .BorrowPayload, ty, intent, 0, 0, token) }
        else if ft.type_kind(&c.types, ty) == 6 { place_step(&mut c, .Read, ty, intent, 3, 0, token) }
        else if c.body.direct_place && c.body.places.current < 0 { bound_place(&mut c, .BorrowHome, c.body.places.current, intent, token) }
        else { bound_place(&mut c, .BorrowSaved, c.body.places.current, intent, token) }
        expect(&mut c, ")"); return 13
    }
    if name == "ptr" || name == "ffi_fn" || name == "ref_at" { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c); var want := 13; if name == "ptr" { want = 12 }
        ty := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, ty); expect(&mut c, ")")
        if name == "ptr" { return 13 }
        if name == "ffi_fn" { if ft.type_kind(&c.types, expected) != 8 { fail(&mut c,"ffi_fn needs an extern fn type") }; return expected }
        if ft.type_kind(&c.types, expected) != 4 && ft.type_kind(&c.types, expected) != 5 { fail(&mut c,"ref_at needs a reference parameter type"); return 0 }
        return expected
    }
    if name.len > 5 && name[0..5] == "load_" && raw_memory_type(&c, name, 5) >= 0 { covered = true;
        require_unsafe(&mut c); token := c.body.cursor - 2; ty := raw_memory_type(&c, name, 5)
        a := expression(&mut c, 0, 13, &catalog, &mut inline_work, &mut model); same(&mut c, 13, a); expect(&mut c, ")"); place_transfer(&mut c, ty, 0, 0, true, true, 0, token); return ty
    }
    if name.len > 6 && name[0..6] == "store_" && raw_memory_type(&c, name, 6) >= 0 { covered = true;
        may_invalidate_operand(&mut c) // Inline source write, including void intrinsics.
        require_unsafe(&mut c); token := c.body.cursor - 2; ty := raw_memory_type(&c, name, 6)
        a := expression(&mut c, 0, 13, &catalog, &mut inline_work, &mut model); same(&mut c, 13, a); expect(&mut c, ","); arm.push_temp(&mut c.code, 0)
        b := expression(&mut c, 0, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, b); expect(&mut c, ")")
        arm.pop_temp(&mut c.code, 1); place_transfer(&mut c, ty, 0, 1, false, true, 1, token); return 0
    }
    if name.len >= 6 && name[0..6] == "__sys_" { covered = true; return intrinsic(&mut c, name, expected, &catalog, &mut inline_work, &mut model) }
    if name == "len" { covered = true;
        token := c.body.cursor - 2; ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
        expect(&mut c, ")")
        return length_value(&mut c, ty, token)
    }
    if name == "print" { covered = true; source := c.world.tokens.starts[c.body.cursor - 2]
        task_effect(&mut c, 256)
        ty := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
        if c.code.platform == 3 {
            if ty < 1 || ty > 12 { fail(&mut c, "print requires a scalar value"); return 0 }
            arm.intrinsic_call(&mut c.code, -1, .Print, ty, 0, source); return 0
        }
        var target := c.print_int; var input := ty
        if ty == 3 { target = c.print_bool } else if ty == 4 { target = c.print_text }
        else if floats.has(ty) { format_float(&mut c, ty, source); input = 4; saved_float := temporary(&mut c, 4); target = c.print_text }
        else if ty == 5 { arm.intrinsic_call(&mut c.code, c.runtime.string_rune, .Format, ty, 4, source); input = 4; saved_rune := temporary(&mut c, 4); target = c.print_text }
        else if ty != 1 && ty != 2 && ty != 5 && !unsigned.has(ty) { fail(&mut c, "print requires a scalar value") }
        arm.intrinsic_call(&mut c.code, target, .Print, input, 0, source); return 0
    }
    if name == "assert" { call_at := c.body.cursor - 2; covered = true; ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty); expect(&mut c, ")"); trap_edge(&mut c, c.assertion, .Assert, call_at); return 0 }
    if name == "i32" || name == "i64" || name == "rune" || floats.has(type_id(&c, name)) || unsigned.has(type_id(&c, name)) { covered = true;
        hint := type_id(&c, name)
        var argument_hint := 0
        offset := c.world.tokens.starts[c.body.cursor - 2]
        var literal_at := c.body.cursor; if is(&c, "-") { literal_at = literal_at + 1 }
        if (c.world.tokens.kinds[literal_at] == .Integer || c.world.tokens.kinds[literal_at] == .Float) && c.world.tokens.texts[literal_at + 1] == ")" {
            if floats.has(hint) || c.world.tokens.kinds[literal_at] == .Integer { argument_hint = hint }
        }
        ty := expression(&mut c, 0, argument_hint, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
        if floats.has(ty) || floats.has(hint) {
            if (!floats.has(ty) && ty != 1 && ty != 2 && !unsigned.has(ty)) || hint == 5 { fail(&mut c, "expected a numeric conversion"); return hint }
            floats.cast(&mut c.code, ty, hint, c.float_trap, offset); return hint
        }
        if ty == 13 && hint == 12 { require_unsafe(&mut c); return 12 }
        if ty != 1 && ty != 2 && ty != 5 && !unsigned.has(ty) && ft.type_kind(&c.types, ty) != 3 { fail(&mut c, "integer conversion requires an integer") }
        if hint == 5 { arm.intrinsic_call(&mut c.code, c.runtime.valid_rune, .CheckRune, ty, hint, offset) }
        unsigned.cast(&mut c.code, ty, hint, c.overflow)
        if hint == 1 { narrow(&mut c) }; return hint
    }
    covered = true
    f := i32(map.get_or(&c.world.functions, name, -1)); callee := local(&c.body, name)
    var signature := -1; var address := -1
    if callee >= 0 {
        signature = c.body.locals.types[callee]
        if ft.type_kind(&c.types, signature) != 9 { fail(&mut c, "local value is not callable"); return 0 }
