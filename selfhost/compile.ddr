            fail(&mut c,"borrow a value-compatible scratch element or record field");return 0
        }
        if c.body.address < 0 { fail(&mut c, "borrow requires a stored value"); return 0 }
        if mutable && !c.body.writable { fail(&mut c, "mutable borrow requires var or &mut") }
        borrow_address(&mut c, ty, mutable, token, place); c.body.address = -1; c.body.writable = false
        return compound(&mut c, kind, ty)
    }
    if eat(&mut c, "-") {
        if c.world.tokens.kinds[c.body.cursor] == .Integer { spelling := "-" + advance(&mut c); return literal(&mut c, &mut model, spelling, expected) }
        ty := primary(&mut c, expected, &catalog, &mut inline_work, &mut model)
        if model.recording { _ := typed.node(&mut model, 4, ty, model.value, -1, -1, 1, -1, token) }
        if floats.has(ty) { result := floats.method(&mut c.code, ty, "negate", c.world.tokens.starts[token]); c.body.address = -1; c.body.writable = false; return result }
        if ty != 1 && ty != 2 { fail(&mut c, "minus requires a signed number") }
        arm.integer_binary(&mut c.code, 2, true, true, 0, 31, 0, -1); arm.branch(&mut c.code, c.overflow, 8); if ty == 1 { narrow(&mut c) }; c.body.address = -1; c.body.writable = false; return ty
    }
    if eat(&mut c, "!") { ty := primary(&mut c, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty); if model.recording { _ := typed.node(&mut model, 4, 3, model.value, -1, -1, 2, -1, token) }; arm.compare_register(&mut c.code, 0, 31); arm.set_condition(&mut c.code, 0, 0); c.body.address = -1; c.body.writable = false; return 3 }
    if eat(&mut c, "(") { ty := expression(&mut c, 0, expected, &catalog, &mut inline_work, &mut model); expect(&mut c, ")"); place = c.body.places.current; at = c.body.places.source; return ty }
    if eat(&mut c, "true") { if model.recording { _ := typed.node(&mut model, 1, 3, -1, -1, -1, 1, -1, token) }; arm.imm(&mut c.code, 0, 1); return 3 }
    if eat(&mut c, "false") { if model.recording { _ := typed.node(&mut model, 1, 3, -1, -1, -1, 0, -1, token) }; arm.imm(&mut c.code, 0, 0); return 3 }
    if eat(&mut c, ".") { return enumeration(&mut c, expected, &catalog, &mut inline_work, &mut model) }
    if eat(&mut c, "[") {
