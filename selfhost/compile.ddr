            }
            if word == "f32" { return 6 }
            if word == "f64" { return 7 }
            found := map.get_or(&c.functions, word, -1)
            if found >= 0 && floats.has(c.returns[i32(found)]) { return c.returns[i32(found)] }
            break
        } else if word == "(" { depth = depth + 1 }
        else if word == ")" {
            if depth == 0 { break }; depth = depth - 1
        } else if word == "." {
            if pos + 3 >= c.tokens.kinds.len || c.tokens.texts[pos + 2] != "(" || c.tokens.texts[pos + 3] != ")" { break }
            name := c.tokens.texts[pos + 1]
