import lexer
import arm64 as arm
import std.map as map
import std.parse as parse
import runtime

// Native Dunder compiler. Values use eight-byte cells; aggregates have value semantics.
// Primitive IDs: ()=0, i32=1, i64=2, bool=3, string=4, rune=5.
pub struct Result { ok: bool, error: string, offset: i32, text: []i32 }
struct Compiler {
    tokens: lexer.Tokens, closes: []i32, block_end: i32, tail: bool, block_depth: i32, cursor: i32, ok: bool, error: string, error_at: i32,
    functions: map.Map, names: []string, starts: []i32, ends: []i32, returns: []i32,
    param_starts: []i32, param_counts: []i32, param_names: []string, param_types: []i32,
    code: arm.Code, fn_labels: []i32, needed: []bool, runtime: runtime.Runtime,
    type_names: []string, type_kinds: []i32, type_bases: []i32, type_starts: []i32, type_counts: []i32, type_clones: []i32,
    field_names: []string, field_types: []i32, field_values: []i64, address: i32, writable: bool,
    local_names: []string, local_types: []i32, local_slots: []i32, local_scopes: []i32, local_mutable: []bool,
    scope: i32, slots: i32, ret_type: i32, depth: i32,
    loop_heads: []i32, loop_ends: []i32,
    strings: []string, string_labels: []i32,
    print_int: i32, print_bool: i32, print_text: i32, write: i32,
    overflow: i32, zero: i32, assertion: i32, io: i32, bounds: i32,
}
fn peek(c: &Compiler) -> string { c.tokens.texts[c.cursor] }
fn is(c: &Compiler, word: string) -> bool { c.tokens.kinds[c.cursor] != .String && c.tokens.kinds[c.cursor] != .Rune && peek(&c) == word }
fn fail(c: &mut Compiler, message: string) { if c.ok { c.ok = false; c.error = message; c.error_at = c.tokens.starts[c.cursor] } }
fn advance(c: &mut Compiler) -> string { value := peek(&c); if c.cursor + 1 < c.tokens.texts.len { c.cursor = c.cursor + 1 }; value }
fn eat(c: &mut Compiler, word: string) -> bool { if is(&c, word) { consumed := advance(&mut c); return true }; false }
fn expect(c: &mut Compiler, word: string) { if !eat(&mut c, word) { fail(&mut c, "expected '" + word + "'") } }
fn separators(c: &mut Compiler) { while c.ok && (is(&c, "\n") || is(&c, ";")) { skipped := advance(&mut c) } }
fn newlines(c: &mut Compiler) { while c.ok && is(&c, "\n") { skipped := advance(&mut c) } }
fn reserved(name: string) -> bool { name == "print" || name == "assert" || name == "i32" || name == "i64" || name == "bool" || name == "string" || name == "len" || name == "f32" || name == "f64" || name == "rune" || name == "range" }
fn identifier(name: string) -> bool {
    if name.len == 0 { return false }
    for i in 0..name.len {
        byte := name[i]
        letter := (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
        if !letter && !(i > 0 && byte >= 48 && byte <= 57) { return false }
    }
    true
}
fn add_type(c: &mut Compiler, name: string, kind: i32, base: i32) -> i32 {
    id := c.type_names.len
    c.type_names.push(name); c.type_kinds.push(kind); c.type_bases.push(base)
    c.type_starts.push(0); c.type_counts.push(0); c.type_clones.push(arm.label(&mut c.code))
    id
}
fn compound(c: &mut Compiler, kind: i32, base: i32) -> i32 {
    if kind == 1 && (c.type_kinds[base] == 1 || c.type_kinds[base] == 2) { fail(&mut c, "arrays of aggregate elements are not supported by this compiler") }
    for i in 0..c.type_names.len { if c.type_kinds[i] == kind && c.type_bases[i] == base { return i } }
    add_type(&mut c, "", kind, base)
}
fn type_id(c: &Compiler, name: string) -> i32 {
    for i in 0..c.type_names.len { if c.type_names[i] == name { return i } }
    -1
}
fn type_name(c: &mut Compiler) -> i32 {
    if eat(&mut c, "&") { var kind := 4; if eat(&mut c, "mut") { kind = 5 }; base := type_name(&mut c); return compound(&mut c, kind, base) }
    if eat(&mut c, "[") {
        if eat(&mut c, "]") { base := type_name(&mut c); return compound(&mut c, 1, base) }
        fail(&mut c, "fixed arrays are not supported by this compiler"); return 0
    }
    if eat(&mut c, "(") { expect(&mut c, ")"); return 0 }
    name := advance(&mut c); found := type_id(&c, name)
    if found < 0 { fail(&mut c, "unknown type '" + name + "'"); return 0 }
    found
}
fn same(c: &mut Compiler, expected: i32, actual: i32) {
    if expected == actual { return }
    if c.type_kinds[expected] == 4 && c.type_kinds[actual] == 5 && c.type_bases[expected] == c.type_bases[actual] { return }
    if c.ok { fail(&mut c, "type mismatch: " + c.type_names[expected] + " / " + c.type_names[actual]) }
}
fn field(c: &Compiler, ty: i32, name: string) -> i32 {
    first := c.type_starts[ty]
    for i in first..first + c.type_counts[ty] { if c.field_names[i] == name { return i } }
    -1
}
fn load_mem(c: &mut Compiler, destination: i32, base: i32, offset: i32) { arm.emit(&mut c.code, 4181721088 + i64(offset / 8) * 1024 + i64(base) * 32 + i64(destination)) }
fn store_mem(c: &mut Compiler, source: i32, base: i32, offset: i32) { arm.emit(&mut c.code, 4177526784 + i64(offset / 8) * 1024 + i64(base) * 32 + i64(source)) }
fn address_slot(c: &mut Compiler, index: i32) {
    arm.imm(&mut c.code, 0, i64(index + 1) * 8); arm.emit(&mut c.code, 3405775776)
}
fn save_address(c: &mut Compiler) { c.address = slot(&mut c); arm.store(&mut c.code, c.address, 0) }
fn copy_value(c: &mut Compiler, ty: i32) {
    if c.type_kinds[ty] == 1 { arm.branch(&mut c.code, c.runtime.array_clone, 1) }
    else if c.type_kinds[ty] == 2 { arm.branch(&mut c.code, c.type_clones[ty], 1) }
}
fn skip_body(c: &mut Compiler) { expect(&mut c, "{"); c.cursor = c.closes[c.cursor - 1] + 1 }
fn headers(c: &mut Compiler) {
    var stack: []i32 = []
    for i in 0..c.tokens.kinds.len {
        if c.tokens.kinds[i] == .Symbol {
            if c.tokens.texts[i] == "{" { stack.push(i) }
            if c.tokens.texts[i] == "}" { if stack.len == 0 { fail(&mut c, "unexpected closing brace"); return }; open := stack.pop(); c.closes[open] = i }
        }
    }
    if stack.len != 0 { fail(&mut c, "unterminated body"); return }
    // Register every nominal type before parsing fields or function signatures.
    var declarations: []i32 = []; var declaration_types: []i32 = []
    separators(&mut c)
    while c.ok && c.tokens.kinds[c.cursor] != .End {
        if eat(&mut c, "@") {
            annotation := advance(&mut c)
            if is(&c, "{") { skip_body(&mut c); separators(&mut c); continue }
        }
        public := eat(&mut c, "pub")
        what := advance(&mut c)
        if what != "fn" && what != "struct" && what != "enum" { fail(&mut c, "expected fn, struct or enum (imports must be loaded first)"); break }
        name := advance(&mut c)
        declarations.push(c.cursor)
        var ty := -1
        if what != "fn" {
            if type_id(&c, name) >= 0 { fail(&mut c, "duplicate type") }
            var kind := 2; if what == "enum" { kind = 3 }
            ty = add_type(&mut c, name, kind, 0)
        } else {
            if map.contains(&c.functions, name) || reserved(name) { fail(&mut c, "duplicate or reserved function name") }
            map.put(&mut c.functions, name, i64(c.names.len)); c.names.push(name); c.fn_labels.push(arm.label(&mut c.code)); c.needed.push(false)
        }
        declaration_types.push(ty)
        while c.ok && !is(&c, "{") { if c.tokens.kinds[c.cursor] == .End { fail(&mut c, "missing declaration body"); break }; skipped := advance(&mut c) }
        if c.ok { skip_body(&mut c); separators(&mut c) }
    }
    for d in 0..declarations.len {
        if !c.ok { break }
        c.cursor = declarations[d]; ty := declaration_types[d]
        if ty >= 0 {
            expect(&mut c, "{"); c.type_starts[ty] = c.field_names.len; separators(&mut c)
            var tag: i64 = 0
            while c.ok && !is(&c, "}") {
                name := advance(&mut c); var ft := 0
                if c.type_kinds[ty] == 2 { expect(&mut c, ":"); ft = type_name(&mut c) }
                else {
                    if eat(&mut c, "(") { while c.ok && !eat(&mut c, ")") { skipped := advance(&mut c) } }
                    if eat(&mut c, "=") { value := parse.integer(advance(&mut c)); tag = value.value }
                }
                c.field_names.push(name); c.field_types.push(ft); c.field_values.push(tag); tag = tag + 1
                if !eat(&mut c, ",") { separators(&mut c); if !is(&c, "}") { fail(&mut c, "expected field comma") } }; separators(&mut c)
            }
            c.type_counts[ty] = c.field_names.len - c.type_starts[ty]
        } else {
            expect(&mut c, "("); first := c.param_names.len
            while c.ok && !is(&c, ")") {
                parameter := advance(&mut c); expect(&mut c, ":"); pt := type_name(&mut c)
                c.param_names.push(parameter); c.param_types.push(pt)
                if !eat(&mut c, ",") { break }
            }
            expect(&mut c, ")"); c.param_starts.push(first); c.param_counts.push(c.param_names.len - first)
            var ret := 0; if eat(&mut c, "->") { ret = type_name(&mut c) }; c.returns.push(ret)
            newlines(&mut c); expect(&mut c, "{"); c.starts.push(c.cursor); c.ends.push(c.closes[c.cursor - 1])
            if ret != 0 { newlines(&mut c); if is(&c, "}") { fail(&mut c, "function can finish without returning a value") } }
        }
    }
}
fn slot(c: &mut Compiler) -> i32 {
    result := c.slots; c.slots = c.slots + 1
    if c.slots > 65535 { fail(&mut c, "this compiler stage allows at most 65535 local slots per function") }
    result
}
fn local(c: &Compiler, name: string) -> i32 {
    var i := c.local_names.len - 1
    while i >= 0 { if c.local_names[i] == name { return i }; i = i - 1 }
    -1
}
fn bind(c: &mut Compiler, name: string, ty: i32, mutable: bool, index: i32) {
    if !identifier(name) { fail(&mut c, "this compiler stage supports ASCII identifiers") }
    if reserved(name) { fail(&mut c, "reserved local name") }
    for i in 0..c.local_names.len { if c.local_names[i] == name && c.local_scopes[i] == c.scope { fail(&mut c, "duplicate local name") } }
    c.local_names.push(name); c.local_types.push(ty); c.local_mutable.push(mutable); c.local_slots.push(index); c.local_scopes.push(c.scope)
}
fn enter(c: &mut Compiler) { c.scope = c.scope + 1 }
fn leave(c: &mut Compiler) {
    while c.local_names.len > 0 && c.local_scopes[c.local_scopes.len - 1] == c.scope {
        name := c.local_names.pop(); ty := c.local_types.pop(); mutable := c.local_mutable.pop(); index := c.local_slots.pop(); scope := c.local_scopes.pop()
    }
    c.scope = c.scope - 1
}
fn narrow(c: &mut Compiler) {
    arm.emit(&mut c.code, 2470476802); arm.emit(&mut c.code, 3942776863); arm.branch(&mut c.code, c.overflow, 3)
}
fn literal(c: &mut Compiler, spelling: string, expected: i32) -> i32 {
    value := parse.integer(spelling)
    var ty := 1
    if expected == 2 { ty = 2 }
    if !value.ok || (ty == 1 && (value.value < -2147483648 || value.value > 2147483647)) { fail(&mut c, "integer literal out of range"); return ty }
    arm.imm(&mut c.code, 0, value.value)
    ty
}
fn intrinsic(c: &mut Compiler, name: string, expected: i32) -> i32 {
    if c.code.platform != 1 { fail(&mut c, "selfhost filesystem and argument intrinsics currently require arm64-linux"); return 0 }
    var target := -1; var ret := expected
    if name == "__sys_arg_count" { target = c.runtime.sys_arg_count; ret = 1 }
    else if name == "__sys_arg" { target = c.runtime.sys_arg; ret = 4 }
    else if name == "__sys_pid" { target = c.runtime.sys_pid; ret = 1 }
    else if name == "__sys_read_text" { target = c.runtime.sys_read_text }
    else if name == "__sys_metadata" { target = c.runtime.sys_metadata }
    else if name == "__sys_same_file" { target = c.runtime.sys_same_file; ret = 3 }
    else if name == "__sys_write_bytes" { target = c.runtime.sys_write_bytes }
    else if name == "__sys_make_executable" { target = c.runtime.sys_make_executable }
    else if name == "__sys_rename" { target = c.runtime.sys_rename }
    else if name == "__sys_remove_file" { target = c.runtime.sys_remove_file }
    else if name == "__sys_decode_utf8" { target = c.runtime.sys_decode_utf8 }
    else if name == "__sys_write_stderr" { target = c.runtime.sys_stderr }
    if target < 0 { fail(&mut c, "unsupported intrinsic '" + name + "'"); return 0 }
    var count := 0
    while c.ok && !is(&c, ")") {
        ty := expression(&mut c, 0, 0)
        if c.type_kinds[ty] == 4 || c.type_kinds[ty] == 5 { load_mem(&mut c, 0, 0, 0) }
        arm.push(&mut c.code, 0); count = count + 1
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")")
    var i := count - 1; while i >= 0 { arm.pop(&mut c.code, i); i = i - 1 }
    arm.branch(&mut c.code, target, 1); ret
}
fn call(c: &mut Compiler, name: string, expected: i32) -> i32 {
    expect(&mut c, "(")
    if name.len >= 6 && name[0..6] == "__sys_" { return intrinsic(&mut c, name, expected) }
    if name == "print" {
        ty := expression(&mut c, 0, 0); expect(&mut c, ")")
        var target := c.print_int
        if ty == 3 { target = c.print_bool } else if ty == 4 { target = c.print_text }
        else if ty == 5 { arm.branch(&mut c.code, c.runtime.string_rune, 1); target = c.print_text }
        else if ty != 1 && ty != 2 && ty != 5 { fail(&mut c, "print requires a scalar value") }
        arm.branch(&mut c.code, target, 1); return 0
    }
    if name == "assert" { ty := expression(&mut c, 0, 3); same(&mut c, 3, ty); expect(&mut c, ")"); arm.branch(&mut c.code, c.assertion, 18); return 0 }
    if name == "i32" || name == "i64" || name == "rune" {
        var hint := 1; if name == "i64" { hint = 2 }; if name == "rune" { hint = 5 }
        var argument_hint := 0
        if c.tokens.kinds[c.cursor] == .Integer && c.tokens.texts[c.cursor + 1] == ")" { argument_hint = hint }
        ty := expression(&mut c, 0, argument_hint); expect(&mut c, ")")
        if ty != 1 && ty != 2 && ty != 5 { fail(&mut c, "integer conversion requires an integer") }
        if hint == 1 { narrow(&mut c) }; return hint
    }
    found := map.get_or(&c.functions, name, -1)
    if found < 0 { fail(&mut c, "unknown function '" + name + "'"); return 0 }
    f := i32(found); first := c.param_starts[f]; count := c.param_counts[f]
    c.needed[f] = true
    var provided := 0; var args: []i32 = []
    while c.ok && !is(&c, ")") {
        if provided >= count { fail(&mut c, "too many arguments"); break }
        want := c.param_types[first + provided]
        ty := expression(&mut c, 0, want); same(&mut c, want, ty); copy_value(&mut c, ty)
        index := slot(&mut c); arm.store(&mut c.code, index, 0); args.push(index); provided = provided + 1
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")"); if provided != count { fail(&mut c, "wrong argument count") }
    var i := provided - 1
    while i >= 8 { arm.load(&mut c.code, args[i]); arm.push(&mut c.code, 0); i = i - 1 }
    // Load x0 last: the slot helper uses x0/x9 only.
    while i >= 0 { arm.load(&mut c.code, args[i]); arm.mov(&mut c.code, i, 0); i = i - 1 }
    arm.branch(&mut c.code, c.fn_labels[f], 1)
    for unused in 8..provided { arm.pop(&mut c.code, 9) }
    c.returns[f]
}
fn primary(c: &mut Compiler, expected: i32) -> i32 {
    c.depth = c.depth + 1
    if c.depth > 128 { fail(&mut c, "expression nesting exceeds 128"); c.depth = c.depth - 1; return 0 }
    c.address = -1; c.writable = false
    var ty := primary_inner(&mut c, expected)
    while c.ok && (is(&c, ".") || is(&c, "[")) {
        if eat(&mut c, "[") {
            writable := c.writable
            arm.push(&mut c.code, 0)
            index_type := expression(&mut c, 0, 1); same(&mut c, 1, index_type)
            if eat(&mut c, "..") {
                if ty != 4 { fail(&mut c, "slice requires a string") }
                arm.push(&mut c.code, 0); last := expression(&mut c, 0, 1); same(&mut c, 1, last); expect(&mut c, "]")
                arm.mov(&mut c.code, 2, 0); arm.pop(&mut c.code, 1); arm.pop(&mut c.code, 0); arm.branch(&mut c.code, c.runtime.string_slice, 1)
                c.address = -1; c.writable = false; continue
            }
            expect(&mut c, "]"); arm.pop(&mut c.code, 1)
            if ty == 4 { arm.mov(&mut c.code, 2, 0); arm.mov(&mut c.code, 0, 1); arm.mov(&mut c.code, 1, 2); arm.branch(&mut c.code, c.runtime.string_index, 1); ty = 1; c.address = -1; c.writable = false }
            else if c.type_kinds[ty] == 1 {
                load_mem(&mut c, 2, 1, 8); arm.emit(&mut c.code, 3942776863); arm.branch(&mut c.code, c.bounds, 4)
                load_mem(&mut c, 1, 1, 0); arm.emit(&mut c.code, 2332036128)
                save_address(&mut c); load_mem(&mut c, 0, 0, 0); ty = c.type_bases[ty]; c.writable = writable
            } else { fail(&mut c, "index requires an array or string") }
        } else {
            expect(&mut c, "."); name := advance(&mut c)
            if is(&c, "(") { ty = method(&mut c, ty, name); c.address = -1; c.writable = false }
            else if name == "len" && (ty == 4 || c.type_kinds[ty] == 1) {
                var offset := 0; if ty != 4 { offset = 8 }; load_mem(&mut c, 0, 0, offset); ty = 1; c.address = -1; c.writable = false
            } else if c.type_kinds[ty] == 2 {
                found := field(&c, ty, name)
                if found < 0 { fail(&mut c, "unknown field '" + name + "'") }
                else { offset := (found - c.type_starts[ty]) * 8; arm.emit(&mut c.code, 2432696320 + i64(offset) * 1024); save_address(&mut c); load_mem(&mut c, 0, 0, 0); ty = c.field_types[found] }
            } else { fail(&mut c, "unknown member '" + name + "'") }
        }
    }
    c.depth = c.depth - 1; ty
}
fn enumeration(c: &mut Compiler, ty: i32) -> i32 {
    name := advance(&mut c)
    if ty < 0 || c.type_kinds[ty] != 3 { fail(&mut c, "enum variant needs a type"); return 0 }
    found := field(&c, ty, name)
    if found < 0 { fail(&mut c, "unknown enum variant"); return ty }
    arm.imm(&mut c.code, 0, c.field_values[found]); ty
}
fn primary_inner(c: &mut Compiler, expected: i32) -> i32 {
    if !c.ok { return 0 }
    if eat(&mut c, "&") {
        mutable := eat(&mut c, "mut"); ty := primary(&mut c, 0)
        if c.address < 0 { fail(&mut c, "borrow requires a stored value"); return 0 }
        if mutable && !c.writable { fail(&mut c, "mutable borrow requires var or &mut") }
        arm.load(&mut c.code, c.address); c.address = -1; c.writable = false
        var kind := 4; if mutable { kind = 5 }; return compound(&mut c, kind, ty)
    }
    if eat(&mut c, "-") {
        if c.tokens.kinds[c.cursor] == .Integer { spelling := "-" + advance(&mut c); return literal(&mut c, spelling, expected) }
        ty := primary(&mut c, expected); if ty != 1 && ty != 2 { fail(&mut c, "minus requires an integer") }
        arm.emit(&mut c.code, 3942646752); arm.branch(&mut c.code, c.overflow, 8); if ty == 1 { narrow(&mut c) }; c.address = -1; c.writable = false; return ty
    }
    if eat(&mut c, "!") { ty := primary(&mut c, 3); same(&mut c, 3, ty); arm.emit(&mut c.code, 3944677407); arm.emit(&mut c.code, 2594117600); c.address = -1; c.writable = false; return 3 }
    if eat(&mut c, "(") { ty := expression(&mut c, 0, expected); expect(&mut c, ")"); return ty }
    if eat(&mut c, "true") { arm.imm(&mut c.code, 0, 1); return 3 }
    if eat(&mut c, "false") { arm.imm(&mut c.code, 0, 0); return 3 }
    if eat(&mut c, ".") { return enumeration(&mut c, expected) }
    if eat(&mut c, "[") {
        var base := 0; if c.type_kinds[expected] == 1 { base = c.type_bases[expected] }
        arm.branch(&mut c.code, c.runtime.array_new, 1); saved := slot(&mut c); arm.store(&mut c.code, saved, 0)
        while c.ok && !is(&c, "]") {
            ty := expression(&mut c, 0, base); if base == 0 { base = ty } else { same(&mut c, base, ty) }; copy_value(&mut c, ty)
            arm.push(&mut c.code, 0); arm.load(&mut c.code, saved); arm.pop(&mut c.code, 1); arm.branch(&mut c.code, c.runtime.array_push, 1)
            if !eat(&mut c, ",") { break }
        }
        expect(&mut c, "]"); arm.load(&mut c.code, saved); c.address = -1; c.writable = false
        if base == 0 { fail(&mut c, "empty array needs an element type") }; return compound(&mut c, 1, base)
    }
    kind := c.tokens.kinds[c.cursor]
    if kind == .Integer { spelling := advance(&mut c); return literal(&mut c, spelling, expected) }
    if kind == .String || kind == .Rune {
        text := advance(&mut c); target := arm.label(&mut c.code)
        c.strings.push(text); c.string_labels.push(target); arm.branch(&mut c.code, target, 20)
        if kind == .Rune { arm.branch(&mut c.code, c.runtime.string_runes, 1); load_mem(&mut c, 0, 0, 0); load_mem(&mut c, 0, 0, 0); return 5 }; return 4
    }
    if kind == .Name {
        name := advance(&mut c); nominal := type_id(&c, name)
        if nominal >= 0 && c.type_kinds[nominal] == 3 && eat(&mut c, ".") { return enumeration(&mut c, nominal) }
        if nominal >= 0 && c.type_kinds[nominal] == 2 && eat(&mut c, "{") {
            arm.imm(&mut c.code, 0, i64(c.type_counts[nominal]) * 8); arm.branch(&mut c.code, c.runtime.alloc, 1)
            saved := slot(&mut c); arm.store(&mut c.code, saved, 0); var provided: []bool = []
            for i in 0..c.type_counts[nominal] { provided.push(false) }; separators(&mut c)
            while c.ok && !is(&c, "}") {
                member := advance(&mut c); expect(&mut c, ":"); found := field(&c, nominal, member)
                if found < 0 { fail(&mut c, "unknown constructor field"); break }
                offset := found - c.type_starts[nominal]
                if provided[offset] { fail(&mut c, "duplicate constructor field") }; provided[offset] = true
                ty := expression(&mut c, 0, c.field_types[found]); same(&mut c, c.field_types[found], ty); copy_value(&mut c, ty)
                arm.push(&mut c.code, 0); arm.load(&mut c.code, saved); arm.pop(&mut c.code, 1); store_mem(&mut c, 1, 0, offset * 8)
                if !eat(&mut c, ",") { break }; separators(&mut c)
            }
            separators(&mut c); expect(&mut c, "}")
