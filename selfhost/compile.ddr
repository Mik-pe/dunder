// Code has already been emitted from a prepared bounded plan. Failure is an
// internal error, never fallback: partially accounted code must not be cached.
// A negative declaration charges a builtin expansion without a callee ID.
fn charge_inline(c: &mut Compiler, declaration: i32, estimate: i32, first_word: i32) -> bool {
    actual := arm.position(&c.code) - first_word
    if first_word < 0 || declaration >= c.names.len || estimate < 0 || estimate > c.inline_caller_words || estimate > c.inline_global_words || actual < 0 || actual > estimate {
        fail(&mut c, "internal inline growth accounting failure"); return false
