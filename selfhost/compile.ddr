    if platform != 0 { arm.emit(&mut c.code, 4181722103); arm.emit(&mut c.code, 2432705528) }
    else { arm.mov(&mut c.code, 23, 0); arm.mov(&mut c.code, 24, 1) }
    runtime.emit_profile_start(&mut c.code, &rt)
    arm.branch(&mut c.code, c.fn_labels[main_id], 1)
    runtime.emit_profile_report(&mut c.code, &rt)
    arm.syscall(&mut c.code, 33554433, 94); arm.emit(&mut c.code, 3558866944)
    c.needed[main_id] = true; var compiled: []bool = []
    for f in 0..c.names.len { compiled.push(false); c.callback_labels.push(-1) }
    globals := arm.label_count(&c.code)
    if c.bindings.profile.enabled { profile.finish(&mut c.bindings.profile, 0, declarations_started, i64(c.names.len)) }
    var scalar_model := opt_ir.new()
    var scalar_work := opt_verify.new()
    var scalar_plan := opt_alloc.new()
    var range_work := opt_range.new()
    var machine_work := machine_ir.new()
    var emit_settings := opt_emit.options()
    emit_settings.const_div_enabled = config.const_div_enabled; emit_settings.frame_free_enabled = config.frame_free_enabled
    var catalog := opt_inline.new()
    var inline_work := opt_inline.workspace()
    if c.inline_enabled {
        opt_inline.configure(&mut inline_work, config.const_div_enabled, config.frame_free_enabled)
        inline_catalog(&mut c, &mut catalog, &mut scalar_model, &mut scalar_work, &mut range_work, directory != "" && identity != "" && platform != 3)
        if !c.ok { return Result { ok: false, error: c.error, offset: c.error_at, text: [], imports: imports() } }
    }
    var cache := ""
    if !check_all && platform != 3 && directory != "" && (!c.inline_enabled || opt_inline.digest_ready(&catalog)) {
        var policy := identity
        if policy != "" {
            if scalar_enabled { policy = policy + ":scalar:on" } else { policy = policy + ":scalar:off" }
            if config.ownership_enabled { policy = policy + ":ownership:on" } else { policy = policy + ":ownership:off" }
            if config.const_div_enabled { policy = policy + ":const-div:on" } else { policy = policy + ":const-div:off" }
            if config.frame_free_enabled { policy = policy + ":frame-free:on" } else { policy = policy + ":frame-free:off" }
            if config.range_enabled { policy = policy + ":range:on" } else { policy = policy + ":range:off" }
            if c.inline_enabled { policy = policy + ":inline-expression-v2:dependencies1:tokens128-32768:caller4096:global65536:utf8-v1-staging48:" + opt_inline.fingerprint(&catalog) } else { policy = policy + ":inline:off" }
            if config.mir_enabled { policy = policy + ":mir-physical-v3:frame-spans1:return-abi1:promotion2-entry-load-work4194304" } else { policy = policy + ":mir:off" }
            if config.mir_opt_enabled { policy = policy + ":mir-opt:on" } else { policy = policy + ":mir-opt:off" }
            policy = policy + ":" + mir_memory.source_policy_tag(config.mir_memory_enabled)
            if config.mir_values_enabled { policy = policy + ":mir-values:v1-terminal1-work4194304" } else { policy = policy + ":mir-values:off" }
