    records.modeled = c.bindings.modeled; records.optimized = c.bindings.optimized
    records.rewrites = c.bindings.rewrites; records.proven_bounds = c.bindings.proven_bounds; records.fallbacks = c.bindings.fallbacks
    records.inline_entries = c.bindings.inline_entries; records.inline_nodes = c.bindings.inline_nodes
    records.inline_tokens = c.bindings.inline_tokens; records.inline_units = c.bindings.inline_units
    records.inlined_calls = c.bindings.inlined_calls; records.inlined_words = c.bindings.inlined_words
    records.inline_estimated_words = c.bindings.inline_estimated_words
    records.mir_functions = c.bindings.mir_functions; records.mir_operations = c.bindings.mir_operations; records.mir_opaque = c.bindings.mir_opaque
    records.mir_optimization_enabled = c.bindings.mir_optimization_enabled
    records.mir_source_objects_enabled = c.bindings.mir_source_objects_enabled; records.mir_private_memory_ops = c.bindings.mir_private_memory_ops
    records.mir_optimized = c.bindings.mir_optimized; records.mir_promoted = c.bindings.mir_promoted
    records.mir_removed_loads = c.bindings.mir_removed_loads; records.mir_removed_stores = c.bindings.mir_removed_stores
    records.mir_analysis_units = c.bindings.mir_analysis_units; records.mir_budget_refusals = c.bindings.mir_budget_refusals
    records.mir_values_enabled = c.bindings.mir_values_enabled; records.mir_values_optimized = c.bindings.mir_values_optimized
    records.mir_value_rewrites = c.bindings.mir_value_rewrites; records.mir_value_deleted = c.bindings.mir_value_deleted; records.mir_value_immediates = c.bindings.mir_value_immediates
    records.mir_value_analysis_units = c.bindings.mir_value_analysis_units; records.mir_value_budget_refusals = c.bindings.mir_value_budget_refusals
