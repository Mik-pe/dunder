    if profile_host > 2 { return Result { ok: false, error: "compiler profiling requires a native host", offset: 0, text: [], imports: imports() } }
    if instrument_runtime && platform == 3 && !check_all { return Result { ok: false, error: "runtime profiling requires a native target", offset: 0, text: [], imports: imports() } }
    var declarations_started: i64 = -1
