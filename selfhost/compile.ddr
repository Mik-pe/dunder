// Fragments omit parameter effects. Recheck only bodies that can create or
// forward a region borrow when the program uses regions.
fn needs_loan_analysis(c: &Session, f: i32) -> bool {
    if !c.loans.active { return false }
    for p in c.world.param_starts[f]..c.world.param_starts[f] + c.world.param_counts[f] {
        kind := ft.type_kind(&c.types, c.world.param_types[p])
        if kind == 4 || kind == 5 { return true }
    }
    for i in c.world.starts[f]..c.world.ends[f] {
        if c.world.tokens.kinds[i] == .Name && c.world.tokens.texts[i] == "region" && c.world.tokens.kinds[i + 1] == .Name { return true }
    }
    false
}
// A projection inherits its resolved root's lifetime. Copies become ordinary locals.
fn loan_origin(c: &Session, place: i32) -> i32 {
    binding := borrows.root(&c.body.places, place)
    if binding < 0 { return -1 }
    kind := ft.type_kind(&c.types, c.body.locals.types[binding])
    if kind == 21 { return -2 }
    if c.body.locals.scopes[binding] == 0 && (kind == 4 || kind == 5) {
        return c.body.first_parameter + binding
    }
    -1
}
fn forward_loan(c: &mut Session, origin: i32, f: i32, signature: i32, parameter: i32, at: i32) {
    if origin == -1 { return }
    if f >= 0 {
        facts.forward(&mut c.body.facts, origin, c.world.param_starts[f] + parameter, at)
    } else if signature < c.types.declared.type_kinds.len {
        // Only canonical declared signatures can match an address-taken declaration.
        facts.indirect(&mut c.body.facts, origin, signature, parameter, at)
    }
}
// Code has already been emitted from a prepared bounded plan. Failure is an
// internal error, never fallback: partially accounted code must not be cached.
// A negative declaration charges a builtin expansion without a callee ID.
fn charge_inline(c: &mut Session, declaration: i32, estimate: i32, first_word: i32) -> bool {
    actual := arm.position(&c.code) - first_word
    if first_word < 0 || declaration >= c.world.names.len || estimate < 0 || actual < 0 || actual > estimate {
        fail(&mut c, "internal inline growth accounting failure"); return false
    }
    var recorded := false
    if declaration >= 0 { recorded = fragments.record_dependency(&mut c.body.inline_deps, declaration, estimate) }
    else { recorded = fragments.charge_dependency_words(&mut c.body.inline_deps, estimate) }
    if !recorded { fail(&mut c, "internal inline dependency admission failure"); return false }
    c.bindings.inlined_calls = c.bindings.inlined_calls + 1; c.bindings.inlined_words = c.bindings.inlined_words + actual
    c.bindings.inline_estimated_words = c.bindings.inline_estimated_words + estimate
    true
}
// The stream head has already established that x1 is an in-bounds scalar
// boundary in the retained immutable snapshot. Frame helpers preserve x1.
// Charge the same per-function growth budget as ordinary expression inlining.
fn inline_rune_stream(c: &mut Session, values: i32, cursor: i32, source: i32) -> bool {
    estimate := runtime.utf8_next_word_estimate() + 16
    if !c.inline_enabled || c.validating_dead || c.code.checking ||
        fragments.remaining_words(&c.body.inline_deps) < estimate { return false }
    first := arm.position(&c.code)
    arm.load(&mut c.code, values)
    iteration.rune(&mut c.code, source)
    arm.store(&mut c.code, cursor, 1)
    charged := charge_inline(&mut c, -1, estimate, first)
    // Admission failure is an internal compiler error, never a second emission.
    true
}
fn invoke(c: &mut Session, signature: i32, address: i32, f: i32, wasm_sig: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    source_offset := c.world.tokens.starts[c.body.cursor - 1]
    if address >= 0 || wasm_sig >= 0 { task_edge(&mut c, -1) } else { task_edge(&mut c, f) }
    first := ft.type_start(&c.types, signature); count := ft.type_count(&c.types, signature)
    first_writeback := c.body.scratch_returns.len
    var provided := 0; var args: []i32 = []; var arg_starts: []i32 = []; var arg_places: []i32 = []; var arg_sources: []i32 = []; var effects: []i32 = []
    while c.ok && !is(&c, ")") {
        if provided >= count { fail(&mut c, "too many arguments"); break }
        argument := c.body.cursor
        arg_starts.push(argument); effects.push(c.body.mutations.len)
        want := ft.parameter_type(&c.types, first + provided)
        previous_address := c.body.taking_address; c.body.taking_address = false
        ty := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model)
        c.body.taking_address = previous_address
        same(&mut c, want, ty); take_value(&mut c, ty)
