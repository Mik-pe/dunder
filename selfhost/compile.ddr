            if c.world.unsafe_functions[f] { fail(&mut c, "unsafe function requires a foreign function pointer"); return 0 }
            if c.loans.active { c.body.facts.taken.push(f) }
            may_invalidate_operand(&mut c); c.body.facts.needed.push(f); arm.branch(&mut c.code, c.fn_labels[f], 20); return c.world.ffi_types[f]
        }
        fail(&mut c, "expected expression"); return 0
    }
    if eat(&mut c, "if") { return if_value(&mut c, expected, &catalog, &mut inline_work, &mut model) }
    if eat(&mut c, "match") {
        var result := 0
        ignored := match_arms(&mut c, expected, &mut result, &catalog, &mut inline_work, &mut model)
        if !c.ok { return 0 }
        return joined_value(&mut c, result)
    }
    if eat(&mut c, "&") {
        may_invalidate_operand(&mut c) // Borrowed storage becomes visible to a receiver.
        mutable := eat(&mut c, "mut")
        var kind := 4; if mutable { kind = 5 }
        if ft.type_kind(&c.types, expected) != kind { fail(&mut c, "use & for a shared parameter or &mut for a mutable parameter"); return 0 }
        previous_address := c.body.taking_address; c.body.taking_address = true
        var ty := primary(&mut c, 0, &catalog, &mut inline_work, &mut model)
        c.body.taking_address = previous_address
        place = c.body.places.current; at = c.body.places.source
        base := borrows.root(&c.body.places, place)
        if base < 0 { fail(&mut c, "borrow a named variable, field or array element"); return 0 }
        if mutable && is_for_locked(&c, base) { fail(&mut c, "cannot mutably borrow a collection while iterating over it"); return 0 }
        if mutable { c.body.mutations.push(base) }
        if ft.type_kind(&c.types, ty)==21 {
            elem:=ft.type_base(&c.types, ty)
            if mutable || ft.type_kind(&c.types, expected)!=4 || ft.type_kind(&c.types, ft.type_base(&c.types, expected))!=1 || ft.type_base(&c.types, ft.type_base(&c.types, expected))!=elem || i32(1).shl(unsigned.shift(storage_type(&c, elem)))!=scratch_width(&c,elem) {fail(&mut c,"scratch slice needs a shared, representation-compatible parameter");return 0}
            ty=ft.type_base(&c.types, expected)
