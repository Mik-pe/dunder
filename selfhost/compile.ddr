        arm.finish_array_literal(&mut c.code, allocation, base, ty, unsigned.shift(storage_type(&c, base)), source)
        return temporary(&mut c, ty)
    }
    fail(&mut c, "expected expression"); 0
}
fn local_value_type(c: &mut Session, found: i32) -> i32 {
    ty := c.body.locals.types[found]; local_kind := ft.type_kind(&c.types, ty)
    if local_kind == 23 { fail(&mut c, "task scope capability is only valid with spawn or await"); return 0 }
    if local_kind == 20 { fail(&mut c, "region is only valid in an allocation"); return 0 }
    if local_kind == 4 || local_kind == 5 { return ft.type_base(&c.types, ty) }
    ty
}
fn load_binding(c: &mut Session, found: i32, access: borrows.Access, token: i32) {
    local_type := c.body.locals.types[found]; kind := ft.type_kind(&c.types, local_type)
    home := places.local_home(c.body.places.arena.locals[found])
    c.body.scratch_place = 0; c.body.inline_place = false
    if kind == 21 { c.body.scratch_place = 3 }
    if kind == 4 || kind == 5 {
        c.body.writable = kind == 5
        ty := ft.type_base(&c.types, local_type)
        // The parameter home already contains the address of its referent.
        c.body.address = home; c.body.direct_place = false
        if access != .Address { bound_place(&mut c, .BorrowSaved, borrows.local_id(found), i32(access), token) }
        if ft.is_c_record(&c.types, ty) || fixed_pod(&c, ty) {
            c_layout(&mut c, ty); c.body.inline_place = true
            if access != .Address { inline_value(&mut c, ty, access, token) }
        } else if access != .Address { bound_place(&mut c, .Read, borrows.local_id(found), i32(access), token) }
    } else {
        c.body.writable = c.body.locals.mutable[found]; c.body.direct_place = true; c.body.address = home
        if access != .Address && (!c.code.checking || c.code.prefixing) { bound_place(&mut c, .LocalRead, borrows.local_id(found), i32(access), token) }
    }
}
fn field_offset(c: &Session, receiver: i32, member: i32) -> i32 {
    if ft.is_c_record(&c.types, receiver) { return i32(c.types.field_values[member]) }
    (member - ft.type_start(&c.types, receiver)) * 8
}
fn field_place(c: &mut Session, parent: i32, receiver: i32, member: i32, token: i32) -> i32 {
    ty := c.types.field_types[member]; packed := ft.is_c_record(&c.types, receiver)
    layout := places.layout(.Field, field_offset(&c, receiver, member), read_shape(&c, ty, packed))
    return borrows.project(&mut c.body.places, parent, receiver, member - ft.type_start(&c.types, receiver), ty, layout, token, c.world.tokens.starts[token])
}
fn index_place(c: &mut Session, parent: i32, receiver: i32, packed: bool, index: i32, token: i32) -> i32 {
    var ty := 1; var kind := places.Projection.TextIndex; var parameter := 0; var shape := 0
    if receiver != 4 {
        if ft.type_kind(&c.types, receiver) != 21 && (!collection(&c, receiver) || ft.type_kind(&c.types, receiver) == 10) { return 0 }
        ty = ft.type_base(&c.types, receiver)
        if ty < 0 { return 0 }
        if ft.type_kind(&c.types, receiver) == 21 {
            kind = .RegionIndex; parameter = scratch_width(&c, ty); shape = read_shape(&c, ty, true)
        } else {
            kind = .ArrayIndex; parameter = unsigned.shift(storage_type(&c, ty)); shape = read_shape(&c, ty, packed)
            if packed && ft.is_c_record(&c.types, ty) {
                parameter = 0; while i32(1).shl(parameter) < ft.c_size(&c.types, ty) { parameter = parameter + 1 }
            }
        }
    }
    return borrows.project(&mut c.body.places, parent, receiver, index+1, ty, places.layout(kind, parameter, shape), token, c.world.tokens.starts[token])
}
fn load_field(c: &mut Session, receiver: i32, member: i32, access: borrows.Access, token: i32, id: i32) -> i32 {
    if c.body.scratch_place != 0 { c.body.scratch_place = 2 }
    ty := c.types.field_types[member]; packed := ft.is_c_record(&c.types, receiver)
    bound_place(&mut c, .Field, id, i32(access), token)
    if access != .Value { save_address(&mut c, id, token) } else { c.body.address = -1; c.body.direct_place = false }
    c.body.inline_place = packed
    if access != .Address {
        if packed && (ft.is_c_record(&c.types, ty) || ft.type_kind(&c.types, ty) == 6) { inline_value(&mut c, ty, access, token) }
        else { bound_place(&mut c, .Read, id, i32(access), token) }
    }
    ty
}
fn load_index(c: &mut Session, receiver: i32, packed: bool, writable: bool, access: borrows.Access, source_at: i32, id: i32) -> i32 {
    ty := places.place_type(&c.body.places.arena, 0, 0, id)
    bound_place(&mut c, .CheckIndex, id, i32(access), source_at)
    trap_edge(&mut c, c.bounds, .Bounds, source_at)
    bound_place(&mut c, .Element, id, i32(access), source_at)
    if receiver == 4 {
        bound_place(&mut c, .Read, id, i32(access), source_at)
        c.body.address = -1; c.body.writable = false; return ty
    }
    if access != .Value { save_address(&mut c, id, source_at) } else { c.body.address = -1; c.body.direct_place = false }
    region := ft.type_kind(&c.types, receiver) == 21
    c.body.scratch_place = 0; c.body.inline_place = packed; c.body.writable = writable
    if region { c.body.scratch_place = 1; c.body.inline_place = ft.is_c_record(&c.types, ty) }
    if access != .Address && !(region && ft.type_kind(&c.types, ty) == 2) {
        bound_place(&mut c, .Read, id, i32(access), source_at)
    }
    ty
}
fn borrow_address(c: &mut Session, ty: i32, mutable: bool, token: i32, place: i32) {
    var intent := 3; if mutable { intent = 4 }
    if c.body.scratch_place == 1 && ft.type_kind(&c.types, ty) == 2 && !ft.is_c_record(&c.types, ty) {
        // Ordinary record parameters borrow a slot containing the payload pointer.
        bound_place(&mut c, .BorrowHome, place, intent, token)
    } else if ft.is_c_record(&c.types, ty) {
        place_step(&mut c, .BorrowPayload, ty, intent, 0, 0, token)
    } else if fixed_pod(&c, ty) {
        place_step(&mut c, .Read, ty, intent, 3, 0, token)
    } else if c.body.inline_place && ft.type_kind(&c.types, ty) == 6 {
        backing := slot(&mut c); arm.store(&mut c.code,backing,0); place_step(&mut c, .BorrowHome, ty, intent, 0, backing, token)
    } else if c.body.direct_place && place < 0 { bound_place(&mut c, .BorrowHome, place, intent, token) }
    else { bound_place(&mut c, .BorrowSaved, place, intent, token) }
}
// The part of a typed path after 'base' is lowered on demand. With a
// materialized base its value is already in x0 (e.g. a checked index).
// Each intermediate projection needs just its value. Only a destination
// needs stable address storage; a plain assignment need not read the leaf.
fn lower_place(c: &mut Session, place: i32, base: i32, access: borrows.Access, root_at: i32) {
    if place < 0 { load_binding(&mut c, borrows.root(&c.body.places, place), access, root_at); return }
    var p := place
    c.body.places.path.clear()
    while p > 0 && p != base { c.body.places.path.push(p - 1); p = places.parent(c.body.places.arena.nodes[3 * (p - 1)]) }
    if base == 0 {
        if p >= 0 { fail(&mut c, "internal missing place root"); return }
        load_binding(&mut c, borrows.root(&c.body.places, p), .Value, root_at)
    } else if p != base { fail(&mut c, "internal inconsistent place path"); return }
    while c.body.places.path.len > 0 {
        node := c.body.places.path.pop()
        receiver := places.receiver(c.body.places.arena.nodes[3*node+1]); selector := places.selector(c.body.places.arena.nodes[3*node])
        var need := borrows.Access.Value
        if c.body.places.path.len == 0 { need = access }
        if places.kind(places.storage(c.body.places.arena.nodes[3*node+2])) == i32(places.Projection.Field) {
            field_type := load_field(&mut c, receiver, ft.type_start(&c.types, receiver) + selector, need, c.body.places.tokens[node], node + 1)
        }
        else {
            if selector == 0 { fail(&mut c, "internal missing evaluated index"); return }
            writable := c.body.writable; packed := c.body.inline_place && ft.type_kind(&c.types, receiver) == 6
            arm.mov(&mut c.code, 1, 0); bound_place(&mut c, .Temporary, node + 1, i32(place_op.Temporary.LoadIndex), c.body.places.tokens[node])
            element := load_index(&mut c, receiver, packed, writable, need, c.body.places.tokens[node], node + 1)
        }
    }
}
fn method(c: &mut Session, ty: i32, name: string, place: i32, receiver_at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    var covered := false
    result := method_dispatch(&mut c, ty, name, place, receiver_at, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
fn integer_method(c: &mut Session, ty: i32, name: string, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    op := integers.method(name)
    covered = op != .Unknown
    if op == .Not {
        expect(&mut c, ")"); integers.complement(&mut c.code, ty); return ty
    }
    var want := ty; if integers.is_shift(op) { want = 1 }
    // Commit only to a complete literal argument. Any nested expression uses
    // normal evaluation order, diagnostics and the expression depth limit.
    if covered && c.body.depth < 128 && c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.kinds[c.body.cursor] == .Integer &&
        c.world.tokens.kinds[c.body.cursor + 1] == .Symbol && c.world.tokens.texts[c.body.cursor + 1] == ")" {
        spelling := advance(&mut c)
        value := integer_literal(&mut c, spelling, want)
        expect(&mut c, ")"); integers.immediate(&mut c.code, op, ty, value, c.bounds); return ty
    }
    arm.push_temp(&mut c.code, 0)
    right := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, right)
    expect(&mut c, ")"); arm.pop_temp(&mut c.code, 1)
    if !covered { fail(&mut c, "unknown integer method '" + name + "'"); return ty }
    integers.dynamic(&mut c.code, op, ty, c.bounds); ty
}
fn method_dispatch(c: &mut Session, ty: i32, name: string, place: i32, receiver_at: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    var effects := c.body.mutations.len
    source := c.world.tokens.starts[c.body.cursor - 1]
    writable := c.body.writable; expect(&mut c, "(")
    if floats.has(ty) {
        expect(&mut c, ")")
        if name == "str" { covered = true; format_float(&mut c, ty, source); return 4 }
        if name == "negate" { fail(&mut c, "unknown float method"); return ty }
        if name == "to_bits" || name == "is_sign_negative" || name == "abs" || name == "sqrt" || name == "floor" || name == "ceil" || name == "round" || name == "round_ties_even" || name == "trunc" || name == "is_nan" || name == "is_finite" || name == "is_infinite" { covered = true }
        actual := floats.method(&mut c.code, ty, name, c.world.tokens.starts[c.body.cursor - 3])
        if actual < 0 { fail(&mut c, "unknown float method"); return ty }
        return actual
    }
    if name == "len" { covered = true; expect(&mut c, ")"); return length_value(&mut c, ty, c.body.cursor - 3) }
    if name == "cap" && ft.type_kind(&c.types, ty) == 1 { covered = true; expect(&mut c, ")"); place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Capacity), 2, c.body.cursor - 3); return 1 }
    // Fuse only a typed string conversion at the outer for-source boundary.
    // Nested arguments, stored conversions and further postfixes retain their
    // ordinary array value semantics. Keep one immutable source snapshot.
    if ty == 4 && c.body.depth == c.body.stream_depth && (name == "bytes" || name == "runes") && is(&c, ")") && c.body.cursor + 1 < c.world.tokens.kinds.len && c.world.tokens.kinds[c.body.cursor + 1] == .Symbol && c.world.tokens.texts[c.body.cursor + 1] == "{" {
        covered = true
        expect(&mut c, ")"); copy_value(&mut c, 4)
        c.body.stream_kind = 1; if name == "runes" { covered = true; c.body.stream_kind = 5 }
        return 4
    }
    if name != "str" && (ty == 1 || ty == 2 || unsigned.has(ty)) { return integer_method(&mut c, ty, name, &catalog, &mut inline_work, &mut model, &mut covered) }
    if ty == 4 { copy_value(&mut c, ty); saved_text := temporary(&mut c, ty) }
    arm.push_temp(&mut c.code, 0)
    var target := -1; var ret := ty; var count := 0; var operation: ri.Operation = .Format
    if name == "iter" && (ft.type_kind(&c.types, ty) == 6 || ft.type_kind(&c.types, ty) == 10) { covered = true;
        expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0); copy_value(&mut c, ty)
        return compound(&mut c, 10, ft.type_base(&c.types, ty))
    }
    if ft.type_kind(&c.types, ty) == 1 {
        may_invalidate_operand(&mut c) // Includes inline clear(), not just runtime calls.
        receiver := borrows.root(&c.body.places, place)
        if receiver < 0 { fail(&mut c, "array mutation requires a stored place"); return 0 }
        if is_for_locked(&c, receiver) { fail(&mut c, "cannot mutate a collection while iterating over it"); return 0 }
        c.body.mutations.push(receiver); effects = c.body.mutations.len
        if !writable { fail(&mut c, "array mutation requires var or &mut") }
        if name == "push" { covered = true;
            if !writable { fail(&mut c, "push requires mutable array") }
            base := ft.type_base(&c.types, ty)
            value := expression(&mut c, 0, base, &catalog, &mut inline_work, &mut model); same(&mut c, base, value); take_value(&mut c, value)
            operation = .ArrayPush; target = c.runtime.typed_push[unsigned.shift(storage_type(&c, base))]; count = 1; ret = 0
        } else if name == "reserve" { covered = true; value := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, value); count = 1; operation = .ArrayReserve; target = c.runtime.array_reserve; ret = 0 }
        else if name == "pop" { covered = true; operation = .ArrayPop; target = c.runtime.array_pop; ret = ft.type_base(&c.types, ty) }
        else if name == "clear" { covered = true; expect(&mut c, ")"); arm.pop_temp(&mut c.code, 0); if ft.type_base(&c.types, ty) == 4 { arm.intrinsic_call(&mut c.code, c.runtime.release_elements, .ReleaseElements, ty, 0, source) }; arm.imm(&mut c.code, 1, 0); place_step(&mut c, .Member, ty, 4, i32(place_op.Member.ClearLength), 1, c.body.cursor - 3); return 0 }
    } else if name == "str" { covered = true;
        if ty != 1 && ty != 2 && ty != 3 && ty != 5 && !unsigned.has(ty) { fail(&mut c, "str requires an integer, bool or rune") }
        ret = 4; target = c.runtime.string_integer
        if ty == 3 { target = c.runtime.string_bool }; if ty == 5 { target = c.runtime.string_rune }
    } else if ty == 4 {
        if name == "bytes" { covered = true; operation = .Bytes; target = c.runtime.string_bytes; ret = compound(&mut c, 1, 1) }
        else if name == "runes" { covered = true; operation = .Runes; target = c.runtime.string_runes; ret = compound(&mut c, 1, 5) }
        else if name == "slice" { covered = true;
            first := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, first); arm.push_temp(&mut c.code, 0); expect(&mut c, ",")
            last := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, last); arm.mov(&mut c.code, 2, 0); arm.pop_temp(&mut c.code, 1); arm.pop_temp(&mut c.code, 0)
            expect(&mut c, ")"); arm.intrinsic_call(&mut c.code, c.runtime.string_slice, .Slice, ty, 4, source); return 4
        }
    }
    if target < 0 { fail(&mut c, "unknown method '" + name + "'"); return 0 }
    expect(&mut c, ")")
    if count == 1 { arm.mov(&mut c.code, 1, 0) }; arm.pop_temp(&mut c.code, 0)
    if count == 1 && ri.mutates_receiver(operation) {
        root := borrows.root(&c.body.places, place)
        if borrows.changed(&c.body.mutations, effects, c.body.mutations.len, root) {
            arm.push_temp(&mut c.code, 1); lower_place(&mut c, place, 0, .Value, receiver_at); arm.pop_temp(&mut c.code, 1)
        }
    }
    arm.intrinsic_call(&mut c.code, target, operation, ty, ret, source); if operation == .ArrayPop && storage_type(&c, ret) == 1 { arm.sign_extend_i32(&mut c.code, 0, 0) }; ret
}
fn comparison_value(c: &mut Session, operator: string) {
    condition := integers.relation(rules.opcode(operator))
    arm.set_condition(&mut c.code, 0, condition)
}
fn binary(c: &mut Session, operator: string, ty: i32, token: i32) -> i32 {
    if ty == 13 && (operator == "==" || operator == "!=") { return unsigned.binary(&mut c.code, operator, 12, c.overflow, c.zero) }
    if floats.has(ty) {
        if operator == "%" { fail(&mut c, "remainder requires integers"); return ty }
        return floats.binary(&mut c.code, operator, ty, c.world.tokens.starts[token])
    }
    if unsigned.has(ty) { return unsigned.binary(&mut c.code, operator, ty, c.overflow, c.zero) }
    if ty == 4 {
        arm.mov(&mut c.code, 2, 0); arm.mov(&mut c.code, 0, 1); arm.mov(&mut c.code, 1, 2)
        if operator == "+" { arm.intrinsic_call(&mut c.code, c.runtime.string_concat, .Concat, 4, 4, c.world.tokens.starts[token]); return 4 }
        arm.intrinsic_call(&mut c.code, c.runtime.string_compare, .Compare, 4, 1, c.world.tokens.starts[token]); arm.mov(&mut c.code, 1, 0); arm.imm(&mut c.code, 0, 0)
    }
    opcode := rules.opcode(operator); numeric := ty == 1 || ty == 2 || ty == 5
    if opcode <= 5 {
        if !numeric { fail(&mut c, "arithmetic requires matching integer types"); return ty }
    } else if !numeric && !((ty == 3 || ft.type_kind(&c.types, ty) == 3) && (opcode == 6 || opcode == 7)) && ty != 4 {
        fail(&mut c, "comparison requires integers or bool equality")
    }
    if c.code.prefixing { arm.pending_operator(&mut c.code, opcode, ty, token) }
    else if !c.code.checking { lower_operator(&mut c, opcode, ty) }
    if opcode <= 5 { ty } else { 3 }
}
fn lower_operator(c: &mut Session, opcode: i32, ty: i32) {
    if opcode >= 6 {
        arm.compare_register(&mut c.code, 1, 0); cc := integers.relation(opcode)
        arm.set_condition(&mut c.code, 0, cc); return
    }
    if opcode == 1 || opcode == 2 {
        integers.signed_add_sub(&mut c.code, ty, opcode == 2, true, c.overflow, 0, 1, 0, -1)
        return
    } else if opcode == 3 {
        arm.integer_binary(&mut c.code, 4, true, false, 2, 1, 0, -1); arm.integer_binary(&mut c.code, 3, true, false, 0, 1, 0, -1)
        arm.bitfield(&mut c.code, true, true, 3, 0, 63, 63); arm.compare_register(&mut c.code, 2, 3); arm.branch(&mut c.code, c.overflow, 3)
    } else {
        arm.branch(&mut c.code, c.zero, 18)
        var minimum: i64 = -2147483648
        if ty == 2 { minimum = -9223372036854775808 }
        safe := arm.label(&mut c.code)
        arm.imm(&mut c.code, 2, minimum); arm.compare_register(&mut c.code, 1, 2); arm.branch(&mut c.code, safe, 3)
        arm.imm(&mut c.code, 2, -1); arm.compare_register(&mut c.code, 0, 2); arm.branch(&mut c.code, c.overflow, 2)
        arm.mark(&mut c.code, safe); arm.integer_binary(&mut c.code, 6, true, false, 2, 1, 0, -1)
        if opcode == 4 { arm.mov(&mut c.code, 0, 2) } else { arm.multiply_subtract(&mut c.code, 0, 2, 0, 1) }
    }
    if ty == 1 { narrow(&mut c) }
}
// Choose the precision of literal-led arithmetic before emitting its first
// operand. Names with known types take precedence over a default decimal.
fn float_context(c: &Session, expected: i32) -> i32 {
    if !c.float_source || expected == 1 || expected == 2 || unsigned.has(expected) || floats.has(expected) { return expected }
    first := c.world.tokens.kinds[c.body.cursor]
    if first != .Integer && first != .Float && !is(&c, "(") && !is(&c, "-") { return expected }
    var pos := c.body.cursor
    var depth := 0
    var decimal_seen := false
    while pos < c.world.tokens.kinds.len {
        kind := c.world.tokens.kinds[pos]; word := c.world.tokens.texts[pos]
        if kind == .Float { decimal_seen = true }
        else if kind == .Name {
            index := local(&c.body, word)
            if index >= 0 {
                ty := c.body.locals.types[index]
                if floats.has(ty) { return ty }
                break
            }
            if word == "f32" { return 6 }
            if word == "f64" { return 7 }
            found := map.get_or(&c.world.functions, word, -1)
            if found >= 0 && floats.has(c.world.returns[i32(found)]) { return c.world.returns[i32(found)] }
            break
        } else if word == "(" { depth = depth + 1 }
        else if word == ")" {
            if depth == 0 { break }; depth = depth - 1
        } else if word == "." {
            if pos + 3 >= c.world.tokens.kinds.len || c.world.tokens.texts[pos + 2] != "(" || c.world.tokens.texts[pos + 3] != ")" { break }
            name := c.world.tokens.texts[pos + 1]
            if name == "str" || name == "to_bits" || name == "is_nan" || name == "is_finite" || name == "is_infinite" || name == "is_sign_negative" { break }
            pos = pos + 3
        } else if kind != .Integer && word != "+" && word != "-" && word != "*" && word != "/" { break }
        pos = pos + 1
    }
    if decimal_seen { return 7 }
    expected
}
// A single scalar operand emits no calls and cannot overwrite x1. Keep the
// left value there instead of spilling it across the right-hand evaluation.
// Postfixes and tighter operators take the general path, preserving order.
fn register_rhs(c: &Session, priority: i32) -> bool {
    var last := c.body.cursor
    kind := c.world.tokens.kinds[last]
    if kind == .Name {
        found := local(&c.body, c.world.tokens.texts[last])
        if found < 0 { return false }
        ty := c.body.locals.types[found]
        if !scalar_element(&c, ty) || ty == 4 { return false }
    } else if kind != .Integer && kind != .Float && kind != .Rune && kind != .Byte {
        if !is(&c, "true") && !is(&c, "false") { return false }
    }
    rhs_ends_at(&c, last + 1, priority)
}
fn rhs_ends_at(c: &Session, next_at: i32, priority: i32) -> bool {
    if next_at >= c.world.tokens.kinds.len { return false }
    next := c.world.tokens.texts[next_at]
    if next == "." || next == "[" || next == "(" { return false }
    rules.precedence(next) <= priority
}
// X0 holds the evaluated left operand. A complete literal atom can be encoded
// directly in the arithmetic instruction, including comparisons against -K
// via CMN. Tighter operators and postfixes must still evaluate their full RHS.
fn signed_immediate_rhs(c: &mut Session, ty: i32, priority: i32, operator: string) -> bool {
    if (ty != 1 && ty != 2 && ty != 5) || priority < 3 || priority > 5 || c.body.depth > 126 { return false }
    var at := c.body.cursor
    var negative := false
    if ty == 5 {
        if c.world.tokens.kinds[at] != .Rune { return false }
    } else if c.world.tokens.kinds[at] != .Integer {
        if !is(&c, "-") { return false }
        negative = true; at = at + 1
        if at >= c.world.tokens.kinds.len || c.world.tokens.kinds[at] != .Integer { return false }
    }
    if !rhs_ends_at(&c, at + 1, priority) { return false }
    var magnitude: i64 = 0
    if ty == 5 { magnitude = i64(i32(c.world.tokens.texts[at].runes()[0])) }
    else {
        n := rules.literal_integer(c.world.tokens.texts[at])
        if !n.ok || n.value < 0 { return false }
        magnitude = n.value
    }
    field := arm.add_sub_field(magnitude)
    if field < 0 { return false }
    c.body.cursor = at + 1
    if priority == 5 {
        if field != 0 {
            integers.signed_add_sub(&mut c.code, ty, (operator == "-") != negative, true, c.overflow, 0, 0, -1, magnitude)
        }
    } else {
        arm.compare_immediate(&mut c.code, 0, magnitude, negative && magnitude != 0)
        comparison_value(&mut c, operator)
    }
    c.body.address = -1; c.body.writable = false; c.body.scratch_place = 0
    c.body.expr_owner = -1; c.body.expr_type = -1
    true
}
fn expression(c: &mut Session, minimum: i32, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "expression nesting exceeds 128"); c.body.depth = c.body.depth - 1; return 0 }
    context := float_context(&c, expected)
    var ty := primary(&mut c, context, &catalog, &mut inline_work, &mut model)
    var place := c.body.places.current; at := c.body.places.source
    while c.ok && c.world.tokens.kinds[c.body.cursor] == .Symbol {
        op_at := c.body.cursor; opcode := rules.opcode(c.world.tokens.texts[op_at])
        priority := rules.priority(opcode)
        if priority == 0 || priority < minimum { break }
        operator := c.world.tokens.texts[op_at]; left_node := model.value
        place = 0; skip_token(&mut c); newlines(&mut c)
        if !model.recording && signed_immediate_rhs(&mut c, ty, priority, operator) {
            if priority != 5 { ty = 3 }
            continue
        }
        if opcode == 12 || opcode == 13 {
            same(&mut c, 3, ty)
            done := new_block(&mut c)
            if operator == "&&" { source_edge(&mut c, done, .WhenFalse, op_at) } else { source_edge(&mut c, done, .WhenTrue, op_at) }
            right := expression(&mut c, priority + 1, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, right); bind_block(&mut c, done); ty = 3; c.body.address = -1; c.body.writable = false
        } else {
            if ty == 4 {
                borrowed := c.body.expr_owner < 0 || c.body.expr_type != ty
                observe := borrowed && c.ownership_enabled && !c.code.checking && !c.validating_dead
                rhs := c.code.words.len; first_reloc := c.code.at.len; first_label := c.code.labels.len; first_import := c.body.facts.sites.len
                var owner := -1; var index := -1
                previous := c.body.observing_lease; generation := c.body.lease_generation
                if observe {
                    // Reserve the slot in source order. Cleanup is enabled if
                    // this operand really needs a lease, after typing its RHS.
                    index = slot(&mut c); owner = c.body.owned_slots.len
                    remember_owner(&mut c, index, 4, true)
                    c.body.observing_lease = true
                } else if borrowed {
                    copy_value(&mut c, ty); saved_left := temporary(&mut c, ty)
                }
                arm.push_temp(&mut c.code, 0)
                right := expression(&mut c, priority + 1, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, right)
                if observe {
                    c.body.observing_lease = previous
                    if c.body.lease_generation == generation {
                        if owner == c.body.owned_slots.len - 1 {
                            unused_slot := c.body.owned_slots.pop(); unused_ty := c.body.owned_types.pop(); unused_temp := c.body.owner_temps.pop()
                        } else { c.body.owned_slots[owner] = -1 }
                    }
                    else if c.ok {
                        setup := c.code.words.len; reloc := c.code.at.len
                        source := c.world.tokens.starts[op_at]
                        arm.ownership_call(&mut c.code, c.runtime.retain, .Copy, ty, source)
                        install_owner(&mut c, index, ty, source)
                        width := lease.insert(&mut c.code, rhs, setup, first_label, first_reloc, reloc)
                        for i in first_import..c.body.facts.sites.len { c.body.facts.sites[i] = c.body.facts.sites[i] + width * 4 }
                    }
                }
                arm.pop_temp(&mut c.code, 1)
            } else {
                var spilled := false; var pending_save := -1
                if c.code.prefixing {
                    pending_save = c.code.prefix.len; spilled = true
                    arm.push_temp(&mut c.code, 0)
                } else if !c.code.checking {
                    spilled = !register_rhs(&c, priority)
                    if spilled { arm.push_temp(&mut c.code, 0) } else { arm.mov(&mut c.code, 1, 0) }
                }
                right := expression(&mut c, priority + 1, ty, &catalog, &mut inline_work, &mut model); same(&mut c, ty, right)
                if pending_save >= 0 && c.code.prefixing && model.recording && model.value >= 0 {
                    kind := model.nodes.kinds[model.value]
                    if kind == 1 || kind == 2 {
                        c.code.prefix[pending_save] = row.copy(1, 0); spilled = false
                    }
                }
                if spilled { arm.pop_temp(&mut c.code, 1) }
            }
            result := binary(&mut c, operator, ty, op_at); ty = temporary(&mut c, result); c.body.address = -1; c.body.writable = false
        }
        if model.recording {
            if left_node < 0 || model.value < 0 { model.recording = false }
            else { _ := typed.node(&mut model, 3, ty, left_node, model.value, -1, i64(opcode), -1, op_at) }
        }
    }
    if minimum == 0 && c.world.tokens.kinds[c.body.cursor] == .Symbol && eat(&mut c, "..") {
        range_source := c.world.tokens.starts[c.body.cursor - 1]; model.recording = false
        place = 0; same(&mut c, 1, ty); arm.push_temp(&mut c.code, 0)
        high := expression(&mut c, 1, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, high); arm.pop_temp(&mut c.code, 1)
        iteration.emit(&mut c.code, .PackRange, .Range, 1, range_source)
