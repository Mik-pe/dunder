}
fn length_value(c: &mut Compiler, ty: i32) -> i32 {
    if collection(&c, ty) || c.type_kinds[ty]==21 { load_mem(&mut c, 0, 0, 8) }
    else if ty == 4 { load_mem(&mut c, 0, 0, 0) }
    else { fail(&mut c, "len expects an array or string") }
