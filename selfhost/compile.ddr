// Native Dunder compiler. Values use eight-byte cells; aggregates have value semantics.
// Primitive IDs: ()=0, i32=1, i64=2, bool=3, string=4, rune=5.
pub struct Imports { globals: i32, libraries: []string, symbols: []string, sites: []i32, slots: []i32 }
fn imports() -> Imports { Imports { globals: 0, libraries: [], symbols: [], sites: [], slots: [] } }
pub struct Bindings {
    reused: i32, emitted: i32, offsets: []i32, names: []string, types: []string,
    worker_scalar: i32, worker_general: i32, frontend_workers: i32, source_windows: i32, peak_jobs: i32,
    scalar_model_hits: i32, modeled: i32, optimized: i32, rewrites: i32, proven_bounds: i32, fallbacks: i32,
    inline_entries: i32, inline_nodes: i32, inline_tokens: i32, inline_units: i32,
    inlined_calls: i32, inlined_words: i32, inline_estimated_words: i32,
    mir_functions: i32, mir_operations: i32, mir_opaque: i32,
    mir_optimization_enabled: bool, mir_source_objects_enabled: bool, mir_private_memory_ops: i32, mir_optimized: i32, mir_promoted: i32,
    mir_removed_loads: i32, mir_removed_stores: i32, mir_analysis_units: i64, mir_budget_refusals: i32,
    mir_ssa_enabled: bool, mir_ssa_optimized: i32, mir_ssa_cells: i32, mir_ssa_values: i32, mir_ssa_parameters: i32, mir_ssa_registers: i32, mir_ssa_captures: i32, mir_ssa_stack_groups: i32, mir_ssa_removed_loads: i32, mir_ssa_removed_stores: i32, mir_ssa_removed_pushes: i32, mir_ssa_removed_pops: i32, mir_ssa_copies: i32, mir_ssa_analysis_units: i64, mir_ssa_budget_refusals: i32,
    mir_values_enabled: bool, mir_values_optimized: i32, mir_value_rewrites: i32, mir_value_deleted: i32, mir_value_immediates: i32, mir_value_analysis_units: i64, mir_value_budget_refusals: i32,
    profile: profile.Profile,
}
pub fn bindings() -> Bindings {
    Bindings { reused: 0, emitted: 0, offsets: [], names: [], types: [],
        worker_scalar: 0, worker_general: 0, frontend_workers: 0, source_windows: 0, peak_jobs: 0,
        scalar_model_hits: 0, modeled: 0, optimized: 0, rewrites: 0, proven_bounds: 0, fallbacks: 0,
        inline_entries: 0, inline_nodes: 0, inline_tokens: 0, inline_units: 0,
        inlined_calls: 0, inlined_words: 0, inline_estimated_words: 0,
        mir_functions: 0, mir_operations: 0, mir_opaque: 0,
        mir_optimization_enabled: false, mir_source_objects_enabled: false, mir_private_memory_ops: 0, mir_optimized: 0, mir_promoted: 0,
        mir_removed_loads: 0, mir_removed_stores: 0, mir_analysis_units: 0, mir_budget_refusals: 0,
        mir_ssa_enabled: false, mir_ssa_optimized: 0, mir_ssa_cells: 0, mir_ssa_values: 0, mir_ssa_parameters: 0, mir_ssa_registers: 0, mir_ssa_captures: 0, mir_ssa_stack_groups: 0, mir_ssa_removed_loads: 0, mir_ssa_removed_stores: 0, mir_ssa_removed_pushes: 0, mir_ssa_removed_pops: 0, mir_ssa_copies: 0, mir_ssa_analysis_units: 0, mir_ssa_budget_refusals: 0,
        mir_values_enabled: false, mir_values_optimized: 0, mir_value_rewrites: 0, mir_value_deleted: 0, mir_value_immediates: 0, mir_value_analysis_units: 0, mir_value_budget_refusals: 0,
        profile: profile.new(-1) }
}
pub struct Result { ok: bool, error: string, offset: i32, text: []u8, imports: Imports }
pub struct Configuration { workers: i32, scalar_enabled: bool, ownership_enabled: bool, const_div_enabled: bool, frame_free_enabled: bool, range_enabled: bool, inline_enabled: bool, mir_opt_enabled: bool, mir_memory_enabled: bool, mir_ssa_enabled: bool, mir_values_enabled: bool, profile_host: i32, instrument_runtime: bool }
pub fn configuration() -> Configuration { Configuration { workers: 1, scalar_enabled: true, ownership_enabled: true, const_div_enabled: true, frame_free_enabled: true, range_enabled: true, inline_enabled: true, mir_opt_enabled: true, mir_memory_enabled: true, mir_ssa_enabled: false, mir_values_enabled: true, profile_host: -1, instrument_runtime: false } }
// Source and resolved signatures are written only while collecting headers.
// Body typing and linking read the same declaration IDs and token positions.
struct DeclarationWorld {
    tokens: lexer.Tokens, closes: []i32, test_functions: []bool, unsafe_capable: bool,
    source_end: i32, param_tokens: []i32, functions: map.Map, names: []string, starts: []i32,
    ends: []i32, returns: []i32, param_starts: []i32, param_counts: []i32,
    param_names: []string, param_types: []i32, libraries: []string, symbols: []string,
    unsafe_functions: []bool, function_owners: []i32, ffi_types: []i32,
}
fn new_world() -> DeclarationWorld {
    DeclarationWorld {
        tokens: lexer.empty(false), closes: [], test_functions: [], unsafe_capable: false,
        source_end: 0, param_tokens: [], functions: map.new(), names: [], starts: [], ends: [],
        returns: [], param_starts: [], param_counts: [], param_names: [], param_types: [],
        libraries: [], symbols: [], unsafe_functions: [], function_owners: [], ffi_types: [],
    }
}

struct FunctionContext {
    facts: facts.Facts,
    block_base: i32, task_handles: []i32, loop_task_locals: []i32, first_parameter: i32, scratch_returns: []i32,
    block_end: i32, tail: bool, block_depth: i32, cursor: i32, testing: bool, mutations: []i32,
    places: borrows.Places, for_locks: []i32, taking_address: bool, stream_depth: i32,
    stream_kind: i32, current_owner: i32, unsafe_scope: bool, inline_place: bool,
    direct_place: bool, address: i32, writable: bool, scratch_place: i32, locals: locals.Table,
    cleanup: i32, owned_slots: []i32, owned_types: []i32, owner_temps: []bool,
    loop_owners: []i32, defers: deferred.Blocks, loop_defers: []i32,
    in_defer: bool, defer_loop_floor: i32, reenter_owners: bool, expr_owner: i32, expr_type: i32, scope: i32,
    slots: i32, ret_type: i32, depth: i32, loop_heads: []i32, loop_ends: []i32,
    inline_deps: fragments.Dependencies, scalar_function: bool, observing_lease: bool,
    lease_generation: i64, scalar_names: []string, scalar_types: []i32, scalar_tokens: []i32,
}
fn new_body() -> FunctionContext {
    FunctionContext {
        facts: facts.new(),
        block_base: 0, task_handles: [], loop_task_locals: [], first_parameter: 0, scratch_returns: [],
        block_end: 0, tail: false, block_depth: 0, cursor: 0, testing: false, mutations: [],
        places: borrows.places(), for_locks: [], taking_address: false, stream_depth: -1,
        stream_kind: 0, current_owner: 0, unsafe_scope: false, inline_place: false,
        direct_place: false, address: -1, writable: false, scratch_place: 0, locals: locals.new(), cleanup: 0,
        owned_slots: [], owned_types: [], owner_temps: [], loop_owners: [],
        defers: deferred.new(), loop_defers: [], in_defer: false, defer_loop_floor: 0,
        reenter_owners: false, expr_owner: -1, expr_type: -1, scope: 0, slots: 0, ret_type: 0, depth: 0,
        loop_heads: [], loop_ends: [], inline_deps: fragments.new_dependencies(),
        scalar_function: false, observing_lease: false, lease_generation: 0, scalar_names: [],
        scalar_types: [], scalar_tokens: [],
    }
}

pub opaque struct Session {
    world: DeclarationWorld, body: FunctionContext,
    validation_spellings: []string, validation_tokens: []i32, worker_kinds: []i32,
    jobs: cs.JobLog,
    tasks: tc.TaskGraph,
    types: ft.TypeRegistry, helper_labels: []i32, array_helpers: i32,
    ok: bool, error: string, error_at: i32,
    validating_dead: bool, validated_through: i32, report: bool, bindings: Bindings,
    wasm_abi: wa.Abi, code: arm.Code, fn_labels: []i32, needed: []bool, runtime: runtime.Runtime,
    imports: Imports,
    callback_labels: []i32, has_callbacks: bool,
    loans: scratch.Loans,
    array_take: i32, record_take_labels: []i32,
    mir_opt_enabled: bool, mir_memory_enabled: bool, mir_ssa_enabled: bool, mir_values_enabled: bool, scalar_enabled: bool, ownership_enabled: bool, range_enabled: bool, inline_enabled: bool,
    scalar_templates: opt_templates.Cache,
    strings: []string, string_labels: []i32,
    print_int: i32, print_bool: i32, print_text: i32, write: i32,
    float_source: bool, float_trap: i32, overflow: i32, zero: i32, assertion: i32, io: i32, bounds: i32,
}
// These observations belong to typed operations in the authoritative body walk.
// Source spellings never grant worker eligibility; the closed graph does.
fn task_effect(c: &mut Session, bits: i64) {
    if c.tasks.program { c.body.facts.effects = c.body.facts.effects.bit_or(bits) }
}
fn task_edge(c: &mut Session, callee: i32) {
    if c.tasks.program { c.body.facts.calls.push(callee) }
}
fn task_use(c: &mut Session, at: i32) {
    task_effect(&mut c, 1024)
    if c.body.facts.first_task < 0 { c.body.facts.first_task = at }
}
fn task_certify(c: &mut Session, certificate: &mut tc.TaskCertificate) -> bool {
    var at := c.body.cursor
    err := tc.certify(&c.tasks, &c.types, &c.world.tokens.starts, c.world.names.len, &c.world.param_starts,
        &c.world.param_counts, &c.world.param_types, &c.world.returns, &mut certificate, &mut at)
    if err != "" { c.body.cursor = at; fail(&mut c, err); return false }
    true
}
fn import_c(c: &mut Session, symbol: string) -> i32 {
    for i in 0..c.imports.symbols.len {
        if c.imports.libraries[i] == "c" && c.imports.symbols[i] == symbol { return i }
    }
    index := c.imports.symbols.len; c.imports.libraries.push("c"); c.imports.symbols.push(symbol); index
}
fn bind_task_runtime(c: &mut Session, rt: &runtime.Runtime, certificate: &tc.TaskCertificate) {
    plan := tc.build_prefix_plan(&certificate, &c.types, &c.helper_labels, &c.world.param_starts, &c.world.param_types, &c.world.returns, &c.fn_labels)
    queue := import_c(&mut c, "dispatch_get_global_queue")
    create := import_c(&mut c, "dispatch_group_create")
    submit := import_c(&mut c, "dispatch_group_async_f")
    wait := import_c(&mut c, "dispatch_group_wait")
    release := import_c(&mut c, "dispatch_release")
    unmap := import_c(&mut c, "munmap")
    symbols := task_native.Symbols { symbol_count: c.imports.symbols.len, global_queue: queue,
        create_group: create, submit: submit, wait: wait, release_group: release, munmap: unmap }
    out := tc.emit_prefix(&mut c.code, &rt, &plan, &symbols, c.imports.globals)
    if !out.ok { fail(&mut c, out.error); return }
    c.code.labels[c.tasks.open] = c.code.labels[out.open]
    c.code.labels[c.tasks.await_result] = c.code.labels[out.await_result]
    c.code.labels[c.tasks.close] = c.code.labels[out.close]
    c.imports.globals = out.import_globals
    for w in 0..plan.worker_ids.len { c.code.labels[c.tasks.spawners[plan.worker_ids[w]]] = c.code.labels[out.spawners[w]] }
    for i in 0..out.import_sites.len { c.imports.sites.push(out.import_sites[i]); c.imports.slots.push(out.import_slots[i]) }
}

fn task_close_slot(c: &mut Session, index: i32) {
    if c.code.checking { return }
    done := arm.label(&mut c.code); arm.load(&mut c.code, index); arm.branch(&mut c.code, done, 18)
    arm.task_call(&mut c.code, c.tasks.close, .ScopeClose, 0, 0, c.world.tokens.starts[c.body.cursor]); arm.store(&mut c.code, index, 31); arm.mark(&mut c.code, done)
}
fn task_close_locals(c: &mut Session, first: i32) {
    var i := c.body.locals.active.len - 1
    while i >= first {
        id := c.body.locals.active[i]
        if ft.type_kind(&c.types, c.body.locals.types[id]) == 23 { task_close_slot(&mut c, places.local_home(c.body.places.arena.locals[id])) }
        i = i - 1
    }
}
fn task_capability(c: &mut Session) -> i32 {
    at := c.body.cursor; name := advance(&mut c); binding := local(&c.body, name)
    if binding < 0 { fail(&mut c, "expected a live task scope capability"); c.error_at = c.world.tokens.starts[at]; return -1 }
    if ft.type_kind(&c.types, c.body.locals.types[binding]) != 23 { fail(&mut c, "expected a live task scope capability"); return -1 }
    binding
}
fn task_scope_statement(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "task"); expect(&mut c, "scope")
    name_at := c.body.cursor; name := advance(&mut c); expect(&mut c, "(")
    actual := expression(&mut c, 0, 1, &catalog, &mut inline_work, &mut model); same(&mut c, 1, actual)
    var factory := -1; var workspace := 0
    var shared := -1; var shared_slot := -1
    if eat(&mut c, ",") {
        var freeze := is(&c, "shared") && c.world.tokens.texts[c.body.cursor + 1] != ")" && c.world.tokens.texts[c.body.cursor + 1] != ","
        if !freeze {
            factory_at := c.body.cursor; target := advance(&mut c); factory = i32(map.get_or(&c.world.functions, target, -1))
            if factory < 0 || local(&c.body, target) >= 0 || c.world.libraries[factory] != "" || c.world.unsafe_functions[factory] || c.world.param_counts[factory] != 0 {
                fail(&mut c, "task workspace requires a named safe initializer without parameters"); return false
            }
            workspace = c.world.returns[factory]
            if ft.type_kind(&c.types, workspace) != 2 || c.types.c_record[workspace] {
                fail(&mut c, "task workspace initializer must return an owned record"); return false
            }
            c.body.facts.needed.push(factory)
            c.body.facts.factories.push(factory); c.body.facts.factory_tokens.push(factory_at)
            freeze = eat(&mut c, ",")
        }
        if freeze {
            value_at := c.body.cursor; expect(&mut c, "shared")
            // Capacity and the snapshot expression are each evaluated once, in order.
            cap_slot := slot(&mut c); arm.store(&mut c.code, cap_slot, 0)
            shared = expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model)
            if !c.ok { return false }
            if ft.type_kind(&c.types, shared) != 2 || ft.is_c_record(&c.types, shared) {
                fail(&mut c, "shared task input requires an owned record of isolated Data"); return false
            }
            c.body.facts.shared.push(tc.shared_data_type(&c.types, shared)); c.body.facts.shared_tokens.push(value_at)
            if !c.code.checking {
                take_value(&mut c, shared); shared_slot = slot(&mut c); arm.store(&mut c.code, shared_slot, 0)
            }
            arm.load(&mut c.code, cap_slot)
        }
    }
    expect(&mut c, ")")
    var cap := 0
    if shared >= 0 {
        // The capability's structural signature stores its exclusive workspace
        // in the base and its single shared input in the parameter table.
        params: []i32 = [shared]; cap = callable_type(&mut c, &params, workspace, 23)
    } else { cap = compound(&mut c, 23, workspace) }
    handle := slot(&mut c); c.body.task_handles.push(handle)
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.push_temp(&mut c.code, 0)
        if factory >= 0 { arm.branch(&mut c.code, c.fn_labels[factory], 20); arm.mov(&mut c.code, 2, 0) }
        else { arm.imm(&mut c.code, 2, 0) }
        if shared >= 0 {
            drop := type_helper(&mut c, shared, true)
            arm.branch(&mut c.code, drop, 20); arm.mov(&mut c.code, 4, 0)
            arm.load_into(&mut c.code, shared_slot, 3)
        } else { arm.imm(&mut c.code, 3, 0); arm.imm(&mut c.code, 4, 0) }
        static_address(&mut c, .TaskCoordinator, 0); arm.mov(&mut c.code, 1, 16); arm.pop_temp(&mut c.code, 0)
        arm.task_call(&mut c.code, c.tasks.open, .ScopeOpen, cap, 0, c.world.tokens.starts[at])
    }
    arm.store(&mut c.code, handle, 0)
    after := c.world.closes[c.body.cursor] + 1; allowed := c.body.tail && terminal(&c, after, true)
    enter(&mut c); bind(&mut c, &mut model, name, cap, false, handle, name_at)
    block_body(&mut c, allowed, &catalog, &mut inline_work, &mut model)
}
fn task_spawn(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "spawn"); cap := task_capability(&mut c)
    worker_at := c.body.cursor; name := advance(&mut c); worker := i32(map.get_or(&c.world.functions, name, -1))
    if cap < 0 { return 0 }
    if local(&c.body, name) >= 0 || worker < 0 { fail(&mut c, "spawn requires a named Dunder worker function"); return 0 }
    scope_type := c.body.locals.types[cap]; workspace := ft.type_base(&c.types, scope_type)
    has_shared := ft.type_count(&c.types, scope_type) == 1
    count := c.world.param_counts[worker]; first := c.world.param_starts[worker]
    if c.world.libraries[worker] != "" || c.world.unsafe_functions[worker] || (workspace == 0 && !has_shared && count != 1) {
        fail(&mut c, "spawn requires one safe by-value worker argument"); return 0
    }
    var next := 1
    if workspace != 0 {
        if next >= count || ft.type_kind(&c.types, c.world.param_types[first + next]) != 5 ||
            ft.type_base(&c.types, c.world.param_types[first + next]) != workspace {
            fail(&mut c, "task worker requires a mutable parameter for this workspace"); return 0
        }
        next = next + 1
    }
    if has_shared {
        shared := ft.parameter_type(&c.types, ft.type_start(&c.types, scope_type))
        if next >= count || ft.type_kind(&c.types, c.world.param_types[first + next]) != 4 ||
            ft.type_base(&c.types, c.world.param_types[first + next]) != shared {
            fail(&mut c, "task worker requires a read-only parameter for this shared input"); return 0
        }
        next = next + 1
    }
    if count != next { fail(&mut c, "worker parameters must match its task scope"); return 0 }
    input := c.world.param_types[c.world.param_starts[worker]]; expect(&mut c, "(")
    actual := expression(&mut c, 0, input, &catalog, &mut inline_work, &mut model); same(&mut c, input, actual); expect(&mut c, ")")
    c.body.facts.needed.push(worker)
    if c.tasks.program {
        c.body.facts.workers.push(worker); c.body.facts.worker_tokens.push(worker_at)
    }
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[cap]))
        arm.task_call(&mut c.code, c.tasks.spawners[worker], .Spawn, c.world.returns[worker], worker, c.world.tokens.starts[at])
    }
    c.body.address = -1; c.body.writable = false
    compound(&mut c, 22, c.world.returns[worker])
}
fn task_await_expression(c: &mut Session, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    at := c.body.cursor; task_use(&mut c, at); expect(&mut c, "await")
    consume := eat(&mut c, "!"); cap := task_capability(&mut c); expect(&mut c, "(")
    key := expression(&mut c, 0, 0, &catalog, &mut inline_work, &mut model); expect(&mut c, ")")
    if cap < 0 { return 0 }
    if ft.type_kind(&c.types, key) != 22 { fail(&mut c, "await requires a typed TaskID result key"); return 0 }
    result := ft.type_base(&c.types, key)
    if c.code.checking { arm.imm(&mut c.code, 0, 0) }
    else {
        arm.mov(&mut c.code, 1, 0); arm.load(&mut c.code, places.local_home(c.body.places.arena.locals[cap]))
        var action: row.Task = .Await; if consume { action = .AwaitOnce }
        arm.task_call(&mut c.code, c.tasks.await_result, action, result, 0, c.world.tokens.starts[at])
    }
    c.body.address = -1; c.body.writable = false; temporary(&mut c, result)
}

fn peek(c: &Session) -> string { c.world.tokens.texts[c.body.cursor] }
fn is(c: &Session, word: string) -> bool {
    kind := c.world.tokens.kinds[c.body.cursor]
    kind != .String && kind != .Rune && kind != .Byte && c.world.tokens.texts[c.body.cursor] == word
}
fn fail(c: &mut Session, message: string) { if c.ok { c.ok = false; c.error = message; c.error_at = c.world.tokens.starts[c.body.cursor] } }
fn skip_token(c: &mut Session) {
    if c.body.cursor + 1 < c.world.tokens.texts.len { c.body.cursor = c.body.cursor + 1 }
}
fn advance(c: &mut Session) -> string { value := peek(&c); skip_token(&mut c); value }
fn eat(c: &mut Session, word: string) -> bool { if is(&c, word) { skip_token(&mut c); return true }; false }
fn expect(c: &mut Session, word: string) { if !eat(&mut c, word) { fail(&mut c, "expected '" + word + "'") } }
fn separators(c: &mut Session) {
    while c.ok {
        kind := c.world.tokens.kinds[c.body.cursor]
        if kind != .Newline && (kind != .Symbol || c.world.tokens.texts[c.body.cursor] != ";") { break }
        skip_token(&mut c)
    }
}
fn newlines(c: &mut Session) { while c.ok && c.world.tokens.kinds[c.body.cursor] == .Newline { skip_token(&mut c) } }
fn check_type_error(c: &mut Session) {
    if c.types.error != "" { fail(&mut c, c.types.error); c.types.error = "" }
}
fn add_type(c: &mut Session, name: string, kind: i32, base: i32) -> i32 {
    ft.add_type(&mut c.types, name, kind, base)
}
fn scalar_element(c: &Session, ty: i32) -> bool { ft.scalar_element(&c.types, ty) }
fn scalar_bytes(c: &Session, ty: i32) -> i32 { ft.scalar_bytes(&c.types, ty, c.code.platform) }
fn compound(c: &mut Session, kind: i32, base: i32) -> i32 {
    found := ft.find_or_check_compound(&mut c.types, kind, base); check_type_error(&mut c)
    if found >= 0 { return found }
    if found == -2 { return 0 }
    ft.insert_compound(&mut c.types, kind, base)
}
fn collection(c: &Session, ty: i32) -> bool { ft.collection(&c.types, ty) }
fn length_literal(c: &mut Session) -> i32 {
    if c.world.tokens.kinds[c.body.cursor] != .Integer { fail(&mut c, "expected nonnegative array length"); return 0 }
    length := rules.literal_integer(advance(&mut c))
    if !length.ok || length.value < 0 || length.value > 1048576 { fail(&mut c, "array length out of range"); return 0 }
    i32(length.value)
}
fn fixed(c: &mut Session, base: i32, length: i32) -> i32 {
    found := ft.find_or_check_fixed(&mut c.types, c.code.platform, base, length); check_type_error(&mut c)
    if found >= 0 { return found }
    if found == -2 { return 0 }
    ft.insert_fixed(&mut c.types, base, length)
}
fn type_id(c: &Session, name: string) -> i32 { ft.type_id(&c.types, name) }
// Function pointers are structural: declarations and annotations share IDs.
fn foreign_type(c: &mut Session, args: &[]i32, result: i32) -> i32 { callable_type(&mut c, &args, result, 8) }
fn callable_type(c: &mut Session, args: &[]i32, result: i32, kind: i32) -> i32 {
    found := ft.find_or_check_callable(&mut c.types, &args, result, kind); check_type_error(&mut c)
    if found >= 0 { return found }
    if found == -2 { return 0 }
    ft.insert_callable(&mut c.types, &args, result, kind)
}
fn type_name(c: &mut Session) -> i32 {
    if eat(&mut c, "TaskID") {
        expect(&mut c, "<"); result := type_name(&mut c); expect(&mut c, ">")
        return compound(&mut c, 22, result)
    }
    if is(&c, "fn") || is(&c, "extern") {
        var kind := 9; if eat(&mut c, "extern") { kind = 8 }; expect(&mut c, "fn"); expect(&mut c, "(")
        var args: []i32 = []
        while c.ok && !is(&c, ")") { v := type_name(&mut c); args.push(v); if !eat(&mut c, ",") { break } }
        expect(&mut c, ")"); var ret := 0
        if eat(&mut c, "->") { ret = type_name(&mut c) }
        return callable_type(&mut c, &args, ret, kind)
    }
    if eat(&mut c, "&") { var kind := 4; if eat(&mut c, "mut") { kind = 5 }; base := type_name(&mut c); return compound(&mut c, kind, base) }
    if eat(&mut c, "[") {
        if eat(&mut c, "]") { base := type_name(&mut c); return compound(&mut c, 1, base) }
        base := type_name(&mut c); expect(&mut c, ";"); length := length_literal(&mut c); expect(&mut c, "]"); return fixed(&mut c, base, length)
    }
    if eat(&mut c, "(") { expect(&mut c, ")"); return 0 }
    name := advance(&mut c); found := type_id(&c, name)
    if found < 0 { fail(&mut c, "unknown type '" + name + "'"); return 0 }
    found
}
fn same(c: &mut Session, expected: i32, actual: i32) {
    if expected == actual { return }
    if c.ok { fail(&mut c, "type mismatch: " + ft.declared_name(&c.types, expected) + " / " + ft.declared_name(&c.types, actual)) }
}
fn field(c: &Session, ty: i32, name: string) -> i32 { ft.field(&c.types, ty, name) }
fn load_mem(c: &mut Session, destination: i32, base: i32, offset: i32) { fa.load_mem(&mut c.code, destination, base, offset) }
fn store_mem(c: &mut Session, source: i32, base: i32, offset: i32) { fa.store_mem(&mut c.code, source, base, offset) }
fn address_slot(c: &mut Session, index: i32) { arm.address(&mut c.code, index) }
fn save_address(c: &mut Session, id: i32, token: i32) {
    var home := places.address(c.body.places.arena.nodes[3 * (id - 1)])
    if home < 0 {
        home = slot(&mut c); if !c.ok { return }
        places.save_home(&mut c.body.places.arena, id, home)
    }
    c.body.inline_place = false; c.body.direct_place = false; c.body.address = home
    bound_place(&mut c, .Temporary, id, i32(place_op.Temporary.SaveAddress), token)
}
fn place_address(c: &mut Session, id: i32, direct: bool, token: i32) {
    var op := place_op.Op.BorrowSaved; if direct { op = .BorrowHome }
    bound_place(&mut c, op, id, i32(borrows.Access.Address), token)
}
fn place_step(c: &mut Session, op: place_op.Op, ty: i32, access: i32, form: i32, parameter: i32, token: i32) {
    place_emit.emit(&mut c.code, op, ty, access, form, parameter, c.world.tokens.starts[token])
}
fn read_shape(c: &Session, ty: i32, packed: bool) -> i32 {
    storage := storage_type(&c, ty)
    var form := unsigned.shift(storage)
    if packed {
        width := ft.foreign_width(storage)
        form = 0; while i32(1).shl(form) < width { form = form + 1 }
    }
    if (packed && ty == 1) || (!packed && storage == 1) { form = 4 }
    form
}
fn bound_place(c: &mut Session, op: place_op.Op, place: i32, access: i32, token: i32) {
    if c.code.checking && !c.code.prefixing { return }
    source := c.world.tokens.starts[token]
    row := place_op.bound_header(op, place, access, source)
    arm.operand(&mut c.code, row)
    if place_op.wide(row) { arm.operand(&mut c.code, place_op.location(0, source)) }
}
fn place_transfer(c: &mut Session, ty: i32, reg: i32, base: i32, load: bool, packed: bool, access: i32, token: i32) {
    var form := read_shape(&c, ty, packed); if !load && form == 4 { form = 2 }
    var op := place_op.Op.Write; if load { op = .Read }
    place_step(&mut c, op, ty, access, form, base * 32 + reg, token)
}
fn owned(c: &Session, ty: i32) -> bool { ft.owned(&c.types, ty) }
// Clone and drop labels are bound as an adjacent pair. The backend owns this
// table; neither interning structural types nor check-only typing allocates labels.
fn bind_type_helpers(c: &mut Session) {
    if c.code.checking { return }
    c.array_helpers = arm.label(&mut c.code)
    for i in 1..4 { reserved := arm.label(&mut c.code) }
    for ty in 0..c.types.declared.type_kinds.len {
        var label := -1
        if collection(&c, ty) {
            label = c.array_helpers
            if c.types.declared.type_bases[ty] == 4 { label = label + 2 }
        } else if ty != 4 && owned(&c, ty) {
            label = arm.label(&mut c.code)
            drop_label := arm.label(&mut c.code)
        }
        c.helper_labels.push(label)
    }
}
fn type_helper(c: &mut Session, ty: i32, drop: bool) -> i32 {
    if c.code.checking { return -1 }
    var label := c.array_helpers
    if ty < c.helper_labels.len { label = c.helper_labels[ty] }
    else {
        assert(collection(&c, ty))
        if ft.type_base(&c.types, ty) == 4 { label = label + 2 }
    }
    if drop { return label + 1 }
    label
}
fn owner_store(c: &mut Session, action: row.OwnerStore, ty: i32, index: i32) {
    if c.code.checking { return }
    source := c.world.tokens.starts[c.body.cursor]
    arm.owner_store(&mut c.code, action, ty, index, source)
}
fn ownership_call(c: &mut Session, action: row.Ownership, ty: i32, target: i32) {
    may_invalidate_operand(&mut c)
    if c.code.checking { return }
    // Runtime helper bodies are outside the current source function.
    var source := 0
    if c.code.mir_capture { source = c.world.tokens.starts[c.body.cursor] }
    arm.ownership_call(&mut c.code, target, action, ty, source)
}
fn copy_value(c: &mut Session, ty: i32) {
    if ft.type_kind(&c.types, ty)==21 || ft.type_kind(&c.types, ty)==20 {fail(&mut c,"scratch values cannot escape the region");return}
    if ty == 4 || ft.type_kind(&c.types, ty) == 7 { ownership_call(&mut c, .Copy, ty, c.runtime.retain) }
    else if owned(&c, ty) { label := type_helper(&mut c, ty, false); ownership_call(&mut c, .Copy, ty, label) }
}
// Only the exact complete expression owner may transfer. Ordinary records
// recursively own their record/array children; shared enums and C inline bytes
// are stop points. The sealed generic plan preserves nested clone capacities.
fn can_take(c: &Session, ty: i32) -> bool {
    if ty == 4 || collection(&c, ty) || ft.type_kind(&c.types, ty) == 7 || ft.is_c_record(&c.types, ty) { return true }
    ft.type_kind(&c.types, ty) == 2 && !c.code.checking && ty < c.record_take_labels.len && c.record_take_labels[ty] >= -1
}
fn take_value(c: &mut Session, ty: i32) {
    if c.body.expr_owner >= 0 && c.body.expr_type == ty && can_take(&c, ty) {
        if collection(&c, ty) { ownership_call(&mut c, .NormalizeTransfer, ty, c.array_take) }
        else if ft.type_kind(&c.types, ty) == 2 && ty < c.record_take_labels.len && c.record_take_labels[ty] >= 0 {
            ownership_call(&mut c, .NormalizeTransfer, ty, c.record_take_labels[ty])
        }
        owner_store(&mut c, .Transfer, ty, c.body.expr_owner)
    } else { copy_value(&mut c, ty) }
    c.body.expr_owner = -1; c.body.expr_type = -1
}
fn drop_target(c: &mut Session, ty: i32) -> i32 {
    if ty == 4 { return c.runtime.release }
    if owned(&c, ty) { return type_helper(&mut c, ty, true) }
    -1
}
fn drop_value(c: &mut Session, ty: i32) {
    target := drop_target(&mut c, ty)
    if target >= 0 { ownership_call(&mut c, .Drop, ty, target) }
}
fn remember_owner(c: &mut Session, index: i32, ty: i32, temporary: bool) {
    c.body.owned_slots.push(index); c.body.owned_types.push(ty); c.body.owner_temps.push(temporary)
}
fn clear_owner_at(c: &mut Session, index: i32, ty: i32, source: i32) {
    target := drop_target(&mut c, ty)
    arm.load(&mut c.code, index)
    if target >= 0 {
        may_invalidate_operand(&mut c)
        arm.ownership_call(&mut c.code, target, .Clear, ty, source)
    }
    arm.owner_store(&mut c.code, .Vacate, ty, index, source)
}
fn clear_owner(c: &mut Session, index: i32, ty: i32) {
    if !c.code.checking { clear_owner_at(&mut c, index, ty, c.world.tokens.starts[c.body.cursor]) }
}
fn save_owner(c: &mut Session, index: i32, ty: i32, temporary: bool) {
    if c.code.checking { return }
    remember_owner(&mut c, index, ty, temporary)
    install_owner(&mut c, index, ty, c.world.tokens.starts[c.body.cursor])
}
fn install_owner(c: &mut Session, index: i32, ty: i32, source: i32) {
    // Every owner first enters as null in the function prologue. Only a
    // backedge can revisit this installation before a previous value dies.
    if c.body.reenter_owners {
        arm.push_temp(&mut c.code, 0); clear_owner_at(&mut c, index, ty, source); arm.pop_temp(&mut c.code, 0)
    }
    arm.owner_store(&mut c.code, .Install, ty, index, source)
}
fn temporary(c: &mut Session, ty: i32) -> i32 {
    c.body.expr_owner = -1; c.body.expr_type = -1
    if owned(&c, ty) { index := slot(&mut c); save_owner(&mut c, index, ty, true); c.body.expr_owner = index; c.body.expr_type = ty }
    ty
}
fn cleanup_from(c: &mut Session, first: i32, only_temps: bool) {
    var i := c.body.owned_slots.len - 1
    while i >= first {
        if c.body.owned_slots[i] >= 0 && (!only_temps || c.body.owner_temps[i]) { clear_owner(&mut c, c.body.owned_slots[i], c.body.owned_types[i]) }
        i = i - 1
    }
}
// The operand's existing owner is safe across local reads and arithmetic.
// Calls, ownership changes, writes and address exposures are observed while
// typing the RHS. Nested operands contribute to the same monotonic summary.
fn may_invalidate_operand(c: &mut Session) {
    if c.body.observing_lease { c.body.lease_generation = c.body.lease_generation + 1 }
}
fn skip_body(c: &mut Session) { expect(&mut c, "{"); c.body.cursor = c.world.closes[c.body.cursor - 1] + 1 }
fn foreign_scalar(c: &Session, ty: i32) -> bool { ft.foreign_scalar(&c.types, ty) }
fn valid_foreign_name(value: string) -> bool {
    if value.len == 0 { return false }
    for i in 0..value.len { if value[i] == 0 { return false } }
    true
}
fn source_owner(offset: i32, starts: &[]i32, files: &[]i32) -> i32 {
    var lo := 0; var hi := starts.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if starts[mid] <= offset { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return 0 }; files[lo - 1]
}
fn opaque_access(c: &mut Session, ty: i32) {
    if ft.declaring_owner(&c.types, ty) >= 0 && ft.declaring_owner(&c.types, ty) != c.body.current_owner {
        fail(&mut c, "an opaque struct can only be constructed or opened by its defining module")
    }
}
fn headers(c: &mut Session, module_starts: &[]i32, module_files: &[]i32) {
    var stack: []i32 = []
    for i in 0..c.world.tokens.kinds.len {
        if c.world.tokens.kinds[i] == .Symbol {
            if c.world.tokens.texts[i] == "{" { stack.push(i) }
            if c.world.tokens.texts[i] == "}" { if stack.len == 0 { fail(&mut c, "unexpected closing brace"); return }; open := stack.pop(); c.world.closes[open] = i }
        }
    }
    if stack.len != 0 { fail(&mut c, "unterminated body"); return }
    // Register every nominal type before parsing fields or function signatures.
    var declarations: []i32 = []; var declaration_types: []i32 = []
    separators(&mut c)
    var file_caps := 0
    if eat(&mut c, "capability") {
        while c.ok {
            if eat(&mut c, "unsafe") && !c.world.unsafe_capable { c.world.unsafe_capable = true }
            else if eat(&mut c, "filesystem") && file_caps.bit_and(1) == 0 { file_caps = file_caps.bit_or(1) }
            else if eat(&mut c, "network") && file_caps.bit_and(2) == 0 { file_caps = file_caps.bit_or(2) }
            else if eat(&mut c, "process") && file_caps.bit_and(4) == 0 { file_caps = file_caps.bit_or(4) }
            else { fail(&mut c, "unknown or duplicate module capability"); break }
            if !eat(&mut c, ",") { break }
        }
        separators(&mut c)
    }
    while c.ok && c.world.tokens.kinds[c.body.cursor] != .End {
        var library := ""; var symbol := ""; var layout := false; var test := false
        if eat(&mut c, "@") {
            annotation := advance(&mut c)
            if annotation == "extern" {
                expect(&mut c, "(")
                if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "expected an extern library") }
                library = advance(&mut c); expect(&mut c, ",")
                if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "expected an extern symbol") }
                symbol = advance(&mut c); expect(&mut c, ")")
                if !valid_foreign_name(library) || !valid_foreign_name(symbol) { fail(&mut c, "invalid external library or symbol") }
            } else if annotation == "c_layout" { layout = true }
            else if annotation == "test" { test = true }
            else { fail(&mut c, "unknown declaration attribute"); break }
            newlines(&mut c)
            if is(&c, "{") { skip_body(&mut c); separators(&mut c); continue }
        }
        public := eat(&mut c, "pub")
        unchecked := eat(&mut c, "unsafe")
        if unchecked && !c.world.unsafe_capable { fail(&mut c, "module requires capability unsafe"); break }
        if library != "" && !unchecked { fail(&mut c, "@extern requires unsafe fn"); break }
        opaque := eat(&mut c, "opaque")
        owner := source_owner(c.world.tokens.starts[c.body.cursor], &module_starts, &module_files)
        what := advance(&mut c)
        if opaque && what != "struct" { fail(&mut c, "expected opaque struct"); break }
        if what != "fn" && what != "struct" && what != "enum" { fail(&mut c, "expected fn, struct or enum (imports must be loaded first)"); break }
        name := advance(&mut c)
        if (layout && what != "struct") || (unchecked && what != "fn") { fail(&mut c, "invalid declaration attribute"); break }
        declarations.push(c.body.cursor)
        var ty := -1
        if what != "fn" {
            if type_id(&c, name) >= 0 { fail(&mut c, "duplicate type") }
            else if name == "TaskID" { fail(&mut c, "reserved type name") }
            var kind := 2; if what == "enum" { kind = 3 }
            ty = add_type(&mut c, name, kind, 0); c.types.c_record[ty] = layout; if opaque { c.types.opaque_owner[ty] = owner }
        } else {
            if map.contains(&c.world.functions, name) || rules.reserved(name) { fail(&mut c, "duplicate or reserved function name") }
            c.world.function_owners.push(owner); c.world.test_functions.push(test)
            c.world.libraries.push(library); c.world.symbols.push(symbol); c.world.unsafe_functions.push(unchecked)
            map.put(&mut c.world.functions, name, i64(c.world.names.len)); c.world.names.push(name)
        }
        declaration_types.push(ty)
        if library != "" {
            while c.ok && !is(&c, "\n") && !is(&c, ";") && c.world.tokens.kinds[c.body.cursor] != .End {
                if is(&c, "{") { fail(&mut c, "external declaration cannot have a body"); break }
                skip_token(&mut c)
            }
            separators(&mut c); continue
        }
        while c.ok && !is(&c, "{") { if c.world.tokens.kinds[c.body.cursor] == .End { fail(&mut c, "missing declaration body"); break }; skip_token(&mut c) }
        if c.ok { skip_body(&mut c); separators(&mut c) }
    }
    for d in 0..declarations.len {
        if !c.ok { break }
        c.body.cursor = declarations[d]; ty := declaration_types[d]
        if ty >= 0 {
            expect(&mut c, "{"); c.types.declared.type_starts[ty] = c.types.field_names.len; separators(&mut c)
            var tag: i64 = 0
            while c.ok && !is(&c, "}") {
                if c.world.tokens.kinds[c.body.cursor] != .Name { fail(&mut c, "expected field or variant name"); break }
                name := advance(&mut c); var ft := 0; payload := c.types.payload_types.len
                if c.types.declared.type_kinds[ty] == 2 {
                    for prior in c.types.declared.type_starts[ty]..c.types.field_names.len {
                        if c.types.field_names[prior] == name { fail(&mut c, "duplicate struct field '" + name + "'") }
                    }
                    expect(&mut c, ":"); ft = type_name(&mut c)
                    if c.types.declared.type_kinds[ft] == 4 || c.types.declared.type_kinds[ft] == 5 { fail(&mut c, "a field cannot store a borrow") }
                }
                else {
                    if eat(&mut c, "(") {
                        c.types.declared.type_kinds[ty] = 7
                        while c.ok {
                            pt := type_name(&mut c)
                            if pt == 0 || c.types.declared.type_kinds[pt] == 4 || c.types.declared.type_kinds[pt] == 5 { fail(&mut c, "invalid payload type") }
                            c.types.payload_types.push(pt)
                            if !eat(&mut c, ",") { break }
                        }
                        expect(&mut c, ")")
                    }
                    if eat(&mut c, "=") {
                        var sign := ""; if eat(&mut c, "-") { sign = "-" }
                        value := rules.literal_integer(sign + advance(&mut c)); tag = value.value
                        if !value.ok { fail(&mut c, "invalid enum tag") }
                    }
                    if tag < -2147483648 || tag > 2147483647 { fail(&mut c, "enum tag out of range") }
                    for prior in c.types.declared.type_starts[ty]..c.types.field_names.len {
                        if c.types.field_names[prior] == name || c.types.field_values[prior] == tag { fail(&mut c, "duplicate enum variant or tag") }
                    }
                }
                c.types.payload_starts.push(payload); c.types.payload_counts.push(c.types.payload_types.len - payload)
                c.types.field_names.push(name); c.types.field_types.push(ft); c.types.field_values.push(tag); tag = tag + 1
                if !eat(&mut c, ",") { separators(&mut c); if !is(&c, "}") { fail(&mut c, "expected field comma") } }; separators(&mut c)
            }
            c.types.declared.type_counts[ty] = c.types.field_names.len - c.types.declared.type_starts[ty]
            if c.types.declared.type_kinds[ty] == 3 && c.types.declared.type_counts[ty] == 0 { fail(&mut c, "enum requires at least one variant") }
        } else {
            expect(&mut c, "("); first := c.world.param_names.len
            while c.ok && !is(&c, ")") {
                c.world.param_tokens.push(c.body.cursor); parameter := advance(&mut c); expect(&mut c, ":"); pt := type_name(&mut c)
                c.world.param_names.push(parameter); c.world.param_types.push(pt)
                if !eat(&mut c, ",") { break }
            }
            expect(&mut c, ")"); c.world.param_starts.push(first); c.world.param_counts.push(c.world.param_names.len - first)
            var ret := 0; if eat(&mut c, "->") { ret = type_name(&mut c); if c.types.declared.type_kinds[ret] == 4 || c.types.declared.type_kinds[ret] == 5 { fail(&mut c, "a function cannot return a borrow") } }; c.world.returns.push(ret)
            f := c.world.returns.len - 1
            if c.world.test_functions[f] && (c.world.param_counts[f] != 0 || ret != 0) { fail(&mut c, "@test function must take no parameters and return ()") }
            if c.world.libraries[f] != "" {
                var args: []i32 = []
                for p in first..c.world.param_names.len { args.push(c.world.param_types[p]) }
                ft := foreign_type(&mut c, &args, ret); c.world.ffi_types.push(ft)
                if !is(&c,"\n") && !is(&c,";") && c.world.tokens.kinds[c.body.cursor] != .End { fail(&mut c,"unexpected token after external declaration") }
                c.world.starts.push(0); c.world.ends.push(0); continue
            }
            var ordinary_args: []i32 = []
            for p in first..c.world.param_names.len { ordinary_args.push(c.world.param_types[p]) }
            signature := callable_type(&mut c, &ordinary_args, ret, 9); c.world.ffi_types.push(signature)
            newlines(&mut c); expect(&mut c, "{"); c.world.starts.push(c.body.cursor); c.world.ends.push(c.world.closes[c.body.cursor - 1])
            if ret != 0 { newlines(&mut c); if is(&c, "}") { fail(&mut c, "function can finish without returning a value") } }
        }
    }
}
fn slot(c: &mut Session) -> i32 {
    result := c.body.slots; c.body.slots = c.body.slots + 1
    if c.body.slots > 65535 { fail(&mut c, "this compiler stage allows at most 65535 local slots per function") }
    result
}
fn local(body: &FunctionContext, name: string) -> i32 {
    locals.resolve(&body.locals, name)
}
fn type_spelling(c: &Session, ty: i32) -> string { ft.type_spelling(&c.types, ty) }
fn bind(c: &mut Session, model: &mut opt_ir.Function, name: string, ty: i32, mutable: bool, index: i32, at: i32) {
    if c.report && at >= 0 && c.world.tokens.starts[at] < c.world.source_end {
        facts.binding(&mut c.body.facts, at, ty)
    }
    if !rules.identifier(name) { fail(&mut c, "this compiler stage supports ASCII identifiers") }
    if rules.reserved(name) { fail(&mut c, "reserved local name") }
    prior := locals.resolve(&c.body.locals, name)
    if prior >= 0 && c.body.locals.scopes[prior] == c.body.scope { fail(&mut c, "duplicate local name") }
    id := locals.add(&mut c.body.locals, name, ty, mutable, c.body.scope, at)
    var referent := ty; var deref := 0; kind := ft.type_kind(&c.types, ty)
    if kind == 4 || kind == 5 { referent = ft.type_base(&c.types, ty); deref = kind - 3 }
    places.local(&mut c.body.places.arena, index, referent, read_shape(&c, referent, false), deref)
    if model.recording {
        var param := -1
        if id < model.params { param = id }
        typed.local(&mut model, &c.body.locals, id, ft.scalar_type(&c.types, ty), param)
    }
}
fn enter(c: &mut Session) { c.body.scope = c.body.scope + 1 }
fn drop_locals_to(c: &mut Session, limit: i32, scope: i32) {
    // Join/discard all tasks before releasing any source owner in this block.
    first := locals.first_in_scope(&c.body.locals, limit, scope)
    if c.tasks.program { task_close_locals(&mut c, first) }
    while c.body.locals.active.len > first {
        id := c.body.locals.active.pop(); ty := c.body.locals.types[id]
        if owned(&c, ty) { clear_owner(&mut c, places.local_home(c.body.places.arena.locals[id]), ty) }
    }
}
fn leave(c: &mut Session) {
    drop_locals_to(&mut c, 0, c.body.scope)
    c.body.scope = c.body.scope - 1
}
fn narrow(c: &mut Session) {
    arm.sign_extend_i32(&mut c.code, 2, 0); arm.compare_register(&mut c.code, 0, 2); arm.branch(&mut c.code, c.overflow, 3)
}
fn float_literal(c: &mut Session, spelling: string, expected: i32) -> i32 {
    var ty := 7; if expected == 6 { ty = 6 }
    value := decimal.decode(spelling, ty == 6)
    if !value.ok { fail(&mut c, "floating literal is outside the finite range") }
    arm.imm(&mut c.code, 0, value.bits); ty
}
fn format_float(c: &mut Session, ty: i32, source: i32) {
    id := i32(map.get_or(&c.world.functions, "__dunder_module_format_float_bits", -1))
    task_edge(&mut c, id)
    if c.validating_dead { return }
    if id < 0 { fail(&mut c, "missing floating formatter"); return }
    c.body.facts.needed.push(id)
    arm.intrinsic_call(&mut c.code, c.fn_labels[id], .Format, ty, 4, source)
}
fn integer_literal(c: &mut Session, spelling: string, ty: i32) -> i64 {
    if unsigned.has(ty) {
        number := unsigned.literal(spelling, ty)
        if !number.ok { fail(&mut c, "unsigned integer literal out of range") }
        else if c.code.platform == 3 && ty == 12 && (number.value < 0 || number.value > 4294967295) { fail(&mut c, "usize literal exceeds wasm32 pointer width") }
        return number.value
    }
    var value := rules.literal_integer(spelling)
    checked := rules.validate_signed(&mut value, ty)
    if !value.ok { fail(&mut c, "integer literal out of range") }
    value.value
}
fn literal(c: &mut Session, model: &mut opt_ir.Function, spelling: string, expected: i32) -> i32 {
    if floats.has(expected) { return float_literal(&mut c, spelling, expected) }
    var ty := expected
    if !unsigned.has(ty) && ty != 2 { ty = 1 }
    value := integer_literal(&mut c, spelling, ty)
    if model.recording {
        if ty != 1 && ty != 2 { model.recording = false }
        else { _ := typed.node(&mut model, 1, ty, -1, -1, -1, value, -1, c.body.cursor - 1) }
    }
    if !c.code.checking || c.code.prefixing { arm.imm(&mut c.code, 0, value) }
    ty
}
fn intrinsic(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    var covered := false
    result := intrinsic_dispatch(&mut c, name, expected, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
fn intrinsic_dispatch(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    if name == "__sys_decode_utf8" || name == "__sys_decode_u8" || name == "__sys_decode_u8_range" { covered = true; task_effect(&mut c, 13) }
    else { task_effect(&mut c, 256) }
    var target := -1; var ret := expected
    if name == "__sys_arg_count" { covered = true; target = c.runtime.sys_arg_count; ret = 1 }
    else if name == "__sys_envp" { covered = true; require_unsafe(&mut c); target = c.runtime.sys_envp; ret = 13 }
    else if name == "__sys_linux_syscall" { covered = true; require_unsafe(&mut c); target = c.runtime.sys_linux_syscall; ret = 2 }
    else if name == "__sys_arg" { covered = true; target = c.runtime.sys_arg; ret = 4 }
    else if name == "__sys_pid" { covered = true; target = c.runtime.sys_pid; ret = 1 }
    else if name == "__sys_read_text" { covered = true; target = c.runtime.sys_read_text }
    else if name == "__sys_read_u8" { covered = true; target = c.runtime.sys_read_u8 }
    else if name == "__sys_metadata" { covered = true; target = c.runtime.sys_metadata }
    else if name == "__sys_same_file" { covered = true; target = c.runtime.sys_same_file; ret = 3 }
    else if name == "__sys_write_bytes" || name == "__sys_write_u8" { covered = true; target = c.runtime.sys_write_bytes }
    else if name == "__sys_make_executable" { covered = true; target = c.runtime.sys_make_executable }
    else if name == "__sys_rename" { covered = true; target = c.runtime.sys_rename }
    else if name == "__sys_remove_file" { covered = true; target = c.runtime.sys_remove_file }
    else if name == "__sys_decode_utf8" || name == "__sys_decode_u8" { covered = true; target = c.runtime.sys_decode_utf8 }
    else if name == "__sys_decode_u8_range" { covered = true; target = c.runtime.sys_decode_u8_range }
    else if name == "__sys_write_stderr" { covered = true; target = c.runtime.sys_stderr }
    else if name == "__sys_write_text" { covered = true; target = c.runtime.sys_write_text }
    else if name == "__sys_append_text" { covered = true; target = c.runtime.sys_append_text }
    else if name == "__sys_mkdir" { covered = true; target = c.runtime.sys_mkdir }
    else if name == "__sys_remove_dir" { covered = true; target = c.runtime.sys_remove_dir }
    else if name == "__sys_now_ms" { covered = true; target = c.runtime.sys_now_ms; ret = 2 }
    else if name == "__sys_net_listen" { covered = true; target = c.runtime.sys_net_listen; ret = 2 }
    else if name == "__sys_net_accept" { covered = true; target = c.runtime.sys_net_accept; ret = 2 }
    else if name == "__sys_net_connect" { covered = true; target = c.runtime.sys_net_connect; ret = 2 }
    else if name == "__sys_net_read" { covered = true; target = c.runtime.sys_net_read; ret = 2 }
    else if name == "__sys_net_write" { covered = true; target = c.runtime.sys_net_write; ret = 2 }
    else if name == "__sys_net_poll" { covered = true; target = c.runtime.sys_net_poll; ret = 2 }
    else if name == "__sys_net_set_nonblocking" { covered = true; target = c.runtime.sys_net_set_nonblocking; ret = 2 }
    else if name == "__sys_net_set_nodelay" { covered = true; target = c.runtime.sys_net_set_nodelay; ret = 2 }
    else if name == "__sys_net_local_port" { covered = true; target = c.runtime.sys_net_local_port; ret = 2 }
    else if name == "__sys_net_shutdown_write" { covered = true; target = c.runtime.sys_net_shutdown_write; ret = 2 }
    else if name == "__sys_net_close" { covered = true; target = c.runtime.sys_net_close; ret = 2 }
    if target < 0 { fail(&mut c, "unsupported intrinsic '" + name + "'"); return 0 }
    var count := 0
    while c.ok && !is(&c, ")") {
        var want := 0
        var elem := 0; var ref_kind := 4
        if count == 1 && (name == "__sys_write_bytes" || name == "__sys_write_u8" || name == "__sys_net_write") {
            elem = 1; if name != "__sys_write_bytes" { elem = 8 }
        } else if count == 0 && (name == "__sys_decode_utf8" || name == "__sys_decode_u8" || name == "__sys_decode_u8_range") {
            elem = 1; if name != "__sys_decode_utf8" { elem = 8 }
        } else if (count == 1 && (name == "__sys_read_u8" || name == "__sys_net_read")) || (count == 0 && name == "__sys_net_poll") {
            elem = 8; ref_kind = 5
        }
        if elem != 0 {
            if elem == 8 { covered = true }
            array := compound(&mut c, 1, elem); want = compound(&mut c, ref_kind, array)
        }
        var arg_want := want
        if name == "__sys_linux_syscall" { arg_want = 2 }
        argument := c.body.cursor; ty := expression(&mut c, 0, arg_want, &catalog, &mut inline_work, &mut model)
        if arg_want != 0 { same(&mut c, arg_want, ty) }
        if want != 0 { place_step(&mut c, .Read, ft.type_base(&c.types, want), ref_kind - 1, 3, 0, argument) }
        arm.push_temp(&mut c.code, 0); count = count + 1
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")")
    if name == "__sys_envp" && count != 0 { fail(&mut c, "__sys_envp expects no arguments"); return 0 }
    if name == "__sys_linux_syscall" && count != 7 { fail(&mut c, "__sys_linux_syscall expects 7 arguments"); return 0 }
    var i := count - 1; while i >= 0 { arm.pop_temp(&mut c.code, i); i = i - 1 }
    arm.branch(&mut c.code, target, 1); ret
}
fn length_value(c: &mut Session, ty: i32, token: i32) -> i32 {
    if collection(&c, ty) || ft.type_kind(&c.types, ty) == 21 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Length), 1, token) }
    else if ty == 4 { place_step(&mut c, .Member, ty, 0, i32(place_op.Member.Length), 0, token) }
    else { fail(&mut c, "len expects an array or string") }
    1
}
// Record only referenced imports and leave one page-relative GOT load for the image writer.
fn import_address(c: &mut Session, f: i32) {
    task_effect(&mut c, 32)
    if c.validating_dead { return }
    if c.code.platform == 3 {
        if !wasm_type(&mut c, c.world.ffi_types[f]) { return }
        request_symbol(&mut c, .WasmImport, f); arm.imm(&mut c.code, 0, 0); return
    }
    request_symbol(&mut c, .Import, f)
    arm.native_address(&mut c.code, 16); arm.mov(&mut c.code, 0, 16)
}
fn hfa(c: &Session, ty: i32, depth: i32) -> i32 { ft.hfa(&c.types, ty, depth) }
fn request_symbol(c: &mut Session, kind: facts.Symbol, operand: i32) {
    var word := -1
    if !c.code.checking { word = arm.position(&c.code) }
    facts.symbol(&mut c.body.facts, kind, word, operand, c.body.cursor)
}
fn static_address(c: &mut Session, kind: facts.Symbol, operand: i32) {
    task_effect(&mut c, 64); request_symbol(&mut c, kind, operand)
    arm.native_address(&mut c.code, 16)
}
fn foreign_width(ty: i32) -> i32 { ft.foreign_width(ty) }
fn storage_type(c: &Session, ty: i32) -> i32 { ft.storage_type(&c.types, ty, c.code.platform) }
fn wasm_type(c: &mut Session, ty: i32) -> bool {
    if ft.is_c_record(&c.types, ft.type_base(&c.types, ty)) { fail(&mut c, "pass Wasm C records by pointer"); return false }
    first := ft.type_start(&c.types, ty)
    for p in first..(first + ft.type_count(&c.types, ty)) {
        if ft.is_c_record(&c.types, ft.parameter_type(&c.types, p)) { fail(&mut c, "pass Wasm C records by pointer"); return false }
    }
    true
}
fn wasm_signature(c: &mut Session, ty: i32) -> i32 {
    first := ft.type_start(&c.types, ty); count := ft.type_count(&c.types, ty)
    var args: []i32 = []; args.reserve(count)
    for p in first..(first + count) { args.push(ft.parameter_type(&c.types, p)) }
    ret := ft.type_base(&c.types, ty)
    wa.signature(&mut c.wasm_abi, &args, ret)
}
// The callee address is in x0. Stage arguments in frame slots before populating
// the independent scalar and float register banks, then the aligned stack.
fn foreign_call(c: &mut Session, sig: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    task_effect(&mut c, 32)
    if !c.body.unsafe_scope { fail(&mut c, "foreign call requires unsafe"); return 0 }
    callee := slot(&mut c); arm.store(&mut c.code, callee, 0)
    if c.code.platform == 3 {
        if !wasm_type(&mut c, sig) { return 0 }
        return invoke(&mut c, sig, callee, -1, 0, &catalog, &mut inline_work, &mut model)
    }
    first := ft.type_start(&c.types, sig); count := ft.type_count(&c.types, sig)
    var values: []i32 = []; var locations: []i32 = []
    var gp_limit := 8; if c.code.platform == 2 { gp_limit = 6 }
    ret := ft.type_base(&c.types, sig); ret_c_record := ft.is_c_record(&c.types, ret); var ret_hfa := 0
    var result_slot := -1; var indirect_result := false
    if ret_c_record {
        ret_hfa = hfa(&c, ret, 0)
        if ret_hfa == 0 { fail(&mut c, "unsupported foreign aggregate result"); return 0 }
        arm.imm(&mut c.code, 0, i64(ft.c_size(&c.types, ret))); arm.branch(&mut c.code, c.runtime.alloc_record, 1)
        result_slot = slot(&mut c); arm.store(&mut c.code, result_slot, 0)
        indirect_result = c.code.platform == 2 && ft.c_size(&c.types, ret) > 16
    }
    var spec := fa.ForeignCallSpec { ret: ret, ret_c_record: ret_c_record, ret_hfa: ret_hfa,
        arg_types: [], arg_packed: [], arg_c_record: [], arg_hfas: [], arg_sizes: [] }
    var gp := 0; if indirect_result { gp = 1 }; var fp := 0; var outgoing := 0
    while c.ok && !is(&c, ")") {
        if values.len == count { fail(&mut c, "too many C call arguments"); return 0 }
        want := ft.parameter_type(&c.types, first + values.len)
        actual := expression(&mut c, 0, want, &catalog, &mut inline_work, &mut model); same(&mut c, want, actual)
        aggregate := ft.is_c_record(&c.types, want)
        if aggregate {
            if hfa(&c, want, 0) == 0 { fail(&mut c, "unsupported foreign aggregate parameter"); return 0 }
            copy_value(&mut c, want); temp := temporary(&mut c, want)
        }
        value := slot(&mut c); arm.store(&mut c.code, value, 0); values.push(value)
        shape := hfa(&c, want, 0); var need := shape; if shape < 0 { need = -shape }
        spec.arg_types.push(want); spec.arg_packed.push(storage_type(&c, want))
        spec.arg_c_record.push(aggregate); spec.arg_hfas.push(shape); spec.arg_sizes.push(ft.c_size(&c.types, want))
        if aggregate && c.code.platform == 2 {
            need = (ft.c_size(&c.types, want) + 7) / 8
            if need > 2 { need = 9 }
        }
        if need > 0 && fp + need <= 8 { locations.push(8 + fp); fp = fp + need }
        else if need == 0 && gp < gp_limit { locations.push(gp); gp = gp + 1 }
        else {
            if need > 0 && c.code.platform != 2 { fp = 8 }
            var alignment := 8; var width := 8
            if c.code.platform == 0 { alignment = foreign_width(want); width = alignment }
            if aggregate {
                width = ft.c_size(&c.types, want)
                if c.code.platform == 0 { alignment = ft.c_align(&c.types, want) } else { width = (width + 7) / 8 * 8 }
            }
            outgoing = (outgoing + alignment - 1) / alignment * alignment
            locations.push(16 + outgoing); outgoing = outgoing + width
        }
        if !eat(&mut c, ",") { break }
    }
    expect(&mut c, ")"); if count != values.len { fail(&mut c, "wrong C argument count"); return 0 }
    outgoing = (outgoing + 15) / 16 * 16
    if outgoing > 4080 { fail(&mut c, "C argument frame exceeds direct stack offset"); return 0 }
    if c.code.checking { return ret }
    var patches := fa.new_patches(0)
    fa.emit_foreign_call(&mut c.code, &spec, callee, &values, &locations,
        result_slot, indirect_result, gp, fp, outgoing, c.has_callbacks,
        &mut patches, c.float_trap, c.overflow)
    for i in 0..patches.sites.len {
        facts.symbol(&mut c.body.facts, .CallbackStorage, patches.sites[i] / 4, -1 - patches.slots[i], c.body.cursor)
    }
    ret
}
fn c_layout(c: &mut Session, ty: i32) {
    if !c.ok { return }
    ft.c_layout(&mut c.types, c.code.platform, ty)
    check_type_error(&mut c)
}
fn validate_layouts(c: &mut Session) {
    if !c.ok { return }
    ft.validate_layouts(&mut c.types, c.code.platform)
    check_type_error(&mut c)
}
// x0 points at source, x1 at destination. Returns destination in x0.
fn copy_inline(c: &mut Session, bytes: i32) { fa.copy_inline(&mut c.code, bytes) }
fn zero_record(c: &mut Session, ty: i32, at: i32) {
    bytes := ft.c_size(&c.types, ty)
    arm.allocate_value(&mut c.code, c.runtime.alloc_record, .CRecord, ty, bytes, c.world.tokens.starts[at])
    fa.clear_record(&mut c.code, bytes)
}
fn fixed_pod(c: &Session, ty: i32) -> bool { ft.fixed_pod(&c.types, ty) }
fn inline_value(c: &mut Session, ty: i32, access: borrows.Access, token: i32) {
    if ft.is_c_record(&c.types, ty) { return }
    if ft.type_kind(&c.types, ty) != 6 { place_transfer(&mut c, ty, 0, 0, true, true, i32(access), token); return }
    elem := ft.type_base(&c.types, ty)
    var local_slots := c.body.slots; var err := ""
    fa.inline_descriptor(&mut c.code, ft.type_count(&c.types, ty), ft.c_size(&c.types, elem), &mut local_slots, &mut err)
    c.body.slots = local_slots
    if err != "" { fail(&mut c, err) }
}
fn store_inline(c: &mut Session, ty: i32, token: i32) {
    access := i32(borrows.Access.Address); kind := ft.type_kind(&c.types, ty)
    if !ft.is_c_record(&c.types, ty) && kind != 6 { place_transfer(&mut c, ty, 0, 1, false, true, access, token); return }
    var fixed := 0; var count := ft.c_size(&c.types, ty); var stride := 1; var part := 0
    if kind == 6 {
        fixed = 1; count = ft.type_count(&c.types, ty); elem := ft.type_base(&c.types, ty)
        stride = ft.c_size(&c.types, elem); var width := 0
        while i32(1).shl(width) < ft.foreign_width(storage_type(&c, elem)) { width = width + 1 }
        if elem == 1 { width = 4 }; part = width + 1
    }
    place_step(&mut c, .CopySetup, ty, access, fixed, count, token)
    head := arm.label(&mut c.code); done := arm.label(&mut c.code)
    arm.mark(&mut c.code, head); place_step(&mut c, .CopyTest, ty, access, fixed, 0, token); arm.branch(&mut c.code, done, 2)
    place_step(&mut c, .CopyPart, ty, access, part, stride, token)
    arm.branch(&mut c.code, head, 0); arm.mark(&mut c.code, done)
}
// Bridge a synchronous C entry onto the suspended Dunder runtime on this thread.
fn callback_entry(c: &mut Session, id: i32) {
    var ptypes: []i32 = []
    first := c.world.param_starts[id]; count := c.world.param_counts[id]
    ptypes.reserve(count)
    for p in 0..count { ptypes.push(c.world.param_types[first + p]) }
    var patches := fa.new_patches(c.imports.globals)
    fa.emit_callback_entry(&mut c.code, &mut patches, c.fn_labels[id], c.callback_labels[id], &ptypes, c.world.returns[id])
    c.imports.globals = patches.globals
    for i in 0..patches.sites.len { c.imports.sites.push(patches.sites[i]); c.imports.slots.push(patches.slots[i]) }
}

fn require_unsafe(c: &mut Session) {
    task_effect(&mut c, 16)
    if !c.body.unsafe_scope { fail(&mut c, "operation requires unsafe function or block") }
}
fn raw_memory_type(c: &Session, name: string, start: i32) -> i32 {
    if name.len <= start { return -1 }
    ty := type_id(&c, name[start..name.len])
    if ty < 0 || !foreign_scalar(&c, ty) { return -1 }; ty
}
fn target_match(platform: i32, name: string) -> i32 {
    if name == "macos" || name == "arm64-macos" || name == "aarch64-apple-darwin" { if platform == 0 { return 1 }; return 0 }
    if name == "linux" { if platform == 1 || platform == 2 { return 1 }; return 0 }
    if name == "arm64-linux" || name == "aarch64-unknown-linux-gnu" { if platform == 1 { return 1 }; return 0 }
    if name == "x86_64-linux" || name == "x86_64-unknown-linux-gnu" { if platform == 2 { return 1 }; return 0 }
    if name == "arm64" { if platform == 0 || platform == 1 { return 1 }; return 0 }
    if name == "x86_64" { if platform == 2 { return 1 }; return 0 }
    if name == "native" { if platform != 3 { return 1 }; return 0 }
    if name == "wasm32" || name == "wasm32-unknown-unknown" { if platform == 3 { return 1 }; return 0 }
    -1
}
fn tok_is(c: &Session, pos: i32, text: string) -> bool {
    pos >= 0 && pos < c.world.tokens.kinds.len && c.world.tokens.kinds[pos] != .String && c.world.tokens.kinds[pos] != .Rune && c.world.tokens.kinds[pos] != .Byte && c.world.tokens.texts[pos] == text
}
fn skip_newlines(c: &Session, pos: i32) -> i32 {
    var i := pos
    while i < c.world.tokens.kinds.len && c.world.tokens.kinds[i] == .Newline { i = i + 1 }
    i
}
fn eval_target_atom(c: &Session, pos: i32, end: &mut i32) -> i32 {
    if tok_is(&c, pos, "!") {
        inner := eval_target_atom(&c, pos + 1, &mut end)
        if inner < 0 { return -1 }
        return 1 - inner
    }
    if tok_is(&c, pos, "(") {
        inner := eval_target_or(&c, skip_newlines(&c, pos + 1), &mut end)
        closed := skip_newlines(&c, end)
        if inner < 0 || !tok_is(&c, closed, ")") { return -1 }
        end = closed + 1
        return inner
    }
    if pos + 3 < c.world.tokens.kinds.len && c.world.tokens.kinds[pos] == .Name && c.world.tokens.texts[pos] == "target_is" && local(&c.body, "target_is") < 0 && tok_is(&c, pos + 1, "(") && c.world.tokens.kinds[pos + 2] == .String && tok_is(&c, pos + 3, ")") {
        v := target_match(c.code.platform, c.world.tokens.texts[pos + 2])
        if v < 0 { return -1 }
        end = pos + 4
        return v
    }
    -1
}
fn eval_target_and(c: &Session, pos: i32, end: &mut i32) -> i32 {
    var v := eval_target_atom(&c, pos, &mut end)
    if v < 0 { return -1 }
    while tok_is(&c, end, "&&") {
        var right_end := 0
        rhs := eval_target_atom(&c, skip_newlines(&c, end + 1), &mut right_end)
        if rhs < 0 { return -1 }
        if v == 1 && rhs == 1 { v = 1 } else { v = 0 }
        end = right_end
    }
    v
}
fn eval_target_or(c: &Session, pos: i32, end: &mut i32) -> i32 {
    var v := eval_target_and(&c, pos, &mut end)
    if v < 0 { return -1 }
    while tok_is(&c, end, "||") {
        var right_end := 0
        rhs := eval_target_and(&c, skip_newlines(&c, end + 1), &mut right_end)
        if rhs < 0 { return -1 }
        if v == 1 || rhs == 1 { v = 1 } else { v = 0 }
        end = right_end
    }
    v
}
fn call(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> i32 {
    may_invalidate_operand(&mut c)
    var covered := false
    result := call_dispatch(&mut c, name, expected, &catalog, &mut inline_work, &mut model, &mut covered)
    if c.tasks.program && c.ok && !covered { task_effect(&mut c, 4096) }
    result
}
fn call_dispatch(c: &mut Session, name: string, expected: i32, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function, covered: &mut bool) -> i32 {
    expect(&mut c, "(")
    if c.code.platform == 3 && name.len >= 6 && name[0..6] == "__sys_" && name != "__sys_decode_utf8" && name != "__sys_decode_u8" && name != "__sys_decode_u8_range" { fail(&mut c, "native system calls need a native target"); return 0 }
    if name == "target_is" { covered = true;
        if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "target_is requires a target literal"); return 0 }
        target := advance(&mut c); expect(&mut c, ")")
        matched := target_match(c.code.platform, target)
        if matched < 0 { fail(&mut c, "unknown target '" + target + "'"); return 0 }
        arm.imm(&mut c.code, 0, i64(matched)); return 3
    }
    if name == "size_of" || name == "align_of" { covered = true;
        ty := type_name(&mut c); c_layout(&mut c, ty); expect(&mut c, ")")
        if name == "size_of" { arm.imm(&mut c.code, 0, i64(ft.c_size(&c.types, ty))) } else { arm.imm(&mut c.code, 0, i64(ft.c_align(&c.types, ty))) }
        return 12
    }
    if name == "zeroed" { covered = true;
        require_unsafe(&mut c); expect(&mut c, ")")
        if !ft.is_c_record(&c.types, expected) { fail(&mut c, "zeroed requires a C record"); return 0 }
        zero_record(&mut c, expected, c.body.cursor - 3); return expected
    }
    if name == "callback" { covered = true;
        task_effect(&mut c, 128)
        may_invalidate_operand(&mut c) // Exposes an executable address to foreign code.
        require_unsafe(&mut c)
        symbol := advance(&mut c); expect(&mut c, ")")
        id := i32(map.get_or(&c.world.functions, symbol, -1))
        if id < 0 || c.world.libraries[id] != "" { fail(&mut c, "callback requires a named Dunder function"); return 0 }
        var params: []i32 = []
        for i in c.world.param_starts[id]..c.world.param_starts[id] + c.world.param_counts[id] {
            ty := c.world.param_types[i]
            if !foreign_scalar(&c, ty) { fail(&mut c, "callbacks require C scalar parameters"); return 0 }
            params.push(ty)
        }
        if c.world.returns[id] != 0 && !foreign_scalar(&c, c.world.returns[id]) { fail(&mut c, "callbacks require a C scalar return"); return 0 }
        if c.code.platform == 3 {
            ty := foreign_type(&mut c, &params, c.world.returns[id])
            c.body.facts.needed.push(id); request_symbol(&mut c, .WasmCallback, id)
            arm.imm(&mut c.code, 0, 0); return ty
        }
        if c.validating_dead { return foreign_type(&mut c, &params, c.world.returns[id]) }
        c.body.facts.needed.push(id); request_symbol(&mut c, .CallbackEntry, id)
        arm.branch(&mut c.code, c.fn_labels[id], 20)
        return foreign_type(&mut c, &params, c.world.returns[id])
    }
    if name == "static_bytes" { covered = true;
        may_invalidate_operand(&mut c) // Exposes mutable storage without a runtime call.
        require_unsafe(&mut c)
        if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "static storage requires a platform literal"); return 0 }
        platform := advance(&mut c); expect(&mut c, ",")
        if c.world.tokens.kinds[c.body.cursor] != .Integer { fail(&mut c, "static storage requires a positive constant size"); return 0 }
        length := rules.literal_integer(advance(&mut c)); expect(&mut c, ")")
        if !length.ok || length.value < 1 || length.value > 16777216 { fail(&mut c, "static byte count must be 1..16777216"); return 0 }
        if platform != "native" && platform != "macos" && platform != "linux" { fail(&mut c, "unknown static storage platform"); return 0 }
        if !c.validating_dead && (c.code.platform == 3 || (platform == "macos" && c.code.platform != 0) || (platform == "linux" && c.code.platform == 0)) {
            fail(&mut c, "static storage requires the selected native platform"); return 0
        }
        static_address(&mut c, .Static, i32(length.value)); arm.mov(&mut c.code, 0, 16); return 13
    }
    if name == "cstr" { covered = true;
        may_invalidate_operand(&mut c)
        require_unsafe(&mut c)
        if c.world.tokens.kinds[c.body.cursor] != .String { fail(&mut c, "cstr needs a string literal"); return 0 }
        value := peek(&c); for i in 0..value.len { if value[i] == 0 { fail(&mut c, "cstr contains an embedded NUL") } }
        var place := 0; var at := -1; var pending := false
        arg := primary_inner(&mut c, 4, &catalog, &mut inline_work, &mut model, &mut place, &mut at, &mut pending); expect(&mut c, ")")
