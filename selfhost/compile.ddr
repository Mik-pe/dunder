    var recorded := false
    if declaration >= 0 { recorded = fragments.record_dependency(&mut c.inline_deps, declaration, estimate) }
    else { recorded = fragments.charge_dependency_words(&mut c.inline_deps, estimate) }
    if !recorded { fail(&mut c, "internal inline dependency admission failure"); return false }
    c.inline_caller_words = c.inline_caller_words - estimate; c.inline_global_words = c.inline_global_words - estimate
    c.bindings.inlined_calls = c.bindings.inlined_calls + 1; c.bindings.inlined_words = c.bindings.inlined_words + actual
