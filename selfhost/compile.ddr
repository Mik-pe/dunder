pub fn compile(source: string) -> Result { compile_for(source, 0) }
pub fn compile_for(source: string, platform: i32) -> Result {
    none: []i32 = []
    compile_modules(source, platform, &none, &none)
}
pub fn compile_modules(source: string, platform: i32, module_starts: &[]i32, module_files: &[]i32) -> Result {
    var ignored := bindings()
    compile_mode(source, platform, &module_starts, &module_files, false, false, &mut ignored)
}
pub fn compile_mode(source: string, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings) -> Result {
    var tokens := lexer.scan(source, false)
    compile_tokens(&mut tokens, platform, &module_starts, &module_files, check_all, report, &mut records)
}
pub fn compile_tokens(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings) -> Result {
    compile_cached(&mut tokens,platform,&module_starts,&module_files,check_all,report,&mut records,"","")
}
pub fn compile_cached(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string) -> Result {
    compile_configured(&mut tokens, platform, &module_starts, &module_files, check_all, report, &mut records, directory, identity, true)
}
pub fn compile_configured(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string, scalar_enabled: bool) -> Result {
    compile_profiled(&mut tokens, platform, &module_starts, &module_files, check_all, report, &mut records, directory, identity, scalar_enabled, -1, false)
}
pub fn compile_profiled(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string, scalar_enabled: bool, profile_host: i32, instrument_runtime: bool) -> Result {
    var config := configuration()
    config.scalar_enabled = scalar_enabled; config.profile_host = profile_host; config.instrument_runtime = instrument_runtime
    compile_options(&mut tokens, platform, &module_starts, &module_files, check_all, report, &mut records, directory, identity, &config)
}
pub fn compile_options(tokens: &mut lexer.Tokens, platform: i32, module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool, records: &mut Bindings, directory: string, identity: string, config: &Configuration) -> Result {
