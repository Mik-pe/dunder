// Native Dunder compiler. Values use eight-byte cells; aggregates have value semantics.
// Primitive IDs: ()=0, i32=1, i64=2, bool=3, string=4, rune=5.
pub struct Imports { globals: i32, libraries: []string, symbols: []string, sites: []i32, slots: []i32 }
fn imports() -> Imports { Imports { globals: 0, libraries: [], symbols: [], sites: [], slots: [] } }
pub struct Bindings {
    reused: i32, emitted: i32, offsets: []i32, names: []string, types: []string,
    modeled: i32, optimized: i32, rewrites: i32, proven_bounds: i32, fallbacks: i32,
    inline_entries: i32, inline_nodes: i32, inline_tokens: i32, inline_units: i32,
    inlined_calls: i32, inlined_words: i32, inline_estimated_words: i32,
    mir_functions: i32, mir_operations: i32, mir_opaque: i32,
    mir_optimization_enabled: bool, mir_source_objects_enabled: bool, mir_private_memory_ops: i32, mir_optimized: i32, mir_promoted: i32,
    mir_removed_loads: i32, mir_removed_stores: i32, mir_analysis_units: i64, mir_budget_refusals: i32,
    mir_values_enabled: bool, mir_values_optimized: i32, mir_value_rewrites: i32, mir_value_deleted: i32, mir_value_immediates: i32, mir_value_analysis_units: i64, mir_value_budget_refusals: i32,
    profile: profile.Profile,
}
pub fn bindings() -> Bindings {
    Bindings { reused: 0, emitted: 0, offsets: [], names: [], types: [],
        modeled: 0, optimized: 0, rewrites: 0, proven_bounds: 0, fallbacks: 0,
        inline_entries: 0, inline_nodes: 0, inline_tokens: 0, inline_units: 0,
        inlined_calls: 0, inlined_words: 0, inline_estimated_words: 0,
        mir_functions: 0, mir_operations: 0, mir_opaque: 0,
        mir_optimization_enabled: false, mir_source_objects_enabled: false, mir_private_memory_ops: 0, mir_optimized: 0, mir_promoted: 0,
        mir_removed_loads: 0, mir_removed_stores: 0, mir_analysis_units: 0, mir_budget_refusals: 0,
        mir_values_enabled: false, mir_values_optimized: 0, mir_value_rewrites: 0, mir_value_deleted: 0, mir_value_immediates: 0, mir_value_analysis_units: 0, mir_value_budget_refusals: 0,
        profile: profile.new(-1) }
}
pub struct Result { ok: bool, error: string, offset: i32, text: []u8, imports: Imports }
pub struct Configuration { scalar_enabled: bool, ownership_enabled: bool, const_div_enabled: bool, frame_free_enabled: bool, range_enabled: bool, inline_enabled: bool, mir_enabled: bool, mir_opt_enabled: bool, mir_memory_enabled: bool, mir_values_enabled: bool, profile_host: i32, instrument_runtime: bool }
pub fn configuration() -> Configuration { Configuration { scalar_enabled: true, ownership_enabled: true, const_div_enabled: true, frame_free_enabled: true, range_enabled: true, inline_enabled: true, mir_enabled: true, mir_opt_enabled: true, mir_memory_enabled: true, mir_values_enabled: true, profile_host: -1, instrument_runtime: false } }
struct Compiler {
    tokens: lexer.Tokens, closes: []i32, block_end: i32, tail: bool, block_depth: i32, cursor: i32, ok: bool, error: string, error_at: i32,
    test_functions: []bool, testing: bool, mutations: []i32, postfix_stop: i32,
    stream_depth: i32, stream_kind: i32,
    validating_dead: bool, report: bool, source_end: i32, bindings: Bindings, param_tokens: []i32,
    functions: map.Map, names: []string, starts: []i32, ends: []i32, returns: []i32,
    param_starts: []i32, param_counts: []i32, param_names: []string, param_types: []i32,
    wasm_abi: wa.Abi, code: arm.Code, fn_labels: []i32, needed: []bool, runtime: runtime.Runtime,
    imports: Imports, libraries: []string, symbols: []string, unsafe_functions: []bool,
    current_owner: i32, opaque_owner: []i32, function_owners: []i32,
    unsafe_capable: bool, unsafe_scope: bool, inline_place: bool, direct_place: bool, c_record: []bool, c_sizes: []i32, c_aligns: []i32,
    ffi_types: []i32, ffi_params: []i32, callback_labels: []i32, has_callbacks: bool,
    type_names: []string, type_kinds: []i32, type_bases: []i32, type_starts: []i32, type_counts: []i32, type_clones: []i32, type_drops: []i32,
    field_names: []string, field_types: []i32, field_values: []i64, payload_starts: []i32, payload_counts: []i32, payload_types: []i32, address: i32, writable: bool, scratch_place: i32, loans: scratch.Loans, scratch_returns: []i32,
    local_names: []string, local_types: []i32, local_slots: []i32, local_scopes: []i32, local_mutable: []bool,
    cleanup: i32, owned_slots: []i32, owned_types: []i32, owner_temps: []bool, owner_elided: []bool, loop_owners: []i32,
    expr_owner: i32, expr_type: i32, array_take: i32,
    mir_enabled: bool, mir_opt_enabled: bool, mir_memory_enabled: bool, mir_values_enabled: bool, scalar_enabled: bool, ownership_enabled: bool, range_enabled: bool, inline_enabled: bool, inline_caller_words: i32, inline_global_words: i32, inline_deps: fragments.Dependencies, scalar_function: bool, lease_starts: []i32, lease_ends: []i32,
    scalar_names: []string, scalar_types: []i32, scalar_tokens: []i32,
    scope: i32, slots: i32, ret_type: i32, depth: i32,
    loop_heads: []i32, loop_ends: []i32,
    strings: []string, string_labels: []i32,
    print_int: i32, print_bool: i32, print_text: i32, write: i32,
    float_source: bool, float_trap: i32, overflow: i32, zero: i32, assertion: i32, io: i32, bounds: i32,
}
fn peek(c: &Compiler) -> string { c.tokens.texts[c.cursor] }
fn is(c: &Compiler, word: string) -> bool { c.tokens.kinds[c.cursor] != .String && c.tokens.kinds[c.cursor] != .Rune && peek(&c) == word }
fn fail(c: &mut Compiler, message: string) { if c.ok { c.ok = false; c.error = message; c.error_at = c.tokens.starts[c.cursor] } }
fn advance(c: &mut Compiler) -> string { value := peek(&c); if c.cursor + 1 < c.tokens.texts.len { c.cursor = c.cursor + 1 }; value }
fn eat(c: &mut Compiler, word: string) -> bool { if is(&c, word) { consumed := advance(&mut c); return true }; false }
fn expect(c: &mut Compiler, word: string) { if !eat(&mut c, word) { fail(&mut c, "expected '" + word + "'") } }
fn separators(c: &mut Compiler) { while c.ok && (is(&c, "\n") || is(&c, ";")) { skipped := advance(&mut c) } }
fn newlines(c: &mut Compiler) { while c.ok && is(&c, "\n") { skipped := advance(&mut c) } }
fn add_type(c: &mut Compiler, name: string, kind: i32, base: i32) -> i32 {
    id := c.type_names.len
    c.opaque_owner.push(-1); c.c_record.push(false); c.c_sizes.push(0); c.c_aligns.push(0)
    c.type_names.push(name); c.type_kinds.push(kind); c.type_bases.push(base)
    c.type_starts.push(0); c.type_counts.push(0); c.type_clones.push(arm.label(&mut c.code)); c.type_drops.push(arm.label(&mut c.code))
    id
}
fn scalar_element(c: &Compiler, ty: i32) -> bool {
    (ty >= 1 && ty <= 13) || c.type_kinds[ty] == 3
}
fn scalar_bytes(c: &Compiler, ty: i32) -> i32 {
    if ty == 3 || ty == 8 { return 1 }
    if ty == 9 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 || c.type_kinds[ty] == 3 { return 4 }
    if c.code.platform == 3 && (ty == 12 || ty == 13 || c.type_kinds[ty] == 8) { return 4 }
    8
}
fn compound(c: &mut Compiler, kind: i32, base: i32) -> i32 {
    if (kind == 4 || kind == 5) && (base == 0 || c.type_kinds[base] == 4 || c.type_kinds[base] == 5) { fail(&mut c, "reference a value type"); return 0 }
    if kind == 1 && !scalar_element(&c, base) { fail(&mut c, "arrays of aggregate elements are not supported by this compiler") }
    for i in 0..c.type_names.len { if c.type_kinds[i] == kind && c.type_bases[i] == base { return i } }
    add_type(&mut c, "", kind, base)
}
fn collection(c: &Compiler, ty: i32) -> bool { c.type_kinds[ty] == 1 || c.type_kinds[ty] == 6 || c.type_kinds[ty] == 10 }
fn length_literal(c: &mut Compiler) -> i32 {
    if c.tokens.kinds[c.cursor] != .Integer { fail(&mut c, "expected nonnegative array length"); return 0 }
    length := parse.integer(advance(&mut c))
    if !length.ok || length.value < 0 || length.value > 1048576 { fail(&mut c, "array length out of range"); return 0 }
    i32(length.value)
}
fn fixed(c: &mut Compiler, base: i32, length: i32) -> i32 {
    if !scalar_element(&c, base) { fail(&mut c, "arrays of aggregate elements are not supported by this compiler") }
    if length > 65536 / scalar_bytes(&c, base) { fail(&mut c, "fixed array exceeds 65536 bytes"); return 0 }
    for i in 0..c.type_names.len {
        if c.type_kinds[i] == 6 && c.type_bases[i] == base && c.type_counts[i] == length { return i }
    }
    ty := add_type(&mut c, "", 6, base); c.type_counts[ty] = length; ty
}
fn type_id(c: &Compiler, name: string) -> i32 {
    for i in 0..c.type_names.len { if c.type_names[i] == name { return i } }
    -1
}
// Function pointers are structural: declarations and annotations share IDs.
fn foreign_type(c: &mut Compiler, args: &[]i32, result: i32) -> i32 { callable_type(&mut c, &args, result, 8) }
fn callable_type(c: &mut Compiler, args: &[]i32, result: i32, kind: i32) -> i32 {
    for ty in args { if kind == 8 && !foreign_scalar(&c, ty) && !c.c_record[ty] { fail(&mut c, "C calls require scalar parameters or a record pointer"); return 0 } }
    if kind == 8 && result != 0 && !foreign_scalar(&c, result) && !c.c_record[result] { fail(&mut c, "C calls require scalar return types"); return 0 }
    for t in 0..c.type_names.len {
        if c.type_kinds[t] == kind && c.type_bases[t] == result && c.type_counts[t] == args.len {
            var equal := true
            for i in 0..args.len { if c.ffi_params[c.type_starts[t] + i] != args[i] { equal = false } }
            if equal { return t }
        }
    }
    t := add_type(&mut c, "", kind, result)
    c.type_starts[t] = c.ffi_params.len; c.type_counts[t] = args.len
    for arg in args { c.ffi_params.push(arg) }
    t
}
fn type_name(c: &mut Compiler) -> i32 {
    if is(&c, "fn") || is(&c, "extern") {
        var kind := 9; if eat(&mut c, "extern") { kind = 8 }; expect(&mut c, "fn"); expect(&mut c, "(")
        var args: []i32 = []
        while c.ok && !is(&c, ")") { v := type_name(&mut c); args.push(v); if !eat(&mut c, ",") { break } }
        expect(&mut c, ")"); var ret := 0
        if eat(&mut c, "->") { ret = type_name(&mut c) }
        return callable_type(&mut c, &args, ret, kind)
    }
    if eat(&mut c, "&") { var kind := 4; if eat(&mut c, "mut") { kind = 5 }; base := type_name(&mut c); return compound(&mut c, kind, base) }
    if eat(&mut c, "[") {
        if eat(&mut c, "]") { base := type_name(&mut c); return compound(&mut c, 1, base) }
        base := type_name(&mut c); expect(&mut c, ";"); length := length_literal(&mut c); expect(&mut c, "]"); return fixed(&mut c, base, length)
    }
    if eat(&mut c, "(") { expect(&mut c, ")"); return 0 }
    name := advance(&mut c); found := type_id(&c, name)
    if found < 0 { fail(&mut c, "unknown type '" + name + "'"); return 0 }
    found
}
fn same(c: &mut Compiler, expected: i32, actual: i32) {
    if expected == actual { return }
    if c.ok { fail(&mut c, "type mismatch: " + c.type_names[expected] + " / " + c.type_names[actual]) }
}
fn field(c: &Compiler, ty: i32, name: string) -> i32 {
    first := c.type_starts[ty]
    for i in first..first + c.type_counts[ty] { if c.field_names[i] == name { return i } }
    -1
}
fn load_mem(c: &mut Compiler, destination: i32, base: i32, offset: i32) { arm.emit(&mut c.code, 4181721088 + i64(offset / 8) * 1024 + i64(base) * 32 + i64(destination)) }
fn store_mem(c: &mut Compiler, source: i32, base: i32, offset: i32) { arm.emit(&mut c.code, 4177526784 + i64(offset / 8) * 1024 + i64(base) * 32 + i64(source)) }
fn address_slot(c: &mut Compiler, index: i32) { arm.address(&mut c.code, index) }
fn save_address(c: &mut Compiler) { c.inline_place = false; c.direct_place = false; c.address = slot(&mut c); arm.store(&mut c.code, c.address, 0) }
// Locals already have stable frame storage. Materialize its address only when
// a borrow, raw address or assignment actually needs it.
fn place_address(c: &mut Compiler, index: i32, direct: bool) {
    if direct { address_slot(&mut c, index) } else { arm.load(&mut c.code, index) }
}
fn load_local(c: &mut Compiler, index: i32, ty: i32) {
    if index < 32 {
        packed := storage_type(&c, ty)
        var opcode: i64 = 4164943872 // LDUR X
        if packed == 3 || packed == 8 { opcode = 943718400 } // LDURB
        else if packed == 9 { opcode = 2017460224 } // LDURH
        else if packed == 1 { opcode = 3095396352 } // LDURSW
        else if packed == 5 || packed == 6 || packed == 10 { opcode = 3091202048 } // LDUR W
        arm.emit(&mut c.code, opcode + i64(-(index + 1) * 8).bit_and(511) * 4096 + 928)
    } else {
        address_slot(&mut c, index); transfer_value(&mut c, ty, 0, 0, true)
    }
}
fn owned(c: &Compiler, ty: i32) -> bool { ty == 4 || collection(&c, ty) || c.type_kinds[ty] == 2 || c.type_kinds[ty] == 7 }
fn copy_value(c: &mut Compiler, ty: i32) {
    if c.type_kinds[ty]==21 || c.type_kinds[ty]==20 {fail(&mut c,"scratch values cannot escape the region");return}
    if ty == 4 || c.type_kinds[ty] == 7 { arm.branch(&mut c.code, c.runtime.retain, 1) }
    else if owned(&c, ty) { arm.branch(&mut c.code, c.type_clones[ty], 1) }
}
// The origin belongs to the complete expression in x0, never to an arbitrary
// nested temporary. Keep recursive aggregate copies until their nested array
// capacities can be preserved without changing the value's observable shape.
fn can_take(c: &Compiler, ty: i32) -> bool {
    if ty == 4 || collection(&c, ty) || c.type_kinds[ty] == 7 || c.c_record[ty] { return true }
    if c.type_kinds[ty] != 2 { return false }
    first := c.type_starts[ty]
    for i in first..first + c.type_counts[ty] {
        field_ty := c.field_types[i]
        if owned(&c, field_ty) && field_ty != 4 && c.type_kinds[field_ty] != 7 { return false }
    }
    true
}
fn take_value(c: &mut Compiler, ty: i32) {
    if c.expr_owner >= 0 && c.expr_type == ty && can_take(&c, ty) {
        if collection(&c, ty) { arm.branch(&mut c.code, c.array_take, 1) }
        arm.store(&mut c.code, c.expr_owner, 31)
    } else { copy_value(&mut c, ty) }
    c.expr_owner = -1; c.expr_type = -1
}
fn drop_value(c: &mut Compiler, ty: i32) {
    if ty == 4 { arm.branch(&mut c.code, c.runtime.release, 1) }
    else if owned(&c, ty) { arm.branch(&mut c.code, c.type_drops[ty], 1) }
}
fn remember_owner(c: &mut Compiler, index: i32, ty: i32, temporary: bool) {
    c.owned_slots.push(index); c.owned_types.push(ty); c.owner_temps.push(temporary); c.owner_elided.push(false)
}
fn clear_owner(c: &mut Compiler, index: i32, ty: i32) {
    arm.load(&mut c.code, index); drop_value(&mut c, ty); arm.store(&mut c.code, index, 31)
}
// Transfer an owned expression into a frame slot, including on loop re-entry.
fn save_owner(c: &mut Compiler, index: i32, ty: i32, temporary: bool) {
    remember_owner(&mut c, index, ty, temporary)
    arm.push(&mut c.code, 0); clear_owner(&mut c, index, ty); arm.pop(&mut c.code, 0); arm.store(&mut c.code, index, 0)
}
fn temporary(c: &mut Compiler, ty: i32) -> i32 {
    c.expr_owner = -1; c.expr_type = -1
    if owned(&c, ty) { index := slot(&mut c); save_owner(&mut c, index, ty, true); c.expr_owner = index; c.expr_type = ty }
    ty
}
fn cleanup_from(c: &mut Compiler, first: i32, only_temps: bool) {
    var i := c.owned_slots.len - 1
    while i >= first {
        if !c.owner_elided[i] && (!only_temps || c.owner_temps[i]) { clear_owner(&mut c, c.owned_slots[i], c.owned_types[i]) }
        i = i - 1
    }
}
// Only the extra binary-operand lease is disposable. The source value or its
// original full-expression temporary remains an owner throughout the RHS.
// Keep slot numbers stable; remove setup and all cleanup of this exact entry.
fn elide_string_operand(c: &mut Compiler, start: i32, end: i32, owner: i32, index: i32) {
    if start < 0 || start >= end || owner < 0 || owner >= c.owned_slots.len {
        fail(&mut c, "internal ownership lease invariant"); return
    }
    if c.owned_slots[owner] != index || c.owned_types[owner] != 4 || !c.owner_temps[owner] || c.owner_elided[owner] {
        fail(&mut c, "internal ownership lease invariant"); return
    }
    if c.lease_ends.len > 0 && start < c.lease_ends[c.lease_ends.len - 1] {
        fail(&mut c, "internal ownership lease ordering"); return
    }
    c.lease_starts.push(start); c.lease_ends.push(end); c.owner_elided[owner] = true
}
fn skip_body(c: &mut Compiler) { expect(&mut c, "{"); c.cursor = c.closes[c.cursor - 1] + 1 }
fn foreign_scalar(c: &Compiler, ty: i32) -> bool { ty == 1 || ty == 2 || (ty >= 6 && ty <= 13) || c.type_kinds[ty] == 8 }
fn valid_foreign_name(value: string) -> bool {
    if value.len == 0 { return false }
    for i in 0..value.len { if value[i] == 0 { return false } }
    true
}
fn source_owner(offset: i32, starts: &[]i32, files: &[]i32) -> i32 {
    var lo := 0; var hi := starts.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if starts[mid] <= offset { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return 0 }; files[lo - 1]
}
fn opaque_access(c: &mut Compiler, ty: i32) {
    if c.opaque_owner[ty] >= 0 && c.opaque_owner[ty] != c.current_owner {
        fail(&mut c, "an opaque struct can only be constructed or opened by its defining module")
    }
}
fn headers(c: &mut Compiler, module_starts: &[]i32, module_files: &[]i32) {
    var stack: []i32 = []
    for i in 0..c.tokens.kinds.len {
        if c.tokens.kinds[i] == .Symbol {
            if c.tokens.texts[i] == "{" { stack.push(i) }
            if c.tokens.texts[i] == "}" { if stack.len == 0 { fail(&mut c, "unexpected closing brace"); return }; open := stack.pop(); c.closes[open] = i }
        }
    }
    if stack.len != 0 { fail(&mut c, "unterminated body"); return }
    // Register every nominal type before parsing fields or function signatures.
    var declarations: []i32 = []; var declaration_types: []i32 = []
    separators(&mut c)
    if eat(&mut c, "capability") {
        expect(&mut c, "unsafe"); c.unsafe_capable = true; separators(&mut c)
    }
    while c.ok && c.tokens.kinds[c.cursor] != .End {
        var library := ""; var symbol := ""; var layout := false; var test := false
        if eat(&mut c, "@") {
            annotation := advance(&mut c)
            if annotation == "extern" {
                expect(&mut c, "(")
                if c.tokens.kinds[c.cursor] != .String { fail(&mut c, "expected an extern library") }
                library = advance(&mut c); expect(&mut c, ",")
                if c.tokens.kinds[c.cursor] != .String { fail(&mut c, "expected an extern symbol") }
                symbol = advance(&mut c); expect(&mut c, ")")
                if !valid_foreign_name(library) || !valid_foreign_name(symbol) { fail(&mut c, "invalid external library or symbol") }
            } else if annotation == "c_layout" { layout = true }
            else if annotation == "test" { test = true }
            else { fail(&mut c, "unknown declaration attribute"); break }
            newlines(&mut c)
            if is(&c, "{") { skip_body(&mut c); separators(&mut c); continue }
        }
        public := eat(&mut c, "pub")
        unchecked := eat(&mut c, "unsafe")
        if unchecked && !c.unsafe_capable { fail(&mut c, "module requires capability unsafe"); break }
        if library != "" && !unchecked { fail(&mut c, "@extern requires unsafe fn"); break }
        opaque := eat(&mut c, "opaque")
        owner := source_owner(c.tokens.starts[c.cursor], &module_starts, &module_files)
        what := advance(&mut c)
        if opaque && what != "struct" { fail(&mut c, "expected opaque struct"); break }
        if what != "fn" && what != "struct" && what != "enum" { fail(&mut c, "expected fn, struct or enum (imports must be loaded first)"); break }
        name := advance(&mut c)
        if (layout && what != "struct") || (unchecked && what != "fn") { fail(&mut c, "invalid declaration attribute"); break }
        declarations.push(c.cursor)
        var ty := -1
        if what != "fn" {
            if type_id(&c, name) >= 0 { fail(&mut c, "duplicate type") }
            var kind := 2; if what == "enum" { kind = 3 }
            ty = add_type(&mut c, name, kind, 0); c.c_record[ty] = layout; if opaque { c.opaque_owner[ty] = owner }
        } else {
            if map.contains(&c.functions, name) || rules.reserved(name) { fail(&mut c, "duplicate or reserved function name") }
            c.function_owners.push(owner); c.test_functions.push(test)
            c.libraries.push(library); c.symbols.push(symbol); c.unsafe_functions.push(unchecked)
            map.put(&mut c.functions, name, i64(c.names.len)); c.names.push(name); c.fn_labels.push(arm.label(&mut c.code)); c.needed.push(false)
        }
        declaration_types.push(ty)
        if library != "" {
            while c.ok && !is(&c, "\n") && !is(&c, ";") && c.tokens.kinds[c.cursor] != .End {
                if is(&c, "{") { fail(&mut c, "external declaration cannot have a body"); break }
                skipped := advance(&mut c)
            }
            separators(&mut c); continue
        }
        while c.ok && !is(&c, "{") { if c.tokens.kinds[c.cursor] == .End { fail(&mut c, "missing declaration body"); break }; skipped := advance(&mut c) }
        if c.ok { skip_body(&mut c); separators(&mut c) }
    }
    for d in 0..declarations.len {
        if !c.ok { break }
        c.cursor = declarations[d]; ty := declaration_types[d]
        if ty >= 0 {
            expect(&mut c, "{"); c.type_starts[ty] = c.field_names.len; separators(&mut c)
            var tag: i64 = 0
            while c.ok && !is(&c, "}") {
                if c.tokens.kinds[c.cursor] != .Name { fail(&mut c, "expected field or variant name"); break }
                name := advance(&mut c); var ft := 0; payload := c.payload_types.len
                if c.type_kinds[ty] == 2 {
                    for prior in c.type_starts[ty]..c.field_names.len {
                        if c.field_names[prior] == name { fail(&mut c, "duplicate struct field '" + name + "'") }
                    }
                    expect(&mut c, ":"); ft = type_name(&mut c)
                    if c.type_kinds[ft] == 4 || c.type_kinds[ft] == 5 { fail(&mut c, "a field cannot store a borrow") }
                }
                else {
                    if eat(&mut c, "(") {
                        c.type_kinds[ty] = 7
                        while c.ok {
                            pt := type_name(&mut c)
                            if pt == 0 || c.type_kinds[pt] == 4 || c.type_kinds[pt] == 5 { fail(&mut c, "invalid payload type") }
                            c.payload_types.push(pt)
                            if !eat(&mut c, ",") { break }
                        }
                        expect(&mut c, ")")
                    }
                    if eat(&mut c, "=") {
                        var sign := ""; if eat(&mut c, "-") { sign = "-" }
                        value := parse.integer(sign + advance(&mut c)); tag = value.value
                        if !value.ok { fail(&mut c, "invalid enum tag") }
                    }
                    if tag < -2147483648 || tag > 2147483647 { fail(&mut c, "enum tag out of range") }
                    for prior in c.type_starts[ty]..c.field_names.len {
                        if c.field_names[prior] == name || c.field_values[prior] == tag { fail(&mut c, "duplicate enum variant or tag") }
                    }
                }
                c.payload_starts.push(payload); c.payload_counts.push(c.payload_types.len - payload)
                c.field_names.push(name); c.field_types.push(ft); c.field_values.push(tag); tag = tag + 1
                if !eat(&mut c, ",") { separators(&mut c); if !is(&c, "}") { fail(&mut c, "expected field comma") } }; separators(&mut c)
            }
            c.type_counts[ty] = c.field_names.len - c.type_starts[ty]
            if c.type_kinds[ty] == 3 && c.type_counts[ty] == 0 { fail(&mut c, "enum requires at least one variant") }
        } else {
            expect(&mut c, "("); first := c.param_names.len
            while c.ok && !is(&c, ")") {
                c.param_tokens.push(c.cursor); parameter := advance(&mut c); expect(&mut c, ":"); pt := type_name(&mut c)
                c.param_names.push(parameter); c.param_types.push(pt)
                if !eat(&mut c, ",") { break }
            }
            expect(&mut c, ")"); c.param_starts.push(first); c.param_counts.push(c.param_names.len - first)
            var ret := 0; if eat(&mut c, "->") { ret = type_name(&mut c); if c.type_kinds[ret] == 4 || c.type_kinds[ret] == 5 { fail(&mut c, "a function cannot return a borrow") } }; c.returns.push(ret)
            f := c.returns.len - 1
            if c.test_functions[f] && (c.param_counts[f] != 0 || ret != 0) { fail(&mut c, "@test function must take no parameters and return ()") }
            if c.libraries[f] != "" {
                var args: []i32 = []
                for p in first..c.param_names.len { args.push(c.param_types[p]) }
                ft := foreign_type(&mut c, &args, ret); c.ffi_types.push(ft)
                if !is(&c,"\n") && !is(&c,";") && c.tokens.kinds[c.cursor] != .End { fail(&mut c,"unexpected token after external declaration") }
                c.starts.push(0); c.ends.push(0); continue
            }
            var ordinary_args: []i32 = []
            for p in first..c.param_names.len { ordinary_args.push(c.param_types[p]) }
            signature := callable_type(&mut c, &ordinary_args, ret, 9); c.ffi_types.push(signature)
            newlines(&mut c); expect(&mut c, "{"); c.starts.push(c.cursor); c.ends.push(c.closes[c.cursor - 1])
            if ret != 0 { newlines(&mut c); if is(&c, "}") { fail(&mut c, "function can finish without returning a value") } }
        }
    }
}
fn slot(c: &mut Compiler) -> i32 {
    result := c.slots; c.slots = c.slots + 1
    if c.slots > 65535 { fail(&mut c, "this compiler stage allows at most 65535 local slots per function") }
    result
}
fn local(c: &Compiler, name: string) -> i32 {
    var i := c.local_names.len - 1
    while i >= 0 { if c.local_names[i] == name { return i }; i = i - 1 }
    -1
}
fn type_spelling(c: &Compiler, ty: i32) -> string {
    kind := c.type_kinds[ty]
    if c.type_names[ty] != "" { return c.type_names[ty] }
    if kind == 8 || kind == 9 {
        var args := ""; for i in 0..c.type_counts[ty] {
            if i > 0 { args = args + ", " }
            args = args + type_spelling(&c, c.ffi_params[c.type_starts[ty] + i])
        }
        var fn_name := "fn"; if kind == 8 { fn_name = "extern fn" }
        return fn_name + "(" + args + ") -> " + type_spelling(&c, c.type_bases[ty])
    }
    if kind == 20 { return "region" }
    base := type_spelling(&c, c.type_bases[ty])
    if kind == 1 || kind == 21 { return "[]" + base }
    if kind == 6 { return "[" + base + "; " + c.type_counts[ty].str() + "]" }
    if kind == 4 { return "&" + base }; if kind == 5 { return "&mut " + base }
    if kind == 10 { return "iter<" + base + ">" }
    base
}
fn bind(c: &mut Compiler, name: string, ty: i32, mutable: bool, index: i32, at: i32) {
    if c.report && at >= 0 && c.tokens.starts[at] < c.source_end {
        c.bindings.offsets.push(c.tokens.starts[at]); c.bindings.names.push(name); c.bindings.types.push(type_spelling(&c, ty))
    }
    if !rules.identifier(name) { fail(&mut c, "this compiler stage supports ASCII identifiers") }
    if rules.reserved(name) { fail(&mut c, "reserved local name") }
    for i in 0..c.local_names.len { if c.local_names[i] == name && c.local_scopes[i] == c.scope { fail(&mut c, "duplicate local name") } }
    c.local_names.push(name); c.local_types.push(ty); c.local_mutable.push(mutable); c.local_slots.push(index); c.local_scopes.push(c.scope)
}
fn enter(c: &mut Compiler) { c.scope = c.scope + 1 }
fn leave(c: &mut Compiler) {
    while c.local_names.len > 0 && c.local_scopes[c.local_scopes.len - 1] == c.scope {
        name := c.local_names.pop(); ty := c.local_types.pop(); mutable := c.local_mutable.pop(); index := c.local_slots.pop(); scope := c.local_scopes.pop()
        if owned(&c, ty) { clear_owner(&mut c, index, ty) }
    }
    c.scope = c.scope - 1
}
fn narrow(c: &mut Compiler) {
    arm.emit(&mut c.code, 2470476802); arm.emit(&mut c.code, 3942776863); arm.branch(&mut c.code, c.overflow, 3)
}
fn float_literal(c: &mut Compiler, spelling: string, expected: i32) -> i32 {
    var ty := 7; if expected == 6 { ty = 6 }
    value := decimal.decode(spelling, ty == 6)
    if !value.ok { fail(&mut c, "floating literal is outside the finite range") }
    arm.imm(&mut c.code, 0, value.bits); ty
}
fn format_float(c: &mut Compiler, ty: i32) {
    if c.validating_dead { return }
    if ty == 6 { arm.imm(&mut c.code, 1, 1) } else { arm.imm(&mut c.code, 1, 0) }
    id := i32(map.get_or(&c.functions, "__dunder_module_format_float_bits", -1))
    if id < 0 { fail(&mut c, "missing floating formatter"); return }
    c.needed[id] = true
    arm.branch(&mut c.code, c.fn_labels[id], 1)
}
fn literal(c: &mut Compiler, spelling: string, expected: i32) -> i32 {
    if floats.has(expected) { return float_literal(&mut c, spelling, expected) }
    if unsigned.has(expected) {
        number := unsigned.literal(spelling, expected)
        if !number.ok { fail(&mut c, "unsigned integer literal out of range"); return expected }
        if c.code.platform == 3 && expected == 12 && (number.value < 0 || number.value > 4294967295) { fail(&mut c, "usize literal exceeds wasm32 pointer width") }
        arm.imm(&mut c.code, 0, number.value)
        return expected
    }
    var value := parse.integer(spelling)
    ty := rules.validate_signed(&mut value, expected)
    if !value.ok { fail(&mut c, "integer literal out of range"); return ty }
    arm.imm(&mut c.code, 0, value.value)
    ty
}
fn intrinsic(c: &mut Compiler, name: string, expected: i32, catalog: &opt_inline.Catalog, inline_work: &mut opt_inline.Workspace) -> i32 {
    var target := -1; var ret := expected
    if name == "__sys_arg_count" { target = c.runtime.sys_arg_count; ret = 1 }
    else if name == "__sys_arg" { target = c.runtime.sys_arg; ret = 4 }
    else if name == "__sys_pid" { target = c.runtime.sys_pid; ret = 1 }
    else if name == "__sys_read_text" { target = c.runtime.sys_read_text }
    else if name == "__sys_metadata" { target = c.runtime.sys_metadata }
    else if name == "__sys_same_file" { target = c.runtime.sys_same_file; ret = 3 }
    else if name == "__sys_write_bytes" || name == "__sys_write_u8" { target = c.runtime.sys_write_bytes }
    else if name == "__sys_make_executable" { target = c.runtime.sys_make_executable }
    else if name == "__sys_rename" { target = c.runtime.sys_rename }
    else if name == "__sys_remove_file" { target = c.runtime.sys_remove_file }
    else if name == "__sys_decode_utf8" || name == "__sys_decode_u8" { target = c.runtime.sys_decode_utf8 }
    else if name == "__sys_write_stderr" { target = c.runtime.sys_stderr }
    else if name == "__sys_write_text" { target = c.runtime.sys_write_text }
    else if name == "__sys_append_text" { target = c.runtime.sys_append_text }
    else if name == "__sys_mkdir" { target = c.runtime.sys_mkdir }
    else if name == "__sys_remove_dir" { target = c.runtime.sys_remove_dir }
    if target < 0 { fail(&mut c, "unsupported intrinsic '" + name + "'"); return 0 }
    var count := 0
    while c.ok && !is(&c, ")") {
        var want := 0
        if (count == 1 && (name == "__sys_write_bytes" || name == "__sys_write_u8")) ||
            (count == 0 && (name == "__sys_decode_utf8" || name == "__sys_decode_u8")) {
            var elem := 1; if name == "__sys_write_u8" || name == "__sys_decode_u8" { elem = 8 }
            array := compound(&mut c, 1, elem); want = compound(&mut c, 4, array)
        }
        ty := expression(&mut c, 0, want, &catalog, &mut inline_work)
        if want != 0 { same(&mut c, want, ty); load_mem(&mut c, 0, 0, 0) }
        arm.push(&mut c.code, 0); count = count + 1
        if !eat(&mut c, ",") { break }
