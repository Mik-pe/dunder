}
fn terminal(c: &Session, after: i32, semicolons: bool) -> bool {
    var pos := after
    while pos < c.world.tokens.texts.len && (c.world.tokens.kinds[pos] == .Newline || (semicolons && c.world.tokens.texts[pos] == ";")) { pos = pos + 1 }
    pos == c.body.block_end
}
// Mirror primary's name resolution at a constructor opening: lexical values
// shadow nominals, and a member name after '.' is not a new primary expression.
// The brace map already balances the constructor, including nested values.
fn condition_constructor(c: &Session, open: i32) -> bool {
    if open == 0 || c.world.tokens.kinds[open - 1] != .Name || c.world.closes[open] < 0 { return false }
    if open > 1 && c.world.tokens.kinds[open - 2] == .Symbol && c.world.tokens.texts[open - 2] == "." { return false }
    name := c.world.tokens.texts[open - 1]
    if local(&c.body, name) >= 0 { return false }
    nominal := type_id(&c, name)
    nominal >= 0 && ft.type_kind(&c.types, nominal) == 2
}
// This lookahead determines structure only. Expression parsing still checks
// all operators, operand types and delimiters and reports source diagnostics.
fn condition_group_end(c: &Session, start: i32, depth: i32) -> i32 {
    if depth > 128 { return c.world.tokens.texts.len }
    var close := ")"; if c.world.tokens.texts[start] == "[" { close = "]" }
    var pos := start + 1
    while pos < c.world.tokens.texts.len {
        if c.world.tokens.kinds[pos] == .End { break }
        if c.world.tokens.kinds[pos] == .Symbol {
            word := c.world.tokens.texts[pos]
            if word == close { return pos + 1 }
            // Braces inside a group belong to its expression.
            if word == "{" && c.world.closes[pos] >= 0 { pos = c.world.closes[pos] + 1; continue }
            if word == "(" || word == "[" { pos = condition_group_end(&c, pos, depth + 1); continue }
            if word == ")" || word == "]" || word == "{" || word == "}" { break }
        }
        pos = pos + 1
    }
    c.world.tokens.texts.len
}
fn condition_body(c: &Session, start: i32, depth: i32) -> i32 {
    if depth > 128 { return c.world.tokens.texts.len }
    var pos := start
    while pos < c.world.tokens.texts.len {
        if c.world.tokens.kinds[pos] == .End { break }
        if c.world.tokens.kinds[pos] == .Keyword && c.world.tokens.texts[pos] == "if" {
            pos = conditional_end_at(&c, pos + 1, depth + 1); continue
        }
        if c.world.tokens.kinds[pos] == .Keyword && c.world.tokens.texts[pos] == "match" {
            pos = match_end(&c, pos + 1, depth + 1); continue
        }
        if c.world.tokens.kinds[pos] == .Symbol {
            word := c.world.tokens.texts[pos]
            if word == "{" {
                if condition_constructor(&c, pos) { pos = c.world.closes[pos] + 1; continue }
                return pos
            }
            if word == "(" || word == "[" { pos = condition_group_end(&c, pos, depth + 1); continue }
            if word == ")" || word == "]" || word == "}" { break }
        }
        pos = pos + 1
    }
    c.world.tokens.texts.len
}
fn match_end(c: &Session, start: i32, depth: i32) -> i32 {
    body := condition_body(&c, start, depth)
    if body >= c.world.tokens.texts.len || c.world.closes[body] < 0 { return c.world.tokens.texts.len - 1 }
    c.world.closes[body] + 1
}
fn continues_expression(c: &Session, pos: i32) -> bool {
    if c.world.tokens.kinds[pos] != .Symbol { return false }
    next := c.world.tokens.texts[pos]
    rules.precedence(next) != 0 || next == ".." || next == "." || next == "[" || next == "("
}
fn conditional_end(c: &Session, start: i32) -> i32 {
    conditional_end_at(&c, start, 0)
}
fn conditional_end_at(c: &Session, start: i32, depth: i32) -> i32 {
    if depth > 128 { return c.world.tokens.texts.len - 1 }
    var pos := start
    while pos < c.world.tokens.texts.len {
        pos = condition_body(&c, pos, depth)
        if pos >= c.world.tokens.texts.len || c.world.closes[pos] < 0 { return c.world.tokens.texts.len - 1 }
        after := c.world.closes[pos] + 1
        pos = after
        while pos < c.world.tokens.texts.len && c.world.tokens.kinds[pos] == .Newline { pos = pos + 1 }
        if pos >= c.world.tokens.texts.len || c.world.tokens.kinds[pos] != .Keyword || c.world.tokens.texts[pos] != "else" { return after }
        pos = pos + 1
        if pos < c.world.tokens.texts.len && c.world.tokens.kinds[pos] == .Keyword && c.world.tokens.texts[pos] == "if" { pos = pos + 1; continue }
        if pos < c.world.tokens.texts.len && c.world.tokens.kinds[pos] == .Symbol && c.world.tokens.texts[pos] == "{" && c.world.closes[pos] >= 0 { return c.world.closes[pos] + 1 }
        return pos
    }
    c.world.tokens.texts.len - 1
}
fn end_statement(c: &mut Session) {
    if c.ok && !is(&c, "\n") && !is(&c, ";") && !is(&c, "}") && c.world.tokens.kinds[c.body.cursor] != .End { fail(&mut c, "expected newline or semicolon") }
}
fn conditional(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    c.body.depth = c.body.depth + 1
    if c.body.depth > 128 { fail(&mut c, "conditional nesting exceeds 128"); c.body.depth = c.body.depth - 1; return false }
    result := conditional_inner(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
    c.body.depth = c.body.depth - 1
    result
}
fn conditional_inner(c: &mut Session, tail_allowed: bool, catalog: &opt_inline.View, inline_work: &mut opt_inline.Workspace, model: &mut opt_ir.Function) -> bool {
    at := c.body.cursor - 1
    var cond_end := c.body.cursor
    folded := eval_target_or(&c, c.body.cursor, &mut cond_end)
    if folded >= 0 && cond_end < c.world.tokens.kinds.len && tok_is(&c, cond_end, "{") {
        c.body.cursor = cond_end
        if folded == 1 {
            taken := block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
            newlines(&mut c)
            if eat(&mut c, "else") {
                if eat(&mut c, "if") { c.body.cursor = conditional_end(&c, c.body.cursor) }
                else { skip_body(&mut c) }
            }
            return taken
        }
        skip_body(&mut c)
        newlines(&mut c)
        if eat(&mut c, "else") {
            if eat(&mut c, "if") { return conditional(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model) }
            return block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
        }
        if model.recording { _ := typed.node(&mut model, 10, 0, -1, -1, -1, 0, -1, at) }
        return false
    }
    condition_at := c.body.cursor; ty := expression(&mut c, 0, 3, &catalog, &mut inline_work, &mut model); same(&mut c, 3, ty)
    condition := model.value
    otherwise := new_block(&mut c); done := new_block(&mut c)
    source_edge(&mut c, otherwise, .WhenFalse, condition_at)
    left := block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model); source_edge(&mut c, done, .Jump, c.body.cursor); bind_block(&mut c, otherwise)
    yes := model.value
    newlines(&mut c)
    var right := false; var no := -1
    if eat(&mut c, "else") {
        if eat(&mut c, "if") {
            right = conditional(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model)
            if model.recording { no = typed.node(&mut model, 10, 0, model.value, -1, -1, 0, -1, at) }
        } else { right = block(&mut c, tail_allowed, &catalog, &mut inline_work, &mut model); no = model.value }
    }
    if model.recording { _ := typed.node(&mut model, 13, 0, condition, yes, no, 0, -1, at) }
    bind_block(&mut c, done)
