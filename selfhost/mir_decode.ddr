// Scalar instruction semantics for the transitional MIR adapter. One reusable
// Decoded record serves an entire function; decoding never allocates per op.
// Machine width and contextual GP register31 roles are explicit here.
import mir
import mir_abi as abi

pub struct Decoded {
    kind: i32, opcode: i32, dst: i32, a: i32, b: i32, c: i32,
    imm: i64, aux: i32, variant: i64, types: i32, extension: i32,
    effects: i32, flags: i32, abi: i32,
    reads: i64, writes: i64, clobbers: i64,
    place_kind: i32, place_offset: i32, place_width: i32,
    unknown_control: bool,
}
pub fn new() -> Decoded { Decoded {
    kind: 0, opcode: 0, dst: -1, a: -1, b: -1, c: -1, imm: 0,
    aux: 0, variant: 0, types: 0, extension: 0, effects: 0, flags: 0,
    abi: 0, reads: 0, writes: 0, clobbers: 0,
    place_kind: -1, place_offset: 0, place_width: 0, unknown_control: false } }
pub fn reset(d: &mut Decoded) {
    d.kind = 0; d.opcode = 0; d.dst = -1; d.a = -1; d.b = -1; d.c = -1
    d.imm = 0; d.aux = 0; d.variant = 0; d.types = 0; d.extension = 0
    d.effects = 0; d.flags = 0; d.abi = 0; d.reads = 0; d.writes = 0; d.clobbers = 0
    d.place_kind = -1; d.place_offset = 0; d.place_width = 0; d.unknown_control = false
}
fn opaque(d: &mut Decoded) {
    d.kind = 0; d.effects = 255; d.flags = 3; d.abi = 4
    d.reads = -1; d.writes = -1; d.clobbers = -1; d.unknown_control = true
}
fn bits(word: i64, shift: i32, mask: i64) -> i32 { i32(word.shr(shift).bit_and(mask)) }
fn variable(d: &mut Decoded, destination: i32, left: i32, right: i32) {
    d.dst = destination; d.a = left; d.b = right
    d.reads = mir.variable_bit(left).bit_or(mir.variable_bit(right))
    d.writes = mir.variable_bit(destination)
}
fn zero_registers(d: &mut Decoded) {
    if d.dst == 31 { d.dst = -1; d.writes = 0 }
    if d.a == 31 { d.a = -1 }
    if d.b == 31 { d.b = -1 }
    if d.c == 31 { d.c = -1 }
    d.reads = mir.variable_bit(d.a).bit_or(mir.variable_bit(d.b)).bit_or(mir.variable_bit(d.c))
}
fn call(d: &mut Decoded, abi: i32) {
    d.kind = 14; d.abi = abi; d.effects = 95; d.flags = 2
    // Internal runtime allocator state is not the ordinary C callee-save set.
    // x18 and x19..24 are reserved throughout the common backend.
    d.reads = -1; d.writes = 0; d.clobbers = -1
}
fn floating(d: &mut Decoded, word: i64) -> bool {
    rd := bits(word, 0, 31); rn := bits(word, 5, 31); rm := bits(word, 16, 31)
    kind := word.bit_and(4294966272); key := word.bit_and(4280351744); unary := word.bit_and(4290771968)
    var opcode := 0; var destination := rd + 32; var left := rn + 32; var right := -1
    if kind == 505872384 || kind == 2657550336 { opcode = 9; left = rn }
    else if kind == 505806848 || kind == 2657484800 { opcode = 10; destination = rd }
    else if key == 505423872 { opcode = 1; right = rm + 32 }
    else if key == 505427968 { opcode = 2; right = rm + 32 }
    else if key == 505415680 { opcode = 3; right = rm + 32 }
    else if key == 505419776 { opcode = 4; right = rm + 32 }
    else if word.bit_and(4280351775) == 505421824 { opcode = 5; destination = -1; right = rm + 32 }
    else if unary == 505462784 { opcode = 6 }
    else if unary == 505495552 { opcode = 7 }
    else if unary == 505528320 { opcode = 8 }
    else if kind == 509755392 || kind == 505593856 { opcode = 11 }
    else if unary == 2653028352 { opcode = 12; left = rn }
    else if unary == 2653093888 { opcode = 13; left = rn }
    else if unary == 2654470144 { opcode = 14; destination = rd }
    else if unary == 2654535680 { opcode = 15; destination = rd }
    else if unary == 505790464 { opcode = 16 }
    else if unary == 505757696 { opcode = 17 }
    else if unary == 505724928 { opcode = 18 }
    else if unary == 505823232 { opcode = 19 }
    else if unary == 505692160 { opcode = 20 }
    if opcode == 0 { return false }
    // Architectural register 31 is ZR only on the GP side of transfers and
    // conversions. V31 remains an ordinary floating register.
    if (opcode == 9 || opcode == 12 || opcode == 13) && left == 31 { left = -1 }
    if (opcode == 10 || opcode == 14 || opcode == 15) && destination == 31 { destination = -1 }
    d.kind = 19; d.opcode = opcode; variable(&mut d, destination, left, right)
    d.types = 5; if bits(word, 22, 1) != 0 { d.types = 6 }
    if opcode == 5 { d.flags = 2 }
    if opcode == 14 || opcode == 15 { d.effects = 1 }
    true
}
fn memory(d: &mut Decoded, word: i64) -> bool {
    scaled := word.bit_and(989855744) == 956301312
    if !scaled && word.bit_and(991955968) != 939524096 { return false }
    size := bits(word, 30, 3); transfer := bits(word, 22, 3)
    if transfer > 2 || (transfer == 2 && size != 2) { return false }
    // SIMD memory instructions are handled by the float vocabulary below.
    if bits(word, 26, 1) != 0 { return false }
    reg := bits(word, 0, 31); base := bits(word, 5, 31)
    var offset := bits(word, 12, 511); if offset >= 256 { offset = offset - 512 }
    if scaled { offset = bits(word, 10, 4095).shl(size) }
    var kind := 7; if transfer == 0 { kind = 8 }
    d.kind = kind; d.imm = i64(offset); d.aux = i32(1).shl(size)
    d.types = 2; if size < 3 && transfer != 2 { d.types = 1 }
    var extension := 0; if transfer == 1 && size < 3 { extension = 1 }; if transfer == 2 { extension = 2 }
    d.extension = extension
    var place_kind := 0; if base == 29 { place_kind = 1 }; if base == 31 { place_kind = 2 }
    d.place_kind = place_kind; d.place_offset = offset; d.place_width = i32(1).shl(size)
    if kind == 7 {
        variable(&mut d, reg, base, -1); d.effects = 3
        if reg == 31 { d.dst = -1; d.writes = 0 }
    } else {
        variable(&mut d, -1, reg, base); d.effects = 5
        if reg == 31 { d.a = -1; d.reads = mir.variable_bit(base) }
    }
    true
}
pub fn word(d: &mut Decoded, word: i64, platform: i32) {
    reset(&mut d)
    rd := bits(word, 0, 31); rn := bits(word, 5, 31); rm := bits(word, 16, 31)
    d.variant = word; d.types = 2; if bits(word, 31, 1) == 0 { d.types = 1 }
    if word == 3573751839 { d.kind = 18; return }
    if word == 3596551104 {
        d.kind = 15; d.opcode = 1; d.abi = 1; d.effects = 16
        d.a = abi.internal_return_value(); d.b = abi.internal_return_target(); d.c = abi.internal_return_stack()
        d.reads = abi.internal_return_reads(); return
    }
    if word == 3558866944 { d.kind = 20; d.effects = 17; return }
    if word.bit_and(4292870175) == 3556769793 { call(&mut d, 3); return }
    if word.bit_and(4294966303) == 3594452992 { call(&mut d, 1); d.a = rn; return }
    family := bits(word, 24, 255)
    if family == 251 || family == 252 || family == 254 {
        call(&mut d, 2)
        // The native x86 foreign-call adapter fetches its function address
        // from logical X17; this is a real input, not an unobserved scratch.
        if family == 254 { d.a = 17 }
        // Wasm's typed foreign dispatch reads its table target from logical
        // X16. On x86 the exact FB word is a callback-return adapter instead.
        if family == 251 && platform == 3 { d.a = 16 }
        return
    }
    // Explicit expression stack units; a push is 16 bytes even though one
    // scalar register is stored. FP/LR frame setup has a separate ABI contract.
    if word.bit_and(4294967264) == 2847899616 {
        d.kind = 10; variable(&mut d, 31, rd, 31)
        if rd == 31 { d.a = -1 }
        d.imm = -16; d.effects = 36
        d.place_kind = 2; d.place_offset = -16; d.place_width = 8; return
    }
    if word.bit_and(4294967264) == 2831253472 {
        d.kind = 11; variable(&mut d, rd, 31, -1)
        if rd == 31 { d.dst = -1 }
        d.writes = d.writes.bit_or(mir.variable_bit(31)); d.imm = 16; d.effects = 34
        d.place_kind = 2; d.place_offset = 0; d.place_width = 8; return
    }
    if word == 2847898621 || word == 2831252477 {
        d.kind = 21; d.opcode = 1; d.imm = -16; d.abi = 1; d.effects = 36
        d.dst = 31; d.a = 29; d.b = 30; d.c = 31
        d.reads = mir.variable_bit(31).bit_or(mir.variable_bit(29)).bit_or(mir.variable_bit(30))
        d.writes = mir.variable_bit(31)
        if word == 2831252477 {
            d.opcode = 2; d.imm = 16; d.effects = 34; d.writes = d.reads
            d.reads = mir.variable_bit(31); d.a = 31; d.b = -1; d.c = -1
        }
        return
    }
    wide_family := word.bit_and(2139095040)
    if wide_family == 1384120320 || wide_family == 1920991232 {
        d.kind = 1; variable(&mut d, rd, -1, -1)
        shift := 16 * bits(word, 21, 3); d.imm = i64(bits(word, 5, 65535)).shl(shift); d.aux = shift
        if wide_family == 1920991232 { d.kind = 3; d.opcode = 3; d.a = rd; d.reads = mir.variable_bit(rd) }
        if rd == 31 { d.dst = -1; d.a = -1; d.reads = 0; d.writes = 0 }
        return
    }
    // ORR Wd/WZR/Wm and Xd/XZR/Xm are width-specific value copies.
    // Ignore only SF here; types still records W zero-extension versus X64.
    if word.bit_and(2145452000) == 704644064 {
        d.kind = 2; variable(&mut d, rd, rm, -1); zero_registers(&mut d)
        if rm == 31 { d.kind = 1 }; return
    }
    if word.bit_and(520093696) == 285212672 {
        d.kind = 4; variable(&mut d, rd, rn, -1)
        d.opcode = 1; if bits(word, 30, 1) != 0 { d.opcode = 2 }
        d.imm = i64(bits(word, 10, 4095)).shl(bits(word, 22, 1) * 12)
        if bits(word, 29, 1) != 0 {
            d.flags = 2
            if rd == 31 { d.kind = 5; d.dst = -1; d.writes = 0 }
        } else if rd == 31 || (rn == 31 && rd == 29) { d.kind = 16; d.effects = 32 }
        return
    }
    arithmetic := word.bit_and(522190848) == 184549376
    logical := word.bit_and(520093696) == 167772160
    if arithmetic || logical {
        d.kind = 4; variable(&mut d, rd, rn, rm)
        d.aux = bits(word, 10, 63) + bits(word, 22, 3) * 64
        if arithmetic {
            d.opcode = 1; if bits(word, 30, 1) != 0 { d.opcode = 2 }
        } else {
            operation := bits(word, 29, 3)
            d.opcode = 8
            if operation == 1 { d.opcode = 9 }; if operation == 2 { d.opcode = 10 }
            if bits(word, 21, 1) != 0 { d.opcode = d.opcode + 3 }
        }
        if rn == 31 { d.a = -1; d.reads = mir.variable_bit(rm) }
        if rm == 31 { d.b = -1; d.reads = mir.variable_bit(d.a) }
        if arithmetic && bits(word, 29, 1) != 0 { d.flags = 2 }
        if logical && bits(word, 29, 3) == 3 { d.flags = 2 }
        if rd == 31 { d.dst = -1; d.writes = 0; if d.flags == 2 { d.kind = 5 } }
        return
    }
    if wide_family == 318767104 || wide_family == 1392508928 {
        d.kind = 3; variable(&mut d, rd, rn, -1)
        d.opcode = 1; if wide_family == 1392508928 { d.opcode = 2 }
        d.aux = bits(word, 16, 63) + bits(word, 10, 63) * 64; zero_registers(&mut d); return
    }
    if word.bit_and(520093696) == 452984832 {
        d.kind = 4; variable(&mut d, rd, rn, rm)
        ra := bits(word, 10, 31)
        family := bits(word, 21, 7)
        if family == 2 { d.opcode = 4 }
        else if family == 6 { d.opcode = 5 }
        else if family == 0 {
            d.opcode = 3
            if ra != 31 {
                d.c = ra; d.reads = d.reads.bit_or(mir.variable_bit(ra)); d.opcode = 17
                if bits(word, 15, 1) != 0 { d.opcode = 18 }
            } else if bits(word, 15, 1) != 0 { d.opcode = 18 }
        } else { opaque(&mut d); return }
        zero_registers(&mut d)
        return
    }
    if word.bit_and(534773760) == 448790528 {
        operation := bits(word, 10, 63)
        d.kind = 4; variable(&mut d, rd, rn, rm)
        if operation == 2 { d.opcode = 7 }
        else if operation == 3 { d.opcode = 6 }
        else if operation >= 8 && operation <= 10 { d.opcode = 14 + operation - 8 }
        else { opaque(&mut d); return }
        if d.opcode == 6 || d.opcode == 7 { d.effects = 1 }
        zero_registers(&mut d); return
    }
    if word.bit_and(4294905824) == 2594113504 {
        d.kind = 6; variable(&mut d, rd, -1, -1); d.flags = 1
        if rd == 31 { d.dst = -1; d.writes = 0 }
        d.imm = i64(bits(word, 12, 15).bit_xor(1)); return
    }
    if memory(&mut d, word) { return }
    if floating(&mut d, word) { return }
    opaque(&mut d)
}

pub fn decode_into(d: &mut Decoded, value: i64, platform: i32) { word(&mut d, value, platform) }

// Symbolic records contain placeholders. Their target/import ID is authoritative
// relocation metadata and is reconstructed by lowering, not encoded in raw.
pub fn symbolic(d: &mut Decoded, reloc: i32) -> bool {
    reset(&mut d)
    if reloc < 0 || reloc > 20 { return false }
    if reloc == 1 { call(&mut d, 1) }
    else if reloc == 20 { d.kind = 9; d.dst = 0; d.writes = 1 }
    else {
        d.kind = 12; d.effects = 16
        if reloc >= 2 {
            d.kind = 13
            if reloc == 18 || reloc == 19 {
                d.a = 0; d.reads = 1; d.opcode = 2
                if reloc == 19 { d.opcode = 3 }
            } else { d.flags = 1; d.opcode = 1; d.imm = i64(reloc - 2) }
        }
    }
    true
}
pub fn imported(d: &mut Decoded, first: i64) -> bool {
    reset(&mut d)
    if first != 0 && first != 4244635648 { return false }
    d.kind = 17; d.dst = 16; if first == 4244635648 { d.dst = 0 }
    d.writes = mir.variable_bit(d.dst); true
}

fn immediate_end(raw: &[]i64, first: i32, end: i32, reg: i32, value: i64) -> i32 {
    if first >= end || raw[first] != 3531603968 + value.bit_and(65535) * 32 + i64(reg) { return -1 }
    var at := first + 1
    for part in 1..4 {
        value_part := value.shr(part * 16).bit_and(65535)
        if value_part != 0 {
            if at >= end || raw[at] != 4068474880 + i64(part) * 2097152 + value_part * 32 + i64(reg) { return -1 }
            at = at + 1
        }
    }
    at
}
pub fn valid_frame_encoding(raw: &[]i64, first: i32, end: i32, kind: i32, slot: i32, reg: i32) -> bool {
    if first < 0 || end <= first || end > raw.len || kind < 1 || kind > 3 ||
        slot < 0 || slot > 268435454 || reg < 0 || reg > 31 || (kind == 3 && reg == 31) { return false }
    if kind == 3 {
        if slot < 511 { return end == first + 1 && raw[first] == 3506439072 + i64(slot + 1) * 8192 + i64(reg) }
        at := immediate_end(&raw, first, end, reg, i64(slot + 1) * 8)
        return at >= 0 && at + 1 == end && raw[at] == 3405775776 + i64(reg) * 65537
    }
    if slot < 32 {
        var base: i64 = 4164944800; if kind == 2 { base = 4160750496 }
        return end == first + 1 && raw[first] == base + i64(-(slot + 1) * 8).bit_and(511) * 4096 + i64(reg)
    }
    var at := first
    if slot < 511 {
        if raw[at] != 3506439081 + i64(slot + 1) * 8192 { return false }
        at = at + 1
    } else {
        at = immediate_end(&raw, first, end, 9, i64(slot + 1) * 8)
        if at < 0 || at >= end || raw[at] != 3406365609 { return false }
        at = at + 1
    }
    var base: i64 = 4181721376; if kind == 2 { base = 4177527072 }
    at + 1 == end && raw[at] == base + i64(reg)
}
pub fn frame(d: &mut Decoded, kind: i32, slot: i32, reg: i32, width: i32) {
    reset(&mut d)
    if kind == 2 && slot >= 32 && reg == 9 { opaque(&mut d); return }
    d.kind = 7; if kind == 2 { d.kind = 8 }; if kind == 3 { d.kind = 9 }
    d.types = 2; d.aux = 8; d.imm = i64(-(slot + 1) * 8)
    d.place_kind = 1; d.place_offset = -(slot + 1) * 8; d.place_width = 8
    if kind == 1 { variable(&mut d, reg, 29, -1); d.effects = 3 }
    else if kind == 2 { variable(&mut d, -1, reg, 29); d.effects = 5 }
    else { variable(&mut d, reg, 29, -1); d.effects = 128 }
    if kind != 3 { zero_registers(&mut d) }
    if kind != 3 && width > 1 {
        d.writes = d.writes.bit_or(mir.variable_bit(9)); d.clobbers = mir.variable_bit(9)
    }
}

// One write of each semantic column. Retained encoding provenance is appended
// by the adapter separately, and is never inferred from mutable semantics.
pub fn append_into(d: &Decoded, f: &mut mir.Function, op: i32) {
    f.kinds[op] = d.kind; f.opcodes[op] = d.opcode
    f.dst[op] = d.dst; f.a[op] = d.a; f.b[op] = d.b; f.c[op] = d.c
    f.imm[op] = d.imm; f.aux[op] = d.aux; f.variant[op] = d.variant
    f.types[op] = d.types; f.extensions[op] = d.extension
    f.effects[op] = d.effects; f.flags[op] = d.flags; f.abi[op] = d.abi
    f.reads[op] = d.reads; f.writes[op] = d.writes; f.clobbers[op] = d.clobbers
    if d.place_kind >= 0 {
        place := mir.add_place(&mut f, d.place_kind, d.place_offset, d.place_width, d.extension)
        f.place[op] = place
        if d.kind == 9 { f.place_escaped[place] = true }
    }
    if d.unknown_control { f.optimizable = false; f.unknown_control = true }
}
