// Transitional adapter from the shared instruction vocabulary. Every word is
// represented; unknown vocabulary is an ordered opaque function barrier.
// Canonical operations and operands live in mir, never in this decoder.
import arm64 as arm
import mir

fn bits(word: i64, shift: i32, mask: i64) -> i32 { i32(word.shr(shift).bit_and(mask)) }
fn variable(f: &mut mir.Function, op: i32, destination: i32, left: i32, right: i32) {
    f.dst[op] = destination; f.a[op] = left; f.b[op] = right
    f.reads[op] = mir.variable_bit(left).bit_or(mir.variable_bit(right))
    f.writes[op] = mir.variable_bit(destination)
}
fn call(f: &mut mir.Function, op: i32, abi: i32) {
    f.kinds[op] = 14; f.abi[op] = abi; f.effects[op] = 95; f.flags[op] = 2
    // Internal runtime allocator state is not the ordinary C callee-save set.
    // x18 and x19..24 are reserved throughout the common backend.
    f.reads[op] = -1; f.writes[op] = -1
}
fn memory(f: &mut mir.Function, op: i32, word: i64) -> bool {
    scaled := word.bit_and(989855744) == 956301312
    if !scaled && word.bit_and(991955968) != 939524096 { return false }
    size := bits(word, 30, 3); transfer := bits(word, 22, 3)
    if transfer > 2 || (transfer == 2 && size != 2) { return false }
    // SIMD memory instructions are handled by the float vocabulary below.
    if bits(word, 26, 1) != 0 { return false }
    reg := bits(word, 0, 31); base := bits(word, 5, 31)
    var offset := bits(word, 12, 511); if offset >= 256 { offset = offset - 512 }
    if scaled { offset = bits(word, 10, 4095).shl(size) }
    var kind := 7; if transfer == 0 { kind = 8 }
    f.kinds[op] = kind; f.imm[op] = i64(offset); f.aux[op] = i32(1).shl(size)
    f.types[op] = 2; if size < 3 { f.types[op] = 1 }
    var extension := 0; if transfer == 1 && size < 3 { extension = 1 }; if transfer == 2 { extension = 2 }
    var place_kind := 0; if base == 29 { place_kind = 1 }; if base == 31 { place_kind = 2 }
    place := mir.add_place(&mut f, place_kind, offset, i32(1).shl(size), extension); f.place[op] = place
    if kind == 7 {
        variable(&mut f, op, reg, base, -1); f.effects[op] = 2
    } else {
        variable(&mut f, op, -1, reg, base); f.effects[op] = 4
    }
    true
}
fn decode(f: &mut mir.Function, op: i32, word: i64) {
    rd := bits(word, 0, 31); rn := bits(word, 5, 31); rm := bits(word, 16, 31)
    f.variant[op] = word; f.types[op] = 2; if bits(word, 31, 1) == 0 { f.types[op] = 1 }
    if word == 3573751839 { f.kinds[op] = 18; return }
    if word == 3596551104 {
        f.kinds[op] = 15; f.effects[op] = 16; f.reads[op] = mir.variable_bit(30); return
    }
    if word == 3558866944 { f.kinds[op] = 20; f.effects[op] = 17; return }
    if word.bit_and(4292870175) == 3556769793 { call(&mut f, op, 3); return }
    if word.bit_and(4294966303) == 3594452992 { call(&mut f, op, 1); f.a[op] = rn; return }
    family := bits(word, 24, 255)
    if family == 251 || family == 252 || family == 254 { call(&mut f, op, 2); return }
    // Explicit expression stack units; a push is 16 bytes even though one
    // scalar register is stored. FP/LR frame setup has a separate ABI contract.
    if word.bit_and(4294967264) == 2847899616 {
        f.kinds[op] = 10; variable(&mut f, op, 31, rd, 31)
        f.imm[op] = -16; f.effects[op] = 36
        place := mir.add_place(&mut f, 2, -16, 8, 0); f.place[op] = place; return
    }
    if word.bit_and(4294967264) == 2831253472 {
        f.kinds[op] = 11; variable(&mut f, op, rd, 31, -1)
        f.writes[op] = f.writes[op].bit_or(mir.variable_bit(31)); f.imm[op] = 16; f.effects[op] = 34
        place := mir.add_place(&mut f, 2, 0, 8, 0); f.place[op] = place; return
    }
    if word == 2847898621 || word == 2831252477 {
        f.kinds[op] = 21; f.abi[op] = 1; f.effects[op] = 36
        f.reads[op] = mir.variable_bit(31).bit_or(mir.variable_bit(29)).bit_or(mir.variable_bit(30))
        f.writes[op] = mir.variable_bit(31)
        if word == 2831252477 { f.effects[op] = 34; f.writes[op] = f.reads[op] }
        return
    }
    wide_family := word.bit_and(2139095040)
    if wide_family == 1384120320 || wide_family == 1920991232 {
        f.kinds[op] = 1; variable(&mut f, op, rd, -1, -1)
        shift := 16 * bits(word, 21, 3); f.imm[op] = i64(bits(word, 5, 65535)).shl(shift); f.aux[op] = shift
        if wide_family == 1920991232 { f.kinds[op] = 3; f.a[op] = rd; f.reads[op] = mir.variable_bit(rd) }
        return
    }
    // ORR Xd,XZR,Xm is an actual mutable-variable copy. XZR is not SP.
    if word.bit_and(4292936672) == 2852127712 {
        f.kinds[op] = 2; variable(&mut f, op, rd, rm, -1); return
    }
    if word.bit_and(520093696) == 285212672 {
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, -1)
        f.imm[op] = i64(bits(word, 10, 4095)).shl(bits(word, 22, 1) * 12)
        if bits(word, 30, 1) != 0 { f.imm[op] = -f.imm[op] }
        if bits(word, 29, 1) != 0 {
            f.flags[op] = 2
            if rd == 31 { f.kinds[op] = 5; f.dst[op] = -1; f.writes[op] = 0 }
        } else if rd == 31 || (rn == 31 && rd == 29) { f.kinds[op] = 16 }
        return
    }
    arithmetic := word.bit_and(522190848) == 184549376
    logical := word.bit_and(520093696) == 167772160
    if arithmetic || logical {
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, rm)
        if rn == 31 { f.a[op] = -1; f.reads[op] = mir.variable_bit(rm) }
        if rm == 31 { f.b[op] = -1; f.reads[op] = mir.variable_bit(f.a[op]) }
        if arithmetic && bits(word, 29, 1) != 0 { f.flags[op] = 2 }
        if logical && bits(word, 29, 3) == 3 { f.flags[op] = 2 }
        if rd == 31 { f.dst[op] = -1; f.writes[op] = 0; if f.flags[op] == 2 { f.kinds[op] = 5 } }
        return
    }
    if wide_family == 318767104 || wide_family == 1392508928 {
        f.kinds[op] = 3; variable(&mut f, op, rd, rn, -1); return
    }
    if word.bit_and(520093696) == 452984832 {
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, rm)
        ra := bits(word, 10, 31)
        if bits(word, 21, 7) == 0 && ra != 31 { f.c[op] = ra; f.reads[op] = f.reads[op].bit_or(mir.variable_bit(ra)) }
        return
    }
    if word.bit_and(534773760) == 448790528 {
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, rm); return
    }
    if word.bit_and(4294905824) == 2594113504 {
        f.kinds[op] = 6; variable(&mut f, op, rd, -1, -1); f.flags[op] = 1; return
    }
    if memory(&mut f, op, word) { return }
    // The adapter keeps floating operations ordered and exposes their exact
    // register bank. Their full arithmetic semantics remain in variant.
    if word.bit_and(1593835520) == 503316480 {
        f.kinds[op] = 19; f.dst[op] = rd + 32; f.a[op] = rn + 32; f.b[op] = rm + 32
        f.reads[op] = -1; f.writes[op] = -1; f.effects[op] = 128
        f.optimizable = false; return
    }
    mir.opaque(&mut f, op)
}
fn record(f: &mut mir.Function, code: &arm.Code, at: i32, width: i32) -> i32 {
    op := mir.add(&mut f, 0); f.origins[op] = at; f.raw_starts[op] = f.raw.len
    f.widths[op] = width; f.modes[op] = 0
    f.boundaries[at - f.first_word] = op
    for i in 0..width { f.raw.push(code.words[at + i]) }
    op
}
fn local_target(f: &mir.Function, code: &arm.Code, target: i32) -> i32 {
    if target < 0 || target >= code.labels.len { return -1 }
    word := code.labels[target]
    if word < f.first_word || word > f.source_words { return -1 }
    mir.boundary(&f, word)
}
fn graph(f: &mut mir.Function, code: &arm.Code) -> bool {
    count := f.order.len
    for i in 0..count + 1 { f.leaders.push(false) }
    f.leaders[0] = true; f.leaders[count] = true
    for i in 0..f.label_ops.len { if f.label_ops[i] >= 0 { f.leaders[f.label_ops[i]] = true } }
    for op in 0..count {
        kind := f.kinds[op]
        if kind == 12 || kind == 13 {
            target := local_target(&f, &code, f.targets[op])
            if target >= 0 { f.leaders[target] = true }
        }
        if kind == 0 || kind == 12 || kind == 13 || kind == 15 || kind == 20 { f.leaders[op + 1] = true }
    }
    var first := 0
    for end in 1..count + 1 {
        if !f.leaders[end] { continue }
        block := f.block_starts.len; f.block_starts.push(first); f.block_ends.push(end)
        for op in first..end { f.op_blocks[op] = block }
        first = end
    }
    for block in 0..f.block_starts.len {
        f.edge_starts.push(f.edge_from.len)
        end := f.block_ends[block]; last := f.order[end - 1]; kind := f.kinds[last]
        if kind == 12 || kind == 13 {
            target := local_target(&f, &code, f.targets[last])
            if target >= 0 && target < count { mir.edge(&mut f, block, f.op_blocks[target], 1) }
            else { mir.edge(&mut f, block, -1, 2) }
        }
        if kind == 0 { mir.edge(&mut f, block, -1, 4) }
        else if kind == 15 { mir.edge(&mut f, block, -1, 3) }
        else if kind == 20 { mir.edge(&mut f, block, -1, 2) }
        else if kind != 12 {
            if block + 1 < f.block_starts.len { mir.edge(&mut f, block, block + 1, 0) }
            else { mir.edge(&mut f, block, -1, 3) }
        }
    }
    f.edge_starts.push(f.edge_from.len)
    true
}
pub fn lift(f: &mut mir.Function, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    mir.reset(&mut f)
    if code.checking || first_word < 0 || first_word > code.words.len || first_label < 0 || first_label > code.labels.len ||
        first_reloc < 0 || first_reloc > code.at.len || first_import < 0 || first_import > sites.len ||
        code.at.len != code.target.len || code.at.len != code.kinds.len { return false }
    f.platform = code.platform; f.first_word = first_word; f.first_label = first_label; f.first_reloc = first_reloc; f.first_import = first_import
    f.source_words = code.words.len; f.source_labels = code.labels.len; f.source_relocs = code.at.len; f.source_imports = sites.len
    for i in first_word..code.words.len + 1 { f.boundaries.push(-1) }
    var r := first_reloc; var imported := first_import; var at := first_word
    if r > 0 {
        kind := code.kinds[r - 1]; var width := 1; if kind >= 2 { width = 2 }
        if kind < 0 || kind > 20 || code.at[r - 1] < 0 || code.at[r - 1] > first_word - width { return false }
    }
    if imported > 0 { site := sites[imported - 1]; if site < 0 || site % 4 != 0 || site / 4 > first_word - 2 { return false } }
    while at < code.words.len {
        if code.words[at] < 0 || code.words[at] > 4294967295 { return false }
        if r < code.at.len && code.at[r] < at { return false }
        if imported < sites.len && (sites[imported] < 0 || sites[imported] % 4 != 0 || sites[imported] / 4 < at) { return false }
        symbolic := r < code.at.len && code.at[r] == at
        foreign := imported < sites.len && sites[imported] / 4 == at
        if symbolic && foreign { return false }
        if symbolic {
            kind := code.kinds[r]; target := code.target[r]
            if kind < 0 || kind > 20 || target < 0 || target >= code.labels.len { return false }
            var width := 1; if kind >= 2 { width = 2 }
            if at > code.words.len - width || code.words[at] != 0 { return false }
            if width == 2 && code.words[at + 1] != 3573751839 { return false }
            op := record(&mut f, &code, at, width); f.targets[op] = target; f.reloc_kinds[op] = kind
            if kind == 1 { call(&mut f, op, 1) }
            else if kind == 20 { f.kinds[op] = 9; f.dst[op] = 0; f.writes[op] = 1 }
            else {
                f.kinds[op] = 12; f.effects[op] = 16
                if kind >= 2 {
                    f.kinds[op] = 13
                    if kind == 18 || kind == 19 { f.a[op] = 0; f.reads[op] = 1 } else { f.flags[op] = 1 }
                }
            }
            r = r + 1; at = at + width
        } else if foreign {
            if at > code.words.len - 2 || code.words[at + 1] != 0 || (code.words[at] != 0 && code.words[at] != 4244635648) { return false }
            op := record(&mut f, &code, at, 2); f.kinds[op] = 17; f.dst[op] = 16
            if code.words[at] == 4244635648 { f.dst[op] = 0 }
            f.writes[op] = mir.variable_bit(f.dst[op]); f.import_ids[op] = imported
            imported = imported + 1; at = at + 2
        } else {
            op := record(&mut f, &code, at, 1); decode(&mut f, op, code.words[at]); at = at + 1
        }
    }
    if r != code.at.len || imported != sites.len { return false }
    f.boundaries[f.boundaries.len - 1] = f.order.len
    for label in first_label..code.labels.len {
        word := code.labels[label]; var op := -1
        if word != -1 {
            if word < first_word || word > code.words.len { return false }
            op = mir.boundary(&f, word); if op < 0 { return false }
        }
        f.label_ids.push(label); f.label_ops.push(op)
    }
    // Referenced old labels may be forward global functions/data, but a local
    // target must be an operation boundary and may never enter a pair interior.
    for op in 0..f.kinds.len {
        target := f.targets[op]
        if target < 0 { continue }
        word := code.labels[target]
        if word < -1 { return false }
        if word >= first_word && word <= code.words.len && mir.boundary(&f, word) < 0 { return false }
        if target < first_label && word > first_word { return false }
    }
    if !graph(&mut f, &code) { return false }
    // Any explicit FP address exposure makes frame ranges escape. An unknown
    // alias/control contract already disables the whole function's optimizer.
    var escape := false
    for op in 0..f.kinds.len {
        if f.a[op] == 29 && f.kinds[op] != 7 && f.kinds[op] != 8 && f.kinds[op] != 16 && f.kinds[op] != 21 { escape = true }
    }
    if escape { for p in 0..f.place_kinds.len { if f.place_kinds[p] == 1 { f.place_escaped[p] = true } } }
    f.valid = true; true
}
