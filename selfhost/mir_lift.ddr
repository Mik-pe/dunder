// Transitional adapter from the shared instruction vocabulary. Every word is
// represented; unknown vocabulary is an ordered opaque function barrier.
// Canonical operations and operands live in mir, never in this decoder.
import arm64 as arm
import backend_row as backend
import mir
import mir_source_call
import mir_float
import mir_source as source
import mir_contract as contract
import mir_decode as decode

pub struct Workspace { decoded: decode.Decoded }
pub fn new_work() -> Workspace { Workspace { decoded: decode.new() } }

fn record(f: &mut mir.Function, words: &[]i64, row: i32, at: i32, width: i32) -> i32 {
    op := mir.add(&mut f, 0); f.origins[op] = at; f.raw_starts[op] = f.raw.len
    f.widths[op] = width; f.modes[op] = 0
    f.boundaries[at - f.first_word] = op
    for i in 0..width { f.raw.push(words[row + i]) }
    op
}
fn local_target(f: &mir.Function, target: i32) -> i32 {
    aliases := f.label_ids.len - (f.source_labels - f.first_label)
    if target >= f.first_label { return f.label_ops[aliases + (target - f.first_label)] }
    // Older labels can only denote this function's entry or an external
    // destination. The sorted alias prefix contains exactly the former.
    var low := 0; var high := aliases
    while low < high {
        middle := low + (high - low) / 2
        if f.label_ids[middle] < target { low = middle + 1 } else { high = middle }
    }
    if low < aliases && f.label_ids[low] == target { return 0 }; -1
}
fn graph(f: &mut mir.Function) -> bool {
    count := f.order.len
    for i in 0..count + 1 { f.leaders.push(false) }
    f.leaders[0] = true; f.leaders[count] = true
    for i in 0..f.label_ops.len { if f.label_ops[i] >= 0 { f.leaders[f.label_ops[i]] = true } }
    for op in 0..count {
        kind := f.kinds[op]
        if kind == 12 || kind == 13 {
            target := local_target(&f, f.targets[op])
            if target >= 0 { f.leaders[target] = true }
        }
        if kind == 0 || kind == 12 || kind == 13 || kind == 15 || kind == 20 { f.leaders[op + 1] = true }
    }
    var first := 0
    for end in 1..count + 1 {
        if !f.leaders[end] { continue }
        block := f.block_starts.len; f.block_starts.push(first); f.block_ends.push(end)
        for op in first..end { f.op_blocks[op] = block }
        first = end
    }
    for block in 0..f.block_starts.len {
        f.edge_starts.push(f.edge_from.len)
        end := f.block_ends[block]; last := f.order[end - 1]; kind := f.kinds[last]
        if kind == 12 || kind == 13 {
            target := local_target(&f, f.targets[last])
            if target >= 0 && target < count { mir.edge(&mut f, block, f.op_blocks[target], 1) }
            else { mir.edge(&mut f, block, -1, 2) }
        }
        if kind == 0 { mir.edge(&mut f, block, -1, 4) }
        else if kind == 15 { mir.edge(&mut f, block, -1, 3) }
        else if kind == 20 { mir.edge(&mut f, block, -1, 2) }
        else if kind != 12 {
            if block + 1 < f.block_starts.len { mir.edge(&mut f, block, block + 1, 0) }
            else { mir.edge(&mut f, block, -1, 5) }
        }
    }
    f.edge_starts.push(f.edge_from.len)
    true
}
fn frame_effects(f: &mut mir.Function) {
    var has_frame := false
    for p in 0..f.place_kinds.len { if f.place_kinds[p] == 1 { has_frame = true; break } }
    if !has_frame { return }
    var escaped := contract.frame_lifetime_unproven(&f)
    if !escaped {
        for op in 0..f.kinds.len { if contract.exposes_frame(&f, op) { escaped = true; break } }
    }
    if escaped {
        for p in 0..f.place_kinds.len { if f.place_kinds[p] == 1 { f.place_escaped[p] = true } }
        return
    }
    size := contract.frame_capacity(&f)
    if size < 0 { return }
    for op in 0..f.kinds.len {
        if (f.recipes[op] == 1 || f.recipes[op] == 2) && (f.kinds[op] == 7 || f.kinds[op] == 8) &&
            contract.frame_place_proven_with_capacity(&f, f.place[op], size) { f.effects[op] = f.effects[op] - 1 }
    }
}
fn insert_entry(f: &mut mir.Function, entry: i32) -> bool {
    var position := 0
    while position < f.label_ids.len && f.label_ids[position] < entry { position = position + 1 }
    if position < f.label_ids.len && f.label_ids[position] == entry { return f.label_ops[position] == 0 }
    f.label_ids.push(entry); f.label_ops.push(0)
    var at := f.label_ids.len - 1
    while at > position {
        f.label_ids[at] = f.label_ids[at - 1]; f.label_ops[at] = f.label_ops[at - 1]; at = at - 1
    }
    f.label_ids[position] = entry; f.label_ops[position] = 0; true
}
fn abi_literal(f: &mut mir.Function, at: i32, reg: i32, value: i64) {
    op := mir.add(&mut f, 1); f.origins[op] = at; f.types[op] = 2
    f.dst[op] = reg; f.imm[op] = value; f.writes[op] = mir.variable_bit(reg)
}
// Direct and batched input use the same decoder. at/first_*/source_* are
// positions in the original emitter; *_row positions index the supplied arrays.
fn lift_rows(f: &mut mir.Function, work: &mut Workspace, item: &source.Item,
    words: &[]i64, labels: &[]i32, relocs: &[]i32, targets: &[]i32, reloc_kinds: &[]i32,
    sites: &[]i32,
    target_words: &[]i32, batched: bool) -> bool {
    first_word := item.first_word; first_label := item.first_label
    f.platform = item.platform; f.first_word = first_word; f.first_label = first_label
    f.first_reloc = item.first_reloc; f.first_import = item.first_import
    f.source_words = first_word + item.word_count; f.source_labels = first_label + item.label_count
    f.source_relocs = f.first_reloc + item.reloc_count; f.source_imports = f.first_import + item.import_count
    reloc_end := item.reloc_row + item.reloc_count; import_end := item.import_row + item.import_count
    f.boundaries.reserve(item.word_count + 1); f.raw.reserve(item.word_count)
    for i in 0..item.word_count + 1 { f.boundaries.push(-1) }
    var r := item.reloc_row; var imported := item.import_row; var at := first_word
    while at < f.source_words {
        row := item.word_row + (at - first_word)
        if words[row] < 0 { return false }
        if r < reloc_end && relocs[r] < at { return false }
        if imported < import_end && (sites[imported] < 0 || sites[imported] % 4 != 0 || sites[imported] / 4 < at) { return false }
        symbolic := r < reloc_end && relocs[r] == at
        foreign := imported < import_end && sites[imported] / 4 == at
        if symbolic && foreign { return false }
        if backend.valid_source_call(words[row]) {
            var target := -1
            if symbolic {
                target = targets[r]
                if reloc_kinds[r] != 1 || target < 0 || target >= f.source_labels { return false }
                r = r + 1
            }
            if foreign || !mir_source_call.append(&mut f, &mut work.decoded, &words, row, at, target) { return false }
            at = at + backend.call_width(words[row])
        } else if symbolic {
            kind := reloc_kinds[r]; target := targets[r]
            if kind < 0 || kind > 20 || target < 0 || target >= f.source_labels { return false }
            cell := words[row]; var width := 1; var op := -1
            if !decode.symbolic(&mut work.decoded, kind) { return false }
            if cell > 4294967295 {
                if backend.valid_control(cell, kind) {
                    work.decoded.variant = cell
                } else if kind == 1 && backend.call_header(cell) {
                    width = 2
                    if at >= f.source_words - 1 || !backend.call_pair(cell, words[row + 1]) { return false }
                    origin := words[row + 1]; tag := backend.kind(cell)
                    work.decoded.opcode = tag; work.decoded.aux = i32(backend.operand(cell).bit_and(2147483647))
                    work.decoded.imm = backend.operand(origin).bit_and(2147483647)
                    if tag == backend.task_tag(.Spawn) { work.decoded.variant = backend.task_decl(cell, origin) + 1 }
                } else { return false }
                f.boundaries[at - first_word] = f.order.len
                if backend.awaiting(work.decoded.opcode) {
                    // The task result type and await cardinality determine the
                    // runtime ABI. An incoming edge precedes both arguments.
                    abi_literal(&mut f, at, 2, i64(work.decoded.aux))
                    var consume: i64 = 0; if work.decoded.opcode == backend.task_tag(.AwaitOnce) { consume = 1 }
                    abi_literal(&mut f, at, 3, consume)
                }
                op = mir.add(&mut f, 0); f.origins[op] = at
            } else {
                if kind >= 2 { width = 2 }
                if at > f.source_words - width || cell != 0 { return false }
                if width == 2 && words[row + 1] != 3573751839 { return false }
                op = record(&mut f, &words, row, at, width); f.recipes[op] = 4
            }
            f.targets[op] = target; f.reloc_kinds[op] = kind
            decode.append_into(&work.decoded, &mut f, op)
            r = r + 1; at = at + width
        } else if foreign {
            if at > f.source_words - 2 || words[row + 1] != 0 || (words[row] != 0 && words[row] != 4244635648) { return false }
            op := record(&mut f, &words, row, at, 2); f.recipes[op] = 5
            if !decode.imported(&mut work.decoded, words[row]) { return false }
            decode.append_into(&work.decoded, &mut f, op); f.import_ids[op] = item.first_import + (imported - item.import_row)
            imported = imported + 1; at = at + 2
        } else if backend.owner_store_cell(words[row]) {
            if at >= f.source_words - 1 || !backend.source_cell(words[row + 1]) { return false }
            tag := backend.kind(words[row]); slot := i32(backend.operand(words[row]).shr(32))
            var reg := 31; if tag == 20 { reg = 0 }
            op := mir.add(&mut f, 8); f.origins[op] = at; f.boundaries[at - first_word] = op
            decode.frame(&mut work.decoded, 2, slot, reg)
            decode.append_into(&work.decoded, &mut f, op)
            f.recipes[op] = 2; f.opcodes[op] = tag
            f.variant[op] = words[row].bit_and(4294967295).shl(32).bit_or(backend.operand(words[row + 1]))
            if slot >= 32 { f.c[op] = 9 }
            at = at + 2
        } else if words[row] > 4294967295 {
            cell := words[row]
            if !backend.valid(cell) || backend.kind(cell) == 48 || backend.control_row(cell) { return false }
            tag := backend.kind(cell); reg := backend.reg(cell); operand := backend.operand(cell)
            op := mir.add(&mut f, 1); f.origins[op] = at; f.boundaries[at - first_word] = op
            f.types[op] = 2; f.dst[op] = reg; f.writes[op] = mir.variable_bit(reg)
            if tag == 61 { mir_float.set(&mut f, op, i32(operand.shr(32)), reg, i32(operand.bit_and(2147483647))) }
            else if tag == 1 {
                var value := operand
                if value >= 140737488355328 { value = value - 281474976710656 }
                f.imm[op] = value
            } else if tag == 2 {
                if at + 1 >= f.source_words || words[row + 1] < 0 || words[row + 1] > 4294967295 { return false }
                f.imm[op] = operand.bit_or(words[row + 1].shl(32)); at = at + 1
            } else if tag == 15 {
                action := i32(operand.bit_and(255)); amount := operand.shr(8)
                if action == 1 || action == 6 || action == 7 {
                    decode.reset(&mut work.decoded)
                    if action == 7 { decode.internal_return(&mut work.decoded) }
                    else { decode.frame_pair(&mut work.decoded, action == 6) }
                    decode.append_into(&work.decoded, &mut f, op)
                } else if action == 8 {
                    f.kinds[op] = 18; f.dst[op] = -1; f.writes[op] = 0
                } else {
                    f.kinds[op] = 16; f.effects[op] = 32; f.opcodes[op] = 1
                    f.dst[op] = 31; f.a[op] = 31
                    if action == 2 { f.dst[op] = 29 } else if action == 5 { f.a[op] = 29 }
                    else { f.opcodes[op] = 2; f.imm[op] = amount; f.variant[op] = i64(action) }
                    f.reads[op] = mir.variable_bit(f.a[op]); f.writes[op] = mir.variable_bit(f.dst[op])
                }
            } else if tag == 14 {
                f.kinds[op] = 3; f.opcodes[op] = 2; if backend.bitfield_signed(cell) { f.opcodes[op] = 1 }
                if !backend.binary_wide(cell) { f.types[op] = 1 }
                f.a[op] = backend.binary_left(cell); f.reads[op] = mir.variable_bit(f.a[op])
                f.aux[op] = i32(backend.binary_right(cell))
            } else if tag == 12 || tag == 13 {
                f.kinds[op] = 4; f.opcodes[op] = backend.binary_op(cell)
                if !backend.binary_wide(cell) { f.types[op] = 1 }; if backend.binary_flags(cell) { f.flags[op] = 2 }
                f.a[op] = backend.binary_left(cell); right := backend.binary_right(cell)
                if tag == 12 { f.b[op] = i32(right) } else { f.imm[op] = right }
                f.reads[op] = mir.variable_bit(f.a[op]).bit_or(mir.variable_bit(f.b[op]))
            } else if tag >= 7 && tag <= 10 {
                decode.reset(&mut work.decoded)
                decode.stack(&mut work.decoded, reg, tag == 7 || tag == 9, tag <= 8)
                if tag <= 8 { f.recipes[op] = tag - 1 }
                decode.append_into(&work.decoded, &mut f, op)
            } else if tag == 11 {
                shape := i32(operand.shr(32)); slot := i32(operand.bit_and(4294967295))
                offset := -(slot + 1) * 8; var width := i32(1).shl(shape); var extension := 1
                if shape == 3 { extension = 0 } else if shape == 4 { width = 4; extension = 2 }
                f.kinds[op] = 7; f.a[op] = 29; f.reads[op] = mir.variable_bit(29)
                f.aux[op] = width; f.extensions[op] = extension; f.imm[op] = i64(offset)
                if shape < 3 { f.types[op] = 1 }
                place := mir.add_place(&mut f, 1, offset, width, extension); f.place[op] = place
                f.recipes[op] = 1; f.effects[op] = 3
                if slot >= 32 { f.c[op] = 0; f.clobbers[op] = mir.variable_bit(0) }
            } else if tag >= 4 {
                slot := i32(operand); recipe := tag - 3
                f.recipes[op] = recipe
                decode.frame(&mut work.decoded, recipe, slot, reg)
                decode.append_into(&work.decoded, &mut f, op)
                if recipe != 3 && slot >= 32 { f.c[op] = 9 }
                if recipe != 2 && reg == 29 { f.optimizable = false }
            } else if operand != 31 {
                f.kinds[op] = 2; f.a[op] = i32(operand); f.reads[op] = mir.variable_bit(i32(operand))
            }
            at = at + 1
        } else {
            op := record(&mut f, &words, row, at, 1)
            decode.word(&mut work.decoded, words[row], item.platform)
            decode.append_into(&work.decoded, &mut f, op); at = at + 1
        }
    }
    if r != reloc_end || imported != import_end { return false }
    f.boundaries[f.boundaries.len - 1] = f.order.len
    for i in 0..item.label_count {
        word := labels[item.label_row + i]; var op := -1
        if word != -1 {
            if word < first_word || word > f.source_words { return false }
            op = mir.boundary(&f, word); if op < 0 { return false }
        }
        f.label_ids.push(first_label + i); f.label_ops.push(op)
    }
    for i in item.reloc_row..reloc_end {
        target := targets[i]
        if target >= first_label { continue } // local binding was checked above
        var word := -1
        if batched { word = target_words[i] } else { word = labels[target] }
        if word < -1 || word > first_word { return false }
        if word == first_word && !insert_entry(&mut f, target) { return false }
    }
    if !graph(&mut f) { return false }
    frame_effects(&mut f)
    f.valid = true; true
}
pub fn build_into(f: &mut mir.Function, work: &mut Workspace, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    mir.reset(&mut f)
    if !source.valid_start(&code, first_word, first_label, first_reloc, &sites, first_import) { return false }
    item := source.rows(code.platform, first_word, first_label, first_reloc, first_import,
        code.words.len, code.labels.len, code.at.len, sites.len)
    return lift_rows(&mut f, &mut work, &item, &code.words, &code.labels, &code.at, &code.target, &code.kinds,
        &sites, &code.labels, false)
}
fn fits(row: i32, count: i32, length: i32) -> bool {
    row >= 0 && count >= 0 && row <= length && count <= length - row
}
// A worker owns the decoded MIR columns. It reads a single logical item
// directly from its immutable snapshot, even when adjacent items share arrays.
pub fn lift_item(f: &mut mir.Function, work: &mut Workspace, batch: &source.Batch, index: i32) -> i32 {
    mir.reset(&mut f)
    if index < 0 || index >= source.count(&batch) { return 10 }
    item := source.item_at(&batch, index)
    if batch.at.len != batch.targets.len || batch.at.len != batch.kinds.len || batch.at.len != batch.target_words.len { return 10 }
    if !fits(item.word_row, item.word_count, batch.words.len) || !fits(item.label_row, item.label_count, batch.labels.len) ||
        !fits(item.reloc_row, item.reloc_count, batch.at.len) || !fits(item.import_row, item.import_count, batch.sites.len) { return 10 }
    if !fits(item.first_word, item.word_count, 2147483647) || item.word_count == 2147483647 ||
        !fits(item.first_label, item.label_count, 2147483647) || !fits(item.first_reloc, item.reloc_count, 2147483647) ||
        !fits(item.first_import, item.import_count, 2147483647) { return 10 }
    if !lift_rows(&mut f, &mut work, &item, &batch.words, &batch.labels, &batch.at, &batch.targets, &batch.kinds,
        &batch.sites, &batch.target_words, true) { return 10 }
    if item.entry < 0 || item.entry >= f.source_labels || item.entry_word != f.first_word || !insert_entry(&mut f, item.entry) { return 11 }
    return 0
}
pub fn lift(f: &mut mir.Function, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    var work := new_work()
    build_into(&mut f, &mut work, &code, first_word, first_label, first_reloc, &sites, first_import)
}
// Global function entry labels are normally allocated before any body is
// emitted. The frontend supplies its known entry explicitly, keeping lifting
// linear in this function rather than scanning all previous global labels.
pub fn own_entry(f: &mut mir.Function, code: &arm.Code, entry: i32) -> bool {
    f.verified = false
    if !f.valid || entry < 0 || entry >= f.source_labels || code.labels.len != f.source_labels ||
        code.labels[entry] != f.first_word { return false }
    insert_entry(&mut f, entry)
}
