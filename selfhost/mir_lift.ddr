// Transitional adapter from the shared instruction vocabulary. Every word is
// represented; unknown vocabulary is an ordered opaque function barrier.
// Canonical operations and operands live in mir, never in this decoder.
import arm64 as arm
import mir
import mir_contract as contract

fn bits(word: i64, shift: i32, mask: i64) -> i32 { i32(word.shr(shift).bit_and(mask)) }
fn variable(f: &mut mir.Function, op: i32, destination: i32, left: i32, right: i32) {
    f.dst[op] = destination; f.a[op] = left; f.b[op] = right
    f.reads[op] = mir.variable_bit(left).bit_or(mir.variable_bit(right))
    f.writes[op] = mir.variable_bit(destination)
}
fn zero_registers(f: &mut mir.Function, op: i32) {
    if f.dst[op] == 31 { f.dst[op] = -1; f.writes[op] = 0 }
    if f.a[op] == 31 { f.a[op] = -1 }
    if f.b[op] == 31 { f.b[op] = -1 }
    if f.c[op] == 31 { f.c[op] = -1 }
    f.reads[op] = mir.variable_bit(f.a[op]).bit_or(mir.variable_bit(f.b[op])).bit_or(mir.variable_bit(f.c[op]))
}
fn call(f: &mut mir.Function, op: i32, abi: i32) {
    f.kinds[op] = 14; f.abi[op] = abi; f.effects[op] = 95; f.flags[op] = 2
    // Internal runtime allocator state is not the ordinary C callee-save set.
    // x18 and x19..24 are reserved throughout the common backend.
    f.reads[op] = -1; f.writes[op] = 0; f.clobbers[op] = -1
}
fn floating(f: &mut mir.Function, op: i32, word: i64) -> bool {
    rd := bits(word, 0, 31); rn := bits(word, 5, 31); rm := bits(word, 16, 31)
    kind := word.bit_and(4294966272); key := word.bit_and(4280351744); unary := word.bit_and(4290771968)
    var opcode := 0; var destination := rd + 32; var left := rn + 32; var right := -1
    if kind == 505872384 || kind == 2657550336 { opcode = 9; left = rn }
    else if kind == 505806848 || kind == 2657484800 { opcode = 10; destination = rd }
    else if key == 505423872 { opcode = 1; right = rm + 32 }
    else if key == 505427968 { opcode = 2; right = rm + 32 }
    else if key == 505415680 { opcode = 3; right = rm + 32 }
    else if key == 505419776 { opcode = 4; right = rm + 32 }
    else if word.bit_and(4280351775) == 505421824 { opcode = 5; destination = -1; right = rm + 32 }
    else if unary == 505462784 { opcode = 6 }
    else if unary == 505495552 { opcode = 7 }
    else if unary == 505528320 { opcode = 8 }
    else if kind == 509755392 || kind == 505593856 { opcode = 11 }
    else if unary == 2653028352 { opcode = 12; left = rn }
    else if unary == 2653093888 { opcode = 13; left = rn }
    else if unary == 2654470144 { opcode = 14; destination = rd }
    else if unary == 2654535680 { opcode = 15; destination = rd }
    else if unary == 505790464 { opcode = 16 }
    else if unary == 505757696 { opcode = 17 }
    else if unary == 505724928 { opcode = 18 }
    else if unary == 505823232 { opcode = 19 }
    else if unary == 505692160 { opcode = 20 }
    if opcode == 0 { return false }
    // Architectural register 31 is ZR only on the GP side of transfers and
    // conversions. V31 remains an ordinary floating register.
    if (opcode == 9 || opcode == 12 || opcode == 13) && left == 31 { left = -1 }
    if (opcode == 10 || opcode == 14 || opcode == 15) && destination == 31 { destination = -1 }
    f.kinds[op] = 19; f.opcodes[op] = opcode; variable(&mut f, op, destination, left, right)
    f.types[op] = 5; if bits(word, 22, 1) != 0 { f.types[op] = 6 }
    if opcode == 5 { f.flags[op] = 2 }
    true
}
fn memory(f: &mut mir.Function, op: i32, word: i64) -> bool {
    scaled := word.bit_and(989855744) == 956301312
    if !scaled && word.bit_and(991955968) != 939524096 { return false }
    size := bits(word, 30, 3); transfer := bits(word, 22, 3)
    if transfer > 2 || (transfer == 2 && size != 2) { return false }
    // SIMD memory instructions are handled by the float vocabulary below.
    if bits(word, 26, 1) != 0 { return false }
    reg := bits(word, 0, 31); base := bits(word, 5, 31)
    var offset := bits(word, 12, 511); if offset >= 256 { offset = offset - 512 }
    if scaled { offset = bits(word, 10, 4095).shl(size) }
    var kind := 7; if transfer == 0 { kind = 8 }
    f.kinds[op] = kind; f.imm[op] = i64(offset); f.aux[op] = i32(1).shl(size)
    f.types[op] = 2; if size < 3 && transfer != 2 { f.types[op] = 1 }
    var extension := 0; if transfer == 1 && size < 3 { extension = 1 }; if transfer == 2 { extension = 2 }
    f.extensions[op] = extension
    var place_kind := 0; if base == 29 { place_kind = 1 }; if base == 31 { place_kind = 2 }
    place := mir.add_place(&mut f, place_kind, offset, i32(1).shl(size), extension); f.place[op] = place
    if kind == 7 {
        variable(&mut f, op, reg, base, -1); f.effects[op] = 3
        if reg == 31 { f.dst[op] = -1; f.writes[op] = 0 }
    } else {
        variable(&mut f, op, -1, reg, base); f.effects[op] = 5
        if reg == 31 { f.a[op] = -1; f.reads[op] = mir.variable_bit(base) }
    }
    true
}
fn decode(f: &mut mir.Function, op: i32, word: i64) {
    rd := bits(word, 0, 31); rn := bits(word, 5, 31); rm := bits(word, 16, 31)
    f.variant[op] = word; f.types[op] = 2; if bits(word, 31, 1) == 0 { f.types[op] = 1 }
    if word == 3573751839 { f.kinds[op] = 18; return }
    if word == 3596551104 {
        f.kinds[op] = 15; f.effects[op] = 16; f.reads[op] = mir.variable_bit(30); return
    }
    if word == 3558866944 { f.kinds[op] = 20; f.effects[op] = 17; return }
    if word.bit_and(4292870175) == 3556769793 { call(&mut f, op, 3); return }
    if word.bit_and(4294966303) == 3594452992 { call(&mut f, op, 1); f.a[op] = rn; return }
    family := bits(word, 24, 255)
    if family == 251 || family == 252 || family == 254 { call(&mut f, op, 2); return }
    // Explicit expression stack units; a push is 16 bytes even though one
    // scalar register is stored. FP/LR frame setup has a separate ABI contract.
    if word.bit_and(4294967264) == 2847899616 {
        f.kinds[op] = 10; variable(&mut f, op, 31, rd, 31)
        if rd == 31 { f.a[op] = -1 }
        f.imm[op] = -16; f.effects[op] = 36
        place := mir.add_place(&mut f, 2, -16, 8, 0); f.place[op] = place; return
    }
    if word.bit_and(4294967264) == 2831253472 {
        f.kinds[op] = 11; variable(&mut f, op, rd, 31, -1)
        if rd == 31 { f.dst[op] = -1 }
        f.writes[op] = f.writes[op].bit_or(mir.variable_bit(31)); f.imm[op] = 16; f.effects[op] = 34
        place := mir.add_place(&mut f, 2, 0, 8, 0); f.place[op] = place; return
    }
    if word == 2847898621 || word == 2831252477 {
        f.kinds[op] = 21; f.opcodes[op] = 1; f.imm[op] = -16; f.abi[op] = 1; f.effects[op] = 36
        f.dst[op] = 31; f.a[op] = 29; f.b[op] = 30; f.c[op] = 31
        f.reads[op] = mir.variable_bit(31).bit_or(mir.variable_bit(29)).bit_or(mir.variable_bit(30))
        f.writes[op] = mir.variable_bit(31)
        if word == 2831252477 {
            f.opcodes[op] = 2; f.imm[op] = 16; f.effects[op] = 34; f.writes[op] = f.reads[op]
            f.reads[op] = mir.variable_bit(31); f.a[op] = 31; f.b[op] = -1; f.c[op] = -1
        }
        return
    }
    wide_family := word.bit_and(2139095040)
    if wide_family == 1384120320 || wide_family == 1920991232 {
        f.kinds[op] = 1; variable(&mut f, op, rd, -1, -1)
        shift := 16 * bits(word, 21, 3); f.imm[op] = i64(bits(word, 5, 65535)).shl(shift); f.aux[op] = shift
        if wide_family == 1920991232 { f.kinds[op] = 3; f.opcodes[op] = 3; f.a[op] = rd; f.reads[op] = mir.variable_bit(rd) }
        if rd == 31 { f.dst[op] = -1; f.a[op] = -1; f.reads[op] = 0; f.writes[op] = 0 }
        return
    }
    // ORR Xd,XZR,Xm is an actual mutable-variable copy. XZR is not SP.
    if word.bit_and(4292935648) == 2852127712 {
        f.kinds[op] = 2; variable(&mut f, op, rd, rm, -1); zero_registers(&mut f, op)
        if rm == 31 { f.kinds[op] = 1 }; return
    }
    if word.bit_and(520093696) == 285212672 {
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, -1)
        f.opcodes[op] = 1; if bits(word, 30, 1) != 0 { f.opcodes[op] = 2 }
        f.imm[op] = i64(bits(word, 10, 4095)).shl(bits(word, 22, 1) * 12)
        if bits(word, 29, 1) != 0 {
            f.flags[op] = 2
            if rd == 31 { f.kinds[op] = 5; f.dst[op] = -1; f.writes[op] = 0 }
        } else if rd == 31 || (rn == 31 && rd == 29) { f.kinds[op] = 16; f.effects[op] = 32 }
        return
    }
    arithmetic := word.bit_and(522190848) == 184549376
    logical := word.bit_and(520093696) == 167772160
    if arithmetic || logical {
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, rm)
        f.aux[op] = bits(word, 10, 63) + bits(word, 22, 3) * 64
        if arithmetic {
            f.opcodes[op] = 1; if bits(word, 30, 1) != 0 { f.opcodes[op] = 2 }
        } else {
            operation := bits(word, 29, 3)
            f.opcodes[op] = 8
            if operation == 1 { f.opcodes[op] = 9 }; if operation == 2 { f.opcodes[op] = 10 }
            if bits(word, 21, 1) != 0 { f.opcodes[op] = f.opcodes[op] + 3 }
        }
        if rn == 31 { f.a[op] = -1; f.reads[op] = mir.variable_bit(rm) }
        if rm == 31 { f.b[op] = -1; f.reads[op] = mir.variable_bit(f.a[op]) }
        if arithmetic && bits(word, 29, 1) != 0 { f.flags[op] = 2 }
        if logical && bits(word, 29, 3) == 3 { f.flags[op] = 2 }
        if rd == 31 { f.dst[op] = -1; f.writes[op] = 0; if f.flags[op] == 2 { f.kinds[op] = 5 } }
        return
    }
    if wide_family == 318767104 || wide_family == 1392508928 {
        f.kinds[op] = 3; variable(&mut f, op, rd, rn, -1)
        f.opcodes[op] = 1; if wide_family == 1392508928 { f.opcodes[op] = 2 }
        f.aux[op] = bits(word, 16, 63) + bits(word, 10, 63) * 64; zero_registers(&mut f, op); return
    }
    if word.bit_and(520093696) == 452984832 {
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, rm)
        ra := bits(word, 10, 31)
        family := bits(word, 21, 7)
        if family == 2 { f.opcodes[op] = 4 }
        else if family == 6 { f.opcodes[op] = 5 }
        else if family == 0 {
            f.opcodes[op] = 3
            if ra != 31 {
                f.c[op] = ra; f.reads[op] = f.reads[op].bit_or(mir.variable_bit(ra)); f.opcodes[op] = 17
                if bits(word, 15, 1) != 0 { f.opcodes[op] = 18 }
            } else if bits(word, 15, 1) != 0 { f.opcodes[op] = 18 }
        } else { mir.opaque(&mut f, op); return }
        zero_registers(&mut f, op)
        return
    }
    if word.bit_and(534773760) == 448790528 {
        operation := bits(word, 10, 63)
        f.kinds[op] = 4; variable(&mut f, op, rd, rn, rm)
        if operation == 2 { f.opcodes[op] = 7 }
        else if operation == 3 { f.opcodes[op] = 6 }
        else if operation >= 8 && operation <= 10 { f.opcodes[op] = 14 + operation - 8 }
        else { mir.opaque(&mut f, op); return }; zero_registers(&mut f, op); return
    }
    if word.bit_and(4294905824) == 2594113504 {
        f.kinds[op] = 6; variable(&mut f, op, rd, -1, -1); f.flags[op] = 1
        if rd == 31 { f.dst[op] = -1; f.writes[op] = 0 }
        f.imm[op] = i64(bits(word, 12, 15).bit_xor(1)); return
    }
    if memory(&mut f, op, word) { return }
    if floating(&mut f, op, word) { return }
    mir.opaque(&mut f, op)
}
fn record(f: &mut mir.Function, code: &arm.Code, at: i32, width: i32) -> i32 {
    op := mir.add(&mut f, 0); f.origins[op] = at; f.raw_starts[op] = f.raw.len
    f.widths[op] = width; f.modes[op] = 0
    f.boundaries[at - f.first_word] = op
    for i in 0..width { f.raw.push(code.words[at + i]) }
    op
}
fn local_target(f: &mir.Function, code: &arm.Code, target: i32) -> i32 {
    if target < 0 || target >= code.labels.len { return -1 }
    word := code.labels[target]
    if word < f.first_word || word > f.source_words { return -1 }
    mir.boundary(&f, word)
}
fn graph(f: &mut mir.Function, code: &arm.Code) -> bool {
    count := f.order.len
    for i in 0..count + 1 { f.leaders.push(false) }
    f.leaders[0] = true; f.leaders[count] = true
    for i in 0..f.label_ops.len { if f.label_ops[i] >= 0 { f.leaders[f.label_ops[i]] = true } }
    for op in 0..count {
        kind := f.kinds[op]
        if kind == 12 || kind == 13 {
            target := local_target(&f, &code, f.targets[op])
            if target >= 0 { f.leaders[target] = true }
        }
        if kind == 0 || kind == 12 || kind == 13 || kind == 15 || kind == 20 { f.leaders[op + 1] = true }
    }
    var first := 0
    for end in 1..count + 1 {
        if !f.leaders[end] { continue }
        block := f.block_starts.len; f.block_starts.push(first); f.block_ends.push(end)
        for op in first..end { f.op_blocks[op] = block }
        first = end
    }
    for block in 0..f.block_starts.len {
        f.edge_starts.push(f.edge_from.len)
        end := f.block_ends[block]; last := f.order[end - 1]; kind := f.kinds[last]
        if kind == 12 || kind == 13 {
            target := local_target(&f, &code, f.targets[last])
            if target >= 0 && target < count { mir.edge(&mut f, block, f.op_blocks[target], 1) }
            else { mir.edge(&mut f, block, -1, 2) }
        }
        if kind == 0 { mir.edge(&mut f, block, -1, 4) }
        else if kind == 15 { mir.edge(&mut f, block, -1, 3) }
        else if kind == 20 { mir.edge(&mut f, block, -1, 2) }
        else if kind != 12 {
            if block + 1 < f.block_starts.len { mir.edge(&mut f, block, block + 1, 0) }
            else { mir.edge(&mut f, block, -1, 5) }
        }
    }
    f.edge_starts.push(f.edge_from.len)
    true
}
fn insert_entry(f: &mut mir.Function, entry: i32) -> bool {
    var position := 0
    while position < f.label_ids.len && f.label_ids[position] < entry { position = position + 1 }
    if position < f.label_ids.len && f.label_ids[position] == entry { return f.label_ops[position] == 0 }
    f.label_ids.push(entry); f.label_ops.push(0)
    var at := f.label_ids.len - 1
    while at > position {
        f.label_ids[at] = f.label_ids[at - 1]; f.label_ops[at] = f.label_ops[at - 1]; at = at - 1
    }
    f.label_ids[position] = entry; f.label_ops[position] = 0; true
}
fn immediate_end(code: &arm.Code, first: i32, end: i32, reg: i32, value: i64) -> i32 {
    if first >= end || code.words[first] != 3531603968 + value.bit_and(65535) * 32 + i64(reg) { return -1 }
    var at := first + 1
    for part in 1..4 {
        value_part := value.shr(part * 16).bit_and(65535)
        if value_part != 0 {
            if at >= end || code.words[at] != 4068474880 + i64(part) * 2097152 + value_part * 32 + i64(reg) { return -1 }
            at = at + 1
        }
    }
    at
}
fn valid_span(code: &arm.Code, first: i32, end: i32, kind: i32, slot: i32, reg: i32) -> bool {
    if first < 0 || end <= first || end > code.words.len || kind < 1 || kind > 3 ||
        slot < 0 || slot > 268435454 || reg < 0 || reg > 31 || (kind == 3 && reg == 31) { return false }
    if kind == 3 {
        if slot < 511 { return end == first + 1 && code.words[first] == 3506439072 + i64(slot + 1) * 8192 + i64(reg) }
        at := immediate_end(&code, first, end, reg, i64(slot + 1) * 8)
        return at >= 0 && at + 1 == end && code.words[at] == 3405775776 + i64(reg) * 65537
    }
    if slot < 32 {
        var base: i64 = 4164944800; if kind == 2 { base = 4160750496 }
        return end == first + 1 && code.words[first] == base + i64(-(slot + 1) * 8).bit_and(511) * 4096 + i64(reg)
    }
    var at := first
    if slot < 511 {
        if code.words[at] != 3506439081 + i64(slot + 1) * 8192 { return false }
        at = at + 1
    } else {
        at = immediate_end(&code, first, end, 9, i64(slot + 1) * 8)
        if at < 0 || at >= end || code.words[at] != 3406365609 { return false }
        at = at + 1
    }
    var base: i64 = 4181721376; if kind == 2 { base = 4177527072 }
    at + 1 == end && code.words[at] == base + i64(reg)
}
fn frame_span(f: &mut mir.Function, code: &arm.Code, first: i32, end: i32, kind: i32, slot: i32, reg: i32) {
    op := record(&mut f, &code, first, end - first)
    f.recipes[op] = kind
    // The historical high-slot store helper consumes x9 as its address scratch.
    // If an unusual producer also supplies x9 as the value, preserve the actual
    // emitted unit conservatively rather than inventing a pre-scratch value.
    if kind == 2 && slot >= 32 && reg == 9 { mir.opaque(&mut f, op); return }
    f.kinds[op] = 7; if kind == 2 { f.kinds[op] = 8 }; if kind == 3 { f.kinds[op] = 9 }
    f.types[op] = 2; f.aux[op] = 8; f.imm[op] = i64(-(slot + 1) * 8)
    place := mir.add_place(&mut f, 1, -(slot + 1) * 8, 8, 0); f.place[op] = place
    if kind == 1 { variable(&mut f, op, reg, 29, -1); f.effects[op] = 3 }
    else if kind == 2 { variable(&mut f, op, -1, reg, 29); f.effects[op] = 5 }
    else { variable(&mut f, op, reg, 29, -1); f.effects[op] = 128; f.place_escaped[place] = true }
    if kind != 3 { zero_registers(&mut f, op) }
    if kind != 3 && end - first > 1 {
        f.writes[op] = f.writes[op].bit_or(mir.variable_bit(9)); f.clobbers[op] = mir.variable_bit(9)
    }
    if kind != 2 && reg == 29 { f.optimizable = false }
}
// Capture columns are reset and reused for each source function by arm.Code.
// An annotation is accepted only when its COMPLETE encoding matches, so stale
// compaction metadata can never silently change the canonical operation.
pub fn lift_spans(f: &mut mir.Function, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32,
    starts: &[]i32, ends: &[]i32, kinds: &[]i32, a: &[]i32, b: &[]i32) -> bool {
    mir.reset(&mut f)
    if code.checking || first_word < 0 || first_word > code.words.len || first_label < 0 || first_label > code.labels.len ||
        first_reloc < 0 || first_reloc > code.at.len || first_import < 0 || first_import > sites.len ||
        code.at.len != code.target.len || code.at.len != code.kinds.len || starts.len != ends.len ||
        starts.len != kinds.len || starts.len != a.len || starts.len != b.len { return false }
    for note in 0..starts.len {
        if starts[note] < first_word || !valid_span(&code, starts[note], ends[note], kinds[note], a[note], b[note]) { return false }
        if note > 0 && starts[note] < ends[note - 1] { return false }
    }
    f.platform = code.platform; f.first_word = first_word; f.first_label = first_label; f.first_reloc = first_reloc; f.first_import = first_import
    f.source_words = code.words.len; f.source_labels = code.labels.len; f.source_relocs = code.at.len; f.source_imports = sites.len
    for i in first_word..code.words.len + 1 { f.boundaries.push(-1) }
    var r := first_reloc; var imported := first_import; var at := first_word; var note := 0
    if r > 0 {
        kind := code.kinds[r - 1]; var width := 1; if kind >= 2 { width = 2 }
        if kind < 0 || kind > 20 || code.at[r - 1] < 0 || code.at[r - 1] > first_word - width { return false }
    }
    if imported > 0 { site := sites[imported - 1]; if site < 0 || site % 4 != 0 || site / 4 > first_word - 2 { return false } }
    while at < code.words.len {
        if code.words[at] < 0 || code.words[at] > 4294967295 { return false }
        if r < code.at.len && code.at[r] < at { return false }
        if imported < sites.len && (sites[imported] < 0 || sites[imported] % 4 != 0 || sites[imported] / 4 < at) { return false }
        symbolic := r < code.at.len && code.at[r] == at
        foreign := imported < sites.len && sites[imported] / 4 == at
        if symbolic && foreign { return false }
        if note < starts.len && starts[note] < at { return false }
        if note < starts.len && starts[note] == at {
            end := ends[note]
            if (r < code.at.len && code.at[r] < end) || (imported < sites.len && sites[imported] / 4 < end) { return false }
            frame_span(&mut f, &code, at, end, kinds[note], a[note], b[note]); at = end; note = note + 1
        } else if symbolic {
            kind := code.kinds[r]; target := code.target[r]
            if kind < 0 || kind > 20 || target < 0 || target >= code.labels.len { return false }
            var width := 1; if kind >= 2 { width = 2 }
            if at > code.words.len - width || code.words[at] != 0 { return false }
            if width == 2 && code.words[at + 1] != 3573751839 { return false }
            op := record(&mut f, &code, at, width); f.recipes[op] = 4; f.targets[op] = target; f.reloc_kinds[op] = kind
            if kind == 1 { call(&mut f, op, 1) }
            else if kind == 20 { f.kinds[op] = 9; f.dst[op] = 0; f.writes[op] = 1 }
            else {
                f.kinds[op] = 12; f.effects[op] = 16
                if kind >= 2 {
                    f.kinds[op] = 13
                    if kind == 18 || kind == 19 {
                        f.a[op] = 0; f.reads[op] = 1; f.opcodes[op] = 2
                        if kind == 19 { f.opcodes[op] = 3 }
                    } else { f.flags[op] = 1; f.opcodes[op] = 1; f.imm[op] = i64(kind - 2) }
                }
            }
            r = r + 1; at = at + width
        } else if foreign {
            if at > code.words.len - 2 || code.words[at + 1] != 0 || (code.words[at] != 0 && code.words[at] != 4244635648) { return false }
            op := record(&mut f, &code, at, 2); f.kinds[op] = 17; f.dst[op] = 16
            f.recipes[op] = 5
            if code.words[at] == 4244635648 { f.dst[op] = 0 }
            f.writes[op] = mir.variable_bit(f.dst[op]); f.import_ids[op] = imported
            imported = imported + 1; at = at + 2
        } else {
            op := record(&mut f, &code, at, 1); decode(&mut f, op, code.words[at]); at = at + 1
        }
    }
    if r != code.at.len || imported != sites.len || note != starts.len { return false }
    f.boundaries[f.boundaries.len - 1] = f.order.len
    for label in first_label..code.labels.len {
        word := code.labels[label]; var op := -1
        if word != -1 {
            if word < first_word || word > code.words.len { return false }
            op = mir.boundary(&f, word); if op < 0 { return false }
        }
        f.label_ids.push(label); f.label_ops.push(op)
    }
    // Referenced old labels may be forward global functions/data, but a local
    // target must be an operation boundary and may never enter a pair interior.
    for op in 0..f.kinds.len {
        target := f.targets[op]
        if target < 0 { continue }
        word := code.labels[target]
        if word < -1 { return false }
        if word >= first_word && word <= code.words.len && mir.boundary(&f, word) < 0 { return false }
        if target < first_label && word > first_word { return false }
        if target < first_label && word == first_word { if !insert_entry(&mut f, target) { return false } }
    }
    if !graph(&mut f, &code) { return false }
    // Any explicit FP address exposure makes frame ranges escape. An unknown
    // alias/control contract already disables the whole function's optimizer.
    var escape := false
    for op in 0..f.kinds.len { if contract.exposes_frame(&f, op) { escape = true } }
    if escape { for p in 0..f.place_kinds.len { if f.place_kinds[p] == 1 { f.place_escaped[p] = true } } }
    for op in 0..f.kinds.len {
        if (f.recipes[op] == 1 || f.recipes[op] == 2) && (f.kinds[op] == 7 || f.kinds[op] == 8) &&
            contract.frame_place_proven(&f, f.place[op]) { f.effects[op] = f.effects[op] - 1 }
    }
    f.valid = true; true
}
pub fn lift(f: &mut mir.Function, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    empty: []i32 = []
    lift_spans(&mut f, &code, first_word, first_label, first_reloc, &sites, first_import, &empty, &empty, &empty, &empty, &empty)
}
// Global function entry labels are normally allocated before any body is
// emitted. The frontend supplies its known entry explicitly, keeping lifting
// linear in this function rather than scanning all previous global labels.
pub fn own_entry(f: &mut mir.Function, code: &arm.Code, entry: i32) -> bool {
    f.verified = false
    if !f.valid || entry < 0 || entry >= f.source_labels || code.labels.len != f.source_labels ||
        code.labels[entry] != f.first_word { return false }
    insert_entry(&mut f, entry)
}
