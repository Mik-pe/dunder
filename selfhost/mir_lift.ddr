// Transitional adapter from the shared instruction vocabulary. Every word is
// represented; unknown vocabulary is an ordered opaque function barrier.
// Canonical operations and operands live in mir, never in this decoder.
import arm64 as arm
import mir
import mir_contract as contract
import mir_decode as decode

pub struct Workspace { decoded: decode.Decoded }
pub fn new_work() -> Workspace { Workspace { decoded: decode.new() } }

fn record(f: &mut mir.Function, code: &arm.Code, at: i32, width: i32) -> i32 {
    op := mir.add(&mut f, 0); f.origins[op] = at; f.raw_starts[op] = f.raw.len
    f.widths[op] = width; f.modes[op] = 0
    f.boundaries[at - f.first_word] = op
    for i in 0..width { f.raw.push(code.words[at + i]) }
    op
}
fn local_target(f: &mir.Function, code: &arm.Code, target: i32) -> i32 {
    if target < 0 || target >= code.labels.len { return -1 }
    word := code.labels[target]
    if word < f.first_word || word > f.source_words { return -1 }
    mir.boundary(&f, word)
}
fn graph(f: &mut mir.Function, code: &arm.Code) -> bool {
    count := f.order.len
    for i in 0..count + 1 { f.leaders.push(false) }
    f.leaders[0] = true; f.leaders[count] = true
    for i in 0..f.label_ops.len { if f.label_ops[i] >= 0 { f.leaders[f.label_ops[i]] = true } }
    for op in 0..count {
        kind := f.kinds[op]
        if kind == 12 || kind == 13 {
            target := local_target(&f, &code, f.targets[op])
            if target >= 0 { f.leaders[target] = true }
        }
        if kind == 0 || kind == 12 || kind == 13 || kind == 15 || kind == 20 { f.leaders[op + 1] = true }
    }
    var first := 0
    for end in 1..count + 1 {
        if !f.leaders[end] { continue }
        block := f.block_starts.len; f.block_starts.push(first); f.block_ends.push(end)
        for op in first..end { f.op_blocks[op] = block }
        first = end
    }
    for block in 0..f.block_starts.len {
        f.edge_starts.push(f.edge_from.len)
        end := f.block_ends[block]; last := f.order[end - 1]; kind := f.kinds[last]
        if kind == 12 || kind == 13 {
            target := local_target(&f, &code, f.targets[last])
            if target >= 0 && target < count { mir.edge(&mut f, block, f.op_blocks[target], 1) }
            else { mir.edge(&mut f, block, -1, 2) }
        }
        if kind == 0 { mir.edge(&mut f, block, -1, 4) }
        else if kind == 15 { mir.edge(&mut f, block, -1, 3) }
        else if kind == 20 { mir.edge(&mut f, block, -1, 2) }
        else if kind != 12 {
            if block + 1 < f.block_starts.len { mir.edge(&mut f, block, block + 1, 0) }
            else { mir.edge(&mut f, block, -1, 5) }
        }
    }
    f.edge_starts.push(f.edge_from.len)
    true
}
fn insert_entry(f: &mut mir.Function, entry: i32) -> bool {
    var position := 0
    while position < f.label_ids.len && f.label_ids[position] < entry { position = position + 1 }
    if position < f.label_ids.len && f.label_ids[position] == entry { return f.label_ops[position] == 0 }
    f.label_ids.push(entry); f.label_ops.push(0)
    var at := f.label_ids.len - 1
    while at > position {
        f.label_ids[at] = f.label_ids[at - 1]; f.label_ops[at] = f.label_ops[at - 1]; at = at - 1
    }
    f.label_ids[position] = entry; f.label_ops[position] = 0; true
}
// Capture columns are reset and reused for each source function by arm.Code.
// An annotation is accepted only when its COMPLETE encoding matches, so stale
// compaction metadata can never silently change the canonical operation.
pub fn lift_spans_into(f: &mut mir.Function, work: &mut Workspace, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32,
    starts: &[]i32, ends: &[]i32, kinds: &[]i32, a: &[]i32, b: &[]i32) -> bool {
    mir.reset(&mut f)
    if code.checking || first_word < 0 || first_word > code.words.len || first_label < 0 || first_label > code.labels.len ||
        first_reloc < 0 || first_reloc > code.at.len || first_import < 0 || first_import > sites.len ||
        code.at.len != code.target.len || code.at.len != code.kinds.len || starts.len != ends.len ||
        starts.len != kinds.len || starts.len != a.len || starts.len != b.len { return false }
    for note in 0..starts.len {
        if starts[note] < first_word || !decode.valid_span_encoding(&code.words, starts[note], ends[note], kinds[note], a[note], b[note]) { return false }
        if note > 0 && starts[note] < ends[note - 1] { return false }
    }
    f.platform = code.platform; f.first_word = first_word; f.first_label = first_label; f.first_reloc = first_reloc; f.first_import = first_import
    f.source_words = code.words.len; f.source_labels = code.labels.len; f.source_relocs = code.at.len; f.source_imports = sites.len
    for i in first_word..code.words.len + 1 { f.boundaries.push(-1) }
    var r := first_reloc; var imported := first_import; var at := first_word; var note := 0
    if r > 0 {
        kind := code.kinds[r - 1]; var width := 1; if kind >= 2 { width = 2 }
        if kind < 0 || kind > 20 || code.at[r - 1] < 0 || code.at[r - 1] > first_word - width { return false }
    }
    if imported > 0 { site := sites[imported - 1]; if site < 0 || site % 4 != 0 || site / 4 > first_word - 2 { return false } }
    while at < code.words.len {
        if code.words[at] < 0 || code.words[at] > 4294967295 { return false }
        if r < code.at.len && code.at[r] < at { return false }
        if imported < sites.len && (sites[imported] < 0 || sites[imported] % 4 != 0 || sites[imported] / 4 < at) { return false }
        symbolic := r < code.at.len && code.at[r] == at
        foreign := imported < sites.len && sites[imported] / 4 == at
        if symbolic && foreign { return false }
        if note < starts.len && starts[note] < at { return false }
        if note < starts.len && starts[note] == at {
            end := ends[note]
            if (r < code.at.len && code.at[r] < end) || (imported < sites.len && sites[imported] / 4 < end) { return false }
            op := record(&mut f, &code, at, end - at)
            if kinds[note] <= 3 {
                f.recipes[op] = kinds[note]
                decode.frame(&mut work.decoded, kinds[note], a[note], b[note], end - at)
            } else {
                f.recipes[op] = kinds[note] + 2
                if !decode.temporary_stack(&mut work.decoded, code.words[at], code.platform, kinds[note] == 4) { return false }
            }
            decode.append_into(&work.decoded, &mut f, op)
            if f.kinds[op] == 7 || f.kinds[op] == 8 { f.effects[op] = f.effects[op].bit_or(1) }
            if kinds[note] <= 3 && kinds[note] != 2 && b[note] == 29 { f.optimizable = false }
            at = end; note = note + 1
        } else if symbolic {
            kind := code.kinds[r]; target := code.target[r]
            if kind < 0 || kind > 20 || target < 0 || target >= code.labels.len { return false }
            var width := 1; if kind >= 2 { width = 2 }
            if at > code.words.len - width || code.words[at] != 0 { return false }
            if width == 2 && code.words[at + 1] != 3573751839 { return false }
            op := record(&mut f, &code, at, width); f.recipes[op] = 4; f.targets[op] = target; f.reloc_kinds[op] = kind
            if !decode.symbolic(&mut work.decoded, kind) { return false }
            decode.append_into(&work.decoded, &mut f, op)
            r = r + 1; at = at + width
        } else if foreign {
            if at > code.words.len - 2 || code.words[at + 1] != 0 || (code.words[at] != 0 && code.words[at] != 4244635648) { return false }
            op := record(&mut f, &code, at, 2); f.recipes[op] = 5
            if !decode.imported(&mut work.decoded, code.words[at]) { return false }
            decode.append_into(&work.decoded, &mut f, op); f.import_ids[op] = imported
            imported = imported + 1; at = at + 2
        } else {
            op := record(&mut f, &code, at, 1)
            decode.word(&mut work.decoded, code.words[at], code.platform)
            decode.append_into(&work.decoded, &mut f, op); at = at + 1
        }
    }
    if r != code.at.len || imported != sites.len || note != starts.len { return false }
    f.boundaries[f.boundaries.len - 1] = f.order.len
    for label in first_label..code.labels.len {
        word := code.labels[label]; var op := -1
        if word != -1 {
            if word < first_word || word > code.words.len { return false }
            op = mir.boundary(&f, word); if op < 0 { return false }
        }
        f.label_ids.push(label); f.label_ops.push(op)
    }
    // Referenced old labels may be forward global functions/data, but a local
    // target must be an operation boundary and may never enter a pair interior.
    for op in 0..f.kinds.len {
        target := f.targets[op]
        if target < 0 { continue }
        word := code.labels[target]
        if word < -1 { return false }
        if word >= first_word && word <= code.words.len && mir.boundary(&f, word) < 0 { return false }
        if target < first_label && word > first_word { return false }
        if target < first_label && word == first_word { if !insert_entry(&mut f, target) { return false } }
    }
    if !graph(&mut f, &code) { return false }
    // Any explicit FP address exposure makes frame ranges escape. An unknown
    // alias/control contract already disables the whole function's optimizer.
    var escape := contract.frame_lifetime_unproven(&f)
    for op in 0..f.kinds.len { if contract.exposes_frame(&f, op) { escape = true } }
    if escape { for p in 0..f.place_kinds.len { if f.place_kinds[p] == 1 { f.place_escaped[p] = true } } }
    for op in 0..f.kinds.len {
        if (f.recipes[op] == 1 || f.recipes[op] == 2) && (f.kinds[op] == 7 || f.kinds[op] == 8) &&
            contract.frame_place_proven(&f, f.place[op]) { f.effects[op] = f.effects[op] - 1 }
    }
    f.valid = true; true
}
pub fn lift_spans(f: &mut mir.Function, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32,
    starts: &[]i32, ends: &[]i32, kinds: &[]i32, a: &[]i32, b: &[]i32) -> bool {
    var work := new_work()
    lift_spans_into(&mut f, &mut work, &code, first_word, first_label, first_reloc, &sites, first_import, &starts, &ends, &kinds, &a, &b)
}
pub fn lift(f: &mut mir.Function, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    empty: []i32 = []
    lift_spans(&mut f, &code, first_word, first_label, first_reloc, &sites, first_import, &empty, &empty, &empty, &empty, &empty)
}
// Global function entry labels are normally allocated before any body is
// emitted. The frontend supplies its known entry explicitly, keeping lifting
// linear in this function rather than scanning all previous global labels.
pub fn own_entry(f: &mut mir.Function, code: &arm.Code, entry: i32) -> bool {
    f.verified = false
    if !f.valid || entry < 0 || entry >= f.source_labels || code.labels.len != f.source_labels ||
        code.labels[entry] != f.first_word { return false }
    insert_entry(&mut f, entry)
}
