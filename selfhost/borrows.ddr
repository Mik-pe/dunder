// Place and mutation checks over an already parsed expression's token interval.
import lexer

fn symbol(t: &lexer.Tokens, i: i32, spelling: string) -> bool {
    i >= 0 && i < t.texts.len && t.kinds[i] == .Symbol && t.texts[i] == spelling
}
fn skip_groups(t: &lexer.Tokens, first: i32, last: i32) -> i32 {
    var i := first
    while i < last && symbol(&t, i, "(") { i = i + 1 }
    i
}
pub fn root(t: &lexer.Tokens, first: i32, last: i32) -> i32 {
    var i := skip_groups(&t, first, last)
    if symbol(&t, i, "&") {
        i = i + 1
        if i < last && t.texts[i] == "mut" { i = i + 1 }
        i = skip_groups(&t, i, last)
    }
    if i < last && t.kinds[i] == .Name { return i }
    -1
}
fn mutator(name: string) -> bool { name == "push" || name == "pop" || name == "clear" || name == "reserve" }
pub fn projected(t: &lexer.Tokens, root_at: i32, end: i32) -> bool {
    if root_at < 0 { return false }
    var i := root_at + 1
    while i < end && symbol(&t, i, ")") { i = i + 1 }
    i < end && (symbol(&t, i, "[") || symbol(&t, i, "."))
}
pub fn fields_only(t: &lexer.Tokens, first: i32, last: i32) -> bool {
    // A named field chain can be resolved again without reevaluating any code.
    var i := first; var member := false
    while i < last {
        if symbol(&t, i, ".") { member = true }
        else if t.kinds[i] != .Name && !symbol(&t, i, "(") && !symbol(&t, i, ")") { return false }
        i = i + 1
    }
    member
}
// A call can modify a root via an explicit &mut or a mutating array method.
fn overlaps(t: &lexer.Tokens, place: i32, place_end: i32, other: i32, other_end: i32) -> bool {
    if t.texts[place] != t.texts[other] { return false }
    var a := place + 1; var b := other + 1
    while a + 1 < place_end && b + 1 < other_end && symbol(&t, a, ".") && symbol(&t, b, ".") {
        if symbol(&t, b + 2, "(") { break }
        if t.texts[a + 1] != t.texts[b + 1] { return false }
        a = a + 2; b = b + 2
    }
    true
}
pub fn changes(t: &lexer.Tokens, place: i32, place_end: i32, first: i32, last: i32) -> bool {
    for i in first..last {
        if symbol(&t, i, "&") && i + 2 < last && t.texts[i + 1] == "mut" {
            found := root(&t, i, last)
            if found >= 0 && overlaps(&t, place, place_end, found, last) { return true }
        }
        if t.kinds[i] == .Name && overlaps(&t, place, place_end, i, last) {
            var j := i + 1
            while j + 1 < last && symbol(&t, j, ".") {
                if mutator(t.texts[j + 1]) && symbol(&t, j + 2, "(") { return true }
                j = j + 2
            }
        }
    }
    false
}
pub fn compatible(t: &lexer.Tokens, starts: &[]i32, ends: &[]i32) -> bool {
    for i in 0..starts.len {
        start := skip_groups(&t, starts[i], ends[i])
        if !symbol(&t, start, "&") { continue }
        base := root(&t, start, ends[i]); if base < 0 { continue }
        for j in 0..starts.len {
            if i == j { continue }
            other := skip_groups(&t, starts[j], ends[j])
            if symbol(&t, other, "&") {
                other_base := root(&t, other, ends[j])
                if other_base >= 0 && t.texts[other_base] == t.texts[base] && (t.texts[start + 1] == "mut" || t.texts[other + 1] == "mut") { return false }
            }
            if projected(&t, base, ends[i]) && changes(&t, base, ends[i], starts[j], ends[j]) { return false }
        }
    }
    true
}
