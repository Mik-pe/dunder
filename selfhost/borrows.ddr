// A place consists of a local with field and index projections. Parentheses
// preserve it. Calls, operators and fresh aggregates produce independent values.
import lexer

fn symbol(t: &lexer.Tokens, i: i32, spelling: string) -> bool {
    i >= 0 && i < t.texts.len && t.kinds[i] == .Symbol && t.texts[i] == spelling
}

pub fn place(t: &lexer.Tokens, first: i32, last: i32) -> i32 {
    var i := first
    var groups := 0
    while i < last && symbol(&t, i, "(") { groups = groups + 1; i = i + 1 }
    if i == last || t.kinds[i] != .Name { return -1 }
    base := i
    i = i + 1
    while i < last {
        if groups > 0 && symbol(&t, i, ")") { groups = groups - 1; i = i + 1 }
        else if symbol(&t, i, ".") && i + 1 < last && t.kinds[i + 1] == .Name { i = i + 2 }
        else if symbol(&t, i, "[") {
            var brackets := 1
            i = i + 1
            while i < last && brackets > 0 {
                if symbol(&t, i, "[") { brackets = brackets + 1 }
                else if symbol(&t, i, "]") { brackets = brackets - 1 }
                i = i + 1
            }
            if brackets != 0 { return -1 }
        } else { return -1 }
    }
    if groups != 0 { return -1 }
    base
}
pub fn indexed(t: &lexer.Tokens, first: i32, last: i32) -> bool {
    for i in first..last { if symbol(&t, i, "[") { return true } }
    false
}
// Borrow expressions have been type checked before we inspect their arguments.
// Raw ref_at arguments and ordinary function values have no tracked local.
pub fn argument(t: &lexer.Tokens, first: i32, last: i32) -> i32 {
    var i := first
    while i < last && symbol(&t, i, "(") { i = i + 1 }
    if i == last || !symbol(&t, i, "&") { return -1 }
    i = i + 1
    if i < last && t.texts[i] == "mut" { i = i + 1 }
    while i < last && symbol(&t, i, "(") { i = i + 1 }
    if i < last && t.kinds[i] == .Name { return i }
    -1
}
// Mutations are recorded by the typed borrow and array-method operators. A
// field called push or an unrelated field with the same name as a local
// therefore cannot create a spurious mutation.
pub fn changed(t: &lexer.Tokens, mutations: &[]i32, first: i32, last: i32, place: i32) -> bool {
    if place < 0 { return false }
    for i in first..last { if t.texts[mutations[i]] == t.texts[place] { return true } }
    false
}
pub fn root(t: &lexer.Tokens, first: i32, last: i32) -> i32 {
    named := place(&t, first, last)
    if named >= 0 { return named }
    argument(&t, first, last)
}
