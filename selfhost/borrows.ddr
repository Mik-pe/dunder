// A place ID is zero for an independent value, negative for a stable LocalID,
// and positive for a resolved projection in the current function. Local reads
// need no arena allocation. A field carries its resolved member ID. An index
// carries the evaluated index slot when its result can itself be projected.
pub enum Access { Value, Address, ValueAndAddress }

pub struct Places {
    current: i32, source: i32, parents: []i32, roots: []i32, receivers: []i32,
    members: []i32, indices: []i32, tokens: []i32, indexed: []bool, path: []i32,
}

pub fn places() -> Places {
    Places { current: 0, source: -1, parents: [], roots: [], receivers: [],
        members: [], indices: [], tokens: [], indexed: [], path: [] }
}
pub fn clear(p: &mut Places) {
    p.current = 0; p.source = -1; p.parents.clear(); p.roots.clear()
    p.receivers.clear(); p.tokens.clear(); p.members.clear(); p.indices.clear(); p.indexed.clear(); p.path.clear()
}
pub fn local_id(binding: i32) -> i32 { -1 - binding }
pub fn root(p: &Places, id: i32) -> i32 {
    if id <= 0 { return -1 - id }
    p.roots[id - 1]
}
pub fn has_index(p: &Places, id: i32) -> bool { id > 0 && p.indexed[id - 1] }

pub fn project(p: &mut Places, parent: i32, receiver: i32, member: i32, index: i32, token: i32) -> i32 {
    if parent == 0 { return 0 }
    binding := root(&p, parent)
    indexed := member < 0 || has_index(&p, parent)
    p.parents.push(parent); p.roots.push(binding); p.receivers.push(receiver)
    p.tokens.push(token); p.members.push(member); p.indices.push(index); p.indexed.push(indexed)
    p.parents.len
}

// Mutations and iteration locks refer to stable LocalIDs. A nested scope can
// shadow a name without acquiring the outer binding's lock.
pub fn changed(mutations: &[]i32, first: i32, last: i32, local: i32) -> bool {
    for i in first..last { if mutations[i] == local { return true } }
    false
}
