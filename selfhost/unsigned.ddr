// Primitive type IDs 8..12 are u8, u16, u32, u64 and native usize.
import arm64 as arm
import std.parse as parse

pub fn has(ty: i32) -> bool { ty >= 8 && ty <= 12 }
pub fn shift(ty: i32) -> i32 {
    if ty == 3 { return 0 }
    if ty == 1 || ty == 5 || ty == 6 { return 2 }
    if ty >= 8 && ty <= 10 { return ty - 8 }
    3
}
pub fn width(ty: i32) -> i32 { i32(8).shl(shift(ty)) }
pub fn maximum(ty: i32) -> i64 {
    if ty == 8 { return 255 }
    if ty == 9 { return 65535 }
    if ty == 10 { return 4294967295 }
    -1
}

// Accumulate a decimal bit pattern using signed operations supported by older
// bootstraps. MAX/10 fits in i64, including for the final u64 digit.
pub fn literal(text: string, ty: i32) -> parse.Integer {
    var acc: i64 = 0
    var previous := false
    for i in 0..text.len {
        byte := text[i]
        if byte == 95 {
            if !previous { return parse.Integer { ok:false, value:0, error:1 } }
            previous = false
        } else {
            if byte < 48 || byte > 57 { return parse.Integer { ok:false, value:0, error:1 } }
            digit := i64(byte - 48)
            if acc < 0 || acc > 1844674407370955161 || (acc == 1844674407370955161 && digit > 5) {
                return parse.Integer { ok:false, value:0, error:2 }
            }
            acc = acc.wrapping_mul(10).wrapping_add(digit)
            previous = true
        }
    }
    if !previous || (width(ty) < 64 && (acc < 0 || acc > maximum(ty))) {
        return parse.Integer { ok:false, value:0, error:2 }
    }
    parse.Integer { ok:true, value:acc, error:0 }
}

pub fn check_max(code: &mut arm.Code, max: i64, trap: i32) {
    arm.imm(&mut code, 2, max)
    arm.emit(&mut code, 3942776863) // cmp x0,x2
    arm.branch(&mut code, trap, 10) // HI
}
pub fn mask(code: &mut arm.Code, ty: i32) {
    if width(ty) < 64 { arm.emit(&mut code, 3544186880 + i64(width(ty) - 1) * 1024) }
}
pub fn cast(code: &mut arm.Code, from: i32, to: i32, trap: i32) {
    if has(to) {
        if !has(from) {
            arm.emit(&mut code, 4043309087) // cmp x0,#0
            arm.branch(&mut code, trap, 13)
        }
        if width(to) < 64 { check_max(&mut code, maximum(to), trap) }
    } else if has(from) {
        if to == 1 { check_max(&mut code, 2147483647, trap) }
        if to == 2 { check_max(&mut code, 9223372036854775807, trap) }
    }
}

// Checked operands are zero-extended in x1 and x0. Return 3 for bool.
pub fn binary(code: &mut arm.Code, op: string, ty: i32, trap: i32, zero: i32) -> i32 {
    if op == "+" {
        arm.emit(&mut code, 2868903968)
        if width(ty) == 64 { arm.branch(&mut code, trap, 4) }
        else { check_max(&mut code, maximum(ty), trap) }
    } else if op == "-" {
        arm.emit(&mut code, 3942645792); arm.branch(&mut code, trap, 5)
    } else if op == "*" {
        if width(ty) == 64 {
            arm.emit(&mut code, 2613083170) // umulh x2,x1,x0
            arm.emit(&mut code, 4043309151); arm.branch(&mut code, trap, 3)
        }
        arm.emit(&mut code, 2600500256)
        if width(ty) < 64 { check_max(&mut code, maximum(ty), trap) }
    } else if op == "/" || op == "%" {
        arm.branch(&mut code, zero, 18); arm.emit(&mut code, 2596276258)
        if op == "/" { arm.mov(&mut code, 0, 2) } else { arm.emit(&mut code, 2600502336) }
    } else {
        var cond := 0
        if op == "!=" { cond = 1 }
        if op == "<" { cond = 3 }
        if op == "<=" { cond = 9 }
        if op == ">" { cond = 8 }
        if op == ">=" { cond = 2 }
        arm.emit(&mut code, 3942645823)
        arm.emit(&mut code, 2594113504 + i64(cond.bit_xor(1)) * 4096)
        return 3
    }
    ty
}
pub fn transfer(code: &mut arm.Code, ty: i32, reg: i32, base: i32, load: bool) {
    var opcode: i64 = 4177526784
    if ty == 3 || ty == 8 { opcode = 956301312 }
    if ty == 9 { opcode = 2030043136 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 { opcode = 3103784960 }
    if load { opcode = opcode + 4194304; if ty == 1 { opcode = 3112173568 } }
    arm.emit(&mut code, opcode + i64(base) * 32 + i64(reg))
}
