// Target-independent Typed SSA MIR (`selfhost/ssa/ssa_ir.ddr`).
// Flat i32-indexed arenas, zero ARM64 registers/flags, zero imports of compile.ddr or selfhost/mir/*.
// Designed for Dunder 1.0 Phase 3B unified SSA optimization, inlining, and native target ISel.

import ..hir.hir_types as ht

// SsaVal.def_inst sentinels:
//   >= 0 : index into SsaFunc.insts
//   -1   : block parameter of def_bb
//   -2   : terminator result of def_bb (Call / IndirectCall / ExternCall / IntrinsicCall)
//   -3   : function entry parameter (defined at entry of bb 0)
pub const DEF_BLOCK_PARAM: i32 = -1
pub const DEF_TERM_RESULT: i32 = -2
pub const DEF_FN_PARAM: i32    = -3

// BoundsCheck modes (SsaInst.aux):
pub const BOUNDS_LT: i32 = 0    // 0 <= idx < len
pub const BOUNDS_LE: i32 = 1    // 0 <= idx <= len (slice upper bound)

pub struct StackSlot {
    id: i32,
    ty: i32,
    size: i32,
    align: i32,
    addr_taken: bool,
    is_param: bool,
    is_sret: bool,
    dead: bool,
    name: string,
}

pub struct SsaVal {
    id: i32,
    ty: i32,
    def_bb: i32,
    def_inst: i32,
}

pub struct SsaBlock {
    params_start: i32,
    params_len: i32,
    inst_start: i32,
    inst_len: i32,
    term_id: i32,
    pred_start: i32,
    pred_len: i32,
}

pub enum SsaInstKind {
    ConstInt,
    ConstFloat,
    ConstStr,
    ConstCStr,
    ConstWStr,
    ConstBlob,
    ConstFn,
    Copy,
    Binary,
    Unary,
    Cast,
    SlotAddr,
    Load,
    Store,
    FieldAddr,
    IndexAddr,
    FatMake,
    FatPtr,
    FatLen,
    AllocHeap,
    MemCopy,
    MemZero,
    Discriminant,
    SetDiscriminant,
    Len,
    ClosureMake,
    Select,
    BoundsCheck,
    OverflowCheck,
    Nop,
}

pub struct SsaInst {
    kind: SsaInstKind,
    res: i32,           // SsaVal id (-1 if instruction produces no value)
    ty: i32,            // result TypeId (or stored/operated TypeId)
    op_a: i32,          // first SsaVal operand (-1 if unused)
    op_b: i32,          // second SsaVal operand (-1 if unused)
    op_c: i32,          // third SsaVal operand (-1 if unused; used by Select)
    aux: i32,           // binop/unop/slot_id/fn_id/field_idx/variant_idx/check_mode/ext_mode
    aux_ty: i32,        // secondary TypeId (cast target, aggregate/elem/enum/closure/check ty)
    imm_i64: i64,       // immediate int / byte offset / byte size / elem stride / blob id
    str_idx: i32,       // index into SsaFunc.const_strs (-1 if unused)
    arg_start: i32,     // slice into SsaFunc.val_args (used by ClosureMake)
    arg_len: i32,
    span_start: i32,
    span_end: i32,
}

pub enum SsaTermKind {
    Goto,
    Branch,
    Switch,
    Call,
    IndirectCall,
    ExternCall,
    IntrinsicCall,
    TaskScopeEnter,
    TaskScopeJoin,
    RegionEnter,
    RegionExit,
    Return,
    Trap,
}

pub struct SsaTerm {
    kind: SsaTermKind,
    target_a: i32,      // Goto bb / Branch then_bb / Switch default_bb / Call..Exit next_bb
    target_b: i32,      // Branch else_bb (-1 otherwise)
    cond_val: i32,      // Branch cond / Switch val / IndirectCall callee_val / Return val / Enter|Join handle|cap val
    env_val: i32,       // IndirectCall env_val (-1 if plain fn ptr)
    callee: i32,        // Call/ExternCall fn_id / IntrinsicCall id / TaskScope|Region scope_id / Trap code
    sig_ty: i32,        // Call/IndirectCall/ExternCall signature TypeId (-1 if N/A)
    aux_ty: i32,        // IntrinsicCall auxiliary TypeId (-1 if N/A)
    dest_val: i32,      // Call..IntrinsicCall result SsaVal id (-1 if none)
    arg_start: i32,     // Goto args / Branch then_args / Switch default_args / Call..TaskScopeEnter args
    arg_len: i32,
    arg2_start: i32,    // Branch else_args
    arg2_len: i32,
    case_start: i32,    // Switch slice into switch_vals / switch_bbs / switch_arg_starts / switch_arg_lens
    case_len: i32,
    span_start: i32,
    span_end: i32,
}

pub struct SsaFunc {
    fn_id: i32,
    owner_mod: i32,
    name: string,
    path: string,
    sig_ty: i32,
    ret_ty: i32,
    param_count: i32,
    is_unsafe: bool,
    is_extern: bool,
    is_closure_body: bool,
    slots: []StackSlot,
    vals: []SsaVal,
    param_vals: []i32,
    blocks: []SsaBlock,
    block_params: []i32,
    block_insts: []i32,
    insts: []SsaInst,
    terms: []SsaTerm,
    preds: []i32,
    val_args: []i32,
    const_strs: []string,
    switch_vals: []i64,
    switch_bbs: []i32,
    switch_arg_starts: []i32,
    switch_arg_lens: []i32,
}

pub struct SsaProgram {
    funcs: []SsaFunc,
    entry_fn: i32,
    fn_id_to_idx: []i32,
}

pub struct DomTree {
    idom: []i32,        // immediate dominator per bb (idom[0] = 0, -1 if unreachable)
    rpo_order: []i32,   // reachable blocks in reverse post-order
    rpo_num: []i32,     // position in rpo_order (-1 if unreachable)
    dom_child_start: []i32,
    dom_child_len: []i32,
    dom_children: []i32,
}

pub struct DomFrontiers {
    df_start: []i32,
    df_len: []i32,
    df_nodes: []i32,
}

// =========================================================================
// Constructors & Arena Builders
// =========================================================================

pub fn new_program(fn_count: i32, entry_fn: i32) -> SsaProgram {
    mut map: []i32 = []
    for _ in 0..fn_count { map.push(-1) }
    SsaProgram {
        funcs: [],
        entry_fn: entry_fn,
        fn_id_to_idx: move map,
    }
}

pub fn add_program_func(prog: &mut SsaProgram, move f: SsaFunc) -> i32 {
    idx := prog.funcs.len
    fid := f.fn_id
    while fid >= prog.fn_id_to_idx.len {
        prog.fn_id_to_idx.push(-1)
    }
    if fid >= 0 { prog.fn_id_to_idx[fid] = idx }
    prog.funcs.push(move f)
    idx
}

pub fn new_func(fn_id: i32, owner_mod: i32, name: string, path: string,
    sig_ty: i32, ret_ty: i32, param_count: i32, is_unsafe: bool) -> SsaFunc {
    SsaFunc {
        fn_id: fn_id,
        owner_mod: owner_mod,
        name: name.clone(),
        path: path.clone(),
        sig_ty: sig_ty,
        ret_ty: ret_ty,
        param_count: param_count,
        is_unsafe: is_unsafe,
        is_extern: false,
        is_closure_body: false,
        slots: [],
        vals: [],
        param_vals: [],
        blocks: [],
        block_params: [],
        block_insts: [],
        insts: [],
        terms: [],
        preds: [],
        val_args: [],
        const_strs: [],
        switch_vals: [],
        switch_bbs: [],
        switch_arg_starts: [],
        switch_arg_lens: [],
    }
}

pub fn add_slot(f: &mut SsaFunc, ty: i32, size: i32, align: i32,
    addr_taken: bool, is_param: bool, is_sret: bool, name: string) -> i32 {
    id := f.slots.len
    f.slots.push(StackSlot {
        id: id,
        ty: ty,
        size: size,
        align: align,
        addr_taken: addr_taken,
        is_param: is_param,
        is_sret: is_sret,
        dead: false,
        name: name.clone(),
    })
    id
}

pub fn add_val(f: &mut SsaFunc, ty: i32, def_bb: i32, def_inst: i32) -> i32 {
    id := f.vals.len
    f.vals.push(SsaVal {
        id: id,
        ty: ty,
        def_bb: def_bb,
        def_inst: def_inst,
    })
    id
}

pub fn add_fn_param_val(f: &mut SsaFunc, ty: i32) -> i32 {
    vid := add_val(&mut f, ty, 0, DEF_FN_PARAM)
    f.param_vals.push(vid)
    vid
}

pub fn add_block(f: &mut SsaFunc) -> i32 {
    id := f.blocks.len
    f.blocks.push(SsaBlock {
        params_start: 0,
        params_len: 0,
        inst_start: 0,
        inst_len: 0,
        term_id: -1,
        pred_start: 0,
        pred_len: 0,
    })
    id
}

pub fn add_block_param(f: &mut SsaFunc, bb: i32, ty: i32) -> i32 {
    vid := add_val(&mut f, ty, bb, DEF_BLOCK_PARAM)
    append_block_param_val(&mut f, bb, vid)
    vid
}

pub fn append_block_param_val(f: &mut SsaFunc, bb: i32, vid: i32) {
    idx := f.block_params.len
    f.block_params.push(vid)
    if f.blocks[bb].params_len == 0 {
        f.blocks[bb].params_start = idx
        f.blocks[bb].params_len = 1
    } else if f.blocks[bb].params_start + f.blocks[bb].params_len == idx {
        f.blocks[bb].params_len += 1
    } else {
        old_s := f.blocks[bb].params_start
        old_n := f.blocks[bb].params_len
        new_s := f.block_params.len - 1
        last := f.block_params[new_s]
        f.block_params[new_s] = f.block_params[old_s]
        for k in 1..old_n {
            f.block_params.push(f.block_params[old_s + k])
        }
        f.block_params.push(last)
        f.blocks[bb].params_start = new_s
        f.blocks[bb].params_len = old_n + 1
    }
}

pub fn add_const_str(f: &mut SsaFunc, text: string) -> i32 {
    id := f.const_strs.len
    f.const_strs.push(text.clone())
    id
}

pub fn push_val_args(f: &mut SsaFunc, args: &[]i32) -> i32 {
    start := f.val_args.len
    for i in 0..args.len {
        f.val_args.push(args[i])
    }
    start
}

pub fn make_inst(kind: SsaInstKind, ty: i32, op_a: i32, op_b: i32, op_c: i32,
    aux: i32, aux_ty: i32, imm_i64: i64, str_idx: i32, arg_start: i32, arg_len: i32,
    span_start: i32, span_end: i32) -> SsaInst {
    SsaInst {
        kind: kind,
        res: -1,
        ty: ty,
        op_a: op_a,
        op_b: op_b,
        op_c: op_c,
        aux: aux,
        aux_ty: aux_ty,
        imm_i64: imm_i64,
        str_idx: str_idx,
        arg_start: arg_start,
        arg_len: arg_len,
        span_start: span_start,
        span_end: span_end,
    }
}

pub fn inst_produces_val(kind: SsaInstKind) -> bool {
    kind != .Store && kind != .MemCopy && kind != .MemZero &&
    kind != .SetDiscriminant && kind != .BoundsCheck &&
    kind != .OverflowCheck && kind != .Nop
}

pub fn inst_is_pure(kind: SsaInstKind) -> bool {
    kind != .Store && kind != .MemCopy && kind != .MemZero &&
    kind != .SetDiscriminant && kind != .AllocHeap &&
    kind != .BoundsCheck && kind != .OverflowCheck && kind != .Nop
}

// Append an instruction to `bb`, automatically allocating its result SsaVal if `inst_produces_val`.
// Returns the allocated SsaVal id (or -1 for void instructions).
pub fn emit_inst(f: &mut SsaFunc, bb: i32, inst: SsaInst) -> i32 {
    iid := f.insts.len
    mut ins := inst
    mut res_val := -1
    if inst_produces_val(ins.kind) {
        if ins.res >= 0 {
            res_val = ins.res
            f.vals[res_val].def_bb = bb
            f.vals[res_val].def_inst = iid
        } else {
            res_val = add_val(&mut f, ins.ty, bb, iid)
            ins.res = res_val
        }
    }
    f.insts.push(ins)
    append_block_inst_id(&mut f, bb, iid)
    res_val
}

// Prepend an instruction to the start of `bb` (used e.g. for Call destination stores or hoisted constants).
pub fn prepend_inst(f: &mut SsaFunc, bb: i32, inst: SsaInst) -> i32 {
    iid := f.insts.len
    mut ins := inst
    mut res_val := -1
    if inst_produces_val(ins.kind) {
        if ins.res >= 0 {
            res_val = ins.res
            f.vals[res_val].def_bb = bb
            f.vals[res_val].def_inst = iid
        } else {
            res_val = add_val(&mut f, ins.ty, bb, iid)
            ins.res = res_val
        }
    }
    f.insts.push(ins)
    old_s := f.blocks[bb].inst_start
    old_n := f.blocks[bb].inst_len
    new_s := f.block_insts.len
    f.block_insts.push(iid)
    for k in 0..old_n {
        f.block_insts.push(f.block_insts[old_s + k])
    }
    f.blocks[bb].inst_start = new_s
    f.blocks[bb].inst_len = old_n + 1
    res_val
}

pub fn append_block_inst_id(f: &mut SsaFunc, bb: i32, iid: i32) {
    idx := f.block_insts.len
    f.block_insts.push(iid)
    if f.blocks[bb].inst_len == 0 {
        f.blocks[bb].inst_start = idx
        f.blocks[bb].inst_len = 1
    } else if f.blocks[bb].inst_start + f.blocks[bb].inst_len == idx {
        f.blocks[bb].inst_len += 1
    } else {
        old_s := f.blocks[bb].inst_start
        old_n := f.blocks[bb].inst_len
        new_s := f.block_insts.len - 1
        last := f.block_insts[new_s]
        f.block_insts[new_s] = f.block_insts[old_s]
        for k in 1..old_n {
            f.block_insts.push(f.block_insts[old_s + k])
        }
        f.block_insts.push(last)
        f.blocks[bb].inst_start = new_s
        f.blocks[bb].inst_len = old_n + 1
    }
}

pub fn make_term(kind: SsaTermKind) -> SsaTerm {
    SsaTerm {
        kind: kind,
        target_a: -1,
        target_b: -1,
        cond_val: -1,
        env_val: -1,
        callee: -1,
        sig_ty: -1,
        aux_ty: -1,
        dest_val: -1,
        arg_start: 0,
        arg_len: 0,
        arg2_start: 0,
        arg2_len: 0,
        case_start: 0,
        case_len: 0,
        span_start: 0,
        span_end: 0,
    }
}

pub fn set_term(f: &mut SsaFunc, bb: i32, term: SsaTerm) -> i32 {
    tid := f.terms.len
    f.terms.push(term)
    f.blocks[bb].term_id = tid
    tid
}

pub fn set_goto(f: &mut SsaFunc, bb: i32, target_bb: i32, args: &[]i32, span_s: i32, span_e: i32) -> i32 {
    a_start := push_val_args(&mut f, &args)
    mut tm := make_term(.Goto)
    tm.target_a = target_bb
    tm.arg_start = a_start
    tm.arg_len = args.len
    tm.span_start = span_s
    tm.span_end = span_e
    set_term(&mut f, bb, tm)
}

pub fn set_branch(f: &mut SsaFunc, bb: i32, cond: i32,
    then_bb: i32, then_args: &[]i32,
    else_bb: i32, else_args: &[]i32,
    span_s: i32, span_e: i32) -> i32 {
    a1 := push_val_args(&mut f, &then_args)
    a2 := push_val_args(&mut f, &else_args)
    mut tm := make_term(.Branch)
    tm.cond_val = cond
    tm.target_a = then_bb
    tm.arg_start = a1
    tm.arg_len = then_args.len
    tm.target_b = else_bb
    tm.arg2_start = a2
    tm.arg2_len = else_args.len
    tm.span_start = span_s
    tm.span_end = span_e
    set_term(&mut f, bb, tm)
}

pub fn push_switch_cases(f: &mut SsaFunc, vals: &[]i64, bbs: &[]i32) -> i32 {
    start := f.switch_vals.len
    for i in 0..vals.len {
        f.switch_vals.push(vals[i])
        f.switch_bbs.push(bbs[i])
        f.switch_arg_starts.push(0)
        f.switch_arg_lens.push(0)
    }
    start
}

pub fn set_return(f: &mut SsaFunc, bb: i32, val: i32, span_s: i32, span_e: i32) -> i32 {
    mut tm := make_term(.Return)
    tm.cond_val = val
    tm.span_start = span_s
    tm.span_end = span_e
    set_term(&mut f, bb, tm)
}

pub fn set_trap(f: &mut SsaFunc, bb: i32, code: i32, span_s: i32, span_e: i32) -> i32 {
    mut tm := make_term(.Trap)
    tm.callee = code
    tm.span_start = span_s
    tm.span_end = span_e
    set_term(&mut f, bb, tm)
}

// Convenience instruction emitters
pub fn emit_const_int(f: &mut SsaFunc, bb: i32, ty: i32, val: i64, span_s: i32, span_e: i32) -> i32 {
    emit_inst(&mut f, bb, make_inst(.ConstInt, ty, -1, -1, -1, 0, -1, val, -1, 0, 0, span_s, span_e))
}

pub fn emit_slot_addr(f: &mut SsaFunc, bb: i32, ptr_ty: i32, slot_id: i32, offset: i64, span_s: i32, span_e: i32) -> i32 {
    emit_inst(&mut f, bb, make_inst(.SlotAddr, ptr_ty, -1, -1, -1, slot_id, -1, offset, -1, 0, 0, span_s, span_e))
}

pub fn emit_load(f: &mut SsaFunc, bb: i32, ty: i32, addr: i32, offset: i64, slot_hint: i32, span_s: i32, span_e: i32) -> i32 {
    emit_inst(&mut f, bb, make_inst(.Load, ty, addr, -1, -1, slot_hint, -1, offset, -1, 0, 0, span_s, span_e))
}

pub fn emit_store(f: &mut SsaFunc, bb: i32, val_ty: i32, addr: i32, val: i32, offset: i64, slot_hint: i32, span_s: i32, span_e: i32) {
    _ := emit_inst(&mut f, bb, make_inst(.Store, val_ty, addr, val, -1, slot_hint, -1, offset, -1, 0, 0, span_s, span_e))
}

pub fn emit_copy(f: &mut SsaFunc, bb: i32, ty: i32, src: i32, span_s: i32, span_e: i32) -> i32 {
    emit_inst(&mut f, bb, make_inst(.Copy, ty, src, -1, -1, 0, -1, 0, -1, 0, 0, span_s, span_e))
}

pub fn emit_binary(f: &mut SsaFunc, bb: i32, ty: i32, binop: i32, lhs: i32, rhs: i32, span_s: i32, span_e: i32) -> i32 {
    emit_inst(&mut f, bb, make_inst(.Binary, ty, lhs, rhs, -1, binop, -1, 0, -1, 0, 0, span_s, span_e))
}

pub fn emit_unary(f: &mut SsaFunc, bb: i32, ty: i32, unop: i32, op: i32, span_s: i32, span_e: i32) -> i32 {
    emit_inst(&mut f, bb, make_inst(.Unary, ty, op, -1, -1, unop, -1, 0, -1, 0, 0, span_s, span_e))
}

pub fn emit_cast(f: &mut SsaFunc, bb: i32, target_ty: i32, op: i32, span_s: i32, span_e: i32) -> i32 {
    emit_inst(&mut f, bb, make_inst(.Cast, target_ty, op, -1, -1, 0, target_ty, 0, -1, 0, 0, span_s, span_e))
}

// =========================================================================
// CFG Successors, Predecessors & Dominator Tree (Cooper-Harvey-Kennedy)
// =========================================================================

pub fn term_succs(f: &SsaFunc, bb: i32, out: &mut []i32) {
    out.clear()
    tid := f.blocks[bb].term_id
    if tid < 0 || tid >= f.terms.len { return }
    tm := f.terms[tid]
    if tm.kind == .Goto || tm.kind == .Call || tm.kind == .IndirectCall ||
        tm.kind == .ExternCall || tm.kind == .IntrinsicCall ||
        tm.kind == .TaskScopeEnter || tm.kind == .TaskScopeJoin ||
        tm.kind == .RegionEnter || tm.kind == .RegionExit {
        if tm.target_a >= 0 { out.push(tm.target_a) }
    } else if tm.kind == .Branch {
        if tm.target_a >= 0 { out.push(tm.target_a) }
        if tm.target_b >= 0 { out.push(tm.target_b) }
    } else if tm.kind == .Switch {
        for i in 0..tm.case_len {
            out.push(f.switch_bbs[tm.case_start + i])
        }
        if tm.target_a >= 0 { out.push(tm.target_a) }
    }
}

pub fn compute_preds(f: &mut SsaFunc) {
    n := f.blocks.len
    mut counts: []i32 = []
    for _ in 0..n { counts.push(0) }
    mut succs: []i32 = []
    for bb in 0..n {
        term_succs(&f, bb, &mut succs)
        for i in 0..succs.len {
            s := succs[i]
            if s >= 0 && s < n { counts[s] += 1 }
        }
    }
    f.preds.clear()
    mut total := 0
    for bb in 0..n {
        f.blocks[bb].pred_start = total
        f.blocks[bb].pred_len = 0
        total += counts[bb]
    }
    for _ in 0..total { f.preds.push(-1) }
    for bb in 0..n {
        term_succs(&f, bb, &mut succs)
        for i in 0..succs.len {
            s := succs[i]
            if s >= 0 && s < n {
                pos := f.blocks[s].pred_start + f.blocks[s].pred_len
                f.preds[pos] = bb
                f.blocks[s].pred_len += 1
            }
        }
    }
}

fn intersect_dom(idom: &[]i32, rpo_num: &[]i32, b1_in: i32, b2_in: i32) -> i32 {
    mut f1 := b1_in
    mut f2 := b2_in
    while f1 != f2 {
        while rpo_num[f1] > rpo_num[f2] {
            f1 = idom[f1]
        }
        while rpo_num[f2] > rpo_num[f1] {
            f2 = idom[f2]
        }
    }
    f1
}

pub fn compute_doms(f: &SsaFunc) -> DomTree {
    n := f.blocks.len
    mut idom: []i32 = []
    mut rpo_num: []i32 = []
    mut visited: []bool = []
    for _ in 0..n {
        idom.push(-1)
        rpo_num.push(-1)
        visited.push(false)
    }
    mut rpo_order: []i32 = []
    mut dom_child_start: []i32 = []
    mut dom_child_len: []i32 = []
    mut dom_children: []i32 = []
    for _ in 0..n {
        dom_child_start.push(0)
        dom_child_len.push(0)
    }
    if n == 0 {
        return DomTree {
            idom: move idom,
            rpo_order: move rpo_order,
            rpo_num: move rpo_num,
            dom_child_start: move dom_child_start,
            dom_child_len: move dom_child_len,
            dom_children: move dom_children,
        }
    }

    // Iterative DFS post-order from entry block 0
    mut post: []i32 = []
    mut stack_bb: []i32 = [0]
    mut stack_si: []i32 = [0]
    visited[0] = true
    mut succs: []i32 = []
    while stack_bb.len > 0 {
        top := stack_bb.len - 1
        bb := stack_bb[top]
        si := stack_si[top]
        term_succs(&f, bb, &mut succs)
        mut pushed := false
        mut k := si
        while k < succs.len {
            s := succs[k]
            k += 1
            if s >= 0 && s < n && !visited[s] {
                visited[s] = true
                stack_si[top] = k
                stack_bb.push(s)
                stack_si.push(0)
                pushed = true
                break
            }
        }
        if !pushed {
            _ := stack_bb.pop()
            _ := stack_si.pop()
            post.push(bb)
        }
    }

    // Reverse post-order
    mut pi := post.len - 1
    while pi >= 0 {
        bb := post[pi]
        rpo_num[bb] = rpo_order.len
        rpo_order.push(bb)
        pi -= 1
    }

    // Cooper-Harvey-Kennedy iterative dominator fixpoint
    idom[0] = 0
    mut changed := true
    while changed {
        changed = false
        for ri in 1..rpo_order.len {
            b := rpo_order[ri]
            ps := f.blocks[b].pred_start
            pl := f.blocks[b].pred_len
            mut new_idom := -1
            for k in 0..pl {
                p := f.preds[ps + k]
                if p >= 0 && p < n && idom[p] >= 0 {
                    if new_idom < 0 {
                        new_idom = p
                    } else {
                        new_idom = intersect_dom(&idom, &rpo_num, p, new_idom)
                    }
                }
            }
            if new_idom >= 0 && idom[b] != new_idom {
                idom[b] = new_idom
                changed = true
            }
        }
    }

    // Build dominator tree children lists (in RPO order)
    mut c_counts: []i32 = []
    for _ in 0..n { c_counts.push(0) }
    for ri in 1..rpo_order.len {
        b := rpo_order[ri]
        d := idom[b]
        if d >= 0 && d != b { c_counts[d] += 1 }
    }
    mut tot := 0
    for bb in 0..n {
        dom_child_start[bb] = tot
        dom_child_len[bb] = 0
        tot += c_counts[bb]
    }
    for _ in 0..tot { dom_children.push(-1) }
    for ri in 1..rpo_order.len {
        b := rpo_order[ri]
        d := idom[b]
        if d >= 0 && d != b {
            pos := dom_child_start[d] + dom_child_len[d]
            dom_children[pos] = b
            dom_child_len[d] += 1
        }
    }

    DomTree {
        idom: move idom,
        rpo_order: move rpo_order,
        rpo_num: move rpo_num,
        dom_child_start: move dom_child_start,
        dom_child_len: move dom_child_len,
        dom_children: move dom_children,
    }
}

pub fn dominates(dom: &DomTree, a: i32, b: i32) -> bool {
    if a < 0 || b < 0 || a >= dom.idom.len || b >= dom.idom.len { return false }
    if dom.idom[a] < 0 || dom.idom[b] < 0 { return false }
    mut cur := b
    while cur != a {
        next := dom.idom[cur]
        if next < 0 || next == cur { return false }
        cur = next
    }
    true
}

pub fn strictly_dominates(dom: &DomTree, a: i32, b: i32) -> bool {
    a != b && dominates(&dom, a, b)
}

pub fn compute_dom_frontiers(f: &SsaFunc, dom: &DomTree) -> DomFrontiers {
    n := f.blocks.len
    mut df_start: []i32 = []
    mut df_len: []i32 = []
    mut df_nodes: []i32 = []
    for _ in 0..n { df_start.push(0); df_len.push(0) }

    // Collect (owner, target) pairs then group per owner without duplicates.
    mut pair_owner: []i32 = []
    mut pair_target: []i32 = []
    for ri in 0..dom.rpo_order.len {
        b := dom.rpo_order[ri]
        pl := f.blocks[b].pred_len
        if pl < 2 { continue }
        ps := f.blocks[b].pred_start
        for k in 0..pl {
            p := f.preds[ps + k]
            if p < 0 || dom.idom[p] < 0 { continue }
            mut runner := p
            while runner >= 0 && runner != dom.idom[b] {
                pair_owner.push(runner)
                pair_target.push(b)
                next := dom.idom[runner]
                if next == runner { break }
                runner = next
            }
        }
    }

    mut counts: []i32 = []
    for _ in 0..n { counts.push(0) }
    for i in 0..pair_owner.len { counts[pair_owner[i]] += 1 }
    mut total := 0
    for bb in 0..n {
        df_start[bb] = total
        df_len[bb] = 0
        total += counts[bb]
    }
    for _ in 0..total { df_nodes.push(-1) }
    for i in 0..pair_owner.len {
        o := pair_owner[i]
        t := pair_target[i]
        s := df_start[o]
        l := df_len[o]
        mut dup := false
        for k in 0..l {
            if df_nodes[s + k] == t { dup = true; break }
        }
        if !dup {
            df_nodes[s + l] = t
            df_len[o] = l + 1
        }
    }

    DomFrontiers {
        df_start: move df_start,
        df_len: move df_len,
        df_nodes: move df_nodes,
    }
}

// Find instruction's ordinal position inside `bb` (-1 if not present).
pub fn find_inst_pos_in_bb(f: &SsaFunc, bb: i32, inst_id: i32) -> i32 {
    if bb < 0 || bb >= f.blocks.len { return -1 }
    s := f.blocks[bb].inst_start
    n := f.blocks[bb].inst_len
    for i in 0..n {
        if f.block_insts[s + i] == inst_id { return i }
    }
    -1
}

// Check if `val_id`'s definition strictly dominates instruction at ordinal `use_pos` in `use_bb`.
pub fn val_dominates_inst(f: &SsaFunc, dom: &DomTree, val_id: i32, use_bb: i32, use_pos: i32) -> bool {
    if val_id < 0 || val_id >= f.vals.len { return false }
    v := f.vals[val_id]
    if v.def_bb < 0 || v.def_bb >= f.blocks.len { return false }
    if v.def_inst == DEF_FN_PARAM {
        return dominates(&dom, 0, use_bb)
    }
    if v.def_bb == use_bb {
        if v.def_inst == DEF_BLOCK_PARAM { return true }
        if v.def_inst == DEF_TERM_RESULT { return false }
        def_pos := find_inst_pos_in_bb(&f, use_bb, v.def_inst)
        return def_pos >= 0 && def_pos < use_pos
    }
    strictly_dominates(&dom, v.def_bb, use_bb)
}

// Check if `val_id`'s definition dominates the terminator of `use_bb`.
pub fn val_dominates_term(f: &SsaFunc, dom: &DomTree, val_id: i32, use_bb: i32) -> bool {
    if val_id < 0 || val_id >= f.vals.len { return false }
    v := f.vals[val_id]
    if v.def_bb < 0 || v.def_bb >= f.blocks.len { return false }
    if v.def_inst == DEF_FN_PARAM {
        return dominates(&dom, 0, use_bb)
    }
    if v.def_bb == use_bb {
        if v.def_inst == DEF_BLOCK_PARAM { return true }
        if v.def_inst == DEF_TERM_RESULT { return false }
        return find_inst_pos_in_bb(&f, use_bb, v.def_inst) >= 0
    }
    strictly_dominates(&dom, v.def_bb, use_bb)
}

// Helper: is `ty` a pointer/address type?
pub fn is_addr_ty(types: &ht.TypeTable, ty: i32) -> bool {
    if ty < 0 || ty >= types.entries.len { return false }
    k := types.entries[ty].kind
    k == .Ptr || k == .Ref || k == .MutRef || k == .RawConst || k == .RawMut
}

pub fn is_int_ty(types: &ht.TypeTable, ty: i32) -> bool {
    if ty < 0 || ty >= types.entries.len { return false }
    k := types.entries[ty].kind
    k == .I8 || k == .I16 || k == .I32 || k == .I64 || k == .Isize ||
    k == .U8 || k == .U16 || k == .U32 || k == .U64 || k == .Usize || k == .Rune
}

pub fn is_unsigned_int_ty(types: &ht.TypeTable, ty: i32) -> bool {
    if ty < 0 || ty >= types.entries.len { return false }
    k := types.entries[ty].kind
    k == .U8 || k == .U16 || k == .U32 || k == .U64 || k == .Usize || k == .Rune
}

pub fn is_float_ty(types: &ht.TypeTable, ty: i32) -> bool {
    if ty < 0 || ty >= types.entries.len { return false }
    k := types.entries[ty].kind
    k == .F32 || k == .F64
}

pub fn is_fat_ty(types: &ht.TypeTable, ty: i32) -> bool {
    if ty < 0 || ty >= types.entries.len { return false }
    k := types.entries[ty].kind
    k == .FatStr || k == .FatSlice || k == .RegionSlice
}
