// Frontend type registry, layout validation, and O(1) type indexing.
// Owns all nominal, compound, fixed-array, callable, and C-layout tables
// without circularly depending on the compiler Session or AST/parser state.
import ffi_arm64 as abi
import std.map as map

pub struct TypeRegistry {
    type_names: []string, type_kinds: []i32, type_bases: []i32, type_starts: []i32, type_counts: []i32,
    type_clones: []i32, type_drops: []i32,
    field_names: []string, field_types: []i32, field_values: []i64,
    payload_starts: []i32, payload_counts: []i32, payload_types: []i32,
    opaque_owner: []i32, c_record: []bool, c_sizes: []i32, c_aligns: []i32,
    ffi_params: []i32,
    named_map: map.Map,
    compound_buckets: []i32, compound_count: i32,
    fixed_buckets: []i32, fixed_count: i32,
    callable_buckets: []i32, callable_count: i32,
    error: string,
}

pub fn new_registry() -> TypeRegistry {
    var named := map.new()
    map.reserve(&mut named, 64)
    TypeRegistry {
        type_names: [], type_kinds: [], type_bases: [], type_starts: [], type_counts: [],
        type_clones: [], type_drops: [],
        field_names: [], field_types: [], field_values: [],
        payload_starts: [], payload_counts: [], payload_types: [],
        opaque_owner: [], c_record: [], c_sizes: [], c_aligns: [],
        ffi_params: [],
        named_map: named,
        compound_buckets: [], compound_count: 0,
        fixed_buckets: [], fixed_count: 0,
        callable_buckets: [], callable_count: 0,
        error: "",
    }
}

pub fn set_error(reg: &mut TypeRegistry, message: string) {
    if reg.error == "" { reg.error = message }
}

pub fn add_type(reg: &mut TypeRegistry, clone_label: i32, drop_label: i32, name: string, kind: i32, base: i32) -> i32 {
    id := reg.type_names.len
    reg.opaque_owner.push(-1); reg.c_record.push(false); reg.c_sizes.push(0); reg.c_aligns.push(0)
    reg.type_names.push(name); reg.type_kinds.push(kind); reg.type_bases.push(base)
    reg.type_starts.push(0); reg.type_counts.push(0)
    reg.type_clones.push(clone_label); reg.type_drops.push(drop_label)
    if name != "" && !map.contains(&reg.named_map, name) {
        map.put(&mut reg.named_map, name, i64(id))
    }
    id
}

pub fn type_id(reg: &TypeRegistry, name: string) -> i32 {
    if name == "" { return -1 }
    i32(map.get_or(&reg.named_map, name, -1))
}

pub fn scalar_element(reg: &TypeRegistry, ty: i32) -> bool {
    (ty >= 1 && ty <= 13) || reg.type_kinds[ty] == 3 || reg.type_kinds[ty] == 22
}

pub fn foreign_scalar(reg: &TypeRegistry, ty: i32) -> bool {
    ty == 1 || ty == 2 || (ty >= 6 && ty <= 13) || reg.type_kinds[ty] == 8
}

pub fn foreign_width(ty: i32) -> i32 { abi.width(ty) }

pub fn storage_type(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    if reg.type_kinds[ty] == 3 { return 1 }
    if platform == 3 && (ty == 12 || ty == 13 || reg.type_kinds[ty] == 8 || reg.type_kinds[ty] == 9) { return 10 }
    ty
}

pub fn scalar_bytes(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    if ty == 3 || ty == 8 { return 1 }
    if ty == 9 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 || reg.type_kinds[ty] == 3 { return 4 }
    if platform == 3 && (ty == 12 || ty == 13 || reg.type_kinds[ty] == 8) { return 4 }
    8
}

pub fn collection(reg: &TypeRegistry, ty: i32) -> bool {
    reg.type_kinds[ty] == 1 || reg.type_kinds[ty] == 6 || reg.type_kinds[ty] == 10
}

pub fn owned(reg: &TypeRegistry, ty: i32) -> bool {
    ty == 4 || collection(&reg, ty) || reg.type_kinds[ty] == 2 || reg.type_kinds[ty] == 7
}

pub fn enum_type(reg: &TypeRegistry, ty: i32) -> bool {
    ty >= 0 && (reg.type_kinds[ty] == 3 || reg.type_kinds[ty] == 7)
}

pub fn fixed_pod(reg: &TypeRegistry, ty: i32) -> bool {
    reg.type_kinds[ty] == 6 && (foreign_scalar(&reg, reg.type_bases[ty]) || reg.type_bases[ty] == 3)
}

pub fn field(reg: &TypeRegistry, ty: i32, name: string) -> i32 {
    first := reg.type_starts[ty]
    for i in first..first + reg.type_counts[ty] {
        if reg.field_names[i] == name { return i }
    }
    -1
}

pub fn scalar_type(reg: &TypeRegistry, ty: i32) -> i32 {
    if ty >= 0 && ty <= 3 { return ty }
    if reg.type_kinds[ty] == 4 || reg.type_kinds[ty] == 5 {
        array := reg.type_bases[ty]
        if reg.type_kinds[array] == 1 && reg.type_bases[array] == 2 {
            if reg.type_kinds[ty] == 5 { return 21 }
            return 20
        }
    }
    -1
}

fn hash2(a: i32, b: i32, capacity: i32) -> i32 {
    var value := i64(a).bit_xor(i64(b).shl(32))
    value = value.bit_xor(value.shr(30)).wrapping_mul(-4658895280553007687)
    value = value.bit_xor(value.shr(27)).wrapping_mul(-7723592293110705685)
    value = value.bit_xor(value.shr(31))
    i32(value.bit_and(i64(capacity - 1)))
}

fn callable_hash(kind: i32, result: i32, args: &[]i32, capacity: i32) -> i32 {
    var value := i64(kind).wrapping_mul(1000003).bit_xor(i64(result).wrapping_mul(2654435761))
    value = value.bit_xor(i64(args.len).wrapping_mul(-4658895280553007687))
    for arg in args {
        value = value.wrapping_mul(131).bit_xor(i64(arg) + 1)
    }
    value = value.bit_xor(value.shr(30)).wrapping_mul(-7723592293110705685)
    value = value.bit_xor(value.shr(31))
    i32(value.bit_and(i64(capacity - 1)))
}

fn grow_compound(reg: &mut TypeRegistry) {
    var capacity := 64
    if reg.compound_buckets.len > 0 { capacity = reg.compound_buckets.len * 2 }
    var fresh: []i32 = []
    fresh.reserve(capacity)
    for i in 0..capacity { fresh.push(0) }
    for i in 0..reg.compound_buckets.len {
        entry := reg.compound_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        var slot := hash2(reg.type_kinds[ty], reg.type_bases[ty], capacity)
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.compound_buckets = fresh
}

fn grow_fixed(reg: &mut TypeRegistry) {
    var capacity := 32
    if reg.fixed_buckets.len > 0 { capacity = reg.fixed_buckets.len * 2 }
    var fresh: []i32 = []
    fresh.reserve(capacity)
    for i in 0..capacity { fresh.push(0) }
    for i in 0..reg.fixed_buckets.len {
        entry := reg.fixed_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        var slot := hash2(reg.type_bases[ty], reg.type_counts[ty], capacity)
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.fixed_buckets = fresh
}

fn grow_callable(reg: &mut TypeRegistry) {
    var capacity := 32
    if reg.callable_buckets.len > 0 { capacity = reg.callable_buckets.len * 2 }
    var fresh: []i32 = []
    fresh.reserve(capacity)
    for i in 0..capacity { fresh.push(0) }
    for i in 0..reg.callable_buckets.len {
        entry := reg.callable_buckets[i]
        if entry == 0 { continue }
        ty := entry - 1
        var value := i64(reg.type_kinds[ty]).wrapping_mul(1000003).bit_xor(i64(reg.type_bases[ty]).wrapping_mul(2654435761))
        count := reg.type_counts[ty]
        value = value.bit_xor(i64(count).wrapping_mul(-4658895280553007687))
        first := reg.type_starts[ty]
        for p in 0..count { value = value.wrapping_mul(131).bit_xor(i64(reg.ffi_params[first + p]) + 1) }
        value = value.bit_xor(value.shr(30)).wrapping_mul(-7723592293110705685)
        value = value.bit_xor(value.shr(31))
        var slot := i32(value.bit_and(i64(capacity - 1)))
        while fresh[slot] != 0 { slot = (slot + 1).bit_and(capacity - 1) }
        fresh[slot] = entry
    }
    reg.callable_buckets = fresh
}

pub fn find_or_check_compound(reg: &mut TypeRegistry, kind: i32, base: i32) -> i32 {
    if (kind == 4 || kind == 5) && (base == 0 || reg.type_kinds[base] == 4 || reg.type_kinds[base] == 5) {
        set_error(&mut reg, "reference a value type"); return -2
    }
    if kind == 1 && !scalar_element(&reg, base) {
        set_error(&mut reg, "arrays of aggregate elements are not supported by this compiler")
    }
    if reg.compound_buckets.len > 0 {
        cap := reg.compound_buckets.len
        var slot := hash2(kind, base, cap)
        while reg.compound_buckets[slot] != 0 {
            ty := reg.compound_buckets[slot] - 1
            if reg.type_kinds[ty] == kind && reg.type_bases[ty] == base { return ty }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_compound(reg: &mut TypeRegistry, clone_label: i32, drop_label: i32, kind: i32, base: i32) -> i32 {
    if reg.compound_buckets.len == 0 || (reg.compound_count + 1) * 2 > reg.compound_buckets.len {
        grow_compound(&mut reg)
    }
    id := add_type(&mut reg, clone_label, drop_label, "", kind, base)
    cap := reg.compound_buckets.len
    var slot := hash2(kind, base, cap)
    while reg.compound_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.compound_buckets[slot] = id + 1
    reg.compound_count = reg.compound_count + 1
    id
}

pub fn find_or_check_fixed(reg: &mut TypeRegistry, platform: i32, base: i32, length: i32) -> i32 {
    if !scalar_element(&reg, base) {
        set_error(&mut reg, "arrays of aggregate elements are not supported by this compiler")
    }
    if length > 65536 / scalar_bytes(&reg, base, platform) {
        set_error(&mut reg, "fixed array exceeds 65536 bytes"); return -2
    }
    if reg.fixed_buckets.len > 0 {
        cap := reg.fixed_buckets.len
        var slot := hash2(base, length, cap)
        while reg.fixed_buckets[slot] != 0 {
            ty := reg.fixed_buckets[slot] - 1
            if reg.type_kinds[ty] == 6 && reg.type_bases[ty] == base && reg.type_counts[ty] == length { return ty }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_fixed(reg: &mut TypeRegistry, clone_label: i32, drop_label: i32, base: i32, length: i32) -> i32 {
    if reg.fixed_buckets.len == 0 || (reg.fixed_count + 1) * 2 > reg.fixed_buckets.len {
        grow_fixed(&mut reg)
    }
    ty := add_type(&mut reg, clone_label, drop_label, "", 6, base)
    reg.type_counts[ty] = length
    cap := reg.fixed_buckets.len
    var slot := hash2(base, length, cap)
    while reg.fixed_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.fixed_buckets[slot] = ty + 1
    reg.fixed_count = reg.fixed_count + 1
    ty
}

pub fn find_or_check_callable(reg: &mut TypeRegistry, args: &[]i32, result: i32, kind: i32) -> i32 {
    for ty in args {
        if kind == 8 && !foreign_scalar(&reg, ty) && !reg.c_record[ty] {
            set_error(&mut reg, "C calls require scalar parameters or a record pointer"); return -2
        }
    }
    if kind == 8 && result != 0 && !foreign_scalar(&reg, result) && !reg.c_record[result] {
        set_error(&mut reg, "C calls require scalar return types"); return -2
    }
    if reg.callable_buckets.len > 0 {
        cap := reg.callable_buckets.len
        var slot := callable_hash(kind, result, &args, cap)
        while reg.callable_buckets[slot] != 0 {
            t := reg.callable_buckets[slot] - 1
            if reg.type_kinds[t] == kind && reg.type_bases[t] == result && reg.type_counts[t] == args.len {
                var equal := true
                first := reg.type_starts[t]
                for i in 0..args.len {
                    if reg.ffi_params[first + i] != args[i] { equal = false; break }
                }
                if equal { return t }
            }
            slot = (slot + 1).bit_and(cap - 1)
        }
    }
    -1
}

pub fn insert_callable(reg: &mut TypeRegistry, clone_label: i32, drop_label: i32, args: &[]i32, result: i32, kind: i32) -> i32 {
    if reg.callable_buckets.len == 0 || (reg.callable_count + 1) * 2 > reg.callable_buckets.len {
        grow_callable(&mut reg)
    }
    t := add_type(&mut reg, clone_label, drop_label, "", kind, result)
    reg.type_starts[t] = reg.ffi_params.len; reg.type_counts[t] = args.len
    for arg in args { reg.ffi_params.push(arg) }
    cap := reg.callable_buckets.len
    var slot := callable_hash(kind, result, &args, cap)
    while reg.callable_buckets[slot] != 0 { slot = (slot + 1).bit_and(cap - 1) }
    reg.callable_buckets[slot] = t + 1
    reg.callable_count = reg.callable_count + 1
    t
}

pub fn type_spelling(reg: &TypeRegistry, ty: i32) -> string {
    kind := reg.type_kinds[ty]
    if reg.type_names[ty] != "" { return reg.type_names[ty] }
    if kind == 8 || kind == 9 {
        var args := ""
        for i in 0..reg.type_counts[ty] {
            if i > 0 { args = args + ", " }
            args = args + type_spelling(&reg, reg.ffi_params[reg.type_starts[ty] + i])
        }
        var fn_name := "fn"; if kind == 8 { fn_name = "extern fn" }
        return fn_name + "(" + args + ") -> " + type_spelling(&reg, reg.type_bases[ty])
    }
    if kind == 20 { return "region" }
    if kind == 22 { return "TaskID<" + type_spelling(&reg, reg.type_bases[ty]) + ">" }
    if kind == 23 { return "task scope" }
    base := type_spelling(&reg, reg.type_bases[ty])
    if kind == 1 || kind == 21 { return "[]" + base }
    if kind == 6 { return "[" + base + "; " + reg.type_counts[ty].str() + "]" }
    if kind == 4 { return "&" + base }
    if kind == 5 { return "&mut " + base }
    if kind == 10 { return "iter<" + base + ">" }
    base
}

// Positive counts denote homogeneous f32 members, negative counts homogeneous f64.
pub fn hfa(reg: &TypeRegistry, ty: i32, depth: i32) -> i32 {
    if depth > 64 { return 0 }
    if ty == 6 { return 1 }
    if ty == 7 { return -1 }
    if reg.type_kinds[ty] == 6 {
        count := reg.type_counts[ty]; if count > 4 { return 0 }
        return count * hfa(&reg, reg.type_bases[ty], depth + 1)
    }
    if !reg.c_record[ty] { return 0 }
    var shape := 0
    for index in reg.type_starts[ty]..reg.type_starts[ty] + reg.type_counts[ty] {
        part := hfa(&reg, reg.field_types[index], depth + 1)
        if part == 0 || (shape > 0 && part < 0) || (shape < 0 && part > 0) { return 0 }
        shape = shape + part
        if shape < -4 || shape > 4 { return 0 }
    }
    shape
}

pub fn c_layout(reg: &mut TypeRegistry, platform: i32, ty: i32) {
    if reg.error != "" || reg.c_aligns[ty] > 0 { return }
    if reg.c_aligns[ty] < 0 { set_error(&mut reg, "recursive C layout"); return }
    reg.c_aligns[ty] = -1
    var size := 0; var alignment := 1
    if reg.c_record[ty] {
        first := reg.type_starts[ty]
        for field_index in first..first + reg.type_counts[ty] {
            ft := reg.field_types[field_index]; c_layout(&mut reg, platform, ft)
            if reg.error != "" { return }
            child := reg.c_aligns[ft]
            if size > 2147483647 - child || reg.c_sizes[ft] > 2147483647 - child - size {
                set_error(&mut reg, "C record layout exceeds supported size"); return
            }
            size = (size + child - 1) / child * child
            reg.field_values[field_index] = i64(size)
            if child > alignment { alignment = child }
            size = size + reg.c_sizes[ft]
        }
        if size == 0 { set_error(&mut reg, "empty C record"); return }
        size = (size + alignment - 1) / alignment * alignment
    } else if reg.type_kinds[ty] == 6 {
        child := reg.type_bases[ty]; c_layout(&mut reg, platform, child)
        if reg.error != "" { return }
        if reg.c_sizes[child] > 0 && reg.type_counts[ty] > 2147483647 / reg.c_sizes[child] {
            set_error(&mut reg, "C array layout exceeds supported size"); return
        }
        alignment = reg.c_aligns[child]; size = reg.type_counts[ty] * reg.c_sizes[child]
    } else if foreign_scalar(&reg, ty) || ty == 3 {
        alignment = foreign_width(ty); size = alignment
        if platform == 3 && (ty == 12 || ty == 13 || reg.type_kinds[ty] == 8) { size = 4; alignment = 4 }
    } else {
        set_error(&mut reg, "C layouts can contain only unmanaged C fields"); return
    }
    reg.c_aligns[ty] = alignment; reg.c_sizes[ty] = size
}

pub fn layout_bytes(reg: &mut TypeRegistry, platform: i32, ty: i32, depth: i32, sizes: &mut []i32) -> i32 {
    if reg.error != "" { return 1 }
    if sizes[ty] < 0 || depth >= 128 {
        set_error(&mut reg, "recursive or excessively nested inline value type"); return 1
    }
    if sizes[ty] > 0 { return sizes[ty] }
    kind := reg.type_kinds[ty]
    if kind == 1 { return 24 }
    if kind == 6 {
        bytes := reg.type_counts[ty] * scalar_bytes(&reg, reg.type_bases[ty], platform)
        if bytes == 0 { return 1 }; return bytes
    }
    if kind != 2 && kind != 7 {
        if ty == 0 || ty == 14 || kind == 10 { set_error(&mut reg, "invalid stored field type"); return 1 }
        return scalar_bytes(&reg, ty, platform)
    }
    if reg.c_record[ty] { return reg.c_sizes[ty] }
    sizes[ty] = -1
    var size := 0
    var max_align := 1
    for member in reg.type_starts[ty]..reg.type_starts[ty] + reg.type_counts[ty] {
        var offset := size
        var items := 1
        if kind == 7 { offset = 8; items = reg.payload_counts[member]; max_align = 8 }
        for item in 0..items {
            var ft := reg.field_types[member]
            if kind == 7 { ft = reg.payload_types[reg.payload_starts[member] + item] }
            width := layout_bytes(&mut reg, platform, ft, depth + 1, &mut sizes)
            if reg.error != "" { return 1 }
            var alignment := scalar_bytes(&reg, ft, platform)
            field_kind := reg.type_kinds[ft]
            if field_kind == 1 || field_kind == 2 || field_kind == 6 || field_kind == 7 { alignment = 8 }
            offset = (offset + alignment - 1) / alignment * alignment + width
            if offset > 65536 { set_error(&mut reg, "inline value exceeds 65536 bytes"); return 1 }
            if alignment > max_align { max_align = alignment }
        }
        if size < offset { size = offset }
    }
    if size == 0 { size = 1 }
    size = (size + max_align - 1) / max_align * max_align
    sizes[ty] = size
    size
}

pub fn validate_layouts(reg: &mut TypeRegistry, platform: i32) {
    var sizes: []i32 = []
    sizes.reserve(reg.type_kinds.len)
    for ty in reg.type_kinds { sizes.push(0) }
    for ty in 0..sizes.len {
        if reg.error != "" { return }
        kind := reg.type_kinds[ty]
        if (kind == 1 || kind == 6) && !scalar_element(&reg, reg.type_bases[ty]) {
            set_error(&mut reg, "arrays of aggregate elements are not supported by this compiler"); return
        }
        if kind == 2 || kind == 7 {
            size := layout_bytes(&mut reg, platform, ty, 0, &mut sizes)
            if size > 65536 { set_error(&mut reg, "inline value exceeds 65536 bytes") }
        }
    }
}

pub fn scratch_c_value(reg: &TypeRegistry, ty: i32) -> bool {
    if reg.c_record[ty] {
        for f in reg.type_starts[ty]..reg.type_starts[ty] + reg.type_counts[ty] {
            if !scratch_c_value(&reg, reg.field_types[f]) { return false }
        }
        return true
    }
    if reg.type_kinds[ty] == 6 { return scratch_c_value(&reg, reg.type_bases[ty]) }
    ty >= 1 && ty <= 12 && ty != 4
}

pub fn scratch_width(reg: &TypeRegistry, ty: i32, platform: i32) -> i32 {
    if reg.type_kinds[ty] == 2 {
        if reg.c_record[ty] {
            if scratch_c_value(&reg, ty) { return reg.c_sizes[ty] }
            return 0
        }
        for f in reg.type_starts[ty]..reg.type_starts[ty] + reg.type_counts[ty] {
            ft := reg.field_types[f]
            if ft < 1 || ft > 12 || ft == 4 { return 0 }
        }
        if reg.type_counts[ty] == 0 { return 1 }
        return reg.type_counts[ty] * 8
    }
    if ty < 1 || ty > 12 || ty == 4 { return 0 }
    foreign_width(storage_type(&reg, ty, platform))
}
