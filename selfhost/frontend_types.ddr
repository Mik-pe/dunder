// Authoritative semantic type storage. No Code, labels, imports or lowering.
// Transparent columns keep the existing hot indexed accesses. Session is the
// opaque owner; only these constructors write semantic rows after headers.
// layouts is explicitly a MUTABLE NONSEMANTIC computation cache: it is not
// part of the frozen declaration identity and is never a second type schema.
pub struct LayoutCache {
    c_sizes: []i32, c_aligns: []i32, field_offsets: []i64,
    inline_sizes: []i32, error: i32,
}
pub struct Arena {
    names: []string, kinds: []i32, bases: []i32, starts: []i32, counts: []i32,
    opaque_owner: []i32, c_record: []bool, complete: []bool,
    field_names: []string, field_types: []i32, field_values: []i64,
    payload_starts: []i32, payload_counts: []i32, payload_types: []i32,
    arguments: []i32, layouts: LayoutCache,
    sealed: bool, header_types: i32, header_fields: i32, header_payloads: i32, header_arguments: i32,
    error: i32,
}
pub fn new() -> Arena {
    Arena { names: [], kinds: [], bases: [], starts: [], counts: [], opaque_owner: [], c_record: [], complete: [],
        field_names: [], field_types: [], field_values: [], payload_starts: [], payload_counts: [], payload_types: [], arguments: [],
        layouts: LayoutCache { c_sizes: [], c_aligns: [], field_offsets: [], inline_sizes: [], error: 0 },
        sealed: false, header_types: 0, header_fields: 0, header_payloads: 0, header_arguments: 0, error: 0 }
}
fn error(a: &mut Arena, code: i32) { if a.error == 0 { a.error = code } }
// 1 borrow shape,2 aggregate array,3 fixed byte cap,4/5 C callable parameter/
// result,6 broken declaration lifecycle. The parser maps errors at its cursor.
pub fn error_message(code: i32) -> string {
    if code == 1 { "reference a value type" }
    else if code == 2 { "arrays of aggregate elements are not supported by this compiler" }
    else if code == 3 { "fixed array exceeds 65536 bytes" }
    else if code == 4 { "C calls require scalar parameters or a record pointer" }
    else if code == 5 { "C calls require scalar return types" }
    else { "internal semantic type lifecycle failure" }
}
pub fn scalar_element(a: &Arena, ty: i32) -> bool {
    (ty >= 1 && ty <= 13) || a.kinds[ty] == 3 || a.kinds[ty] == 22
}
pub fn scalar_bytes(a: &Arena, ty: i32, target: i32) -> i32 {
    if ty == 3 || ty == 8 { return 1 }; if ty == 9 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 || a.kinds[ty] == 3 { return 4 }
    if target == 3 && (ty == 12 || ty == 13 || a.kinds[ty] == 8) { return 4 }; 8
}
pub fn collection(a: &Arena, ty: i32) -> bool { a.kinds[ty] == 1 || a.kinds[ty] == 6 || a.kinds[ty] == 10 }
pub fn owned(a: &Arena, ty: i32) -> bool { ty == 4 || collection(&a, ty) || a.kinds[ty] == 2 || a.kinds[ty] == 7 }
pub fn foreign_scalar(a: &Arena, ty: i32) -> bool { ty == 1 || ty == 2 || (ty >= 6 && ty <= 13) || a.kinds[ty] == 8 }
pub fn storage_type(a: &Arena, ty: i32, target: i32) -> i32 {
    if a.kinds[ty] == 3 { return 1 }
    if target == 3 && (ty == 12 || ty == 13 || a.kinds[ty] == 8 || a.kinds[ty] == 9) { return 10 }; ty
}
fn append(a: &mut Arena, name: string, kind: i32, base: i32) -> i32 {
    if a.sealed && (name != "" || kind == 0 || kind == 2 || kind == 3 || kind == 7) { error(&mut a, 6); return 0 }
    id := a.names.len
    a.names.push(name); a.kinds.push(kind); a.bases.push(base); a.starts.push(0); a.counts.push(0)
    a.opaque_owner.push(-1); a.c_record.push(false); a.complete.push(kind != 2 && kind != 3)
    a.layouts.c_sizes.push(0); a.layouts.c_aligns.push(0); id
}
pub fn declare(a: &mut Arena, name: string, kind: i32, base: i32) -> i32 { a.error = 0; append(&mut a, name, kind, base) }
pub fn nominal(a: &mut Arena, name: string, kind: i32, c_record: bool, owner: i32) -> i32 {
    a.error = 0; id := append(&mut a, name, kind, 0)
    if a.error == 0 { a.c_record[id] = c_record; a.opaque_owner[id] = owner }; id
}
pub fn named(a: &Arena, name: string) -> i32 {
    for ty in 0..a.names.len { if a.names[ty] == name { return ty } }; -1
}
pub fn intern_compound(a: &mut Arena, kind: i32, base: i32) -> i32 {
    a.error = 0
    if (kind == 4 || kind == 5) && (base == 0 || a.kinds[base] == 4 || a.kinds[base] == 5) { error(&mut a, 1); return 0 }
    // Rejected aggregate arrays still follow the old row-discovery behavior;
    // the first source diagnostic remains the parser's responsibility.
    if kind == 1 && !scalar_element(&a, base) { error(&mut a, 2) }
    for ty in 0..a.names.len { if a.kinds[ty] == kind && a.bases[ty] == base { return ty } }
    append(&mut a, "", kind, base)
}
pub fn intern_fixed(a: &mut Arena, base: i32, length: i32, target: i32) -> i32 {
    a.error = 0
    if !scalar_element(&a, base) { error(&mut a, 2) }
    // This check PRECEDES interning, including an existing matching row.
    if length > 65536 / scalar_bytes(&a, base, target) { error(&mut a, 3); return 0 }
    for ty in 0..a.names.len { if a.kinds[ty] == 6 && a.bases[ty] == base && a.counts[ty] == length { return ty } }
    id := append(&mut a, "", 6, base); a.counts[id] = length; id
}
pub fn intern_callable(a: &mut Arena, args: &[]i32, result: i32, kind: i32) -> i32 {
    a.error = 0
    for at in 0..args.len {
        ty := args[at]
        if kind == 8 && !foreign_scalar(&a, ty) && !a.c_record[ty] { error(&mut a, 4); return 0 }
    }
    if kind == 8 && result != 0 && !foreign_scalar(&a, result) && !a.c_record[result] { error(&mut a, 5); return 0 }
    for ty in 0..a.names.len {
        if a.kinds[ty] == kind && a.bases[ty] == result && a.counts[ty] == args.len {
            var equal := true
            for at in 0..args.len { if a.arguments[a.starts[ty] + at] != args[at] { equal = false } }
            if equal { return ty }
        }
    }
    id := append(&mut a, "", kind, result); a.starts[id] = a.arguments.len; a.counts[id] = args.len
    for at in 0..args.len { a.arguments.push(args[at]) }; id
}
pub fn begin_fields(a: &mut Arena, ty: i32) -> bool {
    if a.sealed || a.complete[ty] { error(&mut a, 6); return false }; a.starts[ty] = a.field_names.len; true
}
pub fn payload_enum(a: &mut Arena, ty: i32) -> bool {
    if a.sealed || a.complete[ty] { error(&mut a, 6); return false }; a.kinds[ty] = 7; true
}
pub fn append_payload(a: &mut Arena, ty: i32) -> bool {
    if a.sealed { error(&mut a, 6); return false }; a.payload_types.push(ty); true
}
pub fn append_field(a: &mut Arena, name: string, ty: i32, value: i64, payload: i32) -> bool {
    if a.sealed { error(&mut a, 6); return false }
    a.payload_starts.push(payload); a.payload_counts.push(a.payload_types.len - payload)
    a.field_names.push(name); a.field_types.push(ty); a.field_values.push(value); a.layouts.field_offsets.push(0); true
}
pub fn finish_fields(a: &mut Arena, ty: i32) -> bool {
    if a.sealed || a.complete[ty] { error(&mut a, 6); return false }
    a.counts[ty] = a.field_names.len - a.starts[ty]; a.complete[ty] = true; true
}
pub fn seal_header(a: &mut Arena) -> bool {
    if a.sealed || a.error != 0 { return false }
    for ty in 0..a.names.len { if !a.complete[ty] { error(&mut a, 6); return false } }
    a.header_types = a.names.len; a.header_fields = a.field_names.len; a.header_payloads = a.payload_types.len; a.header_arguments = a.arguments.len
    a.sealed = true; true
}
