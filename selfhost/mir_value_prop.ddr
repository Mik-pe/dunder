// Exclusive bounded whole-function value optimization with sparse undo.
// The sole &mut Function borrow spans analysis, staging, verification and commit.
// Each point owns equivalence partitions for full64 and low32 bits, constants
// (TOP / exact / unknown), and a zero-extension fact. Unknowns never compare
// equal. Writes remove their register from EVERY class before assigning a new
// value, so re-executing a loop definition cannot alias its previous result.
// Joins intersect all reachable predecessors; no rewrite occurs before the
// descending fixpoint. No source names, encoded words, memory values or motion.
import mir
import mir_contract as core
import mir_scalar_contract as scalar
import mir_liveness as live
import mir_verify as verify

// Trusted producer premises, separate from Function metadata and NoReturn.
// Declaring a target promises that its terminal behavior has no observable
// dependence on incoming registers/flags or incoming user-memory contents.
// It must not return, invoke user code, format a value, or inspect a user
// pointer. Merely never returning does NOT establish this stronger promise.
// Epoch1 describes these semantics; labels carry no inferred source meaning.
pub opaque struct Context { valid: bool, epoch: i32, labels: []i32 }
pub fn policy_tag() -> string { "mir-value-terminal1" }
pub fn context(epoch: i32) -> Context { Context { valid: epoch == 1, epoch: epoch, labels: [] } }
pub fn declare_unobserving_terminal(ctx: &mut Context, label: i32) -> bool {
    if !ctx.valid || label < 0 { ctx.valid = false; return false }
    var at := 0
    while at < ctx.labels.len && ctx.labels[at] < label { at = at + 1 }
    if at < ctx.labels.len && ctx.labels[at] == label { return true }
    ctx.labels.push(label); var i := ctx.labels.len - 1
    while i > at { ctx.labels[i] = ctx.labels[i - 1]; i = i - 1 }
    ctx.labels[at] = label; true
}
// The current source producer may justify this premise for its six owned
// traps only: arm.runtime's overflow/zero/assertion/io and finish_image's
// float_trap/bounds enter arm.exit directly. That tail materializes its own
// constant status and syscall number, then terminates (or executes BRK).
// Native exit observes only that status; Wasm exit is unreachable. It neither
// dereferences an incoming pointer nor runs cleanup/callbacks. An allocator
// exhaustion tail or an I/O helper does not satisfy this proof. The caller
// must supply the actual owned label IDs; this module grants none implicitly.

pub opaque struct Workspace {
    candidate: mir.Function, verifier: verify.Workspace, liveness: live.Workspace,
    undo_slots: []i32, undo_ops: []i32, undo_modes: []i32, undo_starts: []i32, undo_rows: []i64,
    before_verified: bool, before_optimizable: bool, action: i32, immediate: bool, restored: i32,
    definitions: []i32,
    reached: []bool, queued: []bool, queue: []i32, pred_starts: []i32, pred_fill: []i32, predecessors: []i32,
    in_x: []i64, in_w: []i64, in_kx: []i32, in_vx: []i64, in_kw: []i32, in_vw: []i64, in_zero: []i64,
    out_x: []i64, out_w: []i64, out_kx: []i32, out_vx: []i64, out_kw: []i32, out_vw: []i64, out_zero: []i64,
    x: []i64, low: []i64, kx: []i32, vx: []i64, kw: []i32, vw: []i64, zero: i64,
    state: i32, work: i32, limit: i32, rewrites: i32, deleted: i32, immediates: i32, iterations: i32,
}
fn candidate() -> mir.Function { var f := mir.new(); op := mir.add(&mut f, 1); f }
pub fn new() -> Workspace {
    Workspace { candidate: candidate(), verifier: verify.new_work(), liveness: live.new(),
        undo_slots: [], undo_ops: [], undo_modes: [], undo_starts: [], undo_rows: [],
        before_verified: false, before_optimizable: false, action: 0, immediate: false, restored: 0,
        definitions: [], reached: [], queued: [], queue: [], pred_starts: [], pred_fill: [], predecessors: [],
        in_x: [], in_w: [], in_kx: [], in_vx: [], in_kw: [], in_vw: [], in_zero: [],
        out_x: [], out_w: [], out_kx: [], out_vx: [], out_kw: [], out_vw: [], out_zero: [],
        x: [], low: [], kx: [], vx: [], kw: [], vw: [], zero: 0,
        state: 0, work: 0, limit: 0, rewrites: 0, deleted: 0, immediates: 0, iterations: 0 }
}
pub fn status(w: &Workspace) -> i32 { w.state }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn rewritten(w: &Workspace) -> i32 { if w.state > 0 { w.rewrites } else { 0 } }
pub fn deleted(w: &Workspace) -> i32 { if w.state > 0 { w.deleted } else { 0 } }
pub fn constant_immediates(w: &Workspace) -> i32 { if w.state > 0 { w.immediates } else { 0 } }
pub fn fixpoint_visits(w: &Workspace) -> i32 { w.iterations }
// Diagnostic work count; failed transactions publish no optimization counters.
pub fn restored_rows(w: &Workspace) -> i32 { w.restored }
fn charge(w: &mut Workspace, n: i32) -> bool {
    if n < 0 || n > w.limit - w.work { w.state = -3; return false }; w.work = w.work + n; true
}
fn reset(w: &mut Workspace, limit: i32) {
    w.undo_slots.clear(); w.undo_ops.clear(); w.undo_modes.clear(); w.undo_starts.clear(); w.undo_rows.clear()
    w.action = 0; w.immediate = false; w.restored = 0; w.definitions.clear(); w.reached.clear(); w.queued.clear(); w.queue.clear()
    w.pred_starts.clear(); w.pred_fill.clear(); w.predecessors.clear()
    w.in_x.clear(); w.in_w.clear(); w.in_kx.clear(); w.in_vx.clear(); w.in_kw.clear(); w.in_vw.clear(); w.in_zero.clear()
    w.out_x.clear(); w.out_w.clear(); w.out_kx.clear(); w.out_vx.clear(); w.out_kw.clear(); w.out_vw.clear(); w.out_zero.clear()
    w.x.clear(); w.low.clear(); w.kx.clear(); w.vx.clear(); w.kw.clear(); w.vw.clear()
    w.state = 0; w.work = 0; w.limit = limit; w.rewrites = 0; w.deleted = 0; w.immediates = 0; w.iterations = 0
}
fn bit(reg: i32) -> i64 { i64(1).shl(reg) }
fn index(reg: i32) -> i32 { if reg == -1 { 31 } else { reg } }
fn top(w: &mut Workspace) {
    w.zero = 4294967295
    for r in 0..32 {
        w.x[r] = 4294967295; w.low[r] = 4294967295; w.kx[r] = 2; w.vx[r] = 0; w.kw[r] = 2; w.vw[r] = 0
    }
}
fn entry(w: &mut Workspace) {
    w.zero = bit(31)
    for r in 0..32 { w.x[r] = bit(r); w.low[r] = bit(r); w.kx[r] = 0; w.vx[r] = 0; w.kw[r] = 0; w.vw[r] = 0 }
    w.kx[31] = 1; w.kw[31] = 1
}
fn kill(w: &mut Workspace, mask: i64) {
    killed := mask.bit_and(2147483647); w.zero = w.zero.bit_and(killed.bit_not())
    for r in 0..32 {
        if killed.bit_and(bit(r)) != 0 {
            w.x[r] = bit(r); w.low[r] = bit(r); w.kx[r] = 0; w.vx[r] = 0; w.kw[r] = 0; w.vw[r] = 0
        } else { w.x[r] = w.x[r].bit_and(killed.bit_not()); w.low[r] = w.low[r].bit_and(killed.bit_not()) }
    }
}
fn assign(w: &mut Workspace, dst: i32, eqx: i64, eqw: i64, kx: i32, vx: i64, kw: i32, vw: i64, zero: bool) {
    kill(&mut w, bit(dst)); flag := bit(dst)
    var full := eqx.bit_or(flag); var low := eqw.bit_or(flag)
    for r in 0..32 {
        if kx == 1 && w.kx[r] == 1 && w.vx[r] == vx { full = full.bit_or(bit(r)) }
        if kw == 1 && w.kw[r] == 1 && w.vw[r] == vw { low = low.bit_or(bit(r)) }
        if full.bit_and(bit(r)) != 0 { w.x[r] = w.x[r].bit_or(flag) }
        if low.bit_and(bit(r)) != 0 { w.low[r] = w.low[r].bit_or(flag) }
    }
    w.x[dst] = full; w.low[dst] = low; w.kx[dst] = kx; w.vx[dst] = vx; w.kw[dst] = kw; w.vw[dst] = vw
    if zero { w.zero = w.zero.bit_or(flag) }
}
fn transfer(w: &mut Workspace, f: &mir.Function, op: i32) {
    if f.modes[op] == 2 { return }
    dst := f.dst[op]; kind := f.kinds[op]; ty := f.types[op]
    if dst >= 0 && dst <= 30 && (kind == 1 || kind == 2) && (ty == 1 || ty == 2) {
        if kind == 1 {
            var value := f.imm[op]; if ty == 1 { value = value.bit_and(4294967295) }
            assign(&mut w, dst, 0, 0, 1, value, 1, value.bit_and(4294967295), value >= 0 && value <= 4294967295)
        } else {
            source := index(f.a[op]); var eqx := w.x[source]; eqw := w.low[source]
            var kx := w.kx[source]; var vx := w.vx[source]; kw := w.kw[source]; vw := w.vw[source]
            var zero := w.zero.bit_and(bit(source)) != 0
            if ty == 1 { eqx = eqw.bit_and(w.zero); kx = kw; vx = vw; zero = true }
            assign(&mut w, dst, eqx, eqw, kx, vx, kw, vw, zero)
        }
        return
    }
    // A constant's shared MOVZ/MOVK construction is an explicit bit insertion,
    // not an opaque arithmetic value number. Interpret only these known bits.
    if dst >= 0 && dst <= 30 && kind == 3 && f.opcodes[op] == 3 && (ty == 1 || ty == 2) &&
        f.a[op] >= -1 && f.a[op] <= 30 && f.aux[op] >= 0 && f.aux[op] < 64 {
        source := index(f.a[op]); shift := f.aux[op]; mask := i64(65535).shl(shift)
        var kx := w.kx[source]; var vx := w.vx[source]; var kw := w.kw[source]; var vw := w.vw[source]
        if kx == 1 { vx = vx.bit_and(mask.bit_not()).bit_or(f.imm[op]) }
        if shift < 32 && kw == 1 { vw = vw.bit_and(mask.bit_not()).bit_or(f.imm[op]).bit_and(4294967295) }
        if ty == 1 { kx = kw; vx = vw }
        var zero := ty == 1
        if kx == 1 { zero = vx >= 0 && vx <= 4294967295 }
        var eqw: i64 = 0; if shift >= 32 { eqw = w.low[source] }
        assign(&mut w, dst, 0, eqw, kx, vx, kw, vw, zero); return
    }
    kill(&mut w, f.writes[op].bit_or(f.clobbers[op]))
    // Only known GP W-writing operation contracts establish zero-extension.
    if dst >= 0 && dst <= 30 && (ty == 1 || kind == 6) &&
        (kind == 3 || kind == 4 || kind == 6 || kind == 7) { w.zero = w.zero.bit_or(bit(dst)) }
}
fn load_in(w: &mut Workspace, block: i32) {
    w.zero = w.in_zero[block]; base := block * 32
    for r in 0..32 {
        w.x[r] = w.in_x[base + r]; w.low[r] = w.in_w[base + r]
        w.kx[r] = w.in_kx[base + r]; w.vx[r] = w.in_vx[base + r]; w.kw[r] = w.in_kw[base + r]; w.vw[r] = w.in_vw[base + r]
    }
}
fn meet(w: &mut Workspace, block: i32) {
    if block == 0 { entry(&mut w); return }; top(&mut w)
    for p in w.pred_starts[block]..w.pred_starts[block + 1] {
        pred := w.predecessors[p]; base := pred * 32; w.zero = w.zero.bit_and(w.out_zero[pred])
        for r in 0..32 {
            w.x[r] = w.x[r].bit_and(w.out_x[base + r]); w.low[r] = w.low[r].bit_and(w.out_w[base + r])
            pk := w.out_kx[base + r]; pv := w.out_vx[base + r]
            if w.kx[r] == 2 { w.kx[r] = pk; w.vx[r] = pv }
            else if pk != 2 && (pk != w.kx[r] || (pk == 1 && pv != w.vx[r])) { w.kx[r] = 0; w.vx[r] = 0 }
            lk := w.out_kw[base + r]; lv := w.out_vw[base + r]
            if w.kw[r] == 2 { w.kw[r] = lk; w.vw[r] = lv }
            else if lk != 2 && (lk != w.kw[r] || (lk == 1 && lv != w.vw[r])) { w.kw[r] = 0; w.vw[r] = 0 }
        }
    }
}
fn save_in(w: &mut Workspace, block: i32) {
    w.in_zero[block] = w.zero; base := block * 32
    for r in 0..32 {
        w.in_x[base + r] = w.x[r]; w.in_w[base + r] = w.low[r]
        w.in_kx[base + r] = w.kx[r]; w.in_vx[base + r] = w.vx[r]; w.in_kw[base + r] = w.kw[r]; w.in_vw[base + r] = w.vw[r]
    }
}
fn save_out(w: &mut Workspace, block: i32) -> bool {
    var changed := w.out_zero[block] != w.zero; w.out_zero[block] = w.zero; base := block * 32
    for r in 0..32 {
        at := base + r
        if w.out_x[at] != w.x[r] || w.out_w[at] != w.low[r] || w.out_kx[at] != w.kx[r] || w.out_vx[at] != w.vx[r] ||
            w.out_kw[at] != w.kw[r] || w.out_vw[at] != w.vw[r] { changed = true }
        w.out_x[at] = w.x[r]; w.out_w[at] = w.low[r]; w.out_kx[at] = w.kx[r]; w.out_vx[at] = w.vx[r]
        w.out_kw[at] = w.kw[r]; w.out_vw[at] = w.vw[r]
    }
    changed
}
fn graph(w: &mut Workspace, f: &mir.Function) -> bool {
    blocks := f.block_starts.len
    if !charge(&mut w, blocks * 386 + f.edge_to.len * 4 + f.kinds.len * 32) { return false }
    for r in 0..32 {
        w.definitions.push(0); w.x.push(0); w.low.push(0); w.kx.push(0); w.vx.push(0); w.kw.push(0); w.vw.push(0)
    }
    for op in 0..f.kinds.len { if f.modes[op] != 2 {
        defs := f.writes[op].bit_or(f.clobbers[op])
        for r in 0..31 { if defs.bit_and(bit(r)) != 0 { w.definitions[r] = w.definitions[r] + 1 } }
    } }
    for b in 0..blocks {
        w.reached.push(false); w.queued.push(false); w.pred_fill.push(0); w.in_zero.push(4294967295); w.out_zero.push(4294967295)
        for r in 0..32 {
            w.in_x.push(4294967295); w.in_w.push(4294967295); w.in_kx.push(2); w.in_vx.push(0); w.in_kw.push(2); w.in_vw.push(0)
            w.out_x.push(4294967295); w.out_w.push(4294967295); w.out_kx.push(2); w.out_vx.push(0); w.out_kw.push(2); w.out_vw.push(0)
        }
    }
    w.reached[0] = true; w.queue.push(0); var next := 0
    while next < w.queue.len {
        b := w.queue[next]; next = next + 1
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to >= 0 && !w.reached[to] { w.reached[to] = true; w.queue.push(to) }
        }
    }
    for e in 0..f.edge_to.len { to := f.edge_to[e]; if to >= 0 && w.reached[f.edge_from[e]] { w.pred_fill[to] = w.pred_fill[to] + 1 } }
    w.pred_starts.push(0)
    for b in 0..blocks { w.pred_starts.push(w.pred_starts[b] + w.pred_fill[b]); w.pred_fill[b] = w.pred_starts[b] }
    for p in 0..w.pred_starts[blocks] { w.predecessors.push(0) }
    for e in 0..f.edge_to.len {
        to := f.edge_to[e]; if to < 0 || !w.reached[f.edge_from[e]] { continue }
        w.predecessors[w.pred_fill[to]] = f.edge_from[e]; w.pred_fill[to] = w.pred_fill[to] + 1
    }
    true
}
// A boundary without a declared observation contract can inspect any register.
// Only an explicit unobserving-terminal contract permits an empty live-out
// set. Otherwise refuse the whole pass before DCE can erase definitions that
// are observed outside the function. Unreachable exits impose no condition.
fn declared_exit(w: &mut Workspace, f: &mir.Function, block: i32, labels: &[]i32, epoch: i32) -> bool {
    if epoch != 1 { return false }
    var last := -1
    for position in f.block_starts[block]..f.block_ends[block] {
        if !charge(&mut w, 1) { return false }
        op := f.order[position]; if f.modes[op] != 2 { last = op }
    }
    if last < 0 || (f.kinds[last] != 12 && f.kinds[last] != 13) { return false }
    target := f.targets[last]; var first := 0; var end := labels.len
    while first < end {
        if !charge(&mut w, 1) { return false }
        middle := first + (end - first) / 2
        if labels[middle] < target { first = middle + 1 } else { end = middle }
    }
    first < labels.len && labels[first] == target
}
fn contracted_exits(w: &mut Workspace, f: &mir.Function, labels: &[]i32, epoch: i32) -> bool {
    if !charge(&mut w, f.block_starts.len + f.edge_to.len * 2) { return false }
    for b in 0..f.block_starts.len { w.reached.push(false) }
    w.reached[0] = true; w.queue.push(0); var next := 0
    while next < w.queue.len {
        b := w.queue[next]; next = next + 1
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to < 0 {
                if f.edge_kinds[e] != 3 {
                    var declared := false
                    if f.edge_kinds[e] == 2 { declared = declared_exit(&mut w, &f, b, &labels, epoch) }
                    if !declared { if w.state != -3 { w.state = -2 }; return false }
                }
            } else if !w.reached[to] { w.reached[to] = true; w.queue.push(to) }
        }
    }
    w.reached.clear(); w.queue.clear(); true
}
fn solve(w: &mut Workspace, f: &mir.Function) -> bool {
    blocks := f.block_starts.len; w.queue.clear(); var pending := 0
    for b in 0..blocks { w.queue.push(0); if w.reached[b] { w.queue[pending] = b; w.queued[b] = true; pending = pending + 1 } }
    var head := 0; var tail := pending % blocks
    while pending > 0 {
        b := w.queue[head]; head = (head + 1) % blocks; pending = pending - 1; w.queued[b] = false
        cost := 800 + (w.pred_starts[b + 1] - w.pred_starts[b]) * 194 + (f.block_ends[b] - f.block_starts[b]) * 256
        if !charge(&mut w, cost) { return false }; w.iterations = w.iterations + 1
        meet(&mut w, b); save_in(&mut w, b)
        for position in f.block_starts[b]..f.block_ends[b] { transfer(&mut w, &f, f.order[position]) }
        if !save_out(&mut w, b) { continue }
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to >= 0 && !w.queued[to] { w.queue[tail] = to; tail = (tail + 1) % blocks; pending = pending + 1; w.queued[to] = true }
        }
    }
    true
}

// One undo entry per touched stable operation ID. A mode-only deletion stores
// only its old mode. A semantic replacement adds one packed row on first use.
// Rollback costs are prepaid before each first mutation; rollback never fails.
fn remember(w: &mut Workspace, f: &mir.Function, op: i32, whole: bool) -> bool {
    if w.undo_slots.len == 0 {
        if !charge(&mut w, f.kinds.len) { return false }
        for i in 0..f.kinds.len { w.undo_slots.push(-1) }
    }
    var slot := w.undo_slots[op]
    if slot < 0 {
        if !charge(&mut w, 8) { return false }
        slot = w.undo_ops.len; w.undo_slots[op] = slot
        w.undo_ops.push(op); w.undo_modes.push(f.modes[op]); w.undo_starts.push(-1)
    }
    if whole && w.undo_starts[slot] < 0 {
        //20 captured fields,20 possible restoration writes,21 commit writes.
        if !charge(&mut w, 64) { return false }
        w.undo_starts[slot] = w.undo_rows.len
        w.undo_rows.push(i64(f.kinds[op]))
        w.undo_rows.push(i64(f.opcodes[op]))
        w.undo_rows.push(i64(f.dst[op]))
        w.undo_rows.push(i64(f.a[op]))
        w.undo_rows.push(i64(f.b[op]))
        w.undo_rows.push(i64(f.c[op]))
        w.undo_rows.push(i64(f.imm[op]))
        w.undo_rows.push(i64(f.aux[op]))
        w.undo_rows.push(i64(f.types[op]))
        w.undo_rows.push(i64(f.place[op]))
        w.undo_rows.push(i64(f.extensions[op]))
        w.undo_rows.push(i64(f.effects[op]))
        w.undo_rows.push(i64(f.flags[op]))
        w.undo_rows.push(i64(f.abi[op]))
        w.undo_rows.push(i64(f.reads[op]))
        w.undo_rows.push(i64(f.writes[op]))
        w.undo_rows.push(i64(f.clobbers[op]))
        w.undo_rows.push(i64(f.targets[op]))
        w.undo_rows.push(i64(f.reloc_kinds[op]))
        w.undo_rows.push(i64(f.import_ids[op]))
    }
    true
}
fn rollback(w: &mut Workspace, f: &mut mir.Function) {
    var slot := w.undo_ops.len
    while slot > 0 {
        slot = slot - 1; op := w.undo_ops[slot]; start := w.undo_starts[slot]
        f.modes[op] = w.undo_modes[slot]
        if start >= 0 {
            f.kinds[op] = i32(w.undo_rows[start + 0])
            f.opcodes[op] = i32(w.undo_rows[start + 1])
            f.dst[op] = i32(w.undo_rows[start + 2])
            f.a[op] = i32(w.undo_rows[start + 3])
            f.b[op] = i32(w.undo_rows[start + 4])
            f.c[op] = i32(w.undo_rows[start + 5])
            f.imm[op] = w.undo_rows[start + 6]
            f.aux[op] = i32(w.undo_rows[start + 7])
            f.types[op] = i32(w.undo_rows[start + 8])
            f.place[op] = i32(w.undo_rows[start + 9])
            f.extensions[op] = i32(w.undo_rows[start + 10])
            f.effects[op] = i32(w.undo_rows[start + 11])
            f.flags[op] = i32(w.undo_rows[start + 12])
            f.abi[op] = i32(w.undo_rows[start + 13])
            f.reads[op] = w.undo_rows[start + 14]
            f.writes[op] = w.undo_rows[start + 15]
            f.clobbers[op] = w.undo_rows[start + 16]
            f.targets[op] = i32(w.undo_rows[start + 17])
            f.reloc_kinds[op] = i32(w.undo_rows[start + 18])
            f.import_ids[op] = i32(w.undo_rows[start + 19])
        }
        w.restored = w.restored + 1
    }
    f.verified = w.before_verified; f.optimizable = w.before_optimizable
}
fn candidate_from(w: &mut Workspace, f: &mir.Function, op: i32) {
    w.candidate.kinds[0] = f.kinds[op]
    w.candidate.opcodes[0] = f.opcodes[op]
    w.candidate.dst[0] = f.dst[op]
    w.candidate.a[0] = f.a[op]
    w.candidate.b[0] = f.b[op]
    w.candidate.c[0] = f.c[op]
    w.candidate.imm[0] = f.imm[op]
    w.candidate.aux[0] = f.aux[op]
    w.candidate.types[0] = f.types[op]
    w.candidate.place[0] = f.place[op]
    w.candidate.extensions[0] = f.extensions[op]
    w.candidate.effects[0] = f.effects[op]
    w.candidate.flags[0] = f.flags[op]
    w.candidate.abi[0] = f.abi[op]
    w.candidate.reads[0] = f.reads[op]
    w.candidate.writes[0] = f.writes[op]
    w.candidate.clobbers[0] = f.clobbers[op]
    w.candidate.modes[0] = f.modes[op]
    w.candidate.targets[0] = f.targets[op]
    w.candidate.reloc_kinds[0] = f.reloc_kinds[op]
    w.candidate.import_ids[0] = f.import_ids[op]
}
fn commit_prepared(w: &mut Workspace, f: &mut mir.Function, op: i32) -> bool {
    if w.action == 0 { return true }
    if !remember(&mut w, &f, op, w.action == 2) { return false }
    if w.action == 1 {
        f.modes[op] = 2; f.verified = false; w.deleted = w.deleted + 1; return true
    }
    f.kinds[op] = w.candidate.kinds[0]
    f.opcodes[op] = w.candidate.opcodes[0]
    f.dst[op] = w.candidate.dst[0]
    f.a[op] = w.candidate.a[0]
    f.b[op] = w.candidate.b[0]
    f.c[op] = w.candidate.c[0]
    f.imm[op] = w.candidate.imm[0]
    f.aux[op] = w.candidate.aux[0]
    f.types[op] = w.candidate.types[0]
    f.place[op] = w.candidate.place[0]
    f.extensions[op] = w.candidate.extensions[0]
    f.effects[op] = w.candidate.effects[0]
    f.flags[op] = w.candidate.flags[0]
    f.abi[op] = w.candidate.abi[0]
    f.reads[op] = w.candidate.reads[0]
    f.writes[op] = w.candidate.writes[0]
    f.clobbers[op] = w.candidate.clobbers[0]
    f.targets[op] = w.candidate.targets[0]
    f.reloc_kinds[op] = w.candidate.reloc_kinds[0]
    f.import_ids[op] = w.candidate.import_ids[0]
    f.modes[op] = 1; f.verified = false; w.rewrites = w.rewrites + 1
    if w.immediate { w.immediates = w.immediates + 1 }; true
}
fn alias(w: &Workspace, operand: i32, ty: i32) -> i32 {
    if operand < 0 || operand > 30 { return operand }
    var eq := w.x[operand]; if ty == 1 { eq = w.low[operand] }
    if eq.bit_and(bit(31)) != 0 { return -1 }
    var best := operand
    for r in 0..31 {
        if eq.bit_and(bit(r)) != 0 && (w.definitions[r] < w.definitions[best] ||
            (w.definitions[r] == w.definitions[best] && r < best)) { best = r }
    }
    best
}
fn known_constant(w: &Workspace, operand: i32, ty: i32) -> bool {
    if operand < -1 || operand > 30 { return false }; r := index(operand)
    if ty == 1 { w.kw[r] == 1 } else { w.kx[r] == 1 }
}
fn constant(w: &Workspace, operand: i32, ty: i32) -> i64 {
    r := index(operand); if ty == 1 { w.vw[r] } else { w.vx[r] }
}
fn masks(w: &mut Workspace) {
    w.candidate.reads[0] = mir.variable_bit(w.candidate.a[0]).bit_or(mir.variable_bit(w.candidate.b[0])).bit_or(mir.variable_bit(w.candidate.c[0]))
    w.candidate.writes[0] = mir.variable_bit(w.candidate.dst[0])
}
fn rewrite_copy(w: &mut Workspace, f: &mir.Function, op: i32) {
    dst := f.dst[op]; source := f.a[op]; ty := f.types[op]
    if dst < 0 || dst > 30 || source < -1 || source > 30 || (ty != 1 && ty != 2) { return }
    var same := w.x[dst].bit_and(bit(index(source))) != 0
    if ty == 1 { same = w.low[dst].bit_and(bit(index(source))) != 0 && w.zero.bit_and(bit(dst)) != 0 }
    if same { w.action = 1; return }
    selected := alias(&w, source, ty); if selected == source { return }
    candidate_from(&mut w, &f, op); w.candidate.a[0] = selected; masks(&mut w)
    if core.canonical(&w.candidate, 0) { w.action = 2 }
}
fn rewrite_constant(w: &mut Workspace, f: &mir.Function, op: i32) {
    dst := f.dst[op]; ty := f.types[op]; if dst < 0 || dst > 30 || (ty != 1 && ty != 2) { return }
    var value := f.imm[op]; if ty == 1 { value = value.bit_and(4294967295) }
    if w.kx[dst] == 1 && w.vx[dst] == value { w.action = 1; return }
    var best := -2
    for source in -1..31 {
        if source == dst || !known_constant(&w, source, ty) || constant(&w, source, ty) != value { continue }
        if source == -1 { best = -1; break }
        if best == -2 { best = source }
        else if w.definitions[source] < w.definitions[best] { best = source }
    }
    if best == -2 { return }
    candidate_from(&mut w, &f, op)
    w.candidate.kinds[0] = 2; w.candidate.opcodes[0] = 0; w.candidate.a[0] = best
    w.candidate.b[0] = -1; w.candidate.c[0] = -1; w.candidate.imm[0] = 0; w.candidate.aux[0] = 0
    masks(&mut w); if core.canonical(&w.candidate, 0) { w.action = 2 }
}
fn rewrite_scalar(w: &mut Workspace, f: &mir.Function, op: i32) {
    candidate_from(&mut w, &f, op)
    if !scalar.can_emit(&w.candidate, 0) { return }
    ty := f.types[op]
    w.candidate.a[0] = alias(&w, f.a[op], ty); w.candidate.b[0] = alias(&w, f.b[op], ty); w.candidate.c[0] = alias(&w, f.c[op], ty)
    masks(&mut w); var immediate := false
    opcode := f.opcodes[op]
    if (opcode == 1 || opcode == 2) && f.imm[op] == 0 && f.aux[op] == 0 && known_constant(&w, f.b[op], ty) {
        value := constant(&w, f.b[op], ty)
        if value > 0 {
            saved := w.candidate.b[0]; w.candidate.b[0] = -1; w.candidate.imm[0] = value; masks(&mut w)
            if scalar.can_emit(&w.candidate, 0) { immediate = true }
            else { w.candidate.b[0] = saved; w.candidate.imm[0] = f.imm[op]; masks(&mut w) }
        }
    }
    if w.candidate.a[0] == f.a[op] && w.candidate.b[0] == f.b[op] && w.candidate.c[0] == f.c[op] &&
        w.candidate.imm[0] == f.imm[op] { return }
    if !scalar.can_emit(&w.candidate, 0) { return }
    w.action = 2; w.immediate = immediate
}
fn replay(w: &mut Workspace, f: &mut mir.Function) -> bool {
    if !charge(&mut w, f.kinds.len * 512 + f.block_starts.len * 194) { return false }
    for b in 0..f.block_starts.len {
        if !w.reached[b] { continue }; load_in(&mut w, b)
        for position in f.block_starts[b]..f.block_ends[b] {
            op := f.order[position]; if f.modes[op] == 2 { continue }
            w.action = 0; w.immediate = false
            if f.kinds[op] == 1 { rewrite_constant(&mut w, &f, op) }
            else if f.kinds[op] == 2 { rewrite_copy(&mut w, &f, op) }
            else if scalar.handles(f.kinds[op]) { rewrite_scalar(&mut w, &f, op) }
            // Preserve the previous source→plan fact trajectory exactly. The
            // prepared equivalent row is not visible to this transfer yet.
            transfer(&mut w, &f, op)
            if !commit_prepared(&mut w, &mut f, op) { return false }
        }
    }
    true
}
fn pure_materialization(f: &mir.Function, op: i32) -> bool {
    (f.kinds[op] == 1 || f.kinds[op] == 2 || (f.kinds[op] == 3 && f.opcodes[op] == 3 && scalar.can_emit(&f, op))) &&
        f.effects[op] == 0 && f.flags[op] == 0 && f.abi[op] == 0 &&
        f.clobbers[op] == 0 && f.dst[op] >= -1 && f.dst[op] <= 30 &&
        f.writes[op] == mir.variable_bit(f.dst[op]) && f.place[op] == -1 && f.reloc_kinds[op] == -1 && f.import_ids[op] == -1
}
fn check_staged(w: &mut Workspace, f: &mut mir.Function) -> bool {
    if f.verified { return true }
    if !charge(&mut w, f.kinds.len * 100 + f.raw.len) { return false }
    if !verify.verify_into(&mut f, &mut w.verifier) { w.state = -1; return false }
    if !f.optimizable { w.state = -2; return false }; true
}
fn dead(w: &mut Workspace, f: &mut mir.Function) -> bool {
    var again := true
    while again {
        again = false
        if !check_staged(&mut w, &mut f) { return false }
        if !live.analyze_into(&mut w.liveness, &f, w.limit - w.work) {
            w.work = w.work + live.units(&w.liveness); w.state = live.status(&w.liveness); return false
        }
        if !charge(&mut w, live.units(&w.liveness) + f.kinds.len * 4) { return false }
        for b in 0..f.block_starts.len {
            if !live.reachable(&w.liveness, b) { continue }
            var needed := live.live_out(&w.liveness, b); var position := f.block_ends[b]
            while position > f.block_starts[b] {
                position = position - 1; op := f.order[position]
                if f.modes[op] == 2 { continue }
                if pure_materialization(&f, op) && f.writes[op].bit_and(needed) == 0 {
                    // A private proof-preserving tombstone, not a general
                    // verifier bypass: the already-verified row is pure GP
                    // Const/Copy/MOVK with no flags, memory, stack, call/ABI
                    // effects or relocations. Only its mode changes; IDs,
                    // blocks, edges and all other rows remain identical.
                    // Removing it cannot add a new verification obligation.
                    assert(f.verified)
                    if !remember(&mut w, &f, op, false) { return false }
                    f.modes[op] = 2; w.deleted = w.deleted + 1; again = true; continue
                }
                needed = f.reads[op].bit_or(needed.bit_and(f.writes[op].bit_or(f.clobbers[op]).bit_not()))
            }
        }
    }
    true
}
// All analysis before this boundary is read-only under the public exclusive
// borrow. Source facts, exit contracts and stable CFG are the same as before.
fn begin(w: &mut Workspace, f: &mir.Function, labels: &[]i32, epoch: i32, limit: i32) -> bool {
    reset(&mut w, limit)
    w.before_verified = f.verified; w.before_optimizable = f.optimizable
    if epoch < 0 || epoch > 1 { w.state = -1; return false }
    if !f.valid || !f.verified { w.state = -1; return false }
    if !f.optimizable || f.unknown_control { w.state = -2; return false }
    n := f.kinds.len; blocks := f.block_starts.len
    if limit < 0 || n > 65536 || blocks > 16384 || f.edge_to.len > 32768 { w.state = -3; return false }
    if blocks == 0 { return false }
    if !charge(&mut w, n) { return false }; var candidates := false
    for op in 0..n { if f.modes[op] != 2 && (f.kinds[op] == 1 || f.kinds[op] == 2 || (f.kinds[op] == 3 && f.opcodes[op] == 3)) { candidates = true } }
    if !candidates { return false }
    if !contracted_exits(&mut w, &f, &labels, epoch) { return false }
    graph(&mut w, &f) && solve(&mut w, &f)
}
fn finish(w: &mut Workspace, f: &mut mir.Function) -> bool {
    if !replay(&mut w, &mut f) || !check_staged(&mut w, &mut f) || !dead(&mut w, &mut f) {
        rollback(&mut w, &mut f); return false
    }
    if w.undo_ops.len == 0 { w.state = 0; return false }
    // Mandatory complete final verification, even when restricted pure DCE
    // preserved an already-true certificate. No false→true shortcut exists.
    if !charge(&mut w, f.kinds.len * 100 + f.raw.len) {
        rollback(&mut w, &mut f); return false
    }
    if !verify.verify_into(&mut f, &mut w.verifier) {
        w.state = -1; rollback(&mut w, &mut f); return false
    }
    if !f.optimizable { w.state = -2; rollback(&mut w, &mut f); return false }
    // No unverified candidate can escape the exclusive transaction. Every
    // changed model has just passed the ordinary complete MIR verifier.
    assert(f.verified); w.state = 2; true
}
// status:2 committed,0 no change,-1 invalid,-2 uncontracted control,-3 budget.
// The single exclusive Function borrow spans every fallible stage. Refusal
// restores sparse rows and the verifier's two mutable metadata scalars exactly.
// No public prepared plan, full-model copy, hash, snapshot or aggregate swap.
pub fn optimize_budget(w: &mut Workspace, f: &mut mir.Function, limit: i32) -> bool {
    // The labels borrow is read-only and ends before any Function mutation.
    if !begin(&mut w, &f, &f.label_ids, 0, limit) { return false }; finish(&mut w, &mut f)
}
pub fn optimize_into(w: &mut Workspace, f: &mut mir.Function) -> bool { optimize_budget(&mut w, &mut f, 4194304) }
pub fn optimize_with_context_budget(w: &mut Workspace, f: &mut mir.Function, ctx: &Context, limit: i32) -> bool {
    var epoch := ctx.epoch; if !ctx.valid { epoch = -1 }
    if !begin(&mut w, &f, &ctx.labels, epoch, limit) { return false }; finish(&mut w, &mut f)
}
pub fn optimize_with_context(w: &mut Workspace, f: &mut mir.Function, ctx: &Context) -> bool {
    optimize_with_context_budget(&mut w, &mut f, &ctx, 4194304)
}
