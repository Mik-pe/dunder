// macOS bundle metadata, deterministic resource envelope and publication.
import bundle_fs as fs
import cli
import macho
import std.bytes as bytes
import std.sha256 as sha
import std.text as text
import sys

fn valid_name(name: string) -> bool {
    if name == "" || name == "." || name == ".." { return false }
    for i in 0..name.len {
        b := name[i]
        if b < 32 || b == 127 || (b == 194 && i + 1 < name.len && name[i + 1] < 160) { return false }
    }
    true
}
pub fn name(path: string) -> string {
    if !text.ends_with(path, ".app") { return "" }
    var base := 0
    for i in 0..path.len { if path[i] == 47 { base = i + 1 } }
    result := path[base..path.len-4]
    if !valid_name(result) { return "" }
    result
}

fn xml(value: string) -> string {
    var out: []u8 = []
    for b in value.bytes() {
        if b == 38 { bytes.append_utf8(&mut out, "&amp;") }
        else if b == 60 { bytes.append_utf8(&mut out, "&lt;") }
        else if b == 62 { bytes.append_utf8(&mut out, "&gt;") }
        else if b == 34 { bytes.append_utf8(&mut out, "&quot;") }
        else if b == 39 { bytes.append_utf8(&mut out, "&apos;") }
        else { out.push(u8(b)) }
    }
    bytes.decode(&out).value
}

fn identifier(name: string) -> string {
    var out: []u8 = []
    var hash: i64 = 2166136261
    for byte in name.bytes() {
        hash = (hash.bit_xor(i64(byte)) * 16777619).bit_and(4294967295)
        if byte >= 65 && byte <= 90 { out.push(u8(byte + 32)) }
        else if byte >= 97 && byte <= 122 || byte >= 48 && byte <= 57 { out.push(u8(byte)) }
        else if out.len > 0 && out[out.len - 1] != 45 { out.push(45) }
    }
    if out.len > 0 && out[out.len-1] == 45 { trimmed := out.pop() }
    if out.len == 0 { bytes.append_utf8(&mut out, "app") }
    out.push(45)
    digits := "0123456789abcdef"
    for i in 0..8 { out.push(u8(digits[i32(hash.shr((7 - i) * 4).bit_and(15))])) }
    "org.dunder." + bytes.decode(&out).value
}

fn header() -> string {
    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n"
}
fn property(key: string, value: string) -> string { "<key>" + key + "</key><string>" + value + "</string>\n" }
// Bundle display names use the original UTF-8 spelling. For a Unicode
// stem, keep the signed executable's path stable across filesystem normalizations.
pub fn executable_name(app: string) -> string {
    for b in app.bytes() {
        if b >= 128 {
            id := identifier(app)
            return "dunder-" + id[id.len-8..id.len]
        }
    }
    app
}

fn plist(name: string, executable: string, id: string) -> string {
    escaped := xml(name)
    var result := header()
    result = result + property("CFBundleExecutable", xml(executable))
    for key in ["CFBundleName", "CFBundleDisplayName"] { result = result + property(key, escaped) }
    result = result + property("CFBundleIdentifier", id) + property("CFBundlePackageType", "APPL")
    result = result + property("CFBundleInfoDictionaryVersion", "6.0")
    result = result + property("CFBundleVersion", "0.1.0") + property("CFBundleShortVersionString", "0.1.0")
    result + "<key>NSHighResolutionCapable</key><true/>\n" + property("LSMinimumSystemVersion", "11.0") + "<key>NSSupportsAutomaticGraphicsSwitching</key><true/>\n</dict>\n</plist>\n"
}

fn base64(input: &[]u8) -> string {
    alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var out: []u8 = []
    var i := 0
    while i < input.len {
        left := input.len - i
        a := i32(input[i])
        var b := 0
        var c := 0
        if left > 1 { b = i32(input[i + 1]) }
        if left > 2 { c = i32(input[i + 2]) }
        out.push(u8(alphabet[a / 4]))
        out.push(u8(alphabet[(a % 4) * 16 + b / 16]))
        if left > 1 { out.push(u8(alphabet[(b % 16) * 4 + c / 64])) } else { out.push(61) }
        if left > 2 { out.push(u8(alphabet[c % 64])) } else { out.push(61) }
        i = i + 3
    }
    bytes.decode(&out).value
}

struct Resources { names: []string, hashes: []string, error: string }
fn before(a: string, b: string) -> bool {
    var i := 0
    while i < a.len && i < b.len { if a[i] != b[i] { return a[i] < b[i] }; i = i + 1 }
    a.len < b.len
}

fn collect(resources: &mut Resources, base: string, relative: string, executable: string) {
    var folder := base
    if relative != "" { folder = base + "/" + relative }
    entries := fs.entries(folder)
    if entries.error != "" { resources.error = entries.error; return }
    for item in entries.paths {
        if !valid_name(item) { resources.error = "invalid resource filename"; return }
        var key := item
        if relative != "" { key = relative + "/" + item }
        path := base + "/" + key
        if fs.is_link(path) { resources.error = "bundle entry is a symbolic link: " + path; return }
        status := sys.metadata(path)
        if key == "Info.plist" || key == executable || key == "_CodeSignature/CodeResources" {
            if !status.is_file { resources.error = "expected regular file: " + path; return }
        } else if relative == "_CodeSignature" { resources.error = "unsupported existing bundle signature file: " + path; return }
        else if status.is_dir {
            collect(&mut resources, base, key, executable)
            if resources.error != "" { return }
        } else if status.is_file && key != "MacOS" && key != "_CodeSignature" {
            file := fs.contents(path)
            if file.error != "" { resources.error = file.error; return }
            digest := sha.digest_bytes(&file.data)
            // CodeResources is sorted by the full UTF-8 relative path.
            var pos := resources.names.len
            resources.names.push(key)
            resources.hashes.push(base64(&digest))
            while pos > 0 && before(key, resources.names[pos - 1]) {
                old_key := resources.names[pos - 1]; old_hash := resources.hashes[pos - 1]
                resources.names[pos - 1] = resources.names[pos]; resources.hashes[pos - 1] = resources.hashes[pos]
                resources.names[pos] = old_key; resources.hashes[pos] = old_hash
                pos = pos - 1
            }
        } else { resources.error = "unsupported bundle entry: " + path; return }
    }
}

fn resources(path: string, executable: string) -> Resources {
    var files := Resources { names: [], hashes: [], error: "" }
    if fs.is_link(path) { files.error = "bundle must be a directory"; return files }
    status := sys.metadata(path)
    if !status.ok && status.error == 2 { return files }
    if !status.is_dir { files.error = "bundle must be a directory"; return files }
    entries := fs.entries(path)
    files.error = entries.error
    if files.error != "" { return files }
    for entry in entries.paths {
        if entry != "Contents" { files.error = "unsupported bundle entry outside Contents: " + entry; return files }
        contents := path + "/Contents"
        if fs.is_link(contents) || !sys.metadata(contents).is_dir { files.error = "Contents must be a real directory"; return files }
        collect(&mut files, contents, "", executable)
    }
    files
}

fn envelope(files: &Resources) -> string {
    var out: []u8 = []
    bytes.append_utf8(&mut out, header() + "<key>files</key><dict/>\n<key>files2</key><dict>\n")
    for i in 0..files.names.len {
        bytes.append_utf8(&mut out, "<key>" + xml(files.names[i]) + "</key><dict><key>hash2</key><data>" + files.hashes[i] + "</data></dict>\n")
    }
    bytes.append_utf8(&mut out, "</dict>\n<key>rules</key><dict/>\n<key>rules2</key><dict>\n<key>^.*</key><true/>\n<key>^Info\\.plist$</key><dict><key>omit</key><true/><key>weight</key><real>20</real></dict>\n</dict>\n</dict>\n</plist>\n")
    bytes.decode(&out).value
}
fn publish_text(path: string, value: string) -> string {
    var out: []u8 = []
    bytes.append_utf8(&mut out, value)
    fs.publish(path, &out, false)
}
pub fn publish(path: string, image: &mut []u8, sources: &[]string) -> string {
    app := name(path)
    if app == "" { return "--app output must end in a nonempty name followed by '.app'" }
    contents := path + "/Contents"
    binary := executable_name(app)
    executable := contents + "/MacOS/" + binary
    plist_path := contents + "/Info.plist"
    seal_path := contents + "/_CodeSignature/CodeResources"
    for source in sources {
        if source.len > 0 && source[0] != 60 {
            for target in [executable, plist_path, seal_path] {
                if target == source || sys.same_file(source, target) { return "output must not overwrite source: " + target }
            }
        }
    }
    files := resources(path, "MacOS/" + binary)
    if files.error != "" { return files.error }
    id := identifier(app)
    info := plist(app, binary, id)
    seal := envelope(&files)
    macho.seal_bundle(&mut image, id, info, seal)
    if !cli.prepare_parent(executable) || !cli.prepare_parent(seal_path) { return "cannot create bundle directories" }
    written := fs.publish(executable, &image, true)
    if written != "" { return written }
    metadata := publish_text(plist_path, info)
    if metadata != "" { return metadata }
    publish_text(seal_path, seal)
}
