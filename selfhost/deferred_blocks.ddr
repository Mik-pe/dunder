// Lexical cleanup blocks and the control-flow edges which resume after them.

pub struct Blocks {
    bodies: []i32, scopes: []i32, owner_limits: []i32, local_limits: []i32,
    entries: []i32, exits: []i32,
    selector: i32, return_slot: i32, targets: []i32, previous: []i32,
}

pub fn new() -> Blocks {
    Blocks { bodies: [], scopes: [], owner_limits: [], local_limits: [],
        entries: [], exits: [], selector: -1, return_slot: -1, targets: [], previous: [] }
}

pub fn reset(b: &mut Blocks) {
    b.bodies.clear(); b.scopes.clear(); b.owner_limits.clear(); b.local_limits.clear()
    b.entries.clear(); b.exits.clear(); b.selector = -1; b.return_slot = -1; b.targets.clear(); b.previous.clear()
}

pub fn register(b: &mut Blocks, body: i32, scope: i32, owners: i32, locals: i32) {
    b.bodies.push(body); b.scopes.push(scope); b.owner_limits.push(owners); b.local_limits.push(locals)
    b.entries.push(-1); b.exits.push(-1)
}

// Each early exit contributes a continuation in the caller's frame. A single
// selector covers the function: deferred blocks cannot register nested defers.
pub fn add_exit(b: &mut Blocks, block: i32, resume: i32) -> i32 {
    edge := b.targets.len
    b.targets.push(resume); b.previous.push(b.exits[block]); b.exits[block] = edge
    edge
}
