// Synthesize shared target vocabulary exclusively from canonical scalar MIR.
// The complete preflight precedes any emission, so rejection changes no Code
// words, relocation/import metadata, labels, counters, or ownership evidence.
import arm64 as arm
import mir
import mir_scalar_contract as contract

fn reg(value: i32) -> i64 { if value == -1 { 31 } else { i64(value) } }
fn width(ty: i32) -> i64 { if ty == 2 { 2147483648 } else { 0 } }
pub fn can_emit(f: &mir.Function, op: i32) -> bool { contract.can_emit(&f, op) }
pub fn emit(code: &mut arm.Code, f: &mir.Function, op: i32) -> bool {
    if !contract.validate(&f, op) { return false }
    kind := f.kinds[op]; opcode := f.opcodes[op]; ty := f.types[op]
    dst := reg(f.dst[op]); a := reg(f.a[op]); b := reg(f.b[op]); var c := reg(f.c[op])
    imm := f.imm[op]; aux := f.aux[op]; sf := width(ty)
    if kind == 6 {
        // Existing x86/Wasm CSET vocabulary is the X encoding. Its result is
        // exactly0/1, so it also implements physical W zero-extension exactly.
        arm.emit(&mut code, 2594113504 + i64(i32(imm).bit_xor(1)) * 4096 + dst); return true
    }
    if kind == 3 {
        if opcode == 3 {
            if f.dst[op] >= 0 && f.a[op] != f.dst[op] {
                var copy: i64 = 704644064; if ty == 2 { copy = 2852127712 }
                arm.emit(&mut code, copy + a * 65536 + dst)
            }
            arm.emit(&mut code, 1920991232 + sf + i64(aux / 16) * 2097152 + imm.shr(aux).bit_and(65535) * 32 + dst)
            return true
        }
        var base: i64 = 318767104; if opcode == 2 { base = 1392508928 }
        if ty == 2 { base = base + 2151677952 }
        arm.emit(&mut code, base + i64(aux.bit_and(63)) * 65536 + i64(aux / 64) * 1024 + a * 32 + dst); return true
    }
    if opcode == 1 || opcode == 2 {
        var base: i64 = 184549376 + sf; if opcode == 2 { base = base + 1073741824 }
        if f.flags[op] == 2 { base = base + 536870912 }
        if imm != 0 {
            base = base + 100663296; var amount := imm
            if amount > 4095 { amount = amount / 4096; base = base + 4194304 }
            arm.emit(&mut code, base + amount * 1024 + a * 32 + dst)
        } else {
            arm.emit(&mut code, base + b * 65536 + i64(aux / 64) * 4194304 + i64(aux.bit_and(63)) * 1024 + a * 32 + dst)
        }
        return true
    }
    if opcode >= 8 && opcode <= 13 {
        var base: i64 = 167772160 + sf; var operation := opcode - 8
        if operation >= 3 { operation = operation - 3; base = base + 2097152 }
        if f.flags[op] == 2 { operation = 3 }
        base = base + i64(operation) * 536870912
        arm.emit(&mut code, base + b * 65536 + i64(aux / 64) * 4194304 + i64(aux.bit_and(63)) * 1024 + a * 32 + dst); return true
    }
    if opcode == 6 || opcode == 7 || (opcode >= 14 && opcode <= 16) {
        var operation := 2
        if opcode == 6 { operation = 3 }; if opcode >= 14 { operation = 8 + opcode - 14 }
        arm.emit(&mut code, 448790528 + sf + i64(operation) * 1024 + b * 65536 + a * 32 + dst); return true
    }
    var base: i64 = 452984832 + sf
    if opcode == 4 { base = base + 4194304 }; if opcode == 5 { base = base + 12582912 }
    if opcode == 3 || opcode == 4 || opcode == 5 { c = 31 }
    if opcode == 18 { base = base + 32768 }
    arm.emit(&mut code, base + b * 65536 + c * 1024 + a * 32 + dst); true
}
