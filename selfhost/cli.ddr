// Project and target selection shared by the self-hosted compiler entrypoints.
import sys
import std.text as text

pub struct Options { error: string, input: string, output: string, platform: i32, tests: bool }
pub fn target_name(platform: i32) -> string {
    if platform == 0 { return "arm64-macos" }
    if platform == 1 { return "arm64-linux" }
    if platform == 2 { return "x86_64-linux" }
    "wasm32"
}
fn target_id(name: string) -> i32 {
    for id in 0..4 { if target_name(id) == name { return id } }
    -1
}

fn path_in(dir: string, path: string) -> string {
    if text.starts_with(path, "/") || dir == "." { return path }
    dir + "/" + path
}

fn manifest(options: &mut Options) -> string {
    var dir := "."
    while !sys.metadata(dir + "/dunder.toml").ok {
        parent := dir + "/.."
        if sys.same_file(dir, parent) { options.error = "no dunder.toml found"; return "" }
        dir = parent
    }
    file := sys.read_text(dir + "/dunder.toml")
    if !file.ok { options.error = sys.error_message(file.error); return "" }
    var name := ""
    var root := ""
    var tests := ""
    for line in text.split(file.value, "\n") {
        field := text.trim(line)
        if field == "" || text.starts_with(field, "#") { continue }
        split := text.find(field, "=")
        if split < 1 { options.error = "invalid manifest field"; return "" }
        key := text.trim(field[0..split])
        quoted := text.trim(field[split+1..field.len])
        if quoted.len < 2 || quoted[0] != 34 || quoted[quoted.len-1] != 34 { options.error = "manifest values must be quoted strings"; return "" }
        value := quoted[1..quoted.len-1]
        if value == "" { options.error = "empty manifest value"; return "" }
        if key == "name" && name == "" { name = value }
        else if key == "root" && root == "" { root = value }
        else if key == "test_root" && tests == "" { tests = value }
        else { options.error = "unknown or duplicate manifest field: " + key; return "" }
    }
    if name == "" || root == "" { options.error = "manifest requires name and root"; return "" }
    for b in name.bytes() {
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 95) {
            options.error = "invalid program name in manifest"; return ""
        }
    }
    if options.tests && tests != "" { root = tests }
    options.input = path_in(dir, root)
    name
}

fn stem(path: string) -> string {
    var start := 0
    var dot := -1
    for i in 0..path.len {
        if path[i] == 47 { start = i + 1; dot = -1 }
        if path[i] == 46 { dot = i }
    }
    if dot > start { return path[start..dot] }
    path[start..path.len]
}
pub fn options(default_target: i32) -> Options {
    var out := Options { error: "", input: "", output: "", platform: default_target, tests: false }
    command := sys.arg(1)
    out.tests = command == "build-tests"
    if command != "build" && !out.tests { out.error = "expected build or build-tests"; return out }
    var target_set := false
    var i := 2
    while i < sys.arg_count() {
        value := sys.arg(i)
        if value == "-o" {
            i = i + 1
            if out.output != "" || i >= sys.arg_count() { out.error = "-o requires one output path"; return out }
            out.output = sys.arg(i)
        } else if value == "--target" {
            i = i + 1
            if target_set || i >= sys.arg_count() { out.error = "--target requires one target"; return out }
            target_set = true; out.platform = target_id(sys.arg(i))
            if out.platform < 0 { out.error = "unsupported target: " + sys.arg(i); return out }
        } else if text.starts_with(value, "-") { out.error = "unknown option: " + value; return out }
        else if out.input == "" { out.input = value }
        else { out.error = "expected a single source file"; return out }
        i = i + 1
    }
    var name := ""
    if out.input == "" { name = manifest(&mut out) } else { name = stem(out.input) }
    if out.output == "" {
        if out.platform == 3 { name = name + ".wasm" }
        var dir := "build/" + target_name(out.platform)
        if out.tests { dir = dir + "/tests" }
        out.output = dir + "/" + name
    }
    out
}
pub fn prepare_parent(output: string) -> bool {
    for i in 1..output.len {
        if output[i] == 47 && output[i-1] != 47 {
            dir := output[0..i]
            if !sys.metadata(dir).is_dir {
                created := sys.mkdir(dir)
                if !created.ok && !sys.metadata(dir).is_dir { return false }
            }
        }
    }
    true
}
