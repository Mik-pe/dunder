// Project and target selection shared by the self-hosted compiler entrypoints.
import sys
import std.parse as decimal
import std.text as text

pub struct Options { group: i32, list_groups: bool, incremental: bool, timings: bool, timings_json: bool, scalar_opt: bool, run: bool, run_tests: bool, affected: bool, timeout_ms: i64, args: []string, error: string, input: string, output: string, platform: i32, tests: bool, app: bool, checking: bool, agent: bool }
pub fn target_name(platform: i32) -> string {
    if platform == 0 { return "arm64-macos" }
    if platform == 1 { return "arm64-linux" }
    if platform == 2 { return "x86_64-linux" }
    "wasm32"
}
fn target_id(name: string) -> i32 {
    for id in 0..4 { if target_name(id) == name { return id } }
    if name == "aarch64-apple-darwin" { return 0 }
    if name == "aarch64-unknown-linux-gnu" { return 1 }
    if name == "x86_64-unknown-linux-gnu" { return 2 }
    if name == "wasm32-unknown-unknown" { return 3 }
    -1
}

fn path_in(dir: string, path: string) -> string {
    if text.starts_with(path, "/") || dir == "." { return path }
    dir + "/" + path
}

fn manifest(options: &mut Options) -> string {
    var dir := "."
    while !sys.metadata(dir + "/dunder.toml").is_file {
        parent := dir + "/.."
        if sys.same_file(dir, parent) { options.error = "no dunder.toml found"; return "" }
        dir = parent
    }
    path := path_in(dir, "dunder.toml")
    file := sys.read_text(path)
    if !file.ok { options.error = path + ": " + sys.error_message(file.error); return "" }
    var name := ""
    var root := ""
    var tests := ""
    var number := 0
    for line in text.split(file.value, "\n") {
        number = number + 1
        field := text.trim(line)
        if field == "" || text.starts_with(field, "#") { continue }
        location := path + ":" + number.str() + ": "
        split := text.find(field, "=")
        if split < 1 { options.error = location + "expected a quoted name, root or test_root assignment"; return "" }
        key := text.trim(field[0..split])
        quoted := text.trim(field[split+1..field.len])
        if quoted.len < 2 || quoted[0] != 34 || quoted[quoted.len-1] != 34 { options.error = location + "manifest values must be quoted strings"; return "" }
        value := quoted[1..quoted.len-1]
        if value == "" { options.error = location + "empty manifest value for " + key; return "" }
        if key == "name" && name == "" { name = value }
        else if key == "root" && root == "" { root = value }
        else if key == "test_root" && tests == "" { tests = value }
        else { options.error = location + "unknown or duplicate manifest field: " + key; return "" }
    }
    if name == "" { options.error = path + ": manifest requires name"; return "" }
    if root == "" { options.error = path + ": manifest requires root"; return "" }
    for b in name.bytes() {
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 95) {
            options.error = path + ": manifest name must contain only letters, digits, '_' or '-'"; return ""
        }
    }
    if options.tests && tests != "" { root = tests }
    options.input = path_in(dir, root)
    name
}

fn stem(path: string) -> string {
    var start := 0
    var dot := -1
    for i in 0..path.len {
        if path[i] == 47 { start = i + 1; dot = -1 }
        if path[i] == 46 { dot = i }
    }
    if dot > start { return path[start..dot] }
    path[start..path.len]
}
pub fn options(default_target: i32) -> Options {
    var out := Options { group: -1, list_groups: false, incremental: false, timings: false, timings_json: false, scalar_opt: true, run: false, run_tests: false, affected: false, timeout_ms: 5000, args: [], error: "", input: "", output: "", platform: default_target, tests: false, app: false, checking: false, agent: false }
    command := sys.arg(1)
    out.run = command == "run"
    out.run_tests = command == "test"
    out.tests = command == "build-tests" || out.run_tests
    out.checking = command == "check"
    if command != "build" && !out.run && !out.tests && !out.checking { out.error = "expected build, build-tests or check"; return out }
    var target_set := false
    var i := 2
    while i < sys.arg_count() {
        value := sys.arg(i)
        if value == "--" && out.run {
            for arg in i+1..sys.arg_count() { out.args.push(sys.arg(arg)) }
            break
        }
        if command == "build-tests" && value == "--list" {
            out.list_groups = true
        } else if command == "build-tests" && value == "--group" {
            i = i + 1
            if i >= sys.arg_count() || out.group >= 0 { out.error = "--group requires a single test ID"; return out }
            id := decimal.integer(sys.arg(i))
            if !id.ok || id.value < 0 || id.value > 2147483647 { out.error = "--group requires a nonnegative test ID"; return out }
            out.group = i32(id.value)
        } else if value == "--incremental" && !out.checking { out.incremental = true }
        else if value == "--timings" { out.timings = true; out.timings_json = false }
        else if value == "--timings=json" { out.timings = true; out.timings_json = true }
        else if value == "--scalar-opt=off" { out.scalar_opt = false }
        else if value == "--scalar-opt=on" { out.scalar_opt = true }
        else if value == "--affected" && out.run_tests { out.affected = true }
        else if value == "--timeout-ms" && out.run_tests {
            i = i + 1
            if i >= sys.arg_count() { out.error = "--timeout-ms requires milliseconds"; return out }
            parsed := decimal.integer(sys.arg(i))
            if !parsed.ok || parsed.value <= 0 { out.error = "--timeout-ms must be a positive integer"; return out }
            out.timeout_ms = parsed.value
        } else if value == "--agent" && out.checking { out.agent = true }
        else if value == "-o" {
            if out.checking { out.error = "check does not accept an output path"; return out }
            i = i + 1
            if out.output != "" || i >= sys.arg_count() { out.error = "-o requires one output path"; return out }
            out.output = sys.arg(i)
        } else if value == "--app" {
            if out.app { out.error = "duplicate --app option"; return out }
            out.app = true
        } else if value == "--target" {
            i = i + 1
            if target_set || i >= sys.arg_count() { out.error = "--target requires one target"; return out }
            target_set = true; out.platform = target_id(sys.arg(i))
            if out.platform < 0 { out.error = "unsupported target: " + sys.arg(i); return out }
        } else if text.starts_with(value, "-") { out.error = "unknown option: " + value; return out }
        else if out.input == "" { out.input = value }
        else { out.error = "expected a single source file"; return out }
        i = i + 1
    }
    if out.list_groups && (out.group >= 0 || out.output != "") { out.error = "--list cannot select or publish a test image"; return out }
    if out.incremental && out.platform == 3 { out.error = "--incremental requires a native target"; return out }
    if out.app && (out.platform != 0 || out.tests || out.checking) { out.error = "--app requires build with target arm64-macos"; return out }
    var name := ""
    if out.input == "" { name = manifest(&mut out) } else { name = stem(out.input) }
    if out.output == "" {
        if out.platform == 3 { name = name + ".wasm" }
        if out.app { name = name + ".app" }
        var dir := "build/" + target_name(out.platform)
        if out.tests { dir = dir + "/tests" }
        out.output = dir + "/" + name
    }
    out
}
pub fn prepare_parent(output: string) -> bool {
    for i in 1..output.len {
        if output[i] == 47 && output[i-1] != 47 {
            dir := output[0..i]
            if !sys.metadata(dir).is_dir {
                created := sys.mkdir(dir)
                if !created.ok && !sys.metadata(dir).is_dir { return false }
            }
        }
    }
    true
}
