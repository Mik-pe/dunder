// Index the symbolic instruction stream once. Block edges preserve jumps across
// shared cleanup/trap code. Call and function-address relocations start a fresh
// Wasm function, so recursion uses the engine's native call stack.
import arm64 as arm

pub struct Graph {
    starts:[]i32, block_at:[]i32, relocation:[]i32, next:[]i32, taken:[]i32,
    functions:[]i32, function_id:[]i32, addresses:[]i32, address_id:[]i32, prints:[]i32,
}
pub fn filled(n:i32,value:i32)->[]i32 {
    var result:[]i32=[];result.reserve(n)
    for i in 0..n {result.push(value)}
    result
}
fn terminal(word:i64)->bool {word==3596551104 || word==3558866944 || word==3556769793}
pub fn print_tag(ty:i32)->i32 {
    if ty<=7 {return ty-1}
    if ty==11 {return 8}
    7
}
fn enqueue(seen:&mut []i32,work:&mut []i32,block:i32) {
    if block>=0 && seen[block]<0 {seen[block]=work.len;work.push(block)}
}
fn function(g:&mut Graph,seen:&mut []i32,work:&mut []i32,block:i32) {
    if g.function_id[block]<0 {g.function_id[block]=g.functions.len;g.functions.push(block)}
    enqueue(&mut seen,&mut work,block)
}
pub fn index(code:&arm.Code,end:i32,entry:i32,callbacks:&[]i32)->Graph {
    var g:=Graph{starts:[],block_at:filled(end+1,0),relocation:filled(end,-1),next:[],taken:[],functions:[],function_id:[],addresses:[],address_id:[],prints:filled(9,-1)}
    // Include branch destinations and the instruction after each terminator.
    for label in code.labels {if label>=0 && label<end {g.block_at[label]=1}}
    for r in 0..code.at.len {
        at:=code.at[r]
        if at<end {
            g.relocation[at]=r
            if code.kinds[r]!=1 && code.kinds[r]!=20 {g.block_at[at+1]=1}
        }
    }
    for i in 0..end {if terminal(code.words[i]) {g.block_at[i+1]=1}}
    for i in 0..end {
        if i==0 || g.block_at[i]!=0 {g.starts.push(i)}
        g.block_at[i]=g.starts.len-1
    }
    g.block_at[end]=g.starts.len;g.starts.push(end)
    n:=g.starts.len-1
    for block in 0..n {
        at:=g.starts[block+1]-1;var fall:=block+1;var target:= -1
        if fall==n || terminal(code.words[at]) {fall= -1}
        r:=g.relocation[at]
        if r>=0 {
            kind:=code.kinds[r]
            if kind!=1 && kind!=20 {
                target=g.block_at[code.labels[code.target[r]]]
                if kind==0 {fall= -1}
            }
        }
        g.next.push(fall);g.taken.push(target)
    }
    g.function_id=filled(n,-1);g.address_id=filled(n,-1)
    var seen:=filled(n,-1);var work:[]i32=[]
    function(&mut g,&mut seen,&mut work,g.block_at[code.labels[entry]])
    for label in callbacks {function(&mut g,&mut seen,&mut work,g.block_at[code.labels[label]])}
    var cursor:=0
    while cursor<work.len {
        block:=work[cursor];cursor=cursor+1
        enqueue(&mut seen,&mut work,g.next[block]);enqueue(&mut seen,&mut work,g.taken[block])
        for at in g.starts[block]..g.starts[block+1] {
            r:=g.relocation[at]
            if r>=0 && (code.kinds[r]==1 || code.kinds[r]==20) {
                dest:=code.labels[code.target[r]]
                if dest<end {
                    destination:=g.block_at[dest]
                    function(&mut g,&mut seen,&mut work,destination)
                    if code.kinds[r]==20 && g.address_id[destination]<0 {
                        g.address_id[destination]=g.addresses.len;g.addresses.push(destination)
                    }
                }
            }
            w:=code.words[at]
            if w>=4227858433 && w<=4227858444 {g.prints[print_tag(i32(w-4227858432))]=0}
        }
    }
    g
}
pub fn blocks(g:&Graph,start:i32,indices:&mut []i32)->[]i32 {
    var work:[]i32=[]
    enqueue(&mut indices,&mut work,start)
    var i:=0
    while i<work.len {
        id:=work[i];i=i+1
        enqueue(&mut indices,&mut work,g.next[id]);enqueue(&mut indices,&mut work,g.taken[id])
    }
    work
}
