// Native relocatable code. The header digest identifies the fixed global label
// table. Function-private labels and instruction locations are stored as offsets.
import arm64 as arm
import cache_io
import cli
import lexer
import mir_lower as lower
import std.bytes as bytes
import sys

pub struct Start { words: i32, labels: i32, relocations: i32 }
pub fn start(code: &arm.Code) -> Start {
    Start { words: code.words.len, labels: code.labels.len, relocations: code.at.len }
}
fn tag(kind: lexer.Kind) -> u8 {
    match kind {
        .End => 0, .Name => 1, .Keyword => 2, .Integer => 3, .Float => 4,
        .String => 5, .Rune => 6, .Symbol => 7, .Newline => 8,
    }
}
fn tokens(output: &mut []u8, input: &lexer.Tokens, first: i32, last: i32) {
    for i in first..last {
        output.push(tag(input.kinds[i]))
        spelling := input.texts[i]
        bytes.append_le(&mut output, i64(spelling.len), 4)
        bytes.append_utf8(&mut output, spelling)
    }
}
pub fn context(input: &lexer.Tokens, starts: &[]i32, ends: &[]i32,
    owners: &[]i32, type_owners: &[]i32, platform: i32, globals: i32,
    callbacks: bool, identity: string) -> string {
    if identity == "" { return "" }
    var raw: []u8 = []
    bytes.append_utf8(&mut raw, identity + ":native3:" + platform.str() + ":" + globals.str())
    if callbacks { raw.push(1) } else { raw.push(0) }
    for owner in owners { bytes.append_le(&mut raw, i64(owner), 4) }
    for owner in type_owners { bytes.append_le(&mut raw, i64(owner), 4) }
    var position := 0
    for i in 0..starts.len {
        if starts[i] > 0 {
            tokens(&mut raw, &input, position, starts[i])
            position = ends[i]
        }
    }
    tokens(&mut raw, &input, position, input.kinds.len)
    cache_io.binary_hash(&raw)
}
pub fn key(context: string, function: i32, input: &lexer.Tokens, first: i32, last: i32) -> string {
    if context == "" { return "" }
    var raw: []u8 = []
    bytes.append_utf8(&mut raw, context)
    bytes.append_le(&mut raw, i64(function), 4)
    tokens(&mut raw, &input, first, last)
    cache_io.binary_hash(&raw)
}
fn put(output: &mut []u8, value: i64) {
    digits := "0123456789abcdef"
    for i in 0..8 { output.push(u8(digits[i32(value.shr((7 - i) * 4).bit_and(15))])) }
}
// Both live-suffix and detached-object writers use the same wire encoder.
// Offsets passed here are already function-local, IDs remain global until the
// relocation encoder tags globals or translates function-private label IDs.
fn header(output: &mut []u8, words: i32, labels: i32, relocations: i32,
    extended: bool, dependencies: i32, charged: i32) {
    if extended { put(&mut output, 1146439236); put(&mut output, 1) }
    put(&mut output, i64(words)); put(&mut output, i64(labels)); put(&mut output, i64(relocations))
    if extended { put(&mut output, i64(dependencies)); put(&mut output, i64(charged)) }
}
fn label_record(output: &mut []u8, offset: i32, words: i32) -> bool {
    if offset < -1 || offset > words { return false }
    if offset == -1 { put(&mut output, 4294967295) } else { put(&mut output, i64(offset)) }
    true
}
fn relocation_record(output: &mut []u8, at: i32, target: i32, kind: i32,
    words: i32, first_label: i32, label_end: i32, globals: i32) -> bool {
    if at < 0 || at >= words || kind < 0 || kind > 20 || (kind >= 2 && at >= words - 1) || target < 0 { return false }
    put(&mut output, i64(at))
    if target < globals { put(&mut output, 2147483648 + i64(target)) }
    else if target >= first_label && target < label_end { put(&mut output, i64(target - first_label)) }
    else { return false }
    put(&mut output, i64(kind)); true
}
fn values(source: string) -> []i64 {
    var result: []i64 = []
    if source.len % 8 != 0 { return result }
    result.reserve(source.len / 8)
    var value: i64 = 0
    for i in 0..source.len {
        byte := source[i]
        var digit := byte - 48
        if byte >= 97 && byte <= 102 { digit = byte - 87 }
        else if byte < 48 || byte > 57 { return [] }
        value = value * 16 + i64(digit)
        if i % 8 == 7 { result.push(value); value = 0 }
    }
    result
}
pub fn save(code: &arm.Code, begin: Start, globals: i32, path: string, key: string) {
    if key == "" { return }
    var output: []u8 = []
    words := code.words.len - begin.words
    header(&mut output, words, code.labels.len - begin.labels, code.at.len - begin.relocations, false, 0, 0)
    for i in begin.words..code.words.len { put(&mut output, code.words[i]) }
    for i in begin.labels..code.labels.len {
        var offset := code.labels[i]; if offset >= 0 { if offset < begin.words { return }; offset = offset - begin.words }
        if !label_record(&mut output, offset, words) { return }
    }
    for i in begin.relocations..code.at.len {
        if !relocation_record(&mut output, code.at[i] - begin.words, code.target[i], code.kinds[i], words, begin.labels, code.labels.len, globals) { return }
    }
    published := publish_dependencies(path, key, &output)
}
pub fn restore(code: &mut arm.Code, globals: i32, entry: i32, path: string, key: string) -> bool {
    if key == "" { return false }
    info := sys.metadata(path)
    if !info.is_file || info.size < 152 || info.size > 67108864 { return false }
    read := sys.read_text(path)
    if !read.ok || read.value.len < 152 || read.value[0..64] != key { return false }
    payload := read.value[128..read.value.len]
    if read.value[64..128] != cache_io.digest(key + payload) { return false }
    data := values(payload)
    if data.len < 3 { return false }
    if i64(3) + data[0] + data[1] + i64(3) * data[2] != i64(data.len) || data[0] == 0 { return false }
    words := i32(data[0])
    labels := i32(data[1])
    relocations := i32(data[2])
    label_start := 3 + words
    relocation_start := label_start + labels
    for i in 0..labels {
        offset := data[label_start + i]
        if offset != 4294967295 && offset > i64(words) { return false }
    }
    for i in 0..relocations {
        at := data[relocation_start + i * 3]
        target := data[relocation_start + i * 3 + 1]
        kind := data[relocation_start + i * 3 + 2]
        if at >= i64(words) || kind > 20 || (kind >= 2 && at + 1 >= i64(words)) { return false }
        if target >= 2147483648 {
            if target - 2147483648 >= i64(globals) { return false }
        } else if target >= i64(labels) || data[label_start + i32(target)] == 4294967295 { return false }
    }
    // Only mutate compiler state after every length and symbolic target is valid.
    base := code.words.len
    first := code.labels.len
    arm.mark(&mut code, entry)
    for i in 0..words { code.words.push(data[3 + i]) }
    for i in 0..labels {
        offset := data[label_start + i]
        if offset == 4294967295 { code.labels.push(-1) }
        else { code.labels.push(base + i32(offset)) }
    }
    for i in 0..relocations {
        destination := data[relocation_start + i * 3 + 1]
        var target := 0
        if destination >= 2147483648 { target = i32(destination - 2147483648) }
        else { target = first + i32(destination) }
        code.at.push(base + i32(data[relocation_start + i * 3]))
        code.kinds.push(i32(data[relocation_start + i * 3 + 2]))
        code.target.push(target)
    }
    true
}

// Explicit growth/dependency admission for future generic code transforms.
// Dependencies are sorted unique declaration IDs; charges count every admitted
// expansion, including repeated declarations and builtins without a declaration.
pub struct Dependencies { declarations: []i32, charged_words: i32 }
pub fn new_dependencies() -> Dependencies { Dependencies { declarations: [], charged_words: 0 } }
pub fn reset_dependencies(dependencies: &mut Dependencies) {
    dependencies.declarations.clear(); dependencies.charged_words = 0
}
fn valid_dependencies(dependencies: &Dependencies, declaration_limit: i32) -> bool {
    if declaration_limit < 0 || dependencies.declarations.len > 256 || dependencies.charged_words < 0 || dependencies.charged_words > 4096 { return false }
    var previous := -1
    for declaration in dependencies.declarations {
        if declaration <= previous || declaration >= declaration_limit { return false }
        previous = declaration
    }
    true
}
pub fn charge_dependency_words(dependencies: &mut Dependencies, estimate: i32) -> bool {
    if !valid_dependencies(&dependencies, 2147483647) || estimate < 0 || estimate > 4096 - dependencies.charged_words { return false }
    dependencies.charged_words = dependencies.charged_words + estimate; true
}
pub fn record_dependency(dependencies: &mut Dependencies, declaration: i32, estimate: i32) -> bool {
    if !valid_dependencies(&dependencies, 2147483647) || declaration < 0 || declaration == 2147483647 || estimate < 0 || estimate > 4096 - dependencies.charged_words { return false }
    var at := 0
    while at < dependencies.declarations.len && dependencies.declarations[at] < declaration { at = at + 1 }
    present := at < dependencies.declarations.len && dependencies.declarations[at] == declaration
    if !present && dependencies.declarations.len == 256 { return false }
    // Capacity and charge are both admitted before either public field changes.
    if !present {
        dependencies.declarations.push(declaration)
        var i := dependencies.declarations.len - 1
        while i > at { dependencies.declarations[i] = dependencies.declarations[i - 1]; i = i - 1 }
        dependencies.declarations[at] = declaration
    }
    dependencies.charged_words = dependencies.charged_words + estimate; true
}
fn valid_key(key: string) -> bool {
    if key.len != 64 { return false }
    for b in key.bytes() { if !(b >= 48 && b <= 57) && !(b >= 97 && b <= 102) { return false } }
    true
}
fn publish_dependencies(path: string, key: string, output: &[]u8) -> bool {
    if output.len > 67108864 - 128 || !cli.prepare_parent(path) { return false }
    payload := sys.decode_u8(&output)
    if !payload.ok { return false }
    temporary := path + "." + sys.pid().str() + ".tmp"
    signature := cache_io.digest(key + payload.value)
    written := sys.write_text(temporary, key + signature + payload.value)
    if written.ok {
        updated := sys.rename(temporary, path)
        if updated.ok { return true }
    }
    removed := sys.remove_file(temporary); false
}
pub fn save_with_dependencies(code: &arm.Code, begin: Start, globals: i32,
    path: string, key: string, dependencies: &Dependencies, declaration_limit: i32) -> bool {
    if !valid_key(key) || !valid_dependencies(&dependencies, declaration_limit) || code.checking { return false }
    if begin.words < 0 || begin.words >= code.words.len || begin.labels < 0 || begin.labels > code.labels.len || begin.relocations < 0 || begin.relocations > code.at.len { return false }
    if globals < 0 || globals > begin.labels || code.at.len != code.target.len || code.at.len != code.kinds.len { return false }
    words := code.words.len - begin.words; labels := code.labels.len - begin.labels; relocations := code.at.len - begin.relocations
    size := i64(7) + i64(words) + i64(labels) + i64(relocations) * 3 + i64(dependencies.declarations.len)
    if size * 8 + 128 > 67108864 { return false }
    var output: []u8 = []
    // DUFD, version 1. The old API interprets magic as an impossible word count
    // and declines this payload. New restore requires magic and rejects native3.
    header(&mut output, words, labels, relocations, true, dependencies.declarations.len, dependencies.charged_words)
    for i in begin.words..code.words.len {
        word := code.words[i]
        if word < 0 || word > 4294967295 { return false }
        put(&mut output, word)
    }
    for i in begin.labels..code.labels.len {
        var offset := code.labels[i]; if offset >= 0 { if offset < begin.words { return false }; offset = offset - begin.words }
        if !label_record(&mut output, offset, words) { return false }
    }
    for i in begin.relocations..code.at.len {
        at := code.at[i]; target := code.target[i]; kind := code.kinds[i]
        if at < begin.words || at >= code.words.len || kind < 0 || kind > 20 || (kind >= 2 && at + 1 >= code.words.len) { return false }
        if target < 0 || target >= code.labels.len { return false }
        if target >= globals && code.labels[target] < begin.words { return false }
        if !relocation_record(&mut output, at - begin.words, target, kind, words, begin.labels, code.labels.len, globals) { return false }
    }
    for declaration in dependencies.declarations { put(&mut output, i64(declaration)) }
    publish_dependencies(path, key, &output)
}
fn object_payload(output: &mut []u8, object: &lower.FunctionObject,
    first_label: i32, label_end: i32, globals: i32, extended: bool, count: i32, charged: i32) -> bool {
    if !lower.object_ready(&object) || first_label < 0 || label_end < first_label || globals < 0 || globals > first_label { return false }
    if lower.object_first_label(&object) != first_label || lower.object_label_end(&object) != label_end ||
        lower.object_import_count(&object) != 0 { return false }
    // Native3/DUFD never contained import sites or imported symbol slots. An
    // import-bearing object is ineligible, exactly as the serial producer was.
    words := lower.object_word_count(&object); labels := label_end - first_label
    relocations := lower.object_reloc_count(&object)
    var size := i64(3); if extended { size = 7 }
    size = size + i64(words) + i64(labels) + i64(relocations) * 3 + i64(count)
    if words <= 0 || size * 8 + 128 > 67108864 { return false }
    // A lowered/captured object owns the exact private range plus, optionally,
    // one predeclared global entry. The latter is NOT serialized as private.
    n := lower.object_label_count(&object)
    if i64(n) < i64(labels) || i64(n) > i64(labels) + 1 { return false }
    var first := 0
    if n > 0 && lower.object_label_id(&object, 0) < first_label { first = 1 }
    if labels > n - first { return false }
    for i in 0..labels { if lower.object_label_id(&object, first + i) != first_label + i { return false } }
    if first == 1 && lower.object_label_offset(&object, 0) != 0 { return false }
    if n > first + labels {
        if first != 0 || lower.object_label_id(&object, n - 1) < label_end || lower.object_label_offset(&object, n - 1) != 0 { return false }
    }
    header(&mut output, words, labels, relocations, extended, count, charged)
    for i in 0..words {
        word := lower.object_word(&object, i)
        if word < 0 || word > 4294967295 { return false }; put(&mut output, word)
    }
    for i in 0..labels {
        if !label_record(&mut output, lower.object_label_offset(&object, first + i), words) { return false }
    }
    for i in 0..relocations {
        target := lower.object_reloc_target(&object, i)
        if target >= globals {
            if target < first_label || target >= label_end { return false }
            if lower.object_label_offset(&object, first + target - first_label) < 0 { return false }
        }
        if !relocation_record(&mut output, lower.object_reloc_at(&object, i), target,
            lower.object_reloc_kind(&object, i), words, first_label, label_end, globals) { return false }
    }
    true
}
// Save final detached bytes, not the provisional frontend suffix. No Code or
// MIR snapshot is constructed, and future namespace growth is irrelevant.
// A rejected save leaves the previous cache file intact.
pub fn save_object(object: &lower.FunctionObject, first_label: i32, label_end: i32,
    globals: i32, path: string, key: string) -> bool {
    if !valid_key(key) { return false }
    var output: []u8 = []
    if !object_payload(&mut output, &object, first_label, label_end, globals, false, 0, 0) { return false }
    publish_dependencies(path, key, &output)
}
pub fn save_object_with_dependencies(object: &lower.FunctionObject, first_label: i32, label_end: i32,
    globals: i32, path: string, key: string, dependencies: &Dependencies, declaration_limit: i32) -> bool {
    if !valid_key(key) || !valid_dependencies(&dependencies, declaration_limit) { return false }
    var output: []u8 = []
    if !object_payload(&mut output, &object, first_label, label_end, globals, true,
        dependencies.declarations.len, dependencies.charged_words) { return false }
    for declaration in dependencies.declarations { put(&mut output, i64(declaration)) }
    publish_dependencies(path, key, &output)
}
fn restore_dependencies(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_global_words: i32,
    dependencies: &mut Dependencies, allow_native3: bool) -> bool {
    if !valid_key(key) || declaration_limit < 0 || available_global_words < 0 || code.checking { return false }
    if globals < 0 || globals > code.labels.len || entry < 0 || entry >= code.labels.len || code.labels[entry] != -1 { return false }
    if code.at.len != code.target.len || code.at.len != code.kinds.len { return false }
    var minimum:=184;if allow_native3{minimum=152}
    info := sys.metadata(path)
    if !info.is_file || info.size < i64(minimum) || info.size > 67108864 { return false }
    read := sys.read_text(path)
    if !read.ok || read.value.len < minimum || read.value.len > 67108864 || read.value[0..64] != key { return false }
    payload := read.value[128..read.value.len]
    if read.value[64..128] != cache_io.digest(key + payload) { return false }
    data := values(payload)
    if data.len < 3 { return false }
    var header:=3;var word_count:=data[0];var label_count:=data[1];var relocation_count:=data[2]
    var dependency_count:i64=0;var charged_words:i64=0
    if data[0]==1146439236{
        if data.len<7 || data[1]!=1{return false}
        header=7;word_count=data[2];label_count=data[3];relocation_count=data[4]
        dependency_count=data[5];charged_words=data[6]
    }else if !allow_native3{return false}
    if word_count==0 || dependency_count>256 || charged_words>4096 || charged_words>i64(available_global_words){return false}
    size:=i64(header)+word_count+label_count+relocation_count*3+dependency_count
    if size!=i64(data.len) || word_count>i64(2147483647-code.words.len) || label_count>i64(2147483647-code.labels.len) || relocation_count>i64(2147483647-code.at.len){return false}
    words:=i32(word_count);labels:=i32(label_count);relocations:=i32(relocation_count);count:=i32(dependency_count)
    label_start := header + words; relocation_start := label_start + labels
    declaration_start := relocation_start + relocations * 3
    var previous: i64 = -1
    for i in 0..count {
        declaration := data[declaration_start + i]
        if declaration <= previous || declaration >= i64(declaration_limit) { return false }
        previous = declaration
    }
    for i in 0..labels {
        offset := data[label_start + i]
        if offset != 4294967295 && offset > i64(words) { return false }
    }
    for i in 0..relocations {
        at := data[relocation_start + i * 3]; target := data[relocation_start + i * 3 + 1]; kind := data[relocation_start + i * 3 + 2]
        if at >= i64(words) || kind > 20 || (kind >= 2 && at + 1 >= i64(words)) { return false }
        if target >= 2147483648 {
            if target - 2147483648 >= i64(globals) { return false }
        } else if target >= i64(labels) || data[label_start + i32(target)] == 4294967295 { return false }
    }
    var accepted := new_dependencies()
    for i in 0..count { accepted.declarations.push(i32(data[declaration_start + i])) }
    accepted.charged_words = i32(charged_words)
    // All metadata and relocations have been checked. Commit code and output
    // dependencies only now; every false return above leaves both untouched.
    base := code.words.len; first := code.labels.len
    arm.mark(&mut code, entry)
    for i in 0..words { code.words.push(data[header + i]) }
    for i in 0..labels {
        offset := data[label_start + i]
        if offset == 4294967295 { code.labels.push(-1) } else { code.labels.push(base + i32(offset)) }
    }
    for i in 0..relocations {
        destination := data[relocation_start + i * 3 + 1]
        var target := 0
        if destination >= 2147483648 { target = i32(destination - 2147483648) } else { target = first + i32(destination) }
        code.at.push(base + i32(data[relocation_start + i * 3])); code.kinds.push(i32(data[relocation_start + i * 3 + 2])); code.target.push(target)
    }
    dependencies = accepted; true
}
pub fn restore_with_dependencies(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_global_words: i32,
    dependencies: &mut Dependencies) -> bool {
    restore_dependencies(&mut code,globals,entry,path,key,declaration_limit,available_global_words,&mut dependencies,false)
}
// One read/decode for the common scalar native3 cache as well as DUFD. A
// successful native3 restore commits empty dependency metadata and zero charge.
// Failed restores preserve both outputs; strict DUFD restoration stays separate.
pub fn restore_cached_with_dependencies(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_global_words: i32,
    dependencies: &mut Dependencies) -> bool {
    restore_dependencies(&mut code,globals,entry,path,key,declaration_limit,available_global_words,&mut dependencies,true)
}
