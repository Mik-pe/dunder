// Native relocatable code. The header digest identifies the fixed global label
// table. Function-private labels and instruction locations are stored as offsets.
import arm64 as arm
import cache_io
import cli
import lexer
import native_clock as monotonic
import std.bytes as bytes
import sys

// Optional nested attribution. One external meter is reused for the complete
// compiler call. Disabled meters allocate no stage arrays and read no clocks.
pub struct Meter { enabled: bool, host: i32, clock_ok: bool, elapsed: []i64, calls: []i64, work: []i64 }
pub fn new_meter(host: i32) -> Meter {
    var m := Meter { enabled: host >= 0 && host <= 2, host: host, clock_ok: true, elapsed: [], calls: [], work: [] }
    if m.enabled { for i in 0..9 { m.elapsed.push(0); m.calls.push(0); m.work.push(0) } }
    m
}
pub fn meter_phase(phase: i32) -> string {
    if phase == 0 { return "identity_serialize" }; if phase == 1 { return "identity_hash" }
    if phase == 2 { return "metadata_read" }; if phase == 3 { return "content_hash" }
    if phase == 4 { return "hex_decode" }; if phase == 5 { return "validation" }
    if phase == 6 { return "commit" }; if phase == 7 { return "serialization" }; "publication"
}
fn meter_unit(phase: i32) -> string { if phase == 5 { return "records" }; if phase == 6 { return "words" }; "bytes" }
fn meter_begin(m: &Meter) -> i64 { if !m.enabled { return -1 }; monotonic.nanoseconds(m.host) }
pub fn record_meter(m: &mut Meter, phase: i32, first: i64, last: i64, work: i64) {
    if !m.enabled { return }
    if phase < 0 || phase >= 9 || work < 0 { m.clock_ok = false; return }
    m.calls[phase] = m.calls[phase] + 1; m.work[phase] = m.work[phase] + work
    if first < 0 || last < first { m.clock_ok = false; return }
    m.elapsed[phase] = m.elapsed[phase] + last - first
}
fn meter_finish(m: &mut Meter, phase: i32, first: i64, work: i64) {
    if !m.enabled { return }
    last := monotonic.nanoseconds(m.host); record_meter(&mut m, phase, first, last, work)
}
pub fn json_meter(m: &Meter) -> string {
    if !m.enabled { return "{\"enabled\":false}" }
    var flag := "false"; var total := "null"; var sum: i64 = 0
    for elapsed in m.elapsed { sum = sum + elapsed }
    if m.clock_ok { flag = "true"; total = sum.str() }
    var out := "{\"enabled\":true,\"clock_ok\":" + flag + ",\"unit\":\"ns\",\"overlaps_parent\":\"fragment_cache\",\"included_in_covered\":false,\"total\":" + total + ",\"phases\":{"
    for phase in 0..9 {
        if phase > 0 { out = out + "," }
        var value := "null"; if m.clock_ok { value = m.elapsed[phase].str() }
        out = out + "\"" + meter_phase(phase) + "\":" + value
    }
    out = out + "},\"calls\":{"
    for phase in 0..9 {
        if phase > 0 { out = out + "," }
        out = out + "\"" + meter_phase(phase) + "\":" + m.calls[phase].str()
    }
    out = out + "},\"work\":{"
    for phase in 0..9 {
        if phase > 0 { out = out + "," }
        out = out + "\"" + meter_phase(phase) + "_" + meter_unit(phase) + "\":" + m.work[phase].str()
    }
    out + "}}"
}

pub struct Start { words: i32, labels: i32, relocations: i32 }
pub fn start(code: &arm.Code) -> Start {
    Start { words: code.words.len, labels: code.labels.len, relocations: code.at.len }
}
fn tag(kind: lexer.Kind) -> u8 {
    match kind {
        .End => 0, .Name => 1, .Keyword => 2, .Integer => 3, .Float => 4,
        .String => 5, .Rune => 6, .Symbol => 7, .Newline => 8,
    }
}
fn tokens(output: &mut []u8, input: &lexer.Tokens, first: i32, last: i32) {
    for i in first..last {
        output.push(tag(input.kinds[i]))
        spelling := input.texts[i]
        bytes.append_le(&mut output, i64(spelling.len), 4)
        bytes.append_utf8(&mut output, spelling)
    }
}
fn context_payload(raw: &mut []u8, input: &lexer.Tokens, starts: &[]i32, ends: &[]i32,
    owners: &[]i32, type_owners: &[]i32, platform: i32, globals: i32,
    callbacks: bool, identity: string) {
    bytes.append_utf8(&mut raw, identity + ":native3:" + platform.str() + ":" + globals.str())
    if callbacks { raw.push(1) } else { raw.push(0) }
    for owner in owners { bytes.append_le(&mut raw, i64(owner), 4) }
    for owner in type_owners { bytes.append_le(&mut raw, i64(owner), 4) }
    var position := 0
    for i in 0..starts.len {
        if starts[i] > 0 {
            tokens(&mut raw, &input, position, starts[i])
            position = ends[i]
        }
    }
    tokens(&mut raw, &input, position, input.kinds.len)
}
fn key_payload(raw: &mut []u8, context: string, function: i32, input: &lexer.Tokens, first: i32, last: i32) {
    bytes.append_utf8(&mut raw, context)
    bytes.append_le(&mut raw, i64(function), 4)
    tokens(&mut raw, &input, first, last)
}
pub fn context(input: &lexer.Tokens, starts: &[]i32, ends: &[]i32,
    owners: &[]i32, type_owners: &[]i32, platform: i32, globals: i32,
    callbacks: bool, identity: string) -> string {
    if identity == "" { return "" }
    var raw: []u8 = []; context_payload(&mut raw,&input,&starts,&ends,&owners,&type_owners,platform,globals,callbacks,identity)
    cache_io.binary_hash(&raw)
}
pub fn key(context: string, function: i32, input: &lexer.Tokens, first: i32, last: i32) -> string {
    if context == "" { return "" }
    var raw: []u8 = []; key_payload(&mut raw,context,function,&input,first,last)
    cache_io.binary_hash(&raw)
}
pub fn context_metered(input: &lexer.Tokens, starts: &[]i32, ends: &[]i32,
    owners: &[]i32, type_owners: &[]i32, platform: i32, globals: i32,
    callbacks: bool, identity: string, meter: &mut Meter) -> string {
    if identity == "" { return "" }
    var started: i64 = -1; if meter.enabled { started = meter_begin(&meter) }
    var raw: []u8 = []; context_payload(&mut raw,&input,&starts,&ends,&owners,&type_owners,platform,globals,callbacks,identity)
    if meter.enabled { meter_finish(&mut meter,0,started,i64(raw.len)); started = meter_begin(&meter) }
    result := cache_io.binary_hash(&raw)
    if meter.enabled { meter_finish(&mut meter,1,started,i64(raw.len)) }
    result
}
pub fn key_metered(context: string, function: i32, input: &lexer.Tokens, first: i32, last: i32, meter: &mut Meter) -> string {
    if context == "" { return "" }
    var started: i64 = -1; if meter.enabled { started = meter_begin(&meter) }
    var raw: []u8 = []; key_payload(&mut raw,context,function,&input,first,last)
    if meter.enabled { meter_finish(&mut meter,0,started,i64(raw.len)); started = meter_begin(&meter) }
    result := cache_io.binary_hash(&raw)
    if meter.enabled { meter_finish(&mut meter,1,started,i64(raw.len)) }
    result
}
fn put(output: &mut []u8, value: i64) {
    digits := "0123456789abcdef"
    for i in 0..8 { output.push(u8(digits[i32(value.shr((7 - i) * 4).bit_and(15))])) }
}
fn values(source: string) -> []i64 {
    var result: []i64 = []
    if source.len % 8 != 0 { return result }
    result.reserve(source.len / 8)
    var value: i64 = 0
    for i in 0..source.len {
        byte := source[i]
        var digit := byte - 48
        if byte >= 97 && byte <= 102 { digit = byte - 87 }
        else if byte < 48 || byte > 57 { return [] }
        value = value * 16 + i64(digit)
        if i % 8 == 7 { result.push(value); value = 0 }
    }
    result
}
// Explicit growth/dependency admission for future generic code transforms.
// Dependencies are sorted unique declaration IDs; charges count every admitted
// expansion, including repeated declarations and builtins without a declaration.
pub struct Dependencies { declarations: []i32, charged_words: i32 }
pub fn new_dependencies() -> Dependencies { Dependencies { declarations: [], charged_words: 0 } }
pub fn reset_dependencies(dependencies: &mut Dependencies) {
    dependencies.declarations.clear(); dependencies.charged_words = 0
}
fn valid_dependencies(dependencies: &Dependencies, declaration_limit: i32) -> bool {
    if declaration_limit < 0 || dependencies.declarations.len > 256 || dependencies.charged_words < 0 || dependencies.charged_words > 4096 { return false }
    var previous := -1
    for declaration in dependencies.declarations {
        if declaration <= previous || declaration >= declaration_limit { return false }
        previous = declaration
    }
    true
}
pub fn charge_dependency_words(dependencies: &mut Dependencies, estimate: i32) -> bool {
    if !valid_dependencies(&dependencies, 2147483647) || estimate < 0 || estimate > 4096 - dependencies.charged_words { return false }
    dependencies.charged_words = dependencies.charged_words + estimate; true
}
pub fn record_dependency(dependencies: &mut Dependencies, declaration: i32, estimate: i32) -> bool {
    if !valid_dependencies(&dependencies, 2147483647) || declaration < 0 || declaration == 2147483647 || estimate < 0 || estimate > 4096 - dependencies.charged_words { return false }
    var at := 0
    while at < dependencies.declarations.len && dependencies.declarations[at] < declaration { at = at + 1 }
    present := at < dependencies.declarations.len && dependencies.declarations[at] == declaration
    if !present && dependencies.declarations.len == 256 { return false }
    // Capacity and charge are both admitted before either public field changes.
    if !present {
        dependencies.declarations.push(declaration)
        var i := dependencies.declarations.len - 1
        while i > at { dependencies.declarations[i] = dependencies.declarations[i - 1]; i = i - 1 }
        dependencies.declarations[at] = declaration
    }
    dependencies.charged_words = dependencies.charged_words + estimate; true
}
fn valid_key(key: string) -> bool {
    if key.len != 64 { return false }
    for b in key.bytes() { if !(b >= 48 && b <= 57) && !(b >= 97 && b <= 102) { return false } }
    true
}
// All formats share serialization, validation and commit logic. Policy 0 is
// native3 only, 1 is strict DUFD, and 2 accepts either on a single file read.
fn serialize_body(code: &arm.Code, begin: &Start, globals: i32, output: &mut []u8, strict: bool) -> bool {
    for i in begin.words..code.words.len {
        word := code.words[i]
        if strict && (word < 0 || word > 4294967295) { return false }
        put(&mut output, word)
    }
    for i in begin.labels..code.labels.len {
        offset := code.labels[i]
        if offset < 0 {
            if strict && offset != -1 { return false }
            put(&mut output, 4294967295)
        } else {
            if offset < begin.words || (strict && offset > code.words.len) { return false }
            put(&mut output, i64(offset - begin.words))
        }
    }
    for i in begin.relocations..code.at.len {
        at := code.at[i]; target := code.target[i]; kind := code.kinds[i]
        if strict && (at < begin.words || at >= code.words.len || kind < 0 || kind > 20 || (kind >= 2 && at + 1 >= code.words.len) || target < 0 || target >= code.labels.len) { return false }
        put(&mut output, i64(at - begin.words))
        if target < globals { put(&mut output, 2147483648 + i64(target)) }
        else if target >= begin.labels {
            if strict && code.labels[target] < begin.words { return false }
            put(&mut output, i64(target - begin.labels))
        } else { return false }
        put(&mut output, i64(kind))
    }
    true
}
fn valid_start(code: &arm.Code, begin: &Start, globals: i32) -> bool {
    !code.checking && begin.words >= 0 && begin.words <= code.words.len &&
        begin.labels >= 0 && begin.labels <= code.labels.len && begin.relocations >= 0 && begin.relocations <= code.at.len &&
        globals >= 0 && globals <= begin.labels && code.at.len == code.target.len && code.at.len == code.kinds.len
}
fn serialize_legacy(code: &arm.Code, begin: &Start, globals: i32, output: &mut []u8) -> bool {
    if !valid_start(&code, &begin, globals) { return false }
    put(&mut output, i64(code.words.len - begin.words)); put(&mut output, i64(code.labels.len - begin.labels)); put(&mut output, i64(code.at.len - begin.relocations))
    serialize_body(&code, &begin, globals, &mut output, false)
}
fn serialize_dependencies(code: &arm.Code, begin: &Start, globals: i32, dependencies: &Dependencies, declaration_limit: i32, output: &mut []u8) -> bool {
    if !valid_dependencies(&dependencies, declaration_limit) || !valid_start(&code, &begin, globals) || begin.words == code.words.len { return false }
    size := i64(7) + i64(code.words.len - begin.words) + i64(code.labels.len - begin.labels) + i64(code.at.len - begin.relocations) * 3 + i64(dependencies.declarations.len)
    if size * 8 + 128 > 67108864 { return false }
    put(&mut output, 1146439236); put(&mut output, 1)
    put(&mut output, i64(code.words.len - begin.words)); put(&mut output, i64(code.labels.len - begin.labels)); put(&mut output, i64(code.at.len - begin.relocations))
    put(&mut output, i64(dependencies.declarations.len)); put(&mut output, i64(dependencies.charged_words))
    if !serialize_body(&code, &begin, globals, &mut output, true) { return false }
    for declaration in dependencies.declarations { put(&mut output, i64(declaration)) }
    true
}
fn publish_payload(path: string, key: string, signature: string, payload: string) -> bool {
    if payload.len > 67108864 - 128 || !cli.prepare_parent(path) { return false }
    temporary := path + "." + sys.pid().str() + ".tmp"
    written := sys.write_text(temporary, key + signature + payload)
    if written.ok { updated := sys.rename(temporary, path); if updated.ok { return true } }
    removed := sys.remove_file(temporary); false
}
fn publish_metered(path: string, key: string, output: &[]u8, started: i64, meter: &mut Meter) -> bool {
    payload := sys.decode_u8(&output)
    if meter.enabled { meter_finish(&mut meter,7,started,i64(output.len)) }
    if !payload.ok { return false }
    var first: i64 = -1; if meter.enabled { first = meter_begin(&meter) }
    signature := cache_io.digest(key + payload.value)
    if meter.enabled { meter_finish(&mut meter,3,first,i64(key.len) + i64(payload.value.len)); first = meter_begin(&meter) }
    result := publish_payload(path,key,signature,payload.value)
    if meter.enabled { meter_finish(&mut meter,8,first,i64(key.len) + 64 + i64(payload.value.len)) }
    result
}
pub fn save_metered(code: &arm.Code, begin: Start, globals: i32, path: string, key: string, meter: &mut Meter) -> bool {
    if key == "" { return false }
    var first: i64 = -1; if meter.enabled { first = meter_begin(&meter) }
    var output: []u8 = []
    if !serialize_legacy(&code,&begin,globals,&mut output) {
        if meter.enabled { meter_finish(&mut meter,7,first,i64(output.len)) }; return false
    }
    publish_metered(path,key,&output,first,&mut meter)
}
pub fn save_with_dependencies_metered(code: &arm.Code, begin: Start, globals: i32,
    path: string, key: string, dependencies: &Dependencies, declaration_limit: i32, meter: &mut Meter) -> bool {
    if !valid_key(key) { return false }
    var first: i64 = -1; if meter.enabled { first = meter_begin(&meter) }
    var output: []u8 = []
    if !serialize_dependencies(&code,&begin,globals,&dependencies,declaration_limit,&mut output) {
        if meter.enabled { meter_finish(&mut meter,7,first,i64(output.len)) }; return false
    }
    publish_metered(path,key,&output,first,&mut meter)
}
fn payload_header(data: &[]i64, policy: i32) -> i32 {
    if data.len < 3 { return -1 }
    if data[0] == 1146439236 {
        if policy == 0 || data.len < 7 || data[1] != 1 { return -1 }
        return 7
    }
    if policy == 1 { return -1 }; 3
}
fn validate_payload(data: &[]i64, header: i32, globals: i32, declaration_limit: i32, available_global_words: i32,
    base: i32, first_label: i32, first_relocation: i32) -> bool {
    if header < 0 { return false }
    var word_count := data[0]; var label_count := data[1]; var relocation_count := data[2]
    var dependency_count: i64 = 0; var charge: i64 = 0
    if header == 7 { word_count=data[2]; label_count=data[3]; relocation_count=data[4]; dependency_count=data[5]; charge=data[6] }
    if word_count == 0 || dependency_count > 256 || charge > 4096 || charge > i64(available_global_words) { return false }
    if i64(header)+word_count+label_count+relocation_count*3+dependency_count != i64(data.len) || word_count>i64(2147483647-base) || label_count>i64(2147483647-first_label) || relocation_count>i64(2147483647-first_relocation) { return false }
    words:=i32(word_count); labels:=i32(label_count); relocations:=i32(relocation_count); count:=i32(dependency_count)
    label_start:=header+words; relocation_start:=label_start+labels; declaration_start:=relocation_start+relocations*3
    var previous: i64 = -1
    for i in 0..count {
        declaration:=data[declaration_start+i]
        if declaration<=previous || declaration>=i64(declaration_limit) { return false }; previous=declaration
    }
    for i in 0..labels { offset:=data[label_start+i]; if offset!=4294967295 && offset>i64(words) { return false } }
    for i in 0..relocations {
        at:=data[relocation_start+i*3]; target:=data[relocation_start+i*3+1]; kind:=data[relocation_start+i*3+2]
        if at>=i64(words) || kind>20 || (kind>=2 && at+1>=i64(words)) { return false }
        if target>=2147483648 { if target-2147483648>=i64(globals) { return false } }
        else if target>=i64(labels) || data[label_start+i32(target)]==4294967295 { return false }
    }
    true
}
fn commit_payload(code: &mut arm.Code, entry: i32, data: &[]i64, header: i32,
    dependencies: &mut Dependencies, replace_dependencies: bool) {
    var words:=i32(data[0]); var labels:=i32(data[1]); var relocations:=i32(data[2])
    if header==7 { words=i32(data[2]); labels=i32(data[3]); relocations=i32(data[4]) }
    label_start:=header+words; relocation_start:=label_start+labels; declaration_start:=relocation_start+relocations*3
    base:=code.words.len; first:=code.labels.len
    arm.mark(&mut code,entry)
    for i in 0..words { code.words.push(data[header+i]) }
    for i in 0..labels {
        offset:=data[label_start+i]
        if offset==4294967295 { code.labels.push(-1) } else { code.labels.push(base+i32(offset)) }
    }
    for i in 0..relocations {
        destination:=data[relocation_start+i*3+1]; var target:=0
        if destination>=2147483648 { target=i32(destination-2147483648) } else { target=first+i32(destination) }
        code.at.push(base+i32(data[relocation_start+i*3]));code.kinds.push(i32(data[relocation_start+i*3+2]));code.target.push(target)
    }
    if replace_dependencies {
        // Validated before either output mutates. Reuse caller-owned capacity;
        // no per-function observer or temporary Dependencies record is needed.
        dependencies.declarations.clear(); dependencies.charged_words=0
        if header==7 {
            for i in 0..i32(data[5]) { dependencies.declarations.push(i32(data[declaration_start+i])) }
            dependencies.charged_words=i32(data[6])
        }
    }
}
fn restore_engine(code: &mut arm.Code, globals: i32, entry: i32, path: string, key: string,
    declaration_limit: i32, available_global_words: i32, dependencies: &mut Dependencies, policy: i32, meter: &mut Meter) -> bool {
    if policy<0 || policy>2 || !valid_key(key) || declaration_limit<0 || available_global_words<0 || code.checking { return false }
    if globals<0 || globals>code.labels.len || entry<0 || entry>=code.labels.len || code.labels[entry]!=-1 || code.at.len!=code.target.len || code.at.len!=code.kinds.len { return false }
    var first: i64 = -1; if meter.enabled { first=meter_begin(&meter) }
    var minimum:=152; if policy==1 { minimum=184 }
    info:=sys.metadata(path)
    if !info.is_file || info.size<i64(minimum) || info.size>67108864 {
        if meter.enabled { meter_finish(&mut meter,2,first,0) }; return false
    }
    read:=sys.read_text(path)
    if meter.enabled { meter_finish(&mut meter,2,first,i64(read.value.len)); first=meter_begin(&meter) }
    if !read.ok || read.value.len<minimum || read.value.len>67108864 {
        if meter.enabled { meter_finish(&mut meter,3,first,0) }; return false
    }
    if read.value[0..64]!=key { if meter.enabled { meter_finish(&mut meter,3,first,0) }; return false }
    payload:=read.value[128..read.value.len]
    signature_ok:=read.value[64..128]==cache_io.digest(key+payload)
    if meter.enabled { meter_finish(&mut meter,3,first,i64(key.len)+i64(payload.len)) }
    if !signature_ok { return false }
    if meter.enabled { first=meter_begin(&meter) }
    data:=values(payload)
    if meter.enabled { meter_finish(&mut meter,4,first,i64(payload.len)); first=meter_begin(&meter) }
    header:=payload_header(&data,policy)
    valid:=validate_payload(&data,header,globals,declaration_limit,available_global_words,code.words.len,code.labels.len,code.at.len)
    if meter.enabled { meter_finish(&mut meter,5,first,i64(data.len)) }
    if !valid { return false }
    var words:=data[0]; if header==7 { words=data[2] }
    if meter.enabled { first=meter_begin(&meter) }
    commit_payload(&mut code,entry,&data,header,&mut dependencies,policy!=0)
    if meter.enabled { meter_finish(&mut meter,6,first,words) }
    true
}
pub fn restore_metered(code: &mut arm.Code, globals: i32, entry: i32, path: string, key: string,
    scratch: &mut Dependencies, meter: &mut Meter) -> bool {
    restore_engine(&mut code,globals,entry,path,key,2147483647,2147483647,&mut scratch,0,&mut meter)
}
pub fn restore_with_dependencies_metered(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_global_words: i32, dependencies: &mut Dependencies, meter: &mut Meter) -> bool {
    restore_engine(&mut code,globals,entry,path,key,declaration_limit,available_global_words,&mut dependencies,1,&mut meter)
}
pub fn restore_cached_with_dependencies_metered(code: &mut arm.Code, globals: i32, entry: i32,
    path: string, key: string, declaration_limit: i32, available_global_words: i32, dependencies: &mut Dependencies, meter: &mut Meter) -> bool {
    restore_engine(&mut code,globals,entry,path,key,declaration_limit,available_global_words,&mut dependencies,2,&mut meter)
}
// Compatibility APIs; production compilation passes one external meter and
// scratch dependency object through the configured entrypoints above.
pub fn save(code: &arm.Code, begin: Start, globals: i32, path: string, key: string) {
    var meter:=new_meter(-1); saved:=save_metered(&code,begin,globals,path,key,&mut meter)
}
pub fn save_with_dependencies(code: &arm.Code, begin: Start, globals: i32, path: string, key: string, dependencies: &Dependencies, declaration_limit: i32) -> bool {
    var meter:=new_meter(-1);save_with_dependencies_metered(&code,begin,globals,path,key,&dependencies,declaration_limit,&mut meter)
}
pub fn restore(code: &mut arm.Code, globals: i32, entry: i32, path: string, key: string) -> bool {
    var meter:=new_meter(-1);var scratch:=new_dependencies();restore_metered(&mut code,globals,entry,path,key,&mut scratch,&mut meter)
}
pub fn restore_with_dependencies(code: &mut arm.Code, globals: i32, entry: i32, path: string, key: string, declaration_limit: i32, available_global_words: i32, dependencies: &mut Dependencies) -> bool {
    var meter:=new_meter(-1);restore_with_dependencies_metered(&mut code,globals,entry,path,key,declaration_limit,available_global_words,&mut dependencies,&mut meter)
}
pub fn restore_cached_with_dependencies(code: &mut arm.Code, globals: i32, entry: i32, path: string, key: string, declaration_limit: i32, available_global_words: i32, dependencies: &mut Dependencies) -> bool {
    var meter:=new_meter(-1);restore_cached_with_dependencies_metered(&mut code,globals,entry,path,key,declaration_limit,available_global_words,&mut dependencies,&mut meter)
}
