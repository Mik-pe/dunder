// Lower the shared compiler/runtime instruction stream to Wasm functions.
// Internal calls carry values in i64 register globals. Only the host-facing
// imports, callbacks and main wrapper use externally visible scalar signatures.
import arm64 as arm
import wasm_abi as abi
import wasm_alu as alu
import wasm_bytes as b
import wasm_flow as flow
import wasm_memory as memory

pub struct Result {ok:bool,error:string,text:[]u8}
struct Image {imports:i32,table_base:i32,data_start:i32,data_base:i32,heap:i32,stack_bottom:i32,print_base:i32}
fn print_type(tag:i32)->i32 {
    if tag==1 || tag==8 {return 126}
    if tag==5 {return 125};if tag==6 {return 124};127
}
fn print_name(tag:i32)->string {
    if tag==0 {return "print_i32"};if tag==1 {return "print_i64"}
    if tag==2 {return "print_bool"};if tag==3 {return "print_string"}
    if tag==4 {return "print_rune"};if tag==5 {return "print_f32"}
    if tag==6 {return "print_f64"};if tag==7 {return "print_u32"};"print_u64"
}
fn move_constant(out:&mut []u8,w:i64,kind:i64) {
    reg:=b.bits(w,0,31);shift:=16*b.bits(w,21,3)
    value:=i64(b.bits(w,5,65535)).shl(shift)
    if kind==1920991232 {
        b.read(&mut out,reg);b.constant(&mut out,i64(65535).shl(shift).bit_not());b.op(&mut out,131)
        b.constant(&mut out,value);b.op(&mut out,132)
        if b.bits(w,31,1)==0 {b.op(&mut out,167);b.op(&mut out,173)}
    }else{b.constant(&mut out,value)}
    b.write(&mut out,reg)
}
fn instruction(out:&mut []u8,code:&arm.Code,g:&flow.Graph,m:&Image,a:&abi.Abi,at:i32)->bool {
    r:=g.relocation[at]
    if r>=0 {
        kind:=code.kinds[r];loc:=code.labels[code.target[r]]
        if kind==1 {b.indexed(&mut out,16,m.imports+g.function_id[g.block_at[loc]])}
        else if kind==20 {
            var address:=0
            if loc>=m.data_start {address=m.data_base+(loc-m.data_start)*4}
            else {address=m.table_base+g.address_id[g.block_at[loc]]}
            b.constant(&mut out,i64(address));b.write(&mut out,0)
        }
        return true
    }
    w:=code.words[at]
    if w==3573751839 {return true}
    if w==3596551104 {b.op(&mut out,15);return true}
    if w==3558866944 {b.op(&mut out,0);return true}
    if w==3556769793 {
        // Reachable nonportable syscalls are rejected by the frontend. The
        // shared checked arithmetic/runtime trap tails invoke exit_group.
        if at>0 && code.words[at-1]==3531606984 {b.op(&mut out,0);return true}
        return false
    }
    if w>=4227858433 && w<=4227858444 {
        tag:=flow.print_tag(i32(w-4227858432));b.read(&mut out,0)
        ty:=print_type(tag)
        if ty==127 || ty==125 {b.op(&mut out,167)};if ty==125 {b.op(&mut out,190)};if ty==124 {b.op(&mut out,191)}
        b.indexed(&mut out,16,g.prints[tag]);return true
    }
    if b.bits(w,24,255)==251 {abi.dispatch(&mut out,&a,b.bits(w,0,16777215));return true}
    if w.bit_and(4294966303)==3594452992 {
        b.read(&mut out,b.bits(w,5,31));b.op(&mut out,167);b.indexed(&mut out,17,0);b.op(&mut out,0);return true
    }
    kind:=w.bit_and(2139095040)
    if kind==1384120320 || kind==1920991232 {move_constant(&mut out,w,kind);return true}
    if memory.word(&mut out,w) {return true}
    alu.word(&mut out,w)
}
fn jump_condition(out:&mut []u8,kind:i32) {
    if kind==18 || kind==19 {b.read(&mut out,0);b.op(&mut out,80);if kind==19 {b.op(&mut out,69)}}
    else {alu.condition(&mut out,kind-2)}
}
fn body(out:&mut []u8,code:&arm.Code,g:&flow.Graph,m:&Image,a:&abi.Abi,root:i32,indices:&mut []i32)->string {
    blocks:=flow.blocks(&g,root,&mut indices)
    // Native calls get fresh scratch locals and a private block index. State
    // needed by the callee or by nested calls lives in the shared register bank.
    b.op(&mut out,2);b.op(&mut out,8);b.op(&mut out,126);b.op(&mut out,1);b.op(&mut out,127)
    b.op(&mut out,3);b.op(&mut out,64)
    for id in blocks {b.op(&mut out,2);b.op(&mut out,64)}
    b.indexed(&mut out,32,8);b.indexed(&mut out,14,blocks.len)
    for i in 0..blocks.len {b.uleb(&mut out,i)};b.uleb(&mut out,0)
    for i in 0..blocks.len {
        b.op(&mut out,11)
        block:=blocks[i];limit:=g.starts[block+1]
        for at in g.starts[block]..limit {
            if !instruction(&mut out,&code,&g,&m,&a,at) {return "unsupported wasm32 instruction "+code.words[at].str()+" at "+at.str()}
        }
        fall:=g.next[block];take:=g.taken[block]
        if take>=0 && fall>=0 {
            kind:=code.kinds[g.relocation[limit-1]];b.i32_const(&mut out,indices[take]);b.i32_const(&mut out,indices[fall])
            jump_condition(&mut out,kind);b.op(&mut out,27)
        }else{
            var dest:=fall;if take>=0 {dest=take}
            if dest<0 {continue}
            // Adjacent fallthrough needs neither a jump nor a dispatch.
            if i+1<blocks.len && indices[dest]==i+1 {continue}
            b.i32_const(&mut out,indices[dest])
        }
        b.indexed(&mut out,33,8);b.indexed(&mut out,12,blocks.len-i-1)
    }
    b.op(&mut out,11);b.op(&mut out,11)
    for block in blocks {indices[block]= -1}
    ""
}
fn signature(out:&mut []u8,arg:i32,ret:i32) {
    b.op(&mut out,96)
    if arg==0 {b.op(&mut out,0)}else{b.op(&mut out,1);b.op(&mut out,arg)}
    if ret==0 {b.op(&mut out,0)}else{b.op(&mut out,1);b.op(&mut out,ret)}
}
fn header(out:&mut []u8,g:&flow.Graph,m:&Image,a:&abi.Abi,ret:i32) {
    var s:[]u8=[];prints:=m.imports-a.import_sigs.len
    b.uleb(&mut s,m.print_base+prints);signature(&mut s,0,0);signature(&mut s,0,127)
    abi.types(&mut s,&a)
    for tag in 0..g.prints.len {if g.prints[tag]>=0 {signature(&mut s,print_type(tag),0)}}
    b.section(&mut out,1,&s)
    if m.imports>0 {
        s.clear();b.uleb(&mut s,m.imports);abi.imports(&mut s,&a)
        for tag in 0..g.prints.len {if g.prints[tag]>=0 {
            b.name(&mut s,"dunder");b.name(&mut s,print_name(tag));b.op(&mut s,0);b.uleb(&mut s,m.print_base+g.prints[tag]-a.import_sigs.len)
        }}
        b.section(&mut out,2,&s)
    }
    s.clear();b.uleb(&mut s,g.functions.len+a.callback_sigs.len+1)
    for f in g.functions {b.op(&mut s,0)}
    for sig in a.callback_sigs {b.uleb(&mut s,2+sig)}
    var main_ty:=0;if ret!=0 {main_ty=1};b.op(&mut s,main_ty);b.section(&mut out,3,&s)
    s.clear();b.op(&mut s,1);b.op(&mut s,112);b.op(&mut s,0);b.uleb(&mut s,m.table_base+g.addresses.len);b.section(&mut out,4,&s)
    s.clear();b.op(&mut s,1);b.op(&mut s,0);b.uleb(&mut s,(m.heap+256+65535)/65536);b.section(&mut out,5,&s)
    s.clear();b.uleb(&mut s,70)
    for i in 0..70 {
        b.op(&mut s,126);var mutability:=1;if i>=68 {mutability=0};b.op(&mut s,mutability)
        var value:=0;if i==19 {value=m.heap+256}else if i==20 {value=m.heap+536870912}
        else if i==21 || i==31 || i==68 {value=m.heap}else if i==69 {value=m.stack_bottom}
        b.constant(&mut s,i64(value));b.op(&mut s,11)
    };b.section(&mut out,6,&s)
    s.clear();b.op(&mut s,3);b.name(&mut s,"main");b.indexed(&mut s,0,m.imports+g.functions.len+a.callback_sigs.len)
    b.name(&mut s,"memory");b.indexed(&mut s,2,0)
    b.name(&mut s,"__indirect_function_table");b.indexed(&mut s,1,0);b.section(&mut out,7,&s)
    s.clear();b.op(&mut s,1);b.op(&mut s,0);b.i32_const(&mut s,1);b.op(&mut s,11)
    b.uleb(&mut s,a.table.len+g.addresses.len);abi.entries(&mut s,&a,m.imports+g.functions.len)
    for block in g.addresses {b.uleb(&mut s,m.imports+g.function_id[block])}
    b.section(&mut out,9,&s)
}
pub fn image(code:&arm.Code,data_start:i32,entry:i32,ret:i32,a:&abi.Abi)->Result {
    var g:=flow.index(&code,data_start,entry,&a.callback_labels)
    var count:=a.import_sigs.len
    for i in 0..g.prints.len {if g.prints[i]>=0 {g.prints[i]=count;count=count+1}}
    // Preserve the native literal pool's 8-byte alignment modulo the original
    // word address, which includes an optional leading alignment word.
    data_base:=16+data_start%2*4
    data_bytes:=(code.words.len-data_start)*4
    bottom:=(data_base+data_bytes+15)/16*16
    var m:=Image{imports:count,table_base:a.table.len+1,data_start:data_start,data_base:data_base,
                 heap:bottom+1048576,stack_bottom:bottom,print_base:2+a.starts.len}
    var out:[]u8=[0,97,115,109,1,0,0,0];header(&mut out,&g,&m,&a,ret)
    var section:[]u8=[];b.uleb(&mut section,g.functions.len+a.callback_labels.len+1)
    var indices:=flow.filled(g.function_id.len,-1);var instructions:[]u8=[]
    for f in g.functions {
        instructions.clear();error:=body(&mut instructions,&code,&g,&m,&a,f,&mut indices)
        if error!="" {return Result{ok:false,error:error,text:[]}}
        b.blob(&mut section,&instructions)
    }
    var labels:=flow.filled(code.labels.len,-1)
    for label in a.callback_labels {labels[label]=m.imports+g.function_id[g.block_at[code.labels[label]]]}
    abi.callbacks(&mut section,&a,&labels)
    instructions.clear();b.op(&mut instructions,0);b.indexed(&mut instructions,16,m.imports)
    if ret!=0 {b.read(&mut instructions,0);b.op(&mut instructions,167)}
    b.op(&mut instructions,11);b.blob(&mut section,&instructions);b.section(&mut out,10,&section)
    if data_bytes>0 {
        section.clear();b.op(&mut section,1);b.op(&mut section,0);b.i32_const(&mut section,data_base);b.op(&mut section,11)
        b.uleb(&mut section,data_bytes)
        for i in data_start..code.words.len {for j in 0..4 {b.op(&mut section,b.bits(code.words[i],8*j,255))}}
        b.section(&mut out,11,&section)
    }
    Result{ok:true,error:"",text:out}
}
