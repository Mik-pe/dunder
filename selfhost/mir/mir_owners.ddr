import mir
import mir_contract as contract
import mir_memory as memory
import mir_terminals as terminals
import mir_verify as verify

// Forward ownership-state elimination for non-escaping 8-byte frame owner cells.
// Tracks {Unreached = 0, Empty = 1, MaybeLive = 2} across CFG edges to eliminate
// redundant clear sequences (Load + Call .Clear + Store .Vacate) on statically
// Empty cells and dead trailing .Vacate stores in return blocks.

pub opaque struct Workspace {
    verifier: verify.Workspace,
    cand_places: []i32,
    place_to_cand: []i32,
    in_state: []i32,
    out_state: []i32,
    cur_state: []i32,
    read_later: []bool,
    pred_starts: []i32,
    pred_fill: []i32,
    predecessors: []i32,
    reached: []bool,
    queued: []bool,
    queue: []i32,
    block_ops: []i32,
    undo_ops: []i32,
    undo_rows: []i64,
    before_verified: bool,
    status: i32,
    work: i32,
    limit: i32,
    eliminated_clears: i32,
    eliminated_vacates: i32,
}

pub fn new() -> Workspace {
    Workspace {
        verifier: verify.new_work(),
        cand_places: [], place_to_cand: [], in_state: [], out_state: [], cur_state: [],
        read_later: [], pred_starts: [], pred_fill: [], predecessors: [],
        reached: [], queued: [], queue: [], block_ops: [], undo_ops: [], undo_rows: [],
        before_verified: false, status: 0, work: 0, limit: 0,
        eliminated_clears: 0, eliminated_vacates: 0,
    }
}

pub fn status(w: &Workspace) -> i32 { w.status }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn cleared(w: &Workspace) -> i32 { if w.status == 2 { w.eliminated_clears } else { 0 } }
pub fn vacated(w: &Workspace) -> i32 { if w.status == 2 { w.eliminated_vacates } else { 0 } }

fn reset(w: &mut Workspace, limit: i32) {
    w.cand_places.clear(); w.place_to_cand.clear()
    w.in_state.clear(); w.out_state.clear(); w.cur_state.clear(); w.read_later.clear()
    w.pred_starts.clear(); w.pred_fill.clear(); w.predecessors.clear()
    w.reached.clear(); w.queued.clear(); w.queue.clear()
    w.block_ops.clear(); w.undo_ops.clear(); w.undo_rows.clear()
    w.before_verified = false; w.status = 0; w.work = 0; w.limit = limit
    w.eliminated_clears = 0; w.eliminated_vacates = 0
}

fn charge(w: &mut Workspace, units: i32) -> bool {
    if units < 0 || units > w.limit - w.work { w.status = -3; return false }
    w.work = w.work + units
    true
}

fn save_op(w: &mut Workspace, f: &mir.Function, op: i32) {
    w.undo_ops.push(op)
    w.undo_rows.push(i64(f.modes[op])); w.undo_rows.push(i64(f.raw_starts[op]))
    w.undo_rows.push(i64(f.widths[op])); w.undo_rows.push(i64(f.recipes[op]))
    w.undo_rows.push(i64(f.kinds[op])); w.undo_rows.push(i64(f.opcodes[op]))
    w.undo_rows.push(i64(f.dst[op])); w.undo_rows.push(i64(f.a[op]))
    w.undo_rows.push(i64(f.b[op])); w.undo_rows.push(i64(f.c[op]))
    w.undo_rows.push(f.imm[op]); w.undo_rows.push(i64(f.aux[op]))
    w.undo_rows.push(f.variant[op]); w.undo_rows.push(i64(f.types[op]))
    w.undo_rows.push(i64(f.place[op])); w.undo_rows.push(i64(f.extensions[op]))
    w.undo_rows.push(i64(f.effects[op])); w.undo_rows.push(i64(f.flags[op]))
    w.undo_rows.push(i64(f.abi[op])); w.undo_rows.push(f.reads[op])
    w.undo_rows.push(f.writes[op]); w.undo_rows.push(f.clobbers[op])
    w.undo_rows.push(i64(f.targets[op])); w.undo_rows.push(i64(f.reloc_kinds[op]))
    w.undo_rows.push(i64(f.import_ids[op]))
}

fn rollback(w: &Workspace, f: &mut mir.Function) {
    mut i := w.undo_ops.len
    while i > 0 {
        i = i - 1
        op := w.undo_ops[i]
        base := i * 25
        f.modes[op] = i32(w.undo_rows[base])
        f.raw_starts[op] = i32(w.undo_rows[base + 1])
        f.widths[op] = i32(w.undo_rows[base + 2])
        f.recipes[op] = i32(w.undo_rows[base + 3])
        f.kinds[op] = i32(w.undo_rows[base + 4])
        f.opcodes[op] = i32(w.undo_rows[base + 5])
        f.dst[op] = i32(w.undo_rows[base + 6])
        f.a[op] = i32(w.undo_rows[base + 7])
        f.b[op] = i32(w.undo_rows[base + 8])
        f.c[op] = i32(w.undo_rows[base + 9])
        f.imm[op] = w.undo_rows[base + 10]
        f.aux[op] = i32(w.undo_rows[base + 11])
        f.variant[op] = w.undo_rows[base + 12]
        f.types[op] = i32(w.undo_rows[base + 13])
        f.place[op] = i32(w.undo_rows[base + 14])
        f.extensions[op] = i32(w.undo_rows[base + 15])
        f.effects[op] = i32(w.undo_rows[base + 16])
        f.flags[op] = i32(w.undo_rows[base + 17])
        f.abi[op] = i32(w.undo_rows[base + 18])
        f.reads[op] = w.undo_rows[base + 19]
        f.writes[op] = w.undo_rows[base + 20]
        f.clobbers[op] = w.undo_rows[base + 21]
        f.targets[op] = i32(w.undo_rows[base + 22])
        f.reloc_kinds[op] = i32(w.undo_rows[base + 23])
        f.import_ids[op] = i32(w.undo_rows[base + 24])
    }
    f.verified = w.before_verified
}

fn has_clear_or_vacate(f: &mir.Function) -> bool {
    for op in 0..f.kinds.len {
        if f.modes[op] == 2 { continue }
        if (f.kinds[op] == 14 && f.opcodes[op] == 19 && f.reloc_kinds[op] == 1) ||
           (f.kinds[op] == 8 && (f.opcodes[op] == 21 || f.opcodes[op] == 22 || f.opcodes[op] == 23)) {
            return true
        }
    }
    false
}

fn collect_candidates(w: &mut Workspace, f: &mir.Function) -> bool {
    places := f.place_kinds.len
    if !charge(&mut w, places * 2 + f.kinds.len) { return false }
    mut has_vacate := false
    w.place_to_cand.reserve(places)
    for p in 0..places { w.place_to_cand.push(-1) }
    for op in 0..f.kinds.len {
        if f.modes[op] != 2 && f.kinds[op] == 8 && f.opcodes[op] == 22 {
            p := f.place[op]
            if p >= 0 && p < places { w.place_to_cand[p] = -2; has_vacate = true }
        }
    }
    if !has_vacate { return false }
    for p in 0..places {
        if w.place_to_cand[p] != -2 { continue }
        w.place_to_cand[p] = -1
        if w.cand_places.len >= 256 { break }
        if f.place_kinds[p] != 1 || f.place_escaped[p] || f.place_widths[p] != 8 ||
           f.place_offsets[p] > -8 || f.place_offsets[p] % 8 != 0 ||
           !contract.frame_place_proven(&f, p) { continue }
        if !charge(&mut w, places) { return false }
        mut unique := true
        ps := i64(f.place_offsets[p]); pe := ps + 8
        for q in 0..places {
            if q == p || f.place_kinds[q] != 1 { continue }
            qs := i64(f.place_offsets[q]); qe := qs + i64(f.place_widths[q])
            if ps < qe && qs < pe { unique = false; break }
        }
        if unique {
            c := w.cand_places.len
            w.cand_places.push(p)
            w.place_to_cand[p] = c
        }
    }
    w.cand_places.len > 0
}

fn build_cfg(w: &mut Workspace, f: &mir.Function, exits: &terminals.TerminalContext) -> bool {
    blocks := f.block_starts.len; edges := f.edge_to.len
    if blocks == 0 || !charge(&mut w, blocks * 2 + edges * 2) { return false }
    w.pred_starts.reserve(blocks + 1); w.pred_fill.reserve(blocks)
    w.reached.reserve(blocks); w.queued.reserve(blocks); w.queue.reserve(blocks)
    for _ in 0..blocks { w.pred_fill.push(0); w.reached.push(false); w.queued.push(false) }
    w.reached[0] = true; w.queue.push(0); mut next := 0
    while next < w.queue.len {
        b := w.queue[next]; next = next + 1
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to >= 0 {
                if !w.reached[to] { w.reached[to] = true; w.queue.push(to) }
                continue
            }
            if f.edge_kinds[e] == 3 { continue }
            if f.edge_kinds[e] != 2 || exits.version != 1 { return false }
            mut last := -1
            for pos in f.block_starts[b]..f.block_ends[b] {
                op := f.order[pos]; if f.modes[op] != 2 { last = op }
            }
            if last < 0 || (f.kinds[last] != 12 && f.kinds[last] != 13) || !terminals.allows(&exits, f.targets[last]) {
                return false
            }
        }
    }
    for e in 0..edges {
        from := f.edge_from[e]; to := f.edge_to[e]
        if to >= 0 && w.reached[from] { w.pred_fill[to] = w.pred_fill[to] + 1 }
    }
    w.pred_starts.push(0)
    for b in 0..blocks { w.pred_starts.push(w.pred_starts[b] + w.pred_fill[b]); w.pred_fill[b] = w.pred_starts[b] }
    w.predecessors.reserve(w.pred_starts[blocks])
    for _ in 0..w.pred_starts[blocks] { w.predecessors.push(0) }
    for e in 0..edges {
        from := f.edge_from[e]; to := f.edge_to[e]
        if to >= 0 && w.reached[from] {
            w.predecessors[w.pred_fill[to]] = from
            w.pred_fill[to] = w.pred_fill[to] + 1
        }
    }
    true
}

fn step_op(w: &mut Workspace, f: &mir.Function, op: i32) {
    if f.modes[op] == 2 || f.kinds[op] != 8 { return }
    p := f.place[op]
    if p < 0 || p >= w.place_to_cand.len { return }
    c := w.place_to_cand[p]
    if c < 0 { return }
    tag := f.opcodes[op]
    if tag == 21 || tag == 22 || tag == 23 { w.cur_state[c] = 1 } else { w.cur_state[c] = 2 }
}

fn solve_dataflow(w: &mut Workspace, f: &mir.Function) -> bool {
    blocks := f.block_starts.len; k := w.cand_places.len; total := blocks * k
    if !charge(&mut w, total * 4 + f.order.len) { return false }
    w.in_state.reserve(total); w.out_state.reserve(total)
    w.cur_state.reserve(k); w.read_later.reserve(k)
    for _ in 0..total { w.in_state.push(0); w.out_state.push(0) }
    for _ in 0..k { w.cur_state.push(0); w.read_later.push(false) }
    w.queue.clear()
    mut head := 0; mut tail := 0; mut pending := 0
    for i in 0..blocks { w.queued[i] = false }
    for b in 0..blocks {
        if w.reached[b] {
            w.queue.push(b); w.queued[b] = true; pending = pending + 1
        }
    }
    tail = 0
    if w.queue.len > 0 { tail = w.queue.len % blocks }
    // Ensure ring buffer has exact size `blocks`.
    while w.queue.len < blocks { w.queue.push(0) }
    mut visits := 0
    while pending > 0 {
        b := w.queue[head]; head = (head + 1) % blocks; pending = pending - 1; w.queued[b] = false
        visits = visits + 1
        if visits > blocks * 16 + 64 || !charge(&mut w, k + f.block_ends[b] - f.block_starts[b]) { return false }
        if b == 0 {
            for c in 0..k { w.cur_state[c] = 2 }
        } else {
            for c in 0..k { w.cur_state[c] = 0 }
            for p_idx in w.pred_starts[b]..w.pred_starts[b + 1] {
                pred := w.predecessors[p_idx]; base := pred * k
                for c in 0..k {
                    s := w.out_state[base + c]
                    if s > w.cur_state[c] { w.cur_state[c] = s }
                }
            }
        }
        in_base := b * k
        for c in 0..k { w.in_state[in_base + c] = w.cur_state[c] }
        for pos in f.block_starts[b]..f.block_ends[b] { step_op(&mut w, &f, f.order[pos]) }
        mut changed := false
        for c in 0..k {
            if w.out_state[in_base + c] != w.cur_state[c] {
                w.out_state[in_base + c] = w.cur_state[c]
                changed = true
            }
        }
        if changed {
            for e in f.edge_starts[b]..f.edge_starts[b + 1] {
                to := f.edge_to[e]
                if to >= 0 && !w.queued[to] {
                    w.queue[tail] = to; tail = (tail + 1) % blocks; pending = pending + 1; w.queued[to] = true
                }
            }
        }
    }
    true
}

fn empty_load_x0(f: &mir.Function, op: i32, p: i32) -> bool {
    f.modes[op] != 2 && f.kinds[op] == 7 && f.opcodes[op] == 0 && f.dst[op] == 0 && f.a[op] == 29 &&
        f.b[op] == -1 && f.place[op] == p && f.aux[op] == 8 && f.types[op] == 2 &&
        f.extensions[op] == 0 && f.flags[op] == 0
}

fn clear_call(f: &mir.Function, op: i32) -> bool {
    f.modes[op] != 2 && f.kinds[op] == 14 && f.opcodes[op] == 19 && f.reloc_kinds[op] == 1
}

fn vacate_store(f: &mir.Function, op: i32, p: i32) -> bool {
    f.modes[op] != 2 && f.kinds[op] == 8 && f.opcodes[op] == 22 && f.recipes[op] == 2 &&
        f.a[op] == -1 && f.b[op] == 29 && f.place[op] == p && f.aux[op] == 8
}

fn make_zero_x0(f: &mut mir.Function, op: i32) {
    f.modes[op] = 1; f.raw_starts[op] = -1; f.widths[op] = 0; f.recipes[op] = 0
    f.kinds[op] = 1; f.opcodes[op] = 0; f.dst[op] = 0; f.a[op] = -1; f.b[op] = -1; f.c[op] = -1
    f.imm[op] = 0; f.aux[op] = 0; f.variant[op] = 0; f.types[op] = 2; f.place[op] = -1; f.extensions[op] = 0
    f.effects[op] = 0; f.flags[op] = 0; f.abi[op] = 0
    f.reads[op] = 0; f.writes[op] = 1; f.clobbers[op] = 0
    f.targets[op] = -1; f.reloc_kinds[op] = -1; f.import_ids[op] = -1
}

fn is_return_block(f: &mir.Function, b: i32, live_ops: &[]i32) -> i32 {
    if f.edge_starts[b + 1] != f.edge_starts[b] + 1 || f.edge_kinds[f.edge_starts[b]] != 3 { return -1 }
    m := live_ops.len
    if m < 3 { return -1 }
    fr := live_ops[m - 3]; abi_op := live_ops[m - 2]; ret := live_ops[m - 1]
    if f.kinds[ret] == 15 && f.kinds[abi_op] == 21 && f.opcodes[abi_op] == 2 &&
       f.kinds[fr] == 16 && f.opcodes[fr] == 1 && f.dst[fr] == 31 && f.a[fr] == 29 && f.imm[fr] == 0 {
        return m - 3
    }
    -1
}

fn rewrite_blocks(w: &mut Workspace, f: &mut mir.Function) -> bool {
    k := w.cand_places.len
    mut changed := false
    for b in 0..f.block_starts.len {
        if !w.reached[b] { continue }
        base := b * k
        for c in 0..k { w.cur_state[c] = w.in_state[base + c] }
        w.block_ops.clear()
        for pos in f.block_starts[b]..f.block_ends[b] {
            op := f.order[pos]
            if f.modes[op] != 2 { w.block_ops.push(op) }
        }
        mut idx := 0
        while idx < w.block_ops.len {
            op0 := w.block_ops[idx]
            if idx + 2 < w.block_ops.len && f.kinds[op0] == 7 {
                p := f.place[op0]
                if p >= 0 && p < w.place_to_cand.len {
                    cand := w.place_to_cand[p]
                    if cand >= 0 && w.cur_state[cand] == 1 && empty_load_x0(&f, op0, p) {
                        op1 := w.block_ops[idx + 1]; op2 := w.block_ops[idx + 2]
                        if clear_call(&f, op1) && vacate_store(&f, op2, p) {
                            save_op(&mut w, &f, op0); save_op(&mut w, &f, op1); save_op(&mut w, &f, op2)
                            make_zero_x0(&mut f, op0)
                            f.modes[op1] = 2; f.modes[op2] = 2
                            w.cur_state[cand] = 1
                            w.eliminated_clears = w.eliminated_clears + 1
                            changed = true
                            idx = idx + 3
                            continue
                        }
                    }
                }
            }
            step_op(&mut w, &f, op0)
            idx = idx + 1
        }
        epilogue_pos := is_return_block(&f, b, &w.block_ops)
        if epilogue_pos > 0 {
            for c in 0..k { w.read_later[c] = false }
            mut r := epilogue_pos - 1
            while r >= 0 {
                op := w.block_ops[r]; kind := f.kinds[op]
                if f.modes[op] == 2 { r = r - 1; continue }
                if kind == 7 {
                    p := f.place[op]
                    if p >= 0 && p < w.place_to_cand.len && w.place_to_cand[p] >= 0 {
                        w.read_later[w.place_to_cand[p]] = true
                    }
                    r = r - 1; continue
                }
                if kind == 8 {
                    p := f.place[op]
                    if p >= 0 && p < w.place_to_cand.len && w.place_to_cand[p] >= 0 {
                        cand := w.place_to_cand[p]
                        if f.opcodes[op] == 22 && !w.read_later[cand] {
                            save_op(&mut w, &f, op)
                            f.modes[op] = 2
                            w.eliminated_vacates = w.eliminated_vacates + 1
                            changed = true
                        }
                        r = r - 1; continue
                    }
                    break
                }
                if kind == 1 || kind == 2 || kind == 10 || kind == 11 ||
                   (kind == 14 && f.opcodes[op] == 19 && f.reloc_kinds[op] == 1) {
                    r = r - 1; continue
                }
                break
            }
        }
    }
    changed
}

pub fn optimize_budget(w: &mut Workspace, f: &mut mir.Function,
    exits: &terminals.TerminalContext, source_objects: bool, limit: i32) -> bool {
    reset(&mut w, limit)
    w.before_verified = f.verified
    if !source_objects || !terminals.valid(&exits) || !f.valid || !f.verified || !f.optimizable || f.unknown_control {
        w.status = -2; return false
    }
    if f.block_starts.len == 0 || f.place_kinds.len == 0 || f.kinds.len > 65536 || f.block_starts.len > 16384 {
        w.status = 0; return false
    }
    if !has_clear_or_vacate(&f) { w.status = 0; return false }
    if !memory.source_frame_eligible(&f) { w.status = -2; return false }
    if !collect_candidates(&mut w, &f) { return false }
    if !build_cfg(&mut w, &f, &exits) { return false }
    if !solve_dataflow(&mut w, &f) { return false }
    if !rewrite_blocks(&mut w, &mut f) { w.status = 0; return false }
    f.verified = false
    if !verify.verify_into(&mut f, &mut w.verifier) {
        rollback(&w, &mut f)
        w.status = -1
        return false
    }
    w.status = 2
    true
}
