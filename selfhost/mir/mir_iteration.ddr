import mir
import ..frontend.source_types
import ..frontend.iteration
import ..backend.backend_row as row

fn reads(step: i32) -> i64 {
    if step == i32(iteration.Step.RangeLimit) { return 2 }
    if step == i32(iteration.Step.Test) || step == i32(iteration.Step.PackRange) || step == i32(iteration.Step.RuneLead) { return 3 }
    if step == i32(iteration.Step.RuneTail) { return 3075 }
    1
}
fn writes(step: i32) -> i64 {
    if step == i32(iteration.Step.Test) { return 0 }
    if step == i32(iteration.Step.PackRange) { return 3 }
    if step == i32(iteration.Step.RuneLead) { return 1027 }
    if step == i32(iteration.Step.RuneTail) { return 7171 }
    if step >= i32(iteration.Step.RuneTwo) { return 2049 }
    1
}
fn effects(step: i32) -> i32 {
    if step == i32(iteration.Step.RuneLead) || step == i32(iteration.Step.RuneTail) { return 3 }
    0
}
fn flags(step: i32) -> i32 { if step == i32(iteration.Step.Test) { return 2 }; 0 }
pub fn set(f: &mut mir.Function, op: i32, h: i64, source: i64) {
    step := row.reg(h); f.opcodes[op] = step; f.aux[op] = i32(row.operand(h).shr(32))
    f.types[op] = i32(h.bit_and(2147483647)); f.imm[op] = row.operand(source)
    f.effects[op] = effects(step); f.flags[op] = flags(step); f.reads[op] = reads(step); f.writes[op] = writes(step)
}
pub fn valid(f: &mir.Function, op: i32) -> bool {
    step := f.opcodes[op]
    source_types.contains(&f.source_types, f.types[op]) && iteration.valid(step, f.aux[op], f.types[op]) && f.imm[op] >= 0 && f.imm[op] <= 2147483647 &&
        f.raw_starts[op] == -1 && f.widths[op] == 0 && f.dst[op] == -1 && f.a[op] == -1 && f.b[op] == -1 && f.c[op] == -1 &&
        f.effects[op] == effects(step) && f.flags[op] == flags(step) && f.reads[op] == reads(step) && f.writes[op] == writes(step) &&
        f.clobbers[op] == 0 && f.variant[op] == 0 && f.place[op] == -1 && f.abi[op] == 0 && f.recipes[op] == 0 &&
        f.stack_roles[op] == 0 && f.extensions[op] == 0 && f.reloc_kinds[op] == -1 && f.targets[op] == -1 && f.import_ids[op] == -1
}

pub fn lower_scalar_steps(f: &mut mir.Function) -> bool {
    if !f.valid || !f.optimizable || f.unknown_control { return false }
    mut changed := false
    for op in 0..f.kinds.len {
        if f.modes[op] == 2 || f.kinds[op] != 25 { continue }
        step := f.opcodes[op]
        is_test := step == i32(iteration.Step.Test)
        is_advance := step == i32(iteration.Step.Advance)
        is_range_start := step == i32(iteration.Step.RangeStart)
        is_range_limit := step == i32(iteration.Step.RangeLimit)
        if !is_test && !is_advance && !is_range_start && !is_range_limit { continue }
        f.modes[op] = 1; f.raw_starts[op] = -1; f.widths[op] = 0
        f.imm[op] = 0; f.aux[op] = 0; f.variant[op] = 0; f.types[op] = 2
        f.place[op] = -1; f.extensions[op] = 0; f.effects[op] = 0; f.abi[op] = 0
        f.clobbers[op] = 0; f.stack_roles[op] = 0; f.recipes[op] = 0
        f.targets[op] = -1; f.reloc_kinds[op] = -1; f.import_ids[op] = -1
        f.b[op] = -1; f.c[op] = -1
        if is_test {
            f.kinds[op] = 5; f.opcodes[op] = 2; f.dst[op] = -1; f.a[op] = 1; f.b[op] = 0
            f.flags[op] = 2; f.reads[op] = 3; f.writes[op] = 0
        } else if is_advance {
            f.kinds[op] = 4; f.opcodes[op] = 1; f.dst[op] = 0; f.a[op] = 0
            f.imm[op] = 1; f.flags[op] = 0; f.reads[op] = 1; f.writes[op] = 1
        } else if is_range_start {
            f.kinds[op] = 3; f.opcodes[op] = 1; f.dst[op] = 0; f.a[op] = 0
            f.aux[op] = 1984; f.flags[op] = 0; f.reads[op] = 1; f.writes[op] = 1
        } else {
            f.kinds[op] = 3; f.opcodes[op] = 1; f.dst[op] = 0; f.a[op] = 1
            f.aux[op] = 4064; f.flags[op] = 0; f.reads[op] = 2; f.writes[op] = 1
        }
        changed = true
    }
    if changed { f.verified = false }
    changed
}
