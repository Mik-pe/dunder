import mir
import mir_operation as decode

fn equal(d: &decode.Decoded, f: &mir.Function, op: i32) -> bool {
    if f.kinds[op] != d.kind || f.opcodes[op] != d.opcode ||
        f.dst[op] != d.dst || f.a[op] != d.a || f.b[op] != d.b || f.c[op] != d.c ||
        f.imm[op] != d.imm || f.aux[op] != d.aux || f.variant[op] != d.variant ||
        f.types[op] != d.types || f.extensions[op] != d.extension || f.stack_roles[op] != d.stack_role ||
        f.effects[op] != d.effects || f.flags[op] != d.flags || f.abi[op] != d.abi ||
        f.reads[op] != d.reads || f.writes[op] != d.writes || f.clobbers[op] != d.clobbers { return false }
    p := f.place[op]
    if d.place_kind < 0 { return p == -1 }
    if p < 0 || p >= f.place_kinds.len { return false }
    f.place_kinds[p] == d.place_kind && f.place_offsets[p] == d.place_offset && f.place_widths[p] == d.place_width
}
pub fn validate(d: &mut decode.Decoded, f: &mir.Function, op: i32) -> bool {
    if op < 0 || op >= f.kinds.len || f.recipes.len != f.kinds.len || f.stack_roles.len != f.kinds.len { return false }
    if f.modes[op] != 0 { return true }
    first := f.raw_starts[op]; width := f.widths[op]
    if first < 0 || width < 1 || width > 2 || first > f.raw.len - width || first >= f.encoded.len / 27 { return false }
    recipe := f.recipes[op]
    if recipe == 0 {
        if width != 1 || f.reloc_kinds[op] != -1 || f.targets[op] != -1 || f.import_ids[op] != -1 { return false }
    } else if recipe == 4 {
        if f.import_ids[op] != -1 || f.targets[op] < 0 || f.targets[op] >= f.source_labels { return false }
    } else if recipe == 5 {
        if width != 2 || f.targets[op] != -1 || f.reloc_kinds[op] != -1 || f.import_ids[op] < f.first_import || f.import_ids[op] >= f.source_imports { return false }
    } else { return false }
    at := first * 27
    if f.raw[first] != f.encoded[at] || (width == 2 && f.raw[first + 1] != f.encoded[at + 1]) ||
        i64(width) != f.encoded[at + 2] || i64(f.recipes[op]) != f.encoded[at + 3] ||
        i64(f.reloc_kinds[op]) != f.encoded[at + 4] || i64(f.platform) != f.encoded[at + 5] { return false }
    d.kind = i32(f.encoded[at + 6]); d.opcode = i32(f.encoded[at + 7]); d.dst = i32(f.encoded[at + 8])
    d.a = i32(f.encoded[at + 9]); d.b = i32(f.encoded[at + 10]); d.c = i32(f.encoded[at + 11])
    d.imm = f.encoded[at + 12]; d.aux = i32(f.encoded[at + 13]); d.variant = f.encoded[at + 14]
    d.types = i32(f.encoded[at + 15]); d.extension = i32(f.encoded[at + 16]); d.stack_role = i32(f.encoded[at + 17])
    d.effects = i32(f.encoded[at + 18]); d.flags = i32(f.encoded[at + 19]); d.abi = i32(f.encoded[at + 20])
    d.reads = f.encoded[at + 21]; d.writes = f.encoded[at + 22]; d.clobbers = f.encoded[at + 23]
    d.place_kind = i32(f.encoded[at + 24]); d.place_offset = i32(f.encoded[at + 25]); d.place_width = i32(f.encoded[at + 26])
    d.unknown_control = d.kind == 0
    equal(&d, &f, op)
}
