// Bounded post-value MIR branch and control-flow cleanup with exact undo.
// Threads jumps/conditional branches over empty/trampoline blocks, eliminates
// fallthrough jumps, and fuses dead-flag/dead-x0 CSET/CMP compare-branch chains.
import ..backend.backend_row as row
import mir
import mir_liveness as live
import mir_terminals as terms
import mir_verify as verify

pub opaque struct Workspace {
    live: live.Workspace,
    verifier: verify.Workspace,
    block_label: []i32,
    block_first: []i32,
    block_last: []i32,
    block_single: []bool,
    block_empty: []bool,
    pred_count: []i32,
    addr_taken: []bool,
    seen: []i32,
    undo_op_ids: []i32,
    undo_op_rows: []i64,
    undo_edge_ids: []i32,
    undo_edge_to: []i32,
    undo_edge_kinds: []i32,
    before_verified: bool,
}

pub fn new() -> Workspace {
    Workspace {
        live: live.new(), verifier: verify.new_work(),
        block_label: [], block_first: [], block_last: [], block_single: [], block_empty: [],
        pred_count: [], addr_taken: [], seen: [],
        undo_op_ids: [], undo_op_rows: [], undo_edge_ids: [], undo_edge_to: [], undo_edge_kinds: [],
        before_verified: false,
    }
}

fn reset(w: &mut Workspace) {
    w.block_label.clear(); w.block_first.clear(); w.block_last.clear()
    w.block_single.clear(); w.block_empty.clear(); w.pred_count.clear(); w.addr_taken.clear()
    w.seen.clear(); w.undo_op_ids.clear(); w.undo_op_rows.clear()
    w.undo_edge_ids.clear(); w.undo_edge_to.clear(); w.undo_edge_kinds.clear()
}

fn save_op(w: &mut Workspace, f: &mir.Function, op: i32) {
    w.undo_op_ids.push(op)
    w.undo_op_rows.push(i64(f.modes[op])); w.undo_op_rows.push(i64(f.raw_starts[op])); w.undo_op_rows.push(i64(f.widths[op]))
    w.undo_op_rows.push(i64(f.kinds[op])); w.undo_op_rows.push(i64(f.opcodes[op])); w.undo_op_rows.push(i64(f.dst[op]))
    w.undo_op_rows.push(i64(f.a[op])); w.undo_op_rows.push(i64(f.b[op])); w.undo_op_rows.push(i64(f.c[op]))
    w.undo_op_rows.push(f.imm[op]); w.undo_op_rows.push(i64(f.aux[op])); w.undo_op_rows.push(f.variant[op])
    w.undo_op_rows.push(i64(f.types[op])); w.undo_op_rows.push(i64(f.place[op])); w.undo_op_rows.push(i64(f.extensions[op]))
    w.undo_op_rows.push(i64(f.stack_roles[op])); w.undo_op_rows.push(i64(f.recipes[op]))
    w.undo_op_rows.push(i64(f.effects[op])); w.undo_op_rows.push(i64(f.flags[op])); w.undo_op_rows.push(i64(f.abi[op]))
    w.undo_op_rows.push(f.reads[op]); w.undo_op_rows.push(f.writes[op]); w.undo_op_rows.push(f.clobbers[op])
    w.undo_op_rows.push(i64(f.reloc_kinds[op])); w.undo_op_rows.push(i64(f.targets[op])); w.undo_op_rows.push(i64(f.import_ids[op]))
}

fn save_edge(w: &mut Workspace, f: &mir.Function, edge: i32) {
    w.undo_edge_ids.push(edge)
    w.undo_edge_to.push(f.edge_to[edge])
    w.undo_edge_kinds.push(f.edge_kinds[edge])
}

fn rollback(w: &Workspace, f: &mut mir.Function) {
    mut i := w.undo_edge_ids.len
    while i > 0 {
        i = i - 1
        edge := w.undo_edge_ids[i]
        f.edge_to[edge] = w.undo_edge_to[i]
        f.edge_kinds[edge] = w.undo_edge_kinds[i]
    }
    mut j := w.undo_op_ids.len
    while j > 0 {
        j = j - 1
        op := w.undo_op_ids[j]
        base := j * 26
        f.modes[op] = i32(w.undo_op_rows[base])
        f.raw_starts[op] = i32(w.undo_op_rows[base + 1])
        f.widths[op] = i32(w.undo_op_rows[base + 2])
        f.kinds[op] = i32(w.undo_op_rows[base + 3])
        f.opcodes[op] = i32(w.undo_op_rows[base + 4])
        f.dst[op] = i32(w.undo_op_rows[base + 5])
        f.a[op] = i32(w.undo_op_rows[base + 6])
        f.b[op] = i32(w.undo_op_rows[base + 7])
        f.c[op] = i32(w.undo_op_rows[base + 8])
        f.imm[op] = w.undo_op_rows[base + 9]
        f.aux[op] = i32(w.undo_op_rows[base + 10])
        f.variant[op] = w.undo_op_rows[base + 11]
        f.types[op] = i32(w.undo_op_rows[base + 12])
        f.place[op] = i32(w.undo_op_rows[base + 13])
        f.extensions[op] = i32(w.undo_op_rows[base + 14])
        f.stack_roles[op] = i32(w.undo_op_rows[base + 15])
        f.recipes[op] = i32(w.undo_op_rows[base + 16])
        f.effects[op] = i32(w.undo_op_rows[base + 17])
        f.flags[op] = i32(w.undo_op_rows[base + 18])
        f.abi[op] = i32(w.undo_op_rows[base + 19])
        f.reads[op] = w.undo_op_rows[base + 20]
        f.writes[op] = w.undo_op_rows[base + 21]
        f.clobbers[op] = w.undo_op_rows[base + 22]
        f.reloc_kinds[op] = i32(w.undo_op_rows[base + 23])
        f.targets[op] = i32(w.undo_op_rows[base + 24])
        f.import_ids[op] = i32(w.undo_op_rows[base + 25])
    }
    f.verified = w.before_verified
}

fn label_pos(f: &mir.Function, label: i32) -> i32 {
    mut low := 0; mut high := f.label_ids.len
    while low < high {
        middle := low + (high - low) / 2
        if f.label_ids[middle] < label { low = middle + 1 } else { high = middle }
    }
    if low < f.label_ids.len && f.label_ids[low] == label { return f.label_ops[low] }
    -1
}

fn label_block(f: &mir.Function, label: i32) -> i32 {
    pos := label_pos(&f, label)
    if pos >= 0 && pos < f.order.len { return f.op_blocks[f.order[pos]] }
    -1
}

fn rebuild_metadata(w: &mut Workspace, f: &mir.Function) {
    blocks := f.block_starts.len
    w.block_label.clear(); w.block_first.clear(); w.block_last.clear()
    w.block_single.clear(); w.block_empty.clear(); w.pred_count.clear(); w.addr_taken.clear()
    w.block_label.reserve(blocks); w.block_first.reserve(blocks); w.block_last.reserve(blocks)
    w.block_single.reserve(blocks); w.block_empty.reserve(blocks); w.pred_count.reserve(blocks); w.addr_taken.reserve(blocks)
    for b in 0..blocks {
        mut first := -1; mut last := -1; mut count := 0
        for pos in f.block_starts[b]..f.block_ends[b] {
            op := f.order[pos]
            if f.modes[op] == 2 { continue }
            if first < 0 { first = op }
            last = op; count = count + 1
        }
        w.block_label.push(-1); w.block_first.push(first); w.block_last.push(last)
        w.block_single.push(count == 1); w.block_empty.push(count == 0)
        w.pred_count.push(0); w.addr_taken.push(false)
    }
    for i in 0..f.label_ids.len {
        id := f.label_ids[i]; pos := f.label_ops[i]
        if id >= f.first_label && id < f.source_labels && pos >= 0 && pos < f.order.len {
            blk := f.op_blocks[f.order[pos]]
            if blk >= 0 && blk < blocks && f.block_starts[blk] == pos && w.block_label[blk] < 0 {
                w.block_label[blk] = id
            }
        }
    }
    for e in 0..f.edge_to.len {
        to := f.edge_to[e]
        if to >= 0 && to < blocks { w.pred_count[to] = w.pred_count[to] + 1 }
    }
    for op in 0..f.kinds.len {
        if f.modes[op] != 2 && f.reloc_kinds[op] == 20 {
            blk := label_block(&f, f.targets[op])
            if blk >= 0 && blk < blocks { w.addr_taken[blk] = true }
        }
    }
}

fn next_nonempty(w: &Workspace, f: &mir.Function, start: i32) -> i32 {
    blocks := f.block_starts.len
    mut cur := start
    mut steps := 0
    while cur >= 0 && cur < blocks && w.block_empty[cur] && steps < 64 {
        e0 := f.edge_starts[cur]
        if e0 >= f.edge_starts[cur + 1] || f.edge_to[e0] != cur + 1 || f.edge_kinds[e0] != 0 { return -1 }
        cur = cur + 1; steps = steps + 1
    }
    if cur < blocks && !w.block_empty[cur] { return cur }
    -1
}

fn seen_contains(w: &Workspace, label: i32) -> bool {
    for i in 0..w.seen.len { if w.seen[i] == label { return true } }
    false
}

fn thread_target(w: &mut Workspace, f: &mir.Function, start_label: i32, reloc_kind: i32) -> i32 {
    w.seen.clear()
    mut cur := start_label
    while w.seen.len < 16 {
        w.seen.push(cur)
        tb := label_block(&f, cur)
        if tb < 0 { break }
        mut next_label := -1
        if w.block_empty[tb] {
            nb := next_nonempty(&w, &f, tb)
            if nb >= 0 { next_label = w.block_label[nb] }
        } else if w.block_single[tb] {
            j := w.block_first[tb]
            if f.kinds[j] == 12 && f.reloc_kinds[j] == 0 {
                next_label = f.targets[j]
            } else if (reloc_kind == 18 || reloc_kind == 19) &&
                f.kinds[j] == 13 && (f.reloc_kinds[j] == 18 || f.reloc_kinds[j] == 19) {
                if f.reloc_kinds[j] == reloc_kind {
                    next_label = f.targets[j]
                } else {
                    nb := next_nonempty(&w, &f, tb + 1)
                    if nb >= 0 { next_label = w.block_label[nb] }
                }
            }
        }
        if next_label < 0 || next_label >= f.source_labels || next_label == cur || seen_contains(&w, next_label) { break }
        cur = next_label
    }
    cur
}

fn set_taken_edge(w: &mut Workspace, f: &mut mir.Function, block: i32, target: i32) {
    edge := f.edge_starts[block]
    tb := label_block(&f, target)
    mut dest := -1; mut ek := 2
    if tb >= 0 { dest = tb; ek = 1 }
    if f.edge_to[edge] != dest || f.edge_kinds[edge] != ek {
        save_edge(&mut w, &f, edge)
        f.edge_to[edge] = dest; f.edge_kinds[edge] = ek
    }
}

fn thread_and_fold_jumps(w: &mut Workspace, f: &mut mir.Function) -> bool {
    mut any := false
    mut pass := 0
    while pass < 8 {
        rebuild_metadata(&mut w, &f)
        mut changed := false
        blocks := f.block_starts.len
        for b in 0..blocks {
            br := w.block_last[b]
            if br < 0 || f.modes[br] == 2 { continue }
            kind := f.kinds[br]
            if kind != 12 && kind != 13 { continue }
            old_target := f.targets[br]
            new_target := thread_target(&mut w, &f, old_target, f.reloc_kinds[br])
            if new_target != old_target {
                save_op(&mut w, &f, br)
                f.targets[br] = new_target
                set_taken_edge(&mut w, &mut f, b, new_target)
                changed = true; any = true
            }
            if kind == 12 {
                // Eliminate jump targeting immediate next non-empty block over empty blocks.
                tb := label_block(&f, f.targets[br])
                if tb > b && b + 1 < blocks && next_nonempty(&w, &f, b + 1) == tb {
                    save_op(&mut w, &f, br)
                    f.modes[br] = 2
                    edge := f.edge_starts[b]
                    save_edge(&mut w, &f, edge)
                    f.edge_to[edge] = b + 1; f.edge_kinds[edge] = 0
                    changed = true; any = true
                }
            } else if b + 1 < blocks && w.pred_count[b + 1] == 1 && !w.addr_taken[b + 1] && w.block_single[b + 1] {
                e_br_fall := f.edge_starts[b] + 1
                if e_br_fall < f.edge_starts[b + 1] && f.edge_to[e_br_fall] == b + 1 && f.edge_kinds[e_br_fall] == 0 {
                    j := w.block_first[b + 1]
                    if f.modes[j] != 2 && f.kinds[j] == 12 && f.reloc_kinds[j] == 0 {
                        tb_skip := label_block(&f, f.targets[br])
                        reloc := f.reloc_kinds[br]
                        invertible := (reloc >= 2 && reloc <= 15) || reloc == 18 || reloc == 19
                        if invertible && tb_skip > b + 1 && b + 2 < blocks && next_nonempty(&w, &f, b + 2) == tb_skip {
                            mut inv := reloc.bit_xor(1)
                            if reloc == 18 { inv = 19 } else if reloc == 19 { inv = 18 }
                            dest_label := f.targets[j]
                            save_op(&mut w, &f, br)
                            save_op(&mut w, &f, j)
                            f.modes[j] = 2
                            edge_j := f.edge_starts[b + 1]
                            save_edge(&mut w, &f, edge_j)
                            f.edge_to[edge_j] = b + 2; f.edge_kinds[edge_j] = 0
                            set_cond_branch(&mut f, br, inv, dest_label)
                            set_taken_edge(&mut w, &mut f, b, dest_label)
                            changed = true; any = true
                        }
                    }
                }
            }
        }
        if !changed { break }
        pass = pass + 1
    }
    any
}

fn find_preceding_live(w: &Workspace, f: &mir.Function, b: i32, op: i32, cross_block: bool) -> i32 {
    mut prev := -1
    for pos in f.block_starts[b]..f.block_ends[b] {
        cur := f.order[pos]
        if cur == op { break }
        if f.modes[cur] != 2 { prev = cur }
    }
    if prev >= 0 || !cross_block || b <= 0 { return prev }
    if w.pred_count[b] == 1 && !w.addr_taken[b] {
        e_in := f.edge_starts[b - 1]
        if e_in < f.edge_starts[b] && f.edge_to[e_in] == b && f.edge_kinds[e_in] == 0 {
            mut tail := -1
            for pos in f.block_starts[b - 1]..f.block_ends[b - 1] {
                cur := f.order[pos]
                if f.modes[cur] != 2 { tail = cur }
            }
            return tail
        }
    }
    -1
}

fn block_edges_safe(f: &mir.Function, b: i32, branch_op: i32, terminals: &terms.TerminalContext) -> bool {
    e_start := f.edge_starts[b]; e_end := f.edge_starts[b + 1]
    for e in e_start..e_end {
        if f.edge_to[e] < 0 {
            if e != e_start || !terms.allows(&terminals, f.targets[branch_op]) { return false }
        }
    }
    true
}

fn set_cond_branch(f: &mut mir.Function, br: i32, reloc: i32, target: i32) {
    f.modes[br] = 1; f.raw_starts[br] = -1; f.widths[br] = 0
    f.kinds[br] = 13; f.dst[br] = -1; f.b[br] = -1; f.c[br] = -1
    f.aux[br] = 0; f.types[br] = 0; f.place[br] = -1; f.extensions[br] = 0
    f.stack_roles[br] = 0; f.recipes[br] = 0; f.effects[br] = 16; f.abi[br] = 0
    f.writes[br] = 0; f.clobbers[br] = 0; f.reloc_kinds[br] = reloc
    f.targets[br] = target; f.import_ids[br] = -1
    f.variant[br] = row.control(.Symbolic, reloc, 0)
    if reloc == 18 || reloc == 19 {
        f.opcodes[br] = reloc - 16; f.a[br] = 0; f.imm[br] = 0; f.flags[br] = 0; f.reads[br] = 1
    } else {
        f.opcodes[br] = 1; f.a[br] = -1; f.imm[br] = i64(reloc - 2); f.flags[br] = 1; f.reads[br] = 0
    }
}

fn is_cmp_zero_x0(f: &mir.Function, op: i32) -> bool {
    op >= 0 && f.kinds[op] == 5 && (f.opcodes[op] == 2 || f.opcodes[op] == 1) &&
        f.types[op] == 2 && f.dst[op] == -1 && f.flags[op] == 2 && f.imm[op] == 0 && f.aux[op] == 0 &&
        ((f.a[op] == 0 && f.b[op] == -1) || (f.a[op] == -1 && f.b[op] == 0))
}

fn fuse_branches(w: &mut Workspace, f: &mut mir.Function, terminals: &terms.TerminalContext) -> bool {
    if !live.analyze_into(&mut w.live, &f, 4194304) || live.status(&w.live) != 1 { return false }
    rebuild_metadata(&mut w, &f)
    mut changed := false
    blocks := f.block_starts.len
    for b in 0..blocks {
        if !live.reachable(&w.live, b) { continue }
        br := w.block_last[b]
        if br < 0 || f.kinds[br] != 13 { continue }
        if !block_edges_safe(&f, b, br, &terminals) { continue }
        reloc := f.reloc_kinds[br]
        if (reloc == 18 || reloc == 19) && f.a[br] == 0 && live.live_after(&w.live, br).bit_and(1) == 0 {
            prev := find_preceding_live(&w, &f, b, br, true)
            if prev >= 0 && f.kinds[prev] == 6 && f.opcodes[prev] == 0 && f.dst[prev] == 0 &&
                f.flags[prev] == 1 && f.imm[prev] >= 0 && f.imm[prev] <= 13 {
                cc := i32(f.imm[prev])
                mut branch_cc := cc
                if reloc == 18 { branch_cc = cc.bit_xor(1) }
                save_op(&mut w, &f, prev); save_op(&mut w, &f, br)
                f.modes[prev] = 2
                set_cond_branch(&mut f, br, branch_cc + 2, f.targets[br])
                changed = true
            }
        }
        cur_reloc := f.reloc_kinds[br]
        if f.kinds[br] == 13 && f.opcodes[br] == 1 && (cur_reloc == 2 || cur_reloc == 3) &&
            !live.flags_after(&w.live, br) {
            prev := find_preceding_live(&w, &f, b, br, true)
            if is_cmp_zero_x0(&f, prev) {
                save_op(&mut w, &f, prev); save_op(&mut w, &f, br)
                f.modes[prev] = 2
                mut cbz_reloc := 18; if cur_reloc == 3 { cbz_reloc = 19 }
                set_cond_branch(&mut f, br, cbz_reloc, f.targets[br])
                changed = true
            }
        }
    }
    changed
}

pub fn optimize_with_terminals_into(w: &mut Workspace, f: &mut mir.Function, terminals: &terms.TerminalContext) -> bool {
    if !f.valid || !f.verified || !f.optimizable || f.unknown_control || f.block_starts.len == 0 ||
        !terms.valid(&terminals) { return false }
    mut any_control := false
    for op in 0..f.kinds.len {
        if f.modes[op] != 2 && (f.kinds[op] == 12 || f.kinds[op] == 13) { any_control = true; break }
    }
    if !any_control { return false }
    reset(&mut w)
    w.before_verified = f.verified
    mut round := 0
    while round < 4 {
        t := thread_and_fold_jumps(&mut w, &mut f)
        u := fuse_branches(&mut w, &mut f, &terminals)
        if !t && !u { break }
        round = round + 1
    }
    if w.undo_op_ids.len == 0 && w.undo_edge_ids.len == 0 { return false }
    if !verify.verify_into(&mut f, &mut w.verifier) {
        rollback(&w, &mut f)
        return false
    }
    true
}

pub fn optimize_into(w: &mut Workspace, f: &mut mir.Function) -> bool {
    none := terms.no_terminals()
    optimize_with_terminals_into(&mut w, &mut f, &none)
}
