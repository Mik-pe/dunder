import mir
import mir_verify as verify
import mir_opt as frame
import mir_ssa as ssa
import mir_memory as memory
import mir_terminals as terms
import mir_call_abi as call_abi
import mir_call_inputs as call_inputs
import mir_expr_stack as expression_stack
import mir_value_prop as values
import mir_branch as branches
import mir_iteration as iteration

pub opaque struct Workspace {
    verifier: verify.Workspace, optimizer: frame.Workspace, expr_work: expression_stack.Workspace, ssa: ssa.Workspace, values: values.Workspace, branches: branches.Workspace,
}
pub fn new() -> Workspace {
    Workspace { verifier: verify.new_work(), optimizer: frame.new(), expr_work: expression_stack.new(), ssa: ssa.new(), values: values.new(), branches: branches.new() }
}
pub struct Options {
    optimize: bool, source_objects: bool, source_abi: bool, source_inputs: bool, source_temporaries: bool, ssa: bool, values: bool, frame_budget: i32, ssa_budget: i32, value_budget: i32,
}
pub fn options() -> Options {
    Options { optimize: true, source_objects: false, source_abi: false, source_inputs: false, source_temporaries: false, ssa: false, values: true, frame_budget: 4194304, ssa_budget: 4194304, value_budget: 4194304 }
}
pub struct Terminals {
    version: i32, overflow: i32, zero: i32, assertion: i32, io: i32, bounds: i32, float_trap: i32,
}
pub fn no_terminals() -> Terminals {
    Terminals { version: 0, overflow: -1, zero: -1, assertion: -1, io: -1, bounds: -1, float_trap: -1 }
}
pub struct Stats {
    operations: i32, opaque: i32,
    optimized: i32, promoted: i32, removed_loads: i32, removed_stores: i32, private_memory_ops: i32,
    analysis_units: i64, budget_refusals: i32,
    ssa_optimized: i32, ssa_cells: i32, ssa_values: i32, ssa_parameters: i32, ssa_registers: i32, ssa_captures: i32, ssa_stack_groups: i32, ssa_removed_loads: i32, ssa_removed_stores: i32, ssa_removed_pushes: i32, ssa_removed_pops: i32, ssa_copies: i32, ssa_analysis_units: i64, ssa_budget_refusals: i32,
    values_optimized: i32, value_rewrites: i32, value_deleted: i32, value_immediates: i32,
    value_analysis_units: i64, value_budget_refusals: i32,
}
pub fn stats() -> Stats {
    Stats { operations: 0, opaque: 0, optimized: 0, promoted: 0, removed_loads: 0, removed_stores: 0, private_memory_ops: 0,
        analysis_units: 0, budget_refusals: 0, ssa_optimized: 0, ssa_cells: 0, ssa_values: 0, ssa_parameters: 0, ssa_registers: 0, ssa_captures: 0, ssa_stack_groups: 0, ssa_removed_loads: 0, ssa_removed_stores: 0, ssa_removed_pushes: 0, ssa_removed_pops: 0, ssa_copies: 0, ssa_analysis_units: 0, ssa_budget_refusals: 0, values_optimized: 0, value_rewrites: 0,
        value_deleted: 0, value_immediates: 0, value_analysis_units: 0, value_budget_refusals: 0 }
}
pub struct Status { error: i32, frame_state: i32, value_state: i32, stats: Stats }
fn status() -> Status { Status { error: 0, frame_state: 0, value_state: 0, stats: stats() } }
fn complete(f: &mir.Function, result: &mut Status) {
    if result.error != 0 { return }
    result.stats.operations = f.order.len
    result.stats.opaque = 0
    for op in 0..f.kinds.len { if f.kinds[op] == 0 { result.stats.opaque = result.stats.opaque + 1 } }
}
fn make_terminals(exits: &Terminals) -> terms.TerminalContext {
    mut terminals := terms.no_terminals()
    terminals.version = exits.version; terminals.overflow = exits.overflow; terminals.zero = exits.zero
    terminals.assertion = exits.assertion; terminals.io = exits.io
    terminals.bounds = exits.bounds; terminals.float_trap = exits.float_trap
    terminals
}
fn make_call_inputs(config: &Options) -> call_inputs.Context {
    if config.source_inputs { return call_inputs.trusted_source_inputs_v1() }
    call_inputs.conservative()
}
fn has_temp_push(f: &mir.Function) -> bool {
    for op in 0..f.kinds.len {
        if f.modes[op] != 2 && f.kinds[op] == 10 {
            place := f.place[op]
            if place >= 0 && f.place_kinds[place] == 2 { return true }
        }
    }
    false
}
fn optimize_values_work_mode(f: &mut mir.Function, val_work: &mut values.Workspace, config: &Options, exits: &Terminals, source_contracts: bool) -> i32 {
    if exits.version == 0 {
        changed := values.optimize_budget(&mut val_work, &mut f, config.value_budget)
        if changed && !f.verified { return 4 }; return 0
    }
    if exits.version != 1 { return 6 }
    mut context := values.context(1)
    if !values.declare_unobserving_terminal(&mut context, exits.overflow) ||
        !values.declare_unobserving_terminal(&mut context, exits.zero) ||
        !values.declare_unobserving_terminal(&mut context, exits.assertion) ||
        !values.declare_unobserving_terminal(&mut context, exits.io) ||
        !values.declare_unobserving_terminal(&mut context, exits.bounds) ||
        !values.declare_unobserving_terminal(&mut context, exits.float_trap) { return 6 }
    mut changed := false
    if source_contracts {
        inputs := make_call_inputs(&config)
        changed = values.optimize_with_source_contracts_budget(&mut val_work, &mut f, &context, &inputs, config.value_budget)
    } else {
        changed = values.optimize_with_context_budget(&mut val_work, &mut f, &context, config.value_budget)
    }
    if changed && !f.verified { return 4 }; 0
}
fn run_frame_pass_mode(f: &mut mir.Function, optimizer: &mut frame.Workspace, config: &Options, exits: &Terminals,
    result: &mut Status, source_contracts: bool) -> bool {
    terminals := make_terminals(&exits)
    if !terms.valid(&terminals) { result.error = 6; return false }
    context := memory.for_source_producer(config.source_objects)
    inputs := make_call_inputs(&config)
    calls := call_abi.for_source_producer(config.source_abi)
    prepared := if source_contracts {
        frame.analyze_with_source_contracts_budget(&mut optimizer, &f, &context, &terminals, &inputs, &calls, config.frame_budget)
    } else {
        frame.analyze_with_contracts_budget(&mut optimizer, &f, &context, &terminals, &calls, config.frame_budget)
    }
    result.frame_state = frame.status(&optimizer)
    result.stats.analysis_units = i64(frame.units(&optimizer))
    if prepared {
        frame.apply(&mut optimizer, &mut f)
        result.frame_state = frame.status(&optimizer)
        result.stats.optimized = 1
        result.stats.promoted = frame.promoted(&optimizer)
        result.stats.removed_loads = frame.removed_loads(&optimizer)
        result.stats.removed_stores = frame.removed_stores(&optimizer)
        result.stats.private_memory_ops = frame.private_memory_ops(&optimizer)
        return true
    } else if result.frame_state == -3 { result.stats.budget_refusals = 1 }
    else if result.frame_state != -2 { result.error = 3 }
    false
}
fn run_frame_pass(f: &mut mir.Function, optimizer: &mut frame.Workspace, config: &Options, exits: &Terminals, result: &mut Status) -> bool {
    run_frame_pass_mode(&mut f, &mut optimizer, &config, &exits, &mut result, false)
}
fn run_expr_pass(f: &mut mir.Function, expr_work: &mut expression_stack.Workspace, config: &Options, exits: &Terminals) -> i32 {
    if !config.source_temporaries || !has_temp_push(&f) { return 0 }
    terminals := make_terminals(&exits)
    if !terms.valid(&terminals) { return 6 }
    inputs := make_call_inputs(&config)
    mut expr_context := expression_stack.trusted_source_expression_storage_v1()
    if config.source_objects && memory.source_frame_eligible(&f) {
        expr_context = expression_stack.trusted_source_expression_and_objects_v1()
    }
    changed := expression_stack.optimize_with_context_budget(&mut expr_work, &mut f, &expr_context, &terminals, &inputs, config.frame_budget)
    state := expression_stack.status(&expr_work)
    if state == 2 {
        if !changed || !f.verified { return 2 }
        return 0
    }
    if changed { return 2 }
    if state == -1 { return 2 }; 0
}
fn run_post_ssa_mode(f: &mut mir.Function, val_work: &mut values.Workspace, config: &Options, exits: &Terminals, result: &mut Status, source_contracts: bool) {
    if !config.values { complete(&f, &mut result); return }
    result.error = optimize_values_work_mode(&mut f, &mut val_work, &config, &exits, source_contracts)
    if result.error == 6 { return }
    result.value_state = values.status(&val_work)
    result.stats.value_analysis_units = i64(values.units(&val_work))
    if result.error != 0 { return }
    if result.value_state == 2 {
        result.stats.values_optimized = 1
        result.stats.value_rewrites = values.rewritten(&val_work)
        result.stats.value_deleted = values.deleted(&val_work)
        result.stats.value_immediates = values.constant_immediates(&val_work)
    } else if result.value_state == -3 { result.stats.value_budget_refusals = 1 }
    else if result.value_state != 0 && result.value_state != -2 { result.error = 5 }
    complete(&f, &mut result)
}
fn run_post_ssa(f: &mut mir.Function, val_work: &mut values.Workspace, config: &Options, exits: &Terminals, result: &mut Status) {
    run_post_ssa_mode(&mut f, &mut val_work, &config, &exits, &mut result, false)
}
fn prepare_source_scalar_passes(f: &mut mir.Function, verifier: &mut verify.Workspace, config: &Options, result: &mut Status) -> bool {
    if config.values && (iteration.lower_scalar_steps(&mut f) || !f.verified) &&
        !verify.verify_into(&mut f, &mut verifier) {
        result.error = 2
        return false
    }
    true
}
fn run_ssa_pass(f: &mut mir.Function, ssa_work: &mut ssa.Workspace, config: &Options, exits: &Terminals, result: &mut Status) -> bool {
    context := memory.for_source_producer(config.source_objects)
    calls := call_abi.for_source_producer(config.source_abi)
    terminals := make_terminals(&exits)
    mut inputs := call_inputs.conservative()
    if config.source_inputs { inputs = call_inputs.trusted_source_inputs_v1() }
    mut temporaries := expression_stack.conservative()
    if config.source_temporaries { temporaries = expression_stack.trusted_source_expression_storage_v1() }
    changed := ssa.optimize_values_with_contracts_budget(&mut ssa_work, &mut f, &context,
        &terminals, &inputs, &calls, &temporaries, config.ssa_budget)
    state := ssa.status(&ssa_work)
    result.stats.ssa_analysis_units = i64(ssa.units(&ssa_work))
    if state == 2 {
        if !changed || !f.verified { result.error = 9; return false }
        result.stats.ssa_optimized = 1
        result.stats.ssa_cells = ssa.cells(&ssa_work)
        result.stats.ssa_values = ssa.values(&ssa_work)
        result.stats.ssa_parameters = ssa.parameters(&ssa_work)
        result.stats.ssa_registers = ssa.registers(&ssa_work)
        result.stats.ssa_captures = ssa.captures(&ssa_work)
        result.stats.ssa_stack_groups = ssa.stack_groups(&ssa_work)
        result.stats.ssa_removed_loads = ssa.removed_loads(&ssa_work)
        result.stats.ssa_removed_stores = ssa.removed_stores(&ssa_work)
        result.stats.ssa_removed_pushes = ssa.removed_pushes(&ssa_work)
        result.stats.ssa_removed_pops = ssa.removed_pops(&ssa_work)
        result.stats.ssa_copies = ssa.copies(&ssa_work)
    } else {
        if changed { result.error = 9; return false }
        if state == -3 { result.stats.ssa_budget_refusals = 1 }
        else if state != 0 && state != -2 { result.error = 9; return false }
    }
    true
}
pub fn run_into(f: &mut mir.Function, w: &mut Workspace, config: &Options, exits: &Terminals) -> Status {
    mut result := status()
    if !verify.verify_into(&mut f, &mut w.verifier) { result.error = 1; return result }
    if !config.optimize { complete(&f, &mut result); return result }
    applied := run_frame_pass(&mut f, &mut w.optimizer, &config, &exits, &mut result)
    if result.error != 0 { return result }
    if applied && !verify.verify_into(&mut f, &mut w.verifier) { result.error = 2; return result }
    if config.ssa {
        if !run_ssa_pass(&mut f, &mut w.ssa, &config, &exits, &mut result) { return result }
    }
    run_post_ssa(&mut f, &mut w.values, &config, &exits, &mut result)
    result
}
pub fn run_source_into(f: &mut mir.Function, w: &mut Workspace, config: &Options, exits: &Terminals) -> Status {
    mut result := status()
    if !verify.verify_into(&mut f, &mut w.verifier) { result.error = 1; return result }
    if !config.optimize { complete(&f, &mut result); return result }
    applied := run_frame_pass_mode(&mut f, &mut w.optimizer, &config, &exits, &mut result, !config.ssa)
    if result.error != 0 { return result }
    if applied && !verify.verify_into(&mut f, &mut w.verifier) { result.error = 2; return result }
    if config.ssa {
        if !run_ssa_pass(&mut f, &mut w.ssa, &config, &exits, &mut result) { return result }
    } else {
        expr_error := run_expr_pass(&mut f, &mut w.expr_work, &config, &exits)
        if expr_error != 0 { result.error = expr_error; return result }
    }
    run_branches(&mut f, &mut w.branches, &config, &exits)
    if prepare_source_scalar_passes(&mut f, &mut w.verifier, &config, &mut result) {
        run_post_ssa_mode(&mut f, &mut w.values, &config, &exits, &mut result, true)
    }
    result
}
fn run_branches(f: &mut mir.Function, bw: &mut branches.Workspace, config: &Options, exits: &Terminals) {
    if !config.optimize { return }
    terminals := make_terminals(&exits)
    if terms.valid(&terminals) { _ := branches.optimize_with_terminals_into(&mut bw, &mut f, &terminals) }
}
