import ..backend.float_operation as floating
import mir

pub fn set(f: &mut mir.Function, id: i32, op: i32, input: i32, offset: i32) {
    f.kinds[id] = 19; f.opcodes[id] = op + 32
    f.a[id] = floating.input_reg(op)
    if op < 12 { f.b[id] = 1 }
    f.dst[id] = floating.output_reg(op); f.types[id] = floating.result(op, input)
    f.aux[id] = input; f.imm[id] = i64(offset)
    f.reads[id] = floating.reads(op); f.writes[id] = floating.writes(op); f.flags[id] = floating.flags(op)
}

pub fn valid(f: &mir.Function, id: i32) -> bool {
    op := f.opcodes[id] - 32; input := f.aux[id]
    mut rhs := -1; if op < 12 { rhs = 1 }
    floating.supported(op, input) && f.types[id] == floating.result(op, input) &&
        f.imm[id] >= 0 && f.imm[id] <= 2147483647 && f.a[id] == floating.input_reg(op) && f.b[id] == rhs &&
        f.c[id] == -1 && f.dst[id] == floating.output_reg(op) && f.reads[id] == floating.reads(op) &&
        f.writes[id] == floating.writes(op) && f.flags[id] == floating.flags(op) &&
        f.effects[id] == 0 && f.clobbers[id] == 0 && f.abi[id] == 0 && f.variant[id] == 0 &&
        f.place[id] == -1 && f.extensions[id] == 0 && f.recipes[id] == 0 && f.stack_roles[id] == 0 &&
        f.reloc_kinds[id] == -1 && f.targets[id] == -1 && f.import_ids[id] == -1
}
