import ..backend.backend_row as row
import mir
import ..frontend.source_types
import mir_operation as decode

fn slot(words: &[]i64, first: i32, arg: i32) -> i32 {
    i32(words[first + arg / 4].shr((arg % 4) * 16).bit_and(65535))
}
fn load(f: &mut mir.Function, d: &mut decode.Decoded, at: i32, home: i32, reg: i32) {
    op := mir.add(&mut f, 7); f.origins[op] = at
    decode.frame(&mut d, 1, home, reg); decode.append_into(&d, &mut f, op)
    f.recipes[op] = 1; if home >= 32 { f.c[op] = 9 }
}
fn stack(f: &mut mir.Function, d: &mut decode.Decoded, at: i32, reg: i32, push: bool) {
    op := mir.add(&mut f, 10); f.origins[op] = at
    decode.reset(&mut d); decode.stack(&mut d, reg, push, false); decode.append_into(&d, &mut f, op)
}
pub fn append(f: &mut mir.Function, d: &mut decode.Decoded, words: &[]i64, first: i32, at: i32, target: i32) -> bool {
    cell := words[first]; indirect := row.kind(cell) == 62
    if !row.valid_source_call(cell) || indirect != (target < 0) || at > f.source_words - row.call_width(cell) { return false }
    args := row.call_count(cell); shape := words[first + 1]
    if shape < 0 || shape.bit_and(2147483648) != 0 { return false }
    mut start := first + 2; mut address := -1; mut dispatch := 0
    if indirect {
        callee := words[start]; start = start + 1
        if callee < 0 || callee.bit_and(4294967295) > 65535 || callee.shr(32) > 16777216 { return false }
        address = i32(callee.bit_and(65535)); dispatch = i32(callee.shr(32))
        if dispatch > 0 && f.platform != 3 && f.platform != 4 { return false }
    }
    if args % 4 != 0 && words[start + args / 4].shr(args % 4 * 16) != 0 { return false }
    f.boundaries[at - f.first_word] = f.order.len
    mut n := args
    while n > 8 { n = n - 1; load(&mut f, &mut d, at, slot(&words, start, n), 0); stack(&mut f, &mut d, at, 0, true) }
    if indirect { load(&mut f, &mut d, at, address, 16) }
    for p in 0..n { load(&mut f, &mut d, at, slot(&words, start, p), p) }
    op := mir.add(&mut f, 14); f.origins[op] = at
    f.opcodes[op] = row.kind(cell); f.imm[op] = cell.bit_and(2147483647); f.aux[op] = n
    f.types[op] = i32(shape.bit_and(2147483647)); f.variant[op] = shape.bit_and(-4294967296).bit_or(i64(dispatch))
    if indirect { f.a[op] = 16 } else { f.targets[op] = target; f.reloc_kinds[op] = 1 }
    f.abi[op] = 1; if dispatch > 0 { f.abi[op] = 2 }
    f.effects[op] = 95; f.flags[op] = 3; f.reads[op] = -1; f.clobbers[op] = -1
    for _ in 8..args { stack(&mut f, &mut d, at, 9, false) }
    true
}
pub fn valid(f: &mir.Function, op: i32) -> bool {
    tag := f.opcodes[op]; dispatch := f.variant[op].bit_and(4294967295)
    if f.kinds[op] != 14 || f.types[op] < 0 || f.variant[op] < 0 || f.aux[op] < 0 || f.aux[op] > 8 ||
        f.imm[op] < 0 || f.imm[op] > 2147483647 || f.b[op] != -1 || f.c[op] != -1 || f.dst[op] != -1 ||
        f.flags[op] != 3 || f.effects[op] != 95 || f.reads[op] != -1 || f.writes[op] != 0 || f.clobbers[op] != -1 ||
        f.place[op] != -1 || f.import_ids[op] != -1 || f.recipes[op] != 0 || f.stack_roles[op] != 0 ||
        f.extensions[op] != 0 || f.raw_starts[op] != -1 || f.widths[op] != 0 { return false }
    if !source_types.callable(&f.source_types, i32(f.variant[op].shr(32)), f.types[op], f.aux[op]) { return false }
    if tag == 48 {
        return f.reloc_kinds[op] == 1 && f.targets[op] >= 0 && f.targets[op] < f.source_labels &&
            f.a[op] == -1 && dispatch == 0 && f.abi[op] == 1
    }
    tag == 62 && f.a[op] == 16 && f.targets[op] == -1 && f.reloc_kinds[op] == -1 &&
        ((dispatch == 0 && f.abi[op] == 1) || (dispatch > 0 && dispatch <= 16777216 && (f.platform == 3 || f.platform == 4) && f.abi[op] == 2))
}
