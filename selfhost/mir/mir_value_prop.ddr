import mir
import mir_call_inputs as call_inputs
import mir_contract as core
import mir_scalar_contract as scalar
import mir_liveness as live
import mir_verify as verify

pub opaque struct Context { valid: bool, epoch: i32, labels: []i32 }
pub fn context(epoch: i32) -> Context { Context { valid: epoch == 1, epoch: epoch, labels: [] } }
pub fn declare_unobserving_terminal(ctx: &mut Context, label: i32) -> bool {
    if !ctx.valid || label < 0 { ctx.valid = false; return false }
    mut at := 0
    while at < ctx.labels.len && ctx.labels[at] < label { at = at + 1 }
    if at < ctx.labels.len && ctx.labels[at] == label { return true }
    ctx.labels.push(label); mut i := ctx.labels.len - 1
    while i > at { ctx.labels[i] = ctx.labels[i - 1]; i = i - 1 }
    ctx.labels[at] = label; true
}

pub opaque struct Workspace {
    candidate: mir.Function, verifier: verify.Workspace, liveness: live.Workspace, copy_live_after: []i64,
    undo_slots: []i32, undo_ops: []i32, undo_modes: []i32, undo_starts: []i32, undo_rows: []i64,
    before_verified: bool, before_optimizable: bool, action: i32, immediate: bool, restored: i32, verifications: i32,
    definitions: []i32, seq: []i32, physical: []i32, slots: []i32, physical_bits: []i64,
    all_slots: i64, zr: i32, step: i32, force_full: bool, fallback: bool,
    reached: []bool, queued: []bool, queue: []i32, pred_starts: []i32, pred_fill: []i32, predecessors: []i32,
    in_x: []i64, in_w: []i64, in_kx: []i32, in_vx: []i64, in_kw: []i32, in_vw: []i64, in_zero: []i64,
    out_x: []i64, out_w: []i64, out_kx: []i32, out_vx: []i64, out_kw: []i32, out_vw: []i64, out_zero: []i64,
    x: []i64, low: []i64, kx: []i32, vx: []i64, kw: []i32, vw: []i64, zero: i64, source_inputs: bool,
    state: i32, work: i32, limit: i32, rewrites: i32, deleted: i32, immediates: i32, iterations: i32,
}
fn candidate() -> mir.Function { mut f := mir.new(); _ := mir.add(&mut f, 1); f }
fn workspace(full: bool) -> Workspace {
    Workspace { candidate: candidate(), verifier: verify.new_work(), liveness: live.new(), copy_live_after: [],
        undo_slots: [], undo_ops: [], undo_modes: [], undo_starts: [], undo_rows: [],
        before_verified: false, before_optimizable: false, action: 0, immediate: false, restored: 0, verifications: 0,
        definitions: [], seq: [], physical: [], slots: [], physical_bits: [], all_slots: 0, zr: 0, step: 0, force_full: full, fallback: false, reached: [], queued: [], queue: [], pred_starts: [], pred_fill: [], predecessors: [],
        in_x: [], in_w: [], in_kx: [], in_vx: [], in_kw: [], in_vw: [], in_zero: [],
        out_x: [], out_w: [], out_kx: [], out_vx: [], out_kw: [], out_vw: [], out_zero: [],
        x: [], low: [], kx: [], vx: [], kw: [], vw: [], zero: 0, source_inputs: false,
        state: 0, work: 0, limit: 0, rewrites: 0, deleted: 0, immediates: 0, iterations: 0 }
}
pub fn new() -> Workspace { workspace(false) }
pub fn new_full_domain() -> Workspace { workspace(true) }
pub fn fact_slots(w: &Workspace) -> i32 { w.physical.len }
pub fn fact_rows(w: &Workspace) -> i32 { w.in_x.len }
pub fn used_full_fallback(w: &Workspace) -> bool { w.fallback }
pub fn status(w: &Workspace) -> i32 { w.state }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn rewritten(w: &Workspace) -> i32 { if w.state > 0 { w.rewrites } else { 0 } }
pub fn deleted(w: &Workspace) -> i32 { if w.state > 0 { w.deleted } else { 0 } }
pub fn constant_immediates(w: &Workspace) -> i32 { if w.state > 0 { w.immediates } else { 0 } }
pub fn fixpoint_visits(w: &Workspace) -> i32 { w.iterations }
pub fn restored_rows(w: &Workspace) -> i32 { w.restored }
pub fn full_verifications(w: &Workspace) -> i32 { w.verifications }
fn charge(w: &mut Workspace, n: i32) -> bool {
    if n < 0 || n > w.limit - w.work { w.state = -3; return false }; w.work = w.work + n; true
}
fn reset(w: &mut Workspace, limit: i32) {
    w.undo_slots.clear(); w.undo_ops.clear(); w.undo_modes.clear(); w.undo_starts.clear(); w.undo_rows.clear()
    w.action = 0; w.immediate = false; w.restored = 0; w.verifications = 0; w.definitions.clear(); w.seq.clear()
    w.physical.clear(); w.slots.clear(); w.physical_bits.clear(); w.all_slots = 0; w.zr = 0; w.step = 0; w.fallback = false
    w.reached.clear(); w.queued.clear(); w.queue.clear()
    w.pred_starts.clear(); w.pred_fill.clear(); w.predecessors.clear()
    w.in_x.clear(); w.in_w.clear(); w.in_kx.clear(); w.in_vx.clear(); w.in_kw.clear(); w.in_vw.clear(); w.in_zero.clear()
    w.out_x.clear(); w.out_w.clear(); w.out_kx.clear(); w.out_vx.clear(); w.out_kw.clear(); w.out_vw.clear(); w.out_zero.clear()
    w.x.clear(); w.low.clear(); w.kx.clear(); w.vx.clear(); w.kw.clear(); w.vw.clear()
    w.state = 0; w.work = 0; w.limit = limit; w.rewrites = 0; w.deleted = 0; w.immediates = 0; w.iterations = 0
}
fn bit(reg: i32) -> i64 { i64(1).shl(reg) }
fn include(w: &mut Workspace, reg: i32) {
    if reg == -1 { return }
    if reg < 0 || reg > 30 { w.fallback = true; return }
    w.slots[reg] = -2
}
fn domain(w: &mut Workspace, f: &mir.Function) -> bool {
    if !charge(&mut w, 128 + f.kinds.len * 4) { return false }
    for _ in 0..31 { w.slots.push(-1) }
    for op in 0..f.kinds.len {
        if f.modes[op] == 2 || f.kinds[op] < 1 || f.kinds[op] > 6 { continue }
        include(&mut w, f.dst[op]); include(&mut w, f.a[op]); include(&mut w, f.b[op]); include(&mut w, f.c[op])
    }
    for reg in 0..31 {
        if w.force_full || w.fallback || w.slots[reg] == -2 {
            slot := w.physical.len; w.slots[reg] = slot
            w.physical.push(reg); w.physical_bits.push(mir.variable_bit(reg))
        }
    }
    w.zr = w.physical.len; w.physical.push(-1); w.physical_bits.push(0)
    w.all_slots = i64(1).shl(w.physical.len) - 1; true
}
fn index(w: &Workspace, reg: i32) -> i32 {
    if reg == -1 { return w.zr }
    if reg < 0 || reg > 30 { return -1 }; w.slots[reg]
}
fn top(w: &mut Workspace) {
    w.zero = w.all_slots
    for r in 0..w.physical.len {
        w.x[r] = w.all_slots; w.low[r] = w.all_slots; w.kx[r] = 2; w.vx[r] = 0; w.kw[r] = 2; w.vw[r] = 0
    }
}
fn entry(w: &mut Workspace) {
    w.zero = bit(w.zr)
    for r in 0..w.physical.len { w.x[r] = bit(r); w.low[r] = bit(r); w.kx[r] = 0; w.vx[r] = 0; w.kw[r] = 0; w.vw[r] = 0 }
    w.kx[w.zr] = 1; w.kw[w.zr] = 1
}
fn op_clobbers(w: &Workspace, f: &mir.Function, op: i32) -> i64 {
    if w.source_inputs && f.kinds[op] == 14 && f.abi[op] >= 1 && f.abi[op] <= 3 {
        return f.clobbers[op].bit_and(i64(503316480).bit_not())
    }
    f.clobbers[op]
}
fn invalidate_one(w: &mut Workspace, dst: i32) {
    w.step = w.step + 1
    flag := bit(dst); clear_flag := flag.bit_not()
    w.zero = w.zero.bit_and(clear_flag)
    aliases := w.x[dst].bit_or(w.low[dst]).bit_and(clear_flag)
    if aliases != 0 {
        for r in 0..w.physical.len {
            if aliases.bit_and(bit(r)) != 0 {
                w.x[r] = w.x[r].bit_and(clear_flag); w.low[r] = w.low[r].bit_and(clear_flag)
            }
        }
    }
    w.seq[dst] = w.step
    w.x[dst] = flag; w.low[dst] = flag; w.kx[dst] = 0; w.vx[dst] = 0; w.kw[dst] = 0; w.vw[dst] = 0
}
fn invalidate(w: &mut Workspace, killed: i64) {
    if killed == 0 { return }
    w.step = w.step + 1
    clear := killed.bit_not()
    w.zero = w.zero.bit_and(clear)
    for r in 0..w.physical.len {
        b := bit(r)
        if killed.bit_and(b) != 0 {
            w.seq[r] = w.step
            w.x[r] = b; w.low[r] = b; w.kx[r] = 0; w.vx[r] = 0; w.kw[r] = 0; w.vw[r] = 0
        } else { w.x[r] = w.x[r].bit_and(clear); w.low[r] = w.low[r].bit_and(clear) }
    }
}
fn kill(w: &mut Workspace, physical_mask: i64) {
    if physical_mask.bit_and(2147483647) == 0 { return }
    mut killed: i64 = 0; mut count := 0; mut last := -1
    for slot in 0..w.zr {
        if physical_mask.bit_and(w.physical_bits[slot]) != 0 {
            killed = killed.bit_or(bit(slot)); count = count + 1; last = slot
        }
    }
    if count == 1 { invalidate_one(&mut w, last) }
    else if count > 1 { invalidate(&mut w, killed) }
}
fn assign(w: &mut Workspace, dst: i32, eqx: i64, eqw: i64, kx: i32, vx: i64, kw: i32, vw: i64, zero: bool) {
    invalidate_one(&mut w, dst); flag := bit(dst)
    if eqx == 0 && eqw == 0 && kx == 0 && kw == 0 {
        w.vx[dst] = vx; w.vw[dst] = vw
        if zero { w.zero = w.zero.bit_or(flag) }
        return
    }
    mut full := eqx.bit_or(flag); mut low := eqw.bit_or(flag)
    if kx == 1 || kw == 1 {
        for r in 0..w.physical.len {
            b := bit(r)
            if kx == 1 && w.kx[r] == 1 && w.vx[r] == vx { full = full.bit_or(b) }
            if kw == 1 && w.kw[r] == 1 && w.vw[r] == vw { low = low.bit_or(b) }
            if full.bit_and(b) != 0 { w.x[r] = w.x[r].bit_or(flag) }
            if low.bit_and(b) != 0 { w.low[r] = w.low[r].bit_or(flag) }
        }
    } else {
        aliases := full.bit_or(low).bit_and(flag.bit_not())
        if aliases != 0 {
            for r in 0..w.physical.len {
                b := bit(r)
                if aliases.bit_and(b) != 0 {
                    if full.bit_and(b) != 0 { w.x[r] = w.x[r].bit_or(flag) }
                    if low.bit_and(b) != 0 { w.low[r] = w.low[r].bit_or(flag) }
                }
            }
        }
    }
    w.x[dst] = full; w.low[dst] = low; w.kx[dst] = kx; w.vx[dst] = vx; w.kw[dst] = kw; w.vw[dst] = vw
    if zero { w.zero = w.zero.bit_or(flag) }
}
fn transfer(w: &mut Workspace, f: &mir.Function, op: i32) {
    if f.modes[op] == 2 { return }
    defs := f.writes[op].bit_or(op_clobbers(&w, &f, op))
    if defs.bit_and(2147483647) == 0 { return }
    physical_dst := f.dst[op]; dst := index(&w, physical_dst); kind := f.kinds[op]; ty := f.types[op]
    if physical_dst >= 0 && physical_dst <= 30 && dst >= 0 && (kind == 1 || kind == 2) && (ty == 1 || ty == 2) &&
        (kind != 2 || index(&w, f.a[op]) >= 0) {
        if kind == 1 {
            mut value := f.imm[op]; if ty == 1 { value = value.bit_and(4294967295) }
            assign(&mut w, dst, 0, 0, 1, value, 1, value.bit_and(4294967295), value >= 0 && value <= 4294967295)
        } else {
            source := index(&w, f.a[op]); mut eqx := w.x[source]; eqw := w.low[source]
            mut kx := w.kx[source]; mut vx := w.vx[source]; kw := w.kw[source]; vw := w.vw[source]
            mut zero := w.zero.bit_and(bit(source)) != 0
            if ty == 1 { eqx = eqw.bit_and(w.zero); kx = kw; vx = vw; zero = true }
            assign(&mut w, dst, eqx, eqw, kx, vx, kw, vw, zero)
        }
        return
    }
    if physical_dst >= 0 && physical_dst <= 30 && dst >= 0 && kind == 3 && f.opcodes[op] == 3 && (ty == 1 || ty == 2) &&
        f.a[op] >= -1 && f.a[op] <= 30 && index(&w, f.a[op]) >= 0 && f.aux[op] >= 0 && f.aux[op] < 64 {
        source := index(&w, f.a[op]); shift := f.aux[op]; mask := i64(65535).shl(shift)
        mut kx := w.kx[source]; mut vx := w.vx[source]; mut kw := w.kw[source]; mut vw := w.vw[source]
        if kx == 1 { vx = vx.bit_and(mask.bit_not()).bit_or(f.imm[op]) }
        if shift < 32 && kw == 1 { vw = vw.bit_and(mask.bit_not()).bit_or(f.imm[op]).bit_and(4294967295) }
        if ty == 1 { kx = kw; vx = vw }
        mut zero := ty == 1
        if kx == 1 { zero = vx >= 0 && vx <= 4294967295 }
        mut eqw: i64 = 0; if shift >= 32 { eqw = w.low[source] }
        assign(&mut w, dst, 0, eqw, kx, vx, kw, vw, zero); return
    }
    if dst >= 0 && dst < w.zr && defs == w.physical_bits[dst] { invalidate_one(&mut w, dst) }
    else { kill(&mut w, defs) }
    if physical_dst >= 0 && physical_dst <= 30 && dst >= 0 && (ty == 1 || kind == 6) &&
        (kind == 3 || kind == 4 || kind == 6 || kind == 7) { w.zero = w.zero.bit_or(bit(dst)) }
}
fn load_in(w: &mut Workspace, block: i32) {
    w.step = 0
    w.zero = w.in_zero[block]; base := block * w.physical.len
    for r in 0..w.physical.len {
        w.seq[r] = 0
        w.x[r] = w.in_x[base + r]; w.low[r] = w.in_w[base + r]
        w.kx[r] = w.in_kx[base + r]; w.vx[r] = w.in_vx[base + r]; w.kw[r] = w.in_kw[base + r]; w.vw[r] = w.in_vw[base + r]
    }
}
fn meet(w: &mut Workspace, block: i32) {
    if block == 0 { entry(&mut w); return }; top(&mut w)
    for p in w.pred_starts[block]..w.pred_starts[block + 1] {
        pred := w.predecessors[p]; base := pred * w.physical.len; w.zero = w.zero.bit_and(w.out_zero[pred])
        for r in 0..w.physical.len {
            w.x[r] = w.x[r].bit_and(w.out_x[base + r]); w.low[r] = w.low[r].bit_and(w.out_w[base + r])
            pk := w.out_kx[base + r]; pv := w.out_vx[base + r]
            if w.kx[r] == 2 { w.kx[r] = pk; w.vx[r] = pv }
            else if pk != 2 && (pk != w.kx[r] || (pk == 1 && pv != w.vx[r])) { w.kx[r] = 0; w.vx[r] = 0 }
            lk := w.out_kw[base + r]; lv := w.out_vw[base + r]
            if w.kw[r] == 2 { w.kw[r] = lk; w.vw[r] = lv }
            else if lk != 2 && (lk != w.kw[r] || (lk == 1 && lv != w.vw[r])) { w.kw[r] = 0; w.vw[r] = 0 }
        }
    }
}
fn save_in(w: &mut Workspace, block: i32) {
    w.in_zero[block] = w.zero; base := block * w.physical.len
    for r in 0..w.physical.len {
        w.in_x[base + r] = w.x[r]; w.in_w[base + r] = w.low[r]
        w.in_kx[base + r] = w.kx[r]; w.in_vx[base + r] = w.vx[r]; w.in_kw[base + r] = w.kw[r]; w.in_vw[base + r] = w.vw[r]
    }
}
fn save_out(w: &mut Workspace, block: i32) -> bool {
    mut changed := w.out_zero[block] != w.zero; w.out_zero[block] = w.zero; base := block * w.physical.len
    for r in 0..w.physical.len {
        at := base + r
        if w.out_x[at] != w.x[r] || w.out_w[at] != w.low[r] || w.out_kx[at] != w.kx[r] || w.out_vx[at] != w.vx[r] ||
            w.out_kw[at] != w.kw[r] || w.out_vw[at] != w.vw[r] { changed = true }
        w.out_x[at] = w.x[r]; w.out_w[at] = w.low[r]; w.out_kx[at] = w.kx[r]; w.out_vx[at] = w.vx[r]
        w.out_kw[at] = w.kw[r]; w.out_vw[at] = w.vw[r]
    }
    changed
}
fn graph(w: &mut Workspace, f: &mir.Function) -> bool {
    blocks := f.block_starts.len
    slots := w.physical.len
    if !charge(&mut w, slots * 7 + blocks * (slots * 12 + 2) + f.edge_to.len * 4 + f.kinds.len * w.zr) { return false }
    w.definitions.reserve(slots); w.seq.reserve(slots); w.x.reserve(slots); w.low.reserve(slots)
    w.kx.reserve(slots); w.vx.reserve(slots); w.kw.reserve(slots); w.vw.reserve(slots)
    for _ in 0..slots {
        w.definitions.push(0); w.seq.push(0); w.x.push(0); w.low.push(0); w.kx.push(0); w.vx.push(0); w.kw.push(0); w.vw.push(0)
    }
    for op in 0..f.kinds.len { if f.modes[op] != 2 {
        defs := f.writes[op].bit_or(op_clobbers(&w, &f, op))
        for r in 0..w.zr { if defs.bit_and(w.physical_bits[r]) != 0 { w.definitions[r] = w.definitions[r] + 1 } }
    } }
    total_rows := blocks * slots
    w.reached.reserve(blocks); w.queued.reserve(blocks); w.pred_fill.reserve(blocks)
    w.in_zero.reserve(blocks); w.out_zero.reserve(blocks)
    w.in_x.reserve(total_rows); w.in_w.reserve(total_rows); w.in_kx.reserve(total_rows); w.in_vx.reserve(total_rows); w.in_kw.reserve(total_rows); w.in_vw.reserve(total_rows)
    w.out_x.reserve(total_rows); w.out_w.reserve(total_rows); w.out_kx.reserve(total_rows); w.out_vx.reserve(total_rows); w.out_kw.reserve(total_rows); w.out_vw.reserve(total_rows)
    for _ in 0..blocks {
        w.reached.push(false); w.queued.push(false); w.pred_fill.push(0); w.in_zero.push(w.all_slots); w.out_zero.push(w.all_slots)
        for _ in 0..slots {
            w.in_x.push(w.all_slots); w.in_w.push(w.all_slots); w.in_kx.push(2); w.in_vx.push(0); w.in_kw.push(2); w.in_vw.push(0)
            w.out_x.push(w.all_slots); w.out_w.push(w.all_slots); w.out_kx.push(2); w.out_vx.push(0); w.out_kw.push(2); w.out_vw.push(0)
        }
    }
    w.queue.reserve(blocks); w.reached[0] = true; w.queue.push(0); mut next := 0
    while next < w.queue.len {
        b := w.queue[next]; next = next + 1
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to >= 0 && !w.reached[to] { w.reached[to] = true; w.queue.push(to) }
        }
    }
    for e in 0..f.edge_to.len { to := f.edge_to[e]; if to >= 0 && w.reached[f.edge_from[e]] { w.pred_fill[to] = w.pred_fill[to] + 1 } }
    w.pred_starts.reserve(blocks + 1); w.pred_starts.push(0)
    for b in 0..blocks { w.pred_starts.push(w.pred_starts[b] + w.pred_fill[b]); w.pred_fill[b] = w.pred_starts[b] }
    w.predecessors.reserve(w.pred_starts[blocks])
    for _ in 0..w.pred_starts[blocks] { w.predecessors.push(0) }
    for e in 0..f.edge_to.len {
        to := f.edge_to[e]; if to < 0 || !w.reached[f.edge_from[e]] { continue }
        w.predecessors[w.pred_fill[to]] = f.edge_from[e]; w.pred_fill[to] = w.pred_fill[to] + 1
    }
    true
}
fn declared_exit(w: &mut Workspace, f: &mir.Function, block: i32, labels: &[]i32, epoch: i32) -> bool {
    if epoch != 1 { return false }
    mut last := -1
    for position in f.block_starts[block]..f.block_ends[block] {
        if !charge(&mut w, 1) { return false }
        op := f.order[position]; if f.modes[op] != 2 { last = op }
    }
    if last < 0 || (f.kinds[last] != 12 && f.kinds[last] != 13) { return false }
    target := f.targets[last]; mut first := 0; mut end := labels.len
    while first < end {
        if !charge(&mut w, 1) { return false }
        middle := first + (end - first) / 2
        if labels[middle] < target { first = middle + 1 } else { end = middle }
    }
    first < labels.len && labels[first] == target
}
fn contracted_exits(w: &mut Workspace, f: &mir.Function, labels: &[]i32, epoch: i32) -> bool {
    if !charge(&mut w, f.block_starts.len + f.edge_to.len * 2) { return false }
    for _ in 0..f.block_starts.len { w.reached.push(false) }
    w.reached[0] = true; w.queue.push(0); mut next := 0
    while next < w.queue.len {
        b := w.queue[next]; next = next + 1
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to < 0 {
                if f.edge_kinds[e] != 3 {
                    mut declared := false
                    if f.edge_kinds[e] == 2 { declared = declared_exit(&mut w, &f, b, &labels, epoch) }
                    if !declared { if w.state != -3 { w.state = -2 }; return false }
                }
            } else if !w.reached[to] { w.reached[to] = true; w.queue.push(to) }
        }
    }
    w.reached.clear(); w.queue.clear(); true
}
fn solve(w: &mut Workspace, f: &mir.Function) -> bool {
    blocks := f.block_starts.len; mut pending := w.queue.len
    for i in 0..pending { w.queued[w.queue[i]] = true }
    w.queue.reserve(blocks)
    while w.queue.len < blocks { w.queue.push(0) }
    mut head := 0; mut tail := pending % blocks
    while pending > 0 {
        b := w.queue[head]; head = (head + 1) % blocks; pending = pending - 1; w.queued[b] = false
        cost := w.physical.len * 24 + 32 + (w.pred_starts[b + 1] - w.pred_starts[b]) * (w.physical.len * 6 + 2) + (f.block_ends[b] - f.block_starts[b]) * (w.physical.len * 8)
        if !charge(&mut w, cost) { return false }; w.iterations = w.iterations + 1
        meet(&mut w, b); save_in(&mut w, b)
        for position in f.block_starts[b]..f.block_ends[b] { transfer(&mut w, &f, f.order[position]) }
        if !save_out(&mut w, b) { continue }
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to >= 0 && !w.queued[to] { w.queue[tail] = to; tail = (tail + 1) % blocks; pending = pending + 1; w.queued[to] = true }
        }
    }
    true
}

fn remember(w: &mut Workspace, f: &mir.Function, op: i32, whole: bool) -> bool {
    if w.undo_slots.len == 0 {
        if !charge(&mut w, f.kinds.len) { return false }
        for _ in 0..f.kinds.len { w.undo_slots.push(-1) }
    }
    mut slot := w.undo_slots[op]
    if slot < 0 {
        if !charge(&mut w, 8) { return false }
        slot = w.undo_ops.len; w.undo_slots[op] = slot
        w.undo_ops.push(op); w.undo_modes.push(f.modes[op]); w.undo_starts.push(-1)
    }
    if whole && w.undo_starts[slot] < 0 {
        if !charge(&mut w, 64) { return false }
        w.undo_starts[slot] = w.undo_rows.len
        w.undo_rows.push(i64(f.kinds[op]))
        w.undo_rows.push(i64(f.opcodes[op]))
        w.undo_rows.push(i64(f.dst[op]))
        w.undo_rows.push(i64(f.a[op]))
        w.undo_rows.push(i64(f.b[op]))
        w.undo_rows.push(i64(f.c[op]))
        w.undo_rows.push(i64(f.imm[op]))
        w.undo_rows.push(i64(f.aux[op]))
        w.undo_rows.push(i64(f.types[op]))
        w.undo_rows.push(i64(f.place[op]))
        w.undo_rows.push(i64(f.extensions[op]))
        w.undo_rows.push(i64(f.effects[op]))
        w.undo_rows.push(i64(f.flags[op]))
        w.undo_rows.push(i64(f.abi[op]))
        w.undo_rows.push(i64(f.reads[op]))
        w.undo_rows.push(i64(f.writes[op]))
        w.undo_rows.push(i64(f.clobbers[op]))
        w.undo_rows.push(i64(f.targets[op]))
        w.undo_rows.push(i64(f.reloc_kinds[op]))
        w.undo_rows.push(i64(f.import_ids[op]))
    }
    true
}
fn rollback(w: &mut Workspace, f: &mut mir.Function) {
    mut slot := w.undo_ops.len
    while slot > 0 {
        slot = slot - 1; op := w.undo_ops[slot]; start := w.undo_starts[slot]
        f.modes[op] = w.undo_modes[slot]
        if start >= 0 {
            f.kinds[op] = i32(w.undo_rows[start + 0])
            f.opcodes[op] = i32(w.undo_rows[start + 1])
            f.dst[op] = i32(w.undo_rows[start + 2])
            f.a[op] = i32(w.undo_rows[start + 3])
            f.b[op] = i32(w.undo_rows[start + 4])
            f.c[op] = i32(w.undo_rows[start + 5])
            f.imm[op] = w.undo_rows[start + 6]
            f.aux[op] = i32(w.undo_rows[start + 7])
            f.types[op] = i32(w.undo_rows[start + 8])
            f.place[op] = i32(w.undo_rows[start + 9])
            f.extensions[op] = i32(w.undo_rows[start + 10])
            f.effects[op] = i32(w.undo_rows[start + 11])
            f.flags[op] = i32(w.undo_rows[start + 12])
            f.abi[op] = i32(w.undo_rows[start + 13])
            f.reads[op] = w.undo_rows[start + 14]
            f.writes[op] = w.undo_rows[start + 15]
            f.clobbers[op] = w.undo_rows[start + 16]
            f.targets[op] = i32(w.undo_rows[start + 17])
            f.reloc_kinds[op] = i32(w.undo_rows[start + 18])
            f.import_ids[op] = i32(w.undo_rows[start + 19])
        }
        w.restored = w.restored + 1
    }
    f.verified = w.before_verified; f.optimizable = w.before_optimizable
}
fn candidate_from(w: &mut Workspace, f: &mir.Function, op: i32) {
    w.candidate.kinds[0] = f.kinds[op]
    w.candidate.opcodes[0] = f.opcodes[op]
    w.candidate.dst[0] = f.dst[op]
    w.candidate.a[0] = f.a[op]
    w.candidate.b[0] = f.b[op]
    w.candidate.c[0] = f.c[op]
    w.candidate.imm[0] = f.imm[op]
    w.candidate.aux[0] = f.aux[op]
    w.candidate.types[0] = f.types[op]
    w.candidate.place[0] = f.place[op]
    w.candidate.extensions[0] = f.extensions[op]
    w.candidate.effects[0] = f.effects[op]
    w.candidate.flags[0] = f.flags[op]
    w.candidate.abi[0] = f.abi[op]
    w.candidate.reads[0] = f.reads[op]
    w.candidate.writes[0] = f.writes[op]
    w.candidate.clobbers[0] = f.clobbers[op]
    w.candidate.modes[0] = f.modes[op]
    w.candidate.targets[0] = f.targets[op]
    w.candidate.reloc_kinds[0] = f.reloc_kinds[op]
    w.candidate.import_ids[0] = f.import_ids[op]
}
fn frame_role(f: &mir.Function, op: i32) -> bool {
    mask := mir.variable_bit(29).bit_or(mir.variable_bit(31))
    f.reads[op].bit_or(f.writes[op]).bit_or(f.clobbers[op]).bit_and(mask) != 0 ||
        f.dst[op] == 29 || f.dst[op] == 31 || f.a[op] == 29 || f.a[op] == 31 ||
        f.b[op] == 29 || f.b[op] == 31 || f.c[op] == 29 || f.c[op] == 31
}
fn preserves_scalar_certificate(w: &Workspace, f: &mir.Function, op: i32) -> bool {
    if !f.verified || f.kinds[op] < 1 || f.kinds[op] > 6 || frame_role(&f, op) { return false }
    if w.action == 1 { return pure_materialization(&f, op) }
    if w.action != 2 || w.candidate.kinds[0] < 1 || w.candidate.kinds[0] > 6 || frame_role(&w.candidate, 0) { return false }
    if f.kinds[op] != w.candidate.kinds[0] && !(f.kinds[op] == 1 && w.candidate.kinds[0] == 2) { return false }
    f.opcodes[op] == w.candidate.opcodes[0] && f.dst[op] == w.candidate.dst[0] &&
        f.types[op] == w.candidate.types[0] && f.writes[op] == w.candidate.writes[0] &&
        (f.aux[op] == w.candidate.aux[0] || (f.kinds[op] == 1 && w.candidate.kinds[0] == 2)) &&
        f.flags[op] == w.candidate.flags[0] && f.effects[op] == w.candidate.effects[0] &&
        (f.effects[op] == 0 || f.effects[op] == 1) && f.abi[op] == w.candidate.abi[0] &&
        f.clobbers[op] == w.candidate.clobbers[0] && f.place[op] == w.candidate.place[0] &&
        f.extensions[op] == w.candidate.extensions[0] && f.targets[op] == w.candidate.targets[0] &&
        f.reloc_kinds[op] == w.candidate.reloc_kinds[0] && f.import_ids[op] == w.candidate.import_ids[0]
}
fn commit_prepared(w: &mut Workspace, f: &mut mir.Function, op: i32) -> bool {
    if w.action == 0 { return true }
    if w.action == 2 && !core.canonical(&w.candidate, 0) { return true }
    if !charge(&mut w, 64) { return false }
    preserve := preserves_scalar_certificate(&w, &f, op)
    if !remember(&mut w, &f, op, w.action == 2) { return false }
    if !preserve { f.verified = false }
    if w.action == 1 {
        f.modes[op] = 2; w.deleted = w.deleted + 1; return true
    }
    f.kinds[op] = w.candidate.kinds[0]
    f.opcodes[op] = w.candidate.opcodes[0]
    f.dst[op] = w.candidate.dst[0]
    f.a[op] = w.candidate.a[0]
    f.b[op] = w.candidate.b[0]
    f.c[op] = w.candidate.c[0]
    f.imm[op] = w.candidate.imm[0]
    f.aux[op] = w.candidate.aux[0]
    f.types[op] = w.candidate.types[0]
    f.place[op] = w.candidate.place[0]
    f.extensions[op] = w.candidate.extensions[0]
    f.effects[op] = w.candidate.effects[0]
    f.flags[op] = w.candidate.flags[0]
    f.abi[op] = w.candidate.abi[0]
    f.reads[op] = w.candidate.reads[0]
    f.writes[op] = w.candidate.writes[0]
    f.clobbers[op] = w.candidate.clobbers[0]
    f.targets[op] = w.candidate.targets[0]
    f.reloc_kinds[op] = w.candidate.reloc_kinds[0]
    f.import_ids[op] = w.candidate.import_ids[0]
    f.modes[op] = 1; w.rewrites = w.rewrites + 1
    if w.immediate { w.immediates = w.immediates + 1 }; true
}
fn earlier_slot(w: &Workspace, left: i32, right: i32) -> bool {
    if w.seq[left] != w.seq[right] { return w.seq[left] < w.seq[right] }
    if w.definitions[left] != w.definitions[right] { return w.definitions[left] < w.definitions[right] }
    w.physical[left] < w.physical[right]
}
fn alias(w: &Workspace, operand: i32, ty: i32) -> i32 {
    source := index(&w, operand); if operand < 0 || source < 0 { return operand }
    mut eq := w.x[source]; if ty == 1 { eq = w.low[source] }
    if eq == bit(source) { return operand }
    if eq.bit_and(bit(w.zr)) != 0 { return -1 }
    mut best := source
    for r in 0..w.zr {
        if eq.bit_and(bit(r)) != 0 && earlier_slot(&w, r, best) { best = r }
    }
    w.physical[best]
}
fn known_constant(w: &Workspace, operand: i32, ty: i32) -> bool {
    r := index(&w, operand); if r < 0 { return false }
    if ty == 1 { w.kw[r] == 1 } else { w.kx[r] == 1 }
}
fn constant(w: &Workspace, operand: i32, ty: i32) -> i64 {
    r := index(&w, operand); assert(r >= 0); if ty == 1 { w.vw[r] } else { w.vx[r] }
}
fn masks(w: &mut Workspace) {
    w.candidate.reads[0] = mir.variable_bit(w.candidate.a[0]).bit_or(mir.variable_bit(w.candidate.b[0])).bit_or(mir.variable_bit(w.candidate.c[0]))
    w.candidate.writes[0] = mir.variable_bit(w.candidate.dst[0])
}
fn rewrite_copy(w: &mut Workspace, f: &mir.Function, op: i32) {
    dst := f.dst[op]; source := f.a[op]; ty := f.types[op]
    if dst < 0 || dst > 30 || source < -1 || source > 30 || (ty != 1 && ty != 2) { return }
    d := index(&w, dst); from := index(&w, source); if d < 0 || from < 0 { return }
    mut same := w.x[d].bit_and(bit(from)) != 0
    if ty == 1 { same = w.low[d].bit_and(bit(from)) != 0 && w.zero.bit_and(bit(d)) != 0 }
    if same { w.action = 1; return }
    selected := alias(&w, source, ty); if selected == source { return }
    candidate_from(&mut w, &f, op); w.candidate.a[0] = selected; masks(&mut w)
    w.action = 2
}
fn rewrite_constant(w: &mut Workspace, f: &mir.Function, op: i32) {
    dst := f.dst[op]; ty := f.types[op]; if dst < 0 || dst > 30 || (ty != 1 && ty != 2) { return }
    mut value := f.imm[op]; if ty == 1 { value = value.bit_and(4294967295) }
    d := index(&w, dst); if d < 0 { return }
    if w.kx[d] == 1 && w.vx[d] == value { w.action = 1; return }
    mut best := -2; mut best_slot := -1
    if known_constant(&w, -1, ty) && constant(&w, -1, ty) == value { best = -1 }
    if best == -2 { for slot in 0..w.zr {
        source := w.physical[slot]
        if source == dst || !known_constant(&w, source, ty) || constant(&w, source, ty) != value { continue }
        if best_slot < 0 || earlier_slot(&w, slot, best_slot) { best = source; best_slot = slot }
    } }
    if best == -2 { return }
    candidate_from(&mut w, &f, op)
    w.candidate.kinds[0] = 2; w.candidate.opcodes[0] = 0; w.candidate.a[0] = best
    w.candidate.b[0] = -1; w.candidate.c[0] = -1; w.candidate.imm[0] = 0; w.candidate.aux[0] = 0
    masks(&mut w); w.action = 2
}
fn rewrite_scalar(w: &mut Workspace, f: &mir.Function, op: i32) {
    if !scalar.can_emit(&f, op) { return }
    ty := f.types[op]
    na := alias(&w, f.a[op], ty); nb := alias(&w, f.b[op], ty); nc := alias(&w, f.c[op], ty)
    opcode := f.opcodes[op]
    try_imm := (opcode == 1 || opcode == 2) && f.imm[op] == 0 && f.aux[op] == 0 && known_constant(&w, f.b[op], ty)
    if na == f.a[op] && nb == f.b[op] && nc == f.c[op] && !try_imm { return }
    candidate_from(&mut w, &f, op)
    w.candidate.a[0] = na; w.candidate.b[0] = nb; w.candidate.c[0] = nc
    masks(&mut w); mut immediate := false
    if try_imm {
        value := constant(&w, f.b[op], ty)
        if value > 0 {
            saved := w.candidate.b[0]; w.candidate.b[0] = -1; w.candidate.imm[0] = value; masks(&mut w)
            if scalar.can_emit(&w.candidate, 0) { immediate = true }
            else { w.candidate.b[0] = saved; w.candidate.imm[0] = f.imm[op]; masks(&mut w) }
        }
    }
    if w.candidate.a[0] == f.a[op] && w.candidate.b[0] == f.b[op] && w.candidate.c[0] == f.c[op] &&
        w.candidate.imm[0] == f.imm[op] { return }
    w.action = 2; w.immediate = immediate
}
fn replay(w: &mut Workspace, f: &mut mir.Function) -> bool {
    if !charge(&mut w, f.kinds.len * (w.physical.len * 10 + 192) + f.block_starts.len * (w.physical.len * 6 + 2)) { return false }
    for b in 0..f.block_starts.len {
        if !w.reached[b] { continue }; load_in(&mut w, b)
        for position in f.block_starts[b]..f.block_ends[b] {
            op := f.order[position]; if f.modes[op] == 2 { continue }
            w.action = 0; w.immediate = false
            if f.kinds[op] == 1 { rewrite_constant(&mut w, &f, op) }
            else if f.kinds[op] == 2 { rewrite_copy(&mut w, &f, op) }
            else if scalar.handles(f.kinds[op]) { rewrite_scalar(&mut w, &f, op) }
            transfer(&mut w, &f, op)
            if !commit_prepared(&mut w, &mut f, op) { return false }
        }
    }
    true
}
fn pure_materialization(f: &mir.Function, op: i32) -> bool {
    (f.kinds[op] == 1 || f.kinds[op] == 2 || (f.kinds[op] == 3 && f.opcodes[op] == 3 && scalar.can_emit(&f, op))) &&
        f.effects[op] == 0 && f.flags[op] == 0 && f.abi[op] == 0 &&
        f.clobbers[op] == 0 && f.dst[op] >= -1 && f.dst[op] <= 30 &&
        f.writes[op] == mir.variable_bit(f.dst[op]) && f.place[op] == -1 && f.reloc_kinds[op] == -1 && f.import_ids[op] == -1
}
fn check_staged(w: &mut Workspace, f: &mut mir.Function) -> bool {
    if f.verified { return true }
    if !charge(&mut w, f.kinds.len * 100 + f.raw.len) { return false }
    w.verifications = w.verifications + 1
    if !verify.verify_into(&mut f, &mut w.verifier) { w.state = -1; return false }
    if !f.optimizable { w.state = -2; return false }; true
}
fn dead(w: &mut Workspace, f: &mut mir.Function, inputs: &call_inputs.Context) -> bool {
    source_inputs := call_inputs.source_inputs(&inputs)
    w.copy_live_after.clear(); w.copy_live_after.reserve(f.kinds.len)
    for _ in 0..f.kinds.len { w.copy_live_after.push(0) }
    mut again := true
    while again {
        again = false
        if !check_staged(&mut w, &mut f) { return false }
        if !live.analyze_blocks_with_inputs_into(&mut w.liveness, &f, &inputs, w.limit - w.work) {
            w.work = w.work + live.units(&w.liveness); w.state = live.status(&w.liveness); return false
        }
        if !charge(&mut w, live.units(&w.liveness) + f.kinds.len * 4) { return false }
        mut b := f.block_starts.len
        while b > 0 {
            b = b - 1
            if !live.reachable(&w.liveness, b) { continue }
            mut block_deleted := false
            mut needed := live.live_out(&w.liveness, b); mut position := f.block_ends[b]
            while position > f.block_starts[b] {
                position = position - 1; op := f.order[position]
                if f.modes[op] == 2 { continue }
                if pure_materialization(&f, op) && f.writes[op].bit_and(needed) == 0 {
                    assert(f.verified)
                    if !remember(&mut w, &f, op, false) { return false }
                    f.modes[op] = 2; w.deleted = w.deleted + 1; block_deleted = true; continue
                }
                if f.kinds[op] == 2 { w.copy_live_after[op] = needed }
                mut op_reads := f.reads[op]
                if source_inputs && f.kinds[op] == 14 { op_reads = call_inputs.reads(&inputs, &f, op) }
                needed = op_reads.bit_or(needed.bit_and(f.writes[op].bit_or(op_clobbers(&w, &f, op)).bit_not()))
            }
            if block_deleted && needed != live.live_in(&w.liveness, b) { again = true }
        }
    }
    true
}
fn coalesceable_def(f: &mir.Function, op: i32) -> bool {
    if frame_role(&f, op) || f.effects[op] != 0 || f.abi[op] != 0 || f.clobbers[op] != 0 ||
        f.place[op] != -1 || f.extensions[op] != 0 || f.targets[op] != -1 ||
        f.reloc_kinds[op] != -1 || f.import_ids[op] != -1 { return false }
    dst := f.dst[op]
    if dst < 0 || dst > 30 || (f.types[op] != 1 && f.types[op] != 2) ||
        f.writes[op] != mir.variable_bit(dst) { return false }
    kind := f.kinds[op]
    if kind == 1 { return f.opcodes[op] == 0 }
    if kind == 4 || kind == 6 { return scalar.can_emit(&f, op) }
    kind == 3 && (f.opcodes[op] == 1 || f.opcodes[op] == 2) && scalar.can_emit(&f, op)
}
fn coalesce(w: &mut Workspace, f: &mut mir.Function) -> bool {
    if live.status(&w.liveness) != 1 { return true }
    for b in 0..f.block_starts.len {
        if !live.reachable(&w.liveness, b) { continue }
        mut prev := -1
        for position in f.block_starts[b]..f.block_ends[b] {
            op := f.order[position]
            if f.modes[op] == 2 { continue }
            if prev >= 0 && f.kinds[op] == 2 && f.opcodes[op] == 0 && f.types[op] == f.types[prev] &&
                f.a[op] == f.dst[prev] && f.dst[op] >= 0 && f.dst[op] <= 30 && f.dst[op] != f.dst[prev] &&
                !frame_role(&f, op) && pure_materialization(&f, op) &&
                w.copy_live_after[op].bit_and(mir.variable_bit(f.dst[prev])) == 0 &&
                coalesceable_def(&f, prev) {
                candidate_from(&mut w, &f, prev)
                w.candidate.dst[0] = f.dst[op]
                w.candidate.writes[0] = mir.variable_bit(f.dst[op])
                if core.canonical(&w.candidate, 0) {
                    if !remember(&mut w, &f, prev, true) || !remember(&mut w, &f, op, false) { return false }
                    f.verified = false
                    f.dst[prev] = w.candidate.dst[0]
                    f.writes[prev] = w.candidate.writes[0]
                    f.modes[prev] = 1
                    f.modes[op] = 2
                    w.rewrites = w.rewrites + 1
                    w.deleted = w.deleted + 1
                    prev = -1
                    continue
                }
            }
            prev = op
        }
    }
    true
}
fn begin(w: &mut Workspace, f: &mir.Function, labels: &[]i32, epoch: i32, limit: i32) -> bool {
    reset(&mut w, limit)
    w.before_verified = f.verified; w.before_optimizable = f.optimizable
    if epoch < 0 || epoch > 1 { w.state = -1; return false }
    if !f.valid || !f.verified { w.state = -1; return false }
    if !f.optimizable || f.unknown_control { w.state = -2; return false }
    n := f.kinds.len; blocks := f.block_starts.len
    if limit < 0 || n > 65536 || blocks > 16384 || f.edge_to.len > 32768 { w.state = -3; return false }
    if blocks == 0 { return false }
    if !charge(&mut w, n) { return false }; mut candidates := false
    for op in 0..n { if f.modes[op] != 2 && (f.kinds[op] == 1 || f.kinds[op] == 2 || (f.kinds[op] == 3 && f.opcodes[op] == 3)) { candidates = true } }
    if !candidates { return false }
    if !contracted_exits(&mut w, &f, &labels, epoch) { return false }
    domain(&mut w, &f) && graph(&mut w, &f) && solve(&mut w, &f)
}
fn finish(w: &mut Workspace, f: &mut mir.Function, inputs: &call_inputs.Context) -> bool {
    if !replay(&mut w, &mut f) || !check_staged(&mut w, &mut f) || !dead(&mut w, &mut f, &inputs) ||
        !coalesce(&mut w, &mut f) {
        rollback(&mut w, &mut f); return false
    }
    if w.undo_ops.len == 0 { w.state = 0; return false }
    if !charge(&mut w, f.kinds.len * 100 + f.raw.len) {
        rollback(&mut w, &mut f); return false
    }
    w.verifications = w.verifications + 1
    if !verify.verify_into(&mut f, &mut w.verifier) {
        w.state = -1; rollback(&mut w, &mut f); return false
    }
    if !f.optimizable { w.state = -2; rollback(&mut w, &mut f); return false }
    assert(f.verified); w.state = 2; true
}
fn is_multi_word_constant(f: &mir.Function, op: i32) -> bool {
    f.modes[op] != 2 && f.kinds[op] == 1 && f.opcodes[op] == 0 &&
        !(f.imm[op] >= -65536 && f.imm[op] <= 65535) &&
        f.dst[op] >= 0 && f.dst[op] <= 30 && (f.types[op] == 1 || f.types[op] == 2) &&
        f.effects[op] == 0 && f.flags[op] == 0 && f.abi[op] == 0 && f.clobbers[op] == 0 &&
        f.place[op] == -1 && f.reloc_kinds[op] == -1 && f.import_ids[op] == -1 &&
        f.writes[op] == mir.variable_bit(f.dst[op])
}
fn const_bits(f: &mir.Function, op: i32) -> i64 {
    if f.types[op] == 1 { return f.imm[op].bit_and(4294967295) }
    f.imm[op]
}
fn set_hoisted_constant(f: &mut mir.Function, op: i32, dst: i32, val: i64, ty: i32, origin: i32, block: i32) {
    f.modes[op] = 1; f.raw_starts[op] = -1; f.widths[op] = 0; f.recipes[op] = 0
    f.kinds[op] = 1; f.opcodes[op] = 0; f.dst[op] = dst; f.a[op] = -1; f.b[op] = -1; f.c[op] = -1
    f.imm[op] = val; f.aux[op] = 0; f.variant[op] = 0; f.types[op] = ty; f.place[op] = -1; f.extensions[op] = 0
    f.effects[op] = 0; f.flags[op] = 0; f.abi[op] = 0
    f.reads[op] = 0; f.writes[op] = mir.variable_bit(dst); f.clobbers[op] = 0
    f.targets[op] = -1; f.reloc_kinds[op] = -1; f.import_ids[op] = -1
    f.origins[op] = origin; f.op_blocks[op] = block
}
fn rewrite_constant_to_copy(f: &mut mir.Function, op: i32, scratch: i32) {
    f.modes[op] = 1; f.raw_starts[op] = -1; f.widths[op] = 0; f.recipes[op] = 0
    f.kinds[op] = 2; f.opcodes[op] = 0; f.a[op] = scratch; f.b[op] = -1; f.c[op] = -1
    f.imm[op] = 0; f.aux[op] = 0; f.variant[op] = 0
    f.reads[op] = mir.variable_bit(scratch); f.writes[op] = mir.variable_bit(f.dst[op]); f.clobbers[op] = 0
    f.effects[op] = 0; f.flags[op] = 0; f.abi[op] = 0
    f.place[op] = -1; f.extensions[op] = 0
    f.targets[op] = -1; f.reloc_kinds[op] = -1; f.import_ids[op] = -1
}
fn save_rewritten_op(f: &mir.Function, op: i32, rows: &mut []i64) {
    rows.push(i64(f.modes[op])); rows.push(i64(f.raw_starts[op])); rows.push(i64(f.widths[op])); rows.push(i64(f.recipes[op]))
    rows.push(i64(f.kinds[op])); rows.push(i64(f.opcodes[op])); rows.push(i64(f.a[op])); rows.push(i64(f.b[op])); rows.push(i64(f.c[op]))
    rows.push(f.imm[op]); rows.push(i64(f.aux[op])); rows.push(f.variant[op])
    rows.push(f.reads[op]); rows.push(f.writes[op]); rows.push(f.clobbers[op])
    rows.push(i64(f.effects[op])); rows.push(i64(f.flags[op])); rows.push(i64(f.abi[op]))
    rows.push(i64(f.place[op])); rows.push(i64(f.extensions[op]))
    rows.push(i64(f.targets[op])); rows.push(i64(f.reloc_kinds[op])); rows.push(i64(f.import_ids[op]))
}
fn restore_rewritten_op(f: &mut mir.Function, op: i32, rows: &[]i64, index: i32) {
    base := index * 23
    f.modes[op] = i32(rows[base]); f.raw_starts[op] = i32(rows[base + 1]); f.widths[op] = i32(rows[base + 2]); f.recipes[op] = i32(rows[base + 3])
    f.kinds[op] = i32(rows[base + 4]); f.opcodes[op] = i32(rows[base + 5]); f.a[op] = i32(rows[base + 6]); f.b[op] = i32(rows[base + 7]); f.c[op] = i32(rows[base + 8])
    f.imm[op] = rows[base + 9]; f.aux[op] = i32(rows[base + 10]); f.variant[op] = rows[base + 11]
    f.reads[op] = rows[base + 12]; f.writes[op] = rows[base + 13]; f.clobbers[op] = rows[base + 14]
    f.effects[op] = i32(rows[base + 15]); f.flags[op] = i32(rows[base + 16]); f.abi[op] = i32(rows[base + 17])
    f.place[op] = i32(rows[base + 18]); f.extensions[op] = i32(rows[base + 19])
    f.targets[op] = i32(rows[base + 20]); f.reloc_kinds[op] = i32(rows[base + 21]); f.import_ids[op] = i32(rows[base + 22])
}
fn pop_added_ops(f: &mut mir.Function, old_n: i32) {
    while f.kinds.len > old_n {
        _ := f.kinds.pop(); _ := f.opcodes.pop(); _ := f.dst.pop()
        _ := f.a.pop(); _ := f.b.pop(); _ := f.c.pop()
        _ := f.imm.pop(); _ := f.aux.pop(); _ := f.variant.pop()
        _ := f.types.pop(); _ := f.place.pop(); _ := f.extensions.pop()
        _ := f.effects.pop(); _ := f.flags.pop(); _ := f.abi.pop()
        _ := f.reads.pop(); _ := f.writes.pop(); _ := f.clobbers.pop()
        _ := f.origins.pop(); _ := f.raw_starts.pop(); _ := f.widths.pop()
        _ := f.modes.pop(); _ := f.recipes.pop(); _ := f.targets.pop()
        _ := f.reloc_kinds.pop(); _ := f.import_ids.pop(); _ := f.op_blocks.pop()
        _ := f.stack_roles.pop()
    }
}
fn declared_exit_in_labels(f: &mir.Function, block: i32, labels: &[]i32, epoch: i32) -> bool {
    if epoch != 1 { return false }
    mut last := -1
    for position in f.block_starts[block]..f.block_ends[block] {
        op := f.order[position]; if f.modes[op] != 2 { last = op }
    }
    if last < 0 || (f.kinds[last] != 12 && f.kinds[last] != 13) { return false }
    target := f.targets[last]; mut first := 0; mut end := labels.len
    while first < end {
        middle := first + (end - first) / 2
        if labels[middle] < target { first = middle + 1 } else { end = middle }
    }
    first < labels.len && labels[first] == target
}
fn collect_scc_info(lv: &live.Workspace, f: &mir.Function, comp: i32,
    block_hoist_mask: &[]i64, labels: &[]i32, epoch: i32,
    cand_ops: &mut []i32, loop_blocks: &mut []i32, header_out: &mut i32, pre_out: &mut i32,
    used_mask_out: &mut i64) -> bool {
    cand_ops.clear(); loop_blocks.clear()
    mut h := -1; mut pre := -1; mut loop_regs: i64 = 0; mut exit_live_ins: i64 = 0
    for b in 0..f.block_starts.len {
        if !live.reachable(&lv, b) || live.component(&lv, b) != comp { continue }
        loop_blocks.push(b)
        pc := live.pred_count(&lv, b)
        for pi in 0..pc {
            p := live.pred_at(&lv, b, pi)
            if live.component(&lv, p) != comp {
                if h >= 0 && h != b { return false }
                if pre >= 0 { return false }
                h = b; pre = p
            }
        }
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]
            if to < 0 {
                if f.edge_kinds[e] == 2 {
                    if !declared_exit_in_labels(&f, b, &labels, epoch) { return false }
                } else if f.edge_kinds[e] != 3 { return false }
            } else if live.component(&lv, to) != comp {
                exit_live_ins = exit_live_ins.bit_or(live.live_in(&lv, to))
            }
        }
        loop_regs = loop_regs.bit_or(live.live_in(&lv, b)).bit_or(live.live_out(&lv, b)).bit_or(block_hoist_mask[b])
        for pos in f.block_starts[b]..f.block_ends[b] {
            op := f.order[pos]
            if f.modes[op] == 2 { continue }
            if f.kinds[op] == 14 || f.kinds[op] == 0 { return false }
            loop_regs = loop_regs.bit_or(f.reads[op]).bit_or(f.writes[op]).bit_or(f.clobbers[op])
            if is_multi_word_constant(&f, op) { cand_ops.push(op) }
        }
    }
    if cand_ops.len == 0 || h < 0 || pre < 0 { return false }
    if f.edge_starts[pre + 1] - f.edge_starts[pre] != 1 { return false }
    pe := f.edge_starts[pre]
    if f.edge_to[pe] != h || (f.edge_kinds[pe] != 0 && f.edge_kinds[pe] != 1) { return false }
    mut last := -1
    for pos in f.block_starts[pre]..f.block_ends[pre] {
        op := f.order[pos]; if f.modes[op] != 2 { last = op }
    }
    if last >= 0 {
        if f.kinds[last] == 13 || f.kinds[last] == 15 { return false }
        if f.edge_kinds[pe] == 1 && f.kinds[last] != 12 { return false }
        if f.kinds[last] == 12 && f.reads[last] != 0 { return false }
    } else if f.edge_kinds[pe] == 1 { return false }
    header_out = h; pre_out = pre
    used_mask_out = live.live_out(&lv, pre).bit_or(block_hoist_mask[pre]).bit_or(loop_regs).bit_or(exit_live_ins)
    true
}
fn hoist_loop_constants(w: &mut Workspace, f: &mut mir.Function, inputs: &call_inputs.Context,
    labels: &[]i32, epoch: i32, limit: i32) -> bool {
    if !call_inputs.source_inputs(&inputs) || f.block_starts.len <= 1 || f.kinds.len >= 65000 { return false }
    if epoch < 0 || epoch > 1 || limit < 0 || !f.valid || !f.verified || !f.optimizable || f.unknown_control { return false }
    mut has_multi := false
    for op in 0..f.kinds.len {
        if is_multi_word_constant(&f, op) { has_multi = true; break }
    }
    if !has_multi { return false }
    reset(&mut w, limit)
    if !contracted_exits(&mut w, &f, &labels, epoch) { return false }
    if !live.analyze_blocks_with_inputs_into(&mut w.liveness, &f, &inputs, limit) { return false }
    if live.status(&w.liveness) != 1 { return false }

    blocks := f.block_starts.len
    mut block_hoist_mask: []i64 = []
    for _ in 0..blocks { block_hoist_mask.push(0) }
    candidates := [5, 6, 7, 10, 11, 12, 13, 14, 15, 4]

    mut hoist_pre: []i32 = []; mut hoist_reg: []i32 = []; mut hoist_imm: []i64 = []
    mut hoist_type: []i32 = []; mut hoist_origin: []i32 = []
    mut rewrite_ops: []i32 = []; mut rewrite_regs: []i32 = []
    mut cand_ops: []i32 = []; mut loop_blocks: []i32 = []; mut free_regs: []i32 = []

    for seed in 0..blocks {
        if !live.reachable(&w.liveness, seed) || !live.loop_block(&w.liveness, seed) { continue }
        comp := live.component(&w.liveness, seed)
        mut first := true
        for prev in 0..seed {
            if live.reachable(&w.liveness, prev) && live.loop_block(&w.liveness, prev) && live.component(&w.liveness, prev) == comp {
                first = false; break
            }
        }
        if !first { continue }
        mut h := -1; mut pre := -1; mut used_mask: i64 = 0
        if !collect_scc_info(&w.liveness, &f, comp, &block_hoist_mask, &labels, epoch,
            &mut cand_ops, &mut loop_blocks, &mut h, &mut pre, &mut used_mask) {
            continue
        }
        free_regs.clear()
        for idx in 0..candidates.len {
            r := candidates[idx]
            if used_mask.bit_and(mir.variable_bit(r)) == 0 {
                free_regs.push(r)
                if free_regs.len >= cand_ops.len { break }
            }
        }
        if free_regs.len == 0 { continue }

        local_start := hoist_pre.len; mut next_reg := 0
        for ci in 0..cand_ops.len {
            op := cand_ops[ci]; val := const_bits(&f, op); ty := f.types[op]
            mut assigned := -1
            for k in local_start..hoist_pre.len {
                if hoist_imm[k] == val && hoist_type[k] == ty { assigned = hoist_reg[k]; break }
            }
            if assigned < 0 && next_reg < free_regs.len && f.kinds.len + hoist_pre.len + 1 <= 65536 {
                assigned = free_regs[next_reg]; next_reg = next_reg + 1
                hoist_pre.push(pre); hoist_reg.push(assigned); hoist_imm.push(val); hoist_type.push(ty); hoist_origin.push(f.origins[op])
                rbit := mir.variable_bit(assigned)
                block_hoist_mask[pre] = block_hoist_mask[pre].bit_or(rbit)
                for li in 0..loop_blocks.len {
                    lb := loop_blocks[li]
                    block_hoist_mask[lb] = block_hoist_mask[lb].bit_or(rbit)
                }
            }
            if assigned >= 0 { rewrite_ops.push(op); rewrite_regs.push(assigned) }
        }
    }
    if hoist_pre.len == 0 || rewrite_ops.len == 0 { return false }

    saved_verified := f.verified; saved_optimizable := f.optimizable
    saved_n := f.kinds.len
    mut saved_order: []i32 = []; for i in 0..f.order.len { saved_order.push(f.order[i]) }
    mut saved_starts: []i32 = []; mut saved_ends: []i32 = []
    for b in 0..blocks { saved_starts.push(f.block_starts[b]); saved_ends.push(f.block_ends[b]) }
    mut saved_labels: []i32 = []; for l in 0..f.label_ops.len { saved_labels.push(f.label_ops[l]) }
    mut undo_rows: []i64 = []
    for ri in 0..rewrite_ops.len { save_rewritten_op(&f, rewrite_ops[ri], &mut undo_rows) }

    mut hoisted_ops: []i32 = []; mut ok := true
    for hi in 0..hoist_pre.len {
        hop := mir.add(&mut f, 1)
        set_hoisted_constant(&mut f, hop, hoist_reg[hi], hoist_imm[hi], hoist_type[hi], hoist_origin[hi], hoist_pre[hi])
        hoisted_ops.push(hop)
        if !core.canonical(&f, hop) { ok = false; break }
    }
    if ok {
        for ri in 0..rewrite_ops.len {
            op := rewrite_ops[ri]
            rewrite_constant_to_copy(&mut f, op, rewrite_regs[ri])
            if !core.canonical(&f, op) { ok = false; break }
        }
    }
    if ok {
        mut new_order: []i32 = []
        mut new_starts: []i32 = []; mut new_ends: []i32 = []
        for b in 0..blocks {
            new_starts.push(new_order.len)
            mut has_hoist := false
            for hi in 0..hoist_pre.len { if hoist_pre[hi] == b { has_hoist = true; break } }
            start := saved_starts[b]; end := saved_ends[b]
            if !has_hoist {
                for pos in start..end { new_order.push(saved_order[pos]) }
            } else {
                mut last_pos := -1
                for pos in start..end { if f.modes[saved_order[pos]] != 2 { last_pos = pos } }
                mut split := end
                if last_pos >= start && f.kinds[saved_order[last_pos]] == 12 { split = last_pos }
                for pos in start..split { new_order.push(saved_order[pos]) }
                for hi in 0..hoist_pre.len { if hoist_pre[hi] == b { new_order.push(hoisted_ops[hi]) } }
                for pos in split..end { new_order.push(saved_order[pos]) }
            }
            new_ends.push(new_order.len)
        }
        mir.swap_order(&mut f, &mut new_order)
        for b in 0..blocks { f.block_starts[b] = new_starts[b]; f.block_ends[b] = new_ends[b] }
        for l in 0..f.label_ops.len {
            old := saved_labels[l]
            if old >= 0 && old < saved_order.len {
                blk := f.op_blocks[saved_order[old]]
                if blk >= 0 && blk < blocks { f.label_ops[l] = new_starts[blk] }
            }
        }
        f.verified = false
        if !verify.verify_into(&mut f, &mut w.verifier) || !f.optimizable { ok = false }
    }
    if !ok {
        mut ri := rewrite_ops.len
        while ri > 0 {
            ri = ri - 1
            restore_rewritten_op(&mut f, rewrite_ops[ri], &undo_rows, ri)
        }
        pop_added_ops(&mut f, saved_n)
        mir.swap_order(&mut f, &mut saved_order)
        for b in 0..blocks { f.block_starts[b] = saved_starts[b]; f.block_ends[b] = saved_ends[b] }
        for l in 0..f.label_ops.len { f.label_ops[l] = saved_labels[l] }
        f.verified = saved_verified; f.optimizable = saved_optimizable
        return false
    }
    true
}
pub fn optimize_budget(w: &mut Workspace, f: &mut mir.Function, limit: i32) -> bool {
    w.source_inputs = false
    inputs := call_inputs.conservative()
    if !begin(&mut w, &f, &f.label_ids, 0, limit) { return false }; finish(&mut w, &mut f, &inputs)
}
pub fn optimize_into(w: &mut Workspace, f: &mut mir.Function) -> bool { optimize_budget(&mut w, &mut f, 4194304) }
pub fn optimize_with_context_budget(w: &mut Workspace, f: &mut mir.Function, ctx: &Context, limit: i32) -> bool {
    inputs := call_inputs.conservative()
    optimize_with_source_contracts_budget(&mut w, &mut f, &ctx, &inputs, limit)
}
pub fn optimize_with_source_contracts_budget(w: &mut Workspace, f: &mut mir.Function, ctx: &Context,
    inputs: &call_inputs.Context, limit: i32) -> bool {
    mut epoch := ctx.epoch; if !ctx.valid { epoch = -1 }
    w.source_inputs = call_inputs.source_inputs(&inputs)
    hoisted := hoist_loop_constants(&mut w, &mut f, &inputs, &ctx.labels, epoch, limit)
    if !begin(&mut w, &f, &ctx.labels, epoch, limit) {
        if hoisted && w.state == 0 { w.state = 2 }
        return hoisted
    }
    if finish(&mut w, &mut f, &inputs) { return true }
    if hoisted {
        if w.state == 0 { w.state = 2 }
        return true
    }
    false
}
pub fn optimize_with_context(w: &mut Workspace, f: &mut mir.Function, ctx: &Context) -> bool {
    optimize_with_context_budget(&mut w, &mut f, &ctx, 4194304)
}
