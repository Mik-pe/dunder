// Host-clock boundary shared by compiler attribution and process timeouts.
// Target selection does not change the clock API of the running compiler.
capability unsafe
@extern("c","clock_gettime") unsafe fn read_clock(clock: i32, out: ptr) -> i32
@c_layout
struct Time { seconds: i64, nanos: i64 }
pub fn nanoseconds(platform: i32) -> i64 {
    unsafe {
        var now: Time = zeroed()
        var clock := 1
        if platform == 0 { clock = 6 }
        if read_clock(clock, addr(&mut now)) != 0 { return -1 }
        return now.seconds * 1000000000 + now.nanos
    }
}
