// Definite ownership of stable function-local IDs. This module tracks source
// validity only; runtime owner slots and partial-place policies belong to the
// frontend. Array columns are copied explicitly so checkpoints never alias.
pub struct State {
    states: []i32, moves: []i32, reachable: bool,
}
// states: 0 initialized, 1 moved on every incoming path, 2 maybe moved.
// moves contains the source token responsible for an unavailable state.
pub fn new() -> State { State { states: [], moves: [], reachable: true } }
pub fn clear(s: &mut State) {
    s.states.clear(); s.moves.clear(); s.reachable = true
}
pub fn add(s: &mut State, id: i32) {
    assert(id == s.states.len && s.moves.len == s.states.len)
    s.states.push(0); s.moves.push(-1)
}
pub fn available(s: &State, id: i32) -> bool {
    assert(id >= 0 && id < s.states.len)
    s.states[id] == 0
}
pub fn moved_at(s: &State, id: i32) -> i32 {
    assert(id >= 0 && id < s.moves.len)
    s.moves[id]
}
pub fn consume(s: &mut State, id: i32, token: i32) {
    assert(id >= 0 && id < s.states.len && token >= 0)
    s.states[id] = 1; s.moves[id] = token
}
pub fn initialize(s: &mut State, id: i32) {
    assert(id >= 0 && id < s.states.len)
    s.states[id] = 0; s.moves[id] = -1
}
pub fn snapshot(s: &State) -> State {
    mut out := new()
    out.states.reserve(s.states.len); out.moves.reserve(s.moves.len)
    for i in 0..s.states.len {
        out.states.push(s.states[i]); out.moves.push(s.moves[i])
    }
    out.reachable = s.reachable
    out
}
// Local IDs are never reused after a scope ends. Restoring a predecessor
// resets later, now-inactive IDs rather than shrinking the columns.
pub fn restore(s: &mut State, saved: &State) {
    while s.states.len < saved.states.len { add(&mut s, s.states.len) }
    for i in 0..s.states.len {
        if i < saved.states.len {
            s.states[i] = saved.states[i]; s.moves[i] = saved.moves[i]
        } else { s.states[i] = 0; s.moves[i] = -1 }
    }
    s.reachable = saved.reachable
}
pub fn join(s: &mut State, left: &State, right: &State) {
    // A terminating predecessor contributes no ownership requirements to a
    // live fallthrough. If both terminate, keep checking later dead source
    // conservatively against the union, while retaining reachable=false.
    mut count := left.states.len
    if right.states.len > count { count = right.states.len }
    while s.states.len < count { add(&mut s, s.states.len) }
    if !left.reachable && right.reachable { restore(&mut s, &right); return }
    if left.reachable && !right.reachable { restore(&mut s, &left); return }
    for i in 0..s.states.len {
        if i >= left.states.len || i >= right.states.len {
            // Such IDs were introduced inside only one predecessor's scope.
            s.states[i] = 0; s.moves[i] = -1
        } else {
            l := left.states[i]; r := right.states[i]
            if l == 0 && r == 0 { s.states[i] = 0; s.moves[i] = -1 }
            else {
                s.states[i] = 2
                if l == 1 && r == 1 { s.states[i] = 1 }
                mut token := left.moves[i]
                if l == 0 { token = right.moves[i] }
                s.moves[i] = token
            }
        }
    }
    s.reachable = left.reachable || right.reachable
}
// Called on every reachable backedge, including explicit continue edges.
// A variable available before the loop must be restored before another
// iteration can reach its condition/body. New loop-local IDs are excluded.
pub fn validate_restored(s: &State, entry: &State, local_count: i32) -> i32 {
    assert(local_count >= 0 && local_count <= entry.states.len && local_count <= s.states.len)
    if !s.reachable || !entry.reachable { return -1 }
    for i in 0..local_count {
        if entry.states[i] == 0 && s.states[i] != 0 { return i }
    }
    -1
}

@test fn checkpoints_are_independent_and_restore_stable_local_ids() {
    mut s := new(); add(&mut s, 0); add(&mut s, 1)
    saved := snapshot(&s)
    consume(&mut s, 0, 7); add(&mut s, 2); consume(&mut s, 2, 9)
    assert(available(&saved, 0) && !available(&s, 0) && moved_at(&s, 0) == 7)
    restore(&mut s, &saved)
    assert(s.states.len == 3 && available(&s, 0) && available(&s, 2))
    assert(moved_at(&s, 0) == -1 && moved_at(&s, 2) == -1)
    add(&mut s, 3)
    assert(s.states.len == 4 && available(&s, 3))
    clear(&mut s); assert(s.states.len == 0 && s.moves.len == 0 && s.reachable)
    add(&mut s, 0); assert(available(&s, 0))
}
@test fn joins_require_initialization_on_every_reachable_predecessor() {
    mut base := new(); add(&mut base, 0); add(&mut base, 1)
    mut left := snapshot(&base); mut right := snapshot(&base)
    consume(&mut left, 0, 10)
    join(&mut base, &left, &right)
    assert(!available(&base, 0) && base.states[0] == 2 && moved_at(&base, 0) == 10)
    assert(available(&base, 1))
    consume(&mut right, 0, 20)
    join(&mut base, &left, &right)
    assert(base.states[0] == 1 && moved_at(&base, 0) == 10)
    initialize(&mut left, 0); initialize(&mut right, 0)
    join(&mut base, &left, &right)
    assert(available(&base, 0) && moved_at(&base, 0) == -1)
}
@test fn terminated_paths_do_not_contaminate_live_fallthrough() {
    mut base := new(); add(&mut base, 0)
    mut left := snapshot(&base); mut right := snapshot(&base)
    consume(&mut left, 0, 31); add(&mut left, 1); left.reachable = false
    join(&mut base, &left, &right)
    assert(base.reachable && available(&base, 0) && base.states.len == 2)
    assert(available(&base, 1))
    join(&mut base, &right, &left)
    assert(base.reachable && available(&base, 0))
    right.reachable = false
    join(&mut base, &left, &right)
    assert(!base.reachable && !available(&base, 0) && moved_at(&base, 0) == 31)
    // Dead source remains conservatively checked by available().
    assert(!available(&left, 0))
}
@test fn branch_only_ids_remain_stable_and_inactive_after_join() {
    mut base := new(); add(&mut base, 0)
    mut left := snapshot(&base); mut right := snapshot(&base)
    add(&mut left, 1); consume(&mut left, 1, 44)
    join(&mut base, &left, &right)
    assert(base.states.len == 2 && available(&base, 0) && available(&base, 1))
    assert(moved_at(&base, 1) == -1)
    add(&mut base, 2); assert(base.states.len == 3)
}
@test fn loop_backedges_require_restoration_and_ignore_new_locals() {
    mut s := new(); add(&mut s, 0); add(&mut s, 1)
    consume(&mut s, 1, 50)
    entry := snapshot(&s)
    consume(&mut s, 0, 51)
    assert(validate_restored(&s, &entry, 2) == 0)
    initialize(&mut s, 0); add(&mut s, 2); consume(&mut s, 2, 52)
    assert(validate_restored(&s, &entry, 2) == -1)
    consume(&mut s, 0, 53); s.reachable = false
    assert(validate_restored(&s, &entry, 2) == -1)
}
