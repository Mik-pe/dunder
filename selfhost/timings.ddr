// Driver-level wall-clock phases. The compiler call is an aggregate that includes
// semantic checks, code generation, target lowering and symbolic fixups. These
// measurements exclude CLI parsing and executing the built program/test suite.
// For apps, publication also includes resource sealing and bundle signing.
import cli
import sys
import compiler_profile as profile

pub struct Inlining {
    enabled: bool, entries: i32, nodes: i32, tokens: i32, units: i32,
    calls: i32, words: i32, estimated_words: i32,
}
pub fn inlining() -> Inlining { Inlining { enabled: false, entries: 0, nodes: 0,
    tokens: 0, units: 0, calls: 0, words: 0, estimated_words: 0 } }
pub struct Backend { enabled: bool, functions: i32, operations: i32, opaque: i32 }
pub fn backend() -> Backend { Backend { enabled: false, functions: 0, operations: 0, opaque: 0 } }
fn backend_json(data: &Backend) -> string {
    ",\"mir\":{\"enabled\":" + data.enabled.str() + ",\"functions\":" + data.functions.str() +
    ",\"operations\":" + data.operations.str() + ",\"opaque\":" + data.opaque.str() + "}"
}
fn inline_json(data: &Inlining) -> string {
    ",\"inlining\":{\"enabled\":" + data.enabled.str() + ",\"entries\":" + data.entries.str() +
    ",\"nodes\":" + data.nodes.str() + ",\"tokens\":" + data.tokens.str() + ",\"units\":" + data.units.str() +
    ",\"calls\":" + data.calls.str() + ",\"words\":" + data.words.str() + ",\"estimated_words\":" + data.estimated_words.str() + "}"
}

fn duration(first: i64, last: i64) -> string {
    if first < 0 || last < first { return "null" }
    (last - first).str()
}
fn milliseconds(first: i64, last: i64) -> string {
    if first < 0 || last < first { return "unavailable" }
    micros := (last - first) / 1000
    fraction := (micros % 1000).str()
    var padding := ""
    if fraction.len < 3 { padding = "0" }
    if fraction.len < 2 { padding = "00" }
    (micros / 1000).str() + "." + padding + fraction + " ms"
}
pub fn report(json: bool, checking: bool, target: i32, modules: i32, reused: i32, emitted: i32,
    started: i64, loaded: i64, setup: i64, compiled: i64, image: i64, published: i64) {
    report_optimizer(json,checking,target,modules,reused,emitted,started,loaded,setup,compiled,image,published,false,0,0,0,0,0)
}
pub fn report_optimizer(json: bool, checking: bool, target: i32, modules: i32, reused: i32, emitted: i32,
    started: i64, loaded: i64, setup: i64, compiled: i64, image: i64, published: i64,
    enabled: bool, modeled: i32, optimized: i32, rewrites: i32, bounds: i32, fallbacks: i32) {
    details := profile.new(-1)
    report_profiled(json,checking,target,modules,reused,emitted,started,loaded,setup,compiled,image,published,enabled,modeled,optimized,rewrites,bounds,fallbacks,&details)
}
pub fn report_profiled(json: bool, checking: bool, target: i32, modules: i32, reused: i32, emitted: i32,
    started: i64, loaded: i64, setup: i64, compiled: i64, image: i64, published: i64,
    enabled: bool, modeled: i32, optimized: i32, rewrites: i32, bounds: i32, fallbacks: i32, details: &profile.Profile) {
    none := inlining()
    report_profiled_inlining(json, checking, target, modules, reused, emitted, started, loaded, setup, compiled, image, published,
        enabled, modeled, optimized, rewrites, bounds, fallbacks, &details, &none)
}
pub fn report_profiled_inlining(json: bool, checking: bool, target: i32, modules: i32, reused: i32, emitted: i32,
    started: i64, loaded: i64, setup: i64, compiled: i64, image: i64, published: i64,
    enabled: bool, modeled: i32, optimized: i32, rewrites: i32, bounds: i32, fallbacks: i32, details: &profile.Profile, inline_data: &Inlining) {
    none := backend()
    report_profiled_backend(json, checking, target, modules, reused, emitted, started, loaded, setup, compiled, image, published,
        enabled, modeled, optimized, rewrites, bounds, fallbacks, &details, &inline_data, &none)
}
pub fn report_profiled_backend(json: bool, checking: bool, target: i32, modules: i32, reused: i32, emitted: i32,
    started: i64, loaded: i64, setup: i64, compiled: i64, image: i64, published: i64,
    enabled: bool, modeled: i32, optimized: i32, rewrites: i32, bounds: i32, fallbacks: i32, details: &profile.Profile, inline_data: &Inlining, backend_data: &Backend) {
    valid := started >= 0 && loaded >= started && setup >= loaded && compiled >= setup && image >= compiled && published >= image
    if json {
        var operation := "build"
        if checking { operation = "check" }
        var skipped := "[]"
        if checking { skipped = "[\"image_format_sign\",\"publication\"]" }
        var clock_ok := "false"
        if valid { clock_ok = "true" }
        var detail := ""
        if details.enabled {
            var compiler_ns: i64 = -1
            if compiled >= setup && setup >= 0 { compiler_ns = compiled - setup }
            detail = ",\"compiler_detail\":" + profile.json(&details, compiler_ns)
        }
        output := "{\"kind\":\"timings\",\"version\":1,\"operation\":\"" + operation + "\",\"scope\":\"compiler_pipeline\",\"clock\":\"monotonic\",\"clock_ok\":" + clock_ok +
            ",\"unit\":\"ns\",\"target\":\"" + cli.target_name(target) + "\",\"modules\":" + modules.str() +
            ",\"functions\":{\"reused\":" + reused.str() + ",\"emitted\":" + emitted.str() + "},\"phases\":{" +
            "\"module_load_lex_resolve\":" + duration(started, loaded) + ",\"build_setup\":" + duration(loaded, setup) +
            ",\"compiler\":" + duration(setup, compiled) + ",\"image_format_sign\":" + duration(compiled, image) +
            ",\"publication\":" + duration(image, published) + "},\"skipped_phases\":" + skipped + ",\"total\":" + duration(started, published) +
            ",\"optimizer\":{\"enabled\":" + enabled.str() + ",\"modeled\":" + modeled.str() + ",\"emitted\":" + optimized.str() +
            ",\"rewrites\":" + rewrites.str() + ",\"proven_bounds\":" + bounds.str() + ",\"fallbacks\":" + fallbacks.str() + "}" + inline_json(&inline_data) + backend_json(&backend_data) + detail + "}"
        written := sys.eprint(output)
        return
    }
    counts := sys.eprint("functions " + reused.str() + " reused, " + emitted.str() + " emitted")
    if enabled { detail := sys.eprint("scalar optimizer " + modeled.str() + " modeled, " + optimized.str() + " emitted, " + rewrites.str() + " rewrites, " + bounds.str() + " proven bounds, " + fallbacks.str() + " fallbacks") }
    if inline_data.enabled {
        inline_line := sys.eprint("inline optimizer " + inline_data.entries.str() + " entries, " + inline_data.calls.str() +
            " calls, " + inline_data.words.str() + " emitted words, " + inline_data.estimated_words.str() + " charged words")
    }
    if backend_data.enabled {
        backend_line := sys.eprint("MIR " + backend_data.functions.str() + " functions, " + backend_data.operations.str() + " operations, " + backend_data.opaque.str() + " opaque barriers")
    }
    if !valid {
        unavailable := sys.eprint("timings unavailable: monotonic clock failed or moved backwards")
        return
    }
    output := "timings module_load_lex_resolve=" + milliseconds(started, loaded) +
        " build_setup=" + milliseconds(loaded, setup) + " compiler=" + milliseconds(setup, compiled) +
        " image_format_sign=" + milliseconds(compiled, image) + " publication=" + milliseconds(image, published) +
        " total=" + milliseconds(started, published)
    written := sys.eprint(output)
    if details.enabled {
        for phase in 0..details.elapsed.len {
            var elapsed := "unavailable"
            if details.clock_ok { elapsed = milliseconds(0, details.elapsed[phase]) }
            line := sys.eprint("compiler " + profile.phase_name(phase) + "=" + elapsed + " calls=" + details.calls[phase].str() + " work=" + details.work[phase].str())
        }
    }
}
