import arm64 as arm
import place_operation as place

// Shared by unoptimized target emission and the verified worker backend.
pub fn lower(code: &mut arm.Code, k: i32, form: i32, parameter: i32) {
    if k == place.tag(.Field) {
        if parameter < 4096 { arm.emit(&mut code, 2432696320 + i64(parameter) * 1024) }
        else { arm.imm(&mut code, 2, i64(parameter)); arm.emit(&mut code, 2332164096) }
    } else if k == place.tag(.CheckIndex) {
        // Immutable text has its length at offset zero; collection descriptors at eight.
        arm.emit(&mut code, 4181721122 + i64(form) * 1024); arm.emit(&mut code, 3942776863)
    } else if k == place.tag(.Element) {
        if form == 0 { arm.emit(&mut code, 2332033056); arm.emit(&mut code, 2432704512) }
        else {
            arm.emit(&mut code, 4181721121)
            if form == 1 { arm.emit(&mut code, 2332033056 + i64(parameter) * 1024) }
            else { arm.imm(&mut code, 2, i64(parameter)); arm.emit(&mut code, 2600600576) }
        }
    } else if k == place.tag(.Read) || k == place.tag(.Write) {
        var opcode: i64 = 4177526784
        if form == 0 { opcode = 956301312 } else if form == 1 { opcode = 2030043136 }
        else if form == 2 || form == 4 { opcode = 3103784960 }
        if k == place.tag(.Read) { opcode = opcode + 4194304; if form == 4 { opcode = 3112173568 } }
        arm.emit(&mut code, opcode + i64(parameter))
    } else if k == place.tag(.BorrowHome) { arm.address(&mut code, parameter) }
    else if k == place.tag(.BorrowSaved) { arm.load(&mut code, parameter) }
    else if k == place.tag(.LocalRead) { arm.read_local(&mut code, parameter, form) }
    else if k == place.tag(.LocalWrite) { arm.store(&mut code, parameter, 0) }
    // An inline payload is already addressed in x0.
}
pub fn emit(code: &mut arm.Code, op: place.Op, ty: i32, access: i32, form: i32, parameter: i32, source: i32) {
    if code.mir_capture {
        code.words.push(place.header(op, ty, access, form))
        code.words.push(place.location(parameter, source))
    } else { lower(&mut code, place.tag(op), form, parameter) }
}
