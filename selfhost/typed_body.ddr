// The body checker records resolved values and statement edges here. A target
// pass may stop recording when its work budget or operation coverage ends.
import opt_ir as ir
import function_locals as locals

pub fn begin(b: &mut ir.Function, result: i32, params: i32) {
    ir.reset(&mut b)
    b.probing = true; b.recording = true; b.params = params; b.ret = result
    b.value = -1; b.array = -1; b.heights.clear()
}
pub fn local(b: &mut ir.Function, table: &locals.Table, id: i32, ty: i32, param: i32) {
    if !b.recording { return }
    if ty < 1 || (ty > 3 && !ir.array_type(ty)) || id >= 256 {
        b.recording = false; return
    }
    assert(b.local_types.len == id)
    b.local_names.push(table.names[id]); b.local_types.push(ty); b.local_mutable.push(table.mutable[id])
    b.local_param.push(param); b.local_at.push(table.tokens[id])
}
pub fn node(b: &mut ir.Function, kind: i32, ty: i32, a: i32, rhs: i32, third: i32, immediate: i64, binding: i32, token: i32) -> i32 {
    if !b.recording { return -1 }
    if b.nodes.kinds.len >= 2048 { b.recording = false; b.budget_exhausted = true; return -1 }
    var h := 1
    var effects := ir.own_effects(kind, immediate)
    if a >= 0 { h = b.heights[a] + 1; effects = effects.bit_or(b.nodes.effects[a]) }
    if rhs >= 0 {
        if b.heights[rhs] >= h { h = b.heights[rhs] + 1 }
        effects = effects.bit_or(b.nodes.effects[rhs])
    }
    if third >= 0 {
        if b.heights[third] >= h { h = b.heights[third] + 1 }
        effects = effects.bit_or(b.nodes.effects[third])
    }
    if h > 64 { b.recording = false; b.budget_exhausted = true; return -1 }
    id := b.nodes.kinds.len
    b.nodes.kinds.push(kind); b.nodes.types.push(ty)
    b.nodes.left.push(a); b.nodes.right.push(rhs); b.nodes.third.push(third); b.nodes.next.push(-1)
    b.nodes.values.push(immediate); b.nodes.locals.push(binding); b.nodes.starts.push(token)
    b.nodes.effects.push(effects); b.nodes.proofs.push(0); b.heights.push(h)
    b.value = id; b.array = -1; id
}
pub fn append(b: &mut ir.Function, block: i32, previous: i32) -> i32 {
    if !b.recording { return -1 }
    child := b.value
    if child < 0 || b.nodes.kinds[child] < 10 { b.recording = false; return -1 }
    if previous < 0 { b.nodes.left[block] = child } else { b.nodes.next[previous] = child }
    b.nodes.effects[block] = b.nodes.effects[block].bit_or(b.nodes.effects[child])
    child
}
pub fn read(b: &mut ir.Function, id: i32, token: i32) {
    if !b.recording { return }
    ty := b.local_types[id]
    if ir.array_type(ty) { b.array = id; b.value = -1; return }
    _ := node(&mut b, 2, ty, -1, -1, -1, 0, id, token)
}
pub fn set(b: &mut ir.Function, lhs: i32, rhs: i32, compound: i32, at: i32) {
    if !b.recording { return }
    if lhs < 0 || rhs < 0 { b.recording = false; return }
    kind := b.nodes.kinds[lhs]; local := b.nodes.locals[lhs]
    if kind == 6 && compound == 0 && ir.writable_array(b.local_types[local]) {
        b.nodes.kinds[lhs] = 18; b.nodes.types[lhs] = 0; b.nodes.right[lhs] = rhs
        b.nodes.effects[lhs] = b.nodes.effects[lhs].bit_or(b.nodes.effects[rhs]).bit_or(17)
        b.value = lhs; return
    }
    if kind != 2 { b.recording = false; return }
    if compound == 0 {
        // The resolved LHS denotes this store; no detached read survives.
        b.nodes.kinds[lhs] = 12; b.nodes.types[lhs] = 0
        b.nodes.left[lhs] = rhs; b.nodes.effects[lhs] = b.nodes.effects[rhs].bit_or(4)
        b.value = lhs; return
    }
    var value := rhs
    if compound > 0 { value = node(&mut b, 3, b.nodes.types[lhs], lhs, rhs, -1, i64(compound), -1, at) }
    _ := node(&mut b, 12, 0, value, -1, -1, 0, local, at)
}
