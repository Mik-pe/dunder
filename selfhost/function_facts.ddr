// Function-owned output of source typing. Each ID names a sealed declaration,
// source token, formal parameter or a row in this function's type arena.
pub struct Facts {
    needed: []i32, taken: []i32, effects: i64, calls: []i32, first_task: i32,
    workers: []i32, worker_tokens: []i32, factories: []i32, factory_tokens: []i32, exposed: []i32,
    forwards: []i32, indirect: []i32, literal_tokens: []i32, literal_labels: []i32,
    binding_tokens: []i32, binding_types: []i32,
}
pub fn new() -> Facts {
    Facts { needed: [], taken: [], effects: 0, calls: [], first_task: -1,
        workers: [], worker_tokens: [], factories: [], factory_tokens: [], exposed: [], forwards: [], indirect: [],
        literal_tokens: [], literal_labels: [], binding_tokens: [], binding_types: [] }
}
pub fn reset(f: &mut Facts) {
    f.needed.clear(); f.taken.clear(); f.effects = 0; f.calls.clear(); f.first_task = -1
    f.factories.clear(); f.factory_tokens.clear(); f.workers.clear(); f.worker_tokens.clear(); f.exposed.clear()
    f.forwards.clear(); f.indirect.clear(); f.literal_tokens.clear(); f.literal_labels.clear()
    f.binding_tokens.clear(); f.binding_types.clear()
}
pub fn forward(f: &mut Facts, source: i32, parameter: i32, at: i32) {
    f.forwards.push(source); f.forwards.push(parameter); f.forwards.push(at)
}
pub fn indirect(f: &mut Facts, source: i32, signature: i32, parameter: i32, at: i32) {
    f.indirect.push(source); f.indirect.push(signature); f.indirect.push(parameter); f.indirect.push(at)
}
pub fn binding(f: &mut Facts, at: i32, ty: i32) {
    f.binding_tokens.push(at); f.binding_types.push(ty)
}
