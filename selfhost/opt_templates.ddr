// Build-local memo for call-free, typed scalar bodies. Only the frontend's
// immutable resolved token stream may be used with this cache. Each session
// owns its cache, so ranges and optimizer policies never cross builds.
import lexer
import opt_ir as ir

pub opaque struct Cache {
    recent: i32, recent_length: i32,
    saved: i32, saved_length: i32, model: ir.Function,
}
pub fn new() -> Cache {
    Cache { recent: -1, recent_length: 0, saved: -1, saved_length: 0, model: ir.new() }
}
pub fn same_body(t: &lexer.Tokens, first: i32, previous: i32, length: i32) -> bool {
    for i in 0..length {
        if t.kinds[first + i] != t.kinds[previous + i] ||
            t.texts[first + i] != t.texts[previous + i] { return false }
    }
    true
}
fn same_signature(f: &ir.Function, t: &lexer.Tokens, names: &[]string, types: &[]i32,
    positions: &[]i32, ret: i32) -> bool {
    if f.ret != ret || f.params != names.len { return false }
    for p in 0..names.len {
        at := positions[p]
        if f.local_names[p] != names[p] || f.local_types[p] != types[p] ||
            at < 0 || at >= t.kinds.len || t.kinds[at] != .Name || t.texts[at] != names[p] { return false }
    }
    true
}
pub enum Decision { Miss, Admit, Reused }
// Retain one verified model. A previously unseen body only leaves its span.
pub fn probe(cache: &Cache, t: &lexer.Tokens, first: i32, last: i32,
    names: &[]string, types: &[]i32, positions: &[]i32, ret: i32) -> Decision {
    if !t.ok || first < 0 || last <= first || last >= t.kinds.len || last - first > 4096 ||
        names.len != types.len || names.len != positions.len { return .Miss }
    length := last - first + 1
    if cache.saved_length == length &&
        same_signature(&cache.model, &t, &names, &types, &positions, ret) &&
        same_body(&t, first, cache.saved, length) {
        return .Reused
    }
    if cache.recent_length == length && same_body(&t, first, cache.recent, length) { return .Admit }
    .Miss
}
pub fn observe(cache: &mut Cache, first: i32, last: i32) {
    cache.recent = first; cache.recent_length = last - first + 1
}
pub fn restore(cache: &Cache, f: &mut ir.Function, first: i32, positions: &[]i32) {
    f = cache.model
    // Preserve source locations even for detached nodes in the verified arena.
    previous := cache.saved
    for i in 0..f.nodes.starts.len { f.nodes.starts[i] = first + (f.nodes.starts[i] - previous) }
    for i in 0..f.params { f.local_at[i] = positions[i] }
    for i in f.params..f.local_at.len { f.local_at[i] = first + (f.local_at[i] - previous) }
}
pub fn save(cache: &mut Cache, f: &ir.Function, first: i32, last: i32) {
    cache.model = f
    cache.saved = first; cache.saved_length = last - first + 1
}
