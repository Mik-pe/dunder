// Closed typed call graph for worker eligibility. Effects are observations,
// not source spellings; every direct/indirect target must be recorded by the
// authoritative frontend. Incomplete bodies and unknown targets fail closed.
//
// Allowed bits:1 local read,2 local write,4 local allocation,8 fatal trap.
// Forbidden known bits:16 unsafe,32 FFI,64 static_bytes/global storage,
// 128 callback,256 ambient services,512 unknown indirect call,
// 1024 nested task scheduling,2048 incomplete body.
// ANY future/unknown bit is forbidden too. No shared mutation is implied by
// "local": that classification is valid only for a task's isolated runtime.
//
// Frontend hooks: record edges at authoritative typed invoke sites, including
// every possible indirect target or an explicit -1 unknown marker. Record
// unsafe/FFI/static-address/callback/ambient/task-schedule effects where their
// typed operations are checked. Runtime helpers require explicit local-effect
// contracts. A body is complete only after all operations and calls were
// checked. Cache hits must replay certified body/effect/edge metadata bound to
// source, dependency identities and policy, or trigger the semantic body walk.
// The workspace borrows no input and stores no full graph snapshot.
// status:1 complete,-1 malformed CSR,-2 resource/work limit,0 reset.
pub opaque struct Workspace {
    effects: []i64, bad_source: []i32, reverse_counts: []i32, starts: []i32,
    fill: []i32, callers: []i32, queue: []i32, queued: []bool,
    state: i32, work: i32, limit: i32,
}
pub fn new() -> Workspace { Workspace {
    effects: [], bad_source: [], reverse_counts: [], starts: [], fill: [], callers: [],
    queue: [], queued: [], state: 0, work: 0, limit: 0 } }
pub fn status(w: &Workspace) -> i32 { w.state }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn worker_safe(w: &Workspace, function: i32) -> bool {
    w.state == 1 && function >= 0 && function < w.effects.len && w.effects[function].bit_and(i64(15).bit_not()) == 0
}
pub fn transitive_effects(w: &Workspace, function: i32) -> i64 {
    if w.state != 1 || function < 0 || function >= w.effects.len { return -1 }; w.effects[function]
}
pub fn denied_by(w: &Workspace, function: i32) -> i32 {
    if w.state != 1 || function < 0 || function >= w.bad_source.len { return -1 }; w.bad_source[function]
}
fn charge(w: &mut Workspace, amount: i32) -> bool {
    if amount < 0 || amount > w.limit - w.work { w.state = -2; return false }
    w.work = w.work + amount; true
}
fn reset(w: &mut Workspace, limit: i32) {
    w.effects.clear(); w.bad_source.clear(); w.reverse_counts.clear(); w.starts.clear()
    w.fill.clear(); w.callers.clear(); w.queue.clear(); w.queued.clear()
    w.state = 0; w.work = 0; w.limit = limit
}
pub fn analyze_budget(w: &mut Workspace, direct: &[]i64, complete: &[]bool,
    call_starts: &[]i32, call_targets: &[]i32, limit: i32) -> bool {
    reset(&mut w, limit); n := direct.len
    if limit < 0 || n > 65536 || call_targets.len > 262144 { w.state = -2; return false }
    if complete.len != n || call_starts.len != n + 1 || call_starts[0] != 0 ||
        call_starts[n] != call_targets.len { w.state = -1; return false }
    if !charge(&mut w, n * 8 + call_targets.len * 4 + 1) { return false }
    for function in 0..n {
        first := call_starts[function]; end := call_starts[function + 1]
        if first < 0 || end < first || end > call_targets.len { w.state = -1; return false }
        var effects := direct[function]; if !complete[function] { effects = effects.bit_or(2048) }
        for edge in first..end {
            target := call_targets[edge]
            if target < -1 || target >= n { w.state = -1; return false }
            if target == -1 { effects = effects.bit_or(512) }
        }
        w.effects.push(effects); var source := -1
        if effects.bit_and(i64(15).bit_not()) != 0 { source = function }
        w.bad_source.push(source); w.reverse_counts.push(0); w.queue.push(function); w.queued.push(true)
    }
    for target in call_targets { if target >= 0 { w.reverse_counts[target] = w.reverse_counts[target] + 1 } }
    w.starts.push(0)
    for function in 0..n { w.starts.push(w.starts[function] + w.reverse_counts[function]); w.fill.push(w.starts[function]) }
    for edge in 0..w.starts[n] { w.callers.push(0) }
    for function in 0..n { for edge in call_starts[function]..call_starts[function + 1] {
        target := call_targets[edge]; if target < 0 { continue }
        at := w.fill[target]; w.callers[at] = function; w.fill[target] = at + 1
    } }
    var pending := n; var head := 0; var tail := 0
    while pending > 0 {
        if !charge(&mut w, 2) { return false }
        function := w.queue[head]; head = (head + 1) % n; pending = pending - 1; w.queued[function] = false
        for edge in w.starts[function]..w.starts[function + 1] {
            if !charge(&mut w, 4) { return false }
            caller := w.callers[edge]; joined := w.effects[caller].bit_or(w.effects[function])
            if joined == w.effects[caller] { continue }
            w.effects[caller] = joined
            if w.bad_source[caller] < 0 && w.bad_source[function] >= 0 { w.bad_source[caller] = w.bad_source[function] }
            if !w.queued[caller] {
                w.queue[tail] = caller; tail = (tail + 1) % n; pending = pending + 1; w.queued[caller] = true
            }
        }
    }
    w.state = 1; true
}
pub fn analyze_into(w: &mut Workspace, direct: &[]i64, complete: &[]bool,
    call_starts: &[]i32, call_targets: &[]i32) -> bool {
    analyze_budget(&mut w, &direct, &complete, &call_starts, &call_targets, 16777216)
}
