// Numeric trusted-producer premises, independent of source names and memory
// provenance. Version1 promises that each exact target terminates without
// observing incoming registers/flags or user-memory contents, running cleanup,
// formatting values, or invoking callbacks/user code. NoReturn alone is NOT
// this promise. The source producer proves it only for its six owned constant
// status exit tails. Raw callers assert nothing by default.
pub struct TerminalContext {
    version: i32, overflow: i32, zero: i32, assertion: i32, io: i32,
    bounds: i32, float_trap: i32,
}
pub fn policy_tag() -> string { "mir-unobserving-terminals1" }
pub fn no_terminals() -> TerminalContext { TerminalContext {
    version: 0, overflow: -1, zero: -1, assertion: -1, io: -1, bounds: -1, float_trap: -1 } }
pub fn new() -> TerminalContext { no_terminals() }
// Version0 ignores all six IDs. Version1 requires six nonnegative numeric
// targets; duplicates are harmless. Unknown versions never grant a premise.
pub fn valid(ctx: &TerminalContext) -> bool {
    ctx.version == 0 || (ctx.version == 1 && ctx.overflow >= 0 && ctx.zero >= 0 &&
        ctx.assertion >= 0 && ctx.io >= 0 && ctx.bounds >= 0 && ctx.float_trap >= 0)
}
pub fn allows(ctx: &TerminalContext, label: i32) -> bool {
    valid(&ctx) && ctx.version == 1 && label >= 0 && (label == ctx.overflow ||
        label == ctx.zero || label == ctx.assertion || label == ctx.io ||
        label == ctx.bounds || label == ctx.float_trap)
}
