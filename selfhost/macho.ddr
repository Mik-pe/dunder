import std.bytes as bytes
import imports
import std.sha256 as sha256
fn align(value: i32, alignment: i32) -> i32 { (value + alignment - 1) / alignment * alignment }
fn name(output: &mut []u8, value: string) { assert(value.len <= 16); bytes.append_utf8(&mut output, value); bytes.pad(&mut output, 16 - value.len) }
fn segment(output: &mut []u8, label: string, vm: i64, size: i64, offset: i64, file_size: i64, protection: i32, sections: i32) {
    bytes.append_le(&mut output, 25, 4); bytes.append_le(&mut output, i64(72 + 80 * sections), 4); name(&mut output, label)
    bytes.append_le(&mut output, vm, 8); bytes.append_le(&mut output, size, 8); bytes.append_le(&mut output, offset, 8); bytes.append_le(&mut output, file_size, 8)
    bytes.append_le(&mut output, i64(protection), 4); bytes.append_le(&mut output, i64(protection), 4); bytes.append_le(&mut output, i64(sections), 4); bytes.append_le(&mut output, 0, 4)
}
pub fn image(text: &[]u8) -> []u8 {
    page := 16384
    vm: i64 = 4294967296
    text_offset := 432
    text_end := text_offset + text.len
    signature_offset := align(text_end, page)
    slots := signature_offset / page
    hash_offset := 95
    directory_length := hash_offset + slots * 32
    signature_size := align(20 + directory_length, 16)
    var output: []u8 = []
    output.reserve(signature_offset + signature_size)
    header: [i64; 8] = [4277009103, 16777228, 0, 2, 7, 392, 2097157, 0]
    for value in header { bytes.append_le(&mut output, value, 4) }
    segment(&mut output, "__PAGEZERO", 0, vm, 0, 0, 0, 0)
    segment(&mut output, "__TEXT", vm, i64(signature_offset), 0, i64(text_end), 5, 1)
    name(&mut output, "__text"); name(&mut output, "__TEXT")
    bytes.append_le(&mut output, vm + i64(text_offset), 8); bytes.append_le(&mut output, i64(text.len), 8)
    section: [i64; 8] = [432, 4, 0, 0, 2147484672, 0, 0, 0]
    for value in section { bytes.append_le(&mut output, value, 4) }
    segment(&mut output, "__LINKEDIT", vm + i64(signature_offset), i64(align(signature_size, page)), i64(signature_offset), i64(signature_size), 1, 0)
    version: [i64; 6] = [50, 24, 1, 720896, 720896, 0]
    for value in version { bytes.append_le(&mut output, value, 4) }
    bytes.append_le(&mut output, 14, 4); bytes.append_le(&mut output, 32, 4); bytes.append_le(&mut output, 12, 4)
    bytes.append_utf8(&mut output, "/usr/lib/dyld"); bytes.pad(&mut output, 7)
    bytes.append_le(&mut output, 2147483688, 4); bytes.append_le(&mut output, 24, 4); bytes.append_le(&mut output, i64(text_offset), 8); bytes.append_le(&mut output, 0, 8)
    bytes.append_le(&mut output, 29, 4); bytes.append_le(&mut output, 16, 4); bytes.append_le(&mut output, i64(signature_offset), 4); bytes.append_le(&mut output, i64(signature_size), 4)
    assert(output.len == 424)
    bytes.pad(&mut output, text_offset - output.len)
    bytes.extend(&mut output, &text)
    bytes.pad(&mut output, signature_offset - output.len)
    append_signature(&mut output, signature_offset, signature_offset, signature_size)
    output
}

fn append_signature(output: &mut []u8, signature_offset: i32, executable_bytes: i32, signature_size: i32) {
    append_directory(&mut output, signature_offset, executable_bytes, signature_size, "dunder", "", "")
}

fn append_directory(output: &mut []u8, signature_offset: i32, executable_bytes: i32, signature_size: i32, identifier: string, info: string, resources: string) {
    page := 16384
    slots := signature_offset / page
    var special := 0
    if info.len > 0 { special = 3 }
    hash_offset := 88 + identifier.len + 1 + special * 32
    directory_length := hash_offset + slots * 32
    var directory: []u8 = []
    bytes.pad(&mut directory, directory_length)
    bytes.set_be(&mut directory, 0, 4208856066, 4)
    bytes.set_be(&mut directory, 4, i64(directory_length), 4)
    bytes.set_be(&mut directory, 8, 132096, 4)
    bytes.set_be(&mut directory, 12, 2, 4)
    bytes.set_be(&mut directory, 16, i64(hash_offset), 4)
    bytes.set_be(&mut directory, 20, 88, 4)
    bytes.set_be(&mut directory, 28, i64(slots), 4)
    bytes.set_be(&mut directory, 32, i64(signature_offset), 4)
    directory[36] = 32; directory[37] = 2; directory[39] = 14
    bytes.set_be(&mut directory, 72, i64(executable_bytes), 8); bytes.set_be(&mut directory, 80, 1, 8)
    bytes.set_be(&mut directory, 24, i64(special), 4)
    if special > 0 {
        info_hash := sha256.text(info)
        resource_hash := sha256.text(resources)
        for i in 0..32 {
            directory[hash_offset - 32 + i] = u8(info_hash[i])
            directory[hash_offset - 96 + i] = u8(resource_hash[i])
        }
    }
    for i in 0..identifier.len { directory[88 + i] = u8(identifier[i]) }
    for slot in 0..slots {
        digest := sha256.digest_range(&output, slot * page, page)
        for i in 0..32 { directory[hash_offset + slot * 32 + i] = digest[i] }
    }
    var signature: []u8 = []
    bytes.pad(&mut signature, 20)
    bytes.set_be(&mut signature, 0, 4208856256, 4)
    bytes.set_be(&mut signature, 4, i64(signature_size), 4)
    bytes.set_be(&mut signature, 8, 1, 4); bytes.set_be(&mut signature, 16, 20, 4)
    bytes.extend(&mut signature, &directory)
    bytes.pad(&mut signature, signature_size - signature.len)
    bytes.extend(&mut output, &signature)
}

fn section(output: &mut []u8, label: string, seg: string, offset: i32, size: i32, code: bool) {
    name(&mut output, label); name(&mut output, seg)
    bytes.append_le(&mut output, 4294967296 + i64(offset), 8)
    bytes.append_le(&mut output, i64(size), 8)
    bytes.append_le(&mut output, i64(offset), 4)
    if code {
        text: [i64; 7] = [4, 0, 0, 2147484672, 0, 0, 0]
        for field in text { bytes.append_le(&mut output, field, 4) }
    } else {
        bytes.append_le(&mut output, 3, 4); bytes.pad(&mut output, 24)
    }
}

pub fn dynamic_image(text: &[]u8, libraries: &[]string, symbols: &[]string,
                     sites: &[]i32, slots: &[]i32) -> []u8 {
    dynamic_storage(&text, &libraries, &symbols, &sites, &slots, 0)
}

pub fn dynamic_storage(text: &[]u8, libraries: &[]string, symbols: &[]string,
                       sites: &[]i32, slots: &[]i32, globals: i32) -> []u8 {
    assert(symbols.len == libraries.len)
    table := imports.libraries(&libraries, true)
    page := 16384
    var commands := 592
    for lib in table.names { commands = commands + align(25 + lib.len, 8) }
    text_off := align(32 + commands, page)
    data := align(text_off + text.len, page)
    data_len := align(symbols.len * 8, 16) + globals
    data_size := align(data_len, page)
    linkedit := data + data_size
    var binds: []u8 = [81, 114, 0]
    for i in 0..symbols.len {
        var ordinal := table.ordinals[i]
        if ordinal < 16 { binds.push(u8(16 + ordinal)) }
        else {
            binds.push(32)
            while ordinal >= 128 { binds.push(u8(128 + ordinal % 128)); ordinal = ordinal / 128 }
            binds.push(u8(ordinal))
        }
        binds.push(64); binds.push(95); bytes.append_utf8(&mut binds, symbols[i]); binds.push(0)
        binds.push(144)
    }
    binds.push(0)
    signature := align(linkedit + binds.len, page)
    sig_size := align(20 + 95 + signature / page * 32, 16)
    link_size := signature + sig_size - linkedit
    vm: i64 = 4294967296
    var out: []u8 = []
    out.reserve(signature + sig_size)
    header: [i64; 8] = [4277009103, 16777228, 0, 2, i64(9 + table.names.len), i64(commands), 2097285, 0]
    for field in header { bytes.append_le(&mut out, field, 4) }
    segment(&mut out, "__PAGEZERO", 0, vm, 0, 0, 0, 0)
    segment(&mut out, "__TEXT", vm, i64(data), 0, i64(data), 5, 1)
    section(&mut out, "__text", "__TEXT", text_off, text.len, true)
    segment(&mut out, "__DATA", vm + i64(data), i64(data_size), i64(data), i64(data_size), 3, 1)
    section(&mut out, "__data", "__DATA", data, data_len, false)
    segment(&mut out, "__LINKEDIT", vm + i64(linkedit), i64(align(link_size, page)), i64(linkedit), i64(link_size), 1, 0)
    version: [i64; 6] = [50, 24, 1, 720896, 720896, 0]
    for field in version { bytes.append_le(&mut out, field, 4) }
    bytes.append_le(&mut out, 14, 4); bytes.append_le(&mut out, 32, 4); bytes.append_le(&mut out, 12, 4)
    bytes.append_utf8(&mut out, "/usr/lib/dyld"); bytes.pad(&mut out, 7)
    bytes.append_le(&mut out, 2147483688, 4); bytes.append_le(&mut out, 24, 4); bytes.append_le(&mut out, i64(text_off), 8); bytes.append_le(&mut out, 0, 8)
    for lib in table.names {
        size := align(25 + lib.len, 8)
        cmd: [i64; 6] = [12, i64(size), 24, 0, 65536, 65536]
        for field in cmd { bytes.append_le(&mut out, field, 4) }
        bytes.append_utf8(&mut out, lib); bytes.pad(&mut out, size - 24 - lib.len)
    }
    bind: [i64; 12] = [2147483682, 48, 0, 0, i64(linkedit), i64(binds.len), 0, 0, 0, 0, 0, 0]
    for field in bind { bytes.append_le(&mut out, field, 4) }
    signing: [i64; 4] = [29, 16, i64(signature), i64(sig_size)]
    for field in signing { bytes.append_le(&mut out, field, 4) }
    assert(out.len == 32 + commands)
    bytes.pad(&mut out, text_off - out.len)
    bytes.extend(&mut out, &text)
    imports.relocate(&mut out, text_off, text.len, data, symbols.len, &sites, &slots)
    bytes.pad(&mut out, linkedit - out.len)
    bytes.extend(&mut out, &binds)
    bytes.pad(&mut out, signature - out.len)
    append_signature(&mut out, signature, data, sig_size)
    out
}


// Bind the bundle metadata to an image emitted by image() or dynamic_storage().
// Both writers place LC_CODE_SIGNATURE last and align the signature to 16 KiB.
fn le32(image: &[]u8, offset: i32) -> i32 {
    return i32(image[offset]).bit_or(i32(image[offset + 1]).shl(8)).bit_or(i32(image[offset + 2]).shl(16)).bit_or(i32(image[offset + 3]).shl(24))
}

pub fn seal_bundle(image: &mut []u8, identifier: string, info: string, resources: string) {
    var cursor := 32
    var signature := 0
    var link := 0
    var exec_size := 0
    for i in 0..le32(&image, 16) {
        kind := le32(&image, cursor)
        if kind == 29 { signature = cursor }
        if kind == 25 {
            if image[cursor + 10] == 76 { link = cursor }
            if image[cursor + 10] == 84 { exec_size = le32(&image, cursor + 48) }
        }
        cursor = cursor + le32(&image, cursor + 4)
    }
    assert(signature > 0 && link > 0 && exec_size > 0)
    offset := le32(&image, signature + 8)
    slots := offset / 16384
    length := align(20 + 88 + identifier.len + 1 + 96 + slots * 32, 16)
    link_len := offset + length - le32(&image, link + 40)
    imports.set_le(&mut image, signature + 12, i64(length), 4)
    imports.set_le(&mut image, link + 32, i64(align(link_len, 16384)), 8)
    imports.set_le(&mut image, link + 48, i64(link_len), 8)
    while image.len > offset { discarded := image.pop() }
    append_directory(&mut image, offset, exec_size, length, identifier, info, resources)
}
