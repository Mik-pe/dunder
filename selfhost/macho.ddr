import std/bytes as bytes
import std/sha256 as sha256
fn align(value: i32, alignment: i32) -> i32 { (value + alignment - 1) / alignment * alignment }
fn name(output: &mut []i32, value: string) { assert(value.len <= 16); bytes.append_text(&mut output, value); bytes.zeros(&mut output, 16 - value.len) }
fn segment(output: &mut []i32, label: string, vm: i64, size: i64, offset: i64, file_size: i64, protection: i32, sections: i32) {
    bytes.u32le(&mut output, 25); bytes.u32le(&mut output, i64(72 + 80 * sections)); name(&mut output, label)
    bytes.u64le(&mut output, vm); bytes.u64le(&mut output, size); bytes.u64le(&mut output, offset); bytes.u64le(&mut output, file_size)
    bytes.u32le(&mut output, i64(protection)); bytes.u32le(&mut output, i64(protection)); bytes.u32le(&mut output, i64(sections)); bytes.u32le(&mut output, 0)
}
pub fn image(text: &[]i32) -> []i32 {
    page := 16384
    vm: i64 = 4294967296
    text_offset := 432
    text_end := text_offset + text.len
    signature_offset := align(text_end, page)
    slots := signature_offset / page
    hash_offset := 95
    directory_length := hash_offset + slots * 32
    signature_size := align(20 + directory_length, 16)
    var output: []i32 = []
    header: [i64; 8] = [4277009103, 16777228, 0, 2, 7, 392, 2097157, 0]
    for value in header { bytes.u32le(&mut output, value) }
    segment(&mut output, "__PAGEZERO", 0, vm, 0, 0, 0, 0)
    segment(&mut output, "__TEXT", vm, i64(signature_offset), 0, i64(text_end), 5, 1)
    name(&mut output, "__text"); name(&mut output, "__TEXT")
    bytes.u64le(&mut output, vm + i64(text_offset)); bytes.u64le(&mut output, i64(text.len))
    section: [i64; 8] = [432, 4, 0, 0, 2147484672, 0, 0, 0]
    for value in section { bytes.u32le(&mut output, value) }
    segment(&mut output, "__LINKEDIT", vm + i64(signature_offset), i64(align(signature_size, page)), i64(signature_offset), i64(signature_size), 1, 0)
    version: [i64; 6] = [50, 24, 1, 720896, 720896, 0]
    for value in version { bytes.u32le(&mut output, value) }
    bytes.u32le(&mut output, 14); bytes.u32le(&mut output, 32); bytes.u32le(&mut output, 12)
    bytes.append_text(&mut output, "/usr/lib/dyld"); bytes.zeros(&mut output, 7)
    bytes.u32le(&mut output, 2147483688); bytes.u32le(&mut output, 24); bytes.u64le(&mut output, i64(text_offset)); bytes.u64le(&mut output, 0)
    bytes.u32le(&mut output, 29); bytes.u32le(&mut output, 16); bytes.u32le(&mut output, i64(signature_offset)); bytes.u32le(&mut output, i64(signature_size))
    assert(output.len == 424)
    bytes.zeros(&mut output, text_offset - output.len)
    bytes.append(&mut output, &text)
    bytes.zeros(&mut output, signature_offset - output.len)
    var directory: []i32 = []
    bytes.zeros(&mut directory, directory_length)
    bytes.set_u32be(&mut directory, 0, 4208856066)
    bytes.set_u32be(&mut directory, 4, i64(directory_length))
    bytes.set_u32be(&mut directory, 8, 132096)
    bytes.set_u32be(&mut directory, 12, 2)
    bytes.set_u32be(&mut directory, 16, i64(hash_offset))
    bytes.set_u32be(&mut directory, 20, 88)
    bytes.set_u32be(&mut directory, 28, i64(slots))
    bytes.set_u32be(&mut directory, 32, i64(signature_offset))
    directory[36] = 32; directory[37] = 2; directory[39] = 14
    bytes.set_u64be(&mut directory, 72, i64(signature_offset)); bytes.set_u64be(&mut directory, 80, 1)
    identifier := "dunder\0"
    for i in 0..identifier.len { directory[88 + i] = identifier[i] }
    var chunk: []i32 = []
    chunk.reserve(page)
    for slot in 0..slots {
        chunk.clear()
        for i in 0..page { chunk.push(output[slot * page + i]) }
        digest := sha256.digest(&chunk)
        for i in 0..32 { directory[hash_offset + slot * 32 + i] = digest[i] }
    }
    var signature: []i32 = []
    bytes.zeros(&mut signature, 20)
    bytes.set_u32be(&mut signature, 0, 4208856256)
    bytes.set_u32be(&mut signature, 4, i64(signature_size))
    bytes.set_u32be(&mut signature, 8, 1); bytes.set_u32be(&mut signature, 16, 20)
    bytes.append(&mut signature, &directory)
    bytes.zeros(&mut signature, signature_size - signature.len)
    bytes.append(&mut output, &signature)
    output
}
