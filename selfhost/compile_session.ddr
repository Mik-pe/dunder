// Compiler session job log, object-origin bounds checking, fragment
// persistence, and target binary formatting (ARM64, x86_64, Wasm).
import arm64 as arm
import fragments
import mir_lower
import wasm_abi as wa
import wasm_native as wasm
import x86

pub struct JobLog {
    compiled: []bool, phase: i32, scan: i32, more: bool, globals: i32,
    main_id: i32, platform: i32, checking: bool, accepted: i32,
    cache: string, directory: string, error_ordinal: i32,
    declarations: []i32, words: []i32, word_ends: []i32,
    labels: []i32, label_ends: []i32, relocs: []i32, reloc_ends: []i32,
    imports: []i32, import_ends: []i32, kinds: []i32,
    keys: []string, paths: []string, eligible: []bool, legacy: []bool,
    deps_first: []i32, deps_end: []i32, deps: []i32, charged: []i32,
    started: []i64, instrument_runtime: bool,
}

pub fn new_job_log() -> JobLog {
    JobLog {
        compiled: [], phase: 0, scan: 0, more: false, globals: 0,
        main_id: 0, platform: 0, checking: false, accepted: 0,
        cache: "", directory: "", error_ordinal: 2147483647,
        declarations: [], words: [], word_ends: [], labels: [], label_ends: [],
        relocs: [], reloc_ends: [], imports: [], import_ends: [], kinds: [],
        keys: [], paths: [], eligible: [], legacy: [], deps_first: [], deps_end: [],
        deps: [], charged: [], started: [], instrument_runtime: false,
    }
}

pub fn job_range(log: &JobLog, ordinal: i32, fn_labels: &[]i32) -> mir_lower.FragmentRange {
    mir_lower.FragmentRange {
        first_word: log.words[ordinal], word_end: log.word_ends[ordinal],
        first_label: log.labels[ordinal], label_end: log.label_ends[ordinal],
        first_reloc: log.relocs[ordinal], reloc_end: log.reloc_ends[ordinal],
        first_import: log.imports[ordinal], import_end: log.import_ends[ordinal],
        entry: fn_labels[log.declarations[ordinal]],
    }
}

pub fn record_job(log: &mut JobLog, words_len: i32, labels_len: i32, at_len: i32,
    f: i32, begin_words: i32, begin_labels: i32, begin_relocations: i32,
    first_import: i32, import_sites_len: i32, kind: i32, key: string, path: string,
    eligible: bool, inline_enabled: bool, scalar_function: bool, started: i64) {
    log.declarations.push(f); log.words.push(begin_words); log.word_ends.push(words_len)
    log.labels.push(begin_labels); log.label_ends.push(labels_len)
    log.relocs.push(begin_relocations); log.reloc_ends.push(at_len)
    log.imports.push(first_import); log.import_ends.push(import_sites_len); log.kinds.push(kind)
    log.keys.push(key); log.paths.push(path); log.eligible.push(eligible)
    log.legacy.push(inline_enabled && !scalar_function)
    log.deps_first.push(log.deps.len); log.deps_end.push(log.deps.len)
    log.charged.push(0); log.started.push(started)
}

pub fn job_object_matches(log: &JobLog, object: &mir_lower.FunctionObject, ordinal: i32, fn_labels: &[]i32) -> bool {
    if !mir_lower.object_ready(&object) || mir_lower.object_platform(&object) != log.platform { return false }
    if mir_lower.object_first_word(&object) != log.words[ordinal] || mir_lower.object_word_end(&object) != log.word_ends[ordinal] ||
        mir_lower.object_first_label(&object) != log.labels[ordinal] || mir_lower.object_label_end(&object) != log.label_ends[ordinal] ||
        mir_lower.object_first_reloc(&object) != log.relocs[ordinal] || mir_lower.object_reloc_end(&object) != log.reloc_ends[ordinal] ||
        mir_lower.object_first_import(&object) != log.imports[ordinal] || mir_lower.object_import_end(&object) != log.import_ends[ordinal] {
        return false
    }
    labels := log.label_ends[ordinal] - log.labels[ordinal]
    if mir_lower.object_label_count(&object) != labels + 1 ||
        mir_lower.object_label_id(&object, 0) != fn_labels[log.declarations[ordinal]] ||
        mir_lower.object_label_offset(&object, 0) != 0 ||
        mir_lower.object_import_count(&object) != log.import_ends[ordinal] - log.imports[ordinal] {
        return false
    }
    for i in 0..labels {
        if mir_lower.object_label_id(&object, i + 1) != log.labels[ordinal] + i { return false }
    }
    for i in 0..mir_lower.object_import_count(&object) {
        if mir_lower.object_import_id(&object, i) != log.imports[ordinal] + i { return false }
    }
    true
}

pub fn save_accepted_object(log: &JobLog, ordinal: i32, object: &mir_lower.FunctionObject, fn_count: i32) {
    if log.legacy[ordinal] {
        var deps := fragments.new_dependencies(); deps.charged_words = log.charged[ordinal]
        for i in log.deps_first[ordinal]..log.deps_end[ordinal] { deps.declarations.push(log.deps[i]) }
        saved := fragments.save_object_with_dependencies(&object, log.labels[ordinal], log.label_ends[ordinal],
            log.globals, log.paths[ordinal], log.keys[ordinal], &deps, fn_count)
    } else {
        saved := fragments.save_object(&object, log.labels[ordinal], log.label_ends[ordinal],
            log.globals, log.paths[ordinal], log.keys[ordinal])
    }
}

pub fn assemble_wasm(code: &arm.Code, data_start: i32, main_label: i32,
    main_ret: i32, wasm_abi: &wa.Abi) -> wasm.Result {
    wasm.image(&code, data_start, main_label, main_ret, &wasm_abi)
}

pub fn assemble_x86(code: &arm.Code, data_start: i32, import_sites: &[]i32,
    import_slots: &[]i32) -> x86.Result {
    x86.finish(&code, data_start, &import_sites, &import_slots)
}
