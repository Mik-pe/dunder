// Optional attribution for compiler work. These intervals partition work in
// the compiler call; normal compilation performs no clock reads or updates.
import native_clock as monotonic
import std.text as text

pub struct Profile { enabled: bool, host: i32, clock_ok: bool, elapsed: []i64, calls: []i64, work: []i64 }
pub fn new(host: i32) -> Profile {
    var p := Profile { enabled: host >= 0 && host <= 2, host: host, clock_ok: true, elapsed: [], calls: [], work: [] }
    if p.enabled { for i in 0..10 { p.elapsed.push(0); p.calls.push(0); p.work.push(0) } }
    p
}
pub fn phase_name(phase: i32) -> string {
    if phase == 0 { return "declarations" }; if phase == 1 { return "model_parse" }
    if phase == 2 { return "verify_pre" }; if phase == 3 { return "simplify" }
    if phase == 4 { return "verify_post" }; if phase == 5 { return "allocation" }
    if phase == 6 { return "scalar_emit" }; if phase == 7 { return "legacy_body" }
    if phase == 8 { return "fragment_cache" }; "finalize"
}
fn unit_name(phase: i32) -> string {
    if phase == 0 { return "functions" }; if phase == 1 || phase == 7 { return "tokens" }
    if phase == 2 || phase == 4 { return "nodes" }; if phase == 3 { return "visits" }
    if phase == 5 { return "frame_values" }; if phase == 6 { return "words" }
    if phase == 8 { return "operations" }; "bytes"
}
pub fn clock(host: i32) -> i64 { monotonic.nanoseconds(host) }
pub fn begin(p: &Profile) -> i64 {
    if !p.enabled { return -1 }
    clock(p.host)
}
pub fn record(p: &mut Profile, phase: i32, first: i64, last: i64, work: i64) {
    if !p.enabled { return }
    if phase < 0 || phase >= 10 || work < 0 { p.clock_ok = false; return }
    p.calls[phase] = p.calls[phase] + 1; p.work[phase] = p.work[phase] + work
    if first < 0 || last < first { p.clock_ok = false; return }
    p.elapsed[phase] = p.elapsed[phase] + last - first
}
pub fn finish(p: &mut Profile, phase: i32, first: i64, work: i64) {
    if !p.enabled { return }
    last := clock(p.host)
    record(&mut p, phase, first, last, work)
}
pub fn json(p: &Profile, compiler_ns: i64) -> string {
    if !p.enabled { return "{\"enabled\":false}" }
    var total: i64 = 0
    for elapsed in p.elapsed { total = total + elapsed }
    valid := p.clock_ok && compiler_ns >= total
    var flag := "false"; var covered := "null"; var other := "null"
    if valid { flag = "true"; covered = total.str(); other = (compiler_ns - total).str() }
    var out := "{\"enabled\":true,\"clock_ok\":" + flag + ",\"unit\":\"ns\",\"covered\":" + covered + ",\"other\":" + other + ",\"phases\":{"
    for phase in 0..10 {
        if phase > 0 { out = out + "," }
        var duration := "null"; if valid { duration = p.elapsed[phase].str() }
        out = out + "\"" + phase_name(phase) + "\":" + duration
    }
    out = out + "},\"calls\":{"
    for phase in 0..10 {
        if phase > 0 { out = out + "," }
        out = out + "\"" + phase_name(phase) + "\":" + p.calls[phase].str()
    }
    out = out + "},\"work\":{"
    for phase in 0..10 {
        if phase > 0 { out = out + "," }
        out = out + "\"" + phase_name(phase) + "_" + unit_name(phase) + "\":" + p.work[phase].str()
    }
    out + "}}"
}
@test fn compiler_profile_accounts_intervals_and_preserves_missing_clock_data() {
    var off := new(-1)
    record(&mut off, 3, 1, 4, 9)
    off.calls.len == 0
    json(&off, 100) == "{\"enabled\":false}"
    var p := new(0)
    record(&mut p, 1, 10, 30, 42); record(&mut p, 1, 40, 50, 3)
    p.elapsed[1] == 30
    p.calls[1] == 2
    p.work[1] == 45
    text.find(json(&p, 100), "\"covered\":30,\"other\":70") >= 0
    text.find(json(&p, 20), "\"clock_ok\":true") < 0
    record(&mut p, 2, -1, 40, 8)
    !p.clock_ok
    text.find(json(&p, 100), "\"covered\":null,\"other\":null") >= 0
    p.calls[2] == 1
    p.work[2] == 8
}
