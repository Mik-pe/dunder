import arm64 as arm

// Private selfhost ABI: every value cell is eight bytes, including fields.
pub struct Sys {
    arg_count: i32, arg: i32, pid: i32, read_text: i32, read_u8: i32, metadata: i32, same_file: i32,
    write_bytes: i32, make_executable: i32, rename: i32, remove_file: i32, decode_utf8: i32,
    decode_u8_range: i32, write_text: i32, append_text: i32, mkdir: i32, remove_dir: i32, stderr: i32,
    now_ms: i32, net_listen: i32, net_accept: i32, net_connect: i32, net_read: i32, net_write: i32,
    net_poll: i32, net_set_nonblocking: i32, net_set_nodelay: i32, net_local_port: i32,
    net_shutdown_write: i32, net_close: i32,
}
pub fn new(code: &mut arm.Code) -> Sys {
    Sys {
        arg_count: arm.label(&mut code), arg: arm.label(&mut code), pid: arm.label(&mut code),
        read_text: arm.label(&mut code), read_u8: arm.label(&mut code), metadata: arm.label(&mut code),
        same_file: arm.label(&mut code), write_bytes: arm.label(&mut code), make_executable: arm.label(&mut code),
        rename: arm.label(&mut code), remove_file: arm.label(&mut code), decode_utf8: arm.label(&mut code),
        decode_u8_range: arm.label(&mut code), write_text: arm.label(&mut code), append_text: arm.label(&mut code),
        mkdir: arm.label(&mut code), remove_dir: arm.label(&mut code), stderr: arm.label(&mut code),
        now_ms: arm.label(&mut code), net_listen: arm.label(&mut code), net_accept: arm.label(&mut code),
        net_connect: arm.label(&mut code), net_read: arm.label(&mut code), net_write: arm.label(&mut code),
        net_poll: arm.label(&mut code), net_set_nonblocking: arm.label(&mut code), net_set_nodelay: arm.label(&mut code),
        net_local_port: arm.label(&mut code), net_shutdown_write: arm.label(&mut code), net_close: arm.label(&mut code),
    }
}
fn mul(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 2600500224 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn udiv(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 2596276224 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn lsr_imm(code: &mut arm.Code, d: i32, a: i32, k: i32) { arm.emit(&mut code, 3544186880 + i64(k) * 65536 + 63 * 1024 + i64(a) * 32 + i64(d)) }
fn lsl_imm(code: &mut arm.Code, d: i32, a: i32, k: i32) { arm.emit(&mut code, 3544186880 + i64(64 - k) * 65536 + i64(63 - k) * 1024 + i64(a) * 32 + i64(d)) }
fn and_reg(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 2315255808 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn orr_reg(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 2852126720 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn eor_reg(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 3388997632 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn ld32(code: &mut arm.Code, d: i32, a: i32, offset: i32) { arm.emit(&mut code, 3107979264 + i64(offset / 4) * 1024 + i64(a) * 32 + i64(d)) }
fn st32(code: &mut arm.Code, d: i32, a: i32, offset: i32) { arm.emit(&mut code, 3103784960 + i64(offset / 4) * 1024 + i64(a) * 32 + i64(d)) }
fn add(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn sub(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 3405774848 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn inc(code: &mut arm.Code, d: i32, a: i32, n: i32) { arm.emit(&mut code, 2432696320 + i64(n) * 1024 + i64(a) * 32 + i64(d)) }
fn dec(code: &mut arm.Code, d: i32, a: i32, n: i32) { arm.emit(&mut code, 3506438144 + i64(n) * 1024 + i64(a) * 32 + i64(d)) }
fn ld(code: &mut arm.Code, d: i32, a: i32, offset: i32) { arm.emit(&mut code, 4181721088 + i64(offset / 8) * 1024 + i64(a) * 32 + i64(d)) }
fn st(code: &mut arm.Code, d: i32, a: i32, offset: i32) { arm.emit(&mut code, 4177526784 + i64(offset / 8) * 1024 + i64(a) * 32 + i64(d)) }
fn ldb(code: &mut arm.Code, d: i32, a: i32) { arm.emit(&mut code, 960495616 + i64(a) * 32 + i64(d)) }
fn stb(code: &mut arm.Code, d: i32, a: i32) { arm.emit(&mut code, 956301312 + i64(a) * 32 + i64(d)) }
fn cmp(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn numcmp(code: &mut arm.Code, a: i32, n: i64) { arm.imm(&mut code, 17, n); cmp(&mut code, a, 17) }
fn testzero(code: &mut arm.Code, reg: i32, target: i32) { numcmp(&mut code, reg, 0); arm.branch(&mut code, target, 2) }
fn negerr(code: &mut arm.Code, target: i32) { numcmp(&mut code, 0, 0); arm.branch(&mut code, target, 13) }
fn begin(code: &mut arm.Code, label: i32) { arm.mark(&mut code, label); f := arm.prologue(&mut code); arm.frame(&mut code, f, 48) }
// Filesystem entries reserve space for two bounded 4096-byte C paths and
// one stat buffer. Keeping the conversion storage in the caller frame also
// covers all early returns from the syscalls.
fn file_frame(code: &mut arm.Code, label: i32) {
    arm.mark(&mut code, label); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1072)
}
fn path_arg(code: &mut arm.Code, convert: i32, second: bool) {
    var index := 559; if second { index = 1071 }
    local(&mut code, 1, index); call(&mut code, convert)
}
fn local(code: &mut arm.Code, reg: i32, slot: i32) { arm.imm(&mut code, reg, i64(slot + 1) * 8); sub(&mut code, reg, 29, reg) }
fn call(code: &mut arm.Code, label: i32) { arm.branch(&mut code, label, 1) }
fn jump(code: &mut arm.Code, label: i32) { arm.branch(&mut code, label, 0) }
// The runtime consumes a result or a negative errno on either host.
fn syscall(code: &mut arm.Code, darwin: i64, linux: i64) {
    arm.syscall(&mut code, 33554432 + darwin, linux)
    if code.platform == 0 {
        success := arm.label(&mut code); arm.branch(&mut code, success, 5)
        sub(&mut code, 0, 31, 0); arm.mark(&mut code, success)
    }
}
// Open the path in x1. x0 receives the descriptor or a negative errno.
fn open_file(code: &mut arm.Code, operation: i32) {
    var flags := 0
    if operation == 1 { if code.platform != 0 { flags = 577 } else { flags = 1537 } }
    if operation == 2 { if code.platform != 0 { flags = 1089 } else { flags = 521 } }
    if code.platform != 0 {
        arm.imm(&mut code, 0, -100); arm.imm(&mut code, 2, i64(flags)); arm.imm(&mut code, 3, 420)
    } else {
        arm.mov(&mut code, 0, 1); arm.imm(&mut code, 1, i64(flags)); arm.imm(&mut code, 2, 420)
    }
    syscall(&mut code, 5, 56)
}
fn stat_path(code: &mut arm.Code) {
    // x0 is a C path. Keep the struct stat buffer inside this runtime frame.
    if code.platform != 0 {
        arm.mov(&mut code, 1, 0); arm.imm(&mut code, 0, -100); local(&mut code, 2, 47); arm.imm(&mut code, 3, 0)
    } else { local(&mut code, 1, 47) }
    syscall(&mut code, 338, 79)
}
fn stat_size(code: &mut arm.Code, dst: i32) {
    var offset := 96; if code.platform != 0 { offset = 48 }
    ld(&mut code, dst, 2, offset)
}
fn stat_mode(code: &mut arm.Code) {
    if code.platform == 2 { ld(&mut code, 3, 2, 24) }
    else if code.platform == 1 { ld(&mut code, 3, 2, 16) }
    else { arm.emit(&mut code, 2034237440 + 2 * 1024 + 2 * 32 + 3) } // ldrh w3,[x2,#4]
}
fn stat_device(code: &mut arm.Code, dst: i32) {
    if code.platform != 0 { ld(&mut code, dst, 2, 0) }
    else { arm.emit(&mut code, 3107979264 + 2 * 32 + i64(dst)) } // ldr wD,[x2]
}
fn leaf(code: &mut arm.Code) { arm.emit(&mut code, 3596551104) }
fn copy(code: &mut arm.Code, dst: i32, src: i32, count: i32) {
    if code.profile {
        // Shared runtime.copy_bytes counter. Existing x16 scratch is free
        // here; the actual callers keep source/count in x2..4.
        ld(&mut code, 16, 21, 376); add(&mut code, 16, 16, count); st(&mut code, 16, 21, 376)
    }
    words := arm.label(&mut code); tail := arm.label(&mut code)
    loop_label := arm.label(&mut code); done := arm.label(&mut code)
    // Source and destination are separate buffers; bound every word load by
    // the remaining count, including argv strings that may end at a page edge.
    arm.mark(&mut code, words); numcmp(&mut code, count, 8); arm.branch(&mut code, tail, 5)
    ld(&mut code, 16, src, 0); st(&mut code, 16, dst, 0)
    inc(&mut code, dst, dst, 8); inc(&mut code, src, src, 8); dec(&mut code, count, count, 8); jump(&mut code, words)
    arm.mark(&mut code, tail)
    arm.mark(&mut code, loop_label); testzero(&mut code, count, done)
    ldb(&mut code, 16, src); stb(&mut code, 16, dst)
    inc(&mut code, dst, dst, 1); inc(&mut code, src, src, 1); dec(&mut code, count, count, 1); jump(&mut code, loop_label)
    arm.mark(&mut code, done)
}

// Validate a length-prefixed string, returning zero or portable EILSEQ (92).
fn utf8(code: &mut arm.Code, label: i32) {
    arm.mark(&mut code, label); ld(&mut code, 3, 0, 0); inc(&mut code, 2, 0, 8); add(&mut code, 3, 2, 3)
    head := arm.label(&mut code); done := arm.label(&mut code); bad := arm.label(&mut code)
    two := arm.label(&mut code); three := arm.label(&mut code); four := arm.label(&mut code); cont := arm.label(&mut code)
    arm.mark(&mut code, head); cmp(&mut code, 2, 3); arm.branch(&mut code, done, 2)
    ldb(&mut code, 4, 2); inc(&mut code, 2, 2, 1); numcmp(&mut code, 4, 128); arm.branch(&mut code, head, 5)
    numcmp(&mut code, 4, 194); arm.branch(&mut code, bad, 5)
    numcmp(&mut code, 4, 224); arm.branch(&mut code, two, 5)
    numcmp(&mut code, 4, 240); arm.branch(&mut code, three, 5)
    numcmp(&mut code, 4, 245); arm.branch(&mut code, four, 5); jump(&mut code, bad)
    arm.mark(&mut code, two); arm.imm(&mut code, 5, 1); arm.imm(&mut code, 6, 128); arm.imm(&mut code, 7, 191); jump(&mut code, cont)
    arm.mark(&mut code, three); arm.imm(&mut code, 5, 2); arm.imm(&mut code, 6, 128); arm.imm(&mut code, 7, 191)
    normal3 := arm.label(&mut code); not_e0 := arm.label(&mut code)
    numcmp(&mut code, 4, 224); arm.branch(&mut code, not_e0, 3); arm.imm(&mut code, 6, 160); jump(&mut code, normal3)
    arm.mark(&mut code, not_e0); numcmp(&mut code, 4, 237); arm.branch(&mut code, normal3, 3); arm.imm(&mut code, 7, 159)
    arm.mark(&mut code, normal3); jump(&mut code, cont)
    arm.mark(&mut code, four); arm.imm(&mut code, 5, 3); arm.imm(&mut code, 6, 128); arm.imm(&mut code, 7, 191)
    normal4 := arm.label(&mut code); not_f0 := arm.label(&mut code)
    numcmp(&mut code, 4, 240); arm.branch(&mut code, not_f0, 3); arm.imm(&mut code, 6, 144); jump(&mut code, normal4)
    arm.mark(&mut code, not_f0); numcmp(&mut code, 4, 244); arm.branch(&mut code, normal4, 3); arm.imm(&mut code, 7, 143)
    arm.mark(&mut code, normal4)
    arm.mark(&mut code, cont); cmp(&mut code, 2, 3); arm.branch(&mut code, bad, 2)
    ldb(&mut code, 4, 2); inc(&mut code, 2, 2, 1); cmp(&mut code, 4, 6); arm.branch(&mut code, bad, 5); cmp(&mut code, 4, 7); arm.branch(&mut code, bad, 10)
    dec(&mut code, 5, 5, 1); arm.imm(&mut code, 6, 128); arm.imm(&mut code, 7, 191); testzero(&mut code, 5, head); jump(&mut code, cont)
    arm.mark(&mut code, done); arm.imm(&mut code, 0, 0); leaf(&mut code)
    arm.mark(&mut code, bad); arm.imm(&mut code, 0, 92); leaf(&mut code)
}

pub fn emit_runtime(code: &mut arm.Code, r: &Sys, alloc: i32, release: i32, record: i32) {
    path := arm.label(&mut code); pack := arm.label(&mut code); status := arm.label(&mut code); text_result := arm.label(&mut code); validate := arm.label(&mut code); error := arm.label(&mut code)
    utf8(&mut code, validate)
    // Translate a negative Linux syscall result to the language's errno table.
    arm.mark(&mut code, error); sub(&mut code, 0, 31, 0)
    if code.platform == 0 { leaf(&mut code) }
    for n in [1, 2, 4, 5, 9, 12, 13, 17, 20, 21, 22, 27, 28, 30, 32] { next := arm.label(&mut code); numcmp(&mut code, 0, i64(n)); arm.branch(&mut code, next, 3); leaf(&mut code); arm.mark(&mut code, next) }
    // Most filesystem and network errors retain their POSIX numbers; Linux differs on these.
    for i in 0..11 {
        var linux: i64 = 11; var portable: i64 = 35
        if i == 1 { linux = 36; portable = 63 }
        if i == 2 { linux = 39; portable = 66 }
        if i == 3 { linux = 84; portable = 92 }
        if i == 4 { linux = 95; portable = 45 }
        if i == 5 { linux = 98; portable = 48 }
        if i == 6 { linux = 103; portable = 53 }
        if i == 7 { linux = 104; portable = 54 }
        if i == 8 { linux = 110; portable = 60 }
        if i == 9 { linux = 111; portable = 61 }
        if i == 10 { linux = 115; portable = 36 }
        next := arm.label(&mut code); numcmp(&mut code, 0, linux); arm.branch(&mut code, next, 3); arm.imm(&mut code, 0, portable); leaf(&mut code); arm.mark(&mut code, next)
    }
    arm.imm(&mut code, 17, 10000); add(&mut code, 0, 0, 17); leaf(&mut code)

    begin(&mut code, status); arm.store(&mut code, 0, 0); arm.imm(&mut code, 0, 16); call(&mut code, record); arm.store(&mut code, 1, 0); arm.mov(&mut code, 2, 0); arm.load(&mut code, 0); st(&mut code, 0, 2, 8)
    failed_status := arm.label(&mut code); status_end := arm.label(&mut code); arm.branch(&mut code, failed_status, 19); arm.imm(&mut code, 1, 1); jump(&mut code, status_end); arm.mark(&mut code, failed_status); arm.imm(&mut code, 1, 0); arm.mark(&mut code, status_end); st(&mut code, 1, 2, 0); arm.load(&mut code, 1); arm.ret(&mut code)
    begin(&mut code, text_result); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 1); valid_text := arm.label(&mut code); testzero(&mut code, 1, valid_text); call(&mut code, release); arm.imm(&mut code, 0, 8); call(&mut code, alloc); st(&mut code, 31, 0, 0); arm.store(&mut code, 0, 0); arm.mark(&mut code, valid_text); arm.imm(&mut code, 0, 24); call(&mut code, record); arm.store(&mut code, 2, 0); arm.mov(&mut code, 2, 0); arm.load(&mut code, 0); st(&mut code, 0, 2, 8); arm.load(&mut code, 1); st(&mut code, 0, 2, 16)
    text_bad := arm.label(&mut code); text_end := arm.label(&mut code); arm.branch(&mut code, text_bad, 19); arm.imm(&mut code, 1, 1); jump(&mut code, text_end); arm.mark(&mut code, text_bad); arm.imm(&mut code, 1, 0); arm.mark(&mut code, text_end); st(&mut code, 1, 2, 0); arm.load(&mut code, 2); arm.ret(&mut code)

    // CString conversion validates path size and embedded NULs.
    begin(&mut code, path); arm.store(&mut code, 2, 1); arm.store(&mut code, 0, 0); ld(&mut code, 1, 0, 0); arm.store(&mut code, 1, 1)
    path_bad := arm.label(&mut code); path_long := arm.label(&mut code); path_done := arm.label(&mut code); numcmp(&mut code, 1, 4095); arm.branch(&mut code, path_long, 10)
    arm.load(&mut code, 2); arm.mov(&mut code, 2, 0); arm.load(&mut code, 0); inc(&mut code, 3, 0, 8); arm.load(&mut code, 1); arm.mov(&mut code, 4, 0)
    path_loop := arm.label(&mut code); arm.mark(&mut code, path_loop); testzero(&mut code, 4, path_done); ldb(&mut code, 5, 3); testzero(&mut code, 5, path_bad); stb(&mut code, 5, 2); inc(&mut code, 2, 2, 1); inc(&mut code, 3, 3, 1); dec(&mut code, 4, 4, 1); jump(&mut code, path_loop)
    arm.mark(&mut code, path_done); stb(&mut code, 31, 2); arm.load(&mut code, 2); arm.imm(&mut code, 1, 0); arm.ret(&mut code)
    arm.mark(&mut code, path_bad); arm.imm(&mut code, 0, 0); arm.imm(&mut code, 1, 22); arm.ret(&mut code)
    arm.mark(&mut code, path_long); arm.imm(&mut code, 0, 0); arm.imm(&mut code, 1, 63); arm.ret(&mut code)

    // Both packed []u8 and legacy []i32 produce an owned UTF-8 or I/O buffer.
    begin(&mut code, pack); ld(&mut code, 1, 0, 24); arm.store(&mut code, 3, 1); ld(&mut code, 1, 0, 0); arm.store(&mut code, 0, 1); ld(&mut code, 0, 0, 8); arm.store(&mut code, 1, 0); inc(&mut code, 0, 0, 9); call(&mut code, alloc); arm.store(&mut code, 2, 0); arm.mov(&mut code, 2, 0); arm.load(&mut code, 1); st(&mut code, 0, 2, 0); arm.mov(&mut code, 4, 0); inc(&mut code, 3, 2, 8); arm.load(&mut code, 0); arm.mov(&mut code, 2, 0)
    pack_loop := arm.label(&mut code); pack_done := arm.label(&mut code); pack_bad := arm.label(&mut code); arm.load(&mut code, 3); arm.branch(&mut code, pack_loop, 19); copy(&mut code, 3, 2, 4); jump(&mut code, pack_done); arm.mark(&mut code, pack_loop); testzero(&mut code, 4, pack_done); arm.emit(&mut code, 3107979333); numcmp(&mut code, 5, 255); arm.branch(&mut code, pack_bad, 10); stb(&mut code, 5, 3); inc(&mut code, 2, 2, 4); inc(&mut code, 3, 3, 1); dec(&mut code, 4, 4, 1); jump(&mut code, pack_loop)
    arm.mark(&mut code, pack_done); stb(&mut code, 31, 3); arm.load(&mut code, 2); arm.imm(&mut code, 1, 0); arm.ret(&mut code)
    arm.mark(&mut code, pack_bad); arm.load(&mut code, 2); call(&mut code, release); arm.imm(&mut code, 0, 0); arm.imm(&mut code, 1, 22); arm.ret(&mut code)

    arm.mark(&mut code, r.arg_count); arm.mov(&mut code, 0, 23); leaf(&mut code)
    arm.mark(&mut code, r.pid); syscall(&mut code, 20, 172); leaf(&mut code)
    begin(&mut code, r.arg); arg_bad := arm.label(&mut code); cmp(&mut code, 0, 23); arm.branch(&mut code, arg_bad, 4)
    arm.emit(&mut code, 3548246016); add(&mut code, 0, 24, 0); ld(&mut code, 0, 0, 0); arm.store(&mut code, 0, 0); arm.mov(&mut code, 2, 0); arm.imm(&mut code, 3, 0)
    arg_loop := arm.label(&mut code); arg_done := arm.label(&mut code); arm.mark(&mut code, arg_loop); ldb(&mut code, 4, 2); testzero(&mut code, 4, arg_done); inc(&mut code, 2, 2, 1); inc(&mut code, 3, 3, 1); jump(&mut code, arg_loop)
    arm.mark(&mut code, arg_done); arm.store(&mut code, 1, 3); inc(&mut code, 0, 3, 9); call(&mut code, alloc); arm.store(&mut code, 2, 0); arm.mov(&mut code, 2, 0); arm.load(&mut code, 1); st(&mut code, 0, 2, 0); arm.mov(&mut code, 4, 0); inc(&mut code, 2, 2, 8); arm.load(&mut code, 0); arm.mov(&mut code, 3, 0); copy(&mut code, 2, 3, 4); arm.load(&mut code, 2); call(&mut code, validate); arg_utf8 := arm.label(&mut code); arm.branch(&mut code, arg_utf8, 18); arm.imm(&mut code, 0, 106); syscall(&mut code, 1, 94); arm.mark(&mut code, arg_utf8); arm.load(&mut code, 2); arm.ret(&mut code)
    arm.mark(&mut code, arg_bad); arm.imm(&mut code, 0, 103); syscall(&mut code, 1, 94)

    begin(&mut code, r.decode_utf8); call(&mut code, pack); arm.store(&mut code, 0, 0); decode_bad := arm.label(&mut code); testzero(&mut code, 1, decode_bad); call(&mut code, text_result); arm.ret(&mut code)
    arm.mark(&mut code, decode_bad); call(&mut code, validate); arm.mov(&mut code, 1, 0); arm.load(&mut code, 0); call(&mut code, text_result); arm.ret(&mut code)

    begin(&mut code, r.decode_u8_range)
    arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 1); arm.store(&mut code, 2, 2)
    range_bad := arm.label(&mut code)
    numcmp(&mut code, 1, 0); arm.branch(&mut code, range_bad, 13)
    numcmp(&mut code, 2, 0); arm.branch(&mut code, range_bad, 13)
    ld(&mut code, 3, 0, 8); cmp(&mut code, 1, 3); arm.branch(&mut code, range_bad, 10)
    sub(&mut code, 4, 3, 1); cmp(&mut code, 2, 4); arm.branch(&mut code, range_bad, 10)
    arm.imm(&mut code, 5, 2147483638); cmp(&mut code, 2, 5); arm.branch(&mut code, range_bad, 10)
    inc(&mut code, 0, 2, 9); call(&mut code, alloc); arm.store(&mut code, 3, 0)
    arm.mov(&mut code, 2, 0); arm.load_into(&mut code, 2, 1); st(&mut code, 1, 2, 0)
    inc(&mut code, 2, 2, 8)
    arm.load(&mut code, 0); ld(&mut code, 3, 0, 0); arm.load_into(&mut code, 1, 4); add(&mut code, 3, 3, 4)
    arm.load_into(&mut code, 2, 4); copy(&mut code, 2, 3, 4); stb(&mut code, 31, 2)
    arm.load(&mut code, 3); call(&mut code, validate)
    arm.mov(&mut code, 1, 0); arm.load(&mut code, 3); call(&mut code, text_result); arm.ret(&mut code)
    arm.mark(&mut code, range_bad); arm.imm(&mut code, 0, 0); arm.imm(&mut code, 1, 22); call(&mut code, text_result); arm.ret(&mut code)

    h := Helpers { alloc: alloc, release: release, record: record, path: path, pack: pack, status: status, text_result: text_result, validate: validate, error: error }
    emit_files(&mut code, &r, &h)
    emit_net(&mut code, &r, &h)
}

struct Helpers { alloc: i32, release: i32, record: i32, path: i32, pack: i32, status: i32, text_result: i32, validate: i32, error: i32 }
fn emit_files(code: &mut arm.Code, r: &Sys, h: &Helpers) {
    emit_read(&mut code, &r, &h)
    emit_read_u8(&mut code, &r, &h)
    emit_metadata(&mut code, &r, &h)
    emit_write(&mut code, &r, &h)
    // The single-path mutations share the same checked path conversion.
    for operation in 0..4 {
        var entry := r.make_executable
        if operation == 1 { entry = r.remove_file }
        if operation == 2 { entry = r.mkdir }; if operation == 3 { entry = r.remove_dir }
        file_frame(&mut code, entry); path_arg(&mut code, h.path, false)
        failed := arm.label(&mut code); done := arm.label(&mut code); os_failed := arm.label(&mut code)
        numcmp(&mut code, 1, 0); arm.branch(&mut code, failed, 3)
        if code.platform != 0 {
            arm.mov(&mut code, 1, 0); arm.imm(&mut code, 0, -100)
            if operation == 0 || operation == 2 { arm.imm(&mut code, 2, 493) } else if operation == 3 { arm.imm(&mut code, 2, 512) } else { arm.imm(&mut code, 2, 0) }
        } else { arm.imm(&mut code, 1, 493) }
        if operation == 0 { syscall(&mut code, 15, 53) } else if operation == 2 { syscall(&mut code, 136, 34) } else if operation == 3 { syscall(&mut code, 137, 35) } else { syscall(&mut code, 10, 35) }
        negerr(&mut code, os_failed); arm.imm(&mut code, 0, 0); jump(&mut code, done)
