    numcmp(&mut code, 4, 0); arm.branch(&mut code, nread_zero, 15)
    cmp(&mut code, 2, 4); arm.branch(&mut code, nread_use_max, 15); arm.mov(&mut code, 2, 4); arm.mark(&mut code, nread_use_max)
