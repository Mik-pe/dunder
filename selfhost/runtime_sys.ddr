fn emit_net(code: &mut arm.Code, r: &Sys, h: &Helpers) {
    // now_ms() -> i64
    begin(&mut code, r.now_ms)
    if code.platform == 0 {
        local(&mut code, 0, 47); st(&mut code, 31, 0, 0); st(&mut code, 31, 0, 8)
        arm.imm(&mut code, 1, 0); arm.imm(&mut code, 2, 0); syscall(&mut code, 116, 113)
        local(&mut code, 1, 47); ld(&mut code, 0, 1, 0)
        arm.imm(&mut code, 2, 1000); mul(&mut code, 0, 0, 2)
        ld32(&mut code, 3, 1, 8); udiv(&mut code, 3, 3, 2); add(&mut code, 0, 0, 3); arm.ret(&mut code)
    } else {
        arm.imm(&mut code, 0, 1); local(&mut code, 1, 47); st(&mut code, 31, 1, 0); st(&mut code, 31, 1, 8)
        syscall(&mut code, 116, 113)
        local(&mut code, 1, 47); ld(&mut code, 0, 1, 0)
        arm.imm(&mut code, 2, 1000); mul(&mut code, 0, 0, 2)
        ld(&mut code, 3, 1, 8); arm.imm(&mut code, 4, 1000000); udiv(&mut code, 3, 3, 4)
        add(&mut code, 0, 0, 3); arm.ret(&mut code)
    }

    // net_listen(ipv4, port, backlog) -> fd or -errno
    begin(&mut code, r.net_listen)
    arm.store(&mut code, 1, 0); arm.store(&mut code, 2, 1); arm.store(&mut code, 3, 2)
    listen_bad := arm.label(&mut code); listen_fail_fd := arm.label(&mut code); listen_os := arm.label(&mut code)
    numcmp(&mut code, 1, 0); arm.branch(&mut code, listen_bad, 13)
    arm.imm(&mut code, 4, 65535); cmp(&mut code, 1, 4); arm.branch(&mut code, listen_bad, 14)
    arm.imm(&mut code, 0, 2); arm.imm(&mut code, 1, 1); arm.imm(&mut code, 2, 0); syscall(&mut code, 97, 198); negerr(&mut code, listen_os)
    arm.store(&mut code, 0, 0); emit_set_cloexec(&mut code); emit_setsockopt_one(&mut code, 65535, 1, 4, 2)
    if code.platform == 0 { emit_setsockopt_one(&mut code, 65535, 1, 4130, 4130) }
    emit_sockaddr_in(&mut code, 2, 1)
    arm.load(&mut code, 0); local(&mut code, 1, 47); arm.imm(&mut code, 2, 16); syscall(&mut code, 104, 200); negerr(&mut code, listen_fail_fd)
    arm.load(&mut code, 3); numcmp(&mut code, 0, 0); backlog_ok := arm.label(&mut code); arm.branch(&mut code, backlog_ok, 14)
    arm.imm(&mut code, 0, 128); arm.mark(&mut code, backlog_ok)
    arm.mov(&mut code, 1, 0); arm.load(&mut code, 0); syscall(&mut code, 106, 201); negerr(&mut code, listen_fail_fd)
    arm.load(&mut code, 0); arm.ret(&mut code)
    arm.mark(&mut code, listen_fail_fd); call(&mut code, h.error); arm.store(&mut code, 4, 0)
    arm.load(&mut code, 0); syscall(&mut code, 6, 57); arm.load(&mut code, 4); sub(&mut code, 0, 31, 0); arm.ret(&mut code)
    arm.mark(&mut code, listen_bad); arm.imm(&mut code, 0, -22)
    arm.mark(&mut code, listen_os); emit_ret_neg_errno(&mut code, h.error)

    // net_accept(listen_fd) -> fd or -errno
    begin(&mut code, r.net_accept)
    arm.store(&mut code, 1, 0)
    accept_bad := arm.label(&mut code); accept_again := arm.label(&mut code); accept_os := arm.label(&mut code)
    numcmp(&mut code, 0, 0); arm.branch(&mut code, accept_bad, 13)
    arm.mark(&mut code, accept_again); arm.load(&mut code, 1); arm.imm(&mut code, 1, 0); arm.imm(&mut code, 2, 0)
    syscall(&mut code, 30, 202); numcmp(&mut code, 0, -4); arm.branch(&mut code, accept_again, 2); negerr(&mut code, accept_os)
    arm.store(&mut code, 0, 0); emit_set_cloexec(&mut code)
    if code.platform == 0 { emit_setsockopt_one(&mut code, 65535, 1, 4130, 4130) }
    arm.load(&mut code, 0); arm.ret(&mut code)
    arm.mark(&mut code, accept_bad); arm.imm(&mut code, 0, -9)
    arm.mark(&mut code, accept_os); emit_ret_neg_errno(&mut code, h.error)

    // net_connect(ipv4, port) -> fd or -errno
    begin(&mut code, r.net_connect)
    arm.store(&mut code, 1, 0); arm.store(&mut code, 2, 1)
    conn_bad := arm.label(&mut code); conn_again := arm.label(&mut code); conn_fail_fd := arm.label(&mut code); conn_os := arm.label(&mut code)
    numcmp(&mut code, 1, 1); arm.branch(&mut code, conn_bad, 13)
    arm.imm(&mut code, 4, 65535); cmp(&mut code, 1, 4); arm.branch(&mut code, conn_bad, 14)
    arm.imm(&mut code, 0, 2); arm.imm(&mut code, 1, 1); arm.imm(&mut code, 2, 0); syscall(&mut code, 97, 198); negerr(&mut code, conn_os)
    arm.store(&mut code, 0, 0); emit_set_cloexec(&mut code)
