pub struct Sys { arg_count: i32, arg: i32, pid: i32, read_text: i32, metadata: i32, same_file: i32, write_bytes: i32, make_executable: i32, rename: i32, remove_file: i32, decode_utf8: i32, write_text: i32, append_text: i32, mkdir: i32, remove_dir: i32, stderr: i32 }
