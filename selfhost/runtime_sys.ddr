    syscall(&mut code, 98, 203); numcmp(&mut code, 0, -4); arm.branch(&mut code, conn_again, 2); negerr(&mut code, conn_fail_fd)
    arm.load(&mut code, 0); arm.ret(&mut code)
    arm.mark(&mut code, conn_fail_fd); call(&mut code, h.error); arm.store(&mut code, 4, 0)
    arm.load(&mut code, 0); syscall(&mut code, 6, 57); arm.load(&mut code, 4); sub(&mut code, 0, 31, 0); arm.ret(&mut code)
    arm.mark(&mut code, conn_bad); arm.imm(&mut code, 0, -22)
    arm.mark(&mut code, conn_os); emit_ret_neg_errno(&mut code, h.error)

