        arm.mov(&mut code, 2, 0); arm.load(&mut code, 2); sub(&mut code, 0, 0, 2); arm.store(&mut code, 2, 0); arm.load(&mut code, 3); add(&mut code, 0, 0, 2); arm.store(&mut code, 3, 0); jump(&mut code, loop_label)
        arm.mark(&mut code, interrupted); numcmp(&mut code, 0, -4); arm.branch(&mut code, loop_label, 2)
