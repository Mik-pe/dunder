// Standalone little-endian ELF64 for Linux ARM64, with a non-executable stack.
import std.bytes as bytes
import imports

fn u16le(output: &mut []u8, value: i32) {
    output.push(u8(value % 256)); output.push(u8(value / 256))
}

pub fn image(text: &[]u8) -> []u8 { image_for(&text, 183) }

pub fn image_for(text: &[]u8, machine: i32) -> []u8 {
    var output: []u8 = []
    output.reserve(4096 + text.len)
    output.push(127); bytes.append_utf8(&mut output, "ELF")
    output.push(2); output.push(1); output.push(1); bytes.pad(&mut output, 9)
    u16le(&mut output, 2); u16le(&mut output, machine)
    bytes.append_le(&mut output, 1, 4)
    bytes.append_le(&mut output, 4198400, 8); bytes.append_le(&mut output, 64, 8)
    bytes.append_le(&mut output, 0, 8); bytes.append_le(&mut output, 0, 4)
    u16le(&mut output, 64); u16le(&mut output, 56); u16le(&mut output, 2)
    u16le(&mut output, 0); u16le(&mut output, 0); u16le(&mut output, 0)

    // A single read/execute mapping contains both headers and code.
    bytes.append_le(&mut output, 1, 4); bytes.append_le(&mut output, 5, 4)
    bytes.append_le(&mut output, 0, 8)
    bytes.append_le(&mut output, 4194304, 8); bytes.append_le(&mut output, 4194304, 8)
    size := i64(4096 + text.len)
    bytes.append_le(&mut output, size, 8); bytes.append_le(&mut output, size, 8)
    bytes.append_le(&mut output, 4096, 8)

    bytes.append_le(&mut output, 1685382481, 4); bytes.append_le(&mut output, 6, 4)
    bytes.pad(&mut output, 40); bytes.append_le(&mut output, 16, 8)
    bytes.pad(&mut output, 4096 - output.len)
    bytes.extend(&mut output, &text)
    output
}

@test fn elf_has_an_arm64_entry_and_a_non_executable_stack() {
    code: []u8 = [1, 2, 3, 4]
    output := image(&code)
    assert(output.len == 4100)
    assert(output[0] == 127 && output[1] == 69 && output[2] == 76 && output[3] == 70)
    assert(output[4] == 2 && output[5] == 1)
    assert(output[18] == 183 && output[19] == 0)
    assert(output[24] == 0 && output[25] == 16 && output[26] == 64)
    assert(output[56] == 2 && output[64] == 1 && output[68] == 5)
    assert(output[96] == 4 && output[97] == 16)
    assert(output[120] == 81 && output[121] == 229 && output[122] == 116 && output[123] == 100)
    assert(output[124] == 6 && output[168] == 16)
    assert(output[4096] == 1 && output[4099] == 4)
}

fn phdr(out: &mut []u8, index: i32, kind: i32, flags: i32, offset: i32, size: i32, alignment: i32) {
    at := 64 + index * 56
    imports.set_le(&mut out, at, i64(kind), 4); imports.set_le(&mut out, at + 4, i64(flags), 4)
    imports.set_le(&mut out, at + 8, i64(offset), 8)
    imports.set_le(&mut out, at + 16, 4194304 + i64(offset), 8); imports.set_le(&mut out, at + 24, 4194304 + i64(offset), 8)
    imports.set_le(&mut out, at + 32, i64(size), 8); imports.set_le(&mut out, at + 40, i64(size), 8)
    imports.set_le(&mut out, at + 48, i64(alignment), 8)
}

fn tag(out: &mut []u8, key: i32, value: i32) {
    bytes.append_le(&mut out, i64(key), 8); bytes.append_le(&mut out, i64(value), 8)
}

pub fn dynamic_image(text: &[]u8, libraries: &[]string, symbols: &[]string,
                     sites: &[]i32, slots: &[]i32) -> []u8 {
    dynamic_image_for(&text, &libraries, &symbols, &sites, &slots, 183)
}

pub fn dynamic_image_for(text: &[]u8, libraries: &[]string, symbols: &[]string,
                         sites: &[]i32, slots: &[]i32, machine: i32) -> []u8 {
    dynamic_storage(&text, &libraries, &symbols, &sites, &slots, machine, 0)
}

pub fn dynamic_storage(text: &[]u8, libraries: &[]string, symbols: &[]string,
                       sites: &[]i32, slots: &[]i32, machine: i32, globals: i32) -> []u8 {
    assert(machine == 183 || machine == 62)
    assert(symbols.len == libraries.len && sites.len == slots.len)
    table := imports.libraries(&libraries, false)
    var out := image_for(&text, machine)
    base := 4194304
    data := imports.align(out.len, 4096)
    bytes.pad(&mut out, data - out.len + imports.align(symbols.len * 8, 16) + globals)
    if machine == 183 { imports.relocate(&mut out, 4096, text.len, data, symbols.len, &sites, &slots) }
    else {
        for i in 0..sites.len {
            assert(sites[i] >= 0 && sites[i] <= text.len - 4)
            assert(slots[i] < symbols.len)
            at := 4096 + sites[i]
            var destination := data
            if slots[i] < 0 { destination = data + imports.align(symbols.len * 8, 16) - 1 - slots[i] }
            else { destination = data + slots[i] * 8 }
            displacement := destination - at - 4
            imports.set_le(&mut out, at, i64(displacement), 4)
        }
    }
    string_table := out.len
    out.push(0)
    var needed: []i32 = []
    for library in table.names {
        needed.push(out.len - string_table)
        bytes.append_utf8(&mut out, library); out.push(0)
    }
    var names: []i32 = []
    for symbol in symbols {
        names.push(out.len - string_table)
        bytes.append_utf8(&mut out, symbol); out.push(0)
    }
    string_size := out.len - string_table
    bytes.pad(&mut out, imports.align(out.len, 8) - out.len)
    dynsym := out.len
    bytes.pad(&mut out, 24)
    for name_off in names {
        bytes.append_le(&mut out, i64(name_off), 4)
        out.push(18); bytes.pad(&mut out, 19)
    }
    hash := out.len
    bytes.append_le(&mut out, 1, 4); bytes.append_le(&mut out, i64(symbols.len + 1), 4)
    if symbols.len > 0 { bytes.append_le(&mut out, 1, 4) } else { bytes.append_le(&mut out, 0, 4) }
    bytes.append_le(&mut out, 0, 4)
    for i in 0..symbols.len {
        if i + 1 == symbols.len { bytes.append_le(&mut out, 0, 4) }
        else { bytes.append_le(&mut out, i64(i + 2), 4) }
    }
    bytes.pad(&mut out, imports.align(out.len, 8) - out.len)
    rela := out.len
    var kind: i64 = 1025
    if machine == 62 { kind = 6 }
    for i in 0..symbols.len {
        bytes.append_le(&mut out, i64(base + data + i * 8), 8)
        bytes.append_le(&mut out, i64(i + 1) * 4294967296 + kind, 8)
        bytes.append_le(&mut out, 0, 8)
    }
    dynamic := out.len
    for library in needed { tag(&mut out, 1, library) }
    tag(&mut out, 4, base + hash); tag(&mut out, 5, base + string_table); tag(&mut out, 10, string_size)
    tag(&mut out, 6, base + dynsym); tag(&mut out, 11, 24); tag(&mut out, 7, base + rela)
    tag(&mut out, 8, symbols.len * 24); tag(&mut out, 9, 24); tag(&mut out, 24, 0); tag(&mut out, 0, 0)
    length := out.len
    var interp := "/lib/ld-linux-aarch64.so.1"
    if machine == 62 { interp = "/lib64/ld-linux-x86-64.so.2" }
    for i in 0..interp.len { out[512 + i] = u8(interp[i]) }
    imports.set_le(&mut out, 56, 6, 2)
    phdr(&mut out, 0, 6, 4, 64, 336, 8)
    phdr(&mut out, 1, 3, 4, 512, interp.len + 1, 1)
    phdr(&mut out, 2, 1, 5, 0, data, 4096)
    phdr(&mut out, 3, 1, 6, data, length - data, 4096)
    phdr(&mut out, 4, 2, 6, dynamic, length - dynamic, 8)
    phdr(&mut out, 5, 1685382481, 6, 0, 0, 16)
    out
}
