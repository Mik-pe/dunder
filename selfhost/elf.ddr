// Standalone little-endian ELF64 for Linux ARM64, with a non-executable stack.
import std.bytes as bytes

fn u16le(output: &mut []i32, value: i32) {
    output.push(value % 256); output.push(value / 256)
}

pub fn image(text: &[]i32) -> []i32 {
    var output: []i32 = []
    output.reserve(4096 + text.len)
    output.push(127); bytes.append_text(&mut output, "ELF")
    output.push(2); output.push(1); output.push(1); bytes.zeros(&mut output, 9)
    u16le(&mut output, 2); u16le(&mut output, 183)
    bytes.u32le(&mut output, 1)
    bytes.u64le(&mut output, 4198400); bytes.u64le(&mut output, 64)
    bytes.u64le(&mut output, 0); bytes.u32le(&mut output, 0)
    u16le(&mut output, 64); u16le(&mut output, 56); u16le(&mut output, 2)
    u16le(&mut output, 0); u16le(&mut output, 0); u16le(&mut output, 0)

    // A single read/execute mapping contains both headers and code.
    bytes.u32le(&mut output, 1); bytes.u32le(&mut output, 5)
    bytes.u64le(&mut output, 0)
    bytes.u64le(&mut output, 4194304); bytes.u64le(&mut output, 4194304)
    size := i64(4096 + text.len)
    bytes.u64le(&mut output, size); bytes.u64le(&mut output, size)
    bytes.u64le(&mut output, 4096)

    bytes.u32le(&mut output, 1685382481); bytes.u32le(&mut output, 6)
    bytes.zeros(&mut output, 40); bytes.u64le(&mut output, 16)
    bytes.zeros(&mut output, 4096 - output.len)
    bytes.append(&mut output, &text)
    output
}

@test fn elf_has_an_arm64_entry_and_a_non_executable_stack() {
    code: []i32 = [1, 2, 3, 4]
    output := image(&code)
    assert(output.len == 4100)
    assert(output[0] == 127 && output[1] == 69 && output[2] == 76 && output[3] == 70)
    assert(output[4] == 2 && output[5] == 1)
    assert(output[18] == 183 && output[19] == 0)
    assert(output[24] == 0 && output[25] == 16 && output[26] == 64)
    assert(output[56] == 2 && output[64] == 1 && output[68] == 5)
    assert(output[96] == 4 && output[97] == 16)
    assert(output[120] == 81 && output[121] == 229 && output[122] == 116 && output[123] == 100)
    assert(output[124] == 6 && output[168] == 16)
    assert(output[4096] == 1 && output[4099] == 4)
}
