// Floating aggregate and scalar register transfers shared by the native targets.
import arm64 as arm

pub fn width(ty: i32) -> i32 {
    if ty == 3 || ty == 8 { return 1 }
    if ty == 9 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 { return 4 }
    8
}
pub fn load(code: &mut arm.Code, dst: i32, base: i32, offset: i32, size: i32) {
    var op: i64 = 4181721088
    if size == 4 { op = 3107979264 }; if size == 2 { op = 2034237440 }; if size == 1 { op = 960495616 }
    arm.emit(&mut code, op + i64(offset / size) * 1024 + i64(base) * 32 + i64(dst))
}
pub fn store(code: &mut arm.Code, src: i32, base: i32, offset: i32, size: i32) {
    var op: i64 = 4177526784
    if size == 4 { op = 3103784960 }; if size == 2 { op = 2030043136 }; if size == 1 { op = 956301312 }
    arm.emit(&mut code, op + i64(offset / size) * 1024 + i64(base) * 32 + i64(src))
}
pub fn fp(code: &mut arm.Code, reg: i32, general: i32, size: i32, into_fp: bool) {
    var op: i64 = 2657550336
    if size == 4 { op = 505872384 }
    if into_fp { arm.emit(&mut code, op + i64(general) * 32 + i64(reg)) }
    else { arm.emit(&mut code, op - 65536 + i64(reg) * 32 + i64(general)) }
}
pub fn copy(code: &mut arm.Code, dst: i32, src: i32, size: i32) {
    var off := 0
    while off < size {
        var step := size - off
        if step > 8 { step = 8 }
        load(&mut code, 12, src, off, step); store(&mut code, 12, dst, off, step)
        off = off + step
    }
}
pub fn hfa(code: &mut arm.Code, base: i32, first: i32, shape: i32, into_fp: bool) {
    var stride := 4; var size := shape * 4
    if shape < 0 { stride = 8; size = -shape * 8 }
    if code.platform == 2 { stride = 8 }
    var off := 0; var reg := first
    while off < size {
        var step := size - off; if step > stride { step = stride }
        if into_fp { load(&mut code, 12, base, off, step); fp(&mut code, reg, 12, step, true) }
        else { fp(&mut code, reg, 12, step, false); store(&mut code, 12, base, off, step) }
        off = off + step; reg = reg + 1
    }
}

// x10 receives the calling OS thread's token. Zero in the writable context
// means no Dunder -> C frame is active.
pub fn thread_token(code: &mut arm.Code) {
    if code.platform == 0 {
        arm.emit(&mut code, 3577466986); arm.emit(&mut code, 3544448330)
    } else { arm.emit(&mut code, 3577466954) }
}
