// Typed integer operations shared by the expression and scalar emitters.
// Register allocation and evaluation order remain the caller's responsibility.
import arm64 as arm
import unsigned

pub enum Method { Unknown, Not, And, Or, Xor, Left, Right, Add, Sub, Mul }
pub fn method(name: string) -> Method {
    if name == "bit_not" { return .Not }
    if name == "bit_and" { return .And }
    if name == "bit_or" { return .Or }
    if name == "bit_xor" { return .Xor }
    if name == "shl" { return .Left }
    if name == "shr" { return .Right }
    if name == "wrapping_add" { return .Add }
    if name == "wrapping_sub" { return .Sub }
    if name == "wrapping_mul" { return .Mul }
    .Unknown
}
pub fn is_shift(op: Method) -> bool { op == .Left || op == .Right }
fn normalize(code: &mut arm.Code, ty: i32) {
    if ty == 1 { arm.emit(&mut code, 2470476800) } // SXTW X0,W0
    else if unsigned.has(ty) { unsigned.mask(&mut code, ty) }
}
pub fn complement(code: &mut arm.Code, ty: i32) {
    arm.emit(&mut code, 2854224864); normalize(&mut code, ty)
}
// Register forms put their result in X0. W-register shifts of signed i32
// discard the sign extension before applying the logical shift.
fn registers(code: &mut arm.Code, op: Method, ty: i32, lhs: i32, rhs: i32) {
    var word: i64 = 0
    if op == .And { word = 2315255808 }
    else if op == .Or { word = 2852126720 }
    else if op == .Xor { word = 3388997632 }
    else if op == .Left { word = 2596282368 }
    else if op == .Right { word = 2596283392 }
    else if op == .Add { word = 2332033024 }
    else if op == .Sub { word = 3405774848 }
    else { assert(op == .Mul); word = 2600500224 }
    if ty == 1 { word = word.bit_and(2147483647) }
    arm.emit(&mut code, word + i64(lhs) * 32 + i64(rhs) * 65536)
    normalize(&mut code, ty)
}
pub fn dynamic(code: &mut arm.Code, op: Method, ty: i32, bounds: i32) {
    if is_shift(op) {
        arm.imm(&mut code, 2, i64(unsigned.width_for(ty, code.platform)))
        arm.emit(&mut code, 3942776863); arm.branch(&mut code, bounds, 4)
    }
    registers(&mut code, op, ty, 1, 0)
}
// X0 holds the receiver. UBFM retains precisely the source bits that
// survive a shift or low-bit mask at the language type's width.
pub fn immediate(code: &mut arm.Code, op: Method, ty: i32, value: i64, bounds: i32) {
    if is_shift(op) {
        width := i64(unsigned.width_for(ty, code.platform))
        if value < 0 || value >= width { arm.branch(&mut code, bounds, 0); return }
        if value == 0 { return }
        if op == .Right {
            arm.emit(&mut code, 3544186880 + value * 65536 + (width - 1) * 1024)
        } else {
            arm.emit(&mut code, 3544186880 + (64 - value) * 65536 + (width - 1 - value) * 1024)
            if ty == 1 { normalize(&mut code, ty) }
        }
        return
    }
    if op == .And && value.bit_and(value.wrapping_add(1)) == 0 {
        if value == 0 { arm.imm(&mut code, 0, 0); return }
        if value == -1 { return }
        var top := 0; var mask := value.shr(1)
        while mask != 0 { top = top + 1; mask = mask.shr(1) }
        arm.emit(&mut code, 3544186880 + i64(top) * 1024); return
    }
    if op == .Add || op == .Sub {
        field := arm.add_sub_field(value)
        if field >= 0 {
            if value != 0 {
                var word: i64 = 2432696320; if op == .Sub { word = 3506438144 }
                arm.emit(&mut code, word + field); normalize(&mut code, ty)
            }
            return
        }
    }
    arm.imm(&mut code, 1, value); registers(&mut code, op, ty, 0, 1)
}
// A proven operation can use the sign-extended register values directly.
// Otherwise check overflow at source width before extending a signed i32.
pub fn signed_add_sub(code: &mut arm.Code, ty: i32, subtract: bool, checked: bool, overflow: i32,
    dst: i32, lhs: i32, rhs: i32, field: i64) {
    var word: i64 = 0
    if field >= 0 { word = 285212672 + field }
    else { word = 184549376 + i64(rhs) * 65536 }
    narrow := checked && ty == 1
    if !narrow { word = word + 2147483648 }
    if subtract { word = word + 1073741824 }
    if checked { word = word + 536870912 }
    arm.emit(&mut code, word + i64(lhs) * 32 + i64(dst))
    if checked { arm.branch(&mut code, overflow, 8) }
    if narrow { arm.emit(&mut code, 2470476800 + i64(dst) * 33) }
}
pub fn relation(op: i32) -> i32 {
    if op == 6 { return 0 }; if op == 7 { return 1 }
    if op == 8 { return 11 }; if op == 9 { return 13 }; if op == 10 { return 12 }
    assert(op == 11); 10
}
