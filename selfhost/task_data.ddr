// First task-boundary clone domain. This describes the ACTUAL current clone
// implementation, not source-level immutability or a general Send guarantee.
// Input metadata is authoritative typed frontend metadata; names are absent.
//
// Current type kinds:0 primitive,1 owned array,2 record,3 tag enum,4/5 borrow,
// 6 fixed array,7 shared payload enum,8/9 callable,10 iterator,20/21 scratch.
// Other/future kinds (including task IDs) are denied until explicitly modeled.
// Primitive codes:0 unknown,1 unit,2 i32,3 i64,4 bool,5 string,6 rune,7 f32,
// 8 f64,9 u8,10 u16,11 u32,12 u64,13 usize,14 ptr,15 internal range.
// Opaque classes:0 transparent,1 unclassified,2 definition-checked Data,
// 3 thread-bound. Class2 still requires all representation fields to pass.
//
// Frontend hooks: append deny-by-default rows at type creation; set primitive
// codes from semantic builtin identities; seal complete only after declaration
// and layout validation. Opaque class2 is supplied by the defining declaration's
// checked classification, never by a type-name whitelist. Reanalyze after any
// schema change. Cached results must bind the COMPLETE field/layout schema and
// policy version; a nominal type ID alone cannot certify a changed record.
// The workspace borrows no input and stores no full metadata snapshot.
//
// status:1 complete,-1 malformed metadata,-2 resource/work limit,0 reset.
// Reasons:0 Data,1 unknown type,2 shared handle,3 borrow,4 raw address,
// 5 callable,6 scratch,7 iterator,8 opaque not classified,9 thread-bound,
// 10 unsupported array element clone,11 non-Data dependency,
// 12 non-inline C-layout field,13 recursive/unresolved representation,
// 14 incomplete type. A forward declaration is never an empty Data record.
pub opaque struct Workspace {
    accepted: []bool, inline: []bool, needs_inline: []bool, reasons: []i32,
    remaining: []i32, reverse_counts: []i32, edge_child: []i32, edge_parent: []i32,
    starts: []i32, fill: []i32, parents: []i32, queue: []i32,
    state: i32, work: i32, limit: i32,
}
pub fn new() -> Workspace { Workspace {
    accepted: [], inline: [], needs_inline: [], reasons: [], remaining: [], reverse_counts: [],
    edge_child: [], edge_parent: [], starts: [], fill: [], parents: [], queue: [],
    state: 0, work: 0, limit: 0 } }
pub fn status(w: &Workspace) -> i32 { w.state }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn is_data(w: &Workspace, ty: i32) -> bool {
    w.state == 1 && ty >= 0 && ty < w.accepted.len && w.accepted[ty]
}
pub fn inline_data(w: &Workspace, ty: i32) -> bool {
    is_data(&w, ty) && w.inline[ty]
}
pub fn reason(w: &Workspace, ty: i32) -> i32 {
    if w.state != 1 || ty < 0 || ty >= w.reasons.len { return -1 }; w.reasons[ty]
}
fn charge(w: &mut Workspace, amount: i32) -> bool {
    if amount < 0 || amount > w.limit - w.work { w.state = -2; return false }
    w.work = w.work + amount; true
}
fn reset(w: &mut Workspace, limit: i32) {
    w.accepted.clear(); w.inline.clear(); w.needs_inline.clear(); w.reasons.clear()
    w.remaining.clear(); w.reverse_counts.clear(); w.edge_child.clear(); w.edge_parent.clear()
    w.starts.clear(); w.fill.clear(); w.parents.clear(); w.queue.clear()
    w.state = 0; w.work = 0; w.limit = limit
}
fn scalar(code: i32) -> bool { (code >= 2 && code <= 4) || (code >= 6 && code <= 13) }
fn flat(kinds: &[]i32, primitives: &[]i32, ty: i32) -> bool {
    kinds[ty] == 3 || (kinds[ty] == 0 && scalar(primitives[ty]))
}
fn dependency(w: &mut Workspace, parent: i32, child: i32) -> bool {
    if w.edge_child.len >= 262144 { w.state = -2; return false }
    if !charge(&mut w, 8) { return false }
    w.edge_child.push(child); w.edge_parent.push(parent)
    w.remaining[parent] = w.remaining[parent] + 1
    w.reverse_counts[child] = w.reverse_counts[child] + 1; true
}
fn valid(w: &mut Workspace, kinds: &[]i32, bases: &[]i32, starts: &[]i32, counts: &[]i32,
    fields: &[]i32, primitives: &[]i32, complete: &[]bool, c_layout: &[]bool,
    opaque_owner: &[]i32, opaque_class: &[]i32) -> bool {
    n := kinds.len
    if bases.len != n || starts.len != n || counts.len != n || primitives.len != n ||
        complete.len != n || c_layout.len != n || opaque_owner.len != n || opaque_class.len != n { w.state = -1; return false }
    if n > 65536 || fields.len > 262144 { w.state = -2; return false }
    if !charge(&mut w, n * 13 + fields.len) { return false }
    for ty in 0..n {
        if primitives[ty] < 0 || opaque_owner[ty] < -1 || opaque_class[ty] < 0 ||
            (kinds[ty] != 0 && primitives[ty] != 0) || (c_layout[ty] && kinds[ty] != 2) ||
            (opaque_owner[ty] >= 0 && kinds[ty] != 2) ||
            (opaque_owner[ty] < 0 && opaque_class[ty] != 0) { w.state = -1; return false }
        if kinds[ty] == 1 || kinds[ty] == 6 {
            if bases[ty] < 0 || bases[ty] >= n || (kinds[ty] == 6 && counts[ty] < 0) { w.state = -1; return false }
        }
        if kinds[ty] == 2 || kinds[ty] == 3 {
            if starts[ty] < 0 || counts[ty] < 0 || counts[ty] > fields.len ||
                starts[ty] > fields.len - counts[ty] { w.state = -1; return false }
        }
    }
    for ty in fields { if ty < 0 || ty >= n { w.state = -1; return false } }
    true
}
pub fn analyze_budget(w: &mut Workspace, kinds: &[]i32, bases: &[]i32, starts: &[]i32,
    counts: &[]i32, fields: &[]i32, primitives: &[]i32, complete: &[]bool, c_layout: &[]bool,
    opaque_owner: &[]i32, opaque_class: &[]i32, limit: i32) -> bool {
    reset(&mut w, limit)
    if limit < 0 { w.state = -2; return false }
    if !valid(&mut w, &kinds, &bases, &starts, &counts, &fields, &primitives,
        &complete, &c_layout, &opaque_owner, &opaque_class) { return false }
    n := kinds.len
    for ty in 0..n {
        w.accepted.push(false); w.inline.push(false); w.needs_inline.push(c_layout[ty])
        w.reasons.push(1); w.remaining.push(0); w.reverse_counts.push(0)
    }
    for ty in 0..n {
        kind := kinds[ty]; var why := 1; var inline := false
        if kind == 0 {
            if primitives[ty] == 1 || scalar(primitives[ty]) { why = 0; inline = primitives[ty] != 1 }
            else if primitives[ty] == 5 { why = 2 }
            else if primitives[ty] == 14 { why = 4 }
        } else if kind == 3 { why = 0; inline = true }
        else if kind == 1 || kind == 6 {
            if flat(&kinds, &primitives, bases[ty]) { why = 0; inline = kind == 6 }
            else { why = 10 }
        } else if kind == 2 {
            why = 0; inline = c_layout[ty]
            if opaque_owner[ty] >= 0 {
                if opaque_class[ty] == 3 { why = 9 }
                else if opaque_class[ty] != 2 { why = 8 }
            }
        } else if kind == 4 || kind == 5 { why = 3 }
        else if kind == 7 { why = 2 }
        else if kind == 8 || kind == 9 { why = 5 }
        else if kind == 10 { why = 7 }
        else if kind == 20 || kind == 21 { why = 6 }
        if !complete[ty] { why = 14 }
        w.reasons[ty] = why; w.inline[ty] = inline
        if why != 0 { continue }
        if kind == 1 || kind == 6 {
            if !dependency(&mut w, ty, bases[ty]) { return false }
        } else if kind == 2 {
            for field in starts[ty]..starts[ty] + counts[ty] {
                child := fields[field]
                if kinds[child] == 0 && primitives[child] == 1 { w.reasons[ty] = 11 }
                if !dependency(&mut w, ty, child) { return false }
            }
        }
    }
    if !charge(&mut w, n * 4 + w.edge_child.len * 2) { return false }
    w.starts.push(0)
    for ty in 0..n { w.starts.push(w.starts[ty] + w.reverse_counts[ty]); w.fill.push(w.starts[ty]) }
    for edge in 0..w.edge_child.len { w.parents.push(0) }
    for edge in 0..w.edge_child.len {
        child := w.edge_child[edge]; at := w.fill[child]
        w.parents[at] = w.edge_parent[edge]; w.fill[child] = at + 1
    }
    for ty in 0..n {
        if w.remaining[ty] == 0 {
            w.accepted[ty] = w.reasons[ty] == 0; w.inline[ty] = w.inline[ty] && w.accepted[ty]
            w.queue.push(ty)
        }
    }
    var next := 0
    while next < w.queue.len {
        if !charge(&mut w, 2) { return false }
        child := w.queue[next]; next = next + 1
        for edge in w.starts[child]..w.starts[child + 1] {
            if !charge(&mut w, 4) { return false }
            parent := w.parents[edge]
            if w.reasons[parent] == 0 {
                if !w.accepted[child] { w.reasons[parent] = 11 }
                else if w.needs_inline[parent] && !w.inline[child] { w.reasons[parent] = 12 }
            }
            w.remaining[parent] = w.remaining[parent] - 1
            if w.remaining[parent] == 0 {
                w.accepted[parent] = w.reasons[parent] == 0
                w.inline[parent] = w.inline[parent] && w.accepted[parent]; w.queue.push(parent)
            }
        }
    }
    if !charge(&mut w, n) { return false }
    for ty in 0..n { if w.remaining[ty] > 0 && w.reasons[ty] == 0 { w.reasons[ty] = 13 } }
    w.state = 1; true
}
pub fn analyze_into(w: &mut Workspace, kinds: &[]i32, bases: &[]i32, starts: &[]i32,
    counts: &[]i32, fields: &[]i32, primitives: &[]i32, complete: &[]bool, c_layout: &[]bool,
    opaque_owner: &[]i32, opaque_class: &[]i32) -> bool {
    analyze_budget(&mut w, &kinds, &bases, &starts, &counts, &fields, &primitives,
        &complete, &c_layout, &opaque_owner, &opaque_class, 8388608)
}
