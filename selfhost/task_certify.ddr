// Task effect graph, Data isolation certification, and native task prefix
// emission for structured task scopes. Serial seed-compatible module.
import arm64 as arm
import frontend_types as ft
import runtime
import task_data
import task_effects
import task_native
import task_scope_emit

pub struct TaskCertificate {
    safe: []bool, inputs: []bool, outputs: []bool, workers: []bool, runtime: bool, at: i32,
}

pub fn task_certificate() -> TaskCertificate {
    TaskCertificate { safe: [], inputs: [], outputs: [], workers: [], runtime: false, at: 0 }
}

pub struct TaskGraph {
    program: bool,
    direct: []i64, complete: []bool, edges_from: []i32, edges_to: []i32,
    initializers: []i32, initializer_ats: []i32, shared: []i32, shared_ats: []i32,
    spawn_workers: []i32, spawn_callers: []i32, spawn_ats: []i32,
    uses: []bool, use_ats: []i32, reachable: []bool,
    spawners: []i32,
    open: i32, await_result: i32, close: i32, coordinator: i32,
}

pub fn new_graph() -> TaskGraph {
    TaskGraph {
        program: false,
        direct: [], complete: [], edges_from: [], edges_to: [],
        initializers: [], initializer_ats: [], shared: [], shared_ats: [],
        spawn_workers: [], spawn_callers: [], spawn_ats: [],
        uses: [], use_ats: [], reachable: [],
        spawners: [],
        open: -1, await_result: -1, close: -1, coordinator: -1,
    }
}

pub fn add_function(g: &mut TaskGraph, foreign: bool) {
    var effects: i64 = 0
    if foreign { effects = 32 }
    g.direct.push(effects); g.complete.push(foreign); g.uses.push(false)
    g.use_ats.push(-1); g.spawners.push(-1)
}

pub fn record_workspace(g: &mut TaskGraph, factory: i32, at: i32) {
    for existing in g.initializers { if existing == factory { return } }
    g.initializers.push(factory); g.initializer_ats.push(at)
}
// A body-local collection has no persistent type ID. Certify its declared
// element under the same Data rule before recycling the local shape arena.
pub fn shared_data_type(reg: &ft.TypeRegistry, ty: i32) -> i32 {
    if ty < reg.declared.type_kinds.len { return ty }
    kind := ft.type_kind(&reg, ty)
    if kind != 1 && kind != 6 { return -1 }
    element := ft.type_base(&reg, ty)
    if element >= reg.declared.type_kinds.len { return -1 }
    ek := ft.type_kind(&reg, element)
    if !task_data.flat_element(ek, task_data.compiler_primitive_code(ek, element)) { return -1 }
    element
}
pub fn record_shared(g: &mut TaskGraph, ty: i32, at: i32) {
    for existing in g.shared { if existing == ty { return } }
    g.shared.push(ty); g.shared_ats.push(at)
}
// The workspace is constructed in its exclusive worker arena. It never enters
// a program-visible parent value or the input/result clone domain. Inspect the
// representation, including opaque fields, to exclude addresses and capabilities.
fn local_storage(reg: &ft.TypeRegistry, root: i32) -> bool {
    var seen: []bool = []; seen.reserve(reg.declared.type_kinds.len)
    for kind in reg.declared.type_kinds { seen.push(false) }
    var pending: []i32 = [root]
    while pending.len > 0 {
        ty := pending.pop()
        if seen[ty] { continue }; seen[ty] = true
        kind := reg.declared.type_kinds[ty]
        if kind == 2 {
            for at in reg.declared.type_starts[ty]..reg.declared.type_starts[ty] + reg.declared.type_counts[ty] {
                pending.push(reg.field_types[at])
            }
        } else if kind == 1 || kind == 6 {
            pending.push(reg.declared.type_bases[ty])
        } else if kind != 3 && !(kind == 0 && ty >= 1 && ty <= 12) {
            return false
        }
    }
    true
}
pub fn certify(g: &TaskGraph, reg: &ft.TypeRegistry, token_starts: &[]i32,
    fn_count: i32, param_starts: &[]i32, param_counts: &[]i32, param_types: &[]i32,
    returns: &[]i32, certificate: &mut TaskCertificate, error_cursor: &mut i32) -> string {
    var data := task_data.new(); var effects := task_effects.new()
    var primitives: []i32 = []; var complete: []bool = []; var classes: []i32 = []
    primitives.reserve(reg.declared.type_kinds.len); complete.reserve(reg.declared.type_kinds.len); classes.reserve(reg.declared.type_kinds.len)
    for ty in 0..reg.declared.type_kinds.len {
        primitives.push(task_data.compiler_primitive_code(reg.declared.type_kinds[ty], ty)); complete.push(true)
        var classification := 0; if reg.opaque_owner[ty] >= 0 { classification = 1 }; classes.push(classification)
    }
    if !task_data.analyze_into(&mut data, &reg.declared.type_kinds, &reg.declared.type_bases, &reg.declared.type_starts, &reg.declared.type_counts,
        &reg.field_types, &primitives, &complete, &reg.c_record, &reg.opaque_owner, &classes) {
        return "internal isolated task Data metadata failure"
    }
    var counts: []i32 = []; var starts: []i32 = [0]; var fill: []i32 = []; var targets: []i32 = []
    counts.reserve(fn_count); starts.reserve(fn_count + 1); fill.reserve(fn_count)
    for f in 0..fn_count { counts.push(0) }
    for e in 0..g.edges_from.len {
        from := g.edges_from[e]; counts[from] = counts[from] + 1; targets.push(-1)
    }
    for f in 0..fn_count { starts.push(starts[f] + counts[f]); fill.push(starts[f]) }
    for e in 0..g.edges_from.len {
        from := g.edges_from[e]; targets[fill[from]] = g.edges_to[e]; fill[from] = fill[from] + 1
    }
    if !task_effects.analyze_into(&mut effects, &g.direct, &g.complete, &starts, &targets) {
        return "isolated task effect analysis exceeded its resource limit"
    }
    for f in 0..fn_count {
        certificate.safe.push(task_effects.worker_safe(&effects, f)); certificate.workers.push(false)
        var input := false
        first := param_starts[f]
        if param_counts[f] >= 1 && param_counts[f] <= 3 {
            input = task_data.is_data(&data, param_types[first])
        }
        certificate.inputs.push(input); certificate.outputs.push(task_data.is_data(&data, returns[f]))
        if g.reachable[f] && g.uses[f] && !certificate.runtime {
            certificate.runtime = true; certificate.at = token_starts[g.use_ats[f]]
        }
    }
    for i in 0..g.shared.len {
        if !task_data.is_data(&data, g.shared[i]) {
            error_cursor = g.shared_ats[i]; return "shared task input requires isolated Data without shared managed handles"
        }
    }
    for i in 0..g.initializers.len {
        factory := g.initializers[i]; error_cursor = g.initializer_ats[i]
        if !certificate.safe[factory] { return "task workspace initializer has effects outside its isolated runtime" }
        if !local_storage(&reg, returns[factory]) { return "task workspace contains a value outside isolated storage" }
    }
    for s in 0..g.spawn_workers.len {
        worker := g.spawn_workers[s]; error_cursor = g.spawn_ats[s]
        if !certificate.inputs[worker] { return "task worker input must be isolated Data" }
        if !certificate.outputs[worker] { return "task worker result must be isolated Data" }
        if !certificate.safe[worker] { return "task worker has effects outside its isolated runtime" }
        if g.reachable[g.spawn_callers[s]] { certificate.workers[worker] = true }
    }
    ""
}

pub struct PrefixPlan {
    worker_ids: []i32, fn_labels: []i32, results: []i32,
    input_clones: []i32, result_clones: []i32, result_drops: []i32,
}

pub struct PrefixOutput {
    ok: bool, error: string, trap: i32, coordinator: i32, open: i32, await_result: i32, close: i32,
    spawners: []i32, import_sites: []i32, import_slots: []i32, import_globals: i32,
}

pub fn build_prefix_plan(certificate: &TaskCertificate, reg: &ft.TypeRegistry, helper_labels: &[]i32,
    param_starts: &[]i32, param_types: &[]i32, returns: &[]i32, fn_labels: &[]i32) -> PrefixPlan {
    var plan := PrefixPlan { worker_ids: [], fn_labels: [], results: [],
        input_clones: [], result_clones: [], result_drops: [] }
    for f in 0..certificate.workers.len {
        if !certificate.workers[f] { continue }
        input := param_types[param_starts[f]]; result := returns[f]
        var input_clone := -1; var result_clone := -1; var result_drop := -1
        if ft.owned(&reg, input) { input_clone = helper_labels[input] }
        if ft.owned(&reg, result) { result_clone = helper_labels[result]; result_drop = helper_labels[result] + 1 }
        plan.worker_ids.push(f); plan.fn_labels.push(fn_labels[f]); plan.results.push(result)
        plan.input_clones.push(input_clone)
        plan.result_clones.push(result_clone); plan.result_drops.push(result_drop)
    }
    plan
}

pub fn coordinator_offset(globals: i32) -> i32 {
    offset := (globals + 15) / 16 * 16
    if offset < 64 { return 64 }; offset
}
pub fn after_coordinator(offset: i32) -> i32 { offset + task_scope_emit.coordinator_bytes() }

pub fn emit_prefix(code: &mut arm.Code, rt: &runtime.Runtime, plan: &PrefixPlan,
    symbols: &task_native.Symbols, globals: i32) -> PrefixOutput {
    var out := PrefixOutput { ok: false, error: "", trap: -1, coordinator: -1, open: -1, await_result: -1, close: -1,
        spawners: [], import_sites: [], import_slots: [], import_globals: globals }
    out.trap = arm.label(&mut code); arm.mark(&mut code, out.trap); arm.exit(&mut code, 112)
    unmap_helper := task_native.emit_unmap_pool(&mut code, &symbols)
    if !unmap_helper.ok { out.error = unmap_helper.error; return out }
    for i in 0..unmap_helper.import_sites.len {
        out.import_sites.push(unmap_helper.import_sites[i]); out.import_slots.push(unmap_helper.import_slots[i])
    }
    emitted := task_scope_emit.emit_runtime(&mut code, &rt, out.trap, unmap_helper.label)
    if !emitted.ok { out.error = emitted.error; return out }
    out.open = emitted.open; out.await_result = emitted.await_result; out.close = emitted.close
    for w in 0..plan.worker_ids.len {
        input_clone := plan.input_clones[w]
        result_clone := plan.result_clones[w]; result_drop := plan.result_drops[w]
        spec := task_native.TaskSpec { input_clone: input_clone, worker: plan.fn_labels[w], result_clone: result_clone, result_drop: result_drop }
        native := task_native.emit(&mut code, &rt, &spec, &symbols)
        if !native.ok { out.error = native.error; return out }
        for i in 0..native.import_sites.len { out.import_sites.push(native.import_sites[i]); out.import_slots.push(native.import_slots[i]) }
        kind_spec := task_scope_emit.KindSpec { result_type: plan.results[w], create: native.create, collect: native.collect, discard: native.discard,
            result_clone: result_clone, result_drop: result_drop }
        offset := (out.import_globals + 15) / 16 * 16; out.import_globals = offset + task_scope_emit.kind_bytes()
        kind := task_scope_emit.emit_kind(&mut code, &emitted, &kind_spec, -1 - offset)
        if !kind.ok { out.error = kind.error; return out }
        out.spawners.push(kind.spawn)
        for i in 0..kind.import_sites.len { out.import_sites.push(kind.import_sites[i]); out.import_slots.push(kind.import_slots[i]) }
    }
    out.ok = true; out
}
