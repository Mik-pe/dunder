    arm.mark(&mut c, next_three); ci(&mut c, 0, 240); arm.branch(&mut c, next_four, 4)
    si(&mut c, 0, 0, 224); arm.imm(&mut c, 11, 2); arm.branch(&mut c, next_decode, 0)
    arm.mark(&mut c, next_four); si(&mut c, 0, 0, 240); arm.imm(&mut c, 11, 3)
    arm.mark(&mut c, next_decode); shl(&mut c, 0, 0, 6); lb(&mut c, 12, 10); si(&mut c, 12, 12, 128); add(&mut c, 0, 0, 12)
