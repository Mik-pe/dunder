    again := arm.label(&mut code); failed := arm.label(&mut code); error := arm.label(&mut code); complete := arm.label(&mut code)
    arm.mark(&mut code, again); ci(&mut code, 2, 0); arm.branch(&mut code, complete, 2)
    arm.imm(&mut code, 0, 2); arm.syscall(&mut code, 33554436, 64)
    if code.platform == 0 { arm.branch(&mut code, error, 4) }
    else { ci(&mut code, 0, 0); arm.branch(&mut code, error, 13) }
    arm.branch(&mut code, failed, 18)
