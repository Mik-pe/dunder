fn profile_segments() -> []string {
    ["{\"kind\":\"runtime_profile\",\"version\":1,\"units\":{\"counts\":\"events\",\"bytes\":\"bytes\"},\"counter_arithmetic\":\"uint64_modulo\",\"allocation_header_bytes\":16,\"pool_header_bytes\":512,\"requested_bytes_exclude_allocator_header\":true,\"size_class_payload_excludes_header\":true,\"counters\":{\"allocation_count\":",
     ",\"requested_bytes\":", ",\"size_class_payload_bytes\":", ",\"fresh_allocations\":", ",\"reused_allocations\":",
     ",\"retain_calls\":", ",\"release_calls\":", ",\"array_clone_calls\":", ",\"array_clone_bytes\":",
     ",\"string_slice_calls\":", ",\"string_slice_bytes\":", ",\"record_construct_calls\":", ",\"record_construct_bytes\":",
     ",\"record_clone_calls\":", ",\"record_clone_bytes\":", ",\"copy_bytes\":", "}}\n"]
}
pub fn emit_profile_start(code: &mut arm.Code, r: &Runtime) {
    if code.profile { assert(code.platform != 3); call(&mut code, r.profile_start) }
}
pub fn emit_profile_report(code: &mut arm.Code, r: &Runtime) {
    if code.profile { assert(code.platform != 3); call(&mut code, r.profile_report) }
}
pub fn emit_profile_data(code: &mut arm.Code, r: &Runtime) {
    if !code.profile { return }
    arm.mark(&mut code, r.profile_data)
    var word: i64 = 0; var shift := 0
    for segment in profile_segments() {
        for byte in segment.bytes() {
            word = word + i64(byte).shl(shift); shift = shift + 8
            if shift == 32 { arm.emit(&mut code, word); word = 0; shift = 0 }
        }
    }
    if shift != 0 { arm.emit(&mut code, word) }
}
fn profile_helpers(code: &mut arm.Code, r: &Runtime) {
    if !code.profile { return }
    assert(code.platform != 3)
    ready := arm.label(&mut code); map_failed := arm.label(&mut code)
    begin(&mut code, r.profile_start, 0)
    ci(&mut code, 19, 0); arm.branch(&mut code, ready, 3)
    arm.imm(&mut code, 0, 0); arm.imm(&mut code, 1, 536870912); arm.imm(&mut code, 2, 3)
    if code.platform == 0 { arm.imm(&mut code, 3, 4098) } else { arm.imm(&mut code, 3, 34) }
    arm.imm(&mut code, 4, -1); arm.imm(&mut code, 5, 0); arm.syscall(&mut code, 33554629, 222)
    if code.platform == 0 { arm.branch(&mut code, map_failed, 4) }
    else { ci(&mut code, 0, 0); arm.branch(&mut code, map_failed, 13) }
    arm.mov(&mut code, 21, 0); ai(&mut code, 19, 0, 512)
    arm.imm(&mut code, 10, 536870912); add(&mut code, 20, 21, 10)
    arm.mark(&mut code, ready)
