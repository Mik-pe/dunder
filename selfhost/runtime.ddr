        array_reserve: arm.label(&mut code), array_push: arm.label(&mut code), array_pop: arm.label(&mut code),
        string_concat: arm.label(&mut code), string_compare: arm.label(&mut code), string_slice: arm.label(&mut code),
        string_integer: arm.label(&mut code), string_bool: arm.label(&mut code), string_rune: arm.label(&mut code),
