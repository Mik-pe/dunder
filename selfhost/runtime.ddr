fn ci(c: &mut arm.Code, a: i32, n: i32) { arm.emit(&mut c, 4043309087 + i64(n) * 1024 + i64(a) * 32) }
fn shl(c: &mut arm.Code, d: i32, a: i32, n: i32) { arm.emit(&mut c, 3544186880 + i64(64 - n) * 65536 + i64(63 - n) * 1024 + i64(a) * 32 + i64(d)) }
