    arm.mark(&mut c, decode); shl(&mut c, 13, 13, 6); lb(&mut c, 15, 10); si(&mut c, 15, 15, 128); add(&mut c, 13, 13, 15)
    ai(&mut c, 10, 10, 1); si(&mut c, 12, 12, 1); si(&mut c, 14, 14, 1); ci(&mut c, 14, 0); arm.branch(&mut c, decode, 3)
    arm.mark(&mut c, append); st(&mut c, 13, 11, 0); ai(&mut c, 11, 11, 8); ai(&mut c, 16, 16, 1); arm.branch(&mut c, rune_loop, 0)
