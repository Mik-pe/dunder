    else { arm.imm(&mut code, 3, -4); cmp(&mut code, 0, 3) }
    arm.branch(&mut code, again, 2)
    arm.mark(&mut code, failed); arm.imm(&mut code, 0, 0); leaf(&mut code)
    arm.mark(&mut code, complete); arm.imm(&mut code, 0, 1); leaf(&mut code)
