pub fn emit_runtime(code: &mut arm.Code, r: &Runtime) {
    trap := arm.label(&mut code)
    allocator(&mut code, &r, trap); arrays(&mut code, &r, trap); strings(&mut code, &r, trap)
    format(&mut code, &r, trap); conversions(&mut code, &r)
    s := sys.Sys {arg_count:r.sys_arg_count,arg:r.sys_arg,pid:r.sys_pid,read_text:r.sys_read_text,
        metadata:r.sys_metadata,same_file:r.sys_same_file,write_bytes:r.sys_write_bytes,
        make_executable:r.sys_make_executable,rename:r.sys_rename,remove_file:r.sys_remove_file,
        decode_utf8:r.sys_decode_utf8,stderr:r.sys_stderr,write_text:r.sys_write_text,append_text:r.sys_append_text,mkdir:r.sys_mkdir,remove_dir:r.sys_remove_dir}
    sys.emit_runtime(&mut code, &s, r.alloc, r.release)
    arm.mark(&mut code, trap); arm.exit(&mut code, 103)
}
