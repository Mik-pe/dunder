// Bounded scalar simplification and local loop proofs. The parser validates
// the entire typed function, including unreachable branches, before this pass.
import opt_ir as ir

struct Facts { known: []bool, values: []i64 }

fn step(f: &mut ir.Function, depth: i32) -> bool {
    if f.budget_exhausted { return false }
    if f.visits >= 65536 || depth > 64 {
        f.budget_exhausted = true
        return false
    }
    f.visits = f.visits + 1
    true
}
fn constant(f: &mut ir.Function, node: i32, value: i64) {
    f.kinds[node] = 1; f.values[node] = value
    f.left[node] = -1; f.right[node] = -1; f.third[node] = -1; f.locals[node] = -1
    f.effects[node] = 0; f.proofs[node] = 0
    f.rewrites = f.rewrites + 1
}
// Keep the outer statement's successor. Detached nodes remain in the scratch
// arrays; only nodes reachable from root describe the optimized function.
fn replace(f: &mut ir.Function, destination: i32, source: i32) {
    f.kinds[destination] = f.kinds[source]; f.types[destination] = f.types[source]
    f.left[destination] = f.left[source]; f.right[destination] = f.right[source]
    f.third[destination] = f.third[source]; f.values[destination] = f.values[source]
    f.locals[destination] = f.locals[source]; f.effects[destination] = f.effects[source]
    f.proofs[destination] = f.proofs[source]; f.starts[destination] = f.starts[source]
    f.rewrites = f.rewrites + 1
}
fn empty_block(f: &mut ir.Function, node: i32) {
    f.kinds[node] = 10; f.types[node] = 0
    f.left[node] = -1; f.right[node] = -1; f.third[node] = -1; f.locals[node] = -1
    f.values[node] = 0; f.effects[node] = 0; f.proofs[node] = 0
    f.rewrites = f.rewrites + 1
}
fn fold_binary(f: &mut ir.Function, node: i32) {
    left := f.left[node]; right := f.right[node]; op := f.values[node]
    if f.kinds[left] != 1 || f.kinds[right] != 1 { return }
    a := f.values[left]; b := f.values[right]
    var value: i64 = 0; var valid := true
    if op == 1 {
        value = a.wrapping_add(b)
        valid = a.bit_xor(value).bit_and(b.bit_xor(value)) >= 0
    } else if op == 2 {
        value = a.wrapping_sub(b)
        valid = a.bit_xor(b).bit_and(a.bit_xor(value)) >= 0
    } else if op == 3 {
        value = a.wrapping_mul(b)
        if a == 0 || b == 0 { valid = true }
        else if (a == -9223372036854775808 && b == -1) || (b == -9223372036854775808 && a == -1) { valid = false }
        else { valid = value / b == a }
    } else if op == 4 || op == 5 {
        var minimum: i64 = -9223372036854775808
        if f.types[node] == 1 { minimum = -2147483648 }
        if b == 0 || (a == minimum && b == -1) { valid = false }
        else if op == 4 { value = a / b } else { value = a % b }
    } else if op == 6 { if a == b { value = 1 } }
    else if op == 7 { if a != b { value = 1 } }
    else if op == 8 { if a < b { value = 1 } }
    else if op == 9 { if a <= b { value = 1 } }
    else if op == 10 { if a > b { value = 1 } }
    else if op == 11 { if a >= b { value = 1 } }
    else if op == 12 { if a != 0 && b != 0 { value = 1 } }
    else if op == 13 { if a != 0 || b != 0 { value = 1 } }
    else { valid = false }
    if f.types[node] == 1 && (value < -2147483648 || value > 2147483647) { valid = false }
    if valid { constant(&mut f, node, value) }
}
fn expression(f: &mut ir.Function, node: i32, facts: &Facts, depth: i32) {
    if node < 0 || !step(&mut f, depth) { return }
    kind := f.kinds[node]
    if kind == 2 {
        local := f.locals[node]
        if facts.known[local] { constant(&mut f, node, facts.values[local]) }
    } else if kind == 3 {
        left := f.left[node]; right := f.right[node]; op := f.values[node]
        expression(&mut f, left, &facts, depth + 1)
        if f.budget_exhausted { return }
        if (op == 12 || op == 13) && f.kinds[left] == 1 {
            value := f.values[left]
            if (op == 12 && value == 0) || (op == 13 && value != 0) {
                // Never visit or evaluate the skipped operand, which may trap.
                constant(&mut f, node, value); return
            }
            expression(&mut f, right, &facts, depth + 1)
            if !f.budget_exhausted { replace(&mut f, node, right) }
            return
        }
        expression(&mut f, right, &facts, depth + 1)
        if !f.budget_exhausted { fold_binary(&mut f, node) }
    } else if kind == 4 {
        operand := f.left[node]
        expression(&mut f, operand, &facts, depth + 1)
        if f.budget_exhausted || f.kinds[operand] != 1 { return }
        value := f.values[operand]
        if f.values[node] == 2 {
            var result: i64 = 0; if value == 0 { result = 1 }
            constant(&mut f, node, result)
        } else if f.values[node] == 1 {
            var minimum: i64 = -9223372036854775808
            if f.types[node] == 1 { minimum = -2147483648 }
            if value != minimum { constant(&mut f, node, -value) }
        }
    } else if kind == 6 { expression(&mut f, f.left[node], &facts, depth + 1) }
}
fn forget(f: &mut ir.Function, facts: &mut Facts, depth: i32) {
    for i in 0..facts.known.len {
        if !step(&mut f, depth) { return }
        facts.known[i] = false
    }
}
// Kill writes before visiting a loop's condition: propagating the preheader's
// i=0 into the loop condition/body would change every later iteration.
fn kill_writes(f: &mut ir.Function, first: i32, facts: &mut Facts, depth: i32) {
    var node := first
    while node >= 0 {
        if !step(&mut f, depth) { return }
        kind := f.kinds[node]
        if kind == 11 || kind == 12 { facts.known[f.locals[node]] = false }
        else if kind == 10 { kill_writes(&mut f, f.left[node], &mut facts, depth + 1) }
        else if kind == 13 {
            kill_writes(&mut f, f.right[node], &mut facts, depth + 1)
            kill_writes(&mut f, f.third[node], &mut facts, depth + 1)
        } else if kind == 14 { kill_writes(&mut f, f.right[node], &mut facts, depth + 1) }
        node = f.next[node]
    }
}
fn induction(f: &ir.Function, node: i32, facts: &Facts) -> i32 {
    condition := f.left[node]
    if f.kinds[condition] != 3 || f.values[condition] != 8 { return -1 }
    left := f.left[condition]; right := f.right[condition]
    if f.kinds[left] != 2 || f.kinds[right] != 5 { return -1 }
    local := f.locals[left]; array := f.locals[right]
    if f.local_types[local] != 1 || !facts.known[local] || facts.values[local] != 0 { return -1 }
    if f.local_types[array] != 20 || f.local_param[array] < 0 || f.local_mutable[array] { return -1 }
    local
}
// The only write to the induction variable must be the final top-level +1.
// Nested loops and continue are conservatively outside this first proof.
fn invariant_prefix(f: &mut ir.Function, first: i32, stop: i32, local: i32, depth: i32) -> bool {
    var node := first
    while node >= 0 && node != stop {
        if !step(&mut f, depth) { return false }
        kind := f.kinds[node]
        if (kind == 11 || kind == 12) && f.locals[node] == local { return false }
        if kind == 14 || kind == 17 { return false }
        if kind == 10 && !invariant_prefix(&mut f, f.left[node], -1, local, depth + 1) { return false }
        if kind == 13 {
            if !invariant_prefix(&mut f, f.right[node], -1, local, depth + 1) { return false }
            if !invariant_prefix(&mut f, f.third[node], -1, local, depth + 1) { return false }
        }
        node = f.next[node]
    }
    !f.budget_exhausted
}
fn mark_indices(f: &mut ir.Function, first: i32, stop: i32, local: i32, array: i32, depth: i32) {
    var node := first
    while node >= 0 && node != stop {
        if !step(&mut f, depth) { return }
        kind := f.kinds[node]
        if kind == 6 && f.locals[node] == array {
            index := f.left[node]
            if f.kinds[index] == 2 && f.locals[index] == local && f.proofs[node].bit_and(2) == 0 {
                f.proofs[node] = f.proofs[node].bit_or(2); f.rewrites = f.rewrites + 1
            }
        }
        mark_indices(&mut f, f.left[node], -1, local, array, depth + 1)
        mark_indices(&mut f, f.right[node], -1, local, array, depth + 1)
        mark_indices(&mut f, f.third[node], -1, local, array, depth + 1)
        node = f.next[node]
    }
}
fn prove_loop(f: &mut ir.Function, node: i32, local: i32) {
    if local < 0 || f.budget_exhausted { return }
    condition := f.left[node]
    // Constant propagation may simplify this condition, so recheck its shape.
    if f.kinds[condition] != 3 || f.values[condition] != 8 { return }
    lhs := f.left[condition]; rhs := f.right[condition]
    if f.kinds[lhs] != 2 || f.locals[lhs] != local || f.kinds[rhs] != 5 { return }
    array := f.locals[rhs]
    body := f.right[node]; first := f.left[body]; var last := first
    if first < 0 { return }
    while f.next[last] >= 0 {
        if !step(&mut f, 0) { return }
        last = f.next[last]
    }
    if f.kinds[last] != 12 || f.locals[last] != local { return }
    value := f.left[last]
    if f.kinds[value] != 3 || f.values[value] != 1 || f.types[value] != 1 { return }
    a := f.left[value]; b := f.right[value]
    valid := (f.kinds[a] == 2 && f.locals[a] == local && f.kinds[b] == 1 && f.values[b] == 1) ||
        (f.kinds[b] == 2 && f.locals[b] == local && f.kinds[a] == 1 && f.values[a] == 1)
    if !valid || !invariant_prefix(&mut f, first, last, local, 0) { return }
    // i starts at zero, is unchanged through the prefix, and each backedge
    // executes +1 under i<len. Thus 0<=i<len<=i32::MAX before each index and
    // i<=i32::MAX-1 before the increment. Reductions retain their checks.
    mark_indices(&mut f, first, last, local, array, 0)
    if !f.budget_exhausted && f.proofs[value].bit_and(1) == 0 {
        f.proofs[value] = f.proofs[value].bit_or(1); f.rewrites = f.rewrites + 1
    }
}
fn statements(f: &mut ir.Function, first: i32, facts: &mut Facts, depth: i32) {
    var node := first
    while node >= 0 {
        if !step(&mut f, depth) { return }
        kind := f.kinds[node]
        if kind == 10 { statements(&mut f, f.left[node], &mut facts, depth + 1) }
        else if kind == 11 || kind == 12 {
            value := f.left[node]; local := f.locals[node]
            expression(&mut f, value, &facts, depth + 1)
            if f.budget_exhausted { return }
            facts.known[local] = f.kinds[value] == 1
            if facts.known[local] { facts.values[local] = f.values[value] }
        } else if kind == 13 {
            condition := f.left[node]
            expression(&mut f, condition, &facts, depth + 1)
            if f.budget_exhausted { return }
            if f.kinds[condition] == 1 {
                var chosen := f.third[node]; if f.values[condition] != 0 { chosen = f.right[node] }
                if chosen < 0 { empty_block(&mut f, node) }
                else { replace(&mut f, node, chosen); statements(&mut f, f.left[node], &mut facts, depth + 1) }
            } else {
                forget(&mut f, &mut facts, depth)
                statements(&mut f, f.right[node], &mut facts, depth + 1)
                forget(&mut f, &mut facts, depth)
                statements(&mut f, f.third[node], &mut facts, depth + 1)
                forget(&mut f, &mut facts, depth)
            }
        } else if kind == 14 {
            index := induction(&f, node, &facts)
            kill_writes(&mut f, f.right[node], &mut facts, depth + 1)
            if f.budget_exhausted { return }
            expression(&mut f, f.left[node], &facts, depth + 1)
            if f.budget_exhausted { return }
            condition := f.left[node]
            if f.kinds[condition] == 1 && f.values[condition] == 0 { empty_block(&mut f, node) }
            else {
                statements(&mut f, f.right[node], &mut facts, depth + 1)
                prove_loop(&mut f, node, index)
                kill_writes(&mut f, f.right[node], &mut facts, depth + 1)
            }
        } else if kind == 15 { expression(&mut f, f.left[node], &facts, depth + 1) }
        if f.budget_exhausted { return }
        node = f.next[node]
    }
}
pub fn run(f: &mut ir.Function) {
    if !f.supported { return }
    f.visits = 0; f.rewrites = 0; f.budget_exhausted = false
    var facts := Facts { known: [], values: [] }
    for i in 0..f.local_types.len { facts.known.push(false); facts.values.push(0) }
    statements(&mut f, f.root, &mut facts, 0)
}
