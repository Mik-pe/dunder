import ..driver.budget
import ..frontend.compile as compiler
import validation_tasks
import frontend_tasks as front
import ..mir.mir_lower
import ..mir.mir_link
import ..mir.mir_pipeline as pipeline
import mir_task
import ..driver.fragments
import ..frontend.record_take
import ..opt.opt_ir
import ..opt.opt_verify
import ..opt.opt_alloc
import ..opt.opt_emit
import ..opt.opt_range
import ..opt.opt_inline

fn empty_status() -> pipeline.Status {
    pipeline.Status { error: 0, frame_state: 0, value_state: 0, stats: pipeline.stats() }
}
fn failure(move message: string) -> compiler.Result {
    compiler.Result { ok: false, error: message, offset: 0, text: [],
        imports: compiler.Imports { globals: 0, libraries: [], symbols: [], sites: [], slots: [], env_source_slot: -1 } }
}
fn accept_batch(session: &mut compiler.Session, link: &mut mir_link.Linker,
    object: &mut mir_lower.FunctionObject, data: &mut mir_lower.ObjectData,
    status: &mut pipeline.Status, answer: &mir_task.BatchAnswer,
    ordinals: &[]i32, declarations: &[]i32, item_offset: i32) -> i32 {
    count := mir_task.answer_len(&answer)
    for i in 0..count {
        cursor := item_offset + i
        if cursor >= ordinals.len { return -1 }
        expected_ordinal := ordinals[cursor]
        expected_declaration := declarations[cursor]
        mir_task.unpack_answer(&answer, i, &mut data, &mut status)
        if mir_task.answer_ordinal(&answer, i) != expected_ordinal || mir_task.answer_declaration(&answer, i) != expected_declaration {
            status.error = 8
        }
        if status.error == 0 && !mir_lower.exchange_data_into(&mut object, &mut data) { status.error = 8 }
        if !compiler.accept_into(&mut session, &mut link, expected_ordinal, &object, &status) { return -1 }
    }
    item_offset + count
}

pub fn compile_loaded(session: &mut compiler.Session, platform: i32,
    module_starts: &[]i32, module_files: &[]i32, check_all: bool, report: bool,
    records: &mut compiler.Bindings, directory: string, identity: string,
    config: &compiler.Configuration) -> compiler.Result {
    if config.workers < 1 || config.workers > budget.max_jobs() { return failure(f"compiler workers must be 1..{budget.max_jobs()}") }
    if config.workers == 1 || config.profile_host >= 0 {
        return compiler.compile_loaded(&mut session, platform, &module_starts, &module_files,
            check_all, report, &mut records, directory, identity, &config)
    }
    mut record_takes := record_take.new()
    mut model := opt_ir.new()
    mut verifier := opt_verify.new()
    mut plan := opt_alloc.new()
    mut settings := opt_emit.options()
    mut range_work := opt_range.new()
    mut catalog := opt_inline.new()
    mut inline_work := opt_inline.workspace()
    if !compiler.begin_loaded(&mut session, platform, &module_starts, &module_files,
        check_all, report, directory, identity, &config, &mut model, &mut verifier, &mut range_work,
        &mut catalog, &mut inline_work, &mut settings, &mut record_takes) { return compiler.session_error(&session) }
    view := opt_inline.emission_view(move catalog)
    if compiler.declaration_count(&session) < 2 {
        return compiler.continue_serial_loaded(&mut session, check_all, &mut records, &mut model, &mut verifier, &mut plan,
            &settings, &mut range_work, &view, &mut inline_work, &mut record_takes)
    }
    if check_all {
        return validation_tasks.check_all(&mut session, platform, config.workers, &mut model, &mut verifier, &mut plan,
            &settings, &mut range_work, &view, &mut inline_work, &mut records, &mut record_takes)
    }
    mut link := mir_link.new()
    if !compiler.begin_linker(&session, &mut link) { return failure("internal compiler prefix linking failure") }
    mut final_object := mir_lower.new_object()
    mut lowered := mir_lower.new_object()
    mut restored := fragments.new_dependencies()
    mut options := pipeline.options()
    mut terminals := pipeline.no_terminals()
    compiler.pipeline_options_into(&session, &mut options)
    compiler.terminals_into(&session, &mut terminals)
    ordinary := empty_status()
    mut backend_failed := false
    mut source_failed := false
    backend_policy := mir_task.Policy { options: options, terminals: terminals }
    policy := front.BuildPolicy { frontend: front.freeze(&mut session, &view, &config), backend: backend_policy }
    mut batch := mir_task.new_batch()
    mut data_scratch := mir_lower.new_data()
    mut status_scratch := empty_status()
    max_siblings := budget.worker_slots(config.workers, true)
    batch_word_limit := 8192
    task scope jobs(config.workers, front.build_workspace, shared policy) {
        mut frontier: []i32 = []; mut source_keys: []TaskID<compiler.FrontendBody> = []
        mut consumed := 0
        mut keys: []TaskID<mir_task.BatchAnswer> = []
        mut batch_words: []i32 = []
        mut pending_words: i64 = 0
        mut item_ordinals: []i32 = []
        mut item_declarations: []i32 = []
        mut read := 0
        mut item_read := 0
        mut spawned_items := 0
        mut scalar_run := 0
        mut need_spawn := false
        mut flush := false
        mut cached := false
        mut cached_ordinal := -1
        mut done := false
        while !backend_failed {
            backend_count := keys.len - read
            frontend_count := source_keys.len - consumed
            if need_spawn && backend_count + frontend_count < config.workers {
                words := batch.source.words.len
                keys.push(spawn jobs front.lower_batch(batch))
                batch_words.push(words)
                pending_words += i64(words)
                compiler.observe_jobs(&mut session, backend_count + frontend_count + 1, config.workers, false)
                spawned_items = spawned_items + mir_task.batch_len(&batch)
                mir_task.reset_batch(&mut batch)
                need_spawn = false
                continue
            }
            reserve_front := source_keys.len < frontier.len && backend_count + frontier.len > max_siblings
            mut wait_for_local := false
            if !flush && !done && !compiler.source_done(&session) && (consumed == frontier.len || frontier[consumed] != compiler.next_frontend(&session)) {
                next_candidate := compiler.next_frontend(&session)
                if next_candidate >= 0 && !compiler.is_cached_hit(&session, next_candidate) && backend_count + frontend_count > max_siblings {
                    wait_for_local = true
                }
            }
            if (need_spawn || flush || backend_count == config.workers || reserve_front || wait_for_local) && read < keys.len {
                answer := await! jobs(keys[read])
                pending_words -= i64(batch_words[read])
                read = read + 1
                next_item := accept_batch(&mut session, &mut link, &mut lowered,
                    &mut data_scratch, &mut status_scratch, &answer,
                    &item_ordinals, &item_declarations, item_read)
                if next_item < 0 { backend_failed = true; break }
                item_read = next_item
                continue
            }
            if flush {
                if cached {
                    if !compiler.accept_into(&mut session, &mut link, cached_ordinal,
                        &final_object, &ordinary) { backend_failed = true; break }
                    cached = false
                }
                if source_failed || done || compiler.source_done(&session) { break }
                flush = false
            }
            if compiler.source_done(&session) {
                if mir_task.batch_len(&batch) > 0 { need_spawn = true }
                flush = true
                done = true
                continue
            }
            next_source := compiler.next_frontend(&session)
            if consumed == frontier.len {
                mut source_target := max_siblings - backend_count
                // Keep body typing wide while batch pressure is low, or when
                // recent functions show that scalar projection is paying off.
                if pending_words < i64(batch_word_limit / 2) || scalar_run >= 4 {
                    front_slots := if max_siblings >= 2 { 2 } else { 1 }
                    if source_target < front_slots { source_target = front_slots }
                }
                compiler.frontend_window(&mut session, &view, next_source, source_target, true, &mut frontier)
                source_keys.clear(); consumed = 0
            }
            if source_keys.len < frontier.len {
                if backend_count + frontier.len > max_siblings { continue }
                for f in &frontier {
                    job := compiler.source_job(&session, f)
                    source_keys.push(spawn jobs front.check_source(job))
                }
                compiler.observe_jobs(&mut session, backend_count + frontier.len + 1, config.workers, true)
            }
            prepared := if consumed < frontier.len && frontier[consumed] == next_source {
                body := await! jobs(source_keys[consumed])
                consumed = consumed + 1
                body
            } else { compiler.empty_frontend() }
            state := compiler.next_typed_into(&mut session, &mut batch.source, &mut final_object, &mut model, &mut verifier, &mut plan, &settings,
                &mut range_work, &view, &mut inline_work, &mut restored, move prepared)
            if state == 1 {
                ordinal := compiler.current_ordinal(&session)
                declaration := compiler.current_declaration(&session)
                item_ordinals.push(ordinal)
                item_declarations.push(declaration)
                mir_task.add_item(&mut batch, ordinal, declaration)
                if compiler.current_scalar(&session) { scalar_run += 1 }
                else { scalar_run = 0 }
                // Short first batches get workers busy quickly. Bound later batches
                // by emitted words as well as function count to limit skew.
                mut target := 2
                if spawned_items >= config.workers * 8 {
                    target = if scalar_run >= 4 { 8 } else { 64 }
                }
                if mir_task.batch_len(&batch) >= target || batch.source.words.len >= batch_word_limit { need_spawn = true }
            } else {
                if state == 2 { cached = true; cached_ordinal = compiler.current_ordinal(&session) }
                else {
                    if state != 0 {
                        source_failed = true
                        for i in consumed..frontier.len {
                            _ := await! jobs(source_keys[i])
                        }
                    }
                    done = true
                }
                if mir_task.batch_len(&batch) > 0 { need_spawn = true }
                flush = true
            }
        }
    }
    if backend_failed || source_failed { return compiler.session_error(&session) }
    if !validation_tasks.check_remaining(&mut session, config.workers) { return compiler.session_error(&session) }
    compiler.finish(&mut session, &mut link, &mut model, &mut verifier, &mut plan,
        &settings, &mut range_work, &view, &mut inline_work, &mut records, &mut record_takes)
}
