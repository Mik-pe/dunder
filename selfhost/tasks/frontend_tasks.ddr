import ..frontend.compile as compiler
import ..frontend.frozen_source
import mir_task
import ..opt.opt_ir
import ..opt.opt_inline

pub struct Policy { world: frozen_source.World, backend: compiler.BackendBindings, view: opt_inline.View, const_div: bool, frame_free: bool }
pub struct Work { session: compiler.Session, ready: bool }
pub fn workspace() -> Work { Work { session: compiler.new_session(), ready: false } }
pub fn freeze(c: &mut compiler.Session, view: &opt_inline.View, config: &compiler.Configuration) -> Policy {
    enabled := compiler.enable_frontend(&mut c) && !compiler.all_body_fragments_cached(&c)
    none: []i32 = []
    if !enabled {
        empty := compiler.new_session()
        return Policy { world: compiler.freeze_validation_world(&empty, &none), backend: compiler.freeze_backend(&empty), view: opt_inline.empty_view(), const_div: false, frame_free: false }
    }
    Policy { world: compiler.freeze_validation_world(&c, &none), backend: compiler.freeze_backend(&c), view: view.clone(),
        const_div: config.const_div_enabled, frame_free: config.frame_free_enabled }
}
pub struct BuildPolicy { frontend: Policy, backend: mir_task.Policy }
pub struct BuildWork { frontend: Work, backend: mir_task.WorkerWorkspace }
pub fn build_workspace() -> BuildWork {
    BuildWork { frontend: workspace(), backend: mir_task.new_workspace() }
}
pub fn check_source(job: compiler.SourceJob, work: &mut BuildWork, policy: &BuildPolicy) -> compiler.FrontendBody {
    first := !work.frontend.ready
    if first {
        compiler.hydrate_validation_worker(&mut work.frontend.session, &policy.frontend.world)
        compiler.prepare_emitter(&mut work.frontend.session, &policy.frontend.backend)
        work.frontend.ready = true
    }
    compiler.load_job(&mut work.frontend.session, &policy.frontend.world, &job)
    mut model := opt_ir.new(); mut inliner := opt_inline.workspace()
    opt_inline.configure(&mut inliner, policy.frontend.const_div, policy.frontend.frame_free)
    mut out := compiler.empty_frontend()
    out.source = compiler.emit_isolated_into(&mut work.frontend.session, job.declaration, &policy.frontend.view, &mut inliner, &mut model, job.project)
    out.first = first; out.project = job.project
    if model.supported && out.source.error.len == 0 {
        out.supported = true; out.root = model.root; out.result = model.ret; out.params = model.params
        out.locals = model.local_at; out.types = model.local_types
        out.mutable = model.local_mutable; out.parameters = model.local_param
        out.nodes = model.nodes
    }
    out
}
pub fn lower_batch(batch: mir_task.Batch, work: &mut BuildWork, policy: &BuildPolicy) -> mir_task.BatchAnswer {
    mut out := mir_task.empty_answer()
    mir_task.execute_batch_into(&mut out, &batch, &mut work.backend, &policy.backend)
    out
}
