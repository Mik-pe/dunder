import ..backend.arm64 as arm
import ..frontend.frontend_types as ft
import ..runtime.runtime
import task_data
import task_effects
import task_native
import task_scope_emit

pub struct TaskCertificate {
    safe: []bool, inputs: []bool, outputs: []bool, workers: []bool, worker_has_input: []i32, runtime: bool, at: i32,
}

pub fn task_certificate() -> TaskCertificate {
    TaskCertificate { safe: [], inputs: [], outputs: [], workers: [], worker_has_input: [], runtime: false, at: 0 }
}

pub struct TaskGraph {
    program: bool,
    direct: []i64, complete: []bool, effect_ats: []i32, edges_from: []i32, edges_to: []i32, edge_offsets: []i32,
    initializers: []i32, initializer_ats: []i32, initializer_allowed: []i64, shared: []i32, shared_ats: []i32,
    spawn_workers: []i32, spawn_callers: []i32, spawn_ats: []i32, spawn_allowed: []i64, spawn_has_input: []bool,
    uses: []bool, use_ats: []i32, reachable: []bool,
    spawners: []i32, detached_spawners: []i32,
    open: i32, await_result: i32, await_any: i32, close: i32, coordinator: i32,
}

pub fn new_graph() -> TaskGraph {
    TaskGraph {
        program: false,
        direct: [], complete: [], effect_ats: [], edges_from: [], edges_to: [], edge_offsets: [],
        initializers: [], initializer_ats: [], initializer_allowed: [], shared: [], shared_ats: [],
        spawn_workers: [], spawn_callers: [], spawn_ats: [], spawn_allowed: [], spawn_has_input: [],
        uses: [], use_ats: [], reachable: [],
        spawners: [], detached_spawners: [],
        open: -1, await_result: -1, await_any: -1, close: -1, coordinator: -1,
    }
}

pub fn add_function_effects(g: &mut TaskGraph, effects: i64, complete: bool) {
    g.direct.push(effects); g.complete.push(complete); g.effect_ats.push(-1); g.uses.push(false)
    g.use_ats.push(-1); g.spawners.push(-1); g.detached_spawners.push(-1)
}
pub fn add_function(g: &mut TaskGraph, foreign: bool) {
    mut effects: i64 = 0
    if foreign { effects = 32 }
    add_function_effects(&mut g, effects, foreign)
}

pub fn record_workspace_with(g: &mut TaskGraph, factory: i32, at: i32, allowed: i64) {
    for i in 0..g.initializers.len {
        existing_allowed := if i < g.initializer_allowed.len { g.initializer_allowed[i] } else { i64(15) }
        if g.initializers[i] == factory && existing_allowed == allowed { return }
    }
    g.initializers.push(factory); g.initializer_ats.push(at); g.initializer_allowed.push(allowed)
}
pub fn record_workspace(g: &mut TaskGraph, factory: i32, at: i32) {
    record_workspace_with(&mut g, factory, at, 15)
}
pub fn shared_data_type(reg: &ft.TypeRegistry, ty: i32) -> i32 { ty }
pub fn record_shared(g: &mut TaskGraph, ty: i32, at: i32) {
    for existing in &g.shared { if existing == ty { return } }
    g.shared.push(ty); g.shared_ats.push(at)
}
fn analyze_marker(reg: &ft.TypeRegistry, data: &mut task_data.Workspace, is_sync: bool) -> bool {
    n := reg.declared.type_kinds.len + reg.body.type_kinds.len
    mut kinds: []i32 = []; mut bases: []i32 = []; mut starts: []i32 = []; mut counts: []i32 = []
    mut fields: []i32 = []; mut primitives: []i32 = []; mut complete: []bool = []
    mut c_layout: []bool = []; mut owners: []i32 = []; mut classes: []i32 = []
    kinds.reserve(n); bases.reserve(n); starts.reserve(n); counts.reserve(n)
    primitives.reserve(n); complete.reserve(n); c_layout.reserve(n); owners.reserve(n); classes.reserve(n)
    for ty in 0..n {
        kind := ft.type_kind(&reg, ty)
        kinds.push(kind); bases.push(ft.type_base(&reg, ty))
        primitives.push(task_data.compiler_primitive_code(kind, ty)); complete.push(true)
        c_layout.push(ty < reg.c_record.len && reg.c_record[ty])
        owner := if ty < reg.opaque_owner.len { reg.opaque_owner[ty] } else { -1 }
        owners.push(owner)
        is_unsafe := if is_sync { ty < reg.unsafe_sync.len && reg.unsafe_sync[ty] } else { ty < reg.unsafe_sendable.len && reg.unsafe_sendable[ty] }
        is_opaque_ok := if is_sync { ty < reg.opaque_sync.len && reg.opaque_sync[ty] } else { ty < reg.opaque_sendable.len && reg.opaque_sendable[ty] }
        mut classification := 0
        if is_unsafe {
            classification = 4
        } else if ty < reg.resource.len && reg.resource[ty] {
            classification = 3
        } else if owner >= 0 {
            if is_opaque_ok { classification = 2 }
            else { classification = 1 }
        }
        classes.push(classification)
        starts.push(fields.len)
        if kind == 2 {
            first := ft.type_start(&reg, ty); count := ft.type_count(&reg, ty)
            for at in first..first + count { fields.push(reg.field_types[at]) }
            counts.push(count)
        } else if kind == 3 {
            count := ft.type_count(&reg, ty)
            for _ in 0..count { fields.push(0) }
            counts.push(count)
        } else if kind == 7 {
            first := ft.type_start(&reg, ty); count := ft.type_count(&reg, ty)
            mut added := 0
            for v in first..first + count {
                ps := reg.payload_starts[v]; pc := reg.payload_counts[v]
                for p in ps..ps + pc { fields.push(reg.payload_types[p]); added = added + 1 }
            }
            counts.push(added)
        } else if kind == 6 {
            counts.push(ft.type_count(&reg, ty))
        } else {
            counts.push(0)
        }
    }
    task_data.analyze_into(&mut data, &kinds, &bases, &starts, &counts,
        &fields, &primitives, &complete, &c_layout, &owners, &classes)
}
pub fn analyze_sendable(reg: &ft.TypeRegistry, data: &mut task_data.Workspace) -> bool {
    analyze_marker(&reg, &mut data, false)
}
pub fn analyze_sync(reg: &ft.TypeRegistry, data: &mut task_data.Workspace) -> bool {
    analyze_marker(&reg, &mut data, true)
}
fn local_storage(reg: &ft.TypeRegistry, root: i32) -> bool {
    total := reg.declared.type_kinds.len + reg.body.type_kinds.len
    mut seen: []bool = []; seen.reserve(total)
    for _ in 0..total { seen.push(false) }
    mut pending: []i32 = [root]
    while pending.len > 0 {
        ty := pending.pop()
        if ty < 0 || ty >= total { return false }
        if seen[ty] { continue }; seen[ty] = true
        is_res := ty < reg.resource.len && reg.resource[ty]
        if is_res && ft.cleanup_method(&reg, ty) < 0 { return false }
        kind := ft.type_kind(&reg, ty)
        if kind == 2 {
            first := ft.type_start(&reg, ty)
            for at in first..first + ft.type_count(&reg, ty) {
                f_ty := reg.field_types[at]
                if is_res && f_ty == 13 { continue }
                pending.push(f_ty)
            }
        } else if kind == 7 {
            first := ft.type_start(&reg, ty)
            for v in first..first + ft.type_count(&reg, ty) {
                ps := reg.payload_starts[v]
                for p in ps..ps + reg.payload_counts[v] { pending.push(reg.payload_types[p]) }
            }
        } else if kind == 1 || kind == 6 {
            pending.push(ft.type_base(&reg, ty))
        } else if kind != 3 && !(kind == 0 && ty >= 0 && ty <= 12) {
            return false
        }
    }
    true
}
fn effect_detail(bits: i64) -> string {
    if bits.bit_and(16) != 0 { return "unsafe operation" }
    if bits.bit_and(32) != 0 { return "external FFI call" }
    if bits.bit_and(64) != 0 { return "mutable global state" }
    if bits.bit_and(128) != 0 { return "callback" }
    if bits.bit_and(256) != 0 { return "ambient I/O or system call" }
    if bits.bit_and(512) != 0 { return "unknown indirect call" }
    if bits.bit_and(1024) != 0 { return "nested task scheduling" }
    if bits.bit_and(8192) != 0 { return "filesystem I/O; grant 'with (filesystem)'" }
    if bits.bit_and(16384) != 0 { return "network I/O; grant 'with (network)'" }
    if bits.bit_and(32768) != 0 { return "process management; grant 'with (process)'" }
    if bits.bit_and(65536) != 0 { return "stdio I/O; grant 'with (stdio)'" }
    "disallowed effect"
}
fn edge_site(g: &TaskGraph, from: i32, to: i32) -> i32 {
    for e in 0..g.edges_from.len {
        if g.edges_from[e] == from && g.edges_to[e] == to { return g.edge_offsets[e] }
    }
    -1
}
fn chain_contains(chain: &[]i32, target: i32) -> bool {
    for item in chain { if item == target { return true } }
    false
}
fn record_effect_chain_for(g: &TaskGraph, effects: &task_effects.Workspace, start: i32, allowed_mask: i64, chain: &mut []i32, sites: &mut []i32) {
    chain.clear(); sites.clear()
    disallowed := allowed_mask.bit_not()
    mut cur := start
    for _ in 0..16 {
        if cur < 0 || cur >= g.direct.len { break }
        chain.push(cur)
        if g.direct[cur].bit_and(disallowed) != 0 || !g.complete[cur] {
            sites.push(if cur < g.effect_ats.len { g.effect_ats[cur] } else { -1 })
            break
        }
        mut nxt := -1; mut site := -1
        for e in 0..g.edges_from.len {
            if g.edges_from[e] != cur { continue }
            cand := g.edges_to[e]
            if cand == -1 { nxt = -1; site = g.edge_offsets[e]; break }
            if !chain_contains(&chain, cand) && task_effects.transitive_effects(&effects, cand).bit_and(disallowed) != 0 {
                nxt = cand; site = g.edge_offsets[e]; break
            }
        }
        if nxt < 0 { sites.push(if site >= 0 { site } else if cur < g.effect_ats.len { g.effect_ats[cur] } else { -1 }); break }
        sites.push(site)
        cur = nxt
    }
}
pub fn certify(g: &TaskGraph, reg: &ft.TypeRegistry, token_starts: &[]i32,
    fn_count: i32, param_starts: &[]i32, param_counts: &[]i32, param_types: &[]i32,
    returns: &[]i32, certificate: &mut TaskCertificate, error_cursor: &mut i32,
    bad_chain: &mut []i32, bad_sites: &mut []i32) -> string {
    mut data := task_data.new(); mut sync_data := task_data.new(); mut effects := task_effects.new()
    if !analyze_sendable(&reg, &mut data) || !analyze_sync(&reg, &mut sync_data) {
        return "internal isolated task Data metadata failure"
    }
    mut counts: []i32 = []; mut starts: []i32 = [0]; mut fill: []i32 = []; mut targets: []i32 = []
    counts.reserve(fn_count); starts.reserve(fn_count + 1); fill.reserve(fn_count)
    for _ in 0..fn_count { counts.push(0) }
    for e in 0..g.edges_from.len {
        from := g.edges_from[e]; counts[from] = counts[from] + 1; targets.push(-1)
    }
    for f in 0..fn_count { starts.push(starts[f] + counts[f]); fill.push(starts[f]) }
    for e in 0..g.edges_from.len {
        from := g.edges_from[e]; targets[fill[from]] = g.edges_to[e]; fill[from] = fill[from] + 1
    }
    if !task_effects.analyze_into(&mut effects, &g.direct, &g.complete, &starts, &targets) {
        return "isolated task effect analysis exceeded its resource limit"
    }
    for f in 0..fn_count {
        certificate.safe.push(task_effects.worker_safe(&effects, f)); certificate.workers.push(false)
        certificate.worker_has_input.push(0)
        mut input := false
        first := param_starts[f]
        if param_counts[f] == 0 {
            input = true
        } else if param_counts[f] >= 1 && param_counts[f] <= 3 {
            input_type := param_types[first]
            kind := ft.type_kind(&reg, input_type)
            if kind == 4 {
                base := ft.type_base(&reg, input_type)
                input = ft.cloneable(&reg, base) && task_data.is_data(&data, base)
            } else if kind != 5 { input = task_data.is_data(&data, input_type) }
        }
        certificate.inputs.push(input); certificate.outputs.push(task_data.is_data(&data, returns[f]))
        if g.reachable[f] && g.uses[f] && !certificate.runtime {
            certificate.runtime = true; certificate.at = token_starts[g.use_ats[f]]
        }
    }
    for i in 0..g.shared.len {
        if !task_data.is_data(&data, g.shared[i]) {
            error_cursor = g.shared_ats[i]
            detail := task_data.reason_text(task_data.reason(&data, g.shared[i]))
            return "shared task input requires isolated Data / Sendable (" + detail + ")"
        }
        if !task_data.is_data(&sync_data, g.shared[i]) {
            error_cursor = g.shared_ats[i]
            detail := task_data.sync_reason_text(task_data.reason(&sync_data, g.shared[i]))
            return "shared task input requires Sync (" + detail + ")"
        }
        if !ft.cloneable(&reg, g.shared[i]) {
            error_cursor = g.shared_ats[i]
            return "shared task input requires isolated Data / Sendable + Sync (type is not cloneable)"
        }
    }
    for i in 0..g.initializers.len {
        factory := g.initializers[i]; error_cursor = g.initializer_ats[i]
        allowed := if i < g.initializer_allowed.len { g.initializer_allowed[i] } else { i64(15) }
        if !task_effects.worker_allowed(&effects, factory, allowed) {
            record_effect_chain_for(&g, &effects, factory, allowed, &mut bad_chain, &mut bad_sites)
            disallowed := task_effects.transitive_effects(&effects, factory).bit_and(allowed.bit_not())
            return "task workspace initializer has effects outside its isolated runtime (" + effect_detail(disallowed) + ")"
        }
        if !local_storage(&reg, returns[factory]) { return "task workspace contains a value outside isolated storage" }
    }
    for s in 0..g.spawn_workers.len {
        worker := g.spawn_workers[s]; error_cursor = g.spawn_ats[s]
        allowed := if s < g.spawn_allowed.len { g.spawn_allowed[s] } else { i64(15) }
        has_in := if s < g.spawn_has_input.len { g.spawn_has_input[s] } else { true }
        if has_in && !certificate.inputs[worker] {
            mut raw_in := param_types[param_starts[worker]]
            if ft.type_kind(&reg, raw_in) == 4 { raw_in = ft.type_base(&reg, raw_in) }
            detail := task_data.reason_text(task_data.reason(&data, raw_in))
            return "task worker input must be isolated Data / Sendable (" + detail + ")"
        }
        if !certificate.outputs[worker] {
            detail := task_data.reason_text(task_data.reason(&data, returns[worker]))
            return "task worker result must be isolated Data / Sendable (" + detail + ")"
        }
        if !task_effects.worker_allowed(&effects, worker, allowed) {
            record_effect_chain_for(&g, &effects, worker, allowed, &mut bad_chain, &mut bad_sites)
            disallowed := task_effects.transitive_effects(&effects, worker).bit_and(allowed.bit_not())
            return "task worker has effects outside its isolated runtime (" + effect_detail(disallowed) + ")"
        }
        in_mode := if has_in { 2 } else { 1 }
        if certificate.worker_has_input[worker] != 0 && certificate.worker_has_input[worker] != in_mode {
            return "worker cannot be spawned with inconsistent argument counts"
        }
        certificate.worker_has_input[worker] = in_mode
        if g.reachable[g.spawn_callers[s]] { certificate.workers[worker] = true }
    }
    ""
}

pub struct PrefixPlan {
    worker_ids: []i32, fn_labels: []i32, results: []i32, has_inputs: []bool,
    input_clones: []i32, input_modes: []i32, input_drops: []i32, input_pods: []bool,
    result_clones: []i32, result_drops: []i32, result_shell_drops: []i32,
    result_pod_words: []i32, workspace_pod_words: []i32, shared_pods: []bool,
}

pub struct PrefixOutput {
    ok: bool, error: string, trap: i32, coordinator: i32, open: i32, await_result: i32, await_any: i32, close: i32,
    spawners: []i32, detached_spawners: []i32, import_sites: []i32, import_slots: []i32, import_globals: i32,
}

pub fn build_prefix_plan(certificate: &TaskCertificate, reg: &ft.TypeRegistry, iso_labels: &[]i32, drop_labels: &[]i32, shell_drop_labels: &[]i32,
    param_starts: &[]i32, param_counts: &[]i32, param_types: &[]i32, returns: &[]i32, fn_labels: &[]i32) -> PrefixPlan {
    mut plan := PrefixPlan { worker_ids: [], fn_labels: [], results: [], has_inputs: [],
        input_clones: [], input_modes: [], input_drops: [], input_pods: [],
        result_clones: [], result_drops: [], result_shell_drops: [],
        result_pod_words: [], workspace_pod_words: [], shared_pods: [] }
    for f in 0..certificate.workers.len {
        if !certificate.workers[f] { continue }
        has_in := f >= certificate.worker_has_input.len || certificate.worker_has_input[f] != 1
        result := returns[f]
        mut input_clone := -1; mut input_drop := -1; mut input_mode := 0
        mut input_pod := false
        mut result_clone := -1; mut result_drop := -1; mut result_shell_drop := -1
        if has_in {
            mut input := param_types[param_starts[f]]
            if ft.type_kind(&reg, input) == 4 {
                input = ft.type_base(&reg, input); input_mode = 1
                if ft.is_c_record(&reg, input) || ft.is_pod_struct(&reg, input) { input_mode = 2 }
                else if ft.fixed_pod(&reg, input) { input_mode = 3 }
            } else if ft.is_pod_struct(&reg, input) {
                input_pod = true
            }
            if ft.owned(&reg, input) {
                input_clone = iso_labels[input]
                if input_mode != 0 || input_pod { input_drop = drop_labels[input] }
            }
        }
        if ft.owned(&reg, result) {
            result_clone = iso_labels[result]; result_drop = drop_labels[result]
            if result >= 0 && result < shell_drop_labels.len && shell_drop_labels[result] >= 0 {
                result_shell_drop = shell_drop_labels[result]
            }
        }
        mut res_words := 0
        if ft.is_pod_struct(&reg, result) { res_words = ft.pod_words(&reg, result) }
        mut ws_words := 0
        mut shared_pod := false
        ws_idx := if has_in { 1 } else { 0 }
        if param_counts[f] > ws_idx {
            p1 := param_types[param_starts[f] + ws_idx]
            k1 := ft.type_kind(&reg, p1)
            if k1 == 5 {
                ws := ft.type_base(&reg, p1)
                if ft.is_pod_struct(&reg, ws) { ws_words = ft.pod_words(&reg, ws) }
                if param_counts[f] > ws_idx + 1 {
                    sh_p := param_types[param_starts[f] + ws_idx + 1]
                    if ft.type_kind(&reg, sh_p) == 4 {
                        shared_pod = ft.is_pod_struct(&reg, ft.type_base(&reg, sh_p))
                    }
                }
            } else if k1 == 4 {
                shared_pod = ft.is_pod_struct(&reg, ft.type_base(&reg, p1))
            }
        }
        plan.worker_ids.push(f); plan.fn_labels.push(fn_labels[f]); plan.results.push(result)
        plan.has_inputs.push(has_in)
        plan.input_clones.push(input_clone); plan.input_modes.push(input_mode); plan.input_drops.push(input_drop)
        plan.input_pods.push(input_pod)
        plan.result_clones.push(result_clone); plan.result_drops.push(result_drop); plan.result_shell_drops.push(result_shell_drop)
        plan.result_pod_words.push(res_words); plan.workspace_pod_words.push(ws_words); plan.shared_pods.push(shared_pod)
    }
    plan
}

pub fn coordinator_offset(globals: i32) -> i32 {
    offset := (globals + 15) / 16 * 16
    if offset < 64 { return 64 }; offset
}
pub fn after_coordinator(offset: i32) -> i32 { offset + task_scope_emit.coordinator_bytes() }

pub fn emit_prefix(code: &mut arm.Code, rt: &runtime.Runtime, plan: &PrefixPlan,
    symbols: &task_native.SymbolsExt, globals: i32) -> PrefixOutput {
    mut out := PrefixOutput { ok: false, error: "", trap: -1, coordinator: -1, open: -1, await_result: -1, await_any: -1, close: -1,
        spawners: [], detached_spawners: [], import_sites: [], import_slots: [], import_globals: globals }
    out.trap = arm.label(&mut code); arm.mark(&mut code, out.trap); arm.exit(&mut code, 112)
    unmap_helper := task_native.emit_unmap_pool_ext(&mut code, &rt, &symbols)
    if !unmap_helper.ok { out.error = unmap_helper.error; return out }
    for i in 0..unmap_helper.import_sites.len {
        out.import_sites.push(unmap_helper.import_sites[i]); out.import_slots.push(unmap_helper.import_slots[i])
    }
    lane_loop := task_native.emit_lane_loop(&mut code, &rt)
    emitted := task_scope_emit.emit_runtime_ext(&mut code, &rt, &symbols, out.trap, unmap_helper.label)
    if !emitted.ok { out.error = emitted.error; return out }
    out.open = emitted.open; out.await_result = emitted.await_result; out.await_any = emitted.await_any; out.close = emitted.close
    for i in 0..emitted.import_sites.len { out.import_sites.push(emitted.import_sites[i]); out.import_slots.push(emitted.import_slots[i]) }
    for w in 0..plan.worker_ids.len {
        input_clone := plan.input_clones[w]
        result_clone := plan.result_clones[w]; result_drop := plan.result_drops[w]
        base := task_native.TaskSpec {
            input_clone: input_clone, input_mode: plan.input_modes[w], input_drop: plan.input_drops[w],
            input_pod: plan.input_pods[w], worker: plan.fn_labels[w], result_clone: result_clone, result_drop: result_drop,
            result_pod_words: plan.result_pod_words[w], workspace_pod_words: plan.workspace_pod_words[w],
            shared_pod: plan.shared_pods[w],
        }
        spec := task_native.TaskSpecExt {
            base: base, has_input: plan.has_inputs[w], result_shell_drop: plan.result_shell_drops[w], use_pool: code.platform != 0,
        }
        native := task_native.emit_ext(&mut code, &rt, &spec, &symbols, unmap_helper.label, lane_loop)
        if !native.ok { out.error = native.error; return out }
        for i in 0..native.import_sites.len { out.import_sites.push(native.import_sites[i]); out.import_slots.push(native.import_slots[i]) }
        kind_spec := task_scope_emit.KindSpec { result_type: plan.results[w], create: native.create, collect: native.collect, discard: native.discard,
            result_clone: result_clone, result_drop: result_drop }
        offset := (out.import_globals + 15) / 16 * 16; out.import_globals = offset + task_scope_emit.kind_bytes()
        kind := task_scope_emit.emit_kind_ext(&mut code, &emitted, &kind_spec, -1 - offset)
        if !kind.ok { out.error = kind.error; return out }
        out.spawners.push(kind.spawn); out.detached_spawners.push(kind.spawn_detached)
        for i in 0..kind.import_sites.len { out.import_sites.push(kind.import_sites[i]); out.import_slots.push(kind.import_slots[i]) }
    }
    out.ok = true; out
}
