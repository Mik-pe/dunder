pub fn emit_ext(c: &mut arm.Code, rt: &runtime.Runtime, spec: &TaskSpecExt, symbols: &SymbolsExt, unmap_pool: i32, lane_loop: i32) -> Provider {
    mut out := result()
    if !native_platform(c.platform) || c.profile || c.checking || c.mir_capture {
        out.error = "isolated native tasks require an unprofiled native runtime target"; return out
    }
    count := arm.label_count(&c)
    if rt.alloc < 0 || rt.alloc >= count || rt.alloc_record < 0 || rt.alloc_record >= count ||
        unmap_pool < 0 || unmap_pool >= count ||
        (c.platform != 0 && spec.use_pool && (lane_loop < 0 || lane_loop >= count)) ||
        spec.base.input_clone < -1 || spec.base.input_clone >= count ||
        spec.base.input_mode < 0 || spec.base.input_mode > 3 || spec.base.input_drop < -1 || spec.base.input_drop >= count ||
        (!spec.has_input && (spec.base.input_clone >= 0 || spec.base.input_drop >= 0 || spec.base.input_pod || spec.base.input_mode != 0)) ||
        (spec.has_input && !spec.base.input_pod && spec.base.input_mode == 0 && spec.base.input_drop >= 0) ||
        (spec.has_input && spec.base.input_pod && (spec.base.input_clone < 0 || spec.base.input_drop < 0)) ||
