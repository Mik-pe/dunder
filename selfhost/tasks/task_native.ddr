        spec.base.result_drop < -1 || spec.base.result_drop >= count ||
        spec.result_shell_drop < -1 || spec.result_shell_drop >= count ||
        spec.base.result_pod_words < 0 || spec.base.result_pod_words > 16 ||
        spec.base.workspace_pod_words < 0 || spec.base.workspace_pod_words > 16 ||
        (spec.base.result_pod_words > 0 && (spec.base.result_clone < 0 || spec.base.result_drop < 0)) ||
