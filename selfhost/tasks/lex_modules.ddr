import ..driver.modules
import ..frontend.lexer

fn tokenize(move source: string) -> lexer.Packed {
    lexer.scan_packed(source)
}

pub fn scan(loader: &mut modules.Loader, first: i32, last: i32, workers: i32) {
    mut total: i64 = 0
    for owner in first..last {
        size := modules.module_bytes(&loader, owner)
        // The coordinator's lexer is not restricted to a task arena.
        if size > 2097152 {
            modules.scan_wave_serial(&mut loader, first, last, 1)
            return
        }
        total += i64(size)
    }
    if total < 32768 {
        modules.scan_wave_serial(&mut loader, first, last, 1)
        return
    }
    task scope jobs(workers) {
        mut pending: []Task<lexer.Packed> = []
        pending.reserve(workers)
        mut spawned := first
        mut read := first
        while read < last {
            while spawned < last && pending.len < workers {
                pending.push(jobs.spawn(tokenize, modules.module_source(&loader, spawned)))
                spawned += 1
            }
            tokens := pending.remove(0).join()
            if !modules.admit_tokens(&mut loader, read, &tokens) { break }
            read += 1
        }
        while pending.len > 0 { _ := pending.remove(0).join() }
    }
}
