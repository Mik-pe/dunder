import ..driver.modules
import ..frontend.lexer
import std.bytes

fn tokenize(input: []u8) -> lexer.Packed {
    source := bytes.decode(&input)
    assert(source.ok)
    lexer.scan_packed(source.value)
}

pub fn scan(loader: &mut modules.Loader, first: i32, last: i32, workers: i32) {
    mut total: i64 = 0
    for owner in first..last {
        size := modules.module_bytes(&loader, owner)
        // The coordinator's lexer is not restricted to a task arena.
        if size > 2097152 {
            modules.scan_wave_serial(&mut loader, first, last, 1)
            return
        }
        total += i64(size)
    }
    if total < 32768 {
        modules.scan_wave_serial(&mut loader, first, last, 1)
        return
    }
    task scope jobs(workers) {
        mut pending: []TaskID<lexer.Packed> = []
        pending.reserve(last - first)
        mut read := first
        while read < last {
            while first + pending.len < last && first + pending.len - read < workers {
                mut input: []u8 = []
                bytes.append_utf8(&mut input, modules.module_source(&loader, first + pending.len))
                pending.push(spawn jobs tokenize(input))
            }
            tokens := await! jobs(pending[read - first])
            if !modules.admit_tokens(&mut loader, read, &tokens) { break }
            read += 1
        }
    }
}
