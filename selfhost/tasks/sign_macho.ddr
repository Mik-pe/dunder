capability unsafe
import std.dl as dl
import ..backend.macho
import std.bytes

struct Pages { image: []u8 }
struct Range { start: i32, end: i32 }

fn hash_range(span: Range, pages: &Pages) -> []u8 {
    macho.digest_pages(&pages.image, span.start, span.end, 1)
}

unsafe fn native_pages(image: &[]u8, first: i32, end: i32) -> []u8 {
    page := macho.code_page_bytes()
    assert(first >= 0 && end >= first && end <= image.len / page)
    mut hashes: []u8 = []
    handle := dl.open(ptr(0), 1)
    if usize(handle) == 0 { return hashes }
    symbol := dl.symbol(handle, ptr(c"CC_SHA256".as_ptr()))
    if usize(symbol) != 0 {
        digest: extern fn(ptr, u32, ptr) -> ptr = ffi_fn(symbol)
        hashes.reserve((end - first) * 32)
        mut hash: [u8;32] = [0;32]
        for slot in first..end {
            if usize(digest(addr(&image[slot * page]), u32(page), addr(&mut hash[0]))) == 0 {
                hashes.clear()
                break
            }
            for b in &hash { hashes.push(b) }
        }
    }
    _ := dl.close(handle)
    hashes
}

pub fn digest_pages(image: &[]u8, first: i32, end: i32, workers: i32) -> []u8 {
    count := end - first
    if target_is("macos") && count > 0 {
        unsafe {
            hashes := native_pages(&image, first, end)
            if hashes.len != 0 { return hashes }
        }
    }
    // Keep small images on the caller and amortize the shared snapshot per chunk.
    mut chunks := count / 8
    if chunks > workers { chunks = workers }
    if chunks < 2 { return macho.digest_pages(&image, first, end, 1) }

    mut snapshot: []u8 = []
    bytes.extend_range(&mut snapshot, &image, 0, end * macho.code_page_bytes())
    mut hashes: []u8 = []
    hashes.reserve(count * 32)
    task scope jobs(chunks - 1, shared Pages { image: move snapshot }) {
        mut pending: []Task<[]u8> = []
        pending.reserve(chunks - 1)
        for chunk in 1..chunks {
            start := first + count * chunk / chunks
            stop := first + count * (chunk + 1) / chunks
            pending.push(jobs.spawn(hash_range, Range { start: start, end: stop }))
        }
        local := macho.digest_pages(&image, first, first + count / chunks, 1)
        bytes.extend(&mut hashes, &local)
        for task in move pending {
            result := task.join()
            bytes.extend(&mut hashes, &result)
        }
    }
    hashes
}

@test fn page_digests_match_the_portable_signer_for_a_subrange() {
    mut image: []u8 = []
    page := macho.code_page_bytes()
    for slot in 0..4 {
        for i in 0..page { image.push(u8((i + slot) % 251)) }
    }
    expected := macho.digest_pages(&image, 1, 3, 1)
    actual := digest_pages(&image, 1, 3, 2)
    assert(bytes.equal(&actual, &expected))
}
