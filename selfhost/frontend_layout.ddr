// Computed layouts over the one authoritative semantic arena. Every write is
// confined to Arena.layouts, which is NOT part of the declaration freeze.
// Taking the whole state avoids &mut cache + &schema aliases of one root.
// C layout, inline-validation bytes and runtime boxed-field cells are distinct.
import frontend_types as types

fn error(a: &mut types.Arena, code: i32) { if a.layouts.error == 0 { a.layouts.error = code } }
pub fn error_message(code: i32) -> string {
    if code == 1 { "recursive C layout" }
    else if code == 2 { "C record layout exceeds supported size" }
    else if code == 3 { "empty C record" }
    else if code == 4 { "C array layout exceeds supported size" }
    else if code == 5 { "C layouts can contain only unmanaged C fields" }
    else if code == 6 { "recursive or excessively nested inline value type" }
    else if code == 7 { "invalid stored field type" }
    else if code == 8 { "inline value exceeds 65536 bytes" }
    else { "arrays of aggregate elements are not supported by this compiler" }
}
fn c_width(ty: i32) -> i32 {
    if ty == 3 || ty == 8 { return 1 }; if ty == 9 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 { return 4 }; 8
}
fn c_layout(a: &mut types.Arena, ty: i32, target: i32) {
    if a.layouts.error != 0 || a.layouts.c_aligns[ty] > 0 { return }
    if a.layouts.c_aligns[ty] < 0 { error(&mut a, 1); return }
    a.layouts.c_aligns[ty] = -1
    var size := 0; var alignment := 1
    if a.c_record[ty] {
        first := a.starts[ty]
        for field in first..first + a.counts[ty] {
            child_type := a.field_types[field]; c_layout(&mut a, child_type, target)
            if a.layouts.error != 0 { return }; child := a.layouts.c_aligns[child_type]
            if size > 2147483647 - child || a.layouts.c_sizes[child_type] > 2147483647 - child - size { error(&mut a, 2); return }
            size = (size + child - 1) / child * child
            a.layouts.field_offsets[field] = i64(size)
            if child > alignment { alignment = child }; size = size + a.layouts.c_sizes[child_type]
        }
        if size == 0 { error(&mut a, 3); return }; size = (size + alignment - 1) / alignment * alignment
    } else if a.kinds[ty] == 6 {
        child := a.bases[ty]; c_layout(&mut a, child, target); if a.layouts.error != 0 { return }
        if a.layouts.c_sizes[child] > 0 && a.counts[ty] > 2147483647 / a.layouts.c_sizes[child] { error(&mut a, 4); return }
        alignment = a.layouts.c_aligns[child]; size = a.counts[ty] * a.layouts.c_sizes[child]
    } else if types.foreign_scalar(&a, ty) || ty == 3 {
        alignment = c_width(ty); size = alignment
        if target == 3 && (ty == 12 || ty == 13 || a.kinds[ty] == 8) { size = 4; alignment = 4 }
    } else { error(&mut a, 5); return }
    a.layouts.c_aligns[ty] = alignment; a.layouts.c_sizes[ty] = size
}
pub fn ensure_c(a: &mut types.Arena, ty: i32, target: i32) -> i32 {
    a.layouts.error = 0; c_layout(&mut a, ty, target); a.layouts.error
}
fn inline_bytes(a: &mut types.Arena, ty: i32, depth: i32, target: i32) -> i32 {
    if a.layouts.error != 0 { return 1 }
    if a.layouts.inline_sizes[ty] < 0 || depth >= 128 { error(&mut a, 6); return 1 }
    if a.layouts.inline_sizes[ty] > 0 { return a.layouts.inline_sizes[ty] }
    kind := a.kinds[ty]
    if kind == 1 { return 24 }
    if kind == 6 { size := a.counts[ty] * types.scalar_bytes(&a, a.bases[ty], target); if size == 0 { return 1 }; return size }
    if kind != 2 && kind != 7 {
        if ty == 0 || ty == 14 || kind == 10 { error(&mut a, 7); return 1 }; return types.scalar_bytes(&a, ty, target)
    }
    if a.c_record[ty] { return a.layouts.c_sizes[ty] }
    a.layouts.inline_sizes[ty] = -1
    var size := 0; var max_align := 1
    for member in a.starts[ty]..a.starts[ty] + a.counts[ty] {
        var offset := size; var items := 1
        if kind == 7 { offset = 8; items = a.payload_counts[member]; max_align = 8 }
        for item in 0..items {
            var child := a.field_types[member]
            if kind == 7 { child = a.payload_types[a.payload_starts[member] + item] }
            width := inline_bytes(&mut a, child, depth + 1, target); if a.layouts.error != 0 { return 1 }
            var alignment := types.scalar_bytes(&a, child, target); child_kind := a.kinds[child]
            if child_kind == 1 || child_kind == 2 || child_kind == 6 || child_kind == 7 { alignment = 8 }
            offset = (offset + alignment - 1) / alignment * alignment + width
            if offset > 65536 { error(&mut a, 8); return 1 }; if alignment > max_align { max_align = alignment }
        }
        if size < offset { size = offset }
    }
    if size == 0 { size = 1 }; size = (size + max_align - 1) / max_align * max_align
    a.layouts.inline_sizes[ty] = size; size
}
pub fn validate_inline(a: &mut types.Arena, target: i32) -> i32 {
    a.layouts.error = 0; a.layouts.inline_sizes.clear()
    for ty in 0..a.kinds.len { a.layouts.inline_sizes.push(0) }
    for ty in 0..a.kinds.len {
        if a.layouts.error != 0 { return a.layouts.error }; kind := a.kinds[ty]
        if (kind == 1 || kind == 6) && !types.scalar_element(&a, a.bases[ty]) { error(&mut a, 9); return a.layouts.error }
        if kind == 2 || kind == 7 { size := inline_bytes(&mut a, ty, 0, target); if size > 65536 { error(&mut a, 8) } }
    }; a.layouts.error
}
