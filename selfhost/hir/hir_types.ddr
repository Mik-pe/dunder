// Sealed unified TypeTable for Dunder 1.0 HIR and HL-MIR.
// Replaces the legacy declared/body TypeRegistry split and 48B borrowed_view descriptors.

pub const PARAM_ENV: i32 = -1

// TypeEntry.flags bitmask (i64)
pub const TF_COPY: i64              = 1
pub const TF_RESOURCE: i64          = 2
pub const TF_DISPOSE: i64           = 4
pub const TF_SENDABLE: i64          = 8
pub const TF_SYNC: i64              = 16
pub const TF_OPAQUE: i64            = 32
pub const TF_C_LAYOUT: i64          = 64
pub const TF_POD_INLINE: i64        = 128
pub const TF_OPEN_ENUM: i64         = 256
pub const TF_EXTERN: i64            = 512
pub const TF_EXPLICIT_SENDABLE: i64 = 1024
pub const TF_EXPLICIT_SYNC: i64     = 2048
pub const TF_CLOSURE_MUT: i64       = 4096
pub const TF_CLOSURE_ONCE: i64      = 8192
pub const TF_CLOSURE_BORROWED: i64  = 16384

// Pre-interned primitive TypeIds
pub const TY_UNIT: i32   = 0
pub const TY_BOOL: i32   = 1
pub const TY_I8: i32     = 2
pub const TY_I16: i32    = 3
pub const TY_I32: i32    = 4
pub const TY_I64: i32    = 5
pub const TY_ISIZE: i32  = 6
pub const TY_U8: i32     = 7
pub const TY_U16: i32    = 8
pub const TY_U32: i32    = 9
pub const TY_U64: i32    = 10
pub const TY_USIZE: i32  = 11
pub const TY_F32: i32    = 12
pub const TY_F64: i32    = 13
pub const TY_RUNE: i32   = 14
pub const TY_PTR: i32    = 15
pub const TY_STRING: i32 = 16
pub const TY_RANGE: i32  = 17
pub const TY_CSTR: i32   = 18
pub const TY_WSTR: i32   = 19
pub const TY_ERROR: i32  = 20

pub enum TypeKind {
    Unit, Bool, I8, I16, I32, I64, Isize, U8, U16, U32, U64, Usize,
    F32, F64, Rune, Ptr, String, Range, CStr, WStr,
    Struct, Union, Enum, Tuple, Array, FixedArr,
    Ref, MutRef, FatSlice, FatStr,
    RawConst, RawMut,
    FnPtr, ExternFn, ClosureEnv, RegionSlice, Task,
    TypeParam, Error,
}

pub enum ParamMode { CopyVal, MoveVal, SharedBorrow, MutBorrow, BorrowOrCopy }

pub struct FromEdge {
    param_idx: i32,     // 0..N-1 or PARAM_ENV (-1) for closure capture environment
    field_slot: i32,    // -1 for whole param, or borrow-field origin slot
    ret_slot: i32,      // target origin slot on return type
}

pub struct FieldEntry {
    name: string,
    ty: i32,
    offset: i32,
    is_pub: bool,
    origin_slot: i32,   // -1 if non-borrowing, else first origin slot in owner
}

pub struct VariantEntry {
    name: string,
    tag_value: i64,
    payload_start: i32, // slice into TypeTable.fields
    payload_count: i32,
}

pub struct ParamEntry {
    ty: i32,
    mode: ParamMode,
}

pub struct TypeEntry {
    kind: TypeKind,
    name: string,
    owner_mod: i32,
    size: i32,
    align: i32,
    flags: i64,
    inner_a: i32,       // elem / pointee / ret_ty / field_start / variant_start
    inner_b: i32,       // param_start / closure_fn_id / fixed_len
    count: i32,         // field_count / variant_count / param_count
    origin_count: i32,  // positional origin slots on this type
    from_start: i32,
    from_len: i32,
}

pub struct TypeTable {
    entries: []TypeEntry,
    fields: []FieldEntry,
    variants: []VariantEntry,
    params: []ParamEntry,
    from_edges: []FromEdge,
    sealed: bool,
    platform: i32,      // 0:arm64-macos, 1:arm64-linux, 2:x86_64-linux, 3:wasm32, 4:wasm32-wasi, 5:x86_64-windows
}

pub fn word_size(platform: i32) -> i32 {
    if platform == 3 || platform == 4 { return 4 }
    8
}

fn align_up(value: i32, align: i32) -> i32 {
    if align <= 1 { return value }
    rem := value % align
    if rem == 0 { value } else { value + (align - rem) }
}

fn make_entry(kind: TypeKind, name: string, owner_mod: i32, size: i32, align: i32,
    flags: i64, inner_a: i32, inner_b: i32, count: i32, origin_count: i32,
    from_start: i32, from_len: i32) -> TypeEntry {
    TypeEntry {
        kind: kind,
        name: name.clone(),
        owner_mod: owner_mod,
        size: size,
        align: align,
        flags: flags,
        inner_a: inner_a,
        inner_b: inner_b,
        count: count,
        origin_count: origin_count,
        from_start: from_start,
        from_len: from_len,
    }
}

pub fn new_table(platform: i32) -> TypeTable {
    ws := word_size(platform)
    copy_ss := TF_COPY.bit_or(TF_SENDABLE).bit_or(TF_SYNC).bit_or(TF_POD_INLINE)
    mut t := TypeTable {
        entries: [],
        fields: [],
        variants: [],
        params: [],
        from_edges: [],
        sealed: false,
        platform: platform,
    }
    t.entries.push(make_entry(.Unit,   "()",     -1, 0,  1,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.Bool,   "bool",   -1, 1,  1,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.I8,     "i8",     -1, 1,  1,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.I16,    "i16",    -1, 2,  2,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.I32,    "i32",    -1, 4,  4,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.I64,    "i64",    -1, 8,  8,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.Isize,  "isize",  -1, ws, ws, copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.U8,     "u8",     -1, 1,  1,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.U16,    "u16",    -1, 2,  2,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.U32,    "u32",    -1, 4,  4,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.U64,    "u64",    -1, 8,  8,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.Usize,  "usize",  -1, ws, ws, copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.F32,    "f32",    -1, 4,  4,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.F64,    "f64",    -1, 8,  8,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.Rune,   "rune",   -1, 4,  4,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.Ptr,    "ptr",    -1, ws, ws, TF_COPY.bit_or(TF_POD_INLINE), -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.String, "string", -1, ws, ws, TF_SENDABLE.bit_or(TF_SYNC), -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.Range,  "range",  -1, 16, 8,  copy_ss, -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.CStr,   "CStr",   -1, ws, ws, TF_COPY.bit_or(TF_POD_INLINE), -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.WStr,   "WStr",   -1, ws, ws, TF_COPY.bit_or(TF_POD_INLINE), -1, -1, 0, 0, 0, 0))
    t.entries.push(make_entry(.Error,  "<error>",-1, 0,  1,  TF_COPY, -1, -1, 0, 0, 0, 0))
    t
}

pub fn intern(t: &mut TypeTable, move entry: TypeEntry) -> i32 {
    id := t.entries.len
    t.entries.push(move entry)
    id
}

pub fn add_ref(t: &mut TypeTable, pointee: i32) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .Ref && t.entries[i].inner_a == pointee { return i }
    }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.Ref, "&" + t.entries[pointee].name, -1, ws, ws,
        TF_COPY.bit_or(TF_POD_INLINE), pointee, -1, 0, 1, 0, 0))
}

pub fn add_mut_ref(t: &mut TypeTable, pointee: i32) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .MutRef && t.entries[i].inner_a == pointee { return i }
    }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.MutRef, "&mut " + t.entries[pointee].name, -1, ws, ws,
        0, pointee, -1, 0, 1, 0, 0))
}

pub fn add_fat_str(t: &mut TypeTable) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .FatStr { return i }
    }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.FatStr, "&str", -1, ws * 2, ws,
        TF_COPY.bit_or(TF_POD_INLINE), TY_U8, -1, 0, 1, 0, 0))
}

pub fn add_fat_slice(t: &mut TypeTable, elem: i32) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .FatSlice && t.entries[i].inner_a == elem { return i }
    }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.FatSlice, "&[]" + t.entries[elem].name, -1, ws * 2, ws,
        TF_COPY.bit_or(TF_POD_INLINE), elem, -1, 0, 1, 0, 0))
}

pub fn add_region_slice(t: &mut TypeTable, elem: i32) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .RegionSlice && t.entries[i].inner_a == elem { return i }
    }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.RegionSlice, "region[]" + t.entries[elem].name, -1, ws * 2, ws,
        TF_COPY.bit_or(TF_POD_INLINE), elem, -1, 0, 1, 0, 0))
}

pub fn add_array(t: &mut TypeTable, elem: i32) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .Array && t.entries[i].inner_a == elem { return i }
    }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.Array, "[]" + t.entries[elem].name, -1, ws, ws,
        0, elem, -1, 0, 0, 0, 0))
}

pub fn add_fixed_array(t: &mut TypeTable, elem: i32, fixed_len: i32) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .FixedArr && t.entries[i].inner_a == elem && t.entries[i].count == fixed_len { return i }
    }
    intern(&mut t, make_entry(.FixedArr, "[" + t.entries[elem].name + "; " + fixed_len.str() + "]", -1,
        0, 1, 0, elem, fixed_len, fixed_len, 0, 0, 0))
}

pub fn add_raw_ptr(t: &mut TypeTable, pointee: i32, is_mut: bool) -> i32 {
    kind: TypeKind = if is_mut { .RawMut } else { .RawConst }
    for i in 0..t.entries.len {
        if t.entries[i].kind == kind && t.entries[i].inner_a == pointee { return i }
    }
    ws := word_size(t.platform)
    prefix := if is_mut { "*mut " } else { "*const " }
    intern(&mut t, make_entry(kind, prefix + t.entries[pointee].name, -1, ws, ws,
        TF_COPY.bit_or(TF_POD_INLINE), pointee, -1, 0, 0, 0, 0))
}

pub fn add_task(t: &mut TypeTable, inner: i32) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .Task && t.entries[i].inner_a == inner { return i }
    }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.Task, "Task<" + t.entries[inner].name + ">", -1, ws, ws,
        0, inner, -1, 0, 0, 0, 0))
}

pub fn add_tuple(t: &mut TypeTable, elems: &[]i32) -> i32 {
    field_start := t.fields.len
    mut label := "("
    for i in 0..elems.len {
        if i > 0 { label += ", " }
        label += t.entries[elems[i]].name
        t.fields.push(FieldEntry { name: i.str(), ty: elems[i], offset: 0, is_pub: true, origin_slot: -1 })
    }
    label += ")"
    intern(&mut t, make_entry(.Tuple, label, -1, 0, 1, 0, field_start, -1, elems.len, 0, 0, 0))
}

pub fn add_struct(t: &mut TypeTable, name: string, owner_mod: i32, flags: i64, fields: &[]FieldEntry) -> i32 {
    field_start := t.fields.len
    for i in 0..fields.len {
        f := &fields[i]
        t.fields.push(FieldEntry {
            name: f.name.clone(),
            ty: f.ty,
            offset: f.offset,
            is_pub: f.is_pub,
            origin_slot: -1,
        })
    }
    intern(&mut t, make_entry(.Struct, name, owner_mod, 0, 1, flags, field_start, -1, fields.len, 0, 0, 0))
}

pub fn add_union(t: &mut TypeTable, name: string, owner_mod: i32, flags: i64, fields: &[]FieldEntry) -> i32 {
    field_start := t.fields.len
    for i in 0..fields.len {
        f := &fields[i]
        t.fields.push(FieldEntry {
            name: f.name.clone(),
            ty: f.ty,
            offset: 0,
            is_pub: f.is_pub,
            origin_slot: -1,
        })
    }
    intern(&mut t, make_entry(.Union, name, owner_mod, 0, 1, flags.bit_or(TF_C_LAYOUT), field_start, -1, fields.len, 0, 0, 0))
}

pub fn add_enum(t: &mut TypeTable, name: string, owner_mod: i32, flags: i64,
    variants: &[]VariantEntry, payload_fields: &[]FieldEntry) -> i32 {
    field_base := t.fields.len
    for i in 0..payload_fields.len {
        f := &payload_fields[i]
        t.fields.push(FieldEntry {
            name: f.name.clone(),
            ty: f.ty,
            offset: f.offset,
            is_pub: f.is_pub,
            origin_slot: -1,
        })
    }
    v_start := t.variants.len
    for i in 0..variants.len {
        v := &variants[i]
        t.variants.push(VariantEntry {
            name: v.name.clone(),
            tag_value: v.tag_value,
            payload_start: field_base + v.payload_start,
            payload_count: v.payload_count,
        })
    }
    intern(&mut t, make_entry(.Enum, name, owner_mod, 0, 1, flags, v_start, -1, variants.len, 0, 0, 0))
}

pub fn add_option(t: &mut TypeTable, inner: i32) -> i32 {
    name := "Option<" + t.entries[inner].name + ">"
    for i in 0..t.entries.len {
        if t.entries[i].kind == .Enum && t.entries[i].name == name { return i }
    }
    payload: []FieldEntry = [FieldEntry { name: "0", ty: inner, offset: 0, is_pub: true, origin_slot: -1 }]
    vars: []VariantEntry = [
        VariantEntry { name: "Some", tag_value: 0, payload_start: 0, payload_count: 1 },
        VariantEntry { name: "None", tag_value: 1, payload_start: 1, payload_count: 0 },
    ]
    add_enum(&mut t, name, -1, 0, &vars, &payload)
}

pub fn add_result(t: &mut TypeTable, ok_ty: i32, err_ty: i32) -> i32 {
    name := "Result<" + t.entries[ok_ty].name + ", " + t.entries[err_ty].name + ">"
    for i in 0..t.entries.len {
        if t.entries[i].kind == .Enum && t.entries[i].name == name { return i }
    }
    payload: []FieldEntry = [
        FieldEntry { name: "0", ty: ok_ty, offset: 0, is_pub: true, origin_slot: -1 },
        FieldEntry { name: "0", ty: err_ty, offset: 0, is_pub: true, origin_slot: -1 },
    ]
    vars: []VariantEntry = [
        VariantEntry { name: "Ok", tag_value: 0, payload_start: 0, payload_count: 1 },
        VariantEntry { name: "Err", tag_value: 1, payload_start: 1, payload_count: 1 },
    ]
    add_enum(&mut t, name, -1, 0, &vars, &payload)
}

pub fn add_type_param(t: &mut TypeTable, name: string, owner_mod: i32) -> i32 {
    intern(&mut t, make_entry(.TypeParam, name, owner_mod, 0, 1, 0, -1, -1, 0, 0, 0, 0))
}

pub fn set_struct_fields(t: &mut TypeTable, ty: i32, fields: &[]FieldEntry) {
    field_start := t.fields.len
    for i in 0..fields.len {
        f := &fields[i]
        t.fields.push(FieldEntry {
            name: f.name.clone(),
            ty: f.ty,
            offset: f.offset,
            is_pub: f.is_pub,
            origin_slot: -1,
        })
    }
    t.entries[ty].inner_a = field_start
    t.entries[ty].count = fields.len
}

pub fn set_enum_variants(t: &mut TypeTable, ty: i32, variants: &[]VariantEntry, payload_fields: &[]FieldEntry) {
    field_base := t.fields.len
    for i in 0..payload_fields.len {
        f := &payload_fields[i]
        t.fields.push(FieldEntry {
            name: f.name.clone(),
            ty: f.ty,
            offset: f.offset,
            is_pub: f.is_pub,
            origin_slot: -1,
        })
    }
    v_start := t.variants.len
    for i in 0..variants.len {
        v := &variants[i]
        t.variants.push(VariantEntry {
            name: v.name.clone(),
            tag_value: v.tag_value,
            payload_start: field_base + v.payload_start,
            payload_count: v.payload_count,
        })
    }
    t.entries[ty].inner_a = v_start
    t.entries[ty].count = variants.len
}

pub fn set_fn_from_edges(t: &mut TypeTable, sig_ty: i32, from_edges: &[]FromEdge) {
    f_start := t.from_edges.len
    for i in 0..from_edges.len { t.from_edges.push(from_edges[i]) }
    t.entries[sig_ty].from_start = f_start
    t.entries[sig_ty].from_len = from_edges.len
}

pub fn add_fn_ptr(t: &mut TypeTable, params: &[]ParamEntry, ret_ty: i32, from_edges: &[]FromEdge) -> i32 {
    for i in 0..t.entries.len {
        if t.entries[i].kind == .FnPtr && t.entries[i].inner_a == ret_ty &&
            t.entries[i].count == params.len && t.entries[i].from_len == from_edges.len {
            mut same := true
            ps := t.entries[i].inner_b
            for k in 0..params.len {
                if t.params[ps + k].ty != params[k].ty || t.params[ps + k].mode != params[k].mode {
                    same = false; break
                }
            }
            if same {
                fs := t.entries[i].from_start
                for k in 0..from_edges.len {
                    if t.from_edges[fs + k].param_idx != from_edges[k].param_idx ||
                        t.from_edges[fs + k].field_slot != from_edges[k].field_slot ||
                        t.from_edges[fs + k].ret_slot != from_edges[k].ret_slot {
                        same = false; break
                    }
                }
            }
            if same { return i }
        }
    }
    p_start := t.params.len
    for i in 0..params.len { t.params.push(params[i]) }
    f_start := t.from_edges.len
    for i in 0..from_edges.len { t.from_edges.push(from_edges[i]) }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.FnPtr, "fn", -1, ws, ws,
        TF_COPY.bit_or(TF_SENDABLE).bit_or(TF_SYNC).bit_or(TF_POD_INLINE),
        ret_ty, p_start, params.len, 0, f_start, from_edges.len))
}

pub fn add_extern_fn(t: &mut TypeTable, params: &[]ParamEntry, ret_ty: i32) -> i32 {
    p_start := t.params.len
    for i in 0..params.len { t.params.push(params[i]) }
    ws := word_size(t.platform)
    intern(&mut t, make_entry(.ExternFn, "extern fn", -1, ws, ws,
        TF_COPY.bit_or(TF_EXTERN).bit_or(TF_POD_INLINE),
        ret_ty, p_start, params.len, 0, 0, 0))
}

pub fn add_closure_env(t: &mut TypeTable, name: string, owner_mod: i32,
    is_mut: bool, is_once: bool, is_borrowed: bool,
    cap_fields: &[]FieldEntry, params: &[]ParamEntry, ret_ty: i32, from_edges: &[]FromEdge) -> i32 {
    // Store captures in fields; params in params; ret_ty in inner_b of a companion FnPtr or directly:
    // For ClosureEnv: inner_a = field_start, count = cap_count, inner_b = companion FnPtr sig_ty!
    sig_ty := add_fn_ptr(&mut t, &params, ret_ty, &from_edges)
    field_start := t.fields.len
    for i in 0..cap_fields.len {
        f := &cap_fields[i]
        t.fields.push(FieldEntry {
            name: f.name.clone(),
            ty: f.ty,
            offset: f.offset,
            is_pub: f.is_pub,
            origin_slot: -1,
        })
    }
    mut flags: i64 = 0
    if is_mut { flags = flags.bit_or(TF_CLOSURE_MUT) }
    if is_once { flags = flags.bit_or(TF_CLOSURE_ONCE) }
    if is_borrowed { flags = flags.bit_or(TF_CLOSURE_BORROWED) }
    ws := word_size(t.platform)
    f_start := t.entries[sig_ty].from_start
    f_len := t.entries[sig_ty].from_len
    intern(&mut t, make_entry(.ClosureEnv, name, owner_mod, ws, ws, flags,
        field_start, sig_ty, cap_fields.len, 0, f_start, f_len))
}

pub fn has_flag(t: &TypeTable, ty: i32, flag: i64) -> bool {
    if ty < 0 || ty >= t.entries.len { return false }
    t.entries[ty].flags.bit_and(flag) != 0
}

pub fn is_copy(t: &TypeTable, ty: i32) -> bool {
    has_flag(&t, ty, TF_COPY)
}

pub fn has_dispose(t: &TypeTable, ty: i32) -> bool {
    has_flag(&t, ty, TF_DISPOSE)
}

pub fn is_sendable(t: &TypeTable, ty: i32) -> bool {
    has_flag(&t, ty, TF_SENDABLE)
}

pub fn is_sync(t: &TypeTable, ty: i32) -> bool {
    has_flag(&t, ty, TF_SYNC)
}

pub fn origin_count(t: &TypeTable, ty: i32) -> i32 {
    if ty < 0 || ty >= t.entries.len { return 0 }
    t.entries[ty].origin_count
}

// True for types whose nested origins are invariant (cannot shorten or widen).
pub fn is_invariant_container(t: &TypeTable, ty: i32) -> bool {
    if ty < 0 || ty >= t.entries.len { return false }
    e := &t.entries[ty]
    if e.kind == .MutRef { return true }
    if e.kind == .ClosureEnv && has_flag(&t, ty, TF_CLOSURE_BORROWED) && has_flag(&t, ty, TF_CLOSURE_MUT) {
        return true
    }
    false
}

// True if ty is an invariant container holding a type that itself contains origins.
pub fn has_invariant_nested_origins(t: &TypeTable, ty: i32) -> bool {
    if !is_invariant_container(&t, ty) { return false }
    e := &t.entries[ty]
    if e.kind == .MutRef { return origin_count(&t, e.inner_a) > 0 }
    // Borrowed &mut FnMut: captures with origins are invariant.
    for i in 0..e.count {
        if origin_count(&t, t.fields[e.inner_a + i].ty) > 0 { return true }
    }
    false
}

pub fn field_type(t: &TypeTable, ty: i32, field_idx: i32) -> i32 {
    if ty < 0 || ty >= t.entries.len { return -1 }
    e := &t.entries[ty]
    if e.kind != .Struct && e.kind != .Tuple && e.kind != .Union && e.kind != .ClosureEnv { return -1 }
    if field_idx < 0 || field_idx >= e.count { return -1 }
    t.fields[e.inner_a + field_idx].ty
}

pub fn field_origin_slot(t: &TypeTable, ty: i32, field_idx: i32) -> i32 {
    if ty < 0 || ty >= t.entries.len { return -1 }
    e := &t.entries[ty]
    if e.kind != .Struct && e.kind != .Tuple && e.kind != .ClosureEnv { return -1 }
    if field_idx < 0 || field_idx >= e.count { return -1 }
    t.fields[e.inner_a + field_idx].origin_slot
}

pub fn variant_payload_type(t: &TypeTable, ty: i32, variant_idx: i32, payload_idx: i32) -> i32 {
    if ty < 0 || ty >= t.entries.len { return -1 }
    e := &t.entries[ty]
    if e.kind != .Enum || variant_idx < 0 || variant_idx >= e.count { return -1 }
    v := &t.variants[e.inner_a + variant_idx]
    if payload_idx < 0 || payload_idx >= v.payload_count { return -1 }
    t.fields[v.payload_start + payload_idx].ty
}

pub fn callable_ret(t: &TypeTable, sig_ty: i32) -> i32 {
    if sig_ty < 0 || sig_ty >= t.entries.len { return -1 }
    e := &t.entries[sig_ty]
    if e.kind == .FnPtr || e.kind == .ExternFn { return e.inner_a }
    if e.kind == .ClosureEnv && e.inner_b >= 0 { return t.entries[e.inner_b].inner_a }
    -1
}

pub fn callable_param_start(t: &TypeTable, sig_ty: i32) -> i32 {
    if sig_ty < 0 || sig_ty >= t.entries.len { return 0 }
    e := &t.entries[sig_ty]
    if e.kind == .FnPtr || e.kind == .ExternFn { return e.inner_b }
    if e.kind == .ClosureEnv && e.inner_b >= 0 { return t.entries[e.inner_b].inner_b }
    0
}

pub fn callable_param_count(t: &TypeTable, sig_ty: i32) -> i32 {
    if sig_ty < 0 || sig_ty >= t.entries.len { return 0 }
    e := &t.entries[sig_ty]
    if e.kind == .FnPtr || e.kind == .ExternFn { return e.count }
    if e.kind == .ClosureEnv && e.inner_b >= 0 { return t.entries[e.inner_b].count }
    0
}

fn is_primitive_kind(k: TypeKind) -> bool {
    k == .Unit || k == .Bool || k == .I8 || k == .I16 || k == .I32 || k == .I64 || k == .Isize ||
    k == .U8 || k == .U16 || k == .U32 || k == .U64 || k == .Usize ||
    k == .F32 || k == .F64 || k == .Rune || k == .Ptr || k == .String || k == .Range ||
    k == .CStr || k == .WStr || k == .Error
}

// Compute transitive layout, origin counts, and Copy/Dispose/Sendable/Sync flags.
pub fn seal(t: &mut TypeTable) {
    ws := word_size(t.platform)
    n := t.entries.len
    // Fixed-point loop (bounded to handle any ordering or recursion cleanly).
    mut iter := 0
    mut changed := true
    while changed && iter < 64 {
        changed = false
        iter += 1
        for i in 0..n {
            k := t.entries[i].kind
            if is_primitive_kind(k) { continue }

            old_size := t.entries[i].size
            old_align := t.entries[i].align
            old_flags := t.entries[i].flags
            old_origins := t.entries[i].origin_count

            mut sz := old_size
            mut al := old_align
            mut fl := old_flags
            mut oc := old_origins

            if k == .Ref {
                sz = ws; al = ws
                oc = 1 + t.entries[t.entries[i].inner_a].origin_count
                fl = fl.bit_or(TF_COPY).bit_or(TF_POD_INLINE)
                fl = fl.bit_and(TF_DISPOSE.bit_not()).bit_and(TF_SENDABLE.bit_not()).bit_and(TF_SYNC.bit_not())
            } else if k == .MutRef {
                sz = ws; al = ws
                oc = 1 + t.entries[t.entries[i].inner_a].origin_count
                fl = fl.bit_and(TF_COPY.bit_not()).bit_and(TF_POD_INLINE.bit_not())
                    .bit_and(TF_DISPOSE.bit_not()).bit_and(TF_SENDABLE.bit_not()).bit_and(TF_SYNC.bit_not())
            } else if k == .FatStr || k == .FatSlice || k == .RegionSlice {
                sz = ws * 2; al = ws
                elem := t.entries[i].inner_a
                elem_oc := if elem >= 0 && elem < n { t.entries[elem].origin_count } else { 0 }
                oc = 1 + elem_oc
                fl = fl.bit_or(TF_COPY).bit_or(TF_POD_INLINE)
                fl = fl.bit_and(TF_DISPOSE.bit_not()).bit_and(TF_SENDABLE.bit_not()).bit_and(TF_SYNC.bit_not())
            } else if k == .RawConst || k == .RawMut {
                sz = ws; al = ws; oc = 0
                fl = fl.bit_or(TF_COPY).bit_or(TF_POD_INLINE)
                fl = fl.bit_and(TF_SENDABLE.bit_not()).bit_and(TF_SYNC.bit_not())
            } else if k == .Array {
                sz = ws; al = ws
                elem := t.entries[i].inner_a
                oc = t.entries[elem].origin_count
                fl = fl.bit_and(TF_COPY.bit_not()).bit_and(TF_POD_INLINE.bit_not())
                if t.entries[elem].flags.bit_and(TF_DISPOSE) != 0 { fl = fl.bit_or(TF_DISPOSE) }
                if oc == 0 && t.entries[elem].flags.bit_and(TF_SENDABLE) != 0 { fl = fl.bit_or(TF_SENDABLE) }
                else { fl = fl.bit_and(TF_SENDABLE.bit_not()) }
                if oc == 0 && t.entries[elem].flags.bit_and(TF_SYNC) != 0 { fl = fl.bit_or(TF_SYNC) }
                else { fl = fl.bit_and(TF_SYNC.bit_not()) }
            } else if k == .FixedArr {
                elem := t.entries[i].inner_a
                cnt := t.entries[i].count
                ea := if t.entries[elem].align > 0 { t.entries[elem].align } else { 1 }
                es := align_up(t.entries[elem].size, ea)
                sz = es * cnt; al = ea
                oc = t.entries[elem].origin_count
                if t.entries[elem].flags.bit_and(TF_COPY) != 0 { fl = fl.bit_or(TF_COPY) }
                else { fl = fl.bit_and(TF_COPY.bit_not()) }
                if t.entries[elem].flags.bit_and(TF_DISPOSE) != 0 { fl = fl.bit_or(TF_DISPOSE) }
                if oc == 0 && t.entries[elem].flags.bit_and(TF_SENDABLE) != 0 { fl = fl.bit_or(TF_SENDABLE) }
                else { fl = fl.bit_and(TF_SENDABLE.bit_not()) }
                if oc == 0 && t.entries[elem].flags.bit_and(TF_SYNC) != 0 { fl = fl.bit_or(TF_SYNC) }
                else { fl = fl.bit_and(TF_SYNC.bit_not()) }
                if fl.bit_and(TF_COPY) != 0 && sz <= 128 { fl = fl.bit_or(TF_POD_INLINE) }
                else { fl = fl.bit_and(TF_POD_INLINE.bit_not()) }
            } else if k == .Task {
                sz = ws; al = ws; oc = 0
                fl = fl.bit_and(TF_COPY.bit_not()).bit_and(TF_SENDABLE.bit_not()).bit_and(TF_SYNC.bit_not())
            } else if k == .Struct || k == .Tuple {
                start := t.entries[i].inner_a
                cnt := t.entries[i].count
                mut cur_off := 0
                mut max_al := 1
                mut all_copy := (fl.bit_and(TF_RESOURCE) == 0) && (fl.bit_and(TF_DISPOSE) == 0)
                mut any_dispose := fl.bit_and(TF_DISPOSE) != 0
                mut all_send := fl.bit_and(TF_OPAQUE) == 0
                mut all_sync := fl.bit_and(TF_OPAQUE) == 0
                mut total_oc := 0
                for fi in 0..cnt {
                    fty := t.fields[start + fi].ty
                    fa := if t.entries[fty].align > 0 { t.entries[fty].align } else { 1 }
                    fs := t.entries[fty].size
                    cur_off = align_up(cur_off, fa)
                    t.fields[start + fi].offset = cur_off
                    cur_off += fs
                    if fa > max_al { max_al = fa }
                    ff := t.entries[fty].flags
                    if ff.bit_and(TF_COPY) == 0 { all_copy = false }
                    if ff.bit_and(TF_DISPOSE) != 0 { any_dispose = true }
                    if ff.bit_and(TF_SENDABLE) == 0 { all_send = false }
                    if ff.bit_and(TF_SYNC) == 0 { all_sync = false }
                    foc := t.entries[fty].origin_count
                    if foc > 0 {
                        t.fields[start + fi].origin_slot = total_oc
                        total_oc += foc
                    } else {
                        t.fields[start + fi].origin_slot = -1
                    }
                }
                sz = align_up(cur_off, max_al)
                al = max_al
                oc = total_oc
                if all_copy { fl = fl.bit_or(TF_COPY) } else { fl = fl.bit_and(TF_COPY.bit_not()) }
                if any_dispose { fl = fl.bit_or(TF_DISPOSE) }
                if fl.bit_and(TF_EXPLICIT_SENDABLE) != 0 || (all_send && oc == 0) { fl = fl.bit_or(TF_SENDABLE) }
                else { fl = fl.bit_and(TF_SENDABLE.bit_not()) }
                if fl.bit_and(TF_EXPLICIT_SYNC) != 0 || (all_sync && oc == 0) { fl = fl.bit_or(TF_SYNC) }
                else { fl = fl.bit_and(TF_SYNC.bit_not()) }
                if fl.bit_and(TF_COPY) != 0 && sz <= 128 { fl = fl.bit_or(TF_POD_INLINE) }
                else { fl = fl.bit_and(TF_POD_INLINE.bit_not()) }
            } else if k == .Union {
                start := t.entries[i].inner_a
                cnt := t.entries[i].count
                mut max_sz := 0; mut max_al := 1
                mut all_copy := true
                for fi in 0..cnt {
                    fty := t.fields[start + fi].ty
                    if t.entries[fty].size > max_sz { max_sz = t.entries[fty].size }
                    if t.entries[fty].align > max_al { max_al = t.entries[fty].align }
                    if t.entries[fty].flags.bit_and(TF_COPY) == 0 { all_copy = false }
                    t.fields[start + fi].offset = 0
                }
                sz = align_up(max_sz, max_al); al = max_al; oc = 0
                if all_copy { fl = fl.bit_or(TF_COPY) } else { fl = fl.bit_and(TF_COPY.bit_not()) }
                fl = fl.bit_and(TF_SENDABLE.bit_not()).bit_and(TF_SYNC.bit_not())
            } else if k == .Enum {
                v_start := t.entries[i].inner_a
                v_cnt := t.entries[i].count
                mut max_payload := 0
                mut max_al := 4
                mut all_copy := (fl.bit_and(TF_RESOURCE) == 0) && (fl.bit_and(TF_DISPOSE) == 0)
                mut any_dispose := fl.bit_and(TF_DISPOSE) != 0
                mut all_send := fl.bit_and(TF_OPAQUE) == 0
                mut all_sync := fl.bit_and(TF_OPAQUE) == 0
                mut total_oc := 0
                for vi in 0..v_cnt {
                    p_start := t.variants[v_start + vi].payload_start
                    p_cnt := t.variants[v_start + vi].payload_count
                    mut v_off := 0
                    for pi in 0..p_cnt {
                        pty := t.fields[p_start + pi].ty
                        pa := if t.entries[pty].align > 0 { t.entries[pty].align } else { 1 }
                        v_off = align_up(v_off, pa)
                        t.fields[p_start + pi].offset = v_off
                        v_off += t.entries[pty].size
                        if pa > max_al { max_al = pa }
                        pf := t.entries[pty].flags
                        if pf.bit_and(TF_COPY) == 0 { all_copy = false }
                        if pf.bit_and(TF_DISPOSE) != 0 { any_dispose = true }
                        if pf.bit_and(TF_SENDABLE) == 0 { all_send = false }
                        if pf.bit_and(TF_SYNC) == 0 { all_sync = false }
                        poc := t.entries[pty].origin_count
                        if poc > 0 {
                            t.fields[p_start + pi].origin_slot = total_oc
                            total_oc += poc
                        } else {
                            t.fields[p_start + pi].origin_slot = -1
                        }
                    }
                    if v_off > max_payload { max_payload = v_off }
                }
                if max_payload == 0 {
                    sz = 4; al = 4
                } else {
                    sz = align_up(align_up(4, max_al) + max_payload, max_al)
                    al = max_al
                }
                oc = total_oc
                if all_copy { fl = fl.bit_or(TF_COPY) } else { fl = fl.bit_and(TF_COPY.bit_not()) }
                if any_dispose { fl = fl.bit_or(TF_DISPOSE) }
                if fl.bit_and(TF_EXPLICIT_SENDABLE) != 0 || (all_send && oc == 0) { fl = fl.bit_or(TF_SENDABLE) }
                else { fl = fl.bit_and(TF_SENDABLE.bit_not()) }
                if fl.bit_and(TF_EXPLICIT_SYNC) != 0 || (all_sync && oc == 0) { fl = fl.bit_or(TF_SYNC) }
                else { fl = fl.bit_and(TF_SYNC.bit_not()) }
                if fl.bit_and(TF_COPY) != 0 && sz <= 128 { fl = fl.bit_or(TF_POD_INLINE) }
                else { fl = fl.bit_and(TF_POD_INLINE.bit_not()) }
            } else if k == .ClosureEnv {
                start := t.entries[i].inner_a
                cnt := t.entries[i].count
                borrowed := fl.bit_and(TF_CLOSURE_BORROWED) != 0
                is_mut := fl.bit_and(TF_CLOSURE_MUT) != 0
                mut any_dispose := false
                mut all_send := !borrowed
                mut all_sync := !borrowed && !is_mut && (fl.bit_and(TF_CLOSURE_ONCE) == 0)
                mut total_oc := if borrowed { 1 } else { 0 }
                for fi in 0..cnt {
                    fty := t.fields[start + fi].ty
                    ff := t.entries[fty].flags
                    if !borrowed && ff.bit_and(TF_DISPOSE) != 0 { any_dispose = true }
                    if ff.bit_and(TF_SENDABLE) == 0 { all_send = false }
                    if ff.bit_and(TF_SYNC) == 0 { all_sync = false }
                    foc := t.entries[fty].origin_count
                    if foc > 0 {
                        t.fields[start + fi].origin_slot = total_oc
                        total_oc += foc
                    } else {
                        t.fields[start + fi].origin_slot = -1
                    }
                }
                sz = ws; al = ws; oc = total_oc
                if borrowed && !is_mut { fl = fl.bit_or(TF_COPY) }
                else { fl = fl.bit_and(TF_COPY.bit_not()) }
                if any_dispose { fl = fl.bit_or(TF_DISPOSE) }
                if all_send && oc == 0 { fl = fl.bit_or(TF_SENDABLE) }
                else { fl = fl.bit_and(TF_SENDABLE.bit_not()) }
                if all_sync && oc == 0 { fl = fl.bit_or(TF_SYNC) }
                else { fl = fl.bit_and(TF_SYNC.bit_not()) }
            }

            if sz != old_size || al != old_align || fl != old_flags || oc != old_origins {
                t.entries[i].size = sz
                t.entries[i].align = al
                t.entries[i].flags = fl
                t.entries[i].origin_count = oc
                changed = true
            }
        }
    }
    t.sealed = true
}
