pub fn intrinsic_id_for_name(name: string) -> i32 {
    if name == "print" { return INTRINSIC_PRINT }
    if name == "eprint" { return INTRINSIC_EPRINT }
    if name == "assert" { return INTRINSIC_ASSERT }
    if name == "panic" { return INTRINSIC_PANIC }
    if name == "unreachable" { return INTRINSIC_UNREACHABLE }
    if name == "target_is" { return INTRINSIC_TARGET_IS }
    if name == "size_of" { return INTRINSIC_SIZE_OF }
    if name == "align_of" { return INTRINSIC_ALIGN_OF }
    if name == "offset_of" { return INTRINSIC_OFFSET_OF }
    if name == "zeroed" { return INTRINSIC_ZEROED }
    if name == "clone" { return INTRINSIC_CLONE }
    if name == "str" || name == "to_string" { return INTRINSIC_TO_STR }
    if name == "hash" { return INTRINSIC_HASH }
    if name == "cap" { return INTRINSIC_CAP }
    if name == "runes" { return INTRINSIC_RUNES }
    if name == "str_slice" { return INTRINSIC_STR_SLICE }
    if name == "for_move_elem" { return INTRINSIC_FOR_MOVE_ELEM }
    if name == "push" { return INTRINSIC_ARR_PUSH }
    if name == "pop" { return INTRINSIC_ARR_POP }
    if name == "clear" { return INTRINSIC_ARR_CLEAR }
    if name == "reserve" { return INTRINSIC_ARR_RESERVE }
    if name == "try_reserve" { return INTRINSIC_ARR_TRY_RESERVE }
    if name == "remove" { return INTRINSIC_ARR_REMOVE }
    if name == "truncate" { return INTRINSIC_ARR_TRUNCATE }
    if name == "swap" { return INTRINSIC_ARR_SWAP }
    if name == "as_ptr" { return INTRINSIC_AS_PTR }
    if name == "as_mut_ptr" { return INTRINSIC_AS_MUT_PTR }
    if name == "addr" { return INTRINSIC_PTR_ADDR }
    if name == "is_null" { return INTRINSIC_PTR_IS_NULL }
    if name == "add" { return INTRINSIC_PTR_ADD }
    if name == "sub" { return INTRINSIC_PTR_SUB }
    if name == "offset" { return INTRINSIC_PTR_OFFSET }
    if name == "byte_add" { return INTRINSIC_PTR_BYTE_ADD }
    if name == "byte_offset" { return INTRINSIC_PTR_BYTE_OFFSET }
    if name == "read" { return INTRINSIC_PTR_READ }
    if name == "write" { return INTRINSIC_PTR_WRITE }
    if name == "null" { return INTRINSIC_PTR_NULL }
    if name == "null_mut" { return INTRINSIC_PTR_NULL_MUT }
    if name == "to_bits" { return INTRINSIC_FLOAT_TO_BITS }
    if name == "from_bits" { return INTRINSIC_FLOAT_FROM_BITS }
    if name == "is_nan" { return INTRINSIC_FLOAT_IS_NAN }
    if name == "is_finite" { return INTRINSIC_FLOAT_IS_FINITE }
    if name == "is_infinite" { return INTRINSIC_FLOAT_IS_INFINITE }
    if name == "is_sign_negative" { return INTRINSIC_FLOAT_IS_SIGN_NEG }
    if name == "abs" { return INTRINSIC_MATH_ABS }
    if name == "sqrt" { return INTRINSIC_FLOAT_SQRT }
    if name == "floor" { return INTRINSIC_FLOAT_FLOOR }
    if name == "ceil" { return INTRINSIC_FLOAT_CEIL }
    if name == "round" { return INTRINSIC_FLOAT_ROUND }
    if name == "round_ties_even" { return INTRINSIC_FLOAT_ROUND_EVEN }
    if name == "trunc" { return INTRINSIC_FLOAT_TRUNC }
    if name == "bit_or" { return INTRINSIC_INT_BIT_OR }
    if name == "bit_and" { return INTRINSIC_INT_BIT_AND }
    if name == "bit_xor" { return INTRINSIC_INT_BIT_XOR }
    if name == "bit_not" { return INTRINSIC_INT_BIT_NOT }
    if name == "shl" { return INTRINSIC_INT_SHL }
    if name == "shr" { return INTRINSIC_INT_SHR }
    if name == "wrapping_add" { return INTRINSIC_INT_WRAPPING_ADD }
    if name == "wrapping_sub" { return INTRINSIC_INT_WRAPPING_SUB }
    if name == "wrapping_mul" { return INTRINSIC_INT_WRAPPING_MUL }
    if name == "saturating_add" { return INTRINSIC_INT_SAT_ADD }
    if name == "saturating_sub" { return INTRINSIC_INT_SAT_SUB }
    if name == "saturating_mul" { return INTRINSIC_INT_SAT_MUL }
    if name == "min" { return INTRINSIC_INT_MIN }
    if name == "max" { return INTRINSIC_INT_MAX }
    if name == "clamp" { return INTRINSIC_INT_CLAMP }
    if name == "rotate_left" { return INTRINSIC_INT_ROT_L }
    if name == "rotate_right" { return INTRINSIC_INT_ROT_R }
    if name == "swap_bytes" { return INTRINSIC_INT_SWAP_BYTES }
    if name == "reverse_bits" { return INTRINSIC_INT_REV_BITS }
    if name == "leading_zeros" { return INTRINSIC_INT_CLZ }
    if name == "trailing_zeros" { return INTRINSIC_INT_CTZ }
    if name == "count_ones" { return INTRINSIC_INT_POPCNT }
    if name == "count_zeros" { return INTRINSIC_INT_COUNT_ZEROS }
    if name == "is_some" { return INTRINSIC_OPT_IS_SOME }
    if name == "is_none" { return INTRINSIC_OPT_IS_NONE }
    if name == "is_ok" { return INTRINSIC_RES_IS_OK }
    if name == "is_err" { return INTRINSIC_RES_IS_ERR }
    if name == "unwrap" { return INTRINSIC_UNWRAP }
    if name == "unwrap_or" { return INTRINSIC_UNWRAP_OR }
    if name == "unwrap_or_default" { return INTRINSIC_UNWRAP_OR_DEFAULT }
    if name == "unwrap_err" { return INTRINSIC_UNWRAP_ERR }
    if name == "ok" { return INTRINSIC_RES_OK }
    if name == "err" { return INTRINSIC_RES_ERR }
    if name == "spawn" { return INTRINSIC_TASK_SPAWN }
    if name == "join" { return INTRINSIC_TASK_JOIN }
    if name == "wait_any" { return INTRINSIC_TASK_WAIT_ANY }
    if name == "__sync_needs_pool" { return INTRINSIC_SYNC_NEEDS_POOL }
    if name == "__sync_pack" { return INTRINSIC_SYNC_PACK }
    if name == "__sync_freeze" { return INTRINSIC_SYNC_FREEZE }
    if name == "__sync_unpack" { return INTRINSIC_SYNC_UNPACK }
    if name == "__sync_drop_packed" { return INTRINSIC_SYNC_DROP_PACKED }
    if name == "__sync_borrow_ref" { return INTRINSIC_SYNC_BORROW_REF }
    if name == "__sync_thread_token" { return INTRINSIC_SYNC_THREAD_TOKEN }
    if name == "__sync_iso_clone" { return INTRINSIC_SYNC_ISO_CLONE }
    if name == "__sync_shell_drop" { return INTRINSIC_SYNC_SHELL_DROP }
    if name == "sys.exit" { return INTRINSIC_SYS_EXIT }
    if name == "sys.args" { return INTRINSIC_SYS_ARGS }
    if name == "sys.env" { return INTRINSIC_SYS_ENV }
    if name == "sys.read_file" { return INTRINSIC_SYS_READ_FILE }
    if name == "sys.write_file" { return INTRINSIC_SYS_WRITE_FILE }
    if name == "sys.clock" || name == "sys.monotonic_ns" { return INTRINSIC_SYS_CLOCK }
    if name == "sys.alloc" { return INTRINSIC_SYS_ALLOC }
    if name == "sys.free" { return INTRINSIC_SYS_FREE }
    if name == "sys.stderr" { return INTRINSIC_SYS_STDERR }
    if name.len >= 4 && name[0..4] == "sys." { return INTRINSIC_SYS_OTHER }
    if name == "__sys_arg_count" { return INTRINSIC_SYS_ARG_COUNT }
    if name == "__sys_arg" { return INTRINSIC_SYS_ARG }
    if name == "__sys_envp" { return INTRINSIC_SYS_ENVP }
    if name == "__sys_linux_syscall" { return INTRINSIC_SYS_LINUX_SYSCALL }
    if name == "__sys_pid" { return INTRINSIC_SYS_PID }
    if name == "__sys_now_ms" { return INTRINSIC_SYS_NOW_MS }
    if name == "__sys_read_text" { return INTRINSIC_SYS_READ_TEXT }
    if name == "__sys_read_u8" { return INTRINSIC_SYS_READ_U8 }
    if name == "__sys_metadata" { return INTRINSIC_SYS_METADATA }
    if name == "__sys_same_file" { return INTRINSIC_SYS_SAME_FILE }
    if name == "__sys_write_bytes" || name == "__sys_write_u8" { return INTRINSIC_SYS_WRITE_BYTES }
    if name == "__sys_make_executable" { return INTRINSIC_SYS_MAKE_EXECUTABLE }
    if name == "__sys_rename" { return INTRINSIC_SYS_RENAME }
    if name == "__sys_remove_file" { return INTRINSIC_SYS_REMOVE_FILE }
    if name == "__sys_decode_utf8" || name == "__sys_decode_u8" { return INTRINSIC_SYS_DECODE_UTF8 }
    if name == "__sys_decode_u8_range" { return INTRINSIC_SYS_DECODE_U8_RANGE }
    if name == "__sys_write_stderr" { return INTRINSIC_SYS_WRITE_STDERR }
    if name == "__sys_write_text" { return INTRINSIC_SYS_WRITE_TEXT }
    if name == "__sys_append_text" { return INTRINSIC_SYS_APPEND_TEXT }
    if name == "__sys_mkdir" { return INTRINSIC_SYS_MKDIR }
    if name == "__sys_remove_dir" { return INTRINSIC_SYS_REMOVE_DIR }
    if name == "__sys_memory_copy" { return INTRINSIC_SYS_MEM_COPY }
    if name == "__sys_memory_equal" { return INTRINSIC_SYS_MEM_EQUAL }
    if name == "__sys_memory_zero" { return INTRINSIC_SYS_MEM_ZERO }
    if name == "__sys_atomic_load_i64" { return INTRINSIC_SYS_ATOMIC_LOAD }
    if name == "__sys_atomic_store_i64" { return INTRINSIC_SYS_ATOMIC_STORE }
    if name == "__sys_atomic_cas_i64" { return INTRINSIC_SYS_ATOMIC_CAS }
    if name == "__sys_atomic_fetch_add_i64" { return INTRINSIC_SYS_ATOMIC_FETCH_ADD }
    if name == "__sys_pool_alloc_try" { return INTRINSIC_SYS_POOL_ALLOC_TRY }
    if name == "__sys_pool_free" { return INTRINSIC_SYS_POOL_FREE }
    if name == "__sys_bytes_equal" { return INTRINSIC_SYS_BYTES_EQUAL }
    if name == "__sys_bytes_extend" { return INTRINSIC_SYS_BYTES_EXTEND }
    if name == "__sys_bytes_append_text" { return INTRINSIC_SYS_BYTES_APPEND_TEXT }
    if name == "__sys_copy_valid_utf8" { return INTRINSIC_SYS_COPY_VALID_UTF8 }
    if name == "__sys_net_listen" { return INTRINSIC_SYS_NET_LISTEN }
    if name == "__sys_net_accept" { return INTRINSIC_SYS_NET_ACCEPT }
    if name == "__sys_net_connect" { return INTRINSIC_SYS_NET_CONNECT }
    if name == "__sys_net_read" { return INTRINSIC_SYS_NET_READ }
    if name == "__sys_net_peek" { return INTRINSIC_SYS_NET_PEEK }
    if name == "__sys_net_write" { return INTRINSIC_SYS_NET_WRITE }
    if name == "__sys_fd_write" { return INTRINSIC_SYS_FD_WRITE }
    if name == "__sys_net_poll" { return INTRINSIC_SYS_NET_POLL }
    if name == "__sys_net_set_nonblocking" { return INTRINSIC_SYS_NET_SET_NONBLOCKING }
    if name == "__sys_net_set_nodelay" { return INTRINSIC_SYS_NET_SET_NODELAY }
    if name == "__sys_net_local_port" { return INTRINSIC_SYS_NET_LOCAL_PORT }
    if name == "__sys_net_shutdown_write" { return INTRINSIC_SYS_NET_SHUTDOWN_WRITE }
    if name == "__sys_net_close" { return INTRINSIC_SYS_NET_CLOSE }
    if name == "load_ptr" { return INTRINSIC_LOAD_PTR }
    if name == "load_i8" { return INTRINSIC_LOAD_I8 }
    if name == "load_i16" { return INTRINSIC_LOAD_I16 }
    if name == "load_i32" { return INTRINSIC_LOAD_I32 }
    if name == "load_i64" { return INTRINSIC_LOAD_I64 }
    if name == "load_u8" { return INTRINSIC_LOAD_U8 }
    if name == "load_u16" { return INTRINSIC_LOAD_U16 }
    if name == "load_u32" { return INTRINSIC_LOAD_U32 }
    if name == "load_u64" { return INTRINSIC_LOAD_U64 }
    if name == "store_ptr" { return INTRINSIC_STORE_PTR }
    if name == "store_i8" { return INTRINSIC_STORE_I8 }
    if name == "store_i16" { return INTRINSIC_STORE_I16 }
    if name == "store_i32" { return INTRINSIC_STORE_I32 }
    if name == "store_i64" { return INTRINSIC_STORE_I64 }
    if name == "store_u8" { return INTRINSIC_STORE_U8 }
    if name == "store_u16" { return INTRINSIC_STORE_U16 }
    if name == "store_u32" { return INTRINSIC_STORE_U32 }
    if name == "store_u64" { return INTRINSIC_STORE_U64 }
    if name == "static_bytes" { return INTRINSIC_STATIC_BYTES }
    if name == "bytes_view" { return INTRINSIC_BYTES_VIEW }
    if name == "__dunder_module_format_integer" { return INTRINSIC_FORMAT_INT }
    if name == "__dunder_module_format_string" { return INTRINSIC_FORMAT_STR }
    if name == "__dunder_module_format_fixed" { return INTRINSIC_FORMAT_FIXED }
    if name == "__dunder_module_embed_bytes" { return INTRINSIC_EMBED_BYTES }
    if name == "bytes" { return INTRINSIC_STR_BYTES }
    if name == "__ptr_as_ref" { return INTRINSIC_PTR_AS_REF }
    if name == "__map_new" { return INTRINSIC_MAP_NEW }
    if name == "__map_put" { return INTRINSIC_MAP_PUT }
    if name == "__map_put_new" { return INTRINSIC_MAP_PUT_NEW }
    if name == "__map_get" { return INTRINSIC_MAP_GET }
    if name == "__map_get_or" { return INTRINSIC_MAP_GET_OR }
    if name == "__map_get_or_default" { return INTRINSIC_MAP_GET_OR_DEFAULT }
    if name == "__map_get_ref" { return INTRINSIC_MAP_GET_REF }
    if name == "__map_at" { return INTRINSIC_MAP_AT }
    if name == "__map_at_mut" || name == "__map_get_mut" { return INTRINSIC_MAP_AT_MUT }
    if name == "__map_contains" { return INTRINSIC_MAP_CONTAINS }
    if name == "__map_index_of" { return INTRINSIC_MAP_INDEX_OF }
    if name == "__map_find_index" { return INTRINSIC_MAP_FIND_INDEX }
    if name == "__map_remove" { return INTRINSIC_MAP_REMOVE }
    if name == "__map_take" { return INTRINSIC_MAP_TAKE }
    if name == "__map_clear" { return INTRINSIC_MAP_CLEAR }
    if name == "__map_len" { return INTRINSIC_MAP_LEN }
    if name == "__map_is_empty" { return INTRINSIC_MAP_IS_EMPTY }
    if name == "__map_reserve" { return INTRINSIC_MAP_RESERVE }
    if name == "__map_keys" { return INTRINSIC_MAP_KEYS }
    if name == "__map_values" { return INTRINSIC_MAP_VALUES }
    if name == "__map_key_at" { return INTRINSIC_MAP_KEY_AT }
    if name == "__map_value_at" { return INTRINSIC_MAP_VAL_AT }
    if name == "__map_value_at_mut" { return INTRINSIC_MAP_VAL_AT_MUT }
    if name == "__map_value_at_ref" { return INTRINSIC_MAP_VAL_AT_REF }
    if name == "__map_take_at" { return INTRINSIC_MAP_TAKE_AT }
    if name == "__set_new" { return INTRINSIC_SET_NEW }
    if name == "__map_insert" { return INTRINSIC_SET_INSERT }
    INTRINSIC_UNKNOWN
}

// Thin module input adapter populated from modules.Loaded + parser.parse_source.
pub struct ModuleInput {
    mod_id: i32,
    path: string,
    source: string,
    caps_mask: i32,
    ast: ast.Module,
}

pub struct ImportEdge {
    owner_mod: i32,
    alias: string,
    target_mod: i32,
}

pub enum HirStmtKind {
    Let, Assign, Expr, Return, Break, Continue, Defer, UnsafeBlock,
    RegionBlock, TaskScope, While, ForIter, ForRange, Block,
}

pub enum HirExprKind {
    LitInt, LitFloat, LitBool, LitStr, LitCStr, LitWStr, LitRune, LitByte,
    LocalRef, FnRef, ConstRef,
    Unary, Binary, Cast, Try, Move,
    Ref, MutRef, Deref, Field, Index, Slice, BytesView, AddrOf,
    Call, MethodCall, StructLit, EnumLit, TupleLit, ArrayLit,
    Closure, If, Match, Block, Replace, Swap, Error,
}

pub enum HirPatKind { Wild, Bind, Lit, Variant, Struct, Tuple, Or }

pub struct HirLocal {
    name: string,
    ty: i32,
    mode: ht.ParamMode,
    is_mut: bool,
    is_param: bool,
    span_start: i32,
    span_end: i32,
}

pub struct HirExpr {
    kind: HirExprKind,
    ty: i32,
    a: i32,
    b: i32,
    c: i32,
    arg_start: i32,
    arg_len: i32,
    int_val: i64,
    text: string,
    in_unsafe: bool,
    span_start: i32,
    span_end: i32,
}

pub struct HirStmt {
    kind: HirStmtKind,
    local_id: i32,      // Let / ForIter / ForRange / RegionBlock local binding
    expr_a: i32,        // init / cond / lhs / iter / range_start / block_expr
    expr_b: i32,        // rhs / else / cap / range_end / next_fn_id (ForIter)
    stmt_start: i32,    // child stmts slice in HirFn.stmt_list (or body stmt for loops/blocks)
    stmt_len: i32,
    in_unsafe: bool,
    span_start: i32,
    span_end: i32,
}

pub struct HirPat {
    kind: HirPatKind,
    ty: i32,
    local_id: i32,      // bound local for Bind
    tag: i32,           // variant_idx or field_idx
    child_start: i32,
    child_len: i32,
    is_move_bind: bool,
    span_start: i32,
    span_end: i32,
}

pub struct HirFn {
    id: i32,
    name: string,
    owner_mod: i32,
    sig_ty: i32,        // FnPtr or ClosureEnv TypeId in TypeTable
    ret_ty: i32,
    param_count: i32,
    is_pub: bool,
    is_unsafe: bool,
    is_extern: bool,
    is_generic_template: bool,
    is_trait_default: bool,
    is_closure_body: bool,
    requires_caps: i32,
    extern_lib: string,
    extern_symbol: string,
    variadic_fixed: i32,
    link_weak: bool,
    link_delay: bool,
    is_thread_safe: bool,
    is_test: bool,
    test_group: string,
    body_stmt: i32,     // root Block stmt (-1 for extern / trait decl)
    locals: []HirLocal,
    stmts: []HirStmt,
    exprs: []HirExpr,
    pats: []HirPat,
    expr_list: []i32,
    stmt_list: []i32,
    pat_list: []i32,
    span_start: i32,
    span_end: i32,
}

pub struct HirConst {
    name: string,
    owner_mod: i32,
    ty: i32,
    int_val: i64,
    text_val: string,
    is_pub: bool,
    span_start: i32,
    span_end: i32,
}

pub struct HirExternStatic {
    name: string,
    owner_mod: i32,
    ty: i32,
    is_mut: bool,
    extern_lib: string,
    extern_symbol: string,
    link_weak: bool,
    link_delay: bool,
    span_start: i32,
    span_end: i32,
}

pub struct SafeSendSyncCheck {
    ty_id: i32,
    is_sync: bool,
    mod_id: i32,
    span_start: i32,
    span_end: i32,
}

pub struct HirProgram {
    types: ht.TypeTable,
    fns: []HirFn,
    consts: []HirConst,
    extern_statics: []HirExternStatic,
    entry_fn: i32,
    mod_paths: []string,
    mod_caps: []i32,
    embed_blobs: []u8,
    embed_starts: []i32,
    embed_counts: []i32,
    safe_send_sync_checks: []SafeSendSyncCheck,
    diagnostics: []diag.Diagnostic,
    ok: bool,
}

pub fn new_program(platform: i32) -> HirProgram {
    HirProgram {
        types: ht.new_table(platform),
        fns: [],
        consts: [],
        extern_statics: [],
        entry_fn: -1,
        mod_paths: [],
        mod_caps: [],
        embed_blobs: [],
        embed_starts: [],
        embed_counts: [],
        safe_send_sync_checks: [],
        diagnostics: [],
        ok: true,
    }
}

pub fn new_fn(id: i32, name: string, owner_mod: i32, sig_ty: i32, ret_ty: i32, param_count: i32) -> HirFn {
    HirFn {
        id: id,
        name: name.clone(),
        owner_mod: owner_mod,
        sig_ty: sig_ty,
        ret_ty: ret_ty,
        param_count: param_count,
        is_pub: false,
        is_unsafe: false,
        is_extern: false,
        is_generic_template: false,
        is_trait_default: false,
        is_closure_body: false,
        requires_caps: 0,
        extern_lib: "",
        extern_symbol: "",
        variadic_fixed: -1,
        link_weak: false,
        link_delay: false,
        is_thread_safe: false,
        is_test: false,
        test_group: "",
        body_stmt: -1,
        locals: [],
        stmts: [],
        exprs: [],
        pats: [],
        expr_list: [],
        stmt_list: [],
        pat_list: [],
        span_start: 0,
        span_end: 0,
    }
}

pub fn add_fn(prog: &mut HirProgram, move f: HirFn) -> i32 {
    id := prog.fns.len
    mut func := move f
    func.id = id
    prog.fns.push(move func)
    id
}

pub fn add_local(f: &mut HirFn, name: string, ty: i32, mode: ht.ParamMode, is_mut: bool, is_param: bool, start: i32, end: i32) -> i32 {
    id := f.locals.len
    f.locals.push(HirLocal {
        name: name.clone(),
        ty: ty,
        mode: mode,
        is_mut: is_mut,
        is_param: is_param,
        span_start: start,
        span_end: end,
    })
    id
}

pub fn add_expr(f: &mut HirFn, move e: HirExpr) -> i32 {
    id := f.exprs.len
    f.exprs.push(move e)
    id
}

pub fn add_stmt(f: &mut HirFn, move s: HirStmt) -> i32 {
    id := f.stmts.len
    f.stmts.push(move s)
    id
}

pub fn add_pat(f: &mut HirFn, move p: HirPat) -> i32 {
    id := f.pats.len
    f.pats.push(move p)
    id
}

pub fn push_expr_list(f: &mut HirFn, items: &[]i32) -> i32 {
    start := f.expr_list.len
    for i in 0..items.len { f.expr_list.push(items[i]) }
    start
}

pub fn push_stmt_list(f: &mut HirFn, items: &[]i32) -> i32 {
    start := f.stmt_list.len
    for i in 0..items.len { f.stmt_list.push(items[i]) }
    start
}

pub fn push_pat_list(f: &mut HirFn, items: &[]i32) -> i32 {
    start := f.pat_list.len
    for i in 0..items.len { f.pat_list.push(items[i]) }
    start
}

pub fn make_expr(kind: HirExprKind, ty: i32, a: i32, b: i32, c: i32, arg_start: i32, arg_len: i32,
    int_val: i64, text: string, in_unsafe: bool, start: i32, end: i32) -> HirExpr {
    HirExpr {
        kind: kind,
        ty: ty,
        a: a, b: b, c: c,
        arg_start: arg_start, arg_len: arg_len,
        int_val: int_val,
        text: text.clone(),
        in_unsafe: in_unsafe,
        span_start: start, span_end: end,
    }
}

pub fn make_stmt(kind: HirStmtKind, local_id: i32, expr_a: i32, expr_b: i32,
    stmt_start: i32, stmt_len: i32, in_unsafe: bool, start: i32, end: i32) -> HirStmt {
    HirStmt {
        kind: kind,
        local_id: local_id,
        expr_a: expr_a, expr_b: expr_b,
        stmt_start: stmt_start, stmt_len: stmt_len,
        in_unsafe: in_unsafe,
        span_start: start, span_end: end,
    }
}

pub fn push_error(diags: &mut []diag.Diagnostic, code: string, path: string, start: i32, end: i32, message: string) {
    diags.push(diag.Diagnostic {
        severity: .Error,
        code: code.clone(),
        path: path.clone(),
        start: start,
        end: end,
        message: message.clone(),
        note_path: "",
        note_start: -1,
        note_end: -1,
        note_message: "",
    })
}
