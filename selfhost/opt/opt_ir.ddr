pub struct Nodes {
    kinds: []i32, types: []i32, left: []i32, right: []i32, third: []i32, next: []i32,
    values: []i64, locals: []i32, starts: []i32, effects: []i32, proofs: []i32,
}
pub fn new_nodes() -> Nodes { Nodes { kinds: [], types: [], left: [], right: [], third: [], next: [],
    values: [], locals: [], starts: [], effects: [], proofs: [] } }
pub fn reset_nodes(nodes: &mut Nodes) {
    nodes.kinds.clear(); nodes.types.clear(); nodes.left.clear(); nodes.right.clear(); nodes.third.clear()
    nodes.next.clear(); nodes.values.clear(); nodes.locals.clear(); nodes.starts.clear()
    nodes.effects.clear(); nodes.proofs.clear()
}
pub struct Function {
    probing: bool, recording: bool, value: i32, array: i32, heights: []i32,
    supported: bool, root: i32, ret: i32, params: i32, nodes: Nodes,
    local_names: []string, local_types: []i32, local_mutable: []bool,
    local_param: []i32, local_at: []i32,
    visits: i32, rewrites: i32, budget_exhausted: bool,
}
pub fn new() -> Function {
    Function { probing: false, recording: false, value: -1, array: -1, heights: [], supported: false, root: -1, ret: 0, params: 0,
        nodes: new_nodes(), local_names: [],
        local_types: [], local_mutable: [], local_param: [], local_at: [],
        visits: 0, rewrites: 0, budget_exhausted: false }
}
pub fn reset(f: &mut Function) {
    f.supported = false; f.root = -1; f.ret = 0; f.params = 0
    reset_nodes(&mut f.nodes); f.local_names.clear(); f.local_types.clear()
    f.local_mutable.clear(); f.local_param.clear(); f.local_at.clear()
    f.visits = 0; f.rewrites = 0; f.budget_exhausted = false
}
pub fn array_type(ty: i32) -> bool { ty >= 20 && ty <= 23 }
pub fn writable_array(ty: i32) -> bool { ty == 21 || ty == 23 }
pub fn array_element(ty: i32) -> i32 { if ty == 22 || ty == 23 { return 1 } 2 }
pub fn own_effects(kind: i32, op: i64) -> i32 {
    if kind == 1 || kind == 2 || kind == 10 { return 0 }
    if kind == 3 { if op >= 1 && op <= 5 { return 1 }; return 0 }
    if kind == 4 { if op == 1 { return 1 }; return 0 }
    if kind == 5 { return 2 }; if kind == 6 { return 3 }
    if kind == 11 || kind == 12 { return 4 }
    if kind >= 13 && kind <= 17 { return 8 }
    if kind == 18 { return 17 }; if kind == 19 { return 12 }
    -1
}
