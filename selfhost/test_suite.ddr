// The test executable lists stable group IDs and executes one group per process.
// The host can enforce timeouts and continue after an assertion or runtime trap.
import std.bytes as bytes

fn literal(output: &mut []i32, value: string) {
    output.push(34)
    for byte in value.bytes() {
        if byte == 34 || byte == 92 { output.push(92); output.push(byte) }
        else if byte == 10 { bytes.append_text(&mut output, "\\n") }
        else if byte == 13 { bytes.append_text(&mut output, "\\r") }
        else if byte == 9 { bytes.append_text(&mut output, "\\t") }
        else { output.push(byte) }
    }
    output.push(34)
}

pub fn entry(output: &mut []i32, groups: &[]string, calls: &[]string) {
    bytes.append_text(&mut output, "\nfn main() -> i32 {\nif __sys_arg_count() != 2 { return 2 }\nselected := __sys_arg(1)\n")
    bytes.append_text(&mut output, "if selected == \"--list\" {\n")
    for i in 0..groups.len {
        bytes.append_text(&mut output, "print(")
        literal(&mut output, i.str() + " " + groups[i])
        bytes.append_text(&mut output, ")\n")
    }
    bytes.append_text(&mut output, "return 0\n}\n")
    for i in 0..calls.len {
        bytes.append_text(&mut output, "if selected == \"" + i.str() + "\" { " + calls[i] + "(); return 0 }\n")
    }
    bytes.append_text(&mut output, "return 2\n}\n")
}
