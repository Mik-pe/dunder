import driver.driver
import tasks.compile_parallel
import tasks.sign_macho
import tasks.lex_modules

fn default_platform() -> i32 {
    if target_is("arm64-linux") { return 1 }
    if target_is("x86_64-linux") { return 2 }
    0
}

fn main() -> i32 { driver.build_configured(default_platform(), 0, true, compile_parallel.compile_loaded, sign_macho.digest_pages, lex_modules.scan) }
