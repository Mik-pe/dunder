// Canonical scalar synthesis contract. No retained word, variant, recipe, source
// spelling, or target-specific peephole is consulted. Preflight this contract
// before changing a retained operation to canonical lowering mode.
//
// GP operand -1 is ZR/discard; 31 is SP and is forbidden here. W results are
// zero-extended physical register values, not signed source-language i32s.
// aux is shift_amount | (shift_kind << 6); arithmetic permits LSL/LSR/ASR,
// logical operations also permit ROR. Bitfield aux is rotate | (top_bit << 6).
// Add/Sub use a nonnegative immediate only when b=-1, aux=0 and imm!=0;
// imm=0 is always the register/ZR form, avoiding an ambiguous SP operand.
//
// Exact NZCV: arithmetic/logical flags are either unchanged or defined; Compare
// always defines them, CSET reads them. Flag-writing operations must remain
// ordered with their users, including checked arithmetic's trap branches.
// Division conservatively MAY TRAP on every target: a target's guarded machine
// implementation does not establish a language-level speculation proof.
// Float-to-integer conversions are likewise MAY TRAP, but are not synthesized
// by this module. Unknown effect queries return the complete barrier mask.
import mir

pub fn handles(kind: i32) -> bool { kind >= 3 && kind <= 6 }
pub fn expected_effects(kind: i32, opcode: i32) -> i32 {
    if kind == 3 && opcode >= 1 && opcode <= 3 { return 0 }
    if kind == 4 && opcode >= 1 && opcode <= 18 {
        if opcode == 6 || opcode == 7 { return 1 }; return 0
    }
    if kind == 5 && (opcode == 1 || opcode == 2 || opcode == 8 || opcode == 11) { return 0 }
    if kind == 6 && opcode == 0 { return 0 }
    if kind == 19 && (opcode == 14 || opcode == 15) { return 1 }
    255
}
fn gp(value: i32) -> bool { value >= -1 && value <= 30 }
fn columns(f: &mir.Function) -> bool {
    n := f.kinds.len
    f.opcodes.len == n && f.dst.len == n && f.a.len == n && f.b.len == n && f.c.len == n &&
        f.types.len == n && f.imm.len == n && f.aux.len == n && f.effects.len == n &&
        f.flags.len == n && f.abi.len == n && f.reads.len == n && f.writes.len == n &&
        f.clobbers.len == n && f.place.len == n && f.extensions.len == n &&
        f.targets.len == n && f.reloc_kinds.len == n && f.import_ids.len == n
}
fn immediate(value: i64) -> bool {
    value > 0 && (value <= 4095 || (value % 4096 == 0 && value / 4096 <= 4095))
}
fn shifted(aux: i32, width: i32, rotate: bool) -> bool {
    if aux < 0 || aux > 255 || aux.bit_and(63) >= width { return false }
    rotate || aux / 64 <= 2
}
pub fn validate(f: &mir.Function, op: i32) -> bool {
    if op < 0 || op >= f.kinds.len || !columns(&f) { return false }
    kind := f.kinds[op]; opcode := f.opcodes[op]; ty := f.types[op]
    dst := f.dst[op]; a := f.a[op]; b := f.b[op]; c := f.c[op]
    imm := f.imm[op]; aux := f.aux[op]; flags := f.flags[op]
    if !handles(kind) || (ty != 1 && ty != 2) || !gp(dst) || !gp(a) || !gp(b) || !gp(c) ||
        f.effects[op] != expected_effects(kind, opcode) || f.abi[op] != 0 || f.clobbers[op] != 0 ||
        f.place[op] != -1 || f.extensions[op] != 0 || f.targets[op] != -1 || f.reloc_kinds[op] != -1 || f.import_ids[op] != -1 ||
        f.reads[op] != mir.variable_bit(a).bit_or(mir.variable_bit(b)).bit_or(mir.variable_bit(c)) ||
        f.writes[op] != mir.variable_bit(dst) { return false }
    var width := 32; if ty == 2 { width = 64 }
    if kind == 6 {
        // The shared vocabulary implements CSET, not arbitrary CSEL values.
        // AL/NV are excluded because existing targets differ on those aliases.
        return opcode == 0 && a == -1 && b == -1 && c == -1 && aux == 0 && imm >= 0 && imm <= 13 && flags == 1
    }
    if kind == 3 {
        if flags != 0 || b != -1 || c != -1 { return false }
        if opcode == 1 || opcode == 2 {
            if imm != 0 || aux < 0 || aux > 4095 { return false }
            rotate := aux.bit_and(63); top := aux / 64
            // Signed wrapping bitfields have no shared x86/Wasm lowering.
            return rotate < width && top < width && (opcode != 1 || top >= rotate)
        }
        if opcode != 3 || aux < 0 || aux >= width || aux % 16 != 0 { return false }
        mask := i64(65535).shl(aux)
        if imm.bit_and(mask.bit_not()) != 0 { return false }
        // A MOVK-style insertion can untie a and dst with an explicit copy.
        return dst >= 0 || a == -1
    }
    if kind == 5 {
        if dst != -1 || flags != 2 { return false }
    } else if flags != 0 && flags != 2 { return false }
    if opcode == 1 || opcode == 2 {
        if c != -1 { return false }
        if imm != 0 {
            // Immediate ADD/SUB interprets encoded register31 as SP. A real
            // source register is mandatory, and discard requires the S form.
            return b == -1 && a >= 0 && aux == 0 && immediate(imm) && (dst >= 0 || flags == 2)
        }
        return shifted(aux, width, false)
    }
    if opcode >= 8 && opcode <= 13 {
        if c != -1 || imm != 0 || !shifted(aux, width, true) { return false }
        if flags == 2 && opcode != 8 && opcode != 11 { return false }
        return kind != 5 || opcode == 8 || opcode == 11
    }
    if kind != 4 || flags != 0 || imm != 0 || aux != 0 { return false }
    if opcode == 17 || opcode == 18 { return true }
    if c != -1 { return false }
    if opcode == 4 || opcode == 5 { return ty == 2 }
    opcode == 3 || opcode == 6 || opcode == 7 || (opcode >= 14 && opcode <= 16)
}
pub fn can_emit(f: &mir.Function, op: i32) -> bool { validate(&f, op) }
