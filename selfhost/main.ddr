import compile as compiler
import macho
import sys

fn report(path: string, source: string, offset: i32, message: string) {
    var line := 1
    var column := 1
    for i in 0..offset {
        if i >= source.len { break }
        byte := source[i]
        if byte == 10 { line = line + 1; column = 1 }
        else if byte < 128 || byte >= 192 { column = column + 1 }
    }
    print(path + ":" + line.str() + ":" + column.str() + ": error[E1000]: " + message)
}
fn main() -> i32 {
    if sys.arg_count() != 5 || sys.arg(1) != "build" || sys.arg(3) != "-o" {
        print("dunder-ddr build input.ddr -o output")
        return 2
    }
    input := sys.arg(2)
    output := sys.arg(4)
    source := sys.read_text(input)
    if !source.ok { print(sys.error_message(source.error)); return 1 }
    if input == output || sys.same_file(input, output) { print("output must not overwrite source"); return 1 }
    result := compiler.compile(source.value)
    if !result.ok { report(input, source.value, result.offset, result.error); return 1 }
    image := macho.image(&result.text)
    temporary := output + ".dunder-" + sys.pid().str() + ".tmp"
    if sys.metadata(temporary).ok { print("temporary output already exists"); return 1 }
    written := sys.write_bytes(temporary, &image)
    if !written.ok { removed := sys.remove_file(temporary); print(sys.error_message(written.error)); return 1 }
    executable := sys.make_executable(temporary)
    if !executable.ok { removed := sys.remove_file(temporary); print(sys.error_message(executable.error)); return 1 }
    published := sys.rename(temporary, output)
    if !published.ok { removed := sys.remove_file(temporary); print(sys.error_message(published.error)); return 1 }
    print("built " + output)
    0
}
