// The scope owns one immutable declaration world. A returned body is consumed
// in source order while its siblings continue checking on exclusive workers.
import compile as compiler
import frozen_source
import opt_ir
import opt_inline

pub struct Policy { world: frozen_source.World, backend: compiler.BackendBindings, catalog: opt_inline.Frozen, const_div: bool, frame_free: bool }
pub struct Work { session: compiler.Session, ready: bool }
pub fn workspace() -> Work { Work { session: compiler.new_session(), ready: false } }
pub fn freeze(c: &mut compiler.Session, catalog: &opt_inline.Catalog, config: &compiler.Configuration) -> Policy {
    enabled := compiler.enable_frontend(&mut c)
    none: []i32 = []
    if !enabled {
        empty := compiler.new_session()
        return Policy { world: compiler.freeze_validation_world(&empty, &none), backend: compiler.freeze_backend(&empty), catalog: opt_inline.freeze(&catalog), const_div: false, frame_free: false }
    }
    Policy { world: compiler.freeze_validation_world(&c, &none), backend: compiler.freeze_backend(&c), catalog: opt_inline.freeze(&catalog),
        const_div: config.const_div_enabled, frame_free: config.frame_free_enabled }
}
pub fn check(job: compiler.SourceJob, work: &mut Work, policy: &Policy) -> compiler.FrontendBody {
    first := !work.ready
    if first {
        compiler.hydrate_validation_worker(&mut work.session, &policy.world)
        compiler.prepare_emitter(&mut work.session, &policy.backend)
        work.ready = true
    }
    compiler.load_job(&mut work.session, &policy.world, &job)
    var model := opt_ir.new(); var inliner := opt_inline.workspace()
    opt_inline.configure(&mut inliner, policy.const_div, policy.frame_free)
    var catalog := opt_inline.new(); opt_inline.hydrate(&mut catalog, &policy.catalog)
    source := compiler.emit_isolated_into(&mut work.session, job.declaration, &catalog, &mut inliner, &mut model, job.project)
    var out := compiler.empty_frontend(); out.source = source; out.first = first; out.project = job.project
    if model.supported && source.error.len == 0 {
        out.supported = true; out.root = model.root; out.result = model.ret; out.params = model.params
        out.nodes = model.nodes; out.locals = model.local_at; out.types = model.local_types
        out.mutable = model.local_mutable; out.parameters = model.local_param
    }
    out
}
