// JSONL for check --agent. Offsets count UTF-8 bytes in each original file.
import std.bytes as bytes
import sys
import modules
import compile as compiler

fn quote(value: string) -> string {
    var out: []u8 = [34]
    hex := "0123456789abcdef"
    for byte in value.bytes() {
        if byte == 34 || byte == 92 { out.push(92); out.push(u8(byte)) }
        else if byte < 32 {
            bytes.append_utf8(&mut out, "\\u00"); out.push(u8(hex[byte / 16])); out.push(u8(hex[byte % 16]))
        } else { out.push(u8(byte)) }
    }
    out.push(34); sys.decode_u8(&out).value
}
fn public_name(ty: string, names: &[]string) -> string {
    prefix := "__dunder_module_"; var result: []u8 = []; var i := 0
    while i < ty.len {
        if ty[i] == 95 && i + prefix.len <= ty.len && ty[i..i+prefix.len] == prefix {
            var end := i + prefix.len; var id := 0
            while end < ty.len && ty[end] >= 48 && ty[end] <= 57 { id = id * 10 + ty[end] - 48; end = end + 1 }
            if end > i + prefix.len && id < names.len { bytes.append_utf8(&mut result, names[id]); i = end; continue }
        }
        result.push(u8(ty[i])); i = i + 1
    }
    sys.decode_u8(&result).value
}
pub fn error(path: string, source: string, start: i32, message: string) {
    var end := start
    if end < source.len {
        end = end + 1
        while end < source.len && source[end] >= 128 && source[end] < 192 { end = end + 1 }
        first := source[start]
        if first == 95 || (first >= 65 && first <= 90) || (first >= 97 && first <= 122) {
            while end < source.len {
                b := source[end]
                if !(b == 95 || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57)) { break }
                end = end + 1
            }
        }
    }
    print("{\"kind\":\"error\",\"code\":\"E1000\",\"path\":" + quote(path) + ",\"start\":" + start.str() + ",\"end\":" + end.str() + ",\"message\":" + quote(message) + "}")
}
pub fn success(loaded: &modules.Loaded, bindings: &compiler.Bindings) {
    for i in 0..bindings.offsets.len {
        p := modules.location(&loaded, bindings.offsets[i]); name := bindings.names[i]; end := p.offset + name.len
        print("{\"kind\":\"binding\",\"path\":" + quote(p.path) + ",\"start\":" + p.offset.str() + ",\"end\":" + end.str() + ",\"name\":" + quote(name) + ",\"type\":" + quote(public_name(bindings.types[i], &loaded.symbols)) + "}")
    }
    print("{\"kind\":\"ok\",\"modules\":" + loaded.paths.len.str() + "}")
}
