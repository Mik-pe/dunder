// Internal Dunder ABI semantics, independent of ARM instruction encodings.
// All scalar returns, including floats, carry their raw value bits in X0.
// Runtime-global live-outs are observable state, not promises of unchanged
// values. Foreign C returns need their own signature-dependent contract.
import mir

pub fn internal_return_value() -> i32 { 0 }
pub fn internal_return_target() -> i32 { 30 }
pub fn internal_return_stack() -> i32 { 31 }
pub fn internal_return_state_mask() -> i64 {
    // X18 platform state, X19..24 runtime/argv state, X25..28 callee-saved
    // homes, X29 restored FP, and the restored SP remain caller-observable.
    var mask := mir.variable_bit(31)
    for reg in 18..30 { mask = mask.bit_or(mir.variable_bit(reg)) }; mask
}
pub fn internal_return_reads() -> i64 {
    internal_return_state_mask().bit_or(mir.variable_bit(internal_return_value())).bit_or(mir.variable_bit(internal_return_target()))
}
pub fn internal_return_contract(f: &mir.Function, op: i32) -> bool {
    f.kinds[op] == 15 && f.opcodes[op] == 1 && f.abi[op] == 1 && f.dst[op] == -1 &&
        f.a[op] == internal_return_value() && f.b[op] == internal_return_target() && f.c[op] == internal_return_stack() &&
        f.imm[op] == 0 && f.aux[op] == 0 && f.types[op] == 2 && f.place[op] == -1 && f.extensions[op] == 0 &&
        f.effects[op] == 16 && f.flags[op] == 0 && f.reads[op] == internal_return_reads() && f.writes[op] == 0 && f.clobbers[op] == 0
}
