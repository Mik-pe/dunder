// Launch the published executable with an argv array and the inherited environment.
capability unsafe
import receipts

@extern("c","fork") unsafe fn child_process() -> i32
@extern("c","execv") unsafe fn execute(path: ptr, argv: ptr) -> i32
@extern("c","_exit") unsafe fn exit_child(code: i32)
@extern("c","waitpid") unsafe fn wait_child(pid: i32, status: ptr, options: i32) -> i32
@extern("c","kill") unsafe fn signal_child(pid: i32, signal: i32) -> i32
@extern("c","setpgid") unsafe fn process_group(pid: i32, group: i32) -> i32
@extern("c","usleep") unsafe fn sleep_us(interval: u32) -> i32
@extern("c","clock_gettime") unsafe fn read_clock(clock: i32, out: ptr) -> i32

@c_layout
struct Time { seconds: i64, nanos: i64 }

// The platform is the compiler's host, including when it emits another target.
// Return -1 on OS failure so instrumentation cannot fabricate a duration.
pub fn monotonic_nanoseconds(platform: i32) -> i64 {
    unsafe {
        var now: Time = zeroed()
        var clock := 1
        if platform == 0 { clock = 6 }
        if read_clock(clock, addr(&mut now)) != 0 { return -1 }
        return now.seconds * 1000000000 + now.nanos
    }
}
unsafe fn milliseconds(platform: i32) -> i64 {
    now := monotonic_nanoseconds(platform)
    if now < 0 { return -1 }
    now / 1000000
}
fn append_arg(bytes: &mut []u8, offsets: &mut []i32, arg: string) -> bool {
    offsets.push(bytes.len)
    for b in arg.bytes() {
        if b == 0 { return false }
        bytes.push(u8(b))
    }
    bytes.push(0)
    true
}

pub fn run(path: string, args: &[]string, timeout_ms: i64, platform: i32) -> i32 {
    var bytes: []u8 = []
    var offsets: []i32 = []
    if !append_arg(&mut bytes, &mut offsets, path) { return 126 }
    for arg in args { if !append_arg(&mut bytes, &mut offsets, arg) { return 126 } }
    unsafe {
        var argv: []ptr = []
        for offset in offsets { argv.push(addr(&bytes[offset])) }
        argv.push(ptr(0))
        executable := argv[0]
        arguments := addr(&argv[0])
        var status := 0
        status_ptr := addr(&mut status)
        var start: i64 = 0
        if timeout_ms > 0 { start = milliseconds(platform); if start < 0 { return 126 } }
        pid := child_process()
        if pid < 0 { return 126 }
        if pid == 0 {
            if timeout_ms > 0 && process_group(0, 0) != 0 { exit_child(126); return 126 }
            failed := execute(executable, arguments)
            exit_child(127)
            return 127
        }
        var wait_flags := 0
        if timeout_ms > 0 {
            // Both sides establish the group, closing the race before exec.
            grouped := process_group(pid, pid)
            wait_flags = 1
        }
        var timed_out := false
        while true {
            result := wait_child(pid, status_ptr, wait_flags)
            if result == pid { break }
            if result < 0 {
                // An interrupted wait can be retried while this child exists.
                if signal_child(pid, 0) != 0 { return 126 }
            }
            if wait_flags != 0 {
                current := milliseconds(platform)
                if current < 0 || current - start >= timeout_ms {
                    killed := signal_child(-pid, 9)
                    if killed != 0 { fallback := signal_child(pid, 9) }
                    timed_out = true
                    wait_flags = 0
                } else { pause := sleep_us(250) }
            }
        }
        if timed_out { return 124 }
        signal := status.bit_and(127)
        if signal != 0 { return 128 + signal }
        return status.shr(8).bit_and(255)
    }
    126
}

pub fn tests(path: string, groups: &[]string, keys: &[]string, affected: bool, timeout_ms: i64, platform: i32) -> i32 {
    var skipped := 0
    var passed := 0
    var failed := 0
    for i in 0..groups.len {
        var key := ""
        if i < keys.len { key = keys[i] }
        if affected && receipts.seen(key) { skipped = skipped + 1; continue }
        args: []string = [i.str()]
        result := run(path, &args, timeout_ms, platform)
        receipts.update(key, result == 0)
        if result == 0 { passed = passed + 1; print("PASS " + groups[i]) }
        else { failed = failed + 1; print("FAIL " + groups[i] + " (exit " + result.str() + ")") }
    }
    if affected { print(skipped.str() + " unaffected") }
    print(passed.str() + " passed, " + failed.str() + " failed")
    if failed > 0 { return 1 }
    0
}
