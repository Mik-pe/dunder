// A separate trusted ABI premise, not a register-liveness, NoModRef or terminal
// declaration. Raw MIR has no such promise. Under source ABI version1:
// - calls obey the declared source/native ABI; X25..28 are preserved hidden
//   state, never semantic arguments or observable scratch inputs;
// - the caller's private frame reservation/padding and exact incoming call SP
//   are implementation-private. Valid arguments, stack arguments and escaped
//   source objects must retain their ordinary values and observable behavior.
// This grants NO NoModRef premise for original frame cells, no preservation of
// X0..24 or flags, and no exemption from synchronization around ANY call.
// A raw callee observing call SP or incoming X25, or permanently clobbering
// X25..28, does not satisfy this contract. A complete trusted source producer
// must prove ABI-conforming callees/bridges before constructing version1.
pub opaque struct Context { version: i32 }
pub fn conservative() -> Context { Context { version: 0 } }
pub fn trusted_source_abi_v1() -> Context { Context { version: 1 } }
pub fn for_source_producer(enabled: bool) -> Context {
    if enabled { return trusted_source_abi_v1() }; conservative()
}
pub fn source_abi(ctx: &Context) -> bool { ctx.version == 1 }
pub fn policy_tag(ctx: &Context) -> string {
    if source_abi(&ctx) { "mir-call-abi:source-v1" } else { "mir-call-abi:raw-v1" }
}
