// Exact conversion of decimal source to IEEE bits. Base 2^24 limbs fit all
// tenfold multiplies in i32. A binary64 midpoint has <= 768 significant
// decimal digits, so a sticky bit suffices after 800 digits.
pub struct Number { ok: bool, bits: i64 }

fn multiply(value: &mut []i32, factor: i32, add: i32) {
    var carry := add
    for i in 0..value.len {
        n := value[i] * factor + carry
        value[i] = n % 16777216
        carry = n / 16777216
    }
    if carry != 0 { value.push(carry) }
}

fn compare(a: &[]i32, b: &[]i32) -> i32 {
    if a.len != b.len { return a.len - b.len }
    var i := a.len - 1
    while i >= 0 {
        if a[i] != b[i] { return a[i] - b[i] }
        i = i - 1
    }
    0
}

fn subtract(a: &mut []i32, b: &[]i32) {
    var borrow := 0
    for i in 0..a.len {
        var n := a[i] - borrow
        if i < b.len { n = n - b[i] }
        borrow = 0
        if n < 0 { n = n + 16777216; borrow = 1 }
        a[i] = n
    }
    while a.len > 0 && a[a.len - 1] == 0 { last := a.pop() }
}

pub fn decode(text: string, single: bool) -> Number {
    var sign: i64 = 0
    var bias := 1023
    var fraction := 52
    if single { bias = 127; fraction = 23 }
    var i := 0
    if text[0] == 45 {
        i = 1; sign = -9223372036854775808
        if single { sign = 2147483648 }
    }
    var numerator: []i32 = []
    var denominator: []i32 = [1]
    var after_point := false
    var digits := 0
    var scale: i64 = 0
    var sticky := false
    while i < text.len {
        byte := text[i]; i = i + 1
        if byte == 69 || byte == 101 {
            var negative := false
            if i < text.len && (text[i] == 43 || text[i] == 45) { negative = text[i] == 45; i = i + 1 }
            var power: i64 = 0
            while i < text.len {
                digit := text[i]; i = i + 1
                if digit != 95 && power < 10000000000 { power = power * 10 + i64(digit - 48) }
            }
            if negative { scale = scale - power } else { scale = scale + power }
            break
        }
        if byte == 95 { continue }
        if byte == 46 { after_point = true; continue }
        if after_point { scale = scale - 1 }
        if byte == 48 && digits == 0 { continue }
        if digits < 800 {
            multiply(&mut numerator, 10, byte - 48); digits = digits + 1
        } else {
            scale = scale + 1
            if byte != 48 { sticky = true }
        }
    }
    if digits == 0 || i64(digits) + scale < -324 { return Number { ok: true, bits: sign } }
    if i64(digits) + scale > 309 { return Number { ok: false, bits: 0 } }
    while scale > 0 { multiply(&mut numerator, 10, 0); scale = scale - 1 }
    while scale < 0 { multiply(&mut denominator, 10, 0); scale = scale + 1 }
    var exponent := 0
    if compare(&numerator, &denominator) < 0 {
        while compare(&numerator, &denominator) < 0 { multiply(&mut numerator, 2, 0); exponent = exponent - 1 }
    } else {
        var twice := denominator
        multiply(&mut twice, 2, 0)
        while compare(&numerator, &twice) >= 0 {
            multiply(&mut denominator, 2, 0); multiply(&mut twice, 2, 0); exponent = exponent + 1
        }
    }
    var precision := fraction + 1
    if exponent < 1 - bias { precision = precision + exponent - (1 - bias) }
    if precision < 0 { return Number { ok: true, bits: sign } }
    var mantissa: i64 = 0
    for j in 0..precision {
        mantissa = mantissa * 2
        if compare(&numerator, &denominator) >= 0 {
            mantissa = mantissa + 1
            subtract(&mut numerator, &denominator)
        }
        multiply(&mut numerator, 2, 0)
    }
    rounding := compare(&numerator, &denominator)
    if rounding > 0 || (rounding == 0 && (sticky || mantissa % 2 != 0)) { mantissa = mantissa + 1 }
    unit := i64(1).shl(fraction)
    if mantissa >= unit * 2 { mantissa = mantissa / 2; exponent = exponent + 1 }
    if exponent > bias { return Number { ok: false, bits: 0 } }
    if exponent >= 1 - bias { mantissa = mantissa + i64(exponent + bias - 1) * unit }
    Number { ok: true, bits: mantissa.bit_or(sign) }
}
