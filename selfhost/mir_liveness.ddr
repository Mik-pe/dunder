// Whole-function physical-variable liveness and actual CFG loop membership.
// Calls' MAY clobbers kill old physical values; they are not semantic SSA defs.
// Primitive arenas are reused across functions, with one bounded work budget.
import mir
import mir_call_inputs as call_inputs

pub opaque struct Workspace {
    use: []i64, define: []i64, incoming: []i64, outgoing: []i64, after: []i64,
    flag_use: []i32, flag_define: []i32, flag_in: []i32, flag_out: []i32, flag_after: []i32,
    pred_starts: []i32, pred_fill: []i32, predecessors: []i32,
    reached: []bool, queued: []bool, cursors: []i32, queue: []i32, finish: []i32,
    components: []i32, component_sizes: []i32, loop: []bool,
    status: i32, work: i32, limit: i32,
}
pub fn new() -> Workspace { Workspace { use: [], define: [], incoming: [], outgoing: [], after: [],
    flag_use: [], flag_define: [], flag_in: [], flag_out: [], flag_after: [],
    pred_starts: [], pred_fill: [], predecessors: [], reached: [], queued: [], cursors: [],
    queue: [], finish: [], components: [], component_sizes: [], loop: [], status: 0, work: 0, limit: 0 } }
fn charge(w: &mut Workspace, units: i32) -> bool {
    if units < 0 || units > w.limit - w.work { w.status = -3; return false }
    w.work = w.work + units; true
}
pub fn status(w: &Workspace) -> i32 { w.status }
pub fn units(w: &Workspace) -> i32 { w.work }
pub fn reachable(w: &Workspace, block: i32) -> bool { w.status == 1 && block >= 0 && block < w.reached.len && w.reached[block] }
pub fn loop_block(w: &Workspace, block: i32) -> bool { w.status == 1 && block >= 0 && block < w.loop.len && w.loop[block] }
pub fn live_in(w: &Workspace, block: i32) -> i64 { assert(w.status == 1); w.incoming[block] }
pub fn live_out(w: &Workspace, block: i32) -> i64 { assert(w.status == 1); w.outgoing[block] }
pub fn live_after(w: &Workspace, op: i32) -> i64 { assert(w.status == 1); w.after[op] }
pub fn flags_after(w: &Workspace, op: i32) -> bool { assert(w.status == 1); w.flag_after[op] != 0 }
fn reset(w: &mut Workspace, limit: i32) {
    w.use.clear(); w.define.clear(); w.incoming.clear(); w.outgoing.clear(); w.after.clear()
    w.flag_use.clear(); w.flag_define.clear(); w.flag_in.clear(); w.flag_out.clear(); w.flag_after.clear()
    w.pred_starts.clear(); w.pred_fill.clear(); w.predecessors.clear(); w.reached.clear(); w.queued.clear()
    w.cursors.clear(); w.queue.clear(); w.finish.clear(); w.components.clear(); w.component_sizes.clear(); w.loop.clear()
    w.status = 0; w.work = 0; w.limit = limit
}
fn graph(w: &mut Workspace, f: &mir.Function) -> bool {
    blocks := f.block_starts.len; edges := f.edge_to.len
    if !charge(&mut w, blocks + edges) { return false }
    w.pred_fill.reserve(blocks); w.reached.reserve(blocks); w.queued.reserve(blocks); w.cursors.reserve(blocks)
    w.components.reserve(blocks); w.component_sizes.reserve(blocks); w.loop.reserve(blocks)
    w.pred_starts.reserve(blocks + 1); w.finish.reserve(blocks); w.queue.reserve(blocks)
    for b in 0..blocks {
        w.pred_fill.push(0); w.reached.push(false); w.queued.push(false); w.cursors.push(f.edge_starts[b])
        w.components.push(-1); w.component_sizes.push(0); w.loop.push(false)
    }
    for e in 0..edges { to := f.edge_to[e]; if to >= 0 { w.pred_fill[to] = w.pred_fill[to] + 1 } }
    w.pred_starts.push(0)
    for b in 0..blocks { w.pred_starts.push(w.pred_starts[b] + w.pred_fill[b]); w.pred_fill[b] = w.pred_starts[b] }
    w.predecessors.reserve(w.pred_starts[blocks])
    for e in 0..w.pred_starts[blocks] { w.predecessors.push(0) }
    for e in 0..edges {
        to := f.edge_to[e]; if to < 0 { continue }
        w.predecessors[w.pred_fill[to]] = f.edge_from[e]; w.pred_fill[to] = w.pred_fill[to] + 1
    }
    // Iterative DFS finishing order. A backward PC edge alone is not a loop.
    if blocks == 0 { return true }
    w.queue.push(0); w.reached[0] = true
    while w.queue.len > 0 {
        if !charge(&mut w, 1) { return false }
        b := w.queue[w.queue.len - 1]; edge := w.cursors[b]
        if edge == f.edge_starts[b + 1] { removed := w.queue.pop(); w.finish.push(b); continue }
        w.cursors[b] = edge + 1; to := f.edge_to[edge]
        if to >= 0 && !w.reached[to] { w.reached[to] = true; w.queue.push(to) }
    }
    // Kosaraju's reverse walk is linear and requires no recursion or per-edge
    // records. Late owned initialization can reach an earlier body acyclically.
    var at := w.finish.len; var component := 0
    while at > 0 {
        at = at - 1; root := w.finish[at]
        if w.components[root] >= 0 { continue }
        w.queue.push(root); w.components[root] = component
        while w.queue.len > 0 {
            if !charge(&mut w, 1) { return false }
            b := w.queue.pop(); w.component_sizes[component] = w.component_sizes[component] + 1
            if !charge(&mut w, w.pred_starts[b + 1] - w.pred_starts[b]) { return false }
            for p in w.pred_starts[b]..w.pred_starts[b + 1] {
                from := w.predecessors[p]
                if w.reached[from] && w.components[from] < 0 { w.components[from] = component; w.queue.push(from) }
            }
        }
        component = component + 1
    }
    if !charge(&mut w, blocks + edges) { return false }
    for b in 0..blocks { if w.reached[b] { w.loop[b] = w.component_sizes[w.components[b]] > 1 } }
    for e in 0..edges { if f.edge_from[e] == f.edge_to[e] { w.loop[f.edge_from[e]] = true } }
    true
}
pub fn analyze_with_inputs_into(w: &mut Workspace, f: &mir.Function, inputs: &call_inputs.Context, limit: i32) -> bool {
    reset(&mut w, limit)
    if !f.valid || !f.verified { w.status = -1; return false }
    if !f.optimizable || f.unknown_control { w.status = -2; return false }
    n := f.kinds.len; blocks := f.block_starts.len
    if limit < 0 || n > 65536 || blocks > 16384 || f.edge_to.len > 32768 { w.status = -3; return false }
    if !graph(&mut w, &f) { return false }
    source_inputs := call_inputs.source_inputs(&inputs)
    if !charge(&mut w, n + blocks) { return false }
    w.after.reserve(n); w.flag_after.reserve(n)
    w.use.reserve(blocks); w.define.reserve(blocks); w.incoming.reserve(blocks); w.outgoing.reserve(blocks)
    w.flag_use.reserve(blocks); w.flag_define.reserve(blocks); w.flag_in.reserve(blocks); w.flag_out.reserve(blocks)
    for op in 0..n { w.after.push(0); w.flag_after.push(0) }
    for b in 0..blocks {
        var use: i64 = 0; var define: i64 = 0; var flag_use := 0; var flag_define := 0
        for position in f.block_starts[b]..f.block_ends[b] {
            op := f.order[position]; if f.modes[op] == 2 { continue }
            var reads := f.reads[op]
            if source_inputs && f.kinds[op] == 14 { reads = call_inputs.reads(&inputs, &f, op) }
            use = use.bit_or(reads.bit_and(define.bit_not()))
            define = define.bit_or(f.writes[op]).bit_or(f.clobbers[op])
            if f.flags[op].bit_and(1) != 0 && flag_define == 0 { flag_use = 1 }
            if f.flags[op].bit_and(2) != 0 { flag_define = 1 }
        }
        w.use.push(use); w.define.push(define); w.incoming.push(0); w.outgoing.push(0)
        w.flag_use.push(flag_use); w.flag_define.push(flag_define); w.flag_in.push(0); w.flag_out.push(0)
    }
    // A bounded circular worklist holds at most one pending visit per block.
    // DFS post-order visits exits before predecessors so acyclic CFGs converge in one sweep.
    w.queue.clear()
    for i in 0..w.finish.len { b := w.finish[i]; w.queue.push(b); w.queued[b] = true }
    for b in 0..blocks { if !w.reached[b] { w.queue.push(b); w.queued[b] = true } }
    var head := 0; var tail := 0; var pending := blocks
    while pending > 0 {
        b := w.queue[head]; head = (head + 1) % blocks; pending = pending - 1; w.queued[b] = false
        if !charge(&mut w, 1 + f.edge_starts[b + 1] - f.edge_starts[b]) { return false }
        var outgoing: i64 = 0; var flags := 0
        for e in f.edge_starts[b]..f.edge_starts[b + 1] {
            to := f.edge_to[e]; if to >= 0 { outgoing = outgoing.bit_or(w.incoming[to]); flags = flags.bit_or(w.flag_in[to]) }
        }
        incoming := w.use[b].bit_or(outgoing.bit_and(w.define[b].bit_not()))
        var flag_in := w.flag_use[b]; if w.flag_define[b] == 0 { flag_in = flag_in.bit_or(flags) }
        w.outgoing[b] = outgoing; w.flag_out[b] = flags
        if incoming == w.incoming[b] && flag_in == w.flag_in[b] { continue }
        w.incoming[b] = incoming; w.flag_in[b] = flag_in
        if !charge(&mut w, w.pred_starts[b + 1] - w.pred_starts[b]) { return false }
        for p in w.pred_starts[b]..w.pred_starts[b + 1] {
            from := w.predecessors[p]
            if !w.queued[from] { w.queue[tail] = from; tail = (tail + 1) % blocks; pending = pending + 1; w.queued[from] = true }
        }
    }
    if !charge(&mut w, n) { return false }
    for b in 0..blocks {
        var live := w.outgoing[b]; var flags := w.flag_out[b]; var position := f.block_ends[b]
        while position > f.block_starts[b] {
            position = position - 1; op := f.order[position]; w.after[op] = live; w.flag_after[op] = flags
            if f.modes[op] == 2 { continue }
            var reads := f.reads[op]
            if source_inputs && f.kinds[op] == 14 { reads = call_inputs.reads(&inputs, &f, op) }
            live = reads.bit_or(live.bit_and(f.writes[op].bit_or(f.clobbers[op]).bit_not()))
            if f.flags[op].bit_and(2) != 0 { flags = 0 }
            if f.flags[op].bit_and(1) != 0 { flags = 1 }
        }
    }
    w.status = 1; true
}
// Existing clients retain raw physical observations. Only a producer-owned
// call-input contract may change uses; MAY clobbers, flags and CFG stay exact.
pub fn analyze_into(w: &mut Workspace, f: &mir.Function, limit: i32) -> bool {
    inputs := call_inputs.conservative(); analyze_with_inputs_into(&mut w, &f, &inputs, limit)
}
