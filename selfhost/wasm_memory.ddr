// Memory instructions for the selfhost's shared register and stack ABI.
// Effective addresses live in i64 registers. Only the final memory access
// consumes a wasm32 address. Positive displacements use Wasm's memarg so an
// access past the end of linear memory traps instead of wrapping to zero.
import wasm_bytes as b

fn add_offset(out: &mut []u8, offset: i32) {
    if offset != 0 { b.constant(&mut out, i64(offset)); b.op(&mut out, 124) }
}

fn update_base(out: &mut []u8, reg: i32, offset: i32) {
    b.base(&mut out, reg)
    add_offset(&mut out, offset)
    b.set_base(&mut out, reg)
}

// The effective base address is on the operand stack. Size is log2(bytes).
// Kind 0 stores; 1 loads unsigned; 2 sign-extends to X; 3 sign-extends to W.
fn transfer(out: &mut []u8, reg: i32, kind: i32, size: i32, offset: i32) {
    var displacement := offset
    if offset < 0 { add_offset(&mut out, offset); displacement = 0 }
    b.op(&mut out, 167) // i32.wrap_i64
    var opcode := 41 // i64.load
    if kind == 0 {
        b.read(&mut out, reg)
        opcode = 55 // i64.store
        if size != 3 { opcode = 60 + size }
    } else if size != 3 {
        opcode = 48 + 2 * size // i64.load8_s, load16_s, load32_s
        if kind == 1 { opcode = opcode + 1 }
    }
    b.op(&mut out, opcode)
    b.uleb(&mut out, size)
    b.uleb(&mut out, displacement)
    if kind != 0 {
        if kind == 3 { b.op(&mut out, 167); b.op(&mut out, 173) }
        b.write(&mut out, reg)
    }
}

fn signed_field(n: i32, sign_bit: i32) -> i32 {
    if n >= sign_bit { return n - 2 * sign_bit }
    n
}

fn single(out: &mut []u8, w: i64, scaled: bool) -> bool {
    size := b.bits(w, 30, 3)
    kind := b.bits(w, 22, 3)
    if (size == 3 && kind >= 2) || (size == 2 && kind == 3) { return false }
    reg := b.bits(w, 0, 31)
    base := b.bits(w, 5, 31)
    var offset := signed_field(b.bits(w, 12, 511), 256)
    var mode := 0
    if scaled { offset = b.bits(w, 10, 4095).shl(size) }
    else { mode = b.bits(w, 10, 3) }
    if mode == 3 { update_base(&mut out, base, offset) }
    b.base(&mut out, base)
    var displacement := offset
    if mode == 1 || mode == 3 { displacement = 0 }
    transfer(&mut out, reg, kind, size, displacement)
    if mode == 1 { update_base(&mut out, base, offset) }
    true
}

fn pair(out: &mut []u8, w: i64) -> bool {
    width := b.bits(w, 30, 3)
    var kind := b.bits(w, 22, 1)
    if width == 3 || (width == 1 && kind == 0) { return false }
    var size := 2
    if width == 2 { size = 3 }
    if width == 1 { kind = 2 } // LDPSW
    offset := signed_field(b.bits(w, 15, 127), 64).shl(size)
    mode := b.bits(w, 23, 3)
    base := b.bits(w, 5, 31)
    if mode == 3 { update_base(&mut out, base, offset) }
    b.base(&mut out, base)
    b.indexed(&mut out, 33, 7) // preserve the effective base for both transfers
    var displacement := offset
    if mode == 1 || mode == 3 { displacement = 0 }
    b.indexed(&mut out, 32, 7)
    transfer(&mut out, b.bits(w, 0, 31), kind, size, displacement)
    b.indexed(&mut out, 32, 7)
    transfer(&mut out, b.bits(w, 10, 31), kind, size, displacement + i32(1).shl(size))
    if mode == 1 { update_base(&mut out, base, offset) }
    true
}

// x12 is the exclusive end of the new block, already checked against the pool
// bound. Freed blocks are recycled by the allocator before reaching this path.
fn grow_to_end(out: &mut []u8) {
    b.read(&mut out, 12)
    b.constant(&mut out, 65535); b.op(&mut out, 124)
    b.constant(&mut out, 16); b.op(&mut out, 136) // required pages
    b.indexed(&mut out, 34, 7)
    b.op(&mut out, 63); b.op(&mut out, 0); b.op(&mut out, 173)
    b.op(&mut out, 86) // required > memory.size, unsigned
    b.op(&mut out, 4); b.op(&mut out, 64)
    b.indexed(&mut out, 32, 7); b.op(&mut out, 167)
    b.op(&mut out, 63); b.op(&mut out, 0); b.op(&mut out, 107)
    b.op(&mut out, 64); b.op(&mut out, 0) // memory.grow
    b.i32_const(&mut out, -1); b.op(&mut out, 70)
    b.op(&mut out, 4); b.op(&mut out, 64); b.op(&mut out, 0); b.op(&mut out, 11)
    b.op(&mut out, 11)
}

// Array clones, buffer growth and string operations copy into separate live
// storage. Preserve the advancing cursors used by consecutive string copies.
fn copy_bytes(out: &mut []u8) {
    b.read(&mut out, 11); b.op(&mut out, 167)
    b.read(&mut out, 10); b.op(&mut out, 167)
    b.read(&mut out, 12); b.op(&mut out, 167)
    b.op(&mut out, 252); b.op(&mut out, 10); b.op(&mut out, 0); b.op(&mut out, 0)
    for reg in 10..12 {
        b.read(&mut out, reg); b.read(&mut out, 12)
        b.op(&mut out, 124); b.write(&mut out, reg)
    }
    b.constant(&mut out, 0); b.write(&mut out, 12)
}

pub fn word(out: &mut []u8, w: i64) -> bool {
    if w == 4278194176 { grow_to_end(&mut out); return true }
    if w == 4278194177 { copy_bytes(&mut out); return true }
    if b.bits(w, 26, 1) != 0 { return false } // SIMD memory forms
    scaled := w.bit_and(989855744) == 956301312
    if scaled || w.bit_and(991952896) == 939524096 { return single(&mut out, w, scaled) }
    if w.bit_and(973078528) == 671088640 { return pair(&mut out, w) }
    false
}
