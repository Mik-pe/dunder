unsafe {\n        _ := static_bytes(\"native\", 16)\n        var buf: [u8; 4096] = [0; 4096]\n        p := c_getcwd(addr(&mut buf[0]), 4096)\n        if usize(p) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: read_errno() }\n        }\n        return decode_cstr(p)\n    }\n    sys.TextResult { ok: false, value: \"\", error: 45 }\n}\n\n@requires(filesystem)\npub fn realpath(path: string) -> sys.TextResult {\n    var raw: []u8 = []\n    perr := c_path(path, &mut raw)\n    if perr != 0 { return sys.TextResult { ok: false, value: \"\", error: perr } }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        var buf: [u8; 4096] = [0; 4096]\n        p := c_realpath(addr(&raw[0]), addr(&mut buf[0]))\n        if usize(p) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: read_errno() }\n        }\n        return decode_cstr(p)\n    }\n    sys.TextResult { ok: false, value: \"\", error: 45 }\n}\n\n@requires(filesystem)\npub fn is_symlink(path: string) -> bool {\n    var raw: []u8 = []\n    if c_path(path, &mut raw) != 0 { return false }\n    var scratch: u8 = 0\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        return c_readlink(addr(&raw[0]), addr(&mut scratch), 1) >= 0\n    }\n    false\n}\n\n@requires(filesystem)\npub fn symlink(target: string, link_path: string) -> sys.Status {\n    var raw_target: []u8 = []\n    var raw_link: []u8 = []\n    e1 := c_path(target, &mut raw_target)\n    if e1 != 0 { return sys.Status { ok: false, error: e1 } }\n    e2 := c_path(link_path, &mut raw_link)\n    if e2 != 0 { return sys.Status { ok: false, error: e2 } }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        if c_symlink(addr(&raw_target[0]), addr(&raw_link[0])) == 0 {\n            return sys.Status { ok: true, error: 0 }\n        }\n        return sys.Status { ok: false, error: read_errno() }\n    }\n    sys.Status { ok: false, error: 45 }\n}\n\n@requires(filesystem)\npub fn hard_link(existing: string, link_path: string) -> sys.Status {\n    var raw_existing: []u8 = []\n    var raw_link: []u8 = []\n    e1 := c_path(existing, &mut raw_existing)\n    if e1 != 0 { return sys.Status { ok: false, error: e1 } }\n    e2 := c_path(link_path, &mut raw_link)\n    if e2 != 0 { return sys.Status { ok: false, error: e2 } }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        if c_link(addr(&raw_existing[0]), addr(&raw_link[0])) == 0 {\n            return sys.Status { ok: true, error: 0 }\n        }\n        return sys.Status { ok: false, error: read_errno() }\n    }\n    sys.Status { ok: false, error: 45 }\n}\n\n@requires(filesystem)\npub fn mkdir_all(path: string) -> sys.Status {\n    if path.len == 0 { return sys.Status { ok: false, error: 22 } }\n    if path.len > 1023 { return sys.Status { ok: false, error: 63 } }\n    for b in path.bytes() { if b == 0 { return sys.Status { ok: false, error: 22 } } }\n    info := sys.metadata(path)\n    if info.ok {\n        if info.is_dir { return sys.Status { ok: true, error: 0 } }\n        return sys.Status { ok: false, error: 17 }\n    }\n    var i := 0\n    if path[0] == 47 { i = 1 }\n    while i <= path.len {\n        if i == path.len || path[i] == 47 {\n            if i > 0 {\n                prefix := path[0..i]\n                if prefix != \".\" && prefix != \"..\" {\n                    pinfo := sys.metadata(prefix)\n                    if !pinfo.ok {\n                        st := sys.mkdir(prefix)\n                        if !st.ok && st.error != 17 { return st }\n                        check := sys.metadata(prefix)\n                        if !check.ok || !check.is_dir {\n                            return sys.Status { ok: false, error: 17 }\n                        }\n                    } else if !pinfo.is_dir {\n                        return sys.Status { ok: false, error: 20 }\n                    }\n                }\n            }\n        }\n        i = i + 1\n    }\n    sys.Status { ok: true, error: 0 }\n}\n\n@requires(filesystem)\npub fn temp_dir(prefix: string) -> sys.TextResult {\n    for b in prefix.bytes() {\n        if b == 0 || b == 47 {\n            return sys.TextResult { ok: false, value: \"\", error: 22 }\n        }\n    }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        var base := \"/tmp\"\n        env_p := c_getenv(cstr(\"TMPDIR\"))\n        if usize(env_p) != 0 {\n            dec := decode_cstr(env_p)\n            if dec.ok && dec.value.len > 0 && dec.value.len < 900 {\n                base = dec.value\n            }\n        }\n        while base.len > 1 && base[base.len - 1] == 47 {\n            base = base[0..base.len - 1]\n        }\n        full := base + \"/\" + prefix + \"XXXXXX\"\n        var tmpl: []u8 = []\n        perr := c_path(full, &mut tmpl)\n        if perr != 0 { return sys.TextResult { ok: false, value: \"\", error: perr } }\n        created := c_mkdtemp(addr(&mut tmpl[0]))\n        if usize(created) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: read_errno() }\n        }\n        return bytes.decode_range(&tmpl, 0, tmpl.len - 1)\n    }\n    sys.TextResult { ok: false, value: \"\", error: 45 }\n}\n\nfn list_dir_internal(path: string) -> DirEntriesResult {\n    var raw: []u8 = []\n    perr := c_path(path, &mut raw)\n    if perr != 0 { return DirEntriesResult { ok: false, entries: [], error: perr } }\n    var names: []string = []\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        darwin := host_is_darwin()\n        if darwin < 0 { return DirEntriesResult { ok: false, entries: [], error: 45 } }\n        var name_at := 19\n        var errno_sym := cstr(\"__errno_location\")\n        if darwin == 1 { name_at = 21; errno_sym = cstr(\"__error\") }\n        h := dl.open(ptr(0), 2)\n        if usize(h) == 0 { return DirEntriesResult { ok: false, entries: [], error: 5 } }\n        sym := dl.symbol(h, errno_sym)\n        if usize(sym) == 0 { _ := dl.close(h); return DirEntriesResult { ok: false, entries: [], error: 5 } }\n        errno_fn: extern fn() -> ptr = ffi_fn(sym)\n        errno_ptr := errno_fn()\n        _ := dl.close(h)\n\n        dir := c_opendir(addr(&raw[0]))\n        if usize(dir) == 0 {\n            err := portable_errno(load_i32(errno_ptr), darwin == 1)\n            return DirEntriesResult { ok: false, entries: [], error: err }\n        }\n        var raw_name: []u8 = []\n        var read_err := 0\n        while true {\n            store_i32(errno_ptr, 0)\n            entry := c_readdir(dir)\n            if usize(entry) == 0 {\n                e := load_i32(errno_ptr)\n                if e != 0 { read_err = portable_errno(e, darwin == 1) }\n                break\n            }\n            rec_len := i32(load_u16(ptr(usize(entry) + 16)))\n            raw_name.clear()\n            for off in name_at..rec_len {\n                b := load_u8(ptr(usize(entry) + usize(off)))\n                if b == 0 { break }\n                raw_name.push(b)\n            }\n            dec := bytes.decode(&raw_name)\n            if !dec.ok { read_err = 92; break }\n            if dec.value != \"\" && dec.value != \".\" && dec.value != \"..\" {\n                names.push(dec.value)\n            }\n        }\n        closed := c_closedir(dir)\n        if read_err != 0 { return DirEntriesResult { ok: false, entries: [], error: read_err } }\n        if closed != 0 {\n            return DirEntriesResult { ok: false, entries: [], error: portable_errno(load_i32(errno_ptr), darwin == 1) }\n        }\n    }\n    array.sort_strings(&mut names)\n    DirEntriesResult { ok: true, entries: names, error: 0 }\n}\n\n@requires(filesystem)\npub fn list_dir(path: string) -> DirEntriesResult { list_dir_internal(path) }\n\npub fn list_read_dir(dir: &ReadDir) -> DirEntriesResult {\n    if dir.root.len == 0 { return DirEntriesResult { ok: false, entries: [], error: 22 } }\n    list_dir_internal(dir.root)\n}\n\n@requires(filesystem)\npub fn remove_all(path: string) -> sys.Status {\n    if path.len == 0 || path == \"/\" || path == \".\" || path == \"..\" {\n        return sys.Status { ok: false, error: 22 }\n    }\n    if is_symlink(path) {\n        return sys.remove_file(path)\n    }\n    info := sys.metadata(path)\n    if !info.ok {\n        if info.error == 2 { return sys.Status { ok: true, error: 0 } }\n        return sys.Status { ok: false, error: info.error }\n    }\n    if !info.is_dir {\n        return sys.remove_file(path)\n    }\n    listing := list_dir(path)\n    if !listing.ok { return sys.Status { ok: false, error: listing.error } }\n    var prefix := path\n    if prefix[prefix.len - 1] != 47 { prefix += \"/\" }\n    for item in listing.entries {\n        st := remove_all(prefix + item)\n        if !st.ok { return st }\n    }\n    sys.remove_dir(path)\n}\n" }
    if name == "hash" { return "// Stable byte hash; independent of locale and Unicode normalization.\n@test {\n    (\"\") -> 0\n    (\"a\") -> 97\n    hash(\"å\") != hash(\"a\")\n    hash(\"🌍\") == hash(\"🌍\")\n}\npub fn hash(text: string) -> i64 {\n    var value: i64 = 0\n    for byte in text.bytes() {\n        value = (value * 131 + i64(byte)) % 2147483647\n    }\n    value\n}\n" }
    if name == "json" { return "// Zero-DOM streaming JSON writer and flat span-tape RFC 8259 parser.\n// Parsing records compact parallel arrays of byte spans into the input buffer\n// with zero hashmap allocations and zero string unescaping until a field is read.\nimport std.bytes as bytes\nimport std.parse as parse\nimport sys\n\npub enum Kind {\n    Invalid = 0,\n    Null = 1,\n    Bool = 2,\n    Number = 3,\n    String = 4,\n    Array = 5,\n    Object = 6,\n}\n\npub struct Doc {\n    ok: bool,\n    error: string,\n    offset: i32,\n    root: i32,\n    input: []u8,\n    kinds: []u8,\n    starts: []i32,    // byte start in input (for String: after opening quote)\n    ends: []i32,      // byte end in input (for String: before closing quote)\n    escaped: []bool,  // true only when a String span contains '\\'\n    first_child: []i32,\n    next_sibling: []i32,\n    key_starts: []i32,\n    key_ends: []i32,\n    key_escaped: []bool,\n    counts: []i32,\n}\n\npub struct BoolField { ok: bool, value: bool }\npub struct IntField { ok: bool, value: i64 }\npub struct UintField { ok: bool, value: u64 }\npub struct StrField { ok: bool, value: string }\n\n// --- Direct-to-buffer JSON Writer (zero intermediate string concatenations) ---\n\npub fn write_str(out: &mut []u8, value: string) {\n    hex := \"0123456789abcdef\"\n    out.reserve(out.len + value.len + 2)\n    out.push(b'\"')\n    for b in value.bytes() {\n        if b == 34 { out.push(b'\\\\'); out.push(b'\"') }\n        else if b == 92 { out.push(b'\\\\'); out.push(b'\\\\') }\n        else if b == 8 { out.push(b'\\\\'); out.push(b'b') }\n        else if b == 12 { out.push(b'\\\\'); out.push(b'f') }\n        else if b == 10 { out.push(b'\\\\'); out.push(b'n') }\n        else if b == 13 { out.push(b'\\\\'); out.push(b'r') }\n        else if b == 9 { out.push(b'\\\\'); out.push(b't') }\n        else if b < 32 {\n            bytes.append_utf8(&mut out, \"\\\\u00\")\n            out.push(u8(hex[b / 16]))\n            out.push(u8(hex[b % 16]))\n        } else {\n            out.push(u8(b))\n        }\n    }\n    out.push(b'\"')\n}\n\npub fn quote(value: string) -> string {\n    var out: []u8 = []\n    write_str(&mut out, value)\n    bytes.decode(&out).value\n}\n\npub fn write_i64(out: &mut []u8, value: i64) { bytes.append_decimal(&mut out, value) }\n\npub fn write_u64(out: &mut []u8, value: u64) {\n    if value == 0 { out.push(b'0'); return }\n    start := out.len\n    var v := value\n    while v > 0 {\n        d := i32(v % 10)\n        out.push(u8(48 + d))\n        v /= 10\n    }\n    var left := start\n    var right := out.len - 1\n    while left < right {\n        tmp := out[left]; out[left] = out[right]; out[right] = tmp\n        left += 1; right -= 1\n    }\n}\n\npub fn write_bool(out: &mut []u8, value: bool) {\n    if value { bytes.append_utf8(&mut out, \"true\") }\n    else { bytes.append_utf8(&mut out, \"false\") }\n}\n\npub fn write_null(out: &mut []u8) { bytes.append_utf8(&mut out, \"null\") }\n\nfn sep_key(out: &mut []u8, first: &mut bool, key: string) {\n    if !first { out.push(b',') }\n    first = false\n    write_str(&mut out, key)\n    out.push(b':')\n}\n\npub fn sep_elem(out: &mut []u8, first: &mut bool) {\n    if !first { out.push(b',') }\n    first = false\n}\n\npub fn begin_obj(out: &mut []u8) -> bool { out.push(b'{'); true }\npub fn end_obj(out: &mut []u8) { out.push(b'}') }\npub fn begin_arr(out: &mut []u8) -> bool { out.push(b'['); true }\npub fn end_arr(out: &mut []u8) { out.push(b']') }\n\npub fn field_str(out: &mut []u8, first: &mut bool, key: string, value: string) {\n    sep_key(&mut out, &mut first, key); write_str(&mut out, value)\n}\npub fn field_i64(out: &mut []u8, first: &mut bool, key: string, value: i64) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, value)\n}\npub fn field_i32(out: &mut []u8, first: &mut bool, key: string, value: i32) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, i64(value))\n}\npub fn field_u64(out: &mut []u8, first: &mut bool, key: string, value: u64) {\n    sep_key(&mut out, &mut first, key); write_u64(&mut out, value)\n}\npub fn field_bool(out: &mut []u8, first: &mut bool, key: string, value: bool) {\n    sep_key(&mut out, &mut first, key); write_bool(&mut out, value)\n}\npub fn field_null(out: &mut []u8, first: &mut bool, key: string) {\n    sep_key(&mut out, &mut first, key); write_null(&mut out)\n}\npub fn begin_field_obj(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_obj(&mut out)\n}\npub fn begin_field_arr(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_arr(&mut out)\n}\n\npub fn finish_text(out: &[]u8) -> string { bytes.decode(&out).value }\n\n// --- Flat Span-Tape Parser ---\n\nstruct Parser {\n    pos: i32,\n    depth: i32,\n}\n\nfn is_ws(b: u8) -> bool {\n    b == b' ' || b == b'\\t' || b == b'\\n' || b == b'\\r'\n}\n\nfn skip_ws(input: &[]u8, p: &mut Parser) {\n    while p.pos < input.len && is_ws(input[p.pos]) {\n        p.pos += 1\n    }\n}\n\nfn fail_doc(doc: &mut Doc, at: i32, msg: string) {\n    if doc.ok {\n        doc.ok = false\n        doc.offset = at\n        doc.error = msg\n    }\n}\n\nfn hex_val(b: u8) -> i32 {\n    if b >= b'0' && b <= b'9' { return i32(b - b'0') }\n    if b >= b'a' && b <= b'f' { return i32(b - b'a') + 10 }\n    if b >= b'A' && b <= b'F' { return i32(b - b'A') + 10 }\n    -1\n}\n\nfn alloc_node(doc: &mut Doc, kind: u8, start: i32, end: i32, esc: bool) -> i32 {\n    id := doc.kinds.len\n    doc.kinds.push(kind)\n    doc.starts.push(start)\n    doc.ends.push(end)\n    doc.escaped.push(esc)\n    doc.first_child.push(-1)\n    doc.next_sibling.push(-1)\n    doc.key_starts.push(0)\n    doc.key_ends.push(0)\n    doc.key_escaped.push(false)\n    doc.counts.push(0)\n    id\n}\n\nstruct StrSpan { ok: bool, start: i32, end: i32, escaped: bool }\n\nfn scan_string(doc: &mut Doc, p: &mut Parser) -> StrSpan {\n    if p.pos >= doc.input.len || doc.input[p.pos] != b'\"' {\n        fail_doc(&mut doc, p.pos, \"expected '\\\"'\")\n        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n    }\n    p.pos += 1\n    start := p.pos\n    var has_esc := false\n    while p.pos < doc.input.len {\n        b := doc.input[p.pos]\n        if b == b'\"' {\n            end := p.pos\n            p.pos += 1\n            return StrSpan { ok: true, start: start, end: end, escaped: has_esc }\n        }\n        if b < 32 {\n            fail_doc(&mut doc, p.pos, \"unescaped control character in JSON string\")\n            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n        }\n        if b == b'\\\\' {\n            has_esc = true\n            p.pos += 1\n            if p.pos >= doc.input.len {\n                fail_doc(&mut doc, p.pos, \"unterminated escape sequence\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n            esc := doc.input[p.pos]\n            if esc == b'\"' || esc == b'\\\\' || esc == b'/' || esc == b'b' ||\n               esc == b'f' || esc == b'n' || esc == b'r' || esc == b't' {\n                p.pos += 1\n            } else if esc == b'u' {\n                if p.pos + 4 >= doc.input.len {\n                    fail_doc(&mut doc, p.pos, \"incomplete \\\\uXXXX escape\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n                var cp := 0\n                for k in 1..5 {\n                    hv := hex_val(doc.input[p.pos + k])\n                    if hv < 0 {\n                        fail_doc(&mut doc, p.pos + k, \"invalid hex digit in \\\\uXXXX escape\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    cp = cp * 16 + hv\n                }\n                p.pos += 5\n                if cp >= 0xD800 && cp <= 0xDBFF {\n                    if p.pos + 5 >= doc.input.len || doc.input[p.pos] != b'\\\\' || doc.input[p.pos + 1] != b'u' {\n                        fail_doc(&mut doc, p.pos, \"missing low surrogate in UTF-16 pair\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    var low := 0\n                    for k in 2..6 {\n                        hv := hex_val(doc.input[p.pos + k])\n                        if hv < 0 {\n                            fail_doc(&mut doc, p.pos + k, \"invalid hex digit in low surrogate\")\n                            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                        }\n                        low = low * 16 + hv\n                    }\n                    if low < 0xDC00 || low > 0xDFFF {\n                        fail_doc(&mut doc, p.pos, \"invalid low surrogate range\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    p.pos += 6\n                } else if cp >= 0xDC00 && cp <= 0xDFFF {\n                    fail_doc(&mut doc, p.pos - 5, \"lone low surrogate\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n            } else {\n                fail_doc(&mut doc, p.pos, \"invalid escape character\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n        } else {\n            p.pos += 1\n        }\n    }\n    fail_doc(&mut doc, p.pos, \"unterminated JSON string\")\n    StrSpan { ok: false, start: 0, end: 0, escaped: false }\n}\n\nfn scan_number(doc: &mut Doc, p: &mut Parser) -> i32 {\n    start := p.pos\n    if p.pos < doc.input.len && doc.input[p.pos] == b'-' { p.pos += 1 }\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, start, \"invalid number\")\n        return -1\n    }\n    if doc.input[p.pos] == b'0' {\n        p.pos += 1\n        if p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            fail_doc(&mut doc, p.pos, \"leading zero in JSON number\")\n            return -1\n        }\n    } else if doc.input[p.pos] >= b'1' && doc.input[p.pos] <= b'9' {\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    } else {\n        fail_doc(&mut doc, p.pos, \"expected digit in JSON number\")\n        return -1\n    }\n    if p.pos < doc.input.len && doc.input[p.pos] == b'.' {\n        p.pos += 1\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected digit after decimal point\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    if p.pos < doc.input.len && (doc.input[p.pos] == b'e' || doc.input[p.pos] == b'E') {\n        p.pos += 1\n        if p.pos < doc.input.len && (doc.input[p.pos] == b'+' || doc.input[p.pos] == b'-') {\n            p.pos += 1\n        }\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected exponent digit\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    alloc_node(&mut doc, 3, start, p.pos, false)\n}\n\nfn scan_value(doc: &mut Doc, p: &mut Parser) -> i32 {\n    skip_ws(&doc.input, &mut p)\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, p.pos, \"unexpected end of JSON input\")\n        return -1\n    }\n    if p.depth >= 256 {\n        fail_doc(&mut doc, p.pos, \"JSON nesting depth exceeds 256\")\n        return -1\n    }\n    b := doc.input[p.pos]\n    if b == b'\"' {\n        sp := scan_string(&mut doc, &mut p)\n        if !sp.ok { return -1 }\n        if !sp.escaped {\n            // Validate UTF-8 once over raw slice.\n            if !bytes.decode_range(&doc.input, sp.start, sp.end).ok {\n                fail_doc(&mut doc, sp.start, \"invalid UTF-8 in JSON string\")\n                return -1\n            }\n        }\n        return alloc_node(&mut doc, 4, sp.start, sp.end, sp.escaped)\n    }\n    if b == b'{' {\n        start := p.pos\n        p.pos += 1\n        obj := alloc_node(&mut doc, 6, start, start, false)\n        skip_ws(&doc.input, &mut p)\n        if p.pos < doc.input.len && doc.input[p.pos] == b'}' {\n            p.pos += 1\n            doc.ends[obj] = p.pos\n            return obj\n        }\n        p.depth += 1\n        var prev_child := -1\n        var count := 0\n        while doc.ok {\n            skip_ws(&doc.input, &mut p)\n            key := scan_string(&mut doc, &mut p)\n            if !key.ok { p.depth -= 1; return -1 }\n            if !key.escaped && !bytes.decode_range(&doc.input, key.start, key.end).ok {\n                fail_doc(&mut doc, key.start, \"invalid UTF-8 in JSON key\")\n                p.depth -= 1; return -1\n            }\n            skip_ws(&doc.input, &mut p)\n            if p.pos >= doc.input.len || doc.input[p.pos] != b':' {\n                fail_doc(&mut doc, p.pos, \"expected ':' after object key\")\n                p.depth -= 1; return -1\n            }\n            p.pos += 1\n            child := scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { p.depth -= 1; return -1 }\n            doc.key_starts[child] = key.start\n            doc.key_ends[child] = key.end\n            doc.key_escaped[child] = key.escaped\n            if prev_child < 0 { doc.first_child[obj] = child }\n            else { doc.next_sibling[prev_child] = child }\n            prev_child = child\n            count += 1\n            skip_ws(&doc.input, &mut p)\n            if p.pos < doc.input.len && doc.input[p.pos] == b',' {\n                p.pos += 1\n                continue\n            }\n            if p.pos < doc.input.len && doc.input[p.pos] == b'}' {\n                p.pos += 1\n                doc.ends[obj] = p.pos\n                doc.counts[obj] = count\n                p.depth -= 1\n                return obj\n            }\n            fail_doc(&mut doc, p.pos, \"expected ',' or '}' in JSON object\")\n            p.depth -= 1\n            return -1\n        }\n        p.depth -= 1\n        return -1\n    }\n    if b == b'[' {\n        start := p.pos\n        p.pos += 1\n        arr := alloc_node(&mut doc, 5, start, start, false)\n        skip_ws(&doc.input, &mut p)\n        if p.pos < doc.input.len && doc.input[p.pos] == b']' {\n            p.pos += 1\n            doc.ends[arr] = p.pos\n            return arr\n        }\n        p.depth += 1\n        var prev_child := -1\n        var count := 0\n        while doc.ok {\n            child := scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { p.depth -= 1; return -1 }\n            if prev_child < 0 { doc.first_child[arr] = child }\n            else { doc.next_sibling[prev_child] = child }\n            prev_child = child\n            count += 1\n            skip_ws(&doc.input, &mut p)\n            if p.pos < doc.input.len && doc.input[p.pos] == b',' {\n                p.pos += 1\n                continue\n            }\n            if p.pos < doc.input.len && doc.input[p.pos] == b']' {\n                p.pos += 1\n                doc.ends[arr] = p.pos\n                doc.counts[arr] = count\n                p.depth -= 1\n                return arr\n            }\n            fail_doc(&mut doc, p.pos, \"expected ',' or ']' in JSON array\")\n            p.depth -= 1\n            return -1\n        }\n        p.depth -= 1\n        return -1\n    }\n    if b == b't' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"true\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'f' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 5, \"false\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 5, false)\n            p.pos += 5\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'n' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"null\") {\n            node := alloc_node(&mut doc, 1, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'-' || (b >= b'0' && b <= b'9') {\n        return scan_number(&mut doc, &mut p)\n    }\n    fail_doc(&mut doc, p.pos, \"unexpected character in JSON\")\n    -1\n}\n\npub fn parse_bytes(input: &[]u8) -> Doc {\n    var copy: []u8 = []\n    bytes.extend(&mut copy, &input)\n    var doc := Doc {\n        ok: true, error: \"\", offset: 0, root: -1,\n        input: copy, kinds: [], starts: [], ends: [], escaped: [],\n        first_child: [], next_sibling: [], key_starts: [], key_ends: [], key_escaped: [], counts: [],\n    }\n    est := input.len / 8 + 8\n    doc.kinds.reserve(est); doc.starts.reserve(est); doc.ends.reserve(est)\n    var p := Parser { pos: 0, depth: 0 }\n    root := scan_value(&mut doc, &mut p)\n    if !doc.ok { return doc }\n    skip_ws(&doc.input, &mut p)\n    if p.pos != doc.input.len {\n        fail_doc(&mut doc, p.pos, \"trailing characters after JSON value\")\n        return doc\n    }\n    doc.root = root\n    doc\n}\n\npub fn parse_text(text: string) -> Doc {\n    var raw: []u8 = []\n    bytes.append_utf8(&mut raw, text)\n    parse_bytes(&raw)\n}\n\n// --- Zero-Allocation Span Queries & Lazy Unescaping ---\n\npub fn kind(doc: &Doc, node: i32) -> Kind {\n    if !doc.ok || node < 0 || node >= doc.kinds.len { return .Invalid }\n    k := doc.kinds[node]\n    if k == 1 { return .Null }\n    if k == 2 { return .Bool }\n    if k == 3 { return .Number }\n    if k == 4 { return .String }\n    if k == 5 { return .Array }\n    if k == 6 { return .Object }\n    .Invalid\n}\n\npub fn count(doc: &Doc, node: i32) -> i32 {\n    if !doc.ok || node < 0 || node >= doc.counts.len { return 0 }\n    doc.counts[node]\n}\n\nfn push_codepoint_utf8(out: &mut []u8, cp: i32) {\n    if cp <= 0x7F {\n        out.push(u8(cp))\n    } else if cp <= 0x7FF {\n        out.push(u8(0xC0.bit_or(cp.shr(6))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else if cp <= 0xFFFF {\n        out.push(u8(0xE0.bit_or(cp.shr(12))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else {\n        out.push(u8(0xF0.bit_or(cp.shr(18))))\n        out.push(u8(0x80.bit_or(cp.shr(12).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    }\n}\n\nfn unescape_span(input: &[]u8, start: i32, end: i32, has_esc: bool) -> StrField {\n    if !has_esc {\n        dec := bytes.decode_range(&input, start, end)\n        return StrField { ok: dec.ok, value: dec.value }\n    }\n    var out: []u8 = []\n    out.reserve(end - start)\n    var i := start\n    while i < end {\n        b := input[i]\n        if b != b'\\\\' {\n            out.push(b)\n            i += 1\n            continue\n        }\n        i += 1\n        esc := input[i]\n        if esc == b'\"' { out.push(b'\"'); i += 1 }\n        else if esc == b'\\\\' { out.push(b'\\\\'); i += 1 }\n        else if esc == b'/' { out.push(b'/'); i += 1 }\n        else if esc == b'b' { out.push(8); i += 1 }\n        else if esc == b'f' { out.push(12); i += 1 }\n        else if esc == b'n' { out.push(10); i += 1 }\n        else if esc == b'r' { out.push(13); i += 1 }\n        else if esc == b't' { out.push(9); i += 1 }\n        else if esc == b'u' {\n            var cp := 0\n            for k in 1..5 { cp = cp * 16 + hex_val(input[i + k]) }\n            i += 5\n            if cp >= 0xD800 && cp <= 0xDBFF {\n                var low := 0\n                for k in 2..6 { low = low * 16 + hex_val(input[i + k]) }\n                i += 6\n                cp = 0x10000 + (cp - 0xD800).shl(10) + (low - 0xDC00)\n            }\n            push_codepoint_utf8(&mut out, cp)\n        } else {\n            return StrField { ok: false, value: \"\" }\n        }\n    }\n    dec := bytes.decode(&out)\n    StrField { ok: dec.ok, value: dec.value }\n}\n\nfn key_matches(doc: &Doc, child: i32, key: string) -> bool {\n    ks := doc.key_starts[child]\n    ke := doc.key_ends[child]\n    if !doc.key_escaped[child] {\n        return bytes.equals_text(&doc.input, ks, ke, key)\n    }\n    unesc := unescape_span(&doc.input, ks, ke, true)\n    unesc.ok && unesc.value == key\n}\n\npub fn field(doc: &Doc, obj: i32, key: string) -> i32 {\n    if kind(&doc, obj) != .Object { return -1 }\n    var found := -1\n    var cur := doc.first_child[obj]\n    while cur >= 0 {\n        if key_matches(&doc, cur, key) { found = cur }\n        cur = doc.next_sibling[cur]\n    }\n    found\n}\n\npub fn at(doc: &Doc, arr: i32, index: i32) -> i32 {\n    if kind(&doc, arr) != .Array || index < 0 || index >= doc.counts[arr] { return -1 }\n    var cur := doc.first_child[arr]\n    for _ in 0..index { cur = doc.next_sibling[cur] }\n    cur\n}\n\npub fn key_at(doc: &Doc, obj: i32, index: i32) -> StrField {\n    if kind(&doc, obj) != .Object || index < 0 || index >= doc.counts[obj] {\n        return StrField { ok: false, value: \"\" }\n    }\n    var cur := doc.first_child[obj]\n    for _ in 0..index { cur = doc.next_sibling[cur] }\n    unescape_span(&doc.input, doc.key_starts[cur], doc.key_ends[cur], doc.key_escaped[cur])\n}\n\npub fn val_at(doc: &Doc, obj: i32, index: i32) -> i32 {\n    if kind(&doc, obj) != .Object || index < 0 || index >= doc.counts[obj] { return -1 }\n    var cur := doc.first_child[obj]\n    for _ in 0..index { cur = doc.next_sibling[cur] }\n    cur\n}\n\npub fn as_bool(doc: &Doc, node: i32) -> BoolField {\n    if kind(&doc, node) != .Bool { return BoolField { ok: false, value: false } }\n    BoolField { ok: true, value: doc.input[doc.starts[node]] == b't' }\n}\n\npub fn as_i64(doc: &Doc, node: i32) -> IntField {\n    if kind(&doc, node) != .Number { return IntField { ok: false, value: 0 } }\n    parsed := parse.i64_range(bytes.decode_range(&doc.input, doc.starts[node], doc.ends[node]).value, 0, doc.ends[node] - doc.starts[node])\n    IntField { ok: parsed.ok, value: parsed.value }\n}\n\npub fn as_u64(doc: &Doc, node: i32) -> UintField {\n    if kind(&doc, node) != .Number { return UintField { ok: false, value: 0 } }\n    s := doc.starts[node]; e := doc.ends[node]\n    if s < e && doc.input[s] == b'-' { return UintField { ok: false, value: 0 } }\n    parsed := parse.u64_range(bytes.decode_range(&doc.input, s, e).value, 0, e - s)\n    UintField { ok: parsed.ok, value: parsed.value }\n}\n\npub fn as_str(doc: &Doc, node: i32) -> StrField {\n    if kind(&doc, node) != .String { return StrField { ok: false, value: \"\" } }\n    unescape_span(&doc.input, doc.starts[node], doc.ends[node], doc.escaped[node])\n}\n\npub fn raw_span(doc: &Doc, node: i32) -> string {\n    if !doc.ok || node < 0 || node >= doc.starts.len { return \"\" }\n    bytes.decode_range(&doc.input, doc.starts[node], doc.ends[node]).value\n}\n\npub fn get_bool(doc: &Doc, obj: i32, key: string) -> BoolField { as_bool(&doc, field(&doc, obj, key)) }\npub fn get_i64(doc: &Doc, obj: i32, key: string) -> IntField { as_i64(&doc, field(&doc, obj, key)) }\npub fn get_u64(doc: &Doc, obj: i32, key: string) -> UintField { as_u64(&doc, field(&doc, obj, key)) }\npub fn get_str(doc: &Doc, obj: i32, key: string) -> StrField { as_str(&doc, field(&doc, obj, key)) }\n\n@test\nfn json_writer_and_zero_dom_parser_handle_nesting_unicode_and_errors() {\n    var out: []u8 = []\n    var first := begin_obj(&mut out)\n    field_str(&mut out, &mut first, \"kind\", \"runtime_profile\")\n    field_i32(&mut out, &mut first, \"version\", 1)\n    field_bool(&mut out, &mut first, \"ok\", true)\n    field_u64(&mut out, &mut first, \"max_u64\", 18446744073709551615)\n    field_str(&mut out, &mut first, \"msg\", \"rad1\\n\\\"åäö\\\" 🌍\")\n    var af := begin_field_arr(&mut out, &mut first, \"items\")\n    sep_elem(&mut out, &mut af); write_i64(&mut out, -42)\n    sep_elem(&mut out, &mut af); write_null(&mut out)\n    end_arr(&mut out)\n    end_obj(&mut out)\n\n    doc := parse_bytes(&out)\n    assert(doc.ok)\n    assert(get_str(&doc, doc.root, \"kind\").value == \"runtime_profile\")\n    assert(get_i64(&doc, doc.root, \"version\").value == 1)\n    assert(get_bool(&doc, doc.root, \"ok\").value)\n    assert(get_u64(&doc, doc.root, \"max_u64\").value == 18446744073709551615)\n    assert(get_str(&doc, doc.root, \"msg\").value == \"rad1\\n\\\"åäö\\\" 🌍\")\n    items := field(&doc, doc.root, \"items\")\n    assert(count(&doc, items) == 2)\n    assert(as_i64(&doc, at(&doc, items, 0)).value == -42)\n    assert(kind(&doc, at(&doc, items, 1)) == .Null)\n\n    // Surrogate pair decoding (\\uD83C\\uDF0D == 🌍) and duplicate key override (last wins).\n    sur := parse_text(\"{\\\"a\\\":1,\\\"a\\\":2,\\\"globe\\\":\\\"\\\\uD83C\\\\uDF0D\\\"}\")\n    assert(sur.ok)\n    assert(get_i64(&sur, sur.root, \"a\").value == 2)\n    assert(get_str(&sur, sur.root, \"globe\").value == \"🌍\")\n\n    assert(!parse_text(\"{\\\"a\\\":01}\").ok)\n    assert(!parse_text(\"{\\\"a\\\":1} trailing\").ok)\n    assert(!parse_text(\"\\\"\\\\uD800\\\"\").ok)\n}\n" }
    if name == "map" { return "import std.hash as hashing\n\npub struct Map {\n    keys: []string,\n    values: []i64,\n    slots: []i32,\n    length: i32,\n    used: i32,\n}\npub enum Lookup { Missing, Found(i64) }\n\npub fn new() -> Map { Map { keys: [], values: [], slots: [], length: 0, used: 0 } }\npub fn length(table: &Map) -> i32 { table.length }\n\nfn locate(table: &Map, key: string) -> i32 {\n    capacity := table.slots.len\n    if capacity == 0 { return -1 }\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    for step in 0..capacity {\n        state := table.slots[slot]\n        if state == 0 { return -1 }\n        if state == 1 && table.keys[slot] == key { return slot }\n        slot = (slot + 1) % capacity\n    }\n    -1\n}\npub fn contains(table: &Map, key: string) -> bool { locate(&table, key) >= 0 }\npub fn get(table: &Map, key: string) -> Lookup {\n    slot := locate(&table, key)\n    if slot < 0 { .Missing } else { .Found(table.values[slot]) }\n}\npub fn get_or(table: &Map, key: string, fallback: i64) -> i64 {\n    slot := locate(&table, key)\n    if slot < 0 { fallback } else { table.values[slot] }\n}\nfn insert_slot(table: &mut Map, key: string, value: i64) {\n    capacity := table.slots.len\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    while table.slots[slot] == 1 { slot = (slot + 1) % capacity }\n    if table.slots[slot] == 0 { table.used = table.used + 1 }\n    table.slots[slot] = 1\n    table.keys[slot] = key\n    table.values[slot] = value\n    table.length = table.length + 1\n}\nfn rehash(table: &mut Map, capacity: i32) {\n    var fresh := new()\n    fresh.keys.reserve(capacity)\n    fresh.values.reserve(capacity)\n    fresh.slots.reserve(capacity)\n    for i in 0..capacity { fresh.keys.push(\"\"); fresh.values.push(0); fresh.slots.push(0) }\n    for i in 0..table.slots.len {\n        if table.slots[i] == 1 { insert_slot(&mut fresh, table.keys[i], table.values[i]) }\n    }\n    table = fresh\n}\npub fn reserve(table: &mut Map, entries: i32) {\n    assert(entries >= 0)\n    var capacity := 8\n    while i64(capacity) * 7 < i64(entries) * 10 { capacity = capacity * 2 }\n    if capacity > table.slots.len { rehash(&mut table, capacity) }\n}\npub fn put(table: &mut Map, key: string, value: i64) {\n    existing := locate(&table, key)\n    if existing >= 0 { table.values[existing] = value; return }\n    capacity := table.slots.len\n    if capacity == 0 { rehash(&mut table, 8) }\n    else if (table.used + 1) * 10 >= capacity * 7 {\n        if (table.length + 1) * 10 < capacity * 4 { rehash(&mut table, capacity) }\n        else { rehash(&mut table, capacity * 2) }\n    }\n    insert_slot(&mut table, key, value)\n}\npub fn remove(table: &mut Map, key: string) -> bool {\n    slot := locate(&table, key)\n    if slot < 0 { return false }\n    table.slots[slot] = 2\n    table.keys[slot] = \"\"\n    table.values[slot] = 0\n    table.length = table.length - 1\n    true\n}\npub fn clear(table: &mut Map) {\n    for i in 0..table.slots.len { table.slots[i] = 0; table.keys[i] = \"\"; table.values[i] = 0 }\n    table.length = 0\n    table.used = 0\n}\npub fn keys(table: &Map) -> []string {\n    var result: []string = []\n    result.reserve(table.length)\n    for i in 0..table.slots.len { if table.slots[i] == 1 { result.push(table.keys[i]) } }\n    result\n}\n\n@test fn map_handles_growth_collisions_updates_removal_and_copies() {\n    var collisions := new()\n    put(&mut collisions, \"a\", 1); put(&mut collisions, \"i\", 2); put(&mut collisions, \"q\", 3); put(&mut collisions, \"y\", 4)\n    remove(&mut collisions, \"a\")\n    put(&mut collisions, \"q\", 99)\n    length(&collisions) == 3\n    get_or(&collisions, \"q\", 0) == 99\n    get_or(&collisions, \"y\", 0) == 4\n    put(&mut collisions, \"\", -1); put(&mut collisions, \"\\0\", -2)\n    get_or(&collisions, \"\", 0) == -1\n    get_or(&collisions, \"\\0\", 0) == -2\n    var table := new()\n    put(&mut table, \"\", -1)\n    put(&mut table, \"å 🌍\", 42)\n    for i in 0..1000 { put(&mut table, i.str(), i64(i) * 3) }\n    length(&table) == 1002\n    for i in 0..1000 { get_or(&table, i.str(), -1) == i64(i) * 3 }\n    snapshot := table\n    put(&mut table, \"å 🌍\", 99)\n    get_or(&snapshot, \"å 🌍\", 0) == 42\n    for i in 0..1000 { remove(&mut table, i.str()) }\n    length(&table) == 2\n    !remove(&mut table, \"missing\")\n    for i in 0..1000 { put(&mut table, i.str(), i64(i)) }\n    keys(&table).len == 1002\n    match get(&table, \"å 🌍\") { .Found(value) => { value == 99 }, .Missing => { assert(false) } }\n    clear(&mut table)\n    length(&table) == 0\n    !contains(&table, \"\")\n    put(&mut table, \"again\", 7)\n    get_or(&table, \"again\", 0) == 7\n}\n" }
    if name == "net" { return "capability network\nimport sys\n\npub fn poll_in() -> i32 { 1 }\npub fn poll_out() -> i32 { 4 }\npub fn poll_err() -> i32 { 8 }\npub fn poll_hup() -> i32 { 16 }\npub fn poll_nval() -> i32 { 32 }\npub fn err_would_block() -> i32 { 35 }\n\npub fn ipv4(a: i32, b: i32, c: i32, d: i32) -> i64 {\n    assert(a >= 0 && a <= 255 && b >= 0 && b <= 255 && c >= 0 && c <= 255 && d >= 0 && d <= 255)\n    (i64(a).shl(24)).bit_or(i64(b).shl(16)).bit_or(i64(c).shl(8)).bit_or(i64(d))\n}\npub fn loopback() -> i64 { ipv4(127, 0, 0, 1) }\npub fn any_addr() -> i64 { 0 }\n\npub opaque struct TcpListener { fd: i32 }\npub opaque struct TcpStream { fd: i32 }\npub opaque struct StreamSet { fds: []i32 }\n\npub struct ListenResult { ok: bool, listener: TcpListener, error: i32 }\npub struct AcceptResult { ok: bool, would_block: bool, stream: TcpStream, error: i32 }\npub struct ConnectResult { ok: bool, stream: TcpStream, error: i32 }\npub struct IoResult { ok: bool, would_block: bool, eof: bool, count: i64, error: i32 }\npub struct PollSet {\n    fds: []i32,\n    events: []i32,\n    revents: []i32,\n    scratch: []u8,\n}\n\nfn status_from_i64(raw: i64) -> sys.Status {\n    if raw < 0 { return sys.Status { ok: false, error: i32(-raw) } }\n    sys.Status { ok: true, error: 0 }\n}\n\n@requires(network)\npub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult {\n    raw := sys.net_listen(addr, i64(port), i64(backlog))\n    if raw < 0 {\n        return ListenResult { ok: false, listener: TcpListener { fd: -1 }, error: i32(-raw) }\n    }\n    ListenResult { ok: true, listener: TcpListener { fd: i32(raw) }, error: 0 }\n}\n\n@requires(network)\npub fn connect(addr: i64, port: i32) -> ConnectResult {\n    raw := sys.net_connect(addr, i64(port))\n    if raw < 0 {\n        return ConnectResult { ok: false, stream: TcpStream { fd: -1 }, error: i32(-raw) }\n    }\n    ConnectResult { ok: true, stream: TcpStream { fd: i32(raw) }, error: 0 }\n}\n\npub fn listener_fd(l: &TcpListener) -> i32 { l.fd }\npub fn stream_fd(s: &TcpStream) -> i32 { s.fd }\n\npub fn local_port(l: &TcpListener) -> i32 {\n    raw := sys.net_local_port(l.fd)\n    if raw < 0 { return -1 }\n    i32(raw)\n}\n\npub fn set_listener_nonblocking(l: &TcpListener, enabled: bool) -> sys.Status {\n    status_from_i64(sys.net_set_nonblocking(l.fd, enabled))\n}\n\npub fn accept(l: &TcpListener) -> AcceptResult {\n    raw := sys.net_accept(l.fd)\n    if raw < 0 {\n        err := i32(-raw)\n        return AcceptResult { ok: false, would_block: err == 35, stream: TcpStream { fd: -1 }, error: err }\n    }\n    AcceptResult { ok: true, would_block: false, stream: TcpStream { fd: i32(raw) }, error: 0 }\n}\n\npub fn close_listener(l: &mut TcpListener) -> sys.Status {\n    if l.fd < 0 { return sys.Status { ok: true, error: 0 } }\n    st := status_from_i64(sys.net_close(l.fd))\n    l.fd = -1\n    st\n}\n\npub fn set_nonblocking(s: &TcpStream, enabled: bool) -> sys.Status {\n    status_from_i64(sys.net_set_nonblocking(s.fd, enabled))\n}\n\npub fn set_nodelay(s: &TcpStream, enabled: bool) -> sys.Status {\n    status_from_i64(sys.net_set_nodelay(s.fd, enabled))\n}\n\nfn fd_read_append(fd: i32, out: &mut []u8, max_bytes: i32) -> IoResult {\n    if max_bytes <= 0 {\n        return IoResult { ok: true, would_block: false, eof: false, count: 0, error: 0 }\n    }\n    out.reserve(out.len + max_bytes)\n    n := sys.net_read(fd, &mut out, i64(max_bytes))\n    if n < 0 {\n        err := i32(-n)\n        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n    }\n    IoResult { ok: true, would_block: false, eof: n == 0, count: n, error: 0 }\n}\n\nfn fd_write_range(fd: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {\n    n := sys.net_write(fd, &data, i64(offset), i64(length))\n    if n < 0 {\n        err := i32(-n)\n        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n    }\n    IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }\n}\n\npub fn read_append(s: &TcpStream, out: &mut []u8, max_bytes: i32) -> IoResult {\n    fd_read_append(s.fd, &mut out, max_bytes)\n}\n\npub fn write_range(s: &TcpStream, data: &[]u8, offset: i32, length: i32) -> IoResult {\n    fd_write_range(s.fd, &data, offset, length)\n}\n\npub fn write_all(s: &TcpStream, data: &[]u8) -> sys.Status {\n    var off := 0\n    while off < data.len {\n        n := sys.net_write(s.fd, &data, i64(off), i64(data.len - off))\n        if n < 0 { return sys.Status { ok: false, error: i32(-n) } }\n        if n == 0 { return sys.Status { ok: false, error: 5 } }\n        off += i32(n)\n    }\n    sys.Status { ok: true, error: 0 }\n}\n\npub fn shutdown_write(s: &TcpStream) -> sys.Status {\n    status_from_i64(sys.net_shutdown_write(s.fd))\n}\n\npub fn close(s: &mut TcpStream) -> sys.Status {\n    if s.fd < 0 { return sys.Status { ok: true, error: 0 } }\n    st := status_from_i64(sys.net_close(s.fd))\n    s.fd = -1\n    st\n}\n\npub fn poll_set() -> PollSet {\n    PollSet { fds: [], events: [], revents: [], scratch: [] }\n}\n\npub fn poll_clear(ps: &mut PollSet) {\n    ps.fds.clear()\n    ps.events.clear()\n    ps.revents.clear()\n}\n\npub fn poll_add(ps: &mut PollSet, fd: i32, events: i32) {\n    ps.fds.push(fd)\n    ps.events.push(events)\n    ps.revents.push(0)\n}\n\npub fn poll(ps: &mut PollSet, timeout_ms: i32) -> IoResult {\n    count := ps.fds.len\n    assert(ps.events.len == count && ps.revents.len == count)\n    need := count * 8\n    if ps.scratch.len < need {\n        ps.scratch.reserve(need)\n        while ps.scratch.len < need { ps.scratch.push(0) }\n    }\n    for i in 0..count {\n        base := i * 8\n        u := i64(ps.fds[i]).bit_and(0xffffffff)\n        ps.scratch[base] = u8(u.bit_and(0xff))\n        ps.scratch[base + 1] = u8(u.shr(8).bit_and(0xff))\n        ps.scratch[base + 2] = u8(u.shr(16).bit_and(0xff))\n        ps.scratch[base + 3] = u8(u.shr(24).bit_and(0xff))\n        ev := i64(ps.events[i]).bit_and(0xffff)\n        ps.scratch[base + 4] = u8(ev.bit_and(0xff))\n        ps.scratch[base + 5] = u8(ev.shr(8).bit_and(0xff))\n        ps.scratch[base + 6] = 0\n        ps.scratch[base + 7] = 0\n    }\n    n := sys.net_poll(&mut ps.scratch, i64(count), i64(timeout_ms))\n    if n < 0 {\n        err := i32(-n)\n        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n    }\n    for i in 0..count {\n        base := i * 8\n        lo := i32(ps.scratch[base + 6])\n        hi := i32(ps.scratch[base + 7])\n        ps.revents[i] = lo + hi.shl(8)\n    }\n    IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }\n}\n\npub fn stream_set() -> StreamSet {\n    StreamSet { fds: [] }\n}\n\npub fn set_len(set: &StreamSet) -> i32 {\n    set.fds.len\n}\n\npub fn set_fd(set: &StreamSet, slot: i32) -> i32 {\n    set.fds[slot]\n}\n\npub fn set_insert(set: &mut StreamSet, s: &mut TcpStream) -> i32 {\n    assert(s.fd >= 0)\n    fd := s.fd\n    s.fd = -1\n    for i in 0..set.fds.len {\n        if set.fds[i] < 0 {\n            set.fds[i] = fd\n            return i\n        }\n    }\n    set.fds.push(fd)\n    set.fds.len - 1\n}\n\npub fn set_read_append(set: &StreamSet, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult {\n    fd := set.fds[slot]\n    assert(fd >= 0)\n    fd_read_append(fd, &mut out, max_bytes)\n}\n\npub fn set_write_range(set: &StreamSet, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {\n    fd := set.fds[slot]\n    assert(fd >= 0)\n    fd_write_range(fd, &data, offset, length)\n}\n\npub fn set_shutdown_write(set: &StreamSet, slot: i32) -> sys.Status {\n    fd := set.fds[slot]\n    assert(fd >= 0)\n    status_from_i64(sys.net_shutdown_write(fd))\n}\n\npub fn set_close(set: &mut StreamSet, slot: i32) -> sys.Status {\n    fd := set.fds[slot]\n    if fd < 0 { return sys.Status { ok: true, error: 0 } }\n    st := status_from_i64(sys.net_close(fd))\n    set.fds[slot] = -1\n    st\n}\n\npub fn set_close_all(set: &mut StreamSet) {\n    for i in 0..set.fds.len {\n        if set.fds[i] >= 0 {\n            unused := sys.net_close(set.fds[i])\n            set.fds[i] = -1\n        }\n    }\n}\n" }
    if name == "parse" { return "pub struct Integer { ok: bool, value: i64, error: i32 }\npub struct Unsigned { ok: bool, value: u64, error: i32 }\n\nfn radix_digit(byte: i32, radix: i32) -> i32 {\n    if byte >= 48 && byte <= 57 {\n        d := byte - 48\n        if d < radix { return d }\n        return -1\n    }\n    if radix == 16 {\n        if byte >= 65 && byte <= 70 { return byte - 55 }\n        if byte >= 97 && byte <= 102 { return byte - 87 }\n    }\n    -1\n}\n\nfn parse_signed_range(text: string, start: i32, end: i32, radix: i32) -> Integer {\n    if start < 0 || end < start || end > text.len || start == end { return Integer { ok: false, value: 0, error: 1 } }\n    var cursor := start\n    var negative := false\n    if text[cursor] == 45 || text[cursor] == 43 { negative = text[cursor] == 45; cursor = cursor + 1 }\n    if cursor == end { return Integer { ok: false, value: 0, error: 1 } }\n    var limit: i64 = -9223372036854775807\n    if negative { limit = -9223372036854775808 }\n    var value: i64 = 0\n    while cursor < end {\n        d := radix_digit(text[cursor], radix)\n        if d < 0 { return Integer { ok: false, value: 0, error: 1 } }\n        if value < limit / i64(radix) { return Integer { ok: false, value: 0, error: 2 } }\n        value = value * i64(radix)\n        if value < limit + i64(d) { return Integer { ok: false, value: 0, error: 2 } }\n        value = value - i64(d)\n        cursor = cursor + 1\n    }\n    if !negative { value = -value }\n    Integer { ok: true, value: value, error: 0 }\n}\n\nfn parse_unsigned_range(text: string, start: i32, end: i32, radix: i32) -> Unsigned {\n    if start < 0 || end < start || end > text.len || start == end { return Unsigned { ok: false, value: 0, error: 1 } }\n    var max_div: u64 = 1844674407370955161\n    var max_rem := 5\n    if radix == 16 { max_div = 1152921504606846975; max_rem = 15 }\n    var value: u64 = 0\n    for i in start..end {\n        d := radix_digit(text[i], radix)\n        if d < 0 { return Unsigned { ok: false, value: 0, error: 1 } }\n        if value > max_div || (value == max_div && d > max_rem) {\n            return Unsigned { ok: false, value: 0, error: 2 }\n        }\n        value = value * u64(radix) + u64(d)\n    }\n    Unsigned { ok: true, value: value, error: 0 }\n}\n\n// error: 1=invalid spelling, 2=overflow. Strict ASCII decimal, optional sign.\npub fn integer(text: string) -> Integer {\n    if text.len == 0 { return Integer { ok: false, value: 0, error: 1 } }\n    var cursor := 0\n    var negative := false\n    if text[0] == 45 || text[0] == 43 { negative = text[0] == 45; cursor = 1 }\n    if cursor == text.len { return Integer { ok: false, value: 0, error: 1 } }\n    var limit: i64 = -9223372036854775807\n    if negative { limit = -9223372036854775808 }\n    var value: i64 = 0\n    var previous_digit := false\n    while cursor < text.len {\n        byte := text[cursor]\n        if byte == 95 {\n            if !previous_digit || cursor + 1 == text.len || text[cursor + 1] < 48 || text[cursor + 1] > 57 { return Integer { ok: false, value: 0, error: 1 } }\n            previous_digit = false\n        } else {\n            if byte < 48 || byte > 57 { return Integer { ok: false, value: 0, error: 1 } }\n            if value < limit / 10 { return Integer { ok: false, value: 0, error: 2 } }\n            value = value * 10\n            if value < limit + i64(byte - 48) { return Integer { ok: false, value: 0, error: 2 } }\n            value = value - i64(byte - 48)\n            previous_digit = true\n        }\n        cursor = cursor + 1\n    }\n    if !negative { value = -value }\n    Integer { ok: true, value: value, error: 0 }\n}\npub fn hex(text: string) -> Integer { parse_signed_range(text, 0, text.len, 16) }\npub fn i64_range(text: string, start: i32, end: i32) -> Integer { parse_signed_range(text, start, end, 10) }\npub fn u64_range(text: string, start: i32, end: i32) -> Unsigned { parse_unsigned_range(text, start, end, 10) }\npub fn hex_u64_range(text: string, start: i32, end: i32) -> Unsigned { parse_unsigned_range(text, start, end, 16) }\n\n@test fn decimal_parser_covers_limits_separators_and_errors() {\n    integer(\"42\").value == 42\n    integer(\"-9223372036854775808\").value == -9223372036854775808\n    integer(\"9223372036854775807\").value == 9223372036854775807\n    integer(\"42_000\").value == 42000\n    integer(\"+0\").ok\n    integer(\"9223372036854775808\").error == 2\n    integer(\"-9223372036854775809\").error == 2\n    !integer(\"1__2\").ok\n    !integer(\"1_\").ok\n    !integer(\" 2\").ok\n    !integer(\"+\").ok\n    !integer(\"\").ok\n    hex(\"1a2B\").value == 6699\n    hex(\"-ff\").value == -255\n    !hex(\"1_2\").ok\n    i64_range(\"len:1024;\", 4, 8).value == 1024\n    u64_range(\"len:18446744073709551615;\", 4, 24).value == 18446744073709551615\n    u64_range(\"18446744073709551616\", 0, 20).error == 2\n    hex_u64_range(\"chunk=deadbeef;\", 6, 14).value == 3735928559\n}\n" }
    if name == "process" { return "capability unsafe, process\nimport std.bytes as bytes\nimport std.dl as dl\nimport std.text as text\nimport sys\n\n@extern(\"c\", \"uname\")\nunsafe fn c_uname(output: ptr) -> i32\n@extern(\"c\", \"fork\")\nunsafe fn c_fork() -> i32\n@extern(\"c\", \"execve\")\nunsafe fn c_execve(path: ptr, argv: ptr, envp: ptr) -> i32\n@extern(\"c\", \"_exit\")\nunsafe fn c_exit(code: i32)\n@extern(\"c\", \"pipe\")\nunsafe fn c_pipe(fds: ptr) -> i32\n@extern(\"c\", \"dup2\")\nunsafe fn c_dup2(oldfd: i32, newfd: i32) -> i32\n@extern(\"c\", \"close\")\nunsafe fn c_close(fd: i32) -> i32\n@extern(\"c\", \"chdir\")\nunsafe fn c_chdir(path: ptr) -> i32\n@extern(\"c\", \"waitpid\")\nunsafe fn c_waitpid(pid: i32, status: ptr, options: i32) -> i32\n@extern(\"c\", \"kill\")\nunsafe fn c_kill(pid: i32, sig: i32) -> i32\n@extern(\"c\", \"setpgid\")\nunsafe fn c_setpgid(pid: i32, pgid: i32) -> i32\n@extern(\"c\", \"read\")\nunsafe fn c_read(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"write\")\nunsafe fn c_write(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"ioctl\")\nunsafe fn c_ioctl(fd: i32, req: usize) -> i32\n@extern(\"c\", \"fopen\")\nunsafe fn c_fopen(path: ptr, mode: ptr) -> ptr\n@extern(\"c\", \"fileno\")\nunsafe fn c_fileno(file: ptr) -> i32\n@extern(\"c\", \"fclose\")\nunsafe fn c_fclose(file: ptr) -> i32\n@extern(\"c\", \"getenv\")\nunsafe fn c_getenv(name: ptr) -> ptr\n@extern(\"c\", \"signal\")\nunsafe fn c_signal(sig: i32, handler: ptr) -> ptr\n@extern(\"c\", \"sysconf\")\nunsafe fn c_sysconf(name: i32) -> i64\n@extern(\"c\", \"usleep\")\nunsafe fn c_usleep(usec: u32) -> i32\n\npub enum EnvMode { Inherit = 0, Clear = 1 }\npub enum Stdio { Inherit = 0, Pipe = 1, Null = 2 }\n\npub opaque struct Executable { program: string }\n\npub struct Command {\n    program: string,\n    args: []string,\n    cwd: string,\n    env_mode: EnvMode,\n    env_keys: []string,\n    env_vals: []string,\n    env_unset: []bool,\n    stdin_mode: Stdio,\n    stdout_mode: Stdio,\n    stderr_mode: Stdio,\n    stdin_data: []u8,\n    timeout_ms: i64,\n    max_output_bytes: i64,\n}\n\npub struct Output {\n    ok: bool,\n    error: i32,\n    code: i32,\n    signal: i32,\n    timed_out: bool,\n    stdout: []u8,\n    stderr: []u8,\n}\n\npub opaque struct Child {\n    pid: i32,\n    pgid: i32,\n    stdin_fd: i32,\n    stdout_fd: i32,\n    stderr_fd: i32,\n    reaped: bool,\n    code: i32,\n    signal: i32,\n}\n\npub struct SpawnResult { ok: bool, child: Child, error: i32 }\npub struct WaitResult { ok: bool, exited: bool, timed_out: bool, code: i32, signal: i32, error: i32 }\n\n@requires(process)\npub fn grant(program: string) -> Executable { Executable { program: program } }\n\npub fn executable_path(exe: &Executable) -> string { exe.program }\n\npub fn command(program: string, args: []string) -> Command {\n    Command {\n        program: program,\n        args: args,\n        cwd: \"\",\n        env_mode: .Inherit,\n        env_keys: [],\n        env_vals: [],\n        env_unset: [],\n        stdin_mode: .Null,\n        stdout_mode: .Pipe,\n        stderr_mode: .Pipe,\n        stdin_data: [],\n        timeout_ms: 0,\n        max_output_bytes: 67108864,\n    }\n}\n\npub fn add_arg(cmd: &mut Command, arg: string) { cmd.args.push(arg) }\n\npub fn add_args(cmd: &mut Command, args: &[]string) {\n    for a in args { cmd.args.push(a) }\n}\n\npub fn set_cwd(cmd: &mut Command, cwd: string) { cmd.cwd = cwd }\n\npub fn clear_env(cmd: &mut Command) {\n    cmd.env_mode = .Clear\n    cmd.env_keys.clear()\n    cmd.env_vals.clear()\n    cmd.env_unset.clear()\n}\n\npub fn set_env(cmd: &mut Command, key: string, value: string) {\n    for i in 0..cmd.env_keys.len {\n        if cmd.env_keys[i] == key {\n            cmd.env_vals[i] = value\n            cmd.env_unset[i] = false\n            return\n        }\n    }\n    cmd.env_keys.push(key)\n    cmd.env_vals.push(value)\n    cmd.env_unset.push(false)\n}\n\npub fn unset_env(cmd: &mut Comm