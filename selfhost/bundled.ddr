pub fn core_prelude() -> string { "pub enum Ordering { Less, Equal, Greater }\npub enum ReserveStatus { Ok, InvalidCapacity, OutOfMemory }\n\npub trait Eq {\n    fn eq(&self, other: &Self) -> bool\n    fn ne(&self, other: &Self) -> bool { !self.eq(other) }\n}\n\npub trait Ord: Eq {\n    fn cmp(&self, other: &Self) -> Ordering\n    fn lt(&self, other: &Self) -> bool { self.cmp(other) == Ordering.Less }\n    fn le(&self, other: &Self) -> bool { self.cmp(other) != Ordering.Greater }\n    fn gt(&self, other: &Self) -> bool { self.cmp(other) == Ordering.Greater }\n    fn ge(&self, other: &Self) -> bool { self.cmp(other) != Ordering.Less }\n}\n\npub trait Hash: Eq {\n    fn hash(&self) -> u64\n}\n\npub trait Display {\n    fn str(&self) -> string\n}\n\npub trait Default {\n    fn default() -> Self\n}\n\nfn __dunder_module_mix_key(n: u64) -> u64 {\n    mixed := n.bit_xor(n.shr(32)).wrapping_mul(11400714819323198485)\n    mixed.bit_xor(mixed.shr(32))\n}\n\nimpl Eq for Ordering {\n    fn eq(&self, other: &Self) -> bool { self == other }\n}\nimpl Ord for Ordering {\n    fn cmp(&self, other: &Self) -> Ordering {\n        a := match self { .Less => 0, .Equal => 1, .Greater => 2 }\n        b := match other { .Less => 0, .Equal => 1, .Greater => 2 }\n        if a < b { return Ordering.Less }\n        if a > b { return Ordering.Greater }\n        Ordering.Equal\n    }\n}\nimpl Hash for Ordering {\n    fn hash(&self) -> u64 {\n        v := match self { .Less => 0, .Equal => 1, .Greater => 2 }\n        __dunder_module_mix_key(u64(v))\n    }\n}\nimpl Display for Ordering {\n    fn str(&self) -> string {\n        match self {\n            .Less => \"Less\",\n            .Equal => \"Equal\",\n            .Greater => \"Greater\",\n        }\n    }\n}\nimpl Default for Ordering {\n    fn default() -> Self { Ordering.Equal }\n}\n\nimpl Eq for bool {\n    fn eq(&self, other: &Self) -> bool { self == other }\n}\nimpl Ord for bool {\n    fn cmp(&self, other: &Self) -> Ordering {\n        if self == other { return Ordering.Equal }\n        if self { Ordering.Greater } else { Ordering.Less }\n    }\n}\nimpl Hash for bool {\n    fn hash(&self) -> u64 {\n        if self { u64(1) } else { u64(0) }\n    }\n}\nimpl Display for bool {\n    fn str(&self) -> string { self.str() }\n}\nimpl Default for bool {\n    fn default() -> Self { false }\n}\n\nimpl Eq for i16 {\n    fn eq(&self, other: &Self) -> bool { self == other }\n}\nimpl Ord for i16 {\n    fn cmp(&self, other: &Self) -> Ordering {\n        if self < other { Ordering.Less } else if self > other { Ordering.Greater } else { Ordering.Equal }\n    }\n}\nimpl Hash for i16 {\n    fn hash(&self) -> u64 {\n        __dunder_module_mix_key(u64(i64(self).bit_and(65535)))\n    }\n}\nimpl Display for i16 {\n    fn str(&self) -> string { self.str() }\n}\nimpl Default for i16 {\n    fn default() -> Self { 0 }\n}\n\nimpl Eq for i32 {\n    fn eq(&self, other: &Self) -> bool { self == other }\n}\nimpl Ord for i32 {\n    fn cmp(&self, other: &Self) -> Ordering {\n        if self < other { Ordering.Less } else if self > other { Ordering.Greater } else { Ordering.Equal }\n    }\n}\nimpl Hash for i32 {\n    fn hash(&self) -> u64 {\n        lo := u64(i64(self).bit_and(2147483647))\n        mut bits := lo\n        if self < 0 { bits = lo.bit_or(u64(2147483648)) }\n        __dunder_module_mix_key(bits)\n    }\n}\nimpl Display for i32 {\n    fn str(&self) -> string { self.str() }\n}\nimpl Default for i32 {\n    fn default() -> Self { 0 }\n}\n\nimpl Eq for i64 {\n    fn eq(&self, other: &Self) -> bool { self == other }\n}\nimpl Ord for i64 {\n    fn cmp(&self, other: &Self) -> Ordering {\n        if self < other { Ordering.Less } else if self > other { Ordering.Greater } else { Ordering.Equal }\n    }\n}\nimpl Hash for i64 {\n    fn hash(&self) -> u64 {\n        lo := u64(i64(self).bit_and(9223372036854775807))\n        mut bits := lo\n        if self < 0 { bits = lo.bit_or(u64(9223372036854775808)) }\n        __dunder_module_mi