pub fn source(name: string) -> string {
    if name == "alloc" { return "capability unsafe\n\nimport std.bytes as bytes\nimport std.io as io\nimport sys\n\n@extern(\"c\", \"mmap\")\nunsafe fn c_mmap(address: ptr, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> ptr\n\n@extern(\"c\", \"munmap\")\nunsafe fn c_munmap(address: ptr, length: usize) -> i32\n\npub enum AllocError {\n    InvalidLayout = 1,\n    OutOfMemory = 2,\n    LimitExceeded = 3,\n    Unsupported = 4,\n}\n\nimpl Eq for AllocError {\n    fn eq(&self, other: &Self) -> bool { self.code() == other.code() }\n}\n\nimpl Hash for AllocError {\n    fn hash(&self) -> u64 { self.code().hash() }\n}\n\nimpl Display for AllocError {\n    fn str(&self) -> string { self.message() }\n}\n\nimpl AllocError {\n    pub fn code(&self) -> i32 {\n        match self {\n            .InvalidLayout => 1,\n            .OutOfMemory => 2,\n            .LimitExceeded => 3,\n            .Unsupported => 4,\n        }\n    }\n\n    pub fn message(&self) -> string {\n        match self {\n            .InvalidLayout => \"invalid allocation layout\",\n            .OutOfMemory => \"out of memory\",\n            .LimitExceeded => \"allocation limit exceeded\",\n            .Unsupported => \"unsupported allocation operation\",\n        }\n    }\n}\n\nfn max_isize() -> usize {\n    if target_is(\"wasm32\") { return usize(2147483647) }\n    hi := u64(9223372036854775807)\n    usize(hi)\n}\n\nfn ptr_bytes() -> usize {\n    if target_is(\"wasm32\") { return usize(4) }\n    usize(8)\n}\n\nfn is_power_of_two(v: usize) -> bool {\n    v > usize(0) && v.bit_and(v - usize(1)) == usize(0)\n}\n\nfn align_up(value: usize, align: usize) -> usize {\n    mask := align - usize(1)\n    misalign := value.bit_and(mask)\n    if misalign == usize(0) { value } else { value + (align - misalign) }\n}\n\npub struct Layout {\n    size: usize,\n    align: usize,\n}\n\nimpl Layout {\n    pub fn from_size_align(size: usize, align: usize) -> Result<Self, AllocError> {\n        if !is_power_of_two(align) { return .Err(.InvalidLayout) }\n        limit := max_isize()\n        if align > limit || size > limit - (align - usize(1)) {\n            return .Err(.InvalidLayout)\n        }\n        .Ok(Self { size: size, align: align })\n    }\n\n    pub fn bytes(size: usize) -> Result<Self, AllocError> {\n        Self::from_size_align(size, usize(1))\n    }\n\n    pub fn size(&self) -> usize { self.size }\n    pub fn align(&self) -> usize { self.align }\n\n    pub fn is_valid(&self) -> bool {\n        if !is_power_of_two(self.align) { return false }\n        limit := max_isize()\n        self.align <= limit && self.size <= limit - (self.align - usize(1))\n    }\n\n    pub fn pad_to_align(&self) -> Result<Self, AllocError> {\n        if !self.is_valid() { return .Err(.InvalidLayout) }\n        Self::from_size_align(align_up(self.size, self.align), self.align)\n    }\n\n    pub fn repeat(&self, count: usize) -> Result<Self, AllocError> {\n        match self.pad_to_align() {\n            .Ok(padded) => {\n                if count == usize(0) || padded.size == usize(0) {\n                    return .Ok(Self { size: usize(0), align: self.align })\n                }\n                if count > max_isize() / padded.size { return .Err(.InvalidLayout) }\n                Self::from_size_align(padded.size * count, self.align)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n}\n\nimpl Eq for Layout {\n    fn eq(&self, other: &Self) -> bool { self.size == other.size && self.align == other.align }\n}\n\nimpl Hash for Layout {\n    fn hash(&self) -> u64 {\n        u64(self.size).hash().bit_xor(u64(self.align).hash().wrapping_mul(u64(11400714819323198485)))\n    }\n}\n\npub fn layout_of<T>() -> Layout {\n    Layout { size: size_of(T), align: align_of(T) }\n}\n\npub fn layout_array<T>(count: usize) -> Result<Layout, AllocError> {\n    layout_of<T>().repeat(count)\n}\n\npub struct Block {\n    ptr: ptr,\n    size: usize,\n}\n\nimpl Block {\n    pub fn empty() -> Self {\n        unsafe { return Self { ptr: ptr(0), size: usize(0) } }\n    }\n    pub fn is_empty(&self) -> bool { self.size == usize(0) }\n    pub fn address(&self) -> ptr { self.ptr }\n    pub fn size(&self) -> usize { self.size }\n}\n\n@resource\npub opaque struct ByteView {\n    data: ptr,\n    length: usize,\n}\n\nimpl ByteView {\n    pub fn len(&self) -> usize { self.length }\n\n    pub fn get(&self, index: usize) -> Option<u8> {\n        if index >= self.length { return .None }\n        unsafe { return .Some(load_u8(ptr(usize(self.data) + index))) }\n    }\n\n    pub fn window(&self, first: usize, end: usize) -> &[]u8 from self {\n        assert(first <= end && end <= self.length)\n        if first == end { unsafe { return bytes_view(&self, self.data, usize(0)) } }\n        unsafe { return bytes_view(&self, ptr(usize(self.data) + first), end - first) }\n    }\n}\n\npub unsafe fn with_bytes<R>(block: &Block, read: &Fn(&ByteView) -> R) -> R {\n    view := ByteView { data: block.ptr, length: block.size }\n    read(view)\n}\n\npub trait RawAllocator {\n    unsafe fn alloc(&mut self, layout: Layout) -> Result<Block, AllocError>\n    unsafe fn dealloc(&mut self, block: Block, layout: Layout)\n\n    unsafe fn alloc_zeroed(&mut self, layout: Layout) -> Result<Block, AllocError> {\n        match self.alloc(layout) {\n            .Ok(blk) => {\n                if blk.size > usize(0) && usize(blk.ptr) != usize(0) {\n                    sys.memory_zero(blk.ptr, blk.size)\n                }\n                .Ok(blk)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    unsafe fn realloc(&mut self, block: Block, old_layout: Layout, new_layout: Layout) -> Result<Block, AllocError> {\n        if !new_layout.is_valid() { return .Err(.InvalidLayout) }\n        if new_layout.size == usize(0) {\n            self.dealloc(block, old_layout)\n            return .Ok(Block { ptr: ptr(new_layout.align), size: usize(0) })\n        }\n        match self.alloc(new_layout) {\n            .Ok(next) => {\n                copy_n := if old_layout.size < next.size { old_layout.size } else { next.size }\n                if copy_n > usize(0) && usize(block.ptr) != usize(0) {\n                    sys.memory_copy(next.ptr, block.ptr, copy_n)\n                }\n                self.dealloc(block, old_layout)\n                .Ok(next)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n}\n\npub struct Global {}\n\nimpl Global {\n    pub fn new() -> Self { Self {} }\n}\n\nimpl Default for Global {\n    fn default() -> Self { Self {} }\n}\n\nimpl RawAllocator for Global {\n    unsafe fn alloc(&mut self, layout: Layout) -> Result<Block, AllocError> {\n        if !layout.is_valid() { return .Err(.InvalidLayout) }\n        if layout.size == usize(0) {\n            return .Ok(Block { ptr: ptr(layout.align), size: usize(0) })\n        }\n        if layout.align <= usize(8) {\n            raw := sys.pool_alloc_try(layout.size)\n            if usize(raw) == usize(0) { return .Err(.OutOfMemory) }\n            return .Ok(Block { ptr: raw, size: layout.size })\n        }\n        meta := ptr_bytes()\n        extra := layout.align + meta\n        if layout.size > max_isize() - extra { return .Err(.InvalidLayout) }\n        raw := sys.pool_alloc_try(layout.size + extra)\n        if usize(raw) == usize(0) { return .Err(.OutOfMemory) }\n        aligned := align_up(usize(raw) + meta, layout.align)\n        store_ptr(ptr(aligned - meta), raw)\n        .Ok(Block { ptr: ptr(aligned), size: layout.size })\n    }\n\n    unsafe fn dealloc(&mut self, block: Block, layout: Layout) {\n        if layout.size == usize(0) || !layout.is_valid() || usize(block.ptr) == usize(0) { return }\n        if layout.align <= usize(8) {\n            sys.pool_free(block.ptr)\n            return\n        }\n        raw := load_ptr(ptr(usize(block.ptr) - ptr_bytes()))\n        if usize(raw) != usize(0) { sys.pool_free(raw) }\n    }\n}\n\npub struct System {}\n\nimpl System {\n    pub fn new() -> Self { Self {} }\n}\n\nimpl Default for System {\n    fn default() -> Self { Self {} }\n}\n\nfn system_page_size() -> usize {\n    if target_is(\"macos\") { return usize(16384) }\n    usize(4096)\n}\n\nunsafe fn os_mmap_anon(length: usize) -> Result<ptr, AllocError> {\n    if target_is(\"macos\") {\n        // PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANON = 0x1002 = 4098\n        raw := c_mmap(ptr(0), length, 3, 4098, -1, 0)\n        failed := usize(0).wrapping_sub(usize(1))\n        if usize(raw) == usize(0) || usize(raw) == failed { return .Err(.OutOfMemory) }\n        return .Ok(raw)\n    }\n    if target_is(\"linux\") {\n        // MAP_PRIVATE|MAP_ANONYMOUS = 0x22 = 34; ARM64 mmap syscall 222 (mapped on x86_64)\n        r := sys.linux_syscall(222, 0, i64(length), 3, 34, -1, 0)\n        if r <= 0 { return .Err(.OutOfMemory) }\n        return .Ok(ptr(usize(r)))\n    }\n    .Err(.Unsupported)\n}\n\nunsafe fn os_munmap_anon(raw: ptr, length: usize) {\n    if target_is(\"macos\") {\n        _ := c_munmap(raw, length)\n    } else if target_is(\"linux\") {\n        // ARM64 munmap syscall 215 (mapped on x86_64)\n        _ := sys.linux_syscall(215, i64(usize(raw)), i64(length), 0, 0, 0, 0)\n    }\n}\n\nimpl RawAllocator for System {\n    unsafe fn alloc(&mut self, layout: Layout) -> Result<Block, AllocError> {\n        if !layout.is_valid() { return .Err(.InvalidLayout) }\n        if layout.size == usize(0) {\n            return .Ok(Block { ptr: ptr(layout.align), size: usize(0) })\n        }\n        if !target_is(\"native\") {\n            mut g := Global::new()\n            return g.alloc(layout)\n        }\n        page := system_page_size()\n        limit := max_isize()\n        if layout.align <= page {\n            if layout.size > limit - (page - usize(1)) { return .Err(.InvalidLayout) }\n            mapped := align_up(layout.size, page)\n            match os_mmap_anon(mapped) {\n                .Ok(raw) => { return .Ok(Block { ptr: raw, size: layout.size }) },\n                .Err(e) => { return .Err(e) },\n            }\n        }\n        meta := ptr_bytes()\n        if layout.align > limit - meta - (page - usize(1)) { return .Err(.InvalidLayout) }\n        extra := layout.align + meta\n        if layout.size > limit - extra - (page - usize(1)) { return .Err(.InvalidLayout) }\n        mapped := align_up(layout.size + extra, page)\n        match os_mmap_anon(mapped) {\n            .Ok(raw) => {\n                aligned := align_up(usize(raw) + meta, layout.align)\n                store_ptr(ptr(aligned - meta), raw)\n                .Ok(Block { ptr: ptr(aligned), size: layout.size })\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    unsafe fn dealloc(&mut self, block: Block, layout: Layout) {\n        if layout.size == usize(0) || !layout.is_valid() || usize(block.ptr) == usize(0) { return }\n        if !target_is(\"native\") {\n            mut g := Global::new()\n            g.dealloc(block, layout)\n            return\n        }\n        page := system_page_size()\n        limit := max_isize()\n        if layout.align <= page {\n            if layout.size > limit - (page - usize(1)) { return }\n            mapped := align_up(layout.size, page)\n            os_munmap_anon(block.ptr, mapped)\n            return\n        }\n        meta := ptr_bytes()\n        extra := layout.align + meta\n        if layout.size > limit - extra - (page - usize(1)) { return }\n        mapped := align_up(layout.size + extra, page)\n        raw := load_ptr(ptr(usize(block.ptr) - meta))\n        if usize(raw) != usize(0) { os_munmap_anon(raw, mapped) }\n    }\n}\n\npub struct Capped<A> where A: RawAllocator {\n    inner: A,\n    limit: usize,\n    used: usize,\n}\n\nimpl Capped<A> {\n    pub fn new(move inner: A, limit: usize) -> Self {\n        Self { inner: inner, limit: limit, used: usize(0) }\n    }\n\n    pub fn limit(&self) -> usize { self.limit }\n    pub fn used(&self) -> usize { self.used }\n    pub fn remaining(&self) -> usize {\n        if self.used >= self.limit { usize(0) } else { self.limit - self.used }\n    }\n    pub fn inner(&self) -> &A from self { &self.inner }\n    pub fn into_inner(move self) -> A { self.inner }\n}\n\nimpl RawAllocator for Capped<A> where A: RawAllocator {\n    unsafe fn alloc(&mut self, layout: Layout) -> Result<Block, AllocError> {\n        if !layout.is_valid() { return .Err(.InvalidLayout) }\n        if layout.size > self.limit || self.used > self.limit - layout.size {\n            return .Err(.LimitExceeded)\n        }\n        match self.inner.alloc(layout) {\n            .Ok(blk) => {\n                self.used += layout.size\n                .Ok(blk)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    unsafe fn dealloc(&mut self, block: Block, layout: Layout) {\n        self.inner.dealloc(block, layout)\n        if self.used >= layout.size { self.used -= layout.size } else { self.used = usize(0) }\n    }\n}\n\npub struct Stats {\n    allocs: u64,\n    deallocs: u64,\n    live_bytes: usize,\n    peak_bytes: usize,\n    total_bytes: u64,\n}\n\nimpl Eq for Stats {\n    fn eq(&self, other: &Self) -> bool {\n        self.allocs == other.allocs && self.deallocs == other.deallocs &&\n            self.live_bytes == other.live_bytes && self.peak_bytes == other.peak_bytes &&\n            self.total_bytes == other.total_bytes\n    }\n}\n\npub struct Tracking<A> where A: RawAllocator {\n    inner: A,\n    stats: Stats,\n}\n\nimpl Tracking<A> {\n    pub fn new(move inner: A) -> Self {\n        Self {\n            inner: inner,\n            stats: Stats { allocs: u64(0), deallocs: u64(0), live_bytes: usize(0), peak_bytes: usize(0), total_bytes: u64(0) },\n        }\n    }\n\n    pub fn stats(&self) -> Stats { self.stats }\n    pub fn inner(&self) -> &A from self { &self.inner }\n    pub fn into_inner(move self) -> A { self.inner }\n}\n\nimpl Default for Tracking<A> where A: RawAllocator + Default {\n    fn default() -> Self { Self::new(A::default()) }\n}\n\nimpl RawAllocator for Tracking<A> where A: RawAllocator {\n    unsafe fn alloc(&mut self, layout: Layout) -> Result<Block, AllocError> {\n        match self.inner.alloc(layout) {\n            .Ok(blk) => {\n                self.stats.allocs += u64(1)\n                self.stats.total_bytes = self.stats.total_bytes.wrapping_add(u64(layout.size))\n                self.stats.live_bytes += layout.size\n                if self.stats.live_bytes > self.stats.peak_bytes {\n                    self.stats.peak_bytes = self.stats.live_bytes\n                }\n                .Ok(blk)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    unsafe fn dealloc(&mut self, block: Block, layout: Layout) {\n        self.inner.dealloc(block, layout)\n        self.stats.deallocs += u64(1)\n        if self.stats.live_bytes >= layout.size {\n            self.stats.live_bytes -= layout.size\n        } else {\n            self.stats.live_bytes = usize(0)\n        }\n    }\n}\n\nstruct Slab {\n    block: Block,\n    layout: Layout,\n}\n\n@resource(dispose)\npub struct Bump<A> where A: RawAllocator {\n    backing: A,\n    slabs: []Slab,\n    current_cursor: usize,\n    current_end: usize,\n    next_slab_size: usize,\n    bytes_allocated: usize,\n    last_ptr: ptr,\n    last_prev_cursor: usize,\n    last_size: usize,\n}\n\nimpl Bump<A> {\n    pub fn with_slab_size(move backing: A, slab_size: usize) -> Self {\n        actual := if slab_size < usize(64) { usize(64) } else { slab_size }\n        unsafe {\n            return Self {\n                backing: backing,\n                slabs: [],\n                current_cursor: usize(0),\n                current_end: usize(0),\n                next_slab_size: actual,\n                bytes_allocated: usize(0),\n                last_ptr: ptr(0),\n                last_prev_cursor: usize(0),\n                last_size: usize(0),\n            }\n        }\n    }\n\n    pub fn new(move backing: A) -> Self {\n        Self::with_slab_size(move backing, usize(4096))\n    }\n\n    pub fn allocated_bytes(&self) -> usize { self.bytes_allocated }\n    pub fn slab_count(&self) -> i32 { self.slabs.len }\n    pub fn backing(&self) -> &A from self { &self.backing }\n\n    pub fn reset(&mut self) {\n        unsafe {\n            self.last_ptr = ptr(0)\n            self.last_prev_cursor = usize(0)\n            self.last_size = usize(0)\n            self.bytes_allocated = usize(0)\n            if self.slabs.len == 0 {\n                self.current_cursor = usize(0)\n                self.current_end = usize(0)\n                return\n            }\n            while self.slabs.len > 1 {\n                s := self.slabs.pop()\n                self.backing.dealloc(s.block, s.layout)\n            }\n            self.current_cursor = usize(self.slabs[0].block.ptr)\n            self.current_end = usize(self.slabs[0].block.ptr) + self.slabs[0].block.size\n        }\n    }\n\n    pub fn release(&mut self) {\n        unsafe {\n            while self.slabs.len > 0 {\n                s := self.slabs.pop()\n                self.backing.dealloc(s.block, s.layout)\n            }\n            self.current_cursor = usize(0)\n            self.current_end = usize(0)\n            self.bytes_allocated = usize(0)\n            self.last_ptr = ptr(0)\n            self.last_prev_cursor = usize(0)\n            self.last_size = usize(0)\n        }\n    }\n\n    fn dispose(&mut self) {\n        self.release()\n    }\n}\n\nimpl Default for Bump<A> where A: RawAllocator + Default {\n    fn default() -> Self { Self::new(A::default()) }\n}\n\nimpl RawAllocator for Bump<A> where A: RawAllocator {\n    unsafe fn alloc(&mut self, layout: Layout) -> Result<Block, AllocError> {\n        if !layout.is_valid() { return .Err(.InvalidLayout) }\n        if layout.size == usize(0) {\n            return .Ok(Block { ptr: ptr(layout.align), size: usize(0) })\n        }\n        if self.current_cursor != usize(0) && self.current_cursor <= self.current_end {\n            rem := self.current_end - self.current_cursor\n            mis := self.current_cursor.bit_and(layout.align - usize(1))\n            pad := if mis == usize(0) { usize(0) } else { layout.align - mis }\n            if pad <= rem && layout.size <= rem - pad {\n                prev := self.current_cursor\n                aligned := prev + pad\n                self.current_cursor = aligned + layout.size\n                self.bytes_allocated += layout.size\n                self.last_ptr = ptr(aligned)\n                self.last_prev_cursor = prev\n                self.last_size = layout.size\n                return .Ok(Block { ptr: ptr(aligned), size: layout.size })\n            }\n        }\n        slab_align := if layout.align > usize(16) { layout.align } else { usize(16) }\n        need := if self.next_slab_size > layout.size { self.next_slab_size } else { layout.size }\n        mut slab_layout := Layout { size: need, align: slab_align }\n        match Layout::from_size_align(need, slab_align) {\n            .Ok(l) => { slab_layout = l },\n            .Err(e) => { return .Err(e) },\n        }\n        match self.backing.alloc(slab_layout) {\n            .Ok(blk) => {\n                base := usize(blk.ptr)\n                self.slabs.push(Slab { block: blk, layout: slab_layout })\n                self.current_cursor = base + layout.size\n                self.current_end = base + blk.size\n                self.bytes_allocated += layout.size\n                self.last_ptr = blk.ptr\n                self.last_prev_cursor = base\n                self.last_size = layout.size\n                if self.next_slab_size <= usize(33554432) {\n                    self.next_slab_size = self.next_slab_size * usize(2)\n                }\n                .Ok(Block { ptr: blk.ptr, size: layout.size })\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    unsafe fn dealloc(&mut self, block: Block, layout: Layout) {\n        if layout.size == usize(0) { return }\n        if self.last_ptr == block.ptr && layout.size == self.last_size {\n            self.current_cursor = self.last_prev_cursor\n            if self.bytes_allocated >= layout.size {\n                self.bytes_allocated -= layout.size\n            } else {\n                self.bytes_allocated = usize(0)\n            }\n            self.last_ptr = ptr(0)\n            self.last_prev_cursor = usize(0)\n            self.last_size = usize(0)\n        }\n    }\n}\n\nfn alloc_to_io_error(err: AllocError) -> sys.IoError {\n    match err {\n        .InvalidLayout => .InvalidArgument,\n        .OutOfMemory => .OutOfMemory,\n        .LimitExceeded => .OutOfMemory,\n        .Unsupported => .Unsupported,\n    }\n}\n\nunsafe fn copy_slice_to_ptr(dst: ptr, src: &[]u8) {\n    base := usize(dst)\n    for i in 0..src.len {\n        store_u8(ptr(base + usize(i)), src[i])\n    }\n}\n\n@resource(dispose)\npub struct OwnedBuf<A> where A: RawAllocator {\n    allocator: A,\n    data: ptr,\n    len: usize,\n    cap: usize,\n}\n\nimpl OwnedBuf<A> {\n    pub fn new(move allocator: A) -> Self {\n        unsafe { return Self { allocator: allocator, data: ptr(0), len: usize(0), cap: usize(0) } }\n    }\n\n    pub fn with_capacity(move allocator: A, cap: usize) -> Result<Self, AllocError> {\n        mut out := Self::new(move allocator)\n        if cap > usize(0) {\n            match out.reserve(cap) {\n                .Ok => {},\n                .Err(e) => { return .Err(e) },\n            }\n        }\n        .Ok(out)\n    }\n\n    pub fn len(&self) -> usize { self.len }\n    pub fn capacity(&self) -> usize { self.cap }\n    pub fn is_empty(&self) -> bool { self.len == usize(0) }\n    pub fn allocator(&self) -> &A from self { &self.allocator }\n\n    pub fn reserve(&mut self, additional: usize) -> Result<(), AllocError> {\n        if additional == usize(0) { return .Ok }\n        limit := usize(2147483647)\n        if self.len > limit || additional > limit - self.len { return .Err(.InvalidLayout) }\n        needed := self.len + additional\n        if needed <= self.cap { return .Ok }\n        mut next_cap := if self.cap < usize(64) { usize(64) } else { self.cap * usize(2) }\n        if next_cap < needed { next_cap = needed }\n        if next_cap > limit { next_cap = needed }\n        match Layout::bytes(next_cap) {\n            .Ok(new_layout) => {\n                if self.cap == usize(0) {\n                    unsafe {\n                        match self.allocator.alloc(new_layout) {\n                            .Ok(blk) => {\n                                self.data = blk.ptr\n                                self.cap = next_cap\n                                return .Ok\n                            },\n                            .Err(e) => { return .Err(e) },\n                        }\n                    }\n                }\n                old_layout := Layout { size: self.cap, align: usize(1) }\n                unsafe {\n                    match self.allocator.realloc(Block { ptr: self.data, size: self.cap }, old_layout, new_layout) {\n                        .Ok(blk) => {\n                            self.data = blk.ptr\n                            self.cap = next_cap\n                            return .Ok\n                        },\n                        .Err(e) => { return .Err(e) },\n                    }\n                }\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n\n    pub fn push_byte(&mut self, value: u8) -> Result<(), AllocError> {\n        match self.reserve(usize(1)) {\n            .Ok => {\n                unsafe { store_u8(ptr(usize(self.data) + self.len), value) }\n                self.len += usize(1)\n                .Ok\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    pub fn extend_bytes(&mut self, src: &[]u8) -> Result<(), AllocError> {\n        if src.len == 0 { return .Ok }\n        match self.reserve(usize(src.len)) {\n            .Ok => {\n                unsafe {\n                    copy_slice_to_ptr(ptr(usize(self.data) + self.len), &src)\n                }\n                self.len += usize(src.len)\n                .Ok\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    pub fn extend_str(&mut self, s: string) -> Result<(), AllocError> {\n        if s.len == 0 { return .Ok }\n        mut tmp: []u8 = []\n        bytes.append_utf8(&mut tmp, s)\n        self.extend_bytes(&tmp)\n    }\n\n    pub fn as_bytes(&self) -> &[]u8 from self {\n        unsafe { return bytes_view(&self, self.data, self.len) }\n    }\n\n    pub fn clear(&mut self) { self.len = usize(0) }\n\n    pub fn release(&mut self) {\n        unsafe {\n            if self.cap > usize(0) && usize(self.data) != usize(0) {\n                self.allocator.dealloc(Block { ptr: self.data, size: self.cap }, Layout { size: self.cap, align: usize(1) })\n            }\n            self.data = ptr(0)\n            self.len = usize(0)\n            self.cap = usize(0)\n        }\n    }\n\n    pub fn into_allocator(mut move self) -> A {\n        self.release()\n        Self { allocator, .. } := move self\n        allocator\n    }\n\n    fn dispose(&mut self) {\n        self.release()\n    }\n}\n\npub fn buf_into_allocator<A: RawAllocator>(move buf: OwnedBuf<A>) -> A {\n    buf.into_allocator()\n}\n\nimpl Default for OwnedBuf<A> where A: RawAllocator + Default {\n    fn default() -> Self { Self::new(A::default()) }\n}\n\nimpl io.Write for OwnedBuf<A> where A: RawAllocator {\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        match self.extend_bytes(&data) {\n            .Ok => .Ok(data.len),\n            .Err(e) => .Err(alloc_to_io_error(e)),\n        }\n    }\n    fn flush(&mut self) -> Result<(), sys.IoError> { .Ok }\n}\n\npub struct Span {\n    chunk: i32,\n    offset: usize,\n    len: usize,\n}\n\nimpl Span {\n    pub fn empty() -> Self { Self { chunk: -1, offset: usize(0), len: usize(0) } }\n    pub fn len(&self) -> usize { self.len }\n    pub fn is_empty(&self) -> bool { self.len == usize(0) }\n}\n\nimpl Eq for Span {\n    fn eq(&self, other: &Self) -> bool {\n        self.chunk == other.chunk && self.offset == other.offset && self.len == other.len\n    }\n}\n\nimpl Hash for Span {\n    fn hash(&self) -> u64 {\n        h1 := self.chunk.hash()\n        h2 := u64(self.offset).hash()\n        h3 := u64(self.len).hash()\n        h1.bit_xor(h2.wrapping_mul(u64(11400714819323198485))).bit_xor(h3.wrapping_mul(u64(14029467366897019727)))\n    }\n}\n\nstruct ArenaChunk {\n    block: Block,\n    layout: Layout,\n    used: usize,\n}\n\nfn free_arena_chunks<A: RawAllocator>(allocator: &mut A, chunks: &mut []ArenaChunk) {\n    unsafe {\n        while chunks.len > 0 {\n            c := chunks.pop()\n            allocator.dealloc(c.block, c.layout)\n        }\n    }\n}\n\nfn arena_bytes_ptr(chunks: &[]ArenaChunk, span: Span) -> ptr {\n    unsafe {\n        if span.len == usize(0) && span.chunk == -1 { return ptr(0) }\n    }\n    assert(span.chunk >= 0 && span.chunk < chunks.len)\n    c := &chunks[span.chunk]\n    assert(span.offset <= c.used && span.len <= c.used - span.offset)\n    unsafe {\n        if span.len == usize(0) { return ptr(0) }\n        return ptr(usize(c.block.ptr) + span.offset)\n    }\n}\n\n@resource(dispose)\npub struct Arena<A> where A: RawAllocator {\n    allocator: A,\n    chunks: []ArenaChunk,\n    default_chunk_size: usize,\n    total: usize,\n}\n\n@resource(dispose)\npub struct FrozenArena<A> where A: RawAllocator {\n    allocator: A,\n    chunks: []ArenaChunk,\n    total: usize,\n}\n\nimpl Arena<A> {\n    pub fn with_chunk_size(move allocator: A, chunk_size: usize) -> Self {\n        actual := if chunk_size < usize(64) { usize(64) } else { chunk_size }\n        Self { allocator: allocator, chunks: [], default_chunk_size: actual, total: usize(0) }\n    }\n\n    pub fn new(move allocator: A) -> Self {\n        Self::with_chunk_size(move allocator, usize(4096))\n    }\n\n    pub fn total_bytes(&self) -> usize { self.total }\n    pub fn chunk_count(&self) -> i32 { self.chunks.len }\n    pub fn allocator(&self) -> &A from self { &self.allocator }\n\n    fn reserve_span(&mut self, len: usize) -> Result<Span, AllocError> {\n        if len == usize(0) { return .Ok(Span::empty()) }\n        if len > usize(2147483647) { return .Err(.InvalidLayout) }\n        if self.chunks.len > 0 {\n            last_idx := self.chunks.len - 1\n            if self.chunks[last_idx].block.size >= self.chunks[last_idx].used &&\n               len <= self.chunks[last_idx].block.size - self.chunks[last_idx].used {\n                off := self.chunks[last_idx].used\n                self.chunks[last_idx].used += len\n                self.total += len\n                return .Ok(Span { chunk: last_idx, offset: off, len: len })\n            }\n        }\n        chunk_bytes := if self.default_chunk_size > len { self.default_chunk_size } else { len }\n        match Layout::bytes(chunk_bytes) {\n            .Ok(layout) => {\n                unsafe {\n                    match self.allocator.alloc(layout) {\n                        .Ok(blk) => {\n                            idx := self.chunks.len\n                            self.chunks.push(ArenaChunk { block: blk, layout: layout, used: len })\n                            self.total += len\n                            return .Ok(Span { chunk: idx, offset: usize(0), len: len })\n                        },\n                        .Err(e) => { return .Err(e) },\n                    }\n                }\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n\n    pub fn push_bytes(&mut self, src: &[]u8) -> Result<Span, AllocError> {\n        if src.len == 0 { return .Ok(Span::empty()) }\n        match self.reserve_span(usize(src.len)) {\n            .Ok(span) => {\n                unsafe {\n                    dst := ptr(usize(self.chunks[span.chunk].block.ptr) + span.offset)\n                    copy_slice_to_ptr(dst, &src)\n                }\n                .Ok(span)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    pub fn push_str(&mut self, s: string) -> Result<Span, AllocError> {\n        if s.len == 0 { return .Ok(Span::empty()) }\n        mut tmp: []u8 = []\n        bytes.append_utf8(&mut tmp, s)\n        self.push_bytes(&tmp)\n    }\n\n    pub fn alloc_zeroed(&mut self, len: usize) -> Result<Span, AllocError> {\n        if len == usize(0) { return .Ok(Span::empty()) }\n        match self.reserve_span(len) {\n            .Ok(span) => {\n                unsafe {\n                    dst := ptr(usize(self.chunks[span.chunk].block.ptr) + span.offset)\n                    sys.memory_zero(dst, len)\n                }\n                .Ok(span)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    pub fn bytes(&self, span: Span) -> &[]u8 from self {\n        p := arena_bytes_ptr(&self.chunks, span)\n        unsafe { return bytes_view(&self, p, span.len) }\n    }\n\n    pub fn reset(&mut self) {\n        self.total = usize(0)\n        if self.chunks.len == 0 { return }\n        unsafe {\n            while self.chunks.len > 1 {\n                c := self.chunks.pop()\n                self.allocator.dealloc(c.block, c.layout)\n            }\n        }\n        self.chunks[0].used = usize(0)\n    }\n\n    pub fn release_all(&mut self) {\n        free_arena_chunks<A>(&mut self.allocator, &mut self.chunks)\n        self.total = usize(0)\n    }\n\n    pub fn freeze(move self) -> FrozenArena<A> {\n        Self { allocator, chunks, total, .. } := move self\n        FrozenArena<A> { allocator, chunks, total }\n    }\n\n    fn dispose(&mut self) {\n        self.release_all()\n    }\n}\n\nimpl Default for Arena<A> where A: RawAllocator + Default {\n    fn default() -> Self { Self::new(A::default()) }\n}\n\npub fn freeze_arena<A: RawAllocator>(move arena: Arena<A>) -> FrozenArena<A> {\n    arena.freeze()\n}\n\nimpl FrozenArena<A> {\n    pub fn bytes(&self, span: Span) -> &[]u8 from self {\n        p := arena_bytes_ptr(&self.chunks, span)\n        unsafe { return bytes_view(&self, p, span.len) }\n    }\n\n    pub fn total_bytes(&self) -> usize { self.total }\n    pub fn chunk_count(&self) -> i32 { self.chunks.len }\n    pub fn allocator(&self) -> &A from self { &self.allocator }\n\n    fn dispose(&mut self) {\n        free_arena_chunks<A>(&mut self.allocator, &mut self.chunks)\n        self.total = usize(0)\n    }\n}\n\npub fn read_into_arena<A: RawAllocator, R: io.Read>(arena: &mut Arena<A>, reader: &mut R, max_bytes: i64) -> Result<Span, sys.IoError> {\n    mut buf: []u8 = []\n    match io.read_to_end_limit<R>(&mut reader, &mut buf, max_bytes) {\n        .Ok(_) => match arena.push_bytes(&buf) {\n            .Ok(span) => .Ok(span),\n            .Err(e) => .Err(alloc_to_io_error(e)),\n        },\n        .Err(e) => .Err(e),\n    }\n}\n\nstruct PoolEntry<T> {\n    value: T,\n    slot: i32,\n}\n\npub struct Id<T> {\n    index: u32,\n    gen: u32,\n}\n\nimpl Id<T> {\n    pub fn index(&self) -> u32 { self.index }\n    pub fn generation(&self) -> u32 { self.gen }\n}\n\nimpl Eq for Id<T> {\n    fn eq(&self, other: &Self) -> bool { self.index == other.index && self.gen == other.gen }\n}\n\nimpl Hash for Id<T> {\n    fn hash(&self) -> u64 {\n        self.index.hash().bit_xor(self.gen.hash().wrapping_mul(u64(11400714819323198485)))\n    }\n}\n\npub opaque struct Pool<T> where T: Storable {\n    entries: []PoolEntry<T>,\n    slot_to_entry: []i32,\n    gens: []u32,\n    free_next: []i32,\n    free_head: i32,\n}\n\nimpl Pool<T> {\n    pub fn new() -> Self {\n        Self { entries: [], slot_to_entry: [], gens: [], free_next: [], free_head: -1 }\n    }\n\n    pub fn len(&self) -> i32 { self.entries.len }\n    pub fn is_empty(&self) -> bool { self.entries.len == 0 }\n\n    pub fn contains(&self, id: Id<T>) -> bool {\n        if i64(id.index) >= i64(self.slot_to_entry.len) { return false }\n        slot := i32(id.index)\n        self.slot_to_entry[slot] >= 0 && self.gens[slot] == id.gen\n    }\n\n    pub fn insert(&mut self, move value: T) -> Id<T> {\n        if self.free_head >= 0 {\n            slot := self.free_head\n            self.free_head = self.free_next[slot]\n            self.free_next[slot] = -1\n            entry := self.entries.len\n            self.entries.push(PoolEntry<T> { value: value, slot: slot })\n            self.slot_to_entry[slot] = entry\n            return Id<T> { index: u32(slot), gen: self.gens[slot] }\n        }\n        slot := self.slot_to_entry.len\n        entry := self.entries.len\n        self.entries.push(PoolEntry<T> { value: value, slot: slot })\n        self.slot_to_entry.push(entry)\n        self.gens.push(u32(1))\n        self.free_next.push(-1)\n        Id<T> { index: u32(slot), gen: u32(1) }\n    }\n\n    pub fn at(&self, id: Id<T>) -> &T from self {\n        assert(self.contains(id))\n        entry := self.slot_to_entry[i32(id.index)]\n        &self.entries[entry].value\n    }\n\n    pub fn set(&mut self, id: Id<T>, move value: T) -> bool {\n        if !self.contains(id) { return false }\n        entry := self.slot_to_entry[i32(id.index)]\n        self.entries[entry].value = value\n        true\n    }\n\n    pub fn remove(&mut self, id: Id<T>) -> Result<T, ()> {\n        if !self.contains(id) { return .Err }\n        slot := i32(id.index)\n        entry := self.slot_to_entry[slot]\n        last := self.entries.len - 1\n        self.entries.swap(entry, last)\n        popped := self.entries.pop()\n        if entry < last {\n            moved_slot := self.entries[entry].slot\n            self.slot_to_entry[moved_slot] = entry\n        }\n        self.slot_to_entry[slot] = -1\n        mut next_gen := self.gens[slot].wrapping_add(u32(1))\n        if next_gen == u32(0) { next_gen = u32(1) }\n        self.gens[slot] = next_gen\n        self.free_next[slot] = self.free_head\n        self.free_head = slot\n        .Ok(popped.value)\n    }\n\n    pub fn clear(&mut self) {\n        self.entries.clear()\n        self.free_head = -1\n        for slot in 0..self.slot_to_entry.len {\n            self.slot_to_entry[slot] = -1\n            mut next_gen := self.gens[slot].wrapping_add(u32(1))\n            if next_gen == u32(0) { next_gen = u32(1) }\n            self.gens[slot] = next_gen\n            self.free_next[slot] = self.free_head\n            self.free_head = slot\n        }\n    }\n}\n\nimpl Default for Pool<T> where T: Storable {\n    fn default() -> Self { Self::new() }\n}\n\nimpl Sendable for Pool<T> where T: Storable + Sendable {}\n" }
    if name == "array" { return "pub fn ints() -> []i64 { [] }\npub fn strings() -> []string { [] }\n\npub fn sum(values: &[]i64) -> i64 {\n    mut result: i64 = 0\n    mut i := 0\n    while i + 4 <= values.len {\n        result = result + values[i] + values[i + 1] + values[i + 2] + values[i + 3]\n        i = i + 4\n    }\n    while i < values.len {\n        result = result + values[i]\n        i = i + 1\n    }\n    result\n}\n\npub fn swap_remove<T: Storable>(values: &mut []T, index: i32) -> T {\n    values.swap(index, values.len - 1)\n    values.pop()\n}\n\n@test fn swap_remove_transfers_the_element_and_fills_the_gap() {\n    mut names: []string = [\"a\", \"b\", \"c\", \"d\"]\n    assert(swap_remove(&mut names, 1) == \"b\" && names == [\"a\", \"d\", \"c\"])\n    assert(swap_remove(&mut names, 2) == \"c\" && names == [\"a\", \"d\"])\n    assert(swap_remove(&mut names, 0) == \"a\" && names == [\"d\"])\n    assert(swap_remove(&mut names, 0) == \"d\" && names.len == 0)\n}\n\npub fn reverse<T: Storable>(values: &mut []T) {\n    if values.len <= 1 { return }\n    mut left := 0\n    mut right := values.len - 1\n    while left < right {\n        values.swap(left, right)\n        left += 1\n        right -= 1\n    }\n}\n\nfn insertion_sort<T: Ord + Storable>(values: &mut []T, low: i32, high: i32) {\n    mut i := low + 1\n    while i < high {\n        mut j := i\n        while j > low && values[j - 1].cmp(values[j]) == Ordering.Greater {\n            values.swap(j - 1, j)\n            j -= 1\n        }\n        i += 1\n    }\n}\n\nfn sift_down<T: Ord + Storable>(values: &mut []T, low: i32, start: i32, count: i32) {\n    mut root := start\n    half := count / 2\n    while root < half {\n        mut child := root * 2 + 1\n        if child + 1 < count && values[low + child].cmp(values[low + child + 1]) == Ordering.Less {\n            child += 1\n        }\n        if values[low + root].cmp(values[low + child]) != Ordering.Less { return }\n        values.swap(low + root, low + child)\n        root = child\n    }\n}\n\nfn heapsort<T: Ord + Storable>(values: &mut []T, low: i32, high: i32) {\n    count := high - low\n    if count <= 1 { return }\n    mut start := count / 2\n    while start > 0 {\n        start -= 1\n        sift_down<T>(&mut values, low, start, count)\n    }\n    mut end := count\n    while end > 1 {\n        end -= 1\n        values.swap(low, low + end)\n        sift_down<T>(&mut values, low, 0, end)\n    }\n}\n\nfn partition<T: Ord + Storable>(values: &mut []T, low: i32, high: i32) -> i32 {\n    mid := low + (high - low) / 2\n    last := high - 1\n    if values[low].cmp(values[mid]) == Ordering.Greater { values.swap(low, mid) }\n    if values[mid].cmp(values[last]) == Ordering.Greater {\n        values.swap(mid, last)\n        if values[low].cmp(values[mid]) == Ordering.Greater { values.swap(low, mid) }\n    }\n    pivot := last - 1\n    values.swap(mid, pivot)\n    mut i := low\n    mut j := pivot\n    while true {\n        i += 1\n        while values[i].cmp(values[pivot]) == Ordering.Less { i += 1 }\n        j -= 1\n        while j > low && values[j].cmp(values[pivot]) == Ordering.Greater { j -= 1 }\n        if i >= j { break }\n        values.swap(i, j)\n    }\n    values.swap(i, pivot)\n    i\n}\n\nfn introsort<T: Ord + Storable>(values: &mut []T, low_start: i32, high_end: i32, depth_limit: i32) {\n    mut low := low_start\n    mut high := high_end\n    mut depth := depth_limit\n    while high - low > 24 {\n        if depth <= 0 {\n            heapsort<T>(&mut values, low, high)\n            return\n        }\n        depth -= 1\n        pivot := partition<T>(&mut values, low, high)\n        if pivot - low < high - (pivot + 1) {\n            introsort<T>(&mut values, low, pivot, depth)\n            low = pivot + 1\n        } else {\n            introsort<T>(&mut values, pivot + 1, high, depth)\n            high = pivot\n        }\n    }\n    insertion_sort<T>(&mut values, low, high)\n}\n\npub fn sort<T: Ord + Storable>(values: &mut []T) {\n    if values.len <= 1 { return }\n    mut depth := 0\n    mut span := values.len\n    while span > 1 { span /= 2; depth += 2 }\n    introsort<T>(&mut values, 0, values.len, depth)\n}\n\nfn insertion_sort_by<T: Storable>(values: &mut []T, low: i32, high: i32, compare: &Fn(&T, &T) -> Ordering) {\n    mut i := low + 1\n    while i < high {\n        mut j := i\n        while j > low && compare(values[j - 1], values[j]) == Ordering.Greater {\n            values.swap(j - 1, j)\n            j -= 1\n        }\n        i += 1\n    }\n}\n\nfn sift_down_by<T: Storable>(values: &mut []T, low: i32, start: i32, count: i32, compare: &Fn(&T, &T) -> Ordering) {\n    mut root := start\n    half := count / 2\n    while root < half {\n        mut child := root * 2 + 1\n        if child + 1 < count && compare(values[low + child], values[low + child + 1]) == Ordering.Less {\n            child += 1\n        }\n        if compare(values[low + root], values[low + child]) != Ordering.Less { return }\n        values.swap(low + root, low + child)\n        root = child\n    }\n}\n\nfn heapsort_by<T: Storable>(values: &mut []T, low: i32, high: i32, compare: &Fn(&T, &T) -> Ordering) {\n    count := high - low\n    if count <= 1 { return }\n    mut start := count / 2\n    while start > 0 {\n        start -= 1\n        sift_down_by<T>(&mut values, low, start, count, compare)\n    }\n    mut end := count\n    while end > 1 {\n        end -= 1\n        values.swap(low, low + end)\n        sift_down_by<T>(&mut values, low, 0, end, compare)\n    }\n}\n\nfn partition_by<T: Storable>(values: &mut []T, low: i32, high: i32, compare: &Fn(&T, &T) -> Ordering) -> i32 {\n    mid := low + (high - low) / 2\n    last := high - 1\n    if compare(values[low], values[mid]) == Ordering.Greater { values.swap(low, mid) }\n    if compare(values[mid], values[last]) == Ordering.Greater {\n        values.swap(mid, last)\n        if compare(values[low], values[mid]) == Ordering.Greater { values.swap(low, mid) }\n    }\n    pivot := last - 1\n    values.swap(mid, pivot)\n    mut i := low\n    mut j := pivot\n    while true {\n        i += 1\n        while compare(values[i], values[pivot]) == Ordering.Less { i += 1 }\n        j -= 1\n        while j > low && compare(values[j], values[pivot]) == Ordering.Greater { j -= 1 }\n        if i >= j { break }\n        values.swap(i, j)\n    }\n    values.swap(i, pivot)\n    i\n}\n\nfn introsort_by<T: Storable>(values: &mut []T, low_start: i32, high_end: i32, depth_limit: i32, compare: &Fn(&T, &T) -> Ordering) {\n    mut low := low_start\n    mut high := high_end\n    mut depth := depth_limit\n    while high - low > 24 {\n        if depth <= 0 {\n            heapsort_by<T>(&mut values, low, high, compare)\n            return\n        }\n        depth -= 1\n        pivot := partition_by<T>(&mut values, low, high, compare)\n        if pivot - low < high - (pivot + 1) {\n            introsort_by<T>(&mut values, low, pivot, depth, compare)\n            low = pivot + 1\n        } else {\n            introsort_by<T>(&mut values, pivot + 1, high, depth, compare)\n            high = pivot\n        }\n    }\n    insertion_sort_by<T>(&mut values, low, high, compare)\n}\n\npub fn sort_by<T: Storable>(values: &mut []T, compare: &Fn(&T, &T) -> Ordering) {\n    if values.len <= 1 { return }\n    mut depth := 0\n    mut span := values.len\n    while span > 1 { span /= 2; depth += 2 }\n    introsort_by<T>(&mut values, 0, values.len, depth, compare)\n}\n\npub fn is_sorted<T: Ord + Storable>(values: &[]T) -> bool {\n    mut i := 1\n    while i < values.len {\n        if values[i - 1].cmp(values[i]) == Ordering.Greater { return false }\n        i += 1\n    }\n    true\n}\n\npub fn binary_search<T: Ord + Storable>(values: &[]T, target: &T) -> Result<i32, i32> {\n    mut low := 0\n    mut high := values.len\n    while low < high {\n        mid := low + (high - low) / 2\n        ord := values[mid].cmp(target)\n        if ord == Ordering.Less { low = mid + 1 }\n        else if ord == Ordering.Greater { high = mid }\n        else { return .Ok(mid) }\n    }\n    .Err(low)\n}\n\npub fn contains<T: Eq + Storable>(values: &[]T, target: &T) -> bool {\n    index_of<T>(&values, target).is_some()\n}\n\npub fn index_of<T: Eq + Storable>(values: &[]T, target: &T) -> Option<i32> {\n    for i in 0..values.len {\n        if values[i].eq(target) { return .Some(i) }\n    }\n    .None\n}\n\npub fn equal<T: Eq + Storable>(lhs: &[]T, rhs: &[]T) -> bool {\n    if lhs.len != rhs.len { return false }\n    for i in 0..lhs.len {\n        if !lhs[i].eq(rhs[i]) { return false }\n    }\n    true\n}\n\npub fn min_index<T: Ord + Storable>(values: &[]T) -> Option<i32> {\n    if values.len == 0 { return .None }\n    mut best := 0\n    for i in 1..values.len {\n        if values[i].cmp(values[best]) == Ordering.Less { best = i }\n    }\n    .Some(best)\n}\n\npub fn max_index<T: Ord + Storable>(values: &[]T) -> Option<i32> {\n    if values.len == 0 { return .None }\n    mut best := 0\n    for i in 1..values.len {\n        if values[i].cmp(values[best]) == Ordering.Greater { best = i }\n    }\n    .Some(best)\n}\n\npub fn dedup<T: Eq + Storable>(values: &mut []T) {\n    if values.len <= 1 { return }\n    mut write := 1\n    for read in 1..values.len {\n        if !values[read].eq(values[write - 1]) {\n            if write != read { values.swap(write, read) }\n            write += 1\n        }\n    }\n    while values.len > write { _ := values.pop() }\n}\n\npub fn append<T: Clone + Storable>(values: &mut []T, extra: &[]T) {\n    values.reserve(values.len + extra.len)\n    for i in 0..extra.len { values.push(extra[i].clone()) }\n}\n\npub fn fill<T: Clone + Storable>(values: &mut []T, value: &T) {\n    for i in 0..values.len { values[i] = value.clone() }\n}\n\npub fn resize<T: Clone + Storable>(values: &mut []T, new_len: i32, value: &T) {\n    assert(new_len >= 0)\n    while values.len > new_len { _ := values.pop() }\n    values.reserve(new_len)\n    while values.len < new_len { values.push(value.clone()) }\n}\n\npub fn join<T: Display + Storable>(values: &[]T, sep: string) -> string {\n    mut out := \"\"\n    for i in 0..values.len {\n        if i > 0 { out += sep }\n        out += values[i].str()\n    }\n    out\n}\n\nfn desc_i64(a: &i64, b: &i64) -> Ordering { b.cmp(a) }\n\n@test fn dynamic_algorithms_preserve_independent_values() {\n    mut values: []i64 = [3, -1, 9, 0, 3]\n    copy := values.clone()\n    sort<i64>(&mut values)\n    assert(values[0] == -1 && values[4] == 9)\n    assert(is_sorted<i64>(&values))\n    reverse<i64>(&mut values)\n    assert(values[0] == 9)\n    assert(!is_sorted<i64>(&values))\n    assert(sum(&values) == 14)\n    append<i64>(&mut values, &copy)\n    assert(values.len == 10 && sum(&values) == 28 && copy[0] == 3)\n}\n\n@test fn string_sort_handles_empty_values_unicode_duplicates_and_copies() {\n    mut values: []string = [\"🌍\", \"å\", \"\", \"a\", \"a\", \"\\0\", \"ä\"]\n    original := values.clone()\n    sort<string>(&mut values)\n    assert(values == [\"\", \"\\0\", \"a\", \"a\", \"ä\", \"å\", \"🌍\"])\n    assert(original[0] == \"🌍\")\n    assert(contains<string>(&values, \"å\"))\n    assert(index_of<string>(&values, \"a\") == .Some(2))\n    assert(index_of<string>(&values, \"missing\") == .None)\n    assert(join<string>(&[\"x\", \"y\", \"z\"], \",\") == \"x,y,z\")\n    dedup<string>(&mut values)\n    assert(values == [\"\", \"\\0\", \"a\", \"ä\", \"å\", \"🌍\"])\n    mut empty: []string = []\n    sort<string>(&mut empty)\n    assert(empty.len == 0)\n    mut one: []string = [\"one\"]\n    sort<string>(&mut one)\n    assert(one[0] == \"one\")\n}\n\n@test fn integer_sort_and_search_cover_boundaries_and_compounds() {\n    mut empty: []i64 = []\n    sort<i64>(&mut empty)\n    assert(empty.len == 0 && min_index<i64>(&empty) == .None && max_index<i64>(&empty) == .None)\n    mut one: []i64 = [-9223372036854775808]\n    sort<i64>(&mut one)\n    assert(one.len == 1 && one[0] == -9223372036854775808)\n\n    mut values: []i64 = [9223372036854775807, 0, -1, -9223372036854775808, 1, 0]\n    expected: []i64 = [-9223372036854775808, -1, 0, 0, 1, 9223372036854775807]\n    sort<i64>(&mut values)\n    assert(equal<i64>(&values, &expected))\n    assert(min_index<i64>(&values) == .Some(0) && max_index<i64>(&values) == .Some(5))\n    assert(binary_search<i64>(&values, 1) == .Ok(4))\n    assert(binary_search<i64>(&values, 2) == .Err(5))\n    sort_by<i64>(&mut values, desc_i64)\n    assert(values[0] == 9223372036854775807 && values[5] == -9223372036854775808)\n\n    mut descending: []i64 = []\n    for i in 0..4097 { descending.push(i64(2048 - i)) }\n    sort<i64>(&mut descending)\n    assert(is_sorted<i64>(&descending))\n    for i in 0..descending.len { assert(descending[i] == i64(i - 2048)) }\n\n    mut pairs: [](i32, string) = [(2, \"b\"), (1, \"b\"), (1, \"a\")]\n    sort<(i32, string)>(&mut pairs)\n    assert(pairs == [(1, \"a\"), (1, \"b\"), (2, \"b\")])\n\n    mut filled: []i32 = [1, 2]\n    resize<i32>(&mut filled, 4, 9)\n    assert(filled == [1, 2, 9, 9])\n    fill<i32>(&mut filled, 5)\n    assert(filled == [5, 5, 5, 5])\n    assert(join<i32>(&filled, \"-\") == \"5-5-5-5\")\n}\n" }
    if name == "base64" { return "import std.bytes as bytes\n\npub struct DecodeResult { ok: bool, value: []u8, error: string }\n\nfn fail(message: string) -> DecodeResult {\n    DecodeResult { ok: false, value: [], error: message.clone() }\n}\n\nfn encode_inner(input: &[]u8, url_safe: bool, pad: bool) -> string {\n    if input.len == 0 { return \"\" }\n    assert(input.len <= 25165824)\n    alpha := if url_safe {\n        \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\"\n    } else {\n        \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n    }\n    mut out: []u8 = []\n    out.reserve(((input.len + 2) / 3) * 4)\n    mut i := 0\n    while i < input.len {\n        rem := input.len - i\n        b0 := i32(input[i])\n        b1 := if rem > 1 { i32(input[i + 1]) } else { 0 }\n        b2 := if rem > 2 { i32(input[i + 2]) } else { 0 }\n        triple := b0.shl(16).bit_or(b1.shl(8)).bit_or(b2)\n        out.push(u8(alpha[triple.shr(18).bit_and(63)]))\n        out.push(u8(alpha[triple.shr(12).bit_and(63)]))\n        if rem > 1 {\n            out.push(u8(alpha[triple.shr(6).bit_and(63)]))\n        } else if pad {\n            out.push(b'=')\n        }\n        if rem > 2 {\n            out.push(u8(alpha[triple.bit_and(63)]))\n        } else if pad {\n            out.push(b'=')\n        }\n        i += 3\n    }\n    bytes.decode(&out).unwrap()\n}\n\npub fn encode(input: &[]u8) -> string { encode_inner(&input, false, true) }\npub fn encode_no_pad(input: &[]u8) -> string { encode_inner(&input, false, false) }\npub fn encode_url(input: &[]u8) -> string { encode_inner(&input, true, true) }\npub fn encode_url_no_pad(input: &[]u8) -> string { encode_inner(&input, true, false) }\n\nfn sextet(raw: u8, url_safe: bool) -> i32 {\n    c := i32(raw)\n    if c >= 65 && c <= 90 { return c - 65 }\n    if c >= 97 && c <= 122 { return c - 71 }\n    if c >= 48 && c <= 57 { return c + 4 }\n    if url_safe {\n        if c == 45 { return 62 }\n        if c == 95 { return 63 }\n    } else {\n        if c == 43 { return 62 }\n        if c == 47 { return 63 }\n    }\n    -1\n}\n\nfn decode_inner(input: string, url_safe: bool) -> DecodeResult {\n    if input.len == 0 { return DecodeResult { ok: true, value: [], error: \"\" } }\n    if input.len > 33554432 { return fail(\"base64 input exceeds its limit\") }\n    mut pad := 0\n    if input[input.len - 1] == 61 {\n        if input.len % 4 != 0 { return fail(\"invalid base64 padding\") }\n        pad = 1\n        if input.len >= 2 && input[input.len - 2] == 61 { pad = 2 }\n    }\n    data_len := input.len - pad\n    if data_len % 4 == 1 { return fail(\"invalid base64 length\") }\n    mut out: []u8 = []\n    out.reserve((data_len / 4) * 3 + 3)\n    mut i := 0\n    while i + 4 <= data_len {\n        a := sextet(input[i], url_safe)\n        b := sextet(input[i + 1], url_safe)\n        c := sextet(input[i + 2], url_safe)\n        d := sextet(input[i + 3], url_safe)\n        if a < 0 || b < 0 || c < 0 || d < 0 { return fail(\"invalid base64 character\") }\n        out.push(u8(a.shl(2).bit_or(b.shr(4))))\n        out.push(u8(b.bit_and(15).shl(4).bit_or(c.shr(2))))\n        out.push(u8(c.bit_and(3).shl(6).bit_or(d)))\n        i += 4\n    }\n    rem := data_len - i\n    if rem == 2 {\n        a := sextet(input[i], url_safe)\n        b := sextet(input[i + 1], url_safe)\n        if a < 0 || b < 0 { return fail(\"invalid base64 character\") }\n        if b.bit_and(15) != 0 { return fail(\"non-canonical base64 trailing bits\") }\n        out.push(u8(a.shl(2).bit_or(b.shr(4))))\n    } else if rem == 3 {\n        a := sextet(input[i], url_safe)\n        b := sextet(input[i + 1], url_safe)\n        c := sextet(input[i + 2], url_safe)\n        if a < 0 || b < 0 || c < 0 { return fail(\"invalid base64 character\") }\n        if c.bit_and(3) != 0 { return fail(\"non-canonical base64 trailing bits\") }\n        out.push(u8(a.shl(2).bit_or(b.shr(4))))\n        out.push(u8(b.bit_and(15).shl(4).bit_or(c.shr(2))))\n    }\n    DecodeResult { ok: true, value: out, error: \"\" }\n}\n\npub fn decode(input: string) -> DecodeResult { decode_inner(input, false) }\npub fn decode_url(input: string) -> DecodeResult { decode_inner(input, true) }\n\n@test fn rfc4648_test_vectors_and_round_trips() {\n    vectors: [](string, string, string) = [\n        (\"\", \"\", \"\"),\n        (\"f\", \"Zg==\", \"Zg\"),\n        (\"fo\", \"Zm8=\", \"Zm8\"),\n        (\"foo\", \"Zm9v\", \"Zm9v\"),\n        (\"foob\", \"Zm9vYg==\", \"Zm9vYg\"),\n        (\"fooba\", \"Zm9vYmE=\", \"Zm9vYmE\"),\n        (\"foobar\", \"Zm9vYmFy\", \"Zm9vYmFy\"),\n    ]\n    for entry in vectors {\n        raw := bytes.from_text(entry.0)\n        assert(encode(&raw) == entry.1)\n        assert(encode_no_pad(&raw) == entry.2)\n        assert(encode_url(&raw) == entry.1)\n        assert(encode_url_no_pad(&raw) == entry.2)\n        d1 := decode(entry.1)\n        assert(d1.ok && bytes.equal(&d1.value, &raw))\n        d2 := decode(entry.2)\n        assert(d2.ok && bytes.equal(&d2.value, &raw))\n        d3 := decode_url(entry.1)\n        assert(d3.ok && bytes.equal(&d3.value, &raw))\n        d4 := decode_url(entry.2)\n        assert(d4.ok && bytes.equal(&d4.value, &raw))\n    }\n\n    binary: []u8 = [0xfb, 0xff, 0xbf, 0x00, 0xfe]\n    assert(encode(&binary) == \"+/+/\" + \"AP4=\")\n    assert(encode_no_pad(&binary) == \"+/+/\" + \"AP4\")\n    assert(encode_url(&binary) == \"-_-_\" + \"AP4=\")\n    assert(encode_url_no_pad(&binary) == \"-_-_\" + \"AP4\")\n\n    std_dec := decode(\"+/+/\" + \"AP4=\")\n    assert(std_dec.ok && bytes.equal(&std_dec.value, &binary))\n    url_dec := decode_url(\"-_-_\" + \"AP4\")\n    assert(url_dec.ok && bytes.equal(&url_dec.value, &binary))\n\n    // Alphabet separation\n    assert(!decode(\"-_-_AP4=\").ok)\n    assert(!decode_url(\"+/+/AP4=\").ok)\n\n    // Invalid lengths, padding, characters, and non-zero trailing bits\n    assert(!decode(\"A\").ok)\n    assert(!decode(\"AAAAA\").ok)\n    assert(!decode(\"==\").ok)\n    assert(!decode(\"====\").ok)\n    assert(!decode(\"A===\").ok)\n    assert(!decode(\"AA=\").ok)\n    assert(!decode(\"AA=A\").ok)\n    assert(!decode(\"AA==\").ok == false && decode(\"AA==\").value[0] == 0)\n    assert(!decode(\"AB==\").ok)\n    assert(!decode(\"AAB=\").ok)\n    assert(!decode(\"Zm 9v\").ok)\n    assert(!decode_url(\"AB==\").ok)\n    assert(!decode_url(\"AAB=\").ok)\n}\n" }
    if name == "bytes" { return "capability unsafe\n\nimport sys\nimport std.bytes.utf8 as utf8\npub fn packed() -> []u8 { [] }\npub fn from_text(text: string) -> []u8 {\n    mut output: []u8 = []\n    output.reserve(text.len)\n    append_utf8(&mut output, text)\n    output\n}\npub fn from_i32(input: &[]i32) -> []u8 {\n    mut output: []u8 = []\n    output.reserve(input.len)\n    for byte in &input {\n        assert(byte >= 0 && byte <= 255)\n        output.push(u8(byte))\n    }\n    output\n}\npub fn to_i32(input: &[]u8) -> []i32 {\n    mut output: []i32 = []\n    output.reserve(input.len)\n    for byte in &input { output.push(i32(byte)) }\n    output\n}\npub fn append_utf8(output: &mut []u8, text: string) {\n    sys.bytes_append_text(&mut output, text)\n}\npub fn extend(output: &mut []u8, input: &[]u8) {\n    sys.bytes_extend(&mut output, &input, 0, input.len)\n}\n@thread_safe\npub unsafe fn copy_memory(destination: ptr, source: ptr, count: usize) { sys.memory_copy(destination, source, count) }\n@thread_safe\npub unsafe fn equal_memory(lhs: ptr, rhs: ptr, count: usize) -> bool { sys.memory_equal(lhs, rhs, count) }\n@thread_safe\npub unsafe fn zero_memory(destination: ptr, count: usize) { sys.memory_zero(destination, count) }\n@thread_safe\npub fn equal(lhs: &[]u8, rhs: &[]u8) -> bool {\n    sys.bytes_equal(&lhs, &rhs)\n}\n@thread_safe\npub fn equal_ranges(lhs: &[]u8, lstart: i32, lend: i32, rhs: &[]u8, rstart: i32, rend: i32) -> bool {\n    if lstart < 0 || lend < lstart || lend > lhs.len || rstart < 0 || rend < rstart || rend > rhs.len { return false }\n    equal(&lhs[lstart..lend], &rhs[rstart..rend])\n}\npub fn pad(output: &mut []u8, count: i32) {\n    assert(count >= 0)\n    output.reserve(output.len + count)\n    for i in 0..count { output.push(0) }\n}\npub fn append_le(output: &mut []u8, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8)\n    for i in 0..width { output.push(u8(value.shr(i * 8).bit_and(255))) }\n}\npub fn append_be(output: &mut []u8, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8)\n    for i in 0..width { output.push(u8(value.shr((width - 1 - i) * 8).bit_and(255))) }\n}\npub fn set_be(output: &mut []u8, offset: i32, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8 && offset >= 0 && offset <= output.len - width)\n    for i in 0..width { output[offset + width - 1 - i] = u8(value.shr(i * 8).bit_and(255)) }\n}\npub fn decode(input: &[]u8) -> Result<string, sys.IoError> { utf8.decode(&input) }\npub fn decode_range(input: &[]u8, start: i32, end: i32) -> Result<string, sys.IoError> {\n    utf8.decode_range(&input, start, end)\n}\npub fn find_byte(input: &[]u8, start: i32, end: i32, needle: u8) -> Option<i32> {\n    mut from := start\n    if from < 0 { from = 0 }\n    mut limit := end\n    if limit > input.len { limit = input.len }\n    if from >= limit { return .None }\n    for i in from..limit {\n        if input[i] == needle { return .Some(i) }\n    }\n    .None\n}\npub fn find_crlf(input: &[]u8, start: i32, end: i32) -> Option<i32> {\n    mut from := start\n    if from < 0 { from = 0 }\n    mut limit := end\n    if limit > input.len { limit = input.len }\n    if limit - from < 2 { return .None }\n    for i in from..(limit - 1) {\n        if input[i] == b'\\r' && input[i + 1] == b'\\n' { return .Some(i) }\n    }\n    .None\n}\npub fn find_double_crlf(input: &[]u8, start: i32, end: i32) -> Option<i32> {\n    mut from := start\n    if from < 0 { from = 0 }\n    mut limit := end\n    if limit > input.len { limit = input.len }\n    if limit - from < 4 { return .None }\n    for i in from..(limit - 3) {\n        if input[i] == b'\\r' && input[i + 1] == b'\\n' && input[i + 2] == b'\\r' && input[i + 3] == b'\\n' {\n            return .Some(i)\n        }\n    }\n    .None\n}\npub fn equals_text(input: &[]u8, start: i32, end: i32, expected: string) -> bool {\n    if start < 0 || end < start || end > input.len || end - start != expected.len { return false }\n    for i in 0..expected.len {\n        if i32(input[start + i]) != i32(expected[i]) { return false }\n    }\n    true\n}\npub fn equals_ascii_ci(input: &[]u8, start: i32, end: i32, expected_lower: string) -> bool {\n    if start < 0 || end < start || end > input.len || end - start != expected_lower.len { return false }\n    for i in 0..expected_lower.len {\n        mut b := i32(input[start + i])\n        if b >= 65 && b <= 90 { b += 32 }\n        if b != i32(expected_lower[i]) { return false }\n    }\n    true\n}\npub fn extend_range(output: &mut []u8, input: &[]u8, start: i32, end: i32) {\n    assert(start >= 0 && start <= end && end <= input.len)\n    sys.bytes_extend(&mut output, &input, start, end)\n}\npub fn consume_prefix(buf: &mut []u8, count: i32) {\n    if count <= 0 { return }\n    if count >= buf.len { buf.clear(); return }\n    remaining := buf.len - count\n    for i in 0..remaining { buf[i] = buf[i + count] }\n    buf.truncate(remaining)\n}\npub fn append_decimal(output: &mut []u8, value: i64) {\n    if value == 0 { output.push(b'0'); return }\n    mut v := value\n    if v < 0 { output.push(b'-') }\n    start := output.len\n    while v != 0 {\n        mut d := v % 10\n        if d < 0 { d = -d }\n        output.push(u8(48 + i32(d)))\n        v /= 10\n    }\n    mut left := start\n    mut right := output.len - 1\n    while left < right {\n        output.swap(left, right)\n        left += 1\n        right -= 1\n    }\n}\n\npub fn hex_u8(input: &[]u8) -> string {\n    digits := \"0123456789abcdef\"\n    mut output: []u8 = []\n    output.reserve(input.len * 2)\n    for b in &input {\n        val := i32(b)\n        output.push(u8(digits[val / 16]))\n        output.push(u8(digits[val % 16]))\n    }\n    decode(&output).unwrap()\n}\npub fn u16_le(input: &[]u8, offset: i32) -> i32 {\n    assert(offset >= 0 && offset <= input.len - 2)\n    i32(input[offset]).bit_or(i32(input[offset + 1]).shl(8))\n}\npub fn u32_le(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 4)\n    a := i64(input[offset]).bit_or(i64(input[offset + 1]).shl(8))\n    b := i64(input[offset + 2]).shl(16).bit_or(i64(input[offset + 3]).shl(24))\n    a.bit_or(b)\n}\nfn signed_word(raw: i64) -> i32 {\n    if raw >= 2147483648 { return i32(raw - 4294967296) }\n    i32(raw)\n}\npub fn i32_le(input: &[]u8, offset: i32) -> i32 {\n    signed_word(u32_le(&input, offset))\n}\n@test fn signed_little_endian_words_preserve_the_high_bit() {\n    data: []u8 = [42, 0, 0, 0, 128, 255, 255, 255, 255, 255, 255, 255, 127]\n    assert(i32_le(&data, 1) == -2147483648)\n    assert(i32_le(&data, 5) == -1 && i32_le(&data, 9) == 2147483647)\n}\npub fn i64_le(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: i64 = 0\n    for i in 0..8 {\n        v = v.bit_or(i64(input[offset + i]).shl(i * 8))\n    }\n    v\n}\npub fn u64_le(input: &[]u8, offset: i32) -> u64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: u64 = 0\n    for i in 0..8 {\n        v = v.bit_or(u64(input[offset + i]).shl(i * 8))\n    }\n    v\n}\npub fn u16_be(input: &[]u8, offset: i32) -> i32 {\n    assert(offset >= 0 && offset <= input.len - 2)\n    i32(input[offset]).shl(8).bit_or(i32(input[offset + 1]))\n}\npub fn i16_be(input: &[]u8, offset: i32) -> i32 {\n    raw := u16_be(&input, offset)\n    if raw >= 32768 { return raw - 65536 }\n    raw\n}\npub fn u32_be(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 4)\n    a := i64(input[offset]).shl(24).bit_or(i64(input[offset + 1]).shl(16))\n    b := i64(input[offset + 2]).shl(8).bit_or(i64(input[offset + 3]))\n    a.bit_or(b)\n}\npub fn i32_be(input: &[]u8, offset: i32) -> i32 {\n    signed_word(u32_be(&input, offset))\n}\npub fn i64_be(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: i64 = 0\n    for i in 0..8 {\n        v = v.bit_or(i64(input[offset + i]).shl((7 - i) * 8))\n    }\n    v\n}\npub fn u64_be(input: &[]u8, offset: i32) -> u64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: u64 = 0\n    for i in 0..8 {\n        v = v.bit_or(u64(input[offset + i]).shl((7 - i) * 8))\n    }\n    v\n}\n\npub fn hex(input: &[]u8) -> string {\n    hex_u8(&input)\n}\n\n@test fn utf8_decode_distinguishes_invalid_bounds_and_encoding() {\n    empty: []u8 = []\n    assert(decode(&empty) == .Ok(\"\"))\n    raw := from_text(\"å🌍\")\n    assert(decode(&raw) == .Ok(\"å🌍\"))\n    assert(decode_range(&raw, 2, 6) == .Ok(\"🌍\"))\n    assert(decode_range(&raw, 0, 0) == .Ok(\"\"))\n    assert(decode_range(&raw, 6, 6) == .Ok(\"\"))\n    assert(decode_range(&raw, 1, 2) == .Err(.InvalidUtf8))\n    assert(decode_range(&raw, 0, 5) == .Err(.InvalidUtf8))\n    malformed: []u8 = [255]\n    assert(decode(&malformed) == .Err(.InvalidUtf8))\n    assert(decode_range(&malformed, 0, 2) == .Err(.InvalidArgument))\n}\n\n@test fn byte_equality_covers_empty_values_word_tails_and_each_mismatch_position() {\n    empty: []u8 = []\n    assert(equal(&empty, &empty))\n    for length in [1, 2, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128, 129] {\n        mut lhs: []u8 = []\n        for i in 0..length { lhs.push(u8((i * 29 + 197) % 256)) }\n        same := lhs.clone()\n        assert(equal(&lhs, &same))\n        assert(!equal(&lhs, &empty) && !equal(&empty, &lhs))\n        for position in [0, length / 2, length - 1] {\n            mut different := lhs.clone()\n            different[position] = u8(255 - i32(different[position]))\n            assert(!equal(&lhs, &different))\n        }\n        mut left: []u8 = [11]\n        mut right: []u8 = [22, 33]\n        for i in 0..length { left.push(lhs[i]); right.push(lhs[i]) }\n        assert(equal_ranges(&left, 1, left.len, &right, 2, right.len))\n        right[right.len - 1] = u8(255 - i32(right[right.len - 1]))\n        assert(!equal_ranges(&left, 1, left.len, &right, 2, right.len))\n    }\n}\n\n@test fn byte_range_equality_rejects_invalid_bounds_before_taking_addresses() {\n    empty: []u8 = []; data: []u8 = [0, 255, 127, 42]\n    assert(equal_ranges(&empty, 0, 0, &empty, 0, 0))\n    assert(equal_ranges(&data, data.len, data.len, &empty, 0, 0))\n    assert(equal_ranges(&empty, 0, 0, &data, 2, 2))\n    assert(!equal_ranges(&data, 0, 1, &empty, 0, 0))\n    assert(!equal_ranges(&data, -1, 0, &data, 0, 1))\n    assert(!equal_ranges(&data, 2, 1, &data, 0, 1))\n    assert(!equal_ranges(&data, 0, 5, &data, 0, 5))\n    assert(!equal_ranges(&data, 0, 1, &data, -1, 0))\n    assert(!equal_ranges(&data, 0, 1, &data, 2, 1))\n    assert(!equal_ranges(&data, 0, 4, &data, 0, 5))\n    assert(!equal_ranges(&data, 0, 1, &data, 0, 2))\n    assert(!equal_ranges(&empty, -1, -1, &empty, 0, 0))\n    assert(!equal_ranges(&empty, 0, 0, &empty, 1, 1))\n    assert(!equal_ranges(&data, -2147483648, 2147483647, &data, 0, 4))\n    assert(!equal_ranges(&data, 0, 4, &data, -2147483648, 2147483647))\n}\n\n@test fn raw_byte_copy_handles_overlap_both_directions_without_touching_neighbors() {\n    mut buffer: [u8; 33] = [0; 33]\n    for i in 0..33 { buffer[i] = u8(i) }\n    unsafe {\n        base := addr(&mut buffer[0])\n        copy_memory(ptr(usize(base) + 3), base, usize(25))\n    }\n    for i in 0..3 { assert(buffer[i] == u8(i)) }\n    for i in 0..25 { assert(buffer[i + 3] == u8(i)) }\n    for i in 28..33 { assert(buffer[i] == u8(i)) }\n    for i in 0..33 { buffer[i] = u8(i) }\n    unsafe {\n        base := addr(&mut buffer[0])\n        copy_memory(base, ptr(usize(base) + 3), usize(25))\n        copy_memory(base, base, usize(33))\n        assert(equal_memory(base, base, usize(33)))\n        copy_memory(ptr(0), ptr(0), usize(0))\n        assert(equal_memory(ptr(0), ptr(0), usize(0)))\n    }\n    for i in 0..25 { assert(buffer[i] == u8(i + 3)) }\n    for i in 25..33 { assert(buffer[i] == u8(i)) }\n}\n\n@test fn buffer_extensions_preserve_prefixes_binary_values_and_utf8_bytes() {\n    mut output: []u8 = [0, 255]\n    append_utf8(&mut output, \"A\\0å雪\")\n    assert(hex_u8(&output) == \"00ff4100c3a5e99baa\")\n    source: []u8 = [17, 0, 255, 128, 34]\n    extend_range(&mut output, &source, 1, 4)\n    assert(hex_u8(&output) == \"00ff4100c3a5e99baa00ff80\")\n    empty: []u8 = []\n    extend(&mut output, &empty)\n    extend_range(&mut output, &source, source.len, source.len)\n    append_utf8(&mut output, \"\")\n    assert(output.len == 12)\n    extend(&mut output, &source)\n    assert(hex_u8(&output) == \"00ff4100c3a5e99baa00ff801100ff8022\")\n    for length in [1, 7, 8, 9, 31, 32, 33, 127, 128, 129] {\n        mut input: []u8 = []\n        for i in 0..length { input.push(u8(i % 256)) }\n        mut appended: []u8 = [0xaa]\n        extend(&mut appended, &input)\n        extend_range(&mut appended, &input, 0, input.len)\n        assert(appended.len == 1 + length * 2 && appended[0] == 0xaa)\n        for i in 0..length { assert(appended[i + 1] == u8(i % 256) && appended[i + length + 1] == u8(i % 256)) }\n    }\n}\n\n@test fn byte_encoding_is_explicit_and_round_trips_bits() {\n    mut output: []u8 = []\n    append_le(&mut output, 4278255360, 4)\n    hex_u8(&output) == \"00ff00ff\"\n    set_be(&mut output, 0, 16909060, 4)\n    hex_u8(&output) == \"01020304\"\n    output.clear()\n    append_le(&mut output, -1, 8)\n    hex_u8(&output) == \"ffffffffffffffff\"\n    output.clear()\n    append_utf8(&mut output, \"å\")\n    hex_u8(&output) == \"c3a5\"\n}\n@test fn big_endian_round_trips_and_boundaries() {\n    mut buf: []u8 = []\n    append_be(&mut buf, 0xab, 1)\n    append_be(&mut buf, 0, 2)\n    append_be(&mut buf, 65535, 2)\n    append_be(&mut buf, -32768, 2)\n    append_be(&mut buf, -1, 2)\n    append_be(&mut buf, 32767, 2)\n    append_be(&mut buf, 0x010203, 3)\n    append_be(&mut buf, 0, 4)\n    append_be(&mut buf, 4294967295, 4)\n    append_be(&mut buf, -2147483648, 4)\n    append_be(&mut buf, -1, 4)\n    append_be(&mut buf, 2147483647, 4)\n    append_be(&mut buf, 0, 8)\n    append_be(&mut buf, -9223372036854775808, 8)\n    append_be(&mut buf, 9223372036854775807, 8)\n    append_be(&mut buf, -1, 8)\n    append_be(&mut buf, 0x0102030405060708, 8)\n    assert(buf.len == 1 + 10 + 3 + 20 + 40)\n    assert(buf[0] == 0xab)\n\n    assert(u16_be(&buf, 1) == 0)\n    assert(i16_be(&buf, 1) == 0)\n    assert(u16_be(&buf, 3) == 65535)\n    assert(i16_be(&buf, 3) == -1)\n    assert(u16_be(&buf, 5) == 32768)\n    assert(i16_be(&buf, 5) == -32768)\n    assert(u16_be(&buf, 7) == 65535)\n    assert(i16_be(&buf, 7) == -1)\n    assert(u16_be(&buf, 9) == 32767)\n    assert(i16_be(&buf, 9) == 32767)\n\n    assert(buf[11] == 1 && buf[12] == 2 && buf[13] == 3)\n\n    assert(u32_be(&buf, 14) == 0)\n    assert(i32_be(&buf, 14) == 0)\n    assert(u32_be(&buf, 18) == 4294967295)\n    assert(i32_be(&buf, 18) == -1)\n    assert(u32_be(&buf, 22) == 2147483648)\n    assert(i32_be(&buf, 22) == -2147483648)\n    assert(u32_be(&buf, 26) == 4294967295)\n    assert(i32_be(&buf, 26) == -1)\n    assert(u32_be(&buf, 30) == 2147483647)\n    assert(i32_be(&buf, 30) == 2147483647)\n\n    assert(i64_be(&buf, 34) == 0)\n    assert(u64_be(&buf, 34) == u64(0))\n    assert(i64_be(&buf, 42) == -9223372036854775808)\n    assert(u64_be(&buf, 42) == u64(9223372036854775808))\n    assert(i64_be(&buf, 50) == 9223372036854775807)\n    assert(u64_be(&buf, 50) == u64(9223372036854775807))\n    assert(i64_be(&buf, 58) == -1)\n    assert(u64_be(&buf, 58) == u64(18446744073709551615))\n    assert(i64_be(&buf, 66) == 0x0102030405060708)\n    assert(u64_be(&buf, 66) == u64(0x0102030405060708))\n\n    mut exact: []u8 = [0xaa, 0, 0, 0, 0, 0, 0, 0, 0, 0xbb]\n    set_be(&mut exact, 1, 0x1234, 2)\n    assert(exact[0] == 0xaa && u16_be(&exact, 1) == 0x1234 && exact[3] == 0)\n    set_be(&mut exact, 1, 0x12345678, 4)\n    assert(exact[0] == 0xaa && u32_be(&exact, 1) == 0x12345678 && exact[5] == 0)\n    set_be(&mut exact, 1, -9223372036854775808, 8)\n    assert(exact[0] == 0xaa && i64_be(&exact, 1) == -9223372036854775808 && exact[9] == 0xbb)\n    assert(hex_u8(&exact) == \"aa8000000000000000bb\")\n\n    mut tail2: []u8 = [0xff, 0x80, 0x01]\n    assert(u16_be(&tail2, tail2.len - 2) == 0x8001)\n    assert(i16_be(&tail2, tail2.len - 2) == -32767)\n    mut tail4: []u8 = [0xff, 0x80, 0x00, 0x00, 0x01]\n    assert(u32_be(&tail4, tail4.len - 4) == 0x80000001)\n    assert(i32_be(&tail4, tail4.len - 4) == -2147483647)\n\n    min2: []u8 = [0x80, 0x00]\n    assert(u16_be(&min2, 0) == 32768 && i16_be(&min2, 0) == -32768)\n    min4: []u8 = [0x80, 0x00, 0x00, 0x00]\n    assert(u32_be(&min4, 0) == 2147483648 && i32_be(&min4, 0) == -2147483648)\n    min8: []u8 = [0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]\n    assert(i64_be(&min8, 0) == -9223372036854775808 && u64_be(&min8, 0) == u64(9223372036854775808))\n\n    assert(decode_range(&tail2, -1, 1) == .Err(.InvalidArgument))\n    assert(decode_range(&tail2, 2, 1) == .Err(.InvalidArgument))\n    assert(decode_range(&tail2, 0, 4) == .Err(.InvalidArgument))\n    assert(find_byte(&tail2, -5, 99, 0x01) == .Some(2))\n    assert(find_byte(&tail2, 3, 5, 0x01) == .None)\n    assert(find_crlf(&tail2, 0, 99) == .None)\n    assert(find_double_crlf(&tail2, -1, 99) == .None)\n    assert(!equals_text(&tail2, -1, 0, \"\"))\n    assert(!equals_text(&tail2, 0, 4, \"abcd\"))\n\n    raw := from_text(\"å🌍\")\n    assert(raw.len == 6 && decode(&raw).unwrap() == \"å🌍\")\n    assert(hex(&raw) == \"c3a5f09f8c8d\")\n    mut prefix_buf := raw.clone()\n    consume_prefix(&mut prefix_buf, 2)\n    assert(decode(&prefix_buf).unwrap() == \"🌍\")\n    wide := to_i32(&raw)\n    repacked := from_i32(&wide)\n    assert(wide.len == 6 && equal(&repacked, &raw))\n}\n" }
    if name == "bytes/utf8" { return "import sys\n\npub fn decode(input: &[]u8) -> Result<string, sys.IoError> { decode_range(&input, 0, input.len) }\npub fn decode_range(input: &[]u8, start: i32, end: i32) -> Result<string, sys.IoError> {\n    if start < 0 || end < start || end > input.len {\n        return .Err(.InvalidArgument)\n    }\n    decoded := sys.decode_u8_range(&input, i64(start), i64(end - start))\n    if decoded.ok { .Ok(decoded.value) } else { .Err(sys.IoError::from_code(decoded.error)) }\n}\n\n@derive(Eq)\npub enum Prefix { Scalar(rune, i32), Incomplete, Invalid }\n\npub fn decode_prefix(input: &[]u8) -> Prefix {\n    if input.len == 0 { return .Incomplete }\n    first := i32(input[0])\n    if first < 128 { return .Scalar(rune(first), 1) }\n    if first < 0xc2 || first > 0xf4 { return .Invalid }\n    size := if first < 0xe0 { 2 } else if first < 0xf0 { 3 } else { 4 }\n    mut scalar := first.bit_and(127.shr(size))\n    for i in 1..size {\n        if i == input.len { return .Incomplete }\n        byte := i32(input[i])\n        if byte < 0x80 || byte > 0xbf { return .Invalid }\n        if i == 1 && ((first == 0xe0 && byte < 0xa0) || (first == 0xed && byte >= 0xa0) ||\n            (first == 0xf0 && byte < 0x90) || (first == 0xf4 && byte >= 0x90)) { return .Invalid }\n        scalar = scalar.shl(6).bit_or(byte.bit_and(63))\n    }\n    .Scalar(rune(scalar), size)\n}\n\n@test fn prefix_waits_only_for_possible_scalars() {\n    for scalar in [0, 127, 128, 2047, 2048, 0xd7ff, 0xe000, 0xffff, 0x10000, 0x10ffff] {\n        encoded := rune(scalar).str().bytes()\n        for split in 0..encoded.len { assert(decode_prefix(&encoded[..split]) == .Incomplete) }\n        assert(decode_prefix(&encoded) == .Scalar(rune(scalar), encoded.len))\n    }\n    invalid: [][]u8 = [[u8(0x80)], [u8(0xff)], [u8(0xc0)], [u8(0xe0), 0x9f], [u8(0xed), 0xa0],\n                [u8(0xf0), 0x8f], [u8(0xf4), 0x90], [u8(0xf5)], [u8(0xe2), 65], [u8(0xf0), 0x90, 0]]\n    for bad in &invalid {\n        assert(decode_prefix(&bad) == .Invalid)\n    }\n    both: []u8 = [0xc3, 0xa5, 0xff]\n    assert(decode_prefix(&both) == .Scalar(rune(229), 2))\n}\n" }
    if name == "cmp" { return "pub fn min<T: Ord + Storable>(move a: T, move b: T) -> T {\n    if a.cmp(b) != Ordering.Greater { a } else { b }\n}\n\npub fn max<T: Ord + Storable>(move a: T, move b: T) -> T {\n    if a.cmp(b) != Ordering.Less { a } else { b }\n}\n\npub fn clamp<T: Ord + Storable>(move value: T, move low: T, move high: T) -> T {\n    assert(low.cmp(high) != Ordering.Greater)\n    if value.cmp(low) == Ordering.Less { return low }\n    if value.cmp(high) == Ordering.Greater { return high }\n    value\n}\n\npub struct Reverse<T> where T: Storable {\n    value: T,\n}\n\nimpl Reverse<T> {\n    pub fn new(move value: T) -> Self { Self { value: value } }\n    pub fn into_inner(move self) -> T { self.value }\n}\n\nimpl Eq for Reverse<T> where T: Eq {\n    fn eq(&self, other: &Self) -> bool { self.value.eq(other.value) }\n}\n\nimpl Ord for Reverse<T> where T: Ord {\n    fn cmp(&self, other: &Self) -> Ordering { other.value.cmp(self.value) }\n}\n\nimpl Hash for Reverse<T> where T: Hash {\n    fn hash(&self) -> u64 { self.value.hash() }\n}\n\nimpl Display for Reverse<T> where T: Display {\n    fn str(&self) -> string { self.value.str() }\n}\n\nimpl Default for Reverse<T> where T: Default {\n    fn default() -> Self { Self { value: T::default() } }\n}\n\nimpl Sendable for Reverse<T> where T: Sendable {}\n\n@test\nfn ordering_and_bounds_cover_min_max_clamp_and_reverse() {\n    assert(min<i32>(3, 7) == 3)\n    assert(min<i32>(7, 3) == 3)\n    assert(max<i32>(3, 7) == 7)\n    assert(max<string>(\"alpha\", \"beta\") == \"beta\")\n    assert(min<string>(\"alpha\", \"beta\") == \"alpha\")\n    assert(clamp<i64>(-5, 0, 10) == 0)\n    assert(clamp<i64>(5, 0, 10) == 5)\n    assert(clamp<i64>(25, 0, 10) == 10)\n\n    a := Reverse<i32>::new(10)\n    b := Reverse<i32>::new(20)\n    assert(a > b)\n    assert(b < a)\n    assert(a != b)\n    assert(a == Reverse<i32>::new(10))\n    assert(a.str() == \"10\")\n    assert(Reverse<i32>::default().into_inner() == 0)\n    assert(Ordering.Less < Ordering.Equal && Ordering.Equal < Ordering.Greater)\n    assert(Ordering.Less.str() == \"Less\")\n    assert(Ordering::default() == Ordering.Equal)\n}\n" }
    if name == "crypto" { return "capability unsafe\n\nimport std.bytes as bytes\nimport std.dl as dl\nimport std.parse as parse\nimport std.random as entropy\nimport std.sha256 as sha256\nimport std.text as text\n\npub struct Sealed { ciphertext: []u8, tag: []u8 }\npub struct Keypair { private_key: []u8, public_key: []u8 }\n\n@extern(\"c\", \"getenv\")\n@thread_safe\nunsafe fn c_getenv(name: ptr) -> ptr\n\nfn as_bytes(value: string) -> []u8 { mut out: []u8 = []; bytes.append_utf8(&mut out, value); out }\nfn terminated(value: string) -> []u8 { mut out := as_bytes(value); out.push(0); out }\n@thread_safe\nunsafe fn pointer(value: &[]u8) -> ptr { if value.len == 0 { return ptr(0) }; addr(&value[0]) }\n\n@thread_safe\nunsafe fn decode_cstr(p: ptr) -> string {\n    if usize(p) == 0 { return \"\" }\n    mut raw: []u8 = []\n    mut offset: usize = 0\n    while offset < 4096 {\n        b := load_u8(ptr(usize(p) + offset))\n        if b == 0 { break }\n        raw.push(b)\n        offset += usize(1)\n    }\n    bytes.decode(&raw).unwrap_or_default()\n}\n\n@thread_safe\nunsafe fn read_env(name: string) -> string {\n    if !target_is(\"native\") { return \"\" }\n    key := terminated(name)\n    decode_cstr(c_getenv(addr(&key[0])))\n}\n\n@thread_safe\nunsafe fn open_candidate(path: string) -> ptr {\n    if path == \"\" { return ptr(0) }\n    raw := terminated(path)\n    dl.open(addr(&raw[0]), 1)\n}\n\n@thread_safe\nunsafe fn open_crypto_lib() -> ptr {\n    if !target_is(\"native\") { return ptr(0) }\n    explicit := read_env(\"DUNDER_CRYPTO_LIB\")\n    if explicit != \"\" { return open_candidate(explicit) }\n    dir := read_env(\"OPENSSL_LIB_DIR\")\n    if dir != \"\" {\n        mut clean := dir.clone()\n        while clean.len > 1 && clean[clean.len - 1] == 47 { clean = clean[0..clean.len - 1] }\n        if target_is(\"macos\") {\n            for leaf in [\"libcrypto.3.dylib\", \"libcrypto.dylib\"] {\n                h := open_candidate(clean + \"/\" + leaf)\n                if usize(h) != 0 { return h }\n            }\n        } else if target_is(\"linux\") {\n            for leaf in [\"libcrypto.so.3\", \"libcrypto.so\"] {\n                h := open_candidate(clean + \"/\" + leaf)\n                if usize(h) != 0 { return h }\n            }\n        }\n    }\n    if target_is(\"macos\") {\n        for cand in [\n            \"libcrypto.3.dylib\",\n            \"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\",\n            \"/usr/local/opt/openssl@3/lib/libcrypto.3.dylib\",\n            \"/opt/local/lib/libcrypto.3.dylib\",\n            \"libcrypto.dylib\",\n        ] {\n            h := open_candidate(cand)\n            if usize(h) != 0 { return h }\n        }\n    } else if target_is(\"linux\") {\n        for cand in [\n            \"libcrypto.so.3\",\n            \"/usr/lib/aarch64-linux-gnu/libcrypto.so.3\",\n            \"/usr/lib/x86_64-linux-gnu/libcrypto.so.3\",\n            \"/usr/lib64/libcrypto.so.3\",\n            \"libcrypto.so\",\n        ] {\n            h := open_candidate(cand)\n            if usize(h) != 0 { return h }\n        }\n    }\n    ptr(0)\n}\n\n@thread_safe\nunsafe fn open_argon2_lib() -> ptr {\n    if !target_is(\"native\") { return ptr(0) }\n    explicit := read_env(\"DUNDER_ARGON2_LIB\")\n    if explicit != \"\" { return open_candidate(explicit) }\n    if target_is(\"macos\") {\n        for cand in [\n            \"libargon2.1.dylib\",\n            \"libargon2.dylib\",\n            \"/opt/homebrew/opt/argon2/lib/libargon2.dylib\",\n            \"/usr/local/opt/argon2/lib/libargon2.dylib\",\n            \"/opt/local/lib/libargon2.dylib\",\n        ] {\n            h := open_candidate(cand)\n            if usize(h) != 0 { return h }\n        }\n    } else if target_is(\"linux\") {\n        for cand in [\n            \"libargon2.so.1\",\n            \"/usr/lib/aarch64-linux-gnu/libargon2.so.1\",\n            \"/usr/lib/x86_64-linux-gnu/libargon2.so.1\",\n            \"/usr/lib64/libargon2.so.1\",\n            \"libargon2.so\",\n        ] {\n            h := open_candidate(cand)\n            if usize(h) != 0 { return h }\n        }\n    }\n    ptr(0)\n}\n\n@thread_safe\nunsafe fn load_sym(lib: ptr, name: string) -> ptr {\n    raw := terminated(name)\n    dl.symbol(lib, addr(&raw[0]))\n}\n\n@thread_safe\npub fn random(count: i32) -> Result<[]u8, string> {\n    match entropy.bytes(count) {\n        .Ok(value) => .Ok(value),\n        .Err(e) => .Err(e.message()),\n    }\n}\n\npub fn equal(left: &[]u8, right: &[]u8) -> bool {\n    if left.len != right.len { return false }\n    mut difference := 0\n    for i in 0..left.len { difference = difference.bit_or(i32(left[i]).bit_xor(i32(right[i]))) }\n    difference == 0\n}\n\npub fn hmac_sha256(key: &[]u8, input: &[]u8) -> []u8 {\n    mut material: []u8 = []\n    if key.len > 64 { material = sha256.digest_bytes(&key) } else { bytes.extend(&mut material, &key) }\n    while material.len < 64 { material.push(0) }\n    mut inside: []u8 = []; mut outside: []u8 = []\n    inside.reserve(64 + input.len); outside.reserve(96)\n    for byte in &material { inside.push(u8(i32(byte).bit_xor(54))); outside.push(u8(i32(byte).bit_xor(92))) }\n    bytes.extend(&mut inside, &input)\n    digest := sha256.digest_bytes(&inside)\n    bytes.extend(&mut outside, &digest)\n    sha256.digest_bytes(&outside)\n}\n\npub fn hkdf_sha256(key: &[]u8, salt: &[]u8, info: &[]u8, length: i32) -> Result<[]u8, string> {\n    if length < 0 || length > 8160 { return .Err(\"HKDF output must be 0..8160 bytes\") }\n    prk := hmac_sha256(&salt, &key)\n    mut output: []u8 = []; mut previous: []u8 = []; mut counter := 1\n    output.reserve(length)\n    while output.len < length {\n        mut block: []u8 = []\n        bytes.extend(&mut block, &previous); bytes.extend(&mut block, &info); block.push(u8(counter))\n        previous = hmac_sha256(&prk, &block)\n        for byte in &previous { if output.len < length { output.push(byte) } }\n        counter += 1\n    }\n    .Ok(output)\n}\n\nfn digit(value: i32) -> i32 {\n    if value >= 48 && value <= 57 { return value - 48 }\n    if value >= 65 && value <= 70 { return value - 55 }\n    if value >= 97 && value <= 102 { return value - 87 }\n    -1\n}\npub fn decode_hex(value: string) -> Result<[]u8, string> {\n    if value.len % 2 != 0 || value.len > 33554432 { return .Err(\"invalid hex encoding\") }\n    mut output: []u8 = []; output.reserve(value.len / 2)\n    mut i := 0\n    while i < value.len {\n        high := digit(i32(value[i])); low := digit(i32(value[i + 1]))\n        if high < 0 || low < 0 { return .Err(\"invalid hex encoding\") }\n        output.push(u8(high * 16 + low)); i += 2\n    }\n    .Ok(output)\n}\n\n@thread_safe\npub fn argon2id_hash(password: string) -> Result<string, string> {\n    if password.len > 1048576 { return .Err(\"password exceeds its byte limit\") }\n    if !target_is(\"native\") { return .Err(\"Argon2id requires a native target\") }\n    salt := random(16)?\n    raw := as_bytes(password)\n    mut encoded: []u8 = []; bytes.pad(&mut encoded, 512)\n    unsafe {\n        lib := open_argon2_lib()\n        if usize(lib) == 0 { return .Err(\"cannot load Argon2 library; set DUNDER_ARGON2_LIB\") }\n        defer { _ := dl.close(lib) }\n        sym := load_sym(lib, \"argon2id_hash_encoded\")\n        if usize(sym) == 0 { return .Err(\"missing argon2id_hash_encoded symbol\") }\n        hash_fn: extern fn(u32, u32, u32, ptr, usize, ptr, usize, usize, ptr, usize) -> i32 = ffi_fn(sym)\n        if hash_fn(u32(2), u32(19456), u32(1), pointer(&raw), usize(raw.len), pointer(&salt), usize(16), usize(32), addr(&mut encoded[0]), usize(512)) != 0 {\n            return .Err(\"Argon2id password hashing failed\")\n        }\n    }\n    mut end := 0\n    while end < encoded.len && encoded[end] != 0 { end += 1 }\n    if end == encoded.len { return .Err(\"invalid Argon2id output\") }\n    .Ok(bytes.decode_range(&encoded, 0, end).unwrap_or_default())\n}\n\nfn argon_parameters(encoded: string) -> bool {\n    if encoded.len > 512 || !text.starts_with(encoded, \"$argon2id$v=19$\") { return false }\n    for byte in encoded.bytes() { if byte == 0 { return false } }\n    parts := text.split(encoded, \"$\")\n    if parts.len != 6 || parts[4].len < 11 || parts[5].len < 16 { return false }\n    settings := text.split(parts[3], \",\")\n    if settings.len != 3 { return false }\n    prefixes: []string = [\"m=\", \"t=\", \"p=\"]\n    limits: []i64 = [262144, 10, 16]\n    for i in 0..3 {\n        if !text.starts_with(settings[i], prefixes[i]) { return false }\n        value := settings[i][2..settings[i].len]\n        if value.len == 0 || value.len > 8 { return false }\n        for byte in value.bytes() { if byte < 48 || byte > 57 { return false } }\n        number := parse.integer(value)\n        if !number.ok || number.value < 1 || number.value > limits[i] { return false }\n    }\n    true\n}\n\n@thread_safe\npub fn argon2id_verify(password: string, encoded: string) -> bool {\n    if password.len > 1048576 || !argon_parameters(encoded) { return false }\n    if !target_is(\"native\") { return false }\n    hash := terminated(encoded); raw := as_bytes(password)\n    unsafe {\n        lib := open_argon2_lib()\n        if usize(lib) == 0 { return false }\n        defer { _ := dl.close(lib) }\n        sym := load_sym(lib, \"argon2id_verify\")\n        if usize(sym) == 0 { return false }\n        verify_fn: extern fn(ptr, ptr, usize) -> i32 = ffi_fn(sym)\n        return verify_fn(addr(&hash[0]), pointer(&raw), usize(raw.len)) == 0\n    }\n    false\n}\n\n@thread_safe\npub fn aes256_gcm_seal(key: &[]u8, nonce: &[]u8, aad: &[]u8, plaintext: &[]u8) -> Result<Sealed, string> {\n    if key.len != 32 || nonce.len != 12 || plaintext.len > 16777216 || aad.len > 1048576 {\n        return .Err(\"invalid AES-256-GCM inputs\")\n    }\n    if !target_is(\"native\") {\n        return .Err(\"AES requires a native target\")\n    }\n    unsafe {\n        lib := open_crypto_lib()\n        if usize(lib) == 0 { return .Err(\"cannot load OpenSSL libcrypto; set DUNDER_CRYPTO_LIB or OPENSSL_LIB_DIR\") }\n        defer { _ := dl.close(lib) }\n        s_ctx_new := load_sym(lib, \"EVP_CIPHER_CTX_new\")\n        s_ctx_free := load_sym(lib, \"EVP_CIPHER_CTX_free\")\n        s_cipher := load_sym(lib, \"EVP_aes_256_gcm\")\n        s_init := load_sym(lib, \"EVP_EncryptInit_ex\")\n        s_upd := load_sym(lib, \"EVP_EncryptUpdate\")\n        s_fin := load_sym(lib, \"EVP_EncryptFinal_ex\")\n        s_ctrl := load_sym(lib, \"EVP_CIPHER_CTX_ctrl\")\n        if usize(s_ctx_new) == 0 || usize(s_ctx_free) == 0 || usize(s_cipher) == 0 || usize(s_init) == 0 || usize(s_upd) == 0 || usize(s_fin) == 0 || usize(s_ctrl) == 0 {\n            return .Err(\"missing EVP AES symbols in OpenSSL libcrypto\")\n        }\n        ctx_new: extern fn() -> ptr = ffi_fn(s_ctx_new)\n        ctx_free: extern fn(ptr) = ffi_fn(s_ctx_free)\n        cipher_fn: extern fn() -> ptr = ffi_fn(s_cipher)\n        enc_init: extern fn(ptr, ptr, ptr, ptr, ptr) -> i32 = ffi_fn(s_init)\n        enc_update: extern fn(ptr, ptr, ptr, ptr, i32) -> i32 = ffi_fn(s_upd)\n        enc_final: extern fn(ptr, ptr, ptr) -> i32 = ffi_fn(s_fin)\n        ctrl: extern fn(ptr, i32, i32, ptr) -> i32 = ffi_fn(s_ctrl)\n\n        context := ctx_new()\n        if context == ptr(0) { return .Err(\"cannot allocate AES context\") }\n        defer { ctx_free(context) }\n        if enc_init(context, cipher_fn(), ptr(0), pointer(&key), pointer(&nonce)) != 1 {\n            return .Err(\"cannot initialize AES-256-GCM\")\n        }\n        mut count := 0\n        if aad.len > 0 && enc_update(context, ptr(0), addr(&mut count), pointer(&aad), aad.len) != 1 {\n            return .Err(\"cannot authenticate AES associated data\")\n        }\n        mut output: []u8 = []; bytes.pad(&mut output, plaintext.len + 16)\n        count = 0\n        if enc_update(context, addr(&mut output[0]), addr(&mut count), pointer(&plaintext), plaintext.len) != 1 {\n            return .Err(\"AES encryption failed\")\n        }\n        mut final_count := 0\n        if enc_final(context, addr(&mut output[count]), addr(&mut final_count)) != 1 {\n            return .Err(\"AES encryption failed\")\n        }\n        mut tag: []u8 = []; bytes.pad(&mut tag, 16)\n        if ctrl(context, 16, 16, addr(&mut tag[0])) != 1 {\n            return .Err(\"cannot read AES authentication tag\")\n        }\n        while output.len > count + final_count { _ := output.pop() }\n        return .Ok(Sealed { ciphertext: output, tag: tag })\n    }\n    .Err(\"AES requires a native target\")\n}\n\n@thread_safe\npub fn aes256_gcm_open(key: &[]u8, nonce: &[]u8, aad: &[]u8, ciphertext: &[]u8, tag: &[]u8) -> Result<[]u8, string> {\n    if key.len != 32 || nonce.len != 12 || tag.len != 16 || ciphertext.len > 16777216 || aad.len > 1048576 { return .Err(\"invalid AES-256-GCM inputs\") }\n    if !target_is(\"native\") { return .Err(\"AES requires a native target\") }\n    unsafe {\n        lib := open_crypto_lib()\n        if usize(lib) == 0 { return .Err(\"cannot load OpenSSL libcrypto; set DUNDER_CRYPTO_LIB or OPENSSL_LIB_DIR\") }\n        defer { _ := dl.close(lib) }\n        s_ctx_new := load_sym(lib, \"EVP_CIPHER_CTX_new\")\n        s_ctx_free := load_sym(lib, \"EVP_CIPHER_CTX_free\")\n        s_cipher := load_sym(lib, \"EVP_aes_256_gcm\")\n        s_init := load_sym(lib, \"EVP_DecryptInit_ex\")\n        s_upd := load_sym(lib, \"EVP_DecryptUpdate\")\n        s_fin := load_sym(lib, \"EVP_DecryptFinal_ex\")\n        s_ctrl := load_sym(lib, \"EVP_CIPHER_CTX_ctrl\")\n        if usize(s_ctx_new) == 0 || usize(s_ctx_free) == 0 || usize(s_cipher) == 0 || usize(s_init) == 0 || usize(s_upd) == 0 || usize(s_fin) == 0 || usize(s_ctrl) == 0 {\n            return .Err(\"missing EVP AES symbols in OpenSSL libcrypto\")\n        }\n        ctx_new: extern fn() -> ptr = ffi_fn(s_ctx_new)\n        ctx_free: extern fn(ptr) = ffi_fn(s_ctx_free)\n        cipher_fn: extern fn() -> ptr = ffi_fn(s_cipher)\n        dec_init: extern fn(ptr, ptr, ptr, ptr, ptr) -> i32 = ffi_fn(s_init)\n        dec_update: extern fn(ptr, ptr, ptr, ptr, i32) -> i32 = ffi_fn(s_upd)\n        dec_final: extern fn(ptr, ptr, ptr) -> i32 = ffi_fn(s_fin)\n        ctrl: extern fn(ptr, i32, i32, ptr) -> i32 = ffi_fn(s_ctrl)\n\n        context := ctx_new()\n        if context == ptr(0) { return .Err(\"cannot allocate AES context\") }\n        defer { ctx_free(context) }\n        if dec_init(context, cipher_fn(), ptr(0), pointer(&key), pointer(&nonce)) != 1 { return .Err(\"cannot initialize AES-256-GCM\") }\n        mut count := 0\n        if aad.len > 0 && dec_update(context, ptr(0), addr(&mut count), pointer(&aad), aad.len) != 1 { return .Err(\"cannot authenticate AES associated data\") }\n        mut output: []u8 = []; bytes.pad(&mut output, ciphertext.len + 16)\n        count = 0\n        if dec_update(context, addr(&mut output[0]), addr(&mut count), pointer(&ciphertext), ciphertext.len) != 1 { return .Err(\"AES decryption failed\") }\n        if ctrl(context, 17, 16, pointer(&tag)) != 1 { return .Err(\"cannot set AES authentication tag\") }\n        mut final_count := 0\n        if dec_final(context, addr(&mut output[count]), addr(&mut final_count)) != 1 {\n            for i in 0..output.len { output[i] = 0 }\n            return .Err(\"AES authentication failed\")\n        }\n        while output.len > count + final_count { _ := output.pop() }\n        return .Ok(output)\n    }\n    .Err(\"AES requires a native target\")\n}\n\n@thread_safe\npub fn ed25519_public_key(private_key: &[]u8) -> Result<[]u8, string> {\n    if private_key.len != 32 { return .Err(\"Ed25519 private key must be 32 bytes\") }\n    if !target_is(\"native\") { return .Err(\"Ed25519 requires a native target\") }\n    name := terminated(\"ED25519\")\n    unsafe {\n        lib := open_crypto_lib()\n        if usize(lib) == 0 { return .Err(\"cannot load OpenSSL libcrypto; set DUNDER_CRYPTO_LIB or OPENSSL_LIB_DIR\") }\n        defer { _ := dl.close(lib) }\n        s_new := load_sym(lib, \"EVP_PKEY_new_raw_private_key_ex\")\n        s_pub := load_sym(lib, \"EVP_PKEY_get_raw_public_key\")\n        s_free := load_sym(lib, \"EVP_PKEY_free\")\n        if usize(s_new) == 0 || usize(s_pub) == 0 || usize(s_free) == 0 {\n            return .Err(\"missing EVP Ed25519 symbols in OpenSSL libcrypto\")\n        }\n        pkey_new: extern fn(ptr, ptr, ptr, ptr, usize) -> ptr = ffi_fn(s_new)\n        pkey_pub: extern fn(ptr, ptr, ptr) -> i32 = ffi_fn(s_pub)\n        pkey_free: extern fn(ptr) = ffi_fn(s_free)\n\n        pkey := pkey_new(ptr(0), addr(&name[0]), ptr(0), addr(&private_key[0]), usize(32))\n        if pkey == ptr(0) { return .Err(\"cannot load Ed25519 private key\") }\n        defer { pkey_free(pkey) }\n        mut public_key: []u8 = []; bytes.pad(&mut public_key, 32)\n        mut length: usize = usize(32)\n        if pkey_pub(pkey, addr(&mut public_key[0]), addr(&mut length)) != 1 || length != usize(32) {\n            return .Err(\"cannot derive Ed25519 public key\")\n        }\n        return .Ok(public_key)\n    }\n    .Err(\"Ed25519 requires a native target\")\n}\n\n@thread_safe\npub fn ed25519_keygen() -> Result<Keypair, string> {\n    seed := random(32)?\n    public_key := ed25519_public_key(&seed)?\n    .Ok(Keypair { private_key: seed, public_key: public_key })\n}\n\n@thread_safe\npub fn ed25519_sign(private_key: &[]u8, message: &[]u8) -> Result<[]u8, string> {\n    if private_key.len != 32 || message.len > 16777216 { return .Err(\"invalid Ed25519 signing inputs\") }\n    if !target_is(\"native\") { return .Err(\"Ed25519 requires a native target\") }\n    name := terminated(\"ED25519\")\n    mut scratch: u8 = 0\n    unsafe {\n        lib := open_crypto_lib()\n        if usize(lib) == 0 { return .Err(\"cannot load OpenSSL libcrypto; set DUNDER_CRYPTO_LIB or OPENSSL_LIB_DIR\") }\n        defer { _ := dl.close(lib) }\n        s_new := load_sym(lib, \"EVP_PKEY_new_raw_private_key_ex\")\n        s_free := load_sym(lib, \"EVP_PKEY_free\")\n        s_md_new := load_sym(lib, \"EVP_MD_CTX_new\")\n        s_md_free := load_sym(lib, \"EVP_MD_CTX_free\")\n        s_init := load_sym(lib, \"EVP_DigestSignInit\")\n        s_sign := load_sym(lib, \"EVP_DigestSign\")\n        if usize(s_new) == 0 || usize(s_free) == 0 || usize(s_md_new) == 0 || usize(s_md_free) == 0 || usize(s_init) == 0 || usize(s_sign) == 0 {\n            return .Err(\"missing EVP Ed25519 signing symbols in OpenSSL libcrypto\")\n        }\n        pkey_new: extern fn(ptr, ptr, ptr, ptr, usize) -> ptr = ffi_fn(s_new)\n        pkey_free: extern fn(ptr) = ffi_fn(s_free)\n        md_ctx_new: extern fn() -> ptr = ffi_fn(s_md_new)\n        md_ctx_free: extern fn(ptr) = ffi_fn(s_md_free)\n        digest_sign_init: extern fn(ptr, ptr, ptr, ptr, ptr) -> i32 = ffi_fn(s_init)\n        digest_sign: extern fn(ptr, ptr, ptr, ptr, usize) -> i32 = ffi_fn(s_sign)\n\n        pkey := pkey_new(ptr(0), addr(&name[0]), ptr(0), addr(&private_key[0]), usize(32))\n        if pkey == ptr(0) { return .Err(\"cannot load Ed25519 private key\") }\n        defer { pkey_free(pkey) }\n        context := md_ctx_new()\n        if context == ptr(0) { return .Err(\"cannot allocate Ed25519 signing context\") }\n        defer { md_ctx_free(context) }\n        if digest_sign_init(context, ptr(0), ptr(0), ptr(0), pkey) != 1 {\n            return .Err(\"cannot initialize Ed25519 signature\")\n        }\n        mut signature: []u8 = []; bytes.pad(&mut signature, 64)\n        mut signature_len: usize = usize(64)\n        tbs := if message.len > 0 { addr(&message[0]) } else { addr(&mut scratch) }\n        if digest_sign(context, addr(&mut signature[0]), addr(&mut signature_len), tbs, usize(message.len)) != 1 || signature_len != usize(64) {\n            return .Err(\"Ed25519 signing failed\")\n        }\n        return .Ok(signature)\n    }\n    .Err(\"Ed25519 requires a native target\")\n}\n\n@thread_safe\npub fn ed25519_verify(public_key: &[]u8, message: &[]u8, signature: &[]u8) -> bool {\n    if public_key.len != 32 || signature.len != 64 || message.len > 16777216 { return false }\n    if !target_is(\"native\") { return false }\n    name := terminated(\"ED25519\")\n    mut scratch: u8 = 0\n    unsafe {\n        lib := open_crypto_lib()\n        if usize(lib) == 0 { return false }\n        defer { _ := dl.close(lib) }\n        s_new := load_sym(lib, \"EVP_PKEY_new_raw_public_key_ex\")\n        s_free := load_sym(lib, \"EVP_PKEY_free\")\n        s_md_new := load_sym(lib, \"EVP_MD_CTX_new\")\n        s_md_free := load_sym(lib, \"EVP_MD_CTX_free\")\n        s_init := load_sym(lib, \"EVP_DigestVerifyInit\")\n        s_verify := load_sym(lib, \"EVP_DigestVerify\")\n        if usize(s_new) == 0 || usize(s_free) == 0 || usize(s_md_new) == 0 || usize(s_md_free) == 0 || usize(s_init) == 0 || usize(s_verify) == 0 {\n            return false\n        }\n        pkey_new: extern fn(ptr, ptr, ptr, ptr, usize) -> ptr = ffi_fn(s_new)\n        pkey_free: extern fn(ptr) = ffi_fn(s_free)\n        md_ctx_new: extern fn() -> ptr = ffi_fn(s_md_new)\n        md_ctx_free: extern fn(ptr) = ffi_fn(s_md_free)\n        digest_verify_init: extern fn(ptr, ptr, ptr, ptr, ptr) -> i32 = ffi_fn(s_init)\n        digest_verify: extern fn(ptr, ptr, usize, ptr, usize) -> i32 = ffi_fn(s_verify)\n\n        pkey := pkey_new(ptr(0), addr(&name[0]), ptr(0), addr(&public_key[0]), usize(32))\n        if pkey == ptr(0) { return false }\n        defer { pkey_free(pkey) }\n        context := md_ctx_new()\n        if context == ptr(0) { return false }\n        defer { md_ctx_free(context) }\n        if digest_verify_init(context, ptr(0), ptr(0), ptr(0), pkey) != 1 { return false }\n        tbs := if message.len > 0 { addr(&message[0]) } else { addr(&mut scratch) }\n        return digest_verify(context, addr(&signature[0]), usize(64), tbs, usize(message.len)) == 1\n    }\n    false\n}\n\n@thread_safe\npub fn zeroize(buf: &mut []u8) {\n    if buf.len == 0 { return }\n    unsafe { bytes.zero_memory(addr(&mut buf[0]), usize(buf.len)) }\n}\n\npub fn zeroize_and_clear(buf: &mut []u8) {\n    zeroize(&mut buf)\n    buf.clear()\n}\n\n@resource(dispose)\npub opaque struct SecretBytes {\n    data: []u8,\n}\n\nimpl SecretBytes {\n    pub fn empty() -> Self {\n        Self { data: [] }\n    }\n    pub fn from_bytes(move data: []u8) -> Self {\n        Self { data: move data }\n    }\n    pub fn from_slice(data: &[]u8) -> Self {\n        mut copy: []u8 = []\n        bytes.extend(&mut copy, &data)\n        Self { data: move copy }\n    }\n    pub fn from_text(text: string) -> Self {\n        Self { data: bytes.from_text(text) }\n    }\n    pub fn random(count: i32) -> Result<Self, string> {\n        if count < 0 { return .Err(\"negative secret length\") }\n        match random(count) {\n            .Ok(buf) => .Ok(Self { data: move buf }),\n            .Err(err) => .Err(err),\n        }\n    }\n    pub fn len(&self) -> i32 { self.data.len }\n    pub fn is_empty(&self) -> bool { self.data.len == 0 }\n    pub fn as_bytes(&self) -> &[]u8 { &self.data }\n    pub fn as_mut_bytes(&mut self) -> &mut []u8 { &mut self.data }\n    pub fn equal(&self, other: &SecretBytes) -> bool { equal(&self.data, &other.data) }\n    pub fn clear(&mut self) { zeroize_and_clear(&mut self.data) }\n    fn dispose(&mut self) { self.clear() }\n}\n" }
    if name == "dl" { return "capability unsafe\n\n@extern(\"dl\", \"dlopen\") @thread_safe\nunsafe fn posix_open(path: ptr, flags: i32) -> ptr\n@extern(\"dl\", \"dlsym\") @thread_safe\nunsafe fn posix_symbol(library: ptr, name: ptr) -> ptr\n@extern(\"dl\", \"dlclose\") @thread_safe\nunsafe fn posix_close(library: ptr) -> i32\n\n@extern(\"kernel32.dll\", \"MultiByteToWideChar\") @thread_safe\nunsafe fn to_wide(page: u32, flags: u32, input: ptr, length: i32, output: ptr, capacity: i32) -> i32\n@extern(\"kernel32.dll\", \"LoadLibraryW\") @thread_safe\nunsafe fn load_library(path: ptr) -> ptr\n@extern(\"kernel32.dll\", \"GetModuleHandleExW\") @thread_safe\nunsafe fn current_module(flags: u32, name: ptr, result: ptr) -> i32\n@extern(\"kernel32.dll\", \"GetProcAddress\") @thread_safe\nunsafe fn get_proc(library: ptr, name: ptr) -> ptr\n@extern(\"kernel32.dll\", \"FreeLibrary\") @thread_safe\nunsafe fn free_library(library: ptr) -> i32\n\n@thread_safe\npub unsafe fn open(path: ptr, flags: i32) -> ptr {\n    if target_is(\"windows\") {\n        if flags != 1 && flags != 2 { return ptr(0) }\n        if usize(path) == 0 {\n            mut handle := ptr(0)\n            if current_module(u32(0), ptr(0), addr(&mut handle)) == 0 { return ptr(0) }\n            return handle\n        }\n        count := to_wide(u32(65001), u32(8), path, -1, ptr(0), 0)\n        if count <= 1 { return ptr(0) }\n        mut units: []u16 = []\n        units.reserve(count)\n        for _ in 0..count { units.push(0) }\n        if to_wide(u32(65001), u32(8), path, -1, addr(&mut units[0]), count) != count { return ptr(0) }\n        return load_library(addr(&units[0]))\n    } else { return posix_open(path, flags) }\n}\n\n@thread_safe\npub unsafe fn symbol(library: ptr, name: ptr) -> ptr {\n    if target_is(\"windows\") {\n        if usize(library) == 0 || usize(name) == 0 { return ptr(0) }\n        return get_proc(library, name)\n    } else { return posix_symbol(library, name) }\n}\n\n@thread_safe\npub unsafe fn close(library: ptr) -> i32 {\n    if target_is(\"windows\") {\n        if usize(library) == 0 || free_library(library) == 0 { return -1 }\n        return 0\n    } else { return posix_close(library) }\n}\n" }
    if name == "fs" { return "capability filesystem, unsafe\nimport std.array as array\nimport std.bytes as bytes\nimport std.dl as dl\nimport std.io as io\nimport std.path as path\nimport std.time as time\nimport std.sys.winfs as winfs\nimport sys\n\n@extern(\"c\", \"uname\")\n@thread_safe\nunsafe fn c_uname(output: ptr) -> i32\n@c_variadic(2)\n@extern(\"c\", \"open\")\n@thread_safe\nunsafe fn c_open_mode(path: ptr, flags: i32, mode: i32) -> i32\n@extern(\"c\", \"lseek\")\n@thread_safe\nunsafe fn c_lseek(fd: i32, offset: i64, whence: i32) -> i64\n@extern(\"c\", \"fsync\")\n@thread_safe\nunsafe fn c_fsync(fd: i32) -> i32\n@extern(\"c\", \"stat\")\n@thread_safe\nunsafe fn c_stat(path: ptr, buf: ptr) -> i32\n@extern(\"c\", \"lstat\")\n@thread_safe\nunsafe fn c_lstat(path: ptr, buf: ptr) -> i32\n@extern(\"c\", \"fstat\")\n@thread_safe\nunsafe fn c_fstat(fd: i32, buf: ptr) -> i32\n@extern(\"c\", \"chmod\")\n@thread_safe\nunsafe fn c_chmod(path: ptr, mode: u32) -> i32\n@extern(\"c\", \"fchmod\")\n@thread_safe\nunsafe fn c_fchmod(fd: i32, mode: u32) -> i32\n@extern(\"c\", \"__error\")\n@thread_safe\nunsafe fn c_errno_ptr() -> ptr\n@extern(\"c\", \"opendir\")\n@thread_safe\nunsafe fn c_opendir(path: ptr) -> ptr\n@extern(\"c\", \"readdir\")\n@thread_safe\nunsafe fn c_readdir(directory: ptr) -> ptr\n@extern(\"c\", \"closedir\")\n@thread_safe\nunsafe fn c_closedir(directory: ptr) -> i32\n@extern(\"c\", \"readlink\")\n@thread_safe\nunsafe fn c_readlink(path: ptr, buffer: ptr, capacity: usize) -> i64\n@extern(\"c\", \"symlink\")\n@thread_safe\nunsafe fn c_symlink(target: ptr, link_path: ptr) -> i32\n@extern(\"c\", \"link\")\n@thread_safe\nunsafe fn c_link(existing: ptr, link_path: ptr) -> i32\n@extern(\"c\", \"realpath\")\n@thread_safe\nunsafe fn c_realpath(path: ptr, dst: ptr) -> ptr\n@extern(\"c\", \"getcwd\")\n@thread_safe\nunsafe fn c_getcwd(dst: ptr, size: usize) -> ptr\n@extern(\"c\", \"mkdtemp\")\n@thread_safe\nunsafe fn c_mkdtemp(tmpl: ptr) -> ptr\n@extern(\"c\", \"getenv\")\n@thread_safe\nunsafe fn c_getenv(name: ptr) -> ptr\n\npub opaque struct ReadFile { path: string }\npub opaque struct WriteFile { path: string }\npub opaque struct ReadDir { root: string }\n\nimpl ReadFile {\n    @requires(filesystem)\n    pub fn grant(move path: string) -> Self { Self { path: path } }\n    pub fn read(&self) -> Result<string, sys.IoError> { sys.read(self.path) }\n    pub fn read_limit(&self, max_bytes: i64) -> Result<string, sys.IoError> { sys.read_limit(self.path, max_bytes) }\n    pub fn read_bytes(&self) -> Result<[]u8, sys.IoError> { sys.read_bytes(self.path) }\n    pub fn read_bytes_limit(&self, max_bytes: i64) -> Result<[]u8, sys.IoError> { sys.read_bytes_limit(self.path, max_bytes) }\n    pub fn read_bytes_into(&self, out: &mut []u8, max_bytes: i64) -> Result<(), sys.IoError> {\n        sys.read_u8_into(self.path, &mut out, max_bytes).into_result()\n    }\n    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> {\n        info := sys.metadata(self.path)\n        if info.ok { .Ok(info) } else { .Err(sys.IoError::from_code(info.error)) }\n    }\n    pub fn open(&self) -> Result<FileReader, sys.IoError> {\n        match os_open_fd(self.path, OpenOptions::read_only()) {\n            .Ok(fd) => .Ok(FileReader { fd: fd }),\n            .Err(e) => .Err(e),\n        }\n    }\n}\n\nimpl WriteFile {\n    @requires(filesystem)\n    pub fn grant(move path: string) -> Self { Self { path: path } }\n    pub fn write(&self, text: string) -> Result<(), sys.IoError> { sys.write(self.path, text) }\n    pub fn append(&self, text: string) -> Result<(), sys.IoError> { sys.append_text(self.path, text).into_result() }\n    pub fn write_bytes(&self, bytes: &[]u8) -> Result<(), sys.IoError> { sys.write_bytes(self.path, &bytes) }\n    pub fn create(&self) -> Result<FileWriter, sys.IoError> {\n        match os_open_fd(self.path, OpenOptions::create_truncate()) {\n            .Ok(fd) => .Ok(FileWriter { fd: fd }),\n            .Err(e) => .Err(e),\n        }\n    }\n    pub fn open_append(&self) -> Result<FileWriter, sys.IoError> {\n        match os_open_fd(self.path, OpenOptions::append_only()) {\n            .Ok(fd) => .Ok(FileWriter { fd: fd }),\n            .Err(e) => .Err(e),\n        }\n    }\n}\n\npub struct OpenOptions {\n    read: bool,\n    write: bool,\n    create: bool,\n    truncate: bool,\n    append: bool,\n    create_new: bool,\n    nofollow: bool,\n    mode: i32,\n}\n\nimpl OpenOptions {\n    pub fn read_only() -> Self {\n        Self { read: true, write: false, create: false, truncate: false, append: false, create_new: false, nofollow: false, mode: 420 }\n    }\n    pub fn write_only() -> Self {\n        Self { read: false, write: true, create: false, truncate: false, append: false, create_new: false, nofollow: false, mode: 420 }\n    }\n    pub fn create_truncate() -> Self {\n        Self { read: false, write: true, create: true, truncate: true, append: false, create_new: false, nofollow: false, mode: 420 }\n    }\n    pub fn append_only() -> Self {\n        Self { read: false, write: true, create: true, truncate: false, append: true, create_new: false, nofollow: false, mode: 420 }\n    }\n    pub fn read_write() -> Self {\n        Self { read: true, write: true, create: false, truncate: false, append: false, create_new: false, nofollow: false, mode: 420 }\n    }\n    pub fn set_create(&mut self, enabled: bool) { self.create = enabled }\n    pub fn set_truncate(&mut self, enabled: bool) { self.truncate = enabled }\n    pub fn set_append(&mut self, enabled: bool) { self.append = enabled }\n    pub fn set_create_new(&mut self, enabled: bool) { self.create_new = enabled }\n    pub fn set_nofollow(&mut self, enabled: bool) { self.nofollow = enabled }\n    pub fn set_mode(&mut self, mode: i32) { self.mode = mode }\n}\n\n@resource(dispose)\npub opaque struct FileReader { fd: i32 }\nimpl Sendable for FileReader {}\n\n@resource(dispose)\npub opaque struct FileWriter { fd: i32 }\nimpl Sendable for FileWriter {}\n\n@resource(dispose)\npub opaque struct File { fd: i32 }\nimpl Sendable for File {}\n\n@thread_safe\nfn os_close_fd(fd: i32) -> Result<(), sys.IoError> {\n    if fd < 0 { return .Ok }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    mut n: i64 = 0\n    unsafe { n = sys.fd_close(fd) }\n    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n    .Ok\n}\n\n@thread_safe\nfn os_open_fd(path: string, opts: OpenOptions) -> Result<i32, sys.IoError> {\n    if target_is(\"windows\") {\n        if (opts.create || opts.create_new) && opts.mode != 420 { return .Err(.Unsupported) }\n        fd := winfs.open(path, opts.read, opts.write, opts.create, opts.truncate, opts.append, opts.create_new, opts.nofollow)\n        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }\n        return .Ok(fd)\n    }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    if !opts.read && !opts.write { return .Err(.InvalidArgument) }\n    if opts.truncate && !opts.write { return .Err(.InvalidArgument) }\n    mut raw_path: []u8 = []\n    path_err := c_path(path, &mut raw_path)\n    if path_err != 0 { return .Err(sys.IoError::from_code(path_err)) }\n    mut base_flags := 0\n    if opts.read && opts.write { base_flags = 2 }\n    else if opts.write { base_flags = 1 }\n    if target_is(\"macos\") {\n        mut flags := base_flags + 16777216 // O_CLOEXEC\n        if opts.create || opts.create_new { flags += 512 }\n        if opts.create_new { flags += 2048 }\n        if opts.truncate { flags += 1024 }\n        if opts.append { flags += 8 }\n        if opts.nofollow { flags += 256 }\n        unsafe {\n            fd := c_open_mode(addr(&raw_path[0]), flags, opts.mode)\n            if fd < 0 { return .Err(sys.IoError::from_code(portable_errno(load_i32(c_errno_ptr()), true))) }\n            return .Ok(fd)\n        }\n    } else if target_is(\"linux\") {\n        mut flags := base_flags + 524288 // O_CLOEXEC\n        if opts.create || opts.create_new { flags += 64 }\n        if opts.create_new { flags += 128 }\n        if opts.truncate { flags += 512 }\n        if opts.append { flags += 1024 }\n        if opts.nofollow {\n            if target_is(\"arm64\") { flags += 32768 }\n            else if target_is(\"x86_64\") { flags += 131072 }\n        }\n        unsafe {\n            // openat(AT_FDCWD=-100, path, flags, mode) = ARM64 syscall 56 (mapped on x86_64)\n            r := sys.linux_syscall(56, -100, i64(usize(addr(&raw_path[0]))), i64(flags), i64(opts.mode), 0, 0)\n            if r < 0 { return .Err(sys.IoError::from_code(portable_errno(i32(-r), false))) }\n            return .Ok(i32(r))\n        }\n    }\n    .Err(.Unsupported)\n}\n\nfn seek_whence_and_offset(pos: io.SeekFrom) -> (i32, i64) {\n    match pos {\n        .Start(n) => (0, n),\n        .Current(n) => (1, n),\n        .End(n) => (2, n),\n    }\n}\n\n@thread_safe\nfn os_lseek(fd: i32, pos: io.SeekFrom) -> Result<i64, sys.IoError> {\n    if target_is(\"windows\") {\n        (whence, offset) := seek_whence_and_offset(pos)\n        unsafe {\n            n := winfs.seek(fd, offset, whence)\n            if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n            return .Ok(n)\n        }\n    }\n    if fd < 0 { return .Err(.BadDescriptor) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    (whence, offset) := seek_whence_and_offset(pos)\n    if target_is(\"macos\") {\n        unsafe {\n            r := c_lseek(fd, offset, whence)\n            if r < 0 { return .Err(sys.IoError::from_code(portable_errno(load_i32(c_errno_ptr()), true))) }\n            return .Ok(r)\n        }\n    } else if target_is(\"linux\") {\n        unsafe {\n            // lseek(fd, offset, whence) = ARM64 syscall 62 (mapped on x86_64)\n            r := sys.linux_syscall(62, i64(fd), offset, i64(whence), 0, 0, 0)\n            if r < 0 && r >= -4095 { return .Err(sys.IoError::from_code(portable_errno(i32(-r), false))) }\n            return .Ok(r)\n        }\n    }\n    .Err(.Unsupported)\n}\n\n@thread_safe\nfn os_fsync(fd: i32) -> Result<(), sys.IoError> {\n    if target_is(\"windows\") {\n        unsafe {\n            n := winfs.flush(fd)\n            if n < 0 { return .Err(sys.IoError::from_code(-n)) }\n            return .Ok\n        }\n    }\n    if fd < 0 { return .Err(.BadDescriptor) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    if target_is(\"macos\") {\n        unsafe {\n            if c_fsync(fd) != 0 { return .Err(sys.IoError::from_code(portable_errno(load_i32(c_errno_ptr()), true))) }\n            return .Ok\n        }\n    } else if target_is(\"linux\") {\n        unsafe {\n            // fsync(fd) = ARM64 syscall 82 (mapped on x86_64)\n            r := sys.linux_syscall(82, i64(fd), 0, 0, 0, 0, 0)\n            if r < 0 { return .Err(sys.IoError::from_code(portable_errno(i32(-r), false))) }\n            return .Ok\n        }\n    }\n    .Err(.Unsupported)\n}\n\nimpl FileReader {\n    @requires(filesystem)\n    pub fn open(path: string) -> Result<Self, sys.IoError> {\n        match os_open_fd(path, OpenOptions::read_only()) {\n            .Ok(fd) => .Ok(Self { fd: fd }),\n            .Err(e) => .Err(e),\n        }\n    }\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> { os_fstat(self.fd) }\n    pub fn close(&mut self) -> Result<(), sys.IoError> {\n        fd := self.fd\n        self.fd = -1\n        os_close_fd(fd)\n    }\n    @thread_safe\n    fn dispose(&mut self) {\n        if self.fd >= 0 {\n            unsafe { _ := sys.fd_close(self.fd) }\n            self.fd = -1\n        }\n    }\n}\n\nimpl io.Read for FileReader {\n    @thread_safe\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        mut r: Result<i32, sys.IoError> = .Ok(0)\n        unsafe { r = io.fd_read_chunk(self.fd, &mut out, max_bytes) }\n        r\n    }\n}\n\nimpl io.Seek for FileReader {\n    fn seek(&mut self, pos: io.SeekFrom) -> Result<i64, sys.IoError> {\n        os_lseek(self.fd, pos)\n    }\n}\n\nimpl FileWriter {\n    @requires(filesystem)\n    pub fn create(path: string) -> Result<Self, sys.IoError> {\n        match os_open_fd(path, OpenOptions::create_truncate()) {\n            .Ok(fd) => .Ok(Self { fd: fd }),\n            .Err(e) => .Err(e),\n        }\n    }\n    @requires(filesystem)\n    pub fn open_append(path: string) -> Result<Self, sys.IoError> {\n        match os_open_fd(path, OpenOptions::append_only()) {\n            .Ok(fd) => .Ok(Self { fd: fd }),\n            .Err(e) => .Err(e),\n        }\n    }\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> { os_fstat(self.fd) }\n    pub fn set_permissions(&self, mode: u32) -> Result<(), sys.IoError> { os_fchmod(self.fd, mode) }\n    pub fn sync(&self) -> Result<(), sys.IoError> { os_fsync(self.fd) }\n    pub fn close(&mut self) -> Result<(), sys.IoError> {\n        fd := self.fd\n        self.fd = -1\n        os_close_fd(fd)\n    }\n    @thread_safe\n    fn dispose(&mut self) {\n        if self.fd >= 0 {\n            unsafe { _ := sys.fd_close(self.fd) }\n            self.fd = -1\n        }\n    }\n}\n\nimpl io.Write for FileWriter {\n    @thread_safe\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        mut r: Result<i32, sys.IoError> = .Ok(0)\n        unsafe { r = io.fd_write_chunk(self.fd, &data) }\n        r\n    }\n    fn flush(&mut self) -> Result<(), sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        .Ok\n    }\n}\n\nimpl io.Seek for FileWriter {\n    fn seek(&mut self, pos: io.SeekFrom) -> Result<i64, sys.IoError> {\n        os_lseek(self.fd, pos)\n    }\n}\n\nimpl File {\n    @requires(filesystem)\n    pub fn open(path: string, opts: OpenOptions) -> Result<Self, sys.IoError> {\n        match os_open_fd(path,