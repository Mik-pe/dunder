between fork() and execve().\n    mut str_blob: []u8 = []\n    mut arg_offsets: []i32 = []\n    if !push_cstr(&mut str_blob, &mut arg_offsets, program) {\n        return SpawnResult { ok: false, child: dead_child(), error: 22 }\n    }\n    for a in &args {\n        if !push_cstr(&mut str_blob, &mut arg_offsets, a) {\n            return SpawnResult { ok: false, child: dead_child(), error: 22 }\n        }\n    }\n\n    mut cand_offsets: []i32 = []\n    if text.find(program, \"/\") >= 0 {\n        cand_offsets.push(arg_offsets[0])\n    } else {\n        search_path := effective_path(&cmd)\n        if search_path.len > 0 {\n            for dir in text.split(search_path, \":\") {\n                mut prefix := dir\n                if prefix == \"\" { prefix = \".\" }\n                else if prefix[prefix.len - 1] != 47 { prefix += \"/\" }\n                mut candidate := prefix + program\n                if prefix == \".\" { candidate = \"./\" + program }\n                if !push_cstr(&mut str_blob, &mut cand_offsets, candidate) {\n                    return SpawnResult { ok: false, child: dead_child(), error: 22 }\n                }\n            }\n        }\n    }\n    if cand_offsets.len == 0 {\n        return SpawnResult { ok: false, child: dead_child(), error: 2 }\n    }\n\n    mut cwd_offset := -1\n    if cmd.cwd.len > 0 {\n        mut tmp_off: []i32 = []\n        if !push_cstr(&mut str_blob, &mut tmp_off, cmd.cwd) {\n            return SpawnResult { ok: false, child: dead_child(), error: 22 }\n        }\n        cwd_offset = tmp_off[0]\n    }\n\n    mut env_blob: []u8 = []\n    mut env_offsets: []i32 = []\n    unsafe {\n        if cmd.env_mode == .Inherit {\n            envp_parent := parent_environ()\n            if usize(envp_parent) != 0 {\n                mut idx: usize = 0\n                mut entry_buf: []u8 = []\n                while idx < 16384 {\n                    ep := load_ptr(ptr(usize(envp_parent) + idx * size_of(ptr)))\n                    if usize(ep) == 0 { break }\n                    entry_buf.clear()\n                    mut eq := -1\n                    mut j: usize = 0\n                    while j < 1048576 {\n                        b := load_u8(ptr(usize(ep) + j))\n                        if b == 0 { break }\n                        if b == 61 && eq < 0 { eq = i32(j) }\n                        entry_buf.push(b)\n                        j = j + 1\n                    }\n                    if eq > 0 && !key_overridden(&cmd.env_keys, &entry_buf, eq) {\n                        env_offsets.push(env_blob.len)\n                        bytes.extend(&mut env_blob, &entry_buf)\n                        env_blob.push(0)\n                    }\n                    idx = idx + 1\n                }\n            }\n        }\n    }\n    for i in 0..cmd.env_keys.len {\n        if !cmd.env_unset[i] {\n            if !push_cstr(&mut env_blob, &mut env_offsets, cmd.env_keys[i] + \"=\" + cmd.env_vals[i]) {\n                return SpawnResult { ok: false, child: dead_child(), error: 22 }\n            }\n        }\n    }\n    if env_blob.len == 0 { env_blob.push(0) }\n\n    unsafe {\n        // Ignoring SIGPIPE in parent prevents broken child stdin pipes from killing parent;\n        // the child resets SIGPIPE to SIG_DFL before execve.\n        os_signal_pipe(true)\n\n        mut argv: []ptr = []\n        for off in &arg_offsets { argv.push(addr(&str_blob[off])) }\n        argv.push(ptr(0))\n\n        mut candidates: []ptr = []\n        for off in &cand_offsets { candidates.push(addr(&str_blob[off])) }\n\n        mut envp: []ptr = []\n        for off in &env_offsets { envp.push(addr(&env_blob[off])) }\n        envp.push(ptr(0))\n\n        mut cwd_ptr := ptr(0)\n        if cwd_offset >= 0 { cwd_ptr = addr(&str_blob[cwd_offset]) }\n\n        mut err_fds: [i32; 2] = [-1, -1]\n        err_pipe := os_pipe_cloexec(addr(&mut err_fds[0]))\n        if err_pipe != 0 {\n            return SpawnResult { ok: false, child: dead_ch