 error: fork_err }\n        }\n\n        if pid == 0 {\n            _ := c_setpgid(0, 0)\n            _ := c_close(err_fds[0])\n            if in_fds[1] >= 0 { _ := c_close(in_fds[1]) }\n            if out_fds[0] >= 0 { _ := c_close(out_fds[0]) }\n            if err_out_fds[0] >= 0 { _ := c_close(err_out_fds[0]) }\n\n            var child_err := 0\n            if usize(cwd_ptr) != 0 {\n                if c_chdir(cwd_ptr) != 0 {\n                    child_err = portable_errno(load_i32(errno_ptr), is_darwin)\n                }\n            }\n            if child_err == 0 && in_fds[0] >= 0 {\n                if c_dup2(in_fds[0], 0) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }\n                if in_fds[0] > 2 { _ := c_close(in_fds[0]) }\n            } else if child_err == 0 && null_rfd >= 0 {\n                if c_dup2(null_rfd, 0) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }\n            }\n            if child_err == 0 && out_fds[1] >= 0 {\n                if c_dup2(out_fds[1], 1) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }\n                if out_fds[1] > 2 { _ := c_close(out_fds[1]) }\n            } else if child_err == 0 && cmd.stdout_mode == .Null && null_wfd >= 0 {\n                if c_dup2(null_wfd, 1) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }\n            }\n            if child_err == 0 && err_out_fds[1] >= 0 {\n                if c_dup2(err_out_fds[1], 2) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }\n                if err_out_fds[1] > 2 { _ := c_close(err_out_fds[1]) }\n            } else if child_err == 0 && cmd.stderr_mode == .Null && null_wfd >= 0 {\n                if c_dup2(null_wfd, 2) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }\n            }\n            if null_rfd > 2 { _ := c_close(null_rfd) }\n            if null_wfd > 2 { _ := c_close(null_wfd) }\n\n            // Restore default SIGPIPE disposition before execve.\n            _ := c_signal(13, ptr(0))\n\n            if child_err == 0 {\n                var saw_perm := false\n                var last_e := 2\n                for ci in 0..candidates.len {\n                    _ := c_execve(candidates[ci], argv_ptr, envp_ptr)\n                    e := portable_errno(load_i32(errno_ptr), is_darwin)\n                    if e == 13 { saw_perm = true }\n                    if e != 2 && e != 20 { last_e = e }\n                }\n                if saw_perm { child_err = 13 } else { child_err = last_e }\n            }\n\n            var msg: [u8; 4] = [\n                u8(child_err.bit_and(255)),\n                u8(child_err.shr(8).bit_and(255)),\n                u8(child_err.shr(16).bit_and(255)),\n                u8(child_err.shr(24).bit_and(255)),\n            ]\n            _ := c_write(err_fds[1], addr(&msg[0]), 4)\n            _ := c_close(err_fds[1])\n            c_exit(127)\n            return SpawnResult { ok: false, child: dead_child(), error: 127 }\n        }\n\n        // Parent side\n        _ := c_setpgid(pid, pid)\n        _ := c_close(err_fds[1])\n        if in_fds[0] >= 0 { _ := c_close(in_fds[0]) }\n        if out_fds[1] >= 0 { _ := c_close(out_fds[1]) }\n        if err_out_fds[1] >= 0 { _ := c_close(err_out_fds[1]) }\n        if usize(null_read) != 0 { _ := c_fclose(null_read) }\n        if usize(null_write) != 0 { _ := c_fclose(null_write) }\n\n        var err_buf: [u8; 4] = [0, 0, 0, 0]\n        var err_got := 0\n        while err_got < 4 {\n            n := c_read(err_fds[0], ptr(usize(addr(&mut err_buf[0])) + usize(err_got)), usize(4 - err_got))\n            if n == 0 { break }\n            if n < 0 {\n                e := load_i32(errno_ptr)\n                if e == 4 { continue }\n                break\n            }\n            err_got += i32(n)\n        }\n        _ := c_close(err_fds[0])\n\n        if err_got == 4 {\n            exec_lo := i32(err_buf[0]).bit_or(i32(err_buf[1]).shl(8))\n            exec_hi := i32(err_buf[2]).shl(16).bit_or(i32(err_buf[3]).shl(24))\n            exec_err := exec_lo.bit_or(exec_hi)\n            var wstatus := 0\n            while c_waitpid(pid, addr(&mut wstatus), 0) < 0 {\n                if load_i32(errno_ptr) != 4 { break }\n            }\n            if in_fds[1] >= 0 { _ := c_close(in_fds[1]) }\n            if out_fds[0] >= 0 { _ := c_close(out_fds[0]) }\n            if err_out_fds[0] >= 0 { _ := c_close(err_out_fds[0]) }\n            return SpawnResult { ok: false, child: dead_child(), error: exec_err }\n        }\n\n        if in_fds[1] >= 0 { _ := sys.net_set_nonblocking(in_fds[1], true) }\n        if out_fds[0] >= 0 { _ := sys.net_set_nonblocking(out_fds[0], true) }\n        if err_out_fds[0] >= 0 { _ := sys.net_set_nonblocking(err_out_fds[0], true) }\n\n        return SpawnResult {\n            ok: true,\n            child: Child {\n                pid: pid,\n                pgid: pid,\n                stdin_fd: in_fds[1],\n                stdout_fd: out_fds[0],\n                stderr_fd: err_out_fds[0],\n                reaped: false,\n                code: 0,\n                signal: 0,\n            },\n            error: 0,\n        }\n    }\n    SpawnResult { ok: false, child: dead_child(), error: 45 }\n}\n\nfn decode_wait_status(child: &mut Child, wstatus: i32) {\n    child.reaped = true\n    sig := wstatus.bit_and(127)\n    if sig != 0 {\n        child.signal = sig\n        child.code = 128 + sig\n    } else {\n        child.signal = 0\n        child.code = wstatus.shr(8).bit_and(255)\n    }\n}\n\npub fn child_pid(child: &Child) -> i32 { child.pid }\n\npub fn close_stdin(child: &mut Child) {\n    if child.stdin_fd >= 0 {\n        _ := sys.net_close(child.stdin_fd)\n        child.stdin_fd = -1\n    }\n}\n\npub fn close_pipes(child: &mut Child) {\n    close_stdin(&mut child)\n    if child.stdout_fd >= 0 { _ := sys.net_close(child.stdout_fd); child.stdout_fd = -1 }\n    if child.stderr_fd >= 0 { _ := sys.net_close(child.stderr_fd); child.stderr_fd = -1 }\n}\n\nfn signal_group(child: &Child, sig: i32) -> sys.Status {\n    if child.reaped || child.pid <= 0 { return sys.Status { ok: true, error: 0 } }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        if c_kill(-child.pgid, sig) == 0 || c_kill(child.pid, sig) == 0 {\n            return sys.Status { ok: true, error: 0 }\n        }\n    }\n    sys.Status { ok: true, error: 0 }\n}\n\npub fn terminate(child: &mut Child) -> sys.Status { signal_group(&child, 15) }\npub fn kill(child: &mut Child) -> sys.Status { signal_group(&child, 9) }\n\npub fn try_wait(child: &mut Child) -> WaitResult {\n    if child.reaped {\n        return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }\n    }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        var wstatus := 0\n        r := c_waitpid(child.pid, addr(&mut wstatus), 1)\n        if r == child.pid {\n            decode_wait_status(&mut child, wstatus)\n            return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }\n        }\n        if r == 0 {\n            return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }\n        }\n    }\n    WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n}\n\npub fn wait(child: &mut Child, timeout_ms: i64) -> WaitResult {\n    if child.reaped {\n        close_pipes(&mut child)\n        return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }\n    }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        var wstatus := 0\n        if timeout_ms <= 0 {\n            while true {\n                r := c_waitpid(child.pid, addr(&mut wstatus), 0)\n                if r == child.pid {\n                    decode_wait_status(&mut child, wstatus)\n                    close_pipes(&mut child)\n                    return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }\n                }\n                if r < 0 && c_kill(child.pid, 0) != 0 { break }\n            }\n            close_pipes(&mut child)\n            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n        }\n\n        start := sys.now_ms()\n        while true {\n            r := c_waitpid(child.pid, addr(&mut wstatus), 1)\n            if r == child.pid {\n                decode_wait_status(&mut child, wstatus)\n                close_pipes(&mut child)\n                return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }\n            }\n            now := sys.now_ms()\n            if now - start >= timeout_ms {\n                _ := kill(&mut child)\n                while c_waitpid(child.pid, addr(&mut wstatus), 0) < 0 {\n                    if c_kill(child.pid, 0) != 0 { break }\n                }\n                decode_wait_status(&mut child, wstatus)\n                child.code = 124\n                close_pipes(&mut child)\n                return WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: child.signal, error: 60 }\n            }\n            sys.sleep_ms(2)\n        }\n    }\n    WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n}\n\nfn read_pipe(fd: &mut i32, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n    if fd < 0 { return 0 }\n    if max_bytes <= 0 { return 0 }\n    var poll_buf: []u8 = []\n    bytes.append_le(&mut poll_buf, i64(fd), 4)\n    bytes.append_le(&mut poll_buf, 1, 2)\n    bytes.append_le(&mut poll_buf, 0, 2)\n    var chunk := 65536\n    if max_bytes < 65536 { chunk = i32(max_bytes) }\n    out.reserve(out.len + chunk)\n    n := sys.net_read(fd, &mut out, max_bytes)\n    if n > 0 { return n }\n    if n == 0 { _ := sys.net_close(fd); fd = -1; return 0 }\n    if n != -35 { return n }\n    if timeout_ms == 0 { return -35 }\n    pr := sys.net_poll(&mut poll_buf, 1, timeout_ms)\n    if pr < 0 { return pr }\n    if pr == 0 { return -35 }\n    n2 := sys.net_read(fd, &mut out, max_bytes)\n    if n2 == 0 { _ := sys.net_close(fd); fd = -1; return 0 }\n    n2\n}\n\npub fn read_stdout(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n    read_pipe(&mut child.stdout_fd, &mut out, max_bytes, timeout_ms)\n}\n\npub fn read_stderr(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n    read_pipe(&mut child.stderr_fd, &mut out, max_bytes, timeout_ms)\n}\n\npub fn read_stdout_line(child: &mut Child, timeout_ms: i64) -> sys.TextResult {\n    start := sys.now_ms()\n    var line: []u8 = []\n    while line.len < 65536 {\n        var rem: i64 = -1\n        if timeout_ms > 0 {\n            elapsed := sys.now_ms() - start\n            if elapsed >= timeout_ms {\n                return sys.TextResult { ok: false, value: \"\", error: 60 }\n            }\n            rem = timeout_ms - elapsed\n        }\n        before := line.len\n        n := read_stdout(&mut child, &mut line, 1, rem)\n        if n == 0 {\n            if line.len == 0 { return sys.TextResult { ok: false, value: \"\", error: 5 } }\n            break\n        }\n        if n == -35 {\n            return sys.TextResult { ok: false, value: \"\", error: 60 }\n        }\n        if n < 0 {\n            return sys.TextResult { ok: false, value: \"\", error: i32(-n) }\n        }\n        if line.len > before && line[line.len - 1] == b'\\n' {\n            break\n        }\n    }\n    var end := line.len\n    if end > 0 && line[end - 1] == b'\\n' { end -= 1 }\n    if end > 0 && line[end - 1] == b'\\r' { end -= 1 }\n    bytes.decode_range(&line, 0, end)\n}\n\npub fn write_stdin(child: &mut Child, data: &[]u8) -> sys.Status {\n    if child.stdin_fd < 0 { return sys.Status { ok: false, error: 9 } }\n    if data.len == 0 { return sys.Status { ok: true, error: 0 } }\n    is_darwin := host_os() == \"macos\"\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        errno_ptr := resolve_errno_ptr(is_darwin)\n        var off := 0\n        var poll_buf: []u8 = []\n        while off < data.len {\n            p := ptr(usize(addr(&data[0])) + usize(off))\n            n := c_write(child.stdin_fd, p, usize(data.len - off))\n            if n > 0 { off += i32(n); continue }\n            e := portable_errno(load_i32(errno_ptr), is_darwin)\n            if e == 4 { continue }\n            if e == 35 {\n                poll_buf.clear()\n                bytes.append_le(&mut poll_buf, i64(child.stdin_fd), 4)\n                bytes.append_le(&mut poll_buf, 4, 2)\n                bytes.append_le(&mut poll_buf, 0, 2)\n                _ := sys.net_poll(&mut poll_buf, 1, 100)\n                continue\n            }\n            return sys.Status { ok: false, error: e }\n        }\n    }\n    sys.Status { ok: true, error: 0 }\n}\n\nfn exec_internal(program: string, cmd: &Command) -> Output {\n    var actual := cmd\n    if actual.stdin_data.len > 0 { actual.stdin_mode = .Pipe }\n    sp := spawn_internal(program, &actual)\n    if !sp.ok {\n        return Output {\n            ok: false, error: sp.error, code: 127, signal: 0, timed_out: false,\n            stdout: [], stderr: [],\n        }\n    }\n    var child := sp.child\n    var out_bytes: []u8 = []\n    var err_bytes: []u8 = []\n    var in_off := 0\n    if actual.stdin_mode == .Pipe && actual.stdin_data.len == 0 {\n        close_stdin(&mut child)\n    }\n\n    is_darwin := host_os() == \"macos\"\n    start := sys.now_ms()\n    var poll_buf: []u8 = []\n    var fd_roles: []i32 = []\n\n    while child.stdin_fd >= 0 || child.stdout_fd >= 0 || child.stderr_fd >= 0 {\n        if actual.timeout_ms > 0 && sys.now_ms() - start >= actual.timeout_ms {\n            _ := kill(&mut child)\n            w := wait(&mut child, 1000)\n            return Output {\n                ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,\n                stdout: out_bytes, stderr: err_bytes,\n            }\n        }\n\n        poll_buf.clear()\n        fd_roles.clear()\n        if child.stdin_fd >= 0 {\n            bytes.append_le(&mut poll_buf, i64(child.stdin_fd), 4)\n            bytes.append_le(&mut poll_buf, 4, 2)\n            bytes.append_le(&mut poll_buf, 0, 2)\n            fd_roles.push(0)\n        }\n        if child.stdout_fd >= 0 {\n            bytes.append_le(&mut poll_buf, i64(child.stdout_fd), 4)\n            bytes.append_le(&mut poll_buf, 1, 2)\n            bytes.append_le(&mut poll_buf, 0, 2)\n            fd_roles.push(1)\n        }\n        if child.stderr_fd >= 0 {\n            bytes.append_le(&mut poll_buf, i64(child.stderr_fd), 4)\n            bytes.append_le(&mut poll_buf, 1, 2)\n            bytes.append_le(&mut poll_buf, 0, 2)\n            fd_roles.push(2)\n        }\n\n        var wait_ms: i64 = -1\n        if actual.timeout_ms > 0 {\n            rem := actual.timeout_ms - (sys.now_ms() - start)\n            if rem <= 0 { continue }\n            wait_ms = rem\n        }\n        _ := sys.net_poll(&mut poll_buf, i64(fd_roles.len), wait_ms)\n\n        for idx in 0..fd_roles.len {\n            revents := bytes.u16_le(&poll_buf, idx * 8 + 6)\n            if revents == 0 { continue }\n            role := fd_roles[idx]\n            if role == 0 && child.stdin_fd >= 0 {\n                unsafe {\n                    _ := static_bytes(\"native\", 16)\n                    errno_ptr := resolve_errno_ptr(is_darwin)\n                    while in_off < actual.stdin_data.len {\n                        p := ptr(usize(addr(&actual.stdin_data[0])) + usize(in_off))\n                        n := c_write(child.stdin_fd, p, usize(actual.stdin_data.len - in_off))\n                        if n > 0 { in_off += i32(n); continue }\n                        e := portable_errno(load_i32(errno_ptr), is_darwin)\n                        if e == 4 { continue }\n                        if e != 35 { in_off = actual.stdin_data.len }\n                        break\n                    }\n                }\n                if in_off >= actual.stdin_data.len { close_stdin(&mut child) }\n            } else if role == 1 && child.stdout_fd >= 0 {\n                while child.stdout_fd >= 0 {\n                    if i64(out_bytes.len) >= actual.max_output_bytes {\n                        _ := kill(&mut child)\n                        _ := wait(&mut child, 1000)\n                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }\n                    }\n                    out_bytes.reserve(out_bytes.len + 16384)\n                    n := sys.net_read(child.stdout_fd, &mut out_bytes, 65536)\n                    if n > 0 { continue }\n                    if n == 0 || n != -35 {\n                        _ := sys.net_close(child.stdout_fd)\n                        child.stdout_fd = -1\n                    }\n                    break\n                }\n            } else if role == 2 && child.stderr_fd >= 0 {\n                while child.stderr_fd >= 0 {\n                    if i64(err_bytes.len) >= actual.max_output_bytes {\n                        _ := kill(&mut child)\n                        _ := wait(&mut child, 1000)\n                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }\n                    }\n                    err_bytes.reserve(err_bytes.len + 16384)\n                    n := sys.net_read(child.stderr_fd, &mut err_bytes, 65536)\n                    if n > 0 { continue }\n                    if n == 0 || n != -35 {\n                        _ := sys.net_close(child.stderr_fd)\n                        child.stderr_fd = -1\n                    }\n                    break\n                }\n            }\n        }\n    }\n\n    var rem_wait: i64 = 0\n    if actual.timeout_ms > 0 {\n        rem_wait = actual.timeout_ms - (sys.now_ms() - start)\n        if rem_wait <= 0 { rem_wait = 1 }\n    }\n    w := wait(&mut child, rem_wait)\n    if w.timed_out {\n        return Output {\n            ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,\n            stdout: out_bytes, stderr: err_bytes,\n        }\n    }\n    Output {\n        ok: w.ok, error: w.error, code: w.code, signal: w.signal, timed_out: false,\n        stdout: out_bytes, stderr: err_bytes,\n    }\n}\n\n@requires(process)\npub fn exec(cmd: &Command) -> Output { exec_internal(cmd.program, &cmd) }\n\n@requires(process)\npub fn run(program: string, args: []string) -> Output {\n    cmd := command(program, args)\n    exec_internal(program, &cmd)\n}\n\n@requires(process)\npub fn run_in(program: string, args: []string, cwd: string) -> Output {\n    var cmd := command(program, args)\n    cmd.cwd = cwd\n    exec_internal(program, &cmd)\n}\n\n@requires(process)\npub fn status(program: string, args: []string) -> WaitResult {\n    var cmd := command(program, args)\n    inherit_stdio(&mut cmd)\n    sp := spawn_internal(program, &cmd)\n    if !sp.ok {\n        return WaitResult { ok: false, exited: false, timed_out: false, code: 127, signal: 0, error: sp.error }\n    }\n    var child := sp.child\n    wait(&mut child, 0)\n}\n\n@requires(process)\npub fn spawn(cmd: &Command) -> SpawnResult { spawn_internal(cmd.program, &cmd) }\n\npub fn exec_granted(exe: &Executable, cmd: &Command) -> Output { exec_internal(exe.program, &cmd) }\n\npub fn run_granted(exe: &Executable, args: []string) -> Output {\n    cmd := command(exe.program, args)\n    exec_internal(exe.program, &cmd)\n}\n\npub fn spawn_granted(exe: &Executable, cmd: &Command) -> SpawnResult { spawn_internal(exe.program, &cmd) }\n\n\npub opaque struct ChildSet {\n    cap: i32,\n    count: i32,\n    active: []bool,\n    pids: []i32,\n    pgids: []i32,\n    stdin_fds: []i32,\n    stdout_fds: []i32,\n    stderr_fds: []i32,\n    reaped: []bool,\n    codes: []i32,\n    signals: []i32,\n    poll_buf: []u8,\n}\n\npub fn set_new(capacity: i32) -> ChildSet {\n    assert(capacity > 0 && capacity <= 1024)\n    var s := ChildSet {\n        cap: capacity, count: 0, active: [], pids: [], pgids: [],\n        stdin_fds: [], stdout_fds: [], stderr_fds: [],\n        reaped: [], codes: [], signals: [], poll_buf: [],\n    }\n    for _ in 0..capacity {\n        s.active.push(false)\n        s.pids.push(-1)\n        s.pgids.push(-1)\n        s.stdin_fds.push(-1)\n        s.stdout_fds.push(-1)\n        s.stderr_fds.push(-1)\n        s.reaped.push(false)\n        s.codes.push(0)\n        s.signals.push(0)\n    }\n    s\n}\n\npub fn set_len(set: &ChildSet) -> i32 { set.count }\n\npub fn set_active(set: &ChildSet, slot: i32) -> bool {\n    slot >= 0 && slot < set.cap && set.active[slot]\n}\n\npub fn set_insert(set: &mut ChildSet, child: &mut Child) -> i32 {\n    if child.pid <= 0 { return -1 }\n    for slot in 0..set.cap {\n        if !set.active[slot] {\n            set.active[slot] = true\n            set.pids[slot] = child.pid\n            set.pgids[slot] = child.pgid\n            set.stdin_fds[slot] = child.stdin_fd\n            set.stdout_fds[slot] = child.stdout_fd\n            set.stderr_fds[slot] = child.stderr_fd\n            set.reaped[slot] = child.reaped\n            set.codes[slot] = child.code\n            set.signals[slot] = child.signal\n            set.count += 1\n            child.pid = -1\n            child.pgid = -1\n            child.stdin_fd = -1\n            child.stdout_fd = -1\n            child.stderr_fd = -1\n            child.reaped = true\n            return slot\n        }\n    }\n    -1\n}\n\nfn drain_fd_all(fd: &mut i32, out: &mut []u8) {\n    while fd >= 0 {\n        out.reserve(out.len + 16384)\n        n := sys.net_read(fd, &mut out, 65536)\n        if n > 0 { continue }\n        if n == 0 { _ := sys.net_close(fd); fd = -1 }\n        break\n    }\n}\n\npub fn set_drain(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) {\n    if slot < 0 || slot >= set.cap || !set.active[slot] { return }\n    var out_fd := set.stdout_fds[slot]\n    drain_fd_all(&mut out_fd, &mut stdout_out)\n    set.stdout_fds[slot] = out_fd\n    var err_fd := set.stderr_fds[slot]\n    drain_fd_all(&mut err_fd, &mut stderr_out)\n    set.stderr_fds[slot] = err_fd\n}\n\nfn close_slot_fds(set: &mut ChildSet, slot: i32) {\n    if set.stdin_fds[slot] >= 0 { _ := sys.net_close(set.stdin_fds[slot]); set.stdin_fds[slot] = -1 }\n    if set.stdout_fds[slot] >= 0 { _ := sys.net_close(set.stdout_fds[slot]); set.stdout_fds[slot] = -1 }\n    if set.stderr_fds[slot] >= 0 { _ := sys.net_close(set.stderr_fds[slot]); set.stderr_fds[slot] = -1 }\n}\n\npub fn set_wait_any(set: &mut ChildSet, timeout_ms: i64) -> i32 {\n    if set.count <= 0 { return 0 }\n    set.poll_buf.clear()\n    var nfds := 0\n    var has_pipeless := false\n    for slot in 0..set.cap {\n        if !set.active[slot] { continue }\n        out_fd := set.stdout_fds[slot]\n        err_fd := set.stderr_fds[slot]\n        if out_fd >= 0 {\n            bytes.append_le(&mut set.poll_buf, i64(out_fd), 4)\n            bytes.append_le(&mut set.poll_buf, 1, 2)\n            bytes.append_le(&mut set.poll_buf, 0, 2)\n            nfds += 1\n        }\n        if err_fd >= 0 {\n            bytes.append_le(&mut set.poll_buf, i64(err_fd), 4)\n            bytes.append_le(&mut set.poll_buf, 1, 2)\n            bytes.append_le(&mut set.poll_buf, 0, 2)\n            nfds += 1\n        }\n        if out_fd < 0 && err_fd < 0 { has_pipeless = true }\n    }\n    var wait_ms := timeout_ms\n    if has_pipeless && (wait_ms < 0 || wait_ms > 1) { wait_ms = 1 }\n    if nfds == 0 {\n        if wait_ms > 0 { sys.sleep_ms(wait_ms) }\n        return 0\n    }\n    i32(sys.net_poll(&mut set.poll_buf, i64(nfds), wait_ms))\n}\n\npub fn set_try_wait(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {\n    if slot < 0 || slot >= set.cap || !set.active[slot] {\n        return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }\n    }\n    set_drain(&mut set, slot, &mut stdout_out, &mut stderr_out)\n    if set.reaped[slot] {\n        close_slot_fds(&mut set, slot)\n        code := set.codes[slot]\n        sig := set.signals[slot]\n        set.active[slot] = false\n        set.pids[slot] = -1\n        set.count -= 1\n        return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }\n    }\n    unsafe {\n        _ := static_bytes(\"native\", 8)\n        pid := set.pids[slot]\n        var wstatus := 0\n        var r := c_waitpid(pid, addr(&mut wstatus), 1)\n        if r == 0 && set.stdout_fds[slot] < 0 && set.stderr_fds[slot] < 0 {\n            _ := c_usleep(50)\n            r = c_waitpid(pid, addr(&mut wstatus), 1)\n        }\n        if r == pid {\n            set_drain(&mut set, slot, &mut stdout_out, &mut stderr_out)\n            close_slot_fds(&mut set, slot)\n            sig := wstatus.bit_and(127)\n            var code := wstatus.shr(8).bit_and(255)\n            if sig != 0 { code = 128 + sig }\n            set.active[slot] = false\n            set.pids[slot] = -1\n            set.count -= 1\n            return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }\n        }\n        if r == 0 {\n            return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }\n        }\n    }\n    close_slot_fds(&mut set, slot)\n    set.active[slot] = false\n    set.pids[slot] = -1\n    set.count -= 1\n    WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n}\n\npub fn set_kill_reap(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {\n    if slot < 0 || slot >= set.cap || !set.active[slot] {\n        return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }\n    }\n    unsafe {\n        _ := static_bytes(\"native\", 8)\n        pid := set.pids[slot]\n        pgid := set.pgids[slot]\n        if pgid > 0 && c_kill(-pgid, 9) == 0 {\n            // Killed process group\n        } else if pid > 0 {\n            _ := c_kill(pid, 9)\n        }\n        var wstatus := 0\n        while c_waitpid(pid, addr(&mut wstatus), 0) < 0 {\n            if c_kill(pid, 0) != 0 { break }\n        }\n    }\n    set_drain(&mut set, slot, &mut stdout_out, &mut stderr_out)\n    close_slot_fds(&mut set, slot)\n    set.active[slot] = false\n    set.pids[slot] = -1\n    set.count -= 1\n    WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: 9, error: 60 }\n}\n\npub fn set_kill_all(set: &mut ChildSet) {\n    var sink_out: []u8 = []\n    var sink_err: []u8 = []\n    for slot in 0..set.cap {\n        if set.active[slot] {\n            _ := set_kill_reap(&mut set, slot, &mut sink_out, &mut sink_err)\n            sink_out.clear()\n            sink_err.clear()\n        }\n    }\n}\n" }
    if name == "set" { return "import std.hash as hashing\n\npub struct Set { keys: []string, slots: []i32, length: i32, used: i32 }\npub fn new() -> Set { Set { keys: [], slots: [], length: 0, used: 0 } }\npub fn length(values: &Set) -> i32 { values.length }\nfn locate(values: &Set, key: string) -> i32 {\n    capacity := values.slots.len\n    if capacity == 0 { return -1 }\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    for step in 0..capacity {\n        state := values.slots[slot]\n        if state == 0 { return -1 }\n        if state == 1 && values.keys[slot] == key { return slot }\n        slot = (slot + 1) % capacity\n    }\n    -1\n}\npub fn contains(values: &Set, key: string) -> bool { locate(&values, key) >= 0 }\nfn insert_slot(values: &mut Set, key: string) {\n    capacity := values.slots.len\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    while values.slots[slot] == 1 { slot = (slot + 1) % capacity }\n    if values.slots[slot] == 0 { values.used = values.used + 1 }\n    values.slots[slot] = 1\n    values.keys[slot] = key\n    values.length = values.length + 1\n}\nfn rehash(values: &mut Set, capacity: i32) {\n    var fresh := new()\n    fresh.keys.reserve(capacity)\n    fresh.slots.reserve(capacity)\n    for i in 0..capacity { fresh.keys.push(\"\"); fresh.slots.push(0) }\n    for i in 0..values.slots.len {\n        if values.slots[i] == 1 { insert_slot(&mut fresh, values.keys[i]) }\n    }\n    values = fresh\n}\npub fn reserve(values: &mut Set, entries: i32) {\n    assert(entries >= 0)\n    var capacity := 8\n    while i64(capacity) * 7 < i64(entries) * 10 { capacity = capacity * 2 }\n    if capacity > values.slots.len { rehash(&mut values, capacity) }\n}\npub fn insert(values: &mut Set, key: string) -> bool {\n    if contains(&values, key) { return false }\n    capacity := values.slots.len\n    if capacity == 0 { rehash(&mut values, 8) }\n    else if (values.used + 1) * 10 >= capacity * 7 {\n        if (values.length + 1) * 10 < capacity * 4 { rehash(&mut values, capacity) }\n        else { rehash(&mut values, capacity * 2) }\n    }\n    insert_slot(&mut values, key)\n    true\n}\npub fn remove(values: &mut Set, key: string) -> bool {\n    slot := locate(&values, key)\n    if slot < 0 { return false }\n    values.slots[slot] = 2\n    values.keys[slot] = \"\"\n    values.length = values.length - 1\n    true\n}\npub fn clear(values: &mut Set) {\n    for i in 0..values.slots.len { values.slots[i] = 0; values.keys[i] = \"\" }\n    values.length = 0\n    values.used = 0\n}\npub fn items(values: &Set) -> []string {\n    var result: []string = []\n    result.reserve(values.length)\n    for i in 0..values.slots.len { if values.slots[i] == 1 { result.push(values.keys[i]) } }\n    result\n}\n@test fn set_deduplicates_utf8_and_survives_tombstones() {\n    var collisions := new()\n    insert(&mut collisions, \"a\"); insert(&mut collisions, \"i\"); insert(&mut collisions, \"q\"); insert(&mut collisions, \"y\")\n    remove(&mut collisions, \"a\")\n    !insert(&mut collisions, \"q\")\n    contains(&collisions, \"y\")\n    length(&collisions) == 3\n    var values := new()\n    insert(&mut values, \"\")\n    insert(&mut values, \"🌍\")\n    !insert(&mut values, \"🌍\")\n    for i in 0..1000 { insert(&mut values, i.str()) }\n    length(&values) == 1002\n    copy := values\n    for i in 0..1000 { remove(&mut values, i.str()) }\n    length(&values) == 2\n    length(&copy) == 1002\n    for i in 0..1000 { insert(&mut values, i.str()) }\n    items(&values).len == 1002\n    clear(&mut values)\n    !contains(&values, \"🌍\")\n    insert(&mut values, \"after clear\")\n    length(&values) == 1\n}\n" }
    if name == "sha256" { return "import std.bytes as bytes\nfn push_word(out: &mut []u8, v: i64) {\n    out.push(u8(v.shr(24).bit_and(255)))\n    out.push(u8(v.shr(16).bit_and(255)))\n    out.push(u8(v.shr(8).bit_and(255)))\n    out.push(u8(v.bit_and(255)))\n}\n// Hash a contiguous range without copying full message blocks.\npub fn digest_range(input: &[]u8, start: i32, length: i32) -> []u8 {\n    assert(start >= 0 && start <= input.len && length >= 0 && length <= input.len - start)\n    constants: [i64; 64] = [\n        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,\n        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,\n        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,\n        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,\n        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,\n        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,\n        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,\n        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298\n    ]\n    var h0: i64 = 1779033703; var h1: i64 = 3144134277\n    var h2: i64 = 1013904242; var h3: i64 = 2773480762\n    var h4: i64 = 1359893119; var h5: i64 = 2600822924\n    var h6: i64 = 528734635; var h7: i64 = 1541459225\n    full := length / 64\n    remainder := length % 64\n    var tail_length := 64\n    if remainder >= 56 { tail_length = 128 }\n    var tail: [u8; 128] = [0; 128]\n    for i in 0..remainder { tail[i] = input[start + full * 64 + i] }\n    tail[remainder] = 128\n    bits := i64(length) * 8\n    for i in 0..8 { tail[tail_length - 1 - i] = u8(bits.shr(i * 8).bit_and(255)) }\n\n    var w: [i64; 64] = [0; 64]\n    for block in 0..full + tail_length / 64 {\n        if block < full {\n            base := start + block * 64\n            for i in 0..16 {\n                at := base + 4 * i\n                w[i] = i64(input[at]).shl(24).bit_or(i64(input[at + 1]).shl(16)).bit_or(i64(input[at + 2]).shl(8)).bit_or(i64(input[at + 3]))\n            }\n        } else {\n            base := (block - full) * 64\n            for i in 0..16 {\n                at := base + 4 * i\n                w[i] = i64(tail[at]).shl(24).bit_or(i64(tail[at + 1]).shl(16)).bit_or(i64(tail[at + 2]).shl(8)).bit_or(i64(tail[at + 3]))\n            }\n        }\n        for i in 16..64 {\n            a := w[i - 15]\n            b := w[i - 2]\n            // Repeating a 32-bit word in both halves makes each rotate a shift.\n            doubled_a := a.bit_or(a.shl(32))\n            doubled_b := b.bit_or(b.shl(32))\n            s0 := doubled_a.shr(7).bit_xor(doubled_a.shr(18)).bit_xor(a.shr(3)).bit_and(4294967295)\n            s1 := doubled_b.shr(17).bit_xor(doubled_b.shr(19)).bit_xor(b.shr(10)).bit_and(4294967295)\n            w[i] = (w[i - 16] + s0 + w[i - 7] + s1).bit_and(4294967295)\n        }\n        var a := h0; var b := h1; var c := h2; var d := h3\n        var e := h4; var f := h5; var g := h6; var h := h7\n        for i in 0..64 {\n            doubled_e := e.bit_or(e.shl(32))\n            doubled_a := a.bit_or(a.shl(32))\n            s1 := doubled_e.shr(6).bit_xor(doubled_e.shr(11)).bit_xor(doubled_e.shr(25)).bit_and(4294967295)\n            choose := g.bit_xor(e.bit_and(f.bit_xor(g)))\n            first := h + s1 + choose + constants[i] + w[i]\n            s0 := doubled_a.shr(2).bit_xor(doubled_a.shr(13)).bit_xor(doubled_a.shr(22)).bit_and(4294967295)\n            majority := a.bit_and(b).bit_or(c.bit_and(a.bit_or(b)))\n            second := s0 + majority\n            h = g; g = f; f = e; e = (d + first).bit_and(4294967295)\n            d = c; c = b; b = a; a = (first + second).bit_and(4294967295)\n        }\n        h0 = (h0 + a).bit_and(4294967295); h1 = (h1 + b).bit_and(4294967295)\n        h2 = (h2 + c).bit_and(4294967295); h3 = (h3 + d).bit_and(4294967295)\n        h4 = (h4 + e).bit_and(4294967295); h5 = (h5 + f).bit_and(4294967295)\n        h6 = (h6 + g).bit_and(4294967295); h7 = (h7 + h).bit_and(4294967295)\n    }\n    var result: []u8 = []\n    result.reserve(32)\n    push_word(&mut result, h0); push_word(&mut result, h1); push_word(&mut result, h2); push_word(&mut result, h3)\n    push_word(&mut result, h4); push_word(&mut result, h5); push_word(&mut result, h6); push_word(&mut result, h7)\n    result\n}\npub fn digest_bytes(input: &[]u8) -> []u8 {\n    digest_range(&input, 0, input.len)\n}\nfn widen(input: &[]u8) -> []i32 {\n    var result: []i32 = []\n    result.reserve(input.len)\n    for byte in input { result.push(i32(byte)) }\n    result\n}\npub fn digest(input: &[]i32) -> []i32 {\n    var packed: []u8 = []\n    packed.reserve(input.len)\n    for byte in input {\n        assert(byte >= 0 && byte <= 255)\n        packed.push(u8(byte))\n    }\n    digest := digest_bytes(&packed)\n    widen(&digest)\n}\npub fn text(input: string) -> []i32 {\n    var packed: []u8 = []\n    packed.reserve(input.len)\n    bytes.append_utf8(&mut packed, input)\n    digest := digest_bytes(&packed)\n    widen(&digest)\n}\n@test fn sha256_matches_empty_abc_and_multi_block_reference_vectors() {\n    empty := text(\"\")\n    bytes.hex(&empty) == \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n    abc := text(\"abc\")\n    bytes.hex(&abc) == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n    long := text(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")\n    bytes.hex(&long) == \"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1\"\n}\n@test fn packed_ranges_match_sha256_at_padding_boundaries() {\n    var input: []u8 = []\n    for i in 0..132 { input.push(u8(i)) }\n    lengths := [0, 55, 56, 63, 64, 65, 128]\n    expected := [\n        \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n        \"4653ce834ad1216507f784697481e2134214fb99e203b0e247d86b941b660707\",\n        \"1d742f4c8c512b0d2811d426f99ccdc16103332fac6c1ae4ffaa27535b2875bb\",\n        \"191b2ec5f9d8dd469ce7ddc71e282a89ea317915b2f4b40e7138a7795ba1191f\",\n        \"795430e15796923a557f9da1d980ec9db341e9acd6da682e1cd86303ce6b0b08\",\n        \"40a81d14a50081b4fdf29d5fb626e24cafdc507026f2de40dec3b0370a0e591e\",\n        \"db0d88f6150bf6e6a5d4ac9507b9a7a6b0d144e07e2e9ab67be9fe741788550c\"\n    ]\n    for i in 0..lengths.len {\n        packed := digest_range(&input, 3, lengths[i])\n        wide := widen(&packed)\n        assert(bytes.hex(&wide) == expected[i])\n    }\n}\n" }
    if name == "sys" { return "// macOS/Linux filesystem API. error is zero on success, otherwise a Dunder code.\n// Known Linux errno values map to the original Darwin-compatible codes below.\n// Unmapped Linux errno values use 10000 + errno; see docs/sys.md.\npub struct Status { ok: bool, error: i32 }\npub struct TextResult { ok: bool, value: string, error: i32 }\npub struct BytesResult { ok: bool, value: []u8, error: i32 }\npub struct Metadata { ok: bool, size: i64, is_file: bool, is_dir: bool, error: i32 }\n\npub fn read_text(path: string) -> TextResult { __sys_read_text(path) }\npub fn read_u8_into(path: string, out: &mut []u8, max_bytes: i64) -> Status { __sys_read_u8(path, &mut out, max_bytes) }\npub fn read_u8_limit(path: string, max_bytes: i64) -> BytesResult {\n    if max_bytes < 0 { return BytesResult { ok: false, value: [], error: 22 } }\n    for attempt in 0..4 {\n        info := metadata(path)\n        if !info.ok { return BytesResult { ok: false, value: [], error: info.error } }\n        if info.is_dir { return BytesResult { ok: false, value: [], error: 21 } }\n        if info.size > max_bytes || info.size > 2147483640 {\n            return BytesResult { ok: false, value: [], error: 27 }\n        }\n        var buf: []u8 = []\n        buf.reserve(i32(info.size) + 1)\n        st := read_u8_into(path, &mut buf, max_bytes)\n        if st.ok { return BytesResult { ok: true, value: buf, error: 0 } }\n        if st.error != 35 { return BytesResult { ok: false, value: [], error: st.error } }\n    }\n    BytesResult { ok: false, value: [], error: 35 }\n}\npub fn read_u8(path: string) -> BytesResult { read_u8_limit(path, 67108864) }\npub fn write_text(path: string, text: string) -> Status { __sys_write_text(path, text) }\npub fn write_stderr(text: string) -> Status { __sys_write_stderr(text) }\npub fn eprint(text: string) -> Status { write_stderr(text + \"\\n\") }\npub fn append_text(path: string, text: string) -> Status { __sys_append_text(path, text) }\npub fn mkdir(path: string) -> Status { __sys_mkdir(path) }\npub fn rename(from: string, to: string) -> Status { __sys_rename(from, to) }\npub fn remove_file(path: string) -> Status { __sys_remove_file(path) }\npub fn remove_dir(path: string) -> Status { __sys_remove_dir(path) }\npub fn metadata(path: string) -> Metadata { __sys_metadata(path) }\npub fn pid() -> i32 { __sys_pid() }\npub fn now_ms() -> i64 { __sys_now_ms() }\npub fn sleep_ms(ms: i64) {\n    if ms <= 0 { return }\n    var empty: []u8 = []\n    _ := net_poll(&mut empty, 0, ms)\n}\npub fn arg_count() -> i32 { __sys_arg_count() }\npub fn arg(index: i32) -> string { __sys_arg(index) }\npub fn write_bytes(path: string, bytes: &[]i32) -> Status { __sys_write_bytes(path, &bytes) }\npub fn make_executable(path: string) -> Status { __sys_make_executable(path) }\npub fn write_u8(path: string, bytes: &[]u8) -> Status { __sys_write_u8(path, &bytes) }\npub fn decode_u8(bytes: &[]u8) -> TextResult { __sys_decode_u8(&bytes) }\npub fn decode_u8_range(bytes: &[]u8, start: i64, length: i64) -> TextResult { __sys_decode_u8_range(&bytes, start, length) }\npub fn decode_utf8(bytes: &[]i32) -> TextResult { __sys_decode_utf8(&bytes) }\npub fn same_file(first: string, second: string) -> bool { __sys_same_file(first, second) }\npub fn net_listen(ipv4: i64, port: i64, backlog: i64) -> i64 { __sys_net_listen(ipv4, port, backlog) }\npub fn net_accept(listen_fd: i32) -> i64 { __sys_net_accept(listen_fd) }\npub fn net_connect(ipv4: i64, port: i64) -> i64 { __sys_net_connect(ipv4, port) }\npub fn net_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_read(fd, &mut out, max_bytes) }\npub fn net_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 { __sys_net_write(fd, &data, offset, length) }\npub fn net_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 { __sys_net_poll(&mut fds, nfds, timeout_ms) }\npub fn net_set_nonblocking(fd: i32, enabled: bool) -> i64 { __sys_net_set_nonblocking(fd, enabled) }\npub fn net_set_nodelay(fd: i32, enabled: bool) -> i64 { __sys_net_set_nodelay(fd, enabled) }\npub fn net_local_port(fd: i32) -> i64 { __sys_net_local_port(fd) }\npub fn net_shutdown_write(fd: i32) -> i64 { __sys_net_shutdown_write(fd) }\npub fn net_close(fd: i32) -> i64 { __sys_net_close(fd) }\n\n@test {\n    (0) -> \"ok\"\n    (2) -> \"no such file or directory\"\n    (92) -> \"invalid UTF-8\"\n    (12345) -> \"OS error 12345\"\n}\npub fn error_message(error: i32) -> string {\n    if error == 0 { return \"ok\" }\n    if error == 2 { return \"no such file or directory\" }\n    if error == 5 { return \"I/O error\" }\n    if error == 9 { return \"bad file descriptor\" }\n    if error == 12 { return \"out of memory\" }\n    if error == 13 { return \"permission denied\" }\n    if error == 17 { return \"already exists\" }\n    if error == 20 { return \"not a directory\" }\n    if error == 21 { return \"is a directory\" }\n    if error == 22 { return \"invalid argument\" }\n    if error == 27 { return \"file too large\" }\n    if error == 32 { return \"broken pipe\" }\n    if error == 35 { return \"temporarily unavailable\" }\n    if error == 36 { return \"operation in progress\" }\n    if error == 45 { return \"not supported\" }\n    if error == 48 { return \"address already in use\" }\n    if error == 53 { return \"connection aborted\" }\n    if error == 54 { return \"connection reset\" }\n    if error == 60 { return \"timed out\" }\n    if error == 61 { return \"connection refused\" }\n    if error == 63 { return \"path too long\" }\n    if error == 66 { return \"directory not empty\" }\n    if error == 92 { return \"invalid UTF-8\" }\n    \"OS error \" + error.str()\n}\n\npub enum FileKind { Other = 0, File = 1, Directory = 2 }\npub enum IoError {\n    Other(i32) = 0,\n    NotFound = 2,\n    BadDescriptor = 9,\n    OutOfMemory = 12,\n    PermissionDenied = 13,\n    AlreadyExists = 17,\n    NotDirectory = 20,\n    IsDirectory = 21,\n    InvalidArgument = 22,\n    TooLarge = 27,\n    BrokenPipe = 32,\n    Changed = 35,\n    InProgress = 36,\n    Unsupported = 45,\n    AddressInUse = 48,\n    ConnectionAborted = 53,\n    ConnectionReset = 54,\n    TimedOut = 60,\n    ConnectionRefused = 61,\n    NameTooLong = 63,\n    NotEmpty = 66,\n    InvalidUtf8 = 92,\n}\npub enum ReadResult { Ok(string), Err(IoError) }\n\npub fn read(path: string) -> ReadResult {\n    result := read_text(path)\n    if result.ok { .Ok(result.value) }\n    else { .Err(error_from_code(result.error)) }\n}\n\npub fn file_kind(info: Metadata) -> FileKind {\n    if info.is_file { .File }\n    else if info.is_dir { .Directory }\n    else { .Other }\n}\n\npub fn error_from_code(error: i32) -> IoError {\n    if error == 2 { return .NotFound }\n    if error == 9 { return .BadDescriptor }\n    if error == 12 { return .OutOfMemory }\n    if error == 13 { return .PermissionDenied }\n    if error == 17 { return .AlreadyExists }\n    if error == 20 { return .NotDirectory }\n    if error == 21 { return .IsDirectory }\n    if error == 22 { return .InvalidArgument }\n    if error == 27 { return .TooLarge }\n    if error == 32 { return .BrokenPipe }\n    if error == 35 { return .Changed }\n    if error == 36 { return .InProgress }\n    if error == 45 { return .Unsupported }\n    if error == 48 { return .AddressInUse }\n    if error == 53 { return .ConnectionAborted }\n    if error == 54 { return .ConnectionReset }\n    if error == 60 { return .TimedOut }\n    if error == 61 { return .ConnectionRefused }\n    if error == 63 { return .NameTooLong }\n    if error == 66 { return .NotEmpty }\n    if error == 92 { return .InvalidUtf8 }\n    .Other(error)\n}\n\n@test {\n    (.NotFound) -> 2\n    (.InvalidUtf8) -> 92\n    (.ConnectionReset) -> 54\n    (.Other(12345)) -> 12345\n    error_code(error_from_code(63)) == 63\n    error_code(error_from_code(48)) == 48\n    error_code(error_from_code(54321)) == 54321\n}\npub fn error_code(error: IoError) -> i32 {\n    match error {\n        .NotFound => 2,\n        .BadDescriptor => 9,\n        .OutOfMemory => 12,\n        .PermissionDenied => 13,\n        .AlreadyExists => 17,\n        .NotDirectory => 20,\n        .IsDirectory => 21,\n        .InvalidArgument => 22,\n        .TooLarge => 27,\n        .BrokenPipe => 32,\n        .Changed => 35,\n        .InProgress => 36,\n        .Unsupported => 45,\n        .AddressInUse => 48,\n        .ConnectionAborted => 53,\n        .ConnectionReset => 54,\n        .TimedOut => 60,\n        .ConnectionRefused => 61,\n        .NameTooLong => 63,\n        .NotEmpty => 66,\n        .InvalidUtf8 => 92,\n        .Other(code) => code,\n    }\n}\n\npub fn io_error_message(error: IoError) -> string { error_message(error_code(error)) }\n" }
    if name == "text" { return "pub fn starts_with(text: string, prefix: string) -> bool {\n    if prefix.len > text.len { return false }\n    for i in 0..prefix.len { if text[i] != prefix[i] { return false } }\n    true\n}\npub fn ends_with(text: string, suffix: string) -> bool {\n    if suffix.len > text.len { return false }\n    start := text.len - suffix.len\n    for i in 0..suffix.len { if text[start + i] != suffix[i] { return false } }\n    true\n}\npub fn find(text: string, needle: string) -> i32 {\n    if needle.len == 0 { return 0 }\n    var start := 0\n    while start + needle.len <= text.len {\n        var i := 0\n        while i < needle.len && text[start + i] == needle[i] { i = i + 1 }\n        if i == needle.len { return start }\n        start = start + 1\n    }\n    -1\n}\npub fn split(text: string, separator: string) -> []string {\n    var parts: []string = []\n    if separator.len == 0 { parts.push(text); return parts }\n    var start := 0\n    var cursor := 0\n    while cursor + separator.len <= text.len {\n        var i := 0\n        while i < separator.len && text[cursor + i] == separator[i] { i = i + 1 }\n        if i == separator.len {\n            parts.push(text[start..cursor])\n            cursor = cursor + separator.len\n            start = cursor\n        } else { cursor = cursor + 1 }\n    }\n    if start == 0 { parts.push(text) }\n    else if start == text.len { parts.push(\"\") }\n    else { parts.push(text[start..text.len]) }\n    parts\n}\nfn whitespace(byte: i32) -> bool { byte == 32 || byte == 9 || byte == 10 || byte == 13 }\npub fn trim(text: string) -> string {\n    var start := 0\n    var end := text.len\n    while start < end && whitespace(text[start]) { start = start + 1 }\n    while end > start && whitespace(text[end - 1]) { end = end - 1 }\n    if start == 0 && end == text.len { return text }\n    if start == end { return \"\" }\n    text[start..end]\n}\n@test fn text_search_and_split_handle_utf8_and_empty_parts() {\n    starts_with(\"åäö 🌍\", \"å\")\n    ends_with(\"åäö 🌍\", \"🌍\")\n    find(\"åäö 🌍\", \"🌍\") == 7\n    find(\"åäö 🌍\", \"missing\") == -1\n    parts := split(\"å::🌍::::\", \"::\")\n    parts.len == 4\n    parts[0] == \"å\"\n    parts[1] == \"🌍\"\n    parts[2] == \"\"\n    parts[3] == \"\"\n    trim(\" \\t å 🌍 \\r\\n\") == \"å 🌍\"\n    split(\"\", \"\").len == 1\n}\n" }
    if name == "wire" { return "// Compact binary wire codec over []u8. Zero heap allocations during encoding,\n// explicit bounds checking during decoding, portable across native and wasm32.\nimport std.bytes as bytes\nimport sys\n\npub struct Reader {\n    pos: i32,\n    ok: bool,\n    error: i32, // 0=ok, 1=truncated, 2=overflow/varint, 92=invalid UTF-8\n}\n\npub fn reader() -> Reader { Reader { pos: 0, ok: true, error: 0 } }\n\npub fn remaining(buf: &[]u8, r: &Reader) -> i32 {\n    if !r.ok || r.pos > buf.len { return 0 }\n    buf.len - r.pos\n}\n\npub fn finish(buf: &[]u8, r: &Reader) -> bool {\n    r.ok && r.pos == buf.len\n}\n\nfn fail_read(r: &mut Reader, err: i32) {\n    if r.ok { r.ok = false; r.error = err }\n}\n\npub fn put_u8(out: &mut []u8, v: u8) { out.push(v) }\n\npub fn put_bool(out: &mut []u8, v: bool) {\n    if v { out.push(1) } else { out.push(0) }\n}\n\npub fn put_u16_le(out: &mut []u8, v: u16) {\n    bytes.append_le(&mut out, i64(v), 2)\n}\n\npub fn put_i32_le(out: &mut []u8, v: i32) {\n    bytes.append_le(&mut out, i64(v), 4)\n}\n\npub fn put_u32_le(out: &mut []u8, v: u32) {\n    bytes.append_le(&mut out, i64(v), 4)\n}\n\npub fn put_i64_le(out: &mut []u8, v: i64) {\n    bytes.append_le(&mut out, v, 8)\n}\n\npub fn put_u64_le(out: &mut []u8, v: u64) {\n    for i in 0..8 {\n        out.push(u8(v.shr(i * 8).bit_and(255)))\n    }\n}\n\npub fn put_f32(out: &mut []u8, v: f32) {\n    bits := v.to_bits()\n    bytes.append_le(&mut out, i64(bits), 4)\n}\n\npub fn put_f64(out: &mut []u8, v: f64) {\n    bits := v.to_bits()\n    bytes.append_le(&mut out, bits, 8)\n}\n\n// Unsigned LEB128 varint (1..10 bytes).\npub fn put_uvarint(out: &mut []u8, value: u64) {\n    var v := value\n    while v >= 128 {\n        out.push(u8(v.bit_and(127).bit_or(128)))\n        v = v.shr(7)\n    }\n    out.push(u8(v))\n}\n\n// ZigZag-encoded signed varint so small negative and positive numbers take 1 byte.\npub fn put_varint(out: &mut []u8, value: i64) {\n    var zz: u64 = 0\n    if value < 0 {\n        // (-value - 1) * 2 + 1 without signed overflow on i64::MIN\n        zz = u64(-(value + 1)).shl(1).bit_or(1)\n    } else {\n        zz = u64(value).shl(1)\n    }\n    put_uvarint(&mut out, zz)\n}\n\npub fn put_bytes(out: &mut []u8, data: &[]u8) {\n    put_uvarint(&mut out, u64(data.len))\n    bytes.extend(&mut out, &data)\n}\n\npub fn put_str(out: &mut []u8, text: string) {\n    put_uvarint(&mut out, u64(text.len))\n    bytes.append_utf8(&mut out, text)\n}\n\npub fn read_u8(buf: &[]u8, r: &mut Reader) -> u8 {\n    if !r.ok { return 0 }\n    if r.pos >= buf.len { fail_read(&mut r, 1); return 0 }\n    b := buf[r.pos]\n    r.pos += 1\n    b\n}\n\npub fn read_bool(buf: &[]u8, r: &mut Reader) -> bool {\n    b := read_u8(&buf, &mut r)\n    if !r.ok { return false }\n    if b == 0 { return false }\n    if b == 1 { return true }\n    fail_read(&mut r, 2)\n    false\n}\n\npub fn read_u16_le(buf: &[]u8, r: &mut Reader) -> u16 {\n    if !r.ok { return 0 }\n    if r.pos + 2 > buf.len { fail_read(&mut r, 1); return 0 }\n    v := u16(bytes.u16_le(&buf, r.pos))\n    r.pos += 2\n    v\n}\n\npub fn read_i32_le(buf: &[]u8, r: &mut Reader) -> i32 {\n    if !r.ok { return 0 }\n    if r.pos + 4 > buf.len { fail_read(&mut r, 1); return 0 }\n    raw := bytes.u32_le(&buf, r.pos)\n    r.pos += 4\n    if raw >= 2147483648 { return i32(raw - 4294967296) }\n    i32(raw)\n}\n\npub fn read_u32_le(buf: &[]u8, r: &mut Reader) -> u32 {\n    if !r.ok { return 0 }\n    if r.pos + 4 > buf.len { fail_read(&mut r, 1); return 0 }\n    raw := bytes.u32_le(&buf, r.pos)\n    r.pos += 4\n    u32(raw)\n}\n\npub fn read_i64_le(buf: &[]u8, r: &mut Reader) -> i64 {\n    if !r.ok { return 0 }\n    if r.pos + 8 > buf.len { fail_read(&mut r, 1); return 0 }\n    v := bytes.i64_le(&buf, r.pos)\n    r.pos += 8\n    v\n}\n\npub fn read_u64_le(buf: &[]u8, r: &mut Reader) -> u64 {\n    if !r.ok { return 0 }\n    if r.pos + 8 > buf.len { fail_read(&mut r, 1); return 0 }\n    v := bytes.u64_le(&buf, r.pos)\n    r.pos += 8\n    v\n}\n\npub fn read_f32(buf: &[]u8, r: &mut Reader) -> f32 {\n    bits := read_i32_le(&buf, &mut r)\n    if !r.ok { return 0.0 }\n    f32.from_bits(bits)\n}\n\npub fn read_f64(buf: &[]u8, r: &mut Reader) -> f64 {\n    bits := read_i64_le(&buf, &mut r)\n    if !r.ok { return 0.0 }\n    f64.from_bits(bits)\n}\n\npub fn read_uvarint(buf: &[]u8, r: &mut Reader) -> u64 {\n    if !r.ok { return 0 }\n    var result: u64 = 0\n    var shift := 0\n    for i in 0..10 {\n        if r.pos >= buf.len { fail_read(&mut r, 1); return 0 }\n        b := buf[r.pos]\n        r.pos += 1\n        if i == 9 && b > 1 { fail_read(&mut r, 2); return 0 }\n        result = result.bit_or(u64(b.bit_and(127)).shl(shift))\n        if b < 128 { return result }\n        shift += 7\n    }\n    fail_read(&mut r, 2)\n    0\n}\n\npub fn read_varint(buf: &[]u8, r: &mut Reader) -> i64 {\n    zz := read_uvarint(&buf, &mut r)\n    if !r.ok { return 0 }\n    half := zz.shr(1)\n    if zz.bit_and(1) != 0 {\n        return -i64(half) - 1\n    }\n    i64(half)\n}\n\npub fn read_bytes(buf: &[]u8, r: &mut Reader) -> []u8 {\n    if !r.ok { return [] }\n    n := read_uvarint(&buf, &mut r)\n    if !r.ok { return [] }\n    if n > u64(buf.len - r.pos) { fail_read(&mut r, 1); return [] }\n    count := i32(n)\n    var out: []u8 = []\n    bytes.extend_range(&mut out, &buf, r.pos, r.pos + count)\n    r.pos += count\n    out\n}\n\npub fn read_str(buf: &[]u8, r: &mut Reader) -> string {\n    if !r.ok { return \"\" }\n    n := read_uvarint(&buf, &mut r)\n    if !r.ok { return \"\" }\n    if n > u64(buf.len - r.pos) { fail_read(&mut r, 1); return \"\" }\n    count := i32(n)\n    dec := bytes.decode_range(&buf, r.pos, r.pos + count)\n    if !dec.ok { fail_read(&mut r, 92); return \"\" }\n    r.pos += count\n    dec.value\n}\n\n@test\nfn wire_round_trips_scalars_strings_extremes_and_rejects_truncation() {\n    var buf: []u8 = []\n    put_bool(&mut buf, true)\n    put_bool(&mut buf, false)\n    put_i32_le(&mut buf, -2147483648)\n    put_u32_le(&mut buf, 4294967295)\n    put_i64_le(&mut buf, -9223372036854775808)\n    put_u64_le(&mut buf, 18446744073709551615)\n    put_varint(&mut buf, 0)\n    put_varint(&mut buf, -1)\n    put_varint(&mut buf, 42)\n    put_varint(&mut buf, -9223372036854775808)\n    put_varint(&mut buf, 9223372036854775807)\n    put_f64(&mut buf, -3.5)\n    put_str(&mut buf, \"dunder åäö 🌍\")\n    var raw: []u8 = [0, 255, 17]\n    put_bytes(&mut buf, &raw)\n\n    var r := reader()\n    assert(read_bool(&buf, &mut r))\n    assert(!read_bool(&buf, &mut r))\n    assert(read_i32_le(&buf, &mut r) == -2147483648)\n    assert(read_u32_le(&buf, &mut r) == 4294967295)\n    assert(read_i64_le(&buf, &mut r) == -9223372036854775808)\n    assert(read_u64_le(&buf, &mut r) == 18446744073709551615)\n    assert(read_varint(&buf, &mut r) == 0)\n    assert(read_varint(&buf, &mut r) == -1)\n    assert(read_varint(&buf, &mut r) == 42)\n    assert(read_varint(&buf, &mut r) == -9223372036854775808)\n    assert(read_varint(&buf, &mut r) == 9223372036854775807)\n    assert(read_f64(&buf, &mut r) == -3.5)\n    assert(read_str(&buf, &mut r) == \"dunder åäö 🌍\")\n    got := read_bytes(&buf, &mut r)\n    assert(got.len == 3 && got[0] == 0 && got[1] == 255 && got[2] == 17)\n    assert(finish(&buf, &r))\n\n    // Extra read past end marks truncated error without trapping.\n    _ := read_u8(&buf, &mut r)\n    assert(!r.ok && r.error == 1)\n}\n" }
    ""
}

pub fn contains(name: string) -> bool {
    if name == "array" { return true }
    if name == "bytes" { return true }
    if name == "dl" { return true }
    if name == "fs" { return true }
    if name == "hash" { return true }
    if name == "json" { return true }
    if name == "map" { return true }
    if name == "net" { return true }
    if name == "parse" { return true }
    if name == "process" { return true }
    if name == "set" { return true }
    if name == "sha256" { return true }
    if name == "sys" { return true }
    if name == "text" { return true }
    if name == "wire" { return true }
    false
}

pub fn float_formatter() -> string { "// Shortest round-trip decimal formatting from IEEE bits, written in Dunder.\n// Exact decimal integers describe the value and its rounding interval.\n// Try increasing significant-digit counts; accept a decimal only inside\n// that interval, including midpoint ties only for an even significand.\npub fn format_float_bits(raw: i64, single: bool) -> string {\n    var bits := raw\n    var negative := false\n    var unit: i64 = 4503599627370496\n    var bias := 1023\n    var fraction_bits := 52\n    var exponent_limit := 2047\n    var precision := 17\n    if single {\n        unit = 8388608\n        bias = 127\n        fraction_bits = 23\n        exponent_limit = 255\n        precision = 9\n        if bits >= 2147483648 { negative = true; bits = bits - 2147483648 }\n    } else if bits < 0 {\n        negative = true\n        bits = bits - i64(-9223372036854775808)\n    }\n    var sign := \"\"\n    if negative { sign = \"-\" }\n    exponent_field := i32(bits / unit)\n    if exponent_field == exponent_limit {\n        if bits % unit != 0 { return \"nan\" }\n        return sign + \"inf\"\n    }\n    if bits == 0 { return sign + \"0.0\" }\n    var mantissa := bits % unit\n    var exponent := 1 - bias - fraction_bits\n    if exponent_field != 0 {\n        mantissa = mantissa + unit\n        exponent = exponent_field - bias - fraction_bits\n    }\n    even := mantissa % 2 == 0\n    var digits := [0; 2400]\n    var sizes := [0; 3]\n    var scales := [0; 3]\n    for variant in 0..3 {\n        var coefficient := mantissa\n        var power := exponent\n        if variant == 1 {\n            coefficient = mantissa * 2 - 1\n            power = exponent - 1\n            if mantissa == unit && exponent_field > 1 {\n                coefficient = mantissa * 4 - 1\n                power = exponent - 2\n            }\n        }\n        if variant == 2 { coefficient = mantissa * 2 + 1; power = exponent - 1 }\n        base := variant * 800\n        var size := 0\n        while coefficient != 0 {\n            digits[base + size] = i32(coefficient % 10)\n            coefficient = coefficient / 10\n            size = size + 1\n        }\n        var factor := 2\n        var steps := power\n        if power < 0 { factor = 5; steps = -power; scales[variant] = -power }\n        for step in 0..steps {\n            var carry := 0\n            for j in 0..size {\n                next := digits[base + j] * factor + carry\n                digits[base + j] = next % 10\n                carry = next / 10\n            }\n            if carry != 0 { digits[base + size] = carry; size = size + 1 }\n        }\n        sizes[variant] = size\n    }\n    var prefix: i64 = 0\n    var chosen: i64 = 0\n    var decimal_power := 0\n    var found := false\n    for count in 1..precision + 1 {\n        value_index := sizes[0] - count\n        var digit := 0\n        if value_index >= 0 { digit = digits[value_index] }\n        prefix = prefix * 10 + i64(digit)\n        var round_up := false\n        if value_index > 0 {\n            next := digits[value_index - 1]\n            var tail := false\n            for j in 0..value_index - 1 { if digits[j] != 0 { tail = true } }\n            round_up = next > 5 || (next == 5 && (tail || prefix % 2 != 0))\n        }\n        power := sizes[0] - scales[0] - count\n        for attempt in 0..2 {\n            var candidate := prefix\n            if (attempt == 0 && round_up) || (attempt == 1 && !round_up) { candidate = candidate + 1 }\n            spelling := candidate.str()\n            var accepted := true\n            for boundary in 1..3 {\n                order := spelling.len + power\n                bound_order := sizes[boundary] - scales[boundary]\n                var comparison := 0\n                if order < bound_order { comparison = -1 }\n                if order > bound_order { comparison = 1 }\n                if order == bound_order {\n                    var length := sizes[boundary]\n                    if spelling.len > length { length = spelling.len }\n                    for j in 0..length {\n                        var a := 0\n                        var b := 0\n                        if j < spelling.len { a = spelling[j] - 48 }\n                        if j < sizes[boundary] { b = digits[boundary * 800 + sizes[boundary] - 1 - j] }\n                        if a < b { comparison = -1; break }\n                        if a > b { comparison = 1; break }\n                    }\n                }\n                if boundary == 1 && (comparison < 0 || (comparison == 0 && !even)) { accepted = false }\n                if boundary == 2 && (comparison > 0 || (comparison == 0 && !even)) { accepted = false }\n            }\n            if accepted { chosen = candidate; decimal_power = power; found = true; break }\n        }\n        if found { break }\n    }\n    assert(found)\n    while chosen % 10 == 0 { chosen = chosen / 10; decimal_power = decimal_power + 1 }\n    spelling := chosen.str()\n    order := spelling.len + decimal_power - 1\n    if order < -4 || order >= 16 {\n        var result := sign + spelling[0..1]\n        if spelling.len > 1 { result = result + \".\" + spelling[1..spelling.len] }\n        result = result + \"e\"\n        if order >= 0 { result = result + \"+\" }\n        return result + order.str()\n    }\n    if decimal_power >= 0 {\n        var result := sign + spelling\n        for i in 0..decimal_power { result = result + \"0\" }\n        return result + \".0\"\n    }\n    point := spelling.len + decimal_power\n    if point > 0 { return sign + spelling[0..point] + \".\" + spelling[point..spelling.len] }\n    var result := sign + \"0.\"\n    for i in 0..-point { result = result + \"0\" }\n    result + spelling\n}\n" }
