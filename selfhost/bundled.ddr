macos\") { return mac_stmt_readonly(statement) }\n    if target_is(\"linux\") { return linux_stmt_readonly(statement) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_last_insert_rowid\")\nunsafe fn mac_last_insert_rowid(db: ptr) -> i64\n@extern(\"libsqlite3.so.0\", \"sqlite3_last_insert_rowid\")\nunsafe fn linux_last_insert_rowid(db: ptr) -> i64\nunsafe fn sql_last_insert_rowid(db: ptr) -> i64 {\n    if target_is(\"macos\") { return mac_last_insert_rowid(db) }\n    if target_is(\"linux\") { return linux_last_insert_rowid(db) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_changes64\")\nunsafe fn mac_changes64(db: ptr) -> i64\n@extern(\"libsqlite3.so.0\", \"sqlite3_changes64\")\nunsafe fn linux_changes64(db: ptr) -> i64\nunsafe fn sql_changes64(db: ptr) -> i64 {\n    if target_is(\"macos\") { return mac_changes64(db) }\n    if target_is(\"linux\") { return linux_changes64(db) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_busy_timeout\")\nunsafe fn mac_busy_timeout(db: ptr, milliseconds: i32) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_busy_timeout\")\nunsafe fn linux_busy_timeout(db: ptr, milliseconds: i32) -> i32\nunsafe fn sql_busy_timeout(db: ptr, milliseconds: i32) -> i32 {\n    if target_is(\"macos\") { return mac_busy_timeout(db, milliseconds) }\n    if target_is(\"linux\") { return linux_busy_timeout(db, milliseconds) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_errmsg\")\nunsafe fn mac_errmsg(db: ptr) -> ptr\n@extern(\"libsqlite3.so.0\", \"sqlite3_errmsg\")\nunsafe fn linux_errmsg(db: ptr) -> ptr\nunsafe fn sql_errmsg(db: ptr) -> ptr {\n    if target_is(\"macos\") { return mac_errmsg(db) }\n    if target_is(\"linux\") { return linux_errmsg(db) }\n    ptr(0)\n}\n\nfn c_string(value: string) -> []u8 {\n    mut out: []u8 = []\n    bytes.append_utf8(&mut out, value)\n    out.push(0)\n    out\n}\n\nunsafe fn copy_text(value: ptr, length: i32) -> string {\n    mut out: []u8 = []\n    if length < 0 || (length > 0 && value == ptr(0)) { return \"\" }\n    out.reserve(length)\n    for i in 0..length { out.push(load_u8(ptr(usize(value) + usize(i)))) }\n    decoded := bytes.decode(&out)\n    // SQLite permits arbitrary bytes in TEXT. The JSON interface rejects them\n    // before exposing a row instead of silently replacing invalid UTF-8.\n    if !decoded.ok { return \"\" }\n    decoded.value\n}\n\nunsafe fn copy_c_string(value: ptr) -> string {\n    if value == ptr(0) { return \"\" }\n    mut length := 0\n    while length < 1048576 {\n        if load_u8(ptr(usize(value) + usize(length))) == 0 { return copy_text(value, length) }\n        length += 1\n    }\n    \"\"\n}\n\nunsafe fn failure(db: ptr) -> string {\n    if db == ptr(0) { return \"SQLite could not allocate a connection\" }\n    \"SQLite: \" + copy_c_string(sql_errmsg(db))\n}\n\nfn tail_empty(sql: string, start: i32) -> bool {\n    mut i := start\n    while i < sql.len {\n        byte := sql[i]\n        if byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 || byte == 32 || byte == 59 {\n            i += 1\n        } else if i + 1 < sql.len && byte == 45 && sql[i + 1] == 45 {\n            i += 2\n            while i < sql.len && sql[i] != 10 { i += 1 }\n        } else if i + 1 < sql.len && byte == 47 && sql[i + 1] == 42 {\n            i += 2\n            while i + 1 < sql.len && !(sql[i] == 42 && sql[i + 1] == 47) { i += 1 }\n            if i + 1 >= sql.len { return true }\n            i += 2\n        } else { return false }\n    }\n    true\n}\n\n// sqlite3_complete recognizes trigger bodies without preparing anything. Check\n// each possible terminator before prepare: several PRAGMAs act at prepare time.\n// Thus an invalid multi-statement request cannot change even pragma state.\nunsafe fn single_statement(sql: string) -> bool {\n    mut prefix: []u8 = []\n    prefix.reserve(sql.len + 1)\n    mut state := 0 // single/double/backtick/bracket quoting and SQL comments\n    mut i := 0