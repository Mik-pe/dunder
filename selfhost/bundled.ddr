lse if target_is(\"linux\") { linux_global_cleanup() }\n}\n\nunsafe fn easy_init() -> ptr {\n    if target_is(\"macos\") { return mac_easy_init() }\n    if target_is(\"linux\") { return linux_easy_init() }\n    ptr(0)\n}\n\nunsafe fn easy_cleanup(easy: ptr) {\n    if target_is(\"macos\") { mac_easy_cleanup(easy) }\n    else if target_is(\"linux\") { linux_easy_cleanup(easy) }\n}\n\nunsafe fn set_long(easy: ptr, option: i32, value: i64) -> bool {\n    if target_is(\"macos\") { return mac_setopt_long(easy, option, value) == 0 }\n    if target_is(\"linux\") { return linux_setopt_long(easy, option, value) == 0 }\n    false\n}\n\nunsafe fn set_ptr(easy: ptr, option: i32, value: ptr) -> bool {\n    if target_is(\"macos\") { return mac_setopt_ptr(easy, option, value) == 0 }\n    if target_is(\"linux\") { return linux_setopt_ptr(easy, option, value) == 0 }\n    false\n}\n\nunsafe fn set_writer(easy: ptr) -> bool {\n    if target_is(\"macos\") { return mac_setopt_write(easy, 20011, callback(receive)) == 0 }\n    if target_is(\"linux\") { return linux_setopt_write(easy, 20011, callback(receive)) == 0 }\n    false\n}\n\nunsafe fn slist_append(list: ptr, value: ptr) -> ptr {\n    if target_is(\"macos\") { return mac_slist_append(list, value) }\n    if target_is(\"linux\") { return linux_slist_append(list, value) }\n    ptr(0)\n}\n\nunsafe fn slist_free(list: ptr) {\n    if target_is(\"macos\") { mac_slist_free(list) }\n    else if target_is(\"linux\") { linux_slist_free(list) }\n}\n\nunsafe fn perform(easy: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_easy_perform(easy) }\n    if target_is(\"linux\") { return linux_easy_perform(easy) }\n    4\n}\n\nunsafe fn response_code(easy: ptr) -> i32 {\n    mut value: i64 = 0\n    mut code := 4\n    if target_is(\"macos\") { code = mac_getinfo(easy, 0x200002, addr(&mut value)) }\n    else if target_is(\"linux\") { code = linux_getinfo(easy, 0x200002, addr(&mut value)) }\n    if code != 0 || value < 0 || value > 999 { return 0 }