pub fn float_formatter() -> string { "pub fn format_float_bits(raw: i64, single: bool, decimals: i32) -> string {\n    fraction_bits := if single { 23 } else { 52 }\n    bias := if single { 127 } else { 1023 }\n    exponent_limit := if single { 255 } else { 2047 }\n    precision := if single { 9 } else { 17 }\n    unit := i64(1).shl(fraction_bits)\n    negative := if single { raw >= 2147483648 } else { raw < 0 }\n    bits := if !negative { raw } else if single { raw - 2147483648 } else { raw - i64(-9223372036854775808) }\n    sign := if negative { \"-\" } else { \"\" }\n    exponent_field := i32(bits / unit)\n    if exponent_field == exponent_limit {\n        if bits % unit != 0 { return \"nan\" }\n        return sign + \"inf\"\n    }\n    if bits == 0 && decimals < 0 { return sign + \"0.0\" }\n    mut mantissa := bits % unit\n    mut exponent := 1 - bias - fraction_bits\n    if exponent_field != 0 {\n        mantissa = mantissa + unit\n        exponent = exponent_field - bias - fraction_bits\n    }\n    if bits == 0 { exponent = 0 }\n    even := mantissa % 2 == 0\n    mut digits := [0; 2400]\n    mut sizes := [0; 3]\n    mut scales := [0; 3]\n    variants := if decimals >= 0 { 1 } else { 3 }\n    for variant in 0..variants {\n        mut coefficient := mantissa\n        mut power := exponent\n        if variant == 1 {\n            coefficient = mantissa * 2 - 1\n            power = exponent - 1\n            if mantissa == unit && exponent_field > 1 {\n                coefficient = mantissa * 4 - 1\n                power = exponent - 2\n            }\n        }\n        if variant == 2 { coefficient = mantissa * 2 + 1; power = exponent - 1 }\n        base := variant * 800\n        mut size := 0\n        while coefficient != 0 {\n            digits[base + size] = i32(coefficient % 10)\n            coefficient = coefficient / 10\n            size = size + 1\n        }\n        mut factor := 2\n        mut steps := power\n        if power < 0 { factor = 5; steps = -power; scales[variant] = -power }\n        for step in 0..steps {\n            mut carry := 0\n            for j in 0..size {\n                next := digits[base + j] * factor + carry\n                digits[base + j] = next % 10\n                carry = next / 10\n            }\n            if carry != 0 { digits[base + size] = carry; size = size + 1 }\n        }\n        sizes[variant] = size\n    }\n    if decimals >= 0 {\n        mut size := sizes[0]\n        scale := scales[0]\n        cutoff := scale - decimals\n        if cutoff > 0 && cutoff <= size {\n            next := digits[cutoff - 1]\n            mut tail := false\n            for j in 0..cutoff - 1 { if digits[j] != 0 { tail = true; break } }\n            if next > 5 || (next == 5 && (tail || digits[cutoff] % 2 != 0)) {\n                mut j := cutoff\n                while digits[j] == 9 { digits[j] = 0; j += 1 }\n                digits[j] += 1\n                if j >= size { size = j + 1 }\n            }\n        }\n        mut pos := if size > scale { size - 1 } else { scale }\n        mut result := sign.clone()\n        while pos >= cutoff {\n            if pos == scale - 1 { result += \".\" }\n            digit := if pos >= 0 && pos < size { digits[pos] } else { 0 }\n            result += digit.str()\n            pos -= 1\n        }\n        return result\n    }\n    mut prefix: i64 = 0\n    mut chosen: i64 = 0\n    mut decimal_power := 0\n    mut found := false\n    for count in 1..precision + 1 {\n        value_index := sizes[0] - count\n        digit := if value_index >= 0 { digits[value_index] } else { 0 }\n        prefix = prefix * 10 + i64(digit)\n        mut round_up := false\n        if value_index > 0 {\n            next := digits[value_index - 1]\n            mut tail := false\n            for j in 0..value_index - 1 { if digits[j] != 0 { tail = true; break } }\n            round_up = next > 5 || (next == 5 && (tail || prefix % 2 != 0))\n        }\n        power := sizes[0] - scales[0] - count\n        for attempt in 0..2 {\n            mut candidate := prefix\n            if (attempt == 0 && round_up) || (attempt == 1 && !round_up) { candidate = candidate + 1 }\n            spelling := candidate.str()\n            mut accepted := true\n            for boundary in 1..3 {\n                order := spelling.len + power\n                bound_order := sizes[boundary] - scales[boundary]\n                mut comparison := 0\n                if order < bound_order { comparison = -1 }\n                if order > bound_order { comparison = 1 }\n                if order == bound_order {\n                    mut length := sizes[boundary]\n                    if spelling.len > length { length = spelling.len }\n                    for j in 0..length {\n                        a := if j < spelling.len { i32(spelling[j]) - 48 } else { 0 }\n                        b := if j < sizes[boundary] { digits[boundary * 800 + sizes[boundary] - 1 - j] } else { 0 }\n                        if a < b { comparison = -1; break }\n                        if a > b { comparison = 1; break }\n                    }\n                }\n                if boundary == 1 && (comparison < 0 || (comparison == 0 && !even)) { accepted = false }\n                if boundary == 2 && (comparison > 0 || (comparison == 0 && !even)) { accepted = false }\n            }\n            if accepted { chosen = candidate; decimal_power = power; found = true; break }\n        }\n        if found { break }\n    }\n    assert(found)\n    while chosen % 10 == 0 { chosen = chosen / 10; decimal_power = decimal_power + 1 }\n    spelling := chosen.str()\n    order := spelling.len + decimal_power - 1\n    if order < -4 || order >= 16 {\n        mut result := sign + spelling[0..1]\n        if spelling.len > 1 { result = result + \".\" + spelling[1..spelling.len] }\n        result = result + \"e\"\n        if order >= 0 { result = result + \"+\" }\n        return result + order.str()\n    }\n    if decimal_power >= 0 {\n        mut result := sign + spelling\n        for i in 0..decimal_power { result = result + \"0\" }\n        return result + \".0\"\n    }\n    point := spelling.len + decimal_power\n    if point > 0 { return sign + spelling[0..point] + \".\" + spelling[point..spelling.len] }\n    mut result := sign + \"0.\"\n    for i in 0..-point { result = result + \"0\" }\n    result + spelling\n}\n" }

