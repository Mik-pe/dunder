pub fn generic_prelude() -> string { "pub enum Option<T> { Some(T), None }\n\nimpl Option<T> {\n    pub fn is_some(&self) -> bool {\n        match self {\n            .Some(_) => true,\n            .None => false,\n        }\n    }\n\n    pub fn is_none(&self) -> bool {\n        match self {\n            .Some(_) => false,\n            .None => true,\n        }\n    }\n\n    pub fn unwrap_or(move self, move fallback: T) -> T {\n        match move self {\n            .Some(value) => value,\n            .None => fallback,\n        }\n    }\n}\n\nimpl Option<T> where T: Storable {\n    pub fn unwrap_or_else(move self, f: &mut FnMut() -> T) -> T {\n        match move self {\n            .Some(value) => value,\n            .None => f(),\n        }\n    }\n}\n\nimpl Option<T> where T: Default {\n    pub fn unwrap_or_default(move self) -> T {\n        match move self {\n            .Some(value) => value,\n            .None => T::default(),\n        }\n    }\n}\n\nimpl Eq for Option<T> where T: Eq {\n    fn eq(&self, other: &Self) -> bool {\n        match self {\n            .Some(a) => match other { .Some(b) => a.eq(b), .None => false },\n            .None => match other { .Some(_) => false, .None => true },\n        }\n    }\n}\n\nimpl Ord for Option<T> where T: Ord {\n    fn cmp(&self, other: &Self) -> Ordering {\n        match self {\n            .Some(a) => match other { .Some(b) => a.cmp(b), .None => Ordering.Greater },\n            .None => match other { .Some(_) => Ordering.Less, .None => Ordering.Equal },\n        }\n    }\n}\n\nimpl Hash for Option<T> where T: Hash {\n    fn hash(&self) -> u64 {\n        match self {\n            .Some(v) => v.hash().bit_xor(u64(11400714819323198485)),\n            .None => u64(14029467366897019727),\n        }\n    }\n}\n\nimpl Display for Option<T> where T: Display {\n    fn str(&self) -> string {\n        match self {\n            .Some(v) => \"Some(\" + v.str() + \")\",\n            .None => \"None\",\n        }\n    }\n}\n\nimpl Default for Option<T> {\n    fn default() -> Self { .None }\n}\n\npub enum Result<T, E> { Ok(T), Err(E) }\n\nimpl Result<T, E> {\n    pub fn is_ok(&self) -> bool {\n        match self {\n            .Ok(_) => true,\n            .Err(_) => false,\n        }\n    }\n\n    pub fn is_err(&self) -> bool {\n        match self {\n            .Ok(_) => false,\n            .Err(_) => true,\n        }\n    }\n\n    pub fn unwrap_or(move self, move fallback: T) -> T {\n        match move self {\n            .Ok(value) => value,\n            .Err(_) => fallback,\n        }\n    }\n\n    pub fn ok(move self) -> Option<T> {\n        match move self {\n            .Ok(value) => .Some(value),\n            .Err(_) => .None,\n        }\n    }\n\n    pub fn err(move self) -> Option<E> {\n        match move self {\n            .Ok(_) => .None,\n            .Err(err) => .Some(err),\n        }\n    }\n}\n\nimpl Result<T, E> where T: Storable {\n    pub fn unwrap_or_else(move self, f: &mut FnMut(move E) -> T) -> T {\n        match move self {\n            .Ok(value) => value,\n            .Err(err) => f(move err),\n        }\n    }\n}\n\nimpl Result<T, E> where T: Default {\n    pub fn unwrap_or_default(move self) -> T {\n        match move self {\n            .Ok(value) => value,\n            .Err(_) => T::default(),\n        }\n    }\n}\n\nimpl Eq for Result<T, E> where T: Eq, E: Eq {\n    fn eq(&self, other: &Self) -> bool {\n        match self {\n            .Ok(a) => match other { .Ok(b) => a.eq(b), .Err(_) => false },\n            .Err(a) => match other { .Ok(_) => false, .Err(b) => a.eq(b) },\n        }\n    }\n}\n\nimpl Ord for Result<T, E> where T: Ord, E: Ord {\n    fn cmp(&self, other: &Self) -> Ordering {\n        match self {\n            .Ok(a) => match other { .Ok(b) => a.cmp(b), .Err(_) => Ordering.Less },\n            .Err(a) => match other { .Ok(_) => Ordering.Greater, .Err(b) => a.cmp(b) },\n        }\n    }\n}\n\nimpl Hash for Result<T, E> where T: Hash, E: Hash {\n    fn hash(&self) -> u64 {\n        match self {\n            .Ok(v) => v.hash().bit_xor(u64(11400714819323198485)),\n            .Err(e) => e.hash().bit_xor(u64(14029467366897019727)),\n        }\n    }\n}\n\nimpl Display for Result<T, E> where T: Display, E: Display {\n    fn str(&self) -> string {\n        match self {\n            .Ok(v) => \"Ok(\" + v.str() + \")\",\n            .Err(e) => \"Err(\" + e.str() + \")\",\n        }\n    }\n}\n\nimpl Eq for []T where T: Eq {\n    fn eq(&self, other: &Self) -> bool {\n        if self.len != other.len { return false }\n        for i in 0..self.len {\n            if !self[i].eq(other[i]) { return false }\n        }\n        true\n    }\n}\n\nimpl Ord for []T where T: Ord {\n    fn cmp(&self, other: &Self) -> Ordering {\n        n := if self.len < other.len { self.len } else { other.len }\n        for i in 0..n {\n            c := self[i].cmp(other[i])\n            if c != Ordering.Equal { return c }\n        }\n        if self.len < other.len { return Ordering.Less }\n        if self.len > other.len { return Ordering.Greater }\n        Ordering.Equal\n    }\n}\n\nimpl Hash for []T where T: Hash {\n    fn hash(&self) -> u64 {\n        mut h := u64(self.len).wrapping_mul(11400714819323198485)\n        for i in 0..self.len {\n            h = h.bit_xor(self[i].hash().wrapping_add(11400714819323198485).wrapping_add(h.shl(6)).wrapping_add(h.shr(2)))\n        }\n        h\n    }\n}\n\nimpl Default for []T where T: Storable {\n    fn default() -> Self { [] }\n}\n\nimpl Eq for (A, B) where A: Eq, B: Eq {\n    fn eq(&self, other: &Self) -> bool {\n        self.0.eq(other.0) && self.1.eq(other.1)\n    }\n}\n\nimpl Ord for (A, B) where A: Ord, B: Ord {\n    fn cmp(&self, other: &Self) -> Ordering {\n        c0 := self.0.cmp(other.0)\n        if c0 != Ordering.Equal { return c0 }\n        self.1.cmp(other.1)\n    }\n}\n\nimpl Hash for (A, B) where A: Hash, B: Hash {\n    fn hash(&self) -> u64 {\n        mut h := self.0.hash()\n        h = h.bit_xor(self.1.hash().wrapping_add(11400714819323198485).wrapping_add(h.shl(6)).wrapping_add(h.shr(2)))\n        h\n    }\n}\n\nimpl Default for (A, B) where A: Default, B: Default {\n    fn default() -> Self { (A::default(), B::default()) }\n}\n\nimpl Eq for (A, B, C) where A: Eq, B: Eq, C: Eq {\n    fn eq(&self, other: &Self) -> bool {\n        self.0.eq(other.0) && self.1.eq(other.1) && self.2.eq(other.2)\n    }\n}\n\nimpl Ord for (A, B, C) where A: Ord, B: Ord, C: Ord {\n    fn cmp(&self, other: &Self) -> Ordering {\n        c0 := self.0.cmp(other.0)\n        if c0 != Ordering.Equal { return c0 }\n        c1 := self.1.cmp(other.1)\n        if c1 != Ordering.Equal { return c1 }\n        self.2.cmp(other.2)\n    }\n}\n\nimpl Hash for (A, B, C) where A: Hash, B: Hash, C: Hash {\n    fn hash(&self) -> u64 {\n        mut h := self.0.hash()\n        h = h.bit_xor(self.1.hash().wrapping_add(11400714819323198485).wrapping_add(h.shl(6)).wrapping_add(h.shr(2)))\n        h = h.bit_xor(self.2.hash().wrapping_add(11400714819323198485).wrapping_add(h.shl(6)).wrapping_add(h.shr(2)))\n        h\n    }\n}\n\nimpl Default for (A, B, C) where A: Default, B: Default, C: Default {\n    fn default() -> Self { (A::default(), B::default(), C::default()) }\n}\n\nstruct MapEntry<K, V> { key: K, value: V, slot: i32, hash: u64 }\npub opaque struct Map<K, V> where K: Hash + Storable, V: Storable {\n    entries: []MapEntry<K, V>, slots: []i32, used: i32\n}\n\nimpl Map<K, V> {\n    pub fn new() -> Self { Self { entries: [], slots: [], used: 0 } }\n    pub fn len(&self) -> i32 { self.entries.len }\n    pub fn get_ref(&self, key: K) -> Option<&V> from self {\n        index := self.index_of_ref(key)\n        if index < 0 { return .None }\n        .Some(&self.entries[index].value)\n    }\n    pub fn is_empty(&self) -> bool { self.entries.len == 0 }\n\n    fn slot_for(&self, key: &K, hash: u64) -> i32 {\n        capacity := self.slots.len\n        if capacity == 0 { return -1 }\n        mask := capacity - 1\n        mut slot := i32(hash.bit_and(u64(mask)))\n        for _ in 0..capacity {\n            index := self.slots[slot]\n            if index == -1 { return -1 }\n            if index >= 0 && self.entries[index].hash == hash && self.entries[index].key.eq(key) { return slot }\n            slot = (slot + 1).bit_and(mask)\n        }\n        -1\n    }\n\n    fn vacant(&self, hash: u64) -> i32 {\n        mask := self.slots.len - 1\n        mut slot := i32(hash.bit_and(u64(mask)))\n        while self.slots[slot] >= 0 { slot = (slot + 1).bit_and(mask) }\n        slot\n    }\n\n    fn rehash(&mut self, capacity: i32) {\n        self.slots.clear()\n        self.slots.reserve(capacity)\n        for _ in 0..capacity { self.slots.push(-1) }\n        for index in 0..self.entries.len {\n            slot := self.vacant(self.entries[index].hash)\n            self.slots[slot] = index\n            self.entries[index].slot = slot\n        }\n        self.used = self.entries.len\n    }\n\n    pub fn reserve(&mut self, count: i32) {\n        assert(count >= 0)\n        self.entries.reserve(count)\n        mut capacity := 8\n        while i64(capacity) * 7 < i64(count) * 10 { capacity *= 2 }\n        if capacity > self.slots.len { self.rehash(capacity) }\n    }\n\n    fn index_of_ref(&self, key: &K) -> i32 {\n        slot := self.slot_for(key, key.hash())\n        if slot >= 0 { self.slots[slot] } else { -1 }\n    }\n\n    pub fn index_of(&self, key: K) -> i32 {\n        self.index_of_ref(key)\n    }\n    pub fn find_index(&self, key: K) -> Option<i32> {\n        index := self.index_of_ref(key)\n        if index < 0 { .None } else { .Some(index) }\n    }\n    pub fn contains(&self, key: K) -> bool { self.index_of_ref(key) >= 0 }\n\n    pub fn key_at(&self, index: i32) -> &K from self { &self.entries[index].key }\n    pub fn value_at(&self, index: i32) -> &V from self { &self.entries[index].value }\n    pub fn value_at_mut(&mut self, index: i32) -> &mut V from self { &mut self.entries[index].value }\n\n    pub fn at(&self, key: K) -> &V from self {\n        index := self.index_of_ref(key)\n        assert(index >= 0)\n        &self.entries[index].value\n    }\n    pub fn at_mut(&mut self, key: K) -> &mut V from self {\n        index := self.index_of_ref(key)\n        assert(index >= 0)\n        &mut self.entries[index].value\n    }\n    pub fn get_mut(&mut self, key: K) -> &mut V from self {\n        index := self.index_of_ref(key)\n        assert(index >= 0)\n        &mut self.entries[index].value\n    }\n    pub fn with_value(&self, key: K, f: &mut FnMut(&V)) -> bool {\n        index := self.index_of_ref(key)\n        if index < 0 { return false }\n        f(&self.entries[index].value)\n        true\n    }\n    pub fn update(&mut self, key: K, f: &mut FnMut(&mut V)) -> bool {\n        index := self.index_of_ref(key)\n        if index < 0 { return false }\n        f(&mut self.entries[index].value)\n        true\n    }\n\n    fn put_inner(&mut self, move key: K, move value: V, overwrite: bool) -> bool {\n        hash := key.hash()\n        capacity := self.slots.len\n        mut first_tomb := -1\n        mut target := -1\n        if capacity > 0 {\n            mask := capacity - 1\n            mut slot := i32(hash.bit_and(u64(mask)))\n            for _ in 0..capacity {\n                index := self.slots[slot]\n                if index == -1 {\n                    if first_tomb >= 0 { target = first_tomb } else { target = slot }\n                    break\n                }\n                if index >= 0 {\n                    if self.entries[index].hash == hash && self.entries[index].key.eq(key) {\n                        if overwrite { self.entries[index].value = value }\n                        return false\n                    }\n                } else if first_tomb < 0 { first_tomb = slot }\n                slot = (slot + 1).bit_and(mask)\n            }\n        }\n        mut slot := target\n        if slot >= 0 && self.slots[slot] == -1 && (i64(self.used) + 1) * 10 >= i64(capacity) * 7 {\n            if (i64(self.entries.len) + 1) * 10 < i64(capacity) * 4 { self.rehash(capacity) }\n            else { self.rehash(capacity * 2) }\n            slot = self.vacant(hash)\n        } else if capacity == 0 {\n            self.rehash(8)\n            slot = self.vacant(hash)\n        } else if (i64(self.used) + 1) * 10 >= i64(capacity) * 7 {\n            if (i64(self.entries.len) + 1) * 10 < i64(capacity) * 4 { self.rehash(capacity) }\n            else { self.rehash(capacity * 2) }\n            slot = self.vacant(hash)\n        }\n        if self.slots[slot] == -1 { self.used += 1 }\n        self.slots[slot] = self.entries.len\n        self.entries.push(MapEntry<K, V> { key:key, value:value, slot:slot, hash:hash })\n        true\n    }\n\n    pub fn put(&mut self, move key: K, move value: V) {\n        _ := self.put_inner(move key, move value, true)\n    }\n\n    pub fn put_new(&mut self, move key: K, move value: V) -> bool {\n        self.put_inner(move key, move value, false)\n    }\n\n    fn insert_index(&mut self, move key: K, move value: V) -> i32 {\n        _ := self.put_inner(move key, move value, false)\n        self.entries.len - 1\n    }\n\n    pub fn entry_or_insert(&mut self, move key: K, move value: V) -> &mut V from self {\n        existing := self.index_of_ref(key)\n        if existing >= 0 { return &mut self.entries[existing].value }\n        index := self.insert_index(move key, move value)\n        &mut self.entries[index].value\n    }\n\n    pub fn entry_or_insert_with(&mut self, move key: K, make: &mut FnMut() -> V) -> &mut V from self {\n        existing := self.index_of_ref(key)\n        if existing >= 0 { return &mut self.entries[existing].value }\n        index := self.insert_index(move key, move make())\n        &mut self.entries[index].value\n    }\n\n    pub fn entry_modify_or_insert(&mut self, move key: K, modify: &mut FnMut(&mut V), move value: V) -> &mut V from self {\n        existing := self.index_of_ref(key)\n        if existing >= 0 {\n            modify(&mut self.entries[existing].value)\n            return &mut self.entries[existing].value\n        }\n        index := self.insert_index(move key, move value)\n        &mut self.entries[index].value\n    }\n\n    fn remove_entry(&mut self, index: i32) -> MapEntry<K, V> {\n        last := self.entries.len - 1\n        self.entries.swap(index, last)\n        entry := self.entries.pop()\n        self.slots[entry.slot] = -2\n        if index < last { self.slots[self.entries[index].slot] = index }\n        entry\n    }\n\n    pub fn take(&mut self, key: K) -> Option<V> {\n        index := self.index_of_ref(key)\n        if index < 0 { return .None }\n        entry := self.remove_entry(index)\n        .Some(entry.value)\n    }\n\n    pub fn take_key(&mut self, key: K) -> Option<K> {\n        index := self.index_of_ref(key)\n        self.take_key_at(index)\n    }\n\n    pub fn take_key_at(&mut self, index: i32) -> Option<K> {\n        if index < 0 || index >= self.entries.len { return .None }\n        entry := self.remove_entry(index)\n        .Some(entry.key)\n    }\n\n    pub fn remove(&mut self, key: K) -> bool {\n        index := self.index_of_ref(key)\n        if index < 0 { return false }\n        _ := self.remove_entry(index)\n        true\n    }\n\n    pub fn clear(&mut self) {\n        self.entries.clear()\n        self.slots.clear()\n        self.used = 0\n    }\n}\n\nimpl Map<K, V> where V: Default {\n    pub fn entry_or_default(&mut self, move key: K) -> &mut V from self {\n        existing := self.index_of_ref(key)\n        if existing >= 0 { return &mut self.entries[existing].value }\n        index := self.insert_index(move key, move V::default())\n        &mut self.entries[index].value\n    }\n}\n\nimpl Map<K, V> where V: Clone {\n    pub fn get(&self, key: K) -> Option<V> {\n        index := self.index_of_ref(key)\n        if index < 0 { .None } else { .Some(self.entries[index].value.clone()) }\n    }\n    pub fn get_or(&self, key: K, move fallback: V) -> V {\n        index := self.index_of_ref(key)\n        if index < 0 { fallback } else { self.entries[index].value.clone() }\n    }\n}\n\nimpl Map<K, V> where V: Default + Clone {\n    pub fn get_or_default(&self, key: K) -> V {\n        index := self.index_of_ref(key)\n        if index < 0 { V::default() } else { self.entries[index].value.clone() }\n    }\n}\n\nimpl Map<K, V> where K: Clone {\n    pub fn keys(&self) -> []K {\n        mut result: []K = []\n        result.reserve(self.entries.len)\n        for entry in &self.entries { result.push(entry.key.clone()) }\n        result\n    }\n}\n\nimpl Default for Map<K, V> where K: Hash + Storable, V: Storable {\n    fn default() -> Self { Self::new() }\n}\n\nimpl Eq for Map<K, V> where V: Eq {\n    fn eq(&self, other: &Self) -> bool {\n        if self.entries.len != other.entries.len { return false }\n        for i in 0..self.entries.len {\n            idx := other.index_of_ref(self.entries[i].key)\n            if idx < 0 || !self.entries[i].value.eq(other.entries[idx].value) { return false }\n        }\n        true\n    }\n}\n\nimpl Sendable for Map<K, V> where K: Sendable, V: Sendable {}\n\npub opaque struct Set<K> where K: Hash + Storable { table: Map<K, bool> }\n\nimpl Set<K> {\n    pub fn new() -> Self { Self { table: Map<K, bool>::new() } }\n    pub fn len(&self) -> i32 { self.table.len() }\n    pub fn is_empty(&self) -> bool { self.table.is_empty() }\n    pub fn reserve(&mut self, count: i32) { self.table.reserve(count) }\n    pub fn contains(&self, key: K) -> bool { self.table.contains(key) }\n    pub fn at(&self, index: i32) -> &K from self { self.table.key_at(index) }\n\n    pub fn insert(&mut self, move key: K) -> bool {\n        self.table.put_new(move key, true)\n    }\n\n    pub fn take(&mut self, key: K) -> Option<K> { self.table.take_key(key) }\n    pub fn take_at(&mut self, index: i32) -> Option<K> { self.table.take_key_at(index) }\n    pub fn remove(&mut self, key: K) -> bool { self.table.remove(key) }\n    pub fn clear(&mut self) { self.table.clear() }\n}\n\nimpl Set<K> where K: Clone {\n    pub fn values(&self) -> []K { self.table.keys() }\n}\n\nimpl Default for Set<K> where K: Hash + Storable {\n    fn default() -> Self { Self::new() }\n}\n\nimpl Eq for Set<K> where K: Hash + Storable {\n    fn eq(&self, other: &Self) -> bool { self.table.eq(other.table) }\n}\n\nimpl Sendable for Set<K> where K: Sendable {}\n\n" }

pub fn combinators_prelude() -> string { "impl Option<T> {\n    pub fn unwrap(move self) -> T {\n        match move self {\n            .Some(value) => value,\n            .None => panic(\"called Option::unwrap() on None\\n\"),\n        }\n    }\n\n    pub fn expect(move self, msg: string) -> T {\n        match move self {\n            .Some(value) => value,\n            .None => panic(msg + \"\\n\"),\n        }\n    }\n\n    pub fn map<U>(move self, f: &mut FnMut(move T) -> U) -> Option<U> {\n        match move self {\n            .Some(value) => .Some(f(move value)),\n            .None => .None,\n        }\n    }\n\n    pub fn and_then<U>(move self, f: &mut FnMut(move T) -> Option<U>) -> Option<U> {\n        match move self {\n            .Some(value) => f(move value),\n            .None => .None,\n        }\n    }\n\n    pub fn ok_or<E>(move self, move err: E) -> Result<T, E> {\n        match move self {\n            .Some(value) => .Ok(value),\n            .None => .Err(err),\n        }\n    }\n\n    pub fn ok_or_else<E>(move self, f: &mut FnMut() -> E) -> Result<T, E> {\n        match move self {\n            .Some(value) => .Ok(value),\n            .None => .Err(f()),\n        }\n    }\n}\n\nimpl Result<T, E> {\n    pub fn unwrap(move self) -> T {\n        match move self {\n            .Ok(value) => value,\n            .Err(_) => panic(\"called Result::unwrap() on Err\\n\"),\n        }\n    }\n\n    pub fn unwrap_err(move self) -> E {\n        match move self {\n            .Ok(_) => panic(\"called Result::unwrap_err() on Ok\\n\"),\n            .Err(err) => err,\n        }\n    }\n\n    pub fn expect(move self, msg: string) -> T {\n        match move self {\n            .Ok(value) => value,\n            .Err(_) => panic(msg + \"\\n\"),\n        }\n    }\n\n    pub fn map<U>(move self, f: &mut FnMut(move T) -> U) -> Result<U, E> {\n        match move self {\n            .Ok(value) => .Ok(f(move value)),\n            .Err(err) => .Err(err),\n        }\n    }\n\n    pub fn map_err<F>(move self, f: &mut FnMut(move E) -> F) -> Result<T, F> {\n        match move self {\n            .Ok(value) => .Ok(value),\n            .Err(err) => .Err(f(move err)),\n        }\n    }\n\n    pub fn and_then<U>(move self, f: &mut FnMut(move T) -> Result<U, E>) -> Result<U, E> {\n        match move self {\n            .Ok(value) => f(move value),\n            .Err(err) => .Err(err),\n        }\n    }\n}\n" }
