    if name == "text/view" { return "fn whitespace(byte: u8) -> bool { byte == 32 || byte == 9 || byte == 10 || byte == 13 }\n\nfn matches_at(text: &str, start: i32, needle: &str) -> bool {\n    for i in 0..needle.len { if text[start + i] != needle[i] { return false } }\n    true\n}\n\npub fn starts_with(text: &str, prefix: &str) -> bool {\n    prefix.len <= text.len && matches_at(text, 0, prefix)\n}\n\npub fn ends_with(text: &str, suffix: &str) -> bool {\n    suffix.len <= text.len && matches_at(text, text.len - suffix.len, suffix)\n}\n\nfn find_index(text: &str, needle: &str) -> i32 {\n    if needle.len == 0 { return 0 }\n    if needle.len > text.len { return -1 }\n    for start in 0..(text.len - needle.len + 1) {\n        if matches_at(text, start, needle) { return start }\n    }\n    -1\n}\n\npub fn find(text: &str, needle: &str) -> Option<i32> {\n    pos := find_index(text, needle)\n    if pos >= 0 { .Some(pos) } else { .None }\n}\n\npub fn contains(text: &str, needle: &str) -> bool {\n    find_index(text, needle) >= 0\n}\n\npub fn trim_start(text: &str) -> &str {\n    mut start := 0\n    while start < text.len && whitespace(text[start]) { start += 1 }\n    &text[start..]\n}\n\npub fn trim_end(text: &str) -> &str {\n    mut end := text.len\n    while end > 0 && whitespace(text[end - 1]) { end -= 1 }\n    &text[..end]\n}\n\npub fn trim(text: &str) -> &str {\n    mut start := 0\n    mut end := text.len\n    while start < end && whitespace(text[start]) { start += 1 }\n    while end > start && whitespace(text[end - 1]) { end -= 1 }\n    &text[start..end]\n}\n\npub fn strip_prefix(text: &str, prefix: &str) -> &str from text {\n    if starts_with(text, prefix) { &text[prefix.len..] } else { text }\n}\n\npub fn strip_suffix(text: &str, suffix: &str) -> &str from text {\n    if ends_with(text, suffix) { &text[..text.len - suffix.len] } else { text }\n}\n\npub fn before(text: &str, sep: &str) -> &str from text {\n    pos := find_index(text, sep)\n    if pos >= 0 { &text[..pos] } else { text }\n}\n\npub fn after(text: &str, sep: &str) -> &str from text {\n    pos := find_index(text, sep)\n    if pos >= 0 { &text[pos + sep.len..] } else { &text[text.len..] }\n}\n\n@test fn borrowed_str_views_slice_and_trim_utf8_without_copy() {\n    sample := \" \\t å 🌍 \\r\\n\"\n    trim(sample) == \"å 🌍\"\n    trim_start(sample) == \"å 🌍 \\r\\n\"\n    trim_end(sample) == \" \\t å 🌍\"\n    starts_with(\"åäö 🌍\", \"å\")\n    ends_with(\"åäö 🌍\", \"🌍\")\n    find(\"åäö 🌍\", \"🌍\") == .Some(7)\n    find(\"åäö 🌍\", \"missing\") == .None\n    contains(\"åäö 🌍\", \"äö\")\n    !contains(\"åäö\", \"xyz\")\n    strip_prefix(\"å: 🌍\", \"å: \") == \"🌍\"\n    strip_prefix(\"å: 🌍\", \"no\") == \"å: 🌍\"\n    strip_suffix(\"å: 🌍\", \" 🌍\") == \"å:\"\n    strip_suffix(\"å: 🌍\", \"no\") == \"å: 🌍\"\n    before(\"å=🌍\", \"=\") == \"å\"\n    before(\"å\", \"=\") == \"å\"\n    after(\"å=🌍\", \"=\") == \"🌍\"\n    after(\"å\", \"=\") == \"\"\n}\n" }
    if name == "time" { return "capability unsafe\n\nimport sys\n\n@extern(\"c\", \"clock_gettime\")\n@thread_safe\nunsafe fn c_clock_gettime(clock_id: i32, tp: ptr) -> i32\n\n@extern(\"kernel32.dll\", \"QueryPerformanceFrequency\")\n@thread_safe\nunsafe fn counter_frequency(frequency: ptr) -> i32\n@extern(\"kernel32.dll\", \"QueryPerformanceCounter\")\n@thread_safe\nunsafe fn counter_value(value: ptr) -> i32\n@extern(\"kernel32.dll\", \"GetSystemTimeAsFileTime\")\n@thread_safe\nunsafe fn system_file_time(value: ptr)\n\npub struct UnixTime {\n    secs: i64,\n    nanos: i32,\n}\n\npub struct DateTime {\n    year: i32,\n    month: i32,\n    day: i32,\n    hour: i32,\n    minute: i32,\n    second: i32,\n    weekday: i32,\n}\n\nimpl UnixTime {\n    pub fn from_secs(secs: i64) -> Self {\n        Self { secs: secs, nanos: 0 }\n    }\n    pub fn from_millis(ms: i64) -> Self {\n        mut s := ms / 1000\n        mut rem := ms % 1000\n        if rem < 0 { rem += 1000; s -= 1 }\n        Self { secs: s, nanos: i32(rem * 1000000) }\n    }\n    pub fn as_secs(&self) -> i64 { self.secs }\n    pub fn as_millis(&self) -> i64 { self.secs * 1000 + i64(self.nanos / 1000000) }\n    pub fn sub_millis(&self, earlier: &UnixTime) -> i64 {\n        self.as_millis() - earlier.as_millis()\n    }\n}\n\nimpl Eq for UnixTime {\n    fn eq(&self, other: &Self) -> bool { self.secs == other.secs && self.nanos == other.nanos }\n}\nimpl Ord for UnixTime {\n    fn cmp(&self, other: &Self) -> Ordering {\n        if self.secs < other.secs { return .Less }\n        if self.secs > other.secs { return .Greater }\n        self.nanos.cmp(&other.nanos)\n    }\n}\nimpl Display for UnixTime {\n    fn str(&self) -> string { format_rfc3339_ms(UnixTime { secs: self.secs, nanos: self.nanos }) }\n}\n\nimpl Eq for DateTime {\n    fn eq(&self, other: &Self) -> bool {\n        self.year == other.year && self.month == other.month && self.day == other.day &&\n            self.hour == other.hour && self.minute == other.minute && self.second == other.second &&\n            self.weekday == other.weekday\n    }\n}\nimpl Display for DateTime {\n    fn str(&self) -> string {\n        fmt_iso_parts(self.year, self.month, self.day, self.hour, self.minute, self.second)\n    }\n}\n\n@thread_safe\npub fn monotonic_ns() -> i64 {\n    unsafe {\n        mut now: [i64; 2] = [0; 2]\n        if target_is(\"macos\") {\n            if c_clock_gettime(6, addr(&mut now[0])) != 0 { return -1 }\n        } else if target_is(\"linux\") {\n            if sys.linux_syscall(113, 1, i64(usize(addr(&mut now[0]))), 0, 0, 0, 0) != 0 { return -1 }\n        } else if target_is(\"windows\") {\n            mut hz: i64 = 0\n            mut ticks: i64 = 0\n            if counter_frequency(addr(&mut hz)) == 0 || hz <= 0 || counter_value(addr(&mut ticks)) == 0 || ticks < 0 { return -1 }\n            now[0] = ticks / hz\n            now[1] = i64(f64(ticks % hz) / f64(hz) * 1000000000.0)\n        } else { return -1 }\n        return now[0] * 1000000000 + now[1]\n    }\n}\n\npub fn monotonic_ms() -> i64 {\n    now := monotonic_ns()\n    if now < 0 { return -1 }\n    now / 1000000\n}\n\n@thread_safe\npub fn unix_now() -> UnixTime {\n    if target_is(\"macos\") {\n        unsafe {\n            mut ts: [i64; 2] = [0; 2]\n            if c_clock_gettime(0, addr(&mut ts[0])) == 0 {\n                return UnixTime { secs: ts[0], nanos: i32(ts[1]) }\n            }\n        }\n    } else if target_is(\"linux\") {\n        unsafe {\n            mut ts: [i64; 2] = [0; 2]\n            if sys.linux_syscall(113, 0, i64(usize(addr(&mut ts[0]))), 0, 0, 0, 0) == 0 {\n                return UnixTime { secs: ts[0], nanos: i32(ts[1]) }\n            }\n        }\n    } else if target_is(\"windows\") {\n        unsafe {\n            mut ticks: i64 = 0\n            system_file_time(addr(&mut ticks))\n            return UnixTime { secs: ticks / 10000000 - 11644473600, nanos: i32(ticks % 10000000) * 100 }\n        }\n    }\n    UnixTime { secs: 0, nanos: 0 }\n}\n\npub fn unix_now_secs() -> i64 {\n    unix_now().secs\n}\n\npub fn unix_now_ms() -> i64 {\n    unix_now().as_millis()\n}\n\npub fn utc_from_unix(secs: i64) -> DateTime {\n    mut days := secs / 86400\n    mut rem := secs % 86400\n    if rem < 0 { rem += 86400; days -= 1 }\n    mut weekday := i32((days + 4) % 7)\n    if weekday < 0 { weekday += 7 }\n\n    hour := i32(rem / 3600)\n    rem_m := rem % 3600\n    minute := i32(rem_m / 60)\n    second := i32(rem_m % 60)\n\n    z := days + 719468\n    era := (if z >= 0 { z } else { z - 146096 }) / 146097\n    doe := z - era * 146097\n    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365\n    y_base := yoe + era * 400\n    doy := doe - (yoe * 365 + yoe / 4 - yoe / 100)\n    mp := (doy * 5 + 2) / 153\n    day := i32(doy - (mp * 153 + 2) / 5 + 1)\n    month := i32(mp + (if mp < 10 { i64(3) } else { i64(-9) }))\n    year := i32(y_base + (if month <= 2 { i64(1) } else { i64(0) }))\n\n    DateTime {\n        year: year,\n        month: month,\n        day: day,\n        hour: hour,\n        minute: minute,\n        second: second,\n        weekday: weekday,\n    }\n}\n\npub fn unix_from_utc(dt: &DateTime) -> i64 {\n    mut y := i64(dt.year)\n    m := i64(dt.month)\n    d := i64(dt.day)\n    if m <= 2 { y -= 1 }\n    era := (if y >= 0 { y } else { y - 399 }) / 400\n    yoe := y - era * 400\n    doy := ((m + (if m > 2 { i64(-3) } else { i64(9) })) * 153 + 2) / 5 + d - 1\n    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy\n    days := era * 146097 + doe - 719468\n    days * 86400 + i64(dt.hour) * 3600 + i64(dt.minute) * 60 + i64(dt.second)\n}\n\nfn pad2(n: i32) -> string {\n    if n < 10 { return \"0\" + n.str() }\n    n.str()\n}\n\nfn pad3(n: i32) -> string {\n    if n < 10 { return \"00\" + n.str() }\n    if n < 100 { return \"0\" + n.str() }\n    n.str()\n}\n\nfn pad4(n: i32) -> string {\n    if n < 0 {\n        pos := -n\n        return \"-\" + pad4(pos)\n    }\n    if n < 10 { return \"000\" + n.str() }\n    if n < 100 { return \"00\" + n.str() }\n    if n < 1000 { return \"0\" + n.str() }\n    n.str()\n}\n\nfn fmt_iso_parts(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32) -> string {\n    pad4(year) + \"-\" + pad2(month) + \"-\" + pad2(day) + \"T\" +\n        pad2(hour) + \":\" + pad2(minute) + \":\" + pad2(second) + \"Z\"\n}\n\npub fn format_rfc3339(secs: i64) -> string {\n    dt := utc_from_unix(secs)\n    fmt_iso_parts(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second)\n}\n\npub fn format_rfc3339_ms(t: UnixTime) -> string {\n    mut secs := t.secs\n    mut ms := t.nanos / 1000000\n    if ms < 0 { ms += 1000; secs -= 1 }\n    else if ms >= 1000 { secs += i64(ms / 1000); ms = ms % 1000 }\n    dt := utc_from_unix(secs)\n    pad4(dt.year) + \"-\" + pad2(dt.month) + \"-\" + pad2(dt.day) + \"T\" +\n        pad2(dt.hour) + \":\" + pad2(dt.minute) + \":\" + pad2(dt.second) + \".\" + pad3(ms) + \"Z\"\n}\n\nfn weekday_name(weekday: i32) -> string {\n    if weekday == 0 { return \"Sun\" }\n    if weekday == 1 { return \"Mon\" }\n    if weekday == 2 { return \"Tue\" }\n    if weekday == 3 { return \"Wed\" }\n    if weekday == 4 { return \"Thu\" }\n    if weekday == 5 { return \"Fri\" }\n    \"Sat\"\n}\n\nfn month_name(month: i32) -> string {\n    if month == 1 { return \"Jan\" }\n    if month == 2 { return \"Feb\" }\n    if month == 3 { return \"Mar\" }\n    if month == 4 { return \"Apr\" }\n    if month == 5 { return \"May\" }\n    if month == 6 { return \"Jun\" }\n    if month == 7 { return \"Jul\" }\n    if month == 8 { return \"Aug\" }\n    if month == 9 { return \"Sep\" }\n    if month == 10 { return \"Oct\" }\n    if month == 11 { return \"Nov\" }\n    \"Dec\"\n}\n\npub fn format_http_date(secs: i64) -> string {\n    dt := utc_from_unix(secs)\n    weekday_name(dt.weekday) + \", \" + pad2(dt.day) + \" \" + month_name(dt.month) + \" \" +\n        pad4(dt.year) + \" \" + pad2(dt.hour) + \":\" + pad2(dt.minute) + \":\" + pad2(dt.second) + \" GMT\"\n}\n\n@test fn rfc3339_and_http_date_formatting() {\n    assert(format_rfc3339(0) == \"1970-01-01T00:00:00Z\")\n    assert(format_http_date(0) == \"Thu, 01 Jan 1970 00:00:00 GMT\")\n\n    assert(format_rfc3339(-1) == \"1969-12-31T23:59:59Z\")\n    assert(format_http_date(-1) == \"Wed, 31 Dec 1969 23:59:59 GMT\")\n\n    // 2000-02-29T12:34:56Z (leap century year)\n    leap_2000: i64 = 951827696\n    assert(format_rfc3339(leap_2000) == \"2000-02-29T12:34:56Z\")\n    assert(format_http_date(leap_2000) == \"Tue, 29 Feb 2000 12:34:56 GMT\")\n\n    // 2024-02-29T23:59:59Z (leap year)\n    leap_2024: i64 = 1709251199\n    assert(format_rfc3339(leap_2024) == \"2024-02-29T23:59:59Z\")\n    assert(format_http_date(leap_2024) == \"Thu, 29 Feb 2024 23:59:59 GMT\")\n\n    // 1900-03-01T00:00:00Z (non-leap century year): -2203891200\n    assert(format_rfc3339(-2203891200) == \"1900-03-01T00:00:00Z\")\n    // 2100-03-01T00:00:00Z (non-leap century year): 4107542400\n    assert(format_rfc3339(4107542400) == \"2100-03-01T00:00:00Z\")\n\n    t := UnixTime::from_millis(1709251199045)\n    assert(format_rfc3339_ms(t) == \"2024-02-29T23:59:59.045Z\")\n\n    samples: []i64 = [-2203891200, -1, 0, 86400, 951827696, 1709251199, 1763683200, 4107542400]\n    for sample in samples {\n        dt := utc_from_unix(sample)\n        assert(unix_from_utc(&dt) == sample)\n    }\n}\n" }
    if name == "toml" { return "import std.toml.values as scalars\nimport std.toml.tree as tables\nimport std.json as json\n\npub struct ParseResult { ok: bool, error: string, json: string }\nstruct Parser { input: string, pos: i32, error: string, nodes: tables.Tree }\n\nfn fail(p: &mut Parser, message: string) {\n    if p.error != \"\" { return }\n    mut line := 1; mut column := 1\n    mut end := p.pos; if end > p.input.len { end = p.input.len }\n    for i in 0..end {\n        if p.input[i] == 10 { line += 1; column = 1 } else { column += 1 }\n    }\n    p.error = f\"TOML line {line}, column {column}: {message}\"\n}\nfn tree_error(p: &mut Parser) {\n    message := tables.error(&p.nodes)\n    if message != \"\" { fail(&mut p, message) }\n}\nfn peek(p: &Parser) -> i32 { if p.pos >= p.input.len { return -1 }; i32(p.input[p.pos]) }\nfn horizontal(p: &mut Parser) {\n    while peek(&p) == 32 || peek(&p) == 9 { p.pos += 1 }\n}\nfn comment(p: &mut Parser) {\n    if peek(&p) == 35 {\n        while peek(&p) >= 0 && peek(&p) != 10 && peek(&p) != 13 { p.pos += 1 }\n    }\n}\nfn whitespace(p: &mut Parser) {\n    while p.pos < p.input.len && p.error == \"\" {\n        horizontal(&mut p); comment(&mut p)\n        if peek(&p) == 10 { p.pos += 1 }\n        else if peek(&p) == 13 { p.pos += 2 }\n        else { return }\n    }\n}\nfn add(p: &mut Parser, parent: i32, key: string, kind: i32, definition: i32) -> i32 {\n    if p.error != \"\" { return -1 }\n    result := tables.add(&mut p.nodes, parent, key, kind, definition)\n    tree_error(&mut p); result\n}\nfn quoted(p: &mut Parser, key: bool) -> string {\n    parsed := scalars.quoted(p.input, p.pos, key)\n    p.pos = parsed.next\n    if !parsed.ok { fail(&mut p, parsed.error); return \"\" }\n    parsed.value\n}\nfn key_path(p: &mut Parser) -> []string {\n    mut result: []string = []\n    while p.error == \"\" {\n        horizontal(&mut p)\n        mut key := \"\"\n        if peek(&p) == 34 || peek(&p) == 39 { key = quoted(&mut p, true) }\n        else {\n            start := p.pos\n            while p.pos < p.input.len {\n                b := peek(&p)\n                if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95) { break }\n                p.pos += 1\n            }\n            if p.pos == start { fail(&mut p, \"expected a key\"); return result }\n            key = p.input[start..p.pos]\n        }\n        if p.error != \"\" { return result }\n        if result.len >= 64 { fail(&mut p, \"maximum nesting depth exceeded\"); return result }\n        result.push(move key)\n        horizontal(&mut p)\n        if peek(&p) != 46 { return result }\n        p.pos += 1\n    }\n    result\n}\nfn assignment_parent(p: &mut Parser, base: i32, path: &[]string) -> i32 {\n    result := tables.assignment_parent(&mut p.nodes, base, &path)\n    tree_error(&mut p); result\n}\nfn value(p: &mut Parser, parent: i32, key: string, depth: i32) -> i32 {\n    if depth > 64 { fail(&mut p, \"maximum nesting depth exceeded\"); return -1 }\n    if p.error != \"\" { return -1 }\n    horizontal(&mut p)\n    b := peek(&p)\n    if b == 34 || b == 39 {\n        content := quoted(&mut p, false)\n        if p.error != \"\" { return -1 }\n        result := add(&mut p, parent, key, 2, 1)\n        if result >= 0 { tables.set_value(&mut p.nodes, result, json.quote(content)) }\n        tree_error(&mut p); return result\n    }\n    if b == 91 {\n        p.pos += 1\n        result := add(&mut p, parent, key, 1, 1)\n        whitespace(&mut p)\n        while peek(&p) != 93 && p.error == \"\" {\n            _ := value(&mut p, result, \"\", depth + 1)\n            whitespace(&mut p)\n            if peek(&p) == 93 { break }\n            if peek(&p) != 44 { fail(&mut p, \"expected comma in array\"); return result }\n            p.pos += 1; whitespace(&mut p)\n        }\n        if p.error != \"\" { return result }\n        if peek(&p) != 93 { fail(&mut p, \"unterminated array\"); return result }\n        p.pos += 1; return result\n    }\n    if b == 123 {\n        p.pos += 1\n        result := add(&mut p, parent, key, 0, 0)\n        horizontal(&mut p)\n        while peek(&p) != 125 && p.error == \"\" {\n            mut path := key_path(&mut p)\n            if path.len == 0 || p.error != \"\" { return result }\n            if peek(&p) != 61 { fail(&mut p, \"expected '=' in inline table\"); return result }\n            p.pos += 1\n            container := assignment_parent(&mut p, result, &path)\n            if p.error != \"\" { return result }\n            name := path.pop()\n            if tables.field(&p.nodes, container, name) >= 0 { fail(&mut p, \"duplicate key\"); return result }\n            _ := value(&mut p, container, name, depth + 1)\n            horizontal(&mut p)\n            if peek(&p) == 125 { break }\n            if peek(&p) != 44 { fail(&mut p, \"expected comma in inline table\"); return result }\n            p.pos += 1; horizontal(&mut p)\n            if peek(&p) == 125 { fail(&mut p, \"trailing comma in inline table\"); return result }\n        }\n        if p.error != \"\" { return result }\n        if peek(&p) != 125 { fail(&mut p, \"unterminated inline table\"); return result }\n        p.pos += 1\n        tables.close_inline(&mut p.nodes, result); tree_error(&mut p)\n        return result\n    }\n    raw := scalars.scalar(p.input, p.pos)\n    p.pos = raw.next\n    if !raw.ok { fail(&mut p, raw.error); return -1 }\n    result := add(&mut p, parent, key, 2, 1)\n    if result >= 0 { tables.set_value(&mut p.nodes, result, raw.value) }\n    tree_error(&mut p); result\n}\nfn table(p: &mut Parser, array_table: bool) -> i32 {\n    path := key_path(&mut p)\n    if path.len == 0 || p.error != \"\" { return -1 }\n    if peek(&p) != 93 { fail(&mut p, \"expected closing table bracket\"); return -1 }\n    p.pos += 1\n    if array_table {\n        if peek(&p) != 93 { fail(&mut p, \"expected closing array-table bracket\"); return -1 }\n        p.pos += 1\n    }\n    result := tables.table(&mut p.nodes, &path, array_table)\n    tree_error(&mut p); result\n}\n\npub fn parse(input: string) -> ParseResult {\n    if input.len > 4194304 { return ParseResult { ok: false, error: \"TOML exceeds 4 MiB\", json: \"\" } }\n    mut p := Parser { input: input.clone(), pos: 0, error: \"\", nodes: tables.new() }\n    for i in 0..input.len {\n        b := i32(input[i])\n        if (b < 32 && b != 9 && b != 10 && b != 13) || b == 127 {\n            p.pos = i; fail(&mut p, \"unescaped control character\"); break\n        }\n        if b == 13 && (i + 1 >= input.len || input[i + 1] != 10) {\n            p.pos = i; fail(&mut p, \"bare carriage return\"); break\n        }\n    }\n    mut current := 0\n    while p.pos < p.input.len && p.error == \"\" {\n        whitespace(&mut p)\n        if p.pos >= p.input.len { break }\n        if peek(&p) == 91 {\n            p.pos += 1\n            mut array_table := false\n            if peek(&p) == 91 { array_table = true; p.pos += 1 }\n            current = table(&mut p, array_table)\n        } else {\n            mut path := key_path(&mut p)\n            if path.len == 0 || p.error != \"\" { break }\n            if peek(&p) != 61 { fail(&mut p, \"expected '=' after key\"); break }\n            p.pos += 1\n            container := assignment_parent(&mut p, current, &path)\n            if p.error != \"\" { break }\n            name := path.pop()\n            if tables.field(&p.nodes, container, name) >= 0 { fail(&mut p, \"duplicate key\"); break }\n            _ := value(&mut p, container, name, 0)\n        }\n        if p.error != \"\" { break }\n        horizontal(&mut p); comment(&mut p)\n        if p.pos < p.input.len && peek(&p) != 10 && peek(&p) != 13 { fail(&mut p, \"unexpected characters after value\") }\n    }\n    if p.error != \"\" { return ParseResult { ok: false, error: p.error, json: \"\" } }\n    rendered := tables.render(&p.nodes)\n    if !rendered.ok { fail(&mut p, rendered.error); return ParseResult { ok: false, error: p.error, json: \"\" } }\n    ParseResult { ok: true, error: \"\", json: rendered.json }\n}\n" }
    if name == "toml/values" { return "import std.bytes\nimport std.json\n\npub struct Parsed { ok: bool, next: i32, error: string, value: string }\nstruct Digits { ok: bool, next: i32, count: i32 }\n\nfn fail(at: i32, error: string) -> Parsed {\n    Parsed { ok: false, next: at, error: error.clone(), value: \"\" }\n}\nfn done(at: i32, value: string) -> Parsed {\n    Parsed { ok: true, next: at, error: \"\", value: value.clone() }\n}\nfn peek(input: string, at: i32) -> i32 {\n    if at < 0 || at >= input.len { return -1 }\n    i32(input[at])\n}\nfn digit(byte: i32) -> i32 {\n    if byte >= 48 && byte <= 57 { return byte - 48 }\n    if byte >= 65 && byte <= 70 { return byte - 55 }\n    if byte >= 97 && byte <= 102 { return byte - 87 }\n    -1\n}\nfn decimal(byte: i32) -> bool { byte >= 48 && byte <= 57 }\nfn continuation(byte: i32) -> bool { byte >= 128 && byte <= 191 }\n\nfn utf8_width(input: string, at: i32) -> i32 {\n    a := peek(input, at)\n    b := peek(input, at + 1)\n    if a >= 194 && a <= 223 {\n        if continuation(b) { return 2 }\n        return 0\n    }\n    c := peek(input, at + 2)\n    if a >= 224 && a <= 239 {\n        if !continuation(b) || !continuation(c) { return 0 }\n        if a == 224 && b < 160 { return 0 }\n        if a == 237 && b >= 160 { return 0 }\n        return 3\n    }\n    d := peek(input, at + 3)\n    if a >= 240 && a <= 244 {\n        if !continuation(b) || !continuation(c) || !continuation(d) { return 0 }\n        if a == 240 && b < 144 { return 0 }\n        if a == 244 && b >= 144 { return 0 }\n        return 4\n    }\n    0\n}\n\npub fn quoted(input: string, start: i32, key: bool) -> Parsed {\n    quote := peek(input, start)\n    if quote != 34 && quote != 39 { return fail(start, \"expected a quoted string\") }\n    mut pos := start + 1\n    mut multiline := false\n    if peek(input, pos) == quote && peek(input, pos + 1) == quote {\n        if key { return fail(start, \"multiline strings are not permitted as keys\") }\n        multiline = true\n        pos += 2\n        if peek(input, pos) == 10 { pos += 1 }\n        else if peek(input, pos) == 13 {\n            if peek(input, pos + 1) != 10 { return fail(pos, \"bare carriage return in string\") }\n            pos += 2\n        }\n    }\n    mut output: []u8 = []\n    while pos < input.len {\n        byte := i32(input[pos])\n        if byte == quote {\n            if !multiline { return done(pos + 1, bytes.decode(&output).unwrap_or_default()) }\n            mut count := 1\n            while peek(input, pos + count) == quote { count += 1 }\n            if count >= 3 {\n                if count > 5 { return fail(pos + 5, \"too many closing quotes\") }\n                for _ in 0..count - 3 { output.push(u8(quote)) }\n                return done(pos + count, bytes.decode(&output).unwrap_or_default())\n            }\n        }\n        if byte == 92 && quote == 34 {\n            pos += 1\n            escape := peek(input, pos)\n            if multiline && (escape == 32 || escape == 9 || escape == 10 || escape == 13) {\n                while peek(input, pos) == 32 || peek(input, pos) == 9 { pos += 1 }\n                if peek(input, pos) != 10 && peek(input, pos) != 13 {\n                    return fail(pos, \"line-ending backslash requires a newline\")\n                }\n                while true {\n                    trimmed := peek(input, pos)\n                    if trimmed == 32 || trimmed == 9 || trimmed == 10 { pos += 1 }\n                    else if trimmed == 13 {\n                        if peek(input, pos + 1) != 10 { return fail(pos, \"bare carriage return in string\") }\n                        pos += 2\n                    } else { break }\n                }\n                continue\n            }\n            if escape < 0 { return fail(pos, \"unterminated string escape\") }\n            pos += 1\n            if escape == 34 || escape == 92 { output.push(u8(escape)) }\n            else if escape == 98 { output.push(8) }\n            else if escape == 116 { output.push(9) }\n            else if escape == 110 { output.push(10) }\n            else if escape == 102 { output.push(12) }\n            else if escape == 114 { output.push(13) }\n            else if escape == 117 || escape == 85 {\n                mut width := 4\n                if escape == 85 { width = 8 }\n                mut code: i64 = 0\n                first := pos\n                for _ in 0..width {\n                    d := digit(peek(input, pos))\n                    if d < 0 { return fail(pos, \"invalid Unicode escape\") }\n                    code = code * 16 + i64(d)\n                    pos += 1\n                }\n                if code > 1114111 || (code >= 55296 && code <= 57343) {\n                    return fail(first, \"Unicode escape is not a scalar value\")\n                }\n                bytes.append_utf8(&mut output, rune(i32(code)).str())\n            } else { return fail(pos - 1, \"invalid string escape\") }\n        } else {\n            if byte < 32 && byte != 9 && !(multiline && (byte == 10 || byte == 13)) {\n                return fail(pos, \"control byte in string\")\n            }\n            if byte == 127 { return fail(pos, \"control byte in string\") }\n            if byte == 13 {\n                if !multiline { return fail(pos, \"newline in single-line string\") }\n                if peek(input, pos + 1) != 10 { return fail(pos, \"bare carriage return in string\") }\n                output.push(10)\n                pos += 2\n            } else if byte >= 128 {\n                width := utf8_width(input, pos)\n                if width == 0 { return fail(pos, \"invalid UTF-8 in string\") }\n                for i in 0..width { output.push(u8(input[pos + i])) }\n                pos += width\n            } else {\n                output.push(u8(byte))\n                pos += 1\n            }\n        }\n    }\n    fail(pos, \"unterminated string\")\n}\n\nfn delimiter(byte: i32) -> bool {\n    byte < 0 || byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 35 || byte == 44 || byte == 93 || byte == 125\n}\nfn digits(input: string, start: i32, end: i32, radix: i32) -> Digits {\n    mut pos := start\n    mut count := 0\n    mut previous := false\n    while pos < end {\n        byte := i32(input[pos])\n        d := digit(byte)\n        if d >= 0 && d < radix { count += 1; previous = true; pos += 1 }\n        else if byte == 95 {\n            following := digit(peek(input, pos + 1))\n            if !previous || pos + 1 >= end || following < 0 || following >= radix {\n                return Digits { ok: false, next: pos, count: count }\n            }\n            previous = false\n            pos += 1\n        } else { break }\n    }\n    Digits { ok: count > 0, next: pos, count: count }\n}\nfn cleaned(input: string, start: i32, end: i32) -> string {\n    mut output: []u8 = []\n    mut from := start\n    if peek(input, from) == 43 { from += 1 }\n    for i in from..end { if input[i] != 95 { output.push(u8(input[i])) } }\n    bytes.decode(&output).unwrap_or_default()\n}\n\nfn unsigned_integer(input: string, start: i32, end: i32, radix: i32, negative: bool) -> Parsed {\n    mut limit: u64 = 18446744073709551615\n    if negative { limit = 9223372036854775808 }\n    mut value: u64 = 0\n    for i in start..end {\n        if input[i] != 95 {\n            d := u64(digit(i32(input[i])))\n            if value > (limit - d) / u64(radix) { return fail(i, \"integer exceeds supported 64-bit range\") }\n            value = value * u64(radix) + d\n        }\n    }\n    if radix == 10 { return done(end, cleaned(input, start, end)) }\n    mut output: []u8 = []\n    json.write_u64(&mut output, value)\n    done(end, bytes.decode(&output).unwrap_or_default())\n}\n\nfn decimal_number(input: string, start: i32, end: i32) -> Parsed {\n    mut pos := start\n    negative := peek(input, pos) == 45\n    if negative || peek(input, pos) == 43 { pos += 1 }\n    integral := pos\n    whole := digits(input, pos, end, 10)\n    if !whole.ok { return fail(whole.next, \"expected decimal digits\") }\n    if whole.count > 1 && input[integral] == 48 { return fail(integral + 1, \"leading zero in decimal number\") }\n    pos = whole.next\n    mut floating := false\n    if pos < end && input[pos] == 46 {\n        floating = true\n        fraction := digits(input, pos + 1, end, 10)\n        if !fraction.ok { return fail(fraction.next, \"expected fractional digits\") }\n        pos = fraction.next\n    }\n    if pos < end && (input[pos] == 101 || input[pos] == 69) {\n        floating = true\n        pos += 1\n        if pos < end && (input[pos] == 43 || input[pos] == 45) { pos += 1 }\n        exponent := digits(input, pos, end, 10)\n        if !exponent.ok { return fail(exponent.next, \"expected exponent digits\") }\n        pos = exponent.next\n    }\n    if pos != end { return fail(pos, \"invalid scalar value\") }\n    if floating { return done(end, cleaned(input, start, end)) }\n    magnitude := unsigned_integer(input, integral, end, 10, negative)\n    if !magnitude.ok { return magnitude }\n    if magnitude.value == \"0\" { return done(end, \"0\") }\n    done(end, cleaned(input, start, end))\n}\n\nfn fixed_decimal(input: string, start: i32, width: i32, end: i32) -> i32 {\n    if start + width > end { return -1 }\n    mut value := 0\n    for i in start..start + width {\n        b := i32(input[i])\n        if !decimal(b) { return -1 }\n        value = value * 10 + b - 48\n    }\n    value\n}\nfn date_shape(input: string, start: i32, end: i32) -> bool {\n    end - start >= 10 && peek(input, start + 4) == 45 && peek(input, start + 7) == 45\n}\nfn month_days(year: i32, month: i32) -> i32 {\n    if month == 2 {\n        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) { return 29 }\n        return 28\n    }\n    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }\n    31\n}\nfn date_time(input: string, start: i32, end: i32, has_date: bool) -> Parsed {\n    mut pos := start\n    mut tag := \"$toml_time\"\n    if has_date {\n        year := fixed_decimal(input, pos, 4, end)\n        month := fixed_decimal(input, pos + 5, 2, end)\n        day := fixed_decimal(input, pos + 8, 2, end)\n        if year < 0 { return fail(pos, \"invalid calendar year\") }\n        if month < 1 || month > 12 { return fail(pos + 5, \"invalid calendar month\") }\n        if day < 1 || day > month_days(year, month) { return fail(pos + 8, \"invalid calendar day\") }\n        pos += 10\n        if pos == end { return done(end, \"{\\\"$toml_date\\\":\" + json.quote(input[start..end]) + \"}\") }\n        if input[pos] != 84 && input[pos] != 116 && input[pos] != 32 { return fail(pos, \"expected date-time separator\") }\n        pos += 1\n        tag = \"$toml_datetime\"\n    }\n    hour := fixed_decimal(input, pos, 2, end)\n    minute := fixed_decimal(input, pos + 3, 2, end)\n    second := fixed_decimal(input, pos + 6, 2, end)\n    if hour < 0 || hour > 23 { return fail(pos, \"invalid time hour\") }\n    if peek(input, pos + 2) != 58 { return fail(pos + 2, \"expected time colon\") }\n    if minute < 0 || minute > 59 { return fail(pos + 3, \"invalid time minute\") }\n    if peek(input, pos + 5) != 58 { return fail(pos + 5, \"expected time colon\") }\n    if second == 60 { return fail(pos + 6, \"leap seconds are not supported\") }\n    if second < 0 || second > 59 { return fail(pos + 6, \"invalid time second\") }\n    pos += 8\n    if pos < end && input[pos] == 46 {\n        pos += 1\n        first := pos\n        while pos < end && decimal(i32(input[pos])) { pos += 1 }\n        if first == pos { return fail(pos, \"expected fractional second digits\") }\n    }\n    if pos < end {\n        if !has_date { return fail(pos, \"local time cannot have an offset\") }\n        if input[pos] == 90 || input[pos] == 122 { pos += 1 }\n        else if input[pos] == 43 || input[pos] == 45 {\n            zone_hour := fixed_decimal(input, pos + 1, 2, end)\n            zone_minute := fixed_decimal(input, pos + 4, 2, end)\n            if zone_hour < 0 || zone_hour > 23 { return fail(pos + 1, \"invalid offset hour\") }\n            if peek(input, pos + 3) != 58 { return fail(pos + 3, \"expected offset colon\") }\n            if zone_minute < 0 || zone_minute > 59 { return fail(pos + 4, \"invalid offset minute\") }\n            pos += 6\n        } else { return fail(pos, \"invalid date-time suffix\") }\n    }\n    if pos != end { return fail(pos, \"invalid date-time suffix\") }\n    mut output: []u8 = []\n    for i in start..end {\n        mut b := i32(input[i])\n        if has_date && i == start + 10 { b = 84 }\n        if b == 122 { b = 90 }\n        output.push(u8(b))\n    }\n    done(end, \"{\" + json.quote(tag) + \":\" + json.quote(bytes.decode(&output).unwrap_or_default()) + \"}\")\n}\n\npub fn scalar(input: string, start: i32) -> Parsed {\n    if start < 0 || start >= input.len { return fail(start, \"expected a value\") }\n    mut end := start\n    while end < input.len && !delimiter(i32(input[end])) { end += 1 }\n    if end == start { return fail(start, \"expected a value\") }\n    if end == start + 10 && date_shape(input, start, end) && peek(input, end) == 32 && decimal(peek(input, end + 1)) {\n        end += 1\n        while end < input.len && !delimiter(i32(input[end])) { end += 1 }\n    }\n    raw := input[start..end]\n    if raw == \"true\" || raw == \"false\" { return done(end, raw) }\n    if raw == \"inf\" || raw == \"+inf\" { return done(end, \"{\\\"$toml_float\\\":\\\"inf\\\"}\") }\n    if raw == \"-inf\" { return done(end, \"{\\\"$toml_float\\\":\\\"-inf\\\"}\") }\n    if raw == \"nan\" || raw == \"+nan\" || raw == \"-nan\" { return done(end, \"{\\\"$toml_float\\\":\\\"nan\\\"}\") }\n    if date_shape(input, start, end) { return date_time(input, start, end, true) }\n    if end - start >= 3 && peek(input, start + 2) == 58 { return date_time(input, start, end, false) }\n    if end - start >= 2 && input[start] == 48 {\n        mut radix := 0\n        if input[start + 1] == 120 { radix = 16 }\n        else if input[start + 1] == 111 { radix = 8 }\n        else if input[start + 1] == 98 { radix = 2 }\n        if radix != 0 {\n            body := digits(input, start + 2, end, radix)\n            if !body.ok || body.next != end { return fail(body.next, \"invalid radix integer\") }\n            return unsigned_integer(input, start + 2, end, radix, false)\n        }\n    }\n    decimal_number(input, start, end)\n}\n" }
    if name == "toml/tree" { return "import std.bytes\nimport std.json\n\npub opaque struct Tree {\n    problem: string,\n    parents: []i32,\n    keys: []string,\n    kinds: []i32,\n    values: []string,\n    definitions: []i32,\n    depths: []i32,\n    first: []i32,\n    last: []i32,\n    next: []i32,\n    fields: Map<string, i32>,\n}\n\npub struct RenderResult { ok: bool, error: string, json: string }\n\npub fn new() -> Tree {\n    Tree {\n        problem: \"\", parents: [-1], keys: [\"\"], kinds: [0], values: [\"\"],\n        definitions: [1], depths: [0], first: [-1], last: [-1], next: [-1],\n        fields: Map<string, i32>::new(),\n    }\n}\n\nimpl Sendable for Tree {}\nimpl Default for Tree {\n    fn default() -> Self { new() }\n}\n\nfn fail(tree: &mut Tree, message: string) {\n    if tree.problem == \"\" { tree.problem = message.clone() }\n}\n\nfn valid(tree: &Tree, node: i32) -> bool { node >= 0 && node < tree.kinds.len }\n\npub fn error(tree: &Tree) -> string { tree.problem.clone() }\npub fn kind(tree: &Tree, node: i32) -> i32 {\n    if !valid(&tree, node) { return -1 }\n    tree.kinds[node]\n}\npub fn definition(tree: &Tree, node: i32) -> i32 {\n    if !valid(&tree, node) { return -1 }\n    tree.definitions[node]\n}\npub fn get(tree: &Tree, node: i32) -> string {\n    if !valid(&tree, node) { return \"\" }\n    tree.values[node].clone()\n}\n\nfn indexed(parent: i32, key: string) -> string { f\"{parent}:{key}\" }\n\npub fn field(tree: &Tree, parent: i32, key: string) -> i32 {\n    if !valid(&tree, parent) || tree.kinds[parent] != 0 { return -1 }\n    tree.fields.get_or(indexed(parent, key), -1)\n}\n\npub fn add(tree: &mut Tree, parent: i32, key: string, node_kind: i32, node_definition: i32) -> i32 {\n    if tree.problem != \"\" { return -1 }\n    if !valid(&tree, parent) || tree.kinds[parent] == 2 {\n        fail(&mut tree, \"cannot add a value to a scalar\"); return -1\n    }\n    if tree.definitions[parent] == 3 {\n        fail(&mut tree, \"cannot extend an inline table\"); return -1\n    }\n    if node_kind < 0 || node_kind > 3 || node_definition < 0 || node_definition > 3 {\n        fail(&mut tree, \"invalid configuration node\"); return -1\n    }\n    if tree.kinds[parent] == 3 && node_kind != 0 {\n        fail(&mut tree, \"array table elements must be tables\"); return -1\n    }\n    if node_kind == 3 && tree.kinds[parent] != 0 {\n        fail(&mut tree, \"array table requires a table parent\"); return -1\n    }\n    if tree.kinds[parent] == 0 && field(&tree, parent, key) >= 0 {\n        fail(&mut tree, \"duplicate key\"); return -1\n    }\n    if tree.kinds.len >= 100000 {\n        fail(&mut tree, \"configuration has too many values\"); return -1\n    }\n    node_depth := tree.depths[parent] + 1\n    if node_depth > 64 {\n        fail(&mut tree, \"maximum nesting depth exceeded\"); return -1\n    }\n    result := tree.kinds.len\n    tree.parents.push(parent); tree.keys.push(key.clone()); tree.kinds.push(node_kind)\n    tree.values.push(\"\"); tree.definitions.push(node_definition); tree.depths.push(node_depth)\n    tree.first.push(-1); tree.last.push(-1); tree.next.push(-1)\n    previous := tree.last[parent]\n    if previous < 0 { tree.first[parent] = result }\n    else { tree.next[previous] = result }\n    tree.last[parent] = result\n    if tree.kinds[parent] == 0 { tree.fields.put(indexed(parent, key), result) }\n    result\n}\n\npub fn set_definition(tree: &mut Tree, node: i32, value: i32) {\n    if tree.problem != \"\" { return }\n    if !valid(&tree, node) || value < 0 || value > 3 {\n        fail(&mut tree, \"invalid table definition\"); return\n    }\n    previous := tree.definitions[node]\n    if previous == 3 && value != 3 {\n        fail(&mut tree, \"cannot extend an inline table\"); return\n    }\n    if previous != 0 && value != previous && value != 3 {\n        fail(&mut tree, \"duplicate or conflicting table\"); return\n    }\n    if value == 3 { close_inline(&mut tree, node); return }\n    tree.definitions[node] = value\n}\n\npub fn set_value(tree: &mut Tree, node: i32, value: string) {\n    if tree.problem != \"\" { return }\n    if !valid(&tree, node) || tree.kinds[node] != 2 || value == \"\" {\n        fail(&mut tree, \"invalid scalar value\"); return\n    }\n    if tree.definitions[node] == 3 || tree.values[node] != \"\" {\n        fail(&mut tree, \"duplicate key\"); return\n    }\n    tree.values[node] = value.clone()\n}\n\npub fn assignment_parent(tree: &mut Tree, base: i32, path: &[]string) -> i32 {\n    if tree.problem != \"\" { return -1 }\n    if path.len == 0 { fail(&mut tree, \"expected a key\"); return -1 }\n    if !valid(&tree, base) || tree.kinds[base] != 0 || tree.definitions[base] == 3 {\n        fail(&mut tree, \"cannot extend a scalar or inline table\"); return -1\n    }\n    mut current := base\n    for i in 0..path.len - 1 {\n        mut child := field(&tree, current, path[i])\n        if child < 0 { child = add(&mut tree, current, path[i], 0, 2) }\n        if child < 0 { return -1 }\n        if tree.kinds[child] != 0 || tree.definitions[child] == 3 {\n            fail(&mut tree, \"key conflicts with an existing value\"); return -1\n        }\n        if tree.definitions[child] == 1 {\n            fail(&mut tree, \"cannot redefine an explicitly declared table with a dotted key\"); return -1\n        }\n        tree.definitions[child] = 2\n        current = child\n    }\n    current\n}\n\npub fn table(tree: &mut Tree, path: &[]string, array_table: bool) -> i32 {\n    if tree.problem != \"\" { return -1 }\n    if path.len == 0 { fail(&mut tree, \"expected a table name\"); return -1 }\n    mut current := 0\n    for i in 0..path.len {\n        if tree.definitions[current] == 3 {\n            fail(&mut tree, \"cannot extend an inline table\"); return -1\n        }\n        last_segment := i + 1 == path.len\n        mut child := field(&tree, current, path[i])\n        if child < 0 {\n            mut child_kind := 0\n            if last_segment && array_table { child_kind = 3 }\n            child = add(&mut tree, current, path[i], child_kind, 0)\n            if child < 0 { return -1 }\n        }\n        if last_segment {\n            if array_table {\n                if tree.kinds[child] != 3 || tree.definitions[child] == 3 {\n                    fail(&mut tree, \"array table conflicts with an existing value\"); return -1\n                }\n                return add(&mut tree, child, \"\", 0, 1)\n            }\n            if tree.kinds[child] != 0 || tree.definitions[child] != 0 {\n                fail(&mut tree, \"duplicate or conflicting table\"); return -1\n            }\n            tree.definitions[child] = 1\n            return child\n        }\n        if tree.kinds[child] == 3 {\n            child = tree.last[child]\n            if child < 0 { fail(&mut tree, \"array table has no current element\"); return -1 }\n        }\n        if tree.kinds[child] != 0 || tree.definitions[child] == 3 {\n            fail(&mut tree, \"table path conflicts with a value\"); return -1\n        }\n        current = child\n    }\n    -1\n}\n\nfn seal(tree: &mut Tree, node: i32) {\n    tree.definitions[node] = 3\n    mut child := tree.first[node]\n    while child >= 0 { seal(&mut tree, child); child = tree.next[child] }\n}\n\npub fn close_inline(tree: &mut Tree, node: i32) {\n    if tree.problem != \"\" { return }\n    if !valid(&tree, node) || tree.kinds[node] != 0 {\n        fail(&mut tree, \"invalid inline table\"); return\n    }\n    seal(&mut tree, node)\n}\n\nfn quoted_size(value: string) -> i64 {\n    mut result: i64 = 2\n    for byte in value.bytes() {\n        if byte == 34 || byte == 92 || byte == 8 || byte == 12 || byte == 10 || byte == 13 || byte == 9 { result += 2 }\n        else if byte < 32 { result += 6 }\n        else { result += 1 }\n    }\n    result\n}\n\nfn rendered_size(tree: &Tree) -> i64 {\n    mut size: i64 = 0\n    for node in 0..tree.kinds.len {\n        if tree.kinds[node] == 2 {\n            if tree.values[node] == \"\" { return -1 }\n            size += i64(tree.values[node].len)\n        } else { size += 2 }\n        parent := tree.parents[node]\n        if parent >= 0 {\n            if tree.first[parent] != node { size += 1 }\n            if tree.kinds[parent] == 0 { size += quoted_size(tree.keys[node]) + 1 }\n        }\n        if size > 67108864 { return -2 }\n    }\n    size\n}\n\nfn write_node(tree: &Tree, node: i32, output: &mut []u8) {\n    if tree.kinds[node] == 2 { bytes.append_utf8(&mut output, tree.values[node]); return }\n    array := tree.kinds[node] == 1 || tree.kinds[node] == 3\n    if array { output.push(91) } else { output.push(123) }\n    mut child := tree.first[node]\n    while child >= 0 {\n        if child != tree.first[node] { output.push(44) }\n        if !array { json.write_str(&mut output, tree.keys[child]); output.push(58) }\n        write_node(&tree, child, &mut output)\n        child = tree.next[child]\n    }\n    if array { output.push(93) } else { output.push(125) }\n}\n\npub fn render(tree: &Tree) -> RenderResult {\n    if tree.problem != \"\" { return RenderResult { ok: false, error: tree.problem.clone(), json: \"\" } }\n    size := rendered_size(&tree)\n    if size == -1 { return RenderResult { ok: false, error: \"configuration contains an unfinished scalar\", json: \"\" } }\n    if size == -2 { return RenderResult { ok: false, error: \"configuration JSON exceeds 64 MiB\", json: \"\" } }\n    mut output: []u8 = []\n    output.reserve(i32(size))\n    write_node(&tree, 0, &mut output)\n    RenderResult { ok: true, error: \"\", json: bytes.decode(&output).unwrap_or_default() }\n}\n\nfn test_value(tree: &mut Tree, parent: i32, key: string, value: string) -> i32 {\n    node := add(&mut tree, parent, key, 2, 1)\n    set_value(&mut tree, node, value)\n    node\n}\n\n@test fn keys_with_dots_empty_strings_colons_and_nul_stay_distinct() {\n    mut tree := new()\n    dotted := test_value(&mut tree, 0, \"a.b\", \"1\")\n    empty := test_value(&mut tree, 0, \"\", \"2\")\n    nul := test_value(&mut tree, 0, \"\\0\", \"3\")\n    prefixed := test_value(&mut tree, 0, \"1:key\", \"4\")\n    path: []string = [\"a\", \"b\"]\n    parent := assignment_parent(&mut tree, 0, &path)\n    nested := test_value(&mut tree, parent, \"b\", \"5\")\n    assert(field(&tree, 0, \"a.b\") == dotted && field(&tree, 0, \"\") == empty)\n    assert(field(&tree, 0, \"\\0\") == nul && field(&tree, 0, \"1:key\") == prefixed)\n    assert(field(&tree, parent, \"b\") == nested && get(&tree, nested) == \"5\")\n    out := render(&tree)\n    assert(out.ok && out.json == \"{\\\"a.b\\\":1,\\\"\\\":2,\\\"\\\\u0000\\\":3,\\\"1:key\\\":4,\\\"a\\\":{\\\"b\\\":5}}\")\n}\n\n@test fn duplicate_values_preserve_first_error_and_payload() {\n    mut tree := new()\n    first := test_value(&mut tree, 0, \"key\", \"1\")\n    assert(add(&mut tree, 0, \"key\", 2, 1) == -1)\n    assert(error(&tree) == \"duplicate key\" && get(&tree, first) == \"1\")\n    assert(table(&mut tree, &[\"key\"], false) == -1)\n    assert(error(&tree) == \"duplicate key\" && !render(&tree).ok)\n}\n\n@test fn implicit_supertables_can_be_declared_once() {\n    mut tree := new()\n    leaf := table(&mut tree, &[\"a\", \"b\", \"c\"], false)\n    _ := test_value(&mut tree, leaf, \"value\", \"1\")\n    middle := table(&mut tree, &[\"a\", \"b\"], false)\n    _ := test_value(&mut tree, middle, \"other\", \"2\")\n    top := table(&mut tree, &[\"a\"], false)\n    assert(top > 0 && definition(&tree, top) == 1)\n    out := render(&tree)\n    assert(out.ok && out.json == \"{\\\"a\\\":{\\\"b\\\":{\\\"c\\\":{\\\"value\\\":1},\\\"other\\\":2}}}\")\n    assert(table(&mut tree, &[\"a\", \"b\"], false) == -1)\n}\n\n@test fn dotted_tables_cannot_be_declared_but_their_descendants_can() {\n    mut tree := new()\n    parent := assignment_parent(&mut tree, 0, &[\"fruit\", \"apple\"])\n    _ := test_value(&mut tree, parent, \"apple\", \"1\")\n    descendant := table(&mut tree, &[\"fruit\", \"orange\"], false)\n    assert(descendant > 0 && error(&tree) == \"\")\n    assert(table(&mut tree, &[\"fruit\"], false) == -1)\n    assert(error(&tree) == \"duplicate or conflicting table\")\n}\n\n@test fn dotted_assignment_claims_implicit_header_parents() {\n    mut tree := new()\n    _ := table(&mut tree, &[\"a\", \"b\", \"c\"], false)\n    top := table(&mut tree, &[\"a\"], false)\n    parent := assignment_parent(&mut tree, top, &[\"b\", \"d\"])\n    _ := test_value(&mut tree, parent, \"d\", \"1\")\n    assert(definition(&tree, parent) == 2)\n    assert(table(&mut tree, &[\"a\", \"b\"], false) == -1)\n}\n\n@test fn dotted_assignment_cannot_reopen_explicit_headers() {\n    mut tree := new()\n    _ := table(&mut tree, &[\"a\", \"b\"], false)\n    top := table(&mut tree, &[\"a\"], false)\n    assert(assignment_parent(&mut tree, top, &[\"b\", \"other\"]) == -1)\n    assert(error(&tree) == \"cannot redefine an explicitly declared table with a dotted key\")\n}\n\n@test fn array_table_paths_use_latest_element_at_every_segment() {\n    mut tree := new()\n    first := table(&mut tree, &[\"fruit\"], true)\n    _ := test_value(&mut tree, first, \"name\", \"\\\"apple\\\"\")\n    variety := table(&mut tree, &[\"fruit\", \"variety\"], true)\n    detail := table(&mut tree, &[\"fruit\", \"variety\", \"detail\"], false)\n    _ := test_value(&mut tree, detail, \"code\", \"1\")\n    _ := table(&mut tree, &[\"fruit\", \"variety\"], true)\n    second_detail := table(&mut tree, &[\"fruit\", \"variety\", \"detail\"], false)\n    _ := test_value(&mut tree, second_detail, \"code\", \"2\")\n    second := table(&mut tree, &[\"fruit\"], true)\n    _ := test_value(&mut tree, second, \"name\", \"\\\"banana\\\"\")\n    _ := table(&mut tree, &[\"fruit\", \"variety\"], true)\n    third_detail := table(&mut tree, &[\"fruit\", \"variety\", \"detail\"], false)\n    _ := test_value(&mut tree, third_detail, \"code\", \"3\")\n    assert(variety > first && second > variety && third_detail > second_detail)\n    out := render(&tree)\n    assert(out.ok && out.json == \"{\\\"fruit\\\":[{\\\"name\\\":\\\"apple\\\",\\\"variety\\\":[{\\\"detail\\\":{\\\"code\\\":1}},{\\\"detail\\\":{\\\"code\\\":2}}]},{\\\"name\\\":\\\"banana\\\",\\\"variety\\\":[{\\\"detail\\\":{\\\"code\\\":3}}]}]}\")\n    assert(table(&mut tree, &[\"fruit\", \"variety\", \"detail\"], false) == -1)\n}\n\n@test fn ordinary_arrays_cannot_become_arrays_of_tables() {\n    mut tree := new()\n    array := add(&mut tree, 0, \"fruit\", 1, 1)\n    _ := test_value(&mut tree, array, \"\", \"1\")\n    assert(table(&mut tree, &[\"fruit\"], true) == -1)\n    assert(error(&tree) == \"array table conflicts with an existing value\")\n    mut empty := new()\n    _ := add(&mut empty, 0, \"fruit\", 1, 1)\n    assert(table(&mut empty, &[\"fruit\", \"subtable\"], false) == -1)\n}\n\n@test fn inline_closure_seals_dotted_descendants_and_array_values() {\n    mut tree := new()\n    inline := add(&mut tree, 0, \"inline\", 0, 0)\n    parent := assignment_parent(&mut tree, inline, &[\"nested\", \"value\"])\n    _ := test_value(&mut tree, parent, \"value\", \"1\")\n    array := add(&mut tree, inline, \"items\", 1, 1)\n    element := add(&mut tree, array, \"\", 0, 0)\n    _ := test_value(&mut tree, element, \"value\", \"2\")\n    close_inline(&mut tree, inline)\n    assert(definition(&tree, parent) == 3 && definition(&tree, element) == 3)\n    out := render(&tree)\n    assert(out.ok && out.json == \"{\\\"inline\\\":{\\\"nested\\\":{\\\"value\\\":1},\\\"items\\\":[{\\\"value\\\":2}]}}\")\n    assert(add(&mut tree, parent, \"other\", 2, 1) == -1)\n    mut headers := new()\n    inline2 := add(&mut headers, 0, \"inline\", 0, 0)\n    close_inline(&mut headers, inline2)\n    assert(table(&mut headers, &[\"inline\", \"other\"], false) == -1)\n}\n\n@test fn depth_limit_counts_dotted_keys_and_array_table_wrappers() {\n    mut tree := new()\n    mut path: []string = []\n    for _ in 0..63 { path.push(\"nested\") }\n    path.push(\"value\")\n    parent := assignment_parent(&mut tree, 0, &path)\n    _ := test_value(&mut tree, parent, \"value\", \"1\")\n    out := render(&tree)\n    assert(out.ok && out.json.len > 64 && error(&tree) == \"\")\n    assert(add(&mut tree, parent, \"too_deep\", 1, 1) > 0)\n    array := field(&tree, parent, \"too_deep\")\n    assert(add(&mut tree, array, \"\", 2, 1) == -1)\n    mut tables := new()\n    mut header: []string = []\n    for _ in 0..63 { header.push(\"nested\") }\n    assert(table(&mut tables, &header, true) > 0)\n    assert(table(&mut tables, &header, true) > 0)\n    header.push(\"too_deep\")\n    assert(table(&mut tables, &header, false) == -1)\n}\n\n@test fn unfinished_scalars_fail_rendering_explicitly() {\n    mut tree := new()\n    _ := add(&mut tree, 0, \"value\", 2, 1)\n    out := render(&tree)\n    assert(!out.ok && out.error == \"configuration contains an unfinished scalar\" && out.json == \"\")\n    assert(render(&new()).json == \"{}\")\n}\n\n@test fn field_index_and_sibling_links_survive_growth() {\n    mut tree := new()\n    for i in 0..10000 { _ := test_value(&mut tree, 0, i.str(), i.str()) }\n    for i in 0..10000 {\n        node := field(&tree, 0, i.str())\n        assert(node == i + 1 && get(&tree, node) == i.str())\n    }\n    out := render(&tree)\n    assert(out.ok && json.Doc::parse_text(out.json).ok)\n}\n\n@test fn node_limit_accepts_the_last_node_and_rejects_the_next() {\n    mut tree := new()\n    array := add(&mut tree, 0, \"values\", 1, 1)\n    mut last := -1\n    for _ in 0..99998 { last = test_value(&mut tree, array, \"\", \"0\") }\n    assert(last == 99999 && error(&tree) == \"\")\n    out := render(&tree)\n    assert(out.ok && out.json.len == 200008)\n    assert(add(&mut tree, array, \"\", 2, 1) == -1)\n    assert(error(&tree) == \"configuration has too many values\")\n    assert(!render(&tree).ok)\n}\n" }
    if name == "wire" { return "import std.bytes as bytes\n\npub struct Reader {\n    pos: i32,\n    ok: bool,\n    error: i32,\n}\n\nimpl Reader {\n    pub fn new() -> Self { Self { pos: 0, ok: true, error: 0 } }\n\n    pub fn remaining(&self, buf: &[]u8) -> i32 {\n        if !self.ok || self.pos > buf.len { return 0 }\n        buf.len - self.pos\n    }\n\n    pub fn finish(&self, buf: &[]u8) -> bool {\n        self.ok && self.pos == buf.len\n    }\n\n    fn fail_read(&mut self, err: i32) {\n        if self.ok { self.ok = false; self.error = err }\n    }\n\n    pub fn read_u8(&mut self, buf: &[]u8) -> u8 {\n        if !self.ok { return 0 }\n        if self.pos >= buf.len { self.fail_read(1); return 0 }\n        b := buf[self.pos]\n        self.pos += 1\n        b\n    }\n\n    pub fn read_bool(&mut self, buf: &[]u8) -> bool {\n        b := self.read_u8(&buf)\n        if !self.ok { return false }\n        if b == 0 { return false }\n        if b == 1 { return true }\n        self.fail_read(2)\n        false\n    }\n\n    pub fn read_u16_le(&mut self, buf: &[]u8) -> u16 {\n        if !self.ok { return 0 }\n        if self.pos + 2 > buf.len { self.fail_read(1); return 0 }\n        v := u16(bytes.u16_le(&buf, self.pos))\n        self.pos += 2\n        v\n    }\n\n    pub fn read_i32_le(&mut self, buf: &[]u8) -> i32 {\n        if !self.ok { return 0 }\n        if self.pos + 4 > buf.len { self.fail_read(1); return 0 }\n        value := bytes.i32_le(&buf, self.pos)\n        self.pos += 4\n        value\n    }\n\n    pub fn read_u32_le(&mut self, buf: &[]u8) -> u32 {\n        if !self.ok { return 0 }\n        if self.pos + 4 > buf.len { self.fail_read(1); return 0 }\n        raw := bytes.u32_le(&buf, self.pos)\n        self.pos += 4\n        u32(raw)\n    }\n\n    pub fn read_i64_le(&mut self, buf: &[]u8) -> i64 {\n        if !self.ok { return 0 }\n        if self.pos + 8 > buf.len { self.fail_read(1); return 0 }\n        v := bytes.i64_le(&buf, self.pos)\n        self.pos += 8\n        v\n    }\n\n    pub fn read_u64_le(&mut self, buf: &[]u8) -> u64 {\n        if !self.ok { return 0 }\n        if self.pos + 8 > buf.len { self.fail_read(1); return 0 }\n        v := bytes.u64_le(&buf, self.pos)\n        self.pos += 8\n        v\n    }\n\n    pub fn read_f32(&mut self, buf: &[]u8) -> f32 {\n        bits := self.read_i32_le(&buf)\n        if !self.ok { return 0.0 }\n        f32.from_bits(bits)\n    }\n\n    pub fn read_f64(&mut self, buf: &[]u8) -> f64 {\n        bits := self.read_i64_le(&buf)\n        if !self.ok { return 0.0 }\n        f64.from_bits(bits)\n    }\n\n    pub fn read_uvarint(&mut self, buf: &[]u8) -> u64 {\n        if !self.ok { return 0 }\n        mut result: u64 = 0\n        mut shift := 0\n        for i in 0..10 {\n            if self.pos >= buf.len { self.fail_read(1); return 0 }\n            b := buf[self.pos]\n            self.pos += 1\n            if i == 9 && b > 1 { self.fail_read(2); return 0 }\n            result = result.bit_or(u64(b.bit_and(127)).shl(shift))\n            if b < 128 { return result }\n            shift += 7\n        }\n        self.fail_read(2)\n        0\n    }\n\n    pub fn read_varint(&mut self, buf: &[]u8) -> i64 {\n        zz := self.read_uvarint(&buf)\n        if !self.ok { return 0 }\n        half := zz.shr(1)\n        if zz.bit_and(1) != 0 {\n            return -i64(half) - 1\n        }\n        i64(half)\n    }\n\n    fn read_count(&mut self, buf: &[]u8) -> i32 {\n        n := self.read_uvarint(&buf)\n        if !self.ok { return -1 }\n        if n > u64(buf.len - self.pos) { self.fail_read(1); return -1 }\n        i32(n)\n    }\n\n    pub fn read_bytes(&mut self, buf: &[]u8) -> []u8 {\n        count := self.read_count(&buf)\n        if count < 0 { return [] }\n        mut out: []u8 = []\n        bytes.extend_range(&mut out, &buf, self.pos, self.pos + count)\n        self.pos += count\n        out\n    }\n\n    pub fn read_str(&mut self, buf: &[]u8) -> string {\n        count := self.read_count(&buf)\n        if count < 0 { return \"\" }\n        dec := match bytes.decode_range(&buf, self.pos, self.pos + count) {\n            .Ok(value) => value,\n            .Err(_) => { self.fail_read(92); return \"\" },\n        }\n        self.pos += count\n        dec\n    }\n}\n\npub fn put_u8(out: &mut []u8, v: u8) { out.push(v) }\n\npub fn put_bool(out: &mut []u8, v: bool) {\n    if v { out.push(1) } else { out.push(0) }\n}\n\npub fn put_u16_le(out: &mut []u8, v: u16) {\n    bytes.append_le(&mut out, i64(v), 2)\n}\n\npub fn put_i32_le(out: &mut []u8, v: i32) {\n    bytes.append_le(&mut out, i64(v), 4)\n}\n\npub fn put_u32_le(out: &mut []u8, v: u32) {\n    bytes.append_le(&mut out, i64(v), 4)\n}\n\npub fn put_i64_le(out: &mut []u8, v: i64) {\n    bytes.append_le(&mut out, v, 8)\n}\n\npub fn put_u64_le(out: &mut []u8, v: u64) {\n    for i in 0..8 {\n        out.push(u8(v.shr(i * 8).bit_and(255)))\n    }\n}\n\npub fn put_f32(out: &mut []u8, v: f32) {\n    bits := v.to_bits()\n    bytes.append_le(&mut out, i64(bits), 4)\n}\n\npub fn put_f64(out: &mut []u8, v: f64) {\n    bits := v.to_bits()\n    bytes.append_le(&mut out, bits, 8)\n}\n\npub fn put_uvarint(out: &mut []u8, value: u64) {\n    mut v := value\n    while v >= 128 {\n        out.push(u8(v.bit_and(127).bit_or(128)))\n        v = v.shr(7)\n    }\n    out.push(u8(v))\n}\n\npub fn put_varint(out: &mut []u8, value: i64) {\n    mut zz: u64 = 0\n    if value < 0 {\n        zz = u64(-(value + 1)).shl(1).bit_or(1)\n    } else {\n        zz = u64(value).shl(1)\n    }\n    put_uvarint(&mut out, zz)\n}\n\npub fn put_bytes(out: &mut []u8, data: &[]u8) {\n    put_uvarint(&mut out, u64(data.len))\n    bytes.extend(&mut out, &data)\n}\n\npub fn put_str(out: &mut []u8, text: string) {\n    put_uvarint(&mut out, u64(text.len))\n    bytes.append_utf8(&mut out, text)\n}\n\nimpl Default for Reader {\n    fn default() -> Self { Self::new() }\n}\n\npub trait Encode {\n    fn encode_wire(&self, out: &mut []u8)\n}\n\npub trait Decode {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32>\n}\n\nimpl Encode for bool {\n    fn encode_wire(&self, out: &mut []u8) { put_bool(&mut out, self) }\n}\nimpl Decode for bool {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_bool(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for u8 {\n    fn encode_wire(&self, out: &mut []u8) { put_u8(&mut out, self) }\n}\nimpl Decode for u8 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_u8(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for u16 {\n    fn encode_wire(&self, out: &mut []u8) { put_u16_le(&mut out, self) }\n}\nimpl Decode for u16 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_u16_le(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for u32 {\n    fn encode_wire(&self, out: &mut []u8) { put_u32_le(&mut out, self) }\n}\nimpl Decode for u32 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_u32_le(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for u64 {\n    fn encode_wire(&self, out: &mut []u8) { put_u64_le(&mut out, self) }\n}\nimpl Decode for u64 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_u64_le(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for i32 {\n    fn encode_wire(&self, out: &mut []u8) { put_i32_le(&mut out, self) }\n}\nimpl Decode for i32 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_i32_le(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for i64 {\n    fn encode_wire(&self, out: &mut []u8) { put_i64_le(&mut out, self) }\n}\nimpl Decode for i64 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_i64_le(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for f32 {\n    fn encode_wire(&self, out: &mut []u8) { put_f32(&mut out, self) }\n}\nimpl Decode for f32 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_f32(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for f64 {\n    fn encode_wire(&self, out: &mut []u8) { put_f64(&mut out, self) }\n}\nimpl Decode for f64 {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_f64(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for string {\n    fn encode_wire(&self, out: &mut []u8) { put_str(&mut out, self) }\n}\nimpl Decode for string {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        v := r.read_str(&buf)\n        if !r.ok { return .Err(r.error) }\n        .Ok(v)\n    }\n}\n\nimpl Encode for []T where T: Encode {\n    fn encode_wire(&self, out: &mut []u8) {\n        put_uvarint(&mut out, u64(self.len))\n        for i in 0..self.len { self[i].encode_wire(&mut out) }\n    }\n}\nimpl Decode for []T where T: Decode {\n    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {\n        raw := r.read_uvarint(&buf)\n        if !r.ok { return .Err(r.error) }\n        if raw > u64(r.remaining(&buf)) { r.fail_read(1); return .Err(1) }\n        count := i32(raw)\n        mut out: []T = []\n        out.reserve(count)\n        for _ in 0..count {\n            item := T::decode_wire(&mut r, &buf)\n            match move item {\n                .Ok(v) => { out.push(move v) },\n                .Err(err) => { return .Err(err) },\n            }\n        }\n        .Ok(out)\n    }\n}\n\npub fn encode<T: Encode + Storable>(out: &mut []u8, value: &T) {\n    value.encode_wire(&mut out)\n}\n\npub fn decode<T: Decode + Storable>(r: &mut Reader, buf: &[]u8) -> Result<T, i32> {\n    T::decode_wire(&mut r, &buf)\n}\n\n@test\nfn wire_reader_methods_round_trip() {\n    mut buf: []u8 = []\n    put_varint(&mut buf, -7)\n    put_str(&mut buf, \"hi\")\n    mut r := Reader::new()\n    assert(r.remaining(&buf) > 0)\n    assert(r.read_varint(&buf) == -7)\n    assert(r.read_str(&buf) == \"hi\")\n    assert(r.finish(&buf))\n}\n\n@test\nfn wire_round_trips_scalars_strings_extremes_and_rejects_truncation() {\n    mut buf: []u8 = []\n    put_bool(&mut buf, true)\n    put_bool(&mut buf, false)\n    put_i32_le(&mut buf, -2147483648)\n    put_u32_le(&mut buf, 4294967295)\n    put_i64_le(&mut buf, -9223372036854775808)\n    put_u64_le(&mut buf, 18446744073709551615)\n    put_varint(&mut buf, 0)\n    put_varint(&mut buf, -1)\n    put_varint(&mut buf, 42)\n    put_varint(&mut buf, -9223372036854775808)\n    put_varint(&mut buf, 9223372036854775807)\n    put_f64(&mut buf, -3.5)\n    put_str(&mut buf, \"dunder åäö 🌍\")\n    mut raw: []u8 = [0, 255, 17]\n    put_bytes(&mut buf, &raw)\n\n    mut r := Reader::new()\n    assert(r.read_bool(&buf))\n    assert(!r.read_bool(&buf))\n    assert(r.read_i32_le(&buf) == -2147483648)\n    assert(r.read_u32_le(&buf) == 4294967295)\n    assert(r.read_i64_le(&buf) == -9223372036854775808)\n    assert(r.read_u64_le(&buf) == 18446744073709551615)\n    assert(r.read_varint(&buf) == 0)\n    assert(r.read_varint(&buf) == -1)\n    assert(r.read_varint(&buf) == 42)\n    assert(r.read_varint(&buf) == -9223372036854775808)\n    assert(r.read_varint(&buf) == 9223372036854775807)\n    assert(r.read_f64(&buf) == -3.5)\n    assert(r.read_str(&buf) == \"dunder åäö 🌍\")\n    got := r.read_bytes(&buf)\n    assert(got.len == 3 && got[0] == 0 && got[1] == 255 && got[2] == 17)\n    assert(r.finish(&buf))\n\n    _ := r.read_u8(&buf)\n    assert(!r.ok && r.error == 1)\n\n    mut encoded: []u8 = []\n    encode<[]string>(&mut encoded, &[\"alpha\", \"åäö\"])\n    encode<i32>(&mut encoded, -42)\n    mut dec := Reader::default()\n    match decode<[]string>(&mut dec, &encoded) {\n        .Ok(xs) => assert(xs == [\"alpha\", \"åäö\"]),\n        .Err(_) => assert(false),\n    }\n    assert(decode<i32>(&mut dec, &encoded) == .Ok(-42))\n    assert(dec.finish(&encoded))\n}\n" }
    ""
}

