    if name == "macos/renderer" { return "capability unsafe\nimport std.macos.objc as o\n\n@c_layout\npub struct State {\n    application: ptr, rootPool: ptr, delegateClass: ptr, mode: ptr,\n    createDevice: extern fn() -> ptr, now: extern fn() -> f64,\n    window: ptr, view: ptr, layer: ptr, delegate: ptr,\n    device: ptr, queue: ptr, pipeline: ptr, buffer: ptr,\n    generation: i64, active: i32, closed: i32, frames: i64, vertexCount: usize,\n    width: i32, height: i32, pixelWidth: i32, pixelHeight: i32,\n    scale: f64, logicalWidth: f64, logicalHeight: f64,\n    start: f64, x: f64, y: f64, down: i32, key: i32, resized: i32,\n    clear: o.Rect,\n}\n\npub unsafe fn state() -> ptr {\n    assert(size_of(State) <= 512)\n    static_bytes(\"macos\", 512)\n}\n\nunsafe fn shader_source() -> ptr {\n    o.named_string(cstr(\"#include <metal_stdlib>\\nusing namespace metal;\\nstruct Vertex { float4 position; float4 color; };\\nstruct Output { float4 position [[position]]; float4 color; };\\nvertex Output vertex_main(uint index [[vertex_id]], constant Vertex* vertices [[buffer(0)]]) { Output v; v.position = vertices[index].position; v.color = vertices[index].color; return v; }\\nfragment float4 fragment_main(Output v [[stage_in]]) { return v.color; }\"))\n}\n\npub unsafe fn setup(s: &mut State) -> bool {\n    s.device = s.createDevice()\n    if s.device == ptr(0) { return false }\n    s.queue = o.get(s.device, cstr(\"newCommandQueue\"))\n    if s.queue == ptr(0) { return false }\n    var error := ptr(0)\n    library := o.three_objects(s.device, cstr(\"newLibraryWithSource:options:error:\"), shader_source(), ptr(0), addr(&mut error))\n    if library == ptr(0) { return false }\n    vertex := o.get_object(library, cstr(\"newFunctionWithName:\"), o.named_string(cstr(\"vertex_main\")))\n    fragment := o.get_object(library, cstr(\"newFunctionWithName:\"), o.named_string(cstr(\"fragment_main\")))\n    descriptor := o.new_object(cstr(\"MTLRenderPipelineDescriptor\"))\n    if vertex != ptr(0) && fragment != ptr(0) && descriptor != ptr(0) {\n        o.set_object(descriptor, cstr(\"setVertexFunction:\"), vertex)\n        o.set_object(descriptor, cstr(\"setFragmentFunction:\"), fragment)\n        attachment := o.get_index(o.get(descriptor, cstr(\"colorAttachments\")), cstr(\"objectAtIndexedSubscript:\"), 0)\n        o.set_word(attachment, cstr(\"setPixelFormat:\"), 80)\n        o.set_flag(attachment, cstr(\"setBlendingEnabled:\"), 1)\n        o.set_word(attachment, cstr(\"setSourceRGBBlendFactor:\"), 4)\n        o.set_word(attachment, cstr(\"setDestinationRGBBlendFactor:\"), 5)\n        o.set_word(attachment, cstr(\"setSourceAlphaBlendFactor:\"), 1)\n        o.set_word(attachment, cstr(\"setDestinationAlphaBlendFactor:\"), 5)\n        s.pipeline = o.two_objects(s.device, cstr(\"newRenderPipelineStateWithDescriptor:error:\"), descriptor, addr(&mut error))\n    }\n    o.release(descriptor)\n    o.release(fragment)\n    o.release(vertex)\n    o.release(library)\n    s.pipeline != ptr(0)\n}\n\nunsafe fn present(s: &mut State) -> bool {\n    drawable := o.get(s.layer, cstr(\"nextDrawable\"))\n    if drawable == ptr(0) { return true }\n    pass := o.get(o.class_named(cstr(\"MTLRenderPassDescriptor\")), cstr(\"renderPassDescriptor\"))\n    attachment := o.get_index(o.get(pass, cstr(\"colorAttachments\")), cstr(\"objectAtIndexedSubscript:\"), 0)\n    o.set_object(attachment, cstr(\"setTexture:\"), o.get(drawable, cstr(\"texture\")))\n    o.set_word(attachment, cstr(\"setLoadAction:\"), 2)\n    o.set_word(attachment, cstr(\"setStoreAction:\"), 1)\n    o.set_rect(attachment, cstr(\"setClearColor:\"), s.clear)\n    command := o.get(s.queue, cstr(\"commandBuffer\"))\n    encoder := o.get_object(command, cstr(\"renderCommandEncoderWithDescriptor:\"), pass)\n    if encoder == ptr(0) { return false }\n    o.set_object(encoder, cstr(\"setRenderPipelineState:\"), s.pipeline)\n    o.set_word(encoder, cstr(\"setCullMode:\"), 0)\n    if s.vertexCount != 0 {\n        o.bind_buffer(encoder, cstr(\"setVertexBuffer:offset:atIndex:\"), s.buffer, 0, 0)\n        o.draw(encoder, cstr(\"drawPrimitives:vertexStart:vertexCount:\"), 3, 0, s.vertexCount)\n    }\n    o.action(encoder, cstr(\"endEncoding\"))\n    o.set_object(command, cstr(\"presentDrawable:\"), drawable)\n    o.action(command, cstr(\"commit\"))\n    o.action(command, cstr(\"waitUntilCompleted\"))\n    if o.get_word(command, cstr(\"status\")) != 4 || o.get(command, cstr(\"error\")) != ptr(0) { return false }\n    s.frames = s.frames + 1\n    true\n}\n\npub unsafe fn render(s: &mut State) -> bool {\n    if s.active == 0 || s.closed != 0 || s.pixelWidth == 0 || s.pixelHeight == 0 { return true }\n    if o.get_flag(s.window, cstr(\"isVisible\")) == 0 || o.get_flag(s.window, cstr(\"isMiniaturized\")) != 0 { return true }\n    pool := o.pool()\n    ok := present(&mut s)\n    o.drain(pool)\n    ok\n}\n\npub unsafe fn upload(s: &mut State, data: &[]f32, red: f64, green: f64, blue: f64) -> bool {\n    var next := ptr(0)\n    if data.len != 0 {\n        next = o.buffer(s.device, cstr(\"newBufferWithBytes:length:options:\"), addr(&data[0]), usize(data.len) * 4, 0)\n        if next == ptr(0) { return false }\n    }\n    o.release(s.buffer)\n    s.buffer = next\n    s.vertexCount = usize(data.len / 8)\n    s.clear = o.Rect {x: red, y: green, w: blue, h: 1.0}\n    true\n}\n" }
    if name == "map" { return "import std.hash as hashing\n\npub struct Map {\n    keys: []string,\n    values: []i64,\n    slots: []i32,\n    length: i32,\n    used: i32,\n}\npub enum Lookup { Missing, Found(i64) }\n\npub fn new() -> Map { Map { keys: [], values: [], slots: [], length: 0, used: 0 } }\npub fn length(table: &Map) -> i32 { table.length }\n\nfn locate(table: &Map, key: string) -> i32 {\n    capacity := table.slots.len\n    if capacity == 0 { return -1 }\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    for step in 0..capacity {\n        state := table.slots[slot]\n        if state == 0 { return -1 }\n        if state == 1 && table.keys[slot] == key { return slot }\n        slot = (slot + 1) % capacity\n    }\n    -1\n}\npub fn contains(table: &Map, key: string) -> bool { locate(&table, key) >= 0 }\npub fn get(table: &Map, key: string) -> Lookup {\n    slot := locate(&table, key)\n    if slot < 0 { .Missing } else { .Found(table.values[slot]) }\n}\npub fn get_or(table: &Map, key: string, fallback: i64) -> i64 {\n    slot := locate(&table, key)\n    if slot < 0 { fallback } else { table.values[slot] }\n}\nfn insert_slot(table: &mut Map, key: string, value: i64) {\n    capacity := table.slots.len\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    while table.slots[slot] == 1 { slot = (slot + 1) % capacity }\n    if table.slots[slot] == 0 { table.used = table.used + 1 }\n    table.slots[slot] = 1\n    table.keys[slot] = key\n    table.values[slot] = value\n    table.length = table.length + 1\n}\nfn rehash(table: &mut Map, capacity: i32) {\n    var fresh := new()\n    fresh.keys.reserve(capacity)\n    fresh.values.reserve(capacity)\n    fresh.slots.reserve(capacity)\n    for i in 0..capacity { fresh.keys.push(\"\"); fresh.values.push(0); fresh.slots.push(0) }\n    for i in 0..table.slots.len {\n        if table.slots[i] == 1 { insert_slot(&mut fresh, table.keys[i], table.values[i]) }\n    }\n    table = fresh\n}\npub fn reserve(table: &mut Map, entries: i32) {\n    assert(entries >= 0)\n    var capacity := 8\n    while i64(capacity) * 7 < i64(entries) * 10 { capacity = capacity * 2 }\n    if capacity > table.slots.len { rehash(&mut table, capacity) }\n}\npub fn put(table: &mut Map, key: string, value: i64) {\n    existing := locate(&table, key)\n    if existing >= 0 { table.values[existing] = value; return }\n    capacity := table.slots.len\n    if capacity == 0 { rehash(&mut table, 8) }\n    else if (table.used + 1) * 10 >= capacity * 7 {\n        if (table.length + 1) * 10 < capacity * 4 { rehash(&mut table, capacity) }\n        else { rehash(&mut table, capacity * 2) }\n    }\n    insert_slot(&mut table, key, value)\n}\npub fn remove(table: &mut Map, key: string) -> bool {\n    slot := locate(&table, key)\n    if slot < 0 { return false }\n    table.slots[slot] = 2\n    table.keys[slot] = \"\"\n    table.values[slot] = 0\n    table.length = table.length - 1\n    true\n}\npub fn clear(table: &mut Map) {\n    for i in 0..table.slots.len { table.slots[i] = 0; table.keys[i] = \"\"; table.values[i] = 0 }\n    table.length = 0\n    table.used = 0\n}\npub fn keys(table: &Map) -> []string {\n    var result: []string = []\n    result.reserve(table.length)\n    for i in 0..table.slots.len { if table.slots[i] == 1 { result.push(table.keys[i]) } }\n    result\n}\n\n@test fn map_handles_growth_collisions_updates_removal_and_copies() {\n    var collisions := new()\n    put(&mut collisions, \"a\", 1); put(&mut collisions, \"i\", 2); put(&mut collisions, \"q\", 3); put(&mut collisions, \"y\", 4)\n    remove(&mut collisions, \"a\")\n    put(&mut collisions, \"q\", 99)\n    length(&collisions) == 3\n    get_or(&collisions, \"q\", 0) == 99\n    get_or(&collisions, \"y\", 0) == 4\n    put(&mut collisions, \"\", -1); put(&mut collisions, \"\\0\", -2)\n    get_or(&collisions, \"\", 0) == -1\n    get_or(&collisions, \"\\0\", 0) == -2\n    var table := new()\n    put(&mut table, \"\", -1)\n    put(&mut table, \"å 🌍\", 42)\n    for i in 0..1000 { put(&mut table, i.str(), i64(i) * 3) }\n    length(&table) == 1002\n    for i in 0..1000 { get_or(&table, i.str(), -1) == i64(i) * 3 }\n    snapshot := table\n    put(&mut table, \"å 🌍\", 99)\n    get_or(&snapshot, \"å 🌍\", 0) == 42\n    for i in 0..1000 { remove(&mut table, i.str()) }\n    length(&table) == 2\n    !remove(&mut table, \"missing\")\n    for i in 0..1000 { put(&mut table, i.str(), i64(i)) }\n    keys(&table).len == 1002\n    match get(&table, \"å 🌍\") { .Found(value) => { value == 99 }, .Missing => { assert(false) } }\n    clear(&mut table)\n    length(&table) == 0\n    !contains(&table, \"\")\n    put(&mut table, \"again\", 7)\n    get_or(&table, \"again\", 0) == 7\n}\n" }
    if name == "parse" { return "pub struct Integer { ok: bool, value: i64, error: i32 }\n// error: 1=invalid spelling, 2=overflow. Strict ASCII decimal, optional sign.\npub fn integer(text: string) -> Integer {\n    if text.len == 0 { return Integer { ok: false, value: 0, error: 1 } }\n    var cursor := 0\n    var negative := false\n    if text[0] == 45 || text[0] == 43 { negative = text[0] == 45; cursor = 1 }\n    if cursor == text.len { return Integer { ok: false, value: 0, error: 1 } }\n    var limit: i64 = -9223372036854775807\n    if negative { limit = -9223372036854775808 }\n    var value: i64 = 0\n    var previous_digit := false\n    while cursor < text.len {\n        byte := text[cursor]\n        if byte == 95 {\n            if !previous_digit || cursor + 1 == text.len || text[cursor + 1] < 48 || text[cursor + 1] > 57 { return Integer { ok: false, value: 0, error: 1 } }\n            previous_digit = false\n        } else {\n            if byte < 48 || byte > 57 { return Integer { ok: false, value: 0, error: 1 } }\n            if value < limit / 10 { return Integer { ok: false, value: 0, error: 2 } }\n            value = value * 10\n            if value < limit + i64(byte - 48) { return Integer { ok: false, value: 0, error: 2 } }\n            value = value - i64(byte - 48)\n            previous_digit = true\n        }\n        cursor = cursor + 1\n    }\n    if !negative { value = -value }\n    Integer { ok: true, value: value, error: 0 }\n}\n@test fn decimal_parser_covers_limits_separators_and_errors() {\n    integer(\"42\").value == 42\n    integer(\"-9223372036854775808\").value == -9223372036854775808\n    integer(\"9223372036854775807\").value == 9223372036854775807\n    integer(\"42_000\").value == 42000\n    integer(\"+0\").ok\n    integer(\"9223372036854775808\").error == 2\n    integer(\"-9223372036854775809\").error == 2\n    !integer(\"1__2\").ok\n    !integer(\"1_\").ok\n    !integer(\" 2\").ok\n    !integer(\"+\").ok\n    !integer(\"\").ok\n}\n" }
    if name == "set" { return "import std.hash as hashing\n\npub struct Set { keys: []string, slots: []i32, length: i32, used: i32 }\npub fn new() -> Set { Set { keys: [], slots: [], length: 0, used: 0 } }\npub fn length(values: &Set) -> i32 { values.length }\nfn locate(values: &Set, key: string) -> i32 {\n    capacity := values.slots.len\n    if capacity == 0 { return -1 }\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    for step in 0..capacity {\n        state := values.slots[slot]\n        if state == 0 { return -1 }\n        if state == 1 && values.keys[slot] == key { return slot }\n        slot = (slot + 1) % capacity\n    }\n    -1\n}\npub fn contains(values: &Set, key: string) -> bool { locate(&values, key) >= 0 }\nfn insert_slot(values: &mut Set, key: string) {\n    capacity := values.slots.len\n    var slot := i32(hashing.hash(key) % i64(capacity))\n    while values.slots[slot] == 1 { slot = (slot + 1) % capacity }\n    if values.slots[slot] == 0 { values.used = values.used + 1 }\n    values.slots[slot] = 1\n    values.keys[slot] = key\n    values.length = values.length + 1\n}\nfn rehash(values: &mut Set, capacity: i32) {\n    var fresh := new()\n    fresh.keys.reserve(capacity)\n    fresh.slots.reserve(capacity)\n    for i in 0..capacity { fresh.keys.push(\"\"); fresh.slots.push(0) }\n    for i in 0..values.slots.len {\n        if values.slots[i] == 1 { insert_slot(&mut fresh, values.keys[i]) }\n    }\n    values = fresh\n}\npub fn reserve(values: &mut Set, entries: i32) {\n    assert(entries >= 0)\n    var capacity := 8\n    while i64(capacity) * 7 < i64(entries) * 10 { capacity = capacity * 2 }\n    if capacity > values.slots.len { rehash(&mut values, capacity) }\n}\npub fn insert(values: &mut Set, key: string) -> bool {\n    if contains(&values, key) { return false }\n    capacity := values.slots.len\n    if capacity == 0 { rehash(&mut values, 8) }\n    else if (values.used + 1) * 10 >= capacity * 7 {\n        if (values.length + 1) * 10 < capacity * 4 { rehash(&mut values, capacity) }\n        else { rehash(&mut values, capacity * 2) }\n    }\n    insert_slot(&mut values, key)\n    true\n}\npub fn remove(values: &mut Set, key: string) -> bool {\n    slot := locate(&values, key)\n    if slot < 0 { return false }\n    values.slots[slot] = 2\n    values.keys[slot] = \"\"\n    values.length = values.length - 1\n    true\n}\npub fn clear(values: &mut Set) {\n    for i in 0..values.slots.len { values.slots[i] = 0; values.keys[i] = \"\" }\n    values.length = 0\n    values.used = 0\n}\npub fn items(values: &Set) -> []string {\n    var result: []string = []\n    result.reserve(values.length)\n    for i in 0..values.slots.len { if values.slots[i] == 1 { result.push(values.keys[i]) } }\n    result\n}\n@test fn set_deduplicates_utf8_and_survives_tombstones() {\n    var collisions := new()\n    insert(&mut collisions, \"a\"); insert(&mut collisions, \"i\"); insert(&mut collisions, \"q\"); insert(&mut collisions, \"y\")\n    remove(&mut collisions, \"a\")\n    !insert(&mut collisions, \"q\")\n    contains(&collisions, \"y\")\n    length(&collisions) == 3\n    var values := new()\n    insert(&mut values, \"\")\n    insert(&mut values, \"🌍\")\n    !insert(&mut values, \"🌍\")\n    for i in 0..1000 { insert(&mut values, i.str()) }\n    length(&values) == 1002\n    copy := values\n    for i in 0..1000 { remove(&mut values, i.str()) }\n    length(&values) == 2\n    length(&copy) == 1002\n    for i in 0..1000 { insert(&mut values, i.str()) }\n    items(&values).len == 1002\n    clear(&mut values)\n    !contains(&values, \"🌍\")\n    insert(&mut values, \"after clear\")\n    length(&values) == 1\n}\n" }
    if name == "sha256" { return "import std.bytes as bytes\nfn word(value: i64) -> i64 { value.bit_and(4294967295) }\nfn rotate(value: i64, count: i32) -> i64 { word(value.shr(count).bit_or(value.shl(32 - count))) }\n// The compression input, SHA padding and digest are octets throughout.\npub fn digest_bytes(input: &[]u8) -> []u8 {\n    constants: [i64; 64] = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]\n    var state: [i64; 8] = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]\n    var data := input\n    bit_length := i64(data.len) * 8\n    data.push(128)\n    while data.len % 64 != 56 { data.push(0) }\n    for i in 0..8 { data.push(u8(bit_length.shr((7 - i) * 8).bit_and(255))) }\n    var start := 0\n    while start < data.len {\n        var w: [i64; 64] = [0; 64]\n        for i in 0..16 {\n            offset := start + i * 4\n            w[i] = i64(data[offset]) * 16777216 + i64(data[offset + 1]) * 65536 + i64(data[offset + 2]) * 256 + i64(data[offset + 3])\n        }\n        for i in 16..64 {\n            a := w[i - 15]\n            b := w[i - 2]\n            s0 := rotate(a, 7).bit_xor(rotate(a, 18)).bit_xor(a.shr(3))\n            s1 := rotate(b, 17).bit_xor(rotate(b, 19)).bit_xor(b.shr(10))\n            w[i] = word(w[i - 16] + s0 + w[i - 7] + s1)\n        }\n        var a := state[0]; var b := state[1]; var c := state[2]; var d := state[3]\n        var e := state[4]; var f := state[5]; var g := state[6]; var h := state[7]\n        for i in 0..64 {\n            s1 := rotate(e, 6).bit_xor(rotate(e, 11)).bit_xor(rotate(e, 25))\n            choose := e.bit_and(f).bit_xor(e.bit_not().bit_and(g))\n            first := h + s1 + choose + constants[i] + w[i]\n            s0 := rotate(a, 2).bit_xor(rotate(a, 13)).bit_xor(rotate(a, 22))\n            majority := a.bit_and(b).bit_xor(a.bit_and(c)).bit_xor(b.bit_and(c))\n            second := s0 + majority\n            h = g; g = f; f = e; e = word(d + first)\n            d = c; c = b; b = a; a = word(first + second)\n        }\n        state[0] = word(state[0] + a); state[1] = word(state[1] + b)\n        state[2] = word(state[2] + c); state[3] = word(state[3] + d)\n        state[4] = word(state[4] + e); state[5] = word(state[5] + f)\n        state[6] = word(state[6] + g); state[7] = word(state[7] + h)\n        start = start + 64\n    }\n    var result: []u8 = []\n    result.reserve(32)\n    for value in state { for i in 0..4 { result.push(u8(value.shr((3 - i) * 8).bit_and(255))) } }\n    result\n}\nfn widen(input: &[]u8) -> []i32 {\n    var result: []i32 = []\n    result.reserve(input.len)\n    for byte in input { result.push(i32(byte)) }\n    result\n}\npub fn digest(input: &[]i32) -> []i32 {\n    var packed: []u8 = []\n    packed.reserve(input.len)\n    for byte in input {\n        assert(byte >= 0 && byte <= 255)\n        packed.push(u8(byte))\n    }\n    digest := digest_bytes(&packed)\n    widen(&digest)\n}\npub fn text(input: string) -> []i32 {\n    var packed: []u8 = []\n    bytes.append_utf8(&mut packed, input)\n    digest := digest_bytes(&packed)\n    widen(&digest)\n}\n@test fn sha256_matches_empty_abc_and_multi_block_reference_vectors() {\n    empty := text(\"\")\n    bytes.hex(&empty) == \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n    abc := text(\"abc\")\n    bytes.hex(&abc) == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n    long := text(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")\n    bytes.hex(&long) == \"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1\"\n}\n" }
    if name == "sys" { return "// macOS/Linux filesystem API. error is zero on success, otherwise a Dunder code.\n// Known Linux errno values map to the original Darwin-compatible codes below.\n// Unmapped Linux errno values use 10000 + errno; see docs/sys.md.\npub struct Status { ok: bool, error: i32 }\npub struct TextResult { ok: bool, value: string, error: i32 }\npub struct Metadata { ok: bool, size: i64, is_file: bool, is_dir: bool, error: i32 }\n\npub fn read_text(path: string) -> TextResult { __sys_read_text(path) }\npub fn write_text(path: string, text: string) -> Status { __sys_write_text(path, text) }\npub fn write_stderr(text: string) -> Status { __sys_write_stderr(text) }\npub fn eprint(text: string) -> Status { write_stderr(text + \"\\n\") }\npub fn append_text(path: string, text: string) -> Status { __sys_append_text(path, text) }\npub fn mkdir(path: string) -> Status { __sys_mkdir(path) }\npub fn rename(from: string, to: string) -> Status { __sys_rename(from, to) }\npub fn remove_file(path: string) -> Status { __sys_remove_file(path) }\npub fn remove_dir(path: string) -> Status { __sys_remove_dir(path) }\npub fn metadata(path: string) -> Metadata { __sys_metadata(path) }\npub fn pid() -> i32 { __sys_pid() }\npub fn arg_count() -> i32 { __sys_arg_count() }\npub fn arg(index: i32) -> string { __sys_arg(index) }\npub fn write_bytes(path: string, bytes: &[]i32) -> Status { __sys_write_bytes(path, &bytes) }\npub fn make_executable(path: string) -> Status { __sys_make_executable(path) }\npub fn write_u8(path: string, bytes: &[]u8) -> Status { __sys_write_u8(path, &bytes) }\npub fn decode_u8(bytes: &[]u8) -> TextResult { __sys_decode_u8(&bytes) }\npub fn decode_utf8(bytes: &[]i32) -> TextResult { __sys_decode_utf8(&bytes) }\npub fn same_file(first: string, second: string) -> bool { __sys_same_file(first, second) }\n\n@test {\n    (0) -> \"ok\"\n    (2) -> \"no such file or directory\"\n    (92) -> \"invalid UTF-8\"\n    (12345) -> \"OS error 12345\"\n}\npub fn error_message(error: i32) -> string {\n    if error == 0 { return \"ok\" }\n    if error == 2 { return \"no such file or directory\" }\n    if error == 5 { return \"I/O error\" }\n    if error == 12 { return \"out of memory\" }\n    if error == 13 { return \"permission denied\" }\n    if error == 17 { return \"already exists\" }\n    if error == 20 { return \"not a directory\" }\n    if error == 21 { return \"is a directory\" }\n    if error == 22 { return \"invalid argument\" }\n    if error == 27 { return \"file too large\" }\n    if error == 35 { return \"temporarily unavailable\" }\n    if error == 45 { return \"not supported\" }\n    if error == 63 { return \"path too long\" }\n    if error == 66 { return \"directory not empty\" }\n    if error == 92 { return \"invalid UTF-8\" }\n    \"OS error \" + error.str()\n}\n\npub enum FileKind { Other = 0, File = 1, Directory = 2 }\npub enum IoError {\n    Other(i32) = 0,\n    NotFound = 2,\n    OutOfMemory = 12,\n    PermissionDenied = 13,\n    AlreadyExists = 17,\n    NotDirectory = 20,\n    IsDirectory = 21,\n    InvalidArgument = 22,\n    TooLarge = 27,\n    Changed = 35,\n    Unsupported = 45,\n    NameTooLong = 63,\n    NotEmpty = 66,\n    InvalidUtf8 = 92,\n}\npub enum ReadResult { Ok(string), Err(IoError) }\n\npub fn read(path: string) -> ReadResult {\n    result := read_text(path)\n    if result.ok { .Ok(result.value) }\n    else { .Err(error_from_code(result.error)) }\n}\n\npub fn file_kind(info: Metadata) -> FileKind {\n    if info.is_file { .File }\n    else if info.is_dir { .Directory }\n    else { .Other }\n}\n\npub fn error_from_code(error: i32) -> IoError {\n    if error == 2 { return .NotFound }\n    if error == 12 { return .OutOfMemory }\n    if error == 13 { return .PermissionDenied }\n    if error == 17 { return .AlreadyExists }\n    if error == 20 { return .NotDirectory }\n    if error == 21 { return .IsDirectory }\n    if error == 22 { return .InvalidArgument }\n    if error == 27 { return .TooLarge }\n    if error == 35 { return .Changed }\n    if error == 45 { return .Unsupported }\n    if error == 63 { return .NameTooLong }\n    if error == 66 { return .NotEmpty }\n    if error == 92 { return .InvalidUtf8 }\n    .Other(error)\n}\n\n@test {\n    (.NotFound) -> 2\n    (.InvalidUtf8) -> 92\n    (.Other(12345)) -> 12345\n    error_code(error_from_code(63)) == 63\n    error_code(error_from_code(54321)) == 54321\n}\npub fn error_code(error: IoError) -> i32 {\n    match error {\n        .NotFound => 2,\n        .OutOfMemory => 12,\n        .PermissionDenied => 13,\n        .AlreadyExists => 17,\n        .NotDirectory => 20,\n        .IsDirectory => 21,\n        .InvalidArgument => 22,\n        .TooLarge => 27,\n        .Changed => 35,\n        .Unsupported => 45,\n        .NameTooLong => 63,\n        .NotEmpty => 66,\n        .InvalidUtf8 => 92,\n        .Other(code) => code,\n    }\n}\n\npub fn io_error_message(error: IoError) -> string { error_message(error_code(error)) }\n" }
    if name == "text" { return "pub fn starts_with(text: string, prefix: string) -> bool {\n    if prefix.len > text.len { return false }\n    for i in 0..prefix.len { if text[i] != prefix[i] { return false } }\n    true\n}\npub fn ends_with(text: string, suffix: string) -> bool {\n    if suffix.len > text.len { return false }\n    start := text.len - suffix.len\n    for i in 0..suffix.len { if text[start + i] != suffix[i] { return false } }\n    true\n}\npub fn find(text: string, needle: string) -> i32 {\n    if needle.len == 0 { return 0 }\n    var start := 0\n    while start + needle.len <= text.len {\n        var i := 0\n        while i < needle.len && text[start + i] == needle[i] { i = i + 1 }\n        if i == needle.len { return start }\n        start = start + 1\n    }\n    -1\n}\npub fn split(text: string, separator: string) -> []string {\n    var parts: []string = []\n    if separator.len == 0 { parts.push(text); return parts }\n    var start := 0\n    var cursor := 0\n    while cursor + separator.len <= text.len {\n        var i := 0\n        while i < separator.len && text[cursor + i] == separator[i] { i = i + 1 }\n        if i == separator.len {\n            parts.push(text[start..cursor])\n            cursor = cursor + separator.len\n            start = cursor\n        } else { cursor = cursor + 1 }\n    }\n    if start == 0 { parts.push(text) }\n    else if start == text.len { parts.push(\"\") }\n    else { parts.push(text[start..text.len]) }\n    parts\n}\nfn whitespace(byte: i32) -> bool { byte == 32 || byte == 9 || byte == 10 || byte == 13 }\npub fn trim(text: string) -> string {\n    var start := 0\n    var end := text.len\n    while start < end && whitespace(text[start]) { start = start + 1 }\n    while end > start && whitespace(text[end - 1]) { end = end - 1 }\n    if start == 0 && end == text.len { return text }\n    if start == end { return \"\" }\n    text[start..end]\n}\n@test fn text_search_and_split_handle_utf8_and_empty_parts() {\n    starts_with(\"åäö 🌍\", \"å\")\n    ends_with(\"åäö 🌍\", \"🌍\")\n    find(\"åäö 🌍\", \"🌍\") == 7\n    find(\"åäö 🌍\", \"missing\") == -1\n    parts := split(\"å::🌍::::\", \"::\")\n    parts.len == 4\n    parts[0] == \"å\"\n    parts[1] == \"🌍\"\n    parts[2] == \"\"\n    parts[3] == \"\"\n    trim(\" \\t å 🌍 \\r\\n\") == \"å 🌍\"\n    split(\"\", \"\").len == 1\n}\n" }
    if name == "vulkan" { return "capability unsafe\n\nimport sys\nimport std.dl as dl\nimport std.vulkan.api as api\nimport std.vulkan.device as device\nimport std.vulkan.pipeline as pipeline\nimport std.vulkan.sdl as sdl\nimport std.vulkan.state as state\n\n// Native Linux Vulkan triangle-list rendering, with optional window presentation.\n// Window is a validated resource ID. Copies refer to the same native window.\npub struct Window { id: i64 }\npub struct OpenResult { ok: bool, window: Window, error: string }\npub struct Frame {\n    closed: bool,\n    width: i32,\n    height: i32,\n    pixel_width: i32,\n    pixel_height: i32,\n    scale: f64,\n    time: f64,\n    pointer_x: f64,\n    pointer_y: f64,\n    pointer_down: bool,\n    key: i32,\n    resized: bool,\n}\npub struct DrawResult { ok: bool, error: string, frames: i64 }\n\n// The image owns these two writable words for the lifetime of the process.\n// Public Window values only ever contain a generation, never a raw pointer.\n@c_layout\nstruct Registry { active: ptr, generation: i64 }\n\nunsafe fn registry_address() -> ptr { static_bytes(\"linux\", 16) }\n\n@extern(\"c\", \"calloc\")\nunsafe fn allocate(count: usize, bytes: usize) -> ptr\n@extern(\"c\", \"free\")\nunsafe fn release(address: ptr)\n@extern(\"c\", \"memcpy\")\nunsafe fn copy_bytes(destination: ptr, source: ptr, bytes: usize) -> ptr\n@extern(\"c\", \"clock_gettime\")\nunsafe fn clock_gettime(clock: i32, output: ptr) -> i32\n\nunsafe fn millis() -> i64 {\n    var t: [i64; 2] = [0, 0]\n    if clock_gettime(1, addr(&mut t[0])) != 0 { return 0 }\n    t[0] * 1000 + t[1] / 1000000\n}\n\nfn open_error(message: string) -> OpenResult {\n    OpenResult { ok: false, window: Window {id: 0}, error: message }\n}\n\nunsafe fn initialize(r: &mut state.Renderer, title: string, width: i32, height: i32, headless: bool) -> bool {\n    r.width = width\n    r.height = height\n    r.firstPoll = 1\n    r.window.key = -1\n    r.window.width = width\n    r.window.height = height\n    if !device.setup(&mut r) || !pipeline.setup(&mut r) { return false }\n    if !headless && !sdl.open(&mut r.window, title, width, height) { return false }\n    r.startMillis = millis()\n    true\n}\n\nunsafe fn dispose(address: ptr, r: &mut state.Renderer) {\n    device.destroy(&mut r)\n    sdl.close(&mut r.window)\n    if r.loader != ptr(0) { closed := dl.close(r.loader) }\n    release(address)\n}\n\nunsafe fn open_renderer(registry: &mut Registry, title: string, width: i32, height: i32, headless: bool) -> OpenResult {\n    if width < 1 || width > 4096 || height < 1 || height > 4096 {\n        return open_error(\"Vulkan dimensions must be between 1 and 4096\")\n    }\n    if registry.active != ptr(0) { return open_error(\"a Vulkan renderer is already open\") }\n    address := allocate(1, size_of(state.Renderer))\n    if address == ptr(0) { return open_error(\"could not allocate Vulkan state\") }\n    loader := dl.open(cstr(\"libvulkan.so.1\"), 2)\n    if loader == ptr(0) {\n        release(address)\n        return open_error(\"Vulkan loader is unavailable\")\n    }\n    if !load_api(ref_at(address), loader) {\n        closed := dl.close(loader)\n        release(address)\n        return open_error(\"Vulkan loader is missing required entry points\")\n    }\n    if !initialize(ref_at(address), title, width, height, headless) {\n        dispose(address, ref_at(address))\n        return open_error(\"Vulkan or SDL initialization failed\")\n    }\n    registry.generation = registry.generation + 1\n    registry.active = address\n    OpenResult {ok: true, window: Window {id: registry.generation}, error: \"\"}\n}\n\nunsafe fn load_api(r: &mut state.Renderer, library: ptr) -> bool {\n    r.loader = library\n    api.load(&mut r.api, library)\n}\n\npub fn open(title: string, width: i32, height: i32) -> OpenResult {\n    unsafe { return open_renderer(ref_at(registry_address()), title, width, height, false) }\n}\npub fn open_headless(width: i32, height: i32) -> OpenResult {\n    unsafe { return open_renderer(ref_at(registry_address()), \"\", width, height, true) }\n}\n\nunsafe fn active(registry: &Registry, window: Window) -> ptr {\n    if registry.generation != window.id { return ptr(0) }\n    registry.active\n}\n\nunsafe fn name(r: &state.Renderer) -> string {\n    var bytes: []i32 = []\n    for i in 0..256 {\n        byte := r.properties.deviceName[i]\n        if byte == 0 { break }\n        bytes.push(i32(byte))\n    }\n    sys.decode_utf8(&bytes).value\n}\npub fn device_name(window: Window) -> string {\n    unsafe {\n        address := active(ref_at(registry_address()), window)\n        if address == ptr(0) { return \"\" }\n        return name(ref_at(address))\n    }\n}\n\nunsafe fn snapshot(r: &state.Renderer) -> []i32 {\n    var result: []i32 = []\n    if r.frames > 0 {\n        count := r.width * r.height * 4\n        result.reserve(count)\n        for i in 0..count { result.push(i32(load_u8(ptr(usize(r.readback.mapped) + usize(i))))) }\n    }\n    result\n}\npub fn pixels(window: Window) -> []i32 {\n    unsafe {\n        address := active(ref_at(registry_address()), window)\n        if address == ptr(0) { return [] }\n        return snapshot(ref_at(address))\n    }\n}\n\nunsafe fn next_frame(r: &mut state.Renderer) -> Frame {\n    if r.window.handle != ptr(0) { sdl.poll(&mut r.window) }\n    resized := r.firstPoll != 0 || r.window.resized != 0\n    r.firstPoll = 0\n    Frame {closed: r.window.closed != 0, width: r.window.width, height: r.window.height,\n        pixel_width: r.width, pixel_height: r.height, scale: 1.0, time: f64(millis() - r.startMillis) / 1000.0,\n        pointer_x: f64(r.window.x), pointer_y: f64(r.window.y), pointer_down: r.window.down != 0,\n        key: r.window.key, resized: resized}\n}\npub fn poll(window: Window) -> Frame {\n    unsafe {\n        address := active(ref_at(registry_address()), window)\n        if address == ptr(0) {\n            return Frame {closed: true, width: 0, height: 0, pixel_width: 0, pixel_height: 0, scale: 0.0,\n                time: 0.0, pointer_x: 0.0, pointer_y: 0.0, pointer_down: false, key: -1, resized: false}\n        }\n        return next_frame(ref_at(address))\n    }\n}\n\nfn draw_error(frames: i64, message: string) -> DrawResult {\n    DrawResult {ok: false, error: message, frames: frames}\n}\nunsafe fn submit(r: &mut state.Renderer, vertices: &[]f32, red: f64, green: f64, blue: f64) -> DrawResult {\n    if r.window.closed != 0 { return draw_error(r.frames, \"Vulkan window is closed\") }\n    if vertices.len > 800000 || vertices.len % 24 != 0 || !red.is_finite() || !green.is_finite() || !blue.is_finite() {\n        return draw_error(r.frames, \"expected a finite triangle list (max 100000 vertices) and finite clear colors\")\n    }\n    for i in 0..vertices.len {\n        if !vertices[i].is_finite() { return draw_error(r.frames, \"non-finite Vulkan vertex\") }\n    }\n    if vertices.len > 0 { copied := copy_bytes(r.vertex.mapped, addr(&vertices[0]), usize(vertices.len * 4)) }\n    if !pipeline.render(&r, u32(vertices.len / 8), f32(red), f32(green), f32(blue)) {\n        return draw_error(r.frames, \"Vulkan rendering failed\")\n    }\n    if r.window.handle != ptr(0) && !sdl.present(&r.window, r.readback.mapped, r.width, r.height) {\n        return draw_error(r.frames, \"window presentation failed\")\n    }\n    r.frames = r.frames + 1\n    DrawResult {ok: true, error: \"\", frames: r.frames}\n}\npub fn draw(window: Window, vertices: &[]f32, red: f64, green: f64, blue: f64) -> DrawResult {\n    unsafe {\n        address := active(ref_at(registry_address()), window)\n        if address == ptr(0) { return draw_error(0, \"invalid or expired Vulkan handle\") }\n        return submit(ref_at(address), &vertices, red, green, blue)\n    }\n}\n\nunsafe fn close_window(registry: &mut Registry, window: Window) {\n    address := active(&registry, window)\n    if address != ptr(0) {\n        registry.active = ptr(0)\n        dispose(address, ref_at(address))\n    }\n}\npub fn close(window: Window) { unsafe { close_window(ref_at(registry_address()), window) } }\n\n// Geometry is ordinary Dunder. Positions are clip coordinates: +Y up.\n// Each vertex is [x, y, 0, 1, red, green, blue, alpha]. Colors use straight alpha.\npub struct Point { x: f32, y: f32 }\npub struct Color { red: f32, green: f32, blue: f32, alpha: f32 }\n\npub fn rgb(red: f32, green: f32, blue: f32) -> Color {\n    Color { red: red, green: green, blue: blue, alpha: 1.0 }\n}\npub fn rgba(red: f32, green: f32, blue: f32, alpha: f32) -> Color {\n    Color { red: red, green: green, blue: blue, alpha: alpha }\n}\npub fn vertex(vertices: &mut []f32, point: Point, color: Color) {\n    vertices.push(point.x)\n    vertices.push(point.y)\n    vertices.push(0.0)\n    vertices.push(1.0)\n    vertices.push(color.red)\n    vertices.push(color.green)\n    vertices.push(color.blue)\n    vertices.push(color.alpha)\n}\npub fn triangle(vertices: &mut []f32, a: Point, b: Point, c: Point, color: Color) {\n    vertex(&mut vertices, a, color)\n    vertex(&mut vertices, b, color)\n    vertex(&mut vertices, c, color)\n}\npub fn gradient_triangle(vertices: &mut []f32, a: Point, b: Point, c: Point, ca: Color, cb: Color, cc: Color) {\n    vertex(&mut vertices, a, ca)\n    vertex(&mut vertices, b, cb)\n    vertex(&mut vertices, c, cc)\n}\n\n// x/y is the lower-left corner; width/height are clip-coordinate extents.\npub fn quad(vertices: &mut []f32, x: f32, y: f32, width: f32, height: f32, color: Color) {\n    a := Point { x: x, y: y }\n    b := Point { x: x + width, y: y }\n    c := Point { x: x + width, y: y + height }\n    d := Point { x: x, y: y + height }\n    triangle(&mut vertices, a, b, c, color)\n    triangle(&mut vertices, a, c, d, color)\n}\n\n@test fn geometry_emits_interleaved_triangle_lists() {\n    var vertices: []f32 = []\n    a := Point { x: -0.5, y: -0.5 }\n    b := Point { x: 0.5, y: -0.5 }\n    c := Point { x: 0.0, y: 0.5 }\n    gradient_triangle(&mut vertices, a, b, c, rgb(1.0, 0.0, 0.0), rgb(0.0, 1.0, 0.0), rgba(0.0, 0.0, 1.0, 0.5))\n    vertices.len == 24\n    vertices[0] == -0.5\n    vertices[2] == 0.0\n    vertices[3] == 1.0\n    vertices[4] == 1.0\n    vertices[8] == 0.5\n    vertices[13] == 1.0\n    vertices[17] == 0.5\n    vertices[22] == 1.0\n    vertices[23] == 0.5\n    vertices.clear()\n    quad(&mut vertices, -1.0, -1.0, 2.0, 2.0, rgb(0.2, 0.3, 0.4))\n    vertices.len == 48\n    vertices[0] == -1.0\n    vertices[9] == -1.0\n    vertices[16] == 1.0\n    vertices[17] == 1.0\n    vertices[40] == -1.0\n    vertices[41] == 1.0\n}\n" }
    if name == "vulkan/api" { return "capability unsafe\n\nimport std.dl as dl\n\n// Vulkan 1.0 loader entry points, resolved once before the first driver call.\n@c_layout\npub struct Api {\n    CreateInstance: extern fn(ptr, ptr, ptr) -> i32,\n    EnumeratePhysicalDevices: extern fn(ptr, ptr, ptr) -> i32,\n    GetPhysicalDeviceProperties: extern fn(ptr, ptr),\n    GetPhysicalDeviceQueueFamilyProperties: extern fn(ptr, ptr, ptr),\n    GetPhysicalDeviceMemoryProperties: extern fn(ptr, ptr),\n    CreateDevice: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    GetDeviceQueue: extern fn(ptr, u32, u32, ptr),\n    CreateCommandPool: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    AllocateCommandBuffers: extern fn(ptr, ptr, ptr) -> i32,\n    CreateImage: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    GetImageMemoryRequirements: extern fn(ptr, ptr, ptr),\n    AllocateMemory: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    BindImageMemory: extern fn(ptr, ptr, ptr, u64) -> i32,\n    CreateImageView: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    CreateRenderPass: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    CreateFramebuffer: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    CreateShaderModule: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    CreatePipelineLayout: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    CreateGraphicsPipelines: extern fn(ptr, ptr, u32, ptr, ptr, ptr) -> i32,\n    CreateBuffer: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    GetBufferMemoryRequirements: extern fn(ptr, ptr, ptr),\n    BindBufferMemory: extern fn(ptr, ptr, ptr, u64) -> i32,\n    MapMemory: extern fn(ptr, ptr, u64, u64, u32, ptr) -> i32,\n    ResetCommandBuffer: extern fn(ptr, u32) -> i32,\n    BeginCommandBuffer: extern fn(ptr, ptr) -> i32,\n    CmdBeginRenderPass: extern fn(ptr, ptr, u32),\n    CmdBindPipeline: extern fn(ptr, u32, ptr),\n    CmdBindVertexBuffers: extern fn(ptr, u32, u32, ptr, ptr),\n    CmdDraw: extern fn(ptr, u32, u32, u32, u32),\n    CmdEndRenderPass: extern fn(ptr),\n    CmdCopyImageToBuffer: extern fn(ptr, ptr, u32, ptr, u32, ptr),\n    EndCommandBuffer: extern fn(ptr) -> i32,\n    QueueSubmit: extern fn(ptr, u32, ptr, ptr) -> i32,\n    QueueWaitIdle: extern fn(ptr) -> i32,\n    DeviceWaitIdle: extern fn(ptr) -> i32,\n    DestroyBuffer: extern fn(ptr, ptr, ptr),\n    FreeMemory: extern fn(ptr, ptr, ptr),\n    DestroyFramebuffer: extern fn(ptr, ptr, ptr),\n    DestroyPipeline: extern fn(ptr, ptr, ptr),\n    DestroyPipelineLayout: extern fn(ptr, ptr, ptr),\n    DestroyShaderModule: extern fn(ptr, ptr, ptr),\n    DestroyRenderPass: extern fn(ptr, ptr, ptr),\n    DestroyImageView: extern fn(ptr, ptr, ptr),\n    DestroyImage: extern fn(ptr, ptr, ptr),\n    DestroyCommandPool: extern fn(ptr, ptr, ptr),\n    DestroyDevice: extern fn(ptr, ptr),\n    DestroyInstance: extern fn(ptr, ptr),\n    UnmapMemory: extern fn(ptr, ptr),\n    CmdPipelineBarrier: extern fn(ptr, u32, u32, u32, u32, ptr, u32, ptr, u32, ptr),\n}\n\npub unsafe fn load(api: &mut Api, library: ptr) -> bool {\n    var symbol := ptr(0)\n    symbol = dl.symbol(library, cstr(\"vkCreateInstance\"))\n    if symbol == ptr(0) { return false }\n    api.CreateInstance = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkEnumeratePhysicalDevices\"))\n    if symbol == ptr(0) { return false }\n    api.EnumeratePhysicalDevices = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkGetPhysicalDeviceProperties\"))\n    if symbol == ptr(0) { return false }\n    api.GetPhysicalDeviceProperties = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkGetPhysicalDeviceQueueFamilyProperties\"))\n    if symbol == ptr(0) { return false }\n    api.GetPhysicalDeviceQueueFamilyProperties = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkGetPhysicalDeviceMemoryProperties\"))\n    if symbol == ptr(0) { return false }\n    api.GetPhysicalDeviceMemoryProperties = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateDevice\"))\n    if symbol == ptr(0) { return false }\n    api.CreateDevice = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkGetDeviceQueue\"))\n    if symbol == ptr(0) { return false }\n    api.GetDeviceQueue = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateCommandPool\"))\n    if symbol == ptr(0) { return false }\n    api.CreateCommandPool = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkAllocateCommandBuffers\"))\n    if symbol == ptr(0) { return false }\n    api.AllocateCommandBuffers = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateImage\"))\n    if symbol == ptr(0) { return false }\n    api.CreateImage = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkGetImageMemoryRequirements\"))\n    if symbol == ptr(0) { return false }\n    api.GetImageMemoryRequirements = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkAllocateMemory\"))\n    if symbol == ptr(0) { return false }\n    api.AllocateMemory = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkBindImageMemory\"))\n    if symbol == ptr(0) { return false }\n    api.BindImageMemory = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateImageView\"))\n    if symbol == ptr(0) { return false }\n    api.CreateImageView = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateRenderPass\"))\n    if symbol == ptr(0) { return false }\n    api.CreateRenderPass = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateFramebuffer\"))\n    if symbol == ptr(0) { return false }\n    api.CreateFramebuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateShaderModule\"))\n    if symbol == ptr(0) { return false }\n    api.CreateShaderModule = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreatePipelineLayout\"))\n    if symbol == ptr(0) { return false }\n    api.CreatePipelineLayout = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateGraphicsPipelines\"))\n    if symbol == ptr(0) { return false }\n    api.CreateGraphicsPipelines = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCreateBuffer\"))\n    if symbol == ptr(0) { return false }\n    api.CreateBuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkGetBufferMemoryRequirements\"))\n    if symbol == ptr(0) { return false }\n    api.GetBufferMemoryRequirements = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkBindBufferMemory\"))\n    if symbol == ptr(0) { return false }\n    api.BindBufferMemory = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkMapMemory\"))\n    if symbol == ptr(0) { return false }\n    api.MapMemory = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkResetCommandBuffer\"))\n    if symbol == ptr(0) { return false }\n    api.ResetCommandBuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkBeginCommandBuffer\"))\n    if symbol == ptr(0) { return false }\n    api.BeginCommandBuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCmdBeginRenderPass\"))\n    if symbol == ptr(0) { return false }\n    api.CmdBeginRenderPass = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCmdBindPipeline\"))\n    if symbol == ptr(0) { return false }\n    api.CmdBindPipeline = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCmdBindVertexBuffers\"))\n    if symbol == ptr(0) { return false }\n    api.CmdBindVertexBuffers = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCmdDraw\"))\n    if symbol == ptr(0) { return false }\n    api.CmdDraw = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCmdEndRenderPass\"))\n    if symbol == ptr(0) { return false }\n    api.CmdEndRenderPass = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCmdCopyImageToBuffer\"))\n    if symbol == ptr(0) { return false }\n    api.CmdCopyImageToBuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkEndCommandBuffer\"))\n    if symbol == ptr(0) { return false }\n    api.EndCommandBuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkQueueSubmit\"))\n    if symbol == ptr(0) { return false }\n    api.QueueSubmit = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkQueueWaitIdle\"))\n    if symbol == ptr(0) { return false }\n    api.QueueWaitIdle = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDeviceWaitIdle\"))\n    if symbol == ptr(0) { return false }\n    api.DeviceWaitIdle = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyBuffer\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyBuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkFreeMemory\"))\n    if symbol == ptr(0) { return false }\n    api.FreeMemory = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyFramebuffer\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyFramebuffer = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyPipeline\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyPipeline = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyPipelineLayout\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyPipelineLayout = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyShaderModule\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyShaderModule = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyRenderPass\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyRenderPass = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyImageView\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyImageView = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyImage\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyImage = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyCommandPool\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyCommandPool = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyDevice\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyDevice = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkDestroyInstance\"))\n    if symbol == ptr(0) { return false }\n    api.DestroyInstance = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkUnmapMemory\"))\n    if symbol == ptr(0) { return false }\n    api.UnmapMemory = ffi_fn(symbol)\n    symbol = dl.symbol(library, cstr(\"vkCmdPipelineBarrier\"))\n    if symbol == ptr(0) { return false }\n    api.CmdPipelineBarrier = ffi_fn(symbol)\n    true\n}\n" }
    if name == "vulkan/device" { return "capability unsafe\n\nimport std.vulkan.layout as vk\nimport std.vulkan.state as state\n\nunsafe fn create_device(r: &mut state.Renderer) -> bool {\n    var app: vk.ApplicationInfo = zeroed()\n    app.apiVersion = 4194304\n    var instance: vk.InstanceCreateInfo = zeroed()\n    instance.sType = 1\n    instance.pApplicationInfo = addr(&app)\n    if r.api.CreateInstance(addr(&instance), ptr(0), addr(&mut r.instance)) != 0 { return false }\n\n    // The first available device is sufficient. VK_INCOMPLETE is expected\n    // when another device exists after the first one.\n    var count: u32 = 1\n    status := r.api.EnumeratePhysicalDevices(r.instance, addr(&mut count), addr(&mut r.physical))\n    if (status != 0 && status != 5) || count == 0 { return false }\n    r.api.GetPhysicalDeviceProperties(r.physical, addr(&mut r.properties))\n    r.api.GetPhysicalDeviceMemoryProperties(r.physical, addr(&mut r.memoryProperties))\n    // QueueFamilyProperties contains six u32 words, with flags and count first.\n    var families: [u32; 192] = [0; 192]\n    count = 32\n    r.api.GetPhysicalDeviceQueueFamilyProperties(r.physical, addr(&mut count), addr(&mut families[0]))\n    var family := 0\n    while family < i32(count) {\n        if i32(families[family * 6]).bit_and(1) != 0 && families[family * 6 + 1] > 0 { break }\n        family = family + 1\n    }\n    if family == i32(count) { return false }\n    r.family = u32(family)\n    priority: f32 = 1.0\n    var q: vk.DeviceQueueCreateInfo = zeroed()\n    q.sType = 2\n    q.queueFamilyIndex = r.family\n    q.queueCount = 1\n    q.pQueuePriorities = addr(&priority)\n    var device: vk.DeviceCreateInfo = zeroed()\n    device.sType = 3\n    device.queueCreateInfoCount = 1\n    device.pQueueCreateInfos = addr(&q)\n    if r.api.CreateDevice(r.physical, addr(&device), ptr(0), addr(&mut r.device)) != 0 { return false }\n    r.api.GetDeviceQueue(r.device, r.family, 0, addr(&mut r.queue))\n    var pool: vk.CommandPoolCreateInfo = zeroed()\n    pool.sType = 39\n    pool.flags = 2\n    pool.queueFamilyIndex = r.family\n    if r.api.CreateCommandPool(r.device, addr(&pool), ptr(0), addr(&mut r.pool)) != 0 { return false }\n    var command: vk.CommandBufferAllocateInfo = zeroed()\n    command.sType = 40\n    command.commandPool = r.pool\n    command.commandBufferCount = 1\n    r.api.AllocateCommandBuffers(r.device, addr(&command), addr(&mut r.command)) == 0\n}\n\nunsafe fn allocate(r: &state.Renderer, requirements: &vk.MemoryRequirements, flags: i32, output: ptr) -> bool {\n    var i := 0\n    while i < i32(r.memoryProperties.typeCount) {\n        bits := i32(requirements.memoryTypeBits)\n        if bits.bit_and(i32(1).shl(i)) != 0 && i32(r.memoryProperties.types[i * 2]).bit_and(flags) == flags {\n            var alloc: vk.MemoryAllocateInfo = zeroed()\n            alloc.sType = 5\n            alloc.allocationSize = requirements.size\n            alloc.memoryTypeIndex = u32(i)\n            return r.api.AllocateMemory(r.device, addr(&alloc), ptr(0), output) == 0\n        }\n        i = i + 1\n    }\n    false\n}\n\nunsafe fn buffer(r: &state.Renderer, b: &mut state.Buffer, size: u64, usage: u32) -> bool {\n    var info: vk.BufferCreateInfo = zeroed()\n    info.sType = 12\n    info.size = size\n    info.usage = usage\n    if r.api.CreateBuffer(r.device, addr(&info), ptr(0), addr(&mut b.handle)) != 0 { return false }\n    var requirements: vk.MemoryRequirements = zeroed()\n    r.api.GetBufferMemoryRequirements(r.device, b.handle, addr(&mut requirements))\n    if !allocate(&r, &requirements, 6, addr(&mut b.memory)) { return false }\n    if r.api.BindBufferMemory(r.device, b.handle, b.memory, 0) != 0 { return false }\n    r.api.MapMemory(r.device, b.memory, 0, size, 0, addr(&mut b.mapped)) == 0\n}\n\npub unsafe fn setup(r: &mut state.Renderer) -> bool {\n    if !create_device(&mut r) { return false }\n    var image: vk.ImageCreateInfo = zeroed()\n    image.sType = 14\n    image.imageType = 1\n    image.format = 37\n    image.extent = vk.Extent3D {width: u32(r.width), height: u32(r.height), depth: 1}\n    image.mipLevels = 1\n    image.arrayLayers = 1\n    image.samples = 1\n    image.usage = 17\n    if r.api.CreateImage(r.device, addr(&image), ptr(0), addr(&mut r.image)) != 0 { return false }\n    var requirements: vk.MemoryRequirements = zeroed()\n    r.api.GetImageMemoryRequirements(r.device, r.image, addr(&mut requirements))\n    if !allocate(&r, &requirements, 0, addr(&mut r.imageMemory)) { return false }\n    if r.api.BindImageMemory(r.device, r.image, r.imageMemory, 0) != 0 { return false }\n    var view: vk.ImageViewCreateInfo = zeroed()\n    view.sType = 15\n    view.image = r.image\n    view.viewType = 1\n    view.format = 37\n    view.subresourceRange.aspectMask = 1\n    view.subresourceRange.levelCount = 1\n    view.subresourceRange.layerCount = 1\n    if r.api.CreateImageView(r.device, addr(&view), ptr(0), addr(&mut r.imageView)) != 0 { return false }\n    // Both mapped allocations remain valid until queue idle and teardown.\n    if !buffer(&r, ref_at(addr(&mut r.vertex)), 3200000, 128) { return false }\n    buffer(&r, ref_at(addr(&mut r.readback)), u64(r.width * r.height * 4), 2)\n}\n\npub unsafe fn destroy(r: &mut state.Renderer) {\n    if r.device != ptr(0) {\n        waited := r.api.DeviceWaitIdle(r.device)\n        if r.vertex.mapped != ptr(0) { r.api.UnmapMemory(r.device, r.vertex.memory) }\n        if r.readback.mapped != ptr(0) { r.api.UnmapMemory(r.device, r.readback.memory) }\n        // Vulkan destruction commands accept VK_NULL_HANDLE for optional objects.\n        r.api.DestroyBuffer(r.device, r.vertex.handle, ptr(0))\n        r.api.DestroyBuffer(r.device, r.readback.handle, ptr(0))\n        r.api.DestroyFramebuffer(r.device, r.framebuffer, ptr(0))\n        r.api.DestroyPipeline(r.device, r.pipeline, ptr(0))\n        r.api.DestroyPipelineLayout(r.device, r.pipelineLayout, ptr(0))\n        r.api.DestroyShaderModule(r.device, r.vertexShader, ptr(0))\n        r.api.DestroyShaderModule(r.device, r.fragmentShader, ptr(0))\n        r.api.DestroyRenderPass(r.device, r.renderPass, ptr(0))\n        r.api.DestroyImageView(r.device, r.imageView, ptr(0))\n        r.api.DestroyImage(r.device, r.image, ptr(0))\n        r.api.FreeMemory(r.device, r.vertex.memory, ptr(0))\n        r.api.FreeMemory(r.device, r.readback.memory, ptr(0))\n        r.api.FreeMemory(r.device, r.imageMemory, ptr(0))\n        r.api.DestroyCommandPool(r.device, r.pool, ptr(0))\n        r.api.DestroyDevice(r.device, ptr(0))\n    }\n    if r.instance != ptr(0) { r.api.DestroyInstance(r.instance, ptr(0)) }\n}\n" }
    if name == "vulkan/layout" { return "// Native Vulkan structures passed by address. Field names match the Vulkan headers.\n\n@c_layout\npub struct ApplicationInfo {\n    sType: u32,\n    pNext: ptr,\n    pApplicationName: ptr,\n    applicationVersion: u32,\n    pEngineName: ptr,\n    engineVersion: u32,\n    apiVersion: u32,\n}\n\n@c_layout\npub struct InstanceCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    pApplicationInfo: ptr,\n    enabledLayerCount: u32,\n    ppEnabledLayerNames: ptr,\n    enabledExtensionCount: u32,\n    ppEnabledExtensionNames: ptr,\n}\n\n@c_layout\npub struct DeviceQueueCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    queueFamilyIndex: u32,\n    queueCount: u32,\n    pQueuePriorities: ptr,\n}\n\n@c_layout\npub struct DeviceCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    queueCreateInfoCount: u32,\n    pQueueCreateInfos: ptr,\n    enabledLayerCount: u32,\n    ppEnabledLayerNames: ptr,\n    enabledExtensionCount: u32,\n    ppEnabledExtensionNames: ptr,\n    pEnabledFeatures: ptr,\n}\n\n@c_layout\npub struct CommandPoolCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    queueFamilyIndex: u32,\n}\n\n@c_layout\npub struct CommandBufferAllocateInfo {\n    sType: u32,\n    pNext: ptr,\n    commandPool: ptr,\n    level: u32,\n    commandBufferCount: u32,\n}\n\n@c_layout\npub struct ImageCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    imageType: u32,\n    format: u32,\n    extent: Extent3D,\n    mipLevels: u32,\n    arrayLayers: u32,\n    samples: u32,\n    tiling: u32,\n    usage: u32,\n    sharingMode: u32,\n    queueFamilyIndexCount: u32,\n    pQueueFamilyIndices: ptr,\n    initialLayout: u32,\n}\n\n@c_layout\npub struct Extent3D {\n    width: u32,\n    height: u32,\n    depth: u32,\n}\n\n@c_layout\npub struct MemoryRequirements {\n    size: u64,\n    alignment: u64,\n    memoryTypeBits: u32,\n}\n\n@c_layout\npub struct MemoryAllocateInfo {\n    sType: u32,\n    pNext: ptr,\n    allocationSize: u64,\n    memoryTypeIndex: u32,\n}\n\n@c_layout\npub struct ImageViewCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    image: ptr,\n    viewType: u32,\n    format: u32,\n    components: ComponentMapping,\n    subresourceRange: ImageSubresourceRange,\n}\n\n@c_layout\npub struct ComponentMapping {\n    r: u32,\n    g: u32,\n    b: u32,\n    a: u32,\n}\n\n@c_layout\npub struct ImageSubresourceRange {\n    aspectMask: u32,\n    baseMipLevel: u32,\n    levelCount: u32,\n    baseArrayLayer: u32,\n    layerCount: u32,\n}\n\n@c_layout\npub struct AttachmentDescription {\n    flags: u32,\n    format: u32,\n    samples: u32,\n    loadOp: u32,\n    storeOp: u32,\n    stencilLoadOp: u32,\n    stencilStoreOp: u32,\n    initialLayout: u32,\n    finalLayout: u32,\n}\n\n@c_layout\npub struct AttachmentReference {\n    attachment: u32,\n    layout: u32,\n}\n\n@c_layout\npub struct SubpassDescription {\n    flags: u32,\n    pipelineBindPoint: u32,\n    inputAttachmentCount: u32,\n    pInputAttachments: ptr,\n    colorAttachmentCount: u32,\n    pColorAttachments: ptr,\n    pResolveAttachments: ptr,\n    pDepthStencilAttachment: ptr,\n    preserveAttachmentCount: u32,\n    pPreserveAttachments: ptr,\n}\n\n@c_layout\npub struct SubpassDependency {\n    srcSubpass: u32,\n    dstSubpass: u32,\n    srcStageMask: u32,\n    dstStageMask: u32,\n    srcAccessMask: u32,\n    dstAccessMask: u32,\n    dependencyFlags: u32,\n}\n\n@c_layout\npub struct RenderPassCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    attachmentCount: u32,\n    pAttachments: ptr,\n    subpassCount: u32,\n    pSubpasses: ptr,\n    dependencyCount: u32,\n    pDependencies: ptr,\n}\n\n@c_layout\npub struct FramebufferCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    renderPass: ptr,\n    attachmentCount: u32,\n    pAttachments: ptr,\n    width: u32,\n    height: u32,\n    layers: u32,\n}\n\n@c_layout\npub struct ShaderModuleCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    codeSize: usize,\n    pCode: ptr,\n}\n\n@c_layout\npub struct PipelineLayoutCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    setLayoutCount: u32,\n    pSetLayouts: ptr,\n    pushConstantRangeCount: u32,\n    pPushConstantRanges: ptr,\n}\n\n@c_layout\npub struct PipelineShaderStageCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    stage: u32,\n    module: ptr,\n    pName: ptr,\n    pSpecializationInfo: ptr,\n}\n\n@c_layout\npub struct VertexInputBindingDescription {\n    binding: u32,\n    stride: u32,\n    inputRate: u32,\n}\n\n@c_layout\npub struct VertexInputAttributeDescription {\n    location: u32,\n    binding: u32,\n    format: u32,\n    offset: u32,\n}\n\n@c_layout\npub struct PipelineVertexInputStateCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    vertexBindingDescriptionCount: u32,\n    pVertexBindingDescriptions: ptr,\n    vertexAttributeDescriptionCount: u32,\n    pVertexAttributeDescriptions: ptr,\n}\n\n@c_layout\npub struct PipelineInputAssemblyStateCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    topology: u32,\n    primitiveRestartEnable: u32,\n}\n\n@c_layout\npub struct PipelineViewportStateCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    viewportCount: u32,\n    pViewports: ptr,\n    scissorCount: u32,\n    pScissors: ptr,\n}\n\n@c_layout\npub struct Viewport {\n    x: f32,\n    y: f32,\n    width: f32,\n    height: f32,\n    minDepth: f32,\n    maxDepth: f32,\n}\n\n@c_layout\npub struct Rect2D {\n    offset: Offset2D,\n    extent: Extent2D,\n}\n\n@c_layout\npub struct Offset2D {\n    x: i32,\n    y: i32,\n}\n\n@c_layout\npub struct Extent2D {\n    width: u32,\n    height: u32,\n}\n\n@c_layout\npub struct PipelineRasterizationStateCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    depthClampEnable: u32,\n    rasterizerDiscardEnable: u32,\n    polygonMode: u32,\n    cullMode: u32,\n    frontFace: u32,\n    depthBiasEnable: u32,\n    depthBiasConstantFactor: f32,\n    depthBiasClamp: f32,\n    depthBiasSlopeFactor: f32,\n    lineWidth: f32,\n}\n\n@c_layout\npub struct PipelineMultisampleStateCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    rasterizationSamples: u32,\n    sampleShadingEnable: u32,\n    minSampleShading: f32,\n    pSampleMask: ptr,\n    alphaToCoverageEnable: u32,\n    alphaToOneEnable: u32,\n}\n\n@c_layout\npub struct PipelineColorBlendStateCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    logicOpEnable: u32,\n    logicOp: u32,\n    attachmentCount: u32,\n    pAttachments: ptr,\n    blendConstants: [f32; 4],\n}\n\n@c_layout\npub struct PipelineColorBlendAttachmentState {\n    blendEnable: u32,\n    srcColorBlendFactor: u32,\n    dstColorBlendFactor: u32,\n    colorBlendOp: u32,\n    srcAlphaBlendFactor: u32,\n    dstAlphaBlendFactor: u32,\n    alphaBlendOp: u32,\n    colorWriteMask: u32,\n}\n\n@c_layout\npub struct GraphicsPipelineCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    stageCount: u32,\n    pStages: ptr,\n    pVertexInputState: ptr,\n    pInputAssemblyState: ptr,\n    pTessellationState: ptr,\n    pViewportState: ptr,\n    pRasterizationState: ptr,\n    pMultisampleState: ptr,\n    pDepthStencilState: ptr,\n    pColorBlendState: ptr,\n    pDynamicState: ptr,\n    layout: ptr,\n    renderPass: ptr,\n    subpass: u32,\n    basePipelineHandle: ptr,\n    basePipelineIndex: i32,\n}\n\n@c_layout\npub struct BufferCreateInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    size: u64,\n    usage: u32,\n    sharingMode: u32,\n    queueFamilyIndexCount: u32,\n    pQueueFamilyIndices: ptr,\n}\n\n@c_layout\npub struct CommandBufferBeginInfo {\n    sType: u32,\n    pNext: ptr,\n    flags: u32,\n    pInheritanceInfo: ptr,\n}\n\n@c_layout\npub struct RenderPassBeginInfo {\n    sType: u32,\n    pNext: ptr,\n    renderPass: ptr,\n    framebuffer: ptr,\n    renderArea: Rect2D,\n    clearValueCount: u32,\n    pClearValues: ptr,\n}\n\n@c_layout\npub struct BufferImageCopy {\n    bufferOffset: u64,\n    bufferRowLength: u32,\n    bufferImageHeight: u32,\n    imageSubresource: ImageSubresourceLayers,\n    imageOffset: Offset3D,\n    imageExtent: Extent3D,\n}\n\n@c_layout\npub struct ImageSubresourceLayers {\n    aspectMask: u32,\n    mipLevel: u32,\n    baseArrayLayer: u32,\n    layerCount: u32,\n}\n\n@c_layout\npub struct Offset3D {\n    x: i32,\n    y: i32,\n    z: i32,\n}\n\n@c_layout\npub struct MemoryBarrier {\n    sType: u32,\n    pNext: ptr,\n    srcAccessMask: u32,\n    dstAccessMask: u32,\n}\n\n@c_layout\npub struct SubmitInfo {\n    sType: u32,\n    pNext: ptr,\n    waitSemaphoreCount: u32,\n    pWaitSemaphores: ptr,\n    pWaitDstStageMask: ptr,\n    commandBufferCount: u32,\n    pCommandBuffers: ptr,\n    signalSemaphoreCount: u32,\n    pSignalSemaphores: ptr,\n}\n\n" }
    if name == "vulkan/pipeline" { return "capability unsafe\n\nimport std.vulkan.layout as vk\nimport std.vulkan.shader as shader\nimport std.vulkan.state as state\n\n@c_layout\nstruct Dependencies { before: vk.SubpassDependency, after: vk.SubpassDependency }\n@c_layout\nstruct Stages { vertex: vk.PipelineShaderStageCreateInfo, fragment: vk.PipelineShaderStageCreateInfo }\n@c_layout\nstruct Attributes { position: vk.VertexInputAttributeDescription, color: vk.VertexInputAttributeDescription }\n\nunsafe fn targets(r: &mut state.Renderer) -> bool {\n    var attachment: vk.AttachmentDescription = zeroed()\n    attachment.format = 37\n    attachment.samples = 1\n    attachment.loadOp = 1\n    attachment.stencilLoadOp = 2\n    attachment.stencilStoreOp = 1\n    attachment.finalLayout = 6\n    color := vk.AttachmentReference {attachment: 0, layout: 2}\n    var subpass: vk.SubpassDescription = zeroed()\n    subpass.colorAttachmentCount = 1\n    subpass.pColorAttachments = addr(&color)\n    var before: vk.SubpassDependency = zeroed()\n    before.srcSubpass = 4294967295\n    before.srcStageMask = 1\n    before.dstStageMask = 1024\n    before.dstAccessMask = 256\n    var after: vk.SubpassDependency = zeroed()\n    after.dstSubpass = 4294967295\n    after.srcStageMask = 1024\n    after.dstStageMask = 4096\n    after.srcAccessMask = 256\n    after.dstAccessMask = 2048\n    dependencies := Dependencies {before: before, after: after}\n    var pass: vk.RenderPassCreateInfo = zeroed()\n    pass.sType = 38\n    pass.attachmentCount = 1\n    pass.pAttachments = addr(&attachment)\n    pass.subpassCount = 1\n    pass.pSubpasses = addr(&subpass)\n    pass.dependencyCount = 2\n    pass.pDependencies = addr(&dependencies)\n    if r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.renderPass)) != 0 { return false }\n    var frame: vk.FramebufferCreateInfo = zeroed()\n    frame.sType = 37\n    frame.renderPass = r.renderPass\n    frame.attachmentCount = 1\n    frame.pAttachments = addr(&r.imageView)\n    frame.width = u32(r.width)\n    frame.height = u32(r.height)\n    frame.layers = 1\n    r.api.CreateFramebuffer(r.device, addr(&frame), ptr(0), addr(&mut r.framebuffer)) == 0\n}\n\nunsafe fn module(r: &state.Renderer, words: ptr, size: usize, output: ptr) -> bool {\n    var info: vk.ShaderModuleCreateInfo = zeroed()\n    info.sType = 16\n    info.codeSize = size\n    info.pCode = words\n    r.api.CreateShaderModule(r.device, addr(&info), ptr(0), output) == 0\n}\n\npub unsafe fn setup(r: &mut state.Renderer) -> bool {\n    if !targets(&mut r) { return false }\n    vertex := shader.vertex()\n    if !module(&r, addr(&vertex[0]), usize(vertex.len * 4), addr(&mut r.vertexShader)) { return false }\n    fragment := shader.fragment()\n    if !module(&r, addr(&fragment[0]), usize(fragment.len * 4), addr(&mut r.fragmentShader)) { return false }\n    var layout: vk.PipelineLayoutCreateInfo = zeroed()\n    layout.sType = 30\n    if r.api.CreatePipelineLayout(r.device, addr(&layout), ptr(0), addr(&mut r.pipelineLayout)) != 0 { return false }\n\n    var stage: vk.PipelineShaderStageCreateInfo = zeroed()\n    stage.sType = 18\n    stage.stage = 1\n    stage.module = r.vertexShader\n    stage.pName = cstr(\"main\")\n    var stages := Stages {vertex: stage, fragment: stage}\n    stages.fragment.stage = 16\n    stages.fragment.module = r.fragmentShader\n    binding := vk.VertexInputBindingDescription {binding: 0, stride: 32, inputRate: 0}\n    attributes := Attributes {\n        position: vk.VertexInputAttributeDescription {location: 0, binding: 0, format: 109, offset: 0},\n        color: vk.VertexInputAttributeDescription {location: 1, binding: 0, format: 109, offset: 16}\n    }\n    var input: vk.PipelineVertexInputStateCreateInfo = zeroed()\n    input.sType = 19\n    input.vertexBindingDescriptionCount = 1\n    input.pVertexBindingDescriptions = addr(&binding)\n    input.vertexAttributeDescriptionCount = 2\n    input.pVertexAttributeDescriptions = addr(&attributes)\n    var assembly: vk.PipelineInputAssemblyStateCreateInfo = zeroed()\n    assembly.sType = 20\n    assembly.topology = 3\n    viewport := vk.Viewport {x: 0.0, y: 0.0, width: f32(r.width), height: f32(r.height), minDepth: 0.0, maxDepth: 1.0}\n    scissor := vk.Rect2D {offset: vk.Offset2D {x: 0, y: 0}, extent: vk.Extent2D {width: u32(r.width), height: u32(r.height)}}\n    var view: vk.PipelineViewportStateCreateInfo = zeroed()\n    view.sType = 22\n    view.viewportCount = 1\n    view.pViewports = addr(&viewport)\n    view.scissorCount = 1\n    view.pScissors = addr(&scissor)\n    var raster: vk.PipelineRasterizationStateCreateInfo = zeroed()\n    raster.sType = 23\n    raster.lineWidth = 1.0\n    var samples: vk.PipelineMultisampleStateCreateInfo = zeroed()\n    samples.sType = 24\n    samples.rasterizationSamples = 1\n    color := vk.PipelineColorBlendAttachmentState {\n        blendEnable: 1, srcColorBlendFactor: 6, dstColorBlendFactor: 7, colorBlendOp: 0,\n        srcAlphaBlendFactor: 1, dstAlphaBlendFactor: 7, alphaBlendOp: 0, colorWriteMask: 15\n    }\n    var blend: vk.PipelineColorBlendStateCreateInfo = zeroed()\n    blend.sType = 26\n    blend.attachmentCount = 1\n    blend.pAttachments = addr(&color)\n    var info: vk.GraphicsPipelineCreateInfo = zeroed()\n    info.sType = 28\n    info.stageCount = 2\n    info.pStages = addr(&stages)\n    info.pVertexInputState = addr(&input)\n    info.pInputAssemblyState = addr(&assembly)\n    info.pViewportState = addr(&view)\n    info.pRasterizationState = addr(&raster)\n    info.pMultisampleState = addr(&samples)\n    info.pColorBlendState = addr(&blend)\n    info.layout = r.pipelineLayout\n    info.renderPass = r.renderPass\n    info.basePipelineIndex = -1\n    r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&info), ptr(0), addr(&mut r.pipeline)) == 0\n}\n\npub unsafe fn render(r: &state.Renderer, vertices: u32, red: f32, green: f32, blue: f32) -> bool {\n    if r.api.ResetCommandBuffer(r.command, 0) != 0 { return false }\n    var begin: vk.CommandBufferBeginInfo = zeroed()\n    begin.sType = 42\n    begin.flags = 1\n    if r.api.BeginCommandBuffer(r.command, addr(&begin)) != 0 { return false }\n    clear: [f32; 4] = [red, green, blue, 1.0]\n    var pass: vk.RenderPassBeginInfo = zeroed()\n    pass.sType = 43\n    pass.renderPass = r.renderPass\n    pass.framebuffer = r.framebuffer\n    pass.renderArea.extent.width = u32(r.width)\n    pass.renderArea.extent.height = u32(r.height)\n    pass.clearValueCount = 1\n    pass.pClearValues = addr(&clear[0])\n    r.api.CmdBeginRenderPass(r.command, addr(&pass), 0)\n    r.api.CmdBindPipeline(r.command, 0, r.pipeline)\n    offset: u64 = 0\n    r.api.CmdBindVertexBuffers(r.command, 0, 1, addr(&r.vertex.handle), addr(&offset))\n    r.api.CmdDraw(r.command, vertices, 1, 0, 0)\n    r.api.CmdEndRenderPass(r.command)\n    var copy: vk.BufferImageCopy = zeroed()\n    copy.imageSubresource.aspectMask = 1\n    copy.imageSubresource.layerCount = 1\n    copy.imageExtent = vk.Extent3D {width: u32(r.width), height: u32(r.height), depth: 1}\n    r.api.CmdCopyImageToBuffer(r.command, r.image, 6, r.readback.handle, 1, addr(&copy))\n    var barrier: vk.MemoryBarrier = zeroed()\n    barrier.sType = 46\n    barrier.srcAccessMask = 4096\n    barrier.dstAccessMask = 8192\n    r.api.CmdPipelineBarrier(r.command, 4096, 16384, 0, 1, addr(&barrier), 0, ptr(0), 0, ptr(0))\n    if r.api.EndCommandBuffer(r.command) != 0 { return false }\n    var submit: vk.SubmitInfo = zeroed()\n    submit.sType = 4\n    submit.commandBufferCount = 1\n    submit.pCommandBuffers = addr(&r.command)\n    if r.api.QueueSubmit(r.queue, 1, addr(&submit), ptr(0)) != 0 { return false }\n    r.api.QueueWaitIdle(r.queue) == 0\n}\n" }
    if name == "vulkan/sdl" { return "capability unsafe\n\nimport std.dl as dl\n\n// SDL owns the window, input and final software blit. Vulkan supplies the pixels.\n@c_layout\npub struct Window {\n    library: ptr,\n    handle: ptr,\n    id: u32,\n    initialized: u32,\n    closed: u32,\n    resized: u32,\n    down: u32,\n    key: i32,\n    x: i32,\n    y: i32,\n    width: i32,\n    height: i32,\n    InitSubSystem: extern fn(u32) -> i32,\n    QuitSubSystem: extern fn(u32),\n    CreateWindow: extern fn(ptr, i32, i32, i32, i32, u32) -> ptr,\n    DestroyWindow: extern fn(ptr),\n    GetWindowSurface: extern fn(ptr) -> ptr,\n    CreateRGBSurfaceFrom: extern fn(ptr, i32, i32, i32, i32, u32, u32, u32, u32) -> ptr,\n    UpperBlitScaled: extern fn(ptr, ptr, ptr, ptr) -> i32,\n    UpdateWindowSurface: extern fn(ptr) -> i32,\n    FreeSurface: extern fn(ptr),\n    PollEvent: extern fn(ptr) -> i32,\n    GetWindowSize: extern fn(ptr, ptr, ptr),\n    GetWindowID: extern fn(ptr) -> u32,\n    SetSurfaceBlendMode: extern fn(ptr, i32) -> i32,\n}\n\nunsafe fn load(w: &mut Window) -> bool {\n    w.library = dl.open(cstr(\"libSDL2-2.0.so.0\"), 2)\n    if w.library == ptr(0) { return false }\n    var symbol := ptr(0)\n    symbol = dl.symbol(w.library, cstr(\"SDL_InitSubSystem\"))\n    if symbol == ptr(0) { return false }\n    w.InitSubSystem = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_QuitSubSystem\"))\n    if symbol == ptr(0) { return false }\n    w.QuitSubSystem = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_CreateWindow\"))\n    if symbol == ptr(0) { return false }\n    w.CreateWindow = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_DestroyWindow\"))\n    if symbol == ptr(0) { return false }\n    w.DestroyWindow = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_GetWindowSurface\"))\n    if symbol == ptr(0) { return false }\n    w.GetWindowSurface = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_CreateRGBSurfaceFrom\"))\n    if symbol == ptr(0) { return false }\n    w.CreateRGBSurfaceFrom = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_UpperBlitScaled\"))\n    if symbol == ptr(0) { return false }\n    w.UpperBlitScaled = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_UpdateWindowSurface\"))\n    if symbol == ptr(0) { return false }\n    w.UpdateWindowSurface = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_FreeSurface\"))\n    if symbol == ptr(0) { return false }\n    w.FreeSurface = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_PollEvent\"))\n    if symbol == ptr(0) { return false }\n    w.PollEvent = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_GetWindowSize\"))\n    if symbol == ptr(0) { return false }\n    w.GetWindowSize = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_GetWindowID\"))\n    if symbol == ptr(0) { return false }\n    w.GetWindowID = ffi_fn(symbol)\n    symbol = dl.symbol(w.library, cstr(\"SDL_SetSurfaceBlendMode\"))\n    if symbol == ptr(0) { return false }\n    w.SetSurfaceBlendMode = ffi_fn(symbol)\n    true\n}\n\npub unsafe fn open(w: &mut Window, title: string, width: i32, height: i32) -> bool {\n    if title.len > 4095 { return false }\n    var name: []u8 = []\n    name.reserve(title.len + 1)\n    for byte in title.bytes() {\n        if byte == 0 { return false }\n        name.push(u8(byte))\n    }\n    name.push(0)\n    if !load(&mut w) { return false }\n    if w.InitSubSystem(32) != 0 { return false }\n    w.initialized = 1\n    w.handle = w.CreateWindow(addr(&name[0]), 805240832, 805240832, width, height, 36)\n    if w.handle == ptr(0) { return false }\n    w.id = w.GetWindowID(w.handle)\n    w.width = width\n    w.height = height\n    w.resized = 1\n    true\n}\n\npub unsafe fn close(w: &mut Window) {\n    if w.handle != ptr(0) { w.DestroyWindow(w.handle) }\n    if w.initialized != 0 { w.QuitSubSystem(32) }\n    if w.library != ptr(0) { closed := dl.close(w.library) }\n}\n\npub unsafe fn poll(w: &mut Window) {\n    w.key = -1\n    w.resized = 0\n    if w.closed != 0 { return }\n    // SDL_Event is a tagged 56-byte union on 64-bit targets. One control\n    // event per frame preserves key and button transitions for the caller.\n    var event: [u64; 7] = [0; 7]\n    base := addr(&mut event[0])\n    for i in 0..256 {\n        if w.PollEvent(base) == 0 { break }\n        kind := load_u32(base)\n        if kind == 256 { w.closed = 1; w.down = 0; break }\n        if load_u32(ptr(usize(base) + 8)) == w.id {\n            if kind == 512 {\n                action := load_u8(ptr(usize(base) + 12))\n                if action == 14 { w.closed = 1; w.down = 0; break }\n                if action == 5 || action == 6 { w.resized = 1; break }\n                if action == 13 { w.down = 0; break }\n            }\n            if kind == 768 { w.key = load_i32(ptr(usize(base) + 20)); break }\n            if kind == 1024 || ((kind == 1025 || kind == 1026) && load_u8(ptr(usize(base) + 16)) == 1) {\n                w.x = load_i32(ptr(usize(base) + 20))\n                w.y = load_i32(ptr(usize(base) + 24))\n                if kind == 1024 { w.down = u32(i32(load_u32(ptr(usize(base) + 16))).bit_and(1)) }\n                else { w.down = u32(load_u8(ptr(usize(base) + 17))) }\n                break\n            }\n        }\n    }\n    w.GetWindowSize(w.handle, addr(&mut w.width), addr(&mut w.height))\n}\n\npub unsafe fn present(w: &Window, pixels: ptr, width: i32, height: i32) -> bool {\n    surface := w.GetWindowSurface(w.handle)\n    if surface == ptr(0) { return false }\n    image := w.CreateRGBSurfaceFrom(pixels, width, height, 32, width * 4, 255, 65280, 16711680, 4278190080)\n    if image == ptr(0) { return false }\n    var ok := w.SetSurfaceBlendMode(image, 0) == 0\n    if ok { ok = w.UpperBlitScaled(image, ptr(0), surface, ptr(0)) == 0 }\n    w.FreeSurface(image)\n    ok && w.UpdateWindowSurface(w.handle) == 0\n}\n" }
    if name == "vulkan/shader" { return "// SPIR-V 1.0, compiled from triangle.vert and triangle.frag with glslangValidator -V -Os.\n\npub fn vertex() -> [u32; 271] {\n    [\n        119734787, 65536, 524299, 37, 0, 131089, 1, 393227,\n        1, 1280527431, 1685353262, 808793134, 0, 196622, 0, 1,\n        589839, 0, 4, 1852399981, 0, 13, 17, 34,\n        35, 196611, 2, 450, 262149, 4, 1852399981, 0,\n        393221, 11, 1348430951, 1700164197, 2019914866, 0, 393222, 11,\n        0, 1348430951, 1953067887, 7237481, 458758, 11, 1, 1348430951,\n        1953393007, 1702521171, 0, 458758, 11, 2, 1130327143, 1148217708,\n        1635021673, 6644590, 458758, 11, 3, 1130327143, 1147956341, 1635021673,\n        6644590, 196613, 13, 0, 327685, 17, 1769172848, 1852795252,\n        0, 393221, 34, 1953654134, 1667201125, 1919904879, 0, 262149,\n        35, 1869377379, 114, 196679, 11, 2, 327752, 11,\n        0, 11, 0, 327752, 11, 1, 11, 1,\n        327752, 11, 2, 11, 3, 327752, 11, 3,\n        11, 4, 262215, 17, 30, 0, 262215, 34,\n        30, 0, 262215, 35, 30, 1, 131091, 2,\n        196641, 3, 2, 196630, 6, 32, 262167, 7,\n        6, 4, 262165, 8, 32, 0, 262187, 8,\n        9, 1, 262172, 10, 6, 9, 393246, 11,\n        7, 6, 10, 10, 262176, 12, 3, 11,\n        262203, 12, 13, 3, 262165, 14, 32, 1,\n        262187, 14, 15, 0, 262176, 16, 1, 7,\n        262203, 16, 17, 1, 262187, 8, 18, 0,\n        262176, 19, 1, 6, 262187, 8, 25, 2,\n        262187, 8, 28, 3, 262176, 32, 3, 7,\n        262203, 32, 34, 3, 262203, 16, 35, 1,\n        327734, 2, 4, 0, 3, 131320, 5, 327745,\n        19, 20, 17, 18, 262205, 6, 21, 20,\n        327745, 19, 22, 17, 9, 262205, 6, 23,\n        22, 262271, 6, 24, 23, 327745, 19, 26,\n        17, 25, 262205, 6, 27, 26, 327745, 19,\n        29, 17, 28, 262205, 6, 30, 29, 458832,\n        7, 31, 21, 24, 27, 30, 327745, 32,\n        33, 13, 15, 196670, 33, 31, 262205, 7,\n        36, 35, 196670, 34, 36, 65789, 65592\n    ]\n}\n\npub fn fragment() -> [u32; 97] {\n    [\n        119734787, 65536, 524299, 13, 0, 131089, 1, 393227,\n        1, 1280527431, 1685353262, 808793134, 0, 196622, 0, 1,\n        458767, 4, 4, 1852399981, 0, 9, 11, 196624,\n        4, 7, 196611, 2, 450, 262149, 4, 1852399981,\n        0, 393221, 9, 1734439526, 1953391981, 1819239263, 29295, 393221,\n        11, 1953654134, 1667201125, 1919904879, 0, 262215, 9, 30,\n        0, 262215, 11, 30, 0, 131091, 2, 196641,\n        3, 2, 196630, 6, 32, 262167, 7, 6,\n        4, 262176, 8, 3, 7, 262203, 8, 9,\n        3, 262176, 10, 1, 7, 262203, 10, 11,\n        1, 327734, 2, 4, 0, 3, 131320, 5,\n        262205, 7, 12, 11, 196670, 9, 12, 65789,\n        65592\n    ]\n}\n" }
    if name == "vulkan/state" { return "capability unsafe\n\nimport std.vulkan.api as vk\nimport std.vulkan.sdl as sdl\n\n@c_layout\npub struct Buffer {\n    handle: ptr,\n    memory: ptr,\n    mapped: ptr,\n}\n\n@c_layout\npub struct MemoryProperties {\n    typeCount: u32,\n    // 32 VkMemoryType entries, each propertyFlags followed by heapIndex.\n    types: [u32; 64],\n    heapCount: u32,\n    heaps: [u64; 32],\n}\n\n// VkPhysicalDeviceProperties has a stable Vulkan 1.0 layout. Reserve aligned\n// space for its limits and sparse properties; only its deviceName is consumed.\n@c_layout\npub struct Properties {\n    apiVersion: u32, driverVersion: u32, vendorID: u32, deviceID: u32, deviceType: u32,\n    deviceName: [u8; 256],\n    rest: [u64; 128],\n}\n\n@c_layout\npub struct Renderer {\n    api: vk.Api,\n    loader: ptr,\n    instance: ptr,\n    physical: ptr,\n    device: ptr,\n    queue: ptr,\n    family: u32,\n    properties: Properties,\n    memoryProperties: MemoryProperties,\n    pool: ptr,\n    command: ptr,\n    image: ptr,\n    imageMemory: ptr,\n    imageView: ptr,\n    renderPass: ptr,\n    framebuffer: ptr,\n    pipelineLayout: ptr,\n    pipeline: ptr,\n    vertexShader: ptr,\n    fragmentShader: ptr,\n    vertex: Buffer,\n    readback: Buffer,\n    width: i32,\n    height: i32,\n    frames: i64,\n    firstPoll: u32,\n    startMillis: i64,\n    window: sdl.Window,\n}\n" }
    ""
}

pub fn contains(name: string) -> bool {
    if name == "array" { return true }
    if name == "bytes" { return true }
    if name == "dl" { return true }
    if name == "fs" { return true }
    if name == "hash" { return true }
    if name == "macos" { return true }
    if name == "macos/appkit" { return true }
    if name == "macos/objc" { return true }
    if name == "macos/renderer" { return true }
    if name == "map" { return true }
    if name == "parse" { return true }
    if name == "set" { return true }
    if name == "sha256" { return true }
    if name == "sys" { return true }
    if name == "text" { return true }
    if name == "vulkan" { return true }
    if name == "vulkan/api" { return true }
    if name == "vulkan/device" { return true }
    if name == "vulkan/layout" { return true }
    if name == "vulkan/pipeline" { return true }
    if name == "vulkan/sdl" { return true }
    if name == "vulkan/shader" { return true }
    if name == "vulkan/state" { return true }
    false
}

pub fn float_formatter() -> string { "// Shortest round-trip decimal formatting from IEEE bits, written in Dunder.\n// Exact decimal integers describe the value and its rounding interval.\n// Try increasing significant-digit counts; accept a decimal only inside\n// that interval, including midpoint ties only for an even significand.\npub fn format_float_bits(raw: i64, single: bool) -> string {\n    var bits := raw\n    var negative := false\n    var unit: i64 = 4503599627370496\n    var bias := 1023\n    var fraction_bits := 52\n    var exponent_limit := 2047\n    var precision := 17\n    if single {\n        unit = 8388608\n        bias = 127\n        fraction_bits = 23\n        exponent_limit = 255\n        precision = 9\n        if bits >= 2147483648 { negative = true; bits = bits - 2147483648 }\n    } else if bits < 0 {\n        negative = true\n        bits = bits - i64(-9223372036854775808)\n    }\n    var sign := \"\"\n    if negative { sign = \"-\" }\n    exponent_field := i32(bits / unit)\n    if exponent_field == exponent_limit {\n        if bits % unit != 0 { return \"nan\" }\n        return sign + \"inf\"\n    }\n    if bits == 0 { return sign + \"0.0\" }\n    var mantissa := bits % unit\n    var exponent := 1 - bias - fraction_bits\n    if exponent_field != 0 {\n        mantissa = mantissa + unit\n        exponent = exponent_field - bias - fraction_bits\n    }\n    even := mantissa % 2 == 0\n    var digits := [0; 2400]\n    var sizes := [0; 3]\n    var scales := [0; 3]\n    for variant in 0..3 {\n        var coefficient := mantissa\n        var power := exponent\n        if variant == 1 {\n            coefficient = mantissa * 2 - 1\n            power = exponent - 1\n            if mantissa == unit && exponent_field > 1 {\n                coefficient = mantissa * 4 - 1\n                power = exponent - 2\n            }\n        }\n        if variant == 2 { coefficient = mantissa * 2 + 1; power = exponent - 1 }\n        base := variant * 800\n        var size := 0\n        while coefficient != 0 {\n            digits[base + size] = i32(coefficient % 10)\n            coefficient = coefficient / 10\n            size = size + 1\n        }\n        var factor := 2\n        var steps := power\n        if power < 0 { factor = 5; steps = -power; scales[variant] = -power }\n        for step in 0..steps {\n            var carry := 0\n            for j in 0..size {\n                next := digits[base + j] * factor + carry\n                digits[base + j] = next % 10\n                carry = next / 10\n            }\n            if carry != 0 { digits[base + size] = carry; size = size + 1 }\n        }\n        sizes[variant] = size\n    }\n    var prefix: i64 = 0\n    var chosen: i64 = 0\n    var decimal_power := 0\n    var found := false\n    for count in 1..precision + 1 {\n        value_index := sizes[0] - count\n        var digit := 0\n        if value_index >= 0 { digit = digits[value_index] }\n        prefix = prefix * 10 + i64(digit)\n        var round_up := false\n        if value_index > 0 {\n            next := digits[value_index - 1]\n            var tail := false\n            for j in 0..value_index - 1 { if digits[j] != 0 { tail = true } }\n            round_up = next > 5 || (next == 5 && (tail || prefix % 2 != 0))\n        }\n        power := sizes[0] - scales[0] - count\n        for attempt in 0..2 {\n            var candidate := prefix\n            if (attempt == 0 && round_up) || (attempt == 1 && !round_up) { candidate = candidate + 1 }\n            spelling := candidate.str()\n            var accepted := true\n            for boundary in 1..3 {\n                order := spelling.len + power\n                bound_order := sizes[boundary] - scales[boundary]\n                var comparison := 0\n                if order < bound_order { comparison = -1 }\n                if order > bound_order { comparison = 1 }\n                if order == bound_order {\n                    var length := sizes[boundary]\n                    if spelling.len > length { length = spelling.len }\n                    for j in 0..length {\n                        var a := 0\n                        var b := 0\n                        if j < spelling.len { a = spelling[j] - 48 }\n                        if j < sizes[boundary] { b = digits[boundary * 800 + sizes[boundary] - 1 - j] }\n                        if a < b { comparison = -1; break }\n                        if a > b { comparison = 1; break }\n                    }\n                }\n                if boundary == 1 && (comparison < 0 || (comparison == 0 && !even)) { accepted = false }\n                if boundary == 2 && (comparison > 0 || (comparison == 0 && !even)) { accepted = false }\n            }\n            if accepted { chosen = candidate; decimal_power = power; found = true; break }\n        }\n        if found { break }\n    }\n    assert(found)\n    while chosen % 10 == 0 { chosen = chosen / 10; decimal_power = decimal_power + 1 }\n    spelling := chosen.str()\n    order := spelling.len + decimal_power - 1\n    if order < -4 || order >= 16 {\n        var result := sign + spelling[0..1]\n        if spelling.len > 1 { result = result + \".\" + spelling[1..spelling.len] }\n        result = result + \"e\"\n        if order >= 0 { result = result + \"+\" }\n        return result + order.str()\n    }\n    if decimal_power >= 0 {\n        var result := sign + spelling\n        for i in 0..decimal_power { result = result + \"0\" }\n        return result + \".0\"\n    }\n    point := spelling.len + decimal_power\n    if point > 0 { return sign + spelling[0..point] + \".\" + spelling[point..spelling.len] }\n    var result := sign + \"0.\"\n    for i in 0..-point { result = result + \"0\" }\n    result + spelling\n}\n" }
