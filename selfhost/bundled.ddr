    if name == "array" { return "// Dynamic storage is provided by []T; these algorithms are ordinary Dunder.\npub fn ints() -> []i64 { [] }\npub fn strings() -> []string { [] }\npub fn sum(values: &[]i64) -> i64 {\n    var result: i64 = 0\n    var i := 0\n    while i < values.len { result = result + values[i]; i = i + 1 }\n    result\n}\npub fn reverse(values: &mut []i64) {\n    var left := 0\n    var right := values.len - 1\n    while left < right {\n        value := values[left]\n        values[left] = values[right]\n        values[right] = value\n        left = left + 1\n        right = right - 1\n    }\n}\npub fn sort(values: &mut []i64) {\n    for i in 1..values.len {\n        value := values[i]\n        var j := i\n        while j > 0 && values[j - 1] > value { values[j] = values[j - 1]; j = j - 1 }\n        values[j] = value\n    }\n}\n// In-place heapsort, ordered by UTF-8 bytes like ordinary string comparisons.\n// O(n log n), without allocating a second array or recursive stack frames.\nfn sift_strings(values: &mut []string, start: i32, end: i32) {\n    var root := start\n    while root < end / 2 {\n        var child := root * 2 + 1\n        if child + 1 < end && values[child] < values[child + 1] { child = child + 1 }\n        if values[root] >= values[child] { return }\n        value := values[root]\n        values[root] = values[child]\n        values[child] = value\n        root = child\n    }\n}\npub fn sort_strings(values: &mut []string) {\n    var start := values.len / 2\n    while start > 0 {\n        start = start - 1\n        sift_strings(&mut values, start, values.len)\n    }\n    var end := values.len - 1\n    while end > 0 {\n        value := values[0]\n        values[0] = values[end]\n        values[end] = value\n        sift_strings(&mut values, 0, end)\n        end = end - 1\n    }\n}\npub fn append(values: &mut []i64, extra: &[]i64) {\n    values.reserve(values.len + extra.len)\n    var i := 0\n    while i < extra.len { values.push(extra[i]); i = i + 1 }\n}\n@test fn dynamic_algorithms_preserve_independent_values() {\n    var values: []i64 = [3, -1, 9, 0, 3]\n    copy := values\n    sort(&mut values)\n    values[0] == -1\n    values[4] == 9\n    reverse(&mut values)\n    values[0] == 9\n    sum(&values) == 14\n    append(&mut values, &copy)\n    values.len == 10\n    sum(&values) == 28\n    copy[0] == 3\n}\n@test fn string_sort_handles_empty_values_unicode_duplicates_and_copies() {\n    var values: []string = [\"🌍\", \"å\", \"\", \"a\", \"a\", \"\\0\", \"ä\"]\n    original := values\n    sort_strings(&mut values)\n    values[0] == \"\"\n    values[1] == \"\\0\"\n    values[2] == \"a\"\n    values[3] == \"a\"\n    values[4] == \"ä\"\n    values[5] == \"å\"\n    values[6] == \"🌍\"\n    original[0] == \"🌍\"\n    var empty: []string = []\n    sort_strings(&mut empty)\n    empty.len == 0\n    var one: []string = [\"one\"]\n    sort_strings(&mut one)\n    one[0] == \"one\"\n}\n" }
    if name == "bytes" { return "import sys\n// Packed byte storage is useful for files, UTF-8 and binary protocols.\npub fn packed() -> []u8 { [] }\npub fn append_utf8(output: &mut []u8, text: string) {\n    output.reserve(output.len + text.len)\n    for byte in text.bytes() { output.push(u8(byte)) }\n}\npub fn extend(output: &mut []u8, input: &[]u8) {\n    output.reserve(output.len + input.len)\n    var i := 0\n    while i < input.len { output.push(input[i]); i = i + 1 }\n}\npub fn pad(output: &mut []u8, count: i32) {\n    assert(count >= 0)\n    output.reserve(output.len + count)\n    for i in 0..count { output.push(0) }\n}\npub fn append_le(output: &mut []u8, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8)\n    for i in 0..width { output.push(u8(value.shr(i * 8).bit_and(255))) }\n}\npub fn set_be(output: &mut []u8, offset: i32, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8 && offset >= 0 && offset <= output.len - width)\n    for i in 0..width { output[offset + width - 1 - i] = u8(value.shr(i * 8).bit_and(255)) }\n}\npub fn decode(input: &[]u8) -> sys.TextResult { sys.decode_u8(&input) }\n\npub fn new() -> []i32 { [] }\npub fn utf8(input: &[]i32) -> sys.TextResult { sys.decode_utf8(&input) }\npub fn append_text(output: &mut []i32, text: string) {\n    output.reserve(output.len + text.len)\n    for byte in text.bytes() { output.push(byte) }\n}\npub fn append(output: &mut []i32, input: &[]i32) {\n    output.reserve(output.len + input.len)\n    var i := 0\n    while i < input.len { assert(input[i] >= 0 && input[i] <= 255); output.push(input[i]); i = i + 1 }\n}\npub fn zeros(output: &mut []i32, count: i32) {\n    assert(count >= 0)\n    output.reserve(output.len + count)\n    for i in 0..count { output.push(0) }\n}\npub fn u32le(output: &mut []i32, value: i64) {\n    assert(value >= 0 && value <= 4294967295)\n    var remaining := value\n    for i in 0..4 { output.push(i32(remaining % 256)); remaining = remaining / 256 }\n}\npub fn u64le(output: &mut []i32, value: i64) {\n    for i in 0..8 { output.push(i32(value.shr(i * 8).bit_and(255))) }\n}\npub fn set_u32le(output: &mut []i32, offset: i32, value: i64) {\n    assert(value >= 0 && value <= 4294967295)\n    assert(offset >= 0 && offset <= output.len - 4)\n    var remaining := value\n    for i in 0..4 { output[offset + i] = i32(remaining % 256); remaining = remaining / 256 }\n}\npub fn set_u32be(output: &mut []i32, offset: i32, value: i64) {\n    assert(value >= 0 && value <= 4294967295)\n    assert(offset >= 0 && offset <= output.len - 4)\n    var remaining := value\n    for i in 0..4 { output[offset + 3 - i] = i32(remaining % 256); remaining = remaining / 256 }\n}\npub fn set_u64be(output: &mut []i32, offset: i32, value: i64) {\n    assert(offset >= 0 && offset <= output.len - 8)\n    for i in 0..8 { output[offset + 7 - i] = i32(value.shr(i * 8).bit_and(255)) }\n}\npub fn hex(input: &[]i32) -> string {\n    digits := \"0123456789abcdef\"\n    var output: []u8 = []\n    output.reserve(input.len * 2)\n    var i := 0\n    while i < input.len {\n        byte := input[i]\n        assert(byte >= 0 && byte <= 255)\n        output.push(u8(digits[byte / 16]))\n        output.push(u8(digits[byte % 16]))\n        i = i + 1\n    }\n    result := decode(&output)\n    assert(result.ok)\n    result.value\n}\n@test fn byte_encoding_is_explicit_and_round_trips_bits() {\n    var output := new()\n    u32le(&mut output, 4278255360)\n    hex(&output) == \"00ff00ff\"\n    set_u32be(&mut output, 0, 16909060)\n    hex(&output) == \"01020304\"\n    output.clear()\n    u64le(&mut output, -1)\n    hex(&output) == \"ffffffffffffffff\"\n    output.clear()\n    append_text(&mut output, \"å\")\n    hex(&output) == \"c3a5\"\n}\n" }
