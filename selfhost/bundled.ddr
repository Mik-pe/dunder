alse, error: e2 } }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        if c_symlink(addr(&raw_target[0]), addr(&raw_link[0])) == 0 {\n            return sys.Status { ok: true, error: 0 }\n        }\n        return sys.Status { ok: false, error: read_errno() }\n    }\n    sys.Status { ok: false, error: 45 }\n}\n\n@requires(filesystem)\npub fn hard_link(existing: string, link_path: string) -> sys.Status {\n    mut raw_existing: []u8 = []\n    mut raw_link: []u8 = []\n    e1 := c_path(existing, &mut raw_existing)\n    if e1 != 0 { return sys.Status { ok: false, error: e1 } }\n    e2 := c_path(link_path, &mut raw_link)\n    if e2 != 0 { return sys.Status { ok: false, error: e2 } }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        if c_link(addr(&raw_existing[0]), addr(&raw_link[0])) == 0 {\n            return sys.Status { ok: true, error: 0 }\n        }\n        return sys.Status { ok: false, error: read_errno() }\n    }\n    sys.Status { ok: false, error: 45 }\n}\n\n@requires(filesystem)\npub fn mkdir_all(path: string) -> sys.Status {\n    if path.len == 0 { return sys.Status { ok: false, error: 22 } }\n    if path.len > 1023 { return sys.Status { ok: false, error: 63 } }\n    for b in path.bytes() { if b == 0 { return sys.Status { ok: false, error: 22 } } }\n    info := sys.metadata(path)\n    if info.ok {\n        if info.is_dir { return sys.Status { ok: true, error: 0 } }\n        return sys.Status { ok: false, error: 17 }\n    }\n    mut i := 0\n    if path[0] == 47 { i = 1 }\n    while i <= path.len {\n        if i == path.len || path[i] == 47 {\n            if i > 0 {\n                prefix := path[0..i]\n                if prefix != \".\" && prefix != \"..\" {\n                    pinfo := sys.metadata(prefix)\n                    if !pinfo.ok {\n                        st := sys.mkdir(prefix)\n                        if !st.ok && st.error != 17 { return st }\n                        check := sys.metadata(prefix)\n                        if !check.ok || !check.is_dir {\n                            return sys.Status { ok: false, error: 17 }\n                        }\n                    } else if !pinfo.is_dir {\n                        return sys.Status { ok: false, error: 20 }\n                    }\n                }\n            }\n        }\n        i += 1\n    }\n    sys.Status { ok: true, error: 0 }\n}\n\n@requires(filesystem)\npub fn temp_dir(prefix: string) -> sys.TextResult {\n    for b in prefix.bytes() {\n        if b == 0 || b == 47 {\n            return sys.TextResult { ok: false, value: \"\", error: 22 }\n        }\n    }\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        mut base := \"/tmp\"\n        env_p := c_getenv(cstr(\"TMPDIR\"))\n        if usize(env_p) != 0 {\n            dec := decode_cstr(env_p)\n            if dec.ok && dec.value.len > 0 && dec.value.len < 900 {\n                base = dec.value\n            }\n        }\n        while base.len > 1 && base[base.len - 1] == 47 {\n            base = base[0..base.len - 1]\n        }\n        full := f\"{base}/{prefix}XXXXXX\"\n        mut tmpl: []u8 = []\n        perr := c_path(full, &mut tmpl)\n        if perr != 0 { return sys.TextResult { ok: false, value: \"\", error: perr } }\n        created := c_mkdtemp(addr(&mut tmpl[0]))\n        if usize(created) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: read_errno() }\n        }\n        return bytes.decode_range(&tmpl, 0, tmpl.len - 1)\n    }\n    sys.TextResult { ok: false, value: \"\", error: 45 }\n}\n\nfn list_dir_internal(path: string) -> DirEntriesResult {\n    mut raw: []u8 = []\n    perr := c_path(path, &mut raw)\n    if perr != 0 { return DirEntriesResult { ok: false, entries: [], error: perr } }\n    mut names: []string = []\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        darwin := host_is_darwin()\n        if darwin < 0 { return DirEntriesResult { ok: false, entries: [], error: 45 } }\n        mut name_at := 19\n        mut errno_sym := cstr(\"__errno_location\")\n        if darwin == 1 { name_at = 21; errno_sym = cstr(\"__error\") }\n        h := dl.open(ptr(0), 2)\n        if usize(h) == 0 { return DirEntriesResult { ok: false, entries: [], error: 5 } }\n        sym := dl.symbol(h, errno_sym)\n        if usize(sym) == 0 { _ := dl.close(h); return DirEntriesResult { ok: false, entries: [], error: 5 } }\n        errno_fn: extern fn() -> ptr = ffi_fn(sym)\n        errno_ptr := errno_fn()\n        _ := dl.close(h)\n\n        dir := c_opendir(addr(&raw[0]))\n        if usize(dir) == 0 {\n            err := portable_errno(load_i32(errno_ptr), darwin == 1)\n            return DirEntriesResult { ok: false, entries: [], error: err }\n        }\n        mut raw_name: []u8 = []\n        mut read_err := 0\n        while true {\n            store_i32(errno_ptr, 0)\n            entry := c_readdir(dir)\n            if usize(entry) == 0 {\n                e := load_i32(errno_ptr)\n                if e != 0 { read_err = portable_errno(e, darwin == 1) }\n                break\n            }\n            rec_len := i32(load_u16(ptr(usize(entry) + 16)))\n            raw_name.clear()\n            for off in name_at..rec_len {\n                b := load_u8(ptr(usize(entry) + usize(off)))\n                if b == 0 { break }\n                raw_name.push(b)\n            }\n            dec := bytes.decode(&raw_name)\n            if !dec.ok { read_err = 92; break }\n            if dec.value != \"\" && dec.value != \".\" && dec.value != \"..\" {\n                names.push(move dec.value)\n            }\n        }\n        closed := c_closedir(dir)\n        if read_err != 0 { return DirEntriesResult { ok: false, entries: [], error: read_err } }\n        if closed != 0 {\n            return DirEntriesResult { ok: false, entries: [], error: portable_errno(load_i32(errno_ptr), darwin == 1) }\n        }\n    }\n    array.sort_strings(&mut names)\n    DirEntriesResult { ok: true, entries: names, error: 0 }\n}\n\n@requires(filesystem)\npub fn list_dir(path: string) -> DirEntriesResult { list_dir_internal(path) }\n\n@requires(filesystem)\npub fn remove_all(path: string) -> sys.Status {\n    if path.len == 0 || path == \"/\" || path == \".\" || path == \"..\" {\n        return sys.Status { ok: false, error: 22 }\n    }\n    if is_symlink(path) {\n        return sys.remove_file(path)\n    }\n    info := sys.metadata(path)\n    if !info.ok {\n        if info.error == 2 { return sys.Status { ok: true, error: 0 } }\n        return sys.Status { ok: false, error: info.error }\n    }\n    if !info.is_dir {\n        return sys.remove_file(path)\n    }\n    listing := list_dir(path)\n    if !listing.ok { return sys.Status { ok: false, error: listing.error } }\n    mut prefix := path.clone()\n    if prefix[prefix.len - 1] != 47 { prefix += \"/\" }\n    for item in &listing.entries {\n        st := remove_all(prefix + item)\n        if !st.ok { return st }\n    }\n    sys.remove_dir(path)\n}\n" }
    if name == "hash" { return "@test {\n    (\"\") -> 0\n    (\"a\") -> 97\n    hash(\"å\") != hash(\"a\")\n    hash(\"🌍\") == hash(\"🌍\")\n}\npub fn hash(text: string) -> i64 {\n    mut value: i64 = 0\n    for byte in text.bytes() {\n        value = (value * 131 + i64(byte)) % 2147483647\n    }\n    value\n}\n" }
    if name == "http" { return "capability network, unsafe\n\nimport std.bytes as bytes\nimport std.net as net\nimport std.parse as parse\nimport std.text as text\nimport sys\n\npub struct Request {\n    ok: bool,\n    status: i32,\n    method: string,\n    target: string,\n    header_names: []string,\n    header_values: []string,\n    body: []u8,\n    error: string,\n}\n\nstruct Reader {\n    buffer: []u8,\n    offset: i32,\n    deadline: i64,\n    status: i32,\n    error: string,\n}\n\npub opaque struct BodyReader {\n    reader: Reader,\n    remaining: i64,\n    chunked: bool,\n    chunk_remaining: i64,\n    total: i64,\n    maximum: i64,\n    finished: bool,\n    started: bool,\n    expect_continue: bool,\n    valid: bool,\n}\n\npub struct BodyResult { ok: bool, eof: bool, count: i64, status: i32, error: string }\n\n@c_layout\nstruct Timespec { seconds: i64, nanos: i64 }\n\n@extern(\"c\", \"clock_gettime\")\nunsafe fn clock_gettime(clock: i32, result: ptr) -> i32\n@extern(\"c\", \"recv\")\nunsafe fn recv(fd: i32, output: ptr, count: usize, flags: i32) -> i64\n@extern(\"c\", \"__error\")\nunsafe fn macos_errno() -> ptr\n@extern(\"c\", \"__errno_location\")\nunsafe fn linux_errno() -> ptr\n\nfn now_ms() -> i64 {\n    unsafe {\n        mut value: Timespec = zeroed()\n        mut clock := 1\n        if target_is(\"macos\") { clock = 6 }\n        if clock_gettime(clock, addr(&mut value)) != 0 { return sys.now_ms() }\n        value.seconds * 1000 + value.nanos / 1000000\n    }\n}\n\nfn fail(status: i32, message: string) -> Request {\n    Request {\n        ok: false, status: status, method: \"\", target: \"\",\n        header_names: [], header_values: [], body: [], error: message.clone(),\n    }\n}\n\nfn token(value: string) -> bool {\n    if value.len == 0 { return false }\n    for b in value.bytes() {\n        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) { continue }\n        if b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126 { continue }\n        return false\n    }\n    true\n}\n\nfn lower(value: string) -> string {\n    mut out: []u8 = []\n    out.reserve(value.len)\n    for b in value.bytes() {\n        if b >= 65 && b <= 90 { out.push(u8(b + 32)) }\n        else { out.push(u8(b)) }\n    }\n    bytes.decode(&out).value\n}\n\nfn trim_ows(value: string) -> string {\n    mut start := 0\n    mut end := value.len\n    while start < end && (value[start] == 32 || value[start] == 9) { start += 1 }\n    while end > start && (value[end - 1] == 32 || value[end - 1] == 9) { end -= 1 }\n    value[start..end]\n}\n\nfn valid_value(value: string) -> bool {\n    for b in value.bytes() {\n        if (b < 32 && b != 9) || b == 127 { return false }\n    }\n    true\n}\n\nfn singleton(name: string) -> bool {\n    name == \"host\" || name == \"authorization\" || name == \"proxy-authorization\" || name == \"content-length\" || name == \"transfer-encoding\" || name == \"content-type\" || name == \"expect\" || name == \"origin\" || name == \"connection\" || text.starts_with(name, \"x-\")\n}\n\nfn control_trailer(name: string) -> bool {\n    name == \"host\" || name == \"authorization\" || name == \"proxy-authorization\" || name == \"content-length\" || name == \"transfer-encoding\" || name == \"content-type\" || name == \"expect\" || name == \"origin\" || name == \"connection\" || name == \"trailer\" || name == \"te\" || name == \"upgrade\" || name == \"keep-alive\" || name == \"proxy-connection\" || text.starts_with(name, \"x-snus-\")\n}\n\nfn wait_ready(stream: &net.TcpStream, events: i32, deadline: i64) -> bool {\n    mut poll := net.PollSet::new()\n    poll.add(stream.fd(), events)\n    while true {\n        remaining := deadline - now_ms()\n        if remaining <= 0 { return false }\n        mut delay := remaining\n        if delay > 2147483647 { delay = 2147483647 }\n        result := poll.poll(i32(delay))\n        if result.ok { return result.count > 0 }\n        if result.error != 4 { return false }\n    }\n    false\n}\n\nfn fill(stream: &net.TcpStream, reader: &mut Reader, limit: i32) -> bool {\n    if reader.buffer.len >= limit {\n        reader.status = 431\n        reader.error = \"HTTP framing exceeds its limit\"\n        return false\n    }\n    while true {\n        if now_ms() >= reader.deadline {\n            reader.status = 408\n            reader.error = \"request deadline exceeded\"\n            return false\n        }\n        mut amount := limit - reader.buffer.len\n        if amount > 8192 { amount = 8192 }\n        result := stream.read_append(&mut reader.buffer, amount)\n        if result.ok && !result.eof { return true }\n        if result.eof {\n            reader.status = 400\n            reader.error = \"truncated HTTP request\"\n            return false\n        }\n        if !result.would_block && result.error != 4 {\n            reader.status = 400\n            reader.error = \"cannot read HTTP request\"\n            return false\n        }\n        if result.error == 4 { continue }\n        if !wait_ready(&stream, net.poll_in(), reader.deadline) {\n            reader.status = 408\n            reader.error = \"request deadline exceeded\"\n            return false\n        }\n    }\n    false\n}\n\nfn read_line(stream: &net.TcpStream, reader: &mut Reader, maximum: i32, limit: i32) -> sys.TextResult {\n    while true {\n        end := bytes.find_crlf(&reader.buffer, reader.offset, reader.buffer.len)\n        newline := bytes.find_byte(&reader.buffer, reader.offset, reader.buffer.len, b'\\n')\n        if newline >= 0 && (end < 0 || newline != end + 1) {\n            reader.status = 400\n            reader.error = \"HTTP lines require CRLF\"\n            return sys.TextResult { ok: false, value: \"\", error: 22 }\n        }\n        if end >= 0 {\n            if end - reader.offset > maximum || end + 2 > limit {\n                reader.status = 431\n                reader.error = \"HTTP line exceeds its limit\"\n                return sys.TextResult { ok: false, value: \"\", error: 22 }\n            }\n            result := bytes.decode_range(&reader.buffer, reader.offset, end)\n            reader.offset = end + 2\n            if !result.ok {\n                reader.status = 400\n                reader.error = \"invalid UTF-8 in HTTP head\"\n            }\n            return result\n        }\n        if reader.buffer.len - reader.offset > maximum + 1 {\n            reader.status = 431\n            reader.error = \"HTTP line exceeds its limit\"\n            return sys.TextResult { ok: false, value: \"\", error: 22 }\n        }\n        if !fill(&stream, &mut reader, limit) {\n            return sys.TextResult { ok: false, value: \"\", error: 22 }\n        }\n    }\n    sys.TextResult { ok: false, value: \"\", error: 22 }\n}\n\nstruct HeaderPart { ok: bool, name: string, value: string }\n\nfn header_parts(line: string) -> HeaderPart {\n    colon := text.find(line, \":\")\n    if colon <= 0 { return HeaderPart { ok: false, name: \"\", value: \"\" } }\n    name := lower(line[0..colon])\n    value := trim_ows(line[colon + 1..line.len])\n    if !token(name) || !valid_value(value) { return HeaderPart { ok: false, name: \"\", value: \"\" } }\n    HeaderPart { ok: true, name: name, value: value }\n}\n\nfn append_header(req: &mut Request, line: string) -> bool {\n    part := header_parts(line)\n    if !part.ok { return false }\n    if singleton(part.name) {\n        for previous in &req.header_names { if previous == part.name { return false } }\n    }\n    req.header_names.push(move part.name)\n    req.header_values.push(move part.value)\n    true\n}\n\npub fn header(req: &Request, name: string) -> string {\n    wanted := lower(name)\n    for i in 0..req.header_names.len {\n        if req.header_names[i] == wanted { return req.header_values[i].clone() }\n    }\n    \"\"\n}\n\nfn has_header(req: &Request, name: string) -> bool {\n    for current in &req.header_names { if current == name { return true } }\n    false\n}\n\nfn decimal(value: string, maximum: i64) -> i64 {\n    if value.len == 0 || value.len > 20 { return -1 }\n    number := parse.u64_range(value, 0, value.len)\n    if !number.ok { return -1 }\n    if number.value > u64(maximum) { return -2 }\n    i64(number.value)\n}\n\nfn chunk_size(value: string, maximum: i64) -> i64 {\n    semicolon := text.find(value, \";\")\n    mut end := value.len\n    if semicolon >= 0 { end = semicolon }\n    if end == 0 || end > 16 || !valid_value(value) { return -1 }\n    number := parse.hex_u64_range(value, 0, end)\n    if !number.ok { return -1 }\n    if number.value > u64(maximum) { return -2 }\n    i64(number.value)\n}\n\nfn read_exact(stream: &net.TcpStream, reader: &mut Reader, out: &mut []u8, count: i32) -> bool {\n    mut left := count\n    while left > 0 {\n        if reader.offset == reader.buffer.len {\n            reader.buffer.clear()\n            reader.offset = 0\n            if !fill(&stream, &mut reader, left) { return false }\n        }\n        mut amount := reader.buffer.len - reader.offset\n        if amount > left { amount = left }\n        bytes.extend_range(&mut out, &reader.buffer, reader.offset, reader.offset + amount)\n        reader.offset += amount\n        left -= amount\n    }\n    true\n}\n\nfn parse_head(stream: &net.TcpStream, reader: &mut Reader, max_body: i64) -> Request {\n    first := read_line(&stream, &mut reader, 8192, 32768)\n    if !first.ok { return fail(reader.status, reader.error) }\n    mut parts := text.split(first.value, \" \")\n    if parts.len != 3 { return fail(400, \"invalid HTTP request line\") }\n    version := parts.pop()\n    target := parts.pop()\n    method := parts.pop()\n    if !token(method) || (version != \"HTTP/1.0\" && version != \"HTTP/1.1\") { return fail(400, \"invalid HTTP request line\") }\n    if !text.starts_with(target, \"/\") { return fail(400, \"HTTP target requires origin form\") }\n    for b in target.bytes() {\n        if b <= 32 || b == 127 || b == 35 || b == 92 { return fail(400, \"invalid HTTP request target\") }\n    }\n    mut req := Request {\n        ok: true, status: 200, method: method, target: target,\n        header_names: [], header_values: [], body: [], error: \"\",\n    }\n    while true {\n        line := read_line(&stream, &mut reader, 8192, 32768)\n        if !line.ok { return fail(reader.status, reader.error) }\n        if line.value.len == 0 { break }\n        if req.header_names.len >= 100 { return fail(431, \"too many HTTP headers\") }\n        if !append_header(&mut req, line.value) { return fail(400, \"invalid or duplicate HTTP header\") }\n    }\n    if version == \"HTTP/1.1\" && header(&req, \"host\").len == 0 { return fail(400, \"Host required\") }\n    transfer := lower(header(&req, \"transfer-encoding\"))\n    has_transfer := has_header(&req, \"transfer-encoding\")\n    has_length := has_header(&req, \"content-length\")\n    if has_transfer && (transfer != \"chunked\" || has_length) { return fail(400, \"ambiguous or unsupported HTTP body framing\") }\n    mut size: i64 = 0\n    if has_length {\n        size = decimal(header(&req, \"content-length\"), max_body)\n        if size == -1 { return fail(400, \"invalid Content-Length\") }\n        if size == -2 { return fail(413, \"request body exceeds its limit\") }\n    }\n    if has_header(&req, \"expect\") {\n        if lower(header(&req, \"expect\")) != \"100-continue\" { return fail(417, \"unsupported Expect header\") }\n    }\n    req\n}\n\nfn compact(reader: &mut Reader) {\n    if reader.offset > 0 {\n        count := reader.offset\n        bytes.consume_prefix(&mut reader.buffer, count)\n        reader.offset = 0\n    }\n}\n\nfn body_result(ok: bool, eof: bool, count: i64, status: i32, error: string) -> BodyResult {\n    BodyResult { ok: ok, eof: eof, count: count, status: status, error: error.clone() }\n}\n\nimpl BodyReader {\n    pub fn new(head: &Request, max_bytes: i64, timeout_ms: i64) -> Self {\n        mut value := Self {\n            reader: Reader { buffer: [], offset: 0, deadline: 0, status: 200, error: \"\" },\n            remaining: 0, chunked: false, chunk_remaining: 0, total: 0, maximum: max_bytes,\n            finished: false, started: false, expect_continue: false, valid: true,\n        }\n        if max_bytes < 0 || timeout_ms <= 0 || timeout_ms > 3600000 {\n            value.reject(500, \"invalid HTTP reader limits\"); return value\n        }\n        value.reader.deadline = now_ms() + timeout_ms\n        if !head.ok { value.reject(head.status, head.error); return value }\n        if head.body.len != 0 || head.header_names.len != head.header_values.len {\n            value.reject(500, \"BodyReader requires an unconsumed request head\"); return value\n        }\n        value.chunked = has_header(&head, \"transfer-encoding\")\n        has_length := has_header(&head, \"content-length\")\n        if value.chunked && (lower(header(&head, \"transfer-encoding\")) != \"chunked\" || has_length) {\n            value.reject(400, \"ambiguous or unsupported HTTP body framing\"); return value\n        }\n        if has_length {\n            size := decimal(header(&head, \"content-length\"), max_bytes)\n            if size == -1 { value.reject(400, \"invalid Content-Length\"); return value }\n            if size == -2 { value.reject(413, \"request body exceeds its limit\"); return value }\n            value.remaining = size\n        }\n        if has_header(&head, \"expect\") {\n            if lower(header(&head, \"expect\")) != \"100-continue\" {\n                value.reject(417, \"unsupported Expect header\"); return value\n            }\n            value.expect_continue = true\n        }\n        value\n    }\n\n    pub fn ok(&self) -> bool { self.valid }\n    pub fn status(&self) -> i32 { self.reader.status }\n    pub fn error(&self) -> string { self.reader.error.clone() }\n    pub fn count(&self) -> i64 { self.total }\n\n    fn reject(&mut self, status: i32, message: string) {\n        self.valid = false\n        self.reader.status = status\n        self.reader.error = message.clone()\n    }\n\n    fn failed(&mut self) -> BodyResult {\n        self.valid = false\n        body_result(false, false, 0, self.reader.status, self.reader.error)\n    }\n\n    fn finish_trailers(&mut self, stream: &net.TcpStream) -> bool {\n        mut trailer_bytes := 0; mut trailer_count := 0\n        while true {\n            compact(&mut self.reader)\n            trailer := read_line(&stream, &mut self.reader, 8192, 8194)\n            if !trailer.ok { return false }\n            trailer_bytes += trailer.value.len + 2\n            if trailer_bytes > 8192 { self.reject(431, \"HTTP trailers exceed their limit\"); return false }\n            if trailer.value.len == 0 { self.finished = true; return true }\n            trailer_count += 1\n            if trailer_count > 20 { self.reject(431, \"too many HTTP trailers\"); return false }\n            part := header_parts(trailer.value)\n            if !part.ok { self.reject(400, \"invalid HTTP trailer\"); return false }\n            if control_trailer(part.name) { self.reject(400, \"HTTP control trailer refused\"); return false }\n        }\n        false\n    }\n\n    pub fn read(&mut self, stream: &net.TcpStream, chunk: &mut []u8, max_chunk: i32) -> BodyResult {\n        chunk.clear()\n        if !self.valid { return self.failed() }\n        if max_chunk < 1 || max_chunk > 1048576 { self.reject(500, \"invalid HTTP chunk buffer limit\"); return self.failed() }\n        if self.finished { return body_result(true, true, 0, 200, \"\") }\n        if !stream.set_nonblocking(true).ok { self.reject(500, \"cannot configure HTTP stream\"); return self.failed() }\n        if !self.started {\n            self.started = true\n            if self.expect_continue {\n                mut interim: []u8 = []\n                bytes.append_utf8(&mut interim, \"HTTP/1.1 100 Continue\\r\\n\\r\\n\")\n                remaining := self.reader.deadline - now_ms()\n                if remaining <= 0 || !write_all(&stream, &interim, remaining) {\n                    self.reject(408, \"cannot send HTTP continue\"); return self.failed()\n                }\n            }\n        }\n        if now_ms() >= self.reader.deadline { self.reject(408, \"request deadline exceeded\"); return self.failed() }\n        if self.chunked && self.chunk_remaining == 0 {\n            compact(&mut self.reader)\n            line := read_line(&stream, &mut self.reader, 1024, 1026)\n            if !line.ok { return self.failed() }\n            size := chunk_size(line.value, self.maximum - self.total)\n            if size == -1 { self.reject(400, \"invalid HTTP chunk size\"); return self.failed() }\n            if size == -2 { self.reject(413, \"request body exceeds its limit\"); return self.failed() }\n            if size == 0 {\n                if !self.finish_trailers(&stream) { return self.failed() }\n                return body_result(true, true, 0, 200, \"\")\n            }\n            self.chunk_remaining = size\n        }\n        mut amount := self.remaining\n        if self.chunked { amount = self.chunk_remaining }\n        if amount == 0 { self.finished = true; return body_result(true, true, 0, 200, \"\") }\n        if amount > i64(max_chunk) { amount = i64(max_chunk) }\n        if !read_exact(&stream, &mut self.reader, &mut chunk, i32(amount)) { chunk.clear(); return self.failed() }\n        self.total += amount\n        if self.chunked {\n            self.chunk_remaining -= amount\n            if self.chunk_remaining == 0 {\n                mut ending: []u8 = []\n                if !read_exact(&stream, &mut self.reader, &mut ending, 2) { chunk.clear(); return self.failed() }\n                if ending.len != 2 || ending[0] != b'\\r' || ending[1] != b'\\n' {\n                    chunk.clear(); self.reject(400, \"invalid HTTP chunk ending\"); return self.failed()\n                }\n            }\n        } else { self.remaining -= amount }\n        body_result(true, false, amount, 200, \"\")\n    }\n}\n\npub fn read_body(stream: &net.TcpStream, move head: Request, max_body: i32, timeout_ms: i64) -> Request {\n    if max_body < 0 || max_body > 67108864 { return fail(500, \"invalid HTTP reader limits\") }\n    if !head.ok { return head }\n    mut reader := BodyReader::new(&head, i64(max_body), timeout_ms)\n    if !reader.ok() { return fail(reader.status(), reader.error()) }\n    mut req := head\n    mut chunk: []u8 = []\n    while true {\n        result := reader.read(&stream, &mut chunk, 65536)\n        if !result.ok { return fail(result.status, result.error) }\n        if result.eof { return req }\n        bytes.extend(&mut req.body, &chunk)\n    }\n    req\n}\n\npub fn read_request(stream: &net.TcpStream, max_body: i32, timeout_ms: i64) -> Request {\n    if max_body < 0 || max_body > 67108864 || timeout_ms <= 0 || timeout_ms > 3600000 { return fail(500, \"invalid HTTP reader limits\") }\n    deadline := now_ms() + timeout_ms\n    head := read_head(&stream, timeout_ms)\n    if !head.ok { return head }\n    remaining := deadline - now_ms()\n    if remaining <= 0 { return fail(408, \"request deadline exceeded\") }\n    read_body(&stream, move head, max_body, remaining)\n}\n\nfn socket_errno() -> i32 {\n    unsafe {\n        if target_is(\"macos\") { return load_i32(macos_errno()) }\n        else { return load_i32(linux_errno()) }\n    }\n    0\n}\n\nfn partial_head_status(buffer: &[]u8) -> i32 {\n    mut start := 0\n    for i in 0..buffer.len {\n        if buffer[i] == b'\\n' {\n            if i == 0 || buffer[i - 1] != b'\\r' { return 400 }\n            if i - 1 - start > 8192 { return 431 }\n            start = i + 1\n        } else if buffer[i] == b'\\r' && i + 1 < buffer.len && buffer[i + 1] != b'\\n' { return 400 }\n    }\n    remaining := buffer.len - start\n    if remaining > 8192 {\n        if remaining != 8193 || buffer[buffer.len - 1] != b'\\r' { return 431 }\n    }\n    0\n}\n\nfn read_head_wire(stream: &net.TcpStream, reader: &mut Reader) -> bool {\n    mut peek: []u8 = []\n    bytes.pad(&mut peek, 8192)\n    while true {\n        if now_ms() >= reader.deadline {\n            reader.status = 408\n            reader.error = \"request deadline exceeded\"\n            return false\n        }\n        mut count: i64 = 0\n        unsafe { count = recv(stream.fd(), addr(&mut peek[0]), usize(peek.len), 2) }\n        if count == 0 {\n            reader.status = 400\n            reader.error = \"truncated HTTP request\"\n            return false\n        }\n        if count < 0 {\n            error := socket_errno()\n            if error == 4 { continue }\n            if error != 11 && error != 35 {\n                reader.status = 400\n                reader.error = \"cannot read HTTP request\"\n                return false\n            }\n            if !wait_ready(&stream, net.poll_in(), reader.deadline) {\n                reader.status = 408\n                reader.error = \"request deadline exceeded\"\n                return false\n            }\n            continue\n        }\n        mut start := reader.buffer.len - 3\n        if start < 0 { start = 0 }\n        suffix := reader.buffer.len - start\n        mut scan: []u8 = []\n        bytes.extend_range(&mut scan, &reader.buffer, start, reader.buffer.len)\n        bytes.extend_range(&mut scan, &peek, 0, i32(count))\n        boundary := bytes.find_double_crlf(&scan, 0, scan.len)\n        mut amount := i32(count)\n        if boundary >= 0 { amount = boundary + 4 - suffix }\n        if reader.buffer.len + amount > 32768 {\n            reader.status = 431\n            reader.error = \"HTTP headers exceed their limit\"\n            return false\n        }\n        mut left := amount\n        while left > 0 {\n            result := stream.read_append(&mut reader.buffer, left)\n            if !result.ok || result.eof {\n                reader.status = 400\n                reader.error = \"cannot consume HTTP head\"\n                return false\n            }\n            left -= i32(result.count)\n        }\n        partial_status := partial_head_status(&reader.buffer)\n        if partial_status != 0 {\n            reader.status = partial_status\n            reader.error = \"invalid or oversized HTTP head line\"\n            return false\n        }\n        if boundary >= 0 { return true }\n        if reader.buffer.len >= 32768 {\n            reader.status = 431\n            reader.error = \"HTTP headers exceed their limit\"\n            return false\n        }\n    }\n    false\n}\n\npub fn read_head(stream: &net.TcpStream, timeout_ms: i64) -> Request {\n    if timeout_ms <= 0 || timeout_ms > 3600000 { return fail(500, \"invalid HTTP reader limits\") }\n    if !stream.set_nonblocking(true).ok { return fail(500, \"cannot configure HTTP stream\") }\n    mut reader := Reader { buffer: [], offset: 0, deadline: now_ms() + timeout_ms, status: 400, error: \"invalid HTTP request\" }\n    if !read_head_wire(&stream, &mut reader) { return fail(reader.status, reader.error) }\n    parse_head(&stream, &mut reader, 9223372036854775807)\n}\n\npub fn write_all(stream: &net.TcpStream, data: &[]u8, timeout_ms: i64) -> bool {\n    if timeout_ms <= 0 || timeout_ms > 3600000 { return false }\n    if !stream.set_nonblocking(true).ok { return false }\n    deadline := now_ms() + timeout_ms\n    mut offset := 0\n    while offset < data.len {\n        if now_ms() >= deadline { return false }\n        result := stream.write_range(&data, offset, data.len - offset)\n        if result.ok {\n            if result.count <= 0 { return false }\n            offset += i32(result.count)\n        } else if result.error == 4 {\n            continue\n        } else if result.would_block {\n            if !wait_ready(&stream, net.poll_out(), deadline) { return false }\n        } else { return false }\n    }\n    true\n}\n\nfn reason(status: i32) -> string {\n    if status == 200 { return \"OK\" }\n    if status == 201 { return \"Created\" }\n    if status == 204 { return \"No Content\" }\n    if status == 301 { return \"Moved Permanently\" }\n    if status == 302 { return \"Found\" }\n    if status == 304 { return \"Not Modified\" }\n    if status == 400 { return \"Bad Request\" }\n    if status == 401 { return \"Unauthorized\" }\n    if status == 403 { return \"Forbidden\" }\n    if status == 404 { return \"Not Found\" }\n    if status == 405 { return \"Method Not Allowed\" }\n    if status == 408 { return \"Request Timeout\" }\n    if status == 409 { return \"Conflict\" }\n    if status == 413 { return \"Content Too Large\" }\n    if status == 417 { return \"Expectation Failed\" }\n    if status == 429 { return \"Too Many Requests\" }\n    if status == 431 { return \"Request Header Fields Too Large\" }\n    if status == 500 { return \"Internal Server Error\" }\n    if status == 502 { return \"Bad Gateway\" }\n    if status == 503 { return \"Service Unavailable\" }\n    \"Response\"\n}\n\npub fn write_response(stream: &net.TcpStream, status: i32, content_type: string, extra_names: &[]string, extra_values: &[]string, body: &[]u8, head: bool) -> bool {\n    if status < 100 || status > 599 || extra_names.len != extra_values.len || !valid_value(content_type) { return false }\n    mut output: []u8 = []\n    bytes.append_utf8(&mut output, f\"HTTP/1.1 {status} {reason(status)}\\r\\nConnection: close\\r\\n\")\n    if content_type.len > 0 { bytes.append_utf8(&mut output, f\"Content-Type: {content_type}\\r\\n\") }\n    mut length := body.len\n    if status < 200 || status == 204 || status == 205 || status == 304 { length = 0 }\n    if status >= 200 && status != 204 && status != 304 {\n        bytes.append_utf8(&mut output, f\"Content-Length: {length}\\r\\n\")\n    }\n    for i in 0..extra_names.len {\n        name := lower(extra_names[i])\n        if !token(name) || !valid_value(extra_values[i]) || name == \"content-length\" || name == \"transfer-encoding\" || name == \"connection\" || name == \"content-type\" { return false }\n        bytes.append_utf8(&mut output, f\"{extra_names[i]}: {extra_values[i]}\\r\\n\")\n    }\n    bytes.append_utf8(&mut output, \"\\r\\n\")\n    if !head && length > 0 { bytes.extend(&mut output, &body) }\n    write_all(&stream, &output, 30000)\n}\n" }
    if name == "http_client" { return "capability unsafe, network\nimport std.bytes as bytes\nimport std.text as text\n\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_global_init\")\nunsafe fn mac_global_init(flags: i64) -> i32\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_global_cleanup\")\nunsafe fn mac_global_cleanup()\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_init\")\nunsafe fn mac_easy_init() -> ptr\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_cleanup\")\nunsafe fn mac_easy_cleanup(easy: ptr)\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_perform\")\nunsafe fn mac_easy_perform(easy: ptr) -> i32\n@c_variadic(2)\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_setopt\")\nunsafe fn mac_setopt_long(easy: ptr, option: i32, value: i64) -> i32\n@c_variadic(2)\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_setopt\")\nunsafe fn mac_setopt_ptr(easy: ptr, option: i32, value: ptr) -> i32\n@c_variadic(2)\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_setopt\")\nunsafe fn mac_setopt_write(easy: ptr, option: i32, value: extern fn(ptr, usize, usize, ptr) -> usize) -> i32\n@c_variadic(2)\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_setopt\")\nunsafe fn mac_setopt_progress(easy: ptr, option: i32, value: extern fn(ptr, i64, i64, i64, i64) -> i32) -> i32\n@c_variadic(2)\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_getinfo\")\nunsafe fn mac_getinfo(easy: ptr, info: i32, output: ptr) -> i32\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_slist_append\")\nunsafe fn mac_slist_append(list: ptr, value: ptr) -> ptr\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_slist_free_all\")\nunsafe fn mac_slist_free(list: ptr)\n@extern(\"/usr/lib/libcurl.dylib\", \"curl_easy_strerror\")\nunsafe fn mac_strerror(code: i32) -> ptr\n\n@extern(\"libcurl.so.4\", \"curl_global_init\")\nunsafe fn linux_global_init(flags: i64) -> i32\n@extern(\"libcurl.so.4\", \"curl_global_cleanup\")\nunsafe fn linux_global_cleanup()\n@extern(\"libcurl.so.4\", \"curl_easy_init\")\nunsafe fn linux_easy_init() -> ptr\n@extern(\"libcurl.so.4\", \"curl_easy_cleanup\")\nunsafe fn linux_easy_cleanup(easy: ptr)\n@extern(\"libcurl.so.4\", \"curl_easy_perform\")\nunsafe fn linux_easy_perform(easy: ptr) -> i32\n@c_variadic(2)\n@extern(\"libcurl.so.4\", \"curl_easy_setopt\")\nunsafe fn linux_setopt_long(easy: ptr, option: i32, value: i64) -> i32\n@c_variadic(2)\n@extern(\"libcurl.so.4\", \"curl_easy_setopt\")\nunsafe fn linux_setopt_ptr(easy: ptr, option: i32, value: ptr) -> i32\n@c_variadic(2)\n@extern(\"libcurl.so.4\", \"curl_easy_setopt\")\nunsafe fn linux_setopt_write(easy: ptr, option: i32, value: extern fn(ptr, usize, usize, ptr) -> usize) -> i32\n@c_variadic(2)\n@extern(\"libcurl.so.4\", \"curl_easy_setopt\")\nunsafe fn linux_setopt_progress(easy: ptr, option: i32, value: extern fn(ptr, i64, i64, i64, i64) -> i32) -> i32\n@c_variadic(2)\n@extern(\"libcurl.so.4\", \"curl_easy_getinfo\")\nunsafe fn linux_getinfo(easy: ptr, info: i32, output: ptr) -> i32\n@extern(\"libcurl.so.4\", \"curl_slist_append\")\nunsafe fn linux_slist_append(list: ptr, value: ptr) -> ptr\n@extern(\"libcurl.so.4\", \"curl_slist_free_all\")\nunsafe fn linux_slist_free(list: ptr)\n@extern(\"libcurl.so.4\", \"curl_easy_strerror\")\nunsafe fn linux_strerror(code: i32) -> ptr\n\npub struct Response {\n    ok: bool,\n    status: i32,\n    transport_code: i32,\n    body: []u8,\n    error: string,\n}\n\nstruct Receiver {\n    body: []u8,\n    max_bytes: i64,\n    limited: bool,\n    monitor: fn(ptr) -> bool,\n    context: ptr,\n    cancelled: bool,\n    declared_limited: bool,\n    head: bool,\n}\n\nfn failure(move message: string) -> Response {\n    Response { ok: false, status: 0, transport_code: 0, body: [], error: message }\n}\n\nfn c_string(value: string) -> []u8 {\n    mut result: []u8 = []\n    bytes.append_utf8(&mut result, value)\n    result.push(0)\n    result\n}\n\nunsafe fn copy_c_string(value: ptr) -> string {\n    if usize(value) == 0 { return \"HTTP transport failure\" }\n    mut result: []u8 = []\n    for i in 0..256 {\n        byte := load_u8(ptr(usize(value) + usize(i)))\n        if byte == 0 { return bytes.decode(&result).value }\n        result.push(byte)\n    }\n    \"HTTP transport failure\"\n}\n\nfn token(value: string) -> bool {\n    if value.len == 0 { return false }\n    for byte in value.bytes() {\n        if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) { continue }\n        if byte == 33 || byte == 35 || byte == 36 || byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43 || byte == 45 || byte == 46 || byte == 94 || byte == 95 || byte == 96 || byte == 124 || byte == 126 { continue }\n        return false\n    }\n    true\n}\n\nfn valid_url(url: string) -> bool {\n    mut authority := 0\n    if text.starts_with(url, \"http://\") { authority = 7 }\n    else if text.starts_with(url, \"https://\") { authority = 8 }\n    else { return false }\n    if url.len <= authority || url.len > 16384 { return false }\n    mut host_end := url.len\n    for i in authority..url.len {\n        if url[i] == 47 || url[i] == 63 { host_end = i; break }\n    }\n    if host_end == authority { return false }\n    for i in 0..url.len {\n        byte := url[i]\n        if byte <= 32 || byte == 127 || byte == 92 || byte == 35 { return false }\n        if i < host_end && byte == 64 { return false }\n    }\n    true\n}\n\nunsafe fn receive_into(receiver: &mut Receiver, data: ptr, count: usize) -> usize {\n    if count > usize(2147483647) || i64(count) > receiver.max_bytes - i64(receiver.body.len) {\n        receiver.limited = true\n        return 0\n    }\n    receiver.body.reserve(receiver.body.len + i32(count))\n    for i in 0..i32(count) {\n        receiver.body.push(load_u8(ptr(usize(data) + usize(i))))\n    }\n    count\n}\n\nunsafe fn receive(data: ptr, size: usize, count: usize, context: ptr) -> usize {\n    if size > usize(2147483647) || (size != 0 && count > usize(2147483647) / size) { return 0 }\n    receive_into(ref_at(context), data, size * count)\n}\n\nunsafe fn receive_header_into(receiver: &mut Receiver, data: ptr, count: usize) -> usize {\n    if receiver.head || count > 16384 { return count }\n    mut line: []u8 = []\n    for i in 0..i32(count) { line.push(load_u8(ptr(usize(data) + usize(i)))) }\n    if line.len < 15 || !bytes.equals_ascii_ci(&line, 0, 15, \"content-length:\") { return count }\n    mut start := 15\n    while start < line.len && (line[start] == 32 || line[start] == 9) { start += 1 }\n    mut size: i64 = 0\n    while start < line.len && line[start] >= 48 && line[start] <= 57 {\n        digit := i64(line[start] - 48)\n        if size > (receiver.max_bytes - digit) / 10 || size * 10 + digit > receiver.max_bytes {\n            receiver.declared_limited = true\n            return 0\n        }\n        size = size * 10 + digit\n        start += 1\n    }\n    count\n}\n\nunsafe fn receive_header(data: ptr, size: usize, count: usize, context: ptr) -> usize {\n    if size > usize(2147483647) || (size != 0 && count > usize(2147483647) / size) { return 0 }\n    receive_header_into(ref_at(context), data, size * count)\n}\n\nfn always_continue(context: ptr) -> bool { true }\n\nfn continue_transfer(receiver: &mut Receiver) -> i32 {\n    monitor := receiver.monitor\n    if !monitor(receiver.context) { receiver.cancelled = true; return 1 }\n    0\n}\n\nunsafe fn progress(context: ptr, download_total: i64, download_now: i64,\n                   upload_total: i64, upload_now: i64) -> i32 {\n    continue_transfer(ref_at(context))\n}\n\nunsafe fn global_init() -> i32 {\n    if target_is(\"macos\") { return mac_global_init(3) }\n    if target_is(\"linux\") { return linux_global_init(3) }\n    4\n}\n\nunsafe fn global_cleanup() {\n    if target_is(\"macos\") { mac_global_cleanup() }\n    else if target_is(\"linux\") { linux_global_cleanup() }\n}\n\nunsafe fn easy_init() -> ptr {\n    if target_is(\"macos\") { return mac_easy_init() }\n    if target_is(\"linux\") { return linux_easy_init() }\n    ptr(0)\n}\n\nunsafe fn easy_cleanup(easy: ptr) {\n    if target_is(\"macos\") { mac_easy_cleanup(easy) }\n    else if target_is(\"linux\") { linux_easy_cleanup(easy) }\n}\n\nunsafe fn set_long(easy: ptr, option: i32, value: i64) -> bool {\n    if target_is(\"macos\") { return mac_setopt_long(easy, option, value) == 0 }\n    if target_is(\"linux\") { return linux_setopt_long(easy, option, value) == 0 }\n    false\n}\n\nunsafe fn set_ptr(easy: ptr, option: i32, value: ptr) -> bool {\n    if target_is(\"macos\") { return mac_setopt_ptr(easy, option, value) == 0 }\n    if target_is(\"linux\") { return linux_setopt_ptr(easy, option, value) == 0 }\n    false\n}\n\nunsafe fn set_writer(easy: ptr) -> bool {\n    if target_is(\"macos\") { return mac_setopt_write(easy, 20011, callback(receive)) == 0 }\n    if target_is(\"linux\") { return linux_setopt_write(easy, 20011, callback(receive)) == 0 }\n    false\n}\n\nunsafe fn set_header_reader(easy: ptr) -> bool {\n    if target_is(\"macos\") { return mac_setopt_write(easy, 20079, callback(receive_header)) == 0 }\n    if target_is(\"linux\") { return linux_setopt_write(easy, 20079, callback(receive_header)) == 0 }\n    false\n}\n\nunsafe fn set_progress(easy: ptr) -> bool {\n    if target_is(\"macos\") { return mac_setopt_progress(easy, 20219, callback(progress)) == 0 }\n    if target_is(\"linux\") { return linux_setopt_progress(easy, 20219, callback(progress)) == 0 }\n    false\n}\n\nunsafe fn slist_append(list: ptr, value: ptr) -> ptr {\n    if target_is(\"macos\") { return mac_slist_append(list, value) }\n    if target_is(\"linux\") { return linux_slist_append(list, value) }\n    ptr(0)\n}\n\nunsafe fn slist_free(list: ptr) {\n    if target_is(\"macos\") { mac_slist_free(list) }\n    else if target_is(\"linux\") { linux_slist_free(list) }\n}\n\nunsafe fn perform(easy: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_easy_perform(easy) }\n    if target_is(\"linux\") { return linux_easy_perform(easy) }\n    4\n}\n\nunsafe fn response_code(easy: ptr) -> i32 {\n    mut value: i64 = 0\n    mut code := 4\n    if target_is(\"macos\") { code = mac_getinfo(easy, 0x200002, addr(&mut value)) }\n    else if target_is(\"linux\") { code = linux_getinfo(easy, 0x200002, addr(&mut value)) }\n    if code != 0 || value < 0 || value > 999 { return 0 }\n    i32(value)\n}\n\nunsafe fn transport_error(code: i32) -> string {\n    if target_is(\"macos\") { return copy_c_string(mac_strerror(code)) }\n    if target_is(\"linux\") { return copy_c_string(linux_strerror(code)) }\n    \"HTTP transport is unavailable on this target\"\n}\n\n@requires(network)\npub fn request(method: string, url: string, header_names: &[]string, header_values: &[]string,\n               body: &[]u8, timeout_ms: i64, max_bytes: i64) -> Response {\n    request_with_ca(method, url, &header_names, &header_values, &body, timeout_ms, max_bytes, \"\")\n}\n\n@requires(network)\npub fn request_with_ca(method: string, url: string, header_names: &[]string, header_values: &[]string,\n                       body: &[]u8, timeout_ms: i64, max_bytes: i64, ca_bundle: string) -> Response {\n    unsafe { request_internal(method, url, &header_names, &header_values, &body,\n        timeout_ms, max_bytes, ca_bundle, always_continue, ptr(0)) }\n}\n\n@requires(network)\npub unsafe fn request_monitored(method: string, url: string, header_names: &[]string,\n                                 header_values: &[]string, body: &[]u8, timeout_ms: i64,\n                                 max_bytes: i64, monitor: fn(ptr) -> bool, context: ptr) -> Response {\n    request_internal(method, url, &header_names, &header_values, &body,\n        timeout_ms, max_bytes, \"\", monitor, context)\n}\n\n@requires(network)\npub unsafe fn request_monitored_with_ca(method: string, url: string, header_names: &[]string,\n                                         header_values: &[]string, body: &[]u8, timeout_ms: i64,\n                                         max_bytes: i64, ca_bundle: string,\n                                         monitor: fn(ptr) -> bool, context: ptr) -> Response {\n    request_internal(method, url, &header_names, &header_values, &body,\n        timeout_ms, max_bytes, ca_bundle, monitor, context)\n}\n\nunsafe fn request_internal(method: string, url: string, header_names: &[]string,\n                           header_values: &[]string, body: &[]u8, timeout_ms: i64,\n                           max_bytes: i64, ca_bundle: string,\n                           monitor: fn(ptr) -> bool, context: ptr) -> Response {\n    if !token(method) || method.len > 32 { return failure(\"invalid HTTP method\") }\n    if !valid_url(url) { return failure(\"expected an HTTP(S) URL without credentials or control bytes\") }\n    if header_names.len != header_values.len || header_names.len > 128 { return failure(\"invalid HTTP headers\") }\n    if timeout_ms < 1 || timeout_ms > 86400000 || max_bytes < 0 || max_bytes > 2147483647 {\n        return failure(\"invalid HTTP deadline or response limit\")\n    }\n    if method == \"HEAD\" && body.len != 0 { return failure(\"HEAD cannot include a request body\") }\n    for byte in ca_bundle.bytes() { if byte == 0 { return failure(\"invalid CA bundle path\") } }\n    mut header_bytes := 0\n    for i in 0..header_names.len {\n        name := &header_names[i]\n        value := &header_values[i]\n        if !token(name) || name.len > 256 || value.len > 8192 { return failure(\"invalid HTTP header\") }\n        for byte in value.bytes() {\n            if (byte < 32 && byte != 9) || byte == 127 { return failure(\"invalid HTTP header value\") }\n        }\n        header_bytes += name.len + value.len + 4\n        if header_bytes > 65536 { return failure(\"HTTP headers exceed their limit\") }\n    }\n    unsafe {\n        initialized := global_init()\n        if initialized != 0 { return failure(transport_error(initialized)) }\n        defer { global_cleanup() }\n        easy := easy_init()\n        if usize(easy) == 0 { return failure(\"cannot allocate HTTP client\") }\n        defer { easy_cleanup(easy) }\n        mut headers := ptr(0)\n        defer { slist_free(headers) }\n        for i in 0..header_names.len {\n            header := c_string(f\"{header_names[i]}: {header_values[i]}\")\n            next := slist_append(headers, addr(&header[0]))\n            if usize(next) == 0 { return failure(\"cannot allocate HTTP headers\") }\n            headers = next\n        }\n        url_bytes := c_string(url)\n        method_bytes := c_string(method)\n        ca_bytes := c_string(ca_bundle)\n        mut receiver := Receiver { body: [], max_bytes: max_bytes, limited: false,\n            monitor: monitor, context: context, cancelled: false,\n            declared_limited: false, head: method == \"HEAD\" }\n        mut configured := set_ptr(easy, 10002, addr(&url_bytes[0]))\n        configured = set_ptr(easy, 10036, addr(&method_bytes[0])) && configured\n        configured = set_ptr(easy, 10023, headers) && configured\n        configured = set_ptr(easy, 10001, addr(&mut receiver)) && configured\n        configured = set_writer(easy) && configured\n        configured = set_header_reader(easy) && configured\n        configured = set_ptr(easy, 10029, addr(&mut receiver)) && configured\n        configured = set_progress(easy) && configured\n        configured = set_ptr(easy, 10057, addr(&mut receiver)) && configured\n        configured = set_long(easy, 43, 0) && configured\n        configured = set_long(easy, 99, 1) && configured\n        configured = set_long(easy, 156, 5000) && configured\n        configured = set_long(easy, 155, timeout_ms) && configured\n        configured = set_long(easy, 52, 0) && configured\n        configured = set_long(easy, 64, 1) && configured\n        configured = set_long(easy, 81, 2) && configured\n        configured = set_long(easy, 181, 3) && configured\n        if ca_bundle.len > 0 { configured = set_ptr(easy, 10065, addr(&ca_bytes[0])) && configured }\n        if method == \"HEAD\" { configured = set_long(easy, 44, 1) && configured }\n        else if body.len > 0 || method == \"POST\" || method == \"PUT\" || method == \"PATCH\" {\n            mut data := cstr(\"\")\n            if body.len > 0 { data = addr(&body[0]) }\n            configured = set_ptr(easy, 10015, data) && configured\n            configured = set_long(easy, 30120, i64(body.len)) && configured\n        }\n        if !configured { return failure(\"cannot configure HTTP client\") }\n        code := perform(easy)\n        status := response_code(easy)\n        if receiver.cancelled {\n            return Response { ok: false, status: status, transport_code: code, body: receiver.body, error: \"HTTP request cancelled\" }\n        }\n        if receiver.declared_limited {\n            return Response { ok: false, status: status, transport_code: code, body: receiver.body, error: \"declared HTTP response exceeds size limit\" }\n        }\n        if receiver.limited {\n            return Response { ok: false, status: status, transport_code: code, body: receiver.body, error: \"HTTP response exceeds its byte limit\" }\n        }\n        if code != 0 {\n            return Response { ok: false, status: status, transport_code: code, body: receiver.body, error: transport_error(code) }\n        }\n        Response { ok: true, status: status, transport_code: 0, body: receiver.body, error: \"\" }\n    }\n}\n" }
    if name == "json" { return "import std.bytes as bytes\nimport std.parse as parse\n\npub enum Kind {\n    Invalid = 0,\n    Null = 1,\n    Bool = 2,\n    Number = 3,\n    String = 4,\n    Array = 5,\n    Object = 6,\n}\n\npub struct Doc {\n    ok: bool,\n    error: string,\n    offset: i32,\n    root: i32,\n    input: []u8,\n    kinds: []u8,\n    starts: []i32,\n    ends: []i32,\n    escaped: []bool,\n    first_child: []i32,\n    next_sibling: []i32,\n    key_starts: []i32,\n    key_ends: []i32,\n    key_escaped: []bool,\n    counts: []i32,\n}\n\npub struct BoolField { ok: bool, value: bool }\npub struct IntField { ok: bool, value: i64 }\npub struct UintField { ok: bool, value: u64 }\npub struct FloatField { ok: bool, value: f64 }\npub struct StrField { ok: bool, value: string }\n\npub fn write_str(out: &mut []u8, value: string) {\n    hex := \"0123456789abcdef\"\n    out.reserve(out.len + value.len + 2)\n    out.push(b'\"')\n    for b in value.bytes() {\n        if b == 34 { out.push(b'\\\\'); out.push(b'\"') }\n        else if b == 92 { out.push(b'\\\\'); out.push(b'\\\\') }\n        else if b == 8 { out.push(b'\\\\'); out.push(b'b') }\n        else if b == 12 { out.push(b'\\\\'); out.push(b'f') }\n        else if b == 10 { out.push(b'\\\\'); out.push(b'n') }\n        else if b == 13 { out.push(b'\\\\'); out.push(b'r') }\n        else if b == 9 { out.push(b'\\\\'); out.push(b't') }\n        else if b < 32 {\n            bytes.append_utf8(&mut out, \"\\\\u00\")\n            out.push(u8(hex[b / 16]))\n            out.push(u8(hex[b % 16]))\n        } else {\n            out.push(u8(b))\n        }\n    }\n    out.push(b'\"')\n}\n\npub fn quote(value: string) -> string {\n    mut out: []u8 = []\n    write_str(&mut out, value)\n    bytes.decode(&out).value\n}\n\npub fn write_i64(out: &mut []u8, value: i64) { bytes.append_decimal(&mut out, value) }\n\npub fn write_u64(out: &mut []u8, value: u64) {\n    if value == 0 { out.push(b'0'); return }\n    start := out.len\n    mut v := value\n    while v > 0 {\n        d := i32(v % 10)\n        out.push(u8(48 + d))\n        v /= 10\n    }\n    mut left := start\n    mut right := out.len - 1\n    while left < right {\n        out.swap(left, right)\n        left += 1\n        right -= 1\n    }\n}\n\npub fn write_bool(out: &mut []u8, value: bool) {\n    if value { bytes.append_utf8(&mut out, \"true\") }\n    else { bytes.append_utf8(&mut out, \"false\") }\n}\n\npub fn write_f64(out: &mut []u8, value: f64) -> bool {\n    if !value.is_finite() { return false }\n    bytes.append_utf8(&mut out, value.str())\n    true\n}\n\npub fn write_null(out: &mut []u8) { bytes.append_utf8(&mut out, \"null\") }\n\nfn sep_key(out: &mut []u8, first: &mut bool, key: string) {\n    if !first { out.push(b',') }\n    first = false\n    write_str(&mut out, key)\n    out.push(b':')\n}\n\npub fn sep_elem(out: &mut []u8, first: &mut bool) {\n    if !first { out.push(b',') }\n    first = false\n}\n\npub fn begin_obj(out: &mut []u8) -> bool { out.push(b'{'); true }\npub fn end_obj(out: &mut []u8) { out.push(b'}') }\npub fn begin_arr(out: &mut []u8) -> bool { out.push(b'['); true }\npub fn end_arr(out: &mut []u8) { out.push(b']') }\n\npub fn field_str(out: &mut []u8, first: &mut bool, key: string, value: string) {\n    sep_key(&mut out, &mut first, key); write_str(&mut out, value)\n}\npub fn field_i64(out: &mut []u8, first: &mut bool, key: string, value: i64) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, value)\n}\npub fn field_i32(out: &mut []u8, first: &mut bool, key: string, value: i32) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, i64(value))\n}\npub fn field_u64(out: &mut []u8, first: &mut bool, key: string, value: u64) {\n    sep_key(&mut out, &mut first, key); write_u64(&mut out, value)\n}\npub fn field_f64(out: &mut []u8, first: &mut bool, key: string, value: f64) -> bool {\n    if !value.is_finite() { return false }\n    sep_key(&mut out, &mut first, key)\n    write_f64(&mut out, value)\n}\npub fn field_bool(out: &mut []u8, first: &mut bool, key: string, value: bool) {\n    sep_key(&mut out, &mut first, key); write_bool(&mut out, value)\n}\npub fn field_null(out: &mut []u8, first: &mut bool, key: string) {\n    sep_key(&mut out, &mut first, key); write_null(&mut out)\n}\npub fn begin_field_obj(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_obj(&mut out)\n}\npub fn begin_field_arr(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_arr(&mut out)\n}\n\npub fn finish_text(out: &[]u8) -> string { bytes.decode(&out).value }\n\nenum WriteState { Root, Done, ArrayFirst, ArrayMore, ObjectFirst, ObjectMore, ObjectValue }\n\npub struct Writer {\n    output: []u8,\n    stack: []WriteState,\n    failed: bool,\n}\n\nimpl Writer {\n    pub fn new() -> Self { Self { output: [], stack: [.Root], failed: false } }\n\n    fn start_value(&mut self) -> bool {\n        if self.failed { return false }\n        top := self.stack.len - 1\n        state := self.stack[top]\n        match state {\n            .Root => { self.stack[top] = .Done },\n            .ArrayFirst => { self.stack[top] = .ArrayMore },\n            .ArrayMore => { self.output.push(b',') },\n            .ObjectValue => { self.stack[top] = .ObjectMore },\n            _ => { self.failed = true; return false },\n        }\n        true\n    }\n\n    pub fn object(&mut self) {\n        if !self.start_value() { return }\n        self.output.push(b'{')\n        self.stack.push(.ObjectFirst)\n    }\n\n    pub fn array(&mut self) {\n        if !self.start_value() { return }\n        self.output.push(b'[')\n        self.stack.push(.ArrayFirst)\n    }\n\n    pub fn key(&mut self, name: string) {\n        if self.failed { return }\n        top := self.stack.len - 1\n        state := self.stack[top]\n        if state == .ObjectMore {\n            self.output.push(b',')\n        } else if state != .ObjectFirst {\n            self.failed = true\n            return\n        }\n        write_str(&mut self.output, name)\n        self.output.push(b':')\n        self.stack[top] = .ObjectValue\n    }\n\n    pub fn end(&mut self) {\n        if self.failed { return }\n        state := self.stack[self.stack.len - 1]\n        if state == .ObjectFirst || state == .ObjectMore {\n            self.output.push(b'}')\n        } else if state == .ArrayFirst || state == .ArrayMore {\n            self.output.push(b']')\n        } else {\n            self.failed = true\n            return\n        }\n        _ := self.stack.pop()\n    }\n\n    pub fn string(&mut self, value: string) {\n        if self.start_value() { write_str(&mut self.output, value) }\n    }\n\n    pub fn integer(&mut self, value: i64) {\n        if self.start_value() { write_i64(&mut self.output, value) }\n    }\n\n    pub fn unsigned(&mut self, value: u64) {\n        if self.start_value() { write_u64(&mut self.output, value) }\n    }\n\n    pub fn decimal(&mut self, value: f64) {\n        if self.start_value() && !write_f64(&mut self.output, value) { self.failed = true }\n    }\n\n    pub fn boolean(&mut self, value: bool) {\n        if self.start_value() { write_bool(&mut self.output, value) }\n    }\n\n    pub fn null(&mut self) {\n        if self.start_value() { write_null(&mut self.output) }\n    }\n\n    pub fn finish(&self) -> StrField {\n        if self.failed || self.stack.len != 1 || self.stack[0] != .Done {\n            return StrField { ok: false, value: \"\" }\n        }\n        StrField { ok: true, value: finish_text(&self.output) }\n    }\n}\n\nstruct Parser {\n    pos: i32,\n    depth: i32,\n}\n\nfn is_ws(b: u8) -> bool {\n    b == b' ' || b == b'\\t' || b == b'\\n' || b == b'\\r'\n}\n\nfn skip_ws(input: &[]u8, p: &mut Parser) {\n    while p.pos < input.len && is_ws(input[p.pos]) {\n        p.pos += 1\n    }\n}\n\nfn fail_doc(doc: &mut Doc, at: i32, move msg: string) {\n    if doc.ok {\n        doc.ok = false\n        doc.offset = at\n        doc.error = msg\n    }\n}\n\nfn hex_val(b: u8) -> i32 {\n    if b >= b'0' && b <= b'9' { return i32(b - b'0') }\n    if b >= b'a' && b <= b'f' { return i32(b - b'a') + 10 }\n    if b >= b'A' && b <= b'F' { return i32(b - b'A') + 10 }\n    -1\n}\n\nfn alloc_node(doc: &mut Doc, kind: u8, start: i32, end: i32, esc: bool) -> i32 {\n    id := doc.kinds.len\n    doc.kinds.push(kind)\n    doc.starts.push(start)\n    doc.ends.push(end)\n    doc.escaped.push(esc)\n    doc.first_child.push(-1)\n    doc.next_sibling.push(-1)\n    doc.key_starts.push(0)\n    doc.key_ends.push(0)\n    doc.key_escaped.push(false)\n    doc.counts.push(0)\n    id\n}\n\nstruct StrSpan { ok: bool, start: i32, end: i32, escaped: bool }\n\nfn scan_string(doc: &mut Doc, p: &mut Parser) -> StrSpan {\n    if p.pos >= doc.input.len || doc.input[p.pos] != b'\"' {\n        fail_doc(&mut doc, p.pos, \"expected '\\\"'\")\n        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n    }\n    p.pos += 1\n    start := p.pos\n    mut has_esc := false\n    while p.pos < doc.input.len {\n        b := doc.input[p.pos]\n        if b == b'\"' {\n            end := p.pos\n            p.pos += 1\n            return StrSpan { ok: true, start: start, end: end, escaped: has_esc }\n        }\n        if b < 32 {\n            fail_doc(&mut doc, p.pos, \"unescaped control character in JSON string\")\n            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n        }\n        if b == b'\\\\' {\n            has_esc = true\n            p.pos += 1\n            if p.pos >= doc.input.len {\n                fail_doc(&mut doc, p.pos, \"unterminated escape sequence\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n            esc := doc.input[p.pos]\n            if esc == b'\"' || esc == b'\\\\' || esc == b'/' || esc == b'b' ||\n               esc == b'f' || esc == b'n' || esc == b'r' || esc == b't' {\n                p.pos += 1\n            } else if esc == b'u' {\n                if p.pos + 4 >= doc.input.len {\n                    fail_doc(&mut doc, p.pos, \"incomplete \\\\uXXXX escape\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n                mut cp := 0\n                for k in 1..5 {\n                    hv := hex_val(doc.input[p.pos + k])\n                    if hv < 0 {\n                        fail_doc(&mut doc, p.pos + k, \"invalid hex digit in \\\\uXXXX escape\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    cp = cp * 16 + hv\n                }\n                p.pos += 5\n                if cp >= 0xD800 && cp <= 0xDBFF {\n                    if p.pos + 5 >= doc.input.len || doc.input[p.pos] != b'\\\\' || doc.input[p.pos + 1] != b'u' {\n                        fail_doc(&mut doc, p.pos, \"missing low surrogate in UTF-16 pair\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    mut low := 0\n                    for k in 2..6 {\n                        hv := hex_val(doc.input[p.pos + k])\n                        if hv < 0 {\n                            fail_doc(&mut doc, p.pos + k, \"invalid hex digit in low surrogate\")\n                            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                        }\n                        low = low * 16 + hv\n                    }\n                    if low < 0xDC00 || low > 0xDFFF {\n                        fail_doc(&mut doc, p.pos, \"invalid low surrogate range\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    p.pos += 6\n                } else if cp >= 0xDC00 && cp <= 0xDFFF {\n                    fail_doc(&mut doc, p.pos - 5, \"lone low surrogate\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n            } else {\n                fail_doc(&mut doc, p.pos, \"invalid escape character\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n        } else {\n            p.pos += 1\n        }\n    }\n    fail_doc(&mut doc, p.pos, \"unterminated JSON string\")\n    StrSpan { ok: false, start: 0, end: 0, escaped: false }\n}\n\nfn scan_number(doc: &mut Doc, p: &mut Parser) -> i32 {\n    start := p.pos\n    if p.pos < doc.input.len && doc.input[p.pos] == b'-' { p.pos += 1 }\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, start, \"invalid number\")\n        return -1\n    }\n    if doc.input[p.pos] == b'0' {\n        p.pos += 1\n        if p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            fail_doc(&mut doc, p.pos, \"leading zero in JSON number\")\n            return -1\n        }\n    } else if doc.input[p.pos] >= b'1' && doc.input[p.pos] <= b'9' {\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    } else {\n        fail_doc(&mut doc, p.pos, \"expected digit in JSON number\")\n        return -1\n    }\n    if p.pos < doc.input.len && doc.input[p.pos] == b'.' {\n        p.pos += 1\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected digit after decimal point\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    if p.pos < doc.input.len && (doc.input[p.pos] == b'e' || doc.input[p.pos] == b'E') {\n        p.pos += 1\n        if p.pos < doc.input.len && (doc.input[p.pos] == b'+' || doc.input[p.pos] == b'-') {\n            p.pos += 1\n        }\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected exponent digit\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    alloc_node(&mut doc, 3, start, p.pos, false)\n}\n\nfn scan_container(doc: &mut Doc, p: &mut Parser, object: bool) -> i32 {\n    start := p.pos\n    p.pos += 1\n    mut kind: u8 = 5\n    mut closing := b']'\n    if object { kind = 6; closing = b'}' }\n    node := alloc_node(&mut doc, kind, start, start, false)\n    skip_ws(&doc.input, &mut p)\n    if p.pos < doc.input.len && doc.input[p.pos] == closing {\n        p.pos += 1\n        doc.ends[node] = p.pos\n        return node\n    }\n    p.depth += 1\n    mut previous := -1\n    mut count := 0\n    while doc.ok {\n        mut child := -1\n        if object {\n            skip_ws(&doc.input, &mut p)\n            key := scan_string(&mut doc, &mut p)\n            if !key.ok { break }\n            if !key.escaped && !bytes.decode_range(&doc.input, key.start, key.end).ok {\n                fail_doc(&mut doc, key.start, \"invalid UTF-8 in JSON key\")\n                break\n            }\n            skip_ws(&doc.input, &mut p)\n            if p.pos >= doc.input.len || doc.input[p.pos] != b':' {\n                fail_doc(&mut doc, p.pos, \"expected ':' after object key\")\n                break\n            }\n            p.pos += 1\n            child = scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { break }\n            doc.key_starts[child] = key.start\n            doc.key_ends[child] = key.end\n            doc.key_escaped[child] = key.escaped\n        } else {\n            child = scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { break }\n        }\n        if previous < 0 { doc.first_child[node] = child }\n        else { doc.next_sibling[previous] = child }\n        previous = child\n        count += 1\n        skip_ws(&doc.input, &mut p)\n        if p.pos < doc.input.len && doc.input[p.pos] == b',' {\n            p.pos += 1\n            continue\n        }\n        if p.pos < doc.input.len && doc.input[p.pos] == closing {\n            p.pos += 1\n            doc.ends[node] = p.pos\n            doc.counts[node] = count\n            p.depth -= 1\n            return node\n        }\n        if object { fail_doc(&mut doc, p.pos, \"expected ',' or '}' in JSON object\") }\n        else { fail_doc(&mut doc, p.pos, \"expected ',' or ']' in JSON array\") }\n        break\n    }\n    p.depth -= 1\n    -1\n}\n\nfn scan_value(doc: &mut Doc, p: &mut Parser) -> i32 {\n    skip_ws(&doc.input, &mut p)\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, p.pos, \"unexpected end of JSON input\")\n        return -1\n    }\n    if p.depth >= 256 {\n        fail_doc(&mut doc, p.pos, \"JSON nesting depth exceeds 256\")\n        return -1\n    }\n    b := doc.input[p.pos]\n    if b == b'\"' {\n        sp := scan_string(&mut doc, &mut p)\n        if !sp.ok { return -1 }\n        if !sp.escaped {\n            if !bytes.decode_range(&doc.input, sp.start, sp.end).ok {\n                fail_doc(&mut doc, sp.start, \"invalid UTF-8 in JSON string\")\n                return -1\n            }\n        }\n        return alloc_node(&mut doc, 4, sp.start, sp.end, sp.escaped)\n    }\n    if b == b'{' || b == b'[' { return scan_container(&mut doc, &mut p, b == b'{') }\n    if b == b't' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"true\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'f' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 5, \"false\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 5, false)\n            p.pos += 5\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'n' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"null\") {\n            node := alloc_node(&mut doc, 1, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'-' || (b >= b'0' && b <= b'9') {\n        return scan_number(&mut doc, &mut p)\n    }\n    fail_doc(&mut doc, p.pos, \"unexpected character in JSON\")\n    -1\n}\n\nfn push_codepoint_utf8(out: &mut []u8, cp: i32) {\n    if cp <= 0x7F {\n        out.push(u8(cp))\n    } else if cp <= 0x7FF {\n        out.push(u8(0xC0.bit_or(cp.shr(6))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else if cp <= 0xFFFF {\n        out.push(u8(0xE0.bit_or(cp.shr(12))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else {\n        out.push(u8(0xF0.bit_or(cp.shr(18))))\n        out.push(u8(0x80.bit_or(cp.shr(12).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    }\n}\n\nfn unescape_span(input: &[]u8, start: i32, end: i32, has_esc: bool) -> StrField {\n    if !has_esc {\n        dec := bytes.decode_range(&input, start, end)\n        return StrField { ok: dec.ok, value: dec.value }\n    }\n    mut out: []u8 = []\n    out.reserve(end - start)\n    mut i := start\n    while i < end {\n        b := input[i]\n        if b != b'\\\\' {\n            out.push(b)\n            i += 1\n            continue\n        }\n        i += 1\n        esc := input[i]\n        if esc == b'\"' { out.push(b'\"'); i += 1 }\n        else if esc == b'\\\\' { out.push(b'\\\\'); i += 1 }\n        else if esc == b'/' { out.push(b'/'); i += 1 }\n        else if esc == b'b' { out.push(8); i += 1 }\n        else if esc == b'f' { out.push(12); i += 1 }\n        else if esc == b'n' { out.push(10); i += 1 }\n        else if esc == b'r' { out.push(13); i += 1 }\n        else if esc == b't' { out.push(9); i += 1 }\n        else if esc == b'u' {\n            mut cp := 0\n            for k in 1..5 { cp = cp * 16 + hex_val(input[i + k]) }\n            i += 5\n            if cp >= 0xD800 && cp <= 0xDBFF {\n                mut low := 0\n                for k in 2..6 { low = low * 16 + hex_val(input[i + k]) }\n                i += 6\n                cp = 0x10000 + (cp - 0xD800).shl(10) + (low - 0xDC00)\n            }\n            push_codepoint_utf8(&mut out, cp)\n        } else {\n            return StrField { ok: false, value: \"\" }\n        }\n    }\n    dec := bytes.decode(&out)\n    StrField { ok: dec.ok, value: dec.value }\n}\n\nimpl Doc {\n    pub fn parse_bytes(move input: []u8) -> Self {\n        est := input.len / 8 + 8\n        mut doc := Self {\n            ok: true, error: \"\", offset: 0, root: -1,\n            input: input, kinds: [], starts: [], ends: [], escaped: [],\n            first_child: [], next_sibling: [], key_starts: [], key_ends: [], key_escaped: [], counts: [],\n        }\n        doc.kinds.reserve(est); doc.starts.reserve(est); doc.ends.reserve(est)\n        mut p := Parser { pos: 0, depth: 0 }\n        root := scan_value(&mut doc, &mut p)\n        if !doc.ok { return doc }\n        skip_ws(&doc.input, &mut p)\n        if p.pos != doc.input.len {\n            fail_doc(&mut doc, p.pos, \"trailing characters after JSON value\")\n            return doc\n        }\n        doc.root = root\n        doc\n    }\n\n    pub fn parse_text(text: string) -> Self {\n        mut raw: []u8 = []\n        bytes.append_utf8(&mut raw, text)\n        Self::parse_bytes(move raw)\n    }\n\n    pub fn kind(&self, node: i32) -> Kind {\n        if !self.ok || node < 0 || node >= self.kinds.len { return .Invalid }\n        k := self.kinds[node]\n        if k == 1 { return .Null }\n        if k == 2 { return .Bool }\n        if k == 3 { return .Number }\n        if k == 4 { return .String }\n        if k == 5 { return .Array }\n        if k == 6 { return .Object }\n        .Invalid\n    }\n\n    pub fn count(&self, node: i32) -> i32 {\n        if !self.ok || node < 0 || node >= self.counts.len { return 0 }\n        self.counts[node]\n    }\n\n    fn key_matches(&self, child: i32, key: string) -> bool {\n        ks := self.key_starts[child]\n        ke := self.key_ends[child]\n        if !self.key_escaped[child] {\n            return bytes.equals_text(&self.input, ks, ke, key)\n        }\n        unesc := unescape_span(&self.input, ks, ke, true)\n        unesc.ok && unesc.value == key\n    }\n\n    pub fn field(&self, obj: i32, key: string) -> i32 {\n        if self.kind(obj) != .Object { return -1 }\n        mut found := -1\n        mut cur := self.first_child[obj]\n        while cur >= 0 {\n            if self.key_matches(cur, key) { found = cur }\n            cur = self.next_sibling[cur]\n        }\n        found\n    }\n\n    pub fn at(&self, arr: i32, index: i32) -> i32 {\n        if self.kind(arr) != .Array || index < 0 || index >= self.counts[arr] { return -1 }\n        mut cur := self.first_child[arr]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        cur\n    }\n\n    pub fn key_at(&self, obj: i32, index: i32) -> StrField {\n        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] {\n            return StrField { ok: false, value: \"\" }\n        }\n        mut cur := self.first_child[obj]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        unescape_span(&self.input, self.key_starts[cur], self.key_ends[cur], self.key_escaped[cur])\n    }\n\n    pub fn val_at(&self, obj: i32, index: i32) -> i32 {\n        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] { return -1 }\n        mut cur := self.first_child[obj]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        cur\n    }\n\n    pub fn as_bool(&self, node: i32) -> BoolField {\n        if self.kind(node) != .Bool { return BoolField { ok: false, value: false } }\n        BoolField { ok: true, value: self.input[self.starts[node]] == b't' }\n    }\n\n    pub fn as_i64(&self, node: i32) -> IntField {\n        if self.kind(node) != .Number { return IntField { ok: false, value: 0 } }\n        parsed := parse.i64_range(bytes.decode_range(&self.input, self.starts[node], self.ends[node]).value, 0, self.ends[node] - self.starts[node])\n        IntField { ok: parsed.ok, value: parsed.value }\n    }\n\n    pub fn as_u64(&self, node: i32) -> UintField {\n        if self.kind(node) != .Number { return UintField { ok: false, value: 0 } }\n        s := self.starts[node]; e := self.ends[node]\n        if s < e && self.input[s] == b'-' { return UintField { ok: false, value: 0 } }\n        parsed := parse.u64_range(bytes.decode_range(&self.input, s, e).value, 0, e - s)\n        UintField { ok: parsed.ok, value: parsed.value }\n    }\n\n    pub fn as_f64(&self, node: i32) -> FloatField {\n        if self.kind(node) != .Number { return FloatField { ok: false, value: 0.0 } }\n        parsed := parse.Float64::parse(self.raw_span(node))\n        FloatField { ok: parsed.ok, value: parsed.value }\n    }\n\n    pub fn as_str(&self, node: i32) -> StrField {\n        if self.kind(node) != .String { return StrField { ok: false, value: \"\" } }\n        unescape_span(&self.input, self.starts[node], self.ends[node], self.escaped[node])\n    }\n\n    pub fn raw_span(&self, node: i32) -> string {\n        if !self.ok || node < 0 || node >= self.starts.len { return \"\" }\n        bytes.decode_range(&self.input, self.starts[node], self.ends[node]).value\n    }\n\n    pub fn get_bool(&self, obj: i32, key: string) -> BoolField { self.as_bool(self.field(obj, key)) }\n    pub fn get_i64(&self, obj: i32, key: string) -> IntField { self.as_i64(self.field(obj, key)) }\n    pub fn get_u64(&self, obj: i32, key: string) -> UintField { self.as_u64(self.field(obj, key)) }\n    pub fn get_f64(&self, obj: i32, key: string) -> FloatField { self.as_f64(self.field(obj, key)) }\n    pub fn get_str(&self, obj: i32, key: string) -> StrField { self.as_str(self.field(obj, key)) }\n}\n\n@test fn json_writer_manages_nesting_and_round_trips_numbers() {\n    mut w := Writer::new()\n    w.object()\n    w.key(\"dir\")\n    w.array()\n    w.decimal(-0.0)\n    w.decimal(5e-324)\n    w.decimal(1.7976931348623157e308)\n    w.integer(-99)\n    w.unsigned(18446744073709551615)\n    w.null()\n    w.boolean(true)\n    w.object()\n    w.end()\n    w.end()\n    w.key(\"name\")\n    w.string(\"quote \\\"🌍\\\"\")\n    w.end()\n    encoded := w.finish()\n    assert(encoded.ok)\n    doc := Doc::parse_text(encoded.value)\n    assert(doc.ok)\n    dir := doc.field(doc.root, \"dir\")\n    assert(doc.count(dir) == 8)\n    assert(doc.as_f64(doc.at(dir, 0)).value.to_bits() == -9223372036854775808)\n    assert(doc.as_f64(doc.at(dir, 1)).value.to_bits() == 1)\n    assert(doc.as_f64(doc.at(dir, 2)).value.to_bits() == 0x7fefffffffffffff)\n    assert(doc.as_f64(doc.at(dir, 3)).value == -99.0)\n    assert(doc.as_u64(doc.at(dir, 4)).value == 18446744073709551615)\n    assert(!doc.as_f64(doc.at(dir, 5)).ok)\n    assert(doc.as_bool(doc.at(dir, 6)).value)\n    assert(doc.kind(doc.at(dir, 7)) == .Object)\n    assert(doc.get_str(doc.root, \"name\").value == \"quote \\\"🌍\\\"\")\n\n    numbers := Doc::parse_text(\"{\\\"negativeZero\\\":-0,\\\"tooLarge\\\":1e309,\\\"finite\\\":-12.5e-1}\")\n    assert(numbers.ok)\n    assert(numbers.get_f64(numbers.root, \"negativeZero\").value.is_sign_negative())\n    assert(!numbers.get_f64(numbers.root, \"tooLarge\").ok)\n    assert(!numbers.get_f64(numbers.root, \"missing\").ok)\n    assert(numbers.get_f64(numbers.root, \"finite\").value == -1.25)\n    assert(!numbers.get_i64(numbers.root, \"finite\").ok)\n}\n\n@test fn json_writer_rejects_invalid_sequences_and_nonfinite_values() {\n    mut unfinished := Writer::new()\n    assert(!unfinished.finish().ok)\n    unfinished.object()\n    unfinished.key(\"missing\")\n    assert(!unfinished.finish().ok)\n    unfinished.end()\n    unfinished.integer(1)\n    assert(!unfinished.finish().ok)\n\n    mut roots := Writer::new()\n    roots.null()\n    assert(roots.finish().value == \"null\")\n    roots.null()\n    assert(!roots.finish().ok)\n\n    mut nonfinite := Writer::new()\n    nonfinite.array()\n    nonfinite.decimal(1.0 / 0.0)\n    nonfinite.end()\n    assert(!nonfinite.finish().ok)\n\n    mut output: []u8 = []\n    mut first := begin_obj(&mut output)\n    assert(!field_f64(&mut output, &mut first, \"nan\", 0.0 / 0.0))\n    assert(first && output.len == 1)\n    assert(field_f64(&mut output, &mut first, \"number\", 1.25))\n    end_obj(&mut output)\n    assert(finish_text(&output) == \"{\\\"number\\\":1.25}\")\n}\n\n@test\nfn json_doc_impl_methods_work() {\n    doc := Doc::parse_text(\"{\\\"k\\\":\\\"v\\\",\\\"xs\\\":[1,2]}\")\n    assert(doc.ok)\n    assert(doc.get_str(doc.root, \"k\").value == \"v\")\n    xs := doc.field(doc.root, \"xs\")\n    assert(doc.count(xs) == 2)\n    assert(doc.as_i64(doc.at(xs, 1)).value == 2)\n}\n\n@test\nfn json_writer_and_zero_dom_parser_handle_nesting_unicode_and_errors() {\n    mut out: []u8 = []\n    mut first := begin_obj(&mut out)\n    field_str(&mut out, &mut first, \"kind\", \"runtime_profile\")\n    field_i32(&mut out, &mut first, \"version\", 1)\n    field_bool(&mut out, &mut first, \"ok\", true)\n    field_u64(&mut out, &mut first, \"max_u64\", 18446744073709551615)\n    field_str(&mut out, &mut first, \"msg\", \"rad1\\n\\\"åäö\\\" 🌍\")\n    mut af := begin_field_arr(&mut out, &mut first, \"items\")\n    sep_elem(&mut out, &mut af); write_i64(&mut out, -42)\n    sep_elem(&mut out, &mut af); write_null(&mut out)\n    end_arr(&mut out)\n    end_obj(&mut out)\n\n    doc := Doc::parse_bytes(out.clone())\n    assert(doc.ok)\n    assert(doc.get_str(doc.root, \"kind\").value == \"runtime_profile\")\n    assert(doc.get_i64(doc.root, \"version\").value == 1)\n    assert(doc.get_bool(doc.root, \"ok\").value)\n    assert(doc.get_u64(doc.root, \"max_u64\").value == 18446744073709551615)\n    assert(doc.get_str(doc.root, \"msg\").value == \"rad1\\n\\\"åäö\\\" 🌍\")\n    items := doc.field(doc.root, \"items\")\n    assert(doc.count(items) == 2)\n    assert(doc.as_i64(doc.at(items, 0)).value == -42)\n    assert(doc.kind(doc.at(items, 1)) == .Null)\n    out.clear()\n    assert(doc.get_str(doc.root, \"kind\").value == \"runtime_profile\")\n\n    sur := Doc::parse_text(\"{\\\"a\\\":1,\\\"a\\\":2,\\\"globe\\\":\\\"\\\\uD83C\\\\uDF0D\\\"}\")\n    assert(sur.ok)\n    assert(sur.get_i64(sur.root, \"a\").value == 2)\n    assert(sur.get_str(sur.root, \"globe\").value == \"🌍\")\n\n    assert(!Doc::parse_text(\"{\\\"a\\\":01}\").ok)\n    assert(!Doc::parse_text(\"{\\\"a\\\":1} trailing\").ok)\n    assert(!Doc::parse_text(\"\\\"\\\\uD800\\\"\").ok)\n}\n" }
    if name == "map" { return "import std.hash as hashing\n\npub struct Map {\n    keys: []string,\n    values: []i64,\n    slots: []i32,\n    length: i32,\n    used: i32,\n}\npub enum Lookup { Missing, Found(i64) }\n\nimpl Map {\n    pub fn new() -> Self { Self { keys: [], values: [], slots: [], length: 0, used: 0 } }\n    pub fn len(&self) -> i32 { self.length }\n    pub fn length(&self) -> i32 { self.length }\n\n    fn locate(&self, key: string) -> i32 {\n        capacity := self.slots.len\n        if capacity == 0 { return -1 }\n        mut slot := i32(hashing.hash(key) % i64(capacity))\n        for step in 0..capacity {\n            state := self.slots[slot]\n            if state == 0 { return -1 }\n            if state == 1 && self.keys[slot] == key { return slot }\n            slot = (slot + 1) % capacity\n        }\n        -1\n    }\n\n    pub fn contains(&self, key: string) -> bool { self.locate(key) >= 0 }\n\n    pub fn get(&self, key: string) -> Lookup {\n        slot := self.locate(key)\n        if slot < 0 { .Missing } else { .Found(self.values[slot]) }\n    }\n\n    pub fn get_or(&self, key: string, fallback: i64) -> i64 {\n        slot := self.locate(key)\n        if slot < 0 { fallback } else { self.values[slot] }\n    }\n\n    fn insert_slot(&mut self, move key: string, value: i64) {\n        capacity := self.slots.len\n        mut slot := i32(hashing.hash(key) % i64(capacity))\n        while self.slots[slot] == 1 { slot = (slot + 1) % capacity }\n        if self.slots[slot] == 0 { self.used += 1 }\n        self.slots[slot] = 1\n        self.keys[slot] = key\n        self.values[slot] = value\n        self.length += 1\n    }\n\n    fn rehash(&mut self, capacity: i32) {\n        mut fresh := Self::new()\n        fresh.keys.reserve(capacity)\n        fresh.values.reserve(capacity)\n        fresh.slots.reserve(capacity)\n        for i in 0..capacity { fresh.keys.push(\"\"); fresh.values.push(0); fresh.slots.push(0) }\n        while self.slots.len > 0 {\n            state := self.slots.pop()\n            value := self.values.pop()\n            key := self.keys.pop()\n            if state == 1 { fresh.insert_slot(move key, value) }\n        }\n        self = fresh\n    }\n\n    pub fn reserve(&mut self, entries: i32) {\n        assert(entries >= 0)\n        mut capacity := 8\n        while i64(capacity) * 7 < i64(entries) * 10 { capacity *= 2 }\n        if capacity > self.slots.len { self.rehash(capacity) }\n    }\n\n    pub fn put(&mut self, move key: string, value: i64) {\n        existing := self.locate(key)\n        if existing >= 0 { self.values[existing] = value; return }\n        capacity := self.slots.len\n        if capacity == 0 { self.rehash(8) }\n        else if (self.used + 1) * 10 >= capacity * 7 {\n            if (self.length + 1) * 10 < capacity * 4 { self.rehash(capacity) }\n            else { self.rehash(capacity * 2) }\n        }\n        self.insert_slot(move key, value)\n    }\n\n    pub fn remove(&mut self, key: string) -> bool {\n        slot := self.locate(key)\n        if slot < 0 { return false }\n        self.slots[slot] = 2\n        self.keys[slot] = \"\"\n        self.values[slot] = 0\n        self.length -= 1\n        true\n    }\n\n    pub fn clear(&mut self) {\n        for i in 0..self.slots.len { self.slots[i] = 0; self.keys[i] = \"\"; self.values[i] = 0 }\n        self.length = 0\n        self.used = 0\n    }\n\n    pub fn keys(&self) -> []string {\n        mut result: []string = []\n        result.reserve(self.length)\n        for i in 0..self.slots.len { if self.slots[i] == 1 { result.push(self.keys[i].clone()) } }\n        result\n    }\n}\n\npub fn new() -> Map { Map::new() }\npub fn length(table: &Map) -> i32 { table.length() }\npub fn contains(table: &Map, key: string) -> bool { table.contains(key) }\npub fn get(table: &Map, key: string) -> Lookup { table.get(key) }\npub fn get_or(table: &Map, key: string, fallback: i64) -> i64 { table.get_or(key, fallback) }\npub fn reserve(table: &mut Map, entries: i32) { table.reserve(entries) }\npub fn put(table: &mut Map, move key: string, value: i64) { table.put(move key, value) }\npub fn remove(table: &mut Map, key: string) -> bool { table.remove(key) }\npub fn clear(table: &mut Map) { table.clear() }\npub fn keys(table: &Map) -> []string { table.keys() }\n\n@test fn map_handles_growth_collisions_updates_removal_and_copies() {\n    mut collisions := new()\n    put(&mut collisions, \"a\", 1); put(&mut collisions, \"i\", 2); put(&mut collisions, \"q\", 3); put(&mut collisions, \"y\", 4)\n    remove(&mut collisions, \"a\")\n    put(&mut collisions, \"q\", 99)\n    length(&collisions) == 3\n    get_or(&collisions, \"q\", 0) == 99\n    get_or(&collisions, \"y\", 0) == 4\n    put(&mut collisions, \"\", -1); put(&mut collisions, \"\\0\", -2)\n    get_or(&collisions, \"\", 0) == -1\n    get_or(&collisions, \"\\0\", 0) == -2\n    mut table := new()\n    put(&mut table, \"\", -1)\n    put(&mut table, \"å 🌍\", 42)\n    for i in 0..1000 { put(&mut table, i.str(), i64(i) * 3) }\n    length(&table) == 1002\n    for i in 0..1000 { get_or(&table, i.str(), -1) == i64(i) * 3 }\n    snapshot := table.clone()\n    put(&mut table, \"å 🌍\", 99)\n    get_or(&snapshot, \"å 🌍\", 0) == 42\n    for i in 0..1000 { remove(&mut table, i.str()) }\n    length(&table) == 2\n    !remove(&mut table, \"missing\")\n    for i in 0..1000 { put(&mut table, i.str(), i64(i)) }\n    keys(&table).len == 1002\n    match get(&table, \"å 🌍\") { .Found(value) => { value == 99 }, .Missing => { assert(false) } }\n    clear(&mut table)\n    length(&table) == 0\n    !contains(&table, \"\")\n    put(&mut table, \"again\", 7)\n    get_or(&table, \"again\", 0) == 7\n}\n\n@test fn map_impl_methods_and_constructors() {\n    mut m := Map::new()\n    m.reserve(4)\n    m.put(\"k1\", 10)\n    m.put(\"k2\", 20)\n    m.len() == 2\n    m.length() == 2\n    m.contains(\"k1\")\n    m.get_or(\"k1\", -1) == 10\n    match m.get(\"k2\") { .Found(v) => { v == 20 }, .Missing => { assert(false) } }\n    m.keys().len == 2\n    m.remove(\"k1\")\n    !m.contains(\"k1\")\n    m.clear()\n    m.len() == 0\n}\n" }
    if name == "math" { return "pub fn min(a: f64, b: f64) -> f64 {\n    if a.is_nan() { return a }\n    if a < b || (a == b && a.is_sign_negative()) { a } else { b }\n}\n\npub fn max(a: f64, b: f64) -> f64 {\n    if a.is_nan() { return a }\n    if a > b || (a == b && !a.is_sign_negative()) { a } else { b }\n}\n\nfn quiet_nan() -> f64 { f64.from_bits(0x7ff8_0000_0000_0000) }\n\npub fn clamp(value: f64, low: f64, high: f64) -> f64 {\n    if low.is_nan() { return low }\n    if high.is_nan() { return high }\n    if low > high { return quiet_nan() }\n    if value < low { low } else if value > high { high } else { value }\n}\n\nfn product_bit(product: &[i64; 67], index: i32) -> i32 {\n    i32(product[index / 24].shr(index % 24).bit_and(1))\n}\n\n// Payne–Hanek reduction. Multiply the exact significand by floor(2^1536 * 2/pi).\n// The table stores little-endian 24-bit limbs so each product and carry fits i64.\nfn reduce_large(x: f64) -> (i32, f64) {\n    digits: [i64; 64] = [\n        0x73a8c9, 0x1556ca, 0x310606, 0x4d7327, 0xffd880, 0x68408d, 0x5f14a0, 0x659985,\n        0xe61b08, 0x91615e, 0x1da9e3, 0x9af436, 0xcfbc20, 0x6babf0, 0x46fc7b, 0x560330,\n        0x8d5d08, 0x5fb11f, 0xea6bfb, 0x8a5292, 0x0739f7, 0xf17b3d, 0xc7ebe5, 0x7527ba,\n        0x5fea2d, 0x3f669e, 0xb74f46, 0x27cb09, 0x367ecf, 0x6d1f6d, 0x8b5a0a, 0xef2f11,\n        0x05980f, 0x97ffde, 0x3b1ff8, 0xbdf928, 0x845f8b, 0x39f49c, 0x398353, 0x3991d6,\n        0x5f7e41, 0x7026b4, 0x84e99c, 0x2ebb44, 0x8235f5, 0xa73ee8, 0x1cb129, 0xfe1deb,\n        0xd1921c, 0x2eea09, 0xe00649, 0x424dd2, 0x246e3a, 0xc561b7, 0xabdebb, 0xfe5163,\n        0x439041, 0x95993c, 0xc0db62, 0xf534dd, 0x2757d1, 0x1529fc, 0x6e4e44, 0xa2f983,\n    ]\n    bits := x.to_bits()\n    significand := bits.bit_and(0x000f_ffff_ffff_ffff).bit_or(0x0010_0000_0000_0000)\n    exponent := i32(bits.shr(52)) - 1023\n    point := 1536 + 52 - exponent\n    mask: i64 = 0xff_ffff\n    low := significand.bit_and(mask)\n    middle := significand.shr(24).bit_and(mask)\n    high := significand.shr(48)\n    mut product: [i64; 67] = [0; 67]\n    mut carry: i64 = 0\n    // Only the two integer bits adjoining the binary point determine the quadrant.\n    for i in 0..((point + 1) / 24 + 1) {\n        mut sum := carry\n        if i < digits.len { sum += low * digits[i] }\n        if i >= 1 && i - 1 < digits.len { sum += middle * digits[i - 1] }\n        if i >= 2 && i - 2 < digits.len { sum += high * digits[i - 2] }\n        product[i] = sum.bit_and(mask)\n        carry = sum.shr(24)\n    }\n    quadrant := product_bit(&product, point) + 2 * product_bit(&product, point + 1)\n    round_up := product_bit(&product, point - 1) != 0\n    if round_up {\n        // Take the fixed-point complement before conversion to avoid cancellation near a multiple of pi/2.\n        carry = 1\n        for i in 0..((point + 23) / 24) {\n            limb := mask - product[i] + carry\n            product[i] = limb.bit_and(mask)\n            carry = limb.shr(24)\n        }\n    }\n    mut fraction := 0.0\n    whole := point / 24\n    for i in 0..whole { fraction = (fraction + f64(product[i])) / 16777216.0 }\n    rest := point % 24\n    if rest != 0 {\n        scale := i64(1).shl(rest)\n        fraction = (fraction + f64(product[whole].bit_and(scale - 1))) / f64(scale)\n    }\n    remainder := fraction * 1.5707963267948966\n    if round_up { return ((quadrant + 1).bit_and(3), -remainder) }\n    (quadrant, remainder)\n}\n\nfn reduce(x: f64) -> (i32, f64) {\n    if x < 524288.0 {\n        // The leading two parts of pi/2 have at most 33 significant bits.\n        // Their products with the integer multiple are exact in this range.\n        multiple := (x * 0.6366197723675814).round_ties_even()\n        remainder := ((x - multiple * 1.5707963267341256) -\n            multiple * 6.077100506303966e-11) - multiple * 2.0222662487959506e-21\n        if remainder.abs() > 2.9103830456733704e-11 && remainder.abs() <= 0.7853981633974483 {\n            return (i32(multiple).bit_and(3), remainder)\n        }\n    }\n    reduce_large(x)\n}\n\n// Taylor kernels on [-pi/4, pi/4], evaluated with Horner's rule.\nfn sine_kernel(x: f64) -> f64 {\n    square := x * x\n    mut coefficient := 2.8114572543455206e-15\n    coefficient = -7.647163731819816e-13 + square * coefficient\n    coefficient = 1.6059043836821613e-10 + square * coefficient\n    coefficient = -2.505210838544172e-8 + square * coefficient\n    coefficient = 2.7557319223985893e-6 + square * coefficient\n    coefficient = -0.0001984126984126984 + square * coefficient\n    coefficient = 0.008333333333333333 + square * coefficient\n    coefficient = -0.16666666666666666 + square * coefficient\n    x + (x * square) * coefficient\n}\n\nfn cosine_kernel(x: f64) -> f64 {\n    square := x * x\n    mut coefficient := -1.5619206968586225e-16\n    coefficient = 4.779477332387385e-14 + square * coefficient\n    coefficient = -1.1470745597729725e-11 + square * coefficient\n    coefficient = 2.08767569878681e-9 + square * coefficient\n    coefficient = -2.755731922398589e-7 + square * coefficient\n    coefficient = 2.48015873015873e-5 + square * coefficient\n    coefficient = -0.001388888888888889 + square * coefficient\n    coefficient = 0.041666666666666664 + square * coefficient\n    coefficient = -0.5 + square * coefficient\n    1.0 + square * coefficient\n}\n\nenum Trig { Sine, Cosine, Tangent }\n\nfn trig(angle: f64, operation: Trig) -> f64 {\n    if !angle.is_finite() {\n        return if angle.is_nan() { angle } else { quiet_nan() }\n    }\n    mut remainder := angle.abs()\n    mut quadrant := 0\n    if remainder > 0.7853981633974483 {\n        (q, r) := reduce(remainder)\n        quadrant = q\n        remainder = r\n    }\n    if operation == Trig.Tangent {\n        sine := sine_kernel(remainder)\n        cosine := cosine_kernel(remainder)\n        value := if quadrant.bit_and(1) == 0 { sine / cosine } else { -cosine / sine }\n        return if angle.is_sign_negative() { -value } else { value }\n    }\n    if operation == Trig.Cosine { quadrant = (quadrant + 1).bit_and(3) }\n    value := if quadrant.bit_and(1) == 0 { sine_kernel(remainder) } else { cosine_kernel(remainder) }\n    negative := (quadrant >= 2) != (operation == Trig.Sine && angle.is_sign_negative())\n    if negative { -value } else { value }\n}\n\npub fn sin(angle: f64) -> f64 { trig(angle, .Sine) }\npub fn cos(angle: f64) -> f64 { trig(angle, .Cosine) }\npub fn tan(angle: f64) -> f64 { trig(angle, .Tangent) }\n" }
    if name == "net" { return "capability network\nimport sys\n\npub fn poll_in() -> i32 { 1 }\npub fn poll_out() -> i32 { 4 }\npub fn poll_err() -> i32 { 8 }\npub fn poll_hup() -> i32 { 16 }\npub fn poll_nval() -> i32 { 32 }\npub fn err_would_block() -> i32 { 35 }\n\npub fn ipv4(a: i32, b: i32, c: i32, d: i32) -> i64 {\n    assert(a >= 0 && a <= 255 && b >= 0 && b <= 255 && c >= 0 && c <= 255 && d >= 0 && d <= 255)\n    (i64(a).shl(24)).bit_or(i64(b).shl(16)).bit_or(i64(c).shl(8)).bit_or(i64(d))\n}\npub fn loopback() -> i64 { ipv4(127, 0, 0, 1) }\npub fn any_addr() -> i64 { 0 }\n\n@resource(dispose)\npub opaque struct TcpListener { fd: i32 }\n@resource(dispose)\npub opaque struct TcpStream { fd: i32 }\n@resource(dispose)\npub opaque struct StreamSet { fds: []i32 }\n\npub struct ListenResult { ok: bool, listener: TcpListener, error: i32 }\npub struct AcceptResult { ok: bool, would_block: bool, stream: TcpStream, error: i32 }\npub struct ConnectResult { ok: bool, stream: TcpStream, error: i32 }\npub struct IoResult { ok: bool, would_block: bool, eof: bool, count: i64, error: i32 }\npub struct PollSet {\n    fds: []i32,\n    events: []i32,\n    revents: []i32,\n    scratch: []u8,\n}\n\nfn status_from_i64(raw: i64) -> sys.Status {\n    if raw < 0 { return sys.Status { ok: false, error: i32(-raw) } }\n    sys.Status { ok: true, error: 0 }\n}\n\nfn fd_read_append(fd: i32, out: &mut []u8, max_bytes: i32) -> IoResult {\n    if max_bytes <= 0 {\n        return IoResult { ok: true, would_block: false, eof: false, count: 0, error: 0 }\n    }\n    out.reserve(out.len + max_bytes)\n    n := sys.net_read(fd, &mut out, i64(max_bytes))\n    if n < 0 {\n        err := i32(-n)\n        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n    }\n    IoResult { ok: true, would_block: false, eof: n == 0, count: n, error: 0 }\n}\n\nfn fd_write_range(fd: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {\n    n := sys.net_write(fd, &data, i64(offset), i64(length))\n    if n < 0 {\n        err := i32(-n)\n        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n    }\n    IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }\n}\n\nimpl TcpListener {\n    @requires(network)\n    pub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult {\n        raw := sys.net_listen(addr, i64(port), i64(backlog))\n        if raw < 0 {\n            return ListenResult { ok: false, listener: Self { fd: -1 }, error: i32(-raw) }\n        }\n        ListenResult { ok: true, listener: Self { fd: i32(raw) }, error: 0 }\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n\n    pub fn local_port(&self) -> i32 {\n        raw := sys.net_local_port(self.fd)\n        if raw < 0 { return -1 }\n        i32(raw)\n    }\n\n    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))\n    }\n\n    pub fn accept(&self) -> AcceptResult {\n        raw := sys.net_accept(self.fd)\n        if raw < 0 {\n            err := i32(-raw)\n            return AcceptResult { ok: false, would_block: err == 35, stream: TcpStream { fd: -1 }, error: err }\n        }\n        AcceptResult { ok: true, would_block: false, stream: TcpStream { fd: i32(raw) }, error: 0 }\n    }\n\n    fn dispose(&self) {\n        if self.fd >= 0 { _ := sys.net_close(self.fd) }\n    }\n\n    pub fn close(&mut self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(self.fd))\n        self.fd = -1\n        st\n    }\n}\n\nimpl TcpStream {\n    @requires(network)\n    pub fn connect(addr: i64, port: i32) -> ConnectResult {\n        raw := sys.net_connect(addr, i64(port))\n        if raw < 0 {\n            return ConnectResult { ok: false, stream: Self { fd: -1 }, error: i32(-raw) }\n        }\n        ConnectResult { ok: true, stream: Self { fd: i32(raw) }, error: 0 }\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n\n    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))\n    }\n\n    pub fn set_nodelay(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nodelay(self.fd, enabled))\n    }\n\n    pub fn read_append(&self, out: &mut []u8, max_bytes: i32) -> IoResult {\n        fd_read_append(self.fd, &mut out, max_bytes)\n    }\n\n    pub fn write_range(&self, data: &[]u8, offset: i32, length: i32) -> IoResult {\n        fd_write_range(self.fd, &data, offset, length)\n    }\n\n    pub fn write_all(&self, data: &[]u8) -> sys.Status {\n        mut off := 0\n        while off < data.len {\n            n := sys.net_write(self.fd, &data, i64(off), i64(data.len - off))\n            if n < 0 { return sys.Status { ok: false, error: i32(-n) } }\n            if n == 0 { return sys.Status { ok: false, error: 5 } }\n            off += i32(n)\n        }\n        sys.Status { ok: true, error: 0 }\n    }\n\n    pub fn shutdown_write(&self) -> sys.Status {\n        status_from_i64(sys.net_shutdown_write(self.fd))\n    }\n\n    fn dispose(&self) {\n        if self.fd >= 0 { _ := sys.net_close(self.fd) }\n    }\n\n    pub fn close(&mut self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(self.fd))\n        self.fd = -1\n        st\n    }\n}\n\nimpl PollSet {\n    pub fn new() -> Self {\n        Self { fds: [], events: [], revents: [], scratch: [] }\n    }\n\n    pub fn clear(&mut self) {\n        self.fds.clear()\n        self.events.clear()\n        self.revents.clear()\n    }\n\n    pub fn add(&mut self, fd: i32, events: i32) {\n        self.fds.push(fd)\n        self.events.push(events)\n        self.revents.push(0)\n    }\n\n    pub fn poll(&mut self, timeout_ms: i32) -> IoResult {\n        count := self.fds.len\n        assert(self.events.len == count && self.revents.len == count)\n        need := count * 8\n        if self.scratch.len < need {\n            self.scratch.reserve(need)\n            while self.scratch.len < need { self.scratch.push(0) }\n        }\n        for i in 0..count {\n            base := i * 8\n            u := i64(self.fds[i]).bit_and(0xffffffff)\n            self.scratch[base] = u8(u.bit_and(0xff))\n            self.scratch[base + 1] = u8(u.shr(8).bit_and(0xff))\n            self.scratch[base + 2] = u8(u.shr(16).bit_and(0xff))\n            self.scratch[base + 3] = u8(u.shr(24).bit_and(0xff))\n            ev := i64(self.events[i]).bit_and(0xffff)\n            self.scratch[base + 4] = u8(ev.bit_and(0xff))\n            self.scratch[base + 5] = u8(ev.shr(8).bit_and(0xff))\n            self.scratch[base + 6] = 0\n            self.scratch[base + 7] = 0\n        }\n        n := sys.net_poll(&mut self.scratch, i64(count), i64(timeout_ms))\n        if n < 0 {\n            err := i32(-n)\n            return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n        }\n        for i in 0..count {\n            base := i * 8\n            lo := i32(self.scratch[base + 6])\n            hi := i32(self.scratch[base + 7])\n            self.revents[i] = lo + hi.shl(8)\n        }\n        IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }\n    }\n}\n\nimpl StreamSet {\n    pub fn new() -> Self { Self { fds: [] } }\n    pub fn len(&self) -> i32 { self.fds.len }\n    pub fn fd(&self, slot: i32) -> i32 { self.fds[slot] }\n\n    pub fn insert(&mut self, move s: TcpStream) -> i32 {\n        mut stream := s\n        fd := stream.fd\n        assert(fd >= 0)\n        stream.fd = -1\n        for i in 0..self.fds.len {\n            if self.fds[i] < 0 {\n                self.fds[i] = fd\n                return i\n            }\n        }\n        self.fds.push(fd)\n        self.fds.len - 1\n    }\n\n    fn dispose(&self) {\n        for fd in self.fds {\n            if fd >= 0 { _ := sys.net_close(fd) }\n        }\n    }\n\n    pub fn read_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_read_append(fd, &mut out, max_bytes)\n    }\n\n    pub fn write_range(&self, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_write_range(fd, &data, offset, length)\n    }\n\n    pub fn shutdown_write(&self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        status_from_i64(sys.net_shutdown_write(fd))\n    }\n\n    pub fn close(&mut self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        if fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(fd))\n        self.fds[slot] = -1\n        st\n    }\n\n    pub fn close_all(&mut self) {\n        for i in 0..self.fds.len {\n            if self.fds[i] >= 0 {\n                _ := sys.net_close(self.fds[i])\n                self.fds[i] = -1\n            }\n        }\n    }\n}\n\n@requires(network)\npub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult { TcpListener::listen(addr, port, backlog) }\n\n@requires(network)\npub fn connect(addr: i64, port: i32) -> ConnectResult { TcpStream::connect(addr, port) }\n\npub fn listener_fd(l: &TcpListener) -> i32 { l.fd() }\npub fn stream_fd(s: &TcpStream) -> i32 { s.fd() }\npub fn local_port(l: &TcpListener) -> i32 { l.local_port() }\npub fn set_listener_nonblocking(l: &TcpListener, enabled: bool) -> sys.Status { l.set_nonblocking(enabled) }\npub fn accept(l: &TcpListener) -> AcceptResult { l.accept() }\npub fn close_listener(l: &mut TcpListener) -> sys.Status { l.close() }\npub fn set_nonblocking(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nonblocking(enabled) }\npub fn set_nodelay(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nodelay(enabled) }\npub fn read_append(s: &TcpStream, out: &mut []u8, max_bytes: i32) -> IoResult { s.read_append(&mut out, max_bytes) }\npub fn write_range(s: &TcpStream, data: &[]u8, offset: i32, length: i32) -> IoResult { s.write_range(&data, offset, length) }\npub fn write_all(s: &TcpStream, data: &[]u8) -> sys.Status { s.write_all(&data) }\npub fn shutdown_write(s: &TcpStream) -> sys.Status { s.shutdown_write() }\npub fn close(s: &mut TcpStream) -> sys.Status { s.close() }\n\npub fn poll_set() -> PollSet { PollSet::new() }\npub fn poll_clear(ps: &mut PollSet) { ps.clear() }\npub fn poll_add(ps: &mut PollSet, fd: i32, events: i32) { ps.add(fd, events) }\npub fn poll(ps: &mut PollSet, timeout_ms: i32) -> IoResult { ps.poll(timeout_ms) }\n\npub fn stream_set() -> StreamSet { StreamSet::new() }\npub fn set_len(set: &StreamSet) -> i32 { set.len() }\npub fn set_fd(set: &StreamSet, slot: i32) -> i32 { set.fd(slot) }\npub fn set_insert(set: &mut StreamSet, move s: TcpStream) -> i32 { set.insert(move s) }\npub fn set_read_append(set: &StreamSet, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult { set.read_append(slot, &mut out, max_bytes) }\npub fn set_write_range(set: &StreamSet, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult { set.write_range(slot, &data, offset, length) }\npub fn set_shutdown_write(set: &StreamSet, slot: i32) -> sys.Status { set.shutdown_write(slot) }\npub fn set_close(set: &mut StreamSet, slot: i32) -> sys.Status { set.close(slot) }\npub fn set_close_all(set: &mut StreamSet) { set.close_all() }\n" }
    if name == "parse" { return "import std.parse.decimal as decimal\n\npub struct Integer { ok: bool, value: i64, error: i32 }\npub struct Unsigned { ok: bool, value: u64, error: i32 }\npub struct Float32 { ok: bool, value: f32, error: i32 }\npub struct Float64 { ok: bool, value: f64, error: i32 }\n\nfn radix_digit(byte: i32, radix: i32) -> i32 {\n    if byte >= 48 && byte <= 57 {\n        d := byte - 48\n        if d < radix { return d }\n        return -1\n    }\n    if radix == 16 {\n        if byte >= 65 && byte <= 70 { return byte - 55 }\n        if byte >= 97 && byte <= 102 { return byte - 87 }\n    }\n    -1\n}\n\nfn parse_signed_range(text: string, start: i32, end: i32, radix: i32, separators: bool) -> Integer {\n    if start < 0 || end <= start || end > text.len { return Integer { ok: false, value: 0, error: 1 } }\n    mut cursor := start\n    negative := text[cursor] == 45\n    if negative || text[cursor] == 43 { cursor += 1 }\n    if cursor == end { return Integer { ok: false, value: 0, error: 1 } }\n    limit: i64 = if negative { -9223372036854775808 } else { -9223372036854775807 }\n    cutoff := limit / i64(radix)\n    first_digit := cursor\n    mut value: i64 = 0\n    while cursor < end {\n        if separators && text[cursor] == 95 {\n            if cursor == first_digit || cursor + 1 == end { return Integer { ok: false, value: 0, error: 1 } }\n            cursor += 1\n        }\n        d := radix_digit(text[cursor], radix)\n        if d < 0 { return Integer { ok: false, value: 0, error: 1 } }\n        if value < cutoff { return Integer { ok: false, value: 0, error: 2 } }\n        value *= i64(radix)\n        if value < limit + i64(d) { return Integer { ok: false, value: 0, error: 2 } }\n        value -= i64(d)\n        cursor += 1\n    }\n    if !negative { value = -value }\n    Integer { ok: true, value: value, error: 0 }\n}\n\nfn parse_unsigned_range(text: string, start: i32, end: i32, radix: i32) -> Unsigned {\n    if start < 0 || end <= start || end > text.len { return Unsigned { ok: false, value: 0, error: 1 } }\n    maximum: u64 = 18446744073709551615\n    max_div := maximum / u64(radix)\n    max_rem := i32(maximum % u64(radix))\n    mut value: u64 = 0\n    for i in start..end {\n        d := radix_digit(text[i], radix)\n        if d < 0 { return Unsigned { ok: false, value: 0, error: 1 } }\n        if value > max_div || (value == max_div && d > max_rem) {\n            return Unsigned { ok: false, value: 0, error: 2 }\n        }\n        value = value * u64(radix) + u64(d)\n    }\n    Unsigned { ok: true, value: value, error: 0 }\n}\n\npub fn integer(text: string) -> Integer { Integer::parse(text) }\npub fn hex(text: string) -> Integer { Integer::hex(text) }\npub fn i64_range(text: string, start: i32, end: i32) -> Integer { Integer::range(text, start, end) }\npub fn u64_range(text: string, start: i32, end: i32) -> Unsigned { Unsigned::range(text, start, end) }\npub fn hex_u64_range(text: string, start: i32, end: i32) -> Unsigned { Unsigned::hex_range(text, start, end) }\n\nimpl Integer {\n    pub fn parse(text: string) -> Self { parse_signed_range(text, 0, text.len, 10, true) }\n    pub fn hex(text: string) -> Self { parse_signed_range(text, 0, text.len, 16, false) }\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_signed_range(text, start, end, 10, false) }\n}\n\nimpl Unsigned {\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_unsigned_range(text, start, end, 10) }\n    pub fn hex_range(text: string, start: i32, end: i32) -> Self { parse_unsigned_range(text, start, end, 16) }\n}\n\nfn ascii_digit(byte: i32) -> bool { byte >= i32(b'0') && byte <= i32(b'9') }\n\nfn after_decimal_digits(text: string, start: i32, end: i32, separators: bool) -> i32 {\n    if start == end || !ascii_digit(text[start]) { return -1 }\n    mut cursor := start + 1\n    while cursor < end {\n        if ascii_digit(text[cursor]) {\n            cursor += 1\n        } else if separators && text[cursor] == i32(b'_') && cursor + 1 < end && ascii_digit(text[cursor + 1]) {\n            cursor += 2\n        } else {\n            break\n        }\n    }\n    cursor\n}\n\nfn valid_decimal(text: string, start: i32, end: i32, separators: bool) -> bool {\n    if start < 0 || end <= start || end > text.len { return false }\n    mut cursor := start\n    if text[cursor] == i32(b'+') || text[cursor] == i32(b'-') { cursor += 1 }\n    cursor = after_decimal_digits(text, cursor, end, separators)\n    if cursor < 0 { return false }\n    if cursor < end && text[cursor] == i32(b'.') {\n        cursor = after_decimal_digits(text, cursor + 1, end, separators)\n        if cursor < 0 { return false }\n    }\n    if cursor < end && (text[cursor] == i32(b'e') || text[cursor] == i32(b'E')) {\n        cursor += 1\n        if cursor < end && (text[cursor] == i32(b'+') || text[cursor] == i32(b'-')) { cursor += 1 }\n        cursor = after_decimal_digits(text, cursor, end, separators)\n    }\n    cursor == end\n}\n\nfn parse_float32(text: string, start: i32, end: i32, separators: bool) -> Float32 {\n    if !valid_decimal(text, start, end, separators) { return Float32 { ok: false, value: 0.0, error: 1 } }\n    parsed := decimal.decode_range(text, start, end, true)\n    if !parsed.ok { return Float32 { ok: false, value: 0.0, error: 2 } }\n    bits := if parsed.bits >= 2147483648 { parsed.bits - 4294967296 } else { parsed.bits }\n    Float32 { ok: true, value: f32.from_bits(i32(bits)), error: 0 }\n}\n\nfn parse_float64(text: string, start: i32, end: i32, separators: bool) -> Float64 {\n    if !valid_decimal(text, start, end, separators) { return Float64 { ok: false, value: 0.0, error: 1 } }\n    parsed := decimal.decode_range(text, start, end, false)\n    if !parsed.ok { return Float64 { ok: false, value: 0.0, error: 2 } }\n    Float64 { ok: true, value: f64.from_bits(parsed.bits), error: 0 }\n}\n\nimpl Float32 {\n    pub fn parse(text: string) -> Self { parse_float32(text, 0, text.len, true) }\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_float32(text, start, end, false) }\n}\n\nimpl Float64 {\n    pub fn parse(text: string) -> Self { parse_float64(text, 0, text.len, true) }\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_float64(text, start, end, false) }\n}\n\n@test fn floating_parser_checks_grammar_and_rounds_directly_to_the_target_width() {\n    wide := Float64::parse(\"+1_234.5_6e-0_2\")\n    assert(wide.ok && wide.value == 12.3456)\n    narrow := Float32::parse(\"1.000000059604644775390625000000000000000001\")\n    assert(narrow.ok && narrow.value.to_bits() == 0x3f800001)\n    assert(Float32::parse(\"1.000000059604644775390625\").value.to_bits() == 0x3f800000)\n    assert(Float32::parse(\"-1e-99999999\").value.to_bits() == -2147483648)\n    assert(Float64::parse(\"-0\").value.to_bits() == -9223372036854775808)\n    assert(Float64::parse(\"5e-324\").value.to_bits() == 1)\n    assert(Float64::parse(\"1.7976931348623157e308\").value.to_bits() == 0x7fefffffffffffff)\n    assert(Float64::parse(\"1.7976931348623159e308\").error == 2)\n    assert(Float32::parse(\"3.5e38\").error == 2)\n    assert(Float64::range(\"v=-0.125!\", 2, 8).value == -0.125)\n    assert(Float32::range(\"2_0\", 0, 3).error == 1)\n    for invalid in [\"\", \".\", \"+\", \"1.\", \".1\", \"1e\", \"1e+\", \"1e_2\", \"1_.2\", \"1__0\", \" 1\", \"1\\0\", \"NaN\", \"Infinity\"] {\n        assert(Float64::parse(invalid).error == 1)\n    }\n}\n\n@test fn decimal_parser_covers_limits_separators_and_errors() {\n    integer(\"42\").value == 42\n    integer(\"-9223372036854775808\").value == -9223372036854775808\n    integer(\"9223372036854775807\").value == 9223372036854775807\n    integer(\"42_000\").value == 42000\n    integer(\"+0\").ok\n    integer(\"9223372036854775808\").error == 2\n    integer(\"-9223372036854775809\").error == 2\n    !integer(\"1__2\").ok\n    !integer(\"1_\").ok\n    !integer(\"-_1\").ok\n    !integer(\" 2\").ok\n    !integer(\"+\").ok\n    !integer(\"\").ok\n    hex(\"1a2B\").value == 6699\n    hex(\"-ff\").value == -255\n    !hex(\"1_2\").ok\n    i64_range(\"len:1024;\", 4, 8).value == 1024\n    !i64_range(\"len:1_024;\", 4, 9).ok\n    u64_range(\"len:18446744073709551615;\", 4, 24).value == 18446744073709551615\n    u64_range(\"18446744073709551616\", 0, 20).error == 2\n    hex_u64_range(\"chunk=deadbeef;\", 6, 14).value == 3735928559\n}\n" }
    if name == "parse/decimal" { return "pub struct Number { ok: bool, bits: i64 }\n\nfn multiply(value: &mut []i32, factor: i32, add: i32) {\n    mut carry := add\n    for i in 0..value.len {\n        n := value[i] * factor + carry\n        value[i] = n % 16777216\n        carry = n / 16777216\n    }\n    if carry != 0 { value.push(carry) }\n}\n\nfn compare(a: &[]i32, b: &[]i32) -> i32 {\n    if a.len != b.len { return a.len - b.len }\n    mut i := a.len - 1\n    while i >= 0 {\n        if a[i] != b[i] { return a[i] - b[i] }\n        i = i - 1\n    }\n    0\n}\n\nfn subtract(a: &mut []i32, b: &[]i32) {\n    mut borrow := 0\n    for i in 0..a.len {\n        mut n := a[i] - borrow\n        if i < b.len { n = n - b[i] }\n        borrow = 0\n        if n < 0 { n = n + 16777216; borrow = 1 }\n        a[i] = n\n    }\n    while a.len > 0 && a[a.len - 1] == 0 { last := a.pop() }\n}\n\npub fn decode(text: string, single: bool) -> Number {\n    decode_range(text, 0, text.len, single)\n}\n\n// The caller has already checked the decimal grammar.\npub fn decode_range(text: string, start: i32, end: i32, single: bool) -> Number {\n    mut sign: i64 = 0\n    mut bias := 1023\n    mut fraction := 52\n    if single { bias = 127; fraction = 23 }\n    mut i := start\n    if text[i] == i32(b'-') {\n        i += 1\n        sign = -9223372036854775808\n        if single { sign = 2147483648 }\n    } else if text[i] == i32(b'+') {\n        i += 1\n    }\n    mut numerator: []i32 = []\n    mut denominator: []i32 = [1]\n    mut after_point := false\n    mut digits := 0\n    mut scale: i64 = 0\n    mut sticky := false\n    while i < end {\n        byte := text[i]; i = i + 1\n        if byte == 69 || byte == 101 {\n            mut negative := false\n            if i < end && (text[i] == i32(b'+') || text[i] == i32(b'-')) {\n                negative = text[i] == i32(b'-')\n                i += 1\n            }\n            mut power: i64 = 0\n            while i < end {\n                digit := text[i]; i = i + 1\n                if digit != 95 && power < 10000000000 { power = power * 10 + i64(digit - 48) }\n            }\n            if negative { scale = scale - power } else { scale = scale + power }\n            break\n        }\n        if byte == 95 { continue }\n        if byte == 46 { after_point = true; continue }\n        if after_point { scale = scale - 1 }\n        if byte == 48 && digits == 0 { continue }\n        if digits < 800 {\n            multiply(&mut numerator, 10, byte - 48); digits = digits + 1\n        } else {\n            scale = scale + 1\n            if byte != 48 { sticky = true }\n        }\n    }\n    if digits == 0 || i64(digits) + scale < -324 { return Number { ok: true, bits: sign } }\n    if i64(digits) + scale > 309 { return Number { ok: false, bits: 0 } }\n    while scale > 0 { multiply(&mut numerator, 10, 0); scale = scale - 1 }\n    while scale < 0 { multiply(&mut denominator, 10, 0); scale = scale + 1 }\n    mut exponent := 0\n    if compare(&numerator, &denominator) < 0 {\n        while compare(&numerator, &denominator) < 0 { multiply(&mut numerator, 2, 0); exponent = exponent - 1 }\n    } else {\n        mut twice := denominator.clone()\n        multiply(&mut twice, 2, 0)\n        while compare(&numerator, &twice) >= 0 {\n            multiply(&mut denominator, 2, 0); multiply(&mut twice, 2, 0); exponent = exponent + 1\n        }\n    }\n    mut precision := fraction + 1\n    if exponent < 1 - bias { precision = precision + exponent - (1 - bias) }\n    if precision < 0 { return Number { ok: true, bits: sign } }\n    mut mantissa: i64 = 0\n    for j in 0..precision {\n        mantissa = mantissa * 2\n        if compare(&numerator, &denominator) >= 0 {\n            mantissa = mantissa + 1\n            subtract(&mut numerator, &denominator)\n        }\n        multiply(&mut numerator, 2, 0)\n    }\n    rounding := compare(&numerator, &denominator)\n    if rounding > 0 || (rounding == 0 && (sticky || mantissa % 2 != 0)) { mantissa = mantissa + 1 }\n    unit := i64(1).shl(fraction)\n    if mantissa >= unit * 2 { mantissa = mantissa / 2; exponent = exponent + 1 }\n    if exponent > bias { return Number { ok: false, bits: 0 } }\n    if exponent >= 1 - bias { mantissa = mantissa + i64(exponent + bias - 1) * unit }\n    Number { ok: true, bits: mantissa.bit_or(sign) }\n}\n" }
    if name == "process" { return "capability unsafe, process\nimport std.bytes as bytes\nimport std.parse as decimal\nimport std.text as text\nimport sys\n\n@extern(\"c\", \"uname\")\nunsafe fn c_uname(output: ptr) -> i32\n@extern(\"c\", \"fork\")\nunsafe fn c_fork() -> i32\n@extern(\"c\", \"execve\")\nunsafe fn c_execve(path: ptr, argv: ptr, envp: ptr) -> i32\n@extern(\"c\", \"_exit\")\nunsafe fn c_exit(code: i32)\n@extern(\"c\", \"pipe\")\nunsafe fn c_pipe(fds: ptr) -> i32\n@extern(\"c\", \"dup2\")\nunsafe fn c_dup2(oldfd: i32, newfd: i32) -> i32\n@extern(\"c\", \"close\")\nunsafe fn c_close(fd: i32) -> i32\n@extern(\"c\", \"chdir\")\nunsafe fn c_chdir(path: ptr) -> i32\n@extern(\"c\", \"waitpid\")\nunsafe fn c_waitpid(pid: i32, status: ptr, options: i32) -> i32\n@extern(\"c\", \"kill\")\nunsafe fn c_kill(pid: i32, sig: i32) -> i32\n@extern(\"c\", \"setpgid\")\nunsafe fn c_setpgid(pid: i32, pgid: i32) -> i32\n@extern(\"c\", \"read\")\nunsafe fn c_read(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"write\")\nunsafe fn c_write(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"ioctl\")\nunsafe fn c_ioctl(fd: i32, req: usize) -> i32\n@extern(\"c\", \"fopen\")\nunsafe fn c_fopen(path: ptr, mode: ptr) -> ptr\n@extern(\"c\", \"fileno\")\nunsafe fn c_fileno(file: ptr) -> i32\n@extern(\"c\", \"fclose\")\nunsafe fn c_fclose(file: ptr) -> i32\n@extern(\"c\", \"getenv\")\nunsafe fn c_getenv(name: ptr) -> ptr\n@extern(\"c\", \"signal\")\nunsafe fn c_signal(sig: i32, handler: ptr) -> ptr\n@extern(\"c\", \"sigprocmask\")\nunsafe fn c_sigprocmask(how: i32, set: ptr, previous: ptr) -> i32\n@extern(\"c\", \"sysconf\")\nunsafe fn c_sysconf(name: i32) -> i64\n@extern(\"c\", \"usleep\")\nunsafe fn c_usleep(usec: u32) -> i32\n@extern(\"c\", \"__error\")\nunsafe fn c_errno_ptr() -> ptr\n@extern(\"c\", \"_NSGetEnviron\")\nunsafe fn c_ns_get_environ() -> ptr\n\npub enum EnvMode { Inherit = 0, Clear = 1 }\npub enum Stdio { Inherit = 0, Pipe = 1, Null = 2 }\n\npub opaque struct Executable { program: string }\n\npub struct Command {\n    program: string,\n    args: []string,\n    cwd: string,\n    env_mode: EnvMode,\n    env_keys: []string,\n    env_vals: []string,\n    env_unset: []bool,\n    stdin_mode: Stdio,\n    stdout_mode: Stdio,\n    stderr_mode: Stdio,\n    stdin_data: []u8,\n    timeout_ms: i64,\n    max_output_bytes: i64,\n}\n\npub struct Output {\n    ok: bool,\n    error: i32,\n    code: i32,\n    signal: i32,\n    timed_out: bool,\n    stdout: []u8,\n    stderr: []u8,\n}\n\n@resource\npub opaque struct Child {\n    pid: i32,\n    pgid: i32,\n    stdin_fd: i32,\n    stdout_fd: i32,\n    stderr_fd: i32,\n    reaped: bool,\n    code: i32,\n    signal: i32,\n}\n\npub struct SpawnResult { ok: bool, child: Child, error: i32 }\npub struct WaitResult { ok: bool, exited: bool, timed_out: bool, code: i32, signal: i32, error: i32 }\n\nimpl Executable {\n    @requires(process)\n    pub fn grant(move program: string) -> Self { Self { program: program } }\n    pub fn path(&self) -> string { self.program.clone() }\n    pub fn exec(&self, cmd: &Command) -> Output { exec_internal(self.program, &cmd.args, &cmd) }\n\n    pub fn run(&self, args: []string) -> Output {\n        cmd := Command::new(\"\", [])\n        exec_internal(self.program, &args, &cmd)\n    }\n\n    pub fn spawn(&self, cmd: &Command) -> SpawnResult {\n        spawn_internal(self.program, &cmd.args, &cmd, cmd.stdin_mode)\n    }\n}\n\nimpl Command {\n    pub fn new(move program: string, move args: []string) -> Self {\n        Self {\n            program: program,\n            args: args,\n            cwd: \"\",\n            env_mode: .Inherit,\n            env_keys: [],\n            env_vals: [],\n            env_unset: [],\n            stdin_mode: .Null,\n            stdout_mode: .Pipe,\n            stderr_mode: .Pipe,\n            stdin_data: [],\n            timeout_ms: 0,\n            max_output_bytes: 67108864,\n        }\n    }\n\n    pub fn add_arg(&mut self, move arg: string) { self.args.push(move arg) }\n\n    pub fn add_args(&mut self, move args: []string) {\n        self.args.reserve(self.args.len + args.len)\n        for a in move args { self.args.push(move a) }\n    }\n\n    pub fn set_cwd(&mut self, move cwd: string) { self.cwd = cwd }\n\n    pub fn clear_env(&mut self) {\n        self.env_mode = .Clear\n        self.env_keys.clear()\n        self.env_vals.clear()\n        self.env_unset.clear()\n    }\n\n    pub fn set_env(&mut self, move key: string, move value: string) {\n        for i in 0..self.env_keys.len {\n            if self.env_keys[i] == key {\n                self.env_vals[i] = value\n                self.env_unset[i] = false\n                return\n            }\n        }\n        self.env_keys.push(move key)\n        self.env_vals.push(move value)\n        self.env_unset.push(false)\n    }\n\n    pub fn unset_env(&mut self, move key: string) {\n        for i in 0..self.env_keys.len {\n            if self.env_keys[i] == key {\n                self.env_vals[i] = \"\"\n                self.env_unset[i] = true\n                return\n            }\n        }\n        self.env_keys.push(move key)\n        self.env_vals.push(\"\")\n        self.env_unset.push(true)\n    }\n\n    pub fn inherit_stdio(&mut self) {\n        self.stdin_mode = .Inherit\n        self.stdout_mode = .Inherit\n        self.stderr_mode = .Inherit\n    }\n\n    pub fn set_stdio(&mut self, stdin_mode: Stdio, stdout_mode: Stdio, stderr_mode: Stdio) {\n        self.stdin_mode = stdin_mode\n        self.stdout_mode = stdout_mode\n        self.stderr_mode = stderr_mode\n    }\n\n    pub fn set_stdin(&mut self, move data: []u8) {\n        self.stdin_mode = .Pipe\n        self.stdin_data = data\n    }\n\n    pub fn set_stdin_text(&mut self, input: string) {\n        self.stdin_mode = .Pipe\n        self.stdin_data.clear()\n        bytes.append_utf8(&mut self.stdin_data, input)\n    }\n\n    pub fn set_timeout(&mut self, timeout_ms: i64) { se