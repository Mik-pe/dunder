cipher, implementation, key, nonce) }\n    if target_is(\"linux\") { return linux_enc_init(context, cipher, implementation, key, nonce) }\n    -1\n}\n\n@extern(\"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\", \"EVP_EncryptUpdate\")\nunsafe fn mac_enc_update(context: ptr, output: ptr, output_len: ptr, input: ptr, input_len: i32) -> i32\n@extern(\"libcrypto.so.3\", \"EVP_EncryptUpdate\")\nunsafe fn linux_enc_update(context: ptr, output: ptr, output_len: ptr, input: ptr, input_len: i32) -> i32\nunsafe fn c_enc_update(context: ptr, output: ptr, output_len: ptr, input: ptr, input_len: i32) -> i32 {\n    if target_is(\"macos\") { return mac_enc_update(context, output, output_len, input, input_len) }\n    if target_is(\"linux\") { return linux_enc_update(context, output, output_len, input, input_len) }\n    -1\n}\n\n@extern(\"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\", \"EVP_EncryptFinal_ex\")\nunsafe fn mac_enc_final(context: ptr, output: ptr, output_len: ptr) -> i32\n@extern(\"libcrypto.so.3\", \"EVP_EncryptFinal_ex\")\nunsafe fn linux_enc_final(context: ptr, output: ptr, output_len: ptr) -> i32\nunsafe fn c_enc_final(context: ptr, output: ptr, output_len: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_enc_final(context, output, output_len) }\n    if target_is(\"linux\") { return linux_enc_final(context, output, output_len) }\n    -1\n}\n\n@extern(\"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\", \"EVP_DecryptInit_ex\")\nunsafe fn mac_dec_init(context: ptr, cipher: ptr, implementation: ptr, key: ptr, nonce: ptr) -> i32\n@extern(\"libcrypto.so.3\", \"EVP_DecryptInit_ex\")\nunsafe fn linux_dec_init(context: ptr, cipher: ptr, implementation: ptr, key: ptr, nonce: ptr) -> i32\nunsafe fn c_dec_init(context: ptr, cipher: ptr, implementation: ptr, key: ptr, nonce: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_dec_init(context, cipher, implementation, key, nonce) }\n    if target_is(\"linux\") { return linux_dec_init(context, cipher, implementation, key, nonce) }\n    -1\n}\n\n@extern(\"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\", \"EVP_DecryptUpdate\")\nunsafe fn mac_dec_update(context: ptr, output: ptr, output_len: ptr, input: ptr, input_len: i32) -> i32\n@extern(\"libcrypto.so.3\", \"EVP_DecryptUpdate\")\nunsafe fn linux_dec_update(context: ptr, output: ptr, output_len: ptr, input: ptr, input_len: i32) -> i32\nunsafe fn c_dec_update(context: ptr, output: ptr, output_len: ptr, input: ptr, input_len: i32) -> i32 {\n    if target_is(\"macos\") { return mac_dec_update(context, output, output_len, input, input_len) }\n    if target_is(\"linux\") { return linux_dec_update(context, output, output_len, input, input_len) }\n    -1\n}\n\n@extern(\"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\", \"EVP_DecryptFinal_ex\")\nunsafe fn mac_dec_final(context: ptr, output: ptr, output_len: ptr) -> i32\n@extern(\"libcrypto.so.3\", \"EVP_DecryptFinal_ex\")\nunsafe fn linux_dec_final(context: ptr, output: ptr, output_len: ptr) -> i32\nunsafe fn c_dec_final(context: ptr, output: ptr, output_len: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_dec_final(context, output, output_len) }\n    if target_is(\"linux\") { return linux_dec_final(context, output, output_len) }\n    -1\n}\n\n@extern(\"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\", \"EVP_CIPHER_CTX_ctrl\")\nunsafe fn mac_ctrl(context: ptr, operation: i32, length: i32, data: ptr) -> i32\n@extern(\"libcrypto.so.3\", \"EVP_CIPHER_CTX_ctrl\")\nunsafe fn linux_ctrl(context: ptr, operation: i32, length: i32, data: ptr) -> i32\nunsafe fn c_ctrl(context: ptr, operation: i32, length: i32, data: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_ctrl(context, operation, length, data) }\n    if target_is(\"linux\") { return linux_ctrl(context, operation, length, data) }\n    -1\n}\n\nfn bad(message: string) -> BytesResult { BytesResult { ok: false, value: [], error: message.clone() } }\nfn as_bytes(value: string) -> []u8 { mut out: []u8 = []; bytes.append_utf8(&mut out, value); out }\nfn terminated(value: string) -> []u8 { mut out := as_bytes(value); out.push(0); out }\nunsafe fn pointer(value: &[]u8) -> ptr { if value.len == 0 { return ptr(0) }; addr(&value[0]) }\n\npub fn random(count: i32) -> BytesResult {\n    if count < 0 || count > 1048576 { return bad(\"random byte count must be 0..1048576\") }\n    mut value: []u8 = []; bytes.pad(&mut value, count)\n    if count == 0 { return BytesResult { ok: true, value: value, error: \"\" } }\n    unsafe { if c_rand(addr(&mut value[0]), count) != 1 { return bad(\"system random generator failed\") } }\n    BytesResult { ok: true, value: value, error: \"\" }\n}\n\npub fn equal(left: &[]u8, right: &[]u8) -> bool {\n    if left.len != right.len { return false }\n    mut difference := 0\n    for i in 0..left.len { difference = difference.bit_or(i32(left[i]).bit_xor(i32(right[i]))) }\n    difference == 0\n}\n\npub fn hmac_sha256(key: &[]u8, input: &[]u8) -> []u8 {\n    mut material: []u8 = []\n    if key.len > 64 { material = sha256.digest_bytes(&key) } else { bytes.extend(&mut material, &key) }\n    while material.len < 64 { material.push(0) }\n    mut inside: []u8 = []; mut outside: []u8 = []\n    inside.reserve(64 + input.len); outside.reserve(96)\n    for byte in &material { inside.push(u8(i32(byte).bit_xor(54))); outside.push(u8(i32(byte).bit_xor(92))) }\n    bytes.extend(&mut inside, &input)\n    digest := sha256.digest_bytes(&inside)\n    bytes.extend(&mut outside, &digest)\n    sha256.digest_bytes(&outside)\n}\n\npub fn hkdf_sha256(key: &[]u8, salt: &[]u8, info: &[]u8, length: i32) -> BytesResult {\n    if length < 0 || length > 8160 { return bad(\"HKDF output must be 0..8160 bytes\") }\n    prk := hmac_sha256(&salt, &key)\n    mut output: []u8 = []; mut previous: []u8 = []; mut counter := 1\n    output.reserve(length)\n    while output.len < length {\n        mut block: []u8 = []\n        bytes.extend(&mut block, &previous); bytes.extend(&mut block, &info); block.push(u8(counter))\n        previous = hmac_sha256(&prk, &block)\n        for byte in &previous { if output.len < length { output.push(byte) } }\n        counter += 1\n    }\n    BytesResult { ok: true, value: output, error: \"\" }\n}\n\nfn digit(value: i32) -> i32 {\n    if value >= 48 && value <= 57 { return value - 48 }\n    if value >= 65 && value <= 70 { return value - 55 }\n    if value >= 97 && value <= 102 { return value - 87 }\n    -1\n}\npub fn decode_hex(value: string) -> BytesResult {\n    if value.len % 2 != 0 || value.len > 33554432 { return bad(\"invalid hex encoding\") }\n    mut output: []u8 = []; output.reserve(value.len / 2)\n    mut i := 0\n    while i < value.len {\n        high := digit(value[i]); low := digit(value[i + 1])\n        if high < 0 || low < 0 { return bad(\"invalid hex encoding\") }\n        output.push(u8(high * 16 + low)); i += 2\n    }\n    BytesResult { ok: true, value: output, error: \"\" }\n}\n\npub fn argon2id_hash(password: string) -> TextResult {\n    if password.len > 1048576 { return TextResult { ok: false, value: \"\", error: \"password exceeds its byte limit\" } }\n    salt := random(16)\n    if !salt.ok { return TextResult { ok: false, value: \"\", error: salt.error } }\n    raw := as_bytes(password)\n    mut encoded: []u8 = []; bytes.pad(&mut encoded, 512)\n    unsafe {\n        if c_argon_hash(2, 19456, 1, pointer(&raw), usize(raw.len), pointer(&salt.value), 16, 32, addr(&mut encoded[0]), 512) != 0 {\n            return TextResult { ok: false, value: \"\", error: \"Argon2id password hashing failed\" }\n        }\n    }\n    mut end := 0\n    while end < encoded.len && encoded[end] != 0 { end += 1 }\n    if end == encoded.len { return TextResult { ok: false, value: \"\", error: \"invalid Argon2id output\" } }\n    TextResult { ok: true, value: bytes.decode_range(&encoded, 0, end).value, error: \"\" }\n}\n\nfn argon_parameters(encoded: string) -> bool {\n    if encoded.len > 512 || !text.starts_with(encoded, \"$argon2id$v=19$\") { return false }\n    for byte in encoded.bytes() { if byte == 0 { return false } }\n    parts := text.split(encoded, \"$\")\n    if parts.len != 6 || parts[4].len < 11 || parts[5].len < 16 { return false }\n    settings := text.split(parts[3], \",\")\n    if settings.len != 3 { return false }\n    prefixes: []string = [\"m=\", \"t=\", \"p=\"]\n    limits: []i64 = [262144, 10, 16]\n    for i in 0..3 {\n        if !text.starts_with(settings[i], prefixes[i]) { return false }\n        value := settings[i][2..settings[i].len]\n        if value.len == 0 || value.len > 8 { return false }\n        for byte in value.bytes() { if byte < 48 || byte > 57 { return false } }\n        number := parse.integer(value)\n        if !number.ok || number.value < 1 || number.value > limits[i] { return false }\n    }\n    true\n}\n\npub fn argon2id_verify(password: string, encoded: string) -> bool {\n    if password.len > 1048576 || !argon_parameters(encoded) { return false }\n    hash := terminated(encoded); raw := as_bytes(password)\n    unsafe { return c_argon_verify(addr(&hash[0]), pointer(&raw), usize(raw.len)) == 0 }\n    false\n}\n\npub fn aes256_gcm_seal(key: &[]u8, nonce: &[]u8, aad: &[]u8, plaintext: &[]u8) -> SealResult {\n    if key.len != 32 || nonce.len != 12 || plaintext.len > 16777216 || aad.len > 1048576 {\n        return SealResult { ok: false, ciphertext: [], tag: [], error: \"invalid AES-256-GCM inputs\" }\n    }\n    unsafe {\n        context := c_ctx_new()\n        if context == ptr(0) { return SealResult { ok: false, ciphertext: [], tag: [], error: \"cannot allocate AES context\" } }\n        defer { c_ctx_free(context) }\n        if c_enc_init(context, c_cipher(), ptr(0), pointer(&key), pointer(&nonce)) != 1 {\n            return SealResult { ok: false, ciphertext: [], tag: [], error: \"cannot initialize AES-256-GCM\" }\n        }\n        mut count := 0\n        if aad.len > 0 && c_enc_update(context, ptr(0), addr(&mut count), pointer(&aad), aad.len) != 1 {\n            return SealResult { ok: false, ciphertext: [], tag: [], error: \"cannot authenticate AES associated data\" }\n        }\n        mut output: []u8 = []; bytes.pad(&mut output, plaintext.len + 16)\n        count = 0\n        if c_enc_update(context, addr(&mut output[0]), addr(&mut count), pointer(&plaintext), plaintext.len) != 1 {\n            return SealResult { ok: false, ciphertext: [], tag: [], error: \"AES encryption failed\" }\n        }\n        mut final_count := 0\n        if c_enc_final(context, addr(&mut output[count]), addr(&mut final_count)) != 1 {\n            return SealResult { ok: false, ciphertext: [], tag: [], error: \"AES encryption failed\" }\n        }\n        mut tag: []u8 = []; bytes.pad(&mut tag, 16)\n        if c_ctrl(context, 16, 16, addr(&mut tag[0])) != 1 {\n            return SealResult { ok: false, ciphertext: [], tag: [], error: \"cannot read AES authentication tag\" }\n        }\n        while output.len > count + final_count { _ := output.pop() }\n        return SealResult { ok: true, ciphertext: output, tag: tag, error: \"\" }\n    }\n    SealResult { ok: false, ciphertext: [], tag: [], error: \"AES requires a native target\" }\n}\n\npub fn aes256_gcm_open(key: &[]u8, nonce: &[]u8, aad: &[]u8, ciphertext: &[]u8, tag: &[]u8) -> BytesResult {\n    if key.len != 32 || nonce.len != 12 || tag.len != 16 || ciphertext.len > 16777216 || aad.len > 1048576 { return bad(\"invalid AES-256-GCM inputs\") }\n    unsafe {\n        context := c_ctx_new()\n        if context == ptr(0) { return bad(\"cannot allocate AES context\") }\n        defer { c_ctx_free(context) }\n        if c_dec_init(context, c_cipher(), ptr(0), pointer(&key), pointer(&nonce)) != 1 { return bad(\"cannot initialize AES-256-GCM\") }\n        mut count := 0\n        if aad.len > 0 && c_dec_update(context, ptr(0), addr(&mut count), pointer(&aad), aad.len) != 1 { return bad(\"cannot authenticate AES associated data\") }\n        mut output: []u8 = []; bytes.pad(&mut output, ciphertext.len + 16)\n        count = 0\n        if c_dec_update(context, addr(&mut output[0]), addr(&mut count), pointer(&ciphertext), ciphertext.len) != 1 { return bad(\"AES decryption failed\") }\n        if c_ctrl(context, 17, 16, pointer(&tag)) != 1 { return bad(\"cannot set AES authentication tag\") }\n        mut final_count := 0\n        if c_dec_final(context, addr(&mut output[count]), addr(&mut final_count)) != 1 {\n            for i in 0..output.len { output[i] = 0 }\n            return bad(\"AES authentication failed\")\n        }\n        while output.len > count + final_count { _ := output.pop() }\n        return BytesResult { ok: true, value: output, error: \"\" }\n    }\n    bad(\"AES requires a native target\")\n}\n" }
