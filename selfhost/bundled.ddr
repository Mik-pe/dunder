turn failure(\"HEAD cannot include a request body\") }\n    for byte in ca_bundle.bytes() { if byte == 0 { return failure(\"invalid CA bundle path\") } }\n    mut header_bytes := 0\n    for i in 0..header_names.len {\n        name := header_names[i].clone()\n        value := header_values[i].clone()\n        if !token(name) || name.len > 256 || value.len > 8192 { return failure(\"invalid HTTP header\") }\n        for byte in value.bytes() {\n            if (byte < 32 && byte != 9) || byte == 127 { return failure(\"invalid HTTP header value\") }\n        }\n        header_bytes += name.len + value.len + 4\n        if header_bytes > 65536 { return failure(\"HTTP headers exceed their limit\") }\n    }\n    unsafe {\n        initialized := global_init()\n        if initialized != 0 { return failure(transport_error(initialized)) }\n        defer { global_cleanup() }\n        easy := easy_init()\n        if usize(easy) == 0 { return failure(\"cannot allocate HTTP client\") }\n        defer { easy_cleanup(easy) }\n        mut headers := ptr(0)\n        defer { slist_free(headers) }\n        for i in 0..header_names.len {\n            header := c_string(header_names[i] + \": \" + header_values[i])\n            next := slist_append(headers, addr(&header[0]))\n            if usize(next) == 0 { return failure(\"cannot allocate HTTP headers\") }\n            headers = next\n        }\n        url_bytes := c_string(url)\n        method_bytes := c_string(method)\n        ca_bytes := c_string(ca_bundle)\n        mut receiver := Receiver { body: [], max_bytes: max_bytes, limited: false }\n        mut configured := set_ptr(easy, 10002, addr(&url_bytes[0]))\n        configured = set_ptr(easy, 10036, addr(&method_bytes[0])) && configured\n        configured = set_ptr(easy, 10023, headers) && configured\n        configured = set_ptr(easy, 10001, addr(&mut receiver)) && configured\n        configured = set_writer(easy) && configured\n        configured = set_long(easy, 99, 1) && configured\n        configured = set_long(easy, 156, 5000) && configured\n        configured = set_long(easy, 155, timeout_ms) && configured\n        configured = set_long(easy, 52, 0) && configured\n        configured = set_long(easy, 64, 1) && configured\n        configured = set_long(easy, 81, 2) && configured\n        configured = set_long(easy, 181, 3) && configured\n        if ca_bundle.len > 0 { configured = set_ptr(easy, 10065, addr(&ca_bytes[0])) && configured }\n        if method == \"HEAD\" { configured = set_long(easy, 44, 1) && configured }\n        else if body.len > 0 || method == \"POST\" || method == \"PUT\" || method == \"PATCH\" {\n            mut data := cstr(\"\")\n            if body.len > 0 { data = addr(&body[0]) }\n            configured = set_ptr(easy, 10015, data) && configured\n            configured = set_long(easy, 30120, i64(body.len)) && configured\n        }\n        if !configured { return failure(\"cannot configure HTTP client\") }\n        code := perform(easy)\n        status := response_code(easy)\n        if receiver.limited {\n            return Response { ok: false, status: status, body: receiver.body, error: \"HTTP response exceeds its byte limit\" }\n        }\n        if code != 0 {\n            return Response { ok: false, status: status, body: receiver.body, error: transport_error(code) }\n        }\n        Response { ok: true, status: status, body: receiver.body, error: \"\" }\n    }\n}\n" }
    if name == "json" { return "// Zero-DOM streaming JSON writer and flat span-tape RFC 8259 parser.\n// Parsing records compact parallel arrays of byte spans into the input buffer\n// with zero hashmap allocations and zero string unescaping until a field is read.\nimport std.bytes as bytes\nimport std.parse as parse\nimport sys\n\npub enum Kind {\n    Invalid = 0,\n    Null = 1,\n    Bool = 2,\n    Number = 3,\n    String = 4,\n    Array = 5,\n    Object = 6,\n}\n\npub struct Doc {\n    ok: bool,\n    error: string,\n    offset: i32,\n    root: i32,\n    input: []u8,\n    kinds: []u8,\n    starts: []i32,    // byte start in input (for String: after opening quote)\n    ends: []i32,      // byte end in input (for String: before closing quote)\n    escaped: []bool,  // true only when a String span contains '\\'\n    first_child: []i32,\n    next_sibling: []i32,\n    key_starts: []i32,\n    key_ends: []i32,\n    key_escaped: []bool,\n    counts: []i32,\n}\n\npub struct BoolField { ok: bool, value: bool }\npub struct IntField { ok: bool, value: i64 }\npub struct UintField { ok: bool, value: u64 }\npub struct StrField { ok: bool, value: string }\n\n// --- Direct-to-buffer JSON Writer (zero intermediate string concatenations) ---\n\npub fn write_str(out: &mut []u8, value: string) {\n    hex := \"0123456789abcdef\"\n    out.reserve(out.len + value.len + 2)\n    out.push(b'\"')\n    for b in value.bytes() {\n        if b == 34 { out.push(b'\\\\'); out.push(b'\"') }\n        else if b == 92 { out.push(b'\\\\'); out.push(b'\\\\') }\n        else if b == 8 { out.push(b'\\\\'); out.push(b'b') }\n        else if b == 12 { out.push(b'\\\\'); out.push(b'f') }\n        else if b == 10 { out.push(b'\\\\'); out.push(b'n') }\n        else if b == 13 { out.push(b'\\\\'); out.push(b'r') }\n        else if b == 9 { out.push(b'\\\\'); out.push(b't') }\n        else if b < 32 {\n            bytes.append_utf8(&mut out, \"\\\\u00\")\n            out.push(u8(hex[b / 16]))\n            out.push(u8(hex[b % 16]))\n        } else {\n            out.push(u8(b))\n        }\n    }\n    out.push(b'\"')\n}\n\npub fn quote(value: string) -> string {\n    mut out: []u8 = []\n    write_str(&mut out, value)\n    bytes.decode(&out).value\n}\n\npub fn write_i64(out: &mut []u8, value: i64) { bytes.append_decimal(&mut out, value) }\n\npub fn write_u64(out: &mut []u8, value: u64) {\n    if value == 0 { out.push(b'0'); return }\n    start := out.len\n    mut v := value\n    while v > 0 {\n        d := i32(v % 10)\n        out.push(u8(48 + d))\n        v /= 10\n    }\n    mut left := start\n    mut right := out.len - 1\n    while left < right {\n        tmp := out[left]; out[left] = out[right]; out[right] = tmp\n        left += 1; right -= 1\n    }\n}\n\npub fn write_bool(out: &mut []u8, value: bool) {\n    if value { bytes.append_utf8(&mut out, \"true\") }\n    else { bytes.append_utf8(&mut out, \"false\") }\n}\n\npub fn write_null(out: &mut []u8) { bytes.append_utf8(&mut out, \"null\") }\n\nfn sep_key(out: &mut []u8, first: &mut bool, key: string) {\n    if !first { out.push(b',') }\n    first = false\n    write_str(&mut out, key)\n    out.push(b':')\n}\n\npub fn sep_elem(out: &mut []u8, first: &mut bool) {\n    if !first { out.push(b',') }\n    first = false\n}\n\npub fn begin_obj(out: &mut []u8) -> bool { out.push(b'{'); true }\npub fn end_obj(out: &mut []u8) { out.push(b'}') }\npub fn begin_arr(out: &mut []u8) -> bool { out.push(b'['); true }\npub fn end_arr(out: &mut []u8) { out.push(b']') }\n\npub fn field_str(out: &mut []u8, first: &mut bool, key: string, value: string) {\n    sep_key(&mut out, &mut first, key); write_str(&mut out, value)\n}\npub fn field_i64(out: &mut []u8, first: &mut bool, key: string, value: i64) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, value)\n}\npub fn field_i32(out: &mut []u8, first: &mut bool, key: string, value: i32) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, i64(value))\n}\npub fn field_u64(out: &mut []u8, first: &mut bool, key: string, value: u64) {\n    sep_key(&mut out, &mut first, key); write_u64(&mut out, value)\n}\npub fn field_bool(out: &mut []u8, first: &mut bool, key: string, value: bool) {\n    sep_key(&mut out, &mut first, key); write_bool(&mut out, value)\n}\npub fn field_null(out: &mut []u8, first: &mut bool, key: string) {\n    sep_key(&mut out, &mut first, key); write_null(&mut out)\n}\npub fn begin_field_obj(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_obj(&mut out)\n}\npub fn begin_field_arr(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_arr(&mut out)\n}\n\npub fn finish_text(out: &[]u8) -> string { bytes.decode(&out).value }\n\n// --- Flat Span-Tape Parser ---\n\nstruct Parser {\n    pos: i32,\n    depth: i32,\n}\n\nfn is_ws(b: u8) -> bool {\n    b == b' ' || b == b'\\t' || b == b'\\n' || b == b'\\r'\n}\n\nfn skip_ws(input: &[]u8, p: &mut Parser) {\n    while p.pos < input.len && is_ws(input[p.pos]) {\n        p.pos += 1\n    }\n}\n\nfn fail_doc(doc: &mut Doc, at: i32, move msg: string) {\n    if doc.ok {\n        doc.ok = false\n        doc.offset = at\n        doc.error = msg\n    }\n}\n\nfn hex_val(b: u8) -> i32 {\n    if b >= b'0' && b <= b'9' { return i32(b - b'0') }\n    if b >= b'a' && b <= b'f' { return i32(b - b'a') + 10 }\n    if b >= b'A' && b <= b'F' { return i32(b - b'A') + 10 }\n    -1\n}\n\nfn alloc_node(doc: &mut Doc, kind: u8, start: i32, end: i32, esc: bool) -> i32 {\n    id := doc.kinds.len\n    doc.kinds.push(kind)\n    doc.starts.push(start)\n    doc.ends.push(end)\n    doc.escaped.push(esc)\n    doc.first_child.push(-1)\n    doc.next_sibling.push(-1)\n    doc.key_starts.push(0)\n    doc.key_ends.push(0)\n    doc.key_escaped.push(false)\n    doc.counts.push(0)\n    id\n}\n\nstruct StrSpan { ok: bool, start: i32, end: i32, escaped: bool }\n\nfn scan_string(doc: &mut Doc, p: &mut Parser) -> StrSpan {\n    if p.pos >= doc.input.len || doc.input[p.pos] != b'\"' {\n        fail_doc(&mut doc, p.pos, \"expected '\\\"'\")\n        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n    }\n    p.pos += 1\n    start := p.pos\n    mut has_esc := false\n    while p.pos < doc.input.len {\n        b := doc.input[p.pos]\n        if b == b'\"' {\n            end := p.pos\n            p.pos += 1\n            return StrSpan { ok: true, start: start, end: end, escaped: has_esc }\n        }\n        if b < 32 {\n            fail_doc(&mut doc, p.pos, \"unescaped control character in JSON string\")\n            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n        }\n        if b == b'\\\\' {\n            has_esc = true\n            p.pos += 1\n            if p.pos >= doc.input.len {\n                fail_doc(&mut doc, p.pos, \"unterminated escape sequence\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n            esc := doc.input[p.pos]\n            if esc == b'\"' || esc == b'\\\\' || esc == b'/' || esc == b'b' ||\n               esc == b'f' || esc == b'n' || esc == b'r' || esc == b't' {\n                p.pos += 1\n            } else if esc == b'u' {\n                if p.pos + 4 >= doc.input.len {\n                    fail_doc(&mut doc, p.pos, \"incomplete \\\\uXXXX escape\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n                mut cp := 0\n                for k in 1..5 {\n                    hv := hex_val(doc.input[p.pos + k])\n                    if hv < 0 {\n                        fail_doc(&mut doc, p.pos + k, \"invalid hex digit in \\\\uXXXX escape\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    cp = cp * 16 + hv\n                }\n                p.pos += 5\n                if cp >= 0xD800 && cp <= 0xDBFF {\n                    if p.pos + 5 >= doc.input.len || doc.input[p.pos] != b'\\\\' || doc.input[p.pos + 1] != b'u' {\n                        fail_doc(&mut doc, p.pos, \"missing low surrogate in UTF-16 pair\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    mut low := 0\n                    for k in 2..6 {\n                        hv := hex_val(doc.input[p.pos + k])\n                        if hv < 0 {\n                            fail_doc(&mut doc, p.pos + k, \"invalid hex digit in low surrogate\")\n                            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                        }\n                        low = low * 16 + hv\n                    }\n                    if low < 0xDC00 || low > 0xDFFF {\n                        fail_doc(&mut doc, p.pos, \"invalid low surrogate range\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    p.pos += 6\n                } else if cp >= 0xDC00 && cp <= 0xDFFF {\n                    fail_doc(&mut doc, p.pos - 5, \"lone low surrogate\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n            } else {\n                fail_doc(&mut doc, p.pos, \"invalid escape character\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n        } else {\n            p.pos += 1\n        }\n    }\n    fail_doc(&mut doc, p.pos, \"unterminated JSON string\")\n    StrSpan { ok: false, start: 0, end: 0, escaped: false }\n}\n\nfn scan_number(doc: &mut Doc, p: &mut Parser) -> i32 {\n    start := p.pos\n    if p.pos < doc.input.len && doc.input[p.pos] == b'-' { p.pos += 1 }\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, start, \"invalid number\")\n        return -1\n    }\n    if doc.input[p.pos] == b'0' {\n        p.pos += 1\n        if p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            fail_doc(&mut doc, p.pos, \"leading zero in JSON number\")\n            return -1\n        }\n    } else if doc.input[p.pos] >= b'1' && doc.input[p.pos] <= b'9' {\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    } else {\n        fail_doc(&mut doc, p.pos, \"expected digit in JSON number\")\n        return -1\n    }\n    if p.pos < doc.input.len && doc.input[p.pos] == b'.' {\n        p.pos += 1\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected digit after decimal point\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    if p.pos < doc.input.len && (doc.input[p.pos] == b'e' || doc.input[p.pos] == b'E') {\n        p.pos += 1\n        if p.pos < doc.input.len && (doc.input[p.pos] == b'+' || doc.input[p.pos] == b'-') {\n            p.pos += 1\n        }\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected exponent digit\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    alloc_node(&mut doc, 3, start, p.pos, false)\n}\n\nfn scan_value(doc: &mut Doc, p: &mut Parser) -> i32 {\n    skip_ws(&doc.input, &mut p)\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, p.pos, \"unexpected end of JSON input\")\n        return -1\n    }\n    if p.depth >= 256 {\n        fail_doc(&mut doc, p.pos, \"JSON nesting depth exceeds 256\")\n        return -1\n    }\n    b := doc.input[p.pos]\n    if b == b'\"' {\n        sp := scan_string(&mut doc, &mut p)\n        if !sp.ok { return -1 }\n        if !sp.escaped {\n            // Validate UTF-8 once over raw slice.\n            if !bytes.decode_range(&doc.input, sp.start, sp.end).ok {\n                fail_doc(&mut doc, sp.start, \"invalid UTF-8 in JSON string\")\n                return -1\n            }\n        }\n        return alloc_node(&mut doc, 4, sp.start, sp.end, sp.escaped)\n    }\n    if b == b'{' {\n        start := p.pos\n        p.pos += 1\n        obj := alloc_node(&mut doc, 6, start, start, false)\n        skip_ws(&doc.input, &mut p)\n        if p.pos < doc.input.len && doc.input[p.pos] == b'}' {\n            p.pos += 1\n            doc.ends[obj] = p.pos\n            return obj\n        }\n        p.depth += 1\n        mut prev_child := -1\n        mut count := 0\n        while doc.ok {\n            skip_ws(&doc.input, &mut p)\n            key := scan_string(&mut doc, &mut p)\n            if !key.ok { p.depth -= 1; return -1 }\n            if !key.escaped && !bytes.decode_range(&doc.input, key.start, key.end).ok {\n                fail_doc(&mut doc, key.start, \"invalid UTF-8 in JSON key\")\n                p.depth -= 1; return -1\n            }\n            skip_ws(&doc.input, &mut p)\n            if p.pos >= doc.input.len || doc.input[p.pos] != b':' {\n                fail_doc(&mut doc, p.pos, \"expected ':' after object key\")\n                p.depth -= 1; return -1\n            }\n            p.pos += 1\n            child := scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { p.depth -= 1; return -1 }\n            doc.key_starts[child] = key.start\n            doc.key_ends[child] = key.end\n            doc.key_escaped[child] = key.escaped\n            if prev_child < 0 { doc.first_child[obj] = child }\n            else { doc.next_sibling[prev_child] = child }\n            prev_child = child\n            count += 1\n            skip_ws(&doc.input, &mut p)\n            if p.pos < doc.input.len && doc.input[p.pos] == b',' {\n                p.pos += 1\n                continue\n            }\n            if p.pos < doc.input.len && doc.input[p.pos] == b'}' {\n                p.pos += 1\n                doc.ends[obj] = p.pos\n                doc.counts[obj] = count\n                p.depth -= 1\n                return obj\n            }\n            fail_doc(&mut doc, p.pos, \"expected ',' or '}' in JSON object\")\n            p.depth -= 1\n            return -1\n        }\n        p.depth -= 1\n        return -1\n    }\n    if b == b'[' {\n        start := p.pos\n        p.pos += 1\n        arr := alloc_node(&mut doc, 5, start, start, false)\n        skip_ws(&doc.input, &mut p)\n        if p.pos < doc.input.len && doc.input[p.pos] == b']' {\n            p.pos += 1\n            doc.ends[arr] = p.pos\n            return arr\n        }\n        p.depth += 1\n        mut prev_child := -1\n        mut count := 0\n        while doc.ok {\n            child := scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { p.depth -= 1; return -1 }\n            if prev_child < 0 { doc.first_child[arr] = child }\n            else { doc.next_sibling[prev_child] = child }\n            prev_child = child\n            count += 1\n            skip_ws(&doc.input, &mut p)\n            if p.pos < doc.input.len && doc.input[p.pos] == b',' {\n                p.pos += 1\n                continue\n            }\n            if p.pos < doc.input.len && doc.input[p.pos] == b']' {\n                p.pos += 1\n                doc.ends[arr] = p.pos\n                doc.counts[arr] = count\n                p.depth -= 1\n                return arr\n            }\n            fail_doc(&mut doc, p.pos, \"expected ',' or ']' in JSON array\")\n            p.depth -= 1\n            return -1\n        }\n        p.depth -= 1\n        return -1\n    }\n    if b == b't' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"true\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'f' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 5, \"false\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 5, false)\n            p.pos += 5\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'n' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"null\") {\n            node := alloc_node(&mut doc, 1, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'-' || (b >= b'0' && b <= b'9') {\n        return scan_number(&mut doc, &mut p)\n    }\n    fail_doc(&mut doc, p.pos, \"unexpected character in JSON\")\n    -1\n}\n\n// --- Zero-Allocation Span Queries & Lazy Unescaping ---\n\nfn push_codepoint_utf8(out: &mut []u8, cp: i32) {\n    if cp <= 0x7F {\n        out.push(u8(cp))\n    } else if cp <= 0x7FF {\n        out.push(u8(0xC0.bit_or(cp.shr(6))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else if cp <= 0xFFFF {\n        out.push(u8(0xE0.bit_or(cp.shr(12))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else {\n        out.push(u8(0xF0.bit_or(cp.shr(18))))\n        out.push(u8(0x80.bit_or(cp.shr(12).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    }\n}\n\nfn unescape_span(input: &[]u8, start: i32, end: i32, has_esc: bool) -> StrField {\n    if !has_esc {\n        dec := bytes.decode_range(&input, start, end)\n        return StrField { ok: dec.ok, value: dec.value }\n    }\n    mut out: []u8 = []\n    out.reserve(end - start)\n    mut i := start\n    while i < end {\n        b := input[i]\n        if b != b'\\\\' {\n            out.push(b)\n            i += 1\n            continue\n        }\n        i += 1\n        esc := input[i]\n        if esc == b'\"' { out.push(b'\"'); i += 1 }\n        else if esc == b'\\\\' { out.push(b'\\\\'); i += 1 }\n        else if esc == b'/' { out.push(b'/'); i += 1 }\n        else if esc == b'b' { out.push(8); i += 1 }\n        else if esc == b'f' { out.push(12); i += 1 }\n        else if esc == b'n' { out.push(10); i += 1 }\n        else if esc == b'r' { out.push(13); i += 1 }\n        else if esc == b't' { out.push(9); i += 1 }\n        else if esc == b'u' {\n            mut cp := 0\n            for k in 1..5 { cp = cp * 16 + hex_val(input[i + k]) }\n            i += 5\n            if cp >= 0xD800 && cp <= 0xDBFF {\n                mut low := 0\n                for k in 2..6 { low = low * 16 + hex_val(input[i + k]) }\n                i += 6\n                cp = 0x10000 + (cp - 0xD800).shl(10) + (low - 0xDC00)\n            }\n            push_codepoint_utf8(&mut out, cp)\n        } else {\n            return StrField { ok: false, value: \"\" }\n        }\n    }\n    dec := bytes.decode(&out)\n    StrField { ok: dec.ok, value: dec.value }\n}\n\nimpl Doc {\n    pub fn parse_bytes(move input: []u8) -> Self {\n        est := input.len / 8 + 8\n        mut doc := Self {\n            ok: true, error: \"\", offset: 0, root: -1,\n            input: input, kinds: [], starts: [], ends: [], escaped: [],\n            first_child: [], next_sibling: [], key_starts: [], key_ends: [], key_escaped: [], counts: [],\n        }\n        doc.kinds.reserve(est); doc.starts.reserve(est); doc.ends.reserve(est)\n        mut p := Parser { pos: 0, depth: 0 }\n        root := scan_value(&mut doc, &mut p)\n        if !doc.ok { return doc }\n        skip_ws(&doc.input, &mut p)\n        if p.pos != doc.input.len {\n            fail_doc(&mut doc, p.pos, \"trailing characters after JSON value\")\n            return doc\n        }\n        doc.root = root\n        doc\n    }\n\n    pub fn parse_text(text: string) -> Self {\n        mut raw: []u8 = []\n        bytes.append_utf8(&mut raw, text)\n        Self::parse_bytes(move raw)\n    }\n\n    pub fn kind(&self, node: i32) -> Kind {\n        if !self.ok || node < 0 || node >= self.kinds.len { return .Invalid }\n        k := self.kinds[node]\n        if k == 1 { return .Null }\n        if k == 2 { return .Bool }\n        if k == 3 { return .Number }\n        if k == 4 { return .String }\n        if k == 5 { return .Array }\n        if k == 6 { return .Object }\n        .Invalid\n    }\n\n    pub fn count(&self, node: i32) -> i32 {\n        if !self.ok || node < 0 || node >= self.counts.len { return 0 }\n        self.counts[node]\n    }\n\n    fn key_matches(&self, child: i32, key: string) -> bool {\n        ks := self.key_starts[child]\n        ke := self.key_ends[child]\n        if !self.key_escaped[child] {\n            return bytes.equals_text(&self.input, ks, ke, key)\n        }\n        unesc := unescape_span(&self.input, ks, ke, true)\n        unesc.ok && unesc.value == key\n    }\n\n    pub fn field(&self, obj: i32, key: string) -> i32 {\n        if self.kind(obj) != .Object { return -1 }\n        mut found := -1\n        mut cur := self.first_child[obj]\n        while cur >= 0 {\n            if self.key_matches(cur, key) { found = cur }\n            cur = self.next_sibling[cur]\n        }\n        found\n    }\n\n    pub fn at(&self, arr: i32, index: i32) -> i32 {\n        if self.kind(arr) != .Array || index < 0 || index >= self.counts[arr] { return -1 }\n        mut cur := self.first_child[arr]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        cur\n    }\n\n    pub fn key_at(&self, obj: i32, index: i32) -> StrField {\n        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] {\n            return StrField { ok: false, value: \"\" }\n        }\n        mut cur := self.first_child[obj]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        unescape_span(&self.input, self.key_starts[cur], self.key_ends[cur], self.key_escaped[cur])\n    }\n\n    pub fn val_at(&self, obj: i32, index: i32) -> i32 {\n        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] { return -1 }\n        mut cur := self.first_child[obj]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        cur\n    }\n\n    pub fn as_bool(&self, node: i32) -> BoolField {\n        if self.kind(node) != .Bool { return BoolField { ok: false, value: false } }\n        BoolField { ok: true, value: self.input[self.starts[node]] == b't' }\n    }\n\n    pub fn as_i64(&self, node: i32) -> IntField {\n        if self.kind(node) != .Number { return IntField { ok: false, value: 0 } }\n        parsed := parse.i64_range(bytes.decode_range(&self.input, self.starts[node], self.ends[node]).value, 0, self.ends[node] - self.starts[node])\n        IntField { ok: parsed.ok, value: parsed.value }\n    }\n\n    pub fn as_u64(&self, node: i32) -> UintField {\n        if self.kind(node) != .Number { return UintField { ok: false, value: 0 } }\n        s := self.starts[node]; e := self.ends[node]\n        if s < e && self.input[s] == b'-' { return UintField { ok: false, value: 0 } }\n        parsed := parse.u64_range(bytes.decode_range(&self.input, s, e).value, 0, e - s)\n        UintField { ok: parsed.ok, value: parsed.value }\n    }\n\n    pub fn as_str(&self, node: i32) -> StrField {\n        if self.kind(node) != .String { return StrField { ok: false, value: \"\" } }\n        unescape_span(&self.input, self.starts[node], self.ends[node], self.escaped[node])\n    }\n\n    pub fn raw_span(&self, node: i32) -> string {\n        if !self.ok || node < 0 || node >= self.starts.len { return \"\" }\n        bytes.decode_range(&self.input, self.starts[node], self.ends[node]).value\n    }\n\n    pub fn get_bool(&self, obj: i32, key: string) -> BoolField { self.as_bool(self.field(obj, key)) }\n    pub fn get_i64(&self, obj: i32, key: string) -> IntField { self.as_i64(self.field(obj, key)) }\n    pub fn get_u64(&self, obj: i32, key: string) -> UintField { self.as_u64(self.field(obj, key)) }\n    pub fn get_str(&self, obj: i32, key: string) -> StrField { self.as_str(self.field(obj, key)) }\n}\n\n@test\nfn json_doc_impl_methods_work() {\n    doc := Doc::parse_text(\"{\\\"k\\\":\\\"v\\\",\\\"xs\\\":[1,2]}\")\n    assert(doc.ok)\n    assert(doc.get_str(doc.root, \"k\").value == \"v\")\n    xs := doc.field(doc.root, \"xs\")\n    assert(doc.count(xs) == 2)\n    assert(doc.as_i64(doc.at(xs, 1)).value == 2)\n}\n\n@test\nfn json_writer_and_zero_dom_parser_handle_nesting_unicode_and_errors() {\n    mut out: []u8 = []\n    mut first := begin_obj(&mut out)\n    field_str(&mut out, &mut first, \"kind\", \"runtime_profile\")\n    field_i32(&mut out, &mut first, \"version\", 1)\n    field_bool(&mut out, &mut first, \"ok\", true)\n    field_u64(&mut out, &mut first, \"max_u64\", 18446744073709551615)\n    field_str(&mut out, &mut first, \"msg\", \"rad1\\n\\\"åäö\\\" 🌍\")\n    mut af := begin_field_arr(&mut out, &mut first, \"items\")\n    sep_elem(&mut out, &mut af); write_i64(&mut out, -42)\n    sep_elem(&mut out, &mut af); write_null(&mut out)\n    end_arr(&mut out)\n    end_obj(&mut out)\n\n    doc := Doc::parse_bytes(out.clone())\n    assert(doc.ok)\n    assert(doc.get_str(doc.root, \"kind\").value == \"runtime_profile\")\n    assert(doc.get_i64(doc.root, \"version\").value == 1)\n    assert(doc.get_bool(doc.root, \"ok\").value)\n    assert(doc.get_u64(doc.root, \"max_u64\").value == 18446744073709551615)\n    assert(doc.get_str(doc.root, \"msg\").value == \"rad1\\n\\\"åäö\\\" 🌍\")\n    items := doc.field(doc.root, \"items\")\n    assert(doc.count(items) == 2)\n    assert(doc.as_i64(doc.at(items, 0)).value == -42)\n    assert(doc.kind(doc.at(items, 1)) == .Null)\n    out.clear()\n    assert(doc.get_str(doc.root, \"kind\").value == \"runtime_profile\")\n\n    // Surrogate pair decoding (\\uD83C\\uDF0D == 🌍) and duplicate key override (last wins).\n    sur := Doc::parse_text(\"{\\\"a\\\":1,\\\"a\\\":2,\\\"globe\\\":\\\"\\\\uD83C\\\\uDF0D\\\"}\")\n    assert(sur.ok)\n    assert(sur.get_i64(sur.root, \"a\").value == 2)\n    assert(sur.get_str(sur.root, \"globe\").value == \"🌍\")\n\n    assert(!Doc::parse_text(\"{\\\"a\\\":01}\").ok)\n    assert(!Doc::parse_text(\"{\\\"a\\\":1} trailing\").ok)\n    assert(!Doc::parse_text(\"\\\"\\\\uD800\\\"\").ok)\n}\n" }
    if name == "map" { return "import std.hash as hashing\n\npub struct Map {\n    keys: []string,\n    values: []i64,\n    slots: []i32,\n    length: i32,\n    used: i32,\n}\npub enum Lookup { Missing, Found(i64) }\n\nimpl Map {\n    pub fn new() -> Self { Self { keys: [], values: [], slots: [], length: 0, used: 0 } }\n    pub fn len(&self) -> i32 { self.length }\n    pub fn length(&self) -> i32 { self.length }\n\n    fn locate(&self, key: string) -> i32 {\n        capacity := self.slots.len\n        if capacity == 0 { return -1 }\n        mut slot := i32(hashing.hash(key) % i64(capacity))\n        for step in 0..capacity {\n            state := self.slots[slot]\n            if state == 0 { return -1 }\n            if state == 1 && self.keys[slot] == key { return slot }\n            slot = (slot + 1) % capacity\n        }\n        -1\n    }\n\n    pub fn contains(&self, key: string) -> bool { self.locate(key) >= 0 }\n\n    pub fn get(&self, key: string) -> Lookup {\n        slot := self.locate(key)\n        if slot < 0 { .Missing } else { .Found(self.values[slot]) }\n    }\n\n    pub fn get_or(&self, key: string, fallback: i64) -> i64 {\n        slot := self.locate(key)\n        if slot < 0 { fallback } else { self.values[slot] }\n    }\n\n    fn insert_slot(&mut self, move key: string, value: i64) {\n        capacity := self.slots.len\n        mut slot := i32(hashing.hash(key) % i64(capacity))\n        while self.slots[slot] == 1 { slot = (slot + 1) % capacity }\n        if self.slots[slot] == 0 { self.used = self.used + 1 }\n        self.slots[slot] = 1\n        self.keys[slot] = key\n        self.values[slot] = value\n        self.length = self.length + 1\n    }\n\n    fn rehash(&mut self, capacity: i32) {\n        mut fresh := Self::new()\n        fresh.keys.reserve(capacity)\n        fresh.values.reserve(capacity)\n        fresh.slots.reserve(capacity)\n        for i in 0..capacity { fresh.keys.push(\"\"); fresh.values.push(0); fresh.slots.push(0) }\n        while self.slots.len > 0 {\n            state := self.slots.pop()\n            value := self.values.pop()\n            key := self.keys.pop()\n            if state == 1 { fresh.insert_slot(move key, value) }\n        }\n        self = fresh\n    }\n\n    pub fn reserve(&mut self, entries: i32) {\n        assert(entries >= 0)\n        mut capacity := 8\n        while i64(capacity) * 7 < i64(entries) * 10 { capacity = capacity * 2 }\n        if capacity > self.slots.len { self.rehash(capacity) }\n    }\n\n    pub fn put(&mut self, move key: string, value: i64) {\n        existing := self.locate(key)\n        if existing >= 0 { self.values[existing] = value; return }\n        capacity := self.slots.len\n        if capacity == 0 { self.rehash(8) }\n        else if (self.used + 1) * 10 >= capacity * 7 {\n            if (self.length + 1) * 10 < capacity * 4 { self.rehash(capacity) }\n            else { self.rehash(capacity * 2) }\n        }\n        self.insert_slot(move key, value)\n    }\n\n    pub fn remove(&mut self, key: string) -> bool {\n        slot := self.locate(key)\n        if slot < 0 { return false }\n        self.slots[slot] = 2\n        self.keys[slot] = \"\"\n        self.values[slot] = 0\n        self.length = self.length - 1\n        true\n    }\n\n    pub fn clear(&mut self) {\n        for i in 0..self.slots.len { self.slots[i] = 0; self.keys[i] = \"\"; self.values[i] = 0 }\n        self.length = 0\n        self.used = 0\n    }\n\n    pub fn keys(&self) -> []string {\n        mut result: []string = []\n        result.reserve(self.length)\n        for i in 0..self.slots.len { if self.slots[i] == 1 { result.push(self.keys[i].clone()) } }\n        result\n    }\n}\n\npub fn new() -> Map { Map::new() }\npub fn length(table: &Map) -> i32 { table.length() }\npub fn contains(table: &Map, key: string) -> bool { table.contains(key) }\npub fn get(table: &Map, key: string) -> Lookup { table.get(key) }\npub fn get_or(table: &Map, key: string, fallback: i64) -> i64 { table.get_or(key, fallback) }\npub fn reserve(table: &mut Map, entries: i32) { table.reserve(entries) }\npub fn put(table: &mut Map, move key: string, value: i64) { table.put(move key, value) }\npub fn remove(table: &mut Map, key: string) -> bool { table.remove(key) }\npub fn clear(table: &mut Map) { table.clear() }\npub fn keys(table: &Map) -> []string { table.keys() }\n\n@test fn map_handles_growth_collisions_updates_removal_and_copies() {\n    mut collisions := new()\n    put(&mut collisions, \"a\", 1); put(&mut collisions, \"i\", 2); put(&mut collisions, \"q\", 3); put(&mut collisions, \"y\", 4)\n    remove(&mut collisions, \"a\")\n    put(&mut collisions, \"q\", 99)\n    length(&collisions) == 3\n    get_or(&collisions, \"q\", 0) == 99\n    get_or(&collisions, \"y\", 0) == 4\n    put(&mut collisions, \"\", -1); put(&mut collisions, \"\\0\", -2)\n    get_or(&collisions, \"\", 0) == -1\n    get_or(&collisions, \"\\0\", 0) == -2\n    mut table := new()\n    put(&mut table, \"\", -1)\n    put(&mut table, \"å 🌍\", 42)\n    for i in 0..1000 { put(&mut table, i.str(), i64(i) * 3) }\n    length(&table) == 1002\n    for i in 0..1000 { get_or(&table, i.str(), -1) == i64(i) * 3 }\n    snapshot := table.clone()\n    put(&mut table, \"å 🌍\", 99)\n    get_or(&snapshot, \"å 🌍\", 0) == 42\n    for i in 0..1000 { remove(&mut table, i.str()) }\n    length(&table) == 2\n    !remove(&mut table, \"missing\")\n    for i in 0..1000 { put(&mut table, i.str(), i64(i)) }\n    keys(&table).len == 1002\n    match get(&table, \"å 🌍\") { .Found(value) => { value == 99 }, .Missing => { assert(false) } }\n    clear(&mut table)\n    length(&table) == 0\n    !contains(&table, \"\")\n    put(&mut table, \"again\", 7)\n    get_or(&table, \"again\", 0) == 7\n}\n\n@test fn map_impl_methods_and_constructors() {\n    mut m := Map::new()\n    m.reserve(4)\n    m.put(\"k1\", 10)\n    m.put(\"k2\", 20)\n    m.len() == 2\n    m.length() == 2\n    m.contains(\"k1\")\n    m.get_or(\"k1\", -1) == 10\n    match m.get(\"k2\") { .Found(v) => { v == 20 }, .Missing => { assert(false) } }\n    m.keys().len == 2\n    m.remove(\"k1\")\n    !m.contains(\"k1\")\n    m.clear()\n    m.len() == 0\n}\n" }
    if name == "net" { return "capability network\nimport sys\n\npub fn poll_in() -> i32 { 1 }\npub fn poll_out() -> i32 { 4 }\npub fn poll_err() -> i32 { 8 }\npub fn poll_hup() -> i32 { 16 }\npub fn poll_nval() -> i32 { 32 }\npub fn err_would_block() -> i32 { 35 }\n\npub fn ipv4(a: i32, b: i32, c: i32, d: i32) -> i64 {\n    assert(a >= 0 && a <= 255 && b >= 0 && b <= 255 && c >= 0 && c <= 255 && d >= 0 && d <= 255)\n    (i64(a).shl(24)).bit_or(i64(b).shl(16)).bit_or(i64(c).shl(8)).bit_or(i64(d))\n}\npub fn loopback() -> i64 { ipv4(127, 0, 0, 1) }\npub fn any_addr() -> i64 { 0 }\n\n@resource\npub opaque struct TcpListener { fd: i32 }\n@resource\npub opaque struct TcpStream { fd: i32 }\n@resource\npub opaque struct StreamSet { fds: []i32 }\n\npub struct ListenResult { ok: bool, listener: TcpListener, error: i32 }\npub struct AcceptResult { ok: bool, would_block: bool, stream: TcpStream, error: i32 }\npub struct ConnectResult { ok: bool, stream: TcpStream, error: i32 }\npub struct IoResult { ok: bool, would_block: bool, eof: bool, count: i64, error: i32 }\npub struct PollSet {\n    fds: []i32,\n    events: []i32,\n    revents: []i32,\n    scratch: []u8,\n}\n\nfn status_from_i64(raw: i64) -> sys.Status {\n    if raw < 0 { return sys.Status { ok: false, error: i32(-raw) } }\n    sys.Status { ok: true, error: 0 }\n}\n\nfn fd_read_append(fd: i32, out: &mut []u8, max_bytes: i32) -> IoResult {\n    if max_bytes <= 0 {\n        return IoResult { ok: true, would_block: false, eof: false, count: 0, error: 0 }\n    }\n    out.reserve(out.len + max_bytes)\n    n := sys.net_read(fd, &mut out, i64(max_bytes))\n    if n < 0 {\n        err := i32(-n)\n        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n    }\n    IoResult { ok: true, would_block: false, eof: n == 0, count: n, error: 0 }\n}\n\nfn fd_write_range(fd: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {\n    n := sys.net_write(fd, &data, i64(offset), i64(length))\n    if n < 0 {\n        err := i32(-n)\n        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n    }\n    IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }\n}\n\nimpl TcpListener {\n    @requires(network)\n    pub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult {\n        raw := sys.net_listen(addr, i64(port), i64(backlog))\n        if raw < 0 {\n            return ListenResult { ok: false, listener: Self { fd: -1 }, error: i32(-raw) }\n        }\n        ListenResult { ok: true, listener: Self { fd: i32(raw) }, error: 0 }\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n\n    pub fn local_port(&self) -> i32 {\n        raw := sys.net_local_port(self.fd)\n        if raw < 0 { return -1 }\n        i32(raw)\n    }\n\n    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))\n    }\n\n    pub fn accept(&self) -> AcceptResult {\n        raw := sys.net_accept(self.fd)\n        if raw < 0 {\n            err := i32(-raw)\n            return AcceptResult { ok: false, would_block: err == 35, stream: TcpStream { fd: -1 }, error: err }\n        }\n        AcceptResult { ok: true, would_block: false, stream: TcpStream { fd: i32(raw) }, error: 0 }\n    }\n\n    pub fn close(&mut self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(self.fd))\n        self.fd = -1\n        st\n    }\n}\n\nimpl TcpStream {\n    @requires(network)\n    pub fn connect(addr: i64, port: i32) -> ConnectResult {\n        raw := sys.net_connect(addr, i64(port))\n        if raw < 0 {\n            return ConnectResult { ok: false, stream: Self { fd: -1 }, error: i32(-raw) }\n        }\n        ConnectResult { ok: true, stream: Self { fd: i32(raw) }, error: 0 }\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n\n    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))\n    }\n\n    pub fn set_nodelay(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nodelay(self.fd, enabled))\n    }\n\n    pub fn read_append(&self, out: &mut []u8, max_bytes: i32) -> IoResult {\n        fd_read_append(self.fd, &mut out, max_bytes)\n    }\n\n    pub fn write_range(&self, data: &[]u8, offset: i32, length: i32) -> IoResult {\n        fd_write_range(self.fd, &data, offset, length)\n    }\n\n    pub fn write_all(&self, data: &[]u8) -> sys.Status {\n        mut off := 0\n        while off < data.len {\n            n := sys.net_write(self.fd, &data, i64(off), i64(data.len - off))\n            if n < 0 { return sys.Status { ok: false, error: i32(-n) } }\n            if n == 0 { return sys.Status { ok: false, error: 5 } }\n            off += i32(n)\n        }\n        sys.Status { ok: true, error: 0 }\n    }\n\n    pub fn shutdown_write(&self) -> sys.Status {\n        status_from_i64(sys.net_shutdown_write(self.fd))\n    }\n\n    pub fn close(&mut self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(self.fd))\n        self.fd = -1\n        st\n    }\n}\n\nimpl PollSet {\n    pub fn new() -> Self {\n        Self { fds: [], events: [], revents: [], scratch: [] }\n    }\n\n    pub fn clear(&mut self) {\n        self.fds.clear()\n        self.events.clear()\n        self.revents.clear()\n    }\n\n    pub fn add(&mut self, fd: i32, events: i32) {\n        self.fds.push(fd)\n        self.events.push(events)\n        self.revents.push(0)\n    }\n\n    pub fn poll(&mut self, timeout_ms: i32) -> IoResult {\n        count := self.fds.len\n        assert(self.events.len == count && self.revents.len == count)\n        need := count * 8\n        if self.scratch.len < need {\n            self.scratch.reserve(need)\n            while self.scratch.len < need { self.scratch.push(0) }\n        }\n        for i in 0..count {\n            base := i * 8\n            u := i64(self.fds[i]).bit_and(0xffffffff)\n            self.scratch[base] = u8(u.bit_and(0xff))\n            self.scratch[base + 1] = u8(u.shr(8).bit_and(0xff))\n            self.scratch[base + 2] = u8(u.shr(16).bit_and(0xff))\n            self.scratch[base + 3] = u8(u.shr(24).bit_and(0xff))\n            ev := i64(self.events[i]).bit_and(0xffff)\n            self.scratch[base + 4] = u8(ev.bit_and(0xff))\n            self.scratch[base + 5] = u8(ev.shr(8).bit_and(0xff))\n            self.scratch[base + 6] = 0\n            self.scratch[base + 7] = 0\n        }\n        n := sys.net_poll(&mut self.scratch, i64(count), i64(timeout_ms))\n        if n < 0 {\n            err := i32(-n)\n            return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }\n        }\n        for i in 0..count {\n            base := i * 8\n            lo := i32(self.scratch[base + 6])\n            hi := i32(self.scratch[base + 7])\n            self.revents[i] = lo + hi.shl(8)\n        }\n        IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }\n    }\n}\n\nimpl StreamSet {\n    pub fn new() -> Self { Self { fds: [] } }\n    pub fn len(&self) -> i32 { self.fds.len }\n    pub fn fd(&self, slot: i32) -> i32 { self.fds[slot] }\n\n    pub fn insert(&mut self, move s: TcpStream) -> i32 {\n        assert(s.fd >= 0)\n        fd := s.fd\n        for i in 0..self.fds.len {\n            if self.fds[i] < 0 {\n                self.fds[i] = fd\n                return i\n            }\n        }\n        self.fds.push(fd)\n        self.fds.len - 1\n    }\n\n    pub fn read_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_read_append(fd, &mut out, max_bytes)\n    }\n\n    pub fn write_range(&self, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_write_range(fd, &data, offset, length)\n    }\n\n    pub fn shutdown_write(&self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        status_from_i64(sys.net_shutdown_write(fd))\n    }\n\n    pub fn close(&mut self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        if fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(fd))\n        self.fds[slot] = -1\n        st\n    }\n\n    pub fn close_all(&mut self) {\n        for i in 0..self.fds.len {\n            if self.fds[i] >= 0 {\n                unused := sys.net_close(self.fds[i])\n                self.fds[i] = -1\n            }\n        }\n    }\n}\n\n@requires(network)\npub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult { TcpListener::listen(addr, port, backlog) }\n\n@requires(network)\npub fn connect(addr: i64, port: i32) -> ConnectResult { TcpStream::connect(addr, port) }\n\npub fn listener_fd(l: &TcpListener) -> i32 { l.fd() }\npub fn stream_fd(s: &TcpStream) -> i32 { s.fd() }\npub fn local_port(l: &TcpListener) -> i32 { l.local_port() }\npub fn set_listener_nonblocking(l: &TcpListener, enabled: bool) -> sys.Status { l.set_nonblocking(enabled) }\npub fn accept(l: &TcpListener) -> AcceptResult { l.accept() }\npub fn close_listener(l: &mut TcpListener) -> sys.Status { l.close() }\npub fn set_nonblocking(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nonblocking(enabled) }\npub fn set_nodelay(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nodelay(enabled) }\npub fn read_append(s: &TcpStream, out: &mut []u8, max_bytes: i32) -> IoResult { s.read_append(&mut out, max_bytes) }\npub fn write_range(s: &TcpStream, data: &[]u8, offset: i32, length: i32) -> IoResult { s.write_range(&data, offset, length) }\npub fn write_all(s: &TcpStream, data: &[]u8) -> sys.Status { s.write_all(&data) }\npub fn shutdown_write(s: &TcpStream) -> sys.Status { s.shutdown_write() }\npub fn close(s: &mut TcpStream) -> sys.Status { s.close() }\n\npub fn poll_set() -> PollSet { PollSet::new() }\npub fn poll_clear(ps: &mut PollSet) { ps.clear() }\npub fn poll_add(ps: &mut PollSet, fd: i32, events: i32) { ps.add(fd, events) }\npub fn poll(ps: &mut PollSet, timeout_ms: i32) -> IoResult { ps.poll(timeout_ms) }\n\npub fn stream_set() -> StreamSet { StreamSet::new() }\npub fn set_len(set: &StreamSet) -> i32 { set.len() }\npub fn set_fd(set: &StreamSet, slot: i32) -> i32 { set.fd(slot) }\npub fn set_insert(set: &mut StreamSet, move s: TcpStream) -> i32 { set.insert(move s) }\npub fn set_read_append(set: &StreamSet, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult { set.read_append(slot, &mut out, max_bytes) }\npub fn set_write_range(set: &StreamSet, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult { set.write_range(slot, &data, offset, length) }\npub fn set_shutdown_write(set: &StreamSet, slot: i32) -> sys.Status { set.shutdown_write(slot) }\npub fn set_close(set: &mut StreamSet, slot: i32) -> sys.Status { set.close(slot) }\npub fn set_close_all(set: &mut StreamSet) { set.close_all() }\n" }
    if name == "parse" { return "pub struct Integer { ok: bool, value: i64, error: i32 }\npub struct Unsigned { ok: bool, value: u64, error: i32 }\n\nfn radix_digit(byte: i32, radix: i32) -> i32 {\n    if byte >= 48 && byte <= 57 {\n        d := byte - 48\n        if d < radix { return d }\n        return -1\n    }\n    if radix == 16 {\n        if byte >= 65 && byte <= 70 { return byte - 55 }\n        if byte >= 97 && byte <= 102 { return byte - 87 }\n    }\n    -1\n}\n\nfn parse_signed_range(text: string, start: i32, end: i32, radix: i32) -> Integer {\n    if start < 0 || end < start || end > text.len || start == end { return Integer { ok: false, value: 0, error: 1 } }\n    mut cursor := start\n    mut negative := false\n    if text[cursor] == 45 || text[cursor] == 43 { negative = text[cursor] == 45; cursor = cursor + 1 }\n    if cursor == end { return Integer { ok: false, value: 0, error: 1 } }\n    mut limit: i64 = -9223372036854775807\n    if negative { limit = -9223372036854775808 }\n    mut value: i64 = 0\n    while cursor < end {\n        d := radix_digit(text[cursor], radix)\n        if d < 0 { return Integer { ok: false, value: 0, error: 1 } }\n        if value < limit / i64(radix) { return Integer { ok: false, value: 0, error: 2 } }\n        value = value * i64(radix)\n        if value < limit + i64(d) { return Integer { ok: false, value: 0, error: 2 } }\n        value = value - i64(d)\n        cursor = cursor + 1\n    }\n    if !negative { value = -value }\n    Integer { ok: true, value: value, error: 0 }\n}\n\nfn parse_unsigned_range(text: string, start: i32, end: i32, radix: i32) -> Unsigned {\n    if start < 0 || end < start || end > text.len || start == end { return Unsigned { ok: false, value: 0, error: 1 } }\n    mut max_div: u64 = 1844674407370955161\n    mut max_rem := 5\n    if radix == 16 { max_div = 1152921504606846975; max_rem = 15 }\n    mut value: u64 = 0\n    for i in start..end {\n        d := radix_digit(text[i], radix)\n        if d < 0 { return Unsigned { ok: false, value: 0, error: 1 } }\n        if value > max_div || (value == max_div && d > max_rem) {\n            return Unsigned { ok: false, value: 0, error: 2 }\n        }\n        value = value * u64(radix) + u64(d)\n    }\n    Unsigned { ok: true, value: value, error: 0 }\n}\n\n// error: 1=invalid spelling, 2=overflow. Strict ASCII decimal, optional sign.\npub fn integer(text: string) -> Integer { Integer::parse(text) }\npub fn hex(text: string) -> Integer { Integer::hex(text) }\npub fn i64_range(text: string, start: i32, end: i32) -> Integer { Integer::range(text, start, end) }\npub fn u64_range(text: string, start: i32, end: i32) -> Unsigned { Unsigned::range(text, start, end) }\npub fn hex_u64_range(text: string, start: i32, end: i32) -> Unsigned { Unsigned::hex_range(text, start, end) }\n\nimpl Integer {\n    pub fn parse(text: string) -> Self {\n        if text.len == 0 { return Self { ok: false, value: 0, error: 1 } }\n        mut cursor := 0\n        mut negative := false\n        if text[0] == 45 || text[0] == 43 { negative = text[0] == 45; cursor = 1 }\n        if cursor == text.len { return Self { ok: false, value: 0, error: 1 } }\n        mut limit: i64 = -9223372036854775807\n        if negative { limit = -9223372036854775808 }\n        mut value: i64 = 0\n        mut previous_digit := false\n        while cursor < text.len {\n            byte := text[cursor]\n            if byte == 95 {\n                if !previous_digit || cursor + 1 == text.len || text[cursor + 1] < 48 || text[cursor + 1] > 57 { return Self { ok: false, value: 0, error: 1 } }\n                previous_digit = false\n            } else {\n                if byte < 48 || byte > 57 { return Self { ok: false, value: 0, error: 1 } }\n                if value < limit / 10 { return Self { ok: false, value: 0, error: 2 } }\n                value = value * 10\n                if value < limit + i64(byte - 48) { return Self { ok: false, value: 0, error: 2 } }\n                value = value - i64(byte - 48)\n                previous_digit = true\n            }\n            cursor = cursor + 1\n        }\n        if !negative { value = -value }\n        Self { ok: true, value: value, error: 0 }\n    }\n\n    pub fn hex(text: string) -> Self { length := text.len; parse_signed_range(text, 0, length, 16) }\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_signed_range(text, start, end, 10) }\n}\n\nimpl Unsigned {\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_unsigned_range(text, start, end, 10) }\n    pub fn hex_range(text: string, start: i32, end: i32) -> Self { parse_unsigned_range(text, start, end, 16) }\n}\n\n@test fn decimal_parser_covers_limits_separators_and_errors() {\n    integer(\"42\").value == 42\n    integer(\"-9223372036854775808\").value == -9223372036854775808\n    integer(\"9223372036854775807\").value == 9223372036854775807\n    integer(\"42_000\").value == 42000\n    integer(\"+0\").ok\n    integer(\"9223372036854775808\").error == 2\n    integer(\"-9223372036854775809\").error == 2\n    !integer(\"1__2\").ok\n    !integer(\"1_\").ok\n    !integer(\" 2\").ok\n    !integer(\"+\").ok\n    !integer(\"\").ok\n    hex(\"1a2B\").value == 6699\n    hex(\"-ff\").value == -255\n    !hex(\"1_2\").ok\n    i64_range(\"len:1024;\", 4, 8).value == 1024\n    u64_range(\"len:18446744073709551615;\", 4, 24).value == 18446744073709551615\n    u64_range(\"18446744073709551616\", 0, 20).error == 2\n    hex_u64_range(\"chunk=deadbeef;\", 6, 14).value == 3735928559\n}\n" }
