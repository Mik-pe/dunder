]); i = i + 1 }\n}\n@test fn dynamic_algorithms_preserve_independent_values() {\n    var values: []i64 = [3, -1, 9, 0, 3]\n    copy := values\n    sort(&mut values)\n    values[0] == -1\n    values[4] == 9\n    reverse(&mut values)\n    values[0] == 9\n    sum(&values) == 14\n    append(&mut values, &copy)\n    values.len == 10\n    sum(&values) == 28\n    copy[0] == 3\n}\n@test fn string_sort_handles_empty_values_unicode_duplicates_and_copies() {\n    var values: []string = [\"🌍\", \"å\", \"\", \"a\", \"a\", \"\\0\", \"ä\"]\n    original := values\n    sort_strings(&mut values)\n    values[0] == \"\"\n    values[1] == \"\\0\"\n    values[2] == \"a\"\n    values[3] == \"a\"\n    values[4] == \"ä\"\n    values[5] == \"å\"\n    values[6] == \"🌍\"\n    original[0] == \"🌍\"\n    var empty: []string = []\n    sort_strings(&mut empty)\n    empty.len == 0\n    var one: []string = [\"one\"]\n    sort_strings(&mut one)\n    one[0] == \"one\"\n}\n" }
