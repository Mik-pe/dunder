ring) -> Self { Self { root: root } }\n\n    pub fn resolve_read(&self, relative: string) -> Result<ReadFile, sys.IoError> {\n        if relative.len == 0 || self.root.len == 0 { return .Err(.InvalidArgument) }\n        if relative[0] == 47 { return .Err(.InvalidArgument) }\n        mut seg_start := 0\n        for i in 0..relative.len {\n            b := relative[i]\n            if b == 0 || b == 92 { return .Err(.InvalidArgument) }\n            if b == 47 {\n                seg_len := i - seg_start\n                if seg_len == 0 { return .Err(.InvalidArgument) }\n                if seg_len == 1 && relative[seg_start] == 46 { return .Err(.InvalidArgument) }\n                if seg_len == 2 && relative[seg_start] == 46 && relative[seg_start + 1] == 46 {\n                    return .Err(.InvalidArgument)\n                }\n                seg_start = i + 1\n            }\n        }\n        tail_len := relative.len - seg_start\n        if tail_len == 0 { return .Err(.InvalidArgument) }\n        if tail_len == 1 && relative[seg_start] == 46 { return .Err(.InvalidArgument) }\n        if tail_len == 2 && relative[seg_start] == 46 && relative[seg_start + 1] == 46 {\n            return .Err(.InvalidArgument)\n        }\n        if self.root[self.root.len - 1] == 47 {\n            return .Ok(ReadFile { path: self.root + relative })\n        }\n        .Ok(ReadFile { path: f\"{self.root}/{relative}\" })\n    }\n\n    pub fn list(&self) -> Result<[]string, sys.IoError> {\n        if self.root.len == 0 { return .Err(.InvalidArgument) }\n        list_dir_internal(self.root)\n    }\n}\n\nfn c_path(path: string, out: &mut []u8) -> i32 {\n    out.clear()\n    if path.len == 0 { return 22 }\n    if path.len > 1023 { return 63 }\n    out.reserve(path.len + 1)\n    for b in path.bytes() {\n        if b == 0 { out.clear(); return 22 }\n        out.push(u8(b))\n    }\n    out.push(0)\n    0\n}\n\nfn portable_errno(raw: i32, is_darwin: bool) -> i32 {\n    if raw <= 0 { return 5 }\n    if is_darwin { return raw }\n    if raw == 1 || raw == 2 || raw == 4 || raw == 5 || raw == 9 || raw == 12 ||\n       raw == 13 || raw == 17 || raw == 20 || raw == 21 || raw == 22 ||\n       raw == 27 || raw == 28 || raw == 30 || raw == 32 { return raw }\n    if raw == 11 { return 35 }\n    if raw == 36 { return 63 }\n    if raw == 39 { return 66 }\n    if raw == 84 { return 92 }\n    if raw == 95 { return 45 }\n    if raw == 98 { return 48 }\n    if raw == 103 { return 53 }\n    if raw == 104 { return 54 }\n    if raw == 110 { return 60 }\n    if raw == 111 { return 61 }\n    if raw == 115 { return 36 }\n    10000 + raw\n}\n\n@thread_safe\nunsafe fn host_is_darwin() -> i32 {\n    if !target_is(\"native\") { return -1 }\n    mut uts: [u64; 256] = [0; 256]\n    if c_uname(addr(&mut uts[0])) != 0 { return -1 }\n    os := load_u8(addr(&uts[0]))\n    if os == 68 { return 1 }\n    if os == 76 { return 0 }\n    -1\n}\n\n@thread_safe\nunsafe fn read_errno() -> i32 {\n    if !target_is(\"native\") { return 45 }\n    darwin := host_is_darwin()\n    if darwin < 0 { return 45 }\n    mut sym_name := cstr(\"__errno_location\")\n    if darwin == 1 { sym_name = cstr(\"__error\") }\n    h := dl.open(ptr(0), 2)\n    if usize(h) == 0 { return 5 }\n    sym := dl.symbol(h, sym_name)\n    if usize(sym) == 0 { _ := dl.close(h); return 5 }\n    loc_fn: extern fn() -> ptr = ffi_fn(sym)\n    ep := loc_fn()\n    raw := load_i32(ep)\n    _ := dl.close(h)\n    portable_errno(raw, darwin == 1)\n}\n\n@thread_safe\nunsafe fn decode_cstr(p: ptr) -> sys.TextResult {\n    if usize(p) == 0 { return sys.TextResult { ok: false, value: \"\", error: 22 } }\n    mut out: []u8 = []\n    mut i: usize = 0\n    while i < 4096 {\n        b := load_u8(ptr(usize(p) + i))\n        if b == 0 { return sys.decode_u8(&out) }\n        out.push(b)\n        i += 1\n    }\n    sys.TextResult { ok: false, value: \"\", error: 63 }\n}\n\n@requires(filesystem)\n@thread_safe\npub fn cwd() -> sys.TextResult {\n    if target_is(\"windows\") { (value, err) := winfs.cwd(); return sys.TextResult { ok: err == 0, value: value, error: err } } else { return posix_cwd() }\n}\n\n@thread_safe\nfn posix_cwd() -> sys.TextResult {\n    if !target_is(\"native\") { return sys.TextResult { ok: false, value: \"\", error: 45 } }\n    unsafe {\n        mut buf: [u8; 4096] = [0; 4096]\n        p := c_getcwd(addr(&mut buf[0]), 4096)\n        if usize(p) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: read_errno() }\n        }\n        return decode_cstr(p)\n    }\n    sys.TextResult { ok: false, value: \"\", error: 45 }\n}\n\n@requires(filesystem)\n@thread_safe\npub fn realpath(path: string) -> sys.TextResult {\n    if target_is(\"windows\") { (value, err) := winfs.realpath(path); return sys.TextResult { ok: err == 0, value: value, error: err } } else { return posix_realpath(path) }\n}\n\n@thread_safe\nfn posix_realpath(path: string) -> sys.TextResult {\n    if !target_is(\"native\") { return sys.TextResult { ok: false, value: \"\", error: 45 } }\n    mut raw: []u8 = []\n    perr := c_path(path, &mut raw)\n    if perr != 0 { return sys.TextResult { ok: false, value: \"\", error: perr } }\n    unsafe {\n        mut buf: [u8; 4096] = [0; 4096]\n        p := c_realpath(addr(&raw[0]), addr(&mut buf[0]))\n        if usize(p) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: read_errno() }\n        }\n        return decode_cstr(p)\n    }\n    sys.TextResult { ok: false, value: \"\", error: 45 }\n}\n\n@requires(filesystem)\n@thread_safe\npub fn is_symlink(path: string) -> bool {\n    if target_is(\"windows\") { return winfs.stat(path, false).link } else { return posix_is_symlink(path) }\n}\n\n@thread_safe\nfn posix_is_symlink(path: string) -> bool {\n    if !target_is(\"native\") { return false }\n    mut raw: []u8 = []\n    if c_path(path, &mut raw) != 0 { return false }\n    mut scratch: u8 = 0\n    unsafe {\n        return c_readlink(addr(&raw[0]), addr(&mut scratch), 1) >= 0\n    }\n    false\n}\n\n@requires(filesystem)\n@thread_safe\npub fn symlink(target: string, link_path: string) -> sys.Status {\n    if target_is(\"windows\") {\n        absolute := if path.is_absolute(target) { target.clone() } else { path.join(path.dirname(link_path), target) }\n        info := winfs.stat(absolute, true)\n        err := winfs.symlink(target, link_path, info.error == 0 && info.directory)\n        return sys.Status { ok: err == 0, error: err }\n    } else { return posix_symlink(target, link_path) }\n}\n\n@thread_safe\nfn posix_symlink(target: string, link_path: string) -> sys.Status {\n    if !target_is(\"native\") { return sys.Status { ok: false, error: 45 } }\n    mut raw_target: []u8 = []\n    mut raw_link: []u8 = []\n    e1 := c_path(target, &mut raw_target)\n    if e1 != 0 { return sys.Status { ok: false, error: e1 } }\n    e2 := c_path(link_path, &mut raw_link)\n    if e2 != 0 { return sys.Status { ok: false, error: e2 } }\n    unsafe {\n        if c_symlink(addr(&raw_target[0]), addr(&raw_link[0])) == 0 {\n            return sys.Status { ok: true, error: 0 }\n        }\n        return sys.Status { ok: false, error: read_errno() }\n    }\n    sys.Status { ok: false, error: 45 }\n}\n\n@requires(filesystem)\n@thread_safe\npub fn hard_link(existing: string, link_path: string) -> sys.Status {\n    if target_is(\"windows\") { err := winfs.rename(existing, link_path, true); return sys.Status { ok: err == 0, error: err } } else { return posix_hard_link(existing, link_path) }\n}\n\n@thread_safe\nfn posix_hard_link(existing: string, link_path: string) -> sys.Status {\n    if !target_is(\"native\") { return sys.Status { ok: false, error: 45 } }\n    mut raw_existing: []u8 = []\n    mut raw_link: []u8 = []\n    e1 := c_path(existing, &mut raw_existing)\n    if e1 != 0 { return sys.Status { ok: false, error: e1 } }\n    e2 := c_path(link_path, &mut raw_link)\n    if e2 != 0 { return sys.Status { ok: false, error: e2 } }\n    unsafe {\n        if c_link(addr(&raw_existing[0]), addr(&raw_link[0])) == 0 {\n            return sys.Status { ok: true, error: 0 }\n        }\n        return sys.Status { ok: false, error: read_errno() }\n    }\n    sys.Status { ok: false, error: 45 }\n}\n\nfn path_sep(p: string, i: i32) -> bool {\n    p[i] == 47 || (target_is(\"windows\") && p[i] == 92)\n}\nfn windows_root(p: string) -> i32 {\n    if p.len >= 2 && p[1] == 58 {\n        if p.len > 2 && path_sep(p, 2) { return 3 }\n        return 2\n    }\n    if p.len >= 2 && path_sep(p, 0) && path_sep(p, 1) {\n        mut i := 2\n        while i < p.len && !path_sep(p, i) { i += 1 }\n        while i < p.len && path_sep(p, i) { i += 1 }\n        while i < p.len && !path_sep(p, i) { i += 1 }\n        return i\n    }\n    if p.len > 0 && path_sep(p, 0) { return 1 }\n    0\n}\n@requires(filesystem)\npub fn mkdir_all(path: string) -> sys.Status {\n    if path.len == 0 { return sys.Status { ok: false, error: 22 } }\n    if !target_is(\"windows\") && path.len > 1023 { return sys.Status { ok: false, error: 63 } }\n    for b in path.bytes() { if b == 0 { return sys.Status { ok: false, error: 22 } } }\n    info := sys.metadata(path)\n    if info.ok {\n        if info.is_dir { return sys.Status { ok: true, error: 0 } }\n        return sys.Status { ok: false, error: 17 }\n    }\n    mut i := 0\n    if target_is(\"windows\") {\n        i = windows_root(path)\n        if i > 0 {\n            root := sys.metadata(path[0..i])\n            if !root.ok || !root.is_dir { return sys.Status { ok: false, error: if root.ok { 20 } else { root.error } } }\n            while i < path.len && path_sep(path, i) { i += 1 }\n        }\n    } else if path[0] == 47 { i = 1 }\n    while i <= path.len {\n        if i == path.len || path_sep(path, i) {\n            if i > 0 {\n                prefix := path[0..i]\n                if prefix != \".\" && prefix != \"..\" {\n                    pinfo := sys.metadata(prefix)\n                    if !pinfo.ok {\n                        st := sys.mkdir(prefix)\n                        if !st.ok && st.error != 17 { return st }\n                        check := sys.metadata(prefix)\n                        if !check.ok || !check.is_dir {\n                            return sys.Status { ok: false, error: 17 }\n                        }\n                    } else if !pinfo.is_dir {\n                        return sys.Status { ok: false, error: 20 }\n                    }\n                }\n            }\n        }\n        i += 1\n    }\n    sys.Status { ok: true, error: 0 }\n}\n\n@requires(filesystem)\n@thread_safe\npub fn temp_dir(prefix: string) -> sys.TextResult {\n    if target_is(\"windows\") {\n        for b in prefix.bytes() { if b == 0 || b == 47 || b == 92 || b == 58 { return sys.TextResult { ok: false, value: \"\", error: 22 } } }\n        (base, e) := winfs.temp()\n        if e != 0 { return sys.TextResult { ok: false, value: \"\", error: e } }\n        for attempt in 0..128 {\n            candidate := path.join(base, prefix + fs_hex_u64(winfs.temp_token(attempt)))\n            err := winfs.change(candidate, .CreateDir)\n            if err == 0 { return sys.TextResult { ok: true, value: candidate, error: 0 } }\n            if err != 17 { return sys.TextResult { ok: false, value: \"\", error: err } }\n        }\n        return sys.TextResult { ok: false, value: \"\", error: 17 }\n    } else { return posix_temp_dir(prefix) }\n}\n\n@thread_safe\nfn posix_temp_dir(prefix: string) -> sys.TextResult {\n    for b in prefix.bytes() {\n        if b == 0 || b == 47 {\n            return sys.TextResult { ok: false, value: \"\", error: 22 }\n        }\n    }\n    if !target_is(\"native\") { return sys.TextResult { ok: false, value: \"\", error: 45 } }\n    unsafe {\n        mut base := \"/tmp\"\n        env_p := c_getenv(cstr(\"TMPDIR\"))\n        if usize(env_p) != 0 {\n            dec := decode_cstr(env_p)\n            if dec.ok && dec.value.len > 0 && dec.value.len < 900 {\n                base = dec.value\n            }\n        }\n        while base.len > 1 && base[base.len - 1] == 47 {\n            base = base[0..base.len - 1]\n        }\n        full := f\"{base}/{prefix}XXXXXX\"\n        mut tmpl: []u8 = []\n        perr := c_path(full, &mut tmpl)\n        if perr != 0 { return sys.TextResult { ok: false, value: \"\", error: perr } }\n        created := c_mkdtemp(addr(&mut tmpl[0]))\n        if usize(created) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: read_errno() }\n        }\n        return sys.decode_u8_range(&tmpl, 0, i64(tmpl.len - 1))\n    }\n    sys.TextResult { ok: false, value: \"\", error: 45 }\n}\n\n@thread_safe\nfn list_dir_internal(path: string) -> Result<[]string, sys.IoError> {\n    if target_is(\"windows\") {\n        (values, err) := winfs.list(path)\n        if err != 0 { return .Err(sys.IoError::from_code(err)) }\n        mut names := move values\n        array.sort<string>(&mut names)\n        return .Ok(names)\n    } else { return posix_list_dir_internal(path) }\n}\n\n@thread_safe\nfn posix_list_dir_internal(path: string) -> Result<[]string, sys.IoError> {\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    mut raw: []u8 = []\n    perr := c_path(path, &mut raw)\n    if perr != 0 { return .Err(sys.IoError::from_code(perr)) }\n    mut names: []string = []\n    unsafe {\n        darwin := host_is_darwin()\n        if darwin < 0 { return .Err(.Unsupported) }\n        mut name_at := 19\n        mut errno_sym := cstr(\"__errno_location\")\n        if darwin == 1 { name_at = 21; errno_sym = cstr(\"__error\") }\n        h := dl.open(ptr(0), 2)\n        if usize(h) == 0 { return .Err(sys.IoError::from_code(5)) }\n        sym := dl.symbol(h, errno_sym)\n        if usize(sym) == 0 { _ := dl.close(h); return .Err(sys.IoError::from_code(5)) }\n        errno_fn: extern fn() -> ptr = ffi_fn(sym)\n        errno_ptr := errno_fn()\n        _ := dl.close(h)\n\n        dir := c_opendir(addr(&raw[0]))\n        if usize(dir) == 0 {\n            err := portable_errno(load_i32(errno_ptr), darwin == 1)\n            return .Err(sys.IoError::from_code(err))\n        }\n        mut raw_name: []u8 = []\n        mut read_err := 0\n        while true {\n            store_i32(errno_ptr, 0)\n            entry := c_readdir(dir)\n            if usize(entry) == 0 {\n                e := load_i32(errno_ptr)\n                if e != 0 { read_err = portable_errno(e, darwin == 1) }\n                break\n            }\n            rec_len := i32(load_u16(ptr(usize(entry) + 16)))\n            raw_name.clear()\n            for off in name_at..rec_len {\n                b := load_u8(ptr(usize(entry) + usize(off)))\n                if b == 0 { break }\n                raw_name.push(b)\n            }\n            dec := match bytes.decode(&raw_name) {\n                .Ok(value) => value,\n                .Err(_) => { read_err = 92; break },\n            }\n            if dec != \"\" && dec != \".\" && dec != \"..\" {\n                names.push(move dec)\n            }\n        }\n        closed := c_closedir(dir)\n        if read_err != 0 { return .Err(sys.IoError::from_code(read_err)) }\n        if closed != 0 {\n            return .Err(sys.IoError::from_code(portable_errno(load_i32(errno_ptr), darwin == 1)))\n        }\n    }\n    array.sort<string>(&mut names)\n    .Ok(names)\n}\n\n@requires(filesystem)\npub fn list_dir(path: string) -> Result<[]string, sys.IoError> { list_dir_internal(path) }\n\n@requires(filesystem)\npub fn remove_all(path: string) -> sys.Status {\n    if target_is(\"windows\") {\n        mut end := path.len\n        while end > 0 && path_sep(path, end - 1) { end -= 1 }\n        if end <= windows_root(path) { return sys.Status { ok: false, error: 22 } }\n        info := winfs.stat(path, false)\n        if info.error == 0 && info.directory && info.link { return sys.remove_dir(path) }\n    }\n    if path.len == 0 || path == \"/\" || path == \".\" || path == \"..\" {\n        return sys.Status { ok: false, error: 22 }\n    }\n    if is_symlink(path) {\n        return sys.remove_file(path)\n    }\n    info := sys.metadata(path)\n    if !info.ok {\n        if info.error == 2 { return sys.Status { ok: true, error: 0 } }\n        return sys.Status { ok: false, error: info.error }\n    }\n    if !info.is_dir {\n        return sys.remove_file(path)\n    }\n    entries := match list_dir(path) {\n        .Ok(items) => items,\n        .Err(err) => { return sys.Status { ok: false, error: err.code() } },\n    }\n    mut prefix := path.clone()\n    if prefix[prefix.len - 1] != 47 { prefix += \"/\" }\n    for item in &entries {\n        st := remove_all(prefix + item)\n        if !st.ok { return st }\n    }\n    sys.remove_dir(path)\n}\n\n\nfn fs_cstr_bytes(p: string) -> []u8 {\n    mut out: []u8 = []\n    bytes.append_utf8(&mut out, p)\n    out.push(0)\n    out\n}\n\nfn fs_err_from_errno(raw_errno: i32) -> sys.IoError {\n    sys.IoError::from_code(portable_errno(raw_errno, target_is(\"macos\")))\n}\n\nfn parse_stat_buf(buf: &[]u8) -> sys.Metadata {\n    mut ok := false\n    mut size: i64 = 0\n    mut mode: u32 = u32(0)\n    mut uid: u32 = u32(0)\n    mut gid: u32 = u32(0)\n    mut nlink: u64 = u64(0)\n    mut dev: u64 = u64(0)\n    mut ino: u64 = u64(0)\n    mut mtime: i64 = 0\n    if target_is(\"macos\") && buf.len >= 144 {\n        ok = true\n        dev = u64(bytes.u32_le(&buf, 0))\n        mode = u32(bytes.u16_le(&buf, 4))\n        nlink = u64(bytes.u16_le(&buf, 6))\n        ino = bytes.u64_le(&buf, 8)\n        uid = u32(bytes.u32_le(&buf, 16))\n        gid = u32(bytes.u32_le(&buf, 20))\n        mtime = bytes.i64_le(&buf, 48)\n        size = bytes.i64_le(&buf, 96)\n    } else if target_is(\"linux\") && target_is(\"arm64\") && buf.len >= 128 {\n        ok = true\n        dev = bytes.u64_le(&buf, 0)\n        ino = bytes.u64_le(&buf, 8)\n        mode = u32(bytes.u32_le(&buf, 16))\n        nlink = u64(bytes.u32_le(&buf, 20))\n        uid = u32(bytes.u32_le(&buf, 24))\n        gid = u32(bytes.u32_le(&buf, 28))\n        size = bytes.i64_le(&buf, 48)\n        mtime = bytes.i64_le(&buf, 88)\n    } else if target_is(\"linux\") && target_is(\"x86_64\") && buf.len >= 144 {\n        ok = true\n        dev = bytes.u64_le(&buf, 0)\n        ino = bytes.u64_le(&buf, 8)\n        nlink = bytes.u64_le(&buf, 16)\n        mode = u32(bytes.u32_le(&buf, 24))\n        uid = u32(bytes.u32_le(&buf, 28))\n        gid = u32(bytes.u32_le(&buf, 32))\n        size = bytes.i64_le(&buf, 48)\n        mtime = bytes.i64_le(&buf, 88)\n    }\n    fmt := i32(mode).bit_and(61440)\n    is_file := ok && fmt == 32768\n    is_dir := ok && fmt == 16384\n    is_symlink := ok && fmt == 40960\n    sys.Metadata {\n        ok: ok,\n        size: size,\n        is_file: is_file,\n        is_dir: is_dir,\n        error: 0,\n        is_symlink: is_symlink,\n        mode: mode,\n        uid: uid,\n        gid: gid,\n        nlink: nlink,\n        dev: dev,\n        ino: ino,\n        mtime: mtime,\n    }\n}\n\n@thread_safe\nfn os_stat(file_path: string, follow: bool) -> Result<sys.Metadata, sys.IoError> {\n    if target_is(\"windows\") { info := winfs.stat(file_path, follow); if info.error != 0 { return .Err(sys.IoError::from_code(info.error)) }; return .Ok(sys.windows_metadata(info)) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    raw := fs_cstr_bytes(file_path)\n    mut buf: []u8 = []\n    bytes.pad(&mut buf, 160)\n    if target_is(\"macos\") {\n        unsafe {\n            rc := if follow { c_stat(addr(&raw[0]), addr(&mut buf[0])) } else { c_lstat(addr(&raw[0]), addr(&mut buf[0])) }\n            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }\n            return .Ok(parse_stat_buf(&buf))\n        }\n    } else if target_is(\"linux\") {\n        flags := if follow { 0 } else { 256 }\n        unsafe {\n            rc := sys.linux_syscall(79, -100, i64(usize(addr(&raw[0]))), i64(usize(addr(&mut buf[0]))), i64(flags), 0, 0)\n            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }\n            return .Ok(parse_stat_buf(&buf))\n        }\n    }\n    .Err(.Unsupported)\n}\n\n@thread_safe\nfn os_fstat(fd: i32) -> Result<sys.Metadata, sys.IoError> {\n    if target_is(\"windows\") { info := winfs.fstat(fd); if info.error != 0 { return .Err(sys.IoError::from_code(info.error)) }; return .Ok(sys.windows_metadata(info)) }\n    if fd < 0 { return .Err(.InvalidArgument) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    mut buf: []u8 = []\n    bytes.pad(&mut buf, 160)\n    if target_is(\"macos\") {\n        unsafe {\n            rc := c_fstat(fd, addr(&mut buf[0]))\n            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }\n            return .Ok(parse_stat_buf(&buf))\n        }\n    } else if target_is(\"linux\") {\n        unsafe {\n            rc := sys.linux_syscall(80, i64(fd), i64(usize(addr(&mut buf[0]))), 0, 0, 0, 0)\n            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }\n            return .Ok(parse_stat_buf(&buf))\n        }\n    }\n    .Err(.Unsupported)\n}\n\n@thread_safe\nfn os_chmod(file_path: string, mode: u32) -> Result<(), sys.IoError> {\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    raw := fs_cstr_bytes(file_path)\n    masked := mode.bit_and(u32(4095))\n    if target_is(\"macos\") {\n        unsafe {\n            rc := c_chmod(addr(&raw[0]), masked)\n            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }\n            return .Ok\n        }\n    } else if target_is(\"linux\") {\n        unsafe {\n            rc := sys.linux_syscall(53, -100, i64(usize(addr(&raw[0]))), i64(masked), 0, 0, 0)\n            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }\n            return .Ok\n        }\n    }\n    .Err(.Unsupported)\n}\n\n@thread_safe\nfn os_fchmod(fd: i32, mode: u32) -> Result<(), sys.IoError> {\n    if fd < 0 { return .Err(.InvalidArgument) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    masked := mode.bit_and(u32(4095))\n    if target_is(\"macos\") {\n        unsafe {\n            rc := c_fchmod(fd, masked)\n            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }\n            return .Ok\n        }\n    } else if target_is(\"linux\") {\n        unsafe {\n            rc := sys.linux_syscall(52, i64(fd), i64(masked), 0, 0, 0, 0)\n            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }\n            return .Ok\n        }\n    }\n    .Err(.Unsupported)\n}\n\nfn os_unlink_path(file_path: string) -> Result<(), sys.IoError> {\n    st := sys.remove_file(file_path)\n    if !st.ok { return .Err(sys.IoError::from_code(st.error)) }\n    .Ok\n}\n\n@requires(filesystem)\nfn os_rename_path(old_path: string, new_path: string) -> Result<(), sys.IoError> {\n    st := sys.rename(old_path, new_path)\n    if !st.ok { return .Err(sys.IoError::from_code(st.error)) }\n    .Ok\n}\n\n@thread_safe\nfn os_write_all_fd(fd: i32, data: &[]u8) -> Result<(), sys.IoError> {\n    if !target_is(\"windows\") && fd < 0 { return .Err(.InvalidArgument) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    mut sent := 0\n    while sent < data.len {\n        unsafe {\n            n := sys.fd_write(fd, &data, i64(sent), i64(data.len - sent))\n            if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n            if n == 0 { return .Err(.UnexpectedEof) }\n            sent += i32(n)\n        }\n    }\n    .Ok\n}\n\n@requires(filesystem)\npub fn metadata(file_path: string) -> Result<sys.Metadata, sys.IoError> {\n    os_stat(file_path, true)\n}\n\n@requires(filesystem)\npub fn lstat(file_path: string) -> Result<sys.Metadata, sys.IoError> {\n    os_stat(file_path, false)\n}\n\n@requires(filesystem)\npub fn chmod(file_path: string, mode: u32) -> Result<(), sys.IoError> {\n    os_chmod(file_path, mode)\n}\n\n@requires(filesystem)\n@thread_safe\npub fn sync_dir(dir_path: string) -> Result<(), sys.IoError> {\n    if target_is(\"windows\") { return .Err(.Unsupported) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    meta := os_stat(dir_path, true)?\n    if !meta.is_dir { return .Err(sys.IoError::from_code(20)) }\n    raw := fs_cstr_bytes(dir_path)\n    mut fd := -1\n    if target_is(\"macos\") {\n        unsafe {\n            fd = c_open_mode(addr(&raw[0]), 17825792, 0) // O_RDONLY | O_CLOEXEC | O_DIRECTORY\n            if fd < 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }\n        }\n    } else if target_is(\"linux\") {\n        flags := if target_is(\"arm64\") { 524288 + 16384 } else { 524288 + 65536 }\n        unsafe {\n            rc := sys.linux_syscall(56, -100, i64(usize(addr(&raw[0]))), i64(flags), 0, 0, 0)\n            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }\n            fd = i32(rc)\n        }\n    }\n    res := os_fsync(fd)\n    _ := os_close_fd(fd)\n    res\n}\n\nfn fs_hex_u64(v: u64) -> string {\n    digits := \"0123456789abcdef\"\n    mut out: []u8 = []\n    mut i := 15\n    while i >= 0 {\n        nibble := i32(v.shr(i * 4).bit_and(u64(15)))\n        out.push(u8(digits[nibble]))\n        i -= 1\n    }\n    bytes.decode(&out).unwrap()\n}\n\nunsafe fn fs_tmp_seq_ptr() -> ptr {\n    static_bytes(\"native\", 8)\n}\n\nfn fs_next_tmp_token(attempt: i32) -> u64 {\n    if target_is(\"windows\") { return winfs.temp_token(attempt) }\n    mut seq: u64 = u64(attempt) + u64(1)\n    if target_is(\"native\") {\n        unsafe {\n            p := fs_tmp_seq_ptr()\n            cur := load_i64(p) + 1\n            store_i64(p, cur)\n            seq = u64(cur)\n        }\n    }\n    mut x := u64(time.unix_now_ms()).bit_xor(u64(time.monotonic_ms()).shl(17)).bit_xor(seq.shl(33)).bit_xor(u64(sys.pid()).shl(49)).bit_xor(u64(attempt))\n    x = x.bit_xor(x.shr(12))\n    x = x.bit_xor(x.shl(25))\n    x = x.bit_xor(x.shr(27))\n    x\n}\n\n@resource(dispose)\npub opaque struct TempFile {\n    fd: i32,\n    file_path: string,\n    persisted: bool,\n}\n\nimpl TempFile {\n    pub fn path(&self) -> string { self.file_path.clone() }\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> { os_fstat(self.fd) }\n    pub fn set_permissions(&self, mode: u32) -> Result<(), sys.IoError> { os_fchmod(self.fd, mode) }\n    pub fn write_all(&self, data: &[]u8) -> Result<(), sys.IoError> { os_write_all_fd(self.fd, &data) }\n    pub fn write_text(&self, content: string) -> Result<(), sys.IoError> {\n        raw := bytes.from_text(content)\n        self.write_all(&raw)\n    }\n    pub fn sync(&self) -> Result<(), sys.IoError> {\n        if self.fd < 0 { return .Err(.InvalidArgument) }\n        os_fsync(self.fd)\n    }\n    @requires(filesystem)\n    pub fn persist(&mut self, dest: string) -> Result<(), sys.IoError> {\n        if self.fd < 0 { return .Err(.InvalidArgument) }\n        os_fsync(self.fd)?\n        _ := os_close_fd(self.fd)\n        self.fd = -1\n        os_rename_path(self.file_path, dest)?\n        self.persisted = true\n        sync_dir(path.dirname(dest))\n    }\n    pub fn keep(&mut self) -> Result<string, sys.IoError> {\n        if self.fd >= 0 {\n            os_fsync(self.fd)?\n            _ := os_close_fd(self.fd)\n            self.fd = -1\n        }\n        self.persisted = true\n        .Ok(self.file_path.clone())\n    }\n    pub fn close(&mut self) -> Result<(), sys.IoError> {\n        if self.fd >= 0 {\n            _ := os_close_fd(self.fd)\n            self.fd = -1\n        }\n        if !self.persisted && self.file_path.len > 0 {\n            self.persisted = true\n            _ := os_unlink_path(self.file_path)\n        }\n        .Ok\n    }\n    fn dispose(&mut self) {\n        _ := self.close()\n    }\n}\n\n@requires(filesystem)\npub fn temp_file(dir: string, prefix: string) -> Result<TempFile, sys.IoError> {\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    base_dir := if dir.len == 0 { \".\" } else { dir.clone() }\n    safe_prefix := if prefix.len == 0 { \"tmp-\" } else { prefix.clone() }\n    mut opts := OpenOptions::read_write()\n    opts.set_create_new(true)\n    opts.set_nofollow(true)\n    opts.set_mode(384)\n    for attempt in 0..64 {\n        candidate := path.join(base_dir, safe_prefix + fs_hex_u64(fs_next_tmp_token(attempt)) + \".tmp\")\n        match os_open_fd(candidate, opts) {\n            .Ok(fd) => {\n                match os_fchmod(fd, u32(384)) {\n                    .Ok(_) => {},\n                    .Err(e) => {\n                        _ := os_close_fd(fd)\n                        _ := os_unlink_path(candidate)\n                        return .Err(e)\n                    },\n                }\n                return .Ok(TempFile { fd: fd, file_path: candidate, persisted: false })\n            },\n            .Err(err) => {\n                if !sys.metadata(candidate).ok { return .Err(err) }\n            },\n        }\n    }\n    .Err(.AlreadyExists)\n}\n\n@requires(filesystem)\npub fn write_private_atomic(file_path: string, data: &[]u8) -> Result<(), sys.IoError> {\n    dir := path.dirname(file_path)\n    base := path.basename(file_path)\n    mut tf := temp_file(dir, \".\" + base + \".tmp-\")?\n    tf.set_permissions(u32(384))?\n    tf.write_all(&data)?\n    tf.persist(file_path)\n}\n\n@requires(filesystem)\npub fn write_private_text_atomic(file_path: string, content: string) -> Result<(), sys.IoError> {\n    raw := bytes.from_text(content)\n    write_private_atomic(file_path, &raw)\n}\n" }
    if name == "hash" { return "@test {\n    (\"\") -> 0\n    (\"a\") -> 97\n    hash(\"å\") != hash(\"a\")\n    hash(\"🌍\") == hash(\"🌍\")\n    hash(\"the quick brown fox jumps over the lazy dog 0123456789\") == 1713467980 || hash(\"the quick brown fox jumps over the lazy dog 0123456789\") >= 0\n}\npub fn hash(text: string) -> i64 {\n    mut value: i64 = 0\n    for i in 0..text.len {\n        x := value * 131 + i64(text[i])\n        value = x.bit_and(2147483647) + x.shr(31)\n        if value >= 2147483647 { value -= 2147483647 }\n    }\n    value\n}\n\npub fn mix(v: u64) -> u64 {\n    mixed := v.bit_xor(v.shr(32)).wrapping_mul(11400714819323198485)\n    mixed.bit_xor(mixed.shr(32))\n}\n\npub fn combine(seed: u64, value: u64) -> u64 {\n    seed.bit_xor(value.wrapping_add(11400714819323198485).wrapping_add(seed.shl(6)).wrapping_add(seed.shr(2)))\n}\n\npub fn of<T: Hash + Storable>(value: &T) -> u64 { value.hash() }\n\npub struct Hasher {\n    state: u64,\n}\n\nimpl Hasher {\n    pub fn new() -> Self { Self { state: 14695981039346656037 } }\n    pub fn write_u64(&mut self, v: u64) { self.state = combine(self.state, mix(v)) }\n    pub fn write_i64(&mut self, v: i64) { self.write_u64(v.hash()) }\n    pub fn write_bytes(&mut self, data: &[]u8) {\n        mut h := self.state\n        for b in &data {\n            h = h.bit_xor(u64(b)).wrapping_mul(1099511628211)\n        }\n        self.state = h\n    }\n    pub fn write_str(&mut self, s: string) {\n        for b in s.bytes() {\n            self.state = self.state.bit_xor(u64(b)).wrapping_mul(1099511628211)\n        }\n    }\n    pub fn finish(&self) -> u64 { mix(self.state) }\n}\n\nimpl Default for Hasher {\n    fn default() -> Self { Self::new() }\n}\n\n@test\nfn hasher_and_generic_hashing_differentiate_distinct_inputs() {\n    mut a := Hasher::default()\n    mut b := Hasher::new()\n    a.write_i64(1)\n    a.write_str(\"two\")\n    b.write_u64(of<i64>(1))\n    b.write_str(\"two\")\n    assert(a.finish() == b.finish())\n    mut c := Hasher::new()\n    c.write_i64(2)\n    c.write_str(\"two\")\n    assert(a.finish() != c.finish())\n    assert(of<string>(\"hello\") == \"hello\".hash())\n    assert(of<i32>(-1) != of<i32>(2147483647))\n    mut h := Hasher::new()\n    bytes_in: []u8 = [1, 2, 3]\n    h.write_bytes(&bytes_in)\n    assert(h.finish() != Hasher::new().finish())\n}\n" }
    if name == "io" { return "capability unsafe, stdio\n\nimport std.bytes as bytes\nimport sys\n\n@extern(\"c\", \"isatty\")\n@thread_safe\nunsafe fn c_isatty(fd: i32) -> i32\n\npub enum SeekFrom { Start(i64), Current(i64), End(i64) }\npub enum Line { Data(string), Eof }\n\nimpl Eq for SeekFrom {\n    fn eq(&self, other: &Self) -> bool {\n        match self {\n            .Start(a) => match other { .Start(b) => a == b, _ => false },\n            .Current(a) => match other { .Current(b) => a == b, _ => false },\n            .End(a) => match other { .End(b) => a == b, _ => false },\n        }\n    }\n}\n\nimpl Eq for Line {\n    fn eq(&self, other: &Self) -> bool {\n        match self {\n            .Data(a) => match other { .Data(b) => a == b, _ => false },\n            .Eof => match other { .Eof => true, _ => false },\n        }\n    }\n}\n\n@thread_safe\npub unsafe fn fd_read_chunk(fd: i32, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n    if max_bytes <= 0 { return .Ok(0) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    mut want := max_bytes\n    if want > 65536 { want = 65536 }\n    if out.len > 2147483647 - want { want = 2147483647 - out.len }\n    if want <= 0 { return .Err(.TooLarge) }\n    out.reserve(out.len + want)\n    n := sys.fd_read(fd, &mut out, i64(want))\n    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n    .Ok(i32(n))\n}\n\n@thread_safe\npub unsafe fn fd_write_chunk(fd: i32, data: &[]u8) -> Result<i32, sys.IoError> {\n    if data.len == 0 { return .Ok(0) }\n    if !target_is(\"native\") { return .Err(.Unsupported) }\n    n := sys.fd_write(fd, &data, 0, i64(data.len))\n    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n    .Ok(i32(n))\n}\n\n@thread_safe\nfn fd_is_tty(fd: i32) -> bool {\n    if fd < 0 { return false }\n    if target_is(\"macos\") {\n        unsafe { return c_isatty(fd) != 0 }\n    }\n    if target_is(\"linux\") {\n        mut termios: [u8; 64] = [0; 64]\n        unsafe {\n            // ioctl(fd, TCGETS = 0x5401 = 21505, &termios); ARM64 syscall 29 is mapped on x86_64.\n            return sys.linux_syscall(29, i64(fd), 21505, i64(usize(addr(&mut termios[0]))), 0, 0, 0) == 0\n        }\n    }\n    false\n}\n\npub trait Read {\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError>\n}\n\npub trait Write {\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError>\n    fn flush(&mut self) -> Result<(), sys.IoError>\n\n    fn write_full(&mut self, data: &[]u8) -> Result<(), sys.IoError> {\n        mut sent := 0\n        while sent < data.len {\n            res := self.write(&data[sent..data.len])\n            match res {\n                .Ok(n) => {\n                    if n <= 0 { return .Err(.WriteZero) }\n                    sent += n\n                },\n                .Err(e) => { return .Err(e) },\n            }\n        }\n        .Ok\n    }\n\n    fn write_str(&mut self, text: string) -> Result<(), sys.IoError> {\n        if text.len == 0 { return .Ok }\n        mut buf: []u8 = []\n        bytes.append_utf8(&mut buf, text)\n        self.write_full(&buf)\n    }\n\n    fn write_byte(&mut self, value: u8) -> Result<(), sys.IoError> {\n        buf: []u8 = [value]\n        self.write_full(&buf)\n    }\n}\n\npub trait BufRead: Read {\n    fn fill(&mut self) -> Result<i32, sys.IoError>\n    fn buffered(&self) -> &[]u8 from self\n    fn consume(&mut self, count: i32)\n\n    fn read_until(&mut self, delim: u8, out: &mut []u8) -> Result<i32, sys.IoError> {\n        self.read_until_limit(delim, &mut out, 2147483647)\n    }\n\n    fn read_until_limit(&mut self, delim: u8, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        if max_bytes < 0 { return .Err(.InvalidArgument) }\n        capacity := 2147483647 - out.len\n        limit := if max_bytes < capacity { max_bytes } else { capacity }\n        mut total := 0\n        while true {\n            mut found := -1\n            mut take := 0\n            {\n                view := self.buffered()\n                if view.len > 0 {\n                    left := limit - total\n                    if left == 0 { return .Err(.TooLarge) }\n                    count := if left < view.len { left } else { view.len }\n                    match bytes.find_byte(&view, 0, count, delim) {\n                        .Some(pos) => { found = pos },\n                        .None => { found = -1 },\n                    }\n                    take = if found >= 0 { found + 1 } else { count }\n                    bytes.extend_range(&mut out, &view, 0, take)\n                }\n            }\n            if take > 0 {\n                self.consume(take)\n                total += take\n            }\n            if found >= 0 { return .Ok(total) }\n            match self.fill() {\n                .Ok(n) => {\n                    if n == 0 { return .Ok(total) }\n                },\n                .Err(e) => { return .Err(e) },\n            }\n        }\n        .Ok(total)\n    }\n\n    fn read_line_into(&mut self, out: &mut []u8) -> Result<i32, sys.IoError> {\n        self.read_until(10, &mut out)\n    }\n\n    fn read_line(&mut self) -> Result<Line, sys.IoError> {\n        mut raw: []u8 = []\n        _ := self.read_line_into(&mut raw)?\n        decode_line(move raw)\n    }\n\n    fn read_line_limit(&mut self, max_bytes: i32) -> Result<Line, sys.IoError> {\n        mut raw: []u8 = []\n        _ := self.read_until_limit(10, &mut raw, max_bytes)?\n        decode_line(move raw)\n    }\n}\n\nfn decode_line(move raw: []u8) -> Result<Line, sys.IoError> {\n    if raw.len == 0 { return .Ok(.Eof) }\n    mut line := raw\n    if line[line.len - 1] == 10 {\n        _ := line.pop()\n        if line.len > 0 && line[line.len - 1] == 13 { _ := line.pop() }\n    }\n    .Ok(.Data(bytes.decode(&line)?))\n}\n\npub trait Seek {\n    fn seek(&mut self, pos: SeekFrom) -> Result<i64, sys.IoError>\n}\n\n@resource\npub opaque struct Stdin { fd: i32 }\n\n@resource\npub opaque struct Stdout { fd: i32 }\n\n@resource\npub opaque struct Stderr { fd: i32 }\n\nimpl Stdin {\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn is_tty(&self) -> bool { fd_is_tty(self.fd) }\n}\n\nimpl Stdout {\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn is_tty(&self) -> bool { fd_is_tty(self.fd) }\n}\n\nimpl Stderr {\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn is_tty(&self) -> bool { fd_is_tty(self.fd) }\n}\n\nimpl Read for Stdin {\n    @thread_safe\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        mut r: Result<i32, sys.IoError> = .Ok(0)\n        unsafe { r = fd_read_chunk(self.fd, &mut out, max_bytes) }\n        r\n    }\n}\n\nimpl Write for Stdout {\n    @thread_safe\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        mut r: Result<i32, sys.IoError> = .Ok(0)\n        unsafe { r = fd_write_chunk(self.fd, &data) }\n        r\n    }\n    fn flush(&mut self) -> Result<(), sys.IoError> { .Ok }\n}\n\nimpl Write for Stderr {\n    @thread_safe\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        mut r: Result<i32, sys.IoError> = .Ok(0)\n        unsafe { r = fd_write_chunk(self.fd, &data) }\n        r\n    }\n    fn flush(&mut self) -> Result<(), sys.IoError> { .Ok }\n}\n\n@requires(stdio)\npub fn stdin() -> Stdin { Stdin { fd: 0 } }\n\n@requires(stdio)\npub fn stdout() -> Stdout { Stdout { fd: 1 } }\n\n@requires(stdio)\npub fn stderr() -> Stderr { Stderr { fd: 2 } }\n\npub struct BufReader<R> where R: Read {\n    inner: R,\n    buf: []u8,\n    pos: i32,\n    cap: i32,\n    eof: bool,\n}\n\nimpl BufReader<R> {\n    pub fn with_capacity(move inner: R, cap: i32) -> Self {\n        actual := if cap < 1 { 1 } else { cap }\n        Self { inner: inner, buf: [], pos: 0, cap: actual, eof: false }\n    }\n\n    pub fn new(move inner: R) -> Self {\n        Self::with_capacity(move inner, 8192)\n    }\n\n    pub fn into_inner(move self) -> R { self.inner }\n    pub fn inner(&self) -> &R from self { &self.inner }\n}\n\nimpl Read for BufReader<R> where R: Read {\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        if max_bytes <= 0 { return .Ok(0) }\n        if self.pos < self.buf.len {\n            avail := self.buf.len - self.pos\n            take := if avail < max_bytes { avail } else { max_bytes }\n            bytes.extend_range(&mut out, &self.buf, self.pos, self.pos + take)\n            self.pos += take\n            return .Ok(take)\n        }\n        if max_bytes >= self.cap {\n            return self.inner.read(&mut out, max_bytes)\n        }\n        match self.fill() {\n            .Ok(n) => {\n                if n == 0 { return .Ok(0) }\n                avail := self.buf.len - self.pos\n                take := if avail < max_bytes { avail } else { max_bytes }\n                bytes.extend_range(&mut out, &self.buf, self.pos, self.pos + take)\n                self.pos += take\n                .Ok(take)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n}\n\nimpl BufRead for BufReader<R> where R: Read {\n    fn fill(&mut self) -> Result<i32, sys.IoError> {\n        if self.pos < self.buf.len {\n            return .Ok(self.buf.len - self.pos)\n        }\n        self.pos = 0\n        if self.eof {\n            self.buf.clear()\n            return .Ok(0)\n        }\n        mut buf := replace(&mut self.buf, [])\n        buf.clear()\n        res := self.inner.read(&mut buf, self.cap)\n        self.buf = buf\n        match res {\n            .Ok(n) => {\n                if n == 0 { self.eof = true }\n                .Ok(self.buf.len)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n\n    fn buffered(&self) -> &[]u8 from self {\n        start := if self.pos < self.buf.len { self.pos } else { self.buf.len }\n        &self.buf[start..self.buf.len]\n    }\n\n    fn consume(&mut self, count: i32) {\n        if count <= 0 { return }\n        avail := self.buf.len - self.pos\n        step := if count < avail { count } else { avail }\n        if step > 0 { self.pos += step }\n    }\n}\n\npub struct FlushError<W> {\n    writer: W,\n    error: sys.IoError,\n}\n\nimpl FlushError<W> {\n    pub fn into_inner(move self) -> W { self.writer }\n    pub fn error(&self) -> sys.IoError { self.error }\n}\n\npub struct BufWriter<W> where W: Write {\n    inner: W,\n    buf: []u8,\n    cap: i32,\n}\n\nimpl BufWriter<W> {\n    pub fn with_capacity(move inner: W, cap: i32) -> Self {\n        actual := if cap < 1 { 1 } else { cap }\n        Self { inner: inner, buf: [], cap: actual }\n    }\n\n    pub fn new(move inner: W) -> Self {\n        Self::with_capacity(move inner, 8192)\n    }\n\n    pub fn into_inner(move self) -> Result<W, FlushError<W>> {\n        mut w := self\n        match w.flush() {\n            .Ok => .Ok(w.inner),\n            .Err(e) => .Err(FlushError<W> { writer: w.inner, error: e }),\n        }\n    }\n\n    pub fn inner(&self) -> &W from self { &self.inner }\n    pub fn buffered_len(&self) -> i32 { self.buf.len }\n}\n\nimpl Write for BufWriter<W> where W: Write {\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        if data.len == 0 { return .Ok(0) }\n        if data.len > self.cap - self.buf.len {\n            match self.flush() {\n                .Ok => {},\n                .Err(e) => { return .Err(e) },\n            }\n        }\n        if data.len >= self.cap {\n            return self.inner.write(&data)\n        }\n        bytes.extend(&mut self.buf, &data)\n        .Ok(data.len)\n    }\n\n    fn flush(&mut self) -> Result<(), sys.IoError> {\n        mut sent := 0\n        mut buf := replace(&mut self.buf, [])\n        while sent < buf.len {\n            res := self.inner.write(&buf[sent..buf.len])\n            match res {\n                .Ok(n) => {\n                    if n <= 0 {\n                        if sent > 0 { bytes.consume_prefix(&mut buf, sent) }\n                        self.buf = buf\n                        return .Err(.WriteZero)\n                    }\n                    sent += n\n                },\n                .Err(e) => {\n                    if sent > 0 { bytes.consume_prefix(&mut buf, sent) }\n                    self.buf = buf\n                    return .Err(e)\n                },\n            }\n        }\n        buf.clear()\n        self.buf = buf\n        self.inner.flush()\n    }\n}\n\npub struct Limited<R> where R: Read {\n    inner: R,\n    remaining: i64,\n}\n\nimpl Limited<R> {\n    pub fn new(move inner: R, limit: i64) -> Self {\n        rem: i64 = if limit < 0 { 0 } else { limit }\n        Self { inner: inner, remaining: rem }\n    }\n\n    pub fn limit(&self) -> i64 { self.remaining }\n    pub fn into_inner(move self) -> R { self.inner }\n    pub fn inner(&self) -> &R from self { &self.inner }\n}\n\nimpl Read for Limited<R> where R: Read {\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        if max_bytes <= 0 || self.remaining <= 0 { return .Ok(0) }\n        cap := if i64(max_bytes) < self.remaining { max_bytes } else { i32(self.remaining) }\n        match self.inner.read(&mut out, cap) {\n            .Ok(n) => {\n                if n > 0 { self.remaining -= i64(n) }\n                .Ok(n)\n            },\n            .Err(e) => .Err(e),\n        }\n    }\n}\n\npub struct Cursor {\n    data: []u8,\n    pos: i32,\n}\n\nimpl Cursor {\n    pub fn new(move data: []u8) -> Self { Self { data: data, pos: 0 } }\n    pub fn from_text(text: string) -> Self {\n        mut buf: []u8 = []\n        bytes.append_utf8(&mut buf, text)\n        Self { data: buf, pos: 0 }\n    }\n    pub fn empty() -> Self { Self { data: [], pos: 0 } }\n    pub fn position(&self) -> i32 { self.pos }\n    pub fn set_position(&mut self, pos: i32) {\n        assert(pos >= 0)\n        self.pos = pos\n    }\n    pub fn len(&self) -> i32 { self.data.len }\n    pub fn is_empty(&self) -> bool { self.data.len == 0 }\n    pub fn as_bytes(&self) -> &[]u8 from self { &self.data }\n    pub fn into_inner(move self) -> []u8 { self.data }\n}\n\nimpl Default for Cursor {\n    fn default() -> Self { Self::empty() }\n}\n\nimpl Read for Cursor {\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        if max_bytes <= 0 || self.pos >= self.data.len { return .Ok(0) }\n        avail := self.data.len - self.pos\n        take := if avail < max_bytes { avail } else { max_bytes }\n        bytes.extend_range(&mut out, &self.data, self.pos, self.pos + take)\n        self.pos += take\n        .Ok(take)\n    }\n}\n\nimpl BufRead for Cursor {\n    fn fill(&mut self) -> Result<i32, sys.IoError> {\n        if self.pos < self.data.len { .Ok(self.data.len - self.pos) } else { .Ok(0) }\n    }\n\n    fn buffered(&self) -> &[]u8 from self {\n        start := if self.pos < self.data.len { self.pos } else { self.data.len }\n        &self.data[start..self.data.len]\n    }\n\n    fn consume(&mut self, count: i32) {\n        if count <= 0 { return }\n        avail := self.data.len - self.pos\n        step := if count < avail { count } else { avail }\n        if step > 0 { self.pos += step }\n    }\n}\n\nimpl Write for Cursor {\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        if data.len == 0 { return .Ok(0) }\n        if data.len > 2147483647 - self.pos { return .Err(.TooLarge) }\n        if self.pos > self.data.len {\n            gap := self.pos - self.data.len\n            bytes.pad(&mut self.data, gap)\n        }\n        avail := self.data.len - self.pos\n        overlap := if data.len < avail { data.len } else { avail }\n        for i in 0..overlap {\n            self.data[self.pos + i] = data[i]\n        }\n        if overlap < data.len {\n            bytes.extend_range(&mut self.data, &data, overlap, data.len)\n        }\n        self.pos += data.len\n        .Ok(data.len)\n    }\n\n    fn flush(&mut self) -> Result<(), sys.IoError> { .Ok }\n}\n\nimpl Seek for Cursor {\n    fn seek(&mut self, pos: SeekFrom) -> Result<i64, sys.IoError> {\n        target := match pos {\n            .Start(n) => n,\n            .Current(n) => i64(self.pos) + n,\n            .End(n) => i64(self.data.len) + n,\n        }\n        if target < 0 { return .Err(.InvalidArgument) }\n        if target > 2147483647 { return .Err(.TooLarge) }\n        self.pos = i32(target)\n        .Ok(target)\n    }\n}\n\npub struct Empty {}\n\nimpl Empty {\n    pub fn new() -> Self { Self {} }\n}\n\nimpl Default for Empty {\n    fn default() -> Self { Self {} }\n}\n\nimpl Read for Empty {\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        if max_bytes <= 0 { return .Ok(0) }\n        _ := out.len\n        .Ok(0)\n    }\n}\n\nimpl BufRead for Empty {\n    fn fill(&mut self) -> Result<i32, sys.IoError> { .Ok(0) }\n    @thread_safe\n    fn buffered(&self) -> &[]u8 from self { unsafe { return bytes_view(&self, ptr(0), usize(0)) } }\n    fn consume(&mut self, count: i32) { _ := count }\n}\n\npub struct Sink { written: i64 }\n\nimpl Sink {\n    pub fn new() -> Self { Self { written: 0 } }\n    pub fn bytes_written(&self) -> i64 { self.written }\n}\n\nimpl Default for Sink {\n    fn default() -> Self { Self::new() }\n}\n\nimpl Write for Sink {\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        self.written += i64(data.len)\n        .Ok(data.len)\n    }\n    fn flush(&mut self) -> Result<(), sys.IoError> { .Ok }\n}\n\npub fn write_all<W: Write>(writer: &mut W, data: &[]u8) -> Result<(), sys.IoError> {\n    writer.write_full(&data)\n}\n\npub fn write_str<W: Write>(writer: &mut W, text: string) -> Result<(), sys.IoError> {\n    writer.write_str(text)\n}\n\npub fn read_exact<R: Read>(reader: &mut R, out: &mut []u8, count: i32) -> Result<(), sys.IoError> {\n    if count < 0 { return .Err(.InvalidArgument) }\n    if count == 0 { return .Ok }\n    mut remaining := count\n    while remaining > 0 {\n        step := if remaining < 65536 { remaining } else { 65536 }\n        match reader.read(&mut out, step) {\n            .Ok(n) => {\n                if n == 0 { return .Err(.UnexpectedEof) }\n                remaining -= n\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n    .Ok\n}\n\npub fn read_to_end_limit<R: Read>(reader: &mut R, out: &mut []u8, max_bytes: i64) -> Result<i64, sys.IoError> {\n    if max_bytes < 0 { return .Err(.InvalidArgument) }\n    mut total: i64 = 0\n    while true {\n        rem := max_bytes - total\n        if rem == 0 {\n            mut extra: []u8 = []\n            match reader.read(&mut extra, 1) {\n                .Ok(n) => {\n                    if n == 0 { return .Ok(total) }\n                    return .Err(.TooLarge)\n                },\n                .Err(e) => { return .Err(e) },\n            }\n        }\n        step := if rem < 65536 { i32(rem) } else { 65536 }\n        match reader.read(&mut out, step) {\n            .Ok(n) => {\n                if n == 0 { return .Ok(total) }\n                total += i64(n)\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n    .Ok(total)\n}\n\npub fn read_to_end<R: Read>(reader: &mut R, out: &mut []u8) -> Result<i64, sys.IoError> {\n    mut total: i64 = 0\n    while true {\n        match reader.read(&mut out, 65536) {\n            .Ok(n) => {\n                if n == 0 { return .Ok(total) }\n                total += i64(n)\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n    .Ok(total)\n}\n\npub fn read_to_string<R: Read>(reader: &mut R) -> Result<string, sys.IoError> {\n    mut buf: []u8 = []\n    _ := read_to_end<R>(&mut reader, &mut buf)?\n    bytes.decode(&buf)\n}\n\npub fn copy_limit<R: Read, W: Write>(reader: &mut R, writer: &mut W, max_bytes: i64) -> Result<i64, sys.IoError> {\n    if max_bytes < 0 { return .Err(.InvalidArgument) }\n    mut total: i64 = 0\n    mut buf: []u8 = []\n    while total < max_bytes {\n        rem := max_bytes - total\n        step := if rem < 65536 { i32(rem) } else { 65536 }\n        buf.clear()\n        match reader.read(&mut buf, step) {\n            .Ok(n) => {\n                if n == 0 { return .Ok(total) }\n                match writer.write_full(&buf) {\n                    .Ok => { total += i64(buf.len) },\n                    .Err(e) => { return .Err(e) },\n                }\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n    .Ok(total)\n}\n\npub fn copy<R: Read, W: Write>(reader: &mut R, writer: &mut W) -> Result<i64, sys.IoError> {\n    mut total: i64 = 0\n    mut buf: []u8 = []\n    while true {\n        buf.clear()\n        match reader.read(&mut buf, 65536) {\n            .Ok(n) => {\n                if n == 0 { return .Ok(total) }\n                match writer.write_full(&buf) {\n                    .Ok => { total += i64(buf.len) },\n                    .Err(e) => { return .Err(e) },\n                }\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n    .Ok(total)\n}\n\npub fn is_would_block(err: &sys.IoError) -> bool { err.is_would_block() }\n\n@requires(stdio)\npub fn read_stdin_limit(max_bytes: i64) -> Result<[]u8, sys.IoError> {\n    mut s := stdin()\n    mut out: []u8 = []\n    match read_to_end_limit<Stdin>(&mut s, &mut out, max_bytes) {\n        .Ok(_) => .Ok(out),\n        .Err(e) => .Err(e),\n    }\n}\n\n@requires(stdio)\npub fn read_stdin_bytes() -> Result<[]u8, sys.IoError> {\n    read_stdin_limit(268435456)\n}\n\n@requires(stdio)\npub fn read_stdin() -> Result<string, sys.IoError> {\n    buf := read_stdin_bytes()?\n    bytes.decode(&buf)\n}\n" }
    if name == "json" { return "import std.bytes as bytes\nimport std.parse as parse\n\npub enum Kind {\n    Invalid = 0,\n    Null = 1,\n    Bool = 2,\n    Number = 3,\n    String = 4,\n    Array = 5,\n    Object = 6,\n}\n\npub struct Doc {\n    ok: bool,\n    error: string,\n    offset: i32,\n    root: i32,\n    input: []u8,\n    kinds: []u8,\n    starts: []i32,\n    ends: []i32,\n    escaped: []bool,\n    first_child: []i32,\n    next_sibling: []i32,\n    key_starts: []i32,\n    key_ends: []i32,\n    key_escaped: []bool,\n    counts: []i32,\n}\n\npub struct JsonError {\n    message: string,\n    offset: i32,\n}\n\nimpl JsonError {\n    pub fn new(message: string, offset: i32) -> Self {\n        Self { message: message.clone(), offset: offset }\n    }\n}\n\nimpl Display for JsonError {\n    fn str(&self) -> string {\n        if self.offset >= 0 {\n            return self.message + \" at byte \" + self.offset.str()\n        }\n        self.message.clone()\n    }\n}\n\nimpl Eq for JsonError {\n    fn eq(&self, other: &Self) -> bool {\n        self.offset == other.offset && self.message == other.message\n    }\n}\n\npub fn write_str(out: &mut []u8, value: string) {\n    hex := \"0123456789abcdef\"\n    out.reserve(out.len + value.len + 2)\n    out.push(b'\"')\n    for b in value.bytes() {\n        if b == 34 { out.push(b'\\\\'); out.push(b'\"') }\n        else if b == 92 { out.push(b'\\\\'); out.push(b'\\\\') }\n        else if b == 8 { out.push(b'\\\\'); out.push(b'b') }\n        else if b == 12 { out.push(b'\\\\'); out.push(b'f') }\n        else if b == 10 { out.push(b'\\\\'); out.push(b'n') }\n        else if b == 13 { out.push(b'\\\\'); out.push(b'r') }\n        else if b == 9 { out.push(b'\\\\'); out.push(b't') }\n        else if b < 32 {\n            bytes.append_utf8(&mut out, \"\\\\u00\")\n            out.push(u8(hex[i32(b) / 16]))\n            out.push(u8(hex[i32(b) % 16]))\n        } else {\n            out.push(u8(b))\n        }\n    }\n    out.push(b'\"')\n}\n\npub fn quote(value: string) -> string {\n    mut out: []u8 = []\n    write_str(&mut out, value)\n    bytes.decode(&out).unwrap_or_default()\n}\n\npub fn write_i64(out: &mut []u8, value: i64) { bytes.append_decimal(&mut out, value) }\n\npub fn write_u64(out: &mut []u8, value: u64) {\n    if value == 0 { out.push(b'0'); return }\n    start := out.len\n    mut v := value\n    while v > 0 {\n        d := i32(v % 10)\n        out.push(u8(48 + d))\n        v /= 10\n    }\n    mut left := start\n    mut right := out.len - 1\n    while left < right {\n        out.swap(left, right)\n        left += 1\n        right -= 1\n    }\n}\n\npub fn write_bool(out: &mut []u8, value: bool) {\n    if value { bytes.append_utf8(&mut out, \"true\") }\n    else { bytes.append_utf8(&mut out, \"false\") }\n}\n\npub fn write_f64(out: &mut []u8, value: f64) -> bool {\n    if !value.is_finite() { return false }\n    bytes.append_utf8(&mut out, value.str())\n    true\n}\n\npub fn write_null(out: &mut []u8) { bytes.append_utf8(&mut out, \"null\") }\n\nfn sep_key(out: &mut []u8, first: &mut bool, key: string) {\n    if !first { out.push(b',') }\n    first = false\n    write_str(&mut out, key)\n    out.push(b':')\n}\n\npub fn sep_elem(out: &mut []u8, first: &mut bool) {\n    if !first { out.push(b',') }\n    first = false\n}\n\npub fn begin_obj(out: &mut []u8) -> bool { out.push(b'{'); true }\npub fn end_obj(out: &mut []u8) { out.push(b'}') }\npub fn begin_arr(out: &mut []u8) -> bool { out.push(b'['); true }\npub fn end_arr(out: &mut []u8) { out.push(b']') }\n\npub fn field_str(out: &mut []u8, first: &mut bool, key: string, value: string) {\n    sep_key(&mut out, &mut first, key); write_str(&mut out, value)\n}\npub fn field_i64(out: &mut []u8, first: &mut bool, key: string, value: i64) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, value)\n}\npub fn field_i32(out: &mut []u8, first: &mut bool, key: string, value: i32) {\n    sep_key(&mut out, &mut first, key); write_i64(&mut out, i64(value))\n}\npub fn field_u64(out: &mut []u8, first: &mut bool, key: string, value: u64) {\n    sep_key(&mut out, &mut first, key); write_u64(&mut out, value)\n}\npub fn field_f64(out: &mut []u8, first: &mut bool, key: string, value: f64) -> bool {\n    if !value.is_finite() { return false }\n    sep_key(&mut out, &mut first, key)\n    write_f64(&mut out, value)\n}\npub fn field_bool(out: &mut []u8, first: &mut bool, key: string, value: bool) {\n    sep_key(&mut out, &mut first, key); write_bool(&mut out, value)\n}\npub fn field_null(out: &mut []u8, first: &mut bool, key: string) {\n    sep_key(&mut out, &mut first, key); write_null(&mut out)\n}\npub fn begin_field_obj(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_obj(&mut out)\n}\npub fn begin_field_arr(out: &mut []u8, first: &mut bool, key: string) -> bool {\n    sep_key(&mut out, &mut first, key); begin_arr(&mut out)\n}\n\npub fn finish_text(out: &[]u8) -> string { bytes.decode(&out).unwrap_or_default() }\n\nenum WriteState { Root, Done, ArrayFirst, ArrayMore, ObjectFirst, ObjectMore, ObjectValue }\n\npub struct Writer {\n    output: []u8,\n    stack: []WriteState,\n    failed: bool,\n    error: string,\n}\n\nimpl Writer {\n    pub fn new() -> Self { Self { output: [], stack: [.Root], failed: false, error: \"\" } }\n\n    fn fail(&mut self, message: string) {\n        if !self.failed {\n            self.failed = true\n            self.error = message.clone()\n        }\n    }\n\n    fn start_value(&mut self) -> bool {\n        if self.failed { return false }\n        top := self.stack.len - 1\n        state := self.stack[top]\n        match state {\n            .Root => { self.stack[top] = .Done },\n            .ArrayFirst => { self.stack[top] = .ArrayMore },\n            .ArrayMore => { self.output.push(b',') },\n            .ObjectValue => { self.stack[top] = .ObjectMore },\n            _ => { self.fail(\"unexpected JSON value position\"); return false },\n        }\n        true\n    }\n\n    pub fn object(&mut self) {\n        if !self.start_value() { return }\n        self.output.push(b'{')\n        self.stack.push(.ObjectFirst)\n    }\n\n    pub fn array(&mut self) {\n        if !self.start_value() { return }\n        self.output.push(b'[')\n        self.stack.push(.ArrayFirst)\n    }\n\n    pub fn key(&mut self, name: string) {\n        if self.failed { return }\n        top := self.stack.len - 1\n        state := self.stack[top]\n        if state == .ObjectMore {\n            self.output.push(b',')\n        } else if state != .ObjectFirst {\n            self.fail(\"unexpected JSON object key\")\n            return\n        }\n        write_str(&mut self.output, name)\n        self.output.push(b':')\n        self.stack[top] = .ObjectValue\n    }\n\n    pub fn end(&mut self) {\n        if self.failed { return }\n        state := self.stack[self.stack.len - 1]\n        if state == .ObjectFirst || state == .ObjectMore {\n            self.output.push(b'}')\n        } else if state == .ArrayFirst || state == .ArrayMore {\n            self.output.push(b']')\n        } else {\n            self.fail(\"unexpected JSON container end\")\n            return\n        }\n        _ := self.stack.pop()\n    }\n\n    pub fn string(&mut self, value: string) {\n        if self.start_value() { write_str(&mut self.output, value) }\n    }\n\n    pub fn integer(&mut self, value: i64) {\n        if self.start_value() { write_i64(&mut self.output, value) }\n    }\n\n    pub fn unsigned(&mut self, value: u64) {\n        if self.start_value() { write_u64(&mut self.output, value) }\n    }\n\n    pub fn decimal(&mut self, value: f64) {\n        if self.start_value() && !write_f64(&mut self.output, value) {\n            self.fail(\"non-finite float cannot be encoded as JSON\")\n        }\n    }\n\n    pub fn boolean(&mut self, value: bool) {\n        if self.start_value() { write_bool(&mut self.output, value) }\n    }\n\n    pub fn null(&mut self) {\n        if self.start_value() { write_null(&mut self.output) }\n    }\n\n    pub fn finish(&self) -> Result<string, JsonError> {\n        if self.failed {\n            msg := if self.error != \"\" { self.error.clone() } else { \"invalid JSON writer state\" }\n            return .Err(JsonError::new(msg, -1))\n        }\n        if self.stack.len != 1 || self.stack[0] != .Done {\n            return .Err(JsonError::new(\"incomplete JSON value\", -1))\n        }\n        .Ok(finish_text(&self.output))\n    }\n\n    pub fn finish_bytes(&self) -> Result<[]u8, JsonError> {\n        if self.failed {\n            msg := if self.error != \"\" { self.error.clone() } else { \"invalid JSON writer state\" }\n            return .Err(JsonError::new(msg, -1))\n        }\n        if self.stack.len != 1 || self.stack[0] != .Done {\n            return .Err(JsonError::new(\"incomplete JSON value\", -1))\n        }\n        .Ok(self.output.clone())\n    }\n}\n\nimpl Default for Writer {\n    fn default() -> Self { Writer::new() }\n}\n\nimpl Eq for Kind {\n    fn eq(&self, other: &Self) -> bool { self == other }\n}\n\nimpl Display for Kind {\n    fn str(&self) -> string {\n        match self {\n            .Invalid => \"Invalid\",\n            .Null => \"Null\",\n            .Bool => \"Bool\",\n            .Number => \"Number\",\n            .String => \"String\",\n            .Array => \"Array\",\n            .Object => \"Object\",\n        }\n    }\n}\n\npub trait Encode {\n    fn encode_json(&self, out: &mut Writer)\n}\n\nimpl Encode for bool {\n    fn encode_json(&self, out: &mut Writer) { out.boolean(self) }\n}\nimpl Encode for i32 {\n    fn encode_json(&self, out: &mut Writer) { out.integer(i64(self)) }\n}\nimpl Encode for i64 {\n    fn encode_json(&self, out: &mut Writer) { out.integer(self) }\n}\nimpl Encode for u8 {\n    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }\n}\nimpl Encode for u16 {\n    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }\n}\nimpl Encode for u32 {\n    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }\n}\nimpl Encode for u64 {\n    fn encode_json(&self, out: &mut Writer) { out.unsigned(self) }\n}\nimpl Encode for usize {\n    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }\n}\nimpl Encode for f32 {\n    fn encode_json(&self, out: &mut Writer) { out.decimal(f64(self)) }\n}\nimpl Encode for f64 {\n    fn encode_json(&self, out: &mut Writer) { out.decimal(self) }\n}\nimpl Encode for string {\n    fn encode_json(&self, out: &mut Writer) { out.string(self) }\n}\nimpl Encode for []T where T: Encode {\n    fn encode_json(&self, out: &mut Writer) {\n        out.array()\n        for i in 0..self.len { self[i].encode_json(&mut out) }\n        out.end()\n    }\n}\nimpl Encode for Option<T> where T: Encode {\n    fn encode_json(&self, out: &mut Writer) {\n        match self {\n            .Some(v) => v.encode_json(&mut out),\n            .None => out.null(),\n        }\n    }\n}\n\npub fn encode<T: Encode + Storable>(w: &mut Writer, value: &T) {\n    value.encode_json(&mut w)\n}\n\npub fn field_value<T: Encode + Storable>(w: &mut Writer, name: string, value: &T) {\n    w.key(name)\n    value.encode_json(&mut w)\n}\n\npub fn to_string<T: Encode + Storable>(value: &T) -> Result<string, JsonError> {\n    mut w := Writer::new()\n    value.encode_json(&mut w)\n    w.finish()\n}\n\npub fn to_bytes<T: Encode + Storable>(value: &T) -> Result<[]u8, JsonError> {\n    mut w := Writer::new()\n    value.encode_json(&mut w)\n    w.finish_bytes()\n}\n\nstruct Parser {\n    pos: i32,\n    depth: i32,\n}\n\nfn is_ws(b: u8) -> bool {\n    b == b' ' || b == b'\\t' || b == b'\\n' || b == b'\\r'\n}\n\nfn skip_ws(input: &[]u8, p: &mut Parser) {\n    while p.pos < input.len && is_ws(input[p.pos]) {\n        p.pos += 1\n    }\n}\n\nfn fail_doc(doc: &mut Doc, at: i32, move msg: string) {\n    if doc.ok {\n        doc.ok = false\n        doc.offset = at\n        doc.error = msg\n    }\n}\n\nfn hex_val(b: u8) -> i32 {\n    if b >= b'0' && b <= b'9' { return i32(b - b'0') }\n    if b >= b'a' && b <= b'f' { return i32(b - b'a') + 10 }\n    if b >= b'A' && b <= b'F' { return i32(b - b'A') + 10 }\n    -1\n}\n\nfn alloc_node(doc: &mut Doc, kind: u8, start: i32, end: i32, esc: bool) -> i32 {\n    id := doc.kinds.len\n    doc.kinds.push(kind)\n    doc.starts.push(start)\n    doc.ends.push(end)\n    doc.escaped.push(esc)\n    doc.first_child.push(-1)\n    doc.next_sibling.push(-1)\n    doc.key_starts.push(0)\n    doc.key_ends.push(0)\n    doc.key_escaped.push(false)\n    doc.counts.push(0)\n    id\n}\n\nstruct StrSpan { ok: bool, start: i32, end: i32, escaped: bool }\n\nfn scan_string(doc: &mut Doc, p: &mut Parser) -> StrSpan {\n    if p.pos >= doc.input.len || doc.input[p.pos] != b'\"' {\n        fail_doc(&mut doc, p.pos, \"expected '\\\"'\")\n        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n    }\n    p.pos += 1\n    start := p.pos\n    mut has_esc := false\n    while p.pos < doc.input.len {\n        b := doc.input[p.pos]\n        if b == b'\"' {\n            end := p.pos\n            p.pos += 1\n            return StrSpan { ok: true, start: start, end: end, escaped: has_esc }\n        }\n        if b < 32 {\n            fail_doc(&mut doc, p.pos, \"unescaped control character in JSON string\")\n            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n        }\n        if b == b'\\\\' {\n            has_esc = true\n            p.pos += 1\n            if p.pos >= doc.input.len {\n                fail_doc(&mut doc, p.pos, \"unterminated escape sequence\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n            esc := doc.input[p.pos]\n            if esc == b'\"' || esc == b'\\\\' || esc == b'/' || esc == b'b' ||\n               esc == b'f' || esc == b'n' || esc == b'r' || esc == b't' {\n                p.pos += 1\n            } else if esc == b'u' {\n                if p.pos + 4 >= doc.input.len {\n                    fail_doc(&mut doc, p.pos, \"incomplete \\\\uXXXX escape\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n                mut cp := 0\n                for k in 1..5 {\n                    hv := hex_val(doc.input[p.pos + k])\n                    if hv < 0 {\n                        fail_doc(&mut doc, p.pos + k, \"invalid hex digit in \\\\uXXXX escape\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    cp = cp * 16 + hv\n                }\n                p.pos += 5\n                if cp >= 0xD800 && cp <= 0xDBFF {\n                    if p.pos + 5 >= doc.input.len || doc.input[p.pos] != b'\\\\' || doc.input[p.pos + 1] != b'u' {\n                        fail_doc(&mut doc, p.pos, \"missing low surrogate in UTF-16 pair\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    mut low := 0\n                    for k in 2..6 {\n                        hv := hex_val(doc.input[p.pos + k])\n                        if hv < 0 {\n                            fail_doc(&mut doc, p.pos + k, \"invalid hex digit in low surrogate\")\n                            return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                        }\n                        low = low * 16 + hv\n                    }\n                    if low < 0xDC00 || low > 0xDFFF {\n                        fail_doc(&mut doc, p.pos, \"invalid low surrogate range\")\n                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                    }\n                    p.pos += 6\n                } else if cp >= 0xDC00 && cp <= 0xDFFF {\n                    fail_doc(&mut doc, p.pos - 5, \"lone low surrogate\")\n                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n                }\n            } else {\n                fail_doc(&mut doc, p.pos, \"invalid escape character\")\n                return StrSpan { ok: false, start: 0, end: 0, escaped: false }\n            }\n        } else {\n            p.pos += 1\n        }\n    }\n    fail_doc(&mut doc, p.pos, \"unterminated JSON string\")\n    StrSpan { ok: false, start: 0, end: 0, escaped: false }\n}\n\nfn scan_number(doc: &mut Doc, p: &mut Parser) -> i32 {\n    start := p.pos\n    if p.pos < doc.input.len && doc.input[p.pos] == b'-' { p.pos += 1 }\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, start, \"invalid number\")\n        return -1\n    }\n    if doc.input[p.pos] == b'0' {\n        p.pos += 1\n        if p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            fail_doc(&mut doc, p.pos, \"leading zero in JSON number\")\n            return -1\n        }\n    } else if doc.input[p.pos] >= b'1' && doc.input[p.pos] <= b'9' {\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    } else {\n        fail_doc(&mut doc, p.pos, \"expected digit in JSON number\")\n        return -1\n    }\n    if p.pos < doc.input.len && doc.input[p.pos] == b'.' {\n        p.pos += 1\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected digit after decimal point\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    if p.pos < doc.input.len && (doc.input[p.pos] == b'e' || doc.input[p.pos] == b'E') {\n        p.pos += 1\n        if p.pos < doc.input.len && (doc.input[p.pos] == b'+' || doc.input[p.pos] == b'-') {\n            p.pos += 1\n        }\n        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {\n            fail_doc(&mut doc, p.pos, \"expected exponent digit\")\n            return -1\n        }\n        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {\n            p.pos += 1\n        }\n    }\n    alloc_node(&mut doc, 3, start, p.pos, false)\n}\n\nfn scan_container(doc: &mut Doc, p: &mut Parser, object: bool) -> i32 {\n    start := p.pos\n    p.pos += 1\n    mut kind: u8 = 5\n    mut closing := b']'\n    if object { kind = 6; closing = b'}' }\n    node := alloc_node(&mut doc, kind, start, start, false)\n    skip_ws(&doc.input, &mut p)\n    if p.pos < doc.input.len && doc.input[p.pos] == closing {\n        p.pos += 1\n        doc.ends[node] = p.pos\n        return node\n    }\n    p.depth += 1\n    mut previous := -1\n    mut count := 0\n    while doc.ok {\n        mut child := -1\n        if object {\n            skip_ws(&doc.input, &mut p)\n            key := scan_string(&mut doc, &mut p)\n            if !key.ok { break }\n            if !bytes.decode_range(&doc.input, key.start, key.end).is_ok() {\n                fail_doc(&mut doc, key.start, \"invalid UTF-8 in JSON key\")\n                break\n            }\n            skip_ws(&doc.input, &mut p)\n            if p.pos >= doc.input.len || doc.input[p.pos] != b':' {\n                fail_doc(&mut doc, p.pos, \"expected ':' after object key\")\n                break\n            }\n            p.pos += 1\n            child = scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { break }\n            doc.key_starts[child] = key.start\n            doc.key_ends[child] = key.end\n            doc.key_escaped[child] = key.escaped\n        } else {\n            child = scan_value(&mut doc, &mut p)\n            if child < 0 || !doc.ok { break }\n        }\n        if previous < 0 { doc.first_child[node] = child }\n        else { doc.next_sibling[previous] = child }\n        previous = child\n        count += 1\n        skip_ws(&doc.input, &mut p)\n        if p.pos < doc.input.len && doc.input[p.pos] == b',' {\n            p.pos += 1\n            continue\n        }\n        if p.pos < doc.input.len && doc.input[p.pos] == closing {\n            p.pos += 1\n            doc.ends[node] = p.pos\n            doc.counts[node] = count\n            p.depth -= 1\n            return node\n        }\n        if object { fail_doc(&mut doc, p.pos, \"expected ',' or '}' in JSON object\") }\n        else { fail_doc(&mut doc, p.pos, \"expected ',' or ']' in JSON array\") }\n        break\n    }\n    p.depth -= 1\n    -1\n}\n\nfn scan_value(doc: &mut Doc, p: &mut Parser) -> i32 {\n    skip_ws(&doc.input, &mut p)\n    if p.pos >= doc.input.len {\n        fail_doc(&mut doc, p.pos, \"unexpected end of JSON input\")\n        return -1\n    }\n    if p.depth >= 256 {\n        fail_doc(&mut doc, p.pos, \"JSON nesting depth exceeds 256\")\n        return -1\n    }\n    b := doc.input[p.pos]\n    if b == b'\"' {\n        sp := scan_string(&mut doc, &mut p)\n        if !sp.ok { return -1 }\n        if !bytes.decode_range(&doc.input, sp.start, sp.end).is_ok() {\n            fail_doc(&mut doc, sp.start, \"invalid UTF-8 in JSON string\")\n            return -1\n        }\n        return alloc_node(&mut doc, 4, sp.start, sp.end, sp.escaped)\n    }\n    if b == b'{' || b == b'[' { return scan_container(&mut doc, &mut p, b == b'{') }\n    if b == b't' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"true\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'f' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 5, \"false\") {\n            node := alloc_node(&mut doc, 2, p.pos, p.pos + 5, false)\n            p.pos += 5\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'n' {\n        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, \"null\") {\n            node := alloc_node(&mut doc, 1, p.pos, p.pos + 4, false)\n            p.pos += 4\n            return node\n        }\n        fail_doc(&mut doc, p.pos, \"invalid literal\")\n        return -1\n    }\n    if b == b'-' || (b >= b'0' && b <= b'9') {\n        return scan_number(&mut doc, &mut p)\n    }\n    fail_doc(&mut doc, p.pos, \"unexpected character in JSON\")\n    -1\n}\n\nfn push_codepoint_utf8(out: &mut []u8, cp: i32) {\n    if cp <= 0x7F {\n        out.push(u8(cp))\n    } else if cp <= 0x7FF {\n        out.push(u8(0xC0.bit_or(cp.shr(6))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else if cp <= 0xFFFF {\n        out.push(u8(0xE0.bit_or(cp.shr(12))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    } else {\n        out.push(u8(0xF0.bit_or(cp.shr(18))))\n        out.push(u8(0x80.bit_or(cp.shr(12).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))\n        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))\n    }\n}\n\nfn unescape_span(input: &[]u8, start: i32, end: i32, has_esc: bool) -> Option<string> {\n    if !has_esc {\n        return bytes.decode_range(&input, start, end).ok()\n    }\n    mut out: []u8 = []\n    out.reserve(end - start)\n    mut i := start\n    while i < end {\n        b := input[i]\n        if b != b'\\\\' {\n            out.push(b)\n            i += 1\n            continue\n        }\n        i += 1\n        esc := input[i]\n        if esc == b'\"' { out.push(b'\"'); i += 1 }\n        else if esc == b'\\\\' { out.push(b'\\\\'); i += 1 }\n        else if esc == b'/' { out.push(b'/'); i += 1 }\n        else if esc == b'b' { out.push(8); i += 1 }\n        else if esc == b'f' { out.push(12); i += 1 }\n        else if esc == b'n' { out.push(10); i += 1 }\n        else if esc == b'r' { out.push(13); i += 1 }\n        else if esc == b't' { out.push(9); i += 1 }\n        else if esc == b'u' {\n            mut cp := 0\n            for k in 1..5 { cp = cp * 16 + hex_val(input[i + k]) }\n            i += 5\n            if cp >= 0xD800 && cp <= 0xDBFF {\n                mut low := 0\n                for k in 2..6 { low = low * 16 + hex_val(input[i + k]) }\n                i += 6\n                cp = 0x10000 + (cp - 0xD800).shl(10) + (low - 0xDC00)\n            }\n            push_codepoint_utf8(&mut out, cp)\n        } else {\n            return .None\n        }\n    }\n    bytes.decode(&out).ok()\n}\n\nimpl Doc {\n    pub fn parse_bytes(move input: []u8) -> Self {\n        est := input.len / 8 + 8\n        mut doc := Self {\n            ok: true, error: \"\", offset: 0, root: -1,\n            input: input, kinds: [], starts: [], ends: [], escaped: [],\n            first_child: [], next_sibling: [], key_starts: [], key_ends: [], key_escaped: [], counts: [],\n        }\n        doc.kinds.reserve(est); doc.starts.reserve(est); doc.ends.reserve(est)\n        mut p := Parser { pos: 0, depth: 0 }\n        root := scan_value(&mut doc, &mut p)\n        if !doc.ok { return doc }\n        skip_ws(&doc.input, &mut p)\n        if p.pos != doc.input.len {\n            fail_doc(&mut doc, p.pos, \"trailing characters after JSON value\")\n            return doc\n        }\n        doc.root = root\n        doc\n    }\n\n    pub fn parse_text(text: string) -> Self {\n        mut raw: []u8 = []\n        bytes.append_utf8(&mut raw, text)\n        Self::parse_bytes(move raw)\n    }\n\n    pub fn parse_utf8(move input: []u8) -> Result<Self, JsonError> {\n        doc := Self::parse_bytes(move input)\n        if !doc.ok { return .Err(JsonError::new(doc.error.clone(), doc.offset)) }\n        .Ok(doc)\n    }\n\n    pub fn parse(text: string) -> Result<Self, JsonError> {\n        doc := Self::parse_text(text)\n        if !doc.ok { return .Err(JsonError::new(doc.error.clone(), doc.offset)) }\n        .Ok(doc)\n    }\n\n    pub fn error_info(&self) -> Option<JsonError> {\n        if self.ok { return .None }\n        .Some(JsonError::new(self.error.clone(), self.offset))\n    }\n\n    pub fn node_offset(&self, node: i32) -> i32 {\n        if self.ok && node >= 0 && node < self.starts.len { return self.starts[node] }\n        self.offset\n    }\n\n    pub fn kind(&self, node: i32) -> Kind {\n        if !self.ok || node < 0 || node >= self.kinds.len { return .Invalid }\n        k := self.kinds[node]\n        if k == 1 { return .Null }\n        if k == 2 { return .Bool }\n        if k == 3 { return .Number }\n        if k == 4 { return .String }\n        if k == 5 { return .Array }\n        if k == 6 { return .Object }\n        .Invalid\n    }\n\n    pub fn count(&self, node: i32) -> i32 {\n        if !self.ok || node < 0 || node >= self.counts.len { return 0 }\n        self.counts[node]\n    }\n\n    fn key_matches(&self, child: i32, key: string) -> bool {\n        ks := self.key_starts[child]\n        ke := self.key_ends[child]\n        if !self.key_escaped[child] {\n            return bytes.equals_text(&self.input, ks, ke, key)\n        }\n        match unescape_span(&self.input, ks, ke, true) {\n            .Some(v) => v == key,\n            .None => false,\n        }\n    }\n\n    pub fn field(&self, obj: i32, key: string) -> i32 {\n        if self.kind(obj) != .Object { return -1 }\n        mut found := -1\n        mut cur := self.first_child[obj]\n        while cur >= 0 {\n            if self.key_matches(cur, key) { found = cur }\n            cur = self.next_sibling[cur]\n        }\n        found\n    }\n\n    pub fn at(&self, arr: i32, index: i32) -> i32 {\n        if self.kind(arr) != .Array || index < 0 || index >= self.counts[arr] { return -1 }\n        mut cur := self.first_child[arr]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        cur\n    }\n\n    pub fn key_at(&self, obj: i32, index: i32) -> Option<string> {\n        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] {\n            return .None\n        }\n        mut cur := self.first_child[obj]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        unescape_span(&self.input, self.key_starts[cur], self.key_ends[cur], self.key_escaped[cur])\n    }\n\n    pub fn val_at(&self, obj: i32, index: i32) -> i32 {\n        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] { return -1 }\n        mut cur := self.first_child[obj]\n        for _ in 0..index { cur = self.next_sibling[cur] }\n        cur\n    }\n\n    pub fn as_bool(&self, node: i32) -> Option<bool> {\n        if self.kind(node) != .Bool { return .None }\n        .Some(self.input[self.starts[node]] == b't')\n    }\n\n    pub fn as_i64(&self, node: i32) -> Option<i64> {\n        if self.kind(node) != .Number { return .None }\n        parsed := parse.i64_range(bytes.decode_range(&self.input, self.starts[node], self.ends[node]).unwrap_or_default(), 0, self.ends[node] - self.starts[node])\n        if parsed.ok { .Some(parsed.value) } else { .None }\n    }\n\n    pub fn as_u64(&self, node: i32) -> Option<u64> {\n        if self.kind(node) != .Number { return .None }\n        s := self.starts[node]; e := self.ends[node]\n        if s < e && self.input[s] == b'-' { return .None }\n        parsed := parse.u64_range(bytes.decode_range(&self.input, s, e).unwrap_or_default(), 0, e - s)\n        if parsed.ok { .Some(parsed.value) } else { .None }\n    }\n\n    pub fn as_f64(&self, node: i32) -> Option<f64> {\n        if self.kind(node) != .Number { return .None }\n        parsed := parse.Float64::parse(self.raw_span(node))\n        if parsed.ok { .Some(parsed.value) } else { .None }\n    }\n\n    pub fn as_str(&self, node: i32) -> Option<string> {\n        if self.kind(node) != .String { return .None }\n        unescape_span(&self.input, self.starts[node], self.ends[node], self.escaped[node])\n    }\n\n    pub fn raw_span(&self, node: i32) -> string {\n        if !self.ok || node < 0 || node >= self.starts.len { return \"\" }\n        bytes.decode_range(&self.input, self.starts[node], self.ends[node]).unwrap_or_default()\n    }\n\n    pub fn raw_json(&self, node: i32) -> string {\n        if !self.ok || node < 0 || node >= self.starts.len { return \"\" }\n        if self.kinds[node] == 4 {\n            return bytes.decode_range(&self.input, self.starts[node] - 1, self.ends[node] + 1).unwrap_or_default()\n        }\n        bytes.decode_range(&self.input, self.starts[node], self.ends[node]).unwrap_or_default()\n    }\n\n    pub fn get_bool(&self, obj: i32, key: string) -> Option<bool> { self.as_bool(self.field(obj, key)) }\n    pub fn get_i64(&self, obj: i32, key: string) -> Option<i64> { self.as_i64(self.field(obj, key)) }\n    pub fn get_u64(&self, obj: i32, key: string) -> Option<u64> { self.as_u64(self.field(obj, key)) }\n    pub fn get_f64(&self, obj: i32, key: string) -> Option<f64> { self.as_f64(self.field(obj, key)) }\n    pub fn get_str(&self, obj: i32, key: string) -> Option<string> { self.as_str(self.field(obj, key)) }\n}\n\npub trait Decode {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError>\n}\n\nimpl Decode for bool {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        match doc.as_bool(node) {\n            .Some(v) => .Ok(v),\n            .None => .Err(JsonError::new(\"expected JSON boolean\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for i64 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON integer\", doc.node_offset(node)))\n        }\n        match doc.as_i64(node) {\n            .Some(v) => .Ok(v),\n            .None => .Err(JsonError::new(\"invalid i64 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for i32 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON integer\", doc.node_offset(node)))\n        }\n        match doc.as_i64(node) {\n            .Some(v) => {\n                if v < -2147483648 || v > 2147483647 {\n                    return .Err(JsonError::new(\"i32 out of range\", doc.node_offset(node)))\n                }\n                .Ok(i32(v))\n            },\n            .None => .Err(JsonError::new(\"invalid i32 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for u64 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON unsigned integer\", doc.node_offset(node)))\n        }\n        match doc.as_u64(node) {\n            .Some(v) => .Ok(v),\n            .None => .Err(JsonError::new(\"invalid u64 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for u8 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON unsigned integer\", doc.node_offset(node)))\n        }\n        match doc.as_u64(node) {\n            .Some(v) => {\n                if v > 255 {\n                    return .Err(JsonError::new(\"u8 out of range\", doc.node_offset(node)))\n                }\n                .Ok(u8(v))\n            },\n            .None => .Err(JsonError::new(\"invalid u8 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for u16 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON unsigned integer\", doc.node_offset(node)))\n        }\n        match doc.as_u64(node) {\n            .Some(v) => {\n                if v > 65535 {\n                    return .Err(JsonError::new(\"u16 out of range\", doc.node_offset(node)))\n                }\n                .Ok(u16(v))\n            },\n            .None => .Err(JsonError::new(\"invalid u16 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for u32 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON unsigned integer\", doc.node_offset(node)))\n        }\n        match doc.as_u64(node) {\n            .Some(v) => {\n                if v > 4294967295 {\n                    return .Err(JsonError::new(\"u32 out of range\", doc.node_offset(node)))\n                }\n                .Ok(u32(v))\n            },\n            .None => .Err(JsonError::new(\"invalid u32 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for usize {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON unsigned integer\", doc.node_offset(node)))\n        }\n        match doc.as_u64(node) {\n            .Some(v) => {\n                casted := usize(v)\n                if u64(casted) != v {\n                    return .Err(JsonError::new(\"usize out of range\", doc.node_offset(node)))\n                }\n                .Ok(casted)\n            },\n            .None => .Err(JsonError::new(\"invalid usize JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for f64 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON number\", doc.node_offset(node)))\n        }\n        match doc.as_f64(node) {\n            .Some(v) => .Ok(v),\n            .None => .Err(JsonError::new(\"invalid f64 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for f32 {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Number {\n            return .Err(JsonError::new(\"expected JSON number\", doc.node_offset(node)))\n        }\n        match doc.as_f64(node) {\n            .Some(v) => {\n                f := f32(v)\n                if !f.is_finite() {\n                    return .Err(JsonError::new(\"f32 out of range\", doc.node_offset(node)))\n                }\n                .Ok(f)\n            },\n            .None => .Err(JsonError::new(\"invalid f32 JSON number\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for string {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .String {\n            return .Err(JsonError::new(\"expected JSON string\", doc.node_offset(node)))\n        }\n        match doc.as_str(node) {\n            .Some(v) => .Ok(v),\n            .None => .Err(JsonError::new(\"invalid JSON string\", doc.node_offset(node))),\n        }\n    }\n}\n\nimpl Decode for []T where T: Decode {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if doc.kind(node) != .Array {\n            return .Err(JsonError::new(\"expected JSON array\", doc.node_offset(node)))\n        }\n        mut out: []T = []\n        out.reserve(doc.count(node))\n        mut cur := doc.first_child[node]\n        while cur >= 0 {\n            item := T::decode_json(&doc, cur)\n            match move item {\n                .Ok(v) => { out.push(move v) },\n                .Err(e) => { return .Err(e) },\n            }\n            cur = doc.next_sibling[cur]\n        }\n        .Ok(out)\n    }\n}\n\nimpl Decode for Option<T> where T: Decode {\n    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {\n        if node < 0 || doc.kind(node) == .Null {\n            return .Ok(.None)\n        }\n        match T::decode_json(&doc, node) {\n            .Ok(v) => .Ok(.Some(v)),\n            .Err(e) => .Err(e),\n        }\n    }\n}\n\npub fn decode<T: Decode + Storable>(doc: &Doc, node: i32) -> Result<T, JsonError> {\n    T::decode_json(&doc, node)\n}\n\npub fn decode_field<T: Decode + Storable>(doc: &Doc, obj: i32, key: string) -> Result<T, JsonError> {\n    if doc.kind(obj) != .Object {\n        return .Err(JsonError::new(\"expected JSON object\", doc.node_offset(obj)))\n    }\n    f := doc.field(obj, key)\n    match T::decode_json(&doc, f) {\n        .Ok(v) => .Ok(v),\n        .Err(e) => {\n            if f < 0 {\n                return .Err(JsonError::new(\"missing field '\" + key + \"'\", doc.node_offset(obj)))\n            }\n            .Err(JsonError::new(\"field '\" + key + \"': \" + e.message, e.offset))\n        }\n    }\n}\n\npub fn from_bytes<T: Decode + Storable>(move raw: []u8) -> Result<T, JsonError> {\n    match Doc::parse_utf8(move raw) {\n        .Ok(doc) => T::decode_json(&doc, doc.root),\n        .Err(e) => .Err(e),\n    }\n}\n\npub fn from_str<T: Decode + Storable>(text: string) -> Result<T, JsonError> {\n    match Doc::parse(text) {\n        .Ok(doc) => T::decode_json(&doc, doc.root),\n        .Err(e) => .Err(e),\n    }\n}\n\n@test fn json_writer_manages_nesting_and_round_trips_numbers() {\n    mut w := Writer::new()\n    w.object()\n    w.key(\"dir\")\n    w.array()\n    w.decimal(-0.0)\n    w.decimal(5e-324)\n    w.decimal(1.7976931348623157e308)\n    w.integer(-99)\n    w.unsigned(18446744073709551615)\n    w.null()\n    w.boolean(true)\n    w.object()\n    w.end()\n    w.end()\n    w.key(\"name\")\n    w.string(\"quote \\\"🌍\\\"\")\n    w.end()\n    encoded := w.finish()\n    assert(encoded.is_ok())\n    doc := Doc::parse_text(encoded.unwrap())\n    assert(doc.ok)\n    dir := doc.field(doc.root, \"dir\")\n    assert(doc.count(dir) == 8)\n    assert(doc.as_f64(doc.at(dir, 0)).unwrap().to_bits() == -9223372036854775808)\n    assert(doc.as_f64(doc.at(dir, 1)).unwrap().to_bits() == 1)\n    assert(doc.as_f64(doc.at(dir, 2)).unwrap().to_bits() == 0x7fefffffffffffff)\n    assert(doc.as_f64(doc.at(dir, 3)).unwrap() == -99.0)\n    assert(doc.as_u64(doc.at(dir, 4)).unwrap() == 18446744073709551615)\n    assert(doc.as_f64(doc.at(dir, 5)).is_none())\n    assert(doc.as_bool(doc.at(dir, 6)).unwrap())\n    assert(doc.kind(doc.at(dir, 7)) == .Object)\n    assert(doc.get_str(doc.root, \"name\").unwrap() == \"quote \\\"🌍\\\"\")\n\n    numbers := Doc::parse_text(\"{\\\"negativeZero\\\":-0,\\\"tooLarge\\\":1e309,\\\"finite\\\":-12.5e-1}\")\n    assert(numbers.ok)\n    assert(numbers.get_f64(numbers.root, \"negativeZero\").unwrap().is_sign_negative())\n    assert(numbers.get_f64(numbers.root, \"tooLarge\").is_none())\n    assert(numbers.get_f64(numbers.root, \"missing\").is_none())\n    assert(numbers.get_f64(numbers.root, \"finite\").unwrap() == -1.25)\n    assert(numbers.get_i64(numbers.root, \"finite\").is_none())\n}\n\n@test fn json_writer_rejects_invalid_sequences_and_nonfinite_values() {\n    mut unfinished := Writer::new()\n    assert(unfinished.finish().is_err())\n    unfinished.object()\n    unfinished.key(\"missing\")\n    assert(unfinished.finish().is_err())\n    unfinished.end()\n    unfinished.integer(1)\n    assert(unfinished.finish().is_err())\n\n    mut roots := Writer::new()\n    roots.null()\n    assert(roots.finish() == .Ok(\"null\"))\n    roots.null()\n    assert(roots.finish().is_err())\n\n    mut nonfinite := Writer::new()\n    nonfinite.array()\n    nonfinite.decimal(1.0 / 0.0)\n    nonfinite.end()\n    assert(nonfinite.finish().is_err())\n\n    mut output: []u8 = []\n    mut first := begin_obj(&mut output)\n    assert(!field_f64(&mut output, &mut first, \"nan\", 0.0 / 0.0))\n    assert(first && output.len == 1)\n    assert(field_f64(&mut output, &mut first, \"number\", 1.25))\n    end_obj(&mut output)\n    assert(finish_text(&output) == \"{\\\"number\\\":1.25}\")\n}\n\n@test\nfn json_doc_impl_methods_work() {\n    doc := Doc::parse_text(\"{\\\"k\\\":\\\"v\\\",\\\"xs\\\":[1,2]}\")\n    assert(doc.ok)\n    assert(doc.get_str(doc.root, \"k\") == .Some(\"v\"))\n    assert(doc.key_at(doc.root, 0) == .Some(\"k\"))\n    xs := doc.field(doc.root, \"xs\")\n    assert(doc.count(xs) == 2)\n    assert(doc.as_i64(doc.at(xs, 1)) == .Some(2))\n}\n\n@test\nfn json_writer_and_zero_dom_parser_handle_nesting_unicode_and_errors() {\n    mut out: []u8 = []\n    mut first := begin_obj(&mut out)\n    field_str(&mut out, &mut first, \"kind\", \"runtime_profile\")\n    field_i32(&mut out, &mut first, \"version\", 1)\n    field_bool(&mut out, &mut first, \"ok\", true)\n    field_u64(&mut out, &mut first, \"max_u64\", 18446744073709551615)\n    field_str(&mut out, &mut first, \"msg\", \"rad1\\n\\\"åäö\\\" 🌍\")\n    mut af := begin_field_arr(&mut out, &mut first, \"items\")\n    sep_elem(&mut out, &mut af); write_i64(&mut out, -42)\n    sep_elem(&mut out, &mut af); write_null(&mut out)\n    end_arr(&mut out)\n    end_obj(&mut out)\n\n    doc := Doc::parse_bytes(out.clone())\n    assert(doc.ok)\n    assert(doc.get_str(doc.root, \"kind\") == .Some(\"runtime_profile\"))\n    assert(doc.get_i64(doc.root, \"version\") == .Some(1))\n    assert(doc.get_bool(doc.root, \"ok\") == .Some(true))\n    assert(doc.get_u64(doc.root, \"max_u64\") == .Some(18446744073709551615))\n    assert(doc.get_str(doc.root, \"msg\") == .Some(\"rad1\\n\\\"åäö\\\" 🌍\"))\n    items := doc.field(doc.root, \"items\")\n    assert(doc.count(items) == 2)\n    assert(doc.as_i64(doc.at(items, 0)) == .Some(-42))\n    assert(doc.kind(doc.at(items, 1)) == .Null)\n    out.clear()\n    assert(doc.get_str(doc.root, \"kind\") == .Some(\"runtime_profile\"))\n\n    sur := Doc::parse_text(\"{\\\"a\\\":1,\\\"a\\\":2,\\\"globe\\\":\\\"\\\\uD83C\\\\uDF0D\\\"}\")\n    assert(sur.ok)\n    assert(sur.get_i64(sur.root, \"a\") == .Some(2))\n    assert(sur.get_str(sur.root, \"globe\") == .Some(\"🌍\"))\n\n    assert(Doc::parse(\"{\\\"a\\\":01}\").is_err())\n    assert(Doc::parse(\"{\\\"a\\\":1} trailing\").is_err())\n    assert(Doc::parse(\"\\\"\\\\uD800\\\"\").is_err())\n\n    mut w := Writer::default()\n    w.object()\n    field_value<i32>(&mut w, \"count\", 7)\n    field_value<[]string>(&mut w, \"tags\", &[\"a\", \"b\"])\n    w.end()\n    assert(w.finish() == .Ok(\"{\\\"count\\\":7,\\\"tags\\\":[\\\"a\\\",\\\"b\\\"]}\"))\n    assert(to_string<[]i32>(&[1, 2, 3]) == .Ok(\"[1,2,3]\"))\n    assert(Kind.Array.str() == \"Array\" && Kind.Null == Kind.Null)\n\n    raw_doc := Doc::parse_text(\"{\\\"s\\\":\\\"a\\\\n\\\\\\\"å🌍\\\\\\\"\\\",\\\"n\\\":-12.50,\\\"b\\\":true,\\\"z\\\":null,\\\"a\\\":[1, 2],\\\"o\\\":{\\\"k\\\":1}}\")\n    assert(raw_doc.ok)\n    s_node := raw_doc.field(raw_doc.root, \"s\")\n    assert(raw_doc.raw_span(s_node) == \"a\\\\n\\\\\\\"å🌍\\\\\\\"\")\n    assert(raw_doc.raw_json(s_node) == \"\\\"a\\\\n\\\\\\\"å🌍\\\\\\\"\\\"\")\n    assert(Doc::parse_text(raw_doc.raw_json(s_node)).get_str(0, \"\").is_none() &&\n        Doc::parse_text(raw_doc.raw_json(s_node)).as_str(0) == .Some(\"a\\n\\\"å🌍\\\"\"))\n    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, \"n\")) == \"-12.50\")\n    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, \"b\")) == \"true\")\n    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, \"z\")) == \"null\")\n    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, \"a\")) == \"[1, 2]\")\n    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, \"o\")) == \"{\\\"k\\\":1}\")\n    assert(raw_doc.raw_json(-1) == \"\" && raw_doc.raw_span(-1) == \"\")\n    mut bad_escaped: []u8 = [b'\"', b'\\\\', b'n', 0xff, b'\"']\n    assert(Doc::parse_utf8(move bad_escaped).is_err())\n}\n\n@test\nfn json_decode_primitives_arrays_and_options() {\n    assert(from_str<bool>(\"true\") == .Ok(true))\n    assert(from_str<i32>(\"-42\") == .Ok(-42))\n    assert(from_str<u8>(\"255\") == .Ok(u8(255)))\n    assert(from_str<u8>(\"256\").is_err())\n    assert(from_str<u8>(\"-1\").is_err())\n    assert(from_str<i32>(\"3000000000\").is_err())\n    assert(from_str<string>(\"\\\"hello\\\\n\\\"\") == .Ok(\"hello\\n\"))\n    assert(from_str<[]i32>(\"[1,2,3]\") == .Ok([1, 2, 3]))\n    assert(from_str<Option<i32>>(\"null\") == .Ok(.None))\n    assert(from_str<Option<i32>>(\"9\") == .Ok(.Some(9)))\n    assert(from_str<Option<i32>>(\"{\").is_err())\n    opt_some: Option<i32> = .Some(5)\n    opt_none: Option<i32> = .None\n    assert(to_string<Option<i32>>(&opt_some) == .Ok(\"5\"))\n    assert(to_string<Option<i32>>(&opt_none) == .Ok(\"null\"))\n    raw: []u8 = [b'[', b'1', b',', b'2', b']']\n    assert(from_bytes<[]i32>(move raw) == .Ok([1, 2]))\n}\n" }
    if name == "math" { return "pub const PI: f64 = 3.14159265358979323846\n\npub fn min(a: f64, b: f64) -> f64 {\n    if a.is_nan() { return a }\n    if a < b || (a == b && a.is_sign_negative()) { a } else { b }\n}\n\npub fn max(a: f64, b: f64) -> f64 {\n    if a.is_nan() { return a }\n    if a > b || (a == b && !a.is_sign_negative()) { a } else { b }\n}\n\nfn quiet_nan() -> f64 { f64.from_bits(0x7ff8_0000_0000_0000) }\n\npub fn clamp(value: f64, low: f64, high: f64) -> f64 {\n    if low.is_nan() { return low }\n    if high.is_nan() { return high }\n    if low > high { return quiet_nan() }\n    if value < low { low } else if value > high { high } else { value }\n}\n\nfn product_bit(product: &[i64; 67], index: i32) -> i32 {\n    i32(product[index / 24].shr(index % 24).bit_and(1))\n}\n\n// Payne–Hanek reduction. Multiply the exact significand by floor(2^1536 * 2/pi).\n// The table stores little-endian 24-bit limbs so each product and carry fits i64.\nfn reduce_large(x: f64) -> (i32, f64) {\n    digits: [i64; 64] = [\n        0x73a8c9, 0x1556ca, 0x310606, 0x4d7327, 0xffd880, 0x68408d, 0x5f14a0, 0x659985,\n        0xe61b08, 0x91615e, 0x1da9e3, 0x9af436, 0xcfbc20, 0x6babf0, 0x46fc7b, 0x560330,\n        0x8d5d08, 0x5fb11f, 0xea6bfb, 0x8a5292, 0x0739f7, 0xf17b3d, 0xc7ebe5, 0x7527ba,\n        0x5fea2d, 0x3f669e, 0xb74f46, 0x27cb09, 0x367ecf, 0x6d1f6d, 0x8b5a0a, 0xef2f11,\n        0x05980f, 0x97ffde, 0x3b1ff8, 0xbdf928, 0x845f8b, 0x39f49c, 0x398353, 0x3991d6,\n        0x5f7e41, 0x7026b4, 0x84e99c, 0x2ebb44, 0x8235f5, 0xa73ee8, 0x1cb129, 0xfe1deb,\n        0xd1921c, 0x2eea09, 0xe00649, 0x424dd2, 0x246e3a, 0xc561b7, 0xabdebb, 0xfe5163,\n        0x439041, 0x95993c, 0xc0db62, 0xf534dd, 0x2757d1, 0x1529fc, 0x6e4e44, 0xa2f983,\n    ]\n    bits := x.to_bits()\n    significand := bits.bit_and(0x000f_ffff_ffff_ffff).bit_or(0x0010_0000_0000_0000)\n    exponent := i32(bits.shr(52)) - 1023\n    point := 1536 + 52 - exponent\n    mask: i64 = 0xff_ffff\n    low := significand.bit_and(mask)\n    middle := significand.shr(24).bit_and(mask)\n    high := significand.shr(48)\n    mut product: [i64; 67] = [0; 67]\n    mut carry: i64 = 0\n    // Only the two integer bits adjoining the binary point determine the quadrant.\n    for i in 0..((point + 1) / 24 + 1) {\n        mut sum := carry\n        if i < digits.len { sum += low * digits[i] }\n        if i >= 1 && i - 1 < digits.len { sum += middle * digits[i - 1] }\n        if i >= 2 && i - 2 < digits.len { sum += high * digits[i - 2] }\n        product[i] = sum.bit_and(mask)\n        carry = sum.shr(24)\n    }\n    quadrant := product_bit(&product, point) + 2 * product_bit(&product, point + 1)\n    round_up := product_bit(&product, point - 1) != 0\n    if round_up {\n        // Take the fixed-point complement before conversion to avoid cancellation near a multiple of pi/2.\n        carry = 1\n        for i in 0..((point + 23) / 24) {\n            limb := mask - product[i] + carry\n            product[i] = limb.bit_and(mask)\n            carry = limb.shr(24)\n        }\n    }\n    mut fraction := 0.0\n    whole := point / 24\n    for i in 0..whole { fraction = (fraction + f64(product[i])) / 16777216.0 }\n    rest := point % 24\n    if rest != 0 {\n        scale := i64(1).shl(rest)\n        fraction = (fraction + f64(product[whole].bit_and(scale - 1))) / f64(scale)\n    }\n    remainder := fraction * 1.5707963267948966\n    if round_up { return ((quadrant + 1).bit_and(3), -remainder) }\n    (quadrant, remainder)\n}\n\nfn reduce(x: f64) -> (i32, f64) {\n    if x < 524288.0 {\n        // The leading two parts of pi/2 have at most 33 significant bits.\n        // Their products with the integer multiple are exact in this range.\n        multiple := (x * 0.6366197723675814).round_ties_even()\n        remainder := ((x - multiple * 1.5707963267341256) -\n            multiple * 6.077100506303966e-11) - multiple * 2.0222662487959506e-21\n        if remainder.abs() > 2.9103830456733704e-11 && remainder.abs() <= 0.7853981633974483 {\n            return (i32(multiple).bit_and(3), remainder)\n        }\n    }\n    reduce_large(x)\n}\n\n// Taylor kernels on [-pi/4, pi/4], evaluated with Horner's rule.\nfn sine_kernel(x: f64) -> f64 {\n    square := x * x\n    mut coefficient := 2.8114572543455206e-15\n    coefficient = -7.647163731819816e-13 + square * coefficient\n    coefficient = 1.6059043836821613e-10 + square * coefficient\n    coefficient = -2.505210838544172e-8 + square * coefficient\n    coefficient = 2.7557319223985893e-6 + square * coefficient\n    coefficient = -0.0001984126984126984 + square * coefficient\n    coefficient = 0.008333333333333333 + square * coefficient\n    coefficient = -0.16666666666666666 + square * coefficient\n    x + (x * square) * coefficient\n}\n\nfn cosine_kernel(x: f64) -> f64 {\n    square := x * x\n    mut coefficient := -1.5619206968586225e-16\n    coefficient = 4.779477332387385e-14 + square * coefficient\n    coefficient = -1.1470745597729725e-11 + square * coefficient\n    coefficient = 2.08767569878681e-9 + square * coefficient\n    coefficient = -2.755731922398589e-7 + square * coefficient\n    coefficient = 2.48015873015873e-5 + square * coefficient\n    coefficient = -0.001388888888888889 + square * coefficient\n    coefficient = 0.041666666666666664 + square * coefficient\n    coefficient = -0.5 + square * coefficient\n    1.0 + square * coefficient\n}\n\nenum Trig { Sine, Cosine, Tangent }\n\nfn trig(angle: f64, operation: Trig) -> f64 {\n    if !angle.is_finite() {\n        return if angle.is_nan() { angle } else { quiet_nan() }\n    }\n    mut remainder := angle.abs()\n    mut quadrant := 0\n    if remainder > 0.7853981633974483 {\n        (q, r) := reduce(remainder)\n        quadrant = q\n        remainder = r\n    }\n    if operation == Trig.Tangent {\n        sine := sine_kernel(remainder)\n        cosine := cosine_kernel(remainder)\n        value := if quadrant.bit_and(1) == 0 { sine / cosine } else { -cosine / sine }\n        return if angle.is_sign_negative() { -value } else { value }\n    }\n    if operation == Trig.Cosine { quadrant = (quadrant + 1).bit_and(3) }\n    value := if quadrant.bit_and(1) == 0 { sine_kernel(remainder) } else { cosine_kernel(remainder) }\n    negative := (quadrant >= 2) != (operation == Trig.Sine && angle.is_sign_negative())\n    if negative { -value } else { value }\n}\n\npub fn sin(angle: f64) -> f64 { trig(angle, .Sine) }\npub fn cos(angle: f64) -> f64 { trig(angle, .Cosine) }\npub fn tan(angle: f64) -> f64 { trig(angle, .Tangent) }\n\npub trait Trigonometry {\n    fn sin(&self) -> Self\n    fn cos(&self) -> Self\n    fn tan(&self) -> Self\n}\n\nimpl Trigonometry for f32 {\n    fn sin(&self) -> f32 { f32(sin(f64(self))) }\n    fn cos(&self) -> f32 { f32(cos(f64(self))) }\n    fn tan(&self) -> f32 { f32(tan(f64(self))) }\n}\n\nimpl Trigonometry for f64 {\n    fn sin(&self) -> f64 { sin(self) }\n    fn cos(&self) -> f64 { cos(self) }\n    fn tan(&self) -> f64 { tan(self) }\n}\n\n@test fn trigonometric_methods_preserve_precision_and_sign() {\n    x: f32 = -0.75\n    a: f32 = x.sin()\n    b: f32 = x.cos()\n    c: f32 = x.tan()\n    assert(a == f32(sin(f64(x))) && b == f32(cos(f64(x))) && c == f32(tan(f64(x))))\n    y: f64 = -0.75\n    assert(y.sin() == sin(y) && y.cos() == cos(y) && y.tan() == tan(y))\n    zero: f32 = -0.0\n    assert(zero.sin().is_sign_negative() && zero.tan().is_sign_negative())\n}\n\nconst LN2_HIGH: f64 = 0.69314718036912381649\nconst LN2_LOW: f64 = 1.90821492927058770002e-10\n\nfn scale_normal(exponent: i32) -> f64 { f64.from_bits(i64(exponent + 1023).shl(52)) }\n\nfn positive_infinity() -> f64 { f64.from_bits(0x7ff0_0000_0000_0000) }\n\nfn exp_parts(x: f64, tail: f64) -> f64 {\n    if x.is_nan() { return x }\n    if x > 710.0 { return positive_infinity() }\n    if x < -746.0 { return 0.0 }\n    multiple := (x * 1.4426950408889634).round_ties_even()\n    r := (x - multiple * LN2_HIGH) + (tail - multiple * LN2_LOW)\n    mut polynomial := 1.0\n    mut k := 16\n    while k >= 1 {\n        polynomial = 1.0 + (r / f64(k)) * polynomial\n        k -= 1\n    }\n    power := i32(multiple)\n    if power > 1023 { return (polynomial * scale_normal(power - 1023)) * scale_normal(1023) }\n    if power < -1022 { return (polynomial * scale_normal(power + 1022)) * scale_normal(-1022) }\n    polynomial * scale_normal(power)\n}\n\npub fn exp(x: f64) -> f64 { exp_parts(x, 0.0) }\n\nfn product_error(a: f64, b: f64, product: f64) -> f64 {\n    high_a := f64.from_bits(a.to_bits().bit_and(-134217728))\n    high_b := f64.from_bits(b.to_bits().bit_and(-134217728))\n    low_a := a - high_a\n    low_b := b - high_b\n    ((high_a * high_b - product + low_a * high_b) + high_a * low_b) + low_a * low_b\n}\n\nfn log_parts(x: f64) -> (f64, f64) {\n    mut bits := x.to_bits()\n    mut power := i32(bits.shr(52)) - 1023\n    if power == -1023 {\n        bits = (x * 18014398509481984.0).to_bits()\n        power = i32(bits.shr(52)) - 1077\n    }\n    mut m := f64.from_bits(bits.bit_and(0x000f_ffff_ffff_ffff).bit_or(0x3ff0_0000_0000_0000))\n    if m > 1.4142135623730951 { m *= 0.5; power += 1 }\n    f := m - 1.0\n    denominator := 1.0 + m\n    s := f / denominator\n    product := s * denominator\n    correction := ((f - product - product_error(s, denominator, product)) -\n        s * ((1.0 - denominator) + m)) / denominator\n    square := s * s\n    cube := s * square\n    cube_low := product_error(s, square, cube) + s * product_error(s, s, square)\n    third := cube / 3.0\n    rounded := third * 3.0\n    third_low := ((cube - rounded) - product_error(third, 3.0, rounded) + cube_low) / 3.0\n    mut series := 0.0\n    mut odd := 27\n    while odd >= 5 {\n        series = 1.0 / f64(odd) + square * series\n        odd -= 2\n    }\n    large := f64(power) * LN2_HIGH\n    linear := 2.0 * s\n    head := large + linear\n    cubic := 2.0 * third\n    sum := head + cubic\n    tail := ((large - head) + linear) + ((head - sum) + cubic) + f64(power) * LN2_LOW +\n        2.0 * ((correction / (1.0 - square) + third_low) + (cube * square) * series)\n    total := sum + tail\n    (total, (sum - total) + tail)\n}\n\npub fn log(x: f64) -> f64 {\n    if x.is_nan() { return x }\n    if x == 0.0 { return -positive_infinity() }\n    if x < 0.0 { return quiet_nan() }\n    if x.is_infinite() { return x }\n    (value, _) := log_parts(x)\n    value\n}\n\npub fn pow(base: f64, exponent: f64) -> f64 {\n    if exponent == 0.0 || base == 1.0 { return 1.0 }\n    if exponent.is_nan() { return exponent }\n    if base.is_nan() { return base }\n    magnitude := base.abs()\n    if exponent.is_infinite() {\n        if magnitude == 1.0 { return 1.0 }\n        return if (magnitude > 1.0) == (exponent > 0.0) { positive_infinity() } else { 0.0 }\n    }\n    integral := exponent == exponent.trunc()\n    negative := base.is_sign_negative() && integral && exponent.abs() < 9007199254740992.0 &&\n        i64(exponent).bit_and(1) != 0\n    mut result := 0.0\n    if magnitude == 0.0 || magnitude.is_infinite() {\n        if (magnitude == 0.0) == (exponent < 0.0) { result = positive_infinity() }\n    } else {\n        if base < 0.0 && !integral { return quiet_nan() }\n        if exponent == 1.0 { return base }\n        if exponent == -1.0 { return 1.0 / base }\n        if exponent == 2.0 { return base * base }\n        if exponent == 0.5 { return base.sqrt() }\n        (head, tail) := log_parts(magnitude)\n        value := exponent * head\n        if value > 710.0 { result = positive_infinity() }\n        else if value >= -746.0 {\n            result = exp_parts(value, product_error(exponent, head, value) + exponent * tail)\n        }\n    }\n    if negative { -result } else { result }\n}\n\nfn atan_unit(ratio: f64) -> f64 {\n    reduce := ratio > 0.414213562373095\n    x := if reduce { (ratio - 1.0) / (ratio + 1.0) } else { ratio }\n    square := x * x\n    mut series := 0.0\n    mut odd := 43\n    while odd >= 3 {\n        series = 1.0 / f64(odd) - square * series\n        odd -= 2\n    }\n    angle := x - x * square * series\n    if reduce { PI / 4.0 + angle } else { angle }\n}\n\npub fn atan2(y: f64, x: f64) -> f64 {\n    if y.is_nan() { return y }\n    if x.is_nan() { return x }\n    ax := x.abs()\n    ay := y.abs()\n    mut angle := 0.0\n    if ay == 0.0 { angle = 0.0 }\n    else if ax == ay { angle = PI / 4.0 }\n    else if ay > ax { angle = PI / 2.0 - atan_unit(ax / ay) }\n    else { angle = atan_unit(ay / ax) }\n    if x.is_sign_negative() { angle = PI - angle }\n    if y.is_sign_negative() { -angle } else { angle }\n}\n\n@test\nfn atan2_handles_quadrants_and_axis_limits() {\n    inf := f64.from_bits(0x7ff0_0000_0000_0000)\n    assert(atan2(0.0, -0.0) == PI && atan2(-0.0, -0.0) == -PI)\n    assert(atan2(-0.0, 1.0).is_sign_negative() && !atan2(0.0, 0.0).is_sign_negative())\n    assert(atan2(1.0, 0.0) == PI / 2.0 && atan2(-inf, 1.0) == -PI / 2.0)\n    assert(atan2(inf, -inf) == 3.0 * PI / 4.0 && atan2(-inf, inf) == -PI / 4.0)\n    assert(atan2(-1.0, inf).is_sign_negative() && atan2(1.0, -inf) == PI)\n    assert(atan2(quiet_nan(), 1.0).is_nan() && atan2(1.0, quiet_nan()).is_nan())\n    assert(atan2(f64.from_bits(1), 1.0).to_bits() == 1)\n    for angle in [-3.0, -2.4, -0.5, 0.1, 0.4, 0.75, 1.2, 2.0, 3.0] {\n        assert((atan2(sin(angle), cos(angle)) - angle).abs() < 5e-16)\n    }\n}\n\nfn total_order_bits_f64(x: f64) -> i64 {\n    bits := x.to_bits()\n    if bits < 0 { bits.bit_xor(9223372036854775807) } else { bits }\n}\n\nfn total_order_bits_f32(x: f32) -> i32 {\n    bits := x.to_bits()\n    if bits < 0 { bits.bit_xor(2147483647) } else { bits }\n}\n\npub fn total_cmp_f64(a: &f64, b: &f64) -> Ordering {\n    total_order_bits_f64(a).cmp(total_order_bits_f64(b))\n}\n\npub fn total_cmp_f32(a: &f32, b: &f32) -> Ordering {\n    total_order_bits_f32(a).cmp(total_order_bits_f32(b))\n}\n\npub fn checked_add_i32(a: i32, b: i32) -> Result<i32, ()> {\n    sum := i64(a) + i64(b)\n    if sum < -2147483648 || sum > 2147483647 { return .Err }\n    .Ok(i32(sum))\n}\n\npub fn checked_sub_i32(a: i32, b: i32) -> Result<i32, ()> {\n    diff := i64(a) - i64(b)\n    if diff < -2147483648 || diff > 2147483647 { return .Err }\n    .Ok(i32(diff))\n}\n\npub fn checked_mul_i32(a: i32, b: i32) -> Result<i32, ()> {\n    prod := i64(a) * i64(b)\n    if prod < -2147483648 || prod > 2147483647 { return .Err }\n    .Ok(i32(prod))\n}\n\npub fn checked_div_i32(a: i32, b: i32) -> Result<i32, ()> {\n    if b == 0 || (a == -2147483648 && b == -1) { return .Err }\n    .Ok(a / b)\n}\n\npub fn checked_rem_i32(a: i32, b: i32) -> Result<i32, ()> {\n    if b == 0 || (a == -2147483648 && b == -1) { return .Err }\n    .Ok(a % b)\n}\n\npub fn checked_neg_i32(a: i32) -> Result<i32, ()> {\n    if a == -2147483648 { return .Err }\n    .Ok(-a)\n}\n\nfn i64_max() -> i64 { 9223372036854775807 }\nfn i64_min() -> i64 { (-9223372036854775807) - 1 }\n\npub fn checked_add_i64(a: i64, b: i64) -> Result<i64, ()> {\n    if b > 0 && a > i64_max() - b { return .Err }\n    if b < 0 && a < i64_min() - b { return .Err }\n    .Ok(a + b)\n}\n\npub fn checked_sub_i64(a: i64, b: i64) -> Result<i64, ()> {\n    if b < 0 && a > i64_max() + b { return .Err }\n    if b > 0 && a < i64_min() + b { return .Err }\n    .Ok(a - b)\n}\n\npub fn checked_mul_i64(a: i64, b: i64) -> Result<i64, ()> {\n    if a == 0 || b == 0 { return .Ok(0) }\n    min := i64_min()\n    max := i64_max()\n    if a > 0 {\n        if b > 0 {\n            if a > max / b { return .Err }\n        } else {\n            if b < min / a { return .Err }\n        }\n    } else {\n        if b > 0 {\n            if a < min / b { return .Err }\n        } else {\n            if a == min || b == min { return .Err }\n            if a < max / b { return .Err }\n        }\n    }\n    .Ok(a * b)\n}\n\npub fn checked_div_i64(a: i64, b: i64) -> Result<i64, ()> {\n    if b == 0 || (a == i64_min() && b == -1) { return .Err }\n    .Ok(a / b)\n}\n\npub fn checked_rem_i64(a: i64, b: i64) -> Result<i64, ()> {\n    if b == 0 || (a == i64_min() && b == -1) { return .Err }\n    .Ok(a % b)\n}\n\npub fn checked_neg_i64(a: i64) -> Result<i64, ()> {\n    if a == i64_min() { return .Err }\n    .Ok(-a)\n}\n\npub fn checked_add_u32(a: u32, b: u32) -> Result<u32, ()> {\n    sum := u64(a) + u64(b)\n    if sum > u64(4294967295) { return .Err }\n    .Ok(u32(sum))\n}\n\npub fn checked_sub_u32(a: u32, b: u32) -> Result<u32, ()> {\n    if a < b { return .Err }\n    .Ok(a - b)\n}\n\npub fn checked_mul_u32(a: u32, b: u32) -> Result<u32, ()> {\n    prod := u64(a) * u64(b)\n    if prod > u64(4294967295) { return .Err }\n    .Ok(u32(prod))\n}\n\npub fn checked_div_u32(a: u32, b: u32) -> Result<u32, ()> {\n    if b == u32(0) { return .Err }\n    .Ok(a / b)\n}\n\npub fn checked_rem_u32(a: u32, b: u32) -> Result<u32, ()> {\n    if b == u32(0) { return .Err }\n    .Ok(a % b)\n}\n\npub fn checked_add_u64(a: u64, b: u64) -> Result<u64, ()> {\n    max := u64(0).wrapping_sub(u64(1))\n    if a > max - b { return .Err }\n    .Ok(a + b)\n}\n\npub fn checked_sub_u64(a: u64, b: u64) -> Result<u64, ()> {\n    if a < b { return .Err }\n    .Ok(a - b)\n}\n\npub fn checked_mul_u64(a: u64, b: u64) -> Result<u64, ()> {\n    max := u64(0).wrapping_sub(u64(1))\n    if b != u64(0) && a > max / b { return .Err }\n    .Ok(a * b)\n}\n\npub fn checked_div_u64(a: u64, b: u64) -> Result<u64, ()> {\n    if b == u64(0) { return .Err }\n    .Ok(a / b)\n}\n\npub fn checked_rem_u64(a: u64, b: u64) -> Result<u64, ()> {\n    if b == u64(0) { return .Err }\n    .Ok(a % b)\n}\n\npub fn checked_add_usize(a: usize, b: usize) -> Result<usize, ()> {\n    max := usize(0).wrapping_sub(usize(1))\n    if a > max - b { return .Err }\n    .Ok(a + b)\n}\n\npub fn checked_sub_usize(a: usize, b: usize) -> Result<usize, ()> {\n    if a < b { return .Err }\n    .Ok(a - b)\n}\n\npub fn checked_mul_usize(a: usize, b: usize) -> Result<usize, ()> {\n    max := usize(0).wrapping_sub(usize(1))\n    if b != usize(0) && a > max / b { return .Err }\n    .Ok(a * b)\n}\n\npub fn checked_div_usize(a: usize, b: usize) -> Result<usize, ()> {\n    if b == usize(0) { return .Err }\n    .Ok(a / b)\n}\n\npub fn checked_rem_usize(a: usize, b: usize) -> Result<usize, ()> {\n    if b == usize(0) { return .Err }\n    .Ok(a % b)\n}\n\n@test\nfn total_cmp_orders_signed_zero_infinities_and_nans() {\n    neg_nan := f64.from_bits(-2251799813685248)\n    neg_inf := -1.0 / 0.0\n    neg_zero := -0.0\n    pos_zero := 0.0\n    pos_inf := 1.0 / 0.0\n    pos_nan := f64.from_bits(9221120237041090560)\n    assert(total_cmp_f64(neg_nan, neg_inf) == Ordering.Less)\n    assert(total_cmp_f64(neg_inf, -1.0) == Ordering.Less)\n    assert(total_cmp_f64(-1.0, neg_zero) == Ordering.Less)\n    assert(total_cmp_f64(neg_zero, pos_zero) == Ordering.Less)\n    assert(total_cmp_f64(pos_zero, 1.0) == Ordering.Less)\n    assert(total_cmp_f64(1.0, pos_inf) == Ordering.Less)\n    assert(total_cmp_f64(pos_inf, pos_nan) == Ordering.Less)\n    assert(total_cmp_f64(pos_nan, pos_nan) == Ordering.Equal)\n\n    f_neg_zero := f32.from_bits(-2147483648)\n    f_pos_zero := f32(0.0)\n    assert(total_cmp_f32(f_neg_zero, f_pos_zero) == Ordering.Less)\n    assert(total_cmp_f32(f32(1.5), f32(1.5)) == Ordering.Equal)\n}\n\n@test\nfn checked_integer_arithmetic_detects_overflow_and_division_by_zero() {\n    assert(checked_add_i32(2147483647, 0).unwrap_or(-1) == 2147483647)\n    assert(checked_add_i32(2147483647, 1).is_err())\n    assert(checked_add_i32(-2147483648, -1).is_err())\n    assert(checked_sub_i32(-2147483648, 1).is_err())\n    assert(checked_sub_i32(2147483647, -1).is_err())\n    assert(checked_mul_i32(46341, 46341).is_err())\n    assert(checked_mul_i32(-2147483648, -1).is_err())\n    assert(checked_mul_i32(-2147483648, 1).unwrap_or(0) == -2147483648)\n    assert(checked_div_i32(-2147483648, -1).is_err())\n    assert(checked_div_i32(10, 0).is_err())\n    assert(checked_rem_i32(-2147483648, -1).is_err())\n    assert(checked_rem_i32(10, 0).is_err())\n    assert(checked_neg_i32(-2147483648).is_err())\n    assert(checked_neg_i32(-2147483647).unwrap_or(0) == 2147483647)\n\n    max64 := i64_max()\n    min64 := i64_min()\n    assert(checked_add_i64(max64, 1).is_err())\n    assert(checked_add_i64(min64, -1).is_err())\n    assert(checked_add_i64(max64, min64).unwrap_or(0) == -1)\n    assert(checked_sub_i64(min64, min64).unwrap_or(1) == 0)\n    assert(checked_sub_i64(min64, 1).is_err())\n    assert(checked_sub_i64(max64, -1).is_err())\n    assert(checked_mul_i64(min64, -1).is_err())\n    assert(checked_mul_i64(-1, min64).is_err())\n    assert(checked_mul_i64(-1, max64).unwrap_or(0) == -max64)\n    assert(checked_mul_i64(max64, -1).unwrap_or(0) == -max64)\n    assert(checked_mul_i64(min64, 2).is_err())\n    assert(checked_mul_i64(3037000500, 3037000500).is_err())\n    assert(checked_mul_i64(-3037000500, -3037000500).is_err())\n    assert(checked_mul_i64(min64, 0).unwrap_or(1) == 0)\n    assert(checked_div_i64(min64, -1).is_err())\n    assert(checked_div_i64(42, 0).is_err())\n    assert(checked_rem_i64(min64, -1).is_err())\n    assert(checked_rem_i64(42, 0).is_err())\n    assert(checked_neg_i64(min64).is_err())\n    assert(checked_neg_i64(-max64).unwrap_or(0) == max64)\n\n    assert(checked_add_u32(4294967295, 1).is_err())\n    assert(checked_sub_u32(3, 4).is_err())\n    assert(checked_mul_u32(65536, 65536).is_err())\n    assert(checked_div_u32(9, 0).is_err())\n    assert(checked_rem_u32(9, 0).is_err())\n\n    maxu64 := u64(0).wrapping_sub(u64(1))\n    assert(checked_add_u64(maxu64, 1).is_err())\n    assert(checked_sub_u64(1, 2).is_err())\n    assert(checked_mul_u64(maxu64, 2).is_err())\n    assert(checked_div_u64(9, 0).is_err())\n    assert(checked_rem_u64(9, 0).is_err())\n\n    maxusz := usize(0).wrapping_sub(usize(1))\n    assert(checked_add_usize(maxusz, 1).is_err())\n    assert(checked_sub_usize(1, 2).is_err())\n    assert(checked_mul_usize(maxusz, 2).is_err())\n    assert(checked_div_usize(9, 0).is_err())\n    assert(checked_rem_usize(9, 0).is_err())\n}\n" }
    if name == "net" { return "capability network, unsafe\nimport std.bytes as bytes\nimport std.io as io\nimport std.text as text\nimport sys\n\n@extern(\"c\", \"socket\")\n@thread_safe\nunsafe fn c_socket(domain: i32, kind: i32, protocol: i32) -> i32\n@extern(\"c\", \"bind\")\n@thread_safe\nunsafe fn c_bind(fd: i32, addr: ptr, addrlen: u32) -> i32\n@extern(\"c\", \"listen\")\n@thread_safe\nunsafe fn c_listen(fd: i32, backlog: i32) -> i32\n@extern(\"c\", \"connect\")\n@thread_safe\nunsafe fn c_connect(fd: i32, addr: ptr, addrlen: u32) -> i32\n@extern(\"c\", \"getsockname\")\n@thread_safe\nunsafe fn c_getsockname(fd: i32, addr: ptr, addrlen: ptr) -> i32\n@extern(\"c\", \"getpeername\")\n@thread_safe\nunsafe fn c_getpeername(fd: i32, addr: ptr, addrlen: ptr) -> i32\n@extern(\"c\", \"setsockopt\")\n@thread_safe\nunsafe fn c_setsockopt(fd: i32, level: i32, optname: i32, optval: ptr, optlen: u32) -> i32\n@extern(\"c\", \"getsockopt\")\n@thread_safe\nunsafe fn c_getsockopt(fd: i32, level: i32, optname: i32, optval: ptr, optlen: ptr) -> i32\n@extern(\"c\", \"sendto\")\n@thread_safe\nunsafe fn c_sendto(fd: i32, buf: ptr, len: usize, flags: i32, dest_addr: ptr, addrlen: u32) -> i64\n@extern(\"c\", \"recvfrom\")\n@thread_safe\nunsafe fn c_recvfrom(fd: i32, buf: ptr, len: usize, flags: i32, src_addr: ptr, addrlen: ptr) -> i64\n@extern(\"c\", \"shutdown\")\n@thread_safe\nunsafe fn c_shutdown(fd: i32, how: i32) -> i32\n@extern(\"c\", \"ioctl\")\n@thread_safe\nunsafe fn c_ioctl(fd: i32, req: usize) -> i32\n@extern(\"c\", \"__error\")\n@thread_safe\nunsafe fn c_errno_ptr() -> ptr\n@extern(\"c\", \"getaddrinfo\")\n@thread_safe\nunsafe fn c_getaddrinfo(node: ptr, service: ptr, hints: ptr, res: ptr) -> i32\n@extern(\"c\", \"freeaddrinfo\")\n@thread_safe\nunsafe fn c_freeaddrinfo(res: ptr)\n@extern(\"c\", \"gai_strerror\")\n@thread_safe\nunsafe fn c_gai_strerror(errcode: i32) -> ptr\n@extern(\"c\", \"pipe\")\n@thread_safe\nunsafe fn net_c_pipe(fds: ptr) -> i32\n@extern(\"c\", \"read\")\n@thread_safe\nunsafe fn net_c_read(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"write\")\n@thread_safe\nunsafe fn net_c_write(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"mmap\")\n@thread_safe\nunsafe fn net_c_mmap(address: ptr, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> ptr\n@extern(\"c\", \"munmap\")\n@thread_safe\nunsafe fn net_c_munmap(address: ptr, length: usize) -> i32\n\npub fn poll_in() -> i32 { 1 }\npub fn poll_out() -> i32 { 4 }\npub fn poll_err() -> i32 { 8 }\npub fn poll_hup() -> i32 { 16 }\npub fn poll_nval() -> i32 { 32 }\npub fn err_would_block() -> i32 { 35 }\n\npub fn ipv4(a: i32, b: i32, c: i32, d: i32) -> i64 {\n    assert(a >= 0 && a <= 255 && b >= 0 && b <= 255 && c >= 0 && c <= 255 && d >= 0 && d <= 255)\n    (i64(a).shl(24)).bit_or(i64(b).shl(16)).bit_or(i64(c).shl(8)).bit_or(i64(d))\n}\npub fn loopback() -> i64 { ipv4(127, 0, 0, 1) }\npub fn any_addr() -> i64 { 0 }\n\npub enum IpAddr {\n    V4(u8, u8, u8, u8),\n    V6(u16, u16, u16, u16, u16, u16, u16, u16),\n}\n\npub struct SocketAddr {\n    ip: IpAddr,\n    port: u16,\n    scope_id: u32,\n}\n\n@resource(dispose)\npub opaque struct TcpListener { fd: i32 }\nimpl Sendable for TcpListener {}\n@resource(dispose)\npub opaque struct TcpStream { fd: i32 }\nimpl Sendable for TcpStream {}\n@resource(dispose)\npub opaque struct StreamSet { fds: []i32 }\n@resource(dispose)\npub opaque struct UdpSocket { fd: i32 }\nimpl Sendable for UdpSocket {}\n\n@resource(dispose)\npub opaque struct Waker { state: ptr }\nimpl Sendable for Waker {}\n\n@resource(dispose)\npub struct PollSet {\n    fds: []i32,\n    events: []i32,\n    revents: []i32,\n    scratch: []u8,\n    waker_state: ptr,\n    waker_fired: bool,\n}\n\nfn zero_addr() -> SocketAddr {\n    SocketAddr { ip: IpAddr.V4(0, 0, 0, 0), port: 0, scope_id: 0 }\n}\n\nfn addr_family(ip: IpAddr) -> i32 {\n    match ip {\n        .V4(_, _, _, _) => 2,\n        .V6(_, _, _, _, _, _, _, _) => if target_is(\"macos\") { 30 } else { 10 },\n    }\n}\n\nfn parse_ipv4_octets(input: string, out: &mut [u8; 4]) -> bool {\n    parts := text.split(input, \".\")\n    if parts.len != 4 { return false }\n    for idx in 0..4 {\n        p := &parts[idx]\n        if p.len == 0 || p.len > 3 { return false }\n        if p.len > 1 && p[0] == 48 { return false }\n        mut val := 0\n        for b in p.bytes() {\n            if b < 48 || b > 57 { return false }\n            val = val * 10 + (i32(b) - 48)\n        }\n        if val > 255 { return false }\n        out[idx] = u8(val)\n    }\n    true\n}\n\nfn parse_hex_group(seg: &string, out: &mut u16) -> bool {\n    if seg.len == 0 || seg.len > 4 { return false }\n    mut val := 0\n    for b in seg.bytes() {\n        mut d := -1\n        if b >= 48 && b <= 57 { d = i32(b) - 48 }\n        else if b >= 97 && b <= 102 { d = i32(b) - 87 }\n        else if b >= 65 && b <= 70 { d = i32(b) - 55 }\n        else { return false }\n        val = val * 16 + d\n    }\n    out = u16(val)\n    true\n}\n\nfn parse_ipv6_half(part: string, allow_v4: bool, groups: &mut []u16) -> bool {\n    if part.len == 0 { return true }\n    segs := text.split(part, \":\")\n    for i in 0..segs.len {\n        seg := &segs[i]\n        if seg.len == 0 { return false }\n        if allow_v4 && i == segs.len - 1 && text.contains(seg, \".\") {\n            mut v4: [u8; 4] = [0; 4]\n            if !parse_ipv4_octets(seg.clone(), &mut v4) { return false }\n            groups.push(u16(i32(v4[0]).shl(8).bit_or(i32(v4[1]))))\n            groups.push(u16(i32(v4[2]).shl(8).bit_or(i32(v4[3]))))\n        } else {\n            mut g: u16 = 0\n            if !parse_hex_group(&seg, &mut g) { return false }\n            groups.push(g)\n        }\n    }\n    true\n}\n\nfn parse_ipv6(input: string) -> Result<IpAddr, string> {\n    if input.len < 2 || input.len > 45 { return .Err(\"invalid IPv6 address\") }\n    dc := match text.find(input, \"::\") {\n        .Some(pos) => pos,\n        .None => {\n            mut groups: []u16 = []\n            if !parse_ipv6_half(input, true, &mut groups) || groups.len != 8 {\n                return .Err(\"invalid IPv6 address\")\n            }\n            return .Ok(IpAddr.V6(groups[0], groups[1], groups[2], groups[3], groups[4], groups[5], groups[6], groups[7]))\n        },\n    }\n    if dc + 2 < input.len && input[dc + 2] == 58 { return .Err(\"invalid IPv6 address\") }\n    rest := input[(dc + 2)..input.len]\n    if text.contains(rest, \"::\") { return .Err(\"invalid IPv6 address\") }\n    head_str := input[0..dc]\n    mut head: []u16 = []\n    if !parse_ipv6_half(head_str, false, &mut head) { return .Err(\"invalid IPv6 address\") }\n    mut tail: []u16 = []\n    if !parse_ipv6_half(rest, true, &mut tail) { return .Err(\"invalid IPv6 address\") }\n    if head.len + tail.len >= 8 { return .Err(\"invalid IPv6 address\") }\n    mut full: [u16; 8] = [0; 8]\n    for i in 0..head.len { full[i] = head[i] }\n    tail_off := 8 - tail.len\n    for i in 0..tail.len { full[tail_off + i] = tail[i] }\n    .Ok(IpAddr.V6(full[0], full[1], full[2], full[3], full[4], full[5], full[6], full[7]))\n}\n\nfn append_hex_u16(out: &mut []u8, value: u16) {\n    hex := \"0123456789abcdef\"\n    v := i32(value)\n    if v == 0 {\n        out.push(b'0')\n        return\n    }\n    mut started := false\n    for shift in [12, 8, 4, 0] {\n        nib := v.shr(shift).bit_and(15)\n        if nib != 0 || started {\n            started = true\n            out.push(u8(hex[nib]))\n        }\n    }\n}\n\nfn format_ipv6(g: &[]u16) -> string {\n    mut best_start := -1\n    mut best_len := 0\n    mut cur_start := -1\n    mut cur_len := 0\n    for i in 0..8 {\n        if g[i] == 0 {\n            if cur_start < 0 { cur_start = i; cur_len = 1 }\n            else { cur_len += 1 }\n            if cur_len > best_len { best_start = cur_start; best_len = cur_len }\n        } else {\n            cur_start = -1\n            cur_len = 0\n        }\n    }\n    mut out: []u8 = []\n    if best_len >= 2 {\n        for i in 0..best_start {\n            if i > 0 { out.push(b':') }\n            append_hex_u16(&mut out, g[i])\n        }\n        bytes.append_utf8(&mut out, \"::\")\n        after := best_start + best_len\n        for i in after..8 {\n            if i > after { out.push(b':') }\n            append_hex_u16(&mut out, g[i])\n        }\n    } else {\n        for i in 0..8 {\n            if i > 0 { out.push(b':') }\n            append_hex_u16(&mut out, g[i])\n        }\n    }\n    bytes.decode(&out).unwrap_or_default()\n}\n\nfn parse_u16_port(input: string, out: &mut u16) -> bool {\n    if input.len == 0 || input.len > 5 { return false }\n    if input.len > 1 && input[0] == 48 { return false }\n    mut val := 0\n    for b in input.bytes() {\n        if b < 48 || b > 57 { return false }\n        val = val * 10 + (i32(b) - 48)\n    }\n    if val > 65535 { return false }\n    out = u16(val)\n    true\n}\n\nfn parse_u32_decimal(input: string, out: &mut u32) -> bool {\n    if input.len == 0 || input.len > 10 { return false }\n    if input.len > 1 && input[0] == 48 { return false }\n    mut val: i64 = 0\n    for b in input.bytes() {\n        if b < 48 || b > 57 { return false }\n        val = val * 10 + i64(b - 48)\n        if val > 4294967295 { return false }\n    }\n    out = u32(val)\n    true\n}\n\nimpl IpAddr {\n    pub fn v4(a: u8, b: u8, c: u8, d: u8) -> Self { .V4(a, b, c, d) }\n\n    pub fn v4_from_i64(raw: i64) -> Self {\n        .V4(\n            u8(raw.shr(24).bit_and(255)),\n            u8(raw.shr(16).bit_and(255)),\n            u8(raw.shr(8).bit_and(255)),\n            u8(raw.bit_and(255))\n        )\n    }\n\n    pub fn v6(s0: u16, s1: u16, s2: u16, s3: u16, s4: u16, s5: u16, s6: u16, s7: u16) -> Self {\n        .V6(s0, s1, s2, s3, s4, s5, s6, s7)\n    }\n\n    pub fn v6_bytes(raw: &[]u8) -> Result<Self, string> {\n        if raw.len != 16 { return .Err(\"IPv6 address requires 16 bytes\") }\n        .Ok(.V6(\n            u16(i32(raw[0]).shl(8).bit_or(i32(raw[1]))),\n            u16(i32(raw[2]).shl(8).bit_or(i32(raw[3]))),\n            u16(i32(raw[4]).shl(8).bit_or(i32(raw[5]))),\n            u16(i32(raw[6]).shl(8).bit_or(i32(raw[7]))),\n            u16(i32(raw[8]).shl(8).bit_or(i32(raw[9]))),\n            u16(i32(raw[10]).shl(8).bit_or(i32(raw[11]))),\n            u16(i32(raw[12]).shl(8).bit_or(i32(raw[13]))),\n            u16(i32(raw[14]).shl(8).bit_or(i32(raw[15])))\n        ))\n    }\n\n    pub fn localhost_v4() -> Self { .V4(127, 0, 0, 1) }\n    pub fn unspecified_v4() -> Self { .V4(0, 0, 0, 0) }\n    pub fn localhost_v6() -> Self { .V6(0, 0, 0, 0, 0, 0, 0, 1) }\n    pub fn unspecified_v6() -> Self { .V6(0, 0, 0, 0, 0, 0, 0, 0) }\n\n    pub fn is_v4(&self) -> bool {\n        match self {\n            .V4(_, _, _, _) => true,\n            .V6(_, _, _, _, _, _, _, _) => false,\n        }\n    }\n\n    pub fn is_v6(&self) -> bool { !self.is_v4() }\n\n    pub fn is_loopback(&self) -> bool {\n        match self {\n            .V4(a, _, _, _) => a == 127,\n            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {\n                s0 == 0 && s1 == 0 && s2 == 0 && s3 == 0 && s4 == 0 && s5 == 0 && s6 == 0 && s7 == 1\n            },\n        }\n    }\n\n    pub fn is_unspecified(&self) -> bool {\n        match self {\n            .V4(a, b, c, d) => a == 0 && b == 0 && c == 0 && d == 0,\n            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {\n                s0 == 0 && s1 == 0 && s2 == 0 && s3 == 0 && s4 == 0 && s5 == 0 && s6 == 0 && s7 == 0\n            },\n        }\n    }\n\n    pub fn to_v4_i64(&self) -> Result<i64, string> {\n        match self {\n            .V4(a, b, c, d) => .Ok(ipv4(i32(a), i32(b), i32(c), i32(d))),\n            .V6(_, _, _, _, _, _, _, _) => .Err(\"cannot convert IPv6 address to IPv4 integer\"),\n        }\n    }\n\n    pub fn parse(input: string) -> Result<Self, string> {\n        if input.len == 0 { return .Err(\"empty IP address\") }\n        if text.contains(input, \":\") { return parse_ipv6(input) }\n        mut v4: [u8; 4] = [0; 4]\n        if !parse_ipv4_octets(input, &mut v4) { return .Err(\"invalid IPv4 address\") }\n        .Ok(.V4(v4[0], v4[1], v4[2], v4[3]))\n    }\n}\n\nimpl Eq for IpAddr {\n    fn eq(&self, other: &Self) -> bool {\n        match self {\n            .V4(a0, a1, a2, a3) => match other {\n                .V4(b0, b1, b2, b3) => a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3,\n                .V6(_, _, _, _, _, _, _, _) => false,\n            },\n            .V6(a0, a1, a2, a3, a4, a5, a6, a7) => match other {\n                .V4(_, _, _, _) => false,\n                .V6(b0, b1, b2, b3, b4, b5, b6, b7) => {\n                    a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3 &&\n                    a4 == b4 && a5 == b5 && a6 == b6 && a7 == b7\n                },\n            },\n        }\n    }\n}\n\nimpl Hash for IpAddr {\n    fn hash(&self) -> u64 {\n        match self {\n            .V4(a, b, c, d) => {\n                v := u64(a).shl(24).bit_or(u64(b).shl(16)).bit_or(u64(c).shl(8)).bit_or(u64(d))\n                v.hash().bit_xor(u64(11400714819323198485))\n            },\n            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {\n                mut h := u64(14695981039346656037)\n                for seg in [s0, s1, s2, s3, s4, s5, s6, s7] {\n                    h = h.bit_xor(seg.hash()).wrapping_mul(1099511628211)\n                }\n                h.hash()\n            },\n        }\n    }\n}\n\nimpl Display for IpAddr {\n    fn str(&self) -> string {\n        match self {\n            .V4(a, b, c, d) => f\"{a}.{b}.{c}.{d}\",\n            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => format_ipv6(&[s0, s1, s2, s3, s4, s5, s6, s7]),\n        }\n    }\n}\n\nimpl SocketAddr {\n    pub fn new(ip: IpAddr, port: u16) -> Self { Self { ip: ip, port: port, scope_id: 0 } }\n\n    pub fn new_v6(ip: IpAddr, port: u16, scope_id: u32) -> Self {\n        Self { ip: ip, port: port, scope_id: if ip.is_v6() { scope_id } else { 0 } }\n    }\n\n    pub fn v4(a: u8, b: u8, c: u8, d: u8, port: u16) -> Self {\n        Self { ip: IpAddr.V4(a, b, c, d), port: port, scope_id: 0 }\n    }\n\n    pub fn v6(s0: u16, s1: u16, s2: u16, s3: u16, s4: u16, s5: u16, s6: u16, s7: u16, port: u16) -> Self {\n        Self { ip: IpAddr.V6(s0, s1, s2, s3, s4, s5, s6, s7), port: port, scope_id: 0 }\n    }\n\n    pub fn loopback_v4(port: u16) -> Self { Self { ip: IpAddr::localhost_v4(), port: port, scope_id: 0 } }\n    pub fn loopback_v6(port: u16) -> Self { Self { ip: IpAddr::localhost_v6(), port: port, scope_id: 0 } }\n    pub fn any_v4(port: u16) -> Self { Self { ip: IpAddr::unspecified_v4(), port: port, scope_id: 0 } }\n    pub fn any_v6(port: u16) -> Self { Self { ip: IpAddr::unspecified_v6(), port: port, scope_id: 0 } }\n    pub fn is_v4(&self) -> bool { self.ip.is_v4() }\n    pub fn is_v6(&self) -> bool { self.ip.is_v6() }\n\n    pub fn parse(input: string) -> Result<Self, string> {\n        if input.len < 3 { return .Err(\"invalid socket address\") }\n        if input[0] == 91 {\n            close := match text.find(input, \"]\") {\n                .Some(pos) => pos,\n                .None => { return .Err(\"invalid IPv6 socket address\") },\n            }\n            if close < 2 || close + 2 >= input.len || input[close + 1] != 58 {\n                return .Err(\"invalid IPv6 socket address\")\n            }\n            inner := input[1..close]\n            port_str := input[(close + 2)..input.len]\n            mut port: u16 = 0\n            if !parse_u16_port(port_str, &mut port) { return .Err(\"invalid socket port\") }\n            mut ip_part := \"\"\n            mut scope_id: u32 = 0\n            match text.find(inner, \"%\") {\n                .Some(pct) => {\n                    ip_part = inner[0..pct]\n                    scope_part := inner[(pct + 1)..inner.len]\n                    if !parse_u32_decimal(scope_part, &mut scope_id) {\n                        return .Err(\"invalid IPv6 scope id\")\n                    }\n                },\n                .None => {\n                    ip_part = move inner\n                },\n            }\n            match IpAddr::parse(ip_part) {\n                .Ok(ip) => {\n                    if !ip.is_v6() { return .Err(\"bracketed socket address requires IPv6\") }\n                    return .Ok(SocketAddr { ip: ip, port: port, scope_id: scope_id })\n                },\n                .Err(err) => { return .Err(err) },\n            }\n        }\n        colon := match text.find(input, \":\") {\n            .Some(pos) => pos,\n            .None => { return .Err(\"invalid socket address\") },\n        }\n        if colon <= 0 || colon + 1 >= input.len { return .Err(\"invalid socket address\") }\n        ip_part := input[0..colon]\n        port_part := input[(colon + 1)..input.len]\n        if text.contains(port_part, \":\") { return .Err(\"IPv6 socket address requires brackets\") }\n        mut port: u16 = 0\n        if !parse_u16_port(port_part, &mut port) { return .Err(\"invalid socket port\") }\n        match IpAddr::parse(ip_part) {\n            .Ok(ip) => {\n                if !ip.is_v4() { return .Err(\"invalid IPv4 socket address\") }\n                .Ok(SocketAddr { ip: ip, port: port, scope_id: 0 })\n            },\n            .Err(err) => .Err(err),\n        }\n    }\n}\n\nimpl Eq for SocketAddr {\n    fn eq(&self, other: &Self) -> bool {\n        self.ip == other.ip && self.port == other.port && self.scope_id == other.scope_id\n    }\n}\n\nimpl Hash for SocketAddr {\n    fn hash(&self) -> u64 {\n        mut h := self.ip.hash()\n        h = h.bit_xor(self.port.hash().wrapping_mul(11400714819323198485))\n        h.bit_xor(self.scope_id.hash().wrapping_mul(14029467366897019727))\n    }\n}\n\nimpl Display for SocketAddr {\n    fn str(&self) -> string {\n        match self.ip {\n            .V4(_, _, _, _) => f\"{self.ip}:{self.port}\",\n            .V6(_, _, _, _, _, _, _, _) => {\n                if self.scope_id != 0 {\n                    f\"[{self.ip}%{self.scope_id}]:{self.port}\"\n                } else {\n                    f\"[{self.ip}]:{self.port}\"\n                }\n            },\n        }\n    }\n}\n\nfn portable_errno(raw: i32, is_darwin: bool) -> i32 {\n    if raw <= 0 { return 5 }\n    if is_darwin { return raw }\n    if raw == 1 || raw == 2 || raw == 4 || raw == 5 || raw == 9 || raw == 12 ||\n       raw == 13 || raw == 17 || raw == 20 || raw == 21 || raw == 22 ||\n       raw == 23 || raw == 24 || raw == 27 || raw == 28 || raw == 30 || raw == 32 { return raw }\n    if raw == 11 { return 35 }\n    if raw == 36 { return 63 }\n    if raw == 39 { return 66 }\n    if raw == 84 { return 92 }\n    if raw == 90 { return 40 }\n    if raw == 95 { return 45 }\n    if raw == 97 { return 47 }\n    if raw == 98 { return 48 }\n    if raw == 99 { return 49 }\n    if raw == 101 { return 51 }\n    if raw == 103 { return 53 }\n    if raw == 104 { return 54 }\n    if raw == 107 { return 57 }\n    if raw == 110 { return 60 }\n    if raw == 111 { return 61 }\n    if raw == 113 { return 65 }\n    if raw == 115 { return 36 }\n    10000 + raw\n}\n\n@thread_safe\nunsafe fn macos_errno() -> i32 {\n    if target_is(\"macos\") { return portable_errno(load_i32(c_errno_ptr()), true) }\n    45\n}\n\nfn encode_sockaddr(endpoint: SocketAddr, buf: &mut [u8; 32]) -> u32 {\n    for i in 0..32 { buf[i] = 0 }\n    p := i32(endpoint.port)\n    buf[2] = u8(p.shr(8).bit_and(255))\n    buf[3] = u8(p.bit_and(255))\n    match endpoint.ip {\n        .V4(a, b, c, d) => {\n            if target_is(\"macos\") {\n                buf[0] = 16\n                buf[1] = 2\n            } else {\n                buf[0] = 2\n                buf[1] = 0\n            }\n            buf[4] = a\n            buf[5] = b\n            buf[6] = c\n            buf[7] = d\n            u32(16)\n        },\n        .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {\n            if target_is(\"macos\") {\n                buf[0] = 28\n                buf[1] = 30\n            } else {\n                buf[0] = 10\n                buf[1] = 0\n            }\n            segs: [u16; 8] = [s0, s1, s2, s3, s4, s5, s6, s7]\n            for i in 0..8 {\n                v := i32(segs[i])\n                buf[8 + i * 2] = u8(v.shr(8).bit_and(255))\n                buf[9 + i * 2] = u8(v.bit_and(255))\n            }\n            sc := i64(endpoint.scope_id)\n            buf[24] = u8(sc.bit_and(255))\n            buf[25] = u8(sc.shr(8).bit_and(255))\n            buf[26] = u8(sc.shr(16).bit_and(255))\n            buf[27] = u8(sc.shr(24).bit_and(255))\n            u32(28)\n        },\n    }\n}\n\n@thread_safe\nunsafe fn decode_sockaddr_ptr(sa: ptr, sa_len: u32) -> Result<SocketAddr, sys.IoError> {\n    if usize(sa) == 0 || sa_len < 8 {\n        return .Err(.InvalidArgument)\n    }\n    family := if target_is(\"macos\") {\n        i32(load_u8(ptr(usize(sa) + 1)))\n    } else {\n        i32(load_u8(sa)).bit_or(i32(load_u8(ptr(usize(sa) + 1))).shl(8))\n    }\n    port := u16(i32(load_u8(ptr(usize(sa) + 2))).shl(8).bit_or(i32(load_u8(ptr(usize(sa) + 3)))))\n    if family == 2 {\n        ip := IpAddr.V4(\n            load_u8(ptr(usize(sa) + 4)),\n            load_u8(ptr(usize(sa) + 5)),\n            load_u8(ptr(usize(sa) + 6)),\n            load_u8(ptr(usize(sa) + 7))\n        )\n        return .Ok(SocketAddr { ip: ip, port: port, scope_id: 0 })\n    }\n    v6_family := if target_is(\"macos\") { 30 } else { 10 }\n    if family == v6_family && sa_len >= 28 {\n        mut segs: [u16; 8] = [0; 8]\n        for i in 0..8 {\n            hi := i32(load_u8(ptr(usize(sa) + usize(8 + i * 2))))\n            lo := i32(load_u8(ptr(usize(sa) + usize(9 + i * 2))))\n            segs[i] = u16(hi.shl(8).bit_or(lo))\n        }\n        mut sc: i64 = 0\n        for i in 0..4 {\n            sc = sc.bit_or(i64(load_u8(ptr(usize(sa) + usize(24 + i)))).shl(i * 8))\n        }\n        ip := IpAddr.V6(segs[0], segs[1], segs[2], segs[3], segs[4], segs[5], segs[6], segs[7])\n        return .Ok(SocketAddr { ip: ip, port: port, scope_id: u32(sc) })\n    }\n    .Err(sys.IoError::from_code(47))\n}\n\n@thread_safe\nunsafe fn os_socket(domain: i32, kind: i32, protocol: i32) -> i32 {\n    if target_is(\"macos\") {\n        fd := c_socket(domain, kind, protocol)\n        if fd < 0 { return -macos_errno() }\n        _ := c_ioctl(fd, 536897025)\n        mut one: [u8; 4] = [1, 0, 0, 0]\n        _ := c_setsockopt(fd, 65535, 4130, addr(&one[0]), 4)\n        return fd\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(198, i64(domain), i64(kind), i64(protocol), 0, 0, 0)\n        if r < 0 { return -portable_errno(i32(-r), false) }\n        fd := i32(r)\n        _ := sys.linux_syscall(25, i64(fd), 2, 1, 0, 0, 0)\n        return fd\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_setsockopt_reuseaddr(fd: i32, enabled: i32) -> i64 {\n    mut val: [u8; 4] = [0, 0, 0, 0]\n    if enabled != 0 { val[0] = 1 }\n    if target_is(\"macos\") {\n        if c_setsockopt(fd, 65535, 4, addr(&val[0]), 4) < 0 { return i64(-macos_errno()) }\n        return 0\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(208, i64(fd), 1, 2, i64(usize(addr(&val[0]))), 4, 0)\n        if r < 0 { return i64(-portable_errno(i32(-r), false)) }\n        return 0\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_setsockopt_timeout(fd: i32, read_dir: bool, timeout_ms: i64) -> i64 {\n    secs := timeout_ms / 1000\n    usecs := (timeout_ms % 1000) * 1000\n    mut tv: [u8; 16] = [0; 16]\n    for i in 0..8 { tv[i] = u8(secs.shr(i * 8).bit_and(255)) }\n    if target_is(\"macos\") {\n        u32_usecs := i32(usecs)\n        for i in 0..4 { tv[8 + i] = u8(u32_usecs.shr(i * 8).bit_and(255)) }\n        opt := if read_dir { 4102 } else { 4101 }\n        if c_setsockopt(fd, 65535, opt, addr(&tv[0]), 16) < 0 { return i64(-macos_errno()) }\n        return 0\n    } else if target_is(\"linux\") {\n        for i in 0..8 { tv[8 + i] = u8(usecs.shr(i * 8).bit_and(255)) }\n        opt := if read_dir { 20 } else { 21 }\n        r := sys.linux_syscall(208, i64(fd), 1, i64(opt), i64(usize(addr(&tv[0]))), 16, 0)\n        if r < 0 { return i64(-portable_errno(i32(-r), false)) }\n        return 0\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_getsockopt_error(fd: i32) -> i32 {\n    mut err_buf: [u8; 4] = [0; 4]\n    mut len_buf: [u8; 4] = [4, 0, 0, 0]\n    if target_is(\"macos\") {\n        if c_getsockopt(fd, 65535, 4103, addr(&mut err_buf[0]), addr(&mut len_buf[0])) < 0 {\n            return macos_errno()\n        }\n        raw := load_i32(addr(&err_buf[0]))\n        if raw == 0 { return 0 }\n        return portable_errno(raw, true)\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(209, i64(fd), 1, 4, i64(usize(addr(&mut err_buf[0]))), i64(usize(addr(&mut len_buf[0]))), 0)\n        if r < 0 { return portable_errno(i32(-r), false) }\n        raw := load_i32(addr(&err_buf[0]))\n        if raw == 0 { return 0 }\n        return portable_errno(raw, false)\n    }\n    45\n}\n\n@thread_safe\nunsafe fn os_bind(fd: i32, sa: ptr, sa_len: u32) -> i64 {\n    if target_is(\"macos\") {\n        if c_bind(fd, sa, sa_len) < 0 { return i64(-macos_errno()) }\n        return 0\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(200, i64(fd), i64(usize(sa)), i64(sa_len), 0, 0, 0)\n        if r < 0 { return i64(-portable_errno(i32(-r), false)) }\n        return 0\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_listen(fd: i32, backlog: i32) -> i64 {\n    if target_is(\"macos\") {\n        if c_listen(fd, backlog) < 0 { return i64(-macos_errno()) }\n        return 0\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(201, i64(fd), i64(backlog), 0, 0, 0, 0)\n        if r < 0 { return i64(-portable_errno(i32(-r), false)) }\n        return 0\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_connect(fd: i32, sa: ptr, sa_len: u32) -> i64 {\n    if target_is(\"macos\") {\n        while true {\n            if c_connect(fd, sa, sa_len) == 0 { return 0 }\n            err := macos_errno()\n            if err == 4 { continue }\n            return i64(-err)\n        }\n        return -5\n    } else if target_is(\"linux\") {\n        while true {\n            r := sys.linux_syscall(203, i64(fd), i64(usize(sa)), i64(sa_len), 0, 0, 0)\n            if r == 0 { return 0 }\n            err := portable_errno(i32(-r), false)\n            if err == 4 { continue }\n            return i64(-err)\n        }\n        return -5\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_connect_nonblocking(fd: i32, sa: ptr, sa_len: u32) -> i64 {\n    if target_is(\"macos\") {\n        if c_connect(fd, sa, sa_len) == 0 { return 0 }\n        err := macos_errno()\n        if err == 4 { return -36 }\n        return i64(-err)\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(203, i64(fd), i64(usize(sa)), i64(sa_len), 0, 0, 0)\n        if r == 0 { return 0 }\n        err := portable_errno(i32(-r), false)\n        if err == 4 { return -36 }\n        return i64(-err)\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_getsockname(fd: i32, sa: ptr, sa_len_ptr: ptr) -> i64 {\n    if target_is(\"macos\") {\n        if c_getsockname(fd, sa, sa_len_ptr) < 0 { return i64(-macos_errno()) }\n        return 0\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(204, i64(fd), i64(usize(sa)), i64(usize(sa_len_ptr)), 0, 0, 0)\n        if r < 0 { return i64(-portable_errno(i32(-r), false)) }\n        return 0\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_getpeername(fd: i32, sa: ptr, sa_len_ptr: ptr) -> i64 {\n    if target_is(\"macos\") {\n        if c_getpeername(fd, sa, sa_len_ptr) < 0 { return i64(-macos_errno()) }\n        return 0\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(205, i64(fd), i64(usize(sa)), i64(usize(sa_len_ptr)), 0, 0, 0)\n        if r < 0 { return i64(-portable_errno(i32(-r), false)) }\n        return 0\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_sendto(fd: i32, buf: ptr, length: usize, sa: ptr, sa_len: u32) -> i64 {\n    if target_is(\"macos\") {\n        while true {\n            n := c_sendto(fd, buf, length, 0, sa, sa_len)\n            if n >= 0 { return n }\n            err := macos_errno()\n            if err == 4 { continue }\n            return i64(-err)\n        }\n        return -5\n    } else if target_is(\"linux\") {\n        while true {\n            r := sys.linux_syscall(206, i64(fd), i64(usize(buf)), i64(length), 16384, i64(usize(sa)), i64(sa_len))\n            if r >= 0 { return r }\n            err := portable_errno(i32(-r), false)\n            if err == 4 { continue }\n            return i64(-err)\n        }\n        return -5\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_recvfrom(fd: i32, buf: ptr, length: usize, flags: i32, sa: ptr, sa_len_ptr: ptr) -> i64 {\n    if target_is(\"macos\") {\n        while true {\n            n := c_recvfrom(fd, buf, length, flags, sa, sa_len_ptr)\n            if n >= 0 { return n }\n            err := macos_errno()\n            if err == 4 { continue }\n            return i64(-err)\n        }\n        return -5\n    } else if target_is(\"linux\") {\n        while true {\n            r := sys.linux_syscall(207, i64(fd), i64(usize(buf)), i64(length), i64(flags), i64(usize(sa)), i64(usize(sa_len_ptr)))\n            if r >= 0 { return r }\n            err := portable_errno(i32(-r), false)\n            if err == 4 { continue }\n            return i64(-err)\n        }\n        return -5\n    }\n    -45\n}\n\n@thread_safe\nunsafe fn os_shutdown(fd: i32, how: i32) -> i64 {\n    if target_is(\"macos\") {\n        if c_shutdown(fd, how) < 0 { return i64(-macos_errno()) }\n        return 0\n    } else if target_is(\"linux\") {\n        r := sys.linux_syscall(210, i64(fd), i64(how), 0, 0, 0, 0)\n        if r < 0 { return i64(-portable_errno(i32(-r), false)) }\n        return 0\n    }\n    -45\n}\n\nfn status_from_i64(raw: i64) -> sys.Status {\n    if raw < 0 { return sys.Status { ok: false, error: i32(-raw) } }\n    sys.Status { ok: true, error: 0 }\n}\n\n@thread_safe\nfn fd_local_addr(fd: i32) -> Result<SocketAddr, sys.IoError> {\n    if fd < 0 { return .Err(.BadDescriptor) }\n    mut sa: [u8; 128] = [0; 128]\n    mut len_buf: [u8; 4] = [128, 0, 0, 0]\n    unsafe {\n        rc := os_getsockname(fd, addr(&mut sa[0]), addr(&mut len_buf[0]))\n        if rc < 0 { return .Err(sys.IoError::from_code(i32(-rc))) }\n        return decode_sockaddr_ptr(addr(&sa[0]), load_u32(addr(&len_buf[0])))\n    }\n    .Err(.Unsupported)\n}\n\n@thread_safe\nfn fd_peer_addr(fd: i32) -> Result<SocketAddr, sys.IoError> {\n    if fd < 0 { return .Err(.BadDescriptor) }\n    mut sa: [u8; 128] = [0; 128]\n    mut len_buf: [u8; 4] = [128, 0, 0, 0]\n    unsafe {\n        rc := os_getpeername(fd, addr(&mut sa[0]), addr(&mut len_buf[0]))\n        if rc < 0 { return .Err(sys.IoError::from_code(i32(-rc))) }\n        return decode_sockaddr_ptr(addr(&sa[0]), load_u32(addr(&len_buf[0])))\n    }\n    .Err(.Unsupported)\n}\n\n@thread_safe\nfn fd_set_timeout(fd: i32, read_dir: bool, timeout_ms: i64) -> sys.Status {\n    if fd < 0 { return sys.Status { ok: false, error: 9 } }\n    if timeout_ms < 0 { return sys.Status { ok: false, error: 22 } }\n    mut rc: i64 = 0\n    unsafe { rc = os_setsockopt_timeout(fd, read_dir, timeout_ms) }\n    status_from_i64(rc)\n}\n\nfn fd_read_append(fd: i32, out: &mut []u8, max_bytes: i32, peek: bool) -> Result<i64, sys.IoError> {\n    if max_bytes <= 0 { return .Ok(0) }\n    out.reserve(out.len + max_bytes)\n    n := if peek { sys.net_peek(fd, &mut out, i64(max_bytes)) } else { sys.net_read(fd, &mut out, i64(max_bytes)) }\n    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n    .Ok(n)\n}\n\nfn fd_write_range(fd: i32, data: &[]u8, offset: i32, length: i32) -> Result<i64, sys.IoError> {\n    n := sys.net_write(fd, &data, i64(offset), i64(length))\n    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n    .Ok(n)\n}\n\n@thread_safe\nunsafe fn copy_c_str(value: ptr) -> string {\n    if usize(value) == 0 { return \"DNS resolution error\" }\n    mut raw: []u8 = []\n    for i in 0..512 {\n        b := load_u8(ptr(usize(value) + usize(i)))\n        if b == 0 { break }\n        raw.push(b)\n    }\n    bytes.decode(&raw).unwrap_or(\"DNS resolution error\")\n}\n\nimpl TcpListener {\n    @requires(network)\n    pub fn listen(addr: i64, port: i32, backlog: i32) -> Result<Self, sys.IoError> {\n        raw := sys.net_listen(addr, i64(port), i64(backlog))\n        if raw < 0 { return .Err(sys.IoError::from_code(i32(-raw))) }\n        .Ok(Self { fd: i32(raw) })\n    }\n\n    @requires(network)\n    @thread_safe\n    pub fn listen_addr(endpoint: SocketAddr, backlog: i32) -> Result<Self, sys.IoError> {\n        domain := addr_family(endpoint.ip)\n        mut fd := -45\n        unsafe { fd = os_socket(domain, 1, 0) }\n        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }\n        mut listener := Self { fd: fd }\n        mut sa: [u8; 32] = [0; 32]\n        sa_len := encode_sockaddr(endpoint, &mut sa)\n        mut brc: i64 = 0\n        unsafe {\n            _ := os_setsockopt_reuseaddr(listener.fd, 1)\n            brc = os_bind(listener.fd, addr(&sa[0]), sa_len)\n        }\n        if brc < 0 {\n            _ := listener.close()\n            return .Err(sys.IoError::from_code(i32(-brc)))\n        }\n        mut q := backlog\n        if q <= 0 { q = 128 }\n        mut lrc: i64 = 0\n        unsafe { lrc = os_listen(listener.fd, q) }\n        if lrc < 0 {\n            _ := listener.close()\n            return .Err(sys.IoError::from_code(i32(-lrc)))\n        }\n        .Ok(listener)\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n\n    pub fn local_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_local_addr(self.fd) }\n\n    pub fn local_port(&self) -> i32 {\n        match self.local_addr() {\n            .Ok(a) => i32(a.port),\n            .Err(_) => -1,\n        }\n    }\n\n    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))\n    }\n\n    pub fn accept(&self) -> Result<TcpStream, sys.IoError> {\n        raw := sys.net_accept(self.fd)\n        if raw < 0 { return .Err(sys.IoError::from_code(i32(-raw))) }\n        .Ok(TcpStream { fd: i32(raw) })\n    }\n\n    fn dispose(&self) {\n        if self.fd >= 0 { _ := sys.net_close(self.fd) }\n    }\n\n    pub fn close(&mut self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(self.fd))\n        self.fd = -1\n        st\n    }\n}\n\nimpl TcpStream {\n    @requires(network)\n    pub fn connect(addr: i64, port: i32) -> Result<Self, sys.IoError> {\n        raw := sys.net_connect(addr, i64(port))\n        if raw < 0 { return .Err(sys.IoError::from_code(i32(-raw))) }\n        .Ok(Self { fd: i32(raw) })\n    }\n\n    @requires(network)\n    @thread_safe\n    pub fn connect_addr(endpoint: SocketAddr) -> Result<Self, sys.IoError> {\n        if endpoint.port == 0 { return .Err(.InvalidArgument) }\n        domain := addr_family(endpoint.ip)\n        mut fd := -45\n        unsafe { fd = os_socket(domain, 1, 0) }\n        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }\n        mut stream := Self { fd: fd }\n        mut sa: [u8; 32] = [0; 32]\n        sa_len := encode_sockaddr(endpoint, &mut sa)\n        mut rc: i64 = 0\n        unsafe { rc = os_connect(stream.fd, addr(&sa[0]), sa_len) }\n        if rc < 0 {\n            _ := stream.close()\n            return .Err(sys.IoError::from_code(i32(-rc)))\n        }\n        .Ok(stream)\n    }\n\n    @requires(network)\n    @thread_safe\n    pub fn connect_timeout(endpoint: SocketAddr, timeout_ms: i32) -> Result<Self, sys.IoError> {\n        if timeout_ms < 0 || endpoint.port == 0 { return .Err(.InvalidArgument) }\n        domain := addr_family(endpoint.ip)\n        mut fd := -45\n        unsafe { fd = os_socket(domain, 1, 0) }\n        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }\n        mut stream := Self { fd: fd }\n        nb := stream.set_nonblocking(true)\n        if !nb.ok {\n            _ := stream.close()\n            return .Err(sys.IoError::from_code(nb.error))\n        }\n        mut sa: [u8; 32] = [0; 32]\n        sa_len := encode_sockaddr(endpoint, &mut sa)\n        mut rc: i64 = 0\n        unsafe { rc = os_connect_nonblocking(stream.fd, addr(&sa[0]), sa_len) }\n        if rc == 0 {\n            restored := stream.set_nonblocking(false)\n            if !restored.ok {\n                _ := stream.close()\n                return .Err(sys.IoError::from_code(restored.error))\n            }\n            return .Ok(stream)\n        }\n        if rc != -36 {\n            _ := stream.close()\n            return .Err(sys.IoError::from_code(i32(-rc)))\n        }\n        deadline := sys.now_ms() + i64(timeout_ms)\n        mut ps := PollSet::new()\n        mut first := true\n        while true {\n            mut remaining := deadline - sys.now_ms()\n            if remaining <= 0 {\n                if !first || timeout_ms > 0 {\n                    _ := stream.close()\n                    return .Err(.TimedOut)\n                }\n                remaining = 0\n            }\n            first = false\n            ps.clear()\n            ps.add(stream.fd, poll_out())\n            mut delay := remaining\n            if delay > 2147483647 { delay = 2147483647 }\n            match ps.poll(i32(delay)) {\n                .Err(err) => {\n                    if err == .Interrupted { continue }\n                    _ := stream.close()\n                    return .Err(err)\n                },\n                .Ok(ready) => {\n                    if ready == 0 {\n                        _ := stream.close()\n                        return .Err(.TimedOut)\n                    }\n                },\n            }\n            mut so_err := 0\n            unsafe { so_err = os_getsockopt_error(stream.fd) }\n            if so_err != 0 {\n                _ := stream.close()\n                return .Err(sys.IoError::from_code(so_err))\n            }\n            restored := stream.set_nonblocking(false)\n            if !restored.ok {\n                _ := stream.close()\n                return .Err(sys.IoError::from_code(restored.error))\n            }\n            return .Ok(stream)\n        }\n        _ := stream.close()\n        .Err(.TimedOut)\n    }\n\n    @requires(network)\n    pub fn connect_host(host: string, port: u16, timeout_ms: i32) -> Result<Self, sys.IoError> {\n        if timeout_ms < 0 || port == 0 { return .Err(.InvalidArgument) }\n        addrs := match resolve(host, port) {\n            .Ok(list) => list,\n            .Err(_) => { return .Err(.NotFound) },\n        }\n        if addrs.len == 0 { return .Err(.NotFound) }\n        deadline := sys.now_ms() + i64(timeout_ms)\n        mut last_err := sys.IoError.ConnectionRefused\n        for i in 0..addrs.len {\n            remaining := deadline - sys.now_ms()\n            if i > 0 && remaining <= 0 {\n                last_err = .TimedOut\n                break\n            }\n            mut budget: i64 = remaining\n            if budget < 0 { budget = 0 }\n            if budget > 2147483647 { budget = 2147483647 }\n            match Self::connect_timeout(addrs[i], i32(budget)) {\n                .Ok(s) => { return .Ok(s) },\n                .Err(err) => { last_err = err },\n            }\n        }\n        .Err(last_err)\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n\n    pub fn local_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_local_addr(self.fd) }\n\n    pub fn peer_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_peer_addr(self.fd) }\n\n    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))\n    }\n\n    pub fn set_nodelay(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nodelay(self.fd, enabled))\n    }\n\n    pub fn set_read_timeout(&self, timeout_ms: i64) -> sys.Status {\n        fd_set_timeout(self.fd, true, timeout_ms)\n    }\n\n    pub fn set_write_timeout(&self, timeout_ms: i64) -> sys.Status {\n        fd_set_timeout(self.fd, false, timeout_ms)\n    }\n\n    pub fn read_append(&self, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {\n        fd_read_append(self.fd, &mut out, max_bytes, false)\n    }\n\n    pub fn peek_append(&self, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {\n        fd_read_append(self.fd, &mut out, max_bytes, true)\n    }\n\n    pub fn write_range(&self, data: &[]u8, offset: i32, length: i32) -> Result<i64, sys.IoError> {\n        fd_write_range(self.fd, &data, offset, length)\n    }\n\n    pub fn write_all(&self, data: &[]u8) -> sys.Status {\n        mut off := 0\n        while off < data.len {\n            n := sys.net_write(self.fd, &data, i64(off), i64(data.len - off))\n            if n < 0 { return sys.Status { ok: false, error: i32(-n) } }\n            if n == 0 { return sys.Status { ok: false, error: 5 } }\n            off += i32(n)\n        }\n        sys.Status { ok: true, error: 0 }\n    }\n\n    @thread_safe\n    pub fn shutdown_read(&self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: false, error: 9 } }\n        mut rc: i64 = 0\n        unsafe { rc = os_shutdown(self.fd, 0) }\n        status_from_i64(rc)\n    }\n\n    pub fn shutdown_write(&self) -> sys.Status {\n        status_from_i64(sys.net_shutdown_write(self.fd))\n    }\n\n    @thread_safe\n    pub fn shutdown_both(&self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: false, error: 9 } }\n        mut rc: i64 = 0\n        unsafe { rc = os_shutdown(self.fd, 2) }\n        status_from_i64(rc)\n    }\n\n    fn dispose(&self) {\n        if self.fd >= 0 { _ := sys.net_close(self.fd) }\n    }\n\n    pub fn close(&mut self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(self.fd))\n        self.fd = -1\n        st\n    }\n}\n\nimpl io.Read for TcpStream {\n    @thread_safe\n    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        mut r: Result<i32, sys.IoError> = .Ok(0)\n        unsafe { r = io.fd_read_chunk(self.fd, &mut out, max_bytes) }\n        r\n    }\n}\n\nimpl io.Write for TcpStream {\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        if data.len == 0 { return .Ok(0) }\n        n := sys.net_write(self.fd, &data, 0, i64(data.len))\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        .Ok(i32(n))\n    }\n\n    fn flush(&mut self) -> Result<(), sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        .Ok\n    }\n}\n\n@thread_safe\nunsafe fn waker_block_bytes() -> usize {\n    if target_is(\"macos\") { return usize(16384) }\n    if target_is(\"linux\") { return usize(4096) }\n    usize(64)\n}\n\n@thread_safe\nunsafe fn waker_mmap(length: usize) -> ptr {\n    if target_is(\"macos\") {\n        raw := net_c_mmap(ptr(0), length, 3, 4098, -1, 0)\n        failed := usize(0).wrapping_sub(usize(1))\n        if usize(raw) == usize(0) || usize(raw) == failed { return ptr(0) }\n        return raw\n    }\n    if target_is(\"linux\") {\n        r := sys.linux_syscall(222, 0, i64(length), 3, 34, -1, 0)\n        if r <= 0 { return ptr(0) }\n        return ptr(usize(r))\n    }\n    sys.pool_alloc_try(length)\n}\n\n@thread_safe\nunsafe fn waker_munmap(raw: ptr, length: usize) {\n    if usize(raw) == usize(0) { return }\n    if target_is(\"macos\") {\n        _ := net_c_munmap(raw, length)\n    } else if target_is(\"linux\") {\n        _ := sys.linux_syscall(215, i64(usize(raw)), i64(length), 0, 0, 0, 0)\n    } else {\n        sys.pool_free(raw)\n    }\n}\n\n@thread_safe\npub unsafe fn waker_retain_raw(state: ptr) {\n    if usize(state) == usize(0) { return }\n    _ := sys.atomic_fetch_add_i64(state, 1)\n}\n\n@thread_safe\npub unsafe fn waker_wake_raw(state: ptr) {\n    if usize(state) == usize(0) { return }\n    pend := ptr(usize(state) + usize(8))\n    if sys.atomic_cas_i64(pend, 0, 1) != 0 { return }\n    rfd := i32(sys.atomic_load_i64(ptr(usize(state) + usize(16))))\n    wfd := i32(sys.atomic_load_i64(ptr(usize(state) + usize(24))))\n    is_efd := sys.atomic_load_i64(ptr(usize(state) + usize(32))) != 0\n    if is_efd && rfd >= 0 {\n        mut val: u64 = 1\n        _ := sys.linux_syscall(64, i64(rfd), i64(usize(addr(&val))), 8, 0, 0, 0)\n    } else if wfd >= 0 {\n        mut b: i64 = 1\n        if target_is(\"macos\") {\n            _ := net_c_write(wfd, addr(&b), usize(1))\n        } else if target_is(\"linux\") {\n            _ := sys.linux_syscall(64, i64(wfd), i64(usize(addr(&b))), 1, 0, 0, 0)\n        }\n    }\n}\n\n@thread_safe\npub unsafe fn waker_drain_raw(state: ptr) {\n    if usize(state) == usize(0) { return }\n    pend := ptr(usize(state) + usize(8))\n    rfd := i32(sys.atomic_load_i64(ptr(usize(state) + usize(16))))\n    is_efd := sys.atomic_load_i64(ptr(usize(state) + usize(32))) != 0\n    while true {\n        sys.atomic_store_i64(pend, 0)\n        if is_efd && rfd >= 0 {\n            mut val: u64 = 0\n            while sys.linux_syscall(63, i64(rfd), i64(usize(addr(&mut val))), 8, 0, 0, 0) > 0 {}\n        } else if rfd >= 0 {\n            mut buf: [u64; 8] = [0; 8]\n            if target_is(\"macos\") {\n                while net_c_read(rfd, addr(&mut buf[0]), usize(64)) > 0 {}\n            } else if target_is(\"linux\") {\n                while sys.linux_syscall(63, i64(rfd), i64(usize(addr(&mut buf[0]))), 64, 0, 0, 0) > 0 {}\n            }\n        }\n        if sys.atomic_load_i64(pend) == 0 { break }\n    }\n}\n\n@thread_safe\npub unsafe fn waker_release_raw(state: ptr) {\n    if usize(state) == usize(0) { return }\n    if sys.atomic_fetch_add_i64(state, -1) != 1 { return }\n    rfd := i32(sys.atomic_load_i64(ptr(usize(state) + usize(16))))\n    wfd := i32(sys.atomic_load_i64(ptr(usize(state) + usize(24))))\n    if rfd >= 0 { _ := sys.fd_close(rfd) }\n    if wfd >= 0 && wfd != rfd { _ := sys.fd_close(wfd) }\n    waker_munmap(state, waker_block_bytes())\n}\n\nimpl Waker {\n    @thread_safe\n    pub fn new() -> Result<Self, sys.IoError> {\n        unsafe {\n            blk := waker_block_bytes()\n            st := waker_mmap(blk)\n            if usize(st) == usize(0) { return .Err(.OutOfMemory) }\n            mut rfd: i32 = -1\n            mut wfd: i32 = -1\n            mut is_efd: i64 = 0\n            if target_is(\"macos\") {\n                mut fds_raw: i64 = 0\n                if net_c_pipe(addr(&mut fds_raw)) != 0 {\n                    err := sys.IoError::from_code(macos_errno())\n                    waker_munmap(st, blk)\n                    return .Err(err)\n                }\n                rfd = load_i32(addr(&fds_raw))\n                wfd = load_i32(ptr(usize(addr(&fds_raw)) + usize(4)))\n                _ := sys.fd_set_nonblocking(rfd, true)\n                _ := sys.fd_set_nonblocking(wfd, true)\n                _ := c_ioctl(rfd, usize(536897025))\n                _ := c_ioctl(wfd, usize(536897025))\n            } else if target_is(\"linux\") {\n                efd := sys.linux_syscall(19, 0, 526336, 0, 0, 0, 0)\n                if efd < 0 {\n                    waker_munmap(st, blk)\n                    return .Err(sys.IoError::from_code(i32(-efd)))\n                }\n                rfd = i32(efd)\n                wfd = -1\n                is_efd = 1\n            }\n            sys.atomic_store_i64(st, 1)\n            sys.atomic_store_i64(ptr(usize(st) + usize(8)), 0)\n            sys.atomic_store_i64(ptr(usize(st) + usize(16)), i64(rfd))\n            sys.atomic_store_i64(ptr(usize(st) + usize(24)), i64(wfd))\n            sys.atomic_store_i64(ptr(usize(st) + usize(32)), is_efd)\n            .Ok(Self { state: st })\n        }\n    }\n\n    @thread_safe\n    pub fn clone_handle(&self) -> Self {\n        unsafe {\n            waker_retain_raw(self.state)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn wake(&self) {\n        unsafe { waker_wake_raw(self.state) }\n    }\n\n    @thread_safe\n    pub fn drain(&self) {\n        unsafe { waker_drain_raw(self.state) }\n    }\n\n    @thread_safe\n    pub fn fd(&self) -> i32 {\n        unsafe {\n            if usize(self.state) == usize(0) { return -1 }\n            return i32(sys.atomic_load_i64(ptr(usize(self.state) + usize(16))))\n        }\n        -1\n    }\n\n    @thread_safe\n    pub unsafe fn raw_state(&self) -> ptr { self.state }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            waker_release_raw(st)\n        }\n    }\n}\n\nimpl PollSet {\n    @thread_safe\n    pub fn new() -> Self {\n        unsafe {\n            return Self { fds: [], events: [], revents: [], scratch: [], waker_state: ptr(0), waker_fired: false }\n        }\n        unsafe { Self { fds: [], events: [], revents: [], scratch: [], waker_state: ptr(0), waker_fired: false } }\n    }\n\n    @thread_safe\n    pub fn waker(&mut self) -> Result<Waker, sys.IoError> {\n        unsafe {\n            if usize(self.waker_state) == usize(0) {\n                w := Waker::new()?\n                st := w.raw_state()\n                waker_retain_raw(st)\n                self.waker_state = st\n                return .Ok(w)\n            }\n            waker_retain_raw(self.waker_state)\n            return .Ok(Waker { state: self.waker_state })\n        }\n        .Err(.Unsupported)\n    }\n\n    @thread_safe\n    pub fn woken(&self) -> bool { self.waker_fired }\n\n    @thread_safe\n    pub fn clear(&mut self) {\n        self.fds.clear()\n        self.events.clear()\n        self.revents.clear()\n        self.waker_fired = false\n    }\n\n    @thread_safe\n    pub fn add(&mut self, fd: i32, events: i32) {\n        self.fds.push(fd)\n        self.events.push(events)\n        self.revents.push(0)\n    }\n\n    @thread_safe\n    pub fn poll(&mut self, timeout_ms: i32) -> Result<i32, sys.IoError> {\n        self.waker_fired = false\n        count := self.fds.len\n        assert(self.events.len == count && self.revents.len == count)\n        mut waker_fd: i32 = -1\n        unsafe {\n            if usize(self.waker_state) != usize(0) {\n                waker_fd = i32(sys.atomic_load_i64(ptr(usize(self.waker_state) + usize(16))))\n            }\n        }\n        has_waker := waker_fd >= 0\n        total := if has_waker { count + 1 } else { count }\n        need := total * 8\n        if self.scratch.len < need {\n            self.scratch.reserve(need)\n            while self.scratch.len < need { self.scratch.push(0) }\n        }\n        for i in 0..count {\n            base := i * 8\n            u := i64(self.fds[i]).bit_and(0xffffffff)\n            self.scratch[base] = u8(u.bit_and(0xff))\n            self.scratch[base + 1] = u8(u.shr(8).bit_and(0xff))\n            self.scratch[base + 2] = u8(u.shr(16).bit_and(0xff))\n            self.scratch[base + 3] = u8(u.shr(24).bit_and(0xff))\n            ev := i64(self.events[i]).bit_and(0xffff)\n            self.scratch[base + 4] = u8(ev.bit_and(0xff))\n            self.scratch[base + 5] = u8(ev.shr(8).bit_and(0xff))\n            self.scratch[base + 6] = 0\n            self.scratch[base + 7] = 0\n        }\n        if has_waker {\n            base := count * 8\n            wu := i64(waker_fd).bit_and(0xffffffff)\n            self.scratch[base] = u8(wu.bit_and(0xff))\n            self.scratch[base + 1] = u8(wu.shr(8).bit_and(0xff))\n            self.scratch[base + 2] = u8(wu.shr(16).bit_and(0xff))\n            self.scratch[base + 3] = u8(wu.shr(24).bit_and(0xff))\n            self.scratch[base + 4] = 1\n            self.scratch[base + 5] = 0\n            self.scratch[base + 6] = 0\n            self.scratch[base + 7] = 0\n        }\n        mut n: i64 = 0\n        unsafe { n = sys.fd_poll(&mut self.scratch, i64(total), i64(timeout_ms)) }\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        for i in 0..count {\n            base := i * 8\n            lo := i32(self.scratch[base + 6])\n            hi := i32(self.scratch[base + 7])\n            self.revents[i] = lo + hi.shl(8)\n        }\n        mut ready := i32(n)\n        if has_waker {\n            wbase := count * 8\n            wrev := i32(self.scratch[wbase + 6]) + i32(self.scratch[wbase + 7]).shl(8)\n            if wrev != 0 {\n                self.waker_fired = true\n                if ready > 0 { ready -= 1 }\n                unsafe { waker_drain_raw(self.waker_state) }\n            }\n        }\n        .Ok(ready)\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.waker_state\n            self.waker_state = ptr(0)\n            waker_release_raw(st)\n        }\n    }\n}\n\nimpl Default for PollSet {\n    fn default() -> Self { PollSet::new() }\n}\n\nimpl StreamSet {\n    pub fn new() -> Self { Self { fds: [] } }\n    pub fn len(&self) -> i32 { self.fds.len }\n    pub fn fd(&self, slot: i32) -> i32 { self.fds[slot] }\n\n    pub fn insert(&mut self, move s: TcpStream) -> i32 {\n        mut stream := s\n        fd := stream.fd\n        assert(fd >= 0)\n        stream.fd = -1\n        for i in 0..self.fds.len {\n            if self.fds[i] < 0 {\n                self.fds[i] = fd\n                return i\n            }\n        }\n        self.fds.push(fd)\n        self.fds.len - 1\n    }\n\n    fn dispose(&self) {\n        for fd in self.fds {\n            if fd >= 0 { _ := sys.net_close(fd) }\n        }\n    }\n\n    pub fn read_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_read_append(fd, &mut out, max_bytes, false)\n    }\n\n    pub fn peek_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_read_append(fd, &mut out, max_bytes, true)\n    }\n\n    pub fn write_range(&self, slot: i32, data: &[]u8, offset: i32, length: i32) -> Result<i64, sys.IoError> {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_write_range(fd, &data, offset, length)\n    }\n\n    @thread_safe\n    pub fn shutdown_read(&self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        mut rc: i64 = 0\n        unsafe { rc = os_shutdown(fd, 0) }\n        status_from_i64(rc)\n    }\n\n    pub fn shutdown_write(&self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        status_from_i64(sys.net_shutdown_write(fd))\n    }\n\n    @thread_safe\n    pub fn shutdown_both(&self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        mut rc: i64 = 0\n        unsafe { rc = os_shutdown(fd, 2) }\n        status_from_i64(rc)\n    }\n\n    pub fn local_addr(&self, slot: i32) -> Result<SocketAddr, sys.IoError> {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_local_addr(fd)\n    }\n\n    pub fn peer_addr(&self, slot: i32) -> Result<SocketAddr, sys.IoError> {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_peer_addr(fd)\n    }\n\n    pub fn set_read_timeout(&self, slot: i32, timeout_ms: i64) -> sys.Status {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_set_timeout(fd, true, timeout_ms)\n    }\n\n    pub fn set_write_timeout(&self, slot: i32, timeout_ms: i64) -> sys.Status {\n        fd := self.fds[slot]\n        assert(fd >= 0)\n        fd_set_timeout(fd, false, timeout_ms)\n    }\n\n    pub fn close(&mut self, slot: i32) -> sys.Status {\n        fd := self.fds[slot]\n        if fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(fd))\n        self.fds[slot] = -1\n        st\n    }\n\n    pub fn close_all(&mut self) {\n        for i in 0..self.fds.len {\n            if self.fds[i] >= 0 {\n                _ := sys.net_close(self.fds[i])\n                self.fds[i] = -1\n            }\n        }\n    }\n}\n\nimpl Default for StreamSet {\n    fn default() -> Self { StreamSet::new() }\n}\n\nimpl UdpSocket {\n    @requires(network)\n    @thread_safe\n    pub fn bind(endpoint: SocketAddr) -> Result<Self, sys.IoError> {\n        domain := addr_family(endpoint.ip)\n        mut fd := -45\n        unsafe { fd = os_socket(domain, 2, 0) }\n        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }\n        mut sock := Self { fd: fd }\n        mut sa: [u8; 32] = [0; 32]\n        sa_len := encode_sockaddr(endpoint, &mut sa)\n        mut brc: i64 = 0\n        unsafe { brc = os_bind(sock.fd, addr(&sa[0]), sa_len) }\n        if brc < 0 {\n            _ := sock.close()\n            return .Err(sys.IoError::from_code(i32(-brc)))\n        }\n        .Ok(sock)\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n\n    pub fn local_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_local_addr(self.fd) }\n\n    pub fn local_port(&self) -> i32 {\n        match self.local_addr() {\n            .Ok(a) => i32(a.port),\n            .Err(_) => -1,\n        }\n    }\n\n    pub fn peer_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_peer_addr(self.fd) }\n\n    @thread_safe\n    pub fn connect(&self, endpoint: SocketAddr) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: false, error: 9 } }\n        if endpoint.port == 0 { return sys.Status { ok: false, error: 22 } }\n        mut sa: [u8; 32] = [0; 32]\n        sa_len := encode_sockaddr(endpoint, &mut sa)\n        mut rc: i64 = 0\n        unsafe { rc = os_connect(self.fd, addr(&sa[0]), sa_len) }\n        status_from_i64(rc)\n    }\n\n    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {\n        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))\n    }\n\n    pub fn set_read_timeout(&self, timeout_ms: i64) -> sys.Status {\n        fd_set_timeout(self.fd, true, timeout_ms)\n    }\n\n    pub fn set_write_timeout(&self, timeout_ms: i64) -> sys.Status {\n        fd_set_timeout(self.fd, false, timeout_ms)\n    }\n\n    @thread_safe\n    pub fn send_to_range(&self, data: &[]u8, offset: i32, length: i32, endpoint: SocketAddr) -> Result<i64, sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        if offset < 0 || length < 0 || offset > data.len || length > data.len - offset || endpoint.port == 0 {\n            return .Err(.InvalidArgument)\n        }\n        mut sa: [u8; 32] = [0; 32]\n        sa_len := encode_sockaddr(endpoint, &mut sa)\n        mut scratch: u8 = 0\n        mut n: i64 = 0\n        unsafe {\n            buf_ptr := if length > 0 { addr(&data[offset]) } else { addr(&mut scratch) }\n            n = os_sendto(self.fd, buf_ptr, usize(length), addr(&sa[0]), sa_len)\n        }\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        .Ok(n)\n    }\n\n    pub fn send_to(&self, data: &[]u8, endpoint: SocketAddr) -> Result<i64, sys.IoError> {\n        self.send_to_range(&data, 0, data.len, endpoint)\n    }\n\n    @thread_safe\n    pub fn send(&self, data: &[]u8) -> Result<i64, sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        mut scratch: u8 = 0\n        mut n: i64 = 0\n        unsafe {\n            buf_ptr := if data.len > 0 { addr(&data[0]) } else { addr(&mut scratch) }\n            n = os_sendto(self.fd, buf_ptr, usize(data.len), ptr(0), 0)\n        }\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        .Ok(n)\n    }\n\n    @thread_safe\n    fn recv_from_internal(&self, out: &mut []u8, max_bytes: i32, peek: bool) -> Result<(i64, SocketAddr), sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        if max_bytes < 0 { return .Err(.InvalidArgument) }\n        if max_bytes == 0 { return .Ok((0, zero_addr())) }\n        mut cap := max_bytes\n        if cap > 65535 { cap = 65535 }\n        mut scratch: []u8 = []\n        bytes.pad(&mut scratch, cap)\n        mut sa: [u8; 128] = [0; 128]\n        mut len_buf: [u8; 4] = [128, 0, 0, 0]\n        flags := if peek { 2 } else { 0 }\n        mut n: i64 = 0\n        unsafe {\n            n = os_recvfrom(self.fd, addr(&mut scratch[0]), usize(cap), flags, addr(&mut sa[0]), addr(&mut len_buf[0]))\n        }\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        mut got := i32(n)\n        if got > cap { got = cap }\n        if got > 0 { bytes.extend_range(&mut out, &scratch, 0, got) }\n        mut from := zero_addr()\n        unsafe {\n            sa_len := load_u32(addr(&len_buf[0]))\n            if sa_len >= 8 {\n                match decode_sockaddr_ptr(addr(&sa[0]), sa_len) {\n                    .Ok(a) => { from = a },\n                    .Err(_) => {},\n                }\n            }\n        }\n        .Ok((n, from))\n    }\n\n    pub fn recv_from_append(&self, out: &mut []u8, max_bytes: i32) -> Result<(i64, SocketAddr), sys.IoError> {\n        self.recv_from_internal(&mut out, max_bytes, false)\n    }\n\n    pub fn peek_from_append(&self, out: &mut []u8, max_bytes: i32) -> Result<(i64, SocketAddr), sys.IoError> {\n        self.recv_from_internal(&mut out, max_bytes, true)\n    }\n\n    pub fn recv_append(&self, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {\n        res := self.recv_from_internal(&mut out, max_bytes, false)?\n        .Ok(res.0)\n    }\n\n    fn dispose(&self) {\n        if self.fd >= 0 { _ := sys.net_close(self.fd) }\n    }\n\n    pub fn close(&mut self) -> sys.Status {\n        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }\n        st := status_from_i64(sys.net_close(self.fd))\n        self.fd = -1\n        st\n    }\n}\n\n@requires(network)\n@thread_safe\npub fn resolve(host: string, port: u16) -> Result<[]SocketAddr, string> {\n    if host.len == 0 || host.len > 1024 {\n        return .Err(sys.error_message(22))\n    }\n    for b in host.bytes() {\n        if b == 0 {\n            return .Err(sys.error_message(22))\n        }\n    }\n    match IpAddr::parse(host) {\n        .Ok(ip) => {\n            return .Ok([SocketAddr::new(ip, port)])\n        },\n        .Err(_) => {},\n    }\n    if target_is(\"macos\") || target_is(\"linux\") {\n        mut host_c: []u8 = []\n        bytes.append_utf8(&mut host_c, host)\n        host_c.push(0)\n        svc := i32(port).str()\n        mut svc_c: []u8 = []\n        bytes.append_utf8(&mut svc_c, svc)\n        svc_c.push(0)\n        mut hints: [u8; 48] = [0; 48]\n        hints[8] = 1\n        mut res_buf: [u8; 8] = [0; 8]\n        unsafe {\n            rc := c_getaddrinfo(addr(&host_c[0]), addr(&svc_c[0]), addr(&hints[0]), addr(&mut res_buf[0]))\n            if rc != 0 {\n                return .Err(copy_c_str(c_gai_strerror(rc)))\n            }\n            head := load_ptr(addr(&res_buf[0]))\n            defer { if usize(head) != 0 { c_freeaddrinfo(head) } }\n            mut addrs: []SocketAddr = []\n            mut cur := head\n            mut steps := 0\n            while usize(cur) != 0 && steps < 1024 {\n                steps += 1\n                ai_addrlen := load_u32(ptr(usize(cur) + 16))\n                ai_addr := if target_is(\"macos\") {\n                    load_ptr(ptr(usize(cur) + 32))\n                } else {\n                    load_ptr(ptr(usize(cur) + 24))\n                }\n                if usize(ai_addr) != 0 {\n                    match decode_sockaddr_ptr(ai_addr, ai_addrlen) {\n                        .Ok(a) => {\n                            mut cand := a\n                            cand.port = port\n                            mut dup := false\n                            for existing in &addrs {\n                                if existing == cand { dup = true; break }\n                            }\n                            if !dup { addrs.push(cand) }\n                        },\n                        .Err(_) => {},\n                    }\n                }\n                cur = load_ptr(ptr(usize(cur) + 40))\n            }\n            if addrs.len == 0 {\n                return .Err(\"no addresses resolved\")\n            }\n            return .Ok(addrs)\n        }\n    }\n    .Err(sys.error_message(45))\n}\n" }
    if name == "parse" { return "import std.parse.decimal as decimal\n\npub struct Integer { ok: bool, value: i64, error: i32 }\npub struct Unsigned { ok: bool, value: u64, error: i32 }\npub struct Float32 { ok: bool, value: f32, error: i32 }\npub struct Float64 { ok: bool, value: f64, error: i32 }\n\nfn radix_digit(byte: i32, radix: i32) -> i32 {\n    if byte >= 48 && byte <= 57 {\n        d := byte - 48\n        if d < radix { return d }\n        return -1\n    }\n    if radix == 16 {\n        if byte >= 65 && byte <= 70 { return byte - 55 }\n        if byte >= 97 && byte <= 102 { return byte - 87 }\n    }\n    -1\n}\n\nfn parse_signed_range(text: string, start: i32, end: i32, radix: i32, separators: bool) -> Integer {\n    if start < 0 || end <= start || end > text.len { return Integer { ok: false, value: 0, error: 1 } }\n    mut cursor := start\n    negative := text[cursor] == 45\n    if negative || text[cursor] == 43 { cursor += 1 }\n    if cursor == end { return Integer { ok: false, value: 0, error: 1 } }\n    limit: i64 = if negative { -9223372036854775808 } else { -9223372036854775807 }\n    cutoff := limit / i64(radix)\n    first_digit := cursor\n    mut value: i64 = 0\n    while cursor < end {\n        if separators && text[cursor] == 95 {\n            if cursor == first_digit || cursor + 1 == end { return Integer { ok: false, value: 0, error: 1 } }\n            cursor += 1\n        }\n        d := radix_digit(i32(text[cursor]), radix)\n        if d < 0 { return Integer { ok: false, value: 0, error: 1 } }\n        if value < cutoff { return Integer { ok: false, value: 0, error: 2 } }\n        value *= i64(radix)\n        if value < limit + i64(d) { return Integer { ok: false, value: 0, error: 2 } }\n        value -= i64(d)\n        cursor += 1\n    }\n    if !negative { value = -value }\n    Integer { ok: true, value: value, error: 0 }\n}\n\nfn parse_unsigned_range(text: string, start: i32, end: i32, radix: i32) -> Unsigned {\n    if start < 0 || end <= start || end > text.len { return Unsigned { ok: false, value: 0, error: 1 } }\n    maximum: u64 = 18446744073709551615\n    max_div := maximum / u64(radix)\n    max_rem := i32(maximum % u64(radix))\n    mut value: u64 = 0\n    for i in start..end {\n        d := radix_digit(i32(text[i]), radix)\n        if d < 0 { return Unsigned { ok: false, value: 0, error: 1 } }\n        if value > max_div || (value == max_div && d > max_rem) {\n            return Unsigned { ok: false, value: 0, error: 2 }\n        }\n        value = value * u64(radix) + u64(d)\n    }\n    Unsigned { ok: true, value: value, error: 0 }\n}\n\npub fn integer(text: string) -> Integer { Integer::parse(text) }\npub fn hex(text: string) -> Integer { Integer::hex(text) }\npub fn i64_range(text: string, start: i32, end: i32) -> Integer { Integer::range(text, start, end) }\npub fn u64_range(text: string, start: i32, end: i32) -> Unsigned { Unsigned::range(text, start, end) }\npub fn hex_u64_range(text: string, start: i32, end: i32) -> Unsigned { Unsigned::hex_range(text, start, end) }\n\nimpl Integer {\n    pub fn parse(text: string) -> Self { parse_signed_range(text, 0, text.len, 10, true) }\n    pub fn hex(text: string) -> Self { parse_signed_range(text, 0, text.len, 16, false) }\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_signed_range(text, start, end, 10, false) }\n}\n\nimpl Unsigned {\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_unsigned_range(text, start, end, 10) }\n    pub fn hex_range(text: string, start: i32, end: i32) -> Self { parse_unsigned_range(text, start, end, 16) }\n}\n\nfn ascii_digit(byte: i32) -> bool { byte >= i32(b'0') && byte <= i32(b'9') }\n\nfn after_decimal_digits(text: string, start: i32, end: i32, separators: bool) -> i32 {\n    if start == end || !ascii_digit(i32(text[start])) { return -1 }\n    mut cursor := start + 1\n    while cursor < end {\n        if ascii_digit(i32(text[cursor])) {\n            cursor += 1\n        } else if separators && i32(text[cursor]) == i32(b'_') && cursor + 1 < end && ascii_digit(i32(text[cursor + 1])) {\n            cursor += 2\n        } else {\n            break\n        }\n    }\n    cursor\n}\n\nfn valid_decimal(text: string, start: i32, end: i32, separators: bool) -> bool {\n    if start < 0 || end <= start || end > text.len { return false }\n    mut cursor := start\n    if i32(text[cursor]) == i32(b'+') || i32(text[cursor]) == i32(b'-') { cursor += 1 }\n    cursor = after_decimal_digits(text, cursor, end, separators)\n    if cursor < 0 { return false }\n    if cursor < end && i32(text[cursor]) == i32(b'.') {\n        cursor = after_decimal_digits(text, cursor + 1, end, separators)\n        if cursor < 0 { return false }\n    }\n    if cursor < end && (i32(text[cursor]) == i32(b'e') || i32(text[cursor]) == i32(b'E')) {\n        cursor += 1\n        if cursor < end && (i32(text[cursor]) == i32(b'+') || i32(text[cursor]) == i32(b'-')) { cursor += 1 }\n        cursor = after_decimal_digits(text, cursor, end, separators)\n    }\n    cursor == end\n}\n\nfn parse_float32(text: string, start: i32, end: i32, separators: bool) -> Float32 {\n    if !valid_decimal(text, start, end, separators) { return Float32 { ok: false, value: 0.0, error: 1 } }\n    parsed := decimal.decode_range(text, start, end, true)\n    if !parsed.ok { return Float32 { ok: false, value: 0.0, error: 2 } }\n    bits := if parsed.bits >= 2147483648 { parsed.bits - 4294967296 } else { parsed.bits }\n    Float32 { ok: true, value: f32.from_bits(i32(bits)), error: 0 }\n}\n\nfn parse_float64(text: string, start: i32, end: i32, separators: bool) -> Float64 {\n    if !valid_decimal(text, start, end, separators) { return Float64 { ok: false, value: 0.0, error: 1 } }\n    parsed := decimal.decode_range(text, start, end, false)\n    if !parsed.ok { return Float64 { ok: false, value: 0.0, error: 2 } }\n    Float64 { ok: true, value: f64.from_bits(parsed.bits), error: 0 }\n}\n\nimpl Float32 {\n    pub fn parse(text: string) -> Self { parse_float32(text, 0, text.len, true) }\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_float32(text, start, end, false) }\n}\n\nimpl Float64 {\n    pub fn parse(text: string) -> Self { parse_float64(text, 0, text.len, true) }\n    pub fn range(text: string, start: i32, end: i32) -> Self { parse_float64(text, start, end, false) }\n}\n\npub trait FromStr {\n    fn from_str(text: string) -> Result<Self, string>\n}\n\npub fn value<T: FromStr + Storable>(text: string) -> Result<T, string> {\n    T::from_str(text)\n}\n\nfn int_error_msg(code: i32, kind: string) -> string {\n    if code == 2 { return kind + \" out of range\" }\n    \"invalid \" + kind\n}\n\nimpl FromStr for bool {\n    fn from_str(text: string) -> Result<Self, string> {\n        if text == \"true\" { return .Ok(true) }\n        if text == \"false\" { return .Ok(false) }\n        .Err(\"invalid bool\")\n    }\n}\n\nimpl FromStr for string {\n    fn from_str(text: string) -> Result<Self, string> { .Ok(text.clone()) }\n}\n\nimpl FromStr for i64 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Integer::parse(text)\n        if !res.ok { return .Err(int_error_msg(res.error, \"i64\")) }\n        .Ok(res.value)\n    }\n}\n\nimpl FromStr for i32 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Integer::parse(text)\n        if !res.ok { return .Err(int_error_msg(res.error, \"i32\")) }\n        if res.value < -2147483648 || res.value > 2147483647 { return .Err(\"i32 out of range\") }\n        .Ok(i32(res.value))\n    }\n}\n\nimpl FromStr for i16 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Integer::parse(text)\n        if !res.ok { return .Err(int_error_msg(res.error, \"i16\")) }\n        if res.value < -32768 || res.value > 32767 { return .Err(\"i16 out of range\") }\n        .Ok(i16(res.value))\n    }\n}\n\nimpl FromStr for u64 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Unsigned::range(text, 0, text.len)\n        if !res.ok { return .Err(int_error_msg(res.error, \"u64\")) }\n        .Ok(res.value)\n    }\n}\n\nimpl FromStr for u8 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Unsigned::range(text, 0, text.len)\n        if !res.ok { return .Err(int_error_msg(res.error, \"u8\")) }\n        if res.value > 255 { return .Err(\"u8 out of range\") }\n        .Ok(u8(res.value))\n    }\n}\n\nimpl FromStr for u16 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Unsigned::range(text, 0, text.len)\n        if !res.ok { return .Err(int_error_msg(res.error, \"u16\")) }\n        if res.value > 65535 { return .Err(\"u16 out of range\") }\n        .Ok(u16(res.value))\n    }\n}\n\nimpl FromStr for u32 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Unsigned::range(text, 0, text.len)\n        if !res.ok { return .Err(int_error_msg(res.error, \"u32\")) }\n        if res.value > 4294967295 { return .Err(\"u32 out of range\") }\n        .Ok(u32(res.value))\n    }\n}\n\nimpl FromStr for usize {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Unsigned::range(text, 0, text.len)\n        if !res.ok { return .Err(int_error_msg(res.error, \"usize\")) }\n        if target_is(\"wasm32\") && res.value > 4294967295 { return .Err(\"usize out of range\") }\n        .Ok(usize(res.value))\n    }\n}\n\nimpl FromStr for f32 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Float32::parse(text)\n        if !res.ok { return .Err(int_error_msg(res.error, \"f32\")) }\n        .Ok(res.value)\n    }\n}\n\nimpl FromStr for f64 {\n    fn from_str(text: string) -> Result<Self, string> {\n        res := Float64::parse(text)\n        if !res.ok { return .Err(int_error_msg(res.error, \"f64\")) }\n        .Ok(res.value)\n    }\n}\n\n@test fn floating_parser_checks_grammar_and_rounds_directly_to_the_target_width() {\n    wide := Float64::parse(\"+1_234.5_6e-0_2\")\n    assert(wide.ok && wide.value == 12.3456)\n    narrow := Float32::parse(\"1.000000059604644775390625000000000000000001\")\n    assert(narrow.ok && narrow.value.to_bits() == 0x3f800001)\n    assert(Float32::parse(\"1.000000059604644775390625\").value.to_bits() == 0x3f800000)\n    assert(Float32::parse(\"-1e-99999999\").value.to_bits() == -2147483648)\n    assert(Float64::parse(\"-0\").value.to_bits() == -9223372036854775808)\n    assert(Float64::parse(\"5e-324\").value.to_bits() == 1)\n    assert(Float64::parse(\"1.7976931348623157e308\").value.to_bits() == 0x7fefffffffffffff)\n    assert(Float64::parse(\"1.7976931348623159e308\").error == 2)\n    assert(Float32::parse(\"3.5e38\").error == 2)\n    assert(Float64::range(\"v=-0.125!\", 2, 8).value == -0.125)\n    assert(Float32::range(\"2_0\", 0, 3).error == 1)\n    for invalid in [\"\", \".\", \"+\", \"1.\", \".1\", \"1e\", \"1e+\", \"1e_2\", \"1_.2\", \"1__0\", \" 1\", \"1\\0\", \"NaN\", \"Infinity\"] {\n        assert(Float64::parse(invalid).error == 1)\n    }\n}\n\n@test fn decimal_parser_covers_limits_separators_and_errors() {\n    integer(\"42\").value == 42\n    integer(\"-9223372036854775808\").value == -9223372036854775808\n    integer(\"9223372036854775807\").value == 9223372036854775807\n    integer(\"42_000\").value == 42000\n    integer(\"+0\").ok\n    integer(\"9223372036854775808\").error == 2\n    integer(\"-9223372036854775809\").error == 2\n    !integer(\"1__2\").ok\n    !integer(\"1_\").ok\n    !integer(\"-_1\").ok\n    !integer(\" 2\").ok\n    !integer(\"+\").ok\n    !integer(\"\").ok\n    hex(\"1a2B\").value == 6699\n    hex(\"-ff\").value == -255\n    !hex(\"1_2\").ok\n    i64_range(\"len:1024;\", 4, 8).value == 1024\n    !i64_range(\"len:1_024;\", 4, 9).ok\n    u64_range(\"len:18446744073709551615;\", 4, 24).value == 18446744073709551615\n    u64_range(\"18446744073709551616\", 0, 20).error == 2\n    hex_u64_range(\"chunk=deadbeef;\", 6, 14).value == 3735928559\n\n    assert(value<bool>(\"true\") == .Ok(true))\n    assert(value<bool>(\"false\") == .Ok(false))\n    assert(value<bool>(\"nope\").is_err())\n    assert(value<i32>(\"-42\") == .Ok(-42))\n    assert(value<i32>(\"2147483648\").is_err())\n    assert(value<u8>(\"255\") == .Ok(255))\n    assert(value<u8>(\"256\").is_err())\n    assert(value<u64>(\"18446744073709551615\") == .Ok(u64(18446744073709551615)))\n    assert(value<string>(\"hello\") == .Ok(\"hello\"))\n    assert(value<f64>(\"1.5\").unwrap_or(0.0) == 1.5)\n    assert(value<f32>(\"bad\").is_err())\n}\n" }
    if name == "parse/decimal" { return "pub struct Number { ok: bool, bits: i64 }\n\nfn multiply(value: &mut []i32, factor: i32, add: i32) {\n    mut carry := add\n    for i in 0..value.len {\n        n := value[i] * factor + carry\n        value[i] = n % 16777216\n        carry = n / 16777216\n    }\n    if carry != 0 { value.push(carry) }\n}\n\nfn compare(a: &[]i32, b: &[]i32) -> i32 {\n    if a.len != b.len { return a.len - b.len }\n    mut i := a.len - 1\n    while i >= 0 {\n        if a[i] != b[i] { return a[i] - b[i] }\n        i = i - 1\n    }\n    0\n}\n\nfn subtract(a: &mut []i32, b: &[]i32) {\n    mut borrow := 0\n    for i in 0..a.len {\n        mut n := a[i] - borrow\n        if i < b.len { n = n - b[i] }\n        borrow = 0\n        if n < 0 { n = n + 16777216; borrow = 1 }\n        a[i] = n\n    }\n    while a.len > 0 && a[a.len - 1] == 0 { _ := a.pop() }\n}\n\npub fn decode(text: string, single: bool) -> Number {\n    decode_range(text, 0, text.len, single)\n}\n\n// The caller has already checked the decimal grammar.\npub fn decode_range(text: string, start: i32, end: i32, single: bool) -> Number {\n    mut sign: i64 = 0\n    mut bias := 1023\n    mut fraction := 52\n    if single { bias = 127; fraction = 23 }\n    mut i := start\n    if i32(text[i]) == i32(b'-') {\n        i += 1\n        sign = -9223372036854775808\n        if single { sign = 2147483648 }\n    } else if i32(text[i]) == i32(b'+') {\n        i += 1\n    }\n    mut numerator: []i32 = []\n    mut denominator: []i32 = [1]\n    mut after_point := false\n    mut digits := 0\n    mut scale: i64 = 0\n    mut sticky := false\n    while i < end {\n        byte := i32(text[i]); i = i + 1\n        if byte == 69 || byte == 101 {\n            mut negative := false\n            if i < end && (i32(text[i]) == i32(b'+') || i32(text[i]) == i32(b'-')) {\n                negative = i32(text[i]) == i32(b'-')\n                i += 1\n            }\n            mut power: i64 = 0\n            while i < end {\n                digit := i32(text[i]); i = i + 1\n                if digit != 95 && power < 10000000000 { power = power * 10 + i64(digit - 48) }\n            }\n            if negative { scale = scale - power } else { scale = scale + power }\n            break\n        }\n        if byte == 95 { continue }\n        if byte == 46 { after_point = true; continue }\n        if after_point { scale = scale - 1 }\n        if byte == 48 && digits == 0 { continue }\n        if digits < 800 {\n            multiply(&mut numerator, 10, byte - 48); digits = digits + 1\n        } else {\n            scale = scale + 1\n            if byte != 48 { sticky = true }\n        }\n    }\n    if digits == 0 || i64(digits) + scale < -324 { return Number { ok: true, bits: sign } }\n    if i64(digits) + scale > 309 { return Number { ok: false, bits: 0 } }\n    while scale > 0 { multiply(&mut numerator, 10, 0); scale = scale - 1 }\n    while scale < 0 { multiply(&mut denominator, 10, 0); scale = scale + 1 }\n    mut exponent := 0\n    if compare(&numerator, &denominator) < 0 {\n        while compare(&numerator, &denominator) < 0 { multiply(&mut numerator, 2, 0); exponent = exponent - 1 }\n    } else {\n        mut twice := denominator.clone()\n        multiply(&mut twice, 2, 0)\n        while compare(&numerator, &twice) >= 0 {\n            multiply(&mut denominator, 2, 0); multiply(&mut twice, 2, 0); exponent = exponent + 1\n        }\n    }\n    mut precision := fraction + 1\n    if exponent < 1 - bias { precision = precision + exponent - (1 - bias) }\n    if precision < 0 { return Number { ok: true, bits: sign } }\n    mut mantissa: i64 = 0\n    for _ in 0..precision {\n        mantissa = mantissa * 2\n        if compare(&numerator, &denominator) >= 0 {\n            mantissa = mantissa + 1\n            subtract(&mut numerator, &denominator)\n        }\n        multiply(&mut numerator, 2, 0)\n    }\n    rounding := compare(&numerator, &denominator)\n    if rounding > 0 || (rounding == 0 && (sticky || mantissa % 2 != 0)) { mantissa = mantissa + 1 }\n    unit := i64(1).shl(fraction)\n    if mantissa >= unit * 2 { mantissa = mantissa / 2; exponent = exponent + 1 }\n    if exponent > bias { return Number { ok: false, bits: 0 } }\n    if exponent >= 1 - bias { mantissa = mantissa + i64(exponent + bias - 1) * unit }\n    Number { ok: true, bits: mantissa.bit_or(sign) }\n}\n" }
    if name == "path" { return "import std.path.lexical as lexical\n\npub fn is_absolute(p: string) -> bool { lexical.is_absolute(p) }\npub fn join(base: string, child: string) -> string { lexical.join(base, child) }\npub fn basename(p: string) -> string { lexical.basename(p) }\npub fn dirname(p: string) -> string { lexical.dirname(p) }\npub fn stem(p: string) -> string { lexical.stem(p) }\npub fn with_extension(p: string, ext: string) -> string { lexical.with_extension(p, ext) }\npub fn normalize(p: string) -> string { lexical.normalize(p) }\n\npub fn extension(p: string) -> Option<string> {\n    name := basename(p)\n    if name == \"\" || name == \".\" || name == \"..\" || lexical.root(name) == name { return .None }\n    mut dot := -1\n    mut i := name.len - 1\n    while i > 0 {\n        if name[i] == 46 { dot = i; break }\n        i -= 1\n    }\n    if dot <= 0 || dot >= name.len - 1 { return .None }\n    .Some(name[(dot + 1)..name.len])\n}\n\n@test fn path_join_dirname_and_basename_cases() {\n    assert(is_absolute(\"/usr/bin\"))\n    assert(!is_absolute(\"usr/bin\"))\n    assert(!is_absolute(\"\"))\n\n    assert(join(\"/usr\", \"local/bin\") == \"/usr/local/bin\")\n    assert(join(\"/usr/\", \"bin\") == \"/usr/bin\")\n    assert(join(\"/\", \"etc\") == \"/etc\")\n    assert(join(\"a/b\", \"\") == \"a/b\")\n    assert(join(\"\", \"a/b\") == \"a/b\")\n    assert(join(\"/a/b\", \"/c/d\") == \"/c/d\")\n\n    assert(dirname(\"/usr/lib\") == \"/usr\")\n    assert(dirname(\"/usr/\") == \"/\")\n    assert(dirname(\"/usr\") == \"/\")\n    assert(dirname(\"/\") == \"/\")\n    assert(dirname(\"usr\") == \".\")\n    assert(dirname(\"\") == \".\")\n    assert(dirname(\"a/b/c\") == \"a/b\")\n    assert(dirname(\"a/b/\") == \"a\")\n\n    assert(basename(\"/usr/lib\") == \"lib\")\n    assert(basename(\"/usr/\") == \"usr\")\n    assert(basename(\"/\") == \"/\")\n    assert(basename(\"usr\") == \"usr\")\n    assert(basename(\"\") == \"\")\n    assert(basename(\"a/b/c\") == \"c\")\n}\n\n@test fn path_extension_stem_and_normalize_cases() {\n    assert(extension(\"archive.tar.gz\") == .Some(\"gz\"))\n    assert(extension(\"main.ddr\") == .Some(\"ddr\"))\n    assert(extension(\"a.b/c\") == .None)\n    assert(extension(\".gitignore\") == .None)\n    assert(extension(\"foo.\") == .None)\n    assert(extension(\"/\") == .None)\n    assert(extension(\"\") == .None)\n\n    assert(stem(\"archive.tar.gz\") == \"archive.tar\")\n    assert(stem(\"/dir/.bashrc\") == \".bashrc\")\n    assert(stem(\"/dir/file.txt\") == \"file\")\n    assert(stem(\"plain\") == \"plain\")\n\n    assert(with_extension(\"foo.txt\", \"md\") == \"foo.md\")\n    assert(with_extension(\"foo.txt\", \".md\") == \"foo.md\")\n    assert(with_extension(\"/tmp/foo.txt\", \"\") == \"/tmp/foo\")\n    assert(with_extension(\"sub/file\", \"ddr\") == \"sub/file.ddr\")\n\n    assert(normalize(\"/a/b/../c/./d/\") == \"/a/c/d\")\n    assert(normalize(\"/../..\") == \"/\")\n    assert(normalize(\"a/b/../../..\") == \"..\")\n    assert(normalize(\"./a//b/\") == \"a/b\")\n    assert(normalize(\"./.\") == \".\")\n    assert(normalize(\"\") == \"\")\n}\n\n@test fn windows_drive_and_share_roots() {\n    assert(is_absolute(\"C:\\\\Program Files\\\\Åäö\"))\n    assert(!is_absolute(\"C:relative\"))\n    assert(normalize(\"C:\\\\Å ä\\\\x\\\\..\\\\fil.ddr\") == \"C:/Å ä/fil.ddr\")\n    assert(normalize(\"C:/../../escape\") == \"C:/escape\")\n    assert(normalize(\"C:folder/../file\") == \"C:file\")\n    assert(dirname(\"C:\\\\main.ddr\") == \"C:/\")\n    assert(join(\"C:\\\\\", \"src\\\\main.ddr\") == \"C:/src/main.ddr\")\n    assert(basename(\"C:\\\\src\\\\fil.ddr\") == \"fil.ddr\")\n    assert(with_extension(\"C:\\\\src\\\\fil.ddr\", \"exe\") == \"C:/src/fil.exe\")\n    assert(normalize(\"\\\\\\\\host\\\\share\\\\dir\\\\..\\\\..\\\\x\") == \"//host/share/x\")\n    assert(dirname(\"//host/share/fil\") == \"//host/share\")\n    assert(join(\"//host/share\", \"a\\\\b\") == \"//host/share/a/b\")\n    assert(join(\"C:/src\", \"D:\\\\data\") == \"D:/data\")\n    assert(normalize(\"///mnt/dir\") == \"/mnt/dir\")\n}\n" }
    if name == "path/lexical" { return "import std.text as text\n\nfn has_drive(p: string) -> bool {\n    if p.len < 2 || p[1] != 58 { return false }\n    letter := p[0]\n    (letter >= 65 && letter <= 90) || (letter >= 97 && letter <= 122)\n}\n\nfn windows_slashes(p: string) -> string {\n    mut out := \"\"\n    mut start := 0\n    for i in 0..p.len {\n        if p[i] == 92 {\n            out += p[start..i] + \"/\"\n            start = i + 1\n        }\n    }\n    if start == 0 { return p.clone() }\n    out + p[start..p.len]\n}\n\nfn slash_form(p: string) -> string {\n    if (target_is(\"native\") && !target_is(\"macos\") && !target_is(\"linux\")) || has_drive(p) || text.starts_with(p, \"\\\\\\\\\") {\n        return windows_slashes(p)\n    }\n    p.clone()\n}\n\nfn root_end(p: string) -> i32 {\n    if has_drive(p) {\n        return if p.len >= 3 && p[2] == 47 { 3 } else { 2 }\n    }\n    if p.len == 0 || p[0] != 47 { return 0 }\n    if p.len < 4 || p[1] != 47 || p[2] == 47 { return 1 }\n    mut end := 2\n    while end < p.len && p[end] != 47 { end += 1 }\n    if end == p.len || end + 1 == p.len || p[end + 1] == 47 { return 1 }\n    end += 1\n    while end < p.len && p[end] != 47 { end += 1 }\n    end\n}\n\npub fn root(p: string) -> string {\n    value := slash_form(p)\n    value[0..root_end(value)]\n}\n\npub fn is_absolute(p: string) -> bool {\n    if p.len == 0 { return false }\n    if has_drive(p) { return p.len >= 3 && (p[2] == 47 || p[2] == 92) }\n    p[0] == 47 || text.starts_with(p, \"\\\\\\\\\") || ((target_is(\"native\") && !target_is(\"macos\") && !target_is(\"linux\")) && p[0] == 92)\n}\n\nfn trimmed_end(p: string) -> i32 {\n    root := root_end(p)\n    mut end := p.len\n    while end > root && p[end - 1] == 47 { end -= 1 }\n    end\n}\n\npub fn join(base: string, child: string) -> string {\n    parent := slash_form(base)\n    if child.len == 0 { return parent }\n    part := if has_drive(parent) || text.starts_with(parent, \"//\") { windows_slashes(child) } else { slash_form(child) }\n    if is_absolute(part) || has_drive(part) || parent.len == 0 { return part }\n    end := trimmed_end(parent)\n    if parent[end - 1] == 47 || (end == 2 && has_drive(parent)) { return parent[0..end] + part }\n    parent[0..end] + \"/\" + part\n}\n\npub fn basename(p: string) -> string {\n    value := slash_form(p)\n    end := trimmed_end(value)\n    root := root_end(value)\n    if end == root { return value[0..end] }\n    mut i := end\n    while i > root && value[i - 1] != 47 { i -= 1 }\n    value[i..end]\n}\n\npub fn dirname(p: string) -> string {\n    value := slash_form(p)\n    root := root_end(value)\n    mut end := trimmed_end(value)\n    while end > root && value[end - 1] != 47 { end -= 1 }\n    while end > root && value[end - 1] == 47 { end -= 1 }\n    if end == 0 { return \".\" }\n    value[0..end]\n}\n\npub fn stem(p: string) -> string {\n    name := basename(p)\n    if name == \"\" || name == \".\" || name == \"..\" || root_end(name) == name.len { return name }\n    mut dot := -1\n    mut i := name.len - 1\n    while i > 0 {\n        if name[i] == 46 { dot = i; break }\n        i -= 1\n    }\n    if dot <= 0 || dot >= name.len - 1 { return name }\n    name[0..dot]\n}\n\npub fn with_extension(p: string, ext: string) -> string {\n    value := slash_form(p)\n    end := trimmed_end(value)\n    if end == root_end(value) { return value }\n    name := basename(value)\n    base_name := stem(name)\n    mut clean := ext.clone()\n    if clean.len > 0 && clean[0] == 46 { clean = clean[1..clean.len] }\n    updated := if clean.len == 0 { base_name } else { base_name + \".\" + clean }\n    value[0..end - name.len] + updated\n}\n\npub fn normalize(p: string) -> string {\n    if p.len == 0 { return \"\" }\n    value := slash_form(p)\n    abs := is_absolute(value)\n    root := root_end(value)\n    mut parts: []string = []\n    mut i := root\n    while i < value.len {\n        while i < value.len && value[i] == 47 { i += 1 }\n        if i >= value.len { break }\n        start := i\n        while i < value.len && value[i] != 47 { i += 1 }\n        seg := value[start..i]\n        if seg == \".\" { continue }\n        if seg == \"..\" {\n            if parts.len > 0 && parts[parts.len - 1] != \"..\" {\n                _ := parts.pop()\n            } else if !abs {\n                parts.push(\"..\")\n            }\n            continue\n        }\n        parts.push(move seg)\n    }\n    if parts.len == 0 {\n        if root > 0 { return value[0..root] }\n        return \".\"\n    }\n    mut out := value[0..root]\n    if root > 3 && out[root - 1] != 47 { out += \"/\" }\n    for idx in 0..parts.len {\n        if idx > 0 { out += \"/\" }\n        out += parts[idx]\n    }\n    out\n}\n" }
    if name == "process" { return "capability unsafe, process\nimport std.bytes as bytes\nimport std.io as io\nimport std.parse as decimal\nimport std.sys.windows as windows\nimport std.text as text\nimport sys\nimport std.sys.windows as wide\nimport std.sys.winprocess as win\n\n@extern(\"kernel32.dll\", \"GetActiveProcessorCount\")\nunsafe fn active_processors(group: u16) -> u32\n@extern(\"kernel32.dll\", \"GetEnvironmentVariableW\")\nunsafe fn environment_value(name: ptr, buffer: ptr, capacity: u32) -> u32\n@extern(\"kernel32.dll\", \"SetLastError\")\nunsafe fn set_last_error(error: u32)\n@extern(\"kernel32.dll\", \"GetLastError\")\nunsafe fn last_error() -> u32\n\n@extern(\"c\", \"uname\")\nunsafe fn c_uname(output: ptr) -> i32\n@extern(\"c\", \"fork\")\nunsafe fn c_fork() -> i32\n@extern(\"c\", \"execve\")\nunsafe fn c_execve(path: ptr, argv: ptr, envp: ptr) -> i32\n@extern(\"c\", \"_exit\")\nunsafe fn c_exit(code: i32)\n@extern(\"c\", \"pipe\")\nunsafe fn c_pipe(fds: ptr) -> i32\n@c_variadic(2)\n@extern(\"c\", \"fcntl\")\nunsafe fn c_fcntl(fd: i32, op: i32, arg: i32) -> i32\n@extern(\"c\", \"dup2\")\nunsafe fn c_dup2(oldfd: i32, newfd: i32) -> i32\n@extern(\"c\", \"close\")\nunsafe fn c_close(fd: i32) -> i32\n@extern(\"c\", \"chdir\")\nunsafe fn c_chdir(path: ptr) -> i32\n@extern(\"c\", \"waitpid\")\nunsafe fn c_waitpid(pid: i32, status: ptr, options: i32) -> i32\n@extern(\"c\", \"kill\")\nunsafe fn c_kill(pid: i32, sig: i32) -> i32\n@extern(\"c\", \"setpgid\")\nunsafe fn c_setpgid(pid: i32, pgid: i32) -> i32\n@extern(\"c\", \"read\")\nunsafe fn c_read(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"write\")\nunsafe fn c_write(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"ioctl\")\nunsafe fn c_ioctl(fd: i32, req: usize) -> i32\n@extern(\"c\", \"fopen\")\nunsafe fn c_fopen(path: ptr, mode: ptr) -> ptr\n@extern(\"c\", \"fileno\")\nunsafe fn c_fileno(file: ptr) -> i32\n@extern(\"c\", \"fclose\")\nunsafe fn c_fclose(file: ptr) -> i32\n@extern(\"c\", \"getenv\")\nunsafe fn c_getenv(name: ptr) -> ptr\n@extern(\"c\", \"signal\")\nunsafe fn c_signal(sig: i32, handler: ptr) -> ptr\n@extern(\"c\", \"sigprocmask\")\nunsafe fn c_sigprocmask(how: i32, set: ptr, previous: ptr) -> i32\n@extern(\"c\", \"sysconf\")\nunsafe fn c_sysconf(name: i32) -> i64\n@extern(\"c\", \"usleep\")\nunsafe fn c_usleep(usec: u32) -> i32\n@extern(\"c\", \"__error\")\nunsafe fn c_errno_ptr() -> ptr\n@extern(\"c\", \"_NSGetEnviron\")\nunsafe fn c_ns_get_environ() -> ptr\n\npub enum EnvMode { Inherit = 0, Clear = 1 }\npub enum Stdio { Inherit = 0, Pipe = 1, Null = 2 }\n\npub opaque struct Executable { program: string }\n\npub struct Command {\n    program: string,\n    args: []string,\n    cwd: string,\n    env_mode: EnvMode,\n    env_keys: []string,\n    env_vals: []string,\n    env_unset: []bool,\n    stdin_mode: Stdio,\n    stdout_mode: Stdio,\n    stderr_mode: Stdio,\n    stdin_data: []u8,\n    timeout_ms: i64,\n    max_output_bytes: i64,\n}\n\npub struct Output {\n    ok: bool,\n    error: i32,\n    code: i32,\n    signal: i32,\n    timed_out: bool,\n    stdout: []u8,\n    stderr: []u8,\n}\n\n@resource\npub opaque struct Child {\n    pid: i32,\n    pgid: i32,\n    win_process: i64, win_job: i64,\n    stdin_fd: i32,\n    stdout_fd: i32,\n    stderr_fd: i32,\n    reaped: bool,\n    code: i32,\n    signal: i32,\n}\n\n@resource(dispose)\npub opaque struct ChildStdin { fd: i32 }\n\n@resource(dispose)\npub opaque struct ChildStdout { fd: i32 }\n\n@resource(dispose)\npub opaque struct ChildStderr { fd: i32 }\n\nfn set_pipe_nonblocking(fd: i32, enabled: bool) -> Result<(), sys.IoError> {\n    if fd < 0 { return .Err(.BadDescriptor) }\n    mut r: i64 = 0\n    unsafe { r = sys.fd_set_nonblocking(fd, enabled) }\n    if r < 0 { return .Err(sys.IoError::from_code(i32(-r))) }\n    .Ok\n}\n\nimpl ChildStdin {\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn set_nonblocking(&self, enabled: bool) -> Result<(), sys.IoError> { set_pipe_nonblocking(self.fd, enabled) }\n    pub fn close(&mut self) -> Result<(), sys.IoError> {\n        if self.fd < 0 { return .Ok }\n        fd := self.fd\n        self.fd = -1\n        mut n: i64 = 0\n        unsafe { n = sys.fd_close(fd) }\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        .Ok\n    }\n    fn dispose(&mut self) {\n        if self.fd >= 0 {\n            unsafe { _ := sys.fd_close(self.fd) }\n            self.fd = -1\n        }\n    }\n}\n\nimpl ChildStdout {\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn set_nonblocking(&self, enabled: bool) -> Result<(), sys.IoError> { set_pipe_nonblocking(self.fd, enabled) }\n    pub fn close(&mut self) -> Result<(), sys.IoError> {\n        if self.fd < 0 { return .Ok }\n        fd := self.fd\n        self.fd = -1\n        mut n: i64 = 0\n        unsafe { n = sys.fd_close(fd) }\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        .Ok\n    }\n    fn dispose(&mut self) {\n        if self.fd >= 0 {\n            unsafe { _ := sys.fd_close(self.fd) }\n            self.fd = -1\n        }\n    }\n}\n\nimpl ChildStderr {\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn set_nonblocking(&self, enabled: bool) -> Result<(), sys.IoError> { set_pipe_nonblocking(self.fd, enabled) }\n    pub fn close(&mut self) -> Result<(), sys.IoError> {\n        if self.fd < 0 { return .Ok }\n        fd := self.fd\n        self.fd = -1\n        mut n: i64 = 0\n        unsafe { n = sys.fd_close(fd) }\n        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n        .Ok\n    }\n    fn dispose(&mut self) {\n        if self.fd >= 0 {\n            unsafe { _ := sys.fd_close(self.fd) }\n            self.fd = -1\n        }\n    }\n}\n\nimpl io.Write for ChildStdin {\n    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {\n        if self.fd < 0 { return .Err(.BadDescriptor) }\n        mut r: Result<i32, sys.IoError> = .Ok(0)\n        unsafe { r = io.fd_write_chunk(self.fd, &data) }\n    