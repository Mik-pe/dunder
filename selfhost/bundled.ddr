bound != 0 {\n            message := failure(db)\n            _ := sql_finalize(statement)\n            return Prepared { ok: false, statement: ptr(0), error: message }\n        }\n    }\n    Prepared { ok: true, statement: statement, error: \"\" }\n}\n\nimpl Database {\n    @requires(filesystem)\n    pub fn open(path: string, read_only: bool) -> OpenResult {\n        if path.len == 0 || path.len > 4096 {\n            unsafe { return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: \"invalid SQLite path\" } }\n        }\n        for byte in path.bytes() {\n            if byte == 0 {\n                unsafe { return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: \"SQLite path contains NUL\" } }\n            }\n        }\n        raw := c_string(path)\n        unsafe {\n            mut handle := ptr(0)\n            mut flags := 65542 // READWRITE | CREATE | FULLMUTEX\n            if read_only { flags = 65537 } // READONLY | FULLMUTEX\n            code := sql_open_v2(addr(&raw[0]), addr(&mut handle), flags, ptr(0))\n            if code != 0 {\n                message := failure(handle)\n                if handle != ptr(0) { _ := sql_close(handle) }\n                return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: message }\n            }\n            if sql_busy_timeout(handle, 5000) != 0 {\n                message := failure(handle)\n                _ := sql_close(handle)\n                return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: message }\n            }\n            db := Self { handle: handle }\n            if read_only {\n                empty: []string = []\n                result := db.exec(\"PRAGMA query_only=ON\", &empty)\n                if !result.ok {\n                    _ := sql_close(handle)\n                    return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: result.error }\n                }\n            }\n            return OpenResult { ok: true, db: db, error: \"\" }\n        }\n        unsafe { OpenResult { ok: false, db: Self { handle: ptr(0) }, error: \"SQLite requires a native target\" } }\n    }\n\n    pub fn close(&mut self) -> CloseResult {\n        unsafe {\n            if self.handle == ptr(0) { return CloseResult { ok: true, error: \"\" } }\n            code := sql_close(self.handle)\n            if code != 0 { return CloseResult { ok: false, error: failure(self.handle) } }\n            self.handle = ptr(0)\n        }\n        CloseResult { ok: true, error: \"\" }\n    }\n\n    pub fn exec(&self, sql: string, params: &[]string) -> ExecResult {\n        unsafe {\n            prepared := prepare(self.handle, sql, &params)\n            if !prepared.ok { return ExecResult { ok: false, changes: 0, last_id: 0, error: prepared.error } }\n            statement := prepared.statement\n            if statement != ptr(0) {\n                defer { _ := sql_finalize(statement) }\n                mut step := sql_step(statement)\n                while step == 100 { step = sql_step(statement) }\n                if step != 101 { return ExecResult { ok: false, changes: 0, last_id: 0, error: failure(self.handle) } }\n            }\n            return ExecResult { ok: true, changes: sql_changes64(self.handle), last_id: sql_last_insert_rowid(self.handle), error: \"\" }\n        }\n        ExecResult { ok: false, changes: 0, last_id: 0, error: \"SQLite requires a native target\" }\n    }\n\n    // Rows are independent JSON objects. Integers retain all 64 bits, finite\n    // doubles retain their value, and TEXT is decoded using its actual byte\n    // count. BLOB is deliberately rejected; callers must explicitly hex it.\n    pub fn query(&self, sql: string, params: &[]string) -> QueryResult {\n        unsafe {\n            prepared := prepare(self.handle, sql, &params)\n            if !prepared.ok { return QueryResult { ok: false, rows: [], error: prepared.error } }\n            statement := prepared.statement\n            if statement == ptr(0) { return QueryResult { ok: true, rows: [], error: \"\" } }\n            defer { _ := sql_finalize(statement) }\n            if sql_stmt_readonly(statement) == 0 {\n                return QueryResult { ok: false, rows: [], error: \"SQLite query requires a read-only statement; use exec for writes\" }\n            }\n            columns := sql_column_count(statement)\n            mut rows: []string = []\n            mut total: i64 = 0\n            mut step := sql_step(statement)\n            while step == 100 {\n                if rows.len >= 10000 { return QueryResult { ok: false, rows: [], error: \"SQLite query exceeds 10000 rows\" } }\n                mut output: []u8 = []\n                output.push(b'{')\n                for column in 0..columns {\n                    if column > 0 { output.push(b',') }\n                    name := copy_c_string(sql_column_name(statement, column))\n                    json.write_str(&mut output, name)\n                    output.push(b':')\n                    kind := sql_column_type(statement, column)\n                    if kind == 1 {\n                        json.write_i64(&mut output, sql_column_int64(statement, column))\n                    } else if kind == 2 {\n                        value := sql_column_double(statement, column)\n                        if !value.is_finite() { return QueryResult { ok: false, rows: [], error: \"SQLite non-finite REAL cannot be represented as JSON\" } }\n                        spelling := value.str()\n                        bytes.append_utf8(&mut output, spelling)\n                        mut decimal := false\n                        for byte in spelling.bytes() {\n                            if byte == 46 || byte == 69 || byte == 101 { decimal = true }\n                        }\n                        if !decimal { bytes.append_utf8(&mut output, \".0\") }\n                    } else if kind == 3 {\n                        pointer := sql_column_text(statement, column)\n                        length := sql_column_bytes(statement, column)\n                        if length < 0 || length > 16777216 || (length > 0 && pointer == ptr(0)) {\n                            return QueryResult { ok: false, rows: [], error: \"SQLite text exceeds its byte limit\" }\n                        }\n                        mut raw: []u8 = []\n                        raw.reserve(length)\n                        for i in 0..length { raw.push(load_u8(ptr(usize(pointer) + usize(i)))) }\n                        decoded := bytes.decode(&raw)\n                        if !decoded.ok { return QueryResult { ok: false, rows: [], error: \"SQLite TEXT contains invalid UTF-8\" } }\n                        json.write_str(&mut output, decoded.value)\n                    } else if kind == 5 {\n                        json.write_null(&mut output)\n                    } else {\n                        return QueryResult { ok: false, rows: [], error: \"SQLite BLOB requires explicit encoding in the query\" }\n                    }\n                }\n                output.push(b'}')\n                total += i64(output.len)\n                if total > 67108864 { return QueryResult { ok: false, rows: [], error: \"SQLite result exceeds 64 MiB\" } }\n                row := bytes.decode(&output).value\n                rows.push(move row)\n                step = sql_step(statement)\n            }\n            if step != 101 { return QueryResult { ok: false, rows: [], error: failure(self.handle) } }\n            return QueryResult { ok: true, rows: rows, error: \"\" }\n        }\n        QueryResult { ok: false, rows: [], error: \"SQLite requires a native target\" }\n    }\n}\n" }
    if name == "sys" { return "capability unsafe\n// macOS/Linux filesystem API. error is zero on success, otherwise a Dunder code.\n// Known Linux errno values map to the original Darwin-compatible codes below.\n// Unmapped Linux errno values use 10000 + errno; see docs/sys.md.\npub struct Status { ok: bool, error: i32 }\npub struct TextResult { ok: bool, value: string, error: i32 }\npub struct BytesResult { ok: bool, value: []u8, error: i32 }\npub struct Metadata { ok: bool, size: i64, is_file: bool, is_dir: bool, error: i32 }\n\npub fn read_text(path: string) -> TextResult { __sys_read_text(path) }\npub fn read_u8_into(path: string, out: &mut []u8, max_bytes: i64) -> Status { __sys_read_u8(path, &mut out, max_bytes) }\npub fn read_u8_limit(path: string, max_bytes: i64) -> BytesResult {\n    if max_bytes < 0 { return BytesResult { ok: false, value: [], error: 22 } }\n    for attempt in 0..4 {\n        info := metadata(path)\n        if !info.ok { return BytesResult { ok: false, value: [], error: info.error } }\n        if info.is_dir { return BytesResult { ok: false, value: [], error: 21 } }\n        if info.size > max_bytes || info.size > 2147483640 {\n            return BytesResult { ok: false, value: [], error: 27 }\n        }\n        mut buf: []u8 = []\n        buf.reserve(i32(info.size) + 1)\n        st := read_u8_into(path, &mut buf, max_bytes)\n        if st.ok { return BytesResult { ok: true, value: buf, error: 0 } }\n        if st.error != 35 { return BytesResult { ok: false, value: [], error: st.error } }\n    }\n    BytesResult { ok: false, value: [], error: 35 }\n}\npub fn read_u8(path: string) -> BytesResult { read_u8_limit(path, 67108864) }\npub fn write_text(path: string, text: string) -> Status { __sys_write_text(path, text) }\npub fn write_stderr(text: string) -> Status { __sys_write_stderr(text) }\npub fn eprint(text: string) -> Status { write_stderr(text + \"\\n\") }\npub fn append_text(path: string, text: string) -> Status { __sys_append_text(path, text) }\npub fn mkdir(path: string) -> Status { __sys_mkdir(path) }\npub fn rename(from: string, to: string) -> Status { __sys_rename(from, to) }\npub fn remove_file(path: string) -> Status { __sys_remove_file(path) }\npub fn remove_dir(path: string) -> Status { __sys_remove_dir(path) }\npub fn metadata(path: string) -> Metadata { __sys_metadata(path) }\npub fn pid() -> i32 { __sys_pid() }\npub fn now_ms() -> i64 { __sys_now_ms() }\npub fn sleep_ms(ms: i64) {\n    if ms <= 0 { return }\n    mut empty: []u8 = []\n    _ := net_poll(&mut empty, 0, ms)\n}\npub fn arg_count() -> i32 { __sys_arg_count() }\npub fn arg(index: i32) -> string { __sys_arg(index) }\npub unsafe fn envp() -> ptr { __sys_envp() }\npub unsafe fn linux_syscall(nr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 { __sys_linux_syscall(nr, a0, a1, a2, a3, a4, a5) }\npub fn write_bytes(path: string, bytes: &[]i32) -> Status { __sys_write_bytes(path, &bytes) }\npub fn make_executable(path: string) -> Status { __sys_make_executable(path) }\npub fn write_u8(path: string, bytes: &[]u8) -> Status { __sys_write_u8(path, &bytes) }\npub fn decode_u8(bytes: &[]u8) -> TextResult { __sys_decode_u8(&bytes) }\npub fn decode_u8_range(bytes: &[]u8, start: i64, length: i64) -> TextResult { __sys_decode_u8_range(&bytes, start, length) }\npub fn decode_utf8(bytes: &[]i32) -> TextResult { __sys_decode_utf8(&bytes) }\npub fn same_file(first: string, second: string) -> bool { __sys_same_file(first, second) }\npub fn net_listen(ipv4: i64, port: i64, backlog: i64) -> i64 { __sys_net_listen(ipv4, port, backlog) }\npub fn net_accept(listen_fd: i32) -> i64 { __sys_net_accept(listen_fd) }\npub fn net_connect(ipv4: i64, port: i64) -> i64 { __sys_net_connect(ipv4, port) }\npub fn net_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_read(fd, &mut out, max_bytes) }\npub fn net_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 { __sys_net_write(fd, &data, offset, length) }\npub fn net_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 { __sys_net_poll(&mut fds, nfds, timeout_ms) }\npub fn net_set_nonblocking(fd: i32, enabled: bool) -> i64 { __sys_net_set_nonblocking(fd, enabled) }\npub fn net_set_nodelay(fd: i32, enabled: bool) -> i64 { __sys_net_set_nodelay(fd, enabled) }\npub fn net_local_port(fd: i32) -> i64 { __sys_net_local_port(fd) }\npub fn net_shutdown_write(fd: i32) -> i64 { __sys_net_shutdown_write(fd) }\npub fn net_close(fd: i32) -> i64 { __sys_net_close(fd) }\n\n@test {\n    (0) -> \"ok\"\n    (2) -> \"no such file or directory\"\n    (92) -> \"invalid UTF-8\"\n    (12345) -> \"OS error 12345\"\n}\npub fn error_message(error: i32) -> string {\n    if error == 0 { return \"ok\" }\n    if error == 2 { return \"no such file or directory\" }\n    if error == 5 { return \"I/O error\" }\n    if error == 9 { return \"bad file descriptor\" }\n    if error == 12 { return \"out of memory\" }\n    if error == 13 { return \"permission denied\" }\n    if error == 17 { return \"already exists\" }\n    if error == 20 { return \"not a directory\" }\n    if error == 21 { return \"is a directory\" }\n    if error == 22 { return \"invalid argument\" }\n    if error == 27 { return \"file too large\" }\n    if error == 32 { return \"broken pipe\" }\n    if error == 35 { return \"temporarily unavailable\" }\n    if error == 36 { return \"operation in progress\" }\n    if error == 45 { return \"not supported\" }\n    if error == 48 { return \"address already in use\" }\n    if error == 53 { return \"connection aborted\" }\n    if error == 54 { return \"connection reset\" }\n    if error == 60 { return \"timed out\" }\n    if error == 61 { return \"connection refused\" }\n    if error == 63 { return \"path too long\" }\n    if error == 66 { return \"directory not empty\" }\n    if error == 92 { return \"invalid UTF-8\" }\n    \"OS error \" + error.str()\n}\n\npub enum FileKind { Other = 0, File = 1, Directory = 2 }\npub enum IoError {\n    Other(i32) = 0,\n    NotFound = 2,\n    BadDescriptor = 9,\n    OutOfMemory = 12,\n    PermissionDenied = 13,\n    AlreadyExists = 17,\n    NotDirectory = 20,\n    IsDirectory = 21,\n    InvalidArgument = 22,\n    TooLarge = 27,\n    BrokenPipe = 32,\n    Changed = 35,\n    InProgress = 36,\n    Unsupported = 45,\n    AddressInUse = 48,\n    ConnectionAborted = 53,\n    ConnectionReset = 54,\n    TimedOut = 60,\n    ConnectionRefused = 61,\n    NameTooLong = 63,\n    NotEmpty = 66,\n    InvalidUtf8 = 92,\n}\npub enum ReadResult { Ok(string), Err(IoError) }\n\npub fn read(path: string) -> ReadResult {\n    result := read_text(path)\n    if result.ok { .Ok(result.value) }\n    else { .Err(error_from_code(result.error)) }\n}\n\npub fn file_kind(info: Metadata) -> FileKind { info.kind() }\n\nimpl Metadata {\n    pub fn kind(&self) -> FileKind {\n        if self.is_file { .File }\n        else if self.is_dir { .Directory }\n        else { .Other }\n    }\n}\n\nimpl IoError {\n    pub fn from_code(error: i32) -> Self {\n        if error == 2 { return .NotFound }\n        if error == 9 { return .BadDescriptor }\n        if error == 12 { return .OutOfMemory }\n        if error == 13 { return .PermissionDenied }\n        if error == 17 { return .AlreadyExists }\n        if error == 20 { return .NotDirectory }\n        if error == 21 { return .IsDirectory }\n        if error == 22 { return .InvalidArgument }\n        if error == 27 { return .TooLarge }\n        if error == 32 { return .BrokenPipe }\n        if error == 35 { return .Changed }\n        if error == 36 { return .InProgress }\n        if error == 45 { return .Unsupported }\n        if error == 48 { return .AddressInUse }\n        if error == 53 { return .ConnectionAborted }\n        if error == 54 { return .ConnectionReset }\n        if error == 60 { return .TimedOut }\n        if error == 61 { return .ConnectionRefused }\n        if error == 63 { return .NameTooLong }\n        if error == 66 { return .NotEmpty }\n        if error == 92 { return .InvalidUtf8 }\n        .Other(error)\n    }\n\n    pub fn code(&self) -> i32 {\n        match self {\n            .NotFound => 2,\n            .BadDescriptor => 9,\n            .OutOfMemory => 12,\n            .PermissionDenied => 13,\n            .AlreadyExists => 17,\n            .NotDirectory => 20,\n            .IsDirectory => 21,\n            .InvalidArgument => 22,\n            .TooLarge => 27,\n            .BrokenPipe => 32,\n            .Changed => 35,\n            .InProgress => 36,\n            .Unsupported => 45,\n            .AddressInUse => 48,\n            .ConnectionAborted => 53,\n            .ConnectionReset => 54,\n            .TimedOut => 60,\n            .ConnectionRefused => 61,\n            .NameTooLong => 63,\n            .NotEmpty => 66,\n            .InvalidUtf8 => 92,\n            .Other(code) => code,\n        }\n    }\n\n    pub fn message(&self) -> string { error_message(self.code()) }\n}\n\npub fn error_from_code(error: i32) -> IoError { IoError::from_code(error) }\n\n@test {\n    (.NotFound) -> 2\n    (.InvalidUtf8) -> 92\n    (.ConnectionReset) -> 54\n    (.Other(12345)) -> 12345\n    IoError::from_code(63).code() == 63\n    IoError::from_code(48).code() == 48\n    IoError::from_code(54321).code() == 54321\n    error_code(error_from_code(63)) == 63\n    error_code(error_from_code(48)) == 48\n    error_code(error_from_code(54321)) == 54321\n}\npub fn error_code(error: IoError) -> i32 { error.code() }\n\npub fn io_error_message(error: IoError) -> string { error.message() }\n" }
    if name == "text" { return "pub fn starts_with(text: string, prefix: string) -> bool {\n    if prefix.len > text.len { return false }\n    for i in 0..prefix.len { if text[i] != prefix[i] { return false } }\n    true\n}\npub fn ends_with(text: string, suffix: string) -> bool {\n    if suffix.len > text.len { return false }\n    start := text.len - suffix.len\n    for i in 0..suffix.len { if text[start + i] != suffix[i] { return false } }\n    true\n}\npub fn find(text: string, needle: string) -> i32 {\n    if needle.len == 0 { return 0 }\n    mut start := 0\n    while start + needle.len <= text.len {\n        mut i := 0\n        while i < needle.len && text[start + i] == needle[i] { i = i + 1 }\n        if i == needle.len { return start }\n        start = start + 1\n    }\n    -1\n}\npub fn split(text: string, separator: string) -> []string {\n    mut parts: []string = []\n    if separator.len == 0 { parts.push(text.clone()); return parts }\n    mut start := 0\n    mut cursor := 0\n    while cursor + separator.len <= text.len {\n        mut i := 0\n        while i < separator.len && text[cursor + i] == separator[i] { i = i + 1 }\n        if i == separator.len {\n            parts.push(text[start..cursor])\n            cursor = cursor + separator.len\n            start = cursor\n        } else { cursor = cursor + 1 }\n    }\n    if start == 0 { parts.push(text.clone()) }\n    else if start == text.len { parts.push(\"\") }\n    else { parts.push(text[start..text.len]) }\n    parts\n}\nfn whitespace(byte: i32) -> bool { byte == 32 || byte == 9 || byte == 10 || byte == 13 }\npub fn trim(text: string) -> string {\n    mut start := 0\n    mut end := text.len\n    while start < end && whitespace(text[start]) { start = start + 1 }\n    while end > start && whitespace(text[end - 1]) { end = end - 1 }\n    if start == 0 && end == text.len { return text.clone() }\n    if start == end { return \"\" }\n    text[start..end]\n}\n@test fn text_search_and_split_handle_utf8_and_empty_parts() {\n    starts_with(\"åäö 🌍\", \"å\")\n    ends_with(\"åäö 🌍\", \"🌍\")\n    find(\"åäö 🌍\", \"🌍\") == 7\n    find(\"åäö 🌍\", \"missing\") == -1\n    parts := split(\"å::🌍::::\", \"::\")\n    parts.len == 4\n    parts[0] == \"å\"\n    parts[1] == \"🌍\"\n    parts[2] == \"\"\n    parts[3] == \"\"\n    trim(\" \\t å 🌍 \\r\\n\") == \"å 🌍\"\n    split(\"\", \"\").len == 1\n}\n" }
    if name == "wire" { return "// Compact binary wire codec over []u8. Zero heap allocations during encoding,\n// explicit bounds checking during decoding, portable across native and wasm32.\nimport std.bytes as bytes\nimport sys\n\npub struct Reader {\n    pos: i32,\n    ok: bool,\n    error: i32, // 0=ok, 1=truncated, 2=overflow/varint, 92=invalid UTF-8\n}\n\nimpl Reader {\n    pub fn new() -> Self { Self { pos: 0, ok: true, error: 0 } }\n\n    pub fn remaining(&self, buf: &[]u8) -> i32 {\n        if !self.ok || self.pos > buf.len { return 0 }\n        buf.len - self.pos\n    }\n\n    pub fn finish(&self, buf: &[]u8) -> bool {\n        self.ok && self.pos == buf.len\n    }\n\n    fn fail_read(&mut self, err: i32) {\n        if self.ok { self.ok = false; self.error = err }\n    }\n\n    pub fn read_u8(&mut self, buf: &[]u8) -> u8 {\n        if !self.ok { return 0 }\n        if self.pos >= buf.len { self.fail_read(1); return 0 }\n        b := buf[self.pos]\n        self.pos += 1\n        b\n    }\n\n    pub fn read_bool(&mut self, buf: &[]u8) -> bool {\n        b := self.read_u8(&buf)\n        if !self.ok { return false }\n        if b == 0 { return false }\n        if b == 1 { return true }\n        self.fail_read(2)\n        false\n    }\n\n    pub fn read_u16_le(&mut self, buf: &[]u8) -> u16 {\n        if !self.ok { return 0 }\n        if self.pos + 2 > buf.len { self.fail_read(1); return 0 }\n        v := u16(bytes.u16_le(&buf, self.pos))\n        self.pos += 2\n        v\n    }\n\n    pub fn read_i32_le(&mut self, buf: &[]u8) -> i32 {\n        if !self.ok { return 0 }\n        if self.pos + 4 > buf.len { self.fail_read(1); return 0 }\n        raw := bytes.u32_le(&buf, self.pos)\n        self.pos += 4\n        if raw >= 2147483648 { return i32(raw - 4294967296) }\n        i32(raw)\n    }\n\n    pub fn read_u32_le(&mut self, buf: &[]u8) -> u32 {\n        if !self.ok { return 0 }\n        if self.pos + 4 > buf.len { self.fail_read(1); return 0 }\n        raw := bytes.u32_le(&buf, self.pos)\n        self.pos += 4\n        u32(raw)\n    }\n\n    pub fn read_i64_le(&mut self, buf: &[]u8) -> i64 {\n        if !self.ok { return 0 }\n        if self.pos + 8 > buf.len { self.fail_read(1); return 0 }\n        v := bytes.i64_le(&buf, self.pos)\n        self.pos += 8\n        v\n    }\n\n    pub fn read_u64_le(&mut self, buf: &[]u8) -> u64 {\n        if !self.ok { return 0 }\n        if self.pos + 8 > buf.len { self.fail_read(1); return 0 }\n        v := bytes.u64_le(&buf, self.pos)\n        self.pos += 8\n        v\n    }\n\n    pub fn read_f32(&mut self, buf: &[]u8) -> f32 {\n        bits := self.read_i32_le(&buf)\n        if !self.ok { return 0.0 }\n        f32.from_bits(bits)\n    }\n\n    pub fn read_f64(&mut self, buf: &[]u8) -> f64 {\n        bits := self.read_i64_le(&buf)\n        if !self.ok { return 0.0 }\n        f64.from_bits(bits)\n    }\n\n    pub fn read_uvarint(&mut self, buf: &[]u8) -> u64 {\n        if !self.ok { return 0 }\n        mut result: u64 = 0\n        mut shift := 0\n        for i in 0..10 {\n            if self.pos >= buf.len { self.fail_read(1); return 0 }\n            b := buf[self.pos]\n            self.pos += 1\n            if i == 9 && b > 1 { self.fail_read(2); return 0 }\n            result = result.bit_or(u64(b.bit_and(127)).shl(shift))\n            if b < 128 { return result }\n            shift += 7\n        }\n        self.fail_read(2)\n        0\n    }\n\n    pub fn read_varint(&mut self, buf: &[]u8) -> i64 {\n        zz := self.read_uvarint(&buf)\n        if !self.ok { return 0 }\n        half := zz.shr(1)\n        if zz.bit_and(1) != 0 {\n            return -i64(half) - 1\n        }\n        i64(half)\n    }\n\n    pub fn read_bytes(&mut self, buf: &[]u8) -> []u8 {\n        if !self.ok { return [] }\n        n := self.read_uvarint(&buf)\n        if !self.ok { return [] }\n        if n > u64(buf.len - self.pos) { self.fail_read(1); return [] }\n        count := i32(n)\n        mut out: []u8 = []\n        bytes.extend_range(&mut out, &buf, self.pos, self.pos + count)\n        self.pos += count\n        out\n    }\n\n    pub fn read_str(&mut self, buf: &[]u8) -> string {\n        if !self.ok { return \"\" }\n        n := self.read_uvarint(&buf)\n        if !self.ok { return \"\" }\n        if n > u64(buf.len - self.pos) { self.fail_read(1); return \"\" }\n        count := i32(n)\n        dec := bytes.decode_range(&buf, self.pos, self.pos + count)\n        if !dec.ok { self.fail_read(92); return \"\" }\n        self.pos += count\n        dec.value\n    }\n}\n\npub fn put_u8(out: &mut []u8, v: u8) { out.push(v) }\n\npub fn put_bool(out: &mut []u8, v: bool) {\n    if v { out.push(1) } else { out.push(0) }\n}\n\npub fn put_u16_le(out: &mut []u8, v: u16) {\n    bytes.append_le(&mut out, i64(v), 2)\n}\n\npub fn put_i32_le(out: &mut []u8, v: i32) {\n    bytes.append_le(&mut out, i64(v), 4)\n}\n\npub fn put_u32_le(out: &mut []u8, v: u32) {\n    bytes.append_le(&mut out, i64(v), 4)\n}\n\npub fn put_i64_le(out: &mut []u8, v: i64) {\n    bytes.append_le(&mut out, v, 8)\n}\n\npub fn put_u64_le(out: &mut []u8, v: u64) {\n    for i in 0..8 {\n        out.push(u8(v.shr(i * 8).bit_and(255)))\n    }\n}\n\npub fn put_f32(out: &mut []u8, v: f32) {\n    bits := v.to_bits()\n    bytes.append_le(&mut out, i64(bits), 4)\n}\n\npub fn put_f64(out: &mut []u8, v: f64) {\n    bits := v.to_bits()\n    bytes.append_le(&mut out, bits, 8)\n}\n\n// Unsigned LEB128 varint (1..10 bytes).\npub fn put_uvarint(out: &mut []u8, value: u64) {\n    mut v := value\n    while v >= 128 {\n        out.push(u8(v.bit_and(127).bit_or(128)))\n        v = v.shr(7)\n    }\n    out.push(u8(v))\n}\n\n// ZigZag-encoded signed varint so small negative and positive numbers take 1 byte.\npub fn put_varint(out: &mut []u8, value: i64) {\n    mut zz: u64 = 0\n    if value < 0 {\n        // (-value - 1) * 2 + 1 without signed overflow on i64::MIN\n        zz = u64(-(value + 1)).shl(1).bit_or(1)\n    } else {\n        zz = u64(value).shl(1)\n    }\n    put_uvarint(&mut out, zz)\n}\n\npub fn put_bytes(out: &mut []u8, data: &[]u8) {\n    put_uvarint(&mut out, u64(data.len))\n    bytes.extend(&mut out, &data)\n}\n\npub fn put_str(out: &mut []u8, text: string) {\n    put_uvarint(&mut out, u64(text.len))\n    bytes.append_utf8(&mut out, text)\n}\n\n@test\nfn wire_reader_methods_round_trip() {\n    mut buf: []u8 = []\n    put_varint(&mut buf, -7)\n    put_str(&mut buf, \"hi\")\n    mut r := Reader::new()\n    assert(r.remaining(&buf) > 0)\n    assert(r.read_varint(&buf) == -7)\n    assert(r.read_str(&buf) == \"hi\")\n    assert(r.finish(&buf))\n}\n\n@test\nfn wire_round_trips_scalars_strings_extremes_and_rejects_truncation() {\n    mut buf: []u8 = []\n    put_bool(&mut buf, true)\n    put_bool(&mut buf, false)\n    put_i32_le(&mut buf, -2147483648)\n    put_u32_le(&mut buf, 4294967295)\n    put_i64_le(&mut buf, -9223372036854775808)\n    put_u64_le(&mut buf, 18446744073709551615)\n    put_varint(&mut buf, 0)\n    put_varint(&mut buf, -1)\n    put_varint(&mut buf, 42)\n    put_varint(&mut buf, -9223372036854775808)\n    put_varint(&mut buf, 9223372036854775807)\n    put_f64(&mut buf, -3.5)\n    put_str(&mut buf, \"dunder åäö 🌍\")\n    mut raw: []u8 = [0, 255, 17]\n    put_bytes(&mut buf, &raw)\n\n    mut r := Reader::new()\n    assert(r.read_bool(&buf))\n    assert(!r.read_bool(&buf))\n    assert(r.read_i32_le(&buf) == -2147483648)\n    assert(r.read_u32_le(&buf) == 4294967295)\n    assert(r.read_i64_le(&buf) == -9223372036854775808)\n    assert(r.read_u64_le(&buf) == 18446744073709551615)\n    assert(r.read_varint(&buf) == 0)\n    assert(r.read_varint(&buf) == -1)\n    assert(r.read_varint(&buf) == 42)\n    assert(r.read_varint(&buf) == -9223372036854775808)\n    assert(r.read_varint(&buf) == 9223372036854775807)\n    assert(r.read_f64(&buf) == -3.5)\n    assert(r.read_str(&buf) == \"dunder åäö 🌍\")\n    got := r.read_bytes(&buf)\n    assert(got.len == 3 && got[0] == 0 && got[1] == 255 && got[2] == 17)\n    assert(r.finish(&buf))\n\n    // Extra read past end marks truncated error without trapping.\n    _ := r.read_u8(&buf)\n    assert(!r.ok && r.error == 1)\n}\n" }
    ""
}

pub fn contains(name: string) -> bool {
    if name == "array" { return true }
    if name == "bytes" { return true }
    if name == "dl" { return true }
    if name == "fs" { return true }
    if name == "hash" { return true }
    if name == "http" { return true }
    if name == "http_client" { return true }
    if name == "json" { return true }
    if name == "map" { return true }
    if name == "net" { return true }
    if name == "parse" { return true }
    if name == "process" { return true }
    if name == "set" { return true }
    if name == "sha256" { return true }
    if name == "sqlite" { return true }
    if name == "sys" { return true }
    if name == "text" { return true }
    if name == "wire" { return true }
    false
}

pub fn float_formatter() -> string { "// Shortest round-trip decimal formatting from IEEE bits, written in Dunder.\n// Exact decimal integers describe the value and its rounding interval.\n// Try increasing significant-digit counts; accept a decimal only inside\n// that interval, including midpoint ties only for an even significand.\npub fn format_float_bits(raw: i64, single: bool) -> string {\n    mut bits := raw\n    mut negative := false\n    mut unit: i64 = 4503599627370496\n    mut bias := 1023\n    mut fraction_bits := 52\n    mut exponent_limit := 2047\n    mut precision := 17\n    if single {\n        unit = 8388608\n        bias = 127\n        fraction_bits = 23\n        exponent_limit = 255\n        precision = 9\n        if bits >= 2147483648 { negative = true; bits = bits - 2147483648 }\n    } else if bits < 0 {\n        negative = true\n        bits = bits - i64(-9223372036854775808)\n    }\n    mut sign := \"\"\n    if negative { sign = \"-\" }\n    exponent_field := i32(bits / unit)\n    if exponent_field == exponent_limit {\n        if bits % unit != 0 { return \"nan\" }\n        return sign + \"inf\"\n    }\n    if bits == 0 { return sign + \"0.0\" }\n    mut mantissa := bits % unit\n    mut exponent := 1 - bias - fraction_bits\n    if exponent_field != 0 {\n        mantissa = mantissa + unit\n        exponent = exponent_field - bias - fraction_bits\n    }\n    even := mantissa % 2 == 0\n    mut digits := [0; 2400]\n    mut sizes := [0; 3]\n    mut scales := [0; 3]\n    for variant in 0..3 {\n        mut coefficient := mantissa\n        mut power := exponent\n        if variant == 1 {\n            coefficient = mantissa * 2 - 1\n            power = exponent - 1\n            if mantissa == unit && exponent_field > 1 {\n                coefficient = mantissa * 4 - 1\n                power = exponent - 2\n            }\n        }\n        if variant == 2 { coefficient = mantissa * 2 + 1; power = exponent - 1 }\n        base := variant * 800\n        mut size := 0\n        while coefficient != 0 {\n            digits[base + size] = i32(coefficient % 10)\n            coefficient = coefficient / 10\n            size = size + 1\n        }\n        mut factor := 2\n        mut steps := power\n        if power < 0 { factor = 5; steps = -power; scales[variant] = -power }\n        for step in 0..steps {\n            mut carry := 0\n            for j in 0..size {\n                next := digits[base + j] * factor + carry\n                digits[base + j] = next % 10\n                carry = next / 10\n            }\n            if carry != 0 { digits[base + size] = carry; size = size + 1 }\n        }\n        sizes[variant] = size\n    }\n    mut prefix: i64 = 0\n    mut chosen: i64 = 0\n    mut decimal_power := 0\n    mut found := false\n    for count in 1..precision + 1 {\n        value_index := sizes[0] - count\n        mut digit := 0\n        if value_index >= 0 { digit = digits[value_index] }\n        prefix = prefix * 10 + i64(digit)\n        mut round_up := false\n        if value_index > 0 {\n            next := digits[value_index - 1]\n            mut tail := false\n            for j in 0..value_index - 1 { if digits[j] != 0 { tail = true } }\n            round_up = next > 5 || (next == 5 && (tail || prefix % 2 != 0))\n        }\n        power := sizes[0] - scales[0] - count\n        for attempt in 0..2 {\n            mut candidate := prefix\n            if (attempt == 0 && round_up) || (attempt == 1 && !round_up) { candidate = candidate + 1 }\n            spelling := candidate.str()\n            mut accepted := true\n            for boundary in 1..3 {\n                order := spelling.len + power\n                bound_order := sizes[boundary] - scales[boundary]\n                mut comparison := 0\n                if order < bound_order { comparison = -1 }\n                if order > bound_order { comparison = 1 }\n                if order == bound_order {\n                    mut length := sizes[boundary]\n                    if spelling.len > length { length = spelling.len }\n                    for j in 0..length {\n                        mut a := 0\n                        mut b := 0\n                        if j < spelling.len { a = spelling[j] - 48 }\n                        if j < sizes[boundary] { b = digits[boundary * 800 + sizes[boundary] - 1 - j] }\n                        if a < b { comparison = -1; break }\n                        if a > b { comparison = 1; break }\n                    }\n                }\n                if boundary == 1 && (comparison < 0 || (comparison == 0 && !even)) { accepted = false }\n                if boundary == 2 && (comparison > 0 || (comparison == 0 && !even)) { accepted = false }\n            }\n            if accepted { chosen = candidate; decimal_power = power; found = true; break }\n        }\n        if found { break }\n    }\n    assert(found)\n    while chosen % 10 == 0 { chosen = chosen / 10; decimal_power = decimal_power + 1 }\n    spelling := chosen.str()\n    order := spelling.len + decimal_power - 1\n    if order < -4 || order >= 16 {\n        mut result := sign + spelling[0..1]\n        if spelling.len > 1 { result = result + \".\" + spelling[1..spelling.len] }\n        result = result + \"e\"\n        if order >= 0 { result = result + \"+\" }\n        return result + order.str()\n    }\n    if decimal_power >= 0 {\n        mut result := sign + spelling\n        for i in 0..decimal_power { result = result + \"0\" }\n        return result + \".0\"\n    }\n    point := spelling.len + decimal_power\n    if point > 0 { return sign + spelling[0..point] + \".\" + spelling[point..spelling.len] }\n    mut result := sign + \"0.\"\n    for i in 0..-point { result = result + \"0\" }\n    result + spelling\n}\n" }
