pub fn source(name: string) -> string {
    if name == "array" { return "pub fn ints() -> []i64 { [] }\npub fn strings() -> []string { [] }\npub fn sum(values: &[]i64) -> i64 {\n    mut result: i64 = 0\n    for value in &values { result += value }\n    result\n}\npub fn reverse(values: &mut []i64) {\n    mut left := 0\n    mut right := values.len - 1\n    while left < right {\n        values.swap(left, right)\n        left += 1\n        right -= 1\n    }\n}\nfn sift_ints(values: &mut []i64, start: i32, end: i32) {\n    mut root := start\n    while root < end / 2 {\n        mut child := root * 2 + 1\n        if child + 1 < end && values[child] < values[child + 1] { child += 1 }\n        if values[root] >= values[child] { return }\n        values.swap(root, child)\n        root = child\n    }\n}\npub fn sort(values: &mut []i64) {\n    mut start := values.len / 2\n    while start > 0 {\n        start -= 1\n        sift_ints(&mut values, start, values.len)\n    }\n    mut end := values.len - 1\n    while end > 0 {\n        values.swap(0, end)\n        sift_ints(&mut values, 0, end)\n        end -= 1\n    }\n}\nfn sift_strings(values: &mut []string, start: i32, end: i32) {\n    mut root := start\n    while root < end / 2 {\n        mut child := root * 2 + 1\n        if child + 1 < end && values[child] < values[child + 1] { child += 1 }\n        if values[root] >= values[child] { return }\n        values.swap(root, child)\n        root = child\n    }\n}\npub fn sort_strings(values: &mut []string) {\n    mut start := values.len / 2\n    while start > 0 {\n        start -= 1\n        sift_strings(&mut values, start, values.len)\n    }\n    mut end := values.len - 1\n    while end > 0 {\n        values.swap(0, end)\n        sift_strings(&mut values, 0, end)\n        end -= 1\n    }\n}\npub fn append(values: &mut []i64, extra: &[]i64) {\n    values.reserve(values.len + extra.len)\n    for value in &extra { values.push(value) }\n}\n@test fn dynamic_algorithms_preserve_independent_values() {\n    mut values: []i64 = [3, -1, 9, 0, 3]\n    copy := values.clone()\n    sort(&mut values)\n    values[0] == -1\n    values[4] == 9\n    reverse(&mut values)\n    values[0] == 9\n    sum(&values) == 14\n    append(&mut values, &copy)\n    values.len == 10\n    sum(&values) == 28\n    copy[0] == 3\n}\n@test fn string_sort_handles_empty_values_unicode_duplicates_and_copies() {\n    mut values: []string = [\"🌍\", \"å\", \"\", \"a\", \"a\", \"\\0\", \"ä\"]\n    original := values.clone()\n    sort_strings(&mut values)\n    values[0] == \"\"\n    values[1] == \"\\0\"\n    values[2] == \"a\"\n    values[3] == \"a\"\n    values[4] == \"ä\"\n    values[5] == \"å\"\n    values[6] == \"🌍\"\n    original[0] == \"🌍\"\n    mut empty: []string = []\n    sort_strings(&mut empty)\n    empty.len == 0\n    mut one: []string = [\"one\"]\n    sort_strings(&mut one)\n    one[0] == \"one\"\n}\n\n@test fn integer_sort_handles_boundaries_duplicates_and_input_order() {\n    mut empty: []i64 = []\n    sort(&mut empty)\n    assert(empty.len == 0)\n    mut one: []i64 = [-9223372036854775808]\n    sort(&mut one)\n    assert(one.len == 1 && one[0] == -9223372036854775808)\n\n    mut values: []i64 = [9223372036854775807, 0, -1, -9223372036854775808, 1, 0]\n    expected: []i64 = [-9223372036854775808, -1, 0, 0, 1, 9223372036854775807]\n    sort(&mut values)\n    for i in 0..expected.len { assert(values[i] == expected[i]) }\n    sort(&mut values)\n    for i in 0..expected.len { assert(values[i] == expected[i]) }\n\n    mut descending: []i64 = []\n    for i in 0..4097 { descending.push(i64(2048 - i)) }\n    sort(&mut descending)\n    for i in 0..descending.len { assert(descending[i] == i64(i - 2048)) }\n\n    mut equal: []i64 = []\n    for i in 0..257 { equal.push(-7) }\n    sort(&mut equal)\n    assert(equal.len == 257)\n    for value in equal { assert(value == -7) }\n}\n" }
    if name == "bytes" { return "capability unsafe\n\nimport sys\npub fn packed() -> []u8 { [] }\npub fn append_utf8(output: &mut []u8, text: string) {\n    sys.bytes_append_text(&mut output, text)\n}\npub fn extend(output: &mut []u8, input: &[]u8) {\n    sys.bytes_extend(&mut output, &input, 0, input.len)\n}\npub unsafe fn copy_memory(destination: ptr, source: ptr, count: usize) { sys.memory_copy(destination, source, count) }\npub unsafe fn equal_memory(lhs: ptr, rhs: ptr, count: usize) -> bool { sys.memory_equal(lhs, rhs, count) }\npub fn equal(lhs: &[]u8, rhs: &[]u8) -> bool {\n    if lhs.len != rhs.len { return false }\n    if lhs.len == 0 { return true }\n    unsafe { equal_memory(addr(&lhs[0]), addr(&rhs[0]), usize(lhs.len)) }\n}\npub fn equal_ranges(lhs: &[]u8, lstart: i32, lend: i32, rhs: &[]u8, rstart: i32, rend: i32) -> bool {\n    if lstart < 0 || lend < lstart || lend > lhs.len || rstart < 0 || rend < rstart || rend > rhs.len { return false }\n    count := lend - lstart\n    if count != rend - rstart { return false }\n    if count == 0 { return true }\n    unsafe { equal_memory(addr(&lhs[lstart]), addr(&rhs[rstart]), usize(count)) }\n}\npub fn pad(output: &mut []u8, count: i32) {\n    assert(count >= 0)\n    output.reserve(output.len + count)\n    for i in 0..count { output.push(0) }\n}\npub fn append_le(output: &mut []u8, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8)\n    for i in 0..width { output.push(u8(value.shr(i * 8).bit_and(255))) }\n}\npub fn append_be(output: &mut []u8, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8)\n    for i in 0..width { output.push(u8(value.shr((width - 1 - i) * 8).bit_and(255))) }\n}\npub fn set_be(output: &mut []u8, offset: i32, value: i64, width: i32) {\n    assert(width >= 1 && width <= 8 && offset >= 0 && offset <= output.len - width)\n    for i in 0..width { output[offset + width - 1 - i] = u8(value.shr(i * 8).bit_and(255)) }\n}\npub fn decode(input: &[]u8) -> sys.TextResult { sys.decode_u8(&input) }\npub fn decode_range(input: &[]u8, start: i32, end: i32) -> sys.TextResult {\n    if start < 0 || end < start || end > input.len {\n        return sys.TextResult { ok: false, value: \"\", error: 22 }\n    }\n    sys.decode_u8_range(&input, i64(start), i64(end - start))\n}\npub fn find_byte(input: &[]u8, start: i32, end: i32, needle: u8) -> i32 {\n    mut from := start\n    if from < 0 { from = 0 }\n    mut limit := end\n    if limit > input.len { limit = input.len }\n    if from >= limit { return -1 }\n    for i in from..limit {\n        if input[i] == needle { return i }\n    }\n    -1\n}\npub fn find_crlf(input: &[]u8, start: i32, end: i32) -> i32 {\n    mut from := start\n    if from < 0 { from = 0 }\n    mut limit := end\n    if limit > input.len { limit = input.len }\n    if limit - from < 2 { return -1 }\n    for i in from..(limit - 1) {\n        if input[i] == b'\\r' && input[i + 1] == b'\\n' { return i }\n    }\n    -1\n}\npub fn find_double_crlf(input: &[]u8, start: i32, end: i32) -> i32 {\n    mut from := start\n    if from < 0 { from = 0 }\n    mut limit := end\n    if limit > input.len { limit = input.len }\n    if limit - from < 4 { return -1 }\n    for i in from..(limit - 3) {\n        if input[i] == b'\\r' && input[i + 1] == b'\\n' && input[i + 2] == b'\\r' && input[i + 3] == b'\\n' {\n            return i\n        }\n    }\n    -1\n}\npub fn equals_text(input: &[]u8, start: i32, end: i32, expected: string) -> bool {\n    if start < 0 || end < start || end > input.len || end - start != expected.len { return false }\n    for i in 0..expected.len {\n        if i32(input[start + i]) != expected[i] { return false }\n    }\n    true\n}\npub fn equals_ascii_ci(input: &[]u8, start: i32, end: i32, expected_lower: string) -> bool {\n    if start < 0 || end < start || end > input.len || end - start != expected_lower.len { return false }\n    for i in 0..expected_lower.len {\n        mut b := i32(input[start + i])\n        if b >= 65 && b <= 90 { b += 32 }\n        if b != expected_lower[i] { return false }\n    }\n    true\n}\npub fn extend_range(output: &mut []u8, input: &[]u8, start: i32, end: i32) {\n    assert(start >= 0 && start <= end && end <= input.len)\n    sys.bytes_extend(&mut output, &input, start, end)\n}\npub fn consume_prefix(buf: &mut []u8, count: i32) {\n    if count <= 0 { return }\n    if count >= buf.len { buf.clear(); return }\n    remaining := buf.len - count\n    for i in 0..remaining { buf[i] = buf[i + count] }\n    for i in 0..count { _ := buf.pop() }\n}\npub fn append_decimal(output: &mut []u8, value: i64) {\n    if value == 0 { output.push(b'0'); return }\n    mut v := value\n    if v < 0 { output.push(b'-') }\n    start := output.len\n    while v != 0 {\n        mut d := v % 10\n        if d < 0 { d = -d }\n        output.push(u8(48 + i32(d)))\n        v /= 10\n    }\n    mut left := start\n    mut right := output.len - 1\n    while left < right {\n        output.swap(left, right)\n        left += 1\n        right -= 1\n    }\n}\n\npub fn hex_u8(input: &[]u8) -> string {\n    digits := \"0123456789abcdef\"\n    mut output: []u8 = []\n    output.reserve(input.len * 2)\n    for b in &input {\n        val := i32(b)\n        output.push(u8(digits[val / 16]))\n        output.push(u8(digits[val % 16]))\n    }\n    result := decode(&output)\n    assert(result.ok)\n    result.value\n}\npub fn u16_le(input: &[]u8, offset: i32) -> i32 {\n    assert(offset >= 0 && offset <= input.len - 2)\n    i32(input[offset]).bit_or(i32(input[offset + 1]).shl(8))\n}\npub fn u32_le(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 4)\n    a := i64(input[offset]).bit_or(i64(input[offset + 1]).shl(8))\n    b := i64(input[offset + 2]).shl(16).bit_or(i64(input[offset + 3]).shl(24))\n    a.bit_or(b)\n}\npub fn i64_le(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: i64 = 0\n    for i in 0..8 {\n        v = v.bit_or(i64(input[offset + i]).shl(i * 8))\n    }\n    v\n}\npub fn u64_le(input: &[]u8, offset: i32) -> u64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: u64 = 0\n    for i in 0..8 {\n        v = v.bit_or(u64(input[offset + i]).shl(i * 8))\n    }\n    v\n}\npub fn u16_be(input: &[]u8, offset: i32) -> i32 {\n    assert(offset >= 0 && offset <= input.len - 2)\n    i32(input[offset]).shl(8).bit_or(i32(input[offset + 1]))\n}\npub fn i16_be(input: &[]u8, offset: i32) -> i32 {\n    raw := u16_be(&input, offset)\n    if raw >= 32768 { return raw - 65536 }\n    raw\n}\npub fn u32_be(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 4)\n    a := i64(input[offset]).shl(24).bit_or(i64(input[offset + 1]).shl(16))\n    b := i64(input[offset + 2]).shl(8).bit_or(i64(input[offset + 3]))\n    a.bit_or(b)\n}\npub fn i32_be(input: &[]u8, offset: i32) -> i32 {\n    raw := u32_be(&input, offset)\n    if raw >= 2147483648 { return i32(raw - 4294967296) }\n    i32(raw)\n}\npub fn i64_be(input: &[]u8, offset: i32) -> i64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: i64 = 0\n    for i in 0..8 {\n        v = v.bit_or(i64(input[offset + i]).shl((7 - i) * 8))\n    }\n    v\n}\npub fn u64_be(input: &[]u8, offset: i32) -> u64 {\n    assert(offset >= 0 && offset <= input.len - 8)\n    mut v: u64 = 0\n    for i in 0..8 {\n        v = v.bit_or(u64(input[offset + i]).shl((7 - i) * 8))\n    }\n    v\n}\n\npub fn utf8(input: &[]i32) -> sys.TextResult { sys.decode_utf8(&input) }\npub fn append_text(output: &mut []i32, text: string) {\n    output.reserve(output.len + text.len)\n    for byte in text.bytes() { output.push(byte) }\n}\npub fn hex(input: &[]i32) -> string {\n    digits := \"0123456789abcdef\"\n    mut output: []u8 = []\n    output.reserve(input.len * 2)\n    for byte in &input {\n        assert(byte >= 0 && byte <= 255)\n        output.push(u8(digits[byte / 16]))\n        output.push(u8(digits[byte % 16]))\n    }\n    result := decode(&output)\n    assert(result.ok)\n    result.value\n}\n\n@test fn byte_equality_covers_empty_values_word_tails_and_each_mismatch_position() {\n    empty: []u8 = []\n    assert(equal(&empty, &empty))\n    for length in [1, 2, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128, 129] {\n        mut lhs: []u8 = []\n        for i in 0..length { lhs.push(u8((i * 29 + 197) % 256)) }\n        same := lhs.clone()\n        assert(equal(&lhs, &same))\n        assert(!equal(&lhs, &empty) && !equal(&empty, &lhs))\n        for position in [0, length / 2, length - 1] {\n            mut different := lhs.clone()\n            different[position] = u8(255 - i32(different[position]))\n            assert(!equal(&lhs, &different))\n        }\n        mut left: []u8 = [11]\n        mut right: []u8 = [22, 33]\n        for i in 0..length { left.push(lhs[i]); right.push(lhs[i]) }\n        assert(equal_ranges(&left, 1, left.len, &right, 2, right.len))\n        right[right.len - 1] = u8(255 - i32(right[right.len - 1]))\n        assert(!equal_ranges(&left, 1, left.len, &right, 2, right.len))\n    }\n}\n\n@test fn byte_range_equality_rejects_invalid_bounds_before_taking_addresses() {\n    empty: []u8 = []; data: []u8 = [0, 255, 127, 42]\n    assert(equal_ranges(&empty, 0, 0, &empty, 0, 0))\n    assert(equal_ranges(&data, data.len, data.len, &empty, 0, 0))\n    assert(equal_ranges(&empty, 0, 0, &data, 2, 2))\n    assert(!equal_ranges(&data, 0, 1, &empty, 0, 0))\n    assert(!equal_ranges(&data, -1, 0, &data, 0, 1))\n    assert(!equal_ranges(&data, 2, 1, &data, 0, 1))\n    assert(!equal_ranges(&data, 0, 5, &data, 0, 5))\n    assert(!equal_ranges(&data, 0, 1, &data, -1, 0))\n    assert(!equal_ranges(&data, 0, 1, &data, 2, 1))\n    assert(!equal_ranges(&data, 0, 4, &data, 0, 5))\n    assert(!equal_ranges(&data, 0, 1, &data, 0, 2))\n    assert(!equal_ranges(&empty, -1, -1, &empty, 0, 0))\n    assert(!equal_ranges(&empty, 0, 0, &empty, 1, 1))\n    assert(!equal_ranges(&data, -2147483648, 2147483647, &data, 0, 4))\n    assert(!equal_ranges(&data, 0, 4, &data, -2147483648, 2147483647))\n}\n\n@test fn raw_byte_copy_handles_overlap_both_directions_without_touching_neighbors() {\n    mut buffer: [u8; 33] = [0; 33]\n    for i in 0..33 { buffer[i] = u8(i) }\n    unsafe {\n        base := addr(&mut buffer[0])\n        copy_memory(ptr(usize(base) + 3), base, usize(25))\n    }\n    for i in 0..3 { assert(buffer[i] == u8(i)) }\n    for i in 0..25 { assert(buffer[i + 3] == u8(i)) }\n    for i in 28..33 { assert(buffer[i] == u8(i)) }\n    for i in 0..33 { buffer[i] = u8(i) }\n    unsafe {\n        base := addr(&mut buffer[0])\n        copy_memory(base, ptr(usize(base) + 3), usize(25))\n        copy_memory(base, base, usize(33))\n        assert(equal_memory(base, base, usize(33)))\n        copy_memory(ptr(0), ptr(0), usize(0))\n        assert(equal_memory(ptr(0), ptr(0), usize(0)))\n    }\n    for i in 0..25 { assert(buffer[i] == u8(i + 3)) }\n    for i in 25..33 { assert(buffer[i] == u8(i)) }\n}\n\n@test fn buffer_extensions_preserve_prefixes_binary_values_and_utf8_bytes() {\n    mut output: []u8 = [0, 255]\n    append_utf8(&mut output, \"A\\0å雪\")\n    assert(hex_u8(&output) == \"00ff4100c3a5e99baa\")\n    source: []u8 = [17, 0, 255, 128, 34]\n    extend_range(&mut output, &source, 1, 4)\n    assert(hex_u8(&output) == \"00ff4100c3a5e99baa00ff80\")\n    empty: []u8 = []\n    extend(&mut output, &empty)\n    extend_range(&mut output, &source, source.len, source.len)\n    append_utf8(&mut output, \"\")\n    assert(output.len == 12)\n    extend(&mut output, &source)\n    assert(hex_u8(&output) == \"00ff4100c3a5e99baa00ff801100ff8022\")\n    for length in [1, 7, 8, 9, 31, 32, 33, 127, 128, 129] {\n        mut input: []u8 = []\n        for i in 0..length { input.push(u8(i % 256)) }\n        mut appended: []u8 = [0xaa]\n        extend(&mut appended, &input)\n        extend_range(&mut appended, &input, 0, input.len)\n        assert(appended.len == 1 + length * 2 && appended[0] == 0xaa)\n        for i in 0..length { assert(appended[i + 1] == u8(i % 256) && appended[i + length + 1] == u8(i % 256)) }\n    }\n}\n\n@test fn byte_encoding_is_explicit_and_round_trips_bits() {\n    mut output: []u8 = []\n    append_le(&mut output, 4278255360, 4)\n    hex_u8(&output) == \"00ff00ff\"\n    set_be(&mut output, 0, 16909060, 4)\n    hex_u8(&output) == \"01020304\"\n    output.clear()\n    append_le(&mut output, -1, 8)\n    hex_u8(&output) == \"ffffffffffffffff\"\n    output.clear()\n    append_utf8(&mut output, \"å\")\n    hex_u8(&output) == \"c3a5\"\n}\n@test fn big_endian_round_trips_and_boundaries() {\n    mut buf: []u8 = []\n    append_be(&mut buf, 0xab, 1)\n    append_be(&mut buf, 0, 2)\n    append_be(&mut buf, 65535, 2)\n    append_be(&mut buf, -32768, 2)\n    append_be(&mut buf, -1, 2)\n    append_be(&mut buf, 32767, 2)\n    append_be(&mut buf, 0x010203, 3)\n    append_be(&mut buf, 0, 4)\n    append_be(&mut buf, 4294967295, 4)\n    append_be(&mut buf, -2147483648, 4)\n    append_be(&mut buf, -1, 4)\n    append_be(&mut buf, 2147483647, 4)\n    append_be(&mut buf, 0, 8)\n    append_be(&mut buf, -9223372036854775808, 8)\n    append_be(&mut buf, 9223372036854775807, 8)\n    append_be(&mut buf, -1, 8)\n    append_be(&mut buf, 0x0102030405060708, 8)\n    assert(buf.len == 1 + 10 + 3 + 20 + 40)\n    assert(buf[0] == 0xab)\n\n    assert(u16_be(&buf, 1) == 0)\n    assert(i16_be(&buf, 1) == 0)\n    assert(u16_be(&buf, 3) == 65535)\n    assert(i16_be(&buf, 3) == -1)\n    assert(u16_be(&buf, 5) == 32768)\n    assert(i16_be(&buf, 5) == -32768)\n    assert(u16_be(&buf, 7) == 65535)\n    assert(i16_be(&buf, 7) == -1)\n    assert(u16_be(&buf, 9) == 32767)\n    assert(i16_be(&buf, 9) == 32767)\n\n    assert(buf[11] == 1 && buf[12] == 2 && buf[13] == 3)\n\n    assert(u32_be(&buf, 14) == 0)\n    assert(i32_be(&buf, 14) == 0)\n    assert(u32_be(&buf, 18) == 4294967295)\n    assert(i32_be(&buf, 18) == -1)\n    assert(u32_be(&buf, 22) == 2147483648)\n    assert(i32_be(&buf, 22) == -2147483648)\n    assert(u32_be(&buf, 26) == 4294967295)\n    assert(i32_be(&buf, 26) == -1)\n    assert(u32_be(&buf, 30) == 2147483647)\n    assert(i32_be(&buf, 30) == 2147483647)\n\n    assert(i64_be(&buf, 34) == 0)\n    assert(u64_be(&buf, 34) == u64(0))\n    assert(i64_be(&buf, 42) == -9223372036854775808)\n    assert(u64_be(&buf, 42) == u64(9223372036854775808))\n    assert(i64_be(&buf, 50) == 9223372036854775807)\n    assert(u64_be(&buf, 50) == u64(9223372036854775807))\n    assert(i64_be(&buf, 58) == -1)\n    assert(u64_be(&buf, 58) == u64(18446744073709551615))\n    assert(i64_be(&buf, 66) == 0x0102030405060708)\n    assert(u64_be(&buf, 66) == u64(0x0102030405060708))\n\n    mut exact: []u8 = [0xaa, 0, 0, 0, 0, 0, 0, 0, 0, 0xbb]\n    set_be(&mut exact, 1, 0x1234, 2)\n    assert(exact[0] == 0xaa && u16_be(&exact, 1) == 0x1234 && exact[3] == 0)\n    set_be(&mut exact, 1, 0x12345678, 4)\n    assert(exact[0] == 0xaa && u32_be(&exact, 1) == 0x12345678 && exact[5] == 0)\n    set_be(&mut exact, 1, -9223372036854775808, 8)\n    assert(exact[0] == 0xaa && i64_be(&exact, 1) == -9223372036854775808 && exact[9] == 0xbb)\n    assert(hex_u8(&exact) == \"aa8000000000000000bb\")\n\n    mut tail2: []u8 = [0xff, 0x80, 0x01]\n    assert(u16_be(&tail2, tail2.len - 2) == 0x8001)\n    assert(i16_be(&tail2, tail2.len - 2) == -32767)\n    mut tail4: []u8 = [0xff, 0x80, 0x00, 0x00, 0x01]\n    assert(u32_be(&tail4, tail4.len - 4) == 0x80000001)\n    assert(i32_be(&tail4, tail4.len - 4) == -2147483647)\n\n    min2: []u8 = [0x80, 0x00]\n    assert(u16_be(&min2, 0) == 32768 && i16_be(&min2, 0) == -32768)\n    min4: []u8 = [0x80, 0x00, 0x00, 0x00]\n    assert(u32_be(&min4, 0) == 2147483648 && i32_be(&min4, 0) == -2147483648)\n    min8: []u8 = [0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]\n    assert(i64_be(&min8, 0) == -9223372036854775808 && u64_be(&min8, 0) == u64(9223372036854775808))\n\n    assert(!decode_range(&tail2, -1, 1).ok)\n    assert(!decode_range(&tail2, 2, 1).ok)\n    assert(!decode_range(&tail2, 0, 4).ok)\n    assert(find_byte(&tail2, -5, 99, 0x01) == 2)\n    assert(find_byte(&tail2, 3, 5, 0x01) == -1)\n    assert(find_crlf(&tail2, 0, 99) == -1)\n    assert(find_double_crlf(&tail2, -1, 99) == -1)\n    assert(!equals_text(&tail2, -1, 0, \"\"))\n    assert(!equals_text(&tail2, 0, 4, \"abcd\"))\n}\n" }
