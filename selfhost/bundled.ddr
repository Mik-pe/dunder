i32(n) }\n        if n > 256 { return 256 }\n    }\n    4\n}\n\n@requires(process)\npub fn env(name: string) -> sys.TextResult {\n    if name.len == 0 { return sys.TextResult { ok: false, value: \"\", error: 22 } }\n    var key: []u8 = []\n    for b in name.bytes() {\n        if b == 0 || b == 61 { return sys.TextResult { ok: false, value: \"\", error: 22 } }\n        key.push(u8(b))\n    }\n    key.push(0)\n    unsafe {\n        _ := static_bytes(\"native\", 16)\n        p := c_getenv(addr(&key[0]))\n        if usize(p) == 0 {\n            return sys.TextResult { ok: false, value: \"\", error: 2 }\n        }\n        var out: []u8 = []\n        var i: usize = 0\n        while i < 1048576 {\n            b := load_u8(ptr(usize(p) + i))\n            if b == 0 { return bytes.decode(&out) }\n            out.push(b)\n            i = i + 1\n        }\n    }\n    sys.TextResult { ok: false, value: \"\", error: 27 }\n}\n\n@requires(process)\npub fn env_or(name: string, fallback: string) -> string {\n    res := env(name)\n    if res.ok { return res.value }\n    fallback\n}\n\nfn push_cstr(blob: &mut []u8, offsets: &mut []i32, value: string) -> bool {\n    offsets.push(blob.len)\n    blob.reserve(blob.len + value.len + 1)\n    for b in value.bytes() {\n        if b == 0 { return false }\n        blob.push(u8(b))\n    }\n    blob.push(0)\n    true\n}\n\nunsafe fn set_cloexec(fd: i32, is_darwin: bool) -> bool {\n    var req: usize = 21585 // Linux FIOCLEX = 0x5451\n    if is_darwin { req = 536897025 } // Darwin FIOCLEX = 0x20006601\n    c_ioctl(fd, req) == 0\n}\n\nunsafe fn resolve_errno_ptr(is_darwin: bool) -> ptr {\n    var sym_name := cstr(\"__errno_location\")\n    if is_darwin { sym_name = cstr(\"__error\") }\n    h := dl.open(ptr(0), 2)\n    if usize(h) == 0 { return ptr(0) }\n    sym := dl.symbol(h, sym_name)\n    if usize(sym) == 0 { _ := dl.close(h); return ptr(0) }\n    loc_fn: extern fn() -> ptr = ffi_fn(sym)\n    ep := loc_fn()\n    _ := dl.close(h)\n    ep\n}\n\nun