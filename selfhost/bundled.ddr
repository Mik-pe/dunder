 0 && cmd.stdout_mode == .Null && null_wfd >= 0 {\n                r := os_dup2(null_wfd, 1)\n                if r < 0 { child_err = -r }\n            }\n            if child_err == 0 && err_out_fds[1] >= 0 {\n                r := os_dup2(err_out_fds[1], 2)\n                if r < 0 { child_err = -r }\n                if err_out_fds[1] > 2 { _ := os_close(err_out_fds[1]) }\n            } else if child_err == 0 && copies[2] < 0 && cmd.stderr_mode == .Null && null_wfd >= 0 {\n                r := os_dup2(null_wfd, 2)\n                if r < 0 { child_err = -r }\n            }\n            if null_rfd > 2 { _ := os_close(null_rfd) }\n            if null_wfd > 2 { _ := os_close(null_wfd) }\n\n            if child_err == 0 { child_err = os_signal_disposition(2, false) }\n            if child_err == 0 { child_err = os_signal_disposition(15, false) }\n            if child_err == 0 { child_err = os_signal_disposition(13, false) }\n            if child_err == 0 { child_err = os_clear_signal_mask() }\n\n            if child_err == 0 {\n                mut saw_perm := false\n                mut last_e := 2\n                for ci in 0..candidates.len {\n                    e := -os_execve(candidates[ci], argv_ptr, envp_ptr)\n                    if e == 13 { saw_perm = true }\n                    if e != 2 && e != 20 { last_e = e }\n                }\n                if saw_perm { child_err = 13 } else { child_err = last_e }\n            }\n\n            mut msg: [u8; 4] = [\n                u8(child_err.bit_and(255)),\n                u8(child_err.shr(8).bit_and(255)),\n                u8(child_err.shr(16).bit_and(255)),\n                u8(child_err.shr(24).bit_and(255)),\n            ]\n            _ := os_write(err_fds[1], addr(&msg[0]), 4)\n            _ := os_close(err_fds[1])\n            os_exit(127)\n            return .Err(sys.IoError::from_code(127))\n        }\n\n        _ := os_setpgid(pid, pid)\n        _ := os_close(err_fds[1])\n        if in_fds[0] >= 0 { _ := os_close(in_fds[0]) }\n        if out_fds[1] >= 0 { _ := os_close(out_fds[1]) }\n        if err_out_fds[1] >= 0 { _ := os_close(err_out_fds[1]) }\n        os_close_devnull(&mut null_read)\n        os_close_devnull(&mut null_write)\n\n        mut err_buf: [u8; 4] = [0, 0, 0, 0]\n        mut err_got := 0\n        while err_got < 4 {\n            n := os_read(err_fds[0], ptr(usize(addr(&mut err_buf[0])) + usize(err_got)), usize(4 - err_got))\n            if n == 0 { break }\n            if n < 0 {\n                if n == -4 { continue }\n                break\n            }\n            err_got += i32(n)\n        }\n        _ := os_close(err_fds[0])\n\n        if err_got == 4 {\n            exec_lo := i32(err_buf[0]).bit_or(i32(err_buf[1]).shl(8))\n            exec_hi := i32(err_buf[2]).shl(16).bit_or(i32(err_buf[3]).shl(24))\n            exec_err := exec_lo.bit_or(exec_hi)\n            mut wstatus := 0\n            while true {\n                wr := os_waitpid(pid, addr(&mut wstatus), 0)\n                if wr >= 0 || wr != -4 { break }\n            }\n            if in_fds[1] >= 0 { _ := os_close(in_fds[1]) }\n            if out_fds[0] >= 0 { _ := os_close(out_fds[0]) }\n            if err_out_fds[0] >= 0 { _ := os_close(err_out_fds[0]) }\n            return .Err(sys.IoError::from_code(exec_err))\n        }\n\n        unsafe {\n            if in_fds[1] >= 0 { _ := sys.fd_set_nonblocking(in_fds[1], true) }\n            if out_fds[0] >= 0 { _ := sys.fd_set_nonblocking(out_fds[0], true) }\n            if err_out_fds[0] >= 0 { _ := sys.fd_set_nonblocking(err_out_fds[0], true) }\n        }\n\n        return .Ok(Child {\n            pid: pid,\n            pgid: pid, win_process: 0, win_job: 0,\n            stdin_fd: in_fds[1],\n            stdout_fd: out_fds[0],\n            stderr_fd: err_out_fds[0],\n            reaped: false,\n            code: 0,\n            signal: 0,\n        })\n    }\n    .Err(.Unsupported)\n}\n\nfn decode_wait_status(child: &mut Child, wstatus: i32) {\n    child.reaped = true\n    sig := wstatus.bit_and(127)\n    if sig != 0 {\n        child.signal = sig\n        child.code = 128 + sig\n    } else {\n        child.signal = 0\n        child.code = wstatus.shr(8).bit_and(255)\n    }\n}\n\nfn append_poll_fd(out: &mut []u8, fd: i32, events: i64) {\n    bytes.append_le(&mut out, i64(fd), 4)\n    bytes.append_le(&mut out, events, 2)\n    bytes.append_le(&mut out, 0, 2)\n}\n\nimpl Child {\n    pub fn pid(&self) -> i32 { self.pid }\n\n    pub fn close_stdin(&mut self) {\n        if self.stdin_fd >= 0 {\n            unsafe { _ := sys.fd_close(self.stdin_fd) }\n            self.stdin_fd = -1\n        }\n    }\n\n    pub fn close_pipes(&mut self) {\n        self.close_stdin()\n        if self.stdout_fd >= 0 { unsafe { _ := sys.fd_close(self.stdout_fd) }; self.stdout_fd = -1 }\n        if self.stderr_fd >= 0 { unsafe { _ := sys.fd_close(self.stderr_fd) }; self.stderr_fd = -1 }\n    }\n\n    pub fn take_stdin(&mut self) -> Result<ChildStdin, sys.IoError> {\n        if self.stdin_fd < 0 { return .Err(.BadDescriptor) }\n        fd := self.stdin_fd\n        self.stdin_fd = -1\n        unsafe { _ := sys.fd_set_nonblocking(fd, false) }\n        .Ok(ChildStdin { fd: fd })\n    }\n\n    pub fn take_stdout(&mut self) -> Result<ChildStdout, sys.IoError> {\n        if self.stdout_fd < 0 { return .Err(.BadDescriptor) }\n        fd := self.stdout_fd\n        self.stdout_fd = -1\n        unsafe { _ := sys.fd_set_nonblocking(fd, false) }\n        .Ok(ChildStdout { fd: fd })\n    }\n\n    pub fn take_stderr(&mut self) -> Result<ChildStderr, sys.IoError> {\n        if self.stderr_fd < 0 { return .Err(.BadDescriptor) }\n        fd := self.stderr_fd\n        self.stderr_fd = -1\n        unsafe { _ := sys.fd_set_nonblocking(fd, false) }\n        .Ok(ChildStderr { fd: fd })\n    }\n\n    fn signal_group(&self, sig: i32) -> sys.Status {\n        if self.reaped || self.pid <= 0 { return sys.Status { ok: true, error: 0 } }\n        unsafe {\n            if target_is(\"windows\") {\n                ok := win.kill(ptr(usize(self.win_job)), 128 + sig)\n                return sys.Status { ok: ok, error: if ok { 0 } else { 5 } }\n            } else if os_kill(-self.pgid, sig) == 0 || os_kill(self.pid, sig) == 0 {\n                return sys.Status { ok: true, error: 0 }\n            }\n        }\n        sys.Status { ok: true, error: 0 }\n    }\n\n    pub fn terminate(&mut self) -> sys.Status { self.signal_group(15) }\n    pub fn kill(&mut self) -> sys.Status { self.signal_group(9) }\n\n    pub fn try_wait(&mut self) -> WaitResult {\n        if target_is(\"windows\") { return wait_windows(&mut self, 0, false) }\n        if self.reaped {\n            return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }\n        }\n        unsafe {\n            mut wstatus := 0\n            r := os_waitpid(self.pid, addr(&mut wstatus), 1)\n            if r == self.pid {\n                decode_wait_status(&mut self, wstatus)\n                return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }\n            }\n            if r == 0 {\n                return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }\n            }\n        }\n        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n    }\n\n    pub fn wait(&mut self, timeout_ms: i64) -> WaitResult {\n        if target_is(\"windows\") {\n            waited := wait_windows(&mut self, if timeout_ms > 0 { timeout_ms } else { -1 }, true)\n            self.close_pipes()\n            return waited\n        }\n        if self.reaped {\n            self.close_pipes()\n            return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }\n        }\n        unsafe {\n            mut wstatus := 0\n            if timeout_ms <= 0 {\n                while true {\n                    r := os_waitpid(self.pid, addr(&mut wstatus), 0)\n                    if r == self.pid {\n                        decode_wait_status(&mut self, wstatus)\n                        self.close_pipes()\n                        return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }\n                    }\n                    if r < 0 && os_kill(self.pid, 0) != 0 { break }\n                }\n                self.close_pipes()\n                return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n            }\n\n            start := sys.now_ms()\n            mut polls := 0\n            while true {\n                r := os_waitpid(self.pid, addr(&mut wstatus), 1)\n                if r == self.pid {\n                    decode_wait_status(&mut self, wstatus)\n                    self.close_pipes()\n                    return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }\n                }\n                now := sys.now_ms()\n                if now - start >= timeout_ms {\n                    _ := self.kill()\n                    while true {\n                        wr := os_waitpid(self.pid, addr(&mut wstatus), 0)\n                        if wr >= 0 || os_kill(self.pid, 0) != 0 { break }\n                    }\n                    decode_wait_status(&mut self, wstatus)\n                    self.code = 124\n                    self.close_pipes()\n                    return WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: self.signal, error: 60 }\n                }\n                if polls < 8 { os_usleep_50(); polls += 1 }\n                else { sys.sleep_ms(2) }\n            }\n        }\n        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n    }\n\n    pub fn read_stdout(&mut self, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> Result<i64, sys.IoError> {\n        read_pipe(&mut self.stdout_fd, &mut out, max_bytes, timeout_ms)\n    }\n\n    pub fn read_stderr(&mut self, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> Result<i64, sys.IoError> {\n        read_pipe(&mut self.stderr_fd, &mut out, max_bytes, timeout_ms)\n    }\n\n    pub fn read_stdout_line(&mut self, timeout_ms: i64) -> Result<Option<string>, sys.IoError> {\n        start := sys.now_ms()\n        mut line: []u8 = []\n        while line.len < 65536 {\n            mut rem: i64 = -1\n            if timeout_ms > 0 {\n                elapsed := sys.now_ms() - start\n                if elapsed >= timeout_ms { return .Err(.TimedOut) }\n                rem = timeout_ms - elapsed\n            }\n            before := line.len\n            match self.read_stdout(&mut line, 1, rem) {\n                .Ok(n) => {\n                    if n == 0 {\n                        if line.len == 0 { return .Ok(.None) }\n                        break\n                    }\n                },\n                .Err(e) => {\n                    if e == .WouldBlock { return .Err(.TimedOut) }\n                    return .Err(e)\n                },\n            }\n            if line.len > before && line[line.len - 1] == b'\\n' {\n                break\n            }\n        }\n        mut end := line.len\n        if end > 0 && line[end - 1] == b'\\n' { end -= 1 }\n        if end > 0 && line[end - 1] == b'\\r' { end -= 1 }\n        .Ok(.Some(bytes.decode_range(&line, 0, end)?))\n    }\n\n    pub fn write_stdin(&mut self, data: &[]u8) -> sys.Status {\n        if self.stdin_fd < 0 { return sys.Status { ok: false, error: 9 } }\n        if data.len == 0 { return sys.Status { ok: true, error: 0 } }\n        unsafe {\n            mut off := 0\n            mut poll_buf: []u8 = []\n            while off < data.len {\n                p := ptr(usize(addr(&data[0])) + usize(off))\n                n := os_write(self.stdin_fd, p, usize(data.len - off))\n                if n > 0 { off += i32(n); continue }\n                e := i32(-n)\n                if e == 4 { continue }\n                if e == 35 {\n                    poll_buf.clear()\n                    append_poll_fd(&mut poll_buf, self.stdin_fd, 4)\n                    unsafe { _ := sys.fd_poll(&mut poll_buf, 1, 100) }\n                    continue\n                }\n                return sys.Status { ok: false, error: e }\n            }\n        }\n        sys.Status { ok: true, error: 0 }\n    }\n}\n\nfn wait_windows(child: &mut Child, timeout: i64, kill_on_timeout: bool) -> WaitResult {\n    mut timed_out := false\n    if !child.reaped {\n        unsafe {\n            handle := ptr(usize(child.win_process)); job := ptr(usize(child.win_job))\n            mut status := win.wait(handle, timeout, &mut child.code)\n            if status == 0 && kill_on_timeout {\n                if win.kill(job, 124) {\n                    status = win.wait(handle, -1, &mut child.code)\n                    timed_out = true\n                } else { status = -1 }\n            }\n            if status < 0 { return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 } }\n            if status == 0 { return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 } }\n            win.close(handle); win.close(job); child.win_process = 0; child.win_job = 0; child.reaped = true\n        }\n    }\n    WaitResult { ok: !timed_out, exited: true, timed_out: timed_out, code: child.code, signal: 0, error: if timed_out { 60 } else { 0 } }\n}\n\nunsafe fn read_available(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 {\n    if target_is(\"windows\") {\n        if max_bytes < 0 { return -22 }\n        if max_bytes == 0 { return 0 }\n        mut buf: [u8; 4096] = [0; 4096]\n        n := win.read(fd, addr(&mut buf[0]), if max_bytes < 4096 { i32(max_bytes) } else { 4096 })\n        if n > 0 { bytes.extend(&mut out, &buf[..i32(n)]) }\n        return n\n    } else { return sys.fd_read(fd, &mut out, max_bytes) }\n}\n\nfn read_pipe(fd: &mut i32, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> Result<i64, sys.IoError> {\n    if fd < 0 { return .Ok(0) }\n    if max_bytes <= 0 { return .Ok(0) }\n    mut poll_buf: []u8 = []\n    append_poll_fd(&mut poll_buf, fd, 1)\n    mut chunk := 65536\n    if max_bytes < 65536 { chunk = i32(max_bytes) }\n    out.reserve(out.len + chunk)\n    mut n: i64 = 0\n    unsafe { n = read_available(fd, &mut out, max_bytes) }\n    if n > 0 { return .Ok(n) }\n    if n == 0 { unsafe { _ := sys.fd_close(fd) }; fd = -1; return .Ok(0) }\n    if n != -35 { return .Err(sys.IoError::from_code(i32(-n))) }\n    if timeout_ms == 0 { return .Err(.WouldBlock) }\n    mut pr: i64 = 0\n    unsafe { pr = sys.fd_poll(&mut poll_buf, 1, timeout_ms) }\n    if pr < 0 { return .Err(sys.IoError::from_code(i32(-pr))) }\n    if pr == 0 { return .Err(.WouldBlock) }\n    mut n2: i64 = 0\n    unsafe { n2 = read_available(fd, &mut out, max_bytes) }\n    if n2 > 0 { return .Ok(n2) }\n    if n2 == 0 { unsafe { _ := sys.fd_close(fd) }; fd = -1; return .Ok(0) }\n    .Err(sys.IoError::from_code(i32(-n2)))\n}\n\nfn exec_internal(program: string, args: &[]string, cmd: &Command) -> Output {\n    mut stdin_mode := cmd.stdin_mode\n    if cmd.stdin_data.len > 0 { stdin_mode = .Pipe }\n    mut child := match spawn_internal(program, &args, &cmd, stdin_mode) {\n        .Ok(ch) => ch,\n        .Err(err) => {\n            return Output {\n                ok: false, error: err.code(), code: 127, signal: 0, timed_out: false,\n                stdout: [], stderr: [],\n            }\n        },\n    }\n    mut out_bytes: []u8 = []\n    mut err_bytes: []u8 = []\n    mut in_off := 0\n    if stdin_mode == .Pipe && cmd.stdin_data.len == 0 {\n        child.close_stdin()\n    }\n\n    start := sys.now_ms()\n    mut poll_buf: []u8 = []\n    mut fd_roles: []i32 = []\n\n    while child.stdin_fd >= 0 || child.stdout_fd >= 0 || child.stderr_fd >= 0 {\n        if cmd.timeout_ms > 0 && sys.now_ms() - start >= cmd.timeout_ms {\n            _ := child.kill()\n            w := child.wait(1000)\n            return Output {\n                ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,\n                stdout: out_bytes, stderr: err_bytes,\n            }\n        }\n\n        poll_buf.clear()\n        fd_roles.clear()\n        if child.stdin_fd >= 0 {\n            append_poll_fd(&mut poll_buf, child.stdin_fd, 4)\n            fd_roles.push(0)\n        }\n        if child.stdout_fd >= 0 {\n            append_poll_fd(&mut poll_buf, child.stdout_fd, 1)\n            fd_roles.push(1)\n        }\n        if child.stderr_fd >= 0 {\n            append_poll_fd(&mut poll_buf, child.stderr_fd, 1)\n            fd_roles.push(2)\n        }\n\n        mut wait_ms: i64 = -1\n        if cmd.timeout_ms > 0 {\n            rem := cmd.timeout_ms - (sys.now_ms() - start)\n            if rem <= 0 { continue }\n            wait_ms = rem\n        }\n        unsafe { _ := sys.fd_poll(&mut poll_buf, i64(fd_roles.len), wait_ms) }\n\n        for idx in 0..fd_roles.len {\n            revents := bytes.u16_le(&poll_buf, idx * 8 + 6)\n            if revents == 0 { continue }\n            role := fd_roles[idx]\n            if role == 0 && child.stdin_fd >= 0 {\n                unsafe {\n                    while in_off < cmd.stdin_data.len {\n                        p := ptr(usize(addr(&cmd.stdin_data[0])) + usize(in_off))\n                        n := os_write(child.stdin_fd, p, usize(cmd.stdin_data.len - in_off))\n                        if n > 0 { in_off += i32(n); continue }\n                        if n == -4 { continue }\n                        if n != -35 { in_off = cmd.stdin_data.len }\n                        break\n                    }\n                }\n                if in_off >= cmd.stdin_data.len { child.close_stdin() }\n            } else if role == 1 && child.stdout_fd >= 0 {\n                while child.stdout_fd >= 0 {\n                    if i64(out_bytes.len) >= cmd.max_output_bytes {\n                        _ := child.kill()\n                        _ := child.wait(1000)\n                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }\n                    }\n                    out_bytes.reserve(out_bytes.len + 16384)\n                    mut n: i64 = 0\n                    unsafe { n = read_available(child.stdout_fd, &mut out_bytes, 65536) }\n                    if n > 0 { continue }\n                    if n == 0 || n != -35 {\n                        unsafe { _ := sys.fd_close(child.stdout_fd) }\n                        child.stdout_fd = -1\n                    }\n                    break\n                }\n            } else if role == 2 && child.stderr_fd >= 0 {\n                while child.stderr_fd >= 0 {\n                    if i64(err_bytes.len) >= cmd.max_output_bytes {\n                        _ := child.kill()\n                        _ := child.wait(1000)\n                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }\n                    }\n                    err_bytes.reserve(err_bytes.len + 16384)\n                    mut n: i64 = 0\n                    unsafe { n = read_available(child.stderr_fd, &mut err_bytes, 65536) }\n                    if n > 0 { continue }\n                    if n == 0 || n != -35 {\n                        unsafe { _ := sys.fd_close(child.stderr_fd) }\n                        child.stderr_fd = -1\n                    }\n                    break\n                }\n            }\n        }\n    }\n\n    mut rem_wait: i64 = 0\n    if cmd.timeout_ms > 0 {\n        rem_wait = cmd.timeout_ms - (sys.now_ms() - start)\n        if rem_wait <= 0 { rem_wait = 1 }\n    }\n    w := child.wait(rem_wait)\n    if w.timed_out {\n        return Output {\n            ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,\n            stdout: out_bytes, stderr: err_bytes,\n        }\n    }\n    Output {\n        ok: w.ok, error: w.error, code: w.code, signal: w.signal, timed_out: false,\n        stdout: out_bytes, stderr: err_bytes,\n    }\n}\n\n@requires(process)\npub fn run(program: string, args: []string) -> Output {\n    cmd := Command::new(\"\", [])\n    exec_internal(program, &args, &cmd)\n}\n\n@requires(process)\npub fn run_in(program: string, args: []string, cwd: string) -> Output {\n    mut cmd := Command::new(\"\", [])\n    cmd.cwd = cwd.clone()\n    exec_internal(program, &args, &cmd)\n}\n\n@requires(process)\npub fn status(program: string, args: []string) -> WaitResult {\n    mut cmd := Command::new(\"\", [])\n    cmd.inherit_stdio()\n    mut child := match spawn_internal(program, &args, &cmd, cmd.stdin_mode) {\n        .Ok(ch) => ch,\n        .Err(err) => { return WaitResult { ok: false, exited: false, timed_out: false, code: 127, signal: 0, error: err.code() } },\n    }\n    child.wait(0)\n}\n\n@requires(process)\npub fn replace(program: string, args: &[]string) -> sys.Status {\n    replace_as(program, program, &args)\n}\n\n@requires(process)\npub fn replace_as(program: string, argv0: string, args: &[]string) -> sys.Status {\n    if target_is(\"windows\") { return sys.Status { ok: false, error: 45 } }\n    else { return replace_posix(program, argv0, &args) }\n}\n\nfn replace_posix(program: string, argv0: string, args: &[]string) -> sys.Status {\n    if program.len == 0 || argv0.len == 0 { return sys.Status { ok: false, error: 22 } }\n    mut blob: []u8 = []\n    mut arg_offsets: []i32 = []\n    if !push_cstr(&mut blob, &mut arg_offsets, argv0) {\n        return sys.Status { ok: false, error: 22 }\n    }\n    for arg in &args {\n        if !push_cstr(&mut blob, &mut arg_offsets, arg) {\n            return sys.Status { ok: false, error: 22 }\n        }\n    }\n    mut candidate_offsets: []i32 = []\n    mut program_offsets: []i32 = []\n    if !push_cstr(&mut blob, &mut program_offsets, program) {\n        return sys.Status { ok: false, error: 22 }\n    }\n    if text.contains(program, \"/\") {\n        candidate_offsets.push(program_offsets[0])\n    } else {\n        mut search_path := \"/usr/bin:/bin\"\n        match env(\"PATH\") {\n            .Some(p) => { search_path = p },\n            .None => {},\n        }\n        for directory in text.split(search_path, \":\") {\n            candidate := if directory.len == 0 { f\"./{program}\" } else { f\"{directory}/{program}\" }\n            if !push_cstr(&mut blob, &mut candidate_offsets, candidate) {\n                return sys.Status { ok: false, error: 22 }\n            }\n        }\n    }\n    unsafe {\n        mut argv: []ptr = []\n        for offset in &arg_offsets { argv.push(addr(&blob[offset])) }\n        argv.push(ptr(0))\n        environ := parent_environ()\n        mut failure := 2\n        for offset in &candidate_offsets {\n            code := -os_execve(addr(&blob[offset]), addr(&argv[0]), environ)\n            if code == 13 { failure = 13 }\n            else if code != 2 && code != 20 { return sys.Status { ok: false, error: code } }\n        }\n        sys.Status { ok: false, error: failure }\n    }\n}\n\n@resource\npub opaque struct ChildSet {\n    cap: i32,\n    count: i32,\n    active: []bool,\n    pids: []i32,\n    pgids: []i32,\n    win_processes: []i64, win_jobs: []i64,\n    stdin_fds: []i32,\n    stdout_fds: []i32,\n    stderr_fds: []i32,\n    reaped: []bool,\n    codes: []i32,\n    signals: []i32,\n    poll_buf: []u8,\n}\n\nfn drain_fd_all(fd: &mut i32, out: &mut []u8) {\n    while fd >= 0 {\n        out.reserve(out.len + 16384)\n        mut n: i64 = 0\n        unsafe { n = read_available(fd, &mut out, 65536) }\n        if n > 0 { continue }\n        if n == 0 { unsafe { _ := sys.fd_close(fd) }; fd = -1 }\n        break\n    }\n}\n\nimpl ChildSet {\n    pub fn new(capacity: i32) -> Self {\n        assert(capacity > 0 && capacity <= 1024)\n        mut s := Self {\n            cap: capacity, count: 0, active: [], pids: [], pgids: [], win_processes: [], win_jobs: [],\n            stdin_fds: [], stdout_fds: [], stderr_fds: [],\n            reaped: [], codes: [], signals: [], poll_buf: [],\n        }\n        for _ in 0..capacity {\n            s.active.push(false)\n            s.pids.push(-1)\n            s.pgids.push(-1)\n            if target_is(\"windows\") { s.win_processes.push(0); s.win_jobs.push(0) }\n            s.stdin_fds.push(-1)\n            s.stdout_fds.push(-1)\n            s.stderr_fds.push(-1)\n            s.reaped.push(false)\n            s.codes.push(0)\n            s.signals.push(0)\n        }\n        s\n    }\n\n    pub fn len(&self) -> i32 { self.count }\n\n    pub fn is_active(&self, slot: i32) -> bool {\n        slot >= 0 && slot < self.cap && self.active[slot]\n    }\n\n    pub fn insert(&mut self, child: &mut Child) -> i32 {\n        if child.pid <= 0 { return -1 }\n        for slot in 0..self.cap {\n            if !self.active[slot] {\n                self.active[slot] = true\n                self.pids[slot] = child.pid\n                self.pgids[slot] = child.pgid\n                if target_is(\"windows\") {\n                    self.win_processes[slot] = child.win_process; self.win_jobs[slot] = child.win_job\n                    child.win_process = 0; child.win_job = 0\n                }\n                self.stdin_fds[slot] = child.stdin_fd\n                self.stdout_fds[slot] = child.stdout_fd\n                self.stderr_fds[slot] = child.stderr_fd\n                self.reaped[slot] = child.reaped\n                self.codes[slot] = child.code\n                self.signals[slot] = child.signal\n                self.count += 1\n                child.pid = -1\n                child.pgid = -1\n                child.stdin_fd = -1\n                child.stdout_fd = -1\n                child.stderr_fd = -1\n                child.reaped = true\n                return slot\n            }\n        }\n        -1\n    }\n\n    pub fn try_insert(&mut self, move child: Child) -> Result<i32, Child> {\n        mut owner := child\n        slot := self.insert(&mut owner)\n        if slot < 0 { return .Err(owner) }\n        .Ok(slot)\n    }\n\n    pub fn drain(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) {\n        if slot < 0 || slot >= self.cap || !self.active[slot] { return }\n        mut out_fd := self.stdout_fds[slot]\n        drain_fd_all(&mut out_fd, &mut stdout_out)\n        self.stdout_fds[slot] = out_fd\n        mut err_fd := self.stderr_fds[slot]\n        drain_fd_all(&mut err_fd, &mut stderr_out)\n        self.stderr_fds[slot] = err_fd\n    }\n\n    fn release_slot(&mut self, slot: i32) {\n        unsafe {\n            if target_is(\"windows\") {\n                win.close(ptr(usize(self.win_processes[slot]))); win.close(ptr(usize(self.win_jobs[slot])))\n                self.win_processes[slot] = 0; self.win_jobs[slot] = 0\n            }\n            if self.stdin_fds[slot] >= 0 { _ := sys.fd_close(self.stdin_fds[slot]); self.stdin_fds[slot] = -1 }\n            if self.stdout_fds[slot] >= 0 { _ := sys.fd_close(self.stdout_fds[slot]); self.stdout_fds[slot] = -1 }\n            if self.stderr_fds[slot] >= 0 { _ := sys.fd_close(self.stderr_fds[slot]); self.stderr_fds[slot] = -1 }\n        }\n        self.active[slot] = false\n        self.pids[slot] = -1\n        self.count -= 1\n    }\n\n    pub fn poll_io(&mut self, timeout_ms: i64) -> Result<i32, sys.IoError> {\n        if self.count <= 0 { return .Ok(0) }\n        self.poll_buf.clear()\n        mut nfds := 0\n        mut has_pipeless := false\n        for slot in 0..self.cap {\n            if !self.active[slot] { continue }\n            out_fd := self.stdout_fds[slot]\n            err_fd := self.stderr_fds[slot]\n            if out_fd >= 0 {\n                append_poll_fd(&mut self.poll_buf, out_fd, 1)\n                nfds += 1\n            }\n            if err_fd >= 0 {\n                append_poll_fd(&mut self.poll_buf, err_fd, 1)\n                nfds += 1\n            }\n            if out_fd < 0 && err_fd < 0 { has_pipeless = true }\n        }\n        mut wait_ms := timeout_ms\n        if has_pipeless && (wait_ms < 0 || wait_ms > 1) { wait_ms = 1 }\n        if nfds == 0 {\n            if wait_ms > 0 { sys.sleep_ms(wait_ms) }\n            return .Ok(0)\n        }\n        mut polled: i64 = 0\n        unsafe { polled = sys.fd_poll(&mut self.poll_buf, i64(nfds), wait_ms) }\n        if polled < 0 { return .Err(sys.IoError::from_code(i32(-polled))) }\n        .Ok(i32(polled))\n    }\n\n    pub fn wait_any(&mut self, timeout_ms: i64) -> Result<i32, sys.IoError> {\n        self.poll_io(timeout_ms)\n    }\n\n    pub fn try_wait(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {\n        if slot < 0 || slot >= self.cap || !self.active[slot] {\n            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }\n        }\n        self.drain(slot, &mut stdout_out, &mut stderr_out)\n        if target_is(\"windows\") {\n            mut code := self.codes[slot]\n            mut waited := 1\n            if !self.reaped[slot] { unsafe { waited = win.wait(ptr(usize(self.win_processes[slot])), 0, &mut code) } }\n            if waited != 0 {\n                self.drain(slot, &mut stdout_out, &mut stderr_out); self.release_slot(slot)\n            }\n            return WaitResult { ok: waited >= 0, exited: waited == 1, timed_out: false, code: if waited == 1 { code } else { 0 }, signal: 0, error: if waited < 0 { 5 } else { 0 } }\n        }\n        if self.reaped[slot] {\n            code := self.codes[slot]\n            sig := self.signals[slot]\n            self.release_slot(slot)\n            return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }\n        }\n        unsafe {\n            pid := self.pids[slot]\n            mut wstatus := 0\n            mut r := os_waitpid(pid, addr(&mut wstatus), 1)\n            if r == 0 && self.stdout_fds[slot] < 0 && self.stderr_fds[slot] < 0 {\n                os_usleep_50()\n                r = os_waitpid(pid, addr(&mut wstatus), 1)\n            }\n            if r == pid {\n                self.drain(slot, &mut stdout_out, &mut stderr_out)\n                self.release_slot(slot)\n                sig := wstatus.bit_and(127)\n                mut code := wstatus.shr(8).bit_and(255)\n                if sig != 0 { code = 128 + sig }\n                return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }\n            }\n            if r == 0 {\n                return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }\n            }\n        }\n        self.release_slot(slot)\n        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n    }\n\n    pub fn kill_reap(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {\n        if slot < 0 || slot >= self.cap || !self.active[slot] {\n            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }\n        }\n        unsafe {\n            if target_is(\"windows\") {\n                mut code := 0\n                if !self.reaped[slot] {\n                    _ := win.kill(ptr(usize(self.win_jobs[slot])), 124)\n                    _ := win.wait(ptr(usize(self.win_processes[slot])), -1, &mut code)\n                }\n                self.drain(slot, &mut stdout_out, &mut stderr_out); self.release_slot(slot)\n                return WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: 9, error: 60 }\n            }\n            pid := self.pids[slot]\n            pgid := self.pgids[slot]\n            if (pgid <= 0 || os_kill(-pgid, 9) != 0) && pid > 0 {\n                _ := os_kill(pid, 9)\n            }\n            mut wstatus := 0\n            while os_waitpid(pid, addr(&mut wstatus), 0) < 0 {\n                if os_kill(pid, 0) != 0 { break }\n            }\n        }\n        self.drain(slot, &mut stdout_out, &mut stderr_out)\n        self.release_slot(slot)\n        WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: 9, error: 60 }\n    }\n\n    pub fn kill_all(&mut self) {\n        mut sink_out: []u8 = []\n        mut sink_err: []u8 = []\n        for slot in 0..self.cap {\n            if self.active[slot] {\n                _ := self.kill_reap(slot, &mut sink_out, &mut sink_err)\n                sink_out.clear()\n                sink_err.clear()\n            }\n        }\n    }\n}\n" }
    if name == "random" { return "capability unsafe\n\nimport sys\n\n@extern(\"c\", \"arc4random_buf\")\n@thread_safe\nunsafe fn mac_random(data: ptr, count: usize)\n\n@extern(\"bcrypt.dll\", \"BCryptGenRandom\")\n@thread_safe\nunsafe fn win_random(algorithm: ptr, data: ptr, count: u32, flags: u32) -> i32\n\n@extern(\"wasi_snapshot_preview1\", \"random_get\")\n@thread_safe\nunsafe fn wasi_random(data: ptr, count: usize) -> i32\n\n@thread_safe\npub fn fill(data: &mut []u8) -> Result<(), sys.IoError> {\n    if data.len == 0 { return .Ok }\n    unsafe {\n        if target_is(\"macos\") {\n            mac_random(addr(&mut data[0]), usize(data.len))\n            return .Ok\n        }\n        if target_is(\"linux\") {\n            mut at := 0\n            while at < data.len {\n                n := sys.linux_syscall(278, i64(usize(addr(&mut data[at]))), i64(data.len - at), 0, 0, 0, 0)\n                if n == -4 { continue }\n                if n == -38 { return .Err(.Unsupported) }\n                if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }\n                if n == 0 { return .Err(.UnexpectedEof) }\n                at += i32(n)\n            }\n            return .Ok\n        }\n        if target_is(\"windows\") {\n            status := win_random(ptr(0), addr(&mut data[0]), u32(data.len), u32(2))\n            if status != 0 { return .Err(.Other(status)) }\n            return .Ok\n        }\n        if target_is(\"wasi\") {\n            status := wasi_random(addr(&mut data[0]), usize(data.len))\n            if status != 0 { return .Err(.Other(status)) }\n            return .Ok\n        }\n    }\n    .Err(.Unsupported)\n}\n\n@thread_safe\npub fn bytes(count: i32) -> Result<[]u8, sys.IoError> {\n    if count < 0 { return .Err(.InvalidArgument) }\n    if count > 1048576 { return .Err(.TooLarge) }\n    if target_is(\"wasm32-unknown-unknown\") && count > 0 { return .Err(.Unsupported) }\n    mut data: []u8 = []\n    match data.try_reserve(count) {\n        .Ok => {},\n        .InvalidCapacity => { return .Err(.TooLarge) },\n        .OutOfMemory => { return .Err(.OutOfMemory) },\n    }\n    for _ in 0..count { data.push(0) }\n    fill(&mut data)?\n    .Ok(data)\n}\n" }
    if name == "sha256" { return "import std.bytes as bytes\nfn push_word(out: &mut []u8, v: i64) {\n    out.push(u8(v.shr(24).bit_and(255)))\n    out.push(u8(v.shr(16).bit_and(255)))\n    out.push(u8(v.shr(8).bit_and(255)))\n    out.push(u8(v.bit_and(255)))\n}\npub fn digest_range(input: &[]u8, start: i32, length: i32) -> []u8 {\n    assert(start >= 0 && start <= input.len && length >= 0 && length <= input.len - start)\n    constants: [i64; 64] = [\n        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,\n        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,\n        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,\n        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,\n        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,\n        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,\n        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,\n        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298\n    ]\n    mut h0: i64 = 1779033703; mut h1: i64 = 3144134277\n    mut h2: i64 = 1013904242; mut h3: i64 = 2773480762\n    mut h4: i64 = 1359893119; mut h5: i64 = 2600822924\n    mut h6: i64 = 528734635; mut h7: i64 = 1541459225\n    full := length / 64\n    remainder := length % 64\n    mut tail_length := 64\n    if remainder >= 56 { tail_length = 128 }\n    mut tail: [u8; 128] = [0; 128]\n    for i in 0..remainder { tail[i] = input[start + full * 64 + i] }\n    tail[remainder] = 128\n    bits := i64(length) * 8\n    for i in 0..8 { tail[tail_length - 1 - i] = u8(bits.shr(i * 8).bit_and(255)) }\n\n    mut w: [i64; 64] = [0; 64]\n    for block in 0..full + tail_length / 64 {\n        if block < full {\n            base := start + block * 64\n            for i in 0..16 {\n                at := base + 4 * i\n                w[i] = i64(input[at]).shl(24).bit_or(i64(input[at + 1]).shl(16)).bit_or(i64(input[at + 2]).shl(8)).bit_or(i64(input[at + 3]))\n            }\n        } else {\n            base := (block - full) * 64\n            for i in 0..16 {\n                at := base + 4 * i\n                w[i] = i64(tail[at]).shl(24).bit_or(i64(tail[at + 1]).shl(16)).bit_or(i64(tail[at + 2]).shl(8)).bit_or(i64(tail[at + 3]))\n            }\n        }\n        for i in 16..64 {\n            a := w[i - 15]\n            b := w[i - 2]\n            doubled_a := a.bit_or(a.shl(32))\n            doubled_b := b.bit_or(b.shl(32))\n            s0 := doubled_a.shr(7).bit_xor(doubled_a.shr(18)).bit_xor(a.shr(3)).bit_and(4294967295)\n            s1 := doubled_b.shr(17).bit_xor(doubled_b.shr(19)).bit_xor(b.shr(10)).bit_and(4294967295)\n            w[i] = (w[i - 16] + s0 + w[i - 7] + s1).bit_and(4294967295)\n        }\n        mut a := h0; mut b := h1; mut c := h2; mut d := h3\n        mut e := h4; mut f := h5; mut g := h6; mut h := h7\n        for i in 0..64 {\n            doubled_e := e.bit_or(e.shl(32))\n            doubled_a := a.bit_or(a.shl(32))\n            s1 := doubled_e.shr(6).bit_xor(doubled_e.shr(11)).bit_xor(doubled_e.shr(25)).bit_and(4294967295)\n            choose := g.bit_xor(e.bit_and(f.bit_xor(g)))\n            first := h + s1 + choose + constants[i] + w[i]\n            s0 := doubled_a.shr(2).bit_xor(doubled_a.shr(13)).bit_xor(doubled_a.shr(22)).bit_and(4294967295)\n            majority := a.bit_and(b).bit_or(c.bit_and(a.bit_or(b)))\n            second := s0 + majority\n            h = g; g = f; f = e; e = (d + first).bit_and(4294967295)\n            d = c; c = b; b = a; a = (first + second).bit_and(4294967295)\n        }\n        h0 = (h0 + a).bit_and(4294967295); h1 = (h1 + b).bit_and(4294967295)\n        h2 = (h2 + c).bit_and(4294967295); h3 = (h3 + d).bit_and(4294967295)\n        h4 = (h4 + e).bit_and(4294967295); h5 = (h5 + f).bit_and(4294967295)\n        h6 = (h6 + g).bit_and(4294967295); h7 = (h7 + h).bit_and(4294967295)\n    }\n    mut result: []u8 = []\n    result.reserve(32)\n    push_word(&mut result, h0); push_word(&mut result, h1); push_word(&mut result, h2); push_word(&mut result, h3)\n    push_word(&mut result, h4); push_word(&mut result, h5); push_word(&mut result, h6); push_word(&mut result, h7)\n    result\n}\npub fn digest_bytes(input: &[]u8) -> []u8 {\n    digest_range(&input, 0, input.len)\n}\npub fn digest_text(input: string) -> []u8 {\n    mut packed: []u8 = []\n    packed.reserve(input.len)\n    bytes.append_utf8(&mut packed, input)\n    digest_bytes(&packed)\n}\npub fn digest(input: &[]u8) -> []u8 {\n    digest_bytes(&input)\n}\npub fn hex_bytes(input: &[]u8) -> string {\n    digest := digest_bytes(&input)\n    bytes.hex_u8(&digest)\n}\npub fn hex_text(input: string) -> string {\n    digest := digest_text(input)\n    bytes.hex_u8(&digest)\n}\n@test fn sha256_matches_empty_abc_and_multi_block_reference_vectors() {\n    bytes.hex(&digest_text(\"\")) == \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n    bytes.hex(&digest_text(\"abc\")) == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n    bytes.hex(&digest_text(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")) == \"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1\"\n    bytes.hex_u8(&digest_text(\"abc\")) == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n    hex_text(\"abc\") == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n    raw_abc := bytes.from_text(\"abc\")\n    hex_bytes(&raw_abc) == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n    bytes.hex(&digest(&raw_abc)) == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n}\n@test fn packed_ranges_match_sha256_at_padding_boundaries() {\n    mut input: []u8 = []\n    for i in 0..132 { input.push(u8(i)) }\n    lengths := [0, 55, 56, 63, 64, 65, 128]\n    expected := [\n        \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n        \"4653ce834ad1216507f784697481e2134214fb99e203b0e247d86b941b660707\",\n        \"1d742f4c8c512b0d2811d426f99ccdc16103332fac6c1ae4ffaa27535b2875bb\",\n        \"191b2ec5f9d8dd469ce7ddc71e282a89ea317915b2f4b40e7138a7795ba1191f\",\n        \"795430e15796923a557f9da1d980ec9db341e9acd6da682e1cd86303ce6b0b08\",\n        \"40a81d14a50081b4fdf29d5fb626e24cafdc507026f2de40dec3b0370a0e591e\",\n        \"db0d88f6150bf6e6a5d4ac9507b9a7a6b0d144e07e2e9ab67be9fe741788550c\"\n    ]\n    for i in 0..lengths.len {\n        packed := digest_range(&input, 3, lengths[i])\n        assert(bytes.hex(&packed) == expected[i])\n    }\n}\n" }
    if name == "signal" { return "capability unsafe\n\nimport std.bytes as bytes\nimport sys\n\n@extern(\"c\", \"signal\")\n@thread_safe\nunsafe fn c_signal(sig: i32, handler: ptr) -> ptr\n@extern(\"c\", \"kqueue\")\nunsafe fn c_kqueue() -> i32\n@extern(\"c\", \"kevent\")\nunsafe fn c_kevent(kq: i32, changelist: ptr, nchanges: i32, eventlist: ptr, nevents: i32, timeout: ptr) -> i32\n@extern(\"c\", \"__error\")\nunsafe fn c_errno_ptr() -> ptr\n@extern(\"c\", \"ioctl\")\nunsafe fn c_ioctl(fd: i32, req: usize) -> i32\n\npub enum Signal {\n    Int = 2,\n    Pipe = 13,\n    Term = 15,\n}\n\nimpl Signal {\n    pub fn number(&self) -> i32 {\n        match self {\n            .Int => 2,\n            .Pipe => 13,\n            .Term => 15,\n        }\n    }\n    pub fn from_number(n: i32) -> Option<Signal> {\n        if n == 2 { return .Some(.Int) }\n        if n == 13 { return .Some(.Pipe) }\n        if n == 15 { return .Some(.Term) }\n        .None\n    }\n}\n\nimpl Eq for Signal {\n    fn eq(&self, other: &Self) -> bool { self.number() == other.number() }\n}\nimpl Hash for Signal {\n    fn hash(&self) -> u64 { self.number().hash() }\n}\nimpl Display for Signal {\n    fn str(&self) -> string {\n        match self {\n            .Int => \"SIGINT\",\n            .Pipe => \"SIGPIPE\",\n            .Term => \"SIGTERM\",\n        }\n    }\n}\n\nunsafe fn macos_errno() -> sys.IoError {\n    sys.IoError::from_code(load_i32(c_errno_ptr()))\n}\n\nunsafe fn linux_set_sig_disposition(signo: i32, ignore: bool) -> Result<(), sys.IoError> {\n    handler: u64 = if ignore { 1 } else { 0 }\n    mut act: [u64; 4] = [handler, 0, 0, 0]\n    r := sys.linux_syscall(134, i64(signo), i64(usize(addr(&act[0]))), 0, 8, 0, 0)\n    if r < 0 { return .Err(sys.IoError::from_code(i32(-r))) }\n    .Ok\n}\n\npub fn ignore_sigpipe() -> Result<(), sys.IoError> {\n    if target_is(\"macos\") {\n        unsafe {\n            prev := c_signal(13, ptr(1))\n            if u64(usize(prev)) == u64(18446744073709551615) {\n                return .Err(macos_errno())\n            }\n            return .Ok\n        }\n    } else if target_is(\"linux\") {\n        unsafe { return linux_set_sig_disposition(13, true) }\n    }\n    .Ok\n}\n\npub fn restore_sigpipe() -> Result<(), sys.IoError> {\n    if target_is(\"macos\") {\n        unsafe {\n            prev := c_signal(13, ptr(0))\n            if u64(usize(prev)) == u64(18446744073709551615) {\n                return .Err(macos_errno())\n            }\n            return .Ok\n        }\n    } else if target_is(\"linux\") {\n        unsafe { return linux_set_sig_disposition(13, false) }\n    }\n    .Ok\n}\n\n@resource(dispose)\npub opaque struct SignalWatcher {\n    fd: i32,\n    mask: u32,\n    triggered: bool,\n    last_signal: i32,\n}\n\nimpl SignalWatcher {\n    pub fn watch(signals: &[]Signal) -> Result<Self, sys.IoError> {\n        if signals.len == 0 { return .Err(.InvalidArgument) }\n        mut mask: u32 = 0\n        for s in signals {\n            num := s.number()\n            mask = mask.bit_or(u32(1).shl(num - 1))\n        }\n        if target_is(\"macos\") {\n            unsafe {\n                kq := c_kqueue()\n                if kq < 0 { return .Err(macos_errno()) }\n                _ := c_ioctl(kq, usize(536897025)) // FIOCLEX\n                mut changes: []u64 = []\n                mut installed: []i32 = []\n                for s in signals {\n                    num := s.number()\n                    if c_signal(num, ptr(1)) == ptr(usize(u64(18446744073709551615))) {\n                        err := macos_errno()\n                        for prev_s in installed { _ := c_signal(prev_s, ptr(0)) }\n                        _ := sys.fd_close(kq)\n                        return .Err(err)\n                    }\n                    installed.push(num)\n                    // struct kevent (32 bytes = 4 x u64):\n                    // [0] ident = num\n                    // [1] filter = EVFILT_SIGNAL (-6 -> u16 65530) | flags = EV_ADD|EV_ENABLE|EV_CLEAR (37) << 16 | fflags=0\n                    changes.push(u64(i64(num)))\n                    changes.push(u64(65530).bit_or(u64(37).shl(16)))\n                    changes.push(0)\n                    changes.push(0)\n                }\n                if c_kevent(kq, addr(&changes[0]), signals.len, ptr(0), 0, ptr(0)) < 0 {\n                    err := macos_errno()\n                    for prev_s in installed { _ := c_signal(prev_s, ptr(0)) }\n                    _ := sys.fd_close(kq)\n                    return .Err(err)\n                }\n                return .Ok(Self { fd: kq, mask: mask, triggered: false, last_signal: 0 })\n            }\n        } else if target_is(\"linux\") {\n            unsafe {\n                mut mask64 := u64(mask)\n                // rt_sigprocmask(SIG_BLOCK=0, &mask64, 0, 8) -> syscall 135\n                rm := sys.linux_syscall(135, 0, i64(usize(addr(&mask64))), 0, 8, 0, 0)\n                if rm < 0 { return .Err(sys.IoError::from_code(i32(-rm))) }\n                // signalfd4(-1, &mask64, 8, SFD_NONBLOCK|SFD_CLOEXEC=526336) -> syscall 74\n                sfd := sys.linux_syscall(74, -1, i64(usize(addr(&mask64))), 8, 526336, 0, 0)\n                if sfd < 0 {\n                    _ := sys.linux_syscall(135, 1, i64(usize(addr(&mask64))), 0, 8, 0, 0)\n                    return .Err(sys.IoError::from_code(i32(-sfd)))\n                }\n                return .Ok(Self { fd: i32(sfd), mask: mask, triggered: false, last_signal: 0 })\n            }\n        }\n        .Err(.Unsupported)\n    }\n\n    pub fn shutdown() -> Result<Self, sys.IoError> {\n        match ignore_sigpipe() {\n            .Ok(_) => {},\n            .Err(e) => { return .Err(e) },\n        }\n        sigs: []Signal = [.Int, .Term]\n        SignalWatcher::watch(&sigs)\n    }\n\n    pub fn fd(&self) -> i32 { self.fd }\n    pub fn mask(&self) -> u32 { self.mask }\n    pub fn detach_fd(&mut self) -> i32 {\n        fd := self.fd\n        self.fd = -1\n        fd\n    }\n\n    pub fn poll(&mut self) -> Option<Signal> {\n        if self.fd < 0 { return .None }\n        if target_is(\"macos\") {\n            unsafe {\n                mut ev: [u64; 4] = [0; 4]\n                mut ts: [i64; 2] = [0; 2]\n                n := c_kevent(self.fd, ptr(0), 0, addr(&mut ev[0]), 1, addr(&ts[0]))\n                if n > 0 {\n                    sig_num := i32(ev[0])\n                    self.triggered = true\n                    self.last_signal = sig_num\n                    return Signal::from_number(sig_num)\n                }\n            }\n            return .None\n        } else if target_is(\"linux\") {\n            unsafe {\n                mut buf: []u8 = []\n                buf.reserve(128)\n                n := sys.fd_read(self.fd, &mut buf, 128)\n                if n >= 4 {\n                    sig_num := i32(bytes.u32_le(&buf, 0))\n                    self.triggered = true\n                    self.last_signal = sig_num\n                    return Signal::from_number(sig_num)\n                }\n            }\n            return .None\n        }\n        .None\n    }\n\n    pub fn wait(&mut self, timeout_ms: i64) -> Option<Signal> {\n        if self.fd < 0 { return .None }\n        match self.poll() {\n            .Some(s) => { return .Some(s) },\n            .None => {},\n        }\n        if timeout_ms == 0 { return .None }\n        if target_is(\"macos\") {\n            unsafe {\n                mut ev: [u64; 4] = [0; 4]\n                mut timeout_ptr := ptr(0)\n                mut ts: [i64; 2] = [0; 2]\n                if timeout_ms > 0 {\n                    ts[0] = timeout_ms / 1000\n                    ts[1] = (timeout_ms % 1000) * 1000000\n                    timeout_ptr = addr(&ts[0])\n                }\n                n := c_kevent(self.fd, ptr(0), 0, addr(&mut ev[0]), 1, timeout_ptr)\n                if n > 0 {\n                    sig_num := i32(ev[0])\n                    self.triggered = true\n                    self.last_signal = sig_num\n                    return Signal::from_number(sig_num)\n                }\n            }\n            return .None\n        } else if target_is(\"linux\") {\n            unsafe {\n                mut pfd: []u8 = []\n                bytes.append_le(&mut pfd, i64(self.fd), 4)\n                pfd.push(1); pfd.push(0); pfd.push(0); pfd.push(0) // POLLIN = 1\n                _ := sys.fd_poll(&mut pfd, 1, timeout_ms)\n            }\n            return self.poll()\n        }\n        .None\n    }\n\n    pub fn triggered(&mut self) -> bool {\n        if self.triggered { return true }\n        match self.poll() {\n            .Some(_) => true,\n            .None => false,\n        }\n    }\n\n    pub fn last(&self) -> Option<Signal> {\n        if self.last_signal == 0 { return .None }\n        Signal::from_number(self.last_signal)\n    }\n\n    pub fn close(&mut self) {\n        if self.fd < 0 { return }\n        fd := self.fd\n        mask := self.mask\n        self.fd = -1\n        close_raw_watcher(fd, mask)\n    }\n\n    fn dispose(&mut self) {\n        self.close()\n    }\n}\n\n@thread_safe\npub fn close_raw_watcher(fd: i32, mask: u32) {\n    if fd < 0 { return }\n    if target_is(\"macos\") {\n        unsafe {\n            _ := sys.fd_close(fd)\n            for sig_num in [2, 13, 15] {\n                if mask.bit_and(u32(1).shl(sig_num - 1)) != u32(0) {\n                    _ := c_signal(sig_num, ptr(0))\n                }\n            }\n        }\n    } else if target_is(\"linux\") {\n        unsafe {\n            mut buf: []u8 = []\n            buf.reserve(128)\n            while sys.fd_read(fd, &mut buf, 128) > 0 { buf.clear() }\n            _ := sys.fd_close(fd)\n            mut mask64 := u64(mask)\n            _ := sys.linux_syscall(135, 1, i64(usize(addr(&mask64))), 0, 8, 0, 0)\n        }\n    }\n}\n\n// Global state layout (32 bytes):\n// [0..4]   installed (i32)\n// [4..8]   fd (i32)\n// [8..12]  mask (u32)\n// [12..16] triggered (i32)\n// [16..20] last_signal (i32)\nunsafe fn signal_state_ptr() -> ptr {\n    static_bytes(\"native\", 32)\n}\n\npub fn install_shutdown_handler() -> Result<(), sys.IoError> {\n    if !target_is(\"native\") { return .Ok }\n    unsafe {\n        st := signal_state_ptr()\n        if load_i32(ptr(usize(st))) != 0 { return .Ok }\n        match SignalWatcher::shutdown() {\n            .Ok(mut w) => {\n                store_i32(ptr(usize(st) + usize(4)), w.fd)\n                store_i32(ptr(usize(st) + usize(8)), i32(w.mask))\n                store_i32(ptr(usize(st) + usize(12)), 0)\n                store_i32(ptr(usize(st) + usize(16)), 0)\n                store_i32(ptr(usize(st)), 1)\n                w.fd = -1\n                return .Ok\n            },\n            .Err(e) => { return .Err(e) },\n        }\n    }\n    .Ok\n}\n\npub fn shutdown_fd() -> i32 {\n    if !target_is(\"native\") { return -1 }\n    unsafe {\n        st := signal_state_ptr()\n        if load_i32(ptr(usize(st))) == 0 { return -1 }\n        return load_i32(ptr(usize(st) + usize(4)))\n    }\n    -1\n}\n\npub fn shutdown_requested() -> bool {\n    if !target_is(\"native\") { return false }\n    unsafe {\n        st := signal_state_ptr()\n        if load_i32(ptr(usize(st))) == 0 { return false }\n        if load_i32(ptr(usize(st) + usize(12))) != 0 { return true }\n        fd := load_i32(ptr(usize(st) + usize(4)))\n        mask := u32(load_i32(ptr(usize(st) + usize(8))))\n        mut w := SignalWatcher { fd: fd, mask: mask, triggered: false, last_signal: 0 }\n        hit := w.triggered()\n        if hit {\n            store_i32(ptr(usize(st) + usize(12)), 1)\n            store_i32(ptr(usize(st) + usize(16)), w.last_signal)\n        }\n        w.fd = -1\n        return hit\n    }\n    false\n}\n\npub fn take_shutdown_signal() -> Option<Signal> {\n    if !target_is(\"native\") { return .None }\n    if !shutdown_requested() { return .None }\n    unsafe {\n        st := signal_state_ptr()\n        sig_num := load_i32(ptr(usize(st) + usize(16)))\n        return Signal::from_number(sig_num)\n    }\n    .None\n}\n\npub fn reset_shutdown_handler() {\n    if !target_is(\"native\") { return }\n    unsafe {\n        st := signal_state_ptr()\n        if load_i32(ptr(usize(st))) == 0 { return }\n        fd := load_i32(ptr(usize(st) + usize(4)))\n        mask := u32(load_i32(ptr(usize(st) + usize(8))))\n        mut w := SignalWatcher { fd: fd, mask: mask, triggered: false, last_signal: 0 }\n        w.close()\n        store_i32(ptr(usize(st)), 0)\n        store_i32(ptr(usize(st) + usize(4)), -1)\n        store_i32(ptr(usize(st) + usize(8)), 0)\n        store_i32(ptr(usize(st) + usize(12)), 0)\n        store_i32(ptr(usize(st) + usize(16)), 0)\n    }\n}\n" }
    if name == "sync" { return "capability unsafe\n\nimport std.net as net\nimport std.signal as signal\nimport sys\n\n@extern(\"c\", \"pipe\")\n@thread_safe\nunsafe fn sync_c_pipe(fds: ptr) -> i32\n@extern(\"c\", \"read\")\n@thread_safe\nunsafe fn sync_c_read(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"write\")\n@thread_safe\nunsafe fn sync_c_write(fd: i32, buf: ptr, count: usize) -> i64\n@extern(\"c\", \"ioctl\")\n@thread_safe\nunsafe fn sync_c_ioctl(fd: i32, req: usize) -> i32\n@extern(\"c\", \"mmap\")\n@thread_safe\nunsafe fn sync_c_mmap(address: ptr, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> ptr\n@extern(\"c\", \"munmap\")\n@thread_safe\nunsafe fn sync_c_munmap(address: ptr, length: usize) -> i32\n\n@thread_safe\nunsafe fn sync_page_bytes() -> usize {\n    if target_is(\"macos\") { return usize(16384) }\n    if target_is(\"linux\") { return usize(4096) }\n    usize(4096)\n}\n\n@thread_safe\nunsafe fn mini_pool_bytes() -> i64 { 16384 }\n\n@thread_safe\nunsafe fn align_up(value: usize, align: usize) -> usize {\n    rem := value % align\n    if rem == usize(0) { value } else { value + (align - rem) }\n}\n\n@thread_safe\nunsafe fn sync_mmap(length: usize) -> ptr {\n    if target_is(\"macos\") {\n        raw := sync_c_mmap(ptr(0), length, 3, 4098, -1, 0)\n        failed := usize(0).wrapping_sub(usize(1))\n        assert(usize(raw) != usize(0) && usize(raw) != failed)\n        return raw\n    }\n    if target_is(\"linux\") {\n        r := sys.linux_syscall(222, 0, i64(length), 3, 34, -1, 0)\n        assert(r > 0)\n        return ptr(usize(r))\n    }\n    raw := sys.pool_alloc_try(length)\n    assert(usize(raw) != usize(0))\n    sys.memory_zero(raw, length)\n    raw\n}\n\n@thread_safe\nunsafe fn sync_munmap(raw: ptr, length: usize) {\n    if usize(raw) == usize(0) { return }\n    if target_is(\"macos\") {\n        _ := sync_c_munmap(raw, length)\n    } else if target_is(\"linux\") {\n        _ := sys.linux_syscall(215, i64(usize(raw)), i64(length), 0, 0, 0, 0)\n    } else {\n        sys.pool_free(raw)\n    }\n}\n\n@thread_safe\nunsafe fn unmap_extra_slabs(pool: ptr) {\n    mut extra := load_ptr(ptr(usize(pool) + usize(240)))\n    store_ptr(ptr(usize(pool) + usize(240)), ptr(0))\n    while usize(extra) != usize(0) {\n        next := load_ptr(extra)\n        slab_len := load_i64(ptr(usize(extra) + usize(8)))\n        sync_munmap(extra, usize(slab_len))\n        extra = next\n    }\n}\n\n@thread_safe\nunsafe fn reset_mini_pool(pool: ptr) {\n    if usize(pool) == usize(0) || !target_is(\"native\") { return }\n    unmap_extra_slabs(pool)\n    sys.memory_zero(pool, usize(512))\n}\n\n@thread_safe\nunsafe fn unmap_mini_pool(pool: ptr, pool_size: i64) {\n    if usize(pool) == usize(0) { return }\n    if target_is(\"native\") {\n        unmap_extra_slabs(pool)\n        sync_munmap(pool, usize(pool_size))\n    } else {\n        sys.pool_free(pool)\n    }\n}\n\n@thread_safe\nunsafe fn spin_lock(lock: ptr) {\n    mut spins: i32 = 0\n    while sys.atomic_cas_i64(lock, 0, 1) != 0 {\n        spins += 1\n        if spins >= 64 {\n            sys.sleep_ms(1)\n            spins = 0\n        }\n    }\n}\n\n@thread_safe\nunsafe fn spin_unlock(lock: ptr) {\n    sys.atomic_store_i64(lock, 0)\n}\n\n@thread_safe\nunsafe fn wake_pair_open() -> (i32, i32, i64) {\n    if target_is(\"macos\") {\n        mut fds_raw: i64 = 0\n        assert(sync_c_pipe(addr(&mut fds_raw)) == 0)\n        rfd := load_i32(addr(&fds_raw))\n        wfd := load_i32(ptr(usize(addr(&fds_raw)) + usize(4)))\n        _ := sys.fd_set_nonblocking(rfd, true)\n        _ := sys.fd_set_nonblocking(wfd, true)\n        _ := sync_c_ioctl(rfd, usize(536897025))\n        _ := sync_c_ioctl(wfd, usize(536897025))\n        return (rfd, wfd, 0)\n    }\n    if target_is(\"linux\") {\n        efd := sys.linux_syscall(19, 0, 526336, 0, 0, 0, 0)\n        assert(efd >= 0)\n        return (i32(efd), -1, 1)\n    }\n    (-1, -1, 0)\n}\n\n@thread_safe\nunsafe fn wake_pair_signal(rfd: i32, wfd: i32, is_efd: i64) {\n    if is_efd != 0 && rfd >= 0 {\n        mut val: u64 = 1\n        _ := sys.linux_syscall(64, i64(rfd), i64(usize(addr(&val))), 8, 0, 0, 0)\n    } else if wfd >= 0 {\n        mut b: i64 = 1\n        if target_is(\"macos\") {\n            _ := sync_c_write(wfd, addr(&b), usize(1))\n        } else if target_is(\"linux\") {\n            _ := sys.linux_syscall(64, i64(wfd), i64(usize(addr(&b))), 1, 0, 0, 0)\n        }\n    }\n}\n\n@thread_safe\nunsafe fn wake_pair_drain(rfd: i32, is_efd: i64) {\n    if is_efd != 0 && rfd >= 0 {\n        mut val: u64 = 0\n        while sys.linux_syscall(63, i64(rfd), i64(usize(addr(&mut val))), 8, 0, 0, 0) > 0 {}\n    } else if rfd >= 0 {\n        mut buf: [u64; 8] = [0; 8]\n        if target_is(\"macos\") {\n            while sync_c_read(rfd, addr(&mut buf[0]), usize(64)) > 0 {}\n        } else if target_is(\"linux\") {\n            while sys.linux_syscall(63, i64(rfd), i64(usize(addr(&mut buf[0]))), 64, 0, 0, 0) > 0 {}\n        }\n    }\n}\n\n@thread_safe\nunsafe fn wake_pair_close(rfd: i32, wfd: i32, is_efd: i64) {\n    if rfd >= 0 { _ := sys.fd_close(rfd) }\n    if is_efd == 0 && wfd >= 0 && wfd != rfd { _ := sys.fd_close(wfd) }\n}\n\n@thread_safe\nunsafe fn poll_wait_raw(fds: &[]i32, timeout_ms: i64, revents_out: &mut []i32) -> i32 {\n    count := fds.len\n    revents_out.clear()\n    for _ in 0..count { revents_out.push(0) }\n    if count == 0 {\n        if timeout_ms > 0 { sys.sleep_ms(timeout_ms) }\n        return 0\n    }\n    mut pfd: []u8 = []\n    pfd.reserve(count * 8)\n    for _ in 0..(count * 8) { pfd.push(0) }\n    for i in 0..count {\n        base := i * 8\n        u := i64(fds[i]).bit_and(0xffffffff)\n        pfd[base] = u8(u.bit_and(0xff))\n        pfd[base + 1] = u8(u.shr(8).bit_and(0xff))\n        pfd[base + 2] = u8(u.shr(16).bit_and(0xff))\n        pfd[base + 3] = u8(u.shr(24).bit_and(0xff))\n        pfd[base + 4] = 1\n        pfd[base + 5] = 0\n        pfd[base + 6] = 0\n        pfd[base + 7] = 0\n    }\n    n := sys.fd_poll(&mut pfd, i64(count), timeout_ms)\n    if n < 0 { return i32(n) }\n    for i in 0..count {\n        base := i * 8\n        revents_out[i] = i32(pfd[base + 6]) + i32(pfd[base + 7]).shl(8)\n    }\n    i32(n)\n}\n\n@thread_safe\nunsafe fn poll_fd_ready_zero(fd: i32) -> bool {\n    if fd < 0 { return false }\n    fds: []i32 = [fd]\n    mut revs: []i32 = []\n    n := poll_wait_raw(&fds, 0, &mut revs)\n    n > 0 && revs[0] != 0\n}\n\n// =========================================================================\n// AtomicI64 & AtomicBool\n// =========================================================================\n\n@resource(dispose)\npub opaque struct AtomicI64 { state: ptr }\nimpl Sendable for AtomicI64 {}\n\nimpl AtomicI64 {\n    @thread_safe\n    pub fn new(initial: i64) -> Self {\n        unsafe {\n            st := sync_mmap(sync_page_bytes())\n            sys.atomic_store_i64(st, 1)\n            sys.atomic_store_i64(ptr(usize(st) + usize(8)), initial)\n            return Self { state: st }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn clone_handle(&self) -> Self {\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn load(&self) -> i64 {\n        unsafe { return sys.atomic_load_i64(ptr(usize(self.state) + usize(8))) }\n        0\n    }\n\n    @thread_safe\n    pub fn store(&self, value: i64) {\n        unsafe { sys.atomic_store_i64(ptr(usize(self.state) + usize(8)), value) }\n    }\n\n    @thread_safe\n    pub fn swap(&self, value: i64) -> i64 {\n        unsafe {\n            val_ptr := ptr(usize(self.state) + usize(8))\n            while true {\n                cur := sys.atomic_load_i64(val_ptr)\n                if sys.atomic_cas_i64(val_ptr, cur, value) == cur { return cur }\n            }\n        }\n        0\n    }\n\n    @thread_safe\n    pub fn compare_exchange(&self, expected: i64, desired: i64) -> (bool, i64) {\n        unsafe {\n            prev := sys.atomic_cas_i64(ptr(usize(self.state) + usize(8)), expected, desired)\n            return (prev == expected, prev)\n        }\n        (false, 0)\n    }\n\n    @thread_safe\n    pub fn fetch_add(&self, delta: i64) -> i64 {\n        unsafe { return sys.atomic_fetch_add_i64(ptr(usize(self.state) + usize(8)), delta) }\n        0\n    }\n\n    @thread_safe\n    pub fn fetch_sub(&self, delta: i64) -> i64 {\n        self.fetch_add(-delta)\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            if usize(st) == usize(0) { return }\n            if sys.atomic_fetch_add_i64(st, -1) == 1 {\n                sync_munmap(st, sync_page_bytes())\n            }\n        }\n    }\n}\n\n@resource(dispose)\npub opaque struct AtomicBool { state: ptr }\nimpl Sendable for AtomicBool {}\n\nimpl AtomicBool {\n    @thread_safe\n    pub fn new(initial: bool) -> Self {\n        unsafe {\n            st := sync_mmap(sync_page_bytes())\n            sys.atomic_store_i64(st, 1)\n            sys.atomic_store_i64(ptr(usize(st) + usize(8)), if initial { 1 } else { 0 })\n            return Self { state: st }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn clone_handle(&self) -> Self {\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn load(&self) -> bool {\n        unsafe { return sys.atomic_load_i64(ptr(usize(self.state) + usize(8))) != 0 }\n        false\n    }\n\n    @thread_safe\n    pub fn store(&self, value: bool) {\n        unsafe { sys.atomic_store_i64(ptr(usize(self.state) + usize(8)), if value { 1 } else { 0 }) }\n    }\n\n    @thread_safe\n    pub fn swap(&self, value: bool) -> bool {\n        unsafe {\n            val_ptr := ptr(usize(self.state) + usize(8))\n            des: i64 = if value { 1 } else { 0 }\n            while true {\n                cur := sys.atomic_load_i64(val_ptr)\n                if sys.atomic_cas_i64(val_ptr, cur, des) == cur { return cur != 0 }\n            }\n        }\n        false\n    }\n\n    @thread_safe\n    pub fn compare_exchange(&self, expected: bool, desired: bool) -> (bool, bool) {\n        unsafe {\n            exp: i64 = if expected { 1 } else { 0 }\n            des: i64 = if desired { 1 } else { 0 }\n            prev := sys.atomic_cas_i64(ptr(usize(self.state) + usize(8)), exp, des)\n            return (prev == exp, prev != 0)\n        }\n        (false, false)\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            if usize(st) == usize(0) { return }\n            if sys.atomic_fetch_add_i64(st, -1) == 1 {\n                sync_munmap(st, sync_page_bytes())\n            }\n        }\n    }\n}\n\n// =========================================================================\n// Semaphore & SemaphorePermit\n// Layout (page):\n//   [0]  refcount\n//   [8]  lock\n//   [16] permits\n//   [24] rfd\n//   [32] wfd\n//   [40] is_efd\n//   [48] signaled (level-triggered: permits > 0)\n// =========================================================================\n\n@resource(dispose)\npub opaque struct Semaphore { state: ptr }\nimpl Sendable for Semaphore {}\n\n@resource(dispose)\npub opaque struct SemaphorePermit { state: ptr }\nimpl Sendable for SemaphorePermit {}\n\n@thread_safe\nunsafe fn sem_release_raw(st: ptr, count: i64) {\n    assert(count > 0)\n    spin_lock(ptr(usize(st) + usize(8)))\n    p_ptr := ptr(usize(st) + usize(16))\n    prev := sys.atomic_load_i64(p_ptr)\n    next := prev + count\n    sys.atomic_store_i64(p_ptr, next)\n    sig_ptr := ptr(usize(st) + usize(48))\n    if next > 0 && sys.atomic_load_i64(sig_ptr) == 0 {\n        rfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(24))))\n        wfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(32))))\n        is_efd := sys.atomic_load_i64(ptr(usize(st) + usize(40)))\n        wake_pair_signal(rfd, wfd, is_efd)\n        sys.atomic_store_i64(sig_ptr, 1)\n    }\n    spin_unlock(ptr(usize(st) + usize(8)))\n}\n\n@thread_safe\nunsafe fn sem_try_acquire_raw(st: ptr) -> bool {\n    spin_lock(ptr(usize(st) + usize(8)))\n    p_ptr := ptr(usize(st) + usize(16))\n    cur := sys.atomic_load_i64(p_ptr)\n    mut ok := false\n    if cur > 0 {\n        next := cur - 1\n        sys.atomic_store_i64(p_ptr, next)\n        if next == 0 {\n            sig_ptr := ptr(usize(st) + usize(48))\n            if sys.atomic_load_i64(sig_ptr) != 0 {\n                rfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(24))))\n                is_efd := sys.atomic_load_i64(ptr(usize(st) + usize(40)))\n                wake_pair_drain(rfd, is_efd)\n                sys.atomic_store_i64(sig_ptr, 0)\n            }\n        }\n        ok = true\n    }\n    spin_unlock(ptr(usize(st) + usize(8)))\n    ok\n}\n\n@thread_safe\nunsafe fn sem_state_drop(st: ptr) {\n    if usize(st) == usize(0) { return }\n    if sys.atomic_fetch_add_i64(st, -1) != 1 { return }\n    rfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(24))))\n    wfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(32))))\n    is_efd := sys.atomic_load_i64(ptr(usize(st) + usize(40)))\n    wake_pair_close(rfd, wfd, is_efd)\n    sync_munmap(st, sync_page_bytes())\n}\n\nimpl Semaphore {\n    @thread_safe\n    pub fn new(permits: i64) -> Self {\n        assert(permits >= 0)\n        unsafe {\n            st := sync_mmap(sync_page_bytes())\n            pair := wake_pair_open()\n            sys.atomic_store_i64(st, 1)\n            sys.atomic_store_i64(ptr(usize(st) + usize(8)), 0)\n            sys.atomic_store_i64(ptr(usize(st) + usize(16)), permits)\n            sys.atomic_store_i64(ptr(usize(st) + usize(24)), i64(pair.0))\n            sys.atomic_store_i64(ptr(usize(st) + usize(32)), i64(pair.1))\n            sys.atomic_store_i64(ptr(usize(st) + usize(40)), pair.2)\n            if permits > 0 {\n                wake_pair_signal(pair.0, pair.1, pair.2)\n                sys.atomic_store_i64(ptr(usize(st) + usize(48)), 1)\n            } else {\n                sys.atomic_store_i64(ptr(usize(st) + usize(48)), 0)\n            }\n            return Self { state: st }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn clone_handle(&self) -> Self {\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn available(&self) -> i64 {\n        unsafe { return sys.atomic_load_i64(ptr(usize(self.state) + usize(16))) }\n        0\n    }\n\n    @thread_safe\n    pub fn try_acquire(&self) -> bool {\n        unsafe { return sem_try_acquire_raw(self.state) }\n        false\n    }\n\n    @thread_safe\n    pub fn acquire(&self) {\n        _ := self.acquire_timeout(-1)\n    }\n\n    @thread_safe\n    pub fn acquire_timeout(&self, timeout_ms: i64) -> bool {\n        unsafe {\n            if sem_try_acquire_raw(self.state) { return true }\n            if timeout_ms == 0 { return false }\n            deadline := if timeout_ms > 0 { sys.now_ms() + timeout_ms } else { 0 }\n            rfd := i32(sys.atomic_load_i64(ptr(usize(self.state) + usize(24))))\n            fds: []i32 = [rfd]\n            mut revs: []i32 = []\n            while true {\n                if sem_try_acquire_raw(self.state) { return true }\n                mut delay: i64 = -1\n                if timeout_ms > 0 {\n                    rem := deadline - sys.now_ms()\n                    if rem <= 0 { return sem_try_acquire_raw(self.state) }\n                    delay = rem\n                }\n                if rfd < 0 {\n                    sys.sleep_ms(if delay < 0 || delay > 1 { 1 } else { delay })\n                    continue\n                }\n                _ := poll_wait_raw(&fds, delay, &mut revs)\n            }\n        }\n        false\n    }\n\n    @thread_safe\n    pub fn try_acquire_permit(&self) -> Option<SemaphorePermit> {\n        unsafe {\n            if !sem_try_acquire_raw(self.state) { return .None }\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return .Some(SemaphorePermit { state: self.state })\n        }\n        .None\n    }\n\n    @thread_safe\n    pub fn acquire_permit(&self) -> SemaphorePermit {\n        self.acquire()\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return SemaphorePermit { state: self.state }\n        }\n        unsafe { SemaphorePermit { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn release(&self) {\n        unsafe { sem_release_raw(self.state, 1) }\n    }\n\n    @thread_safe\n    pub fn release_many(&self, count: i64) {\n        unsafe { sem_release_raw(self.state, count) }\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            sem_state_drop(st)\n        }\n    }\n}\n\nimpl SemaphorePermit {\n    @thread_safe\n    pub fn release(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            if usize(st) == usize(0) { return }\n            sem_release_raw(st, 1)\n            sem_state_drop(st)\n        }\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        self.release()\n    }\n}\n\n// =========================================================================\n// CancelToken (integrated with std.signal & net.Waker)\n// Layout (page):\n//   [0]   refcount\n//   [8]   cancelled (0/1)\n//   [16]  lock\n//   [24]  rfd\n//   [32]  wfd\n//   [40]  is_efd\n//   [48]  sig_fd (-1 if none)\n//   [56]  sig_mask\n//   [64]  owns_sig (1 if dispose calls signal.close_raw_watcher)\n//   [72]  children_ptr (mmap ptr array of child CancelToken state ptrs)\n//   [80]  children_len\n//   [88]  children_cap\n//   [96]  wakers_ptr (mmap ptr array of retained net.Waker state ptrs)\n//   [104] wakers_len\n//   [112] wakers_cap\n//   [120] children_bytes\n//   [128] wakers_bytes\n// =========================================================================\n\n@resource(dispose)\npub opaque struct CancelToken { state: ptr }\nimpl Sendable for CancelToken {}\n\n@thread_safe\nunsafe fn cancel_token_alloc(sig_fd: i32, sig_mask: u32, owns_sig: i64, cancelled_init: i64) -> ptr {\n    st := sync_mmap(sync_page_bytes())\n    pair := wake_pair_open()\n    sys.atomic_store_i64(st, 1)\n    sys.atomic_store_i64(ptr(usize(st) + usize(8)), cancelled_init)\n    sys.atomic_store_i64(ptr(usize(st) + usize(16)), 0)\n    sys.atomic_store_i64(ptr(usize(st) + usize(24)), i64(pair.0))\n    sys.atomic_store_i64(ptr(usize(st) + usize(32)), i64(pair.1))\n    sys.atomic_store_i64(ptr(usize(st) + usize(40)), pair.2)\n    sys.atomic_store_i64(ptr(usize(st) + usize(48)), i64(sig_fd))\n    sys.atomic_store_i64(ptr(usize(st) + usize(56)), i64(sig_mask))\n    sys.atomic_store_i64(ptr(usize(st) + usize(64)), owns_sig)\n    store_ptr(ptr(usize(st) + usize(72)), ptr(0))\n    store_i64(ptr(usize(st) + usize(80)), 0)\n    store_i64(ptr(usize(st) + usize(88)), 0)\n    store_ptr(ptr(usize(st) + usize(96)), ptr(0))\n    store_i64(ptr(usize(st) + usize(104)), 0)\n    store_i64(ptr(usize(st) + usize(112)), 0)\n    store_i64(ptr(usize(st) + usize(120)), 0)\n    store_i64(ptr(usize(st) + usize(128)), 0)\n    if cancelled_init != 0 {\n        wake_pair_signal(pair.0, pair.1, pair.2)\n    }\n    st\n}\n\n@thread_safe\nunsafe fn cancel_push_ptr(list_slot: ptr, len_slot: ptr, cap_slot: ptr, bytes_slot: ptr, item: ptr) {\n    mut arr := load_ptr(list_slot)\n    n := load_i64(len_slot)\n    mut cap := load_i64(cap_slot)\n    if n >= cap {\n        mut next_cap := cap * 2\n        if next_cap < 16 { next_cap = 16 }\n        page := sync_page_bytes()\n        next_bytes := align_up(usize(next_cap) * usize(8), page)\n        next_arr := sync_mmap(next_bytes)\n        if n > 0 && usize(arr) != usize(0) {\n            sys.memory_copy(next_arr, arr, usize(n) * usize(8))\n        }\n        if usize(arr) != usize(0) {\n            old_bytes := load_i64(bytes_slot)\n            sync_munmap(arr, usize(old_bytes))\n        }\n        arr = next_arr\n        cap = i64(next_bytes / usize(8))\n        store_ptr(list_slot, arr)\n        store_i64(cap_slot, cap)\n        store_i64(bytes_slot, i64(next_bytes))\n    }\n    store_ptr(ptr(usize(arr) + usize(n) * usize(8)), item)\n    store_i64(len_slot, n + 1)\n}\n\n@thread_safe\nunsafe fn cancel_state_release(st: ptr) {\n    if usize(st) == usize(0) { return }\n    if sys.atomic_fetch_add_i64(st, -1) != 1 { return }\n    c_arr := load_ptr(ptr(usize(st) + usize(72)))\n    c_len := load_i64(ptr(usize(st) + usize(80)))\n    c_bytes := load_i64(ptr(usize(st) + usize(120)))\n    for i in 0..i32(c_len) {\n        child_st := load_ptr(ptr(usize(c_arr) + usize(i) * usize(8)))\n        cancel_state_release(child_st)\n    }\n    if usize(c_arr) != usize(0) { sync_munmap(c_arr, usize(c_bytes)) }\n    w_arr := load_ptr(ptr(usize(st) + usize(96)))\n    w_len := load_i64(ptr(usize(st) + usize(104)))\n    w_bytes := load_i64(ptr(usize(st) + usize(128)))\n    for i in 0..i32(w_len) {\n        w_st := load_ptr(ptr(usize(w_arr) + usize(i) * usize(8)))\n        net.waker_release_raw(w_st)\n    }\n    if usize(w_arr) != usize(0) { sync_munmap(w_arr, usize(w_bytes)) }\n    rfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(24))))\n    wfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(32))))\n    is_efd := sys.atomic_load_i64(ptr(usize(st) + usize(40)))\n    wake_pair_close(rfd, wfd, is_efd)\n    sfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(48))))\n    smask := u32(sys.atomic_load_i64(ptr(usize(st) + usize(56))))\n    owns_sig := sys.atomic_load_i64(ptr(usize(st) + usize(64)))\n    if owns_sig != 0 && sfd >= 0 {\n        signal.close_raw_watcher(sfd, smask)\n    }\n    sync_munmap(st, sync_page_bytes())\n}\n\n@thread_safe\nunsafe fn cancel_state_fire(st: ptr) {\n    if usize(st) == usize(0) { return }\n    if sys.atomic_cas_i64(ptr(usize(st) + usize(8)), 0, 1) != 0 { return }\n    rfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(24))))\n    wfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(32))))\n    is_efd := sys.atomic_load_i64(ptr(usize(st) + usize(40)))\n    wake_pair_signal(rfd, wfd, is_efd)\n    spin_lock(ptr(usize(st) + usize(16)))\n    c_arr := load_ptr(ptr(usize(st) + usize(72)))\n    c_len := load_i64(ptr(usize(st) + usize(80)))\n    c_bytes := load_i64(ptr(usize(st) + usize(120)))\n    store_ptr(ptr(usize(st) + usize(72)), ptr(0))\n    store_i64(ptr(usize(st) + usize(80)), 0)\n    store_i64(ptr(usize(st) + usize(88)), 0)\n    store_i64(ptr(usize(st) + usize(120)), 0)\n    w_arr := load_ptr(ptr(usize(st) + usize(96)))\n    w_len := load_i64(ptr(usize(st) + usize(104)))\n    w_bytes := load_i64(ptr(usize(st) + usize(128)))\n    store_ptr(ptr(usize(st) + usize(96)), ptr(0))\n    store_i64(ptr(usize(st) + usize(104)), 0)\n    store_i64(ptr(usize(st) + usize(112)), 0)\n    store_i64(ptr(usize(st) + usize(128)), 0)\n    spin_unlock(ptr(usize(st) + usize(16)))\n    for i in 0..i32(c_len) {\n        child_st := load_ptr(ptr(usize(c_arr) + usize(i) * usize(8)))\n        cancel_state_fire(child_st)\n        cancel_state_release(child_st)\n    }\n    if usize(c_arr) != usize(0) { sync_munmap(c_arr, usize(c_bytes)) }\n    for i in 0..i32(w_len) {\n        w_st := load_ptr(ptr(usize(w_arr) + usize(i) * usize(8)))\n        net.waker_wake_raw(w_st)\n        net.waker_release_raw(w_st)\n    }\n    if usize(w_arr) != usize(0) { sync_munmap(w_arr, usize(w_bytes)) }\n}\n\n@thread_safe\nunsafe fn cancel_state_is_cancelled(st: ptr) -> bool {\n    if usize(st) == usize(0) { return false }\n    if sys.atomic_load_i64(ptr(usize(st) + usize(8))) != 0 { return true }\n    sfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(48))))\n    if sfd >= 0 && poll_fd_ready_zero(sfd) {\n        cancel_state_fire(st)\n        return true\n    }\n    false\n}\n\n@thread_safe\nunsafe fn cancel_collect_fds(st: ptr, out: &mut []i32) {\n    if usize(st) == usize(0) { return }\n    rfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(24))))\n    if rfd >= 0 { out.push(rfd) }\n    sfd := i32(sys.atomic_load_i64(ptr(usize(st) + usize(48))))\n    if sfd >= 0 { out.push(sfd) }\n}\n\nimpl CancelToken {\n    @thread_safe\n    pub fn new() -> Self {\n        unsafe { return Self { state: cancel_token_alloc(-1, u32(0), 0, 0) } }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn from_signal_watcher(mut move watcher: signal.SignalWatcher) -> Result<Self, sys.IoError> {\n        mask := watcher.mask()\n        fd := watcher.detach_fd()\n        if fd < 0 { return .Err(.BadDescriptor) }\n        unsafe { return .Ok(Self { state: cancel_token_alloc(fd, mask, 1, 0) }) }\n        .Err(.Unsupported)\n    }\n\n    @thread_safe\n    pub fn on_shutdown_signals() -> Result<Self, sys.IoError> {\n        w := signal.SignalWatcher::shutdown()?\n        Self::from_signal_watcher(move w)\n    }\n\n    pub fn from_shutdown_handler() -> Self {\n        fd := signal.shutdown_fd()\n        triggered := if signal.shutdown_requested() { i64(1) } else { i64(0) }\n        unsafe { return Self { state: cancel_token_alloc(fd, u32(0), 0, triggered) } }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn clone_handle(&self) -> Self {\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn child(&self) -> Self {\n        unsafe {\n            if cancel_state_is_cancelled(self.state) {\n                return Self { state: cancel_token_alloc(-1, u32(0), 0, 1) }\n            }\n            c_st := cancel_token_alloc(-1, u32(0), 0, 0)\n            _ := sys.atomic_fetch_add_i64(c_st, 1)\n            spin_lock(ptr(usize(self.state) + usize(16)))\n            already := sys.atomic_load_i64(ptr(usize(self.state) + usize(8))) != 0\n            if !already {\n                cancel_push_ptr(\n                    ptr(usize(self.state) + usize(72)),\n                    ptr(usize(self.state) + usize(80)),\n                    ptr(usize(self.state) + usize(88)),\n                    ptr(usize(self.state) + usize(120)),\n                    c_st\n                )\n            }\n            spin_unlock(ptr(usize(self.state) + usize(16)))\n            if already {\n                cancel_state_fire(c_st)\n                cancel_state_release(c_st)\n            }\n            return Self { state: c_st }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn cancel(&self) {\n        unsafe { cancel_state_fire(self.state) }\n    }\n\n    @thread_safe\n    pub fn is_cancelled(&self) -> bool {\n        unsafe { return cancel_state_is_cancelled(self.state) }\n        false\n    }\n\n    @thread_safe\n    pub fn fd(&self) -> i32 {\n        unsafe { return i32(sys.atomic_load_i64(ptr(usize(self.state) + usize(24)))) }\n        -1\n    }\n\n    @thread_safe\n    pub fn signal_fd(&self) -> i32 {\n        unsafe { return i32(sys.atomic_load_i64(ptr(usize(self.state) + usize(48)))) }\n        -1\n    }\n\n    @thread_safe\n    pub fn attach_waker(&self, waker: &net.Waker) {\n        unsafe {\n            w_st := waker.raw_state()\n            if usize(w_st) == usize(0) { return }\n            if cancel_state_is_cancelled(self.state) {\n                net.waker_wake_raw(w_st)\n                return\n            }\n            net.waker_retain_raw(w_st)\n            spin_lock(ptr(usize(self.state) + usize(16)))\n            already := sys.atomic_load_i64(ptr(usize(self.state) + usize(8))) != 0\n            if !already {\n                cancel_push_ptr(\n                    ptr(usize(self.state) + usize(96)),\n                    ptr(usize(self.state) + usize(104)),\n                    ptr(usize(self.state) + usize(112)),\n                    ptr(usize(self.state) + usize(128)),\n                    w_st\n                )\n            }\n            spin_unlock(ptr(usize(self.state) + usize(16)))\n            if already {\n                net.waker_wake_raw(w_st)\n                net.waker_release_raw(w_st)\n            }\n        }\n    }\n\n    @thread_safe\n    pub fn register_poll(&self, poll: &mut net.PollSet) {\n        rfd := self.fd()\n        if rfd >= 0 { poll.add(rfd, net.poll_in()) }\n        sfd := self.signal_fd()\n        if sfd >= 0 { poll.add(sfd, net.poll_in()) }\n    }\n\n    @thread_safe\n    pub fn wait(&self) {\n        _ := self.wait_timeout(-1)\n    }\n\n    @thread_safe\n    pub fn wait_timeout(&self, timeout_ms: i64) -> bool {\n        unsafe {\n            if cancel_state_is_cancelled(self.state) { return true }\n            if timeout_ms == 0 { return false }\n            deadline := if timeout_ms > 0 { sys.now_ms() + timeout_ms } else { 0 }\n            mut fds: []i32 = []\n            cancel_collect_fds(self.state, &mut fds)\n            mut revs: []i32 = []\n            while true {\n                if cancel_state_is_cancelled(self.state) { return true }\n                mut delay: i64 = -1\n                if timeout_ms > 0 {\n                    rem := deadline - sys.now_ms()\n                    if rem <= 0 { return cancel_state_is_cancelled(self.state) }\n                    delay = rem\n                }\n                if fds.len == 0 {\n                    sys.sleep_ms(if delay < 0 || delay > 1 { 1 } else { delay })\n                    continue\n                }\n                _ := poll_wait_raw(&fds, delay, &mut revs)\n            }\n        }\n        false\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            cancel_state_release(st)\n        }\n    }\n}\n\n// =========================================================================\n// Bounded Channel<T> (Sender<T> / Receiver<T>, T: Sendable)\n// Header layout (256 bytes) + ring buffer (capacity * 16 bytes):\n//   [0]   send_refs (i64)\n//   [8]   recv_refs (i64)\n//   [16]  total_refs (i64)\n//   [24]  lock (i64)\n//   [32]  capacity (i64)\n//   [40]  head (i64)\n//   [48]  tail (i64)\n//   [56]  count (i64)\n//   [64]  send_closed (i64)\n//   [72]  recv_closed (i64)\n//   [80]  ne_rfd\n//   [88]  ne_wfd\n//   [96]  ne_efd\n//   [104] nf_rfd\n//   [112] nf_wfd\n//   [120] nf_efd\n//   [128] rx_waker (ptr)\n//   [136] tx_waker (ptr)\n//   [144] alloc_bytes (i64)\n//   [152] pool_cache_count (i64, <= 8)\n//   [160..224] pool_cache[0..8]\n//   [224] ne_signaled (i64)\n//   [232] nf_signaled (i64)\n//   [256..] ring slots: 16 bytes each (packed_word: i64, pool: ptr)\n// =========================================================================\n\npub enum TryRecv<T> {\n    Value(T),\n    Empty,\n    Closed,\n}\n\npub enum SendResult<T> {\n    Ok,\n    Full(T),\n    Closed(T),\n    TimedOut(T),\n    Cancelled(T),\n}\n\npub enum Select2<A, B> {\n    First(Option<A>),\n    Second(Option<B>),\n    Timeout,\n    Cancelled,\n}\n\n@resource(dispose)\npub opaque struct Sender<T> { state: ptr }\nimpl Sendable for Sender<T> where T: Sendable {}\n\n@resource(dispose)\npub opaque struct Receiver<T> { state: ptr }\nimpl Sendable for Receiver<T> where T: Sendable {}\n\n@thread_safe\nunsafe fn chan_sync_signals_locked(st: ptr) {\n    count := load_i64(ptr(usize(st) + usize(56)))\n    cap := load_i64(ptr(usize(st) + usize(32)))\n    sc := load_i64(ptr(usize(st) + usize(64)))\n    rc := load_i64(ptr(usize(st) + usize(72)))\n\n    want_ne: i64 = if count > 0 || sc != 0 { 1 } else { 0 }\n    want_nf: i64 = if count < cap || rc != 0 { 1 } else { 0 }\n\n    ne_sig_ptr := ptr(usize(st) + usize(224))\n    nf_sig_ptr := ptr(usize(st) + usize(232))\n    cur_ne := load_i64(ne_sig_ptr)\n    cur_nf := load_i64(nf_sig_ptr)\n\n    if want_ne != cur_ne {\n        rfd := i32(load_i64(ptr(usize(st) + usize(80))))\n        wfd := i32(load_i64(ptr(usize(st) + usize(88))))\n        efd := load_i64(ptr(usize(st) + usize(96)))\n        if want_ne != 0 { wake_pair_signal(rfd, wfd, efd) } else { wake_pair_drain(rfd, efd) }\n        store_i64(ne_sig_ptr, want_ne)\n    }\n    if want_nf != cur_nf {\n        rfd := i32(load_i64(ptr(usize(st) + usize(104))))\n        wfd := i32(load_i64(ptr(usize(st) + usize(112))))\n        efd := load_i64(ptr(usize(st) + usize(120)))\n        if want_nf != 0 { wake_pair_signal(rfd, wfd, efd) } else { wake_pair_drain(rfd, efd) }\n        store_i64(nf_sig_ptr, want_nf)\n    }\n}\n\n@thread_safe\nunsafe fn chan_retain_waker_locked(st: ptr, offset: usize) -> ptr {\n    w := load_ptr(ptr(usize(st) + offset))\n    if usize(w) != usize(0) { net.waker_retain_raw(w) }\n    w\n}\n\n@thread_safe\nunsafe fn chan_notify_waker(w: ptr) {\n    if usize(w) == usize(0) { return }\n    net.waker_wake_raw(w)\n    net.waker_release_raw(w)\n}\n\n@thread_safe\nunsafe fn chan_take_cached_pool_locked(st: ptr) -> ptr {\n    cnt_ptr := ptr(usize(st) + usize(152))\n    n := load_i64(cnt_ptr)\n    if n <= 0 { return ptr(0) }\n    idx := n - 1\n    store_i64(cnt_ptr, idx)\n    slot := ptr(usize(st) + usize(160) + usize(idx) * usize(8))\n    p := load_ptr(slot)\n    store_ptr(slot, ptr(0))\n    p\n}\n\n@thread_safe\nunsafe fn chan_return_pool_locked(st: ptr, pool: ptr) -> bool {\n    if usize(pool) == usize(0) { return true }\n    cnt_ptr := ptr(usize(st) + usize(152))\n    n := load_i64(cnt_ptr)\n    if n >= 8 { return false }\n    slot := ptr(usize(st) + usize(160) + usize(n) * usize(8))\n    store_ptr(slot, pool)\n    store_i64(cnt_ptr, n + 1)\n    true\n}\n\n@thread_safe\nunsafe fn chan_close_send_raw(st: ptr) {\n    if usize(st) == usize(0) { return }\n    spin_lock(ptr(usize(st) + usize(24)))\n    store_i64(ptr(usize(st) + usize(64)), 1)\n    chan_sync_signals_locked(st)\n    rw := chan_retain_waker_locked(st, usize(128))\n    spin_unlock(ptr(usize(st) + usize(24)))\n    chan_notify_waker(rw)\n}\n\n@thread_safe\nunsafe fn chan_close_recv_raw(st: ptr) {\n    if usize(st) == usize(0) { return }\n    spin_lock(ptr(usize(st) + usize(24)))\n    store_i64(ptr(usize(st) + usize(72)), 1)\n    chan_sync_signals_locked(st)\n    tw := chan_retain_waker_locked(st, usize(136))\n    spin_unlock(ptr(usize(st) + usize(24)))\n    chan_notify_waker(tw)\n}\n\n@thread_safe\nunsafe fn chan_free_state_arrays(st: ptr) {\n    ne_rfd := i32(load_i64(ptr(usize(st) + usize(80))))\n    ne_wfd := i32(load_i64(ptr(usize(st) + usize(88))))\n    ne_efd := load_i64(ptr(usize(st) + usize(96)))\n    wake_pair_close(ne_rfd, ne_wfd, ne_efd)\n\n    nf_rfd := i32(load_i64(ptr(usize(st) + usize(104))))\n    nf_wfd := i32(load_i64(ptr(usize(st) + usize(112))))\n    nf_efd := load_i64(ptr(usize(st) + usize(120)))\n    wake_pair_close(nf_rfd, nf_wfd, nf_efd)\n\n    rw := load_ptr(ptr(usize(st) + usize(128)))\n    if usize(rw) != usize(0) { net.waker_release_raw(rw) }\n    tw := load_ptr(ptr(usize(st) + usize(136)))\n    if usize(tw) != usize(0) { net.waker_release_raw(tw) }\n\n    cached := load_i64(ptr(usize(st) + usize(152)))\n    psz := mini_pool_bytes()\n    for i in 0..i32(cached) {\n        p := load_ptr(ptr(usize(st) + usize(160) + usize(i) * usize(8)))\n        unmap_mini_pool(p, psz)\n    }\n    alloc_len := load_i64(ptr(usize(st) + usize(144)))\n    sync_munmap(st, usize(alloc_len))\n}\n\n@thread_safe\nunsafe fn chan_try_pop_locked(st: ptr) -> (i32, i64, ptr, ptr) {\n    // Returns (status: 1=ok, 0=empty, -1=closed; word, pool, tx_waker_to_wake)\n    count := load_i64(ptr(usize(st) + usize(56)))\n    if count > 0 {\n        cap := load_i64(ptr(usize(st) + usize(32)))\n        head := load_i64(ptr(usize(st) + usize(40)))\n        slot := ptr(usize(st) + usize(256) + usize(head) * usize(16))\n        word := load_i64(slot)\n        pool := load_ptr(ptr(usize(slot) + usize(8)))\n        store_i64(slot, 0)\n        store_ptr(ptr(usize(slot) + usize(8)), ptr(0))\n        store_i64(ptr(usize(st) + usize(40)), (head + 1) % cap)\n        store_i64(ptr(usize(st) + usize(56)), count - 1)\n        chan_sync_signals_locked(st)\n        tw := chan_retain_waker_locked(st, usize(136))\n        return (1, word, pool, tw)\n    }\n    if load_i64(ptr(usize(st) + usize(64))) != 0 {\n        return (-1, 0, ptr(0), ptr(0))\n    }\n    (0, 0, ptr(0), ptr(0))\n}\n\n@thread_safe\nunsafe fn chan_set_waker_raw(st: ptr, offset: usize, waker: &net.Waker) {\n    w_st := waker.raw_state()\n    if usize(w_st) != usize(0) { net.waker_retain_raw(w_st) }\n    spin_lock(ptr(usize(st) + usize(24)))\n    old := load_ptr(ptr(usize(st) + offset))\n    store_ptr(ptr(usize(st) + offset), w_st)\n    spin_unlock(ptr(usize(st) + usize(24)))\n    if usize(old) != usize(0) { net.waker_release_raw(old) }\n}\n\n@thread_safe\npub fn channel<T>(capacity: i32) -> (Sender<T>, Receiver<T>) where T: Sendable {\n    assert(capacity > 0)\n    unsafe {\n        page := sync_page_bytes()\n        total_bytes := align_up(usize(256) + usize(capacity) * usize(16), page)\n        st := sync_mmap(total_bytes)\n        ne := wake_pair_open()\n        nf := wake_pair_open()\n        sys.atomic_store_i64(st, 1)\n        sys.atomic_store_i64(ptr(usize(st) + usize(8)), 1)\n        sys.atomic_store_i64(ptr(usize(st) + usize(16)), 2)\n        store_i64(ptr(usize(st) + usize(24)), 0)\n        store_i64(ptr(usize(st) + usize(32)), i64(capacity))\n        store_i64(ptr(usize(st) + usize(40)), 0)\n        store_i64(ptr(usize(st) + usize(48)), 0)\n        store_i64(ptr(usize(st) + usize(56)), 0)\n        store_i64(ptr(usize(st) + usize(64)), 0)\n        store_i64(ptr(usize(st) + usize(72)), 0)\n        store_i64(ptr(usize(st) + usize(80)), i64(ne.0))\n        store_i64(ptr(usize(st) + usize(88)), i64(ne.1))\n        store_i64(ptr(usize(st) + usize(96)), ne.2)\n        store_i64(ptr(usize(st) + usize(104)), i64(nf.0))\n        store_i64(ptr(usize(st) + usize(112)), i64(nf.1))\n        store_i64(ptr(usize(st) + usize(120)), nf.2)\n        store_ptr(ptr(usize(st) + usize(128)), ptr(0))\n        store_ptr(ptr(usize(st) + usize(136)), ptr(0))\n        store_i64(ptr(usize(st) + usize(144)), i64(total_bytes))\n        store_i64(ptr(usize(st) + usize(152)), 0)\n        store_i64(ptr(usize(st) + usize(224)), 0)\n        wake_pair_signal(nf.0, nf.1, nf.2)\n        store_i64(ptr(usize(st) + usize(232)), 1)\n        tx := Sender<T> { state: st }\n        rx := Receiver<T> { state: st }\n        return (move tx, move rx)\n    }\n    unsafe { (Sender<T> { state: ptr(0) }, Receiver<T> { state: ptr(0) }) }\n}\n\nimpl Sender<T> where T: Sendable {\n    @thread_safe\n    pub fn clone_sender(&self) -> Self {\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(ptr(usize(self.state) + usize(16)), 1)\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn close(&self) {\n        unsafe { chan_close_send_raw(self.state) }\n    }\n\n    @thread_safe\n    pub fn is_closed(&self) -> bool {\n        unsafe {\n            return sys.atomic_load_i64(ptr(usize(self.state) + usize(64))) != 0 ||\n                sys.atomic_load_i64(ptr(usize(self.state) + usize(72))) != 0\n        }\n        true\n    }\n\n    @thread_safe\n    pub fn len(&self) -> i32 {\n        unsafe { return i32(sys.atomic_load_i64(ptr(usize(self.state) + usize(56)))) }\n        0\n    }\n\n    @thread_safe\n    pub fn capacity(&self) -> i32 {\n        unsafe { return i32(load_i64(ptr(usize(self.state) + usize(32)))) }\n        0\n    }\n\n    @thread_safe\n    pub fn attach_waker(&self, waker: &net.Waker) {\n        unsafe { chan_set_waker_raw(self.state, usize(136), &waker) }\n    }\n\n    @thread_safe\n    pub fn try_send(&self, move val: T) -> SendResult<T> {\n        unsafe {\n            st := self.state\n            needs_pool := __sync_needs_pool(T)\n            mut pool := ptr(0)\n            mut closed := false\n            mut full := false\n            spin_lock(ptr(usize(st) + usize(24)))\n            if load_i64(ptr(usize(st) + usize(64))) != 0 || load_i64(ptr(usize(st) + usize(72))) != 0 {\n                closed = true\n            } else if load_i64(ptr(usize(st) + usize(56))) >= load_i64(ptr(usize(st) + usize(32))) {\n                full = true\n            } else if needs_pool {\n                pool = chan_take_cached_pool_locked(st)\n            }\n            spin_unlock(ptr(usize(st) + usize(24)))\n            if closed { return .Closed(move val) }\n            if full { return .Full(move val) }\n            psz := mini_pool_bytes()\n            if needs_pool && usize(pool) == usize(0) {\n                pool = sync_mmap(usize(psz))\n            }\n            packed := __sync_pack(T, pool, psz, move val)\n            mut outcome: i32 = 0\n            mut rw := ptr(0)\n            spin_lock(ptr(usize(st) + usize(24)))\n            if load_i64(ptr(usize(st) + usize(64))) != 0 || load_i64(ptr(usize(st) + usize(72))) != 0 {\n                outcome = -1\n            } else {\n                count := load_i64(ptr(usize(st) + usize(56)))\n                cap := load_i64(ptr(usize(st) + usize(32)))\n                if count >= cap {\n                    outcome = -2\n                } else {\n                    tail := load_i64(ptr(usize(st) + usize(48)))\n                    slot := ptr(usize(st) + usize(256) + usize(tail) * usize(16))\n                    store_i64(slot, packed)\n                    store_ptr(ptr(usize(slot) + usize(8)), pool)\n                    store_i64(ptr(usize(st) + usize(48)), (tail + 1) % cap)\n                    store_i64(ptr(usize(st) + usize(56)), count + 1)\n                    chan_sync_signals_locked(st)\n                    rw = chan_retain_waker_locked(st, usize(128))\n                    outcome = 1\n                }\n            }\n            spin_unlock(ptr(usize(st) + usize(24)))\n            if outcome == 1 {\n                chan_notify_waker(rw)\n                return .Ok\n            }\n            ret_val := __sync_unpack(T, packed)\n            if needs_pool && usize(pool) != usize(0) {\n                reset_mini_pool(pool)\n                spin_lock(ptr(usize(st) + usize(24)))\n                kept := chan_return_pool_locked(st, pool)\n                spin_unlock(ptr(usize(st) + usize(24)))\n                if !kept { unmap_mini_pool(pool, psz) }\n            }\n            if outcome == -1 { return .Closed(move ret_val) }\n            return .Full(move ret_val)\n        }\n        panic(\"unreachable\")\n    }\n\n    @thread_safe\n    pub fn send(&self, move val: T) -> bool {\n        unsafe {\n            st := self.state\n            needs_pool := __sync_needs_pool(T)\n            psz := mini_pool_bytes()\n            mut pending: Option<T> = .Some(move val)\n            mut has_packed := false\n            mut packed: i64 = 0\n            mut pool := ptr(0)\n            mut revs: []i32 = []\n            nf_rfd := i32(load_i64(ptr(usize(st) + usize(104))))\n            nf_fds: []i32 = [nf_rfd]\n            while true {\n                mut status: i32 = 0\n                mut rw := ptr(0)\n                mut take_cached := ptr(0)\n                spin_lock(ptr(usize(st) + usize(24)))\n                if load_i64(ptr(usize(st) + usize(64))) != 0 || load_i64(ptr(usize(st) + usize(72))) != 0 {\n                    status = -1\n                } else {\n                    count := load_i64(ptr(usize(st) + usize(56)))\n                    cap := load_i64(ptr(usize(st) + usize(32)))\n                    if count < cap {\n                        if has_packed || !needs_pool {\n                            if !has_packed {\n                                packed = match replace(&mut pending, .None) {\n                                    .Some(v) => __sync_pack(T, ptr(0), psz, move v),\n                                    .None => panic(\"sync channel internal send state\"),\n                                }\n                                has_packed = true\n                            }\n                            tail := load_i64(ptr(usize(st) + usize(48)))\n                            slot := ptr(usize(st) + usize(256) + usize(tail) * usize(16))\n                            store_i64(slot, packed)\n                            store_ptr(ptr(usize(slot) + usize(8)), pool)\n                            store_i64(ptr(usize(st) + usize(48)), (tail + 1) % cap)\n                            store_i64(ptr(usize(st) + usize(56)), count + 1)\n                            chan_sync_signals_locked(st)\n                            rw = chan_retain_waker_locked(st, usize(128))\n                            status = 1\n                        } else {\n                            take_cached = chan_take_cached_pool_locked(st)\n                            status = 2\n                        }\n                    }\n                }\n                spin_unlock(ptr(usize(st) + usize(24)))\n                if status == 1 {\n                    chan_notify_waker(rw)\n                    return true\n                }\n                if status == -1 {\n                    if has_packed {\n                        __sync_drop_packed(T, pool, psz, packed)\n                        unmap_mini_pool(pool, psz)\n                    }\n                    return false\n                }\n                if status == 2 {\n                    pool = if usize(take_cached) != usize(0) { take_cached } else { sync_mmap(usize(psz)) }\n                    packed = match replace(&mut pending, .None) {\n                        .Some(v) => __sync_pack(T, pool, psz, move v),\n                        .None => panic(\"sync channel internal send state\"),\n                    }\n                    has_packed = true\n                    continue\n                }\n                if nf_rfd < 0 {\n                    sys.sleep_ms(1)\n                } else {\n                    _ := poll_wait_raw(&nf_fds, -1, &mut revs)\n                }\n            }\n        }\n        false\n    }\n\n    @thread_safe\n    pub fn send_timeout(&self, move val: T, timeout_ms: i64) -> SendResult<T> {\n        unsafe {\n            st := self.state\n            mut pending: Option<T> = .Some(move val)\n            deadline := if timeout_ms > 0 { sys.now_ms() + timeout_ms } else { 0 }\n            nf_rfd := i32(load_i64(ptr(usize(st) + usize(104))))\n            nf_fds: []i32 = [nf_rfd]\n            mut revs: []i32 = []\n            while true {\n                cur_val := match replace(&mut pending, .None) {\n                    .Some(v) => v,\n                    .None => panic(\"sync channel internal send state\"),\n                }\n                match self.try_send(move cur_val) {\n                    .Ok => { return .Ok },\n                    .Closed(v) => { return .Closed(move v) },\n                    .Cancelled(v) => { return .Cancelled(move v) },\n                    .TimedOut(v) => { return .TimedOut(move v) },\n                    .Full(v) => {\n                        if timeout_ms == 0 { return .Full(move v) }\n                        if timeout_ms > 0 {\n                            rem := deadline - sys.now_ms()\n                            if rem <= 0 { return .TimedOut(move v) }\n                            pending = .Some(move v)\n                            if nf_rfd < 0 { sys.sleep_ms(1) } else { _ := poll_wait_raw(&nf_fds, rem, &mut revs) }\n                        } else {\n                            pending = .Some(move v)\n                            if nf_rfd < 0 { sys.sleep_ms(1) } else { _ := poll_wait_raw(&nf_fds, -1, &mut revs) }\n                        }\n                    },\n                }\n            }\n        }\n        panic(\"unreachable\")\n    }\n\n    @thread_safe\n    pub fn send_cancel(&self, cancel: &CancelToken, move val: T) -> SendResult<T> {\n        unsafe {\n            st := self.state\n            if cancel.is_cancelled() { return .Cancelled(move val) }\n            mut pending: Option<T> = .Some(move val)\n            nf_rfd := i32(load_i64(ptr(usize(st) + usize(104))))\n            mut fds: []i32 = []\n            if nf_rfd >= 0 { fds.push(nf_rfd) }\n            cancel_collect_fds(cancel.state, &mut fds)\n            mut revs: []i32 = []\n            while true {\n                cur_val := match replace(&mut pending, .None) {\n                    .Some(v) => v,\n                    .None => panic(\"sync channel internal send state\"),\n                }\n                if cancel.is_cancelled() { return .Cancelled(move cur_val) }\n                match self.try_send(move cur_val) {\n                    .Ok => { return .Ok },\n                    .Closed(v) => { return .Closed(move v) },\n                    .TimedOut(v) => { return .TimedOut(move v) },\n                    .Cancelled(v) => { return .Cancelled(move v) },\n                    .Full(v) => {\n                        if cancel.is_cancelled() { return .Cancelled(move v) }\n                        pending = .Some(move v)\n                        if fds.len == 0 { sys.sleep_ms(1) } else { _ := poll_wait_raw(&fds, -1, &mut revs) }\n                    },\n                }\n            }\n        }\n        panic(\"unreachable\")\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            if usize(st) == usize(0) { return }\n            if sys.atomic_fetch_add_i64(st, -1) == 1 {\n                chan_close_send_raw(st)\n            }\n            if sys.atomic_fetch_add_i64(ptr(usize(st) + usize(16)), -1) == 1 {\n                cap := load_i64(ptr(usize(st) + usize(32)))\n                mut head := load_i64(ptr(usize(st) + usize(40)))\n                mut count := load_i64(ptr(usize(st) + usize(56)))\n                psz := mini_pool_bytes()\n                while count > 0 {\n                    slot := ptr(usize(st) + usize(256) + usize(head) * usize(16))\n                    word := load_i64(slot)\n                    pool := load_ptr(ptr(usize(slot) + usize(8)))\n                    __sync_drop_packed(T, pool, psz, word)\n                    unmap_mini_pool(pool, psz)\n                    head = (head + 1) % cap\n                    count -= 1\n                }\n                chan_free_state_arrays(st)\n            }\n        }\n    }\n}\n\nimpl Receiver<T> where T: Sendable {\n    @thread_safe\n    pub fn clone_receiver(&self) -> Self {\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(ptr(usize(self.state) + usize(16)), 1)\n            _ := sys.atomic_fetch_add_i64(ptr(usize(self.state) + usize(8)), 1)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn close(&self) {\n        unsafe { chan_close_recv_raw(self.state) }\n    }\n\n    @thread_safe\n    pub fn is_closed(&self) -> bool {\n        unsafe {\n            return sys.atomic_load_i64(ptr(usize(self.state) + usize(64))) != 0 ||\n                sys.atomic_load_i64(ptr(usize(self.state) + usize(72))) != 0\n        }\n        true\n    }\n\n    @thread_safe\n    pub fn len(&self) -> i32 {\n        unsafe { return i32(sys.atomic_load_i64(ptr(usize(self.state) + usize(56)))) }\n        0\n    }\n\n    @thread_safe\n    pub fn capacity(&self) -> i32 {\n        unsafe { return i32(load_i64(ptr(usize(self.state) + usize(32)))) }\n        0\n    }\n\n    @thread_safe\n    pub fn fd(&self) -> i32 {\n        unsafe { return i32(load_i64(ptr(usize(self.state) + usize(80)))) }\n        -1\n    }\n\n    @thread_safe\n    pub fn attach_waker(&self, waker: &net.Waker) {\n        unsafe { chan_set_waker_raw(self.state, usize(128), &waker) }\n    }\n\n    @thread_safe\n    pub fn try_recv(&self) -> TryRecv<T> {\n        unsafe {\n            st := self.state\n            spin_lock(ptr(usize(st) + usize(24)))\n            res := chan_try_pop_locked(st)\n            spin_unlock(ptr(usize(st) + usize(24)))\n            chan_notify_waker(res.3)\n            if res.0 == 0 { return .Empty }\n            if res.0 < 0 { return .Closed }\n            val := __sync_unpack(T, res.1)\n            if usize(res.2) != usize(0) {\n                reset_mini_pool(res.2)\n                spin_lock(ptr(usize(st) + usize(24)))\n                kept := chan_return_pool_locked(st, res.2)\n                spin_unlock(ptr(usize(st) + usize(24)))\n                if !kept { unmap_mini_pool(res.2, mini_pool_bytes()) }\n            }\n            return .Value(move val)\n        }\n        .Closed\n    }\n\n    @thread_safe\n    pub fn recv(&self) -> Option<T> {\n        match self.recv_timeout(-1) {\n            .Value(v) => .Some(move v),\n            .Empty => .None,\n            .Closed => .None,\n        }\n    }\n\n    @thread_safe\n    pub fn recv_timeout(&self, timeout_ms: i64) -> TryRecv<T> {\n        unsafe {\n            match self.try_recv() {\n                .Value(v) => { return .Value(move v) },\n                .Closed => { return .Closed },\n                .Empty => {},\n            }\n            if timeout_ms == 0 { return .Empty }\n            deadline := if timeout_ms > 0 { sys.now_ms() + timeout_ms } else { 0 }\n            ne_rfd := i32(load_i64(ptr(usize(self.state) + usize(80))))\n            fds: []i32 = [ne_rfd]\n            mut revs: []i32 = []\n            while true {\n                match self.try_recv() {\n                    .Value(v) => { return .Value(move v) },\n                    .Closed => { return .Closed },\n                    .Empty => {},\n                }\n                mut delay: i64 = -1\n                if timeout_ms > 0 {\n                    rem := deadline - sys.now_ms()\n                    if rem <= 0 { return .Empty }\n                    delay = rem\n                }\n                if ne_rfd < 0 {\n                    sys.sleep_ms(if delay < 0 || delay > 1 { 1 } else { delay })\n                    continue\n                }\n                _ := poll_wait_raw(&fds, delay, &mut revs)\n            }\n        }\n        .Closed\n    }\n\n    @thread_safe\n    pub fn recv_cancel(&self, cancel: &CancelToken) -> Option<T> {\n        unsafe {\n            if cancel.is_cancelled() { return .None }\n            match self.try_recv() {\n                .Value(v) => { return .Some(move v) },\n                .Closed => { return .None },\n                .Empty => {},\n            }\n            ne_rfd := i32(load_i64(ptr(usize(self.state) + usize(80))))\n            mut fds: []i32 = []\n            if ne_rfd >= 0 { fds.push(ne_rfd) }\n            cancel_collect_fds(cancel.state, &mut fds)\n            mut revs: []i32 = []\n            while true {\n                if cancel.is_cancelled() { return .None }\n                match self.try_recv() {\n                    .Value(v) => { return .Some(move v) },\n                    .Closed => { return .None },\n                    .Empty => {},\n                }\n                if fds.len == 0 {\n                    sys.sleep_ms(1)\n                } else {\n                    _ := poll_wait_raw(&fds, -1, &mut revs)\n                }\n            }\n        }\n        .None\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            if usize(st) == usize(0) { return }\n            if sys.atomic_fetch_add_i64(ptr(usize(st) + usize(8)), -1) == 1 {\n                chan_close_recv_raw(st)\n            }\n            if sys.atomic_fetch_add_i64(ptr(usize(st) + usize(16)), -1) == 1 {\n                cap := load_i64(ptr(usize(st) + usize(32)))\n                mut head := load_i64(ptr(usize(st) + usize(40)))\n                mut count := load_i64(ptr(usize(st) + usize(56)))\n                psz := mini_pool_bytes()\n                while count > 0 {\n                    slot := ptr(usize(st) + usize(256) + usize(head) * usize(16))\n                    word := load_i64(slot)\n                    pool := load_ptr(ptr(usize(slot) + usize(8)))\n                    __sync_drop_packed(T, pool, psz, word)\n                    unmap_mini_pool(pool, psz)\n                    head = (head + 1) % cap\n                    count -= 1\n                }\n                chan_free_state_arrays(st)\n            }\n        }\n    }\n}\n\n@thread_safe\npub fn select2<A, B>(first: &Receiver<A>, second: &Receiver<B>, timeout_ms: i64) -> Select2<A, B> where A: Sendable, B: Sendable {\n    match first.try_recv() {\n        .Value(v) => { return .First(.Some(move v)) },\n        .Closed => { return .First(.None) },\n        .Empty => {},\n    }\n    match second.try_recv() {\n        .Value(v) => { return .Second(.Some(move v)) },\n        .Closed => { return .Second(.None) },\n        .Empty => {},\n    }\n    if timeout_ms == 0 { return .Timeout }\n    deadline := if timeout_ms > 0 { sys.now_ms() + timeout_ms } else { 0 }\n    mut fds: []i32 = []\n    f0 := first.fd()\n    f1 := second.fd()\n    if f0 >= 0 { fds.push(f0) }\n    if f1 >= 0 { fds.push(f1) }\n    mut revs: []i32 = []\n    while true {\n        match first.try_recv() {\n            .Value(v) => { return .First(.Some(move v)) },\n            .Closed => { return .First(.None) },\n            .Empty => {},\n        }\n        match second.try_recv() {\n            .Value(v) => { return .Second(.Some(move v)) },\n            .Closed => { return .Second(.None) },\n            .Empty => {},\n        }\n        mut delay: i64 = -1\n        if timeout_ms > 0 {\n            rem := deadline - sys.now_ms()\n            if rem <= 0 { return .Timeout }\n            delay = rem\n        }\n        if fds.len == 0 {\n            sys.sleep_ms(if delay < 0 || delay > 1 { 1 } else { delay })\n        } else {\n            unsafe { _ := poll_wait_raw(&fds, delay, &mut revs) }\n        }\n    }\n    .Timeout\n}\n\n@thread_safe\npub fn select2_cancel<A, B>(first: &Receiver<A>, second: &Receiver<B>, cancel: &CancelToken, timeout_ms: i64) -> Select2<A, B> where A: Sendable, B: Sendable {\n    if cancel.is_cancelled() { return .Cancelled }\n    match first.try_recv() {\n        .Value(v) => { return .First(.Some(move v)) },\n        .Closed => { return .First(.None) },\n        .Empty => {},\n    }\n    match second.try_recv() {\n        .Value(v) => { return .Second(.Some(move v)) },\n        .Closed => { return .Second(.None) },\n        .Empty => {},\n    }\n    if timeout_ms == 0 { return .Timeout }\n    deadline := if timeout_ms > 0 { sys.now_ms() + timeout_ms } else { 0 }\n    mut fds: []i32 = []\n    f0 := first.fd()\n    f1 := second.fd()\n    if f0 >= 0 { fds.push(f0) }\n    if f1 >= 0 { fds.push(f1) }\n    unsafe { cancel_collect_fds(cancel.state, &mut fds) }\n    mut revs: []i32 = []\n    while true {\n        if cancel.is_cancelled() { return .Cancelled }\n        match first.try_recv() {\n            .Value(v) => { return .First(.Some(move v)) },\n            .Closed => { return .First(.None) },\n            .Empty => {},\n        }\n        match second.try_recv() {\n            .Value(v) => { return .Second(.Some(move v)) },\n            .Closed => { return .Second(.None) },\n            .Empty => {},\n        }\n        mut delay: i64 = -1\n        if timeout_ms > 0 {\n            rem := deadline - sys.now_ms()\n            if rem <= 0 { return .Timeout }\n            delay = rem\n        }\n        if fds.len == 0 {\n            sys.sleep_ms(if delay < 0 || delay > 1 { 1 } else { delay })\n        } else {\n            unsafe { _ := poll_wait_raw(&fds, delay, &mut revs) }\n        }\n    }\n    .Timeout\n}\n\n@thread_safe\npub fn select_ready(fds: &[]i32, timeout_ms: i64) -> i32 {\n    if fds.len == 0 {\n        if timeout_ms > 0 { sys.sleep_ms(timeout_ms) }\n        return -1\n    }\n    mut revs: []i32 = []\n    unsafe {\n        n := poll_wait_raw(&fds, timeout_ms, &mut revs)\n        if n <= 0 { return -1 }\n        for i in 0..revs.len {\n            if revs[i] != 0 { return i }\n        }\n    }\n    -1\n}\n\n@thread_safe\npub fn select_ready_cancel(fds: &[]i32, cancel: &CancelToken, timeout_ms: i64) -> i32 {\n    if cancel.is_cancelled() { return -2 }\n    mut zero_revs: []i32 = []\n    if fds.len > 0 {\n        unsafe {\n            zn := poll_wait_raw(&fds, 0, &mut zero_revs)\n            if zn > 0 {\n                for i in 0..zero_revs.len {\n                    if zero_revs[i] != 0 { return i }\n                }\n            }\n        }\n    }\n    if timeout_ms == 0 { return -1 }\n    deadline := if timeout_ms > 0 { sys.now_ms() + timeout_ms } else { 0 }\n    mut combined: []i32 = []\n    for f in fds { combined.push(f) }\n    unsafe { cancel_collect_fds(cancel.state, &mut combined) }\n    mut revs: []i32 = []\n    while true {\n        if cancel.is_cancelled() { return -2 }\n        mut delay: i64 = -1\n        if timeout_ms > 0 {\n            rem := deadline - sys.now_ms()\n            if rem <= 0 { return -1 }\n            delay = rem\n        }\n        if combined.len == 0 {\n            sys.sleep_ms(if delay < 0 || delay > 1 { 1 } else { delay })\n            continue\n        }\n        unsafe {\n            n := poll_wait_raw(&combined, delay, &mut revs)\n            if cancel.is_cancelled() { return -2 }\n            if n > 0 {\n                for i in 0..fds.len {\n                    if revs[i] != 0 { return i }\n                }\n            }\n        }\n    }\n    -1\n}\n\n// =========================================================================\n// Updatable Frozen Snapshots: Published<T> & ReadGuard<T>\n// PubState (page):\n//   [0]  handles (i64, atomic)\n//   [8]  rw (i64, atomic: bit 0 = writer active, bits 1..62 = acquire window count)\n//   [16] current_snap (ptr as i64, atomic)\n// Snap (page):\n//   [0]  refcount (i64, atomic)\n//   [8]  pool (ptr, owned mini-pool)\n//   [16] packed_word (i64)\n//   [24] pool_size (i64)\n// =========================================================================\n\n@resource(dispose)\npub opaque struct Published<T> { state: ptr }\nimpl Sendable for Published<T> where T: Sendable {}\n\n@resource(dispose)\npub opaque struct ReadGuard<T> { snap: ptr }\n\n@thread_safe\nunsafe fn snap_release_typed<T>(snap: ptr) {\n    if usize(snap) == usize(0) { return }\n    if sys.atomic_fetch_add_i64(snap, -1) != 1 { return }\n    pool := load_ptr(ptr(usize(snap) + usize(8)))\n    word := load_i64(ptr(usize(snap) + usize(16)))\n    psz := load_i64(ptr(usize(snap) + usize(24)))\n    __sync_drop_packed(T, pool, psz, word)\n    unmap_mini_pool(pool, psz)\n    sync_munmap(snap, sync_page_bytes())\n}\n\n@thread_safe\nunsafe fn snap_alloc_frozen<T>(move value: T) -> ptr {\n    snap := sync_mmap(sync_page_bytes())\n    needs_pool := __sync_needs_pool(T)\n    psz := mini_pool_bytes()\n    pool := if needs_pool { sync_mmap(usize(psz)) } else { ptr(0) }\n    word := __sync_freeze(T, pool, psz, move value)\n    sys.atomic_store_i64(snap, 1)\n    store_ptr(ptr(usize(snap) + usize(8)), pool)\n    store_i64(ptr(usize(snap) + usize(16)), word)\n    store_i64(ptr(usize(snap) + usize(24)), psz)\n    snap\n}\n\nimpl Published<T> where T: Sendable {\n    @thread_safe\n    pub fn new(move initial: T) -> Self {\n        unsafe {\n            snap := snap_alloc_frozen<T>(move initial)\n            st := sync_mmap(sync_page_bytes())\n            sys.atomic_store_i64(st, 1)\n            sys.atomic_store_i64(ptr(usize(st) + usize(8)), 0)\n            sys.atomic_store_i64(ptr(usize(st) + usize(16)), i64(usize(snap)))\n            return Self { state: st }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn clone_handle(&self) -> Self {\n        unsafe {\n            _ := sys.atomic_fetch_add_i64(self.state, 1)\n            return Self { state: self.state }\n        }\n        unsafe { Self { state: ptr(0) } }\n    }\n\n    @thread_safe\n    pub fn publish(&self, move next: T) {\n        unsafe {\n            new_snap := snap_alloc_frozen<T>(move next)\n            rw_ptr := ptr(usize(self.state) + usize(8))\n            cur_ptr := ptr(usize(self.state) + usize(16))\n            mut spins: i32 = 0\n            while true {\n                w := sys.atomic_load_i64(rw_ptr)\n                if w.bit_and(1) != 0 {\n                    spins += 1\n                    if spins >= 64 { sys.sleep_ms(1); spins = 0 }\n                    continue\n                }\n                if sys.atomic_cas_i64(rw_ptr, w, w.bit_or(1)) == w { break }\n            }\n            old_snap := ptr(usize(sys.atomic_load_i64(cur_ptr)))\n            sys.atomic_store_i64(cur_ptr, i64(usize(new_snap)))\n            while sys.atomic_load_i64(rw_ptr) != 1 {}\n            sys.atomic_store_i64(rw_ptr, 0)\n            snap_release_typed<T>(old_snap)\n        }\n    }\n\n    @thread_safe\n    pub fn read(&self) -> ReadGuard<T> {\n        unsafe {\n            rw_ptr := ptr(usize(self.state) + usize(8))\n            cur_ptr := ptr(usize(self.state) + usize(16))\n            mut snap := ptr(0)\n            while true {\n                w := sys.atomic_load_i64(rw_ptr)\n                if w.bit_and(1) != 0 { continue }\n                if sys.atomic_cas_i64(rw_ptr, w, w + 2) == w {\n                    snap = ptr(usize(sys.atomic_load_i64(cur_ptr)))\n                    _ := sys.atomic_fetch_add_i64(snap, 1)\n                    _ := sys.atomic_fetch_add_i64(rw_ptr, -2)\n                    break\n                }\n            }\n            return ReadGuard<T> { snap: snap }\n        }\n        unsafe { ReadGuard<T> { snap: ptr(0) } }\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            st := self.state\n            self.state = ptr(0)\n            if usize(st) == usize(0) { return }\n            if sys.atomic_fetch_add_i64(st, -1) != 1 { return }\n            cur_snap := ptr(usize(sys.atomic_load_i64(ptr(usize(st) + usize(16)))))\n            snap_release_typed<T>(cur_snap)\n            sync_munmap(st, sync_page_bytes())\n        }\n    }\n}\n\nimpl ReadGuard<T> {\n    @thread_safe\n    pub fn get(&self) -> &T from self {\n        unsafe { return __sync_borrow_ref(T, &self, ptr(usize(self.snap) + usize(16))) }\n    }\n\n    @thread_safe\n    fn dispose(&mut self) {\n        unsafe {\n            s := self.snap\n            self.snap = ptr(0)\n            snap_release_typed<T>(s)\n        }\n    }\n}\n" }
    if name == "sys" { return "capability unsafe, filesystem, stdio\nimport std.sys.winbase as winbase\nimport std.sys.winfs as winfs\nimport std.sys.winpipe as winpipe\npub struct Status { ok: bool, error: i32 }\npub struct TextResult { ok: bool, value: string, error: i32 }\npub struct BytesResult { ok: bool, value: []u8, error: i32 }\npub struct Metadata {\n    ok: bool,\n    size: i64,\n    is_file: bool,\n    is_dir: bool,\n    error: i32,\n    is_symlink: bool,\n    mode: u32,\n    uid: u32,\n    gid: u32,\n    nlink: u64,\n    dev: u64,\n    ino: u64,\n    mtime: i64,\n}\n\nfn win_status(error: i32) -> Status { Status { ok: error == 0, error: error } }\n\npub fn windows_metadata(info: winfs.Info) -> Metadata {\n    Metadata { ok: info.error == 0, size: info.size, is_file: info.error == 0 && !info.directory && !info.link,\n        is_dir: info.directory, error: info.error, is_symlink: info.link, mode: info.mode, uid: 0, gid: 0,\n        nlink: info.nlink, dev: info.dev, ino: info.ino, mtime: info.mtime }\n}\n\n@thread_safe\nunsafe fn win_read_chunk(fd: i32, out: &mut []u8, limit: i64) -> i64 {\n    if limit < 0 { return -22 }\n    if limit == 0 { return 0 }\n    mut chunk: [u8; 8192] = [0; 8192]\n    n := winfs.read(fd, addr(&mut chunk[0]), if limit < 8192 { i32(limit) } else { 8192 })\n    if n > 0 {\n        view := bytes_view(&chunk, addr(&chunk[0]), usize(n))\n        __sys_bytes_extend(&mut out, &view, 0, n)\n    }\n    i64(n)\n}\n\nfn win_read_file(path: string, out: &mut []u8, max_bytes: i64) -> Status {\n    if max_bytes < 0 { return win_status(22) }\n    fd := winfs.open(path, true, false, false, false, false, false, false)\n    if fd < 0 { return win_status(-fd) }\n    unsafe {\n        defer { _ := winfs.close(fd) }\n        info := winfs.fstat(fd)\n        if info.error != 0 { return win_status(info.error) }\n        if info.directory { return win_status(21) }\n        if info.size > max_bytes { return win_status(27) }\n        if info.size > i64(out.cap()) { return win_status(35) }\n        mut offset := 0\n        size := i32(info.size)\n        out.clear()\n        for _ in 0..size { out.push(0) }\n        while offset < size {\n            n := winfs.read(fd, addr(&mut out[offset]), size - offset)\n            if n <= 0 { out.clear(); return win_status(if n == 0 { 35 } else { -n }) }\n            offset += n\n        }\n        mut byte := u8(0)\n        extra := winfs.read(fd, addr(&mut byte), 1)\n        if extra != 0 { out.clear(); return win_status(if extra > 0 { 35 } else { -extra }) }\n    }\n    win_status(0)\n}\n\nfn win_write_all(fd: i32, data: &[]u8) -> Status {\n    mut sent := 0\n    while sent < data.len {\n        unsafe {\n            n := fd_write(fd, &data, i64(sent), i64(data.len - sent))\n            if n <= 0 { return win_status(if n == 0 { 5 } else { i32(-n) }) }\n            sent += i32(n)\n        }\n    }\n    win_status(0)\n}\n\nfn win_write_file(path: string, bytes: &[]u8, append: bool) -> Status {\n    fd := winfs.open(path, false, true, true, !append, append, false, false)\n    if fd < 0 { return win_status(-fd) }\n    status := win_write_all(fd, &bytes)\n    unsafe {\n        close_error := -winfs.close(fd)\n        if !status.ok { return status }\n        return win_status(close_error)\n    }\n}\n\nfn win_text_file(path: string, value: string, append: bool) -> Status {\n    mut data: []u8 = []\n    bytes_append_text(&mut data, value)\n    win_write_file(path, &data, append)\n}\n\n@requires(filesystem)\npub fn read_text(path: string) -> TextResult {\n    if target_is(\"windows\") { return read_text_limit(path, 1073741823) }\n    __sys_read_text(path)\n}\n@requires(filesystem)\npub fn read_text_limit(path: string, max_bytes: i64) -> TextResult {\n    raw := read_u8_limit(path, max_bytes)\n    if !raw.ok { return TextResult { ok: false, value: \"\", error: raw.error } }\n    decode_u8(&raw.value)\n}\n@requires(filesystem)\npub fn read_u8_into(path: string, out: &mut []u8, max_bytes: i64) -> Status {\n    if target_is(\"windows\") { return win_read_file(path, &mut out, max_bytes) }\n    __sys_read_u8(path, &mut out, max_bytes)\n}\n@requires(filesystem)\npub fn read_u8_limit(path: string, max_bytes: i64) -> BytesResult {\n    if max_bytes < 0 { return BytesResult { ok: false, value: [], error: 22 } }\n    for attempt in 0..4 {\n        info := metadata(path)\n        if !info.ok { return BytesResult { ok: false, value: [], error: info.error } }\n        if info.is_dir { return BytesResult { ok: false, value: [], error: 21 } }\n        if info.size > max_bytes || info.size > 1073741823 {\n            return BytesResult { ok: false, value: [], error: 27 }\n        }\n        mut buf: []u8 = []\n        buf.reserve(i32(info.size) + 1)\n        st := read_u8_into(path, &mut buf, max_bytes)\n        if st.ok { return BytesResult { ok: true, value: buf, error: 0 } }\n        if st.error != 35 { return BytesResult { ok: false, value: [], error: st.error } }\n    }\n    BytesResult { ok: false, value: [], error: 35 }\n}\n@requires(filesystem)\npub fn read_u8(path: string) -> BytesResult { read_u8_limit(path, 1073741823) }\n@requires(filesystem)\npub fn write_text(path: string, text: string) -> Status {\n    if target_is(\"windows\") { return win_text_file(path, text, false) }\n    __sys_write_text(path, text)\n}\n@requires(stdio)\npub fn write_stderr(text: string) -> Status {\n    if target_is(\"windows\") {\n        mut data: []u8 = []\n        bytes_append_text(&mut data, text)\n        return win_write_all(2, &data)\n    }\n    __sys_write_stderr(text)\n}\n@requires(stdio)\npub fn eprint(text: string) -> Status { write_stderr(text + \"\\n\") }\n@requires(filesystem)\npub fn append_text(path: string, text: string) -> Status {\n    if target_is(\"windows\") { return win_text_file(path, text, true) }\n    __sys_append_text(path, text)\n}\n@requires(filesystem)\npub fn mkdir(path: string) -> Status {\n    if target_is(\"windows\") { return win_status(winfs.change(path, .CreateDir)) }\n    __sys_mkdir(path)\n}\n@requires(filesystem)\npub fn rename(from: string, to: string) -> Status {\n    if target_is(\"windows\") { return win_status(winfs.rename(from, to, false)) }\n    __sys_rename(from, to)\n}\n@requires(filesystem)\npub fn remove_file(path: string) -> Status {\n    if target_is(\"windows\") { return win_status(winfs.change(path, .Delete)) }\n    __sys_remove_file(path)\n}\n@requires(filesystem)\npub fn remove_dir(path: string) -> Status {\n    if target_is(\"windows\") { return win_status(winfs.change(path, .RemoveDir)) }\n    __sys_remove_dir(path)\n}\n@requires(filesystem)\npub fn metadata(path: string) -> Metadata {\n    if target_is(\"windows\") { return windows_metadata(winfs.stat(path, true)) }\n    __sys_metadata(path)\n}\npub fn pid() -> i32 {\n    if target_is(\"windows\") { return winbase.pid() } else { return __sys_pid() }\n}\npub fn now_ms() -> i64 {\n    if target_is(\"windows\") { return winbase.now_ms() } else { return __sys_now_ms() }\n}\n@thread_safe\npub fn sleep_ms(ms: i64) {\n    if ms <= 0 { return }\n    if target_is(\"windows\") { winbase.sleep_ms(ms) }\n    else {\n        mut empty: []u8 = []\n        _ := __sys_net_poll(&mut empty, 0, ms)\n    }\n}\npub fn arg_count() -> i32 { __sys_arg_count() }\npub fn arg(index: i32) -> string { __sys_arg(index) }\npub unsafe fn envp() -> ptr { __sys_envp() }\n@thread_safe\npub unsafe fn linux_syscall(nr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 { __sys_linux_syscall(nr, a0, a1, a2, a3, a4, a5) }\n@requires(filesystem)\npub fn make_executable(path: string) -> Status {\n    if target_is(\"windows\") { return win_status(winfs.stat(path, true).error) }\n    __sys_make_executable(path)\n}\n@requires(filesystem)\npub fn write_u8(path: string, bytes: &[]u8) -> Status {\n    if target_is(\"windows\") { return win_write_file(path, &bytes, false) }\n    __sys_write_u8(path, &bytes)\n}\npub fn decode_u8(bytes: &[]u8) -> TextResult { __sys_decode_u8(&bytes) }\npub fn decode_u8_range(bytes: &[]u8, start: i64, length: i64) -> TextResult { __sys_decode_u8_range(&bytes, start, length) }\n@requires(filesystem)\npub fn same_file(first: string, second: string) -> bool {\n    if target_is(\"windows\") { a := winfs.stat(first, true); b := winfs.stat(second, true); return a.error == 0 && b.error == 0 && a.dev == b.dev && a.ino == b.ino }\n    __sys_same_file(first, second)\n}\n@thread_safe\npub unsafe fn memory_copy(destination: ptr, source: ptr, count: usize) { __sys_memory_copy(destination, source, count) }\n@thread_safe\npub unsafe fn memory_equal(lhs: ptr, rhs: ptr, count: usize) -> bool { __sys_memory_equal(lhs, rhs, count) }\n@thread_safe\npub unsafe fn memory_zero(dst: ptr, count: usize) { __sys_memory_zero(dst, count) }\n@thread_safe\npub unsafe fn atomic_load_i64(p: ptr) -> i64 { __sys_atomic_load_i64(p) }\n@thread_safe\npub unsafe fn atomic_store_i64(p: ptr, value: i64) { __sys_atomic_store_i64(p, value) }\n@thread_safe\npub unsafe fn atomic_cas_i64(p: ptr, expected: i64, desired: i64) -> i64 { __sys_atomic_cas_i64(p, expected, desired) }\n@thread_safe\npub unsafe fn atomic_fetch_add_i64(p: ptr, delta: i64) -> i64 { __sys_atomic_fetch_add_i64(p, delta) }\n@thread_safe\npub unsafe fn pool_alloc_try(size: usize) -> ptr { __sys_pool_alloc_try(size) }\n@thread_safe\npub unsafe fn pool_free(p: ptr) { __sys_pool_free(p) }\n@thread_safe\npub fn bytes_equal(lhs: &[]u8, rhs: &[]u8) -> bool { __sys_bytes_equal(&lhs, &rhs) }\npub fn bytes_extend(output: &mut []u8, input: &[]u8, start: i32, end: i32) { __sys_bytes_extend(&mut output, &input, start, end) }\npub fn bytes_append_text(output: &mut []u8, text: string) { __sys_bytes_append_text(&mut output, text) }\n@thread_safe\npub unsafe fn fd_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 {\n    if target_is(\"windows\") { return win_read_chunk(fd, &mut out, max_bytes) }\n    __sys_net_read(fd, &mut out, max_bytes)\n}\n@thread_safe\npub unsafe fn fd_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 {\n    mut n := __sys_fd_write(fd, &data, offset, length)\n    if target_is(\"windows\") {\n        while n == -1 {\n            error := winfs.crt_error()\n            if error != 4 { return -i64(error) }\n            n = __sys_fd_write(fd, &data, offset, length)\n        }\n    }\n    n\n}\n@thread_safe\npub unsafe fn fd_close(fd: i32) -> i64 {\n    if target_is(\"windows\") { return i64(winfs.close(fd)) }\n    __sys_net_close(fd)\n}\n@thread_safe\npub unsafe fn fd_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 {\n    if target_is(\"windows\") { return winpipe.poll(&mut fds, nfds, timeout_ms) }\n    else { return __sys_net_poll(&mut fds, nfds, timeout_ms) }\n}\n@thread_safe\npub unsafe fn fd_set_nonblocking(fd: i32, enabled: bool) -> i64 {\n    if target_is(\"windows\") { return winpipe.nonblocking(fd, enabled) }\n    else { return __sys_net_set_nonblocking(fd, enabled) }\n}\n@requires(network)\npub fn net_listen(ipv4: i64, port: i64, backlog: i64) -> i64 { __sys_net_listen(ipv4, port, backlog) }\n@requires(network)\npub fn net_accept(listen_fd: i32) -> i64 { __sys_net_accept(listen_fd) }\n@requires(network)\npub fn net_connect(ipv4: i64, port: i64) -> i64 { __sys_net_connect(ipv4, port) }\n@requires(network)\n@thread_safe\npub fn net_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_read(fd, &mut out, max_bytes) }\n@requires(network)\npub fn net_peek(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_peek(fd, &mut out, max_bytes) }\n@requires(network)\npub fn net_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 { __sys_net_write(fd, &data, offset, length) }\n@requires(network)\n@thread_safe\npub fn net_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 { __sys_net_poll(&mut fds, nfds, timeout_ms) }\n@requires(network)\n@thread_safe\npub fn net_set_nonblocking(fd: i32, enabled: bool) -> i64 { __sys_net_set_nonblocking(fd, enabled) }\n@requires(network)\npub fn net_set_nodelay(fd: i32, enabled: bool) -> i64 { __sys_net_set_nodelay(fd, enabled) }\n@requires(network)\npub fn net_local_port(fd: i32) -> i64 { __sys_net_local_port(fd) }\n@requires(network)\npub fn net_shutdown_write(fd: i32) -> i64 { __sys_net_shutdown_write(fd) }\n@requires(network)\n@thread_safe\npub fn net_close(fd: i32) -> i64 { __sys_net_close(fd) }\n\n@test {\n    (0) -> \"ok\"\n    (2) -> \"no such file or directory\"\n    (4) -> \"interrupted\"\n    (28) -> \"no space left on device\"\n    (92) -> \"invalid UTF-8\"\n    (93) -> \"unexpected end of file\"\n    (94) -> \"write returned zero bytes\"\n    (12345) -> \"OS error 12345\"\n}\npub fn error_message(error: i32) -> string {\n    if error == 0 { return \"ok\" }\n    if error == 2 { return \"no such file or directory\" }\n    if error == 4 { return \"interrupted\" }\n    if error == 5 { return \"I/O error\" }\n    if error == 9 { return \"bad file descriptor\" }\n    if error == 12 { return \"out of memory\" }\n    if error == 13 { return \"permission denied\" }\n    if error == 17 { return \"already exists\" }\n    if error == 20 { return \"not a directory\" }\n    if error == 21 { return \"is a directory\" }\n    if error == 22 { return \"invalid argument\" }\n    if error == 27 { return \"file too large\" }\n    if error == 28 { return \"no space left on device\" }\n    if error == 32 { return \"broken pipe\" }\n    if error == 35 { return \"temporarily unavailable\" }\n    if error == 36 { return \"operation in progress\" }\n    if error == 40 { return \"message too long\" }\n    if error == 45 { return \"not supported\" }\n    if error == 47 { return \"address family not supported\" }\n    if error == 48 { return \"address already in use\" }\n    if error == 49 { return \"cannot assign requested address\" }\n    if error == 51 { return \"network is unreachable\" }\n    if error == 53 { return \"connection aborted\" }\n    if error == 54 { return \"connection reset\" }\n    if error == 57 { return \"socket is not connected\" }\n    if error == 60 { return \"timed out\" }\n    if error == 61 { return \"connection refused\" }\n    if error == 63 { return \"path too long\" }\n    if error == 65 { return \"no route to host\" }\n    if error == 66 { return \"directory not empty\" }\n    if error == 92 { return \"invalid UTF-8\" }\n    if error == 93 { return \"unexpected end of file\" }\n    if error == 94 { return \"write returned zero bytes\" }\n    f\"OS error {error}\"\n}\n\npub enum FileKind { Other = 0, File = 1, Directory = 2, Symlink = 3 }\npub enum IoError {\n    Other(i32) = 0,\n    NotFound = 2,\n    Interrupted = 4,\n    BadDescriptor = 9,\n    OutOfMemory = 12,\n    PermissionDenied = 13,\n    AlreadyExists = 17,\n    NotDirectory = 20,\n    IsDirectory = 21,\n    InvalidArgument = 22,\n    TooLarge = 27,\n    NoSpace = 28,\n    BrokenPipe = 32,\n    WouldBlock = 35,\n    InProgress = 36,\n    Unsupported = 45,\n    AddressInUse = 48,\n    ConnectionAborted = 53,\n    ConnectionReset = 54,\n    TimedOut = 60,\n    ConnectionRefused = 61,\n    NameTooLong = 63,\n    NotEmpty = 66,\n    InvalidUtf8 = 92,\n    UnexpectedEof = 93,\n    WriteZero = 94,\n}\nimpl Status {\n    pub fn into_result(&self) -> Result<(), IoError> {\n        if self.ok { .Ok } else { .Err(IoError::from_code(self.error)) }\n    }\n}\nimpl TextResult {\n    pub fn into_result(move self) -> Result<string, IoError> {\n        if self.ok { .Ok(self.value) } else { .Err(IoError::from_code(self.error)) }\n    }\n}\nimpl BytesResult {\n    pub fn into_result(move self) -> Result<[]u8, IoError> {\n        if self.ok { .Ok(self.value) } else { .Err(IoError::from_code(self.error)) }\n    }\n}\n\n@requires(filesystem)\npub fn read(path: string) -> Result<string, IoError> {\n    read_text(path).into_result()\n}\n@requires(filesystem)\npub fn read_limit(path: string, max_bytes: i64) -> Result<string, IoError> {\n    read_text_limit(path, max_bytes).into_result()\n}\n@requires(filesystem)\npub fn read_bytes(path: string) -> Result<[]u8, IoError> {\n    read_u8(path).into_result()\n}\n@requires(filesystem)\npub fn read_bytes_limit(path: string, max_bytes: i64) -> Result<[]u8, IoError> {\n    read_u8_limit(path, max_bytes).into_result()\n}\n@requires(filesystem)\npub fn write(path: string, text: string) -> Result<(), IoError> {\n    write_text(path, text).into_result()\n}\n@requires(filesystem)\npub fn write_bytes(path: string, data: &[]u8) -> Result<(), IoError> {\n    write_u8(path, &data).into_result()\n}\n\npub fn file_kind(info: Metadata) -> FileKind { info.kind() }\n\nimpl Metadata {\n    pub fn kind(&self) -> FileKind {\n        if self.is_symlink { .Symlink }\n        else if self.is_file { .File }\n        else if self.is_dir { .Directory }\n        else { .Other }\n    }\n    pub fn permissions(&self) -> u32 { self.mode.bit_and(u32(4095)) }\n}\n\nimpl IoError {\n    pub fn would_block() -> Self { .WouldBlock }\n    pub fn is_would_block(&self) -> bool { self.code() == 35 }\n\n    pub fn from_code(error: i32) -> Self {\n        if error == 2 { return .NotFound }\n        if error == 4 { return .Interrupted }\n        if error == 9 { return .BadDescriptor }\n        if error == 12 { return .OutOfMemory }\n        if error == 13 { return .PermissionDenied }\n        if error == 17 { return .AlreadyExists }\n        if error == 20 { return .NotDirectory }\n        if error == 21 { return .IsDirectory }\n        if error == 22 { return .InvalidArgument }\n        if error == 27 { return .TooLarge }\n        if error == 28 { return .NoSpace }\n        if error == 32 { return .BrokenPipe }\n        if error == 35 { return .WouldBlock }\n        if error == 36 { return .InProgress }\n        if error == 45 { return .Unsupported }\n        if error == 48 { return .AddressInUse }\n        if error == 53 { return .ConnectionAborted }\n        if error == 54 { return .ConnectionReset }\n        if error == 60 { return .TimedOut }\n        if error == 61 { return .ConnectionRefused }\n        if error == 63 { return .NameTooLong }\n        if error == 66 { return .NotEmpty }\n        if error == 92 { return .InvalidUtf8 }\n        if error == 93 { return .UnexpectedEof }\n        if error == 94 { return .WriteZero }\n        .Other(error)\n    }\n\n    pub fn code(&self) -> i32 {\n        match self {\n            .NotFound => 2,\n            .Interrupted => 4,\n            .BadDescriptor => 9,\n            .OutOfMemory => 12,\n            .PermissionDenied => 13,\n            .AlreadyExists => 17,\n            .NotDirectory => 20,\n            .IsDirectory => 21,\n            .InvalidArgument => 22,\n            .TooLarge => 27,\n            .NoSpace => 28,\n            .BrokenPipe => 32,\n            .WouldBlock => 35,\n            .InProgress => 36,\n            .Unsupported => 45,\n            .AddressInUse => 48,\n            .ConnectionAborted => 53,\n            .ConnectionReset => 54,\n            .TimedOut => 60,\n            .ConnectionRefused => 61,\n            .NameTooLong => 63,\n            .NotEmpty => 66,\n            .InvalidUtf8 => 92,\n            .UnexpectedEof => 93,\n            .WriteZero => 94,\n            .Other(code) => code,\n        }\n    }\n\n    pub fn message(&self) -> string { error_message(self.code()) }\n}\n\npub fn error_from_code(error: i32) -> IoError { IoError::from_code(error) }\n\n@test {\n    (.NotFound) -> 2\n    (.Interrupted) -> 4\n    (.NoSpace) -> 28\n    (.InvalidUtf8) -> 92\n    (.UnexpectedEof) -> 93\n    (.WriteZero) -> 94\n    (.ConnectionReset) -> 54\n    (.Other(12345)) -> 12345\n    IoError::would_block().is_would_block()\n    !IoError.NotFound.is_would_block()\n    IoError::from_code(4) == IoError.Interrupted\n    IoError::from_code(93) == IoError.UnexpectedEof\n    IoError::from_code(63).code() == 63\n    IoError::from_code(48).code() == 48\n    IoError::from_code(54321).code() == 54321\n    error_code(error_from_code(63)) == 63\n    error_code(error_from_code(48)) == 48\n    error_code(error_from_code(54321)) == 54321\n}\npub fn error_code(error: IoError) -> i32 { error.code() }\n\npub fn io_error_message(error: IoError) -> string { error.message() }\n\nimpl Display for IoError {\n    fn str(&self) -> string { self.message() }\n}\nimpl Eq for IoError {\n    fn eq(&self, other: &Self) -> bool { self.code() == other.code() }\n}\nimpl Hash for IoError {\n    fn hash(&self) -> u64 { self.code().hash() }\n}\n\nimpl Display for FileKind {\n    fn str(&self) -> string {\n        match self {\n            .Other => \"Other\",\n            .File => \"File\",\n            .Directory => \"Directory\",\n            .Symlink => \"Symlink\",\n        }\n    }\n}\nimpl Eq for FileKind {\n    fn eq(&self, other: &Self) -> bool { self == other }\n}\nimpl Hash for FileKind {\n    fn hash(&self) -> u64 {\n        v := match self { .Other => 0, .File => 1, .Directory => 2, .Symlink => 3 }\n        v.hash()\n    }\n}\n\nimpl Eq for Status {\n    fn eq(&self, other: &Self) -> bool { self.ok == other.ok && self.error == other.error }\n}\n" }
