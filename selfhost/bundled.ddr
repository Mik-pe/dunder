self.code, signal: self.signal, error: 0 }\n                    }\n                    if r < 0 && os_kill(self.pid, 0) != 0 { break }\n                }\n                self.close_pipes()\n                return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n            }\n\n            start := sys.now_ms()\n            while true {\n                r := os_waitpid(self.pid, addr(&mut wstatus), 1)\n                if r == self.pid {\n                    decode_wait_status(&mut self, wstatus)\n                    self.close_pipes()\n                    return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }\n                }\n                now := sys.now_ms()\n                if now - start >= timeout_ms {\n                    _ := self.kill()\n                    while true {\n                        wr := os_waitpid(self.pid, addr(&mut wstatus), 0)\n                        if wr >= 0 || os_kill(self.pid, 0) != 0 { break }\n                    }\n                    decode_wait_status(&mut self, wstatus)\n                    self.code = 124\n                    self.close_pipes()\n                    return WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: self.signal, error: 60 }\n                }\n                sys.sleep_ms(2)\n            }\n        }\n        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n    }\n\n    pub fn read_stdout(&mut self, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n        read_pipe(&mut self.stdout_fd, &mut out, max_bytes, timeout_ms)\n    }\n\n    pub fn read_stderr(&mut self, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n        read_pipe(&mut self.stderr_fd, &mut out, max_bytes, timeout_ms)\n    }\n\n    pub fn read_stdout_line(&mut self, timeout_ms: i64) -> sys.TextResult {\n        start := sys.now_ms()\n        mut line: []u8 = []\n        while line.len < 65536 {\n            mut rem: i64 = -1\n            if timeout_ms > 0 {\n                elapsed := sys.now_ms() - start\n                if elapsed >= timeout_ms {\n                    return sys.TextResult { ok: false, value: \"\", error: 60 }\n                }\n                rem = timeout_ms - elapsed\n            }\n            before := line.len\n            n := self.read_stdout(&mut line, 1, rem)\n            if n == 0 {\n                if line.len == 0 { return sys.TextResult { ok: false, value: \"\", error: 5 } }\n                break\n            }\n            if n == -35 {\n                return sys.TextResult { ok: false, value: \"\", error: 60 }\n            }\n            if n < 0 {\n                return sys.TextResult { ok: false, value: \"\", error: i32(-n) }\n            }\n            if line.len > before && line[line.len - 1] == b'\\n' {\n                break\n            }\n        }\n        mut end := line.len\n        if end > 0 && line[end - 1] == b'\\n' { end -= 1 }\n        if end > 0 && line[end - 1] == b'\\r' { end -= 1 }\n        bytes.decode_range(&line, 0, end)\n    }\n\n    pub fn write_stdin(&mut self, data: &[]u8) -> sys.Status {\n        if self.stdin_fd < 0 { return sys.Status { ok: false, error: 9 } }\n        if data.len == 0 { return sys.Status { ok: true, error: 0 } }\n        unsafe {\n            mut off := 0\n            mut poll_buf: []u8 = []\n            while off < data.len {\n                p := ptr(usize(addr(&data[0])) + usize(off))\n                n := os_write(self.stdin_fd, p, usize(data.len - off))\n                if n > 0 { off += i32(n); continue }\n                e := i32(-n)\n                if e == 4 { continue }\n                if e == 35 {\n                    poll_buf.clear()\n                    append_poll_fd(&mut poll_buf, self.stdin_fd, 4)\n                    _ := sys.net_poll(&mut poll_buf, 1, 100)\n                    continue\n                }\n                return sys.Status { ok: false, error: e }\n            }\n        }\n        sys.Status { ok: true, error: 0 }\n    }\n}\n\npub fn child_pid(child: &Child) -> i32 { child.pid() }\npub fn close_stdin(child: &mut Child) { child.close_stdin() }\npub fn close_pipes(child: &mut Child) { child.close_pipes() }\npub fn terminate(child: &mut Child) -> sys.Status { child.terminate() }\npub fn kill(child: &mut Child) -> sys.Status { child.kill() }\npub fn try_wait(child: &mut Child) -> WaitResult { child.try_wait() }\npub fn wait(child: &mut Child, timeout_ms: i64) -> WaitResult { child.wait(timeout_ms) }\n\nfn read_pipe(fd: &mut i32, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n    if fd < 0 { return 0 }\n    if max_bytes <= 0 { return 0 }\n    mut poll_buf: []u8 = []\n    append_poll_fd(&mut poll_buf, fd, 1)\n    mut chunk := 65536\n    if max_bytes < 65536 { chunk = i32(max_bytes) }\n    out.reserve(out.len + chunk)\n    n := sys.net_read(fd, &mut out, max_bytes)\n    if n > 0 { return n }\n    if n == 0 { _ := sys.net_close(fd); fd = -1; return 0 }\n    if n != -35 { return n }\n    if timeout_ms == 0 { return -35 }\n    pr := sys.net_poll(&mut poll_buf, 1, timeout_ms)\n    if pr < 0 { return pr }\n    if pr == 0 { return -35 }\n    n2 := sys.net_read(fd, &mut out, max_bytes)\n    if n2 == 0 { _ := sys.net_close(fd); fd = -1; return 0 }\n    n2\n}\n\npub fn read_stdout(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n    child.read_stdout(&mut out, max_bytes, timeout_ms)\n}\n\npub fn read_stderr(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {\n    child.read_stderr(&mut out, max_bytes, timeout_ms)\n}\n\npub fn read_stdout_line(child: &mut Child, timeout_ms: i64) -> sys.TextResult {\n    child.read_stdout_line(timeout_ms)\n}\n\npub fn write_stdin(child: &mut Child, data: &[]u8) -> sys.Status { child.write_stdin(&data) }\n\nfn exec_internal(program: string, args: &[]string, cmd: &Command) -> Output {\n    mut stdin_mode := cmd.stdin_mode\n    if cmd.stdin_data.len > 0 { stdin_mode = .Pipe }\n    sp := spawn_internal(program, &args, &cmd, stdin_mode)\n    if !sp.ok {\n        return Output {\n            ok: false, error: sp.error, code: 127, signal: 0, timed_out: false,\n            stdout: [], stderr: [],\n        }\n    }\n    mut child := sp.child\n    mut out_bytes: []u8 = []\n    mut err_bytes: []u8 = []\n    mut in_off := 0\n    if stdin_mode == .Pipe && cmd.stdin_data.len == 0 {\n        close_stdin(&mut child)\n    }\n\n    start := sys.now_ms()\n    mut poll_buf: []u8 = []\n    mut fd_roles: []i32 = []\n\n    while child.stdin_fd >= 0 || child.stdout_fd >= 0 || child.stderr_fd >= 0 {\n        if cmd.timeout_ms > 0 && sys.now_ms() - start >= cmd.timeout_ms {\n            _ := kill(&mut child)\n            w := wait(&mut child, 1000)\n            return Output {\n                ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,\n                stdout: out_bytes, stderr: err_bytes,\n            }\n        }\n\n        poll_buf.clear()\n        fd_roles.clear()\n        if child.stdin_fd >= 0 {\n            append_poll_fd(&mut poll_buf, child.stdin_fd, 4)\n            fd_roles.push(0)\n        }\n        if child.stdout_fd >= 0 {\n            append_poll_fd(&mut poll_buf, child.stdout_fd, 1)\n            fd_roles.push(1)\n        }\n        if child.stderr_fd >= 0 {\n            append_poll_fd(&mut poll_buf, child.stderr_fd, 1)\n            fd_roles.push(2)\n        }\n\n        mut wait_ms: i64 = -1\n        if cmd.timeout_ms > 0 {\n            rem := cmd.timeout_ms - (sys.now_ms() - start)\n            if rem <= 0 { continue }\n            wait_ms = rem\n        }\n        _ := sys.net_poll(&mut poll_buf, i64(fd_roles.len), wait_ms)\n\n        for idx in 0..fd_roles.len {\n            revents := bytes.u16_le(&poll_buf, idx * 8 + 6)\n            if revents == 0 { continue }\n            role := fd_roles[idx]\n            if role == 0 && child.stdin_fd >= 0 {\n                unsafe {\n                    while in_off < cmd.stdin_data.len {\n                        p := ptr(usize(addr(&cmd.stdin_data[0])) + usize(in_off))\n                        n := os_write(child.stdin_fd, p, usize(cmd.stdin_data.len - in_off))\n                        if n > 0 { in_off += i32(n); continue }\n                        if n == -4 { continue }\n                        if n != -35 { in_off = cmd.stdin_data.len }\n                        break\n                    }\n                }\n                if in_off >= cmd.stdin_data.len { close_stdin(&mut child) }\n            } else if role == 1 && child.stdout_fd >= 0 {\n                while child.stdout_fd >= 0 {\n                    if i64(out_bytes.len) >= cmd.max_output_bytes {\n                        _ := kill(&mut child)\n                        _ := wait(&mut child, 1000)\n                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }\n                    }\n                    out_bytes.reserve(out_bytes.len + 16384)\n                    n := sys.net_read(child.stdout_fd, &mut out_bytes, 65536)\n                    if n > 0 { continue }\n                    if n == 0 || n != -35 {\n                        _ := sys.net_close(child.stdout_fd)\n                        child.stdout_fd = -1\n                    }\n                    break\n                }\n            } else if role == 2 && child.stderr_fd >= 0 {\n                while child.stderr_fd >= 0 {\n                    if i64(err_bytes.len) >= cmd.max_output_bytes {\n                        _ := kill(&mut child)\n                        _ := wait(&mut child, 1000)\n                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }\n                    }\n                    err_bytes.reserve(err_bytes.len + 16384)\n                    n := sys.net_read(child.stderr_fd, &mut err_bytes, 65536)\n                    if n > 0 { continue }\n                    if n == 0 || n != -35 {\n                        _ := sys.net_close(child.stderr_fd)\n                        child.stderr_fd = -1\n                    }\n                    break\n                }\n            }\n        }\n    }\n\n    mut rem_wait: i64 = 0\n    if cmd.timeout_ms > 0 {\n        rem_wait = cmd.timeout_ms - (sys.now_ms() - start)\n        if rem_wait <= 0 { rem_wait = 1 }\n    }\n    w := wait(&mut child, rem_wait)\n    if w.timed_out {\n        return Output {\n            ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,\n            stdout: out_bytes, stderr: err_bytes,\n        }\n    }\n    Output {\n        ok: w.ok, error: w.error, code: w.code, signal: w.signal, timed_out: false,\n        stdout: out_bytes, stderr: err_bytes,\n    }\n}\n\n@requires(process)\npub fn exec(cmd: &Command) -> Output { cmd.exec() }\n\n@requires(process)\npub fn run(program: string, args: []string) -> Output {\n    cmd := command(\"\", [])\n    exec_internal(program, &args, &cmd)\n}\n\n@requires(process)\npub fn run_in(program: string, args: []string, cwd: string) -> Output {\n    mut cmd := command(\"\", [])\n    cmd.cwd = cwd.clone()\n    exec_internal(program, &args, &cmd)\n}\n\n@requires(process)\npub fn status(program: string, args: []string) -> WaitResult {\n    mut cmd := command(\"\", [])\n    cmd.inherit_stdio()\n    sp := spawn_internal(program, &args, &cmd, cmd.stdin_mode)\n    if !sp.ok {\n        return WaitResult { ok: false, exited: false, timed_out: false, code: 127, signal: 0, error: sp.error }\n    }\n    mut child := sp.child\n    child.wait(0)\n}\n\n@requires(process)\npub fn replace(program: string, args: &[]string) -> sys.Status {\n    replace_as(program, program, &args)\n}\n\n@requires(process)\npub fn replace_as(program: string, argv0: string, args: &[]string) -> sys.Status {\n    if program.len == 0 || argv0.len == 0 { return sys.Status { ok: false, error: 22 } }\n    mut blob: []u8 = []\n    mut arg_offsets: []i32 = []\n    if !push_cstr(&mut blob, &mut arg_offsets, argv0) {\n        return sys.Status { ok: false, error: 22 }\n    }\n    for arg in &args {\n        if !push_cstr(&mut blob, &mut arg_offsets, arg) {\n            return sys.Status { ok: false, error: 22 }\n        }\n    }\n    mut candidate_offsets: []i32 = []\n    mut program_offsets: []i32 = []\n    if !push_cstr(&mut blob, &mut program_offsets, program) {\n        return sys.Status { ok: false, error: 22 }\n    }\n    if text.find(program, \"/\") >= 0 {\n        candidate_offsets.push(program_offsets[0])\n    } else {\n        path := env(\"PATH\")\n        mut search_path := \"/usr/bin:/bin\"\n        if path.ok { search_path = path.value }\n        for directory in text.split(search_path, \":\") {\n            candidate := if directory.len == 0 { f\"./{program}\" } else { f\"{directory}/{program}\" }\n            if !push_cstr(&mut blob, &mut candidate_offsets, candidate) {\n                return sys.Status { ok: false, error: 22 }\n            }\n        }\n    }\n    unsafe {\n        mut argv: []ptr = []\n        for offset in &arg_offsets { argv.push(addr(&blob[offset])) }\n        argv.push(ptr(0))\n        environ := parent_environ()\n        mut failure := 2\n        for offset in &candidate_offsets {\n            code := -os_execve(addr(&blob[offset]), addr(&argv[0]), environ)\n            if code == 13 { failure = 13 }\n            else if code != 2 && code != 20 { return sys.Status { ok: false, error: code } }\n        }\n        sys.Status { ok: false, error: failure }\n    }\n}\n\n@requires(process)\npub fn spawn(cmd: &Command) -> SpawnResult { cmd.spawn() }\n\npub fn exec_granted(exe: &Executable, cmd: &Command) -> Output { exe.exec(&cmd) }\n\npub fn run_granted(exe: &Executable, args: []string) -> Output { exe.run(args) }\n\npub fn spawn_granted(exe: &Executable, cmd: &Command) -> SpawnResult { exe.spawn(&cmd) }\n\n@resource\npub opaque struct ChildSet {\n    cap: i32,\n    count: i32,\n    active: []bool,\n    pids: []i32,\n    pgids: []i32,\n    stdin_fds: []i32,\n    stdout_fds: []i32,\n    stderr_fds: []i32,\n    reaped: []bool,\n    codes: []i32,\n    signals: []i32,\n    poll_buf: []u8,\n}\n\nfn drain_fd_all(fd: &mut i32, out: &mut []u8) {\n    while fd >= 0 {\n        out.reserve(out.len + 16384)\n        n := sys.net_read(fd, &mut out, 65536)\n        if n > 0 { continue }\n        if n == 0 { _ := sys.net_close(fd); fd = -1 }\n        break\n    }\n}\n\nimpl ChildSet {\n    pub fn new(capacity: i32) -> Self {\n        assert(capacity > 0 && capacity <= 1024)\n        mut s := Self {\n            cap: capacity, count: 0, active: [], pids: [], pgids: [],\n            stdin_fds: [], stdout_fds: [], stderr_fds: [],\n            reaped: [], codes: [], signals: [], poll_buf: [],\n        }\n        for _ in 0..capacity {\n            s.active.push(false)\n            s.pids.push(-1)\n            s.pgids.push(-1)\n            s.stdin_fds.push(-1)\n            s.stdout_fds.push(-1)\n            s.stderr_fds.push(-1)\n            s.reaped.push(false)\n            s.codes.push(0)\n            s.signals.push(0)\n        }\n        s\n    }\n\n    pub fn len(&self) -> i32 { self.count }\n\n    pub fn is_active(&self, slot: i32) -> bool {\n        slot >= 0 && slot < self.cap && self.active[slot]\n    }\n\n    pub fn insert(&mut self, child: &mut Child) -> i32 {\n        if child.pid <= 0 { return -1 }\n        for slot in 0..self.cap {\n            if !self.active[slot] {\n                self.active[slot] = true\n                self.pids[slot] = child.pid\n                self.pgids[slot] = child.pgid\n                self.stdin_fds[slot] = child.stdin_fd\n                self.stdout_fds[slot] = child.stdout_fd\n                self.stderr_fds[slot] = child.stderr_fd\n                self.reaped[slot] = child.reaped\n                self.codes[slot] = child.code\n                self.signals[slot] = child.signal\n                self.count += 1\n                child.pid = -1\n                child.pgid = -1\n                child.stdin_fd = -1\n                child.stdout_fd = -1\n                child.stderr_fd = -1\n                child.reaped = true\n                return slot\n            }\n        }\n        -1\n    }\n\n    pub fn try_insert(&mut self, move child: Child) -> Result<i32, Child> {\n        mut owner := child\n        slot := self.insert(&mut owner)\n        if slot < 0 { return .Err(owner) }\n        .Ok(slot)\n    }\n\n    pub fn drain(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) {\n        if slot < 0 || slot >= self.cap || !self.active[slot] { return }\n        mut out_fd := self.stdout_fds[slot]\n        drain_fd_all(&mut out_fd, &mut stdout_out)\n        self.stdout_fds[slot] = out_fd\n        mut err_fd := self.stderr_fds[slot]\n        drain_fd_all(&mut err_fd, &mut stderr_out)\n        self.stderr_fds[slot] = err_fd\n    }\n\n    fn release_slot(&mut self, slot: i32) {\n        if self.stdin_fds[slot] >= 0 { _ := sys.net_close(self.stdin_fds[slot]); self.stdin_fds[slot] = -1 }\n        if self.stdout_fds[slot] >= 0 { _ := sys.net_close(self.stdout_fds[slot]); self.stdout_fds[slot] = -1 }\n        if self.stderr_fds[slot] >= 0 { _ := sys.net_close(self.stderr_fds[slot]); self.stderr_fds[slot] = -1 }\n        self.active[slot] = false\n        self.pids[slot] = -1\n        self.count -= 1\n    }\n\n    pub fn wait_any(&mut self, timeout_ms: i64) -> i32 {\n        if self.count <= 0 { return 0 }\n        self.poll_buf.clear()\n        mut nfds := 0\n        mut has_pipeless := false\n        for slot in 0..self.cap {\n            if !self.active[slot] { continue }\n            out_fd := self.stdout_fds[slot]\n            err_fd := self.stderr_fds[slot]\n            if out_fd >= 0 {\n                append_poll_fd(&mut self.poll_buf, out_fd, 1)\n                nfds += 1\n            }\n            if err_fd >= 0 {\n                append_poll_fd(&mut self.poll_buf, err_fd, 1)\n                nfds += 1\n            }\n            if out_fd < 0 && err_fd < 0 { has_pipeless = true }\n        }\n        mut wait_ms := timeout_ms\n        if has_pipeless && (wait_ms < 0 || wait_ms > 1) { wait_ms = 1 }\n        if nfds == 0 {\n            if wait_ms > 0 { sys.sleep_ms(wait_ms) }\n            return 0\n        }\n        i32(sys.net_poll(&mut self.poll_buf, i64(nfds), wait_ms))\n    }\n\n    pub fn try_wait(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {\n        if slot < 0 || slot >= self.cap || !self.active[slot] {\n            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }\n        }\n        self.drain(slot, &mut stdout_out, &mut stderr_out)\n        if self.reaped[slot] {\n            code := self.codes[slot]\n            sig := self.signals[slot]\n            self.release_slot(slot)\n            return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }\n        }\n        unsafe {\n            pid := self.pids[slot]\n            mut wstatus := 0\n            mut r := os_waitpid(pid, addr(&mut wstatus), 1)\n            if r == 0 && self.stdout_fds[slot] < 0 && self.stderr_fds[slot] < 0 {\n                os_usleep_50()\n                r = os_waitpid(pid, addr(&mut wstatus), 1)\n            }\n            if r == pid {\n                self.drain(slot, &mut stdout_out, &mut stderr_out)\n                self.release_slot(slot)\n                sig := wstatus.bit_and(127)\n                mut code := wstatus.shr(8).bit_and(255)\n                if sig != 0 { code = 128 + sig }\n                return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }\n            }\n            if r == 0 {\n                return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }\n            }\n        }\n        self.release_slot(slot)\n        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }\n    }\n\n    pub fn kill_reap(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {\n        if slot < 0 || slot >= self.cap || !self.active[slot] {\n            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }\n        }\n        unsafe {\n            pid := self.pids[slot]\n            pgid := self.pgids[slot]\n            if (pgid <= 0 || os_kill(-pgid, 9) != 0) && pid > 0 {\n                _ := os_kill(pid, 9)\n            }\n            mut wstatus := 0\n            while os_waitpid(pid, addr(&mut wstatus), 0) < 0 {\n                if os_kill(pid, 0) != 0 { break }\n            }\n        }\n        self.drain(slot, &mut stdout_out, &mut stderr_out)\n        self.release_slot(slot)\n        WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: 9, error: 60 }\n    }\n\n    pub fn kill_all(&mut self) {\n        mut sink_out: []u8 = []\n        mut sink_err: []u8 = []\n        for slot in 0..self.cap {\n            if self.active[slot] {\n                _ := self.kill_reap(slot, &mut sink_out, &mut sink_err)\n                sink_out.clear()\n                sink_err.clear()\n            }\n        }\n    }\n}\n\npub fn set_new(capacity: i32) -> ChildSet { ChildSet::new(capacity) }\npub fn set_len(set: &ChildSet) -> i32 { set.len() }\npub fn set_active(set: &ChildSet, slot: i32) -> bool { set.is_active(slot) }\npub fn set_insert(set: &mut ChildSet, child: &mut Child) -> i32 { set.insert(&mut child) }\npub fn set_drain(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) { set.drain(slot, &mut stdout_out, &mut stderr_out) }\npub fn set_wait_any(set: &mut ChildSet, timeout_ms: i64) -> i32 { set.wait_any(timeout_ms) }\npub fn set_try_wait(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult { set.try_wait(slot, &mut stdout_out, &mut stderr_out) }\npub fn set_kill_reap(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult { set.kill_reap(slot, &mut stdout_out, &mut stderr_out) }\npub fn set_kill_all(set: &mut ChildSet) { set.kill_all() }\n" }
    if name == "set" { return "import std.hash as hashing\n\npub struct Set { keys: []string, slots: []i32, length: i32, used: i32 }\n\nimpl Set {\n    pub fn new() -> Self { Self { keys: [], slots: [], length: 0, used: 0 } }\n    pub fn len(&self) -> i32 { self.length }\n    pub fn length(&self) -> i32 { self.length }\n\n    fn locate(&self, key: string) -> i32 {\n        capacity := self.slots.len\n        if capacity == 0 { return -1 }\n        mut slot := i32(hashing.hash(key) % i64(capacity))\n        for step in 0..capacity {\n            state := self.slots[slot]\n            if state == 0 { return -1 }\n            if state == 1 && self.keys[slot] == key { return slot }\n            slot = (slot + 1) % capacity\n        }\n        -1\n    }\n\n    pub fn contains(&self, key: string) -> bool { self.locate(key) >= 0 }\n\n    fn insert_slot(&mut self, move key: string) {\n        capacity := self.slots.len\n        mut slot := i32(hashing.hash(key) % i64(capacity))\n        while self.slots[slot] == 1 { slot = (slot + 1) % capacity }\n        if self.slots[slot] == 0 { self.used += 1 }\n        self.slots[slot] = 1\n        self.keys[slot] = key\n        self.length += 1\n    }\n\n    fn rehash(&mut self, capacity: i32) {\n        mut fresh := Self::new()\n        fresh.keys.reserve(capacity)\n        fresh.slots.reserve(capacity)\n        for i in 0..capacity { fresh.keys.push(\"\"); fresh.slots.push(0) }\n        while self.slots.len > 0 {\n            state := self.slots.pop()\n            key := self.keys.pop()\n            if state == 1 { fresh.insert_slot(move key) }\n        }\n        self = fresh\n    }\n\n    pub fn reserve(&mut self, entries: i32) {\n        assert(entries >= 0)\n        mut capacity := 8\n        while i64(capacity) * 7 < i64(entries) * 10 { capacity *= 2 }\n        if capacity > self.slots.len { self.rehash(capacity) }\n    }\n\n    pub fn insert(&mut self, move key: string) -> bool {\n        if self.contains(key) { return false }\n        capacity := self.slots.len\n        if capacity == 0 { self.rehash(8) }\n        else if (self.used + 1) * 10 >= capacity * 7 {\n            if (self.length + 1) * 10 < capacity * 4 { self.rehash(capacity) }\n            else { self.rehash(capacity * 2) }\n        }\n        self.insert_slot(move key)\n        true\n    }\n\n    pub fn remove(&mut self, key: string) -> bool {\n        slot := self.locate(key)\n        if slot < 0 { return false }\n        self.slots[slot] = 2\n        self.keys[slot] = \"\"\n        self.length -= 1\n        true\n    }\n\n    pub fn clear(&mut self) {\n        for i in 0..self.slots.len { self.slots[i] = 0; self.keys[i] = \"\" }\n        self.length = 0\n        self.used = 0\n    }\n\n    pub fn items(&self) -> []string {\n        mut result: []string = []\n        result.reserve(self.length)\n        for i in 0..self.slots.len { if self.slots[i] == 1 { result.push(self.keys[i].clone()) } }\n        result\n    }\n}\n\npub fn new() -> Set { Set::new() }\npub fn length(values: &Set) -> i32 { values.length() }\npub fn contains(values: &Set, key: string) -> bool { values.contains(key) }\npub fn reserve(values: &mut Set, entries: i32) { values.reserve(entries) }\npub fn insert(values: &mut Set, move key: string) -> bool { values.insert(move key) }\npub fn remove(values: &mut Set, key: string) -> bool { values.remove(key) }\npub fn clear(values: &mut Set) { values.clear() }\npub fn items(values: &Set) -> []string { values.items() }\n@test fn set_deduplicates_utf8_and_survives_tombstones() {\n    mut collisions := new()\n    insert(&mut collisions, \"a\"); insert(&mut collisions, \"i\"); insert(&mut collisions, \"q\"); insert(&mut collisions, \"y\")\n    remove(&mut collisions, \"a\")\n    !insert(&mut collisions, \"q\")\n    contains(&collisions, \"y\")\n    length(&collisions) == 3\n    mut values := new()\n    insert(&mut values, \"\")\n    insert(&mut values, \"🌍\")\n    !insert(&mut values, \"🌍\")\n    for i in 0..1000 { insert(&mut values, i.str()) }\n    length(&values) == 1002\n    copy := values.clone()\n    for i in 0..1000 { remove(&mut values, i.str()) }\n    length(&values) == 2\n    length(&copy) == 1002\n    for i in 0..1000 { insert(&mut values, i.str()) }\n    items(&values).len == 1002\n    clear(&mut values)\n    !contains(&values, \"🌍\")\n    insert(&mut values, \"after clear\")\n    length(&values) == 1\n}\n\n@test fn set_impl_methods_and_constructors() {\n    mut s := Set::new()\n    s.reserve(4)\n    s.insert(\"alpha\")\n    !s.insert(\"alpha\")\n    s.insert(\"beta\")\n    s.len() == 2\n    s.length() == 2\n    s.contains(\"beta\")\n    s.items().len == 2\n    s.remove(\"alpha\")\n    !s.contains(\"alpha\")\n    s.clear()\n    s.len() == 0\n}\n" }
    if name == "sha256" { return "import std.bytes as bytes\nfn push_word(out: &mut []u8, v: i64) {\n    out.push(u8(v.shr(24).bit_and(255)))\n    out.push(u8(v.shr(16).bit_and(255)))\n    out.push(u8(v.shr(8).bit_and(255)))\n    out.push(u8(v.bit_and(255)))\n}\npub fn digest_range(input: &[]u8, start: i32, length: i32) -> []u8 {\n    assert(start >= 0 && start <= input.len && length >= 0 && length <= input.len - start)\n    constants: [i64; 64] = [\n        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,\n        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,\n        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,\n        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,\n        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,\n        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,\n        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,\n        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298\n    ]\n    mut h0: i64 = 1779033703; mut h1: i64 = 3144134277\n    mut h2: i64 = 1013904242; mut h3: i64 = 2773480762\n    mut h4: i64 = 1359893119; mut h5: i64 = 2600822924\n    mut h6: i64 = 528734635; mut h7: i64 = 1541459225\n    full := length / 64\n    remainder := length % 64\n    mut tail_length := 64\n    if remainder >= 56 { tail_length = 128 }\n    mut tail: [u8; 128] = [0; 128]\n    for i in 0..remainder { tail[i] = input[start + full * 64 + i] }\n    tail[remainder] = 128\n    bits := i64(length) * 8\n    for i in 0..8 { tail[tail_length - 1 - i] = u8(bits.shr(i * 8).bit_and(255)) }\n\n    mut w: [i64; 64] = [0; 64]\n    for block in 0..full + tail_length / 64 {\n        if block < full {\n            base := start + block * 64\n            for i in 0..16 {\n                at := base + 4 * i\n                w[i] = i64(input[at]).shl(24).bit_or(i64(input[at + 1]).shl(16)).bit_or(i64(input[at + 2]).shl(8)).bit_or(i64(input[at + 3]))\n            }\n        } else {\n            base := (block - full) * 64\n            for i in 0..16 {\n                at := base + 4 * i\n                w[i] = i64(tail[at]).shl(24).bit_or(i64(tail[at + 1]).shl(16)).bit_or(i64(tail[at + 2]).shl(8)).bit_or(i64(tail[at + 3]))\n            }\n        }\n        for i in 16..64 {\n            a := w[i - 15]\n            b := w[i - 2]\n            doubled_a := a.bit_or(a.shl(32))\n            doubled_b := b.bit_or(b.shl(32))\n            s0 := doubled_a.shr(7).bit_xor(doubled_a.shr(18)).bit_xor(a.shr(3)).bit_and(4294967295)\n            s1 := doubled_b.shr(17).bit_xor(doubled_b.shr(19)).bit_xor(b.shr(10)).bit_and(4294967295)\n            w[i] = (w[i - 16] + s0 + w[i - 7] + s1).bit_and(4294967295)\n        }\n        mut a := h0; mut b := h1; mut c := h2; mut d := h3\n        mut e := h4; mut f := h5; mut g := h6; mut h := h7\n        for i in 0..64 {\n            doubled_e := e.bit_or(e.shl(32))\n            doubled_a := a.bit_or(a.shl(32))\n            s1 := doubled_e.shr(6).bit_xor(doubled_e.shr(11)).bit_xor(doubled_e.shr(25)).bit_and(4294967295)\n            choose := g.bit_xor(e.bit_and(f.bit_xor(g)))\n            first := h + s1 + choose + constants[i] + w[i]\n            s0 := doubled_a.shr(2).bit_xor(doubled_a.shr(13)).bit_xor(doubled_a.shr(22)).bit_and(4294967295)\n            majority := a.bit_and(b).bit_or(c.bit_and(a.bit_or(b)))\n            second := s0 + majority\n            h = g; g = f; f = e; e = (d + first).bit_and(4294967295)\n            d = c; c = b; b = a; a = (first + second).bit_and(4294967295)\n        }\n        h0 = (h0 + a).bit_and(4294967295); h1 = (h1 + b).bit_and(4294967295)\n        h2 = (h2 + c).bit_and(4294967295); h3 = (h3 + d).bit_and(4294967295)\n        h4 = (h4 + e).bit_and(4294967295); h5 = (h5 + f).bit_and(4294967295)\n        h6 = (h6 + g).bit_and(4294967295); h7 = (h7 + h).bit_and(4294967295)\n    }\n    mut result: []u8 = []\n    result.reserve(32)\n    push_word(&mut result, h0); push_word(&mut result, h1); push_word(&mut result, h2); push_word(&mut result, h3)\n    push_word(&mut result, h4); push_word(&mut result, h5); push_word(&mut result, h6); push_word(&mut result, h7)\n    result\n}\npub fn digest_bytes(input: &[]u8) -> []u8 {\n    digest_range(&input, 0, input.len)\n}\nfn widen(input: &[]u8) -> []i32 {\n    mut result: []i32 = []\n    result.reserve(input.len)\n    for byte in &input { result.push(i32(byte)) }\n    result\n}\npub fn digest(input: &[]i32) -> []i32 {\n    mut packed: []u8 = []\n    packed.reserve(input.len)\n    for byte in &input {\n        assert(byte >= 0 && byte <= 255)\n        packed.push(u8(byte))\n    }\n    digest := digest_bytes(&packed)\n    widen(&digest)\n}\npub fn text(input: string) -> []i32 {\n    mut packed: []u8 = []\n    packed.reserve(input.len)\n    bytes.append_utf8(&mut packed, input)\n    digest := digest_bytes(&packed)\n    widen(&digest)\n}\n@test fn sha256_matches_empty_abc_and_multi_block_reference_vectors() {\n    empty := text(\"\")\n    bytes.hex(&empty) == \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n    abc := text(\"abc\")\n    bytes.hex(&abc) == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"\n    long := text(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")\n    bytes.hex(&long) == \"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1\"\n}\n@test fn packed_ranges_match_sha256_at_padding_boundaries() {\n    mut input: []u8 = []\n    for i in 0..132 { input.push(u8(i)) }\n    lengths := [0, 55, 56, 63, 64, 65, 128]\n    expected := [\n        \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n        \"4653ce834ad1216507f784697481e2134214fb99e203b0e247d86b941b660707\",\n        \"1d742f4c8c512b0d2811d426f99ccdc16103332fac6c1ae4ffaa27535b2875bb\",\n        \"191b2ec5f9d8dd469ce7ddc71e282a89ea317915b2f4b40e7138a7795ba1191f\",\n        \"795430e15796923a557f9da1d980ec9db341e9acd6da682e1cd86303ce6b0b08\",\n        \"40a81d14a50081b4fdf29d5fb626e24cafdc507026f2de40dec3b0370a0e591e\",\n        \"db0d88f6150bf6e6a5d4ac9507b9a7a6b0d144e07e2e9ab67be9fe741788550c\"\n    ]\n    for i in 0..lengths.len {\n        packed := digest_range(&input, 3, lengths[i])\n        wide := widen(&packed)\n        assert(bytes.hex(&wide) == expected[i])\n    }\n}\n" }
    if name == "sqlite" { return "capability filesystem, unsafe\n\nimport std.bytes as bytes\nimport std.json as json\n\n@resource\npub opaque struct Database { handle: ptr }\npub struct OpenResult { ok: bool, db: Database, error: string }\npub struct QueryResult { ok: bool, rows: []string, error: string }\npub struct ExecResult { ok: bool, changes: i64, last_id: i64, error: string }\npub struct CloseResult { ok: bool, error: string }\n\nstruct Prepared { ok: bool, statement: ptr, error: string }\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_open_v2\")\nunsafe fn mac_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_open_v2\")\nunsafe fn linux_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32\nunsafe fn sql_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_open_v2(path, db, flags, vfs) }\n    if target_is(\"linux\") { return linux_open_v2(path, db, flags, vfs) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_close\")\nunsafe fn mac_close(db: ptr) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_close\")\nunsafe fn linux_close(db: ptr) -> i32\nunsafe fn sql_close(db: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_close(db) }\n    if target_is(\"linux\") { return linux_close(db) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_prepare_v2\")\nunsafe fn mac_prepare_v2(db: ptr, sql: ptr, length: i32, statement: ptr, tail: ptr) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_prepare_v2\")\nunsafe fn linux_prepare_v2(db: ptr, sql: ptr, length: i32, statement: ptr, tail: ptr) -> i32\nunsafe fn sql_prepare_v2(db: ptr, sql: ptr, length: i32, statement: ptr, tail: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_prepare_v2(db, sql, length, statement, tail) }\n    if target_is(\"linux\") { return linux_prepare_v2(db, sql, length, statement, tail) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_complete\")\nunsafe fn mac_complete(sql: ptr) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_complete\")\nunsafe fn linux_complete(sql: ptr) -> i32\nunsafe fn sql_complete(sql: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_complete(sql) }\n    if target_is(\"linux\") { return linux_complete(sql) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_bind_parameter_count\")\nunsafe fn mac_bind_parameter_count(statement: ptr) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_bind_parameter_count\")\nunsafe fn linux_bind_parameter_count(statement: ptr) -> i32\nunsafe fn sql_bind_parameter_count(statement: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_bind_parameter_count(statement) }\n    if target_is(\"linux\") { return linux_bind_parameter_count(statement) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_bind_text\")\nunsafe fn mac_bind_text(statement: ptr, index: i32, value: ptr, length: i32, destructor: ptr) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_bind_text\")\nunsafe fn linux_bind_text(statement: ptr, index: i32, value: ptr, length: i32, destructor: ptr) -> i32\nunsafe fn sql_bind_text(statement: ptr, index: i32, value: ptr, length: i32, destructor: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_bind_text(statement, index, value, length, destructor) }\n    if target_is(\"linux\") { return linux_bind_text(statement, index, value, length, destructor) }\n    -1\n}\n\n@extern(\"/usr/lib/libsqlite3.dylib\", \"sqlite3_bind_blob\")\nunsafe fn mac_bind_blob(statement: ptr, index: i32, value: ptr, length: i32, destructor: ptr) -> i32\n@extern(\"libsqlite3.so.0\", \"sqlite3_bind_blob\")\nunsafe fn linux_bind_blob(statement: ptr, index: i32, value: ptr, length: i32, destructor: ptr) -> i32\nunsafe fn sql_bind_blob(statement: ptr, index: i32, value: ptr, length: i32, destructor: ptr) -> i32 {\n    if target_is(\"macos\") { return mac_bind_blob(statement, index, value, length, destructor) }\n    if target_is(\"linux\") { return linu