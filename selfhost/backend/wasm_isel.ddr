const OP_F32_GE: i32 = 96

const OP_F64_EQ: i32 = 97
const OP_F64_NE: i32 = 98
const OP_F64_LT: i32 = 99
const OP_F64_GT: i32 = 100
const OP_F64_LE: i32 = 101
const OP_F64_GE: i32 = 102

// WASM integer arithmetic & bit opcodes
const OP_I32_CLZ: i32    = 103
