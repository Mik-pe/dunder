// Phase 4C: Native WebAssembly Typed-Local LIR/ISel (`selfhost/backend/wasm_isel.ddr`).
// Compiles Target-Independent Typed SSA MIR (`selfhost/ssa/ssa_ir.ddr`) directly to valid
// WebAssembly 32-bit binaries (`wasm32` & `wasm32-wasi`) using:
// - Native typed WASM locals (`i32`, `i64`, `f32`, `f64`, and 2 `i32` locals `(ptr, len)`
//   for 2-word `FatStr` / `FatSlice` / `RegionSlice` fat views)
// - Per-signature deduplicated `call_indirect` types registered via `object_module.add_wasm_sig`
//   and dispatched through `__indirect_function_table`
// - Structured CFG lowering (fast-path straight-line / `if`-`else` / `while`-`loop` + general
//   `$pc` block-dispatch loop for arbitrary reducible/irreducible CFGs)
// - ONLY 2 linear-memory globals (`$sp` = global 0, `$hp` = global 1) — ZERO ARM64 global-bank emulation!
// - ONLY `wasm_bytes.ddr` LEB128/section/op primitives (NEVER `read`/`write`/`base`/`set_base`).

import std.bytes as bytes
import ..hir.hir_types as ht
import ..hir.hir_body as hb
import ..ssa.ssa_ir as ssa
import wasm_bytes as b
import object_module as om

// =========================================================================
// Constants & WebAssembly Opcodes
// =========================================================================

const GL_SP: i32 = 0 // Linear-memory downward-growing stack pointer (mut i32)
const GL_HP: i32 = 1 // Linear-memory upward-growing bump heap pointer (mut i32)

const WASI_SCRATCH: i32 = 64  // 64..255: iovecs (16B), nwritten (4B), digit/str scratch
const DATA_BASE: i32    = 256 // Start of static read-only data segment
const STACK_BYTES: i32  = 1048576 // 1 MiB shadow stack for StackSlots & aggregate temps

// WASM value type encodings
const VT_I32: i32 = 127 // 0x7f
const VT_I64: i32 = 126 // 0x7e
const VT_F32: i32 = 125 // 0x7d
const VT_F64: i32 = 124 // 0x7c

// WASM control opcodes
const OP_UNREACHABLE: i32   = 0   // 0x00
const OP_NOP: i32           = 1   // 0x01
const OP_BLOCK: i32         = 2   // 0x02
const OP_LOOP: i32          = 3   // 0x03
const OP_IF: i32            = 4   // 0x04
const OP_ELSE: i32          = 5   // 0x05
const OP_END: i32           = 11  // 0x0b
const OP_BR: i32            = 12  // 0x0c
const OP_BR_IF: i32         = 13  // 0x0d
const OP_BR_TABLE: i32      = 14  // 0x0e
const OP_RETURN: i32        = 15  // 0x0f
const OP_CALL: i32          = 16  // 0x10
const OP_CALL_INDIRECT: i32 = 17  // 0x11
const OP_DROP: i32          = 26  // 0x1a
const OP_SELECT: i32        = 27  // 0x1b
const OP_LOCAL_GET: i32     = 32  // 0x20
const OP_LOCAL_SET: i32     = 33  // 0x21
const OP_LOCAL_TEE: i32     = 34  // 0x22
const OP_GLOBAL_GET: i32    = 35  // 0x23
const OP_GLOBAL_SET: i32    = 36  // 0x24
const BT_VOID: i32          = 64  // 0x40

// WASM memory opcodes
const OP_I32_LOAD: i32     = 40  // 0x28
const OP_I64_LOAD: i32     = 41  // 0x29
const OP_F32_LOAD: i32     = 42  // 0x2a
const OP_F64_LOAD: i32     = 43  // 0x2b
const OP_I32_LOAD8_S: i32  = 44  // 0x2c
const OP_I32_LOAD8_U: i32  = 45  // 0x2d
const OP_I32_LOAD16_S: i32 = 46  // 0x2e
const OP_I32_LOAD16_U: i32 = 47  // 0x2f
const OP_I32_STORE: i32    = 54  // 0x36
const OP_I64_STORE: i32    = 55  // 0x37
const OP_F32_STORE: i32    = 56  // 0x38
const OP_F64_STORE: i32    = 57  // 0x39
const OP_I32_STORE8: i32   = 58  // 0x3a
const OP_I32_STORE16: i32  = 59  // 0x3b
const OP_MEM_SIZE: i32     = 63  // 0x3f
const OP_MEM_GROW: i32     = 64  // 0x40

// WASM numeric comparison opcodes
const OP_I32_EQZ: i32  = 69
const OP_I32_EQ: i32   = 70
const OP_I32_NE: i32   = 71
const OP_I32_LT_S: i32 = 72
const OP_I32_LT_U: i32 = 73
const OP_I32_GT_S: i32 = 74
const OP_I32_GT_U: i32 = 75
const OP_I32_LE_S: i32 = 76
const OP_I32_LE_U: i32 = 77
const OP_I32_GE_S: i32 = 78
const OP_I32_GE_U: i32 = 79

const OP_I64_EQZ: i32  = 80
const OP_I64_EQ: i32   = 81
const OP_I64_NE: i32   = 82
const OP_I64_LT_S: i32 = 83
const OP_I64_LT_U: i32 = 84
const OP_I64_GT_S: i32 = 85
const OP_I64_GT_U: i32 = 86
const OP_I64_LE_S: i32 = 87
const OP_I64_LE_U: i32 = 88
const OP_I64_GE_S: i32 = 89
const OP_I64_GE_U: i32 = 90

const OP_F32_EQ: i32 = 91
const OP_F32_NE: i32 = 92
const OP_F32_LT: i32 = 93
const OP_F32_GT: i32 = 94
