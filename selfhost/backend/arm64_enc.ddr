// Pure, stateless ARM64 (AArch64) instruction encoder and label/branch-relaxation buffer.
// Zero MIR capture, zero prefixing, zero owner_store/task_call/backend_row coupling.
// Designed for Phase 3 SSA MIR lowering and Phase 4 native arm64_isel.

// General-purpose register indices (X0..X30, FP=29, LR=30, SP/XZR=31)
pub const X0: i32  = 0
pub const X1: i32  = 1
pub const X2: i32  = 2
pub const X3: i32  = 3
pub const X4: i32  = 4
pub const X5: i32  = 5
pub const X6: i32  = 6
pub const X7: i32  = 7
pub const X8: i32  = 8
pub const X9: i32  = 9
pub const X10: i32 = 10
pub const X11: i32 = 11
pub const X12: i32 = 12
pub const X13: i32 = 13
pub const X14: i32 = 14
pub const X15: i32 = 15
pub const X16: i32 = 16
pub const X17: i32 = 17
pub const X18: i32 = 18
pub const X19: i32 = 19
pub const X20: i32 = 20
pub const X21: i32 = 21
pub const X22: i32 = 22
pub const X23: i32 = 23
pub const X24: i32 = 24
pub const X25: i32 = 25
pub const X26: i32 = 26
pub const X27: i32 = 27
pub const X28: i32 = 28
pub const FP: i32  = 29
pub const LR: i32  = 30
pub const SP: i32  = 31
pub const XZR: i32 = 31

// ARM64 condition codes
pub const CC_EQ: i32 = 0
pub const CC_NE: i32 = 1
pub const CC_CS: i32 = 2
pub const CC_HS: i32 = 2
pub const CC_CC: i32 = 3
pub const CC_LO: i32 = 3
pub const CC_MI: i32 = 4
pub const CC_PL: i32 = 5
pub const CC_VS: i32 = 6
pub const CC_VC: i32 = 7
pub const CC_HI: i32 = 8
pub const CC_LS: i32 = 9
pub const CC_GE: i32 = 10
pub const CC_LT: i32 = 11
pub const CC_GT: i32 = 12
pub const CC_LE: i32 = 13
pub const CC_AL: i32 = 14

pub const NOP_WORD: i64 = 0xd503201f

pub enum RelocKind {
    Branch26,
    Call26,
    Cond19,
    Cbz19,
    Cbnz19,
    AdrpAdd,
    AdrpLdr,
}

pub struct ArmBuf {
    words: []i64,
    labels: []i32,
    reloc_at: []i32,
    reloc_target: []i32,
    reloc_kind: []RelocKind,
    reloc_reg: []i32,
    reloc_aux: []i32,
}

pub fn new() -> ArmBuf {
    ArmBuf {
        words: [],
        labels: [],
        reloc_at: [],
        reloc_target: [],
        reloc_kind: [],
        reloc_reg: [],
        reloc_aux: [],
    }
}

pub fn word_len(b: &ArmBuf) -> i32 { b.words.len }
pub fn byte_len(b: &ArmBuf) -> i32 { b.words.len * 4 }
pub fn invert_cc(cc: i32) -> i32 { cc.bit_xor(1) }

pub fn emit(b: &mut ArmBuf, word: i64) {
    b.words.push(word.bit_and(0xffffffff))
}

pub fn patch(b: &mut ArmBuf, at: i32, word: i64) {
    assert(at >= 0 && at < b.words.len)
    b.words[at] = word.bit_and(0xffffffff)
}

pub fn label(b: &mut ArmBuf) -> i32 {
    id := b.labels.len
    b.labels.push(-1)
    id
}

pub fn mark(b: &mut ArmBuf, lbl: i32) {
    assert(lbl >= 0 && lbl < b.labels.len)
    b.labels[lbl] = b.words.len
}

pub fn label_word(b: &ArmBuf, lbl: i32) -> i32 {
    assert(lbl >= 0 && lbl < b.labels.len)
    b.labels[lbl]
}

fn sf_bit(wide: bool) -> i64 { if wide { 0x80000000 } else { 0 } }
fn flags_bit(set_flags: bool) -> i64 { if set_flags { 0x20000000 } else { 0 } }
fn ftype_bit(is_f64: bool) -> i64 { if is_f64 { 0x00400000 } else { 0 } }

pub fn add_sub_imm_field(value: i64) -> i64 {
    if value >= 0 && value <= 4095 { return value.shl(10) }
    if value > 0 && value <= 16773120 && value % 4096 == 0 {
        return (value / 4096).shl(10).bit_or(0x00400000)
    }
    -1
}

// --- Data Processing: Immediate ---

pub fn add_imm(b: &mut ArmBuf, wide: bool, set_flags: bool, dst: i32, lhs: i32, value: i64) {
    field := add_sub_imm_field(value)
    assert(field >= 0 && dst >= 0 && dst <= 31 && lhs >= 0 && lhs <= 31)
    emit(&mut b, 0x11000000 + sf_bit(wide) + flags_bit(set_flags) + field + i64(lhs) * 32 + i64(dst))
}

pub fn sub_imm(b: &mut ArmBuf, wide: bool, set_flags: bool, dst: i32, lhs: i32, value: i64) {
    field := add_sub_imm_field(value)
    assert(field >= 0 && dst >= 0 && dst <= 31 && lhs >= 0 && lhs <= 31)
    emit(&mut b, 0x51000000 + sf_bit(wide) + flags_bit(set_flags) + field + i64(lhs) * 32 + i64(dst))
}

pub fn movz(b: &mut ArmBuf, wide: bool, dst: i32, imm16: i64, hw: i32) {
    assert(dst >= 0 && dst <= 31 && hw >= 0 && hw <= 3)
    emit(&mut b, 0x52800000 + sf_bit(wide) + i64(hw).shl(21) + imm16.bit_and(65535).shl(5) + i64(dst))
}

pub fn movn(b: &mut ArmBuf, wide: bool, dst: i32, imm16: i64, hw: i32) {
    assert(dst >= 0 && dst <= 31 && hw >= 0 && hw <= 3)
    emit(&mut b, 0x12800000 + sf_bit(wide) + i64(hw).shl(21) + imm16.bit_and(65535).shl(5) + i64(dst))
}

pub fn movk(b: &mut ArmBuf, wide: bool, dst: i32, imm16: i64, hw: i32) {
    assert(dst >= 0 && dst <= 31 && hw >= 0 && hw <= 3)
    emit(&mut b, 0x72800000 + sf_bit(wide) + i64(hw).shl(21) + imm16.bit_and(65535).shl(5) + i64(dst))
}

pub fn imm(b: &mut ArmBuf, dst: i32, value: i64) {
    assert(dst >= 0 && dst <= 31)
    if value >= 0 && value <= 65535 { movz(&mut b, true, dst, value, 0); return }
    if value < 0 && value >= -65536 { movn(&mut b, true, dst, value.bit_not(), 0); return }
    mut fill: i64 = 0
    mut use_movn := false
    if value < 0 || value > 4294967295 {
        mut zero_lanes := 0
        mut ones_lanes := 0
        for part in 0..4 {
            bits := value.shr(part * 16).bit_and(65535)
            if bits == 0 { zero_lanes += 1 } else if bits == 65535 { ones_lanes += 1 }
        }
        if ones_lanes > zero_lanes { fill = 65535; use_movn = true }
    }
    mut emitted_first := false
    for part in 0..4 {
        bits := value.shr(part * 16).bit_and(65535)
        if bits != fill {
            if !emitted_first {
                if use_movn { movn(&mut b, true, dst, bits.bit_xor(65535), part) }
                else { movz(&mut b, true, dst, bits, part) }
                emitted_first = true
            } else {
                movk(&mut b, true, dst, bits, part)
            }
        }
    }
}

// --- Data Processing: Register ---

pub fn mov(b: &mut ArmBuf, dst: i32, src: i32) {
    if dst == src { return }
    assert(dst >= 0 && dst <= 31 && src >= 0 && src <= 31)
    if dst == SP || src == SP {
        add_imm(&mut b, true, false, dst, src, 0)
        return
    }
    emit(&mut b, 0xaa0003e0 + i64(src) * 65536 + i64(dst))
}

pub fn mov32(b: &mut ArmBuf, dst: i32, src: i32) {
    assert(dst >= 0 && dst <= 30 && src >= 0 && src <= 31)
    emit(&mut b, 0x2a0003e0 + i64(src) * 65536 + i64(dst))
}

pub fn add_reg(b: &mut ArmBuf, wide: bool, set_flags: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x0b000000 + sf_bit(wide) + flags_bit(set_flags) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn add_reg_lsl(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32, shift: i32) {
    assert(shift >= 0 && shift < (if wide { 64 } else { 32 }))
    emit(&mut b, 0x0b000000 + sf_bit(wide) + i64(rhs) * 65536 + i64(shift) * 1024 + i64(lhs) * 32 + i64(dst))
}

pub fn sub_reg(b: &mut ArmBuf, wide: bool, set_flags: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x4b000000 + sf_bit(wide) + flags_bit(set_flags) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn neg(b: &mut ArmBuf, wide: bool, set_flags: bool, dst: i32, src: i32) {
    sub_reg(&mut b, wide, set_flags, dst, XZR, src)
}

pub fn and_reg(b: &mut ArmBuf, wide: bool, set_flags: bool, dst: i32, lhs: i32, rhs: i32) {
    base: i64 = if set_flags { 0x6a000000 } else { 0x0a000000 }
    emit(&mut b, base + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn orr_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x2a000000 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn orn_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x2a200000 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn mvn(b: &mut ArmBuf, wide: bool, dst: i32, src: i32) {
    orn_reg(&mut b, wide, dst, XZR, src)
}

pub fn eor_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x4a000000 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn bic_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x0a200000 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

// --- Multiply, Divide, Shifts & Bitfields ---

pub fn madd(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32, acc: i32) {
    emit(&mut b, 0x1b000000 + sf_bit(wide) + i64(rhs) * 65536 + i64(acc) * 1024 + i64(lhs) * 32 + i64(dst))
}

pub fn msub(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32, acc: i32) {
    emit(&mut b, 0x1b008000 + sf_bit(wide) + i64(rhs) * 65536 + i64(acc) * 1024 + i64(lhs) * 32 + i64(dst))
}

pub fn mul(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    madd(&mut b, wide, dst, lhs, rhs, XZR)
}

pub fn smulh(b: &mut ArmBuf, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x9b407c00 + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn umulh(b: &mut ArmBuf, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x9bc07c00 + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn sdiv(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x1ac00c00 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn udiv(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x1ac00800 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn lsl_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x1ac02000 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn lsr_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x1ac02400 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn asr_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x1ac02800 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn ror_reg(b: &mut ArmBuf, wide: bool, dst: i32, lhs: i32, rhs: i32) {
    emit(&mut b, 0x1ac02c00 + sf_bit(wide) + i64(rhs) * 65536 + i64(lhs) * 32 + i64(dst))
}

pub fn bitfield(b: &mut ArmBuf, signed: bool, wide: bool, dst: i32, src: i32, immr: i32, imms: i32) {
    mut word: i64 = if signed { 0x13000000 } else { 0x53000000 }
    if wide { word += 0x80400000 }
    emit(&mut b, word + i64(immr) * 65536 + i64(imms) * 1024 + i64(src) * 32 + i64(dst))
}

pub fn lsl_imm(b: &mut ArmBuf, wide: bool, dst: i32, src: i32, amount: i32) {
    width := if wide { 64 } else { 32 }
    assert(amount >= 0 && amount < width)
    if amount == 0 { if wide { mov(&mut b, dst, src) } else { mov32(&mut b, dst, src) }; return }
    bitfield(&mut b, false, wide, dst, src, width - amount, width - 1 - amount)
}

pub fn lsr_imm(b: &mut ArmBuf, wide: bool, dst: i32, src: i32, amount: i32) {
    width := if wide { 64 } else { 32 }
    assert(amount >= 0 && amount < width)
    bitfield(&mut b, false, wide, dst, src, amount, width - 1)
}

pub fn asr_imm(b: &mut ArmBuf, wide: bool, dst: i32, src: i32, amount: i32) {
    width := if wide { 64 } else { 32 }
    assert(amount >= 0 && amount < width)
    bitfield(&mut b, true, wide, dst, src, amount, width - 1)
}

pub fn sxtb(b: &mut ArmBuf, dst: i32, src: i32) { bitfield(&mut b, true, true, dst, src, 0, 7) }
pub fn sxth(b: &mut ArmBuf, dst: i32, src: i32) { bitfield(&mut b, true, true, dst, src, 0, 15) }
pub fn sxtw(b: &mut ArmBuf, dst: i32, src: i32) { bitfield(&mut b, true, true, dst, src, 0, 31) }
pub fn uxtb(b: &mut ArmBuf, dst: i32, src: i32) { bitfield(&mut b, false, false, dst, src, 0, 7) }
pub fn uxth(b: &mut ArmBuf, dst: i32, src: i32) { bitfield(&mut b, false, false, dst, src, 0, 15) }

pub fn clz(b: &mut ArmBuf, wide: bool, dst: i32, src: i32) {
    emit(&mut b, 0x5ac01000 + sf_bit(wide) + i64(src) * 32 + i64(dst))
}

pub fn rbit(b: &mut ArmBuf, wide: bool, dst: i32, src: i32) {
    emit(&mut b, 0x5ac00000 + sf_bit(wide) + i64(src) * 32 + i64(dst))
}

// --- Compare & Conditional Select ---

pub fn cmp_reg(b: &mut ArmBuf, wide: bool, lhs: i32, rhs: i32) {
    sub_reg(&mut b, wide, true, XZR, lhs, rhs)
}

pub fn cmp_imm(b: &mut ArmBuf, wide: bool, lhs: i32, value: i64) {
    sub_imm(&mut b, wide, true, XZR, lhs, value)
}

pub fn cmn_imm(b: &mut ArmBuf, wide: bool, lhs: i32, value: i64) {
    add_imm(&mut b, wide, true, XZR, lhs, value)
}

pub fn tst_reg(b: &mut ArmBuf, wide: bool, lhs: i32, rhs: i32) {
    and_reg(&mut b, wide, true, XZR, lhs, rhs)
}

pub fn csel(b: &mut ArmBuf, wide: bool, dst: i32, t_reg: i32, f_reg: i32, cc: i32) {
    emit(&mut b, 0x1a800000 + sf_bit(wide) + i64(f_reg) * 65536 + i64(cc) * 4096 + i64(t_reg) * 32 + i64(dst))
}

pub fn cset(b: &mut ArmBuf, dst: i32, cc: i32) {
    emit(&mut b, 0x9a9f07e0 + i64(invert_cc(cc)) * 4096 + i64(dst))
}

// --- Loads & Stores ---

fn size_shift(width: i32) -> i32 {
    if width == 1 { return 0 }
    if width == 2 { return 1 }
    if width == 4 { return 2 }
    assert(width == 8)
    3
}

// Unsigned scaled immediate offset load (1, 2, 4, or 8 bytes; zero-extending or sign-extending to 64-bit).
pub fn ldr(b: &mut ArmBuf, dst: i32, base: i32, offset: i32, width: i32, sign_ext: bool) {
    sh := size_shift(width)
    assert(offset >= 0 && (offset.bit_and((1.shl(sh)) - 1)) == 0)
    imm12 := offset.shr(sh)
    assert(imm12 >= 0 && imm12 <= 4095)
    mut op: i64 = 0x39400000 + i64(sh).shl(30)
    if sign_ext && width < 8 { op = 0x39800000 + i64(sh).shl(30) }
    emit(&mut b, op + i64(imm12) * 1024 + i64(base) * 32 + i64(dst))
}

pub fn str(b: &mut ArmBuf, src: i32, base: i32, offset: i32, width: i32) {
    sh := size_shift(width)
    assert(offset >= 0 && (offset.bit_and((1.shl(sh)) - 1)) == 0)
    imm12 := offset.shr(sh)
    assert(imm12 >= 0 && imm12 <= 4095)
    emit(&mut b, 0x39000000 + i64(sh).shl(30) + i64(imm12) * 1024 + i64(base) * 32 + i64(src))
}

// Unscaled signed 9-bit offset (-256..255) load/store (ldur/stur/ldursb/ldursh/ldursw).
pub fn ldur(b: &mut ArmBuf, dst: i32, base: i32, offset: i32, width: i32, sign_ext: bool) {
    sh := size_shift(width)
    assert(offset >= -256 && offset <= 255)
    mut op: i64 = 0x38400000 + i64(sh).shl(30)
    if sign_ext && width < 8 { op = 0x38800000 + i64(sh).shl(30) }
    emit(&mut b, op + i64(offset.bit_and(511)) * 4096 + i64(base) * 32 + i64(dst))
}

pub fn stur(b: &mut ArmBuf, src: i32, base: i32, offset: i32, width: i32) {
    sh := size_shift(width)
    assert(offset >= -256 && offset <= 255)
    emit(&mut b, 0x38000000 + i64(sh).shl(30) + i64(offset.bit_and(511)) * 4096 + i64(base) * 32 + i64(src))
}

// Scaled register-offset load/store: [base, index, lsl #shift] (unscaled when width==1).
pub fn ldr_idx(b: &mut ArmBuf, dst: i32, base: i32, index: i32, width: i32, sign_ext: bool) {
    sh := size_shift(width)
    s_bit: i64 = if sh > 0 { 0x1000 } else { 0 }
    mut op: i64 = 0x38606800 + i64(sh).shl(30) + s_bit
    if sign_ext && width < 8 { op = 0x38a06800 + i64(sh).shl(30) + s_bit }
    emit(&mut b, op + i64(index) * 65536 + i64(base) * 32 + i64(dst))
}

pub fn str_idx(b: &mut ArmBuf, src: i32, base: i32, index: i32, width: i32) {
    sh := size_shift(width)
    s_bit: i64 = if sh > 0 { 0x1000 } else { 0 }
    emit(&mut b, 0x38206800 + i64(sh).shl(30) + s_bit + i64(index) * 65536 + i64(base) * 32 + i64(src))
}

// Pre-index store / post-index load (64-bit single register, offset -256..255).
pub fn str_pre(b: &mut ArmBuf, src: i32, base: i32, offset: i32) {
    assert(offset >= -256 && offset <= 255)
    emit(&mut b, 0xf8000c00 + i64(offset.bit_and(511)) * 4096 + i64(base) * 32 + i64(src))
}

pub fn ldr_post(b: &mut ArmBuf, dst: i32, base: i32, offset: i32) {
    assert(offset >= -256 && offset <= 255)
    emit(&mut b, 0xf8400400 + i64(offset.bit_and(511)) * 4096 + i64(base) * 32 + i64(dst))
}

// 64-bit register pair loads/stores (offset multiple of 8, in -512..504).
pub fn stp_pre(b: &mut ArmBuf, r1: i32, r2: i32, base: i32, offset: i32) {
    assert(offset >= -512 && offset <= 504 && offset % 8 == 0)
    emit(&mut b, 0xa9800000 + i64((offset / 8).bit_and(127)).shl(15) + i64(r2) * 1024 + i64(base) * 32 + i64(r1))
}

pub fn ldp_post(b: &mut ArmBuf, r1: i32, r2: i32, base: i32, offset: i32) {
    assert(offset >= -512 && offset <= 504 && offset % 8 == 0)
    emit(&mut b, 0xa8c00000 + i64((offset / 8).bit_and(127)).shl(15) + i64(r2) * 1024 + i64(base) * 32 + i64(r1))
}

pub fn stp_off(b: &mut ArmBuf, r1: i32, r2: i32, base: i32, offset: i32) {
    assert(offset >= -512 && offset <= 504 && offset % 8 == 0)
    emit(&mut b, 0xa9000000 + i64((offset / 8).bit_and(127)).shl(15) + i64(r2) * 1024 + i64(base) * 32 + i64(r1))
}

pub fn ldp_off(b: &mut ArmBuf, r1: i32, r2: i32, base: i32, offset: i32) {
    assert(offset >= -512 && offset <= 504 && offset % 8 == 0)
    emit(&mut b, 0xa9400000 + i64((offset / 8).bit_and(127)).shl(15) + i64(r2) * 1024 + i64(base) * 32 + i64(r1))
}

// --- Floating-Point Scalar (f32 / f64) ---

pub fn fmov_to_fp(b: &mut ArmBuf, is_f64: bool, vd: i32, xn: i32) {
    base: i64 = if is_f64 { 0x9e670000 } else { 0x1e270000 }
    emit(&mut b, base + i64(xn) * 32 + i64(vd))
}

pub fn fmov_from_fp(b: &mut ArmBuf, is_f64: bool, xd: i32, vn: i32) {
    base: i64 = if is_f64 { 0x9e660000 } else { 0x1e260000 }
    emit(&mut b, base + i64(vn) * 32 + i64(xd))
}

pub fn fmov_reg(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32) {
    emit(&mut b, 0x1e204000 + ftype_bit(is_f64) + i64(vn) * 32 + i64(vd))
}

pub fn fadd(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32, vm: i32) {
    emit(&mut b, 0x1e202800 + ftype_bit(is_f64) + i64(vm) * 65536 + i64(vn) * 32 + i64(vd))
}

pub fn fsub(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32, vm: i32) {
    emit(&mut b, 0x1e203800 + ftype_bit(is_f64) + i64(vm) * 65536 + i64(vn) * 32 + i64(vd))
}

pub fn fmul(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32, vm: i32) {
    emit(&mut b, 0x1e200800 + ftype_bit(is_f64) + i64(vm) * 65536 + i64(vn) * 32 + i64(vd))
}

pub fn fdiv(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32, vm: i32) {
    emit(&mut b, 0x1e201800 + ftype_bit(is_f64) + i64(vm) * 65536 + i64(vn) * 32 + i64(vd))
}

pub fn fabs(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32) {
    emit(&mut b, 0x1e20c000 + ftype_bit(is_f64) + i64(vn) * 32 + i64(vd))
}

pub fn fneg(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32) {
    emit(&mut b, 0x1e214000 + ftype_bit(is_f64) + i64(vn) * 32 + i64(vd))
}

pub fn fsqrt(b: &mut ArmBuf, is_f64: bool, vd: i32, vn: i32) {
    emit(&mut b, 0x1e21c000 + ftype_bit(is_f64) + i64(vn) * 32 + i64(vd))
}

pub fn fcmp(b: &mut ArmBuf, is_f64: bool, vn: i32, vm: i32) {
    emit(&mut b, 0x1e202000 + ftype_bit(is_f64) + i64(vm) * 65536 + i64(vn) * 32)
}

pub fn fcmp_zero(b: &mut ArmBuf, is_f64: bool, vn: i32) {
    emit(&mut b, 0x1e202008 + ftype_bit(is_f64) + i64(vn) * 32)
}

pub fn scvtf(b: &mut ArmBuf, wide_int: bool, is_f64: bool, vd: i32, xn: i32) {
    emit(&mut b, 0x1e220000 + sf_bit(wide_int) + ftype_bit(is_f64) + i64(xn) * 32 + i64(vd))
}

pub fn ucvtf(b: &mut ArmBuf, wide_int: bool, is_f64: bool, vd: i32, xn: i32) {
    emit(&mut b, 0x1e230000 + sf_bit(wide_int) + ftype_bit(is_f64) + i64(xn) * 32 + i64(vd))
}

pub fn fcvtzs(b: &mut ArmBuf, wide_int: bool, is_f64: bool, xd: i32, vn: i32) {
    emit(&mut b, 0x1e380000 + sf_bit(wide_int) + ftype_bit(is_f64) + i64(vn) * 32 + i64(xd))
}

pub fn fcvtzu(b: &mut ArmBuf, wide_int: bool, is_f64: bool, xd: i32, vn: i32) {
    emit(&mut b, 0x1e390000 + sf_bit(wide_int) + ftype_bit(is_f64) + i64(vn) * 32 + i64(xd))
}

pub fn fcvt_f32_to_f64(b: &mut ArmBuf, vd: i32, vn: i32) {
    emit(&mut b, 0x1e22c000 + i64(vn) * 32 + i64(vd))
}

pub fn fcvt_f64_to_f32(b: &mut ArmBuf, vd: i32, vn: i32) {
    emit(&mut b, 0x1e624000 + i64(vn) * 32 + i64(vd))
}

pub fn ldr_fp(b: &mut ArmBuf, is_f64: bool, vt: i32, base: i32, offset: i32) {
    sh := if is_f64 { 3 } else { 2 }
    assert(offset >= 0 && (offset.bit_and((1.shl(sh)) - 1)) == 0)
    imm12 := offset.shr(sh)
    assert(imm12 >= 0 && imm12 <= 4095)
    base_op: i64 = if is_f64 { 0xfd400000 } else { 0xbd400000 }
    emit(&mut b, base_op + i64(imm12) * 1024 + i64(base) * 32 + i64(vt))
}

pub fn str_fp(b: &mut ArmBuf, is_f64: bool, vt: i32, base: i32, offset: i32) {
    sh := if is_f64 { 3 } else { 2 }
    assert(offset >= 0 && (offset.bit_and((1.shl(sh)) - 1)) == 0)
    imm12 := offset.shr(sh)
    assert(imm12 >= 0 && imm12 <= 4095)
    base_op: i64 = if is_f64 { 0xfd000000 } else { 0xbd000000 }
    emit(&mut b, base_op + i64(imm12) * 1024 + i64(base) * 32 + i64(vt))
}

// --- Control Flow, Relocs, System & Atomics ---

fn add_reloc(b: &mut ArmBuf, kind: RelocKind, target: i32, reg: i32, aux: i32) {
    b.reloc_at.push(b.words.len)
    b.reloc_target.push(target)
    b.reloc_kind.push(kind)
    b.reloc_reg.push(reg)
    b.reloc_aux.push(aux)
}

pub fn b(buf: &mut ArmBuf, lbl: i32) {
    add_reloc(&mut buf, .Branch26, lbl, 0, 0)
    emit(&mut buf, 0)
}

pub fn bl(buf: &mut ArmBuf, lbl: i32) {
    add_reloc(&mut buf, .Call26, lbl, 0, 0)
    emit(&mut buf, 0)
}

pub fn b_cond(buf: &mut ArmBuf, cc: i32, lbl: i32) {
    assert(cc >= 0 && cc <= 15)
    add_reloc(&mut buf, .Cond19, lbl, 0, cc)
    emit(&mut buf, 0)
    emit(&mut buf, NOP_WORD)
}

pub fn cbz(buf: &mut ArmBuf, wide: bool, reg: i32, lbl: i32) {
    assert(reg >= 0 && reg <= 31)
    add_reloc(&mut buf, .Cbz19, lbl, reg, if wide { 1 } else { 0 })
    emit(&mut buf, 0)
    emit(&mut buf, NOP_WORD)
}

pub fn cbnz(buf: &mut ArmBuf, wide: bool, reg: i32, lbl: i32) {
    assert(reg >= 0 && reg <= 31)
    add_reloc(&mut buf, .Cbnz19, lbl, reg, if wide { 1 } else { 0 })
    emit(&mut buf, 0)
    emit(&mut buf, NOP_WORD)
}

pub fn adrp_add(buf: &mut ArmBuf, dst: i32, lbl: i32) {
    assert(dst >= 0 && dst <= 30)
    add_reloc(&mut buf, .AdrpAdd, lbl, dst, 0)
    emit(&mut buf, 0)
    emit(&mut buf, 0)
}

pub fn adrp_ldr(buf: &mut ArmBuf, dst: i32, lbl: i32) {
    assert(dst >= 0 && dst <= 30)
    add_reloc(&mut buf, .AdrpLdr, lbl, dst, 0)
    emit(&mut buf, 0)
    emit(&mut buf, 0)
}

pub fn br(buf: &mut ArmBuf, reg: i32) { emit(&mut buf, 0xd61f0000 + i64(reg) * 32) }
pub fn blr(buf: &mut ArmBuf, reg: i32) { emit(&mut buf, 0xd63f0000 + i64(reg) * 32) }
pub fn ret(buf: &mut ArmBuf) { emit(&mut buf, 0xd65f03c0) }
pub fn nop(buf: &mut ArmBuf) { emit(&mut buf, NOP_WORD) }
pub fn svc(buf: &mut ArmBuf, imm16: i32) { emit(&mut buf, 0xd4000001 + i64(imm16.bit_and(65535)) * 32) }
pub fn brk(buf: &mut ArmBuf, imm16: i32) { emit(&mut buf, 0xd4200000 + i64(imm16.bit_and(65535)) * 32) }

// Atomics & Barriers
pub fn ldaxr(buf: &mut ArmBuf, wide: bool, rt: i32, rn: i32) {
    base: i64 = if wide { 0xc85ffc00 } else { 0x885ffc00 }
    emit(&mut buf, base + i64(rn) * 32 + i64(rt))
}

pub fn stlxr(buf: &mut ArmBuf, wide: bool, rs: i32, rt: i32, rn: i32) {
    base: i64 = if wide { 0xc800fc00 } else { 0x8800fc00 }
    emit(&mut buf, base + i64(rs) * 65536 + i64(rn) * 32 + i64(rt))
}

pub fn ldar(buf: &mut ArmBuf, wide: bool, rt: i32, rn: i32) {
    base: i64 = if wide { 0xc8dffc00 } else { 0x88dffc00 }
    emit(&mut buf, base + i64(rn) * 32 + i64(rt))
}

pub fn stlr(buf: &mut ArmBuf, wide: bool, rt: i32, rn: i32) {
    base: i64 = if wide { 0xc89ffc00 } else { 0x889ffc00 }
    emit(&mut buf, base + i64(rn) * 32 + i64(rt))
}

pub fn casal(buf: &mut ArmBuf, wide: bool, rs: i32, rt: i32, rn: i32) {
    base: i64 = if wide { 0xc8e0fc00 } else { 0x88e0fc00 }
    emit(&mut buf, base + i64(rs) * 65536 + i64(rn) * 32 + i64(rt))
}

pub fn dmb_ish(buf: &mut ArmBuf) { emit(&mut buf, 0xd5033bbf) }
pub fn dsb_ish(buf: &mut ArmBuf) { emit(&mut buf, 0xd5033b9f) }
pub fn isb(buf: &mut ArmBuf) { emit(&mut buf, 0xd5033fdf) }

// --- Native Stack Frame Prologue / Epilogue Helpers ---

pub fn emit_prologue(buf: &mut ArmBuf, frame_bytes: i32) {
    aligned := (frame_bytes + 15) / 16 * 16
    stp_pre(&mut buf, FP, LR, SP, -16)
    mov(&mut buf, FP, SP)
    if aligned == 0 { return }
    hi := aligned - (aligned % 4096)
    lo := aligned % 4096
    if hi > 0 { sub_imm(&mut buf, true, false, SP, SP, i64(hi)) }
    if lo > 0 { sub_imm(&mut buf, true, false, SP, SP, i64(lo)) }
}

pub fn emit_epilogue(buf: &mut ArmBuf) {
    mov(&mut buf, SP, FP)
    ldp_post(&mut buf, FP, LR, SP, 16)
    ret(&mut buf)
}

// --- Relaxation & Finalization ---

fn fits_cond19(word_delta: i64) -> bool { word_delta >= -262144 && word_delta < 262144 }

pub fn relax_branches(buf: &mut ArmBuf) -> i32 {
    n := buf.words.len
    mut shift: []i32 = []
    shift.reserve(n + 1)
    for _ in 0..n + 1 { shift.push(0) }
    for l in 0..buf.labels.len {
        pos := buf.labels[l]
        if pos >= 0 && pos <= n { shift[pos] = -1 }
    }
    for r in 0..buf.reloc_at.len {
        at := buf.reloc_at[r]
        if at >= 0 && at < n { shift[at] = -1 }
    }
    for r in 0..buf.reloc_at.len {
        k := buf.reloc_kind[r]
        if k != .Cond19 && k != .Cbz19 && k != .Cbnz19 { continue }
        at := buf.reloc_at[r]
        lbl := buf.reloc_target[r]
        if at < 0 || at + 1 >= n || lbl < 0 || lbl >= buf.labels.len { continue }
        if buf.words[at] != 0 || buf.words[at + 1] != NOP_WORD || shift[at + 1] == -1 { continue }
        dest := buf.labels[lbl]
        if dest < 0 || dest > n { continue }
        if fits_cond19(i64(dest - at)) { shift[at + 1] = -2 }
    }
    mut removed := 0
    for i in 0..n {
        drop := shift[i] == -2
        shift[i] = removed
        if drop { removed += 1 }
        else if removed > 0 { buf.words[i - removed] = buf.words[i] }
    }
    shift[n] = removed
    if removed == 0 { return 0 }
    buf.words.truncate(n - removed)
    for l in 0..buf.labels.len {
        pos := buf.labels[l]
        if pos >= 0 { buf.labels[l] = pos - shift[pos] }
    }
    for r in 0..buf.reloc_at.len {
        at := buf.reloc_at[r]
        buf.reloc_at[r] = at - shift[at]
    }
    removed
}

pub struct WordPair {
    w0: i64,
    w1: i64,
}

pub fn encode_adrp_add_words(from_byte: i32, dest_byte: i32, dst: i32) -> WordPair {
    pages := i64(dest_byte / 4096 - from_byte / 4096).bit_and(2097151)
    w0: i64 = (i64(0x90000000) + pages.bit_and(3).shl(29) + pages.shr(2).shl(5) + i64(dst)).bit_and(0xffffffff)
    w1: i64 = (i64(0x91000000) + i64(dest_byte % 4096).shl(10) + i64(dst) * 32 + i64(dst)).bit_and(0xffffffff)
    WordPair { w0: w0, w1: w1 }
}

pub fn encode_adrp_ldr_words(from_byte: i32, dest_byte: i32, dst: i32) -> WordPair {
    assert(dest_byte % 8 == 0)
    pages := i64(dest_byte / 4096 - from_byte / 4096).bit_and(2097151)
    w0: i64 = (i64(0x90000000) + pages.bit_and(3).shl(29) + pages.shr(2).shl(5) + i64(dst)).bit_and(0xffffffff)
    w1: i64 = (i64(0xf9400000) + i64((dest_byte % 4096) / 8).shl(10) + i64(dst) * 32 + i64(dst)).bit_and(0xffffffff)
    WordPair { w0: w0, w1: w1 }
}

pub fn patch_relocs(buf: &mut ArmBuf, text_offset: i32) {
    for i in 0..buf.reloc_at.len {
        at := buf.reloc_at[i]
        target := buf.labels[buf.reloc_target[i]]
        k := buf.reloc_kind[i]
        assert(target >= 0)
        delta := i64(target - at)
        if k == .Branch26 || k == .Call26 {
            assert(delta >= -33554432 && delta < 33554432)
            base: i64 = if k == .Call26 { 0x94000000 } else { 0x14000000 }
            buf.words[at] = (base + delta.bit_and(67108863)).bit_and(0xffffffff)
        } else if k == .AdrpAdd {
            pair := encode_adrp_add_words(text_offset + at * 4, text_offset + target * 4, buf.reloc_reg[i])
            buf.words[at] = pair.w0
            buf.words[at + 1] = pair.w1
        } else if k == .AdrpLdr {
            pair := encode_adrp_ldr_words(text_offset + at * 4, text_offset + target * 4, buf.reloc_reg[i])
            buf.words[at] = pair.w0
            buf.words[at + 1] = pair.w1
        } else {
            mut base: i64 = 0x54000000
            mut inverse: i64 = 1
            if k == .Cbz19 {
                sf: i64 = if buf.reloc_aux[i] != 0 { 0x80000000 } else { 0 }
                base = 0x34000000 + sf + i64(buf.reloc_reg[i])
                inverse = 0x01000000
            } else if k == .Cbnz19 {
                sf: i64 = if buf.reloc_aux[i] != 0 { 0x80000000 } else { 0 }
                base = 0x35000000 + sf + i64(buf.reloc_reg[i])
                inverse = 0x01000000
            } else {
                base = 0x54000000 + i64(buf.reloc_aux[i])
                inverse = 1
            }
            if fits_cond19(delta) {
                buf.words[at] = (base + delta.bit_and(524287).shl(5)).bit_and(0xffffffff)
            } else {
                buf.words[at] = (base.bit_xor(inverse) + 64).bit_and(0xffffffff)
                buf.words[at + 1] = (0x14000000 + (delta - 1).bit_and(67108863)).bit_and(0xffffffff)
            }
        }
    }
}

pub fn to_bytes(buf: &ArmBuf) -> []u8 {
    mut out: []u8 = []
    out.reserve(buf.words.len * 4)
    for i in 0..buf.words.len {
        w := buf.words[i]
        out.push(u8(w.bit_and(255)))
        out.push(u8(w.shr(8).bit_and(255)))
        out.push(u8(w.shr(16).bit_and(255)))
        out.push(u8(w.shr(24).bit_and(255)))
    }
    out
}

pub fn finish_at_offset(buf: &mut ArmBuf, text_offset: i32) -> []u8 {
    _ := relax_branches(&mut buf)
    patch_relocs(&mut buf, text_offset)
    to_bytes(&buf)
}
