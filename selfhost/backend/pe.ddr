import std.bytes as bytes

fn align(value: i32, alignment: i32) -> i32 {
    (value + alignment - 1) / alignment * alignment
}

fn lower_ascii(value: string) -> string {
    mut raw: []u8 = []
    raw.reserve(value.len)
    for i in 0..value.len {
        b := value[i]
        if b >= 65 && b <= 90 { raw.push(u8(b + 32)) }
        else { raw.push(u8(b)) }
    }
    decoded := bytes.decode(&raw)
    assert(decoded.ok)
    decoded.value
}

fn dll_name(raw: string) -> string {
    lower := lower_ascii(raw)
    if lower == "c" || lower == "msvcrt" { return "msvcrt.dll" }
    if lower == "kernel32" { return "kernel32.dll" }
    mut has_dot := false
    for i in 0..lower.len {
        if lower[i] == 46 { has_dot = true; break }
    }
    if !has_dot && lower.len > 0 { return lower + ".dll" }
    lower
}

fn copy_string(dst: &mut []u8, offset: i32, value: string) {
    for i in 0..value.len {
        dst[offset + i] = u8(value[i])
    }
}

fn store_le32(out: &mut []u8, offset: i32, value: i32) {
    v := i64(value)
    for i in 0..4 {
        out[offset + i] = u8(v.shr(i * 8).bit_and(255))
    }
}

fn store_le64(out: &mut []u8, offset: i32, value: i64) {
    for i in 0..8 {
        out[offset + i] = u8(value.shr(i * 8).bit_and(255))
    }
}

fn append_section_header(out: &mut []u8, label: string, vsize: i32, rva: i32, raw_size: i32, raw_off: i32, chars: i64) {
    assert(label.len <= 8)
    bytes.append_utf8(&mut out, label)
    bytes.pad(&mut out, 8 - label.len)
    bytes.append_le(&mut out, i64(vsize), 4)
    bytes.append_le(&mut out, i64(rva), 4)
    bytes.append_le(&mut out, i64(raw_size), 4)
    bytes.append_le(&mut out, i64(raw_off), 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, chars, 4)
}

fn build_rdata(libraries: &[]string, symbols: &[]string, rdata_rva: i32,
    sym_iat_rel: &mut []i32, out_import_dir_rel: &mut i32, out_import_dir_size: &mut i32, out_iat_size: &mut i32) -> []u8 {
    if symbols.len == 0 {
        out_import_dir_rel = 0
        out_import_dir_size = 0
        out_iat_size = 0
        return []
    }
    mut group_names: []string = []
    mut sym_group: []i32 = []
    sym_group.reserve(symbols.len)
    for i in 0..symbols.len {
        name := dll_name(libraries[i].clone())
        mut gid := -1
        for g in 0..group_names.len {
            if group_names[g] == name { gid = g; break }
        }
        if gid < 0 {
            gid = group_names.len
            group_names.push(move name)
        }
        sym_group.push(gid)
    }

    group_count := group_names.len
    mut group_syms: []i32 = []
    mut group_sym_counts: []i32 = []
    for _ in 0..group_count { group_sym_counts.push(0) }
    for g in 0..group_count {
        for s in 0..symbols.len {
            if sym_group[s] == g {
                group_syms.push(s)
                group_sym_counts[g] = group_sym_counts[g] + 1
            }
        }
    }

    for _ in 0..symbols.len { sym_iat_rel.push(0) }
    mut group_iat_rel: []i32 = []
    mut group_ilt_rel: []i32 = []
    mut group_name_rel: []i32 = []
    mut sym_hn_rel: []i32 = []
    for _ in 0..symbols.len { sym_hn_rel.push(0) }

    mut cursor := 0
    mut ordered := 0
    for g in 0..group_count {
        group_iat_rel.push(cursor)
        cnt := group_sym_counts[g]
        for _ in 0..cnt {
            sid := group_syms[ordered]
            sym_iat_rel[sid] = cursor
            cursor += 8
            ordered += 1
        }
        cursor += 8
    }
    out_iat_size = cursor

    out_import_dir_rel = cursor
    out_import_dir_size = (group_count + 1) * 20
    cursor += out_import_dir_size
    cursor = align(cursor, 8)

    for g in 0..group_count {
        group_ilt_rel.push(cursor)
        cursor += (group_sym_counts[g] + 1) * 8
    }

    for g in 0..group_count {
        group_name_rel.push(cursor)
        cursor += group_names[g].len + 1
    }

    ordered = 0
    for g in 0..group_count {
        cnt := group_sym_counts[g]
        for _ in 0..cnt {
            cursor = align(cursor, 2)
            sid := group_syms[ordered]
            sym_hn_rel[sid] = cursor
            cursor += 2 + symbols[sid].len + 1
            ordered += 1
        }
    }

    mut rdata: []u8 = []
    bytes.pad(&mut rdata, cursor)

    ordered = 0
    for g in 0..group_count {
        cnt := group_sym_counts[g]
        desc_off := out_import_dir_rel + g * 20
        store_le32(&mut rdata, desc_off + 0, rdata_rva + group_ilt_rel[g])
        store_le32(&mut rdata, desc_off + 12, rdata_rva + group_name_rel[g])
        store_le32(&mut rdata, desc_off + 16, rdata_rva + group_iat_rel[g])

        copy_string(&mut rdata, group_name_rel[g], group_names[g].clone())

        for k in 0..cnt {
            sid := group_syms[ordered]
            hn_rva := i64(rdata_rva + sym_hn_rel[sid])
            store_le64(&mut rdata, group_ilt_rel[g] + k * 8, hn_rva)
            store_le64(&mut rdata, group_iat_rel[g] + k * 8, hn_rva)

            copy_string(&mut rdata, sym_hn_rel[sid] + 2, symbols[sid].clone())
            ordered += 1
        }
    }
    rdata
}

pub fn image(text: &[]u8, libraries: &[]string, symbols: &[]string, sites: &[]i32, slots: &[]i32, globals: i32) -> []u8 {
    assert(symbols.len == libraries.len && sites.len == slots.len)
    sec_align := 4096
    file_align := 512
    headers_size := 512
    text_rva := 4096
    text_vsize := if text.len > 0 { text.len } else { 1 }
    text_raw_size := align(text_vsize, file_align)
    text_raw_off := headers_size

    has_rdata := symbols.len > 0
    has_data := globals > 0
    mut num_sections := 1
    if has_rdata { num_sections += 1 }
    if has_data { num_sections += 1 }

    mut next_rva := text_rva + align(text_vsize, sec_align)
    mut next_file := text_raw_off + text_raw_size

    rdata_rva := next_rva
    rdata_raw_off := next_file
    mut sym_iat_rel: []i32 = []
    mut import_dir_rel := 0
    mut import_dir_size := 0
    mut iat_size := 0
    rdata := build_rdata(&libraries, &symbols, rdata_rva, &mut sym_iat_rel, &mut import_dir_rel, &mut import_dir_size, &mut iat_size)
    mut rdata_raw_size := 0
    if has_rdata {
        rdata_raw_size = align(rdata.len, file_align)
        next_rva = rdata_rva + align(rdata.len, sec_align)
        next_file = rdata_raw_off + rdata_raw_size
    }

    data_rva := next_rva
    data_raw_off := next_file
    mut data_raw_size := 0
    if has_data {
        data_raw_size = align(globals, file_align)
        next_rva = data_rva + align(globals, sec_align)
        next_file = data_raw_off + data_raw_size
    }
    size_of_image := next_rva

    mut patched_text: []u8 = []
    patched_text.reserve(text.len)
    bytes.extend(&mut patched_text, &text)
    for i in 0..sites.len {
        site := sites[i]
        slot := slots[i]
        assert(site >= 0 && site + 4 <= patched_text.len)
        mut target_rva := 0
        if slot < 0 {
            assert(has_data)
            target_rva = data_rva + (-1 - slot)
        } else {
            assert(slot < sym_iat_rel.len)
            target_rva = rdata_rva + sym_iat_rel[slot]
        }
        disp := target_rva - (text_rva + site + 4)
        store_le32(&mut patched_text, site, disp)
    }

    mut out: []u8 = []
    out.reserve(next_file)

    bytes.append_le(&mut out, 0x5A4D, 2)
    bytes.pad(&mut out, 58)
    bytes.append_le(&mut out, 128, 4)
    bytes.pad(&mut out, 64)
    assert(out.len == 128)

    bytes.append_le(&mut out, 0x00004550, 4)
    bytes.append_le(&mut out, 0x8664, 2)
    bytes.append_le(&mut out, i64(num_sections), 2)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 240, 2)
    bytes.append_le(&mut out, 0x0022, 2)

    bytes.append_le(&mut out, 0x020B, 2)
    out.push(u8(1))
    out.push(u8(0))
    bytes.append_le(&mut out, i64(text_raw_size), 4)
    bytes.append_le(&mut out, i64(rdata_raw_size + data_raw_size), 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, i64(text_rva), 4)
    bytes.append_le(&mut out, i64(text_rva), 4)
    bytes.append_le(&mut out, i64(5368709120), 8)
    bytes.append_le(&mut out, i64(sec_align), 4)
    bytes.append_le(&mut out, i64(file_align), 4)
    bytes.append_le(&mut out, 6, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 6, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, i64(size_of_image), 4)
    bytes.append_le(&mut out, i64(headers_size), 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 3, 2)
    bytes.append_le(&mut out, 0x8100, 2)
    bytes.append_le(&mut out, 0x100000, 8)
    bytes.append_le(&mut out, 0x1000, 8)
    bytes.append_le(&mut out, 0x100000, 8)
    bytes.append_le(&mut out, 0x1000, 8)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 16, 4)

    for dir in 0..16 {
        if dir == 1 && has_rdata {
            bytes.append_le(&mut out, i64(rdata_rva + import_dir_rel), 4)
            bytes.append_le(&mut out, i64(import_dir_size), 4)
        } else if dir == 12 && has_rdata {
            bytes.append_le(&mut out, i64(rdata_rva), 4)
            bytes.append_le(&mut out, i64(iat_size), 4)
        } else {
            bytes.append_le(&mut out, 0, 8)
        }
    }

    append_section_header(&mut out, ".text", text.len, text_rva, text_raw_size, text_raw_off, i64(0x60000020))
    if has_rdata {
        append_section_header(&mut out, ".rdata", rdata.len, rdata_rva, rdata_raw_size, rdata_raw_off, i64(0x40000040))
    }
    if has_data {
        append_section_header(&mut out, ".data", globals, data_rva, data_raw_size, data_raw_off, i64(0xC0000040))
    }
    assert(out.len <= headers_size)
    bytes.pad(&mut out, headers_size - out.len)

    bytes.extend(&mut out, &patched_text)
    bytes.pad(&mut out, text_raw_size - patched_text.len)
    if has_rdata {
        bytes.extend(&mut out, &rdata)
        bytes.pad(&mut out, rdata_raw_size - rdata.len)
    }
    if has_data {
        bytes.pad(&mut out, data_raw_size)
    }
    out
}

fn read_le16(raw: &[]u8, offset: i32) -> i32 {
    i32(raw[offset]) + i32(raw[offset + 1]) * 256
}

fn read_le32(raw: &[]u8, offset: i32) -> i64 {
    mut val: i64 = 0
    for i in 0..4 {
        val += i64(raw[offset + i]).shl(i * 8)
    }
    val
}

@test fn emits_valid_pe32_plus_with_grouped_imports_and_patched_relocs() {
    mut code: []u8 = [
        u8(0xff), u8(0x15), u8(0), u8(0), u8(0), u8(0),
        u8(0x48), u8(0x8b), u8(0x05), u8(0), u8(0), u8(0), u8(0),
        u8(0xff), u8(0x15), u8(0), u8(0), u8(0), u8(0),
        u8(0x48), u8(0x8d), u8(0x05), u8(0), u8(0), u8(0), u8(0),
    ]
    libs: []string = ["kernel32", "c", "KERNEL32.DLL"]
    syms: []string = ["VirtualAlloc", "puts", "ExitProcess"]
    sites: []i32 = [2, 9, 15, 22]
    slots: []i32 = [0, 1, 2, -9]
    img := image(&code, &libs, &syms, &sites, &slots, 32)
    assert(img[0] == u8(0x4d) && img[1] == u8(0x5a))
    lfanew := i32(read_le32(&img, 60))
    assert(lfanew == 128)
    assert(img[lfanew] == u8(0x50) && img[lfanew + 1] == u8(0x45))
    assert(read_le16(&img, lfanew + 4) == 0x8664)
    assert(read_le16(&img, lfanew + 6) == 3)
    assert(read_le16(&img, lfanew + 24) == 0x020B)
    assert(read_le32(&img, lfanew + 24 + 16) == 0x1000)
    assert(read_le32(&img, lfanew + 24 + 60) == 0x200)
    assert(read_le16(&img, lfanew + 24 + 68) == 3)

    imp_dir_rva := i32(read_le32(&img, lfanew + 24 + 120))
    iat_rva := i32(read_le32(&img, lfanew + 24 + 208))
    assert(iat_rva == 0x2000)
    assert(imp_dir_rva > iat_rva)

    disp0 := i32(read_le32(&img, 0x200 + 2))
    assert(0x1000 + 6 + disp0 == 0x2000)
    disp1 := i32(read_le32(&img, 0x200 + 9))
    assert(0x1000 + 13 + disp1 == 0x2000 + 24)
    disp2 := i32(read_le32(&img, 0x200 + 15))
    assert(0x1000 + 19 + disp2 == 0x2000 + 8)
    disp3 := i32(read_le32(&img, 0x200 + 22))
    assert(0x1000 + 26 + disp3 == 0x3000 + 8)
}
