import std.bytes as bytes
import imports

pub struct UnwindEntry {
    start_off: i32,
    end_off: i32,
    prolog_size: i32,
    frame_size: i32,
    frame_reg: i32,
    saved_reg_mask: i32,
}

pub struct PeConfig {
    subsystem: i32,
    aslr: bool,
    dpi_aware: bool,
    utf8_codepage: bool,
    manifest_xml: string,
    unwind: []UnwindEntry,
    overrides: []imports.LibraryOverride,
}

pub fn subsystem_console() -> i32 { 3 }
pub fn subsystem_gui() -> i32 { 2 }

pub fn default_config() -> PeConfig {
    PeConfig {
        subsystem: 3,
        aslr: false,
        dpi_aware: false,
        utf8_codepage: false,
        manifest_xml: "",
        unwind: [],
        overrides: [],
    }
}

pub fn modern_config(subsystem: i32, dpi_aware: bool, utf8_codepage: bool) -> PeConfig {
    PeConfig {
        subsystem: subsystem,
        aslr: true,
        dpi_aware: dpi_aware,
        utf8_codepage: utf8_codepage,
        manifest_xml: "",
        unwind: [],
        overrides: [],
    }
}

fn align(value: i32, alignment: i32) -> i32 {
    (value + alignment - 1) / alignment * alignment
}

pub fn dll_name(raw: string) -> string {
    imports.resolve_library(raw, 5, .Glibc).name
}

fn copy_string(dst: &mut []u8, offset: i32, value: string) {
    for i in 0..value.len {
        dst[offset + i] = u8(value[i])
    }
}

fn store_le16(out: &mut []u8, offset: i32, value: i32) {
    v := i64(value)
    out[offset] = u8(v.bit_and(255))
    out[offset + 1] = u8(v.shr(8).bit_and(255))
}

fn store_le32(out: &mut []u8, offset: i32, value: i32) {
    v := i64(value)
    for i in 0..4 {
        out[offset + i] = u8(v.shr(i * 8).bit_and(255))
    }
}

fn store_le64(out: &mut []u8, offset: i32, value: i64) {
    for i in 0..8 {
        out[offset + i] = u8(value.shr(i * 8).bit_and(255))
    }
}

fn append_section_header(out: &mut []u8, label: string, vsize: i32, rva: i32, raw_size: i32, raw_off: i32, chars: i64) {
    assert(label.len <= 8)
    bytes.append_utf8(&mut out, label)
    bytes.pad(&mut out, 8 - label.len)
    bytes.append_le(&mut out, i64(vsize), 4)
    bytes.append_le(&mut out, i64(rva), 4)
    bytes.append_le(&mut out, i64(raw_size), 4)
    bytes.append_le(&mut out, i64(raw_off), 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, chars, 4)
}

fn default_manifest_xml(dpi_aware: bool, utf8_codepage: bool) -> string {
    mut out := "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\r\n" +
        "<assembly xmlns=\"urn:schemas-microsoft-com:asm.v1\" manifestVersion=\"1.0\">\r\n" +
        "  <compatibility xmlns=\"urn:schemas-microsoft-com:compatibility.v1\">\r\n" +
        "    <application>\r\n" +
        "      <supportedOS Id=\"{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}\"/>\r\n" +
        "    </application>\r\n" +
        "  </compatibility>\r\n"
    if dpi_aware || utf8_codepage {
        out = out + "  <application xmlns=\"urn:schemas-microsoft-com:asm.v3\">\r\n    <windowsSettings>\r\n"
        if dpi_aware {
            out = out + "      <dpiAware xmlns=\"http://schemas.microsoft.com/SMI/2005/WindowsSettings\">true/pm</dpiAware>\r\n" +
                "      <dpiAwareness xmlns=\"http://schemas.microsoft.com/SMI/2016/WindowsSettings\">PerMonitorV2</dpiAwareness>\r\n"
        }
        if utf8_codepage {
            out = out + "      <activeCodePage xmlns=\"http://schemas.microsoft.com/SMI/2019/WindowsSettings\">UTF-8</activeCodePage>\r\n"
        }
        out = out + "    </windowsSettings>\r\n  </application>\r\n"
    }
    out + "</assembly>\r\n"
}

fn build_rsrc_manifest(xml: string, rsrc_rva: i32) -> []u8 {
    mut out: []u8 = []
    out.reserve(88 + xml.len)
    // Level 1: Type directory (RT_MANIFEST = 24) at offset 0 -> Level 2 at offset 24
    bytes.pad(&mut out, 12)
    bytes.append_le(&mut out, 0, 2) // NumberOfNamedEntries
    bytes.append_le(&mut out, 1, 2) // NumberOfIdEntries
    bytes.append_le(&mut out, 24, 4) // RT_MANIFEST
    bytes.append_le(&mut out, i64(24).bit_or(2147483648), 4) // subdirectory at 24

    // Level 2: Name directory (ID = 1) at offset 24 -> Level 3 at offset 48
    bytes.pad(&mut out, 12)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 1, 2)
    bytes.append_le(&mut out, 1, 4) // CREATEPROCESS_MANIFEST_RESOURCE_ID
    bytes.append_le(&mut out, i64(48).bit_or(2147483648), 4) // subdirectory at 48

    // Level 3: Language directory (1033 = EN-US) at offset 48 -> Data entry at offset 72
    bytes.pad(&mut out, 12)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 1, 2)
    bytes.append_le(&mut out, 1033, 4) // MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US)
    bytes.append_le(&mut out, 72, 4) // IMAGE_RESOURCE_DATA_ENTRY at 72

    // IMAGE_RESOURCE_DATA_ENTRY at offset 72
    bytes.append_le(&mut out, i64(rsrc_rva + 88), 4) // OffsetToData (RVA)
    bytes.append_le(&mut out, i64(xml.len), 4) // Size
    bytes.append_le(&mut out, 65001, 4) // CodePage (UTF-8)
    bytes.append_le(&mut out, 0, 4) // Reserved

    // Manifest XML bytes at offset 88
    bytes.append_utf8(&mut out, xml)
    out
}

fn build_reloc_minimal(text_rva: i32) -> []u8 {
    // Minimal valid IMAGE_BASE_RELOCATION block (pure RIP-relative code has 0 fixups).
    mut out: []u8 = []
    bytes.append_le(&mut out, i64(text_rva), 4) // VirtualAddress
    bytes.append_le(&mut out, 12, 4) // SizeOfBlock (8-byte header + two 2-byte ABS pad entries)
    bytes.append_le(&mut out, 0, 2) // IMAGE_REL_BASED_ABSOLUTE
    bytes.append_le(&mut out, 0, 2) // IMAGE_REL_BASED_ABSOLUTE
    out
}

fn build_pdata(entries: &[]UnwindEntry, text_rva: i32, pdata_rva: i32, out_rf_size: &mut i32) -> []u8 {
    if entries.len == 0 {
        out_rf_size = 0
        return []
    }
    // Sort entry indices by start_off (Win64 requires RUNTIME_FUNCTION sorted by BeginAddress)
    mut order: []i32 = []
    order.reserve(entries.len)
    for i in 0..entries.len { order.push(i) }
    for i in 1..order.len {
        mut j := i
        while j > 0 && entries[order[j]].start_off < entries[order[j - 1]].start_off {
            order.swap(j - 1, j)
            j -= 1
        }
    }
    rf_size := order.len * 12
    out_rf_size = rf_size
    mut xdata: []u8 = []
    mut info_rels: []i32 = []
    info_rels.reserve(order.len)
    for k in 0..order.len {
        e := &entries[order[k]]
        while xdata.len % 4 != 0 { xdata.push(0) }
        info_rels.push(rf_size + xdata.len)
        mut codes: []u8 = []
        prolog := if e.prolog_size > 255 { 255 } else if e.prolog_size < 0 { 0 } else { e.prolog_size }
        // Stack allocation unwind code
        if e.frame_size > 0 {
            if e.frame_size <= 128 && e.frame_size % 8 == 0 {
                // UWOP_ALLOC_SMALL (2): info = (size/8) - 1
                info := e.frame_size / 8 - 1
                codes.push(u8(prolog))
                codes.push(u8(info * 16 + 2))
            } else if e.frame_size <= 524280 && e.frame_size % 8 == 0 {
                // UWOP_ALLOC_LARGE (1), info = 0: followed by u16(size/8)
                codes.push(u8(prolog))
                codes.push(u8(1))
                bytes.append_le(&mut codes, i64(e.frame_size / 8), 2)
            } else {
                // UWOP_ALLOC_LARGE (1), info = 1: followed by u32(size)
                codes.push(u8(prolog))
                codes.push(u8(17))
                bytes.append_le(&mut codes, i64(e.frame_size), 4)
            }
        }
        // Saved nonvolatile GPRs (UWOP_PUSH_NONVOL = 0, info = reg number 0..15)
        for reg in 0..16 {
            if e.saved_reg_mask.bit_and(i32(1).shl(reg)) != 0 {
                codes.push(u8(prolog))
                codes.push(u8(reg * 16))
            }
        }
        code_count := codes.len / 2
        xdata.push(1) // Version=1, Flags=0
        xdata.push(u8(prolog))
        xdata.push(u8(code_count))
        xdata.push(u8(e.frame_reg.bit_and(15)))
        bytes.extend(&mut xdata, &codes)
        if code_count % 2 != 0 {
            xdata.push(0); xdata.push(0)
        }
    }
    mut out: []u8 = []
    out.reserve(rf_size + xdata.len)
    for k in 0..order.len {
        e := &entries[order[k]]
        bytes.append_le(&mut out, i64(text_rva + e.start_off), 4)
        bytes.append_le(&mut out, i64(text_rva + e.end_off), 4)
        bytes.append_le(&mut out, i64(pdata_rva + info_rels[k]), 4)
    }
    bytes.extend(&mut out, &xdata)
    out
}

struct ImportLayout {
    rdata: []u8,
    sym_is_delay: []bool,
    sym_iat_rel: []i32,
    import_dir_rel: i32,
    import_dir_size: i32,
    iat_size: i32,
    delay_dir_rel: i32,
    delay_dir_size: i32,
    delay_data_size: i32,
}

fn build_imports(specs: &[]imports.SymbolSpec, overrides: &[]imports.LibraryOverride,
                 rdata_rva: i32, data_rva: i32, delay_data_base: i32) -> ImportLayout {
    if specs.len == 0 {
        return ImportLayout {
            rdata: [], sym_is_delay: [], sym_iat_rel: [],
            import_dir_rel: 0, import_dir_size: 0, iat_size: 0,
            delay_dir_rel: 0, delay_dir_size: 0, delay_data_size: 0,
        }
    }
    table := imports.resolve_table(&specs, 5, .Glibc, &overrides)
    group_count := table.names.len

    mut eager_groups: []i32 = []
    mut delay_groups: []i32 = []
    for g in 0..group_count {
        if table.delay[g] { delay_groups.push(g) } else { eager_groups.push(g) }
    }

    mut group_syms: [][]i32 = []
    for _ in 0..group_count { group_syms.push([]) }
    for s in 0..specs.len {
        g := table.ordinals[s] - 1
        group_syms[g].push(s)
    }

    mut sym_is_delay: []bool = []
    mut sym_iat_rel: []i32 = []
    mut sym_hn_rel: []i32 = []
    for s in 0..specs.len {
        sym_is_delay.push(table.delay[table.ordinals[s] - 1])
        sym_iat_rel.push(0)
        sym_hn_rel.push(0)
    }

    mut group_iat_rel: []i32 = []
    mut group_ilt_rel: []i32 = []
    mut group_name_rel: []i32 = []
    mut group_hmod_rel: []i32 = []
    for _ in 0..group_count {
        group_iat_rel.push(0); group_ilt_rel.push(0); group_name_rel.push(0); group_hmod_rel.push(0)
    }

    // 1. Eager IATs at start of .rdata (DataDirectory[12])
    mut cursor := 0
    for g in &eager_groups {
        group_iat_rel[g] = cursor
        for s in &group_syms[g] {
            sym_iat_rel[s] = cursor
            cursor += 8
        }
        cursor += 8
    }
    iat_size := cursor

    // 2. Eager Import Directory Table (DataDirectory[1])
    mut import_dir_rel := 0
    mut import_dir_size := 0
    if eager_groups.len > 0 {
        import_dir_rel = cursor
        import_dir_size = (eager_groups.len + 1) * 20
        cursor += import_dir_size
        cursor = align(cursor, 8)
    }

    // 3. Eager ILTs
    for g in &eager_groups {
        group_ilt_rel[g] = cursor
        cursor += (group_syms[g].len + 1) * 8
    }

    // 4. Delay-Load Import Directory (DataDirectory[13]) & Delay INTs in .rdata, plus HMODULE & Delay IAT in .data
    mut delay_dir_rel := 0
    mut delay_dir_size := 0
    mut data_cursor := delay_data_base
    if delay_groups.len > 0 {
        cursor = align(cursor, 4)
        delay_dir_rel = cursor
        delay_dir_size = (delay_groups.len + 1) * 32
        cursor += delay_dir_size
        cursor = align(cursor, 8)
        for g in &delay_groups {
            group_ilt_rel[g] = cursor // Delay INT in .rdata
            cursor += (group_syms[g].len + 1) * 8

            group_hmod_rel[g] = data_cursor
            data_cursor += 8
        }
        for g in &delay_groups {
            group_iat_rel[g] = data_cursor // Writable Delay IAT in .data
            for s in &group_syms[g] {
                sym_iat_rel[s] = data_cursor
                data_cursor += 8
            }
            data_cursor += 8
        }
    }
    delay_data_size := data_cursor - delay_data_base

    // 5. DLL name strings
    for g in 0..group_count {
        group_name_rel[g] = cursor
        cursor += table.names[g].len + 1
    }

    // 6. Hint/Name entries for non-ordinal symbols
    for g in 0..group_count {
        for s in &group_syms[g] {
            if specs[s].ordinal > 0 { continue }
            cursor = align(cursor, 2)
            sym_hn_rel[s] = cursor
            cursor += 2 + specs[s].name.len + 1
        }
    }

    mut rdata: []u8 = []
    bytes.pad(&mut rdata, cursor)

    ord_flag: i64 = -9223372036854775808 // IMAGE_ORDINAL_FLAG64 (0x8000000000000000)

    // Populate eager import descriptors + ILT/IAT
    for ei in 0..eager_groups.len {
        g := eager_groups[ei]
        desc_off := import_dir_rel + ei * 20
        store_le32(&mut rdata, desc_off + 0, rdata_rva + group_ilt_rel[g])
        store_le32(&mut rdata, desc_off + 12, rdata_rva + group_name_rel[g])
        store_le32(&mut rdata, desc_off + 16, rdata_rva + group_iat_rel[g])
        copy_string(&mut rdata, group_name_rel[g], table.names[g].clone())
        for k in 0..group_syms[g].len {
            sid := group_syms[g][k]
            mut thunk: i64 = 0
            if specs[sid].ordinal > 0 {
                thunk = ord_flag.bit_or(i64(specs[sid].ordinal).bit_and(65535))
            } else {
                thunk = i64(rdata_rva + sym_hn_rel[sid])
                copy_string(&mut rdata, sym_hn_rel[sid] + 2, specs[sid].name.clone())
            }
            store_le64(&mut rdata, group_ilt_rel[g] + k * 8, thunk)
            store_le64(&mut rdata, group_iat_rel[g] + k * 8, thunk)
        }
    }

    // Populate delay-load descriptors + Delay INT
    for di in 0..delay_groups.len {
        g := delay_groups[di]
        desc_off := delay_dir_rel + di * 32
        store_le32(&mut rdata, desc_off + 0, 1) // dlattrRva = 1
        store_le32(&mut rdata, desc_off + 4, rdata_rva + group_name_rel[g]) // rvaDLLName
        store_le32(&mut rdata, desc_off + 8, data_rva + group_hmod_rel[g]) // rvaHmod
        store_le32(&mut rdata, desc_off + 12, data_rva + group_iat_rel[g]) // rvaIAT
        store_le32(&mut rdata, desc_off + 16, rdata_rva + group_ilt_rel[g]) // rvaINT
        // rvaBoundIAT (20), rvaUnloadIAT (24), dwTimeStamp (28) stay 0
        copy_string(&mut rdata, group_name_rel[g], table.names[g].clone())
        for k in 0..group_syms[g].len {
            sid := group_syms[g][k]
            mut thunk: i64 = 0
            if specs[sid].ordinal > 0 {
                thunk = ord_flag.bit_or(i64(specs[sid].ordinal).bit_and(65535))
            } else {
                thunk = i64(rdata_rva + sym_hn_rel[sid])
                copy_string(&mut rdata, sym_hn_rel[sid] + 2, specs[sid].name.clone())
            }
            store_le64(&mut rdata, group_ilt_rel[g] + k * 8, thunk)
        }
    }

    ImportLayout {
        rdata: rdata,
        sym_is_delay: sym_is_delay,
        sym_iat_rel: sym_iat_rel,
        import_dir_rel: import_dir_rel,
        import_dir_size: import_dir_size,
        iat_size: iat_size,
        delay_dir_rel: delay_dir_rel,
        delay_dir_size: delay_dir_size,
        delay_data_size: delay_data_size,
    }
}

pub fn image_configured(text: &[]u8, specs: &[]imports.SymbolSpec, sites: &[]i32, slots: &[]i32,
                        globals: i32, config: &PeConfig) -> []u8 {
    assert(sites.len == slots.len)
    sec_align := 4096
    file_align := 512

    // Detect if any symbols are delay-loaded so we know whether .data is required
    table_probe := imports.resolve_table(&specs, 5, .Glibc, &config.overrides)
    mut has_delay := false
    for d in &table_probe.delay { if d { has_delay = true; break } }

    has_rdata := specs.len > 0
    has_data := globals > 0 || has_delay
    has_pdata := config.unwind.len > 0
    manifest_text := if config.manifest_xml != "" {
        config.manifest_xml.clone()
    } else if config.dpi_aware || config.utf8_codepage {
        default_manifest_xml(config.dpi_aware, config.utf8_codepage)
    } else {
        ""
    }
    has_rsrc := manifest_text.len > 0
    has_reloc := config.aslr

    mut num_sections := 1 // .text
    if has_rdata { num_sections += 1 }
    if has_data { num_sections += 1 }
    if has_pdata { num_sections += 1 }
    if has_rsrc { num_sections += 1 }
    if has_reloc { num_sections += 1 }

    // Dynamic header size: DOS(128) + PE(4) + COFF(20) + Opt(240) + num_sections * 40
    headers_size := align(392 + num_sections * 40, file_align)
    text_rva := align(headers_size, sec_align)
    text_vsize := if text.len > 0 { text.len } else { 1 }
    text_raw_size := align(text_vsize, file_align)
    text_raw_off := headers_size

    mut next_rva := text_rva + align(text_vsize, sec_align)
    mut next_file := text_raw_off + text_raw_size

    // Pre-assign .rdata and .data RVAs (since delay-load descriptors in .rdata reference .data RVAs!)
    rdata_rva := next_rva
    rdata_raw_off := next_file
    delay_data_base := align(globals, 8)
    // First pass to know rdata.len (independent of data_rva value)
    probe_imp := build_imports(&specs, &config.overrides, rdata_rva, 0, delay_data_base)
    mut rdata_raw_size := 0
    if has_rdata {
        rdata_raw_size = align(probe_imp.rdata.len, file_align)
        next_rva = rdata_rva + align(probe_imp.rdata.len, sec_align)
        next_file = rdata_raw_off + rdata_raw_size
    }

    data_rva := next_rva
    data_raw_off := next_file
    data_vsize := if has_delay { delay_data_base + probe_imp.delay_data_size } else { globals }
    mut data_raw_size := 0
    if has_data {
        data_raw_size = align(data_vsize, file_align)
        next_rva = data_rva + align(data_vsize, sec_align)
        next_file = data_raw_off + data_raw_size
    }

    // Final import tables with exact data_rva
    imp := build_imports(&specs, &config.overrides, rdata_rva, data_rva, delay_data_base)

    pdata_rva := next_rva
    pdata_raw_off := next_file
    mut pdata_rf_size := 0
    pdata := build_pdata(&config.unwind, text_rva, pdata_rva, &mut pdata_rf_size)
    mut pdata_raw_size := 0
    if has_pdata {
        pdata_raw_size = align(pdata.len, file_align)
        next_rva = pdata_rva + align(pdata.len, sec_align)
        next_file = pdata_raw_off + pdata_raw_size
    }

    rsrc_rva := next_rva
    rsrc_raw_off := next_file
    rsrc := if has_rsrc { build_rsrc_manifest(manifest_text, rsrc_rva) } else { [] }
    mut rsrc_raw_size := 0
    if has_rsrc {
        rsrc_raw_size = align(rsrc.len, file_align)
        next_rva = rsrc_rva + align(rsrc.len, sec_align)
        next_file = rsrc_raw_off + rsrc_raw_size
    }

    reloc_rva := next_rva
    reloc_raw_off := next_file
    reloc := if has_reloc { build_reloc_minimal(text_rva) } else { [] }
    mut reloc_raw_size := 0
    if has_reloc {
        reloc_raw_size = align(reloc.len, file_align)
        next_rva = reloc_rva + align(reloc.len, sec_align)
        next_file = reloc_raw_off + reloc_raw_size
    }

    size_of_image := next_rva

    mut patched_text: []u8 = []
    patched_text.reserve(text.len)
    bytes.extend(&mut patched_text, &text)
    for i in 0..sites.len {
        site := sites[i]
        slot := slots[i]
        assert(site >= 0 && site + 4 <= patched_text.len)
        mut target_rva := 0
        if slot < 0 {
            assert(has_data)
            target_rva = data_rva + (-1 - slot)
        } else {
            assert(slot < imp.sym_iat_rel.len)
            if imp.sym_is_delay[slot] {
                target_rva = data_rva + imp.sym_iat_rel[slot]
            } else {
                target_rva = rdata_rva + imp.sym_iat_rel[slot]
            }
        }
        disp := target_rva - (text_rva + site + 4)
        store_le32(&mut patched_text, site, disp)
    }

    mut out: []u8 = []
    out.reserve(next_file)

    // DOS Header (128 bytes)
    bytes.append_le(&mut out, 0x5A4D, 2)
    bytes.pad(&mut out, 58)
    bytes.append_le(&mut out, 128, 4)
    bytes.pad(&mut out, 64)
    assert(out.len == 128)

    // PE Signature + COFF File Header (24 bytes)
    bytes.append_le(&mut out, 0x00004550, 4)
    bytes.append_le(&mut out, 0x8664, 2)
    bytes.append_le(&mut out, i64(num_sections), 2)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 240, 2)
    bytes.append_le(&mut out, 0x0022, 2) // EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

    // Optional Header PE32+ (240 bytes)
    init_data_size := rdata_raw_size + data_raw_size + pdata_raw_size + rsrc_raw_size + reloc_raw_size
    dll_chars: i64 = if config.aslr { 0x8160 } else { 0x8100 } // HIGH_ENTROPY_VA | DYNAMIC_BASE | NX_COMPAT | TERMINAL_SERVER_AWARE
    subsys := if config.subsystem == 2 { 2 } else { 3 }

    bytes.append_le(&mut out, 0x020B, 2)
    out.push(u8(1))
    out.push(u8(0))
    bytes.append_le(&mut out, i64(text_raw_size), 4)
    bytes.append_le(&mut out, i64(init_data_size), 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, i64(text_rva), 4)
    bytes.append_le(&mut out, i64(text_rva), 4)
    bytes.append_le(&mut out, i64(5368709120), 8) // ImageBase 0x140000000
    bytes.append_le(&mut out, i64(sec_align), 4)
    bytes.append_le(&mut out, i64(file_align), 4)
    bytes.append_le(&mut out, 6, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 6, 2)
    bytes.append_le(&mut out, 0, 2)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, i64(size_of_image), 4)
    bytes.append_le(&mut out, i64(headers_size), 4)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, i64(subsys), 2)
    bytes.append_le(&mut out, dll_chars, 2)
    bytes.append_le(&mut out, 0x100000, 8)
    bytes.append_le(&mut out, 0x1000, 8)
    bytes.append_le(&mut out, 0x100000, 8)
    bytes.append_le(&mut out, 0x1000, 8)
    bytes.append_le(&mut out, 0, 4)
    bytes.append_le(&mut out, 16, 4)

    for dir in 0..16 {
        if dir == 1 && imp.import_dir_size > 0 {
            bytes.append_le(&mut out, i64(rdata_rva + imp.import_dir_rel), 4)
            bytes.append_le(&mut out, i64(imp.import_dir_size), 4)
        } else if dir == 2 && has_rsrc {
            bytes.append_le(&mut out, i64(rsrc_rva), 4)
            bytes.append_le(&mut out, i64(rsrc.len), 4)
        } else if dir == 3 && has_pdata {
            bytes.append_le(&mut out, i64(pdata_rva), 4)
            bytes.append_le(&mut out, i64(pdata_rf_size), 4)
        } else if dir == 5 && has_reloc {
            bytes.append_le(&mut out, i64(reloc_rva), 4)
            bytes.append_le(&mut out, i64(reloc.len), 4)
        } else if dir == 12 && imp.iat_size > 0 {
            bytes.append_le(&mut out, i64(rdata_rva), 4)
            bytes.append_le(&mut out, i64(imp.iat_size), 4)
        } else if dir == 13 && imp.delay_dir_size > 0 {
            bytes.append_le(&mut out, i64(rdata_rva + imp.delay_dir_rel), 4)
            bytes.append_le(&mut out, i64(imp.delay_dir_size), 4)
        } else {
            bytes.append_le(&mut out, 0, 8)
        }
    }

    append_section_header(&mut out, ".text", text.len, text_rva, text_raw_size, text_raw_off, i64(0x60000020))
    if has_rdata {
        append_section_header(&mut out, ".rdata", imp.rdata.len, rdata_rva, rdata_raw_size, rdata_raw_off, i64(0x40000040))
    }
    if has_data {
        append_section_header(&mut out, ".data", data_vsize, data_rva, data_raw_size, data_raw_off, i64(0xC0000040))
    }
    if has_pdata {
        append_section_header(&mut out, ".pdata", pdata.len, pdata_rva, pdata_raw_size, pdata_raw_off, i64(0x40000040))
    }
    if has_rsrc {
        append_section_header(&mut out, ".rsrc", rsrc.len, rsrc_rva, rsrc_raw_size, rsrc_raw_off, i64(0x40000040))
    }
    if has_reloc {
        append_section_header(&mut out, ".reloc", reloc.len, reloc_rva, reloc_raw_size, reloc_raw_off, i64(0x42000040))
    }
    assert(out.len <= headers_size)
    bytes.pad(&mut out, headers_size - out.len)

    bytes.extend(&mut out, &patched_text)
    bytes.pad(&mut out, text_raw_size - patched_text.len)
    if has_rdata {
        bytes.extend(&mut out, &imp.rdata)
        bytes.pad(&mut out, rdata_raw_size - imp.rdata.len)
    }
    if has_data {
        bytes.pad(&mut out, data_raw_size)
    }
    if has_pdata {
        bytes.extend(&mut out, &pdata)
        bytes.pad(&mut out, pdata_raw_size - pdata.len)
    }
    if has_rsrc {
        bytes.extend(&mut out, &rsrc)
        bytes.pad(&mut out, rsrc_raw_size - rsrc.len)
    }
    if has_reloc {
        bytes.extend(&mut out, &reloc)
        bytes.pad(&mut out, reloc_raw_size - reloc.len)
    }
    out
}

pub fn image(text: &[]u8, libraries: &[]string, symbols: &[]string, sites: &[]i32, slots: &[]i32, globals: i32) -> []u8 {
    specs := imports.from_legacy(&libraries, &symbols, -1)
    cfg := default_config()
    image_configured(&text, &specs, &sites, &slots, globals, &cfg)
}

fn read_le16(raw: &[]u8, offset: i32) -> i32 {
    i32(raw[offset]) + i32(raw[offset + 1]) * 256
}

fn read_le32(raw: &[]u8, offset: i32) -> i64 {
    mut val: i64 = 0
    for i in 0..4 {
        val += i64(raw[offset + i]).shl(i * 8)
    }
    val
}

@test fn emits_valid_pe32_plus_with_grouped_imports_and_patched_relocs() {
    mut code: []u8 = [
        u8(0xff), u8(0x15), u8(0), u8(0), u8(0), u8(0),
        u8(0x48), u8(0x8b), u8(0x05), u8(0), u8(0), u8(0), u8(0),
        u8(0xff), u8(0x15), u8(0), u8(0), u8(0), u8(0),
        u8(0x48), u8(0x8d), u8(0x05), u8(0), u8(0), u8(0), u8(0),
    ]
    libs: []string = ["kernel32", "c", "KERNEL32.DLL"]
    syms: []string = ["VirtualAlloc", "puts", "ExitProcess"]
    sites: []i32 = [2, 9, 15, 22]
    slots: []i32 = [0, 1, 2, -9]
    img := image(&code, &libs, &syms, &sites, &slots, 32)
    assert(img[0] == u8(0x4d) && img[1] == u8(0x5a))
    lfanew := i32(read_le32(&img, 60))
    assert(lfanew == 128)
    assert(img[lfanew] == u8(0x50) && img[lfanew + 1] == u8(0x45))
    assert(read_le16(&img, lfanew + 4) == 0x8664)
    assert(read_le16(&img, lfanew + 6) == 3)
    assert(read_le16(&img, lfanew + 24) == 0x020B)
    assert(read_le32(&img, lfanew + 24 + 16) == 0x1000)
    assert(read_le32(&img, lfanew + 24 + 60) == 0x200)
    assert(read_le16(&img, lfanew + 24 + 68) == 3)

    imp_dir_rva := i32(read_le32(&img, lfanew + 24 + 120))
    iat_rva := i32(read_le32(&img, lfanew + 24 + 208))
    assert(iat_rva == 0x2000)
    assert(imp_dir_rva > iat_rva)

    disp0 := i32(read_le32(&img, 0x200 + 2))
    assert(0x1000 + 6 + disp0 == 0x2000)
    disp1 := i32(read_le32(&img, 0x200 + 9))
    assert(0x1000 + 13 + disp1 == 0x2000 + 24)
    disp2 := i32(read_le32(&img, 0x200 + 15))
    assert(0x1000 + 19 + disp2 == 0x2000 + 8)
    disp3 := i32(read_le32(&img, 0x200 + 22))
    assert(0x1000 + 26 + disp3 == 0x3000 + 8)
}
