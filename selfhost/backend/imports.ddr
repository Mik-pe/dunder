pub enum LibcAbi { Glibc, Musl }

pub enum SymbolKind { Function, DataObject }

pub struct LibraryOverride {
    key: string,
    path: string,
    framework: string,
    soname: string,
    dll: string,
    weak: bool,
    delay: bool,
}

pub struct ResolvedLibrary {
    name: string,
    weak: bool,
    delay: bool,
    is_framework: bool,
}

pub struct SymbolSpec {
    library: string,
    name: string,
    kind: SymbolKind,
    weak: bool,
    delay: bool,
    lib_weak: bool,
    ordinal: i32,
    version_lib: string,
    version_name: string,
}

pub struct Table { names: []string, ordinals: []i32 }

pub struct LibraryTable {
    names: []string,
    weak: []bool,
    delay: []bool,
    ordinals: []i32,
}

pub fn symbol_spec(library: string, name: string) -> SymbolSpec {
    SymbolSpec {
        library: library.clone(),
        name: name.clone(),
        kind: .Function,
        weak: false,
        delay: false,
        lib_weak: false,
        ordinal: 0,
        version_lib: "",
        version_name: "",
    }
}

pub fn data_symbol_spec(library: string, name: string) -> SymbolSpec {
    SymbolSpec {
        library: library.clone(),
        name: name.clone(),
        kind: .DataObject,
        weak: false,
        delay: false,
        lib_weak: false,
        ordinal: 0,
        version_lib: "",
        version_name: "",
    }
}

pub fn from_legacy(libraries: &[]string, symbols: &[]string, environ_slot: i32) -> []SymbolSpec {
    assert(libraries.len == symbols.len)
    mut specs: []SymbolSpec = []
    specs.reserve(symbols.len)
    for i in 0..symbols.len {
        mut spec := symbol_spec(libraries[i].clone(), symbols[i].clone())
        if i == environ_slot { spec.kind = .DataObject }
        specs.push(move spec)
    }
    specs
}

fn lower_ascii(value: string) -> string {
    mut ascii := true
    mut has_upper := false
    for i in 0..value.len {
        b := value[i]
        if b >= 128 { ascii = false; break }
        if b >= 65 && b <= 90 { has_upper = true }
    }
    if !ascii || !has_upper { return value.clone() }
    lower_table := "abcdefghijklmnopqrstuvwxyz"
    mut result := ""
    for i in 0..value.len {
        b := i32(value[i])
        if b >= 65 && b <= 90 {
            idx := b - 65
            result = result + lower_table[idx..idx + 1]
        } else {
            result = result + value[i..i + 1]
        }
    }
    result
}

fn has_prefix(value: string, prefix: string) -> bool {
    if value.len < prefix.len { return false }
    for i in 0..prefix.len {
        if value[i] != prefix[i] { return false }
    }
    true
}

fn has_dot(value: string) -> bool {
    for i in 0..value.len {
        if value[i] == 46 { return true }
    }
    false
}

pub fn framework_path(name: string) -> string {
    "/System/Library/Frameworks/" + name + ".framework/Versions/A/" + name
}

fn musl_libc_name(platform: i32) -> string {
    if platform == 1 { return "libc.musl-aarch64.so.1" }
    "libc.musl-x86_64.so.1"
}

pub fn resolve_library(raw: string, platform: i32, libc: LibcAbi) -> ResolvedLibrary {
    if platform == 0 {
        if has_prefix(raw, "framework:") && raw.len > 10 {
            fw := raw[10..raw.len]
            return ResolvedLibrary { name: framework_path(fw), weak: false, delay: false, is_framework: true }
        }
        if raw == "c" || raw == "dl" || raw == "m" || raw == "pthread" || raw == "ucrt" {
            return ResolvedLibrary { name: "/usr/lib/libSystem.B.dylib", weak: false, delay: false, is_framework: false }
        }
        if raw == "objc" {
            return ResolvedLibrary { name: "/usr/lib/libobjc.A.dylib", weak: false, delay: false, is_framework: false }
        }
        if raw == "metal" { return ResolvedLibrary { name: framework_path("Metal"), weak: false, delay: false, is_framework: true } }
        if raw == "appkit" { return ResolvedLibrary { name: framework_path("AppKit"), weak: false, delay: false, is_framework: true } }
        if raw == "cocoa" { return ResolvedLibrary { name: framework_path("Cocoa"), weak: false, delay: false, is_framework: true } }
        if raw == "foundation" { return ResolvedLibrary { name: framework_path("Foundation"), weak: false, delay: false, is_framework: true } }
        if raw == "quartzcore" { return ResolvedLibrary { name: framework_path("QuartzCore"), weak: false, delay: false, is_framework: true } }
        if raw == "coregraphics" { return ResolvedLibrary { name: framework_path("CoreGraphics"), weak: false, delay: false, is_framework: true } }
        if raw == "corevideo" { return ResolvedLibrary { name: framework_path("CoreVideo"), weak: false, delay: false, is_framework: true } }
        if raw == "vulkan" { return ResolvedLibrary { name: "@rpath/libvulkan.1.dylib", weak: false, delay: false, is_framework: false } }
        return ResolvedLibrary { name: raw.clone(), weak: false, delay: false, is_framework: false }
    }
    if platform == 5 {
        key := lower_ascii(raw)
        if key == "c" || key == "msvcrt" { return ResolvedLibrary { name: "msvcrt.dll", weak: false, delay: false, is_framework: false } }
        if key == "ucrt" || key == "m" { return ResolvedLibrary { name: "ucrtbase.dll", weak: false, delay: false, is_framework: false } }
        if key == "kernel32" || key == "dl" || key == "pthread" { return ResolvedLibrary { name: "kernel32.dll", weak: false, delay: false, is_framework: false } }
        if key == "user32" { return ResolvedLibrary { name: "user32.dll", weak: false, delay: false, is_framework: false } }
        if key == "gdi32" { return ResolvedLibrary { name: "gdi32.dll", weak: false, delay: false, is_framework: false } }
        if key == "ole32" { return ResolvedLibrary { name: "ole32.dll", weak: false, delay: false, is_framework: false } }
        if key == "ws2_32" { return ResolvedLibrary { name: "ws2_32.dll", weak: false, delay: false, is_framework: false } }
        if key == "d3d12" { return ResolvedLibrary { name: "d3d12.dll", weak: false, delay: false, is_framework: false } }
        if key == "dxgi" { return ResolvedLibrary { name: "dxgi.dll", weak: false, delay: false, is_framework: false } }
        if key == "d3dcompiler" { return ResolvedLibrary { name: "d3dcompiler_47.dll", weak: false, delay: false, is_framework: false } }
        if key == "advapi32" { return ResolvedLibrary { name: "advapi32.dll", weak: false, delay: false, is_framework: false } }
        if key == "shell32" { return ResolvedLibrary { name: "shell32.dll", weak: false, delay: false, is_framework: false } }
        if key == "vulkan" { return ResolvedLibrary { name: "vulkan-1.dll", weak: false, delay: false, is_framework: false } }
        if !has_dot(key) && key.len > 0 { return ResolvedLibrary { name: key + ".dll", weak: false, delay: false, is_framework: false } }
        return ResolvedLibrary { name: key, weak: false, delay: false, is_framework: false }
    }
    // Linux (arm64-linux = 1, x86_64-linux = 2)
    if libc == .Musl {
        if raw == "c" || raw == "dl" || raw == "m" || raw == "pthread" || raw == "ucrt" {
            return ResolvedLibrary { name: musl_libc_name(platform), weak: false, delay: false, is_framework: false }
        }
    } else {
        if raw == "c" || raw == "ucrt" { return ResolvedLibrary { name: "libc.so.6", weak: false, delay: false, is_framework: false } }
        if raw == "dl" { return ResolvedLibrary { name: "libdl.so.2", weak: false, delay: false, is_framework: false } }
        if raw == "m" { return ResolvedLibrary { name: "libm.so.6", weak: false, delay: false, is_framework: false } }
        if raw == "pthread" { return ResolvedLibrary { name: "libpthread.so.0", weak: false, delay: false, is_framework: false } }
    }
    if raw == "vulkan" { return ResolvedLibrary { name: "libvulkan.so.1", weak: false, delay: false, is_framework: false } }
    if raw == "wayland-client" { return ResolvedLibrary { name: "libwayland-client.so.0", weak: false, delay: false, is_framework: false } }
    if raw == "x11" { return ResolvedLibrary { name: "libX11.so.6", weak: false, delay: false, is_framework: false } }
    if raw == "xcb" { return ResolvedLibrary { name: "libxcb.so.1", weak: false, delay: false, is_framework: false } }
    if raw == "xkbcommon" { return ResolvedLibrary { name: "libxkbcommon.so.0", weak: false, delay: false, is_framework: false } }
    ResolvedLibrary { name: raw.clone(), weak: false, delay: false, is_framework: false }
}

pub fn resolve_library_with_overrides(raw: string, platform: i32, libc: LibcAbi, overrides: &[]LibraryOverride) -> ResolvedLibrary {
    mut resolved := resolve_library(raw.clone(), platform, libc)
    for ov in &overrides {
        if ov.key == raw {
            if platform == 0 && ov.framework != "" {
                resolved.name = framework_path(ov.framework)
                resolved.is_framework = true
            } else if platform == 5 && ov.dll != "" {
                resolved.name = lower_ascii(ov.dll)
            } else if (platform == 1 || platform == 2) && ov.soname != "" {
                resolved.name = ov.soname.clone()
            } else if ov.path != "" {
                resolved.name = ov.path.clone()
            }
            if ov.weak { resolved.weak = true }
            if ov.delay { resolved.delay = true }
            break
        }
    }
    resolved
}

pub fn library_name(path: string, darwin: bool) -> string {
    platform := if darwin { 0 } else { 1 }
    resolve_library(path, platform, .Glibc).name
}

pub fn libraries(paths: &[]string, darwin: bool) -> Table {
    mut names: []string = []
    mut ordinals: []i32 = []
    if darwin { names.push("/usr/lib/libSystem.B.dylib") }
    for path in &paths {
        library := library_name(path, darwin)
        mut index := 0
        while index < names.len && names[index] != library { index = index + 1 }
        if index == names.len { names.push(move library) }
        ordinals.push(index + 1)
    }
    Table { names: names, ordinals: ordinals }
}

pub fn resolve_table(specs: &[]SymbolSpec, platform: i32, libc: LibcAbi, overrides: &[]LibraryOverride) -> LibraryTable {
    mut names: []string = []
    mut weak: []bool = []
    mut delay: []bool = []
    mut ordinals: []i32 = []
    if platform == 0 {
        names.push("/usr/lib/libSystem.B.dylib")
        weak.push(false)
        delay.push(false)
    }
    for spec in &specs {
        res := resolve_library_with_overrides(spec.library.clone(), platform, libc, &overrides)
        sym_lib_weak := res.weak || spec.lib_weak
        sym_lib_delay := res.delay || spec.delay
        mut index := 0
        while index < names.len && names[index] != res.name { index = index + 1 }
        if index == names.len {
            names.push(move res.name)
            weak.push(sym_lib_weak)
            delay.push(sym_lib_delay)
        } else {
            if !sym_lib_weak { weak[index] = false }
            if !sym_lib_delay { delay[index] = false }
        }
        ordinals.push(index + 1)
    }
    LibraryTable { names: names, weak: weak, delay: delay, ordinals: ordinals }
}

pub fn align(value: i32, alignment: i32) -> i32 {
    (value + alignment - 1) / alignment * alignment
}

pub fn set_le(output: &mut []u8, offset: i32, value: i64, width: i32) {
    assert(offset >= 0 && offset <= output.len - width)
    for i in 0..width { output[offset + i] = u8(value.shr(i * 8).bit_and(255)) }
}

pub fn relocate_at(output: &mut []u8, text: i32, text_len: i32, got: i32, globals_base: i32,
                   symbols: i32, sites: &[]i32, slots: &[]i32) {
    assert(sites.len == slots.len)
    for i in 0..sites.len {
        assert(sites[i] >= 0 && sites[i] <= text_len - 8 && sites[i] % 4 == 0)
        assert(slots[i] < symbols)
        site := text + sites[i]
        mut target := got
        if slots[i] < 0 { target = globals_base - 1 - slots[i] }
        else { target = got + slots[i] * 8 }
        pages := target / 4096 - site / 4096
        assert(pages >= 0 && pages < 1048576)
        adrp: i64 = i64(2415919120) + i64(pages % 4) * 536870912 + i64(pages / 4) * 32
        mut load: i64 = i64(4181721616) + i64(target % 4096 / 8) * 1024
        if slots[i] < 0 { load = i64(2432696848) + i64(target % 4096) * 1024 }
        set_le(&mut output, site, adrp, 4)
        set_le(&mut output, site + 4, load, 4)
    }
}

pub fn relocate(output: &mut []u8, text: i32, text_len: i32, data: i32,
                symbols: i32, sites: &[]i32, slots: &[]i32) {
    relocate_at(&mut output, text, text_len, data, data + align(symbols * 8, 16), symbols, &sites, &slots)
}
