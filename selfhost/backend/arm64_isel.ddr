            a64.imm(&mut fc.buf, a64.X0, 0)
            a64.b(&mut fc.buf, lbl_pm_done)
            a64.mark(&mut fc.buf, lbl_pm_err)
            a64.mark(&mut fc.buf, lbl_pm_done)
        } else {
