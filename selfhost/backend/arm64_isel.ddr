    }
    if (id == hb.INTRINSIC_SYS_MKDIR || id == hb.INTRINSIC_SYS_REMOVE_FILE ||
        id == hb.INTRINSIC_SYS_REMOVE_DIR || id == hb.INTRINSIC_SYS_MAKE_EXECUTABLE) && a_len >= 1 {
