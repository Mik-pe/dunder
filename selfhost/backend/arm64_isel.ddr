        a64.add_reg(&mut fc.buf, true, false, a64.X1, a64.X1, a64.X7) // new_len
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_grow)
        load_gp_into(&mut fc, out_v, a64.X4)
        if types.entries[f.vals[out_v].ty].kind == .Ref || types.entries[f.vals[out_v].ty].kind == .MutRef {
            a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false)
        }
        a64.ldp_post(&mut fc.buf, a64.X1, a64.X2, a64.SP, 16) // src_ptr, cnt
        a64.ldr(&mut fc.buf, a64.X0, a64.X4, 0, 8, false) // dst_data
        a64.ldr(&mut fc.buf, a64.X5, a64.X4, 8, 8, false) // old_len
        a64.add_reg(&mut fc.buf, true, false, a64.X0, a64.X0, a64.X5)
        a64.add_reg(&mut fc.buf, true, false, a64.X5, a64.X5, a64.X2)
        a64.str(&mut fc.buf, a64.X5, a64.X4, 8, 8) // out.len += cnt
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
        a64.mark(&mut fc.buf, lbl_be_done)
        return true
    }
    if id == hb.INTRINSIC_SYS_BYTES_APPEND_TEXT && a_len >= 2 {
        out_v := f.val_args[a_start]
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start + 1], a64.X3, a64.X7)
        lbl_ba_done := a64.label(&mut fc.buf)
        a64.cbz(&mut fc.buf, true, a64.X7, lbl_ba_done)
        a64.stp_pre(&mut fc.buf, a64.X3, a64.X7, a64.SP, -16)
        load_gp_into(&mut fc, out_v, a64.X0)
        if types.entries[f.vals[out_v].ty].kind == .Ref || types.entries[f.vals[out_v].ty].kind == .MutRef {
            a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
        }
        a64.ldr(&mut fc.buf, a64.X1, a64.X0, 8, 8, false)
        a64.add_reg(&mut fc.buf, true, false, a64.X1, a64.X1, a64.X7)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_grow)
        load_gp_into(&mut fc, out_v, a64.X4)
        if types.entries[f.vals[out_v].ty].kind == .Ref || types.entries[f.vals[out_v].ty].kind == .MutRef {
            a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false)
        }
        a64.ldp_post(&mut fc.buf, a64.X1, a64.X2, a64.SP, 16)
        a64.ldr(&mut fc.buf, a64.X0, a64.X4, 0, 8, false)
        a64.ldr(&mut fc.buf, a64.X5, a64.X4, 8, 8, false)
        a64.add_reg(&mut fc.buf, true, false, a64.X0, a64.X0, a64.X5)
        a64.add_reg(&mut fc.buf, true, false, a64.X5, a64.X5, a64.X2)
        a64.str(&mut fc.buf, a64.X5, a64.X4, 8, 8)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
        a64.mark(&mut fc.buf, lbl_ba_done)
        return true
    }
    if (id == hb.INTRINSIC_SYS_FD_WRITE || id == hb.INTRINSIC_SYS_NET_WRITE) && a_len >= 4 && tm.dest_val >= 0 {
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start + 1], a64.X4, a64.X5)
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)     // fd
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X6) // offset
        load_gp_into(&mut fc, f.val_args[a_start + 3], a64.X2) // length
        a64.add_reg(&mut fc.buf, true, false, a64.X1, a64.X4, a64.X6)
        emit_syscall(&mut fc.buf, target, 33554436, 64) // write
        if target == .Arm64Macos {
            lbl_fw_ok := a64.label(&mut fc.buf)
            a64.b_cond(&mut fc.buf, a64.CC_CC, lbl_fw_ok)
            a64.neg(&mut fc.buf, true, false, a64.X0, a64.X0)
            a64.mark(&mut fc.buf, lbl_fw_ok)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_NET_READ && a_len >= 3 && tm.dest_val >= 0 {
        out_v := f.val_args[a_start + 1]
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X7) // max_bytes
        load_gp_into(&mut fc, out_v, a64.X0)
        if types.entries[f.vals[out_v].ty].kind == .Ref || types.entries[f.vals[out_v].ty].kind == .MutRef {
            a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
        }
        a64.ldr(&mut fc.buf, a64.X1, a64.X0, 8, 8, false)
        a64.add_reg(&mut fc.buf, true, false, a64.X1, a64.X1, a64.X7)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_grow)
        load_gp_into(&mut fc, out_v, a64.X4)
        if types.entries[f.vals[out_v].ty].kind == .Ref || types.entries[f.vals[out_v].ty].kind == .MutRef {
            a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false)
        }
        a64.ldr(&mut fc.buf, a64.X1, a64.X4, 0, 8, false)
        a64.ldr(&mut fc.buf, a64.X5, a64.X4, 8, 8, false)
        a64.add_reg(&mut fc.buf, true, false, a64.X1, a64.X1, a64.X5)
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)     // fd
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X2) // max_bytes
        emit_syscall(&mut fc.buf, target, 33554435, 63) // read
        lbl_nr_done := a64.label(&mut fc.buf)
        if target == .Arm64Macos {
            lbl_nr_ok := a64.label(&mut fc.buf)
            a64.b_cond(&mut fc.buf, a64.CC_CC, lbl_nr_ok)
            a64.neg(&mut fc.buf, true, false, a64.X0, a64.X0)
            a64.b(&mut fc.buf, lbl_nr_done)
            a64.mark(&mut fc.buf, lbl_nr_ok)
        } else {
            a64.cmp_imm(&mut fc.buf, true, a64.X0, 0)
            a64.b_cond(&mut fc.buf, a64.CC_LE, lbl_nr_done)
        }
        a64.add_reg(&mut fc.buf, true, false, a64.X5, a64.X5, a64.X0)
        a64.str(&mut fc.buf, a64.X5, a64.X4, 8, 8)
        a64.mark(&mut fc.buf, lbl_nr_done)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_NET_CLOSE && a_len >= 1 && tm.dest_val >= 0 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        emit_syscall(&mut fc.buf, target, 33554438, 57) // close
        if target == .Arm64Macos {
            lbl_nc_ok := a64.label(&mut fc.buf)
            a64.b_cond(&mut fc.buf, a64.CC_CC, lbl_nc_ok)
            a64.neg(&mut fc.buf, true, false, a64.X0, a64.X0)
            a64.mark(&mut fc.buf, lbl_nc_ok)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_NET_POLL && a_len >= 3 && tm.dest_val >= 0 {
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start], a64.X0, a64.X4)
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1) // nfds
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X2) // timeout_ms
        if target == .Arm64Macos {
            emit_syscall(&mut fc.buf, target, 33554662, 73) // poll (230)
            lbl_np_ok := a64.label(&mut fc.buf)
            a64.b_cond(&mut fc.buf, a64.CC_CC, lbl_np_ok)
            a64.neg(&mut fc.buf, true, false, a64.X0, a64.X0)
            a64.mark(&mut fc.buf, lbl_np_ok)
        } else {
            // Linux ppoll(fds, nfds, ts_ptr, NULL, 8)
            a64.sub_imm(&mut fc.buf, true, false, a64.SP, a64.SP, 16)
            lbl_np_inf := a64.label(&mut fc.buf)
            lbl_np_go := a64.label(&mut fc.buf)
            a64.cmp_imm(&mut fc.buf, true, a64.X2, 0)
            a64.b_cond(&mut fc.buf, a64.CC_LT, lbl_np_inf)
            a64.imm(&mut fc.buf, a64.X10, 1000)
            a64.udiv(&mut fc.buf, true, a64.X11, a64.X2, a64.X10) // sec
            a64.msub(&mut fc.buf, true, a64.X12, a64.X11, a64.X10, a64.X2) // rem ms
            a64.imm(&mut fc.buf, a64.X13, 1000000)
            a64.mul(&mut fc.buf, true, a64.X12, a64.X12, a64.X13) // nsec
            a64.str(&mut fc.buf, a64.X11, a64.SP, 0, 8)
            a64.str(&mut fc.buf, a64.X12, a64.SP, 8, 8)
            a64.mov(&mut fc.buf, a64.X2, a64.SP)
            a64.b(&mut fc.buf, lbl_np_go)
            a64.mark(&mut fc.buf, lbl_np_inf)
            a64.imm(&mut fc.buf, a64.X2, 0)
            a64.mark(&mut fc.buf, lbl_np_go)
            a64.imm(&mut fc.buf, a64.X3, 0)
            a64.imm(&mut fc.buf, a64.X4, 8)
            emit_syscall(&mut fc.buf, target, 33554662, 73)
            a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, 16)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_NET_SET_NONBLOCKING && a_len >= 2 && tm.dest_val >= 0 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0) // fd
        a64.imm(&mut fc.buf, a64.X1, 3) // F_GETFL
        a64.imm(&mut fc.buf, a64.X2, 0)
        emit_syscall(&mut fc.buf, target, 33554524, 25) // fcntl
        a64.mov(&mut fc.buf, a64.X2, a64.X0)
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X10) // enabled
        o_nb: i64 = if target == .Arm64Macos { 4 } else { 2048 }
        a64.imm(&mut fc.buf, a64.X11, o_nb)
        lbl_nb_off := a64.label(&mut fc.buf)
        lbl_nb_set := a64.label(&mut fc.buf)
        a64.cbz(&mut fc.buf, true, a64.X10, lbl_nb_off)
        a64.orr_reg(&mut fc.buf, true, a64.X2, a64.X2, a64.X11)
        a64.b(&mut fc.buf, lbl_nb_set)
        a64.mark(&mut fc.buf, lbl_nb_off)
        a64.mvn(&mut fc.buf, true, a64.X11, a64.X11)
        a64.and_reg(&mut fc.buf, true, false, a64.X2, a64.X2, a64.X11)
        a64.mark(&mut fc.buf, lbl_nb_set)
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        a64.imm(&mut fc.buf, a64.X1, 4) // F_SETFL
        emit_syscall(&mut fc.buf, target, 33554524, 25)
        a64.imm(&mut fc.buf, a64.X0, 0)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if (id <= hb.INTRINSIC_SYS_NET_LISTEN && id >= hb.INTRINSIC_SYS_NET_SHUTDOWN_WRITE) && tm.dest_val >= 0 {
        a64.imm(&mut fc.buf, a64.X0, -45) // ENOTSUP fallback for remaining socket ops
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    false
}

fn emit_intrinsic_call(m: &mut obj.ObjectModule, hir: &hb.HirProgram, f: &ssa.SsaFunc,
    fc: &mut FnCodegen, rt: &RuntimeSyms, fn_syms: &[]i32, target: obj.TargetKind, tm: &ssa.SsaTerm) {
    types := &hir.types
    id := tm.callee
    a_start := tm.arg_start
    a_len := tm.arg_len

    // 1. print / eprint
    if id == hb.INTRINSIC_PRINT || id == hb.INTRINSIC_EPRINT {
        if a_len == 0 { return }
        av := f.val_args[a_start]
        aty := f.vals[av].ty
        ak := types.entries[aty].kind
        fd: i64 = if id == hb.INTRINSIC_EPRINT { 2 } else { 1 }
        if ak == .String {
            load_gp_into(&mut fc, av, a64.X3)
            a64.imm(&mut fc.buf, a64.X0, fd)
            a64.add_imm(&mut fc.buf, true, false, a64.X1, a64.X3, 8)
            a64.ldr(&mut fc.buf, a64.X2, a64.X3, 0, 8, false)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.print_str)
        } else if ak == .FatStr {
            load_fat_into(&mut fc, av, a64.X1, a64.X2)
            a64.imm(&mut fc.buf, a64.X0, fd)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.print_str)
        } else if ak == .Bool {
            load_gp_into(&mut fc, av, a64.X1)
            a64.imm(&mut fc.buf, a64.X0, fd)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.print_bool)
        } else if ssa.is_int_ty(&types, aty) {
            load_gp_into(&mut fc, av, a64.X1)
            a64.imm(&mut fc.buf, a64.X0, fd)
            a64.imm(&mut fc.buf, a64.X2, if ssa.is_unsigned_int_ty(&types, aty) { 1 } else { 0 })
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.print_int)
        }
        return
    }

    // 2. assert / panic / unreachable / sys.exit
    if id == hb.INTRINSIC_ASSERT {
        if a_len > 0 {
            av := f.val_args[a_start]
            rc := load_gp_val(&mut fc, av, a64.X0)
            a64.cbz(&mut fc.buf, true, rc, fc.trap_104)
        }
        return
    }
    if id == hb.INTRINSIC_PANIC {
        a64.b(&mut fc.buf, fc.trap_105)
        return
    }
    if id == hb.INTRINSIC_UNREACHABLE {
        a64.b(&mut fc.buf, fc.trap_106)
        return
    }
    if id == hb.INTRINSIC_SYS_EXIT {
        if a_len > 0 { load_gp_into(&mut fc, f.val_args[a_start], a64.X0) }
        else { a64.imm(&mut fc.buf, a64.X0, 0) }
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)
        return
    }

    // 3. INTRINSIC_DROP
    if id == hb.INTRINSIC_DROP {
        if a_len > 0 {
            av := f.val_args[a_start]
            ty := f.vals[av].ty
            is_ref := types.entries[ty].kind == .Ref || types.entries[ty].kind == .MutRef
            inner := if is_ref { types.entries[ty].inner_a } else { ty }
            if inner >= 0 && inner < types.entries.len && types.entries[inner].dispose_fn >= 0 {
                dfid := types.entries[inner].dispose_fn
                if dfid < fn_syms.len && fn_syms[dfid] >= 0 {
                    if is_ref {
                        load_gp_into(&mut fc, av, a64.X0)
                        emit_call_sym(&mut fc.buf, &mut fc.relocs, fn_syms[dfid])
                    } else if fc.plan.locs[av].cls == .Agg {
                        emit_sub_imm_any(&mut fc.buf, a64.X0, a64.FP, i64(fc.plan.locs[av].spill_off))
                        emit_call_sym(&mut fc.buf, &mut fc.relocs, fn_syms[dfid])
                    } else if fc.plan.locs[av].cls == .Gp {
                        load_gp_into(&mut fc, av, a64.X16)
                        a64.stp_pre(&mut fc.buf, a64.X16, a64.XZR, a64.SP, -16)
                        a64.mov(&mut fc.buf, a64.X0, a64.SP)
                        emit_call_sym(&mut fc.buf, &mut fc.relocs, fn_syms[dfid])
                        a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, 16)
                    }
                }
            }
        }
        return
    }

    // 4. INTRINSIC_REPLACE(mut_ref, new_val) -> old_val
    if id == hb.INTRINSIC_REPLACE && a_len >= 2 {
        ref_v := f.val_args[a_start]
        new_v := f.val_args[a_start + 1]
        d_ty := if tm.dest_val >= 0 { f.vals[tm.dest_val].ty } else { f.vals[new_v].ty }
        cls := classify_type(&types, d_ty)
        load_gp_into(&mut fc, ref_v, a64.X4)
        if cls == .Gp {
            sz := type_size(&types, d_ty)
            w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
            emit_ldr_off(&mut fc.buf, a64.X5, a64.X4, 0, w, is_signed_int_ty(&types, d_ty))
            nv := load_gp_val(&mut fc, new_v, a64.X6)
            emit_str_off(&mut fc.buf, nv, a64.X4, 0, w)
            store_gp_val(&mut fc, tm.dest_val, a64.X5)
        } else if cls == .Fp {
            is64 := is_f64_ty(&types, d_ty)
            emit_ldr_fp_off(&mut fc.buf, is64, 16, a64.X4, 0)
            nv := load_fp_val(&mut fc, new_v, 17)
            emit_str_fp_off(&mut fc.buf, is64, nv, a64.X4, 0)
            store_fp_val(&mut fc, tm.dest_val, 16)
        } else if cls == .Fat {
            emit_ldr_off(&mut fc.buf, a64.X5, a64.X4, 0, 8, false)
            emit_ldr_off(&mut fc.buf, a64.X6, a64.X4, 8, 8, false)
            load_fat_into(&mut fc, new_v, a64.X0, a64.X1)
            emit_str_off(&mut fc.buf, a64.X0, a64.X4, 0, 8)
            emit_str_off(&mut fc.buf, a64.X1, a64.X4, 8, 8)
            store_fat_val(&mut fc, tm.dest_val, a64.X5, a64.X6)
        } else if cls == .Agg {
            sz := type_size(&types, d_ty)
            if tm.dest_val >= 0 {
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X4, sz)
            }
            load_gp_into(&mut fc, ref_v, a64.X4)
            emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[new_v].spill_off))
            emit_memcpy_size(&mut fc, &rt, a64.X4, a64.X7, sz)
        }
        return
    }

    // 5. INTRINSIC_SWAP(a_mut_ref, b_mut_ref)
    if id == hb.INTRINSIC_SWAP && a_len >= 2 {
        ra_v := f.val_args[a_start]
        rb_v := f.val_args[a_start + 1]
        a_ty := types.entries[f.vals[ra_v].ty].inner_a
        cls := classify_type(&types, a_ty)
        load_gp_into(&mut fc, ra_v, a64.X4)
        load_gp_into(&mut fc, rb_v, a64.X5)
        if cls == .Gp {
            sz := type_size(&types, a_ty)
            w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
            emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, 0, w, false)
            emit_ldr_off(&mut fc.buf, a64.X1, a64.X5, 0, w, false)
            emit_str_off(&mut fc.buf, a64.X1, a64.X4, 0, w)
            emit_str_off(&mut fc.buf, a64.X0, a64.X5, 0, w)
        } else if cls == .Fp {
            is64 := is_f64_ty(&types, a_ty)
            emit_ldr_fp_off(&mut fc.buf, is64, 16, a64.X4, 0)
            emit_ldr_fp_off(&mut fc.buf, is64, 17, a64.X5, 0)
            emit_str_fp_off(&mut fc.buf, is64, 17, a64.X4, 0)
            emit_str_fp_off(&mut fc.buf, is64, 16, a64.X5, 0)
        } else {
            sz := type_size(&types, a_ty)
            mut off := 0
            while off + 8 <= sz {
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(off), 8, false)
                emit_ldr_off(&mut fc.buf, a64.X1, a64.X5, i64(off), 8, false)
                emit_str_off(&mut fc.buf, a64.X1, a64.X4, i64(off), 8)
                emit_str_off(&mut fc.buf, a64.X0, a64.X5, i64(off), 8)
                off += 8
            }
            while off < sz {
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(off), 1, false)
                emit_ldr_off(&mut fc.buf, a64.X1, a64.X5, i64(off), 1, false)
                emit_str_off(&mut fc.buf, a64.X1, a64.X4, i64(off), 1)
                emit_str_off(&mut fc.buf, a64.X0, a64.X5, i64(off), 1)
                off += 1
            }
        }
        return
    }

    // 6. Array intrinsics (push, pop, clear, reserve, try_reserve, truncate, remove, swap, cap)
    if (id >= hb.INTRINSIC_ARR_SWAP && id <= hb.INTRINSIC_ARR_PUSH || id == hb.INTRINSIC_CAP) && a_len >= 1 {
        av := f.val_args[a_start]
        mut aty := f.vals[av].ty
        load_gp_into(&mut fc, av, a64.X4)
        if types.entries[aty].kind == .Ref || types.entries[aty].kind == .MutRef {
            aty = types.entries[aty].inner_a
            if types.entries[aty].kind == .Array {
                a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false) // x4 = arr_hdr
            }
        }
        elem_ty := types.entries[aty].inner_a
        elem_cls := classify_type(&types, elem_ty)
        elem_sz := type_size(&types, elem_ty)
        elem_al := type_align(&types, elem_ty)
        stride := align_up_i32(elem_sz, elem_al)

        if id == hb.INTRINSIC_CAP {
            a64.ldr(&mut fc.buf, a64.X0, a64.X4, 16, 8, false)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
            return
        }
        if id == hb.INTRINSIC_ARR_CLEAR {
            a64.str(&mut fc.buf, a64.XZR, a64.X4, 8, 8)
            return
        }
        if id == hb.INTRINSIC_ARR_RESERVE && a_len >= 2 {
            a64.mov(&mut fc.buf, a64.X0, a64.X4)
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_grow)
            return
        }
        if id == hb.INTRINSIC_ARR_TRY_RESERVE && a_len >= 2 {
            a64.mov(&mut fc.buf, a64.X0, a64.X4)
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_grow)
            if tm.dest_val >= 0 {
                a64.imm(&mut fc.buf, a64.X0, 0)
                store_gp_val(&mut fc, tm.dest_val, a64.X0)
            }
            return
        }
        if id == hb.INTRINSIC_ARR_TRUNCATE && a_len >= 2 {
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X5)
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, 8, 8, false)
            a64.cmp_reg(&mut fc.buf, true, a64.X5, a64.X6)
            lbl_ok := a64.label(&mut fc.buf)
            a64.b_cond(&mut fc.buf, a64.CC_HS, lbl_ok)
            a64.str(&mut fc.buf, a64.X5, a64.X4, 8, 8)
            a64.mark(&mut fc.buf, lbl_ok)
            return
        }
        if id == hb.INTRINSIC_ARR_PUSH && a_len >= 2 {
            // Grow if len + 1 > cap
            a64.ldr(&mut fc.buf, a64.X1, a64.X4, 8, 8, false)
            a64.add_imm(&mut fc.buf, true, false, a64.X1, a64.X1, 1)
            a64.mov(&mut fc.buf, a64.X0, a64.X4)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_grow)
            // Reload arr_hdr cleanly
            load_gp_into(&mut fc, av, a64.X4)
            if types.entries[f.vals[av].ty].kind == .Ref || types.entries[f.vals[av].ty].kind == .MutRef {
                a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false)
            }
            a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 8, false) // data_ptr
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, 8, 8, false) // len
            a64.imm(&mut fc.buf, a64.X16, i64(stride))
            a64.madd(&mut fc.buf, true, a64.X5, a64.X6, a64.X16, a64.X5) // &data[len]
            a64.add_imm(&mut fc.buf, true, false, a64.X6, a64.X6, 1)
            a64.str(&mut fc.buf, a64.X6, a64.X4, 8, 8) // len += 1
            vv := f.val_args[a_start + 1]
            if elem_cls == .Gp {
                w := if elem_sz == 1 || elem_sz == 2 || elem_sz == 4 || elem_sz == 8 { elem_sz } else { 8 }
                rv := load_gp_val(&mut fc, vv, a64.X0)
                emit_str_off(&mut fc.buf, rv, a64.X5, 0, w)
            } else if elem_cls == .Fp {
                vf := load_fp_val(&mut fc, vv, 16)
                emit_str_fp_off(&mut fc.buf, is_f64_ty(&types, elem_ty), vf, a64.X5, 0)
            } else if elem_cls == .Fat {
                load_fat_into(&mut fc, vv, a64.X0, a64.X1)
                emit_str_off(&mut fc.buf, a64.X0, a64.X5, 0, 8)
                emit_str_off(&mut fc.buf, a64.X1, a64.X5, 8, 8)
            } else if elem_cls == .Agg {
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[vv].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X5, a64.X7, elem_sz)
            }
            return
        }
        if id == hb.INTRINSIC_ARR_POP {
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, 8, 8, false)
            a64.cbz(&mut fc.buf, true, a64.X6, fc.trap_103)
            a64.sub_imm(&mut fc.buf, true, false, a64.X6, a64.X6, 1)
            a64.str(&mut fc.buf, a64.X6, a64.X4, 8, 8)
            a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 8, false)
            a64.imm(&mut fc.buf, a64.X16, i64(stride))
            a64.madd(&mut fc.buf, true, a64.X5, a64.X6, a64.X16, a64.X5)
            if tm.dest_val >= 0 {
                if elem_cls == .Gp {
                    w := if elem_sz == 1 || elem_sz == 2 || elem_sz == 4 || elem_sz == 8 { elem_sz } else { 8 }
                    emit_ldr_off(&mut fc.buf, a64.X0, a64.X5, 0, w, is_signed_int_ty(&types, elem_ty))
                    store_gp_val(&mut fc, tm.dest_val, a64.X0)
                } else if elem_cls == .Fp {
                    emit_ldr_fp_off(&mut fc.buf, is_f64_ty(&types, elem_ty), 16, a64.X5, 0)
                    store_fp_val(&mut fc, tm.dest_val, 16)
                } else if elem_cls == .Fat {
                    emit_ldr_off(&mut fc.buf, a64.X0, a64.X5, 0, 8, false)
                    emit_ldr_off(&mut fc.buf, a64.X1, a64.X5, 8, 8, false)
                    store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
                } else if elem_cls == .Agg {
                    emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                    emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X5, elem_sz)
                }
            }
            return
        }
        if id == hb.INTRINSIC_ARR_SWAP && a_len >= 3 {
            // arr.swap(i, j): bounds check both, swap elem_sz bytes
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, 8, 8, false) // len
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X2) // i
            load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X3) // j
            a64.cmp_reg(&mut fc.buf, true, a64.X2, a64.X6)
            a64.b_cond(&mut fc.buf, a64.CC_HS, fc.trap_103)
            a64.cmp_reg(&mut fc.buf, true, a64.X3, a64.X6)
            a64.b_cond(&mut fc.buf, a64.CC_HS, fc.trap_103)
            a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 8, false) // data_ptr
            a64.imm(&mut fc.buf, a64.X16, i64(stride))
            a64.madd(&mut fc.buf, true, a64.X4, a64.X2, a64.X16, a64.X5) // &data[i]
            a64.madd(&mut fc.buf, true, a64.X5, a64.X3, a64.X16, a64.X5) // &data[j]
            mut off := 0
            while off + 8 <= elem_sz {
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(off), 8, false)
                emit_ldr_off(&mut fc.buf, a64.X1, a64.X5, i64(off), 8, false)
                emit_str_off(&mut fc.buf, a64.X1, a64.X4, i64(off), 8)
                emit_str_off(&mut fc.buf, a64.X0, a64.X5, i64(off), 8)
                off += 8
            }
            while off < elem_sz {
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(off), 1, false)
                emit_ldr_off(&mut fc.buf, a64.X1, a64.X5, i64(off), 1, false)
                emit_str_off(&mut fc.buf, a64.X1, a64.X4, i64(off), 1)
                emit_str_off(&mut fc.buf, a64.X0, a64.X5, i64(off), 1)
                off += 1
            }
            return
        }
        if id == hb.INTRINSIC_ARR_REMOVE && a_len >= 2 {
            // arr.remove(idx) -> elem
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, 8, 8, false) // len
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X3) // idx
            a64.cmp_reg(&mut fc.buf, true, a64.X3, a64.X6)
            a64.b_cond(&mut fc.buf, a64.CC_HS, fc.trap_103)
            a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 8, false) // data_ptr
            a64.imm(&mut fc.buf, a64.X16, i64(stride))
            a64.madd(&mut fc.buf, true, a64.X5, a64.X3, a64.X16, a64.X5) // &data[idx]
            if tm.dest_val >= 0 {
                if elem_cls == .Gp {
                    w := if elem_sz == 1 || elem_sz == 2 || elem_sz == 4 || elem_sz == 8 { elem_sz } else { 8 }
                    emit_ldr_off(&mut fc.buf, a64.X0, a64.X5, 0, w, is_signed_int_ty(&types, elem_ty))
                    store_gp_val(&mut fc, tm.dest_val, a64.X0)
                } else if elem_cls == .Fp {
                    emit_ldr_fp_off(&mut fc.buf, is_f64_ty(&types, elem_ty), 16, a64.X5, 0)
                    store_fp_val(&mut fc, tm.dest_val, 16)
                } else if elem_cls == .Fat {
                    emit_ldr_off(&mut fc.buf, a64.X0, a64.X5, 0, 8, false)
                    emit_ldr_off(&mut fc.buf, a64.X1, a64.X5, 8, 8, false)
                    store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
                } else if elem_cls == .Agg {
                    emit_sub_imm_any(&mut fc.buf, a64.X0, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                    emit_memcpy_size(&mut fc, &rt, a64.X0, a64.X5, elem_sz)
                    // Reload hdr, len, idx, &data[idx] cleanly after potential memcpy call
                    load_gp_into(&mut fc, av, a64.X4)
                    if types.entries[f.vals[av].ty].kind == .Ref || types.entries[f.vals[av].ty].kind == .MutRef {
                        a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false)
                    }
                    a64.ldr(&mut fc.buf, a64.X6, a64.X4, 8, 8, false)
                    load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X3)
                    a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 8, false)
                    a64.imm(&mut fc.buf, a64.X16, i64(stride))
                    a64.madd(&mut fc.buf, true, a64.X5, a64.X3, a64.X16, a64.X5)
                }
            }
            // Shift tail left: dst = &data[idx], src = &data[idx+1], bytes = (len - idx - 1) * stride
            a64.sub_imm(&mut fc.buf, true, false, a64.X6, a64.X6, 1)
            a64.str(&mut fc.buf, a64.X6, a64.X4, 8, 8) // len -= 1
            a64.sub_reg(&mut fc.buf, true, false, a64.X2, a64.X6, a64.X3) // tail_count
            lbl_rm_done := a64.label(&mut fc.buf)
            a64.cbz(&mut fc.buf, true, a64.X2, lbl_rm_done)
            a64.imm(&mut fc.buf, a64.X16, i64(stride))
            a64.mul(&mut fc.buf, true, a64.X2, a64.X2, a64.X16) // bytes to shift
            a64.mov(&mut fc.buf, a64.X0, a64.X5) // dst
            a64.add_reg(&mut fc.buf, true, false, a64.X1, a64.X5, a64.X16) // src
            // Forward byte copy loop (safe for dst < src overlap!)
            lbl_rm_loop := a64.label(&mut fc.buf)
            a64.mark(&mut fc.buf, lbl_rm_loop)
            a64.ldr(&mut fc.buf, a64.X16, a64.X1, 0, 1, false)
            a64.str(&mut fc.buf, a64.X16, a64.X0, 0, 1)
            a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X0, 1)
            a64.add_imm(&mut fc.buf, true, false, a64.X1, a64.X1, 1)
            a64.sub_imm(&mut fc.buf, true, false, a64.X2, a64.X2, 1)
            a64.cbnz(&mut fc.buf, true, a64.X2, lbl_rm_loop)
            a64.mark(&mut fc.buf, lbl_rm_done)
            return
        }
        return
    }

    // 7. Option / Result intrinsics
    if (id >= hb.INTRINSIC_OPT_IS_SOME && id <= hb.INTRINSIC_RES_ERR || id >= hb.INTRINSIC_RES_ERR && id <= hb.INTRINSIC_OPT_IS_SOME) && a_len >= 1 {
        av := f.val_args[a_start]
        mut ety := f.vals[av].ty
        // Get address of enum in x4 (if Ref/MutRef, load ptr; if Agg, compute home; if Gp, it's the tag directly)
        mut tag_in_reg := false
        if types.entries[ety].kind == .Ref || types.entries[ety].kind == .MutRef {
            ety = types.entries[ety].inner_a
            load_gp_into(&mut fc, av, a64.X4)
        } else if fc.plan.locs[av].cls == .Agg {
            emit_sub_imm_any(&mut fc.buf, a64.X4, a64.FP, i64(fc.plan.locs[av].spill_off))
        } else {
            load_gp_into(&mut fc, av, a64.X5)
            tag_in_reg = true
        }
        if !tag_in_reg {
            a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 4, true)
        }
        if id == hb.INTRINSIC_OPT_IS_SOME || id == hb.INTRINSIC_RES_IS_OK {
            a64.cmp_imm(&mut fc.buf, true, a64.X5, 0)
            a64.cset(&mut fc.buf, a64.X0, a64.CC_EQ)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
            return
        }
        if id == hb.INTRINSIC_OPT_IS_NONE || id == hb.INTRINSIC_RES_IS_ERR {
            a64.cmp_imm(&mut fc.buf, true, a64.X5, 0)
            a64.cset(&mut fc.buf, a64.X0, a64.CC_NE)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
            return
        }
        if id == hb.INTRINSIC_UNWRAP || id == hb.INTRINSIC_UNWRAP_ERR {
            want: i64 = if id == hb.INTRINSIC_UNWRAP { 0 } else { 1 }
            a64.cmp_imm(&mut fc.buf, true, a64.X5, want)
            a64.b_cond(&mut fc.buf, a64.CC_NE, fc.trap_105)
            if tm.dest_val >= 0 {
                d_ty := f.vals[tm.dest_val].ty
                d_cls := fc.plan.locs[tm.dest_val].cls
                poff := enum_payload_offset(&types, ety, i32(want), 0)
                if d_cls == .Gp {
                    sz := type_size(&types, d_ty)
                    w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
                    emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(poff), w, is_signed_int_ty(&types, d_ty))
                    store_gp_val(&mut fc, tm.dest_val, a64.X0)
                } else if d_cls == .Fp {
                    emit_ldr_fp_off(&mut fc.buf, is_f64_ty(&types, d_ty), 16, a64.X4, i64(poff))
                    store_fp_val(&mut fc, tm.dest_val, 16)
                } else if d_cls == .Fat {
                    emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(poff), 8, false)
                    emit_ldr_off(&mut fc.buf, a64.X1, a64.X4, i64(poff + 8), 8, false)
                    store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
                } else if d_cls == .Agg {
                    emit_add_imm_any(&mut fc.buf, a64.X7, a64.X4, i64(poff))
                    emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                    emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, d_ty))
                }
            }
            return
        }
        if id == hb.INTRINSIC_UNWRAP_OR && a_len >= 2 && tm.dest_val >= 0 {
            lbl_def := a64.label(&mut fc.buf)
            lbl_done := a64.label(&mut fc.buf)
            a64.cbnz(&mut fc.buf, true, a64.X5, lbl_def)
            d_ty := f.vals[tm.dest_val].ty
            d_cls := fc.plan.locs[tm.dest_val].cls
            poff := enum_payload_offset(&types, ety, 0, 0)
            def_v := f.val_args[a_start + 1]
            if d_cls == .Gp {
                sz := type_size(&types, d_ty)
                w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(poff), w, is_signed_int_ty(&types, d_ty))
                store_gp_val(&mut fc, tm.dest_val, a64.X0)
                a64.b(&mut fc.buf, lbl_done)
                a64.mark(&mut fc.buf, lbl_def)
                load_gp_into(&mut fc, def_v, a64.X0)
                store_gp_val(&mut fc, tm.dest_val, a64.X0)
            } else if d_cls == .Fp {
                emit_ldr_fp_off(&mut fc.buf, is_f64_ty(&types, d_ty), 16, a64.X4, i64(poff))
                store_fp_val(&mut fc, tm.dest_val, 16)
                a64.b(&mut fc.buf, lbl_done)
                a64.mark(&mut fc.buf, lbl_def)
                load_fp_into(&mut fc, def_v, 16)
                store_fp_val(&mut fc, tm.dest_val, 16)
            } else if d_cls == .Fat {
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, i64(poff), 8, false)
                emit_ldr_off(&mut fc.buf, a64.X1, a64.X4, i64(poff + 8), 8, false)
                store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
                a64.b(&mut fc.buf, lbl_done)
                a64.mark(&mut fc.buf, lbl_def)
                load_fat_into(&mut fc, def_v, a64.X0, a64.X1)
                store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
            } else if d_cls == .Agg {
                emit_add_imm_any(&mut fc.buf, a64.X7, a64.X4, i64(poff))
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, d_ty))
                a64.b(&mut fc.buf, lbl_done)
                a64.mark(&mut fc.buf, lbl_def)
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[def_v].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, d_ty))
            }
            a64.mark(&mut fc.buf, lbl_done)
            return
        }
    }

    // 8. INTRINSIC_TO_STR
    if id == hb.INTRINSIC_TO_STR && a_len >= 1 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        aty := f.vals[av].ty
        ak := types.entries[aty].kind
        if ssa.is_int_ty(&types, aty) {
            load_gp_into(&mut fc, av, a64.X0)
            a64.imm(&mut fc.buf, a64.X1, if ssa.is_unsigned_int_ty(&types, aty) { 1 } else { 0 })
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.int_to_str)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if ak == .String {
            load_gp_into(&mut fc, av, a64.X0)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if ak == .FatStr {
            // Allocate String from FatStr (ptr, len)
            load_fat_into(&mut fc, av, a64.X4, a64.X5)
            a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X5, 17)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
            a64.imm(&mut fc.buf, a64.X16, 1)
            a64.str(&mut fc.buf, a64.X16, a64.X0, 0, 8)
            a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X0, 8)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
            load_fat_into(&mut fc, av, a64.X1, a64.X2)
            a64.str(&mut fc.buf, a64.X2, a64.X0, 0, 8)
            a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X0, 8)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
        } else if ak == .Bool {
            fc.ro_counter += 1
            st_t := append_rodata_dunder_str(&mut m, "__str_t_" + f.fn_id.str() + "_" + fc.ro_counter.str(), "true")
            st_f := append_rodata_dunder_str(&mut m, "__str_f_" + f.fn_id.str() + "_" + fc.ro_counter.str(), "false")
            lbl_f := a64.label(&mut fc.buf)
            lbl_d := a64.label(&mut fc.buf)
            rc := load_gp_val(&mut fc, av, a64.X1)
            a64.cbz(&mut fc.buf, true, rc, lbl_f)
            emit_adrp_sym(&mut fc.buf, &mut fc.relocs, a64.X0, st_t, 0)
            a64.b(&mut fc.buf, lbl_d)
            a64.mark(&mut fc.buf, lbl_f)
            emit_adrp_sym(&mut fc.buf, &mut fc.relocs, a64.X0, st_f, 0)
            a64.mark(&mut fc.buf, lbl_d)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if ak == .Rune {
            load_gp_into(&mut fc, av, a64.X0)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.rune_to_str)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if ak == .F32 || ak == .F64 {
            load_fp_into(&mut fc, av, 0)
            if ak == .F32 { a64.fcvt_f32_to_f64(&mut fc.buf, 0, 0) }
            a64.imm(&mut fc.buf, a64.X0, 6)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.fmt_fixed)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        }
        return
    }

    // 9. INTRINSIC_CLONE
    if id == hb.INTRINSIC_CLONE && a_len >= 1 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        d_ty := f.vals[tm.dest_val].ty
        d_cls := fc.plan.locs[tm.dest_val].cls
        aty := f.vals[av].ty
        is_ref := types.entries[aty].kind == .Ref || types.entries[aty].kind == .MutRef
        if d_cls == .Gp {
            load_gp_into(&mut fc, av, a64.X0)
            if is_ref {
                sz := type_size(&types, d_ty)
                w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X0, 0, w, is_signed_int_ty(&types, d_ty))
            }
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if d_cls == .Fp {
            if is_ref {
                load_gp_into(&mut fc, av, a64.X0)
                emit_ldr_fp_off(&mut fc.buf, is_f64_ty(&types, d_ty), 16, a64.X0, 0)
            } else {
                load_fp_into(&mut fc, av, 16)
            }
            store_fp_val(&mut fc, tm.dest_val, 16)
        } else if d_cls == .Fat {
            if is_ref {
                load_gp_into(&mut fc, av, a64.X2)
                emit_ldr_off(&mut fc.buf, a64.X0, a64.X2, 0, 8, false)
                emit_ldr_off(&mut fc.buf, a64.X1, a64.X2, 8, 8, false)
            } else {
                load_fat_into(&mut fc, av, a64.X0, a64.X1)
            }
            store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
        } else if d_cls == .Agg {
            sz := type_size(&types, d_ty)
            emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
            if is_ref {
                load_gp_into(&mut fc, av, a64.X7)
            } else {
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[av].spill_off))
            }
            emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
        }
        return
    }

    // 10. Integer bit/wrapping/math intrinsics
    if a_len >= 1 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        d_ty := f.vals[tm.dest_val].ty
        if id == hb.INTRINSIC_INT_BIT_NOT {
            ra := load_gp_val(&mut fc, av, a64.X0)
            a64.mvn(&mut fc.buf, true, a64.X1, ra)
            emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X1, a64.X1)
            store_gp_val(&mut fc, tm.dest_val, a64.X1)
            return
        }
        if id == hb.INTRINSIC_INT_CLZ {
            ra := load_gp_val(&mut fc, av, a64.X0)
            a64.clz(&mut fc.buf, type_size(&types, f.vals[av].ty) == 8, a64.X1, ra)
            store_gp_val(&mut fc, tm.dest_val, a64.X1)
            return
        }
        if id == hb.INTRINSIC_INT_REV_BITS {
            ra := load_gp_val(&mut fc, av, a64.X0)
            a64.rbit(&mut fc.buf, type_size(&types, f.vals[av].ty) == 8, a64.X1, ra)
            store_gp_val(&mut fc, tm.dest_val, a64.X1)
            return
        }
        if id == hb.INTRINSIC_INT_CTZ {
            ra := load_gp_val(&mut fc, av, a64.X0)
            w64 := type_size(&types, f.vals[av].ty) == 8
            a64.rbit(&mut fc.buf, w64, a64.X1, ra)
            a64.clz(&mut fc.buf, w64, a64.X1, a64.X1)
            store_gp_val(&mut fc, tm.dest_val, a64.X1)
            return
        }
        if id == hb.INTRINSIC_INT_SWAP_BYTES {
            ra := load_gp_val(&mut fc, av, a64.X0)
            sz := type_size(&types, f.vals[av].ty)
            if sz == 8 { a64.rev(&mut fc.buf, true, a64.X1, ra) }
            else if sz == 4 { a64.rev(&mut fc.buf, false, a64.X1, ra) }
            else if sz == 2 { a64.rev16(&mut fc.buf, false, a64.X1, ra); a64.uxth(&mut fc.buf, a64.X1, a64.X1) }
            else { a64.mov(&mut fc.buf, a64.X1, ra) }
            emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X1, a64.X1)
            store_gp_val(&mut fc, tm.dest_val, a64.X1)
            return
        }
        if id == hb.INTRINSIC_INT_POPCNT || id == hb.INTRINSIC_INT_COUNT_ZEROS {
            load_gp_into(&mut fc, av, a64.X0)
            sz := type_size(&types, f.vals[av].ty)
            if sz == 1 { a64.uxtb(&mut fc.buf, a64.X0, a64.X0) }
            else if sz == 2 { a64.uxth(&mut fc.buf, a64.X0, a64.X0) }
            else if sz == 4 { a64.mov32(&mut fc.buf, a64.X0, a64.X0) }
            a64.imm(&mut fc.buf, a64.X1, 0)
            lbl_pc_l := a64.label(&mut fc.buf)
            lbl_pc_d := a64.label(&mut fc.buf)
            a64.mark(&mut fc.buf, lbl_pc_l)
            a64.cbz(&mut fc.buf, true, a64.X0, lbl_pc_d)
            a64.sub_imm(&mut fc.buf, true, false, a64.X2, a64.X0, 1)
            a64.and_reg(&mut fc.buf, true, false, a64.X0, a64.X0, a64.X2)
            a64.add_imm(&mut fc.buf, true, false, a64.X1, a64.X1, 1)
            a64.b(&mut fc.buf, lbl_pc_l)
            a64.mark(&mut fc.buf, lbl_pc_d)
            if id == hb.INTRINSIC_INT_COUNT_ZEROS {
                a64.imm(&mut fc.buf, a64.X2, i64(sz * 8))
                a64.sub_reg(&mut fc.buf, true, false, a64.X1, a64.X2, a64.X1)
            }
            store_gp_val(&mut fc, tm.dest_val, a64.X1)
            return
        }
        if id == hb.INTRINSIC_FLOAT_IS_NAN || id == hb.INTRINSIC_FLOAT_IS_INFINITE ||
            id == hb.INTRINSIC_FLOAT_IS_FINITE || id == hb.INTRINSIC_FLOAT_IS_SIGN_NEG {
            is64 := is_f64_ty(&types, f.vals[av].ty)
            va := load_fp_val(&mut fc, av, 16)
            if id == hb.INTRINSIC_FLOAT_IS_NAN {
                a64.fcmp(&mut fc.buf, is64, va, va)
                a64.cset(&mut fc.buf, a64.X0, a64.CC_VS)
            } else if id == hb.INTRINSIC_FLOAT_IS_SIGN_NEG {
                a64.fmov_from_fp(&mut fc.buf, is64, a64.X0, va)
                a64.lsr_imm(&mut fc.buf, is64, a64.X0, a64.X0, if is64 { 63 } else { 31 })
            } else {
                a64.fmov_from_fp(&mut fc.buf, is64, a64.X0, va)
                if is64 {
                    a64.lsl_imm(&mut fc.buf, true, a64.X0, a64.X0, 1)
                    a64.imm(&mut fc.buf, a64.X1, -9007199254740992) // 0xffe0000000000000
                    a64.cmp_reg(&mut fc.buf, true, a64.X0, a64.X1)
                } else {
                    a64.lsl_imm(&mut fc.buf, false, a64.X0, a64.X0, 1)
                    a64.imm(&mut fc.buf, a64.X1, 0xff000000)
                    a64.cmp_reg(&mut fc.buf, false, a64.X0, a64.X1)
                }
                if id == hb.INTRINSIC_FLOAT_IS_INFINITE { a64.cset(&mut fc.buf, a64.X0, a64.CC_EQ) }
                else { a64.cset(&mut fc.buf, a64.X0, a64.CC_LO) }
            }
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
            return
        }
        if id == hb.INTRINSIC_FLOAT_FLOOR || id == hb.INTRINSIC_FLOAT_CEIL ||
            id == hb.INTRINSIC_FLOAT_ROUND || id == hb.INTRINSIC_FLOAT_ROUND_EVEN ||
            id == hb.INTRINSIC_FLOAT_TRUNC {
            is64 := is_f64_ty(&types, d_ty)
            va := load_fp_val(&mut fc, av, 16)
            if id == hb.INTRINSIC_FLOAT_FLOOR { a64.frintm(&mut fc.buf, is64, 16, va) }
            else if id == hb.INTRINSIC_FLOAT_CEIL { a64.frintp(&mut fc.buf, is64, 16, va) }
            else if id == hb.INTRINSIC_FLOAT_ROUND { a64.frinta(&mut fc.buf, is64, 16, va) }
            else if id == hb.INTRINSIC_FLOAT_ROUND_EVEN { a64.frintn(&mut fc.buf, is64, 16, va) }
            else { a64.frintz(&mut fc.buf, is64, 16, va) }
            store_fp_val(&mut fc, tm.dest_val, 16)
            return
        }
        if id == hb.INTRINSIC_MATH_ABS {
            if fc.plan.locs[tm.dest_val].cls == .Fp {
                va := load_fp_val(&mut fc, av, 16)
                a64.fabs(&mut fc.buf, is_f64_ty(&types, d_ty), 16, va)
                store_fp_val(&mut fc, tm.dest_val, 16)
            } else {
                ra := load_gp_val(&mut fc, av, a64.X0)
                a64.neg(&mut fc.buf, true, false, a64.X1, ra)
                a64.cmp_imm(&mut fc.buf, true, ra, 0)
                a64.csel(&mut fc.buf, true, a64.X2, ra, a64.X1, a64.CC_GE)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
            }
            return
        }
        if id == hb.INTRINSIC_FLOAT_SQRT {
            va := load_fp_val(&mut fc, av, 16)
            a64.fsqrt(&mut fc.buf, is_f64_ty(&types, d_ty), 16, va)
            store_fp_val(&mut fc, tm.dest_val, 16)
            return
        }
        if id == hb.INTRINSIC_FLOAT_TO_BITS {
            va := load_fp_val(&mut fc, av, 16)
            a64.fmov_from_fp(&mut fc.buf, is_f64_ty(&types, f.vals[av].ty), a64.X0, va)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
            return
        }
        if id == hb.INTRINSIC_FLOAT_FROM_BITS {
            ra := load_gp_val(&mut fc, av, a64.X0)
            a64.fmov_to_fp(&mut fc.buf, is_f64_ty(&types, d_ty), 16, ra)
            store_fp_val(&mut fc, tm.dest_val, 16)
            return
        }
        if a_len >= 2 {
            bv := f.val_args[a_start + 1]
            ra := load_gp_val(&mut fc, av, a64.X0)
            rb := load_gp_val(&mut fc, bv, a64.X1)
            is_u := ssa.is_unsigned_int_ty(&types, d_ty)
            if id == hb.INTRINSIC_INT_BIT_OR {
                a64.orr_reg(&mut fc.buf, true, a64.X2, ra, rb)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_BIT_AND {
                a64.and_reg(&mut fc.buf, true, false, a64.X2, ra, rb)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_BIT_XOR {
                a64.eor_reg(&mut fc.buf, true, a64.X2, ra, rb)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_SHL {
                a64.lsl_reg(&mut fc.buf, true, a64.X2, ra, rb)
                emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X2, a64.X2)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_SHR {
                if is_u { a64.lsr_reg(&mut fc.buf, true, a64.X2, ra, rb) }
                else { a64.asr_reg(&mut fc.buf, true, a64.X2, ra, rb) }
                emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X2, a64.X2)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_WRAPPING_ADD {
                a64.add_reg(&mut fc.buf, true, false, a64.X2, ra, rb)
                emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X2, a64.X2)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_WRAPPING_SUB {
                a64.sub_reg(&mut fc.buf, true, false, a64.X2, ra, rb)
                emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X2, a64.X2)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_WRAPPING_MUL {
                a64.mul(&mut fc.buf, true, a64.X2, ra, rb)
                emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X2, a64.X2)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_MIN || id == hb.INTRINSIC_INT_MAX {
                a64.cmp_reg(&mut fc.buf, true, ra, rb)
                cc := if id == hb.INTRINSIC_INT_MIN {
                    if is_u { a64.CC_LO } else { a64.CC_LT }
                } else {
                    if is_u { a64.CC_HI } else { a64.CC_GT }
                }
                a64.csel(&mut fc.buf, true, a64.X2, ra, rb, cc)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_ROT_L || id == hb.INTRINSIC_INT_ROT_R {
                w64 := type_size(&types, d_ty) == 8
                if id == hb.INTRINSIC_INT_ROT_R {
                    a64.ror_reg(&mut fc.buf, w64, a64.X2, ra, rb)
                } else {
                    a64.neg(&mut fc.buf, w64, false, a64.X3, rb)
                    a64.ror_reg(&mut fc.buf, w64, a64.X2, ra, a64.X3)
                }
                emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X2, a64.X2)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_CLAMP && a_len >= 3 {
                rc := load_gp_val(&mut fc, f.val_args[a_start + 2], a64.X3)
                cc_lo := if is_u { a64.CC_LO } else { a64.CC_LT }
                cc_hi := if is_u { a64.CC_HI } else { a64.CC_GT }
                a64.cmp_reg(&mut fc.buf, true, ra, rb)
                a64.csel(&mut fc.buf, true, a64.X2, rb, ra, cc_lo)
                a64.cmp_reg(&mut fc.buf, true, a64.X2, rc)
                a64.csel(&mut fc.buf, true, a64.X2, rc, a64.X2, cc_hi)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
            if id == hb.INTRINSIC_INT_SAT_ADD || id == hb.INTRINSIC_INT_SAT_SUB || id == hb.INTRINSIC_INT_SAT_MUL {
                sz := type_size(&types, d_ty)
                wide := sz == 8
                if id == hb.INTRINSIC_INT_SAT_ADD {
                    a64.add_reg(&mut fc.buf, wide, true, a64.X2, ra, rb)
                } else if id == hb.INTRINSIC_INT_SAT_SUB {
                    a64.sub_reg(&mut fc.buf, wide, true, a64.X2, ra, rb)
                } else {
                    a64.mul(&mut fc.buf, wide, a64.X2, ra, rb)
                }
                if is_u && id == hb.INTRINSIC_INT_SAT_SUB {
                    a64.csel(&mut fc.buf, true, a64.X2, a64.X2, a64.XZR, a64.CC_CS)
                } else if is_u && id == hb.INTRINSIC_INT_SAT_ADD {
                    a64.imm(&mut fc.buf, a64.X3, -1)
                    a64.csel(&mut fc.buf, true, a64.X2, a64.X3, a64.X2, a64.CC_CS)
                }
                emit_normalize_int(&mut fc.buf, &types, d_ty, a64.X2, a64.X2)
                store_gp_val(&mut fc, tm.dest_val, a64.X2)
                return
            }
        }
    }

    // 11. Compile-time info intrinsics
    if id == hb.INTRINSIC_SIZE_OF && tm.dest_val >= 0 {
        t_id := if tm.sig_ty >= 0 && tm.sig_ty < types.entries.len { tm.sig_ty } else { tm.aux_ty }
        sz := if t_id >= 0 && t_id < types.entries.len { type_size(&types, t_id) } else { 0 }
        a64.imm(&mut fc.buf, a64.X0, i64(sz))
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }
    if id == hb.INTRINSIC_ALIGN_OF && tm.dest_val >= 0 {
        t_id := if tm.sig_ty >= 0 && tm.sig_ty < types.entries.len { tm.sig_ty } else { tm.aux_ty }
        al := if t_id >= 0 && t_id < types.entries.len { type_align(&types, t_id) } else { 1 }
        a64.imm(&mut fc.buf, a64.X0, i64(al))
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }
    if id == hb.INTRINSIC_TARGET_IS && tm.dest_val >= 0 {
        mut res_t: i64 = 0
        if a_len > 0 {
            t_str := ssa_const_str_text(&f, f.val_args[a_start])
            p := obj.target_to_platform(target)
            if (t_str == "macos" && p == 0) || (t_str == "arm64-macos" && p == 0) ||
                (t_str == "arm64-linux" && p == 1) || (t_str == "x86_64-linux" && p == 2) ||
                (t_str == "wasm32-wasi" && p == 4) || (t_str == "x86_64-windows" && p == 5) ||
                (t_str == "linux" && (p == 1 || p == 2)) ||
                (t_str == "windows" && p == 5) || (t_str == "wasm" && (p == 3 || p == 4)) ||
                (t_str == "wasi" && p == 4) || (t_str == "arm64" && (p == 0 || p == 1)) ||
                (t_str == "x86_64" && (p == 2 || p == 5)) || (t_str == "wasm32" && (p == 3 || p == 4)) ||
                (t_str == "native" && p != 3 && p != 4) {
                res_t = 1
            }
        }
        a64.imm(&mut fc.buf, a64.X0, res_t)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }
    if id == hb.INTRINSIC_PTR_NULL || id == hb.INTRINSIC_PTR_NULL_MUT {
        if tm.dest_val >= 0 {
            a64.imm(&mut fc.buf, a64.X0, 0)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        }
        return
    }
    if id == hb.INTRINSIC_PTR_IS_NULL && a_len >= 1 && tm.dest_val >= 0 {
        ra := load_gp_val(&mut fc, f.val_args[a_start], a64.X0)
        a64.cmp_imm(&mut fc.buf, true, ra, 0)
        a64.cset(&mut fc.buf, a64.X1, a64.CC_EQ)
        store_gp_val(&mut fc, tm.dest_val, a64.X1)
        return
    }
    if (id == hb.INTRINSIC_AS_PTR || id == hb.INTRINSIC_AS_MUT_PTR || id == hb.INTRINSIC_PTR_ADDR) && a_len >= 1 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        aty := f.vals[av].ty
        ak := types.entries[aty].kind
        if fc.plan.locs[av].cls == .Fat {
            load_fat_into(&mut fc, av, a64.X0, a64.X1)
        } else if ak == .String {
            load_gp_into(&mut fc, av, a64.X0)
            a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X0, 8)
        } else if ak == .Array {
            load_gp_into(&mut fc, av, a64.X0)
            a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
        } else if (ak == .Ref || ak == .MutRef) && id != hb.INTRINSIC_PTR_ADDR {
            inner := types.entries[aty].inner_a
            ik := if inner >= 0 && inner < types.entries.len { types.entries[inner].kind } else { .Unit }
            load_gp_into(&mut fc, av, a64.X0)
            if ik == .String {
                a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
                a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X0, 8)
            } else if ik == .Array {
                a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
                a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
            } else if ik == .FatSlice || ik == .FatStr || ik == .RegionSlice {
                a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
            }
        } else {
            load_gp_into(&mut fc, av, a64.X0)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }

    // 12. Raw pointer arithmetic, read/write, and memory/atomic intrinsics
    if (id == hb.INTRINSIC_PTR_ADD || id == hb.INTRINSIC_PTR_SUB || id == hb.INTRINSIC_PTR_OFFSET ||
        id == hb.INTRINSIC_PTR_BYTE_ADD || id == hb.INTRINSIC_PTR_BYTE_OFFSET) && a_len >= 2 && tm.dest_val >= 0 {
        pv := f.val_args[a_start]
        iv := f.val_args[a_start + 1]
        pty := f.vals[pv].ty
        elem_ty := if pty >= 0 && pty < types.entries.len { types.entries[pty].inner_a } else { ht.TY_U8 }
        stride: i64 = if id == hb.INTRINSIC_PTR_BYTE_ADD || id == hb.INTRINSIC_PTR_BYTE_OFFSET { 1 }
            else { i64(if type_size(&types, elem_ty) > 0 { align_up_i32(type_size(&types, elem_ty), type_align(&types, elem_ty)) } else { 1 }) }
        load_gp_into(&mut fc, pv, a64.X0)
        load_gp_into(&mut fc, iv, a64.X1)
        if stride > 1 {
            a64.imm(&mut fc.buf, a64.X16, stride)
            a64.mul(&mut fc.buf, true, a64.X1, a64.X1, a64.X16)
        }
        if id == hb.INTRINSIC_PTR_SUB {
            a64.sub_reg(&mut fc.buf, true, false, a64.X0, a64.X0, a64.X1)
        } else {
            a64.add_reg(&mut fc.buf, true, false, a64.X0, a64.X0, a64.X1)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }
    if (id == hb.INTRINSIC_PTR_READ || (id >= hb.INTRINSIC_LOAD_U64 && id <= hb.INTRINSIC_LOAD_PTR)) && a_len >= 1 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        d_ty := f.vals[tm.dest_val].ty
        d_cls := fc.plan.locs[tm.dest_val].cls
        load_gp_into(&mut fc, av, a64.X4)
        if d_cls == .Gp {
            sz := type_size(&types, d_ty)
            w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
            emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, 0, w, is_signed_int_ty(&types, d_ty))
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if d_cls == .Fp {
            emit_ldr_fp_off(&mut fc.buf, is_f64_ty(&types, d_ty), 16, a64.X4, 0)
            store_fp_val(&mut fc, tm.dest_val, 16)
        } else if d_cls == .Fat {
            emit_ldr_off(&mut fc.buf, a64.X0, a64.X4, 0, 8, false)
            emit_ldr_off(&mut fc.buf, a64.X1, a64.X4, 8, 8, false)
            store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
        } else if d_cls == .Agg {
            emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
            emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X4, type_size(&types, d_ty))
        }
        return
    }
    if (id == hb.INTRINSIC_PTR_WRITE || (id >= hb.INTRINSIC_STORE_U64 && id <= hb.INTRINSIC_STORE_PTR)) && a_len >= 2 {
        pv := f.val_args[a_start]
        vv := f.val_args[a_start + 1]
        v_ty := f.vals[vv].ty
        v_cls := fc.plan.locs[vv].cls
        load_gp_into(&mut fc, pv, a64.X4)
        if v_cls == .Gp {
            sz := type_size(&types, v_ty)
            w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
            rv := load_gp_val(&mut fc, vv, a64.X0)
            emit_str_off(&mut fc.buf, rv, a64.X4, 0, w)
        } else if v_cls == .Fp {
            vf := load_fp_val(&mut fc, vv, 16)
            emit_str_fp_off(&mut fc.buf, is_f64_ty(&types, v_ty), vf, a64.X4, 0)
        } else if v_cls == .Fat {
            load_fat_into(&mut fc, vv, a64.X0, a64.X1)
            emit_str_off(&mut fc.buf, a64.X0, a64.X4, 0, 8)
            emit_str_off(&mut fc.buf, a64.X1, a64.X4, 8, 8)
        } else if v_cls == .Agg {
            emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[vv].spill_off))
            emit_memcpy_size(&mut fc, &rt, a64.X4, a64.X7, type_size(&types, v_ty))
        }
        return
    }
    if id == hb.INTRINSIC_PTR_AS_REF && a_len >= 1 && tm.dest_val >= 0 {
        d_ty := f.vals[tm.dest_val].ty
        d_cls := fc.plan.locs[tm.dest_val].cls
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        if d_cls == .Agg {
            emit_sub_imm_any(&mut fc.buf, a64.X4, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
            emit_memzero_size(&mut fc, &rt, a64.X4, type_size(&types, d_ty))
            lbl_null := a64.label(&mut fc.buf)
            lbl_done := a64.label(&mut fc.buf)
            a64.cbz(&mut fc.buf, true, a64.X0, lbl_null)
            poff := enum_payload_offset(&types, d_ty, 0, 0)
            emit_str_off(&mut fc.buf, a64.X0, a64.X4, i64(poff), 8)
            a64.b(&mut fc.buf, lbl_done)
            a64.mark(&mut fc.buf, lbl_null)
            a64.imm(&mut fc.buf, a64.X1, 1)
            emit_str_off(&mut fc.buf, a64.X1, a64.X4, 0, 4)
            a64.mark(&mut fc.buf, lbl_done)
        } else {
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        }
        return
    }
    if id == hb.INTRINSIC_ZEROED && tm.dest_val >= 0 {
        d_cls := fc.plan.locs[tm.dest_val].cls
        if d_cls == .Gp {
            a64.imm(&mut fc.buf, a64.X0, 0)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if d_cls == .Fp {
            a64.fmov_to_fp(&mut fc.buf, is_f64_ty(&types, f.vals[tm.dest_val].ty), 16, a64.XZR)
            store_fp_val(&mut fc, tm.dest_val, 16)
        } else if d_cls == .Fat {
            a64.imm(&mut fc.buf, a64.X0, 0)
            store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X0)
        } else if d_cls == .Agg {
            emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
            emit_memzero_size(&mut fc, &rt, a64.X6, type_size(&types, f.vals[tm.dest_val].ty))
        }
        return
    }

    // 13. String bytes / slice & memory / atomic sys intrinsics
    if id == hb.INTRINSIC_STR_BYTES && a_len >= 1 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        ak := types.entries[f.vals[av].ty].kind
        if ak == .FatStr {
            load_fat_into(&mut fc, av, a64.X4, a64.X5)
        } else {
            load_gp_into(&mut fc, av, a64.X4)
            a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 8, false)
            a64.add_imm(&mut fc.buf, true, false, a64.X4, a64.X4, 8)
        }
        a64.stp_pre(&mut fc.buf, a64.X4, a64.X5, a64.SP, -16)
        a64.mov(&mut fc.buf, a64.X0, a64.X5)
        a64.imm(&mut fc.buf, a64.X1, 1)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_alloc)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false) // data_ptr
        a64.ldp_post(&mut fc.buf, a64.X1, a64.X2, a64.SP, 16) // src_ptr, len
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
        return
    }
    if id == hb.INTRINSIC_SYS_MEM_COPY && a_len >= 3 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X2)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
        return
    }
    if id == hb.INTRINSIC_SYS_MEM_ZERO && a_len >= 2 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memzero)
        return
    }
    if id == hb.INTRINSIC_SYS_MEM_EQUAL && a_len >= 3 && tm.dest_val >= 0 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X2)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.mem_eq)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }
    if id == hb.INTRINSIC_SYS_ATOMIC_LOAD && a_len >= 1 && tm.dest_val >= 0 {
        ra := load_gp_val(&mut fc, f.val_args[a_start], a64.X0)
        a64.ldar(&mut fc.buf, true, a64.X1, ra)
        store_gp_val(&mut fc, tm.dest_val, a64.X1)
        return
    }
    if id == hb.INTRINSIC_SYS_ATOMIC_STORE && a_len >= 2 {
        ra := load_gp_val(&mut fc, f.val_args[a_start], a64.X0)
        rv := load_gp_val(&mut fc, f.val_args[a_start + 1], a64.X1)
        a64.stlr(&mut fc.buf, true, rv, ra)
        return
    }
    if id == hb.INTRINSIC_SYS_ATOMIC_FETCH_ADD && a_len >= 2 && tm.dest_val >= 0 {
        ra := load_gp_val(&mut fc, f.val_args[a_start], a64.X4)
        rv := load_gp_val(&mut fc, f.val_args[a_start + 1], a64.X5)
        lbl_fa := a64.label(&mut fc.buf)
        a64.mark(&mut fc.buf, lbl_fa)
        a64.ldaxr(&mut fc.buf, true, a64.X0, ra)
        a64.add_reg(&mut fc.buf, true, false, a64.X1, a64.X0, rv)
        a64.stlxr(&mut fc.buf, true, a64.X16, a64.X1, ra)
        a64.cbnz(&mut fc.buf, false, a64.X16, lbl_fa)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }
    if id == hb.INTRINSIC_SYS_ATOMIC_CAS && a_len >= 3 && tm.dest_val >= 0 {
        ra := load_gp_val(&mut fc, f.val_args[a_start], a64.X4)
        re := load_gp_val(&mut fc, f.val_args[a_start + 1], a64.X5)
        rn := load_gp_val(&mut fc, f.val_args[a_start + 2], a64.X6)
        lbl_cas_loop := a64.label(&mut fc.buf)
        lbl_cas_fail := a64.label(&mut fc.buf)
        lbl_cas_done := a64.label(&mut fc.buf)
        a64.mark(&mut fc.buf, lbl_cas_loop)
        a64.ldaxr(&mut fc.buf, true, a64.X0, ra)
        a64.cmp_reg(&mut fc.buf, true, a64.X0, re)
        a64.b_cond(&mut fc.buf, a64.CC_NE, lbl_cas_fail)
        a64.stlxr(&mut fc.buf, true, a64.X16, rn, ra)
        a64.cbnz(&mut fc.buf, false, a64.X16, lbl_cas_loop)
        a64.imm(&mut fc.buf, a64.X0, 1)
        a64.b(&mut fc.buf, lbl_cas_done)
        a64.mark(&mut fc.buf, lbl_cas_fail)
        a64.imm(&mut fc.buf, a64.X0, 0)
        a64.mark(&mut fc.buf, lbl_cas_done)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }
    if id == hb.INTRINSIC_SYNC_THREAD_TOKEN && tm.dest_val >= 0 {
        a64.mov(&mut fc.buf, a64.X0, a64.SP)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }

    // 14. Structured multi-worker concurrency: INTRINSIC_TASK_SPAWN / INTRINSIC_TASK_JOIN / WAIT_ANY
    if id == hb.INTRINSIC_TASK_SPAWN && a_len >= 2 {
        // arg[0] = scope handle slot ptr, arg[1] = worker fn ptr, arg[2..] = worker args
        // Allocate 96-byte TaskNode
        a64.imm(&mut fc.buf, a64.X0, 96)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
        a64.stp_pre(&mut fc.buf, a64.X0, a64.XZR, a64.SP, -16) // [sp+0] = TaskNode*
        emit_inline_memzero(&mut fc.buf, a64.X0, 96)
        a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false) // x4 = node
        // Store worker_fn_ptr at [node + 16]
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X5)
        a64.str(&mut fc.buf, a64.X5, a64.X4, 16, 8)
        // Store explicit worker args into [node + 24 + slot*8]
        mut w_slot := 0
        for ai in 2..a_len {
            if w_slot >= 4 { break }
            av := f.val_args[a_start + ai]
            acls := fc.plan.locs[av].cls
            if acls == .Gp {
                load_gp_into(&mut fc, av, a64.X5)
                a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
                a64.str(&mut fc.buf, a64.X5, a64.X4, 24 + w_slot * 8, 8)
                w_slot += 1
            } else if acls == .Fat {
                load_fat_into(&mut fc, av, a64.X5, a64.X6)
                a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
                a64.str(&mut fc.buf, a64.X5, a64.X4, 24 + w_slot * 8, 8)
                if w_slot + 1 < 4 { a64.str(&mut fc.buf, a64.X6, a64.X4, 24 + (w_slot + 1) * 8, 8) }
                w_slot += 2
            } else if acls == .Agg {
                asz := type_size(&types, f.vals[av].ty)
                a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
                if asz <= 8 {
                    emit_ldr_off(&mut fc.buf, a64.X5, a64.FP, -i64(fc.plan.locs[av].spill_off), 8, false)
                    a64.str(&mut fc.buf, a64.X5, a64.X4, 24 + w_slot * 8, 8)
                    w_slot += 1
                } else if asz <= 16 {
                    emit_ldr_off(&mut fc.buf, a64.X5, a64.FP, -i64(fc.plan.locs[av].spill_off), 8, false)
                    emit_ldr_off(&mut fc.buf, a64.X6, a64.FP, -i64(fc.plan.locs[av].spill_off) + 8, 8, false)
                    a64.str(&mut fc.buf, a64.X5, a64.X4, 24 + w_slot * 8, 8)
                    if w_slot + 1 < 4 { a64.str(&mut fc.buf, a64.X6, a64.X4, 24 + (w_slot + 1) * 8, 8) }
                    w_slot += 2
                } else {
                    a64.imm(&mut fc.buf, a64.X0, i64(align_up_i32(asz, 8)))
                    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
                    a64.mov(&mut fc.buf, a64.X6, a64.X0)
                    emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[av].spill_off))
                    emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, asz)
                    a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
                    a64.str(&mut fc.buf, a64.X6, a64.X4, 24 + w_slot * 8, 8)
                    w_slot += 1
                }
            }
        }
        // Append scope's shared arg if present (`[scope_hdr + 24] != 0`)
        if w_slot < 4 && fc.plan.locs[f.val_args[a_start]].cls == .Gp {
            load_gp_into(&mut fc, f.val_args[a_start], a64.X5) // &scope_slot
            a64.ldr(&mut fc.buf, a64.X5, a64.X5, 0, 8, false)  // scope_hdr
            lbl_no_sh := a64.label(&mut fc.buf)
            a64.cbz(&mut fc.buf, true, a64.X5, lbl_no_sh)
            a64.ldr(&mut fc.buf, a64.X6, a64.X5, 24, 8, false) // has_shared
            a64.cbz(&mut fc.buf, true, a64.X6, lbl_no_sh)
            a64.ldr(&mut fc.buf, a64.X6, a64.X5, 16, 8, false) // shared_val
            a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
            a64.str(&mut fc.buf, a64.X6, a64.X4, 24 + w_slot * 8, 8)
            a64.mark(&mut fc.buf, lbl_no_sh)
        }
        // Allocate sret buffer if Task<T> inner type is Agg > 16B
        if tm.dest_val >= 0 {
            t_ty := f.vals[tm.dest_val].ty
            if types.entries[t_ty].kind == .Task {
                inner_ty := types.entries[t_ty].inner_a
                if classify_type(&types, inner_ty) == .Agg && type_size(&types, inner_ty) > 16 {
                    a64.imm(&mut fc.buf, a64.X0, i64(align_up_i32(type_size(&types, inner_ty), 8)))
                    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
                    a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
                    a64.str(&mut fc.buf, a64.X0, a64.X4, 72, 8) // sret_buf
                }
            }
        }
        // Link TaskNode onto scope_hdr task list: node.next = scope_hdr[0]; scope_hdr[0] = node
        if fc.plan.locs[f.val_args[a_start]].cls == .Gp {
            load_gp_into(&mut fc, f.val_args[a_start], a64.X5)
            a64.ldr(&mut fc.buf, a64.X5, a64.X5, 0, 8, false)
            lbl_no_link := a64.label(&mut fc.buf)
            a64.cbz(&mut fc.buf, true, a64.X5, lbl_no_link)
            a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
            a64.ldr(&mut fc.buf, a64.X6, a64.X5, 0, 8, false)
            a64.str(&mut fc.buf, a64.X6, a64.X4, 80, 8) // node.next
            a64.str(&mut fc.buf, a64.X4, a64.X5, 0, 8)  // scope_hdr.head = node
            a64.mark(&mut fc.buf, lbl_no_link)
        }
        // Call pthread_create(&node[0], NULL, &__dunder_rt_pthread_trampoline, node)
        a64.ldr(&mut fc.buf, a64.X0, a64.SP, 0, 8, false) // &node.pthread_t
        a64.imm(&mut fc.buf, a64.X1, 0)                   // attr = NULL
        emit_adrp_sym(&mut fc.buf, &mut fc.relocs, a64.X2, rt.pthread_tramp, 0)
        a64.mov(&mut fc.buf, a64.X3, a64.X0)              // arg = node
        p_lib := if target == .Arm64Macos { "c" } else { "pthread" }
        imp_pc := obj.add_import(&mut m, &native_imports.symbol_spec(p_lib, "pthread_create"))
        lbl_pc := a64.label(&mut fc.buf)
        a64.mark(&mut fc.buf, lbl_pc)
        a64.nop(&mut fc.buf)
        a64.nop(&mut fc.buf)
        fc.imp_sites.push(PendingImport { site_lbl: lbl_pc, imp_id: imp_pc })
        a64.blr(&mut fc.buf, a64.X16)
        a64.ldp_post(&mut fc.buf, a64.X0, a64.X1, a64.SP, 16)
        if tm.dest_val >= 0 {
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        }
        return
    }

    if id == hb.INTRINSIC_TASK_JOIN && a_len >= 1 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X4)
        a64.stp_pre(&mut fc.buf, a64.X4, a64.XZR, a64.SP, -16) // save node on stack
        a64.ldr(&mut fc.buf, a64.X5, a64.X4, 8, 8, false)      // joined_flag
        lbl_joined := a64.label(&mut fc.buf)
        a64.cbnz(&mut fc.buf, true, a64.X5, lbl_joined)
        a64.imm(&mut fc.buf, a64.X5, 1)
        a64.str(&mut fc.buf, a64.X5, a64.X4, 8, 8)
        a64.ldr(&mut fc.buf, a64.X0, a64.X4, 0, 8, false)      // pthread_t
        a64.imm(&mut fc.buf, a64.X1, 0)                        // retval = NULL
        p_lib := if target == .Arm64Macos { "c" } else { "pthread" }
        imp_pj := obj.add_import(&mut m, &native_imports.symbol_spec(p_lib, "pthread_join"))
        lbl_pj := a64.label(&mut fc.buf)
        a64.mark(&mut fc.buf, lbl_pj)
        a64.nop(&mut fc.buf)
        a64.nop(&mut fc.buf)
        fc.imp_sites.push(PendingImport { site_lbl: lbl_pj, imp_id: imp_pj })
        a64.blr(&mut fc.buf, a64.X16)
        a64.mark(&mut fc.buf, lbl_joined)
        a64.ldp_post(&mut fc.buf, a64.X4, a64.X5, a64.SP, 16)
        if tm.dest_val >= 0 {
            d_cls := fc.plan.locs[tm.dest_val].cls
            d_ty := f.vals[tm.dest_val].ty
            if d_cls == .Gp {
                a64.ldr(&mut fc.buf, a64.X0, a64.X4, 56, 8, false)
                store_gp_val(&mut fc, tm.dest_val, a64.X0)
            } else if d_cls == .Fp {
                a64.ldr_fp(&mut fc.buf, is_f64_ty(&types, d_ty), 16, a64.X4, 88)
                store_fp_val(&mut fc, tm.dest_val, 16)
            } else if d_cls == .Fat {
                a64.ldr(&mut fc.buf, a64.X0, a64.X4, 56, 8, false)
                a64.ldr(&mut fc.buf, a64.X1, a64.X4, 64, 8, false)
                store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
            } else if d_cls == .Agg {
                dsz := type_size(&types, d_ty)
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                if dsz <= 8 {
                    a64.ldr(&mut fc.buf, a64.X0, a64.X4, 56, 8, false)
                    emit_str_off(&mut fc.buf, a64.X0, a64.X6, 0, 8)
                } else if dsz <= 16 {
                    a64.ldr(&mut fc.buf, a64.X0, a64.X4, 56, 8, false)
                    a64.ldr(&mut fc.buf, a64.X1, a64.X4, 64, 8, false)
                    emit_str_off(&mut fc.buf, a64.X0, a64.X6, 0, 8)
                    emit_str_off(&mut fc.buf, a64.X1, a64.X6, 8, 8)
                } else {
                    a64.ldr(&mut fc.buf, a64.X7, a64.X4, 72, 8, false) // sret_buf
                    emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, dsz)
                }
            }
        }
        return
    }
    if id == hb.INTRINSIC_TASK_WAIT_ANY && tm.dest_val >= 0 {
        a64.imm(&mut fc.buf, a64.X0, 0)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return
    }

    // 15. Map / Set / Hash intrinsics
    if emit_map_intrinsic_arm64(&mut m, &hir, &f, &mut fc, &rt, &tm) { return }

    // 16. Formatting, UTF-8, Slices, Embed/Static Bytes, and OS __sys_* intrinsics
    _ := emit_sys_and_fmt_intrinsic_arm64(&mut m, &hir, &f, &mut fc, &rt, target, &tm)
}

fn emit_abi_call(m: &mut obj.ObjectModule, hir: &hb.HirProgram, f: &ssa.SsaFunc,
    fc: &mut FnCodegen, fn_syms: &[]i32, tm: &ssa.SsaTerm) {
    types := &hir.types

    // Plan GP regs (x0..x7), FP regs (d0..d7), and outgoing stack words
    mut gp_idx := 0
    mut fp_idx := 0
    mut stack_words := 0
    mut arg_kind: []i32 = []   // 0=void, 1=gp_reg, 2=fp_reg, 3=fat_reg, 4=agg_reg1, 5=agg_reg2, 6=agg_ptr_reg, 7=stack1, 8=stack2, 9=agg_ptr_stack
    mut arg_slot: []i32 = []   // reg num or stack word index

    for ai in 0..tm.arg_len {
        av := f.val_args[tm.arg_start + ai]
        aty := f.vals[av].ty
        cls := fc.plan.locs[av].cls
        if cls == .Void {
            arg_kind.push(0); arg_slot.push(0)
        } else if cls == .Gp {
            if gp_idx < 8 { arg_kind.push(1); arg_slot.push(gp_idx); gp_idx += 1 }
            else { arg_kind.push(7); arg_slot.push(stack_words); stack_words += 1 }
        } else if cls == .Fp {
            if fp_idx < 8 { arg_kind.push(2); arg_slot.push(fp_idx); fp_idx += 1 }
            else { arg_kind.push(7); arg_slot.push(stack_words); stack_words += 1 }
        } else if cls == .Fat {
            if gp_idx + 2 <= 8 { arg_kind.push(3); arg_slot.push(gp_idx); gp_idx += 2 }
            else { gp_idx = 8; arg_kind.push(8); arg_slot.push(stack_words); stack_words += 2 }
        } else {
            sz := type_size(&types, aty)
            if sz <= 8 {
                if gp_idx < 8 { arg_kind.push(4); arg_slot.push(gp_idx); gp_idx += 1 }
                else { arg_kind.push(7); arg_slot.push(stack_words); stack_words += 1 }
            } else if sz <= 16 {
                if gp_idx + 2 <= 8 { arg_kind.push(5); arg_slot.push(gp_idx); gp_idx += 2 }
                else { gp_idx = 8; arg_kind.push(8); arg_slot.push(stack_words); stack_words += 2 }
            } else {
                if gp_idx < 8 { arg_kind.push(6); arg_slot.push(gp_idx); gp_idx += 1 }
                else { arg_kind.push(9); arg_slot.push(stack_words); stack_words += 1 }
            }
        }
    }

    stack_bytes := if stack_words > 0 { align_up_i32(stack_words * 8, 16) } else { 0 }
    if stack_bytes > 0 {
        emit_sub_imm_any(&mut fc.buf, a64.SP, a64.SP, i64(stack_bytes))
    }

    // Populate stack overflow args first
    for ai in 0..tm.arg_len {
        k := arg_kind[ai]
        if k != 7 && k != 8 && k != 9 { continue }
        av := f.val_args[tm.arg_start + ai]
        soff := i64(arg_slot[ai] * 8)
        cls := fc.plan.locs[av].cls
        if k == 7 {
            if cls == .Gp {
                load_gp_into(&mut fc, av, a64.X16)
                emit_str_off(&mut fc.buf, a64.X16, a64.SP, soff, 8)
            } else if cls == .Fp {
                load_fp_into(&mut fc, av, 16)
                emit_str_fp_off(&mut fc.buf, fc.plan.locs[av].is_f64, 16, a64.SP, soff)
            } else {
                emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, -i64(fc.plan.locs[av].spill_off), 8, false)
                emit_str_off(&mut fc.buf, a64.X16, a64.SP, soff, 8)
            }
        } else if k == 8 {
            if cls == .Fat {
                load_fat_into(&mut fc, av, a64.X0, a64.X1)
                emit_str_off(&mut fc.buf, a64.X0, a64.SP, soff, 8)
                emit_str_off(&mut fc.buf, a64.X1, a64.SP, soff + 8, 8)
            } else {
                emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, -i64(fc.plan.locs[av].spill_off), 8, false)
                emit_str_off(&mut fc.buf, a64.X16, a64.SP, soff, 8)
                emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, -i64(fc.plan.locs[av].spill_off) + 8, 8, false)
                emit_str_off(&mut fc.buf, a64.X16, a64.SP, soff + 8, 8)
            }
        } else if k == 9 {
            emit_sub_imm_any(&mut fc.buf, a64.X16, a64.FP, i64(fc.plan.locs[av].spill_off))
            emit_str_off(&mut fc.buf, a64.X16, a64.SP, soff, 8)
        }
    }

    // Populate register args (note: x0..x7 are NOT in GP alloc pool, so loading x0..x7 never clobbers live GP vals!
    // For FP args, d0..d7 MAY hold live caller-saved FP vals whose last use is THIS call, so use parallel moves for FP!)
    mut fp_arg_moves: []ScalarMove = []
    for ai in 0..tm.arg_len {
        k := arg_kind[ai]
        av := f.val_args[tm.arg_start + ai]
        reg := arg_slot[ai]
        if k == 1 {
            load_gp_into(&mut fc, av, reg)
        } else if k == 2 {
            sl := fc.plan.locs[av]
            fp_arg_moves.push(ScalarMove {
                src_is_reg: sl.kind == .Reg,
                src_loc: if sl.kind == .Reg { sl.reg_lo } else { sl.spill_off },
                dst_is_reg: true,
                dst_loc: reg,
                is_f64: sl.is_f64,
                done: false,
            })
        } else if k == 3 {
            load_fat_into(&mut fc, av, reg, reg + 1)
        } else if k == 4 {
            emit_ldr_off(&mut fc.buf, reg, a64.FP, -i64(fc.plan.locs[av].spill_off), 8, false)
        } else if k == 5 {
            emit_ldr_off(&mut fc.buf, reg, a64.FP, -i64(fc.plan.locs[av].spill_off), 8, false)
            emit_ldr_off(&mut fc.buf, reg + 1, a64.FP, -i64(fc.plan.locs[av].spill_off) + 8, 8, false)
        } else if k == 6 {
            emit_sub_imm_any(&mut fc.buf, reg, a64.FP, i64(fc.plan.locs[av].spill_off))
        }
    }
    if fp_arg_moves.len > 0 {
        run_parallel_moves(&mut fc.buf, &mut fp_arg_moves, true)
    }

    // Setup indirect sret in x8 if return value is Agg with size > 16
    mut use_sret := false
    if tm.dest_val >= 0 && fc.plan.locs[tm.dest_val].cls == .Agg {
        rsz := type_size(&types, f.vals[tm.dest_val].ty)
        if rsz > 16 {
            use_sret = true
            emit_sub_imm_any(&mut fc.buf, a64.X8, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
        }
    }

    // Emit the actual call instruction
    if tm.kind == .Call {
        if tm.callee >= 0 && tm.callee < fn_syms.len && fn_syms[tm.callee] >= 0 {
            emit_call_sym(&mut fc.buf, &mut fc.relocs, fn_syms[tm.callee])
        }
    } else if tm.kind == .IndirectCall {
        if tm.env_val >= 0 {
            // Closure call: x9 = env_ptr, x16 = [x9 + 0], blr x16
            load_gp_into(&mut fc, tm.env_val, a64.X9)
            a64.ldr(&mut fc.buf, a64.X16, a64.X9, 0, 8, false)
        } else {
            load_gp_into(&mut fc, tm.cond_val, a64.X16)
        }
        a64.blr(&mut fc.buf, a64.X16)
    } else if tm.kind == .ExternCall {
        if tm.callee >= 0 && tm.callee < hir.fns.len {
            hf := &hir.fns[tm.callee]
            lib := if hf.extern_lib != "" { hf.extern_lib.clone() } else { "c" }
            sym_name := if hf.extern_symbol != "" { hf.extern_symbol.clone() } else { hf.name.clone() }
            mut spec := native_imports.symbol_spec(lib, sym_name)
            spec.weak = hf.link_weak
            spec.delay = hf.link_delay
            imp_id := obj.add_import(&mut m, &spec)
            lbl := a64.label(&mut fc.buf)
            a64.mark(&mut fc.buf, lbl)
            a64.nop(&mut fc.buf)
            a64.nop(&mut fc.buf)
            fc.imp_sites.push(PendingImport { site_lbl: lbl, imp_id: imp_id })
            a64.blr(&mut fc.buf, a64.X16)
        }
    }

    if stack_bytes > 0 {
        emit_add_imm_any(&mut fc.buf, a64.SP, a64.SP, i64(stack_bytes))
    }

    // Receive return value
    if tm.dest_val >= 0 && !use_sret {
        dl := fc.plan.locs[tm.dest_val]
        if dl.cls == .Gp {
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
        } else if dl.cls == .Fp {
            store_fp_val(&mut fc, tm.dest_val, 0)
        } else if dl.cls == .Fat {
            store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
        } else if dl.cls == .Agg {
            rsz := type_size(&types, f.vals[tm.dest_val].ty)
            if rsz > 0 {
                emit_str_off(&mut fc.buf, a64.X0, a64.FP, -i64(dl.spill_off), 8)
                if rsz > 8 {
                    emit_str_off(&mut fc.buf, a64.X1, a64.FP, -i64(dl.spill_off) + 8, 8)
                }
            }
        }
    }
}

// =========================================================================
// 9. Function-Level Frame Layout, Prologue, Blocks, Epilogue & Emission
// =========================================================================

fn emit_closure_writeback(fc: &mut FnCodegen, types: &ht.TypeTable, f: &ssa.SsaFunc, rt: &RuntimeSyms) {
    if !f.is_closure_body || fc.env_off <= 0 { return }
    if f.sig_ty < 0 || f.sig_ty >= types.entries.len { return }
    cte := &types.entries[f.sig_ty]
    if cte.flags.bit_and(ht.TF_CLOSURE_MUT) == 0 || cte.count <= 0 { return }
    mut cap_off := 16
    for ci in 0..cte.count {
        loc_id := 1 + f.param_count + ci
        cty := ht.field_type(&types, f.sig_ty, ci)
        csz := align_up_i32(type_size(&types, cty), 8)
        step := if csz < 8 { 8 } else { csz }
        if loc_id < f.slots.len && !f.slots[loc_id].dead && fc.slot_offs[loc_id] > 0 {
            emit_ldr_off(&mut fc.buf, a64.X4, a64.FP, -i64(fc.env_off), 8, false)
            emit_add_imm_any(&mut fc.buf, a64.X6, a64.X4, i64(cap_off))
            emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.slot_offs[loc_id]))
            emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, cty))
        }
        cap_off += step
    }
}

fn func_has_task_spawn(f: &ssa.SsaFunc) -> bool {
    for ti in 0..f.terms.len {
        if f.terms[ti].kind == .IntrinsicCall && f.terms[ti].callee == hb.INTRINSIC_TASK_SPAWN {
            return true
        }
    }
    false
}

fn emit_function(m: &mut obj.ObjectModule, hir: &hb.HirProgram, f: &ssa.SsaFunc,
    rt: &RuntimeSyms, fn_syms: &[]i32, target: obj.TargetKind, sources: &[]string) {
    types := &hir.types
    has_spawns := func_has_task_spawn(&f)
    mut plan := allocate_registers(&types, &f)

    // 1. Lay out frame slots (all negative byte offsets from FP, aligned to natural alignment)
    mut cur_off := 0

    // Callee-saved GP regs (x22..x28)
    mut callee_gp_offs: []i32 = []
    for _ in 0..plan.used_callee_gp.len {
        cur_off = align_up_i32(cur_off + 8, 8)
        callee_gp_offs.push(cur_off)
    }
    // Callee-saved FP regs (d8..d15)
    mut callee_fp_offs: []i32 = []
    for _ in 0..plan.used_callee_fp.len {
        cur_off = align_up_i32(cur_off + 8, 8)
        callee_fp_offs.push(cur_off)
    }

    // sret save slot (if return type is Agg > 16B)
    ret_cls := classify_type(&types, f.ret_ty)
    ret_sz := type_size(&types, f.ret_ty)
    mut sret_off := 0
    if ret_cls == .Agg && ret_sz > 16 {
        cur_off = align_up_i32(cur_off + 8, 8)
        sret_off = cur_off
    }

    // Closure env save slot
    mut env_off := 0
    if f.is_closure_body {
        cur_off = align_up_i32(cur_off + 8, 8)
        env_off = cur_off
    }

    // Region save slots (2 words: saved x19, x20 per RegionEnter scope_id)
    mut region_ids: []i32 = []
    mut region_offs: []i32 = []
    for bb in 0..f.blocks.len {
        tid := f.blocks[bb].term_id
        if tid >= 0 && f.terms[tid].kind == .RegionEnter {
            sid := f.terms[tid].callee
            mut found := false
            for k in 0..region_ids.len { if region_ids[k] == sid { found = true; break } }
            if !found {
                cur_off = align_up_i32(cur_off + 16, 8)
                region_ids.push(sid)
                region_offs.push(cur_off)
            }
        }
    }

    // Explicit StackSlots (non-dead; addr_taken slots with size 0 still reserve 8B so SlotAddr never hits FP)
    mut slot_offs: []i32 = []
    for si in 0..f.slots.len {
        sl := &f.slots[si]
        if sl.dead || (sl.size <= 0 && !sl.addr_taken) {
            slot_offs.push(0)
            continue
        }
        al := if sl.align > 8 { sl.align } else { 8 }
        raw_sz := if sl.size > 0 { sl.size } else { 8 }
        sz := align_up_i32(raw_sz, 8)
        cur_off = align_up_i32(cur_off + sz, al)
        slot_offs.push(cur_off)
    }

    // Spill slots & Agg value homes
    for v in 0..plan.locs.len {
        lk := plan.locs[v].kind
        if lk == .Spill {
            sz := if plan.locs[v].cls == .Fat { 16 } else { 8 }
            cur_off = align_up_i32(cur_off + sz, 8)
            plan.locs[v].spill_off = cur_off
        } else if lk == .AggHome {
            vty := f.vals[v].ty
            vsz := align_up_i32(type_size(&types, vty), 8)
            val := if type_align(&types, vty) > 8 { type_align(&types, vty) } else { 8 }
            if vsz > 0 {
                cur_off = align_up_i32(cur_off + vsz, val)
                plan.locs[v].spill_off = cur_off
            }
        }
    }

    frame_bytes := align_up_i32(cur_off, 16)

    mut buf := a64.new()
    mut bb_labels: []i32 = []
    for _ in 0..f.blocks.len { bb_labels.push(a64.label(&mut buf)) }
    epilogue_lbl := a64.label(&mut buf)
    trap_101 := a64.label(&mut buf)
    trap_102 := a64.label(&mut buf)
    trap_103 := a64.label(&mut buf)
    trap_104 := a64.label(&mut buf)
    trap_105 := a64.label(&mut buf)
    trap_106 := a64.label(&mut buf)

    mut fc := FnCodegen {
        buf: move buf,
        relocs: [],
        imp_sites: [],
        gsites: [],
        plan: move plan,
        slot_offs: move slot_offs,
        callee_gp_offs: move callee_gp_offs,
        callee_fp_offs: move callee_fp_offs,
        sret_off: sret_off,
        env_off: env_off,
        region_offs: move region_offs,
        region_ids: move region_ids,
        frame_bytes: frame_bytes,
        bb_labels: move bb_labels,
        epilogue_lbl: epilogue_lbl,
        trap_101: trap_101,
        trap_102: trap_102,
        trap_103: trap_103,
        trap_104: trap_104,
        trap_105: trap_105,
        trap_106: trap_106,
        ro_counter: 0,
    }

    // 2. Prologue
    a64.stp_pre(&mut fc.buf, a64.FP, a64.LR, a64.SP, -16)
    a64.mov(&mut fc.buf, a64.FP, a64.SP)
    if frame_bytes > 0 {
        emit_sub_imm_any(&mut fc.buf, a64.SP, a64.SP, i64(frame_bytes))
    }
    for i in 0..fc.plan.used_callee_gp.len {
        emit_str_off(&mut fc.buf, fc.plan.used_callee_gp[i], a64.FP, -i64(fc.callee_gp_offs[i]), 8)
    }
    for i in 0..fc.plan.used_callee_fp.len {
        emit_str_fp_off(&mut fc.buf, true, fc.plan.used_callee_fp[i], a64.FP, -i64(fc.callee_fp_offs[i]))
    }
    if fc.sret_off > 0 {
        emit_str_off(&mut fc.buf, a64.X8, a64.FP, -i64(fc.sret_off), 8)
    }
    if fc.env_off > 0 {
        emit_str_off(&mut fc.buf, a64.X9, a64.FP, -i64(fc.env_off), 8)
    }

    // 3. Receive incoming function parameters into their allocated SsaVal locations
    // NOTE: Handle FP params via parallel moves because d0..d7 may be allocated to incoming FP params!
    mut in_gp := 0
    mut in_fp := 0
    mut in_stk := 0
    mut fp_in_moves: []ScalarMove = []
    mut deferred_agg_offs: []i32 = []
    mut deferred_agg_szs: []i32 = []
    for pi in 0..f.param_vals.len {
        pv := f.param_vals[pi]
        pty := f.vals[pv].ty
        ploc := fc.plan.locs[pv]
        if ploc.cls == .Void { continue }
        if ploc.cls == .Gp {
            if in_gp < 8 {
                if ploc.kind != .None { store_gp_val(&mut fc, pv, in_gp) }
                in_gp += 1
            } else {
                if ploc.kind != .None {
                    emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, i64(16 + in_stk * 8), 8, false)
                    store_gp_val(&mut fc, pv, a64.X16)
                }
                in_stk += 1
            }
        } else if ploc.cls == .Fp {
            if in_fp < 8 {
                if ploc.kind != .None {
                    fp_in_moves.push(ScalarMove {
                        src_is_reg: true, src_loc: in_fp,
                        dst_is_reg: ploc.kind == .Reg,
                        dst_loc: if ploc.kind == .Reg { ploc.reg_lo } else { ploc.spill_off },
                        is_f64: ploc.is_f64, done: false,
                    })
                }
                in_fp += 1
            } else {
                if ploc.kind != .None {
                    emit_ldr_fp_off(&mut fc.buf, ploc.is_f64, 16, a64.FP, i64(16 + in_stk * 8))
                    store_fp_val(&mut fc, pv, 16)
                }
                in_stk += 1
            }
        } else if ploc.cls == .Fat {
            if in_gp + 2 <= 8 {
                if ploc.kind != .None { store_fat_val(&mut fc, pv, in_gp, in_gp + 1) }
                in_gp += 2
            } else {
                in_gp = 8
                if ploc.kind != .None {
                    emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, i64(16 + in_stk * 8), 8, false)
                    emit_ldr_off(&mut fc.buf, a64.X8, a64.FP, i64(16 + (in_stk + 1) * 8), 8, false)
                    store_fat_val(&mut fc, pv, a64.X16, a64.X8)
                }
                in_stk += 2
            }
        } else if ploc.cls == .Agg {
            sz := type_size(&types, pty)
            if sz <= 8 {
                if in_gp < 8 {
                    if ploc.spill_off > 0 { emit_str_off(&mut fc.buf, in_gp, a64.FP, -i64(ploc.spill_off), 8) }
                    in_gp += 1
                } else {
                    if ploc.spill_off > 0 {
                        emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, i64(16 + in_stk * 8), 8, false)
                        emit_str_off(&mut fc.buf, a64.X16, a64.FP, -i64(ploc.spill_off), 8)
                    }
                    in_stk += 1
                }
            } else if sz <= 16 {
                if in_gp + 2 <= 8 {
                    if ploc.spill_off > 0 {
                        emit_str_off(&mut fc.buf, in_gp, a64.FP, -i64(ploc.spill_off), 8)
                        emit_str_off(&mut fc.buf, in_gp + 1, a64.FP, -i64(ploc.spill_off) + 8, 8)
                    }
                    in_gp += 2
                } else {
                    in_gp = 8
                    if ploc.spill_off > 0 {
                        emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, i64(16 + in_stk * 8), 8, false)
                        emit_str_off(&mut fc.buf, a64.X16, a64.FP, -i64(ploc.spill_off), 8)
                        emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, i64(16 + (in_stk + 1) * 8), 8, false)
                        emit_str_off(&mut fc.buf, a64.X16, a64.FP, -i64(ploc.spill_off) + 8, 8)
                    }
                    in_stk += 2
                }
            } else {
                // Indirect pointer passed in GP reg or stack
                if in_gp < 8 {
                    if ploc.spill_off > 0 {
                        if sz <= 64 {
                            emit_sub_imm_any(&mut fc.buf, a64.X8, a64.FP, i64(ploc.spill_off))
                            emit_inline_memcpy(&mut fc.buf, a64.X8, in_gp, sz)
                        } else {
                            // Stash source pointer in [FP - spill_off] until all X0..X7 params are saved!
                            emit_str_off(&mut fc.buf, in_gp, a64.FP, -i64(ploc.spill_off), 8)
                            deferred_agg_offs.push(ploc.spill_off)
                            deferred_agg_szs.push(sz)
                        }
                    }
                    in_gp += 1
                } else {
                    if ploc.spill_off > 0 {
                        emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, i64(16 + in_stk * 8), 8, false)
                        if sz <= 64 {
                            emit_sub_imm_any(&mut fc.buf, a64.X8, a64.FP, i64(ploc.spill_off))
                            emit_inline_memcpy(&mut fc.buf, a64.X8, a64.X16, sz)
                        } else {
                            emit_str_off(&mut fc.buf, a64.X16, a64.FP, -i64(ploc.spill_off), 8)
                            deferred_agg_offs.push(ploc.spill_off)
                            deferred_agg_szs.push(sz)
                        }
                    }
                    in_stk += 1
                }
            }
        }
    }
    if fp_in_moves.len > 0 {
        run_parallel_moves(&mut fc.buf, &mut fp_in_moves, true)
    }
    for di in 0..deferred_agg_offs.len {
        doff := deferred_agg_offs[di]
        dsz := deferred_agg_szs[di]
        // Inline loop using ONLY X0..X3 (never allocated!) so X9..X15 & D0..D31 incoming params are preserved!
        emit_ldr_off(&mut fc.buf, a64.X1, a64.FP, -i64(doff), 8, false)
        emit_sub_imm_any(&mut fc.buf, a64.X0, a64.FP, i64(doff))
        qwords := dsz / 8
        rem := dsz % 8
        if qwords > 0 {
            a64.imm(&mut fc.buf, a64.X2, i64(qwords))
            lbl_cp := a64.label(&mut fc.buf)
            a64.mark(&mut fc.buf, lbl_cp)
            a64.ldr(&mut fc.buf, a64.X3, a64.X1, 0, 8, false)
            a64.str(&mut fc.buf, a64.X3, a64.X0, 0, 8)
            a64.add_imm(&mut fc.buf, true, false, a64.X1, a64.X1, 8)
            a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X0, 8)
            a64.sub_imm(&mut fc.buf, true, false, a64.X2, a64.X2, 1)
            a64.cbnz(&mut fc.buf, true, a64.X2, lbl_cp)
        }
        if rem > 0 {
            emit_inline_memcpy(&mut fc.buf, a64.X0, a64.X1, rem)
        }
    }

    // 4. Load closure captures from [env + 16..] into capture slots if closure body
    mut cap_cnt := 0
    mut cap_skipped: []bool = []
    if f.is_closure_body && fc.env_off > 0 && f.sig_ty >= 0 && f.sig_ty < types.entries.len {
        cte := &types.entries[f.sig_ty]
        cap_cnt = cte.count
        mut cap_off := 16
        for ci in 0..cap_cnt {
            cap_skipped.push(false)
            loc_id := 1 + f.param_count + ci
            cty := ht.field_type(&types, f.sig_ty, ci)
            csz := align_up_i32(type_size(&types, cty), 8)
            step := if csz < 8 { 8 } else { csz }
            if loc_id < f.slots.len && !f.slots[loc_id].dead && fc.slot_offs[loc_id] > 0 {
                emit_ldr_off(&mut fc.buf, a64.X4, a64.FP, -i64(fc.env_off), 8, false)
                emit_add_imm_any(&mut fc.buf, a64.X7, a64.X4, i64(cap_off))
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.slot_offs[loc_id]))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, cty))
            }
            cap_off += step
        }
    }

    // 5. Emit Basic Blocks in RPO order (recording DWARF line checkpoints per distinct span)
    mut dbg_line_lbls: []i32 = []
    mut dbg_line_nums: []i32 = []
    mut dbg_col_nums: []i32 = []
    mut last_dbg_line := -1
    has_src := f.owner_mod >= 0 && f.owner_mod < sources.len && sources[f.owner_mod].len > 0

    rpo_len := fc.plan.rpo.len
    for ri in 0..rpo_len {
        bb := fc.plan.rpo[ri]
        next_rpo_bb := if ri + 1 < rpo_len { fc.plan.rpo[ri + 1] } else { -1 }
        a64.mark(&mut fc.buf, fc.bb_labels[bb])
        blk := f.blocks[bb]

        for ii in 0..blk.inst_len {
            ins := f.insts[f.block_insts[blk.inst_start + ii]]
            // Skip synthetic zero-init Store into closure capture slots in bb 0
            if bb == 0 && cap_cnt > 0 && ins.kind == .Store && ins.aux >= 0 {
                ci := ins.aux - (1 + f.param_count)
                if ci >= 0 && ci < cap_cnt && !cap_skipped[ci] {
                    cap_skipped[ci] = true
                    continue
                }
            }
            if ins.span_start > 0 {
                mut cur_l := 1
                mut cur_c := 1
                if has_src {
                    lc := diag.line_col(sources[f.owner_mod], ins.span_start)
                    cur_l = lc.line
                    cur_c = lc.column
                } else {
                    cur_l = 1 + ins.span_start / 32
                }
                if cur_l != last_dbg_line {
                    last_dbg_line = cur_l
                    dlbl := a64.label(&mut fc.buf)
                    a64.mark(&mut fc.buf, dlbl)
                    dbg_line_lbls.push(dlbl)
                    dbg_line_nums.push(cur_l)
                    dbg_col_nums.push(cur_c)
                }
            }
            emit_inst(&mut m, &hir, &f, &mut fc, &rt, &fn_syms, &ins)
        }

        if blk.term_id < 0 { continue }
        tm := f.terms[blk.term_id]

        if tm.kind == .Goto {
            emit_edge_copies(&mut fc, &types, &f, &rt, tm.target_a, tm.arg_start, tm.arg_len)
            if tm.target_a != next_rpo_bb {
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            }
        } else if tm.kind == .Branch {
            rc := load_gp_val(&mut fc, tm.cond_val, a64.X0)
            if tm.arg_len == 0 && tm.arg2_len == 0 {
                if tm.target_a == next_rpo_bb {
                    a64.cbz(&mut fc.buf, true, rc, fc.bb_labels[tm.target_b])
                } else if tm.target_b == next_rpo_bb {
                    a64.cbnz(&mut fc.buf, true, rc, fc.bb_labels[tm.target_a])
                } else {
                    a64.cbnz(&mut fc.buf, true, rc, fc.bb_labels[tm.target_a])
                    a64.b(&mut fc.buf, fc.bb_labels[tm.target_b])
                }
            } else {
                else_tramp := a64.label(&mut fc.buf)
                a64.cbz(&mut fc.buf, true, rc, else_tramp)
                emit_edge_copies(&mut fc, &types, &f, &rt, tm.target_a, tm.arg_start, tm.arg_len)
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
                a64.mark(&mut fc.buf, else_tramp)
                emit_edge_copies(&mut fc, &types, &f, &rt, tm.target_b, tm.arg2_start, tm.arg2_len)
                if tm.target_b != next_rpo_bb {
                    a64.b(&mut fc.buf, fc.bb_labels[tm.target_b])
                }
            }
        } else if tm.kind == .Switch {
            rv := load_gp_val(&mut fc, tm.cond_val, a64.X0)
            mut tramp_lbls: []i32 = []
            for ci in 0..tm.case_len {
                c_val := f.switch_vals[tm.case_start + ci]
                c_bb := f.switch_bbs[tm.case_start + ci]
                c_al := f.switch_arg_lens[tm.case_start + ci]
                emit_cmp_imm_any(&mut fc.buf, true, rv, c_val)
                if c_al == 0 {
                    a64.b_cond(&mut fc.buf, a64.CC_EQ, fc.bb_labels[c_bb])
                    tramp_lbls.push(-1)
                } else {
                    tl := a64.label(&mut fc.buf)
                    a64.b_cond(&mut fc.buf, a64.CC_EQ, tl)
                    tramp_lbls.push(tl)
                }
            }
            emit_edge_copies(&mut fc, &types, &f, &rt, tm.target_a, tm.arg_start, tm.arg_len)
            a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            for ci in 0..tm.case_len {
                if tramp_lbls[ci] >= 0 {
                    a64.mark(&mut fc.buf, tramp_lbls[ci])
                    c_bb := f.switch_bbs[tm.case_start + ci]
                    c_as := f.switch_arg_starts[tm.case_start + ci]
                    c_al := f.switch_arg_lens[tm.case_start + ci]
                    emit_edge_copies(&mut fc, &types, &f, &rt, c_bb, c_as, c_al)
                    a64.b(&mut fc.buf, fc.bb_labels[c_bb])
                }
            }
        } else if tm.kind == .Call || tm.kind == .IndirectCall || tm.kind == .ExternCall {
            emit_abi_call(&mut m, &hir, &f, &mut fc, &fn_syms, &tm)
            if tm.target_a >= 0 && tm.target_a != next_rpo_bb {
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            }
        } else if tm.kind == .IntrinsicCall {
            emit_intrinsic_call(&mut m, &hir, &f, &mut fc, &rt, &fn_syms, target, &tm)
            if tm.target_a >= 0 && tm.target_a != next_rpo_bb {
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            }
        } else if tm.kind == .RegionEnter {
            roff := find_region_off(&fc, tm.callee)
            if roff > 0 {
                emit_str_off(&mut fc.buf, a64.X19, a64.FP, -i64(roff), 8)
                emit_str_off(&mut fc.buf, a64.X20, a64.FP, -i64(roff) + 8, 8)
            }
            if tm.target_a >= 0 && tm.target_a != next_rpo_bb {
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            }
        } else if tm.kind == .RegionExit {
            roff := find_region_off(&fc, tm.callee)
            if roff > 0 {
                // Only rewind bump cursor x19 if slab end x20 did not grow to a new mmap slab
                emit_ldr_off(&mut fc.buf, a64.X16, a64.FP, -i64(roff) + 8, 8, false)
                a64.cmp_reg(&mut fc.buf, true, a64.X16, a64.X20)
                lbl_skip := a64.label(&mut fc.buf)
                a64.b_cond(&mut fc.buf, a64.CC_NE, lbl_skip)
                emit_ldr_off(&mut fc.buf, a64.X19, a64.FP, -i64(roff), 8, false)
                a64.mark(&mut fc.buf, lbl_skip)
            }
            if tm.target_a >= 0 && tm.target_a != next_rpo_bb {
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            }
        } else if tm.kind == .TaskScopeEnter {
            if tm.cond_val >= 0 {
                if has_spawns {
                    // Allocate 32-byte ScopeHdr: [0]=task_head, [8]=cap, [16]=shared_val, [24]=has_shared
                    a64.imm(&mut fc.buf, a64.X0, 32)
                    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
                    a64.str(&mut fc.buf, a64.XZR, a64.X0, 0, 8)
                    a64.str(&mut fc.buf, a64.XZR, a64.X0, 8, 8)
                    a64.str(&mut fc.buf, a64.XZR, a64.X0, 16, 8)
                    a64.str(&mut fc.buf, a64.XZR, a64.X0, 24, 8)
                    a64.mov(&mut fc.buf, a64.X4, a64.X0)
                    // Store ScopeHdr pointer in [handle_slot + 0]
                    load_gp_into(&mut fc, tm.cond_val, a64.X5)
                    a64.str(&mut fc.buf, a64.X4, a64.X5, 0, 8)
                    // Populate optional cap (arg 0) & shared value (arg 2)
                    if tm.arg_len >= 1 {
                        cap_v := f.val_args[tm.arg_start]
                        if cap_v >= 0 {
                            load_gp_into(&mut fc, cap_v, a64.X6)
                            load_gp_into(&mut fc, tm.cond_val, a64.X5)
                            a64.ldr(&mut fc.buf, a64.X4, a64.X5, 0, 8, false)
                            a64.str(&mut fc.buf, a64.X6, a64.X4, 8, 8)
                        }
                    }
                    if tm.arg_len >= 3 {
                        sh_v := f.val_args[tm.arg_start + 2]
                        if sh_v >= 0 {
                            sh_cls := fc.plan.locs[sh_v].cls
                            if sh_cls == .Gp {
                                load_gp_into(&mut fc, sh_v, a64.X6)
                            } else if sh_cls == .Agg {
                                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[sh_v].spill_off))
                            } else {
                                a64.imm(&mut fc.buf, a64.X6, 0)
                            }
                            load_gp_into(&mut fc, tm.cond_val, a64.X5)
                            a64.ldr(&mut fc.buf, a64.X4, a64.X5, 0, 8, false)
                            a64.str(&mut fc.buf, a64.X6, a64.X4, 16, 8)
                            a64.imm(&mut fc.buf, a64.X7, 1)
                            a64.str(&mut fc.buf, a64.X7, a64.X4, 24, 8)
                        }
                    }
                } else {
                    load_gp_into(&mut fc, tm.cond_val, a64.X0)
                    a64.str(&mut fc.buf, a64.XZR, a64.X0, 0, 8)
                }
            }
            if tm.target_a >= 0 && tm.target_a != next_rpo_bb {
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            }
        } else if tm.kind == .TaskScopeJoin {
            if has_spawns && tm.cond_val >= 0 {
                // Auto-join any unjoined TaskNodes linked off ScopeHdr[0]
                load_gp_into(&mut fc, tm.cond_val, a64.X4)
                a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false) // scope_hdr
                lbl_sj_done := a64.label(&mut fc.buf)
                a64.cbz(&mut fc.buf, true, a64.X4, lbl_sj_done)
                a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false) // head node
                lbl_sj_loop := a64.label(&mut fc.buf)
                lbl_sj_next := a64.label(&mut fc.buf)
                a64.mark(&mut fc.buf, lbl_sj_loop)
                a64.cbz(&mut fc.buf, true, a64.X4, lbl_sj_done)
                a64.ldr(&mut fc.buf, a64.X5, a64.X4, 8, 8, false) // joined?
                a64.cbnz(&mut fc.buf, true, a64.X5, lbl_sj_next)
                a64.imm(&mut fc.buf, a64.X5, 1)
                a64.str(&mut fc.buf, a64.X5, a64.X4, 8, 8)
                a64.stp_pre(&mut fc.buf, a64.X4, a64.XZR, a64.SP, -16)
                a64.ldr(&mut fc.buf, a64.X0, a64.X4, 0, 8, false) // pthread_t
                a64.imm(&mut fc.buf, a64.X1, 0)
                p_lib := if target == .Arm64Macos { "c" } else { "pthread" }
                imp_pj := obj.add_import(&mut m, &native_imports.symbol_spec(p_lib, "pthread_join"))
                lbl_pj := a64.label(&mut fc.buf)
                a64.mark(&mut fc.buf, lbl_pj)
                a64.nop(&mut fc.buf)
                a64.nop(&mut fc.buf)
                fc.imp_sites.push(PendingImport { site_lbl: lbl_pj, imp_id: imp_pj })
                a64.blr(&mut fc.buf, a64.X16)
                a64.ldp_post(&mut fc.buf, a64.X4, a64.X5, a64.SP, 16)
                a64.mark(&mut fc.buf, lbl_sj_next)
                a64.ldr(&mut fc.buf, a64.X4, a64.X4, 80, 8, false) // node.next
                a64.b(&mut fc.buf, lbl_sj_loop)
                a64.mark(&mut fc.buf, lbl_sj_done)
            }
            if tm.target_a >= 0 && tm.target_a != next_rpo_bb {
                a64.b(&mut fc.buf, fc.bb_labels[tm.target_a])
            }
        } else if tm.kind == .Return {
            emit_closure_writeback(&mut fc, &types, &f, &rt)
            if tm.cond_val >= 0 && ret_cls != .Void {
                if ret_cls == .Gp {
                    load_gp_into(&mut fc, tm.cond_val, a64.X0)
                } else if ret_cls == .Fp {
                    load_fp_into(&mut fc, tm.cond_val, 0)
                } else if ret_cls == .Fat {
                    load_fat_into(&mut fc, tm.cond_val, a64.X0, a64.X1)
                } else if ret_cls == .Agg {
                    voff := fc.plan.locs[tm.cond_val].spill_off
                    if ret_sz <= 8 {
                        emit_ldr_off(&mut fc.buf, a64.X0, a64.FP, -i64(voff), 8, false)
                    } else if ret_sz <= 16 {
                        emit_ldr_off(&mut fc.buf, a64.X0, a64.FP, -i64(voff), 8, false)
                        emit_ldr_off(&mut fc.buf, a64.X1, a64.FP, -i64(voff) + 8, 8, false)
                    } else if fc.sret_off > 0 {
                        emit_ldr_off(&mut fc.buf, a64.X6, a64.FP, -i64(fc.sret_off), 8, false)
                        emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(voff))
                        emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, ret_sz)
                    }
                }
            }
            a64.b(&mut fc.buf, fc.epilogue_lbl)
        } else if tm.kind == .Trap {
            code := if tm.callee > 0 { tm.callee } else { hb.TRAP_UNREACHABLE }
            a64.imm(&mut fc.buf, a64.X0, i64(code))
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)
        }
    }

    // 6. Trap landing pads
    a64.mark(&mut fc.buf, fc.trap_101)
    a64.imm(&mut fc.buf, a64.X0, i64(hb.TRAP_OVERFLOW))
    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)

    a64.mark(&mut fc.buf, fc.trap_102)
    a64.imm(&mut fc.buf, a64.X0, i64(hb.TRAP_DIV_ZERO))
    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)

    a64.mark(&mut fc.buf, fc.trap_103)
    a64.imm(&mut fc.buf, a64.X0, i64(hb.TRAP_BOUNDS))
    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)

    a64.mark(&mut fc.buf, fc.trap_104)
    a64.imm(&mut fc.buf, a64.X0, i64(hb.TRAP_ASSERT))
    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)

    a64.mark(&mut fc.buf, fc.trap_105)
    a64.imm(&mut fc.buf, a64.X0, i64(hb.TRAP_PANIC))
    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)

    a64.mark(&mut fc.buf, fc.trap_106)
    a64.imm(&mut fc.buf, a64.X0, i64(hb.TRAP_UNREACHABLE))
    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.trap)

    // 7. Epilogue
    a64.mark(&mut fc.buf, fc.epilogue_lbl)
    for i in 0..fc.plan.used_callee_fp.len {
        emit_ldr_fp_off(&mut fc.buf, true, fc.plan.used_callee_fp[i], a64.FP, -i64(fc.callee_fp_offs[i]))
    }
    for i in 0..fc.plan.used_callee_gp.len {
        emit_ldr_off(&mut fc.buf, fc.plan.used_callee_gp[i], a64.FP, -i64(fc.callee_gp_offs[i]), 8, false)
    }
    a64.mov(&mut fc.buf, a64.SP, a64.FP)
    a64.ldp_post(&mut fc.buf, a64.FP, a64.LR, a64.SP, 16)
    a64.ret(&mut fc.buf)

    // 8. Finalize ArmBuf -> append to ObjectModule & patch pre-registered function symbol offset/size!
    code := a64.finish_at_offset(&mut fc.buf, 0)
    start := obj.append_text(&mut m, &code, 4)
    sym_id := fn_syms[f.fn_id]
    m.symbols[sym_id].offset = start
    m.symbols[sym_id].size = code.len
    for i in 0..fc.relocs.len {
        r := fc.relocs[i]
        off := start + a64.label_word(&fc.buf, r.site_lbl) * 4
        _ := obj.add_reloc(&mut m, .Text, off, r.kind, r.sym_id, r.addend, r.reg)
    }
    for i in 0..fc.imp_sites.len {
        p := fc.imp_sites[i]
        off := start + a64.label_word(&fc.buf, p.site_lbl) * 4
        obj.add_import_site(&mut m, p.imp_id, off)
    }
    for i in 0..fc.gsites.len {
        g := fc.gsites[i]
        off := start + a64.label_word(&fc.buf, g.site_lbl) * 4
        obj.add_global_site(&mut m, off, g.bss_off)
    }

    // 9. Record DWARF function range & line table entries
    f_path := if f.path != "" { f.path.clone() } else { "main.ddr" }
    fidx_dbg := obj.add_debug_file(&mut m, f_path)
    mut fn_line := 1
    if f.fn_id >= 0 && f.fn_id < hir.fns.len && has_src && hir.fns[f.fn_id].span_start > 0 {
        fn_line = diag.line_col(sources[f.owner_mod], hir.fns[f.fn_id].span_start).line
    } else if dbg_line_nums.len > 0 {
        fn_line = dbg_line_nums[0]
    }
    obj.add_func_range(&mut m, f.name.clone(), fidx_dbg, fn_line, start, start + code.len)
    if dbg_line_lbls.len == 0 {
        obj.add_debug_line(&mut m, start, fidx_dbg, fn_line, 1)
    } else {
        for li in 0..dbg_line_lbls.len {
            off := start + a64.label_word(&fc.buf, dbg_line_lbls[li]) * 4
            obj.add_debug_line(&mut m, off, fidx_dbg, dbg_line_nums[li], dbg_col_nums[li])
        }
    }
}

// =========================================================================
// 10. Top-Level Entry Points: emit_program & emit_executable
// =========================================================================

pub fn emit_program(prog: &ssa.SsaProgram, hir: &hb.HirProgram, target: obj.TargetKind) -> obj.ObjectModule {
    empty_src: []string = []
    emit_program_with_sources(&prog, &hir, target, &empty_src)
}

fn program_uses_cli_args(prog: &ssa.SsaProgram) -> bool {
    for i in 0..prog.funcs.len {
        sf := &prog.funcs[i]
        for ti in 0..sf.terms.len {
            tm := sf.terms[ti]
            if tm.kind == .IntrinsicCall &&
                (tm.callee == hb.INTRINSIC_SYS_ARG_COUNT || tm.callee == hb.INTRINSIC_SYS_ARG || tm.callee == hb.INTRINSIC_SYS_ENVP) {
                return true
            }
        }
    }
    false
}

pub fn emit_program_with_sources(prog: &ssa.SsaProgram, hir: &hb.HirProgram,
    target: obj.TargetKind, sources: &[]string) -> obj.ObjectModule {
    assert(target == .Arm64Macos || target == .Arm64Linux)
    mut m := obj.new(target)

    // Pre-register placeholder symbols for all SSA functions so forward/recursive calls resolve cleanly
    mut max_fid := prog.fn_id_to_idx.len
    for i in 0..prog.funcs.len {
        if prog.funcs[i].fn_id + 1 > max_fid { max_fid = prog.funcs[i].fn_id + 1 }
    }
    mut fn_syms: []i32 = []
    for _ in 0..max_fid { fn_syms.push(-1) }
    for i in 0..prog.funcs.len {
        sf := &prog.funcs[i]
        if sf.fn_id >= 0 {
            fn_syms[sf.fn_id] = obj.add_symbol(&mut m, sf.name.clone(), .Function, .Text, 0, 0, sf.fn_id == prog.entry_fn)
        }
    }

    // Reserve 24B .bss [argc, argv, envp] only when the program reads CLI args / envp
    mut bss_args_off := -1
    if program_uses_cli_args(&prog) {
        bss_args_off = obj.reserve_bss(&mut m, 24, 8)
    }

    // 1. Emit `_start` at byte offset 0 of .text (required entry point for Mach-O LC_MAIN and ELF e_entry)
    mut b_start := a64.new()
    mut r_start: []PendingReloc = []
    mut g_start: []PendingGlobal = []
    empty_imp: []PendingImport = []
    if bss_args_off >= 0 {
        if target == .Arm64Macos {
            // LC_MAIN passes argc in x0, argv in x1, envp in x2
            emit_global_addr(&mut b_start, &mut g_start, bss_args_off)
            a64.str(&mut b_start, a64.X0, a64.X16, 0, 8)
            a64.str(&mut b_start, a64.X1, a64.X16, 8, 8)
            a64.str(&mut b_start, a64.X2, a64.X16, 16, 8)
        } else {
            // Linux ELF e_entry: [sp+0] = argc, sp+8 = argv, sp+16+argc*8 = envp
            a64.ldr(&mut b_start, a64.X0, a64.SP, 0, 8, false)
            a64.add_imm(&mut b_start, true, false, a64.X1, a64.SP, 8)
            a64.add_imm(&mut b_start, true, false, a64.X2, a64.X0, 2)
            a64.lsl_imm(&mut b_start, true, a64.X2, a64.X2, 3)
            a64.add_reg(&mut b_start, true, false, a64.X2, a64.SP, a64.X2)
            emit_global_addr(&mut b_start, &mut g_start, bss_args_off)
            a64.str(&mut b_start, a64.X0, a64.X16, 0, 8)
            a64.str(&mut b_start, a64.X1, a64.X16, 8, 8)
            a64.str(&mut b_start, a64.X2, a64.X16, 16, 8)
        }
    }
    // Initialize reserved per-thread bump arena registers x19, x20, x21 = 0
    a64.imm(&mut b_start, a64.X19, 0)
    a64.imm(&mut b_start, a64.X20, 0)
    a64.imm(&mut b_start, a64.X21, 0)

    mut entry_returns_int := false
    if prog.entry_fn >= 0 && prog.entry_fn < fn_syms.len && fn_syms[prog.entry_fn] >= 0 {
        e_idx := prog.fn_id_to_idx[prog.entry_fn]
        if e_idx >= 0 && e_idx < prog.funcs.len {
            entry_returns_int = ssa.is_int_ty(&hir.types, prog.funcs[e_idx].ret_ty)
        }
        emit_call_sym(&mut b_start, &mut r_start, fn_syms[prog.entry_fn])
    }
    if !entry_returns_int {
        a64.imm(&mut b_start, a64.X0, 0)
    }
    emit_syscall(&mut b_start, target, 33554433, 94) // exit / exit_group
    a64.brk(&mut b_start, 0)
    start_sym := flush_buf_to_module_g(&mut m, &mut b_start, &r_start, &empty_imp, &g_start, "_start", true)
    m.entry_sym = start_sym

    // 2. Emit self-contained native runtime stubs (bump allocator, print, strings, arrays, maps, format, sys, traps)
    rt := emit_runtime_stubs(&mut m, target, bss_args_off)

    // 3. Emit every SSA function into ObjectModule
    for i in 0..prog.funcs.len {
        sf := &prog.funcs[i]
        if sf.is_extern || sf.blocks.len == 0 { continue }
        emit_function(&mut m, &hir, &sf, &rt, &fn_syms, target, &sources)
    }

    m
}

pub fn emit_executable(prog: &ssa.SsaProgram, hir: &hb.HirProgram, target: obj.TargetKind) -> []u8 {
    m := emit_program(&prog, &hir, target)
    if target == .Arm64Macos {
        cfg := macho.default_config()
        signer := macho.serial_signer()
        return obj.emit_macho(&m, &cfg, &signer, false, "dunder-arm64-isel", ".", "main.ddr")
    }
    ecfg := elf.default_config()
    obj.emit_elf(&m, &ecfg, false, "dunder-arm64-isel", ".", "main.ddr")
}

pub fn emit_executable_debug(prog: &ssa.SsaProgram, hir: &hb.HirProgram, target: obj.TargetKind,
    sources: &[]string, main_file: string) -> []u8 {
    m := emit_program_with_sources(&prog, &hir, target, &sources)
    if target == .Arm64Macos {
        cfg := macho.default_config()
        signer := macho.serial_signer()
        return obj.emit_macho(&m, &cfg, &signer, true, "dunder-arm64-isel", ".", main_file)
    }
    ecfg := elf.default_config()
    obj.emit_elf(&m, &ecfg, true, "dunder-arm64-isel", ".", main_file)
}
