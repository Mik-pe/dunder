// Phase 4A: Native ARM64 LIR/ISel + Linear-Scan Register Allocator (`selfhost/backend/arm64_isel.ddr`).
// Direct lowering: `selfhost/ssa/ssa_ir` -> `selfhost/backend/arm64_enc` -> `selfhost/backend/object_module`.
// ZERO imports of `compile.ddr`, `selfhost/mir/*`, `selfhost/mir2/*`, or legacy `arm64.ddr`.
//
// Register Discipline (Native ARM64 AAPCS64 + Per-Thread Arena Reservation):
// - Reserved per-thread arena regs (NEVER allocated/clobbered): x19 (cursor), x20 (end), x21 (slab root)
// - Platform reserved: x18 (Darwin), x29 (FP), x30 (LR), sp/xzr (31)
// - Allocatable GP callee-saved: x22..x28 (7 regs, live across calls)
// - Allocatable GP caller-saved: x9..x15 (7 regs, non-call-crossing intervals)
// - Allocatable FP callee-saved: d8..d15 (8 regs, live across calls)
// - Allocatable FP caller-saved: d0..d7 (8 regs, non-call-crossing intervals)
// - Scratch/ABI regs (never allocated to live intervals): x0..x8, x16, x17; FP scratch: d16, d17
//
// Calling Convention:
// - Scalars: x0..x7 (overflow on stack), return in x0
// - Floats (f32/f64): d0..d7 (overflow on stack), return in d0
// - First-class 2-word FatStr/FatSlice/RegionSlice: 2 GP regs (ptr, len), return in (x0, x1)
// - Inline aggregates <= 16B: 1-2 GP regs, return in x0 / (x0, x1); > 16B: ptr arg & indirect sret in x8
// - Closures: env_ptr passed in x9 (loaded right before blr x16, saved at top of closure prologue)

import std.bytes as bytes
import ..frontend.diagnostics as diag
import ..hir.hir_types as ht
import ..hir.hir_body as hb
import ..ssa.ssa_ir as ssa
import arm64_enc as a64
import object_module as obj
import imports as native_imports
import macho
import elf

// =========================================================================
// 1. Value Classification & Register Allocation Plan
// =========================================================================

pub enum ValClass {
    Void,
    Gp,     // single GP reg (scalars, bool, ptr, refs, String, Array, FnPtr, ClosureEnv, small enum <= 4B)
    Fp,     // single FP reg (f32 / f64)
    Fat,    // 2-word GP pair (ptr, len) for FatStr / FatSlice / RegionSlice
    Agg,    // memory-backed stack home (Struct, Tuple, Union, FixedArr, Range, payload Enum > 4B)
}

pub enum LocKind {
    None,
    Reg,    // GP reg (or FP reg for ValClass.Fp); Fat uses (reg_lo, reg_hi)
    Spill,  // negative byte offset from FP: [fp - spill_off]
    AggHome,// negative byte offset from FP: [fp - spill_off] of agg size bytes
}

pub struct ValLoc {
    cls: ValClass,
    kind: LocKind,
    reg_lo: i32,
    reg_hi: i32,
    spill_off: i32, // positive magnitude -> stored at [fp - spill_off]
    is_f64: bool,
}

pub struct RegAllocPlan {
    rpo: []i32,
    locs: []ValLoc,
    used_callee_gp: []i32,
    used_callee_fp: []i32,
    spill_count: i32,
    live_starts: []i32,
    live_ends: []i32,
    crosses_call: []bool,
}

pub fn classify_type(types: &ht.TypeTable, ty: i32) -> ValClass {
    if ty < 0 || ty >= types.entries.len { return .Void }
    te := &types.entries[ty]
    k := te.kind
    if k == .Unit || k == .Error || te.size == 0 { return .Void }
    if k == .F32 || k == .F64 { return .Fp }
    if k == .FatStr || k == .FatSlice || k == .RegionSlice { return .Fat }
    if k == .Bool || k == .I8 || k == .I16 || k == .I32 || k == .I64 || k == .Isize ||
        k == .U8 || k == .U16 || k == .U32 || k == .U64 || k == .Usize ||
        k == .Rune || k == .Ptr || k == .String || k == .Array || k == .CStr || k == .WStr ||
        k == .Ref || k == .MutRef || k == .RawConst || k == .RawMut ||
        k == .FnPtr || k == .ExternFn || k == .ClosureEnv || k == .Task {
        return .Gp
    }
    if k == .Enum && te.size <= 4 { return .Gp }
    .Agg
}

fn type_size(types: &ht.TypeTable, ty: i32) -> i32 {
    if ty < 0 || ty >= types.entries.len { return 0 }
    types.entries[ty].size
}

fn type_align(types: &ht.TypeTable, ty: i32) -> i32 {
    if ty < 0 || ty >= types.entries.len { return 1 }
    al := types.entries[ty].align
    if al < 1 { 1 } else { al }
}

fn align_up_i32(v: i32, al: i32) -> i32 {
    if al <= 1 { return v }
    rem := v % al
    if rem == 0 { v } else { v + (al - rem) }
}

fn is_signed_int_ty(types: &ht.TypeTable, ty: i32) -> bool {
    if ty < 0 || ty >= types.entries.len { return false }
    k := types.entries[ty].kind
    k == .I8 || k == .I16 || k == .I32 || k == .I64 || k == .Isize
}

fn is_f64_ty(types: &ht.TypeTable, ty: i32) -> bool {
    ty >= 0 && ty < types.entries.len && types.entries[ty].kind == .F64
}

fn enum_payload_offset(types: &ht.TypeTable, enum_ty: i32, var_idx: i32, field_idx: i32) -> i32 {
    te := &types.entries[enum_ty]
    al := if te.align > 0 { te.align } else { 4 }
    tag_aligned := align_up_i32(4, al)
    v := &types.variants[te.inner_a + var_idx]
    f := &types.fields[v.payload_start + field_idx]
    tag_aligned + f.offset
}

fn inst_clobbers_caller_saved(types: &ht.TypeTable, ins: &ssa.SsaInst) -> bool {
    k := ins.kind
    if k == .AllocHeap || k == .ClosureMake { return true }
    if (k == .MemCopy || k == .MemZero) && ins.imm_i64 > 64 { return true }
    if k == .Binary && ins.op_a >= 0 {
        // String and FatStr binary ops call runtime concat/eq/cmp helpers
        // Checked via operand type by caller; here check ins.ty or aux
        if ins.ty == ht.TY_STRING { return true }
    }
    _ := types.sealed
    false
}

fn inst_actually_clobbers(types: &ht.TypeTable, f: &ssa.SsaFunc, ins: &ssa.SsaInst) -> bool {
    if inst_clobbers_caller_saved(&types, &ins) { return true }
    if ins.kind == .Binary && ins.op_a >= 0 && ins.op_a < f.vals.len {
        aty := f.vals[ins.op_a].ty
        if aty >= 0 && aty < types.entries.len {
            ak := types.entries[aty].kind
            if ak == .String || ak == .FatStr { return true }
        }
    }
    false
}

fn term_clobbers_caller_saved(kind: ssa.SsaTermKind) -> bool {
    kind == .Call || kind == .IndirectCall || kind == .ExternCall || kind == .IntrinsicCall ||
    kind == .TaskScopeEnter || kind == .TaskScopeJoin
}

// =========================================================================
// 2. Bitset Helpers & Backward CFG Liveness + Linear-Scan RegAlloc
// =========================================================================

fn bs_set(bits: &mut []u64, base: i32, idx: i32) {
    if idx < 0 { return }
    w := idx / 64
    b := idx % 64
    bits[base + w] = bits[base + w].bit_or(u64(1).shl(b))
}

fn bs_clear(bits: &mut []u64, base: i32, idx: i32) {
    if idx < 0 { return }
    w := idx / 64
    b := idx % 64
    bits[base + w] = bits[base + w].bit_and(u64(1).shl(b).bit_not())
}

fn bs_test(bits: &[]u64, base: i32, idx: i32) -> bool {
    if idx < 0 { return false }
    w := idx / 64
    b := idx % 64
    bits[base + w].bit_and(u64(1).shl(b)) != 0
}

fn record_inst_uses(f: &ssa.SsaFunc, ins: &ssa.SsaInst, bits: &mut []u64, base: i32) {
    if ins.op_a >= 0 { bs_set(&mut bits, base, ins.op_a) }
    if ins.op_b >= 0 { bs_set(&mut bits, base, ins.op_b) }
    if ins.op_c >= 0 { bs_set(&mut bits, base, ins.op_c) }
    if ins.kind == .ClosureMake {
        for ci in 0..ins.arg_len {
            bs_set(&mut bits, base, f.val_args[ins.arg_start + ci])
        }
    }
}

fn record_term_uses(f: &ssa.SsaFunc, tm: &ssa.SsaTerm, bits: &mut []u64, base: i32) {
    if tm.cond_val >= 0 { bs_set(&mut bits, base, tm.cond_val) }
    if tm.env_val >= 0 { bs_set(&mut bits, base, tm.env_val) }
    for ai in 0..tm.arg_len {
        v := f.val_args[tm.arg_start + ai]
        if v >= 0 { bs_set(&mut bits, base, v) }
    }
    for ai in 0..tm.arg2_len {
        v := f.val_args[tm.arg2_start + ai]
        if v >= 0 { bs_set(&mut bits, base, v) }
    }
    if tm.kind == .Switch {
        for ci in 0..tm.case_len {
            as0 := f.switch_arg_starts[tm.case_start + ci]
            al0 := f.switch_arg_lens[tm.case_start + ci]
            for ai in 0..al0 {
                v := f.val_args[as0 + ai]
                if v >= 0 { bs_set(&mut bits, base, v) }
            }
        }
    }
}

fn extend_use(starts: &mut []i32, ends: &mut []i32, v: i32, pt: i32) {
    if v < 0 || v >= ends.len { return }
    if starts[v] < 0 || pt < starts[v] { starts[v] = pt }
    if pt > ends[v] { ends[v] = pt }
}

fn push_unique_i32(arr: &mut []i32, v: i32) {
    for i in 0..arr.len {
        if arr[i] == v { return }
    }
    arr.push(v)
}

pub fn allocate_registers(types: &ht.TypeTable, f: &ssa.SsaFunc) -> RegAllocPlan {
    n_bbs := f.blocks.len
    n_vals := f.vals.len
    dom := ssa.compute_doms(&f)
    mut rpo: []i32 = []
    if dom.rpo_order.len > 0 {
        for i in 0..dom.rpo_order.len { rpo.push(dom.rpo_order[i]) }
    } else {
        for b in 0..n_bbs { rpo.push(b) }
    }

    // 1. Assign linear program points in RPO order & collect call clobber points
    mut bb_start: []i32 = []
    mut bb_end: []i32 = []
    for _ in 0..n_bbs { bb_start.push(-1); bb_end.push(-1) }
    mut call_pts: []i32 = []
    mut cur_pt := 0
    for ri in 0..rpo.len {
        bb := rpo[ri]
        bb_start[bb] = cur_pt
        cur_pt += 2 // entry / block params at bb_start[bb]
        blk := f.blocks[bb]
        for pi in 0..blk.inst_len {
            iid := f.block_insts[blk.inst_start + pi]
            if inst_actually_clobbers(&types, &f, &f.insts[iid]) {
                call_pts.push(cur_pt + 1)
            }
            cur_pt += 2
        }
        if blk.term_id >= 0 && term_clobbers_caller_saved(f.terms[blk.term_id].kind) {
            call_pts.push(cur_pt + 1)
        }
        bb_end[bb] = cur_pt + 1
        cur_pt += 2
    }

    // 2. Backward dataflow liveness (bitset per block)
    words := (n_vals + 63) / 64
    mut w_sz := if words < 1 { 1 } else { words }
    mut live_in: []u64 = []
    mut live_out: []u64 = []
    live_in.reserve(n_bbs * w_sz)
    live_out.reserve(n_bbs * w_sz)
    for _ in 0..(n_bbs * w_sz) {
        live_in.push(u64(0))
        live_out.push(u64(0))
    }

    mut tmp_live: []u64 = []
    for _ in 0..w_sz { tmp_live.push(u64(0)) }
    mut succs: []i32 = []

    mut changed := true
    mut iters := 0
    while changed && iters < 64 {
        changed = false
        iters += 1
        mut ri := rpo.len - 1
        while ri >= 0 {
            bb := rpo[ri]
            blk := f.blocks[bb]
            for w in 0..w_sz { tmp_live[w] = u64(0) }

            // Union live_in[s] \ block_params(s) over all successors s
            ssa.term_succs(&f, bb, &mut succs)
            for si in 0..succs.len {
                s := succs[si]
                if s < 0 || s >= n_bbs { continue }
                s_base := s * w_sz
                // Copy live_in[s], clearing s's own block params
                for w in 0..w_sz {
                    mut mask := live_in[s_base + w]
                    // Clear any block param of s in this word
                    sp_s := f.blocks[s].params_start
                    sp_n := f.blocks[s].params_len
                    for pi in 0..sp_n {
                        pv := f.block_params[sp_s + pi]
                        if pv >= 0 && pv / 64 == w {
                            mask = mask.bit_and(u64(1).shl(pv % 64).bit_not())
                        }
                    }
                    tmp_live[w] = tmp_live[w].bit_or(mask)
                }
            }

            // Record live_out[bb] (values live across outgoing edges, excluding edge args not live-through)
            b_base := bb * w_sz
            for w in 0..w_sz {
                if live_out[b_base + w] != tmp_live[w] {
                    live_out[b_base + w] = tmp_live[w]
                    changed = true
                }
            }

            // Walk terminator backwards: kill dest_val, gen terminator uses & edge args
            if blk.term_id >= 0 {
                tm := f.terms[blk.term_id]
                if tm.dest_val >= 0 { bs_clear(&mut tmp_live, 0, tm.dest_val) }
                record_term_uses(&f, &tm, &mut tmp_live, 0)
            }

            // Walk instructions backwards: kill def, gen uses
            mut idx := blk.inst_len - 1
            while idx >= 0 {
                ins := f.insts[f.block_insts[blk.inst_start + idx]]
                if ins.res >= 0 { bs_clear(&mut tmp_live, 0, ins.res) }
                record_inst_uses(&f, &ins, &mut tmp_live, 0)
                idx -= 1
            }

            for w in 0..w_sz {
                if live_in[b_base + w] != tmp_live[w] {
                    live_in[b_base + w] = tmp_live[w]
                    changed = true
                }
            }
            ri -= 1
        }
    }

    // 3. Build conservative linear intervals [live_starts[v], live_ends[v]]
    mut starts: []i32 = []
    mut ends: []i32 = []
    mut classes: []ValClass = []
    for v in 0..n_vals {
        starts.push(-1)
        ends.push(-1)
        classes.push(classify_type(&types, f.vals[v].ty))
    }

    // Entry function params defined at point 0
    for pi in 0..f.param_vals.len {
        pv := f.param_vals[pi]
        if pv >= 0 && pv < n_vals {
            starts[pv] = 0
            ends[pv] = 0
        }
    }

    for ri in 0..rpo.len {
        bb := rpo[ri]
        blk := f.blocks[bb]
        bs := bb_start[bb]
        be := bb_end[bb]

        // Block params defined at bs
        for pi in 0..blk.params_len {
            pv := f.block_params[blk.params_start + pi]
            if pv >= 0 && pv < n_vals {
                extend_use(&mut starts, &mut ends, pv, bs)
            }
        }

        // Values live_in / live_out of this block
        b_base := bb * w_sz
        for v in 0..n_vals {
            if bs_test(&live_out, b_base, v) {
                extend_use(&mut starts, &mut ends, v, be)
                if bs_test(&live_in, b_base, v) {
                    extend_use(&mut starts, &mut ends, v, bs)
                }
            } else if bs_test(&live_in, b_base, v) {
                extend_use(&mut starts, &mut ends, v, bs)
            }
        }

        // Instruction defs and uses
        for ii in 0..blk.inst_len {
            use_pt := bs + 2 + ii * 2
            def_pt := use_pt + 1
            ins := f.insts[f.block_insts[blk.inst_start + ii]]
            if ins.op_a >= 0 { extend_use(&mut starts, &mut ends, ins.op_a, use_pt) }
            if ins.op_b >= 0 { extend_use(&mut starts, &mut ends, ins.op_b, use_pt) }
            if ins.op_c >= 0 { extend_use(&mut starts, &mut ends, ins.op_c, use_pt) }
            if ins.kind == .ClosureMake {
                for ci in 0..ins.arg_len {
                    extend_use(&mut starts, &mut ends, f.val_args[ins.arg_start + ci], use_pt)
                }
            }
            if ins.res >= 0 { extend_use(&mut starts, &mut ends, ins.res, def_pt) }
        }

        // Terminator uses and call result def
        if blk.term_id >= 0 {
            tm := f.terms[blk.term_id]
            t_use := be - 1
            if tm.cond_val >= 0 { extend_use(&mut starts, &mut ends, tm.cond_val, t_use) }
            if tm.env_val >= 0 { extend_use(&mut starts, &mut ends, tm.env_val, t_use) }
            for ai in 0..tm.arg_len {
                v := f.val_args[tm.arg_start + ai]
                if v >= 0 { extend_use(&mut starts, &mut ends, v, t_use) }
            }
            for ai in 0..tm.arg2_len {
                v := f.val_args[tm.arg2_start + ai]
                if v >= 0 { extend_use(&mut starts, &mut ends, v, t_use) }
            }
            if tm.kind == .Switch {
                for ci in 0..tm.case_len {
                    as0 := f.switch_arg_starts[tm.case_start + ci]
                    al0 := f.switch_arg_lens[tm.case_start + ci]
                    for ai in 0..al0 {
                        v := f.val_args[as0 + ai]
                        if v >= 0 { extend_use(&mut starts, &mut ends, v, t_use) }
                    }
                }
            }
            if tm.dest_val >= 0 { extend_use(&mut starts, &mut ends, tm.dest_val, be) }
        }
    }

    // 4. Determine which values cross any call site
    mut crosses: []bool = []
    for v in 0..n_vals {
        mut cc := false
        if starts[v] >= 0 && ends[v] > starts[v] {
            for ci in 0..call_pts.len {
                cp := call_pts[ci]
                if starts[v] < cp && cp < ends[v] {
                    cc = true
                    break
                }
            }
        }
        crosses.push(cc)
    }

    // 5. Initialize ValLoc array
    mut locs: []ValLoc = []
    for v in 0..n_vals {
        cls := classes[v]
        locs.push(ValLoc {
            cls: cls,
            kind: if cls == .Agg { .AggHome } else { .None },
            reg_lo: -1,
            reg_hi: -1,
            spill_off: 0,
            is_f64: is_f64_ty(&types, f.vals[v].ty),
        })
    }

    // 6. Linear-scan allocation over GP/Fat intervals and FP intervals
    // Collect active candidate value IDs sorted by start[v] ascending
    mut gp_order: []i32 = []
    mut fp_order: []i32 = []
    for v in 0..n_vals {
        if starts[v] < 0 { continue }
        c := classes[v]
        if c == .Gp || c == .Fat { gp_order.push(v) }
        else if c == .Fp { fp_order.push(v) }
    }
    // Insertion sort by starts[v]
    for i in 1..gp_order.len {
        key := gp_order[i]
        mut j := i - 1
        while j >= 0 && starts[gp_order[j]] > starts[key] {
            gp_order[j + 1] = gp_order[j]
            j -= 1
        }
        gp_order[j + 1] = key
    }
    for i in 1..fp_order.len {
        key := fp_order[i]
        mut j := i - 1
        while j >= 0 && starts[fp_order[j]] > starts[key] {
            fp_order[j + 1] = fp_order[j]
            j -= 1
        }
        fp_order[j + 1] = key
    }

    // GP physical register pools:
    // Caller-saved: x9..x15 (7 regs); Callee-saved: x22..x28 (7 regs)
    // x19, x20, x21 are strictly RESERVED for per-thread arena!
    gp_caller: [i32; 7] = [a64.X9, a64.X10, a64.X11, a64.X12, a64.X13, a64.X14, a64.X15]
    gp_callee: [i32; 7] = [a64.X22, a64.X23, a64.X24, a64.X25, a64.X26, a64.X27, a64.X28]
    mut gp_in_use: []bool = []
    for _ in 0..32 { gp_in_use.push(false) }

    mut active_gp: []i32 = []
    mut used_callee_gp: []i32 = []
    mut spill_count := 0

    for oi in 0..gp_order.len {
        v := gp_order[oi]
        st := starts[v]
        // Expire old intervals with ends[u] < st
        mut wi := 0
        for ai in 0..active_gp.len {
            u := active_gp[ai]
            if ends[u] < st {
                if locs[u].reg_lo >= 0 { gp_in_use[locs[u].reg_lo] = false }
                if locs[u].reg_hi >= 0 { gp_in_use[locs[u].reg_hi] = false }
            } else {
                active_gp[wi] = u
                wi += 1
            }
        }
        active_gp.truncate(wi)

        need := if classes[v] == .Fat { 2 } else { 1 }
        must_callee := crosses[v]

        mut r0 := -1
        mut r1 := -1
        if !must_callee {
            for k in 0..7 {
                reg := gp_caller[k]
                if !gp_in_use[reg] {
                    if r0 < 0 { r0 = reg }
                    else if need == 2 && r1 < 0 { r1 = reg; break }
                    if need == 1 { break }
                }
            }
        }
        if r0 < 0 || (need == 2 && r1 < 0) {
            for k in 0..7 {
                reg := gp_callee[k]
                if !gp_in_use[reg] {
                    if r0 < 0 { r0 = reg }
                    else if need == 2 && r1 < 0 { r1 = reg; break }
                    if need == 1 { break }
                }
            }
        }

        if r0 >= 0 && (need == 1 || r1 >= 0) {
            locs[v].kind = .Reg
            locs[v].reg_lo = r0
            gp_in_use[r0] = true
            if r0 >= a64.X22 && r0 <= a64.X28 { push_unique_i32(&mut used_callee_gp, r0) }
            if need == 2 {
                locs[v].reg_hi = r1
                gp_in_use[r1] = true
                if r1 >= a64.X22 && r1 <= a64.X28 { push_unique_i32(&mut used_callee_gp, r1) }
            }
            active_gp.push(v)
        } else if need == 1 {
            // Try spilling the active 1-reg interval with furthest end > ends[v]
            mut victim_idx := -1
            mut victim_end := ends[v]
            for ai in 0..active_gp.len {
                u := active_gp[ai]
                if classes[u] != .Gp { continue }
                ur := locs[u].reg_lo
                if must_callee && !(ur >= a64.X22 && ur <= a64.X28) { continue }
                if ends[u] > victim_end {
                    victim_end = ends[u]
                    victim_idx = ai
                }
            }
            if victim_idx >= 0 {
                u := active_gp[victim_idx]
                stolen := locs[u].reg_lo
                locs[u].kind = .Spill
                locs[u].reg_lo = -1
                spill_count += 1
                locs[v].kind = .Reg
                locs[v].reg_lo = stolen
                if stolen >= a64.X22 && stolen <= a64.X28 { push_unique_i32(&mut used_callee_gp, stolen) }
                active_gp[victim_idx] = v
            } else {
                locs[v].kind = .Spill
                spill_count += 1
            }
        } else {
            // Spill 2-word Fat value (16 bytes)
            locs[v].kind = .Spill
            spill_count += 1
        }
    }

    // FP physical register pools:
    // Caller-saved: d0..d7 (8 regs); Callee-saved: d8..d15 (8 regs)
    fp_caller: [i32; 8] = [0, 1, 2, 3, 4, 5, 6, 7]
    fp_callee: [i32; 8] = [8, 9, 10, 11, 12, 13, 14, 15]
    mut fp_in_use: []bool = []
    for _ in 0..32 { fp_in_use.push(false) }

    mut active_fp: []i32 = []
    mut used_callee_fp: []i32 = []

    for oi in 0..fp_order.len {
        v := fp_order[oi]
        st := starts[v]
        mut wi := 0
        for ai in 0..active_fp.len {
            u := active_fp[ai]
            if ends[u] < st {
                if locs[u].reg_lo >= 0 { fp_in_use[locs[u].reg_lo] = false }
            } else {
                active_fp[wi] = u
                wi += 1
            }
        }
        active_fp.truncate(wi)

        must_callee := crosses[v]
        mut r0 := -1
        if !must_callee {
            for k in 0..8 {
                reg := fp_caller[k]
                if !fp_in_use[reg] { r0 = reg; break }
            }
        }
        if r0 < 0 {
            for k in 0..8 {
                reg := fp_callee[k]
                if !fp_in_use[reg] { r0 = reg; break }
            }
        }

        if r0 >= 0 {
            locs[v].kind = .Reg
            locs[v].reg_lo = r0
            fp_in_use[r0] = true
            if r0 >= 8 && r0 <= 15 { push_unique_i32(&mut used_callee_fp, r0) }
            active_fp.push(v)
        } else {
            mut victim_idx := -1
            mut victim_end := ends[v]
            for ai in 0..active_fp.len {
                u := active_fp[ai]
                ur := locs[u].reg_lo
                if must_callee && !(ur >= 8 && ur <= 15) { continue }
                if ends[u] > victim_end {
                    victim_end = ends[u]
                    victim_idx = ai
                }
            }
            if victim_idx >= 0 {
                u := active_fp[victim_idx]
                stolen := locs[u].reg_lo
                locs[u].kind = .Spill
                locs[u].reg_lo = -1
                spill_count += 1
                locs[v].kind = .Reg
                locs[v].reg_lo = stolen
                if stolen >= 8 && stolen <= 15 { push_unique_i32(&mut used_callee_fp, stolen) }
                active_fp[victim_idx] = v
            } else {
                locs[v].kind = .Spill
                spill_count += 1
            }
        }
    }

    RegAllocPlan {
        rpo: move rpo,
        locs: move locs,
        used_callee_gp: move used_callee_gp,
        used_callee_fp: move used_callee_fp,
        spill_count: spill_count,
        live_starts: move starts,
        live_ends: move ends,
        crosses_call: move crosses,
    }
}

// =========================================================================
// 3. Low-Level ARM64 Emission Helpers (Safe Arbitary Offsets & Immediates)
// =========================================================================

fn emit_add_imm_any(buf: &mut a64.ArmBuf, dst: i32, src: i32, val: i64) {
    if val == 0 {
        a64.mov(&mut buf, dst, src)
        return
    }
    if val > 0 && a64.add_sub_imm_field(val) >= 0 {
        a64.add_imm(&mut buf, true, false, dst, src, val)
        return
    }
    if val < 0 && a64.add_sub_imm_field(-val) >= 0 {
        a64.sub_imm(&mut buf, true, false, dst, src, -val)
        return
    }
    a64.imm(&mut buf, a64.X17, val)
    a64.add_reg(&mut buf, true, false, dst, src, a64.X17)
}

fn emit_sub_imm_any(buf: &mut a64.ArmBuf, dst: i32, src: i32, val: i64) {
    emit_add_imm_any(&mut buf, dst, src, -val)
}

fn emit_cmp_imm_any(buf: &mut a64.ArmBuf, wide: bool, lhs: i32, val: i64) {
    if val >= 0 && val <= 4095 {
        a64.cmp_imm(&mut buf, wide, lhs, val)
    } else if val < 0 && val >= -4095 {
        a64.cmn_imm(&mut buf, wide, lhs, -val)
    } else {
        a64.imm(&mut buf, a64.X17, val)
        a64.cmp_reg(&mut buf, wide, lhs, a64.X17)
    }
}

// Load 1/2/4/8 bytes from [base + off] (arbitrary signed offset, handles unaligned offsets cleanly).
fn emit_ldr_off(buf: &mut a64.ArmBuf, dst: i32, base: i32, off: i64, width: i32, sign_ext: bool) {
    if off >= 0 && off <= i64(4095 * width) && (off % i64(width)) == 0 {
        a64.ldr(&mut buf, dst, base, i32(off), width, sign_ext)
        return
    }
    if off >= -256 && off <= 255 {
        a64.ldur(&mut buf, dst, base, i32(off), width, sign_ext)
        return
    }
    emit_add_imm_any(&mut buf, a64.X17, base, off)
    a64.ldr(&mut buf, dst, a64.X17, 0, width, sign_ext)
}

fn emit_str_off(buf: &mut a64.ArmBuf, src: i32, base: i32, off: i64, width: i32) {
    if off >= 0 && off <= i64(4095 * width) && (off % i64(width)) == 0 {
        a64.str(&mut buf, src, base, i32(off), width)
        return
    }
    if off >= -256 && off <= 255 {
        a64.stur(&mut buf, src, base, i32(off), width)
        return
    }
    emit_add_imm_any(&mut buf, a64.X17, base, off)
    a64.str(&mut buf, src, a64.X17, 0, width)
}

fn emit_ldr_fp_off(buf: &mut a64.ArmBuf, is_f64: bool, vt: i32, base: i32, off: i64) {
    w := if is_f64 { 8 } else { 4 }
    if off >= 0 && off <= i64(4095 * w) && (off % i64(w)) == 0 {
        a64.ldr_fp(&mut buf, is_f64, vt, base, i32(off))
        return
    }
    emit_add_imm_any(&mut buf, a64.X17, base, off)
    a64.ldr_fp(&mut buf, is_f64, vt, a64.X17, 0)
}

fn emit_str_fp_off(buf: &mut a64.ArmBuf, is_f64: bool, vt: i32, base: i32, off: i64) {
    w := if is_f64 { 8 } else { 4 }
    if off >= 0 && off <= i64(4095 * w) && (off % i64(w)) == 0 {
        a64.str_fp(&mut buf, is_f64, vt, base, i32(off))
        return
    }
    emit_add_imm_any(&mut buf, a64.X17, base, off)
    a64.str_fp(&mut buf, is_f64, vt, a64.X17, 0)
}

// Inline small memory copy (dst_reg, src_reg untouched; uses x16, x17) for size <= 64
fn emit_inline_memcpy(buf: &mut a64.ArmBuf, dst_reg: i32, src_reg: i32, size: i32) {
    mut off := 0
    while off + 8 <= size {
        emit_ldr_off(&mut buf, a64.X16, src_reg, i64(off), 8, false)
        emit_str_off(&mut buf, a64.X16, dst_reg, i64(off), 8)
        off += 8
    }
    if off + 4 <= size {
        emit_ldr_off(&mut buf, a64.X16, src_reg, i64(off), 4, false)
        emit_str_off(&mut buf, a64.X16, dst_reg, i64(off), 4)
        off += 4
    }
    if off + 2 <= size {
        emit_ldr_off(&mut buf, a64.X16, src_reg, i64(off), 2, false)
        emit_str_off(&mut buf, a64.X16, dst_reg, i64(off), 2)
        off += 2
    }
    if off < size {
        emit_ldr_off(&mut buf, a64.X16, src_reg, i64(off), 1, false)
        emit_str_off(&mut buf, a64.X16, dst_reg, i64(off), 1)
    }
}

fn emit_inline_memzero(buf: &mut a64.ArmBuf, dst_reg: i32, size: i32) {
    mut off := 0
    while off + 8 <= size {
        emit_str_off(&mut buf, a64.XZR, dst_reg, i64(off), 8)
        off += 8
    }
    if off + 4 <= size {
        emit_str_off(&mut buf, a64.XZR, dst_reg, i64(off), 4)
        off += 4
    }
    if off + 2 <= size {
        emit_str_off(&mut buf, a64.XZR, dst_reg, i64(off), 2)
        off += 2
    }
    if off < size {
        emit_str_off(&mut buf, a64.XZR, dst_reg, i64(off), 1)
    }
}

fn emit_syscall(buf: &mut a64.ArmBuf, target: obj.TargetKind, darwin_nr: i64, linux_nr: i64) {
    if target == .Arm64Macos {
        a64.imm(&mut buf, a64.X16, darwin_nr)
        a64.svc(&mut buf, 128) // svc #0x80
    } else {
        a64.imm(&mut buf, a64.X8, linux_nr)
        a64.svc(&mut buf, 0)   // svc #0
    }
}

fn emit_normalize_int(buf: &mut a64.ArmBuf, types: &ht.TypeTable, ty: i32, dst: i32, src: i32) {
    if ty < 0 || ty >= types.entries.len {
        a64.mov(&mut buf, dst, src)
        return
    }
    k := types.entries[ty].kind
    if k == .I8 { a64.sxtb(&mut buf, dst, src) }
    else if k == .I16 { a64.sxth(&mut buf, dst, src) }
    else if k == .I32 { a64.sxtw(&mut buf, dst, src) }
    else if k == .U8 || k == .Bool { a64.uxtb(&mut buf, dst, src) }
    else if k == .U16 { a64.uxth(&mut buf, dst, src) }
    else if k == .U32 || k == .Rune { a64.mov32(&mut buf, dst, src) }
    else { a64.mov(&mut buf, dst, src) }
}

// =========================================================================
// 4. Shared Self-Contained Runtime Helpers (Emitted into ObjectModule)
// =========================================================================

struct RuntimeSyms {
    alloc: i32,
    trap: i32,
    write_buf: i32,
    print_str: i32,
    print_int: i32,
    print_bool: i32,
    int_to_str: i32,
    str_concat: i32,
    str_eq: i32,
    str_cmp: i32,
    arr_alloc: i32,
    arr_grow: i32,
    memcpy: i32,
    memzero: i32,
    mem_eq: i32,
    pthread_tramp: i32,
    ro_true: i32,
    ro_false: i32,
    ro_nl: i32,
}

struct PendingReloc {
    site_lbl: i32,
    kind: obj.ObjRelocKind,
    sym_id: i32,
    addend: i64,
    reg: i32,
}

struct PendingImport {
    site_lbl: i32,
    imp_id: i32,
}

fn emit_call_sym(buf: &mut a64.ArmBuf, relocs: &mut []PendingReloc, sym_id: i32) {
    lbl := a64.label(&mut buf)
    a64.mark(&mut buf, lbl)
    a64.emit(&mut buf, 0) // patched by Arm64Call26
    relocs.push(PendingReloc {
        site_lbl: lbl,
        kind: .Arm64Call26,
        sym_id: sym_id,
        addend: 0,
        reg: 0,
    })
}

fn emit_adrp_sym(buf: &mut a64.ArmBuf, relocs: &mut []PendingReloc, reg: i32, sym_id: i32, addend: i64) {
    lbl := a64.label(&mut buf)
    a64.mark(&mut buf, lbl)
    a64.emit(&mut buf, 0) // patched by Arm64AdrpAdd
    a64.emit(&mut buf, 0)
    relocs.push(PendingReloc {
        site_lbl: lbl,
        kind: .Arm64AdrpAdd,
        sym_id: sym_id,
        addend: addend,
        reg: reg,
    })
}

fn flush_buf_to_module(m: &mut obj.ObjectModule, buf: &mut a64.ArmBuf,
    relocs: &[]PendingReloc, imp_sites: &[]PendingImport,
    name: string, exported: bool) -> i32 {
    code := a64.finish_at_offset(&mut buf, 0)
    start := obj.append_text(&mut m, &code, 4)
    sym := obj.add_symbol(&mut m, name, .Function, .Text, start, code.len, exported)
    for i in 0..relocs.len {
        r := relocs[i]
        off := start + a64.label_word(&buf, r.site_lbl) * 4
        _ := obj.add_reloc(&mut m, .Text, off, r.kind, r.sym_id, r.addend, r.reg)
    }
    for i in 0..imp_sites.len {
        p := imp_sites[i]
        off := start + a64.label_word(&buf, p.site_lbl) * 4
        obj.add_import_site(&mut m, p.imp_id, off)
    }
    sym
}

fn append_rodata_cstr(m: &mut obj.ObjectModule, name: string, text: string) -> i32 {
    mut blob: []u8 = []
    bytes.append_utf8(&mut blob, text)
    blob.push(u8(0))
    off := obj.append_rodata(&mut m, &blob, 8)
    obj.add_symbol(&mut m, name, .RodataBlob, .Rodata, off, blob.len, false)
}

fn append_rodata_dunder_str(m: &mut obj.ObjectModule, name: string, text: string) -> i32 {
    mut blob: []u8 = []
    bytes.append_le(&mut blob, 0, 8) // immortal RC = 0 at [ptr - 8]
    bytes.append_le(&mut blob, i64(text.len), 8) // length at [ptr + 0]
    bytes.append_utf8(&mut blob, text)
    blob.push(u8(0))
    off := obj.append_rodata(&mut m, &blob, 8)
    // Symbol points at [len, bytes...] (+8 past RC header)
    obj.add_symbol(&mut m, name, .RodataBlob, .Rodata, off + 8, blob.len - 8, false)
}

fn emit_runtime_stubs(m: &mut obj.ObjectModule, target: obj.TargetKind) -> RuntimeSyms {
    ro_true := append_rodata_cstr(&mut m, "__rt_str_true", "true\n")
    ro_false := append_rodata_cstr(&mut m, "__rt_str_false", "false\n")
    ro_nl := append_rodata_cstr(&mut m, "__rt_str_nl", "\n")

    empty_imp: []PendingImport = []

    // 1. __dunder_rt_trap(x0 = exit_code)
    mut b_trap := a64.new()
    emit_syscall(&mut b_trap, target, 33554433, 94) // exit / exit_group
    a64.brk(&mut b_trap, 1)
    mut r_trap: []PendingReloc = []
    sym_trap := flush_buf_to_module(&mut m, &mut b_trap, &r_trap, &empty_imp, "__dunder_rt_trap", false)

    // 2. __dunder_rt_alloc(x0 = size_bytes) -> x0 = 16B-aligned pointer via x19..x21 + mmap slow-path
    mut b_alloc := a64.new()
    mut r_alloc: []PendingReloc = []
    // Round x0 up to 16-byte multiple (min 16)
    lbl_nonzero := a64.label(&mut b_alloc)
    a64.cbnz(&mut b_alloc, true, a64.X0, lbl_nonzero)
    a64.imm(&mut b_alloc, a64.X0, 16)
    a64.mark(&mut b_alloc, lbl_nonzero)
    a64.add_imm(&mut b_alloc, true, false, a64.X10, a64.X0, 15)
    a64.lsr_imm(&mut b_alloc, true, a64.X10, a64.X10, 4)
    a64.lsl_imm(&mut b_alloc, true, a64.X10, a64.X10, 4)

    // Fast path: x19 != 0 && x19 + x10 <= x20
    lbl_slow := a64.label(&mut b_alloc)
    a64.cbz(&mut b_alloc, true, a64.X19, lbl_slow)
    a64.add_reg(&mut b_alloc, true, false, a64.X11, a64.X19, a64.X10)
    a64.cmp_reg(&mut b_alloc, true, a64.X11, a64.X20)
    a64.b_cond(&mut b_alloc, a64.CC_HI, lbl_slow)
    a64.mov(&mut b_alloc, a64.X0, a64.X19)
    a64.mov(&mut b_alloc, a64.X19, a64.X11)
    a64.ret(&mut b_alloc)

    // Slow path: mmap max(65536, align_page(x10))
    a64.mark(&mut b_alloc, lbl_slow)
    a64.emit_prologue(&mut b_alloc, 16)
    a64.str(&mut b_alloc, a64.X10, a64.SP, 0, 8) // save requested size
    // chunk = max(65536, (x10 + 16383) & ~16383)
    a64.imm(&mut b_alloc, a64.X11, 16383)
    a64.add_reg(&mut b_alloc, true, false, a64.X1, a64.X10, a64.X11)
    a64.lsr_imm(&mut b_alloc, true, a64.X1, a64.X1, 14)
    a64.lsl_imm(&mut b_alloc, true, a64.X1, a64.X1, 14)
    a64.imm(&mut b_alloc, a64.X11, 65536)
    a64.cmp_reg(&mut b_alloc, true, a64.X1, a64.X11)
    lbl_sized := a64.label(&mut b_alloc)
    a64.b_cond(&mut b_alloc, a64.CC_HS, lbl_sized)
    a64.mov(&mut b_alloc, a64.X1, a64.X11)
    a64.mark(&mut b_alloc, lbl_sized)
    a64.str(&mut b_alloc, a64.X1, a64.SP, 8, 8) // save chunk size
    a64.imm(&mut b_alloc, a64.X0, 0)            // addr = NULL
    a64.imm(&mut b_alloc, a64.X2, 3)            // PROT_READ | PROT_WRITE
    if target == .Arm64Macos {
        a64.imm(&mut b_alloc, a64.X3, 4098)     // MAP_PRIVATE | MAP_ANON
    } else {
        a64.imm(&mut b_alloc, a64.X3, 34)       // MAP_PRIVATE | MAP_ANONYMOUS
    }
    a64.imm(&mut b_alloc, a64.X4, -1)           // fd = -1
    a64.imm(&mut b_alloc, a64.X5, 0)            // offset = 0
    emit_syscall(&mut b_alloc, target, 33554629, 222) // mmap
    lbl_oom := a64.label(&mut b_alloc)
    if target == .Arm64Macos {
        a64.b_cond(&mut b_alloc, a64.CC_CS, lbl_oom)
    } else {
        a64.cmp_imm(&mut b_alloc, true, a64.X0, 0)
        a64.b_cond(&mut b_alloc, a64.CC_LT, lbl_oom)
    }
    a64.ldr(&mut b_alloc, a64.X10, a64.SP, 0, 8, false) // req size
    a64.ldr(&mut b_alloc, a64.X11, a64.SP, 8, 8, false) // chunk size
    a64.mov(&mut b_alloc, a64.X21, a64.X0)              // slab root
    a64.add_reg(&mut b_alloc, true, false, a64.X20, a64.X0, a64.X11)
    a64.add_reg(&mut b_alloc, true, false, a64.X19, a64.X0, a64.X10)
    a64.emit_epilogue(&mut b_alloc)

    a64.mark(&mut b_alloc, lbl_oom)
    a64.imm(&mut b_alloc, a64.X0, 109)
    emit_call_sym(&mut b_alloc, &mut r_alloc, sym_trap)
    sym_alloc := flush_buf_to_module(&mut m, &mut b_alloc, &r_alloc, &empty_imp, "__dunder_rt_alloc", false)

    // 3. __dunder_rt_memcpy(x0 = dst, x1 = src, x2 = bytes)
    mut b_cpy := a64.new()
    mut r_cpy: []PendingReloc = []
    lbl_cpy_w := a64.label(&mut b_cpy)
    lbl_cpy_b := a64.label(&mut b_cpy)
    lbl_cpy_done := a64.label(&mut b_cpy)
    a64.mark(&mut b_cpy, lbl_cpy_w)
    a64.cmp_imm(&mut b_cpy, true, a64.X2, 8)
    a64.b_cond(&mut b_cpy, a64.CC_LO, lbl_cpy_b)
    a64.ldr(&mut b_cpy, a64.X10, a64.X1, 0, 8, false)
    a64.str(&mut b_cpy, a64.X10, a64.X0, 0, 8)
    a64.add_imm(&mut b_cpy, true, false, a64.X0, a64.X0, 8)
    a64.add_imm(&mut b_cpy, true, false, a64.X1, a64.X1, 8)
    a64.sub_imm(&mut b_cpy, true, false, a64.X2, a64.X2, 8)
    a64.b(&mut b_cpy, lbl_cpy_w)
    a64.mark(&mut b_cpy, lbl_cpy_b)
    a64.cbz(&mut b_cpy, true, a64.X2, lbl_cpy_done)
    a64.ldr(&mut b_cpy, a64.X10, a64.X1, 0, 1, false)
    a64.str(&mut b_cpy, a64.X10, a64.X0, 0, 1)
    a64.add_imm(&mut b_cpy, true, false, a64.X0, a64.X0, 1)
    a64.add_imm(&mut b_cpy, true, false, a64.X1, a64.X1, 1)
    a64.sub_imm(&mut b_cpy, true, false, a64.X2, a64.X2, 1)
    a64.b(&mut b_cpy, lbl_cpy_b)
    a64.mark(&mut b_cpy, lbl_cpy_done)
    a64.ret(&mut b_cpy)
    sym_memcpy := flush_buf_to_module(&mut m, &mut b_cpy, &r_cpy, &empty_imp, "__dunder_rt_memcpy", false)

    // 4. __dunder_rt_memzero(x0 = dst, x1 = bytes)
    mut b_zero := a64.new()
    mut r_zero: []PendingReloc = []
    lbl_zw := a64.label(&mut b_zero)
    lbl_zb := a64.label(&mut b_zero)
    lbl_zdone := a64.label(&mut b_zero)
    a64.mark(&mut b_zero, lbl_zw)
    a64.cmp_imm(&mut b_zero, true, a64.X1, 8)
    a64.b_cond(&mut b_zero, a64.CC_LO, lbl_zb)
    a64.str(&mut b_zero, a64.XZR, a64.X0, 0, 8)
    a64.add_imm(&mut b_zero, true, false, a64.X0, a64.X0, 8)
    a64.sub_imm(&mut b_zero, true, false, a64.X1, a64.X1, 8)
    a64.b(&mut b_zero, lbl_zw)
    a64.mark(&mut b_zero, lbl_zb)
    a64.cbz(&mut b_zero, true, a64.X1, lbl_zdone)
    a64.str(&mut b_zero, a64.XZR, a64.X0, 0, 1)
    a64.add_imm(&mut b_zero, true, false, a64.X0, a64.X0, 1)
    a64.sub_imm(&mut b_zero, true, false, a64.X1, a64.X1, 1)
    a64.b(&mut b_zero, lbl_zb)
    a64.mark(&mut b_zero, lbl_zdone)
    a64.ret(&mut b_zero)
    sym_memzero := flush_buf_to_module(&mut m, &mut b_zero, &r_zero, &empty_imp, "__dunder_rt_memzero", false)

    // 5. __dunder_rt_write_buf(x0 = fd, x1 = ptr, x2 = len)
    mut b_wr := a64.new()
    mut r_wr: []PendingReloc = []
    lbl_wr_done := a64.label(&mut b_wr)
    a64.cbz(&mut b_wr, true, a64.X2, lbl_wr_done)
    emit_syscall(&mut b_wr, target, 33554436, 64) // write
    a64.mark(&mut b_wr, lbl_wr_done)
    a64.ret(&mut b_wr)
    sym_write_buf := flush_buf_to_module(&mut m, &mut b_wr, &r_wr, &empty_imp, "__dunder_rt_write_buf", false)

    // 6. __dunder_rt_print_str(x0 = fd, x1 = ptr, x2 = len) -> prints bytes + '\n'
    mut b_pstr := a64.new()
    mut r_pstr: []PendingReloc = []
    a64.emit_prologue(&mut b_pstr, 16)
    a64.str(&mut b_pstr, a64.X0, a64.SP, 0, 8) // save fd
    emit_call_sym(&mut b_pstr, &mut r_pstr, sym_write_buf)
    a64.ldr(&mut b_pstr, a64.X0, a64.SP, 0, 8, false)
    emit_adrp_sym(&mut b_pstr, &mut r_pstr, a64.X1, ro_nl, 0)
    a64.imm(&mut b_pstr, a64.X2, 1)
    emit_call_sym(&mut b_pstr, &mut r_pstr, sym_write_buf)
    a64.emit_epilogue(&mut b_pstr)
    sym_print_str := flush_buf_to_module(&mut m, &mut b_pstr, &r_pstr, &empty_imp, "__dunder_rt_print_str", false)

    // 7. __dunder_rt_print_bool(x0 = fd, x1 = val)
    mut b_pbool := a64.new()
    mut r_pbool: []PendingReloc = []
    a64.emit_prologue(&mut b_pbool, 0)
