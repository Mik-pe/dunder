                emit_syscall(&mut fc.buf, target, 33554568, 34) // mkdir (136)
            } else if id == hb.INTRINSIC_SYS_REMOVE_FILE {
                emit_syscall(&mut fc.buf, target, 33554442, 35) // unlink (10)
            } else if id == hb.INTRINSIC_SYS_REMOVE_DIR {
