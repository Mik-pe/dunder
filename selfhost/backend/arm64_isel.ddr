    a64.mark(&mut b_swf, lbl_swf_app)
    a64.imm(&mut b_swf, a64.X10, if target == .Arm64Macos { 521 } else { 1089 }) // O_WRONLY|O_CREAT|O_APPEND
    a64.mark(&mut b_swf, lbl_swf_open)
    if target == .Arm64Macos {
        a64.add_imm(&mut b_swf, true, false, a64.X0, a64.X0, 8)
        a64.mov(&mut b_swf, a64.X1, a64.X10)
        a64.imm(&mut b_swf, a64.X2, 420) // 0644
        emit_syscall(&mut b_swf, target, 33554437, 56)
        a64.b_cond(&mut b_swf, a64.CC_CS, lbl_swf_oerr)
    } else {
        a64.add_imm(&mut b_swf, true, false, a64.X1, a64.X0, 8)
        a64.imm(&mut b_swf, a64.X0, -100)
        a64.mov(&mut b_swf, a64.X2, a64.X10)
        a64.imm(&mut b_swf, a64.X3, 420)
        emit_syscall(&mut b_swf, target, 33554437, 56)
        a64.cmp_imm(&mut b_swf, true, a64.X0, 0)
        a64.b_cond(&mut b_swf, a64.CC_LT, lbl_swf_oerr)
    }
    a64.str(&mut b_swf, a64.X0, a64.SP, 16, 8) // fd
    a64.str(&mut b_swf, a64.XZR, a64.SP, 24, 8) // written = 0
    lbl_swf_wl := a64.label(&mut b_swf)
    lbl_swf_wd := a64.label(&mut b_swf)
    a64.mark(&mut b_swf, lbl_swf_wl)
    a64.ldr(&mut b_swf, a64.X10, a64.SP, 24, 8, false) // written
    a64.ldr(&mut b_swf, a64.X11, a64.SP, 8, 8, false)  // total
    a64.cmp_reg(&mut b_swf, true, a64.X10, a64.X11)
    a64.b_cond(&mut b_swf, a64.CC_HS, lbl_swf_wd)
    a64.ldr(&mut b_swf, a64.X0, a64.SP, 16, 8, false) // fd
    a64.ldr(&mut b_swf, a64.X1, a64.SP, 0, 8, false)
    a64.add_reg(&mut b_swf, true, false, a64.X1, a64.X1, a64.X10)
    a64.sub_reg(&mut b_swf, true, false, a64.X2, a64.X11, a64.X10)
    emit_syscall(&mut b_swf, target, 33554436, 64) // write
    if target == .Arm64Macos {
        a64.b_cond(&mut b_swf, a64.CC_CS, lbl_swf_werr)
    } else {
        a64.cmp_imm(&mut b_swf, true, a64.X0, 0)
        a64.b_cond(&mut b_swf, a64.CC_LT, lbl_swf_werr)
    }
    a64.ldr(&mut b_swf, a64.X10, a64.SP, 24, 8, false)
    a64.add_reg(&mut b_swf, true, false, a64.X10, a64.X10, a64.X0)
    a64.str(&mut b_swf, a64.X10, a64.SP, 24, 8)
    a64.b(&mut b_swf, lbl_swf_wl)
    a64.mark(&mut b_swf, lbl_swf_wd)
    a64.ldr(&mut b_swf, a64.X0, a64.SP, 16, 8, false)
    emit_syscall(&mut b_swf, target, 33554438, 57) // close
    a64.imm(&mut b_swf, a64.X0, 0)
    a64.emit_epilogue(&mut b_swf)
    a64.mark(&mut b_swf, lbl_swf_werr)
    if target != .Arm64Macos { a64.neg(&mut b_swf, true, false, a64.X0, a64.X0) }
    a64.str(&mut b_swf, a64.X0, a64.SP, 32, 8)
    a64.ldr(&mut b_swf, a64.X0, a64.SP, 16, 8, false)
    emit_syscall(&mut b_swf, target, 33554438, 57)
    a64.ldr(&mut b_swf, a64.X0, a64.SP, 32, 8, false)
    a64.emit_epilogue(&mut b_swf)
    a64.mark(&mut b_swf, lbl_swf_oerr)
    if target != .Arm64Macos { a64.neg(&mut b_swf, true, false, a64.X0, a64.X0) }
    a64.emit_epilogue(&mut b_swf)
    sym_sys_write_file := flush_buf_to_module(&mut m, &mut b_swf, &r_swf, &empty_imp, "__dunder_rt_sys_write_file", false)

    // 39. __dunder_rt_sys_stat(x0 = path_str, x1 = stat_buf, x2 = use_lstat) -> x0 = errno (0 ok)
    mut b_sst := a64.new()
    mut r_sst: []PendingReloc = []
    lbl_sst_ls := a64.label(&mut b_sst)
    lbl_sst_chk := a64.label(&mut b_sst)
    lbl_sst_err := a64.label(&mut b_sst)
    if target == .Arm64Macos {
        a64.add_imm(&mut b_sst, true, false, a64.X0, a64.X0, 8)
        a64.cbnz(&mut b_sst, true, a64.X2, lbl_sst_ls)
        emit_syscall(&mut b_sst, target, 33554770, 79) // stat64 (338)
        a64.b(&mut b_sst, lbl_sst_chk)
        a64.mark(&mut b_sst, lbl_sst_ls)
        emit_syscall(&mut b_sst, target, 33554772, 79) // lstat64 (340)
        a64.mark(&mut b_sst, lbl_sst_chk)
        a64.b_cond(&mut b_sst, a64.CC_CS, lbl_sst_err)
        a64.imm(&mut b_sst, a64.X0, 0)
        a64.ret(&mut b_sst)
        a64.mark(&mut b_sst, lbl_sst_err)
        a64.ret(&mut b_sst)
    } else {
        a64.mov(&mut b_sst, a64.X10, a64.X0)
        a64.mov(&mut b_sst, a64.X11, a64.X1)
        a64.mov(&mut b_sst, a64.X12, a64.X2)
        a64.imm(&mut b_sst, a64.X0, -100) // AT_FDCWD
        a64.add_imm(&mut b_sst, true, false, a64.X1, a64.X10, 8)
        a64.mov(&mut b_sst, a64.X2, a64.X11)
        a64.imm(&mut b_sst, a64.X3, 0)
        a64.cbz(&mut b_sst, true, a64.X12, lbl_sst_ls)
        a64.imm(&mut b_sst, a64.X3, 256) // AT_SYMLINK_NOFOLLOW
        a64.mark(&mut b_sst, lbl_sst_ls)
        emit_syscall(&mut b_sst, target, 33554770, 79) // newfstatat
        a64.cmp_imm(&mut b_sst, true, a64.X0, 0)
        a64.b_cond(&mut b_sst, a64.CC_LT, lbl_sst_err)
        a64.imm(&mut b_sst, a64.X0, 0)
        a64.ret(&mut b_sst)
        a64.mark(&mut b_sst, lbl_sst_err)
        a64.neg(&mut b_sst, true, false, a64.X0, a64.X0)
        a64.ret(&mut b_sst)
    }
    sym_sys_stat := flush_buf_to_module(&mut m, &mut b_sst, &r_sst, &empty_imp, "__dunder_rt_sys_stat", false)

    RuntimeSyms {
        alloc: sym_alloc,
        trap: sym_trap,
        write_buf: sym_write_buf,
        print_str: sym_print_str,
        print_int: sym_print_int,
        print_bool: sym_print_bool,
        int_to_str: sym_int_to_str,
        str_concat: sym_str_concat,
        str_eq: sym_str_eq,
        str_cmp: sym_str_cmp,
        str_from_fat: sym_str_from_fat,
        str_slice: sym_str_slice,
        str_runes: sym_str_runes,
        rune_to_str: sym_rune_to_str,
        fmt_int: sym_fmt_int,
        fmt_str: sym_fmt_str,
        fmt_fixed: sym_fmt_fixed,
        utf8_valid: sym_utf8_valid,
        cstr_len: sym_cstr_len,
        arr_alloc: sym_arr_alloc,
        arr_grow: sym_arr_grow,
        memcpy: sym_memcpy,
        memzero: sym_memzero,
        mem_eq: sym_mem_eq,
        hash_key: sym_hash_key,
        key_eq: sym_key_eq,
        map_new: sym_map_new,
        map_rehash: sym_map_rehash,
        map_find: sym_map_find,
        map_put: sym_map_put,
        map_remove_idx: sym_map_remove_idx,
        map_remove: sym_map_remove,
        map_clear: sym_map_clear,
        sys_arg: sym_sys_arg,
        sys_now_ms: sym_sys_now_ms,
        sys_read_all: sym_sys_read_all,
        sys_write_file: sym_sys_write_file,
        sys_stat: sym_sys_stat,
        pthread_tramp: sym_pthread_tramp,
        bss_args_off: bss_args_off,
        ro_true: ro_true,
        ro_false: ro_false,
        ro_nl: ro_nl,
    }
}

// =========================================================================
// 5. Function Codegen Context & Value Load / Store Helpers
// =========================================================================

struct FnCodegen {
    buf: a64.ArmBuf,
    relocs: []PendingReloc,
    imp_sites: []PendingImport,
    gsites: []PendingGlobal,
    plan: RegAllocPlan,
    slot_offs: []i32,     // negative offset magnitude from FP for each StackSlot
    callee_gp_offs: []i32,
    callee_fp_offs: []i32,
    sret_off: i32,        // >0 if function uses indirect sret in x8
    env_off: i32,         // >0 if function is closure body (x9 saved here)
    region_offs: []i32,   // negative offset magnitude for saved (x19, x20) per region scope
    region_ids: []i32,
    frame_bytes: i32,
    bb_labels: []i32,
    epilogue_lbl: i32,
    trap_101: i32,
    trap_102: i32,
    trap_103: i32,
    trap_104: i32,
    trap_105: i32,
    trap_106: i32,
    ro_counter: i32,
}

fn find_region_off(fc: &FnCodegen, scope_id: i32) -> i32 {
    for i in 0..fc.region_ids.len {
        if fc.region_ids[i] == scope_id { return fc.region_offs[i] }
    }
    -1
}

// Materialize GP SsaVal `v` into physical GP register `dst` (or return its already-assigned GP reg if `prefer_reg < 0`).
fn load_gp_val(fc: &mut FnCodegen, v: i32, scratch: i32) -> i32 {
    loc := fc.plan.locs[v]
    if loc.kind == .Reg { return loc.reg_lo }
    if loc.kind == .Spill {
        emit_ldr_off(&mut fc.buf, scratch, a64.FP, -i64(loc.spill_off), 8, false)
        return scratch
    }
    a64.imm(&mut fc.buf, scratch, 0)
    scratch
}

fn load_gp_into(fc: &mut FnCodegen, v: i32, dst: i32) {
    loc := fc.plan.locs[v]
    if loc.kind == .Reg {
        a64.mov(&mut fc.buf, dst, loc.reg_lo)
    } else if loc.kind == .Spill {
        emit_ldr_off(&mut fc.buf, dst, a64.FP, -i64(loc.spill_off), 8, false)
    } else {
        a64.imm(&mut fc.buf, dst, 0)
    }
}

fn store_gp_val(fc: &mut FnCodegen, v: i32, src: i32) {
    if v < 0 { return }
    loc := fc.plan.locs[v]
    if loc.kind == .Reg {
        a64.mov(&mut fc.buf, loc.reg_lo, src)
    } else if loc.kind == .Spill {
        emit_str_off(&mut fc.buf, src, a64.FP, -i64(loc.spill_off), 8)
    }
}

fn dst_gp_reg(fc: &FnCodegen, v: i32, scratch: i32) -> i32 {
    if v >= 0 && fc.plan.locs[v].kind == .Reg { return fc.plan.locs[v].reg_lo }
    scratch
}

fn commit_gp_dst(fc: &mut FnCodegen, v: i32, reg: i32) {
    if v >= 0 && fc.plan.locs[v].kind == .Spill {
        emit_str_off(&mut fc.buf, reg, a64.FP, -i64(fc.plan.locs[v].spill_off), 8)
    }
}

// Materialize FP SsaVal `v` into FP reg (returns its reg or loads into `scratch`).
fn load_fp_val(fc: &mut FnCodegen, v: i32, scratch: i32) -> i32 {
    loc := fc.plan.locs[v]
    if loc.kind == .Reg { return loc.reg_lo }
    if loc.kind == .Spill {
        emit_ldr_fp_off(&mut fc.buf, loc.is_f64, scratch, a64.FP, -i64(loc.spill_off))
        return scratch
    }
    a64.fmov_to_fp(&mut fc.buf, loc.is_f64, scratch, a64.XZR)
    scratch
}

fn load_fp_into(fc: &mut FnCodegen, v: i32, dst: i32) {
    loc := fc.plan.locs[v]
    if loc.kind == .Reg {
        if dst != loc.reg_lo { a64.fmov_reg(&mut fc.buf, loc.is_f64, dst, loc.reg_lo) }
    } else if loc.kind == .Spill {
        emit_ldr_fp_off(&mut fc.buf, loc.is_f64, dst, a64.FP, -i64(loc.spill_off))
    } else {
        a64.fmov_to_fp(&mut fc.buf, loc.is_f64, dst, a64.XZR)
    }
}

fn store_fp_val(fc: &mut FnCodegen, v: i32, src: i32) {
    if v < 0 { return }
    loc := fc.plan.locs[v]
    if loc.kind == .Reg {
        if loc.reg_lo != src { a64.fmov_reg(&mut fc.buf, loc.is_f64, loc.reg_lo, src) }
    } else if loc.kind == .Spill {
        emit_str_fp_off(&mut fc.buf, loc.is_f64, src, a64.FP, -i64(loc.spill_off))
    }
}

fn dst_fp_reg(fc: &FnCodegen, v: i32, scratch: i32) -> i32 {
    if v >= 0 && fc.plan.locs[v].kind == .Reg { return fc.plan.locs[v].reg_lo }
    scratch
}

fn commit_fp_dst(fc: &mut FnCodegen, v: i32, reg: i32) {
    if v >= 0 && fc.plan.locs[v].kind == .Spill {
        emit_str_fp_off(&mut fc.buf, fc.plan.locs[v].is_f64, reg, a64.FP, -i64(fc.plan.locs[v].spill_off))
    }
}

// Materialize 2-word Fat SsaVal `v` into (ptr_dst, len_dst) GP registers.
fn load_fat_into(fc: &mut FnCodegen, v: i32, ptr_dst: i32, len_dst: i32) {
    loc := fc.plan.locs[v]
    if loc.kind == .Reg {
        if ptr_dst == loc.reg_hi && len_dst == loc.reg_lo {
            a64.mov(&mut fc.buf, a64.X16, loc.reg_lo)
            a64.mov(&mut fc.buf, ptr_dst, loc.reg_hi)
            a64.mov(&mut fc.buf, len_dst, a64.X16)
        } else if ptr_dst == loc.reg_hi {
            a64.mov(&mut fc.buf, len_dst, loc.reg_hi)
            a64.mov(&mut fc.buf, ptr_dst, loc.reg_lo)
        } else {
            a64.mov(&mut fc.buf, ptr_dst, loc.reg_lo)
            a64.mov(&mut fc.buf, len_dst, loc.reg_hi)
        }
    } else if loc.kind == .Spill {
        emit_ldr_off(&mut fc.buf, ptr_dst, a64.FP, -i64(loc.spill_off), 8, false)
        emit_ldr_off(&mut fc.buf, len_dst, a64.FP, -i64(loc.spill_off) + 8, 8, false)
    } else {
        a64.imm(&mut fc.buf, ptr_dst, 0)
        a64.imm(&mut fc.buf, len_dst, 0)
    }
}

fn store_fat_val(fc: &mut FnCodegen, v: i32, ptr_src: i32, len_src: i32) {
    if v < 0 { return }
    loc := fc.plan.locs[v]
    if loc.kind == .Reg {
        if loc.reg_lo == len_src && loc.reg_hi == ptr_src {
            a64.mov(&mut fc.buf, a64.X16, ptr_src)
            a64.mov(&mut fc.buf, loc.reg_lo, len_src)
            a64.mov(&mut fc.buf, loc.reg_hi, a64.X16)
        } else if loc.reg_lo == len_src {
            a64.mov(&mut fc.buf, loc.reg_hi, len_src)
            a64.mov(&mut fc.buf, loc.reg_lo, ptr_src)
        } else {
            a64.mov(&mut fc.buf, loc.reg_lo, ptr_src)
            a64.mov(&mut fc.buf, loc.reg_hi, len_src)
        }
    } else if loc.kind == .Spill {
        emit_str_off(&mut fc.buf, ptr_src, a64.FP, -i64(loc.spill_off), 8)
        emit_str_off(&mut fc.buf, len_src, a64.FP, -i64(loc.spill_off) + 8, 8)
    }
}

fn emit_memcpy_size(fc: &mut FnCodegen, rt: &RuntimeSyms, dst_reg: i32, src_reg: i32, size: i32) {
    if size <= 0 { return }
    if size <= 64 {
        emit_inline_memcpy(&mut fc.buf, dst_reg, src_reg, size)
    } else {
        a64.mov(&mut fc.buf, a64.X0, dst_reg)
        a64.mov(&mut fc.buf, a64.X1, src_reg)
        a64.imm(&mut fc.buf, a64.X2, i64(size))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
    }
}

fn emit_memzero_size(fc: &mut FnCodegen, rt: &RuntimeSyms, dst_reg: i32, size: i32) {
    if size <= 0 { return }
    if size <= 64 {
        emit_inline_memzero(&mut fc.buf, dst_reg, size)
    } else {
        a64.mov(&mut fc.buf, a64.X0, dst_reg)
        a64.imm(&mut fc.buf, a64.X1, i64(size))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memzero)
    }
}

// =========================================================================
// 6. Parallel Copy Lowering on CFG Edges (Handles Cycles via x16/x17, d16/d17)
// =========================================================================

struct ScalarMove {
    src_is_reg: bool,
    src_loc: i32,    // reg num if src_is_reg, else negative-offset magnitude from FP
    dst_is_reg: bool,
    dst_loc: i32,
    is_f64: bool,
    done: bool,
}

fn emit_one_gp_move(buf: &mut a64.ArmBuf, mv: ScalarMove) {
    if mv.src_is_reg && mv.dst_is_reg {
        a64.mov(&mut buf, mv.dst_loc, mv.src_loc)
    } else if mv.src_is_reg && !mv.dst_is_reg {
        emit_str_off(&mut buf, mv.src_loc, a64.FP, -i64(mv.dst_loc), 8)
    } else if !mv.src_is_reg && mv.dst_is_reg {
        emit_ldr_off(&mut buf, mv.dst_loc, a64.FP, -i64(mv.src_loc), 8, false)
    } else {
        emit_ldr_off(&mut buf, a64.X16, a64.FP, -i64(mv.src_loc), 8, false)
        emit_str_off(&mut buf, a64.X16, a64.FP, -i64(mv.dst_loc), 8)
    }
}

fn emit_one_fp_move(buf: &mut a64.ArmBuf, mv: ScalarMove) {
    if mv.src_is_reg && mv.dst_is_reg {
        if mv.dst_loc != mv.src_loc { a64.fmov_reg(&mut buf, mv.is_f64, mv.dst_loc, mv.src_loc) }
    } else if mv.src_is_reg && !mv.dst_is_reg {
        emit_str_fp_off(&mut buf, mv.is_f64, mv.src_loc, a64.FP, -i64(mv.dst_loc))
    } else if !mv.src_is_reg && mv.dst_is_reg {
        emit_ldr_fp_off(&mut buf, mv.is_f64, mv.dst_loc, a64.FP, -i64(mv.src_loc))
    } else {
        emit_ldr_fp_off(&mut buf, mv.is_f64, 16, a64.FP, -i64(mv.src_loc))
        emit_str_fp_off(&mut buf, mv.is_f64, 16, a64.FP, -i64(mv.dst_loc))
    }
}

fn run_parallel_moves(buf: &mut a64.ArmBuf, moves: &mut []ScalarMove, is_fp: bool) {
    mut remaining := 0
    for i in 0..moves.len {
        m := moves[i]
        if m.src_is_reg == m.dst_is_reg && m.src_loc == m.dst_loc {
            moves[i].done = true
        } else {
            remaining += 1
        }
    }
    scratch := if is_fp { 17 } else { a64.X8 }
    while remaining > 0 {
        // Find a move whose dst is NOT the src of any other undone move
        mut ready := -1
        for i in 0..moves.len {
            if moves[i].done { continue }
            di_r := moves[i].dst_is_reg
            di_l := moves[i].dst_loc
            mut blocked := false
            for j in 0..moves.len {
                if i == j || moves[j].done { continue }
                if moves[j].src_is_reg == di_r && moves[j].src_loc == di_l {
                    blocked = true
                    break
                }
            }
            if !blocked {
                ready = i
                break
            }
        }
        if ready >= 0 {
            if is_fp { emit_one_fp_move(&mut buf, moves[ready]) }
            else { emit_one_gp_move(&mut buf, moves[ready]) }
            moves[ready].done = true
            remaining -= 1
        } else {
            // Break cycle: pick first undone move, save its dst to scratch (x17/d17)
            mut pick := -1
            for i in 0..moves.len {
                if !moves[i].done { pick = i; break }
            }
            if pick < 0 { break }
            d_r := moves[pick].dst_is_reg
            d_l := moves[pick].dst_loc
            mv_f64 := moves[pick].is_f64
            save_mv := ScalarMove {
                src_is_reg: d_r, src_loc: d_l,
                dst_is_reg: true, dst_loc: scratch,
                is_f64: mv_f64, done: false,
            }
            if is_fp { emit_one_fp_move(&mut buf, save_mv) }
            else { emit_one_gp_move(&mut buf, save_mv) }
            for j in 0..moves.len {
                if !moves[j].done && moves[j].src_is_reg == d_r && moves[j].src_loc == d_l {
                    moves[j].src_is_reg = true
                    moves[j].src_loc = scratch
                }
            }
        }
    }
}

fn emit_edge_copies(fc: &mut FnCodegen, types: &ht.TypeTable, f: &ssa.SsaFunc, rt: &RuntimeSyms,
    target_bb: i32, arg_start: i32, arg_len: i32) {
    if arg_len <= 0 { return }
    p_start := f.blocks[target_bb].params_start
    mut gp_moves: []ScalarMove = []
    mut fp_moves: []ScalarMove = []

    for i in 0..arg_len {
        src_v := f.val_args[arg_start + i]
        dst_v := f.block_params[p_start + i]
        sl := fc.plan.locs[src_v]
        dl := fc.plan.locs[dst_v]
        if dl.cls == .Void || dl.kind == .None { continue }
        if dl.cls == .Gp {
            gp_moves.push(ScalarMove {
                src_is_reg: sl.kind == .Reg,
                src_loc: if sl.kind == .Reg { sl.reg_lo } else { sl.spill_off },
                dst_is_reg: dl.kind == .Reg,
                dst_loc: if dl.kind == .Reg { dl.reg_lo } else { dl.spill_off },
                is_f64: false,
                done: false,
            })
        } else if dl.cls == .Fp {
            fp_moves.push(ScalarMove {
                src_is_reg: sl.kind == .Reg,
                src_loc: if sl.kind == .Reg { sl.reg_lo } else { sl.spill_off },
                dst_is_reg: dl.kind == .Reg,
                dst_loc: if dl.kind == .Reg { dl.reg_lo } else { dl.spill_off },
                is_f64: dl.is_f64,
                done: false,
            })
        } else if dl.cls == .Fat {
            gp_moves.push(ScalarMove {
                src_is_reg: sl.kind == .Reg,
                src_loc: if sl.kind == .Reg { sl.reg_lo } else { sl.spill_off },
                dst_is_reg: dl.kind == .Reg,
                dst_loc: if dl.kind == .Reg { dl.reg_lo } else { dl.spill_off },
                is_f64: false,
                done: false,
            })
            gp_moves.push(ScalarMove {
                src_is_reg: sl.kind == .Reg,
                src_loc: if sl.kind == .Reg { sl.reg_hi } else { sl.spill_off - 8 },
                dst_is_reg: dl.kind == .Reg,
                dst_loc: if dl.kind == .Reg { dl.reg_hi } else { dl.spill_off - 8 },
                is_f64: false,
                done: false,
            })
        } else if dl.cls == .Agg {
            sz := type_size(&types, f.vals[dst_v].ty)
            if sz > 0 && sl.spill_off != dl.spill_off {
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(dl.spill_off))
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(sl.spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
            }
        }
    }

    if gp_moves.len > 0 { run_parallel_moves(&mut fc.buf, &mut gp_moves, false) }
    if fp_moves.len > 0 { run_parallel_moves(&mut fc.buf, &mut fp_moves, true) }
}

// =========================================================================
// 7. Instruction Lowering (All SsaInstKind Ops)
// =========================================================================

fn emit_overflow_check(fc: &mut FnCodegen, types: &ht.TypeTable, ins: &ssa.SsaInst) {
    ty := ins.aux_ty
    sz := type_size(&types, ty)
    is_unsigned := ssa.is_unsigned_int_ty(&types, ty)
    op := ins.aux
    ra := load_gp_val(&mut fc, ins.op_a, a64.X0)
    rb := load_gp_val(&mut fc, ins.op_b, a64.X1)

    if op == hb.BINOP_DIV || op == hb.BINOP_MOD {
        // Check rhs == 0 -> trap 102
        a64.cbz(&mut fc.buf, true, rb, fc.trap_102)
        // Signed MIN / -1 -> trap 101
        if !is_unsigned {
            min_v: i64 = if sz == 1 { -128 }
                else if sz == 2 { -32768 }
                else if sz == 4 { -2147483648 }
                else { -9223372036854775807 - 1 }
            ok_lbl := a64.label(&mut fc.buf)
            emit_cmp_imm_any(&mut fc.buf, true, rb, -1)
            a64.b_cond(&mut fc.buf, a64.CC_NE, ok_lbl)
            emit_cmp_imm_any(&mut fc.buf, true, ra, min_v)
            a64.b_cond(&mut fc.buf, a64.CC_EQ, fc.trap_101)
            a64.mark(&mut fc.buf, ok_lbl)
        }
        return
    }

    if op == hb.BINOP_ADD {
        if sz == 4 || sz == 8 {
            wide := sz == 8
            a64.add_reg(&mut fc.buf, wide, true, a64.X16, ra, rb)
            a64.b_cond(&mut fc.buf, if is_unsigned { a64.CC_CS } else { a64.CC_VS }, fc.trap_101)
        } else {
            a64.add_reg(&mut fc.buf, true, false, a64.X16, ra, rb)
            emit_normalize_int(&mut fc.buf, &types, ty, a64.X17, a64.X16)
            a64.cmp_reg(&mut fc.buf, true, a64.X16, a64.X17)
            a64.b_cond(&mut fc.buf, a64.CC_NE, fc.trap_101)
        }
        return
    }

    if op == hb.BINOP_SUB {
        if sz == 4 || sz == 8 {
            wide := sz == 8
            a64.sub_reg(&mut fc.buf, wide, true, a64.X16, ra, rb)
            a64.b_cond(&mut fc.buf, if is_unsigned { a64.CC_CC } else { a64.CC_VS }, fc.trap_101)
        } else {
            a64.sub_reg(&mut fc.buf, true, false, a64.X16, ra, rb)
            emit_normalize_int(&mut fc.buf, &types, ty, a64.X17, a64.X16)
            a64.cmp_reg(&mut fc.buf, true, a64.X16, a64.X17)
            a64.b_cond(&mut fc.buf, a64.CC_NE, fc.trap_101)
        }
        return
    }

    if op == hb.BINOP_MUL {
        if sz == 8 {
            if is_unsigned {
                a64.umulh(&mut fc.buf, a64.X17, ra, rb)
                a64.cbnz(&mut fc.buf, true, a64.X17, fc.trap_101)
            } else {
                a64.mul(&mut fc.buf, true, a64.X16, ra, rb)
                a64.smulh(&mut fc.buf, a64.X17, ra, rb)
                a64.asr_imm(&mut fc.buf, true, a64.X2, a64.X16, 63)
                a64.cmp_reg(&mut fc.buf, true, a64.X17, a64.X2)
                a64.b_cond(&mut fc.buf, a64.CC_NE, fc.trap_101)
            }
        } else {
            a64.mul(&mut fc.buf, true, a64.X16, ra, rb)
            emit_normalize_int(&mut fc.buf, &types, ty, a64.X17, a64.X16)
            a64.cmp_reg(&mut fc.buf, true, a64.X16, a64.X17)
            a64.b_cond(&mut fc.buf, a64.CC_NE, fc.trap_101)
        }
    }
}

fn emit_inst(m: &mut obj.ObjectModule, hir: &hb.HirProgram, f: &ssa.SsaFunc,
    fc: &mut FnCodegen, rt: &RuntimeSyms, fn_syms: &[]i32, ins: &ssa.SsaInst) {
    types := &hir.types
    k := ins.kind
    if k == .Nop { return }

    if k == .ConstInt {
        if ins.res < 0 || fc.plan.locs[ins.res].cls == .Void { return }
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        a64.imm(&mut fc.buf, dst, ins.imm_i64)
        emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .ConstFloat {
        if ins.res < 0 { return }
        is64 := is_f64_ty(&types, ins.ty)
        vd := dst_fp_reg(&fc, ins.res, 16)
        a64.imm(&mut fc.buf, a64.X16, ins.imm_i64)
        a64.fmov_to_fp(&mut fc.buf, is64, vd, a64.X16)
        commit_fp_dst(&mut fc, ins.res, vd)
        return
    }

    if k == .ConstStr {
        if ins.res < 0 { return }
        text := f.const_strs[ins.str_idx].clone()
        fc.ro_counter += 1
        sym := append_rodata_dunder_str(&mut m, "__str_" + f.fn_id.str() + "_" + fc.ro_counter.str(), text)
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        emit_adrp_sym(&mut fc.buf, &mut fc.relocs, dst, sym, 0)
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .ConstCStr {
        if ins.res < 0 { return }
        text := f.const_strs[ins.str_idx].clone()
        fc.ro_counter += 1
        sym := append_rodata_cstr(&mut m, "__cstr_" + f.fn_id.str() + "_" + fc.ro_counter.str(), text)
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        emit_adrp_sym(&mut fc.buf, &mut fc.relocs, dst, sym, 0)
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .ConstWStr {
        if ins.res < 0 { return }
        text := f.const_strs[ins.str_idx].clone()
        mut blob: []u8 = []
        for i in 0..text.len {
            blob.push(text[i])
            blob.push(u8(0))
        }
        blob.push(u8(0))
        blob.push(u8(0))
        off := obj.append_rodata(&mut m, &blob, 2)
        fc.ro_counter += 1
        sym := obj.add_symbol(&mut m, "__wstr_" + f.fn_id.str() + "_" + fc.ro_counter.str(), .RodataBlob, .Rodata, off, blob.len, false)
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        emit_adrp_sym(&mut fc.buf, &mut fc.relocs, dst, sym, 0)
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .ConstBlob {
        if ins.res < 0 { return }
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        bid := i32(ins.imm_i64)
        if ins.aux == 1 || ins.aux == 2 {
            // extern static address (aux == 1) or value (aux == 2)
            if bid >= 0 && bid < hir.extern_statics.len {
                es := &hir.extern_statics[bid]
                lib := if es.extern_lib != "" { es.extern_lib.clone() } else { "c" }
                sym_name := if es.extern_symbol != "" { es.extern_symbol.clone() } else { es.name.clone() }
                mut spec := native_imports.data_symbol_spec(lib, sym_name)
                spec.weak = es.link_weak
                spec.delay = es.link_delay
                imp_id := obj.add_import(&mut m, &spec)
                lbl := a64.label(&mut fc.buf)
                a64.mark(&mut fc.buf, lbl)
                a64.nop(&mut fc.buf)
                a64.nop(&mut fc.buf)
                fc.imp_sites.push(PendingImport { site_lbl: lbl, imp_id: imp_id })
                if ins.aux == 1 {
                    a64.mov(&mut fc.buf, dst, a64.X16)
                } else {
                    sz := type_size(&types, ins.ty)
                    w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
                    emit_ldr_off(&mut fc.buf, dst, a64.X16, 0, w, is_signed_int_ty(&types, ins.ty))
                }
            } else {
                a64.imm(&mut fc.buf, dst, 0)
            }
            commit_gp_dst(&mut fc, ins.res, dst)
            return
        }
        if bid >= 0 && bid < hir.embed_starts.len {
            bs := hir.embed_starts[bid]
            bc := hir.embed_counts[bid]
            mut blob: []u8 = []
            for i in 0..bc { blob.push(hir.embed_blobs[bs + i]) }
            off := obj.append_rodata(&mut m, &blob, 8)
            fc.ro_counter += 1
            sym := obj.add_symbol(&mut m, "__blob_" + f.fn_id.str() + "_" + fc.ro_counter.str(), .RodataBlob, .Rodata, off, blob.len, false)
            emit_adrp_sym(&mut fc.buf, &mut fc.relocs, dst, sym, 0)
        } else {
            a64.imm(&mut fc.buf, dst, 0)
        }
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .ConstFn {
        if ins.res < 0 { return }
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        fid := ins.aux
        if fid >= 0 && fid < fn_syms.len && fn_syms[fid] >= 0 {
            emit_adrp_sym(&mut fc.buf, &mut fc.relocs, dst, fn_syms[fid], 0)
        } else {
            a64.imm(&mut fc.buf, dst, 0)
        }
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .Copy {
        if ins.res < 0 { return }
        cls := fc.plan.locs[ins.res].cls
        if cls == .Void { return }
        if cls == .Gp {
            src := load_gp_val(&mut fc, ins.op_a, a64.X0)
            store_gp_val(&mut fc, ins.res, src)
        } else if cls == .Fp {
            src := load_fp_val(&mut fc, ins.op_a, 16)
            store_fp_val(&mut fc, ins.res, src)
        } else if cls == .Fat {
            load_fat_into(&mut fc, ins.op_a, a64.X0, a64.X1)
            store_fat_val(&mut fc, ins.res, a64.X0, a64.X1)
        } else if cls == .Agg {
            sz := type_size(&types, ins.ty)
            if sz > 0 {
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[ins.res].spill_off))
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[ins.op_a].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
            }
        }
        return
    }

    if k == .Binary {
        if ins.res < 0 { return }
        aty := f.vals[ins.op_a].ty
        ak := types.entries[aty].kind
        op := ins.aux

        // String binary ops
        if ak == .String {
            if op == hb.BINOP_ADD {
                load_gp_into(&mut fc, ins.op_a, a64.X0)
                load_gp_into(&mut fc, ins.op_b, a64.X1)
                emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_concat)
                store_gp_val(&mut fc, ins.res, a64.X0)
            } else if op == hb.BINOP_EQ || op == hb.BINOP_NE {
                load_gp_into(&mut fc, ins.op_a, a64.X4)
                load_gp_into(&mut fc, ins.op_b, a64.X5)
                a64.ldr(&mut fc.buf, a64.X1, a64.X4, 0, 8, false)
                a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X4, 8)
                a64.ldr(&mut fc.buf, a64.X3, a64.X5, 0, 8, false)
                a64.add_imm(&mut fc.buf, true, false, a64.X2, a64.X5, 8)
                emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_eq)
                if op == hb.BINOP_NE {
                    a64.imm(&mut fc.buf, a64.X16, 1)
                    a64.eor_reg(&mut fc.buf, true, a64.X0, a64.X0, a64.X16)
                }
                store_gp_val(&mut fc, ins.res, a64.X0)
            } else {
                load_gp_into(&mut fc, ins.op_a, a64.X4)
                load_gp_into(&mut fc, ins.op_b, a64.X5)
                a64.ldr(&mut fc.buf, a64.X1, a64.X4, 0, 8, false)
                a64.add_imm(&mut fc.buf, true, false, a64.X0, a64.X4, 8)
                a64.ldr(&mut fc.buf, a64.X3, a64.X5, 0, 8, false)
                a64.add_imm(&mut fc.buf, true, false, a64.X2, a64.X5, 8)
                emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_cmp)
                a64.cmp_imm(&mut fc.buf, true, a64.X0, 0)
                cc := if op == hb.BINOP_LT { a64.CC_LT }
                    else if op == hb.BINOP_LE { a64.CC_LE }
                    else if op == hb.BINOP_GT { a64.CC_GT }
                    else { a64.CC_GE }
                a64.cset(&mut fc.buf, a64.X0, cc)
                store_gp_val(&mut fc, ins.res, a64.X0)
            }
            return
        }

        // FatStr binary ops
        if ak == .FatStr {
            load_fat_into(&mut fc, ins.op_a, a64.X0, a64.X1)
            load_fat_into(&mut fc, ins.op_b, a64.X2, a64.X3)
            if op == hb.BINOP_EQ || op == hb.BINOP_NE {
                emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_eq)
                if op == hb.BINOP_NE {
                    a64.imm(&mut fc.buf, a64.X16, 1)
                    a64.eor_reg(&mut fc.buf, true, a64.X0, a64.X0, a64.X16)
                }
                store_gp_val(&mut fc, ins.res, a64.X0)
            } else {
                emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_cmp)
                a64.cmp_imm(&mut fc.buf, true, a64.X0, 0)
                cc := if op == hb.BINOP_LT { a64.CC_LT }
                    else if op == hb.BINOP_LE { a64.CC_LE }
                    else if op == hb.BINOP_GT { a64.CC_GT }
                    else { a64.CC_GE }
                a64.cset(&mut fc.buf, a64.X0, cc)
                store_gp_val(&mut fc, ins.res, a64.X0)
            }
            return
        }

        // Float binary ops
        if ak == .F32 || ak == .F64 {
            is64 := ak == .F64
            va := load_fp_val(&mut fc, ins.op_a, 16)
            vb := load_fp_val(&mut fc, ins.op_b, 17)
            if op == hb.BINOP_ADD || op == hb.BINOP_SUB || op == hb.BINOP_MUL || op == hb.BINOP_DIV {
                vd := dst_fp_reg(&fc, ins.res, 16)
                if op == hb.BINOP_ADD { a64.fadd(&mut fc.buf, is64, vd, va, vb) }
                else if op == hb.BINOP_SUB { a64.fsub(&mut fc.buf, is64, vd, va, vb) }
                else if op == hb.BINOP_MUL { a64.fmul(&mut fc.buf, is64, vd, va, vb) }
                else { a64.fdiv(&mut fc.buf, is64, vd, va, vb) }
                commit_fp_dst(&mut fc, ins.res, vd)
            } else {
                a64.fcmp(&mut fc.buf, is64, va, vb)
                cc := if op == hb.BINOP_EQ { a64.CC_EQ }
                    else if op == hb.BINOP_NE { a64.CC_NE }
                    else if op == hb.BINOP_LT { a64.CC_MI }
                    else if op == hb.BINOP_LE { a64.CC_LS }
                    else if op == hb.BINOP_GT { a64.CC_GT }
                    else { a64.CC_GE }
                dst := dst_gp_reg(&fc, ins.res, a64.X0)
                a64.cset(&mut fc.buf, dst, cc)
                commit_gp_dst(&mut fc, ins.res, dst)
            }
            return
        }

        // Integer / Bool / Ptr / Enum binary ops
        ra := load_gp_val(&mut fc, ins.op_a, a64.X0)
        rb := load_gp_val(&mut fc, ins.op_b, a64.X1)
        dst := dst_gp_reg(&fc, ins.res, a64.X2)
        is_u := ssa.is_unsigned_int_ty(&types, aty) || ak == .Bool || ak == .Ptr || ak == .Ref || ak == .MutRef || ak == .RawConst || ak == .RawMut
        if op == hb.BINOP_ADD {
            a64.add_reg(&mut fc.buf, true, false, dst, ra, rb)
            emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        } else if op == hb.BINOP_SUB {
            a64.sub_reg(&mut fc.buf, true, false, dst, ra, rb)
            emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        } else if op == hb.BINOP_MUL {
            a64.mul(&mut fc.buf, true, dst, ra, rb)
            emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        } else if op == hb.BINOP_DIV {
            if is_u { a64.udiv(&mut fc.buf, true, dst, ra, rb) }
            else { a64.sdiv(&mut fc.buf, true, dst, ra, rb) }
            emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        } else if op == hb.BINOP_MOD {
            if is_u { a64.udiv(&mut fc.buf, true, a64.X16, ra, rb) }
            else { a64.sdiv(&mut fc.buf, true, a64.X16, ra, rb) }
            a64.msub(&mut fc.buf, true, dst, a64.X16, rb, ra)
            emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        } else if op == hb.BINOP_AND {
            a64.and_reg(&mut fc.buf, true, false, dst, ra, rb)
        } else if op == hb.BINOP_OR {
            a64.orr_reg(&mut fc.buf, true, dst, ra, rb)
        } else {
            a64.cmp_reg(&mut fc.buf, true, ra, rb)
            cc := if op == hb.BINOP_EQ { a64.CC_EQ }
                else if op == hb.BINOP_NE { a64.CC_NE }
                else if op == hb.BINOP_LT { if is_u { a64.CC_LO } else { a64.CC_LT } }
                else if op == hb.BINOP_LE { if is_u { a64.CC_LS } else { a64.CC_LE } }
                else if op == hb.BINOP_GT { if is_u { a64.CC_HI } else { a64.CC_GT } }
                else { if is_u { a64.CC_HS } else { a64.CC_GE } }
            a64.cset(&mut fc.buf, dst, cc)
        }
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .Unary {
        if ins.res < 0 { return }
        aty := f.vals[ins.op_a].ty
        ak := types.entries[aty].kind
        if ak == .F32 || ak == .F64 {
            is64 := ak == .F64
            va := load_fp_val(&mut fc, ins.op_a, 16)
            vd := dst_fp_reg(&fc, ins.res, 16)
            a64.fneg(&mut fc.buf, is64, vd, va)
            commit_fp_dst(&mut fc, ins.res, vd)
            return
        }
        ra := load_gp_val(&mut fc, ins.op_a, a64.X0)
        dst := dst_gp_reg(&fc, ins.res, a64.X1)
        if ins.aux == hb.UNOP_NEG {
            a64.neg(&mut fc.buf, true, false, dst, ra)
            emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        } else if ins.aux == hb.UNOP_NOT {
            a64.cmp_imm(&mut fc.buf, true, ra, 0)
            a64.cset(&mut fc.buf, dst, a64.CC_EQ)
        } else {
            a64.mvn(&mut fc.buf, true, dst, ra)
            emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        }
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .Cast {
        if ins.res < 0 { return }
        src_ty := f.vals[ins.op_a].ty
        dst_ty := ins.ty
        sk := types.entries[src_ty].kind
        dk := types.entries[dst_ty].kind

        // Special ssa_lower casts: String -> Ptr (+8), Array -> Ptr ([arr+0])
        if sk == .String && (dk == .Ptr || dk == .RawConst || dk == .RawMut) {
            ra := load_gp_val(&mut fc, ins.op_a, a64.X0)
            dst := dst_gp_reg(&fc, ins.res, a64.X1)
            a64.add_imm(&mut fc.buf, true, false, dst, ra, 8)
            commit_gp_dst(&mut fc, ins.res, dst)
            return
        }
        if sk == .Array && (dk == .Ptr || dk == .RawConst || dk == .RawMut) {
            ra := load_gp_val(&mut fc, ins.op_a, a64.X0)
            dst := dst_gp_reg(&fc, ins.res, a64.X1)
            a64.ldr(&mut fc.buf, dst, ra, 0, 8, false)
            commit_gp_dst(&mut fc, ins.res, dst)
            return
        }

        // Float <-> Float
        if (sk == .F32 || sk == .F64) && (dk == .F32 || dk == .F64) {
            va := load_fp_val(&mut fc, ins.op_a, 16)
            vd := dst_fp_reg(&fc, ins.res, 16)
            if sk == .F32 && dk == .F64 { a64.fcvt_f32_to_f64(&mut fc.buf, vd, va) }
            else if sk == .F64 && dk == .F32 { a64.fcvt_f64_to_f32(&mut fc.buf, vd, va) }
            else if vd != va { a64.fmov_reg(&mut fc.buf, dk == .F64, vd, va) }
            commit_fp_dst(&mut fc, ins.res, vd)
            return
        }

        // Int -> Float
        if (dk == .F32 || dk == .F64) {
            ra := load_gp_val(&mut fc, ins.op_a, a64.X0)
            vd := dst_fp_reg(&fc, ins.res, 16)
            if ssa.is_unsigned_int_ty(&types, src_ty) || sk == .Bool {
                a64.ucvtf(&mut fc.buf, true, dk == .F64, vd, ra)
            } else {
                a64.scvtf(&mut fc.buf, true, dk == .F64, vd, ra)
            }
            commit_fp_dst(&mut fc, ins.res, vd)
            return
        }

        // Float -> Int
        if (sk == .F32 || sk == .F64) {
            va := load_fp_val(&mut fc, ins.op_a, 16)
            dst := dst_gp_reg(&fc, ins.res, a64.X0)
            if ssa.is_unsigned_int_ty(&types, dst_ty) {
                a64.fcvtzu(&mut fc.buf, true, sk == .F64, dst, va)
            } else {
                a64.fcvtzs(&mut fc.buf, true, sk == .F64, dst, va)
            }
            emit_normalize_int(&mut fc.buf, &types, dst_ty, dst, dst)
            commit_gp_dst(&mut fc, ins.res, dst)
            return
        }

        // GP -> GP (int/bool/ptr/ref/fn/closure)
        if fc.plan.locs[ins.res].cls == .Gp {
            ra := load_gp_val(&mut fc, ins.op_a, a64.X0)
            dst := dst_gp_reg(&fc, ins.res, a64.X1)
            if dk == .Bool {
                a64.cmp_imm(&mut fc.buf, true, ra, 0)
                a64.cset(&mut fc.buf, dst, a64.CC_NE)
            } else {
                emit_normalize_int(&mut fc.buf, &types, dst_ty, dst, ra)
            }
            commit_gp_dst(&mut fc, ins.res, dst)
        }
        return
    }

    if k == .SlotAddr {
        if ins.res < 0 { return }
        sl_off := fc.slot_offs[ins.aux]
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        emit_add_imm_any(&mut fc.buf, dst, a64.FP, -i64(sl_off) + ins.imm_i64)
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .FieldAddr {
        if ins.res < 0 { return }
        base := load_gp_val(&mut fc, ins.op_a, a64.X0)
        dst := dst_gp_reg(&fc, ins.res, a64.X1)
        emit_add_imm_any(&mut fc.buf, dst, base, ins.imm_i64)
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .IndexAddr {
        if ins.res < 0 { return }
        base := load_gp_val(&mut fc, ins.op_a, a64.X0)
        idx := load_gp_val(&mut fc, ins.op_b, a64.X1)
        dst := dst_gp_reg(&fc, ins.res, a64.X2)
        stride := ins.imm_i64
        if stride == 0 {
            a64.mov(&mut fc.buf, dst, base)
        } else if stride == 1 {
            a64.add_reg(&mut fc.buf, true, false, dst, base, idx)
        } else if stride == 2 {
            a64.add_reg_lsl(&mut fc.buf, true, dst, base, idx, 1)
        } else if stride == 4 {
            a64.add_reg_lsl(&mut fc.buf, true, dst, base, idx, 2)
        } else if stride == 8 {
            a64.add_reg_lsl(&mut fc.buf, true, dst, base, idx, 3)
        } else {
            a64.imm(&mut fc.buf, a64.X16, stride)
            a64.madd(&mut fc.buf, true, dst, idx, a64.X16, base)
        }
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .Load {
        if ins.res < 0 { return }
        cls := fc.plan.locs[ins.res].cls
        if cls == .Void { return }
        addr := load_gp_val(&mut fc, ins.op_a, a64.X0)
        if cls == .Gp {
            sz := type_size(&types, ins.ty)
            w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
            sext := is_signed_int_ty(&types, ins.ty)
            dst := dst_gp_reg(&fc, ins.res, a64.X1)
            emit_ldr_off(&mut fc.buf, dst, addr, ins.imm_i64, w, sext)
            commit_gp_dst(&mut fc, ins.res, dst)
        } else if cls == .Fp {
            is64 := is_f64_ty(&types, ins.ty)
            vd := dst_fp_reg(&fc, ins.res, 16)
            emit_ldr_fp_off(&mut fc.buf, is64, vd, addr, ins.imm_i64)
            commit_fp_dst(&mut fc, ins.res, vd)
        } else if cls == .Fat {
            emit_ldr_off(&mut fc.buf, a64.X1, addr, ins.imm_i64, 8, false)
            emit_ldr_off(&mut fc.buf, a64.X2, addr, ins.imm_i64 + 8, 8, false)
            store_fat_val(&mut fc, ins.res, a64.X1, a64.X2)
        } else if cls == .Agg {
            sz := type_size(&types, ins.ty)
            if sz > 0 {
                emit_add_imm_any(&mut fc.buf, a64.X7, addr, ins.imm_i64)
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[ins.res].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
            }
        }
        return
    }

    if k == .Store {
        cls := fc.plan.locs[ins.op_b].cls
        if cls == .Void { return }
        addr := load_gp_val(&mut fc, ins.op_a, a64.X0)
        if cls == .Gp {
            val := load_gp_val(&mut fc, ins.op_b, a64.X1)
            sz := type_size(&types, ins.ty)
            w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
            emit_str_off(&mut fc.buf, val, addr, ins.imm_i64, w)
        } else if cls == .Fp {
            is64 := is_f64_ty(&types, ins.ty)
            vv := load_fp_val(&mut fc, ins.op_b, 16)
            emit_str_fp_off(&mut fc.buf, is64, vv, addr, ins.imm_i64)
        } else if cls == .Fat {
            a64.mov(&mut fc.buf, a64.X3, addr)
            load_fat_into(&mut fc, ins.op_b, a64.X1, a64.X2)
            emit_str_off(&mut fc.buf, a64.X1, a64.X3, ins.imm_i64, 8)
            emit_str_off(&mut fc.buf, a64.X2, a64.X3, ins.imm_i64 + 8, 8)
        } else if cls == .Agg {
            sz := type_size(&types, ins.ty)
            if sz > 0 {
                emit_add_imm_any(&mut fc.buf, a64.X6, addr, ins.imm_i64)
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[ins.op_b].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
            }
        }
        return
    }

    if k == .FatMake {
        if ins.res < 0 { return }
        load_gp_into(&mut fc, ins.op_a, a64.X0)
        load_gp_into(&mut fc, ins.op_b, a64.X1)
        store_fat_val(&mut fc, ins.res, a64.X0, a64.X1)
        return
    }

    if k == .FatPtr {
        if ins.res < 0 { return }
        load_fat_into(&mut fc, ins.op_a, a64.X0, a64.X1)
        store_gp_val(&mut fc, ins.res, a64.X0)
        return
    }

    if k == .FatLen {
        if ins.res < 0 { return }
        load_fat_into(&mut fc, ins.op_a, a64.X0, a64.X1)
        emit_normalize_int(&mut fc.buf, &types, ins.ty, a64.X1, a64.X1)
        store_gp_val(&mut fc, ins.res, a64.X1)
        return
    }

    if k == .Len {
        if ins.res < 0 { return }
        aty := f.vals[ins.op_a].ty
        ak := types.entries[aty].kind
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        if ak == .String {
            ra := load_gp_val(&mut fc, ins.op_a, a64.X1)
            a64.ldr(&mut fc.buf, dst, ra, 0, 8, false)
        } else if ak == .Array {
            ra := load_gp_val(&mut fc, ins.op_a, a64.X1)
            a64.ldr(&mut fc.buf, dst, ra, 8, 8, false)
        } else if ak == .FixedArr {
            a64.imm(&mut fc.buf, dst, i64(types.entries[aty].count))
        } else {
            a64.imm(&mut fc.buf, dst, 0)
        }
        emit_normalize_int(&mut fc.buf, &types, ins.ty, dst, dst)
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .Discriminant {
        if ins.res < 0 { return }
        sl := fc.plan.locs[ins.op_a]
        dst := dst_gp_reg(&fc, ins.res, a64.X0)
        if sl.cls == .Agg {
            emit_ldr_off(&mut fc.buf, dst, a64.FP, -i64(sl.spill_off), 4, true)
        } else {
            ra := load_gp_val(&mut fc, ins.op_a, a64.X1)
            a64.sxtw(&mut fc.buf, dst, ra)
        }
        commit_gp_dst(&mut fc, ins.res, dst)
        return
    }

    if k == .SetDiscriminant {
        addr := load_gp_val(&mut fc, ins.op_a, a64.X0)
        a64.imm(&mut fc.buf, a64.X16, i64(ins.aux))
        a64.str(&mut fc.buf, a64.X16, addr, 0, 4)
        return
    }

    if k == .AllocHeap {
        if ins.res < 0 { return }
        rk := types.entries[ins.ty].kind
        if rk == .Array {
            // Dynamic array allocation: op_a = count, imm_i64 = stride
            if ins.op_a >= 0 { load_gp_into(&mut fc, ins.op_a, a64.X0) }
            else { a64.imm(&mut fc.buf, a64.X0, 0) }
            stride := if ins.imm_i64 > 0 { ins.imm_i64 } else { 8 }
            a64.imm(&mut fc.buf, a64.X1, stride)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_alloc)
            store_gp_val(&mut fc, ins.res, a64.X0)
        } else {
            // Raw / Region bump allocation: op_a * stride (or imm_i64 bytes if op_a < 0)
            if ins.op_a >= 0 {
                load_gp_into(&mut fc, ins.op_a, a64.X0)
                stride := if ins.imm_i64 > 0 { ins.imm_i64 } else { 1 }
                if stride > 1 {
                    a64.imm(&mut fc.buf, a64.X16, stride)
                    a64.mul(&mut fc.buf, true, a64.X0, a64.X0, a64.X16)
                }
            } else {
                a64.imm(&mut fc.buf, a64.X0, if ins.imm_i64 > 0 { ins.imm_i64 } else { 16 })
            }
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
            store_gp_val(&mut fc, ins.res, a64.X0)
        }
        return
    }

    if k == .MemCopy {
        sz := i32(ins.imm_i64)
        if sz <= 0 { return }
        load_gp_into(&mut fc, ins.op_a, a64.X6)
        load_gp_into(&mut fc, ins.op_b, a64.X7)
        emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
        return
    }

    if k == .MemZero {
        sz := i32(ins.imm_i64)
        if sz <= 0 { return }
        load_gp_into(&mut fc, ins.op_a, a64.X6)
        emit_memzero_size(&mut fc, &rt, a64.X6, sz)
        return
    }

    if k == .Select {
        if ins.res < 0 { return }
        cls := fc.plan.locs[ins.res].cls
        if cls == .Void { return }
        rc := load_gp_val(&mut fc, ins.op_a, a64.X3)
        a64.cmp_imm(&mut fc.buf, true, rc, 0)
        if cls == .Gp {
            rt_r := load_gp_val(&mut fc, ins.op_b, a64.X0)
            rf_r := load_gp_val(&mut fc, ins.op_c, a64.X1)
            dst := dst_gp_reg(&fc, ins.res, a64.X2)
            a64.csel(&mut fc.buf, true, dst, rt_r, rf_r, a64.CC_NE)
            commit_gp_dst(&mut fc, ins.res, dst)
        } else {
            lbl_f := a64.label(&mut fc.buf)
            lbl_d := a64.label(&mut fc.buf)
            a64.b_cond(&mut fc.buf, a64.CC_EQ, lbl_f)
            if cls == .Fp {
                vt := load_fp_val(&mut fc, ins.op_b, 16)
                store_fp_val(&mut fc, ins.res, vt)
                a64.b(&mut fc.buf, lbl_d)
                a64.mark(&mut fc.buf, lbl_f)
                vf := load_fp_val(&mut fc, ins.op_c, 16)
                store_fp_val(&mut fc, ins.res, vf)
            } else if cls == .Fat {
                load_fat_into(&mut fc, ins.op_b, a64.X0, a64.X1)
                store_fat_val(&mut fc, ins.res, a64.X0, a64.X1)
                a64.b(&mut fc.buf, lbl_d)
                a64.mark(&mut fc.buf, lbl_f)
                load_fat_into(&mut fc, ins.op_c, a64.X0, a64.X1)
                store_fat_val(&mut fc, ins.res, a64.X0, a64.X1)
            } else if cls == .Agg {
                sz := type_size(&types, ins.ty)
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[ins.res].spill_off))
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[ins.op_b].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
                a64.b(&mut fc.buf, lbl_d)
                a64.mark(&mut fc.buf, lbl_f)
                emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[ins.res].spill_off))
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[ins.op_c].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, sz)
            }
            a64.mark(&mut fc.buf, lbl_d)
        }
        return
    }

    if k == .BoundsCheck {
        r_idx := load_gp_val(&mut fc, ins.op_a, a64.X0)
        r_len := load_gp_val(&mut fc, ins.op_b, a64.X1)
        a64.cmp_reg(&mut fc.buf, true, r_idx, r_len)
        if ins.aux == ssa.BOUNDS_LE {
            a64.b_cond(&mut fc.buf, a64.CC_HI, fc.trap_103)
        } else {
            a64.b_cond(&mut fc.buf, a64.CC_HS, fc.trap_103)
        }
        return
    }

    if k == .OverflowCheck {
        emit_overflow_check(&mut fc, &types, &ins)
        return
    }

    if k == .ClosureMake {
        if ins.res < 0 { return }
        te := &types.entries[ins.ty]
        cl_fn_id := if te.closure_fn_id >= 0 { te.closure_fn_id } else { ins.aux }
        // Layout: [entry_fn (8B), drop_fn (8B), cap_0 (aligned 8B), ...]
        mut total_bytes := 16
        for ci in 0..ins.arg_len {
            cty := ht.field_type(&types, ins.ty, ci)
            csz := align_up_i32(type_size(&types, cty), 8)
            total_bytes += if csz < 8 { 8 } else { csz }
        }
        a64.imm(&mut fc.buf, a64.X0, i64(total_bytes))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
        // Store env_ptr into res right away so it survives if any cap copy uses x0..x7
        store_gp_val(&mut fc, ins.res, a64.X0)
        a64.mov(&mut fc.buf, a64.X4, a64.X0)

        // [env + 0] = closure body entry fn address
        if cl_fn_id >= 0 && cl_fn_id < fn_syms.len && fn_syms[cl_fn_id] >= 0 {
            emit_adrp_sym(&mut fc.buf, &mut fc.relocs, a64.X5, fn_syms[cl_fn_id], 0)
        } else {
            a64.imm(&mut fc.buf, a64.X5, 0)
        }
        a64.str(&mut fc.buf, a64.X5, a64.X4, 0, 8)
        // [env + 8] = drop fn (0)
        a64.str(&mut fc.buf, a64.XZR, a64.X4, 8, 8)

        mut cap_off := 16
        for ci in 0..ins.arg_len {
            cv := f.val_args[ins.arg_start + ci]
            cty := f.vals[cv].ty
            ccls := fc.plan.locs[cv].cls
            csz := align_up_i32(type_size(&types, cty), 8)
            step := if csz < 8 { 8 } else { csz }
            load_gp_into(&mut fc, ins.res, a64.X4)
            if ccls == .Gp {
                rv := load_gp_val(&mut fc, cv, a64.X5)
                emit_str_off(&mut fc.buf, rv, a64.X4, i64(cap_off), 8)
            } else if ccls == .Fp {
                vv := load_fp_val(&mut fc, cv, 16)
                emit_str_fp_off(&mut fc.buf, is_f64_ty(&types, cty), vv, a64.X4, i64(cap_off))
            } else if ccls == .Fat {
                load_fat_into(&mut fc, cv, a64.X5, a64.X6)
                emit_str_off(&mut fc.buf, a64.X5, a64.X4, i64(cap_off), 8)
                emit_str_off(&mut fc.buf, a64.X6, a64.X4, i64(cap_off + 8), 8)
            } else if ccls == .Agg {
                emit_add_imm_any(&mut fc.buf, a64.X6, a64.X4, i64(cap_off))
                emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[cv].spill_off))
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, cty))
            }
            cap_off += step
        }
        return
    }
}

// =========================================================================
// 8. Call & Intrinsic Lowering
// =========================================================================

fn ssa_const_str_text(f: &ssa.SsaFunc, v_in: i32) -> string {
    mut v := v_in
    mut steps := 0
    while v >= 0 && v < f.vals.len && steps < 8 {
        steps += 1
        di := f.vals[v].def_inst
        if di < 0 || di >= f.insts.len { return "" }
        ins := f.insts[di]
        if (ins.kind == .ConstStr || ins.kind == .ConstCStr) && ins.str_idx >= 0 && ins.str_idx < f.const_strs.len {
            return f.const_strs[ins.str_idx].clone()
        }
        if ins.kind == .Copy { v = ins.op_a; continue }
        if ins.kind == .Load && ins.aux >= 0 {
            slot := ins.aux
            bb := f.vals[v].def_bb
            if bb >= 0 && bb < f.blocks.len {
                s0 := f.blocks[bb].inst_start
                n0 := f.blocks[bb].inst_len
                mut fv := -1
                for k in 0..n0 {
                    iid := f.block_insts[s0 + k]
                    if iid == di { break }
                    si := f.insts[iid]
                    if si.kind == .Store && si.aux == slot { fv = si.op_b }
                }
                if fv >= 0 { v = fv; continue }
            }
        }
        return ""
    }
    ""
}

fn ssa_const_i64(f: &ssa.SsaFunc, v_in: i32, fallback: i64) -> i64 {
    mut v := v_in
    mut steps := 0
    while v >= 0 && v < f.vals.len && steps < 8 {
        steps += 1
        di := f.vals[v].def_inst
        if di < 0 || di >= f.insts.len { return fallback }
        ins := f.insts[di]
        if ins.kind == .ConstInt { return ins.imm_i64 }
        if ins.kind == .Copy { v = ins.op_a; continue }
        if ins.kind == .Load && ins.aux >= 0 {
            slot := ins.aux
            bb := f.vals[v].def_bb
            if bb >= 0 && bb < f.blocks.len {
                s0 := f.blocks[bb].inst_start
                n0 := f.blocks[bb].inst_len
                mut fv := -1
                for k in 0..n0 {
                    iid := f.block_insts[s0 + k]
                    if iid == di { break }
                    si := f.insts[iid]
                    if si.kind == .Store && si.aux == slot { fv = si.op_b }
                }
                if fv >= 0 { v = fv; continue }
            }
        }
        return fallback
    }
    fallback
}

fn find_struct_field_off(types: &ht.TypeTable, sty: i32, name: string) -> i32 {
    if sty < 0 || sty >= types.entries.len { return -1 }
    te := &types.entries[sty]
    for i in 0..te.count {
        fld := &types.fields[te.inner_a + i]
        if fld.name == name { return fld.offset }
    }
    -1
}

fn emit_load_byte_slice_ptr_len(fc: &mut FnCodegen, types: &ht.TypeTable, f: &ssa.SsaFunc,
    av: i32, ptr_reg: i32, len_reg: i32) {
    aty := f.vals[av].ty
    ak := types.entries[aty].kind
    if ak == .FatSlice || ak == .FatStr || ak == .RegionSlice {
        load_fat_into(&mut fc, av, ptr_reg, len_reg)
    } else if ak == .String {
        load_gp_into(&mut fc, av, a64.X16)
        a64.ldr(&mut fc.buf, len_reg, a64.X16, 0, 8, false)
        a64.add_imm(&mut fc.buf, true, false, ptr_reg, a64.X16, 8)
    } else if ak == .Array {
        load_gp_into(&mut fc, av, a64.X16)
        a64.ldr(&mut fc.buf, ptr_reg, a64.X16, 0, 8, false)
        a64.ldr(&mut fc.buf, len_reg, a64.X16, 8, 8, false)
    } else if ak == .Ref || ak == .MutRef {
        inner := types.entries[aty].inner_a
        ik := types.entries[inner].kind
        load_gp_into(&mut fc, av, a64.X16)
        if ik == .FatSlice || ik == .FatStr || ik == .RegionSlice {
            a64.ldr(&mut fc.buf, ptr_reg, a64.X16, 0, 8, false)
            a64.ldr(&mut fc.buf, len_reg, a64.X16, 8, 8, false)
        } else if ik == .Array {
            a64.ldr(&mut fc.buf, a64.X16, a64.X16, 0, 8, false)
            a64.ldr(&mut fc.buf, ptr_reg, a64.X16, 0, 8, false)
            a64.ldr(&mut fc.buf, len_reg, a64.X16, 8, 8, false)
        } else if ik == .String {
            a64.ldr(&mut fc.buf, a64.X16, a64.X16, 0, 8, false)
            a64.ldr(&mut fc.buf, len_reg, a64.X16, 0, 8, false)
            a64.add_imm(&mut fc.buf, true, false, ptr_reg, a64.X16, 8)
        } else {
            a64.mov(&mut fc.buf, ptr_reg, a64.X16)
            a64.imm(&mut fc.buf, len_reg, i64(type_size(&types, inner)))
        }
    } else {
        load_gp_into(&mut fc, av, ptr_reg)
        a64.imm(&mut fc.buf, len_reg, 0)
    }
}

fn emit_store_sys_status(fc: &mut FnCodegen, types: &ht.TypeTable, f: &ssa.SsaFunc, dest_v: i32, err_reg: i32) {
    if dest_v < 0 { return }
    dty := f.vals[dest_v].ty
    emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[dest_v].spill_off))
    a64.cmp_imm(&mut fc.buf, true, err_reg, 0)
    a64.cset(&mut fc.buf, a64.X7, a64.CC_EQ)
    ok_off := find_struct_field_off(&types, dty, "ok")
    err_off := find_struct_field_off(&types, dty, "error")
    if ok_off >= 0 { emit_str_off(&mut fc.buf, a64.X7, a64.X6, i64(ok_off), 1) }
    if err_off >= 0 { emit_str_off(&mut fc.buf, err_reg, a64.X6, i64(err_off), 4) }
}

fn emit_store_sys_text_result(m: &mut obj.ObjectModule, fc: &mut FnCodegen, types: &ht.TypeTable,
    f: &ssa.SsaFunc, dest_v: i32, str_reg: i32, err_reg: i32) {
    if dest_v < 0 { return }
    dty := f.vals[dest_v].ty
    emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[dest_v].spill_off))
    // If err != 0, replace str_reg with empty string
    lbl_ok := a64.label(&mut fc.buf)
    a64.cbz(&mut fc.buf, true, err_reg, lbl_ok)
    fc.ro_counter += 1
    empty_s := append_rodata_dunder_str(&mut m, "__rt_empty_" + f.fn_id.str() + "_" + fc.ro_counter.str(), "")
    emit_adrp_sym(&mut fc.buf, &mut fc.relocs, str_reg, empty_s, 0)
    a64.mark(&mut fc.buf, lbl_ok)
    a64.cmp_imm(&mut fc.buf, true, err_reg, 0)
    a64.cset(&mut fc.buf, a64.X7, a64.CC_EQ)
    ok_off := find_struct_field_off(&types, dty, "ok")
    val_off := find_struct_field_off(&types, dty, "value")
    err_off := find_struct_field_off(&types, dty, "error")
    if ok_off >= 0 { emit_str_off(&mut fc.buf, a64.X7, a64.X6, i64(ok_off), 1) }
    if val_off >= 0 { emit_str_off(&mut fc.buf, str_reg, a64.X6, i64(val_off), 8) }
    if err_off >= 0 { emit_str_off(&mut fc.buf, err_reg, a64.X6, i64(err_off), 4) }
}

fn map_key_kind_arm64(types: &ht.TypeTable, key_ty: i32) -> i64 {
    if key_ty < 0 || key_ty >= types.entries.len { return 0 }
    k := types.entries[key_ty].kind
    if k == .String { return 1 }
    if k == .FatStr { return 2 }
    0
}

// Materializes a pointer to a value of `expected_ty` into `dst_reg`.
// Returns stack bytes pushed (0 or 16) that caller MUST pop after use!
fn emit_materialize_val_ptr(fc: &mut FnCodegen, types: &ht.TypeTable, rt: &RuntimeSyms, f: &ssa.SsaFunc,
    val_id: i32, expected_ty: i32, dst_reg: i32) -> i32 {
    vty := f.vals[val_id].ty
    vk := types.entries[vty].kind
    if (vk == .Ref || vk == .MutRef) && types.entries[vty].inner_a == expected_ty {
        load_gp_into(&mut fc, val_id, dst_reg)
        return 0
    }
    if expected_ty == ht.TY_STRING && vk == .FatStr {
        load_fat_into(&mut fc, val_id, a64.X0, a64.X1)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_from_fat)
        a64.stp_pre(&mut fc.buf, a64.X0, a64.XZR, a64.SP, -16)
        a64.mov(&mut fc.buf, dst_reg, a64.SP)
        return 16
    }
    if expected_ty == ht.TY_STRING && (vk == .Ref || vk == .MutRef) &&
        types.entries[types.entries[vty].inner_a].kind == .FatStr {
        load_gp_into(&mut fc, val_id, a64.X16)
        a64.ldr(&mut fc.buf, a64.X0, a64.X16, 0, 8, false)
        a64.ldr(&mut fc.buf, a64.X1, a64.X16, 8, 8, false)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_from_fat)
        a64.stp_pre(&mut fc.buf, a64.X0, a64.XZR, a64.SP, -16)
        a64.mov(&mut fc.buf, dst_reg, a64.SP)
        return 16
    }
    cls := fc.plan.locs[val_id].cls
    if cls == .Agg {
        emit_sub_imm_any(&mut fc.buf, dst_reg, a64.FP, i64(fc.plan.locs[val_id].spill_off))
        return 0
    }
    if cls == .Fat {
        load_fat_into(&mut fc, val_id, a64.X16, a64.X17)
        a64.stp_pre(&mut fc.buf, a64.X16, a64.X17, a64.SP, -16)
        a64.mov(&mut fc.buf, dst_reg, a64.SP)
        return 16
    }
    if cls == .Fp {
        load_fp_into(&mut fc, val_id, 16)
        a64.stp_pre(&mut fc.buf, a64.XZR, a64.XZR, a64.SP, -16)
        emit_str_fp_off(&mut fc.buf, is_f64_ty(&types, expected_ty), 16, a64.SP, 0)
        a64.mov(&mut fc.buf, dst_reg, a64.SP)
        return 16
    }
    load_gp_into(&mut fc, val_id, a64.X16)
    a64.stp_pre(&mut fc.buf, a64.X16, a64.XZR, a64.SP, -16)
    a64.mov(&mut fc.buf, dst_reg, a64.SP)
    16
}

fn emit_load_typed_to_dest(fc: &mut FnCodegen, types: &ht.TypeTable, rt: &RuntimeSyms, f: &ssa.SsaFunc,
    src_ptr_reg: i32, dest_v: i32) {
    if dest_v < 0 { return }
    d_ty := f.vals[dest_v].ty
    d_cls := fc.plan.locs[dest_v].cls
    if d_cls == .Gp {
        sz := type_size(&types, d_ty)
        w := if sz == 1 || sz == 2 || sz == 4 || sz == 8 { sz } else { 8 }
        emit_ldr_off(&mut fc.buf, a64.X0, src_ptr_reg, 0, w, is_signed_int_ty(&types, d_ty))
        store_gp_val(&mut fc, dest_v, a64.X0)
    } else if d_cls == .Fp {
        emit_ldr_fp_off(&mut fc.buf, is_f64_ty(&types, d_ty), 16, src_ptr_reg, 0)
        store_fp_val(&mut fc, dest_v, 16)
    } else if d_cls == .Fat {
        emit_ldr_off(&mut fc.buf, a64.X0, src_ptr_reg, 0, 8, false)
        emit_ldr_off(&mut fc.buf, a64.X1, src_ptr_reg, 8, 8, false)
        store_fat_val(&mut fc, dest_v, a64.X0, a64.X1)
    } else if d_cls == .Agg {
        emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[dest_v].spill_off))
        emit_memcpy_size(&mut fc, &rt, a64.X6, src_ptr_reg, type_size(&types, d_ty))
    }
}

fn emit_map_intrinsic_arm64(m: &mut obj.ObjectModule, hir: &hb.HirProgram, f: &ssa.SsaFunc,
    fc: &mut FnCodegen, rt: &RuntimeSyms, tm: &ssa.SsaTerm) -> bool {
    types := &hir.types
    id := tm.callee
    a_start := tm.arg_start
    a_len := tm.arg_len

    // .hash() intrinsic
    if id == hb.INTRINSIC_HASH && a_len >= 1 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        mut aty := f.vals[av].ty
        is_ref := types.entries[aty].kind == .Ref || types.entries[aty].kind == .MutRef
        inner := if is_ref { types.entries[aty].inner_a } else { aty }
        kk := map_key_kind_arm64(&types, inner)
        ksz := if type_size(&types, inner) > 0 { type_size(&types, inner) } else { 8 }
        pushed := emit_materialize_val_ptr(&mut fc, &types, &rt, &f, av, inner, a64.X0)
        a64.imm(&mut fc.buf, a64.X1, kk)
        a64.imm(&mut fc.buf, a64.X2, i64(ksz))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.hash_key)
        if pushed > 0 { a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, i64(pushed)) }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }

    is_map_op := (id >= hb.INTRINSIC_MAP_FIND_INDEX && id <= hb.INTRINSIC_MAP_NEW) ||
        (id >= hb.INTRINSIC_MAP_TAKE_AT && id <= hb.INTRINSIC_MAP_TAKE)
    if !is_map_op { return false }

    // Resolve MapInst
    mut map_ty := -1
    if tm.sig_ty >= 0 && ht.find_map_inst(&types, tm.sig_ty) >= 0 {
        map_ty = tm.sig_ty
    } else if tm.dest_val >= 0 && ht.find_map_inst(&types, f.vals[tm.dest_val].ty) >= 0 {
        map_ty = f.vals[tm.dest_val].ty
    } else if a_len > 0 {
        mut t0 := f.vals[f.val_args[a_start]].ty
        if types.entries[t0].kind == .Ref || types.entries[t0].kind == .MutRef {
            t0 = types.entries[t0].inner_a
        }
        if ht.find_map_inst(&types, t0) >= 0 { map_ty = t0 }
    }
    mi := ht.find_map_inst(&types, map_ty)
    if mi < 0 { return true }
    k_ty := types.map_insts[mi].key_ty
    is_set := types.map_insts[mi].is_set
    v_ty := if is_set { ht.TY_BOOL } else { types.map_insts[mi].val_ty }
    k_stride := if type_size(&types, k_ty) > 0 { align_up_i32(type_size(&types, k_ty), type_align(&types, k_ty)) } else { 8 }
    v_stride := if is_set { 0 } else if type_size(&types, v_ty) > 0 { align_up_i32(type_size(&types, v_ty), type_align(&types, v_ty)) } else { 8 }
    kk := map_key_kind_arm64(&types, k_ty)

    if id == hb.INTRINSIC_MAP_NEW || id == hb.INTRINSIC_SET_NEW {
        a64.imm(&mut fc.buf, a64.X0, kk)
        a64.imm(&mut fc.buf, a64.X1, i64(k_stride))
        a64.imm(&mut fc.buf, a64.X2, i64(v_stride))
        a64.imm(&mut fc.buf, a64.X3, if is_set { 1 } else { 0 })
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_new)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }

    if a_len == 0 { return true }
    mv := f.val_args[a_start]
    mv_is_ref := types.entries[f.vals[mv].ty].kind == .Ref || types.entries[f.vals[mv].ty].kind == .MutRef

    // Helper: load MapHdr* into X4
    load_gp_into(&mut fc, mv, a64.X4)
    if mv_is_ref { a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false) }

    if id == hb.INTRINSIC_MAP_LEN || id == hb.INTRINSIC_MAP_IS_EMPTY {
        a64.ldr(&mut fc.buf, a64.X5, a64.X4, 0, 8, false) // keys_arr
        a64.ldr(&mut fc.buf, a64.X0, a64.X5, 8, 8, false) // len
        if id == hb.INTRINSIC_MAP_IS_EMPTY {
            a64.cmp_imm(&mut fc.buf, true, a64.X0, 0)
            a64.cset(&mut fc.buf, a64.X0, a64.CC_EQ)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_MAP_CLEAR {
        a64.mov(&mut fc.buf, a64.X0, a64.X4)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_clear)
        return true
    }
    if id == hb.INTRINSIC_MAP_RESERVE && a_len >= 2 {
        a64.mov(&mut fc.buf, a64.X0, a64.X4)
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
        a64.lsl_imm(&mut fc.buf, true, a64.X1, a64.X1, 1) // 2x for load factor
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_rehash)
        return true
    }
    if (id == hb.INTRINSIC_MAP_PUT || id == hb.INTRINSIC_MAP_PUT_NEW || id == hb.INTRINSIC_SET_INSERT) && a_len >= 2 {
        kp := emit_materialize_val_ptr(&mut fc, &types, &rt, &f, f.val_args[a_start + 1], k_ty, a64.X5)
        mut vp := 0
        if id != hb.INTRINSIC_SET_INSERT && a_len >= 3 {
            a64.stp_pre(&mut fc.buf, a64.X5, a64.XZR, a64.SP, -16) // save key_ptr across val materialization
            vp = emit_materialize_val_ptr(&mut fc, &types, &rt, &f, f.val_args[a_start + 2], v_ty, a64.X2)
            a64.ldr(&mut fc.buf, a64.X1, a64.SP, vp, 8, false) // key_ptr
            vp += 16
        } else {
            a64.mov(&mut fc.buf, a64.X1, a64.X5)
            a64.imm(&mut fc.buf, a64.X2, 0)
        }
        load_gp_into(&mut fc, mv, a64.X0)
        if mv_is_ref { a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false) }
        a64.imm(&mut fc.buf, a64.X3, if id == hb.INTRINSIC_MAP_PUT { 1 } else { 0 })
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_put)
        if kp + vp > 0 { a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, i64(kp + vp)) }
        if tm.dest_val >= 0 { store_gp_val(&mut fc, tm.dest_val, a64.X0) }
        return true
    }
    if id == hb.INTRINSIC_MAP_REMOVE && a_len >= 2 {
        kp := emit_materialize_val_ptr(&mut fc, &types, &rt, &f, f.val_args[a_start + 1], k_ty, a64.X1)
        load_gp_into(&mut fc, mv, a64.X0)
        if mv_is_ref { a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false) }
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_remove)
        if kp > 0 { a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, i64(kp)) }
        if tm.dest_val >= 0 { store_gp_val(&mut fc, tm.dest_val, a64.X0) }
        return true
    }
    if (id == hb.INTRINSIC_MAP_CONTAINS || id == hb.INTRINSIC_MAP_FIND_INDEX || id == hb.INTRINSIC_MAP_INDEX_OF) && a_len >= 2 {
        kp := emit_materialize_val_ptr(&mut fc, &types, &rt, &f, f.val_args[a_start + 1], k_ty, a64.X1)
        load_gp_into(&mut fc, mv, a64.X0)
        if mv_is_ref { a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false) }
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_find)
        if kp > 0 { a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, i64(kp)) }
        if tm.dest_val >= 0 {
            if id == hb.INTRINSIC_MAP_CONTAINS {
                a64.cmp_imm(&mut fc.buf, true, a64.X0, 0)
                a64.cset(&mut fc.buf, a64.X0, a64.CC_GE)
                store_gp_val(&mut fc, tm.dest_val, a64.X0)
            } else if id == hb.INTRINSIC_MAP_FIND_INDEX {
                store_gp_val(&mut fc, tm.dest_val, a64.X0)
            } else {
                // Option<i32>
                dty := f.vals[tm.dest_val].ty
                emit_sub_imm_any(&mut fc.buf, a64.X4, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                emit_memzero_size(&mut fc, &rt, a64.X4, type_size(&types, dty))
                lbl_none := a64.label(&mut fc.buf)
                lbl_done := a64.label(&mut fc.buf)
                a64.cmp_imm(&mut fc.buf, true, a64.X0, 0)
                a64.b_cond(&mut fc.buf, a64.CC_LT, lbl_none)
                poff := enum_payload_offset(&types, dty, 0, 0)
                emit_str_off(&mut fc.buf, a64.X0, a64.X4, i64(poff), 4)
                a64.b(&mut fc.buf, lbl_done)
                a64.mark(&mut fc.buf, lbl_none)
                a64.imm(&mut fc.buf, a64.X1, 1)
                emit_str_off(&mut fc.buf, a64.X1, a64.X4, 0, 4)
                a64.mark(&mut fc.buf, lbl_done)
            }
        }
        return true
    }
    if (id == hb.INTRINSIC_MAP_GET || id == hb.INTRINSIC_MAP_GET_OR || id == hb.INTRINSIC_MAP_GET_OR_DEFAULT ||
        id == hb.INTRINSIC_MAP_GET_REF || id == hb.INTRINSIC_MAP_AT || id == hb.INTRINSIC_MAP_AT_MUT ||
        id == hb.INTRINSIC_MAP_TAKE) && a_len >= 2 {
        kp := emit_materialize_val_ptr(&mut fc, &types, &rt, &f, f.val_args[a_start + 1], k_ty, a64.X1)
        load_gp_into(&mut fc, mv, a64.X0)
        if mv_is_ref { a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false) }
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_find)
        if kp > 0 { a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, i64(kp)) }
        // X0 = idx (-1 if missing); reload MapHdr* into X4
        a64.mov(&mut fc.buf, a64.X5, a64.X0) // X5 = idx
        load_gp_into(&mut fc, mv, a64.X4)
        if mv_is_ref { a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false) }
        arr_off := if id == hb.INTRINSIC_MAP_TAKE && is_set { 0 } else { 8 }
        e_ty := if id == hb.INTRINSIC_MAP_TAKE && is_set { k_ty } else { v_ty }
        e_stride := if id == hb.INTRINSIC_MAP_TAKE && is_set { k_stride } else { v_stride }

        if id == hb.INTRINSIC_MAP_AT || id == hb.INTRINSIC_MAP_AT_MUT {
            a64.cmp_imm(&mut fc.buf, true, a64.X5, 0)
            a64.b_cond(&mut fc.buf, a64.CC_LT, fc.trap_103)
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, arr_off, 8, false)
            a64.ldr(&mut fc.buf, a64.X6, a64.X6, 0, 8, false) // data
            a64.imm(&mut fc.buf, a64.X16, i64(e_stride))
            a64.madd(&mut fc.buf, true, a64.X0, a64.X5, a64.X16, a64.X6)
            store_gp_val(&mut fc, tm.dest_val, a64.X0)
            return true
        }
        if id == hb.INTRINSIC_MAP_GET_OR || id == hb.INTRINSIC_MAP_GET_OR_DEFAULT {
            lbl_miss := a64.label(&mut fc.buf)
            lbl_done := a64.label(&mut fc.buf)
            a64.cmp_imm(&mut fc.buf, true, a64.X5, 0)
            a64.b_cond(&mut fc.buf, a64.CC_LT, lbl_miss)
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, arr_off, 8, false)
            a64.ldr(&mut fc.buf, a64.X6, a64.X6, 0, 8, false)
            a64.imm(&mut fc.buf, a64.X16, i64(e_stride))
            a64.madd(&mut fc.buf, true, a64.X4, a64.X5, a64.X16, a64.X6)
            emit_load_typed_to_dest(&mut fc, &types, &rt, &f, a64.X4, tm.dest_val)
            a64.b(&mut fc.buf, lbl_done)
            a64.mark(&mut fc.buf, lbl_miss)
            if id == hb.INTRINSIC_MAP_GET_OR && a_len >= 3 {
                dv := f.val_args[a_start + 2]
                d_cls := fc.plan.locs[tm.dest_val].cls
                if d_cls == .Gp { load_gp_into(&mut fc, dv, a64.X0); store_gp_val(&mut fc, tm.dest_val, a64.X0) }
                else if d_cls == .Fp { load_fp_into(&mut fc, dv, 16); store_fp_val(&mut fc, tm.dest_val, 16) }
                else if d_cls == .Fat { load_fat_into(&mut fc, dv, a64.X0, a64.X1); store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1) }
                else if d_cls == .Agg {
                    emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                    emit_sub_imm_any(&mut fc.buf, a64.X7, a64.FP, i64(fc.plan.locs[dv].spill_off))
                    emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, e_ty))
                }
            } else if tm.dest_val >= 0 {
                // Default value: empty string, empty array, or zero
                d_cls := fc.plan.locs[tm.dest_val].cls
                if e_ty == ht.TY_STRING {
                    fc.ro_counter += 1
                    es := append_rodata_dunder_str(&mut m, "__def_s_" + f.fn_id.str() + "_" + fc.ro_counter.str(), "")
                    emit_adrp_sym(&mut fc.buf, &mut fc.relocs, a64.X0, es, 0)
                    store_gp_val(&mut fc, tm.dest_val, a64.X0)
                } else if types.entries[e_ty].kind == .Array {
                    et := types.entries[e_ty].inner_a
                    st := align_up_i32(if type_size(&types, et) > 0 { type_size(&types, et) } else { 1 }, type_align(&types, et))
                    a64.imm(&mut fc.buf, a64.X0, 0)
                    a64.imm(&mut fc.buf, a64.X1, i64(st))
                    emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_alloc)
                    store_gp_val(&mut fc, tm.dest_val, a64.X0)
                } else if d_cls == .Gp {
                    a64.imm(&mut fc.buf, a64.X0, 0)
                    store_gp_val(&mut fc, tm.dest_val, a64.X0)
                } else if d_cls == .Fp {
                    a64.fmov_to_fp(&mut fc.buf, is_f64_ty(&types, e_ty), 16, a64.XZR)
                    store_fp_val(&mut fc, tm.dest_val, 16)
                } else if d_cls == .Fat {
                    a64.imm(&mut fc.buf, a64.X0, 0)
                    store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X0)
                } else if d_cls == .Agg {
                    emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
                    emit_memzero_size(&mut fc, &rt, a64.X6, type_size(&types, e_ty))
                }
            }
            a64.mark(&mut fc.buf, lbl_done)
            return true
        }
        // MAP_GET / MAP_GET_REF / MAP_TAKE -> Option<V> / Option<&V>
        if tm.dest_val >= 0 {
            dty := f.vals[tm.dest_val].ty
            lbl_none := a64.label(&mut fc.buf)
            lbl_done := a64.label(&mut fc.buf)
            a64.stp_pre(&mut fc.buf, a64.X4, a64.X5, a64.SP, -16) // save hdr, idx
            emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
            emit_memzero_size(&mut fc, &rt, a64.X6, type_size(&types, dty))
            a64.ldr(&mut fc.buf, a64.X4, a64.SP, 0, 8, false)
            a64.ldr(&mut fc.buf, a64.X5, a64.SP, 8, 8, false)
            a64.cmp_imm(&mut fc.buf, true, a64.X5, 0)
            a64.b_cond(&mut fc.buf, a64.CC_LT, lbl_none)
            a64.ldr(&mut fc.buf, a64.X6, a64.X4, arr_off, 8, false)
            a64.ldr(&mut fc.buf, a64.X6, a64.X6, 0, 8, false) // data
            a64.imm(&mut fc.buf, a64.X16, i64(e_stride))
            a64.madd(&mut fc.buf, true, a64.X7, a64.X5, a64.X16, a64.X6) // &elem
            poff := enum_payload_offset(&types, dty, 0, 0)
            emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off - poff))
            if id == hb.INTRINSIC_MAP_GET_REF {
                emit_str_off(&mut fc.buf, a64.X7, a64.X6, 0, 8)
            } else {
                emit_memcpy_size(&mut fc, &rt, a64.X6, a64.X7, type_size(&types, e_ty))
            }
            if id == hb.INTRINSIC_MAP_TAKE {
                a64.ldr(&mut fc.buf, a64.X0, a64.SP, 0, 8, false)
                a64.ldr(&mut fc.buf, a64.X1, a64.SP, 8, 8, false)
                emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_remove_idx)
            }
            a64.b(&mut fc.buf, lbl_done)
            a64.mark(&mut fc.buf, lbl_none)
            emit_sub_imm_any(&mut fc.buf, a64.X6, a64.FP, i64(fc.plan.locs[tm.dest_val].spill_off))
            a64.imm(&mut fc.buf, a64.X1, 1)
            emit_str_off(&mut fc.buf, a64.X1, a64.X6, 0, 4)
            a64.mark(&mut fc.buf, lbl_done)
            a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, 16)
        }
        return true
    }
    if (id == hb.INTRINSIC_MAP_KEY_AT || id == hb.INTRINSIC_MAP_VAL_AT ||
        id == hb.INTRINSIC_MAP_VAL_AT_MUT || id == hb.INTRINSIC_MAP_VAL_AT_REF ||
        id == hb.INTRINSIC_MAP_TAKE_AT) && a_len >= 2 {
        arr_off := if id == hb.INTRINSIC_MAP_KEY_AT || (id == hb.INTRINSIC_MAP_TAKE_AT && is_set) { 0 } else { 8 }
        e_stride := if id == hb.INTRINSIC_MAP_KEY_AT || (id == hb.INTRINSIC_MAP_TAKE_AT && is_set) { k_stride } else { v_stride }
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X5) // idx
        a64.ldr(&mut fc.buf, a64.X6, a64.X4, arr_off, 8, false) // arr_hdr
        a64.ldr(&mut fc.buf, a64.X7, a64.X6, 8, 8, false) // len
        a64.cmp_reg(&mut fc.buf, true, a64.X5, a64.X7)
        a64.b_cond(&mut fc.buf, a64.CC_HS, fc.trap_103)
        a64.ldr(&mut fc.buf, a64.X6, a64.X6, 0, 8, false) // data
        a64.imm(&mut fc.buf, a64.X16, i64(e_stride))
        a64.madd(&mut fc.buf, true, a64.X7, a64.X5, a64.X16, a64.X6)
        if id == hb.INTRINSIC_MAP_VAL_AT_MUT || id == hb.INTRINSIC_MAP_VAL_AT_REF {
            store_gp_val(&mut fc, tm.dest_val, a64.X7)
        } else if id == hb.INTRINSIC_MAP_TAKE_AT {
            a64.stp_pre(&mut fc.buf, a64.X4, a64.X5, a64.SP, -16)
            emit_load_typed_to_dest(&mut fc, &types, &rt, &f, a64.X7, tm.dest_val)
            a64.ldp_post(&mut fc.buf, a64.X0, a64.X1, a64.SP, 16)
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.map_remove_idx)
        } else {
            emit_load_typed_to_dest(&mut fc, &types, &rt, &f, a64.X7, tm.dest_val)
        }
        return true
    }
    if (id == hb.INTRINSIC_MAP_KEYS || id == hb.INTRINSIC_MAP_VALUES) && tm.dest_val >= 0 {
        arr_off := if id == hb.INTRINSIC_MAP_KEYS { 0 } else { 8 }
        e_stride := if id == hb.INTRINSIC_MAP_KEYS { k_stride } else { v_stride }
        a64.ldr(&mut fc.buf, a64.X5, a64.X4, arr_off, 8, false) // src arr_hdr
        a64.stp_pre(&mut fc.buf, a64.X5, a64.XZR, a64.SP, -16)
        a64.ldr(&mut fc.buf, a64.X0, a64.X5, 8, 8, false) // len
        a64.imm(&mut fc.buf, a64.X1, i64(e_stride))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_alloc)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false) // dst_data
        a64.ldp_post(&mut fc.buf, a64.X5, a64.X6, a64.SP, 16)
        a64.ldr(&mut fc.buf, a64.X1, a64.X5, 0, 8, false) // src_data
        a64.ldr(&mut fc.buf, a64.X2, a64.X5, 8, 8, false) // len
        a64.imm(&mut fc.buf, a64.X16, i64(e_stride))
        a64.mul(&mut fc.buf, true, a64.X2, a64.X2, a64.X16)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
        return true
    }
    true
}

fn emit_sys_and_fmt_intrinsic_arm64(m: &mut obj.ObjectModule, hir: &hb.HirProgram, f: &ssa.SsaFunc,
    fc: &mut FnCodegen, rt: &RuntimeSyms, target: obj.TargetKind, tm: &ssa.SsaTerm) -> bool {
    types := &hir.types
    id := tm.callee
    a_start := tm.arg_start
    a_len := tm.arg_len

    // --- Formatting, UTF-8, Slices, Embed/Static Bytes ---
    if id == hb.INTRINSIC_FORMAT_INT && a_len >= 2 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        vty := f.vals[av].ty
        spec_txt := ssa_const_str_text(&f, f.val_args[a_start + 1])
        spec := lexer.integer_format(spec_txt)
        load_gp_into(&mut fc, av, a64.X0)
        a64.imm(&mut fc.buf, a64.X1, i64(spec.width))
        a64.imm(&mut fc.buf, a64.X2, if ssa.is_unsigned_int_ty(&types, vty) { 1 } else { 0 })
        a64.imm(&mut fc.buf, a64.X3, i64(spec.radix))
        a64.imm(&mut fc.buf, a64.X4, i64(spec.letter_offset))
        a64.imm(&mut fc.buf, a64.X5, i64(spec.padding))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.fmt_int)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_FORMAT_STR && a_len >= 2 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        spec_txt := ssa_const_str_text(&f, f.val_args[a_start + 1])
        spec := lexer.string_format(spec_txt)
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, av, a64.X0, a64.X1)
        a64.imm(&mut fc.buf, a64.X2, i64(spec.width))
        a64.imm(&mut fc.buf, a64.X3, i64(spec.align))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.fmt_str)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_FORMAT_FIXED && a_len >= 2 && tm.dest_val >= 0 {
        av := f.val_args[a_start]
        spec_txt := ssa_const_str_text(&f, f.val_args[a_start + 1])
        dec := lexer.fixed_precision(spec_txt)
        load_fp_into(&mut fc, av, 0)
        if !is_f64_ty(&types, f.vals[av].ty) { a64.fcvt_f32_to_f64(&mut fc.buf, 0, 0) }
        a64.imm(&mut fc.buf, a64.X0, i64(if dec >= 0 { dec } else { 6 }))
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.fmt_fixed)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_RUNES && a_len >= 1 && tm.dest_val >= 0 {
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start], a64.X0, a64.X1)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_runes)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_STR_SLICE && a_len >= 1 && tm.dest_val >= 0 {
        sv := f.val_args[a_start]
        load_gp_into(&mut fc, sv, a64.X0)
        if a_len >= 3 {
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
            load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X2)
        } else if a_len == 2 {
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X1)
            a64.ldr(&mut fc.buf, a64.X2, a64.X0, 0, 8, false)
        } else {
            a64.imm(&mut fc.buf, a64.X1, 0)
            a64.ldr(&mut fc.buf, a64.X2, a64.X0, 0, 8, false)
        }
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_slice)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_FOR_MOVE_ELEM && a_len >= 1 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X4)
        emit_load_typed_to_dest(&mut fc, &types, &rt, &f, a64.X4, tm.dest_val)
        a64.str(&mut fc.buf, a64.XZR, a64.X4, 0, 8)
        return true
    }
    if id == hb.INTRINSIC_BYTES_VIEW && a_len >= 3 && tm.dest_val >= 0 {
        load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X0)
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X1)
        store_fat_val(&mut fc, tm.dest_val, a64.X0, a64.X1)
        return true
    }
    if id == hb.INTRINSIC_EMBED_BYTES && tm.dest_val >= 0 {
        bid := tm.sig_ty
        cnt := if bid >= 0 && bid < hir.embed_counts.len { hir.embed_counts[bid] } else { 0 }
        a64.imm(&mut fc.buf, a64.X0, i64(cnt))
        a64.imm(&mut fc.buf, a64.X1, 1)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.arr_alloc)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        if cnt > 0 {
            bs := hir.embed_starts[bid]
            mut blob: []u8 = []
            blob.reserve(cnt)
            for bi in 0..cnt { blob.push(hir.embed_blobs[bs + bi]) }
            off := obj.append_rodata(&mut m, &blob, 8)
            fc.ro_counter += 1
            sym := obj.add_symbol(&mut m, "__embed_" + f.fn_id.str() + "_" + fc.ro_counter.str(), .RodataBlob, .Rodata, off, cnt, false)
            a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false)
            emit_adrp_sym(&mut fc.buf, &mut fc.relocs, a64.X1, sym, 0)
            a64.imm(&mut fc.buf, a64.X2, i64(cnt))
            emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.memcpy)
        }
        return true
    }
    if id == hb.INTRINSIC_STATIC_BYTES && a_len >= 2 && tm.dest_val >= 0 {
        n_bytes := i32(ssa_const_i64(&f, f.val_args[a_start + 1], 8))
        sz := if n_bytes > 0 { n_bytes } else { 8 }
        boff := obj.reserve_bss(&mut m, sz, 8)
        emit_global_addr(&mut fc.buf, &mut fc.gsites, boff)
        store_gp_val(&mut fc, tm.dest_val, a64.X16)
        return true
    }

    // --- OS & stdlib/sys.ddr __sys_* intrinsics ---
    if id == hb.INTRINSIC_SYS_ARG_COUNT && tm.dest_val >= 0 {
        if rt.bss_args_off >= 0 {
            emit_global_addr(&mut fc.buf, &mut fc.gsites, rt.bss_args_off)
            a64.ldr(&mut fc.buf, a64.X0, a64.X16, 0, 8, false)
        } else {
            a64.imm(&mut fc.buf, a64.X0, 0)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_ARG && a_len >= 1 && tm.dest_val >= 0 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.sys_arg)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_ENVP && tm.dest_val >= 0 {
        if rt.bss_args_off >= 0 {
            emit_global_addr(&mut fc.buf, &mut fc.gsites, rt.bss_args_off)
            a64.ldr(&mut fc.buf, a64.X0, a64.X16, 16, 8, false)
        } else {
            a64.imm(&mut fc.buf, a64.X0, 0)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_PID && tm.dest_val >= 0 {
        emit_syscall(&mut fc.buf, target, 33554452, 172) // getpid
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if (id == hb.INTRINSIC_SYS_NOW_MS || id == hb.INTRINSIC_SYS_CLOCK) && tm.dest_val >= 0 {
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.sys_now_ms)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_ALLOC && a_len >= 1 && tm.dest_val >= 0 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_FREE { return true }
    if id == hb.INTRINSIC_SYS_POOL_ALLOC_TRY && a_len >= 1 && tm.dest_val >= 0 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.alloc)
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_POOL_FREE { return true }
    if id == hb.INTRINSIC_SYS_LINUX_SYSCALL && a_len >= 7 && tm.dest_val >= 0 {
        if target == .Arm64Macos {
            a64.imm(&mut fc.buf, a64.X0, -78)
        } else {
            load_gp_into(&mut fc, f.val_args[a_start], a64.X8)
            load_gp_into(&mut fc, f.val_args[a_start + 1], a64.X0)
            load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X1)
            load_gp_into(&mut fc, f.val_args[a_start + 3], a64.X2)
            load_gp_into(&mut fc, f.val_args[a_start + 4], a64.X3)
            load_gp_into(&mut fc, f.val_args[a_start + 5], a64.X4)
            load_gp_into(&mut fc, f.val_args[a_start + 6], a64.X5)
            a64.svc(&mut fc.buf, 0)
        }
        store_gp_val(&mut fc, tm.dest_val, a64.X0)
        return true
    }
    if (id == hb.INTRINSIC_SYS_WRITE_STDERR || id == hb.INTRINSIC_SYS_STDERR) && a_len >= 1 {
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start], a64.X1, a64.X2)
        a64.imm(&mut fc.buf, a64.X0, 2)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.write_buf)
        a64.imm(&mut fc.buf, a64.X0, 0)
        emit_store_sys_status(&mut fc, &types, &f, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_WRITE_TEXT && a_len >= 2 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start + 1], a64.X1, a64.X2)
        a64.imm(&mut fc.buf, a64.X3, 0)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.sys_write_file)
        emit_store_sys_status(&mut fc, &types, &f, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_APPEND_TEXT && a_len >= 2 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start + 1], a64.X1, a64.X2)
        a64.imm(&mut fc.buf, a64.X3, 1)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.sys_write_file)
        emit_store_sys_status(&mut fc, &types, &f, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_WRITE_BYTES && a_len >= 2 {
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        emit_load_byte_slice_ptr_len(&mut fc, &types, &f, f.val_args[a_start + 1], a64.X1, a64.X2)
        a64.imm(&mut fc.buf, a64.X3, 0)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.sys_write_file)
        emit_store_sys_status(&mut fc, &types, &f, tm.dest_val, a64.X0)
        return true
    }
    if id == hb.INTRINSIC_SYS_READ_TEXT && a_len >= 1 {
        a64.stp_pre(&mut fc.buf, a64.XZR, a64.XZR, a64.SP, -16) // [sp+0] = err
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        a64.mov(&mut fc.buf, a64.X1, a64.SP)
        a64.imm(&mut fc.buf, a64.X2, 1073741823)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.sys_read_all)
        a64.ldr(&mut fc.buf, a64.X5, a64.SP, 0, 8, false) // err
        lbl_rt_err := a64.label(&mut fc.buf)
        lbl_rt_done := a64.label(&mut fc.buf)
        a64.cbnz(&mut fc.buf, true, a64.X5, lbl_rt_err)
        a64.str(&mut fc.buf, a64.X0, a64.SP, 8, 8) // arr_hdr
        a64.ldr(&mut fc.buf, a64.X1, a64.X0, 8, 8, false) // len
        a64.ldr(&mut fc.buf, a64.X0, a64.X0, 0, 8, false) // data
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.utf8_valid)
        lbl_rt_vok := a64.label(&mut fc.buf)
        a64.cbnz(&mut fc.buf, true, a64.X0, lbl_rt_vok)
        a64.imm(&mut fc.buf, a64.X5, 92) // invalid UTF-8
        a64.b(&mut fc.buf, lbl_rt_err)
        a64.mark(&mut fc.buf, lbl_rt_vok)
        a64.ldr(&mut fc.buf, a64.X4, a64.SP, 8, 8, false)
        a64.ldr(&mut fc.buf, a64.X0, a64.X4, 0, 8, false)
        a64.ldr(&mut fc.buf, a64.X1, a64.X4, 8, 8, false)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.str_from_fat)
        a64.imm(&mut fc.buf, a64.X5, 0)
        a64.b(&mut fc.buf, lbl_rt_done)
        a64.mark(&mut fc.buf, lbl_rt_err)
        a64.imm(&mut fc.buf, a64.X0, 0)
        a64.mark(&mut fc.buf, lbl_rt_done)
        a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, 16)
        emit_store_sys_text_result(&mut m, &mut fc, &types, &f, tm.dest_val, a64.X0, a64.X5)
        return true
    }
    if id == hb.INTRINSIC_SYS_READ_U8 && a_len >= 3 {
        // __sys_read_u8(path, out: &mut []u8, max_bytes) -> Status
        a64.stp_pre(&mut fc.buf, a64.XZR, a64.XZR, a64.SP, -16)
        load_gp_into(&mut fc, f.val_args[a_start], a64.X0)
        a64.mov(&mut fc.buf, a64.X1, a64.SP)
        load_gp_into(&mut fc, f.val_args[a_start + 2], a64.X2)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.sys_read_all)
        a64.ldr(&mut fc.buf, a64.X5, a64.SP, 0, 8, false) // err
        lbl_ru_done := a64.label(&mut fc.buf)
        a64.cbnz(&mut fc.buf, true, a64.X5, lbl_ru_done)
        // Copy fields (data, len, cap, stride) from returned arr_hdr into *out
        out_v := f.val_args[a_start + 1]
        load_gp_into(&mut fc, out_v, a64.X4)
        if types.entries[f.vals[out_v].ty].kind == .Ref || types.entries[f.vals[out_v].ty].kind == .MutRef {
            a64.ldr(&mut fc.buf, a64.X4, a64.X4, 0, 8, false)
        }
        a64.ldr(&mut fc.buf, a64.X10, a64.X0, 0, 8, false)
        a64.ldr(&mut fc.buf, a64.X11, a64.X0, 8, 8, false)
        a64.ldr(&mut fc.buf, a64.X12, a64.X0, 16, 8, false)
        a64.ldr(&mut fc.buf, a64.X13, a64.X0, 24, 8, false)
        a64.str(&mut fc.buf, a64.X10, a64.X4, 0, 8)
        a64.str(&mut fc.buf, a64.X11, a64.X4, 8, 8)
        a64.str(&mut fc.buf, a64.X12, a64.X4, 16, 8)
        a64.str(&mut fc.buf, a64.X13, a64.X4, 24, 8)
        a64.mark(&mut fc.buf, lbl_ru_done)
        a64.add_imm(&mut fc.buf, true, false, a64.SP, a64.SP, 16)
        emit_store_sys_status(&mut fc, &types, &f, tm.dest_val, a64.X5)
