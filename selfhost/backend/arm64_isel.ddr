        a64.cmp_imm(&mut fc.buf, true, a64.X7, 0)
        a64.b_cond(&mut fc.buf, a64.CC_LT, lbl_dr_bad)
        a64.add_reg(&mut fc.buf, true, false, a64.X10, a64.X6, a64.X7)
