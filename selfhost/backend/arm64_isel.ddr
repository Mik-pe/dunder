        a64.mov(&mut fc.buf, a64.X1, a64.X7)
        emit_call_sym(&mut fc.buf, &mut fc.relocs, rt.utf8_valid)
        a64.cbz(&mut fc.buf, true, a64.X0, lbl_dr_u8b)
        a64.ldp_post(&mut fc.buf, a64.X0, a64.X1, a64.SP, 16)
