import arm64 as arm
import backend_row as row
import ..mir.mir

pub enum Operation { Invoke, IntoFloat, FromFloat, Reserve, Release, StackAddress, ThreadToken, SaveRuntime }
fn tag(op: Operation) -> i32 { 115 + i32(op) }
pub fn handles(n: i32) -> bool { n >= 115 && n <= tag(.SaveRuntime) }
const MAX_FOREIGN_STACK: i32 = 1048576

fn emit_sp_delta(code: &mut arm.Code, base_op: i64, dst: i32, src: i32, n: i32) {
    pages := n / 4096
    rem := n % 4096
    if pages > 0 {
        arm.emit(&mut code, base_op + 4194304 + i64(pages) * 1024 + i64(src) * 32 + i64(dst))
        if rem > 0 {
            arm.emit(&mut code, base_op + i64(rem) * 1024 + i64(dst) * 32 + i64(dst))
        }
    } else {
        arm.emit(&mut code, base_op + i64(rem) * 1024 + i64(src) * 32 + i64(dst))
    }
}

fn encode(code: &mut arm.Code, op: i32, x: i32, y: i32, n: i32) {
    if op == tag(.Invoke) {
        if code.platform == 2 || code.platform == 5 {
            slots := n / 16
            if slots >= 255 {
                arm.imm(&mut code, 15, i64(n))
                arm.emit(&mut code, 4261412864 + i64(x) * 65536 + i64(y) * 256 + 255)
            } else {
                arm.emit(&mut code, 4261412864 + i64(x) * 65536 + i64(y) * 256 + i64(slots))
            }
        } else { arm.emit(&mut code, 3594453536) }
    } else if op == tag(.IntoFloat) || op == tag(.FromFloat) {
        mut base: i64 = 2657550336; if n == 4 { base = 505872384 }
        if op == tag(.IntoFloat) { arm.emit(&mut code, base + i64(y) * 32 + i64(x)) }
        else { arm.emit(&mut code, base - 65536 + i64(x) * 32 + i64(y)) }
    } else if op == tag(.Reserve) { emit_sp_delta(&mut code, 3506438144, 31, 31, n) }
    else if op == tag(.Release) { emit_sp_delta(&mut code, 2432696320, 31, 31, n) }
    else if op == tag(.StackAddress) { emit_sp_delta(&mut code, 2432696320, x, 31, n) }
    else if op == tag(.ThreadToken) {
        if code.platform == 0 { arm.emit(&mut code, 3577466986); arm.emit(&mut code, 3544448330) }
        else { arm.emit(&mut code, 3577466954) }
    } else { arm.emit(&mut code, 4194304000) }
}
pub fn emit(code: &mut arm.Code, op: Operation, x: i32, y: i32, amount: i32) {
    if code.mir_capture {
        if op == .Invoke { arm.barrier(&mut code) }
        code.words.push(row.foreign(tag(op), x, y, amount)); return
    }
    encode(&mut code, tag(op), x, y, amount)
}
pub fn read(f: &mut mir.Function, id: i32, cell: i64) -> bool {
    op := row.kind(cell); x := row.reg(cell); y := i32(row.operand(cell).shr(32)); n := i32(row.binary_right(cell))
    if cell != row.foreign(op, x, y, n) || n < 0 || !handles(op) { return false }
    f.opcodes[id] = op
    if op == tag(.Invoke) {
        if x > 8 || y > 8 || n % 16 != 0 || n > MAX_FOREIGN_STACK { return false }
        f.kinds[id] = 14; f.abi[id] = 2; f.effects[id] = 95; f.flags[id] = 3
        f.a[id] = 17; f.aux[id] = x + y * 256; f.imm[id] = i64(n)
        f.reads[id] = -1; f.clobbers[id] = -1; return true
    }
    if op == tag(.IntoFloat) || op == tag(.FromFloat) {
        if x >= 32 || y >= 31 || (n != 4 && n != 8) { return false }
        f.kinds[id] = 19; f.types[id] = 7; if n == 4 { f.types[id] = 6 }
        f.dst[id] = x + 32; f.a[id] = y
        if op == tag(.FromFloat) { f.dst[id] = y; f.a[id] = x + 32 }
    } else {
        if y != 0 { return false }
        f.kinds[id] = 24; f.types[id] = 2; f.imm[id] = i64(n)
        if op == tag(.ThreadToken) {
            if x != 0 || n != 0 { return false }
            f.dst[id] = 10; f.effects[id] = 2
        } else if op == tag(.SaveRuntime) {
            if x != 0 || n != 0 || (f.platform != 2 && f.platform != 5) { return false }
            f.reads[id] = -1; f.effects[id] = 5; return true
        } else {
            if n > MAX_FOREIGN_STACK { return false }; f.a[id] = 31; f.dst[id] = x
            if op != tag(.StackAddress) {
                if x != 0 || n % 16 != 0 { return false }; f.dst[id] = 31; f.effects[id] = 32
            } else if x == 31 { return false }
        }
    }
    f.reads[id] = mir.variable_bit(f.a[id]); f.writes[id] = mir.variable_bit(f.dst[id]); true
}
pub fn valid(f: &mir.Function, id: i32) -> bool {
    op := f.opcodes[id]; dst := f.dst[id]; src := f.a[id]; n := f.imm[id]
    if !handles(op) || f.b[id] != -1 || f.c[id] != -1 || f.variant[id] != 0 ||
        f.reloc_kinds[id] != -1 || f.targets[id] != -1 || f.import_ids[id] != -1 || f.place[id] != -1 ||
        f.extensions[id] != 0 || f.recipes[id] != 0 || f.stack_roles[id] != 0 { return false }
    if op == tag(.Invoke) {
        args := f.aux[id]
        return f.kinds[id] == 14 && f.types[id] == 0 && src == 17 && dst == -1 && args >= 0 &&
            args % 256 <= 8 && args / 256 <= 8 && n >= 0 && n <= i64(MAX_FOREIGN_STACK) && n % 16 == 0 &&
            f.flags[id] == 3 && f.abi[id] == 2 && f.effects[id] == 95 && f.reads[id] == -1 && f.writes[id] == 0 && f.clobbers[id] == -1
    }
    if f.aux[id] != 0 || f.abi[id] != 0 || f.flags[id] != 0 || f.clobbers[id] != 0 || f.writes[id] != mir.variable_bit(dst) { return false }
    if op == tag(.SaveRuntime) {
        return f.kinds[id] == 24 && (f.platform == 2 || f.platform == 5) && f.types[id] == 2 && src == -1 && dst == -1 && n == 0 &&
            f.reads[id] == -1 && f.effects[id] == 5
    }
    if f.reads[id] != mir.variable_bit(src) { return false }
    if op == tag(.IntoFloat) || op == tag(.FromFloat) {
        if f.kinds[id] != 19 || n != 0 || f.effects[id] != 0 || (f.types[id] != 6 && f.types[id] != 7) { return false }
        if op == tag(.IntoFloat) { return dst >= 32 && dst < 64 && src >= 0 && src < 31 }
        return src >= 32 && src < 64 && dst >= 0 && dst < 31
    }
    if f.kinds[id] != 24 || f.types[id] != 2 { return false }
    if op == tag(.ThreadToken) { return n == 0 && src == -1 && dst == 10 && f.effects[id] == 2 }
    if src != 31 || n < 0 || n > i64(MAX_FOREIGN_STACK) { return false }
    if op == tag(.StackAddress) { return dst >= 0 && dst < 31 && f.effects[id] == 0 }
    dst == 31 && n % 16 == 0 && f.effects[id] == 32
}
pub fn lower(code: &mut arm.Code, f: &mir.Function, id: i32) {
    op := f.opcodes[id]; mut x := 0; mut y := 0; mut n := i32(f.imm[id])
    if op == tag(.Invoke) { x = f.aux[id] % 256; y = f.aux[id] / 256 }
    else if op == tag(.IntoFloat) || op == tag(.FromFloat) {
        n = 8; if f.types[id] == 6 { n = 4 }
        x = f.dst[id] - 32; y = f.a[id]; if op == tag(.FromFloat) { x = f.a[id] - 32; y = f.dst[id] }
    } else if op == tag(.StackAddress) { x = f.dst[id] }
    encode(&mut code, op, x, y, n)
}
