import std.bytes as bytes
import imports
import dwarf
import std.sha256 as sha256

pub struct Signer { workers: i32, digest: fn(&[]u8, i32, i32, i32) -> []u8 }

pub struct MachoConfig {
    rpaths: []string,
    entitlements: string,
    identifier: string,
    overrides: []imports.LibraryOverride,
}

pub fn default_config() -> MachoConfig {
    MachoConfig { rpaths: [], entitlements: "", identifier: "dunder", overrides: [] }
}

pub fn code_page_bytes() -> i32 { 16384 }

pub fn digest_pages(image: &[]u8, first: i32, end: i32, _workers: i32) -> []u8 {
    page := code_page_bytes()
    mut hashes: []u8 = []
    hashes.reserve((end - first) * 32)
    for slot in first..end {
        digest := sha256.digest_range(&image, slot * page, page)
        bytes.extend(&mut hashes, &digest)
    }
    hashes
}

pub fn serial_signer() -> Signer { Signer { workers: 1, digest: digest_pages } }

fn align(value: i32, alignment: i32) -> i32 { (value + alignment - 1) / alignment * alignment }
fn name(output: &mut []u8, value: string) { assert(value.len <= 16); bytes.append_utf8(&mut output, value); bytes.pad(&mut output, 16 - value.len) }
fn segment_flagged(output: &mut []u8, label: string, vm: i64, size: i64, offset: i64, file_size: i64, maxprot: i32, initprot: i32, sections: i32, flags: i32) {
    bytes.append_le(&mut output, 25, 4); bytes.append_le(&mut output, i64(72 + 80 * sections), 4); name(&mut output, label)
    bytes.append_le(&mut output, vm, 8); bytes.append_le(&mut output, size, 8); bytes.append_le(&mut output, offset, 8); bytes.append_le(&mut output, file_size, 8)
    bytes.append_le(&mut output, i64(maxprot), 4); bytes.append_le(&mut output, i64(initprot), 4); bytes.append_le(&mut output, i64(sections), 4); bytes.append_le(&mut output, i64(flags), 4)
}
fn segment(output: &mut []u8, label: string, vm: i64, size: i64, offset: i64, file_size: i64, protection: i32, sections: i32) {
    segment_flagged(&mut output, label, vm, size, offset, file_size, protection, protection, sections, 0)
}

fn signature_bytes_len(slots: i32, identifier: string, info: string, entitlements: string) -> i32 {
    has_ent := entitlements.len > 0
    has_info := info.len > 0
    mut special := 0
    if has_ent { special = 5 } else if has_info { special = 3 }
    hash_offset := 88 + identifier.len + 1 + special * 32
    directory_length := hash_offset + slots * 32
    super_header := if has_ent { 28 } else { 20 }
    ent_blob := if has_ent { 8 + entitlements.len } else { 0 }
    align(super_header + directory_length + ent_blob, 16)
}

pub fn image(text: &[]u8) -> []u8 {
    image_using(&text, &serial_signer())
}

pub fn image_using(text: &[]u8, signer: &Signer) -> []u8 {
    page := code_page_bytes()
    vm: i64 = 4294967296
    text_offset := 432
    text_end := text_offset + text.len
    signature_offset := align(text_end, page)
    slots := signature_offset / page
    signature_size := signature_bytes_len(slots, "dunder", "", "")
    mut output: []u8 = []
    output.reserve(signature_offset + signature_size)
    header: [i64; 8] = [4277009103, 16777228, 0, 2, 7, 392, 2097157, 0]
    for value in &header { bytes.append_le(&mut output, value, 4) }
    segment(&mut output, "__PAGEZERO", 0, vm, 0, 0, 0, 0)
    segment(&mut output, "__TEXT", vm, i64(signature_offset), 0, i64(text_end), 5, 1)
    name(&mut output, "__text"); name(&mut output, "__TEXT")
    bytes.append_le(&mut output, vm + i64(text_offset), 8); bytes.append_le(&mut output, i64(text.len), 8)
    section: [i64; 8] = [432, 4, 0, 0, 2147484672, 0, 0, 0]
    for value in &section { bytes.append_le(&mut output, value, 4) }
    segment(&mut output, "__LINKEDIT", vm + i64(signature_offset), i64(align(signature_size, page)), i64(signature_offset), i64(signature_size), 1, 0)
    version: [i64; 6] = [50, 24, 1, 720896, 720896, 0]
    for value in &version { bytes.append_le(&mut output, value, 4) }
    bytes.append_le(&mut output, 14, 4); bytes.append_le(&mut output, 32, 4); bytes.append_le(&mut output, 12, 4)
    bytes.append_utf8(&mut output, "/usr/lib/dyld"); bytes.pad(&mut output, 7)
    bytes.append_le(&mut output, 2147483688, 4); bytes.append_le(&mut output, 24, 4); bytes.append_le(&mut output, i64(text_offset), 8); bytes.append_le(&mut output, 0, 8)
    bytes.append_le(&mut output, 29, 4); bytes.append_le(&mut output, 16, 4); bytes.append_le(&mut output, i64(signature_offset), 4); bytes.append_le(&mut output, i64(signature_size), 4)
    assert(output.len == 424)
    bytes.pad(&mut output, text_offset - output.len)
    bytes.extend(&mut output, &text)
    bytes.pad(&mut output, signature_offset - output.len)
    append_signature(&mut output, signature_offset, signature_offset, signature_size, &signer)
    output
}

fn append_signature(output: &mut []u8, signature_offset: i32, executable_bytes: i32, signature_size: i32, signer: &Signer) {
    append_directory_with_entitlements(&mut output, signature_offset, executable_bytes, signature_size, "dunder", "", "", "", &signer)
}

fn append_directory_with_entitlements(output: &mut []u8, signature_offset: i32, executable_bytes: i32, signature_size: i32, identifier: string, info: string, resources: string, entitlements: string, signer: &Signer) {
    page := code_page_bytes()
    slots := signature_offset / page
    has_ent := entitlements.len > 0
    has_info := info.len > 0
    mut special := 0
    if has_ent { special = 5 } else if has_info { special = 3 }
    hash_offset := 88 + identifier.len + 1 + special * 32
    directory_length := hash_offset + slots * 32
    mut directory: []u8 = []
    bytes.pad(&mut directory, directory_length)
    bytes.set_be(&mut directory, 0, 4208856066, 4)
    bytes.set_be(&mut directory, 4, i64(directory_length), 4)
    bytes.set_be(&mut directory, 8, 132096, 4)
    bytes.set_be(&mut directory, 12, 2, 4)
    bytes.set_be(&mut directory, 16, i64(hash_offset), 4)
    bytes.set_be(&mut directory, 20, 88, 4)
    bytes.set_be(&mut directory, 24, i64(special), 4)
    bytes.set_be(&mut directory, 28, i64(slots), 4)
    bytes.set_be(&mut directory, 32, i64(signature_offset), 4)
    directory[36] = 32; directory[37] = 2; directory[39] = 14
    bytes.set_be(&mut directory, 72, i64(executable_bytes), 8); bytes.set_be(&mut directory, 80, 1, 8)
    if has_info {
        mut info_raw: []u8 = []; bytes.append_utf8(&mut info_raw, info)
        mut res_raw: []u8 = []; bytes.append_utf8(&mut res_raw, resources)
        info_hash := sha256.digest_bytes(&info_raw)
        resource_hash := sha256.digest_bytes(&res_raw)
        for i in 0..32 {
            directory[hash_offset - 32 + i] = info_hash[i]
            directory[hash_offset - 96 + i] = resource_hash[i]
        }
    }
    mut ent_blob: []u8 = []
    if has_ent {
        ent_len := 8 + entitlements.len
        bytes.pad(&mut ent_blob, 8)
        bytes.set_be(&mut ent_blob, 0, 4208882033, 4) // CSMAGIC_EMBEDDED_ENTITLEMENTS (0xfade7171)
        bytes.set_be(&mut ent_blob, 4, i64(ent_len), 4)
        bytes.append_utf8(&mut ent_blob, entitlements)
        ent_hash := sha256.digest_bytes(&ent_blob)
        for i in 0..32 {
            directory[hash_offset - 160 + i] = ent_hash[i]
        }
    }
    for i in 0..identifier.len { directory[88 + i] = u8(identifier[i]) }
    hashes := signer.digest(&output, 0, slots, signer.workers)
    assert(hashes.len == slots * 32)
    for i in 0..hashes.len { directory[hash_offset + i] = hashes[i] }
    blob_count := if has_ent { 2 } else { 1 }
    super_header := if has_ent { 28 } else { 20 }
    mut signature: []u8 = []
    bytes.pad(&mut signature, super_header)
    bytes.set_be(&mut signature, 0, 4208856256, 4) // CSMAGIC_EMBEDDED_SIGNATURE
    bytes.set_be(&mut signature, 4, i64(signature_size), 4)
    bytes.set_be(&mut signature, 8, i64(blob_count), 4)
    bytes.set_be(&mut signature, 12, 0, 4) // CSSLOT_CODEDIRECTORY
    bytes.set_be(&mut signature, 16, i64(super_header), 4)
    if has_ent {
        bytes.set_be(&mut signature, 20, 5, 4) // CSSLOT_ENTITLEMENTS
        bytes.set_be(&mut signature, 24, i64(super_header + directory_length), 4)
    }
    bytes.extend(&mut signature, &directory)
    if has_ent { bytes.extend(&mut signature, &ent_blob) }
    bytes.pad(&mut signature, signature_size - signature.len)
    bytes.extend(&mut output, &signature)
}

fn section(output: &mut []u8, label: string, seg: string, offset: i32, size: i32, code: bool) {
    name(&mut output, label); name(&mut output, seg)
    bytes.append_le(&mut output, 4294967296 + i64(offset), 8)
    bytes.append_le(&mut output, i64(size), 8)
    bytes.append_le(&mut output, i64(offset), 4)
    if code {
        text: [i64; 7] = [4, 0, 0, 2147484672, 0, 0, 0]
        for field in &text { bytes.append_le(&mut output, field, 4) }
    } else {
        bytes.append_le(&mut output, 3, 4); bytes.pad(&mut output, 24)
    }
}

fn dwarf_section(output: &mut []u8, label: string, vmaddr: i64, offset: i32, size: i32) {
    name(&mut output, label); name(&mut output, "__DWARF")
    bytes.append_le(&mut output, vmaddr, 8)
    bytes.append_le(&mut output, i64(size), 8)
    bytes.append_le(&mut output, i64(offset), 4)
    bytes.append_le(&mut output, 0, 4) // align
    bytes.append_le(&mut output, 0, 4) // reloff
    bytes.append_le(&mut output, 0, 4) // nreloc
    bytes.append_le(&mut output, 33554432, 4) // S_ATTR_DEBUG (0x02000000)
    bytes.append_le(&mut output, 0, 4)
    bytes.append_le(&mut output, 0, 4)
    bytes.append_le(&mut output, 0, 4)
}

fn build_symtab(dbg: &dwarf.Bundle, symtab: &mut []u8, strtab: &mut []u8) {
    strtab.push(0)
    for i in 0..dbg.sym_names.len {
        strx := strtab.len
        strtab.push(95) // '_'
        if dbg.sym_names[i] != "" { bytes.append_utf8(&mut strtab, dbg.sym_names[i]) }
        strtab.push(0)
        bytes.append_le(&mut symtab, i64(strx), 4)
        symtab.push(15) // N_SECT | N_EXT
        symtab.push(1)  // __text section
        bytes.append_le(&mut symtab, 0, 2)
        bytes.append_le(&mut symtab, dbg.sym_addrs[i], 8)
    }
}

pub fn image_debug_using(text: &[]u8, dbg: &dwarf.Bundle, signer: &Signer) -> []u8 {
    page := code_page_bytes()
    vm: i64 = 4294967296
    commands := 808
    text_off := align(32 + commands, page)
    text_size := align(text_off + text.len, page)
    dwarf_off := text_size
    abbrev_off := dwarf_off
    info_off := abbrev_off + dbg.abbrev.len
    line_off := info_off + dbg.info.len
    str_off := line_off + dbg.line.len
    dwarf_len := dbg.abbrev.len + dbg.info.len + dbg.line.len + dbg.str_tab.len
    linkedit := align(dwarf_off + (if dwarf_len > 0 { dwarf_len } else { 1 }), page)
    dwarf_vmsize := linkedit - dwarf_off
    mut symtab: []u8 = []
    mut strtab: []u8 = []
    build_symtab(&dbg, &mut symtab, &mut strtab)
    symoff := linkedit
    stroff := symoff + symtab.len
    signature := align(stroff + strtab.len, page)
    sig_size := signature_bytes_len(signature / page, "dunder", "", "")
    link_size := signature + sig_size - linkedit

    mut out: []u8 = []
    out.reserve(signature + sig_size)
    header: [i64; 8] = [4277009103, 16777228, 0, 2, 9, i64(commands), 2097157, 0]
    for field in &header { bytes.append_le(&mut out, field, 4) }
    segment(&mut out, "__PAGEZERO", 0, vm, 0, 0, 0, 0)
    segment(&mut out, "__TEXT", vm, i64(text_size), 0, i64(text_size), 5, 1)
    section(&mut out, "__text", "__TEXT", text_off, text.len, true)
    segment(&mut out, "__DWARF", vm + i64(dwarf_off), i64(dwarf_vmsize), i64(dwarf_off), i64(dwarf_len), 1, 4)
    dwarf_section(&mut out, "__debug_abbrev", vm + i64(abbrev_off), abbrev_off, dbg.abbrev.len)
    dwarf_section(&mut out, "__debug_info", vm + i64(info_off), info_off, dbg.info.len)
    dwarf_section(&mut out, "__debug_line", vm + i64(line_off), line_off, dbg.line.len)
    dwarf_section(&mut out, "__debug_str", vm + i64(str_off), str_off, dbg.str_tab.len)
    segment(&mut out, "__LINKEDIT", vm + i64(linkedit), i64(align(link_size, page)), i64(linkedit), i64(link_size), 1, 0)
    version: [i64; 6] = [50, 24, 1, 720896, 720896, 0]
    for field in &version { bytes.append_le(&mut out, field, 4) }
    bytes.append_le(&mut out, 14, 4); bytes.append_le(&mut out, 32, 4); bytes.append_le(&mut out, 12, 4)
    bytes.append_utf8(&mut out, "/usr/lib/dyld"); bytes.pad(&mut out, 7)
    bytes.append_le(&mut out, 2147483688, 4); bytes.append_le(&mut out, 24, 4); bytes.append_le(&mut out, i64(text_off), 8); bytes.append_le(&mut out, 0, 8)
    symcmd: [i64; 6] = [2, 24, i64(symoff), i64(dbg.sym_names.len), i64(stroff), i64(strtab.len)]
    for field in &symcmd { bytes.append_le(&mut out, field, 4) }
    signing: [i64; 4] = [29, 16, i64(signature), i64(sig_size)]
    for field in &signing { bytes.append_le(&mut out, field, 4) }
    assert(out.len == 32 + commands)
    bytes.pad(&mut out, text_off - out.len)
    bytes.extend(&mut out, &text)
    bytes.pad(&mut out, dwarf_off - out.len)
    bytes.extend(&mut out, &dbg.abbrev)
    bytes.extend(&mut out, &dbg.info)
    bytes.extend(&mut out, &dbg.line)
    bytes.extend(&mut out, &dbg.str_tab)
    bytes.pad(&mut out, linkedit - out.len)
    bytes.extend(&mut out, &symtab)
    bytes.extend(&mut out, &strtab)
    bytes.pad(&mut out, signature - out.len)
    append_signature(&mut out, signature, text_size, sig_size, &signer)
    out
}

fn build_chained_fixups(specs: &[]imports.SymbolSpec, table: &imports.LibraryTable, seg_count: i32, got_seg_index: i32, got_off: i32, got_seg_size: i32) -> []u8 {
    page := code_page_bytes()
    mut sym_pool: []u8 = [0]
    mut sym_offs: []i32 = []
    sym_offs.reserve(specs.len)
    mut max_name_off := 0
    for i in 0..specs.len {
        off := sym_pool.len
        sym_offs.push(off)
        if off > max_name_off { max_name_off = off }
        sym_pool.push(95) // '_'
        bytes.append_utf8(&mut sym_pool, specs[i].name)
        sym_pool.push(0)
    }
    while sym_pool.len % 8 != 0 { sym_pool.push(0) }

    mut use_addend64 := false
    if table.names.len > 240 || max_name_off >= 8388608 { use_addend64 = true }
    imports_format := if use_addend64 { 3 } else { 1 }

    starts_offset := 32
    got_seg_info_rel := align(4 + seg_count * 4, 8)
    page_count := got_seg_size / page
    seg_info_size := align(22 + page_count * 2, 4)
    starts_len := align(got_seg_info_rel + seg_info_size, 8)
    imports_offset := starts_offset + starts_len
    imports_bytes := specs.len * (if use_addend64 { 16 } else { 4 })
    symbols_offset := align(imports_offset + imports_bytes, 4)

    mut out: []u8 = []
    out.reserve(symbols_offset + sym_pool.len)
    // dyld_chained_fixups_header (28 bytes + 4 pad = 32)
    bytes.append_le(&mut out, 0, 4) // fixups_version
    bytes.append_le(&mut out, i64(starts_offset), 4)
    bytes.append_le(&mut out, i64(imports_offset), 4)
    bytes.append_le(&mut out, i64(symbols_offset), 4)
    bytes.append_le(&mut out, i64(specs.len), 4)
    bytes.append_le(&mut out, i64(imports_format), 4)
    bytes.append_le(&mut out, 0, 4) // symbols_format = 0
    bytes.append_le(&mut out, 0, 4) // align to 32

    // dyld_chained_starts_in_image
    bytes.append_le(&mut out, i64(seg_count), 4)
    for s in 0..seg_count {
        if s == got_seg_index { bytes.append_le(&mut out, i64(got_seg_info_rel), 4) }
        else { bytes.append_le(&mut out, 0, 4) }
    }
    bytes.pad(&mut out, starts_offset + got_seg_info_rel - out.len)

    // dyld_chained_starts_in_segment
    bytes.append_le(&mut out, i64(seg_info_size), 4)
    bytes.append_le(&mut out, i64(page), 2)
    bytes.append_le(&mut out, 2, 2) // DYLD_CHAINED_PTR_64
    bytes.append_le(&mut out, i64(got_off), 8)
    bytes.append_le(&mut out, 0, 4) // max_valid_pointer
    bytes.append_le(&mut out, i64(page_count), 2)
    for _ in 0..page_count {
        bytes.append_le(&mut out, 0, 2) // first fixup on each GOT page is at offset 0
    }
    bytes.pad(&mut out, imports_offset - out.len)

    // imports table
    for i in 0..specs.len {
        ord := table.ordinals[i]
        weak_sym := specs[i].weak || table.weak[ord - 1]
        if use_addend64 {
            mut entry: i64 = i64(ord).bit_and(65535)
            if weak_sym { entry = entry.bit_or(65536) }
            entry = entry.bit_or(i64(sym_offs[i]).shl(32))
            bytes.append_le(&mut out, entry, 8)
            bytes.append_le(&mut out, 0, 8)
        } else {
            mut entry: i64 = i64(ord).bit_and(255)
            if weak_sym { entry = entry.bit_or(256) }
            entry = entry.bit_or(i64(sym_offs[i]).shl(9))
            bytes.append_le(&mut out, entry, 4)
        }
    }
    bytes.pad(&mut out, symbols_offset - out.len)
    bytes.extend(&mut out, &sym_pool)
    while out.len % 8 != 0 { out.push(0) }
    out
}

fn dynamic_commands_size(table: &imports.LibraryTable, config: &MachoConfig, has_got: bool, has_data: bool, has_debug: bool) -> i32 {
    // Base: __PAGEZERO (72) + __TEXT (72+80) + __LINKEDIT (72) + LC_BUILD_VERSION (24) + LC_LOAD_DYLINKER (32) + LC_MAIN (24) + LC_CODE_SIGNATURE (16) = 392
    mut commands := 392
    if has_got {
        // __DATA_CONST (72+80) + LC_DYLD_CHAINED_FIXUPS (16) + LC_DYLD_EXPORTS_TRIE (16) = 184
        commands += 184
    }
    if has_data {
        // __DATA (72+80) = 152
        commands += 152
    }
    if has_debug {
        // __DWARF (72 + 4*80 = 392) + LC_SYMTAB (24) = 416
        commands += 416
    }
    for lib in &table.names { commands += align(25 + lib.len, 8) }
    for rp in &config.rpaths { commands += align(13 + rp.len, 8) }
    commands
}

pub fn dynamic_text_offset_for(specs: &[]imports.SymbolSpec, globals: i32, has_debug: bool, config: &MachoConfig) -> i32 {
    table := imports.resolve_table(&specs, 0, .Glibc, &config.overrides)
    commands := dynamic_commands_size(&table, &config, specs.len > 0, globals > 0, has_debug)
    align(32 + commands, code_page_bytes())
}

pub fn dynamic_text_offset(libraries: &[]string, symbols: &[]string, globals: i32, has_debug: bool, config: &MachoConfig) -> i32 {
    specs := imports.from_legacy(&libraries, &symbols, -1)
    dynamic_text_offset_for(&specs, globals, has_debug, &config)
}

fn build_dynamic_image(text: &[]u8, specs: &[]imports.SymbolSpec, sites: &[]i32, slots: &[]i32,
                       globals: i32, has_debug: bool, dbg: &dwarf.Bundle, config: &MachoConfig, signer: &Signer) -> []u8 {
    table := imports.resolve_table(&specs, 0, .Glibc, &config.overrides)
    page := code_page_bytes()
    has_got := specs.len > 0
    has_data := globals > 0

    commands := dynamic_commands_size(&table, &config, has_got, has_data, has_debug)
    mut ncmds := 7 + table.names.len + config.rpaths.len
    mut seg_count := 3 // __PAGEZERO, __TEXT, __LINKEDIT
    if has_got { ncmds += 3; seg_count += 1 }
    if has_data { ncmds += 1; seg_count += 1 }
    if has_debug { ncmds += 2; seg_count += 1 }

    text_off := align(32 + commands, page)
    mut next_off := align(text_off + text.len, page)
    text_seg_size := next_off

    got_off := next_off
    got_len := specs.len * 8
    got_seg_size := if has_got { align(got_len, page) } else { 0 }
    if has_got { next_off += got_seg_size }

    data_off := next_off
    data_seg_size := if has_data { align(globals, page) } else { 0 }
    if has_data { next_off += data_seg_size }

    dwarf_off := next_off
    abbrev_off := dwarf_off
    info_off := abbrev_off + (if has_debug { dbg.abbrev.len } else { 0 })
    line_off := info_off + (if has_debug { dbg.info.len } else { 0 })
    str_off := line_off + (if has_debug { dbg.line.len } else { 0 })
    dwarf_len := if has_debug { dbg.abbrev.len + dbg.info.len + dbg.line.len + dbg.str_tab.len } else { 0 }
    mut dwarf_vmsize := 0
    if has_debug {
        next_off = align(dwarf_off + (if dwarf_len > 0 { dwarf_len } else { 1 }), page)
        dwarf_vmsize = next_off - dwarf_off
    }

    linkedit := next_off
    mut fixups: []u8 = []
    mut exports: []u8 = []
    if has_got {
        fixups = build_chained_fixups(&specs, &table, seg_count, 2, got_off, got_seg_size)
        exports = [0, 0, 0, 0, 0, 0, 0, 0]
    }
    fixups_off := linkedit
    exports_off := fixups_off + fixups.len
    mut link_cursor := exports_off + exports.len

    mut symtab: []u8 = []
    mut strtab: []u8 = []
    mut symoff := 0
    mut stroff := 0
    if has_debug {
        build_symtab(&dbg, &mut symtab, &mut strtab)
        symoff = link_cursor
        stroff = symoff + symtab.len
        link_cursor = stroff + strtab.len
    }

    ident := if config.identifier != "" { config.identifier.clone() } else { "dunder" }
    signature := align(link_cursor, page)
    sig_size := signature_bytes_len(signature / page, ident.clone(), "", config.entitlements.clone())
    link_size := signature + sig_size - linkedit

    vm: i64 = 4294967296
    mut out: []u8 = []
    out.reserve(signature + sig_size)
    header: [i64; 8] = [4277009103, 16777228, 0, 2, i64(ncmds), i64(commands), 2097285, 0]
    for field in &header { bytes.append_le(&mut out, field, 4) }

    segment(&mut out, "__PAGEZERO", 0, vm, 0, 0, 0, 0)
    segment(&mut out, "__TEXT", vm, i64(text_seg_size), 0, i64(text_seg_size), 5, 1)
    section(&mut out, "__text", "__TEXT", text_off, text.len, true)

    if has_got {
        // SG_READ_ONLY (0x10): dyld protects __DATA_CONST read-only after applying chained fixups
        segment_flagged(&mut out, "__DATA_CONST", vm + i64(got_off), i64(got_seg_size), i64(got_off), i64(got_seg_size), 3, 3, 1, 16)
        section(&mut out, "__got", "__DATA_CONST", got_off, got_len, false)
    }
    if has_data {
        segment(&mut out, "__DATA", vm + i64(data_off), i64(data_seg_size), i64(data_off), i64(data_seg_size), 3, 1)
        section(&mut out, "__data", "__DATA", data_off, globals, false)
    }
    if has_debug {
        segment(&mut out, "__DWARF", vm + i64(dwarf_off), i64(dwarf_vmsize), i64(dwarf_off), i64(dwarf_len), 1, 4)
        dwarf_section(&mut out, "__debug_abbrev", vm + i64(abbrev_off), abbrev_off, dbg.abbrev.len)
        dwarf_section(&mut out, "__debug_info", vm + i64(info_off), info_off, dbg.info.len)
        dwarf_section(&mut out, "__debug_line", vm + i64(line_off), line_off, dbg.line.len)
        dwarf_section(&mut out, "__debug_str", vm + i64(str_off), str_off, dbg.str_tab.len)
    }
    segment(&mut out, "__LINKEDIT", vm + i64(linkedit), i64(align(link_size, page)), i64(linkedit), i64(link_size), 1, 0)

    version: [i64; 6] = [50, 24, 1, 720896, 720896, 0]
    for field in &version { bytes.append_le(&mut out, field, 4) }
    bytes.append_le(&mut out, 14, 4); bytes.append_le(&mut out, 32, 4); bytes.append_le(&mut out, 12, 4)
    bytes.append_utf8(&mut out, "/usr/lib/dyld"); bytes.pad(&mut out, 7)
    bytes.append_le(&mut out, 2147483688, 4); bytes.append_le(&mut out, 24, 4); bytes.append_le(&mut out, i64(text_off), 8); bytes.append_le(&mut out, 0, 8)

    for i in 0..table.names.len {
        lib := &table.names[i]
        size := align(25 + lib.len, 8)
        cmd_id: i64 = if table.weak[i] { 2147483672 } else { 12 } // LC_LOAD_WEAK_DYLIB or LC_LOAD_DYLIB
        cmd: [i64; 6] = [cmd_id, i64(size), 24, 0, 65536, 65536]
        for field in &cmd { bytes.append_le(&mut out, field, 4) }
        bytes.append_utf8(&mut out, lib.clone()); bytes.pad(&mut out, size - 24 - lib.len)
    }
    for rp in &config.rpaths {
        size := align(13 + rp.len, 8)
        bytes.append_le(&mut out, 2147483676, 4) // LC_RPATH (0x8000001c)
        bytes.append_le(&mut out, i64(size), 4)
        bytes.append_le(&mut out, 12, 4)
        bytes.append_utf8(&mut out, rp.clone()); bytes.pad(&mut out, size - 12 - rp.len)
    }
    if has_got {
        bytes.append_le(&mut out, 2147483700, 4) // LC_DYLD_CHAINED_FIXUPS (0x80000034)
        bytes.append_le(&mut out, 16, 4)
        bytes.append_le(&mut out, i64(fixups_off), 4)
        bytes.append_le(&mut out, i64(fixups.len), 4)
        bytes.append_le(&mut out, 2147483699, 4) // LC_DYLD_EXPORTS_TRIE (0x80000033)
        bytes.append_le(&mut out, 16, 4)
        bytes.append_le(&mut out, i64(exports_off), 4)
        bytes.append_le(&mut out, i64(exports.len), 4)
    }
    if has_debug {
        symcmd: [i64; 6] = [2, 24, i64(symoff), i64(dbg.sym_names.len), i64(stroff), i64(strtab.len)]
        for field in &symcmd { bytes.append_le(&mut out, field, 4) }
    }
    signing: [i64; 4] = [29, 16, i64(signature), i64(sig_size)]
    for field in &signing { bytes.append_le(&mut out, field, 4) }
    assert(out.len == 32 + commands)

    bytes.pad(&mut out, text_off - out.len)
    bytes.extend(&mut out, &text)
    imports.relocate_at(&mut out, text_off, text.len, got_off, data_off, specs.len, &sites, &slots)

    if has_got {
        bytes.pad(&mut out, got_off - out.len)
        bind_bit: i64 = -9223372036854775808
        for i in 0..specs.len {
            next_stride := if (i + 1 < specs.len) && (((i + 1) * 8) / page == (i * 8) / page) { 2 } else { 0 }
            slot_val := bind_bit.bit_or(i64(next_stride).shl(51)).bit_or(i64(i).bit_and(16777215))
            bytes.append_le(&mut out, slot_val, 8)
        }
        bytes.pad(&mut out, got_off + got_seg_size - out.len)
    }
    if has_data {
        bytes.pad(&mut out, data_off + data_seg_size - out.len)
    }
    if has_debug {
        bytes.pad(&mut out, dwarf_off - out.len)
        bytes.extend(&mut out, &dbg.abbrev)
        bytes.extend(&mut out, &dbg.info)
        bytes.extend(&mut out, &dbg.line)
        bytes.extend(&mut out, &dbg.str_tab)
    }
    bytes.pad(&mut out, linkedit - out.len)
    if has_got {
        bytes.extend(&mut out, &fixups)
        bytes.extend(&mut out, &exports)
    }
    if has_debug {
        bytes.extend(&mut out, &symtab)
        bytes.extend(&mut out, &strtab)
    }
    bytes.pad(&mut out, signature - out.len)
    append_directory_with_entitlements(&mut out, signature, text_seg_size, sig_size, ident, "", "", config.entitlements.clone(), &signer)
    out
}

fn empty_dwarf() -> dwarf.Bundle {
    dwarf.Bundle { abbrev: [], info: [], str_tab: [], line: [], sym_names: [], sym_addrs: [], sym_sizes: [] }
}

pub fn dynamic_image(text: &[]u8, libraries: &[]string, symbols: &[]string,
                     sites: &[]i32, slots: &[]i32) -> []u8 {
    dynamic_storage(&text, &libraries, &symbols, &sites, &slots, 0)
}

pub fn dynamic_storage(text: &[]u8, libraries: &[]string, symbols: &[]string,
                       sites: &[]i32, slots: &[]i32, globals: i32) -> []u8 {
    dynamic_storage_using(&text, &libraries, &symbols, &sites, &slots, globals, &serial_signer())
}

pub fn dynamic_storage_using(text: &[]u8, libraries: &[]string, symbols: &[]string,
                             sites: &[]i32, slots: &[]i32, globals: i32, signer: &Signer) -> []u8 {
    specs := imports.from_legacy(&libraries, &symbols, -1)
    cfg := default_config()
    dbg := empty_dwarf()
    build_dynamic_image(&text, &specs, &sites, &slots, globals, false, &dbg, &cfg, &signer)
}

pub fn dynamic_storage_configured(text: &[]u8, specs: &[]imports.SymbolSpec,
                                  sites: &[]i32, slots: &[]i32, globals: i32,
                                  config: &MachoConfig, signer: &Signer) -> []u8 {
    dbg := empty_dwarf()
    build_dynamic_image(&text, &specs, &sites, &slots, globals, false, &dbg, &config, &signer)
}

pub fn dynamic_storage_debug_using(text: &[]u8, libraries: &[]string, symbols: &[]string,
                                   sites: &[]i32, slots: &[]i32, globals: i32,
                                   dbg: &dwarf.Bundle, signer: &Signer) -> []u8 {
    specs := imports.from_legacy(&libraries, &symbols, -1)
    cfg := default_config()
    build_dynamic_image(&text, &specs, &sites, &slots, globals, true, &dbg, &cfg, &signer)
}

pub fn dynamic_storage_debug_configured(text: &[]u8, specs: &[]imports.SymbolSpec,
                                        sites: &[]i32, slots: &[]i32, globals: i32,
                                        dbg: &dwarf.Bundle, config: &MachoConfig, signer: &Signer) -> []u8 {
    build_dynamic_image(&text, &specs, &sites, &slots, globals, true, &dbg, &config, &signer)
}

fn le32(image: &[]u8, offset: i32) -> i32 {
    return i32(image[offset]).bit_or(i32(image[offset + 1]).shl(8)).bit_or(i32(image[offset + 2]).shl(16)).bit_or(i32(image[offset + 3]).shl(24))
}

pub fn seal_bundle(image: &mut []u8, identifier: string, info: string, resources: string, signer: &Signer) {
    seal_bundle_with_entitlements(&mut image, identifier, info, resources, "", &signer)
}

pub fn seal_bundle_with_entitlements(image: &mut []u8, identifier: string, info: string, resources: string, entitlements: string, signer: &Signer) {
    mut cursor := 32
    mut signature := 0
    mut link := 0
    mut exec_size := 0
    for _ in 0..le32(&image, 16) {
        kind := le32(&image, cursor)
        if kind == 29 { signature = cursor }
        if kind == 25 {
            if image[cursor + 10] == 76 { link = cursor }
            if image[cursor + 10] == 84 { exec_size = le32(&image, cursor + 48) }
        }
        cursor = cursor + le32(&image, cursor + 4)
    }
    assert(signature > 0 && link > 0 && exec_size > 0)
    offset := le32(&image, signature + 8)
    slots := offset / code_page_bytes()
    length := signature_bytes_len(slots, identifier.clone(), info.clone(), entitlements.clone())
    link_len := offset + length - le32(&image, link + 40)
    imports.set_le(&mut image, signature + 12, i64(length), 4)
    imports.set_le(&mut image, link + 32, i64(align(link_len, code_page_bytes())), 8)
    imports.set_le(&mut image, link + 48, i64(link_len), 8)
    while image.len > offset { _ := image.pop() }
    append_directory_with_entitlements(&mut image, offset, exec_size, length, identifier, info, resources, entitlements, &signer)
}
