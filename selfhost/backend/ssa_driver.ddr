// Phase 3/4 End-to-End Native SSA Backend Driver (`selfhost/backend/ssa_driver.ddr`).
//
// Complete target-independent SSA compilation pipeline:
//   MirProgram + TypeTable + BuildOptions
//     -> ssa_lower (all fns, closures, string/cstr/wstr/embed blobs, extern decls, FFI, task scope, @test entry)
//     -> ssa_verify (pre-opt structural/type/dominance/scope verification)
//     -> ssa_opt (Mem2Reg/SROA, unified SSA inliner, GVN/ConstFold/CopyProp, bounds/overflow elision, CFG/DCE)
//     -> ssa_runtime (optional type-driven drop/clone/iso_clone/freeze, RC sentinels 0/-1/-2/<=-3,
//                     TYPE_DESC_TABLE, TLS CallbackFrame, bump alloc, R-3 task worker entries)
//     -> { arm64_isel | x86_isel | wasm_isel }
//     -> ObjectModule (relocations, dynamic imports, TYPE_DESC_TABLE, DWARF -g line tables)
//     -> { Mach-O (arm64-macos) | ELF64 (arm64-linux, x86_64-linux) | PE32+ (x86_64-windows) | WASM32/WASI }
//
// Also supports incremental content-hashed per-function compilation via `ssa_fragments`
// (`compile_mir_program_ssa_cached`) guaranteeing 100% byte-identical output across cold, warm,
// and disk-restored builds.
//
// ZERO imports of legacy `compile.ddr`, `mir_emit*.ddr`, `mir_lift.ddr`, `arm64.ddr`,
// `x86.ddr`, `x86_mir.ddr`, `wasm_mir.ddr`, or `wasm_native.ddr`.

capability filesystem

import ..frontend.diagnostics as diag
import ..hir.hir_types as ht
import ..hir.hir_body as hb
import ..mir2.mir_body as mb
import ..ssa.ssa_ir as ssa
import ..ssa.ssa_verify as ssa_verify
import ..ssa.ssa_lower as ssa_lower
import ..ssa.ssa_opt as ssa_opt
import ..ssa.ssa_runtime as ssa_rt
import object_module as obj
import arm64_isel
import x86_isel
import wasm_isel
import ssa_fragments as frag
import imports as native_imports
import macho
import elf
import pe

// =========================================================================
// Public Pipeline Types & Constructors
// =========================================================================

pub struct MirProgram {
    hir: hb.HirProgram,
    bodies: []mb.MirBody,
    sources: []string,
}

pub struct BuildOptions {
    target: obj.TargetKind,
    run_opt: bool,
    verify_ssa: bool,
    synthesize_runtime: bool,
    debug_info: bool,
    cache_dir: string,
    producer: string,
    comp_dir: string,
    main_file: string,
    macho_cfg: macho.MachoConfig,
    elf_cfg: elf.ElfConfig,
    pe_cfg: pe.PeConfig,
    lib_overrides: []native_imports.LibraryOverride,
}

pub struct CompileOutput {
    ok: bool,
    error: string,
    image: []u8,
    module: obj.ObjectModule,
    ssa_prog: ssa.SsaProgram,
    diagnostics: []diag.Diagnostic,
    total_fns: i32,
    cache_hits: i32,
    cache_misses: i32,
    type_desc_count: i32,
    recompiled_fn_ids: []i32,
}

pub fn new_mir_program(move hir: hb.HirProgram, move bodies: []mb.MirBody) -> MirProgram {
    MirProgram {
        hir: move hir,
        bodies: move bodies,
        sources: [],
    }
}

pub fn new_mir_program_with_sources(move hir: hb.HirProgram, move bodies: []mb.MirBody,
    move sources: []string) -> MirProgram {
    MirProgram {
        hir: move hir,
        bodies: move bodies,
        sources: move sources,
    }
}

pub fn default_options(target: obj.TargetKind) -> BuildOptions {
    BuildOptions {
        target: target,
        run_opt: true,
        verify_ssa: true,
        synthesize_runtime: false,
        debug_info: false,
        cache_dir: "",
        producer: "dunder-ssa-driver 1.0",
        comp_dir: ".",
        main_file: "main.ddr",
        macho_cfg: macho.default_config(),
        elf_cfg: elf.default_config(),
        pe_cfg: pe.default_config(),
        lib_overrides: [],
    }
}

pub fn target_from_name(name: string) -> Result<obj.TargetKind, string> {
    if name == "arm64-macos" { return .Ok(.Arm64Macos) }
    if name == "arm64-linux" { return .Ok(.Arm64Linux) }
    if name == "x86_64-linux" { return .Ok(.X86_64Linux) }
    if name == "x86_64-windows" { return .Ok(.X86_64Windows) }
    if name == "wasm32" { return .Ok(.Wasm32) }
    if name == "wasm32-wasi" { return .Ok(.Wasm32Wasi) }
    .Err("unknown SSA backend target: " + name)
}

// =========================================================================
// Internal Metadata Cloning & Image Packaging Helpers
// =========================================================================

fn clone_type_table(tt: &ht.TypeTable) -> ht.TypeTable {
    mut entries: []ht.TypeEntry = []
    entries.reserve(tt.entries.len)
    for i in 0..tt.entries.len {
        e := &tt.entries[i]
        entries.push(ht.TypeEntry {
            kind: e.kind,
            name: e.name.clone(),
            owner_mod: e.owner_mod,
            size: e.size,
            align: e.align,
            inner_a: e.inner_a,
            inner_b: e.inner_b,
            count: e.count,
            flags: e.flags,
            origin_count: e.origin_count,
            dispose_fn: e.dispose_fn,
            from_start: e.from_start,
            from_len: e.from_len,
            repr_ty: e.repr_ty,
            closure_fn_id: e.closure_fn_id,
        })
    }
    mut fields: []ht.FieldEntry = []
    fields.reserve(tt.fields.len)
    for i in 0..tt.fields.len {
        f := &tt.fields[i]
        fields.push(ht.FieldEntry {
            name: f.name.clone(),
            ty: f.ty,
            offset: f.offset,
            is_pub: f.is_pub,
            origin_slot: f.origin_slot,
        })
    }
    mut variants: []ht.VariantEntry = []
    variants.reserve(tt.variants.len)
    for i in 0..tt.variants.len {
        v := &tt.variants[i]
        variants.push(ht.VariantEntry {
            name: v.name.clone(),
            tag_value: v.tag_value,
            payload_start: v.payload_start,
            payload_count: v.payload_count,
        })
    }
    ht.TypeTable {
        entries: move entries,
        fields: move fields,
        variants: move variants,
        params: tt.params.clone(),
        from_edges: tt.from_edges.clone(),
        map_insts: tt.map_insts.clone(),
        gen_insts: tt.gen_insts.clone(),
        gen_inst_args: tt.gen_inst_args.clone(),
        ref_of: tt.ref_of.clone(),
        mut_ref_of: tt.mut_ref_of.clone(),
        array_of: tt.array_of.clone(),
        fat_slice_of: tt.fat_slice_of.clone(),
        region_slice_of: tt.region_slice_of.clone(),
        raw_const_of: tt.raw_const_of.clone(),
        raw_mut_of: tt.raw_mut_of.clone(),
        task_of: tt.task_of.clone(),
        option_of: tt.option_of.clone(),
        map_inst_of: tt.map_inst_of.clone(),
        gen_inst_of: tt.gen_inst_of.clone(),
        fat_str_ty: tt.fat_str_ty,
        fn_ptr_map: Map<string, i64>::new(),
        sealed: tt.sealed,
        platform: tt.platform,
    }
}

// Lightweight HirProgram metadata clone for runtime synthesis (copies type table,
// extern/fn headers, extern statics, and embed blobs without duplicating HIR expr/stmt trees).
fn clone_hir_metadata(hir: &hb.HirProgram, tt: &ht.TypeTable) -> hb.HirProgram {
    mut fns: []hb.HirFn = []
    fns.reserve(hir.fns.len)
    for i in 0..hir.fns.len {
        sf := &hir.fns[i]
        mut nf := hb.new_fn(sf.id, sf.name.clone(), sf.owner_mod, sf.sig_ty, sf.ret_ty, sf.param_count)
        nf.is_pub = sf.is_pub
        nf.is_unsafe = sf.is_unsafe
        nf.is_extern = sf.is_extern
        nf.is_generic_template = sf.is_generic_template
        nf.is_trait_default = sf.is_trait_default
        nf.is_closure_body = sf.is_closure_body
        nf.requires_caps = sf.requires_caps
        nf.extern_lib = sf.extern_lib.clone()
        nf.extern_symbol = sf.extern_symbol.clone()
        nf.variadic_fixed = sf.variadic_fixed
        nf.link_weak = sf.link_weak
        nf.link_delay = sf.link_delay
        nf.is_thread_safe = sf.is_thread_safe
        nf.is_test = sf.is_test
        nf.test_group = sf.test_group.clone()
        nf.span_start = sf.span_start
        nf.span_end = sf.span_end
        fns.push(move nf)
    }
    mut ext_statics: []hb.HirExternStatic = []
    ext_statics.reserve(hir.extern_statics.len)
    for i in 0..hir.extern_statics.len {
        es := &hir.extern_statics[i]
        ext_statics.push(hb.HirExternStatic {
            name: es.name.clone(),
            owner_mod: es.owner_mod,
            ty: es.ty,
            is_mut: es.is_mut,
            extern_lib: es.extern_lib.clone(),
            extern_symbol: es.extern_symbol.clone(),
            link_weak: es.link_weak,
            link_delay: es.link_delay,
            span_start: es.span_start,
            span_end: es.span_end,
        })
    }
    mut mod_paths: []string = []
    for i in 0..hir.mod_paths.len { mod_paths.push(hir.mod_paths[i].clone()) }
    hb.HirProgram {
        types: clone_type_table(&tt),
        fns: move fns,
        consts: [],
        extern_statics: move ext_statics,
        entry_fn: hir.entry_fn,
        mod_paths: move mod_paths,
        mod_caps: hir.mod_caps.clone(),
        embed_blobs: hir.embed_blobs.clone(),
        embed_starts: hir.embed_starts.clone(),
        embed_counts: hir.embed_counts.clone(),
        safe_send_sync_checks: [],
        diagnostics: [],
        ok: hir.ok,
    }
}

fn format_diags_summary(diags: &[]diag.Diagnostic) -> string {
    if diags.len == 0 { return "unknown SSA error" }
    mut out := ""
    mut lim := diags.len
    if lim > 5 { lim = 5 }
    for i in 0..lim {
        if i > 0 { out = out + "; " }
        d := &diags[i]
        out = out + d.code + ": " + d.message
    }
    out
}

fn fail_output(target: obj.TargetKind, err: string, move diags: []diag.Diagnostic) -> CompileOutput {
    CompileOutput {
        ok: false,
        error: err.clone(),
        image: [],
        module: obj.new(target),
        ssa_prog: ssa.new_program(0, -1),
        diagnostics: move diags,
        total_fns: 0,
        cache_hits: 0,
        cache_misses: 0,
        type_desc_count: 0,
        recompiled_fn_ids: [],
    }
}

fn emit_native_image_for_options(m: &obj.ObjectModule, opts: &BuildOptions) -> []u8 {
    if m.target == .Arm64Macos {
        signer := macho.serial_signer()
        return obj.emit_macho(&m, &opts.macho_cfg, &signer, opts.debug_info,
            opts.producer.clone(), opts.comp_dir.clone(), opts.main_file.clone())
    }
    if m.target == .Arm64Linux || m.target == .X86_64Linux {
        return obj.emit_elf(&m, &opts.elf_cfg, opts.debug_info,
            opts.producer.clone(), opts.comp_dir.clone(), opts.main_file.clone())
    }
    obj.emit_pe(&m, &opts.pe_cfg)
}

// =========================================================================
// Core End-to-End Compilation Pipeline
// =========================================================================

fn target_is_matches(name: string, platform: i32) -> bool {
    (name == "macos" && platform == 0) ||
    (name == "arm64-macos" && platform == 0) ||
    (name == "arm64-linux" && platform == 1) ||
    (name == "x86_64-linux" && platform == 2) ||
    (name == "wasm32-wasi" && platform == 4) ||
    (name == "x86_64-windows" && platform == 5) ||
    (name == "linux" && (platform == 1 || platform == 2)) ||
    (name == "windows" && platform == 5) ||
    (name == "wasm" && (platform == 3 || platform == 4)) ||
    (name == "wasi" && platform == 4) ||
    (name == "arm64" && (platform == 0 || platform == 1)) ||
    (name == "x86_64" && (platform == 2 || platform == 5)) ||
    (name == "wasm32" && (platform == 3 || platform == 4)) ||
    (name == "native" && platform != 3 && platform != 4)
}

fn trace_const_str_ssa(f: &ssa.SsaFunc, v_in: i32) -> (bool, string) {
    mut v := v_in
    mut steps := 0
    while v >= 0 && v < f.vals.len && steps < 8 {
        steps += 1
        di := f.vals[v].def_inst
        if di < 0 || di >= f.insts.len { return (false, "") }
        ins := f.insts[di]
        if (ins.kind == .ConstStr || ins.kind == .ConstCStr) &&
            ins.str_idx >= 0 && ins.str_idx < f.const_strs.len {
            return (true, f.const_strs[ins.str_idx].clone())
        }
        if ins.kind == .Copy {
            v = ins.op_a
            continue
        }
        if ins.kind == .Load && ins.aux >= 0 {
            slot := ins.aux
            bb := f.vals[v].def_bb
            if bb >= 0 && bb < f.blocks.len {
                s0 := f.blocks[bb].inst_start
                n0 := f.blocks[bb].inst_len
                mut found_v := -1
                for k in 0..n0 {
                    iid := f.block_insts[s0 + k]
                    if iid == di { break }
                    si := f.insts[iid]
                    if si.kind == .Store && si.aux == slot { found_v = si.op_b }
                }
                if found_v >= 0 { v = found_v; continue }
            }
        }
        return (false, "")
    }
    (false, "")
}

// Fold `target_is("...")` IntrinsicCalls to constant bools before SSA optimization so
// CFG simplification & dead-function pruning eliminate inactive platform branches (e.g. win32 on macOS).
fn fold_target_is_program(sp: &mut ssa.SsaProgram, platform: i32) {
    for fi in 0..sp.funcs.len {
        f := &mut sp.funcs[fi]
        mut folded_any := false
        for bb in 0..f.blocks.len {
            tid := f.blocks[bb].term_id
            if tid < 0 { continue }
            tm := f.terms[tid]
            if tm.kind != .IntrinsicCall || tm.callee != hb.INTRINSIC_TARGET_IS || tm.dest_val < 0 || tm.target_a < 0 {
                continue
            }
            mut matched := false
            mut known := false
            if tm.arg_len > 0 {
                (ok_s, txt) := trace_const_str_ssa(&f, f.val_args[tm.arg_start])
                if ok_s {
                    known = true
                    matched = target_is_matches(txt, platform)
                }
            }
            if !known { continue }
            folded_any = true
            // Replace IntrinsicCall terminator with ConstInt defining dest_val + Goto target_a
            mut ci := ssa.make_inst(.ConstInt, ht.TY_BOOL, -1, -1, -1, 0, -1,
                if matched { 1 } else { 0 }, -1, 0, 0, tm.span_start, tm.span_end)
            ci.res = tm.dest_val
            iid := f.insts.len
            f.insts.push(ci)
            f.vals[tm.dest_val].def_bb = bb
            f.vals[tm.dest_val].def_inst = iid
            // Append iid to bb's instruction slice
            old_s := f.blocks[bb].inst_start
            old_n := f.blocks[bb].inst_len
            new_s := f.block_insts.len
            for k in 0..old_n { f.block_insts.push(f.block_insts[old_s + k]) }
            f.block_insts.push(iid)
            f.blocks[bb].inst_start = new_s
            f.blocks[bb].inst_len = old_n + 1
            f.terms[tid].kind = .Goto
            f.terms[tid].callee = -1
            f.terms[tid].arg_start = 0
            f.terms[tid].arg_len = 0
            f.terms[tid].dest_val = -1
        }
        // Fold any Branch whose cond_val traces to a ConstInt (including via pre-Mem2Reg Store/Load of dest_val!)
        mut cfg_changed := false
        if folded_any {
            for bb in 0..f.blocks.len {
                tid := f.blocks[bb].term_id
                if tid < 0 { continue }
                tm := f.terms[tid]
                if tm.kind == .Branch && tm.cond_val >= 0 && tm.cond_val < f.vals.len {
                    // Trace cond_val through Copy / single-pred Store->Load
                    mut cv := tm.cond_val
                    mut is_const := false
                    mut cval: i64 = 0
                    mut csteps := 0
                    while cv >= 0 && cv < f.vals.len && csteps < 8 {
                        csteps += 1
                        di := f.vals[cv].def_inst
                        if di < 0 || di >= f.insts.len { break }
                        ins := f.insts[di]
                        if ins.kind == .ConstInt { is_const = true; cval = ins.imm_i64; break }
                        if ins.kind == .Copy { cv = ins.op_a; continue }
                        if ins.kind == .Load && ins.aux >= 0 {
                            slot := ins.aux
                            lbb := f.vals[cv].def_bb
                            if lbb >= 0 && lbb < f.blocks.len {
                                s0 := f.blocks[lbb].inst_start
                                n0 := f.blocks[lbb].inst_len
                                mut fv := -1
                                for k in 0..n0 {
                                    iid := f.block_insts[s0 + k]
                                    if iid == di { break }
                                    si := f.insts[iid]
                                    if si.kind == .Store && si.aux == slot { fv = si.op_b }
                                }
                                if fv >= 0 { cv = fv; continue }
                            }
                        }
                        break
                    }
                    if is_const {
                        take_a := cval != 0
                        f.terms[tid].kind = .Goto
                        f.terms[tid].cond_val = -1
                        if take_a {
                            f.terms[tid].target_b = -1
                            f.terms[tid].arg2_start = 0
                            f.terms[tid].arg2_len = 0
                        } else {
                            f.terms[tid].target_a = tm.target_b
                            f.terms[tid].arg_start = tm.arg2_start
                            f.terms[tid].arg_len = tm.arg2_len
                            f.terms[tid].target_b = -1
                            f.terms[tid].arg2_start = 0
                            f.terms[tid].arg2_len = 0
                        }
                        cfg_changed = true
                    }
                }
            }
        }
        if cfg_changed { ssa.compute_preds(&mut f) }
    }
}

// Prune functions unreachable from `entry_fn` so dead platform helpers (e.g. Win32 imports on macOS)
// are not emitted into ObjectModule.
fn prune_unreachable_fns(sp: &mut ssa.SsaProgram, hir: &hb.HirProgram, target: obj.TargetKind) {
    if target == .Wasm32 { return }
    types := &hir.types
    if sp.entry_fn < 0 || sp.entry_fn >= sp.fn_id_to_idx.len { return }
    eidx := sp.fn_id_to_idx[sp.entry_fn]
    if eidx < 0 || eidx >= sp.funcs.len { return }

    mut visited: []bool = []
    for _ in 0..sp.funcs.len { visited.push(false) }
    mut queue: []i32 = []
    visited[eidx] = true
    queue.push(eidx)

    mut qi := 0
    while qi < queue.len {
        cur := queue[qi]
        qi += 1
        sf := &sp.funcs[cur]
        if sf.blocks.len == 0 { continue }
        // BFS only reachable blocks within `sf` so dead target_is branches never pull in dead callees!
        mut bvis: []bool = []
        for _ in 0..sf.blocks.len { bvis.push(false) }
        mut bq: []i32 = [0]
        bvis[0] = true
        mut bqi := 0
        mut succs: []i32 = []
        while bqi < bq.len {
            bi := bq[bqi]
            bqi += 1
            blk := sf.blocks[bi]
            for ii in 0..blk.inst_len {
                ins := sf.insts[sf.block_insts[blk.inst_start + ii]]
                if ins.kind == .ConstFn && ins.aux >= 0 && ins.aux < sp.fn_id_to_idx.len {
                    tidx := sp.fn_id_to_idx[ins.aux]
                    if tidx >= 0 && tidx < sp.funcs.len && !visited[tidx] {
                        visited[tidx] = true
                        queue.push(tidx)
                    }
                } else if ins.kind == .ClosureMake {
                    te := &types.entries[ins.ty]
                    cfid := if te.closure_fn_id >= 0 { te.closure_fn_id } else { ins.aux }
                    if cfid >= 0 && cfid < sp.fn_id_to_idx.len {
                        tidx := sp.fn_id_to_idx[cfid]
                        if tidx >= 0 && tidx < sp.funcs.len && !visited[tidx] {
                            visited[tidx] = true
                            queue.push(tidx)
                        }
                    }
                }
            }
            if blk.term_id >= 0 {
                tm := sf.terms[blk.term_id]
                if tm.kind == .Call && tm.callee >= 0 && tm.callee < sp.fn_id_to_idx.len {
                    tidx := sp.fn_id_to_idx[tm.callee]
                    if tidx >= 0 && tidx < sp.funcs.len && !visited[tidx] {
                        visited[tidx] = true
                        queue.push(tidx)
                    }
                } else if tm.kind == .IntrinsicCall && tm.callee == hb.INTRINSIC_DROP && tm.arg_len > 0 {
                    av := sf.val_args[tm.arg_start]
                    mut ty := sf.vals[av].ty
                    if types.entries[ty].kind == .Ref || types.entries[ty].kind == .MutRef {
                        ty = types.entries[ty].inner_a
                    }
                    if ty >= 0 && ty < types.entries.len && types.entries[ty].dispose_fn >= 0 {
                        dfid := types.entries[ty].dispose_fn
                        if dfid < sp.fn_id_to_idx.len {
                            tidx := sp.fn_id_to_idx[dfid]
                            if tidx >= 0 && tidx < sp.funcs.len && !visited[tidx] {
                                visited[tidx] = true
                                queue.push(tidx)
                            }
                        }
                    }
                }
            }
            ssa.term_succs(&sf, bi, &mut succs)
            for si in 0..succs.len {
                sb := succs[si]
                if sb >= 0 && sb < sf.blocks.len && !bvis[sb] {
                    bvis[sb] = true
                    bq.push(sb)
                }
            }
        }
    }

    // Compact sp.funcs to keep only reachable functions (and rebuild fn_id_to_idx)
    mut kept: []ssa.SsaFunc = []
    for fi in 0..sp.fn_id_to_idx.len { sp.fn_id_to_idx[fi] = -1 }
    old_funcs := replace(&mut sp.funcs, [])
    mut idx := 0
    for sf in move old_funcs {
        if visited[idx] {
            fid := sf.fn_id
            new_i := kept.len
            if fid >= 0 && fid < sp.fn_id_to_idx.len {
                sp.fn_id_to_idx[fid] = new_i
            }
            kept.push(move sf)
        }
        idx += 1
    }
    sp.funcs = move kept
}

pub fn compile_mir_program_ssa_detailed(prog: &MirProgram, tt: &ht.TypeTable,
    opts: &BuildOptions) -> CompileOutput {
    mut diags: []diag.Diagnostic = []
    if !prog.hir.ok {
        return fail_output(opts.target, "HirProgram contains errors", move diags)
    }

    // 1. Lower post-drop HL-MIR bodies to Target-Independent Typed SSA MIR
    mut sp := ssa_lower.lower_program(&prog.hir, &prog.bodies, &mut diags)
    if diags.len > 0 {
        err := "ssa_lower failed: " + format_diags_summary(&diags)
        return fail_output(opts.target, err, move diags)
    }

    // Fold target_is("...") & prune unreachable functions BEFORE opt/verify
    fold_target_is_program(&mut sp, obj.target_to_platform(opts.target))
    prune_unreachable_fns(&mut sp, &prog.hir, opts.target)

    // 2. Verify pre-opt SSA invariants
    if opts.verify_ssa {
        if !ssa_verify.verify_program(&tt, &sp, &mut diags) || diags.len > 0 {
            err := "ssa_verify(pre-opt) failed: " + format_diags_summary(&diags)
            return fail_output(opts.target, err, move diags)
        }
    }

    // 3. Run unified SSA optimization pipeline (Mem2Reg, Inliner, GVN/ConstFold, Bounds/Ovf Elision, CFG/DCE)
    if opts.run_opt {
        if !ssa_opt.optimize_program(&tt, &mut sp, false, &mut diags) || diags.len > 0 {
            err := "ssa_opt failed: " + format_diags_summary(&diags)
            return fail_output(opts.target, err, move diags)
        }
        if opts.verify_ssa {
            if !ssa_verify.verify_program(&tt, &sp, &mut diags) || diags.len > 0 {
                err := "ssa_verify(post-opt) failed: " + format_diags_summary(&diags)
                return fail_output(opts.target, err, move diags)
            }
        }
    }

    prune_unreachable_fns(&mut sp, &prog.hir, opts.target)

    total_fns := sp.funcs.len

    // 4. Optional structured SSA runtime synthesis + TYPE_DESC_TABLE preparation
    if opts.synthesize_runtime {
        mut rt_hir := clone_hir_metadata(&prog.hir, &tt)
        start_fid := rt_hir.fns.len
        reg := ssa_rt.synthesize_runtime(&mut rt_hir.types, &mut sp, start_fid)
        if opts.verify_ssa {
            if !ssa_rt.verify_runtime(&rt_hir.types, &sp, &reg, &mut diags) || diags.len > 0 {
                err := "ssa_runtime verification failed: " + format_diags_summary(&diags)
                return fail_output(opts.target, err, move diags)
            }
        }
        if opts.target == .Wasm32 || opts.target == .Wasm32Wasi {
            wasm_bin := wasm_isel.emit_wasm(&sp, &rt_hir, opts.target == .Wasm32Wasi)
            mut wm := obj.new(opts.target)
            _ := obj.append_text(&mut wm, &wasm_bin, 1)
            return CompileOutput {
                ok: true, error: "", image: move wasm_bin, module: move wm, ssa_prog: move sp,
                diagnostics: move diags, total_fns: total_fns, cache_hits: 0, cache_misses: total_fns,
                type_desc_count: reg.type_descs.len, recompiled_fn_ids: [],
            }
        }
        mut obj_mod := if opts.target == .Arm64Macos || opts.target == .Arm64Linux {
            if opts.debug_info { arm64_isel.emit_program_with_sources(&sp, &rt_hir, opts.target, &prog.sources) }
            else { arm64_isel.emit_program(&sp, &rt_hir, opts.target) }
        } else {
            x86_isel.emit_program(&sp, &rt_hir, opts.target)
        }
        _ := ssa_rt.populate_type_desc_table(&mut obj_mod, &reg)
        img := emit_native_image_for_options(&obj_mod, &opts)
        return CompileOutput {
            ok: true, error: "", image: move img, module: move obj_mod, ssa_prog: move sp,
            diagnostics: move diags, total_fns: total_fns, cache_hits: 0, cache_misses: total_fns,
            type_desc_count: reg.type_descs.len, recompiled_fn_ids: [],
        }
    }

    // 5. Direct ISel -> ObjectModule -> Native/WASM executable packaging
    if opts.target == .Wasm32 || opts.target == .Wasm32Wasi {
        wasm_bin := wasm_isel.emit_wasm(&sp, &prog.hir, opts.target == .Wasm32Wasi)
        mut wm := obj.new(opts.target)
        _ := obj.append_text(&mut wm, &wasm_bin, 1)
        return CompileOutput {
            ok: true, error: "", image: move wasm_bin, module: move wm, ssa_prog: move sp,
            diagnostics: move diags, total_fns: total_fns, cache_hits: 0, cache_misses: total_fns,
            type_desc_count: 0, recompiled_fn_ids: [],
        }
    }

    obj_mod := if opts.target == .Arm64Macos || opts.target == .Arm64Linux {
        if opts.debug_info { arm64_isel.emit_program_with_sources(&sp, &prog.hir, opts.target, &prog.sources) }
        else { arm64_isel.emit_program(&sp, &prog.hir, opts.target) }
    } else {
        x86_isel.emit_program(&sp, &prog.hir, opts.target)
    }
    img := emit_native_image_for_options(&obj_mod, &opts)
    CompileOutput {
        ok: true, error: "", image: move img, module: move obj_mod, ssa_prog: move sp,
        diagnostics: move diags, total_fns: total_fns, cache_hits: 0, cache_misses: total_fns,
        type_desc_count: 0, recompiled_fn_ids: [],
    }
}

// =========================================================================
// Incremental Content-Hashed Fragment-Cached Compilation Pipeline
// =========================================================================

pub fn compile_mir_program_ssa_cached_detailed(cache: &mut frag.FragmentCache,
    prog: &MirProgram, tt: &ht.TypeTable, opts: &BuildOptions) -> CompileOutput {
    _ := tt.sealed
    res := frag.compile_program_cached(&mut cache, &prog.hir, opts.target, opts.run_opt)
    if !res.ok {
        return CompileOutput {
            ok: false,
            error: res.error,
            image: [],
            module: move res.module,
            ssa_prog: ssa.new_program(0, -1),
            diagnostics: move res.diagnostics,
            total_fns: res.total_fns,
            cache_hits: res.cache_hits,
            cache_misses: res.cache_misses,
            type_desc_count: 0,
            recompiled_fn_ids: move res.recompiled_fn_ids,
        }
    }
    // Re-emit with BuildOptions debug_info / configs when targeting native with custom options
    mut img := move res.executable
    if opts.debug_info && opts.target != .Wasm32 && opts.target != .Wasm32Wasi {
        img = emit_native_image_for_options(&res.module, &opts)
    }
    CompileOutput {
        ok: true,
        error: "",
        image: move img,
        module: move res.module,
        ssa_prog: ssa.new_program(0, -1),
        diagnostics: move res.diagnostics,
        total_fns: res.total_fns,
        cache_hits: res.cache_hits,
        cache_misses: res.cache_misses,
        type_desc_count: 0,
        recompiled_fn_ids: move res.recompiled_fn_ids,
    }
}

// =========================================================================
// Primary Clean Public Entrypoints (`Result<[]u8, string>`)
// =========================================================================

pub fn compile_mir_program_ssa(prog: &MirProgram, tt: &ht.TypeTable,
    opts: &BuildOptions) -> Result<[]u8, string> {
    if opts.cache_dir.len > 0 && !opts.synthesize_runtime {
        mut cache := frag.new_cache(opts.cache_dir.clone())
        return compile_mir_program_ssa_cached(&mut cache, &prog, &tt, &opts)
    }
    out := compile_mir_program_ssa_detailed(&prog, &tt, &opts)
    if !out.ok { return .Err(out.error) }
    .Ok(move out.image)
}

pub fn compile_mir_program_ssa_cached(cache: &mut frag.FragmentCache,
    prog: &MirProgram, tt: &ht.TypeTable, opts: &BuildOptions) -> Result<[]u8, string> {
    out := compile_mir_program_ssa_cached_detailed(&mut cache, &prog, &tt, &opts)
    if !out.ok { return .Err(out.error) }
    .Ok(move out.image)
}
