import arm64 as arm
import backend_row as row
import ..frontend.unsigned

pub enum Method { Unknown, Not, And, Or, Xor, Left, Right, Add, Sub, Mul }
pub fn method(name: string) -> Method {
    if name == "bit_not" { return .Not }
    if name == "bit_and" { return .And }
    if name == "bit_or" { return .Or }
    if name == "bit_xor" { return .Xor }
    if name == "shl" { return .Left }
    if name == "shr" { return .Right }
    if name == "wrapping_add" { return .Add }
    if name == "wrapping_sub" { return .Sub }
    if name == "wrapping_mul" { return .Mul }
    .Unknown
}
pub fn is_shift(op: Method) -> bool { op == .Left || op == .Right }
fn normalize(code: &mut arm.Code, ty: i32) {
    if ty == 1 { arm.sign_extend_i32(&mut code, 0, 0) }
    else if ty == 16 { arm.bitfield(&mut code, true, true, 0, 0, 0, 15) }
    else if unsigned.has(ty) { unsigned.mask(&mut code, ty) }
}
pub fn complement(code: &mut arm.Code, ty: i32) {
    arm.integer_binary(&mut code, 12, true, false, 0, 31, 0, -1); normalize(&mut code, ty)
}
fn registers(code: &mut arm.Code, op: Method, ty: i32, lhs: i32, rhs: i32) {
    mut opcode := 1
    if op == .And { opcode = 8 } else if op == .Or { opcode = 9 } else if op == .Xor { opcode = 10 }
    else if op == .Left { opcode = 14 } else if op == .Right { opcode = 15 }
    else if op == .Sub { opcode = 2 } else if op == .Mul { opcode = 3 } else { assert(op == .Add) }
    if op == .Right && ty == 16 { arm.bitfield(&mut code, false, true, lhs, lhs, 0, 15) }
    arm.integer_binary(&mut code, opcode, ty != 1, false, 0, lhs, rhs, -1)
    normalize(&mut code, ty)
}
pub fn dynamic(code: &mut arm.Code, op: Method, ty: i32, bounds: i32) {
    if is_shift(op) {
        arm.imm(&mut code, 2, i64(unsigned.width_for(ty, code.platform)))
        arm.compare_register(&mut code, 0, 2); arm.branch(&mut code, bounds, 4)
    }
    registers(&mut code, op, ty, 1, 0)
}
pub fn immediate(code: &mut arm.Code, op: Method, ty: i32, value: i64, bounds: i32) {
    if is_shift(op) {
        width := i64(unsigned.width_for(ty, code.platform))
        if value < 0 || value >= width { arm.branch(&mut code, bounds, 0); return }
        if value == 0 { return }
        if op == .Right {
            arm.bitfield(&mut code, false, true, 0, 0, i32(value), i32(width - 1))
        } else {
            arm.bitfield(&mut code, false, true, 0, 0, i32(i64(64) - value), i32(width - 1 - value))
            if ty == 1 || ty == 16 { normalize(&mut code, ty) }
        }
        return
    }
    if op == .And && value.bit_and(value.wrapping_add(1)) == 0 {
        if value == 0 { arm.imm(&mut code, 0, 0); return }
        if value == -1 { return }
        mut top := 0; mut mask := value.shr(1)
        while mask != 0 { top = top + 1; mask = mask.shr(1) }
        arm.bitfield(&mut code, false, true, 0, 0, 0, top); return
    }
    if op == .Add || op == .Sub {
        field := arm.add_sub_field(value)
        if field >= 0 {
            if value != 0 {
                mut opcode := 1; if op == .Sub { opcode = 2 }
                arm.integer_binary(&mut code, opcode, true, false, 0, 0, -1, value); normalize(&mut code, ty)
            }
            return
        }
    }
    arm.imm(&mut code, 1, value); registers(&mut code, op, ty, 0, 1)
}
pub fn signed_add_sub(code: &mut arm.Code, ty: i32, subtract: bool, checked: bool, overflow: i32,
    dst: i32, lhs: i32, rhs: i32, amount: i64) {
    if ty == 16 {
        arm.integer_binary(&mut code, if subtract { 2 } else { 1 }, true, false, dst, lhs, rhs, amount)
        if checked { unsigned.check_i16(&mut code, dst, overflow) }
        return
    }
    narrow := checked && ty == 1
    if checked && (code.mir_capture || code.prefixing) {
        arm.symbolic_operand(&mut code, row.checked_add_sub(subtract, !narrow, dst, lhs, rhs, amount), overflow, 8)
        return
    }
    mut opcode := 1; if subtract { opcode = 2 }
    arm.integer_binary(&mut code, opcode, !narrow, checked, dst, lhs, rhs, amount)
    if checked { arm.branch(&mut code, overflow, 8) }
    if narrow { arm.sign_extend_i32(&mut code, dst, dst) }
}
pub fn signed_binary(code: &mut arm.Code, opcode: i32, ty: i32, overflow: i32, zero: i32) {
    if opcode >= 6 {
        arm.compare_register(&mut code, 1, 0)
        arm.set_condition(&mut code, 0, relation(opcode)); return
    }
    if opcode == 1 || opcode == 2 {
        signed_add_sub(&mut code, ty, opcode == 2, true, overflow, 0, 1, 0, -1)
        return
    }
    if opcode == 3 { signed_multiply(&mut code, ty, true, overflow); return }
    signed_division(&mut code, ty, opcode == 5, true, overflow, zero)
}
pub fn signed_multiply(code: &mut arm.Code, ty: i32, checked: bool, overflow: i32) {
    check_high := checked && ty == 2
    if check_high { arm.integer_binary(&mut code, 4, true, false, 2, 1, 0, -1) }
    arm.integer_binary(&mut code, 3, true, false, 0, 1, 0, -1)
    if check_high {
        arm.bitfield(&mut code, true, true, 3, 0, 63, 63); arm.compare_register(&mut code, 2, 3)
        arm.branch(&mut code, overflow, 3)
    }
    if checked && ty == 1 { check_i32(&mut code, overflow) }
    if checked && ty == 16 { unsigned.check_i16(&mut code, 0, overflow) }
}
pub fn signed_division(code: &mut arm.Code, ty: i32, remainder: bool, checked: bool, overflow: i32, zero: i32) {
    arm.branch(&mut code, zero, 18)
    if checked {
        minimum: i64 = if ty == 2 { -9223372036854775808 } else if ty == 16 { -32768 } else { -2147483648 }
        safe := arm.label(&mut code)
        arm.imm(&mut code, 2, minimum); arm.compare_register(&mut code, 1, 2); arm.branch(&mut code, safe, 3)
        arm.imm(&mut code, 2, -1); arm.compare_register(&mut code, 0, 2); arm.branch(&mut code, overflow, 2)
        arm.mark(&mut code, safe)
    }
    arm.integer_binary(&mut code, 6, true, false, 2, 1, 0, -1)
    if remainder { arm.multiply_subtract(&mut code, 0, 2, 0, 1) } else { arm.mov(&mut code, 0, 2) }
    if checked && ty == 1 { check_i32(&mut code, overflow) }
    if checked && ty == 16 { unsigned.check_i16(&mut code, 0, overflow) }
}
pub fn check_i32(code: &mut arm.Code, overflow: i32) {
    arm.sign_extend_i32(&mut code, 2, 0); arm.compare_register(&mut code, 0, 2); arm.branch(&mut code, overflow, 3)
}
pub fn relation(op: i32) -> i32 {
    if op == 6 { return 0 }; if op == 7 { return 1 }
    if op == 8 { return 11 }; if op == 9 { return 13 }; if op == 10 { return 12 }
    assert(op == 11); 10
}
