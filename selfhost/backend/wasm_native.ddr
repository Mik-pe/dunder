    abi.types(&mut s,&a)
    if wasi {
        signature_fd_write(&mut s)
        signature(&mut s,127,0)
    }
    for tag in 0..g.prints.len {if g.prints[tag]>=0 {signature(&mut s,print_type(tag),0)}}
    b.section(&mut out,1,&s)
    if m.imports>0 {
        s.clear();b.uleb(&mut s,m.imports);abi.imports(&mut s,&a)
        if wasi {
            wasi_ty_base:=2+a.starts.len
            b.name(&mut s,"wasi_snapshot_preview1");b.name(&mut s,"fd_write");b.op(&mut s,0);b.uleb(&mut s,wasi_ty_base)
            b.name(&mut s,"wasi_snapshot_preview1");b.name(&mut s,"proc_exit");b.op(&mut s,0);b.uleb(&mut s,wasi_ty_base+1)
        } else {
            for tag in 0..g.prints.len {if g.prints[tag]>=0 {
                b.name(&mut s,"dunder");b.name(&mut s,print_name(tag));b.op(&mut s,0);b.uleb(&mut s,m.print_base+g.prints[tag]-a.import_sigs.len)
            }}
        }
        b.section(&mut out,2,&s)
    }
    defined_prints:=if wasi {print_count}else{0}
    s.clear();b.uleb(&mut s,g.functions.len+a.callback_sigs.len+1+defined_prints)
    for _ in &g.functions {b.op(&mut s,0)}
    for sig in &a.callback_sigs {b.uleb(&mut s,2+sig)}
    mut main_ty:=0;if !wasi && ret!=0 {main_ty=1};b.op(&mut s,main_ty)
    if wasi {
        mut slot:=0
        for tag in 0..g.prints.len {if g.prints[tag]>=0 {b.uleb(&mut s,m.print_base+slot);slot=slot+1}}
    }
    b.section(&mut out,3,&s)
    s.clear();b.op(&mut s,1);b.op(&mut s,112);b.op(&mut s,0);b.uleb(&mut s,m.table_base+g.addresses.len);b.section(&mut out,4,&s)
    s.clear();b.op(&mut s,1);b.op(&mut s,0);b.uleb(&mut s,(m.heap+256+65535)/65536);b.section(&mut out,5,&s)
    s.clear();b.uleb(&mut s,70)
    for i in 0..70 {
        b.op(&mut s,126);mut mutability:=1;if i>=68 {mutability=0};b.op(&mut s,mutability)
        mut value:=0;if i==19 {value=m.heap+256}else if i==20 {value=m.heap+536870912}
        else if i==21 || i==31 || i==68 {value=m.heap}else if i==69 {value=m.stack_bottom}
        b.constant(&mut s,i64(value));b.op(&mut s,11)
    };b.section(&mut out,6,&s)
    s.clear();b.op(&mut s,3)
    b.name(&mut s,if wasi {"_start"}else{"main"});b.indexed(&mut s,0,start_fn)
    b.name(&mut s,"memory");b.indexed(&mut s,2,0)
    b.name(&mut s,"__indirect_function_table");b.indexed(&mut s,1,0);b.section(&mut out,7,&s)
    s.clear();b.op(&mut s,1);b.op(&mut s,0);b.i32_const(&mut s,1);b.op(&mut s,11)
    b.uleb(&mut s,a.table.len+g.addresses.len);abi.entries(&mut s,&a,m.imports+g.functions.len)
    for block in &g.addresses {b.uleb(&mut s,m.imports+g.function_id[block])}
    b.section(&mut out,9,&s)
}
fn is_trap_block(code: &arm.Code, g: &flow.Graph, block: i32) -> bool {
    start := g.starts[block]; limit := g.starts[block + 1]
    if limit <= start { return false }
    last := code.words[limit - 1]
    ok_tail := last == 3558866944 || (last == 3556769793 && limit - 2 >= start && code.words[limit - 2] == 3531606984)
    if !ok_tail { return false }
    for at in start..limit - 1 {
        w := code.words[at]
        if w != 3573751839 && w.bit_and(2139095040) != 1384120320 { return false }
    }
    true
}

fn splice_mir_body(out: &mut []u8, code: &arm.Code, g: &flow.Graph, m: &Image, a: &abi.Abi, linked: &LinkedWasm, idx: i32) -> bool {
    if linked.needs_pc[idx] {
        b.op(&mut out, 2); b.uleb(&mut out, linked.local_i64_counts[idx]); b.op(&mut out, 126); b.op(&mut out, 1); b.op(&mut out, 127)
    } else {
        b.op(&mut out, 1); b.uleb(&mut out, linked.local_i64_counts[idx]); b.op(&mut out, 126)
    }
    body_start := linked.body_starts[idx]; body_end := linked.body_ends[idx]
    body_len := body_end - body_start
    p_start := linked.patch_starts[idx]; p_end := linked.patch_ends[idx]
    mut cursor := 0
    for p in p_start..p_end {
        at := linked.patch_at[p]
        if at < cursor || at > body_len { return false }
        for bi in cursor..at { out.push(linked.bodies[body_start + bi]) }
        cursor = at
        kind := linked.patch_kind[p]; target := linked.patch_target[p]
        if kind == 0 {
            if target < 0 || target >= code.labels.len { return false }
            loc := code.labels[target]
            if loc < 0 || loc >= m.data_start { return false }
            fid := g.function_id[g.block_at[loc]]
            if fid < 0 { return false }
            b.indexed(&mut out, 16, m.imports + fid)
        } else if kind == 1 {
            if target < 0 || target >= code.labels.len { return false }
            loc := code.labels[target]
            if loc < 0 { return false }
            mut addr := 0
            if loc >= m.data_start {
                addr = m.data_base + (loc - m.data_start) * 4
            } else {
                aid := g.address_id[g.block_at[loc]]
                if aid < 0 { return false }
                addr = m.table_base + aid
            }
            b.constant(&mut out, i64(addr))
        } else if kind == 2 {
            if target < 0 || target >= g.prints.len || g.prints[target] < 0 { return false }
            b.indexed(&mut out, 16, g.prints[target])
        } else if kind == 3 {
            if target < 0 || target >= code.labels.len { return false }
            loc := code.labels[target]
            if loc < 0 || loc >= m.data_start { return false }
            blk := g.block_at[loc]
            if is_trap_block(&code, &g, blk) {
                b.op(&mut out, 0)
            } else if g.function_id[blk] >= 0 {
                b.indexed(&mut out, 16, m.imports + g.function_id[blk])
                b.op(&mut out, 15)
            } else {
                return false
            }
        } else if kind == 4 {
            if target < 0 || target >= a.starts.len { return false }
            abi.dispatch(&mut out, &a, target)
        } else {
            return false
        }
    }
    for bi in cursor..body_len { out.push(linked.bodies[body_start + bi]) }
    true
}

pub fn image(code:&arm.Code,data_start:i32,entry:i32,ret:i32,a:&abi.Abi)->Result {
    empty := empty_linked()
    image_linked_for(&code, data_start, entry, ret, &a, &empty, false)
}

pub fn image_linked(code:&arm.Code,data_start:i32,entry:i32,ret:i32,a:&abi.Abi,linked:&LinkedWasm)->Result {
    image_linked_for(&code, data_start, entry, ret, &a, &linked, false)
}

pub fn image_linked_for(code:&arm.Code,data_start:i32,entry:i32,ret:i32,a:&abi.Abi,linked:&LinkedWasm,wasi:bool)->Result {
    mut g:=flow.index(&code,data_start,entry,&a.callback_labels)
    mut mir_for_block := flow.filled(g.function_id.len, -1)
    if linked.active {
        for k in 0..linked.entry_labels.len {
            lbl := linked.entry_labels[k]
            if lbl >= 0 && lbl < code.labels.len {
                loc := code.labels[lbl]
                if loc >= 0 && loc < data_start {
                    blk := g.block_at[loc]
                    if blk >= 0 && blk < mir_for_block.len { mir_for_block[blk] = k }
                }
            }
        }
        mut merged_prints := 0
        for fi in 0..g.functions.len {
            k := mir_for_block[g.functions[fi]]
            if k >= 0 { merged_prints = merged_prints.bit_or(linked.prints_masks[k]) }
        }
        for tag in 0..9 {
            if merged_prints.bit_and(i32(1).shl(tag)) != 0 { g.prints[tag] = 0 }
        }
    }
    if wasi && (g.prints[5] >= 0 || g.prints[6] >= 0) {
        return Result { ok: false, error: "WASI float output requires the decimal formatter", text: [] }
    }
    print_count := wasi_print_count(&g)
    mut imports := a.import_sigs.len
    mut print_base := 2 + a.starts.len
    if wasi {
        imports = a.import_sigs.len + 2
        print_base = 4 + a.starts.len
    } else {
        mut count := a.import_sigs.len
        for i in 0..g.prints.len { if g.prints[i]>=0 { g.prints[i]=count; count=count+1 } }
        imports = count
    }
    start_fn := imports + g.functions.len + a.callback_sigs.len
    if wasi {
        mut print_fn := start_fn + 1
        for i in 0..g.prints.len { if g.prints[i]>=0 { g.prints[i]=print_fn; print_fn=print_fn+1 } }
    }
    data_base:=16+data_start%2*4
    data_bytes:=(code.words.len-data_start)*4
    bottom:=(data_base+data_bytes+15)/16*16
    wasi_scratch:=bottom
    stack_bottom:=bottom+(if wasi {128}else{0})
    m := Image { imports:imports,table_base:a.table.len+1,data_start:data_start,data_base:data_base,
                 heap:stack_bottom+1048576,stack_bottom:stack_bottom,print_base:print_base }
    mut out:[]u8=[0,97,115,109,1,0,0,0];header(&mut out,&g,&m,&a,ret,wasi,print_count,start_fn)
    mut section:[]u8=[]
    defined_prints:=if wasi {print_count}else{0}
    b.uleb(&mut section,g.functions.len+a.callback_labels.len+1+defined_prints)
    mut indices:=flow.filled(g.function_id.len,-1);mut instructions:[]u8=[]
    for f in &g.functions {
        instructions.clear()
        k := mir_for_block[f]
        if k >= 0 && splice_mir_body(&mut instructions, &code, &g, &m, &a, &linked, k) {
            b.blob(&mut section, &instructions)
            continue
        }
        instructions.clear()
        error:=body(&mut instructions,&code,&g,&m,&a,f,&mut indices)
        if error!="" {return Result{ok:false,error:error,text:[]}}
        b.blob(&mut section,&instructions)
    }
    mut labels:=flow.filled(code.labels.len,-1)
    for label in &a.callback_labels {labels[label]=m.imports+g.function_id[g.block_at[code.labels[label]]]}
    abi.callbacks(&mut section,&a,&labels)
    instructions.clear();b.op(&mut instructions,0);b.indexed(&mut instructions,16,m.imports)
    if wasi {
        if ret!=0 {
            wasi_proc_exit:=a.import_sigs.len+1
            b.read(&mut instructions,0);b.op(&mut instructions,167);b.op(&mut instructions,4);b.op(&mut instructions,64)
            b.read(&mut instructions,0);b.op(&mut instructions,167);b.indexed(&mut instructions,16,wasi_proc_exit)
            b.op(&mut instructions,11)
        }
        b.op(&mut instructions,11);b.blob(&mut section,&instructions)
        wasi_fd_write:=a.import_sigs.len
        for tag in 0..g.prints.len {
            if g.prints[tag]>=0 {
                instructions.clear()
                wasi_emit_print_body(&mut instructions,tag,wasi_fd_write,wasi_scratch)
                b.blob(&mut section,&instructions)
            }
        }
        b.section(&mut out,10,&section)
    } else {
        if ret!=0 {b.read(&mut instructions,0);b.op(&mut instructions,167)}
        b.op(&mut instructions,11);b.blob(&mut section,&instructions);b.section(&mut out,10,&section)
    }
    if data_bytes>0 {
        section.clear();b.op(&mut section,1);b.op(&mut section,0);b.i32_const(&mut section,data_base);b.op(&mut section,11)
        b.uleb(&mut section,data_bytes)
        for i in data_start..code.words.len {for j in 0..4 {b.op(&mut section,b.bits(code.words[i],8*j,255))}}
        b.section(&mut out,11,&section)
    }
    Result{ok:true,error:"",text:out}
}
