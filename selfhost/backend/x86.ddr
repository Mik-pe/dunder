pub fn finish(code: &arm.Code, data_start: i32, imports: &[]i32, slots: &[]i32) -> Result {
    mut c := Emitter { text: [], at: [], targets: [], stack_traps: [], store_end: -1, store_reg: -1, store_slot: -1 }
    mut offsets: []i32 = []
    mut reloc := 0
    mut next_import := 0
    mut import_sites: []i32 = []
    mut skip := -1
    c.text.reserve(data_start * 24)
    offsets.reserve(code.words.len + 1)
    mut label_word: []bool = []
    label_word.reserve(data_start)
    for i in 0..data_start { label_word.push(false) }
    for l in 0..code.labels.len {
        pos := code.labels[l]
        if pos >= 0 && pos < data_start { label_word[pos] = true }
    }
    prelude(&mut c)
    for i in 0..data_start {
        offsets.push(c.text.len)
        if label_word[i] { c.store_end = -1 }
        if i == skip { continue }
        if next_import < imports.len && i == imports[next_import] / 4 {
            lea_global: i64 = 0x488d05
            load_got: i64 = 0x488b05
            op(&mut c, if slots[next_import] < 0 { lea_global } else { load_got })
            import_sites.push(c.text.len)
            little(&mut c, 0, 4)
            if code.words[i] != 4244635648 { store(&mut c, 16, 0) }
            next_import += 1
            skip = i + 1
        } else if reloc < code.at.len && code.at[reloc] == i {
            relocation(&mut c, code.kinds[reloc], code.labels[code.target[reloc]])
            reloc += 1
        } else {
            previous := if i > 0 { code.words[i - 1] } else { 0 }
            if !word(&mut c, code.words[i], previous) {
                return Result { ok: false, error: f"unsupported x86 lowering for word {code.words[i]} at {i}", text: [], imports: [] }
            }
        }
    }
    for i in 0..c.stack_traps.len {
        at := c.stack_traps[i]
        patch(&mut c, at)
    }
    imm(&mut c, 0, 231)
    imm(&mut c, 7, 110)
    op(&mut c, 0x0f050f0b)
    while c.text.len % 8 != (data_start % 2) * 4 { byte(&mut c, 0) }
    for i in data_start..code.words.len {
        offsets.push(c.text.len)
        little(&mut c, code.words[i], 4)
    }
    offsets.push(c.text.len)
    for i in 0..c.at.len {
        destination := c.targets[i]
        if destination < 0 || destination >= offsets.len {
            return Result { ok: false, error: "invalid native relocation", text: [], imports: [] }
        }
        at := c.at[i]
        displacement(&mut c, at, offsets[destination])
    }
    Result { ok: true, error: "", text: c.text, imports: import_sites }
}

@test fn linux_syscall_table_covers_process_and_io_numbers() {
    mut c := Emitter { text: [], at: [], targets: [], stack_traps: [], store_end: -1, store_reg: -1, store_slot: -1 }
    supported: [i32; 44] = [93, 94, 63, 64, 222, 226, 56, 57, 35, 53, 34, 172, 38, 79, 80, 46, 135, 113, 198, 200, 201, 202, 203, 204, 205, 206, 207, 208, 209, 210, 25, 73, 24, 49, 59, 101, 123, 129, 134, 154, 160, 220, 221, 260]
    for id in &supported { assert(syscall(&mut c, id)) }
    assert(!syscall(&mut c, 9999))
}
