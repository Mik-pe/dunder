import ..frontend.frontend_types as ft

pub const ARG_GPR: i32 = 0
pub const ARG_FP: i32 = 1
pub const ARG_STACK_SCALAR: i32 = 2
pub const ARG_AGG_GPR: i32 = 3
pub const ARG_AGG_HFA: i32 = 4
pub const ARG_AGG_INDIRECT_GPR: i32 = 5
pub const ARG_AGG_INDIRECT_STACK: i32 = 6
pub const ARG_AGG_STACK: i32 = 7

pub const RET_VOID: i32 = 0
pub const RET_GPR: i32 = 1
pub const RET_FP: i32 = 2
pub const RET_AGG_GPR: i32 = 3
pub const RET_AGG_HFA: i32 = 4
pub const RET_INDIRECT: i32 = 5

pub struct ArgPlan {
    kind: i32,
    reg0: i32,
    reg_count: i32,
    hfa_shape: i32,
    stack_off: i32,
    slot_width: i32,
    total_size: i32,
}

pub struct RetPlan {
    kind: i32,
    hfa_shape: i32,
    total_size: i32,
}

pub struct Plan {
    ret: RetPlan,
    args: []ArgPlan,
    gp_used: i32,
    fp_used: i32,
    outgoing: i32,
}

fn align_up(value: i32, alignment: i32) -> i32 {
    if alignment <= 1 { return value }
    (value + alignment - 1) / alignment * alignment
}

fn is_float_scalar(ty: i32) -> bool {
    ty == 6 || ty == 7
}

pub fn plan_return(reg: &ft.TypeRegistry, ret_ty: i32) -> RetPlan {
    if ret_ty == 0 {
        return RetPlan { kind: RET_VOID, hfa_shape: 0, total_size: 0 }
    }
    if !ft.is_c_record(&reg, ret_ty) {
        w := ft.foreign_width(ret_ty)
        if is_float_scalar(ret_ty) {
            return RetPlan { kind: RET_FP, hfa_shape: 0, total_size: w }
        }
        return RetPlan { kind: RET_GPR, hfa_shape: 0, total_size: w }
    }
    shape := ft.hfa(&reg, ret_ty, 0)
    size := ft.c_size(&reg, ret_ty)
    if shape != 0 {
        return RetPlan { kind: RET_AGG_HFA, hfa_shape: shape, total_size: size }
    }
    if size <= 16 {
        return RetPlan { kind: RET_AGG_GPR, hfa_shape: 0, total_size: size }
    }
    RetPlan { kind: RET_INDIRECT, hfa_shape: 0, total_size: size }
}

pub fn plan_call(reg: &ft.TypeRegistry, darwin: bool, variadic_fixed: i32, param_types: &[]i32, ret_ty: i32) -> Plan {
    ret := plan_return(&reg, ret_ty)
    mut gp := 0
    mut fp := 0
    mut outgoing := 0
    mut args: []ArgPlan = []
    args.reserve(param_types.len)
    for i in 0..param_types.len {
        ty := param_types[i]
        is_variadic := variadic_fixed >= 0 && i >= variadic_fixed
        if darwin && is_variadic {
            w := ft.foreign_width(ty)
            outgoing = align_up(outgoing, 8)
            args.push(ArgPlan { kind: ARG_STACK_SCALAR, reg0: 0, reg_count: 0, hfa_shape: 0, stack_off: outgoing, slot_width: 8, total_size: w })
            outgoing += 8
            continue
        }
        if !ft.is_c_record(&reg, ty) {
            w := ft.foreign_width(ty)
            if is_float_scalar(ty) {
                if fp < 8 {
                    args.push(ArgPlan { kind: ARG_FP, reg0: fp, reg_count: 1, hfa_shape: 0, stack_off: 0, slot_width: w, total_size: w })
                    fp += 1
                } else {
                    slot_align := if darwin { w } else { 8 }
                    slot_w := if darwin { w } else { 8 }
                    outgoing = align_up(outgoing, slot_align)
                    args.push(ArgPlan { kind: ARG_STACK_SCALAR, reg0: 0, reg_count: 0, hfa_shape: 0, stack_off: outgoing, slot_width: slot_w, total_size: w })
                    outgoing += slot_w
                }
            } else {
                if gp < 8 {
                    args.push(ArgPlan { kind: ARG_GPR, reg0: gp, reg_count: 1, hfa_shape: 0, stack_off: 0, slot_width: w, total_size: w })
                    gp += 1
                } else {
                    slot_align := if darwin { w } else { 8 }
                    slot_w := if darwin { w } else { 8 }
                    outgoing = align_up(outgoing, slot_align)
                    args.push(ArgPlan { kind: ARG_STACK_SCALAR, reg0: 0, reg_count: 0, hfa_shape: 0, stack_off: outgoing, slot_width: slot_w, total_size: w })
                    outgoing += slot_w
                }
            }
            continue
        }
        shape := ft.hfa(&reg, ty, 0)
        size := ft.c_size(&reg, ty)
        align := ft.c_align(&reg, ty)
        if shape != 0 {
            need := if shape < 0 { -shape } else { shape }
            if fp + need <= 8 {
                args.push(ArgPlan { kind: ARG_AGG_HFA, reg0: fp, reg_count: need, hfa_shape: shape, stack_off: 0, slot_width: size, total_size: size })
                fp += need
            } else {
                fp = 8
                slot_align := if darwin { align } else if align > 8 { align } else { 8 }
                stride := if darwin { size } else { align_up(size, 8) }
                outgoing = align_up(outgoing, slot_align)
                args.push(ArgPlan { kind: ARG_AGG_STACK, reg0: 0, reg_count: 0, hfa_shape: shape, stack_off: outgoing, slot_width: stride, total_size: size })
                outgoing += stride
            }
        } else if size <= 16 {
            mut regs := (size + 7) / 8
            if regs < 1 { regs = 1 }
            if gp + regs <= 8 {
                args.push(ArgPlan { kind: ARG_AGG_GPR, reg0: gp, reg_count: regs, hfa_shape: 0, stack_off: 0, slot_width: size, total_size: size })
                gp = gp + regs
            } else {
                gp = 8
                slot_align := if align > 8 { align } else { 8 }
                stride := align_up(size, 8)
                outgoing = align_up(outgoing, slot_align)
                args.push(ArgPlan { kind: ARG_AGG_STACK, reg0: 0, reg_count: 0, hfa_shape: 0, stack_off: outgoing, slot_width: stride, total_size: size })
                outgoing += stride
            }
        } else {
            if gp < 8 {
                args.push(ArgPlan { kind: ARG_AGG_INDIRECT_GPR, reg0: gp, reg_count: 1, hfa_shape: 0, stack_off: 0, slot_width: 8, total_size: size })
                gp += 1
            } else {
                outgoing = align_up(outgoing, 8)
                args.push(ArgPlan { kind: ARG_AGG_INDIRECT_STACK, reg0: 0, reg_count: 0, hfa_shape: 0, stack_off: outgoing, slot_width: 8, total_size: size })
                outgoing += 8
            }
        }
    }
    outgoing = align_up(outgoing, 16)
    Plan { ret: ret, args: args, gp_used: gp, fp_used: fp, outgoing: outgoing }
}

fn test_registry() -> ft.TypeRegistry {
    mut reg := ft.new_registry()
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr", "range", "str", "i16"] {
        _ := ft.add_type(&mut reg, name, 0, 0)
    }
    reg
}

fn add_c_struct(reg: &mut ft.TypeRegistry, name: string, fields: &[]i32) -> i32 {
    ty := ft.add_type(&mut reg, name, 2, 0)
    reg.c_record[ty] = true
    reg.declared.type_starts[ty] = reg.field_types.len
    reg.declared.type_counts[ty] = fields.len
    for i in 0..fields.len {
        reg.field_names.push(f"f{i}")
        reg.field_types.push(fields[i])
        reg.field_values.push(0)
        reg.payload_starts.push(reg.payload_types.len)
        reg.payload_counts.push(0)
    }
    ft.c_layout(&mut reg, 0, ty)
    assert(reg.error == "")
    ty
}

@test fn darwin_packs_spilled_hfa_and_scalars_while_aligning_non_hfa_composites() {
    mut reg := test_registry()
    s3 := add_c_struct(&mut reg, "S3", &[8, 8, 8])
    s12 := add_c_struct(&mut reg, "S12", &[10, 10, 10])
    range16 := add_c_struct(&mut reg, "Range16", &[11, 11])
    triple := add_c_struct(&mut reg, "Triple", &[6, 6, 6])

    // Matches clang arm64-macos: non-HFA <=16B composites use 8B-aligned/8B-rounded slots, scalars pack tightly
    darwin_plan := plan_call(&reg, true, -1, &[11, 11, 11, 11, 11, 11, 11, range16, s3, 8, s12], 11)
    assert(darwin_plan.args[7].kind == ARG_AGG_STACK && darwin_plan.args[7].stack_off == 0)
    assert(darwin_plan.args[8].kind == ARG_AGG_STACK && darwin_plan.args[8].stack_off == 16 && darwin_plan.args[8].slot_width == 8)
    assert(darwin_plan.args[9].kind == ARG_STACK_SCALAR && darwin_plan.args[9].stack_off == 24 && darwin_plan.args[9].slot_width == 1)
    assert(darwin_plan.args[10].kind == ARG_AGG_STACK && darwin_plan.args[10].stack_off == 32 && darwin_plan.args[10].slot_width == 16)
    assert(darwin_plan.outgoing == 48)

    // Matches clang arm64-macos: spilled HFA Triple (3xf32) packs at 4B align / 12B stride
    darwin_hfa := plan_call(&reg, true, -1, &[7, 7, 7, 7, 7, 7, 7, triple, triple, 6], 6)
    assert(darwin_hfa.args[7].kind == ARG_AGG_STACK && darwin_hfa.args[7].stack_off == 0 && darwin_hfa.args[7].slot_width == 12)
    assert(darwin_hfa.args[8].kind == ARG_AGG_STACK && darwin_hfa.args[8].stack_off == 12 && darwin_hfa.args[8].slot_width == 12)
    assert(darwin_hfa.args[9].kind == ARG_STACK_SCALAR && darwin_hfa.args[9].stack_off == 24 && darwin_hfa.args[9].slot_width == 4)
    assert(darwin_hfa.outgoing == 32)

    // Linux AAPCS64 uses 8B-aligned, 8B-rounded slots for both HFA and scalars
    linux_hfa := plan_call(&reg, false, -1, &[7, 7, 7, 7, 7, 7, 7, triple, triple, 6], 6)
    assert(linux_hfa.args[7].kind == ARG_AGG_STACK && linux_hfa.args[7].stack_off == 0 && linux_hfa.args[7].slot_width == 16)
    assert(linux_hfa.args[8].kind == ARG_AGG_STACK && linux_hfa.args[8].stack_off == 16 && linux_hfa.args[8].slot_width == 16)
    assert(linux_hfa.args[9].kind == ARG_STACK_SCALAR && linux_hfa.args[9].stack_off == 32 && linux_hfa.args[9].slot_width == 8)
    assert(linux_hfa.outgoing == 48)
}

@test fn aapcs64_classifies_hfa_and_large_indirect_returns() {
    mut reg := test_registry()
    clear_color := add_c_struct(&mut reg, "ClearColor", &[7, 7, 7, 7])
    region := add_c_struct(&mut reg, "Region", &[11, 11, 11, 11, 11, 11])
    p := plan_call(&reg, true, -1, &[clear_color, region], region)
    assert(p.ret.kind == RET_INDIRECT && p.ret.total_size == 48)
    assert(p.args[0].kind == ARG_AGG_HFA && p.args[0].reg0 == 0 && p.args[0].hfa_shape == -4)
    assert(p.args[1].kind == ARG_AGG_INDIRECT_GPR && p.args[1].reg0 == 0 && p.args[1].total_size == 48)
}
