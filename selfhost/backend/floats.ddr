// Selfhosted ARM64 expression values carry raw IEEE bits in x0 (left operand x1).
import arm64 as arm
import ..frontend.unsigned
import float_operation as operation
import ..opt.scalar_rules as rules
pub fn has(ty: i32) -> bool { ty == 6 || ty == 7 }
fn width(ty: i32) -> i64 { if ty == 7 { 4194304 } else { 0 } }
fn into_fp(code: &mut arm.Code, ty: i32, reg: i32) {
    mut opcode: i64 = 505872384
    if ty == 7 { opcode = 2657550336 }
    arm.emit(&mut code, opcode + i64(reg) * 33)
}
fn from_fp(code: &mut arm.Code, ty: i32) {
    if ty == 6 { arm.emit(&mut code, 505806848) } else { arm.emit(&mut code, 2657484800) }
}
fn produce(code: &mut arm.Code, op: i32, ty: i32, offset: i32) -> i32 {
    if code.mir_capture { code.words.push(operation.cell(op, ty, offset)) }
    else if !code.checking { lower(&mut code, op, ty) }
    operation.result(op, ty)
}

pub fn binary(code: &mut arm.Code, op: string, ty: i32, offset: i32) -> i32 {
    produce(&mut code, rules.opcode(op), ty, offset)
}
pub fn method(code: &mut arm.Code, ty: i32, name: string, offset: i32) -> i32 {
    op := operation.method(name)
    if op == 0 { return -1 }
    produce(&mut code, op, ty, offset)
}

// Lower verified floating-point operations to target instructions.
pub fn lower(code: &mut arm.Code, op: i32, ty: i32) {
    if op >= 32 { lower_cast(&mut code, op, ty); return }
    if op == 12 {
        if ty == 6 { arm.emit(&mut code, 2470476800) }
        return
    }
    if op == 13 {
        mut shift := 31; if ty == 7 { shift = 63 }
        arm.emit(&mut code, 3544251392 + i64(shift) * 65536); return
    }
    into_fp(&mut code, ty, 0)
    if op < 12 {
        into_fp(&mut code, ty, 1)
        mut opcode: i64 = 0
        if op == 1 { opcode = 505423872 }
        else if op == 2 { opcode = 505427968 }
        else if op == 3 { opcode = 505415680 }
        else if op == 4 { opcode = 505419776 }
        if opcode != 0 {
            arm.emit(&mut code, opcode + width(ty) + 32); from_fp(&mut code, ty); return
        }
        mut cond := 0
        if op == 7 { cond = 1 } else if op == 8 { cond = 4 }
        else if op == 9 { cond = 9 } else if op == 10 { cond = 12 } else if op == 11 { cond = 10 }
        arm.emit(&mut code, 505421856 + width(ty))
        arm.emit(&mut code, 2594113504 + i64(cond.bit_xor(1)) * 4096)
        return
    }
    if op <= 21 {
        mut opcode: i64 = 505462784
        if op == 15 { opcode = 505528320 }
        else if op == 16 { opcode = 505757696 } else if op == 17 { opcode = 505724928 }
        else if op == 18 { opcode = 505823232 } else if op == 19 { opcode = 505692160 }
        else if op == 20 { opcode = 505790464 } else if op == 21 { opcode = 505495552 }
        arm.emit(&mut code, opcode + width(ty)); from_fp(&mut code, ty); return
    }
    if op == 22 {
        arm.emit(&mut code, 505421824 + width(ty)); arm.emit(&mut code, 2594142176); return
    }
    mut infinity: i64 = 2139095040; if ty == 7 { infinity = 9218868437227405312 }
    arm.imm(&mut code, 1, infinity); into_fp(&mut code, ty, 1)
    arm.emit(&mut code, 505462784 + width(ty)); arm.emit(&mut code, 505487360 + width(ty))
    mut cond := 0; if op == 23 { cond = 4 }
    arm.emit(&mut code, 2594113504 + i64(cond.bit_xor(1)) * 4096)
}
pub fn cast(code: &mut arm.Code, from: i32, to: i32, trap: i32, offset: i32) {
    if from == to { return }
    if has(from) && !has(to) {
        low_check := produce(&mut code, operation.cast(.CheckLower, to), from, offset)
        arm.branch(&mut code, trap, 8); arm.branch(&mut code, trap, 6)
        high_check := produce(&mut code, operation.cast(.CheckUpper, to), from, offset)
        arm.branch(&mut code, trap, 12)
    }
    result := produce(&mut code, operation.cast(.Convert, to), from, offset)
}
fn lower_cast(code: &mut arm.Code, op: i32, from: i32) {
    to := operation.destination(op)
    if op < 48 {
        if !has(from) {
            mut opcode: i64 = 2653028352
            if unsigned.has(from) { opcode = 2653093888 }
            arm.emit(&mut code, opcode + width(to)); from_fp(&mut code, to)
        } else if has(to) {
            into_fp(&mut code, from, 0)
            if to == 6 { arm.emit(&mut code, 509755392) } else { arm.emit(&mut code, 505593856) }
            from_fp(&mut code, to)
        } else {
            mut opcode: i64 = 2654470144; if unsigned.has(to) { opcode = 2654535680 }
            arm.emit(&mut code, opcode + width(from))
        }
        return
    }
    mut bits := 64
    if to == 1 { bits = 32 }; if unsigned.has(to) { bits = unsigned.width_for(to, code.platform) }
    mut power := bits; if !unsigned.has(to) { power = power - 1 }
    mut limit := i64(127 + power).shl(23); mut sign: i64 = 2147483648
    if from == 7 { limit = i64(1023 + power).shl(52); sign = -9223372036854775808 }
    if op < 64 {
        into_fp(&mut code, from, 0); arm.emit(&mut code, 505790464 + width(from))
        limit = limit.bit_or(sign); if unsigned.has(to) { limit = 0 }
    }
    arm.imm(&mut code, 1, limit); into_fp(&mut code, from, 1); arm.emit(&mut code, 505487360 + width(from))
}
