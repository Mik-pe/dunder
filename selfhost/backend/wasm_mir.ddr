import arm64 as arm
import floats
import foreign_operation as foreign_abi
import place_lower
import wasm_bytes as b
import wasm_flow as flow
import wasm_native
import ..frontend.iteration
import ..frontend.place_operation as place_op
import ..frontend.region_operation as region
import ..mir.mir
import ..mir.mir_liveness as live
import ..mir.mir_place

pub struct Object {
    ready: bool,
    structured: bool,
    local_i64_count: i32,
    needs_pc_local: bool,
    entry_label: i32,
    prints_mask: i32,
    body: []u8,
    patch_at: []i32,
    patch_kind: []i32,
    patch_target: []i32,
}

pub fn empty() -> Object {
    Object {
        ready: false,
        structured: false,
        local_i64_count: 8,
        needs_pc_local: false,
        entry_label: -1,
        prints_mask: 0,
        body: [],
        patch_at: [],
        patch_kind: [],
        patch_target: [],
    }
}

pub fn reset(out: &mut Object) {
    out.ready = false
    out.structured = false
    out.local_i64_count = 8
    out.needs_pc_local = false
    out.entry_label = -1
    out.prints_mask = 0
    out.body.clear()
    out.patch_at.clear()
    out.patch_kind.clear()
    out.patch_target.clear()
}

pub fn clone_into(dst: &mut Object, src: &Object) {
    reset(&mut dst)
    dst.ready = src.ready
    dst.structured = src.structured
    dst.local_i64_count = src.local_i64_count
    dst.needs_pc_local = src.needs_pc_local
    dst.entry_label = src.entry_label
    dst.prints_mask = src.prints_mask
    dst.body.reserve(src.body.len)
    for i in 0..src.body.len { dst.body.push(src.body[i]) }
    for i in 0..src.patch_at.len {
        dst.patch_at.push(src.patch_at[i])
        dst.patch_kind.push(src.patch_kind[i])
        dst.patch_target.push(src.patch_target[i])
    }
}

struct State {
    reg_to_local: []i32,
    allocated_regs: []i32,
    allocated_locals: []i32,
}

fn new_state() -> State {
    mut reg_to_local: []i32 = []
    for _ in 0..29 { reg_to_local.push(-1) }
    State {
        reg_to_local: reg_to_local,
        allocated_regs: [],
        allocated_locals: [],
    }
}

fn add_patch(obj: &mut Object, kind: i32, target: i32) {
    obj.patch_at.push(obj.body.len)
    obj.patch_kind.push(kind)
    obj.patch_target.push(target)
}

fn narrow(out: &mut []u8, wide: bool) {
    if !wide { b.op(&mut out, 167); b.op(&mut out, 173) }
}

fn sign_bit(out: &mut []u8, wide: bool) {
    sign: i64 = if wide { 63 } else { 31 }
    b.constant(&mut out, sign); b.op(&mut out, 136)
}

fn read_vreg(st: &State, out: &mut []u8, v: i32) {
    if v < 0 { b.constant(&mut out, 0); return }
    if v < 29 {
        loc := st.reg_to_local[v]
        if loc >= 0 { b.indexed(&mut out, 32, loc); return }
    }
    b.read(&mut out, v)
}

fn write_vreg(st: &State, out: &mut []u8, v: i32) {
    if v < 0 { b.op(&mut out, 26); return }
    if v < 29 {
        loc := st.reg_to_local[v]
        if loc >= 0 { b.indexed(&mut out, 33, loc); return }
    }
    b.write(&mut out, v)
}

fn read_base(st: &State, out: &mut []u8, v: i32) {
    if v < 0 { b.constant(&mut out, 0); return }
    if v < 29 {
        loc := st.reg_to_local[v]
        if loc >= 0 { b.indexed(&mut out, 32, loc); return }
    }
    b.base(&mut out, v)
}

fn set_sp_checked(out: &mut []u8) {
    b.set_base(&mut out, 31)
}

fn flush_all_regs(st: &State, out: &mut []u8) {
    for i in 0..st.allocated_regs.len {
        b.indexed(&mut out, 32, st.allocated_locals[i])
        b.write(&mut out, st.allocated_regs[i])
    }
}

fn reload_all_regs(st: &State, out: &mut []u8) {
    for i in 0..st.allocated_regs.len {
        b.read(&mut out, st.allocated_regs[i])
        b.indexed(&mut out, 33, st.allocated_locals[i])
    }
}

fn emit_shift(out: &mut []u8, wide: bool, kind: i32, amount: i32) {
    if amount == 0 { narrow(&mut out, wide); return }
    mut opcode := 134
    if kind == 1 { opcode = 136 } else if kind == 2 { opcode = 135 } else if kind == 3 { opcode = 138 }
    if wide {
        b.constant(&mut out, i64(amount)); b.op(&mut out, opcode)
    } else {
        b.op(&mut out, 167); b.i32_const(&mut out, amount)
        b.op(&mut out, opcode - 18); b.op(&mut out, 173)
    }
}

fn emit_flags(out: &mut []u8, wide: bool, subtract: bool, logical: bool) {
    b.indexed(&mut out, 32, 2); sign_bit(&mut out, wide); b.indexed(&mut out, 36, 32)
    b.indexed(&mut out, 32, 2); b.op(&mut out, 80); b.op(&mut out, 173); b.indexed(&mut out, 36, 33)
    if logical {
        b.constant(&mut out, 0); b.indexed(&mut out, 36, 34)
        b.constant(&mut out, 0); b.indexed(&mut out, 36, 35)
        return
    }
    if subtract { b.indexed(&mut out, 32, 0); b.indexed(&mut out, 32, 1); b.op(&mut out, 90) }
    else { b.indexed(&mut out, 32, 2); b.indexed(&mut out, 32, 0); b.op(&mut out, 84) }
    b.op(&mut out, 173); b.indexed(&mut out, 36, 34)
    b.indexed(&mut out, 32, 0)
    if subtract { b.indexed(&mut out, 32, 1) } else { b.indexed(&mut out, 32, 2) }
    b.op(&mut out, 133)
    if subtract { b.indexed(&mut out, 32, 0) } else { b.indexed(&mut out, 32, 1) }
    b.indexed(&mut out, 32, 2); b.op(&mut out, 133)
    b.op(&mut out, 131); sign_bit(&mut out, wide); b.indexed(&mut out, 36, 35)
}

fn cond_from_globals(out: &mut []u8, cond: i32) {
    class := cond / 2
    if class == 0 { b.indexed(&mut out, 35, 33) }
    else if class == 1 { b.indexed(&mut out, 35, 34) }
    else if class == 2 { b.indexed(&mut out, 35, 32) }
    else if class == 3 { b.indexed(&mut out, 35, 35) }
    else if class == 4 {
        b.indexed(&mut out, 35, 33); b.constant(&mut out, 1); b.op(&mut out, 133)
        b.indexed(&mut out, 35, 34); b.op(&mut out, 131)
    } else if class == 5 || class == 6 {
        b.indexed(&mut out, 35, 32); b.indexed(&mut out, 35, 35); b.op(&mut out, 133)
        if class == 6 { b.indexed(&mut out, 35, 33); b.op(&mut out, 132) }
        b.constant(&mut out, 1); b.op(&mut out, 133)
    } else {
        b.i32_const(&mut out, 1); return
    }
    if cond % 2 == 1 { b.constant(&mut out, 1); b.op(&mut out, 133) }
    b.op(&mut out, 167)
}

fn cond_wasm_cmp(cond: i32, wide: bool) -> i32 {
    if wide {
        if cond == 0 { return 81 }
        if cond == 1 { return 82 }
        if cond == 2 { return 90 }
        if cond == 3 { return 84 }
        if cond == 8 { return 86 }
        if cond == 9 { return 88 }
        if cond == 10 { return 89 }
        if cond == 11 { return 83 }
        if cond == 12 { return 85 }
        if cond == 13 { return 87 }
        return -1
    }
    if cond == 0 { return 70 }
    if cond == 1 { return 71 }
    if cond == 2 { return 79 }
    if cond == 3 { return 73 }
    if cond == 8 { return 75 }
    if cond == 9 { return 77 }
    if cond == 10 { return 78 }
    if cond == 11 { return 72 }
    if cond == 12 { return 74 }
    if cond == 13 { return 76 }
    -1
}

fn lower_unary(st: &State, out: &mut []u8, f: &mir.Function, op: i32) {
    dst := f.dst[op]
    opcode := f.opcodes[op]; a := f.a[op]; wide := f.types[op] != 1; aux := f.aux[op]
    if opcode == 3 {
        clear_mask := i64(65535).shl(aux).bit_not()
        read_vreg(&st, &mut out, a)
        b.constant(&mut out, clear_mask); b.op(&mut out, 131)
        b.constant(&mut out, f.imm[op].bit_and(i64(65535).shl(aux))); b.op(&mut out, 132)
        narrow(&mut out, wide)
        write_vreg(&st, &mut out, dst)
        return
    }
    signed := opcode == 1
    r := aux.bit_and(63); s := aux / 64
    width := if wide { 64 } else { 32 }
    if signed && wide && r == 0 && s == 31 {
        read_vreg(&st, &mut out, a); b.op(&mut out, 167); b.op(&mut out, 172); write_vreg(&st, &mut out, dst); return
    }
    if !signed && r == 0 && s == 7 {
        read_vreg(&st, &mut out, a); b.constant(&mut out, 255); b.op(&mut out, 131); write_vreg(&st, &mut out, dst); return
    }
    if !signed && r == 0 && s == 15 {
        read_vreg(&st, &mut out, a); b.constant(&mut out, 65535); b.op(&mut out, 131); write_vreg(&st, &mut out, dst); return
    }
    if !signed && r == 0 && s == 31 {
        read_vreg(&st, &mut out, a); narrow(&mut out, false); write_vreg(&st, &mut out, dst); return
    }
    read_vreg(&st, &mut out, a)
    if s >= r {
        emit_shift(&mut out, wide, 0, width - 1 - s)
        kind := if signed { 2 } else { 1 }
        emit_shift(&mut out, wide, kind, width - 1 - s + r)
    } else {
        b.constant(&mut out, i64(1).shl(s + 1).wrapping_sub(1)); b.op(&mut out, 131)
        emit_shift(&mut out, wide, 0, width - r)
    }
    write_vreg(&st, &mut out, dst)
}

fn lower_div(st: &State, out: &mut []u8, wide: bool, signed: bool, a: i32, b_reg: i32, dst: i32) {
    read_vreg(&st, &mut out, b_reg); narrow(&mut out, wide); b.op(&mut out, 80)
    b.op(&mut out, 4); b.op(&mut out, 126); b.constant(&mut out, 0); b.op(&mut out, 5)
    if signed {
        min_v: i64 = if wide { -9223372036854775808 } else { 2147483648 }
        neg_one := if wide { i64(-1) } else { 4294967295 }
        read_vreg(&st, &mut out, a); narrow(&mut out, wide); b.constant(&mut out, min_v); b.op(&mut out, 81)
        read_vreg(&st, &mut out, b_reg); narrow(&mut out, wide); b.constant(&mut out, neg_one); b.op(&mut out, 81)
        b.op(&mut out, 113); b.op(&mut out, 4); b.op(&mut out, 126)
        b.constant(&mut out, min_v); b.op(&mut out, 5)
    }
    read_vreg(&st, &mut out, a); if !wide { b.op(&mut out, 167) }
    read_vreg(&st, &mut out, b_reg); if !wide { b.op(&mut out, 167) }
    mut ins := if signed { 127 } else { 128 }
    if !wide { ins = ins - 18 }
    b.op(&mut out, ins); if !wide { b.op(&mut out, 173) }
    if signed { b.op(&mut out, 11) }
    b.op(&mut out, 11)
    write_vreg(&st, &mut out, dst)
}

fn half_from(st: &State, out: &mut []u8, reg: i32, high: bool) {
    read_vreg(&st, &mut out, reg)
    if high { b.constant(&mut out, 32); b.op(&mut out, 136) }
    else { b.op(&mut out, 167); b.op(&mut out, 173) }
}

fn half_prod(st: &State, out: &mut []u8, a: i32, a_hi: bool, b_reg: i32, b_hi: bool) {
    half_from(&st, &mut out, a, a_hi); half_from(&st, &mut out, b_reg, b_hi); b.op(&mut out, 126)
}

fn lower_mulh(st: &State, out: &mut []u8, a: i32, b_reg: i32, dst: i32, signed: bool) {
    half_prod(&st, &mut out, a, false, b_reg, false)
    b.constant(&mut out, 32); b.op(&mut out, 136)
    half_prod(&st, &mut out, a, true, b_reg, false); b.op(&mut out, 124)
    b.indexed(&mut out, 33, 0)
    b.indexed(&mut out, 32, 0); b.op(&mut out, 167); b.op(&mut out, 173)
    half_prod(&st, &mut out, a, false, b_reg, true); b.op(&mut out, 124)
    b.constant(&mut out, 32); b.op(&mut out, 136)
    b.indexed(&mut out, 32, 0); b.constant(&mut out, 32); b.op(&mut out, 136); b.op(&mut out, 124)
    half_prod(&st, &mut out, a, true, b_reg, true); b.op(&mut out, 124)
    if signed {
        read_vreg(&st, &mut out, a); b.constant(&mut out, 63); b.op(&mut out, 135)
        read_vreg(&st, &mut out, b_reg); b.op(&mut out, 131); b.op(&mut out, 125)
        read_vreg(&st, &mut out, b_reg); b.constant(&mut out, 63); b.op(&mut out, 135)
        read_vreg(&st, &mut out, a); b.op(&mut out, 131); b.op(&mut out, 125)
    }
    write_vreg(&st, &mut out, dst)
}

fn lower_binary_or_compare(st: &State, out: &mut []u8, f: &mir.Function, op: i32, live_flags_after: bool) -> bool {
    kind := f.kinds[op]; opcode := f.opcodes[op]
    dst := f.dst[op]; a := f.a[op]; b_reg := f.b[op]; c := f.c[op]
    wide := f.types[op] != 1
    sets_flags := f.flags[op].bit_and(2) != 0
    need_flags := sets_flags && live_flags_after

    if opcode == 6 || opcode == 7 {
        lower_div(&st, &mut out, wide, opcode == 6, a, b_reg, dst)
        return true
    }
    if opcode == 4 || opcode == 5 {
        lower_mulh(&st, &mut out, a, b_reg, dst, opcode == 4)
        return true
    }
    if opcode == 17 || opcode == 18 {
        read_vreg(&st, &mut out, c)
        read_vreg(&st, &mut out, a)
        read_vreg(&st, &mut out, b_reg)
        b.op(&mut out, 126)
        b.op(&mut out, if opcode == 18 { 125 } else { 124 })
        narrow(&mut out, wide)
        write_vreg(&st, &mut out, dst)
        return true
    }
    if opcode == 14 || opcode == 15 || opcode == 16 {
        sub := if opcode == 14 { 134 } else if opcode == 15 { 136 } else { 135 }
        read_vreg(&st, &mut out, a); if !wide { b.op(&mut out, 167) }
        read_vreg(&st, &mut out, b_reg); if !wide { b.op(&mut out, 167) }
        b.op(&mut out, if wide { sub } else { sub - 18 })
        if !wide { b.op(&mut out, 173) }
        write_vreg(&st, &mut out, dst)
        return true
    }
    if opcode == 3 {
        read_vreg(&st, &mut out, a); read_vreg(&st, &mut out, b_reg); b.op(&mut out, 126)
        narrow(&mut out, wide); write_vreg(&st, &mut out, dst); return true
    }

    logical := opcode >= 8 && opcode <= 13
    mut w_op := 124
    if opcode == 2 { w_op = 125 }
    else if opcode == 8 || opcode == 11 { w_op = 131 }
    else if opcode == 9 || opcode == 12 { w_op = 132 }
    else if opcode == 10 || opcode == 13 { w_op = 133 }
    else if opcode != 1 { return false }

    if (opcode == 1 || opcode == 2) && b_reg < 0 && f.aux[op] == 0 {
        read_vreg(&st, &mut out, a); narrow(&mut out, wide)
        if need_flags { b.indexed(&mut out, 34, 0) }
        b.constant(&mut out, f.imm[op]); narrow(&mut out, wide)
        if need_flags { b.indexed(&mut out, 34, 1) }
        b.op(&mut out, w_op); narrow(&mut out, wide)
        if need_flags {
            b.indexed(&mut out, 33, 2)
            emit_flags(&mut out, wide, opcode == 2, false)
            if kind != i32(mir.Kind.Compare) { b.indexed(&mut out, 32, 2) }
        } else if kind == i32(mir.Kind.Compare) {
            b.op(&mut out, 26)
        }
        if kind != i32(mir.Kind.Compare) { write_vreg(&st, &mut out, dst) }
        return true
    }

    read_vreg(&st, &mut out, a); narrow(&mut out, wide)
    if need_flags { b.indexed(&mut out, 34, 0) }
    aux := f.aux[op]
    read_vreg(&st, &mut out, b_reg)
    if aux != 0 {
        sk := aux / 64; sa := aux.bit_and(63)
        if !logical && sk == 3 { return false }
        emit_shift(&mut out, wide, sk, sa)
    } else {
        narrow(&mut out, wide)
    }
    if opcode >= 11 {
        b.constant(&mut out, -1); b.op(&mut out, 133); narrow(&mut out, wide)
    }
    if need_flags { b.indexed(&mut out, 34, 1) }
    b.op(&mut out, w_op); narrow(&mut out, wide)
    if need_flags {
        b.indexed(&mut out, 33, 2)
        emit_flags(&mut out, wide, opcode == 2, logical)
        if kind != i32(mir.Kind.Compare) { b.indexed(&mut out, 32, 2) }
    } else if kind == i32(mir.Kind.Compare) {
        b.op(&mut out, 26)
    }
    if kind != i32(mir.Kind.Compare) { write_vreg(&st, &mut out, dst) }
    true
}

fn emit_mem_addr_disp(st: &State, out: &mut []u8, base_v: i32, disp: i32) -> i32 {
    read_base(&st, &mut out, base_v)
    mut u_disp := disp
    if disp < 0 { b.constant(&mut out, i64(disp)); b.op(&mut out, 124); u_disp = 0 }
    b.op(&mut out, 167)
    u_disp
}

fn emit_mem_addr_sib8(st: &State, out: &mut []u8, base_v: i32, idx_v: i32) {
    read_base(&st, &mut out, base_v)
    read_vreg(&st, &mut out, idx_v)
    b.constant(&mut out, 3); b.op(&mut out, 134)
    b.op(&mut out, 124)
    b.op(&mut out, 167)
}

fn lower_load(st: &State, out: &mut []u8, f: &mir.Function, op: i32) -> bool {
    dst := f.dst[op]; width := f.aux[op]; sign_ext := f.extensions[op] == 2
    base_v := f.a[op]; indexed := f.opcodes[op] == 1 && f.b[op] >= 0
    mut disp := 0
    if indexed { emit_mem_addr_sib8(&st, &mut out, base_v, f.b[op]) }
    else { disp = emit_mem_addr_disp(&st, &mut out, base_v, i32(f.imm[op])) }
    mut align := 0; mut opcode := 49
    if width == 8 { opcode = 41; align = 3 }
    else if width == 4 { opcode = if sign_ext { 52 } else { 53 }; align = 2 }
    else if width == 2 { opcode = if sign_ext { 50 } else { 51 }; align = 1 }
    else if width == 1 { opcode = if sign_ext { 48 } else { 49 }; align = 0 }
    else { return false }
    b.op(&mut out, opcode); b.uleb(&mut out, align); b.uleb(&mut out, disp)
    if width == 4 && sign_ext && f.types[op] == 1 { b.op(&mut out, 167); b.op(&mut out, 173) }
    write_vreg(&st, &mut out, dst)
    true
}

fn lower_store(st: &State, out: &mut []u8, f: &mir.Function, op: i32) -> bool {
    val_v := f.a[op]; base_v := f.b[op]; width := f.aux[op]
    indexed := f.opcodes[op] == 1 && f.c[op] >= 0
    mut disp := 0
    if indexed { emit_mem_addr_sib8(&st, &mut out, base_v, f.c[op]) }
    else { disp = emit_mem_addr_disp(&st, &mut out, base_v, i32(f.imm[op])) }
    read_vreg(&st, &mut out, val_v)
    mut align := 0; mut opcode := 60
    if width == 8 { opcode = 55; align = 3 }
    else if width == 4 { opcode = 62; align = 2 }
    else if width == 2 { opcode = 61; align = 1 }
    else if width != 1 { return false }
    b.op(&mut out, opcode); b.uleb(&mut out, align); b.uleb(&mut out, disp)
    true
}

fn lower_arm_fallback(st: &State, obj: &mut Object, f: &mir.Function, op: i32, scratch_arm: &mut arm.Code) -> bool {
    flush_all_regs(&st, &mut obj.body)
    scratch_arm.words.clear(); scratch_arm.at.clear(); scratch_arm.target.clear(); scratch_arm.kinds.clear()
    kind := f.kinds[op]
    if f.modes[op] == 0 {
        first := f.raw_starts[op]; size := f.widths[op]
        for k in 0..size { scratch_arm.words.push(f.raw[first + k]) }
    } else if kind == i32(mir.Kind.Float) {
        if foreign_abi.handles(f.opcodes[op]) { foreign_abi.lower(&mut scratch_arm, &f, op) }
        else { floats.lower(&mut scratch_arm, f.opcodes[op] - 32, f.aux[op]) }
    } else if kind == i32(mir.Kind.Region) {
        region.lower(&mut scratch_arm, f.opcodes[op], f.aux[op], f.imm[op])
    } else if kind == i32(mir.Kind.Iteration) {
        iteration.lower(&mut scratch_arm, f.opcodes[op])
    } else if kind == i32(mir.Kind.Foreign) {
        foreign_abi.lower(&mut scratch_arm, &f, op)
    } else if kind == i32(mir.Kind.Place) {
        place_lower.lower(&mut scratch_arm, mir_place.memory_tag(f.opcodes[op]), f.aux[op], i32(f.imm[op]))
    } else {
        return false
    }
    if scratch_arm.at.len != 0 { return false }
    mut tmp_body := replace(&mut obj.body, [])
    ok := wasm_native.emit_arm_words(&mut tmp_body, &scratch_arm.words)
    obj.body = move tmp_body
    if !ok { return false }
    reload_all_regs(&st, &mut obj.body)
    true
}

fn lower_hot_place(st: &State, obj: &mut Object, f: &mir.Function, op: i32, scratch_arm: &mut arm.Code) -> bool {
    tag := mir_place.memory_tag(f.opcodes[op])
    form := f.aux[op]; param := i32(f.imm[op])
    if tag == place_op.tag(.Field) {
        if param == 0 { return true }
        read_vreg(&st, &mut obj.body, 0)
        b.constant(&mut obj.body, i64(param)); b.op(&mut obj.body, 124)
        write_vreg(&st, &mut obj.body, 0)
        return true
    }
    if tag == place_op.tag(.CheckIndex) {
        disp := emit_mem_addr_disp(&st, &mut obj.body, 1, form * 8)
        b.op(&mut obj.body, 41); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, disp)
        b.indexed(&mut obj.body, 33, 1)
        read_vreg(&st, &mut obj.body, 0); b.indexed(&mut obj.body, 33, 0)
        b.indexed(&mut obj.body, 32, 1); write_vreg(&st, &mut obj.body, 2)
        b.indexed(&mut obj.body, 32, 0); b.indexed(&mut obj.body, 32, 1); b.op(&mut obj.body, 125)
        b.indexed(&mut obj.body, 33, 2)
        emit_flags(&mut obj.body, true, true, false)
        return true
    }
    if tag == place_op.tag(.Element) {
        if form == 0 {
            read_vreg(&st, &mut obj.body, 1); read_vreg(&st, &mut obj.body, 0); b.op(&mut obj.body, 124)
            b.constant(&mut obj.body, 8); b.op(&mut obj.body, 124); write_vreg(&st, &mut obj.body, 0); return true
        }
        read_vreg(&st, &mut obj.body, 1); b.op(&mut obj.body, 167)
        b.op(&mut obj.body, 41); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, 0)
        b.indexed(&mut obj.body, 34, 1); write_vreg(&st, &mut obj.body, 1)
        b.indexed(&mut obj.body, 32, 1)
        read_vreg(&st, &mut obj.body, 0)
        if form == 1 {
            if param != 0 { b.constant(&mut obj.body, i64(param)); b.op(&mut obj.body, 134) }
        } else {
            b.constant(&mut obj.body, i64(param)); b.indexed(&mut obj.body, 34, 2); write_vreg(&st, &mut obj.body, 2)
            b.indexed(&mut obj.body, 32, 2); b.op(&mut obj.body, 126)
        }
        b.op(&mut obj.body, 124); write_vreg(&st, &mut obj.body, 0)
        return true
    }
    if tag == place_op.tag(.Member) {
        disp := emit_mem_addr_disp(&st, &mut obj.body, 0, param * 8)
        if place_op.member_write(form) {
            read_vreg(&st, &mut obj.body, 1)
            b.op(&mut obj.body, 55); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, disp)
        } else {
            b.op(&mut obj.body, 41); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, disp)
            write_vreg(&st, &mut obj.body, 0)
        }
        return true
    }
    if tag == place_op.tag(.BorrowPayload) { return true }
    lower_arm_fallback(&st, &mut obj, &f, op, &mut scratch_arm)
}

fn next_live_op(f: &mir.Function, b_idx: i32, after_pos: i32) -> i32 {
    mut p := after_pos + 1
    limit := f.block_ends[b_idx]
    while p < limit {
        op := f.order[p]
        if f.modes[op] != 2 && f.kinds[op] != i32(mir.Kind.Nop) { return p }
        p = p + 1
    }
    -1
}

fn can_fuse_producer(f: &mir.Function, op: i32) -> bool {
    if f.modes[op] == 0 && f.reloc_kinds[op] < 0 { return false }
    kind := f.kinds[op]
    if kind == i32(mir.Kind.Compare) {
        return f.opcodes[op] == 2 && f.aux[op] == 0
    }
    if kind == i32(mir.Kind.Place) {
        return mir_place.memory_tag(f.opcodes[op]) == place_op.tag(.CheckIndex)
    }
    false
}

fn fused_cond_code(f: &mir.Function, consumer: i32) -> i32 {
    kind := f.kinds[consumer]
    if kind == i32(mir.Kind.CondJump) {
        reloc := f.reloc_kinds[consumer]
        if reloc >= 2 && reloc <= 15 { return reloc - 2 }
        return -1
    }
    if kind == i32(mir.Kind.Select) {
        c := i32(f.imm[consumer])
        if c >= 0 && c <= 13 { return c }
        return -1
    }
    -1
}

fn emit_fused_condition(st: &State, out: &mut []u8, f: &mir.Function, prod: i32, cond: i32) -> bool {
    if f.kinds[prod] == i32(mir.Kind.Compare) {
        wide := f.types[prod] != 1
        w_cmp := cond_wasm_cmp(cond, wide)
        if w_cmp < 0 { return false }
        read_vreg(&st, &mut out, f.a[prod])
        if !wide { b.op(&mut out, 167) }
        if f.b[prod] < 0 {
            b.constant(&mut out, f.imm[prod])
            if !wide { b.op(&mut out, 167) }
        } else {
            read_vreg(&st, &mut out, f.b[prod])
            if !wide { b.op(&mut out, 167) }
        }
        b.op(&mut out, w_cmp)
        return true
    }
    // Place(.CheckIndex): loads [x1 + form*8] -> x2, compares x0 vs x2 (64-bit)
    w_cmp := cond_wasm_cmp(cond, true)
    if w_cmp < 0 { return false }
    form := f.aux[prod]
    disp := emit_mem_addr_disp(&st, &mut out, 1, form * 8)
    b.op(&mut out, 41); b.uleb(&mut out, 3); b.uleb(&mut out, disp)
    b.indexed(&mut out, 34, 1); write_vreg(&st, &mut out, 2)
    read_vreg(&st, &mut out, 0)
    b.indexed(&mut out, 32, 1)
    b.op(&mut out, w_cmp)
    true
}

fn emit_cond_expr(st: &State, out: &mut []u8, f: &mir.Function, op: i32, invert: bool) {
    reloc := f.reloc_kinds[op]
    if reloc == 18 || reloc == 19 {
        reg_v := if f.a[op] >= 0 { f.a[op] } else { 0 }
        read_vreg(&st, &mut out, reg_v)
        b.op(&mut out, 80) // eqz
        // reloc 18 = cbz (branch if == 0 -> eqz == 1); reloc 19 = cbnz (eqz; i32.eqz)
        if (reloc == 19) != invert { b.op(&mut out, 69) }
        return
    }
    cond := reloc - 2
    if cond >= 14 { b.i32_const(&mut out, if invert { 0 } else { 1 }); return }
    final_cond := if invert { cond.bit_xor(1) } else { cond }
    cond_from_globals(&mut out, final_cond)
}

fn lower_op(st: &State, obj: &mut Object, f: &mir.Function, op: i32,
    live_flags_after: bool, scratch_arm: &mut arm.Code) -> bool {
    kind := f.kinds[op]
    if kind == i32(mir.Kind.Nop) { return true }
    if kind == i32(mir.Kind.ImportAddress) {
        b.op(&mut obj.body, 0)
        b.constant(&mut obj.body, 0)
        write_vreg(&st, &mut obj.body, f.dst[op])
        return true
    }
    if kind == i32(mir.Kind.Address) {
        if f.reloc_kinds[op] == 20 {
            add_patch(&mut obj, 1, f.targets[op])
            write_vreg(&st, &mut obj.body, f.dst[op])
            return true
        }
        read_base(&st, &mut obj.body, f.a[op])
        if f.imm[op] != 0 { b.constant(&mut obj.body, f.imm[op]); b.op(&mut obj.body, 124) }
        write_vreg(&st, &mut obj.body, f.dst[op])
        return true
    }
    if f.modes[op] == 0 && f.reloc_kinds[op] < 0 {
        if f.raw_starts[op] >= 0 && f.widths[op] == 1 && f.raw[f.raw_starts[op]] == 3556769793 {
            // Exit syscall preceded in MIR by x8 = 94 collapses to Wasm unreachable trap.
            prev_is_exit := op > 0 && ((f.kinds[op - 1] == i32(mir.Kind.Constant) && f.dst[op - 1] == 8 && f.imm[op - 1] == 94) ||
                (f.modes[op - 1] == 0 && f.widths[op - 1] == 1 && f.raw[f.raw_starts[op - 1]] == 3531606984))
            if prev_is_exit { b.op(&mut obj.body, 0); return true }
        }
        return lower_arm_fallback(&st, &mut obj, &f, op, &mut scratch_arm)
    }
    if kind == i32(mir.Kind.Constant) {
        mut val := f.imm[op]
        if f.types[op] == 1 { val = val.bit_and(4294967295) }
        b.constant(&mut obj.body, val)
        write_vreg(&st, &mut obj.body, f.dst[op])
        return true
    }
    if kind == i32(mir.Kind.Copy) {
        read_vreg(&st, &mut obj.body, f.a[op])
        narrow(&mut obj.body, f.types[op] != 1)
        write_vreg(&st, &mut obj.body, f.dst[op])
        return true
    }
    if kind == i32(mir.Kind.Unary) {
        lower_unary(&st, &mut obj.body, &f, op)
        return true
    }
    if kind == i32(mir.Kind.Binary) || kind == i32(mir.Kind.Compare) {
        return lower_binary_or_compare(&st, &mut obj.body, &f, op, live_flags_after)
    }
    if kind == i32(mir.Kind.Select) {
        cond := i32(f.imm[op])
        if cond >= 14 { b.constant(&mut obj.body, 1) }
        else { cond_from_globals(&mut obj.body, cond); b.op(&mut obj.body, 173) }
        write_vreg(&st, &mut obj.body, f.dst[op])
        return true
    }
    if kind == i32(mir.Kind.Load) { return lower_load(&st, &mut obj.body, &f, op) }
    if kind == i32(mir.Kind.Store) { return lower_store(&st, &mut obj.body, &f, op) }
    if kind == i32(mir.Kind.StackPush) {
        b.base(&mut obj.body, 31); b.constant(&mut obj.body, f.imm[op]); b.op(&mut obj.body, 124)
        set_sp_checked(&mut obj.body)
        b.base(&mut obj.body, 31); b.op(&mut obj.body, 167)
        read_vreg(&st, &mut obj.body, f.a[op])
        b.op(&mut obj.body, 55); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, 0)
        return true
    }
    if kind == i32(mir.Kind.StackPop) {
        if f.dst[op] >= 0 {
            b.base(&mut obj.body, 31); b.op(&mut obj.body, 167)
            b.op(&mut obj.body, 41); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, 0)
            write_vreg(&st, &mut obj.body, f.dst[op])
        }
        b.base(&mut obj.body, 31); b.constant(&mut obj.body, f.imm[op]); b.op(&mut obj.body, 124)
        set_sp_checked(&mut obj.body)
        return true
    }
    if kind == i32(mir.Kind.Frame) {
        delta := if f.opcodes[op] == 2 { -f.imm[op] } else { f.imm[op] }
        read_base(&st, &mut obj.body, f.a[op])
        if delta != 0 { b.constant(&mut obj.body, delta); b.op(&mut obj.body, 124) }
        if f.dst[op] == 31 { set_sp_checked(&mut obj.body) } else { write_vreg(&st, &mut obj.body, f.dst[op]) }
        return true
    }
    if kind == i32(mir.Kind.Abi) {
        if f.opcodes[op] == 1 {
            b.base(&mut obj.body, 31); b.constant(&mut obj.body, -16); b.op(&mut obj.body, 124)
            set_sp_checked(&mut obj.body)
            b.base(&mut obj.body, 31); b.op(&mut obj.body, 167); b.read(&mut obj.body, 29)
            b.op(&mut obj.body, 55); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, 0)
            b.base(&mut obj.body, 31); b.op(&mut obj.body, 167); b.read(&mut obj.body, 30)
            b.op(&mut obj.body, 55); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, 8)
        } else {
            b.base(&mut obj.body, 31); b.op(&mut obj.body, 167)
            b.op(&mut obj.body, 41); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, 0); b.write(&mut obj.body, 29)
            b.base(&mut obj.body, 31); b.op(&mut obj.body, 167)
            b.op(&mut obj.body, 41); b.uleb(&mut obj.body, 3); b.uleb(&mut obj.body, 8); b.write(&mut obj.body, 30)
            b.base(&mut obj.body, 31); b.constant(&mut obj.body, 16); b.op(&mut obj.body, 124)
            set_sp_checked(&mut obj.body)
        }
        return true
    }
    if kind == i32(mir.Kind.Call) {
        if f.reloc_kinds[op] == 1 {
            flush_all_regs(&st, &mut obj.body)
            add_patch(&mut obj, 0, f.targets[op])
            reload_all_regs(&st, &mut obj.body)
            return true
        }
        if f.reloc_kinds[op] < 0 && f.opcodes[op] == 96 {
            if f.variant[op] < 1 || f.variant[op] > 12 { return false }
            tag := flow.print_tag(i32(f.variant[op]))
            read_vreg(&st, &mut obj.body, 0)
            mut ty := 127
            if tag == 1 || tag == 8 { ty = 126 }
            else if tag == 5 { ty = 125 }
            else if tag == 6 { ty = 124 }
            if ty == 127 || ty == 125 { b.op(&mut obj.body, 167) }
            if ty == 125 { b.op(&mut obj.body, 190) }
            if ty == 124 { b.op(&mut obj.body, 191) }
            obj.prints_mask = obj.prints_mask.bit_or(i32(1).shl(tag))
            add_patch(&mut obj, 2, tag)
            return true
        }
        if f.reloc_kinds[op] < 0 && f.opcodes[op] == 62 {
            flush_all_regs(&st, &mut obj.body)
            dispatch := f.variant[op].bit_and(4294967295)
            if dispatch > 0 {
                add_patch(&mut obj, 4, i32(dispatch) - 1)
            } else {
                callee_reg := if f.a[op] >= 0 { f.a[op] } else { 16 }
                b.read(&mut obj.body, callee_reg); b.op(&mut obj.body, 167)
                b.indexed(&mut obj.body, 17, 0); b.op(&mut obj.body, 0)
            }
            reload_all_regs(&st, &mut obj.body)
            return true
        }
        return false
    }
    if kind == i32(mir.Kind.Return) {
        flush_all_regs(&st, &mut obj.body)
        b.op(&mut obj.body, 15)
        return true
    }
    if kind == i32(mir.Kind.Trap) {
        b.op(&mut obj.body, 0)
        return true
    }
    if kind == i32(mir.Kind.Foreign) {
        opcode := f.opcodes[op]
        if opcode == 118 || opcode == 119 {
            delta := if opcode == 118 { -f.imm[op] } else { f.imm[op] }
            b.base(&mut obj.body, 31)
            if delta != 0 { b.constant(&mut obj.body, delta); b.op(&mut obj.body, 124) }
            set_sp_checked(&mut obj.body)
            return true
        }
        if opcode == 120 {
            b.base(&mut obj.body, 31)
            if f.imm[op] != 0 { b.constant(&mut obj.body, f.imm[op]); b.op(&mut obj.body, 124) }
            write_vreg(&st, &mut obj.body, f.dst[op])
            return true
        }
        return lower_arm_fallback(&st, &mut obj, &f, op, &mut scratch_arm)
    }
    if kind == i32(mir.Kind.Place) {
        return lower_hot_place(&st, &mut obj, &f, op, &mut scratch_arm)
    }
    if kind == i32(mir.Kind.Float) || kind == i32(mir.Kind.Region) || kind == i32(mir.Kind.Iteration) {
        return lower_arm_fallback(&st, &mut obj, &f, op, &mut scratch_arm)
    }
    false
}

fn lower_block_body(st: &State, obj: &mut Object, f: &mir.Function, b_idx: i32,
    live_ws: &live.Workspace, live_ok: bool, skip_op: i32, scratch_arm: &mut arm.Code) -> bool {
    mut pos := f.block_starts[b_idx]; end := f.block_ends[b_idx]
    while pos < end {
        op := f.order[pos]
        if op == skip_op { break }
        if f.modes[op] == 2 || f.kinds[op] == i32(mir.Kind.Nop) { pos = pos + 1; continue }
        kind := f.kinds[op]
        if kind == i32(mir.Kind.Jump) || kind == i32(mir.Kind.CondJump) { break }

        next_pos := next_live_op(&f, b_idx, pos)
        if next_pos >= 0 {
            next_op := f.order[next_pos]
            if f.kinds[next_op] == i32(mir.Kind.Select) && next_op != skip_op && can_fuse_producer(&f, op) {
                cond := fused_cond_code(&f, next_op)
                next_flags_live := if live_ok { live.flags_after(&live_ws, next_op) } else { true }
                if cond >= 0 && !next_flags_live {
                    if emit_fused_condition(&st, &mut obj.body, &f, op, cond) {
                        b.op(&mut obj.body, 173)
                        write_vreg(&st, &mut obj.body, f.dst[next_op])
                        pos = next_pos + 1
                        continue
                    }
                }
            }
        }
        live_flags_after := if live_ok { live.flags_after(&live_ws, op) } else { true }
        if !lower_op(&st, &mut obj, &f, op, live_flags_after, &mut scratch_arm) { return false }
        if kind == i32(mir.Kind.Return) || kind == i32(mir.Kind.Trap) { break }
        pos = pos + 1
    }
    true
}

fn select_locals(st: &mut State, f: &mir.Function, live_ok: bool) {
    if !live_ok { return }
    mut used: []bool = []
    for _ in 0..29 { used.push(false) }
    for op in &f.order {
        if f.modes[op] == 2 { continue }
        kind := f.kinds[op]
        if f.dst[op] >= 0 && f.dst[op] < 29 { used[f.dst[op]] = true }
        if f.a[op] >= 0 && f.a[op] < 29 { used[f.a[op]] = true }
        if f.b[op] >= 0 && f.b[op] < 29 { used[f.b[op]] = true }
        if f.c[op] >= 0 && f.c[op] < 29 { used[f.c[op]] = true }
        if kind == i32(mir.Kind.Place) || kind == i32(mir.Kind.Region) || kind == i32(mir.Kind.Iteration) {
            r := f.reads[op]; w := f.writes[op]
            for v in 0..29 {
                bit := i64(1).shl(v)
                if r.bit_and(bit) != 0 || w.bit_and(bit) != 0 { used[v] = true }
            }
        }
    }
    mut next_local := 8
    for v in 0..29 {
        if v >= 18 && v <= 21 { continue }
        if used[v] {
            st.reg_to_local[v] = next_local
            st.allocated_regs.push(v)
            st.allocated_locals.push(next_local)
            next_local = next_local + 1
        }
    }
}

fn local_block_for_label(f: &mir.Function, label: i32) -> i32 {
    mut low := 0; mut high := f.label_ids.len
    while low < high {
        mid := low + (high - low) / 2
        if f.label_ids[mid] < label { low = mid + 1 } else { high = mid }
    }
    if low >= f.label_ids.len || f.label_ids[low] != label { return -1 }
    pos := f.label_ops[low]
    if pos < 0 { return -1 }
    if pos == f.order.len { return f.block_starts.len }
    f.op_blocks[f.order[pos]]
}

struct CfgInfo {
    ok_for_stackifier: bool,
    succ_fall: []i32,
    succ_taken: []i32,
    cond_op: []i32,
    ext_cond_op: []i32,
    ext_jump_op: []i32,
    fuse_cmp_op: []i32,
}

fn extract_cfg(f: &mir.Function, live_ws: &live.Workspace, live_ok: bool) -> CfgInfo {
    blocks := f.block_starts.len
    mut succ_fall: []i32 = []
    mut succ_taken: []i32 = []
    mut cond_op: []i32 = []
    mut ext_cond_op: []i32 = []
    mut ext_jump_op: []i32 = []
    mut fuse_cmp_op: []i32 = []
    mut ok_stack := blocks > 0

    for b_idx in 0..blocks {
        mut fall_blk := -1
        for e in f.edge_starts[b_idx]..f.edge_starts[b_idx + 1] {
            if f.edge_kinds[e] == 0 && b_idx + 1 < blocks { fall_blk = b_idx + 1; break }
        }
        mut c_op := -1; mut ec_op := -1; mut ej_op := -1
        mut sf := fall_blk; mut st_blk := -1
        mut prev_live_op := -1; mut tail_branch_op := -1
        mut has_term := false

        for pos in f.block_starts[b_idx]..f.block_ends[b_idx] {
            op := f.order[pos]
            if f.modes[op] == 2 || f.kinds[op] == i32(mir.Kind.Nop) { continue }
            kind := f.kinds[op]
            if kind == i32(mir.Kind.Return) || kind == i32(mir.Kind.Trap) {
                has_term = true; sf = -1; st_blk = -1; prev_live_op = -1; break
            }
            if kind == i32(mir.Kind.Jump) {
                tb := local_block_for_label(&f, f.targets[op])
                if tb == blocks { ok_stack = false }
                if tb >= 0 { sf = tb; st_blk = -1 } else { sf = -1; st_blk = -1; ej_op = op }
                tail_branch_op = op; break
            }
            if kind == i32(mir.Kind.CondJump) {
                reloc := f.reloc_kinds[op]; tb := local_block_for_label(&f, f.targets[op])
                if tb == blocks { ok_stack = false }
                always := reloc == 16 || reloc == 17
                if always {
                    if tb >= 0 { sf = tb; st_blk = -1 } else { sf = -1; st_blk = -1; ej_op = op }
                } else if tb >= 0 {
                    if tb == fall_blk { st_blk = -1 }
                    else { c_op = op; st_blk = tb }
                } else {
                    ec_op = op; st_blk = -1
                }
                tail_branch_op = op; break
            }
            prev_live_op = op
        }
        if has_term { sf = -1; st_blk = -1 }
        mut fused := -1
        branch_op := if c_op >= 0 { c_op } else { ec_op }
        if branch_op >= 0 && branch_op == tail_branch_op && prev_live_op >= 0 && can_fuse_producer(&f, prev_live_op) {
            if fused_cond_code(&f, branch_op) >= 0 {
                live_after_br := if live_ok { live.flags_after(&live_ws, branch_op) } else { true }
                if !live_after_br { fused = prev_live_op }
            }
        }
        succ_fall.push(sf); succ_taken.push(st_blk)
        cond_op.push(c_op); ext_cond_op.push(ec_op); ext_jump_op.push(ej_op)
        fuse_cmp_op.push(fused)
    }

    CfgInfo {
        ok_for_stackifier: ok_stack,
        succ_fall: succ_fall,
        succ_taken: succ_taken,
        cond_op: cond_op,
        ext_cond_op: ext_cond_op,
        ext_jump_op: ext_jump_op,
        fuse_cmp_op: fuse_cmp_op,
    }
}

fn dominates(idom: &[]i32, a: i32, b: i32) -> bool {
    mut x := b
    while x > a { x = idom[x] }
    x == a
}

struct Scope {
    start: i32,
    end: i32,
    is_loop: bool,
    target: i32,
}

fn scope_comes_before(a: &Scope, b: &Scope) -> bool {
    if a.start != b.start { return a.start < b.start }
    if a.end != b.end { return a.end > b.end }
    !a.is_loop && b.is_loop
}

fn emit_cond_branch_expr(st: &State, out: &mut []u8, f: &mir.Function, fused_op: i32, branch_op: i32, invert: bool) -> bool {
    if fused_op >= 0 {
        base_cond := fused_cond_code(&f, branch_op)
        final_cond := if invert { base_cond.bit_xor(1) } else { base_cond }
        return emit_fused_condition(&st, &mut out, &f, fused_op, final_cond)
    }
    emit_cond_expr(&st, &mut out, &f, branch_op, invert)
    true
}

fn lookup_branch_depth(active: &[]i32, scopes: &[]Scope, pos: i32, dest_rpo: i32) -> i32 {
    is_back := dest_rpo <= pos
    for d in 0..active.len {
        sc := &scopes[active[active.len - 1 - d]]
        if is_back && sc.is_loop && sc.target == dest_rpo { return d }
        if !is_back && !sc.is_loop && sc.target == dest_rpo { return d }
    }
    -1
}

fn try_lower_structured(st: &State, out: &mut Object, f: &mir.Function, cfg: &CfgInfo,
    live_ws: &live.Workspace, live_ok: bool, scratch_arm: &mut arm.Code) -> bool {
    if !cfg.ok_for_stackifier { return false }
    blocks := f.block_starts.len
    mut state := flow.filled(blocks, 0)
    mut stack: []i32 = [0]
    mut post: []i32 = []

    while stack.len > 0 {
        b_idx := stack[stack.len - 1]
        if state[b_idx] == 0 {
            state[b_idx] = 1
            sf := cfg.succ_fall[b_idx]; sk := cfg.succ_taken[b_idx]
            if sf >= 0 && state[sf] == 0 { stack.push(sf) }
            if sk >= 0 && state[sk] == 0 { stack.push(sk) }
        } else {
            _ := stack.pop()
            if state[b_idx] == 1 {
                state[b_idx] = 2
                post.push(b_idx)
            }
        }
    }

    n := post.len
    if n == 0 { return false }
    mut rpo: []i32 = []
    mut rpo_of := flow.filled(blocks, -1)
    for i in 0..n {
        blk := post[n - 1 - i]
        rpo.push(blk)
        rpo_of[blk] = i
    }

    mut r_fall := flow.filled(n, -1)
    mut r_taken := flow.filled(n, -1)
    mut pred_counts := flow.filled(n, 0)
    for u in 0..n {
        blk := rpo[u]
        if cfg.succ_fall[blk] >= 0 {
            v := rpo_of[cfg.succ_fall[blk]]; r_fall[u] = v; pred_counts[v] = pred_counts[v] + 1
        }
        if cfg.succ_taken[blk] >= 0 {
            v := rpo_of[cfg.succ_taken[blk]]; r_taken[u] = v; pred_counts[v] = pred_counts[v] + 1
        }
    }

    mut pred_starts := flow.filled(n + 1, 0)
    for v in 0..n { pred_starts[v + 1] = pred_starts[v] + pred_counts[v] }
    mut preds := flow.filled(pred_starts[n], 0)
    mut pred_cur := flow.filled(n, 0)
    for v in 0..n { pred_cur[v] = pred_starts[v] }
    for u in 0..n {
        if r_fall[u] >= 0 { v := r_fall[u]; preds[pred_cur[v]] = u; pred_cur[v] = pred_cur[v] + 1 }
        if r_taken[u] >= 0 { v := r_taken[u]; preds[pred_cur[v]] = u; pred_cur[v] = pred_cur[v] + 1 }
    }

    mut idom := flow.filled(n, -1)
    idom[0] = 0
    mut changed := true
    while changed {
        changed = false
        for i in 1..n {
            mut new_idom := -1
            for pi in pred_starts[i]..pred_starts[i + 1] {
                p := preds[pi]
                if idom[p] < 0 { continue }
                if new_idom < 0 { new_idom = p }
                else {
                    mut f1 := p; mut f2 := new_idom
                    while f1 != f2 {
                        while f1 > f2 { f1 = idom[f1] }
                        while f2 > f1 { f2 = idom[f2] }
                    }
                    new_idom = f1
                }
            }
            if new_idom >= 0 && idom[i] != new_idom { idom[i] = new_idom; changed = true }
        }
    }

    mut is_loop: []bool = []
    for _ in 0..n { is_loop.push(false) }
    mut loop_end := flow.filled(n, -1)
    mut seen_mark := flow.filled(n, -1)
    mut stamp := 0
    mut queue: []i32 = []

    for u in 0..n {
        for edge_idx in 0..2 {
            v := if edge_idx == 0 { r_fall[u] } else { r_taken[u] }
            if v < 0 || v > u { continue }
            if !dominates(&idom, v, u) { return false }
            is_loop[v] = true
            if u > loop_end[v] { loop_end[v] = u }
            stamp = stamp + 1
            seen_mark[v] = stamp
            queue.clear()
            if u != v {
                seen_mark[u] = stamp
                queue.push(u)
            }
            mut qpos := 0
            while qpos < queue.len {
                w := queue[qpos]; qpos = qpos + 1
                if w > loop_end[v] { loop_end[v] = w }
                for pi in pred_starts[w]..pred_starts[w + 1] {
                    p := preds[pi]
                    if seen_mark[p] != stamp { seen_mark[p] = stamp; queue.push(p) }
                }
            }
        }
    }

    mut loop_changed := true
    while loop_changed {
        loop_changed = false
        mut h := n - 1
        while h >= 0 {
            if is_loop[h] {
                mut k := h + 1
                while k <= loop_end[h] {
                    if is_loop[k] && loop_end[k] > loop_end[h] {
                        loop_end[h] = loop_end[k]; loop_changed = true
                    }
                    k = k + 1
                }
            }
            h = h - 1
        }
    }

    mut scopes: []Scope = []
    for h in 0..n {
        if is_loop[h] {
            scopes.push(Scope { start: h, end: loop_end[h] + 1, is_loop: true, target: h })
        }
    }

    for t in 2..n {
        mut first_src := -1
        for pi in pred_starts[t]..pred_starts[t + 1] {
            u := preds[pi]
            if u + 1 < t && (first_src < 0 || u < first_src) { first_src = u }
        }
        if first_src < 0 { continue }
        mut open_pos := first_src
        mut widen := true
        while widen {
            widen = false
            for s in 0..scopes.len {
                ss := scopes[s].start; se := scopes[s].end
                if ss < open_pos && open_pos < se && se < t {
                    open_pos = ss; widen = true
                }
            }
        }
        scopes.push(Scope { start: open_pos, end: t, is_loop: false, target: t })
    }

    for i in 0..scopes.len {
        for j in (i + 1)..scopes.len {
            a := &scopes[i]; bs := &scopes[j]
            if (a.start < bs.start && bs.start < a.end && a.end < bs.end) ||
               (bs.start < a.start && a.start < bs.end && bs.end < a.end) {
                return false
            }
            if a.start == bs.start && a.end == bs.end && a.is_loop == bs.is_loop { return false }
        }
    }

    // Sort scopes into outer-before-inner opening order for each start position.
    mut sorted_ids: []i32 = []
    for i in 0..scopes.len { sorted_ids.push(i) }
    for i in 1..sorted_ids.len {
        key := sorted_ids[i]
        mut j := i - 1
        while j >= 0 && scope_comes_before(&scopes[key], &scopes[sorted_ids[j]]) {
            sorted_ids[j + 1] = sorted_ids[j]
            j = j - 1
        }
        sorted_ids[j + 1] = key
    }

    // Dry-run scope stack and verify every branch resolves cleanly before committing bytecode.
    mut active: []i32 = []
    for pos in 0..n {
        while active.len > 0 && scopes[active[active.len - 1]].end == pos { _ := active.pop() }
        for sid in &active { if scopes[sid].end == pos { return false } }
        for id in &sorted_ids {
            if scopes[id].start == pos { active.push(id) }
        }
        rf := r_fall[pos]; rk := r_taken[pos]
        if rk >= 0 && rf >= 0 {
            if rk == pos + 1 {
                if lookup_branch_depth(&active, &scopes, pos, rf) < 0 { return false }
            } else {
                if lookup_branch_depth(&active, &scopes, pos, rk) < 0 { return false }
                if rf != pos + 1 && lookup_branch_depth(&active, &scopes, pos, rf) < 0 { return false }
            }
        } else {
            dest := if rk >= 0 { rk } else { rf }
            if dest >= 0 && dest != pos + 1 {
                if lookup_branch_depth(&active, &scopes, pos, dest) < 0 { return false }
            }
        }
    }
    while active.len > 0 && scopes[active[active.len - 1]].end == n { _ := active.pop() }
    if active.len != 0 { return false }

    // Emit bytecode cleanly now that structured nesting is proven exact!
    reset(&mut out)
    out.local_i64_count = 8 + st.allocated_regs.len
    out.structured = true
    out.needs_pc_local = false

    reload_all_regs(&st, &mut out.body)

    active.clear()
    for pos in 0..n {
        while active.len > 0 && scopes[active[active.len - 1]].end == pos {
            _ := active.pop()
            b.op(&mut out.body, 11)
        }
        for id in &sorted_ids {
            if scopes[id].start == pos {
                active.push(id)
                b.op(&mut out.body, if scopes[id].is_loop { 3 } else { 2 })
                b.op(&mut out.body, 64)
            }
        }

        blk := rpo[pos]
        skip_op := cfg.fuse_cmp_op[blk]
        if !lower_block_body(&st, &mut out, &f, blk, &live_ws, live_ok, skip_op, &mut scratch_arm) {
            return false
        }

        rf := r_fall[pos]; rk := r_taken[pos]
        if cfg.cond_op[blk] >= 0 && rk >= 0 && rf >= 0 {
            cop := cfg.cond_op[blk]
            if rk == pos + 1 {
                if !emit_cond_branch_expr(&st, &mut out.body, &f, skip_op, cop, true) { return false }
                b.indexed(&mut out.body, 13, lookup_branch_depth(&active, &scopes, pos, rf))
            } else {
                if !emit_cond_branch_expr(&st, &mut out.body, &f, skip_op, cop, false) { return false }
                b.indexed(&mut out.body, 13, lookup_branch_depth(&active, &scopes, pos, rk))
                if rf != pos + 1 {
                    b.indexed(&mut out.body, 12, lookup_branch_depth(&active, &scopes, pos, rf))
                }
            }
        } else if cfg.ext_cond_op[blk] >= 0 {
            ecop := cfg.ext_cond_op[blk]
            if !emit_cond_branch_expr(&st, &mut out.body, &f, skip_op, ecop, false) { return false }
            b.op(&mut out.body, 4); b.op(&mut out.body, 64)
            flush_all_regs(&st, &mut out.body)
            add_patch(&mut out, 3, f.targets[ecop])
            b.op(&mut out.body, 11)
            if rf >= 0 && rf != pos + 1 {
                b.indexed(&mut out.body, 12, lookup_branch_depth(&active, &scopes, pos, rf))
            }
        } else if cfg.ext_jump_op[blk] >= 0 {
            flush_all_regs(&st, &mut out.body)
            add_patch(&mut out, 3, f.targets[cfg.ext_jump_op[blk]])
        } else {
            dest := if rk >= 0 { rk } else { rf }
            if dest >= 0 && dest != pos + 1 {
                b.indexed(&mut out.body, 12, lookup_branch_depth(&active, &scopes, pos, dest))
            }
        }
    }
    while active.len > 0 {
        _ := active.pop()
        b.op(&mut out.body, 11)
    }
    b.op(&mut out.body, 11)
    true
}

fn emit_dispatch_next(out: &mut []u8, pc_local: i32, dest: i32, loop_depth: i32) {
    if dest >= 0 {
        b.i32_const(&mut out, dest)
        b.indexed(&mut out, 33, pc_local)
        b.indexed(&mut out, 12, loop_depth)
    } else {
        b.op(&mut out, 0)
    }
}

fn lower_br_table(st: &State, out: &mut Object, f: &mir.Function, cfg: &CfgInfo,
    live_ws: &live.Workspace, live_ok: bool, scratch_arm: &mut arm.Code) -> bool {
    reset(&mut out)
    blocks := f.block_starts.len
    if blocks <= 0 { return false }
    out.local_i64_count = 8 + st.allocated_regs.len
    out.structured = false
    out.needs_pc_local = true
    pc_local := out.local_i64_count

    reload_all_regs(&st, &mut out.body)
    b.i32_const(&mut out.body, 0)
    b.indexed(&mut out.body, 33, pc_local)

    b.op(&mut out.body, 3); b.op(&mut out.body, 64) // outer loop
    for _ in 0..(blocks + 1) { b.op(&mut out.body, 2); b.op(&mut out.body, 64) }
    b.indexed(&mut out.body, 32, pc_local)
    b.op(&mut out.body, 14) // br_table
    b.uleb(&mut out.body, blocks)
    for k in 0..blocks { b.uleb(&mut out.body, k) }
    b.uleb(&mut out.body, blocks)
    b.op(&mut out.body, 11) // end innermost dispatch block -> blk 0

    for b_idx in 0..blocks {
        skip_op := cfg.fuse_cmp_op[b_idx]
        if !lower_block_body(&st, &mut out, &f, b_idx, &live_ws, live_ok, skip_op, &mut scratch_arm) {
            return false
        }
        loop_depth := blocks - 1 - b_idx
        sf := cfg.succ_fall[b_idx]; sk := cfg.succ_taken[b_idx]
        if cfg.cond_op[b_idx] >= 0 && sk >= 0 && sf >= 0 {
            cop := cfg.cond_op[b_idx]
            if !emit_cond_branch_expr(&st, &mut out.body, &f, skip_op, cop, false) { return false }
            b.op(&mut out.body, 4); b.op(&mut out.body, 64)
            emit_dispatch_next(&mut out.body, pc_local, sk, loop_depth + 1)
            b.op(&mut out.body, 11)
            emit_dispatch_next(&mut out.body, pc_local, sf, loop_depth)
        } else if cfg.ext_cond_op[b_idx] >= 0 {
            ecop := cfg.ext_cond_op[b_idx]
            if !emit_cond_branch_expr(&st, &mut out.body, &f, skip_op, ecop, false) { return false }
            b.op(&mut out.body, 4); b.op(&mut out.body, 64)
            flush_all_regs(&st, &mut out.body)
            add_patch(&mut out, 3, f.targets[ecop])
            b.op(&mut out.body, 11)
            if sf >= 0 { emit_dispatch_next(&mut out.body, pc_local, sf, loop_depth) }
            else { b.op(&mut out.body, 0) }
        } else if cfg.ext_jump_op[b_idx] >= 0 {
            flush_all_regs(&st, &mut out.body)
            add_patch(&mut out, 3, f.targets[cfg.ext_jump_op[b_idx]])
        } else {
            dest := if sk >= 0 { sk } else { sf }
            if dest >= 0 { emit_dispatch_next(&mut out.body, pc_local, dest, loop_depth) }
        }
        b.op(&mut out.body, 11) // end case blk_{b_idx}
    }
    b.op(&mut out.body, 0) // default unreachable
    b.op(&mut out.body, 11) // end outer loop
    b.op(&mut out.body, 11) // end function
    true
}

fn find_entry_label(f: &mir.Function) -> i32 {
    for i in 0..f.label_ids.len {
        if f.label_ops[i] == 0 { return f.label_ids[i] }
    }
    -1
}

pub fn lower_into(out: &mut Object, f: &mir.Function) -> bool {
    reset(&mut out)
    if !f.valid || !f.verified || (f.platform != 3 && f.platform != 4) { return false }
    mut live_ws := live.new()
    live_ok := f.optimizable && !f.unknown_control && live.analyze_into(&mut live_ws, &f, 4194304)
    mut st := new_state()
    select_locals(&mut st, &f, live_ok)
    cfg := extract_cfg(&f, &live_ws, live_ok)
    mut scratch_arm := arm.new_for(3)

    if !try_lower_structured(&st, &mut out, &f, &cfg, &live_ws, live_ok, &mut scratch_arm) {
        if !lower_br_table(&st, &mut out, &f, &cfg, &live_ws, live_ok, &mut scratch_arm) {
            reset(&mut out)
            return false
        }
    }
    out.entry_label = find_entry_label(&f)
    out.ready = true
    true
}
