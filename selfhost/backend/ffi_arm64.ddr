import foreign_operation as foreign_abi
import arm64 as arm

pub fn width(ty: i32) -> i32 {
    if ty == 3 || ty == 8 || ty == 17 { return 1 }
    if ty == 9 || ty == 16 { return 2 }
    if ty == 1 || ty == 5 || ty == 6 || ty == 10 { return 4 }
    8
}
fn shape(size: i32) -> i32 {
    if size == 1 { return 0 }; if size == 2 { return 1 }; if size == 4 { return 2 }
    assert(size == 8); 3
}
pub fn load(code: &mut arm.Code, dst: i32, base: i32, offset: i32, size: i32) {
    arm.transfer(&mut code, true, dst, base, shape(size), offset)
}
pub fn store(code: &mut arm.Code, src: i32, base: i32, offset: i32, size: i32) {
    arm.transfer(&mut code, false, src, base, shape(size), offset)
}
pub fn fp(code: &mut arm.Code, reg: i32, general: i32, size: i32, into_fp: bool) {
    mut width := 8; if size == 4 { width = 4 }
    if into_fp { foreign_abi.emit(&mut code, .IntoFloat, reg, general, width) }
    else { foreign_abi.emit(&mut code, .FromFloat, reg, general, width) }
}
pub fn copy(code: &mut arm.Code, dst: i32, src: i32, size: i32) {
    mut off := 0
    while off < size {
        remaining := size - off; mut step := 1
        if remaining >= 8 { step = 8 } else if remaining >= 4 { step = 4 } else if remaining >= 2 { step = 2 }
        load(&mut code, 12, src, off, step); store(&mut code, 12, dst, off, step)
        off = off + step
    }
}
pub fn hfa(code: &mut arm.Code, base: i32, first: i32, shape: i32, into_fp: bool) {
    mut stride := 4; mut size := shape * 4
    if shape < 0 { stride = 8; size = -shape * 8 }
    if code.platform == 2 || code.platform == 5 { stride = 8 }
    mut off := 0; mut reg := first
    while off < size {
        mut step := size - off; if step > stride { step = stride }
        if into_fp { load(&mut code, 12, base, off, step); fp(&mut code, reg, 12, step, true) }
        else { fp(&mut code, reg, 12, step, false); store(&mut code, 12, base, off, step) }
        off = off + step; reg = reg + 1
    }
}

pub fn thread_token(code: &mut arm.Code) {
    foreign_abi.emit(&mut code, .ThreadToken, 0, 0, 0)
}
pub fn load_word_partial(code: &mut arm.Code, dst: i32, base: i32, offset: i32, size: i32) {
    if size <= 0 { return }
    if size == 1 || size == 2 || size == 4 || size == 8 { load(&mut code, dst, base, offset, size); return }
    arm.imm(&mut code, dst, 0)
    mut off := 0
    while off < size {
        remaining := size - off
        mut step := 1
        if remaining >= 4 { step = 4 } else if remaining >= 2 { step = 2 }
        load(&mut code, 11, base, offset + off, step)
        if off > 0 { arm.bitfield(&mut code, false, true, 11, 11, 64 - off * 8, 63 - off * 8) }
        arm.integer_binary(&mut code, 9, true, false, dst, dst, 11, -1)
        off = off + step
    }
}
pub fn store_word_partial(code: &mut arm.Code, src: i32, base: i32, offset: i32, size: i32) {
    if size <= 0 { return }
    if size == 1 || size == 2 || size == 4 || size == 8 { store(&mut code, src, base, offset, size); return }
    mut off := 0
    while off < size {
        remaining := size - off
        mut step := 1
        if remaining >= 4 { step = 4 } else if remaining >= 2 { step = 2 }
        if off == 0 {
            store(&mut code, src, base, offset, step)
        } else {
            arm.bitfield(&mut code, false, true, 11, src, off * 8, 63)
            store(&mut code, 11, base, offset + off, step)
        }
        off = off + step
    }
}
