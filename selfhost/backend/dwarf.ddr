import std.bytes as bytes

pub struct FunctionInfo {
    name: string,
    file_index: i32,
    line: i32,
    low_pc: i64,
    high_pc: i64,
}

pub struct LineInfo {
    address: i64,
    file_index: i32,
    line: i32,
    column: i32,
}

pub struct Input {
    producer: string,
    comp_dir: string,
    main_file: string,
    files: []string,
    low_pc: i64,
    high_pc: i64,
    functions: []FunctionInfo,
    lines: []LineInfo,
}

pub struct Bundle {
    abbrev: []u8,
    info: []u8,
    str_tab: []u8,
    line: []u8,
    sym_names: []string,
    sym_addrs: []i64,
    sym_sizes: []i64,
}

fn append_uleb128(out: &mut []u8, val_in: i64) {
    mut v := val_in
    if v < 0 { v = 0 }
    while true {
        mut byte := i32(v.bit_and(127))
        v = v.shr(7)
        if v != 0 { byte = byte.bit_or(128) }
        out.push(u8(byte))
        if v == 0 { break }
    }
}

fn append_sleb128(out: &mut []u8, val_in: i64) {
    mut v := val_in
    mut more := true
    while more {
        mut byte := i32(v.bit_and(127))
        v = if v < 0 { v.bit_not().shr(7).bit_not() } else { v.shr(7) }
        sign_bit := byte.bit_and(64) != 0
        if (v == 0 && !sign_bit) || (v == -1 && sign_bit) {
            more = false
        } else {
            byte = byte.bit_or(128)
        }
        out.push(u8(byte))
    }
}

fn add_string(str_tab: &mut []u8, index: &mut Map<string, i64>, s: string) -> i64 {
    existing := index.get_or(s, -1)
    if existing >= 0 { return existing }
    off := i64(str_tab.len)
    if s != "" { bytes.append_utf8(&mut str_tab, s) }
    str_tab.push(0)
    index.put(s.clone(), off)
    off
}

fn set_le32(out: &mut []u8, offset: i32, value: i64) {
    for i in 0..4 {
        out[offset + i] = u8(value.shr(i * 8).bit_and(255))
    }
}

fn build_abbrev() -> []u8 {
    mut abbrev: []u8 = []
    // Abbrev 1: DW_TAG_compile_unit (0x11), DW_CHILDREN_yes (1)
    append_uleb128(&mut abbrev, 1)
    append_uleb128(&mut abbrev, 17)
    abbrev.push(1)
    append_uleb128(&mut abbrev, 37); append_uleb128(&mut abbrev, 14) // DW_AT_producer, DW_FORM_strp
    append_uleb128(&mut abbrev, 19); append_uleb128(&mut abbrev, 5)  // DW_AT_language, DW_FORM_data2
    append_uleb128(&mut abbrev, 3);  append_uleb128(&mut abbrev, 14) // DW_AT_name, DW_FORM_strp
    append_uleb128(&mut abbrev, 27); append_uleb128(&mut abbrev, 14) // DW_AT_comp_dir, DW_FORM_strp
    append_uleb128(&mut abbrev, 17); append_uleb128(&mut abbrev, 1)  // DW_AT_low_pc, DW_FORM_addr
    append_uleb128(&mut abbrev, 18); append_uleb128(&mut abbrev, 7)  // DW_AT_high_pc, DW_FORM_data8
    append_uleb128(&mut abbrev, 16); append_uleb128(&mut abbrev, 23) // DW_AT_stmt_list, DW_FORM_sec_offset
    append_uleb128(&mut abbrev, 0);  append_uleb128(&mut abbrev, 0)

    // Abbrev 2: DW_TAG_subprogram (0x2e), DW_CHILDREN_no (0)
    append_uleb128(&mut abbrev, 2)
    append_uleb128(&mut abbrev, 46)
    abbrev.push(0)
    append_uleb128(&mut abbrev, 3);  append_uleb128(&mut abbrev, 14) // DW_AT_name, DW_FORM_strp
    append_uleb128(&mut abbrev, 58); append_uleb128(&mut abbrev, 6)  // DW_AT_decl_file, DW_FORM_data4
    append_uleb128(&mut abbrev, 59); append_uleb128(&mut abbrev, 6)  // DW_AT_decl_line, DW_FORM_data4
    append_uleb128(&mut abbrev, 17); append_uleb128(&mut abbrev, 1)  // DW_AT_low_pc, DW_FORM_addr
    append_uleb128(&mut abbrev, 18); append_uleb128(&mut abbrev, 7)  // DW_AT_high_pc, DW_FORM_data8
    append_uleb128(&mut abbrev, 63); append_uleb128(&mut abbrev, 25) // DW_AT_external, DW_FORM_flag_present
    append_uleb128(&mut abbrev, 0);  append_uleb128(&mut abbrev, 0)

    append_uleb128(&mut abbrev, 0)
    abbrev
}

fn emit_set_address(line: &mut []u8, address: i64) {
    line.push(0)
    append_uleb128(&mut line, 9)
    line.push(2)
    bytes.append_le(&mut line, address, 8)
}

fn build_line(files: &[]string, cu_low: i64, cu_high: i64, rows_in: &[]LineInfo) -> []u8 {
    mut line: []u8 = []
    bytes.append_le(&mut line, 0, 4) // unit_length placeholder
    bytes.append_le(&mut line, 4, 2) // version 4
    header_len_at := line.len
    bytes.append_le(&mut line, 0, 4) // header_length placeholder
    header_body_start := line.len
    line.push(1)   // minimum_instruction_length
    line.push(1)   // maximum_operations_per_instruction
    line.push(1)   // default_is_stmt
    line.push(251) // line_base = -5
    line.push(14)  // line_range = 14
    line.push(13)  // opcode_base = 13
    std_lens: [i32; 12] = [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1]
    for l in &std_lens { line.push(u8(l)) }
    // include_directories (empty)
    line.push(0)
    // file_names
    file_count := files.len
    for i in 0..file_count {
        if files[i] != "" { bytes.append_utf8(&mut line, files[i]) } else { bytes.append_utf8(&mut line, "<source>") }
        line.push(0)
        append_uleb128(&mut line, 0) // dir index
        append_uleb128(&mut line, 0) // mtime
        append_uleb128(&mut line, 0) // size
    }
    line.push(0)
    set_le32(&mut line, header_len_at, i64(line.len - header_body_start))

    mut rows: []LineInfo = []
    for i in 0..rows_in.len {
        r := &rows_in[i]
        if r.address < cu_low || r.address >= cu_high { continue }
        mut fidx := r.file_index
        if fidx < 1 { fidx = 1 }
        if fidx > file_count { fidx = file_count }
        mut ln := r.line; if ln < 1 { ln = 1 }
        mut col := r.column; if col < 1 { col = 1 }
        if rows.len > 0 && rows[rows.len - 1].address == r.address {
            continue
        }
        rows.push(LineInfo { address: r.address, file_index: fidx, line: ln, column: col })
    }

    if rows.len == 0 && cu_high > cu_low {
        rows.push(LineInfo { address: cu_low, file_index: 1, line: 1, column: 1 })
    }

    if rows.len > 0 {
        mut cur_addr: i64 = rows[0].address
        mut cur_file: i32 = 1
        mut cur_line: i32 = 1
        mut cur_col: i32 = 0
        emit_set_address(&mut line, cur_addr)
        for i in 0..rows.len {
            r := &rows[i]
            if r.address > cur_addr {
                line.push(2) // DW_LNS_advance_pc
                append_uleb128(&mut line, r.address - cur_addr)
                cur_addr = r.address
            }
            if r.file_index != cur_file {
                line.push(4) // DW_LNS_set_file
                append_uleb128(&mut line, i64(r.file_index))
                cur_file = r.file_index
            }
            if r.column != cur_col {
                line.push(5) // DW_LNS_set_column
                append_uleb128(&mut line, i64(r.column))
                cur_col = r.column
            }
            if r.line != cur_line {
                line.push(3) // DW_LNS_advance_line
                append_sleb128(&mut line, i64(r.line - cur_line))
                cur_line = r.line
            }
            line.push(1) // DW_LNS_copy
        }
        if cu_high > cur_addr {
            line.push(2) // DW_LNS_advance_pc
            append_uleb128(&mut line, cu_high - cur_addr)
        }
        // DW_LNE_end_sequence
        line.push(0)
        append_uleb128(&mut line, 1)
        line.push(1)
    }

    set_le32(&mut line, 0, i64(line.len - 4))
    line
}

pub fn build(input: &Input) -> Bundle {
    mut str_tab: []u8 = [0]
    mut str_map := Map<string, i64>::new()
    str_map.put("", 0)

    mut files := input.files.clone()
    if files.len == 0 {
        files.push(if input.main_file != "" { input.main_file.clone() } else { "<source>" })
    }

    mut cu_low := input.low_pc
    mut cu_high := input.high_pc
    if cu_high < cu_low { cu_high = cu_low }

    abbrev := build_abbrev()

    mut info: []u8 = []
    bytes.append_le(&mut info, 0, 4) // unit_length placeholder
    bytes.append_le(&mut info, 4, 2) // version 4
    bytes.append_le(&mut info, 0, 4) // debug_abbrev_offset
    info.push(8)                     // address_size

    prod := if input.producer != "" { input.producer.clone() } else { "dunder" }
    main_name := if input.main_file != "" { input.main_file.clone() } else { files[0].clone() }
    dir_name := if input.comp_dir != "" { input.comp_dir.clone() } else { "." }

    append_uleb128(&mut info, 1) // CU abbrev
    bytes.append_le(&mut info, add_string(&mut str_tab, &mut str_map, prod), 4)
    bytes.append_le(&mut info, 12, 2) // DW_LANG_C99
    bytes.append_le(&mut info, add_string(&mut str_tab, &mut str_map, main_name), 4)
    bytes.append_le(&mut info, add_string(&mut str_tab, &mut str_map, dir_name), 4)
    bytes.append_le(&mut info, cu_low, 8)
    bytes.append_le(&mut info, cu_high - cu_low, 8)
    bytes.append_le(&mut info, 0, 4) // DW_AT_stmt_list

    mut sym_names: []string = []
    mut sym_addrs: []i64 = []
    mut sym_sizes: []i64 = []

    for i in 0..input.functions.len {
        fn_item := &input.functions[i]
        if fn_item.high_pc <= fn_item.low_pc { continue }
        if fn_item.low_pc < cu_low || fn_item.high_pc > cu_high { continue }
        mut fidx := fn_item.file_index
        if fidx < 1 { fidx = 1 }
        if fidx > files.len { fidx = files.len }
        mut ln := fn_item.line
        if ln < 1 { ln = 1 }
        fname := if fn_item.name != "" { fn_item.name.clone() } else { "fn_" + i.str() }
        sym_names.push(fname.clone())
        sym_addrs.push(fn_item.low_pc)
        sym_sizes.push(fn_item.high_pc - fn_item.low_pc)

        append_uleb128(&mut info, 2) // subprogram abbrev
        bytes.append_le(&mut info, add_string(&mut str_tab, &mut str_map, fname), 4)
        bytes.append_le(&mut info, i64(fidx), 4)
        bytes.append_le(&mut info, i64(ln), 4)
        bytes.append_le(&mut info, fn_item.low_pc, 8)
        bytes.append_le(&mut info, fn_item.high_pc - fn_item.low_pc, 8)
    }

    info.push(0) // terminate CU children
    set_le32(&mut info, 0, i64(info.len - 4))

    line := build_line(&files, cu_low, cu_high, &input.lines)
    Bundle {
        abbrev: abbrev,
        info: info,
        str_tab: str_tab,
        line: line,
        sym_names: sym_names,
        sym_addrs: sym_addrs,
        sym_sizes: sym_sizes,
    }
}

@test fn dwarf_v4_encodes_sleb_uleb_and_sections() {
    mut leb: []u8 = []
    append_uleb128(&mut leb, 624485)
    assert(leb.len == 3 && leb[0] == 229 && leb[1] == 142 && leb[2] == 38)
    mut sleb: []u8 = []
    append_sleb128(&mut sleb, -123456)
    assert(sleb.len == 3 && sleb[0] == 192 && sleb[1] == 187 && sleb[2] == 120)

    input := Input {
        producer: "dunder test",
        comp_dir: "/work",
        main_file: "main.ddr",
        files: ["main.ddr"],
        low_pc: 4198400,
        high_pc: 4198464,
        functions: [
            FunctionInfo { name: "main", file_index: 1, line: 1, low_pc: 4198400, high_pc: 4198440 },
            FunctionInfo { name: "helper", file_index: 1, line: 4, low_pc: 4198440, high_pc: 4198464 },
        ],
        lines: [
            LineInfo { address: 4198400, file_index: 1, line: 2, column: 5 },
            LineInfo { address: 4198416, file_index: 1, line: 3, column: 5 },
            LineInfo { address: 4198440, file_index: 1, line: 5, column: 5 },
        ],
    }
    b := build(&input)
    assert(b.abbrev.len > 0 && b.abbrev[b.abbrev.len - 1] == 0)
    assert(b.info.len > 12 && bytes.u16_le(&b.info, 4) == 4 && b.info[10] == 8)
    assert(b.line.len > 20 && bytes.u16_le(&b.line, 4) == 4)
    assert(b.sym_names.len == 2 && b.sym_names[0] == "main" && b.sym_names[1] == "helper")
    assert(b.sym_addrs[0] == 4198400 && b.sym_sizes[0] == 40)
}
