import ..frontend.frontend_types as ft

pub const CLASS_NO: i32 = 0
pub const CLASS_SSE: i32 = 1
pub const CLASS_INT: i32 = 2
pub const CLASS_MEM: i32 = 3

pub const ARG_GPR: i32 = 0
pub const ARG_XMM: i32 = 1
pub const ARG_STACK_SCALAR: i32 = 2
pub const ARG_AGG_REGS: i32 = 3
pub const ARG_AGG_STACK: i32 = 4

pub const RET_VOID: i32 = 0
pub const RET_GPR: i32 = 1
pub const RET_XMM: i32 = 2
pub const RET_AGG_REGS: i32 = 3
pub const RET_INDIRECT: i32 = 4

pub struct Eightbytes {
    count: i32,
    c0: i32,
    c1: i32,
    size: i32,
    align: i32,
    memory: bool,
}

pub struct ArgPlan {
    kind: i32,
    eb_count: i32,
    c0: i32,
    reg0: i32,
    size0: i32,
    c1: i32,
    reg1: i32,
    size1: i32,
    stack_off: i32,
    total_size: i32,
}

pub struct RetPlan {
    kind: i32,
    eb_count: i32,
    c0: i32,
    reg0: i32,
    size0: i32,
    c1: i32,
    reg1: i32,
    size1: i32,
    total_size: i32,
}

pub struct Plan {
    ret: RetPlan,
    args: []ArgPlan,
    gp_used: i32,
    fp_used: i32,
    outgoing: i32,
}

fn align_up(value: i32, alignment: i32) -> i32 {
    if alignment <= 1 { return value }
    (value + alignment - 1) / alignment * alignment
}

fn merge_class(a: i32, b: i32) -> i32 {
    if a == b { return a }
    if a == CLASS_NO { return b }
    if b == CLASS_NO { return a }
    if a == CLASS_MEM || b == CLASS_MEM { return CLASS_MEM }
    if a == CLASS_INT || b == CLASS_INT { return CLASS_INT }
    CLASS_SSE
}

fn is_float_scalar(ty: i32) -> bool {
    ty == 6 || ty == 7
}

fn classify_walk(reg: &ft.TypeRegistry, ty: i32, base_off: i32, depth: i32, eb0: &mut i32, eb1: &mut i32) {
    if depth > 64 {
        eb0 = CLASS_MEM
        eb1 = CLASS_MEM
        return
    }
    if ft.is_c_record(&reg, ty) {
        first := ft.type_start(&reg, ty)
        count := ft.type_count(&reg, ty)
        for i in 0..count {
            fty := reg.field_types[first + i]
            foff := i32(reg.field_values[first + i])
            classify_walk(&reg, fty, base_off + foff, depth + 1, &mut eb0, &mut eb1)
            if eb0 == CLASS_MEM || eb1 == CLASS_MEM { return }
        }
        return
    }
    if ft.type_kind(&reg, ty) == 6 {
        elem := ft.type_base(&reg, ty)
        count := ft.type_count(&reg, ty)
        stride := ft.c_size(&reg, elem)
        for i in 0..count {
            classify_walk(&reg, elem, base_off + i * stride, depth + 1, &mut eb0, &mut eb1)
            if eb0 == CLASS_MEM || eb1 == CLASS_MEM { return }
        }
        return
    }
    base := ft.c_abi_scalar_type(&reg, ty)
    width := ft.foreign_width(base)
    if width > 1 && base_off % width != 0 {
        eb0 = CLASS_MEM
        eb1 = CLASS_MEM
        return
    }
    cls := if is_float_scalar(base) { CLASS_SSE } else { CLASS_INT }
    first_eb := base_off / 8
    last_eb := (base_off + width - 1) / 8
    if first_eb < 0 || last_eb > 1 {
        eb0 = CLASS_MEM
        eb1 = CLASS_MEM
        return
    }
    if first_eb == 0 { eb0 = merge_class(eb0, cls) }
    if first_eb == 1 || last_eb == 1 { eb1 = merge_class(eb1, cls) }
}

pub fn classify_type(reg: &ft.TypeRegistry, ty: i32) -> Eightbytes {
    if ty == 0 {
        return Eightbytes { count: 0, c0: CLASS_NO, c1: CLASS_NO, size: 0, align: 1, memory: false }
    }
    if !ft.is_c_record(&reg, ty) {
        base := ft.c_abi_scalar_type(&reg, ty)
        w := ft.foreign_width(base)
        cls := if is_float_scalar(base) { CLASS_SSE } else { CLASS_INT }
        return Eightbytes { count: 1, c0: cls, c1: CLASS_NO, size: w, align: w, memory: false }
    }
    size := ft.c_size(&reg, ty)
    align := ft.c_align(&reg, ty)
    if size <= 0 || size > 16 {
        return Eightbytes { count: 0, c0: CLASS_MEM, c1: CLASS_MEM, size: size, align: align, memory: true }
    }
    mut eb0 := CLASS_NO
    mut eb1 := CLASS_NO
    classify_walk(&reg, ty, 0, 0, &mut eb0, &mut eb1)
    if eb0 == CLASS_MEM || eb1 == CLASS_MEM {
        return Eightbytes { count: 0, c0: CLASS_MEM, c1: CLASS_MEM, size: size, align: align, memory: true }
    }
    count := if size > 8 { 2 } else { 1 }
    if eb0 == CLASS_NO { eb0 = CLASS_INT }
    if count == 2 && eb1 == CLASS_NO { eb1 = CLASS_INT }
    Eightbytes { count: count, c0: eb0, c1: eb1, size: size, align: align, memory: false }
}

pub fn plan_return(reg: &ft.TypeRegistry, ret_ty: i32) -> RetPlan {
    if ret_ty == 0 {
        return RetPlan { kind: RET_VOID, eb_count: 0, c0: CLASS_NO, reg0: 0, size0: 0, c1: CLASS_NO, reg1: 0, size1: 0, total_size: 0 }
    }
    if !ft.is_c_record(&reg, ret_ty) {
        base := ft.c_abi_scalar_type(&reg, ret_ty)
        w := ft.foreign_width(base)
        if is_float_scalar(base) {
            return RetPlan { kind: RET_XMM, eb_count: 1, c0: CLASS_SSE, reg0: 0, size0: w, c1: CLASS_NO, reg1: 0, size1: 0, total_size: w }
        }
        return RetPlan { kind: RET_GPR, eb_count: 1, c0: CLASS_INT, reg0: 0, size0: w, c1: CLASS_NO, reg1: 0, size1: 0, total_size: w }
    }
    eb := classify_type(&reg, ret_ty)
    if eb.memory {
        return RetPlan { kind: RET_INDIRECT, eb_count: 0, c0: CLASS_MEM, reg0: 0, size0: 0, c1: CLASS_NO, reg1: 0, size1: 0, total_size: eb.size }
    }
    mut gp := 0
    mut fp := 0
    mut r0 := 0
    mut r1 := 0
    s0 := if eb.size > 8 { 8 } else { eb.size }
    s1 := if eb.size > 8 { eb.size - 8 } else { 0 }
    if eb.c0 == CLASS_INT { r0 = gp; gp += 1 } else { r0 = fp; fp += 1 }
    if eb.count == 2 {
        if eb.c1 == CLASS_INT { r1 = gp; gp += 1 } else { r1 = fp; fp += 1 }
    }
    RetPlan { kind: RET_AGG_REGS, eb_count: eb.count, c0: eb.c0, reg0: r0, size0: s0, c1: eb.c1, reg1: r1, size1: s1, total_size: eb.size }
}

pub fn plan_call(reg: &ft.TypeRegistry, param_types: &[]i32, ret_ty: i32) -> Plan {
    ret := plan_return(&reg, ret_ty)
    mut gp := if ret.kind == RET_INDIRECT { 1 } else { 0 }
    mut fp := 0
    mut outgoing := 0
    mut args: []ArgPlan = []
    args.reserve(param_types.len)
    for i in 0..param_types.len {
        ty := param_types[i]
        if !ft.is_c_record(&reg, ty) {
            base := ft.c_abi_scalar_type(&reg, ty)
            w := ft.foreign_width(base)
            if is_float_scalar(base) {
                if fp < 8 {
                    args.push(ArgPlan { kind: ARG_XMM, eb_count: 1, c0: CLASS_SSE, reg0: fp, size0: w, c1: CLASS_NO, reg1: 0, size1: 0, stack_off: 0, total_size: w })
                    fp += 1
                } else {
                    outgoing = align_up(outgoing, 8)
                    args.push(ArgPlan { kind: ARG_STACK_SCALAR, eb_count: 1, c0: CLASS_SSE, reg0: 0, size0: w, c1: CLASS_NO, reg1: 0, size1: 0, stack_off: outgoing, total_size: w })
                    outgoing += 8
                }
            } else {
                if gp < 6 {
                    args.push(ArgPlan { kind: ARG_GPR, eb_count: 1, c0: CLASS_INT, reg0: gp, size0: w, c1: CLASS_NO, reg1: 0, size1: 0, stack_off: 0, total_size: w })
                    gp += 1
                } else {
                    outgoing = align_up(outgoing, 8)
                    args.push(ArgPlan { kind: ARG_STACK_SCALAR, eb_count: 1, c0: CLASS_INT, reg0: 0, size0: w, c1: CLASS_NO, reg1: 0, size1: 0, stack_off: outgoing, total_size: w })
                    outgoing += 8
                }
            }
        } else {
            eb := classify_type(&reg, ty)
            mut placed := false
            if !eb.memory {
                mut need_gp := 0
                mut need_fp := 0
                if eb.c0 == CLASS_INT { need_gp += 1 } else if eb.c0 == CLASS_SSE { need_fp += 1 }
                if eb.count == 2 {
                    if eb.c1 == CLASS_INT { need_gp += 1 } else if eb.c1 == CLASS_SSE { need_fp += 1 }
                }
                if gp + need_gp <= 6 && fp + need_fp <= 8 {
                    mut r0 := 0
                    mut r1 := 0
                    s0 := if eb.size > 8 { 8 } else { eb.size }
                    s1 := if eb.size > 8 { eb.size - 8 } else { 0 }
                    if eb.c0 == CLASS_INT { r0 = gp; gp += 1 } else { r0 = fp; fp += 1 }
                    if eb.count == 2 {
                        if eb.c1 == CLASS_INT { r1 = gp; gp += 1 } else { r1 = fp; fp += 1 }
                    }
                    args.push(ArgPlan { kind: ARG_AGG_REGS, eb_count: eb.count, c0: eb.c0, reg0: r0, size0: s0, c1: eb.c1, reg1: r1, size1: s1, stack_off: 0, total_size: eb.size })
                    placed = true
                }
            }
            if !placed {
                slot_align := if eb.align > 8 { eb.align } else { 8 }
                outgoing = align_up(outgoing, slot_align)
                args.push(ArgPlan { kind: ARG_AGG_STACK, eb_count: 0, c0: CLASS_MEM, reg0: 0, size0: eb.size, c1: CLASS_NO, reg1: 0, size1: 0, stack_off: outgoing, total_size: eb.size })
                outgoing += align_up(eb.size, 8)
            }
        }
    }
    outgoing = align_up(outgoing, 16)
    Plan { ret: ret, args: args, gp_used: gp, fp_used: fp, outgoing: outgoing }
}

fn test_registry() -> ft.TypeRegistry {
    mut reg := ft.new_registry()
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr", "range", "str", "i16"] {
        _ := ft.add_type(&mut reg, name, 0, 0)
    }
    reg
}

fn add_c_struct(reg: &mut ft.TypeRegistry, name: string, fields: &[]i32) -> i32 {
    ty := ft.add_type(&mut reg, name, 2, 0)
    reg.c_record[ty] = true
    reg.declared.type_starts[ty] = reg.field_types.len
    reg.declared.type_counts[ty] = fields.len
    for i in 0..fields.len {
        reg.field_names.push(f"f{i}")
        reg.field_types.push(fields[i])
        reg.field_values.push(0)
        reg.payload_starts.push(reg.payload_types.len)
        reg.payload_counts.push(0)
    }
    ft.c_layout(&mut reg, 2, ty)
    assert(reg.error == "")
    ty
}

@test fn sysv_classifies_int_sse_mixed_and_memory_structs() {
    mut reg := test_registry()
    s_i32_i32 := add_c_struct(&mut reg, "I32Pair", &[1, 1])
    s_i64_i64 := add_c_struct(&mut reg, "I64Pair", &[2, 2])
    s_f32_f32 := add_c_struct(&mut reg, "F32Pair", &[6, 6])
    s_f32_4 := add_c_struct(&mut reg, "F32Quad", &[6, 6, 6, 6])
    s_i64_f64 := add_c_struct(&mut reg, "IntFloat", &[2, 7])
    s_f32_i32_f64 := add_c_struct(&mut reg, "Mixed16", &[6, 1, 7])
    s_big := add_c_struct(&mut reg, "Big24", &[2, 2, 2])

    c1 := classify_type(&reg, s_i32_i32)
    assert(!c1.memory && c1.count == 1 && c1.c0 == CLASS_INT && c1.size == 8)

    c2 := classify_type(&reg, s_i64_i64)
    assert(!c2.memory && c2.count == 2 && c2.c0 == CLASS_INT && c2.c1 == CLASS_INT && c2.size == 16)

    c3 := classify_type(&reg, s_f32_f32)
    assert(!c3.memory && c3.count == 1 && c3.c0 == CLASS_SSE && c3.size == 8)

    c4 := classify_type(&reg, s_f32_4)
    assert(!c4.memory && c4.count == 2 && c4.c0 == CLASS_SSE && c4.c1 == CLASS_SSE && c4.size == 16)

    c5 := classify_type(&reg, s_i64_f64)
    assert(!c5.memory && c5.count == 2 && c5.c0 == CLASS_INT && c5.c1 == CLASS_SSE && c5.size == 16)

    c6 := classify_type(&reg, s_f32_i32_f64)
    assert(!c6.memory && c6.count == 2 && c6.c0 == CLASS_INT && c6.c1 == CLASS_SSE && c6.size == 16)

    c7 := classify_type(&reg, s_big)
    assert(c7.memory && c7.size == 24)
}

@test fn sysv_plan_handles_atomic_spill_and_sret() {
    mut reg := test_registry()
    s_i64_i64 := add_c_struct(&mut reg, "I64Pair", &[2, 2])
    s_i64_f64 := add_c_struct(&mut reg, "IntFloat", &[2, 7])
    s_big := add_c_struct(&mut reg, "Big24", &[2, 2, 2])

    // 5 GPRs used + 2-GPR struct -> must spill atomically to stack, leaving GPR 5 free for final i64!
    p := plan_call(&reg, &[2, 2, 2, 2, 2, s_i64_i64, 2], s_i64_f64)
    assert(p.ret.kind == RET_AGG_REGS && p.ret.c0 == CLASS_INT && p.ret.reg0 == 0 && p.ret.c1 == CLASS_SSE && p.ret.reg1 == 0)
    assert(p.args[5].kind == ARG_AGG_STACK && p.args[5].stack_off == 0)
    assert(p.args[6].kind == ARG_GPR && p.args[6].reg0 == 5)
    assert(p.gp_used == 6 && p.outgoing == 16)

    // >16B return consumes rdi (gp = 1)
    p2 := plan_call(&reg, &[2, s_big], s_big)
    assert(p2.ret.kind == RET_INDIRECT)
    assert(p2.args[0].kind == ARG_GPR && p2.args[0].reg0 == 1)
    assert(p2.args[1].kind == ARG_AGG_STACK && p2.args[1].stack_off == 0 && p2.outgoing == 32)
}
