// Selfhosted ARM64 expression values carry raw IEEE bits in x0 (left operand x1).
import arm64 as arm
import unsigned
pub fn has(ty: i32) -> bool { ty == 6 || ty == 7 }
fn width(ty: i32) -> i64 { if ty == 7 { 4194304 } else { 0 } }
fn into_fp(code: &mut arm.Code, ty: i32, reg: i32) {
    var opcode: i64 = 505872384
    if ty == 7 { opcode = 2657550336 }
    arm.emit(&mut code, opcode + i64(reg) * 33)
}
fn from_fp(code: &mut arm.Code, ty: i32) {
    if ty == 6 { arm.emit(&mut code, 505806848) } else { arm.emit(&mut code, 2657484800) }
}
pub fn binary(code: &mut arm.Code, op: string, ty: i32) -> i32 {
    into_fp(&mut code, ty, 0); into_fp(&mut code, ty, 1)
    var opcode: i64 = 0
    if op == "+" { opcode = 505423872 }
    else if op == "-" { opcode = 505427968 }
    else if op == "*" { opcode = 505415680 }
    else if op == "/" { opcode = 505419776 }
    if opcode != 0 {
        arm.emit(&mut code, opcode + width(ty) + 32); from_fp(&mut code, ty); return ty
    }
    var cond := 0
    if op == "!=" { cond = 1 }
    if op == "<" { cond = 4 }
    if op == "<=" { cond = 9 }
    if op == ">" { cond = 12 }
    if op == ">=" { cond = 10 }
    arm.emit(&mut code, 505421856 + width(ty))
    arm.emit(&mut code, 2594113504 + i64(cond.bit_xor(1)) * 4096)
    3
}
pub fn method(code: &mut arm.Code, ty: i32, name: string) -> i32 {
    if name == "to_bits" {
        if ty == 6 { arm.emit(&mut code, 2470476800); return 1 }
        return 2
    }
    if name == "is_sign_negative" {
        var shift := 31; if ty == 7 { shift = 63 }
        arm.emit(&mut code, 3544251392 + i64(shift) * 65536); return 3
    }
    into_fp(&mut code, ty, 0)
    var opcode: i64 = 0
    if name == "abs" { opcode = 505462784 }
    if name == "sqrt" { opcode = 505528320 }
    if name == "floor" { opcode = 505757696 }
    if name == "ceil" { opcode = 505724928 }
    if name == "round" { opcode = 505823232 }
    if name == "round_ties_even" { opcode = 505692160 }
    if name == "trunc" { opcode = 505790464 }
    if name == "negate" { opcode = 505495552 }
    if opcode != 0 {
        arm.emit(&mut code, opcode + width(ty)); from_fp(&mut code, ty); return ty
    }
    if name == "is_nan" {
        arm.emit(&mut code, 505421824 + width(ty)); arm.emit(&mut code, 2594142176); return 3
    }
    if name == "is_finite" || name == "is_infinite" {
        var infinity: i64 = 2139095040; if ty == 7 { infinity = 9218868437227405312 }
        arm.imm(&mut code, 1, infinity); into_fp(&mut code, ty, 1)
        arm.emit(&mut code, 505462784 + width(ty)); arm.emit(&mut code, 505487360 + width(ty))
        var cond := 0; if name == "is_finite" { cond = 4 }
        arm.emit(&mut code, 2594113504 + i64(cond.bit_xor(1)) * 4096); return 3
    }
    -1
}
pub fn cast(code: &mut arm.Code, from: i32, to: i32, trap: i32) {
    if from == to { return }
    if !has(from) {
        var opcode: i64 = 2653028352
        if unsigned.has(from) { opcode = 2653093888 }
        arm.emit(&mut code, opcode + width(to)); from_fp(&mut code, to); return
    }
    into_fp(&mut code, from, 0)
    if has(to) {
        if to == 6 { arm.emit(&mut code, 509755392) } else { arm.emit(&mut code, 505593856) }
        from_fp(&mut code, to); return
    }
    arm.emit(&mut code, 505790464 + width(from))
    var bits := 64
    if to == 1 { bits = 32 }; if unsigned.has(to) { bits = unsigned.width(to) }
    var power := bits; if !unsigned.has(to) { power = power - 1 }
    var limit := i64(127 + power).shl(23); var sign: i64 = 2147483648
    if from == 7 { limit = i64(1023 + power).shl(52); sign = -9223372036854775808 }
    var lower := limit.bit_or(sign); if unsigned.has(to) { lower = 0 }
    arm.imm(&mut code, 1, lower); into_fp(&mut code, from, 1); arm.emit(&mut code, 505487360 + width(from))
    arm.branch(&mut code, trap, 8); arm.branch(&mut code, trap, 6)
    arm.imm(&mut code, 1, limit); into_fp(&mut code, from, 1); arm.emit(&mut code, 505487360 + width(from))
    arm.branch(&mut code, trap, 12)
    var opcode: i64 = 2654470144; if unsigned.has(to) { opcode = 2654535680 }
    arm.emit(&mut code, opcode + width(from))
}
