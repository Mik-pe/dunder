// Source-independent, parent-only isolated task scheduler emission. The source
// producer seals worker effects and NoSharedHandleData before using this API.
// Pointer tables contain non-owning references, never copied managed values.
import arm64 as arm
import ffi_arm64 as abi
import runtime
import task_native as native

// Coordinator32: magic0, owner OS token8, last generation16, reserved24.
// ONE zeroed coordinator belongs to the parent runtime, not to each scope.
// Scope128: generation0, live1/closed2 at8, limit16, active24, jobs32,
// index capacity40, index pointer48, FIFO head56/tail64, owner token72.
// Index slots are16 bytes: non-owning Entry pointer0, exact result type8.
// Entry128: immutable Kind pointer0, FIFO next8, ordinal16, Scope owner24,
// active flag32, reserved40, embedded NativeControl at48 (80 bytes).
// Kind80: initialized0, result type8, create16, collect24, discard32,
// input clone40/drop48, result clone56/drop64, reserved72. Callback addresses
// are immutable parent-only code pointers; zero means a scalar no-op.
// Completed input snapshots and cached results remain owned until close.
// close first joins/discards ALL active jobs, then drops any parent roots.
// Every validation/provider error branches to the producer's fatal trap with
// scope/index/entry/owner roots retained. There is no recovery or retry here.
pub fn policy_tag() -> string { "isolated-task-scope1" }
pub fn coordinator_bytes() -> i32 { 32 }
pub fn kind_bytes() -> i32 { 80 }
pub fn scope_bytes() -> i32 { 128 }
pub fn entry_bytes() -> i32 { 128 }
pub struct Runtime { ok: bool, error: string, open: i32, spawn: i32, drain: i32, await_result: i32, close: i32, trap: i32 }
pub struct KindSpec {
    result_type: i32, create: i32, collect: i32, discard: i32,
    input_clone: i32, input_drop: i32, result_clone: i32, result_drop: i32,
}
pub struct Kind { ok: bool, error: string, spawn: i32, import_sites: []i32, import_slots: []i32 }
fn ld(c: &mut arm.Code, dst: i32, base: i32, off: i32) { abi.load(&mut c, dst, base, off, 8) }
fn st(c: &mut arm.Code, src: i32, base: i32, off: i32) { abi.store(&mut c, src, base, off, 8) }
fn ai(c: &mut arm.Code, dst: i32, src: i32, n: i32) { arm.emit(&mut c, 2432696320 + i64(n) * 1024 + i64(src) * 32 + i64(dst)) }
fn si(c: &mut arm.Code, dst: i32, src: i32, n: i32) { arm.emit(&mut c, 3506438144 + i64(n) * 1024 + i64(src) * 32 + i64(dst)) }
fn cmp(c: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut c, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn ci(c: &mut arm.Code, reg: i32, n: i32) { arm.emit(&mut c, 4043309087 + i64(n) * 1024 + i64(reg) * 32) }
fn add(c: &mut arm.Code, dst: i32, a: i32, b: i32) { arm.emit(&mut c, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst)) }
fn shl(c: &mut arm.Code, dst: i32, src: i32, n: i32) { arm.emit(&mut c, 3544186880 + i64(64 - n) * 65536 + i64(63 - n) * 1024 + i64(src) * 32 + i64(dst)) }
fn shr(c: &mut arm.Code, dst: i32, src: i32, n: i32) { arm.emit(&mut c, 3544251392 + i64(n) * 65536 + i64(src) * 32 + i64(dst)) }
fn call(c: &mut arm.Code, label: i32) { arm.branch(&mut c, label, 1) }
fn indirect(c: &mut arm.Code) { arm.emit(&mut c, 3594453536) } // BLR X17, internal value ABI
fn begin(c: &mut arm.Code, label: i32, slots: i32) { arm.mark(&mut c, label); at := arm.prologue(&mut c); arm.frame(&mut c, at, slots) }
fn zero(c: &mut arm.Code, base: i32, bytes: i32) { for word in 0..bytes / 8 { st(&mut c, 31, base, word * 8) } }
fn scope_check(c: &mut arm.Code, trap: i32) {
    arm.branch(&mut c, trap, 18); ld(&mut c, 10, 0, 8); ci(&mut c, 10, 1); arm.branch(&mut c, trap, 3)
    abi.thread_token(&mut c); ld(&mut c, 11, 0, 72); cmp(&mut c, 10, 11); arm.branch(&mut c, trap, 3)
}
fn callback(c: &mut arm.Code, offset: i32) {
    // X0=Entry. Load its immutable callback and pass embedded Control in X0.
    ld(&mut c, 17, 0, 0); ld(&mut c, 17, 17, offset); ai(&mut c, 0, 0, 48); indirect(&mut c)
}
fn inactive(c: &mut arm.Code, trap: i32, scope_slot: i32, entry_slot: i32) {
    arm.load(&mut c, entry_slot); st(&mut c, 31, 0, 32)
    arm.load(&mut c, scope_slot); ld(&mut c, 10, 0, 24); ci(&mut c, 10, 0); arm.branch(&mut c, trap, 2)
    si(&mut c, 10, 10, 1); st(&mut c, 10, 0, 24)
}
fn open(c: &mut arm.Code, rt: &runtime.Runtime, r: &Runtime) {
    // X0=positive limit, X1=Coordinator32 address; returns owned Scope.
    begin(&mut c, r.open, 4); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1)
    ci(&mut c, 0, 0); arm.branch(&mut c, r.trap, 15)
    arm.imm(&mut c, 10, 2147483647); cmp(&mut c, 0, 10); arm.branch(&mut c, r.trap, 10)
    arm.mov(&mut c, 0, 1); arm.branch(&mut c, r.trap, 18)
    abi.thread_token(&mut c); arm.store(&mut c, 2, 10)
    fresh := arm.label(&mut c); ready := arm.label(&mut c)
    ld(&mut c, 11, 1, 0); ci(&mut c, 11, 0); arm.branch(&mut c, fresh, 2)
    ci(&mut c, 11, 1); arm.branch(&mut c, r.trap, 3)
    ld(&mut c, 11, 1, 8); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3); arm.branch(&mut c, ready, 0)
    arm.mark(&mut c, fresh); arm.imm(&mut c, 11, 1); st(&mut c, 11, 1, 0); st(&mut c, 10, 1, 8); st(&mut c, 31, 1, 16); st(&mut c, 31, 1, 24)
    arm.mark(&mut c, ready); ld(&mut c, 10, 1, 16); arm.imm(&mut c, 11, 2147483647)
    cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 4); ai(&mut c, 10, 10, 1); st(&mut c, 10, 1, 16); arm.store(&mut c, 3, 10)
    arm.imm(&mut c, 0, 128); call(&mut c, rt.alloc); zero(&mut c, 0, 128)
    arm.load_into(&mut c, 3, 10); st(&mut c, 10, 0, 0)
    arm.imm(&mut c, 10, 1); st(&mut c, 10, 0, 8)
    arm.load_into(&mut c, 0, 10); st(&mut c, 10, 0, 16)
    arm.load_into(&mut c, 2, 10); st(&mut c, 10, 0, 72); arm.ret(&mut c)
}
fn grow_index(c: &mut arm.Code, rt: &runtime.Runtime, trap: i32) {
    // Spawn frame: Scope0, input1, Kind2, ordinal3, Entry4, newIndex5,
    // oldIndex6, newCapacity7. Copies only borrowed pointer/type metadata.
    enough := arm.label(&mut c); initial := arm.label(&mut c); chosen := arm.label(&mut c)
    arm.load(&mut c, 0); ld(&mut c, 10, 0, 40); arm.load_into(&mut c, 3, 11)
    cmp(&mut c, 11, 10); arm.branch(&mut c, enough, 5)
    cmp(&mut c, 11, 10); arm.branch(&mut c, trap, 10)
    ci(&mut c, 10, 0); arm.branch(&mut c, initial, 2); shl(&mut c, 10, 10, 1); arm.branch(&mut c, chosen, 0)
    arm.mark(&mut c, initial); arm.imm(&mut c, 10, 8)
    arm.mark(&mut c, chosen); arm.imm(&mut c, 11, 2147483648); cmp(&mut c, 10, 11)
    clamped := arm.label(&mut c); arm.branch(&mut c, clamped, 11); arm.mov(&mut c, 10, 11); arm.mark(&mut c, clamped)
    arm.store(&mut c, 7, 10); shl(&mut c, 0, 10, 4); call(&mut c, rt.alloc); arm.store(&mut c, 5, 0)
    arm.mov(&mut c, 5, 0); arm.load(&mut c, 0); ld(&mut c, 4, 0, 48); arm.store(&mut c, 6, 4)
    arm.load_into(&mut c, 3, 6); shl(&mut c, 6, 6, 1)
    head := arm.label(&mut c); done := arm.label(&mut c)
    arm.mark(&mut c, head); ci(&mut c, 6, 0); arm.branch(&mut c, done, 2)
    ld(&mut c, 7, 4, 0); st(&mut c, 7, 5, 0); ai(&mut c, 4, 4, 8); ai(&mut c, 5, 5, 8); si(&mut c, 6, 6, 1); arm.branch(&mut c, head, 0)
    arm.mark(&mut c, done); arm.load(&mut c, 0); arm.load_into(&mut c, 5, 10); st(&mut c, 10, 0, 48)
    arm.load_into(&mut c, 7, 10); st(&mut c, 10, 0, 40)
    arm.load(&mut c, 6); call(&mut c, rt.release); arm.mark(&mut c, enough)
}
fn spawn(c: &mut arm.Code, rt: &runtime.Runtime, r: &Runtime) {
    // X0=Scope, X1=borrowed input bits, X2=immutable initialized Kind80.
    begin(&mut c, r.spawn, 8); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1); arm.store(&mut c, 2, 2)
    scope_check(&mut c, r.trap)
    ld(&mut c, 10, 0, 32); arm.imm(&mut c, 11, 2147483647); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 10); arm.store(&mut c, 3, 10)
    grow_index(&mut c, &rt, r.trap)
    arm.imm(&mut c, 0, 128); call(&mut c, rt.alloc); zero(&mut c, 0, 128); arm.store(&mut c, 4, 0)
    arm.load_into(&mut c, 2, 10); st(&mut c, 10, 0, 0)
    arm.load_into(&mut c, 3, 10); st(&mut c, 10, 0, 16)
    arm.load_into(&mut c, 0, 10); st(&mut c, 10, 0, 24)
    arm.load(&mut c, 2); ld(&mut c, 17, 0, 40); arm.load(&mut c, 1)
    copied := arm.label(&mut c); ci(&mut c, 17, 0); arm.branch(&mut c, copied, 2); indirect(&mut c)
    arm.mark(&mut c, copied); arm.load_into(&mut c, 4, 1); st(&mut c, 0, 1, 64)
    // Publish the unique Entry/snapshot owner in Scope before provider calls.
    arm.load(&mut c, 0); ld(&mut c, 1, 0, 48); arm.load_into(&mut c, 3, 10); shl(&mut c, 10, 10, 4); add(&mut c, 1, 1, 10)
    arm.load_into(&mut c, 4, 10); st(&mut c, 10, 1, 0)
    arm.load_into(&mut c, 2, 10); ld(&mut c, 10, 10, 8); st(&mut c, 10, 1, 8)
    arm.load_into(&mut c, 3, 10); ai(&mut c, 10, 10, 1); st(&mut c, 10, 0, 32)
    capacity := arm.label(&mut c); room := arm.label(&mut c)
    arm.mark(&mut c, capacity); arm.load(&mut c, 0); ld(&mut c, 10, 0, 24); ld(&mut c, 11, 0, 16)
    cmp(&mut c, 10, 11); arm.branch(&mut c, room, 5); call(&mut c, r.drain); arm.branch(&mut c, capacity, 0)
    arm.mark(&mut c, room); arm.load(&mut c, 4); callback(&mut c, 16); arm.branch(&mut c, r.trap, 19)
    arm.load(&mut c, 4); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 1); arm.branch(&mut c, r.trap, 3)
    arm.imm(&mut c, 10, 1); st(&mut c, 10, 0, 32)
    arm.load(&mut c, 0); ld(&mut c, 10, 0, 64); arm.load_into(&mut c, 4, 11)
    first := arm.label(&mut c); linked := arm.label(&mut c)
    ci(&mut c, 10, 0); arm.branch(&mut c, first, 2); st(&mut c, 11, 10, 8); arm.branch(&mut c, linked, 0)
    arm.mark(&mut c, first); st(&mut c, 11, 0, 56)
    arm.mark(&mut c, linked); st(&mut c, 11, 0, 64); ld(&mut c, 10, 0, 24); ai(&mut c, 10, 10, 1); st(&mut c, 10, 0, 24)
    ld(&mut c, 1, 0, 0); shl(&mut c, 1, 1, 32); arm.load(&mut c, 3); arm.emit(&mut c, 2852126720 + 1 * 32); arm.ret(&mut c)
}
fn drain(c: &mut arm.Code, r: &Runtime) {
    begin(&mut c, r.drain, 3); arm.store(&mut c, 0, 0); scope_check(&mut c, r.trap)
    head := arm.label(&mut c); active := arm.label(&mut c); tail := arm.label(&mut c)
    arm.mark(&mut c, head); arm.load(&mut c, 0); ld(&mut c, 0, 0, 56); arm.branch(&mut c, r.trap, 18)
    ld(&mut c, 10, 0, 32); ci(&mut c, 10, 0); arm.branch(&mut c, active, 3)
    ld(&mut c, 10, 0, 8); arm.load(&mut c, 0); st(&mut c, 10, 0, 56); arm.branch(&mut c, head, 0)
    arm.mark(&mut c, active); arm.store(&mut c, 1, 0); ld(&mut c, 10, 0, 8); arm.store(&mut c, 2, 10)
    callback(&mut c, 24); arm.branch(&mut c, r.trap, 19)
    arm.load(&mut c, 1); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 4); arm.branch(&mut c, r.trap, 3)
    inactive(&mut c, r.trap, 0, 1)
    arm.load_into(&mut c, 2, 10); st(&mut c, 10, 0, 56); ci(&mut c, 10, 0); arm.branch(&mut c, tail, 3); st(&mut c, 31, 0, 64)
    arm.mark(&mut c, tail); arm.imm(&mut c, 0, 0); arm.ret(&mut c)
}
fn await_result(c: &mut arm.Code, r: &Runtime) {
    begin(&mut c, r.await_result, 4); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1); arm.store(&mut c, 2, 2); scope_check(&mut c, r.trap)
    shr(&mut c, 10, 1, 32); ld(&mut c, 11, 0, 0); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3)
    arm.imm(&mut c, 11, 4294967295); arm.emit(&mut c, 2315255808 + 11 * 65536 + 1 * 32 + 10)
    arm.imm(&mut c, 11, 2147483647); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 10)
    ld(&mut c, 11, 0, 32); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 4)
    shl(&mut c, 10, 10, 4); ld(&mut c, 1, 0, 48); add(&mut c, 1, 1, 10)
    // Exact type is checked in the non-owning index BEFORE Entry is loaded.
    ld(&mut c, 10, 1, 8); arm.load_into(&mut c, 2, 11); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3)
    ld(&mut c, 0, 1, 0); arm.branch(&mut c, r.trap, 18); arm.store(&mut c, 3, 0)
    ld(&mut c, 10, 0, 24); arm.load_into(&mut c, 0, 11); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3)
    cached := arm.label(&mut c); cloned := arm.label(&mut c)
    ld(&mut c, 10, 0, 32); ci(&mut c, 10, 0); arm.branch(&mut c, cached, 2)
    callback(&mut c, 24); arm.branch(&mut c, r.trap, 19); inactive(&mut c, r.trap, 0, 3)
    arm.mark(&mut c, cached); arm.load(&mut c, 3); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 4); arm.branch(&mut c, r.trap, 3)
    ld(&mut c, 17, 0, 0); ld(&mut c, 17, 17, 56); ld(&mut c, 0, 0, 88)
    ci(&mut c, 17, 0); arm.branch(&mut c, cloned, 2); indirect(&mut c)
    arm.mark(&mut c, cloned); arm.ret(&mut c)
}
fn index_entry(c: &mut arm.Code) {
    arm.load(&mut c, 0); ld(&mut c, 1, 0, 48); arm.load_into(&mut c, 1, 10); shl(&mut c, 10, 10, 4); add(&mut c, 1, 1, 10); ld(&mut c, 0, 1, 0)
}
fn close(c: &mut arm.Code, rt: &runtime.Runtime, r: &Runtime) {
    // close(0) is harmless for an unentered lexical scope. A nonzero Scope is
    // consumed once; no copied source handle points directly to this storage.
    begin(&mut c, r.close, 4); arm.store(&mut c, 0, 0)
    done := arm.label(&mut c); arm.branch(&mut c, done, 18); scope_check(&mut c, r.trap)
    arm.store(&mut c, 1, 31)
    join_head := arm.label(&mut c); join_next := arm.label(&mut c); drops := arm.label(&mut c)
    arm.mark(&mut c, join_head); arm.load(&mut c, 0); ld(&mut c, 10, 0, 32); arm.load_into(&mut c, 1, 11); cmp(&mut c, 11, 10); arm.branch(&mut c, drops, 4)
    index_entry(&mut c); arm.store(&mut c, 2, 0); ld(&mut c, 10, 0, 32); ci(&mut c, 10, 0); arm.branch(&mut c, join_next, 2)
    callback(&mut c, 32); arm.branch(&mut c, r.trap, 19)
    arm.load(&mut c, 2); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 8); arm.branch(&mut c, r.trap, 3)
    inactive(&mut c, r.trap, 0, 2)
    arm.mark(&mut c, join_next); arm.load(&mut c, 1); ai(&mut c, 0, 0, 1); arm.store(&mut c, 1, 0); arm.branch(&mut c, join_head, 0)
    // Only after ALL joins/reclaims succeed may any parent-owned root drop.
    arm.mark(&mut c, drops); arm.load(&mut c, 0); ld(&mut c, 10, 0, 24); ci(&mut c, 10, 0); arm.branch(&mut c, r.trap, 3); arm.store(&mut c, 1, 31)
    drop_head := arm.label(&mut c); drop_done := arm.label(&mut c)
    arm.mark(&mut c, drop_head); arm.load(&mut c, 0); ld(&mut c, 10, 0, 32); arm.load_into(&mut c, 1, 11); cmp(&mut c, 11, 10); arm.branch(&mut c, drop_done, 4)
    index_entry(&mut c); arm.store(&mut c, 2, 0); ld(&mut c, 10, 0, 0); arm.store(&mut c, 3, 10)
    input_done := arm.label(&mut c); result_done := arm.label(&mut c)
    ld(&mut c, 17, 10, 48); ld(&mut c, 0, 0, 64); ci(&mut c, 17, 0); arm.branch(&mut c, input_done, 2); indirect(&mut c)
    arm.mark(&mut c, input_done); arm.load(&mut c, 2); st(&mut c, 31, 0, 64); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 4); arm.branch(&mut c, result_done, 3)
    arm.load_into(&mut c, 3, 10); ld(&mut c, 17, 10, 64); ld(&mut c, 0, 0, 88); ci(&mut c, 17, 0); arm.branch(&mut c, result_done, 2); indirect(&mut c)
    arm.mark(&mut c, result_done); arm.load(&mut c, 2); st(&mut c, 31, 0, 88); call(&mut c, rt.release)
    arm.load(&mut c, 1); ai(&mut c, 0, 0, 1); arm.store(&mut c, 1, 0); arm.branch(&mut c, drop_head, 0)
    arm.mark(&mut c, drop_done); arm.load(&mut c, 0); ld(&mut c, 0, 0, 48); call(&mut c, rt.release)
    arm.load(&mut c, 0); arm.imm(&mut c, 10, 2); st(&mut c, 10, 0, 8); call(&mut c, rt.release)
    arm.mark(&mut c, done); arm.imm(&mut c, 0, 0); arm.ret(&mut c)
}
fn label_valid(c: &arm.Code, label: i32, optional: bool) -> bool {
    if optional && label == -1 { return true }; label >= 0 && label < arm.label_count(&c)
}
pub fn emit_runtime(c: &mut arm.Code, rt: &runtime.Runtime, trap: i32) -> Runtime {
    var r := Runtime { ok: false, error: "", open: -1, spawn: -1, drain: -1, await_result: -1, close: -1, trap: trap }
    if !native.supported(c.platform, c.profile) || c.checking || c.mir_capture { r.error = "isolated task scopes require unprofiled ARM64/macOS outside source MIR"; return r }
    if !label_valid(&c, trap, false) || !label_valid(&c, rt.alloc, false) || !label_valid(&c, rt.release, false) { r.error = "invalid task scope runtime labels"; return r }
    r.open = arm.label(&mut c); r.spawn = arm.label(&mut c); r.drain = arm.label(&mut c); r.await_result = arm.label(&mut c); r.close = arm.label(&mut c)
    open(&mut c, &rt, &r); spawn(&mut c, &rt, &r); drain(&mut c, &r); await_result(&mut c, &r); close(&mut c, &rt, &r)
    r.ok = true; r
}

fn recycle_entry(c: &mut arm.Code, rt: &runtime.Runtime, trap: i32, unmap_pool: i32, scope_slot: i32, entry_slot: i32) {
    arm.load(&mut c, entry_slot); ld(&mut c, 10, 0, 0); ld(&mut c, 17, 10, 48); ld(&mut c, 0, 0, 64)
    snap_done := arm.label(&mut c); ci(&mut c, 17, 0); arm.branch(&mut c, snap_done, 2)
    arm.branch(&mut c, snap_done, 18); indirect(&mut c)
    arm.mark(&mut c, snap_done); arm.load(&mut c, entry_slot); st(&mut c, 31, 0, 64)
    ld(&mut c, 10, 0, 120); pool_done := arm.label(&mut c); ci(&mut c, 10, 0); arm.branch(&mut c, pool_done, 2)
    st(&mut c, 31, 0, 120)
    arm.load(&mut c, scope_slot); ld(&mut c, 11, 0, 88)
    full := arm.label(&mut c); has_buf := arm.label(&mut c)
    ci(&mut c, 11, 64); arm.branch(&mut c, full, 4)
    ld(&mut c, 12, 0, 80); ci(&mut c, 12, 0); arm.branch(&mut c, has_buf, 3)
    arm.load_into(&mut c, entry_slot, 13); st(&mut c, 10, 13, 120)
    arm.imm(&mut c, 0, 512); call(&mut c, rt.alloc); arm.mov(&mut c, 12, 0)
    arm.load(&mut c, scope_slot); st(&mut c, 12, 0, 80); ld(&mut c, 11, 0, 88)
    arm.load_into(&mut c, entry_slot, 13); ld(&mut c, 10, 13, 120); st(&mut c, 31, 13, 120)
    arm.mark(&mut c, has_buf)
    shl(&mut c, 13, 11, 3); add(&mut c, 13, 12, 13); st(&mut c, 10, 13, 0)
    ai(&mut c, 11, 11, 1); arm.load(&mut c, scope_slot); st(&mut c, 11, 0, 88)
    arm.branch(&mut c, pool_done, 0)
    arm.mark(&mut c, full); arm.mov(&mut c, 0, 10); call(&mut c, unmap_pool); arm.branch(&mut c, trap, 19)
    arm.mark(&mut c, pool_done)
}

fn spawn_pooled(c: &mut arm.Code, rt: &runtime.Runtime, r: &Runtime) {
    begin(&mut c, r.spawn, 8); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1); arm.store(&mut c, 2, 2)
    scope_check(&mut c, r.trap)
    ld(&mut c, 10, 0, 32); arm.imm(&mut c, 11, 2147483647); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 10); arm.store(&mut c, 3, 10)
    grow_index(&mut c, &rt, r.trap)
    arm.imm(&mut c, 0, 128); call(&mut c, rt.alloc); zero(&mut c, 0, 128); arm.store(&mut c, 4, 0)
    arm.load_into(&mut c, 2, 10); st(&mut c, 10, 0, 0)
    arm.load_into(&mut c, 3, 10); st(&mut c, 10, 0, 16)
    arm.load_into(&mut c, 0, 10); st(&mut c, 10, 0, 24)
    arm.load(&mut c, 2); ld(&mut c, 17, 0, 40); arm.load(&mut c, 1)
    copied := arm.label(&mut c); ci(&mut c, 17, 0); arm.branch(&mut c, copied, 2); indirect(&mut c)
    arm.mark(&mut c, copied); arm.load_into(&mut c, 4, 1); st(&mut c, 0, 1, 64)
    arm.load(&mut c, 0); ld(&mut c, 1, 0, 48); arm.load_into(&mut c, 3, 10); shl(&mut c, 10, 10, 4); add(&mut c, 1, 1, 10)
    arm.load_into(&mut c, 4, 10); st(&mut c, 10, 1, 0)
    arm.load_into(&mut c, 2, 10); ld(&mut c, 10, 10, 8); st(&mut c, 10, 1, 8)
    arm.load_into(&mut c, 3, 10); ai(&mut c, 10, 10, 1); st(&mut c, 10, 0, 32)
    capacity := arm.label(&mut c); room := arm.label(&mut c); no_cached := arm.label(&mut c)
    arm.mark(&mut c, capacity); arm.load(&mut c, 0); ld(&mut c, 10, 0, 24); ld(&mut c, 11, 0, 16)
    cmp(&mut c, 10, 11); arm.branch(&mut c, room, 5); call(&mut c, r.drain); arm.branch(&mut c, capacity, 0)
    arm.mark(&mut c, room)
    arm.load(&mut c, 0); ld(&mut c, 11, 0, 88); ci(&mut c, 11, 0); arm.branch(&mut c, no_cached, 2)
    si(&mut c, 11, 11, 1); st(&mut c, 11, 0, 88); ld(&mut c, 12, 0, 80)
