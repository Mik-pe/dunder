    arm.mark(&mut c, tail); arm.imm(&mut c, 0, 0); arm.ret(&mut c)
}

fn await_result_pooled(c: &mut arm.Code, rt: &runtime.Runtime, r: &Runtime, unmap_pool: i32) {
    begin(&mut c, r.await_result, 4); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1); arm.store(&mut c, 2, 2); scope_check(&mut c, r.trap)
    shr(&mut c, 10, 1, 32); ld(&mut c, 11, 0, 0); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3)
    arm.imm(&mut c, 11, 4294967295); arm.emit(&mut c, 2315255808 + 11 * 65536 + 1 * 32 + 10)
    arm.imm(&mut c, 11, 2147483647); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 10)
    ld(&mut c, 11, 0, 32); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 4)
    shl(&mut c, 10, 10, 4); ld(&mut c, 1, 0, 48); add(&mut c, 1, 1, 10)
    ld(&mut c, 10, 1, 8); arm.load_into(&mut c, 2, 11); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3)
    ld(&mut c, 0, 1, 0); arm.branch(&mut c, r.trap, 18); arm.store(&mut c, 3, 0)
    ld(&mut c, 10, 0, 24); arm.load_into(&mut c, 0, 11); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3)
    cached := arm.label(&mut c); cloned := arm.label(&mut c)
    ld(&mut c, 10, 0, 32); ci(&mut c, 10, 0); arm.branch(&mut c, cached, 2)
    callback(&mut c, 24); arm.branch(&mut c, r.trap, 19); inactive(&mut c, r.trap, 0, 3)
    recycle_entry(&mut c, &rt, r.trap, unmap_pool, 0, 3)
    arm.mark(&mut c, cached); arm.load(&mut c, 3); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 4); arm.branch(&mut c, r.trap, 3)
    ld(&mut c, 17, 0, 0); ld(&mut c, 17, 17, 56); ld(&mut c, 0, 0, 88)
    ci(&mut c, 17, 0); arm.branch(&mut c, cloned, 2); indirect(&mut c)
    arm.mark(&mut c, cloned); arm.ret(&mut c)
}

fn close_pooled(c: &mut arm.Code, rt: &runtime.Runtime, r: &Runtime, unmap_pool: i32) {
    begin(&mut c, r.close, 4); arm.store(&mut c, 0, 0)
    done := arm.label(&mut c); arm.branch(&mut c, done, 18); scope_check(&mut c, r.trap)
    arm.store(&mut c, 1, 31)
    join_head := arm.label(&mut c); join_next := arm.label(&mut c); drops := arm.label(&mut c)
    arm.mark(&mut c, join_head); arm.load(&mut c, 0); ld(&mut c, 10, 0, 32); arm.load_into(&mut c, 1, 11); cmp(&mut c, 11, 10); arm.branch(&mut c, drops, 4)
    index_entry(&mut c); arm.store(&mut c, 2, 0); ld(&mut c, 10, 0, 32); ci(&mut c, 10, 0); arm.branch(&mut c, join_next, 2)
    callback(&mut c, 32); arm.branch(&mut c, r.trap, 19)
    arm.load(&mut c, 2); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 8); arm.branch(&mut c, r.trap, 3)
    inactive(&mut c, r.trap, 0, 2)
    arm.mark(&mut c, join_next); arm.load(&mut c, 1); ai(&mut c, 0, 0, 1); arm.store(&mut c, 1, 0); arm.branch(&mut c, join_head, 0)
    arm.mark(&mut c, drops); arm.load(&mut c, 0); ld(&mut c, 10, 0, 24); ci(&mut c, 10, 0); arm.branch(&mut c, r.trap, 3); arm.store(&mut c, 1, 31)
    drop_head := arm.label(&mut c); drop_done := arm.label(&mut c)
    arm.mark(&mut c, drop_head); arm.load(&mut c, 0); ld(&mut c, 10, 0, 32); arm.load_into(&mut c, 1, 11); cmp(&mut c, 11, 10); arm.branch(&mut c, drop_done, 4)
    index_entry(&mut c); arm.store(&mut c, 2, 0); ld(&mut c, 10, 0, 0); arm.store(&mut c, 3, 10)
    input_done := arm.label(&mut c); result_done := arm.label(&mut c); entry_pool_done := arm.label(&mut c)
    ld(&mut c, 17, 10, 48); ld(&mut c, 0, 0, 64); ci(&mut c, 17, 0); arm.branch(&mut c, input_done, 2)
    arm.branch(&mut c, input_done, 18); indirect(&mut c)
    arm.mark(&mut c, input_done); arm.load(&mut c, 2); st(&mut c, 31, 0, 64); ld(&mut c, 10, 0, 48); ci(&mut c, 10, 4); arm.branch(&mut c, result_done, 3)
    arm.load_into(&mut c, 3, 10); ld(&mut c, 17, 10, 64); ld(&mut c, 0, 0, 88); ci(&mut c, 17, 0); arm.branch(&mut c, result_done, 2); indirect(&mut c)
    arm.mark(&mut c, result_done); arm.load(&mut c, 2); st(&mut c, 31, 0, 88)
    ld(&mut c, 0, 0, 120); arm.branch(&mut c, entry_pool_done, 18)
    arm.load_into(&mut c, 2, 10); st(&mut c, 31, 10, 120); call(&mut c, unmap_pool); arm.branch(&mut c, r.trap, 19)
    arm.mark(&mut c, entry_pool_done); arm.load(&mut c, 2); call(&mut c, rt.release)
    arm.load(&mut c, 1); ai(&mut c, 0, 0, 1); arm.store(&mut c, 1, 0); arm.branch(&mut c, drop_head, 0)
    arm.mark(&mut c, drop_done)
    pool_loop := arm.label(&mut c); pools_done := arm.label(&mut c)
    arm.mark(&mut c, pool_loop); arm.load(&mut c, 0); ld(&mut c, 11, 0, 88); ci(&mut c, 11, 0); arm.branch(&mut c, pools_done, 2)
    si(&mut c, 11, 11, 1); st(&mut c, 11, 0, 88); ld(&mut c, 12, 0, 80)
    shl(&mut c, 13, 11, 3); add(&mut c, 13, 12, 13); ld(&mut c, 0, 13, 0); st(&mut c, 31, 13, 0)
    call(&mut c, unmap_pool); arm.branch(&mut c, r.trap, 19); arm.branch(&mut c, pool_loop, 0)
    arm.mark(&mut c, pools_done); arm.load(&mut c, 0); ld(&mut c, 0, 0, 80); call(&mut c, rt.release)
    arm.load(&mut c, 0); ld(&mut c, 0, 0, 48); call(&mut c, rt.release)
    arm.load(&mut c, 0); arm.imm(&mut c, 10, 2); st(&mut c, 10, 0, 8); call(&mut c, rt.release)
