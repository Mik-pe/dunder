fn drain_pooled(c: &mut arm.Code, rt: &runtime.Runtime, r: &Runtime, unmap_pool: i32) {
    begin(&mut c, r.drain, 3); arm.store(&mut c, 0, 0); scope_check(&mut c, r.trap)
