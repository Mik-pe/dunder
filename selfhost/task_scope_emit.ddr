pub fn emit_pooled_runtime(c: &mut arm.Code, rt: &runtime.Runtime, trap: i32, unmap_pool: i32) -> Runtime {
    var r := Runtime { ok: false, error: "", open: -1, spawn: -1, drain: -1, await_result: -1, close: -1, trap: trap }
    if !native.supported(c.platform, c.profile) || c.checking || c.mir_capture { r.error = "isolated task scopes require unprofiled ARM64/macOS outside source MIR"; return r }
    if !label_valid(&c, trap, false) || !label_valid(&c, rt.alloc, false) || !label_valid(&c, rt.release, false) || !label_valid(&c, unmap_pool, false) { r.error = "invalid task scope runtime labels"; return r }
    r.open = arm.label(&mut c); r.spawn = arm.label(&mut c); r.drain = arm.label(&mut c); r.await_result = arm.label(&mut c); r.close = arm.label(&mut c)
    open(&mut c, &rt, &r); spawn_pooled(&mut c, &rt, &r); drain_pooled(&mut c, &rt, &r, unmap_pool); await_result_pooled(&mut c, &rt, &r, unmap_pool); close_pooled(&mut c, &rt, &r, unmap_pool)
    r.ok = true; r
}
// The producer owns a FRESH, UNIQUE zeroed80B static_slot for each Kind and
// never reuses it for different callbacks, even when result types agree. The
// slot uses existing negative writable-global relocation syntax (-1-offset).
// Emit the helper body outside source MIR/cache fragments (normally prefix).
pub fn emit_kind(c: &mut arm.Code, r: &Runtime, spec: &KindSpec, static_slot: i32) -> Kind {
    var k := Kind { ok: false, error: "", spawn: -1, import_sites: [], import_slots: [] }
    if !native.supported(c.platform, c.profile) || c.checking || c.mir_capture || !r.ok { k.error = "unsupported task scope kind emission"; return k }
    if static_slot >= 0 || (-1 - static_slot) % 16 != 0 || -1 - static_slot > 2147483567 || spec.result_type < 0 ||
        !label_valid(&c, r.spawn, false) || !label_valid(&c, r.trap, false) ||
        !label_valid(&c, spec.create, false) || !label_valid(&c, spec.collect, false) || !label_valid(&c, spec.discard, false) ||
        !label_valid(&c, spec.input_clone, true) || !label_valid(&c, spec.input_drop, true) ||
        !label_valid(&c, spec.result_clone, true) || !label_valid(&c, spec.result_drop, true) { k.error = "invalid task scope kind specification"; return k }
    k.spawn = arm.label(&mut c); begin(&mut c, k.spawn, 3); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1)
    k.import_sites.push(arm.position(&c) * 4); k.import_slots.push(static_slot); arm.emit(&mut c, 0); arm.emit(&mut c, 0)
    arm.store(&mut c, 2, 16); ld(&mut c, 10, 16, 0)
    fresh := arm.label(&mut c); ready := arm.label(&mut c)
    ci(&mut c, 10, 0); arm.branch(&mut c, fresh, 2); ci(&mut c, 10, 1); arm.branch(&mut c, r.trap, 3)
    ld(&mut c, 10, 16, 8); arm.imm(&mut c, 11, i64(spec.result_type)); cmp(&mut c, 10, 11); arm.branch(&mut c, r.trap, 3); arm.branch(&mut c, ready, 0)
    arm.mark(&mut c, fresh); arm.imm(&mut c, 0, i64(spec.result_type)); st(&mut c, 0, 16, 8)
    for field in 0..7 {
        var target := spec.create
        if field == 1 { target = spec.collect } else if field == 2 { target = spec.discard }
        else if field == 3 { target = spec.input_clone } else if field == 4 { target = spec.input_drop }
        else if field == 5 { target = spec.result_clone } else if field == 6 { target = spec.result_drop }
        if target < 0 { arm.imm(&mut c, 0, 0) } else { arm.branch(&mut c, target, 20) }
        arm.load_into(&mut c, 2, 16); st(&mut c, 0, 16, 16 + field * 8)
    }
    arm.imm(&mut c, 0, 1); st(&mut c, 0, 16, 0)
    arm.mark(&mut c, ready); arm.load_into(&mut c, 2, 2); arm.load_into(&mut c, 1, 1); arm.load(&mut c, 0); call(&mut c, r.spawn); arm.ret(&mut c)
    k.ok = true; k
}
