// Canonical contracts used by verification and optional analyses. These checks
// use operation semantics; original ARM encodings are never proof inputs.
import mir

fn frame_part(f: &mir.Function, op: i32, dst: i32, source: i32, opcode: i32) -> bool {
    f.modes[op] != 2 && f.kinds[op] == 16 && f.opcodes[op] == opcode && f.types[op] == 2 &&
        f.dst[op] == dst && f.a[op] == source && f.b[op] == -1 && f.c[op] == -1 && f.imm[op] >= 0
}
pub fn frame_capacity(f: &mir.Function) -> i64 {
    if f.order.len < 4 { return -1 }
    enter := f.order[0]; setup := f.order[1]; high := f.order[2]; low := f.order[3]
    if enter < 0 || setup < 0 || high < 0 || low < 0 || enter >= f.kinds.len || setup >= f.kinds.len ||
        high >= f.kinds.len || low >= f.kinds.len { return -1 }
    if f.modes[enter] == 2 || f.kinds[enter] != 21 || f.opcodes[enter] != 1 || f.imm[enter] != -16 ||
        !frame_part(&f, setup, 29, 31, 1) || f.imm[setup] != 0 ||
        !frame_part(&f, high, 31, 31, 2) || !frame_part(&f, low, 31, 31, 2) { return -1 }
    if f.imm[high] > 16777200 || f.imm[low] > 16777200 { return -1 }
    size := f.imm[high] + f.imm[low]
    if size > 16777200 || size % 16 != 0 { return -1 }; size
}
pub fn frame_place_proven(f: &mir.Function, place: i32) -> bool {
    if place < 0 || place >= f.place_kinds.len || f.place_kinds[place] != 1 || f.place_escaped[place] { return false }
    size := frame_capacity(&f); if size < 0 { return false }
    offset := i64(f.place_offsets[place]); width := i64(f.place_widths[place])
    width > 0 && offset >= -size && offset <= -width
}
fn pointer_value(variable: i32) -> bool { variable == 29 || variable == 31 }
pub fn exposes_frame(f: &mir.Function, op: i32) -> bool {
    kind := f.kinds[op]
    if kind == 16 {
        if f.dst[op] != 29 { return false }
        // Only the unique entry FP=SP is an implicit frame-state operation.
        return f.order.len < 2 || f.order[1] != op || f.opcodes[op] != 1 || f.a[op] != 31 || f.imm[op] != 0
    }
    if kind == 21 { return false }
    if f.writes[op].bit_and(mir.variable_bit(29)) != 0 { return true }
    if kind == 7 { return pointer_value(f.b[op]) || pointer_value(f.c[op]) }
    if kind == 8 { return pointer_value(f.a[op]) || pointer_value(f.c[op]) }
    if kind == 10 { return pointer_value(f.a[op]) || pointer_value(f.c[op]) }
    if kind == 11 { return pointer_value(f.b[op]) || pointer_value(f.c[op]) }
    pointer_value(f.a[op]) || pointer_value(f.b[op]) || pointer_value(f.c[op])
}
pub fn memory_scratch(offset: i64, width: i32) -> bool {
    if offset >= -256 && offset <= 255 { return false }
    !(offset >= 0 && width > 0 && offset % i64(width) == 0 && offset / i64(width) <= 4095)
}
fn plain(f: &mir.Function, op: i32) -> bool {
    f.flags[op] == 0 && f.abi[op] == 0 && f.reloc_kinds[op] == -1 && f.targets[op] == -1 && f.import_ids[op] == -1
}
pub fn canonical(f: &mir.Function, op: i32) -> bool {
    kind := f.kinds[op]; dst := f.dst[op]; a := f.a[op]; b := f.b[op]; c := f.c[op]; ty := f.types[op]
    if !plain(&f, op) || f.opcodes[op] < 0 { return false }
    if kind == 1 || kind == 2 {
        if dst < 0 || dst > 30 || (ty != 1 && ty != 2) || b != -1 || c != -1 ||
            f.place[op] != -1 || f.extensions[op] != 0 || f.opcodes[op] != 0 || f.aux[op] != 0 ||
            f.effects[op] != 0 || f.clobbers[op] != 0 || f.writes[op] != mir.variable_bit(dst) { return false }
        if kind == 1 {
            if a != -1 || f.reads[op] != 0 { return false }
            if ty == 1 && (f.imm[op] < -2147483648 || f.imm[op] > 4294967295) { return false }; return true
        }
        a >= -1 && a <= 30 && f.imm[op] == 0 && f.reads[op] == mir.variable_bit(a)
    } else if kind == 16 {
        (ty == 2 && (dst == 29 || dst == 31) && (a == 29 || a == 31) && b == -1 && c == -1 &&
            (f.opcodes[op] == 1 || f.opcodes[op] == 2) && f.imm[op] >= 0 && f.imm[op] <= 2147483647 &&
            (dst != 31 || f.imm[op] % 16 == 0) && f.aux[op] == 0 && f.place[op] == -1 && f.extensions[op] == 0 &&
            f.effects[op] == 32 && f.reads[op] == mir.variable_bit(a) && f.writes[op] == mir.variable_bit(dst) && f.clobbers[op] == 0)
    } else if kind == 7 || kind == 8 {
        p := f.place[op]; width := f.aux[op]; offset := f.imm[op]; extension := f.extensions[op]
        if p < 0 || p >= f.place_kinds.len || f.opcodes[op] != 0 ||
            (width != 1 && width != 2 && width != 4 && width != 8) ||
            f.place_widths[p] != width || i64(f.place_offsets[p]) != offset { return false }
        var value := a; var base := b; var reads: i64 = 0; var writes: i64 = 0
        if kind == 7 {
            value = dst; base = a
            if b != -1 || value < -1 || value > 30 { return false }
            if width == 8 { if extension != 0 || ty != 2 { return false } }
            else if extension == 2 { if width != 4 || ty != 2 { return false } }
            else if extension != 1 || ty != 1 { return false }
            writes = mir.variable_bit(value)
        } else {
            if dst != -1 || value < -1 || value > 30 || extension != 0 ||
                (width == 8 && ty != 2) || (width != 8 && ty != 1) { return false }
            reads = mir.variable_bit(value)
        }
        if base < 0 || base > 31 || (f.place_kinds[p] == 1 && base != 29) || (f.place_kinds[p] == 2 && base != 31) { return false }
        reads = reads.bit_or(mir.variable_bit(base)); var clobbers: i64 = 0
        if memory_scratch(offset, width) {
            if c < 0 || c > 30 || c == base || (kind == 8 && c == value) { return false }
            writes = writes.bit_or(mir.variable_bit(c)); clobbers = mir.variable_bit(c)
        } else if c != -1 { return false }
        var effects := 3; if kind == 8 { effects = 5 }
        if frame_place_proven(&f, p) { effects = effects - 1 }
        f.effects[op] == effects && f.reads[op] == reads && f.writes[op] == writes && f.clobbers[op] == clobbers
    } else { false }
}
