// Operations 1..11 follow scalar_rules.opcode. The source width remains
// explicit even when a predicate returns bool or to_bits returns an integer.
pub fn method(name: string) -> i32 {
    if name == "to_bits" { return 12 }; if name == "is_sign_negative" { return 13 }
    if name == "abs" { return 14 }; if name == "sqrt" { return 15 }
    if name == "floor" { return 16 }; if name == "ceil" { return 17 }
    if name == "round" { return 18 }; if name == "round_ties_even" { return 19 }
    if name == "trunc" { return 20 }; if name == "negate" { return 21 }
    if name == "is_nan" { return 22 }; if name == "is_finite" { return 23 }
    if name == "is_infinite" { return 24 }; 0
}
pub fn supported(op: i32, ty: i32) -> bool {
    (ty == 6 || ty == 7) && op >= 1 && op <= 24 && op != 5
}
pub fn result(op: i32, ty: i32) -> i32 {
    if (op >= 6 && op <= 11) || op == 13 || op >= 22 { return 3 }
    if op == 12 { if ty == 6 { return 1 }; return 2 }
    ty
}
pub fn cell(op: i32, ty: i32, offset: i32) -> i64 {
    i64(61).shl(56).bit_or(i64(ty).shl(48)).bit_or(i64(op).shl(32)).bit_or(i64(offset))
}
pub fn reads(op: i32) -> i64 { if op < 12 { return 3 }; 1 }
pub fn writes(op: i32) -> i64 {
    // x0 is the result, v0/v1 are private scratch for IEEE evaluation.
    if op == 12 || op == 13 { return 1 }
    if op < 12 { return 12884901889 }
    if op >= 23 { return 12884901891 }
    4294967297
}
pub fn flags(op: i32) -> i32 {
    if (op >= 6 && op <= 11) || op >= 22 { return 2 }; 0
}
