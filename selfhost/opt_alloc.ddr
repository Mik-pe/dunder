// Conservative live intervals over structured, call-free scalar source.
// Locals touched by a loop span the whole outer loop, including its backedge.
// Every value retains a frame home; twelve caller-clobbered registers are
// assigned only to disjoint intervals. Runtime globals and x18 are untouched.
import opt_ir as ir

pub struct Plan {
    homes: []i32, first: []i32, last: []i32, loop: []i32,
    data: []i32, length: []i32, limits: []i32, loop_end: []i32, clock: i32,
    // Empty means the ordinary local-ID frame layout. A nonempty map names
    // the physical caller-frame slot for every value that may be spilled.
    frame_slots: []i32,
}
fn value(p: &mut Plan) -> i32 {
    id := p.homes.len
    p.homes.push(-1); p.first.push(-1); p.last.push(-1); p.loop.push(-1)
    id
}
fn touch(p: &mut Plan, id: i32, parameter: bool, outer: i32, begin: i32) {
    if id < 0 { return }
    var first := p.clock
    if parameter { first = 0 } else if outer >= 0 { first = begin }
    if p.first[id] < 0 || first < p.first[id] { p.first[id] = first }
    p.last[id] = p.clock
    if outer >= 0 { p.loop[id] = outer }
}
fn walk(p: &mut Plan, f: &ir.Function, node: i32, outer: i32, begin: i32) {
    if node < 0 { return }
    p.clock = p.clock + 1
    kind := f.nodes.kinds[node]
    local := f.nodes.locals[node]
    if kind == 2 { touch(&mut p, local, f.local_param[local] >= 0, outer, begin) }
    else if kind == 5 || kind == 6 || kind == 18 {
        if kind == 6 || kind == 18 { walk(&mut p, &f, f.nodes.left[node], outer, begin); touch(&mut p, p.data[local], true, outer, begin) }
        touch(&mut p, p.length[local], true, outer, begin)
        if kind == 18 { walk(&mut p, &f, f.nodes.right[node], outer, begin) }
    } else if kind == 3 {
        walk(&mut p, &f, f.nodes.left[node], outer, begin); walk(&mut p, &f, f.nodes.right[node], outer, begin)
    } else if kind == 4 || kind == 15 { walk(&mut p, &f, f.nodes.left[node], outer, begin) }
    else if kind == 10 {
        var at := f.nodes.left[node]
        while at >= 0 { walk(&mut p, &f, at, outer, begin); at = f.nodes.next[at] }
    } else if kind == 11 || kind == 12 {
        walk(&mut p, &f, f.nodes.left[node], outer, begin)
        touch(&mut p, local, f.local_param[local] >= 0, outer, begin)
    } else if kind == 13 {
        walk(&mut p, &f, f.nodes.left[node], outer, begin)
        walk(&mut p, &f, f.nodes.right[node], outer, begin); walk(&mut p, &f, f.nodes.third[node], outer, begin)
    } else if kind == 14 {
        var owner := outer; var start := begin
        if owner < 0 { owner = node; start = p.clock }
        walk(&mut p, &f, f.nodes.left[node], owner, start); walk(&mut p, &f, f.nodes.right[node], owner, start)
        p.loop_end[node] = p.clock
    } else if kind == 19 {
        // Bounds belong to the enclosing scope and execute once before the
        // new iterator/limit are stored. They may refer to a shadowed local.
        walk(&mut p, &f, f.nodes.left[node], outer, begin); walk(&mut p, &f, f.nodes.right[node], outer, begin)
        p.clock = p.clock + 1
        var owner := outer; var start := begin
        if owner < 0 { owner = node; start = p.clock }
        touch(&mut p, local, false, owner, start); touch(&mut p, p.limits[node], false, owner, start)
        walk(&mut p, &f, f.nodes.third[node], owner, start)
        p.clock = p.clock + 1
        touch(&mut p, local, false, owner, start); touch(&mut p, p.limits[node], false, owner, start)
        p.loop_end[node] = p.clock
    }
    p.clock = p.clock + 1
}
pub fn new() -> Plan { Plan { homes: [], first: [], last: [], loop: [], data: [], length: [], limits: [], loop_end: [], clock: 0, frame_slots: [] } }
pub fn allocate_into(p: &mut Plan, f: &ir.Function) {
    p.homes.clear(); p.first.clear(); p.last.clear(); p.loop.clear(); p.data.clear(); p.length.clear(); p.limits.clear(); p.loop_end.clear(); p.clock = 0
    p.frame_slots.clear()
    for i in 0..f.local_types.len { added := value(&mut p); p.data.push(-1); p.length.push(-1) }
    for i in 0..f.local_types.len {
        if ir.array_type(f.local_types[i]) { data := value(&mut p); length := value(&mut p); p.data[i] = data; p.length[i] = length }
    }
    for i in 0..f.nodes.kinds.len {
        p.loop_end.push(-1); var limit := -1
        if f.nodes.kinds[i] == 19 { limit = value(&mut p) }
        p.limits.push(limit)
    }
    walk(&mut p, &f, f.root, -1, 0)
    for id in 0..p.homes.len {
        loop := p.loop[id]
        if loop >= 0 && p.loop_end[loop] > p.last[id] { p.last[id] = p.loop_end[loop] }
    }
    // Counting buckets keep interval ordering linear, including equal starts
    // for parameters and array caches. No repeated sort or fixed-point pass.
    var heads: []i32 = []; var links: []i32 = []
    for i in 0..p.clock + 1 { heads.push(-1) }
    for id in 0..p.homes.len { links.push(-1) }
    var id := p.homes.len - 1
    while id >= 0 {
        if p.first[id] >= 0 { links[id] = heads[p.first[id]]; heads[p.first[id]] = id }
        id = id - 1
    }
    registers := [4, 5, 6, 7, 10, 11, 12, 13, 14, 15, 16, 17]
    var active: []i32 = []
    for reg in registers { active.push(-1) }
    for position in 0..heads.len {
        var current := heads[position]
        while current >= 0 {
            var free := -1; var farthest := -1
            for r in 0..active.len {
                old := active[r]
                if old < 0 || p.last[old] < position { if free < 0 { free = r } }
                else if farthest < 0 || p.last[old] > p.last[active[farthest]] { farthest = r }
            }
            if free < 0 && farthest >= 0 && p.last[active[farthest]] > p.last[current] {
                p.homes[active[farthest]] = -1; free = farthest
            }
            if free >= 0 { active[free] = current; p.homes[current] = registers[free] }
            current = links[current]
        }
    }
}
pub fn allocate(f: &ir.Function) -> Plan { var p := new(); allocate_into(&mut p, &f); p }
