pub enum Operation {
    ArrayNew, ArrayInitializeElement, ArrayPush, ArrayReserve, ArrayPop, ArrayClear,
    Concat, Compare, Slice, Bytes, Runes, NextRune, Format, Print, CheckRune, RegionNew, ArrayRemove, FormatInteger, FormatString, ArrayTruncate, ArrayTryReserve
}
pub fn types(input: i32, result: i32) -> i64 { i64(result).shl(32).bit_or(i64(input)) }
pub fn input(pair: i64) -> i32 { i32(pair.bit_and(2147483647)) }
pub fn result(pair: i64) -> i32 { i32(pair.shr(32)) }
pub fn valid(op: i32, layout: i32, input: i32, result: i32) -> bool {
    if op < 0 || op > i32(Operation.ArrayTryReserve) || input < 1 || result < 0 ||
        layout < 0 || layout > 3 || (op != i32(Operation.ArrayNew) && layout != 0) { return false }
    if op == i32(Operation.RegionNew) { return input == 1 && result > 13 }
    if op == i32(Operation.ArrayNew) { return result > 13 }
    if op == i32(Operation.ArrayTryReserve) { return input > 13 && result > 13 }
    if op == i32(Operation.ArrayInitializeElement) { return result == 0 }
    if op == i32(Operation.ArrayPop) || op == i32(Operation.ArrayRemove) { return input > 13 && result > 0 }
    if op <= i32(Operation.ArrayClear) || op == i32(Operation.ArrayTruncate) { return input > 13 && result == 0 }
    if op == i32(Operation.Format) { return ((input <= 12 && input != 4) || input == 15) && result == 4 }
    if op == i32(Operation.FormatInteger) { return (input == 1 || input == 2 || (input >= 8 && input <= 12)) && result == 4 }
    if op == i32(Operation.FormatString) { return input == 4 && result == 4 }
    if op == i32(Operation.Print) { return input <= 12 && result == 0 }
    if op == i32(Operation.CheckRune) { return result == 5 }
    if input != 4 && input != 15 { return false }
    if op == i32(Operation.Concat) || op == i32(Operation.Slice) { return input == 4 && result == 4 }
    if op == i32(Operation.Compare) { return result == 1 }
    if op == i32(Operation.NextRune) { return result == 5 }
    result > 13
}
pub fn mutates_receiver(op: Operation) -> bool {
    op == .ArrayInitializeElement || op == .ArrayPush || op == .ArrayReserve || op == .ArrayTryReserve || op == .ArrayPop || op == .ArrayClear || op == .ArrayRemove || op == .ArrayTruncate
}
pub fn effects(op: i32) -> i32 {
    if op == i32(Operation.CheckRune) { return 25 }
    if op == i32(Operation.Compare) || op == i32(Operation.NextRune) { return 27 }
    95
}
pub fn argument_register(op: i32, input: i32) -> i32 {
    if op == i32(Operation.ArrayNew) { return 2 }
    if op == i32(Operation.FormatInteger) { return 2 }
    if op == i32(Operation.Format) {
        if input == 6 || input == 7 { return 1 }
        if input == 1 || input == 2 || (input >= 8 && input <= 12) { return 2 }
    }
    if op == i32(Operation.Print) && (input == 1 || input == 2 || (input >= 8 && input <= 12)) { return 8 }
    -1
}
pub fn argument_value(op: i32, input: i32, layout: i32) -> i64 {
    if op == i32(Operation.ArrayNew) { return i64(layout) }
    if input == 6 || (input >= 8 && input <= 12) { return 1 }
    0
}
