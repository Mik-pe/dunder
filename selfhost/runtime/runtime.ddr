// Native runtime for the self-hosted compiler's uniform eight-byte value ABI.
import ..backend.arm64 as arm
import runtime_sys as sys
import ..frontend.unsigned
import ..frontend.iteration

pub struct Runtime {
    alloc: i32, string_alloc: i32, release: i32, retain: i32, retain_elements: i32, release_elements: i32, array_new: i32, array_clone: i32, array_reserve: i32, array_push: i32, typed_push: [i32; 4], array_pop: i32,
    string_concat: i32, string_compare: i32, string_slice: i32, string_integer: i32, string_bool: i32,
    string_rune: i32, valid_rune: i32, string_bytes: i32, string_runes: i32, string_index: i32, string_next: i32,
    sys_arg_count: i32, sys_arg: i32, sys_envp: i32, sys_linux_syscall: i32, sys_pid: i32, sys_read_text: i32, sys_read_u8: i32, sys_metadata: i32,
    sys_same_file: i32, sys_write_bytes: i32, sys_make_executable: i32, sys_rename: i32,
    sys_remove_file: i32, sys_decode_utf8: i32, sys_decode_u8_range: i32, sys_write_text: i32,
    sys_append_text: i32, sys_mkdir: i32, sys_remove_dir: i32, sys_stderr: i32, sys_now_ms: i32,
    sys_net_listen: i32, sys_net_accept: i32, sys_net_connect: i32, sys_net_read: i32, sys_net_write: i32,
    sys_net_poll: i32, sys_net_set_nonblocking: i32, sys_net_set_nodelay: i32, sys_net_local_port: i32,
    sys_net_shutdown_write: i32, sys_net_close: i32,
    alloc_record: i32, alloc_clone: i32, assert_report: i32, profile_start: i32, profile_report: i32, profile_data: i32,
    array_clear: i32, array_drop: i32, array_remove: i32,
    memory_copy: i32, memory_equal: i32, bytes_extend: i32, bytes_append_text: i32,
}
pub fn new(code: &mut arm.Code) -> Runtime {
    s := sys.new(&mut code)
    allocation := arm.label(&mut code)
    mut r := Runtime {
        alloc: allocation, string_alloc: arm.label(&mut code), release: arm.label(&mut code), retain: arm.label(&mut code), retain_elements: arm.label(&mut code), release_elements: arm.label(&mut code), array_new: arm.label(&mut code), array_clone: arm.label(&mut code),
        array_reserve: arm.label(&mut code), array_push: arm.label(&mut code),
        typed_push: [arm.label(&mut code), arm.label(&mut code), arm.label(&mut code), arm.label(&mut code)], array_pop: arm.label(&mut code),
        string_concat: arm.label(&mut code), string_compare: arm.label(&mut code), string_slice: arm.label(&mut code),
        string_integer: arm.label(&mut code), string_bool: arm.label(&mut code), string_rune: arm.label(&mut code),
        valid_rune: arm.label(&mut code), string_bytes: arm.label(&mut code), string_runes: arm.label(&mut code), string_index: arm.label(&mut code), string_next: arm.label(&mut code),
        sys_arg_count: s.arg_count, sys_arg: s.arg, sys_envp: s.envp, sys_linux_syscall: s.linux_syscall, sys_pid: s.pid, sys_read_text: s.read_text, sys_read_u8: s.read_u8,
        sys_metadata: s.metadata, sys_same_file: s.same_file, sys_write_bytes: s.write_bytes,
        sys_make_executable: s.make_executable, sys_rename: s.rename, sys_remove_file: s.remove_file,
        sys_decode_utf8: s.decode_utf8, sys_decode_u8_range: s.decode_u8_range, sys_stderr: s.stderr,
        sys_write_text: s.write_text, sys_append_text: s.append_text, sys_mkdir: s.mkdir, sys_remove_dir: s.remove_dir,
        sys_now_ms: s.now_ms, sys_net_listen: s.net_listen, sys_net_accept: s.net_accept, sys_net_connect: s.net_connect,
        sys_net_read: s.net_read, sys_net_write: s.net_write, sys_net_poll: s.net_poll,
        sys_net_set_nonblocking: s.net_set_nonblocking, sys_net_set_nodelay: s.net_set_nodelay,
        sys_net_local_port: s.net_local_port, sys_net_shutdown_write: s.net_shutdown_write, sys_net_close: s.net_close,
        alloc_record: allocation, alloc_clone: allocation, assert_report: arm.label(&mut code), profile_start: -1, profile_report: -1, profile_data: -1,
        array_clear: -1, array_drop: -1, array_remove: -1,
        memory_copy: -1, memory_equal: -1, bytes_extend: -1, bytes_append_text: -1,
    }
    if code.profile {
        assert(code.platform != 3)
        r.alloc_record = arm.label(&mut code); r.alloc_clone = arm.label(&mut code)
        r.profile_start = arm.label(&mut code); r.profile_report = arm.label(&mut code); r.profile_data = arm.label(&mut code)
    }
    // Append the generic ownership entries without renumbering existing labels.
    r.array_clear = arm.label(&mut code); r.array_drop = arm.label(&mut code)
    r.memory_copy = arm.label(&mut code); r.memory_equal = arm.label(&mut code)
    r.bytes_extend = arm.label(&mut code); r.bytes_append_text = arm.label(&mut code)
    r.array_remove = arm.label(&mut code)
    r
}
fn ld(c: &mut arm.Code, d: i32, b: i32, off: i32) { arm.emit(&mut c, 4181721088 + i64(off / 8) * 1024 + i64(b) * 32 + i64(d)) }
fn st(c: &mut arm.Code, s: i32, b: i32, off: i32) { arm.emit(&mut c, 4177526784 + i64(off / 8) * 1024 + i64(b) * 32 + i64(s)) }
fn lb(c: &mut arm.Code, d: i32, b: i32) { arm.emit(&mut c, 960495616 + i64(b) * 32 + i64(d)) }
fn sb(c: &mut arm.Code, s: i32, b: i32) { arm.emit(&mut c, 956301312 + i64(b) * 32 + i64(s)) }
fn add(c: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut c, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn sub(c: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut c, 3405774848 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn ai(c: &mut arm.Code, d: i32, a: i32, n: i32) { arm.emit(&mut c, 2432696320 + i64(n) * 1024 + i64(a) * 32 + i64(d)) }
fn si(c: &mut arm.Code, d: i32, a: i32, n: i32) { arm.emit(&mut c, 3506438144 + i64(n) * 1024 + i64(a) * 32 + i64(d)) }
fn cmp(c: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut c, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn ci(c: &mut arm.Code, a: i32, n: i32) { arm.emit(&mut c, 4043309087 + i64(n) * 1024 + i64(a) * 32) }
fn shl(c: &mut arm.Code, d: i32, a: i32, n: i32) { arm.emit(&mut c, 3544186880 + i64(64 - n) * 65536 + i64(63 - n) * 1024 + i64(a) * 32 + i64(d)) }
fn shr(c: &mut arm.Code, d: i32, a: i32, n: i32) { arm.emit(&mut c, 3544251392 + i64(n) * 65536 + i64(a) * 32 + i64(d)) }
fn begin(c: &mut arm.Code, label: i32, slots: i32) { arm.mark(&mut c, label); at := arm.prologue(&mut c); arm.frame(&mut c, at, slots) }
fn call(c: &mut arm.Code, label: i32) { arm.branch(&mut c, label, 1) }
fn leaf(c: &mut arm.Code) { arm.emit(&mut c, 3596551104) }
// Executed-event counters occupy [pool+256,pool+384), outside free-list bins.
// x16 is scratch; all existing runtime helper live values remain untouched.
fn profile_count(c: &mut arm.Code, counter: i32, source: i32) {
    if !c.profile { return }
    ld(&mut c, 16, 21, 256 + counter * 8)
    if source < 0 { ai(&mut c, 16, 16, 1) } else { add(&mut c, 16, 16, source) }
    st(&mut c, 16, 21, 256 + counter * 8)
}
// Copy x12 bytes from x10 to x11. The count and both addresses are advanced.
fn copy(c: &mut arm.Code) {
    profile_count(&mut c, 15, 12)
    if c.platform == 3 { arm.emit(&mut c, 4278194177); return }
    words := arm.label(&mut c); tail := arm.label(&mut c)
    loop_at := arm.label(&mut c); done := arm.label(&mut c)
    // Callers select this forward path for disjoint ranges or an earlier
    // destination. Unaligned loads never pass the requested byte count.
    arm.mark(&mut c, words); ci(&mut c, 12, 8); arm.branch(&mut c, tail, 5)
    ld(&mut c, 13, 10, 0); st(&mut c, 13, 11, 0)
    ai(&mut c, 10, 10, 8); ai(&mut c, 11, 11, 8); si(&mut c, 12, 12, 8)
    arm.branch(&mut c, words, 0); arm.mark(&mut c, tail)
    arm.mark(&mut c, loop_at); ci(&mut c, 12, 0); arm.branch(&mut c, done, 2)
    lb(&mut c, 13, 10); sb(&mut c, 13, 11); ai(&mut c, 10, 10, 1); ai(&mut c, 11, 11, 1); si(&mut c, 12, 12, 1)
    arm.branch(&mut c, loop_at, 0); arm.mark(&mut c, done)
}
// Raw byte ranges use the ordinary value ABI: X0 destination/left, X1
// source/right, X2 usize count. Zero-length ranges never access either pointer.
// Copy is overlap-safe; equality returns exactly zero or one in X0.
fn memory(c: &mut arm.Code, r: &Runtime) {
    arm.mark(&mut c, r.memory_copy)
    copied := arm.label(&mut c); forward := arm.label(&mut c)
    ci(&mut c, 2, 0); arm.branch(&mut c, copied, 2)
    if c.platform != 3 {
        cmp(&mut c, 0, 1); arm.branch(&mut c, forward, 11)
        sub(&mut c, 13, 0, 1); cmp(&mut c, 13, 2); arm.branch(&mut c, forward, 4)
        // A later overlapping destination must be filled from the end.
        add(&mut c, 10, 1, 2); add(&mut c, 11, 0, 2); arm.mov(&mut c, 12, 2)
        profile_count(&mut c, 15, 12)
        words := arm.label(&mut c); tail := arm.label(&mut c)
        arm.mark(&mut c, words); ci(&mut c, 12, 8); arm.branch(&mut c, tail, 5)
        si(&mut c, 10, 10, 8); si(&mut c, 11, 11, 8)
        ld(&mut c, 13, 10, 0); st(&mut c, 13, 11, 0); si(&mut c, 12, 12, 8)
        arm.branch(&mut c, words, 0); arm.mark(&mut c, tail)
        ci(&mut c, 12, 0); arm.branch(&mut c, copied, 2)
        si(&mut c, 10, 10, 1); si(&mut c, 11, 11, 1)
        lb(&mut c, 13, 10); sb(&mut c, 13, 11); si(&mut c, 12, 12, 1)
        arm.branch(&mut c, tail, 0)
    }
    arm.mark(&mut c, forward)
    arm.mov(&mut c, 10, 1); arm.mov(&mut c, 11, 0); arm.mov(&mut c, 12, 2)
    // Wasm memory.copy already supplies memmove semantics for overlap.
    copy(&mut c); arm.mark(&mut c, copied); leaf(&mut c)

    arm.mark(&mut c, r.memory_equal)
    equal := arm.label(&mut c); different := arm.label(&mut c)
    words := arm.label(&mut c); tail := arm.label(&mut c)
    ci(&mut c, 2, 0); arm.branch(&mut c, equal, 2)
    cmp(&mut c, 0, 1); arm.branch(&mut c, equal, 2)
    arm.mov(&mut c, 10, 0); arm.mov(&mut c, 11, 1); arm.mov(&mut c, 12, 2)
    arm.mark(&mut c, words); ci(&mut c, 12, 8); arm.branch(&mut c, tail, 5)
    ld(&mut c, 13, 10, 0); ld(&mut c, 14, 11, 0); cmp(&mut c, 13, 14); arm.branch(&mut c, different, 3)
    ai(&mut c, 10, 10, 8); ai(&mut c, 11, 11, 8); si(&mut c, 12, 12, 8); arm.branch(&mut c, words, 0)
    arm.mark(&mut c, tail); ci(&mut c, 12, 0); arm.branch(&mut c, equal, 2)
    lb(&mut c, 13, 10); lb(&mut c, 14, 11); cmp(&mut c, 13, 14); arm.branch(&mut c, different, 3)
    ai(&mut c, 10, 10, 1); ai(&mut c, 11, 11, 1); si(&mut c, 12, 12, 1); arm.branch(&mut c, tail, 0)
    arm.mark(&mut c, equal); arm.imm(&mut c, 0, 1); leaf(&mut c)
    arm.mark(&mut c, different); arm.imm(&mut c, 0, 0); leaf(&mut c)
}
// Typed byte append keeps descriptor writes inside the runtime. X0 is the
// output descriptor. Extend takes X1 source descriptor, X2 start, X3 end;
// append_text takes X1 immutable UTF-8 string. Both return the output in X0.
fn byte_arrays(c: &mut arm.Code, r: &Runtime, bounds: i32) {
    for text in [false, true] {
        mut entry := r.bytes_extend; if text { entry = r.bytes_append_text }
        begin(&mut c, entry, 6)
        if text { arm.imm(&mut c, 2, 0); ld(&mut c, 3, 1, 0) }
        else {
            ld(&mut c, 10, 1, 8); cmp(&mut c, 2, 3); arm.branch(&mut c, bounds, 10)
            cmp(&mut c, 3, 10); arm.branch(&mut c, bounds, 10)
        }
        arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1); arm.store(&mut c, 2, 2)
        sub(&mut c, 3, 3, 2); arm.store(&mut c, 3, 3)
        ld(&mut c, 10, 0, 8); arm.store(&mut c, 4, 10)
        add(&mut c, 11, 10, 3); arm.store(&mut c, 5, 11); arm.mov(&mut c, 1, 11)
        call(&mut c, r.array_reserve)
        ld(&mut c, 11, 0, 0); arm.load_into(&mut c, 4, 10); add(&mut c, 11, 11, 10)
        // Reserve may move the output backing buffer. Reload the source
        // descriptor afterwards, including for self-append of its old prefix.
        arm.load(&mut c, 1)
        if text { ai(&mut c, 10, 0, 8) } else { ld(&mut c, 10, 0, 0) }
        arm.load_into(&mut c, 2, 12); add(&mut c, 10, 10, 12)
        arm.load_into(&mut c, 3, 12); copy(&mut c)
        arm.load_into(&mut c, 5, 10); arm.load(&mut c, 0); st(&mut c, 10, 0, 8); arm.ret(&mut c)
    }
}
fn map_native_pool(c: &mut arm.Code, failed: i32, header: i32) {
    arm.imm(&mut c, 0, 0); arm.imm(&mut c, 1, 536870912); arm.imm(&mut c, 2, 3)
    if c.platform == 0 { arm.imm(&mut c, 3, 4098) } else { arm.imm(&mut c, 3, 34) }
    arm.imm(&mut c, 4, -1); arm.imm(&mut c, 5, 0); arm.syscall(&mut c, 33554629, 222)
    if c.platform == 0 { arm.branch(&mut c, failed, 4) }
    else { ci(&mut c, 0, 0); arm.branch(&mut c, failed, 13) }
    arm.mov(&mut c, 21, 0); ai(&mut c, 19, 0, header)
    arm.imm(&mut c, 10, 536870912); add(&mut c, 20, 21, 10)
}

fn allocator(c: &mut arm.Code, r: &Runtime, trap: i32) {
    common := arm.label(&mut c); exhausted := arm.label(&mut c)
    if c.profile {
        arm.mark(&mut c, r.alloc_record); profile_count(&mut c, 11, -1); profile_count(&mut c, 12, 0); arm.branch(&mut c, r.alloc, 0)
        arm.mark(&mut c, r.alloc_clone); profile_count(&mut c, 13, -1); profile_count(&mut c, 14, 0); arm.branch(&mut c, r.alloc, 0)
    }
    // Both entry points share the bins. Preserve the requested failure status
    // across a kernel mapping call. String allocation includes its length word.
    begin(&mut c, r.string_alloc, 2); arm.imm(&mut c, 10, 105); arm.store(&mut c, 1, 10)
    arm.imm(&mut c, 10, 16777216); cmp(&mut c, 0, 10); arm.branch(&mut c, exhausted, 10)
    arm.branch(&mut c, common, 0)
    begin(&mut c, r.alloc, 2); arm.imm(&mut c, 10, 109); arm.store(&mut c, 1, 10)
    arm.mark(&mut c, common); arm.store(&mut c, 0, 0)
    if c.platform != 3 {
        ready := arm.label(&mut c)
        ci(&mut c, 19, 0); arm.branch(&mut c, ready, 3)
        mut header := 256; if c.profile { header = 512 }
        map_native_pool(&mut c, exhausted, header)
        arm.mark(&mut c, ready)
    }
    // The Wasm image initializes x19..21 to its linear heap at instantiation.
    arm.load(&mut c, 0)
    profile_count(&mut c, 0, -1); profile_count(&mut c, 1, 0)
    // Each power-of-two bin stores free payload pointers. At p-16 is the
    // bin address; at p-8 is the reference count (zero for static strings).
    arm.mov(&mut c, 11, 21); arm.imm(&mut c, 10, 16)
    choose := arm.label(&mut c); chosen := arm.label(&mut c)
    arm.mark(&mut c, choose); cmp(&mut c, 10, 0); arm.branch(&mut c, chosen, 4)
    shl(&mut c, 10, 10, 1); ai(&mut c, 11, 11, 8)
    arm.imm(&mut c, 12, 536870912); cmp(&mut c, 10, 12); arm.branch(&mut c, exhausted, 4); arm.branch(&mut c, choose, 0)
    arm.mark(&mut c, chosen); profile_count(&mut c, 2, 10); ld(&mut c, 0, 11, 0)
    fresh := arm.label(&mut c); taken := arm.label(&mut c); arm.branch(&mut c, fresh, 18)
    ld(&mut c, 12, 0, 0); st(&mut c, 12, 11, 0); profile_count(&mut c, 4, -1); arm.branch(&mut c, taken, 0)
    arm.mark(&mut c, fresh); ai(&mut c, 0, 19, 16); add(&mut c, 12, 0, 10); cmp(&mut c, 12, 20); arm.branch(&mut c, exhausted, 10)
    if c.platform == 3 { arm.emit(&mut c, 4278194176) } // grow Wasm memory through x12
    profile_count(&mut c, 3, -1)
    st(&mut c, 11, 19, 0); arm.mov(&mut c, 19, 12)
    arm.mark(&mut c, taken); si(&mut c, 12, 0, 8); arm.imm(&mut c, 13, 1); st(&mut c, 13, 12, 0); arm.ret(&mut c)
    arm.mark(&mut c, exhausted); arm.load(&mut c, 1)
    arm.syscall(&mut c, 33554433, 94); arm.emit(&mut c, 3558866944)
    // Retain and release preserve x0. Null and immortal literals need no work.
    for operation in 0..2 {
        if operation == 0 { arm.mark(&mut c, r.retain) } else { arm.mark(&mut c, r.release) }
        mut counter := 5; if operation == 1 { counter = 6 }; profile_count(&mut c, counter, -1)
        done := arm.label(&mut c); arm.branch(&mut c, done, 18); si(&mut c, 10, 0, 8); ld(&mut c, 11, 10, 0)
        ci(&mut c, 11, 0); arm.branch(&mut c, done, 2); arm.branch(&mut c, trap, 13)
        if operation == 0 { ai(&mut c, 11, 11, 1); st(&mut c, 11, 10, 0) }
        else {
            si(&mut c, 11, 11, 1); st(&mut c, 11, 10, 0); ci(&mut c, 11, 0); arm.branch(&mut c, done, 3)
            arm.imm(&mut c, 11, -1); st(&mut c, 11, 10, 0); si(&mut c, 10, 10, 8); ld(&mut c, 10, 10, 0)
            ld(&mut c, 11, 10, 0); st(&mut c, 11, 0, 0); st(&mut c, 0, 10, 0)
        }
        arm.mark(&mut c, done); leaf(&mut c)
    }
}
// Size-class shifts live at descriptor offset 24. Array indices remain element counts.
fn scaled(c: &mut arm.Code, dst: i32, count: i32, descriptor: i32) {
    ld(&mut c, 15, descriptor, 24)
    arm.emit(&mut c, 2596282368 + 15 * 65536 + i64(count) * 32 + i64(dst)) // lslv
}
// Common word-width path first, then byte/halfword/word transfer.
fn element(c: &mut arm.Code, reg: i32, base: i32, load: bool) {
    done := arm.label(&mut c)
    for shift in [3, 0, 1, 2] {
        next := arm.label(&mut c)
        if shift != 2 { ci(&mut c, 15, shift); arm.branch(&mut c, next, 3) }
        unsigned.transfer(&mut c, shift + 8, reg, base, load)
        if shift != 2 { arm.branch(&mut c, done, 0) }
        arm.mark(&mut c, next)
    }
    arm.mark(&mut c, done)
}
// Managed descriptors keep 0 <= len <= cap <= i32::MAX independently of the
// pool's byte limit. x0 is the descriptor and x1 the requested element count.
// Return the selected capacity in x10; preserve x0/x1 and clobber x11/flags.
// An already sufficient descriptor branches to enough. The shared emitter is
// also exercised without allocating an impossible multi-gigabyte buffer.
pub fn emit_array_growth(c: &mut arm.Code, capacity: i32, enough: i32) {
    // For a valid descriptor, unsigned wanted<=cap also proves wanted<=MAX.
    // Negative counts and counts above MAX can only reach the guarded growth.
    ld(&mut c, 10, 0, 16); cmp(&mut c, 1, 10); arm.branch(&mut c, enough, 11)
    arm.imm(&mut c, 11, 2147483647); cmp(&mut c, 1, 11); arm.branch(&mut c, capacity, 10)
    clamped := arm.label(&mut c); chosen := arm.label(&mut c); minimum := arm.label(&mut c)
    // Current capacity is valid, so doubling fits in the wide runtime register.
    // Clamp before publishing a new descriptor or scaling to a byte count.
    shl(&mut c, 10, 10, 1); cmp(&mut c, 10, 11); arm.branch(&mut c, clamped, 11)
    arm.mov(&mut c, 10, 11); arm.mark(&mut c, clamped)
    cmp(&mut c, 10, 1); arm.branch(&mut c, chosen, 4); arm.mov(&mut c, 10, 1)
    arm.mark(&mut c, chosen); ci(&mut c, 10, 8); arm.branch(&mut c, minimum, 4); arm.imm(&mut c, 10, 8)
    arm.mark(&mut c, minimum)
}
fn arrays(c: &mut arm.Code, r: &Runtime, bounds: i32, capacity: i32) {
    // A cloned string array shares its handles until each is released.
    for operation in 0..2 {
        mut entry := r.retain_elements; mut apply := r.retain
        if operation == 1 { entry = r.release_elements; apply = r.release }
        begin(&mut c, entry, 1); arm.store(&mut c, 0, 0); ld(&mut c, 14, 0, 0); ld(&mut c, 15, 0, 8)
        head := arm.label(&mut c); done := arm.label(&mut c); arm.mark(&mut c, head)
        ci(&mut c, 15, 0); arm.branch(&mut c, done, 2); ld(&mut c, 0, 14, 0); call(&mut c, apply)
        ai(&mut c, 14, 14, 8); si(&mut c, 15, 15, 1); arm.branch(&mut c, head, 0)
        arm.mark(&mut c, done); arm.load(&mut c, 0); arm.ret(&mut c)
    }
    begin(&mut c, r.array_new, 2); arm.store(&mut c, 0, 2); arm.imm(&mut c, 0, 48); call(&mut c, r.alloc); arm.mov(&mut c, 10, 0); arm.load(&mut c, 0); st(&mut c, 0, 10, 24); arm.mov(&mut c, 0, 10)
    st(&mut c, 31, 0, 0); st(&mut c, 31, 0, 8); st(&mut c, 31, 0, 16)
    // Recycled descriptor allocations must never inherit ownership callbacks.
    st(&mut c, 31, 0, 32); st(&mut c, 31, 0, 40); arm.ret(&mut c)
    begin(&mut c, r.array_reserve, 4); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1)
    enough := arm.label(&mut c); emit_array_growth(&mut c, capacity, enough)
    arm.store(&mut c, 3, 10); scaled(&mut c, 0, 10, 0); call(&mut c, r.alloc); arm.store(&mut c, 2, 0)
    arm.mov(&mut c, 11, 0); arm.load(&mut c, 0); ld(&mut c, 10, 0, 0); ld(&mut c, 12, 0, 8); scaled(&mut c, 12, 12, 0); copy(&mut c)
    arm.load(&mut c, 0); ld(&mut c, 0, 0, 0); call(&mut c, r.release)
    arm.load(&mut c, 2); arm.mov(&mut c, 10, 0); arm.load(&mut c, 0); st(&mut c, 10, 0, 0)
    arm.mov(&mut c, 10, 0); arm.load(&mut c, 3); st(&mut c, 0, 10, 16)
    arm.mark(&mut c, enough); arm.load(&mut c, 0); arm.ret(&mut c)
    // A push with spare capacity is a leaf. Keep the descriptor and value in
    // their argument registers; only growing the buffer requires a frame.
    grow := arm.label(&mut c); append := arm.label(&mut c)
    arm.mark(&mut c, r.array_push); ld(&mut c, 11, 0, 8); ld(&mut c, 10, 0, 16)
    cmp(&mut c, 11, 10); arm.branch(&mut c, grow, 4)
    arm.mark(&mut c, append); ld(&mut c, 10, 0, 0); scaled(&mut c, 12, 11, 0); add(&mut c, 10, 10, 12)
    ai(&mut c, 11, 11, 1); st(&mut c, 11, 0, 8); element(&mut c, 1, 10, false); leaf(&mut c)
