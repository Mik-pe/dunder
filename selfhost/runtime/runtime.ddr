fn profile_segments() -> []string {
    ["{\"kind\":\"runtime_profile\",\"version\":1,\"units\":{\"counts\":\"events\",\"bytes\":\"bytes\"},\"counter_arithmetic\":\"uint64_modulo\",\"allocation_header_bytes\":16,\"pool_header_bytes\":512,\"requested_bytes_exclude_allocator_header\":true,\"size_class_payload_excludes_header\":true,\"counters\":{\"allocation_count\":",
     ",\"requested_bytes\":", ",\"size_class_payload_bytes\":", ",\"fresh_allocations\":", ",\"reused_allocations\":",
     ",\"retain_calls\":", ",\"release_calls\":", ",\"array_clone_calls\":", ",\"array_clone_bytes\":",
     ",\"string_slice_calls\":", ",\"string_slice_bytes\":", ",\"record_construct_calls\":", ",\"record_construct_bytes\":",
     ",\"record_clone_calls\":", ",\"record_clone_bytes\":", ",\"copy_bytes\":", "}}\n"]
}
pub fn emit_profile_start(code: &mut arm.Code, r: &Runtime) {
    if code.profile { assert(code.platform != 3); call(&mut code, r.profile_start) }
}
pub fn emit_profile_report(code: &mut arm.Code, r: &Runtime) {
    if code.profile { assert(code.platform != 3); call(&mut code, r.profile_report) }
}
pub fn emit_profile_data(code: &mut arm.Code, r: &Runtime) {
    if !code.profile { return }
    arm.mark(&mut code, r.profile_data)
    mut word: i64 = 0; mut shift := 0
    for segment in profile_segments() {
        for byte in segment.bytes() {
            word = word + i64(byte).shl(shift); shift = shift + 8
            if shift == 32 { arm.emit(&mut code, word); word = 0; shift = 0 }
        }
    }
    if shift != 0 { arm.emit(&mut code, word) }
}
fn profile_helpers(code: &mut arm.Code, r: &Runtime) {
    if !code.profile { return }
    assert(code.platform != 3)
    ready := arm.label(&mut code); map_failed := arm.label(&mut code)
    begin(&mut code, r.profile_start, 0)
    ci(&mut code, 19, 0); arm.branch(&mut code, ready, 3)
    map_native_pool(&mut code, map_failed, 512)
    arm.mark(&mut code, ready)
    for i in 0..16 { st(&mut code, 31, 21, 256 + i * 8) }
    arm.ret(&mut code)
    arm.mark(&mut code, map_failed); arm.exit(&mut code, 109)

    write := arm.label(&mut code); number := arm.label(&mut code); done := arm.label(&mut code)
    begin(&mut code, r.profile_report, 8); arm.store(&mut code, 0, 0)
    arm.imm(&mut code, 0, 4096); arm.store(&mut code, 2, 0); si(&mut code, 1, 29, 24)
    if code.platform == 0 { arm.imm(&mut code, 0, 1) } else { arm.imm(&mut code, 0, 0) }
    arm.imm(&mut code, 2, 0); arm.imm(&mut code, 3, 8); arm.syscall(&mut code, 33554480, 135)
    if code.platform == 0 { arm.branch(&mut code, done, 4) }
    else { ci(&mut code, 0, 0); arm.branch(&mut code, done, 13) }
    arm.branch(&mut code, r.profile_data, 20); arm.store(&mut code, 1, 0)
    segments := profile_segments(); mut offset := 0
    for i in 0..16 {
        arm.load(&mut code, 1); ai(&mut code, 1, 0, offset); arm.imm(&mut code, 2, i64(segments[i].len))
        call(&mut code, write); arm.branch(&mut code, done, 18)
        ld(&mut code, 0, 21, 256 + i * 8); call(&mut code, number); arm.branch(&mut code, done, 18)
        offset = offset + segments[i].len
    }
    assert(offset < 4096)
    arm.load(&mut code, 1); ai(&mut code, 1, 0, offset); arm.imm(&mut code, 2, i64(segments[16].len)); call(&mut code, write)
    arm.mark(&mut code, done); arm.load(&mut code, 0); arm.ret(&mut code)

    begin(&mut code, number, 8); arm.mov(&mut code, 10, 0); si(&mut code, 1, 29, 8)
    arm.imm(&mut code, 2, 0); arm.imm(&mut code, 15, 10)
    digit := arm.label(&mut code); arm.mark(&mut code, digit)
    arm.emit(&mut code, 2596276224 + 15 * 65536 + 10 * 32 + 13)
    arm.emit(&mut code, 2600501248 + 15 * 65536 + 10 * 1024 + 13 * 32 + 14)
    ai(&mut code, 14, 14, 48); si(&mut code, 1, 1, 1); sb(&mut code, 14, 1); ai(&mut code, 2, 2, 1)
    arm.mov(&mut code, 10, 13); ci(&mut code, 10, 0); arm.branch(&mut code, digit, 3)
    call(&mut code, write); arm.ret(&mut code)

    arm.mark(&mut code, write)
    again := arm.label(&mut code); failed := arm.label(&mut code); error := arm.label(&mut code); complete := arm.label(&mut code)
    arm.mark(&mut code, again); ci(&mut code, 2, 0); arm.branch(&mut code, complete, 2)
    arm.imm(&mut code, 0, 2); arm.syscall(&mut code, 33554436, 64)
    if code.platform == 0 { arm.branch(&mut code, error, 4) }
    else { ci(&mut code, 0, 0); arm.branch(&mut code, error, 13) }
    arm.branch(&mut code, failed, 18)
    sub(&mut code, 2, 2, 0); add(&mut code, 1, 1, 0); arm.branch(&mut code, again, 0)
    arm.mark(&mut code, error)
    if code.platform == 0 { ci(&mut code, 0, 4) }
    else { arm.imm(&mut code, 3, -4); cmp(&mut code, 0, 3) }
    arm.branch(&mut code, again, 2)
    arm.mark(&mut code, failed); arm.imm(&mut code, 0, 0); leaf(&mut code)
    arm.mark(&mut code, complete); arm.imm(&mut code, 0, 1); leaf(&mut code)
}
fn assertion_report(code: &mut arm.Code, entry: i32) {
