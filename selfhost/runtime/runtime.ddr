    ai(&mut code, 14, 14, 48); si(&mut code, 1, 1, 1); sb(&mut code, 14, 1); ai(&mut code, 2, 2, 1)
    arm.mov(&mut code, 10, 13); ci(&mut code, 10, 0); arm.branch(&mut code, digit, 3)
    call(&mut code, write); arm.ret(&mut code)

    // x1=bytes, x2=remaining. Return bool success and tolerate short writes,
    // EINTR, closed descriptors and errors without changing main's exit code.
    arm.mark(&mut code, write)
    again := arm.label(&mut code); failed := arm.label(&mut code); error := arm.label(&mut code); complete := arm.label(&mut code)
    arm.mark(&mut code, again); ci(&mut code, 2, 0); arm.branch(&mut code, complete, 2)
    arm.imm(&mut code, 0, 2); arm.syscall(&mut code, 33554436, 64)
    if code.platform == 0 { arm.branch(&mut code, error, 4) }
    else { ci(&mut code, 0, 0); arm.branch(&mut code, error, 13) }
    arm.branch(&mut code, failed, 18)
    sub(&mut code, 2, 2, 0); add(&mut code, 1, 1, 0); arm.branch(&mut code, again, 0)
    arm.mark(&mut code, error)
    if code.platform == 0 { ci(&mut code, 0, 4) }
    else { arm.imm(&mut code, 3, -4); cmp(&mut code, 0, 3) }
    arm.branch(&mut code, again, 2)
    arm.mark(&mut code, failed); arm.imm(&mut code, 0, 0); leaf(&mut code)
    arm.mark(&mut code, complete); arm.imm(&mut code, 0, 1); leaf(&mut code)
}
// Source assertion tails pass one static string. This observing helper is
// separate from the unobserving assertion exit used by MIR terminal proofs.
// No allocation or formatting runs in the program, including on failure.
fn assertion_report(code: &mut arm.Code, entry: i32) {
    arm.mark(&mut code, entry)
    if code.platform == 3 { arm.emit(&mut code, 3596551104); return }
    ld(&mut code, 2, 0, 0); ai(&mut code, 1, 0, 8)
    again := arm.label(&mut code); error := arm.label(&mut code); done := arm.label(&mut code)
    arm.mark(&mut code, again); ci(&mut code, 2, 0); arm.branch(&mut code, done, 2)
    arm.imm(&mut code, 0, 2); arm.syscall(&mut code, 33554436, 64)
    if code.platform == 0 { arm.branch(&mut code, error, 4) }
    else { ci(&mut code, 0, 0); arm.branch(&mut code, error, 13) }
    arm.branch(&mut code, done, 18)
    sub(&mut code, 2, 2, 0); add(&mut code, 1, 1, 0); arm.branch(&mut code, again, 0)
    arm.mark(&mut code, error)
    if code.platform == 0 { ci(&mut code, 0, 4) }
    else { arm.imm(&mut code, 3, -4); cmp(&mut code, 0, 3) }
    arm.branch(&mut code, again, 2)
    arm.mark(&mut code, done); leaf(&mut code)
}
pub fn emit_runtime(code: &mut arm.Code, r: &Runtime) {
    site := emit_runtime_with_env(&mut code, &r, -1)
}
pub fn emit_runtime_with_env(code: &mut arm.Code, r: &Runtime, environ_slot: i32) -> i32 {
    assertion_report(&mut code, r.assert_report)
    capacity := arm.label(&mut code); bounds := arm.label(&mut code); unicode := arm.label(&mut code)
    allocator(&mut code, &r, capacity); arrays(&mut code, &r, bounds, capacity)
    memory(&mut code, &r); byte_arrays(&mut code, &r, bounds); strings(&mut code, &r, bounds, unicode)
    format(&mut code, &r, unicode); conversions(&mut code, &r)
    s := sys.Sys {arg_count:r.sys_arg_count,arg:r.sys_arg,envp:r.sys_envp,linux_syscall:r.sys_linux_syscall,pid:r.sys_pid,read_text:r.sys_read_text,read_u8:r.sys_read_u8,
        metadata:r.sys_metadata,same_file:r.sys_same_file,write_bytes:r.sys_write_bytes,
        make_executable:r.sys_make_executable,rename:r.sys_rename,remove_file:r.sys_remove_file,
        decode_utf8:r.sys_decode_utf8,decode_u8_range:r.sys_decode_u8_range,stderr:r.sys_stderr,
        write_text:r.sys_write_text,append_text:r.sys_append_text,mkdir:r.sys_mkdir,remove_dir:r.sys_remove_dir,
        now_ms:r.sys_now_ms,net_listen:r.sys_net_listen,net_accept:r.sys_net_accept,net_connect:r.sys_net_connect,
        net_read:r.sys_net_read,net_write:r.sys_net_write,net_poll:r.sys_net_poll,
        net_set_nonblocking:r.sys_net_set_nonblocking,net_set_nodelay:r.sys_net_set_nodelay,
        net_local_port:r.sys_net_local_port,net_shutdown_write:r.sys_net_shutdown_write,net_close:r.sys_net_close,environ_slot:environ_slot}
    site := sys.emit_runtime(&mut code, &s, r.alloc, r.release, r.alloc_record)
    profile_helpers(&mut code, &r)
    arm.mark(&mut code, bounds); arm.exit(&mut code, 103)
    arm.mark(&mut code, unicode); arm.exit(&mut code, 106)
    arm.mark(&mut code, capacity); arm.exit(&mut code, 109)
    site
}
