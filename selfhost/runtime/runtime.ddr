fn assertion_values(code: &mut arm.Code, r: &Runtime) {
    // Keep the source and both values together in a single stderr record.
    left := "  left = "; right := "\n  right = "; newline := "\n"
    begin(&mut code, r.assert_values, 4)
    for part in 0..3 { arm.store(&mut code, part, part) }
    arm.imm(&mut code, 0, i64(left.len + right.len + newline.len))
    for part in 0..3 {
        arm.load_into(&mut code, part, 10); ld(&mut code, 10, 10, 0); add(&mut code, 0, 0, 10)
    }
    arm.store(&mut code, 3, 0); ai(&mut code, 0, 0, 8); call(&mut code, r.string_alloc)
    arm.mov(&mut code, 11, 0); arm.load_into(&mut code, 3, 12)
    st(&mut code, 12, 0, 0); ai(&mut code, 11, 11, 8)
    append_assert_part(&mut code, 0); append_assert_text(&mut code, left)
    append_assert_part(&mut code, 1); append_assert_text(&mut code, right)
