// Function-local machine input for isolated compiler workers. Source IDs and
// positions stay absolute; storage rows address only this batch's columns.
import arm64 as arm

pub struct Item {
    platform: i32, entry: i32, entry_word: i32,
    first_word: i32, first_label: i32, first_reloc: i32, first_import: i32,
    word_count: i32, label_count: i32, reloc_count: i32, import_count: i32,
    word_row: i32, label_row: i32, reloc_row: i32, import_row: i32,
}
pub struct Batch {
    type_ends: []i32, types: []i32, items: []i32, words: []i64, labels: []i32,
    at: []i32, targets: []i32, kinds: []i32, target_words: []i32, sites: []i32,
}
pub fn new() -> Batch {
    Batch { type_ends: [], types: [], items: [], words: [], labels: [], at: [], targets: [], kinds: [], target_words: [],
        sites: [] }
}
pub fn reset(batch: &mut Batch) {
    batch.type_ends.clear(); batch.types.clear(); batch.items.clear(); batch.words.clear(); batch.labels.clear()
    batch.at.clear(); batch.targets.clear(); batch.kinds.clear(); batch.target_words.clear()
    batch.sites.clear()
}
// Fixed-width item headers are consumed whole by one worker. Machine rows
// remain columnar so each inner loop reads or appends contiguous primitives.
pub fn count(batch: &Batch) -> i32 { batch.items.len / 15 }
pub fn item_at(batch: &Batch, index: i32) -> Item {
    at := index * 15
    Item {
        platform: batch.items[at + 0], entry: batch.items[at + 1], entry_word: batch.items[at + 2],
        first_word: batch.items[at + 3], first_label: batch.items[at + 4], first_reloc: batch.items[at + 5],
        first_import: batch.items[at + 6], word_count: batch.items[at + 7], label_count: batch.items[at + 8],
        reloc_count: batch.items[at + 9], import_count: batch.items[at + 10],
        word_row: batch.items[at + 11], label_row: batch.items[at + 12], reloc_row: batch.items[at + 13],
        import_row: batch.items[at + 14],
    }
}
fn add_item(batch: &mut Batch, item: &Item) {
    batch.items.push(item.platform); batch.items.push(item.entry); batch.items.push(item.entry_word)
    batch.items.push(item.first_word); batch.items.push(item.first_label); batch.items.push(item.first_reloc)
    batch.items.push(item.first_import); batch.items.push(item.word_count); batch.items.push(item.label_count)
    batch.items.push(item.reloc_count); batch.items.push(item.import_count)
    batch.items.push(item.word_row); batch.items.push(item.label_row); batch.items.push(item.reloc_row)
    batch.items.push(item.import_row)
}
pub fn valid_start(code: &arm.Code, first_word: i32, first_label: i32, first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    if code.checking || first_word < 0 || first_word > code.words.len || first_label < 0 || first_label > code.labels.len ||
        first_reloc < 0 || first_reloc > code.at.len || first_import < 0 || first_import > sites.len ||
        code.at.len != code.target.len || code.at.len != code.kinds.len { return false }
    // Adjacent rows are the only earlier suffix input that can overlap this
    // function. Check them here while the whole source Code is available.
    if first_reloc > 0 {
        kind := code.kinds[first_reloc - 1]; width := arm.source_reloc_width(&code, code.at[first_reloc - 1], kind)
        if kind < 0 || kind > 20 || code.at[first_reloc - 1] < 0 || code.at[first_reloc - 1] > first_word - width { return false }
    }
    if first_import > 0 {
        site := sites[first_import - 1]
        if site < 0 || site % 4 != 0 || site / 4 > first_word - arm.source_import_width(&code, site / 4) { return false }
    }
    true
}
pub fn rows(platform: i32, first_word: i32, first_label: i32, first_reloc: i32, first_import: i32,
    words: i32, labels: i32, relocs: i32, imports: i32) -> Item {
    Item { platform: platform, entry: -1, entry_word: -1,
        first_word: first_word, first_label: first_label, first_reloc: first_reloc, first_import: first_import,
        word_count: words - first_word, label_count: labels - first_label,
        reloc_count: relocs - first_reloc, import_count: imports - first_import,
        word_row: first_word, label_row: first_label, reloc_row: first_reloc, import_row: first_import }
}
pub fn capture(batch: &mut Batch, code: &arm.Code, first_word: i32, first_label: i32, first_reloc: i32,
    sites: &[]i32, first_import: i32, entry: i32) -> bool {
    if !valid_start(&code, first_word, first_label, first_reloc, &sites, first_import) { return false }
    var item := rows(code.platform, first_word, first_label, first_reloc, first_import,
        code.words.len, code.labels.len, code.at.len, sites.len)
    item.word_row = batch.words.len; item.label_row = batch.labels.len
    item.reloc_row = batch.at.len; item.import_row = batch.sites.len
    item.entry = entry
    if entry >= 0 && entry < code.labels.len { item.entry_word = code.labels[entry] }
    for i in first_word..code.words.len { batch.words.push(code.words[i]) }
    for i in first_label..code.labels.len { batch.labels.push(code.labels[i]) }
    for i in first_reloc..code.at.len {
        target := code.target[i]
        // Older global labels are shared by all functions. Snapshot only
        // referenced bindings; a later frontend job may bind a forward label.
        var word := -1; if target >= 0 && target < code.labels.len { word = code.labels[target] }
        batch.at.push(code.at[i]); batch.targets.push(target); batch.kinds.push(code.kinds[i]); batch.target_words.push(word)
    }
    for i in first_import..sites.len { batch.sites.push(sites[i]) }
    add_item(&mut batch, &item)
    true
}
