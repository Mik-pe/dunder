// Lower the arithmetic vocabulary of the native emitter to WebAssembly. A W
// destination zero-extends into its X register. Arithmetic flags are i64 0/1.
import wasm_bytes as b

fn local(out: &mut []u8, index: i32) { b.indexed(&mut out, 32, index) }
fn save(out: &mut []u8, index: i32) { b.indexed(&mut out, 33, index) }
fn global(out: &mut []u8, index: i32) { b.indexed(&mut out, 35, index) }
fn put_global(out: &mut []u8, index: i32) { b.indexed(&mut out, 36, index) }
fn narrow(out: &mut []u8, wide: bool) {
    if !wide { b.op(&mut out, 167); b.op(&mut out, 173) }
}
fn sign_bit(out: &mut []u8, wide: bool) {
    var sign: i64 = 31
    if wide { sign = 63 }
    b.constant(&mut out, sign); b.op(&mut out, 136)
}
pub fn condition(out: &mut []u8, cond: i32) {
    class := cond / 2
    if class == 0 { global(&mut out, 33) } // Z
    else if class == 1 { global(&mut out, 34) } // C
    else if class == 2 { global(&mut out, 32) } // N
    else if class == 3 { global(&mut out, 35) } // V
    else if class == 4 { // unsigned higher: C && !Z
        global(&mut out, 33); b.constant(&mut out, 1); b.op(&mut out, 133)
        global(&mut out, 34); b.op(&mut out, 131)
    } else if class == 5 || class == 6 {
        global(&mut out, 32); global(&mut out, 35); b.op(&mut out, 133)
        if class == 6 { global(&mut out, 33); b.op(&mut out, 132) }
        b.constant(&mut out, 1); b.op(&mut out, 133)
    } else { b.i32_const(&mut out, 1); return }
    if cond % 2 == 1 { b.constant(&mut out, 1); b.op(&mut out, 133) }
    b.op(&mut out, 167)
}
// Input locals 0 and 1 hold the operands, local 2 holds their truncated result.
fn flags(out: &mut []u8, wide: bool, subtract: bool, logical: bool) {
    local(&mut out, 2); sign_bit(&mut out, wide); put_global(&mut out, 32)
    local(&mut out, 2); b.op(&mut out, 80); b.op(&mut out, 173); put_global(&mut out, 33)
    if logical {
        b.constant(&mut out, 0); put_global(&mut out, 34)
        b.constant(&mut out, 0); put_global(&mut out, 35)
        return
    }
    if subtract { local(&mut out, 0); local(&mut out, 1); b.op(&mut out, 90) }
    else { local(&mut out, 2); local(&mut out, 0); b.op(&mut out, 84) }
    b.op(&mut out, 173); put_global(&mut out, 34)
    local(&mut out, 0)
    if subtract { local(&mut out, 1) } else { local(&mut out, 2) }
    b.op(&mut out, 133)
    if subtract { local(&mut out, 0) } else { local(&mut out, 1) }
    local(&mut out, 2); b.op(&mut out, 133)
    b.op(&mut out, 131); sign_bit(&mut out, wide); put_global(&mut out, 35)
}
// An i64 value is on the stack. Shift at the architectural width.
fn shift(out: &mut []u8, wide: bool, kind: i32, amount: i32) {
    if amount == 0 { narrow(&mut out, wide); return }
    var opcode := 134
    if kind == 1 { opcode = 136 } else if kind == 2 { opcode = 135 } else if kind == 3 { opcode = 138 }
    if wide { b.constant(&mut out, i64(amount)); b.op(&mut out, opcode) }
    else {
        b.op(&mut out, 167); b.i32_const(&mut out, amount)
        b.op(&mut out, opcode - 18); b.op(&mut out, 173)
    }
}
fn arithmetic(out: &mut []u8, w: i64, immediate: bool, logical: bool) -> bool {
    rd := b.bits(w, 0, 31); rn := b.bits(w, 5, 31); rm := b.bits(w, 16, 31)
    wide := w >= 2147483648
    subtract := b.bits(w, 30, 1) != 0
    operation := b.bits(w, 29, 3)
    var update := b.bits(w, 29, 1) != 0
    if logical { update = operation == 3 }
    if immediate { b.base(&mut out, rn) } else { b.read(&mut out, rn) }
    narrow(&mut out, wide)
    if update { b.indexed(&mut out, 34, 0) }
    if immediate {
        value := b.bits(w, 10, 4095).shl(b.bits(w, 22, 1) * 12)
        b.constant(&mut out, i64(value))
    } else {
        which := b.bits(w, 22, 3)
        if !logical && which == 3 { return false }
        b.read(&mut out, rm)
        shift(&mut out, wide, which, b.bits(w, 10, 63))
    }
    var opcode := 124
    if logical {
        if b.bits(w, 21, 1) != 0 { b.constant(&mut out, -1); b.op(&mut out, 133); narrow(&mut out, wide) }
        opcode = 131
        if operation == 1 { opcode = 132 } else if operation == 2 { opcode = 133 }
    } else if subtract { opcode = 125 }
    if update { b.indexed(&mut out, 34, 1) }
    b.op(&mut out, opcode); narrow(&mut out, wide)
    if update {
        save(&mut out, 2); flags(&mut out, wide, subtract, logical); local(&mut out, 2)
    }
    if immediate && !update { b.set_base(&mut out, rd) } else { b.write(&mut out, rd) }
    true
}
fn field(out: &mut []u8, w: i64, signed: bool) -> bool {
    rd := b.bits(w, 0, 31); rn := b.bits(w, 5, 31); wide := w >= 2147483648
    var width := 32
    if wide { width = 64 }
    r := b.bits(w, 16, 63); s := b.bits(w, 10, 63)
    if r >= width || s >= width || (s < r && signed) { return false }
    b.read(&mut out, rn)
    if s >= r {
        shift(&mut out, wide, 0, width - 1 - s)
        var kind := 1
        if signed { kind = 2 }
        shift(&mut out, wide, kind, width - 1 - s + r)
    } else {
        b.constant(&mut out, i64(1).shl(s + 1).wrapping_sub(1)); b.op(&mut out, 131)
        shift(&mut out, wide, 0, width - r)
    }
    b.write(&mut out, rd); true
}
fn half(out: &mut []u8, reg: i32, high: bool) {
    b.read(&mut out, reg)
    if high { b.constant(&mut out, 32); b.op(&mut out, 136) }
    else { b.op(&mut out, 167); b.op(&mut out, 173) }
}
fn half_product(out: &mut []u8, a: i32, a_high: bool, right: i32, b_high: bool) {
    half(&mut out, a, a_high); half(&mut out, right, b_high); b.op(&mut out, 126)
}
// High half of the 128-bit product. Carries from the two middle columns are
// accumulated before truncation. Signed multiplication corrects the high word.
fn multiply_high(out: &mut []u8, a: i32, right: i32, signed: bool) {
    half_product(&mut out, a, false, right, false)
    b.constant(&mut out, 32); b.op(&mut out, 136)
    half_product(&mut out, a, true, right, false); b.op(&mut out, 124)
    save(&mut out, 0)
    local(&mut out, 0); b.op(&mut out, 167); b.op(&mut out, 173)
    half_product(&mut out, a, false, right, true); b.op(&mut out, 124)
    b.constant(&mut out, 32); b.op(&mut out, 136)
    local(&mut out, 0); b.constant(&mut out, 32); b.op(&mut out, 136); b.op(&mut out, 124)
    half_product(&mut out, a, true, right, true); b.op(&mut out, 124)
    if signed {
        b.read(&mut out, a); b.constant(&mut out, 63); b.op(&mut out, 135)
        b.read(&mut out, right); b.op(&mut out, 131); b.op(&mut out, 125)
        b.read(&mut out, right); b.constant(&mut out, 63); b.op(&mut out, 135)
        b.read(&mut out, a); b.op(&mut out, 131); b.op(&mut out, 125)
    }
}
fn divide(out: &mut []u8, wide: bool, signed: bool, numerator: i32, denominator: i32) {
    b.read(&mut out, denominator); narrow(&mut out, wide); b.op(&mut out, 80)
    b.op(&mut out, 4); b.op(&mut out, 126); b.constant(&mut out, 0); b.op(&mut out, 5)
    if signed {
        var minimum: i64 = -9223372036854775808
        var minus_one: i64 = -1
        if !wide { minimum = 2147483648; minus_one = 4294967295 }
        b.read(&mut out, numerator); narrow(&mut out, wide); b.constant(&mut out, minimum); b.op(&mut out, 81)
        b.read(&mut out, denominator); narrow(&mut out, wide); b.constant(&mut out, minus_one); b.op(&mut out, 81)
        b.op(&mut out, 113); b.op(&mut out, 4); b.op(&mut out, 126)
        b.constant(&mut out, minimum); b.op(&mut out, 5)
    }
    b.read(&mut out, numerator); if !wide { b.op(&mut out, 167) }
    b.read(&mut out, denominator); if !wide { b.op(&mut out, 167) }
    var instruction := 128
    if signed { instruction = 127 }
    if !wide { instruction = instruction - 18 }
    b.op(&mut out, instruction); if !wide { b.op(&mut out, 173) }
    if signed { b.op(&mut out, 11) }
    b.op(&mut out, 11)
}
fn read_fp(out: &mut []u8, reg: i32, wide: bool) {
    global(&mut out, 36 + reg)
    if wide { b.op(&mut out, 191) } else { b.op(&mut out, 167); b.op(&mut out, 190) }
}
fn write_fp(out: &mut []u8, reg: i32, wide: bool) {
    if wide { b.op(&mut out, 189) } else { b.op(&mut out, 188); b.op(&mut out, 173) }
    put_global(&mut out, 36 + reg)
}
fn bits_fp(out: &mut []u8, value: i64, wide: bool) {
    b.constant(&mut out, value)
    if wide { b.op(&mut out, 191) } else { b.op(&mut out, 167); b.op(&mut out, 190) }
}
fn compare_fp(out: &mut []u8, src: i32, right: i32, wide: bool) {
    var base := 91
    if wide { base = 97 }
    // AArch64 FCMP distinguishes unordered (0011), less (1000), equal
    // (0110), and greater (0010) in NZCV. An ordered >= sets C, as does NaN.
    read_fp(&mut out, src, wide); read_fp(&mut out, right, wide); b.op(&mut out, base + 2)
    b.op(&mut out, 173); put_global(&mut out, 32)
    read_fp(&mut out, src, wide); read_fp(&mut out, right, wide); b.op(&mut out, base)
    b.op(&mut out, 173); put_global(&mut out, 33)
    global(&mut out, 32); b.constant(&mut out, 1); b.op(&mut out, 133); put_global(&mut out, 34)
    read_fp(&mut out, src, wide); read_fp(&mut out, src, wide); b.op(&mut out, base + 1)
    read_fp(&mut out, right, wide); read_fp(&mut out, right, wide); b.op(&mut out, base + 1)
    b.op(&mut out, 114); b.op(&mut out, 173); put_global(&mut out, 35)
}
fn round_away(out: &mut []u8, src: i32, dst: i32, wide: bool) {
    var shift := 0; var fp_type := 125
    var half: i64 = 1056964608; var one: i64 = 1065353216
    if wide { shift = 14; fp_type = 124; half = 4602678819172646912; one = 4607182418800017408 }
    // Abs and subtraction preserve the half-way boundary just below 0.5.
    // Save the floor bits before selecting the signed, rounded result.
    read_fp(&mut out, src, wide); b.op(&mut out, 139 + shift); b.op(&mut out, 142 + shift)
    if wide { b.op(&mut out, 189) } else { b.op(&mut out, 188); b.op(&mut out, 173) }
    save(&mut out, 0)
    read_fp(&mut out, src, wide); b.op(&mut out, 139 + shift)
    local(&mut out, 0)
    if wide { b.op(&mut out, 191) } else { b.op(&mut out, 167); b.op(&mut out, 190) }
    b.op(&mut out, 147 + shift); bits_fp(&mut out, half, wide)
    if wide { b.op(&mut out, 102) } else { b.op(&mut out, 96) }
    b.op(&mut out, 4); b.op(&mut out, fp_type)
    local(&mut out, 0)
    if wide { b.op(&mut out, 191) } else { b.op(&mut out, 167); b.op(&mut out, 190) }
    bits_fp(&mut out, one, wide); b.op(&mut out, 146 + shift)
    b.op(&mut out, 5); local(&mut out, 0)
    if wide { b.op(&mut out, 191) } else { b.op(&mut out, 167); b.op(&mut out, 190) }
    b.op(&mut out, 11); read_fp(&mut out, src, wide); b.op(&mut out, 152 + shift)
    write_fp(&mut out, dst, wide)
}
fn floating(out: &mut []u8, w: i64) -> bool {
    dst := b.bits(w, 0, 31); src := b.bits(w, 5, 31); right := b.bits(w, 16, 31)
    wide := b.bits(w, 22, 1) != 0
    var shift := 0; if wide { shift = 14 }
    kind := w.bit_and(4294966272)
    if kind == 505872384 || kind == 2657550336 {
        b.read(&mut out, src); narrow(&mut out, wide); put_global(&mut out, 36 + dst); return true
    }
    if kind == 505806848 || kind == 2657484800 {
        global(&mut out, 36 + src); narrow(&mut out, wide); b.write(&mut out, dst); return true
    }
    binary := w.bit_and(4280351744)
    var op := 0
    if binary == 505423872 { op = 146 } else if binary == 505427968 { op = 147 }
    else if binary == 505415680 { op = 148 } else if binary == 505419776 { op = 149 }
    if op != 0 {
        read_fp(&mut out, src, wide); read_fp(&mut out, right, wide)
        b.op(&mut out, op + shift); write_fp(&mut out, dst, wide); return true
    }
    if w.bit_and(4280351775) == 505421824 { compare_fp(&mut out, src, right, wide); return true }
    if kind == 509755392 || kind == 505593856 {
        read_fp(&mut out, src, wide)
        if wide { b.op(&mut out, 182) } else { b.op(&mut out, 187) }
        write_fp(&mut out, dst, !wide); return true
    }
    unary := w.bit_and(4290771968)
    if unary == 2653028352 || unary == 2653093888 {
        b.read(&mut out, src)
        var ins := 180; if wide { ins = 185 }
        if unary == 2653093888 { ins = ins + 1 }
        b.op(&mut out, ins); write_fp(&mut out, dst, wide); return true
    }
    if unary == 2654470144 || unary == 2654535680 {
        read_fp(&mut out, src, wide)
        var ins := 4; if wide { ins = 6 }; if unary == 2654535680 { ins = ins + 1 }
        // Raw FCVTZ saturates. Language casts already branch on range and NaN.
        b.indexed(&mut out, 252, ins); b.write(&mut out, dst); return true
    }
    if unary == 505823232 { round_away(&mut out, src, dst, wide); return true }
    if unary == 505462784 { op = 139 } else if unary == 505495552 { op = 140 }
    else if unary == 505724928 { op = 141 } else if unary == 505757696 { op = 142 }
    else if unary == 505790464 { op = 143 } else if unary == 505692160 { op = 144 }
    else if unary == 505528320 { op = 145 } else { return false }
    read_fp(&mut out, src, wide); b.op(&mut out, op + shift); write_fp(&mut out, dst, wide)
    true
}
pub fn word(out: &mut []u8, w: i64) -> bool {
    if w.bit_and(503316480) == 503316480 && floating(&mut out, w) { return true }
    if w.bit_and(520093696) == 285212672 { return arithmetic(&mut out, w, true, false) }
    if w.bit_and(522190848) == 184549376 { return arithmetic(&mut out, w, false, false) }
    if w.bit_and(520093696) == 167772160 { return arithmetic(&mut out, w, false, true) }
    family := w.bit_and(2139095040)
    if family == 318767104 || family == 1392508928 { return field(&mut out, w, family == 318767104) }
    rd := b.bits(w, 0, 31); rn := b.bits(w, 5, 31); rm := b.bits(w, 16, 31)
    wide := w >= 2147483648
    if w.bit_and(520093696) == 452984832 {
        kind := b.bits(w, 21, 7)
        if kind == 2 || kind == 6 { multiply_high(&mut out, rn, rm, kind == 2) }
        else if kind == 0 {
            b.read(&mut out, b.bits(w, 10, 31)); b.read(&mut out, rn); b.read(&mut out, rm)
            b.op(&mut out, 126)
            if b.bits(w, 15, 1) != 0 { b.op(&mut out, 125) } else { b.op(&mut out, 124) }
            narrow(&mut out, wide)
        } else { return false }
        b.write(&mut out, rd); return true
    }
    if w.bit_and(534773760) == 448790528 {
        operation := b.bits(w, 10, 63)
        if operation == 2 || operation == 3 { divide(&mut out, wide, operation == 3, rn, rm) }
        else if operation >= 8 && operation <= 10 {
            var opcode := 134
            if operation == 9 { opcode = 136 } else if operation == 10 { opcode = 135 }
            b.read(&mut out, rn); if !wide { b.op(&mut out, 167) }
            b.read(&mut out, rm); if !wide { b.op(&mut out, 167); opcode = opcode - 18 }
            b.op(&mut out, opcode); if !wide { b.op(&mut out, 173) }
        } else { return false }
        b.write(&mut out, rd); return true
    }
    if w.bit_and(4294905824) == 2594113504 {
        condition(&mut out, b.bits(w, 12, 15).bit_xor(1)); b.op(&mut out, 173); b.write(&mut out, rd); return true
    }
    false
}
