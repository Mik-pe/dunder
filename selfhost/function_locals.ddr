// LocalID is a declaration ordinal within a function. The lexical stack
// controls visibility. Leaving a scope does not invalidate typed operands
// that still refer to an earlier binding.
pub struct Table {
    names: []string, types: []i32, mutable: []bool, scopes: []i32,
    tokens: []i32, active: []i32,
}
pub fn new() -> Table { Table { names: [], types: [], mutable: [], scopes: [], tokens: [], active: [] } }
pub fn clear(t: &mut Table) {
    t.names.clear(); t.types.clear(); t.mutable.clear(); t.scopes.clear()
    t.tokens.clear(); t.active.clear()
}
pub fn add(t: &mut Table, move name: string, ty: i32, mutable: bool, scope: i32, token: i32) -> i32 {
    id := t.names.len
    t.names.push(move name); t.types.push(ty); t.mutable.push(mutable)
    t.scopes.push(scope); t.tokens.push(token); t.active.push(id)
    id
}
pub fn resolve(t: &Table, name: string) -> i32 {
    if name == "_" { return -1 }
    mut i := t.active.len
    while i > 0 {
        i = i - 1; id := t.active[i]
        if t.names[id] == name { return id }
    }
    -1
}
pub fn first_in_scope(t: &Table, limit: i32, scope: i32) -> i32 {
    mut first := t.active.len
    while first > limit && t.scopes[t.active[first - 1]] == scope { first = first - 1 }
    first
}

@test fn leaving_a_scope_keeps_its_local_ids_and_restores_shadowed_names() {
    mut t := new()
    outer := add(&mut t, "value", 3, false, 0, 1)
    inner := add(&mut t, "value", 1, true, 1, 8)
    assert(resolve(&t, "value") == inner && first_in_scope(&t, 0, 1) == 1)
    _ := t.active.pop()
    assert(resolve(&t, "value") == outer)
    next := add(&mut t, "value", 4, false, 1, 23)
    assert(next != inner && resolve(&t, "value") == next)
    assert(t.types[inner] == 1 && t.mutable[inner] && t.tokens[inner] == 8)
    clear(&mut t)
    assert(resolve(&t, "value") == -1 && add(&mut t, "x", 2, false, 0, 0) == 0)
}
