// Validated edits to the unfinalized suffix of the shared ARM vocabulary.
// The append-only prefix is trusted and never rewritten. Import sites are byte
// offsets for two-word address records; deleting imports also needs their slot
// table, so this API deliberately rejects any edit that touches an import.
import arm64 as arm

pub opaque struct Workspace {
    starts: []i32, ends: []i32, map: []i32,
    valid: bool, mapped: bool, first: i32,
    prepared: bool, code_done: bool, imports_done: bool,
    first_label: i32, first_reloc: i32, first_import: i32,
    words: i32, labels: i32, relocs: i32, imports: i32,
}
pub fn new() -> Workspace { Workspace { starts: [], ends: [], map: [], valid: true, mapped: false, first: 0,
    prepared: false, code_done: false, imports_done: false,
    first_label: 0, first_reloc: 0, first_import: 0, words: 0, labels: 0, relocs: 0, imports: 0 } }
pub fn reset(work: &mut Workspace) {
    while work.starts.len > 0 { removed := work.starts.pop() }
    while work.ends.len > 0 { removed := work.ends.pop() }
    while work.map.len > 0 { removed := work.map.pop() }
    work.valid = true; work.mapped = false; work.first = 0; work.prepared = false
}
// Absolute word ranges must already be ordered. A rejected edit poisons the
// complete plan until reset, even if a caller forgets to inspect this result.
pub fn add_range(work: &mut Workspace, start: i32, end: i32) -> bool {
    work.mapped = false
    if work.prepared { work.valid = false; return false }
    if !work.valid { return false }
    if start < 0 || start >= end { work.valid = false; return false }
    if work.ends.len > 0 && start < work.ends[work.ends.len - 1] { work.valid = false; return false }
    work.starts.push(start); work.ends.push(end); true
}
// Available after a successful nonempty preparation, including the old end.
// Every removed boundary collapses to the start of its removal range.
pub fn boundary(work: &Workspace, word: i32) -> i32 {
    if !work.mapped || word < work.first || word - work.first >= work.map.len { return -1 }
    work.map[word - work.first]
}
fn width(kind: i32) -> i32 { if kind >= 2 { 2 } else { 1 } }

pub fn prepare(work: &mut Workspace, code: &arm.Code,
    first_word: i32, first_label: i32, first_reloc: i32,
    import_sites: &[]i32, first_import: i32) -> bool {
    // A prepared plan is immutable until reset, including between commits.
    if work.prepared { return false }
    work.mapped = false
    if !work.valid { return false }
    // The common no-edit path allocates and scans nothing.
    if work.starts.len == 0 { work.prepared = true; work.code_done = false; work.imports_done = false; return true }
    count := code.words.len
    if code.checking || first_word < 0 || first_word > count ||
        first_label < 0 || first_label > code.labels.len ||
        first_reloc < 0 || first_reloc > code.at.len ||
        first_import < 0 || first_import > import_sites.len ||
        code.at.len != code.target.len || code.at.len != code.kinds.len { return false }
    // Only the boundary of the trusted prefix is inspected. Repeated suffix
    // rewrites must not rescan all earlier functions and become quadratic.
    if first_reloc > 0 {
        previous := first_reloc - 1; kind := code.kinds[previous]
        if kind < 0 || kind > 20 || code.at[previous] < 0 || code.at[previous] > first_word - width(kind) { return false }
    }
    if first_import > 0 {
        site := import_sites[first_import - 1]
        if site < 0 || site % 4 != 0 || site / 4 > first_word - 2 { return false }
    }
    for i in 0..work.starts.len {
        if work.starts[i] < first_word || work.ends[i] > count { return false }
    }
    // There is one entry per word boundary, not a second instruction program.
    // Pop retains the primitive array capacity and is frozen-seed compatible.
    while work.map.len > 0 { removed := work.map.pop() }
    var edit := 0; var destination := first_word
    work.map.push(destination)
    for source in first_word..count {
        if code.words[source] < 0 || code.words[source] > 4294967295 { return false }
        while edit < work.ends.len && source >= work.ends[edit] { edit = edit + 1 }
        if edit == work.starts.len || source < work.starts[edit] { destination = destination + 1 }
        work.map.push(destination)
    }
    // Merge symbolic records in word order. This catches overlaps both within
    // one table and between relocation and import records. Temporarily negative
    // interior boundaries forbid labels that enter the second half of a pair.
    var reloc := first_reloc; var imported := first_import; var previous_end := first_word
    while reloc < code.at.len || imported < import_sites.len {
        var take_reloc := reloc < code.at.len
        if imported < import_sites.len {
            if import_sites[imported] < 0 || import_sites[imported] % 4 != 0 { return false }
            if take_reloc { take_reloc = code.at[reloc] <= import_sites[imported] / 4 }
        }
        var at := 0; var size := 2
        if take_reloc {
            at = code.at[reloc]; kind := code.kinds[reloc]
            if kind < 0 || kind > 20 { return false }
            size = width(kind)
            target := code.target[reloc]
            if target < 0 || target >= code.labels.len { return false }
            position := code.labels[target]
            if target < first_label {
                // Forward targets may still be unmarked, including new data
                // and callback labels marked by image finalization. An earlier
                // entry marked exactly at first_word remains at that address.
                if position < -1 || position > first_word { return false }
            } else if position != -1 && (position < first_word || position > count) { return false }
        } else { at = import_sites[imported] / 4 }
        if at < previous_end || at > count - size { return false }
        kept := work.map[at + size - first_word] - work.map[at - first_word]
        if take_reloc {
            if kept != 0 && kept != size { return false }
            // Rewrites run before target finishing, while relocation words
            // retain their canonical placeholder representation.
            if code.words[at] != 0 { return false }
            if size == 2 && code.words[at + 1] != 3573751839 { return false }
            reloc = reloc + 1
        } else {
            if kept != size || code.words[at + 1] != 0 { return false }
            if code.words[at] != 0 && code.words[at] != 4244635648 { return false }
            imported = imported + 1
        }
        if size == 2 {
            interior := at + 1 - first_word
            work.map[interior] = -work.map[interior] - 1
        }
        previous_end = at + size
    }
    for i in first_label..code.labels.len {
        position := code.labels[i]
        if position < -1 || position > count { return false }
        if position >= 0 {
            if position < first_word || work.map[position - first_word] < 0 { return false }
        }
    }
    // Everything above is validation or workspace scratch. Only now may any
    // code/label/relocation/import storage change, so failure is atomic.
    for i in 0..work.map.len { if work.map[i] < 0 { work.map[i] = -work.map[i] - 1 } }
    work.first = first_word; work.first_label = first_label; work.first_reloc = first_reloc; work.first_import = first_import
    work.words = count; work.labels = code.labels.len; work.relocs = code.at.len; work.imports = import_sites.len
    work.mapped = true; work.prepared = true; work.code_done = false; work.imports_done = false; true
}
// No code or import mutation may occur between prepare and these commits.
// Separate commits avoid borrowing two fields of one compiler root mutably.
// Each commit consumes its part of the plan and checks the captured shape.
pub fn commit_code(work: &mut Workspace, code: &mut arm.Code) {
    assert(work.valid && work.prepared && !work.code_done)
    work.code_done = true
    if work.starts.len == 0 { return }
    assert(!code.checking && code.words.len == work.words && code.labels.len == work.labels)
    assert(code.at.len == work.relocs && code.target.len == work.relocs && code.kinds.len == work.relocs)
    first_word := work.first; first_label := work.first_label; first_reloc := work.first_reloc; count := work.words
    for i in first_word..count {
        offset := i - first_word
        if work.map[offset + 1] > work.map[offset] { code.words[work.map[offset]] = code.words[i] }
    }
    for i in first_label..code.labels.len {
        position := code.labels[i]
        if position >= 0 { code.labels[i] = work.map[position - first_word] }
    }
    var retained := first_reloc
    for i in first_reloc..code.at.len {
        at := code.at[i] - first_word
        if work.map[at + width(code.kinds[i])] > work.map[at] {
            code.at[retained] = work.map[at]; code.target[retained] = code.target[i]; code.kinds[retained] = code.kinds[i]
            retained = retained + 1
        }
    }
    while code.at.len > retained {
        at := code.at.pop(); target := code.target.pop(); kind := code.kinds.pop()
    }
    destination := work.map[work.map.len - 1]
    while code.words.len > destination { removed := code.words.pop() }
}
pub fn commit_imports(work: &mut Workspace, import_sites: &mut []i32) {
    assert(work.valid && work.prepared && !work.imports_done)
    work.imports_done = true
    if work.starts.len == 0 { return }
    assert(import_sites.len == work.imports)
    for i in work.first_import..import_sites.len { import_sites[i] = work.map[import_sites[i] / 4 - work.first] * 4 }
}
// Convenience for callers with independently borrowable code and import arrays.
pub fn compact(work: &mut Workspace, code: &mut arm.Code,
    first_word: i32, first_label: i32, first_reloc: i32,
    import_sites: &mut []i32, first_import: i32) -> bool {
    if !prepare(&mut work, &code, first_word, first_label, first_reloc, &import_sites, first_import) { return false }
    commit_code(&mut work, &mut code); commit_imports(&mut work, &mut import_sites); true
}
