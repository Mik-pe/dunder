// A retained encoding is a cache of the canonical operation, not a second
// semantic authority. Re-decode it and compare exact scalar fields before
// replay. The scratch record is reused for every operation in a function.
import mir
import mir_decode as decode

fn equal(d: &decode.Decoded, f: &mir.Function, op: i32) -> bool {
    if f.kinds[op] != d.kind || f.opcodes[op] != d.opcode ||
        f.dst[op] != d.dst || f.a[op] != d.a || f.b[op] != d.b || f.c[op] != d.c ||
        f.imm[op] != d.imm || f.aux[op] != d.aux || f.variant[op] != d.variant ||
        f.types[op] != d.types || f.extensions[op] != d.extension ||
        f.effects[op] != d.effects || f.flags[op] != d.flags || f.abi[op] != d.abi ||
        f.reads[op] != d.reads || f.writes[op] != d.writes || f.clobbers[op] != d.clobbers { return false }
    p := f.place[op]
    if d.place_kind < 0 { return p == -1 }
    if p < 0 || p >= f.place_kinds.len { return false }
    f.place_kinds[p] == d.place_kind && f.place_offsets[p] == d.place_offset && f.place_widths[p] == d.place_width
}
fn frame_slot(f: &mir.Function, first: i32, end: i32, recipe: i32) -> i32 {
    width := end - first; word := f.raw[first]
    var magnitude: i64 = 0
    if recipe != 3 && width == 1 {
        offset := i32(word.shr(12).bit_and(511)); var signed := offset
        if signed >= 256 { signed = signed - 512 }
        magnitude = -i64(signed)
    } else if (recipe == 3 && width == 1) || (recipe != 3 && width == 2) {
        magnitude = word.shr(10).bit_and(4095)
    } else {
        magnitude = word.shr(5).bit_and(65535)
        var stop := end - 2; if recipe == 3 { stop = end - 1 }
        for at in first + 1..stop {
            part := i32(f.raw[at].shr(21).bit_and(3))
            magnitude = magnitude.bit_or(f.raw[at].shr(5).bit_and(65535).shl(part * 16))
        }
    }
    if magnitude < 8 || magnitude > 2147483640 || magnitude % 8 != 0 { return -1 }
    i32(magnitude / 8) - 1
}

pub fn validate(d: &mut decode.Decoded, f: &mir.Function, op: i32) -> bool {
    if op < 0 || op >= f.kinds.len || f.recipes.len != f.kinds.len { return false }
    if f.modes[op] != 0 { return true }
    first := f.raw_starts[op]; width := f.widths[op]
    if first < 0 || width < 1 || width > f.raw.len || first > f.raw.len - width { return false }
    end := first + width; recipe := f.recipes[op]
    for at in first..end { if f.raw[at] < 0 || f.raw[at] > 4294967295 { return false } }
    if recipe == 0 {
        if width != 1 || f.reloc_kinds[op] != -1 || f.import_ids[op] != -1 || f.targets[op] != -1 { return false }
        decode.decode_into(&mut d, f.raw[first], f.platform)
    } else if recipe >= 1 && recipe <= 3 {
        if f.reloc_kinds[op] != -1 || f.import_ids[op] != -1 || f.targets[op] != -1 { return false }
        slot := frame_slot(&f, first, end, recipe); reg := i32(f.raw[end - 1].bit_and(31))
        if slot < 0 || !decode.valid_frame_encoding(&f.raw, first, end, recipe, slot, reg) { return false }
        decode.frame(&mut d, recipe, slot, reg, width)
        if recipe != 2 && reg == 29 && f.optimizable { return false }
    } else if recipe == 4 {
        kind := f.reloc_kinds[op]; var expected := 1; if kind >= 2 { expected = 2 }
        if width != expected || f.raw[first] != 0 || f.import_ids[op] != -1 ||
            f.targets[op] < 0 || f.targets[op] >= f.source_labels { return false }
        if width == 2 && f.raw[first + 1] != 3573751839 { return false }
        if !decode.symbolic(&mut d, kind) { return false }
    } else if recipe == 5 {
        if width != 2 || f.raw[first + 1] != 0 || f.reloc_kinds[op] != -1 || f.targets[op] != -1 ||
            f.import_ids[op] < f.first_import || f.import_ids[op] >= f.source_imports { return false }
        if !decode.imported(&mut d, f.raw[first]) { return false }
    } else { return false }
    equal(&d, &f, op)
}
