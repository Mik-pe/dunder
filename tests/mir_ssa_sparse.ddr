// The driver executes natively and on Wasm. Its closed byte interpreter
// executes the final relocated ARM vocabulary; it does not claim native/Wasm
// machine-code execution of these generated kernels (the external matrix does).
import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_lower as lower
import ..selfhost.mir_ssa as ssa

fn add(c: &mut arm.Code, dst: i32, a: i32, b: i32) { arm.emit(&mut c, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst)) }
fn kernel(loop: bool) -> arm.Code {
    var c := arm.new(); arm.begin_mir(&mut c, true)
    frame := arm.prologue(&mut c); arm.frame(&mut c, frame, 132)
    // These129 independent full-cell definitions are ALL needed after the
    // entry edge. In the straight kernel they are every demanded frame value,
    // so the live-out set has two complete64-bit words, not just >128 total
    // (mostly dead) definitions. No particular internal value ID is asserted.
    for cell in 0..129 { arm.imm(&mut c, 0, i64(cell) * 3 + 1); arm.store(&mut c, cell, 0) }
    if loop { arm.imm(&mut c, 0, 0); arm.store(&mut c, 129, 0); arm.store(&mut c, 130, 0) }
    head := arm.label(&mut c); done := arm.label(&mut c); arm.branch(&mut c, head, 0); arm.mark(&mut c, head)
    if loop {
        arm.load(&mut c, 129); arm.imm(&mut c, 1, 3)
        arm.emit(&mut c, 3942645791 + 65536); arm.branch(&mut c, done, 2)
        arm.load_into(&mut c, 130, 2)
    } else { arm.imm(&mut c, 2, 0) }
    for cell in 0..129 {
        arm.load(&mut c, cell); add(&mut c, 2, 2, 0)
        arm.load(&mut c, cell); add(&mut c, 2, 2, 0)
        // Make two distant cell webs the allocator's first choices. Losing a
        // high live-out bit must not merely reduce pressure on unplaced cells.
        if cell == 63 || cell == 127 { arm.load(&mut c, cell); add(&mut c, 2, 2, 0) }
    }
    if loop {
        arm.store(&mut c, 130, 2); arm.load(&mut c, 129); arm.imm(&mut c, 1, 1)
        add(&mut c, 0, 0, 1); arm.store(&mut c, 129, 0); arm.branch(&mut c, head, 0)
        arm.mark(&mut c, done); arm.load(&mut c, 130)
    } else { arm.mark(&mut c, done); arm.mov(&mut c, 0, 2) }
    arm.ret(&mut c); arm.end_mir(&mut c); c
}
fn model(c: &arm.Code) -> mir.Function {
    var f := mir.new(); none: []i32 = []
    assert(lift.lift_spans(&mut f, &c, 0, 0, 0, &none, 0,
        &c.mir_starts, &c.mir_ends, &c.mir_kinds, &c.mir_a, &c.mir_b))
    assert(verify.verify(&mut f)); f
}
fn word(bytes: &[]u8, pc: i32) -> i64 {
    assert(pc >= 0 && pc + 4 <= bytes.len && pc % 4 == 0)
    i64(bytes[pc]) + i64(bytes[pc + 1]) * 256 + i64(bytes[pc + 2]) * 65536 + i64(bytes[pc + 3]) * 16777216
}
fn signed(bits: i64, width: i32) -> i64 {
    limit := i64(1).shl(width); if bits >= limit / 2 { bits - limit } else { bits }
}
fn index(address: i64) -> i32 { assert(address >= 0 && address < 8192 && address % 8 == 0); i32(address / 8) }
fn gp(regs: &[]i64, reg: i32) -> i64 { if reg == 31 { 0 } else { regs[reg] } }
// Closed, independently decoded subset: full-cell memory, GP moves/adds,
// immediates, CMP/BEQ/B, and the standard frame. Unknown bytes fail the test.
fn execute(bytes: &[]u8) -> i64 {
    var regs: []i64 = []; var mem: []i64 = []
    for reg in 0..32 { regs.push(i64(reg) * 1009 + 17) }; regs[31] = 4096
    for cell in 0..1024 { mem.push(0) }
    saved_fp := regs[29]; saved_lr := regs[30]; var pc := 0; var equal := false; var fuel := 20000
    while fuel > 0 {
        fuel = fuel - 1; w := word(&bytes, pc); var next := pc + 4
        dst := i32(w.bit_and(31)); a := i32(w.shr(5).bit_and(31)); b := i32(w.shr(16).bit_and(31))
        if w == 2847898621 {
            regs[31] = regs[31] - 16; mem[index(regs[31])] = regs[29]; mem[index(regs[31] + 8)] = regs[30]
        } else if w == 2831252477 {
            regs[29] = mem[index(regs[31])]; regs[30] = mem[index(regs[31] + 8)]; regs[31] = regs[31] + 16
        } else if w == 3596551104 {
            assert(regs[31] == 4096 && regs[29] == saved_fp && regs[30] == saved_lr); return regs[0]
        } else if w == 3573751839 {
        } else if w.bit_and(4286578688) == 3531603968 {
            regs[dst] = w.shr(5).bit_and(65535).shl(i32(w.shr(21).bit_and(3)) * 16)
        } else if w.bit_and(4286578688) == 4068474880 {
            shift := i32(w.shr(21).bit_and(3)) * 16
            regs[dst] = regs[dst].bit_and(i64(65535).shl(shift).bit_not()).bit_or(w.shr(5).bit_and(65535).shl(shift))
        } else if w.bit_and(4292935648) == 2852127712 {
            assert(dst != 31); regs[dst] = gp(&regs, b)
        } else if w.bit_and(4286578688) == 2432696320 || w.bit_and(4286578688) == 3506438144 {
            amount := w.shr(10).bit_and(4095).shl(i32(w.shr(22).bit_and(1)) * 12)
            if w.bit_and(1073741824) != 0 { regs[dst] = regs[a] - amount } else { regs[dst] = regs[a] + amount }
        } else if w.bit_and(4292934656) == 2332033024 {
            assert(dst != 31); regs[dst] = gp(&regs, a).wrapping_add(gp(&regs, b))
        } else if w.bit_and(4292934687) == 3942645791 {
            equal = gp(&regs, a) == gp(&regs, b)
        } else if w.bit_and(4292873216) == 4160749568 || w.bit_and(4292873216) == 4164943872 {
            address := regs[a] + signed(w.shr(12).bit_and(511), 9)
            if w.bit_and(4194304) != 0 { assert(dst != 31); regs[dst] = mem[index(address)] }
            else { mem[index(address)] = gp(&regs, dst) }
        } else if w.bit_and(4290772992) == 4177526784 || w.bit_and(4290772992) == 4181721088 {
            address := regs[a] + w.shr(10).bit_and(4095) * 8
            if w.bit_and(4194304) != 0 { assert(dst != 31); regs[dst] = mem[index(address)] }
            else { mem[index(address)] = gp(&regs, dst) }
        } else if w.bit_and(4227858432) == 335544320 {
            next = pc + i32(signed(w.bit_and(67108863), 26)) * 4
        } else if w.bit_and(4278190096) == 1409286144 {
            assert(w.bit_and(15) == 0); if equal { next = pc + i32(signed(w.shr(5).bit_and(524287), 19)) * 4 }
        } else { assert(false) }
        pc = next
    }
    assert(false); 0
}
fn check(loop: bool) {
    var c := kernel(loop); var baseline := kernel(loop); original := arm.finish(&mut baseline)
    var f := model(&c); var work := ssa.new(); var lowering := lower.new(); var sites: []i32 = []; var important: []i32 = []
    var needed_cells := 0
    for place in 0..f.place_kinds.len { if f.place_kinds[place] == 1 && f.place_widths[place] == 8 { needed_cells = needed_cells + 1 } }
    assert(needed_cells >= 129)
    for op in 0..f.kinds.len {
        if f.kinds[op] == 7 && (f.imm[op] == -512 || f.imm[op] == -1024) { important.push(op) }
    }
    // Deliberately high-pressure regression budget; production remains4M.
    // Every overlap is genuine, unlike the old dense empty-state work.
    assert(ssa.optimize_budget(&mut work, &mut f, 33554432))
    assert(ssa.status(&work) == 2 && f.verified && ssa.cells(&work) > 0 && ssa.registers(&work) > 0)
    assert(ssa.removed_loads(&work) > 0 && ssa.values(&work) > 128)
    if loop { assert(ssa.parameters(&work) >= 2) }
    assert(important.len == 6)
    for at in 0..important.len { assert(f.modes[important[at]] == 1 && f.kinds[important[at]] == 2) }
    assert(lower.prepare(&mut lowering, &f, &c, &sites)); lower.commit_code(&mut lowering, &mut c); lower.commit_imports(&mut lowering, &mut sites)
    result := arm.finish(&mut c); var expected: i64 = 0
    for cell in 0..129 { expected = expected + 2 * (i64(cell) * 3 + 1) }
    expected = expected + (63 * 3 + 1) + (127 * 3 + 1); if loop { expected = expected * 3 }
    assert(execute(&original) == expected && execute(&result) == expected)
}
@test fn complete_live_out_words_keep_high_bits_through_real_placement() { check(false) }
@test fn wide_live_out_and_loop_phi_transport_preserve_byte_arithmetic() { check(true) }
fn main() {}
