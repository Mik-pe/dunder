capability process
import ..stdlib.process as process
import std.bytes

fn main() {
    assert(process.env_or("DUNDER_ENV_CHANGED", "") == "original")
    assert(process.env_or("DUNDER_ENV_DELETED", "") == "delete-me")
    result := process.Command::new("sh", ["-c", "printf '%s' \"$DUNDER_ENV_CHANGED|$DUNDER_ENV_DELETED\""]).exec()
    assert(result.ok && result.code == 0 && result.signal == 0)
    assert(bytes.decode(&result.stdout).unwrap() == "original|delete-me")
    print("pure inherited environment")
}
