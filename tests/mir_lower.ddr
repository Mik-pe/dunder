import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_lower as lower
import ..selfhost.mir_contract as contract

fn same_i32(a: &[]i32, b: &[]i32) { assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) } }
fn same_i64(a: &[]i64, b: &[]i64) { assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) } }
fn lifted(code: &arm.Code, sites: &[]i32, word: i32, label: i32, reloc: i32, imported: i32) -> mir.Function {
    var f := mir.new(); assert(lift.lift(&mut f, &code, word, label, reloc, &sites, imported))
    assert(verify.verify(&mut f)); f
}
@test fn exact_lowering_preserves_every_symbolic_pair_and_target_platform() {
    var work := lower.new()
    for platform in 0..4 {
        for kind in 0..21 {
            var code := arm.new_for(platform); target := arm.label(&mut code)
            arm.imm(&mut code, 0, -9223372036854775808); arm.mark(&mut code, target)
            arm.branch(&mut code, target, kind)
            pending := arm.label(&mut code)
            words := code.words; labels := code.labels; at := code.at; targets := code.target; kinds := code.kinds
            var sites: []i32 = []; f := lifted(&code, &sites, 0, 0, 0, 0)
            assert(lower.prepare(&mut work, &f, &code, &sites))
            lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
            same_i64(&words, &code.words); same_i32(&labels, &code.labels)
            same_i32(&at, &code.at); same_i32(&targets, &code.target); same_i32(&kinds, &code.kinds)
            assert(code.labels[pending] == -1)
        }
    }
}
@test fn exact_suffix_keeps_prefix_import_slots_and_trailing_initializer() {
    var code := arm.new(); external := arm.label(&mut code)
    arm.emit(&mut code, 0); arm.emit(&mut code, 0)
    var sites: []i32 = [0]
    entry := arm.label(&mut code); first := code.words.len; first_label := code.labels.len
    arm.mark(&mut code, entry)
    body := arm.label(&mut code); init := arm.label(&mut code); pending := arm.label(&mut code)
    arm.branch(&mut code, init, 0); arm.mark(&mut code, body)
    arm.emit(&mut code, 4294967295)
    sites.push(code.words.len * 4); arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0)
    arm.branch(&mut code, external, 20); arm.ret(&mut code)
    arm.mark(&mut code, init); arm.imm(&mut code, 0, 0); arm.branch(&mut code, body, 0)
    words := code.words; labels := code.labels; at := code.at; targets := code.target; kinds := code.kinds; imports := sites
    f := lifted(&code, &sites, first, first_label, 0, 1); assert(f.unknown_control)
    var work := lower.new(); assert(lower.prepare(&mut work, &f, &code, &sites))
    lower.commit_imports(&mut work, &mut sites); lower.commit_code(&mut work, &mut code)
    same_i64(&words, &code.words); same_i32(&labels, &code.labels); same_i32(&imports, &sites)
    same_i32(&at, &code.at); same_i32(&targets, &code.target); same_i32(&kinds, &code.kinds)
    assert(code.labels[entry] == first && code.labels[pending] == -1)
}
@test fn owned_preallocated_entry_remains_at_the_function_boundary() {
    var code := arm.new(); entry := arm.label(&mut code)
    arm.emit(&mut code, 3573751839); first := code.words.len
    arm.mark(&mut code, entry); arm.imm(&mut code, 0, 7); arm.ret(&mut code)
    var sites: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, first, code.labels.len, 0, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry)); assert(verify.verify(&mut f))
    var work := lower.new(); assert(lower.prepare(&mut work, &f, &code, &sites))
    lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
    assert(code.labels[entry] == first)
}
@test fn canonical_w_values_zero_extend_and_x_values_preserve_their_bits() {
    values: []i64 = [-2147483648, -1, 0, 2147483647, 2147483648, 4294967295]
    for value in values {
        var code := arm.new(); arm.imm(&mut code, 0, 0); arm.ret(&mut code)
        var sites: []i32 = []; var f := lifted(&code, &sites, 0, 0, 0, 0)
        f.modes[0] = 1; f.types[0] = 1; f.imm[0] = i64(value)
        assert(verify.verify(&mut f)); var work := lower.new()
        assert(lower.prepare(&mut work, &f, &code, &sites))
        lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
        bits := i64(value).bit_and(4294967295)
        assert(code.words[0] == 1384120320 + bits.bit_and(65535) * 32)
        if bits.shr(16) != 0 { assert(code.words[1] == 1923088384 + bits.shr(16) * 32) }
    }
    for width in [1, 2] {
        var code := arm.new(); arm.mov(&mut code, 0, 1); arm.ret(&mut code)
        var sites: []i32 = []; var f := lifted(&code, &sites, 0, 0, 0, 0)
        f.modes[0] = 1; f.types[0] = width; assert(verify.verify(&mut f))
        var work := lower.new(); assert(lower.prepare(&mut work, &f, &code, &sites))
        lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
        var expected: i64 = 704709600; if width == 2 { expected = 2852193248 }
        assert(code.words[0] == expected)
    }
}
@test fn new_constants_deleted_operations_and_import_sites_recompute_layout() {
    var code := arm.new(); label := arm.label(&mut code)
    arm.imm(&mut code, 0, 7); arm.imm(&mut code, 1, 8); arm.mark(&mut code, label)
    arm.emit(&mut code, 0); arm.emit(&mut code, 0); arm.ret(&mut code)
    var sites: []i32 = [8]; var f := lifted(&code, &sites, 0, 0, 0, 0)
    f.modes[0] = 1; f.types[0] = 2; f.imm[0] = -1
    f.modes[1] = 2
    assert(verify.verify(&mut f))
    var work := lower.new(); assert(lower.prepare(&mut work, &f, &code, &sites))
    lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
    var expected := arm.new(); arm.imm(&mut expected, 0, -1)
    assert(code.labels[label] == expected.words.len && sites[0] == expected.words.len * 4)
    arm.emit(&mut expected, 0); arm.emit(&mut expected, 0); arm.ret(&mut expected)
    same_i64(&expected.words, &code.words)
}
@test fn canonical_frame_load_store_has_explicit_large_offset_scratch() {
    for access in [7, 8] {
        for offset in [-8, -256, -264, -4096, -4104, 32760, 32768] {
            var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 512)
            memory_word := code.words.len; arm.imm(&mut code, 0, 1); arm.ret(&mut code)
            var sites: []i32 = []; var f := lifted(&code, &sites, 0, 0, 0, 0)
            id := mir.boundary(&f, memory_word); assert(id >= 0)
            p := mir.add_place(&mut f, 1, offset, 8, 0)
            f.kinds[id] = access; f.modes[id] = 1; f.dst[id] = 0; f.a[id] = 29
            f.place[id] = p; f.imm[id] = i64(offset); f.aux[id] = 8
            // The 4096-byte allocation proves only its own negative range.
            // Accesses outside it retain MayTrap, even when FP-relative.
            inside := offset >= -4096 && offset <= -8
            assert(contract.frame_capacity(&f) == 4096)
            assert(contract.frame_place_proven(&f, p) == inside)
            f.effects[id] = 3; if inside { f.effects[id] = 2 }
            f.reads[id] = mir.variable_bit(29); f.writes[id] = 1
            if access == 8 {
                f.dst[id] = -1; f.a[id] = 0; f.b[id] = 29
                f.effects[id] = 5; if inside { f.effects[id] = 4 }
                f.reads[id] = f.reads[id].bit_or(1); f.writes[id] = 0
            }
            var work := lower.new()
            if offset < -256 || offset == 32768 {
                // Missing scratch is now rejected by the mandatory contract,
                // before the lowerer can synthesize any addressing words.
                assert(!verify.verify(&mut f))
                assert(!lower.prepare(&mut work, &f, &code, &sites))
                f.c[id] = 9; f.writes[id] = f.writes[id].bit_or(mir.variable_bit(9))
                assert(!verify.verify(&mut f)) // Its clobber must be explicit too.
                f.clobbers[id] = mir.variable_bit(9)
            }
            assert(verify.verify(&mut f))
            assert(lower.prepare(&mut work, &f, &code, &sites))
            lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
            assert(code.words.len >= 8)
        }
    }
}
@test fn canonical_frame_resizing_preserves_the_standard_fp_lr_layout() {
    var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 4); arm.ret(&mut code)
    var sites: []i32 = []; var f := lifted(&code, &sites, 0, 0, 0, 0)
    var first := -1; var second := -1
    for id in 0..f.kinds.len {
        if f.kinds[id] == 16 && f.dst[id] == 31 && f.a[id] == 31 {
            if first < 0 { first = id } else { second = id }
        }
    }
    assert(first >= 0 && second >= 0)
    f.modes[first] = 1; f.imm[first] = 40000; f.opcodes[first] = 2; f.modes[second] = 2
    assert(verify.verify(&mut f)); var work := lower.new()
    assert(lower.prepare(&mut work, &f, &code, &sites))
    lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
    var expected := arm.new(); direct := arm.prologue(&mut expected); arm.frame(&mut expected, direct, 5000); arm.ret(&mut expected)
    same_i64(&code.words, &expected.words)
}
@test fn rejected_preparations_never_change_code_or_import_sites() {
    var code := arm.new(); arm.emit(&mut code, 0); arm.emit(&mut code, 0); arm.ret(&mut code)
    var sites: []i32 = [0]; var f := lifted(&code, &sites, 0, 0, 0, 0)
    words := code.words; imports := sites; var work := lower.new()
    f.modes[0] = 2; assert(verify.verify(&mut f)); assert(!lower.prepare(&mut work, &f, &code, &sites))
    same_i64(&words, &code.words); same_i32(&imports, &sites)
    f.modes[0] = 0; assert(verify.verify(&mut f)); assert(lower.prepare(&mut work, &f, &code, &sites))
    assert(!lower.prepare(&mut work, &f, &code, &sites))
    lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
    same_i64(&words, &code.words); same_i32(&imports, &sites)
}
@test fn register_constraints_reserve_allocator_state_and_name_new_callee_saves() {
    for reg in [18, 19, 20, 21, 23, 24, 29, 30, 31] { assert(lower.reserved_gpr(reg)) }
    for reg in [22, 25, 26, 27, 28] { assert(!lower.reserved_gpr(reg) && lower.callee_saved_gpr(reg)) }
    assert(!lower.callee_saved_gpr(19) && !lower.callee_saved_gpr(21))
}
fn main() {}
