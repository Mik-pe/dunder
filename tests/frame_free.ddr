import ..selfhost.arm64 as arm
import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_alloc as alloc
import ..selfhost.opt_emit as emitter
import ..selfhost.lexer

fn body(source: string, types: &[]i32, ret: i32) -> ir.Function {
    input := lexer.scan(source, false)
    var names: []string = []; var positions: []i32 = []
    for p in 0..types.len { names.push(input.texts[p]); positions.push(p) }
    var f := ir.new()
    assert(parse.parse(&mut f, &input, types.len, input.kinds.len - 2, &names, &types, &positions, ret))
    f
}
fn emitted(f: &ir.Function, plan: &alloc.Plan, platform: i32, enabled: bool) -> arm.Code {
    var code := arm.new_for(platform)
    entry := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code)
    var options := emitter.options(); options.frame_free_enabled = enabled
    emitter.emit_prepared_configured(&mut code, &f, &plan, entry, overflow, zero, bounds, &options)
    code
}
fn same(left: &arm.Code, right: &arm.Code) {
    assert(left.words.len == right.words.len && left.labels.len == right.labels.len && left.at.len == right.at.len)
    for i in 0..left.words.len { assert(left.words[i] == right.words[i]) }
    for i in 0..left.labels.len { assert(left.labels[i] == right.labels[i]) }
    for i in 0..left.at.len { assert(left.at[i] == right.at[i] && left.target[i] == right.target[i] && left.kinds[i] == right.kinds[i]) }
}
@test fn arm_scalar_leaf_omits_frame_and_other_targets_keep_identical_code() {
    types: []i32 = [2]
    f := body("x{x+1}", &types, 2)
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &f)
    for platform in 0..4 {
        off := emitted(&f, &plan, platform, false); on := emitted(&f, &plan, platform, true)
        assert(off.words[0] == 2847898621)
        if platform < 2 {
            assert(on.words[0] != 2847898621 && on.words.len < off.words.len)
            assert(on.words[on.words.len - 1] == 3596551104)
            for word in on.words { assert(word != 2432697341 && word != 2432697279 && word != 2831252477) }
        } else { same(&off, &on) }
        assert(on.effect_depth == 0)
    }
    var normal := arm.new(); entry := arm.label(&mut normal); overflow := arm.label(&mut normal); zero := arm.label(&mut normal); bounds := arm.label(&mut normal)
    emitter.emit_prepared(&mut normal, &f, &plan, entry, overflow, zero, bounds)
    configured := emitted(&f, &plan, 0, true)
    same(&normal, &configured)
}
@test fn spills_arrays_and_synthetic_loop_limit_spills_keep_the_frame() {
    types: []i32 = [2]
    pressure := body("x{a:=x+1;b:=x+2;c:=x+3;d:=x+4;e:=x+5;f:=x+6;g:=x+7;h:=x+8;i:=x+9;j:=x+10;k:=x+11;l:=x+12;m:=x+13;a+b+c+d+e+f+g+h+i+j+k+l+m}", &types, 2)
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &pressure)
    var spilled := false
    for value in 0..plan.homes.len { if plan.first[value] >= 0 && plan.homes[value] < 0 { spilled = true } }
    assert(spilled)
    for platform in 0..2 {
        off := emitted(&pressure, &plan, platform, false); on := emitted(&pressure, &plan, platform, true)
        same(&off, &on)
    }
    array_types: []i32 = [20]
    array := body("values{values.len}", &array_types, 1)
    alloc.allocate_into(&mut plan, &array)
    off_array := emitted(&array, &plan, 0, false); on_array := emitted(&array, &plan, 0, true)
    same(&off_array, &on_array)
    loop := body("x{var sum:i64=0;for i in 0..3{sum=sum+x};sum}", &types, 2)
    alloc.allocate_into(&mut plan, &loop)
    on_loop := emitted(&loop, &plan, 0, true)
    assert(on_loop.words[0] != 2847898621)
    for node in 0..loop.nodes.kinds.len { if loop.nodes.kinds[node] == 19 { plan.homes[plan.limits[node]] = -1 } }
    off_limit := emitted(&loop, &plan, 0, false); on_limit := emitted(&loop, &plan, 0, true)
    same(&off_limit, &on_limit)
}
@test fn unused_parameters_need_no_frame_and_i32_normalizes_after_moves() {
    types: []i32 = [1, 2]
    f := body("used unused{used+1}", &types, 1)
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &f)
    assert(plan.first[1] < 0 && plan.homes[1] < 0)
    code := emitted(&f, &plan, 0, true)
    assert(code.words[0] != 2847898621)
    assert(code.words[0] == 2852127712 + i64(plan.homes[0])) // MOV home,x0.
    assert(code.words[1] == 2470476800 + i64(plan.homes[0]) * 33) // SXTW home,home.
}
