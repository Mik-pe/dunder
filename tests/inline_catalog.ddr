import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_verify as verify
import ..selfhost.opt_inline as inline
import ..selfhost.opt_emit as emitter
import ..selfhost.arm64 as arm
import ..selfhost.lexer
import std.sha256 as sha
import std.bytes as bytes

fn digest(label:string)->string{value:=sha.text(label);bytes.hex(&value)}

fn body(source: string, types: &[]i32, ret: i32) -> ir.Function {
    input := lexer.scan(source, false)
    var names: []string = []; var positions: []i32 = []
    for p in 0..types.len { names.push(input.texts[p]); positions.push(p) }
    var f := ir.new()
    assert(parse.parse(&mut f, &input, types.len, input.kinds.len - 2, &names, &types, &positions, ret))
    assert(verify.validate(&f, false)); assert(verify.validate(&f, true)); f
}
fn prepared(w: &mut inline.Workspace, c: &inline.Catalog, declaration: i32, types: &[]i32, ret: i32) -> bool {
    slots: []i32 = [37, 620]
    inline.prepare(&mut w, &c, declaration, -1, &types, ret, &slots, 621, 0, 4096)
}
@test fn catalog_selects_verified_closed_expressions_and_rebases_multiple_entries() {
    types: []i32 = [2, 2]
    good := body("x y{(x*3+y)%7}", &types, 2)
    boolean := body("x y{x!=0&&y/x>0}", &types, 3)
    local := body("x y{z:=x+y;z}", &types, 2)
    branch := body("x y{if x==0{return y};x}", &types, 2)
    var c := inline.new()
    assert(inline.add_verified(&mut c, 1, &good, digest("body-one")))
    assert(!inline.add_verified(&mut c, 2, &local, digest("local")))
    inline.reject(&mut c, 3)
    assert(!inline.add_verified(&mut c, 4, &branch, digest("branch")))
    assert(inline.add_verified(&mut c, 7, &boolean, digest("body-seven")))
    assert(inline.count(&c) == 2 && inline.find(&c, 1) == 0 && inline.find(&c, 7) == 1 && inline.find(&c, 2) == -1)
    assert(inline.seal(&mut c) && inline.digest_ready(&c) && inline.fingerprint(&c).len == 64)
    var w := inline.workspace()
    assert(prepared(&mut w, &c, 7, &types, 3))
    estimate := inline.word_estimate(&w)
    var code := arm.new(); overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code)
    settings := emitter.options()
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(code.words.len > 0 && code.words.len <= estimate && code.effect_depth == 0)
    before := code.words.len
    assert(!inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(code.words.len == before && inline.word_estimate(&w) == 0)
}
@test fn admission_budgets_rejection_and_reset_are_deterministic() {
    types: []i32 = [2]
    var expression := "x"
    for step in 0..15 { expression = expression + "+1" }
    exact := body("x{-(" + expression + ")}", &types, 2)
    large := body("x{" + expression + "+1}", &types, 2)
    var c := inline.new()
    inline.reset(&mut c, 32, 65536, 1)
    assert(inline.add_verified(&mut c, 0, &exact, digest("exact32")))
    assert(inline.node_count(&c) == 32)
    assert(!inline.add_verified(&mut c, 1, &large, digest("too-large")))
    assert(inline.count(&c) == 1 && inline.node_count(&c) == 32)
    assert(!inline.add_verified(&mut c, 2, &exact, digest("no-space")) && inline.exhausted(&c))
    assert(inline.units(&c) <= 65536)
    assert(inline.seal(&mut c))
    inline.reset(&mut c, 0, 0, 0)
    assert(!inline.add_verified(&mut c, 0, &exact, digest("none")) && inline.exhausted(&c))
    assert(inline.count(&c) == 0 && inline.node_count(&c) == 0 && inline.seal(&mut c))
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &exact, digest("again")))
    assert(!inline.add_verified(&mut c, 0, &exact, digest("duplicate")))
    assert(!inline.seal(&mut c) && inline.find(&c, 0) == -1)
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &exact, digest("fresh")) && inline.seal(&mut c))
}
@test fn workspace_checks_shadowed_targets_signatures_slots_budget_and_generation_before_code() {
    types: []i32 = [1, 2]; wrong: []i32 = [2, 2]; slots: []i32 = [37, 620]; bad_slots: []i32 = [37, 621]
    f := body("x y{x}", &types, 1)
    var c := inline.new(); assert(inline.add_verified(&mut c, 3, &f, digest("signed32")) && inline.seal(&mut c))
    var w := inline.workspace(); settings := emitter.options(); var code := arm.new()
    overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code)
    assert(!inline.prepare(&mut w, &c, 3, 0, &types, 1, &slots, 621, 0, 4096)) // Local function pointer shadows that declaration.
    assert(!inline.prepare(&mut w, &c, 3, -1, &wrong, 1, &slots, 621, 0, 4096))
    assert(!inline.prepare(&mut w, &c, 3, -1, &types, 2, &slots, 621, 0, 4096))
    assert(!inline.prepare(&mut w, &c, 3, -1, &types, 1, &bad_slots, 621, 0, 4096))
    assert(!inline.prepare(&mut w, &c, 3, -1, &types, 1, &slots, 621, 0, 0))
    assert(!inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings) && code.words.len == 0)
    assert(prepared(&mut w, &c, 3, &types, 1))
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 3, &f, digest("signed32")) && inline.seal(&mut c))
    assert(!inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings) && code.words.len == 0)
    assert(prepared(&mut w, &c, 3, &types, 1))
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    // Slot37 needs SUB+LDR, then MOV home4,x0 and in-place SXTW.
    assert(code.words[2] == 2852127716 && code.words[3] == 2470476932)
    assert(prepared(&mut w, &c, 3, &types, 1))
    changed := body("x y{1}", &types, 1)
    var other := inline.new()
    // Match generation while changing content; structural seal rejects reuse.
    inline.reset(&mut other, 4096, 65536, 256)
    inline.reset(&mut other, 4096, 65536, 256)
    assert(inline.add_verified(&mut other, 3, &changed, digest("changed")) && inline.seal(&mut other))
    before := code.words.len
    assert(!inline.emit_prepared(&mut w, &mut code, &other, overflow, zero, bounds, &settings) && code.words.len == before)
}
@test fn fingerprints_require_all_source_digests_and_cover_signatures_ids_and_policy() {
    types: []i32 = [2, 2]; f := body("x y{x+y}", &types, 2)
    var c := inline.new(); assert(inline.add_verified(&mut c, 0, &f, ""))
    assert(inline.fingerprint(&c) == "" && !inline.digest_ready(&c))
    assert(inline.seal(&mut c) && !inline.digest_ready(&c) && inline.fingerprint(&c) == "")
    assert(!inline.set_body_digest(&mut c, 0, digest("too-late")))
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &f, ""))
    assert(inline.set_body_digest(&mut c, 0, digest("body-A")) && inline.seal(&mut c))
    original := inline.fingerprint(&c); assert(original.len == 64)
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &f, digest("body-B")) && inline.seal(&mut c))
    assert(inline.fingerprint(&c) != original)
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 1, &f, digest("body-A")) && inline.seal(&mut c))
    assert(inline.fingerprint(&c) != original)
    inline.reset(&mut c, 4095, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &f, digest("body-A")) && inline.seal(&mut c))
    assert(inline.fingerprint(&c) != original)
}
@test fn malformed_or_unbounded_digest_inputs_are_refused_without_admission() {
    types: []i32 = [2]; f := body("x{x+1}", &types, 2)
    var c := inline.new()
    assert(!inline.add_verified(&mut c, 0, &f, "short"))
    var long := ""; for i in 0..65 { long = long + "a" }
    assert(!inline.add_verified(&mut c, 1, &f, long))
    assert(inline.count(&c) == 0 && inline.node_count(&c) == 0)
    assert(inline.add_verified(&mut c, 2, &f, ""))
    assert(!inline.set_body_digest(&mut c, 2, "bad"))
    assert(inline.set_body_digest(&mut c, 2, digest("bounded")) && inline.seal(&mut c))
    first := inline.fingerprint(&c)
    assert(first == inline.fingerprint(&c) && first.len == 64)
}
