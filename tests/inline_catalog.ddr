import ..selfhost.opt.opt_ir as ir
import support.typed_fixture as fixture
import ..selfhost.opt.opt_verify as verify
import ..selfhost.opt.opt_inline as inline
import ..selfhost.opt.opt_emit as emitter
import ..selfhost.backend.arm64 as arm
import ..selfhost.frontend.lexer
import std.sha256 as sha
import std.bytes as bytes

fn digest(label:string)->string{value:=sha.digest_text(label);bytes.hex(&value)}

fn body(source: string, types: &[]i32, ret: i32) -> ir.Function {
    input := lexer.scan(source, false)
    mut names: []string = []; mut positions: []i32 = []
    for p in 0..types.len { names.push(input.texts[p].clone()); positions.push(p) }
    mut f := ir.new()
    assert(fixture.body(&mut f, &input, types.len, input.kinds.len - 2, &names, &types, &positions, ret))
    assert(verify.validate(&f, false)); assert(verify.validate(&f, true)); f
}
fn prepared(w: &mut inline.Workspace, c: &inline.Catalog, declaration: i32, types: &[]i32, ret: i32) -> bool {
    slots: []i32 = [37, 620]
    inline.prepare(&mut w, &c, declaration, -1, &types, ret, &slots, 621, 0, 4096)
}
@test fn catalog_selects_verified_closed_expressions_and_rebases_multiple_entries() {
    types: []i32 = [2, 2]
    good := body("x y{(x*3+y)%7}", &types, 2)
    boolean := body("x y{x!=0&&y/x>0}", &types, 3)
    local := body("x y{z:=x+y;z}", &types, 2)
    branch := body("x y{if x==0{return y};x}", &types, 2)
    mut c := inline.new()
    assert(inline.add_verified(&mut c, 1, &good, digest("body-one")))
    assert(inline.add_verified(&mut c, 2, &local, digest("local")))
    inline.reject(&mut c, 3)
    assert(inline.add_verified(&mut c, 4, &branch, digest("branch")))
    assert(inline.add_verified(&mut c, 7, &boolean, digest("body-seven")))
    assert(inline.count(&c) == 4 && inline.find(&c, 1) == 0 && inline.find(&c, 2) == 1 && inline.find(&c, 3) == -1 &&
        inline.find(&c, 4) == 2 && inline.find(&c, 7) == 3)
    assert(inline.seal(&mut c) && inline.digest_ready(&c) && inline.fingerprint(&c).len == 64)
    mut whole := ir.new(); names: []string = ["unused", "x", "y"]; tokens: []i32 = [9, 10, 11]
    assert(inline.restore_body(&c, 7, &mut whole, &names, &tokens, 1))
    assert(verify.validate(&whole, true) && whole.local_at[0] == 10 && whole.local_at[1] == 11)
    assert(whole.nodes.starts[whole.root] == boolean.nodes.starts[boolean.root] && whole.ret == 3)
    assert(inline.restore_body(&c, 2, &mut whole, &names, &tokens, 1) && verify.validate(&whole, true))
    assert(inline.restore_body(&c, 4, &mut whole, &names, &tokens, 1) && verify.validate(&whole, true))
    assert(!inline.restore_body(&c, 3, &mut whole, &names, &tokens, 1))
    mut w := inline.workspace()
    mut code := arm.new(); overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code)
    settings := emitter.options()
    for id in [2, 4, 7] {
        expected_ret := if id == 7 { 3 } else { 2 }
        assert(prepared(&mut w, &c, id, &types, expected_ret))
        estimate := inline.word_estimate(&w)
        before_emit := code.words.len
        assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
        assert(code.words.len > before_emit && code.words.len - before_emit <= estimate && code.effect_depth == 0)
    }
    before := code.words.len
    assert(!inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(code.words.len == before && inline.word_estimate(&w) == 0)
}
@test fn admission_budgets_rejection_and_reset_are_deterministic() {
    types: []i32 = [2]
    mut expression := "x"
    for step in 0..15 { expression = expression + "+1" }
    exact := body("x{-(" + expression + ")}", &types, 2)
    large := body("x{" + expression + "+1}", &types, 2)
    mut c := inline.new()
    inline.reset(&mut c, 32, 65536, 1)
    assert(inline.add_verified(&mut c, 0, &exact, digest("exact32")))
    assert(inline.node_count(&c) == 32)
    assert(!inline.add_verified(&mut c, 1, &large, digest("too-large")))
    assert(inline.count(&c) == 1 && inline.node_count(&c) == 32)
    assert(!inline.add_verified(&mut c, 2, &exact, digest("no-space")) && inline.exhausted(&c))
    assert(inline.units(&c) <= 65536)
    assert(inline.seal(&mut c))
    inline.reset(&mut c, 0, 0, 0)
    assert(!inline.add_verified(&mut c, 0, &exact, digest("none")) && inline.exhausted(&c))
    assert(inline.count(&c) == 0 && inline.node_count(&c) == 0 && inline.seal(&mut c))
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &exact, digest("again")))
    assert(!inline.add_verified(&mut c, 0, &exact, digest("duplicate")))
    assert(!inline.seal(&mut c) && inline.find(&c, 0) == -1)
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &exact, digest("fresh")) && inline.seal(&mut c))
}
@test fn workspace_checks_shadowed_targets_signatures_slots_budget_and_generation_before_code() {
    types: []i32 = [1, 2]; wrong: []i32 = [2, 2]; slots: []i32 = [37, 620]; bad_slots: []i32 = [37, 621]
    f := body("x y{x}", &types, 1)
    mut c := inline.new(); assert(inline.add_verified(&mut c, 3, &f, digest("signed32")) && inline.seal(&mut c))
    mut w := inline.workspace(); settings := emitter.options(); mut code := arm.new()
    overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code)
    assert(!inline.prepare(&mut w, &c, 3, 0, &types, 1, &slots, 621, 0, 4096))
    assert(!inline.prepare(&mut w, &c, 3, -1, &wrong, 1, &slots, 621, 0, 4096))
    assert(!inline.prepare(&mut w, &c, 3, -1, &types, 2, &slots, 621, 0, 4096))
    assert(!inline.prepare(&mut w, &c, 3, -1, &types, 1, &bad_slots, 621, 0, 4096))
    assert(!inline.prepare(&mut w, &c, 3, -1, &types, 1, &slots, 621, 0, 0))
    assert(!inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings) && code.words.len == 0)
    assert(prepared(&mut w, &c, 3, &types, 1))
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 3, &f, digest("signed32")) && inline.seal(&mut c))
    assert(!inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings) && code.words.len == 0)
    assert(prepared(&mut w, &c, 3, &types, 1))
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(code.words[2] == 2852127716 && code.words[3] == 2470476932)
    assert(prepared(&mut w, &c, 3, &types, 1))
    changed := body("x y{1}", &types, 1)
    mut other := inline.new()
    inline.reset(&mut other, 4096, 65536, 256)
    inline.reset(&mut other, 4096, 65536, 256)
    assert(inline.add_verified(&mut other, 3, &changed, digest("changed")) && inline.seal(&mut other))
    before := code.words.len
    assert(!inline.emit_prepared(&mut w, &mut code, &other, overflow, zero, bounds, &settings) && code.words.len == before)
}
@test fn fingerprints_require_all_source_digests_and_cover_signatures_ids_and_policy() {
    types: []i32 = [2, 2]; f := body("x y{x+y}", &types, 2)
    mut c := inline.new(); assert(inline.add_verified(&mut c, 0, &f, ""))
    assert(inline.fingerprint(&c) == "" && !inline.digest_ready(&c))
    assert(inline.seal(&mut c) && !inline.digest_ready(&c) && inline.fingerprint(&c) == "")
    assert(!inline.set_body_digest(&mut c, 0, digest("too-late")))
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &f, ""))
    assert(inline.set_body_digest(&mut c, 0, digest("body-A")) && inline.seal(&mut c))
    original := inline.fingerprint(&c); assert(original.len == 64)
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &f, digest("body-B")) && inline.seal(&mut c))
    assert(inline.fingerprint(&c) != original)
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 1, &f, digest("body-A")) && inline.seal(&mut c))
    assert(inline.fingerprint(&c) != original)
    inline.reset(&mut c, 4095, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &f, digest("body-A")) && inline.seal(&mut c))
    assert(inline.fingerprint(&c) != original)
}
@test fn malformed_or_unbounded_digest_inputs_are_refused_without_admission() {
    types: []i32 = [2]; f := body("x{x+1}", &types, 2)
    mut c := inline.new()
    assert(!inline.add_verified(&mut c, 0, &f, "short"))
    mut long := ""; for i in 0..65 { long = long + "a" }
    assert(!inline.add_verified(&mut c, 1, &f, move long))
    assert(inline.count(&c) == 0 && inline.node_count(&c) == 0)
    assert(inline.add_verified(&mut c, 2, &f, ""))
    assert(!inline.set_body_digest(&mut c, 2, "bad"))
    assert(inline.set_body_digest(&mut c, 2, digest("bounded")) && inline.seal(&mut c))
    first := inline.fingerprint(&c)
    assert(first == inline.fingerprint(&c) && first.len == 64)
}

@test fn configured_workspace_matches_explicit_options_without_changing_legacy_wrapper() {
    types: []i32 = [2]; f := body("x{x/7}", &types, 2)
    mut c := inline.new(); assert(inline.add_verified(&mut c, 0, &f, digest("division")) && inline.seal(&mut c))
    slots: []i32 = [37]
    mut w := inline.workspace()
    for platform in 0..4 {
        for mode in 0..2 {
            enabled := mode == 1
            inline.configure(&mut w, enabled, enabled)
            mut configured := arm.new_for(platform); mut explicit := arm.new_for(platform)
            overflow := arm.label(&mut configured); zero := arm.label(&mut configured); bounds := arm.label(&mut configured)
            a := arm.label(&mut explicit); b := arm.label(&mut explicit); d := arm.label(&mut explicit)
            assert(inline.prepare(&mut w, &c, 0, -1, &types, 2, &slots, 38, platform, 4096))
            assert(inline.emit_prepared_configured(&mut w, &mut configured, &c, overflow, zero, bounds))
            assert(inline.prepare(&mut w, &c, 0, -1, &types, 2, &slots, 38, platform, 4096))
            mut settings := emitter.options(); settings.const_div_enabled = enabled; settings.frame_free_enabled = enabled
            assert(inline.emit_prepared(&mut w, &mut explicit, &c, a, b, d, &settings))
            assert(configured.words.len == explicit.words.len && configured.at.len == explicit.at.len && configured.labels.len == explicit.labels.len)
            for i in 0..configured.words.len { assert(configured.words[i] == explicit.words[i]) }
            for i in 0..configured.at.len { assert(configured.at[i] == explicit.at[i] && configured.target[i] == explicit.target[i] && configured.kinds[i] == explicit.kinds[i]) }
            for i in 0..configured.labels.len { assert(configured.labels[i] == explicit.labels[i]) }
        }
    }
}

@test fn whole_function_bodies_with_control_arrays_and_spills_are_admitted_and_bound() {
    arr_ro: []i32 = [20]
    arr_rw: []i32 = [21]
    i32_ro: []i32 = [22]
    i32_rw: []i32 = [23]
    two_i64: []i32 = [2, 2]
    one_i64: []i32 = [2]
    one_i32: []i32 = [1]
    mut cond := body("x y{if x<0{return -x};mut i:i64=0;mut s:i64=0;while i<y{if i==5{break};i+=1;s+=i};s}", &two_i64, 2)
    mut bad_mut_param := cond.clone()
    bad_mut_param.local_mutable[0] = true
    looped := body("n{mut acc:=0;for i in 0..n{if i%2==0{continue};acc+=i};acc}", &one_i32, 1)
    sum64 := body("values{mut s:i64=0;for i in 0..values.len{s+=values[i]};s}", &arr_ro, 2)
    scale64 := body("values{for i in 0..values.len{values[i]=values[i]*2}}", &arr_rw, 0)
    sum32 := body("values{mut s:=0;for i in 0..values.len{s+=values[i]};s}", &i32_ro, 1)
    bump32 := body("values{for i in 0..values.len{values[i]=values[i]+1}}", &i32_rw, 0)
    mut spill_src := "x{"
    for i in 0..14 { spill_src = spill_src + f"v{i}:=x+{i};" }
    spill_src = spill_src + "mut s:i64=0;"
    for i in 0..14 { spill_src = spill_src + f"s=s+v{i};" }
    spill_src = spill_src + "s}"
    spilled := body(spill_src, &one_i64, 2)

    mut big_src := "x{mut s:i64=x;"
    for _ in 0..45 { big_src = big_src + "s=s+1;" }
    too_big := body(big_src + "s}", &one_i64, 2)
    mut many_locals := "x{"
    for i in 0..25 { many_locals = many_locals + f"a{i}:=x+{i};" }
    many_locals = many_locals + "a0}"
    too_many_locals := body(many_locals, &one_i64, 2)

    mut c := inline.new()
    assert(inline.add_verified(&mut c, 0, &cond, digest("cond")))
    assert(inline.add_verified(&mut c, 1, &looped, digest("looped")))
    assert(inline.add_verified(&mut c, 2, &sum64, digest("sum64")))
    assert(inline.add_verified(&mut c, 3, &scale64, digest("scale64")))
    assert(inline.add_verified(&mut c, 4, &sum32, digest("sum32")))
    assert(inline.add_verified(&mut c, 5, &bump32, digest("bump32")))
    assert(inline.add_verified(&mut c, 6, &spilled, digest("spilled")))
    assert(!inline.add_verified(&mut c, 7, &too_big, digest("too_big")))
    assert(!inline.add_verified(&mut c, 8, &too_many_locals, digest("too_many_locals")))
    assert(!inline.add_verified(&mut c, 9, &bad_mut_param, digest("bad_mut_param")))
    assert(inline.seal(&mut c))

    mut w := inline.workspace()
    mut code := arm.new()
    overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code)
    settings := emitter.options()
    one_slot: []i32 = [12]
    assert(inline.prepare(&mut w, &c, 2, -1, &arr_ro, 2, &one_slot, 20, 0, 4096))
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(inline.prepare(&mut w, &c, 3, -1, &arr_rw, 0, &one_slot, 20, 0, 4096))
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(inline.prepare(&mut w, &c, 4, -1, &i32_ro, 1, &one_slot, 20, 0, 4096))
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(inline.prepare(&mut w, &c, 5, -1, &i32_rw, 0, &one_slot, 20, 0, 4096))
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))

    assert(!inline.prepare(&mut w, &c, 6, -1, &one_i64, 2, &one_slot, 20, 0, 4096))
    needed := inline.spills_needed(&w)
    assert(needed > 0)
    mut bad_dup: []i32 = []; mut bad_alias: []i32 = []; mut bad_oob: []i32 = []; mut good: []i32 = []
    for i in 0..needed {
        bad_dup.push(13); bad_alias.push(if i == 0 { 12 } else { 30 + i }); bad_oob.push(20 + i); good.push(13 + i)
    }
    if needed > 1 { assert(!inline.bind_spill_slots(&mut w, &bad_dup, 20 + needed)) }
    assert(!inline.bind_spill_slots(&mut w, &bad_alias, 30 + needed))
    assert(!inline.bind_spill_slots(&mut w, &bad_oob, 20))
    assert(inline.bind_spill_slots(&mut w, &good, 20))
    est := inline.word_estimate(&w)
    before := code.words.len
    assert(inline.emit_prepared(&mut w, &mut code, &c, overflow, zero, bounds, &settings))
    assert(code.words.len > before && code.words.len - before <= est && code.effect_depth == 0)
}
