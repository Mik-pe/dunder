import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_lower as lower
import ..selfhost.mir_opt as promotion
import ..selfhost.mir_value_prop as values
import mir_object_support as support

fn lifted(f: &mut mir.Function, code: &arm.Code, sites: &[]i32, first: i32, label: i32, reloc: i32, imported: i32) {
    assert(lift.lift(&mut f, &code, first, label, reloc, &sites, imported))
    assert(verify.verify(&mut f))
}
fn compare_serial(f: &mir.Function, original: &arm.Code, original_sites: &[]i32) {
    var serial := arm.new_for(original.platform); support.copy_code(&mut serial, &original)
    var sites: []i32 = []; for i in 0..original_sites.len { sites.push(original_sites[i]) }
    var work := lower.new(); assert(lower.prepare(&mut work, &f, &serial, &sites))
    lower.commit_code(&mut work, &mut serial); lower.commit_imports(&mut work, &mut sites)
    var object := lower.new_object(); assert(lower.lower_into(&mut object, &f))
    assert(lower.object_platform(&object) == original.platform)
    var linked := arm.new_for(original.platform)
    for i in 0..f.first_word { linked.words.push(original.words[i]) }
    for i in 0..original.labels.len { linked.labels.push(original.labels[i]) }
    for i in 0..f.first_reloc {
        linked.at.push(original.at[i]); linked.target.push(original.target[i]); linked.kinds.push(original.kinds[i])
    }
    var imports: []i32 = []; for i in 0..original_sites.len { imports.push(original_sites[i]) }
    support.append(&object, &mut linked, &mut imports)
    support.same_code(&serial, &linked); support.same_i32(&sites, &imports)
    // Rebase the detached object after additional prefix words. Every local
    // target, end/unmarked label and import coordinate must shift exactly once.
    for extra in [1, 17] {
        var rebased := arm.new_for(original.platform)
        for i in 0..f.first_word { rebased.words.push(original.words[i]) }
        for i in 0..extra { arm.emit(&mut rebased, 3573751839) }
        for i in 0..original.labels.len { rebased.labels.push(original.labels[i]) }
        for i in 0..f.first_reloc {
            rebased.at.push(original.at[i]); rebased.target.push(original.target[i]); rebased.kinds.push(original.kinds[i])
        }
        var shifted: []i32 = []; for i in 0..original_sites.len { shifted.push(original_sites[i]) }
        support.append(&object, &mut rebased, &mut shifted)
        assert(rebased.words.len == serial.words.len + extra)
        for i in 0..lower.object_word_count(&object) { assert(rebased.words[f.first_word + extra + i] == serial.words[f.first_word + i]) }
        for i in 0..lower.object_label_count(&object) {
            id := lower.object_label_id(&object, i); var at := serial.labels[id]; if at >= 0 { at = at + extra }
            assert(rebased.labels[id] == at)
        }
        for i in f.first_reloc..serial.at.len {
            assert(rebased.at[i] == serial.at[i] + extra && rebased.target[i] == serial.target[i] && rebased.kinds[i] == serial.kinds[i])
        }
        for i in f.first_import..sites.len { assert(shifted[i] == sites[i] + extra * 4) }
    }
}
@test fn detached_objects_cover_all_targets_symbolic_kinds_imports_and_initializer_tails() {
    for platform in 0..4 {
        for kind in 0..21 {
            var code := arm.new_for(platform); outside := arm.label(&mut code); entry := arm.label(&mut code)
            arm.mark(&mut code, outside); arm.emit(&mut code, 0); arm.emit(&mut code, 0)
            var sites: []i32 = [0]; first := code.words.len; first_label := code.labels.len
            arm.mark(&mut code, entry); body := arm.label(&mut code); init := arm.label(&mut code)
            end := arm.label(&mut code); pending := arm.label(&mut code)
            arm.branch(&mut code, init, 0); arm.mark(&mut code, body)
            arm.branch(&mut code, outside, kind); arm.branch(&mut code, end, kind)
            sites.push(code.words.len * 4); arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0)
            arm.ret(&mut code); arm.mark(&mut code, init)
            arm.imm(&mut code, 0, -9223372036854775808); arm.branch(&mut code, body, 0); arm.mark(&mut code, end)
            var f := mir.new(); lifted(&mut f, &code, &sites, first, first_label, 0, 1)
            assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
            compare_serial(&f, &code, &sites)
        }
    }
}
@test fn canonical_constants_deletions_and_imports_relayout_without_live_source_tables() {
    for platform in 0..4 {
        var code := arm.new_for(platform); entry := arm.label(&mut code)
        arm.emit(&mut code, 3573751839); first := code.words.len
        arm.mark(&mut code, entry); target := arm.label(&mut code); deleted := arm.label(&mut code)
        arm.imm(&mut code, 0, 7); arm.mark(&mut code, deleted); arm.imm(&mut code, 1, 8); arm.mark(&mut code, target)
        site := code.words.len * 4; arm.emit(&mut code, 0); arm.emit(&mut code, 0); arm.ret(&mut code)
        sites: []i32 = [site]; var f := mir.new(); lifted(&mut f, &code, &sites, first, 1, 0, 0)
        assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
        f.modes[0] = 1; f.types[0] = 2; f.imm[0] = -9223372036854775808; f.modes[1] = 2
        assert(verify.verify(&mut f)); compare_serial(&f, &code, &sites)
        var object := lower.new_object(); assert(lower.lower_into(&mut object, &f))
        count := lower.object_word_count(&object); first_word := lower.object_word(&object, 0)
        mir.reset(&mut f); code.words.clear(); code.labels.clear(); code.at.clear(); code.target.clear(); code.kinds.clear()
        assert(lower.object_ready(&object) && lower.object_word_count(&object) == count && lower.object_word(&object, 0) == first_word)
        assert(lower.object_import_id(&object, 0) == 0 && lower.object_import_byte_at(&object, 0) >= 0)
    }
}
fn loop_code(code: &mut arm.Code) {
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    arm.emit(&mut code, 3942645823); arm.branch(&mut code, done, 12)
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 0); arm.pop(&mut code, 1)
    arm.emit(&mut code, 2332033056); arm.store(&mut code, 1, 0)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); arm.emit(&mut code, 2332098560); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done); arm.load(&mut code, 1); arm.ret(&mut code)
}
@test fn detached_objects_share_promotion_and_scalar_rewrite_lowering_with_serial_adapter() {
    var optimizer := promotion.new(); var scalar := values.new()
    for platform in 0..4 {
        var code := arm.new_for(platform); loop_code(&mut code)
        sites: []i32 = []; var f := mir.new(); lifted(&mut f, &code, &sites, 0, 0, 0, 0)
        assert(promotion.analyze_into(&mut optimizer, &f) && promotion.promoted(&optimizer) > 0)
        promotion.apply(&mut optimizer, &mut f); assert(verify.verify(&mut f)); compare_serial(&f, &code, &sites)
        var arithmetic := arm.new_for(platform)
        arm.imm(&mut arithmetic, 1, 7); arm.mov(&mut arithmetic, 2, 1); arm.mov(&mut arithmetic, 3, 2)
        arm.emit(&mut arithmetic, 2332229760); arm.emit(&mut arithmetic, 3596551104)
        lifted(&mut f, &arithmetic, &sites, 0, 0, 0, 0)
        assert(values.optimize_into(&mut scalar, &mut f) && f.verified && values.rewritten(&scalar) > 0)
        compare_serial(&f, &arithmetic, &sites)
    }
}
@test fn object_reset_refusal_and_reuse_never_publish_a_partial_output() {
    var object := lower.new_object(); var f := mir.new(); assert(!lower.object_ready(&object))
    assert(!lower.lower_into(&mut object, &f) && !lower.object_ready(&object))
    var code := arm.new(); arm.emit(&mut code, 0); arm.emit(&mut code, 0); arm.ret(&mut code)
    sites: []i32 = [0]; lifted(&mut f, &code, &sites, 0, 0, 0, 0)
    assert(lower.lower_into(&mut object, &f) && lower.object_ready(&object))
    f.modes[0] = 2; assert(verify.verify(&mut f))
    assert(!lower.lower_into(&mut object, &f) && !lower.object_ready(&object))
    f.modes[0] = 0; assert(verify.verify(&mut f))
    assert(lower.lower_into(&mut object, &f) && lower.object_word_count(&object) == code.words.len)
    lower.reset_object(&mut object); assert(!lower.object_ready(&object))
    assert(lower.lower_into(&mut object, &f)); lower.reset_object(&mut object); lower.reset_object(&mut object)
    assert(!lower.object_ready(&object))
}
@test fn serial_adapter_still_refuses_changed_snapshots_without_external_mutation() {
    var code := arm.new(); label := arm.label(&mut code); arm.mark(&mut code, label)
    arm.emit(&mut code, 0); arm.emit(&mut code, 0); arm.ret(&mut code)
    var sites: []i32 = [0]; var f := mir.new(); lifted(&mut f, &code, &sites, 0, 0, 0, 0)
    var work := lower.new(); before := code.words.len; code.words.push(3573751839)
    assert(!lower.prepare(&mut work, &f, &code, &sites) && code.words.len == before + 1 && sites[0] == 0)
    removed := code.words.pop(); sites.push(8)
    assert(!lower.prepare(&mut work, &f, &code, &sites) && sites.len == 2)
    imported := sites.pop(); code.platform = 1
    assert(!lower.prepare(&mut work, &f, &code, &sites)); code.platform = 0
    code.labels[label] = -1
    assert(!lower.prepare(&mut work, &f, &code, &sites) && code.labels[label] == -1)
    code.labels[label] = 0; assert(lower.prepare(&mut work, &f, &code, &sites))
    assert(!lower.prepare(&mut work, &f, &code, &sites))
    lower.commit_imports(&mut work, &mut sites); lower.commit_code(&mut work, &mut code)
    compare_serial(&f, &code, &sites)
}
fn main() {}
