import ..selfhost.machine_ir as mir
import ..selfhost.arm64 as arm

fn plain() -> arm.Code {
    var code := arm.new(); entry := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.mark(&mut code, entry)
    for i in 0..12 { arm.imm(&mut code, 0, i64(i)) }
    code
}
fn equal(code: &arm.Code, old: &arm.Code, sites: &[]i32, old_sites: &[]i32) {
    assert(code.words.len == old.words.len && code.labels.len == old.labels.len && code.at.len == old.at.len)
    assert(code.target.len == old.target.len && code.kinds.len == old.kinds.len && sites.len == old_sites.len)
    for i in 0..code.words.len { assert(code.words[i] == old.words[i]) }
    for i in 0..code.labels.len { assert(code.labels[i] == old.labels[i]) }
    for i in 0..code.at.len { assert(code.at[i] == old.at[i]) }
    for i in 0..code.target.len { assert(code.target[i] == old.target[i]) }
    for i in 0..code.kinds.len { assert(code.kinds[i] == old.kinds[i]) }
    for i in 0..sites.len { assert(sites[i] == old_sites[i]) }
    assert(code.platform == old.platform && code.checking == old.checking && code.profile == old.profile)
    assert(code.virtual_words == old.virtual_words && code.virtual_labels == old.virtual_labels)
}
fn snapshot(code: &arm.Code) -> arm.Code {
    var copy := arm.new_for(code.platform)
    copy.words = code.words; copy.labels = code.labels; copy.at = code.at; copy.target = code.target; copy.kinds = code.kinds
    copy.checking = code.checking; copy.virtual_words = code.virtual_words; copy.virtual_labels = code.virtual_labels; copy.profile = code.profile
    copy
}
fn reject(work: &mut mir.Workspace, code: &mut arm.Code, sites: &mut []i32,
    first_word: i32, first_label: i32, first_reloc: i32, first_import: i32) {
    old := snapshot(&code); var old_sites: []i32 = []
    for site in sites { old_sites.push(site) }
    assert(!mir.compact(&mut work, &mut code, first_word, first_label, first_reloc, &mut sites, first_import))
    equal(&code, &old, &sites, &old_sites)
    assert(mir.boundary(&work, first_word) == -1)
}

@test fn compaction_remaps_all_suffix_boundaries_symbols_and_byte_import_sites() {
    var code := arm.new(); entry := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.mark(&mut code, entry)
    arm.imm(&mut code, 0, 99); arm.branch(&mut code, entry, 1)
    arm.branch(&mut code, entry, 2); arm.imm(&mut code, 0, 98)
    var sites: []i32 = [24]; arm.emit(&mut code, 0); arm.emit(&mut code, 0)
    end := arm.label(&mut code); arm.branch(&mut code, end, 20)
    arm.imm(&mut code, 0, 97); arm.imm(&mut code, 0, 42); arm.mark(&mut code, end)
    code.labels.push(1); code.labels.push(3); code.labels.push(5); code.labels.push(11); code.labels.push(-1)
    before := code
    var work := mir.new()
    assert(mir.add_range(&mut work, 1, 3)); assert(mir.add_range(&mut work, 5, 6)); assert(mir.add_range(&mut work, 10, 11))
    assert(mir.compact(&mut work, &mut code, 1, 1, 1, &mut sites, 0))
    expected := [1, 1, 1, 2, 3, 3, 4, 5, 6, 7, 7, 8]
    for i in 0..expected.len { assert(mir.boundary(&work, i + 1) == expected[i]) }
    assert(mir.boundary(&work, 0) == -1 && mir.boundary(&work, 13) == -1)
    assert(code.words.len == 8 && code.words[0] == before.words[0] && code.words[7] == before.words[11])
    assert(code.labels[0] == 1 && code.labels[1] == 8 && code.labels[2] == 1 && code.labels[3] == 1)
    assert(code.labels[4] == 3 && code.labels[5] == 7 && code.labels[6] == -1)
    assert(code.at.len == 3 && code.at[0] == 0 && code.at[1] == 1 && code.at[2] == 5)
    assert(code.kinds[0] == 1 && code.kinds[1] == 2 && code.kinds[2] == 20)
    assert(code.target[0] == 0 && code.target[1] == 0 && code.target[2] == 1 && sites[0] == 12)
}

@test fn every_relocation_kind_can_be_removed_whole_but_pairs_cannot_be_split() {
    for kind in 0..21 {
        var code := arm.new(); target := arm.label(&mut code)
        arm.branch(&mut code, target, 1); arm.mark(&mut code, target)
        arm.branch(&mut code, target, kind); end := code.words.len; arm.imm(&mut code, 0, 42)
        var sites: []i32 = []; var work := mir.new()
        assert(mir.add_range(&mut work, 1, end))
        assert(mir.compact(&mut work, &mut code, 1, 1, 1, &mut sites, 0))
        assert(code.words.len == 2 && code.at.len == 1 && mir.boundary(&work, end + 1) == 2)
        if kind >= 2 {
            for half in 0..2 {
                code = arm.new(); target := arm.label(&mut code)
                arm.branch(&mut code, target, 1); arm.mark(&mut code, target)
                arm.branch(&mut code, target, kind); arm.imm(&mut code, 0, 42)
                mir.reset(&mut work); assert(mir.add_range(&mut work, 1 + half, 2 + half))
                reject(&mut work, &mut code, &mut sites, 1, 1, 1, 0)
            }
            // Labels cannot enter padding/address halves, even when the whole
            // pair is removed. Boundary consistency is independent of edits.
            code = arm.new(); target := arm.label(&mut code)
            arm.branch(&mut code, target, 1); arm.mark(&mut code, target)
            arm.branch(&mut code, target, kind); code.labels.push(2)
            mir.reset(&mut work); assert(mir.add_range(&mut work, 1, 3))
            reject(&mut work, &mut code, &mut sites, 1, 1, 1, 0)
        }
    }
}

@test fn imports_keep_their_parallel_slot_order_and_reject_partial_or_complete_removal() {
    var code := arm.new(); entry := arm.label(&mut code)
    arm.emit(&mut code, 0); arm.emit(&mut code, 0)
    arm.branch(&mut code, entry, 1); arm.mark(&mut code, entry)
    arm.imm(&mut code, 0, 99); arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0); arm.imm(&mut code, 0, 42)
    var sites: []i32 = [0, 16]; var work := mir.new()
    assert(mir.add_range(&mut work, 3, 4))
    assert(mir.compact(&mut work, &mut code, 3, 1, 1, &mut sites, 1))
    assert(sites.len == 2 && sites[0] == 0 && sites[1] == 12 && code.words[3] == 4244635648)
    assert(code.words[0] == 0 && code.words[1] == 0 && code.at[0] == 2 && code.labels[0] == 3)
    for mode in 0..8 {
        code = plain(); sites = [12]; code.words[3] = 0; code.words[4] = 0
        mir.reset(&mut work)
        var start := 1; var end := 2
        if mode == 0 { start = 3; end = 4 }
        if mode == 1 { start = 4; end = 5 }
        if mode == 2 { start = 3; end = 5 }
        if mode == 3 { sites[0] = -4 }
        if mode == 4 { sites[0] = 13 }
        if mode == 5 { sites[0] = code.words.len * 4 }
        if mode == 6 { sites.push(8); code.words[2] = 0 }
        if mode == 7 { code.at.push(3); code.target.push(0); code.kinds.push(0) }
        assert(mir.add_range(&mut work, start, end))
        reject(&mut work, &mut code, &mut sites, 1, 1, 1, 0)
    }
}

@test fn malformed_lengths_boundaries_words_and_labels_are_rejected_atomically() {
    for mode in 0..22 {
        var code := plain(); var sites: []i32 = []; var work := mir.new()
        var first_word := 1; var first_label := 1; var first_reloc := 1; var first_import := 0
        if mode == 0 { removed := code.target.pop() }
        if mode == 1 { removed := code.kinds.pop() }
        if mode == 2 { first_word = -1 }
        if mode == 3 { first_word = code.words.len + 1 }
        if mode == 4 { first_label = -1 }
        if mode == 5 { first_label = code.labels.len + 1 }
        if mode == 6 { first_reloc = -1 }
        if mode == 7 { first_reloc = code.at.len + 1 }
        if mode == 8 { first_import = -1 }
        if mode == 9 { first_import = 1 }
        if mode == 10 { code.checking = true }
        if mode == 11 { code.words[12] = -1 }
        if mode == 12 { code.words[1] = 4294967296 }
        if mode == 13 { code.labels.push(-2) }
        if mode == 14 { code.labels.push(0) }
        if mode == 15 { code.labels.push(code.words.len + 1) }
        if mode == 16 { code.at[0] = 1 }
        if mode == 17 { code.kinds[0] = 20 }
        if mode == 18 { sites.push(0); first_import = 1 }
        if mode == 19 { sites.push(1); first_import = 1 }
        if mode == 20 { first_word = 2 }
        if mode == 21 { first_word = 0; first_reloc = 0 }
        assert(mir.add_range(&mut work, 1, 2))
        // mode21 attempts to keep a relocation targeting an old label outside
        // the trusted prefix; its inconsistent first_label is rejected.
        reject(&mut work, &mut code, &mut sites, first_word, first_label, first_reloc, first_import)
    }
}

@test fn malformed_symbolic_records_are_rejected_before_filtering_removed_relocations() {
    for mode in 0..13 {
        var code := arm.new(); target := arm.label(&mut code)
        arm.branch(&mut code, target, 1); arm.mark(&mut code, target)
        arm.branch(&mut code, target, 2); arm.branch(&mut code, target, 1); arm.imm(&mut code, 0, 42)
        var sites: []i32 = []; var work := mir.new()
        if mode == 0 { code.kinds[1] = -1 }
        if mode == 1 { code.kinds[1] = 21 }
        if mode == 2 { code.target[1] = -1 }
        if mode == 3 { code.target[1] = code.labels.len }
        if mode == 4 { code.labels.push(-2); code.target[1] = 1 }
        if mode == 5 { code.labels[0] = -2 }
        if mode == 6 { code.labels[0] = 2 }
        if mode == 7 { code.at[1] = 0 }
        if mode == 8 { code.at[1] = code.words.len - 1 }
        if mode == 9 { code.at[2] = 2 }
        if mode == 10 { code.words[1] = 1 }
        if mode == 11 { code.words[2] = 0 }
        if mode == 12 { code.at[1] = 3; code.at[2] = 1 }
        assert(mir.add_range(&mut work, 1, 4))
        reject(&mut work, &mut code, &mut sites, 1, 1, 1, 0)
    }
    // Forward global function/runtime targets are valid before they are marked.
    var code := arm.new(); forward := arm.label(&mut code)
    arm.imm(&mut code, 0, 99); arm.branch(&mut code, forward, 1)
    var sites: []i32 = []; var work := mir.new(); assert(mir.add_range(&mut work, 0, 1))
    assert(mir.compact(&mut work, &mut code, 0, 1, 0, &mut sites, 0))
    assert(code.labels[0] == -1 && code.at[0] == 0)
}

struct Image { code: arm.Code, sites: []i32 }
@test fn prepare_and_separate_commits_allow_shared_roots_and_preserve_forward_data_and_callbacks() {
    var image := Image { code: plain(), sites: [] }
    // New labels can name data and callbacks emitted only by finish_image.
    data := arm.label(&mut image.code); callback := arm.label(&mut image.code)
    arm.branch(&mut image.code, data, 20); arm.branch(&mut image.code, callback, 1)
    var work := mir.new(); assert(mir.add_range(&mut work, 1, 3))
    original := snapshot(&image.code)
    assert(mir.prepare(&mut work, &image.code, 1, 1, 1, &image.sites, 0))
    equal(&image.code, &original, &image.sites, &image.sites)
    // Re-preparing cannot replace a plan, even before the first commit.
    assert(!mir.prepare(&mut work, &image.code, 1, 1, 1, &image.sites, 0))
    mir.commit_code(&mut work, &mut image.code)
    assert(!mir.prepare(&mut work, &image.code, 1, 1, 1, &image.sites, 0))
    mir.commit_imports(&mut work, &mut image.sites)
    assert(image.code.labels[0] == 1 && image.code.labels[data] == -1 && image.code.labels[callback] == -1)
    assert(image.code.at[1] == 11 && image.code.at[2] == 13)
    arm.mark(&mut image.code, data); arm.emit(&mut image.code, 42)
    arm.mark(&mut image.code, callback); arm.imm(&mut image.code, 0, 0)
    assert(image.code.labels[data] == 14 && image.code.labels[callback] == 15)
    mir.reset(&mut work)
    assert(mir.add_range(&mut work, 1, 2))
    assert(mir.prepare(&mut work, &image.code, 1, 1, 1, &image.sites, 0))
    assert(!mir.add_range(&mut work, 2, 3))
    assert(!mir.prepare(&mut work, &image.code, 1, 1, 1, &image.sites, 0))
    // A mutation attempt poisons the plan rather than silently changing it.
    mir.reset(&mut work)
    assert(mir.add_range(&mut work, 1, 2))
    assert(mir.prepare(&mut work, &image.code, 1, 1, 1, &image.sites, 0))
    mir.commit_imports(&mut work, &mut image.sites)
    assert(!mir.add_range(&mut work, 2, 3))
}

@test fn invalid_range_plans_stay_poisoned_until_reset_and_no_edits_scan_nothing() {
    var work := mir.new(); var sites: []i32 = []
    for mode in 0..6 {
        var code := plain(); mir.reset(&mut work)
        if mode == 0 { assert(!mir.add_range(&mut work, 1, 1)) }
        if mode == 1 { assert(!mir.add_range(&mut work, -1, 2)) }
        if mode == 2 { assert(!mir.add_range(&mut work, 3, 2)) }
        if mode == 3 { assert(mir.add_range(&mut work, 2, 4)); assert(!mir.add_range(&mut work, 3, 5)) }
        if mode == 4 { assert(mir.add_range(&mut work, 2, 4)); assert(!mir.add_range(&mut work, 1, 2)) }
        if mode == 5 { assert(mir.add_range(&mut work, 1, 14)) }
        if mode < 5 { assert(!mir.add_range(&mut work, 4, 5)) }
        reject(&mut work, &mut code, &mut sites, 1, 1, 1, 0)
    }
    mir.reset(&mut work); var code := plain(); assert(mir.add_range(&mut work, 1, 2))
    assert(mir.compact(&mut work, &mut code, 1, 1, 1, &mut sites, 0))
    mir.reset(&mut work)
    // Empty plans have no effect and do not even inspect malformed inputs.
    code.checking = true; code.target.push(-99); old := code
    assert(mir.compact(&mut work, &mut code, -100, -100, -100, &mut sites, -100))
    equal(&code, &old, &sites, &sites)
}

@test fn reusable_map_matches_independent_removal_count_across_function_sizes() {
    var work := mir.new(); var sites: []i32 = []
    for round in 0..5 {
        for size in [2500, 1, 47, 3, 129] {
            var code := arm.new(); entry := arm.label(&mut code)
            arm.branch(&mut code, entry, 1); arm.mark(&mut code, entry)
            for i in 0..size { arm.imm(&mut code, 0, i64(i)); code.labels.push(i + 1) }
            code.labels.push(size + 1)
            mir.reset(&mut work)
            var start := 1
            while start <= size {
                var end := start + 2; if end > size + 1 { end = size + 1 }
                assert(mir.add_range(&mut work, start, end)); start = start + 5
            }
            assert(mir.compact(&mut work, &mut code, 1, 1, 1, &mut sites, 0))
            var expected := 1
            for source in 1..size + 2 {
                assert(mir.boundary(&work, source) == expected && code.labels[source] == expected)
                if source <= size && (source - 1) % 5 >= 2 {
                    assert(code.words[expected] == 3531603968 + i64(source - 1) * 32)
                    expected = expected + 1
                }
            }
            assert(code.words.len == expected && code.labels[0] == 1 && code.at[0] == 0)
        }
    }
}
