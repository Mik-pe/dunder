import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_memory as memory
import ..selfhost.mir_ssa_cells as cells

fn begin(platform: i32, slots: i32) -> arm.Code {
    var c := arm.new_for(platform); arm.begin_mir(&mut c, true)
    frame := arm.prologue(&mut c); arm.frame(&mut c, frame, slots); c
}
fn load(c: &mut arm.Code, offset: i32, width: i32, sign: bool) {
    var op: i64 = 4164943872
    if width == 1 { op = 943718400 }; if width == 2 { op = 2017460224 }
    if width == 4 { op = 3091202048; if sign { op = 3095396352 } }
    arm.emit(&mut c, op + i64(offset).bit_and(511) * 4096 + 29 * 32)
}
fn store(c: &mut arm.Code, offset: i32, width: i32) {
    var op: i64 = 4160749568
    if width == 1 { op = 939524096 }; if width == 2 { op = 2013265920 }; if width == 4 { op = 3087007744 }
    arm.emit(&mut c, op + i64(offset).bit_and(511) * 4096 + 29 * 32)
}
fn model(c: &arm.Code) -> mir.Function {
    var f := mir.new(); none: []i32 = []
    assert(lift.lift_spans(&mut f, &c, 0, 0, 0, &none, 0,
        &c.mir_starts, &c.mir_ends, &c.mir_kinds, &c.mir_a, &c.mir_b))
    assert(verify.verify(&mut f)); f
}
fn sample(platform: i32) -> mir.Function {
    var c := begin(platform, 4); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1)
    load(&mut c, -8, 8, false); load(&mut c, -7, 1, false); load(&mut c, -6, 2, false)
    load(&mut c, -4, 4, false); load(&mut c, -4, 4, true); arm.ret(&mut c); model(&c)
}
fn at_offset(f: &mir.Function, offset: i32, width: i32) -> i32 {
    for p in 0..f.place_kinds.len { if f.place_kinds[p] == 1 && f.place_offsets[p] == offset && f.place_widths[p] == width { return p } }; -1
}
fn empty_result(p: &cells.Plan, op: i32, place: i32) {
    assert(cells.group_count(&p) == 0 && cells.group_place(&p, 0) == -1 && cells.group_offset(&p, 0) == 0)
    assert(cells.op_group(&p, op) == -1 && cells.place_group(&p, place) == -1)
    assert(cells.op_width(&p, op) == 0 && cells.op_extension(&p, op) == -1 && cells.op_view_shift(&p, op) == -1)
    assert(cells.op_barrier(&p, op))
}
@test fn full_stores_support_explicit_shifted_zero_and_signed_read_views_on_all_targets() {
    source := memory.trusted_source_objects_v1(); var p := cells.new()
    for target in 0..4 {
        f := sample(target); assert(cells.analyze_with_context(&mut p, &f, &source))
        assert(cells.status(&p) == 1 && cells.group_count(&p) == 2)
        full := at_offset(&f, -8, 8); g := cells.place_group(&p, full)
        assert(g >= 0 && cells.group_offset(&p, g) == -8 && cells.group_place(&p, g) == full)
        var reads := 0; var signed := 0; var zero := 0
        for op in 0..f.kinds.len {
            if f.kinds[op] != 7 { continue }; assert(cells.op_group(&p, op) == g)
            width := f.aux[op]; assert(cells.op_width(&p, op) == width)
            assert(cells.op_view_shift(&p, op) == i32((f.imm[op] + 8) * 8))
            assert(cells.op_extension(&p, op) == f.extensions[op] && !cells.op_barrier(&p, op))
            if f.extensions[op] == 2 { signed = signed + 1 }; if f.extensions[op] == 1 { zero = zero + 1 }; reads = reads + 1
        }
        assert(reads == 5 && signed == 1 && zero == 3)
        // Per-op extension is not part of Place identity.
        word := at_offset(&f, -4, 4); assert(cells.place_group(&p, word) == g)
        assert(cells.group_offset(&p, -1) == 0 && cells.op_group(&p, -1) == -1 && cells.op_barrier(&p, -1))
        assert(f.valid && f.verified)
    }
}
@test fn any_partial_store_rejects_the_entire_cell_but_not_disjoint_cells() {
    var p := cells.new()
    for width in [1, 2, 4] {
        var c := begin(0, 4); arm.store(&mut c, 0, 0); arm.store(&mut c, 1, 1)
        load(&mut c, -8, 1, false); store(&mut c, -8, width); load(&mut c, -8, 8, false); arm.ret(&mut c)
        f := model(&c); assert(cells.analyze_into(&mut p, &f) && cells.group_count(&p) == 1)
        assert(cells.group_offset(&p, 0) == -16)
        for place in 0..f.place_kinds.len { if f.place_offsets[place] == -8 { assert(cells.place_group(&p, place) == -1) } }
        for op in 0..f.kinds.len { if f.place[op] >= 0 && f.place_offsets[f.place[op]] == -8 { assert(cells.op_group(&p, op) == -1) } }
    }
}
@test fn crossing_reads_and_stores_poison_both_overlapped_cells() {
    var p := cells.new()
    for write in [false, true] {
        var c := begin(0, 4); for slot in 0..3 { arm.store(&mut c, slot, 0) }
        if write { store(&mut c, -12, 8) } else { load(&mut c, -12, 8, false) }; arm.ret(&mut c)
        f := model(&c); assert(cells.analyze_into(&mut p, &f) && cells.group_count(&p) == 1)
        assert(cells.group_offset(&p, 0) == -24)
    }
}
@test fn zero_stores_are_full_definitions_and_deleted_partial_stores_do_not_poison_views() {
    var c := begin(0, 2); arm.store(&mut c, 0, 31); store(&mut c, -8, 1); load(&mut c, -8, 4, false); arm.ret(&mut c)
    var f := model(&c); var p := cells.new()
    assert(cells.analyze_into(&mut p, &f) && cells.group_count(&p) == 0)
    var zeros := 0
    for op in 0..f.kinds.len {
        if f.kinds[op] == 8 && f.aux[op] == 1 { f.modes[op] = 2 }
        if f.kinds[op] == 8 && f.aux[op] == 8 { assert(f.a[op] == -1); zeros = zeros + 1 }
    }
    assert(zeros == 1 && verify.verify(&mut f) && cells.analyze_into(&mut p, &f) && cells.group_count(&p) == 1)
}
@test fn escaped_and_unused_overlapping_shapes_are_checked_without_pairwise_scans() {
    var p := cells.new(); var f := sample(0)
    escaped := mir.add_place(&mut f, 1, -7, 1, 0); f.place_escaped[escaped] = true; assert(verify.verify(&mut f))
    assert(cells.analyze_into(&mut p, &f) && cells.group_count(&p) == 1 && cells.group_offset(&p, 0) == -16)
    var c := begin(0, 4); for slot in 0..4 { arm.store(&mut c, slot, 0) }; arm.ret(&mut c); var wide := model(&c)
    unused := mir.add_place(&mut wide, 1, -20, 16, 0); assert(verify.verify(&mut wide))
    assert(cells.analyze_into(&mut p, &wide) && cells.group_count(&p) == 1 && cells.group_offset(&p, 0) == -32)
    wide.place_widths[unused] = 17; assert(verify.verify(&mut wide))
    assert(!cells.analyze_into(&mut p, &wide) && cells.status(&p) == -2); empty_result(&p, 4, 0)
    var address := begin(0, 4); arm.store(&mut address, 0, 0); arm.address(&mut address, 0); arm.ret(&mut address)
    exposed := model(&address); source := memory.trusted_source_objects_v1()
    assert(cells.analyze_into(&mut p, &exposed) && cells.group_count(&p) == 0)
    assert(!cells.analyze_with_context(&mut p, &exposed, &source) && cells.status(&p) == -2)
}
@test fn source_context_exempts_only_indirect_memory_and_never_calls() {
    var c := begin(0, 2); called := arm.label(&mut c); arm.store(&mut c, 0, 0)
    arm.emit(&mut c, 4181721088 + 2 * 32 + 3); arm.emit(&mut c, 4177526784 + 2 * 32 + 3)
    arm.branch(&mut c, called, 1); arm.ret(&mut c); f := model(&c)
    raw := memory.conservative(); source := memory.trusted_source_objects_v1(); var p := cells.new()
    for trusted in [false, true] {
        if trusted { assert(cells.analyze_with_context(&mut p, &f, &source)) }
        else { assert(cells.analyze_with_context(&mut p, &f, &raw)) }
        assert(cells.group_count(&p) == 1)
        var heap := 0; var calls := 0
        for op in 0..f.kinds.len {
            if f.kinds[op] == 14 { assert(cells.op_barrier(&p, op)); calls = calls + 1; assert(f.reads[op] == -1 && f.clobbers[op] == -1) }
            if (f.kinds[op] == 7 || f.kinds[op] == 8) && f.place_kinds[f.place[op]] == 0 {
                assert(cells.op_barrier(&p, op) == !trusted && cells.op_group(&p, op) == -1); heap = heap + 1
            }
        }; assert(heap == 2 && calls == 1)
    }
}
@test fn no_anchor_and_no_reaching_store_are_distinct_from_initialization_proofs() {
    var c := begin(0, 2); load(&mut c, -8, 1, false); arm.ret(&mut c); f := model(&c); var p := cells.new()
    assert(cells.analyze_into(&mut p, &f) && cells.group_count(&p) == 0)
    var full := begin(0, 2); load(&mut full, -8, 8, false); arm.ret(&mut full); uninitialized := model(&full)
    assert(cells.analyze_into(&mut p, &uninitialized) && cells.group_count(&p) == 1)
    // Classification alone never fabricates an initialized SSA value.
    assert(cells.group_place(&p, 0) == at_offset(&uninitialized, -8, 8))
}
@test fn late_initializer_backward_transfer_does_not_require_a_syntactic_loop() {
    var c := begin(0, 2); body := arm.label(&mut c); initialize := arm.label(&mut c); arm.branch(&mut c, initialize, 0)
    arm.mark(&mut c, body); load(&mut c, -8, 4, false); arm.ret(&mut c)
    arm.mark(&mut c, initialize); arm.store(&mut c, 0, 0); arm.branch(&mut c, body, 0)
    f := model(&c); source := memory.trusted_source_objects_v1(); var p := cells.new()
    assert(cells.analyze_with_context(&mut p, &f, &source) && cells.group_count(&p) == 1)
}
@test fn sparse_huge_frames_use_work_proportional_to_accesses_and_keep_scratch_obligations() {
    var c := begin(0, 2000000); arm.store(&mut c, 0, 0); arm.store(&mut c, 1999999, 1); arm.ret(&mut c)
    f := model(&c); source := memory.trusted_source_objects_v1(); var p := cells.new()
    assert(cells.analyze_with_context(&mut p, &f, &source) && cells.group_count(&p) == 2 && cells.units(&p) < 1000)
    var scratch := 0
    for op in 0..f.kinds.len {
        if f.kinds[op] == 8 && f.clobbers[op].bit_and(mir.variable_bit(9)) != 0 {
            assert(cells.op_group(&p, op) >= 0 && f.clobbers[op].bit_and(mir.variable_bit(9)) != 0); scratch = scratch + 1
        }
    }; assert(scratch == 1)
}
@test fn bounded_hash_clusters_refuse_atomically_instead_of_quadratic_probing() {
    var c := begin(0, 34000)
    // All33 offsets collide in this bounded interner. Refusal is valid and
    // must not expose the32 partially constructed groups to the SSA caller.
    for i in 1..34 { arm.store(&mut c, i * 1024 - 1, 0) }; arm.ret(&mut c)
    f := model(&c); var p := cells.new(); assert(!cells.analyze_into(&mut p, &f) && cells.status(&p) == -3)
    assert(cells.probe_count(&p) <= 33 * 32); empty_result(&p, 4, 0)
    next := sample(0); assert(cells.analyze_into(&mut p, &next) && cells.group_count(&p) == 2)
}
@test fn fresh_and_reused_plans_match_and_budget_or_invalid_returns_never_publish_stale_groups() {
    f := sample(0); var p := cells.new(); assert(cells.analyze_into(&mut p, &f)); work := cells.units(&p)
    assert(!cells.analyze_budget(&mut p, &f, work - 1) && cells.status(&p) == -3); empty_result(&p, 4, 0)
    assert(!cells.analyze_budget(&mut p, &f, 0) && cells.units(&p) == 0); empty_result(&p, 4, 0)
    var invalid := f; removed := invalid.extensions.pop()
    assert(!cells.analyze_into(&mut p, &invalid) && cells.status(&p) == -1); empty_result(&p, 4, 0)
    var q := cells.new(); assert(cells.analyze_into(&mut p, &f) && cells.analyze_into(&mut q, &f))
    assert(cells.units(&p) == cells.units(&q) && cells.group_count(&p) == cells.group_count(&q))
    for op in 0..f.kinds.len {
        assert(cells.op_group(&p, op) == cells.op_group(&q, op) && cells.op_width(&p, op) == cells.op_width(&q, op))
        assert(cells.op_view_shift(&p, op) == cells.op_view_shift(&q, op) && cells.op_extension(&p, op) == cells.op_extension(&q, op))
        assert(cells.op_barrier(&p, op) == cells.op_barrier(&q, op))
    }
    var leaf := arm.new(); arm.emit(&mut leaf, 3596551104); plain := model(&leaf)
    assert(cells.analyze_into(&mut p, &plain) && cells.group_count(&p) == 0 && cells.op_group(&p, 0) == -1)
    var future := f; future.platform = 4
    assert(!cells.analyze_into(&mut p, &future) && cells.status(&p) == -2); empty_result(&p, 4, 0)
    var crossing_limit := f; overflow := mir.add_place(&mut crossing_limit, 1, 2147483647, 16, 0)
    assert(verify.verify(&mut crossing_limit))
    assert(!cells.analyze_into(&mut p, &crossing_limit) && cells.status(&p) == -2); empty_result(&p, 4, overflow)
}
@test fn missing_or_ended_frame_lifetime_never_grants_private_cell_proofs() {
    var raw := arm.new(); load(&mut raw, -8, 8, false); arm.emit(&mut raw, 3596551104); f := model(&raw)
    var p := cells.new(); assert(!cells.analyze_into(&mut p, &f) && cells.status(&p) == -2)
    var c := begin(0, 2); arm.emit(&mut c, 2432697279); load(&mut c, -8, 8, false); arm.emit(&mut c, 3596551104)
    ended := model(&c); assert(!cells.analyze_into(&mut p, &ended) && cells.status(&p) == -2)
}
fn main() {}
