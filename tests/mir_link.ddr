import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_lower as lower
import ..selfhost.mir_link as link
import mir_object_support as support

fn take(f: &mut mir.Function, code: &arm.Code, entry: i32, first: i32, first_label: i32, first_reloc: i32,
    sites: &[]i32, first_import: i32) {
    assert(lift.lift(&mut f, &code, first, first_label, first_reloc, &sites, first_import))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
}
fn output(w: &mut link.Linker, code: &mut arm.Code, sites: &mut []i32, count: i32) {
    assert(link.seal_namespace(&mut w, count) && link.finalize(&mut w))
    link.export_import_sites(&mut w, &mut sites); link.export_code(&mut w, &mut code)
    assert(link.state(&w) == 4)
}
fn same_link(a: &link.Linker, b: &link.Linker) {
    assert(link.state(&a) == link.state(&b) && link.next_ordinal(&a) == link.next_ordinal(&b))
    assert(link.word_count(&a) == link.word_count(&b) && link.label_count(&a) == link.label_count(&b))
    assert(link.relocation_count(&a) == link.relocation_count(&b) && link.import_site_count(&a) == link.import_site_count(&b))
    for at in 0..link.word_count(&a) { assert(link.word_at(&a, at) == link.word_at(&b, at)) }
    for id in 0..link.label_count(&a) { assert(link.label_at(&a, id) == link.label_at(&b, id) && link.label_owner(&a, id) == link.label_owner(&b, id)) }
    for id in 0..link.import_site_count(&a) { assert(link.import_site_at(&a, id) == link.import_site_at(&b, id) && link.import_site_owner(&a, id) == link.import_site_owner(&b, id)) }
    for at in 0..link.relocation_count(&a) {
        assert(link.relocation_at(&a, at) == link.relocation_at(&b, at) && link.relocation_target(&a, at) == link.relocation_target(&b, at))
        assert(link.relocation_kind(&a, at) == link.relocation_kind(&b, at))
    }
}
fn simple_object(object: &mut lower.FunctionObject, platform: i32, entry: i32) {
    var code := arm.new_for(platform)
    for i in 0..entry + 1 { id := arm.label(&mut code) }
    arm.mark(&mut code, entry); arm.imm(&mut code, 0, 42); arm.emit(&mut code, 3596551104)
    none: []i32 = []; var f := mir.new(); take(&mut f, &code, entry, 0, code.labels.len, 0, &none, 0)
    assert(lower.lower_into(&mut object, &f))
}
@test fn namespace_growth_preserves_prefix_and_unbound_global_entries() {
    for platform in 0..4 {
        var prefix := arm.new_for(platform); entry := arm.label(&mut prefix); unused := arm.label(&mut prefix)
        arm.branch(&mut prefix, entry, 1); arm.emit(&mut prefix, 3573751839)
        var object := lower.new_object(); simple_object(&mut object, platform, entry)
        none: []i32 = []; var w := link.new(); assert(link.begin(&mut w, &prefix, &none))
        assert(link.reserve_namespace(&mut w, 8, 0) && link.reserve_namespace(&mut w, 8, 0))
        assert(!link.reserve_namespace(&mut w, 7, 0) && !link.reserve_namespace(&mut w, 8, -1))
        assert(link.label_owner(&w, entry) == -1 && link.label_owner(&w, unused) == -1)
        assert(link.append(&mut w, &object, 0)); lower.reset_object(&mut object)
        assert(link.label_at(&w, entry) == prefix.words.len && link.label_owner(&w, entry) == 0)
        for at in 0..prefix.words.len { assert(link.word_at(&w, at) == prefix.words[at]) }
        var code := arm.new(); var sites: []i32 = []; output(&mut w, &mut code, &mut sites, 1)
        assert(code.platform == platform && code.labels.len == 8 && code.labels[unused] == -1 && sites.len == 0)
        assert(prefix.labels[entry] == -1 && prefix.words.len == 2)
    }
}
@test fn all_symbolic_pairs_end_labels_and_owned_unmarked_labels_rebase_once() {
    for platform in 0..4 {
        for kind in 0..21 {
            var prefix := arm.new_for(platform); outside := arm.label(&mut prefix); entry := arm.label(&mut prefix)
            arm.mark(&mut prefix, outside); arm.imm(&mut prefix, 0, 17)
            var source := arm.new_for(platform); support.copy_code(&mut source, &prefix)
            first := source.words.len; first_label := source.labels.len
            arm.mark(&mut source, entry); end := arm.label(&mut source); forward_data := arm.label(&mut source)
            arm.branch(&mut source, outside, kind); arm.branch(&mut source, end, kind); arm.branch(&mut source, forward_data, 20)
            arm.imm(&mut source, 0, 7); arm.emit(&mut source, 3596551104); arm.mark(&mut source, end)
            var f := mir.new(); none: []i32 = []; take(&mut f, &source, entry, first, first_label, 0, &none, 0)
            var object := lower.new_object(); assert(lower.lower_into(&mut object, &f))
            var w := link.new(); assert(link.begin(&mut w, &prefix, &none)); assert(link.reserve_namespace(&mut w, source.labels.len, 0))
            assert(link.append(&mut w, &object, 0) && link.label_at(&w, forward_data) == -1 && link.label_owner(&w, forward_data) == 0)
            var linked := arm.new(); var sites: []i32 = []; output(&mut w, &mut linked, &mut sites, 1)
            support.same_code(&source, &linked)
            // Relocatable finalization intentionally keeps forward data unbound.
            assert(linked.labels[end] == linked.words.len && linked.labels[forward_data] == -1)
        }
    }
}
@test fn import_site_ids_rebase_bytes_and_do_not_name_symbol_slots() {
    for platform in 0..4 {
        var prefix := arm.new_for(platform); entry := arm.label(&mut prefix)
        arm.emit(&mut prefix, 0); arm.emit(&mut prefix, 0)
        prefix_sites: []i32 = [0]; symbol_slots: []i32 = [77, 77, -9]
        var source := arm.new_for(platform); support.copy_code(&mut source, &prefix)
        first := source.words.len; arm.mark(&mut source, entry)
        var sites: []i32 = [0, first * 4]; arm.emit(&mut source, 4244635648); arm.emit(&mut source, 0)
        arm.imm(&mut source, 0, 42); sites.push(source.words.len * 4); arm.emit(&mut source, 0); arm.emit(&mut source, 0)
        arm.emit(&mut source, 3596551104)
        var f := mir.new(); take(&mut f, &source, entry, first, source.labels.len, 0, &sites, 1)
        var object := lower.new_object(); assert(lower.lower_into(&mut object, &f))
        var w := link.new(); assert(link.begin(&mut w, &prefix, &prefix_sites)); assert(link.reserve_namespace(&mut w, source.labels.len, 3))
        assert(link.append(&mut w, &object, 0)); var result := arm.new(); var actual: []i32 = []; output(&mut w, &mut result, &mut actual, 1)
        support.same_code(&source, &result); support.same_i32(&sites, &actual)
        assert(actual.len == 3 && actual[1] == first * 4 && link.import_site_owner(&w, 0) == -2)
        assert(link.import_site_owner(&w, 1) == 0 && link.import_site_owner(&w, 2) == 0)
        assert(symbol_slots[0] == 77 && symbol_slots[1] == 77 && symbol_slots[2] == -9)
    }
}
@test fn rejected_appends_namespace_limits_and_job_counts_are_atomic() {
    var prefix := arm.new(); entry := arm.label(&mut prefix); arm.emit(&mut prefix, 3573751839)
    none: []i32 = []; var object := lower.new_object(); simple_object(&mut object, 0, entry)
    var w := link.new(); var reference := link.new()
    assert(link.begin_limited(&mut w, &prefix, &none, 8, 2, 1)); assert(link.begin_limited(&mut reference, &prefix, &none, 8, 2, 1))
    assert(!link.append(&mut w, &object, 1)); same_link(&w, &reference)
    assert(!link.append(&mut w, &object, -1)); same_link(&w, &reference)
    assert(!link.reserve_namespace(&mut w, 3, 0)); same_link(&w, &reference)
    assert(!link.reserve_namespace(&mut w, 2, 2)); same_link(&w, &reference)
    var foreign := lower.new_object(); simple_object(&mut foreign, 1, entry)
    assert(!link.append(&mut w, &foreign, 0)); same_link(&w, &reference)
    lower.reset_object(&mut foreign); assert(!link.append(&mut w, &foreign, 0)); same_link(&w, &reference)
    assert(link.append(&mut w, &object, 0) && link.append(&mut reference, &object, 0))
    assert(!link.append(&mut w, &object, 0)); same_link(&w, &reference)
    assert(!link.append(&mut w, &object, 1)); same_link(&w, &reference) // Already owned entry.
    assert(!link.seal_namespace(&mut w, 0)); same_link(&w, &reference)
    assert(link.seal_namespace(&mut w, 2)); assert(!link.finalize(&mut w)) // Missing ordinal1.
    assert(!link.reserve_namespace(&mut w, 2, 0)); assert(link.state(&w) == 2)
    link.reset(&mut w); assert(link.begin_limited(&mut w, &prefix, &none, 2, 2, 1))
    assert(!link.append(&mut w, &object, 0) && link.word_count(&w) == 1 && link.next_ordinal(&w) == 0)
    assert(!link.begin(&mut w, &prefix, &none) && link.word_count(&w) == 1)
}
@test fn duplicate_unmarked_labels_and_nonmonotonic_import_ids_are_refused() {
    var prefix := arm.new(); entry := arm.label(&mut prefix); shared := arm.label(&mut prefix)
    none: []i32 = []; var source := arm.new(); support.copy_code(&mut source, &prefix)
    arm.mark(&mut source, entry); arm.imm(&mut source, 0, 7); arm.emit(&mut source, 3596551104)
    var f := mir.new(); take(&mut f, &source, entry, 0, source.labels.len, 0, &none, 0)
    // Invalid producer metadata is intentionally admitted by lowerer's trusted
    // verified flag to exercise the coordinator's independent object checks.
    f.label_ids.push(shared); f.label_ops.push(-1)
    var a := lower.new_object(); assert(lower.lower_into(&mut a, &f))
    var w := link.new(); assert(link.begin(&mut w, &prefix, &none)); assert(link.append(&mut w, &a, 0))
    assert(link.label_owner(&w, shared) == 0 && link.label_at(&w, shared) == -1)
    f.label_ids[0] = shared; removed_id := f.label_ids.pop(); removed_at := f.label_ops.pop(); f.label_ops[0] = -1
    var b := lower.new_object(); assert(lower.lower_into(&mut b, &f))
    before := link.word_count(&w); assert(!link.append(&mut w, &b, 1) && link.word_count(&w) == before)
    // A global site1 record cannot arrive before site0, even when both IDs
    // have been reserved and the relocation byte offsets themselves are valid.
    var imported := arm.new(); e := arm.label(&mut imported); arm.mark(&mut imported, e)
    arm.emit(&mut imported, 0); arm.emit(&mut imported, 0); arm.emit(&mut imported, 3596551104)
    real_sites: []i32 = [0]; assert(lift.lift(&mut f, &imported, 0, 1, 0, &real_sites, 0)); assert(lift.own_entry(&mut f, &imported, e) && verify.verify(&mut f))
    f.import_ids[0] = 1; f.first_import = 1; f.source_imports = 2
    assert(lower.lower_into(&mut b, &f)); link.reset(&mut w); assert(link.begin(&mut w, &prefix, &none))
    assert(link.reserve_namespace(&mut w, prefix.labels.len, 2)); assert(!link.append(&mut w, &b, 0) && link.next_ordinal(&w) == 0)
    assert(link.seal_namespace(&mut w, 0) && !link.finalize(&mut w)) // Reserved site IDs still missing.
}
@test fn malformed_prefix_records_and_pair_interior_labels_are_never_copied() {
    var w := link.new(); none: []i32 = []
    for mode in 0..11 {
        var prefix := arm.new(); label := arm.label(&mut prefix); arm.branch(&mut prefix, label, 20)
        if mode == 0 { prefix.labels[label] = 1 }
        if mode == 1 { prefix.at[0] = -1 }; if mode == 2 { prefix.target[0] = 1 }
        if mode == 3 { prefix.kinds[0] = 21 }; if mode == 4 { prefix.words[0] = 1 }
        if mode == 5 { prefix.words[1] = 0 }; if mode == 6 { removed := prefix.target.pop() }
        if mode == 7 { prefix.words[1] = 4294967296 }
        if mode == 8 { prefix.effect_depth = 1 }; if mode == 9 { prefix.mir_capture = true }
        if mode == 10 { prefix.labels[label] = -2 }
        assert(!link.begin(&mut w, &prefix, &none) && link.state(&w) == 0 && link.word_count(&w) == 0)
    }
    var prefix := arm.new(); target := arm.label(&mut prefix); arm.branch(&mut prefix, target, 20)
    overlapping: []i32 = [0]; assert(!link.begin(&mut w, &prefix, &overlapping))
    malformed: []i32 = [1]; assert(!link.begin(&mut w, &prefix, &malformed))
    checking := arm.new_check(0); assert(!link.begin(&mut w, &checking, &none))
}

@test fn future_namespace_targets_and_internal_duplicate_owners_are_checked_before_copy() {
    var prefix := arm.new(); for id in 0..2 { declared := arm.label(&mut prefix) }
    arm.emit(&mut prefix, 3573751839); none: []i32 = []
    var source := arm.new(); support.copy_code(&mut source, &prefix)
    for id in 2..4 { declared := arm.label(&mut source) }
    first := source.words.len; arm.mark(&mut source, 0); arm.branch(&mut source, 3, 20); arm.emit(&mut source, 3596551104)
    var f := mir.new(); take(&mut f, &source, 0, first, 4, 0, &none, 0)
    var object := lower.new_object(); assert(lower.lower_into(&mut object, &f))
    var w := link.new(); var reference := link.new()
    assert(link.begin(&mut w, &prefix, &none) && link.begin(&mut reference, &prefix, &none))
    assert(!link.append(&mut w, &object, 0)); same_link(&w, &reference)
    assert(link.reserve_namespace(&mut w, 4, 0) && link.append(&mut w, &object, 0))
    assert(link.label_at(&w, 3) == -1 && link.label_owner(&w, 3) == -1)
    assert(link.seal_namespace(&mut w, 1) && link.finalize(&mut w))
    var image := arm.new(); var sites: []i32 = []
    link.export_code(&mut w, &mut image); link.export_import_sites(&mut w, &mut sites)
    // The final image owner may bind a forward runtime/data label afterward.
    image.labels[3] = image.words.len; assert(link.state(&w) == 4)
    link.reset(&mut w); assert(link.begin(&mut w, &prefix, &none))
    assert(link.reserve_namespace(&mut w, 4, 0) && link.reserve_namespace(&mut reference, 4, 0))
    f.label_ids.push(0); f.label_ops.push(-1)
    assert(lower.lower_into(&mut object, &f)); assert(!link.append(&mut w, &object, 0))
    same_link(&w, &reference)
}
@test fn namespace_seal_can_precede_completed_jobs_and_publication_preserves_code_flags() {
    var prefix := arm.new(); id := arm.label(&mut prefix); prefix.profile = true; prefix.effect_epoch = 17
    none: []i32 = []; var object := lower.new_object(); simple_object(&mut object, 0, id)
    var w := link.new(); assert(link.begin(&mut w, &prefix, &none))
    assert(link.seal_namespace(&mut w, 1) && !link.finalize(&mut w))
    assert(link.append(&mut w, &object, 0) && link.finalize(&mut w)); assert(!link.append(&mut w, &object, 1))
    var code := arm.new(); var sites: []i32 = []
    link.export_code(&mut w, &mut code); assert(link.state(&w) == 3)
    link.export_import_sites(&mut w, &mut sites); assert(link.state(&w) == 4)
    assert(code.profile && code.effect_epoch == 17 && code.labels[id] == 0)
}
