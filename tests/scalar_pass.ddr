import ..selfhost.opt_ir as ir
import ..selfhost.opt_pass as pass
import ..selfhost.opt_parse as parse
import ..selfhost.lexer
import ..selfhost.opt_verify as verify

fn node(f: &mut ir.Function, kind: i32, ty: i32, left: i32, right: i32, third: i32, value: i64, local: i32) -> i32 {
    id := f.nodes.kinds.len
    f.nodes.kinds.push(kind); f.nodes.types.push(ty); f.nodes.left.push(left); f.nodes.right.push(right); f.nodes.third.push(third)
    f.nodes.next.push(-1); f.nodes.values.push(value); f.nodes.locals.push(local); f.nodes.starts.push(id)
    f.nodes.effects.push(1); f.nodes.proofs.push(0)
    id
}
fn local(f: &mut ir.Function, ty: i32, mutable: bool, parameter: i32) -> i32 {
    id := f.local_types.len
    f.local_names.push("local" + id.str()); f.local_types.push(ty); f.local_mutable.push(mutable)
    f.local_param.push(parameter); f.local_at.push(id)
    id
}
fn number(f: &mut ir.Function, ty: i32, value: i64) -> i32 { node(&mut f, 1, ty, -1, -1, -1, value, -1) }
fn read(f: &mut ir.Function, ty: i32, local: i32) -> i32 { node(&mut f, 2, ty, -1, -1, -1, 0, local) }
fn binary(f: &mut ir.Function, ty: i32, op: i64, left: i32, right: i32) -> i32 { node(&mut f, 3, ty, left, right, -1, op, -1) }
fn block(f: &mut ir.Function, first: i32) -> i32 { node(&mut f, 10, 0, first, -1, -1, 0, -1) }
fn result(f: &mut ir.Function, expression: i32) {
    ret := node(&mut f, 15, 0, expression, -1, -1, 0, -1)
    f.root = block(&mut f, ret); f.ret = f.nodes.types[expression]; f.supported = true
}

@test fn checked_constants_never_turn_runtime_traps_into_compile_time_traps() {
    for width in [1, 2] {
        var minimum: i64 = -2147483648; var maximum: i64 = 2147483647
        if width == 2 { minimum = -9223372036854775808; maximum = 9223372036854775807 }
        for operation in 1..6 {
            var f := ir.new()
            var a := maximum; var b: i64 = 1
            if operation == 2 { a = minimum }
            if operation == 3 { b = 2 }
            if operation == 4 || operation == 5 { a = minimum; b = -1 }
            left := number(&mut f, width, a); right := number(&mut f, width, b)
            value := binary(&mut f, width, i64(operation), left, right); result(&mut f, value)
            pass.run(&mut f)
            assert(f.nodes.kinds[value] == 3 && f.nodes.proofs[value] == 0 && !f.budget_exhausted)
        }
        for operation in 4..6 {
            var f := ir.new()
            left := number(&mut f, width, 7); right := number(&mut f, width, 0)
            value := binary(&mut f, width, i64(operation), left, right); result(&mut f, value)
            pass.run(&mut f)
            assert(f.nodes.kinds[value] == 3 && f.nodes.proofs[value] == 0)
        }
        var f := ir.new()
        operand := number(&mut f, width, minimum)
        value := node(&mut f, 4, width, operand, -1, -1, 1, -1); result(&mut f, value)
        pass.run(&mut f)
        assert(f.nodes.kinds[value] == 4 && f.nodes.proofs[value] == 0)
    }
    for operation in 1..6 {
        var f := ir.new()
        left := number(&mut f, 2, -12); right := number(&mut f, 2, 5)
        value := binary(&mut f, 2, i64(operation), left, right); result(&mut f, value)
        pass.run(&mut f)
        expected: [i64;5] = [-7, -17, -60, -2, -2]
        assert(f.nodes.kinds[value] == 1 && f.nodes.values[value] == expected[operation - 1])
    }
    // In particular, overflow detection must not itself divide MIN by -1.
    lefts: [i64;9] = [-9223372036854775808, -9223372036854775808, -9223372036854775808, 9223372036854775807, 9223372036854775807, -3037000500, 3037000499, 4611686018427387904, -9223372036854775808]
    rights: [i64;9] = [0, 1, -1, 2, -1, -3037000500, 3037000499, -2, -9223372036854775808]
    safe: [bool;9] = [true, true, false, false, true, false, true, true, false]
    products: [i64;9] = [0, -9223372036854775808, 0, 0, -9223372036854775807, 0, 9223372030926249001, -9223372036854775808, 0]
    for i in 0..lefts.len {
        var f := ir.new()
        left := number(&mut f, 2, lefts[i]); right := number(&mut f, 2, rights[i])
        value := binary(&mut f, 2, 3, left, right); result(&mut f, value)
        pass.run(&mut f)
        if safe[i] { assert(f.nodes.kinds[value] == 1 && f.nodes.values[value] == products[i]) }
        else { assert(f.nodes.kinds[value] == 3 && f.nodes.proofs[value] == 0) }
    }
}

@test fn propagation_preserves_short_circuit_and_statement_successors() {
    for operation in [12, 13] {
        var f := ir.new()
        lhs := number(&mut f, 3, i64(operation - 12))
        seven := number(&mut f, 2, 7); zero := number(&mut f, 2, 0)
        division := binary(&mut f, 2, 4, seven, zero)
        rhs := binary(&mut f, 3, 6, division, seven)
        value := binary(&mut f, 3, i64(operation), lhs, rhs); result(&mut f, value)
        pass.run(&mut f)
        assert(f.nodes.kinds[value] == 1 && f.nodes.values[value] == i64(operation - 12))
        assert(f.nodes.kinds[division] == 3 && f.nodes.kinds[rhs] == 3)
    }
    for operation in [12, 13] {
        var f := ir.new()
        parameter := local(&mut f, 3, false, 0); f.params = 1
        lhs := read(&mut f, 3, parameter); rhs := number(&mut f, 3, i64(operation - 12))
        value := binary(&mut f, 3, i64(operation), lhs, rhs); result(&mut f, value)
        pass.run(&mut f)
        assert(f.nodes.kinds[value] == 3 && f.nodes.kinds[lhs] == 2)
    }

    var f := ir.new()
    x := local(&mut f, 2, true, -1)
    seven := number(&mut f, 2, 7); nine := number(&mut f, 2, 9)
    set_then := node(&mut f, 12, 0, seven, -1, -1, 0, x)
    set_else := node(&mut f, 12, 0, nine, -1, -1, 0, x)
    then_block := block(&mut f, set_then); else_block := block(&mut f, set_else)
    condition := number(&mut f, 3, 1)
    choice := node(&mut f, 13, 0, condition, then_block, else_block, 0, -1)
    loaded := read(&mut f, 2, x); ret := node(&mut f, 15, 0, loaded, -1, -1, 0, -1)
    f.nodes.next[choice] = ret; f.root = block(&mut f, choice); f.ret = 2; f.supported = true
    pass.run(&mut f)
    assert(f.nodes.kinds[choice] == 10 && f.nodes.next[choice] == ret)
    assert(f.nodes.kinds[loaded] == 1 && f.nodes.values[loaded] == 7)
}

fn loop_model(mode: i32) -> ir.Function {
    var f := ir.new()
    array := local(&mut f, 20, false, 0); flag := local(&mut f, 3, false, 1); f.params = 2
    index := local(&mut f, 1, true, -1); sum := local(&mut f, 2, true, -1)
    var initial: i64 = 0; if mode == 1 { initial = -1 }
    zero := number(&mut f, 1, initial); sum_zero := number(&mut f, 2, 0)
    init_index := node(&mut f, 11, 0, zero, -1, -1, 0, index)
    init_sum := node(&mut f, 11, 0, sum_zero, -1, -1, 0, sum)
    f.nodes.next[init_index] = init_sum
    condition_index := read(&mut f, 1, index); length := node(&mut f, 5, 1, -1, -1, -1, 0, array)
    var compare: i64 = 8; if mode == 7 { compare = 9 }
    condition := binary(&mut f, 3, compare, condition_index, length)
    indexed := read(&mut f, 1, index)
    element := node(&mut f, 6, 2, indexed, -1, -1, 0, array)
    prior_sum := read(&mut f, 2, sum); addition := binary(&mut f, 2, 1, prior_sum, element)
    accumulate := node(&mut f, 12, 0, addition, -1, -1, 0, sum)
    prior_index := read(&mut f, 1, index)
    var stride: i64 = 1; if mode == 3 { stride = 2 }
    one := number(&mut f, 1, stride); increment := binary(&mut f, 1, 1, prior_index, one)
    update := node(&mut f, 12, 0, increment, -1, -1, 0, index)
    f.nodes.next[accumulate] = update
    var first := accumulate
    if mode == 2 || mode == 6 || mode == 8 {
        negative := number(&mut f, 1, -1)
        extra := node(&mut f, 12, 0, negative, -1, -1, 0, index)
        if mode == 8 {
            then_block := block(&mut f, extra); flag_read := read(&mut f, 3, flag)
            branch := node(&mut f, 13, 0, flag_read, then_block, -1, 0, -1)
            first = branch; f.nodes.next[branch] = accumulate
        } else { first = extra; f.nodes.next[extra] = accumulate }
    }
    if mode == 4 {
        skip := node(&mut f, 17, 0, -1, -1, -1, 0, -1)
        first = skip; f.nodes.next[skip] = accumulate
    }
    if mode == 5 {
        flag_read := read(&mut f, 3, flag); nested_body := block(&mut f, -1)
        nested := node(&mut f, 14, 0, flag_read, nested_body, -1, 0, -1)
        first = nested; f.nodes.next[nested] = accumulate
    }
    body := block(&mut f, first); loop := node(&mut f, 14, 0, condition, body, -1, 0, -1)
    f.nodes.next[init_sum] = loop
    returned := read(&mut f, 2, sum); ret := node(&mut f, 15, 0, returned, -1, -1, 0, -1)
    f.nodes.next[loop] = ret; f.root = block(&mut f, init_index); f.ret = 2; f.supported = true
    f
}
@test fn range_proofs_require_dominating_nonnegative_induction_and_exclude_reduction_overflow() {
    for mode in [0, 1, 2, 3, 4, 5, 6, 7, 8] {
        var f := loop_model(mode)
        pass.run(&mut f)
        var bounded := 0; var increments := 0
        for i in 0..f.nodes.kinds.len {
            if f.nodes.proofs[i].bit_and(2) != 0 { bounded = bounded + 1; assert(f.nodes.kinds[i] == 6) }
            if f.nodes.proofs[i].bit_and(1) != 0 { increments = increments + 1; assert(f.nodes.kinds[i] == 3 && f.nodes.types[i] == 1) }
            if f.nodes.kinds[i] == 3 && f.nodes.types[i] == 2 { assert(f.nodes.proofs[i] == 0) }
        }
        assert(!f.budget_exhausted)
        if mode == 0 { assert(bounded == 1 && increments == 1) }
        else { assert(bounded == 0 && increments == 0) }
        // A mutable induction read must not become the preheader's constant.
        loop := f.nodes.next[f.nodes.next[f.nodes.left[f.root]]]
        guard := f.nodes.left[loop]
        assert(f.nodes.kinds[f.nodes.left[guard]] == 2)
    }
}
@test fn branch_heavy_work_stops_at_a_fixed_budget_with_a_valid_partial_model() {
    var f := ir.new()
    flag := local(&mut f, 3, false, 0); f.params = 1
    for i in 0..255 { unused := local(&mut f, 2, true, -1) }
    var first := -1; var last := -1
    for i in 0..100 {
        condition := read(&mut f, 3, flag); yes := block(&mut f, -1); no := block(&mut f, -1)
        branch := node(&mut f, 13, 0, condition, yes, no, 0, -1)
        if first < 0 { first = branch } else { f.nodes.next[last] = branch }; last = branch
    }
    f.root = block(&mut f, first); f.supported = true
    pass.run(&mut f)
    assert(f.supported && f.budget_exhausted && f.visits == 65536)
    for i in 0..f.nodes.kinds.len { assert(f.nodes.proofs[i] == 0) }
}

@test fn parsed_function_proofs_are_general_and_dead_code_is_validated_first() {
    sources: []string = [
        "values {var result:i64=0;var cursor:=0;while cursor<values.len{result=result+values[cursor];cursor=cursor+1};result}",
        "values {var result:i64=0;var cursor:=-1;while cursor<values.len{result=result+values[cursor];cursor=cursor+1};result}",
        "values {var result:i64=0;var cursor:=0;while cursor<values.len{cursor=cursor+1;result=result+values[cursor]};result}",
        "values {var result:i64=0;var cursor:=0;while cursor<=values.len{result=result+values[cursor];cursor=cursor+1};result}",
    ]
    names: []string = ["values"]; types: []i32 = [20]; positions: []i32 = [0]
    for source in 0..sources.len {
        input := lexer.scan(sources[source], false)
        var f := ir.new()
        assert(parse.parse(&mut f, &input, 1, input.kinds.len - 2, &names, &types, &positions, 2))
        pass.run(&mut f)
        var bounds := 0; var increments := 0
        for i in 0..f.nodes.kinds.len {
            if f.nodes.proofs[i].bit_and(2) != 0 { bounds = bounds + 1 }
            if f.nodes.proofs[i].bit_and(1) != 0 { increments = increments + 1 }
        }
        if source == 0 { assert(bounds == 1 && increments == 1) }
        else { assert(bounds == 0 && increments == 0) }
    }
    input := lexer.scan("{if false{value:=1;value=2};42}", false)
    var f := ir.new(); empty_names: []string = []; empty_types: []i32 = []; empty_positions: []i32 = []
    assert(!parse.parse(&mut f, &input, 0, input.kinds.len - 2, &empty_names, &empty_types, &empty_positions, 1))
    pass.run(&mut f)
    assert(!f.supported && f.rewrites == 0)
}

@test fn counted_loop_bound_snapshots_do_not_leak_iteration_or_written_scalar_constants() {
    sources: []string = [
        "{var limit:=2;for cursor in 0..limit{limit=limit+1};limit}",
        "{var limit:=0;while limit<3{for cursor in 0..1{limit=limit+1}};limit}",
        "{var limit:=0;for cursor in 0..4{while limit<5{limit=limit+1}};limit}",
    ]
    names: []string = []; types: []i32 = []; positions: []i32 = []
    for mode in 0..sources.len {
        input := lexer.scan(sources[mode], false); var f := ir.new()
        assert(parse.parse(&mut f, &input, 0, input.kinds.len - 2, &names, &types, &positions, 1))
        assert(verify.validate(&f, false))
        pass.run(&mut f)
        assert(verify.validate(&f, true))
        var returned := -1
        for i in 0..f.nodes.kinds.len {
            if f.nodes.kinds[i] == 15 { returned = f.nodes.left[i] }
            if f.nodes.kinds[i] == 3 && f.nodes.values[i] == 1 { assert(f.nodes.kinds[f.nodes.left[i]] == 2) }
            assert(f.nodes.proofs[i] == 0)
            if mode == 0 && f.nodes.kinds[i] == 19 {
                high := f.nodes.right[i]
                assert(f.nodes.kinds[high] == 1 && f.nodes.values[high] == 2)
            }
        }
        assert(returned >= 0 && f.nodes.kinds[returned] == 2)
    }
}

@test fn element_stores_preserve_checked_memory_reads_and_stale_proofs_are_cleared() {
    source := "values {var limit:=2;for cursor in 0..limit{limit=limit+1;values[cursor]=values[cursor]+1};var cursor:=0;while cursor<values.len{values[cursor]=values[cursor]+1;cursor=cursor+1};values[0]}"
    input := lexer.scan(source, false)
    names: []string = ["values"]; types: []i32 = [21]; positions: []i32 = [0]
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 1, input.kinds.len - 2, &names, &types, &positions, 2))
    assert(verify.validate(&f, false))
    pass.run(&mut f)
    assert(verify.validate(&f, true))
    var stores := 0; var reads := 0
    for i in 0..f.nodes.kinds.len {
        if f.nodes.kinds[i] == 18 { stores = stores + 1; assert(f.nodes.kinds[f.nodes.left[i]] == 2) }
        if f.nodes.kinds[i] == 6 { reads = reads + 1 }
        assert(f.nodes.proofs[i] == 0)
    }
    assert(stores == 2 && reads == 3)

    f = loop_model(0)
    pass.run(&mut f)
    var proof_count := 0
    for i in 0..f.nodes.kinds.len { if f.nodes.proofs[i] != 0 { proof_count = proof_count + 1 } }
    assert(proof_count == 2)
    f.local_types[0] = 21
    pass.run(&mut f)
    for i in 0..f.nodes.kinds.len { assert(f.nodes.proofs[i] == 0) }
}
