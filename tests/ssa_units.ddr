// Comprehensive unit tests for Phase 3B:
// Target-Independent Typed SSA MIR (`selfhost/ssa/ssa_ir.ddr`),
// Semantic SSA Verifier (`selfhost/ssa/ssa_verify.ddr`),
// Post-Drop HL-MIR -> SSA Lowering (`selfhost/ssa/ssa_lower.ddr`),
// and Unified SSA Optimizer & Inliner (`selfhost/ssa/ssa_opt.ddr`).

import ..selfhost.frontend.diagnostics as diag
import ..selfhost.frontend.parser as parser
import ..selfhost.hir.hir_types as ht
import ..selfhost.hir.hir_body as hb
import ..selfhost.hir.hir_lower as hir_lower
import ..selfhost.hir.hir_mono as hir_mono
import ..selfhost.mir2.mir_check as mir_check
import ..selfhost.ssa.ssa_ir as ssa
import ..selfhost.ssa.ssa_verify as ssa_verify
import ..selfhost.ssa.ssa_lower as ssa_lower
import ..selfhost.ssa.ssa_opt as ssa_opt

struct PipelineResult {
    ok: bool,
    hir: hb.HirProgram,
    ssa_prog: ssa.SsaProgram,
    diags: []diag.Diagnostic,
}

fn compile_to_ssa(src: string) -> PipelineResult {
    tree := parser.parse_source("ssa_unit.ddr", src)
    mods: []hb.ModuleInput = [hb.ModuleInput {
        mod_id: 0, path: "ssa_unit.ddr", source: src.clone(), caps_mask: 0, ast: move tree,
    }]
    edges: []hb.ImportEdge = []
    mut prog := hir_lower.lower_modules(&mods, &edges, 0)
    if !prog.ok {
        return PipelineResult {
            ok: false, hir: move prog, ssa_prog: ssa.new_program(0, -1), diags: [],
        }
    }
    hir_mono.monomorphize(&mut prog)
    chk := mir_check.check_program(&prog)
    if !chk.ok {
        return PipelineResult {
            ok: false, hir: move prog, ssa_prog: ssa.new_program(0, -1), diags: move chk.diagnostics,
        }
    }
    mut diags: []diag.Diagnostic = []
    sp := ssa_lower.lower_program(&prog, &chk.bodies, &mut diags)
    v_ok := ssa_verify.verify_program(&prog.types, &sp, &mut diags)
    PipelineResult {
        ok: v_ok && diags.len == 0,
        hir: move prog,
        ssa_prog: move sp,
        diags: move diags,
    }
}

fn find_fn_idx(sp: &ssa.SsaProgram, name: string) -> i32 {
    for i in 0..sp.funcs.len {
        if sp.funcs[i].name == name { return i }
    }
    -1
}

fn count_inst_kind(f: &ssa.SsaFunc, kind: ssa.SsaInstKind) -> i32 {
    mut cnt := 0
    for bb in 0..f.blocks.len {
        is0 := f.blocks[bb].inst_start
        in0 := f.blocks[bb].inst_len
        for i in 0..in0 {
            if f.insts[f.block_insts[is0 + i]].kind == kind { cnt += 1 }
        }
    }
    cnt
}

fn count_term_kind(f: &ssa.SsaFunc, kind: ssa.SsaTermKind) -> i32 {
    mut cnt := 0
    for bb in 0..f.blocks.len {
        tid := f.blocks[bb].term_id
        if tid >= 0 && f.terms[tid].kind == kind { cnt += 1 }
    }
    cnt
}

fn count_block_params(f: &ssa.SsaFunc) -> i32 {
    mut cnt := 0
    for bb in 0..f.blocks.len { cnt += f.blocks[bb].params_len }
    cnt
}

fn count_live_slots(f: &ssa.SsaFunc) -> i32 {
    mut cnt := 0
    for i in 0..f.slots.len {
        if !f.slots[i].dead { cnt += 1 }
    }
    cnt
}

// =========================================================================
// 1. End-to-End AST -> HIR -> HL-MIR -> DropElab -> SSA -> Verify -> Opt -> Verify
// =========================================================================

@test
fn ssa_e2e_real_dunder_programs_lower_verify_and_optimize() {
    src := "struct Pair { a: i32, b: i32 }\n" +
        "impl Pair {\n" +
        "    fn sum(&self) -> i32 { self.a + self.b }\n" +
        "}\n" +
        "fn classify(x: i32) -> i32 {\n" +
        "    mut acc := 0\n" +
        "    if x > 10 {\n" +
        "        acc = x * 2\n" +
        "    } else {\n" +
        "        acc = x + 5\n" +
        "    }\n" +
        "    acc\n" +
        "}\n" +
        "fn sum_slice(xs: &[]i32) -> i32 {\n" +
        "    mut total := 0\n" +
        "    for i in 0..xs.len {\n" +
        "        total += xs[i]\n" +
        "    }\n" +
        "    total\n" +
        "}\n" +
        "fn opt_or_zero(o: Option<i32>) -> i32 {\n" +
        "    match o {\n" +
        "        .Some(v) => v,\n" +
        "        .None => 0,\n" +
        "    }\n" +
        "}\n" +
        "fn main() {\n" +
        "    p := Pair { a: 3, b: 4 }\n" +
        "    s := p.sum()\n" +
        "    c := classify(s)\n" +
        "    arr: []i32 = [1, 2, 3, 4]\n" +
        "    t := sum_slice(&arr)\n" +
        "    o := opt_or_zero(.Some(c + t))\n" +
        "    _ := o\n" +
        "}\n"

    mut res := compile_to_ssa(src)
    assert(res.ok)
    assert(res.ssa_prog.funcs.len >= 5)

    mut opt_diags: []diag.Diagnostic = []
    assert(ssa_opt.optimize_program(&res.hir.types, &mut res.ssa_prog, true, &mut opt_diags))
    assert(opt_diags.len == 0)
    assert(ssa_verify.verify_program(&res.hir.types, &res.ssa_prog, &mut opt_diags))
}

@test
fn ssa_e2e_task_scope_and_region_balanced() {
    src := "fn main() {\n" +
        "    task scope s(1) {\n" +
        "        x := 1 + 2\n" +
        "        _ := x\n" +
        "    }\n" +
        "    region r(256) {\n" +
        "        buf := r.alloc(4)\n" +
        "        _ := buf.len\n" +
        "    }\n" +
        "}\n"

    mut res := compile_to_ssa(src)
    assert(res.ok)
    mi := find_fn_idx(&res.ssa_prog, "main")
    assert(mi >= 0)
    assert(count_term_kind(&res.ssa_prog.funcs[mi], .TaskScopeEnter) == 1)
    assert(count_term_kind(&res.ssa_prog.funcs[mi], .TaskScopeJoin) == 1)
    assert(count_term_kind(&res.ssa_prog.funcs[mi], .RegionEnter) == 1)
    assert(count_term_kind(&res.ssa_prog.funcs[mi], .RegionExit) == 1)

    mut opt_diags: []diag.Diagnostic = []
    assert(ssa_opt.optimize_program(&res.hir.types, &mut res.ssa_prog, true, &mut opt_diags))
    assert(opt_diags.len == 0)
}

// =========================================================================
// 2. ssa_verify Negative Tests (Dominance, TypeId, Block-Param Arity,
//    StackSlot Bounds, Unbalanced TaskScope / Region)
// =========================================================================

@test
fn ssa_verify_catches_bad_dominance() {
    mut types := ht.new_table(0)
    ht.seal(&mut types)

    // bb0 branches to bb1 (defines v1) and bb2 (uses v1 -> NOT dominated by bb1!)
    mut f := ssa.new_func(0, 0, "bad_dom", "test.ddr", -1, ht.TY_I32, 1, false)
    cond := ssa.add_fn_param_val(&mut f, ht.TY_BOOL)
    bb0 := ssa.add_block(&mut f)
    bb1 := ssa.add_block(&mut f)
    bb2 := ssa.add_block(&mut f)
    empty: []i32 = []
    _ := ssa.set_branch(&mut f, bb0, cond, bb1, &empty, bb2, &empty, 1, 2)
    v1 := ssa.emit_const_int(&mut f, bb1, ht.TY_I32, 7, 1, 2)
    _ := ssa.set_return(&mut f, bb1, v1, 1, 2)
    // Illegal cross-branch use of v1 in bb2!
    v2 := ssa.emit_copy(&mut f, bb2, ht.TY_I32, v1, 1, 2)
    _ := ssa.set_return(&mut f, bb2, v2, 1, 2)
    ssa.compute_preds(&mut f)

    mut diags: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f, &mut diags))
    assert(diags.len > 0)
}

@test
fn ssa_verify_catches_type_mismatch_and_slot_bounds() {
    mut types := ht.new_table(0)
    ht.seal(&mut types)

    // 2a: Binary operand type mismatch (i32 + i64)
    mut f1 := ssa.new_func(0, 0, "bad_ty", "test.ddr", -1, ht.TY_I32, 0, false)
    bb0 := ssa.add_block(&mut f1)
    a := ssa.emit_const_int(&mut f1, bb0, ht.TY_I32, 1, 1, 2)
    b := ssa.emit_const_int(&mut f1, bb0, ht.TY_I64, 2, 1, 2)
    c := ssa.emit_binary(&mut f1, bb0, ht.TY_I32, hb.BINOP_ADD, a, b, 1, 2)
    _ := ssa.set_return(&mut f1, bb0, c, 1, 2)
    ssa.compute_preds(&mut f1)
    mut d1: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f1, &mut d1))
    assert(d1.len > 0)

    // 2b: StackSlot bounds violation (8-byte Load from a 4-byte i32 slot!)
    mut f2 := ssa.new_func(1, 0, "bad_slot_oob", "test.ddr", -1, ht.TY_I64, 0, false)
    sl := ssa.add_slot(&mut f2, ht.TY_I32, 4, 4, false, false, false, "x")
    b0 := ssa.add_block(&mut f2)
    addr := ssa.emit_slot_addr(&mut f2, b0, ht.TY_PTR, sl, 0, 1, 2)
    oob := ssa.emit_load(&mut f2, b0, ht.TY_I64, addr, 0, sl, 1, 2)
    _ := ssa.set_return(&mut f2, b0, oob, 1, 2)
    ssa.compute_preds(&mut f2)
    mut d2: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f2, &mut d2))
    assert(d2.len > 0)
}

@test
fn ssa_verify_catches_block_param_arity_and_type_mismatch() {
    mut types := ht.new_table(0)
    ht.seal(&mut types)

    // 3a: Edge arity mismatch (bb1 expects 1 param, Goto passes 0 args)
    mut f1 := ssa.new_func(0, 0, "bad_arity", "test.ddr", -1, ht.TY_I32, 0, false)
    bb0 := ssa.add_block(&mut f1)
    bb1 := ssa.add_block(&mut f1)
    p := ssa.add_block_param(&mut f1, bb1, ht.TY_I32)
    empty: []i32 = []
    _ := ssa.set_goto(&mut f1, bb0, bb1, &empty, 1, 2)
    _ := ssa.set_return(&mut f1, bb1, p, 1, 2)
    ssa.compute_preds(&mut f1)
    mut d1: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f1, &mut d1))

    // 3b: Edge TypeId mismatch (bb1 expects i32, Goto passes bool)
    mut f2 := ssa.new_func(1, 0, "bad_edge_ty", "test.ddr", -1, ht.TY_I32, 0, false)
    b0 := ssa.add_block(&mut f2)
    b1 := ssa.add_block(&mut f2)
    p2 := ssa.add_block_param(&mut f2, b1, ht.TY_I32)
    bv := ssa.emit_const_int(&mut f2, b0, ht.TY_BOOL, 1, 1, 2)
    args: []i32 = [bv]
    _ := ssa.set_goto(&mut f2, b0, b1, &args, 1, 2)
    _ := ssa.set_return(&mut f2, b1, p2, 1, 2)
    ssa.compute_preds(&mut f2)
    mut d2: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f2, &mut d2))
}

@test
fn ssa_verify_catches_unbalanced_task_scope_and_region() {
    mut types := ht.new_table(0)
    ht.seal(&mut types)

    // Unbalanced TaskScopeEnter without TaskScopeJoin before Return
    mut f1 := ssa.new_func(0, 0, "bad_ts", "test.ddr", -1, ht.TY_UNIT, 0, false)
    bb0 := ssa.add_block(&mut f1)
    bb1 := ssa.add_block(&mut f1)
    mut tm := ssa.make_term(.TaskScopeEnter)
    tm.callee = 0
    tm.target_a = bb1
    _ := ssa.set_term(&mut f1, bb0, tm)
    _ := ssa.set_return(&mut f1, bb1, -1, 1, 2)
    ssa.compute_preds(&mut f1)
    mut d1: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f1, &mut d1))

    // Unmatched RegionExit (depth < 0)
    mut f2 := ssa.new_func(1, 0, "bad_reg", "test.ddr", -1, ht.TY_UNIT, 0, false)
    r0 := ssa.add_block(&mut f2)
    r1 := ssa.add_block(&mut f2)
    mut rtm := ssa.make_term(.RegionExit)
    rtm.callee = 0
    rtm.target_a = r1
    _ := ssa.set_term(&mut f2, r0, rtm)
    _ := ssa.set_return(&mut f2, r1, -1, 1, 2)
    ssa.compute_preds(&mut f2)
    mut d2: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f2, &mut d2))
}

// =========================================================================
// 3. Pass 1 — Mem2Reg: Promotes Scalar & FatStr Locals Across Branches & Loops
// =========================================================================

@test
fn ssa_opt_mem2reg_promotes_branches_loops_and_fat_views() {
    src := "fn branch_and_loop(cond: bool, n: i32) -> i32 {\n" +
        "    mut acc := 0\n" +
        "    if cond {\n" +
        "        acc = 10\n" +
        "    } else {\n" +
        "        acc = 20\n" +
        "    }\n" +
        "    mut i := 0\n" +
        "    while i < n {\n" +
        "        acc += i\n" +
        "        i += 1\n" +
        "    }\n" +
        "    acc\n" +
        "}\n" +
        "fn pick_str(cond: bool, a: &str, b: &str) -> &str from (a, b) {\n" +
        "    mut s := a\n" +
        "    if cond { s = b }\n" +
        "    s\n" +
        "}\n" +
        "fn main() {}\n"

    mut res := compile_to_ssa(src)
    assert(res.ok)

    bi := find_fn_idx(&res.ssa_prog, "branch_and_loop")
    pi := find_fn_idx(&res.ssa_prog, "pick_str")
    assert(bi >= 0 && pi >= 0)

    // Before Mem2Reg: stack loads/stores exist, zero block params
    assert(count_inst_kind(&res.ssa_prog.funcs[bi], .Load) > 0)
    assert(count_inst_kind(&res.ssa_prog.funcs[bi], .Store) > 0)
    assert(count_block_params(&res.ssa_prog.funcs[bi]) == 0)

    // Run Mem2Reg on branch_and_loop
    mut d: []diag.Diagnostic = []
    assert(ssa_opt.pass_mem2reg(&res.hir.types, &mut res.ssa_prog.funcs[bi]))
    assert(ssa_verify.verify_func(&res.hir.types, &res.ssa_prog.funcs[bi], &mut d))
    assert(d.len == 0)
    // All scalar locals promoted: zero Loads, zero Stores, block params inserted for branch join & loop header!
    assert(count_inst_kind(&res.ssa_prog.funcs[bi], .Load) == 0)
    assert(count_inst_kind(&res.ssa_prog.funcs[bi], .Store) == 0)
    assert(count_block_params(&res.ssa_prog.funcs[bi]) >= 3)
    assert(count_live_slots(&res.ssa_prog.funcs[bi]) == 0)

    // Run Mem2Reg on pick_str (2-word FatStr promoted to pure SSA + block param!)
    assert(ssa_opt.pass_mem2reg(&res.hir.types, &mut res.ssa_prog.funcs[pi]))
    assert(ssa_verify.verify_func(&res.hir.types, &res.ssa_prog.funcs[pi], &mut d))
    assert(count_inst_kind(&res.ssa_prog.funcs[pi], .Load) == 0)
    assert(count_inst_kind(&res.ssa_prog.funcs[pi], .Store) == 0)
    assert(count_block_params(&res.ssa_prog.funcs[pi]) >= 1)
}

// =========================================================================
// 4. Pass 2 — Unified SSA Inliner (Structs, Methods, Option Helpers)
// =========================================================================

@test
fn ssa_opt_inliner_inlines_struct_method_and_option_helpers() {
    src := "struct Vec2 { x: i32, y: i32 }\n" +
        "impl Vec2 {\n" +
        "    fn dot_self(&self) -> i32 { self.x * self.x + self.y * self.y }\n" +
        "}\n" +
        "fn add_one(v: i32) -> i32 { v + 1 }\n" +
        "fn unwrap_or_default_i32(opt: Option<i32>) -> i32 {\n" +
        "    match opt {\n" +
        "        .Some(v) => return v,\n" +
        "        .None => return 0,\n" +
        "    }\n" +
        "}\n" +
        "fn compute(a: i32, b: i32) -> i32 {\n" +
        "    v := Vec2 { x: add_one(a), y: add_one(b) }\n" +
        "    d := v.dot_self()\n" +
        "    unwrap_or_default_i32(.Some(d))\n" +
        "}\n" +
        "fn main() { _ := compute(2, 3) }\n"

    mut res := compile_to_ssa(src)
    assert(res.ok)
    ci := find_fn_idx(&res.ssa_prog, "compute")
    assert(ci >= 0)
    // Before optimization: `compute` has 4 direct Calls (2x add_one, dot_self, unwrap_or_default_i32)
    calls_before := count_term_kind(&res.ssa_prog.funcs[ci], .Call)
    assert(calls_before >= 4)

    mut diags: []diag.Diagnostic = []
    assert(ssa_opt.optimize_program(&res.hir.types, &mut res.ssa_prog, true, &mut diags))
    assert(diags.len == 0)

    // After unified SSA inlining: ALL 4 helper/method/Option calls inlined (0 Call terminators remaining)!
    calls_after := count_term_kind(&res.ssa_prog.funcs[ci], .Call)
    assert(calls_after == 0)
}

// =========================================================================
// 5. Pass 3 — GVN, Constant Folding & Copy Propagation
// =========================================================================

@test
fn ssa_opt_gvn_const_fold_and_copy_prop() {
    mut types := ht.new_table(0)
    fstr := ht.add_fat_str(&mut types)
    ht.seal(&mut types)

    // Build function with:
    // - constant arithmetic (10 + 20) * 2 -> folds to 60
    // - redundant Copy chains
    // - duplicate pure expression (x + 1) computed twice -> GVN deduplicates to 1 Binary!
    // - FatLen(FatMake(p, n)) -> folds directly to n!
    mut f := ssa.new_func(0, 0, "gvn_test", "test.ddr", -1, ht.TY_I64, 2, false)
    x := ssa.add_fn_param_val(&mut f, ht.TY_I64)
    p := ssa.add_fn_param_val(&mut f, ht.TY_PTR)
    bb0 := ssa.add_block(&mut f)

    c10 := ssa.emit_const_int(&mut f, bb0, ht.TY_I64, 10, 1, 2)
    c20 := ssa.emit_const_int(&mut f, bb0, ht.TY_I64, 20, 1, 2)
    c2 := ssa.emit_const_int(&mut f, bb0, ht.TY_I64, 2, 1, 2)
    sum30 := ssa.emit_binary(&mut f, bb0, ht.TY_I64, hb.BINOP_ADD, c10, c20, 1, 2)
    prod60 := ssa.emit_binary(&mut f, bb0, ht.TY_I64, hb.BINOP_MUL, sum30, c2, 1, 2)

    c1 := ssa.emit_const_int(&mut f, bb0, ht.TY_I64, 1, 1, 2)
    dup_a := ssa.emit_binary(&mut f, bb0, ht.TY_I64, hb.BINOP_ADD, x, c1, 1, 2)
    dup_a_copy := ssa.emit_copy(&mut f, bb0, ht.TY_I64, dup_a, 1, 2)
    dup_b := ssa.emit_binary(&mut f, bb0, ht.TY_I64, hb.BINOP_ADD, c1, x, 1, 2) // commutative duplicate!

    fm := ssa.emit_inst(&mut f, bb0, ssa.make_inst(.FatMake, fstr, p, prod60, -1, 0, ht.TY_U8, 0, -1, 0, 0, 1, 2))
    fl := ssa.emit_inst(&mut f, bb0, ssa.make_inst(.FatLen, ht.TY_I64, fm, -1, -1, 0, fstr, 0, -1, 0, 0, 1, 2))

    t1 := ssa.emit_binary(&mut f, bb0, ht.TY_I64, hb.BINOP_ADD, dup_a_copy, dup_b, 1, 2)
    t2 := ssa.emit_binary(&mut f, bb0, ht.TY_I64, hb.BINOP_ADD, t1, fl, 1, 2)
    _ := ssa.set_return(&mut f, bb0, t2, 1, 2)
    ssa.compute_preds(&mut f)

    mut diags: []diag.Diagnostic = []
    assert(ssa_opt.optimize_func(&types, &mut f, true, &mut diags))
    assert(diags.len == 0)

    // Zero Copy, zero FatMake, zero FatLen left!
    assert(count_inst_kind(&f, .Copy) == 0)
    assert(count_inst_kind(&f, .FatMake) == 0)
    assert(count_inst_kind(&f, .FatLen) == 0)
    // Only 3 Binary ops remain: (x + 1), (dup + dup), (t1 + 60) — constant 10+20, *2 folded and commutative duplicate eliminated!
    assert(count_inst_kind(&f, .Binary) == 3)
}

// =========================================================================
// 6. Pass 4 — Bounds & Overflow Check Elision on `for i in 0..arr.len`
// =========================================================================

@test
fn ssa_opt_bounds_and_overflow_check_elision_on_for_range() {
    src := "fn sum_all(arr: &[]i32) -> i32 {\n" +
        "    mut total := 0\n" +
        "    for i in 0..arr.len {\n" +
        "        total += arr[i]\n" +
        "    }\n" +
        "    total\n" +
        "}\n" +
        "fn unchecked_get(arr: &[]i32, k: i32) -> i32 {\n" +
        "    arr[k]\n" +
        "}\n" +
        "fn main() {}\n"

    mut res := compile_to_ssa(src)
    assert(res.ok)
    si := find_fn_idx(&res.ssa_prog, "sum_all")
    ui := find_fn_idx(&res.ssa_prog, "unchecked_get")
    assert(si >= 0 && ui >= 0)

    // Before optimization: `sum_all` has BoundsCheck (for arr[i]) and OverflowCheck (for i + 1 and total + arr[i])
    bc_before := count_inst_kind(&res.ssa_prog.funcs[si], .BoundsCheck)
    oc_before := count_inst_kind(&res.ssa_prog.funcs[si], .OverflowCheck)
    assert(bc_before >= 1)
    assert(oc_before >= 2)

    mut diags: []diag.Diagnostic = []
    assert(ssa_opt.optimize_program(&res.hir.types, &mut res.ssa_prog, true, &mut diags))
    assert(diags.len == 0)

    // After optimization:
    // 1. BoundsCheck on `arr[i]` in `for i in 0..arr.len` is COMPLETELY ELIDED (0 remaining)!
    assert(count_inst_kind(&res.ssa_prog.funcs[si], .BoundsCheck) == 0)
    // 2. OverflowCheck on induction step `i + 1` is ELIDED (only `total += arr[i]` remains -> fewer than before)!
    assert(count_inst_kind(&res.ssa_prog.funcs[si], .OverflowCheck) < oc_before)
    // 3. Unconstrained `arr[k]` MUST retain its BoundsCheck (soundness)!
    assert(count_inst_kind(&res.ssa_prog.funcs[ui], .BoundsCheck) == 1)
}

// =========================================================================
// 7. Pass 5 — CFG Simplification & DCE (Constant Branch/Switch, Unreachable, Dead Pure Ops)
// =========================================================================

@test
fn ssa_opt_cfg_simplify_and_dce() {
    mut types := ht.new_table(0)
    ht.seal(&mut types)

    // Build CFG with constant Branch(true), unreachable dead branch, dead pure computations,
    // and an unused StackSlot!
    mut f := ssa.new_func(0, 0, "cfg_dce", "test.ddr", -1, ht.TY_I32, 1, false)
    p := ssa.add_fn_param_val(&mut f, ht.TY_I32)
    _ := ssa.add_slot(&mut f, ht.TY_I32, 4, 4, false, false, false, "unused_slot")
    bb0 := ssa.add_block(&mut f)
    bb_then := ssa.add_block(&mut f)
    bb_else := ssa.add_block(&mut f)
    bb_join := ssa.add_block(&mut f)
    jparam := ssa.add_block_param(&mut f, bb_join, ht.TY_I32)

    // Dead pure computation in bb0
    c99 := ssa.emit_const_int(&mut f, bb0, ht.TY_I32, 99, 1, 2)
    _ := ssa.emit_binary(&mut f, bb0, ht.TY_I32, hb.BINOP_MUL, p, c99, 1, 2)

    cond := ssa.emit_const_int(&mut f, bb0, ht.TY_BOOL, 1, 1, 2)
    empty: []i32 = []
    _ := ssa.set_branch(&mut f, bb0, cond, bb_then, &empty, bb_else, &empty, 1, 2)

    v_then := ssa.emit_const_int(&mut f, bb_then, ht.TY_I32, 42, 1, 2)
    t_args: []i32 = [v_then]
    _ := ssa.set_goto(&mut f, bb_then, bb_join, &t_args, 1, 2)

    v_else := ssa.emit_const_int(&mut f, bb_else, ht.TY_I32, 13, 1, 2)
    e_args: []i32 = [v_else]
    _ := ssa.set_goto(&mut f, bb_else, bb_join, &e_args, 1, 2)

    _ := ssa.set_return(&mut f, bb_join, jparam, 1, 2)
    ssa.compute_preds(&mut f)

    mut diags: []diag.Diagnostic = []
    assert(ssa_opt.optimize_func(&types, &mut f, true, &mut diags))
    assert(diags.len == 0)

    // Constant branch folded -> unreachable bb_else removed -> bb0 + bb_then + bb_join merged into 1 single block!
    assert(f.blocks.len == 1)
    // Dead multiplication eliminated -> zero Binary ops remain, only ConstInt(42) and Return!
    assert(count_inst_kind(&f, .Binary) == 0)
    assert(count_inst_kind(&f, .ConstInt) == 1)
    // Unused StackSlot marked dead!
    assert(count_live_slots(&f) == 0)
}

// =========================================================================
// 8. Additional Coverage: addr_taken Soundness, Call Signature Verification,
//    Generics / Result / FatStr Inlining & Post-Drop INTRINSIC_DROP
// =========================================================================

@test
fn ssa_verify_catches_call_sig_mismatch() {
    mut types := ht.new_table(0)
    p: []ht.ParamEntry = [ht.ParamEntry { ty: ht.TY_I32, mode: .CopyVal }]
    nf: []ht.FromEdge = []
    sig := ht.add_fn_ptr(&mut types, &p, ht.TY_I64, &nf)
    ht.seal(&mut types)

    // Call passes TY_BOOL to a TY_I32 param -> MUST fail ssa_verify!
    mut f := ssa.new_func(0, 0, "bad_call_sig", "test.ddr", -1, ht.TY_I64, 0, false)
    bb0 := ssa.add_block(&mut f)
    bb1 := ssa.add_block(&mut f)
    bad_arg := ssa.emit_const_int(&mut f, bb0, ht.TY_BOOL, 1, 1, 2)
    args: []i32 = [bad_arg]
    a_start := ssa.push_val_args(&mut f, &args)
    dval := ssa.add_val(&mut f, ht.TY_I64, bb0, ssa.DEF_TERM_RESULT)
    mut tm := ssa.make_term(.Call)
    tm.callee = 1
    tm.sig_ty = sig
    tm.arg_start = a_start
    tm.arg_len = 1
    tm.dest_val = dval
    tm.target_a = bb1
    _ := ssa.set_term(&mut f, bb0, tm)
    _ := ssa.set_return(&mut f, bb1, dval, 1, 2)
    ssa.compute_preds(&mut f)

    mut diags: []diag.Diagnostic = []
    assert(!ssa_verify.verify_func(&types, &f, &mut diags))
    assert(diags.len > 0)
}

@test
fn ssa_opt_preserves_addr_taken_and_inlines_generics_result_fatstr_drop() {
    src := "fn bump(x: &mut i32) { x = x + 1 }\n" +
        "fn use_addr_taken() -> i32 {\n" +
        "    mut v := 10\n" +
        "    bump(&mut v)\n" +
        "    v\n" +
        "}\n" +
        "fn id_val<T>(x: T) -> T { x }\n" +
        "fn str_len_helper(s: &str) -> i32 { s.len }\n" +
        "fn check_res(r: Result<i32, i32>) -> i32 {\n" +
        "    match r {\n" +
        "        .Ok(v) => v,\n" +
        "        .Err(e) => e,\n" +
        "    }\n" +
        "}\n" +
        "fn owned_drop_test(flag: bool) -> i32 {\n" +
        "    s := \"hello\"\n" +
        "    n := str_len_helper(s.as_str())\n" +
        "    k := id_val(n)\n" +
        "    if flag { return check_res(.Ok(k)) }\n" +
        "    check_res(.Err(0))\n" +
        "}\n" +
        "fn main() {\n" +
        "    _ := use_addr_taken()\n" +
        "    _ := owned_drop_test(true)\n" +
        "}\n"

    mut res := compile_to_ssa(src)
    assert(res.ok)
    ui := find_fn_idx(&res.ssa_prog, "use_addr_taken")
    oi := find_fn_idx(&res.ssa_prog, "owned_drop_test")
    assert(ui >= 0 && oi >= 0)

    // Before optimization: `owned_drop_test` has post-drop INTRINSIC_DROP for owned `string` `s`!
    assert(count_term_kind(&res.ssa_prog.funcs[oi], .IntrinsicCall) >= 1)

    // Verify `use_addr_taken` slot for `v` is marked addr_taken so Mem2Reg preserves it safely
    mut saw_at := false
    for s in 0..res.ssa_prog.funcs[ui].slots.len {
        if res.ssa_prog.funcs[ui].slots[s].addr_taken { saw_at = true }
    }
    assert(saw_at)

    mut diags: []diag.Diagnostic = []
    assert(ssa_opt.optimize_program(&res.hir.types, &mut res.ssa_prog, true, &mut diags))
    assert(diags.len == 0)
    // Helper calls (`str_len_helper`, `id_val`, `check_res`) inlined into `owned_drop_test`!
    assert(count_term_kind(&res.ssa_prog.funcs[oi], .Call) == 0)
    // `use_addr_taken` still preserves its addr_taken slot (verified by ssa_verify after every pass!)
    assert(count_live_slots(&res.ssa_prog.funcs[ui]) >= 1)
}
