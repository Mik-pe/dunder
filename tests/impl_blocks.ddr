import .support.impl_counter as counter
import .support.impl_counter_methods as _

impl Point {
    pub fn new(x: i32, y: i32) -> Self {
        Self { x: x, y: y }
    }

    pub fn get_x(self: &Self) -> i32 {
        self.x
    }
}

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    pub fn translate(&mut self, dx: i32, dy: i32) {
        self.x = self.x + dx
        self.y = self.y + dy
    }

    pub fn shifted(self: Self, dx: i32, dy: i32) -> Self {
        if (Self { x: 0, y: 0 }).x == 0 {
            return Self { x: self.x + dx, y: self.y + dy }
        }
        Self { x: 0, y: 0 }
    }

    pub fn sum(&self) -> i32 {
        mut acc := 0
        xs: []i32 = [self.x, self.y]
        for v in &xs {
            acc = acc + v
        }
        acc
    }

    pub fn len(&self) -> i32 { 2 }
}

@c_layout
struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    pub fn new(x: f64, y: f64) -> Self {
        Self { x: x, y: y }
    }

    pub fn scale(&mut self, factor: f64) {
        self.x = self.x * factor
        self.y = self.y * factor
    }

    pub fn dot(&self, other: &Self) -> f64 {
        self.x * other.x + self.y * other.y
    }
}

@resource
struct Token {
    id: i32,
    label: string,
}

impl Token {
    pub fn acquire(id: i32, move label: string) -> Self {
        Self { id: id, label: label }
    }

    pub fn id(&self) -> i32 { self.id }

    pub fn retag(&mut self, move label: string) {
        self.label = label
    }

    pub fn release(move self) -> i32 {
        self.id + i32(self.label.len)
    }

    pub fn consume_mut(move mut self, extra: i32) -> i32 {
        self.id = self.id + extra
        self.id
    }
}

struct Outer {
    inner: Token,
    scale: i32,
}

impl Outer {
    pub fn unwrap_id(self) -> i32 {
        scale := self.scale
        self.inner.release() + scale
    }
}

struct CbBox {
    cb: fn(i32) -> i32,
    bias: i32,
}

impl CbBox {
    pub fn val(&self) -> i32 { self.bias }
}

enum Choice {
    Empty = 0,
    Count(i32) = 1,
}

impl Choice {
    pub fn get_or(&self, fallback: i32) -> i32 {
        match self {
            Self.Empty => fallback,
            Self.Count(v) => v,
        }
    }

    pub fn add_or_init(&mut self, delta: i32) {
        next := self.get_or(0) + delta
        self = Self.Count(next)
    }
}

fn double_it(x: i32) -> i32 { x * 2 }

fn task_worker(input: i32) -> i32 {
    mut p := Point::new(input, 3)
    p.translate(2, 4)
    p.sum()
}

@test
fn impl_multiple_blocks_and_receivers() {
    mut p := Point::new(10, 20)
    assert(p.get_x() == 10)
    assert(p.len() == 2)
    p.translate(5, -3)
    assert(p.sum() == 32)
    moved := p.shifted(1, 1)
    assert(moved.sum() == 34)
    assert(p.get_x() == 15)
    assert(Point::new(1, 2).shifted(3, 4).sum() == 10)
}

@test
fn impl_cross_module_opaque_and_enum() {
    assert(counter.value() == 999)
    assert(counter.inc(1) == 101)
    mut c := counter.Counter::new(5)
    assert(c.value() == 5)
    c.inc()
    c.add(4)
    assert(c.value() == 10)

    mut other := counter.Counter::with_tag(7, "tag")
    assert(other.label() == "tag")
    c.merge(&other)
    assert(c.value() == 17)
    c.merge_mut(&mut other)
    assert(c.value() == 24)
    assert(other.value() == 0)

    assert(c.bump_and_finish(6) == 30)
    assert(other.into_parts() == 3)

    m0 := counter.Mode::from_code(0)
    m1 := counter.Mode::from_code(42)
    assert(m0.speed() == 1)
    assert(m1.speed() == 42)
}

@test fn inherent_methods_from_a_sibling_module() {
    mut c := counter.Counter::new(4)
    c.twice()
    assert(c.value() == 8)
    assert(counter.Mode::faster(5).speed() == 6)
    box := counter.Box<i32>::wrap(7)
    assert(box.refill(19).value == 19)
}

@test
fn impl_ufcs_and_function_values() {
    ctor := Point::new
    p := ctor(4, 6)
    assert(Point::len(&p) == 2)
    getter := Point::get_x
    assert(getter(&p) == 4)

    mut c := counter.Counter::new(10)
    inc_fn := counter.Counter::inc
    inc_fn(&mut c)
    assert(counter.Counter::value(&c) == 11)
}

@test
fn impl_resources_and_nested_moves() {
    mut tok := Token::acquire(10, "hi")
    assert(tok.id() == 10)
    tok.retag("abc")
    assert(tok.release() == 13)

    tok2 := Token::acquire(20, "z")
    assert((move tok2).consume_mut(5) == 25)

    o := Outer { inner: Token::acquire(30, "xy"), scale: 100 }
    assert(o.inner.release() == 32)

    o2 := Outer { inner: Token::acquire(7, "k"), scale: 3 }
    assert(o2.unwrap_id() == 11)
}

enum KindTag {
    Alpha = 0,
    Beta = 1,
}

impl KindTag {
    pub fn label(&self) -> i32 {
        match self {
            Self.Alpha => 10,
            Self.Beta => 20,
        }
    }
}

struct PairOuter {
    left: Choice,
    right: Choice,
    vec: Vec2,
}

impl PairOuter {
    pub fn compute(&mut self, delta: i32) -> f64 {
        self.left.add_or_init(delta)
        self.vec.scale(2.0)
        self.vec.x + self.vec.y
    }
}

@test
fn impl_arrays_structs_enums_and_c_layout() {
    mut vec := Vec2::new(1.0, 2.0)
    other_vec := Vec2::new(3.0, 4.0)
    vec.scale(2.0)
    assert(vec.dot(&other_vec) == 22.0)

    mut tags: []KindTag = [KindTag.Alpha, KindTag.Beta]
    assert(tags[0].label() == 10)
    assert(tags[1].label() == 20)

    mut c0 := Choice.Empty
    mut c1 := Choice.Count(10)
    assert(c0.get_or(-1) == -1)
    c0.add_or_init(8)
    assert(c0.get_or(-1) == 8)
    c1.add_or_init(5)
    assert(c1.get_or(-1) == 15)

    mut pair := PairOuter { left: Choice.Empty, right: Choice.Count(3), vec: Vec2::new(1.5, 2.5) }
    assert(pair.compute(4) == 8.0)
    assert(pair.left.get_or(0) == 4)
    assert(pair.right.get_or(0) == 3)
}

@test
fn impl_callable_field_preserved() {
    b := CbBox { cb: double_it, bias: 9 }
    assert(b.cb(6) == 12)
    assert(b.val() == 9)
}

@test
fn impl_in_task_scope() {
    mut total := 0
    task scope cap(2) {
        t1 := spawn cap task_worker(10)
        t2 := spawn cap task_worker(20)
        total = await cap(t1) + await cap(t2)
    }
    assert(total == 48)
}

@test
fn impl_in_region() {
    region nodes(128) {
        mut a: []Point = nodes.alloc(3)
        a[0] = Point::new(5, 7)
        a[1] = Point::new(1, 2)
        assert(a[0].get_x() == 5)
        a[0].translate(10, 20)
        assert(a[0].sum() == 42)
        assert(a[1].sum() == 3)
    }
}
