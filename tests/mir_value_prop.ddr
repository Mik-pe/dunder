import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_value_prop as values

fn add(code: &mut arm.Code, dst: i32, a: i32, b: i32, w: bool) {
    var base: i64 = 2332033024; if w { base = 184549376 }
    arm.emit(&mut code, base + i64(b) * 65536 + i64(a) * 32 + i64(dst))
}
fn model(code: &arm.Code) -> mir.Function {
    sites: []i32 = []; var f := mir.new(); assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut f)); f
}
fn same(a: &mir.Function, b: &mir.Function) {
    assert(a.valid == b.valid)
    assert(a.verified == b.verified)
    assert(a.optimizable == b.optimizable)
    assert(a.unknown_control == b.unknown_control)
    assert(a.platform == b.platform)
    assert(a.first_word == b.first_word)
    assert(a.first_label == b.first_label)
    assert(a.first_reloc == b.first_reloc)
    assert(a.first_import == b.first_import)
    assert(a.source_words == b.source_words)
    assert(a.source_labels == b.source_labels)
    assert(a.source_relocs == b.source_relocs)
    assert(a.source_imports == b.source_imports)
    assert(a.kinds.len == b.kinds.len); for i in 0..a.kinds.len { assert(a.kinds[i] == b.kinds[i]) }
    assert(a.opcodes.len == b.opcodes.len); for i in 0..a.opcodes.len { assert(a.opcodes[i] == b.opcodes[i]) }
    assert(a.dst.len == b.dst.len); for i in 0..a.dst.len { assert(a.dst[i] == b.dst[i]) }
    assert(a.a.len == b.a.len); for i in 0..a.a.len { assert(a.a[i] == b.a[i]) }
    assert(a.b.len == b.b.len); for i in 0..a.b.len { assert(a.b[i] == b.b[i]) }
    assert(a.c.len == b.c.len); for i in 0..a.c.len { assert(a.c[i] == b.c[i]) }
    assert(a.imm.len == b.imm.len); for i in 0..a.imm.len { assert(a.imm[i] == b.imm[i]) }
    assert(a.aux.len == b.aux.len); for i in 0..a.aux.len { assert(a.aux[i] == b.aux[i]) }
    assert(a.variant.len == b.variant.len); for i in 0..a.variant.len { assert(a.variant[i] == b.variant[i]) }
    assert(a.types.len == b.types.len); for i in 0..a.types.len { assert(a.types[i] == b.types[i]) }
    assert(a.place.len == b.place.len); for i in 0..a.place.len { assert(a.place[i] == b.place[i]) }
    assert(a.extensions.len == b.extensions.len); for i in 0..a.extensions.len { assert(a.extensions[i] == b.extensions[i]) }
    assert(a.effects.len == b.effects.len); for i in 0..a.effects.len { assert(a.effects[i] == b.effects[i]) }
    assert(a.flags.len == b.flags.len); for i in 0..a.flags.len { assert(a.flags[i] == b.flags[i]) }
    assert(a.abi.len == b.abi.len); for i in 0..a.abi.len { assert(a.abi[i] == b.abi[i]) }
    assert(a.reads.len == b.reads.len); for i in 0..a.reads.len { assert(a.reads[i] == b.reads[i]) }
    assert(a.writes.len == b.writes.len); for i in 0..a.writes.len { assert(a.writes[i] == b.writes[i]) }
    assert(a.clobbers.len == b.clobbers.len); for i in 0..a.clobbers.len { assert(a.clobbers[i] == b.clobbers[i]) }
    assert(a.origins.len == b.origins.len); for i in 0..a.origins.len { assert(a.origins[i] == b.origins[i]) }
    assert(a.raw_starts.len == b.raw_starts.len); for i in 0..a.raw_starts.len { assert(a.raw_starts[i] == b.raw_starts[i]) }
    assert(a.widths.len == b.widths.len); for i in 0..a.widths.len { assert(a.widths[i] == b.widths[i]) }
    assert(a.modes.len == b.modes.len); for i in 0..a.modes.len { assert(a.modes[i] == b.modes[i]) }
    assert(a.recipes.len == b.recipes.len); for i in 0..a.recipes.len { assert(a.recipes[i] == b.recipes[i]) }
    assert(a.stack_roles.len == b.stack_roles.len); for i in 0..a.stack_roles.len { assert(a.stack_roles[i] == b.stack_roles[i]) }
    assert(a.targets.len == b.targets.len); for i in 0..a.targets.len { assert(a.targets[i] == b.targets[i]) }
    assert(a.reloc_kinds.len == b.reloc_kinds.len); for i in 0..a.reloc_kinds.len { assert(a.reloc_kinds[i] == b.reloc_kinds[i]) }
    assert(a.import_ids.len == b.import_ids.len); for i in 0..a.import_ids.len { assert(a.import_ids[i] == b.import_ids[i]) }
    assert(a.order.len == b.order.len); for i in 0..a.order.len { assert(a.order[i] == b.order[i]) }
    assert(a.raw.len == b.raw.len); for i in 0..a.raw.len { assert(a.raw[i] == b.raw[i]) }
    assert(a.place_kinds.len == b.place_kinds.len); for i in 0..a.place_kinds.len { assert(a.place_kinds[i] == b.place_kinds[i]) }
    assert(a.place_offsets.len == b.place_offsets.len); for i in 0..a.place_offsets.len { assert(a.place_offsets[i] == b.place_offsets[i]) }
    assert(a.place_widths.len == b.place_widths.len); for i in 0..a.place_widths.len { assert(a.place_widths[i] == b.place_widths[i]) }
    assert(a.place_extensions.len == b.place_extensions.len); for i in 0..a.place_extensions.len { assert(a.place_extensions[i] == b.place_extensions[i]) }
    assert(a.place_escaped.len == b.place_escaped.len); for i in 0..a.place_escaped.len { assert(a.place_escaped[i] == b.place_escaped[i]) }
    assert(a.place_table.len == b.place_table.len); for i in 0..a.place_table.len { assert(a.place_table[i] == b.place_table[i]) }
    assert(a.place_probes == b.place_probes)
    assert(a.block_starts.len == b.block_starts.len); for i in 0..a.block_starts.len { assert(a.block_starts[i] == b.block_starts[i]) }
    assert(a.block_ends.len == b.block_ends.len); for i in 0..a.block_ends.len { assert(a.block_ends[i] == b.block_ends[i]) }
    assert(a.op_blocks.len == b.op_blocks.len); for i in 0..a.op_blocks.len { assert(a.op_blocks[i] == b.op_blocks[i]) }
    assert(a.edge_from.len == b.edge_from.len); for i in 0..a.edge_from.len { assert(a.edge_from[i] == b.edge_from[i]) }
    assert(a.edge_to.len == b.edge_to.len); for i in 0..a.edge_to.len { assert(a.edge_to[i] == b.edge_to[i]) }
    assert(a.edge_kinds.len == b.edge_kinds.len); for i in 0..a.edge_kinds.len { assert(a.edge_kinds[i] == b.edge_kinds[i]) }
    assert(a.edge_starts.len == b.edge_starts.len); for i in 0..a.edge_starts.len { assert(a.edge_starts[i] == b.edge_starts[i]) }
    assert(a.label_ids.len == b.label_ids.len); for i in 0..a.label_ids.len { assert(a.label_ids[i] == b.label_ids[i]) }
    assert(a.label_ops.len == b.label_ops.len); for i in 0..a.label_ops.len { assert(a.label_ops[i] == b.label_ops[i]) }
    assert(a.boundaries.len == b.boundaries.len); for i in 0..a.boundaries.len { assert(a.boundaries[i] == b.boundaries[i]) }
    assert(a.leaders.len == b.leaders.len); for i in 0..a.leaders.len { assert(a.leaders[i] == b.leaders[i]) }
    assert(a.visits == b.visits)
    assert(a.budget_exhausted == b.budget_exhausted)
}
fn run(f: &mut mir.Function) -> values.Workspace {
    var work := values.new(); assert(values.optimize_into(&mut work, &mut f))
    assert(f.verified); work
}
fn spans(code: &arm.Code) -> mir.Function {
    sites: []i32 = []; var f := mir.new()
    assert(lift.lift_spans(&mut f, &code, 0, 0, 0, &sites, 0,
        &code.mir_starts, &code.mir_ends, &code.mir_kinds, &code.mir_a, &code.mir_b))
    assert(verify.verify(&mut f)); f
}
// Compare every Function column/metadata field after two independent lifts.
// The reference uses all31 physical GP slots plus the separate immutable ZR.
fn compact_match(code: &arm.Code, count: i32, fallback: bool) -> mir.Function {
    var f := spans(&code); var reference := spans(&code)
    var work := values.new(); var full := values.new_full_domain()
    changed := values.optimize_into(&mut work, &mut f)
    reference_changed := values.optimize_into(&mut full, &mut reference)
    assert(changed == reference_changed && values.status(&work) == values.status(&full))
    assert(values.rewritten(&work) == values.rewritten(&full))
    assert(values.deleted(&work) == values.deleted(&full))
    assert(values.constant_immediates(&work) == values.constant_immediates(&full))
    assert(values.full_verifications(&work) == values.full_verifications(&full))
    assert(values.fact_slots(&work) == count && values.fact_slots(&full) == 32)
    assert(values.fact_rows(&work) == f.block_starts.len * count)
    assert(values.used_full_fallback(&work) == fallback)
    if count < 32 { assert(values.units(&work) < values.units(&full)) }
    same(&f, &reference); f
}
@test fn compact_domain_preserves_noncontiguous_alias_preference_and_abi_liveness() {
    var code := arm.new(); arm.imm(&mut code, 9, 7); arm.mov(&mut code, 24, 9)
    arm.mov(&mut code, 30, 24); add(&mut code, 0, 30, 9, false); arm.emit(&mut code, 3596551104)
    f := compact_match(&code, 5, false)
    assert(f.kinds[3] == 4 && f.imm[3] == 7 && f.b[3] == -1)
    // ABI Return's implicit preserved registers do not inflate the domain,
    // but remain live in the full physical liveness analysis.
    assert(f.modes[1] != 2 && f.modes[2] != 2)
    assert(f.a[3] == 9)
}
@test fn compact_domain_projects_implicit_far_frame_scratch_writes_and_definition_scores() {
    var code := arm.new(); arm.begin_mir(&mut code, true)
    arm.imm(&mut code, 9, 7); arm.load_into(&mut code, 32, 0)
    add(&mut code, 0, 4, 9, false); arm.emit(&mut code, 3596551104); arm.end_mir(&mut code)
    f := compact_match(&code, 4, false)
    assert(f.kinds[1] == 7 && f.writes[1].bit_and(mir.variable_bit(9)) != 0)
    assert(f.b[2] == 9 && f.imm[2] == 0)
    // The scratch write also contributes to physical definition scores.
    // After establishing a new alias, X24 has fewer definitions than X9.
    code = arm.new(); arm.begin_mir(&mut code, true)
    arm.load_into(&mut code, 32, 0); arm.imm(&mut code, 24, 7); arm.mov(&mut code, 9, 24)
    add(&mut code, 0, 9, 4, false); arm.emit(&mut code, 3596551104); arm.end_mir(&mut code)
    scored := compact_match(&code, 5, false); assert(scored.a[3] == 24)
}
@test fn compact_w_values_and_movk_self_input_keep_actual_32_bit_masks() {
    var code := arm.new(); arm.emit(&mut code, 704644064 + 24 * 65536 + 9)
    arm.mov(&mut code, 0, 9); arm.emit(&mut code, 3596551104)
    high := compact_match(&code, 4, false); assert(high.a[1] == 9)
    code = arm.new(); arm.emit(&mut code, 704644064 + 24 * 65536 + 9)
    add(&mut code, 0, 9, 30, true); arm.emit(&mut code, 3596551104)
    low := compact_match(&code, 5, false); assert(low.a[1] == 24 && low.modes[0] == 2)
    code = arm.new(); arm.imm(&mut code, 24, 4294967297)
    arm.emit(&mut code, 704644064 + 24 * 65536 + 9)
    add(&mut code, 0, 4, 9, false); arm.emit(&mut code, 3596551104)
    inserted := compact_match(&code, 5, false)
    assert(inserted.b[3] == -1 && inserted.imm[3] == 1)
}
@test fn compact_join_kills_call_clobbers_from_only_one_predecessor() {
    var code := arm.new(); other := arm.label(&mut code); join := arm.label(&mut code); external := arm.label(&mut code)
    arm.imm(&mut code, 9, 7); arm.branch(&mut code, other, 18)
    arm.branch(&mut code, external, 1); arm.branch(&mut code, join, 0)
    arm.mark(&mut code, other); arm.mark(&mut code, join)
    add(&mut code, 0, 4, 9, false); arm.emit(&mut code, 3596551104)
    f := compact_match(&code, 4, false); assert(f.b[4] == 9 && f.imm[4] == 0)
}
@test fn compact_loop_fixpoint_does_not_alias_previous_iteration_values() {
    var code := arm.new(); head := arm.label(&mut code); done := arm.label(&mut code)
    arm.imm(&mut code, 9, 1); arm.imm(&mut code, 0, 3); arm.mov(&mut code, 24, 4)
    arm.mark(&mut code, head); arm.mov(&mut code, 30, 24); add(&mut code, 24, 24, 9, false)
    arm.emit(&mut code, 3942645791 + 30 * 65536 + 24 * 32)
    arm.emit(&mut code, 3405774848 + 9 * 65536); arm.branch(&mut code, done, 18); arm.branch(&mut code, head, 0)
    arm.mark(&mut code, done); arm.mov(&mut code, 0, 24); arm.emit(&mut code, 3596551104)
    f := compact_match(&code, 6, false)
    assert(f.kinds[5] == 5 && f.a[5] != f.b[5] && f.modes[5] != 2)
}
@test fn compact_domain_tracks_explicit_abi_reserved_gp_roles_and_separates_sp_from_zr() {
    for reg in 18..31 {
        var code := arm.new(); arm.imm(&mut code, reg, 7); add(&mut code, 0, 4, reg, false)
        arm.emit(&mut code, 3596551104)
        f := compact_match(&code, 4, false); assert(f.b[1] == -1 && f.imm[1] == 7)
        assert(f.modes[0] == 0) // Caller-observable preserved state remains live.
    }
    var code := arm.new(); arm.imm(&mut code, 9, 0)
    // ADD X0,SP,#16 has an actual SP source, not the ZR/discard operand.
    arm.emit(&mut code, 2432697312 + 16 * 1024); arm.emit(&mut code, 3596551104)
    f := compact_match(&code, 32, true)
    assert(f.a[1] == 31 && f.modes[1] == 0 && f.imm[1] == 16)
}
@test fn copy_chains_and_known_scalar_immediates_remove_only_dead_materializations() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); arm.mov(&mut code, 2, 1); arm.mov(&mut code, 3, 2)
    add(&mut code, 0, 4, 3, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.kinds[3] == 4 && f.a[3] == 4 && f.b[3] == -1 && f.imm[3] == 5)
    assert(f.modes[0] == 2 && f.modes[1] == 2 && f.modes[2] == 2 && f.modes[3] == 1)
    assert(values.constant_immediates(&work) == 1 && values.deleted(&work) == 3)
    assert(values.full_verifications(&work) == 1)
}
@test fn scalar_certificate_preservation_keeps_checked_flags_and_final_full_verification() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); arm.mov(&mut code, 2, 1)
    arm.emit(&mut code, 2868903936 + 2 * 65536 + 4 * 32); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.modes[2] == 1 && f.flags[2] == 2 && f.b[2] == -1 && f.imm[2] == 5)
    assert(values.full_verifications(&work) == 1 && values.deleted(&work) == 2)
    code = arm.new(); arm.imm(&mut code, 24, 7); arm.imm(&mut code, 9, 7)
    add(&mut code, 0, 4, 9, false); arm.emit(&mut code, 3596551104)
    f = model(&code); constant_copy := run(&mut f)
    assert(f.kinds[1] == 2 && f.a[1] == 24 && values.full_verifications(&constant_copy) == 1)
}
@test fn scalar_certificate_fp_roles_take_the_full_staged_verification_path() {
    var code := arm.new(); arm.mov(&mut code, 29, 4); arm.mov(&mut code, 0, 29); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.modes[1] == 1 && f.a[1] == 4 && values.full_verifications(&work) == 2)
}
@test fn scalar_certificate_safe_unsafe_safe_sequence_cannot_restore_a_false_certificate() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); add(&mut code, 0, 4, 1, false)
    arm.mov(&mut code, 29, 4); arm.mov(&mut code, 9, 29)
    arm.imm(&mut code, 2, 3); add(&mut code, 0, 0, 2, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); expected := model(&code); var work := values.new()
    assert(values.optimize_into(&mut work, &mut f))
    assert(f.modes[1] == 1 && f.imm[1] == 5 && f.modes[3] == 2 && f.a[3] == 4)
    assert(f.modes[5] == 1 && f.imm[5] == 3 && values.full_verifications(&work) == 2)
    total := values.units(&work); f = model(&code)
    assert(!values.optimize_budget(&mut work, &mut f, total - 1) && values.status(&work) == -3)
    assert(values.full_verifications(&work) == 1 && values.restored_rows(&work) > 0)
    same(&f, &expected)
}
@test fn scalar_certificate_preservation_never_upgrades_an_unverified_input() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); add(&mut code, 0, 4, 1, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); var expected := model(&code); var work := values.new()
    f.verified = false; expected.verified = false
    assert(!values.optimize_into(&mut work, &mut f) && values.status(&work) == -1)
    assert(values.full_verifications(&work) == 0 && values.restored_rows(&work) == 0)
    same(&f, &expected)
}
fn diamond(disagree: bool) -> mir.Function {
    var code := arm.new(); other := arm.label(&mut code); join := arm.label(&mut code)
    arm.branch(&mut code, other, 18); arm.imm(&mut code, 1, 11); arm.branch(&mut code, join, 0)
    arm.mark(&mut code, other); var constant := 11; if disagree { constant = 12 }
    arm.imm(&mut code, 1, i64(constant)); arm.mark(&mut code, join)
    add(&mut code, 0, 4, 1, false); arm.emit(&mut code, 3596551104); model(&code)
}
@test fn joins_require_agreement_from_every_reachable_predecessor() {
    var agreed := diamond(false); work := run(&mut agreed)
    assert(agreed.b[4] == -1 && agreed.imm[4] == 11 && values.constant_immediates(&work) == 1)
    var different := diamond(true); var refused := values.new()
    assert(!values.optimize_into(&mut refused, &mut different) && values.status(&refused) == 0)
    assert(different.modes[4] == 0 && different.b[4] == 1 && different.imm[4] == 0)
}
@test fn unreachable_predecessors_do_not_destroy_reachable_available_facts() {
    var code := arm.new(); reachable := arm.label(&mut code); join := arm.label(&mut code)
    arm.branch(&mut code, reachable, 0); arm.imm(&mut code, 1, 99); arm.branch(&mut code, join, 0)
    arm.mark(&mut code, reachable); arm.imm(&mut code, 1, 11); arm.mark(&mut code, join)
    add(&mut code, 0, 4, 1, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.imm[4] == 11 && values.constant_immediates(&work) == 1)
}
@test fn loop_reexecution_kills_old_aliases_before_defining_the_new_value() {
    var code := arm.new(); head := arm.label(&mut code); done := arm.label(&mut code)
    arm.imm(&mut code, 3, 1); arm.imm(&mut code, 0, 3); arm.mov(&mut code, 1, 4)
    arm.mark(&mut code, head); arm.mov(&mut code, 2, 1); add(&mut code, 1, 1, 3, false)
    arm.emit(&mut code, 3942645791 + 2 * 65536 + 1 * 32)
    arm.emit(&mut code, 3405774848 + 3 * 65536); arm.branch(&mut code, done, 18); arm.branch(&mut code, head, 0)
    arm.mark(&mut code, done); arm.mov(&mut code, 0, 1); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.kinds[5] == 5 && f.flags[5] == 2 && f.a[5] != f.b[5] && f.modes[5] != 2)
    assert(values.fixpoint_visits(&work) > f.block_starts.len)
}
@test fn w_low_bit_equivalence_never_becomes_unsound_x_equivalence() {
    var code := arm.new(); arm.emit(&mut code, 704644064 + 1 * 65536 + 2)
    arm.mov(&mut code, 0, 2); arm.emit(&mut code, 3596551104)
    var f := model(&code); var no_change := values.new()
    assert(!values.optimize_into(&mut no_change, &mut f) && f.a[1] == 2)
    code = arm.new(); arm.emit(&mut code, 704644064 + 1 * 65536 + 2)
    add(&mut code, 0, 2, 3, true); arm.emit(&mut code, 3596551104)
    f = model(&code); work := run(&mut f)
    assert(f.a[1] == 1 && f.modes[0] == 2 && values.deleted(&work) == 1)
}
@test fn materialized_full_width_constants_keep_low_and_full_bits_distinct() {
    var code := arm.new(); arm.imm(&mut code, 1, 4294967297)
    arm.emit(&mut code, 704644064 + 1 * 65536 + 2); add(&mut code, 0, 4, 2, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.b[3] == -1 && f.imm[3] == 1 && values.constant_immediates(&work) == 1)
}
@test fn abi_clobbers_kill_value_facts_and_memory_is_never_cached() {
    var code := arm.new(); external := arm.label(&mut code)
    arm.imm(&mut code, 1, 9); arm.branch(&mut code, external, 1); add(&mut code, 0, 4, 1, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); var work := values.new()
    assert(!values.optimize_into(&mut work, &mut f) && f.b[2] == 1)
    code = arm.new(); arm.emit(&mut code, 4181721088 + 4 * 32); arm.emit(&mut code, 4181721088 + 4 * 32 + 1)
    add(&mut code, 0, 0, 1, false); arm.emit(&mut code, 3596551104)
    f = model(&code); assert(!values.optimize_into(&mut work, &mut f))
    assert(f.modes[0] == 0 && f.modes[1] == 0 && f.kinds[0] == 7 && f.kinds[1] == 7)
}
@test fn early_budget_refusal_is_unchanged_and_workspace_can_be_reused() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); add(&mut code, 0, 4, 1, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); expected := model(&code); var work := values.new()
    assert(!values.optimize_budget(&mut work, &mut f, 1) && values.status(&work) == -3)
    assert(values.rewritten(&work) == 0 && values.deleted(&work) == 0 && values.restored_rows(&work) == 0)
    same(&f, &expected)
    assert(values.optimize_into(&mut work, &mut f) && f.verified && values.status(&work) == 2)
}
@test fn late_budget_exhaustion_hides_partial_plans_and_preserves_checked_flags() {
    var code := arm.new(); trap := arm.label(&mut code)
    arm.imm(&mut code, 1, 1); arm.emit(&mut code, 2868903936 + 1 * 65536 + 4 * 32)
    arm.branch(&mut code, trap, 8); arm.emit(&mut code, 3596551104)
    arm.mark(&mut code, trap); arm.emit(&mut code, 3596551104)
    var f := model(&code); var work := values.new(); assert(values.optimize_into(&mut work, &mut f))
    total := values.units(&work); f = model(&code)
    assert(!values.optimize_budget(&mut work, &mut f, total - 1) && values.status(&work) == -3)
    assert(values.deleted(&work) == 0 && values.rewritten(&work) == 0 && f.verified && f.modes[0] == 0 && f.modes[1] == 0)
    assert(values.full_verifications(&work) == 0) // Charged final verification refused before execution.
    assert(f.verified)
    assert(values.optimize_into(&mut work, &mut f) && f.verified)
    assert(f.flags[1] == 2 && f.modes[1] == 1 && f.modes[2] == 0 && f.kinds[2] == 13)
}
fn refused_exit(code: &arm.Code, expected_kind: i32) {
    var f := model(&code); var exit := false
    for e in 0..f.edge_to.len { if f.edge_to[e] < 0 && f.edge_kinds[e] == expected_kind { exit = true } }
    assert(exit)
    var work := values.new(); assert(!values.optimize_into(&mut work, &mut f))
    assert(values.status(&work) == -2 && values.deleted(&work) == 0 && values.rewritten(&work) == 0)
    assert(f.verified)
    for op in 0..f.kinds.len { assert(f.modes[op] == 0) }
    assert(f.verified)
}
@test fn external_and_fallthrough_exits_preserve_uncontracted_register_observations() {
    var code := arm.new(); outside := arm.label(&mut code)
    arm.imm(&mut code, 0, 42); arm.branch(&mut code, outside, 0)
    refused_exit(&code, 2)
    code = arm.new(); before := arm.label(&mut code); external := arm.label(&mut code)
    arm.imm(&mut code, 0, 42); arm.branch(&mut code, before, 0)
    arm.mark(&mut code, before); arm.branch(&mut code, external, 0)
    refused_exit(&code, 2)
    code = arm.new(); conditional := arm.label(&mut code); external_cond := arm.label(&mut code)
    arm.imm(&mut code, 1, 42); arm.branch(&mut code, conditional, 0)
    arm.mark(&mut code, conditional); arm.branch(&mut code, external_cond, 18)
    arm.imm(&mut code, 0, 0); arm.emit(&mut code, 3596551104)
    refused_exit(&code, 2)
    code = arm.new(); fall := arm.label(&mut code)
    arm.imm(&mut code, 0, 42); arm.branch(&mut code, fall, 0)
    arm.mark(&mut code, fall); arm.mov(&mut code, 1, 0)
    refused_exit(&code, 5)
}
@test fn unreachable_uncontracted_exit_does_not_block_return_abi_optimization() {
    var code := arm.new(); body := arm.label(&mut code); outside := arm.label(&mut code)
    arm.branch(&mut code, body, 0); arm.imm(&mut code, 0, 99); arm.branch(&mut code, outside, 0)
    arm.mark(&mut code, body); arm.imm(&mut code, 1, 5); arm.mov(&mut code, 2, 1)
    add(&mut code, 0, 4, 2, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.imm[5] == 5 && f.b[5] == -1 && values.constant_immediates(&work) == 1)
    assert(f.modes[1] == 0 && f.modes[2] == 0 && f.modes[3] == 2 && f.modes[4] == 2)
}
@test fn unrelated_unknown_values_do_not_share_an_equivalence_class() {
    var code := arm.new(); arm.mov(&mut code, 1, 4); add(&mut code, 0, 1, 5, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); work := run(&mut f)
    assert(f.a[1] == 4 && f.b[1] == 5 && f.a[1] != f.b[1] && values.deleted(&work) == 1)
}
@test fn sparse_rollback_restores_full_rows_mode_only_rows_and_all_function_metadata() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); arm.imm(&mut code, 2, 5)
    add(&mut code, 0, 4, 1, false); arm.emit(&mut code, 3596551104)
    var f := model(&code); expected := model(&code); var work := values.new()
    assert(values.optimize_into(&mut work, &mut f)); total := values.units(&work)
    var exercised := false
    for step in 1..17 {
        f = model(&code); limit := total * step / 17
        assert(!values.optimize_budget(&mut work, &mut f, limit) && values.status(&work) == -3)
        same(&f, &expected)
        assert(values.rewritten(&work) == 0 && values.deleted(&work) == 0 && values.constant_immediates(&work) == 0)
        if values.restored_rows(&work) > 0 { exercised = true }
    }
    f = model(&code)
    assert(!values.optimize_budget(&mut work, &mut f, total - 1) && values.restored_rows(&work) > 0)
    same(&f, &expected); assert(exercised)
    assert(values.optimize_into(&mut work, &mut f) && f.verified)
}
@test fn verifier_rejection_rolls_back_changed_rows_and_verified_optimizable_metadata() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); add(&mut code, 0, 4, 1, false)
    arm.emit(&mut code, 3573751839); arm.emit(&mut code, 3596551104)
    var f := model(&code); var expected := model(&code); var work := values.new()
    // Fault-inject a stale certificate on an untouched retained unit. The
    // ordinary verifier must reject after staging and restore the exact input.
    f.variant[2] = 0; expected.variant[2] = 0
    assert(!values.optimize_into(&mut work, &mut f) && values.status(&work) == -1)
    assert(values.restored_rows(&work) == 2 && values.rewritten(&work) == 0)
    assert(values.full_verifications(&work) == 1) // Final verifier, after replay AND pure DCE.
    same(&f, &expected)
}
fn dead_constant_chain(length: i32) -> arm.Code {
    var code := arm.new(); arm.imm(&mut code, 1, 17)
    for i in 0..length { arm.emit(&mut code, 4068474880 + 3 * 2097152 + 48879 * 32 + 1) }
    arm.emit(&mut code, 3573751839); arm.emit(&mut code, 3596551104); code
}
@test fn long_movk_chain_uses_mode_only_undo_and_rolls_back_at_final_verification_budget() {
    code := dead_constant_chain(256); var f := model(&code); expected := model(&code); var work := values.new()
    assert(values.optimize_into(&mut work, &mut f) && f.verified)
    assert(values.deleted(&work) == 257 && f.modes[257] == 0 && f.modes[258] == 0)
    assert(values.full_verifications(&work) == 1)
    for op in 0..257 { assert(f.modes[op] == 2) }
    total := values.units(&work); f = model(&code)
    assert(!values.optimize_budget(&mut work, &mut f, total - 1) && values.status(&work) == -3)
    assert(values.restored_rows(&work) == 257 && values.deleted(&work) == 0)
    assert(values.full_verifications(&work) == 0)
    same(&f, &expected)
}
@test fn proof_preserving_dce_still_runs_the_unconditional_complete_final_verifier() {
    code := dead_constant_chain(128); var f := model(&code); var expected := model(&code); var work := values.new()
    // Replay makes no replacements. DCE can preserve an already-true
    // certificate, but must never use it to bypass final raw/MIR consistency.
    f.variant[129] = 0; expected.variant[129] = 0
    assert(!values.optimize_into(&mut work, &mut f) && values.status(&work) == -1)
    assert(values.restored_rows(&work) == 129 && values.deleted(&work) == 0)
    assert(values.full_verifications(&work) == 1)
    same(&f, &expected)
}
@test fn only_explicit_unobserving_terminal_context_allows_external_branch_dce() {
    var code := arm.new(); terminal := arm.label(&mut code)
    arm.imm(&mut code, 0, 42); arm.branch(&mut code, terminal, 0)
    var f := model(&code); var work := values.new()
    assert(!values.optimize_into(&mut work, &mut f) && values.status(&work) == -2)
    var ctx := values.context(1)
    assert(values.declare_unobserving_terminal(&mut ctx, terminal))
    assert(values.declare_unobserving_terminal(&mut ctx, terminal))
    assert(values.optimize_with_context(&mut work, &mut f, &ctx))
    assert(f.verified && f.modes[0] == 2 && f.modes[1] == 0)
    assert(f.kinds[1] == 12 && f.targets[1] == terminal && f.verified)
    // Context use must never leak to a later raw invocation on reused roots.
    f = model(&code)
    assert(!values.optimize_into(&mut work, &mut f) && values.status(&work) == -2)
    assert(f.verified && f.modes[0] == 0)
}
@test fn terminal_contract_preserves_checked_flags_branch_and_return_values() {
    var code := arm.new(); terminal := arm.label(&mut code)
    arm.imm(&mut code, 1, 1); arm.emit(&mut code, 2868903936 + 1 * 65536 + 4 * 32)
    arm.branch(&mut code, terminal, 8); arm.emit(&mut code, 3596551104)
    var f := model(&code); var work := values.new(); var ctx := values.context(1)
    assert(values.declare_unobserving_terminal(&mut ctx, terminal))
    assert(values.optimize_with_context(&mut work, &mut f, &ctx))
    total := values.units(&work); f = model(&code)
    assert(!values.optimize_with_context_budget(&mut work, &mut f, &ctx, total - 1))
    assert(values.status(&work) == -3 && values.deleted(&work) == 0 && values.rewritten(&work) == 0)
    assert(f.verified && f.modes[0] == 0 && f.flags[1] == 2)
    assert(values.optimize_with_context(&mut work, &mut f, &ctx) && f.verified)
    assert(f.modes[0] == 2 && f.modes[1] == 1 && f.flags[1] == 2 && f.imm[1] == 1)
    assert(f.kinds[2] == 13 && f.modes[2] == 0 && f.targets[2] == terminal && f.kinds[3] == 15)
}
@test fn terminal_labels_match_exactly_and_all_reachable_external_edges_need_contracts() {
    var code := arm.new(); first := arm.label(&mut code); second := arm.label(&mut code)
    arm.imm(&mut code, 1, 42); arm.branch(&mut code, first, 18); arm.branch(&mut code, second, 0)
    var f := model(&code); var work := values.new(); var ctx := values.context(1)
    // Declare in reverse order to exercise sorted exact-ID lookup.
    assert(values.declare_unobserving_terminal(&mut ctx, second))
    assert(!values.optimize_with_context(&mut work, &mut f, &ctx) && values.status(&work) == -2)
    assert(f.modes[0] == 0)
    assert(values.declare_unobserving_terminal(&mut ctx, first))
    assert(values.optimize_with_context(&mut work, &mut f, &ctx) && f.verified)
    assert(f.modes[0] == 2 && f.modes[1] == 0 && f.modes[2] == 0)
}
@test fn wrong_terminal_epoch_and_invalid_declarations_refuse_atomically() {
    var code := arm.new(); terminal := arm.label(&mut code)
    arm.imm(&mut code, 0, 42); arm.branch(&mut code, terminal, 0)
    var f := model(&code); var work := values.new(); var ctx := values.context(1)
    assert(values.declare_unobserving_terminal(&mut ctx, terminal + 1))
    assert(!values.optimize_with_context(&mut work, &mut f, &ctx) && values.status(&work) == -2)
    for epoch in 0..3 {
        if epoch == 1 { continue }
        ctx = values.context(epoch)
        assert(!values.declare_unobserving_terminal(&mut ctx, terminal))
        assert(!values.optimize_with_context(&mut work, &mut f, &ctx) && values.status(&work) == -1)
        assert(f.verified && f.modes[0] == 0)
    }
    ctx = values.context(1); assert(values.declare_unobserving_terminal(&mut ctx, terminal))
    assert(values.optimize_with_context(&mut work, &mut f, &ctx))
    f = model(&code)
    assert(!values.declare_unobserving_terminal(&mut ctx, -1))
    assert(!values.optimize_with_context(&mut work, &mut f, &ctx) && values.status(&work) == -1)
    assert(f.verified && f.modes[0] == 0)
}
@test fn terminal_contract_does_not_erase_the_branch_own_register_observation() {
    var code := arm.new(); first := arm.label(&mut code); second := arm.label(&mut code)
    arm.imm(&mut code, 0, 42); arm.branch(&mut code, first, 18); arm.branch(&mut code, second, 0)
    var f := model(&code); var work := values.new(); var ctx := values.context(1)
    assert(values.declare_unobserving_terminal(&mut ctx, first))
    assert(values.declare_unobserving_terminal(&mut ctx, second))
    // Each terminal may have a different fixed status. CBZ still selects it.
    assert(!values.optimize_with_context(&mut work, &mut f, &ctx) && values.status(&work) == 0)
    assert(f.modes[0] == 0 && values.deleted(&work) == 0 && f.verified)
}
@test fn terminal_contract_never_classifies_fallthrough_or_unlabelled_trap() {
    var code := arm.new(); var terminal := arm.label(&mut code); arm.imm(&mut code, 0, 42)
    var f := model(&code); var work := values.new(); var ctx := values.context(1)
    assert(values.declare_unobserving_terminal(&mut ctx, terminal))
    assert(!values.optimize_with_context(&mut work, &mut f, &ctx) && values.status(&work) == -2)
    code = arm.new(); terminal = arm.label(&mut code)
    arm.imm(&mut code, 0, 42); arm.emit(&mut code, 3558866944)
    f = model(&code)
    assert(!values.optimize_with_context(&mut work, &mut f, &ctx) && values.status(&work) == -2)
    assert(f.modes[0] == 0 && f.kinds[1] == 20)
}
fn main() {}
