// Unit tests for Phase 3 Backend Decoupling:
// - selfhost/backend/arm64_enc.ddr (byte-exact ARM64 encodings cross-checked against arm64.ddr + FP/atomics/relax)
// - selfhost/backend/x86_enc.ddr (byte-exact native SysV/Win64 x86_64 GP + SSE2 + RIP-rel + atomics + jumps)
// - selfhost/backend/object_module.ddr (target-neutral ObjectModule, relocs, TypeDescTable, merge, Mach-O/ELF/PE/DWARF)

import ..selfhost.backend.arm64 as legacy_arm
import ..selfhost.backend.arm64_enc as a64
import ..selfhost.backend.x86_enc as x64
import ..selfhost.backend.object_module as om
import ..selfhost.backend.imports as native_imports
import ..selfhost.backend.macho as macho
import ..selfhost.backend.elf as elf
import ..selfhost.backend.pe as pe

fn read_le32(buf: &[]u8, off: i32) -> i64 {
    i64(buf[off]).bit_or(i64(buf[off + 1]).shl(8))
        .bit_or(i64(buf[off + 2]).shl(16))
        .bit_or(i64(buf[off + 3]).shl(24))
}

fn read_le64(buf: &[]u8, off: i32) -> i64 {
    lo := read_le32(&buf, off)
    hi := read_le32(&buf, off + 4)
    lo.bit_or(hi.shl(32))
}

fn bytes_match(actual: &[]u8, expected: &[]i32) -> bool {
    if actual.len != expected.len { return false }
    for i in 0..actual.len {
        if i32(actual[i]) != expected[i] { return false }
    }
    true
}

// --- 1. ARM64 Encoder Tests (Cross-Checked Against Legacy arm64.ddr) ---

@test fn arm64_enc_alu_and_bitfield_match_legacy() {
    mut b := a64.new()
    mut c := legacy_arm.new()

    // add_imm, sub_imm, add_reg, sub_reg, mul, sdiv, udiv, and, orr, eor, lsl, lsr, asr, sxtw, msub
    a64.add_imm(&mut b, true, false, 0, 1, 42);           legacy_arm.integer_binary(&mut c, 1, true, false, 0, 1, -1, 42)
    a64.sub_imm(&mut b, true, true, 2, 3, 4096);          legacy_arm.integer_binary(&mut c, 2, true, true, 2, 3, -1, 4096)
    a64.add_reg(&mut b, true, false, 4, 5, 6);            legacy_arm.integer_binary(&mut c, 1, true, false, 4, 5, 6, -1)
    a64.sub_reg(&mut b, false, true, 7, 8, 9);            legacy_arm.integer_binary(&mut c, 2, false, true, 7, 8, 9, -1)
    a64.mul(&mut b, true, 0, 1, 2);                       legacy_arm.integer_binary(&mut c, 3, true, false, 0, 1, 2, -1)
    a64.sdiv(&mut b, true, 3, 4, 5);                      legacy_arm.integer_binary(&mut c, 6, true, false, 3, 4, 5, -1)
    a64.udiv(&mut b, true, 6, 7, 8);                      legacy_arm.integer_binary(&mut c, 7, true, false, 6, 7, 8, -1)
    a64.and_reg(&mut b, true, false, 1, 2, 3);            legacy_arm.integer_binary(&mut c, 8, true, false, 1, 2, 3, -1)
    a64.orr_reg(&mut b, true, 4, 5, 6);                   legacy_arm.integer_binary(&mut c, 9, true, false, 4, 5, 6, -1)
    a64.eor_reg(&mut b, true, 7, 8, 9);                   legacy_arm.integer_binary(&mut c, 10, true, false, 7, 8, 9, -1)
    a64.lsl_reg(&mut b, true, 0, 1, 2);                   legacy_arm.integer_binary(&mut c, 14, true, false, 0, 1, 2, -1)
    a64.lsr_reg(&mut b, true, 3, 4, 5);                   legacy_arm.integer_binary(&mut c, 15, true, false, 3, 4, 5, -1)
    a64.sxtw(&mut b, 0, 1);                               legacy_arm.sign_extend_i32(&mut c, 0, 1)
    a64.msub(&mut b, true, 0, 1, 2, 3);                   legacy_arm.multiply_subtract(&mut c, 0, 1, 2, 3)
    a64.add_reg_lsl(&mut b, true, 0, 1, 2, 3);            legacy_arm.add_scaled(&mut c, 0, 1, 2, 3)
    a64.mov(&mut b, 5, 6);                                legacy_arm.mov(&mut c, 5, 6)
    a64.cmp_reg(&mut b, true, 1, 2);                      legacy_arm.compare_register(&mut c, 1, 2)
    a64.cmp_imm(&mut b, true, 3, 17);                     legacy_arm.compare_immediate(&mut c, 3, 17, false)
    a64.cmn_imm(&mut b, true, 4, 9);                      legacy_arm.compare_immediate(&mut c, 4, 9, true)
    a64.cset(&mut b, 0, a64.CC_LT);                       legacy_arm.set_condition(&mut c, 0, a64.CC_LT)

    assert(b.words.len == c.words.len)
    for i in 0..b.words.len {
        assert(b.words[i] == c.words[i])
    }
}

@test fn arm64_enc_immediates_match_legacy() {
    vals: []i64 = [0, 1, 65535, -1, -65536, 0x12345678, -100000, 0x1122334455667788, -0x0001000200030004]
    for i in 0..vals.len {
        mut b := a64.new()
        mut c := legacy_arm.new()
        a64.imm(&mut b, 5, vals[i])
        legacy_arm.imm(&mut c, 5, vals[i])
        assert(b.words.len == c.words.len)
        for k in 0..b.words.len {
            assert(b.words[k] == c.words[k])
        }
    }
}

@test fn arm64_enc_loads_stores_and_prologue_match_legacy() {
    mut b := a64.new()
    mut c := legacy_arm.new()

    a64.ldr(&mut b, 0, 1, 0, 1, false);     legacy_arm.transfer(&mut c, true, 0, 1, 0, 0)
    a64.ldr(&mut b, 0, 1, 4, 2, false);     legacy_arm.transfer(&mut c, true, 0, 1, 1, 4)
    a64.ldr(&mut b, 0, 1, 8, 4, false);     legacy_arm.transfer(&mut c, true, 0, 1, 2, 8)
    a64.ldr(&mut b, 0, 1, 16, 8, false);    legacy_arm.transfer(&mut c, true, 0, 1, 3, 16)
    a64.ldr(&mut b, 0, 1, 12, 4, true);     legacy_arm.transfer(&mut c, true, 0, 1, 4, 12)
    a64.str(&mut b, 2, 3, 24, 8);           legacy_arm.transfer(&mut c, false, 2, 3, 3, 24)
    a64.ldr_idx(&mut b, 4, 5, 6, 8, false); legacy_arm.transfer_indexed(&mut c, true, 4, 5, 6)
    a64.str_idx(&mut b, 4, 5, 6, 8);        legacy_arm.transfer_indexed(&mut c, false, 4, 5, 6)
    a64.stp_pre(&mut b, a64.FP, a64.LR, a64.SP, -16)
    a64.mov(&mut b, a64.FP, a64.SP)
    a64.mov(&mut b, a64.SP, a64.FP)
    a64.ldp_post(&mut b, a64.FP, a64.LR, a64.SP, 16)
    a64.ret(&mut b)

    assert(b.words.len == c.words.len + 5)
    for i in 0..c.words.len { assert(b.words[i] == c.words[i]) }
    // Verify exact stp x29,x30,[sp,#-16]! / mov x29,sp / mov sp,x29 / ldp x29,x30,[sp],#16 / ret
    base := c.words.len
    assert(b.words[base] == 0xa9bf7bfd)
    assert(b.words[base + 1] == 0x910003fd)
    assert(b.words[base + 2] == 0x910003bf)
    assert(b.words[base + 3] == 0xa8c17bfd)
    assert(b.words[base + 4] == 0xd65f03c0)
}

@test fn arm64_enc_fp_and_atomics_exact() {
    mut b := a64.new()
    a64.fmov_to_fp(&mut b, false, 0, 0)      // fmov s0, w0  = 0x1e270000
    a64.fmov_to_fp(&mut b, true, 1, 1)       // fmov d1, x1  = 0x9e670021
    a64.fmov_from_fp(&mut b, true, 0, 0)     // fmov x0, d0  = 0x9e660000
    a64.fadd(&mut b, true, 0, 1, 2)          // fadd d0, d1, d2 = 0x1e622820
    a64.fsub(&mut b, false, 3, 4, 5)         // fsub s3, s4, s5 = 0x1e253883
    a64.fmul(&mut b, true, 0, 0, 1)          // fmul d0, d0, d1 = 0x1e610800
    a64.fdiv(&mut b, true, 0, 0, 1)          // fdiv d0, d0, d1 = 0x1e611800
    a64.fcmp(&mut b, true, 0, 1)             // fcmp d0, d1  = 0x1e612000
    a64.scvtf(&mut b, true, true, 0, 0)      // scvtf d0, x0 = 0x9e620000
    a64.fcvtzs(&mut b, true, true, 0, 0)     // fcvtzs x0, d0 = 0x9e780000
    a64.fcvt_f32_to_f64(&mut b, 0, 0)        // fcvt d0, s0  = 0x1e22c000
    a64.fcvt_f64_to_f32(&mut b, 0, 0)        // fcvt s0, d0  = 0x1e624000
    a64.ldaxr(&mut b, true, 2, 0)            // ldaxr x2, [x0] = 0xc85ffc02
    a64.stlxr(&mut b, true, 3, 1, 0)         // stlxr w3, x1, [x0] = 0xc803fc01
    a64.casal(&mut b, true, 1, 2, 0)         // casal x1, x2, [x0] = 0xc8e1fc02
    a64.dmb_ish(&mut b)                      // dmb ish = 0xd5033bbf

    assert(b.words[0] == 0x1e270000)
    assert(b.words[1] == 0x9e670021)
    assert(b.words[2] == 0x9e660000)
    assert(b.words[3] == 0x1e622820)
    assert(b.words[4] == 0x1e253883)
    assert(b.words[5] == 0x1e610800)
    assert(b.words[6] == 0x1e611800)
    assert(b.words[7] == 0x1e612000)
    assert(b.words[8] == 0x9e620000)
    assert(b.words[9] == 0x9e780000)
    assert(b.words[10] == 0x1e22c000)
    assert(b.words[11] == 0x1e624000)
    assert(b.words[12] == 0xc85ffc02)
    assert(b.words[13] == 0xc803fc01)
    assert(b.words[14] == 0xc8e1fc02)
    assert(b.words[15] == 0xd5033bbf)
}

@test fn arm64_enc_branch_relax_and_adrp_patching() {
    mut b := a64.new()
    done := a64.label(&mut b)
    data := a64.label(&mut b)

    a64.cmp_imm(&mut b, true, 0, 0)
    a64.b_cond(&mut b, a64.CC_EQ, done)      // reserves 2 words, relaxes to 1
    a64.cbz(&mut b, true, 1, done)           // reserves 2 words, relaxes to 1
    a64.adrp_add(&mut b, a64.X2, data)       // 2 words
    a64.mark(&mut b, done)
    a64.ret(&mut b)
    a64.mark(&mut b, data)
    a64.emit(&mut b, 0xdeadbeef)

    removed := a64.relax_branches(&mut b)
    assert(removed == 2)
    a64.patch_relocs(&mut b, 4096)
    // b.eq +4 words (from word 1 to word 5): 0x54000000 | (4 << 5) = 0x54000080
    assert(b.words[1] == 0x54000080)
    // cbz x1, +3 words (from word 2 to word 5): 0xb4000001 | (3 << 5) = 0xb4000061
    assert(b.words[2] == 0xb4000061)
    // adrp x2, page 0 (4096+12=4108 -> 4096+24=4120, same page): 0x90000002
    assert(b.words[3] == 0x90000002)
    // add x2, x2, #24 (4120 % 4096 = 24): 0x91000000 | (24 << 10) | (2 << 5) | 2 = 0x91006042
    assert(b.words[4] == 0x91006042)
    out := a64.to_bytes(&b)
    assert(out.len == b.words.len * 4)
    assert(read_le32(&out, 4) == 0x54000080)
}

// --- 2. Native x86_64 Encoder Tests (SysV & Win64, Zero [r15] Bank) ---

@test fn x86_enc_gp_moves_alu_and_edge_cases() {
    // Verify native SysV & Win64 ABI helper tables
    assert(x64.sysv_gp_arg(0) == x64.RDI && x64.sysv_gp_arg(5) == x64.R9)
    assert(x64.win64_gp_arg(0) == x64.RCX && x64.win64_gp_arg(3) == x64.R9)
    assert(x64.sysv_is_callee_saved(x64.RBX) && !x64.sysv_is_callee_saved(x64.RDI))
    assert(x64.win64_is_callee_saved(x64.RDI) && x64.win64_is_callee_saved(x64.RSI))

    // mov rax, rdi => 48 89 f8
    mut b := x64.new()
    x64.mov_rr(&mut b, true, x64.RAX, x64.RDI)
    assert(bytes_match(&b.bytes, &[0x48, 0x89, 0xf8]))

    // mov r12, r8 => 4d 89 c4
    b = x64.new()
    x64.mov_rr(&mut b, true, x64.R12, x64.R8)
    assert(bytes_match(&b.bytes, &[0x4d, 0x89, 0xc4]))

    // mov_imm 0 => xor eax, eax (31 c0); preserve_flags => mov eax, 0 (b8 00 00 00 00)
    b = x64.new()
    x64.mov_imm(&mut b, true, x64.RAX, 0)
    assert(bytes_match(&b.bytes, &[0x31, 0xc0]))

    b = x64.new()
    x64.mov_imm_preserve_flags(&mut b, true, x64.RAX, 0)
    assert(bytes_match(&b.bytes, &[0xb8, 0x00, 0x00, 0x00, 0x00]))

    // Byte store from SIL (reg 6) to [rbp - 8]: MUST emit REX 0x40! => 40 88 75 f8
    b = x64.new()
    x64.mov_store(&mut b, x64.RBP, -8, x64.RSI, 1)
    assert(bytes_match(&b.bytes, &[0x40, 0x88, 0x75, 0xf8]))

    // Load [rsp] (needs SIB 0x24): mov rax, [rsp] => 48 8b 04 24
    b = x64.new()
    x64.mov_load(&mut b, x64.RAX, x64.RSP, 0, 8, false)
    assert(bytes_match(&b.bytes, &[0x48, 0x8b, 0x04, 0x24]))

    // Load [rbp] (disp=0 on rm=5 needs mod=01 disp8=0): mov rdx, [rbp + 0] => 48 8b 55 00
    b = x64.new()
    x64.mov_load(&mut b, x64.RDX, x64.RBP, 0, 8, false)
    assert(bytes_match(&b.bytes, &[0x48, 0x8b, 0x55, 0x00]))

    // Load signed byte [r12 + r10*8 + 16]: movsx rax, byte [r12 + r10*8 + 16] => 4b 0f be 44 d4 10
    b = x64.new()
    x64.mov_load_sib(&mut b, x64.RAX, x64.R12, x64.R10, 8, 16, 1, true)
    assert(bytes_match(&b.bytes, &[0x4b, 0x0f, 0xbe, 0x44, 0xd4, 0x10]))

    // setcc_bool CC_L, RSI (SIL needs REX 0x40): 40 0f 9c c6  40 0f b6 f6
    b = x64.new()
    x64.setcc_bool(&mut b, x64.CC_L, x64.RSI)
    assert(bytes_match(&b.bytes, &[0x40, 0x0f, 0x9c, 0xc6, 0x40, 0x0f, 0xb6, 0xf6]))
}

@test fn x86_enc_sse2_atomics_and_jumps_exact() {
    // addsd xmm0, xmm1 => f2 0f 58 c1
    mut b := x64.new()
    x64.adds_rr(&mut b, true, x64.XMM0, x64.XMM1)
    assert(bytes_match(&b.bytes, &[0xf2, 0x0f, 0x58, 0xc1]))

    // movss xmm8, [rsp + 16] => f3 44 0f 10 44 24 10
    b = x64.new()
    x64.movs_load(&mut b, false, x64.XMM8, x64.RSP, 16)
    assert(bytes_match(&b.bytes, &[0xf3, 0x44, 0x0f, 0x10, 0x44, 0x24, 0x10]))

    // cvtsi2sd xmm0, rax (64-bit) => f2 48 0f 2a c0
    b = x64.new()
    x64.cvtsi2s(&mut b, true, true, x64.XMM0, x64.RAX)
    assert(bytes_match(&b.bytes, &[0xf2, 0x48, 0x0f, 0x2a, 0xc0]))

    // ucomisd xmm0, xmm1 => 66 0f 2e c1
    b = x64.new()
    x64.ucomis_rr(&mut b, true, x64.XMM0, x64.XMM1)
    assert(bytes_match(&b.bytes, &[0x66, 0x0f, 0x2e, 0xc1]))

    // lock cmpxchg [rdi], rcx (64b) => f0 48 0f b1 0f
    b = x64.new()
    x64.lock_cmpxchg(&mut b, true, x64.RDI, 0, x64.RCX)
    assert(bytes_match(&b.bytes, &[0xf0, 0x48, 0x0f, 0xb1, 0x0f]))

    // lock xadd [rsi + 8], rax (64b) => f0 48 0f c1 46 08
    b = x64.new()
    x64.lock_xadd(&mut b, true, x64.RSI, 8, x64.RAX)
    assert(bytes_match(&b.bytes, &[0xf0, 0x48, 0x0f, 0xc1, 0x46, 0x08]))

    // Forward & backward jump patching + Win64 prologue (32B shadow space + 16B frame = 48B)
    b = x64.new()
    skip := x64.label(&mut b)
    x64.emit_prologue(&mut b, 16, true)      // push rbp (1) + mov rbp,rsp (3) + sub rsp,48 (4) = 8 bytes
    j_at := x64.jcc_lbl(&mut b, x64.CC_E, skip) // 0f 84 rel32 (6 bytes, j_at=10, next=14)
    x64.nop(&mut b)                          // 1 byte (off 14)
    x64.mark(&mut b, skip)                   // off 15
    x64.emit_epilogue(&mut b)                // mov rsp,rbp (3) + pop rbp (1) + ret (1)
    out := x64.finish(&mut b)
    assert(j_at == 10)
    assert(read_le32(&out, j_at) == 1)
    assert(i32(out[7]) == 48) // Win64 shadow (32) + 16 = 48
}

// --- 3. Target-Neutral ObjectModule Tests ---

@test fn object_module_arm64_relocs_type_descs_and_macho_dwarf() {
    mut m := om.new(.Arm64Macos)

    // Function 0: main -> calls helper, loads rodata address via AdrpAdd, returns
    mut main_buf := a64.new()
    a64.emit_prologue(&mut main_buf, 0)
    call_off := a64.byte_len(&main_buf)
    a64.emit(&mut main_buf, 0)               // patched by Arm64Call26
    adrp_off := a64.byte_len(&main_buf)
    a64.emit(&mut main_buf, 0)               // patched by Arm64AdrpAdd
    a64.emit(&mut main_buf, 0)
    a64.emit_epilogue(&mut main_buf)
    main_bytes := a64.to_bytes(&main_buf)
    main_start := om.append_text(&mut m, &main_bytes, 4)
    main_sym := om.add_symbol(&mut m, "main", .Function, .Text, main_start, main_bytes.len, true)
    m.entry_sym = main_sym

    // Function 1: helper (mov x0, #7; ret)
    mut h_buf := a64.new()
    a64.imm(&mut h_buf, a64.X0, 7)
    a64.ret(&mut h_buf)
    h_bytes := a64.to_bytes(&h_buf)
    h_start := om.append_text(&mut m, &h_bytes, 4)
    h_sym := om.add_symbol(&mut m, "helper", .Function, .Text, h_start, h_bytes.len, false)

    // Rodata blob + TYPE_DESC_TABLE
    msg: []u8 = [u8(72), u8(105), u8(0)]
    r_off := om.append_rodata(&mut m, &msg, 8)
    r_sym := om.add_symbol(&mut m, "str0", .RodataBlob, .Rodata, r_off, msg.len, false)

    _ := om.add_type_desc(&mut m, 42, "MyBox", h_sym, h_sym, -1, 16, 8)
    td_sym := om.materialize_type_desc_table(&mut m)
    assert(td_sym >= 0 && m.symbols[td_sym].kind == .TypeDescTable && m.symbols[td_sym].size == 32)

    // Wire relocations
    _ := om.add_reloc(&mut m, .Text, main_start + call_off, .Arm64Call26, h_sym, 0, 0)
    _ := om.add_reloc(&mut m, .Text, main_start + adrp_off, .Arm64AdrpAdd, r_sym, 0, a64.X1)

    // Debug info
    fidx := om.add_debug_file(&mut m, "test.ddr")
    om.add_func_range(&mut m, "main", fidx, 1, main_start, main_start + main_bytes.len)
    om.add_debug_line(&mut m, main_start, fidx, 1, 1)

    // Verify flatten_and_link resolves Call26, AdrpAdd, and TYPE_DESC_TABLE Abs64 relocs
    linked := om.flatten_and_link(&m, 432, 0x1000001b0)
    assert(linked.ok)
    expected_bl: i64 = i64(0x94000000) + i64((h_start - (main_start + call_off)) / 4).bit_and(67108863)
    assert(read_le32(&linked.text, main_start + call_off) == expected_bl)
    td_off := linked.rodata_offset + m.symbols[td_sym].offset
    assert(read_le64(&linked.text, td_off) == 0x1000001b0 + i64(h_start))
    assert(read_le64(&linked.text, td_off + 8) == 0x1000001b0 + i64(h_start))
    assert(read_le64(&linked.text, td_off + 16) == 0)
    assert(read_le32(&linked.text, td_off + 24) == 16)
    assert(read_le32(&linked.text, td_off + 28) == 8)

    // Emit both plain and DWARF Mach-O images
    cfg := macho.default_config()
    signer := macho.serial_signer()
    img := om.emit_macho(&m, &cfg, &signer, false, "dunder-test", ".", "test.ddr")
    assert(img.len > 64 && read_le32(&img, 0) == i64(0xfeedfacf))

    dbg_img := om.emit_macho(&m, &cfg, &signer, true, "dunder-test", ".", "test.ddr")
    assert(dbg_img.len > img.len && read_le32(&dbg_img, 0) == i64(0xfeedfacf))
}

@test fn object_module_x86_merge_elf_pe_and_wasm_sigs() {
    // Build two per-function x86_64 fragments and merge them into a single ObjectModule
    mut f0 := om.new(.X86_64Linux)
    mut b0 := x64.new()
    x64.emit_prologue(&mut b0, 0, false)
    rip_off := x64.lea_rip(&mut b0, x64.RAX, -1)
    x64.emit_epilogue(&mut b0)
    t0 := om.append_text(&mut f0, &b0.bytes, 16)
    f0.entry_sym = om.add_symbol(&mut f0, "_start", .Function, .Text, t0, b0.bytes.len, true)
    r0 := om.append_rodata(&mut f0, &[u8(1), u8(2), u8(3), u8(4)], 8)
    rsym0 := om.add_symbol(&mut f0, "c0", .RodataBlob, .Rodata, r0, 4, false)
    _ := om.add_reloc(&mut f0, .Text, t0 + rip_off, .X86RipDisp32, rsym0, 0, 0)

    mut f1 := om.new(.X86_64Linux)
    mut b1 := x64.new()
    x64.mov_imm(&mut b1, true, x64.RAX, 42)
    x64.ret(&mut b1)
    t1 := om.append_text(&mut f1, &b1.bytes, 16)
    _ := om.add_symbol(&mut f1, "answer", .Function, .Text, t1, b1.bytes.len, false)

    mut merged := om.new(.X86_64Linux)
    _ := om.merge_fragment(&mut merged, &f0)
    f1_base := om.merge_fragment(&mut merged, &f1)
    assert(f1_base >= 16 && f1_base % 16 == 0)
    assert(om.find_symbol(&merged, "_start") >= 0)
    assert(om.find_symbol(&merged, "answer") >= 0)

    // Verify X86RipDisp32 patched accurately across text -> rodata
    linked := om.flatten_and_link(&merged, 4096, 0x401000)
    assert(linked.ok)
    c0_sym := om.find_symbol(&merged, "c0")
    c0_abs := linked.rodata_offset + merged.symbols[c0_sym].offset
    assert(read_le32(&linked.text, rip_off) == i64(c0_abs - (rip_off + 4)))

    // Emit Linux x86_64 ELF (plain + DWARF)
    ecfg := elf.default_config()
    elf_img := om.emit_elf(&merged, &ecfg, false, "dunder-test", ".", "test.ddr")
    assert(elf_img.len > 64 && i32(elf_img[0]) == 0x7f && i32(elf_img[1]) == 69 && i32(elf_img[2]) == 76 && i32(elf_img[3]) == 70)
    assert(i32(elf_img[18]) == 62) // EM_X86_64

    // Emit Windows x86_64 PE (MZ + PE header)
    mut win := om.new(.X86_64Windows)
    mut wb := x64.new()
    x64.mov_imm(&mut wb, true, x64.RAX, 0)
    x64.ret(&mut wb)
    _ := om.append_text(&mut win, &wb.bytes, 16)
    _ := om.add_import(&mut win, &native_imports.symbol_spec("kernel32", "ExitProcess"))
    pcfg := pe.default_config()
    pe_img := om.emit_pe(&win, &pcfg)
    assert(pe_img.len > 256 && i32(pe_img[0]) == 77 && i32(pe_img[1]) == 90) // "MZ"

    // Verify deduplicated WASM signature table
    mut wm := om.new(.Wasm32)
    s0 := om.add_wasm_sig(&mut wm, &[om.WasmValType.I64, om.WasmValType.I32], &[om.WasmValType.I64])
    s1 := om.add_wasm_sig(&mut wm, &[om.WasmValType.I64, om.WasmValType.I32], &[om.WasmValType.I64])
    s2 := om.add_wasm_sig(&mut wm, &[om.WasmValType.F64], &[om.WasmValType.I32])
    assert(s0 == 0 && s1 == 0 && s2 == 1 && wm.wasm_fn_types.len == 2)
}
