import ..selfhost.driver.budget

@test fn cpu_max_and_cfs_quotas_round_up_when_fractional_and_ignore_unlimited() {
    assert(budget.parse_cpu_max("") == 0)
    assert(budget.parse_cpu_max("max 100000\n") == 0)
    assert(budget.parse_cpu_max("100000 100000\n") == 1)
    assert(budget.parse_cpu_max("150000 100000\n") == 2)
    assert(budget.parse_cpu_max("400000  100000\n") == 4)
    assert(budget.parse_cpu_max("10000 100000\n") == 1)
    assert(budget.parse_cpu_max("bad 100000\n") == 0)

    assert(budget.parse_cfs_quota("-1\n", "100000\n") == 0)
    assert(budget.parse_cfs_quota("0", "100000") == 0)
    assert(budget.parse_cfs_quota("250000\n", "100000\n") == 3)
    assert(budget.parse_cfs_quota("50000", "100000") == 1)

    assert(budget.parse_cpu_list("") == 0)
    assert(budget.parse_cpu_list("0\n") == 1)
    assert(budget.parse_cpu_list("0-9\n") == 10)
    assert(budget.parse_cpu_list("0,2-5,8\n") == 6)
    assert(budget.parse_cpu_list("5-2\n") == 0)
    assert(budget.parse_cpu_list("0-999\n") == budget.max_jobs())
}

@test fn jobs_flag_validates_range_with_consistent_contract() {
    ok1 := budget.parse_jobs_flag("1")
    assert(ok1.ok && ok1.jobs == 1 && ok1.error == "")
    okmax := budget.parse_jobs_flag("256")
    assert(okmax.ok && okmax.jobs == 256)
    for bad in ["", "0", "-1", "257", "abc"] {
        res := budget.parse_jobs_flag(bad)
        assert(!res.ok && res.error == "--jobs must be an integer from 1 to 256")
    }
}

@test fn budget_resolution_honors_host_overrides_child_caps_and_serial_entries() {
    host := budget.host_cpus(0)
    assert(host >= 1 && host <= budget.max_jobs())

    // Explicit --jobs takes precedence over default override and DUNDER_CHILD_JOBS.
    explicit := budget.resolve_jobs_for(0, 3, true, 0, true, 1)
    assert(explicit.ok && explicit.jobs == 3)

    // Serial entries accept --jobs 1 and reject --jobs > 1, defaulting to 1.
    serial_auto := budget.resolve_jobs_for(0, 0, false, 1, false, 4)
    assert(serial_auto.ok && serial_auto.jobs == 1)
    serial_one := budget.resolve_jobs_for(0, 1, true, 1, false, 0)
    assert(serial_one.ok && serial_one.jobs == 1)
    serial_two := budget.resolve_jobs_for(0, 2, true, 1, false, 0)
    assert(!serial_two.ok && serial_two.error == "this compiler entry supports only --jobs 1")

    // Default override (e.g. driver test fixture) stays independent of child env.
    fixture := budget.resolve_jobs_for(0, 0, false, 4, true, 1)
    assert(fixture.ok && fixture.jobs == 4)

    // Automatic compiler default uses host CPUs, clamped down by nested child budget.
    auto := budget.resolve_jobs_for(0, 0, false, 0, true, 0)
    assert(auto.ok && auto.jobs == host)
    if host >= 2 {
        capped := budget.resolve_jobs_for(0, 0, false, 0, true, 1)
        assert(capped.ok && capped.jobs == 1)
    }
    huge_cap := budget.resolve_jobs_for(0, 0, false, 0, true, 512)
    assert(huge_cap.ok && huge_cap.jobs == host)
}

@test fn worker_and_test_slots_avoid_oversubscription() {
    assert(budget.worker_slots(1, false) == 0)
    assert(budget.worker_slots(1, true) == 0)
    assert(budget.worker_slots(4, true) == 3)
    assert(budget.worker_slots(4, false) == 4)

    assert(budget.test_process_slots(8, 0) == 0)
    assert(budget.test_process_slots(8, 3) == 3)
    assert(budget.test_process_slots(8, 20) == 8)
    assert(budget.test_process_slots(256, 200) == budget.max_test_processes())

    assert(budget.nested_child_jobs(10, 1) == 10)
    assert(budget.nested_child_jobs(10, 4) == 2)
    assert(budget.nested_child_jobs(4, 16) == 1)
}

fn main() {}
