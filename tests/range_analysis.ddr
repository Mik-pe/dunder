import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_pass as pass
import ..selfhost.opt_range as range_analysis
import ..selfhost.opt_verify as verify
import ..selfhost.lexer

fn body(source: string, ret: i32) -> ir.Function {
    input := lexer.scan("values other index limit " + source, false)
    names: []string = ["values", "other", "index", "limit"]
    types: []i32 = [21, 20, 1, 1]; positions: []i32 = [0, 1, 2, 3]
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 4, input.kinds.len - 2, &names, &types, &positions, ret))
    assert(verify.validate(&f, false)); f
}
fn same(f: &ir.Function, old: &ir.Function) {
    assert(f.nodes.kinds.len == old.nodes.kinds.len && f.local_types.len == old.local_types.len)
    assert(f.supported == old.supported && f.root == old.root && f.ret == old.ret && f.params == old.params)
    assert(f.visits == old.visits && f.rewrites == old.rewrites && f.budget_exhausted == old.budget_exhausted)
    for i in 0..f.nodes.kinds.len {
        assert(f.nodes.kinds[i] == old.nodes.kinds[i] && f.nodes.types[i] == old.nodes.types[i])
        assert(f.nodes.left[i] == old.nodes.left[i] && f.nodes.right[i] == old.nodes.right[i] && f.nodes.third[i] == old.nodes.third[i] && f.nodes.next[i] == old.nodes.next[i])
        assert(f.nodes.values[i] == old.nodes.values[i] && f.nodes.locals[i] == old.nodes.locals[i] && f.nodes.starts[i] == old.nodes.starts[i])
        assert(f.nodes.effects[i] == old.nodes.effects[i] && f.nodes.proofs[i] == old.nodes.proofs[i])
    }
    for i in 0..f.local_types.len {
        assert(f.local_names[i] == old.local_names[i] && f.local_types[i] == old.local_types[i])
        assert(f.local_mutable[i] == old.local_mutable[i] && f.local_param[i] == old.local_param[i] && f.local_at[i] == old.local_at[i])
    }
}
fn proves(work: &mut range_analysis.Workspace, f: &mut ir.Function, reads: i32, stores: i32) {
    before := f
    old_proofs := f.nodes.proofs; old_rewrites := f.rewrites
    assert(range_analysis.analyze_into(&mut work, &f))
    assert(range_analysis.status(&work) == 1)
    same(&f, &before)
    assert(range_analysis.read_count(&work) == reads && range_analysis.store_count(&work) == stores)
    var actual_reads := 0; var actual_stores := 0
    for i in 0..f.nodes.kinds.len {
        if range_analysis.produced(&work, i) {
            if f.nodes.kinds[i] == 6 { actual_reads = actual_reads + 1 }
            else { assert(f.nodes.kinds[i] == 18); actual_stores = actual_stores + 1 }
        }
    }
    assert(actual_reads == reads && actual_stores == stores)
    range_analysis.apply(&mut work, &mut f)
    assert(range_analysis.status(&work) == 2 && verify.validate(&f, true))
    assert(f.rewrites == old_rewrites + reads + stores + range_analysis.arithmetic_count(&work))
    for i in 0..f.nodes.kinds.len {
        mask := range_analysis.proof_mask(&work, i)
        assert(range_analysis.produced(&work, i) == (mask.bit_and(2) != 0))
        assert(f.nodes.proofs[i] == old_proofs[i].bit_or(mask))
    }
}

@test fn stable_mutable_shapes_prove_sort_reverse_and_guarded_loops_with_typed_proof_masks() {
    sources := [
        "{for cursor in 1..values.len{item:=values[cursor];var hole:=cursor;while hole>0&&values[hole-1]>item{values[hole]=values[hole-1];hole=hole-1};values[hole]=item}}",
        "{var left:=0;var right:=values.len-1;while left<right{item:=values[left];values[left]=values[right];values[right]=item;left=left+1;right=right-1}}",
        "{var cursor:=0;while cursor<values.len{values[cursor]=values[cursor]+1;cursor=cursor+1}}",
        "{for cursor in 0..values.len{values[cursor]=values[cursor]+1}}",
        "{if values.len>0{values[0]=values[0]+1}}",
        "{if index>=0&&index<values.len{values[index]=other[0]}}",
    ]
    expected_reads := [3, 2, 1, 1, 1, 0]; expected_stores := [2, 2, 1, 1, 1, 1]
    var work := range_analysis.new()
    for i in 0..sources.len {
        var f := body(sources[i], 0)
        proves(&mut work, &mut f, expected_reads[i], expected_stores[i])
    }
}

@test fn snapshots_nested_loops_break_continue_returns_and_shortcircuit_joins_are_preserved() {
    sources := [
        "{var high:=values.len;for cursor in 0..high{high=high+1;values[cursor]=values[cursor]+1}}",
        "{for row in 0..values.len{for column in 0..values.len{if column==1{continue};if column==3{break};values[column]=values[row]}}}",
        "{var cursor:=0;while cursor<values.len{if cursor==2{cursor=cursor+1;continue};values[cursor]=values[cursor]+1;if cursor==4{break};cursor=cursor+1}}",
        "{for cursor in 0..values.len{if cursor==2{continue};values[cursor]=values[cursor]+1}}",
        "{if index<0||index>=values.len{return 0};values[index]}",
        "{if !(index>=0&&index<values.len){return 0};values[index]}",
        "{if false{values[index]=other[index]};return}",
        "{return;values[index]=other[index]}",
        "{for cursor in 5..2{values[cursor]=other[cursor]}}",
    ]
    var work := range_analysis.new()
    for i in 0..sources.len {
        var ret := 0; if i == 4 || i == 5 { ret = 2 }
        var f := body(sources[i], ret)
        var reads := 1; var stores := 1
        if i == 4 || i == 5 { stores = 0 }
        if i >= 6 { reads = 0; stores = 0 }
        proves(&mut work, &mut f, reads, stores)
    }
}

@test fn failed_first_iteration_guesses_wrong_roots_and_unsafe_offsets_produce_no_proofs() {
    sources := [
        "{values[index]=values[index]}",
        "{for cursor in -1..values.len{values[cursor]=0}}",
        "{for cursor in 0..values.len{values[cursor+1]=values[cursor-1]}}",
        "{for cursor in 0..values.len{var hole:=cursor;while hole>0{hole=hole+1;values[hole]=0}}}",
        "{var cursor:=0;while cursor<values.len{values[cursor]=0;cursor=-1}}",
        "{var cursor:=0;while cursor<values.len{if limit>0{cursor=-1;continue};values[cursor]=0;cursor=cursor+1}}",
        "{for cursor in 0..values.len{var target:=cursor;if index>0{target=-1};values[target]=0}}",
        "{if index>=0&&index<other.len{values[index]=0}}",
        "{for cursor in 0..limit{values[cursor]=0}}",
    ]
    var work := range_analysis.new()
    for source in sources { var f := body(source, 0); proves(&mut work, &mut f, 0, 0) }
    var f := body("{for cursor in 0..other.len{values[cursor]=other[cursor]}}", 0)
    proves(&mut work, &mut f, 1, 0)
}

@test fn nested_invariants_are_recomputed_and_break_exits_do_not_inherit_body_guards() {
    var work := range_analysis.new()
    var f := body("{var outer:=0;while outer<values.len{var inner:=outer;while inner>=0&&inner<values.len{values[inner]=0;inner=inner+1};outer=outer+1}}", 0)
    proves(&mut work, &mut f, 0, 1)
    f = body("{var outer:=0;while outer<2{var inner:=outer;while inner<values.len{values[inner]=0;inner=-1};outer=outer+1}}", 0)
    proves(&mut work, &mut f, 0, 0)
    f = body("{var cursor:=values.len;for cursor in 0..cursor{values[cursor]=0}}", 0)
    proves(&mut work, &mut f, 0, 1)
    f = body("{for cursor in 0..values.len{var target:=cursor;while target>0{target=target-1;if index>0{target=-1;break};values[target]=0};values[target]=0}}", 0)
    proves(&mut work, &mut f, 0, 1)
    f = body("{if index>=0&&index<values.len{return values[index]};values[index]}", 2)
    proves(&mut work, &mut f, 1, 0)
    f = body("{if values[index]>0&&index>=0&&index<values.len{values[index]=0}}", 0)
    proves(&mut work, &mut f, 0, 1)
}

@test fn affine_offsets_obey_both_nonnegative_and_exact_array_upper_bounds() {
    var work := range_analysis.new()
    for low in -2..4 {
        for offset in -2..3 {
            source := "{for cursor in " + low.str() + "..values.len{values[cursor+(" + offset.str() + ")]=0}}"
            var f := body(source, 0); var stores := 0
            if low + offset >= 0 && offset <= 0 { stores = 1 }
            proves(&mut work, &mut f, 0, stores)
        }
    }
}

@test fn budget_failure_is_transactional_including_late_replay_and_workspace_reuse() {
    source := "{for cursor in 1..values.len{item:=values[cursor];var hole:=cursor;while hole>0&&values[hole-1]>item{values[hole]=values[hole-1];hole=hole-1};values[hole]=item}}"
    var f := body(source, 0); old := f; var work := range_analysis.new()
    assert(range_analysis.analyze_into(&mut work, &f)); spent := range_analysis.units(&work)
    assert(spent > 0 && spent <= 131072)
    for allowance in [0, 1, spent / 2, spent - 1] {
        range_analysis.set_budget(&mut work, allowance)
        assert(!range_analysis.analyze_into(&mut work, &f) && range_analysis.status(&work) == 3)
        assert(range_analysis.read_count(&work) == 0 && range_analysis.store_count(&work) == 0)
        for node in 0..f.nodes.kinds.len { assert(!range_analysis.produced(&work, node)) }
        same(&f, &old)
    }
    range_analysis.set_budget(&mut work, 131072)
    proves(&mut work, &mut f, 3, 2)
    for round in 0..3 {
        f = body("{if index>=0&&index<values.len{values[index]=0}}", 0)
        proves(&mut work, &mut f, 0, 1)
        f = body(source, 0); proves(&mut work, &mut f, 3, 2)
        f = body("{if false{values[index]=0}}", 0); proves(&mut work, &mut f, 0, 0)
    }
}

@test fn malformed_and_future_operations_are_distinct_from_budget_failure() {
    original := body("{if index>=0&&index<values.len{values[index]=values[index]+1}}", 0)
    var work := range_analysis.new()
    for mode in 0..6 {
        var f := original
        if mode == 0 { f.nodes.kinds[f.root] = 20 }
        if mode == 1 { f.nodes.effects[f.root] = 32 }
        if mode == 2 { f.local_mutable[0] = true }
        if mode == 3 { removed := f.nodes.left.pop() }
        if mode == 4 { f.nodes.left[f.root] = f.root }
        if mode == 5 { f.local_types[0] = 22 }
        before := f
        assert(!range_analysis.analyze_into(&mut work, &f) && range_analysis.status(&work) == 4)
        // Check the unaffected arrays even for the deliberately shortened one.
        assert(f.nodes.proofs.len == before.nodes.proofs.len && f.rewrites == before.rewrites)
        for i in 0..f.nodes.proofs.len { assert(f.nodes.proofs[i] == before.nodes.proofs[i] && f.nodes.kinds[i] == before.nodes.kinds[i]) }
    }
    var f := original; proves(&mut work, &mut f, 1, 1)
}

@test fn proof_placement_accepts_only_index_reads_or_exclusive_element_stores() {
    original := body("{if index>=0&&index<values.len{values[index]=other[index]}}", 0)
    for kind in [5, 6, 11, 13, 18] {
        var f := original; var found := false
        for i in 0..f.nodes.kinds.len { if f.nodes.kinds[i] == kind { f.nodes.proofs[i] = 2; found = true; break } }
        if found { assert(verify.validate(&f, true) == (kind == 6 || kind == 18)) }
    }
    var f := original
    for i in 0..f.nodes.kinds.len { if f.nodes.kinds[i] == 6 || f.nodes.kinds[i] == 18 { f.nodes.proofs[i] = 2 } }
    assert(verify.validate(&f, true) && !verify.validate(&f, false))
    f.local_types[0] = 20; assert(!verify.validate(&f, true))
}

@test fn analysis_preserves_prior_safe_proofs_and_skips_non_array_functions() {
    input := lexer.scan("{var result:i64=0;for cursor in 0..3{result=result+1};result}", false)
    names: []string = []; types: []i32 = []; positions: []i32 = []
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 0, input.kinds.len - 2, &names, &types, &positions, 2))
    pass.run(&mut f); old := f
    var work := range_analysis.new(); range_analysis.set_budget(&mut work, 0)
    assert(range_analysis.analyze_into(&mut work, &f) && range_analysis.units(&work) == 0)
    range_analysis.apply(&mut work, &mut f); same(&f, &old)
}
