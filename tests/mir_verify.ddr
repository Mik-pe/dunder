import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify

fn leaders(f: &mir.Function) -> []bool {
    var out: []bool = []; for flag in f.leaders { out.push(flag) }; out
}
fn unchanged(f: &mir.Function, expected: &[]bool) {
    assert(f.leaders.len == expected.len)
    for at in 0..expected.len { assert(f.leaders[at] == expected[at]) }
}
@test fn verifier_seen_scratch_preserves_leaders_across_success_failure_and_sizes() {
    var work := verify.new_work(); var f := mir.new(); sites: []i32 = []
    for count in [1, 64, 2, 257, 0, 17] {
        var code := arm.new()
        for value in 0..count { arm.imm(&mut code, 0, i64(value)) }
        arm.emit(&mut code, 3596551104)
        assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
        expected := leaders(&f); original_optimizable := f.optimizable
        assert(verify.verify_into(&mut f, &mut work) && f.verified)
        unchanged(&f, &expected)
        assert(work.seen.len == f.kinds.len)
        for flag in work.seen { assert(flag) }

        // Early rejection after some seen bits are written must not touch the
        // function metadata, and the next call must reset that partial scratch.
        f.order.push(0)
        assert(!verify.verify_into(&mut f, &mut work) && !f.verified)
        assert(f.optimizable == original_optimizable); unchanged(&f, &expected)
        removed := f.order.pop()
        assert(verify.verify_into(&mut f, &mut work)); unchanged(&f, &expected)

        // This fails after the complete seen pass, during exact CFG checking.
        last := f.edge_kinds.len - 1; old_kind := f.edge_kinds[last]
        f.edge_kinds[last] = 5
        assert(!verify.verify_into(&mut f, &mut work) && !f.verified)
        assert(f.optimizable == original_optimizable); unchanged(&f, &expected)
        f.edge_kinds[last] = old_kind
        assert(verify.verify_into(&mut f, &mut work)); unchanged(&f, &expected)
    }
}
@test fn invalid_expression_stack_changes_only_the_scalar_optimization_result() {
    var code := arm.new(); arm.pop(&mut code, 0); arm.emit(&mut code, 3596551104)
    var f := mir.new(); sites: []i32 = []; var work := verify.new_work()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(f.optimizable); expected := leaders(&f)
    assert(verify.verify_into(&mut f, &mut work) && f.verified && !f.optimizable)
    unchanged(&f, &expected)
    assert(verify.verify_into(&mut f, &mut work) && f.verified && !f.optimizable)
    unchanged(&f, &expected)
}
