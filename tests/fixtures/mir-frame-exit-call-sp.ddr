// Independent raw-call observer: GP preservation and cell synchronization do
// not preserve an unknown callee's observation of its incoming call SP.
import ...selfhost.arm64 as arm
import ...selfhost.ffi_arm64 as abi
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_opt as opt
import ...selfhost.mir_memory as memory
import ...selfhost.macho
import sys

fn main() {
    var code := arm.new(); entry := arm.label(&mut code); called := arm.label(&mut code)
    integer := arm.label(&mut code); boolean := arm.label(&mut code); text := arm.label(&mut code)
    write := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code)
    assertion := arm.label(&mut code); io := arm.label(&mut code)
    arm.imm(&mut code, 25, 333)
    arm.branch(&mut code, entry, 1); arm.imm(&mut code, 8, 0); arm.branch(&mut code, integer, 1); arm.exit(&mut code, 0)
    arm.mark(&mut code, called); call_frame := arm.prologue(&mut code); arm.frame(&mut code, call_frame, 0)
    if sys.arg(3) == "gp" { arm.mov(&mut code, 0, 25) }
    else {
        abi.load(&mut code, 10, 29, 0, 8) // Saved FP is the caller's FP.
        arm.emit(&mut code, 2432696320 + 16 * 1024 + 29 * 32 + 11) // Own FP+16 is incoming call SP.
        arm.emit(&mut code, 3405774848 + 11 * 65536 + 10 * 32) // Caller FP - call SP.
    }
    arm.ret(&mut code)
    first := code.words.len; labels := code.labels.len; relocations := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1)
    arm.imm(&mut code, 0, 13); arm.store(&mut code, 0, 0)
    for repeat in 0..8 { arm.load(&mut code, 0); arm.store(&mut code, 0, 0) }
    arm.branch(&mut code, called, 1); arm.mov(&mut code, 2, 0)
    for repeat in 0..8 { arm.load(&mut code, 0); arm.store(&mut code, 0, 0) }
    arm.mov(&mut code, 0, 2); arm.ret(&mut code)
    var sites: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, first, labels, relocations, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    var work := opt.new(); var prepared := false
    if sys.arg(2) == "raw" { prepared = opt.analyze_into(&mut work, &f) }
    else if sys.arg(2) == "memory" { context := memory.for_source_producer(true); prepared = opt.analyze_with_context(&mut work, &f, &context) }
    else { assert(sys.arg(2) == "off") }
    if prepared { opt.apply(&mut work, &mut f); assert(verify.verify(&mut f)) }
    var output := lower.new(); assert(lower.prepare(&mut output, &f, &code, &sites))
    lower.commit_code(&mut output, &mut code); lower.commit_imports(&mut output, &mut sites)
    arm.runtime(&mut code, integer, boolean, text, write, overflow, zero, assertion, io)
    bytes := arm.finish(&mut code); image := macho.image(&bytes)
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print(prepared)
}
