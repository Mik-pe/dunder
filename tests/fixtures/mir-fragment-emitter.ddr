// Final worker objects, delayed cache writes and restored fragments all enter
// the same ordered linker. The provisional frontend Code keeps advancing.
import ...selfhost.arm64 as arm
import ...selfhost.fragments as fragments
import ...selfhost.cache_io
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_link as link
import ...selfhost.mir_value_prop as values
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import ..mir_object_support as support
import std.parse as decimal
import sys

fn closed(code:&arm.Code, begin:fragments.Start, entry:i32)->lower.FragmentRange {
    lower.FragmentRange {first_word:begin.words,word_end:code.words.len,first_label:begin.labels,label_end:code.labels.len,
        first_reloc:begin.relocations,reloc_end:code.at.len,first_import:0,import_end:0,entry:entry}
}
fn prefix(code:&mut arm.Code,padding:i32) {
    entry:=arm.label(&mut code);helper:=arm.label(&mut code);failure:=arm.label(&mut code)
    assert(entry==0 && helper==1 && failure==2)
    arm.branch(&mut code,entry,1);arm.exit(&mut code,0);arm.mark(&mut code,failure);arm.exit(&mut code,104)
    if padding!=0 {unused:=arm.label(&mut code);arm.emit(&mut code,3573751839)}
}
fn first_body(code:&mut arm.Code) {
    arm.mark(&mut code,0);frame:=arm.prologue(&mut code);arm.frame(&mut code,frame,0)
    done:=arm.label(&mut code);unused:=arm.label(&mut code)
    arm.branch(&mut code,1,1);arm.imm(&mut code,1,42);arm.emit(&mut code,3942711327);arm.branch(&mut code,2,3)
    arm.branch(&mut code,done,0);arm.mark(&mut code,done);arm.imm(&mut code,0,0);arm.ret(&mut code)
    end:=arm.label(&mut code);arm.mark(&mut code,end)
}
fn second_body(code:&mut arm.Code) {
    arm.mark(&mut code,1);frame:=arm.prologue(&mut code);arm.frame(&mut code,frame,0)
    arm.imm(&mut code,1,7);arm.mov(&mut code,2,1);arm.mov(&mut code,3,2)
    arm.imm(&mut code,4,35);arm.emit(&mut code,2332229760);arm.ret(&mut code)
    end:=arm.label(&mut code);arm.mark(&mut code,end);unused:=arm.label(&mut code)
}
fn take(f:&mut mir.Function,code:&arm.Code,begin:fragments.Start,entry:i32) {
    none:[]i32=[]
    assert(lift.lift(&mut f,&code,begin.words,begin.labels,begin.relocations,&none,0))
    assert(lift.own_entry(&mut f,&code,entry) && verify.verify(&mut f))
}
fn serial(f:&mir.Function,code:&mut arm.Code) {
    var work:=lower.new();var none:[]i32=[]
    assert(lower.prepare(&mut work,&f,&code,&none));lower.commit_code(&mut work,&mut code);lower.commit_imports(&mut work,&mut none)
}
fn deps()->fragments.Dependencies {
    var d:=fragments.new_dependencies();assert(fragments.record_dependency(&mut d,8,3))
    assert(fragments.record_dependency(&mut d,2,5));assert(fragments.record_dependency(&mut d,8,2));d
}
fn save_live(code:&arm.Code,begin:fragments.Start,path:string,key:string,extended:bool) {
    if extended {d:=deps();assert(fragments.save_with_dependencies(&code,begin,3,path,key,&d,12))}
    else {fragments.save(&code,begin,3,path,key);assert(sys.metadata(path).is_file)}
}
fn save_object(object:&lower.FunctionObject,r:&lower.FragmentRange,path:string,key:string,extended:bool) {
    if extended {d:=deps();assert(fragments.save_object_with_dependencies(&object,r.first_label,r.label_end,3,path,key,&d,12))}
    else {assert(fragments.save_object(&object,r.first_label,r.label_end,3,path,key))}
}
fn restore(code:&mut arm.Code,entry:i32,path:string,key:string,extended:bool) {
    if extended {var accepted:=fragments.new_dependencies();assert(fragments.restore_cached_with_dependencies(&mut code,3,entry,path,key,12,10,&mut accepted))
        assert(accepted.charged_words==10 && accepted.declarations.len==2 && accepted.declarations[0]==2 && accepted.declarations[1]==8)}
    else {assert(fragments.restore(&mut code,3,entry,path,key))}
}
fn image(code:&mut arm.Code,path:string) {
    var bytes:[]u8=[];none:[]i32=[]
    if code.platform==3 {abi:=wa.new();result:=wasm.image(&code,code.words.len,0,1,&abi);assert(result.ok);bytes=result.text}
    else if code.platform==2 {result:=x86.finish(&code,code.words.len,&none,&none);assert(result.ok);bytes=elf.image_for(&result.text,62)}
    else {text:=arm.finish(&mut code);if code.platform==0 {bytes=macho.image(&text)}else{bytes=elf.image(&text)}}
    assert(sys.write_u8(path,&bytes).ok && sys.make_executable(path).ok)
}
fn invalid_saves(path:string,key:string) {
    var code:=arm.new();prefix(&mut code,0);begin:=fragments.start(&code);first_body(&mut code)
    none:[]i32=[];r:=closed(&code,begin,0);var object:=lower.new_object()
    assert(lower.capture_verified_fragment(&mut object,&code,&none,&r))
    sentinel:="previous successful fragment";assert(sys.write_text(path,sentinel).ok)
    var d:=deps()
    for bad in 0..8 {
        var first:=r.first_label;var last:=r.label_end;var globals:=3;var wrong:=d;var fingerprint:=key;var limit:=12
        if bad==0 {first=first+1};if bad==1 {last=last-1};if bad==2 {last=last+1};if bad==3 {globals=first+1}
        if bad==4 {wrong.declarations[1]=wrong.declarations[0]};if bad==5 {wrong.charged_words=4097}
        if bad==6 {fingerprint="wrong key"};if bad==7 {limit=8}
        assert(!fragments.save_object_with_dependencies(&object,first,last,globals,path,fingerprint,&wrong,limit))
        if bad<4 || bad==6 {assert(!fragments.save_object(&object,first,last,globals,path,fingerprint))}
        read:=sys.read_text(path);assert(read.ok && read.value==sentinel)
    }
    lower.reset_object(&mut object);assert(!fragments.save_object(&object,r.first_label,r.label_end,3,path,key))
    imported:=code.words.len;arm.emit(&mut code,4244635648);arm.emit(&mut code,0)
    sites:[]i32=[imported*4];with_import:=closed(&code,begin,0)
    var including:=with_import;including.import_end=1
    assert(lower.capture_verified_fragment(&mut object,&code,&sites,&including))
    assert(!fragments.save_object(&object,r.first_label,r.label_end,3,path,key))
    assert(!fragments.save_object_with_dependencies(&object,r.first_label,r.label_end,3,path,key,&d,12))
    read:=sys.read_text(path);assert(read.ok && read.value==sentinel);print("objects=2")
}
fn main() {
    mode:=sys.arg(1);base:=sys.arg(2);parsed:=decimal.integer(sys.arg(3));assert(parsed.ok);platform:=i32(parsed.value)
    output:=sys.arg(4);extended:=sys.arg(5)=="inline";padding:=i32(decimal.integer(sys.arg(6)).value)
    key:=cache_io.digest("detached-fragment:"+platform.str())
    if mode=="invalid" {invalid_saves(base,key);return}
    var source:=arm.new_for(platform);prefix(&mut source,padding)
    var expected:=arm.new_for(platform);support.copy_code(&mut expected,&source)
    var coordinator:=link.new();none:[]i32=[];assert(link.begin(&mut coordinator,&source,&none))
    var a:=lower.new_object();var b:=lower.new_object();var f:=mir.new()
    begin_a:=fragments.start(&source)
    if mode=="restore" {restore(&mut source,0,base+".a",key,extended)}else{first_body(&mut source)}
    range_a:=closed(&source,begin_a,0)
    if mode!="restore" {
        take(&mut f,&source,begin_a,0);assert(lower.lower_into(&mut a,&f))
        first_body(&mut expected);serial(&f,&mut expected)
        save_live(&expected,begin_a,base+".serial.a",key,extended)
    }
    begin_b:=fragments.start(&source)
    if mode=="restore" {restore(&mut source,1,base+".b",key,extended)}else{second_body(&mut source)}
    range_b:=closed(&source,begin_b,1)
    if mode!="restore" {
        take(&mut f,&source,begin_b,1);var work:=values.new();assert(values.optimize_into(&mut work,&mut f))
        assert(values.rewritten(&work)>0 && values.deleted(&work)>0 && verify.verify(&mut f))
        assert(lower.lower_into(&mut b,&f));second_body(&mut expected);serial(&f,&mut expected)
        assert(lower.object_word_count(&b)<range_b.word_end-range_b.first_word)
        save_live(&expected,begin_b,base+".serial.b",key,extended)
    }
    // Future entry and callback-like/data labels are deliberately present at
    // capture/save time. They are not owned by either earlier object.
    future:=arm.label(&mut source);arm.mark(&mut source,future);callback:=arm.label(&mut source)
    arm.emit(&mut source,3573751839);arm.branch(&mut source,callback,20)
    if mode=="restore" {
        before:=source
        assert(lower.capture_verified_fragment(&mut b,&source,&none,&range_b))
        assert(lower.capture_verified_fragment(&mut a,&source,&none,&range_a));support.same_code(&before,&source)
        save_object(&a,&range_a,base+".roundtrip.a",key,extended);save_object(&b,&range_b,base+".roundtrip.b",key,extended)
    } else {
        save_object(&a,&range_a,base+".a",key,extended);save_object(&b,&range_b,base+".b",key,extended)
    }
    // No source or MIR arena is consulted by cache publication or linking.
    mir.reset(&mut f);source.words.clear();source.labels.clear();source.at.clear();source.target.clear();source.kinds.clear()
    assert(link.reserve_namespace(&mut coordinator,range_b.label_end,0))
    assert(link.append(&mut coordinator,&a,0) && link.append(&mut coordinator,&b,1))
    assert(link.seal_namespace(&mut coordinator,2) && link.finalize(&mut coordinator))
    var merged:=arm.new();var sites:[]i32=[]
    link.export_code(&mut coordinator,&mut merged);link.export_import_sites(&mut coordinator,&mut sites)
    if mode!="restore" {support.same_code(&expected,&merged)}
    if mode=="serial" {image(&mut expected,output)}else{assert(mode=="object" || mode=="restore");image(&mut merged,output)}
    print("objects=2")
}
