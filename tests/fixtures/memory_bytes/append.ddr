capability unsafe
import std.bytes as bytes
import std.sys as sys

fn pattern(index: i32) -> u8 { u8((index * 43 + 251) % 256) }

fn main() -> i32 {
    mut source: []u8 = []
    source.reserve(65579)
    for i in 0..65579 { source.push(pattern(i)) }
    mut output: []u8 = [17, 0, 255]
    bytes.extend_range(&mut output, &source, 3, source.len - 2)
    first_length := output.len
    assert(first_length == 65577)
    assert(output[0] == 17 && output[1] == 0 && output[2] == 255)
    for i in 3..output.len { assert(output[i] == pattern(i)) }

    // Keep spare capacity for the second bulk append, after testing growth above.
    output.reserve(output.len + source.len + 32)
    sys.bytes_extend(&mut output, &source, 7, source.len)
    assert(output.len == first_length + source.len - 7)
    for i in first_length..output.len { assert(output[i] == pattern(i - first_length + 7)) }
    previous := output.len
    bytes.append_utf8(&mut output, "A\0å雪")
    text: []u8 = [65, 0, 195, 165, 233, 155, 170]
    assert(output.len == previous + text.len)
    for i in 0..text.len { assert(output[previous + i] == text[i]) }
    sys.bytes_append_text(&mut output, "")
    sys.bytes_extend(&mut output, &source, source.len, source.len)
    assert(output.len == previous + text.len)
    for i in 0..source.len { assert(source[i] == pattern(i)) }
    0
}
