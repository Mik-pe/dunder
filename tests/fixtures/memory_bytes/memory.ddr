capability unsafe
import std.bytes as bytes
import std.sys as sys

fn pattern(index: i32) -> u8 { u8((index * 37 + 19) % 256) }

fn overlapping(shift: i32, backwards: bool) {
    count := 65573
    mut buffer: []u8 = []
    buffer.reserve(count + 32)
    for i in 0..(count + 32) { buffer.push(pattern(i)) }
    mut source := 3
    mut destination := source + shift
    if !backwards { source = source + shift; destination = 3 }
    unsafe {
        base := addr(&mut buffer[0])
        bytes.copy_memory(ptr(usize(base) + usize(destination)),
                          ptr(usize(base) + usize(source)), usize(count))
    }
    // This oracle reads the original pattern, never the mutated source region.
    for i in 0..buffer.len {
        mut original := i
        if i >= destination && i < destination + count { original = source + i - destination }
        assert(buffer[i] == pattern(original))
    }
}

fn main() -> i32 {
    // Wasm must not perform its usual zero-length memory.copy bounds check.
    unsafe {
        outside := ptr(usize(4294967295))
        sys.memory_copy(outside, ptr(0), usize(0))
        bytes.copy_memory(ptr(0), outside, usize(0))
        bytes.copy_memory(outside, outside, usize(0))
        assert(sys.memory_equal(outside, ptr(0), usize(0)))
        assert(bytes.equal_memory(ptr(0), outside, usize(0)))
    }

    count := 65573
    mut source: []u8 = []
    mut destination: []u8 = []
    source.reserve(count + 32); destination.reserve(count + 32)
    for i in 0..(count + 32) { source.push(pattern(i)); destination.push(166) }
    unsafe {
        input := addr(&source[3])
        output := addr(&mut destination[5])
        sys.memory_copy(output, input, usize(count))
        assert(bytes.equal_memory(output, input, usize(count)))
        assert(sys.memory_equal(input, output, usize(count)))
        sys.memory_copy(output, output, usize(count))
    }
    for i in 0..destination.len {
        mut expected: u8 = 166
        if i >= 5 && i < 5 + count { expected = pattern(i - 2) }
        assert(destination[i] == expected)
        assert(source[i] == pattern(i))
    }
    // A mismatch in the final partial word must be visible.
    destination[5 + count - 1] = u8(255 - i32(destination[5 + count - 1]))
    unsafe {
        assert(!sys.memory_equal(addr(&source[3]), addr(&destination[5]), usize(count)))
        assert(sys.memory_equal(addr(&source[3]), addr(&destination[5]), usize(count - 1)))
    }

    for shift in [1, 7, 8, 11] {
        overlapping(shift, true)
        overlapping(shift, false)
    }
    0
}
