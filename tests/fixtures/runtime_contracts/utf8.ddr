fn main() {
        text := "A\0߿ࠀ퟿￿𐀀􏿿åå🌍"
        bytes: []u8 = [65, 0, 127, 194, 128, 223, 191, 224, 160, 128, 237, 159, 191, 238, 128, 128, 239, 191, 191, 240, 144, 128, 128, 244, 143, 191, 191, 97, 204, 138, 195, 165, 240, 159, 140, 141]
        scalars := [65, 0, 127, 128, 2047, 2048, 55295, 57344, 65535, 65536, 1114111, 97, 778, 229, 127757]
        assert(text.len == bytes.len)
        mut i := 0
        for b in text.bytes() { assert(b == bytes[i]); i = i + 1 }
        assert(i == bytes.len)
        mut j := 0
        mut offset := 0
        for r in text.runes() {
            assert(i32(r) == scalars[j]); assert(rune(scalars[j]) == r)
            end := offset + r.str().len
            assert(text[offset..end] == r.str())
            offset = end; j = j + 1
        }
        assert(offset == bytes.len); assert(j == scalars.len)
        print(42)
    }