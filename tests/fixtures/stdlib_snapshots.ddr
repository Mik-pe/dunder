capability unsafe
import ...stdlib.map as map
import ...stdlib.set as set
import ...stdlib.json as json
import ...stdlib.bytes as bytes
import ...stdlib.text as text

fn string_identity(value: string) -> i64 { unsafe { load_i64(addr(&value)) } }
fn byte_identity(value: []u8) -> usize { unsafe { usize(addr(&value[0])) } }

fn main() {
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, "{\"n\":42}")
    doc := json.Doc::parse_bytes(raw.clone())
    assert(doc.ok && byte_identity(doc.input) != byte_identity(raw))
    raw[5] = b'9'
    assert(doc.get_i64(doc.root, "n").value == 42)
    assert(raw[5] == b'9')

    mut table := map.Map<string, i64>::new()
    table.put("kept-" + 42.str(), 42)
    names := table.keys()
    table.clear()
    assert(names.len == 1 && names[0] == "kept-42")

    mut values := set.Set<string>::new()
    assert(values.insert("kept-" + 7.str()))
    items := values.values()
    values.clear()
    assert(items.len == 1 && items[0] == "kept-7")

    unchanged := "shared-" + 42.str()
    trimmed := text.trim(unchanged)
    assert(trimmed == unchanged && string_identity(trimmed) == string_identity(unchanged))
    parts := text.split(unchanged, "")
    assert(parts.len == 1 && string_identity(parts[0]) == string_identity(unchanged))
    print("stdlib snapshots ok")
}
