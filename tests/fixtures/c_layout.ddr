capability unsafe
@extern("c","strlen") unsafe fn strlen(s:ptr)->usize
@c_layout struct Nested { a:u8, b:u16 }
@c_layout struct Thing { tag:u8, x:u32, next:ptr, nested:Nested, arr:[u8;4] }
fn replace(n: &mut Nested) { n = Nested { a: 6, b: 25 } }
fn fill(a: &mut [u8;4]) { a = [9,8,7,6] }
fn main() {
    unsafe {
        assert(size_of(Thing) == 24)
        assert(align_of(Thing) == 8)
        var r:Thing = zeroed()
        r.x = 4026531841
        r.nested.b = 61234
        r.arr[3] = 248
        r.next = cstr("hello")
        assert(strlen(r.next) == 5)
        p := addr(&mut r)
        assert(load_u32(ptr(usize(p) + 4)) == 4026531841)
        assert(load_u16(ptr(usize(p) + 18)) == 61234)
        assert(load_u8(ptr(usize(p) + 23)) == 248)
        clone := r
        r.nested.b = 10
        assert(clone.nested.b == 61234)
        var a := Thing { tag:3, x:42, next:ptr(0), nested:Nested { a:8,b:555 }, arr:[1,2,3,4] }
        replace(ref_at(addr(&mut r.nested)))
        assert(r.nested.b == 25)
        replace(&mut r.nested)
        assert(r.nested.a == 6)
        fill(&mut r.arr)
        assert(r.arr[0] == 9 && r.arr[3] == 6)
        fill(ref_at(addr(&mut r.arr)))
        assert(r.arr[1] == 8)
        var standalone: [u8;4] = [0;4]
        fill(&mut standalone)
        assert(standalone[2] == 7)
        print(a.nested.b)
        print(a.arr[1])
    }
}
