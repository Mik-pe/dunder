struct Pair { first: i64, label: string }

fn main() -> i32 {
    for i in 0..5 {
        mut value := Pair { first: i64(i), label: "ok" }
        snapshot := value.clone()
        value.first = -1
        assert(snapshot.first == i64(i) && snapshot.label == "ok")
    }
    print(42)
    return 17
}
