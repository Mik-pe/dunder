capability filesystem, unsafe, stdio
import std.fs
import std.path
import sys
fn main() {
    d := fs.temp_dir("fil-åäö-")
    assert(d.ok)
    defer { _ := fs.remove_all(d.value) }
    file := path.join(d.value, "en snöfil.ddr")
    assert(sys.write_text(file, "fn main() { print(42) }").ok)
    assert(sys.append_text(file, "\n").ok)
    assert(sys.read_text(file).value == "fn main() { print(42) }\n")
    info := sys.metadata(file)
    assert(info.ok && info.is_file && info.size == 24)
    items := fs.list_dir(d.value).unwrap()
    assert(items.len == 1 && items[0] == "en snöfil.ddr")
    mut reader := fs.FileReader::open(file).unwrap()
    assert(reader.metadata().unwrap().size == info.size)
    mut data: []u8 = []
    assert(reader.read(&mut data, 16).unwrap() == 16)
    assert(reader.close().is_ok())
    assert(sys.same_file(file, fs.realpath(file).value))
    moved := path.join(d.value, "ny snöfil.ddr")
    assert(sys.rename(file, moved).ok && !sys.metadata(file).ok)
    assert(sys.remove_file(moved).ok && fs.list_dir(d.value).unwrap().len == 0)
}
