import std.fs

pub fn copy(input: &fs.ReadFile, output: &fs.WriteFile) {
    data := fs.read(&input)
    info := fs.metadata(&input)
    assert(data.ok && info.ok && info.is_file && info.size == i64(data.value.len))
    assert(fs.write(&output, data.value).ok)
    assert(fs.append(&output, "✓\n").ok)
}
