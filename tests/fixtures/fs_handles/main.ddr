capability filesystem
import std.fs
import std.sys as sys
import worker

fn main() {
    assert(sys.mkdir("arbete").ok)
    assert(sys.mkdir("arbete").error == 17)
    assert(sys.metadata("arbete").is_dir)
    input := fs.grant_read("källa.txt")
    output := fs.grant_write("arbete/kopia.txt")
    worker.copy(&input, &output)
    missing := fs.grant_read("saknas")
    assert(fs.read(&missing).error == 2)
    assert(sys.remove_dir("arbete").error == 66)
    assert(sys.rename("arbete/kopia.txt", "resultat.txt").ok)
    assert(sys.remove_dir("arbete").ok)
}
