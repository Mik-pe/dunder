capability filesystem
import std.fs
import std.sys as sys
import worker

fn main() {
    assert(sys.mkdir("arbete").ok)
    assert(sys.mkdir("arbete").error == 17)
    assert(sys.metadata("arbete").is_dir)
    input := fs.ReadFile::grant("källa.txt")
    output := fs.WriteFile::grant("arbete/kopia.txt")
    assert(worker.copy(&input, &output).is_ok())
    missing := fs.ReadFile::grant("saknas")
    assert(worker.copy(&missing, &output).unwrap_err() == .NotFound)
    assert(input.read_limit(2) == .Err(.TooLarge))
    assert(input.read_bytes_limit(-1) == .Err(.InvalidArgument))
    impossible := fs.WriteFile::grant("saknas/kopia.txt")
    assert(worker.copy(&input, &impossible).unwrap_err() == .NotFound)
    assert(sys.remove_dir("arbete").error == 66)
    assert(sys.rename("arbete/kopia.txt", "resultat.txt").ok)
    assert(sys.remove_dir("arbete").ok)
}
