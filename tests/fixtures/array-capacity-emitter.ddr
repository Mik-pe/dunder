// Internal runtime ABI probes. The mathematical descriptor only supplies cap;
// no probe claims that a tiny backing allocation can hold billions of elements.
import ...selfhost.arm64 as arm
import ...selfhost.runtime as runtime
import ...selfhost.compile as compiler
import ...selfhost.macho as macho
import ...selfhost.elf as elf
import ...selfhost.x86 as x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as parse
import sys

fn descriptor(code: &mut arm.Code) {
    arm.imm(&mut code, 0, 32); arm.emit(&mut code, 3405775776)
}
fn main() {
    platform := i32(parse.integer(sys.arg(2)).value); mode := sys.arg(3)
    var text: []u8 = []
    if mode == "program" {
        source := sys.read_text(sys.arg(4)); assert(source.ok)
        built := compiler.compile_for(source.value, platform)
        if !built.ok { print(built.error) }
        assert(built.ok); text = built.text
    } else {
        var code := arm.new_for(platform); rt := runtime.new(&mut code)
        entry := arm.label(&mut code); failed := arm.label(&mut code); capacity := arm.label(&mut code)
        if platform != 3 { arm.imm(&mut code, 19, 0); arm.imm(&mut code, 20, 0) }
        arm.branch(&mut code, entry, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
        arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 4)
        for slot in 0..4 { arm.store(&mut code, slot, 31) }
        if mode == "math" {
            current: []i64 = [0,0,0,0,0,8,8,8,8,9,1,1073741822,1073741823,1073741823,1073741824,1073741824,2147483646,2147483646,2147483647,2147483647]
            wanted: []i64 = [0,1,7,8,9,0,8,9,17,10,2,1073741823,1073741824,2147483647,1073741825,2147483647,2147483646,2147483647,0,2147483647]
            expected: []i64 = [0,8,8,8,9,8,8,16,17,18,8,2147483644,2147483646,2147483647,2147483647,2147483647,2147483646,2147483647,2147483647,2147483647]
            for test in 0..current.len {
                arm.imm(&mut code, 0, current[test]); arm.store(&mut code, 1, 0); descriptor(&mut code)
                arm.imm(&mut code, 1, wanted[test]); enough := arm.label(&mut code)
                runtime.emit_array_growth(&mut code, capacity, enough)
                arm.mark(&mut code, enough); arm.imm(&mut code, 12, expected[test])
                arm.emit(&mut code, 3942645791 + 12 * 65536 + 10 * 32); arm.branch(&mut code, failed, 3)
            }
        } else if mode == "push-limit" {
            arm.imm(&mut code, 0, 2147483647); arm.store(&mut code, 1, 0); arm.store(&mut code, 2, 0)
            descriptor(&mut code); arm.imm(&mut code, 1, 42); arm.branch(&mut code, rt.array_push, 1)
            arm.branch(&mut code, failed, 0)
        } else {
            requested := parse.integer(sys.arg(4)); assert(requested.ok)
            // Invalid reserve counts must fail before dereferencing x0, even
            // when the source-language i32 argument cannot spell that count.
            arm.imm(&mut code, 0, 0); arm.imm(&mut code, 1, requested.value)
            if mode == "reserve-invalid" { arm.branch(&mut code, rt.array_reserve, 1) }
            else {
                assert(mode == "growth-invalid"); enough := arm.label(&mut code)
                runtime.emit_array_growth(&mut code, capacity, enough); arm.mark(&mut code, enough)
            }
            arm.branch(&mut code, failed, 0)
        }
        arm.imm(&mut code, 0, 0); arm.ret(&mut code)
        arm.mark(&mut code, failed); arm.exit(&mut code, 104)
        arm.mark(&mut code, capacity); arm.exit(&mut code, 109)
        runtime.emit_runtime(&mut code, &rt)
        end := code.words.len
        if platform == 3 {
            abi := wa.new(); built := wasm.image(&code, end, entry, 1, &abi); assert(built.ok); text = built.text
        } else if platform == 2 {
            empty: []i32 = []; built := x86.finish(&code, end, &empty, &empty); assert(built.ok); text = built.text
        } else { text = arm.finish(&mut code) }
    }
    var image := text
    if platform == 0 { image = macho.image(&text) }
    else if platform != 3 { var machine := 183; if platform == 2 { machine = 62 }; image = elf.image_for(&text, machine) }
    saved := sys.write_u8(sys.arg(1), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(1)); assert(executable.ok)
}
