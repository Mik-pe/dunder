capability unsafe
import sys

fn main() {
    mut items: []string = []
    items.push(f"item {42}")
    previous := items.cap()
    unsafe {
        first := sys.pool_alloc_try(usize(32))
        assert(usize(first) != usize(0))
        store_u8(first, 91)
        denied := sys.pool_alloc_try(usize(8388608))
        assert(usize(denied) == usize(0))
        assert(load_u8(first) == 91)
        next := sys.pool_alloc_try(usize(32))
        assert(usize(next) != usize(0) && next != first)
        store_u8(next, 37)
        assert(load_u8(first) == 91 && load_u8(next) == 37)
        sys.pool_free(next)
        sys.pool_free(first)
    }
    assert(items.try_reserve(1048576) == .OutOfMemory)
    assert(items.cap() == previous && items.len == 1 && items[0] == "item 42")
    assert(items.try_reserve(20) == .Ok)
    assert(items.pop() == "item 42")
    mut bytes: []u8 = []
    bytes.reserve(300000)
    bytes.push(91)
    unsafe {
        mut head := ptr(0)
        while true {
            block := sys.pool_alloc_try(usize(524288))
            if usize(block) == usize(0) { break }
            store_ptr(block, head)
            head = block
        }
        assert(usize(head) != usize(0))
        available := head
        head = load_ptr(available)
        sys.pool_free(available)
        assert(bytes.try_reserve(300001) == .Ok)
        assert(bytes.cap() == 300001 && bytes.pop() == 91)
        while usize(head) != usize(0) {
            block := head
            head = load_ptr(block)
            sys.pool_free(block)
        }
    }
    print(42)
}
