// Batch acceptance protocol: one result line per UTF-8 source file argument.
// The TOML parser under test runs inside the emitted target executable.
capability filesystem

import std.toml as toml
import std.json as json
import sys

fn main() -> i32 {
    if sys.arg_count() < 2 { return 2 }
    for index in 1..sys.arg_count() {
        path := sys.arg(index)
        // read_text has its own 4 MiB cap. Read bounded bytes first so an
        // over-limit valid string reaches the TOML parser's independent cap.
        raw := sys.read_u8(path)
        if !raw.ok { return 3 }
        source := sys.decode_u8(&raw.value)
        if !source.ok {
            // Dunder strings are valid UTF-8. Invalid source bytes are rejected
            // at this boundary before std.toml.parse can receive a string.
            print("{\"file\":" + json.quote(path) + ",\"source_ok\":false,\"ok\":false,\"error\":" + json.quote(sys.error_message(source.error)) + ",\"json\":\"\",\"json_ok\":false,\"numbers\":[]}")
            continue
        }
        result := toml.parse(source.value)
        mut out: []u8 = []
        mut first := json.begin_obj(&mut out)
        json.field_str(&mut out, &mut first, "file", path)
        json.field_bool(&mut out, &mut first, "source_ok", true)
        json.field_bool(&mut out, &mut first, "ok", result.ok)
        json.field_str(&mut out, &mut first, "error", result.error)
        json.field_str(&mut out, &mut first, "json", result.json)
        doc := json.Doc::parse_text(result.json)
        json.field_bool(&mut out, &mut first, "json_ok", doc.ok)
        mut numbers_first := json.begin_field_arr(&mut out, &mut first, "numbers")
        if doc.ok {
            for node in 0..doc.kinds.len {
                if doc.kind(node) == .Number {
                    json.sep_elem(&mut out, &mut numbers_first)
                    json.write_str(&mut out, doc.raw_span(node))
                }
            }
        }
        json.end_arr(&mut out)
        json.end_obj(&mut out)
        print(json.finish_text(&out))
    }
    0
}
