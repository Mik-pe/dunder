capability unsafe
import views

fn fresh() -> []i32 { [7, 20, 22, 9] }
fn sum(data: &[]i32) -> i32 {
    mut total := 0
    for n in data { total += n }
    total
}
fn pair(left: &[]i32, right: &[]i32) -> i32 {
    left[0] * 100 + right[0]
}
fn fixed(data: &[i32; 4]) -> &[]i32 { &data[1..3] }
fn marker(text: &string) -> &string { text }
fn read(n: &i32) -> i32 { n }
fn identity(n: &i32) -> &i32 { n }
fn forwarded_integer(n: &i32) -> &i32 { identity(identity(n)) }
fn truth(flag: &bool) -> &bool { flag }
fn first_number(data: &[]i32) -> &i32 { identity(data[0]) }
fn envelope() -> views.Envelope { views.Envelope { message: .Text("dunder") } }
fn message_length(value: &views.Envelope) -> i32 {
    match views.envelope(value).message { .Text(s) => s.len, .Empty => 0 }
}
fn all_exits(value: &i32, flag: bool) -> &i32 {
    return if flag { return value } else { return value }
}
fn string_window(values: &[]string) -> &[]string { &values[1..3] }
fn record_element(values: &[]views.Fields) -> &views.Fields { &values[0] }
fn implicit(data: []i32) -> &[]i32 { &data[1..3] }
fn through(f: fn(&[]i32, &[]i32) -> &[]i32 from 1,
           source: &[]i32, other: &[]i32) -> &[]i32 from source {
    f(source, other)
}

fn with_defer(data: &[]i32, observe: &mut i32) -> &[]i32 from data {
    defer { observe = sum(data) }
    views.window(data, 1, 3)
}

fn main() {
    mut integer := 42
    yes := true
    copy: i32 = forwarded_integer(integer)
    integer = 43
    assert(copy == 42 && forwarded_integer(integer) == 43 && 1 + identity(integer) == 44)
    assert(-identity(integer) == -43 && truth(yes) && !truth(false))
    if truth(yes) { assert(i64(identity(integer)) == i64(43)) }
    ref := forwarded_integer(integer)
    unsafe { assert(addr(&ref) == addr(&integer)) }
    print(forwarded_integer(integer))
    mail := envelope()
    assert(message_length(mail) == 6)
    match views.message(mail.message) {
        .Text(s) => { assert(s == "dunder") },
        .Empty => { assert(false) },
    }
    match views.message(envelope().message) {
        .Text(s) => { assert(s.len == 6) },
        .Empty => { assert(false) },
    }
    mut fields := views.Fields { data: fresh(), spare: [99], number: 42 }
    {
        outside: []i32 = [40, 2]
        from_argument := fields.other(outside)
        fields.number = 42
        assert(sum(from_argument) == 42)
    }
    {
        chosen := views.prefer(fields.data, fields.spare)
        fields.spare = [71]
        assert(chosen.len == 3 && chosen[0] == 20 && chosen[2] == 9)
    }
    {
        left := fields.middle()
        right := views.window(fields.data, 2, 4)
        forwarded := views.relay(left, 12)
        again := views.window(forwarded, 1, 2)
        scalar := views.first(right)
        n := views.number(fields)
        many := views.wide(1, 2, 3, 4, 5, 6, 7, 8, fields.data, 3)
        window_fn: fn(&[]i32, i32, i32) -> &[]i32 = views.window
        call := window_fn(fields.data, 1, 3)
        selected := through(views.prefer, fields.data, fresh())
        for i in 0..96 {
            assert(pair(views.window(fields.data, 0, 1),
                        views.window(fields.data, 3, 4)) == 709)
            assert(views.relay(right, i % 6).len == 2)
        }
        assert(left.len == 2 && left.cap() == 2 && sum(left) == 42)
        assert(sum(forwarded) == 42 && sum(many) == 42)
        assert(sum(call) == 42 && selected.len == 3 && selected[1] == 22)
        assert(read(first_number(selected)) == 20)
        assert(sum(implicit(fields.data)) == 42)
        assert(sum(views.branch(fields.data, .Front, true)) == 27)
        assert(sum(views.branch(fields.data, .Back, true)) == 31)
        assert(sum(views.branch(fields.data, .Back, false)) == 42)
        assert(scalar == 22 && n == 42 && again[0] == 22)
        t := all_exits(scalar, true)
        e := all_exits(scalar, false)
        assert(t == 22 && e == 22)
        assert(views.window(fields.data, 1, 3)[0] == 20 && len(views.window(fields.data, 1, 3)) == 2)
        mut total := 0
        for value in views.window(fields.data, 1, 3) { total += value }
        assert(total == 42)
        unsafe {
            assert(addr(&left[0]) == addr(&fields.data[1]))
            assert(addr(&forwarded[1]) == addr(&fields.data[2]))
            assert(addr(&again[0]) == addr(&fields.data[2]))
            assert(addr(&scalar) == addr(&fields.data[2]))
            assert(addr(&t) == addr(&fields.data[2]) && addr(&e) == addr(&fields.data[2]))
            assert(addr(&n) == addr(&fields.number))
        }
    }
    fields.data[1] = 20
    mut observed := 0
    tail := with_defer(fields.data, &mut observed)
    assert(sum(tail) == 42 && observed == 58)
    assert(sum(views.window(fresh(), 1, 3)) == 42)
    mut temporary_sum := 0
    for value in views.window(fresh(), 0, 4) {
        noise: []i32 = [93, 94, 95, 96]
        assert(noise[0] == 93)
        temporary_sum += value
    }
    assert(temporary_sum == 58)
    none: []i32 = []
    assert(views.window(none, 0, 0).len == 0 && views.text_bytes("", 0, 0).len == 0)
    fixed_data: [i32; 4] = [7, 20, 22, 9]
    f := fixed(fixed_data)
    unsafe { assert(addr(&f[1]) == addr(&fixed_data[2])) }
    original := "x" + "å🌍" + "y"
    assert(read(original[0]) == 120 && read(identity(original[1])) == 195)
    label := marker(original)
    utf8 := views.text_bytes(label, 1, 7)
    empty := views.text_bytes(label, label.len, label.len)
    assert(utf8.len == 6 && empty.len == 0)
    assert(utf8[0] == 195 && utf8[2] == 240 && utf8[5] == 141)
    unsafe {
        assert(addr(&utf8[0]) == ptr(usize(load_ptr(addr(&original))) + 9))
        assert(addr(&label) == addr(&original))
    }
    mut words: []string = ["x", "å", "dunder", "z"]
    mut copied: []string = []
    {
        selected := string_window(words)
        copied = selected.clone()
        assert(selected[1] == "dunder")
    }
    words.clear()
    assert(copied.len == 2 && copied[0] == "å" && copied[1] == "dunder")
    records: []views.Fields = [views.Fields { data: [40, 2], spare: [], number: 7 }]
    record := record_element(records)
    assert(sum(record.data) == 42 && record.number == 7)
    unsafe { assert(addr(&record.number) == addr(&records[0].number)) }
    print("returned borrows ok")
}
