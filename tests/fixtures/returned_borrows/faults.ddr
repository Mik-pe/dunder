import sys
import views

fn start() -> i32 { print(1); -1 }
fn end() -> i32 { print(2); 1 }

fn main() {
    mode := sys.arg(1)
    text := "xå🌍y"
    numbers: []i32 = [20, 22]
    if mode == "order" { v := views.window(numbers, start(), end()); print(v.len) }
    if mode == "reversed" { v := views.window(numbers, 2, 1); print(v.len) }
    if mode == "past" { v := views.window(numbers, 0, 3); print(v.len) }
    if mode == "utf8-start" { v := views.text_bytes(text, 2, 7); print(v.len) }
    if mode == "utf8-end" { v := views.text_bytes(text, 1, 6); print(v.len) }
    if mode == "utf8-empty" { v := views.text_bytes(text, 2, 2); print(v.len) }
    if mode == "bounds-first" { v := views.text_bytes(text, 2, 9); print(v.len) }
}
