pub struct Fields { data: []i32, spare: []i32, number: i32 }

pub fn window(data: &[]i32, start: i32, end: i32) -> &[]i32 {
    &data[start..end]
}

pub fn text_bytes(text: &string, start: i32, end: i32) -> &[]u8 {
    v := &text[start..end]
    v.as_bytes()
}

pub fn relay(data: &[]i32, depth: i32) -> &[]i32 {
    alias := window(data, 0, data.len)
    if depth == 0 { return alias }
    return relay(alias, depth - 1)
}

pub fn first(data: &[]i32) -> &i32 { &data[0] }

pub fn number(fields: &Fields) -> &i32 { &fields.number }

fn from() -> i32 { 1 }

pub fn prefer(first: &[]i32, other: &[]i32) -> &[]i32 from first {
    if other.len == 0 { return first }
    return &first[from()..first.len]
}

pub enum Side { Front, Back }
pub enum Message { Empty, Text(string) }
pub struct Envelope { message: Message }

pub fn envelope(value: &Envelope) -> &Envelope { value }
pub fn message(value: &Message) -> &Message { value }

pub fn branch(data: &[]i32, side: Side, nested: bool) -> &[]i32 from data {
    return if nested {
        match side {
            .Front => &data[0..2],
            .Back => { tail := &data[2..4]; tail },
        }
    } else { window(data, 1, 3) }
}

pub fn wide(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32,
            data: &[]i32, last: i32) -> &[]i32 {
    assert(a + b + c + d + e + f + g + h == 36)
    return window(data, 1, last)
}

impl Fields {
    pub fn middle(&self) -> &[]i32 {
        &self.data[1..self.data.len - 1]
    }

    pub fn other(&self, values: &[]i32) -> &[]i32 from values {
        window(values, 0, values.len)
    }
}
