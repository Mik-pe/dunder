capability unsafe

@repr(C) struct Pair { a: u8, b: u16 }
@repr(C) struct Packet { tag: u8, pair: Pair, numbers: [i32; 4] }
struct Bag { packet: Packet, labels: [string; 2] }

fn packet(bag: &Bag) -> &Packet { &bag.packet }
fn pair(p: &Packet) -> &Pair { &p.pair }
fn member(p: &Pair) -> &u16 { &p.b }
fn fixed(p: &Packet) -> &[i32; 4] { &p.numbers }
fn identity(values: &[i32; 4]) -> &[i32; 4] { values }
fn tail(p: &Packet) -> &[]i32 { &p.numbers[1..4] }
fn element(p: &Packet) -> &i32 { &p.numbers[2] }
fn labels(bag: &Bag) -> &[string; 2] { &bag.labels }
fn second(names: &[string; 2]) -> &string { &names[1] }
fn first(packets: &[]Packet) -> &Packet { &packets[0] }

fn main() {
    bag := Bag {
        packet: Packet { tag: 8, pair: Pair { a: 3, b: 60891 }, numbers: [-1, -777, 20, 22] },
        labels: ["alpha", "ome" + "ga"]
    }
    p := packet(bag)
    nested := pair(p)
    number := member(nested)
    numbers := fixed(p)
    forwarded := identity(numbers)
    view := tail(p)
    value := element(p)
    names := labels(bag)
    name := second(names)
    packets: []Packet = [bag.packet.clone()]
    head := first(packets)
    assert(number == 60891 && numbers[1] == -777 && forwarded[2] == 20)
    assert(view[0] == -777 && view[1] == 20 && value == 20)
    assert(name == "omega" && head.tag == 8)
    unsafe {
        assert(addr(&p) == addr(&bag.packet))
        assert(addr(&nested) == addr(&bag.packet.pair))
        assert(addr(&number) == addr(&bag.packet.pair.b))
        assert(addr(&numbers) == addr(&bag.packet.numbers))
        assert(addr(&forwarded) == addr(&bag.packet.numbers))
        assert(addr(&view[0]) == addr(&bag.packet.numbers[1]))
        assert(addr(&value) == addr(&bag.packet.numbers[2]))
        assert(addr(&name) == addr(&bag.labels[1]))
        assert(addr(&head) == addr(&packets[0]))
    }
    print("returned layouts ok")
}
