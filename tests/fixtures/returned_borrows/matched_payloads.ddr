struct Label { text: Option<string>, fallback: string }
struct Count { value: i32 }
enum Page { Empty, Ready(Count), Waiting(Count) }
enum Pair { Values(i32, i32), Empty }

fn text(label: &Label) -> &str from label {
    match &label.text { .Some(value) => value.as_str(), .None => label.fallback.as_str() }
}

fn indexed(values: &mut []i32, index: i32) -> Option<&mut i32> from values {
    if index < 0 || index >= values.len { return .None }
    .Some(&mut values[index])
}

fn change(value: &mut i32) { value = 19 }

pub fn check() {
    label := Label { text: .Some("北"), fallback: "?" }
    blank := Label { text: .None, fallback: "?" }
    assert(text(&label) == "北" && text(&blank) == "?")
    mut pages: []Page = [.Empty, .Ready(Count { value: 16 }), .Waiting(Count { value: 8 })]
    for i in 0..pages.len {
        match &mut pages[i] {
            .Ready(n) | .Waiting(n) => { n.value += 1 },
            .Empty => {},
        }
    }
    match &pages[0] { .Empty => {}, _ => { assert(false) }, }
    match &pages[1] { .Ready(n) => { assert(n.value == 17) }, _ => { assert(false) }, }
    match &pages[2] { .Waiting(n) => { assert(n.value == 9) }, _ => { assert(false) }, }
    mut pair := Pair.Values(3, 5)
    match &mut pair { .Values(first, second) => { first += second; second = 7 }, .Empty => {}, }
    match pair { .Values(a, b) => { assert(a == 8 && b == 7) }, .Empty => { assert(false) }, }
    mut data: []i32 = [3, 5]
    match indexed(&mut data, 1) { .Some(value) => { change(value) }, .None => { assert(false) }, }
    assert(data[0] == 3 && data[1] == 19 && indexed(&mut data, -1).is_none())
    element := indexed(&mut data, 0).unwrap()
    element = 23
    assert(data[0] == 23)
}
