import std.text

pub struct Parser { symbols: &Map<string, f64>, cursor: i32 }
pub struct Session { symbols: Map<string, f64> }

impl Session {
    fn parser(&self) -> Parser from self {
        result := Parser { symbols: &self.symbols, cursor: 0 }
        return move result
    }
}

impl Parser {
    pub fn lookup(&self, key: string) -> Option<&f64> from self {
        self.symbols.get_ref(key)
    }

    fn next(&mut self, key: string) -> Option<f64> {
        value: Option<f64> = match self.lookup(key) {
            .Some(v) => .Some(v + 0.0),
            .None => .None,
        }
        self.cursor += 1
        value
    }
}

fn sum(symbols: &Map<string, f64>, first: string, second: string) -> Option<f64> {
    mut parser := Parser { symbols: symbols, cursor: 0 }
    a := parser.next(first)?
    b := parser.next(second)?
    assert(parser.cursor == 2)
    .Some(a + b)
}

fn assign(session: &mut Session, key: string, first: string, second: string) {
    match sum(&session.symbols, first, second) {
        .Some(value) => { session.symbols.put(key.clone(), value) },
        .None => {},
    }
}

fn forward(v: &i32) -> Option<&i32> {
    opt: Option<&i32> = .Some(v)
    ref := opt?
    .Some(&ref)
}

fn relay(use_value: bool, move opt: Option<&i32>) -> Option<&i32> {
    if use_value { return opt }
    .None
}

@resource struct Handle { id: i32 }

fn first_line(move source: string) -> string {
    mut lines := text.lines(source.as_str())
    while lines.advance() {
        line := lines.current()
        if line.len == source.len { return move source }
        if line.len > 0 { return line.to_string() }
    }
    ""
}

pub fn exercise() {
    assert(first_line("one line") == "one line")
    assert(first_line("\nsecond\nthird") == "second")
    assert(first_line("") == "")
    mut session := Session { symbols: Map<string, f64>::new() }
    session.symbols.put("x", 3.0)
    assign(&mut session, "x", "x", "x")
    assert(session.symbols.at("x") == 6.0)
    assign(&mut session, "x", "x", "missing")
    assert(session.symbols.at("x") == 6.0)

    parser := session.parser()
    found: Option<&f64> = if true {
        key := "x".clone()
        parser.lookup(key)
    } else { .None }
    match found { .Some(v) => { assert(v == 6.0) }, .None => { assert(false) } }
    session.symbols.clear()
    assert(session.symbols.is_empty())

    mut handles := Map<i32, Handle>::new()
    handles.put(7, Handle { id: 11 })
    match handles.get_ref(7) { .Some(h) => { assert(h.id == 11) }, .None => { assert(false) } }
    assert(handles.take(7).is_some())

    empty: Option<&i32> = .None
    forwarded := relay(true, move empty)
    assert(forwarded.is_none())
    number := 42
    match forward(&number) { .Some(v) => { assert(v == 42) }, .None => { assert(false) } }
}
