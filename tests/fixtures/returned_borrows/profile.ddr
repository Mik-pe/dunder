import sys
import views

struct Cursor { first: &i32 }

fn cursor(first: &i32) -> Cursor from first {
    value := Cursor { first: first }
    return move value
}

fn main() {
    returned := sys.arg(1) == "1"
    numbers: []i32 = [7, 20, 22, 9]
    text := "x" + "å🌍" + "y"
    mut total := 0
    for turn in 0..256 {
        c := cursor(&numbers[0])
        assert(c.first == 7)
        if returned {
            a := views.window(numbers, 1, 3)
            b := views.relay(a, 3)
            bytes := views.text_bytes(text, 1, 7)
            total += a[0] + b[1] + i32(bytes[0])
        } else {
            a := &numbers[1..3]
            b := &a[0..a.len]
            bytes := &text[1..7]
            total += a[0] + b[1] + i32(bytes[0])
        }
    }
    assert(total == 60672)
    print(total)
}
