import std.map as maps
import std.set as sets

struct Key { id: i32 }
impl Eq for Key {
    fn eq(&self, other: &Self) -> bool { self.id == other.id }
}
impl Hash for Key {
    fn hash(&self) -> u64 { 7 } // Force collisions between distinct keys.
}
impl Key {
    fn one(self) -> Map<Self, i32> {
        mut table := Map<Self, i32>::new()
        table.put(self, 42)
        table
    }
}

@resource(dispose)
struct Handle { id: i32 }
impl Eq for Handle {
    fn eq(&self, other: &Self) -> bool { self.id == other.id }
}
impl Hash for Handle {
    fn hash(&self) -> u64 { u64(self.id) }
}
impl Handle {
    fn dispose(&self) { print(self.id) }
}

fn numeric_keys() {
    mut values := maps.Map<i64, []u8>::new()
    min: i64 = -9223372036854775808
    values.put(min, [9])
    values.put(0, [42])
    for i in 1..65 { values.put(i64(i), [u8(i)]) }
    for i in 1..60 { assert(values.remove(i64(i))) }
    assert(values.len() == 7 && values.at(min)[0] == 9)
    saved := values.clone()
    values.put(0, [21])
    assert(saved.at(0)[0] == 42 && values.at(0)[0] == 21)
    index := values.index_of(61)
    assert(values.key_at(index) == 61 && values.value_at(index)[0] == 61)
    snapshot := values.get_or(0, [0])
    fallback := values.get_or(-1, [42])
    values.put(0, [9])
    assert(snapshot[0] == 21 && fallback[0] == 42)
    match values.take(-1) { .Err => {}, .Ok(_) => { assert(false) } }

    mut bits := sets.Set<u64>::new()
    assert(bits.insert(18446744073709551615) && bits.contains(18446744073709551615))
    assert(!bits.insert(18446744073709551615))
    assert(bits.at(0) == 18446744073709551615)
}

fn custom_keys() {
    mut values := Set<Key>::new()
    for id in 0..96 { assert(values.insert(Key {id:id})) }
    for id in 0..90 { assert(values.remove(Key {id:id})) }
    for id in 90..96 {
        assert(values.contains(Key {id:id}))
        assert(!values.insert(Key {id:id}))
    }
    match values.take(Key {id:93}) {
        .Ok(key) => { assert(key.id == 93) },
        .Err => { assert(false) },
    }
    assert(values.len() == 5)
    assert(!values.remove(Key {id:93}))
    mut nested := Map<string, Set<Key>>::new()
    nested.put("å\0🌍", move values)
    assert(nested.at("å\0🌍").contains(Key {id:95}))
    assert(!nested.contains("å"))
    assert(Key {id:7}.one().at(Key {id:7}) == 42)
}

fn handles() {
    mut table := Map<i32, Handle>::new()
    table.put(1, Handle {id:11})
    table.put(2, Handle {id:12})
    table.reserve(1024)
    assert(table.at(1).id == 11)
    print(1)
    table.put(2, Handle {id:13})
    match table.take(1) {
        .Ok(handle) => { assert(handle.id == 11); print(2) },
        .Err => { assert(false) },
    }
    table.clear()
    assert(table.len() == 0)

    mut keys := Set<Handle>::new()
    assert(keys.insert(Handle {id:14}))
    assert(!keys.insert(Handle {id:14}))
    assert(keys.at(0).id == 14)
    match keys.take_at(0) {
        .Ok(handle) => { assert(handle.id == 14); print(6) },
        .Err => { assert(false) },
    }
    assert(keys.len() == 0)
}

fn canonical(
    move table: Map<i32, fn(string) -> i32>
) -> maps.Map<i32, fn(&string) -> i32> { table }

fn same_array(
    move table: Map<bool, [i32; 0x4]>
) -> Map<bool, [i32; 4]> { table }

fn string_size(text: string) -> i32 { text.len }

fn equivalent_types() {
    mut source := Map<i32, fn(string) -> i32>::new()
    source.put(1, string_size)
    functions := canonical(move source)
    call := functions.at(1)
    assert(call("text") == 4)
    mut widths: Map<bool, [i32; 4]>= Map<bool, [i32; 4]>::new()
    widths.put(true, [1, 2, 3, 4])
    array := same_array(move widths)
    assert(array.at(true)[3] == 4)
}

fn main() {
    numeric_keys()
    custom_keys()
    handles()
    equivalent_types()
    print(42)
}
