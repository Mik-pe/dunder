import numbers

struct Number { value: i32 }
impl Number {
    fn plus(&self, amount: i32) -> Self { Self { value: self.value + amount } }
}
enum Choice { yes(i32), no }

fn checked(flag: bool) -> Choice {
    if flag { return .no }
    value := 42
    .yes(value)
}
fn separated() -> Choice {
    value := 21;
        .yes(value * 2)
}
fn shadow() -> i32 {
    numbers := Number { value: numbers.forty() }
        .plus(numbers.two())
        .value
    numbers
}
fn plus_one(value: i32) -> i32 { value + 1 }
fn function_value() -> fn(i32) -> i32 { plus_one }
fn array_value() -> []i32 { [42] }
fn count(counter: &mut i32) { counter += 1 }
fn early(counter: &mut i32) {
    _ := plus_one(if true {
        return
        count(&mut counter)
        0
    } else { 0 })
}
fn main() {
    mut values: []i32 = []
    values // the following mutating call is part of this expression
        .push(40)
    mut number := Number { value: values[0] }
    number
        .value += 1
    number = number
        .plus(1)
    assert(number.value == 42)

    text := number
        .plus(3)
        /* a multiline comment
           between links */
        .value.str()
    assert(text == "45" && shadow() == 42)
    n := 2 * 10
        .wrapping_add(11)
    assert(n == 42)
    state := match checked(false) {
        .yes(n) => n,
        .no => 0,
    }
    match separated() {
        .yes(n) => assert(n == 42 && state == 42),
        .no => assert(false),
    }

    grouped := (Number {
        value
        :
            plus_one
            (40)
            + 1
        }
        .value)
    assert(grouped == 42)
    assert((if true { number
    .value } else { 0 }) == 42)
    assert((if true { Number { value: 42 }
    .value } else { 0 }) == 42)
    assert((if true { 1
        + 41 } else { 0 }) == 42)
    assert([if true { plus_one
        (41) } else { 0 }][0] == 42)
    assert((if true {
        x: i32 = 7
        -x
    } else { 0 }) == -7)
    mut calls := 0
    assert((if true { count(&mut calls)
        -42 } else { 0 }) == -42)
    assert((if true { count(&mut calls)
        (42) } else { 0 }) == 42)
    assert((if true { count(&mut calls)
        [42] } else { [0] })[0] == 42)
    assert((if true { function_value()
        (41) } else { 0 }) == 42)
    assert((if true { array_value()
        [0] } else { 0 }) == 42)
    assert((if true { plus_one(43)
        - 2 } else { 0 }) == 42)
    early(&mut calls)
    assert(calls == 3)
    interpolated := f"{if true { n := 40
        n + 2 } else { 0 }}"
    assert(interpolated == "42")
    print(42)
}
