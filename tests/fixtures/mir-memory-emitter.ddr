// An outer frame owns the valid object referenced by x2. That object is
// distinct from the optimized callee's private locals. No source-name rule.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_liveness as live
import ...selfhost.mir_memory as memory
import ...selfhost.mir_opt as opt
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys
fn integer(at: i32) -> i32 { i32(decimal.integer(sys.arg(at)).value) }
fn add(code: &mut arm.Code, dst: i32, a: i32, b: i32) { arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst)) }
fn compare(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn main() {
    target := integer(2); selected := integer(3); policy := sys.arg(4)
    var code := arm.new_for(target); wrapper := arm.label(&mut code); entry := arm.label(&mut code)
    called := arm.label(&mut code); failed := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    // This untrusted callee deliberately walks the saved FP and mutates its
    // caller's counter, then destroys x25..28. Calls must remain synchronized
    // even under the trusted source-object context for the caller's own ops.
    arm.mark(&mut code, called); old_frame := arm.prologue(&mut code); arm.frame(&mut code, old_frame, 0)
    arm.emit(&mut code, 4181721088 + 29 * 32)
    arm.emit(&mut code, 4164943872 + 504 * 4096 + 1) // LDUR x1,[x0,#-8]
    arm.imm(&mut code, 16, 1); add(&mut code, 1, 1, 16)
    arm.emit(&mut code, 4160749568 + 504 * 4096 + 1) // STUR x1,[x0,#-8]
    for reg in 25..29 { arm.imm(&mut code, reg, i64(reg) * 1000003) }; arm.ret(&mut code)
    first_word := code.words.len; first_label := code.labels.len; first_reloc := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    if selected == 3 { arm.mov(&mut code, 5, 29) }
    if selected == 4 { arm.emit(&mut code, 4181721088 + 29 * 32 + 5) }
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    var count := 10; if selected == 6 { count = 0 }
    arm.imm(&mut code, 0, i64(count)); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    compare(&mut code, 1, 0); arm.branch(&mut code, done, 12)
    var read: i64 = 4181721088; var write: i64 = 4177526784
    if selected == 7 { read = 960495616; write = 956301312 }
    arm.emit(&mut code, read + 2 * 32 + 3)
    arm.imm(&mut code, 1, 1); add(&mut code, 4, 3, 1); arm.emit(&mut code, write + 2 * 32 + 4)
    arm.load(&mut code, 1); add(&mut code, 0, 0, 3); arm.store(&mut code, 1, 0)
    if selected == 1 { arm.branch(&mut code, called, 1) }
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
    if selected == 2 { arm.branch(&mut code, called, 1) }
    arm.load(&mut code, 1); arm.ret(&mut code)
    var sites: []i32 = []; var function := mir.new()
    assert(lift.lift(&mut function, &code, first_word, first_label, first_reloc, &sites, 0))
    assert(lift.own_entry(&mut function, &code, entry))
    if selected == 5 { overlap := mir.add_place(&mut function, 1, -4, 8, 0) }
    assert(verify.verify(&mut function))
    var work := opt.new(); var ready := false
    source := memory.trusted_source_objects_v1(); raw := memory.conservative()
    if policy == "source" { ready = opt.analyze_with_context(&mut work, &function, &source) }
    else if policy == "raw" { ready = opt.analyze_with_context(&mut work, &function, &raw) }
    else { assert(policy == "legacy"); ready = opt.analyze_into(&mut work, &function) }
    homes := opt.promoted(&work); skipped := opt.private_memory_ops(&work)
    if ready { opt.apply(&mut work, &mut function); assert(verify.verify(&mut function)) }
    var liveness := live.new(); assert(live.analyze_into(&mut liveness, &function, 1000000))
    var frame_ops := 0; var object_ops := 0; var synchronized := 0
    for position in 0..function.order.len {
        op := function.order[position]; if function.modes[op] == 2 { continue }
        if (function.kinds[op] == 7 || function.kinds[op] == 8) && live.loop_block(&liveness, function.op_blocks[op]) {
            kind := function.place_kinds[function.place[op]]
            if kind == 1 { frame_ops = frame_ops + 1 }; if kind == 0 { object_ops = object_ops + 1 }
        }
        if ready && function.kinds[op] == 14 {
            before := function.order[position - 1]; after := function.order[position + 1]
            assert(function.modes[before] == 1 && function.kinds[before] == 8)
            assert(function.modes[after] == 1 && function.kinds[after] == 7 && function.clobbers[op] == -1)
            synchronized = synchronized + 1
        }
    }
    var lowering := lower.new(); assert(lower.prepare(&mut lowering, &function, &code, &sites))
    lower.commit_code(&mut lowering, &mut code); lower.commit_imports(&mut lowering, &mut sites)
    arm.mark(&mut code, wrapper); outer := arm.prologue(&mut code); arm.frame(&mut code, outer, 1)
    var initial := 7; if selected == 7 { initial = 250 }
    arm.imm(&mut code, 0, i64(initial)); arm.store(&mut code, 0, 0)
    arm.emit(&mut code, 3506438144 + 8 * 1024 + 29 * 32 + 2) // SUB x2,FP,#8: valid outer object.
    if selected == 6 { arm.imm(&mut code, 2, 0) } // Zero-trip must not speculate a null object access.
    for reg in 25..29 { arm.imm(&mut code, reg, i64(reg) * 17 + 3) }
    arm.branch(&mut code, entry, 1)
    var expected := 115; var object_value := 17
    if selected == 1 { expected = 45; object_value = 12 }
    if selected == 6 { expected = 0; object_value = 7 }
    if selected == 7 { expected = 1521; object_value = 4 }
    arm.imm(&mut code, 1, i64(expected)); compare(&mut code, 0, 1); arm.branch(&mut code, failed, 3)
    for reg in 25..25 + homes {
        arm.imm(&mut code, 0, i64(reg) * 17 + 3); compare(&mut code, reg, 0); arm.branch(&mut code, failed, 3)
    }
    arm.load(&mut code, 0); arm.imm(&mut code, 1, i64(object_value)); compare(&mut code, 0, 1); arm.branch(&mut code, failed, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code); arm.mark(&mut code, failed); arm.exit(&mut code, 104)
    var image: []u8 = []; none: []i32 = []
    if target == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if target == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut code); if target == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print(ready); print(homes); print(skipped); print(frame_ops); print(object_ops); print(synchronized)
}
