fn words() -> [u32; 9] {
    [0, 1, 0b10, 3, 4, 5, 6, 0x2345_6789, 4294967295,]
}

fn main() {
    mut first := words()
    other := words()
    first[0] = 42
    assert(first.len == 9 && first[0] == 42 && other[0] == 0)
    assert(other[2] == 2 && other[7] == 0x23456789 && first[8] == 4294967295)
    mut small: [u8; 8] = [255, 1, 2, 3, 4, 5, 6, 7]
    mut halves: [i16; 8] = [0, 1, 2, 3, 4, 5, 6, 32767]
    mut wide: [u64; 8] = [0, 1, 2, 3, 4, 5, 6, 18446744073709551615]
    mut sizes: [usize; 8] = [0, 1, 2, 3, 4, 5, 6, 4294967295]
    assert(small[0] == 255 && halves[7] == 32767 && wide[7] == 0xffffffffffffffff)
    assert(sizes[7] == 4294967295)
    mixed := [0, 1, 2, 3, 4, 5, 6, 7, first[0] - 1]
    assert(mixed[8] == 41)
    print(42)
}
