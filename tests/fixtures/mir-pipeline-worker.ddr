// Real source tasks carry only public Data records. Each worker creates and
// destroys its own opaque scratch arenas; no Compiler/Code/cache is shared.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_pipeline as pipeline
pub struct Job { function: mir.Function, options: pipeline.Options, terminals: pipeline.Terminals }
pub struct Answer { function: mir.Function, status: pipeline.Status }
fn worker(job: Job) -> Answer {
    var function := job.function
    var workspace := pipeline.new()
    status := pipeline.run_into(&mut function, &mut workspace, &job.options, &job.terminals)
    Answer { function: function, status: status }
}
fn main() {
    var code := arm.new(); arm.imm(&mut code, 1, 5); arm.mov(&mut code, 2, 1)
    arm.emit(&mut code, 2332033024 + 2 * 65536 + 4 * 32); arm.emit(&mut code, 3596551104)
    var function := mir.new(); none: []i32 = []
    assert(lift.lift(&mut function, &code, 0, 0, 0, &none, 0))
    var job := Job { function: function, options: pipeline.options(), terminals: pipeline.no_terminals() }
    task scope jobs(2) {
        first := spawn jobs worker(job); second := spawn jobs worker(job)
        job.function.variant[0] = 0
        var answer := await jobs(first)
        assert(answer.status.error == 0 && answer.function.verified)
        assert(answer.status.stats.values_optimized == 1 && answer.status.stats.value_deleted == 2)
        assert(answer.status.stats.operations == 4 && answer.status.stats.opaque == 0)
        answer.function.modes[0] = 0
        cached := await jobs(first); other := await jobs(second)
        assert(cached.function.modes[0] == 2 && other.function.modes[0] == 2)
        assert(cached.function.imm[2] == 5 && other.function.imm[2] == 5)
    }
    print(42)
}
