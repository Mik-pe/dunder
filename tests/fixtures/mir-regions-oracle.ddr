// Independent finite regional-frame consumer; helpers observe actual incoming
// machine state and mutate bytes. Frame-lifetime permission grants no NoModRef.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_memory as memory
import ...selfhost.mir_call_inputs as inputs
import ...selfhost.mir_call_abi as abi
import ...selfhost.mir_ssa as ssa
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import .mir_region_qa_support as witness
import std.parse
import sys

fn integer(at: i32) -> i64 { value := parse.integer(sys.arg(at)); assert(value.ok); value.value }
fn seed(reg: i32) -> i64 { 123456789012345 + i64(reg) * 1000003 }
fn binary(c: &mut arm.Code, word: i64, d: i32, a: i32, b: i32) { arm.emit(&mut c, word + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn add(c: &mut arm.Code, d: i32, a: i32, b: i32) { binary(&mut c, 2332033024, d, a, b) }
fn sub(c: &mut arm.Code, d: i32, a: i32, b: i32) { binary(&mut c, 3405774848, d, a, b) }
fn cmp(c: &mut arm.Code, a: i32, b: i32) { binary(&mut c, 3942645760, 31, a, b) }
fn cset(c: &mut arm.Code, d: i32, condition: i32) { arm.emit(&mut c, 2594113504 + i64(condition.bit_xor(1)) * 4096 + i64(d)) }
fn view(c: &mut arm.Code, width: i32, d: i32, offset: i32, signed: bool) {
    var size := 0; if width == 2 { size = 1 }; if width == 4 { size = 2 }; if width == 8 { size = 3 }
    var base: i64 = 943718400; if signed { base = 947912704 }
    arm.emit(&mut c, base + i64(size) * 1073741824 + i64(offset).bit_and(511) * 4096 + 29 * 32 + i64(d))
}
fn triple(c: &mut arm.Code, width: i32, offset: i32, signed: bool) {
    view(&mut c, width, 0, offset, signed); view(&mut c, width, 2, offset, signed); sub(&mut c, 0, 0, 2)
    view(&mut c, width, 2, offset, signed); add(&mut c, 0, 0, 2)
}
fn expect(c: &mut arm.Code, actual: i32, wanted: i64, failed: i32) {
    arm.imm(&mut c, 1, wanted); cmp(&mut c, actual, 1); arm.branch(&mut c, failed, 3)
}
fn reset_inputs(c: &mut arm.Code, input: i64, control: i64, selected: i32) {
    for reg in 0..18 { arm.imm(&mut c, reg, seed(reg)) }
    arm.load(&mut c, 10); arm.imm(&mut c, 4, input); arm.imm(&mut c, 5, control)
    if selected == 12 { arm.load_into(&mut c, 9, 7) }
    cmp(&mut c, 4, 5)
}
fn helper(c: &mut arm.Code, failed: i32, selected: i32, input: i64, control: i64) {
    frame := arm.prologue(&mut c); arm.frame(&mut c, frame, 24)
    for reg in 0..18 { arm.store(&mut c, reg, reg) }
    for flag in 0..4 { cset(&mut c, 0, flag * 2); arm.store(&mut c, 18 + flag, 0) }
    for reg in 0..18 {
        arm.load(&mut c, reg)
        if reg == 0 || ((selected == 10 || selected == 14) && reg == 9) || (selected == 12 && reg == 7) {
            arm.mov(&mut c, 1, 0); view(&mut c, 8, 0, 0, false)
            var delta := 48; var base: i64 = 2432696320
            if reg == 9 { delta = 328; base = 3506438144 }; if reg == 7 { delta = 8; base = 3506438144 }
            arm.emit(&mut c, base + i64(delta) * 1024); cmp(&mut c, 1, 0); arm.branch(&mut c, failed, 3)
        } else {
            var wanted := seed(reg); if reg == 4 { wanted = input }; if reg == 5 { wanted = control }
            expect(&mut c, 0, wanted, failed)
        }
    }
    var a := input; var b := control; if selected == 4 || selected == 5 { a = control; b = 0 }
    difference := a.wrapping_sub(b); var carry := a >= b
    if a < 0 && b >= 0 { carry = true }; if a >= 0 && b < 0 { carry = false }
    overflow := (a < 0 && b >= 0 && difference >= 0) || (a >= 0 && b < 0 && difference < 0)
    flags: []bool = [difference == 0, carry, difference < 0, overflow]
    for flag in 0..4 { arm.load(&mut c, 18 + flag); var wanted := 0; if flags[flag] { wanted = 1 }; expect(&mut c, 0, i64(wanted), failed) }
    view(&mut c, 8, 0, 0, false); var bytes := 96; if selected == 10 || selected == 14 { bytes = 384 }
    arm.emit(&mut c, 3506438144 + i64(bytes) * 1024)
    arm.emit(&mut c, 2432696320 + 16 * 1024 + 29 * 32 + 1); cmp(&mut c, 1, 0); arm.branch(&mut c, failed, 3)
    if selected != 5 && selected != 6 && selected != 11 {
        view(&mut c, 8, 0, 0, false)
        if selected == 10 || selected == 14 { arm.emit(&mut c, 3506438144 + 328 * 1024); arm.emit(&mut c, 4181721088) }
        else { arm.emit(&mut c, 4164943872 + i64(-8).bit_and(511) * 4096) }
        expect(&mut c, 0, input, failed)
    }
    // Deliberately change only the low32 bits. High64-cell bits are neither
    // zero nor sign fill; the later mixed reads must observe their real value.
    view(&mut c, 8, 0, 0, false); arm.load_into(&mut c, 5, 1)
    if selected == 10 || selected == 14 { arm.emit(&mut c, 3506438144 + 328 * 1024); arm.emit(&mut c, 3103784961) }
    else { arm.emit(&mut c, 3087007744 + i64(-8).bit_and(511) * 4096 + 1) }
    for reg in 0..18 { arm.imm(&mut c, reg, 9000007 + i64(reg) * 101) }
    arm.imm(&mut c, 16, input); arm.imm(&mut c, 17, control); cmp(&mut c, 16, 17)
    arm.imm(&mut c, 0, 99); arm.ret(&mut c)
}
fn main() {
    platform := i32(integer(2)); selected := i32(integer(3)); enabled := sys.arg(4) == "on"
    input := integer(5); control := integer(6); expected := integer(7); limit := i32(integer(8))
    frame_contract := integer(9) != 0; terminal_contract := integer(10) != 0
    var c := arm.new_for(platform)
    wrapper := arm.label(&mut c); entry := arm.label(&mut c); failed := arm.label(&mut c)
    callee := arm.label(&mut c); again := arm.label(&mut c); zero := arm.label(&mut c)
    arm.branch(&mut c, wrapper, 1); arm.exit(&mut c, 0)
    arm.mark(&mut c, failed); arm.exit(&mut c, 104); arm.mark(&mut c, zero); arm.exit(&mut c, 102)
    arm.mark(&mut c, callee); helper(&mut c, failed, selected, input, control)
    arm.mark(&mut c, again); helper(&mut c, failed, selected, input, control.wrapping_add(1))
    first_word := c.words.len; first_label := c.labels.len; first_reloc := c.at.len
    arm.begin_mir(&mut c, true); arm.mark(&mut c, entry)
    frame := arm.prologue(&mut c); var slots := 12; if selected == 10 || selected == 14 { slots = 48 }; arm.frame(&mut c, frame, slots)
    arm.store(&mut c, 10, 0); if selected == 12 { arm.store(&mut c, 9, 7) }
    if selected == 5 {
        skip := arm.label(&mut c); cmp(&mut c, 5, 31); arm.branch(&mut c, skip, 2)
        arm.store(&mut c, 0, 4); arm.mark(&mut c, skip)
    } else if selected == 6 { arm.emit(&mut c, 3087007744 + i64(-8).bit_and(511) * 4096 + 29 * 32 + 4) }
    else if selected == 10 || selected == 14 { arm.store(&mut c, 40, 4) }
    else { if selected != 11 { arm.store(&mut c, 0, 4) } }
    if selected == 4 {
        join := arm.label(&mut c); cmp(&mut c, 5, 31); arm.branch(&mut c, join, 2)
        reset_inputs(&mut c, input, control, selected); cmp(&mut c, 5, 31)
        arm.branch(&mut c, callee, 1); arm.mark(&mut c, join); triple(&mut c, 4, -8, false)
    } else if selected == 7 {
        arm.imm(&mut c, 0, 0); arm.store(&mut c, 2, 0); arm.store(&mut c, 1, 5)
        head := arm.label(&mut c); done := arm.label(&mut c); arm.mark(&mut c, head)
        arm.load(&mut c, 1); cmp(&mut c, 0, 31); arm.branch(&mut c, done, 15)
        reset_inputs(&mut c, input, control, selected); arm.store(&mut c, 0, 4); arm.branch(&mut c, callee, 1)
        triple(&mut c, 4, -8, false); arm.load_into(&mut c, 2, 1); add(&mut c, 0, 0, 1); arm.store(&mut c, 2, 0)
        arm.load(&mut c, 1); arm.imm(&mut c, 1, 1); sub(&mut c, 0, 0, 1); arm.store(&mut c, 1, 0)
        arm.branch(&mut c, head, 0); arm.mark(&mut c, done); arm.load(&mut c, 2)
    } else {
        if selected == 8 { triple(&mut c, 4, -8, false); arm.store(&mut c, 1, 0); reset_inputs(&mut c, input, control, selected) }
        arm.branch(&mut c, callee, 1)
        if selected == 13 { arm.imm(&mut c, 5, control); cmp(&mut c, 5, 31); arm.branch(&mut c, zero, 2) }
        if selected == 0 { triple(&mut c, 8, -8, false) }
        else if selected == 2 {
            view(&mut c, 1, 0, -7, false); view(&mut c, 2, 1, -5, false); add(&mut c, 0, 0, 1)
            view(&mut c, 4, 1, -8, false); add(&mut c, 0, 0, 1); view(&mut c, 4, 1, -8, true); add(&mut c, 0, 0, 1)
            view(&mut c, 8, 1, -8, false); add(&mut c, 0, 0, 1)
        } else if selected == 10 || selected == 14 {
            arm.load(&mut c, 40); if selected == 10 { arm.mov(&mut c, 10, 9) }; arm.load_into(&mut c, 40, 2); sub(&mut c, 0, 0, 2)
            arm.load_into(&mut c, 40, 2); add(&mut c, 0, 0, 2); arm.load_into(&mut c, 40, 2); sub(&mut c, 0, 0, 2)
            arm.load_into(&mut c, 40, 2); add(&mut c, 0, 0, 2)
            if selected == 10 { sub(&mut c, 2, 9, 10); add(&mut c, 0, 0, 2) }
        } else {
            if selected == 9 { cset(&mut c, 3, 6) }
            triple(&mut c, 4, -8, false)
            if selected == 3 {
                arm.store(&mut c, 1, 0); reset_inputs(&mut c, input, control.wrapping_add(1), selected); arm.store(&mut c, 0, 4)
                arm.branch(&mut c, again, 1); triple(&mut c, 4, -8, false); arm.load_into(&mut c, 1, 1); add(&mut c, 0, 0, 1)
            } else if selected == 8 { arm.load_into(&mut c, 1, 1); add(&mut c, 0, 0, 1) }
            else if selected == 9 {
                cset(&mut c, 1, 6); arm.imm(&mut c, 2, 3); binary(&mut c, 2600500224, 3, 3, 2)
                arm.imm(&mut c, 2, 5); binary(&mut c, 2600500224, 1, 1, 2); add(&mut c, 0, 0, 3); add(&mut c, 0, 0, 1)
            } else if selected == 12 {
                arm.store(&mut c, 1, 0); arm.load_into(&mut c, 9, 7); arm.imm(&mut c, 5, control.wrapping_add(1))
                arm.emit(&mut c, 3103784960 + 7 * 32 + 5); triple(&mut c, 4, -8, false)
                arm.load_into(&mut c, 1, 1); add(&mut c, 0, 0, 1)
            }
        }
    }
    arm.ret(&mut c); if selected == 6 || selected == 11 { arm.store(&mut c, 0, 4) }; arm.end_mir(&mut c)
    var sites: []i32 = []; var f := mir.new()
    assert(lift.lift_spans(&mut f, &c, first_word, first_label, first_reloc, &sites, 0, &c.mir_starts, &c.mir_ends, &c.mir_kinds, &c.mir_a, &c.mir_b))
    assert(lift.own_entry(&mut f, &c, entry) && verify.verify(&mut f))
    print("HELPERS"); print(callee); print(again); print(zero); print("ENDHELPERS")
    print("ORIGINAL"); witness.dump(&f); witness.metadata(&f)
    var work := ssa.new(); var changed := false
    if enabled {
        mem := memory.conservative(); calls := inputs.conservative(); var terms := ssa.no_terminals()
        if terminal_contract { terms.version = 1; terms.overflow = zero; terms.zero = zero; terms.assertion = failed; terms.io = zero; terms.bounds = zero; terms.float_trap = zero }
        if frame_contract { life := abi.trusted_frame_lifetime_v1(); changed = ssa.optimize_with_frame_contracts_budget(&mut work, &mut f, &mem, &terms, &calls, &life, limit) }
        else { changed = ssa.optimize_with_contracts_budget(&mut work, &mut f, &mem, &terms, &calls, limit) }
    } else { assert(sys.arg(4) == "off") }
    assert(ssa.status(&work) != -1)
    print("RESULT"); witness.dump(&f); witness.metadata(&f)
    print("COUNTERS"); print(changed); print(ssa.status(&work)); print(ssa.units(&work)); print(ssa.cells(&work)); print(ssa.removed_loads(&work)); print(ssa.removed_stores(&work))
    print(ssa.copies(&work)); print(ssa.parameters(&work)); print(ssa.values(&work)); print(ssa.registers(&work)); print(ssa.removed_pushes(&work)); print(ssa.removed_pops(&work))
    assert(f.verified && verify.verify(&mut f)); var object := lower.new(); assert(lower.prepare(&mut object, &f, &c, &sites))
    lower.commit_code(&mut object, &mut c); lower.commit_imports(&mut object, &mut sites); print(c.words.len - first_word)
    print("CAPTURES"); print(ssa.captures(&work))
    arm.mark(&mut c, wrapper); reserve := arm.prologue(&mut c); arm.frame(&mut c, reserve, 4)
    for reg in 0..29 { arm.imm(&mut c, reg, seed(reg)) }
    if selected == 12 { arm.emit(&mut c, 3506438144 + 24 * 1024 + 31 * 32 + 7) }
    arm.emit(&mut c, 2432696320 + 31 * 32); arm.store(&mut c, 0, 0); arm.mov(&mut c, 0, 29); arm.store(&mut c, 2, 0)
    arm.imm(&mut c, 4, input); arm.imm(&mut c, 5, control); cmp(&mut c, 4, 5); arm.branch(&mut c, entry, 1)
    expect(&mut c, 0, expected, failed)
    for reg in 18..29 { arm.imm(&mut c, 0, seed(reg)); cmp(&mut c, reg, 0); arm.branch(&mut c, failed, 3) }
    arm.emit(&mut c, 2432696320 + 31 * 32); arm.load_into(&mut c, 0, 1); cmp(&mut c, 0, 1); arm.branch(&mut c, failed, 3)
    arm.load(&mut c, 2); cmp(&mut c, 29, 0); arm.branch(&mut c, failed, 3); arm.imm(&mut c, 0, 0); arm.ret(&mut c)
    var image: []u8 = []; none: []i32 = []
    if platform == 3 { a := wa.new(); result := wasm.image(&c, c.words.len, wrapper, 1, &a); assert(result.ok); image = result.text }
    else if platform == 2 { result := x86.finish(&c, c.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut c); if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
}
