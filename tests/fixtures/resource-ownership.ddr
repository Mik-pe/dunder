capability network, process, unsafe
import std.net as net
import std.process as process
import sys

struct ListenerOwner { listener: net.TcpListener }
enum StreamOwner { Live(net.TcpStream), Empty }

fn create_listener() -> net.TcpListener {
    opened := net.TcpListener::listen(net.loopback(), 0, 4)
    assert(opened.is_ok())
    opened.unwrap()
}
fn listener_port(listener: net.TcpListener) -> i32 { listener.local_port() }
fn relay_listener(move listener: net.TcpListener) -> net.TcpListener { listener }
fn relay_stream(move stream: net.TcpStream) -> StreamOwner { .Live(stream) }
fn relay_child(move child: process.Child) -> process.Child { child }

fn scope_closes_socket_owners() {
    mut listener_fd := -1
    {
        listener := create_listener()
        listener_fd = listener.fd()
        connected := net.TcpStream::connect(net.loopback(), listener.local_port())
        assert(connected.is_ok())
        accepted := listener.accept()
        assert(accepted.is_ok())
        stream := accepted.unwrap()
        mut fd := -1
        {
            mut streams := net.StreamSet::new()
            slot := streams.insert(connected.unwrap())
            fd = streams.fd(slot)
            payload: []u8 = [b'x']
            sent := streams.write_range(slot, &payload, 0, 1)
            assert(sent.is_ok() && sent.unwrap() == 1)
        }
        assert(unsafe { sys.net_close(fd) } < 0)
        mut data: []u8 = []
        received := stream.read_append(&mut data, 1)
        assert(received.is_ok() && received.unwrap() == 1 && data[0] == b'x')
    }
    assert(unsafe { sys.net_close(listener_fd) } < 0)
    mut udp_fd := -1
    {
        bound := net.UdpSocket::bind(net.SocketAddr::loopback_v4(0))
        assert(bound.is_ok())
        udp := bound.unwrap()
        udp_fd = udp.fd()
        assert(udp_fd >= 0)
    }
    assert(unsafe { sys.net_close(udp_fd) } < 0)
}

fn main() {
    listener := create_listener()
    listener_fd := listener.fd()
    port := listener_port(listener)
    assert(port > 0 && listener_port(listener) == port)
    wrapped := ListenerOwner { listener: relay_listener(move listener) }
    mut received := wrapped.listener
    assert(received.fd() == listener_fd)

    connected := net.TcpStream::connect(net.loopback(), port)
    assert(connected.is_ok())
    client := connected.unwrap()
    client_fd := client.fd()
    accepted := received.accept()
    assert(accepted.is_ok())
    mut server := accepted.unwrap()
    assert(received.close().ok)
    assert(received.fd() == -1)
    assert(received.close().ok)

    wrapped_client := relay_stream(move client)
    match move wrapped_client {
        .Live(stream) => {
            mut owner := stream
            assert(owner.fd() == client_fd)
            assert(owner.close().ok)
            assert(owner.fd() == -1)
            assert(owner.close().ok)
        },
        .Empty => { assert(false) },
    }
    assert(server.close().ok)

    command := process.Command::new("/usr/bin/true", [])
    spawned := command.spawn()
    assert(spawned.is_ok())
    child := spawned.unwrap()
    pid := child.pid()
    mut received_child := relay_child(move child)
    assert(received_child.pid() == pid)
    waited := received_child.wait(5000)
    assert(waited.ok && waited.exited && waited.code == 0)
    again := received_child.wait(5000)
    assert(again.ok && again.exited && again.code == 0)
    scope_closes_socket_owners()
    print("resource handles ok")
}
