capability network, process
import std.net as net
import std.process as process
import sys

struct ListenerOwner { listener: net.TcpListener }
enum StreamOwner { Live(net.TcpStream), Empty }

fn create_listener() -> net.TcpListener {
    opened := net.listen(net.loopback(), 0, 4)
    assert(opened.ok)
    opened.listener
}
fn listener_port(listener: net.TcpListener) -> i32 { net.local_port(&listener) }
fn relay_listener(move listener: net.TcpListener) -> net.TcpListener { listener }
fn relay_stream(move stream: net.TcpStream) -> StreamOwner { .Live(stream) }
fn relay_child(move child: process.Child) -> process.Child { child }

fn scope_closes_socket_owners() {
    mut listener_fd := -1
    {
        listener := create_listener()
        listener_fd = net.listener_fd(&listener)
        connected := net.connect(net.loopback(), listener.local_port())
        assert(connected.ok)
        accepted := listener.accept()
        assert(accepted.ok)
        stream := accepted.stream
        mut fd := -1
        {
            mut streams := net.StreamSet::new()
            slot := streams.insert(move connected.stream)
            fd = streams.fd(slot)
            payload: []u8 = [b'x']
            sent := streams.write_range(slot, &payload, 0, 1)
            assert(sent.ok && sent.count == 1)
        }
        assert(sys.net_close(fd) < 0)
        mut data: []u8 = []
        received := stream.read_append(&mut data, 1)
        assert(received.ok && received.count == 1 && data[0] == b'x')
    }
    assert(sys.net_close(listener_fd) < 0)
    mut udp_fd := -1
    {
        bound := net.bind_udp(net.SocketAddr::loopback_v4(0))
        assert(bound.ok)
        udp := bound.socket
        udp_fd = udp.fd()
        assert(udp_fd >= 0)
    }
    assert(sys.net_close(udp_fd) < 0)
}

fn main() {
    listener := create_listener()
    listener_fd := net.listener_fd(&listener)
    port := listener_port(listener)
    assert(port > 0 && listener_port(listener) == port)
    wrapped := ListenerOwner { listener: relay_listener(move listener) }
    mut received := wrapped.listener
    assert(net.listener_fd(&received) == listener_fd)

    connected := net.connect(net.loopback(), port)
    assert(connected.ok)
    client := connected.stream
    client_fd := net.stream_fd(&client)
    accepted := net.accept(&received)
    assert(accepted.ok)
    mut server := accepted.stream
    assert(net.close_listener(&mut received).ok)
    assert(net.listener_fd(&received) == -1)
    assert(net.close_listener(&mut received).ok)

    wrapped_client := relay_stream(move client)
    match move wrapped_client {
        .Live(stream) => {
            mut owner := stream
            assert(net.stream_fd(&owner) == client_fd)
            assert(net.close(&mut owner).ok)
            assert(net.stream_fd(&owner) == -1)
            assert(net.close(&mut owner).ok)
        },
        .Empty => { assert(false) },
    }
    assert(net.close(&mut server).ok)

    command := process.command("/usr/bin/true", [])
    spawned := process.spawn(&command)
    assert(spawned.ok)
    child := spawned.child
    pid := process.child_pid(&child)
    mut received_child := relay_child(move child)
    assert(process.child_pid(&received_child) == pid)
    waited := process.wait(&mut received_child, 5000)
    assert(waited.ok && waited.exited && waited.code == 0)
    again := process.wait(&mut received_child, 5000)
    assert(again.ok && again.exited && again.code == 0)
    scope_closes_socket_owners()
    print("resource handles ok")
}
