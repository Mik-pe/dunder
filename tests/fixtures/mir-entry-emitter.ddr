// Seed real reserved storage in an earlier frame, then observe those old bits
// through an unknown-memory call before the target's first original Store.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_opt as opt
import ...selfhost.mir_memory as memory
import ...selfhost.mir_terminals as terminals
import ...selfhost.mir_call_abi as call_abi
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys
fn integer(at: i32) -> i32 { i32(decimal.integer(sys.arg(at)).value) }
fn add(code: &mut arm.Code, dst: i32, a: i32, b: i32) { arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst)) }
fn compare(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn main() {
    target := integer(2); large := sys.arg(3) == "large"; enabled := sys.arg(4) == "on"
    var code := arm.new_for(target)
    wrapper := arm.label(&mut code); entry := arm.label(&mut code); seed := arm.label(&mut code)
    observer := arm.label(&mut code); failed := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, seed); seeded := arm.prologue(&mut code); arm.frame(&mut code, seeded, 4)
    arm.imm(&mut code, 0, 37); arm.store(&mut code, 0, 0)
    arm.imm(&mut code, 0, 123456789); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, -1); arm.store(&mut code, 2, 0); arm.ret(&mut code)
    arm.mark(&mut code, observer); observed := arm.prologue(&mut code); arm.frame(&mut code, observed, 4)
    for reg in 25..29 { arm.store(&mut code, reg - 25, reg) }
    arm.emit(&mut code, 4181721088 + 29 * 32) // Caller FP from saved linkage.
    arm.emit(&mut code, 4164943872 + 504 * 4096) // LDUR x0,[x0,#-8]: prior caller cell.
    for reg in 25..29 { arm.imm(&mut code, reg, i64(reg) * 1000003) }
    for reg in 25..29 { arm.load_into(&mut code, reg - 25, reg) }
    arm.ret(&mut code)
    first_word := code.words.len; first_label := code.labels.len; first_reloc := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); var slots := 4; if large { slots = 80 }
    arm.frame(&mut code, frame, slots)
    // Establish an original x9 definition before the call. The liveness proof
    // can then permit large inserted preservation cells to use scratch9.
    if large { arm.imm(&mut code, 9, 17) }
    arm.branch(&mut code, observer, 1); arm.store(&mut code, 3, 0)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    compare(&mut code, 1, 0); arm.branch(&mut code, done, 12)
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 0); arm.pop(&mut code, 1)
    add(&mut code, 0, 1, 0); arm.store(&mut code, 1, 0)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 3); arm.pop(&mut code, 1)
    add(&mut code, 0, 0, 1); arm.ret(&mut code)
    var sites: []i32 = []; var function := mir.new()
    assert(lift.lift(&mut function, &code, first_word, first_label, first_reloc, &sites, 0))
    assert(lift.own_entry(&mut function, &code, entry) && verify.verify(&mut function))
    var work := opt.new(); var homes := 0
    if enabled {
        context := memory.conservative(); exits := terminals.no_terminals(); calls := call_abi.trusted_source_abi_v1()
        assert(opt.analyze_with_contracts_budget(&mut work, &function, &context, &exits, &calls, 4194304)); homes = opt.promoted(&work)
        assert(homes == 3); opt.apply(&mut work, &mut function); assert(verify.verify(&mut function))
    } else { assert(sys.arg(4) == "off") }
    var lowering := lower.new(); assert(lower.prepare(&mut lowering, &function, &code, &sites))
    lower.commit_code(&mut lowering, &mut code); lower.commit_imports(&mut lowering, &mut sites)
    arm.mark(&mut code, wrapper); outer := arm.prologue(&mut code); arm.frame(&mut code, outer, 0)
    arm.branch(&mut code, seed, 1)
    for reg in 25..29 { arm.imm(&mut code, reg, i64(reg) * 17 + 3) }
    arm.branch(&mut code, entry, 1); arm.imm(&mut code, 1, 82); compare(&mut code, 0, 1); arm.branch(&mut code, failed, 3)
    for reg in 25..25 + homes {
        arm.imm(&mut code, 0, i64(reg) * 17 + 3); compare(&mut code, reg, 0); arm.branch(&mut code, failed, 3)
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code); arm.mark(&mut code, failed); arm.exit(&mut code, 104)
    var image: []u8 = []; none: []i32 = []
    if target == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if target == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut code); if target == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok); print(homes)
}
