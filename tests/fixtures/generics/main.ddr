import .library as lib
import .library as again
import .reexport
import .reexport.Step as State
import std.array

struct Pair<A, B> { first: A, second: B }
enum Answer<T, E> { Yes(T), No(E) }
trait Measurable { fn size(&self) -> i32 }
struct Stored<T> where T: Storable { item: T }
struct Sized<T> where T: Measurable { item: T }
struct Measure { n: i32 }
impl Measurable for Measure { fn size(&self) -> i32 { self.n } }

fn same_tuple(move x: lib.Box<(i32, bool,)>) -> again.Box<(i32, bool)> { x }
fn empty_map() -> Map<i32, bool> { Map<i32, bool>::new() }
fn wide<T>() -> T { 8000000000 }
fn choose<T>(x: T) -> i32 where T: Measurable {
    return if x.size() == 9 { 19 } else { 42 }
}
impl Stored<A> where A: Measurable {
    fn measured(&self) -> i32 { self.item.size() }
}
fn contextual<T>(flag: bool) -> i32 {
    n: T = if flag { 1 } else { 2 }
    42
}

impl Stored<A> {
    fn number(&self) -> i32 { 42 }
    fn length(&self) -> i32 { self.item.len }
    fn sized(&self) -> i32 { Sized<A> { item: self.item }.item.size() }
    fn grow(&self) -> i32 { Stored<[]A> { item: [] }.grow() }
}

fn count<T>(x: T, n: i32) -> i32 {
    if n == 0 { return 0 }
    1 + count<T>(x, n - 1)
}

fn type() -> i32 { 42 }
fn count_phase(p: State) -> i32 {
    match p { reexport.Step.Start => 0, lib.Phase.Next(n) => n }
}

fn same_numbers(values: &[]i64, other: &[]i64, operator: bool) -> bool {
    if operator { values == other } else { array.equal<i64>(&values, &other) }
}
fn same_page<T: Eq>(left: &T, right: &T, values: &[]i64, other: &[]i64, operator: bool) -> bool {
    left == right && same_numbers(&values, &other, operator)
}
fn measure<T: Measurable>(values: &[]T) -> i32 {
    mut total := 0
    for value in values { total += value.size() }
    total
}
struct Menu {}
trait Named { fn name(move self) -> string }
struct Label { text: string }
impl Named for Label { fn name(move self) -> string { move self.text } }
impl Menu {
    fn labels<T: Named>(move items: []T) -> []string {
        mut names: []string = []
        for item in move items { names.push(item.name()) }
        names
    }
}

fn main() {
    first_phase: lib.Phase = reexport.Step.Next(21)
    second_phase: reexport.Step = lib.Phase.Next(15)
    assert(reexport.value(first_phase) + lib.phase_value(second_phase) + count_phase(State.Next(6)) == 42)
    assert(count_phase(reexport.Step.Start) == 0 && reexport.Size { n: 42 }.n == type())

    left: []i64 = [2, 4]
    equal: []i64 = [2, 4]
    different: []i64 = [2, 5]
    for operator in [true, false] {
        assert(same_page<i32>(&1, &1, &left, &equal, operator))
        assert(!same_page<i32>(&1, &1, &left, &different, operator))
    }
    assert(measure(&[Measure { n: 2 }, Measure { n: 3 }]) == 5)
    assert(Menu::labels([Label { text: "Norr" }, Label { text: "Söder" }]) == ["Norr", "Söder"])
    sample := lib.Reading { number: lib.Box<i32>::new(1) }
    assert(lib.first(sample.view()) == 42)

    tuple := same_tuple(lib.boxed<(i32, bool)>((42, true)))
    assert(tuple.value.0 == 42)
    assert(Stored<i32> { item: 1 }.number() == 42)
    assert(Stored<Measure> { item: Measure { n: 17 } }.measured() == 17)
    assert(Stored<string> { item: "abc" }.length() == 3)
    assert(Sized<Measure> { item: Measure { n: 9 } }.item.size() == 9)
    assert(wide<i64>() == 8000000000 && choose<Measure>(Measure { n: 9 }) == 19 && contextual<i64>(true) == 42)
    {
        Map := 1
        table: Map<i32, bool> = empty_map()
        assert(table.len() == 0)
        limit := 2
        assert(Map < limit && limit > 0)
    }
    assert(lib.identity<i32>(42) == 42)
    assert(lib.shadow<i32>(42) == 42)
    assert(lib.compare<bool>(2) == 42)
    callback := lib.identity<i32>
    assert(callback(19) == 19)
    pair := Pair<i32, string> { first: 4, second: "hello" }
    box := lib.boxed<Pair<i32, string>>(move pair)
    assert(count<lib.Box<Pair<i32, string>>>(box, 3) == 3)
    answer := Answer<lib.Maybe<i32>, string>.Yes(.Some(box.value.first))
    match answer {
        .Yes(lib.Maybe<i32>.Some(n)) => { assert(n == 4) },
        _ => { assert(false) },
    }
    mut boxes := Map<string, lib.Box<[]i32>>::new()
    boxes.put("numbers", lib.boxed<[]i32>([20, 22]))
    values := boxes.at("numbers")
    assert(values.value[0] + values.value[1] == 42)
    match lib.wrapped<i32>(19) {
        .T(n) => { assert(n == 19) },
        .Empty => { assert(false) },
    }
    h := lib.Hidden<bool>::make(true)
    assert(h.answer() == 42)
    assert(lib.identity<string>("owned") == "owned")
    a := lib.converter().unwrap()
    b := lib.Converter<bool> { sample: true }
    assert(a.forward(2) == 2 && b.forward(3) == 3)
    assert(b.forward(false) == false && a.forward(true))
    print(42)
}
