import .library as lib

struct Pair<A, B> { first: A, second: B }
enum Answer<T, E> { Yes(T), No(E) }

fn count<T>(x: T, n: i32) -> i32 {
    if n == 0 { return 0 }
    1 + count<T>(x, n - 1)
}

fn main() {
    assert(lib.identity<i32>(42) == 42)
    assert(lib.shadow<i32>(42) == 42)
    assert(lib.compare<bool>(2) == 42)
    callback := lib.identity<i32>
    assert(callback(19) == 19)
    pair := Pair<i32, string> { first: 4, second: "hello" }
    box := lib.boxed<Pair<i32, string>>(move pair)
    assert(count<lib.Box<Pair<i32, string>>>(box, 3) == 3)
    answer := Answer<lib.Maybe<i32>, string>.Yes(.Some(box.value.first))
    match answer {
        .Yes(lib.Maybe<i32>.Some(n)) => { assert(n == 4) },
        _ => { assert(false) },
    }
    mut boxes := Map<string, lib.Box<[]i32>>::new()
    boxes.put("numbers", lib.boxed<[]i32>([20, 22]))
    values := boxes.at("numbers")
    assert(values.value[0] + values.value[1] == 42)
    match lib.wrapped<i32>(19) {
        .T(n) => { assert(n == 19) },
        .Empty => { assert(false) },
    }
    h := lib.Hidden<bool>::make(true)
    assert(h.answer() == 42)
    assert(lib.identity<string>("owned") == "owned")
    print(42)
}
