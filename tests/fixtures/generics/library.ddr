pub struct Box<T> { value: T }
pub struct Item { n: i32 }
pub enum Maybe<T> { Some(T), None }

impl Box<T> {
    pub fn new(move value: T) -> Self { Self { value: move value } }
    pub fn unwrap(move self) -> T { self.value }
}

pub fn identity<T>(move value: T) -> T { value }
pub fn boxed<T>(move value: T) -> Box<T> { Box<T>::new(move value) }

struct T { flag: bool }

pub enum Named<T> { T(T), Empty }

fn secret<T>(move value: T) -> T { value }

pub fn wrapped<T>(move value: T) -> Named<T> {
    .T(secret<T>(move value))
}

pub opaque struct Hidden<T> { value: T }
impl Hidden<A> {
    pub fn make(move value: A) -> Self { Self { value: move value } }
    fn internal(&self) -> i32 { 42 }
    pub fn answer(&self) -> i32 { self.internal() }
}

pub fn shadow<T>(T: T) -> T {
    value: T = T
    value
}

pub fn compare<T>(n: i32) -> i32 {
    T := 42
    if n < 5 { return T }
    7
}

pub struct Reading { number: Box<i32> }

impl Reading {
    pub fn view(&self) -> &Box<i32> from self { &self.number }
}

pub fn first<T>(value: &Box<T>) -> i32 { 42 }

pub struct Converter<A> { sample: A }

impl Converter<A> {
    pub fn forward<B>(&self, value: B) -> B { self.convert(value) }
    fn convert<B>(&self, value: B) -> B { value }
}

pub fn converter() -> Result<Converter<i32>, string> {
    .Ok(Converter<i32> { sample: 7 })
}

pub enum Phase { Start, Next(i32) }
pub fn phase_value(p: Phase) -> i32 { match p { .Start => 0, .Next(n) => n } }
