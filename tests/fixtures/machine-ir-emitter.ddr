// Build the same two functions through direct and prepared suffix rewrites.
import ...selfhost.arm64 as arm
import ...selfhost.machine_ir as mir
import ...selfhost.macho as macho
import ...selfhost.elf as elf
import ...selfhost.x86 as x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as parse
import sys

fn apply(work: &mut mir.Workspace, code: &mut arm.Code, sites: &mut []i32,
    word: i32, label: i32, reloc: i32, mode: string) -> i32 {
    before := code.words.len
    if mode == "compact" { assert(mir.compact(&mut work, &mut code, word, label, reloc, &mut sites, 0)) }
    else if mode == "split" {
        assert(mir.prepare(&mut work, &code, word, label, reloc, &sites, 0))
        mir.commit_code(&mut work, &mut code); mir.commit_imports(&mut work, &mut sites)
    } else if mode == "duplicate-code" || mode == "duplicate-imports" || mode == "grow-code" || mode == "grow-imports" {
        assert(mir.prepare(&mut work, &code, word, label, reloc, &sites, 0))
        if mode == "grow-code" { arm.imm(&mut code, 0, 0) }
        if mode == "grow-imports" { sites.push(0) }
        mir.commit_code(&mut work, &mut code); mir.commit_imports(&mut work, &mut sites)
        if mode == "duplicate-code" { mir.commit_code(&mut work, &mut code) }
        if mode == "duplicate-imports" { mir.commit_imports(&mut work, &mut sites) }
    } else { assert(mode == "none") }
    before - code.words.len
}
fn main() {
    platform := i32(parse.integer(sys.arg(2)).value); mode := sys.arg(3)
    expected := parse.integer(sys.arg(4)).value
    var code := arm.new_for(platform); var sites: []i32 = []; var work := mir.new()
    entry := arm.label(&mut code); helper := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    var first_word := code.words.len; var first_label := code.labels.len; var first_reloc := code.at.len
    arm.mark(&mut code, entry); var frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    // An unused temporary still performs real frame writes in the original.
    var start := code.words.len; arm.imm(&mut code, 0, 1234567); arm.store(&mut code, 0, 0)
    assert(mir.add_range(&mut work, start, code.words.len))
    arm.imm(&mut code, 0, 5); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 1); arm.branch(&mut code, done, 18)
    start = code.words.len; arm.imm(&mut code, 0, 7654321); arm.store(&mut code, 0, 0)
    assert(mir.add_range(&mut work, start, code.words.len))
    arm.load(&mut code, 2); arm.imm(&mut code, 1, 3); arm.emit(&mut code, 2332033056); arm.store(&mut code, 2, 0)
    arm.load(&mut code, 1); arm.mov(&mut code, 1, 0); arm.imm(&mut code, 0, 1); arm.emit(&mut code, 3405774880); arm.store(&mut code, 1, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
    arm.branch(&mut code, helper, 1); arm.mov(&mut code, 1, 0); arm.load(&mut code, 2); arm.emit(&mut code, 2332033056)
    arm.imm(&mut code, 2, expected); arm.emit(&mut code, 3942776863); arm.branch(&mut code, assertion, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    var removed := apply(&mut work, &mut code, &mut sites, first_word, first_label, first_reloc, mode)
    // Unexpected acceptance must return success to the driver so its negative
    // test fails. Do not hide a missed guard behind a later assertion.
    if mode != "none" && mode != "compact" && mode != "split" { return }
    assert(code.labels[entry] == first_word)
    mir.reset(&mut work)
    first_word = code.words.len; first_label = code.labels.len; first_reloc = code.at.len
    arm.mark(&mut code, helper); frame = arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    data := arm.label(&mut code)
    start = code.words.len; arm.imm(&mut code, 9, 9876543)
    assert(mir.add_range(&mut work, start, code.words.len))
    arm.branch(&mut code, data, 20); arm.emit(&mut code, 4181721088); arm.ret(&mut code)
    removed = removed + apply(&mut work, &mut code, &mut sites, first_word, first_label, first_reloc, mode)
    assert(code.labels[helper] == first_word && code.labels[data] == -1)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    end := code.words.len; arm.mark(&mut code, data); arm.emit(&mut code, 27); arm.emit(&mut code, 0)
    var image: []u8 = []
    if platform == 3 {
        abi := wa.new(); result := wasm.image(&code, end, entry, 1, &abi); assert(result.ok); image = result.text
    } else if platform == 2 {
        result := x86.finish(&code, end, &sites, &sites); assert(result.ok); image = elf.image_for(&result.text, 62)
    } else {
        text := arm.finish(&mut code)
        if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) }
    }
    saved := sys.write_u8(sys.arg(1), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(1)); assert(executable.ok)
    print(removed)
}
