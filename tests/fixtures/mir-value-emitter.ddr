// Whole-function scalar-value test fixture. Input values enter at the function
// ABI boundary. Baseline and transformed semantic MIR are exported for an
// independent interpreter; actual images check the externally computed result.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_value_prop as values
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys
fn number(at: i32) -> i64 { result := decimal.integer(sys.arg(at)); assert(result.ok); result.value }
fn binary(code: &mut arm.Code, base: i64, dst: i32, a: i32, b: i32) { arm.emit(&mut code, base + i64(b) * 65536 + i64(a) * 32 + i64(dst)) }
fn dump(f: &mir.Function) {
    print("MIR1"); print(f.kinds.len)
    for op in 0..f.kinds.len {
        print(f.kinds[op]); print(f.opcodes[op]); print(f.dst[op]); print(f.a[op]); print(f.b[op]); print(f.c[op])
        print(f.imm[op]); print(f.aux[op]); print(f.types[op]); print(f.place[op]); print(f.extensions[op])
        print(f.effects[op]); print(f.flags[op]); print(f.abi[op]); print(f.reads[op]); print(f.writes[op]); print(f.clobbers[op])
        print(f.modes[op]); print(f.targets[op])
    }
    print("PLACES"); print(f.place_kinds.len)
    for p in 0..f.place_kinds.len { print(f.place_kinds[p]); print(f.place_offsets[p]); print(f.place_widths[p]) }
    print("LABELS"); print(f.label_ids.len)
    for l in 0..f.label_ids.len { print(f.label_ids[l]); print(f.label_ops[l]) }
    print("ORDER"); print(f.order.len); for op in f.order { print(op) }; print("END")
}
fn main() {
    target := i32(number(2)); selected := i32(number(3)); enabled := sys.arg(4) == "on"
    input := number(5); condition := number(6); expected := number(7)
    var code := arm.new_for(target); wrapper := arm.label(&mut code); entry := arm.label(&mut code)
    failed := arm.label(&mut code); overflow := arm.label(&mut code); callee := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.exit(&mut code, 0)
    arm.mark(&mut code, failed); arm.exit(&mut code, 104); arm.mark(&mut code, overflow); arm.exit(&mut code, 101)
    arm.mark(&mut code, callee); helper := arm.prologue(&mut code); arm.frame(&mut code, helper, 0)
    arm.imm(&mut code, 1, 99); arm.ret(&mut code)
    first := code.words.len; first_label := code.labels.len; first_reloc := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    if selected == 0 {
        arm.imm(&mut code, 1, 5); arm.mov(&mut code, 2, 1); arm.mov(&mut code, 3, 2)
        binary(&mut code, 2332033024, 0, 4, 3)
    } else if selected == 1 || selected == 2 || selected == 12 {
        other := arm.label(&mut code); join := arm.label(&mut code); arm.branch(&mut code, other, 18)
        var first_value: i64 = 11; var second_value: i64 = 11
        if selected == 2 { second_value = 12 }; if selected == 12 { first_value = 4294967297; second_value = 8589934593 }
        arm.imm(&mut code, 1, first_value); arm.branch(&mut code, join, 0); arm.mark(&mut code, other)
        arm.imm(&mut code, 1, second_value); arm.mark(&mut code, join)
        if selected == 12 { arm.emit(&mut code, 704644064 + 1 * 65536 + 2); binary(&mut code, 2332033024, 0, 4, 2) }
        else { binary(&mut code, 2332033024, 0, 4, 1) }
    } else if selected == 3 {
        path := arm.label(&mut code); join := arm.label(&mut code); arm.branch(&mut code, path, 0)
        arm.imm(&mut code, 1, 99); arm.branch(&mut code, join, 0); arm.mark(&mut code, path)
        arm.imm(&mut code, 1, 11); arm.mark(&mut code, join); binary(&mut code, 2332033024, 0, 4, 1)
    } else if selected == 4 {
        head := arm.label(&mut code); done := arm.label(&mut code)
        arm.imm(&mut code, 3, 1); arm.imm(&mut code, 0, 3); arm.mov(&mut code, 1, 4); arm.mark(&mut code, head)
        arm.mov(&mut code, 2, 1); binary(&mut code, 2332033024, 1, 1, 3)
        binary(&mut code, 3942645760, 31, 1, 2); arm.branch(&mut code, failed, 2)
        binary(&mut code, 3405774848, 0, 0, 3); arm.branch(&mut code, done, 18); arm.branch(&mut code, head, 0)
        arm.mark(&mut code, done); arm.mov(&mut code, 0, 1)
    } else if selected == 5 {
        arm.emit(&mut code, 704644064 + 4 * 65536 + 2); arm.mov(&mut code, 0, 2)
    } else if selected == 6 {
        arm.emit(&mut code, 704644064 + 4 * 65536 + 2); binary(&mut code, 184549376, 0, 2, 0)
    } else if selected == 7 {
        arm.imm(&mut code, 1, 4294967297); arm.emit(&mut code, 704644064 + 1 * 65536 + 2)
        binary(&mut code, 2332033024, 0, 4, 2)
    } else if selected == 8 {
        arm.imm(&mut code, 1, 9); arm.branch(&mut code, callee, 1); binary(&mut code, 2332033024, 0, 4, 1)
    } else if selected == 9 {
        arm.mov(&mut code, 0, 4); arm.store(&mut code, 0, 0); arm.load(&mut code, 0); arm.mov(&mut code, 2, 0)
        arm.imm(&mut code, 0, 17); arm.store(&mut code, 0, 0); arm.load(&mut code, 0)
        binary(&mut code, 2332033024, 0, 0, 2)
    } else if selected == 10 {
        arm.imm(&mut code, 1, 1); binary(&mut code, 2868903936, 0, 4, 1); arm.branch(&mut code, overflow, 8)
    } else if selected == 11 {
        done := arm.label(&mut code); arm.branch(&mut code, done, 18)
        arm.imm(&mut code, 1, 0); arm.emit(&mut code, 4181721088 + 1 * 32)
        arm.mark(&mut code, done)
    } else if selected == 13 {
        body := arm.label(&mut code); arm.imm(&mut code, 1, 7); arm.mov(&mut code, 2, 1); arm.branch(&mut code, body, 0)
        arm.mark(&mut code, body); arm.mov(&mut code, 3, 2); arm.mov(&mut code, 0, 4)
    } else { assert(false) }
    arm.ret(&mut code); var sites: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, first, first_label, first_reloc, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    print("ORIGINAL"); dump(&f); var work := values.new()
    if enabled { changed := values.optimize_into(&mut work, &mut f); if changed { assert(f.verified) } else { assert(values.status(&work) == 0 || values.status(&work) == -2) } }
    else { assert(sys.arg(4) == "off") }
    print("RESULT"); dump(&f); print("COUNTERS"); print(values.rewritten(&work)); print(values.deleted(&work)); print(values.constant_immediates(&work)); print(values.units(&work))
    var lowering := lower.new(); assert(lower.prepare(&mut lowering, &f, &code, &sites))
    lower.commit_code(&mut lowering, &mut code); lower.commit_imports(&mut lowering, &mut sites)
    arm.mark(&mut code, wrapper); wrapper_frame := arm.prologue(&mut code); arm.frame(&mut code, wrapper_frame, 0)
    arm.imm(&mut code, 4, input); arm.imm(&mut code, 0, condition); arm.branch(&mut code, entry, 1)
    arm.imm(&mut code, 1, expected); binary(&mut code, 3942645760, 31, 0, 1); arm.branch(&mut code, failed, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    var image: []u8 = []; none: []i32 = []
    if target == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if target == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut code); if target == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
}
