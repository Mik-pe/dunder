capability unsafe, process

import std.alloc
import sys

fn suffix_sum(view: &alloc.ByteView, first: usize) -> i32 {
    mut end := view.len()
    mut total := 0
    while end > first {
        end -= usize(1)
        total += i32(view.get(end).unwrap())
    }
    total
}

fn inspect(view: &alloc.ByteView) -> i32 {
    if target_is("wasm32") { assert(view.len() == usize(16)) }
    else { assert(view.len() == usize(2147483652)) }
    last := view.len() - usize(4)
    head := view.window(usize(0), usize(1))
    tail := view.window(last, view.len())
    empty := view.window(view.len(), view.len())
    assert(head[0] == u8(7) && tail.len == 4 && empty.len == 0)
    assert(view.get(last) == .Some(u8(4)) && view.get(view.len() - usize(1)) == .Some(u8(1)))
    assert(view.get(view.len()) == .None)
    assert(i64(empty.len) - 1 == -1)
    assert(suffix_sum(&view, last) == 10 && suffix_sum(&view, view.len()) == 0)
    mut signed := i64(view.len()) - 1
    mut total := 0
    while signed >= i64(last) {
        total += i32(view.get(usize(signed)).unwrap())
        signed -= 1
    }
    total
}

fn wide_window(view: &alloc.ByteView) -> i32 {
    all := view.window(usize(0), view.len())
    all.len
}

fn check_empty(view: &alloc.ByteView) {
    assert(view.len() == usize(0) && view.get(usize(0)) == .None)
    empty := view.window(usize(0), usize(0))
    assert(empty.len == 0)
}

fn check_wasm() {
    assert(alloc.layout_array<u32>(usize(536870911)).is_ok())
    assert(alloc.layout_array<u32>(usize(536870912)).is_err())
    mut pool := alloc.Global::new()
    layout := alloc.Layout::bytes(usize(16)).unwrap()
    unsafe {
        block := pool.alloc_zeroed(layout).unwrap()
        store_u8(block.address(), u8(7))
        store_u32(ptr(usize(block.address()) + usize(12)), u32(16909060))
        assert(alloc.with_bytes(block, inspect) == 10)
        pool.dealloc(block, layout)
    }
}

fn check_native() {
    count := usize(536870913)
    layout := alloc.layout_array<u32>(count).unwrap()
    assert(layout.size() == usize(2147483652) && layout.align() == usize(4))
    mut system := alloc.System::default()
    unsafe {
        block := system.alloc(layout).unwrap()
        start := usize(block.address())
        last := (count - usize(1)) * size_of(u32)
        store_u32(block.address(), u32(7))
        store_u32(ptr(start + last), u32(16909060))
        assert(load_u32(ptr(start + last)) == u32(16909060))
        if sys.arg_count() > 1 {
            print(alloc.with_bytes(block, wide_window))
        }
        assert(alloc.with_bytes(block, inspect) == 10)
        system.dealloc(block, layout)
    }
}

fn main() {
    empty := alloc.Block::empty()
    unsafe { alloc.with_bytes<()>(empty, check_empty) }
    if target_is("wasm32") { check_wasm() } else { check_native() }
}
