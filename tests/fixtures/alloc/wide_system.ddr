capability unsafe, process

import std.alloc
import sys

unsafe fn window(owner: &alloc.Block, first: usize, end: usize) -> &[]u8 from owner {
    assert(first <= end && end <= owner.size())
    length := end - first
    assert(length <= usize(2147483647))
    return bytes_view(&owner, ptr(usize(owner.address()) + first), length)
}

unsafe fn suffix_sum(owner: &alloc.Block, first: usize) -> i32 {
    mut end := owner.size()
    mut total := 0
    while end > first {
        end -= usize(1)
        byte := window(&owner, end, end + usize(1))
        total += i32(byte[0])
    }
    total
}

fn main() {
    count := usize(536870913)
    layout := alloc.layout_array<u32>(count).unwrap()
    assert(layout.size() == usize(2147483652) && layout.align() == usize(4))
    mut system := alloc.System::default()
    unsafe {
        block := system.alloc(layout).unwrap()
        start := usize(block.address())
        last := (count - usize(1)) * size_of(u32)
        store_u32(block.address(), u32(7))
        store_u32(ptr(start + last), u32(16909060))
        assert(load_u32(ptr(start + last)) == u32(16909060))
        if sys.arg_count() > 1 {
            full := bytes_view(&block, block.address(), block.size())
            print(full.len)
        }
        head := window(&block, usize(0), usize(1))
        tail := window(&block, last, block.size())
        empty := window(&block, block.size(), block.size())
        assert(head[0] == u8(7) && tail.len == 4 && empty.len == 0)
        assert(i64(empty.len) - 1 == -1)
        assert(suffix_sum(&block, last) == 10 && suffix_sum(&block, block.size()) == 0)
        mut signed := i64(block.size()) - 1
        mut total := 0
        while signed >= i64(last) {
            offset := usize(signed)
            one := window(&block, offset, offset + usize(1))
            total += i32(one[0])
            signed -= 1
        }
        assert(total == 10)
        system.dealloc(block, layout)
    }
}
