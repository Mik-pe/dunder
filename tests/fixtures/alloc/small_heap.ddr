capability unsafe

import sys

fn main() {
    over_budget := 512 * 1024 * 1024
    unsafe { assert(usize(sys.pool_alloc_try(usize(over_budget))) == usize(0)) }
    mut data: []u8 = [42]
    for shift in 0..8 {
        capacity := i32(1024).shl(shift)
        assert(data.try_reserve(capacity) == .Ok)
        data.push(u8(shift))
    }
    previous := data.cap()
    assert(data.try_reserve(over_budget) == .OutOfMemory)
    assert(data.cap() == previous && data.len == 9 && data[0] == 42)
    for i in 0..8 { assert(data[i + 1] == u8(i)) }
    assert(data.try_reserve(previous + 1) == .Ok)
    data.push(99)
    assert(data.pop() == 99 && data[0] == 42)
}
