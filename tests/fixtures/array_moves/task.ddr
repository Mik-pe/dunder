fn work(move input: []i32) -> []i32 {
    mut output := input
    output[0] += 1
    output
}
fn main() {
    mut source: []i32 = [41]
    task scope jobs(2) {
        first := spawn jobs work(source.clone())
        second := spawn jobs work(move source)
        mut output := await! jobs(first)
        independent := output.clone()
        output[0] = 99
        assert(independent[0] == 42 && output[0] == 99)
        assert((await! jobs(second))[0] == 42)
    }
    print("task moves ok")
}
