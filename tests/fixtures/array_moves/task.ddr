fn work(move input: []i32) -> []i32 {
    mut output := input
    output[0] += 1
    output
}
fn main() {
    mut source: []i32 = [41]
    task scope jobs(2) {
        first := jobs.spawn(work, source.clone())
        second := jobs.spawn(work, move source)
        mut output := first.join()
        independent := output.clone()
        output[0] = 99
        assert(independent[0] == 42 && output[0] == 99)
        assert(second.join()[0] == 42)
    }
    print("task moves ok")
}
