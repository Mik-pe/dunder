capability unsafe

struct Registry { value: i32, label: string }
fn active(registry: &Registry) -> i32 { registry.value }
fn ordinary(registry: Registry) -> i32 { registry.value }
fn array(values: []i32) -> i32 { values[0] }
fn number(value: &i32) -> i32 { value }
fn identity(value: i32) -> i32 { value }
fn owner() -> Registry { Registry { value: 43, label: "local callable" } }
fn borrow_float(value: &f32) -> f32 { move 0.5 + value }
fn after_callback(transform: fn(i32) -> i32, registry: Registry, values: []i32, scalar: &i32) -> i32 {
    transform(registry.value) + values[0] + scalar
}
fn main() {
    registry := Registry { value: 42, label: "borrowed" }
    values: []i32 = [44]
    scalar := 45
    unsafe {
        assert(active(ref_at(addr(&registry))) == 42)
        assert(active(((ref_at(addr(&registry))))) == 42)
        assert(ordinary((ref_at(addr(&registry)))) == 42)
        assert(array(ref_at(addr(&values))) == 44)
        assert(array(((ref_at(addr(&values))))) == 44)
        assert(number((ref_at(addr(&scalar)))) == 45)
        assert(after_callback(identity, ref_at(addr(&registry)), (ref_at(addr(&values))), ((ref_at(addr(&scalar))))) == 131)
    }
    { ref_at := owner; assert(active(ref_at()) == 43) }
    narrow: f32 = 1.25
    assert(borrow_float(&narrow) == 1.75)
    print("reference contexts ok")
}
