capability unsafe

struct Packet { values: []i32, text: string }
fn total(values: []i32) -> i32 {
    mut sum := 0
    for value in values { sum += value }
    assert(values.len == 3)
    sum
}
fn repeated(values: []i32, depth: i32) -> i32 {
    if depth == 0 { return total(values) }
    result := repeated(values, depth - 1)
    assert(values.len == 3)
    result
}
fn text_length(text: string) -> i32 { text.len }
fn inspect(packet: Packet) -> i32 { total(packet.values) + text_length(packet.text) }
fn same_buffer(values: []i32, expected: ptr) -> bool {
    unsafe { return addr(&values[0]) == expected }
}
fn edit(values: &mut []i32) { values[0] = 11 }
fn main() {
    mut values: []i32 = []
    values.reserve(64)
    values.push(10); values.push(12); values.push(20)
    unsafe {
        pointer := addr(&values[0])
        for i in 0..1000 {
            assert(total(values) == 42 && repeated(values, 3) == 42)
            assert(same_buffer(values, pointer) && values.cap() == 64)
        }
    }
    for value in values { assert(value > 0) }
    assert(values[0] == 10 && values.len == 3)
    edit(&mut values)
    assert(total(values) == 43)
    mut text := "owned " + 42.str()
    for i in 0..1000 { assert(text_length(text) == 8 && text_length(text) == 8) }
    assert(text == "owned 42")
    packet := Packet { values: values, text: text }
    assert(inspect(packet) == 51 && inspect(packet) == 51)
    assert(packet.values[0] == 11 && packet.text == "owned 42")
    words: []string = ["owned " + 1.str(), "owned " + 2.str()]
    mut characters := 0
    for word in words { characters += text_length(word) }
    for word in words { characters += text_length(word) }
    assert(characters == 28 && words[0] == "owned 1")
    print("borrow defaults ok")
}
