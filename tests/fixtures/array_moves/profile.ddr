struct Owned { values: []i64 }
enum Result { Owned(Owned), Empty }
fn relay(move values: []i64) -> []i64 { values }
fn box(move values: []i64) -> Result { .Owned(Owned { values: relay(move values) }) }
fn main() {
    mut values: []i64 = []
    values.reserve(64); values.push(20); values.push(22)
    moved := values
    assert(moved.cap() == 64)
    result := box(move moved)
    match move result {
        .Owned(owned) => { assert(owned.values[0] + owned.values[1] == 42 && owned.values.cap() == 64) },
        .Empty => { assert(false) },
    }
    words: []string = [20.str(), 22.str()]
    mut moved_words: []string = []
    for word in move words { moved_words.push(move word) }
    assert(moved_words[0] == "20" && moved_words[1] == "22")
    print(42)
}
