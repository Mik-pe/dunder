struct Message { text: string }
enum Result { Empty, Text(string), Message(Message) }
fn relay(move text: string) -> string { text }
fn cloned_borrow(text: &string) -> string { text.clone() }
fn guarded(move value: Result) -> string {
    match move value {
        .Text(text) if text.len == 0 => "empty",
        .Text(text) => text,
        .Message(message) => message.text.clone(),
        .Empty => "none",
    }
}
fn main() {
    for i in 0..4000 {
        original := "owned-" + i.str()
        // Builtin inspection and formatting borrow their operands.
        assert(original.len > 6 && original == "owned-" + i.str())
        formatted := original.str()
        assert(formatted == original)
        repeated: [string; 2] = [original.clone(); 2]
        assert(repeated[0] == original && repeated[1] == original)
        independent := cloned_borrow(&original)
        moved := relay(move original)
        assert(moved == independent && formatted == moved)
        owner := Message { text: moved }
        snapshot := owner.clone()
        transferred := Result.Message(owner)
        assert(guarded(move transferred) == snapshot.text)
        assert(guarded(Result.Text("")) == "empty")
        assert(guarded(Result.Text("hello")) == "hello")
    }
    print("string moves ok")
}
