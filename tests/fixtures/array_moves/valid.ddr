capability unsafe

import .library

struct Packet { values: []i32, words: [string; 2], label: string }
enum Result { Empty, Packet(Packet), Values([]i32) }
struct Wrapped { result: Result }
struct Plain { value: i32, label: string }
@c_layout struct Inline { bytes: [u8; 4] }
fn clone_inline(value: &Inline) -> [u8; 4] { value.bytes.clone() }

fn consume(move values: []i32) -> i32 {
    mut sum := 0
    for value in &values { sum += value }
    sum
}
fn relay(move values: []i32) -> []i32 { values }
fn recurse(move values: []i32, depth: i32) -> []i32 {
    if depth == 0 { return values }
    recurse(move values, depth - 1)
}
fn clone_borrow(values: &[]i32) -> []i32 { values.clone() }
fn borrowed_self_assignment(values: &mut []i32) { values = values }
fn read(values: []i32) -> i32 { values[0] }
fn changed(flag: bool) -> []i32 {
    mut values: []i32 = [20, 22]
    if flag { moved := values; return moved }
    values
}
fn make_packet() -> Packet {
    Packet { values: [20, 22], words: ["å" + 1.str(), "🌍"], label: "owned" }
}
fn take_result(move result: Result) -> i32 {
    match move result { .Empty => 0, .Values(values) => consume(move values), .Packet(packet) => consume(packet.values.clone()), }
}
fn clone_result(result: &Result) -> Result { result.clone() }
fn guarded(move result: Result) -> i32 {
    match move result {
        .Values(values) if values.len > 0 => consume(move values),
        .Values(values) => consume(move values),
        .Packet(packet) => consume(packet.values.clone()),
        .Empty => 0,
    }
}
fn borrowed_and_owned(read: []i32, move owned: []i32) -> i32 {
    assert(read[0] == owned[0])
    consume(move owned)
}

fn main() {
    callback_source: []i32 = [42]
    assert(library.read(callback_source) == 42 && library.read(callback_source) == 42)
    transform: fn(move []i32) -> []i32 = library.relay
    callback_result := transform(move callback_source)
    assert(callback_result[0] == 42)
    mut backing: []i32 = []
    backing.reserve(64); backing.push(20); backing.push(22)
    unsafe {
        address := addr(&backing[0])
        transferred := relay(move backing)
        assert(transferred.cap() == 64 && transferred.len == 2)
        assert(addr(&transferred[0]) == address)
        independent := transferred.clone()
        assert(independent.cap() == 8 && addr(&independent[0]) != address)
    }
    field_buffer: []i32 = [20, 22]
    holder := Packet { values: field_buffer, words: ["left", "right"], label: "owner" }
    extracted := holder.values
    assert(extracted[0] + extracted[1] == 42)
    fresh_field := make_packet().values
    assert(fresh_field[0] + fresh_field[1] == 42)
    mut inline := Inline { bytes: [1, 2, 3, 4] }
    bytes := clone_inline(&inline)
    inline.bytes[0] = 99
    assert(bytes[0] == 1 && inline.bytes[0] == 99)
    for i in 0..2000 {
        original: []i32 = [20, 22]
        moved := original
        returned := recurse(relay(move moved), 3)
        assert(consume(move returned) == 42)
        mut source: []i32 = [20, 22]
        mut independent := source.clone()
        independent[0] = 99
        assert(source[0] == 20 && independent[0] == 99)
        copied_borrow := clone_borrow(&source)
        assert(consume(move copied_borrow) == 42 && read(source) == 20)
        assert(borrowed_and_owned(source, source.clone()) == 42)
        source = source
        borrowed_self_assignment(&mut source)
        assert(source[0] == 20)
        mut fixed: [i32; 2] = [20, 22]
        fixed_copy := fixed.clone()
        mut fixed_moved := fixed
        fixed_moved[0] = 99
        assert(fixed_copy[0] == 20 && fixed_moved[0] == 99)
        assert(changed(i % 2 == 0)[1] == 22)
    }
    assert(guarded(Result.Values([20, 22])) == 42)
    assert(guarded(Result.Values([])) == 0)
    mut packet := make_packet()
    mut copy := packet.clone()
    copy.values[0] = 99
    copy.words[0] = "changed"
    assert(packet.values[0] == 20 && packet.words[0] == "å1")
    envelope := Wrapped { result: .Packet(packet) }
    cloned := envelope.clone()
    assert(take_result(cloned.result.clone()) == 42)
    transferred := envelope
    assert(take_result(transferred.result.clone()) == 42)
    result := Result.Values([20, 22])
    result_copy := clone_result(&result)
    assert(take_result(move result) == 42 && take_result(move result_copy) == 42)
    plain := Plain { value: 42, label: "RC string" + 1.str() }
    plain_copy := plain.clone()
    assert(plain.value == plain_copy.value && plain.label == plain_copy.label)
    // Consuming iteration takes the owner once; borrowed iteration keeps it.
    values := [10, 12, 20]
    mut sum := 0
    for value in move values { sum += value }
    assert(sum == 42)
    mut borrowed: []i32 = [20, 22]
    for value in borrowed { sum += value }
    borrowed.push(1)
    assert(borrowed.len == 3 && sum == 84)
    // Reinitialization is definite on every path that reaches the next turn.
    mut looped := [42]
    for i in 0..20 {
        taken := looped
        assert(taken[0] == 42)
        looped = [42]
        if i % 2 == 0 { continue }
        assert(looped[0] == 42)
    }
    assert(looped[0] == 42)
    mut branch: []i32 = [42]
    if read(branch) == 42 { old := branch; assert(old[0] == 42); branch = [43] }
    else { old := branch; assert(old[0] != 42); branch = [44] }
    assert(branch[0] == 43)
    mut trace: []i32 = []
    {
        deferred := [42]
        defer { trace.push(deferred[0]) }
        // A separate explicitly cloned owner can outlive deferred use.
        independent := deferred.clone()
        assert(independent[0] == 42)
    }
    assert(trace.len == 1 && trace[0] == 42)
    print("array moves ok")
}
