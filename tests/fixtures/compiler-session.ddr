// Old-syntax consumer of the resumable frontend. Two independent Function and
// Object roots simulate delayed/reversed worker completion; no owned arena is
// extracted from Session or copied between queue slots.
import ...selfhost.compile as compiler
import ...selfhost.lexer
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_lower as lower
import ...selfhost.mir_link as link
import ...selfhost.mir_pipeline as pipeline
import ...selfhost.opt_ir
import ...selfhost.opt_verify
import ...selfhost.opt_alloc
import ...selfhost.opt_range
import ...selfhost.opt_emit
import ...selfhost.opt_inline
import ...selfhost.machine_ir
import ...selfhost.fragments
import ...selfhost.record_take
import sys

fn same(a: &compiler.Result, b: &compiler.Result) {
    assert(a.ok == b.ok && a.error == b.error && a.offset == b.offset && a.text.len == b.text.len)
    for i in 0..a.text.len { assert(a.text[i] == b.text[i]) }
    assert(a.imports.globals == b.imports.globals && a.imports.sites.len == b.imports.sites.len && a.imports.slots.len == b.imports.slots.len)
    assert(a.imports.libraries.len == b.imports.libraries.len && a.imports.symbols.len == b.imports.symbols.len)
    for i in 0..a.imports.sites.len { assert(a.imports.sites[i] == b.imports.sites[i] && a.imports.slots[i] == b.imports.slots[i]) }
    for i in 0..a.imports.symbols.len { assert(a.imports.symbols[i] == b.imports.symbols[i] && a.imports.libraries[i] == b.imports.libraries[i]) }
}
fn work(f: &mut mir.Function, object: &mut lower.FunctionObject, stage: i32, workspace: &mut pipeline.Workspace,
    options: &pipeline.Options, exits: &pipeline.Terminals) -> pipeline.Status {
    var status := pipeline.Status { error: 0, frame_state: 0, value_state: 0, stats: pipeline.stats() }
    if stage == 1 {
        status = pipeline.run_into(&mut f, &mut workspace, &options, &exits)
        assert(status.error == 0 && lower.lower_into(&mut object, &f))
    } else { assert(stage == 2 && lower.object_ready(&object)) }
    status
}
fn check(source: string, platform: i32, enabled: bool, inline: bool, directory: string, records: &mut compiler.Bindings) -> compiler.Result {
    var config := compiler.configuration(); config.mir_enabled = enabled; config.inline_enabled = inline
    var ordinary := lexer.scan(source, false); var ordinary_records := compiler.bindings(); none: []i32 = []
    expected := compiler.compile_options(&mut ordinary, platform, &none, &none, false, true, &mut ordinary_records, "", "session-test", &config)
    var tokens := lexer.scan(source, false); var session := compiler.new_session()
    var model := opt_ir.new(); var verifier := opt_verify.new(); var allocation := opt_alloc.new(); var ranges := opt_range.new()
    var record_takes := record_take.new(); var machine := machine_ir.new(); var settings := opt_emit.options(); var catalog := opt_inline.new(); var inliner := opt_inline.workspace()
    assert(compiler.begin_into(&mut session, &mut tokens, platform, &none, &none, true, directory, "session-test", &config,
        &mut model, &mut verifier, &mut ranges, &mut catalog, &mut inliner, &mut settings, &mut record_takes))
    var linker := link.new(); assert(compiler.begin_linker(&session, &mut linker))
    var first := mir.new(); var second := mir.new(); var first_object := lower.new_object(); var second_object := lower.new_object()
    var lifting := lift.new_work(); var workspace := pipeline.new(); var options := pipeline.options(); var exits := pipeline.no_terminals()
    compiler.pipeline_options_into(&session, &mut options); compiler.terminals_into(&session, &mut exits)
    var restored := fragments.new_dependencies(); var issued := 0
    while true {
        a := compiler.next_into(&mut session, &mut first, &mut first_object, &mut lifting, &mut model, &mut verifier,
            &mut allocation, &mut machine, &settings, &mut ranges, &catalog, &mut inliner, &mut restored)
        assert(a >= 0); if a == 0 { break }
        ordinal_a := compiler.current_ordinal(&session); assert(ordinal_a == issued); issued = issued + 1
        assert(compiler.current_declaration(&session) >= 0 && compiler.current_source_offset(&session) >= 0)
        b := compiler.next_into(&mut session, &mut second, &mut second_object, &mut lifting, &mut model, &mut verifier,
            &mut allocation, &mut machine, &settings, &mut ranges, &catalog, &mut inliner, &mut restored)
        assert(b >= 0)
        if b > 0 {
            ordinal_b := compiler.current_ordinal(&session); assert(ordinal_b == issued); issued = issued + 1
            status_b := work(&mut second, &mut second_object, b, &mut workspace, &options, &exits)
            status_a := work(&mut first, &mut first_object, a, &mut workspace, &options, &exits)
            // Out-of-order acceptance is an inert protocol refusal, not a
            // worker-driven reordering of code, cache budgets or diagnostics.
            assert(!compiler.accept_into(&mut session, &mut linker, ordinal_b, &second_object, &status_b))
            assert(compiler.accept_into(&mut session, &mut linker, ordinal_a, &first_object, &status_a))
            assert(!compiler.accept_into(&mut session, &mut linker, ordinal_a, &first_object, &status_a))
            assert(compiler.accept_into(&mut session, &mut linker, ordinal_b, &second_object, &status_b))
        } else {
            status_a := work(&mut first, &mut first_object, a, &mut workspace, &options, &exits)
            assert(compiler.accept_into(&mut session, &mut linker, ordinal_a, &first_object, &status_a))
        }
    }
    assert(compiler.source_done(&session) && link.next_ordinal(&linker) == issued)
    actual := compiler.finish(&mut session, &mut linker, &mut model, &mut verifier, &mut allocation, &mut machine,
        &settings, &mut ranges, &catalog, &mut inliner, &mut records, &mut record_takes)
    same(&expected, &actual)
    if records.reused == 0 {
        assert(records.offsets.len == ordinary_records.offsets.len && records.names.len == ordinary_records.names.len)
        for i in 0..records.offsets.len { assert(records.offsets[i] == ordinary_records.offsets[i] && records.names[i] == ordinary_records.names[i] && records.types[i] == ordinary_records.types[i]) }
    }
    if records.reused == 0 { assert(records.mir_operations == ordinary_records.mir_operations && records.mir_functions == ordinary_records.mir_functions) }
    actual
}
fn failure(mode: i32) {
    var source := "fn bad()->i64{false} fn main(){print(bad())}"
    if mode == 0 { source = "fn main(){print(42)}" }
    var directory := ""
    if mode == 2 { directory = "build/session-qa/prefix-" + sys.pid().str() }
    var config := compiler.configuration(); config.inline_enabled = false
    var tokens := lexer.scan(source, false); var session := compiler.new_session(); none: []i32 = []
    var model := opt_ir.new(); var verifier := opt_verify.new(); var allocation := opt_alloc.new(); var ranges := opt_range.new()
    var record_takes := record_take.new(); var machine := machine_ir.new(); var settings := opt_emit.options(); var catalog := opt_inline.new(); var inliner := opt_inline.workspace()
    assert(compiler.begin_into(&mut session, &mut tokens, 0, &none, &none, false, directory, "session-errors", &config,
        &mut model, &mut verifier, &mut ranges, &mut catalog, &mut inliner, &mut settings, &mut record_takes))
    var linker := link.new(); assert(compiler.begin_linker(&session, &mut linker)); prefix := link.word_count(&linker)
    var first := mir.new(); var ignored := mir.new(); var object := lower.new_object(); var ignored_object := lower.new_object()
    var lifting := lift.new_work(); var workspace := pipeline.new(); var options := pipeline.options(); var exits := pipeline.no_terminals()
    compiler.pipeline_options_into(&session, &mut options); compiler.terminals_into(&session, &mut exits)
    var restored := fragments.new_dependencies()
    assert(compiler.next_into(&mut session, &mut first, &mut object, &mut lifting, &mut model, &mut verifier,
        &mut allocation, &mut machine, &settings, &mut ranges, &catalog, &mut inliner, &mut restored) == 1)
    offset := compiler.current_source_offset(&session)
    if mode != 0 {
        assert(compiler.next_into(&mut session, &mut ignored, &mut ignored_object, &mut lifting, &mut model, &mut verifier,
            &mut allocation, &mut machine, &settings, &mut ranges, &catalog, &mut inliner, &mut restored) == -1)
        later := compiler.session_error(&session); assert(!later.ok && later.offset != offset)
    }
    if mode == 1 { first.kinds[0] = -1 }
    status := pipeline.run_into(&mut first, &mut workspace, &options, &exits)
    if mode == 1 {
        assert(status.error == 1 && !compiler.accept_into(&mut session, &mut linker, 0, &object, &status))
        result := compiler.session_error(&session)
        assert(result.offset == offset && result.error == "internal whole-function MIR verification failure")
    } else {
        assert(status.error == 0)
        // The bytes, target and label namespace remain valid, but this object
        // claims a different original source range. Ordinal alone is not proof.
        if mode == 0 { first.source_words = first.source_words + 1 }
        assert(lower.lower_into(&mut object, &first))
        accepted := compiler.accept_into(&mut session, &mut linker, 0, &object, &status)
        if mode == 0 {
            assert(!accepted && link.next_ordinal(&linker) == 0 && link.word_count(&linker) == prefix)
            result := compiler.session_error(&session); assert(result.error == "internal ordered function object failure" && result.offset == offset)
        } else {
            assert(accepted && link.next_ordinal(&linker) == 1)
            result := compiler.session_error(&session); assert(!result.ok && result.offset != offset)
            // Earlier successful work is cacheable even when the parent has
            // already found a later source failure. No failed body is saved.
            assert(sys.metadata(directory + "/1.fn").ok && !sys.metadata(directory + "/0.fn").ok)
            var retry := lexer.scan("fn bad()->i64{7} fn main(){print(bad())}", false); var records := compiler.bindings()
            fixed := compiler.compile_options(&mut retry, 0, &none, &none, false, false, &mut records, directory, "session-errors", &config)
            assert(fixed.ok && records.reused == 1)
        }
    }
}
fn main() {
    owned := "fn first(n:i64)->i64{n*3} fn last(a:[]i64)->[]i64{var b:=a;b[0]=b[0]+1;b} fn main(){a:[]i64=[41];print(last(a)[0]);print(first(14))}"
    for platform in 0..4 { for mode in 0..4 {
        var records := compiler.bindings(); actual := check(owned, platform, mode < 2, mode % 2 == 0, "", &mut records)
        assert(actual.ok && records.emitted == 3)
    } }
    // Real import sites must survive detached capture/ordered append. Floating
    // formatting also discovers reachable helpers in later needed sweeps.
    for platform in 0..4 {
        var ffi_records := compiler.bindings()
        ffi := check("capability unsafe\n@extern(\"c\",\"abs\") unsafe fn abs(x:i32)->i32\nfn main(){unsafe{print(abs(-42))}}",
            platform, true, false, "", &mut ffi_records)
        assert(ffi.ok)
        var float_records := compiler.bindings()
        floating := check("fn main(){value:f64=2.5;print(value.str())}", platform, true, false, "", &mut float_records)
        assert(floating.ok)
    }
    directory := "build/session-qa/fragments-" + sys.pid().str()
    var cold := compiler.bindings(); a := check(owned, 0, true, true, directory, &mut cold); assert(a.ok)
    var warm := compiler.bindings(); b := check(owned, 0, true, true, directory, &mut warm)
    assert(b.ok && warm.reused > 0 && warm.mir_functions < cold.mir_functions); same(&a, &b)
    for mode in 0..3 { failure(mode) }
    print("session-passed")
}
