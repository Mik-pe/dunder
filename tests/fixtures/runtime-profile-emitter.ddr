// Focused native runtime harness, independent of the compiler CLI integration.
import ...selfhost.arm64 as arm
import ...selfhost.runtime as runtime
import ...selfhost.macho as macho
import ...selfhost.elf as elf
import ...selfhost.x86 as x86
import std.parse as parse
import sys

fn main() {
    platform := i32(parse.integer(sys.arg(1)).value)
    mode := i32(parse.integer(sys.arg(2)).value)
    var code := arm.new_for(platform); code.profile = sys.arg(4) == "on"
    rt := runtime.new(&mut code)
    arm.imm(&mut code, 19, 0); arm.imm(&mut code, 20, 0)
    if platform == 0 { arm.mov(&mut code, 23, 0); arm.mov(&mut code, 24, 1) }
    else { arm.emit(&mut code, 4181722103); arm.emit(&mut code, 2432705528) }
    runtime.emit_profile_start(&mut code, &rt)
    if mode == 1 {
        // Three executed allocations, one fresh size-class block, two reuses.
        // The record and record-clone entries classify the same allocator.
        arm.imm(&mut code, 0, 24); arm.branch(&mut code, rt.alloc_record, 1)
        arm.branch(&mut code, rt.release, 1)
        arm.imm(&mut code, 0, 24); arm.branch(&mut code, rt.alloc_clone, 1)
        arm.branch(&mut code, rt.release, 1)
        arm.imm(&mut code, 0, 32); arm.branch(&mut code, rt.alloc, 1)
        arm.branch(&mut code, rt.retain, 1); arm.branch(&mut code, rt.release, 1); arm.branch(&mut code, rt.release, 1)
    }
    if mode == 2 {
        assert(code.profile)
        // Exercise unsigned JSON formatting without billions of allocations.
        arm.imm(&mut code, 0, -1); arm.emit(&mut code, 4177526784 + 32 * 1024 + 21 * 32)
    }
    if mode == 3 { arm.exit(&mut code, 104) }
    arm.imm(&mut code, 0, 17); runtime.emit_profile_report(&mut code, &rt)
    arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    runtime.emit_runtime(&mut code, &rt)
    data_start := code.words.len
    runtime.emit_profile_data(&mut code, &rt)
    var text: []u8 = []
    if platform == 2 {
        empty: []i32 = []
        result := x86.finish(&code, data_start, &empty, &empty)
        assert(result.ok); text = result.text
    } else { text = arm.finish(&mut code) }
    var image: []u8 = []
    if platform == 0 { image = macho.image(&text) }
    else { var machine := 183; if platform == 2 { machine = 62 }; image = elf.image_for(&text, machine) }
    saved := sys.write_u8(sys.arg(3), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(3)); assert(executable.ok)
}
