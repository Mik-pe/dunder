// error: scratch borrow reaches a raw address
capability unsafe

fn raw_leaf(value: &i64) -> ptr {
    unsafe { return addr(&value) }
}

fn relay(value: &i64, steps: i32) -> ptr {
    if steps == 0 { return raw_leaf(&value) }
    relay(&value, steps - 1)
}

fn main() {
    region frame {
        values: []i64 = frame.alloc(1)
        result := relay(&values[0], 2)
    }
}
