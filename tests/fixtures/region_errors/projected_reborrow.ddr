// error: scratch borrow reaches a raw address
capability unsafe

fn address(value: &i32) -> ptr {
    unsafe { return addr(&value) }
}

fn first(items: &[]i32) -> ptr { address(&(items[0])) }

fn main() {
    region arena {
        values: []i32 = arena.alloc(1)
        result := first(&values)
    }
}
