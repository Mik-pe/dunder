import ...selfhost.frontend.compile as compiler
import ...selfhost.frontend.lexer

fn hits(source: string, checking: bool) -> i32 {
    mut tokens := lexer.scan(source, false)
    mut stats := compiler.bindings()
    mut config := compiler.configuration()
    config.inline_enabled = false
    none: []i32 = []
    result := compiler.compile_options(&mut tokens, 0, &none, &none, checking, true, &mut stats, "", "", &config)
    assert(result.ok)
    mut arguments := 0; mut locals := 0
    mut last_argument := -1; mut last_local := -1
    for i in 0..stats.names.len {
        offset := stats.offsets[i]
        if stats.names[i] == "x" {
            assert(offset > last_argument && source[offset..offset+1] == "x")
            last_argument = offset; arguments = arguments + 1
        }
        if stats.names[i] == "value" {
            assert(offset > last_local && source[offset..offset+5] == "value")
            last_local = offset; locals = locals + 1
        }
    }
    assert(arguments == 8 && locals == 8)
    return stats.scalar_model_hits
}

fn main() {
    mut source := ""
    mut calls := ""
    for i in 0..8 {
        name := "f" + i.str()
        source = source + "fn " + name + "(x:i32)->i32 { mut value:=x; value=value+3; return value }\n"
        calls = calls + "print(" + name + "(4));"
    }
    source = source + "fn main(){" + calls + "}"
    assert(hits(source, false) > 0)
    assert(hits(source, true) == 0)
}
