{
  "description": "Workflow-shaped TOML parser fixtures.",
  "cases": [
    {
      "name": "ci/minimal-defaults",
      "text": "version = 1\n[[job]]\nid = \"test\"\n[[job.step]]\nrun = \"true\"\n",
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"job\":[{\"id\":\"test\",\"step\":[{\"run\":\"true\"}]}]}"
    },
    {
      "name": "ci/layered-env",
      "text": "version = 1\n[env]\nZ = \"workflow\"\nA = \"one\"\n[[job]]\nid = \"check\"\nworking_dir = \"sub dir\"\ntimeout_seconds = 1200\nenv = { Z = \"job\" }\nenvironment = { os = \"macos\", arch = \"aarch64\", toolchain = \"v-0.5\" }\n[[job.step]]\nname = \"fmt\"\nrun = \"echo 'done'\"\nenv = { A = \"step\", QUOTED = \"'\\\" café\\nline\\tend\" }\nartifacts = [\"reports/**\", \"[a-z]*.txt\"]\n[[job.step]]\nrun = '''echo multiline\nprintf '%s\\n' \"$Z\"\n'''\nworking_dir = \"\"\ntimeout_seconds = 50\ncontinue_on_error = true\n",
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"env\":{\"Z\":\"workflow\",\"A\":\"one\"},\"job\":[{\"id\":\"check\",\"working_dir\":\"sub dir\",\"timeout_seconds\":1200,\"env\":{\"Z\":\"job\"},\"environment\":{\"os\":\"macos\",\"arch\":\"aarch64\",\"toolchain\":\"v-0.5\"},\"step\":[{\"name\":\"fmt\",\"run\":\"echo 'done'\",\"env\":{\"A\":\"step\",\"QUOTED\":\"'\\\" café\\nline\\tend\"},\"artifacts\":[\"reports/**\",\"[a-z]*.txt\"]},{\"run\":\"echo multiline\\nprintf '%s\\\\n' \\\"$Z\\\"\\n\",\"working_dir\":\"\",\"timeout_seconds\":50,\"continue_on_error\":true}]}]}"
    },
    {
      "name": "ci/unicode-and-controls",
      "text": "version = 1\n[[job]]\nid = \"test\"\n[[job.step]]\nrun = \"echo café 你好 \\u0001\\b\\f\\t\\r\\n\\u2028\\u2029\"\n",
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"job\":[{\"id\":\"test\",\"step\":[{\"run\":\"echo café 你好 \\u0001\\b\\f\\t\\r\\n  \"}]}]}"
    },
    {
      "name": "ci/explicit-defaults",
      "text": "version = 1\n[[job]]\nid=\"test\"\nworking_dir=\"\"\ntimeout_seconds=900\nenv={}\nenvironment={}\n[[job.step]]\nname=\"step-1\"\nrun=\"true\"\nworking_dir=\"\"\ntimeout_seconds=900\ncontinue_on_error=false\nenv={}\nartifacts=[]\n",
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"job\":[{\"id\":\"test\",\"working_dir\":\"\",\"timeout_seconds\":900,\"env\":{},\"environment\":{},\"step\":[{\"name\":\"step-1\",\"run\":\"true\",\"working_dir\":\"\",\"timeout_seconds\":900,\"continue_on_error\":false,\"env\":{},\"artifacts\":[]}]}]}"
    },
    {
      "name": "ci/two-jobs",
      "text": "version = 1\n[[job]]\nid = \"test\"\n[[job.step]]\nrun = \"true\"\n[[job]]\nid=\"check\"\n[[job.step]]\nrun=\"false\"\n",
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"job\":[{\"id\":\"test\",\"step\":[{\"run\":\"true\"}]},{\"id\":\"check\",\"step\":[{\"run\":\"false\"}]}]}"
    },
    {
      "name": "ci/inline-arrays",
      "text": "version=1\njob=[{id=\"test\",step=[{run=\"true\"}]}]\n",
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"job\":[{\"id\":\"test\",\"step\":[{\"run\":\"true\"}]}]}"
    },
