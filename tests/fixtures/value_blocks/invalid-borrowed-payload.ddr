// error: cannot move a borrowed pattern binding
enum Source { Rows([]i32), Empty }
fn choose(source: Source) -> []i32 {
    result: []i32 = match source {
        .Rows(rows) => { held := rows; held },
        .Empty => { fallback: []i32 = [1]; fallback },
    }
    result
}
fn main() { print(choose(.Rows([42]))[0]) }
