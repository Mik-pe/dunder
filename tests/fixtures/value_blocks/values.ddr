enum Reply { Number(i32), Empty }
enum Direction { Left, Right }

fn mark(trace: &mut i32, digit: i32) -> i32 {
    trace = trace * 10 + digit
    digit
}

fn classify(present: bool, trace: &mut i32) -> Reply {
    answer: Reply = if present {
        mut subtotal := mark(&mut trace, 1)
        subtotal += mark(&mut trace, 2)
        .Number(subtotal)
    } else {
        _ := mark(&mut trace, 3)
        .Empty
    }
    return answer
}

fn calculate(reply: Reply, trace: &mut i32) -> i32 {
    result := match reply {
        .Number(n) if n > 2 => {
            extra := mark(&mut trace, 4)
            if n > extra { n } else { tens := n * 10; tens + extra }
        },
        .Number(n) => { extra := mark(&mut trace, 5); n + extra },
        .Empty => {
            direction: Direction = .Left
            match direction {
                .Left => { digit := mark(&mut trace, 6); digit * 2 },
                .Right => 0,
            }
        },
    }
    result + 1
}

fn first(values: []u8) -> u8 { values[0] }

fn arm_loan(flag: bool) -> i32 {
    mut values: []i32 = [20, 22]
    selected := if flag {
        part := &values[0]
        part + 1
    } else {
        { part := &values[1]; part - 1 }
    }
    values[0] = selected * 2
    values[0]
}

fn main() {
    mut trace := 0
    full := classify(true, &mut trace)
    assert(trace == 12 && calculate(full, &mut trace) == 35 && trace == 124)
    empty := classify(false, &mut trace)
    assert(calculate(empty, &mut trace) == 13 && trace == 12436)
    assert(calculate(.Number(2), &mut trace) == 8 && trace == 124365)
    assert(first(if trace > 0 { value: u8 = 250; [value, 42] } else { [0] }) == 250)
    assert(arm_loan(true) == 42 && arm_loan(false) == 42)
    print("branch values ok")
}
