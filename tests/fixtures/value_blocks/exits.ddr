enum Action { Skip, Break, Add(i32) }

fn choose(flag: bool, trace: &mut []i32) -> string {
    owner := "early-" + 42.str()
    selected := if flag {
        defer { trace.push(2) }
        trace.push(1)
        return owner
    } else {
        defer { trace.push(4) }
        trace.push(3)
        "late"
    }
    assert(owner == "early-42")
    return selected
}

fn action_for(step: i32) -> Action {
    if step == 0 { return .Skip }
    if step == 4 { return .Break }
    .Add(step)
}

fn sum_steps(trace: &mut []i32) -> i32 {
    mut sum := 0
    for i in 0..8 {
        amount := match action_for(i) {
            .Skip => { defer { trace.push(0) }; continue },
            .Break => { defer { trace.push(4) }; break },
            .Add(n) => { defer { trace.push(n) }; extra := n * 10; extra },
        }
        assert(trace.len == i + 1)
        sum += amount
    }
    sum
}

fn nested(flag: bool, second: bool) -> i32 {
    x := if flag {
        if second { return 41 } else { return 42 }
    } else {
        base := 4
        base * 10
    }
    x + 3
}

fn contextual(flag: bool) -> i32 {
    x: i32 = if flag { return 51 } else { return 52 }
    x
}

fn unbraced(action: Action, alternate: bool) -> i32 {
    result := match action {
        .Skip if alternate => if alternate { return 61; print(99) } else { return 62 },
        .Skip => (if alternate { return 63 } else { return 64 }),
        .Break if alternate => match action {
            .Break => { return 65 }, _ => { return 0 },
        },
        .Break => (match action {
            .Break => { return 66 }, _ => { return 0 },
        }),
        .Add(n) => { amount := n * 2; amount },
    }
    result + 1
}

fn main() {
    mut trace: []i32 = []
    assert(choose(true, &mut trace) == "early-42")
    assert(choose(false, &mut trace) == "late")
    assert(trace.len == 4 && trace[0] == 1 && trace[1] == 2)
    assert(trace[2] == 3 && trace[3] == 4)
    trace.clear()
    assert(sum_steps(&mut trace) == 60)
    assert(trace.len == 5)
    for i in 0..trace.len { assert(trace[i] == i) }
    assert(nested(true, true) == 41 && nested(true, false) == 42 && nested(false, true) == 43)
    assert(contextual(true) == 51 && contextual(false) == 52)
    assert(unbraced(.Skip, true) == 61 && unbraced(.Skip, false) == 64)
    assert(unbraced(.Break, true) == 65 && unbraced(.Break, false) == 66)
    assert(unbraced(.Add(3), false) == 7)
    print("branch exits ok")
}
