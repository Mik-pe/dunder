struct Pair { data: []i32, code: i32 }
enum Item { Pair([]i32, i32) }

impl Pair {
    fn total(move self, extra: i32) -> i32 { self.data[0] + self.code + extra }
}

fn add(move data: []i32, code: i32) -> i32 { data[0] + code }

fn call_arg(stop: bool) -> i32 {
    add([5], if stop { return 8 } else { v := 4; v + 1 })
}

fn record_field(stop: bool) -> i32 {
    pair := Pair { data: [6], code: if stop { return 8 } else { v := 2; v * 2 } }
    pair.data[0] + pair.code
}

fn enum_field(stop: bool) -> i32 {
    pair := Item.Pair([7], if stop { return 8 } else { v := 1; v + 2 })
    match pair { .Pair(data, code) => data[0] + code }
}

fn array_element(stop: bool) -> i32 {
    parts: [][]i32 = [[8], if stop { return 8 } else { v := 2; [v] }]
    parts[0][0] + parts[1][0]
}

fn method_arg(stop: bool) -> i32 {
    pair := Pair { data: [3], code: 4 }
    pair.total(if stop { return 8 } else { v := 1; v + 2 })
}

fn nested_staging() -> i32 {
    pair := Pair { data: [19], code: add([20], if true {
        mut subtotal := 0
        for i in 0..4 {
            piece := if i == 0 { continue } else if i == 3 { break } else { i }
            subtotal += piece
        }
        subtotal
    } else { 0 }) }
    pair.data[0] + pair.code
}

fn abandoned_in_loop() -> i32 {
    mut total := 0
    for i in 0..8 {
        subtotal := add([i], if i % 2 == 0 { continue } else if i == 7 { break } else { i })
        total += subtotal
    }
    total
}

fn number(n: i32) -> i32 { n }

fn loop_in_operand(stop: i32, trail: &mut []i32) -> i32 {
    number(7) + (if stop >= 0 {
        mut total := 0
        for i in 0..7 {
            piece := number(10) + (if i == 0 {
                defer { trail.push(1) }
                continue
            } else if i == stop {
                defer { trail.push(2) }
                break
            } else {
                i * 2
            })
            total += piece
        }
        total
    } else {
        return 74
    })
}

fn shared_defer(exit: bool, trail: &mut []i32) -> i32 {
    number(2) + (if trail.len == 0 {
        defer { trail.push(6) }
        subtotal := number(3) + (if exit { return 28 } else { 4 })
        subtotal + 1
    } else { 0 })
}

fn while_condition(trail: &mut []i32) -> i32 {
    mut visits := 0
    mut body := 0
    while (if visits == 1 {
        visits += 1
        defer { trail.push(8) }
        continue
    } else if visits == 3 {
        defer { trail.push(9) }
        break
    } else { visits += 1; true }) {
        body += 1
    }
    body
}

fn for_bound() -> i32 {
    mut total := 0
    for outer in 0..4 {
        for inner in 0..(if outer == 0 { continue } else if outer == 3 { break } else { 2 }) {
            total += outer * 10 + inner
        }
    }
    total
}

fn main() {
    for i in 0..256 {
        stop := i % 2 == 0
        expected := if stop { 8 } else { 10 }
        assert(call_arg(stop) == expected)
        assert(record_field(stop) == expected)
        assert(enum_field(stop) == expected)
        assert(array_element(stop) == expected)
        assert(method_arg(stop) == expected)
        assert(nested_staging() == 42 && abandoned_in_loop() == 18)
    }
    mut trail: []i32 = []
    assert(loop_in_operand(4, &mut trail) == 49)
    assert(trail.len == 2 && trail[0] == 1 && trail[1] == 2)
    assert(loop_in_operand(-1, &mut trail) == 74 && trail.len == 2)
    trail.clear()
    assert(shared_defer(false, &mut trail) == 10 && trail.len == 1 && trail[0] == 6)
    trail.clear()
    assert(shared_defer(true, &mut trail) == 28 && trail.len == 1 && trail[0] == 6)
    assert(while_condition(&mut trail) == 2 && trail.len == 3)
    assert(trail[1] == 8 && trail[2] == 9)
    assert(for_bound() == 62)
    print("interrupted expressions ok")
}
