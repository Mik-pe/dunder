@resource struct Packet { data: []i32 }
enum Delivery { Sent(Packet), Skipped }

fn packet(n: i32) -> Packet {
    mut data: []i32 = [n]
    data.reserve(32)
    Packet { data: data }
}

fn select(flag: bool, trace: &mut []i32) -> Packet {
    chosen := if flag {
        spare := packet(8)
        defer { trace.push(spare.data[0]) }
        data := packet(40)
        data
    } else {
        spare := packet(9)
        defer { trace.push(spare.data[0]) }
        packet(41)
    }
    assert(trace.len == 1)
    chosen
}

fn receive(move item: Delivery, trace: &mut []i32) -> Packet {
    result := match move item {
        .Sent(p) if p.data[0] == 40 => {
            defer { trace.push(1) }
            original := p
            original
        },
        .Sent(p) => { defer { trace.push(2) }; p },
        .Skipped => { defer { trace.push(3) }; packet(42) },
    }
    assert(trace.len == 2)
    result
}

fn text_snapshot(flag: bool) -> string {
    mut text := "old-" + 6.str()
    text + (if flag {
        text = "new-" + 8.str()
        text + "!"
    } else { "?" })
}

fn main() {
    for i in 0..256 {
        mut trace: []i32 = []
        p := select(i % 2 == 0, &mut trace)
        item := Delivery.Sent(p)
        kept := receive(move item, &mut trace)
        assert(kept.data.cap() == 32 && kept.data[0] == 40 + i % 2)
        assert(trace[0] == 8 + i % 2 && trace[1] == 1 + i % 2)
    }
    mut trace: []i32 = [0]
    fallback := receive(.Skipped, &mut trace)
    assert(fallback.data[0] == 42 && trace[1] == 3)
    assert(text_snapshot(true) == "old-6new-8!" && text_snapshot(false) == "old-6?")
    print("branch ownership ok")
}
