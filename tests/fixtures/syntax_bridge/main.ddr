import helper as values

struct Box { values: i32, callback: fn(move i32) -> i32 }
enum Event { Box(Box), Empty }

fn next(move value: i32) -> i32 { move value + 1 }
fn invoke(transform: fn(move i32) -> i32, move value: i32) -> i32 {
    transform(move value)
}
fn parameter_shadows_import(move values: i32) -> i32 { move values }
fn declaration_shadows_import() -> i32 {
    mut values: i32 = values.answer()
    values += 1
    values
}
fn bridge_relay(move values: []i32) -> []i32 { move values }

fn main() {
    mut local := 20
    local += 2
    mut legacy := local
    legacy += 20
    assert(legacy == 42 && local == 22)
    assert(declaration_shadows_import() == 42)
    assert(parameter_shadows_import(42) == 42)
    assert(values.next(41) == 42)

    unmarked: fn(i32) -> i32 = next
    marked: fn(move i32) -> i32 = unmarked
    boxed := Box { values: move legacy, callback: marked }
    assert(invoke(boxed.callback, move boxed.values) == 43)
    nominal: fn(move values.Value) -> values.Value = values.relay
    result := nominal(move values.Value { number: 42 })
    assert(result.number == 42)

    selected := match Event.Box(boxed) {
        .Box(values) if move (values.values == 42) => move values.values,
        .Box(values) => values.values + 1,
        .Empty => 0,
    }
    assert(selected == 42)
    assert(if move true { move 42 } else { 0 } == 42)
    mut sum := 0
    for i in move 0..move 3 { sum += move i }
    assert(sum == 3)
    narrow: f32 = 1.25
    inferred := move 0.5 + narrow
    expected: f32 = 1.75
    assert(inferred == expected)

    // Explicit clones keep independent owners; transfer syntax consumes only
    // the source owner and preserves its buffer for the recipient.
    original: []i32 = [20, 22]
    independent := original.clone()
    mut copied := bridge_relay(move original)
    copied[0] = 99
    assert(independent[0] == 20 && copied[0] == 99)
    print("syntax bridge ok")
}
