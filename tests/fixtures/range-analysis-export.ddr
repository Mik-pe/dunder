capability filesystem
import ...selfhost.opt.opt_ir as ir
import ..support.typed_fixture as fixture
import ...selfhost.opt.opt_pass as pass
import ...selfhost.opt.opt_range as ranges
import ...selfhost.opt.opt_verify as verify
import ...selfhost.frontend.lexer as lexer
import std.parse as decimal
import sys

fn same(f: &ir.Function, before: &ir.Function) {
    assert(f.root == before.root && f.ret == before.ret && f.params == before.params)
    assert(f.supported == before.supported && f.visits == before.visits &&
        f.rewrites == before.rewrites && f.budget_exhausted == before.budget_exhausted)
    assert(f.nodes.kinds.len == before.nodes.kinds.len && f.local_types.len == before.local_types.len)
    for i in 0..f.nodes.kinds.len {
        assert(f.nodes.kinds[i] == before.nodes.kinds[i] && f.nodes.types[i] == before.nodes.types[i])
        assert(f.nodes.left[i] == before.nodes.left[i] && f.nodes.right[i] == before.nodes.right[i] &&
            f.nodes.third[i] == before.nodes.third[i] && f.nodes.next[i] == before.nodes.next[i])
        assert(f.nodes.values[i] == before.nodes.values[i] && f.nodes.locals[i] == before.nodes.locals[i])
        assert(f.nodes.proofs[i] == before.nodes.proofs[i] && f.nodes.effects[i] == before.nodes.effects[i] &&
            f.nodes.starts[i] == before.nodes.starts[i])
    }
    for i in 0..f.local_types.len {
        assert(f.local_types[i] == before.local_types[i] && f.local_param[i] == before.local_param[i] &&
            f.local_mutable[i] == before.local_mutable[i] && f.local_at[i] == before.local_at[i] &&
            f.local_names[i] == before.local_names[i])
    }
}

fn main() {
    file := sys.read_text(sys.arg(1))
    assert(file.ok)
    tokens := lexer.scan("a b c n m x flag " + file.value, false)
    names: []string = ["a", "b", "c", "n", "m", "x", "flag"]
    types: []i32 = [21, 20, 21, 1, 1, 2, 3]
    positions: []i32 = [0, 1, 2, 3, 4, 5, 6]
    mut f := ir.new()
    assert(fixture.body(&mut f, &tokens, 7, tokens.kinds.len - 2, &names, &types, &positions, 2))
    assert(verify.validate(&f, false))
    if sys.arg(3) == "simplified" {
        pass.run(&mut f)
        assert(!f.budget_exhausted)
    }
    assert(verify.validate(&f, true))
    before := f.clone()
    mut w := ranges.new()
    mut warm := f.clone()
    if ranges.analyze_into(&mut w, &warm) { ranges.apply(&mut w, &mut warm) }
    ranges.set_budget(&mut w, i32(decimal.integer(sys.arg(2)).value))
    ready := ranges.analyze_into(&mut w, &f)
    same(&f, &before)
    if ready {
        assert(ranges.status(&w) == 1)
        ranges.apply(&mut w, &mut f)
        assert(ranges.status(&w) == 2)
        assert(verify.validate(&f, true))
    } else {
        assert(ranges.status(&w) == 3 || ranges.status(&w) == 4)
    }
    print(2)
    print(f.root)
    print(f.ret)
    print(f.params)
    print(f.nodes.kinds.len)
    print(f.local_types.len)
    print(ranges.status(&w))
    print(ranges.units(&w))
    print(ranges.read_count(&w))
    print(ranges.store_count(&w))
    print(f.visits)
    print(f.rewrites)
    print(ranges.arithmetic_count(&w))
    for i in 0..f.nodes.kinds.len {
        mask := ranges.proof_mask(&w, i)
        produced := ranges.produced(&w, i)
        assert(produced == (mask.bit_and(2) != 0))
        assert(f.nodes.proofs[i] == before.nodes.proofs[i].bit_or(mask))
        print(f.nodes.kinds[i])
        print(f.nodes.types[i])
        print(f.nodes.left[i])
        print(f.nodes.right[i])
        print(f.nodes.third[i])
        print(f.nodes.next[i])
        print(f.nodes.values[i])
        print(f.nodes.locals[i])
        print(f.nodes.proofs[i])
        print(f.nodes.effects[i])
        print(f.nodes.starts[i])
        print(if produced { 1 } else { 0 })
        print(mask)
    }
    for i in 0..f.local_types.len {
        print(f.local_types[i])
        print(f.local_param[i])
        print(if f.local_mutable[i] { 1 } else { 0 })
        print(f.local_at[i])
    }
}
