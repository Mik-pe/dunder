@resource
struct Token { number: i32 }
struct Pair { token: Token, count: i32 }
enum Result { Live(Pair), Empty }

fn read(token: Token) -> i32 { token.number }
fn relay(move token: Token) -> Token { token }
fn package(move token: Token) -> Result { .Live(Pair { token: token, count: 2 }) }

fn main() {
    token := Token { number: 21 }
    assert(read(token) == 21 && read(token) == 21)
    next := relay(move token)
    wrapped := package(move next)
    match move wrapped {
        .Live(pair) => {
            count := pair.count
            extracted := pair.token
            assert(read(extracted) * count == 42)
        },
        .Empty => { assert(false) },
    }
    print("resource transfers ok")
}
