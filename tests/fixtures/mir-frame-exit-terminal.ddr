import ..support.mir_object_support as object_support
import ...selfhost.backend.arm64 as arm
import ...selfhost.mir.mir
import .mir_machine as lift
import ...selfhost.mir.mir_verify as verify
import ...selfhost.mir.mir_opt as opt
import ...selfhost.mir.mir_memory as memory
import ...selfhost.mir.mir_terminals as terminals
import ...selfhost.backend.macho
import ...selfhost.backend.elf
import ...selfhost.backend.x86
import ...selfhost.backend.wasm_native as wasm
import ...selfhost.backend.wasm_abi as wa
import std.parse as decimal
import sys

fn number(at: i32) -> i32 { i32(decimal.integer(sys.arg(at)).value) }
fn compare(code: &mut arm.Code, a: i32, b: i32) {
    arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32)
}
fn main() {
    platform := number(2); taken := number(3); mut code := arm.new_for(platform)
    wrapper := arm.label(&mut code); entry := arm.label(&mut code)
    terminal := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, terminal); arm.exit(&mut code, 0)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    first := code.words.len; labels := code.labels.len; relocations := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1)
    arm.mov(&mut code, 2, 0); arm.imm(&mut code, 0, 13); arm.store(&mut code, 0, 0)
    for repeat in 0..8 { arm.load(&mut code, 0); arm.store(&mut code, 0, 0) }
    arm.mov(&mut code, 0, 2); arm.branch(&mut code, terminal, 19)
    arm.load(&mut code, 0); arm.ret(&mut code)
    mut sites: []i32 = []; mut f := mir.new()
    assert(lift.lift(&mut f, &code, first, labels, relocations, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    context := memory.for_source_producer(sys.arg(4) == "source")
    exits := terminals.TerminalContext { version: 1, overflow: terminal, zero: terminal,
        assertion: terminal, io: terminal, bounds: terminal, float_trap: terminal }
    mut work := opt.new()
    assert(opt.analyze_with_terminals(&mut work, &f, &context, &exits) && opt.promoted(&work) == 1)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
    assert(object_support.lower_and_link(&f, &mut code, &mut sites))
    arm.mark(&mut code, wrapper); wrapper_frame := arm.prologue(&mut code); arm.frame(&mut code, wrapper_frame, 0)
    arm.imm(&mut code, 25, 333); arm.imm(&mut code, 0, i64(taken)); arm.branch(&mut code, entry, 1)
    arm.imm(&mut code, 1, 13); compare(&mut code, 0, 1); arm.branch(&mut code, assertion, 3)
    arm.imm(&mut code, 0, 333); compare(&mut code, 25, 0); arm.branch(&mut code, assertion, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    mut image: []u8 = []; none: []i32 = []
    if platform == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if platform == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { bytes := arm.finish(&mut code); if platform == 0 { image = macho.image(&bytes) } else { image = elf.image(&bytes) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print(opt.promoted(&work))
}
