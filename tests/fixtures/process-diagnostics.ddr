// Public process API probe. No production fault controls are exposed here.
capability unsafe
import ...selfhost.process
import sys
import std.parse as decimal

@extern("c", "raise") unsafe fn raise_signal(signal: i32) -> i32
@extern("c", "usleep") unsafe fn sleep_us(interval: u32) -> i32
@extern("c", "sigprocmask") unsafe fn signal_mask(how: i32, set: ptr, old: ptr) -> i32

fn report(outcome: &process.Outcome) {
    print("OUTCOME code=" + outcome.code.str() + " stage=" + process.stage_name(outcome.stage) +
        " errno=" + outcome.os_error.str() + " raw_wait_status=" + outcome.raw_wait_status.str() +
        " pid=" + outcome.pid.str() + " wait_errno=" + outcome.wait_error.str() +
        " probe_errno=" + outcome.probe_error.str() + " parent_setpgid_errno=" + outcome.parent_group_error.str() +
        " clock_errno=" + outcome.clock_error.str() + " group_kill_errno=" + outcome.group_kill_error.str() +
        " fallback_kill_errno=" + outcome.fallback_kill_error.str() + " sleep_errno=" + outcome.sleep_error.str())
}

fn main() -> i32 {
    mode := sys.arg(1)
    if mode == "normal-child" { print("child-output"); status := sys.eprint("child-error"); return 0 }
    if mode == "exit126" || mode == "0" { return 126 }
    if mode == "quiet-child" { return 0 }
    if mode == "signal-child" { unsafe { raised := raise_signal(15) }; return 0 }
    if mode == "timeout-child" { unsafe { paused := sleep_us(1000000) }; return 0 }
    if mode == "mask-child" {
        unsafe {
            var mask: [u64; 16] = [0; 16]
            result := signal_mask(0, ptr(0), addr(&mut mask[0])); assert(result == 0)
            assert(mask[0].bit_and(4096) == 0)
        }
        print("child-mask-unchanged"); return 0
    }
    platform := decimal.integer(sys.arg(4)); timeout := decimal.integer(sys.arg(5))
    assert(platform.ok && timeout.ok)
    var path := sys.arg(2)
    var args: []string = [sys.arg(3)]
    if mode == "invalid-path" { path = path + "\0" }
    if mode == "invalid-arg" { args[0] = args[0] + "\0" }
    if mode == "wrapper" { return process.run(path, &args, timeout.value, i32(platform.value)) }
    if mode == "suite" {
        groups: []string = ["probe_group"]; keys: []string = []
        return process.tests(path, &groups, &keys, false, timeout.value, i32(platform.value))
    }
    outcome := process.run_detailed(path, &args, timeout.value, i32(platform.value))
    if mode == "parent-mask" {
        unsafe {
            var mask: [u64; 16] = [0; 16]
            result := signal_mask(0, ptr(0), addr(&mut mask[0])); assert(result == 0)
            assert(mask[0].bit_and(4096) == 0)
        }
    }
    report(&outcome)
    outcome.code
}
