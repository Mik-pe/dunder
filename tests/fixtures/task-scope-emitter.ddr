import ...selfhost.arm64 as arm
import ...selfhost.ffi_arm64 as abi
import ...selfhost.runtime
import ...selfhost.task_native as native
import ...selfhost.task_scope_emit as scopes
import ...selfhost.macho
import std.parse as parse
import sys

fn ld(c:&mut arm.Code,d:i32,b:i32,o:i32){abi.load(&mut c,d,b,o,8)}
fn st(c:&mut arm.Code,s:i32,b:i32,o:i32){abi.store(&mut c,s,b,o,8)}
fn check(c:&mut arm.Code,reg:i32,v:i64,bad:i32){arm.imm(&mut c,17,v);arm.emit(&mut c,3942645791+17*65536+i64(reg)*32);arm.branch(&mut c,bad,3)}
fn address(c:&mut arm.Code,sites:&mut []i32,slots:&mut []i32,slot:i32){sites.push(arm.position(&c)*4);slots.push(slot);arm.emit(&mut c,0);arm.emit(&mut c,0)}
fn imported(c:&mut arm.Code,sites:&mut []i32,slots:&mut []i32,slot:i32){address(&mut c,&mut sites,&mut slots,slot);arm.emit(&mut c,3594453504)}
fn release_array(c:&mut arm.Code,rt:&runtime.Runtime,slot:i32){arm.load(&mut c,slot);ld(&mut c,0,0,0);arm.branch(&mut c,rt.release,1);arm.load(&mut c,slot);arm.branch(&mut c,rt.release,1)}
fn open(c:&mut arm.Code,r:&scopes.Runtime,sites:&mut []i32,slots:&mut []i32,limit:i32){address(&mut c,&mut sites,&mut slots,-65);arm.mov(&mut c,1,16);arm.imm(&mut c,0,i64(limit));arm.branch(&mut c,r.open,1);arm.store(&mut c,18,0)}
fn await(c:&mut arm.Code,r:&scopes.Runtime,job:i32,ty:i32){arm.load(&mut c,18);arm.load_into(&mut c,job,1);arm.imm(&mut c,2,i64(ty));arm.branch(&mut c,r.await_result,1)}
fn main(){
    mode:=sys.arg(2);limit:=i32(parse.integer(sys.arg(3)).value);library:=sys.arg(4)
    array:=mode!="scalar";probe:=library!=""
    negative:=mode=="wrong-gen"||mode=="wrong-type"||mode=="wrong-index"||mode=="stale"||mode=="owner"||mode=="generation"||mode=="limit"
    var count:=12;if negative{count=1};if mode=="discard"{count=limit}
    var c:=arm.new();rt:=runtime.new(&mut c)
    entry:=arm.label(&mut c);job:=arm.label(&mut c);drop:=arm.label(&mut c);trap:=arm.label(&mut c);bad:=arm.label(&mut c)
    for reg in 19..25{arm.imm(&mut c,reg,0)}
    arm.branch(&mut c,entry,1);arm.syscall(&mut c,33554433,94);arm.emit(&mut c,3558866944)
    var clone: i32 = -1;if array{clone=rt.array_clone}
    var result_clone:=clone;if mode=="discard"{result_clone=bad}
    native_spec:=native.TaskSpec{input_clone:clone,worker:job,result_clone:result_clone}
    symbols:=native.Symbols{symbol_count:5,pthread_create:0,pthread_join:1,munmap:2}
    provider:=native.emit(&mut c,&rt,&native_spec,&symbols);assert(provider.ok)
    r:=scopes.emit_runtime(&mut c,&rt,trap);assert(r.ok)
    var drop_callback: i32 = -1;if array{drop_callback=drop}
    kind_spec:=scopes.KindSpec{result_type:101,create:provider.create,collect:provider.collect,discard:provider.discard,input_clone:clone,input_drop:drop_callback,result_clone:result_clone,result_drop:drop_callback}
    kind:=scopes.emit_kind(&mut c,&r,&kind_spec,-97);assert(kind.ok)
    var sites:=provider.import_sites;var slots:=provider.import_slots
    for i in 0..kind.import_sites.len{sites.push(kind.import_sites[i]);slots.push(kind.import_slots[i])}
    arm.mark(&mut c,entry);frame:=arm.prologue(&mut c);arm.frame(&mut c,frame,32)
    for slot in 0..32{arm.store(&mut c,slot,31)}
    if mode=="generation"{
        address(&mut c,&mut sites,&mut slots,-65);arm.imm(&mut c,0,1);st(&mut c,0,16,0)
        abi.thread_token(&mut c);st(&mut c,10,16,8);arm.imm(&mut c,0,2147483647);st(&mut c,0,16,16)
    }
    var maximum:=limit;if mode=="limit"{maximum=0}
    open(&mut c,&r,&mut sites,&mut slots,maximum)
    if array{
        arm.imm(&mut c,2,3);arm.branch(&mut c,rt.array_new,1);arm.store(&mut c,17,0)
        for value in [11,22]{arm.imm(&mut c,1,i64(value));arm.branch(&mut c,rt.array_push,1)}
    }
    for i in 0..count{
        arm.load(&mut c,18);if array{arm.load_into(&mut c,17,1)}else{arm.imm(&mut c,1,i64(30+i))}
        arm.branch(&mut c,kind.spawn,1);arm.store(&mut c,i,0);check(&mut c,0,4294967296+i64(i),bad)
        if array{arm.load(&mut c,17);ld(&mut c,1,0,0);arm.imm(&mut c,0,i64(12+i));st(&mut c,0,1,0)}
    }
    if mode=="stale"{
        await(&mut c,&r,0,101);arm.store(&mut c,20,0);if array{release_array(&mut c,&rt,20)}
        arm.load(&mut c,18);arm.store(&mut c,22,0)
        arm.load(&mut c,18);arm.branch(&mut c,r.close,1);open(&mut c,&r,&mut sites,&mut slots,limit)
        arm.load_into(&mut c,22,1);arm.emit(&mut c,3942645791+1*65536);arm.branch(&mut c,bad,3)
        arm.load(&mut c,18);if array{arm.load_into(&mut c,17,1)}else{arm.imm(&mut c,1,30)}
        arm.branch(&mut c,kind.spawn,1);check(&mut c,0,8589934592,bad)
    }
    if negative{
        arm.load(&mut c,18)
        if mode=="wrong-type"{
            ld(&mut c,1,0,48);arm.imm(&mut c,10,1);st(&mut c,10,1,0)
        }else if mode=="owner"{
            st(&mut c,31,0,72);arm.imm(&mut c,10,1);st(&mut c,10,0,48)
        }else{arm.imm(&mut c,10,1);st(&mut c,10,0,48)}
        arm.load_into(&mut c,0,1)
        if mode=="wrong-gen"{arm.imm(&mut c,1,8589934592)}
        else if mode=="wrong-index"{arm.imm(&mut c,1,4294967313)}
        var ty:=101;if mode=="wrong-type"{ty=102};arm.imm(&mut c,2,i64(ty));arm.branch(&mut c,r.await_result,1)
        arm.branch(&mut c,bad,0)
    }
    if mode!="unawaited"&&mode!="discard"{
        // Deliberately await in reverse order, leaving inactive FIFO nodes.
        for offset in 0..count{
            i:=count-1-offset;await(&mut c,&r,i,101);arm.store(&mut c,20,0)
            if array{ld(&mut c,1,0,0);ld(&mut c,10,1,0);check(&mut c,10,111+i64(i),bad);arm.imm(&mut c,0,999);st(&mut c,0,1,0)}
            else{check(&mut c,0,40+i64(i),bad)}
            await(&mut c,&r,i,101);arm.store(&mut c,21,0)
            if array{
                ld(&mut c,1,0,0);ld(&mut c,10,1,0);check(&mut c,10,111+i64(i),bad)
                arm.load_into(&mut c,20,1);arm.emit(&mut c,3942645791+1*65536);arm.branch(&mut c,bad,2)
                release_array(&mut c,&rt,20);if i>0{release_array(&mut c,&rt,21)}
            }else{check(&mut c,0,40+i64(i),bad)}
        }
    }
    arm.load(&mut c,18);arm.branch(&mut c,r.close,1);arm.store(&mut c,18,31)
    if array{
        release_array(&mut c,&rt,17)
        if mode!="unawaited"&&mode!="discard"{arm.load(&mut c,21);ld(&mut c,1,0,0);ld(&mut c,10,1,0);check(&mut c,10,111,bad);release_array(&mut c,&rt,21)}
    }
    if probe{
        arm.imm(&mut c,0,0);arm.imm(&mut c,1,i64(count));arm.imm(&mut c,2,0);if array{arm.imm(&mut c,2,1)}
        arm.imm(&mut c,3,i64(limit));var drops:=0;if array{drops=count*2;if mode=="unawaited"{drops=count*2-limit};if mode=="discard"{drops=count}}
        arm.imm(&mut c,4,i64(drops));imported(&mut c,&mut sites,&mut slots,3);check(&mut c,0,0,bad)
    }
    arm.imm(&mut c,0,0);arm.ret(&mut c)
    arm.mark(&mut c,job);worker_frame:=arm.prologue(&mut c);arm.frame(&mut c,worker_frame,2)
    if array{
        arm.store(&mut c,0,0);arm.branch(&mut c,rt.array_clone,1);arm.store(&mut c,1,0)
        ld(&mut c,1,0,0);ld(&mut c,0,1,0);arm.emit(&mut c,2432696320+100*1024);st(&mut c,0,1,0)
        release_array(&mut c,&rt,0);arm.load(&mut c,1)
    }else{arm.emit(&mut c,2432696320+10*1024)}
    arm.ret(&mut c)
    arm.mark(&mut c,drop);drop_frame:=arm.prologue(&mut c);arm.frame(&mut c,drop_frame,1);arm.store(&mut c,0,0)
    if probe{imported(&mut c,&mut sites,&mut slots,4)}
    release_array(&mut c,&rt,0);arm.ret(&mut c)
    arm.mark(&mut c,trap)
    if probe{
        var reason:=4;if mode=="create-fail"{reason=1}else if mode=="join-fail"{reason=2}else if mode=="unmap-fail"{reason=3}else if mode=="stale"{reason=5}else if mode=="generation"||mode=="limit"{reason=6}
        arm.imm(&mut c,0,i64(reason));arm.imm(&mut c,1,i64(count));arm.imm(&mut c,2,0);if array{arm.imm(&mut c,2,1)}
        arm.imm(&mut c,3,i64(limit));arm.imm(&mut c,4,0);imported(&mut c,&mut sites,&mut slots,3);check(&mut c,0,0,bad)
    }
    arm.exit(&mut c,112);arm.mark(&mut c,bad);arm.exit(&mut c,104);runtime.emit_runtime(&mut c,&rt)
    text:=arm.finish_for(&mut c,true)
    var libraries:[]string=["c","c","c"];var names:[]string=["pthread_create","pthread_join","munmap"]
    if probe{libraries=[library,library,library,library,library];names=["probe_create","probe_join","probe_unmap","scope_check","scope_drop"]}
    image:=macho.dynamic_storage(&text,&libraries,&names,&sites,&slots,176)
    saved:=sys.write_u8(sys.arg(1),&image);assert(saved.ok);executable:=sys.make_executable(sys.arg(1));assert(executable.ok)
}
