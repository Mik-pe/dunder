struct Box { text: string }
const PREFIX: string = "item"
const LABELS: []string = ["left", "right"]

fn choose_text(literal: bool) -> string {
    if literal { PREFIX } else { PREFIX + "s" }
}

fn keep(move value: string) -> string { move value }

fn identity(value: string) -> string { value.clone() }
fn make(value: i32) -> Box { Box { text: value.str() } }
fn replace(value: &mut string) -> string {
    value = "replacement"
    "10"
}
fn replace_field(value: &mut Box) -> string {
    value.text = "replacement"
    "20"
}
fn early(value: string, choose: bool) -> string {
    if choose { return value + "!" }
    value + "?"
}
fn main() {
    mut saved: []string = []
    for i in 0..4 {
        saved.push(keep(move "literal"))
        saved.push(choose_text(i == 2))
        saved.push(LABELS[i % 2])
    }
    assert(saved[0] == "literal" && saved[1] == "items" && saved[2] == "left")
    assert(saved[5] == "right" && saved[7] == "item")
    local := 10.str()
    other := "10"
    assert(local == other)
    assert(local != "11")
    assert(local < "20")
    assert(local <= other)
    assert(local >= other)
    assert(local > "09")
    assert(local + "!" == "10!")
    assert((local + "!") + "?" == "10!?")
    assert(local + (other + "!") == "1010!")
    assert(make(20).text == "20")
    box := make(20)
    assert(box.text == "20")
    values := [10.str(), 20.str(), 30.str()]
    assert(values[1] == "20")
    assert(local == values[(8 / 2) - 4])
    assert(identity(local) == other)
    assert(local == identity(other))

    mut mutable := 10.str()
    assert(mutable == replace(&mut mutable))
    assert(mutable == "replacement")
    mutable = 10.str()
    assert(identity(mutable) == replace(&mut mutable))
    assert(mutable == "replacement")
    mut mutable_box := make(20)
    assert(mutable_box.text == replace_field(&mut mutable_box))
    assert(mutable_box.text == "replacement")
    changer: fn(&mut string) -> string = replace
    mutable = 10.str()
    assert(mutable == changer(&mut mutable))
    assert(mutable == "replacement")
    mutable = 10.str()
    assert(mutable == (if other == "10" { changer(&mut mutable) } else { "xx" }))
    assert(mutable == "replacement")
    assert(early(local, true) == "10!")
    assert(early(local, false) == "10?")

    mut iteration := 0
    while iteration < 4000 {
        iteration = iteration + 1
        temporary := iteration.str()
        assert(temporary + "!" != temporary)
        assert(Box { text: temporary.clone() }.text == temporary)
        if iteration < 3 { continue }
        if iteration == 4000 { break }
        for inner in 0..3 {
            assert(temporary == temporary)
            if inner == 0 { continue }
            if inner == 2 { break }
            nested := temporary + "?"
            assert(nested != temporary)
        }
    }
    assert(iteration == 4000)
    print(42)
}
