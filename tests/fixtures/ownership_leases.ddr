struct Box { text: string }

fn identity(value: string) -> string { value }
fn make(value: i32) -> Box { Box { text: value.str() } }
fn replace(value: &mut string) -> string {
    value = "replacement"
    "10"
}
fn replace_field(value: &mut Box) -> string {
    value.text = "replacement"
    "20"
}
fn early(value: string, choose: bool) -> string {
    if choose { return value + "!" }
    value + "?"
}
fn main() {
    local := 10.str()
    other := "10"
    assert(local == other)
    assert(local != "11")
    assert(local < "20")
    assert(local <= other)
    assert(local >= other)
    assert(local > "09")
    assert(local + "!" == "10!")
    assert((local + "!") + "?" == "10!?")
    assert(local + (other + "!") == "1010!")
    assert(make(20).text == "20")
    box := make(20)
    assert(box.text == "20")
    values := [10.str(), 20.str(), 30.str()]
    assert(values[1] == "20")
    assert(local == values[(8 / 2) - 4])
    assert(identity(local) == other)
    assert(local == identity(other))

    // The RHS destroys the source owner. Its extra LHS lease must survive.
    var mutable := 10.str()
    assert(mutable == replace(&mut mutable))
    assert(mutable == "replacement")
    var mutable_box := make(20)
    assert(mutable_box.text == replace_field(&mut mutable_box))
    assert(mutable_box.text == "replacement")
    changer: fn(&mut string) -> string = replace
    mutable = 10.str()
    assert(mutable == changer(&mut mutable))
    assert(mutable == "replacement")
    assert(early(local, true) == "10!")
    assert(early(local, false) == "10?")

    // Reentry, continue, break and early returns share the same cleanup table.
    var iteration := 0
    while iteration < 4000 {
        iteration = iteration + 1
        temporary := iteration.str()
        assert(temporary + "!" != temporary)
        assert(Box { text: temporary }.text == temporary)
        if iteration < 3 { continue }
        if iteration == 4000 { break }
        for inner in 0..3 {
            assert(temporary == temporary)
            if inner == 0 { continue }
            if inner == 2 { break }
            nested := temporary + "?"
            assert(nested != temporary)
        }
    }
    assert(iteration == 4000)
    print(42)
}
