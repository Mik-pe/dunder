// Real ordered coordinator: three detached jobs complete3,1,2, while source
// Code advances independently. Merge in source order after destroying inputs.
// Both incremental reservation and sealed-before-completion schedules match
// serial lowering exactly, including optimization-induced size changes.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_link as link
import ...selfhost.mir_opt as promotion
import ...selfhost.mir_value_prop as values
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import ..mir_object_support as support
import std.parse as decimal
import sys

fn take(f: &mut mir.Function, code: &arm.Code, entry: i32, first: i32, label: i32, reloc: i32) {
    none: []i32 = []
    assert(lift.lift(&mut f, &code, first, label, reloc, &none, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
}
fn loop_body(code: &mut arm.Code, entry: i32) {
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    arm.emit(&mut code, 3942645823); arm.branch(&mut code, done, 12)
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 0); arm.pop(&mut code, 1)
    arm.emit(&mut code, 2332033056); arm.store(&mut code, 1, 0)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); arm.emit(&mut code, 2332098560); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done); arm.load(&mut code, 1); arm.ret(&mut code)
}
fn late_body(code: &mut arm.Code, entry: i32) {
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1)
    body := arm.label(&mut code); init := arm.label(&mut code)
    arm.branch(&mut code, init, 0); arm.mark(&mut code, body)
    arm.imm(&mut code, 1, 7); arm.mov(&mut code, 2, 1); arm.mov(&mut code, 3, 2)
    arm.imm(&mut code, 4, 35); arm.emit(&mut code, 2332229760); arm.ret(&mut code)
    arm.mark(&mut code, init); arm.store(&mut code, 0, 31); arm.branch(&mut code, body, 0)
}
fn wrapper_body(code: &mut arm.Code, entry: i32, loop: i32, late: i32, failed: i32) {
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    // Forward callee labels are still unmarked when this object is built.
    arm.branch(&mut code, loop, 1); arm.imm(&mut code, 1, 45); arm.emit(&mut code, 3942711327); arm.branch(&mut code, failed, 3)
    arm.branch(&mut code, late, 1); arm.imm(&mut code, 1, 42); arm.emit(&mut code, 3942711327); arm.branch(&mut code, failed, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
}
fn serial(f: &mir.Function, code: &mut arm.Code) {
    var work := lower.new(); var none: []i32 = []
    assert(lower.prepare(&mut work, &f, &code, &none)); lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut none)
}
fn main() {
    parsed := decimal.integer(sys.arg(2)); assert(parsed.ok); platform := i32(parsed.value)
    optimized := sys.arg(4) == "on"; assert(optimized || sys.arg(4) == "off")
    var source := arm.new_for(platform); wrapper := arm.label(&mut source); loop := arm.label(&mut source)
    late := arm.label(&mut source); failed := arm.label(&mut source)
    arm.branch(&mut source, wrapper, 1); arm.exit(&mut source, 0)
    arm.mark(&mut source, failed); arm.exit(&mut source, 104)
    var expected := arm.new_for(platform); support.copy_code(&mut expected, &source)
    var coordinator := link.new(); none_prefix: []i32 = []
    assert(link.begin(&mut coordinator, &source, &none_prefix))
    prefix_words := source.words.len
    var first := source.words.len; var label := source.labels.len; var reloc := source.at.len
    wrapper_body(&mut source, wrapper, loop, late, failed)
    var a := mir.new(); take(&mut a, &source, wrapper, first, label, reloc); first_labels := source.labels.len
    first = expected.words.len; label = expected.labels.len; reloc = expected.at.len
    wrapper_body(&mut expected, wrapper, loop, late, failed)
    var reference := mir.new(); take(&mut reference, &expected, wrapper, first, label, reloc); serial(&reference, &mut expected)
    first = source.words.len; label = source.labels.len; reloc = source.at.len
    loop_body(&mut source, loop); var b := mir.new(); take(&mut b, &source, loop, first, label, reloc); second_labels := source.labels.len
    first = expected.words.len; label = expected.labels.len; reloc = expected.at.len
    loop_body(&mut expected, loop); take(&mut reference, &expected, loop, first, label, reloc)
    var optimizer := promotion.new()
    if optimized {
        assert(promotion.analyze_into(&mut optimizer, &b)); promotion.apply(&mut optimizer, &mut b); assert(verify.verify(&mut b))
        assert(promotion.analyze_into(&mut optimizer, &reference)); promotion.apply(&mut optimizer, &mut reference); assert(verify.verify(&mut reference))
    }
    serial(&reference, &mut expected)
    first = source.words.len; label = source.labels.len; reloc = source.at.len
    late_body(&mut source, late); var c := mir.new(); take(&mut c, &source, late, first, label, reloc); final_labels := source.labels.len
    first = expected.words.len; label = expected.labels.len; reloc = expected.at.len
    late_body(&mut expected, late); take(&mut reference, &expected, late, first, label, reloc)
    var scalar := values.new()
    if optimized { assert(values.optimize_into(&mut scalar, &mut c)); assert(values.optimize_into(&mut scalar, &mut reference)) }
    serial(&reference, &mut expected)
    var third := lower.new_object(); var second := lower.new_object(); var first_object := lower.new_object()
    assert(lower.lower_into(&mut third, &c)); assert(lower.lower_into(&mut first_object, &a)); assert(lower.lower_into(&mut second, &b))
    // Destroy every input arena/global source table before linking the objects.
    mir.reset(&mut a); mir.reset(&mut b); mir.reset(&mut c); mir.reset(&mut reference)
    source.words.clear(); source.labels.clear(); source.at.clear(); source.target.clear(); source.kinds.clear()
    assert(!link.append(&mut coordinator, &third, 2))
    assert(link.word_count(&coordinator) == prefix_words && link.next_ordinal(&coordinator) == 0)
    if sys.arg(5) == "sealed" {
        assert(link.reserve_namespace(&mut coordinator, final_labels, 0) && link.seal_namespace(&mut coordinator, 3))
    } else { assert(sys.arg(5) == "grow"); assert(link.reserve_namespace(&mut coordinator, first_labels, 0)) }
    assert(link.append(&mut coordinator, &first_object, 0)); lower.reset_object(&mut first_object)
    if sys.arg(5) == "grow" { assert(link.reserve_namespace(&mut coordinator, second_labels, 0)) }
    assert(link.append(&mut coordinator, &second, 1)); lower.reset_object(&mut second)
    if sys.arg(5) == "grow" {
        assert(link.reserve_namespace(&mut coordinator, final_labels, 0) && link.seal_namespace(&mut coordinator, 3))
    }
    assert(!link.finalize(&mut coordinator)); assert(link.append(&mut coordinator, &third, 2)); lower.reset_object(&mut third)
    assert(link.finalize(&mut coordinator))
    var merged := arm.new(); var none: []i32 = []
    link.export_code(&mut coordinator, &mut merged); link.export_import_sites(&mut coordinator, &mut none)
    support.same_code(&expected, &merged)
    if sys.arg(3) == "serial" { support.copy_code(&mut merged, &expected) } else { assert(sys.arg(3) == "link") }
    var image: []u8 = []
    if platform == 3 { abi := wa.new(); result := wasm.image(&merged, merged.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if platform == 2 { result := x86.finish(&merged, merged.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut merged); if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print("objects=3")
}
