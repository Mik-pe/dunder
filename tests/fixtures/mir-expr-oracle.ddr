import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_terminals as terms
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import .mir_expr_qa_adapter as adapter
import .mir_region_qa_support as witness
import std.parse
import sys

fn number(at: i32) -> i64 { value := parse.integer(sys.arg(at)); assert(value.ok); value.value }
fn seed(reg: i32) -> i64 { 123456789012345 + i64(reg) * 1000003 }
fn binary(c: &mut arm.Code, word: i64, d: i32, a: i32, b: i32) { arm.emit(&mut c, word + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn add(c: &mut arm.Code, d: i32, a: i32, b: i32) { binary(&mut c, 2332033024, d, a, b) }
fn sub(c: &mut arm.Code, d: i32, a: i32, b: i32) { binary(&mut c, 3405774848, d, a, b) }
fn cmp(c: &mut arm.Code, a: i32, b: i32) { binary(&mut c, 3942645760, 31, a, b) }
fn cset(c: &mut arm.Code, d: i32, condition: i32) { arm.emit(&mut c, 2594113504 + i64(condition.bit_xor(1)) * 4096 + i64(d)) }
fn push(c: &mut arm.Code, reg: i32, origin: bool) { if origin { arm.push_temp(&mut c, reg) } else { arm.push(&mut c, reg) } }
fn pop(c: &mut arm.Code, reg: i32, origin: bool) { if origin { arm.pop_temp(&mut c, reg) } else { arm.pop(&mut c, reg) } }
fn expect(c: &mut arm.Code, actual: i32, wanted: i64, failed: i32) { arm.imm(&mut c, 1, wanted); cmp(&mut c, actual, 1); arm.branch(&mut c, failed, 3) }
fn call_observer(c: &mut arm.Code, failed: i32, selected: i32, input: i64, control: i64) {
    flag_bad:=arm.label(&mut c);sp_bad:=arm.label(&mut c);value_bad:=arm.label(&mut c);padding_bad:=arm.label(&mut c)
    f := arm.prologue(&mut c); arm.frame(&mut c, f, 24)
    for reg in 0..18 { arm.store(&mut c, reg, reg) }
    for flag in 0..4 { cset(&mut c, 0, flag * 2); arm.store(&mut c, 18 + flag, 0) }
    // Kept original values, including all nominal scratch, remain inputs to
    // this raw observer. It never aliases private expression backing.
    for reg in 0..18 {
        arm.load(&mut c, reg)
        if reg == 0 {
            arm.mov(&mut c, 1, 0); arm.emit(&mut c, 4164943872 + 29 * 32)
            arm.emit(&mut c, 2432696320 + 48 * 1024); cmp(&mut c, 1, 0); arm.branch(&mut c, failed, 3)
        } else { var wanted := seed(reg); if reg == 4 { wanted = input }; if reg == 5 { wanted = control }; expect(&mut c, 0, wanted, failed) }
    }
    difference := input.wrapping_sub(control); var carry := input >= control
    if input < 0 && control >= 0 { carry=true }; if input >= 0 && control < 0 { carry=false }
    overflow := (input < 0 && control >= 0 && difference >= 0) || (input >= 0 && control < 0 && difference < 0)
    flags: []bool = [difference==0,carry,difference<0,overflow]
    for flag in 0..4 { arm.load(&mut c,18+flag); var wanted:=0; if flags[flag]{wanted=1}; expect(&mut c,0,i64(wanted),flag_bad) }
    var bytes := 16; if selected == 10 { bytes = 32 }; if selected == 19 {bytes=96}
    arm.emit(&mut c, 4164943872 + 29 * 32); arm.emit(&mut c, 3506438144 + i64(bytes) * 1024)
    arm.emit(&mut c, 2432696320 + 16 * 1024 + 29 * 32 + 1); cmp(&mut c, 1, 0); arm.branch(&mut c, sp_bad, 3)
    if selected == 9 || selected == 10 {
        // Only role0 raw/argument storage is observed. In case9 the observer
        // changes the backing value; case10 reads a real ninth stack argument.
        arm.emit(&mut c, 4164943872 + 16 * 4096 + 29 * 32)
        var wanted := input; if selected == 10 { wanted = control }; expect(&mut c, 0, wanted, value_bad)
        // Raw Push is STP value,XZR: the padding is an observable ZERO write.
        arm.emit(&mut c,4164943872+24*4096+29*32); expect(&mut c,0,0,padding_bad)
        if selected == 9 { arm.imm(&mut c, 0, control); arm.emit(&mut c, 4160749568 + 16 * 4096 + 29 * 32) }
    }
    if selected == 19 {
        // Minimal frame-lifetime contract permits observers and mutation.
        arm.emit(&mut c,4164943872+29*32);arm.emit(&mut c,4164943872+i64(-8).bit_and(511)*4096)
        expect(&mut c,0,input,value_bad)
        arm.emit(&mut c,4164943872+29*32);arm.load_into(&mut c,5,1)
        arm.emit(&mut c,3087007744+i64(-8).bit_and(511)*4096+1)
    }
    for reg in 0..18 { arm.imm(&mut c, reg, 9000007 + i64(reg) * 101) }
    arm.imm(&mut c, 0, 99); arm.ret(&mut c)
    arm.mark(&mut c,flag_bad);arm.exit(&mut c,108);arm.mark(&mut c,sp_bad);arm.exit(&mut c,106)
    arm.mark(&mut c,value_bad);arm.exit(&mut c,107);arm.mark(&mut c,padding_bad);arm.exit(&mut c,105)
}
fn main() {
    target := i32(number(2)); selected := i32(number(3)); enabled := sys.arg(4) == "on"
    input := number(5); control := number(6); expected := number(7); limit := i32(number(8))
    origin := number(9) != 0; storage := number(10) != 0; terminal := number(11) != 0
    var c := arm.new_for(target)
    wrapper := arm.label(&mut c); entry := arm.label(&mut c); failed := arm.label(&mut c)
    callee := arm.label(&mut c); outside := arm.label(&mut c); zero := arm.label(&mut c)
    arm.branch(&mut c, wrapper, 1); arm.exit(&mut c, 0)
    arm.mark(&mut c, failed); arm.exit(&mut c, 104); arm.mark(&mut c, zero); arm.exit(&mut c, 102)
    arm.mark(&mut c, callee); call_observer(&mut c, failed, selected, input, control)
    arm.mark(&mut c, outside)
    expect(&mut c, 0, input, failed)
    for reg in 9..18 { arm.imm(&mut c, 0, seed(reg)); cmp(&mut c, reg, 0); arm.branch(&mut c, failed, 3) }
    arm.imm(&mut c, 0, input); arm.ret(&mut c)
    first := c.words.len; labels := c.labels.len; relocations := c.at.len
    arm.begin_mir(&mut c, true); arm.mark(&mut c, entry)
    if selected == 16 || selected == 17 {
        // Bare Wasm entry has exactly1MiB of backing. The reservation itself
        // succeeds; only the extra raw/temporary Push crosses the lower guard.
        if selected == 16 {
            arm.emit(&mut c, 3506439167 + 4194304 + 256 * 1024)
            arm.imm(&mut c, 0, 77); push(&mut c, 0, origin); pop(&mut c, 1, origin)
            arm.mov(&mut c, 0, 1); arm.emit(&mut c, 2432697343 + 4194304 + 256 * 1024)
        } else { pop(&mut c, 0, origin) }
        arm.emit(&mut c, 3596551104)
    } else {
        f := arm.prologue(&mut c); var slots := 0; if selected == 15 || selected==19 { slots = 12 }; if selected == 18 {slots=16}; arm.frame(&mut c, f, slots)
        if selected == 0 || selected == 1 || selected == 2 {
            push(&mut c, 4, origin)
            if selected != 0 { push(&mut c, 5, origin); arm.imm(&mut c, 0, 7); pop(&mut c, 1, origin); sub(&mut c, 0, 1, 0) }
            else { arm.imm(&mut c, 0, 7) }
            pop(&mut c, 1, origin); if selected == 0 {add(&mut c,0,0,1)}else{sub(&mut c,0,1,0)}
            if selected == 2 { cset(&mut c, 1, 6); arm.imm(&mut c, 2, 8); binary(&mut c, 2600500224, 1, 1, 2); add(&mut c, 0, 0, 1) }
        } else if selected == 3 {
            arm.emit(&mut c, 704644064 + 4 * 65536); push(&mut c, 0, origin); arm.imm(&mut c, 0, 7); pop(&mut c, 1, origin); add(&mut c, 0, 0, 1)
        } else if selected == 4 {
            push(&mut c, 31, origin); arm.imm(&mut c, 0, 7); pop(&mut c, 1, origin); add(&mut c, 0, 0, 1)
        } else if selected == 5 {
            alternative := arm.label(&mut c); join := arm.label(&mut c); cmp(&mut c, 5, 31); arm.branch(&mut c, alternative, 2)
            push(&mut c, 4, origin); arm.branch(&mut c, join, 0); arm.mark(&mut c, alternative); push(&mut c, 5, origin)
            arm.mark(&mut c, join); pop(&mut c, 0, origin)
        } else if selected == 6 {
            head := arm.label(&mut c); done := arm.label(&mut c); push(&mut c, 4, origin); arm.imm(&mut c, 0, 0)
            arm.mark(&mut c, head); cmp(&mut c, 5, 31); arm.branch(&mut c, done, 15)
            arm.imm(&mut c, 1, 1); add(&mut c, 0, 0, 1); sub(&mut c, 5, 5, 1); arm.branch(&mut c, head, 0)
            arm.mark(&mut c, done); pop(&mut c, 1, origin); add(&mut c, 0, 0, 1)
        } else if selected == 7 {
            push(&mut c, 4, origin); push(&mut c, 5, origin); arm.imm(&mut c, 0, 7)
            arm.branch(&mut c, zero, 0); pop(&mut c, 1, origin); pop(&mut c, 1, origin)
        } else if selected >= 8 && selected <= 10 {
            var private := origin; if selected == 9 { private = false }; push(&mut c, 4, private)
            if selected == 10 { arm.push(&mut c, 5) }
            arm.branch(&mut c, callee, 1); arm.mov(&mut c, 2, 0)
            if selected == 10 { arm.pop(&mut c, 9) }
            pop(&mut c, 1, private); add(&mut c, 0, 1, 2)
        } else if selected == 11 {
            arm.push(&mut c, 4); arm.emit(&mut c, 2432696320 + 31 * 32 + 7)
            arm.emit(&mut c, 4177526784 + 7 * 32 + 5); arm.pop(&mut c, 0)
        } else if selected == 12 {
            arm.push(&mut c, 4); arm.emit(&mut c, 2432696320 + 31 * 32 + 7); arm.pop(&mut c, 0)
            arm.emit(&mut c, 2432696320 + 31 * 32 + 1); sub(&mut c, 0, 1, 7)
        } else if selected == 13 {
            push(&mut c, 4, origin); pop(&mut c, 0, origin); arm.branch(&mut c, outside, 0)
        } else if selected == 14 {
            push(&mut c, 4, origin); cmp(&mut c, 5, 31); arm.branch(&mut c, zero, 2); pop(&mut c, 0, origin)
        } else if selected == 15 {
            arm.store(&mut c, 0, 4); push(&mut c, 5, origin)
            arm.load(&mut c, 0); arm.load_into(&mut c, 0, 2); sub(&mut c, 0, 0, 2); arm.load_into(&mut c, 0, 2); add(&mut c, 0, 0, 2)
            pop(&mut c, 1, origin); add(&mut c, 0, 0, 1)
        } else if selected == 18 {
            for i in 0..12 { arm.imm(&mut c,1,i64(i));add(&mut c,0,4,1);arm.store(&mut c,i,0) }
            for i in 0..12 { arm.imm(&mut c,1,i64(i));sub(&mut c,0,5,1);push(&mut c,0,origin) }
            arm.imm(&mut c,2,0)
            for i in 0..12 { arm.load(&mut c,i);add(&mut c,2,2,0);arm.load(&mut c,i);add(&mut c,2,2,0) }
            for i in 0..12 { pop(&mut c,1,origin);arm.imm(&mut c,0,i64(i+1));binary(&mut c,2600500224,1,1,0);add(&mut c,2,2,1) }
            arm.mov(&mut c,0,2)
        } else if selected == 19 {
            arm.store(&mut c,0,4);arm.branch(&mut c,callee,1);push(&mut c,0,origin)
            arm.emit(&mut c,3091202048+i64(-8).bit_and(511)*4096+29*32)
            arm.emit(&mut c,3091202048+i64(-8).bit_and(511)*4096+29*32+2);sub(&mut c,0,0,2)
            arm.emit(&mut c,3091202048+i64(-8).bit_and(511)*4096+29*32+2);add(&mut c,0,0,2)
            pop(&mut c,1,origin);add(&mut c,0,0,1)
        } else if selected == 20 {
            // Raw padding semantics are directly covered by the generic
            // Interpreter, with no helper expansion or inserted zero store.
            arm.push(&mut c,4);arm.emit(&mut c,4181721088+1024+31*32);arm.pop(&mut c,1)
        } else { assert(false) }
        arm.ret(&mut c)
    }
    arm.end_mir(&mut c)
    var sites: []i32 = []; var model := mir.new()
    assert(lift.lift_spans(&mut model, &c, first, labels, relocations, &sites, 0, &c.mir_starts, &c.mir_ends, &c.mir_kinds, &c.mir_a, &c.mir_b))
    assert(lift.own_entry(&mut model, &c, entry) && verify.verify(&mut model))
    print("HELPERS"); print(callee); print(outside); print(zero); print("ENDHELPERS")
    print("ORIGINAL"); witness.dump(&model); witness.metadata(&model)
    var result := adapter.Result { changed:false,status:0,units:0,placed:0,pushes:0,pops:0,copies:0,loads:0,stores:0,captures:0 }
    if enabled {
        var exits := terms.no_terminals()
        if terminal { exits.version=1; exits.overflow=zero; exits.zero=zero; exits.assertion=failed; exits.io=zero; exits.bounds=zero; exits.float_trap=zero }
        result = adapter.run(&mut model, storage, selected==19, &exits, limit)
    } else { assert(sys.arg(4) == "off") }
    assert(result.status != -1)
    print("RESULT"); witness.dump(&model); witness.metadata(&model)
    print("STACKCOUNTERS"); print(result.changed); print(result.status); print(result.units); print(result.placed)
    print(result.pushes); print(result.pops); print(result.copies); print(result.loads); print(result.stores); print(result.captures)
    assert(model.verified && verify.verify(&mut model)); var object := lower.new(); assert(lower.prepare(&mut object, &model, &c, &sites))
    lower.commit_code(&mut object, &mut c); lower.commit_imports(&mut object, &mut sites); print(c.words.len-first)
    arm.mark(&mut c, wrapper); f := arm.prologue(&mut c); arm.frame(&mut c, f, 4)
    for reg in 0..29 { arm.imm(&mut c, reg, seed(reg)) }
    if selected == 9 || selected == 10 || selected == 20 {
        var bytes:=24; if selected==10{bytes=40}
        arm.emit(&mut c,4160749568+i64(-bytes).bit_and(511)*4096+31*32+17)
    }
    arm.emit(&mut c, 2432696320 + 31 * 32); arm.store(&mut c, 0, 0); arm.mov(&mut c, 0, 29); arm.store(&mut c, 2, 0)
    arm.imm(&mut c, 4, input); arm.imm(&mut c, 5, control); cmp(&mut c, 4, 5); arm.branch(&mut c, entry, 1)
    expect(&mut c, 0, expected, failed)
    for reg in 18..29 { arm.imm(&mut c, 0, seed(reg)); cmp(&mut c, reg, 0); arm.branch(&mut c, failed, 3) }
    arm.emit(&mut c, 2432696320 + 31 * 32); arm.load_into(&mut c, 0, 1); cmp(&mut c, 0, 1); arm.branch(&mut c, failed, 3)
    arm.load(&mut c, 2); cmp(&mut c, 29, 0); arm.branch(&mut c, failed, 3); arm.imm(&mut c, 0, 0); arm.ret(&mut c)
    var image: []u8 = []; none: []i32 = []
    if target == 3 { a := wa.new(); var start := wrapper; if selected == 16 || selected == 17 { start = entry }; built := wasm.image(&c, c.words.len, start, 1, &a); assert(built.ok); image=built.text }
    else if target == 2 { built := x86.finish(&c,c.words.len,&none,&none); assert(built.ok); image=elf.image_for(&built.text,62) }
    else { text:=arm.finish(&mut c); if target == 0 {image=macho.image(&text)}else{image=elf.image(&text)} }
    assert(sys.write_u8(sys.arg(1),&image).ok && sys.make_executable(sys.arg(1)).ok)
}
