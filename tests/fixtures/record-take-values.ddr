struct Inner { numbers: []i64, words: []string, title: string }
enum Shared { Empty, Items([]i32) }
@c_layout struct Inline { tag: u8, halves: [u16; 3] }
struct Record { inner: Inner, fixed: [i32; 3], shared: Shared, inline: Inline }
struct Container { item: Record }
fn make(n: i32) -> Record {
    var numbers: []i64 = []; numbers.reserve(64)
    for i in 0..n { numbers.push(i64(i + 100)) }
    Record { inner: Inner { numbers: numbers, words: [n.str(), "tail"], title: "title" + n.str() },
        fixed: [3, 5, 7], shared: .Items([11, 13]), inline: Inline { tag: 9, halves: [17, 19, 23] } }
}
fn choose(n: i32) -> Record { if n % 2 == 0 { return (make(n)) }; make(n) }
fn container(n: i32) -> Container { Container { item: make(n) } }
fn inspect(r: Record, n: i32) -> bool {
    var cap := n; if cap > 0 && cap < 8 { cap = 8 }
    assert(r.inner.numbers.len == n && r.inner.numbers.cap() == cap)
    for i in 0..n { assert(r.inner.numbers[i] == i64(i + 100)) }
    assert(r.inner.words[0] == n.str() && r.inner.words[1] == "tail")
    assert(r.inner.words.cap() == 8 && r.inner.title == "title" + n.str())
    assert(r.fixed[0] == 3 && r.fixed[2] == 7)
    assert(r.inline.tag == 9 && r.inline.halves[1] == 19 && r.inline.halves[2] == 23)
    match r.shared { .Items(values) => { assert(values.len == 2 && values[1] == 13) }, _ => { assert(false) } }
    true
}
fn replace(r: &mut Record) { r = make(9) }
fn replace_number(r: &mut Record) -> i32 { replace(&mut r); 7 }
fn pair(r: Record, effect: i32, n: i32) -> bool { assert(effect == 7); inspect(r, n) }
fn reentrant(n: i32) -> Record {
    for i in 0..8 {
        current := choose(n)
        if i < 2 { continue }
        if i == 6 { return current }
        assert(inspect(current, n))
    }
    make(n)
}
fn main() {
    for i in 0..160 {
        n := i % 18
        var original := (choose(n)); assert(inspect(original, n))
        // Locals and field projections remain value snapshots, even when a
        // different owned temporary was most recently evaluated.
        snapshot := original
        assert(pair(original, replace_number(&mut original), n))
        original = choose(n)
        projected := container(n).item
        nested := container(n).item.inner
        shared_alias := original.shared
        original.inner.numbers.reserve(64)
        replace(&mut original)
        assert(inspect(snapshot, n) && inspect(projected, n))
        assert(nested.numbers.len == n && nested.words[0] == n.str())
        assert(inspect(reentrant(n), n))
        maker: fn(i32) -> Record = choose
        assert(inspect(maker(n), n))
        match shared_alias { .Items(values) => { assert(values[0] == 11) }, _ => { assert(false) } }
        var assigned := make(1); assigned = choose(n); assert(inspect(assigned, n))
        assigned = assigned; assert(inspect(assigned, n))
        if i % 3 == 0 { continue }
        for j in 0..4 { temporary := make(n); assert(inspect(temporary, n)); if j == 1 { break } }
    }
    print(42)
}
