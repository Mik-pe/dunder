// Exercise the same comparison walker in functions and caller-owned frames.
import ...selfhost.arm64 as arm
import ...selfhost.lexer
import ...selfhost.opt_ir as ir
import ...selfhost.opt_parse as parse
import ...selfhost.opt_alloc as alloc
import ...selfhost.opt_emit as emitter
import ...selfhost.opt_verify as verify
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn integer(at: i32) -> i64 { parsed := decimal.integer(sys.arg(at)); assert(parsed.ok); parsed.value }
fn address(code: &mut arm.Code, slot: i32) { arm.imm(&mut code, 0, i64(slot + 1) * 8); arm.emit(&mut code, 3405775776) }
fn compare(code: &mut arm.Code, left: i32, right: i32) { arm.emit(&mut code, 3942645791 + i64(right) * 65536 + i64(left) * 32) }
fn input(code: &mut arm.Code, id: i32) {
    if id < 3 { arm.imm(&mut code, 0, integer(8 + id)) }
    else if id == 3 { address(&mut code, 695) }
    else if id == 4 { address(&mut code, 727) }
    else { assert(id == 5); arm.imm(&mut code, 0, integer(11)) }
}
fn main() {
    platform := i32(integer(3)); var mode := sys.arg(4)
    source := sys.read_text(sys.arg(1)); assert(source.ok)
    tokens := lexer.scan(source.value, false)
    names: []string = ["a", "b", "z", "values"]
    scalar := i32(integer(7)); types: []i32 = [scalar, scalar, scalar, 20]; positions: []i32 = [0, 1, 2, 3]
    var f := ir.new()
    assert(parse.parse(&mut f, &tokens, 4, tokens.kinds.len - 2, &names, &types, &positions, i32(integer(6))))
    if mode == "swapped" {
        // A prior typed simplification may expose a constant on the left even
        // when literal-first source inference would initially choose i32.
        root := f.nodes.left[f.nodes.left[f.root]]
        assert(f.nodes.kinds[root] == 3 && f.nodes.values[root] >= 6 && f.nodes.values[root] <= 11)
        saved := f.nodes.left[root]; f.nodes.left[root] = f.nodes.right[root]; f.nodes.right[root] = saved
        mode = "homes"
    }
    assert(verify.validate(&f, false))
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &f)
    var code := arm.new_for(platform)
    entry := arm.label(&mut code); function := arm.label(&mut code)
    overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    var settings := emitter.options(); settings.frame_free_enabled = false
    if mode == "function" {
        first := code.words.len
        emitter.emit_prepared_configured(&mut code, &f, &plan, function, overflow, zero, bounds, &settings)
        for at in first..code.words.len { print(code.words[at]) }
    } else {
        // Synthetic data/len homes follow the four source locals. Unrelated
        // physical frame positions catch accidental local-ID loads.
        assert(plan.homes.len == 6 && plan.data[3] == 4 && plan.length[3] == 5)
        homes: []i32 = [4, 10, 17, -1, 12, 11]
        for id in 0..homes.len { plan.homes[id] = homes[id] }
        if mode == "left-spill" { plan.homes[0] = -1 }
        else if mode == "right-spill" { plan.homes[1] = -1 }
        else if mode == "spills" { for id in 0..plan.homes.len { plan.homes[id] = -1 } }
        else { assert(mode == "homes") }
        slots: []i32 = [37, 620, 71, 96, 112, 113]
        for slot in slots { plan.frame_slots.push(slot) }
    }
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 760)
    values: []i64 = [3, -7, 11, 17, -1, 5, 8, 6]
    for i in 0..values.len { arm.imm(&mut code, 0, values[i]); arm.store(&mut code, 727 - i, 0) }
    address(&mut code, 727); arm.store(&mut code, 700, 0)
    arm.imm(&mut code, 0, integer(11)); arm.store(&mut code, 699, 0); arm.store(&mut code, 698, 0)
    arm.imm(&mut code, 0, 3); arm.store(&mut code, 697, 0)
    address(&mut code, 700); arm.store(&mut code, 695, 0)
    if mode == "function" {
        for p in 0..4 { input(&mut code, p); arm.mov(&mut code, p, 0) }
        // x0 must be loaded last, as every input helper uses it.
        input(&mut code, 0); arm.branch(&mut code, function, 1)
    } else {
        for id in 0..plan.homes.len {
            input(&mut code, id)
            if plan.homes[id] >= 0 { arm.mov(&mut code, plan.homes[id], 0) }
            else { arm.store(&mut code, plan.frame_slots[id], 0) }
        }
        returned := f.nodes.left[f.root]
        assert(f.nodes.kinds[returned] == 15 && f.nodes.next[returned] == -1)
        first := code.words.len
        emitter.emit_expression(&mut code, &f.nodes, &f.local_types, &plan, f.nodes.left[returned], overflow, zero, bounds, &settings)
        for at in first..code.words.len { print(code.words[at]) }
    }
    arm.imm(&mut code, 2, integer(5)); compare(&mut code, 0, 2); arm.branch(&mut code, assertion, 3)
    if mode != "function" {
        for id in 0..plan.homes.len {
            if plan.homes[id] >= 0 { input(&mut code, id); compare(&mut code, plan.homes[id], 0); arm.branch(&mut code, assertion, 3) }
        }
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    arm.mark(&mut code, overflow); arm.exit(&mut code, 101)
    arm.mark(&mut code, zero); arm.exit(&mut code, 102)
    arm.mark(&mut code, bounds); arm.exit(&mut code, 103)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    var image: []u8 = []; none: []i32 = []
    if platform == 3 {
        abi := wa.new(); result := wasm.image(&code, code.words.len, entry, 1, &abi); assert(result.ok); image = result.text
    } else if platform == 2 {
        result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62)
    } else {
        text := arm.finish(&mut code)
        if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) }
    }
    saved := sys.write_u8(sys.arg(2), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(2)); assert(executable.ok)
}
