capability unsafe
import ...stdlib.array as array

fn string_identity(value: string) -> i64 { unsafe { load_i64(addr(&value)) } }
fn array_identity(value: []string) -> usize { unsafe { usize(addr(&value[0])) } }

fn main() {
    mut values: []string = ["z" + 4.str(), "a" + 2.str(), "å" + 1.str(), "a" + 1.str()]
    values.reserve(128)
    storage := array_identity(values)
    z4 := string_identity(values[0]); a2 := string_identity(values[1])
    aa1 := string_identity(values[2]); a1 := string_identity(values[3])
    array.sort<string>(&mut values)
    assert(values.cap() == 128 && array_identity(values) == storage)
    assert(values[0] == "a1" && values[1] == "a2" && values[2] == "z4" && values[3] == "å1")
    assert(string_identity(values[0]) == a1 && string_identity(values[1]) == a2)
    assert(string_identity(values[2]) == z4 && string_identity(values[3]) == aa1)
    print("stdlib sort moves ok")
}
