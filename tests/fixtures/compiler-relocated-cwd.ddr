capability filesystem
import ...selfhost.driver.cache_io
import sys

fn main() {
    stale := sys.arg(1)
    source := "source.ddr"
    assert(!sys.same_file(stale, "."))
    assert(sys.same_file(stale + "/" + source, source))
    assert(cache_io.root_from(stale, source) == cache_io.root(source))
    assert(cache_io.root_from(stale, ".") == cache_io.root("."))
}
