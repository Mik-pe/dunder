// Whole-source API consumer. Source reports are separate from performed work.
import ...selfhost.compile as compiler
import ...selfhost.lexer
import ...selfhost.macho
import ...selfhost.elf
import std.parse as parse
import sys
fn main()->i32 {
    source:=sys.read_text(sys.arg(1));assert(source.ok)
    target:=i32(parse.integer(sys.arg(3)).value)
    var config:=compiler.configuration();config.mir_enabled=sys.arg(4)!="off"
    config.mir_opt_enabled=sys.arg(4)=="opt"
    // Preserve real call boundaries independently of the compiler's defaults.
    config.inline_enabled=false
    var tokens:=lexer.scan(source.value,false);var records:=compiler.bindings();none:[]i32=[]
    checking:=sys.arg(5)=="check"
    result:=compiler.compile_options(&mut tokens,target,&none,&none,checking,true,&mut records,"","mir-qa:v1",&config)
    if !result.ok{print("ERROR");print(result.offset);print(result.error);return 1}
    if !checking {
        var image:=result.text
        if target==0{image=macho.image(&image)}else if target==1{image=elf.image(&image)}else if target==2{image=elf.image_for(&image,62)}
        assert(sys.write_u8(sys.arg(2),&image).ok);assert(sys.make_executable(sys.arg(2)).ok)
    }
    print("MIR");print(records.mir_functions);print(records.mir_operations);print(records.mir_opaque)
    print("OPT");print(records.mir_optimization_enabled)
    print(records.mir_optimized);print(records.mir_promoted);print(records.mir_removed_loads);print(records.mir_removed_stores)
    print(records.mir_analysis_units);print(records.mir_budget_refusals)
    print("BINDINGS");print(records.offsets.len)
    for at in 0..records.offsets.len{print(records.offsets[at]);print(records.names[at]);print(records.types[at])}
    0
}
