fn dynamic_sum(values: &[]i64) -> i64 {
    mut result: i64 = 0
    for value in values { result += value }
    result
}
fn fixed_sum(values: &[i32; 2]) -> i32 { values[0] + values[1] }
fn main() {
    mut matrix: [][]i64 = [[20, 22], [1, 2, 3], []]
    mut total: i64 = 0
    for row in &matrix { total += dynamic_sum(row) }
    assert(total == 48 && dynamic_sum(&matrix[0]) == 42)
    {
        first := &matrix[0]
        assert(dynamic_sum(first) == 42)
        selected := &matrix[0..2]
        mut sum: i64 = 0
        for row in selected { sum += dynamic_sum(row) }
        assert(sum == 48)
    }
    mut copied := matrix.clone()
    copied[0][0] = 99
    assert(matrix[0][0] == 20 && copied[0][0] == 99)
    matrix.push([7, 8])
    popped := matrix.pop()
    assert(dynamic_sum(&popped) == 15 && matrix.len == 3)
    mut iterated: i64 = 0
    for row in matrix.iter() { iterated += dynamic_sum(row) }
    assert(iterated == 48)
    snapshot := matrix.clone().iter()
    matrix[0][0] = 21
    mut frozen: i64 = 0
    for row in snapshot { frozen += dynamic_sum(row) }
    assert(frozen == 48 && matrix[0][0] == 21)
    mut fixed: [][i32; 2] = [[20, 22], [7, 9]]
    mut fixed_total := 0
    for row in &fixed { fixed_total += fixed_sum(row) }
    assert(fixed_total == 58 && fixed_sum(&fixed[0]) == 42)
    {
        row := &fixed[1]
        assert(fixed_sum(row) == 16)
    }
    fixed.swap(0, 1)
    assert(fixed[0][0] == 7 && fixed[1][1] == 22)
    mut fixed_copy := fixed.clone()
    fixed_copy[0][1] = 100
    assert(fixed[0][1] == 9 && fixed_copy[0][1] == 100)
    mut via_iter := 0
    for row in fixed.iter() { via_iter += fixed_sum(row) }
    assert(via_iter == 58)
    print("nested aggregate arrays ok")
}
