fn byte_pairs() -> [](i32, i32) { [(5, 9)] }

fn collect(width: i32, height: i32) {
    if width < 1 || height < 1 { return }
    mut output: []u8 = []
    for (left, right) in byte_pairs() {
        output.push(u8(left))
        output.push(u8(right))
    }
    assert(output == [u8(5), 9])
}

fn main() { collect(1, 1) }
