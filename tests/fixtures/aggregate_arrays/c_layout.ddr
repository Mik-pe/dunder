capability unsafe
@c_layout struct CRecord { first: i32, second: i32, third: i32 }
fn value(number: i32) -> CRecord { CRecord { first: number, second: number + 1, third: number + 2 } }
fn total(record: &CRecord) -> i32 { record.first + record.second + record.third }
fn main() {
    unsafe { assert(size_of(CRecord) == 12 && align_of(CRecord) == 4) }
    mut values: []CRecord = [value(1), value(10)]
    values.reserve(33)
    values.push(value(20))
    assert(values.len == 3 && total(&values[0]) == 6 && total(&values[1]) == 33)
    assert(total(&values[2]) == 63)
    scalar := value(100)
    unsafe {
        address := addr(&scalar)
        assert(load_i32(address) == 100)
        assert(load_i32(ptr(usize(address) + 4)) == 101)
        assert(load_i32(ptr(usize(address) + 8)) == 102)
    }
    unsafe { assert(usize(addr(&values[1])) - usize(addr(&values[0])) == 12) }
    mut sliced := (&values[1..3]).clone()
    assert(sliced.len == 2 && total(&sliced[0]) == 33)
    sliced[1] = value(32)
    assert(total(&values[2]) == 63 && total(&sliced[1]) == 99)
    first := sliced.remove(0)
    assert(total(&first) == 33 && total(&sliced[0]) == 99)
    mut fixed := [value(5); 3]
    fixed[1] = value(15)
    assert(total(&fixed[0]) == 18 && total(&fixed[1]) == 48 && total(&fixed[2]) == 18)
    mut owned_sum := 0
    for item in move fixed { owned_sum += total(&item) }
    assert(owned_sum == 84)
    mut sum := 0
    for record in &values { sum += total(record) }
    assert(sum == 102)
    mut independent := values.clone()
    independent[0].second = 99
    assert(values[0].second == 2 && independent[0].second == 99)
    independent.swap(0, 2)
    assert(independent[0].first == 20 && independent[2].second == 99)
    removed := independent.pop()
    assert(removed.first == 1 && removed.second == 99 && removed.third == 3)
    old := replace(&mut values[1], value(30))
    assert(total(&old) == 33 && total(&values[1]) == 93)
    independent.clear()
    independent.push(value(40))
    assert(total(&independent[0]) == 123)
    print("c layout aggregate arrays ok")
}
