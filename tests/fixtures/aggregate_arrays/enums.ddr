struct Queue { entries: []Entry }
struct Pair { first: i32, second: i32 }
enum Entry { Text(string), Numbers([]i32), Pair(Pair), Empty }
fn score(value: &Entry) -> i32 {
    match value {
        .Text(label) => label.len,
        .Numbers(numbers) => { mut total := 0; for number in numbers { total += number }; total },
        .Pair(pair) => pair.first + pair.second,
        .Empty => 0,
    }
}
fn main() {
    inferred := [Entry.Text("ok"), Entry.Empty]
    assert(inferred.len == 2 && score(&inferred[0]) == 2)
    mut queue := Queue { entries: [.Text("ok"), .Empty, .Pair(Pair { first: 1, second: 2 }), .Numbers([20, 22])] }
    mut total := 0
    for entry in &queue.entries { total += score(entry) }
    assert(total == 47)
    mut copied := queue.entries.clone()
    popped := copied.pop()
    match move popped {
        .Numbers(numbers) => { mut changed := numbers; changed[0] = 99; assert(changed[1] == 22) },
        _ => { assert(false) },
    }
    assert(score(&queue.entries[3]) == 42)
    copied.clear()
    assert(copied.len == 0 && queue.entries.len == 4)
    mut consumed := 0
    for entry in move queue.entries {
        match move entry {
            .Text(label) => { consumed += label.len },
            .Numbers(numbers) => { for number in move numbers { consumed += number } },
            .Pair(pair) => { consumed += pair.first + pair.second },
            .Empty => {},
        }
    }
    assert(consumed == 47)
    print("enum aggregate arrays ok")
}
