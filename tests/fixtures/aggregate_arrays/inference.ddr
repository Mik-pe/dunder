fn wide() -> i64 { 2147483648 }
fn tagged(trace: &mut []i32, id: i32) -> u16 { trace.push(id); u16(id) }
fn outcome(fail: bool) -> Result<u16, i32> {
    if fail { .Err(7) } else { .Ok(4) }
}
fn after_result(fail: bool) -> Result<u16, i32> {
    values := [1, (2), outcome(fail)?, 3]
    .Ok(values[0] + values[1] + values[2] + values[3])
}

struct Packet { len: i32 }
impl Packet { fn len(&self) -> i32 { self.len + 1 } }
fn local_length(len: i32) {
    packet := Packet { len: len }
    values := [0; 2]
    assert(packet.len == len && packet.len() == len + 1 && values.len == len)
}
fn len_bytes() -> i32 { len("ab") }

fn main() {
    narrow := [0, 1, (-1),]
    assert(narrow[2] == i32(-1))
    boundary := [2147483647, -2147483648]
    assert(boundary[1] == i32(-2147483648))
    literals := [0, (-2147483649), 0x8000_0000]
    assert(literals[0] == i64(0) && literals[1] == i64(-2147483649) && literals[2] == i64(2147483648))
    repeated := [0x8000_0000; 2]
    assert(repeated[1] == i64(2147483648))
    anchored := [1, wide(), 3]
    assert(anchored[0] == i64(1) && anchored[1] == i64(2147483648) && anchored[2] == i64(3))
    bytes := [0, 0xff, b'A', 0b10]
    assert(bytes[0] == u8(0) && bytes[1] == u8(255) && bytes[2] == b'A' && bytes[3] == u8(2))
    maximum := [18446744073709551615, u64(1), 0]
    assert(maximum[0] == u64(18446744073709551615) && maximum[2] == u64(0))
    specified: []u32 = [0, 2147483648, 4294967295]
    assert(specified[2] == u32(4294967295))
    decimal := [1, -2, f32(3.5), 4]
    assert(decimal[0] == f32(1) && decimal[1] == f32(-2) && decimal[3] == f32(4))
    mut trace: []i32 = []
    ordered := [1, tagged(&mut trace, 2), 3, tagged(&mut trace, 4), 5]
    assert(ordered[0] == u16(1) && ordered[1] == u16(2) && ordered[2] == u16(3) && ordered[3] == u16(4) && ordered[4] == u16(5))
    assert(trace.len == 2 && trace[0] == 2 && trace[1] == 4)
    match after_result(true) {
        .Ok(value) => { assert(false) },
        .Err(code) => { assert(code == 7) },
    }
    match after_result(false) {
        .Ok(value) => { assert(value == 10) },
        .Err(code) => { assert(false) },
    }
    local_length(2)
    assert(len_bytes() == 2)

    mut strings: []string = []
    original := "label-" + 42.str()
    strings.push(original.clone())
    assert(original == strings[0])
    strings.push(move original)
    strings.push("fresh-" + 7.str())
    assert(strings[1] == "label-42" && strings[2] == "fresh-7")
    print("integer array inference, length names and string owners ok")
}
