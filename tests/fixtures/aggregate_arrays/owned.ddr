struct Item { label: string, words: [string; 2], numbers: []i32 }
fn item(number: i32) -> Item {
    Item { label: "item-" + number.str(), words: ["left-" + number.str(), "right"], numbers: [number, 22] }
}
fn total(values: &[]Item) -> i32 {
    mut result := 0
    for value in values { result += value.numbers[0] + value.numbers[1] }
    result
}
fn main() {
    mut original: []Item = [item(20), item(1)]
    mut copied := original.clone()
    copied[0].label = "changed"
    copied[0].words[0] = "changed word"
    copied[0].numbers[0] = 99
    assert(original[0].label == "item-20" && original[0].words[0] == "left-20")
    assert(original[0].numbers[0] == 20 && copied[0].numbers[0] == 99)
    copied.reserve(40)
    copied.push(item(7))
    popped := copied.pop()
    assert(popped.label == "item-7" && popped.numbers[0] == 7)
    removed := copied.remove(0)
    assert(removed.label == "changed" && removed.numbers[0] == 99 && copied[0].label == "item-1")
    copied.clear()
    assert(copied.len == 0 && total(&original) == 65)
    seed := item(20)
    mut repeated: [Item; 2] = [seed; 2]
    repeated[0].words[1] = "first only"
    repeated[0].numbers[0] = 3
    assert(repeated[1].words[1] == "right" && repeated[1].numbers[0] == 20)
    assert(repeated[0].label == "item-20" && repeated[1].label == "item-20")
    for turn in 0..64 {
        clone := original.clone()
        assert(total(&clone) == 65)
    }
    mut consumed := 0
    for value in move original { consumed += value.numbers[0] + value.numbers[1] }
    assert(consumed == 65)
    print("owned aggregate arrays ok")
}
