struct Pod { left: i32, right: i64, tag: u8 }
fn sum(value: &Pod) -> i64 { i64(value.left) + value.right + i64(value.tag) }
fn fresh(number: i32) -> Pod { Pod { left: number, right: i64(number) * 2, tag: u8(number) } }
fn main() {
    mut values: []Pod = [fresh(1), fresh(2)]
    values.reserve(65)
    for i in 3..18 { values.push(fresh(i)) }
    assert(values.len == 17 && values.cap() >= 65)
    mut total: i64 = 0
    for item in &values { total += sum(item) }
    assert(total == 612)
    assert(sum(&values[16]) == 68)
    mut copy := values.clone()
    copy[0].left = 99
    assert(values[0].left == 1 && copy[0].left == 99)
    copy.swap(0, 16)
    assert(copy[0].left == 17 && copy[16].left == 99)
    tail := copy.pop()
    assert(tail.left == 99 && copy.len == 16)
    copy.clear()
    assert(copy.len == 0 && values.len == 17)
    copy.push(Pod { left: 20, right: 20, tag: 2 })
    assert(sum(&copy[0]) == 42)
    mut iterated: i64 = 0
    for item in values.iter() { iterated += sum(item) }
    assert(iterated == 612)
    print("pod aggregate arrays ok")
}
