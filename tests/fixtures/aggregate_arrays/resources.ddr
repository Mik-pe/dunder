import std.array as array

@resource struct Handle { number: i32, buffer: []i32 }
enum Owned { Live(Handle), Empty }
fn consume(move handle: Handle) -> i32 { handle.number + handle.buffer[0] }
fn main() {
    mut handles: []Handle = [Handle { number: 10, buffer: [1] }]
    next := Handle { number: 20, buffer: [2] }
    handles.push(move next)
    last := handles.pop()
    assert(consume(move last) == 22)
    mut total := 0
    for handle in move handles { total += consume(move handle) }
    assert(total == 11)
    values: []Owned = [.Empty, .Live(Handle { number: 40, buffer: [2] })]
    for value in move values {
        match move value { .Empty => {}, .Live(handle) => { total += consume(move handle) }, }
    }
    assert(total == 53)
    mut left: []Handle = []
    right: []Handle = [Handle { number: 4, buffer: [8] }]
    array.append_move(&mut left, move right)
    moved := left.pop()
    assert(consume(move moved) == 12)
    print("resource aggregate arrays ok")
}
