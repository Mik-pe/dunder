import .tuple_source as number

@resource(dispose) struct Handle { id: i32 }
impl Handle { fn dispose(&self) { print(self.id) } }
struct Box { value: (i32, string), other: i32 }

fn produce(id: i32) -> (string, Handle, i32) {
    (f"id {id}", Handle { id: id }, 11)
}
fn count(pair: (i32, string)) -> i32 { pair.0 + pair.1.len }
fn nested() -> ((i32, i32), bool) { ((4, 5), true) }
fn fail() -> Result<i32, bool> { .Err(true) }
fn abort() -> Result<(Handle, i32), bool> {
    .Ok((Handle { id: 8 }, fail()?))
}
fn from_result() -> Result<i32, i32> {
    pair: (i32, string) = (Result<(i32, string), i32>.Ok((40, "ok"))?)
    (n, word) := pair
    .Ok(n + word.len)
}
fn release_moved_value() {
    (name, handle, id) := produce(9)
    assert(name == "id 9" && handle.id == 9 && id == 11)
    print(19)
}

fn main() {
    (number, text) := number.read(40)
    assert(number == 42 && text == "value 40")
    box := Box { value: (41, "s"), other: 1 }
    assert(box.value.0 == 41 && count(box.value) == 42 && box.other == 1)
    assert(count((41, "s")) == 42)
    local: (u16, bool) = (42, true)
    mut (count, flag) := local
    count += 1
    assert(count == u16(43) && flag && local.0 == 42)
    pair := nested()
    (inner, yes,) := pair
    assert(inner.1 == 5 && yes && pair.0.1 == 5)
    call := fn []() -> (u8, bool) { (15, false) }
    (small, status) := call()
    assert(small == u8(15) && !status)

    (label, _, _) := produce(7)
    assert(label == "id 7")
    print(17)
    match abort() {
        .Ok(_) => { assert(false) },
        .Err(reason) => { assert(reason) },
    }
    print(18)
    release_moved_value()
    match from_result() {
        .Ok(total) => { assert(total == 42) },
        .Err(_) => { assert(false) },
    }

    mut pairs: Map<i32, (i32, string)> = Map<i32, (i32, string)>::new()
    pairs.put(1, (2, "map"))
    assert(pairs.at(1).0 == 2 && pairs.at(1).1 == "map")
    mut list: [](i32, string) = [(0, "array")]
    (zero, word) := list.pop()
    assert(zero == 0 && word == "array")
    print("tuple returns ok")
}
