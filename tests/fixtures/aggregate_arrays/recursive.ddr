struct Node { number: i32, label: string, children: []Node }
fn sum(node: &Node) -> i32 {
    mut result := node.number
    for child in &node.children { result += sum(child) }
    result
}
fn consume(move node: Node) -> i32 {
    mut result := node.number
    for child in move node.children { result += consume(move child) }
    result
}
fn main() {
    root := Node { number: 1, label: "root", children: [
        Node { number: 20, label: "left", children: [Node { number: 2, label: "leaf", children: [] }] },
        Node { number: 19, label: "right", children: [] },
    ] }
    assert(sum(&root) == 42)
    mut cloned := root.clone()
    cloned.children[0].number = 30
    cloned.children[0].children[0].label = "independent"
    assert(sum(&cloned) == 52 && sum(&root) == 42)
    assert(root.children[0].children[0].label == "leaf")
    forest: []Node = [root, Node { number: 7, label: "other", children: [] }]
    mut forest_copy := forest.clone()
    forest_copy[0].children[1].number = 99
    assert(sum(&forest[0]) == 42 && sum(&forest_copy[0]) == 122)
    mut total := 0
    for node in move forest { total += consume(move node) }
    assert(total == 49)
    print("recursive aggregate arrays ok")
}
