struct Pod { left: i32, right: i32, score: i64 }
@repr(C) struct CRecord { first: i32, second: i32, third: i32 }
fn pod_sum(value: &Pod) -> i64 { i64(value.left + value.right) + value.score }
fn edit(value: &mut Pod) { value.left += 1; value.score += 10 }
fn c_sum(value: &CRecord) -> i32 { value.first + value.second + value.third }
fn c_edit(value: &mut CRecord) { value.second += 1 }
fn main() {
    mut owned: []Pod = [Pod { left: 1, right: 2, score: 3 }]
    mut c_owned: []CRecord = [CRecord { first: 1, second: 2, third: 3 }]
    region arena(512) {
        mut values: []Pod = arena.alloc(2)
        values[0] = Pod { left: 20, right: 2, score: 10 }
        values[1] = owned[0]
        assert(pod_sum(&values[0]) == 32 && pod_sum(&values[1]) == 6)
        edit(&mut values[0])
        assert(values[0].left == 21 && values[0].score == 20)
        owned.push(values[0])
        mut c_values: []CRecord = arena.alloc(2)
        c_values[0] = CRecord { first: 10, second: 20, third: 30 }
        c_values[1] = c_owned[0]
        assert(c_sum(&c_values[0]) == 60 && c_sum(&c_values[1]) == 6)
        c_edit(&mut c_values[0])
        assert(c_values[0].second == 21)
        c_owned.push(c_values[0])
    }
    assert(pod_sum(&owned[1]) == 43 && c_sum(&c_owned[1]) == 61)
    assert(pod_sum(&owned[0]) == 6 && c_sum(&c_owned[0]) == 6)
    print("scratch aggregate compatibility ok")
}
