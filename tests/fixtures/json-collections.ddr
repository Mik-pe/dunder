import std.json

@derive(Decode(deny_duplicate_fields))
struct Strict { width: u16 }

@derive(Decode)
struct Compatible { width: u16 }

@derive(Encode, Decode)
struct Labels { value: [string; 2] }

@resource struct Positive { value: i32 }

impl json.Decode for Positive {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self, json.JsonError> {
        value := json.decode<i32>(&doc, node)?
        if value <= 0 { return .Err(json.JsonError::new("expected a positive value", doc.node_offset(node))) }
        .Ok(Self { value })
    }
}

impl json.Encode for Positive {
    fn encode_json(&self, writer: &mut json.Writer) {
        if self.value <= 0 { writer.fail("expected a positive value"); return }
        writer.integer(i64(self.value))
    }
}

fn main() {
    for raw in ["{\"width\":4,\"width\":9}", "{\"width\":4,\"w\\u0069dth\":9}"] {
        error := json.from_str<Strict>(raw).unwrap_err()
        assert(error.offset == 11 && error.message == "duplicate field 'width'")
        assert(json.from_str<Compatible>(raw).unwrap().width == 9)
    }
    assert(json.from_str<Strict>("{\"extra\":1,\"width\":4,\"extra\":2}").unwrap().width == 4)
    owned := json.from_str<[Positive; 2]>("[3,5]").unwrap()
    assert(owned[1].value == 5 && json.to_string(&owned).unwrap() == "[3,5]")
    assert(json.from_str<[Positive; 2]>("[3,0]").is_err())
    values: []Positive = [Positive { value: 1 }, Positive { value: 0 }]
    mut writer := json.Writer::new()
    json.encode(&mut writer, &values)
    writer.fail("later error")
    assert(writer.finish().unwrap_err().message == "expected a positive value")
    assert(writer.finish_bytes().unwrap_err().message == "expected a positive value")

    mut empty_error := json.Writer::new()
    empty_error.fail("")
    empty_error.fail("second")
    assert(empty_error.finish().unwrap_err().message == "")

    literal: [i32; 3] = [7,11,13]
    mut direct := json.Writer::new()
    literal.encode_json(&mut direct)
    assert(direct.finish().unwrap() == "[7,11,13]")
    numbers := json.from_str<[u16; 2]>("[12,24]").unwrap()
    assert(numbers[0] == 12 && numbers[1] == 24)
    assert(json.to_string(&numbers).unwrap() == "[12,24]")
    assert(json.from_str<[u16; 2]>("[12]").is_err())
    assert(json.from_str<[u16; 2]>("[12,24,36]").is_err())
    assert(json.from_str<[u16; 2]>("[12,65536]").is_err())
    empty := json.from_str<[u16; 0]>("[]").unwrap()
    assert(json.to_string(&empty).unwrap() == "[]")
    single := json.from_str<[u16; 1]>("[65535]").unwrap()
    assert(single[0] == 65535 && json.to_string(&single).unwrap() == "[65535]")
    nested := json.from_str<[[u8; 3]; 2]>("[[1,2,3],[4,5,6]]").unwrap()
    assert(nested[1][2] == 6)
    assert(json.to_string(&nested).unwrap() == "[[1,2,3],[4,5,6]]")
    labels := json.from_str<Labels>("{\"value\":[\"å\",\"茶\"]}").unwrap()
    assert(labels.value[1] == "茶")
    assert(json.to_string(&labels).unwrap() == "{\"value\":[\"å\",\"茶\"]}")

    pair := json.from_str<(u16, u16)>("[20,4]").unwrap()
    assert(pair == (u16(20), u16(4)) && json.to_string(&pair).unwrap() == "[20,4]")
    assert(json.from_str<(u16, u16)>("[20,65536]").is_err())
    tuples := json.from_str<[](i32, i32)>("[[3,5],[4,5]]").unwrap()
    assert(tuples[0] == (3,5) && tuples[1] == (4,5))
    assert(json.to_string(&tuples).unwrap() == "[[3,5],[4,5]]")
    assert(json.from_str<[](i32, i32)>("[[3,5],[4]]").is_err())

    doc := json.Doc::parse("{\"a\":[3,5],\"\\u0061\":9}").unwrap()
    mut members := doc.members(doc.root)
    first := members.next().unwrap()
    second := members.next().unwrap()
    assert(first.0 == "a" && second.0 == "a" && doc.as_i64(second.1).unwrap() == 9)
    assert(members.next().is_none() && members.next().is_none())
    mut children := doc.children(first.1)
    assert(doc.as_i64(children.next().unwrap()).unwrap() == 3)
    assert(doc.as_i64(children.next().unwrap()).unwrap() == 5)
    assert(children.next().is_none() && children.next().is_none())
    mut wrong := doc.children(doc.root)
    mut invalid := doc.members(-1)
    assert(wrong.next().is_none() && invalid.next().is_none())
}
