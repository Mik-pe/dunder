import sys
import std.time

fn check(timestamp: i64, offset_hours: i32) {
    local := time.local_from_unix(timestamp).unwrap()
    expected := time.utc_from_unix(timestamp + i64(offset_hours) * 3600)
    assert(local.year == expected.year && local.month == expected.month && local.day == expected.day)
    assert(local.hour == expected.hour && local.minute == expected.minute && local.second == expected.second)
    assert(local.weekday == expected.weekday)
}

fn main() {
    assert(sys.arg_count() == 2)
    zone := sys.arg(1)
    assert(zone == "UTC" || zone == "Europe/Stockholm" || zone == "America/New_York")
    cases: [](i64, i32, i32) = [
        (-315619200, 1, -5),
        (1142146800, 1, -5), (1143961199, 2, -5), (1143961200, 2, -4),
        (1173596399, 1, -5), (1173596400, 1, -4),
        (1704063599, 1, -5), (1704063600, 1, -5), (1704085199, 1, -5), (1704085200, 1, -5),
        (1710053999, 1, -5), (1710054000, 1, -4), (1711846799, 1, -4), (1711846800, 2, -4),
        (1729990799, 2, -4), (1729990800, 1, -4), (1730613599, 1, -4), (1730613600, 1, -5),
    ]
    for (timestamp, stockholm, new_york) in &cases {
        offset := if zone == "Europe/Stockholm" { stockholm } else if zone == "America/New_York" { new_york } else { 0 }
        check(timestamp, offset)
    }
    if target_is("windows") {
        assert(time.local_from_unix(-11644473601).is_none())
        assert(time.local_from_unix(910692730086).is_none())
        if zone == "UTC" { check(-11644473600, 0); check(910670515199, 0) }
    }
}
