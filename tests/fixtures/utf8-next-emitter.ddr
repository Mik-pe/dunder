// Private ABI probe: each step receives a live valid snapshot and an oracle
// byte boundary. The Python driver supplies independent scalar/offset pairs.
import ...selfhost.arm64 as arm
import ...selfhost.runtime
import ...selfhost.lexer
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn integer(at: i32) -> i32 { value := decimal.integer(sys.arg(at)); assert(value.ok); i32(value.value) }
fn address(code: &mut arm.Code, slot: i32) { arm.imm(&mut code, 0, i64(slot + 1) * 8); arm.emit(&mut code, 3405775776) }
fn load(code: &mut arm.Code, to: i32, base: i32, offset: i32) { arm.emit(&mut code, 4181721088 + i64(offset / 8) * 1024 + i64(base * 32 + to)) }
fn compare(code: &mut arm.Code, left: i32, right: i32, failed: i32) {
    arm.emit(&mut code, 3942645791 + i64(right) * 65536 + i64(left) * 32); arm.branch(&mut code, failed, 3)
}
fn data(code: &mut arm.Code, text: string) {
    arm.emit(&mut code, i64(text.len)); arm.emit(&mut code, 0)
    var word: i64 = 0; var count := 0
    for byte in text.bytes() {
        word = word.bit_or(i64(byte).shl(count * 8)); count = count + 1
        if count == 4 { arm.emit(&mut code, word); word = 0; count = 0 }
    }
    if count != 0 { arm.emit(&mut code, word) }
}
fn main() {
    platform := integer(2); mode := sys.arg(3); source_kind := sys.arg(6)
    text := sys.read_text(sys.arg(4)); oracle := sys.read_text(sys.arg(5)); assert(text.ok && oracle.ok)
    tokens := lexer.scan(oracle.value, false); var expected: []i64 = []
    for i in 0..tokens.kinds.len {
        if tokens.kinds[i] == .Integer { parsed := decimal.integer(tokens.texts[i]); assert(parsed.ok); expected.push(parsed.value) }
    }
    assert(expected.len % 2 == 0)
    var probe := arm.new_for(platform); epoch := arm.begin_effects(&mut probe)
    runtime.emit_utf8_next(&mut probe)
    assert(arm.end_effects(&mut probe, epoch) && probe.words.len == runtime.utf8_next_word_estimate())
    for word in probe.words { assert(word != 3596551104) }
    for kind in probe.kinds { assert(kind != 1 && kind != 20) }
    var checking := arm.new_check(platform); runtime.emit_utf8_next(&mut checking)
    assert(checking.words.len == 0 && arm.position(&checking) == probe.words.len && arm.label_count(&checking) == probe.labels.len)

    var code := arm.new_for(platform); code.profile = platform != 3 && sys.arg(7) == "profile"
    rt := runtime.new(&mut code)
    entry := arm.label(&mut code); failed := arm.label(&mut code); literal := arm.label(&mut code)
    if platform != 3 {
        arm.imm(&mut code, 19, 0); arm.imm(&mut code, 20, 0)
        if platform == 0 { arm.mov(&mut code, 23, 0); arm.mov(&mut code, 24, 1) }
        else { arm.emit(&mut code, 4181722103); arm.emit(&mut code, 2432705528) }
    }
    runtime.emit_profile_start(&mut code, &rt)
    arm.branch(&mut code, entry, 1); runtime.emit_profile_report(&mut code, &rt)
    arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 48)
    arm.store(&mut code, 32, 31)
    if source_kind == "argv" {
        assert(platform != 3); arm.imm(&mut code, 0, 1); arm.branch(&mut code, rt.sys_arg, 1)
    } else {
        arm.branch(&mut code, literal, 20)
        if source_kind == "slice" {
            arm.imm(&mut code, 1, 2); arm.imm(&mut code, 2, i64(text.value.len) + 2); arm.branch(&mut code, rt.string_slice, 1)
        } else if source_kind == "decoded" {
            arm.emit(&mut code, 2432704512); arm.store(&mut code, 43, 0)
            arm.imm(&mut code, 0, i64(text.value.len)); arm.store(&mut code, 42, 0); arm.store(&mut code, 41, 0); arm.store(&mut code, 40, 31)
            address(&mut code, 43); arm.branch(&mut code, rt.sys_decode_utf8, 1); arm.store(&mut code, 32, 0)
            load(&mut code, 1, 0, 0); arm.imm(&mut code, 0, 1); compare(&mut code, 0, 1, failed)
            arm.load(&mut code, 32); load(&mut code, 0, 0, 8)
        } else { assert(source_kind == "literal") }
    }
    arm.store(&mut code, 33, 0); arm.store(&mut code, 1, 31)
    // Save every preserved GPR, including FP and platform/runtime globals.
    // All save/check slots are direct, so verification itself preserves x9.
    for reg in 2..30 { if reg < 10 || reg > 12 { arm.store(&mut code, reg, reg) } }
    if mode == "inline" { arm.store(&mut code, 30, 30) } else { assert(mode == "leaf") }
    for item in 0..expected.len / 2 {
        arm.load(&mut code, 1); arm.mov(&mut code, 1, 0); arm.load(&mut code, 33)
        if mode == "inline" { runtime.emit_utf8_next(&mut code) } else { arm.branch(&mut code, rt.string_next, 1) }
        arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 1)
        for reg in 2..30 {
            if reg < 10 || reg > 12 { arm.load(&mut code, reg); compare(&mut code, reg, 0, failed) }
        }
        if mode == "inline" { arm.load(&mut code, 30); compare(&mut code, 30, 0, failed) }
        arm.load(&mut code, 0); arm.imm(&mut code, 1, expected[item * 2]); compare(&mut code, 0, 1, failed)
        arm.load(&mut code, 1); arm.imm(&mut code, 1, expected[item * 2 + 1]); compare(&mut code, 0, 1, failed)
    }
    if source_kind != "literal" { arm.load(&mut code, 33); arm.branch(&mut code, rt.release, 1) }
    if source_kind == "decoded" { arm.load(&mut code, 32); arm.branch(&mut code, rt.release, 1) }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    arm.mark(&mut code, failed); arm.exit(&mut code, 104)
    runtime.emit_runtime(&mut code, &rt)
    // The old leaf is exactly the shared fallthrough vocabulary plus RET;
    // also compare normalized symbolic control-flow records, not just zeros.
    leaf := code.labels[rt.string_next]
    assert(code.labels[rt.string_bytes] == leaf + probe.words.len + 1)
    for at in 0..probe.words.len { assert(code.words[leaf + at] == probe.words[at]) }
    assert(code.words[leaf + probe.words.len] == 3596551104)
    for r in 0..probe.at.len {
        var found := false
        for s in 0..code.at.len {
            if code.at[s] == leaf + probe.at[r] {
                assert(!found && code.kinds[s] == probe.kinds[r])
                assert(code.labels[code.target[s]] - leaf == probe.labels[probe.target[r]]); found = true
            }
        }
        assert(found)
    }
    end := code.words.len; arm.mark(&mut code, literal)
    if source_kind == "slice" { data(&mut code, "π" + text.value + "β") } else { data(&mut code, text.value) }
    runtime.emit_profile_data(&mut code, &rt)
    var image: []u8 = []; none: []i32 = []
    if platform == 3 {
        abi := wa.new(); result := wasm.image(&code, end, entry, 1, &abi); assert(result.ok); image = result.text
    } else if platform == 2 {
        result := x86.finish(&code, end, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62)
    } else {
        text := arm.finish(&mut code)
        if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) }
    }
    saved := sys.write_u8(sys.arg(1), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(1)); assert(executable.ok)
}
