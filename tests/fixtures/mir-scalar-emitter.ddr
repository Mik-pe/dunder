// Inactive scalar foundation execution fixture: directly preflight and emit
// canonical operations, then let every real image backend consume the stream.
// Expected full-width result and all14 NZCV conditions come from Python's
// independent integer oracle; the emitter does not compute expected results.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_scalar_lower as scalar
import ...selfhost.mir_scalar_contract as contract
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn number(at: i32) -> i64 { result := decimal.integer(sys.arg(at)); assert(result.ok); result.value }
fn cmp(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(a) * 32 + i64(b) * 65536) }
fn main() {
    target := i32(number(2)); var f := mir.new(); op := mir.add(&mut f, i32(number(3)))
    f.opcodes[op] = i32(number(4)); f.types[op] = i32(number(5)); f.dst[op] = i32(number(6))
    f.a[op] = i32(number(7)); f.b[op] = i32(number(8)); f.c[op] = i32(number(9))
    f.imm[op] = number(10); f.aux[op] = i32(number(11)); f.flags[op] = i32(number(12))
    f.effects[op] = contract.expected_effects(f.kinds[op], f.opcodes[op])
    f.reads[op] = mir.variable_bit(f.a[op]).bit_or(mir.variable_bit(f.b[op])).bit_or(mir.variable_bit(f.c[op]))
    f.writes[op] = mir.variable_bit(f.dst[op]); assert(scalar.can_emit(&f, op))
    var code := arm.new_for(target); entry := arm.label(&mut code); failed := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.exit(&mut code, 0); arm.mark(&mut code, entry)
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    arm.imm(&mut code, 1, number(13)); arm.imm(&mut code, 2, number(14)); arm.imm(&mut code, 3, number(15))
    arm.imm(&mut code, 4, 1084818905618843912)
    if f.kinds[op] == 6 {
        var base: i64 = 1795162143; if f.types[op] == 2 { base = 3942645791 }
        arm.emit(&mut code, base + 1 * 32 + 2 * 65536)
    }
    assert(scalar.emit(&mut code, &f, op))
    if f.flags[op] == 2 {
        arm.imm(&mut code, 9, 0)
        var conditions := mir.new(); selected := mir.add(&mut conditions, 6)
        conditions.dst[selected] = 5; conditions.types[selected] = 2; conditions.flags[selected] = 1
        conditions.writes[selected] = mir.variable_bit(5)
        for condition in 0..14 {
            conditions.imm[selected] = i64(condition); assert(scalar.emit(&mut code, &conditions, selected))
            arm.emit(&mut code, 2332033024 + 5 * 65536 + i64(condition) * 1024 + 9 * 32 + 9)
        }
        arm.imm(&mut code, 6, number(17)); cmp(&mut code, 9, 6); arm.branch(&mut code, failed, 3)
    }
    if f.dst[op] >= 0 {
        arm.imm(&mut code, 6, number(16)); cmp(&mut code, f.dst[op], 6); arm.branch(&mut code, failed, 3)
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code); arm.mark(&mut code, failed); arm.exit(&mut code, 104)
    var image: []u8 = []; none: []i32 = []
    if target == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, entry, 1, &abi); assert(result.ok); image = result.text }
    else if target == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut code); if target == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
}
