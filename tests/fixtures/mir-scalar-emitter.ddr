capability filesystem
import ...selfhost.backend.arm64 as arm
import ...selfhost.mir.mir
import ...selfhost.mir.mir_scalar_lower as scalar
import ...selfhost.mir.mir_scalar_contract as contract
import ...selfhost.backend.macho
import ...selfhost.backend.elf
import ...selfhost.backend.x86
import ...selfhost.backend.wasm_native as wasm
import ...selfhost.backend.wasm_abi as wa
import std.parse as decimal
import std.text as text
import sys

fn parse_int(value: string) -> i64 { result := decimal.integer(value); assert(result.ok); result.value }
fn number(at: i32) -> i64 { parse_int(sys.arg(at)) }
fn cmp(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(a) * 32 + i64(b) * 65536) }

fn emit_case(code: &mut arm.Code, failed: i32, kind: i32, opcode: i32, ty: i32, dst: i32, a: i32, b: i32, c: i32,
             imm: i64, aux: i32, flags: i32, in0: i64, in1: i64, in2: i64, expected_val: i64, expected_cond: i64) {
    mut f := mir.new(); op := mir.add(&mut f, kind)
    f.opcodes[op] = opcode; f.types[op] = ty; f.dst[op] = dst
    f.a[op] = a; f.b[op] = b; f.c[op] = c
    f.imm[op] = imm; f.aux[op] = aux; f.flags[op] = flags
    f.effects[op] = contract.expected_effects(f.kinds[op], f.opcodes[op])
    f.reads[op] = mir.variable_bit(f.a[op]).bit_or(mir.variable_bit(f.b[op])).bit_or(mir.variable_bit(f.c[op]))
    f.writes[op] = mir.variable_bit(f.dst[op]); assert(scalar.can_emit(&f, op))
    arm.imm(&mut code, 1, in0); arm.imm(&mut code, 2, in1); arm.imm(&mut code, 3, in2)
    arm.imm(&mut code, 4, 1084818905618843912)
    if f.kinds[op] == 6 {
        mut base: i64 = 1795162143; if f.types[op] == 2 { base = 3942645791 }
        arm.emit(&mut code, base + 1 * 32 + 2 * 65536)
    }
    assert(scalar.emit(&mut code, &f, op))
    if f.flags[op] == 2 {
        arm.imm(&mut code, 9, 0)
        mut conditions := mir.new(); selected := mir.add(&mut conditions, 6)
        conditions.dst[selected] = 5; conditions.types[selected] = 2; conditions.flags[selected] = 1
        conditions.writes[selected] = mir.variable_bit(5)
        for condition in 0..14 {
            conditions.imm[selected] = i64(condition); assert(scalar.emit(&mut code, &conditions, selected))
            arm.emit(&mut code, 2332033024 + 5 * 65536 + i64(condition) * 1024 + 9 * 32 + 9)
        }
        arm.imm(&mut code, 6, expected_cond); cmp(&mut code, 9, 6); arm.branch(&mut code, failed, 3)
    }
    if f.dst[op] >= 0 {
        arm.imm(&mut code, 6, expected_val); cmp(&mut code, f.dst[op], 6); arm.branch(&mut code, failed, 3)
    }
}

fn main() {
    batch := sys.arg_count() >= 5 && sys.arg(1) == "--batch"
    out_path := if batch { sys.arg(2) } else { sys.arg(1) }
    target := if batch { i32(parse_int(sys.arg(3))) } else { i32(number(2)) }
    mut code := arm.new_for(target); entry := arm.label(&mut code); failed := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.exit(&mut code, 0); arm.mark(&mut code, entry)
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    if batch {
        content := sys.read_text(sys.arg(4))
        assert(content.ok)
        for line in move text.split(content.value, "\n") {
            if line.len == 0 { continue }
            cols := text.split(line, "\t")
            assert(cols.len == 15)
            emit_case(&mut code, failed, i32(parse_int(cols[0])), i32(parse_int(cols[1])), i32(parse_int(cols[2])),
                      i32(parse_int(cols[3])), i32(parse_int(cols[4])), i32(parse_int(cols[5])), i32(parse_int(cols[6])),
                      parse_int(cols[7]), i32(parse_int(cols[8])), i32(parse_int(cols[9])),
                      parse_int(cols[10]), parse_int(cols[11]), parse_int(cols[12]), parse_int(cols[13]), parse_int(cols[14]))
        }
    } else {
        emit_case(&mut code, failed, i32(number(3)), i32(number(4)), i32(number(5)), i32(number(6)),
                  i32(number(7)), i32(number(8)), i32(number(9)), number(10), i32(number(11)), i32(number(12)),
                  number(13), number(14), number(15), number(16), number(17))
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code); arm.mark(&mut code, failed); arm.exit(&mut code, 104)
    mut image: []u8 = []; none: []i32 = []
    if target == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, entry, 1, &abi); assert(result.ok); image = result.text }
    else if target == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut code); if target == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(out_path, &image).ok && sys.make_executable(out_path).ok)
}
