// Low-level target tests construct physical instructions explicitly. Source
// programs only enter the strict typed-operation reader in selfhost.
import ...selfhost.mir
import ...selfhost.typed_places as places
import ...selfhost.arm64 as arm
import ...selfhost.mir_lift as reader
import ...selfhost.mir_source as source
import ...selfhost.mir_operation as operation
import .mir_machine_decode as decode


pub fn new_work() -> reader.Workspace { reader.new_work() }
fn record(f: &mut mir.Function, words: &[]i64, row: i32, at: i32, width: i32) -> i32 {
    op := mir.add(&mut f, 0); f.origins[op] = at; f.raw_starts[op] = f.raw.len
    f.widths[op] = width; f.modes[op] = 0
    f.boundaries[at - f.first_word] = op
    for i in 0..width { f.raw.push(words[row + i]) }
    op
}
fn lift_rows(f: &mut mir.Function, work: &mut reader.Workspace, item: &source.TypedFunction,
    words: &[]i64, labels: &[]i32, relocs: &[]i32, targets: &[]i32, reloc_kinds: &[]i32,
    sites: &[]i32,
    target_words: &[]i32, batched: bool, arena: &places.Arena, l: i32, le: i32, n: i32, ne: i32) -> bool {
    if !places.valid(&arena, l, le, n, ne, &f.source_types) { return false }
    reader.begin(&mut f, &item)
    first_word := item.first_word; reloc_end := item.reloc_row + item.reloc_count; import_end := item.import_row + item.import_count
    mut r := item.reloc_row; mut imported := item.import_row; mut at := first_word
    while at < f.source_words {
        row := item.word_row + (at - first_word)
        if r < reloc_end && relocs[r] < at { return false }
        if imported < import_end && (sites[imported] < 0 || sites[imported] % 4 != 0 || sites[imported] / 4 < at) { return false }
        mut kind := -1; mut target := -1; mut foreign := -1
        if r < reloc_end && relocs[r] == at {
            kind = reloc_kinds[r]; target = targets[r]; r = r + 1
            if kind < 0 || kind > 20 || target < 0 || target >= f.source_labels { return false }
        }
        if imported < import_end && sites[imported] / 4 == at {
            if kind >= 0 { return false }
            foreign = item.first_import + (imported - item.import_row); imported = imported + 1
        }
        if words[row] > 4294967295 {
            at = reader.append_typed(&mut f, &mut work, &words, row, at, target, kind, foreign, &arena, l, le, n, ne)
        } else {
            if words[row] < 0 { return false }
            mut width := 1; mut recipe := 0
            if kind >= 0 {
                if !operation.symbolic(&mut work.decoded, kind) || words[row] != 0 { return false }
                recipe = 4; if kind >= 2 { width = 2 }
                if width == 2 && (at >= f.source_words - 1 || words[row + 1] != 3573751839) { return false }
            } else if foreign >= 0 {
                recipe = 5; width = 2
                if at >= f.source_words - 1 || words[row + 1] != 0 || !operation.imported(&mut work.decoded, words[row]) { return false }
            } else { decode.word(&mut work.decoded, words[row], item.platform) }
            op := record(&mut f, &words, row, at, width); f.recipes[op] = recipe
            f.targets[op] = target; f.reloc_kinds[op] = kind; f.import_ids[op] = foreign
            operation.append_into(&work.decoded, &mut f, op)
            capture(&mut f, f.raw_starts[op], width, recipe, kind, f.platform, &work.decoded)
            at = at + width
        }
        if at < 0 { return false }
    }
    if r != reloc_end || imported != import_end { return false }
    return reader.finish(&mut f, &item, &labels, &targets, &target_words, batched)
}

pub fn build_into(f: &mut mir.Function, work: &mut reader.Workspace, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    arena := places.new()
    mir.reset(&mut f)
    if !source.valid_start(&code, first_word, first_label, first_reloc, &sites, first_import) { return false }
    item := source.rows(code.platform, first_word, first_label, first_reloc, first_import,
        code.words.len, code.labels.len, code.at.len, sites.len)
    return lift_rows(&mut f, &mut work, &item, &code.words, &code.labels, &code.at, &code.target, &code.kinds,
        &sites, &code.labels, false, &arena, 0, arena.locals.len, 0, arena.nodes.len)
}
fn fits(row: i32, count: i32, length: i32) -> bool {
    row >= 0 && count >= 0 && row <= length && count <= length - row
}
// A worker owns the decoded MIR columns. It reads a single logical item
// directly from its immutable snapshot, even when adjacent items share arrays.
pub fn lift_item(f: &mut mir.Function, work: &mut reader.Workspace, batch: &source.Batch, index: i32) -> i32 {
    mir.reset(&mut f)
    if index < 0 || index >= source.count(&batch) { return 10 }
    if batch.type_ends.len > 0 {
        if batch.type_ends.len != source.count(&batch) { return 10 }
        mut first := 0; if index > 0 { first = batch.type_ends[index - 1] }
        end := batch.type_ends[index]
        if first < 0 || end > batch.types.len || end < first || end - first < 2 { return 10 }
        for row in first..end { f.source_types.push(batch.types[row]) }
    }
    item := source.item_at(&batch, index)
    if batch.at.len != batch.targets.len || batch.at.len != batch.kinds.len || batch.at.len != batch.target_words.len { return 10 }
    if !fits(item.word_row, item.word_count, batch.words.len) || !fits(item.label_row, item.label_count, batch.labels.len) ||
        !fits(item.reloc_row, item.reloc_count, batch.at.len) || !fits(item.import_row, item.import_count, batch.sites.len) { return 10 }
    if !fits(item.first_word, item.word_count, 2147483647) || item.word_count == 2147483647 ||
        !fits(item.first_label, item.label_count, 2147483647) || !fits(item.first_reloc, item.reloc_count, 2147483647) ||
        !fits(item.first_import, item.import_count, 2147483647) { return 10 }
    if batch.local_ends.len != source.count(&batch) || batch.node_ends.len != source.count(&batch) { return 10 }
    mut l := 0; mut n := 0
    if index > 0 { l = batch.local_ends[index-1]; n = batch.node_ends[index-1] }
    if !lift_rows(&mut f, &mut work, &item, &batch.words, &batch.labels, &batch.at, &batch.targets, &batch.kinds,
        &batch.sites, &batch.target_words, true, &batch.places, l, batch.local_ends[index], n, batch.node_ends[index]) { return 10 }
    if item.entry < 0 || item.entry >= f.source_labels || item.entry_word != f.first_word || !reader.insert_entry(&mut f, item.entry) { return 11 }
    return 0
}
pub fn lift(f: &mut mir.Function, code: &arm.Code, first_word: i32, first_label: i32,
    first_reloc: i32, sites: &[]i32, first_import: i32) -> bool {
    mut work := new_work()
    build_into(&mut f, &mut work, &code, first_word, first_label, first_reloc, &sites, first_import)
}
pub fn own_entry(f: &mut mir.Function, code: &arm.Code, entry: i32) -> bool { reader.own_entry(&mut f, &code, entry) }
fn capture(f: &mut mir.Function, first: i32, width: i32, recipe: i32, reloc: i32, platform: i32, d: &operation.Decoded) {
    assert(f.encoded.len == first * 27)
    f.encoded.push(f.raw[first]); mut second: i64 = 0; if width == 2 { second = f.raw[first + 1] }; f.encoded.push(second)
    f.encoded.push(i64(width)); f.encoded.push(i64(recipe)); f.encoded.push(i64(reloc)); f.encoded.push(i64(platform))
    f.encoded.push(i64(d.kind)); f.encoded.push(i64(d.opcode)); f.encoded.push(i64(d.dst)); f.encoded.push(i64(d.a))
    f.encoded.push(i64(d.b)); f.encoded.push(i64(d.c)); f.encoded.push(d.imm); f.encoded.push(i64(d.aux))
    f.encoded.push(d.variant); f.encoded.push(i64(d.types)); f.encoded.push(i64(d.extension)); f.encoded.push(i64(d.stack_role))
    f.encoded.push(i64(d.effects)); f.encoded.push(i64(d.flags)); f.encoded.push(i64(d.abi)); f.encoded.push(d.reads)
    f.encoded.push(d.writes); f.encoded.push(d.clobbers); f.encoded.push(i64(d.place_kind)); f.encoded.push(i64(d.place_offset))
    f.encoded.push(i64(d.place_width))
    if width == 2 { for i in 0..27 { f.encoded.push(0) } }
}
