pub struct Offset { value: i32 }

impl Offset {
    pub fn adder(&self) -> Fn(i32) -> i32 {
        fn[self: Self](n: i32) -> i32 { self.value + n }
    }

    pub fn factory() -> fn(i32) -> Self {
        fn(value: i32) -> Self { Self { value: value } }
    }
}

pub fn plus(base: i32) -> Fn(i32) -> i32 {
    fn[base: i32](x: i32) -> i32 { x + base }
}

pub fn with_record(offset: Offset) -> Fn(i32) -> i32 {
    saved := offset.clone()
    fn[saved: Offset](x: i32) -> i32 { x + saved.value }
}

pub fn compose(f: Fn(i32) -> i32, g: Fn(i32) -> i32) -> Fn(i32) -> i32 {
    fn[f: Fn(i32) -> i32, g: Fn(i32) -> i32](x: i32) -> i32 { f(g(x)) }
}
