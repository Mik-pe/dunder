@resource(dispose)
struct Handle { id: i32 }
impl Handle {
    fn dispose(&self) { print(self.id) }
}

struct Refused { handle: Handle, code: i32 }
struct Entry { number: i32, nested: Result<Result<(), i32>, string>, marker: i32 }

fn transfer(move handle: Handle, accepted: bool) -> Result<i32, Refused> {
    if accepted { return .Ok(handle.id) }
    .Err(Refused { handle: handle, code: 17 })
}

fn convert(move handle: Handle, accepted: bool) -> Result<string, Refused> {
    defer { print(50) }
    .Ok(transfer(move handle, accepted)?.str())
}

fn check(flag: bool) -> Result<(), ()> {
    if flag { return .Ok }
    .Err
}

fn pass_unit(flag: bool) -> Result<i32, ()> {
    check(flag)?
    .Ok(42)
}

fn copied() -> Result<i32, i64> {
    value := Result<i32, i64>.Ok(20)
    number := value?
    match value {
        .Ok(other) => { return .Ok(other + number) },
        .Err(_) => { assert(false); return .Err(0) },
    }
}

fn identity(move handle: Handle) -> Result<Handle, i32> { .Ok(handle) }
fn relay() -> Result<Handle, i32> {
    local := identity(Handle { id: 52 })
    .Ok(local?)
}

fn make(move handle: Handle, value: i32) -> string { "unreachable" }
fn pending_argument() -> Result<string, ()> {
    .Ok(make(Handle { id: 53 }, pass_unit(false)?))
}

fn nominal_identity(
    move value: Result<[i32; 0x4], i64>
) -> Result<[i32; 4], i64> { value }

fn plus_one(move n: i32) -> i32 { n + 1 }

fn captured_combinators() {
    base := 40
    mut hits := 0
    assert(Option<i32>.Some(1).map(plus_one).unwrap() == 2)
    assert(Option<i32>.Some(2).map(fn[base](move n: i32) -> i32 { base + n }).unwrap() == 42)
    assert(Option<i32>.None.map(fn[&mut hits](move n: i32) -> i32 { hits += 1; n }).is_none())
    assert(Option<i32>.None.unwrap_or_else(fn[&mut hits]() -> i32 { hits += 1; 42 }) == 42)
    original: Result<string, i32> = .Ok("ab")
    mapped := original.map(fn[&base](move s: string) -> i32 { base + s.len })
    assert(mapped.unwrap() == 42)
    err: Result<i32, i32> = .Err(2)
    assert(err.map_err(fn[&base](move e: i32) -> i32 { base + e }).unwrap_err() == 42)
    assert(Option<i32>.Some(2).and_then(fn[&base](move n: i32) -> Option<i32> { .Some(base + n) }).unwrap() == 42)
    assert(Option<i32>.None.ok_or_else(fn[&base]() -> i32 { base + 2 }).unwrap_err() == 42)
    assert(Result<i32, i32>.Ok(2).and_then(fn[&base](move n: i32) -> Result<i32, i32> { .Ok(base + n) }).unwrap() == 42)
    assert(Result<i32, i32>.Err(2).unwrap_or_else(fn[&base](move e: i32) -> i32 { base + e }) == 42)
    assert(hits == 1)
}

fn main() {
    captured_combinators()
    accepted := convert(Handle { id: 11 }, true)
    match move accepted {
        .Ok(label) => { assert(label == "11") },
        .Err(_) => { assert(false) },
    }
    refused := convert(Handle { id: 51 }, false)
    print(1)
    match move refused {
        .Ok(_) => { assert(false) },
        .Err(failure) => {
            assert(failure.code == 17)
            assert(failure.handle.id == 51)
            print(2)
        },
    }
    match pass_unit(true) {
        .Ok(n) => { assert(n == 42) },
        .Err => { assert(false) },
    }
    match pass_unit(false) {
        .Ok(_) => { assert(false) },
        .Err => { print(3) },
    }
    match copied() {
        .Ok(n) => { assert(n == 40) },
        .Err(_) => { assert(false) },
    }
    match move relay() {
        .Ok(h) => { assert(h.id == 52); print(4) },
        .Err(_) => { assert(false) },
    }
    match pending_argument() {
        .Ok(_) => { assert(false) },
        .Err => { print(5) },
    }
    entry := Entry { number: 20, nested: .Ok(.Err(42)), marker: 22 }
    match entry.nested {
        .Ok(Result<(), i32>.Err(n)) => { assert(n == 42) },
        _ => { assert(false) },
    }
    assert(entry.number + entry.marker == 42)
    match nominal_identity(.Ok([1, 2, 3, 4])) {
        .Ok(values) => { assert(values[3] == 4) },
        .Err(_) => { assert(false) },
    }
    Result := 1
    assert(Result < 2)
    print(42)
}
