// Export actual verified semantic MIR columns, never variant or retained words.
// The generated function checks its entire 64-bit result against the Python
// reference at runtime. The first three targets use the native shared vocabulary;
// Wasm is built through its real image backend, rather than interpreted ARM.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as parse
import sys

fn integer(at:i32)->i64 { result:=parse.integer(sys.arg(at));assert(result.ok);result.value }
fn binary(code:&mut arm.Code,base:i64,d:i32,a:i32,b:i32) {
    arm.emit(&mut code,base+i64(b)*65536+i64(a)*32+i64(d))
}
fn memory(code:&mut arm.Code,load:bool,width:i32,reg:i32,offset:i32,signed:bool) {
    var size:=0;if width==2{size=1}else if width==4{size=2}else if width==8{size=3}
    var base:i64=939524096;if load{base=943718400};if signed{base=947912704}
    arm.emit(&mut code,base+i64(size)*1073741824+i64(offset).bit_and(511)*4096+29*32+i64(reg))
}
fn dump(f:&mir.Function) {
    print("MIR1");print(f.kinds.len)
    for id in 0..f.kinds.len {
        print(f.kinds[id]);print(f.opcodes[id]);print(f.dst[id]);print(f.a[id]);print(f.b[id]);print(f.c[id])
        print(f.imm[id]);print(f.aux[id]);print(f.types[id]);print(f.place[id]);print(f.extensions[id])
        print(f.effects[id]);print(f.flags[id]);print(f.abi[id]);print(f.reads[id]);print(f.writes[id]);print(f.clobbers[id])
        print(f.modes[id]);print(f.targets[id])
    }
    print("PLACES");print(f.place_kinds.len)
    for p in 0..f.place_kinds.len{print(f.place_kinds[p]);print(f.place_offsets[p]);print(f.place_widths[p])}
    print("LABELS");print(f.label_ids.len)
    for at in 0..f.label_ids.len{print(f.label_ids[at]);print(f.label_ops[at])}
    print("ORDER");print(f.order.len);for at in 0..f.order.len{print(f.order[at])}
    print("END")
}
fn main() {
    target:=i32(integer(2));mode:=sys.arg(3);name:=sys.arg(4);left:=integer(5);right:=integer(6);expected:=integer(7)
    var code:=arm.new_for(target);var sites:[]i32=[]
    entry:=arm.label(&mut code);failed:=arm.label(&mut code)
    arm.branch(&mut code,entry,1);arm.exit(&mut code,0)
    first_word:=code.words.len;first_label:=code.labels.len;first_reloc:=code.at.len
    arm.mark(&mut code,entry);frame:=arm.prologue(&mut code);arm.frame(&mut code,frame,8)
    arm.imm(&mut code,0,left);arm.imm(&mut code,1,right)
    if name=="add"{binary(&mut code,2332033024,0,0,1)}
    else if name=="sub"{binary(&mut code,3405774848,0,0,1)}
    else if name=="mul"{binary(&mut code,2600500224,0,0,1)}
    else if name=="signed-high"{binary(&mut code,2604694528,0,0,1)}
    else if name=="unsigned-high"{binary(&mut code,2613083136,0,0,1)}
    else if name=="div"{binary(&mut code,2596277248,0,0,1)}
    else if name=="and"{binary(&mut code,2315255808,0,0,1)}
    else if name=="or"{binary(&mut code,2852126720,0,0,1)}
    else if name=="xor"{binary(&mut code,3388997632,0,0,1)}
    else if name=="lsl"{binary(&mut code,2596282368,0,0,1)}
    else if name=="lsr"{binary(&mut code,2596283392,0,0,1)}
    else if name=="asr"{binary(&mut code,2596284416,0,0,1)}
    else if name=="add-w"{binary(&mut code,184549376,0,0,1)}
    else if name=="sub-w"{binary(&mut code,1258291200,0,0,1)}
    else if name=="mul-w"{binary(&mut code,453016576,0,0,1)}
    else if name=="div-w"{binary(&mut code,448793600,0,0,1)}
    else if name=="lsl-w"{binary(&mut code,448798720,0,0,1)}
    else if name=="lsr-w"{binary(&mut code,448799744,0,0,1)}
    else if name=="asr-w"{binary(&mut code,448800768,0,0,1)}
    else if name=="copy-w"{arm.emit(&mut code,704644064)}
    else if name=="sign-w"{arm.emit(&mut code,2470476800)}
    else if name=="overlap" {
        memory(&mut code,false,8,0,-24,false);memory(&mut code,false,4,1,-22,false)
        memory(&mut code,true,8,0,-24,false)
    }else if name=="signed-load" {
        memory(&mut code,false,4,0,-24,false);memory(&mut code,true,4,0,-24,true)
    }else if name=="stack" {
        arm.push(&mut code,0);arm.push(&mut code,1);arm.pop(&mut code,2);arm.pop(&mut code,0)
        binary(&mut code,3405774848,0,0,2)
    }else if name=="loop" {
        head:=arm.label(&mut code);done:=arm.label(&mut code)
        arm.store(&mut code,0,0);arm.imm(&mut code,0,0);arm.store(&mut code,1,0)
        arm.mark(&mut code,head);arm.load(&mut code,0);arm.branch(&mut code,done,18)
        arm.mov(&mut code,1,0);arm.load(&mut code,1);binary(&mut code,2332033024,0,0,1);arm.store(&mut code,1,0)
        arm.load(&mut code,0);arm.emit(&mut code,3506438144+1024);arm.store(&mut code,0,0)
        arm.branch(&mut code,head,0);arm.mark(&mut code,done);arm.load(&mut code,1)
    }else if name=="condition" {
        taken:=arm.label(&mut code);done:=arm.label(&mut code)
        binary(&mut code,3942645760,31,0,1);arm.branch(&mut code,taken,13)
        arm.imm(&mut code,0,17);arm.branch(&mut code,done,0)
        arm.mark(&mut code,taken);arm.imm(&mut code,0,29);arm.mark(&mut code,done)
    }else if name=="select" {
        binary(&mut code,3942645760,31,0,1);arm.emit(&mut code,2594113504+10*4096)
    }else if name=="opaque"{arm.emit(&mut code,4294967295)}
    else if name=="external"{arm.branch(&mut code,failed,1)}
    else if name=="cycle"{head:=arm.label(&mut code);arm.mark(&mut code,head);arm.branch(&mut code,head,0)}
    else{assert(false)}
    // This assertion validates all 64 result bits on actual target execution.
    arm.imm(&mut code,1,expected);binary(&mut code,3942645760,31,0,1);arm.branch(&mut code,failed,3)
    arm.ret(&mut code)
    var f:=mir.new();assert(lift.lift(&mut f,&code,first_word,first_label,first_reloc,&sites,0))
    assert(lift.own_entry(&mut f,&code,entry));assert(verify.verify(&mut f))
    if mode=="canonical"{
        for id in 0..f.kinds.len{if f.kinds[id]==1||f.kinds[id]==2||f.kinds[id]==7||f.kinds[id]==8{f.modes[id]=1}}
        assert(verify.verify(&mut f))
    }
    dump(&f)
    if name=="opaque"||name=="external"||name=="cycle"{return}
    if mode!="plain"{
        var work:=lower.new();assert(lower.prepare(&mut work,&f,&code,&sites))
        lower.commit_imports(&mut work,&mut sites);lower.commit_code(&mut work,&mut code)
    }
    arm.mark(&mut code,failed);arm.exit(&mut code,104);end:=code.words.len
    var image:[]u8=[]
    if target==3{abi:=wa.new();result:=wasm.image(&code,end,entry,1,&abi);assert(result.ok);image=result.text}
    else if target==2{result:=x86.finish(&code,end,&sites,&sites);assert(result.ok);image=elf.image_for(&result.text,62)}
    else{text:=arm.finish(&mut code);if target==0{image=macho.image(&text)}else{image=elf.image(&text)}}
    assert(sys.write_u8(sys.arg(1),&image).ok);assert(sys.make_executable(sys.arg(1)).ok)
}
