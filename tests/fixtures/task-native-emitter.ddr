// Actual native images for the internal provider. The optional test library
// injects OS failures and probes the C ABI; normal modes bind real libc APIs.
import ...selfhost.arm64 as arm
import ...selfhost.ffi_arm64 as abi
import ...selfhost.runtime
import ...selfhost.task_native as task
import ...selfhost.macho
import sys

fn ld(c: &mut arm.Code, dst: i32, base: i32, off: i32) { abi.load(&mut c, dst, base, off, 8) }
fn st(c: &mut arm.Code, src: i32, base: i32, off: i32) { abi.store(&mut c, src, base, off, 8) }
fn check(c: &mut arm.Code, reg: i32, value: i64, failed: i32) {
    arm.imm(&mut c, 17, value); arm.emit(&mut c, 3942645791 + 17 * 65536 + i64(reg) * 32); arm.branch(&mut c, failed, 3)
}
fn different(c: &mut arm.Code, a: i32, b: i32, failed: i32) {
    arm.emit(&mut c, 3942645791 + i64(b) * 65536 + i64(a) * 32); arm.branch(&mut c, failed, 2)
}
fn c_call(c: &mut arm.Code, sites: &mut []i32, slots: &mut []i32, slot: i32) {
    sites.push(arm.position(&c) * 4); slots.push(slot); arm.emit(&mut c, 0); arm.emit(&mut c, 0); arm.emit(&mut c, 3594453504)
}
fn clobber_source_homes(c: &mut arm.Code) {
    for reg in 25..29 { arm.imm(&mut c, reg, 900 + i64(reg)) }
    arm.imm(&mut c, 10, 57005)
    for reg in 8..16 { abi.fp(&mut c, reg, 10, 8, true) }
}
fn worker(c: &mut arm.Code, rt: &runtime.Runtime, label: i32, array: bool, failed: i32) {
    arm.mark(&mut c, label); frame := arm.prologue(&mut c); arm.frame(&mut c, frame, 2)
    if !array {
        check(&mut c, 0, 42, failed)
        for reg in 19..25 { check(&mut c, reg, 0, failed) }
        abi.thread_token(&mut c); arm.mov(&mut c, 0, 10)
        clobber_source_homes(&mut c); arm.ret(&mut c); return
    }
    arm.store(&mut c, 0, 0)
    for reg in 22..25 { check(&mut c, reg, 0, failed) }
    // The input descriptor and payload must both belong to the fresh child
    // pool. Comparing bits here does not publish/dereference a user raw handle.
    different(&mut c, 21, 31, failed)
    arm.branch(&mut c, rt.array_clone, 1); arm.store(&mut c, 1, 0)
    ld(&mut c, 1, 0, 0); ld(&mut c, 0, 1, 0); check(&mut c, 0, 11, failed)
    arm.imm(&mut c, 0, 111); st(&mut c, 0, 1, 0)
    arm.load(&mut c, 0); arm.mov(&mut c, 1, 0); arm.load(&mut c, 1); arm.branch(&mut c, rt.array_push, 1)
    arm.mov(&mut c, 1, 21); arm.load(&mut c, 1); arm.branch(&mut c, rt.array_push, 1)
    // Normal owned-argument cleanup runs entirely in the child's heap.
    arm.load(&mut c, 0); ld(&mut c, 0, 0, 0); arm.branch(&mut c, rt.release, 1)
    arm.load(&mut c, 0); arm.branch(&mut c, rt.release, 1)
    arm.load(&mut c, 1); clobber_source_homes(&mut c); arm.ret(&mut c)
}
fn release_array(c: &mut arm.Code, rt: &runtime.Runtime, slot: i32) {
    arm.load(&mut c, slot); ld(&mut c, 0, 0, 0); arm.branch(&mut c, rt.release, 1)
    arm.load(&mut c, slot); arm.branch(&mut c, rt.release, 1)
}
fn main() {
    mode := sys.arg(2); library := sys.arg(3)
    array := mode != "scalar"; probe := library != ""; batch := mode == "batch"
    discard := mode == "discard" || mode == "discard-unmap-fail"
    var c := arm.new(); rt := runtime.new(&mut c)
    main_label := arm.label(&mut c); worker_label := arm.label(&mut c); failed := arm.label(&mut c)
    for reg in 19..25 { arm.imm(&mut c, reg, 0) }
    arm.branch(&mut c, main_label, 1); arm.syscall(&mut c, 33554433, 94); arm.emit(&mut c, 3558866944)
    var clone := -1; if array { clone = rt.array_clone }
    var result_clone := clone; if discard { result_clone = failed }
    spec := task.TaskSpec { input_clone: clone, worker: worker_label, result_clone: result_clone }
    var symbol_count := 3; if probe { symbol_count = 4 }
    symbols := task.Symbols { symbol_count: symbol_count, pthread_create: 0, pthread_join: 1, munmap: 2 }
    provided := task.emit(&mut c, &rt, &spec, &symbols); assert(provided.ok)
    var sites := provided.import_sites; var slots := provided.import_slots
    arm.mark(&mut c, main_label); frame := arm.prologue(&mut c); arm.frame(&mut c, frame, 24)
    for slot in 0..24 { arm.store(&mut c, slot, 31) }
    var count := 1; if batch { count = 4 }
    if array {
        arm.imm(&mut c, 2, 3); arm.branch(&mut c, rt.array_new, 1); arm.store(&mut c, 5, 0)
        for value in [11,22,33] { arm.imm(&mut c, 1, i64(value)); arm.branch(&mut c, rt.array_push, 1) }
        arm.branch(&mut c, rt.array_clone, 1); arm.store(&mut c, 4, 0)
    }
    for i in 0..count {
        arm.imm(&mut c, 0, i64(task.control_bytes())); arm.branch(&mut c, rt.alloc, 1); arm.store(&mut c, i, 0)
        if array { arm.load_into(&mut c, 4, 1) } else { arm.imm(&mut c, 1, 42) }
        task.emit_initialize(&mut c)
    }
    arm.store(&mut c, 6, 21); arm.store(&mut c, 7, 20); arm.store(&mut c, 8, 19)
    arm.emit(&mut c, 2432696320 + 31 * 32); arm.store(&mut c, 19, 0)
    abi.thread_token(&mut c); arm.store(&mut c, 9, 10)
    arm.imm(&mut c, 23, 230023); arm.imm(&mut c, 24, 240024)
    for reg in 25..29 { arm.imm(&mut c, reg, 1000 + i64(reg)) }
    for reg in 8..16 { arm.imm(&mut c, 10, 2000 + i64(reg)); abi.fp(&mut c, reg, 10, 8, true) }
    for i in 0..count {
        arm.load(&mut c, i); arm.branch(&mut c, provided.create, 1)
        if mode == "create-fail" { check(&mut c, 0, 35, failed) } else { check(&mut c, 0, 0, failed) }
        arm.load(&mut c, i); arm.branch(&mut c, provided.create, 1); check(&mut c, 0, -1, failed)
    }
    // The original value may be changed and freed while workers read only the
    // separate retained snapshot. It must not become a child-owned argument.
    if array {
        arm.load(&mut c, 5); ld(&mut c, 1, 0, 0); arm.imm(&mut c, 0, 999); st(&mut c, 0, 1, 0)
        release_array(&mut c, &rt, 5)
    }
    for i in 0..count {
        var collect := provided.collect; if discard { collect = provided.discard }
        arm.load(&mut c, i); arm.branch(&mut c, collect, 1)
        var expected: i64 = 0
        if mode == "create-fail" || mode == "unmap-fail" || mode == "discard-unmap-fail" { expected = -1 }
        if mode == "join-fail" { expected = 22 }
        check(&mut c, 0, expected, failed)
        if mode != "create-fail" && mode != "join-fail" && !discard {
            arm.load(&mut c, i); ld(&mut c, 10, 0, 40); arm.store(&mut c, 14 + i, 10)
        }
        // Calling again uses the stable parent state/cache, never another join
        // or automatic retry of a failed OS call.
        if mode == "discard-cached" { collect = provided.discard }
        arm.load(&mut c, i); arm.branch(&mut c, collect, 1); check(&mut c, 0, expected, failed)
        arm.load(&mut c, i); ld(&mut c, 10, 0, 0)
        var expected_state: i64 = 4
        if mode == "create-fail" { expected_state = 5 }
        else if mode == "join-fail" { expected_state = 6 }
        else if mode == "unmap-fail" { expected_state = 7 }
        else if mode == "discard" { expected_state = 8 }
        else if mode == "discard-unmap-fail" { expected_state = 9 }
        check(&mut c, 10, expected_state, failed)
        if mode == "create-fail" || mode == "join-fail" { continue }
        if probe { ld(&mut c, 10, 0, 72); check(&mut c, 10, 1, failed) }
        if discard {
            ld(&mut c, 10, 0, 40); check(&mut c, 10, 0, failed)
            arm.load(&mut c, i); arm.branch(&mut c, provided.collect, 1); check(&mut c, 0, -1, failed)
            continue
        }
        ld(&mut c, 0, 0, 40); arm.store(&mut c, 10 + i, 0)
        arm.load_into(&mut c, 14 + i, 11)
        arm.emit(&mut c, 3942645791 + 11 * 65536); arm.branch(&mut c, failed, 3)
        if !array {
            arm.load_into(&mut c, 9, 1); different(&mut c, 0, 1, failed); different(&mut c, 0, 31, failed)
        } else {
            different(&mut c, 0, 31, failed); ld(&mut c, 10, 0, 8); check(&mut c, 10, 5, failed)
            ld(&mut c, 1, 0, 0)
            for at in 0..3 { ld(&mut c, 10, 1, at * 8); var value: i64 = 111; if at > 0 { value = i64(at + 1) * 11 }; check(&mut c, 10, value, failed) }
            ld(&mut c, 10, 1, 24); arm.load_into(&mut c, 4, 11); different(&mut c, 10, 11, failed)
            ld(&mut c, 10, 1, 32); different(&mut c, 10, 31, failed)
            arm.load_into(&mut c, 6, 11); different(&mut c, 10, 11, failed)
            // Prior child pools are already munmapped by collect(prior) and the
            // kernel may recycle their VA range if a sibling had not mmapped yet;
            // live parent-cloned result descriptors and buffers must remain distinct.
            for prior in 0..i {
                arm.load_into(&mut c, 10 + prior, 11); different(&mut c, 0, 11, failed)
                ld(&mut c, 11, 11, 0); different(&mut c, 1, 11, failed)
            }
            // Parent mutation after child munmap proves the result owns live
            // parent storage rather than a retained child descriptor/buffer.
            arm.load(&mut c, 10 + i); arm.imm(&mut c, 1, 44); arm.branch(&mut c, rt.array_push, 1)
            ld(&mut c, 10, 0, 8); check(&mut c, 10, 6, failed)
        }
    }
    for reg in 25..29 { check(&mut c, reg, 1000 + i64(reg), failed) }
    for reg in 8..16 { abi.fp(&mut c, reg, 10, 8, false); check(&mut c, 10, 2000 + i64(reg), failed) }
    check(&mut c, 23, 230023, failed); check(&mut c, 24, 240024, failed)
    arm.load_into(&mut c, 6, 10); different(&mut c, 21, 31, failed)
    arm.emit(&mut c, 3942645791 + 10 * 65536 + 21 * 32); arm.branch(&mut c, failed, 3)
    arm.load_into(&mut c, 7, 10); arm.emit(&mut c, 3942645791 + 10 * 65536 + 20 * 32); arm.branch(&mut c, failed, 3)
    arm.load_into(&mut c, 8, 10); arm.emit(&mut c, 3942645791 + 10 * 65536 + 19 * 32); arm.branch(&mut c, failed, 5)
    arm.emit(&mut c, 3942645791 + 20 * 65536 + 19 * 32); arm.branch(&mut c, failed, 10)
    arm.emit(&mut c, 2432696320 + 31 * 32 + 10); arm.load_into(&mut c, 19, 11)
    arm.emit(&mut c, 3942645791 + 11 * 65536 + 10 * 32); arm.branch(&mut c, failed, 3)
    if array && mode != "join-fail" {
        arm.load(&mut c, 4); arm.emit(&mut c, 3506438144 + 8 * 1024); ld(&mut c, 10, 0, 0); check(&mut c, 10, 1, failed)
    }
    if probe {
        var fault := 0; if mode == "create-fail" { fault = 1 } else if mode == "join-fail" { fault = 2 } else if mode == "unmap-fail" || mode == "discard-unmap-fail" { fault = 3 }
        arm.imm(&mut c, 0, i64(fault)); arm.imm(&mut c, 1, i64(count)); arm.imm(&mut c, 2, 0); if array { arm.imm(&mut c, 2, 1) }
        c_call(&mut c, &mut sites, &mut slots, 3); check(&mut c, 0, 0, failed)
    }
    if mode != "join-fail" {
        if array { release_array(&mut c, &rt, 4) }
        if mode != "create-fail" && array && !discard { for i in 0..count { release_array(&mut c, &rt, 10 + i) } }
        for i in 0..count { arm.load(&mut c, i); arm.branch(&mut c, rt.release, 1) }
    }
    arm.imm(&mut c, 0, 0); arm.ret(&mut c)
    worker(&mut c, &rt, worker_label, array, failed)
    arm.mark(&mut c, failed); arm.exit(&mut c, 104)
    runtime.emit_runtime(&mut c, &rt)
    text := arm.finish_for(&mut c, true)
    var libraries: []string = ["c","c","c"]; var names: []string = ["pthread_create","pthread_join","munmap"]
    if probe { libraries = [library,library,library,library]; names = ["probe_create","probe_join","probe_unmap","probe_check"] }
    image := macho.dynamic_image(&text, &libraries, &names, &sites, &slots)
    saved := sys.write_u8(sys.arg(1), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(1)); assert(executable.ok)
}
