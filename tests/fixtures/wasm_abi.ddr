capability unsafe

@c_layout
struct Packet { tag: u8, text: ptr, count: usize, visit: extern fn(i32) -> i32, wide: u64 }
@extern("test", "inspect") unsafe fn inspect(packet: ptr, size: usize, align: usize) -> i32
@extern("test", "bridge") unsafe fn bridge(cb: extern fn(i32, f32, f64, i64, u8, u16, u32, ptr, i32, u64) -> f64, a: i32, b: f32, c: f64, d: i64, e: u8, f: u16, g: u32, p: ptr, i: i32, j: u64) -> f64
@extern("unused", "symbol") unsafe fn unused(x: i32) -> i32
fn inc(n: i32) -> i32 { n + 1 }
fn mix(a: i32, b: f32, c: f64, d: i64, e: u8, f: u16, g: u32, p: ptr, i: i32, j: u64) -> f64 {
    assert(a == -7 && b == 1.25 && c == -0.5 && d == -4294967297)
    assert(e == 255 && f == 65000 && g == 4000000000 && i == -4096 && j == 18446744073709551615)
    unsafe { assert(load_u8(p) == 104) }
    42.25
}
fn main() -> i32 {
    unsafe {
        var packet: Packet = zeroed()
        packet.tag = 251; packet.text = cstr("hello"); packet.count = 5
        packet.visit = callback(inc); packet.wide = 1234567890123456789
        assert(packet.visit(40) == 41)
        host := inspect
        assert(host(addr(&mut packet), size_of(Packet), align_of(Packet)) == 42)
        assert(packet.count == 1234)
        assert(bridge(callback(mix), -7, 1.25, -0.5, -4294967297, 255, 65000, 4000000000, packet.text, -4096, 18446744073709551615) == 42.25)
        return 73
    }
}
