fn calculate(unused: &[]i64, a: i32, b: i32) -> i32 {
    if a < -100 || a > 100 || b < -10 || b > 10 { return 0 }
    (a + b) * (a - b)
}
fn negate(unused: &[]i64, value: i32) -> i32 {
    if value <= -2147483648 { return 0 }
    -value
}
fn main() {
    values: []i64 = []
    assert(calculate(&values, 100, 10) == 9900)
    assert(calculate(&values, -100, -10) == 9900)
    assert(calculate(&values, -7, 3) == 40)
    assert(calculate(&values, 2147483647, 0) == 0)
    assert(negate(&values, -2147483647) == 2147483647)
    assert(negate(&values, 2147483647) == -2147483647)
    assert(negate(&values, -2147483648) == 0)
    print(42)
}
