capability filesystem
import ..support.mir_object_support as object_support
import ...selfhost.backend.arm64 as arm
import ...selfhost.mir.mir
import .mir_machine as lift
import ...selfhost.mir.mir_verify as verify
import ...selfhost.mir.mir_opt as opt
import ...selfhost.mir.mir_memory as memory
import ...selfhost.backend.macho
import sys

fn main() {
    mut code := arm.new()
    entry := arm.label(&mut code); observer := arm.label(&mut code); called := arm.label(&mut code)
    integer := arm.label(&mut code); boolean := arm.label(&mut code); text := arm.label(&mut code)
    write := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code)
    assertion := arm.label(&mut code); io := arm.label(&mut code)
    arm.imm(&mut code, 25, 333)
    arm.branch(&mut code, entry, 1); arm.exit(&mut code, 0)
    arm.mark(&mut code, called); helper := arm.prologue(&mut code); arm.frame(&mut code, helper, 0)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    arm.mark(&mut code, observer); arm.load(&mut code, 0); arm.mov(&mut code, 26, 0)
    arm.mov(&mut code, 0, 25); arm.imm(&mut code, 8, 0)
    arm.branch(&mut code, integer, 1); arm.mov(&mut code, 0, 26); arm.imm(&mut code, 8, 0)
    arm.branch(&mut code, integer, 1); arm.exit(&mut code, 0)
    first := code.words.len; labels := code.labels.len; relocations := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1)
    arm.imm(&mut code, 0, 7); arm.store(&mut code, 0, 0); arm.branch(&mut code, called, 1)
    arm.imm(&mut code, 0, 13); arm.store(&mut code, 0, 0)
    for repeat in 0..8 { arm.load(&mut code, 0); arm.store(&mut code, 0, 0) }
    arm.imm(&mut code, 0, 1); arm.branch(&mut code, observer, 19)
    arm.load(&mut code, 0); arm.ret(&mut code)
    mut f := mir.new(); mut sites: []i32 = []
    assert(lift.lift(&mut f, &code, first, labels, relocations, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    mut work := opt.new(); mut prepared := false
    if sys.arg(2) == "raw" { prepared = opt.analyze_into(&mut work, &f) }
    else if sys.arg(2) == "memory" { context := memory.for_source_producer(true); prepared = opt.analyze_with_context(&mut work, &f, &context) }
    else { assert(sys.arg(2) == "off") }
    if prepared { opt.apply(&mut work, &mut f); assert(verify.verify(&mut f)) }
    assert(object_support.lower_and_link(&f, &mut code, &mut sites))
    arm.runtime(&mut code, integer, boolean, text, write, overflow, zero, assertion, io)
    bytes := arm.finish(&mut code); image := macho.image(&bytes)
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print(prepared); print(opt.status(&work))
}
