capability unsafe, process, stdio
import std.terminal
import std.process
import sys

@extern("kernel32", "GetStdHandle") unsafe fn handle(id: i32) -> ptr
@extern("kernel32", "GetConsoleMode") unsafe fn get_mode(input: ptr, mode: ptr) -> i32
@extern("kernel32", "CreateConsoleScreenBuffer") unsafe fn buffer(access: u32, share: u32, attributes: ptr, flags: u32, data: ptr) -> ptr
@extern("kernel32", "ReadConsoleOutputCharacterW") unsafe fn read_screen(screen: ptr, output: ptr, count: u32, origin: u32, read: ptr) -> i32
@extern("kernel32", "CloseHandle") unsafe fn close(screen: ptr) -> i32

fn input_mode() -> u32 {
    mut mode := u32(0)
    unsafe { assert(get_mode(handle(-10), addr(&mut mode)) != 0) }
    mode
}

fn early() -> i32 {
    _guard := terminal.RawMode::enter().unwrap()
    assert(input_mode().bit_and(7) == 0)
    return 42
}

fn main() {
    if sys.arg_count() > 1 {
        assert(terminal.size().unwrap().columns > 0)
        print(sys.arg(1))
        return
    }
    before := input_mode()
    assert(early() == 42 && input_mode() == before)
    unsafe {
        stdin := handle(-10); stdout := handle(-11); stderr := handle(-12)
        mut screens: [usize; 2] = [0; 2]
        mut children: []process.Child = []
        defer { for screen in &screens { if screen != 0 { _ := close(ptr(screen)) } } }
        for i in 0..2 {
            screen := buffer(0xc0000000, 3, ptr(0), 1, ptr(0))
            assert(i64(usize(screen)) != -1)
            screens[i] = usize(screen)
            cmd := process.Command::new(sys.arg(0), [(i + 1).str()])
            children.push(cmd.spawn_with_handles(.None, .Some(usize(screen)), .None).unwrap())
        }
        for i in 0..2 {
            status := children[i].wait(5000)
            assert(status.ok && status.exited && status.code == 0)
            mut first := u16(0); mut count := u32(0)
            assert(read_screen(ptr(screens[i]), addr(&mut first), 1, 0, addr(&mut count)) != 0)
            assert(count == 1 && i32(first) == 49 + i)
        }
        assert(handle(-10) == stdin && handle(-11) == stdout && handle(-12) == stderr)
    }
    print("PASS Windows console restoration and child streams")
}
