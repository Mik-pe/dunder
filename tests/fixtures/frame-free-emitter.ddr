// Build real scalar callees behind a framed ABI-guard caller.
import ...selfhost.arm64 as arm
import ...selfhost.lexer
import ...selfhost.opt_ir as ir
import ...selfhost.opt_parse as parse
import ...selfhost.opt_alloc as alloc
import ...selfhost.opt_emit as emitter
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as integers
import sys

fn compare(code: &mut arm.Code, left: i32, right: i32) { arm.emit(&mut code, 3942645791 + i64(right) * 65536 + i64(left) * 32) }
fn main() {
    platform := i32(integers.integer(sys.arg(2)).value)
    enabled := sys.arg(3) == "on"; selected := i32(integers.integer(sys.arg(4)).value)
    var names: []string = []; var types: []i32 = []; var positions: []i32 = []
    var arguments: []i64 = [1, 2, 3, 4, 5, 6, 7, 8]
    var expected: i64 = 0; var source := ""; var params := 8
    if selected == 0 { source = "a b c d e f g h{a+2*b+3*c+4*d+5*e+6*f+7*g+8*h}"; expected = 204 }
    else if selected == 1 {
        source = "a b c d e f g h{if a!=-1{return 1};if b!=2{return 2};if c!=-3{return 3};if d!=4{return 4};e+f+g+h}"
        arguments[0] = 4294967295; arguments[1] = 4294967298; arguments[2] = 8589934589; arguments[3] = 4294967300
        expected = 26
    } else if selected == 2 { source = "a b c d e f g h{a+d+h}"; expected = 13 }
    else if selected == 3 { source = "a b c d e f g h{(a+b)*(c+d)+(e+f)*(g+h)}"; expected = 186 }
    else if selected == 4 {
        params = 1; arguments[0] = 2; expected = 12
        source = "a{var i:=0;var total:i64=0;while i<5{for j in 0..4{if j==1{continue};if i==3{return total};total=total+a;if j==2{break}};i=i+1};total}"
    } else {
        params = 1
        if selected == 5 { source = "a{(a+1)/3}"; arguments[0] = 9223372036854775807 }
        else if selected == 6 { source = "a{a/0}" }
        else if selected == 7 { source = "a{a/(-1)}"; arguments[0] = -9223372036854775808 }
        else if selected == 8 { source = "a{a%(-1)}"; arguments[0] = -9223372036854775808 }
        else if selected == 9 { source = "a{(a+1)/0}"; arguments[0] = 9223372036854775807 }
        else {
            assert(selected == 10); expected = 104
            source = "a{a1:=a+1;a2:=a+2;a3:=a+3;a4:=a+4;a5:=a+5;a6:=a+6;a7:=a+7;a8:=a+8;a9:=a+9;a10:=a+10;a11:=a+11;a12:=a+12;a13:=a+13;a1+a2+a3+a4+a5+a6+a7+a8+a9+a10+a11+a12+a13}"
        }
    }
    tokens := lexer.scan(source, false)
    for p in 0..params {
        names.push(tokens.texts[p]); positions.push(p)
        if selected == 1 && p < 4 { types.push(1) } else { types.push(2) }
    }
    var f := ir.new()
    assert(parse.parse(&mut f, &tokens, params, tokens.kinds.len - 2, &names, &types, &positions, 2))
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &f)
    if selected == 0 {
        // Exercise an actual four-register cycle, independently of whichever
        // deterministic homes today's allocator happens to choose.
        for p in 0..4 { plan.homes[p] = 10 + p }
        plan.homes[4] = 5; plan.homes[5] = 6; plan.homes[6] = 7; plan.homes[7] = 4
    }
    var code := arm.new_for(platform)
    entry := arm.label(&mut code); callee := arm.label(&mut code); overflow := arm.label(&mut code)
    zero := arm.label(&mut code); bounds := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    arm.store(&mut code, 0, 29)
    arm.emit(&mut code, 2432697321); arm.store(&mut code, 1, 9) // Save SP with ADD x9,SP,#0.
    for reg in 19..29 { arm.imm(&mut code, reg, i64(reg) * 1000003 + 41) }
    for p in 0..params { arm.imm(&mut code, p, arguments[p]) }
    arm.branch(&mut code, callee, 1)
    arm.imm(&mut code, 1, expected); compare(&mut code, 0, 1); arm.branch(&mut code, assertion, 3)
    for reg in 19..29 {
        arm.imm(&mut code, 0, i64(reg) * 1000003 + 41); compare(&mut code, reg, 0); arm.branch(&mut code, assertion, 3)
    }
    arm.emit(&mut code, 2432697314); arm.load(&mut code, 1); compare(&mut code, 2, 0); arm.branch(&mut code, assertion, 3)
    arm.load(&mut code, 0); compare(&mut code, 29, 0); arm.branch(&mut code, assertion, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    var settings := emitter.options(); settings.frame_free_enabled = enabled
    begin := code.words.len
    emitter.emit_prepared_configured(&mut code, &f, &plan, callee, overflow, zero, bounds, &settings)
    words := code.words.len - begin
    var frameless := 1; if code.words[begin] == 2847898621 { frameless = 0 }
    arm.mark(&mut code, overflow); arm.exit(&mut code, 101)
    arm.mark(&mut code, zero); arm.exit(&mut code, 102)
    arm.mark(&mut code, bounds); arm.exit(&mut code, 103)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    var image: []u8 = []; none: []i32 = []
    if platform == 3 {
        abi := wa.new(); result := wasm.image(&code, code.words.len, entry, 1, &abi); assert(result.ok); image = result.text
    } else if platform == 2 {
        result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62)
    } else {
        text := arm.finish(&mut code)
        if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) }
    }
    saved := sys.write_u8(sys.arg(1), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(1)); assert(executable.ok)
    print(words); print(frameless)
}
