// Execute a whole MIR function, including a late owner initializer and calls
// into an old-style helper that deliberately destroys new register homes.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_opt as opt
import ...selfhost.mir_liveness as live
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys
fn integer(at: i32) -> i32 { i32(decimal.integer(sys.arg(at)).value) }
fn compare(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn add(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn initialize(code: &mut arm.Code, count: i32, max_sum: bool) {
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0)
    if max_sum { arm.imm(&mut code, 0, 9223372036854775807) }; arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, i64(count)); arm.store(&mut code, 2, 0)
}
fn main() {
    platform := integer(2); selected := integer(3); enabled := sys.arg(4) == "on"
    var code := arm.new_for(platform)
    wrapper := arm.label(&mut code); entry := arm.label(&mut code); old_callee := arm.label(&mut code)
    assertion := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, old_callee); old_frame := arm.prologue(&mut code); arm.frame(&mut code, old_frame, 0)
    for reg in 25..29 { arm.imm(&mut code, reg, i64(reg) * 1000003) }
    arm.imm(&mut code, 0, 777); arm.ret(&mut code)
    arm.mark(&mut code, overflow); arm.exit(&mut code, 101); arm.mark(&mut code, zero); arm.exit(&mut code, 102)
    first_word := code.words.len; first_label := code.labels.len; first_reloc := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    head := arm.label(&mut code); done := arm.label(&mut code); init := arm.label(&mut code)
    early := arm.label(&mut code); latch := arm.label(&mut code)
    var count := 10; if selected == 4 || selected == 9 || selected == 11 { count = 0 }
    if selected == 2 { arm.branch(&mut code, init, 0) } else { initialize(&mut code, count, selected == 8 || selected == 9) }
    arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    compare(&mut code, 1, 0); arm.branch(&mut code, done, 12)
    if selected == 3 || selected == 6 {
        arm.load(&mut code, 0); var limit := 3; if selected == 6 { limit = 5 }
        arm.imm(&mut code, 1, i64(limit)); compare(&mut code, 0, 1)
        if selected == 3 { arm.branch(&mut code, early, 2) } else { arm.branch(&mut code, done, 2) }
    }
    if selected == 5 {
        arm.load(&mut code, 0); arm.imm(&mut code, 1, 1)
        arm.emit(&mut code, 2315255808 + 65536); arm.branch(&mut code, latch, 19)
    }
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 0); arm.pop(&mut code, 1)
    if selected == 10 || selected == 11 { arm.imm(&mut code, 0, 0); arm.branch(&mut code, zero, 18) }
    arm.emit(&mut code, 2868903968); arm.branch(&mut code, overflow, 8); arm.store(&mut code, 1, 0)
    if selected == 1 { arm.branch(&mut code, old_callee, 1) }
    arm.mark(&mut code, latch)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); arm.emit(&mut code, 2868903936 + 65536); arm.branch(&mut code, overflow, 8); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
    if selected == 7 { arm.branch(&mut code, old_callee, 1) }
    arm.load(&mut code, 1); arm.ret(&mut code)
    if selected == 3 { arm.mark(&mut code, early); arm.load(&mut code, 1); arm.ret(&mut code) }
    if selected == 2 { arm.mark(&mut code, init); initialize(&mut code, count, selected == 8 || selected == 9); arm.branch(&mut code, head, 0) }
    var sites: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, first_word, first_label, first_reloc, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f) && f.optimizable)
    var work := opt.new(); var promoted := 0
    if enabled {
        assert(opt.analyze_into(&mut work, &f)); promoted = opt.promoted(&work)
        opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
    } else { assert(sys.arg(4) == "off") }
    var loops := live.new(); assert(live.analyze_into(&mut loops, &f, 1000000)); var loop_memory := 0
    for op in 0..f.kinds.len {
        if f.modes[op] != 2 && live.loop_block(&loops, f.op_blocks[op]) && (f.kinds[op] == 7 || f.kinds[op] == 8) { loop_memory = loop_memory + 1 }
    }
    var lowering := lower.new(); assert(lower.prepare(&mut lowering, &f, &code, &sites))
    lower.commit_code(&mut lowering, &mut code); lower.commit_imports(&mut lowering, &mut sites)
    arm.mark(&mut code, wrapper); wrapper_frame := arm.prologue(&mut code); arm.frame(&mut code, wrapper_frame, 0)
    for reg in 25..29 { arm.imm(&mut code, reg, i64(reg) * 17 + 3) }
    arm.branch(&mut code, entry, 1)
    var expected: i64 = 45; if selected == 3 { expected = 3 }; if selected == 4 { expected = 0 }
    if selected == 5 { expected = 20 }; if selected == 6 { expected = 10 }
    if selected == 9 { expected = 9223372036854775807 }; if selected == 11 { expected = 0 }
    arm.imm(&mut code, 1, i64(expected)); compare(&mut code, 0, 1); arm.branch(&mut code, assertion, 3)
    for reg in 25..25 + promoted {
        arm.imm(&mut code, 0, i64(reg) * 17 + 3); compare(&mut code, reg, 0); arm.branch(&mut code, assertion, 3)
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code); arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    var image: []u8 = []; none: []i32 = []
    if platform == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if platform == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut code); if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print(promoted); print(loop_memory)
}
