// error: compute mutations before borrowing an array element
struct Samples { values: []i32 }
struct Weight { value: i32 }
fn combine(sample: &i32, weight: Weight) -> i32 { sample + weight.value }
fn main() {
    var samples := Samples { values: [10, 20] }
    print(combine(&samples.values[0], Weight { value: samples.values.pop() }))
}
