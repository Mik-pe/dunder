// error: mutable arguments must not alias
struct Actions { write: fn(&mut i32, &i32) }
fn update(a: &mut i32, b: &i32) { a = b }
fn exercise() {
    actions := Actions { write: update }
    var value := 1
    actions.write(&mut value, &value)
}
fn main(){exercise()}
@test fn contract(){exercise()}
