@resource(dispose)
struct Handle { value: i32, open: bool, contents: []i32 }

impl Handle {
    fn new(value: i32) -> Self { Self { value: value, open: true, contents: [42] } }

    fn close(&mut self) {
        if self.open {
            print(self.value)
            self.open = false
        }
    }

    fn dispose(&self) {
        assert(self.contents[0] == 42)
        if self.open { print(self.value) }
    }
}

enum Outcome { Rejected(Handle), Accepted }
struct Owner { handle: Handle }

fn dispose() { assert(true) }

fn forward(move handle: Handle) -> Handle {
    print(10)
    return handle
}

fn fail_with_handle(move handle: Handle) -> Outcome {
    local := Handle::new(13)
    return .Rejected(handle)
}

fn capture(move handle: Handle) -> fn() -> i32 {
    fn[handle: Handle]() -> i32 { handle.value }
}

fn main() {
    dispose()
    {
        handle := forward(Handle::new(12))
        print(11)
    }
    outcome := fail_with_handle(Handle::new(15))
    print(14)
    match move outcome {
        .Rejected(handle) => { assert(handle.value == 15) },
        .Accepted => { assert(false) },
    }

    for value in 16..19 {
        scoped := Handle::new(value)
        if value == 16 { continue }
        if value == 17 { break }
    }

    {
        mut manual := Handle::new(18)
        previous := replace(&mut manual.contents, [42])
        assert(previous[0] == 42)
        manual.close()
        manual.close()
        deeper := Owner { handle: Handle::new(19) }
        print(0)
    }

    {
        closure := capture(Handle::new(26))
        assert(closure() == 26)
    }

    mut handles: []Handle = [Handle::new(20), Handle::new(21)]
    removed := handles.remove(0)
    handles.clear()
    assert(removed.value == 20)

    mut slot := Handle::new(22)
    slot = Handle::new(23)
    replaced := replace(&mut slot, Handle::new(24))
    assert(replaced.value == 23 && slot.value == 24)
    print(25)
}
