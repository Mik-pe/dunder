import std.bytes as bytes
import sys

fn check(text: string) {
    expected: []rune = [`\0`, `\u{7f}`, `\u{80}`, `\u{7ff}`, `\u{800}`, `\u{d7ff}`, `\u{e000}`, `\u{ffff}`, `\u{10000}`, `\u{10ffff}`]
    mut position := 0
    for scalar in text.runes() { assert(scalar == expected[position]); position = position + 1 }
    assert(position == expected.len)
}
fn reject(data: []u8) {
    assert(bytes.decode(&data) == .Err(.InvalidUtf8))
}
fn packet_text(data: &[]u8, end: i32, suffix: &[]u8) -> Result<string, sys.IoError> {
    prefix := bytes.decode_range(&data, 0, end)?
    tail := bytes.decode(&suffix)?
    .Ok(prefix + tail)
}
fn main() {
    data := bytes.from_text("å")
    suffix := bytes.from_text("🌍")
    empty: []u8 = []
    invalid: []u8 = [255]
    assert(packet_text(&data, 2, &suffix) == .Ok("å🌍"))
    assert(packet_text(&empty, 0, &empty) == .Ok(""))
    assert(packet_text(&data, 1, &empty) == .Err(.InvalidUtf8))
    assert(packet_text(&data, 3, &empty) == .Err(.InvalidArgument))
    assert(packet_text(&data, 2, &invalid) == .Err(.InvalidUtf8))
    text := "\0\u{7f}\u{80}\u{7ff}\u{800}\u{d7ff}\u{e000}\u{ffff}\u{10000}\u{10ffff}"
    check(text)
    wrapped := "π" + text + "β"
    check(wrapped[2..2 + text.len])
    mut packed: []u8 = []
    bytes.append_utf8(&mut packed, text)
    check(bytes.decode(&packed).unwrap())
    reject([255]); reject([192, 175]); reject([226])
    reject([237, 160, 128]); reject([244, 144, 128, 128])
    print(42)
}
