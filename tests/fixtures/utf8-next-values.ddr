import std.bytes as bytes

fn check(text: string) {
    expected: []rune = [`\0`, `\u{7f}`, `\u{80}`, `\u{7ff}`, `\u{800}`, `\u{d7ff}`, `\u{e000}`, `\u{ffff}`, `\u{10000}`, `\u{10ffff}`]
    var position := 0
    for scalar in text.runes() { assert(scalar == expected[position]); position = position + 1 }
    assert(position == expected.len)
}
fn reject(data: []u8) {
    rejected := bytes.decode(&data)
    assert(!rejected.ok && rejected.error == 92)
    for scalar in rejected.value.runes() { assert(false) }
}
fn main() {
    text := "\0\u{7f}\u{80}\u{7ff}\u{800}\u{d7ff}\u{e000}\u{ffff}\u{10000}\u{10ffff}"
    check(text)
    wrapped := "π" + text + "β"
    check(wrapped[2..2 + text.len])
    var packed: []u8 = []
    bytes.append_utf8(&mut packed, text)
    decoded := bytes.decode(&packed); assert(decoded.ok); check(decoded.value)
    reject([255]); reject([192, 175]); reject([226])
    reject([237, 160, 128]); reject([244, 144, 128, 128])
    print(42)
}
