import bounds

struct Bound { value: i32 }
struct Nested { inner: Bound }
struct Fields { i: i32, value: i32 }
struct Wrapper { Bound: i32 }
fn i() -> i32 { 3 }
fn step(value: i32) -> i32 { value }
fn marker() { print(99) }

fn scalar_type_shadow() -> i32 {
    var Bound := 3
    var total := 0
    for Bound in 0..Bound { total = total + Bound }
    return total + Bound
}
fn scalar_field_shadow() -> i32 {
    object := Wrapper { Bound: 3 }
    var total := 0
    for index in 0..object.Bound { total = total + index }
    return total
}
fn main() {
    // The iterator starts after both bounds, even when a constructor closes
    // before the body. Its function namesake remains visible in the bounds.
    for i in (Bound { value: 0 }.value)..i() { print(i) }
    print(i())
    var total := 0
    for i in Bound { value: 0 }.value..Bound { value: i() }.value {
        total = total + i
    }
    print(total)
    total = 0
    for i in Nested { inner: Bound { value: 0 } }.inner.value..i() {
        total = total + i
    }
    print(total)
    // Constructor fields are not lexical declarations, including multiline
    // fields whose spelling also names an outer function.
    total = 0
    for i in Fields {
        i: 0,
        value: i(),
    }.i..i() { total = total + i }
    print(total)
    total = 0
    for bounds in bounds.Limit { value: 0 }.value..bounds.upper() {
        total = total + bounds
    }
    print(total)
    values := [0, 3]
    total = 0
    for i in values[Bound { value: 0 }.value]..step(values[(Bound { value: 1 }.value)]) {
        total = total + i
    }
    print(total)
    total = 0
    for i in 0..2 {
        for i in (Bound { value: i }.value)..(Bound { value: i + 2 }.value) {
            total = total + i
        }
        total = total + i
    }
    print(total)
    print(scalar_type_shadow())
    print(scalar_field_shadow())
    // A following parenthesized call is a new statement, not a continuation
    // of a constructor. The resolver uses structural context, not lookahead.
    for i in Bound { value: 0 }.value..i() {} (marker)()
}
