import bounds

struct Bound { value: i32 }
struct Nested { inner: Bound }
struct Fields { i: i32, value: i32 }
struct Wrapper { Bound: i32 }
fn i() -> i32 { 3 }
fn step(value: i32) -> i32 { value }
fn marker() { print(99) }

enum Bounds { Named(string, i32), Limit(i32), Missing }
enum BoundPair { Pair(Bounds, bounds.LimitKind) }
fn nested_payload_scope(pair: BoundPair) -> i32 {
    match pair {
        .Pair(Bounds.Named(bounds, i), bounds.LimitKind.Exact(step)) => bounds.len + i + step,
        _ => bounds.upper() + i(),
    }
}
fn guarded_payload_scope(pair: BoundPair, other: Bounds) -> i32 {
    match pair {
        .Pair(Bounds.Named(bounds, i), bounds.LimitKind.Exact(step))
            if match other {
                .Limit(i) if if i > 0 { i == bounds.len } else { false } => true,
                _ => false,
            }
            => bounds.len + i + step,
        _ => bounds.upper() + i(),
    }
}
fn plain_if_after_call(flag: bool) {
    bounds.check_provider(i)
    if flag { assert(i() == 3) }
}
fn sum(left: i32, right: i32) -> i32 { left + right }
fn payload_scope(value: Bounds, nested: Bounds) -> i32 {
    size := match value {
        .Named(bounds, i) => sum(i, match nested {
            .Named(bounds, _) => bounds.len,
            _ => sum(bounds.len, i),
        }),
        .Limit(i) => sum(i, bounds.upper()),
        .Missing => i(),
    }
    size + bounds.upper()
}
fn match_iterator(value: Bounds) -> i32 {
    mut total := 0
    for bounds in match if Bound { value: 1 }.value > 0 { value.clone() } else { Bounds.Missing } {
        .Limit(n) => [bounds.upper().str(), n.str()],
        _ => ["a", "bc"],
    } {
        total += bounds.len
    }
    total + bounds.upper()
}
fn initializer_scope(flag: bool) -> i32 {
    bounds := match if flag { Bounds.Missing }
        else { Bounds.Limit(bounds.upper()) } {
        .Limit(i) => i,
        _ => bounds.upper() + 1,
    }
    bounds
}

fn scalar_type_shadow() -> i32 {
    mut Bound := 3
    mut total := 0
    for Bound in 0..Bound { total = total + Bound }
    return total + Bound
}
fn scalar_field_shadow() -> i32 {
    object := Wrapper { Bound: 3 }
    mut total := 0
    for index in 0..object.Bound { total = total + index }
    return total
}
fn main() {
    plain_if_after_call(true)
    pair := BoundPair.Pair(.Named("abc", i()), bounds.LimitKind.Exact(step(4)))
    assert(guarded_payload_scope(pair, .Limit(3)) == 10)
    assert(guarded_payload_scope(pair, .Limit(2)) == 6)
    assert(nested_payload_scope(.Pair(.Named("abc", i()), bounds.LimitKind.Exact(step(4)))) == 10)
    assert(nested_payload_scope(.Pair(.Missing, .Unbounded)) == 6)
    assert(payload_scope(.Named("outer", 2), .Named("in", 8)) == 7)
    assert(payload_scope(.Named("outer", 2), .Missing) == 12)
    assert(payload_scope(.Limit(7), .Missing) == 13)
    assert(payload_scope(.Missing, .Missing) == 6)
    assert(match_iterator(.Limit(42)) == 6 && match_iterator(.Missing) == 6)
    assert(initializer_scope(true) == 4 && initializer_scope(false) == 3)
    for i in (Bound { value: 0 }.value)..i() { print(i) }
    print(i())
    mut total := 0
    for i in Bound { value: 0 }.value..Bound { value: i() }.value {
        total = total + i
    }
    print(total)
    total = 0
    for i in Nested { inner: Bound { value: 0 } }.inner.value..i() {
        total = total + i
    }
    print(total)
    total = 0
    for i in Fields {
        i: 0,
        value: i(),
    }.i..i() { total = total + i }
    print(total)
    total = 0
    for bounds in bounds.Limit { value: 0 }.value..bounds.upper() {
        total = total + bounds
    }
    print(total)
    values := [0, 3]
    total = 0
    for i in values[Bound { value: 0 }.value]..step(values[(Bound { value: 1 }.value)]) {
        total = total + i
    }
    print(total)
    total = 0
    for i in 0..2 {
        for i in (Bound { value: i }.value)..(Bound { value: i + 2 }.value) {
            total = total + i
        }
        total = total + i
    }
    print(total)
    print(scalar_type_shadow())
    print(scalar_field_shadow())
    for i in Bound { value: 0 }.value..i() {} (marker)()
}
