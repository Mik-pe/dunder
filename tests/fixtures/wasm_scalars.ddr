capability unsafe
@extern("oracle", "case_id") unsafe fn case_id() -> i32

enum Sign { Minus = -10, Plus = 5 }

fn second(values: &[]usize) -> usize { values[1] }

fn main() -> i32 {
    var selected := 0
    unsafe { selected = case_id() }
    max: usize = 4294967295
    wide: u64 = 18446744073709551615
    if selected == 1 { print(max + 1) }
    if selected == 2 { print(max * 2) }
    if selected == 3 { print(max.shl(32)) }
    if selected == 4 { print(usize(wide)) }
    if selected == 5 { print(usize(4294967296.0)) }
    if selected == 6 { print(u64(-1.0)) }
    if selected == 7 { print(i64(0.0 / 0.0)) }
    if selected == 8 { print(wide + 1) }
    if selected == 9 { print(wide * 2) }
    if selected == 10 { print(i64(-9223372036854775808) / i64(-1)) }
    if selected == 11 { print(i32(-2147483648) % i32(-1)) }
    if selected == 12 { unsafe { print(load_u64(ptr(max))) } }
    if selected == 13 { print(u8(256.0)) }
    if selected == 14 { print(i64(9223372036854775808.0)) }
    if selected == 15 { print(i64(9223372036854775807) * i64(2)) }
    if selected == 16 { print(usize(0) - usize(1)) }
    if selected == 17 { print(i32(-2147483648) / i32(-1)) }
    assert(max.wrapping_add(1) == 0)
    assert(usize(0).bit_not() == max)
    assert(usize(4294967295.75) == max)
    assert(max.shr(31) == 1)
    assert(usize(1).shl(31) == 2147483648)
    assert(wide / 3 == 6148914691236517205)
    assert(wide.wrapping_mul(2) == 18446744073709551614)
    assert(i64(-2147483648) * i64(2147483648) == i64(-4611686018427387904))
    assert(u64(18446744073709549568.0) == 18446744073709549568)
    assert(f64(wide) == 18446744073709551616.0)
    assert((-0.49).round().is_sign_negative())
    assert(0.49999999999999994.round() == 0.0)
    assert((-2.5).round() == -3.0)
    assert(2.5.round_ties_even() == 2.0)
    assert(f32.from_bits(-2147483648).is_sign_negative())
    assert(f32.from_bits(1).to_bits() == 1)
    assert(f64.from_bits(1).to_bits() == 1)
    unsafe {
        assert(size_of(usize) == 4 && size_of(ptr) == 4)
        var cells: [usize;2] = [0;2]
        p := addr(&mut cells[0])
        assert(usize(addr(&cells[1])) == usize(p) + 4)
        store_usize(p, max)
        assert(load_usize(p) == max && cells[1] == 0)
        var signs: []Sign = [.Plus, .Minus]
        assert(usize(addr(&signs[1])) == usize(addr(&signs[0])) + 4)
        assert(i64(signs[1]) == -10)
        assert(i64(signs.pop()) == -10)
        var pointers: [ptr;2] = [p, cstr("hello")]
        assert(usize(addr(&pointers[1])) == usize(addr(&pointers[0])) + 4)
        assert(load_u8(pointers[1]) == 104)
        var value: u64 = 0
        store_u64(addr(&mut value), wide)
        assert(load_u64(addr(&value)) == wide)
    }
    region frame(8) {
        var indices: []usize = frame.alloc(2)
        indices[1] = max
        assert(second(&indices) == max)
    }
    print(max)
    print(wide)
    print(f32(-0.0))
    print(-2.25)
    print(f64.from_bits(1))
    42
}
