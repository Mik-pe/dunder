capability unsafe, process
import ...stdlib.map as map
import ...stdlib.set as set
import ...stdlib.json as json
import ...stdlib.bytes as bytes
import ...stdlib.wire as wire
import ...stdlib.process as process

fn string_identity(value: string) -> i64 { unsafe { load_i64(addr(&value)) } }
fn byte_identity(value: []u8) -> usize { unsafe { usize(addr(&value[0])) } }

fn main() {
    mut table := map.new()
    key := "retained-" + 42.str()
    key_identity := string_identity(key)
    map.put(&mut table, move key, 42)
    for i in 0..1000 { map.put(&mut table, i.str(), i64(i)) }
    for i in 0..900 { assert(map.remove(&mut table, i.str())) }
    map.reserve(&mut table, 2000)
    assert(map.get_or(&table, "retained-42", 0) == 42)
    mut found := false
    for i in 0..table.slots.len {
        if table.slots[i] == 1 && table.keys[i] == "retained-42" {
            assert(string_identity(table.keys[i]) == key_identity)
            found = true
        }
    }
    assert(found)
    map.put(&mut table, "retained-" + 42.str(), 84)
    assert(map.get_or(&table, "retained-42", 0) == 84)

    mut values := set.new()
    item := "retained-" + 7.str()
    item_identity := string_identity(item)
    assert(set.insert(&mut values, move item))
    for i in 0..1000 { assert(set.insert(&mut values, i.str())) }
    for i in 0..900 { assert(set.remove(&mut values, i.str())) }
    set.reserve(&mut values, 2000)
    assert(!set.insert(&mut values, "retained-" + 7.str()))
    found = false
    for i in 0..values.slots.len {
        if values.slots[i] == 1 && values.keys[i] == "retained-7" {
            assert(string_identity(values.keys[i]) == item_identity)
            found = true
        }
    }
    assert(found && set.length(&values) == 101)

    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, "{\"name\":\"hej \\u00e5\",\"n\":42}")
    raw.reserve(1024)
    raw_identity := byte_identity(raw)
    raw_capacity := raw.cap()
    doc := json.Doc::parse_bytes(move raw)
    assert(doc.ok && byte_identity(doc.input) == raw_identity && doc.input.cap() == raw_capacity)
    assert(doc.get_str(doc.root, "name").value == "hej å")
    assert(doc.get_i64(doc.root, "n").value == 42)
    assert(json.quote("hej å") == "\"hej å\"")
    assert(doc.raw_span(doc.field(doc.root, "n")) == "42")

    mut cmd := process.command("/bin/echo", [])
    args: []string = ["first-" + 1.str(), "second-" + 2.str()]
    first_identity := string_identity(args[0])
    process.add_args(&mut cmd, move args)
    assert(cmd.args.len == 2 && cmd.args[0] == "first-1" && cmd.args[1] == "second-2")
    assert(string_identity(cmd.args[0]) == first_identity)
    mut input: []u8 = [1, 2, 3]
    input.reserve(128)
    input_identity := byte_identity(input)
    input_capacity := input.cap()
    process.set_stdin(&mut cmd, move input)
    assert(byte_identity(cmd.stdin_data) == input_identity && cmd.stdin_data.cap() == input_capacity)
    assert(cmd.stdin_data.len == 3 && cmd.stdin_data[2] == 3)

    output := process.run("/bin/echo", ["owned-42"])
    assert(process.succeeded(&output) && process.stdout_text(&output) == "owned-42\n")
    in_root := process.run_in("/bin/pwd", [], "/")
    assert(process.succeeded(&in_root) && process.stdout_text(&in_root) == "/\n")
    exit_status := process.status("/bin/sh", ["-c", "exit 0"])
    assert(exit_status.ok && exit_status.code == 0)
    executable := process.grant("/bin/echo")
    granted_output := process.run_granted(&executable, ["granted-42"])
    assert(process.succeeded(&granted_output) && process.stdout_text(&granted_output) == "granted-42\n")

    mut encoded: []u8 = []
    wire.put_str(&mut encoded, "owned-" + 42.str())
    mut reader := wire.Reader::new()
    assert(reader.read_str(&encoded) == "owned-42")
    assert(bytes.hex_u8(&cmd.stdin_data) == "010203")
    print("stdlib ownership ok")
}
