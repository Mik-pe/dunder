import ...selfhost.backend.arm64 as arm
import ...selfhost.mir.mir
import .mir_machine as lift
import ...selfhost.mir.mir_verify as verify
import ...selfhost.mir.mir_terminals as terminals

pub fn context(label: i32) -> terminals.TerminalContext {
    terminals.TerminalContext { version: 1, overflow: label, zero: label, assertion: label,
        io: label, bounds: label, float_trap: label }
}
pub fn build(code: &mut arm.Code, sites: &mut []i32, f: &mut mir.Function, platform: i32, mode: i32) {
    code.platform = platform
    mut entry := arm.label(&mut code); mut external := arm.label(&mut code); second := arm.label(&mut code)
    if mode == 10 { saved := entry; entry = external; external = saved }
    labels := code.labels.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1)
    if mode == 9 { sites.push(code.words.len * 4); arm.emit(&mut code, 0); arm.emit(&mut code, 0) }
    arm.imm(&mut code, 0, 13); arm.store(&mut code, 0, 0)
    for repeat in 0..8 { arm.load(&mut code, 0); arm.store(&mut code, 0, 0) }
    if mode == 1 || mode == 9 || mode == 10 { arm.branch(&mut code, external, 19) }
    if mode == 2 { arm.branch(&mut code, external, 0) }
    if mode == 8 { arm.branch(&mut code, external, 1) }
    if mode == 7 { arm.branch(&mut code, external, 19); arm.branch(&mut code, second, 0) }
    mut last := -1
    if mode >= 3 && mode <= 5 { last = arm.label(&mut code); arm.branch(&mut code, last, 0) }
    arm.load(&mut code, 0); arm.ret(&mut code)
    if mode == 3 { arm.mark(&mut code, last); arm.branch(&mut code, external, 19) }
    if mode == 4 { arm.mark(&mut code, last); arm.emit(&mut code, 3558866944) }
    if mode == 5 { arm.mark(&mut code, last); arm.emit(&mut code, 3592356096 + 8 * 32) }
    if mode == 6 { arm.branch(&mut code, external, 0) }
    assert(lift.lift(&mut f, &code, 0, labels, 0, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
}
