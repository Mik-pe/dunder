fn returned() -> []u8 {
    var values: []u8 = []
    for i in 0..33 { values.push(u8(i)) }
    values
}
fn main() {
    var bytes: []u8 = []
    var halves: []u16 = []
    var words: []u32 = []
    var wide: []u64 = []
    var flags: []bool = []
    var signed: []i64 = []
    assert(bytes.cap() == 0)
    bytes.reserve(0)
    assert(bytes.cap() == 0)
    for i in 0..33 {
        bytes.push(u8(i)); halves.push(u16(i)); words.push(u32(i))
        wide.push(u64(i)); flags.push(i % 2 == 0); signed.push(i64(i) - 16)
    }
    assert(bytes.len == 33 && bytes.cap() == 64)
    assert(halves.cap() == 64 && words.cap() == 64 && wide.cap() == 64)
    assert(flags.cap() == 64 && signed.cap() == 64)
    var byte_copy := bytes
    half_copy := halves; word_copy := words; wide_copy := wide
    flag_copy := flags; signed_copy := signed
    assert(byte_copy.cap() == 33 && half_copy.cap() == 33)
    assert(word_copy.cap() == 33 && wide_copy.cap() == 33)
    for i in 0..33 {
        assert(byte_copy[i] == u8(i) && half_copy[i] == u16(i))
        assert(word_copy[i] == u32(i) && wide_copy[i] == u64(i))
        assert(flag_copy[i] == (i % 2 == 0) && signed_copy[i] == i64(i) - 16)
    }
    byte_copy.push(99)
    assert(byte_copy.len == 34 && byte_copy.cap() == 66)
    assert(bytes.len == 33 && bytes.cap() == 64)
    assert(byte_copy.pop() == 99)
    bytes.reserve(34); assert(bytes.cap() == 64)
    bytes.reserve(65); assert(bytes.cap() == 128 && bytes[32] == 32)
    bytes.clear(); assert(bytes.len == 0 && bytes.cap() == 128)
    bytes.push(42); assert(bytes.pop() == 42 && bytes.cap() == 128)
    result := returned()
    assert(result.len == 33 && result.cap() == 33 && result[32] == 32)

    var texts: []string = []
    for i in 0..33 { texts.push(i.str()) }
    snapshot := texts
    assert(texts.cap() == 64 && snapshot.cap() == 33)
    texts[0] = "replacement"
    texts.clear()
    assert(texts.len == 0 && texts.cap() == 64)
    texts.push("last"); assert(texts.pop() == "last")
    for i in 0..33 { assert(snapshot[i] == i.str()) }

    converted_bytes := "å🌍".bytes()
    converted_runes := "å🌍".runes()
    assert(converted_bytes.len == 6 && converted_bytes[0] == 195)
    assert(converted_runes.len == 2 && i32(converted_runes[1]) == 127757)
    print(42)
}
