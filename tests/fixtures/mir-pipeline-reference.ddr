// Test-only frozen serial reference, never imported by production code.
import ...selfhost.mir
import ...selfhost.mir_verify as verify
import ...selfhost.mir_opt as frame
import ...selfhost.mir_memory as memory
import ...selfhost.mir_value_prop as values
import ...selfhost.mir_pipeline as pipeline
import ...selfhost.mir_terminals as terminals
import ...selfhost.mir_call_abi as call_abi
// Serial reference of the original pass sequence, with the explicit terminal
// observation contract also required by frame promotion after its exit repair.
// Lift/entry ownership and final layout/lowering belong to the caller in both.
pub fn run(f: &mut mir.Function, config: &pipeline.Options, exits: &pipeline.Terminals) -> pipeline.Status {
    var result := pipeline.Status { error: 0, frame_state: 0, value_state: 0, stats: pipeline.stats() }
    var verifier := verify.new_work(); var optimizer := frame.new(); var value_work := values.new()
    if !verify.verify_into(&mut f, &mut verifier) { result.error = 1; return result }
    if !config.optimize { count(&f, &mut result); return result }
    var frame_exits := terminals.no_terminals()
    frame_exits.version = exits.version; frame_exits.overflow = exits.overflow; frame_exits.zero = exits.zero
    frame_exits.assertion = exits.assertion; frame_exits.io = exits.io
    frame_exits.bounds = exits.bounds; frame_exits.float_trap = exits.float_trap
    if !terminals.valid(&frame_exits) { result.error = 6; return result }
    memory_context := memory.for_source_producer(config.source_objects)
    var calls := call_abi.conservative()
    if config.source_abi { calls = call_abi.trusted_source_abi_v1() }
    ready := frame.analyze_with_contracts_budget(&mut optimizer, &f, &memory_context, &frame_exits, &calls, config.frame_budget)
    result.frame_state = frame.status(&optimizer); result.stats.analysis_units = i64(frame.units(&optimizer))
    if ready {
        frame.apply(&mut optimizer, &mut f); result.frame_state = frame.status(&optimizer)
        if !verify.verify_into(&mut f, &mut verifier) { result.error = 2; return result }
        result.stats.optimized = 1; result.stats.promoted = frame.promoted(&optimizer)
        result.stats.removed_loads = frame.removed_loads(&optimizer); result.stats.removed_stores = frame.removed_stores(&optimizer)
        result.stats.private_memory_ops = frame.private_memory_ops(&optimizer)
    } else if result.frame_state == -3 { result.stats.budget_refusals = 1 }
    else if result.frame_state != -2 { result.error = 3; return result }
    if !config.values { count(&f, &mut result); return result }
    var changed := false
    if exits.version == 0 { changed = values.optimize_budget(&mut value_work, &mut f, config.value_budget) }
    else {
        if exits.version != 1 { result.error = 6; return result }
        var context := values.context(1)
        if !values.declare_unobserving_terminal(&mut context, exits.overflow) || !values.declare_unobserving_terminal(&mut context, exits.zero) ||
            !values.declare_unobserving_terminal(&mut context, exits.assertion) || !values.declare_unobserving_terminal(&mut context, exits.io) ||
            !values.declare_unobserving_terminal(&mut context, exits.bounds) || !values.declare_unobserving_terminal(&mut context, exits.float_trap) { result.error = 6; return result }
        changed = values.optimize_with_context_budget(&mut value_work, &mut f, &context, config.value_budget)
    }
    result.stats.value_analysis_units = i64(values.units(&value_work)); result.value_state = values.status(&value_work)
    if changed {
        if !f.verified { result.error = 4; return result }
        result.stats.values_optimized = 1; result.stats.value_rewrites = values.rewritten(&value_work)
        result.stats.value_deleted = values.deleted(&value_work); result.stats.value_immediates = values.constant_immediates(&value_work)
    } else if result.value_state == -3 { result.stats.value_budget_refusals = 1 }
    else if result.value_state != 0 && result.value_state != -2 { result.error = 5 }
    count(&f, &mut result); result
}
fn count(f: &mir.Function, result: &mut pipeline.Status) {
    if result.error != 0 { return }; result.stats.operations = f.order.len
    for op in 0..f.kinds.len { if f.kinds[op] == 0 { result.stats.opaque = result.stats.opaque + 1 } }
}
