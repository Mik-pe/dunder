// An ABI-conforming raw helper preserves X25..28, but may read and mutate
// original caller cells. This observer stress test grants no ordinary source
// or FFI permission to walk saved frame links. ABI1 alone is never NoModRef.
import ...selfhost.arm64 as arm
import ...selfhost.ffi_arm64 as abi
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_opt as opt
import ...selfhost.mir_memory as memory
import ...selfhost.mir_call_abi as calls
import ...selfhost.mir_terminals as terminals
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn number(at: i32) -> i32 { i32(decimal.integer(sys.arg(at)).value) }
fn compare(code: &mut arm.Code, a: i32, b: i32) {
    arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32)
}
fn main() {
    platform := number(2); enabled := sys.arg(4) == "on"; var code := arm.new_for(platform)
    wrapper := arm.label(&mut code); entry := arm.label(&mut code)
    called := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    arm.mark(&mut code, called); helper := arm.prologue(&mut code); arm.frame(&mut code, helper, 0)
    // This helper uses FP only to address an ORIGINAL semantic cell; it never
    // observes call-SP, new reservation/padding, hidden registers or save cells.
    abi.load(&mut code, 10, 29, 0, 8)
    arm.emit(&mut code, 4164943872 + 504 * 4096 + 10 * 32) // LDUR X0,[X10,#-8].
    arm.emit(&mut code, 2432696320 + 1024)
    arm.emit(&mut code, 4160749568 + 504 * 4096 + 10 * 32) // STUR X0,[X10,#-8].
    arm.ret(&mut code)
    first := code.words.len; labels := code.labels.len; relocations := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1)
    arm.imm(&mut code, 0, 13); arm.store(&mut code, 0, 0)
    for repeat in 0..8 { arm.load(&mut code, 0); arm.store(&mut code, 0, 0) }
    arm.branch(&mut code, called, 1)
    for repeat in 0..8 { arm.load(&mut code, 0); arm.store(&mut code, 0, 0) }
    arm.load(&mut code, 0); arm.ret(&mut code)
    var sites: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, first, labels, relocations, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    context := memory.for_source_producer(sys.arg(3) == "source")
    exits := terminals.no_terminals(); call_abi := calls.trusted_source_abi_v1()
    var work := opt.new(); var homes := 0
    if enabled {
        assert(opt.analyze_with_contracts(&mut work, &f, &context, &exits, &call_abi))
        assert(opt.barrier_count(&work) == 1); homes = opt.promoted(&work); assert(homes == 1)
        opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
    }
    var output := lower.new(); assert(lower.prepare(&mut output, &f, &code, &sites))
    lower.commit_code(&mut output, &mut code); lower.commit_imports(&mut output, &mut sites)
    arm.mark(&mut code, wrapper); wrapper_frame := arm.prologue(&mut code); arm.frame(&mut code, wrapper_frame, 0)
    for reg in 25..29 { arm.imm(&mut code, reg, i64(reg) * 111) }
    arm.branch(&mut code, entry, 1); arm.imm(&mut code, 1, 14); compare(&mut code, 0, 1)
    arm.branch(&mut code, assertion, 3)
    for reg in 25..29 {
        arm.imm(&mut code, 0, i64(reg) * 111); compare(&mut code, reg, 0); arm.branch(&mut code, assertion, 3)
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    var image: []u8 = []; none: []i32 = []
    if platform == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if platform == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { bytes := arm.finish(&mut code); if platform == 0 { image = macho.image(&bytes) } else { image = elf.image(&bytes) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print(homes)
}
