// Eligibility probe for the existing compiler analyses through real task
// syntax. This is a fixture, not a second production compiler pipeline.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_opt as frames
import ...selfhost.mir_value_prop as values
import ...selfhost.mir_memory as memory

pub struct Job {
    function: mir.Function, frame_enabled: bool, values_enabled: bool,
    source_objects: bool, budget: i32, terminals: []i32, tag: i32,
}
pub struct Finished {
    function: mir.Function, frame_status: i32, promoted: i32,
    removed_loads: i32, removed_stores: i32, frame_units: i32,
    value_status: i32, rewrites: i32, deleted: i32, value_units: i32,
    tag: i32,
}
fn analyze(job: Job) -> Finished {
    var function := job.function
    // Every opaque workspace and context is task-local. No opaque resource or
    // borrow crosses the typed Job/Finished boundary.
    var verifier := verify.new_work()
    var frame_work := frames.new()
    var value_work := values.new()
    frame_context := memory.for_source_producer(job.source_objects)
    var value_context := values.context(1)
    for label in job.terminals { assert(values.declare_unobserving_terminal(&mut value_context, label)) }
    assert(verify.verify_into(&mut function, &mut verifier))
    if job.frame_enabled && frames.analyze_with_context_budget(&mut frame_work, &function, &frame_context, job.budget) {
        frames.apply(&mut frame_work, &mut function)
        assert(verify.verify_into(&mut function, &mut verifier))
    }
    if job.values_enabled {
        changed := values.optimize_with_context_budget(&mut value_work, &mut function, &value_context, job.budget)
        assert(values.status(&value_work) >= -3)
    }
    assert(verify.verify_into(&mut function, &mut verifier))
    Finished { function: function, frame_status: frames.status(&frame_work),
        promoted: frames.promoted(&frame_work), removed_loads: frames.removed_loads(&frame_work),
        removed_stores: frames.removed_stores(&frame_work), frame_units: frames.units(&frame_work),
        value_status: values.status(&value_work), rewrites: values.rewritten(&value_work),
        deleted: values.deleted(&value_work), value_units: values.units(&value_work), tag: job.tag }
}
fn compare(code: &mut arm.Code, a: i32, b: i32) {
    arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32)
}
fn add(code: &mut arm.Code, dst: i32, a: i32, b: i32) {
    arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst))
}
fn input() -> mir.Function {
    var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    head := arm.label(&mut code); done := arm.label(&mut code)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    compare(&mut code, 1, 0); arm.branch(&mut code, done, 12)
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 0); arm.pop(&mut code, 1)
    add(&mut code, 0, 1, 0); arm.store(&mut code, 1, 0)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
    arm.load(&mut code, 1); arm.ret(&mut code)
    var function := mir.new(); sites: []i32 = []
    assert(lift.lift(&mut function, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut function) && function.optimizable); function
}
fn check(result: &Finished) {
    assert(result.function.verified && result.function.optimizable)
    assert(result.frame_status == 2 && result.promoted > 0)
    assert(result.removed_loads > 0 && result.removed_stores > 0 && result.frame_units > 0)
    assert(result.value_status >= 0 && result.value_units > 0)
}
fn same_i32(a: &[]i32, b: &[]i32) {
    assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) }
}
fn same_i64(a: &[]i64, b: &[]i64) {
    assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) }
}
fn same_bool(a: &[]bool, b: &[]bool) {
    assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) }
}
fn same_function(a: &mir.Function, b: &mir.Function) {
    assert(a.valid == b.valid && a.verified == b.verified && a.optimizable == b.optimizable && a.unknown_control == b.unknown_control)
    assert(a.platform == b.platform && a.first_word == b.first_word && a.first_label == b.first_label && a.first_reloc == b.first_reloc && a.first_import == b.first_import)
    assert(a.source_words == b.source_words && a.source_labels == b.source_labels && a.source_relocs == b.source_relocs && a.source_imports == b.source_imports)
    assert(a.place_probes == b.place_probes && a.visits == b.visits && a.budget_exhausted == b.budget_exhausted)
    same_i32(&a.kinds, &b.kinds); same_i32(&a.opcodes, &b.opcodes)
    same_i32(&a.dst, &b.dst); same_i32(&a.a, &b.a); same_i32(&a.b, &b.b); same_i32(&a.c, &b.c)
    same_i64(&a.imm, &b.imm); same_i32(&a.aux, &b.aux); same_i64(&a.variant, &b.variant)
    same_i32(&a.types, &b.types); same_i32(&a.place, &b.place); same_i32(&a.extensions, &b.extensions)
    same_i32(&a.effects, &b.effects); same_i32(&a.flags, &b.flags); same_i32(&a.abi, &b.abi)
    same_i64(&a.reads, &b.reads); same_i64(&a.writes, &b.writes); same_i64(&a.clobbers, &b.clobbers)
    same_i32(&a.origins, &b.origins); same_i32(&a.raw_starts, &b.raw_starts); same_i32(&a.widths, &b.widths)
    same_i32(&a.modes, &b.modes); same_i32(&a.recipes, &b.recipes); same_i32(&a.targets, &b.targets)
    same_i32(&a.reloc_kinds, &b.reloc_kinds); same_i32(&a.import_ids, &b.import_ids); same_i32(&a.order, &b.order)
    same_i64(&a.raw, &b.raw); same_i32(&a.place_kinds, &b.place_kinds); same_i32(&a.place_offsets, &b.place_offsets)
    same_i32(&a.place_widths, &b.place_widths); same_i32(&a.place_extensions, &b.place_extensions)
    same_bool(&a.place_escaped, &b.place_escaped); same_i32(&a.place_table, &b.place_table)
    same_i32(&a.block_starts, &b.block_starts); same_i32(&a.block_ends, &b.block_ends); same_i32(&a.op_blocks, &b.op_blocks)
    same_i32(&a.edge_from, &b.edge_from); same_i32(&a.edge_to, &b.edge_to); same_i32(&a.edge_kinds, &b.edge_kinds)
    same_i32(&a.edge_starts, &b.edge_starts); same_i32(&a.label_ids, &b.label_ids); same_i32(&a.label_ops, &b.label_ops)
    same_i32(&a.boundaries, &b.boundaries); same_bool(&a.leaders, &b.leaders)
}
fn main() {
    var job := Job { function: input(), frame_enabled: true, values_enabled: true,
        source_objects: false, budget: 4194304, terminals: [], tag: 42 }
    serial := analyze(job); check(&serial)
    task scope jobs(2) {
        first := spawn jobs analyze(job)
        job.tag = 43; second := spawn jobs analyze(job)
        // Inputs are snapshots, and each await is an ordinary value copy.
        job.function.origins[0] = -99
        var result := await jobs(first); check(&result)
        other := await jobs(second); check(&other)
        same_function(&result.function, &serial.function); same_function(&other.function, &serial.function)
        assert(result.tag == 42 && other.tag == 43)
        assert(result.function.origins[0] >= 0 && other.function.origins[0] >= 0)
        assert(result.promoted == serial.promoted && result.rewrites == serial.rewrites && result.deleted == serial.deleted)
        original_kind := result.function.kinds[0]; result.function.kinds[0] = 123
        again := await jobs(first); check(&again)
        same_function(&again.function, &serial.function)
        assert(again.function.kinds[0] == original_kind)
        print(again.promoted); print(again.rewrites); print(again.deleted)
    }
    print(42)
}
