import ...selfhost.fragments as fragments
import ...selfhost.arm64 as arm
import ...selfhost.cache_io as cache_io
import ...selfhost.macho as macho
import ...selfhost.elf as elf
import ...selfhost.x86 as x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as parse
import sys

fn same_dependencies(a:&fragments.Dependencies,b:&fragments.Dependencies){
    assert(a.charged_words==b.charged_words && a.declarations.len==b.declarations.len)
    for i in 0..a.declarations.len{assert(a.declarations[i]==b.declarations[i])}
}
fn same_code(a:&arm.Code,b:&arm.Code){
    assert(a.platform==b.platform && a.checking==b.checking && a.profile==b.profile)
    assert(a.virtual_words==b.virtual_words && a.virtual_labels==b.virtual_labels && a.effect_epoch==b.effect_epoch && a.effect_depth==b.effect_depth)
    assert(a.words.len==b.words.len && a.labels.len==b.labels.len && a.at.len==b.at.len && a.target.len==b.target.len && a.kinds.len==b.kinds.len)
    for i in 0..a.words.len{assert(a.words[i]==b.words[i])}
    for i in 0..a.labels.len{assert(a.labels[i]==b.labels[i])}
    for i in 0..a.at.len{assert(a.at[i]==b.at[i])}
    for i in 0..a.target.len{assert(a.target[i]==b.target[i])}
    for i in 0..a.kinds.len{assert(a.kinds[i]==b.kinds[i])}
}
fn dependencies()->fragments.Dependencies{
    var d:=fragments.new_dependencies()
    assert(fragments.record_dependency(&mut d,9,7))
    assert(fragments.record_dependency(&mut d,2,3))
    assert(fragments.record_dependency(&mut d,5,0))
    assert(fragments.record_dependency(&mut d,9,2))
    assert(fragments.charge_dependency_words(&mut d,11))
    assert(d.declarations.len==3 && d.declarations[0]==2 && d.declarations[1]==5 && d.declarations[2]==9 && d.charged_words==23)
    d
}
fn selected_dependencies(mode:string)->fragments.Dependencies{
    if mode=="builtin"{var d:=fragments.new_dependencies();assert(fragments.charge_dependency_words(&mut d,23));return d}
    if mode=="full"{var d:=fragments.new_dependencies();for i in 0..256{assert(fragments.record_dependency(&mut d,i,16))};return d}
    dependencies()
}
fn units(){
    var d:=fragments.new_dependencies();assert(d.declarations.len==0 && d.charged_words==0)
    assert(fragments.charge_dependency_words(&mut d,4096));assert(d.declarations.len==0)
    before:=d;assert(!fragments.charge_dependency_words(&mut d,1));same_dependencies(&d,&before)
    assert(!fragments.record_dependency(&mut d,1,1));same_dependencies(&d,&before)
    assert(!fragments.record_dependency(&mut d,-1,0));same_dependencies(&d,&before)
    assert(!fragments.record_dependency(&mut d,1,-1));same_dependencies(&d,&before)
    assert(!fragments.charge_dependency_words(&mut d,-1));same_dependencies(&d,&before)
    assert(fragments.record_dependency(&mut d,1,0));assert(d.charged_words==4096)
    fragments.reset_dependencies(&mut d);assert(d.declarations.len==0 && d.charged_words==0)
    for i in 0..256{assert(fragments.record_dependency(&mut d,255-i,1))}
    for i in 0..256{assert(d.declarations[i]==i)}
    full:=d;assert(!fragments.record_dependency(&mut d,256,1));same_dependencies(&d,&full)
    assert(fragments.record_dependency(&mut d,99,3));assert(d.declarations.len==256 && d.charged_words==259)
    d.charged_words=4097;invalid:=d;assert(!fragments.charge_dependency_words(&mut d,0));same_dependencies(&d,&invalid)
    fragments.reset_dependencies(&mut d);d.declarations.push(2);d.declarations.push(1)
    unsorted:=d;assert(!fragments.record_dependency(&mut d,3,1));same_dependencies(&d,&unsorted)
    assert(!fragments.charge_dependency_words(&mut d,1));same_dependencies(&d,&unsorted)
    fragments.reset_dependencies(&mut d);d.charged_words=-1;negative:=d
    assert(!fragments.charge_dependency_words(&mut d,0));same_dependencies(&d,&negative)
    assert(!fragments.record_dependency(&mut d,0,0));same_dependencies(&d,&negative)
    print(42)
}
fn prefix(code:&mut arm.Code,padding:i32){
    entry:=arm.label(&mut code);helper:=arm.label(&mut code);failure:=arm.label(&mut code)
    assert(entry==0 && helper==1 && failure==2)
    arm.branch(&mut code,entry,1);arm.syscall(&mut code,33554433,94);arm.emit(&mut code,3558866944)
    if padding!=0{unused:=arm.label(&mut code);arm.emit(&mut code,3573751839);arm.emit(&mut code,3573751839)}
}
fn body(code:&mut arm.Code){
    arm.mark(&mut code,0);frame:=arm.prologue(&mut code);arm.frame(&mut code,frame,0)
    yes:=arm.label(&mut code);done:=arm.label(&mut code);unused:=arm.label(&mut code)
    arm.imm(&mut code,0,0);arm.branch(&mut code,yes,18)
    arm.imm(&mut code,0,99);arm.branch(&mut code,done,0)
    arm.mark(&mut code,yes);arm.branch(&mut code,1,20);arm.branch(&mut code,1,1)
    arm.mark(&mut code,done);arm.imm(&mut code,2,42);arm.emit(&mut code,3942776863);arm.branch(&mut code,2,3)
    arm.imm(&mut code,0,0);arm.ret(&mut code)
}
fn image(code:&mut arm.Code,path:string){
    arm.mark(&mut code,1);frame:=arm.prologue(&mut code);arm.frame(&mut code,frame,0);arm.imm(&mut code,0,42);arm.ret(&mut code)
    arm.mark(&mut code,2);arm.exit(&mut code,104)
    end:=code.words.len;var output:[]u8=[]
    if code.platform==3{abi:=wa.new();result:=wasm.image(&code,end,0,1,&abi);assert(result.ok);output=result.text}
    else if code.platform==2{empty:[]i32=[];result:=x86.finish(&code,end,&empty,&empty);assert(result.ok);output=elf.image_for(&result.text,62)}
    else{text:=arm.finish(&mut code);if code.platform==0{output=macho.image(&text)}else{output=elf.image(&text)}}
    assert(sys.write_u8(path,&output).ok);assert(sys.make_executable(path).ok)
}
fn main(){
    mode:=sys.arg(1);if mode=="unit"{units();return}
    path:=sys.arg(2);platform:=i32(parse.integer(sys.arg(3)).value);output:=sys.arg(4)
    padding:=i32(parse.integer(sys.arg(5)).value)
    key:=cache_io.digest("generic-fragment-dependencies:"+platform.str())
    var code:=arm.new_for(platform);prefix(&mut code,padding)
    if mode=="generate"{
        begin:=fragments.start(&code);body(&mut code)
        selection:=sys.arg(6);d:=selected_dependencies(selection);var limit:=16;if selection=="full"{limit=256}
        assert(fragments.save_with_dependencies(&code,begin,3,path,key,&d,limit))
        fragments.save(&code,begin,3,path+".native3",key)
        image(&mut code,output);print(42);return
    }
    if mode=="save-invalid"{
        begin:=fragments.start(&code);body(&mut code);var d:=dependencies()
        sentinel:="previous successful fragment";assert(sys.write_text(path,sentinel).ok)
        for bad in 0..8{
            var broken:=d;var wrong:=code
            if bad==0{broken.declarations[1]=broken.declarations[0]}
            if bad==1{broken.declarations[1]=1}
            if bad==2{broken.declarations[0]=-1}
            if bad==3{broken.charged_words=4097}
            if bad==4{broken.declarations[2]=16}
            if bad==5{wrong.words[begin.words]=-1}
            if bad==6{wrong.labels[begin.labels]=code.words.len+1}
            if bad==7{wrong.target[begin.relocations]=99}
            assert(!fragments.save_with_dependencies(&wrong,begin,3,path,key,&broken,16))
            read:=sys.read_text(path);assert(read.ok && read.value==sentinel)
        }
        print(42);return
    }
    limit:=i32(parse.integer(sys.arg(6)).value);budget:=i32(parse.integer(sys.arg(7)).value)
    expected:=sys.arg(8)=="yes"
    var d:=fragments.new_dependencies();assert(fragments.record_dependency(&mut d,99,17))
    var globals:=3;var entry:=0
    var guard:="";if sys.arg_count()>10{guard=sys.arg(10)}
    if guard=="marked"{arm.mark(&mut code,0)}
    if guard=="checking"{code.checking=true}
    if guard=="entry"{entry=99}
    if guard=="globals"{globals=99}
    if guard=="reloc-arrays"{code.target.push(0)}
    before:=code;old:=d;var restored:=false
    if mode=="restore"{restored=fragments.restore_with_dependencies(&mut code,globals,entry,path,key,limit,budget,&mut d)}
    else{assert(mode=="restore-old");restored=fragments.restore(&mut code,3,0,path,key)}
    assert(restored==expected)
    if !restored{same_code(&code,&before);same_dependencies(&d,&old);print(0);return}
    if mode=="restore"{wanted:=selected_dependencies(sys.arg(9));same_dependencies(&d,&wanted)}else{same_dependencies(&d,&old)}
    image(&mut code,output);print(42)
}
