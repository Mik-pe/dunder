capability unsafe, stdio

import std.io as io
import sys

struct ShortWriter { calls: i32 }

impl io.Write for ShortWriter {
    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {
        self.calls += 1
        count := if data.len > 2 { 2 } else { data.len }
        mut n: i64 = 0
        unsafe { n = sys.fd_write(1, &data, 0, i64(count)) }
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        .Ok(i32(n))
    }

    fn flush(&mut self) -> Result<(), sys.IoError> { .Ok }
}

fn main() {
    data: []u8 = [99, 0, 10, 255, 128, 13, 88]
    mut writer := ShortWriter { calls: 0 }
    assert(writer.write_full(&data[1..6]).is_ok())
    assert(writer.calls == 3)
    mut stdout := io.stdout()
    assert(stdout.write_full(&data[2..4]).is_ok())
    unsafe {
        assert(sys.fd_write(1, &data[2..6], 1, 2) == 2)
        assert(sys.fd_write(1, &data, -1, 1) == -22)
        assert(sys.fd_write(1, &data, 1, -1) == -22)
        assert(sys.fd_write(1, &data, 8, 0) == -22)
        assert(sys.fd_write(1, &data, 6, 9223372036854775807) == -22)
        assert(sys.fd_write(-1, &data, 0, 1) == -9)
        assert(sys.fd_write(1, &data, 7, 0) == 0)
    }
}
