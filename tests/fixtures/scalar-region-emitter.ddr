// Exercise the inactive region API in a real legacy frame on every backend.
import ...selfhost.opt_region as region
import ...selfhost.opt_emit as emit
import ...selfhost.arm64 as arm
import ...selfhost.lexer
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn compare(code: &mut arm.Code, left: i32, right: i32) { arm.emit(&mut code, 3942645791 + i64(right) * 65536 + i64(left) * 32) }
fn main() {
    platform := i32(decimal.integer(sys.arg(2)).value); selected := i32(decimal.integer(sys.arg(3)).value)
    var source := "limit sum for i in 0..limit{sum=sum+i}"
    var types: []i32 = [1, 1]; var mutable: []bool = [false, true]
    var initial: []i64 = [5, 10]; var expected: []i64 = [5, 20]
    if selected == 1 {
        source = "n sum while n>0{n=n-1;if n==3{continue};for i in 0..4{if i==1{continue};if i==3{break};sum=sum+n+i};if n==1{break}}"
        mutable[0] = true; initial[0] = 5; initial[1] = 0; expected[0] = 1; expected[1] = 20
    } else if selected == 2 {
        source = "i sum for i in i..i+3{var i:=7;i=i+1;sum=sum+i}"
        mutable[0] = true; initial[0] = 2; initial[1] = 0; expected[0] = 2; expected[1] = 24
    } else if selected == 3 {
        source = "limit sum for i in 0..limit{limit=0;sum=sum+1}"
        mutable[0] = true; initial[1] = 0; expected[0] = 0; expected[1] = 5
    } else if selected >= 4 && selected <= 7 {
        source = "sum for i in 5..3{sum=sum+1}"
        if selected == 5 { source = "sum while false{sum=sum+1}" }
        else if selected == 6 { source = "sum while 1>2{sum=sum+1}" }
        else if selected == 7 { source = "sum while false{}" }
        types = [1]; mutable = [true]; initial = [9]; expected = [9]
        if selected == 7 { initial[0] = 4294967295; expected[0] = -1 }
    } else if selected == 8 || selected == 9 {
        source = "a b for i in a+1..10/b{}"
        if selected == 9 { source = "a b for i in 10/b..a+1{}" }
        mutable = [false, false]; initial = [2147483647, 0]
    } else if selected == 10 || selected == 11 {
        source = "sum den while true{sum=sum+1;sum=sum/den;break}"
        if selected == 11 { source = "sum den while true{sum=sum/den;sum=sum+1;break}" }
        mutable = [true, false]; initial = [2147483647, 0]
    } else if selected == 12 {
        source = "sum while true{sum=sum%(-1);break}"
        types = [2]; mutable = [true]; initial = [-9223372036854775808]; expected = [0]
    } else if selected == 13 {
        source = "flag sum while flag{flag=false;sum=sum+1}"
        types = [3, 1]; mutable = [true, true]; initial = [17, 9]; expected = [0, 10]
    } else if selected == 14 {
        source = "while true{break}"; types = []; mutable = []; initial = []; expected = []
    } else if selected == 15 {
        source = "a b c d e f g h for i in 0..2{"
        for local in 0..16 {
            var name := "a"
            if local % 8 == 1 { name = "b" } else if local % 8 == 2 { name = "c" } else if local % 8 == 3 { name = "d" }
            else if local % 8 == 4 { name = "e" } else if local % 8 == 5 { name = "f" } else if local % 8 == 6 { name = "g" } else if local % 8 == 7 { name = "h" }
            source = source + "var v" + local.str() + ":=" + name + ";"
        }
        source = source + "h=h"
        for local in 0..16 { source = source + "+v" + local.str() }
        source = source + ";a=a+1;b=b+1;c=c+1;d=d+1;e=e+1;f=f+1;g=g+1}"
        types = [1,1,1,1,1,1,1,1]; mutable = [true,true,true,true,true,true,true,true]
        initial = [1,2,3,4,5,6,7,8]; expected = [3,4,5,6,7,8,9,310]
    } else if selected == 16 {
        source = "unused sum for i in 0..3{var later:=(i*12)/3;sum=sum+later}"
        mutable = [true,true]; initial = [73,0]; expected = [73,12]
    } else if selected == 17 {
        source = "limit sum for i in 0..limit{sum=sum+1;if i==2{break}}"
        initial = [8, 10]; expected = [8, 13]
    } else if selected == 18 { source = "while false{}"; types = []; mutable = []; initial = []; expected = [] }
    else if selected < 20 { assert(selected == 0 || selected == 19) }
    else { assert(selected <= 25) }
    t := lexer.scan(source, false); var names: []string = []; var positions: []i32 = []
    for capture in 0..types.len { names.push(t.texts[capture]); positions.push(capture) }
    var r := region.new(); var work := region.workspace()
    assert(region.build_into(&mut r, &mut work, &t, types.len, t.kinds.len - 2, &names, &types, &mutable, &positions, sys.arg(4) == "on"))
    all_slots: []i32 = [37,620,45,92,128,201,300,401]; var slots: []i32 = []
    for capture in 0..types.len { slots.push(all_slots[capture]) }
    if selected == 20 { slots[1] = slots[0]; assert(!region.prepare(&mut work, &r, &slots, 621, platform)); return }
    assert(region.prepare(&mut work, &r, &slots, 621, platform)); required := region.required_slots(&work)
    var code := arm.new_for(platform)
    entry := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, required)
    arm.store(&mut code, 0, 29); arm.emit(&mut code, 2432697321); arm.store(&mut code, 1, 9); arm.store(&mut code, 2, 30); arm.store(&mut code, 3, 18)
    for slot in 4..32 { arm.imm(&mut code, 0, i64(slot) * 100003 + 17); arm.store(&mut code, slot, 0) }
    for reg in 19..29 { arm.imm(&mut code, reg, i64(reg) * 1000003 + 41) }
    for capture in 0..slots.len { arm.imm(&mut code, 0, initial[capture]); arm.store(&mut code, slots[capture], 0) }
    var settings := emit.options(); settings.const_div_enabled = sys.arg(5) == "on"
    begin := code.words.len; first_label := code.labels.len; first_reloc := code.at.len; epoch := code.effect_epoch
    if selected == 19 { slots[0] = 618 } // Prepared placement owns its slot snapshot.
    var accepted := false
    if selected == 21 { accepted = region.emit_prepared(&mut work, &mut code, &r, 622, required, overflow, zero, bounds, &settings) }
    else if selected == 22 { accepted = region.emit_prepared(&mut work, &mut code, &r, 621, required - 1, overflow, zero, bounds, &settings) }
    else if selected == 23 {
        region.reset(&mut r)
        accepted = region.emit_prepared(&mut work, &mut code, &r, 621, required, overflow, zero, bounds, &settings)
    } else if selected == 24 {
        var other := region.new(); var other_work := region.workspace()
        changed := lexer.scan("limit sum for i in 1..limit{sum=sum+i}", false)
        assert(region.build_into(&mut other, &mut other_work, &changed, types.len, changed.kinds.len - 2, &names, &types, &mutable, &positions, true))
        accepted = region.emit_prepared(&mut work, &mut code, &other, 621, required, overflow, zero, bounds, &settings)
    } else if selected == 25 {
        code.platform = (platform + 1) % 4
        accepted = region.emit_prepared(&mut work, &mut code, &r, 621, required, overflow, zero, bounds, &settings)
        code.platform = platform
    } else { accepted = region.emit_prepared(&mut work, &mut code, &r, 621, required, overflow, zero, bounds, &settings) }
    if selected >= 20 {
        assert(!accepted && code.words.len == begin && code.labels.len == first_label && code.at.len == first_reloc && code.effect_epoch == epoch && code.effect_depth == 0)
        return
    }
    assert(accepted && code.effect_epoch == epoch && code.effect_depth == 0)
    actual := code.words.len - begin
    for at in begin..code.words.len { assert(code.words[at] != 2831195133 && code.words[at] != 3596551104 && code.words[at].bit_and(4227858432) != 2483027968) }
    for capture in 0..slots.len { arm.load(&mut code, all_slots[capture]); arm.imm(&mut code, 1, expected[capture]); compare(&mut code, 0, 1); arm.branch(&mut code, assertion, 3) }
    for slot in 4..32 { arm.load(&mut code, slot); arm.imm(&mut code, 1, i64(slot) * 100003 + 17); compare(&mut code, 0, 1); arm.branch(&mut code, assertion, 3) }
    for reg in 19..29 { arm.imm(&mut code, 0, i64(reg) * 1000003 + 41); compare(&mut code, reg, 0); arm.branch(&mut code, assertion, 3) }
    for saved in 0..4 {
        arm.load(&mut code, saved); var reg := 29
        if saved == 1 { arm.emit(&mut code, 2432697314); reg = 2 }
        else if saved == 2 { reg = 30 } else if saved == 3 { reg = 18 }
        compare(&mut code, reg, 0); arm.branch(&mut code, assertion, 3)
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    arm.mark(&mut code, overflow); arm.exit(&mut code, 101)
    arm.mark(&mut code, zero); arm.exit(&mut code, 102)
    arm.mark(&mut code, bounds); arm.exit(&mut code, 103)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    data_start := code.words.len; var image: []u8 = []
    if platform == 3 {
        var abi := wa.new(); result := wasm.image(&code, data_start, entry, 1, &abi); assert(result.ok); image = result.text
    } else if platform == 2 {
        sites: []i32 = []; slots: []i32 = []; result := x86.finish(&code, data_start, &sites, &slots); assert(result.ok); image = elf.image_for(&result.text, 62)
    } else {
        text := arm.finish(&mut code); if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) }
    }
    saved := sys.write_u8(sys.arg(1), &image); assert(saved.ok); executable := sys.make_executable(sys.arg(1)); assert(executable.ok)
    print(actual); print(required); print(region.source_local_count(&r))
}
