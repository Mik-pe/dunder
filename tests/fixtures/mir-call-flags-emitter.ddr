// Raw callee consumes incoming NZCV with CSET before writing any flags.
// "value" runs the actual value pass. "liveness-control" is explicitly a
// TEST-ONLY Compare deletion based on flag liveness, not a production pass.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_liveness as live
import ...selfhost.mir_value_prop as values
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn number(at: i32) -> i32 { result := decimal.integer(sys.arg(at)); assert(result.ok); i32(result.value) }
fn compare(code: &mut arm.Code, a: i32, b: i32) {
    arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32)
}
fn main() {
    target := number(2); indirect := sys.arg(3) == "indirect"; mode := sys.arg(4); equal := number(5) == 1
    var code := arm.new_for(target)
    wrapper := arm.label(&mut code); entry := arm.label(&mut code); callee := arm.label(&mut code)
    integer := arm.label(&mut code); boolean := arm.label(&mut code); text := arm.label(&mut code)
    write := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code)
    assertion := arm.label(&mut code); io := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.exit(&mut code, 0)
    arm.mark(&mut code, callee); helper := arm.prologue(&mut code); arm.frame(&mut code, helper, 0)
    arm.emit(&mut code, 2594113504 + 4096) // CSET X0,EQ, an actual incoming flag observation.
    arm.ret(&mut code)
    first := code.words.len; labels := code.labels.len; relocations := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    if indirect { arm.branch(&mut code, callee, 20); arm.mov(&mut code, 17, 0) }
    arm.emit(&mut code, 2852127712 + 65536 + 1) // MOV X1,X1 makes value-pass work observable.
    compare(&mut code, 4, 5)
    if indirect { arm.emit(&mut code, 3594452992 + 17 * 32) }
    else { arm.branch(&mut code, callee, 1) }
    arm.ret(&mut code)
    var f := mir.new(); var sites: []i32 = []
    assert(lift.lift(&mut f, &code, first, labels, relocations, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    var comparison := -1; var called := -1
    for op in 0..f.kinds.len {
        if f.kinds[op] == 5 { comparison = op }
        if f.kinds[op] == 14 { called = op }
    }
    assert(comparison >= 0 && called >= 0)
    assert(f.reads[called] == -1 && f.writes[called] == 0 && f.clobbers[called] == -1)
    original_flags := f.flags[called]
    var stale := f
    if original_flags == 3 { stale.flags[called] = 2 } else { stale.flags[called] = 3 }
    rejected := !verify.verify(&mut stale); assert(rejected && f.verified)
    var liveness := live.new(); assert(live.analyze_into(&mut liveness, &f, 4194304))
    needed := live.flags_after(&liveness, comparison); var changed := false; var work := values.new()
    if mode == "value" { changed = values.optimize_into(&mut work, &mut f); assert(changed && f.verified) }
    else if mode == "liveness-control" {
        if !needed { f.modes[comparison] = 2; changed = true; assert(verify.verify(&mut f)) }
    } else { assert(mode == "off") }
    assert(live.analyze_into(&mut liveness, &f, 4194304))
    assert(f.reads[called] == -1 && f.writes[called] == 0 && f.clobbers[called] == -1)
    assert(f.flags[called] == original_flags && f.modes[called] == 0)
    print(f.flags[called]); print(needed); print(live.flags_after(&liveness, comparison))
    print(f.modes[comparison] == 2); print(changed); print(values.deleted(&work))
    print(f.reads[called]); print(f.writes[called]); print(f.clobbers[called]); print(f.abi[called])
    print(f.flags[comparison]); print(rejected)
    var output := lower.new(); assert(lower.prepare(&mut output, &f, &code, &sites))
    lower.commit_code(&mut output, &mut code); lower.commit_imports(&mut output, &mut sites)
    arm.mark(&mut code, wrapper); outer := arm.prologue(&mut code); arm.frame(&mut code, outer, 0)
    arm.imm(&mut code, 4, 9); arm.imm(&mut code, 5, 9); arm.imm(&mut code, 6, 10)
    if equal { compare(&mut code, 4, 6) } // Seed the OPPOSITE flag before calling entry.
    else { arm.mov(&mut code, 5, 6); compare(&mut code, 4, 4) }
    arm.branch(&mut code, entry, 1)
    if target == 3 { arm.emit(&mut code, 4227858434) }
    else { arm.imm(&mut code, 8, 0); arm.branch(&mut code, integer, 1) }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    var image: []u8 = []; none: []i32 = []
    if target == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else {
        arm.runtime(&mut code, integer, boolean, text, write, overflow, zero, assertion, io)
        if target == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
        else { bytes := arm.finish(&mut code); if target == 0 { image = macho.image(&bytes) } else { image = elf.image(&bytes) } }
    }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
}
