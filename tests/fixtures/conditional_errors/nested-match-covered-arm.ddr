// error: unreachable match pattern
enum Bit { Zero, One }
enum Bits { Pair(Bit, Bit) }
fn main() {
    pair := Bits.Pair(.One, .Zero)
    value := match pair {
        .Pair(.Zero, _) => 0,
        .Pair(.One, .One) => 1,
        .Pair(_, .One) => 2,
        .Pair(.One, .Zero) => 3,
    }
    print(value)
}
