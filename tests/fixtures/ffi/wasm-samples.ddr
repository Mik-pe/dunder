capability unsafe

@repr(C) struct HostSlot { call: extern "C" fn(i32) -> i32 }
@repr(C) struct SampleSlot { call: extern "C" fn(i16) -> i16 }

extern "C" fn read_sample(value: i16) -> i16 {
    assert(i64(value) == -32768)
    -1
}

extern "C" fn supply_word(value: i32) -> i32 {
    assert(value == 32767)
    0x56788000
}

unsafe fn call_as_sample(slot: &SampleSlot) -> i16 { slot.call(32767) }
unsafe fn call_as_host(slot: &HostSlot) -> i32 { slot.call(0x12348000) }

fn main() {
    unsafe {
        host := HostSlot { call: supply_word }
        guest := SampleSlot { call: read_sample }
        match addr_of(&guest).cast<HostSlot>().as_ref(&guest) {
            .Some(h) => { assert(call_as_host(h) == -1) },
            .None => { assert(false) },
        }
        match addr_of(&host).cast<SampleSlot>().as_ref(&host) {
            .Some(s) => { print(i32(call_as_sample(s))) },
            .None => { assert(false) },
        }
    }
}
