capability unsafe

@c_layout struct HostSlot { call: extern fn(i32) -> i32 }
@c_layout struct SampleSlot { call: extern fn(i16) -> i16 }

fn read_sample(value: i16) -> i16 {
    assert(i64(value) == -32768)
    -1
}

fn supply_word(value: i32) -> i32 {
    assert(value == 32767)
    0x56788000
}

unsafe fn call_as_sample(slot: &SampleSlot) -> i16 { slot.call(32767) }
unsafe fn call_as_host(slot: &HostSlot) -> i32 { slot.call(0x12348000) }

fn main() {
    unsafe {
        host := HostSlot { call: callback(supply_word) }
        guest := SampleSlot { call: callback(read_sample) }
        assert(call_as_host(ref_at(addr(&guest))) == -1)
        print(i32(call_as_sample(ref_at(addr(&host)))))
    }
}
