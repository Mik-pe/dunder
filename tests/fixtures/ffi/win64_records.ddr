capability unsafe

@repr(C) struct Point { x: i32, y: i32 }
@repr(C) struct Pair { x: f64, y: f64 }

@link("win64_records.dll")
extern "C" {
    fn rotate(p: Point) -> Point
    fn combine(a: Pair, k: i32, p: Point, b: Pair, q: Point) -> Pair
    fn sum(first: f64, ...) -> f64
}

fn main() {
    p := Point { x: 12, y: -7 }
    a := Pair { x: 0.5, y: 2.25 }
    unsafe {
        q := rotate(p)
        assert(q.x == -7 && q.y == 12)
        b := combine(a, 4, p, a, q)
        assert(b.x == 6.75 && b.y == -14.0)
        assert(sum(0.25, 1.5, 4.0) == 5.75)
    }
    print("Win64 records ok")
}
