capability unsafe

@extern("c", "qsort")
unsafe fn sort(base: ptr, count: usize, width: usize, compare: extern fn(ptr, ptr) -> i32)

fn compare_values(left: &i32, right: &i32) -> i32 {
    if left < right { return -1 }
    if left > right { return 1 }
    0
}

fn compare(a: ptr, b: ptr) -> i32 { unsafe { compare_values(ref_at(a), ref_at(b)) } }

fn mixed(a: i32, b: f64, c: u16, d: f32, e: i32, f: f64) -> f64 {
    assert(a == -3 && b == 0.5 && c == 65532 && d == 2.25 && e == -17)
    f + b
}

fn main() {
    mut values: []i32 = [7, -4, 2]
    unsafe {
        sort(addr(&mut values[0]), usize(values.len), size_of(i32), callback(compare))
        call := callback(mixed)
        assert(call(-3, 0.5, 65532, 2.25, -17, 41.75) == 42.25)
    }
    assert(values[0] == -4 && values[1] == 2 && values[2] == 7)
    print("Win64 callbacks ok")
}
