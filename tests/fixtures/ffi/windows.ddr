capability unsafe
import std.dl as dl
import sys

@link("c")
extern "C" {
    @link_name("qsort")
    fn sort(base: ptr, count: usize, width: usize, compare: extern "C" fn(*const i32, *const i32) -> i32)
}

extern "C" fn compare(a: *const i32, b: *const i32) -> i32 {
    unsafe {
        left := a.read()
        right := b.read()
        if left < right { return -1 }
        if left > right { return 1 }
    }
    0
}

extern "C" fn mixed(a: i32, b: f64, c: u16, d: f32, e: i32, f: f64) -> f64 {
    assert(a == -3 && b == 0.5 && c == 65532 && d == 2.25 && e == -17)
    f + b
}

unsafe fn check_loader() {
    image := dl.open(ptr(0), 1)
    assert(usize(image) != 0 && dl.close(image) == 0)
    handle := dl.open(ptr(c"kernel32.dll".as_ptr()), 2)
    assert(usize(handle) != 0)
    symbol := dl.symbol(handle, ptr(c"GetCurrentProcessId".as_ptr()))
    assert(usize(symbol) != 0)
    pid: extern "C" fn() -> u32 = ffi_fn(symbol)
    assert(pid() != 0)
    assert(usize(dl.symbol(handle, ptr(c"dunder_missing_export".as_ptr()))) == 0)
    assert(dl.close(handle) == 0)
    invalid: []u8 = [255, 0]
    assert(usize(dl.open(addr(&invalid[0]), 1)) == 0)
}

fn main() {
    assert(sys.arg_count() == 4 && sys.arg(0).len > 0)
    assert(sys.arg(1) == "sök väg" && sys.arg(2) == "" && sys.arg(3) == "🦔")
    unsafe { assert(usize(load_ptr(sys.envp())) != 0) }
    mut values: []i32 = [7, -4, 2]
    unsafe {
        check_loader()
        sort(addr(&mut values[0]), usize(values.len), size_of(i32), compare)
        call := mixed
        assert(call(-3, 0.5, 65532, 2.25, -17, 41.75) == 42.25)
    }
    assert(values[0] == -4 && values[1] == 2 && values[2] == 7)
    print("Win64 callbacks ok")
}
