capability unsafe
import std.dl
@extern("c", "abs") unsafe fn abs(x: i32) -> i32
@extern("@LIB@", "mixed") unsafe fn mixed(a: i64, f: f64, b: i32, g: f32, c: u8, d: i64, e: i32, h: i64, i: i32, j: i64, k: u8, l: u16, m: f32, n: f64, o: f32, p: f64, q: f32, r: f64, s: f32, t: f64, u: u32) -> f64
@extern("@LIB@", "triple") unsafe fn rotate(v: Triple) -> Triple
@c_layout struct Triple { a: f32, b: f32, c: f32 }
@c_layout struct Pair { a: f64, b: f64 }
@c_layout struct Rect { origin: Pair, size: Pair }
@extern("@LIB@", "rect") unsafe fn rect(x: Rect, step: f64, y: Rect) -> Rect
@extern("@LIB@", "invoke") unsafe fn invoke(f: extern fn(i32, f64, i32, i32, i32, i32, i32, i32, u16, i32) -> i32) -> i32
@extern("@LIB@", "invoke_inner") unsafe fn invoke_inner(f: extern fn(i32)->i32, x: i32)->i32
fn inner(x: i32)->i32 { x + 1 }
@extern("@LIB@", "call_samples")
unsafe fn call_samples(f: extern fn(i16,i16,i16,i16,i16,i16,i16,i16,i16)->i16,
                       lo: i16, hi: i16, a: i16, b: i16, c: i16, d: i16, e: i16, f2: i16, last: i16)->i16
fn observe_samples(hi: i16, a: i16, b: i16, c: i16, d: i16, e: i16, f: i16, last: i16, lo: i16) -> i16 {
    assert(i64(hi) == 32767 && i64(lo) == -32768)
    assert(i32(a) == -2 && i32(b) == 3 && i32(c) == -4 && i32(d) == 5)
    assert(i32(e) == -6 && i32(f) == 7 && i32(last) == -8)
    lo
}
unsafe fn observe(a: i32, x: f64, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: u16, i: i32) -> i32 {
    assert(x == 2.5)
    assert(h == 65000)
    assert(a + b + c + d + e + f + g + i == 16)
    s := "callback" + b.str()
    assert(s.len == 10)
    assert(invoke_inner(callback(inner), i) == -9)
    return abs(i)
}
@extern("/missing/unreachable", "never") unsafe fn never()
@c_layout struct Small { byte: u8, short_value: u16 }
@c_layout struct Packet { lead: u8, pair: Small, buffer: [u8;3], length: usize, data: ptr, stamp: u64 }
@c_layout struct Api { first: extern fn(ptr)->u32 }
@extern("@LIB@", "inspect_packet") unsafe fn inspect_packet(p: ptr, size: usize, alignment: usize)->usize
@extern("@LIB@", "first_nibble") unsafe fn first_nibble(p: ptr)->u32
fn packet_length(packet: &Packet) -> usize { packet.length }
unsafe fn rotated_value(stop: bool) -> i32 {
    rotate_fn := rotate
    v := rotate_fn(if stop { return 7 } else { Triple { a: 1.5, b: 2.5, c: 3.5 } })
    assert(v.a == 2.5 && v.b == 3.5 && v.c == 1.5)
    8
}
@c_layout struct Tile { tag: u8, rgba: [u8; 262144], stamp: u32 }
@c_layout struct Planes { first: [u16; 20000], second: [u32; 10000], tail: u64 }
@extern("@LIB@", "tile_layout") unsafe fn tile_layout(p: ptr, size: usize, alignment: usize, pixels: usize, stamp: usize) -> i32
@extern("@LIB@", "planes_layout") unsafe fn planes_layout(p: ptr, size: usize, alignment: usize, second: usize, tail: usize) -> i32
@extern("@LIB@", "sum_bytes") unsafe fn sum_bytes(data: ptr, length: usize) -> usize
@extern("@LIB@", "copy_bytes") unsafe fn copy_bytes(data: ptr, length: usize) -> ptr
@extern("@LIB@", "release_bytes") unsafe fn release_bytes(owned: ptr)

@extern("@LIB@", "wide_counts") unsafe fn wide_counts(count: usize, distance: i64) -> i32

fn sum(bytes: &[]u8) -> usize {
    unsafe {
        if bytes.len == 0 { return sum_bytes(ptr(0), usize(0)) }
        return sum_bytes(addr(&bytes[0]), usize(bytes.len))
    }
}

fn foreign_copy() -> ptr {
    bytes: []u8 = [3, 5, 7]
    unsafe { return copy_bytes(addr(&bytes[0]), usize(bytes.len)) }
}

@c_layout struct Samples { tag: u8, samples: [Triple; 2], tail: u64 }
@extern("@LIB@", "inspect_samples") unsafe fn inspect_samples(s: ptr, values: ptr, size: usize, alignment: usize) -> i32

unsafe fn layouts() {
    mut points := [Triple { a: 1, b: 2, c: 3 }, Triple { a: 4, b: 5, c: 6 }]
    mut batch := Samples { tag: 7, samples: points.clone(), tail: 99 }
    assert(usize(addr(&points[1])) - usize(addr(&points[0])) == size_of(Triple))
    assert(inspect_samples(addr(&mut batch), addr(&mut points[0]), size_of(Samples), align_of(Samples)) == 1)
    assert(batch.samples[1].b == 42 && points[1].c == 77)
    assert(points[1].b == 5 && batch.samples[1].c == 6)

    mut tile: Tile = zeroed()
    tile.rgba = [2; 262144]
    assert(tile.rgba[65536] == 2)
    tile.rgba[262143] = 17
    tile.stamp = 111
    t := addr(&mut tile)
    assert(tile_layout(t, size_of(Tile), align_of(Tile), usize(addr(&tile.rgba[0])) - usize(t), usize(addr(&tile.stamp)) - usize(t)) == 1)
    assert(tile.rgba[0] == 23)
    mut planes: Planes = zeroed()
    planes.first[19999] = 999
    planes.tail = 88
    p := addr(&mut planes)
    assert(planes_layout(p, size_of(Planes), align_of(Planes), usize(addr(&planes.second[0])) - usize(p), usize(addr(&planes.tail)) - usize(p)) == 1)
    assert(planes.second[9999] == 777)
}

fn main() {
    empty: []u8 = []
    data: []u8 = [4, 6]
    assert(sum(&empty) == usize(0) && sum(&data) == usize(10))
    unsafe {
        layouts()
        assert(wide_counts(usize(2147483652), -1) == 1)
        copy := foreign_copy()
        assert(usize(copy) != usize(0) && sum_bytes(copy, usize(3)) == usize(15))
        release_bytes(copy)
    }
    unsafe {
        mut packet: Packet = zeroed()
        packet.lead = 250
        packet.pair.byte = 18
        packet.pair.short_value = 61520
        packet.buffer[0] = 1
        packet.buffer[2] = 27
        packet.length = 6
        packet.data = cstr("dunder")
        packet.stamp = 18364758544493064720
        p := addr(&mut packet)
        offset := usize(addr(&packet.stamp)) - usize(p)
        assert(inspect_packet(p, size_of(Packet), align_of(Packet)) == offset)
        assert(packet.pair.short_value == 57777)
        assert(packet_length(ref_at(p)) == 6)
        mut api: Api = zeroed()
        api.first = first_nibble
        assert(api.first(addr(&packet.lead)) == 10)
        library := dl.open(cstr("@LIB@"), 1)
        assert(usize(library) != 0)
        symbol := dl.symbol(library, cstr("first_nibble"))
        assert(usize(symbol) != 0)
        api.first = ffi_fn(symbol)
        assert(api.first(addr(&packet.pair.byte)) == 2)
        assert(dl.close(library) == 0)
        assert(abs(-8) == 8)
        f := mixed
        result := f(-1, 2.5, -3, 4.5, 250, 6, -7, 8, -9, 10, 244, 65000,
                    13.5, 14.5, 15.5, 16.5, 17.5, 18.5, 19.5, 20.5, 4000000000)
        assert(result == 42.25)
        v := rotate(Triple { a: 1.5, b: 2.5, c: 3.5 })
        assert(v.a == 2.5 && v.b == 3.5 && v.c == 1.5)
        for i in 0..256 {
            assert(rotated_value(true) == 7)
            assert(rotated_value(false) == 8)
        }
        x := Rect { origin: Pair { a: 1.0, b: 2.0 }, size: Pair { a: 3.0, b: 4.0 } }
        y := Rect { origin: Pair { a: 5.0, b: 6.0 }, size: Pair { a: 7.0, b: 8.0 } }
        out := rect(x, 0.25, y)
        assert(out.origin.a == 2.25 && out.origin.b == 5.0 && out.size.a == 4.0 && out.size.b == 7.0)
        assert(invoke(callback(observe)) == 20)
        assert(i64(call_samples(callback(observe_samples), -32768, 32767, -2, 3, -4, 5, -6, 7, -8)) == -32768)
    }
    print("native ABI ok")
}
