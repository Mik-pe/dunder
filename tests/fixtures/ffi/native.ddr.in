capability unsafe
import std.dl
@extern("c", "abs") unsafe fn abs(x: i32) -> i32
@extern("@LIB@", "mixed") unsafe fn mixed(a: i64, f: f64, b: i32, g: f32, c: u8, d: i64, e: i32, h: i64, i: i32, j: i64, k: u8, l: u16, m: f32, n: f64, o: f32, p: f64, q: f32, r: f64, s: f32, t: f64, u: u32) -> f64
@extern("@LIB@", "triple") unsafe fn rotate(v: Triple) -> Triple
@c_layout struct Triple { a: f32, b: f32, c: f32 }
@c_layout struct Pair { a: f64, b: f64 }
@c_layout struct Rect { origin: Pair, size: Pair }
@extern("@LIB@", "rect") unsafe fn rect(x: Rect, step: f64, y: Rect) -> Rect
@extern("@LIB@", "invoke") unsafe fn invoke(f: extern fn(i32, f64, i32, i32, i32, i32, i32, i32, u16, i32) -> i32) -> i32
@extern("@LIB@", "invoke_inner") unsafe fn invoke_inner(f: extern fn(i32)->i32, x: i32)->i32
fn inner(x: i32)->i32 { x + 1 }
unsafe fn observe(a: i32, x: f64, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: u16, i: i32) -> i32 {
    assert(x == 2.5)
    assert(h == 65000)
    assert(a + b + c + d + e + f + g + i == 16)
    s := "callback" + b.str()
    assert(s.len == 10)
    assert(invoke_inner(callback(inner), i) == -9)
    return abs(i)
}
@extern("/missing/unreachable", "never") unsafe fn never()
@c_layout struct Small { byte: u8, short_value: u16 }
@c_layout struct Packet { lead: u8, pair: Small, buffer: [u8;3], length: usize, data: ptr, stamp: u64 }
@c_layout struct Api { first: extern fn(ptr)->u32 }
@extern("@LIB@", "inspect_packet") unsafe fn inspect_packet(p: ptr, size: usize, alignment: usize)->usize
@extern("@LIB@", "first_nibble") unsafe fn first_nibble(p: ptr)->u32
fn packet_length(packet: &Packet) -> usize { packet.length }
fn main() {
    unsafe {
        var packet: Packet = zeroed()
        packet.lead = 250
        packet.pair.byte = 18
        packet.pair.short_value = 61520
        packet.buffer[0] = 1
        packet.buffer[2] = 27
        packet.length = 6
        packet.data = cstr("dunder")
        packet.stamp = 18364758544493064720
        p := addr(&mut packet)
        offset := usize(addr(&packet.stamp)) - usize(p)
        assert(inspect_packet(p, size_of(Packet), align_of(Packet)) == offset)
        assert(packet.pair.short_value == 57777)
        assert(packet_length(ref_at(p)) == 6)
        var api: Api = zeroed()
        api.first = first_nibble
        assert(api.first(addr(&packet.lead)) == 10)
        library := dl.open(cstr("@LIB@"), 1)
        assert(usize(library) != 0)
        symbol := dl.symbol(library, cstr("first_nibble"))
        assert(usize(symbol) != 0)
        api.first = ffi_fn(symbol)
        assert(api.first(addr(&packet.pair.byte)) == 2)
        assert(dl.close(library) == 0)
        assert(abs(-8) == 8)
        f := mixed
        result := f(-1, 2.5, -3, 4.5, 250, 6, -7, 8, -9, 10, 244, 65000,
                    13.5, 14.5, 15.5, 16.5, 17.5, 18.5, 19.5, 20.5, 4000000000)
        assert(result == 42.25)
        v := rotate(Triple { a: 1.5, b: 2.5, c: 3.5 })
        assert(v.a == 2.5 && v.b == 3.5 && v.c == 1.5)
        x := Rect { origin: Pair { a: 1.0, b: 2.0 }, size: Pair { a: 3.0, b: 4.0 } }
        y := Rect { origin: Pair { a: 5.0, b: 6.0 }, size: Pair { a: 7.0, b: 8.0 } }
        out := rect(x, 0.25, y)
        assert(out.origin.a == 2.25 && out.origin.b == 5.0 && out.size.a == 4.0 && out.size.b == 7.0)
        assert(invoke(callback(observe)) == 20)
    }
    print("native ABI ok")
}
