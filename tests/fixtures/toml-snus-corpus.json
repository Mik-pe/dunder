      "name": "ci/minimal-defaults",
      "text": "version = 1\n[[job]]\nid = \"test\"\n[[job.step]]\nrun = \"true\"\n",
      "workflow_valid": true,
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"job\":[{\"id\":\"test\",\"step\":[{\"run\":\"true\"}]}]}"
    },
    {
      "name": "ci/repository-definition",
      "text": "# The pinned runner image provisions V and Bun, including frontend dependencies.\nversion = 1\n\n[[job]]\nid = \"build-and-test\"\ntimeout_seconds = 1200\nenvironment = { os = \"linux\" }\n\n  [[job.step]]\n  name = \"native-dependencies\"\n  run = \"bun run setup:native\"\n\n  [[job.step]]\n  name = \"web-install\"\n  run = \"cd web && bun install --frozen-lockfile --offline --ignore-scripts\"\n\n  [[job.step]]\n  name = \"frontend-build\"\n  run = \"bun run build:web\"\n  artifacts = [\"web/dist/**\"]\n\n  [[job.step]]\n  name = \"v-build\"\n  run = \"bun run build:tcc\"\n  artifacts = [\"build/snus\"]\n\n  [[job.step]]\n  name = \"integration-and-typescript\"\n  run = \"bun run test\"\n\n  [[job.step]]\n  name = \"native-v-unit-tests\"\n  run = \"bun run test:v\"\n\n  [[job.step]]\n  name = \"optimized-build\"\n  run = \"bun run build\"\n\n  [[job.step]]\n  name = \"optimized-integration\"\n  run = \"bun test ./tests\"\n",
      "workflow_valid": true,
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"job\":[{\"id\":\"build-and-test\",\"timeout_seconds\":1200,\"environment\":{\"os\":\"linux\"},\"step\":[{\"name\":\"native-dependencies\",\"run\":\"bun run setup:native\"},{\"name\":\"web-install\",\"run\":\"cd web && bun install --frozen-lockfile --offline --ignore-scripts\"},{\"name\":\"frontend-build\",\"run\":\"bun run build:web\",\"artifacts\":[\"web/dist/**\"]},{\"name\":\"v-build\",\"run\":\"bun run build:tcc\",\"artifacts\":[\"build/snus\"]},{\"name\":\"integration-and-typescript\",\"run\":\"bun run test\"},{\"name\":\"native-v-unit-tests\",\"run\":\"bun run test:v\"},{\"name\":\"optimized-build\",\"run\":\"bun run build\"},{\"name\":\"optimized-integration\",\"run\":\"bun test ./tests\"}]}]}"
    },
    {
      "name": "ci/layered-env",
      "text": "version = 1\n[env]\nZ = \"workflow\"\nA = \"one\"\n[[job]]\nid = \"check\"\nworking_dir = \"sub dir\"\ntimeout_seconds = 1200\nenv = { Z = \"job\" }\nenvironment = { os = \"macos\", arch = \"aarch64\", toolchain = \"v-0.5\" }\n[[job.step]]\nname = \"fmt\"\nrun = \"echo 'done'\"\nenv = { A = \"step\", QUOTED = \"'\\\" café\\nline\\tend\" }\nartifacts = [\"reports/**\", \"[a-z]*.txt\"]\n[[job.step]]\nrun = '''echo multiline\nprintf '%s\\n' \"$Z\"\n'''\nworking_dir = \"\"\ntimeout_seconds = 50\ncontinue_on_error = true\n",
      "workflow_valid": true,
      "parse_ok": true,
      "expected_json": "{\"version\":1,\"env\":{\"Z\":\"workflow\",\"A\":\"one\"},\"job\":[{\"id\":\"check\",\"working_dir\":\"sub dir\",\"timeout_seconds\":1200,\"env\":{\"Z\":\"job\"},\"environment\":{\"os\":\"macos\",\"arch\":\"aarch64\",\"toolchain\":\"v-0.5\"},\"step\":[{\"name\":\"fmt\",\"run\":\"echo 'done'\",\"env\":{\"A\":\"step\",\"QUOTED\":\"'\\\" café\\nline\\tend\"},\"artifacts\":[\"reports/**\",\"[a-z]*.txt\"]},{\"run\":\"echo multiline\\nprintf '%s\\\\n' \\\"$Z\\\"\\n\",\"working_dir\":\"\",\"timeout_seconds\":50,\"continue_on_error\":true}]}]}"
    },
