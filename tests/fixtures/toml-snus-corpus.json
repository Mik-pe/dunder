    {
      "name": "repository/examples/agent-bridge.toml",
      "text": "# Kopiera till agentdatorn och anpassa sökvägarna. Installera och autentisera\n# verktygen separat. Inga hemligheter hör hemma i den här filen.\nmachine_id = \"mac-1\"\nmax_timeout_seconds = 3600\n# Hur många parallella agenter datorn erbjuder per körbana (tasks, review,\n# CI-reparation). 1–16, standard 1. Fristående workflow-steg körs fortsatt ett\n# i taget per arbetsyta eftersom de delar utcheckningskatalogen.\nconcurrency = 1\n# Task-arbete sparas privat tills servern har bekräftat resultatet. Katalogen\n# måste ligga utanför arbetsytorna. Saknas den skapas den med mode 0700.\n# recovery_dir = \"/Users/your-user/.local/state/snus/recovery\"\n\n[workspaces]\nsnus = \"/Users/your-user/dev/snus-agent\"\n\n# Hela uppdraget lämnas på stdin. Verktygets lokala behörigheter gäller.\n[adapters.codex]\nprogram = \"codex\"\nargs = [\"exec\", \"--sandbox\", \"workspace-write\", \"-\"]\n# Sätt true för att uttryckligen tillåta kodning i privata task-utcheckningar.\n# Generiska workflows och reviews behöver ingen sådan behörighet.\ntask_capable = false\n# Sätt true för att tillåta CI-reparation i privata återhämtningskataloger.\nrepair_capable = false\n\n# Antigravity Desktop och headless-CLI:n agy installeras separat.\n# Plan-läge passar granskning. Befintliga lokala rättigheter gäller.\n[adapters.antigravity]\nprogram = \"agy\"\nargs = [\"--mode\", \"plan\", \"--disable-slash-commands\", \"--output-format\", \"text\", \"-p\", \"{prompt}\"]\n\n[adapters.claude]\nprogram = \"claude\"\nargs = [\"-p\"]\n\n# OpenCode läser hela uppdraget från stdin utan prompt i processargument.\n[adapters.opencode]\nprogram = \"opencode\"\nargs = [\"run\"]\n\n# Fler verktyg kan läggas till med ett dokumenterat icke-interaktivt kommando\n# eller en lokal V-/TypeScript-brygga som läser stdin och skriver resultatet\n# till stdout. Lägg endast till profiler som datorn faktiskt kan köra.\n",
      "parse_ok": true,
      "expected_json": "{\"machine_id\":\"mac-1\",\"max_timeout_seconds\":3600,\"concurrency\":1,\"workspaces\":{\"snus\":\"/Users/your-user/dev/snus-agent\"},\"adapters\":{\"codex\":{\"program\":\"codex\",\"args\":[\"exec\",\"--sandbox\",\"workspace-write\",\"-\"],\"task_capable\":false,\"repair_capable\":false},\"antigravity\":{\"program\":\"agy\",\"args\":[\"--mode\",\"plan\",\"--disable-slash-commands\",\"--output-format\",\"text\",\"-p\",\"{prompt}\"]},\"claude\":{\"program\":\"claude\",\"args\":[\"-p\"]},\"opencode\":{\"program\":\"opencode\",\"args\":[\"run\"]}}}"
    },
    {
      "name": "repository/snus-ci.toml",
      "text": "# CI runs on the macOS runner using its installed V and Bun tools.\nversion = 1\n\n[env]\nBUN_INSTALL_CACHE_DIR = \"/var/tmp/snus-bun-cache\"\n\n[[job]]\nid = \"build-and-test\"\ntimeout_seconds = 300\nenvironment = { os = \"macos\", arch = \"aarch64\", toolchain = \"snus-macos-v-8636a8f-bun-1.4.4\" }\n\n  [[job.step]]\n  name = \"system-toolchain\"\n  run = \"v version | grep -F 'V 0.5.2 8636a8f' && test \\\"$(bun --version)\\\" = 1.4.4\"\n\n  [[job.step]]\n  name = \"native-dependencies\"\n  run = \"bun run setup:native\"\n\n  [[job.step]]\n  name = \"web-install\"\n  run = \"cd web && bun install --frozen-lockfile --ignore-scripts\"\n\n  [[job.step]]\n  name = \"frontend-build\"\n  run = \"bun run build:web && tar -cf web/web-build.tar -C web/dist .\"\n  artifacts = [\"web/web-build.tar\"]\n\n  [[job.step]]\n  name = \"v-build\"\n  run = \"bun run build:dev\"\n\n  [[job.step]]\n  name = \"verification-tests\"\n  run = \"bun run test:ci\"\n\n  [[job.step]]\n  name = \"package-verified-binaries\"\n  run = \"tar -cf build/snus-ci.tar -C build snus snus-migrate snus-resources\"\n  artifacts = [\"build/snus-ci.tar\"]\n",
      "parse_ok": true,
