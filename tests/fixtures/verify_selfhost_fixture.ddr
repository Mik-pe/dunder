capability filesystem
import .interpolation.api as api
import "./compiler-session" as session
import ...selfhost.driver.driver
import ...selfhost.frontend.compile as compiler
import sys

fn callback_compile(session_arg: &mut compiler.Session, platform: i32, starts: &[]i32, files: &[]i32,
    checking: bool, report: bool, records: &mut compiler.Bindings, directory: string, identity: string,
    config: &compiler.Configuration) -> compiler.Result {
    assert(sys.write_text("callback.txt", config.workers.str() + "\n" + checking.str() + "\n" + report.str() + "\n" + directory + "\n" + identity + "\n").ok)
    compiler.compile_loaded(&mut session_arg, platform, &starts, &files, checking, report, &mut records, directory, identity, &config)
}

fn basename(path: string) -> string {
    mut last := -1
    for i in 0..path.len {
        if path[i] == 47 { last = i }
    }
    if last < 0 { path.clone() } else { path[(last + 1)..path.len] }
}

fn main() -> i32 {
    name := basename(sys.arg(0))
    if name == "api-consumer" { return api.run() }
    if name == "session-consumer" { session.run(); return 0 }
    if name == "callback-entry-0" { return driver.build_using(0, 4, true, callback_compile) }
    if name == "callback-entry-1" { return driver.build_using(1, 4, true, callback_compile) }
    if name == "callback-entry-2" { return driver.build_using(2, 4, true, callback_compile) }
    print("unknown verify_selfhost_fixture mode: " + name)
    2
}
