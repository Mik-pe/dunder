// Test-only adapter around the SAME public Frame+Expr SSA coordinator used by
// production integration. There is one allocator, undo and final verifier.
import ...selfhost.mir
import ...selfhost.mir_expr_stack as stack
import ...selfhost.mir_ssa as ssa
import ...selfhost.mir_memory as memory
import ...selfhost.mir_call_abi as abi
import ...selfhost.mir_call_inputs as inputs
import ...selfhost.mir_terminals as terms

pub struct Result {
    changed: bool, status: i32, units: i32, placed: i32, pushes: i32, pops: i32, copies: i32,
    loads: i32, stores: i32, captures: i32,
}
pub fn run(f: &mut mir.Function, storage: bool, frame_lifetime: bool, exits: &terms.TerminalContext, limit: i32) -> Result {
    var w := ssa.new(); calls := inputs.conservative(); mem := memory.conservative(); var frame := abi.conservative(); var changed := false
    if frame_lifetime { frame=abi.trusted_frame_lifetime_v1() }
    if storage {
        context := stack.trusted_source_expression_storage_v1()
        changed = ssa.optimize_values_with_contracts_budget(&mut w, &mut f, &mem, &exits, &calls, &frame, &context, limit)
    } else {
        context := stack.conservative()
        changed = ssa.optimize_values_with_contracts_budget(&mut w, &mut f, &mem, &exits, &calls, &frame, &context, limit)
    }
    Result { changed: changed, status: ssa.status(&w), units: ssa.units(&w), placed: ssa.stack_groups(&w),
        pushes: ssa.removed_pushes(&w), pops: ssa.removed_pops(&w), copies: ssa.copies(&w),
        loads: ssa.removed_loads(&w), stores: ssa.removed_stores(&w), captures: ssa.captures(&w) }
}
