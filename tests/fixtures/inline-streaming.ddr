fn total(text: string) -> i64 {
    var result: i64 = 0
    for scalar in text.runes() { result = result + i64(scalar) }
    result
}
fn first(text: string) -> rune {
    for scalar in text.runes() { return scalar }
    `?`
}
fn main() {
    var source := "Aå\0🌍B"
    var count := 0; var folded: i64 = 0
    for scalar in source.runes() {
        source = "changed"
        count = count + 1
        if scalar == `å` { continue }
        folded = folded + i64(scalar)
        if scalar == `🌍` { break }
    }
    assert(count == 4 && folded == 127822)
    assert(source == "changed")
    var nested := 0
    for outer in "Aå".runes() {
        for inner in "🌍\0".runes() {
            nested = nested + 1
            if inner == `\0` { continue }
            if outer == `å` { break }
        }
    }
    assert(nested == 3)
    for repeat in 0..48 {
        assert(total("Aå\0🌍B") == 128117)
        assert(i32(first("🌍å")) == 127757)
        assert(first("") == `?`)
    }
    var bytes := 0
    for byte in "å🌍".bytes() { bytes = bytes + byte }
    assert(bytes == 195 + 165 + 240 + 159 + 140 + 141)
    print(42)
}
