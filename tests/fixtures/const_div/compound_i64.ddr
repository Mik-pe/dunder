fn complex(a:i64,b:i64,c:i64)->i64{((a+b)*(c-1))/7}
fn folded(a:i64)->i64{a/(3+4)}
fn compound(a:i64,b:i64)->i64{(a/3+b%7)/(-5)}
fn nested(a:i64)->i64{(a/(-7))%3}
fn shorted(a:i64)->bool{a==0 || a/0==1}
fn choose(a:i64)->i64{if a<0{return a/(-3)}else{return a%5}}
fn pressure(n:i64)->i64{mut a0:=n+0;mut a1:=n+1;mut a2:=n+2;mut a3:=n+3;mut a4:=n+4;mut a5:=n+5;mut a6:=n+6;mut a7:=n+7;mut a8:=n+8;mut a9:=n+9;mut a10:=n+10;mut a11:=n+11;mut a12:=n+12;mut a13:=n+13;mut a14:=n+14;mut a15:=n+15;mut a16:=n+16;mut a17:=n+17;mut i:=0;while i<4{a0=a0/3;a1=a1/-5;a2=a2/7;a3=a3/-11;a4=a4/13;a5=a5/-17;a6=a6/3;a7=a7/-5;a8=a8/7;a9=a9/-11;a10=a10/13;a11=a11/-17;a12=a12/3;a13=a13/-5;a14=a14/7;a15=a15/-11;a16=a16/13;a17=a17/-17;i=i+1};a0*1+a1*2+a2*3+a3*4+a4*5+a5*6+a6*7+a7*8+a8*9+a9*10+a10*11+a11*12+a12*13+a13*14+a14*15+a15*16+a16*17+a17*18}
fn eight(a:i64,b:i64,c:i64,d:i64,e:i64,f:i64,g:i64,h:i64)->i64{a/3+b/(-5)+c/7+d/(-11)+e/13+f/(-17)+g/19+h/(-23)}
fn main(){{mut a:i64=-77777;mut b:i64=31;mut c:i64=-7;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i64=-101;mut b:i64=-33;mut c:i64=9;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i64=0;mut b:i64=7;mut c:i64=1;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i64=17;mut b:i64=-9;mut c:i64=3;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i64=123456;mut b:i64=3;mut c:i64=-2;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}mut zero:i64=0;print(shorted(zero));mut p0:i64=91;mut p1:i64=-72;mut p2:i64=53;mut p3:i64=-34;mut p4:i64=25;mut p5:i64=-16;mut p6:i64=7;mut p7:i64=-8;print(eight(p0,p1,p2,p3,p4,p5,p6,p7))}
