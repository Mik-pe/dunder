fn complex(a:i32,b:i32,c:i32)->i32{((a+b)*(c-1))/7}
fn folded(a:i32)->i32{a/(3+4)}
fn compound(a:i32,b:i32)->i32{(a/3+b%7)/(-5)}
fn nested(a:i32)->i32{(a/(-7))%3}
fn shorted(a:i32)->bool{a==0 || a/0==1}
fn choose(a:i32)->i32{if a<0{return a/(-3)}else{return a%5}}
fn pressure(n:i32)->i32{mut a0:=n+0;mut a1:=n+1;mut a2:=n+2;mut a3:=n+3;mut a4:=n+4;mut a5:=n+5;mut a6:=n+6;mut a7:=n+7;mut a8:=n+8;mut a9:=n+9;mut a10:=n+10;mut a11:=n+11;mut a12:=n+12;mut a13:=n+13;mut a14:=n+14;mut a15:=n+15;mut a16:=n+16;mut a17:=n+17;mut i:=0;while i<4{a0=a0/3;a1=a1/-5;a2=a2/7;a3=a3/-11;a4=a4/13;a5=a5/-17;a6=a6/3;a7=a7/-5;a8=a8/7;a9=a9/-11;a10=a10/13;a11=a11/-17;a12=a12/3;a13=a13/-5;a14=a14/7;a15=a15/-11;a16=a16/13;a17=a17/-17;i=i+1};a0*1+a1*2+a2*3+a3*4+a4*5+a5*6+a6*7+a7*8+a8*9+a9*10+a10*11+a11*12+a12*13+a13*14+a14*15+a15*16+a16*17+a17*18}
fn eight(a:i32,b:i32,c:i32,d:i32,e:i32,f:i32,g:i32,h:i32)->i32{a/3+b/(-5)+c/7+d/(-11)+e/13+f/(-17)+g/19+h/(-23)}
fn main(){{mut a:i32=-77777;mut b:i32=31;mut c:i32=-7;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i32=-101;mut b:i32=-33;mut c:i32=9;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i32=0;mut b:i32=7;mut c:i32=1;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i32=17;mut b:i32=-9;mut c:i32=3;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}{mut a:i32=123456;mut b:i32=3;mut c:i32=-2;print(complex(a,b,c));print(folded(a));print(compound(a,b));print(nested(a));print(choose(a));print(pressure(a))}mut zero:i32=0;print(shorted(zero));mut p0:i32=91;mut p1:i32=-72;mut p2:i32=53;mut p3:i32=-34;mut p4:i32=25;mut p5:i32=-16;mut p6:i32=7;mut p7:i32=-8;print(eight(p0,p1,p2,p3,p4,p5,p6,p7))}
