import ...selfhost.opt_ir as ir
import ...selfhost.opt_parse as parse
import ...selfhost.opt_alloc as alloc
import ...selfhost.opt_emit as emitter
import ...selfhost.opt_range as ranges
import ...selfhost.opt_verify as verify
import ...selfhost.lexer
import ...selfhost.arm64 as arm
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as numbers
import sys

fn integer(at: i32) -> i64 { numbers.integer(sys.arg(at)).value }
fn address(code: &mut arm.Code, slot: i32) {
    if slot < 511 { arm.emit(&mut code, 3506439072 + i64(slot + 1) * 8192) }
    else { arm.imm(&mut code, 9, i64(slot + 1) * 8); arm.emit(&mut code, 3406365600) }
}
fn put(code: &mut arm.Code, plan: &alloc.Plan, id: i32) {
    if plan.homes[id] >= 0 { arm.mov(&mut code, plan.homes[id], 0) }
    else { var slot := id; if plan.frame_slots.len > 0 { slot = plan.frame_slots[id] }; arm.store(&mut code, slot, 0) }
}
fn first_expression(nodes: &ir.Nodes, node: i32) -> i32 {
    if node < 0 { return -1 }
    if nodes.kinds[node] == 15 { return nodes.left[node] }
    if nodes.kinds[node] == 10 {
        var at := nodes.left[node]
        while at >= 0 { found := first_expression(&nodes, at); if found >= 0 { return found }; at = nodes.next[at] }
    } else if nodes.kinds[node] == 13 {
        found := first_expression(&nodes, nodes.right[node]); if found >= 0 { return found }
        return first_expression(&nodes, nodes.third[node])
    }
    -1
}
fn plan_layout(plan: &mut alloc.Plan, layout: string) {
    if layout == "auto" { return }
    if layout == "homes" {
        registers := [4, 5, 6, 7, 10, 11, 12, 13, 14, 15, 16, 17]; var at := 0
        for id in 0..plan.homes.len { plan.homes[id] = -1; if plan.first[id] >= 0 { assert(at < registers.len); plan.homes[id] = registers[at]; at = at + 1 } }
        return
    }
    for id in 0..plan.homes.len { plan.homes[id] = -1 }
    if layout == "spill" { return }
    assert(layout == "mapped-small" || layout == "mapped-data" || layout == "mapped-index" || layout == "mapped-length" || layout == "mapped-value")
    while plan.homes.len < 72 { plan.homes.push(-1); plan.first.push(-1); plan.last.push(-1); plan.loop.push(-1) }
    for id in 0..plan.homes.len { plan.frame_slots.push(id + 100) }
    for id in 0..8 { plan.frame_slots[id] = id }
    plan.data[0] = 70; plan.length[0] = 71
    plan.frame_slots[70] = 20; plan.frame_slots[71] = 21
    if layout == "mapped-data" { plan.frame_slots[70] = 512 }
    if layout == "mapped-index" { plan.frame_slots[1] = 600 }
    if layout == "mapped-length" { plan.frame_slots[71] = 511 }
    if layout == "mapped-value" { plan.frame_slots[2] = 1024 }
}
fn main() {
    source := sys.read_text(sys.arg(1)); assert(source.ok); input := lexer.scan(source.value, false)
    names: []string = ["p0", "p1", "p2", "p3", "p4", "p5", "p6", "p7"]
    var types: []i32 = [21, 1, 2, 2, 2, 2, 2, 2]; types[0] = i32(integer(6)); positions: []i32 = [0, 1, 2, 3, 4, 5, 6, 7]
    var f := ir.new(); assert(parse.parse(&mut f, &input, 8, input.kinds.len - 2, &names, &types, &positions, i32(integer(5))))
    assert(verify.validate(&f, false))
    if sys.arg(18) == "on" { var work := ranges.new(); assert(ranges.analyze_into(&mut work, &f)); ranges.apply(&mut work, &mut f) }
    else { assert(sys.arg(18) == "off") }
    assert(verify.validate(&f, true))
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &f); plan_layout(&mut plan, sys.arg(17))
    mode := sys.arg(16); root := first_expression(&f.nodes, f.root)
    if mode == "unknown" || mode == "depth" {
        assert(root >= 0)
        if mode == "unknown" { f.nodes.kinds[root] = 7 }
        else { f.nodes.kinds[root] = 4; f.nodes.values[root] = 1; f.nodes.left[root] = root }
        assert(emitter.expression_clobbers(&f.nodes, &plan, root) == -1); print(-1); return
    }
    platform := i32(integer(3)); var code := arm.new_for(platform)
    entry := arm.label(&mut code); wrapper := arm.label(&mut code)
    overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    var start := code.words.len; var finish := start; var mask := 0
    if mode == "function" {
        assert(plan.frame_slots.len == 0)
        emitter.emit_prepared(&mut code, &f, &plan, entry, overflow, zero, bounds)
        finish = code.words.len
        arm.mark(&mut code, wrapper); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 32)
        values := [3, -7, 11, 17, -1, 5, 8, 6]
        for i in 0..8 { arm.imm(&mut code, 0, i64(values[i])); arm.store(&mut code, 20 - i, 0) }
        if integer(15) == 0 { arm.imm(&mut code, 0, 0) } else { address(&mut code, 20) }
        arm.store(&mut code, 4, 0); arm.imm(&mut code, 0, integer(15)); arm.store(&mut code, 3, 0); arm.store(&mut code, 2, 0)
        arm.imm(&mut code, 0, 3); arm.store(&mut code, 1, 0); address(&mut code, 4); arm.store(&mut code, 0, 0)
        for p in 0..8 { arm.imm(&mut code, p, integer(7 + p)) }
        address(&mut code, 0); arm.branch(&mut code, entry, 1)
    } else {
        assert(mode == "probe" && root >= 0 && f.local_types.len == 8)
        arm.mark(&mut code, wrapper); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2048)
        for p in 0..8 {
            arm.imm(&mut code, 0, integer(7 + p)); if types[p] == 1 { arm.emit(&mut code, 2470476800) }
            put(&mut code, &plan, p)
        }
        values := [3, -7, 11, 17, -1, 5, 8, 6]
        for i in 0..8 { arm.imm(&mut code, 0, i64(values[i])); arm.store(&mut code, 1400 - i, 0) }
        if integer(15) == 0 { arm.imm(&mut code, 0, 0) } else { address(&mut code, 1400) }
        put(&mut code, &plan, plan.data[0]); arm.imm(&mut code, 0, integer(15)); put(&mut code, &plan, plan.length[0])
        arm.imm(&mut code, 8, 1234605616436508552); arm.imm(&mut code, 9, 81985529216486895)
        mask = emitter.expression_clobbers(&f.nodes, &plan, root)
        start = code.words.len; settings := emitter.options()
        emitter.emit_expression(&mut code, &f.nodes, &f.local_types, &plan, root, overflow, zero, bounds, &settings)
        finish = code.words.len
    }
    arm.imm(&mut code, 2, integer(4)); arm.emit(&mut code, 3942776863); arm.branch(&mut code, assertion, 3)
    if mode == "probe" {
        if mask.bit_and(256) == 0 { arm.imm(&mut code, 2, 1234605616436508552); arm.emit(&mut code, 3942777119); arm.branch(&mut code, assertion, 3) }
        if mask.bit_and(512) == 0 { arm.imm(&mut code, 2, 81985529216486895); arm.emit(&mut code, 3942777151); arm.branch(&mut code, assertion, 3) }
    }
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    var pushes := 0; var addr8 := 0; var addr9 := 0; var direct := 0; var writes8 := 0; var writes9 := 0
    var held9 := false
    for at in start..finish {
        word := code.words[at]
        if held9 { assert(word.bit_and(31) != 9) }
        if word == 2847899624 { pushes = pushes + 1 }
        if word.bit_and(4292934656) == 2332036096 {
            if word.bit_and(31) == 8 { addr8 = addr8 + 1 }
            if word.bit_and(31) == 9 { addr9 = addr9 + 1; held9 = true }
        }
        if word.bit_and(4294966272) == 4177526784 {
            base := word.shr(5).bit_and(31)
            // Large frame spills also use [x9]; only an outstanding array
            // address identifies the selected store, never the base alone.
            var array_store := base == 8
            if base == 9 && held9 { held9 = false; array_store = true }
            if array_store && word.bit_and(31) >= 4 {
                direct = direct + 1
                assert(at > start && code.words[at - 1].bit_and(4292934656) == 2332036096 && code.words[at - 1].bit_and(31) == base)
            }
        }
        if word.bit_and(31) == 8 { writes8 = writes8 + 1 }
        if word.bit_and(31) == 9 { writes9 = writes9 + 1 }
    }
    assert(!held9)
    if mode == "probe" {
        assert(mask.bit_and(256) != 0 || writes8 == 0); assert(mask.bit_and(512) != 0 || writes9 == 0)
    }
    print(finish - start); print(mask); print(pushes); print(addr8); print(addr9); print(direct); print(writes8); print(writes9)
    arm.mark(&mut code, overflow); arm.exit(&mut code, 101)
    arm.mark(&mut code, zero); arm.exit(&mut code, 102)
    arm.mark(&mut code, bounds); arm.exit(&mut code, 103)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    end := code.words.len; var image: []u8 = []
    if platform == 3 { abi := wa.new(); result := wasm.image(&code, end, wrapper, 1, &abi); assert(result.ok); image = result.text }
    else if platform == 2 { empty: []i32 = []; result := x86.finish(&code, end, &empty, &empty); assert(result.ok); image = elf.image_for(&result.text, 62) }
    else { text := arm.finish(&mut code); if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) } }
    saved := sys.write_u8(sys.arg(2), &image); assert(saved.ok); executable := sys.make_executable(sys.arg(2)); assert(executable.ok)
}
