capability filesystem, process, stdio
import std.fs as fs
import std.io as io
import std.process as process
import sys

fn main() -> i32 {
    if sys.arg_count() > 1 && sys.arg(1) == "wait" {
        print("redo")
        _ := io.read_stdin().unwrap()
        return 77
    }
    if sys.arg_count() > 1 && sys.arg(1) == "worker" {
        assert(sys.pid() > 0)
        started := sys.now_ms()
        sys.sleep_ms(32)
        assert(sys.now_ms() > started)
        assert(sys.arg_count() == 6)
        assert(sys.arg(2) == "" && sys.arg(3) == "a b" && sys.arg(4) == "å\\\"ö" && sys.arg(5) == "🌱\\")
        assert(process.env("DUNDER_CHILD_TEXT") == .Some("Ä Ö"))
        marker := sys.read_text("rötter.txt")
        assert(marker.ok && marker.value == "grön")
        assert(io.read_stdin().unwrap() == "frö\n")
        print("växt")
        _ := sys.eprint("blad")
        return 23
    }
    tmp := fs.temp_dir("dunder å ")
    assert(tmp.ok)
    defer { _ := fs.remove_all(tmp.value) }
    assert(sys.write_text(tmp.value + "/rötter.txt", "grön").ok)
    executable := fs.realpath(sys.arg(0))
    assert(executable.ok)
    mut child := process.Command::new(executable.value.clone(), ["worker", "", "a b", "å\\\"ö", "🌱\\"])
    child.set_cwd(tmp.value.clone())
    child.set_env("DUNDER_CHILD_TEXT", "Ä Ö")
    child.set_stdin_text("frö\n")
    child.set_timeout(10000)
    output := child.exec()
    assert(output.ok && output.code == 23 && output.stdout_text() == "växt\n" && output.stderr_text() == "blad\n")
    mut command := process.Command::new(move executable.value, ["wait"])
    command.set_stdio(.Pipe, .Pipe, .Pipe)
    mut waiting := command.spawn().unwrap()
    assert(waiting.read_stdout_line(10000).unwrap() == .Some("redo"))
    assert(waiting.terminate().ok)
    stopped := waiting.wait(10000)
    assert(stopped.ok && stopped.exited && !stopped.timed_out)
    if target_is("windows") { assert(stopped.code == 143) } else { assert(stopped.signal == 15) }
    print(42)
    0
}
