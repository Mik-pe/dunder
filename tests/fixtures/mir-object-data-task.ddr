// Host-native task generator. Child workers optimize AND lower; only numeric
// ObjectData returns. The emitted kernels also run on Wasm (no Wasm threads).
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.mir_pipeline as pipeline
import ...selfhost.mir_task
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import ..mir_object_support as support
import std.parse as decimal
import sys

fn number(at: i32) -> i32 { n := decimal.integer(sys.arg(at)); assert(n.ok); i32(n.value) }
fn job(prefix: &arm.Code, entry: i32, ordinal: i32, value: i64) -> mir_task.Job {
    var code := arm.new_for(prefix.platform); support.copy_code(&mut code, &prefix)
    first := code.words.len; labels := code.labels.len; relocs := code.at.len
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    arm.imm(&mut code, 0, value); arm.emit(&mut code, 2852193249); arm.ret(&mut code)
    sites: []i32 = []; var f := mir.new(); assert(lift.lift(&mut f, &code, first, labels, relocs, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    mir_task.Job { ordinal: ordinal, declaration: ordinal + 17, function: f, options: pipeline.options(), terminals: pipeline.no_terminals() }
}
fn worker(input: mir_task.Job) -> mir_task.Answer {
    var answer := mir_task.execute(input)
    // Explicitly observe normal value-clone behavior for empty arrays with
    // formerly large capacity. This is test-only, not production builder state.
    answer.object.output.labels.reserve(257); answer.object.output.labels.clear(); answer
}
fn main() {
    target := number(2); mode := sys.arg(3); capacity := number(4)
    assert((mode == "task" || mode == "serial") && (capacity == 1 || capacity == 2 || capacity == 4))
    var prefix := arm.new_for(target); start := arm.label(&mut prefix); entry := arm.label(&mut prefix); failed := arm.label(&mut prefix)
    arm.branch(&mut prefix, start, 1); arm.exit(&mut prefix, 0); arm.mark(&mut prefix, failed); arm.exit(&mut prefix, 104)
    arm.mark(&mut prefix, start); frame := arm.prologue(&mut prefix); arm.frame(&mut prefix, frame, 0)
    arm.branch(&mut prefix, entry, 1); arm.imm(&mut prefix, 1, 42); arm.emit(&mut prefix, 3942711327); arm.branch(&mut prefix, failed, 3)
    arm.imm(&mut prefix, 0, 0); arm.ret(&mut prefix)
    input := job(&prefix, entry, 0, 42); later := job(&prefix, entry, 1, 67)
    expected := mir_task.execute(input); assert(expected.status.error == 0 && expected.status.stats.values_optimized == 1)
    var object := lower.new_object()
    if mode == "task" {
        for iteration in 0..3 {
            task scope jobs(capacity) {
                a := spawn jobs worker(input); b := spawn jobs worker(later)
                discarded := spawn jobs worker(later)
                second := await jobs(b); assert(second.ordinal == 1 && second.declaration == 18 && second.status.error == 0)
                var first := await jobs(a); assert(first.ordinal == 0 && first.declaration == 17 && first.status.error == 0)
                assert(first.object.output.labels.len == 0 && first.object.output.labels.cap() == 0)
                original := first.object.output.words[0]; first.object.output.words[0] = 0
                var repeated := await jobs(a); assert(repeated.object.output.words[0] == original)
                assert(lower.from_data_into(&mut object, &repeated.object))
                repeated.object.output.words[0] = 0; assert(lower.object_word(&object, 0) == original)
                var invalid := input; invalid.function = mir.new()
                refused := spawn jobs worker(invalid); failure := await jobs(refused)
                assert(failure.status.error == 1 && failure.object.version == 0 && failure.object.output.words.len == 0)
            }
            // The accepted object's words outlive all child mappings, input
            // snapshots, cached results and repeated-await copies of the scope.
            assert(lower.object_ready(&object) && lower.object_word_count(&object) == expected.object.output.words.len)
            for i in 0..expected.object.output.words.len { assert(lower.object_word(&object, i) == expected.object.output.words[i]) }
        }
    } else { assert(lower.from_data_into(&mut object, &expected.object)) }
    var code := arm.new_for(target); support.copy_code(&mut code, &prefix); var sites: []i32 = []
    support.append(&object, &mut code, &mut sites)
    var image: []u8 = []
    if target == 3 { abi := wa.new(); output := wasm.image(&code, code.words.len, start, 1, &abi); assert(output.ok); image = output.text }
    else if target == 2 { output := x86.finish(&code, code.words.len, &sites, &sites); assert(output.ok); image = elf.image_for(&output.text, 62) }
    else { bytes := arm.finish(&mut code); if target == 0 { image = macho.image(&bytes) } else { image = elf.image(&bytes) } }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
    print("objects=1;lowering=worker-or-serial-once;iterations=3")
}
