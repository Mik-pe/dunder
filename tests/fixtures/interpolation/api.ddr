import ....selfhost.frontend.compile as compiler
import ....selfhost.driver.modules
import ....selfhost.frontend.lexer
import ....selfhost.backend.macho
import ....selfhost.backend.elf
import std.parse as parse
import sys

fn main() -> i32 {
    path := sys.arg(1)
    target := i32(parse.integer(sys.arg(2)).value)
    mode := sys.arg(3)
    none: []i32 = []
    mut tokens := lexer.empty(false)
    mut source := ""
    if mode == "direct" {
        read := sys.read_text(path); assert(read.ok)
        source = read.value
    } else {
        loaded := modules.load_for(path, false, mode == "tokens", &mut tokens)
        if !loaded.ok { print(loaded.error); return 1 }
        source = loaded.source
    }
    if mode != "tokens" { tokens = lexer.scan(source, false) }
    mut records := compiler.bindings()
    config := compiler.configuration()
    result := compiler.compile_options(&mut tokens, target, &none, &none, false, false, &mut records, "", "", &config)
    if !result.ok { print("ERROR"); print(result.offset); print(result.error); return 1 }
    assert(result.imports.symbols.len == 0)
    mut image := result.text
    if target == 0 { image = macho.image(&image) }
    else if target == 1 { image = elf.image(&image) }
    else { image = elf.image_for(&image, 62) }
    assert(sys.write_u8(sys.arg(4), &image).ok)
    assert(sys.make_executable(sys.arg(4)).ok)
    print("api ok")
    0
}
