// Plumbs the public ten-argument callback without Task syntax. This fixture
// deliberately delegates to serial compilation; it tests routing/configuration,
// not worker scheduling or parallel statistics.
import ...selfhost.driver
import ...selfhost.compile as compiler
import ...selfhost.lexer
import sys
fn compile(tokens:&mut lexer.Tokens,platform:i32,starts:&[]i32,files:&[]i32,
    checking:bool,report:bool,records:&mut compiler.Bindings,directory:string,identity:string,
    config:&compiler.Configuration)->compiler.Result {
    assert(sys.write_text("callback.txt",config.workers.str()+"\n"+checking.str()+"\n"+report.str()+"\n"+directory+"\n"+identity+"\n").ok)
    compiler.compile_options(&mut tokens,platform,&starts,&files,checking,report,&mut records,directory,identity,&config)
}
fn main()->i32 {driver.build_using(0,4,true,compile)}
