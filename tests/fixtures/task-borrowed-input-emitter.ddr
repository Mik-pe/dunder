capability filesystem
import ...selfhost.backend.arm64 as arm
import ...selfhost.backend.ffi_arm64 as abi
import ...selfhost.runtime.runtime
import ...selfhost.tasks.task_native as task
import ...selfhost.backend.macho
import sys

fn ld(c:&mut arm.Code,d:i32,b:i32,o:i32){abi.load(&mut c,d,b,o,8)}
fn st(c:&mut arm.Code,s:i32,b:i32,o:i32){abi.store(&mut c,s,b,o,8)}
fn check(c:&mut arm.Code,r:i32,value:i64,failed:i32){
    arm.imm(&mut c,17,value);arm.compare_register(&mut c,r,17);arm.branch(&mut c,failed,3)
}
fn main(){
    mode:=sys.arg(2)
    mut input_mode:=1
    if mode=="c"{input_mode=2}
    if mode=="fixed"{input_mode=3}
    scalar:=mode=="scalar"
    mut c:=arm.new();rt:=runtime.new(&mut c)
    main_label:=arm.label(&mut c);worker:=arm.label(&mut c);failed:=arm.label(&mut c)
    clone:=arm.label(&mut c);drop:=arm.label(&mut c)
    for reg in 19..25{arm.imm(&mut c,reg,0)}
    arm.branch(&mut c,main_label,1);arm.syscall(&mut c,33554433,94);arm.emit(&mut c,3558866944)
    arm.mark(&mut c,worker);wf:=arm.prologue(&mut c);arm.frame(&mut c,wf,0)
    if input_mode==1{ld(&mut c,0,0,0)}
    if scalar{check(&mut c,0,42,failed)}
    else{
        if input_mode==1{ld(&mut c,0,0,0)}
        ld(&mut c,1,0,0);ld(&mut c,0,0,8)
        arm.integer_binary(&mut c,1,true,false,0,1,0,-1)
        check(&mut c,0,42,failed)
    }
    arm.imm(&mut c,0,42);arm.ret(&mut c)
    arm.mark(&mut c,clone);cf:=arm.prologue(&mut c);arm.frame(&mut c,cf,1)
    arm.store(&mut c,0,0);arm.imm(&mut c,0,16);arm.branch(&mut c,rt.alloc_record,1)
    arm.load_into(&mut c,0,1);ld(&mut c,10,1,0);st(&mut c,10,0,0);ld(&mut c,10,1,8);st(&mut c,10,0,8);arm.ret(&mut c)
    arm.mark(&mut c,drop);df:=arm.prologue(&mut c);arm.frame(&mut c,df,1)
    arm.store(&mut c,0,0);ld(&mut c,0,0,0);arm.branch(&mut c,rt.release,1)
    arm.load(&mut c,0);arm.branch(&mut c,rt.release,1);arm.ret(&mut c)
    mut in_clone:=-1;mut in_drop:=-1
    if !scalar{in_clone=rt.array_clone;in_drop=drop}
    if mode=="c"{in_clone=clone;in_drop=rt.release}
    spec:=task.TaskSpec{input_clone:in_clone,input_mode:input_mode,input_drop:in_drop,input_pod:false,worker:worker,result_clone:-1,result_drop:-1,result_pod_words:0,workspace_pod_words:0}
    symbols:=task.Symbols{symbol_count:6,global_queue:0,create_group:1,submit:2,wait:3,release_group:4,munmap:5}
    provided:=task.emit(&mut c,&rt,&spec,&symbols);assert(provided.ok)
    unmap:=task.emit_unmap_pool(&mut c,&symbols);assert(unmap.ok)
    mut sites:=provided.import_sites.clone();mut slots:=provided.import_slots.clone()
    for i in 0..unmap.import_sites.len{sites.push(unmap.import_sites[i]);slots.push(unmap.import_slots[i])}
    arm.mark(&mut c,main_label);mf:=arm.prologue(&mut c);arm.frame(&mut c,mf,6)
    if scalar{arm.imm(&mut c,0,42)}
    else if mode=="c"{
        arm.imm(&mut c,0,16);arm.branch(&mut c,rt.alloc_record,1)
        arm.imm(&mut c,10,11);st(&mut c,10,0,0);arm.imm(&mut c,10,31);st(&mut c,10,0,8)
    }else{
        arm.imm(&mut c,2,3);arm.branch(&mut c,rt.array_new,1)
        arm.imm(&mut c,1,11);arm.branch(&mut c,rt.array_push,1)
        arm.imm(&mut c,1,31);arm.branch(&mut c,rt.array_push,1)
    }
    arm.store(&mut c,0,0)
    arm.imm(&mut c,0,i64(task.control_bytes()));arm.branch(&mut c,rt.alloc,1);arm.store(&mut c,1,0)
    arm.load_into(&mut c,0,1);task.emit_initialize(&mut c)
    arm.imm(&mut c,10,1);st(&mut c,10,0,88)
    for round in 0..12{
        if round>0{arm.load(&mut c,1);st(&mut c,31,0,0);arm.load_into(&mut c,0,10);st(&mut c,10,0,16)}
        arm.load(&mut c,1);arm.branch(&mut c,provided.create,1);check(&mut c,0,0,failed)
        arm.load(&mut c,1);arm.branch(&mut c,provided.collect,1);check(&mut c,0,0,failed)
        arm.load(&mut c,1);ld(&mut c,10,0,40);check(&mut c,10,42,failed)
        if !scalar{
            ld(&mut c,10,0,48)
            if round==0{arm.store(&mut c,2,10)}
            else{arm.load_into(&mut c,2,11);arm.compare_register(&mut c,10,11);arm.branch(&mut c,failed,3)}
        }
    }
    arm.load(&mut c,1);ld(&mut c,0,0,72);arm.branch(&mut c,unmap.label,1);check(&mut c,0,0,failed)
    arm.imm(&mut c,0,0);arm.ret(&mut c)
    arm.mark(&mut c,failed);arm.exit(&mut c,104)
    runtime.emit_runtime(&mut c,&rt)
    text:=arm.finish_for(&mut c,true)
    libs:[]string=["c","c","c","c","c","c"]
    names:[]string=["dispatch_get_global_queue","dispatch_group_create","dispatch_group_async_f","dispatch_group_wait","dispatch_release","munmap"]
    image:=macho.dynamic_image(&text,&libs,&names,&sites,&slots)
    assert(sys.write_u8(sys.arg(1),&image).ok);assert(sys.make_executable(sys.arg(1)).ok)
}
