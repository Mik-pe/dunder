
fn values(n: i32) -> []i32 { [n] }
fn number(n: i32) -> i32 { n }
fn first(values: &[]i32) -> i32 { values[0] }
fn scalar(value: &i32) -> i32 { value }
fn main() {
    task scope jobs(2) {
        array_key := jobs.spawn(values, 42)
        assert(first(&array_key.join()) == 42)
        number_key := jobs.spawn(number, 42)
        assert(scalar(&number_key.join()) == 42)
        second_key := jobs.spawn(number, 42)
        assert(scalar(&second_key.join()) == 42)
    }
    print("task temporary loans ok")
}
