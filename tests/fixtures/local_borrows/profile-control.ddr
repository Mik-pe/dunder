
fn sum(values: &[]i32) -> i32 {
    mut result := 0
    for value in values { result += value }
    result
}
fn main() {
    values: []i32 = [7, 20, 22, 9]
    text := "xå🌍y"
    mut total := 0
    for turn in 0..10000 {

        total += values[1] + values[2] + values[2]
        assert(text.len == 8 && text[1] == 195 && text[2] == 165 && text[6] == 141)

    }
    assert(total == 640000)
    print("view allocation oracle ok")
}
