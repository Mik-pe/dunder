// Embed the shared expression walker in an existing caller frame. There is
// no inline-cache lookup or source-call replacement in this fixture/compiler.
import ...selfhost.arm64 as arm
import ...selfhost.lexer
import ...selfhost.opt_ir as ir
import ...selfhost.opt_parse as parse
import ...selfhost.opt_alloc as alloc
import ...selfhost.opt_emit as emitter
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn compare(code: &mut arm.Code, left: i32, right: i32) { arm.emit(&mut code, 3942645791 + i64(right) * 65536 + i64(left) * 32) }
fn main() {
    platform := i32(decimal.integer(sys.arg(2)).value); selected := i32(decimal.integer(sys.arg(4)).value)
    var source := "a b{a+b*3}"; var left: i64 = 14; var right: i64 = 7; var expected: i64 = 35; var ret := 2
    if selected == 1 || selected == 2 {
        source = "a b{a!=0&&b/a>1}"; ret = 3
        if selected == 1 { left = 0; right = 9223372036854775807; expected = 0 }
        else { left = 2; right = 14; expected = 1 }
    } else if selected == 3 { source = "a b{(a+b)/7}"; left = 9223372036854775807; right = 1 }
    else if selected == 4 { source = "a b{a/b}"; right = 0 }
    else if selected == 5 { source = "a b{a%(-1)}"; left = -9223372036854775808 }
    else if selected == 6 { source = "a b{a==0||b/a>2}"; ret = 3; left = 0; expected = 1 }
    else if selected == 7 { source = "a b{(a*b+1)%7}"; expected = 1 }
    else if selected == 8 { source = "a b{-a+b}"; left = -9223372036854775808 }
    else { assert(selected == 0 || selected == 9 || selected == 10) }
    input := lexer.scan(source, false)
    names: []string = ["a", "b"]; types: []i32 = [2, 2]; positions: []i32 = [0, 1]
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 2, input.kinds.len - 2, &names, &types, &positions, ret))
    returned := f.nodes.left[f.root]; root := f.nodes.left[returned]
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &f)
    for local in 0..plan.homes.len { plan.homes[local] = -1 }
    plan.frame_slots.push(37); plan.frame_slots.push(620)
    if selected == 9 { removed := plan.frame_slots.pop() }
    if selected == 10 { plan.frame_slots[1] = -1 }
    var code := arm.new_for(platform)
    entry := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code)
    bounds := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    arm.mark(&mut code, entry); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 621)
    arm.store(&mut code, 0, 29); arm.emit(&mut code, 2432697321); arm.store(&mut code, 1, 9)
    for reg in 19..29 { arm.imm(&mut code, reg, i64(reg) * 1000003 + 41) }
    arm.imm(&mut code, 0, left); arm.store(&mut code, 37, 0)
    arm.imm(&mut code, 0, right); arm.store(&mut code, 620, 0)
    var settings := emitter.options(); settings.const_div_enabled = sys.arg(3) == "on"
    begin := code.words.len
    emitter.emit_expression(&mut code, &f.nodes, &f.local_types, &plan, root, overflow, zero, bounds, &settings)
    for at in begin..code.words.len { assert(code.words[at] != 3596551104) }
    for kind in code.kinds { assert(kind != 20) }
    arm.imm(&mut code, 1, expected); compare(&mut code, 0, 1); arm.branch(&mut code, assertion, 3)
    for reg in 19..29 {
        arm.imm(&mut code, 0, i64(reg) * 1000003 + 41); compare(&mut code, reg, 0); arm.branch(&mut code, assertion, 3)
    }
    arm.emit(&mut code, 2432697314); arm.load(&mut code, 1); compare(&mut code, 2, 0); arm.branch(&mut code, assertion, 3)
    arm.load(&mut code, 0); compare(&mut code, 29, 0); arm.branch(&mut code, assertion, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    arm.mark(&mut code, overflow); arm.exit(&mut code, 101)
    arm.mark(&mut code, zero); arm.exit(&mut code, 102)
    arm.mark(&mut code, bounds); arm.exit(&mut code, 103)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    var image: []u8 = []; none: []i32 = []
    if platform == 3 {
        abi := wa.new(); result := wasm.image(&code, code.words.len, entry, 1, &abi); assert(result.ok); image = result.text
    } else if platform == 2 {
        result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62)
    } else {
        text := arm.finish(&mut code)
        if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) }
    }
    saved := sys.write_u8(sys.arg(1), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(1)); assert(executable.ok)
}
