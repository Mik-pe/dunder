// Consumer of the public compiler API: source bindings and optimization/cache
// counters are separate sections, since counters describe work actually done.
import ...selfhost.compile as compiler
import ...selfhost.lexer
import ...selfhost.macho
import ...selfhost.elf
import std.parse as parse
import sys
fn main()->i32 {
    source:=sys.read_text(sys.arg(1));assert(source.ok)
    target:=i32(parse.integer(sys.arg(3)).value)
    var settings:=compiler.configuration()
    settings.inline_enabled=sys.arg(4)=="on";settings.scalar_enabled=sys.arg(5)!="off"
    var tokens:=lexer.scan(source.value,false);var records:=compiler.bindings();none:[]i32=[]
    checking:=sys.arg(7)=="check"
    result:=compiler.compile_options(&mut tokens,target,&none,&none,checking,true,&mut records,sys.arg(6),"inline-producer-test:1",&settings)
    if !result.ok{print("ERROR");print(result.offset);print(result.error);return 1}
    if !checking{
        var image:=result.text
        if target==0{image=macho.image(&image)}else if target==2{image=elf.image_for(&image,62)}else if target==1{image=elf.image(&image)}
        assert(sys.write_u8(sys.arg(2),&image).ok);assert(sys.make_executable(sys.arg(2)).ok)
    }
    print("COUNTERS")
    print(records.modeled);print(records.optimized);print(records.emitted);print(records.reused);print(records.fallbacks)
    print("BINDINGS");print(records.offsets.len)
    for at in 0..records.offsets.len{print(records.offsets[at]);print(records.names[at]);print(records.types[at])}
    print("INLINE")
    print(records.inline_entries);print(records.inline_nodes);print(records.inline_tokens);print(records.inline_units)
    print(records.inlined_calls);print(records.inlined_words);print(records.inline_estimated_words)
    0
}
