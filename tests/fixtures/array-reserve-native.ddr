import std.array

fn main() {
    mut values: []f32 = []
    values.reserve(160000000)
    values.push(3.5)
    values.reserve(160000001)
    status: array.ReserveStatus = values.try_reserve(160000001)
    assert(status == .Ok)
    assert(values.cap() >= 160000001 && values.len == 1 && values[0] == 3.5)
    previous := values.cap()
    assert(values.try_reserve(268435457) == .InvalidCapacity)
    assert(values.cap() == previous && values.pop() == 3.5)
    print(42)
}
