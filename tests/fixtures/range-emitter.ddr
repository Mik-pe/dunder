import ...selfhost.opt_ir as ir
import ...selfhost.opt_parse as parse
import ...selfhost.opt_emit as emit
import ...selfhost.opt_alloc as alloc
import ...selfhost.opt_range as range_analysis
import ...selfhost.opt_verify as verify
import ...selfhost.lexer as lexer
import ...selfhost.arm64 as arm
import ...selfhost.macho as macho
import ...selfhost.elf as elf
import ...selfhost.x86 as x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as integers
import sys

fn integer(at: i32) -> i64 { integers.integer(sys.arg(at)).value }
fn address(code: &mut arm.Code, slot: i32) { arm.emit(&mut code, 3506439072 + i64(slot + 1) * 8192) }
fn main() {
    source := sys.read_text(sys.arg(1)); assert(source.ok)
    tokens := lexer.scan(source.value, false)
    names: []string = ["p0", "p1", "p2", "p3", "p4", "p5", "p6", "p7"]
    var types: []i32 = [2, 2, 2, 2, 2, 2, 2, 2]; types[0] = i32(integer(6))
    if ir.array_type(types[0]) { types[1] = 1 }
    positions: []i32 = [0, 1, 2, 3, 4, 5, 6, 7]
    var f := ir.new()
    assert(parse.parse(&mut f, &tokens, 8, tokens.kinds.len - 2, &names, &types, &positions, i32(integer(5))))
    assert(verify.validate(&f, false))
    var range_work := range_analysis.new(); mode := sys.arg(16)
    if mode == "idle" { range_analysis.apply(&mut range_work, &mut f); return }
    if mode == "budget-apply" { range_analysis.set_budget(&mut range_work, 0); failed := range_analysis.analyze_into(&mut range_work, &f); range_analysis.apply(&mut range_work, &mut f); return }
    var reads := 0; var stores := 0
    if mode == "range" || mode == "twice" || mode == "shape" {
        assert(range_analysis.analyze_into(&mut range_work, &f))
        reads = range_analysis.read_count(&range_work); stores = range_analysis.store_count(&range_work)
        if mode == "shape" { f.nodes.kinds.push(1); range_analysis.apply(&mut range_work, &mut f); return }
        range_analysis.apply(&mut range_work, &mut f)
        if mode == "twice" { range_analysis.apply(&mut range_work, &mut f); return }
    } else if mode == "budget" {
        range_analysis.set_budget(&mut range_work, 0)
        assert(!range_analysis.analyze_into(&mut range_work, &f) && range_analysis.status(&range_work) == 3)
    } else { assert(mode == "none") }
    assert(reads == i32(integer(17)) && stores == i32(integer(18)) && verify.validate(&f, true))
    var original_checks := 0
    for node in 0..f.nodes.kinds.len { if f.nodes.kinds[node] == 6 || f.nodes.kinds[node] == 18 { original_checks = original_checks + 1 } }
    // Exercise one workspace through different model/frame sizes and array/
    // range metadata. The prepared emitter must see only the latest plan.
    warm_tokens := lexer.scan("q {var count:=0;for i in 0..3{count=count+i};count}", false)
    warm_names: []string = ["q"]; warm_types: []i32 = [2]; warm_positions: []i32 = [0]
    var warm := ir.new()
    assert(parse.parse(&mut warm, &warm_tokens, 1, warm_tokens.kinds.len - 2, &warm_names, &warm_types, &warm_positions, 1))
    var plan := alloc.new()
    alloc.allocate_into(&mut plan, &warm); alloc.allocate_into(&mut plan, &f)
    alloc.allocate_into(&mut plan, &warm); alloc.allocate_into(&mut plan, &f)
    for i in 0..plan.homes.len {
        a := plan.homes[i]
        assert(a == -1 || (a >= 4 && a <= 7) || (a >= 10 && a <= 17))
        for j in 0..i {
            if a >= 0 && a == plan.homes[j] { assert(plan.last[i] < plan.first[j] || plan.last[j] < plan.first[i]) }
        }
    }
    for i in 0..f.nodes.kinds.len {
        if f.nodes.kinds[i] == 19 {
            limit := plan.limits[i]
            assert(limit >= 0 && plan.first[limit] >= 0 && plan.last[limit] >= plan.loop_end[i])
            assert(plan.last[f.nodes.locals[i]] >= plan.loop_end[i])
        }
    }
    platform := i32(integer(3)); var code := arm.new_for(platform)
    entry := arm.label(&mut code); wrapper := arm.label(&mut code)
    overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code); assertion := arm.label(&mut code)
    arm.branch(&mut code, wrapper, 1); arm.syscall(&mut code, 33554433, 94); arm.emit(&mut code, 3558866944)
    emit.emit_prepared(&mut code, &f, &plan, entry, overflow, zero, bounds)
    var checks := 0; var arithmetic_checks := 0; var zero_checks := 0
    for relocation in 0..code.at.len {
        if code.target[relocation] == bounds { checks = checks + 1 }
        if code.target[relocation] == overflow { arithmetic_checks = arithmetic_checks + 1 }
        if code.target[relocation] == zero { zero_checks = zero_checks + 1 }
    }
    assert(checks == original_checks - reads - stores)
    print(checks); print(arithmetic_checks); print(zero_checks)
    arm.mark(&mut code, wrapper); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 32)
    if ir.array_type(types[0]) {
        // Descriptor at fp-40, data at fp-168, a separate descriptor cell at fp-8.
        values := [3, -7, 11, 17, -1, 5, 8, 6]
        for i in 0..8 { arm.imm(&mut code, 0, i64(values[i])); arm.store(&mut code, 20 - i, 0) }
        length := i32(integer(15))
        if length == 0 { arm.imm(&mut code, 0, 0) } else { address(&mut code, 20) }
        arm.store(&mut code, 4, 0); arm.imm(&mut code, 0, i64(length)); arm.store(&mut code, 3, 0); arm.store(&mut code, 2, 0)
        arm.imm(&mut code, 0, 3); arm.store(&mut code, 1, 0)
        address(&mut code, 4); arm.store(&mut code, 0, 0)
    }
    for p in 0..8 { arm.imm(&mut code, p, integer(7 + p)) }
    if ir.array_type(types[0]) { address(&mut code, 0) }
    arm.branch(&mut code, entry, 1)
    arm.imm(&mut code, 2, integer(4)); arm.emit(&mut code, 3942776863); arm.branch(&mut code, assertion, 3)
    arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    arm.mark(&mut code, overflow); arm.exit(&mut code, 101)
    arm.mark(&mut code, zero); arm.exit(&mut code, 102)
    arm.mark(&mut code, bounds); arm.exit(&mut code, 103)
    arm.mark(&mut code, assertion); arm.exit(&mut code, 104)
    end := arm.position(&code)
    var image: []u8 = []
    if platform == 3 {
        abi := wa.new(); compiled := wasm.image(&code, end, wrapper, 1, &abi); assert(compiled.ok); image = compiled.text
    } else if platform == 2 {
        empty: []i32 = []; compiled := x86.finish(&code, end, &empty, &empty); assert(compiled.ok); image = elf.image_for(&compiled.text, 62)
    } else {
        text := arm.finish(&mut code)
        if platform == 0 { image = macho.image(&text) } else { image = elf.image(&text) }
    }
    saved := sys.write_u8(sys.arg(2), &image); assert(saved.ok)
    executable := sys.make_executable(sys.arg(2)); assert(executable.ok)
}
