// Origin annotations change no executable word. Fault modes are independent
// resource witnesses: raw AND annotated Wasm stack operations can still trap.
import ...selfhost.arm64 as arm
import ...selfhost.mir
import ...selfhost.mir_lift as lift
import ...selfhost.mir_verify as verify
import ...selfhost.mir_lower as lower
import ...selfhost.macho
import ...selfhost.elf
import ...selfhost.x86
import ...selfhost.wasm_native as wasm
import ...selfhost.wasm_abi as wa
import std.parse as decimal
import sys

fn main() {
    target := decimal.integer(sys.arg(2)); assert(target.ok && target.value >= 0 && target.value < 4)
    platform := i32(target.value); annotated := sys.arg(3) == "temp"; mode := sys.arg(4)
    var code := arm.new_for(platform); entry := arm.label(&mut code)
    integer := arm.label(&mut code); boolean := arm.label(&mut code); text := arm.label(&mut code)
    write := arm.label(&mut code); overflow := arm.label(&mut code); zero := arm.label(&mut code)
    assertion := arm.label(&mut code); io := arm.label(&mut code)
    arm.branch(&mut code, entry, 1); arm.exit(&mut code, 0)
    first := code.words.len; labels := code.labels.len; relocations := code.at.len
    arm.mark(&mut code, entry); arm.begin_mir(&mut code, true)
    if mode == "valid" {
        frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0); arm.imm(&mut code, 0, 42)
        if annotated { arm.push_temp(&mut code, 0); arm.pop_temp(&mut code, 1) }
        else { arm.push(&mut code, 0); arm.pop(&mut code, 1) }
        arm.mov(&mut code, 0, 1)
        if platform == 3 { arm.emit(&mut code, 4227858434) }
        else { arm.imm(&mut code, 8, 0); arm.branch(&mut code, integer, 1) }
        arm.imm(&mut code, 0, 0); arm.ret(&mut code)
    } else {
        assert(platform == 3)
        if mode == "push-fault" || mode == "push-elided-control" {
            // wasm_native starts the logical SP at heap, exactly1MiB above
            // stack_bottom. Reserving that span succeeds; a further push fails.
            arm.emit(&mut code, 3506439167 + 4194304 + 256 * 1024)
            if mode == "push-fault" {
                if annotated { arm.push_temp(&mut code, 0) } else { arm.push(&mut code, 0) }
            }
        } else {
            assert(mode == "pop-fault" || mode == "pop-elided-control")
            if mode == "pop-fault" {
                // Starting at heap, the pop's SP+16 crosses the upper guard.
                if annotated { arm.pop_temp(&mut code, 0) } else { arm.pop(&mut code, 0) }
            }
        }
        arm.imm(&mut code, 0, 77); arm.emit(&mut code, 3596551104)
    }
    arm.end_mir(&mut code)
    var f := mir.new(); var sites: []i32 = []
    assert(lift.lift_spans(&mut f, &code, first, labels, relocations, &sites, 0,
        &code.mir_starts, &code.mir_ends, &code.mir_kinds, &code.mir_a, &code.mir_b))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
    var stacks := 0
    for op in 0..f.kinds.len {
        if f.kinds[op] == 10 || f.kinds[op] == 11 {
            stacks = stacks + 1; assert(f.effects[op].bit_and(1) != 0)
            var role := 0; if annotated { role = 1 }; assert(f.stack_roles[op] == role)
        }
    }
    var expected := 1; if mode == "valid" { expected = 2 }
    if mode == "push-elided-control" || mode == "pop-elided-control" { expected = 0 }
    assert(stacks == expected)
    before := code.words; var work := lower.new()
    assert(lower.prepare(&mut work, &f, &code, &sites)); lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
    assert(code.words.len == before.len)
    for at in 0..before.len { assert(code.words[at] == before[at]) }
    var image: []u8 = []; none: []i32 = []
    if platform == 3 { abi := wa.new(); result := wasm.image(&code, code.words.len, entry, 1, &abi); assert(result.ok); image = result.text }
    else {
        arm.runtime(&mut code, integer, boolean, text, write, overflow, zero, assertion, io)
        if platform == 2 { result := x86.finish(&code, code.words.len, &none, &none); assert(result.ok); image = elf.image_for(&result.text, 62) }
        else { bytes := arm.finish(&mut code); if platform == 0 { image = macho.image(&bytes) } else { image = elf.image(&bytes) } }
    }
    assert(sys.write_u8(sys.arg(1), &image).ok && sys.make_executable(sys.arg(1)).ok)
}
