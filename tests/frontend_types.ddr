import ..selfhost.frontend_types as types
import ..selfhost.frontend_layout as layout
import ..selfhost.frontend_symbols as symbols
import ..selfhost.arm64 as arm

fn primitives(a: &mut types.Arena) {
    for name in ["()", "i32", "i64", "bool", "string", "rune", "f32", "f64", "u8", "u16", "u32", "u64", "usize", "ptr", "range"] {
        id := types.declare(&mut a, name, 0, 0); assert(a.error == 0)
    }
}
// Exact primitive serialization of EVERY semantic column in the sealed
// prefix. Names are checked separately, without hash-based equality proofs.
// The explicitly nonsemantic LayoutCache/error scratch is excluded.
fn prefix(a: &types.Arena) -> []i64 {
    var out: []i64 = [i64(a.header_types), i64(a.header_fields), i64(a.header_payloads), i64(a.header_arguments)]
    assert(a.sealed)
    for ty in 0..a.header_types {
        out.push(i64(a.kinds[ty])); out.push(i64(a.bases[ty])); out.push(i64(a.starts[ty])); out.push(i64(a.counts[ty]))
        out.push(i64(a.opaque_owner[ty])); var c: i64 = 0; if a.c_record[ty] { c = 1 }; out.push(c)
        var complete: i64 = 0; if a.complete[ty] { complete = 1 }; out.push(complete)
    }
    for field in 0..a.header_fields {
        out.push(i64(a.field_types[field])); out.push(a.field_values[field])
        out.push(i64(a.payload_starts[field])); out.push(i64(a.payload_counts[field]))
    }
    for at in 0..a.header_payloads { out.push(i64(a.payload_types[at])) }
    for at in 0..a.header_arguments { out.push(i64(a.arguments[at])) }; out
}
fn same(a: &[]i64, b: &[]i64) { assert(a.len == b.len); for at in 0..a.len { assert(a[at] == b[at]) } }
@test fn sealed_semantic_prefix_survives_body_layout_and_structural_types() {
    var a := types.new(); primitives(&mut a)
    record := types.nominal(&mut a, "Record", 2, true, 42); assert(types.begin_fields(&mut a, record))
    assert(types.append_field(&mut a, "byte", 8, 700, 0)); assert(types.append_field(&mut a, "wide", 2, 701, 0))
    assert(types.append_field(&mut a, "half", 9, 702, 0)); assert(types.finish_fields(&mut a, record))
    tag := types.nominal(&mut a, "Tag", 3, false, -1); assert(types.begin_fields(&mut a, tag))
    assert(types.append_field(&mut a, "First", 0, -2, 0)); assert(types.append_field(&mut a, "Next", 0, 41, 0)); assert(types.finish_fields(&mut a, tag))
    args: []i32 = [record, 2]; callable := types.intern_callable(&mut a, &args, tag, 9)
    assert(types.seal_header(&mut a)); before := prefix(&a); names := a.names; fields := a.field_names
    assert(layout.ensure_c(&mut a, record, 0) == 0)
    assert(a.layouts.c_sizes[record] == 24 && a.layouts.c_aligns[record] == 8)
    assert(a.layouts.field_offsets[0] == 0 && a.layouts.field_offsets[1] == 8 && a.layouts.field_offsets[2] == 16)
    assert(a.field_values[0] == 700 && a.field_values[3] == -2 && a.field_values[4] == 41)
    fixed := types.intern_fixed(&mut a, 12, 10000, 3); assert(a.error == 0 && fixed >= a.header_types)
    assert(layout.ensure_c(&mut a, fixed, 3) == 0 && a.layouts.c_sizes[fixed] == 40000)
    array := types.intern_compound(&mut a, 1, 5); borrow := types.intern_compound(&mut a, 4, array)
    new_args: []i32 = [borrow]; closure := types.intern_callable(&mut a, &new_args, 22, 9)
    assert(closure > callable && a.arguments.len > a.header_arguments)
    // Both legal and rejected C layout queries leave the semantic world alone.
    assert(layout.ensure_c(&mut a, array, 0) == 5)
    after := prefix(&a); same(&before, &after)
    for at in 0..names.len { assert(a.names[at] == names[at]) }
    for at in 0..fields.len { assert(a.field_names[at] == fields[at]) }
    count := a.names.len; rejected := types.nominal(&mut a, "Late", 2, false, -1)
    assert(a.error == 6 && a.names.len == count); final := prefix(&a); same(&before, &final)
}
@test fn interning_keeps_target_cap_and_rejected_row_order() {
    var a := types.new(); primitives(&mut a)
    fixed := types.intern_fixed(&mut a, 12, 10000, 3); count := a.names.len
    assert(a.error == 0 && a.counts[fixed] == 10000)
    rejected := types.intern_fixed(&mut a, 12, 10000, 0)
    assert(rejected == 0 && a.error == 3 && a.names.len == count)
    again := types.intern_fixed(&mut a, 12, 10000, 3); assert(again == fixed && a.names.len == count)
    box := types.nominal(&mut a, "Box", 2, false, -1); assert(types.begin_fields(&mut a, box) && types.finish_fields(&mut a, box))
    before := a.names.len; bad_array := types.intern_compound(&mut a, 1, box)
    assert(a.error == 2 && bad_array == before && a.names.len == before + 1)
    before = a.names.len; bad_fixed := types.intern_fixed(&mut a, box, 10000, 0)
    assert(bad_fixed == 0 && a.error == 2 && a.names.len == before)
    bad_args: []i32 = [3]; bad_call := types.intern_callable(&mut a, &bad_args, 0, 8)
    assert(bad_call == 0 && a.error == 4 && a.names.len == before)
}
@test fn computed_c_and_inline_sizes_have_independent_recursion_and_zero_states() {
    var a := types.new(); primitives(&mut a)
    zero := types.intern_fixed(&mut a, 2, 0, 0)
    record := types.nominal(&mut a, "Zero", 2, false, -1); assert(types.begin_fields(&mut a, record))
    assert(types.append_field(&mut a, "value", zero, 0, 0)); assert(types.finish_fields(&mut a, record))
    assert(layout.ensure_c(&mut a, zero, 0) == 0 && a.layouts.c_sizes[zero] == 0 && a.layouts.c_aligns[zero] == 8)
    assert(layout.validate_inline(&mut a, 0) == 0 && a.layouts.inline_sizes[record] == 8)
    assert(layout.ensure_c(&mut a, record, 0) == 5)
    recursive := types.nominal(&mut a, "Cycle", 2, true, -1); assert(types.begin_fields(&mut a, recursive))
    assert(types.append_field(&mut a, "again", recursive, 0, 0)); assert(types.finish_fields(&mut a, recursive))
    assert(layout.ensure_c(&mut a, recursive, 0) == 1)
    assert(layout.validate_inline(&mut a, 0) == 0) // C records use their separately computed C size.
    plain := types.nominal(&mut a, "InlineCycle", 2, false, -1); assert(types.begin_fields(&mut a, plain))
    assert(types.append_field(&mut a, "again", plain, 0, 0)); assert(types.finish_fields(&mut a, plain))
    assert(layout.validate_inline(&mut a, 0) == 6)
}
@test fn semantic_interning_never_allocates_machine_symbols() {
    var a := types.new(); primitives(&mut a); var s := symbols.new(); var code := arm.new()
    for ty in 0..a.names.len { clone := arm.label(&mut code); drop := arm.label(&mut code); assert(symbols.bind_pair(&mut s, ty, clone, drop)) }
    source_function := arm.label(&mut code); before := arm.label_count(&code)
    ty := types.intern_compound(&mut a, 1, 2); assert(arm.label_count(&code) == before && s.clones.len == ty)
    clone := arm.label(&mut code); drop := arm.label(&mut code); assert(symbols.bind_pair(&mut s, ty, clone, drop))
    assert(s.clones[ty] == source_function + 1 && s.drops[ty] == source_function + 2)
    known := types.intern_compound(&mut a, 1, 2); assert(known == ty && arm.label_count(&code) == before + 2)
    assert(!symbols.bind_pair(&mut s, ty, clone, drop) && s.clones.len == a.names.len)
}
fn main() {}
