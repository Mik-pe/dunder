import ..selfhost.task_effects as effects

@test fn worker_effect_fixedpoint_handles_recursion_and_every_known_call_target() {
    direct: []i64 = [1, 4, 2, 8, 32, 0, 0, 0, i64(1).shl(40), 0]
    complete: []bool = [true, true, true, true, true, true, true, false, true, true]
    starts: []i32 = [0, 1, 2, 3, 4, 4, 6, 7, 7, 7, 8]
    targets: []i32 = [1, 2, 0, 3, 0, 4, -1, 3]
    var w := effects.new(); assert(effects.analyze_into(&mut w, &direct, &complete, &starts, &targets))
    for f in 0..3 { assert(effects.worker_safe(&w, f) && effects.transitive_effects(&w, f) == 7) }
    assert(effects.worker_safe(&w, 3) && effects.transitive_effects(&w, 3) == 8)
    assert(effects.worker_safe(&w, 9) && effects.transitive_effects(&w, 9) == 8)
    for f in 4..9 { assert(!effects.worker_safe(&w, f)) }
    assert(effects.transitive_effects(&w, 5) == 39 && effects.denied_by(&w, 5) == 4)
    assert(effects.transitive_effects(&w, 6) == 512 && effects.denied_by(&w, 6) == 6)
    assert(effects.transitive_effects(&w, 7) == 2048 && effects.denied_by(&w, 7) == 7)
    assert(effects.transitive_effects(&w, 8) == i64(1).shl(40) && effects.denied_by(&w, 8) == 8)
}
@test fn every_forbidden_and_future_effect_propagates_through_recursive_calls() {
    for forbidden in [i64(16), 32, 64, 128, 256, 512, 1024, 2048, i64(1).shl(40), -9223372036854775808] {
        direct: []i64 = [0, forbidden]; complete: []bool = [true, true]
        starts: []i32 = [0, 1, 2]; targets: []i32 = [1, 1]
        var w := effects.new(); assert(effects.analyze_into(&mut w, &direct, &complete, &starts, &targets))
        assert(!effects.worker_safe(&w, 0) && !effects.worker_safe(&w, 1))
        assert(effects.transitive_effects(&w, 0) == forbidden && effects.denied_by(&w, 0) == 1)
    }
}
@test fn partial_indirect_target_sets_never_hide_unknown_or_unsafe_targets() {
    direct: []i64 = [0, 4, 16]; complete: []bool = [true, true, true]
    starts: []i32 = [0, 2, 2, 2]; var targets: []i32 = [1, 2]
    var w := effects.new(); assert(effects.analyze_into(&mut w, &direct, &complete, &starts, &targets))
    assert(!effects.worker_safe(&w, 0) && effects.denied_by(&w, 0) == 2)
    targets[1] = -1
    assert(effects.analyze_into(&mut w, &direct, &complete, &starts, &targets))
    assert(!effects.worker_safe(&w, 0) && effects.transitive_effects(&w, 0) == 516)
}
@test fn worker_effect_budget_and_malformed_graphs_fail_closed_and_reset() {
    direct: []i64 = [1, 4, 2]; complete: []bool = [true, true, true]
    var starts: []i32 = [0, 1, 2, 3]; var targets: []i32 = [1, 2, 0]
    var w := effects.new(); assert(effects.analyze_into(&mut w, &direct, &complete, &starts, &targets))
    units := effects.units(&w)
    assert(!effects.analyze_budget(&mut w, &direct, &complete, &starts, &targets, units - 1))
    assert(effects.status(&w) == -2 && !effects.worker_safe(&w, 0) && effects.transitive_effects(&w, 0) == -1)
    assert(effects.analyze_into(&mut w, &direct, &complete, &starts, &targets) && effects.worker_safe(&w, 0))
    targets[0] = 3; assert(!effects.analyze_into(&mut w, &direct, &complete, &starts, &targets) && effects.status(&w) == -1)
    targets[0] = -2; assert(!effects.analyze_into(&mut w, &direct, &complete, &starts, &targets) && effects.status(&w) == -1)
    targets[0] = 1; starts[1] = 3
    assert(!effects.analyze_into(&mut w, &direct, &complete, &starts, &targets) && effects.status(&w) == -1)
    starts[1] = 1; assert(effects.analyze_into(&mut w, &direct, &complete, &starts, &targets) && effects.worker_safe(&w, 2))
    empty: []i64 = []; no_bodies: []bool = []; empty_starts: []i32 = [0]; no_calls: []i32 = []
    assert(effects.analyze_into(&mut w, &empty, &no_bodies, &empty_starts, &no_calls))
    assert(!effects.worker_safe(&w, 0) && effects.denied_by(&w, 0) == -1)
}
