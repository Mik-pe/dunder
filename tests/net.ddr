capability network
import std.net as net

@test fn peek_preserves_pending_bytes() {
    listening := net.TcpListener::listen(net.loopback(), 0, 1)
    assert(listening.ok)
    listener := listening.listener
    connected := net.TcpStream::connect(net.loopback(), listener.local_port())
    assert(connected.ok)
    sender := connected.stream
    accepted := listener.accept()
    assert(accepted.ok)
    mut receiver := accepted.stream
    assert(receiver.set_nonblocking(true).ok)

    mut output: []u8 = [255]
    idle := receiver.peek_append(&mut output, 1)
    assert(!idle.ok && idle.would_block && !idle.eof && output.len == 1)
    zero := receiver.peek_append(&mut output, 0)
    assert(zero.ok && !zero.eof && zero.count == 0 && output.len == 1)

    data: []u8 = [0, 42]
    assert(sender.write_all(&data).ok)
    assert(sender.shutdown_write().ok)
    mut ready := net.PollSet::new()
    ready.add(receiver.fd(), net.poll_in())
    assert(ready.poll(1000).count == 1)
    for _ in 0..2 {
        next := receiver.peek_append(&mut output, 1)
        assert(next.ok && next.count == 1 && !next.eof)
    }
    assert(output.len == 3 && output[0] == 255 && output[1] == 0 && output[2] == 0)

    assert(receiver.set_nonblocking(false).ok)
    mut actual: []u8 = []
    while actual.len < data.len {
        read := receiver.read_append(&mut actual, data.len - actual.len)
        assert(read.ok && read.count > 0)
    }
    assert(actual[0] == 0 && actual[1] == 42)
    eof := receiver.peek_append(&mut actual, 1)
    assert(eof.ok && eof.eof && eof.count == 0 && actual.len == 2)
    assert(receiver.close().ok)
    closed := receiver.peek_append(&mut actual, 1)
    assert(!closed.ok && !closed.would_block && !closed.eof && actual.len == 2)
}
