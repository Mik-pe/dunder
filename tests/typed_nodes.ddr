import ..selfhost.arm64 as arm
import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_alloc as alloc
import ..selfhost.opt_emit as emitter
import ..selfhost.lexer

fn body(source: string, ret: i32) -> ir.Function {
    input := lexer.scan("x y " + source, false)
    names: []string = ["x", "y"]; types: []i32 = [2, 2]; positions: []i32 = [0, 1]
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 2, input.kinds.len - 2, &names, &types, &positions, ret))
    f
}
fn expression_root(f: &ir.Function) -> i32 {
    returned := f.nodes.left[f.root]
    assert(f.nodes.kinds[returned] == 15 && f.nodes.next[returned] == -1)
    f.nodes.left[returned]
}
@test fn expression_emission_matches_the_function_walker_word_for_word() {
    sources := ["{(x+3)*(y-1)/7}", "{-x+y}", "{x%(-1)}", "{x!=0&&(y/x>0||x<y)}"]
    for platform in 0..4 {
        for selected in 0..sources.len {
            var ret := 2; if selected == 3 { ret = 3 }
            f := body(sources[selected], ret)
            var plan := alloc.new(); alloc.allocate_into(&mut plan, &f)
            for value in 0..plan.homes.len { plan.homes[value] = -1 }
            for const_div in [false, true] {
                var settings := emitter.options(); settings.const_div_enabled = const_div
                var function := arm.new_for(platform)
                for label in 0..4 { allocated := arm.label(&mut function) }
                emitter.emit_prepared_configured(&mut function, &f, &plan, 0, 1, 2, 3, &settings)
                // Two i64 parameters: four prologue words, two stores, and
                // two load/store pairs. The return branch follows the expr.
                first := 10; var last := -1
                for reloc in 0..function.at.len {
                    if function.target[reloc] == 4 && function.kinds[reloc] == 0 { last = function.at[reloc]; break }
                }
                assert(last >= first)
                var expression := arm.new_for(platform)
                for label in 0..5 { allocated := arm.label(&mut expression) }
                arm.mark(&mut expression, 0)
                for at in 0..first { arm.emit(&mut expression, function.words[at]) }
                emitter.emit_expression(&mut expression, &f.nodes, &f.local_types, &plan, expression_root(&f), 1, 2, 3, &settings)
                assert(expression.words.len == last && expression.labels.len == function.labels.len)
                for at in first..last { assert(expression.words[at] == function.words[at]) }
                var actual := 0
                for reloc in 0..function.at.len {
                    if function.at[reloc] >= first && function.at[reloc] < last {
                        assert(expression.at[actual] == function.at[reloc])
                        assert(expression.target[actual] == function.target[reloc] && expression.kinds[actual] == function.kinds[reloc])
                        actual = actual + 1
                    }
                }
                assert(actual == expression.at.len)
                for label in 5..function.labels.len { assert(expression.labels[label] == function.labels[label]) }
            }
        }
    }
}
@test fn physical_frame_maps_are_explicit_and_reset_on_reallocation() {
    f := body("{x+y}", 2)
    var plan := alloc.new(); alloc.allocate_into(&mut plan, &f)
    assert(plan.frame_slots.len == 0)
    for value in 0..plan.homes.len { plan.homes[value] = -1 }
    plan.frame_slots.push(37); plan.frame_slots.push(620)
    var code := arm.new()
    for label in 0..3 { allocated := arm.label(&mut code) }
    settings := emitter.options()
    emitter.emit_expression(&mut code, &f.nodes, &f.local_types, &plan, expression_root(&f), 0, 1, 2, &settings)
    assert(code.words.len > 0 && code.words[0] != 2847898621)
    for word in code.words { assert(word != 3596551104) }
    alloc.allocate_into(&mut plan, &f)
    assert(plan.frame_slots.len == 0)
}
