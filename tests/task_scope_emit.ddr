import ..selfhost.backend.arm64 as arm
import ..selfhost.runtime.runtime
import ..selfhost.tasks.task_scope_emit as scope

@test fn scope_helpers_encode_the_exact_full_width_generation_shift() {
    mut c := arm.new(); rt := runtime.new(&mut c); trap := arm.label(&mut c)
    r := scope.emit_runtime(&mut c, &rt, trap, trap); assert(r.ok)
    mut shifts := 0
    for at in c.labels[r.await_result]..c.labels[r.close] {
        if c.words[at] == 3546348586 { shifts = shifts + 1 }
        assert(c.words[at] != 3546413098)
    }
    assert(shifts == 1 && r.open >= 0 && r.close >= 0)
}
@test fn scope_helper_emission_cannot_enter_a_source_mir_capture_or_unsupported_target() {
    for platform in 0..4 {
        mut c := arm.new_for(platform); rt := runtime.new(&mut c); trap := arm.label(&mut c)
        if platform < 3 { arm.begin_mir(&mut c, true) }
        before := c.words.len; labels := c.labels.len
        r := scope.emit_runtime(&mut c, &rt, trap, trap)
        assert(!r.ok && r.error != "" && c.words.len == before && c.labels.len == labels)
    }
    for platform in 0..3 {
        mut profiled := arm.new_for(platform); profiled.profile = true
        rt := runtime.new(&mut profiled); trap := arm.label(&mut profiled)
        before := profiled.words.len; labels := profiled.labels.len
        r := scope.emit_runtime(&mut profiled, &rt, trap, trap)
        assert(!r.ok && r.error != "" && profiled.words.len == before && profiled.labels.len == labels)
        mut native := arm.new_for(platform); nrt := runtime.new(&mut native); ntrap := arm.label(&mut native)
        nr := scope.emit_runtime(&mut native, &nrt, ntrap, ntrap)
        assert(nr.ok && nr.open >= 0 && nr.spawn >= 0 && nr.close >= 0)
    }
}
@test fn task_kind_validates_callback_labels_and_static_storage_before_emission() {
    mut c := arm.new(); rt := runtime.new(&mut c); trap := arm.label(&mut c)
    r := scope.emit_runtime(&mut c, &rt, trap, trap); assert(r.ok)
    spec := scope.KindSpec { result_type: 1, create: trap, collect: trap, discard: trap,
        result_clone: -1, result_drop: -1 }
    before := c.words.len; labels := c.labels.len
    invalid := scope.emit_kind(&mut c, &r, &spec, -2)
    assert(!invalid.ok && c.words.len == before && c.labels.len == labels)
    valid := scope.emit_kind(&mut c, &r, &spec, -97)
    assert(valid.ok && valid.spawn >= 0 && valid.import_sites.len == 1 && valid.import_slots[0] == -97)
    arm.begin_mir(&mut c, true); captured_words := c.words.len; captured_labels := c.labels.len
    captured := scope.emit_kind(&mut c, &r, &spec, -177)
    assert(!captured.ok && c.words.len == captured_words && c.labels.len == captured_labels)
    assert(scope.coordinator_bytes() == 32 && scope.kind_bytes() == 64 && scope.scope_bytes() == 128 && scope.entry_bytes() == 160)
}
fn main() {}
