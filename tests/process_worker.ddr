// Unprivileged worker module: no capability header at all.
import std.fs as fs
import std.process as process

pub fn run_granted_echo(sh: &process.Executable, msg: string) -> string {
    out := process.run_granted(&sh, ["-c", "printf '%s' \"$1\"", "sh", msg])
    assert(process.succeeded(&out))
    process.stdout_text(&out)
}

pub fn count_granted_dir(dir: &fs.ReadDir) -> i32 {
    res := fs.list_read_dir(&dir)
    assert(res.ok)
    res.entries.len
}
