import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_decode as decode
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_retained as retained
import ..selfhost.mir_lower as lower

fn model(code: &arm.Code, annotated: bool) -> mir.Function {
    var f := mir.new(); sites: []i32 = []
    if annotated {
        assert(lift.lift_spans(&mut f, &code, 0, 0, 0, &sites, 0,
            &code.mir_starts, &code.mir_ends, &code.mir_kinds, &code.mir_a, &code.mir_b))
    } else { assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0)) }
    assert(verify.verify(&mut f)); f
}
fn code_for(platform: i32) -> arm.Code {
    var code := arm.new_for(platform); arm.begin_mir(&mut code, true)
    arm.push_temp(&mut code, 8); arm.push(&mut code, 9)
    arm.pop(&mut code, 10); arm.pop_temp(&mut code, 11)
    arm.emit(&mut code, 3596551104); arm.end_mir(&mut code); code
}
@test fn stack_origins_default_to_raw_and_reset_with_the_operation_arena() {
    var f := mir.new(); assert(f.stack_roles.len == 0)
    for count in [1, 128, 2, 0, 17] {
        mir.reset(&mut f)
        for n in 0..count { op := mir.add(&mut f, 10); assert(f.stack_roles[op] == 0); f.stack_roles[op] = 1 }
        assert(f.stack_roles.len == count)
    }
    mir.reset(&mut f); assert(f.stack_roles.len == 0)
    op := mir.add(&mut f, 18); assert(f.stack_roles[op] == 0)
}
@test fn only_explicit_current_function_capture_declares_temporary_origin() {
    var code := arm.new(); arm.push_temp(&mut code, 0); arm.pop_temp(&mut code, 1)
    assert(code.mir_starts.len == 0)
    arm.begin_mir(&mut code, true)
    arm.push(&mut code, 2); arm.pop(&mut code, 3)
    assert(code.mir_starts.len == 0)
    arm.push_temp(&mut code, 4); arm.pop_temp(&mut code, 5)
    assert(code.mir_starts.len == 2 && code.mir_starts[0] == 4 && code.mir_ends[0] == 5)
    assert(code.mir_kinds[0] == 4 && code.mir_a[0] == 4 && code.mir_b[0] == 0)
    assert(code.mir_kinds[1] == 5 && code.mir_a[1] == 5 && code.mir_b[1] == 0)
    arm.end_mir(&mut code); arm.push_temp(&mut code, 6); arm.pop_temp(&mut code, 7)
    assert(code.mir_starts.len == 2)
    var checking := arm.new_check(3); arm.begin_mir(&mut checking, true)
    arm.push_temp(&mut checking, 0); arm.pop_temp(&mut checking, 1)
    assert(!checking.mir_capture && checking.mir_starts.len == 0 && checking.virtual_words == 2)
}
@test fn all_registers_and_targets_keep_exact_stack_words_and_conservative_effects() {
    var d := decode.new()
    for platform in 0..4 { for reg in 0..32 {
        var code := arm.new_for(platform); arm.begin_mir(&mut code, true)
        arm.push_temp(&mut code, reg); arm.pop_temp(&mut code, reg); arm.emit(&mut code, 3596551104)
        arm.end_mir(&mut code); f := model(&code, true)
        assert(code.words[0] == 2847899616 + i64(reg) && code.words[1] == 2831253472 + i64(reg))
        assert(f.kinds[0] == 10 && f.kinds[1] == 11 && f.stack_roles[0] == 1 && f.stack_roles[1] == 1)
        assert(f.recipes[0] == 6 && f.recipes[1] == 7 && f.stack_roles[2] == 0)
        assert(f.effects[0] == 37 && f.effects[1] == 35)
        assert(f.reads[0].bit_and(mir.variable_bit(31)) != 0 && f.writes[0] == mir.variable_bit(31))
        assert(f.reads[1] == mir.variable_bit(31) && f.writes[1].bit_and(mir.variable_bit(31)) != 0)
        assert(retained.validate(&mut d, &f, 0) && retained.validate(&mut d, &f, 1))
        // A raw decoder/lift cannot recreate a producer declaration from bytes.
        raw := model(&code, false); assert(raw.stack_roles[0] == 0 && raw.stack_roles[1] == 0)
        decode.word(&mut d, code.words[0], platform); assert(d.stack_role == 0 && d.effects == 37)
        decode.word(&mut d, code.words[1], platform); assert(d.stack_role == 0 && d.effects == 35)
    } }
}
@test fn origins_can_coexist_with_raw_argument_like_pushes_without_reclassifying_them() {
    for platform in 0..4 {
        code := code_for(platform); f := model(&code, true)
        assert(f.stack_roles.len == 5 && f.stack_roles[0] == 1 && f.stack_roles[1] == 0 &&
            f.stack_roles[2] == 0 && f.stack_roles[3] == 1 && f.stack_roles[4] == 0)
        assert(f.recipes[1] == 0 && f.recipes[2] == 0 && f.optimizable)
    }
}
@test fn corrupt_capture_register_kind_reserved_width_and_overlap_are_rejected() {
    sites: []i32 = []; code := code_for(0)
    assert(!decode.valid_span_encoding(&code.words, 2147483647, 2147483647, 4, 0, 0))
    assert(!decode.valid_span_encoding(&code.words, 0, 2147483647, 4, 0, 0))
    for damage in 0..8 {
        var starts := code.mir_starts; var ends := code.mir_ends; var kinds := code.mir_kinds
        var a := code.mir_a; var b := code.mir_b
        if damage == 0 { a[0] = 7 }
        if damage == 1 { a[0] = 32 }
        if damage == 2 { kinds[0] = 5 }
        if damage == 3 { kinds[0] = 6 }
        if damage == 4 { b[0] = 1 }
        if damage == 5 { ends[0] = ends[0] + 1 }
        if damage == 6 { starts[1] = starts[0]; ends[1] = ends[0] }
        if damage == 7 { starts[0] = -1 }
        var f := mir.new()
        assert(!lift.lift_spans(&mut f, &code, 0, 0, 0, &sites, 0, &starts, &ends, &kinds, &a, &b) && !f.valid)
    }
}
@test fn origin_and_maytrap_cannot_be_forged_or_erased_in_retained_semantics() {
    code := code_for(0); f := model(&code, true); var d := decode.new()
    for damage in 0..11 {
        var bad := f
        if damage == 0 { bad.stack_roles[0] = 0 }
        if damage == 1 { bad.stack_roles[1] = 1 }
        if damage == 2 { bad.stack_roles[4] = 1 }
        if damage == 3 { bad.stack_roles[0] = 2 }
        if damage == 4 { bad.stack_roles[0] = -1 }
        if damage == 5 { bad.effects[0] = 36 }
        if damage == 6 { bad.effects[3] = 34 }
        if damage == 7 { bad.recipes[0] = 7 }
        if damage == 8 { bad.raw[0] = bad.raw[0] + 1 }
        if damage == 9 { bad.widths[0] = 2 }
        if damage == 10 { removed := bad.stack_roles.pop() }
        assert(!verify.verify(&mut bad) && !bad.verified)
    }
    var nonstack := f; nonstack.stack_roles[4] = 1; nonstack.modes[4] = 1
    assert(!verify.verify(&mut nonstack))
    var raw := model(&code, false); raw.stack_roles[0] = 1
    assert(!retained.validate(&mut d, &raw, 0))
    // Complete re-decode resets the previous positive origin on a raw row.
    assert(retained.validate(&mut d, &f, 0) && d.stack_role == 1)
    assert(retained.validate(&mut d, &f, 1) && d.stack_role == 0)
}
@test fn capture_preserves_frame_annotations_and_lowering_is_byte_identical() {
    for platform in 0..4 {
        var code := arm.new_for(platform); arm.begin_mir(&mut code, true)
        frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 600)
        arm.store(&mut code, 511, 0); arm.push_temp(&mut code, 0)
        arm.load(&mut code, 511); arm.pop_temp(&mut code, 1); arm.address(&mut code, 511); arm.ret(&mut code)
        arm.end_mir(&mut code); f := model(&code, true)
        assert(code.mir_kinds.len == 5 && code.mir_kinds[0] == 2 && code.mir_kinds[1] == 4 &&
            code.mir_kinds[2] == 1 && code.mir_kinds[3] == 5 && code.mir_kinds[4] == 3)
        expected := code.words; var work := lower.new(); var sites: []i32 = []
        assert(lower.prepare(&mut work, &f, &code, &sites)); lower.commit_code(&mut work, &mut code); lower.commit_imports(&mut work, &mut sites)
        assert(code.words.len == expected.len)
        for at in 0..expected.len { assert(code.words[at] == expected[at]) }
    }
}
@test fn temporary_origin_does_not_claim_cfg_balance_or_mapped_storage() {
    var code := arm.new(); arm.begin_mir(&mut code, true); arm.pop_temp(&mut code, 0); arm.emit(&mut code, 3596551104)
    arm.end_mir(&mut code); f := model(&code, true)
    assert(f.stack_roles[0] == 1 && f.effects[0].bit_and(1) != 0 && !f.optimizable)
    var branch := arm.new(); arm.begin_mir(&mut branch, true); done := arm.label(&mut branch)
    arm.branch(&mut branch, done, 18); arm.push_temp(&mut branch, 0); arm.mark(&mut branch, done)
    arm.pop_temp(&mut branch, 1); arm.emit(&mut branch, 3596551104); arm.end_mir(&mut branch)
    joined := model(&branch, true); assert(!joined.optimizable)
}
fn main() {}
