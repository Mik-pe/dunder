import std.random as random

fn main() {
    assert(random.bytes(-1) == .Err(.InvalidArgument))
    assert(random.bytes(1048577) == .Err(.TooLarge))
    assert(random.bytes(0).unwrap().len == 0)
    if target_is("wasm32") && !target_is("wasi") {
        assert(random.bytes(1) == .Err(.Unsupported))
        return
    }
    first := random.bytes(8192).unwrap()
    mut second := first.clone()
    assert(random.fill(&mut second).is_ok())
    assert(first.len == second.len && first != second)
}
