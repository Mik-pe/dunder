import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_opt as frame
import ..selfhost.mir_memory as memory
import ..selfhost.mir_terminals as terminals
import ..selfhost.mir_call_abi as calls
import ..selfhost.mir_verify as verify
import ..selfhost.mir_preserve as preservation
import "fixtures/mir-frame-exit-support" as support

@test fn unknown_external_boundaries_refuse_raw_and_memory_only_without_mutation() {
    var work := frame.new(); source := memory.trusted_source_objects_v1()
    for platform in 0..4 { for mode in [1, 2, 3, 4, 5, 7, 9] {
        var code := arm.new(); var sites: []i32 = []; var f := mir.new()
        support.build(&mut code, &mut sites, &mut f, platform, mode); before := f
        assert(!frame.analyze_into(&mut work, &f) && frame.status(&work) == -2)
        support.same(&f, &before)
        assert(!frame.analyze_with_context(&mut work, &f, &source) && frame.status(&work) == -2)
        support.same(&f, &before)
    } }
}
@test fn only_exact_explicit_unobserving_jumps_allow_frame_promotion() {
    var work := frame.new(); raw := memory.conservative(); source := memory.trusted_source_objects_v1()
    for platform in 0..4 { for mode in [1, 2, 9] {
        var code := arm.new(); var sites: []i32 = []; var f := mir.new()
        support.build(&mut code, &mut sites, &mut f, platform, mode)
        ctx := support.context(1); before := f
        assert(frame.analyze_with_terminals(&mut work, &f, &raw, &ctx) && frame.promoted(&work) == 1)
        support.same(&f, &before)
        frame.apply(&mut work, &mut f); assert(verify.verify(&mut f))
        var second := mir.new(); var code2 := arm.new(); var sites2: []i32 = []
        support.build(&mut code2, &mut sites2, &mut second, platform, mode)
        assert(frame.analyze_with_terminals(&mut work, &second, &source, &ctx))
        frame.apply(&mut work, &mut second); assert(verify.verify(&mut second))
    } }
}
@test fn terminal_contract_does_not_cover_fallthrough_traps_or_indirect_control() {
    var work := frame.new(); source := memory.trusted_source_objects_v1(); ctx := support.context(1)
    for mode in [3, 4, 5] {
        var code := arm.new(); var sites: []i32 = []; var f := mir.new()
        support.build(&mut code, &mut sites, &mut f, 0, mode); before := f
        assert(!frame.analyze_with_terminals(&mut work, &f, &source, &ctx) && frame.status(&work) == -2)
        support.same(&f, &before)
    }
}
@test fn every_reachable_external_target_needs_its_own_exact_promise() {
    var code := arm.new(); var sites: []i32 = []; var f := mir.new(); var work := frame.new()
    support.build(&mut code, &mut sites, &mut f, 0, 7); source := memory.trusted_source_objects_v1()
    var ctx := support.context(1); before := f
    assert(!frame.analyze_with_terminals(&mut work, &f, &source, &ctx) && frame.status(&work) == -2)
    support.same(&f, &before)
    ctx.float_trap = 2
    assert(frame.analyze_with_terminals(&mut work, &f, &source, &ctx))
    frame.apply(&mut work, &mut f); assert(verify.verify(&mut f))
}
@test fn label_zero_is_an_exact_terminal_id_not_an_absent_sentinel() {
    var work := frame.new(); source := memory.conservative(); ctx := support.context(0)
    assert(terminals.valid(&ctx) && terminals.allows(&ctx, 0) && !terminals.allows(&ctx, 1))
    for platform in 0..4 {
        var code := arm.new(); var sites: []i32 = []; var f := mir.new()
        support.build(&mut code, &mut sites, &mut f, platform, 10)
        assert(frame.analyze_with_terminals(&mut work, &f, &source, &ctx))
        frame.apply(&mut work, &mut f); assert(verify.verify(&mut f))
    }
}
@test fn normal_returns_unreachable_exits_and_call_fences_keep_their_contracts() {
    var work := frame.new(); source := memory.trusted_source_objects_v1(); ctx := support.context(1)
    abi := calls.trusted_source_abi_v1()
    for mode in [0, 6, 8] {
        var code := arm.new(); var sites: []i32 = []; var f := mir.new()
        support.build(&mut code, &mut sites, &mut f, 0, mode)
        if mode == 8 {
            before := f
            assert(!frame.analyze_into(&mut work, &f) && frame.status(&work) == -2)
            assert(!frame.analyze_with_terminals(&mut work, &f, &source, &ctx) && frame.status(&work) == -2)
            support.same(&f, &before)
        } else { assert(frame.analyze_into(&mut work, &f)) }
        before := f
        assert(frame.analyze_with_contracts(&mut work, &f, &source, &ctx, &abi))
        var count := 0; if mode == 8 { count = 1 }; assert(frame.barrier_count(&work) == count)
        frame.apply(&mut work, &mut f); assert(verify.verify(&mut f))
        for op in 0..before.kinds.len { if before.kinds[op] == 14 {
            assert(f.reads[op] == before.reads[op] && f.writes[op] == before.writes[op])
            assert(f.clobbers[op] == before.clobbers[op] && f.flags[op] == before.flags[op])
            assert(f.effects[op] == before.effects[op] && f.abi[op] == before.abi[op])
        } }
    }
}
@test fn call_abi_promise_neither_implies_unobserving_exits_nor_memory_no_mod_ref() {
    var code := arm.new(); var sites: []i32 = []; var f := mir.new(); var work := frame.new()
    support.build(&mut code, &mut sites, &mut f, 0, 1)
    abi := calls.trusted_source_abi_v1(); raw := memory.conservative(); none := terminals.no_terminals(); before := f
    assert(!frame.analyze_with_contracts(&mut work, &f, &raw, &none, &abi) && frame.status(&work) == -2)
    support.same(&f, &before)
    var call_code := arm.new(); var call_sites: []i32 = []; var call_f := mir.new()
    support.build(&mut call_code, &mut call_sites, &mut call_f, 0, 8)
    assert(frame.analyze_with_contracts(&mut work, &call_f, &raw, &none, &abi))
    assert(frame.barrier_count(&work) == 1)
    // A frame-lifetime promise alone does not hide incoming call SP or
    // X25..28. It cannot authorize this pass's extra frame/register homes.
    frame_only := calls.trusted_frame_lifetime_v1(); unchanged := call_f
    assert(!frame.analyze_with_contracts(&mut work, &call_f, &raw, &none, &frame_only) && frame.status(&work) == -2)
    support.same(&call_f, &unchanged)
}
@test fn noreturn_and_memory_provenance_alone_cannot_certify_register_observations() {
    var code := arm.new(); var sites: []i32 = []; var f := mir.new(); var work := frame.new()
    support.build(&mut code, &mut sites, &mut f, 0, 1)
    var noreturn := preservation.context(1); assert(preservation.declare_noreturn(&mut noreturn, 1))
    // That declaration has no implicit conversion to an unobserving contract.
    source := memory.trusted_source_objects_v1(); none := terminals.no_terminals(); before := f
    assert(!frame.analyze_with_terminals(&mut work, &f, &source, &none) && frame.status(&work) == -2)
    support.same(&f, &before)
}
@test fn terminal_versions_are_closed_and_version_zero_ignores_all_ids() {
    var work := frame.new(); source := memory.conservative()
    var code := arm.new(); var sites: []i32 = []; var f := mir.new()
    support.build(&mut code, &mut sites, &mut f, 0, 1); before := f
    var ctx := terminals.new(); ctx.overflow = 1; ctx.zero = 1; ctx.assertion = 1; ctx.io = 1; ctx.bounds = 1; ctx.float_trap = 1
    assert(terminals.valid(&ctx) && !terminals.allows(&ctx, 1))
    assert(!frame.analyze_with_terminals(&mut work, &f, &source, &ctx) && frame.status(&work) == -2)
    support.same(&f, &before)
    ctx.version = 2
    assert(!frame.analyze_with_terminals(&mut work, &f, &source, &ctx) && frame.status(&work) == -1)
    support.same(&f, &before)
    ctx.version = 1; ctx.bounds = -1
    assert(!frame.analyze_with_terminals(&mut work, &f, &source, &ctx) && frame.status(&work) == -1)
    support.same(&f, &before)
    ctx.bounds = 1; ctx.overflow = 2; ctx.zero = 2; ctx.assertion = 2; ctx.io = 2; ctx.float_trap = 2; ctx.bounds = 2
    assert(!frame.analyze_with_terminals(&mut work, &f, &source, &ctx) && frame.status(&work) == -2)
    support.same(&f, &before)
}
@test fn budget_refusal_preserves_every_field_including_labels_imports_and_certificate() {
    var code := arm.new(); var sites: []i32 = []; var f := mir.new(); var work := frame.new()
    support.build(&mut code, &mut sites, &mut f, 0, 9)
    source := memory.trusted_source_objects_v1(); ctx := support.context(1); before := f
    assert(frame.analyze_with_terminals(&mut work, &f, &source, &ctx)); budget := frame.units(&work)
    assert(f.import_ids.len > 0 && f.label_ids.len > 0 && sites.len == 1)
    for limit in [0, 1, budget - 1] {
        assert(!frame.analyze_with_terminals_budget(&mut work, &f, &source, &ctx, limit) && frame.status(&work) == -3)
        assert(frame.units(&work) <= limit); support.same(&f, &before)
    }
    assert(frame.analyze_with_terminals_budget(&mut work, &f, &source, &ctx, budget))
    support.same(&f, &before); frame.apply(&mut work, &mut f); assert(verify.verify(&mut f))
}
fn main() {}
