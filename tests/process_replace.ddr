capability process, filesystem, unsafe, stdio
import ..stdlib.process as process
import std.bytes as bytes
import std.fs as fs
import std.json as json
import sys

@extern("c", "read")
unsafe fn c_read(fd: i32, buffer: ptr, length: usize) -> i64

fn stdin_bytes() -> []u8 {
    mut output: []u8 = []
    unsafe {
        mut buffer: [u8; 64] = [0; 64]
        while true {
            mut count: i64 = 0
            if target_is("macos") { count = c_read(0, addr(&mut buffer[0]), 64) }
            else if target_is("linux") {
                count = sys.linux_syscall(63, 0, i64(usize(addr(&mut buffer[0]))), 64, 0, 0, 0)
            }
            assert(count >= 0)
            if count == 0 { break }
            for i in 0..i32(count) { output.push(buffer[i]) }
        }
    }
    output
}

fn probe(wait: bool) -> i32 {
    mut output: []u8 = []
    mut first := json.begin_obj(&mut output)
    json.field_i32(&mut output, &mut first, "pid", sys.pid())
    json.field_str(&mut output, &mut first, "argv0", sys.arg(0))
    json.field_str(&mut output, &mut first, "cwd", fs.cwd().value)
    json.field_str(&mut output, &mut first, "environment", process.env("DUNDER_REPLACE_SENTINEL").unwrap())
    mut first_arg := json.begin_field_arr(&mut output, &mut first, "args")
    for i in 1..sys.arg_count() {
        json.sep_elem(&mut output, &mut first_arg)
        json.write_str(&mut output, sys.arg(i))
    }
    json.end_arr(&mut output)
    if !wait {
        input := stdin_bytes()
        json.field_str(&mut output, &mut first, "stdin_hex", bytes.hex_u8(&input))
    }
    json.end_obj(&mut output)
    print(bytes.decode(&output).unwrap())
    _ := sys.eprint("probe stderr")
    while wait { sys.sleep_ms(100) }
    37
}

fn main() -> i32 {
    assert(sys.arg_count() >= 2)
    mode := sys.arg(1)
    if mode == "probe" { return probe(false) }
    if mode == "wait" { return probe(true) }
    if mode == "replace" || mode == "replace-as" {
        assert(sys.arg_count() >= 3)
        program := sys.arg(2)
        mut args: []string = []
        mut from := 3
        if mode == "replace-as" { assert(sys.arg_count() >= 4); from = 4 }
        for i in from..sys.arg_count() { args.push(sys.arg(i)) }
        mut result := sys.Status { ok: false, error: 22 }
        if mode == "replace" { result = process.replace(program, &args) }
        else { result = process.replace_as(program, sys.arg(3), &args) }
        print("exec failed " + result.error.str())
        return 99
    }
    assert(mode == "failures")
    original_pid := sys.pid()
    cwd := fs.cwd().value
    original_env := process.env("DUNDER_REPLACE_SENTINEL").unwrap()
    empty: []string = []
    assert(!process.replace("", &empty).ok)
    assert(process.replace("", &empty).error == 22)
    assert(process.replace_as("/bin/echo", "", &empty).error == 22)
    assert(process.replace("/definitely/not/a/dunder/executable", &empty).error == 2)
    assert(process.replace("dunder-missing-replace-fixture", &empty).error == 2)
    bad: []string = ["first", "bad\0argument"]
    assert(process.replace("/bin/echo", &bad).error == 22)
    assert(process.replace("/bin/echo\0suffix", &empty).error == 22)
    assert(process.replace_as("/bin/echo", "bad\0argv0", &empty).error == 22)
    assert(sys.pid() == original_pid && fs.cwd().value == cwd)
    assert(process.env("DUNDER_REPLACE_SENTINEL").unwrap() == original_env)
    input := stdin_bytes()
    assert(bytes.hex_u8(&input) == "00017fff")
    print("replace failures preserve caller")
    _ := sys.eprint("failure stderr")
    0
}
