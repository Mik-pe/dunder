import std.bytes as bytes
import std.parse as parse

fn record_push(trace: &mut []i32, value: i32) { trace.push(value) }

fn defer_order_return(trace: &mut []i32, early: bool) -> i32 {
    defer { record_push(&mut trace, 1) }
    {
        defer { record_push(&mut trace, 2) }
        if early {
            defer { record_push(&mut trace, 3) }
            return 10
        }
        record_push(&mut trace, 4)
    }
    record_push(&mut trace, 5)
    20
}

fn defer_in_loops(trace: &mut []i32) {
    for i in 0..4 {
        defer { record_push(&mut trace, 100 + i) }
        if i == 1 { continue }
        if i == 3 { break }
        record_push(&mut trace, i)
    }
}

struct Counter { calls: i32 }

fn trace_condition(trace: &mut []i32, condition: bool) -> bool {
    trace.push(1)
    condition
}

fn trace_value(trace: &mut []i32, value: i32) -> i32 {
    trace.push(value)
    value
}

@test
fn if_expression_selects_one_branch() {
    mut trace: []i32 = []
    for i in 0..3 {
        value := 10 + if trace_condition(&mut trace, i == 0) {
            trace_value(&mut trace, 2)
        } else if trace_condition(&mut trace, i == 1) {
            trace_value(&mut trace, 3)
        } else {
            trace_value(&mut trace, 4)
        }
        assert(value == 12 + i)
    }
    assert(trace.len == 8)
    assert(trace[0] == 1 && trace[1] == 2)
    assert(trace[2] == 1 && trace[3] == 1 && trace[4] == 3)
    assert(trace[5] == 1 && trace[6] == 1 && trace[7] == 4)
}

enum Verdict { Accept, Reject }

fn accepted(value: Verdict) -> bool { value == .Accept }

struct Choice { text: string, values: []i32 }

@test
fn if_expression_preserves_type_and_ownership() {
    for i in 0..4 {
        even := i % 2 == 0
        wide: i64 = if even { 3000000000 } else { -3000000000 }
        assert((wide > 0) == even)
        assert(accepted(if even { .Accept } else { .Reject }) == even)

        mut original := Choice { text: "value" + i.str(), values: [i] }
        mut choice := if even { original.clone() } else { Choice { text: i.str(), values: [i + 10] } }
        choice.values.push(42)
        assert(original.values.len == 1 && choice.values.len == 2)
        if even {
            assert(choice.text == "value" + i.str() && choice.values[0] == i)
        } else {
            assert(choice.text == i.str() && choice.values[0] == i + 10)
        }
    }
}

enum Selection { Some(Choice), Empty }

fn observed_verdict(trace: &mut []i32, value: Verdict) -> Verdict {
    trace.push(1)
    value
}

@test
fn match_expression_selects_one_arm() {
    mut trace: []i32 = []
    for verdict in [Verdict.Accept, Verdict.Reject] {
        value := 40 + match observed_verdict(&mut trace, verdict) {
            .Accept => trace_value(&mut trace, 2),
            _ => { trace_value(&mut trace, 3) },
        }
        assert(value == 42 + i32(verdict))
        assert(accepted(match verdict { .Accept => .Accept, _ => .Reject }) == accepted(verdict))
    }
    assert(trace.len == 4)
    assert(trace[0] == 1 && trace[1] == 2 && trace[2] == 1 && trace[3] == 3)
}

@test
fn match_expression_keeps_payload_values_alive() {
    for i in 0..4 {
        mut source := Selection.Some(Choice { text: "label" + i.str(), values: [i] })
        payload := "outer"
        mut choice := match source {
            .Some(payload) => payload.clone(),
            .Empty => Choice { text: "", values: [] },
        }
        mut values: []i32 = match source { .Some(payload) => payload.values.clone(), _ => [] }
        text := match source {
            .Some(payload) => if i == 0 { payload.text.clone() } else { payload.text + "!" },
            .Empty => "",
        }
        source = .Empty
        values.push(99)
        assert(choice.values.len == 1 && choice.values[0] == i)
        choice.values.push(42)
        assert(values.len == 2 && values[0] == i && values[1] == 99)
        assert(choice.text == "label" + i.str() && payload == "outer")
        assert(text == if i == 0 { choice.text.clone() } else { choice.text + "!" })
        wide: i64 = match source {
            .Some(_) => 0,
            _ => match Verdict.Reject { .Accept => -3000000000, .Reject => 3000000000 },
        }
        assert(wide == 3000000000)
    }
}

enum ReadFailure { NotFound, Other(i32, Choice), Retry(Verdict) }
enum ReadOutcome { Ok(Choice), Err(ReadFailure) }

fn counted_outcome(counter: &mut Counter, outcome: ReadOutcome) -> ReadOutcome {
    counter.calls += 1
    outcome.clone()
}

fn recover_choice(counter: &mut Counter, outcome: ReadOutcome) -> Choice {
    selected := match move counted_outcome(&mut counter, outcome) {
        .Err(.NotFound) => Choice { text: "missing", values: [] },
        .Err(.Other(_, saved)) => saved,
        .Err(.Retry(.Accept)) => Choice { text: "retry", values: [] },
        .Err(_) => Choice { text: "failed", values: [] },
        .Ok(value) => value,
    }
    selected
}

@test
fn nested_patterns_keep_owned_bindings_and_evaluate_subject_once() {
    mut counter := Counter { calls: 0 }
    for i in 0..4 {
        original := Choice { text: "saved" + i.str(), values: [i] }
        mut outcome := ReadOutcome.Err(.Other(7, original.clone()))
        mut recovered := recover_choice(&mut counter, outcome)
        outcome = .Err(.NotFound)
        recovered.values.push(42)
        assert(recovered.text == original.text && recovered.values[0] == i && recovered.values.len == 2)
        assert(original.values.len == 1)
        assert(recover_choice(&mut counter, outcome).text == "missing")
        assert(recover_choice(&mut counter, .Err(.Retry(.Accept))).text == "retry")
        assert(recover_choice(&mut counter, .Err(.Retry(.Reject))).text == "failed")
        assert(recover_choice(&mut counter, .Ok(original.clone())).text == original.text)
        assert(counter.calls == (i + 1) * 5)
    }
}

fn replace_then_reject(source: &mut ReadOutcome, trace: &mut []i32, code: i32) -> bool {
    trace.push(code)
    source = .Err(.NotFound)
    false
}

@test
fn match_guards_keep_the_subject_and_skip_unmatched_effects() {
    mut trace: []i32 = []
    for i in 0..4 {
        trace.clear()
        original := Choice { text: "saved" + i.str(), values: [i] }
        mut source := ReadOutcome.Err(.Other(i + 10, original.clone()))
        mut choice := match move source.clone() {
            .Ok(value) if trace_condition(&mut trace, true) => value,
            .Err(.Other(code, saved)) if replace_then_reject(&mut source, &mut trace, code) => saved,
            .Err(.Other(code, saved)) if trace_condition(&mut trace, saved.values[0] == code - 10) => saved,
            _ if trace_condition(&mut trace, true) => Choice { text: "unexpected", values: [] },
            _ => Choice { text: "fallback", values: [] },
        }
        assert(trace.len == 2 && trace[0] == i + 10 && trace[1] == 1)
        assert(choice.text == original.text && choice.values[0] == i)
        choice.values.push(42)
        assert(choice.values.len == 2 && original.values.len == 1)
        replaced := match source { .Err(.NotFound) => true, _ => false }
        assert(replaced)
    }
}

fn pick_slot(c: &mut Counter) -> i32 {
    c.calls += 1
    0
}

@test
fn byte_and_radix_literals() {
    a: u8 = b'A'
    cr: u8 = b'\r'
    lf: u8 = b'\n'
    tab: u8 = b'\t'
    nul: u8 = b'\0'
    hi: u8 = b'\x7f'
    bs: u8 = b'\\'
    assert(a == 65 && cr == 13 && lf == 10 && tab == 9 && nul == 0 && hi == 127 && bs == 92)
    assert(0xff == 255)
    assert(0x10_20 == 4128)
    assert(0b1010_0101 == 165)
    assert(parse.hex("7f").value == 127)
    assert(parse.hex("-1a").value == -26)
    assert(parse.i64_range("v=-420;", 2, 6).value == -420)
    assert(parse.u64_range("id=98765;", 3, 8).value == 98765)
    assert(parse.hex_u64_range("len: ff00!", 5, 9).value == 65280)
}

@test
fn compound_assignments_and_single_eval() {
    mut x: i32 = 10
    x += 5
    x -= 3
    x *= 4
    x /= 6
    x %= 5
    assert(x == 3)

    mut s := "http"
    s += "://127.0.0.1"
    s += "/ok"
    assert(s == "http://127.0.0.1/ok")

    mut arr := [10, 20]
    mut c := Counter { calls: 0 }
    arr[pick_slot(&mut c)] += 7
    assert(c.calls == 1)
    assert(arr[0] == 17)
}

@test
fn defer_lifo_and_borrow_loops() {
    mut trace: []i32 = []
    assert(defer_order_return(&mut trace, false) == 20)
    assert(trace.len == 4 && trace[0] == 4 && trace[1] == 2 && trace[2] == 5 && trace[3] == 1)

    trace.clear()
    assert(defer_order_return(&mut trace, true) == 10)
    assert(trace.len == 3 && trace[0] == 3 && trace[1] == 2 && trace[2] == 1)

    trace.clear()
    defer_in_loops(&mut trace)
    assert(trace.len == 6)
    assert(trace[0] == 0 && trace[1] == 100 && trace[2] == 101 && trace[3] == 2 && trace[4] == 102 && trace[5] == 103)

    names := ["GET", "POST", "HEAD"]
    mut total_len := 0
    for name in &names { total_len += name.len }
    assert(total_len == 11)
    assert(names[1] == "POST")

    nums: []i32 = [1, 2, 3]
    mut row_sum := 0
    for v in &nums { row_sum += v }
    assert(row_sum == 6)

    fixed := [4, 5, 6]
    mut fixed_sum := 0
    for v in &fixed { fixed_sum += v }
    assert(fixed_sum == 15)
}

fn capture_at_registration(trace: &mut []i32, mode: i32) -> string {
    mut captured := 1
    mut result := "before" + mode.str()
    {
        defer {
            trace.push(captured)
            result = "after" + mode.str()
        }
        captured += 10
        captured := 42
        if mode == 0 { return result.clone() }
        if mode == 1 { return result + "!" }
        trace.push(captured)
    }
    result
}

@test fn deferred_block_reads_current_capture_and_preserves_owned_return() {
    mut trace: []i32 = []
    assert(capture_at_registration(&mut trace, 0) == "before0")
    assert(capture_at_registration(&mut trace, 1) == "before1!")
    assert(capture_at_registration(&mut trace, 2) == "after2")
    assert(trace.len == 4)
    assert(trace[0] == 11 && trace[1] == 11 && trace[2] == 42 && trace[3] == 11)
}

@test
fn bytes_zero_copy_helpers() {
    mut buf: []u8 = []
    bytes.append_utf8(&mut buf, "GET /hello HTTP/1.1\r\nHost: LocalHost\r\nContent-Length: ")
    bytes.append_decimal(&mut buf, 123456789)
    bytes.append_utf8(&mut buf, "\r\n\r\nbody")

    crlf := bytes.find_crlf(&buf, 0, buf.len).unwrap_or(-1)
    assert(crlf == 19)
    end := bytes.find_double_crlf(&buf, 0, buf.len).unwrap_or(-1)
    assert(end > crlf)

    method := bytes.decode_range(&buf, 0, 3)
    assert(method.ok && method.value == "GET")
    assert(bytes.equals_text(&buf, 4, 10, "/hello"))
    assert(bytes.equals_ascii_ci(&buf, 21, 25, "host"))
    assert(!bytes.equals_ascii_ci(&buf, 21, 25, "host2"))

    mut out: []u8 = []
    bytes.extend_range(&mut out, &buf, end + 4, buf.len)
    decoded := bytes.decode_range(&out, 0, out.len)
    assert(decoded.ok && decoded.value == "body")

    bad := bytes.decode_range(&buf, -1, 2)
    assert(!bad.ok && bad.error == 22)

    bytes.consume_prefix(&mut buf, end + 4)
    rest := bytes.decode_range(&buf, 0, buf.len)
    assert(rest.ok && rest.value == "body")

    mut edge: []u8 = []
    bytes.append_decimal(&mut edge, 0)
    bytes.append_utf8(&mut edge, " ")
    bytes.append_decimal(&mut edge, -9223372036854775808)
    edge_text := bytes.decode_range(&edge, 0, edge.len)
    assert(edge_text.ok && edge_text.value == "0 -9223372036854775808")
}

@test fn literal_bit_methods_preserve_logical_width_and_receiver() {
    negative: i32 = -1
    negative.shr(0) == -1
    negative.shr(1) == 2147483647
    negative.shl(31) == -2147483648
    upper: i64 = -9223372036854775808
    upper.shr(63) == 1
    upper.bit_or(9).bit_and(0xffffffff) == 9
    upper.bit_xor(3).bit_not() == 9223372036854775804
    upper.wrapping_sub(1) == 9223372036854775807
    byte: u8 = 255
    byte.shl(7) == u8(128)
    byte.wrapping_add(3).wrapping_mul(9) == u8(18)
    half: u16 = 32769
    half.shl(1) == u16(2)
    half.shr(15) == u16(1)
    word: u32 = 2147483648
    word.shr(1).bit_and(0xffffffff) == u32(1073741824)
    full: u64 = 0xffffffffffffffff
    full.bit_and(0xffffffffffffffff).shr(60) == u64(15)
    full.bit_and(0) == u64(0)
}
