import std.bytes as bytes
import std.parse as parse

fn record_push(trace: &mut []i32, value: i32) { trace.push(value) }

fn defer_order_return(trace: &mut []i32, early: bool) -> i32 {
    defer { record_push(&mut trace, 1) }
    {
        defer { record_push(&mut trace, 2) }
        if early {
            defer { record_push(&mut trace, 3) }
            return 10
        }
        record_push(&mut trace, 4)
    }
    record_push(&mut trace, 5)
    20
}

fn defer_in_loops(trace: &mut []i32) {
    for i in 0..4 {
        defer { record_push(&mut trace, 100 + i) }
        if i == 1 { continue }
        if i == 3 { break }
        record_push(&mut trace, i)
    }
}

struct Counter { calls: i32 }

fn pick_slot(c: &mut Counter) -> i32 {
    c.calls += 1
    0
}

@test
fn byte_and_radix_literals() {
    a: u8 = b'A'
    cr: u8 = b'\r'
    lf: u8 = b'\n'
    tab: u8 = b'\t'
    nul: u8 = b'\0'
    hi: u8 = b'\x7f'
    bs: u8 = b'\\'
    assert(a == 65 && cr == 13 && lf == 10 && tab == 9 && nul == 0 && hi == 127 && bs == 92)
    assert(0xff == 255)
    assert(0x10_20 == 4128)
    assert(0b1010_0101 == 165)
    assert(parse.hex("7f").value == 127)
    assert(parse.hex("-1a").value == -26)
    assert(parse.i64_range("v=-420;", 2, 6).value == -420)
    assert(parse.u64_range("id=98765;", 3, 8).value == 98765)
    assert(parse.hex_u64_range("len: ff00!", 5, 9).value == 65280)
}

@test
fn compound_assignments_and_single_eval() {
    var x: i32 = 10
    x += 5
    x -= 3
    x *= 4
    x /= 6
    x %= 5
    assert(x == 3)

    var s := "http"
    s += "://127.0.0.1"
    s += "/ok"
    assert(s == "http://127.0.0.1/ok")

    var arr := [10, 20]
    var c := Counter { calls: 0 }
    arr[pick_slot(&mut c)] += 7
    assert(c.calls == 1)
    assert(arr[0] == 17)
}

@test
fn defer_lifo_and_borrow_loops() {
    var trace: []i32 = []
    assert(defer_order_return(&mut trace, false) == 20)
    assert(trace.len == 4 && trace[0] == 4 && trace[1] == 2 && trace[2] == 5 && trace[3] == 1)

    trace.clear()
    assert(defer_order_return(&mut trace, true) == 10)
    assert(trace.len == 3 && trace[0] == 3 && trace[1] == 2 && trace[2] == 1)

    trace.clear()
    defer_in_loops(&mut trace)
    // i=0: push 0, defer 100; i=1: continue -> defer 101; i=2: push 2, defer 102; i=3: break -> defer 103
    assert(trace.len == 6)
    assert(trace[0] == 0 && trace[1] == 100 && trace[2] == 101 && trace[3] == 2 && trace[4] == 102 && trace[5] == 103)

    names := ["GET", "POST", "HEAD"]
    var total_len := 0
    for name in &names { total_len += name.len }
    assert(total_len == 11)
    assert(names[1] == "POST")

    nums: []i32 = [1, 2, 3]
    var row_sum := 0
    for v in &nums { row_sum += v }
    assert(row_sum == 6)

    fixed := [4, 5, 6]
    var fixed_sum := 0
    for v in &fixed { fixed_sum += v }
    assert(fixed_sum == 15)
}

@test
fn bytes_zero_copy_helpers() {
    var buf: []u8 = []
    bytes.append_utf8(&mut buf, "GET /hello HTTP/1.1\r\nHost: LocalHost\r\nContent-Length: ")
    bytes.append_decimal(&mut buf, 123456789)
    bytes.append_utf8(&mut buf, "\r\n\r\nbody")

    crlf := bytes.find_crlf(&buf, 0, buf.len)
    assert(crlf == 19)
    end := bytes.find_double_crlf(&buf, 0, buf.len)
    assert(end > crlf)

    method := bytes.decode_range(&buf, 0, 3)
    assert(method.ok && method.value == "GET")
    assert(bytes.equals_text(&buf, 4, 10, "/hello"))
    assert(bytes.equals_ascii_ci(&buf, 21, 25, "host"))
    assert(!bytes.equals_ascii_ci(&buf, 21, 25, "host2"))

    var out: []u8 = []
    bytes.extend_range(&mut out, &buf, end + 4, buf.len)
    decoded := bytes.decode_range(&out, 0, out.len)
    assert(decoded.ok && decoded.value == "body")

    bad := bytes.decode_range(&buf, -1, 2)
    assert(!bad.ok && bad.error == 22)

    bytes.consume_prefix(&mut buf, end + 4)
    rest := bytes.decode_range(&buf, 0, buf.len)
    assert(rest.ok && rest.value == "body")

    var edge: []u8 = []
    bytes.append_decimal(&mut edge, 0)
    bytes.append_utf8(&mut edge, " ")
    bytes.append_decimal(&mut edge, -9223372036854775808)
    edge_text := bytes.decode_range(&edge, 0, edge.len)
    assert(edge_text.ok && edge_text.value == "0 -9223372036854775808")
}
