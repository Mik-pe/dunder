// Test-only ordered consumer of the public detached-object interface. Production
// linking remains coordinator-owned; this consumer makes every local relocation,
// label and import coordinate observable without access to lowerer's internals.
import ..selfhost.arm64 as arm
import ..selfhost.mir_lower as lower

pub fn append(object: &lower.FunctionObject, code: &mut arm.Code, sites: &mut []i32) {
    assert(lower.object_ready(&object) && lower.object_platform(&object) == code.platform)
    base := code.words.len
    assert(base <= 2147483647 - lower.object_word_count(&object))
    for i in 0..lower.object_label_count(&object) {
        id := lower.object_label_id(&object, i)
        assert(id >= 0 && id < code.labels.len)
        offset := lower.object_label_offset(&object, i)
        assert(offset >= -1 && offset <= lower.object_word_count(&object))
    }
    for i in 0..lower.object_reloc_count(&object) {
        at := lower.object_reloc_at(&object, i); target := lower.object_reloc_target(&object, i)
        assert(at >= 0 && at < lower.object_word_count(&object) && target >= 0 && target < code.labels.len)
    }
    for i in 0..lower.object_import_count(&object) {
        id := lower.object_import_id(&object, i); at := lower.object_import_byte_at(&object, i)
        assert(id >= 0 && id < sites.len && at >= 0 && at % 4 == 0 && base <= 536870911 - at / 4)
    }
    for i in 0..lower.object_word_count(&object) { code.words.push(lower.object_word(&object, i)) }
    for i in 0..lower.object_label_count(&object) {
        var at := lower.object_label_offset(&object, i); if at >= 0 { at = base + at }
        code.labels[lower.object_label_id(&object, i)] = at
    }
    for i in 0..lower.object_reloc_count(&object) {
        code.at.push(base + lower.object_reloc_at(&object, i))
        code.target.push(lower.object_reloc_target(&object, i)); code.kinds.push(lower.object_reloc_kind(&object, i))
    }
    for i in 0..lower.object_import_count(&object) {
        sites[lower.object_import_id(&object, i)] = base * 4 + lower.object_import_byte_at(&object, i)
    }
}
pub fn same_i32(a: &[]i32, b: &[]i32) {
    assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) }
}
pub fn same_i64(a: &[]i64, b: &[]i64) {
    assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) }
}
pub fn copy_code(dst: &mut arm.Code, src: &arm.Code) {
    dst.words.clear(); dst.labels.clear(); dst.at.clear(); dst.target.clear(); dst.kinds.clear()
    for i in 0..src.words.len { dst.words.push(src.words[i]) }
    for i in 0..src.labels.len { dst.labels.push(src.labels[i]) }
    for i in 0..src.at.len { dst.at.push(src.at[i]); dst.target.push(src.target[i]); dst.kinds.push(src.kinds[i]) }
}
pub fn same_code(a: &arm.Code, b: &arm.Code) {
    assert(a.platform == b.platform)
    same_i64(&a.words, &b.words); same_i32(&a.labels, &b.labels)
    same_i32(&a.at, &b.at); same_i32(&a.target, &b.target); same_i32(&a.kinds, &b.kinds)
}
