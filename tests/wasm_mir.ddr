import ..selfhost.backend.arm64 as arm
import ..selfhost.backend.floats
import ..selfhost.backend.wasm_abi
import ..selfhost.backend.wasm_mir
import ..selfhost.backend.wasm_native
import ..selfhost.frontend.place_emit
import ..selfhost.frontend.place_operation as place_op
import ..selfhost.mir.mir
import ..selfhost.mir.mir_lift as lift
import ..selfhost.mir.mir_pipeline as pipeline
import ..selfhost.mir.mir_verify as verify

struct BodyStats {
    ops: i32,
    local_get_ge8: i32,
    local_set_ge8: i32,
    blocks: i32,
    loops: i32,
    br_ifs: i32,
    br_tables: i32,
    flag_global_sets: i32,
    f64_adds: i32,
}

fn read_uleb(body: &[]u8, p_ref: &mut i32) -> i32 {
    mut p := p_ref
    mut val := 0
    mut shift := 0
    while p < body.len {
        byte := i32(body[p]); p += 1
        val = val.bit_or(byte.bit_and(127).shl(shift))
        if byte < 128 { break }
        shift += 7
    }
    p_ref = p
    val
}

fn skip_sleb(body: &[]u8, p_ref: &mut i32) {
    mut p := p_ref
    while p < body.len {
        byte := i32(body[p]); p += 1
        if byte < 128 { break }
    }
    p_ref = p
}

fn scan_body(body: &[]u8) -> BodyStats {
    mut s := BodyStats {
        ops: 0, local_get_ge8: 0, local_set_ge8: 0,
        blocks: 0, loops: 0, br_ifs: 0, br_tables: 0,
        flag_global_sets: 0, f64_adds: 0,
    }
    mut p := 0
    while p < body.len {
        op := i32(body[p]); p += 1; s.ops += 1
        if op == 2 { s.blocks += 1; p += 1 }
        else if op == 3 { s.loops += 1; p += 1 }
        else if op == 4 { p += 1 }
        else if op == 12 { _ := read_uleb(&body, &mut p) }
        else if op == 13 { s.br_ifs += 1; _ := read_uleb(&body, &mut p) }
        else if op == 14 {
            s.br_tables += 1
            count := read_uleb(&body, &mut p)
            for _ in 0..count + 1 { _ := read_uleb(&body, &mut p) }
        }
        else if op == 16 { _ := read_uleb(&body, &mut p) }
        else if op == 17 { _ := read_uleb(&body, &mut p); _ := read_uleb(&body, &mut p) }
        else if op == 32 {
            idx := read_uleb(&body, &mut p)
            if idx >= 8 { s.local_get_ge8 += 1 }
        } else if op == 33 {
            idx := read_uleb(&body, &mut p)
            if idx >= 8 { s.local_set_ge8 += 1 }
        } else if op == 34 || op == 35 {
            _ := read_uleb(&body, &mut p)
        } else if op == 36 {
            idx := read_uleb(&body, &mut p)
            if idx >= 32 && idx <= 35 { s.flag_global_sets += 1 }
        } else if op >= 40 && op <= 62 {
            _ := read_uleb(&body, &mut p); _ := read_uleb(&body, &mut p)
        } else if op == 63 || op == 64 {
            _ := read_uleb(&body, &mut p)
        } else if op == 65 || op == 66 {
            skip_sleb(&body, &mut p)
        } else if op == 67 {
            p += 4
        } else if op == 68 {
            p += 8
        } else if op == 160 {
            s.f64_adds += 1
        } else if op == 252 {
            sub := read_uleb(&body, &mut p)
            if sub == 10 { _ := read_uleb(&body, &mut p); _ := read_uleb(&body, &mut p) }
        }
    }
    assert(p == body.len)
    s
}

@test fn straight_line_alu_unary_div_mulh_shifts_and_locals() {
    mut c := arm.new_for(3)
    entry := arm.label(&mut c); arm.mark(&mut c, entry)
    arm.begin_mir(&mut c, true)
    // Exercise 64-bit add, sub, mul, sdiv, udiv, smulh, umulh, lsl/lsr/asr, bitfield, movk.
    arm.integer_binary(&mut c, 1, true, false, 3, 0, 1, -1) // x3 = x0 + x1
    arm.integer_binary(&mut c, 2, true, false, 4, 3, 1, -1) // x4 = x3 - x1
    arm.integer_binary(&mut c, 3, true, false, 5, 4, 2, -1) // x5 = x4 * x2
    arm.integer_binary(&mut c, 6, true, false, 6, 5, 2, -1) // x6 = sdiv x5, x2
    arm.integer_binary(&mut c, 7, true, false, 7, 6, 2, -1) // x7 = udiv x6, x2
    arm.integer_binary(&mut c, 4, true, false, 8, 5, 6, -1) // x8 = smulh
    arm.integer_binary(&mut c, 5, true, false, 9, 5, 6, -1) // x9 = umulh
    arm.integer_binary(&mut c, 14, true, false, 10, 7, 1, -1) // x10 = lsl
    arm.integer_binary(&mut c, 15, true, false, 11, 10, 1, -1) // x11 = lsr
    arm.integer_binary(&mut c, 12, true, false, 12, 11, 1, -1) // x12 = or-not
    arm.bitfield(&mut c, true, true, 13, 12, 4, 19) // sbfm (arithmetic shift/extract)
    arm.imm(&mut c, 14, 1311768467463790320) // movz + movk
    arm.integer_binary(&mut c, 1, true, false, 0, 8, 9, -1)
    arm.integer_binary(&mut c, 1, true, false, 0, 0, 13, -1)
    arm.integer_binary(&mut c, 1, true, false, 0, 0, 14, -1)
    arm.ret(&mut c)
    arm.end_mir(&mut c)

    mut f := mir.new()
    assert(lift.lift(&mut f, &c, 0, 0, 0, [], 0))
    assert(verify.verify(&mut f))

    mut obj := wasm_mir.empty()
    assert(wasm_mir.lower_into(&mut obj, &f))
    assert(obj.ready && obj.structured && !obj.needs_pc_local && obj.local_i64_count > 8)

    stats := scan_body(&obj.body)
    assert(stats.ops > 20 && stats.local_get_ge8 > 0 && stats.local_set_ge8 > 0 && stats.br_tables == 0)
}

@test fn structured_if_else_and_while_loop_fuse_compare_without_br_table() {
    mut c := arm.new_for(3)
    entry := arm.label(&mut c); loop_top := arm.label(&mut c)
    else_lbl := arm.label(&mut c); join_lbl := arm.label(&mut c); done := arm.label(&mut c)
    arm.mark(&mut c, entry)
    arm.begin_mir(&mut c, true)
    // x0 = limit, x1 = acc, x2 = i
    arm.imm(&mut c, 1, 0)
    arm.imm(&mut c, 2, 0)
    arm.imm(&mut c, 3, 1)
    arm.mark(&mut c, loop_top)
    arm.compare_register(&mut c, 2, 0)
    arm.branch(&mut c, done, 12) // ge -> done
    arm.compare_register(&mut c, 2, 1)
    arm.branch(&mut c, else_lbl, 13) // lt -> else
    arm.integer_binary(&mut c, 1, true, false, 1, 1, 2, -1)
    arm.branch(&mut c, join_lbl, 0)
    arm.mark(&mut c, else_lbl)
    arm.integer_binary(&mut c, 1, true, false, 1, 1, 3, -1)
    arm.mark(&mut c, join_lbl)
    arm.integer_binary(&mut c, 1, true, false, 2, 2, 3, -1)
    arm.branch(&mut c, loop_top, 0)
    arm.mark(&mut c, done)
    arm.mov(&mut c, 0, 1)
    arm.ret(&mut c)
    arm.end_mir(&mut c)

    mut f := mir.new()
    assert(lift.lift(&mut f, &c, 0, 0, 0, [], 0))
    assert(verify.verify(&mut f))
    mut opt := pipeline.new()
    _ := pipeline.run_source_into(&mut f, &mut opt, &pipeline.options(), &pipeline.no_terminals())

    mut obj := wasm_mir.empty()
    assert(wasm_mir.lower_into(&mut obj, &f))
    assert(obj.ready && obj.structured && !obj.needs_pc_local)

    stats := scan_body(&obj.body)
    assert(stats.blocks > 0 && stats.loops > 0 && stats.br_ifs > 0)
    assert(stats.br_tables == 0 && stats.flag_global_sets == 0)
}

@test fn nested_loops_with_break_and_continue_are_structured() {
    mut c := arm.new_for(3)
    entry := arm.label(&mut c); outer_top := arm.label(&mut c); inner_top := arm.label(&mut c)
    inner_next := arm.label(&mut c); outer_next := arm.label(&mut c); outer_done := arm.label(&mut c)
    arm.mark(&mut c, entry)
    arm.begin_mir(&mut c, true)
    // x0 = n, x1 = acc, x2 = i, x3 = j, x4 = 1
    arm.imm(&mut c, 1, 0); arm.imm(&mut c, 2, 0); arm.imm(&mut c, 4, 1)
    arm.mark(&mut c, outer_top)
    arm.compare_register(&mut c, 2, 0)
    arm.branch(&mut c, outer_done, 12) // b.ge outer_done (break outer)
    arm.imm(&mut c, 3, 0)
    arm.mark(&mut c, inner_top)
    arm.compare_register(&mut c, 3, 0)
    arm.branch(&mut c, outer_next, 12) // b.ge outer_next (exit inner)
    arm.compare_register(&mut c, 3, 2)
    arm.branch(&mut c, inner_next, 2) // b.eq inner_next (continue inner)
    arm.integer_binary(&mut c, 1, true, false, 1, 1, 3, -1)
    arm.compare_immediate(&mut c, 1, 50, false)
    arm.branch(&mut c, outer_done, 14) // b.gt outer_done (multi-level break)
    arm.mark(&mut c, inner_next)
    arm.integer_binary(&mut c, 1, true, false, 3, 3, 4, -1)
    arm.branch(&mut c, inner_top, 0)
    arm.mark(&mut c, outer_next)
    arm.integer_binary(&mut c, 1, true, false, 2, 2, 4, -1)
    arm.branch(&mut c, outer_top, 0)
    arm.mark(&mut c, outer_done)
    arm.mov(&mut c, 0, 1)
    arm.ret(&mut c)
    arm.end_mir(&mut c)

    mut f := mir.new()
    assert(lift.lift(&mut f, &c, 0, 0, 0, [], 0))
    assert(verify.verify(&mut f))

    mut obj := wasm_mir.empty()
    assert(wasm_mir.lower_into(&mut obj, &f))
    assert(obj.ready && obj.structured && !obj.needs_pc_local)

    stats := scan_body(&obj.body)
    assert(stats.loops >= 2 && stats.blocks > 0 && stats.br_tables == 0)
}

@test fn hot_place_and_float_fallback_lower_cleanly() {
    mut pc := arm.new_for(3)
    pe := arm.label(&mut pc); arm.mark(&mut pc, pe)
    arm.begin_mir(&mut pc, true)
    place_emit.emit(&mut pc, .Field, 2, 0, 0, 8, 100)
    place_emit.emit(&mut pc, .CheckIndex, 2, 0, 1, 0, 101)
    place_emit.emit(&mut pc, .Element, 2, 0, 0, 0, 102)
    place_emit.emit(&mut pc, .Element, 2, 0, 1, 3, 103)
    place_emit.emit(&mut pc, .Element, 2, 0, 2, 24, 104)
    place_emit.emit(&mut pc, .Member, 2, 0, i32(place_op.Member.Length), 1, 105)
    place_emit.emit(&mut pc, .BorrowPayload, 2, 0, 0, 0, 106)
    arm.ret(&mut pc)
    arm.end_mir(&mut pc)

    mut pf := mir.new()
    assert(lift.lift(&mut pf, &pc, 0, 0, 0, [], 0))
    assert(verify.verify(&mut pf))
    mut pobj := wasm_mir.empty()
    assert(wasm_mir.lower_into(&mut pobj, &pf))
    assert(pobj.ready && pobj.structured && !pobj.needs_pc_local)

    mut fc := arm.new_for(3)
    fe := arm.label(&mut fc); arm.mark(&mut fc, fe)
    arm.begin_mir(&mut fc, true)
    _ := floats.binary(&mut fc, "+", 7, 10)
    arm.ret(&mut fc)
    arm.end_mir(&mut fc)

    mut ff := mir.new()
    assert(lift.lift(&mut ff, &fc, 0, 0, 0, [], 0))
    assert(verify.verify(&mut ff))
    mut fobj := wasm_mir.empty()
    assert(wasm_mir.lower_into(&mut fobj, &ff))
    assert(fobj.ready && fobj.structured)
    fstats := scan_body(&fobj.body)
    assert(fstats.f64_adds > 0 && fstats.br_tables == 0)
}

@test fn patch_records_and_image_linked_emit_valid_wasm_header() {
    // 1. Lower `entry` in a clean MIR code buffer matching the label IDs of `c_full`.
    mut c_fn := arm.new_for(3)
    entry := arm.label(&mut c_fn)
    helper := arm.label(&mut c_fn)
    trap := arm.label(&mut c_fn)
    data_lbl := arm.label(&mut c_fn)
    arm.mark(&mut c_fn, entry)
    arm.begin_mir(&mut c_fn, true)
    arm.intrinsic_call(&mut c_fn, 0, .Print, 1, 0, 100)
    arm.compare_immediate(&mut c_fn, 0, 0, false)
    arm.branch(&mut c_fn, trap, 13) // lt -> ExternalJump (patch kind 3 -> unreachable)
    arm.branch(&mut c_fn, helper, 1) // Call (patch kind 0)
    arm.branch(&mut c_fn, data_lbl, 20) // Address (patch kind 1)
    arm.ret(&mut c_fn)
    arm.end_mir(&mut c_fn)

    mut f := mir.new()
    assert(lift.lift(&mut f, &c_fn, 0, 0, 0, [], 0))
    assert(verify.verify(&mut f))

    mut obj := wasm_mir.empty()
    assert(wasm_mir.lower_into(&mut obj, &f))
    assert(obj.ready && obj.entry_label == entry && obj.prints_mask == 1)

    mut seen_call := false; mut seen_addr := false; mut seen_print := false; mut seen_ext := false
    for k in &obj.patch_kind {
        if k == 0 { seen_call = true }
        else if k == 1 { seen_addr = true }
        else if k == 2 { seen_print = true }
        else if k == 3 { seen_ext = true }
    }
    assert(seen_call && seen_addr && seen_print && seen_ext)

    // 2. Build the matching linked image container with entry, helper, trap, and data section.
    mut c_full := arm.new_for(3)
    fe := arm.label(&mut c_full)
    fh := arm.label(&mut c_full)
    ft := arm.label(&mut c_full)
    fd := arm.label(&mut c_full)
    arm.mark(&mut c_full, fe); arm.return_to_caller(&mut c_full)
    arm.mark(&mut c_full, fh); arm.return_to_caller(&mut c_full)
    arm.mark(&mut c_full, ft); arm.exit(&mut c_full, 108)
    data_start := c_full.words.len
    arm.mark(&mut c_full, fd); arm.emit(&mut c_full, 42)

    mut linked := wasm_native.empty_linked()
    linked.active = true
    linked.entry_labels = [obj.entry_label]
    linked.local_i64_counts = [obj.local_i64_count]
    linked.needs_pc = [obj.needs_pc_local]
    linked.prints_masks = [obj.prints_mask]
    linked.body_starts = [0]
    linked.body_ends = [obj.body.len]
    linked.bodies = move obj.body
    linked.patch_starts = [0]
    linked.patch_ends = [obj.patch_at.len]
    linked.patch_at = move obj.patch_at
    linked.patch_kind = move obj.patch_kind
    linked.patch_target = move obj.patch_target

    abi := wasm_abi.new()
    res := wasm_native.image_linked(&c_full, data_start, fe, 0, &abi, &linked)
    assert(res.ok && res.text.len >= 8)
    expected_magic: []u8 = [0, 97, 115, 109, 1, 0, 0, 0]
    for i in 0..8 { assert(res.text[i] == expected_magic[i]) }
}

fn main() {}
