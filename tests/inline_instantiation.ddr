import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_pass as pass
import ..selfhost.opt_verify as verify
import ..selfhost.opt_inline as inline
import ..selfhost.lexer

fn model(source: string, types: &[]i32, ret: i32) -> ir.Function {
    input := lexer.scan(source, false); var names: []string = []; var positions: []i32 = []
    for p in 0..types.len { names.push(input.texts[p]); positions.push(p) }
    var f := ir.new()
    assert(parse.parse(&mut f, &input, types.len, input.kinds.len - 2, &names, &types, &positions, ret))
    assert(verify.validate(&f, false)); f
}
fn equal_i32(a: &[]i32, b: &[]i32) { assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) } }
fn equal_i64(a: &[]i64, b: &[]i64) { assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) } }
fn unchanged(f: &ir.Function, old: &ir.Function) {
    assert(f.supported == old.supported && f.root == old.root && f.ret == old.ret && f.params == old.params)
    assert(f.visits == old.visits && f.rewrites == old.rewrites && f.budget_exhausted == old.budget_exhausted)
    equal_i32(&f.nodes.kinds, &old.nodes.kinds); equal_i32(&f.nodes.types, &old.nodes.types)
    equal_i32(&f.nodes.left, &old.nodes.left); equal_i32(&f.nodes.right, &old.nodes.right)
    equal_i32(&f.nodes.third, &old.nodes.third); equal_i32(&f.nodes.next, &old.nodes.next)
    equal_i64(&f.nodes.values, &old.nodes.values); equal_i32(&f.nodes.locals, &old.nodes.locals)
    equal_i32(&f.nodes.starts, &old.nodes.starts); equal_i32(&f.nodes.effects, &old.nodes.effects); equal_i32(&f.nodes.proofs, &old.nodes.proofs)
    equal_i32(&f.local_types, &old.local_types); equal_i32(&f.local_param, &old.local_param); equal_i32(&f.local_at, &old.local_at)
    assert(f.local_names.len == old.local_names.len && f.local_mutable.len == old.local_mutable.len)
    for i in 0..f.local_names.len { assert(f.local_names[i] == old.local_names[i]) }
    for i in 0..f.local_mutable.len { assert(f.local_mutable[i] == old.local_mutable[i]) }
}
fn returned(f: &ir.Function) -> i32 {
    var at := f.nodes.left[f.root]
    while at >= 0 { if f.nodes.kinds[at] == 15 { return at }; at = f.nodes.next[at] }
    assert(false); -1
}
fn attach(f: &mut ir.Function, expression: i32) {
    ret := returned(&f); f.nodes.left[ret] = expression
    f.nodes.effects[ret] = f.nodes.effects[ret].bit_or(f.nodes.effects[expression])
    f.nodes.effects[f.root] = f.nodes.effects[f.root].bit_or(f.nodes.effects[ret])
    assert(verify.validate(&f, true))
}
fn constant_node(f: &mut ir.Function) {
    f.nodes.kinds.push(1); f.nodes.types.push(2); f.nodes.left.push(-1); f.nodes.right.push(-1)
    f.nodes.third.push(-1); f.nodes.next.push(-1); f.nodes.values.push(0); f.nodes.locals.push(-1)
    f.nodes.starts.push(0); f.nodes.effects.push(0); f.nodes.proofs.push(0)
}

@test fn signatures_are_sealed_bounded_reused_and_clear_stale_results() {
    var c := inline.new(); var signature: []i32 = [2, 2, 2]
    assert(inline.signature_into(&c, 7, &mut signature) == 0 && signature.len == 0)
    two: []i32 = [1, 3]; f := model("x flag{x}", &two, 1)
    assert(inline.add_verified(&mut c, 7, &f, ""))
    assert(inline.signature_into(&c, 7, &mut signature) == 0 && signature.len == 0)
    assert(inline.seal(&mut c))
    for round in 0..4 {
        assert(inline.signature_into(&c, 7, &mut signature) == 1 && signature.len == 2 && signature[0] == 1 && signature[1] == 3)
        assert(inline.signature_into(&c, 8, &mut signature) == 0 && signature.len == 0)
        assert(inline.signature_into(&c, -1, &mut signature) == 0 && signature.len == 0)
    }
    inline.reject(&mut c, 9)
    assert(inline.signature_into(&c, 7, &mut signature) == 0 && signature.len == 0)
    inline.reset(&mut c, 4096, 65536, 256)
    eight: []i32 = [2, 1, 3, 2, 1, 3, 2, 1]
    all := model("a b c d e f g h{a}", &eight, 2)
    assert(inline.add_verified(&mut c, 7, &all, "") && inline.seal(&mut c))
    assert(inline.signature_into(&c, 7, &mut signature) == 2 && signature.len == 8)
    equal_i32(&signature, &eight)
}

@test fn pooled_templates_rebase_all_columns_and_only_append_to_the_caller() {
    types: []i32 = [2, 2]; seed := model("x y{x-y}", &types, 2); callee := model("x y{(x*3+y)%7}", &types, 2)
    var c := inline.new(); assert(inline.add_verified(&mut c, 1, &seed, "")); first := inline.node_count(&c)
    assert(inline.add_verified(&mut c, 7, &callee, "") && inline.seal(&mut c))
    copied := inline.node_count(&c) - first
    var f := model("a b{0}", &types, 2); old := f; base := f.nodes.kinds.len
    ids: []i32 = [1, 0]; call_at := f.nodes.starts[f.nodes.left[returned(&f)]]
    root := inline.append_expression_into(&c, &mut f, 7, &ids, call_at)
    assert(root >= base && root < base + copied && f.nodes.kinds.len == base + copied)
    assert(f.root == old.root && f.supported == old.supported && f.rewrites == old.rewrites && f.visits == old.visits)
    for i in 0..base {
        assert(f.nodes.kinds[i] == old.nodes.kinds[i] && f.nodes.values[i] == old.nodes.values[i])
        assert(f.nodes.left[i] == old.nodes.left[i] && f.nodes.right[i] == old.nodes.right[i] && f.nodes.starts[i] == old.nodes.starts[i])
    }
    var source := 0
    for node in 0..callee.nodes.kinds.len {
        if node == callee.root || node == returned(&callee) { continue }
        destination := base + source; source = source + 1
        assert(f.nodes.kinds[destination] == callee.nodes.kinds[node] && f.nodes.types[destination] == callee.nodes.types[node])
        assert(f.nodes.values[destination] == callee.nodes.values[node] && f.nodes.starts[destination] == call_at)
        assert(f.nodes.effects[destination] == callee.nodes.effects[node] && f.nodes.proofs[destination] == callee.nodes.proofs[node])
        if f.nodes.kinds[destination] == 2 { assert(f.nodes.locals[destination] == ids[callee.nodes.locals[node]]) }
        if f.nodes.left[destination] >= 0 { assert(f.nodes.left[destination] >= base && f.nodes.left[destination] < base + copied) }
        if f.nodes.right[destination] >= 0 { assert(f.nodes.right[destination] >= base && f.nodes.right[destination] < base + copied) }
    }
    attach(&mut f, root)
    // A second instance is disjoint. The old expression is valid detached IR.
    second_base := f.nodes.kinds.len; second := inline.append_expression_into(&c, &mut f, 7, &ids, call_at)
    assert(second >= second_base && f.nodes.kinds.len == second_base + copied); attach(&mut f, second)
}

@test fn initialized_snapshots_allow_duplicate_ids_and_caller_owned_builder_lifecycle() {
    two: []i32 = [2, 2]; one: []i32 = [2]
    callee := model("x y{x-y}", &two, 2)
    var c := inline.new(); assert(inline.add_verified(&mut c, 0, &callee, "") && inline.seal(&mut c))
    var f := model("value{0}", &one, 2); duplicates: []i32 = [0, 0]
    root := inline.append_expression_into(&c, &mut f, 0, &duplicates, 1); assert(root >= 0); attach(&mut f, root)
    var references := 0
    for node in 0..f.nodes.kinds.len { if f.nodes.kinds[node] == 2 { references = references + 1; assert(f.nodes.locals[node] == 0) } }
    assert(references == 2)
    // Future parsers can instantiate before root/return assembly. No support
    // flag, root, locals or accounting state is implicitly activated.
    f = model("a b{0}", &two, 2); ir.reset_nodes(&mut f.nodes); f.root = -1; f.supported = false
    ids: []i32 = [0, 1]
    built := inline.append_expression_into(&c, &mut f, 0, &ids, 2)
    assert(built >= 0 && f.root == -1 && !f.supported && f.rewrites == 0 && f.local_types.len == 2)
}

@test fn argument_errors_and_catalog_generations_fail_without_touching_function_state() {
    types: []i32 = [2, 2]; callee := model("x y{x+y}", &types, 2)
    var c := inline.new(); assert(inline.add_verified(&mut c, 3, &callee, ""))
    var f := model("a b{0}", &types, 2); original := f; ids: []i32 = [0, 1]
    assert(inline.append_expression_into(&c, &mut f, 3, &ids, 1) == -1); unchanged(&f, &original)
    assert(inline.seal(&mut c))
    for mode in 0..7 {
        var args: []i32 = [0, 1]; var declaration := 3; var at := 1
        if mode == 0 { declaration = -1 }; if mode == 1 { declaration = 4 }
        if mode == 2 { at = -1 }; if mode == 3 { removed := args.pop() }
        if mode == 4 { args.push(0) }; if mode == 5 { args[0] = -1 }; if mode == 6 { args[1] = 2 }
        assert(inline.append_expression_into(&c, &mut f, declaration, &args, at) == -1); unchanged(&f, &original)
    }
    wrong_types: []i32 = [1, 2]; f = model("a b{0}", &wrong_types, 2); old := f
    assert(inline.append_expression_into(&c, &mut f, 3, &ids, 1) == -1); unchanged(&f, &old)
    f = original; root := inline.append_expression_into(&c, &mut f, 3, &ids, 1); assert(root >= 0); attach(&mut f, root)
    frozen := f
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.append_expression_into(&c, &mut f, 3, &ids, 1) == -1); unchanged(&f, &frozen)
    replacement := model("x y{x-y}", &types, 2)
    assert(inline.add_verified(&mut c, 3, &replacement, "") && inline.seal(&mut c))
    next := inline.append_expression_into(&c, &mut f, 3, &ids, 1); assert(next >= frozen.nodes.kinds.len)
    for node in 0..frozen.nodes.kinds.len { assert(f.nodes.kinds[node] == frozen.nodes.kinds[node] && f.nodes.values[node] == frozen.nodes.values[node]) }
    attach(&mut f, next)
}

@test fn malformed_caller_storage_is_rejected_before_any_append() {
    types: []i32 = [2, 2]; callee := model("x y{x+y}", &types, 2)
    var c := inline.new(); assert(inline.add_verified(&mut c, 0, &callee, "") && inline.seal(&mut c))
    original := model("a b{snapshot:=a;0}", &types, 2); ids: []i32 = [0, 1]
    for mode in 0..41 {
        var f := original
        if mode == 0 { removed := f.nodes.types.pop() }; if mode == 1 { removed := f.nodes.left.pop() }
        if mode == 2 { removed := f.nodes.right.pop() }; if mode == 3 { removed := f.nodes.third.pop() }
        if mode == 4 { removed := f.nodes.next.pop() }; if mode == 5 { removed := f.nodes.values.pop() }
        if mode == 6 { removed := f.nodes.locals.pop() }; if mode == 7 { removed := f.nodes.starts.pop() }
        if mode == 8 { removed := f.nodes.effects.pop() }; if mode == 9 { removed := f.nodes.proofs.pop() }
        if mode == 10 { removed := f.local_names.pop() }; if mode == 11 { removed := f.local_mutable.pop() }
        if mode == 12 { removed := f.local_param.pop() }; if mode == 13 { removed := f.local_at.pop() }
        if mode == 14 { f.params = -1 }; if mode == 15 { f.params = 9 }; if mode == 16 { f.ret = 4 }
        if mode == 17 { f.root = -2 }; if mode == 18 { f.visits = -1 }; if mode == 19 { f.rewrites = -1 }
        if mode == 20 { f.nodes.left[0] = -2 }; if mode == 21 { f.nodes.right[0] = f.nodes.kinds.len }
        if mode == 22 { f.nodes.third[0] = f.nodes.kinds.len }; if mode == 23 { f.nodes.next[0] = f.nodes.kinds.len }
        if mode == 24 { f.nodes.locals[0] = f.local_types.len }; if mode == 25 { f.nodes.starts[0] = -1 }
        if mode == 26 { f.nodes.effects[0] = 32 }; if mode == 27 { f.nodes.proofs[0] = 4 }
        if mode == 28 { f.nodes.types[0] = 4 }; if mode == 29 { f.nodes.kinds[0] = 99 }
        if mode == 30 { f.local_names[0] = "" }; if mode == 31 { f.local_at[0] = -1 }; if mode == 32 { f.local_types[0] = 0 }
        if mode == 33 { f.local_param[0] = 1 }; if mode == 34 { f.local_mutable[0] = true }; if mode == 35 { f.local_types[0] = 22 }
        if mode == 36 { f.local_param[2] = 0 }; if mode == 37 { f.local_types[2] = 20 }
        if mode == 38 { while f.nodes.kinds.len <= 2048 { constant_node(&mut f) } }
        if mode == 39 { removed := f.local_types.pop() }
        if mode == 40 {
            while f.local_types.len <= 256 {
                name := "extra" + f.local_types.len.str()
                f.local_names.push(name); f.local_types.push(2); f.local_mutable.push(false); f.local_param.push(-1); f.local_at.push(0)
            }
        }
        old := f
        assert(inline.append_expression_into(&c, &mut f, 0, &ids, 1) == -1); unchanged(&f, &old)
    }
}

@test fn conservative_node_caps_include_detached_fold_remnants_and_preserve_proof_bits() {
    types: []i32 = [2, 2]; callee := model("x y{x+y}", &types, 2)
    var c := inline.new(); assert(inline.add_verified(&mut c, 0, &callee, "") && inline.seal(&mut c))
    ids: []i32 = [0, 1]; var f := model("a b{0}", &types, 2)
    while f.nodes.kinds.len < 2045 { constant_node(&mut f) }
    assert(verify.validate(&f, true))
    root := inline.append_expression_into(&c, &mut f, 0, &ids, 1)
    assert(root >= 2045 && f.nodes.kinds.len == 2048); attach(&mut f, root)
    var old := f; assert(inline.append_expression_into(&c, &mut f, 0, &ids, 1) == -1); unchanged(&f, &old)
    one: []i32 = [2]; var expression := "1"; for part in 0..15 { expression = expression + "+1" }
    var folded := model("x{-(" + expression + ")}", &one, 2); pass.run(&mut folded)
    assert(folded.nodes.kinds.len == 34 && verify.validate(&folded, true))
    inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &folded, "") && inline.node_count(&c) == 32 && inline.seal(&mut c))
    f = model("a b{0}", &types, 2); while f.nodes.kinds.len < 2017 { constant_node(&mut f) }
    old = f; single: []i32 = [0]
    assert(inline.append_expression_into(&c, &mut f, 0, &single, 1) == -1); unchanged(&f, &old)
    removed_kind := f.nodes.kinds.pop(); removed_type := f.nodes.types.pop(); removed_left := f.nodes.left.pop(); removed_right := f.nodes.right.pop()
    removed_third := f.nodes.third.pop(); removed_next := f.nodes.next.pop(); removed_value := f.nodes.values.pop(); removed_local := f.nodes.locals.pop()
    removed_start := f.nodes.starts.pop(); removed_effect := f.nodes.effects.pop(); removed_proof := f.nodes.proofs.pop()
    appended := inline.append_expression_into(&c, &mut f, 0, &single, 1)
    assert(appended >= 2016 && f.nodes.kinds.len == 2048); attach(&mut f, appended)
    signed: []i32 = [1]; var proven := model("x{x+0}", &signed, 1)
    for node in 0..proven.nodes.kinds.len { if proven.nodes.kinds[node] == 3 { proven.nodes.proofs[node] = 1 } }
    assert(verify.validate(&proven, true)); inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &proven, "") && inline.seal(&mut c))
    var caller := model("value{0}", &signed, 1); before := caller.nodes.kinds.len
    result := inline.append_expression_into(&c, &mut caller, 0, &single, 1); assert(result >= before)
    assert(caller.nodes.proofs[result] == 1 && caller.nodes.effects[result] == proven.nodes.effects[proven.nodes.left[returned(&proven)]])
    attach(&mut caller, result)
}

@test fn new_apis_reject_bad_template_storage_and_keep_valid_detached_shortcut_remnants() {
    types: []i32 = [2]; good := model("x{x+1}", &types, 2)
    var c := inline.new(); ids: []i32 = [0]
    for mode in 0..4 {
        var f := good; expression := f.nodes.left[returned(&f)]
        if mode == 0 { f.nodes.proofs[f.nodes.right[expression]] = 1 }
        if mode == 1 { f.nodes.values[f.nodes.left[expression]] = 9 }
        if mode == 2 { f.nodes.effects[expression] = 0 }
        if mode == 3 { f.nodes.left[expression] = expression }
        // add_verified's producer contract requires independent verification;
        // these inputs intentionally violate it to test new-API admission.
        inline.reset(&mut c, 4096, 65536, 256)
        assert(inline.add_verified(&mut c, 0, &f, "") && inline.seal(&mut c))
        var signature: []i32 = [2]
        assert(inline.signature_into(&c, 0, &mut signature) == 0 && signature.len == 0)
        var caller := model("value{0}", &types, 2); old := caller
        assert(inline.append_expression_into(&c, &mut caller, 0, &ids, 1) == -1); unchanged(&caller, &old)
    }
    var shortcut := model("x{true&&x>0}", &types, 3); pass.run(&mut shortcut)
    assert(verify.validate(&shortcut, true)); inline.reset(&mut c, 4096, 65536, 256)
    assert(inline.add_verified(&mut c, 0, &shortcut, "") && inline.seal(&mut c))
    var caller := model("value{false}", &types, 3)
    root := inline.append_expression_into(&c, &mut caller, 0, &ids, 1)
    assert(root >= 0); attach(&mut caller, root)
}
