@test
fn standard_collections_and_text_compose() {
    mut seen := Set<string>::new()
    mut counts := Map<string, i64>::new()
    parts := text.split("alpha beta alpha år alpha år", " ")
    for word in move parts {
        unused := seen.insert(word.clone())
        count := counts.get_or(word, 0) + 1
        counts.put(move word, count)
    }
    assert(seen.len() == 3)
    assert(counts.get_or("alpha", 0) == 3)
    assert(counts.get_or("år", 0) == 2)
    assert(counts.get_or("beta", 0) == 1)
    assert(text.contains("alpha år", "år"))
    assert(text.replace("alpha år alpha", "alpha", "x") == "x år x")
    assert(text.lower("Hej ÅÄÖ") == "hej ÅÄÖ" && text.upper("Hej åäö") == "HEJ åäö")
    assert(text.pad_left("å", 3, "0") == "00å" && text.pad_right("å", 3, ".") == "å..")
}

@test
fn standard_parsers_hashes_and_bytes_compose() {
    parsed := parse.i64_range("xx420yy", 2, 5)
    assert(parsed.ok && parsed.value == 420)
    hex_val := parse.hex_u64_range("ff", 0, 2)
    assert(hex_val.ok && hex_val.value == 255)
    digest := sha256.digest_text("abc")
    hex_digest := bytes.hex(&digest)
    assert(hex_digest == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert(sha256.hex_text("abc") == hex_digest)
    raw := bytes.from_text("abc")
    wide := bytes.to_i32(&raw)
    repacked := bytes.from_i32(&wide)
    assert(sha256.hex_bytes(&raw) == hex_digest && bytes.equal(&repacked, &raw))
    assert(math.checked_add_i32(2147483647, 1).is_err() && math.checked_add_i32(40, 2).unwrap_or(0) == 42)
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "HTTP ")
    bytes.append_decimal(&mut out, 200)
    assert(bytes.equals_text(&out, 0, out.len, "HTTP 200"))
}

@test
fn standard_impl_methods_compose() {
    mut s := set.Set<string>::new()
    _ := s.insert("alpha")
    _ := s.insert("beta")
    assert(s.len() == 2 && s.contains("alpha"))

    mut m := Map<string, i64>::new()
    m.put("a", 10)
    assert(m.len() == 1 && m.get_or("a", 0) == 10)

    p := parse.Integer::parse("42")
    assert(p.ok && p.value == 42)

    doc := json.Doc::parse_text("{\"ok\":true,\"n\":7}")
    assert(doc.ok && doc.get_bool(doc.root, "ok") == .Some(true) && doc.get_i64(doc.root, "n") == .Some(7))

    mut wbuf: []u8 = []
    wire.put_varint(&mut wbuf, 123)
    mut r := wire.Reader::new()
    assert(r.read_varint(&wbuf) == 123 && r.finish(&wbuf))
}

fn sum_i32_slice(values: &[]i32) -> i32 {
    mut total: i32 = 0
    for i in 0..values.len {
        total = total + values[i]
    }
    total
}

fn sum_i32_slice_widened(values: &[]i32) -> i64 {
    mut total: i64 = 0
    for i in 0..values.len {
        total = total + i64(values[i])
    }
    total
}

fn add_i32_slices_in_place(dst: &mut []i32, src: &[]i32, delta: i32) {
    mut i: i32 = 0
    while i < dst.len && i < src.len {
        dst[i] = src[i] + delta
        i = i + 1
    }
}

fn general_signed_div_rem(x: i32, y: i64) -> i64 {
    mut scratch: []i32 = [x]
    q1 := scratch[0] / 3
    r1 := scratch[0] % 3
    q2 := scratch[0] / -7
    r2 := scratch[0] % -7
    q3 := scratch[0] / 1
    r3 := scratch[0] % 1
    q4 := y / -3
    r4 := y % -3
    q5 := y / 10
    r5 := y % 10
    q6 := i64(scratch[0]) / -2147483648
    assert(q1 * 3 + r1 == scratch[0])
    assert(q2 * -7 + r2 == scratch[0])
    assert(q3 == scratch[0] && r3 == 0)
    assert(q4 * -3 + r4 == y)
    assert(q5 * 10 + r5 == y)
    i64(q1) + i64(r2) + q4 + r5 + q6
}

@test
fn i32_scalar_slices_and_general_const_div_work_correctly() {
    mut dst: []i32 = [10, -20, 30, -40]
    src: []i32 = [-7, 42, -2147483648, 123]
    add_i32_slices_in_place(&mut dst, &src, 5)
    assert(dst[0] == -2 && dst[1] == 47 && dst[2] == -2147483643 && dst[3] == 128)
    assert(sum_i32_slice(&dst) == -2147483470)
    assert(sum_i32_slice_widened(&src) == i64(-2147483490))

    assert(general_signed_div_rem(-25, -100) == i64(-25 / 3) + i64(-25 % -7) + (-100 / -3) + (-100 % 10) + 0)
    assert(general_signed_div_rem(-2147483648, 99) == i64(-2147483648 / 3) + i64(-2147483648 % -7) + (99 / -3) + (99 % 10) + 1)

    mut u8s: []u8 = [200]
    a8: u8 = u8s[0] / 16
    b8: u8 = u8s[0] % 16
    a32: u32 = u32(1000000007) / 64
    b32: u32 = u32(1000000007) % 64
    a64: u64 = u64(0x8000000000000005) / 0x8000000000000000
    b64: u64 = u64(0x8000000000000005) % 0x8000000000000000
    u1: u64 = a64 / 1
    r1: u64 = a64 % 1
    assert(a8 == 12 && b8 == 8)
    assert(a32 * 64 + b32 == 1000000007)
    assert(a64 == 1 && b64 == 5 && u1 == 1 && r1 == 0)
}

@test
fn mutable_match_pattern_bindings_work_on_copies_and_owned_payloads() {
    scalar_res := Result<i32, string>.Ok(40)
    match scalar_res {
        .Ok(mut x) => {
            x += 2
            assert(x == 42)
        },
        .Err(_) => { assert(false) },
    }
    mut owned_res := Result<[]i32, string>.Ok([1, 2])
    match move owned_res {
        .Ok(mut arr) => {
            arr.push(3)
            assert(arr.len == 3 && arr[2] == 3)
        },
        .Err(_) => { assert(false) },
    }
    guarded := Result<i32, string>.Ok(1)
    match guarded {
        .Ok(mut v) if v > 0 => {
            v += 5
            assert(v == 6)
        },
        .Ok(_) => { assert(false) },
        .Err(_) => { assert(false) },
    }
}

const SUITE_WIDTH: i32 = 4
const SUITE_DOUBLED = SUITE_WIDTH * 2
const SUITE_HEX: []u8 = [b'0', b'1', b'2', b'3']
const SUITE_WEIGHTS: [i32; SUITE_WIDTH] = [10, 20, 30, 40]
const SUITE_GREETING = "dunder" + " const"

@test
fn generic_fn_calls_infer_type_arguments() {
    mut items: []i32 = [10, 20, 30]
    array.reverse(&mut items)
    assert(items[0] == 30 && items[2] == 10)
    assert(array.contains(&items, 20) && array.index_of(&items, 10).unwrap_or(-1) == 2)
    assert(cmp.min(5, 9) == 5 && cmp.max(i64(8), i64(3)) == 8)
}

@test
fn module_level_constants_and_tables_work() {
    assert(SUITE_WIDTH == 4 && SUITE_DOUBLED == 8 && SUITE_GREETING == "dunder const")
    mut buf: [u8; SUITE_WIDTH] = [SUITE_HEX[0], SUITE_HEX[1], SUITE_HEX[2], SUITE_HEX[3]]
    assert(buf.len == 4 && buf[2] == b'2')
    mut sum := 0
    for w in SUITE_WEIGHTS { sum += w }
    sub := (&SUITE_WEIGHTS[1..3]).clone()
    assert(sum == 100 && sub.len == 2 && sub[0] == 20)
    mut copy := SUITE_WEIGHTS
    copy[0] = 99
    assert(copy[0] == 99 && SUITE_WEIGHTS[0] == 10)
}

struct SuitePair { left: []i32, right: []i32 }
struct SuiteResBox { res: Result<SuiteResource, string>, note: []i32 }
@resource(dispose) struct SuiteResource { tag: i32, data: []i32 }
impl SuiteResource {
    fn dispose(&mut self) { self.tag = -1 }
}
enum SuitePairEnum { Some(SuitePair), Empty }
enum SuiteBox { Box(SuiteResource), None }
enum SuiteHolder { Pair(SuiteResource, SuiteResource), Wrap(SuiteBox), Empty }

fn make_suite_pair() -> SuitePair { SuitePair { left: [7, 8], right: [9] } }
fn make_suite_batch() -> []string { ["x" + 1.str(), "y" + 2.str()] }

fn check_diverging_match(move r: Result<i32, string>) -> string {
    match r {
        .Ok(_) => {},
        .Err(e) => { return e },
    }
    assert(r.is_ok())
    "ok"
}

@test fn b1_last_read_auto_release_and_fresh_moves_work() {
    mut v: []i32 = [10, 20, 30]
    r := &v
    assert(r.len == 3)
    v.push(40)
    assert(v == [10, 20, 30, 40])

    mid := &v[0..2]
    assert(mid == [10, 20])
    v[0] = 99
    assert(v == [99, 20, 30, 40])

    s := &v
    sum := s[0] + s[1]
    v.clear()
    assert(sum == 119 && v.len == 0)

    mut sp := SuitePair { left: [1, 2], right: [3] }
    for x in sp.left { sp.right.push(x) }
    assert(sp.right == [3, 1, 2])

    batch := ["a" + 1.str(), "b" + 2.str()]
    mut moved_strings: []string = []
    for item in move batch { moved_strings.push(item) }
    assert(moved_strings == ["a1", "b2"])

    mut from_call: []string = []
    for item in make_suite_batch() { from_call.push(item) }
    assert(from_call == ["x1", "y2"])

    resources: []SuiteResource = [
        SuiteResource { tag: 11, data: [1] },
        SuiteResource { tag: 22, data: [2] },
    ]
    mut kept_resources: []SuiteResource = []
    for res in move resources { kept_resources.push(res) }
    assert(kept_resources.len == 2 && kept_resources[0].tag == 11 && kept_resources[1].tag == 22)

    mut buckets: [][]i32 = []
    buckets.push(make_suite_pair().left)
    old := replace(&mut buckets[0], make_suite_pair().left)
    assert(buckets[0] == [7, 8] && old == [7, 8])
}

@test fn b2_owned_match_payload_moves_work_and_drop_cleanly() {
    r_err: Result<i32, string> = .Err("bad" + 9.str())
    mut failure := ""
    match r_err {
        .Ok(_) => assert(false),
        .Err(e) => { failure = e },
    }
    assert(failure == "bad9")

    r_keep: Result<i32, string> = .Ok(5)
    mut seen_err := ""
    match r_keep {
        .Ok(v) => assert(v == 5),
        .Err(e) => { seen_err = e },
    }
    assert(seen_err == "")
    assert(check_diverging_match(.Ok(5)) == "ok")
    assert(check_diverging_match(.Err("early" + 1.str())) == "early1")

    res_child: Result<SuiteResource, string> = .Ok(SuiteResource { tag: 55, data: [5] })
    mut out_res: []SuiteResource = []
    match res_child {
        .Ok(c) => {
            taken := c
            out_res.push(move taken)
        },
        .Err(_) => assert(false),
    }
    assert(out_res.len == 1 && out_res[0].tag == 55)

    field_box := SuiteResBox {
        res: .Ok(SuiteResource { tag: 66, data: [6] }),
        note: [10],
    }
    match field_box.res {
        .Ok(c) => out_res.push(move c),
        .Err(_) => assert(false),
    }
    assert(out_res.len == 2 && out_res[1].tag == 66 && field_box.note == [10])

    pair_enum := SuiteHolder.Pair(SuiteResource { tag: 1, data: [1] }, SuiteResource { tag: 2, data: [2] })
    match pair_enum {
        .Pair(a, b) => { out_res.push(move a); out_res.push(move b) },
        .Wrap(_) => assert(false),
        .Empty => assert(false),
    }
    assert(out_res.len == 4 && out_res[2].tag == 1 && out_res[3].tag == 2)

    wrapped := SuiteHolder.Wrap(.Box(SuiteResource { tag: 77, data: [7] }))
    match wrapped {
        .Wrap(.Box(c)) => out_res.push(move c),
        .Wrap(.None) => assert(false),
        .Pair(_, _) => assert(false),
        .Empty => assert(false),
    }
    assert(out_res.len == 5 && out_res[4].tag == 77)

    partial_enum := SuitePairEnum.Some(SuitePair { left: [1, 2], right: [3, 4] })
    mut left_parts: [][]i32 = []
    mut right_parts: [][]i32 = []
    match partial_enum {
        .Some(p) => { left_parts.push(move p.left); right_parts.push(move p.right) },
        .Empty => assert(false),
    }
    assert(left_parts[0] == [1, 2] && right_parts[0] == [3, 4])

    guarded: Result<SuiteResource, string> = .Ok(SuiteResource { tag: 88, data: [8] })
    match guarded {
        .Ok(c) if c.tag == 88 => out_res.push(move c),
        .Ok(_) => assert(false),
        .Err(_) => assert(false),
    }
    assert(out_res.len == 6 && out_res[5].tag == 88)

    mut stream_res: []Result<SuiteResource, string> = [
        .Ok(SuiteResource { tag: 91, data: [9] }),
        .Err("skip"),
        .Ok(SuiteResource { tag: 92, data: [10] }),
    ]
    for item in move stream_res {
        match item {
            .Ok(c) => out_res.push(move c),
            .Err(_) => {},
        }
    }
    assert(out_res.len == 8 && out_res[6].tag == 91 && out_res[7].tag == 92)
}

@resource(dispose)
struct ResizeCell { n: i32 }
impl ResizeCell { fn dispose(&self) { assert(self.n > 0) } }
@test fn resize_with_constructs_only_new_move_only_elements() {
    mut cells: []ResizeCell = [ResizeCell { n: 7 }]
    mut calls := 0
    {
        make := fn[&mut calls]() -> ResizeCell { calls += 1; ResizeCell { n: calls } }
        array.resize_with(&mut cells, 4, &mut make)
        assert(cells.len == 4 && cells[0].n == 7 && cells[1].n == 1 && cells[3].n == 3)
        array.resize_with(&mut cells, 4, &mut make)
        array.resize_with(&mut cells, 1, &mut make)
        assert(cells.len == 1 && cells[0].n == 7)
    }
    assert(calls == 3)
}

@test fn utf8_view_hash_matches_the_owned_substring() {
    text := "xö東🦊!"
    expected := ["", "ö", "東", "🦊", "ö東🦊"]
    starts := [1, 1, 3, 6, 1]
    ends := [1, 3, 6, 10, 10]
    for i in 0..expected.len {
        borrowed := &text[starts[i]..ends[i]]
        assert(borrowed.hash() == expected[i].hash())
    }
}
