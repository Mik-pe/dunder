@test
fn standard_collections_and_text_compose() {
    mut seen := Set<string>::new()
    mut counts := Map<string, i64>::new()
    parts := text.split("alpha beta alpha år alpha år", " ")
    for word in move parts {
        unused := seen.insert(word.clone())
        count := counts.get_or(word, 0) + 1
        counts.put(move word, count)
    }
    assert(seen.len() == 3)
    assert(counts.get_or("alpha", 0) == 3)
    assert(counts.get_or("år", 0) == 2)
    assert(counts.get_or("beta", 0) == 1)
}

@test
fn standard_parsers_hashes_and_bytes_compose() {
    parsed := parse.i64_range("xx420yy", 2, 5)
    assert(parsed.ok && parsed.value == 420)
    hex_val := parse.hex_u64_range("ff", 0, 2)
    assert(hex_val.ok && hex_val.value == 255)
    digest := sha256.text("abc")
    hex_digest := bytes.hex(&digest)
    assert(hex_digest == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "HTTP ")
    bytes.append_decimal(&mut out, 200)
    assert(bytes.equals_text(&out, 0, out.len, "HTTP 200"))
}

@test
fn standard_impl_methods_compose() {
    mut s := set.Set<string>::new()
    _ := s.insert("alpha")
    _ := s.insert("beta")
    assert(s.len() == 2 && s.contains("alpha"))

    mut m := Map<string, i64>::new()
    m.put("a", 10)
    assert(m.len() == 1 && m.get_or("a", 0) == 10)

    p := parse.Integer::parse("42")
    assert(p.ok && p.value == 42)

    doc := json.Doc::parse_text("{\"ok\":true,\"n\":7}")
    assert(doc.ok && doc.get_bool(doc.root, "ok").value && doc.get_i64(doc.root, "n").value == 7)

    mut wbuf: []u8 = []
    wire.put_varint(&mut wbuf, 123)
    mut r := wire.Reader::new()
    assert(r.read_varint(&wbuf) == 123 && r.finish(&wbuf))
}

fn sum_i32_slice(values: &[]i32) -> i32 {
    mut total: i32 = 0
    for i in 0..values.len {
        total = total + values[i]
    }
    total
}

fn sum_i32_slice_widened(values: &[]i32) -> i64 {
    mut total: i64 = 0
    for i in 0..values.len {
        total = total + i64(values[i])
    }
    total
}

fn add_i32_slices_in_place(dst: &mut []i32, src: &[]i32, delta: i32) {
    mut i: i32 = 0
    while i < dst.len && i < src.len {
        dst[i] = src[i] + delta
        i = i + 1
    }
}

fn general_signed_div_rem(x: i32, y: i64) -> i64 {
    mut scratch: []i32 = [x]
    q1 := scratch[0] / 3
    r1 := scratch[0] % 3
    q2 := scratch[0] / -7
    r2 := scratch[0] % -7
    q3 := scratch[0] / 1
    r3 := scratch[0] % 1
    q4 := y / -3
    r4 := y % -3
    q5 := y / 10
    r5 := y % 10
    q6 := i64(scratch[0]) / -2147483648
    assert(q1 * 3 + r1 == scratch[0])
    assert(q2 * -7 + r2 == scratch[0])
    assert(q3 == scratch[0] && r3 == 0)
    assert(q4 * -3 + r4 == y)
    assert(q5 * 10 + r5 == y)
    i64(q1) + i64(r2) + q4 + r5 + q6
}

@test
fn i32_scalar_slices_and_general_const_div_work_correctly() {
    mut dst: []i32 = [10, -20, 30, -40]
    src: []i32 = [-7, 42, -2147483648, 123]
    add_i32_slices_in_place(&mut dst, &src, 5)
    assert(dst[0] == -2 && dst[1] == 47 && dst[2] == -2147483643 && dst[3] == 128)
    assert(sum_i32_slice(&dst) == -2147483470)
    assert(sum_i32_slice_widened(&src) == i64(-2147483490))

    assert(general_signed_div_rem(-25, -100) == i64(-25 / 3) + i64(-25 % -7) + (-100 / -3) + (-100 % 10) + 0)
    assert(general_signed_div_rem(-2147483648, 99) == i64(-2147483648 / 3) + i64(-2147483648 % -7) + (99 / -3) + (99 % 10) + 1)

    mut u8s: []u8 = [200]
    a8: u8 = u8s[0] / 16
    b8: u8 = u8s[0] % 16
    a32: u32 = u32(1000000007) / 64
    b32: u32 = u32(1000000007) % 64
    a64: u64 = u64(0x8000000000000005) / 0x8000000000000000
    b64: u64 = u64(0x8000000000000005) % 0x8000000000000000
    u1: u64 = a64 / 1
    r1: u64 = a64 % 1
    assert(a8 == 12 && b8 == 8)
    assert(a32 * 64 + b32 == 1000000007)
    assert(a64 == 1 && b64 == 5 && u1 == 1 && r1 == 0)
}
