import ..selfhost.compile as compiler
import .scalar_pass as scalar_pass
import .scalar_verify as scalar_verify
import .machine_ir as machine_ir
import .const_div as const_div
import .frame_free as frame_free
import .range_analysis as range_analysis
import .range_arithmetic as range_arithmetic
import .typed_nodes as typed_nodes
import .inline_catalog as inline_catalog
import .language_extensions as language_extensions
import .net_loopback as net_loopback
import std.array as array
import std.bytes as bytes
import std.hash as hash
import std.map as map
import std.parse as parse
import std.set as set
import std.sha256 as sha256
import std.text as text

@test
fn standard_collections_and_text_compose() {
    var seen := set.new()
    var counts := map.new()
    parts := text.split("alpha beta alpha år alpha år", " ")
    for i in 0..parts.len {
        word := parts[i]
        unused := set.insert(&mut seen, word)
        map.put(&mut counts, word, map.get_or(&counts, word, 0) + 1)
    }
    assert(set.length(&seen) == 3)
    assert(map.get_or(&counts, "alpha", 0) == 3)
    assert(map.get_or(&counts, "år", 0) == 2)
    assert(map.get_or(&counts, "beta", 0) == 1)
}

@test
fn standard_parsers_hashes_and_bytes_compose() {
    parsed := parse.i64_range("xx420yy", 2, 5)
    assert(parsed.ok && parsed.value == 420)
    hex_val := parse.hex_u64_range("ff", 0, 2)
    assert(hex_val.ok && hex_val.value == 255)
    digest := sha256.text("abc")
    hex_digest := bytes.hex(&digest)
    assert(hex_digest == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    var out: []u8 = []
    bytes.append_utf8(&mut out, "HTTP ")
    bytes.append_decimal(&mut out, 200)
    assert(bytes.equals_text(&out, 0, out.len, "HTTP 200"))
}
