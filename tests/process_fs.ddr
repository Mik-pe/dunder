capability process, filesystem

import .process_worker as worker
import std.bytes as bytes
import std.fs as fs
import std.process as process
import sys

@test
fn fs_temp_dir_links_listing_and_safe_remove_all() {
    cur := fs.cwd()
    assert(cur.ok && cur.value.len > 0)

    outside := fs.temp_dir("dunder-outside-")
    assert(outside.ok)
    defer { _ := fs.remove_all(outside.value) }
    keep_file := outside.value + "/keep.txt"
    assert(sys.write_text(keep_file, "untouched").ok)

    tmp := fs.temp_dir("dunder-fs-")
    assert(tmp.ok)
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    nested := work + "/a/b/c"
    assert(fs.mkdir_all(nested).ok)
    assert(fs.mkdir_all(nested).ok)
    assert(sys.write_text(nested + "/fil å.txt", "hej 🌍").ok)
    assert(sys.write_text(work + "/z.txt", "z").ok)

    // Symlink inside work pointing to outside directory MUST NOT delete outside target on remove_all.
    sym := work + "/escape_link"
    assert(fs.symlink(outside.value, sym).ok)
    assert(fs.is_symlink(sym))
    assert(!fs.is_symlink(work + "/z.txt"))

    canon := fs.realpath(sym + "/keep.txt")
    assert(canon.ok)
    outside_canon := fs.realpath(keep_file)
    assert(outside_canon.ok && canon.value == outside_canon.value)

    hlink := work + "/hard.txt"
    assert(fs.hard_link(work + "/z.txt", hlink).ok)
    assert(sys.read_text(hlink).value == "z")

    listing := fs.list_dir(work)
    assert(listing.ok && listing.entries.len == 4)
    assert(listing.entries[0] == "a")
    assert(listing.entries[1] == "escape_link")
    assert(listing.entries[2] == "hard.txt")
    assert(listing.entries[3] == "z.txt")

    granted := fs.grant_dir(work)
    assert(worker.count_granted_dir(&granted) == 4)

    assert(fs.remove_all(work).ok)
    assert(!sys.metadata(work).ok)
    // Outside target must still exist intact!
    assert(sys.read_text(keep_file).value == "untouched")
}

@test
fn process_grant_and_env_cwd_stderr_exit_code() {
    os := process.host_os()
    assert(os == "macos" || os == "linux")
    target := process.host_target()
    assert(target == "arm64-macos" || target == "arm64-linux" || target == "x86_64-linux")

    tmp := fs.temp_dir("dunder-proc-env-")
    assert(tmp.ok)
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    sh_grant := process.grant("/bin/sh")
    assert(worker.run_granted_echo(&sh_grant, "hej åäö 🌍") == "hej åäö 🌍")

    var env_check := process.command("/usr/bin/env", [])
    process.clear_env(&mut env_check)
    process.set_env(&mut env_check, "FOO", "bar")
    env_res := process.exec(&env_check)
    assert(process.succeeded(&env_res))
    assert(process.stdout_text(&env_res) == "FOO=bar\n")

    var env_cmd := process.command("/bin/sh", ["-c", "pwd; printf '%s' \"$FOO\"; printf 'err!' >&2; exit 17"])
    process.set_cwd(&mut env_cmd, work)
    process.clear_env(&mut env_cmd)
    process.set_env(&mut env_cmd, "FOO", "bar")
    res := process.exec(&env_cmd)
    assert(res.ok && !res.timed_out && res.code == 17)
    assert(process.stderr_text(&res) == "err!")
    real_work := fs.realpath(work).value
    assert(process.stdout_text(&res) == real_work + "\nbar")
}

@test
fn process_large_simultaneous_stdin_stdout_pipe_without_deadlock() {
    var big: []u8 = []
    big.reserve(300000)
    for i in 0..300000 { big.push(u8((i * 31 + 7).bit_and(255))) }
    var cat_cmd := process.command("cat", [])
    process.set_stdin(&mut cat_cmd, &big)
    process.set_timeout(&mut cat_cmd, 10000)
    cat_out := process.exec(&cat_cmd)
    assert(process.succeeded(&cat_out))
    assert(cat_out.stdout.len == big.len)
    assert(cat_out.stdout[0] == big[0] && cat_out.stdout[199999] == big[199999] && cat_out.stdout[299999] == big[299999])
}

@test
fn process_launch_failures_report_portable_errno() {
    tmp := fs.temp_dir("dunder-proc-err-")
    assert(tmp.ok)
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    missing := process.run("/nonexistent-dunder-binary-xyz", [])
    assert(!missing.ok && missing.error == 2)

    non_exec := work + "/not_exec.txt"
    assert(sys.write_text(non_exec, "#!/bin/sh\necho no\n").ok)
    denied := process.run(non_exec, [])
    assert(!denied.ok && denied.error == 13)
}

@test
fn process_timeout_and_background_child_spawn() {
    var slow := process.command("/bin/sh", ["-c", "sleep 10"])
    process.set_timeout(&mut slow, 60)
    timed := process.exec(&slow)
    assert(!timed.ok && timed.timed_out && timed.code == 124 && timed.error == 60)

    var bg_cmd := process.command("/bin/sh", ["-c", "echo READY 4321; while sleep 1; do :; done"])
    sp := process.spawn(&bg_cmd)
    assert(sp.ok)
    var child := sp.child
    assert(process.child_pid(&child) > 0)
    line := process.read_stdout_line(&mut child, 5000)
    assert(line.ok && line.value == "READY 4321")
    alive := process.try_wait(&mut child)
    assert(alive.ok && !alive.exited)
    assert(process.terminate(&mut child).ok)
    waited := process.wait(&mut child, 5000)
    assert(waited.ok && waited.exited && !waited.timed_out)

    assert(process.host_cpus() >= 1)
    var pool := process.set_new(4)
    defer { process.set_kill_all(&mut pool) }
    cmd0 := process.command("/bin/sh", ["-c", "printf A"])
    cmd1 := process.command("/bin/sh", ["-c", "printf B; exit 7"])
    var c0 := process.spawn(&cmd0).child
    var c1 := process.spawn(&cmd1).child
    s0 := process.set_insert(&mut pool, &mut c0)
    s1 := process.set_insert(&mut pool, &mut c1)
    assert(s0 == 0 && s1 == 1 && process.set_len(&pool) == 2)
    var o0: []u8 = []; var e0: []u8 = []
    var o1: []u8 = []; var e1: []u8 = []
    var r0 := process.WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 0 }
    var r1 := process.WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 0 }
    while process.set_len(&pool) > 0 {
        _ := process.set_wait_any(&mut pool, 100)
        if process.set_active(&pool, s0) { r0 = process.set_try_wait(&mut pool, s0, &mut o0, &mut e0) }
        if process.set_active(&pool, s1) { r1 = process.set_try_wait(&mut pool, s1, &mut o1, &mut e1) }
    }
    assert(r0.ok && r0.exited && r0.code == 0 && bytes.decode(&o0).value == "A")
    assert(r1.ok && r1.exited && r1.code == 7 && bytes.decode(&o1).value == "B")
}
