capability process, filesystem

import support.process_worker as worker
import std.bytes as bytes
import std.fs as fs
import std.process as process
import sys

@test
fn fs_temp_dir_links_listing_and_safe_remove_all() {
    cur := fs.cwd()
    assert(cur.ok && cur.value.len > 0)

    outside := fs.temp_dir("dunder-outside-")
    assert(outside.ok)
    defer { _ := fs.remove_all(outside.value) }
    keep_file := outside.value + "/keep.txt"
    assert(sys.write_text(keep_file, "untouched").ok)

    tmp := fs.temp_dir("dunder-fs-")
    assert(tmp.ok)
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    nested := work + "/a/b/c"
    assert(fs.mkdir_all(nested).ok)
    assert(fs.mkdir_all(nested).ok)
    assert(sys.write_text(nested + "/fil å.txt", "hej 🌍").ok)
    assert(sys.write_text(work + "/z.txt", "z").ok)

    sym := work + "/escape_link"
    assert(fs.symlink(outside.value, sym).ok)
    assert(fs.is_symlink(sym))
    assert(!fs.is_symlink(work + "/z.txt"))

    canon := fs.realpath(sym + "/keep.txt")
    assert(canon.ok)
    outside_canon := fs.realpath(keep_file)
    assert(outside_canon.ok && canon.value == outside_canon.value)

    hlink := work + "/hard.txt"
    assert(fs.hard_link(work + "/z.txt", hlink).ok)
    assert(sys.read_text(hlink).value == "z")

    listing := fs.list_dir(work)
    assert(listing.is_ok())
    entries := listing.unwrap()
    assert(entries.len == 4)
    assert(entries[0] == "a")
    assert(entries[1] == "escape_link")
    assert(entries[2] == "hard.txt")
    assert(entries[3] == "z.txt")

    granted := fs.ReadDir::grant(work.clone())
    assert(worker.count_granted_dir(&granted) == 4)

    assert(fs.remove_all(work).ok)
    assert(!sys.metadata(work).ok)
    assert(sys.read_text(keep_file).value == "untouched")
}

@test
fn process_grant_and_env_cwd_stderr_exit_code() {
    os := process.host_os()
    assert(os == "macos" || os == "linux")
    target := process.host_target()
    assert(target == "arm64-macos" || target == "arm64-linux" || target == "x86_64-linux")

    tmp := fs.temp_dir("dunder-proc-env-")
    assert(tmp.ok)
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    sh_grant := process.Executable::grant("/bin/sh")
    assert(worker.run_granted_echo(&sh_grant, "hej åäö 🌍") == "hej åäö 🌍")

    mut env_check := process.Command::new("/usr/bin/env", [])
    env_check.clear_env()
    env_check.set_env("FOO", "bar")
    env_res := env_check.exec()
    assert(env_res.succeeded())
    assert(env_res.stdout_text() == "FOO=bar\n")

    mut env_cmd := process.Command::new("/bin/sh", ["-c", "pwd; printf '%s' \"$FOO\"; printf 'err!' >&2; exit 17"])
    env_cmd.set_cwd(work.clone())
    env_cmd.clear_env()
    env_cmd.set_env("FOO", "bar")
    res := env_cmd.exec()
    assert(res.ok && !res.timed_out && res.code == 17)
    assert(res.stderr_text() == "err!")
    real_work := fs.realpath(work).value
    assert(res.stdout_text() == real_work + "\nbar")
}

@test
fn process_large_simultaneous_stdin_stdout_pipe_without_deadlock() {
    mut big: []u8 = []
    big.reserve(300000)
    for i in 0..300000 { big.push(u8((i * 31 + 7).bit_and(255))) }
    size := big.len
    first := big[0]; middle := big[199999]; last := big[299999]
    mut cat_cmd := process.Command::new("cat", [])
    cat_cmd.set_stdin(move big)
    cat_cmd.set_timeout(10000)
    cat_out := cat_cmd.exec()
    assert(cat_out.succeeded())
    assert(cat_out.stdout.len == size)
    assert(cat_out.stdout[0] == first && cat_out.stdout[199999] == middle && cat_out.stdout[299999] == last)
}

@test
fn process_launch_failures_report_portable_errno() {
    tmp := fs.temp_dir("dunder-proc-err-")
    assert(tmp.ok)
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    missing := process.run("/nonexistent-dunder-binary-xyz", [])
    assert(!missing.ok && missing.error == 2)

    non_exec := work + "/not_exec.txt"
    assert(sys.write_text(non_exec, "#!/bin/sh\necho no\n").ok)
    denied := process.run(non_exec, [])
    assert(!denied.ok && denied.error == 13)
}

@test
fn process_timeout_and_background_child_spawn() {
    mut slow := process.Command::new("/bin/sh", ["-c", "sleep 10"])
    slow.set_timeout(60)
    timed := slow.exec()
    assert(!timed.ok && timed.timed_out && timed.code == 124 && timed.error == 60)

    mut bg_cmd := process.Command::new("/bin/sh", ["-c", "echo READY 4321; while sleep 1; do :; done"])
    sp := bg_cmd.spawn()
    assert(sp.is_ok())
    mut child := sp.unwrap()
    assert(child.pid() > 0)
    line := child.read_stdout_line(5000)
    assert(line.is_ok() && line.unwrap().unwrap_or("") == "READY 4321")
    alive := child.try_wait()
    assert(alive.ok && !alive.exited)
    assert(child.terminate().ok)
    waited := child.wait(5000)
    assert(waited.ok && waited.exited && !waited.timed_out)

    assert(process.host_cpus() >= 1)
    mut pool := process.ChildSet::new(4)
    defer { pool.kill_all() }
    cmd0 := process.Command::new("/bin/sh", ["-c", "printf A"])
    cmd1 := process.Command::new("/bin/sh", ["-c", "printf B; exit 7"])
    mut c0 := cmd0.spawn().unwrap()
    mut c1 := cmd1.spawn().unwrap()
    s0 := pool.insert(&mut c0)
    s1 := pool.insert(&mut c1)
    assert(s0 == 0 && s1 == 1 && pool.len() == 2)
    mut o0: []u8 = []; mut e0: []u8 = []
    mut o1: []u8 = []; mut e1: []u8 = []
    mut r0 := process.WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 0 }
    mut r1 := process.WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 0 }
    while pool.len() > 0 {
        _ := pool.poll_io(100)
        if pool.is_active(s0) { r0 = pool.try_wait(s0, &mut o0, &mut e0) }
        if pool.is_active(s1) { r1 = pool.try_wait(s1, &mut o1, &mut e1) }
    }
    assert(r0.ok && r0.exited && r0.code == 0 && bytes.decode(&o0).value == "A")
    assert(r1.ok && r1.exited && r1.code == 7 && bytes.decode(&o1).value == "B")
}

@test
fn full_child_set_returns_the_live_child_owner() {
    mut pool := process.ChildSet::new(1)
    defer { pool.kill_all() }

    occupied := process.Command::new("/usr/bin/true", []).spawn()
    assert(occupied.is_ok())
    match pool.try_insert(occupied.unwrap()) {
        .Ok(slot) => { assert(slot == 0) },
        .Err(move_failed) => {
            mut unexpected := move_failed
            _ := unexpected.wait(5000)
            assert(false)
        },
    }

    spawn := process.Command::new("/bin/sh", ["-c", "exit 7"]).spawn()
    assert(spawn.is_ok())
    mut child_spawn := spawn.unwrap()
    pid := child_spawn.pid()
    match pool.try_insert(move child_spawn) {
        .Ok(_) => { assert(false) },
        .Err(returned) => {
            mut child := returned
            assert(child.pid() == pid)
            waited := child.wait(5000)
            assert(waited.ok && waited.exited && waited.code == 7)
        },
    }
    assert(pool.len() == 1)
}

@test
fn process_and_fs_impl_methods() {
    tmp := fs.temp_dir("dunder-impl-fs-")
    assert(tmp.ok)
    root := tmp.value
    defer { _ := fs.remove_all(root) }

    wf := fs.WriteFile::grant(root + "/hello.txt")
    assert(wf.write("hello ").ok)
    assert(wf.append("impl").ok)

    dir := fs.ReadDir::grant(root.clone())
    opened := dir.resolve_read("hello.txt")
    assert(opened.is_ok())
    rf := opened.unwrap()
    txt := rf.read()
    assert(txt.ok && txt.value == "hello impl")
    listed := dir.list()
    assert(listed.is_ok() && listed.unwrap().len == 1)

    exe := process.Executable::grant("/bin/echo")
    mut cmd := process.Command::new(exe.path(), [])
    cmd.add_arg("dunder-impl")
    out := exe.exec(&cmd)
    assert(out.succeeded() && out.stdout_text() == "dunder-impl\n")

    mut set := process.ChildSet::new(2)
    defer { set.kill_all() }
    assert(set.len() == 0)
}
