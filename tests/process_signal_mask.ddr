capability unsafe, process
import ..stdlib.process as process

@extern("c", "sigemptyset") unsafe fn c_empty(set: ptr) -> i32
@extern("c", "sigaddset") unsafe fn c_add(set: ptr, signal: i32) -> i32
@extern("c", "sigismember") unsafe fn c_member(set: ptr, signal: i32) -> i32
@extern("c", "sigprocmask") unsafe fn c_mask(how: i32, set: ptr, previous: ptr) -> i32

fn main() {
    unsafe {
        mut set: [u64; 16] = [0; 16]
        mut previous: [u64; 16] = [0; 16]
        assert(c_empty(addr(&mut set[0])) == 0)
        assert(c_add(addr(&mut set[0]), 15) == 0)
        assert(c_add(addr(&mut set[0]), 2) == 0)
        mut block := 0
        mut replace := 2
        if target_is("macos") { block = 1; replace = 3 }
        assert(c_mask(block, addr(&set[0]), addr(&mut previous[0])) == 0)
        for command in ["kill -TERM $$", "kill -INT $$"] {
            child := process.command("/bin/sh", ["-c", command.clone()])
            result := child.exec()
            assert(result.ok && result.signal > 0 && result.code >= 128)
            if command == "kill -TERM $$" { assert(result.signal == 15) }
            else { assert(result.signal == 2) }
            mut current: [u64; 16] = [0; 16]
            assert(c_mask(block, ptr(0), addr(&mut current[0])) == 0)
            assert(c_member(addr(&current[0]), 15) == 1)
            assert(c_member(addr(&current[0]), 2) == 1)
        }
        assert(c_mask(replace, addr(&previous[0]), ptr(0)) == 0)
    }
    print("process signal masks ok")
}
