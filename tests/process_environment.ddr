capability process, unsafe
import ..stdlib.process as process
import std.bytes
import std.json
import sys

@extern("c", "getenv") unsafe fn c_getenv(name: ptr) -> ptr
@extern("c", "setenv") unsafe fn c_setenv(name: ptr, value: ptr, overwrite: i32) -> i32
@extern("c", "unsetenv") unsafe fn c_unsetenv(name: ptr) -> i32
@extern("c", "clearenv") unsafe fn c_clearenv() -> i32

fn cstr(value: string) -> []u8 {
    mut out: []u8 = []; bytes.append_utf8(&mut out, value); out.push(0); out
}
fn set(name: string, value: string) {
    key := cstr(name); encoded := cstr(value)
    unsafe { assert(c_setenv(addr(&key[0]), addr(&encoded[0]), 1) == 0) }
}
fn unset(name: string) {
    key := cstr(name)
    unsafe { assert(c_unsetenv(addr(&key[0])) == 0) }
}
fn native_value(name: string) -> string {
    key := cstr(name)
    unsafe {
        value := c_getenv(addr(&key[0])); assert(value != ptr(0))
        mut out: []u8 = []
        for i in 0..128 {
            byte := load_u8(ptr(usize(value) + usize(i)))
            if byte == 0 { return bytes.decode(&out).value }
            out.push(byte)
        }
    }
    assert(false); ""
}
fn child() -> i32 {
    mut out: []u8 = []; mut first := json.begin_obj(&mut out)
    json.field_i32(&mut out, &mut first, "pid", sys.pid())
    json.field_str(&mut out, &mut first, "argv0", sys.arg(0))
    for key in ["DUNDER_ENV_ADDED", "DUNDER_ENV_CHANGED", "DUNDER_ENV_DELETED", "DUNDER_ENV_EMPTY"] {
        entry := process.env(key)
        json.field_str(&mut out, &mut first, key, entry.clone().unwrap_or(""))
        json.field_bool(&mut out, &mut first, key + "_found", entry.is_some())
    }
    json.end_obj(&mut out); print(bytes.decode(&out).value)
    0
}
fn main() -> i32 {
    assert(sys.arg_count() >= 2)
    mode := sys.arg(1)
    if mode == "child" { return child() }
    assert(process.env_or("DUNDER_ENV_CHANGED", "") == "original")
    assert(process.env_or("DUNDER_ENV_DELETED", "") == "delete-me")
    assert(native_value("DUNDER_ENV_CHANGED") == "original")
    assert(native_value("DUNDER_ENV_DELETED") == "delete-me")
    set("DUNDER_ENV_ADDED", "added å 🌍")
    set("DUNDER_ENV_CHANGED", "changed")
    unset("DUNDER_ENV_DELETED")
    set("DUNDER_ENV_EMPTY", "")
    assert(native_value("DUNDER_ENV_ADDED") == "added å 🌍")
    assert(native_value("DUNDER_ENV_CHANGED") == "changed")
    assert(process.env_or("DUNDER_ENV_ADDED", "missing") == "added å 🌍")
    assert(process.env_or("DUNDER_ENV_CHANGED", "missing") == "changed")
    assert(process.env("DUNDER_ENV_DELETED").is_none())
    assert(process.env("DUNDER_ENV_EMPTY").is_some() && process.env("DUNDER_ENV_EMPTY").unwrap() == "")
    if mode == "clear" {
        if target_is("linux") {
            unsafe { assert(c_clearenv() == 0) }
            assert(process.env("PATH").is_none() && process.env("DUNDER_ENV_CHANGED").is_none())
            args: []string = ["child"]
            output := process.Command::new(sys.arg(0), args.clone()).exec()
            assert(output.ok && output.code == 0 && output.signal == 0)
            print(bytes.decode(&output.stdout).value)
            status := process.replace_as(sys.arg(0), "cleared-environment", &args)
            print("unexpected exec failure " + status.error.str()); return 99
        }
        return 45
    }
    assert(sys.arg_count() == 3)
    set("PATH", sys.arg(2))
    if mode == "spawn" || mode == "override" {
        mut command := process.Command::new("dunder-live-environment", ["child"])
        if mode == "override" {
            command.set_env("DUNDER_ENV_ADDED", "child override")
            command.unset_env("DUNDER_ENV_CHANGED")
        }
        output := command.exec()
        assert(output.ok && output.code == 0 && output.signal == 0)
        print(bytes.decode(&output.stdout).value)
        assert(process.env_or("DUNDER_ENV_ADDED", "") == "added å 🌍")
        assert(process.env_or("DUNDER_ENV_CHANGED", "") == "changed")
        return 0
    }
    args: []string = ["child"]
    mut result := sys.Status { ok: false, error: 22 }
    if mode == "replace" { result = process.replace("dunder-live-environment", &args) }
    else if mode == "replace-as" { result = process.replace_as("dunder-live-environment", "live-environment-alias", &args) }
    else if mode == "unset-path" {
        unset("PATH"); assert(process.env("PATH").is_none())
        output := process.Command::new("sh", ["-c", "printf default-path"]).exec()
        assert(output.ok && output.code == 0 && bytes.decode(&output.stdout).value == "default-path")
        result = process.replace("sh", &["-c", "printf default-path"])
    } else { assert(false) }
    print("unexpected exec failure " + result.error.str()); 99
}
