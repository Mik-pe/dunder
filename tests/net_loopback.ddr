capability network, filesystem

import std.bytes as bytes
import std.fs as fs
import std.net as net
import sys

@test
fn clock_and_confined_dir_bytes() {
    t0 := sys.now_ms()
    assert(t0 > 0)

    tmp := fs.temp_dir("dunder-netfs-")
    assert(tmp.ok)
    root := tmp.value
    sub := root + "/sub"
    defer { unused := sys.remove_dir(root) }
    assert(sys.mkdir(sub).ok)
    defer { unused := sys.remove_dir(sub) }

    bin_path := sub + "/payload.bin"
    mut raw: []u8 = [0, 1, 2, 13, 10, 128, 255, 65]
    assert(sys.write_u8(bin_path, &raw).ok)
    defer { unused := sys.remove_file(bin_path) }

    dir := fs.ReadDir::grant(root.clone())
    assert(dir.resolve_read("").is_err())
    assert(dir.resolve_read("/etc/passwd").is_err())
    assert(dir.resolve_read("../secret.txt").is_err())
    assert(dir.resolve_read("sub/../secret.txt").is_err())
    assert(dir.resolve_read(".").is_err())
    assert(dir.resolve_read("sub/").is_err())
    assert(dir.resolve_read("sub\\payload.bin").is_err())
    assert(dir.resolve_read("sub//payload.bin").is_err())

    opened := dir.resolve_read("sub/payload.bin")
    assert(opened.is_ok())
    file := opened.unwrap()
    loaded := file.read_bytes().unwrap()
    assert(loaded.len == 8)
    assert(loaded[0] == 0 && loaded[5] == 128 && loaded[6] == 255 && loaded[7] == 65)
    assert(file.read_bytes_limit(7) == .Err(.TooLarge))
    assert(file.read_bytes_limit(8) == .Ok(loaded.clone()))
    assert(file.read().unwrap_err() == .InvalidUtf8)

    assert(bytes.decode_range(&loaded, 5, 7) == .Err(.InvalidUtf8))

    t1 := sys.now_ms()
    assert(t1 >= t0)
}

@test
fn loopback_nonblocking_poll_roundtrip() {
    lres := net.TcpListener::listen(net.loopback(), 0, 16)
    assert(lres.is_ok())
    mut listener := lres.unwrap()
    defer { unused := listener.close() }

    port := listener.local_port()
    assert(port > 0)
    assert(listener.set_nonblocking(true).ok)

    empty := listener.accept()
    match empty {
        .Ok(_) => { assert(false) },
        .Err(err) => { assert(err.is_would_block()) },
    }

    cres := net.TcpStream::connect(net.loopback(), port)
    assert(cres.is_ok())
    mut client := cres.unwrap()
    defer { unused := client.close() }
    assert(client.set_nodelay(true).ok)

    mut req: []u8 = []
    bytes.append_utf8(&mut req, "PING\r\n")
    assert(client.write_all(&req).ok)

    mut ps := net.PollSet::new()
    ps.add(listener.fd(), net.poll_in())
    pr := ps.poll(2000)
    assert(pr.is_ok() && pr.unwrap() == 1)
    assert(ps.revents[0].bit_and(net.poll_in()) != 0)

    ares := listener.accept()
    assert(ares.is_ok())
    mut accepted := ares.unwrap()
    defer { unused := accepted.close() }
    assert(accepted.set_nonblocking(true).ok)
    assert(accepted.set_nodelay(true).ok)

    mut srx: []u8 = []
    ps.clear()
    ps.add(accepted.fd(), net.poll_in())
    pr2 := ps.poll(2000)
    assert(pr2.is_ok() && pr2.unwrap() == 1)
    rr := accepted.read_append(&mut srx, 1024)
    assert(rr.is_ok() && rr.unwrap() == 6)
    assert(bytes.equals_text(&srx, 0, srx.len, "PING\r\n"))

    rr_again := accepted.read_append(&mut srx, 1024)
    match rr_again {
        .Ok(_) => { assert(false) },
        .Err(err) => { assert(err.is_would_block()) },
    }

    mut pong: []u8 = []
    bytes.append_utf8(&mut pong, "PONG\r\n")
    wr := accepted.write_range(&pong, 0, pong.len)
    assert(wr.is_ok() && wr.unwrap() == 6)
    assert(accepted.shutdown_write().ok)

    mut crx: []u8 = []
    for _ in 0..4 {
        r := client.read_append(&mut crx, 64)
        assert(r.is_ok())
        if r.unwrap() == 0 { break }
    }
    assert(bytes.equals_text(&crx, 0, crx.len, "PONG\r\n"))

    assert(client.close().ok)
    assert(client.close().ok)
}

@test
fn stream_set_pool_and_slot_reuse() {
    lres := net.TcpListener::listen(net.loopback(), 0, 16)
    assert(lres.is_ok())
    mut listener := lres.unwrap()
    defer { unused := listener.close() }
    port := listener.local_port()
    assert(port > 0)

    c1_res := net.TcpStream::connect(net.loopback(), port)
    assert(c1_res.is_ok())
    mut c1 := c1_res.unwrap()
    defer { unused := c1.close() }

    a1_res := listener.accept()
    assert(a1_res.is_ok())
    a1 := a1_res.unwrap()
    assert(a1.set_nonblocking(true).ok)
    a1_fd := a1.fd()

    mut pool := net.StreamSet::new()
    defer { pool.close_all() }
    slot0 := pool.insert(move a1)
    assert(slot0 == 0 && pool.len() == 1 && pool.fd(slot0) == a1_fd)

    mut msg: []u8 = []
    bytes.append_utf8(&mut msg, "SLOT\r\n")
    assert(c1.write_all(&msg).ok)

    mut ps := net.PollSet::new()
    ps.add(pool.fd(slot0), net.poll_in())
    assert(ps.poll(2000).is_ok())

    mut rx: []u8 = []
    rr := pool.read_append(slot0, &mut rx, 64)
    assert(rr.is_ok() && rr.unwrap() == 6 && bytes.equals_text(&rx, 0, rx.len, "SLOT\r\n"))

    mut reply: []u8 = []
    bytes.append_utf8(&mut reply, "ACK\r\n")
    wr := pool.write_range(slot0, &reply, 0, reply.len)
    assert(wr.is_ok() && wr.unwrap() == 5)
    assert(pool.shutdown_write(slot0).ok)

    mut crx: []u8 = []
    for _ in 0..4 {
        r := c1.read_append(&mut crx, 64)
        assert(r.is_ok())
        if r.unwrap() == 0 { break }
    }
    assert(bytes.equals_text(&crx, 0, crx.len, "ACK\r\n"))

    assert(pool.close(slot0).ok)
    assert(pool.fd(slot0) == -1)

    c2_res := net.TcpStream::connect(net.loopback(), port)
    assert(c2_res.is_ok())
    mut c2 := c2_res.unwrap()
    defer { unused := c2.close() }
    a2_res := listener.accept()
    assert(a2_res.is_ok())
    a2 := a2_res.unwrap()
    a2_fd := a2.fd()
    slot_reused := pool.insert(move a2)
    assert(slot_reused == 0 && pool.len() == 1 && pool.fd(slot_reused) == a2_fd)
}

@test
fn files_round_trip_through_the_os() {
    tmp := fs.temp_dir("dunder-fs-")
    assert(tmp.ok)
    root := tmp.value
    original := root + "/å 🌍.txt"
    renamed := root + "/renamed.txt"
    assert(sys.write_text(original, "Dunder 🌍\n").ok)
    assert(sys.append_text(original, "åäö").ok)
    content := sys.read_text(original)
    assert(content.ok)
    assert(content.value == "Dunder 🌍\nåäö")
    assert(content.value.runes().len == 12)
    match sys.read(original) {
        .Ok(text) => { assert(text == content.value) },
        .Err(error) => { print(sys.io_error_message(error)); assert(false) },
    }
    info := sys.metadata(original)
    assert(info.ok && info.is_file && !info.is_dir)
    assert(info.size == i64(content.value.len))
    assert(sys.metadata(root).is_dir)
    assert(sys.rename(original, renamed).ok)
    assert(sys.metadata(original).error == 2)
    assert(sys.remove_file(renamed).ok)
    assert(sys.remove_dir(root).ok)
    assert(content.value.len == 18)
}

@test
fn net_impl_methods_loopback() {
    lr := net.TcpListener::listen(net.loopback(), 0, 8)
    assert(lr.is_ok())
    mut listener := lr.unwrap()
    defer { _ := listener.close() }
    port := listener.local_port()
    assert(port > 0)

    cr := net.TcpStream::connect(net.loopback(), port)
    assert(cr.is_ok())
    mut client := cr.unwrap()
    defer { _ := client.close() }
    ar := listener.accept()
    assert(ar.is_ok())
    mut server := ar.unwrap()

    mut ps := net.PollSet::new()
    ps.add(server.fd(), net.poll_in())
    mut pool := net.StreamSet::new()
    defer { pool.close_all() }
    slot := pool.insert(move server)
    assert(pool.len() == 1)

    mut msg: []u8 = []
    bytes.append_utf8(&mut msg, "PING")
    assert(client.write_all(&msg).ok)
    assert(ps.poll(2000).is_ok())

    mut got: []u8 = []
    rr := pool.read_append(slot, &mut got, 16)
    assert(rr.is_ok() && bytes.equals_text(&got, 0, got.len, "PING"))
}

@test
fn errors_remain_values() {
    tmp := fs.temp_dir("dunder-fs-errors-")
    assert(tmp.ok)
    root := tmp.value
    defer { unused := sys.remove_dir(root) }
    missing := sys.read_text(root + "/missing")
    assert(!missing.ok)
    assert(missing.error == 2)
    assert(missing.value == "")
    match sys.read(root + "/missing") {
        .Ok(_) => { assert(false) },
        .Err(error) => {
            match error { .NotFound => {}, _ => { assert(false) } }
        },
    }
    assert(sys.error_message(missing.error) == "no such file or directory")
    assert(sys.mkdir(root).error == 17)
    assert(sys.read_text(root).error == 21)
    assert(sys.write_text(root + "\0/ignored", "bad").error == 22)
}
