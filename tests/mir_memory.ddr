import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_memory as memory
import ..selfhost.mir_opt as opt
import ..selfhost.mir_liveness as live
import ..selfhost.mir_terminals as terminals
import ..selfhost.mir_call_abi as call_abi

fn add(code: &mut arm.Code, dst: i32, a: i32, b: i32) { arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst)) }
fn compare(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn object_loop(platform: i32, mode: i32) -> arm.Code {
    var code := arm.new_for(platform); called := arm.label(&mut code)
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    if mode == 1 { arm.mov(&mut code, 4, 29) }
    if mode == 3 { arm.emit(&mut code, 4181721088 + 29 * 32 + 2) }
    if mode == 4 { arm.emit(&mut code, 4177526784 + 1024 + 29 * 32) }
    if mode == 5 { arm.emit(&mut code, 4181721088 + 31 * 32) }
    if mode == 6 { arm.emit(&mut code, 4294967295) }
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    compare(&mut code, 1, 0); arm.branch(&mut code, done, 12)
    // The caller supplies a valid object pointer in x2. This reads AND writes
    // the object, so the alias policy must prove NoRef as well as NoMod.
    var read: i64 = 4181721088; var write: i64 = 4177526784
    if mode == 8 { read = 960495616; write = 956301312 }
    arm.emit(&mut code, read + 2 * 32 + 3)
    arm.imm(&mut code, 1, 1); add(&mut code, 4, 3, 1); arm.emit(&mut code, write + 2 * 32 + 4)
    arm.load(&mut code, 1); add(&mut code, 0, 0, 3); arm.store(&mut code, 1, 0)
    if mode == 7 { arm.branch(&mut code, called, 1) }
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done); arm.load(&mut code, 1); arm.ret(&mut code); code
}
fn lifted(code: &arm.Code) -> mir.Function {
    var f := mir.new(); none: []i32 = []
    assert(lift.lift(&mut f, &code, 0, 0, 0, &none, 0)); assert(verify.verify(&mut f)); f
}
fn loop_frame_ops(f: &mir.Function) -> i32 {
    var liveness := live.new(); assert(live.analyze_into(&mut liveness, &f, 1000000)); var count := 0
    for op in 0..f.kinds.len {
        if f.modes[op] != 2 && (f.kinds[op] == 7 || f.kinds[op] == 8) &&
            f.place_kinds[f.place[op]] == 1 && live.loop_block(&liveness, f.op_blocks[op]) { count = count + 1 }
    }
    count
}
fn unchanged(f: &mir.Function, old: &mir.Function) {
    assert(f.valid == old.valid && f.verified == old.verified && f.optimizable == old.optimizable && f.unknown_control == old.unknown_control)
    assert(f.kinds.len == old.kinds.len && f.order.len == old.order.len && f.raw.len == old.raw.len && f.place_kinds.len == old.place_kinds.len)
    for op in 0..f.kinds.len {
        assert(f.kinds[op] == old.kinds[op] && f.opcodes[op] == old.opcodes[op] && f.modes[op] == old.modes[op])
        assert(f.dst[op] == old.dst[op] && f.a[op] == old.a[op] && f.b[op] == old.b[op] && f.c[op] == old.c[op])
        assert(f.imm[op] == old.imm[op] && f.effects[op] == old.effects[op] && f.flags[op] == old.flags[op] && f.abi[op] == old.abi[op])
        assert(f.reads[op] == old.reads[op] && f.writes[op] == old.writes[op] && f.clobbers[op] == old.clobbers[op] && f.place[op] == old.place[op])
    }
    for position in 0..f.order.len { assert(f.order[position] == old.order[position]) }
    for p in 0..f.place_kinds.len { assert(f.place_offsets[p] == old.place_offsets[p] && f.place_widths[p] == old.place_widths[p] && f.place_escaped[p] == old.place_escaped[p]) }
}
@test fn private_storage_requires_an_explicit_versioned_context() {
    raw := memory.conservative(); source := memory.trusted_source_objects_v1()
    assert(!memory.source_objects(&raw) && memory.source_objects(&source))
    assert(memory.policy_tag(&raw) == "mir-memory:raw-v1" && memory.policy_tag(&source) == "mir-memory:source-objects-v1")
    code := object_loop(0, 0); f := lifted(&code); old := f
    assert(memory.source_frame_eligible(&f))
    var legacy := opt.new(); var conservative := opt.new()
    a := opt.analyze_into(&mut legacy, &f); b := opt.analyze_with_context(&mut conservative, &f, &raw)
    assert(a == b && opt.status(&legacy) == opt.status(&conservative) && opt.units(&legacy) == opt.units(&conservative))
    assert(opt.private_memory_ops(&legacy) == 0 && opt.private_memory_ops(&conservative) == 0); unchanged(&f, &old)
}
@test fn trusted_private_cells_keep_indirect_reads_and_writes_without_frame_synchronization() {
    source := memory.trusted_source_objects_v1(); var work := opt.new()
    for platform in 0..4 {
        code := object_loop(platform, 0); var f := lifted(&code)
        assert(opt.analyze_with_context(&mut work, &f, &source) && opt.promoted(&work) == 3)
        assert(opt.private_memory_ops(&work) == 2 && opt.barrier_count(&work) == 0)
        opt.apply(&mut work, &mut f); assert(verify.verify(&mut f)); assert(loop_frame_ops(&f) == 0)
        var object_accesses := 0
        for op in 0..f.kinds.len {
            if (f.kinds[op] == 7 || f.kinds[op] == 8) && f.place_kinds[f.place[op]] == 0 {
                object_accesses = object_accesses + 1; assert(f.modes[op] == 0 && f.effects[op].bit_and(1) != 0)
            }
        }
        assert(object_accesses == 2)
    }
}
@test fn exposed_linkage_unknown_and_stack_counterexamples_do_not_acquire_private_proofs() {
    source := memory.trusted_source_objects_v1(); var work := opt.new()
    for mode in [1, 3, 4, 5, 6] {
        code := object_loop(0, mode); f := lifted(&code); old := f
        assert(!opt.analyze_with_context(&mut work, &f, &source) && opt.status(&work) == -2)
        assert(opt.private_memory_ops(&work) == 0); unchanged(&f, &old)
    }
    code := object_loop(0, 0); var f := lifted(&code)
    overlapping := mir.add_place(&mut f, 1, -4, 8, 0); assert(verify.verify(&mut f))
    assert(!memory.private_cell(&f, 0))
    assert(opt.analyze_with_context(&mut work, &f, &source) && opt.promoted(&work) == 2)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f)); assert(loop_frame_ops(&f) > 0)
}
@test fn calls_still_synchronize_and_keep_their_original_may_clobbers() {
    code := object_loop(0, 7); var f := lifted(&code); source := memory.trusted_source_objects_v1(); var work := opt.new()
    // Memory provenance alone cannot abstract observable call inputs/layout.
    assert(!opt.analyze_with_context(&mut work, &f, &source) && opt.status(&work) == -2)
    call_context := call_abi.trusted_source_abi_v1(); exits := terminals.no_terminals()
    assert(opt.analyze_with_contracts_budget(&mut work, &f, &source, &exits, &call_context, 4194304))
    assert(opt.private_memory_ops(&work) == 2 && opt.barrier_count(&work) == 1)
    homes := opt.promoted(&work); assert(homes > 0)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f)); assert(loop_frame_ops(&f) >= homes * 2)
    var calls := 0
    for position in 0..f.order.len {
        op := f.order[position]; if f.kinds[op] != 14 { continue }; calls = calls + 1
        assert(f.modes[op] == 0 && f.clobbers[op] == -1 && f.writes[op] == 0)
        assert(f.kinds[f.order[position - 1]] == 8 && f.kinds[f.order[position + 1]] == 7)
    }
    assert(calls == 1)
}
@test fn context_budgets_are_atomic_and_partial_pending_work_is_not_reported() {
    code := object_loop(0, 0); f := lifted(&code); old := f; source := memory.trusted_source_objects_v1(); var work := opt.new()
    assert(opt.analyze_with_context(&mut work, &f, &source)); cost := opt.units(&work)
    for limit in [0, 1, 100, cost - 1] {
        assert(!opt.analyze_with_context_budget(&mut work, &f, &source, limit) && opt.status(&work) == -3)
        assert(opt.private_memory_ops(&work) == 0 && opt.promoted(&work) == 0); unchanged(&f, &old)
    }
    assert(opt.analyze_with_context_budget(&mut work, &f, &source, cost)); unchanged(&f, &old)
}

@test fn byte_object_accesses_retain_their_width_extension_and_truncating_store() {
    code := object_loop(0, 8); var f := lifted(&code); source := memory.trusted_source_objects_v1(); var work := opt.new()
    assert(opt.analyze_with_context(&mut work, &f, &source) && opt.promoted(&work) == 3)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f)); assert(loop_frame_ops(&f) == 0)
    var narrow := 0
    for op in 0..f.kinds.len {
        if (f.kinds[op] == 7 || f.kinds[op] == 8) && f.place_kinds[f.place[op]] == 0 {
            narrow = narrow + 1; assert(f.modes[op] == 0 && f.aux[op] == 1 && f.types[op] == 1)
            if f.kinds[op] == 7 { assert(f.extensions[op] == 1) } else { assert(f.extensions[op] == 0) }
        }
    }
    assert(narrow == 2)
}

fn narrow_frame_loop(narrow_store: bool) -> arm.Code {
    var code := arm.new_for(0)
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    // LDURSW x0, [fp, #-8] and LDURB w1, [fp, #-16]
    arm.emit(&mut code, 3095396352 + i64(-8).bit_and(511) * 4096 + 928)
    arm.load(&mut code, 2); compare(&mut code, 0, 2); arm.branch(&mut code, done, 12)
    arm.emit(&mut code, 943718400 + i64(-16).bit_and(511) * 4096 + 928 + 1)
    add(&mut code, 1, 1, 0); arm.store(&mut code, 1, 1)
    if narrow_store { arm.emit(&mut code, 939524096 + i64(-8).bit_and(511) * 4096 + 928) }
    arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done); arm.load(&mut code, 1); arm.ret(&mut code); code
}

@test fn narrow_gp_frame_loads_promote_under_trusted_source_objects() {
    code := narrow_frame_loop(false); raw := memory.conservative(); source := memory.trusted_source_objects_v1()
    var raw_work := opt.new(); raw_f := lifted(&code)
    assert(opt.analyze_with_context(&mut raw_work, &raw_f, &raw) && opt.promoted(&raw_work) == 1)
    var f := lifted(&code); var work := opt.new()
    assert(opt.analyze_with_context(&mut work, &f, &source) && opt.promoted(&work) == 3)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f)); assert(loop_frame_ops(&f) == 0)
    var sxt := 0; var uxtb := 0
    for op in 0..f.kinds.len {
        if f.modes[op] == 1 && f.kinds[op] == 3 {
            if f.opcodes[op] == 1 && f.types[op] == 2 && f.aux[op] == 1984 { sxt = sxt + 1 }
            if f.opcodes[op] == 2 && f.types[op] == 1 && f.aux[op] == 448 { uxtb = uxtb + 1 }
        }
    }
    assert(sxt == 1 && uxtb == 1)
}

@test fn narrow_frame_store_still_disqualifies_cell_from_promotion() {
    code := narrow_frame_loop(true); source := memory.trusted_source_objects_v1()
    var f := lifted(&code); var work := opt.new()
    assert(opt.analyze_with_context(&mut work, &f, &source) && opt.promoted(&work) == 2)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
}
