import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_ssa as ssa
import ..selfhost.mir_opt as frame

fn model(code: &arm.Code) -> mir.Function {
    none: []i32 = []; var f := mir.new(); assert(lift.lift(&mut f, &code, 0, 0, 0, &none, 0)); assert(verify.verify(&mut f)); f
}
fn add(code: &mut arm.Code, dst: i32, a: i32, b: i32) { arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst)) }
fn mixed() -> arm.Code {
    var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    arm.imm(&mut code, 0, 4294967297); arm.store(&mut code, 0, 0)
    arm.emit(&mut code, 3091202048 + 504 * 4096 + 29 * 32); arm.mov(&mut code, 2, 0)
    arm.emit(&mut code, 3091202048 + 504 * 4096 + 29 * 32); add(&mut code, 2, 2, 0)
    arm.emit(&mut code, 3091202048 + 504 * 4096 + 29 * 32); add(&mut code, 0, 2, 0)
    arm.ret(&mut code); code
}
fn same(a: &mir.Function, b: &mir.Function) {
    assert(a.valid == b.valid)
    assert(a.verified == b.verified)
    assert(a.optimizable == b.optimizable)
    assert(a.unknown_control == b.unknown_control)
    assert(a.platform == b.platform)
    assert(a.first_word == b.first_word)
    assert(a.first_label == b.first_label)
    assert(a.first_reloc == b.first_reloc)
    assert(a.first_import == b.first_import)
    assert(a.source_words == b.source_words)
    assert(a.source_labels == b.source_labels)
    assert(a.source_relocs == b.source_relocs)
    assert(a.source_imports == b.source_imports)
    assert(a.kinds.len == b.kinds.len); for i in 0..a.kinds.len { assert(a.kinds[i] == b.kinds[i]) }
    assert(a.opcodes.len == b.opcodes.len); for i in 0..a.opcodes.len { assert(a.opcodes[i] == b.opcodes[i]) }
    assert(a.dst.len == b.dst.len); for i in 0..a.dst.len { assert(a.dst[i] == b.dst[i]) }
    assert(a.a.len == b.a.len); for i in 0..a.a.len { assert(a.a[i] == b.a[i]) }
    assert(a.b.len == b.b.len); for i in 0..a.b.len { assert(a.b[i] == b.b[i]) }
    assert(a.c.len == b.c.len); for i in 0..a.c.len { assert(a.c[i] == b.c[i]) }
    assert(a.imm.len == b.imm.len); for i in 0..a.imm.len { assert(a.imm[i] == b.imm[i]) }
    assert(a.aux.len == b.aux.len); for i in 0..a.aux.len { assert(a.aux[i] == b.aux[i]) }
    assert(a.variant.len == b.variant.len); for i in 0..a.variant.len { assert(a.variant[i] == b.variant[i]) }
    assert(a.types.len == b.types.len); for i in 0..a.types.len { assert(a.types[i] == b.types[i]) }
    assert(a.place.len == b.place.len); for i in 0..a.place.len { assert(a.place[i] == b.place[i]) }
    assert(a.extensions.len == b.extensions.len); for i in 0..a.extensions.len { assert(a.extensions[i] == b.extensions[i]) }
    assert(a.effects.len == b.effects.len); for i in 0..a.effects.len { assert(a.effects[i] == b.effects[i]) }
    assert(a.flags.len == b.flags.len); for i in 0..a.flags.len { assert(a.flags[i] == b.flags[i]) }
    assert(a.abi.len == b.abi.len); for i in 0..a.abi.len { assert(a.abi[i] == b.abi[i]) }
    assert(a.reads.len == b.reads.len); for i in 0..a.reads.len { assert(a.reads[i] == b.reads[i]) }
    assert(a.writes.len == b.writes.len); for i in 0..a.writes.len { assert(a.writes[i] == b.writes[i]) }
    assert(a.clobbers.len == b.clobbers.len); for i in 0..a.clobbers.len { assert(a.clobbers[i] == b.clobbers[i]) }
    assert(a.origins.len == b.origins.len); for i in 0..a.origins.len { assert(a.origins[i] == b.origins[i]) }
    assert(a.raw_starts.len == b.raw_starts.len); for i in 0..a.raw_starts.len { assert(a.raw_starts[i] == b.raw_starts[i]) }
    assert(a.widths.len == b.widths.len); for i in 0..a.widths.len { assert(a.widths[i] == b.widths[i]) }
    assert(a.modes.len == b.modes.len); for i in 0..a.modes.len { assert(a.modes[i] == b.modes[i]) }
    assert(a.recipes.len == b.recipes.len); for i in 0..a.recipes.len { assert(a.recipes[i] == b.recipes[i]) }
    assert(a.targets.len == b.targets.len); for i in 0..a.targets.len { assert(a.targets[i] == b.targets[i]) }
    assert(a.reloc_kinds.len == b.reloc_kinds.len); for i in 0..a.reloc_kinds.len { assert(a.reloc_kinds[i] == b.reloc_kinds[i]) }
    assert(a.import_ids.len == b.import_ids.len); for i in 0..a.import_ids.len { assert(a.import_ids[i] == b.import_ids[i]) }
    assert(a.order.len == b.order.len); for i in 0..a.order.len { assert(a.order[i] == b.order[i]) }
    assert(a.raw.len == b.raw.len); for i in 0..a.raw.len { assert(a.raw[i] == b.raw[i]) }
    assert(a.place_kinds.len == b.place_kinds.len); for i in 0..a.place_kinds.len { assert(a.place_kinds[i] == b.place_kinds[i]) }
    assert(a.place_offsets.len == b.place_offsets.len); for i in 0..a.place_offsets.len { assert(a.place_offsets[i] == b.place_offsets[i]) }
    assert(a.place_widths.len == b.place_widths.len); for i in 0..a.place_widths.len { assert(a.place_widths[i] == b.place_widths[i]) }
    assert(a.place_extensions.len == b.place_extensions.len); for i in 0..a.place_extensions.len { assert(a.place_extensions[i] == b.place_extensions[i]) }
    assert(a.place_escaped.len == b.place_escaped.len); for i in 0..a.place_escaped.len { assert(a.place_escaped[i] == b.place_escaped[i]) }
    assert(a.place_table.len == b.place_table.len); for i in 0..a.place_table.len { assert(a.place_table[i] == b.place_table[i]) }
    assert(a.place_probes == b.place_probes)
    assert(a.block_starts.len == b.block_starts.len); for i in 0..a.block_starts.len { assert(a.block_starts[i] == b.block_starts[i]) }
    assert(a.block_ends.len == b.block_ends.len); for i in 0..a.block_ends.len { assert(a.block_ends[i] == b.block_ends[i]) }
    assert(a.op_blocks.len == b.op_blocks.len); for i in 0..a.op_blocks.len { assert(a.op_blocks[i] == b.op_blocks[i]) }
    assert(a.edge_from.len == b.edge_from.len); for i in 0..a.edge_from.len { assert(a.edge_from[i] == b.edge_from[i]) }
    assert(a.edge_to.len == b.edge_to.len); for i in 0..a.edge_to.len { assert(a.edge_to[i] == b.edge_to[i]) }
    assert(a.edge_kinds.len == b.edge_kinds.len); for i in 0..a.edge_kinds.len { assert(a.edge_kinds[i] == b.edge_kinds[i]) }
    assert(a.edge_starts.len == b.edge_starts.len); for i in 0..a.edge_starts.len { assert(a.edge_starts[i] == b.edge_starts[i]) }
    assert(a.label_ids.len == b.label_ids.len); for i in 0..a.label_ids.len { assert(a.label_ids[i] == b.label_ids[i]) }
    assert(a.label_ops.len == b.label_ops.len); for i in 0..a.label_ops.len { assert(a.label_ops[i] == b.label_ops[i]) }
    assert(a.boundaries.len == b.boundaries.len); for i in 0..a.boundaries.len { assert(a.boundaries[i] == b.boundaries[i]) }
    assert(a.leaders.len == b.leaders.len); for i in 0..a.leaders.len { assert(a.leaders[i] == b.leaders[i]) }
    assert(a.visits == b.visits)
    assert(a.budget_exhausted == b.budget_exhausted)
}

@test fn mixed_frame_values_are_real_ssa_and_get_caller_save_registers() {
    code := mixed(); var f := model(&code); var w := ssa.new()
    assert(ssa.optimize_into(&mut w, &mut f))
    assert(ssa.status(&w) == 2 && f.verified && ssa.cells(&w) == 1 && ssa.registers(&w) == 1)
    assert(ssa.removed_loads(&w) == 3 && ssa.removed_stores(&w) == 0 && ssa.values(&w) > 0)
    assert(f.label_ids.len == 0 && f.source_words == code.words.len)
}
@test fn sparse_rollback_preserves_all_fields_at_late_budget_refusal() {
    code := mixed(); var f := model(&code); var expected := model(&code); var w := ssa.new()
    assert(ssa.optimize_into(&mut w, &mut f)); total := ssa.units(&w); f = model(&code)
    assert(!ssa.optimize_budget(&mut w, &mut f, total - 1) && ssa.status(&w) == -3)
    same(&f, &expected); assert(ssa.removed_loads(&w) == 0 && ssa.cells(&w) == 0)
    assert(ssa.optimize_into(&mut w, &mut f) && f.verified)
}
@test fn raw_external_observers_get_exact_unmodified_model() {
    var code := mixed(); outside := arm.label(&mut code); arm.branch(&mut code, outside, 0)
    var f := model(&code); var expected := model(&code); var w := ssa.new()
    // Make the observer reachable, before the source epilogue.
    code = arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    external := arm.label(&mut code); arm.imm(&mut code, 0, 7); arm.store(&mut code, 0, 0)
    arm.load(&mut code, 0); arm.load(&mut code, 0); arm.branch(&mut code, external, 0)
    f = model(&code); expected = model(&code)
    assert(!ssa.optimize_into(&mut w, &mut f) && ssa.status(&w) == -2); same(&f, &expected)
}
fn seven_cell_loop() -> arm.Code {
    var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 8)
    for g in 0..7 { arm.imm(&mut code, 0, i64(g)); arm.store(&mut code, g, 0) }
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 10); compare(&mut code, 0, 1); arm.branch(&mut code, done, 12)
    for g in 1..7 {
        arm.load(&mut code, g); arm.push(&mut code, 0); arm.load(&mut code, g - 1); arm.pop(&mut code, 1)
        add(&mut code, 0, 1, 0); arm.store(&mut code, g, 0)
    }
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done)
    arm.load(&mut code, 0); for g in 1..7 { arm.mov(&mut code, 1, 0); arm.load(&mut code, g); add(&mut code, 0, 1, 0) }
    arm.ret(&mut code); code
}
@test fn loop_block_parameters_allocate_more_than_four_caller_save_homes() {
    code := seven_cell_loop(); var f := model(&code); var w := ssa.new()
    assert(ssa.optimize_into(&mut w, &mut f)); assert(ssa.parameters(&w) > 0 && ssa.cells(&w) > 4 && ssa.registers(&w) > 4 && f.verified)
}
@test fn ssa_adds_caller_save_homes_after_existing_four_home_frame_promotion() {
    code := seven_cell_loop(); var f := model(&code); var old := frame.new(); var w := ssa.new()
    assert(frame.analyze_into(&mut old, &f) && frame.promoted(&old) == 4)
    frame.apply(&mut old, &mut f); assert(frame.status(&old) == 2 && verify.verify(&mut f))
    assert(ssa.optimize_into(&mut w, &mut f) && ssa.status(&w) == 2 && f.verified)
    assert(ssa.parameters(&w) > 0 && ssa.cells(&w) >= 3 && ssa.registers(&w) >= 3 && ssa.removed_loads(&w) > 0)
}
@test fn functions_without_frame_reads_pay_no_unused_ssa_or_verifier_work() {
    var code := arm.new(); arm.imm(&mut code, 0, 42); arm.ret(&mut code)
    var f := model(&code); expected := model(&code); var w := ssa.new()
    assert(!ssa.optimize_budget(&mut w, &mut f, 0) && ssa.status(&w) == 0 && ssa.units(&w) == 0)
    same(&f, &expected)
    code = arm.new(); slot := arm.prologue(&mut code); arm.frame(&mut code, slot, 2)
    arm.imm(&mut code, 0, 42); arm.store(&mut code, 0, 0); arm.ret(&mut code)
    f = model(&code); expected2 := model(&code)
    assert(!ssa.optimize_budget(&mut w, &mut f, f.kinds.len) && ssa.status(&w) == 0 && ssa.units(&w) == f.kinds.len)
    same(&f, &expected2)
}
fn compare(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn main() {}
