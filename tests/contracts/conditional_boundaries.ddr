struct Cond { value: bool }
struct Wrapped { inner: Cond }
struct Fields { Cond: bool }
struct TextCond { value: bool, text: string }

fn parenthesized() -> i32 { if (Cond { value: true }.value) { 1 } else { 2 } }
fn bare() -> i32 { if Cond { value: false }.value { 3 } else { 4 } }
fn truth(value: Cond) -> bool { value.value }
fn call_argument() -> i32 { if truth(Cond { value: true }) { 5 } else { 6 } }
fn indexed() -> i32 { if [Cond { value: true }.value, false][0] { 7 } else { 8 } }
fn nested_constructor() -> i32 {
    if Wrapped { inner: Cond { value: false } }.inner.value { 9 }
    else if (Cond { value: true }.value) { 10 }
    else { 11 }
}
fn nested_delimiters() -> i32 {
    if truth((Cond { value: [true, false][0] })) && ([false, true][1]) { 12 } else { 13 }
}
fn parameter_shadow(Cond: bool) -> i32 { if Cond { 14 } else { 15 } }
fn local_shadow() -> i32 { Cond := false; if Cond { 16 } else { 17 } }
fn scoped_shadow() -> i32 {
    var answer := 0
    { Cond := true; if Cond { answer = 18 } else { answer = 19 } }
    if Cond { value: true }.value { answer + 1 } else { 20 }
}
fn member_name() -> i32 { value := Fields { Cond: true }; if value.Cond { 21 } else { 22 } }
fn literal_braces() -> i32 {
    if TextCond { value: true, text: "}" }.value && ("{" == "{") && (`}` == `}`) { 23 } else { 24 }
}
fn nested_tail() -> i32 {
    if Cond { value: true }.value { if (Cond { value: false }.value) { 25 } else { 26 } }
    else { 27 }
}
fn non_tail() -> i32 {
    var answer := 0
    if (Cond { value: true }.value) { answer = 28 } else { answer = 29 }
    answer + 1
}
fn effect(calls: &mut i32, value: bool) -> bool { calls = calls + 1; value }
fn evaluation_once() -> i32 {
    var calls := 0
    if Cond { value: effect(&mut calls, true) }.value && effect(&mut calls, true) { calls } else { 99 }
}
fn main() {
    assert(parenthesized() == 1 && bare() == 4 && call_argument() == 5 && indexed() == 7)
    assert(nested_constructor() == 10 && nested_delimiters() == 12)
    assert(parameter_shadow(true) == 14 && parameter_shadow(false) == 15 && local_shadow() == 17)
    assert(scoped_shadow() == 19 && member_name() == 21 && literal_braces() == 23)
    assert(nested_tail() == 26 && non_tail() == 29 && evaluation_once() == 2)
    print(42)
}
