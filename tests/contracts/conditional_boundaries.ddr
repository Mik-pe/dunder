struct Cond { value: bool }
struct Wrapped { inner: Cond }
struct Fields { Cond: bool }
struct TextCond { value: bool, text: string }

fn parenthesized() -> i32 { if (Cond { value: true }.value) { 1 } else { 2 } }
fn bare() -> i32 { if Cond { value: false }.value { 3 } else { 4 } }
fn truth(value: Cond) -> bool { value.value }
fn call_argument() -> i32 { if truth(Cond { value: true }) { 5 } else { 6 } }
fn indexed() -> i32 { if [Cond { value: true }.value, false][0] { 7 } else { 8 } }
fn nested_constructor() -> i32 {
    if Wrapped { inner: Cond { value: false } }.inner.value { 9 }
    else if (Cond { value: true }.value) { 10 }
    else { 11 }
}
fn nested_delimiters() -> i32 {
    if truth((Cond { value: [true, false][0] })) && ([false, true][1]) { 12 } else { 13 }
}
fn parameter_shadow(Cond: bool) -> i32 { if Cond { 14 } else { 15 } }
fn local_shadow() -> i32 { Cond := false; if Cond { 16 } else { 17 } }
fn scoped_shadow() -> i32 {
    mut answer := 0
    { Cond := true; if Cond { answer = 18 } else { answer = 19 } }
    if Cond { value: true }.value { answer + 1 } else { 20 }
}
fn member_name() -> i32 { value := Fields { Cond: true }; if value.Cond { 21 } else { 22 } }
fn literal_braces() -> i32 {
    if TextCond { value: true, text: "}" }.value && ("{" == "{") && (`}` == `}`) { 23 } else { 24 }
}
fn nested_tail() -> i32 {
    if Cond { value: true }.value { if (Cond { value: false }.value) { 25 } else { 26 } }
    else { 27 }
}
fn non_tail() -> i32 {
    mut answer := 0
    if (Cond { value: true }.value) { answer = 28 } else { answer = 29 }
    answer + 1
}
fn effect(calls: &mut i32, value: bool) -> bool { calls = calls + 1; value }
fn evaluation_once() -> i32 {
    mut calls := 0
    if Cond { value: effect(&mut calls, true) }.value && effect(&mut calls, true) { calls } else { 99 }
}
fn nested_value_condition(flag: bool) -> i32 {
    if if flag { true } else if !flag { false } else { true } {
        40
    } else if (if flag { false } else { [true][0] }) {
        41
    } else {
        42
    }
}
fn leading_value_infix(flag: bool) -> i32 { if flag { 2 } else { 3 } + 40 }
fn leading_value_postfix(flag: bool) -> i32 { if flag { [0, 4] } else { [0, 5] }[1] }
fn separate_statements(flag: bool) -> i32 {
    mut n := 1
    if flag { n = 2 }
    (n + 40)
}
enum Switch { On, Off }
enum Switches { Pair(Switch, Switch) }
fn switch_pair(left: Switch, right: Switch) -> i32 {
    match Switches.Pair(left, right) {
        .Pair(.On, _) => 10,
        .Pair(_, .On) => 20,
        .Pair(.Off, .Off) => 30,
    }
}
fn match_in_condition(state: Switch) -> i32 {
    if match state { .On => true, .Off => false } { 1 } else { 2 }
}
fn nested_match_infix(state: Switch) -> i32 {
    match match state { .On => Switch.Off, .Off => Switch.On } {
        .On => 1, .Off => 2,
    } + 40
}
fn match_value_postfix(flag: bool) -> i32 {
    match if flag { Switch.On } else { Switch.Off } { .On => [3], .Off => [4] }[0]
}
fn separate_match_statements(state: Switch) -> i32 {
    mut n := 2
    match state { .On => { n = 3 }, .Off => { n = 4 } }
    (n + 40)
}
fn guarded_pair(pair: Switches) -> i32 {
    match pair {
        .Pair(.On, right) if match right { .On => true, .Off => false } => 1,
        .Pair(left, right) if if left == .Off { right == .On } else { false } => 2,
        _ => 3,
    }
}
fn loop_with_guard(state: Switch) -> i32 {
    mut total := 0
    for i in 0..5 {
        match state {
            .On if i == 0 => { continue },
            _ if i == 3 => { break },
            _ => { total += i + 1 },
        }
    }
    total
}
fn main() {
    assert(parenthesized() == 1 && bare() == 4 && call_argument() == 5 && indexed() == 7)
    assert(nested_constructor() == 10 && nested_delimiters() == 12)
    assert(parameter_shadow(true) == 14 && parameter_shadow(false) == 15 && local_shadow() == 17)
    assert(scoped_shadow() == 19 && member_name() == 21 && literal_braces() == 23)
    assert(nested_tail() == 26 && non_tail() == 29 && evaluation_once() == 2)
    assert(nested_value_condition(true) == 40 && nested_value_condition(false) == 41)
    assert(leading_value_infix(true) == 42 && leading_value_infix(false) == 43)
    assert(leading_value_postfix(true) == 4 && leading_value_postfix(false) == 5)
    assert(separate_statements(true) == 42 && separate_statements(false) == 41)
    assert(match_in_condition(.On) == 1 && match_in_condition(.Off) == 2)
    assert(nested_match_infix(.On) == 42 && nested_match_infix(.Off) == 41)
    assert(match_value_postfix(true) == 3 && match_value_postfix(false) == 4)
    assert(separate_match_statements(.On) == 43 && separate_match_statements(.Off) == 44)
    assert(switch_pair(.On, .On) == 10 && switch_pair(.On, .Off) == 10)
    assert(switch_pair(.Off, .On) == 20 && switch_pair(.Off, .Off) == 30)
    assert(guarded_pair(.Pair(.On, .On)) == 1 && guarded_pair(.Pair(.Off, .On)) == 2)
    assert(guarded_pair(.Pair(.On, .Off)) == 3 && guarded_pair(.Pair(.Off, .Off)) == 3)
    assert(loop_with_guard(.On) == 5 && loop_with_guard(.Off) == 6)
    print(42)
}
