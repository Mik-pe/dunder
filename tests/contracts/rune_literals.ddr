fn main() {
    values: []rune = [`\0`, `\u{7f}`, `\u{80}`, `\u{7ff}`, `\u{800}`, `\u{d7ff}`, `\u{e000}`, `\u{ffff}`, `\u{10000}`, `\u{10ffff}`, `🌍`, `é`, `\u{301}`, `\n`, `\t`, `\\`, `\``, `\'`, `\"`]
    expected := [0, 127, 128, 2047, 2048, 55295, 57344, 65535, 65536, 1114111, 127757, 233, 769, 10, 9, 92, 96, 39, 34]
    assert(values.len == expected.len)
    for i in 0..values.len { assert(i32(values[i]) == expected[i]); assert(values[i] == rune(expected[i])) }
    assert(`\x41` == `A` && `\u0041` == `A` && `\u{41}` == `A`)
    assert(`🌍` == `\u{1f30d}` && `é` != `\u{301}`)
    var sum := 0
    for i in 0..10000 { if `å` == `\u00e5` { sum = sum + 1 } }
    assert(sum == 10000)
    print(42)
}
