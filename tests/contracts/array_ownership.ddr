fn last(values: []i64) -> i64 { values[values.len - 1] }

fn main() {
    var source: []i64 = []
    source.reserve(1024)
    for i in 0..1024 { source.push(i64(i)) }
    var current: []i64 = []
    for i in 0..200000 {
        var copy := source
        copy[0] = i64(i)
        assert(source[0] == 0 && copy[1023] == 1023)
        current = copy
        current = current
        assert(current[0] == i64(i))
        assert(last(current) == 1023)
    }
    assert(source[0] == 0 && current[0] == 199999)
    print(42)
}
