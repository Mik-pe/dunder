capability unsafe

enum Sign { Minus = -10, Plus = 5 }
struct Box { value: i32, text: string }
@c_layout struct Pair { left: i32, right: i32 }

fn replace(value: &mut i32, next: i32) { value = next }
fn read(value: &i32) -> i32 { value }
fn replace_box(value: &mut Box) { value = Box { value: 42, text: "changed" } }
fn replace_pair(value: &mut Pair) { value.left = 20; value.right = 22 }
fn replace_fixed(values: &mut [i32; 2]) { values[0] = 20; values[1] = 22 }

fn frame_boundary() {
    // Keep independent bindings alive across the near/far frame boundary.
    a00 := 0; a01 := 1; a02 := 2; a03 := 3
    a04 := 4; a05 := 5; a06 := 6; a07 := 7
    a08 := 8; a09 := 9; a10 := 10; a11 := 11
    a12 := 12; a13 := 13; a14 := 14; a15 := 15
    a16 := 16; a17 := 17; a18 := 18; a19 := 19
    a20 := 20; a21 := 21; a22 := 22; a23 := 23
    a24 := 24; a25 := 25; a26 := 26; a27 := 27
    a28 := 28; a29 := 29; a30 := 30; var a31 := 31
    var a32 := 32; a33 := 33
    replace(&mut a31, a32)
    replace(&mut a32, a33)
    assert(a31 == 32 && a32 == 33 && a00 == 0)
}

fn main() {
    var signed: i32 = -1
    var byte: u8 = 255
    var short: u16 = 65535
    var word: u32 = 4294967295
    var sign := Sign.Minus
    var single: f32 = -0.0
    var wide: f64 = 1.25
    var truth := false
    unsafe {
        // Narrow stores leave the rest of a frame cell untouched. A local
        // read must use the declared width and extend its sign correctly.
        store_i32(addr(&mut signed), 42)
        store_u8(addr(&mut byte), 7)
        store_u16(addr(&mut short), 9)
        store_u32(addr(&mut word), 11)
        store_i32(addr(&mut sign), 5)
        store_f32(addr(&mut single), 0.5)
        store_f64(addr(&mut wide), -2.25)
        store_u8(addr(&mut truth), 1)
    }
    assert(signed == 42 && byte == 7 && short == 9 && word == 11)
    assert(sign == .Plus && single == 0.5 && wide == -2.25 && truth)
    replace((&mut signed), -2147483648)
    assert(read((&signed)) == -2147483648)
    ((signed)) = 17
    { var signed := 3; replace(&mut signed, 4); assert(signed == 4) }
    assert(signed == 17)
    var box := Box { value: 1, text: "before" }
    replace_box(&mut box)
    assert(box.value == 42 && box.text == "changed")
    var values := [1, 2]
    values[1] = signed
    assert(values[1] == 17)
    var pair := Pair { left: 0, right: 0 }
    replace_pair(&mut pair)
    assert(pair.left + pair.right == 42)
    var fixed: [i32; 2] = [0; 2]
    replace_fixed(&mut fixed)
    assert(fixed[0] + fixed[1] == 42)
    frame_boundary()
    print(42)
}
