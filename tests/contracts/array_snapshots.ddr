fn main() {
    var source: []i64 = []
    for i in 0..1024 { source.push(i64(i)) }
    for round in 0..100000 {
        var checksum: i64 = 0
        for value in source {
            source[0] = 99
            checksum = checksum + value
            if value == 5 { break }
        }
        assert(checksum == 15)
        source[0] = 0
    }
    print(42)
}
