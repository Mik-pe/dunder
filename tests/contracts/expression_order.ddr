fn record(trace: &mut i32, value: i32) -> i32 {
    trace = trace * 10 + value
    value
}
fn pick(values: &mut []i32, trace: &mut i32) -> i32 {
    trace = trace * 10 + 4
    values[0] = 9
    0
}
fn change(value: &mut i32) -> i32 { value = 42; 3 }
fn main() {
    var trace := 0
    a := 7
    b := 3
    assert(record(&mut trace, 1) + b * record(&mut trace, 2) == 7)
    assert(trace == 12)
    assert(a - b - 1 == 3 && a - (b - 1) == 5)
    assert(a + b * 2 == 13 && (a + b) * 2 == 20)
    assert(a + b.wrapping_mul(2) == 13)
    assert(a / b == 2 && a % b == 1)
    call := record
    assert(call(&mut trace, 3) * b + a == 16 && trace == 123)
    var values: []i32 = [1, 2]
    assert(a + values[pick(&mut values, &mut trace)] == 16)
    assert(trace == 1234)
    var original := 7
    assert(original + change(&mut original) == 10 && original == 42)
    assert(true || record(&mut trace, 5) == 5)
    assert(!(false && record(&mut trace, 6) == 6))
    assert(trace == 1234)
    small: u8 = 2
    large: u64 = 18446744073709551615
    assert(small + 3 == 5 && large / 3 == 6148914691236517205)
    single: f32 = 1.5
    wide: f64 = 2.25
    assert(single + 0.5 == 2.0 && wide * 2.0 == 4.5)
    assert(wide + 1 == 3.25 && single / 2 == 0.75)
    print(42)
}
