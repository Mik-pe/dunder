fn early(n: i32) -> i32 {
    mut allocation: []i64 = []
    allocation.reserve(65536)
    if n % 2 == 0 { return n }
    mut i := 0
    while i < 4 {
        mut temporary: []i64 = []
        temporary.reserve(65536)
        i = i + 1
        if i < 3 { continue }
        break
    }
    n
}

fn main() {
    mut total: i64 = 0
    for i in 0..4096 {
        mut empty: []i64 = []
        empty.reserve(65536)
        assert(empty.len == 0 && empty.cap() >= 65536)
        total = total + i64(early(i))
        if i % 2 == 0 { continue }
        mut tail: []i64 = []
        tail.reserve(65536)
    }
    assert(total == 8386560)
    print(42)
}
