fn early(n:i32)->i32{
 var allocation:[]i64=[]
 allocation.reserve(65536)
 if n%2==0{return n}
 var i:=0
 while i<4{
  var temporary:[]i64=[]
  temporary.reserve(65536)
  i=i+1
  if i<3{continue}
  break
 }
 n
}
fn main(){
 var total:i64=0
 for i in 0..4096{
  var empty:[]i64=[]
  empty.reserve(65536)
  assert(empty.len==0 && empty.cap()>=65536)
  total=total+i64(early(i))
  if i%2==0{continue}
  var tail:[]i64=[]
  tail.reserve(65536)
 }
 assert(total==8386560)
 print(42)
}
