struct Message { text: string, code: i64 }
struct Packet { message: Message, values: []i64 }
struct Envelope { packet: Packet, names: []string }
enum Payload { Empty, Values([]i64), Packet(Packet) }

fn text(seed: i32) -> string { "owned-" + seed.str() }
fn message(seed: i32) -> Message { Message { text: text(seed), code: i64(seed) } }
fn values(seed: i32) -> []i64 { [i64(seed), i64(seed + 1), i64(seed + 2)] }
fn packet(seed: i32) -> Packet { Packet { message: message(seed), values: values(seed) } }
fn relay(make: fn(i32) -> []i64, seed: i32) -> []i64 { return (make(seed)) }
fn join(first: string, second: string) -> string { first + ":" + second }
fn capacity(values: []rune) -> i32 { values.cap() }
fn rune_values() -> []rune { ("😀😀😀😀😀😀😀😀😀".runes()) }
fn replace(p: &mut Packet, seed: i32) -> []i64 {
    p = packet(seed)
    values(seed + 10)
}
fn return_early(seed: i32) -> []i64 {
    for i in 0..3 {
        unused := text(seed)
        if i == 0 { continue }
        return values(seed)
    }
    values(seed + 99)
}

fn main() {
    // A materialized rune array reserves byte length. A value copy exposes
    // max(8, element_count), including when its backing allocation is reused.
    assert(rune_values().cap() == 9)
    assert(capacity("😀😀😀😀😀😀😀😀😀".runes()) == 9)
    empty := "".runes()
    assert(empty.cap() == 0)
    var runes: []rune = []
    runes = "😀😀😀😀😀😀😀😀😀".runes()
    assert(runes.cap() == 9 && runes.len == 9)
    for i in 0..10000 {
        var data := (relay(values, i))
        original := data
        data[0] = -1
        data = data
        assert(original[0] == i64(i) && data[0] == -1)
        assert(data[2] == i64(i + 2) && data.cap() == 8)

        var p := packet(i)
        copied := p
        // Re-resolving the assignment destination must preserve the right
        // expression's own temporary origin, rather than a replayed place.
        p.values = replace(&mut p, i + 1)
        assert(p.values[0] == i64(i + 11))
        assert(copied.values[0] == i64(i))
        assert(copied.message.text == "owned-" + i.str())

        var envelope := Envelope { packet: packet(i), names: [text(i), text(i + 1)] }
        saved := envelope
        envelope.packet.values[1] = -2
        envelope.names.clear()
        assert(saved.packet.values[1] == i64(i + 1))
        assert(saved.names[0] == "owned-" + i.str())

        // Projections are borrowed values even when their receiver is fresh.
        projected := packet(i).values
        projected_text := message(i).text
        assert(projected[2] == i64(i + 2))
        assert(projected_text == "owned-" + i.str())
        assert(join(text(i), projected_text) == projected_text + ":" + projected_text)

        var repeated := [text(i); 3]
        repeated[0] = "changed" + "!"
        assert(repeated[1] == projected_text && repeated[2] == projected_text)
        var payload := Payload.Values(values(i))
        snapshot := payload
        payload = .Empty
        match snapshot {
            .Values(items) => { assert(items[2] == i64(i + 2)) },
            _ => { assert(false) },
        }
        match Payload.Packet(packet(i)) {
            .Packet(item) => { assert(item.values[0] == i64(i)) },
            _ => { assert(false) },
        }

        var sum: i64 = 0
        for value in return_early(i) {
            sum = sum + value
            if value == i64(i + 1) { break }
        }
        assert(sum == i64(i) * 2 + 1)
    }
    print(42)
}
