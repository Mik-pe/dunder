struct Source { text: string }
struct Provider { get: fn(&mut i32) -> string }

fn make(calls: &mut i32) -> string {
    calls = calls + 1
    "A\0" + "åβ🌍"
}
fn same(values: []rune) -> []rune { values }
fn first_three(text: string) -> i32 {
    var sum := 0
    var count := 0
    for scalar in text.runes() {
        sum = sum + i32(scalar)
        count = count + 1
        if count == 3 { return sum }
    }
    sum
}
fn check() {
    var calls := 0
    provider := Provider { get: make }
    var sum := 0
    for scalar in provider.get(&mut calls).runes() { sum = sum + i32(scalar) }
    assert(calls == 1 && sum == 128997)

    var source := Source { text: make(&mut calls) }
    var bytes: []i32 = []
    for byte in source.text.bytes() {
        source.text = "replacement" + "!"
        bytes.push(byte)
    }
    assert(bytes.len == 10)
    assert(bytes[0] == 65 && bytes[1] == 0 && bytes[2] == 195 && bytes[9] == 141)
    source.text = make(&mut calls)
    var scalars: []rune = []
    for scalar in source.text.runes() {
        source.text = "replacement" + "!"
        scalars.push(scalar)
    }
    assert(scalars.len == 5)
    assert(scalars[0] == `A` && scalars[1] == `\0` && scalars[4] == `🌍`)

    // Stored conversions and nested call arguments are independent arrays.
    var stored := make(&mut calls).runes()
    stored[0] = `Z`
    var checked := 0
    for scalar in same(stored) { checked = checked + i32(scalar) }
    assert(checked == 129022 && stored[0] == `Z`)
    for scalar in (source.text.runes()) { assert(scalar != `\0`) }

    var empty_count := 0
    for byte in "".bytes() { empty_count = empty_count + byte + 1 }
    for scalar in "".runes() { empty_count = empty_count + i32(scalar) + 1 }
    assert(empty_count == 0)
    var nested := 0
    for scalar in "åβ🌍".runes() {
        for byte in "\0x".bytes() {
            if byte == 0 { continue }
            nested = nested + i32(scalar)
        }
    }
    assert(nested == 128932)
    var prefix := 0
    for scalar in "åβ🌍".runes() {
        prefix = prefix + i32(scalar)
        if scalar == `β` { break }
    }
    assert(prefix == 1175)
    assert(first_three(make(&mut calls)) == 294)

    // Every UTF-8 width and its scalar boundary is decoded without a NUL sentinel.
    boundaries := "\0\u{7f}\u{80}\u{7ff}\u{800}\u{d7ff}\u{e000}\u{ffff}\u{10000}\u{10ffff}"
    expected: []rune = [`\0`, `\u{7f}`, `\u{80}`, `\u{7ff}`, `\u{800}`, `\u{d7ff}`, `\u{e000}`, `\u{ffff}`, `\u{10000}`, `\u{10ffff}`]
    var position := 0
    for scalar in boundaries.runes() { assert(scalar == expected[position]); position = position + 1 }
    assert(position == expected.len)
}
fn main() { for i in 0..1000 { check() }; print(42) }
