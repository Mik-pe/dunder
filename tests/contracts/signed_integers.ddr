capability stdio, unsafe
import std.parse as parse

const lowest: i16 = -32768
const highest: i16 = 32760 + 7

fn samples() -> Result<[]i16, string> {
    mut values: []i16 = [lowest, 0, highest]
    values.push(-19)
    .Ok(move values)
}

fn calculate(x: i16, y: i16) -> i16 { (x + y) * -2 / y }

fn main() {
    mut values := samples().unwrap()
    unsafe {
        assert(size_of(i16) == 2 && align_of(i16) == 2)
        first := addr(&mut values[0])
        last := addr(&mut values[2])
        assert(usize(last) - usize(first) == 4)
        assert(load_u16(first) == 32768 && load_i16(first) == lowest)
        store_i16(last, -32767)
    }
    assert(i32(values[0]) == -32768 && i64(values[2]) == -32767)
    assert(values.pop() == -19 && values.remove(0) == lowest)
    assert(values[1].abs() == 32767 && values[1].str() == "-32767")
    assert(f"{highest:04x}" == "7fff")
    assert(calculate(-17, 2) == 15)
    assert(highest.wrapping_add(1) == lowest && lowest.wrapping_sub(1) == highest)
    assert(lowest.shr(15) == 1 && lowest.bit_not() == highest)
    for i in 1..3 { assert(i16(-1).shr(i) == i16(65535.shr(i))) }
    assert(i16(f64(values[1]) + 0.5) == -32766)
    assert(parse.value<i16>("-32768").unwrap() == lowest && parse.value<i16>("32768").is_err())
    mut positions := Map<i16, i32>::new()
    positions.put(lowest, 3)
    assert(positions.get_or(lowest, -1) == 3)
    print(42)
}
