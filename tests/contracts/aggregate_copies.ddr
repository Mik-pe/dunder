struct Table { keys: []string, values: []i64, count: i32 }
enum Value { None, Items([]i32), Table(Table) }
enum Kind { Unknown = -1, File = 4, Directory, Link = 9 }

fn make() -> Table { Table { keys: ["a", "b"], values: [1, 2], count: 2 } }
fn invoke(f: fn() -> Table) -> Table { f() }
fn update(t: &mut Table) {
    t.keys[0] = "changed"
    t.values.push(3)
    t.count = 3
}

fn main() {
    var table := invoke(make)
    snapshot := table
    update(&mut table)
    assert(snapshot.keys[0] == "a" && snapshot.values.len == 2)
    assert(table.count == 3 && table.values.len == 3)

    var value := Value.Table(table)
    copy := value
    value = .None
    match copy {
        .Table(t) => { assert(t.keys[0] == "changed" && t.values[2] == 3) },
        _ => { assert(false) },
    }
    var nums: []i32 = [1, 2]
    items := Value.Items(nums)
    nums[0] = 9
    match items {
        .Items(values) => { assert(values[0] == 1) },
        _ => { assert(false) },
    }

    // Accept every declared tag, including noncontiguous and implicit values.
    var tags: []Kind = []
    for n in [-1, 4, 5, 9] { tags.push(Kind(n)) }
    assert(tags[0] == .Unknown && tags[1] == .File)
    assert(tags[2] == .Directory && tags[3] == .Link)
    assert(i64(tags[0]) == -1 && i32(tags[2]) == 5)
    print(42)
}
