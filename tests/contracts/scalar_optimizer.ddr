// Functions here are ordinary consumer code; none has an optimizer-specific name.
fn reduce(values: &[]i64) -> i64 {
    var total: i64 = 0
    var i := 0
    while i < values.len { total = total + values[i]; i = i + 1 }
    total
}
fn control(limit: i32) -> i32 {
    var i := 0
    var total := 0
    while i < limit {
        i = i + 1
        if i % 2 == 0 { continue }
        if i > 11 { break }
        { value := i + 2; total = total + value }
    }
    if limit < 0 { return -7 }
    total
}
fn earlier(limit: i32) -> i32 {
    var i := 0
    var total := 0
    while i < limit {
        if i == 7 { return total }
        total = total + i
        i = i + 1
    }
    total
}
fn shadow(value: i32) -> i32 {
    var total := value
    { value := value + 2; total = total + value }
    total + value
}
fn many(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8
}
fn guarded(value: i64) -> bool { ten: i64 = 10; value == 0 || ten / value > 0 }
fn safe_negative(value: i64) -> bool { ten: i64 = 10; value != 0 && ten / value > 0 }
fn minimum() -> i32 { -2147483648 }
fn main() {
    empty: []i64 = []
    var values: []i64 = [-9, 2, 17, -4]
    saved := values
    values[0] = 100
    assert(reduce(&empty) == 0)
    assert(reduce(&saved) == 6 && reduce(&values) == 115)
    assert(control(-1) == -7 && control(0) == 0)
    assert(control(6) == 15 && control(100) == 48)
    assert(earlier(-1) == 0 && earlier(0) == 0 && earlier(20) == 21)
    assert(shadow(-2) == -4 && shadow(5) == 17)
    assert(many(1, 2, 3, 4, 5, 6, 7, 8) == 204)
    assert(many(-1, 2, -3, 4, -5, 6, -7, 8) == 36)
    assert(guarded(0) && !safe_negative(0))
    assert(guarded(2) && !guarded(-2))
    assert(minimum() == -2147483648)
    print(42)
}
