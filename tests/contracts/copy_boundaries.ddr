import std.bytes as bytes

fn check_text(text: string, length: i32, start: i32) {
    assert(text.len == length)
    for i in 0..length { assert(text[i] == 65 + (start + i) % 26) }
}

fn main() {
    var source := ""
    for i in 0..96 { source = source + rune(65 + i % 26).str() }
    // Both addresses and the tail cross every word alignment. Concatenation
    // must advance the first copy's destination by its exact byte count.
    for start in 0..8 {
        for length in 0..66 {
            text := source[start..start + length]
            check_text(text, length, start)
            joined := "!" + text + "?"
            assert(joined.len == length + 2 && joined[0] == 33)
            assert(joined[length + 1] == 63)
            check_text(joined[1..length + 1], length, start)
        }
    }
    for length in 0..66 {
        var values: []u8 = []
        for i in 0..length { values.push(u8(65 + i % 26)) }
        snapshot := values
        values.reserve(256)
        values.push(255)
        for i in 0..length {
            assert(snapshot[i] == u8(65 + i % 26))
            assert(values[i] == snapshot[i])
        }
        assert(snapshot.len == length && values.len == length + 1)
        decoded := bytes.decode(&snapshot)
        assert(decoded.ok)
        check_text(decoded.value, length, 0)

        var names: []string = []
        for i in 0..length { names.push("owned-" + i.str()) }
        saved := names
        names.reserve(256)
        names.clear()
        // Copying the backing words must retain each owned string handle.
        // Clearing and reusing the original must leave the snapshot alive.
        for i in 0..length { names.push("new-" + i.str()) }
        for i in 0..length { assert(saved[i] == "owned-" + i.str()) }
    }
    // UTF-8 boundaries still govern slicing when a multibyte scalar straddles
    // a copied word; the byte-copy implementation does not interpret scalars.
    text := "abcdefg" + "🌍åβ" + "hijklmnop"
    assert(text[7..15] == "🌍åβ")
    assert(text[11..15] == "åβ")
    print(42)
}
