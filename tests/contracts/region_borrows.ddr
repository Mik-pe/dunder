capability unsafe

struct Node { value:i64 }
@c_layout struct Point { x:u16, y:u16 }
@c_layout struct Packed { id:u8, point:Point, color:[u8;2] }

fn bump(value: &mut i64) { value = value + 1 }
fn relay(value: &mut i64) { bump(&mut value) }
fn replace_point(point: &mut Point) { point = Point { x:7, y:11 } }
fn read_node(node: &Node) -> i64 { node.value }
fn replace(node: &mut Node) -> i64 {
    node = Node { value: node.value + 3 }
    bump(&mut node.value)
    node.value
}
fn relay_node(node: &mut Node) -> i64 { replace(&mut node) }
fn read(values: &[]i64) -> i64 { values[0] }
fn copy(values: &[]i64) -> []i64 { values }
fn address(value: &i64) -> ptr { unsafe { return addr(&value) } }

fn early() -> i32 {
    region frame(16777216) {
        var flags: []bool = frame.alloc(1)
        assert(!flags[0])
        flags[0] = true
        return flags.len
    }
}

fn exercise_cleanup() {
    for i in 0..64 {
        region frame(16777216) {
            var flags: []bool = frame.alloc(1)
            assert(!flags[0])
            flags[0] = true
            if i % 2 == 0 { continue }
            assert(early() == 1)
            if i == 63 { break }
        }
    }
}

fn main() {
    var outside: []i64 = []
    var ordinary: i64 = 7
    region owner(32) {
        var data: []i64 = owner.alloc(2)
        data[0] = 8
        relay(&mut data[0])
        reader := read
        assert(reader(&data) == 9)
        outside = copy(&data)
        region owner(8) {
            var data: []Node = owner.alloc(1)
            relay(&mut data[0].value)
            assert(read_node(&data[0]) == 1)
            assert(relay_node(&mut data[0]) == 5)
            assert(data[0].value == 5)
            {
                var data: i64 = 4
                p := address(&data)
                unsafe { assert(load_i64(p) == 4) }
            }
        }
        assert(data[0] == 9)
        // The borrowed index belongs to the arena, the addressed value does not.
        unsafe {
            var ordinary_values: [i64; 1] = [7]
            p := addr(&ordinary_values[i32(data[1])])
            ordinary = load_i64(p)
        }
    }
    outside.push(ordinary)
    assert(outside[0] == 9 && outside[2] == 7)
    region packed(16) {
        var entries: []Packed = packed.alloc(2)
        entries[1] = Packed { id:5, point:Point { x:1, y:2 }, color:[3,4] }
        replace_point(&mut entries[1].point)
        assert(entries[0].color[0] == 0 && entries[1].point.y == 11)
        value := entries[1]
        entries[1].color[0] = 99
        assert(value.id == 5 && value.color[0] == 3)
    }
    exercise_cleanup()
    print(42)
}

// A same-signature function that is never taken as a value cannot be the
// destination of the indirect call to reader in main.
fn unrelated(values: &[]i64) -> i64 {
    unsafe { p := addr(&values[0]); return load_i64(p) }
}
