struct Metrics { count: i32, samples: []i32 }
struct Job { metrics: Metrics }
struct Actions { modify: fn(&mut i32, i32) }

fn replace(job: &mut Job) -> i32 {
    job = Job { metrics: Metrics { count: 40, samples: [3, 4] } }
    2
}
fn update(samples: &mut []i32) -> i32 { samples = [9, 7]; 1 }
fn accumulate(value: &mut i32, amount: i32) { value = value + amount }
fn read(value: &i32, amount: i32) -> i32 { value + amount }
fn pair(left: &i32, right: &i32) -> i32 { left + right }
fn relay(value: &mut i32) { accumulate(&mut value, read(&value, 0)) }
fn run_contract() {
    var job := Job { metrics: Metrics { count: 0, samples: [1] } }
    assert(read(&(job.metrics).count, replace(&mut job)) == 42)
    f := accumulate
    f((&mut job.metrics.count), replace(&mut job))
    assert(job.metrics.count == 42)
    actions := Actions { modify: accumulate }
    actions.modify(&mut job.metrics.count, 0)
    relay(&mut job.metrics.count)
    assert(pair(&job.metrics.count, &job.metrics.count) == 168)
    var other := Job { metrics: Metrics { count: 5, samples: [3] } }
    f(&mut job.metrics.samples[0], replace(&mut other))
    assert(job.metrics.samples[0] == 5)
    job.metrics.samples.push(replace(&mut job))
    assert(job.metrics.samples[2] == 2)
    assert(job.metrics.samples[update(&mut job.metrics.samples)] == 7)
    job.metrics.count = replace(&mut job)
    assert(job.metrics.count == 2)
    // Copying a borrowed scalar creates an independent value in this scope.
    { var count := 1; relay(&mut count); assert(count == 2) }
}
fn main() { run_contract(); print(42) }
@test fn place_and_reborrow_behavior() { run_contract() }
