        assert(f.raw.len == 0 && f.order.len == 23)
        for op in f.order { assert(f.kinds[op] == 19 && f.imm[op] == 123 && f.aux[op] == ty) }
        mut object := lower.new_object()
        assert(lower.lower_into(&mut object, &f) && lower.object_word_count(&object) == reference.words.len)
        for at in 0..reference.words.len { assert(lower.object_word(&object, at) == reference.words[at]) }
        f.flags[0] = 2
        assert(!verify.verify(&mut f))
    }
}

import ..selfhost.backend.backend_row as backend

@test fn source_edges_keep_their_action_and_location_until_object_lowering() {
    mut code := arm.new()
    destination := arm.label(&mut code)
    arm.begin_mir(&mut code, true)
    for kind in 0..21 { arm.branch(&mut code, destination, kind) }
    actions: []backend.Edge = [.Jump, .WhenFalse, .WhenTrue, .NextVariant, .RangeDone,
        .Return, .Break, .Continue, .Assert, .Bounds, .Defer, .Resume]
    for i in 0..actions.len { arm.source_edge(&mut code, destination, actions[i], 700 + i) }
    arm.mark(&mut code, destination); arm.end_mir(&mut code)
    assert(code.words.len == 21 + actions.len)
    none: []i32 = []; mut f := lifted(&code, &none)
    assert(f.raw.len == 0)
    mut obj := lower.new_object(); assert(lower.lower_into(&mut obj, &f))
    for i in 0..f.order.len {
        assert(f.modes[i] == 1 && lower.object_reloc_target(&obj, i) == destination)
        if i < 21 { assert(lower.object_reloc_kind(&obj, i) == i) }
        else {
            action := actions[i - 21]; kind := backend.edge_reloc(action)
            assert(lower.object_reloc_kind(&obj, i) == kind)
            assert(f.variant[i] == backend.control(action, kind, 700 + i - 21))
        }
    }
    f.reloc_kinds[22] = 19
    assert(!verify.verify(&mut f))
    code.at.clear(); code.target.clear(); code.kinds.clear()
    assert(!lift.lift(&mut f, &code, 0, 0, 0, &none, 0))
}

@test fn typed_owner_slots_survive_source_lowering_and_retain_frame_effects() {
    for slot in [0, 31, 32, 511, 65534] {
        mut code := arm.new()
        arm.begin_mir(&mut code, true)
        arm.owner_store(&mut code, .Install, 4, slot, 57)
        arm.owner_store(&mut code, .Transfer, 4, slot, 81)
        arm.owner_store(&mut code, .Vacate, 4, slot, 83)
        arm.owner_store(&mut code, .Initialize, 4, slot, 92)
        arm.end_mir(&mut code)
        mut sites: []i32 = []; mut f := lifted(&code, &sites)
        for i in 0..4 {
            assert(f.kinds[i] == 8 && f.opcodes[i] == 20 + i && f.modes[i] == 1 && f.recipes[i] == 2)
            assert(f.imm[i] == i64(-(slot + 1) * 8) && f.variant[i].shr(32) == 4)
            assert(f.aux[i] == 8 && f.effects[i] == 5 && mir.boundary(&f, 2*i+1) == -1)
        }
        assert(f.variant[0].bit_and(4294967295) == 57 && f.a[0] == 0)
        assert(f.variant[1].bit_and(4294967295) == 81 && f.a[1] == -1)
        mut obj := lower.new_object()
        assert(lower.lower_into(&mut obj, &f))
        f.opcodes[0] = 21
        assert(!verify.verify(&mut f))
        code.labels.push(1)
        assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    }
}

@test fn integer_rows_preserve_width_checked_flags_and_shift_operands() {
    for wide in [false, true] {
        mut code := arm.new(); mut reference := arm.new()
        arm.begin_mir(&mut code, true)
        for opcode in [1, 2, 3, 8, 9, 10, 14, 15] {
            arm.integer_binary(&mut code, opcode, wide, false, 3, 4, 5, -1)
            arm.integer_binary(&mut reference, opcode, wide, false, 3, 4, 5, -1)
        }
        for amount in [7, 4096, 16773120] {
            arm.integer_binary(&mut code, 2, wide, true, 6, 7, -1, i64(amount))
            arm.integer_binary(&mut reference, 2, wide, true, 6, 7, -1, i64(amount))
        }
        arm.bitfield(&mut code, false, wide, 8, 9, 25, 21)
        arm.bitfield(&mut reference, false, wide, 8, 9, 25, 21)
        arm.sign_extend_i32(&mut code, 10, 10); arm.sign_extend_i32(&mut reference, 10, 10)
        sites: []i32 = []; mut f := lifted(&code, &sites); mut output := lower.new_object()
        assert(f.raw.len == 0 && f.kinds.len == 13 && f.flags[8] == 2 && f.imm[10] == 16773120)
        assert(f.kinds[11] == 3 && f.opcodes[11] == 2 && f.aux[11] == 21 * 64 + 25)
        assert(lower.lower_into(&mut output, &f) && lower.object_word_count(&output) == reference.words.len)
        for at in 0..reference.words.len { assert(lower.object_word(&output, at) == reference.words[at]) }
    }
}

@test fn numeric_casts_keep_bounds_and_source_types_until_lowering() {
    for from in [1, 2, 6, 7, 8, 9, 10, 11, 12] {
        for to in [1, 2, 6, 7, 8, 9, 10, 11, 12] {
            if from == to || (!floats.has(from) && !floats.has(to)) { continue }
            mut code := arm.new(); mut reference := arm.new()
            trap := arm.label(&mut code); target := arm.label(&mut reference)
            arm.begin_mir(&mut code, true); floats.cast(&mut code, from, to, trap, 17); arm.end_mir(&mut code)
            floats.cast(&mut reference, from, to, target, 17)
            arm.mark(&mut code, trap)
            arm.mark(&mut reference, target); _ := arm.relax_branches(&mut reference)
            sites: []i32 = []; mut f := lifted(&code, &sites); assert(f.raw.len == 0)
            mut phases := 0
            for op in f.order { if f.kinds[op] == 19 { assert(f.imm[op] == 17 && f.aux[op] == from); phases = phases + 1 } }
            if floats.has(to) { assert(phases == 1) } else { assert(phases == 3) }
            mut object := lower.new_object(); assert(lower.lower_into(&mut object, &f))
            assert(lower.object_word_count(&object) == reference.words.len && lower.object_reloc_count(&object) == reference.at.len)
            for at in 0..reference.words.len { assert(lower.object_word(&object, at) == reference.words[at]) }
            for at in 0..reference.at.len {
                assert(lower.object_reloc_at(&object, at) == reference.at[at] && lower.object_reloc_kind(&object, at) == reference.kinds[at])
            }
        }
    }
}
@test fn task_operations_keep_typed_results_worker_and_await_cardinality() {
    mut code := arm.new(); runtime := arm.label(&mut code); mut direct := arm.new()
    other := arm.label(&mut direct); arm.begin_mir(&mut code, true)
    actions: []backend.Task = [.ScopeOpen, .ScopeClose, .Spawn, .Await, .AwaitOnce]
    for i in 0..actions.len {
        mut worker := 0; if i == 2 { worker = 2147483647 }
        mut ty := 2147483647; if i == 1 { ty = 0 }
        arm.task_call(&mut code, runtime, actions[i], ty, worker, 2147483647 - i)
        arm.task_call(&mut direct, other, actions[i], ty, worker, 2147483647 - i)
    }
    arm.end_mir(&mut code)
    none: []i32 = []; mut f := lifted(&code, &none)
    mut obj := lower.new_object(); assert(lower.lower_into(&mut obj, &f))
    assert(code.words.len == 10 && f.kinds.len == 9 && f.raw.len == 0)
    assert(lower.object_word_count(&obj) == direct.words.len && lower.object_reloc_count(&obj) == 5)
    for i in 0..direct.words.len { assert(lower.object_word(&obj, i) == direct.words[i]) }
    for i in 0..5 {
        start := mir.boundary(&f, i * 2); mut call := start
        if i >= 3 {
            assert(f.dst[start] == 2 && f.imm[start] == 2147483647)
            assert(f.dst[start + 1] == 3 && f.imm[start + 1] == i64(i - 3))
            call = start + 2
        }
        assert(f.kinds[call] == 14 && f.opcodes[call] == 49 + i && f.imm[call] == i64(2147483647 - i))
        assert(f.targets[call] == runtime && f.reads[call] == -1 && f.modes[call] == 1 && f.raw_starts[call] == -1)
        if i == 2 { assert(f.variant[call] == 2147483648) } else { assert(f.variant[call] == 0) }
        assert(mir.boundary(&f, 2*i+1) == -1 && lower.object_reloc_at(&obj, i) == direct.at[i])
    }
    f.variant[2] = 0; assert(!verify.verify(&mut f))
    code.words[5] = backend.task_origin(0, 0).bit_or(140737488355328)
    assert(!lift.lift(&mut f, &code, 0, 0, 0, &none, 0))
}
@test fn source_frame_and_return_lower_without_raw_prologue_or_epilogue() {
