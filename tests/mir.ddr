import ..selfhost.backend.arm64 as arm
import ..selfhost.mir.mir
import ..selfhost.mir.mir_lower as lower
import .fixtures.mir_machine as lift
import ..selfhost.mir.mir_lift as source_reader
import ..selfhost.mir.mir_verify as verify

@test fn word_and_xword_move_aliases_have_explicit_copy_widths() {
    mut code := arm.new()
    arm.emit(&mut code, 704644064 + 2 * 65536)
    arm.emit(&mut code, 2852127712 + 2 * 65536 + 1)
    arm.emit(&mut code, 704644064 + 31 * 65536 + 3)
    arm.ret(&mut code)
    none: []i32 = []; f := lifted(&code, &none)
    assert(f.kinds[0] == 2 && f.types[0] == 1 && f.a[0] == 2 && f.dst[0] == 0)
    assert(f.kinds[1] == 2 && f.types[1] == 2 && f.a[1] == 2 && f.dst[1] == 1)
    assert(f.kinds[2] == 1 && f.types[2] == 1 && f.imm[2] == 0 && f.reads[2] == 0)
}
import ..selfhost.mir.mir_abi as abi

fn lifted(code: &arm.Code, sites: &[]i32) -> mir.Function {
    mut f := mir.new(); assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut f)); f
}
@test fn frame_places_have_byte_ranges_and_expression_stack_is_distinct() {
    mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 5); arm.store(&mut code, 1, 0); arm.load(&mut code, 1)
    arm.push(&mut code, 0); arm.pop(&mut code, 1); arm.ret(&mut code)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.optimizable && !f.unknown_control)
    mut frame_place := -1; mut stack_place := -1
    for p in 0..f.place_kinds.len {
        if f.place_kinds[p] == 1 { frame_place = p }
        if f.place_kinds[p] == 2 { stack_place = p }
    }
    assert(frame_place >= 0 && stack_place >= 0 && frame_place != stack_place)
    assert(f.place_offsets[frame_place] == -16 && f.place_widths[frame_place] == 8)
    assert(!f.place_escaped[frame_place])
    mut accesses := 0
    for op in 0..f.kinds.len { if f.place[op] == frame_place { accesses = accesses + 1 } }
    assert(accesses == 2)
}
@test fn all_relocation_kinds_keep_complete_indivisible_units() {
    for kind in 0..21 {
        mut code := arm.new(); entry := arm.label(&mut code); arm.mark(&mut code, entry)
        arm.imm(&mut code, 0, 7); arm.branch(&mut code, entry, kind)
        sites: []i32 = []; f := lifted(&code, &sites)
        assert(f.kinds.len == 2 && f.reloc_kinds[1] == kind && f.targets[1] == entry)
        mut width := 1; if kind >= 2 { width = 2 }
        assert(f.widths[1] == width && f.raw.len == code.words.len)
        for i in 0..f.raw.len { assert(f.raw[i] == code.words[i]) }
        if kind >= 2 { assert(mir.boundary(&f, 2) == -1) }
    }
}
@test fn unknown_words_have_complete_barriers_and_unknown_control_edges() {
    mut code := arm.new(); arm.emit(&mut code, 4294967295); arm.imm(&mut code, 0, 1); arm.ret(&mut code)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(!f.optimizable && f.unknown_control && f.kinds[0] == 0)
    assert(f.effects[0] == 255 && f.reads[0] == -1 && f.writes[0] == -1 && f.flags[0] == 3)
    assert(f.edge_from[0] == 0 && f.edge_to[0] == -1 && f.edge_kinds[0] == 4)
    for e in 0..f.edge_from.len { if f.edge_from[e] == 0 { assert(f.edge_kinds[e] == 4) } }
}
@test fn trailing_owned_initializer_blocks_are_inside_the_function() {
    mut code := arm.new(); body := arm.label(&mut code); init := arm.label(&mut code)
    arm.branch(&mut code, init, 0); arm.mark(&mut code, body)
    arm.imm(&mut code, 0, 42); arm.ret(&mut code)
    arm.mark(&mut code, init); arm.imm(&mut code, 0, 0); arm.branch(&mut code, body, 0)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.source_words == code.words.len && f.raw.len == code.words.len)
    assert(f.label_ops[init] > f.label_ops[body] && f.block_starts.len >= 3)
    mut backedge := false
    for e in 0..f.edge_from.len { if f.edge_to[e] >= 0 && f.edge_to[e] < f.edge_from[e] { backedge = true } }
    assert(backedge)
}
@test fn imports_keep_byte_indices_and_cannot_overlap_or_split_pairs() {
    mut code := arm.new(); arm.imm(&mut code, 0, 1)
    arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0)
    mut sites: []i32 = [4]; mut f := lifted(&code, &sites)
    assert(f.kinds[1] == 17 && f.widths[1] == 2 && f.import_ids[1] == 0 && f.dst[1] == 0)
    interior := arm.label(&mut code); code.labels[interior] = 2
    assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    code.labels[interior] = -1; sites[0] = 5
    assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
}
@test fn verifier_rejects_corrupt_columns_duplicate_order_and_incomplete_opaque_contracts() {
    mut code := arm.new(); arm.imm(&mut code, 0, 1); arm.ret(&mut code)
    sites: []i32 = []; mut f := lifted(&code, &sites)
    f.order[1] = f.order[0]; assert(!verify.verify(&mut f))
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0)); removed := f.dst.pop(); assert(!verify.verify(&mut f))
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0)); mir.opaque(&mut f, 0)
    f.effects[0] = 0; assert(!verify.verify(&mut f))
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0)); f.dst[0] = 64; f.modes[0] = 1
    assert(!verify.verify(&mut f))
}
@test fn arithmetic_operands_and_flags_are_semantic_and_zr_never_aliases_sp() {
    mut code := arm.new()
    arm.emit(&mut code, 3506438176 + 7 * 1024)
    arm.emit(&mut code, 2332033024 + 3 * 65536 + 2 * 32 + 1)
    arm.emit(&mut code, 3942645791 + 1 * 65536)
    arm.emit(&mut code, 2852127712 + 31 * 65536 + 4)
    arm.emit(&mut code, 2432697341)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 4 && f.opcodes[0] == 2 && f.imm[0] == 7 && f.a[0] == 1)
    assert(f.kinds[1] == 4 && f.opcodes[1] == 1 && f.dst[1] == 1 && f.a[1] == 2 && f.b[1] == 3)
    assert(f.kinds[2] == 5 && f.dst[2] == -1 && f.flags[2] == 2 && f.writes[2] == 0)
    assert(f.kinds[3] == 1 && f.imm[3] == 0 && f.a[3] == -1 && f.reads[3] == 0)
    assert(f.kinds[4] == 16 && f.dst[4] == 29 && f.a[4] == 31)
}
@test fn calls_have_abi_clobbers_without_invented_ssa_definitions_and_float_has_real_operands() {
    mut code := arm.new(); target := arm.label(&mut code); arm.branch(&mut code, target, 1)
    arm.emit(&mut code, 505423872 + 2 * 65536 + 1 * 32 + 3)
    arm.emit(&mut code, 505421824 + 2 * 65536 + 1 * 32)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 14 && f.abi[0] == 1 && f.clobbers[0] == -1 && f.writes[0] == 0)
    assert(f.kinds[1] == 19 && f.opcodes[1] == 1 && f.dst[1] == 35 && f.a[1] == 33 && f.b[1] == 34)
    assert(f.kinds[2] == 19 && f.opcodes[2] == 5 && f.flags[2] == 2 && f.dst[2] == -1)
}
@test fn memory_identity_is_byte_range_and_independent_of_load_extension() {
    mut f := mir.new()
    raw := mir.add_place(&mut f, 1, -16, 4, 0)
    signed := mir.add_place(&mut f, 1, -16, 4, 2)
    overlapping := mir.add_place(&mut f, 1, -14, 8, 0)
    separate := mir.add_place(&mut f, 1, -32, 8, 0)
    assert(raw == signed && mir.places_alias(&f, raw, overlapping))
    assert(!mir.places_alias(&f, raw, separate))
    f.place_escaped[separate] = true; assert(mir.places_alias(&f, raw, separate))
}
@test fn preallocated_global_entry_is_explicitly_owned_without_a_prefix_scan() {
    mut code := arm.new(); entry := arm.label(&mut code); forward := arm.label(&mut code)
    arm.imm(&mut code, 0, 99); arm.mark(&mut code, entry); arm.imm(&mut code, 0, 42); arm.ret(&mut code)
    sites: []i32 = []; mut f := mir.new()
    assert(lift.lift(&mut f, &code, 1, 2, 0, &sites, 0))
    assert(f.label_ids.len == 0 && lift.own_entry(&mut f, &code, entry))
    assert(verify.verify(&mut f) && f.label_ids.len == 1 && f.label_ids[0] == entry && f.label_ops[0] == 0)
    assert(!lift.own_entry(&mut f, &code, forward))
}
@test fn complete_high_frame_spans_preserve_scratch_defs_and_validated_memory_places() {
    for slot in [0, 1, 32, 510, 511, 8191, 100000] {
        mut code := arm.new(); arm.begin_mir(&mut code, true)
        arm.load(&mut code, slot); arm.store(&mut code, slot, 3)
        sites: []i32 = []; mut f := mir.new()
        assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
        assert(verify.verify(&mut f) && f.kinds.len == 2 && f.kinds[0] == 7 && f.kinds[1] == 8)
        assert(f.place[0] == f.place[1] && f.place_offsets[f.place[0]] == -(slot + 1) * 8)
        assert(f.effects[0] == 3 && f.effects[1] == 5 && f.a[0] == 29 && f.a[1] == 3 && f.b[1] == 29)
        if slot >= 32 { assert(f.writes[0].bit_and(512) != 0 && f.writes[1].bit_and(512) != 0) }
        assert(f.raw.len == 0 && f.modes[0] == 1 && f.modes[1] == 1)
    }
}
@test fn unproved_memory_accesses_may_trap_and_frame_stack_bases_are_not_disjoint_proofs() {
    mut code := arm.new(); arm.emit(&mut code, 4181721120); arm.emit(&mut code, 4177526816)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 7 && f.effects[0].bit_and(1) == 1)
    assert(f.kinds[1] == 8 && f.effects[1].bit_and(1) == 1)
    mut places := mir.new(); frame := mir.add_place(&mut places, 1, -8, 8, 0)
    expression := mir.add_place(&mut places, 2, 0, 8, 0)
    assert(mir.places_alias(&places, frame, expression))
}
@test fn zr_roles_on_float_stack_and_select_do_not_alias_sp_or_v31() {
    mut code := arm.new()
    arm.emit(&mut code, 2657551328)
    arm.emit(&mut code, 2657484831)
    arm.emit(&mut code, 2594113535 + 4096)
    arm.push(&mut code, 31); arm.pop(&mut code, 31)
    arm.emit(&mut code, 505423872 + 31 * 65536 + 31 * 32 + 31)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 19 && f.a[0] == -1 && f.reads[0] == 0 && f.dst[0] == 32)
    assert(f.kinds[1] == 19 && f.dst[1] == -1 && f.writes[1] == 0 && f.a[1] == 32)
    assert(f.kinds[2] == 6 && f.dst[2] == -1 && f.writes[2] == 0)
    assert(f.kinds[3] == 10 && f.a[3] == -1 && f.b[3] == 31 && f.writes[3] == mir.variable_bit(31))
    assert(f.kinds[4] == 11 && f.dst[4] == -1 && f.a[4] == 31 && f.writes[4] == mir.variable_bit(31))
    assert(f.kinds[5] == 19 && f.dst[5] == 63 && f.a[5] == 63 && f.b[5] == 63)
}
@test fn verifier_derives_successors_and_rejects_moved_interior_terminators() {
    mut code := arm.new(); loop := arm.label(&mut code); arm.mark(&mut code, loop)
    arm.imm(&mut code, 0, 1); arm.branch(&mut code, loop, 0)
    sites: []i32 = []; mut f := lifted(&code, &sites)
    f.edge_to[0] = -1; f.edge_kinds[0] = 3; assert(!verify.verify(&mut f))
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    f.order[0] = 1; f.order[1] = 0; assert(!verify.verify(&mut f))
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    f.label_ops[0] = 1; assert(!verify.verify(&mut f))
}
@test fn nonterminator_slice_end_is_explicit_fallthrough_and_frames_are_ordered_effects() {
    mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 42)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.edge_kinds[f.edge_kinds.len - 1] == 5)
    for op in 0..f.kinds.len { if f.kinds[op] == 16 { assert(f.effects[op].bit_and(32) != 0) } }
}
@test fn large_frame_place_interning_reuses_exact_ranges_with_linear_probe_work() {
    mut f := mir.new(); count := 5000
    for slot in 0..count {
        place := mir.add_place(&mut f, 1, -(slot + 1) * 8, 8, 0); assert(place == slot)
    }
    for slot in 0..count {
        place := mir.add_place(&mut f, 1, -(slot + 1) * 8, 8, 2); assert(place == slot)
    }
    assert(f.place_kinds.len == count && f.place_probes < count * 20)
    mir.reset(&mut f); place := mir.add_place(&mut f, 1, -8, 8, 0)
    assert(place == 0 && f.place_table.len == 16 && f.place_probes == 1)
}
@test fn verifier_workspace_is_reused_and_plain_functions_skip_stack_dataflow() {
    mut code := arm.new(); arm.push(&mut code, 0); arm.pop(&mut code, 0); arm.ret(&mut code)
    sites: []i32 = []; mut f := mir.new(); mut work := verify.new_work()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify_into(&mut f, &mut work) && work.depths.len > 0)
    old_depths := work.depths.len; old_queue := work.queue.len
    code = arm.new(); arm.imm(&mut code, 0, 42); arm.ret(&mut code)
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0) && verify.verify_into(&mut f, &mut work))
    assert(work.depths.len == old_depths && work.queue.len == old_queue)
}
@test fn captured_owned_slot_zeroing_accepts_zr_without_a_stack_pointer_value() {
    for slot in [0, 32, 511] {
        mut code := arm.new(); arm.begin_mir(&mut code, true)
        arm.store(&mut code, slot, 31); arm.load_into(&mut code, slot, 31)
        sites: []i32 = []; mut f := mir.new()
        assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
        assert(verify.verify(&mut f) && f.kinds[0] == 8 && f.a[0] == -1 && f.b[0] == 29)
        assert(f.kinds[1] == 7 && f.dst[1] == -1 && f.a[1] == 29)
        assert(f.reads[0].bit_and(mir.variable_bit(31)) == 0 && f.writes[1].bit_and(mir.variable_bit(31)) == 0)
    }
}
@test fn canonical_rewrites_require_exact_operand_effect_and_scratch_contracts() {
    mut code := arm.new(); arm.mov(&mut code, 0, 1); arm.ret(&mut code)
    sites: []i32 = []; mut f := lifted(&code, &sites)
    f.modes[0] = 1; assert(verify.verify(&mut f))
    f.reads[0] = 0; assert(!verify.verify(&mut f))
    f.reads[0] = mir.variable_bit(1); f.effects[0] = 2; assert(!verify.verify(&mut f))
    f.effects[0] = 0; f.c[0] = 9; assert(!verify.verify(&mut f))
}
@test fn validated_frame_allocation_is_required_before_helper_loads_lose_maytrap() {
    mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    arm.begin_mir(&mut code, true); arm.load(&mut code, 0); arm.ret(&mut code)
    sites: []i32 = []
    mut f := mir.new()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut f) && f.effects[4] == 2)
    f.modes[4] = 1; assert(verify.verify(&mut f))
    f.writes[4] = f.writes[4].bit_or(512); f.c[4] = 9
    assert(!verify.verify(&mut f))
}
@test fn frame_pointer_stored_as_value_or_used_as_rhs_escapes_all_frame_ranges() {
    words: []i64 = [4177526813, 2332033024 + 29 * 65536 + 1 * 32]
    for word in words {
        mut code := arm.new(); arm.load(&mut code, 0); arm.emit(&mut code, word)
        sites: []i32 = []; mut f := lifted(&code, &sites)
        assert(f.place_escaped[f.place[0]])
        f.place_escaped[f.place[0]] = false; assert(!verify.verify(&mut f))
    }
}
@test fn retained_semantic_changes_require_canonical_reencoding_before_verification() {
    mut code := arm.new(); arm.mov(&mut code, 0, 1); arm.ret(&mut code)
    sites: []i32 = []; mut f := lifted(&code, &sites)
    f.a[0] = 2; f.reads[0] = mir.variable_bit(2)
    assert(!verify.verify(&mut f))
    f.modes[0] = 1; assert(verify.verify(&mut f))
}
@test fn one_canonical_reservation_and_deleted_unaddressed_low_half_keep_frame_proof() {
    mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    arm.begin_mir(&mut code, true); arm.load(&mut code, 0); arm.ret(&mut code)
    sites: []i32 = []
    mut f := mir.new()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    f.modes[2] = 1; f.imm[2] = 32; f.modes[3] = 2
    assert(verify.verify(&mut f) && f.effects[4] == 2)
    f.label_ids.push(0); f.label_ops.push(3); f.source_labels = 1
    assert(!verify.verify(&mut f))
}
@test fn frame_load_after_sp_reset_cannot_use_an_entry_only_allocation_proof() {
    mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    arm.emit(&mut code, 2432697279)
    arm.begin_mir(&mut code, true); arm.load(&mut code, 0)
    arm.emit(&mut code, 2831252477); arm.emit(&mut code, 3596551104)
    sites: []i32 = []
    mut f := mir.new()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut f) && f.effects[5] == 3 && f.place_escaped[f.place[5]])
}
@test fn internal_return_consumes_result_and_restored_caller_state_without_caller_scratch() {
    mut code := arm.new(); arm.imm(&mut code, 0, 42); arm.emit(&mut code, 3596551104)
    sites: []i32 = []; mut f := lifted(&code, &sites)
    assert(abi.internal_return_contract(&f, 1))
    assert(f.reads[1].bit_and(f.writes[0]) == mir.variable_bit(0))
    for reg in 18..32 { assert(f.reads[1].bit_and(mir.variable_bit(reg)) != 0) }
    for reg in 1..18 { assert(f.reads[1].bit_and(mir.variable_bit(reg)) == 0) }
    assert(f.reads[1].bit_and(mir.variable_bit(32)) == 0)
    f.reads[1] = mir.variable_bit(30); assert(!verify.verify(&mut f))
}
@test fn internal_return_keeps_callee_restore_live_without_escaping_frame_places() {
    mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
    arm.emit(&mut code, 4164944800 + i64(-8).bit_and(511) * 4096 + 25); restore := code.words.len - 1
    arm.ret(&mut code)
    sites: []i32 = []; f := lifted(&code, &sites)
    ret := f.kinds.len - 1
    assert(f.reads[ret].bit_and(f.writes[restore]) == mir.variable_bit(25))
    assert(!f.place_escaped[f.place[restore]] && abi.internal_return_contract(&f, ret))
}
fn main() {}

import ..selfhost.mir.mir_source as source

@test fn worker_lifts_batched_suffixes_with_absolute_bindings_and_source_ids() {
    mut code := arm.new(); entry := arm.label(&mut code); second := arm.label(&mut code); alias := arm.label(&mut code)
    mut batch := source.new(); mut sites: []i32 = []
    arm.mark(&mut code, entry); arm.begin_mir(&mut code, true)
    arm.branch(&mut code, second, 1); sites.push(code.words.len * 4)
    arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0); arm.ret(&mut code)
    arm.end_mir(&mut code)
    assert(source.capture(&mut batch, &code, 0, 3, 0, &sites, 0, entry))
    first_word := code.words.len; first_label := code.labels.len; first_reloc := code.at.len
    arm.mark(&mut code, second); arm.mark(&mut code, alias); arm.begin_mir(&mut code, true)
    local := arm.label(&mut code); arm.push(&mut code, 0); arm.pop(&mut code, 1)
    arm.branch(&mut code, local, 2); arm.branch(&mut code, alias, 0); arm.mark(&mut code, local)
    sites.push(code.words.len * 4); arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0)
    arm.branch(&mut code, entry, 1); arm.ret(&mut code); arm.end_mir(&mut code)
    assert(source.capture(&mut batch, &code, first_word, first_label, first_reloc, &sites, 1, second))
    mut direct := mir.new(); mut packed := mir.new(); mut work := lift.new_work()
    assert(lift.build_into(&mut direct, &mut work, &code, first_word, first_label, first_reloc, &sites, 1))
    assert(lift.own_entry(&mut direct, &code, second) && verify.verify(&mut direct))
    assert(lift.lift_item(&mut packed, &mut work, &batch, 1) == 0 && verify.verify(&mut packed))
    assert(packed.raw.len == direct.raw.len && packed.origins.len == direct.origins.len)
    assert(packed.first_word == first_word && packed.source_words == code.words.len && packed.first_import == 1)
    for i in 0..direct.kinds.len {
        assert(packed.kinds[i] == direct.kinds[i] && packed.recipes[i] == direct.recipes[i] && packed.origins[i] == direct.origins[i])
        assert(packed.targets[i] == direct.targets[i] && packed.import_ids[i] == direct.import_ids[i])
    }
    assert(packed.label_ids.len == direct.label_ids.len && packed.edge_to.len == direct.edge_to.len)
    for i in 0..direct.label_ids.len { assert(packed.label_ids[i] == direct.label_ids[i] && packed.label_ops[i] == direct.label_ops[i]) }
    for i in 0..direct.edge_to.len { assert(packed.edge_to[i] == direct.edge_to[i] && packed.edge_kinds[i] == direct.edge_kinds[i]) }
    assert(lift.lift_item(&mut packed, &mut work, &batch, 0) == 0 && verify.verify(&mut packed))
    assert(packed.label_ids.len == 1 && packed.label_ids[0] == entry)
    source.reset(&mut batch); assert(source.count(&batch) == 0)
}

@test fn raw_lift_rejects_invalid_rows_overlap_and_incorrect_entry_binding() {
    mut code := arm.new(); entry := arm.label(&mut code); arm.mark(&mut code, entry)
    arm.imm(&mut code, 0, 8); arm.branch(&mut code, entry, 2); arm.ret(&mut code)
    sites: []i32 = []; mut batch := source.new()
    assert(!source.capture(&mut batch, &code, 2, 1, 1, &sites, 0, entry))
    assert(source.count(&batch) == 0 && batch.words.len == 0)
    assert(source.capture(&mut batch, &code, 0, 1, 0, &sites, 0, -1))
    mut f := mir.new(); mut work := lift.new_work()
    assert(lift.lift_item(&mut f, &mut work, &batch, 0) == 11)
    batch.target_words[0] = 2
    assert(lift.lift_item(&mut f, &mut work, &batch, 0) == 10)
    assert(lift.lift_item(&mut f, &mut work, &batch, 1) == 10)
}

@test fn logical_literals_and_copies_lower_without_retained_instructions() {
    for platform in 0..4 {
        mut code := arm.new_for(platform); mut reference := arm.new_for(platform)
        arm.begin_mir(&mut code, true)
        values: []i64 = [-9223372036854775807, -140737488355329, -140737488355328, -1, 0, 140737488355327, 140737488355328, 9223372036854775807]
        for value in values {
            arm.imm(&mut code, 4, value); arm.imm(&mut reference, 4, value)
        }
        arm.mov(&mut code, 0, 4); arm.mov(&mut reference, 0, 4)
        arm.end_mir(&mut code)
