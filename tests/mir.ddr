        arm.begin_mir(&mut code, true)
        for op in ["+", "-", "*", "/", "==", "!=", "<", "<=", ">", ">="] {
            assert(floats.binary(&mut code, op, ty, 123) == floats.binary(&mut reference, op, ty, 123))
        }
        for name in ["to_bits", "is_sign_negative", "abs", "sqrt", "floor", "ceil", "round", "round_ties_even",
                "trunc", "negate", "is_nan", "is_finite", "is_infinite"] {
