import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify

fn lifted(code: &arm.Code, sites: &[]i32) -> mir.Function {
    var f := mir.new(); assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut f)); f
}
@test fn frame_places_have_byte_ranges_and_expression_stack_is_distinct() {
    var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 5); arm.store(&mut code, 1, 0); arm.load(&mut code, 1)
    arm.push(&mut code, 0); arm.pop(&mut code, 1); arm.ret(&mut code)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.optimizable && !f.unknown_control)
    var frame_place := -1; var stack_place := -1
    for p in 0..f.place_kinds.len {
        if f.place_kinds[p] == 1 { frame_place = p }
        if f.place_kinds[p] == 2 { stack_place = p }
    }
    assert(frame_place >= 0 && stack_place >= 0 && frame_place != stack_place)
    assert(f.place_offsets[frame_place] == -16 && f.place_widths[frame_place] == 8)
    assert(!f.place_escaped[frame_place])
    var accesses := 0
    for op in 0..f.kinds.len { if f.place[op] == frame_place { accesses = accesses + 1 } }
    assert(accesses == 2)
}
@test fn all_relocation_kinds_keep_complete_indivisible_units() {
    for kind in 0..21 {
        var code := arm.new(); entry := arm.label(&mut code); arm.mark(&mut code, entry)
        arm.imm(&mut code, 0, 7); arm.branch(&mut code, entry, kind)
        sites: []i32 = []; f := lifted(&code, &sites)
        assert(f.kinds.len == 2 && f.reloc_kinds[1] == kind && f.targets[1] == entry)
        var width := 1; if kind >= 2 { width = 2 }
        assert(f.widths[1] == width && f.raw.len == code.words.len)
        for i in 0..f.raw.len { assert(f.raw[i] == code.words[i]) }
        if kind >= 2 { assert(mir.boundary(&f, 2) == -1) }
    }
}
@test fn unknown_words_have_complete_barriers_and_unknown_control_edges() {
    var code := arm.new(); arm.emit(&mut code, 4294967295); arm.imm(&mut code, 0, 1); arm.ret(&mut code)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(!f.optimizable && f.unknown_control && f.kinds[0] == 0)
    assert(f.effects[0] == 255 && f.reads[0] == -1 && f.writes[0] == -1 && f.flags[0] == 3)
    assert(f.edge_from[0] == 0 && f.edge_to[0] == -1 && f.edge_kinds[0] == 4)
    for e in 0..f.edge_from.len { if f.edge_from[e] == 0 { assert(f.edge_kinds[e] == 4) } }
}
@test fn trailing_owned_initializer_blocks_are_inside_the_function() {
    var code := arm.new(); body := arm.label(&mut code); init := arm.label(&mut code)
    arm.branch(&mut code, init, 0); arm.mark(&mut code, body)
    arm.imm(&mut code, 0, 42); arm.ret(&mut code)
    arm.mark(&mut code, init); arm.imm(&mut code, 0, 0); arm.branch(&mut code, body, 0)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.source_words == code.words.len && f.raw.len == code.words.len)
    assert(f.label_ops[init] > f.label_ops[body] && f.block_starts.len >= 3)
    var backedge := false
    for e in 0..f.edge_from.len { if f.edge_to[e] >= 0 && f.edge_to[e] < f.edge_from[e] { backedge = true } }
    assert(backedge)
}
@test fn imports_keep_byte_indices_and_cannot_overlap_or_split_pairs() {
    var code := arm.new(); arm.imm(&mut code, 0, 1)
    arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0)
    var sites: []i32 = [4]; var f := lifted(&code, &sites)
    assert(f.kinds[1] == 17 && f.widths[1] == 2 && f.import_ids[1] == 0 && f.dst[1] == 0)
    interior := arm.label(&mut code); code.labels[interior] = 2
    assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    code.labels[interior] = -1; sites[0] = 5
    assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
}
@test fn verifier_rejects_corrupt_columns_duplicate_order_and_incomplete_opaque_contracts() {
    var code := arm.new(); arm.imm(&mut code, 0, 1); arm.ret(&mut code)
    sites: []i32 = []; var f := lifted(&code, &sites)
    f.order[1] = f.order[0]; assert(!verify.verify(&mut f))
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0)); removed := f.dst.pop(); assert(!verify.verify(&mut f))
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0)); mir.opaque(&mut f, 0)
    f.effects[0] = 0; assert(!verify.verify(&mut f))
}
@test fn arithmetic_operands_and_flags_are_semantic_and_zr_never_aliases_sp() {
    var code := arm.new()
    arm.emit(&mut code, 3506438176 + 7 * 1024) // SUB x0,x1,#7
    arm.emit(&mut code, 2332033024 + 3 * 65536 + 2 * 32 + 1) // ADD x1,x2,x3
    arm.emit(&mut code, 3942645791 + 1 * 65536) // CMP x0,x1
    arm.emit(&mut code, 2852127712 + 31 * 65536 + 4) // MOV x4,xzr
    arm.emit(&mut code, 2432697341) // MOV fp,sp
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 4 && f.opcodes[0] == 2 && f.imm[0] == 7 && f.a[0] == 1)
    assert(f.kinds[1] == 4 && f.opcodes[1] == 1 && f.dst[1] == 1 && f.a[1] == 2 && f.b[1] == 3)
    assert(f.kinds[2] == 5 && f.dst[2] == -1 && f.flags[2] == 2 && f.writes[2] == 0)
    assert(f.kinds[3] == 1 && f.imm[3] == 0 && f.a[3] == -1 && f.reads[3] == 0)
    assert(f.kinds[4] == 16 && f.dst[4] == 29 && f.a[4] == 31)
}
@test fn calls_have_abi_clobbers_without_invented_ssa_definitions_and_float_has_real_operands() {
    var code := arm.new(); target := arm.label(&mut code); arm.branch(&mut code, target, 1)
    arm.emit(&mut code, 505423872 + 2 * 65536 + 1 * 32 + 3) // FADD s3,s1,s2
    arm.emit(&mut code, 505421824 + 2 * 65536 + 1 * 32) // FCMP s1,s2
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 14 && f.abi[0] == 1 && f.clobbers[0] == -1 && f.writes[0] == 0)
    assert(f.kinds[1] == 19 && f.opcodes[1] == 1 && f.dst[1] == 35 && f.a[1] == 33 && f.b[1] == 34)
    assert(f.kinds[2] == 19 && f.opcodes[2] == 5 && f.flags[2] == 2 && f.dst[2] == -1)
}
@test fn memory_identity_is_byte_range_and_independent_of_load_extension() {
    var f := mir.new()
    raw := mir.add_place(&mut f, 1, -16, 4, 0)
    signed := mir.add_place(&mut f, 1, -16, 4, 2)
    overlapping := mir.add_place(&mut f, 1, -14, 8, 0)
    separate := mir.add_place(&mut f, 1, -32, 8, 0)
    assert(raw == signed && mir.places_alias(&f, raw, overlapping))
    assert(!mir.places_alias(&f, raw, separate))
    f.place_escaped[separate] = true; assert(mir.places_alias(&f, raw, separate))
}
@test fn preallocated_global_entry_is_explicitly_owned_without_a_prefix_scan() {
    var code := arm.new(); entry := arm.label(&mut code); forward := arm.label(&mut code)
    arm.imm(&mut code, 0, 99); arm.mark(&mut code, entry); arm.imm(&mut code, 0, 42); arm.ret(&mut code)
    sites: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, 1, 2, 0, &sites, 0))
    assert(f.label_ids.len == 0 && lift.own_entry(&mut f, &code, entry))
    assert(verify.verify(&mut f) && f.label_ids.len == 1 && f.label_ids[0] == entry && f.label_ops[0] == 0)
    assert(!lift.own_entry(&mut f, &code, forward))
}
@test fn complete_high_frame_spans_preserve_scratch_defs_and_validated_memory_places() {
    for slot in [1, 32, 510, 511, 8191, 100000] {
        var code := arm.new(); var starts: []i32 = []; var ends: []i32 = []
        starts.push(code.words.len); arm.load(&mut code, slot); ends.push(code.words.len)
        starts.push(code.words.len); arm.store(&mut code, slot, 3); ends.push(code.words.len)
        sites: []i32 = []; kinds: []i32 = [1, 2]; a: []i32 = [slot, slot]; b: []i32 = [0, 3]
        var f := mir.new()
        assert(lift.lift_spans(&mut f, &code, 0, 0, 0, &sites, 0, &starts, &ends, &kinds, &a, &b))
        assert(verify.verify(&mut f) && f.kinds.len == 2 && f.kinds[0] == 7 && f.kinds[1] == 8)
        assert(f.place[0] == f.place[1] && f.place_offsets[f.place[0]] == -(slot + 1) * 8)
        assert(f.effects[0] == 2 && f.effects[1] == 4 && f.a[0] == 29 && f.a[1] == 3 && f.b[1] == 29)
        if slot >= 32 { assert(f.writes[0].bit_and(512) != 0 && f.writes[1].bit_and(512) != 0) }
        // A stale endpoint cannot split an address-producing unit.
        ends[0] = ends[0] - 1
        assert(!lift.lift_spans(&mut f, &code, 0, 0, 0, &sites, 0, &starts, &ends, &kinds, &a, &b))
    }
}
@test fn unproved_memory_accesses_may_trap_and_frame_stack_bases_are_not_disjoint_proofs() {
    var code := arm.new(); arm.emit(&mut code, 4181721120); arm.emit(&mut code, 4177526816)
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 7 && f.effects[0].bit_and(1) == 1)
    assert(f.kinds[1] == 8 && f.effects[1].bit_and(1) == 1)
    var places := mir.new(); frame := mir.add_place(&mut places, 1, -8, 8, 0)
    expression := mir.add_place(&mut places, 2, 0, 8, 0)
    assert(mir.places_alias(&places, frame, expression))
}
@test fn zr_roles_on_float_stack_and_select_do_not_alias_sp_or_v31() {
    var code := arm.new()
    arm.emit(&mut code, 2657551328) // FMOV D0,XZR
    arm.emit(&mut code, 2657484831) // FMOV XZR,D0
    arm.emit(&mut code, 2594113535 + 4096) // CSET XZR,NE
    arm.push(&mut code, 31); arm.pop(&mut code, 31)
    arm.emit(&mut code, 505423872 + 31 * 65536 + 31 * 32 + 31) // FADD S31,S31,S31
    sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds[0] == 19 && f.a[0] == -1 && f.reads[0] == 0 && f.dst[0] == 32)
    assert(f.kinds[1] == 19 && f.dst[1] == -1 && f.writes[1] == 0 && f.a[1] == 32)
    assert(f.kinds[2] == 6 && f.dst[2] == -1 && f.writes[2] == 0)
    assert(f.kinds[3] == 10 && f.a[3] == -1 && f.b[3] == 31 && f.writes[3] == mir.variable_bit(31))
    assert(f.kinds[4] == 11 && f.dst[4] == -1 && f.a[4] == 31 && f.writes[4] == mir.variable_bit(31))
    assert(f.kinds[5] == 19 && f.dst[5] == 63 && f.a[5] == 63 && f.b[5] == 63)
}
fn main() {}
