        assert(f.raw.len == 0 && f.kinds.len == 9 && f.kinds[8] == 2 && f.a[8] == 4)
        for op in 0..f.order.len { assert(f.modes[op] == 1 && f.raw_starts[op] == -1) }
        assert(verify.verify(&mut f)); mut object := lower.new_object()
        assert(lower.lower_into(&mut object, &f) && lower.object_word_count(&object) == reference.words.len)
        for at in 0..reference.words.len { assert(lower.object_word(&object, at) == reference.words[at]) }
    }
}

import ..selfhost.frontend.source_call
import ..selfhost.mir.mir_call_inputs as call_inputs

@test fn resolved_source_calls_carry_their_register_inputs_and_origin() {
    mut code := arm.new(); target := arm.label(&mut code)
    arm.begin_mir(&mut code, true)
    slots: []i32 = [2, 0]
    source_call.lower(&mut code, target, -1, -1, &slots, 93, 2, 4711)
    arm.end_mir(&mut code)
    none: []i32 = []; mut f := lifted(&code, &none)
    op := f.order[f.order.len - 1]
    assert(f.kinds[op] == 14 && f.opcodes[op] == 48 && f.aux[op] == 2 && f.imm[op] == 4711)
    assert(f.types[op] == 2 && f.variant[op] == i64(93).shl(32) && f.targets[op] == target && f.raw_starts[op] == -1 && f.reads[op] == -1)
    source := call_inputs.trusted_source_inputs_v1()
    conservative := call_inputs.conservative()
    assert(call_inputs.reads(&source, &f, op).bit_and(255) == 3)
    assert(call_inputs.reads(&conservative, &f, op) == -1)
    f.aux[op] = 9
    assert(!verify.verify(&mut f))
}

@test fn ownership_calls_keep_action_type_and_source_through_lowering() {
    for platform in 0..4 {
        mut code := arm.new_for(platform); mut sites: []i32 = []
        callee := arm.label(&mut code)
        arm.begin_mir(&mut code, true)
        arm.ownership_call(&mut code, callee, .Copy, 17, 2147483647)
        arm.ownership_call(&mut code, callee, .Drop, 18, 0)
        arm.ownership_call(&mut code, callee, .NormalizeTransfer, 19, 52)
        arm.ownership_call(&mut code, callee, .Clear, 20, 91)
        arm.end_mir(&mut code)
        mut f := lifted(&code, &sites)
        assert(f.kinds.len == 4 && f.raw.len == 0 && f.imm[0] == 2147483647 && f.imm[3] == 91)
        for i in 0..4 {
            assert(f.kinds[i] == 14 && f.modes[i] == 1 && f.opcodes[i] == 16 + i)
            assert(f.aux[i] == 17 + i && f.targets[i] == callee && f.reloc_kinds[i] == 1)
            assert(mir.boundary(&f, 2*i+1) == -1)
        }
        mut obj := lower.new_object()
        assert(lower.lower_into(&mut obj, &f) && lower.object_word_count(&obj) == 4)
        f.flags[0] = 0
        assert(!verify.verify(&mut f))
        code.labels[callee] = 1
        assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
        code.labels[callee] = -1
        sites.push(4)
        assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
        sites.clear()
        code.words[1] = 42
        assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    }
}

import ..selfhost.backend.floats

@test fn floating_source_operations_lower_once_with_their_source_width() {
    for ty in [6, 7] {
