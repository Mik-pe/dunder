        for row in 0..reference.words.len { assert(lower.object_word(&output, row) == reference.words[row]) }
    }
}

@test fn typed_calls_expand_evaluated_slots_on_the_target_and_preserve_overflow_arguments() {
    slots: []i32 = [62, 1, 32769, 65500, 4, 5, 6, 7, 8, 9]
    for mode in 0..3 {
        mut platform := 0; mut callee := -1; mut dispatch := -1
        if mode != 0 { callee = 320 }
        if mode == 2 { platform = 3; dispatch = 47 }
        mut code := arm.new_for(platform); mut expected := arm.new_for(platform)
        entry := arm.label(&mut code); other := arm.label(&mut expected)
        arm.begin_mir(&mut code, true)
        source_call.lower(&mut code, entry, callee, dispatch, &slots, 415, 17, 209)
        arm.end_mir(&mut code)
        source_call.lower(&mut expected, other, callee, dispatch, &slots, 415, 17, 209)
        mut size := 5; if mode != 0 { size = 6 }
        assert(code.words.len == size)
        none: []i32 = []; mut f := lifted(&code, &none)
        assert(f.raw.len == 0 && mir.boundary(&f, 0) == 0 && mir.boundary(&f, 1) == -1)
        mut seen := 0
        for op in f.order {
            if f.kinds[op] == 14 {
                assert(f.types[op] == 17 && f.variant[op].shr(32) == 415 && f.imm[op] == 209 && f.aux[op] == 8)
                if mode != 0 { assert(f.a[op] == 16 && f.targets[op] == -1) }
                seen = seen + 1
            }
        }
        mut obj := lower.new_object(); assert(seen == 1 && lower.lower_into(&mut obj, &f))
        assert(lower.object_word_count(&obj) == expected.words.len)
        for i in 0..expected.words.len { assert(lower.object_word(&obj, i) == expected.words[i]) }
        if mode == 0 { assert(lower.object_reloc_at(&obj, 0) == expected.at[0]) }
        ignored := code.words.pop(); assert(!lift.lift(&mut f, &code, 0, 0, 0, &none, 0))
    }
}

import ..selfhost.runtime.runtime_intrinsic as ri

@test fn typed_runtime_operations_synthesize_abi_arguments_and_preserve_effects() {
    for platform in 0..4 {
        mut code := arm.new_for(platform); mut reference := arm.new_for(platform)
        runtime := arm.label(&mut code); other := arm.label(&mut reference)
        arm.begin_mir(&mut code, true)
        actions: []ri.Operation = [.ArrayNew, .ArrayInitializeElement, .ArrayPush, .ArrayReserve, .ArrayPop, .ArrayClear,
            .Concat, .Compare, .Slice, .Bytes, .Runes, .NextRune, .Format, .Format, .Print, .ArrayRemove, .CheckRune]
        inputs: []i32 = [0,1,24,24,24,24,4,4,4,4,4,4,6,12,12,24,1]
        results: []i32 = [0,0,0,0,1,0,4,1,4,21,22,5,4,4,0,1,5]
        for i in 0..actions.len {
            source := 2147483647 - i
            arm.intrinsic_call(&mut code, runtime, actions[i], inputs[i], results[i], source)
            arm.intrinsic_call(&mut reference, other, actions[i], inputs[i], results[i], source)
            if i == 0 {
                arm.finish_array_literal(&mut code, 0, 1, 2147483647, 2, source)
                arm.finish_array_literal(&mut reference, 0, 1, 2147483647, 2, source)
            }
        }
        arm.end_mir(&mut code); none: []i32 = []; mut f := lifted(&code, &none)
        assert(f.raw.len == 0)
        mut obj := lower.new_object(); assert(lower.lower_into(&mut obj, &f))
        assert(lower.object_word_count(&obj) == reference.words.len)
        for i in 0..reference.words.len { assert(lower.object_word(&obj, i) == reference.words[i]) }
        mut calls := 0
        for op in f.order {
            if f.kinds[op] != 14 { continue }
            assert(f.modes[op] == 1 && f.opcodes[op] == 96 && f.aux[op] % 32 == i32(actions[calls]))
            assert(f.imm[op] == i64(2147483647 - calls) && f.effects[op] == ri.effects(i32(actions[calls])))
            assert(f.reads[op] == -1 && f.clobbers[op] == -1)
            if calls == 0 { assert(ri.result(f.variant[op]) == 2147483647 && f.aux[op] / 32 == 2) }
            else { assert(ri.input(f.variant[op]) == inputs[calls] && ri.result(f.variant[op]) == results[calls]) }
            if platform == 3 && actions[calls] == .Print { assert(f.targets[op] == -1 && f.abi[op] == 2) }
            else { assert(f.targets[op] == runtime && f.abi[op] == 1) }
            calls = calls + 1
        }
        assert(calls == actions.len)
        f.effects[f.order[f.order.len - 1]] = 95; assert(!verify.verify(&mut f))
        code.words[1] = backend.intrinsic_origin(0, -1)
        assert(!lift.lift(&mut f, &code, 0, 0, 0, &none, 0))
    }
}

@test fn aggregate_construction_keeps_type_layout_and_enum_discriminant() {
    mut code := arm.new(); heap := arm.label(&mut code); arm.begin_mir(&mut code, true)
    arm.allocate_value(&mut code, heap, .Record, 31, 32, 100)
    arm.allocate_value(&mut code, heap, .EnumPayload, 32, 16, 110)
    arm.allocate_value(&mut code, heap, .CRecord, 33, 3, 120)
    arm.enum_value(&mut code, 1, 32, 4, -2147483649, 110); arm.end_mir(&mut code)
    sites: []i32 = []; mut f := lifted(&code, &sites); assert(f.raw.len == 0 && f.order.len == 7)
    for i in 0..3 {
        call := f.order[i * 2 + 1]
        assert(f.opcodes[call] == 110 && f.aux[call] == i && f.variant[call].shr(32) == i64(31 + i))
        assert(f.imm[call] == i64(100 + 10 * i) && f.variant[call].bit_and(4294967295) == f.imm[f.order[i * 2]])
    }
    tag := f.order[6]; assert(f.opcodes[tag] == 111 && f.aux[tag] == 4 && f.variant[tag].shr(32) == 32 && f.imm[tag] == -2147483649)
    mut object := lower.new_object(); assert(lower.lower_into(&mut object, &f) && lower.object_reloc_count(&object) == 3)
    code.words[3] = i64(3).shl(32).bit_or(110); assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
}

import ..selfhost.frontend.place_operation as place
import ..selfhost.frontend.place_emit

@test fn typed_places_keep_provenance_access_effects_and_atomic_boundaries() {
    ops: []place.Op = [.Field, .CheckIndex, .Element, .Read, .Write, .BorrowHome, .BorrowSaved,
        .BorrowPayload, .LocalRead, .LocalWrite, .CopySetup, .CopyTest, .CopyPart, .RegionWrite, .Member, .Member]
    forms := [0, 1, 2, 4, 1, 0, 0, 0, 4, 0, 1, 1, 5, 0, i32(place.Member.Initialize), i32(place.Member.Length)]
    parameters := [4100, 0, 27, 0, 1, 512, 512, 0, 512, 512, 600, 0, 4, 5, 1, 1]
    sites: []i32 = []
    for platform in 0..4 {
        mut code := arm.new_for(platform); mut reference := arm.new_for(platform); arm.begin_mir(&mut code, true)
        for i in 0..ops.len {
            place_emit.emit(&mut code, ops[i], 200 + i, i % 5, forms[i], parameters[i], 9000 + i)
            place_emit.emit(&mut reference, ops[i], 200 + i, i % 5, forms[i], parameters[i], 9000 + i)
        }
        mut f := lifted(&code, &sites)
        assert(f.raw.len == 0 && f.kinds.len == ops.len)
        for i in 0..ops.len {
            assert(mir.boundary(&f, i * 2) == i && mir.boundary(&f, i * 2 + 1) == -1)
            assert(f.opcodes[i] == place.tag(ops[i]) + (i % 5) * 128 && f.variant[i].shr(32) == i64(200 + i) &&
                f.variant[i].bit_and(4294967295) == i64(9000 + i))
        }
        assert(f.effects[1] == 3 && f.flags[1] == 2 && f.imm[2] == 27)
        assert(f.kinds[3] == 7 && f.extensions[3] == 2 && f.kinds[4] == 8 && f.aux[4] == 2)
        assert(f.effects[12] == 7 && f.effects[13] == 7 && f.effects[14] == 5 && f.effects[15] == 3)
        mut output := lower.new_object()
        assert(lower.lower_into(&mut output, &f) && lower.object_word_count(&output) == reference.words.len)
        for i in 0..reference.words.len { assert(lower.object_word(&output, i) == reference.words[i]) }
        f.effects[12] = 0; assert(!verify.verify(&mut f))
        code.words[1] = place.location(5, 0).bit_or(2147483648)
        assert(!lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    }
}

import ..selfhost.frontend.iteration

@test fn source_iteration_steps_keep_element_domain_and_byte_origin() {
    mut code := arm.new(); mut reference := arm.new(); arm.begin_mir(&mut code, true)
    steps: []iteration.Step = [.PackRange, .RangeStart, .RangeLimit, .Test, .Advance]
    for step in steps {
        iteration.emit(&mut code, step, .Range, 1, 123)
        iteration.emit(&mut reference, step, .Range, 1, 123)
    }
    iteration.emit(&mut code, .Advance, .Array, 71, 124)
    iteration.emit(&mut reference, .Advance, .Array, 71, 124)
    iteration.rune(&mut code, 125); iteration.rune(&mut reference, 125)
    _ := arm.relax_branches(&mut reference)
    arm.end_mir(&mut code); none: []i32 = []; mut f := lifted(&code, &none)
    assert(f.raw.len == 0 && f.kinds[0] == 25 && f.writes[0] == 3)
    assert(f.kinds[5] == 25 && f.types[5] == 71 && f.aux[5] == i32(iteration.Kind.Array) && f.imm[5] == 124)
    mut count := 0
    for op in f.order {
        if f.kinds[op] == 25 && f.imm[op] == 125 {
            assert(f.types[op] == 5 && f.aux[op] == i32(iteration.Kind.Runes))
            count = count + 1
        }
    }
    assert(count == 5)
    mut object := lower.new_object(); assert(lower.lower_into(&mut object, &f))
    assert(lower.object_word_count(&object) == reference.words.len)
    for i in 0..reference.words.len { assert(lower.object_word(&object, i) == reference.words[i]) }
    for i in 0..reference.at.len { assert(lower.object_reloc_at(&object, i) == reference.at[i]) }
    f.aux[0] = i32(iteration.Kind.Bytes); assert(!verify.verify(&mut f))
    code.words[1] = backend.source(-1); assert(!lift.lift(&mut f, &code, 0, 0, 0, &none, 0))
}

import ..selfhost.frontend.typed_places as typed_places
import ..selfhost.mir.mir_source as place_source
@test fn each_typed_function_binds_its_local_and_projected_operands() {
    mut batch := place_source.new(); mut code := arm.new(); mut g := typed_places.new()
    mut lifter := lift.new_work(); mut f := mir.new(); none: []i32 = []
    for pass in 0..2 {
        typed_places.reset(&mut g)
        ty := 101 + pass; home := 3 + pass * 40
        typed_places.local(&mut g, home, ty, 3, 0)
        layout := typed_places.layout(.Field, pass * 128, 4)
        id := typed_places.project(&mut g, -1, 120 + pass, ty, 1, layout, 900)
        first := code.words.len; label := arm.label(&mut code); arm.mark(&mut code, label)
        code.words.push(place.bound_header(.LocalRead, -1, 0, 45))
        code.words.push(place.bound_header(.Field, id, 1, 900))
        code.words.push(place.bound_header(.Read, id, 0, 900))
        assert(place_source.capture(&mut batch, &code, first, code.labels.len, 0, &none, 0, label))
        place_source.attach_places(&mut batch, &g)
    }
    for i in [1, 0] {
        assert(lift.lift_item(&mut f, &mut lifter, &batch, i) == 0 && verify.verify(&mut f))
        assert(f.kinds[0] == 7 && f.imm[0] == -8 * i64(4 + i * 40) && f.variant[0].shr(32) == i64(101 + i))
        assert(f.kinds[1] == 23 && f.imm[1] == i64(i * 128) && f.variant[1].bit_and(2147483647) == 900)
        assert(f.kinds[2] == 7 && f.aux[2] == 4 && f.extensions[2] == 2)
    }
    batch.words[0] = place.bound_header(.LocalRead, -2, 0, 45)
    assert(lift.lift_item(&mut f, &mut lifter, &batch, 0) == 10)
    batch.words[0] = place.bound_header(.LocalRead, -1, 0, 45)
    batch.words[1] = place.bound_header(.Field, 2, 1, 900)
    assert(lift.lift_item(&mut f, &mut lifter, &batch, 0) == 10)
    batch.words[1] = place.bound_header(.Field, 1, 1, 900)
    batch.places.nodes[0] = i64(1).shl(32)
    assert(lift.lift_item(&mut f, &mut lifter, &batch, 0) == 10)
    assert(lift.lift_item(&mut f, &mut lifter, &batch, 1) == 0)
}

import ..selfhost.frontend.scratch as scratch
import ..selfhost.frontend.region_operation as region

@test fn regions_keep_layout_checks_view_initialization_and_observable_failures() {
    for platform in 0..4 {
        mut code := arm.new_for(platform); mut raw := arm.new_for(platform)
        bounds := arm.label(&mut code); old := arm.label(&mut raw)
        arm.begin_mir(&mut code, true)
        scratch.allocate(&mut code, 0, 6, 3, 1, 1, bounds, 0, 111)
        scratch.allocate(&mut raw, 0, 6, 3, 1, 1, old, 0, 111)
        scratch.allocate(&mut code, 1, 12, 41, 24, 8, bounds, 3, 222)
        scratch.allocate(&mut raw, 1, 12, 41, 24, 8, old, 3, 222)
        arm.fail_source(&mut code, .InvalidRegion, 333); arm.fail_source(&mut raw, .InvalidRegion, 333)
        _ := arm.relax_branches(&mut raw)
        arm.end_mir(&mut code)
        none: []i32 = []; mut f := mir.new(); assert(source_reader.lift(&mut f, &code, 0, 0, 0, &none, 0))
        assert(verify.verify(&mut f) && f.raw.len == 0)
        mut layouts := 0; mut installs := 0
        for op in f.order {
            if f.kinds[op] == 26 {
                if f.opcodes[op] == i32(region.Stage.Layout) {
                    layouts = layouts + 1
                    if f.types[op] == 3 { assert(f.imm[op] == 1 && f.writes[op] == 30) }
                    else { assert(f.types[op] == 41 && f.imm[op] == 24 && f.aux[op] == 8 && f.variant[op] == 222 && f.writes[op] == 31) }
                } else { installs = installs + 1; assert(f.effects[op] == 5) }
            }
        }
        last := f.order[f.order.len - 1]
        assert(layouts == 2 && installs == 2 && f.kinds[last] == 20 && f.aux[last] == 1 && f.imm[last] == 333)
        mut obj := lower.new_object(); assert(lower.lower_into(&mut obj, &f))
        assert(lower.object_word_count(&obj) == raw.words.len)
        for i in 0..raw.words.len { assert(lower.object_word(&obj, i) == raw.words[i]) }
        f.flags[last] = 0; assert(!verify.verify(&mut f))
    }
}

@test fn retained_index_and_address_homes_are_selected_from_the_projection() {
    mut g := typed_places.new(); typed_places.local(&mut g, 3, 101, 3, 0)
    id := typed_places.project(&mut g, -1, 40 + 1, 101, 102, typed_places.layout(.ArrayIndex, 3, 3), 99)
    typed_places.save_home(&mut g, id, 51)
    mut code := arm.new(); target := arm.label(&mut code); arm.mark(&mut code, target)
    code.words.push(place.bound_header(.Temporary, id, i32(place.Temporary.SaveIndex), 99))
    code.words.push(place.bound_header(.Temporary, id, i32(place.Temporary.SaveAddress), 99))
    code.words.push(place.bound_header(.BorrowSaved, id, 4, 100))
    code.words.push(place.bound_header(.Temporary, id, i32(place.Temporary.LoadIndex), 99))
    sites: []i32 = []; mut batch := place_source.new()
    assert(place_source.capture(&mut batch, &code, 0, 1, 0, &sites, 0, target)); place_source.attach_places(&mut batch, &g)
    mut f := mir.new(); mut w := lift.new_work()
    assert(lift.lift_item(&mut f, &mut w, &batch, 0) == 0 && verify.verify(&mut f))
    assert(f.kinds[0] == 8 && f.imm[0] == -328 && f.variant[0].shr(32) == 1)
    assert(f.kinds[1] == 8 && f.imm[1] == -416 && f.variant[1].shr(32) == 102)
    assert(f.kinds[2] == 7 && f.imm[2] == -416 && f.variant[2].bit_and(2147483647) == 100)
    assert(f.kinds[3] == 7 && f.imm[3] == -328 && f.variant[3].shr(32) == 1)
    batch.places.nodes[0] = batch.places.nodes[0].bit_and(-65536)
    assert(lift.lift_item(&mut f, &mut w, &batch, 0) == 10)
}

@test fn source_reader_rejects_machine_words_and_accepts_literal_payloads() {
    mut code := arm.new(); mut f := mir.new(); sites: []i32 = []
    arm.emit(&mut code, 3596551104)
    assert(!source_reader.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    code.words.clear(); arm.begin_mir(&mut code, true)
    arm.imm(&mut code, 0, 9223372036854775807); arm.end_mir(&mut code)
    assert(source_reader.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(f.raw.len == 0 && f.encoded.len == 0 && f.imm[0] == 9223372036854775807)
    code.words.clear(); arm.emit(&mut code, 0); arm.emit(&mut code, 0)
    mut imports: []i32 = [0]
    assert(!source_reader.lift(&mut f, &code, 0, 0, 0, &imports, 0))
    code.words.clear(); label := arm.label(&mut code); arm.branch(&mut code, label, 1)
    assert(!source_reader.lift(&mut f, &code, 0, 0, 0, &sites, 0))
}
