import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_decode as decode
import ..selfhost.mir_scalar_contract as contract
import ..selfhost.mir_scalar_lower as lower

fn operation(kind: i32, opcode: i32, ty: i32) -> mir.Function {
    var f := mir.new(); op := mir.add(&mut f, kind)
    f.opcodes[op] = opcode; f.types[op] = ty; f.dst[op] = 4; f.a[op] = 1
    if kind == 4 || kind == 5 { f.b[op] = 2 }
    if opcode == 17 || opcode == 18 { f.c[op] = 3 }
    if kind == 5 { f.dst[op] = -1; f.flags[op] = 2 }
    if kind == 6 { f.a[op] = -1; f.flags[op] = 1; f.imm[op] = 11 }
    if kind == 3 { if opcode == 3 { f.aux[op] = 16; f.imm[op] = 305397760 } else { f.aux[op] = 7 + 15 * 64 } }
    f.reads[op] = mir.variable_bit(f.a[op]).bit_or(mir.variable_bit(f.b[op])).bit_or(mir.variable_bit(f.c[op]))
    f.writes[op] = mir.variable_bit(f.dst[op]); f.effects[op] = contract.expected_effects(kind, opcode); f
}
fn check(f: &mir.Function) {
    assert(contract.can_emit(&f, 0)); var code := arm.new(); assert(lower.emit(&mut code, &f, 0))
    assert(code.words.len >= 1 && code.words.len <= 2)
}
@test fn scalar_shapes_cover_both_widths_and_the_shared_vocabulary() {
    for ty in 1..3 {
        for opcode in 1..19 {
            f := operation(4, opcode, ty)
            if ty == 1 && (opcode == 4 || opcode == 5) { assert(!contract.can_emit(&f, 0)) }
            else { check(&f) }
        }
        for opcode in 1..4 { f := operation(3, opcode, ty); check(&f) }
        for opcode in [1, 2, 8, 11] { f := operation(5, opcode, ty); check(&f) }
        f := operation(6, 0, ty); check(&f)
    }
}
@test fn scalar_contract_rejects_exact_field_type_mask_and_flag_mutations() {
    for field in 0..16 {
        var f := operation(4, 1, 2)
        if field == 0 { f.dst[0] = 31 }
        if field == 1 { f.a[0] = 31 }
        if field == 2 { f.b[0] = 32 }
        if field == 3 { f.c[0] = 3 }
        if field == 4 { f.types[0] = 3 }
        if field == 5 { f.reads[0] = 0 }
        if field == 6 { f.writes[0] = 0 }
        if field == 7 { f.flags[0] = 1 }
        if field == 8 { f.effects[0] = 1 }
        if field == 9 { f.clobbers[0] = 1 }
        if field == 10 { f.abi[0] = 1 }
        if field == 11 { f.place[0] = 0 }
        if field == 12 { f.extensions[0] = 1 }
        if field == 13 { f.targets[0] = 0 }
        if field == 14 { f.reloc_kinds[0] = 0 }
        if field == 15 { f.import_ids[0] = 0 }
        assert(!contract.validate(&f, 0))
    }
    var division := operation(4, 6, 2); division.effects[0] = 0; assert(!contract.validate(&division, 0))
    var logical := operation(4, 9, 2); logical.flags[0] = 2; assert(!contract.validate(&logical, 0))
}
@test fn unsupported_forms_are_refused_before_any_machine_or_metadata_mutation() {
    var code := arm.new(); target := arm.label(&mut code); arm.branch(&mut code, target, 2)
    code.effect_depth = 1; code.effect_epoch = 7; code.mir_capture = true
    before_words := code.words.len; before_labels := code.labels.len; before_reloc := code.at.len
    for selected in 0..7 {
        var f := operation(4, 1, 2)
        if selected == 0 { f.aux[0] = 192 } // Arithmetic ROR.
        if selected == 1 { f.imm[0] = 5000; f.b[0] = -1; f.reads[0] = 2 }
        if selected == 2 { f.imm[0] = 5; f.a[0] = -1; f.b[0] = -1; f.reads[0] = 0 }
        if selected == 3 { f = operation(3, 1, 2); f.aux[0] = 15 + 7 * 64 }
        if selected == 4 { f = operation(3, 3, 1); f.aux[0] = 32 }
        if selected == 5 { f = operation(6, 0, 2); f.imm[0] = 14 }
        if selected == 6 { f = operation(4, 4, 1) }
        assert(!lower.emit(&mut code, &f, 0))
        assert(code.words.len == before_words && code.labels.len == before_labels && code.at.len == before_reloc)
        assert(code.effect_epoch == 7 && code.mir_starts.len == 0 && code.mir_capture)
    }
}
@test fn scalar_encoding_ignores_retained_words_variants_and_provenance() {
    var f := operation(4, 18, 2); var before := arm.new(); assert(lower.emit(&mut before, &f, 0))
    f.variant[0] = 4294967295; f.recipes[0] = 5; f.raw_starts[0] = -1234; f.widths[0] = 99
    f.raw.push(0); f.modes[0] = 0
    var after := arm.new(); assert(lower.emit(&mut after, &f, 0))
    assert(before.words.len == after.words.len && before.words[0] == after.words[0])
}
@test fn nzcv_bitfields_zr_and_untied_halfword_insert_have_explicit_semantics() {
    var f := operation(4, 1, 1); f.flags[0] = 2; var code := arm.new()
    assert(lower.emit(&mut code, &f, 0)); var decoded := decode.new(); decode.word(&mut decoded, code.words[0], 0)
    assert(decoded.kind == 4 && decoded.flags == 2 && decoded.types == 1 && decoded.dst == 4 && decoded.a == 1 && decoded.b == 2)
    f = operation(3, 3, 2); code = arm.new(); assert(lower.emit(&mut code, &f, 0))
    assert(code.words.len == 2); decode.word(&mut decoded, code.words[0], 0)
    assert(decoded.kind == 2 && decoded.a == 1 && decoded.dst == 4 && decoded.flags == 0)
    f = operation(4, 1, 2); f.a[0] = -1; f.b[0] = -1; f.reads[0] = 0
    code = arm.new(); assert(lower.emit(&mut code, &f, 0)); decode.word(&mut decoded, code.words[0], 0)
    assert(decoded.a == -1 && decoded.b == -1 && decoded.reads == 0 && decoded.dst == 4)
    assert(contract.expected_effects(4, 6) == 1 && contract.expected_effects(4, 7) == 1)
    assert(contract.expected_effects(19, 14) == 1 && contract.expected_effects(19, 15) == 1)
    assert(contract.expected_effects(99, 0) == 255)
}
fn main() {}
