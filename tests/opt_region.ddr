import ..selfhost.opt_region as region
import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_verify as verify
import ..selfhost.opt_alloc as alloc
import ..selfhost.opt_emit as emit
import ..selfhost.arm64 as arm
import ..selfhost.lexer

fn build(r: &mut region.Region, w: &mut region.Workspace, source: string, types: &[]i32, mutable: &[]bool) -> bool {
    t := lexer.scan(source, false); var names: []string = []; var positions: []i32 = []
    for capture in 0..types.len { names.push(t.texts[capture]); positions.push(capture) }
    region.build_into(&mut r, &mut w, &t, types.len, t.kinds.len - 2, &names, &types, &mutable, &positions, true)
}
@test fn region_uses_ordinary_immutable_params_and_source_mutable_let_copies() {
    source := "limit sum i for i in i..limit{var hidden:=i;sum=sum+hidden}"
    t := lexer.scan(source, false); names: []string = ["limit", "sum", "i"]; types: []i32 = [1, 1, 1]
    mutable: []bool = [false, true, true]; positions: []i32 = [0, 1, 2]
    var f := ir.new()
    assert(parse.parse_region(&mut f, &t, 3, t.kinds.len - 2, &names, &types, &mutable, &positions))
    assert(verify.validate(&f, false) && f.params == 3 && f.ret == 0)
    var item := f.nodes.left[f.root]
    for capture in 0..3 {
        assert(!f.local_mutable[capture] && f.local_param[capture] == capture)
        assert(f.local_names[capture] != names[capture] && f.local_names[capture][0] == 36)
        assert(f.local_names[3 + capture] == names[capture] && f.local_mutable[3 + capture] == mutable[capture] && f.local_param[3 + capture] == -1)
        assert(f.nodes.kinds[item] == 11 && f.nodes.locals[item] == 3 + capture)
        item = f.nodes.next[item]
    }
    assert(f.nodes.kinds[item] == 19 && f.local_names[f.nodes.locals[item]] == "i" && f.nodes.next[item] == -1)
    var r := region.new(); var w := region.workspace()
    assert(build(&mut r, &mut w, source, &types, &mutable))
    assert(region.status(&r) == 2 && region.import_count(&r) == 3 && region.source_local_count(&r) == 2)
    assert(region.import_name(&r, 2) == "i" && region.import_mutable(&r, 2) && region.import_at(&r, 2) == 2)
    assert(region.source_local_name(&r, 0) == "i" && region.source_local_name(&r, 1) == "hidden")
    for local in 0..region.source_local_count(&r) {
        at := region.source_local_at(&r, local)
        assert(at >= 3 && t.texts[at] == region.source_local_name(&r, local))
    }
}
@test fn region_refuses_unsupported_or_invalid_sources_before_publication_and_reuses_safely() {
    types: []i32 = [1]; immutable: []bool = [false]; mutable: []bool = [true]
    var r := region.new(); var w := region.workspace()
    for source in [
        "x while x>0{x=x-1}", "x while true{return}", "x while false{if true{return}}",
        "x while true{return x}", "x while true{unknown()}", "x while call(x){}",
        "x while true{unsafe{var n:=1}}", "x while true{var a:[]i64=[]}",
        "x while 1{}", "x for i in false..2{}", "x for i in 0..2{i=1}",
        "x while true{missing=1}", "x while false{var y:=1;y=true}",
        "x while true{};break", "x while true{};while false{}"
    ] {
        assert(!build(&mut r, &mut w, source, &types, &immutable) && region.status(&r) == 1)
        assert(region.import_count(&r) == 0 && region.source_local_count(&r) == 0 && region.required_slots(&w) == 0)
    }
    assert(build(&mut r, &mut w, "x while x>0{x=x-1;continue}", &types, &mutable))
    assert(build(&mut r, &mut w, "x for i in 0..x{if i==2{break}}", &types, &immutable))
    for source in ["x while false{x=x+1}", "x while 1>2{x=x+1}"] {
        assert(build(&mut r, &mut w, source, &types, &mutable) && region.status(&r) == 2)
    }
    two: []i32 = [1, 1]; both: []bool = [true, true]
    assert(!build(&mut r, &mut w, "x x while false{}", &two, &both))
    assert(!build(&mut r, &mut w, "i32 while false{}", &types, &mutable))
    assert(!build(&mut r, &mut w, "hälsa while false{}", &types, &mutable))
    input := lexer.scan("x while x>0{}", false); names: []string = ["x"]; inside: []i32 = [2]
    assert(!region.build_into(&mut r, &mut w, &input, 1, input.kinds.len - 2, &names, &types, &mutable, &inside, true))
    array: []i32 = [20]
    assert(!build(&mut r, &mut w, "x while false{}", &array, &immutable))
}
@test fn region_live_out_liveness_extends_real_definitions_even_when_unused_or_bound_only() {
    t := lexer.scan("bound unused sum for i in 0..bound{var later:=i+1;sum=sum+later}", false)
    names: []string = ["bound", "unused", "sum"]; types: []i32 = [1, 1, 1]; mutable: []bool = [true, true, true]; positions: []i32 = [0, 1, 2]
    var f := ir.new(); assert(parse.parse_region(&mut f, &t, 3, t.kinds.len - 2, &names, &types, &mutable, &positions))
    var plan := alloc.new(); outputs: []i32 = [3, 4, 5]
    alloc.allocate_live_out_into(&mut plan, &f, &outputs)
    for out in outputs {
        assert(plan.first[out] > 0 && plan.last[out] == plan.clock)
        for other in 0..plan.homes.len {
            if other == out || plan.homes[out] < 0 || plan.homes[other] < 0 || plan.first[other] < 0 { continue }
            if plan.first[other] <= plan.last[out] && plan.last[other] >= plan.first[out] { assert(plan.homes[out] != plan.homes[other]) }
        }
    }
}
@test fn region_placement_and_lifecycle_refusals_leave_all_code_fields_untouched() {
    types: []i32 = [1]; mutable: []bool = [true]; slots: []i32 = [620]
    var r := region.new(); var w := region.workspace()
    assert(build(&mut r, &mut w, "x while x>0{x=x-1}", &types, &mutable))
    assert(!region.prepare(&mut w, &r, &slots, 620, 0))
    assert(!region.prepare(&mut w, &r, &slots, 65535, 0))
    assert(!region.prepare(&mut w, &r, &slots, 65534, 0))
    settings := emit.options()
    for platform in 0..4 {
        var code := arm.new_for(platform); overflow := arm.label(&mut code); zero := arm.label(&mut code); bounds := arm.label(&mut code)
        arm.imm(&mut code, 0, 123); arm.branch(&mut code, overflow, 0)
        marker := code.words[0]; branch := code.words[1]; relocation := code.at[0]
        for refusal in 0..5 {
            assert(region.prepare(&mut w, &r, &slots, 621, platform))
            required := region.required_slots(&w); assert(required > 621 && region.first_slot(&w) == 621)
            words := code.words.len; labels := code.labels.len; relocations := code.at.len; epoch := code.effect_epoch
            if refusal == 0 { assert(!region.emit_prepared(&mut w, &mut code, &r, 622, required, overflow, zero, bounds, &settings)) }
            else if refusal == 1 { assert(!region.emit_prepared(&mut w, &mut code, &r, 621, required - 1, overflow, zero, bounds, &settings)) }
            else if refusal == 2 { assert(!region.emit_prepared(&mut w, &mut code, &r, 621, required, -1, zero, bounds, &settings)) }
            else if refusal == 3 {
                var other := region.new(); var other_work := region.workspace()
                assert(build(&mut other, &mut other_work, "x while x>1{x=x-1}", &types, &mutable))
                assert(!region.emit_prepared(&mut w, &mut code, &other, 621, required, overflow, zero, bounds, &settings))
            } else {
                region.reset(&mut r)
                assert(!region.emit_prepared(&mut w, &mut code, &r, 621, required, overflow, zero, bounds, &settings))
                assert(build(&mut r, &mut w, "x while x>0{x=x-1}", &types, &mutable))
            }
            assert(code.words.len == words && code.words[0] == marker && code.words[1] == branch && code.labels.len == labels && code.at.len == relocations)
            assert(code.at[0] == relocation && code.target.len == relocations && code.kinds.len == relocations && code.target[0] == overflow && code.kinds[0] == 0)
            for label in code.labels { assert(label == -1) }
            assert(code.effect_epoch == epoch && code.effect_depth == 0 && code.virtual_words == 0 && code.virtual_labels == 0 && !code.profile && code.platform == platform)
        }
        assert(region.prepare(&mut w, &r, &slots, 621, platform))
        required := region.required_slots(&w)
        assert(region.emit_prepared(&mut w, &mut code, &r, 621, required, overflow, zero, bounds, &settings))
        before := code.words.len
        assert(!region.emit_prepared(&mut w, &mut code, &r, 621, required, overflow, zero, bounds, &settings) && code.words.len == before)
    }
}

@test fn region_source_and_model_budgets_refuse_then_reuse_without_publishing() {
    types: []i32 = [1]; mutable: []bool = [true]
    var r := region.new(); var w := region.workspace()
    var tokens := "x while false{"
    for i in 0..4100 { tokens = tokens + ";" }
    assert(!build(&mut r, &mut w, tokens + "}", &types, &mutable) && region.budget_exhausted(&r))
    var nodes := "x while x>0{"
    for i in 0..550 { nodes = nodes + "x=x+1;" }
    assert(!build(&mut r, &mut w, nodes + "break}", &types, &mutable) && region.budget_exhausted(&r))
    var locals := "x while false{"
    for i in 0..256 { locals = locals + "var v" + i.str() + ":=1;" }
    assert(!build(&mut r, &mut w, locals + "}", &types, &mutable) && region.budget_exhausted(&r))
    var nested := "x while "
    for i in 0..80 { nested = nested + "(" }
    nested = nested + "x>0"
    for i in 0..80 { nested = nested + ")" }
    assert(!build(&mut r, &mut w, nested + "{}", &types, &mutable) && region.budget_exhausted(&r))
    assert(build(&mut r, &mut w, "x while x>0{x=x-1}", &types, &mutable) && !region.budget_exhausted(&r))
}
