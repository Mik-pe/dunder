import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_pass as pass
import ..selfhost.opt_verify as verify
import ..selfhost.lexer

fn body(source: string, ret: i32) -> ir.Function {
    input := lexer.scan(source, false)
    names: []string = []; types: []i32 = []; positions: []i32 = []
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 0, input.kinds.len - 2, &names, &types, &positions, ret))
    f
}
fn array_body(source: string, ty: i32, ret: i32) -> ir.Function {
    input := lexer.scan("values " + source, false)
    names: []string = ["values"]; types: []i32 = [ty]; positions: []i32 = [0]
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 1, input.kinds.len - 2, &names, &types, &positions, ret))
    f
}
fn find(f: &ir.Function, kind: i32) -> i32 {
    for i in 0..f.kinds.len { if f.kinds[i] == kind { return i } }
    assert(false); -1
}

@test fn verifier_accepts_parser_order_scopes_and_valid_partial_optimization() {
    for source in ["{42}", "{var x:=1;{x:=2;var y:=x;y=3};x}", "{if true{return 7}else{return 9}}", "{var x:=0;while x<4{x=x+1;if x==2{continue};if x==3{break}};x}", "{var n:=3;for i in 0..n{var x:=i;if i==1{continue};n=n+1};n}"] {
        var f := body(source, 1)
        assert(f.root == 0 && verify.validate(&f, false))
        pass.run(&mut f)
        assert(verify.validate(&f, true))
    }
    for ty in [20, 21] {
        var f := array_body("{var sum:i64=0;for i in 0..values.len{sum=sum+values[i]};sum}", ty, 2)
        assert(verify.validate(&f, false))
        pass.run(&mut f)
        assert(verify.validate(&f, true))
    }
    var f := array_body("{for i in 0..values.len{values[i]=values[i]+1};return}", 21, 0)
    assert(verify.validate(&f, false))
    pass.run(&mut f)
    assert(verify.validate(&f, true))
    // Parser block depth and graph depth differ. Fifty accepted loops have
    // roughly twice as many graph levels; the verifier must accept them.
    var source := "{"
    for i in 0..50 { source = source + "for iteration" + i.str() + " in 0..1{" }
    for i in 0..51 { source = source + "}" }
    deep := body(source, 0)
    assert(verify.validate(&deep, false))
}

@test fn malformed_storage_and_metadata_are_rejected_before_dereferencing() {
    original := body("{var x:=1;x+2}", 1)
    for mode in 0..11 {
        var f := original
        if mode == 0 { removed := f.types.pop() }
        if mode == 1 { removed := f.local_param.pop() }
        if mode == 2 { f.root = f.kinds.len }
        if mode == 3 { f.left[f.root] = -2 }
        if mode == 4 { f.right[find(&f, 3)] = f.kinds.len }
        if mode == 5 { f.locals[find(&f, 2)] = f.local_types.len }
        if mode == 6 { f.effects[f.root] = 32 }
        if mode == 7 { f.proofs[f.root] = 8 }
        if mode == 8 { f.starts[0] = -1 }
        if mode == 9 { f.local_types[0] = 21 }
        if mode == 10 { f.local_param[0] = 0 }
        assert(!verify.validate(&f, false))
    }
    original_array := array_body("{values[0]}", 20, 2)
    for mode in 0..4 {
        var f := original_array
        if mode == 0 { f.params = 0 }
        if mode == 1 { f.local_param[0] = 1 }
        if mode == 2 { f.local_mutable[0] = true }
        if mode == 3 { f.local_names[0] = "" }
        assert(!verify.validate(&f, false))
    }
}

@test fn reachable_cycles_sharing_and_wrong_roles_are_rejected_but_detached_nodes_are_allowed() {
    original := body("{1+2}", 1)
    for mode in 0..5 {
        var f := original
        value := find(&f, 3)
        if mode == 0 { f.left[f.root] = f.root }
        if mode == 1 { f.right[value] = f.left[value] }
        if mode == 2 { f.next[f.left[f.root]] = f.left[f.root] }
        if mode == 3 { f.left[value] = f.root }
        if mode == 4 { f.next[f.left[value]] = value }
        assert(!verify.validate(&f, false))
    }
    var f := body("{if true{return 7}else{return 9}}", 1)
    before := f.kinds.len
    pass.run(&mut f)
    assert(f.kinds.len == before && verify.validate(&f, true))
    // The discarded else block is not required to be owned by the root.
    var unseen := false
    for i in 0..f.kinds.len { if f.kinds[i] == 1 && f.values[i] == 9 { unseen = true } }
    assert(unseen)
}

@test fn verifier_checks_typed_operations_effect_unions_and_only_legal_proof_sites() {
    original := body("{var x:=1;x=x+2;x}", 1)
    for mode in 0..8 {
        var f := original
        value := find(&f, 3); set := find(&f, 12); constant := find(&f, 1)
        if mode == 0 { f.local_mutable[0] = false }
        if mode == 1 { f.types[f.right[value]] = 3 }
        if mode == 2 { f.values[value] = 14 }
        if mode == 3 { f.effects[set] = 4 }
        if mode == 4 { f.values[constant] = 2147483648 }
        if mode == 5 { f.types[constant] = 3; f.values[constant] = 2 }
        if mode == 6 { f.proofs[constant] = 1 }
        if mode == 7 { f.proofs[value] = 2 }
        assert(!verify.validate(&f, true))
    }
    var f := original; value := find(&f, 3); f.proofs[value] = 1
    assert(!verify.validate(&f, false))
    // Placement is the invariant here, not an independent arithmetic witness.
    assert(verify.validate(&f, true))
    for ty in [20, 21] {
        var array := array_body("{values[0]}", ty, 2)
        array.proofs[find(&array, 6)] = 2
        assert(!verify.validate(&array, false))
        assert(verify.validate(&array, true))
    }
    var proven_store := array_body("{values[0]=values[1]+1;return}", 21, 0)
    proven_store.proofs[find(&proven_store, 18)] = 2
    assert(!verify.validate(&proven_store, false))
    assert(verify.validate(&proven_store, true))
    original_store := array_body("{values[0]=values[1]+1;return}", 21, 0)
    for mode in 0..4 {
        var array := original_store; store := find(&array, 18)
        if mode == 0 { array.effects[store] = 1 }
        if mode == 1 { array.local_types[0] = 20 }
        if mode == 2 { array.types[array.left[store]] = 2 }
        if mode == 3 { array.proofs[store] = 1 }
        assert(!verify.validate(&array, true))
    }
}

@test fn declaration_dominance_loop_scope_and_return_coverage_are_model_invariants() {
    var f := body("{var x:=1;x}", 1)
    initializer := f.left[find(&f, 11)]
    f.kinds[initializer] = 2; f.locals[initializer] = 0; f.values[initializer] = 0
    assert(!verify.validate(&f, false))
    f = body("{var x:=1;var y:=2;y}", 1)
    var count := 0
    for i in 0..f.kinds.len {
        if f.kinds[i] == 11 { count = count + 1; if count == 2 { f.locals[i] = 0 } }
    }
    assert(!verify.validate(&f, false))
    f = body("{{x:=1};42}", 1)
    returned := f.left[find(&f, 15)]
    f.kinds[returned] = 2; f.locals[returned] = 0; f.values[returned] = 0
    assert(!verify.validate(&f, false))
    f = body("{42}", 1); f.left[f.root] = -1
    assert(!verify.validate(&f, false))
    f = body("{return}", 0); f.kinds[find(&f, 15)] = 16
    assert(!verify.validate(&f, false))

    original := body("{var n:=3;for i in 0..n{var x:=i;x=x+1};n}", 1)
    for mode in 0..3 {
        f = original; loop := find(&f, 19); iterator := f.locals[loop]
        if mode == 0 {
            bound := f.left[loop]; f.kinds[bound] = 2; f.locals[bound] = iterator; f.values[bound] = 0
        }
        if mode == 1 { f.local_mutable[iterator] = true }
        if mode == 2 { f.locals[find(&f, 12)] = iterator }
        assert(!verify.validate(&f, false))
    }
}

fn equivalent(work: &mut verify.Workspace, f: &ir.Function, optimized: bool, expected: bool) {
    assert(verify.validate(&f, optimized) == expected)
    assert(verify.validate_into(&mut work, &f, optimized) == expected)
}
@test fn reusable_workspace_matches_fresh_validation_across_sizes_phases_and_early_failures() {
    var work := verify.new()
    small := body("{42}", 1)
    shared := array_body("{values[0]}", 20, 2)
    mutable := array_body("{for i in 0..values.len{values[i]=values[i]+1};values[0]}", 21, 2)
    var optimized := array_body("{var i:=0;var sum:i64=0;while i<values.len{sum=sum+values[i];i=i+1};sum}", 20, 2)
    pass.run(&mut optimized)

    // Grow both node flags and local/scope storage, then repeatedly validate
    // much smaller models without shrinking or copying the workspace arrays.
    var source := "{var total:=0;"
    for i in 0..180 { source = source + "entry" + i.str() + ":=" + i.str() + ";" }
    source = source + "for iteration in 0..2{"
    for i in 0..200 { source = source + "total=total+1;" }
    source = source + "};total}"
    large := body(source, 1)
    assert(large.kinds.len > 1000 && large.local_types.len > 180)
    var optimized_large := large
    pass.run(&mut optimized_large)

    // These failures stop at different phases. The sharing failure leaves
    // entered scopes; the self-initializer must still see its local inactive
    // even immediately after an array parameter used the same local ID.
    var broken_tree := body("{var x:=1;var y:=2;x+y}", 1)
    expression := find(&broken_tree, 3)
    broken_tree.right[expression] = broken_tree.left[expression]
    var self_read := body("{var x:=1;x}", 1)
    initializer := self_read.left[find(&self_read, 11)]
    self_read.kinds[initializer] = 2; self_read.locals[initializer] = 0; self_read.values[initializer] = 0
    var broken_shape := large; removed := broken_shape.types.pop()
    var broken_metadata := large; broken_metadata.left[broken_metadata.root] = large.kinds.len
    var broken_effects := mutable; broken_effects.effects[find(&broken_effects, 18)] = 1
    var unsupported := ir.new()

    for round in 0..4 {
        equivalent(&mut work, &large, false, true)
        equivalent(&mut work, &broken_tree, false, false)
        equivalent(&mut work, &small, false, true)
        equivalent(&mut work, &shared, false, true)
        equivalent(&mut work, &self_read, false, false)
        equivalent(&mut work, &broken_shape, false, false)
        equivalent(&mut work, &unsupported, false, false)
        equivalent(&mut work, &optimized, false, false)
        equivalent(&mut work, &optimized, true, true)
        equivalent(&mut work, &mutable, false, true)
        equivalent(&mut work, &broken_effects, true, false)
        equivalent(&mut work, &broken_metadata, false, false)
        equivalent(&mut work, &optimized_large, true, true)
        equivalent(&mut work, &small, false, true)
    }
}
