import ..selfhost.opt.opt_ir as ir
import support.typed_fixture as fixture
import ..selfhost.opt.opt_pass as pass
import ..selfhost.opt.opt_verify as verify
import ..selfhost.frontend.lexer

fn body(source: string, ret: i32) -> ir.Function {
    input := lexer.scan(source, false)
    names: []string = []; types: []i32 = []; positions: []i32 = []
    mut f := ir.new()
    assert(fixture.body(&mut f, &input, 0, input.kinds.len - 2, &names, &types, &positions, ret))
    f
}
fn array_body(source: string, ty: i32, ret: i32) -> ir.Function {
    input := lexer.scan("values " + source, false)
    names: []string = ["values"]; types: []i32 = [ty]; positions: []i32 = [0]
    mut f := ir.new()
    assert(fixture.body(&mut f, &input, 1, input.kinds.len - 2, &names, &types, &positions, ret))
    f
}
fn find(f: &ir.Function, kind: i32) -> i32 {
    for i in 0..f.nodes.kinds.len { if f.nodes.kinds[i] == kind { return i } }
    assert(false); -1
}

@test fn verifier_accepts_parser_order_scopes_and_valid_partial_optimization() {
    for source in ["{42}", "{mut x:=1;{x:=2;mut y:=x;y=3};x}", "{if true{return 7}else{return 9}}", "{mut x:=0;while x<4{x=x+1;if x==2{continue};if x==3{break}};x}", "{mut n:=3;for i in 0..n{mut x:=i;if i==1{continue};n=n+1};n}"] {
        mut f := body(source, 1)
        assert(f.root == 0 && verify.validate(&f, false))
        pass.run(&mut f)
        assert(verify.validate(&f, true))
    }
    for ty in [20, 21] {
        mut f := array_body("{mut sum:i64=0;for i in 0..values.len{sum=sum+values[i]};sum}", ty, 2)
        assert(verify.validate(&f, false))
        pass.run(&mut f)
        assert(verify.validate(&f, true))
    }
    mut f := array_body("{for i in 0..values.len{values[i]=values[i]+1};return}", 21, 0)
    assert(verify.validate(&f, false))
    pass.run(&mut f)
    assert(verify.validate(&f, true))
    mut source := "{"
    for i in 0..50 { source = source + "for iteration" + i.str() + " in 0..1{" }
    for i in 0..51 { source = source + "}" }
    deep := body(source, 0)
    assert(verify.validate(&deep, false))
}

@test fn malformed_storage_and_metadata_are_rejected_before_dereferencing() {
    original := body("{mut x:=1;x+2}", 1)
    for mode in 0..11 {
        mut f := original.clone()
        if mode == 0 { removed := f.nodes.types.pop() }
        if mode == 1 { removed := f.local_param.pop() }
        if mode == 2 { f.root = f.nodes.kinds.len }
        if mode == 3 { f.nodes.left[f.root] = -2 }
        if mode == 4 { f.nodes.right[find(&f, 3)] = f.nodes.kinds.len }
        if mode == 5 { f.nodes.locals[find(&f, 2)] = f.local_types.len }
        if mode == 6 { f.nodes.effects[f.root] = 32 }
        if mode == 7 { f.nodes.proofs[f.root] = 8 }
        if mode == 8 { f.nodes.starts[0] = -1 }
        if mode == 9 { f.local_types[0] = 21 }
        if mode == 10 { f.local_param[0] = 0 }
        assert(!verify.validate(&f, false))
    }
    original_array := array_body("{values[0]}", 20, 2)
    for mode in 0..4 {
        mut f := original_array.clone()
        if mode == 0 { f.params = 0 }
        if mode == 1 { f.local_param[0] = 1 }
        if mode == 2 { f.local_mutable[0] = true }
        if mode == 3 { f.local_names[0] = "" }
        assert(!verify.validate(&f, false))
    }
}

@test fn reachable_cycles_sharing_and_wrong_roles_are_rejected_but_detached_nodes_are_allowed() {
    original := body("{1+2}", 1)
    for mode in 0..5 {
        mut f := original.clone()
        value := find(&f, 3)
        if mode == 0 { f.nodes.left[f.root] = f.root }
        if mode == 1 { f.nodes.right[value] = f.nodes.left[value] }
        if mode == 2 { f.nodes.next[f.nodes.left[f.root]] = f.nodes.left[f.root] }
        if mode == 3 { f.nodes.left[value] = f.root }
        if mode == 4 { f.nodes.next[f.nodes.left[value]] = value }
        assert(!verify.validate(&f, false))
    }
    mut f := body("{if true{return 7}else{return 9}}", 1)
    before := f.nodes.kinds.len
    pass.run(&mut f)
    assert(f.nodes.kinds.len == before && verify.validate(&f, true))
    mut unseen := false
    for i in 0..f.nodes.kinds.len { if f.nodes.kinds[i] == 1 && f.nodes.values[i] == 9 { unseen = true } }
    assert(unseen)
}

@test fn verifier_checks_typed_operations_effect_unions_and_only_legal_proof_sites() {
    original := body("{mut x:=1;x=x+2;x}", 1)
    for mode in 0..8 {
        mut f := original.clone()
        value := find(&f, 3); set := find(&f, 12); constant := find(&f, 1)
        if mode == 0 { f.local_mutable[0] = false }
        if mode == 1 { f.nodes.types[f.nodes.right[value]] = 3 }
        if mode == 2 { f.nodes.values[value] = 14 }
        if mode == 3 { f.nodes.effects[set] = 4 }
        if mode == 4 { f.nodes.values[constant] = 2147483648 }
        if mode == 5 { f.nodes.types[constant] = 3; f.nodes.values[constant] = 2 }
        if mode == 6 { f.nodes.proofs[constant] = 1 }
        if mode == 7 { f.nodes.proofs[value] = 2 }
        assert(!verify.validate(&f, true))
    }
    mut f := original.clone(); value := find(&f, 3); f.nodes.proofs[value] = 1
    assert(!verify.validate(&f, false))
    assert(verify.validate(&f, true))
    for ty in [20, 21] {
        mut array := array_body("{values[0]}", ty, 2)
        array.nodes.proofs[find(&array, 6)] = 2
        assert(!verify.validate(&array, false))
        assert(verify.validate(&array, true))
    }
    mut proven_store := array_body("{values[0]=values[1]+1;return}", 21, 0)
    proven_store.nodes.proofs[find(&proven_store, 18)] = 2
    assert(!verify.validate(&proven_store, false))
    assert(verify.validate(&proven_store, true))
    original_store := array_body("{values[0]=values[1]+1;return}", 21, 0)
    for mode in 0..4 {
        mut array := original_store.clone(); store := find(&array, 18)
        if mode == 0 { array.nodes.effects[store] = 1 }
        if mode == 1 { array.local_types[0] = 20 }
        if mode == 2 { array.nodes.types[array.nodes.left[store]] = 2 }
        if mode == 3 { array.nodes.proofs[store] = 1 }
        assert(!verify.validate(&array, true))
    }
}

@test fn declaration_dominance_loop_scope_and_return_coverage_are_model_invariants() {
    mut f := body("{mut x:=1;x}", 1)
    initializer := f.nodes.left[find(&f, 11)]
    f.nodes.kinds[initializer] = 2; f.nodes.locals[initializer] = 0; f.nodes.values[initializer] = 0
    assert(!verify.validate(&f, false))
    f = body("{mut x:=1;mut y:=2;y}", 1)
    mut count := 0
    for i in 0..f.nodes.kinds.len {
        if f.nodes.kinds[i] == 11 { count = count + 1; if count == 2 { f.nodes.locals[i] = 0 } }
    }
    assert(!verify.validate(&f, false))
    f = body("{{x:=1};42}", 1)
    returned := f.nodes.left[find(&f, 15)]
    f.nodes.kinds[returned] = 2; f.nodes.locals[returned] = 0; f.nodes.values[returned] = 0
    assert(!verify.validate(&f, false))
    f = body("{42}", 1); f.nodes.left[f.root] = -1
    assert(!verify.validate(&f, false))
    f = body("{return}", 0); f.nodes.kinds[find(&f, 15)] = 16
    assert(!verify.validate(&f, false))

    original := body("{mut n:=3;for i in 0..n{mut x:=i;x=x+1};n}", 1)
    for mode in 0..3 {
        f = original.clone(); loop := find(&f, 19); iterator := f.nodes.locals[loop]
        if mode == 0 {
            bound := f.nodes.left[loop]; f.nodes.kinds[bound] = 2; f.nodes.locals[bound] = iterator; f.nodes.values[bound] = 0
        }
        if mode == 1 { f.local_mutable[iterator] = true }
        if mode == 2 { f.nodes.locals[find(&f, 12)] = iterator }
        assert(!verify.validate(&f, false))
    }
}

fn equivalent(work: &mut verify.Workspace, f: &ir.Function, optimized: bool, expected: bool) {
    assert(verify.validate(&f, optimized) == expected)
    assert(verify.validate_into(&mut work, &f, optimized) == expected)
}
@test fn reusable_workspace_matches_fresh_validation_across_sizes_phases_and_early_failures() {
    mut work := verify.new()
    small := body("{42}", 1)
    shared := array_body("{values[0]}", 20, 2)
    mutable := array_body("{for i in 0..values.len{values[i]=values[i]+1};values[0]}", 21, 2)
    mut optimized := array_body("{mut i:=0;mut sum:i64=0;while i<values.len{sum=sum+values[i];i=i+1};sum}", 20, 2)
    pass.run(&mut optimized)

    mut source := "{mut total:=0;"
    for i in 0..180 { source = source + "entry" + i.str() + ":=" + i.str() + ";" }
    source = source + "for iteration in 0..2{"
    for i in 0..200 { source = source + "total=total+1;" }
    source = source + "};total}"
    large := body(source, 1)
    assert(large.nodes.kinds.len > 1000 && large.local_types.len > 180)
    mut optimized_large := large.clone()
    pass.run(&mut optimized_large)

    mut broken_tree := body("{mut x:=1;mut y:=2;x+y}", 1)
    expression := find(&broken_tree, 3)
    broken_tree.nodes.right[expression] = broken_tree.nodes.left[expression]
    mut self_read := body("{mut x:=1;x}", 1)
    initializer := self_read.nodes.left[find(&self_read, 11)]
    self_read.nodes.kinds[initializer] = 2; self_read.nodes.locals[initializer] = 0; self_read.nodes.values[initializer] = 0
    mut broken_shape := large.clone(); removed := broken_shape.nodes.types.pop()
    mut broken_metadata := large.clone(); broken_metadata.nodes.left[broken_metadata.root] = large.nodes.kinds.len
    mut broken_effects := mutable.clone(); broken_effects.nodes.effects[find(&broken_effects, 18)] = 1
    mut unsupported := ir.new()

    for round in 0..4 {
        equivalent(&mut work, &large, false, true)
        equivalent(&mut work, &broken_tree, false, false)
        equivalent(&mut work, &small, false, true)
        equivalent(&mut work, &shared, false, true)
        equivalent(&mut work, &self_read, false, false)
        equivalent(&mut work, &broken_shape, false, false)
        equivalent(&mut work, &unsupported, false, false)
        equivalent(&mut work, &optimized, false, false)
        equivalent(&mut work, &optimized, true, true)
        equivalent(&mut work, &mutable, false, true)
        equivalent(&mut work, &broken_effects, true, false)
        equivalent(&mut work, &broken_metadata, false, false)
        equivalent(&mut work, &optimized_large, true, true)
        equivalent(&mut work, &small, false, true)
    }
}
