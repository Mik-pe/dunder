import ..selfhost.opt_ir as ir
import ..selfhost.opt_parse as parse
import ..selfhost.opt_range as ranges
import ..selfhost.opt_verify as verify
import ..selfhost.lexer

fn body(source: string, ret: i32) -> ir.Function {
    input := lexer.scan("values left right wide " + source, false)
    names: []string = ["values", "left", "right", "wide"]
    types: []i32 = [21, 1, 1, 2]; positions: []i32 = [0, 1, 2, 3]
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 4, input.kinds.len - 2, &names, &types, &positions, ret))
    assert(verify.validate(&f, false)); f
}
fn expect(work: &mut ranges.Workspace, f: &mut ir.Function, arithmetic: i32, bounds: i32) {
    old_proofs := f.nodes.proofs; old_values := f.nodes.values; old_kinds := f.nodes.kinds; old_rewrites := f.rewrites
    assert(ranges.analyze_into(&mut work, &f) && ranges.status(&work) == 1)
    assert(ranges.arithmetic_count(&work) == arithmetic)
    assert(ranges.read_count(&work) + ranges.store_count(&work) == bounds)
    var counted := 0; var bounded := 0
    assert(ranges.proof_mask(&work, -1) == 0 && ranges.proof_mask(&work, f.nodes.kinds.len) == 0)
    for node in 0..f.nodes.kinds.len {
        assert(f.nodes.proofs[node] == old_proofs[node] && f.nodes.values[node] == old_values[node] && f.nodes.kinds[node] == old_kinds[node])
        mask := ranges.proof_mask(&work, node)
        assert(mask >= 0 && mask <= 2 && ranges.produced(&work, node) == (mask.bit_and(2) != 0))
        if mask.bit_and(1) != 0 {
            counted = counted + 1
            assert(f.nodes.types[node] == 1 && old_proofs[node].bit_and(1) == 0)
            assert((f.nodes.kinds[node] == 3 && f.nodes.values[node] >= 1 && f.nodes.values[node] <= 3) ||
                (f.nodes.kinds[node] == 4 && f.nodes.values[node] == 1))
        }
        if mask.bit_and(2) != 0 { bounded = bounded + 1 }
    }
    assert(counted == arithmetic && bounded == bounds)
    ranges.apply(&mut work, &mut f)
    assert(ranges.status(&work) == 2 && verify.validate(&f, true))
    assert(f.rewrites == old_rewrites + arithmetic + bounds)
    for node in 0..f.nodes.kinds.len {
        assert(f.nodes.proofs[node] == old_proofs[node].bit_or(ranges.proof_mask(&work, node)))
        assert(f.nodes.values[node] == old_values[node] && f.nodes.kinds[node] == old_kinds[node])
    }
}

@test fn raw_i32_intervals_prove_safe_add_sub_multiply_and_negate() {
    sources := [
        "{left+0}", "{0+left}", "{left-0}", "{left*0}", "{left*1}",
        "{if left>=0&&left<=100&&right>=-3&&right<=5{return left+right}else{return 0}}",
        "{if left>=-100&&left<=100&&right>=-4&&right<=8{return left-right}else{return 0}}",
        "{if left>=-100&&left<=100&&right>=-100&&right<=100{return left*right}else{return 0}}",
        "{if left>=-46340&&left<=46340{return left*left}else{return 0}}",
        "{if left>=-2147483647{return -left}else{return 0}}",
        "{if left<=2147483646{return left+1}else{return 0}}",
        "{if left>=-2147483647{return left-1}else{return 0}}",
        "{if left>=-1073741824&&left<=1073741823{return left*2}else{return 0}}",
        "{if left>=-2147483647{return left*(-1)}else{return 0}}",
        "{if left>=0&&left<=1{return left*(-2147483648)}else{return 0}}",
    ]
    var work := ranges.new()
    for source in sources { var f := body(source, 1); expect(&mut work, &mut f, 1, 0) }
}

@test fn clipping_never_certifies_a_partially_or_wholly_overflowing_operation() {
    sources := [
        "{left+1}", "{left-1}", "{-left}", "{left*(-1)}", "{left*left}",
        "{left+right}", "{left-right}", "{left*right}",
        "{2147483647+1}", "{-2147483648-1}", "{var minimum:=-2147483648;-minimum}",
        "{if left>=-46341&&left<=46341{return left*left}else{return 0}}",
        "{if left>=-1073741824&&left<=1073741824{return left*2}else{return 0}}",
        "{if left>=0{return left+1}else{return 0}}", "{if left<=0{return -left}else{return 0}}",
        "{if left>=1{return left*(-2147483648)}else{return 0}}",
        "{if left>=-1&&left<=0{return left*(-2147483648)}else{return 0}}",
    ]
    var work := ranges.new()
    for source in sources { var f := body(source, 1); expect(&mut work, &mut f, 0, 0) }
}

@test fn child_normal_continuations_can_prove_parents_without_certifying_the_child() {
    var work := ranges.new()
    for source in ["{(left+1)-1}", "{(left-1)+1}", "{-(left+1)}", "{(left*2)*0}"] {
        var f := body(source, 1)
        expect(&mut work, &mut f, 1, 0)
        for node in 0..f.nodes.kinds.len {
            if f.nodes.kinds[node] == 3 || f.nodes.kinds[node] == 4 {
                child := f.nodes.left[node]
                if child >= 0 && f.nodes.kinds[child] == 3 {
                    assert(ranges.proof_mask(&work, node) == 1 && ranges.proof_mask(&work, child) == 0)
                }
            }
        }
    }
    var f := body("{if left<2147483647{return (left+1)-1}else{return 0}}", 1)
    expect(&mut work, &mut f, 2, 0)
    f = body("{if left>=-46340&&left<=46340{return -(left*left)}else{return 0}}", 1)
    expect(&mut work, &mut f, 2, 0)
}

@test fn overflowing_children_stop_binary_and_unary_analysis_before_parent_raw_math() {
    var work := ranges.new()
    for source in [
        "{(2147483647*2147483647)*0}", "{0*(2147483647*2147483647)}",
        "{-(2147483647*2147483647)}", "{(2147483647*2147483647)+1}",
        "{1-(2147483647*2147483647)}", "{(2147483647*2147483647)*(2147483647*2147483647)}",
        "{(-2147483648*(-2147483648))*0}", "{(-2147483648*2147483647)*2147483647}",
        "{-(-2147483648*2147483647)}", "{(2147483647+1)*(-2147483648)}",
        "{(-2147483648-1)*(-2147483648)}",
        "{if left==2147483647{return (left*left)*0}else{return 0}}",
        "{if left==-2147483648{return (left*left)*0}else{return 0}}",
        "{if left>=46341&&left<=50000{return (left*left)*0}else{return 0}}",
    ] {
        var f := body(source, 1); expect(&mut work, &mut f, 0, 0)
    }
}

@test fn replay_checks_all_iterations_and_source_latches_without_annotating_implicit_latches() {
    var work := ranges.new()
    var f := body("{var cursor:=0;while cursor<10{cursor=cursor+1};cursor}", 1)
    expect(&mut work, &mut f, 1, 0)
    f = body("{var cursor:=2147483646;while cursor>=0{cursor=cursor+1};cursor}", 1)
    expect(&mut work, &mut f, 0, 0)
    f = body("{var cursor:=-2147483648;while cursor<=0{cursor=cursor-1};cursor}", 1)
    expect(&mut work, &mut f, 0, 0)
    f = body("{var cursor:=0;while cursor<right{if cursor==2{cursor=cursor+1;continue};cursor=cursor+1};cursor}", 1)
    expect(&mut work, &mut f, 2, 0)
    f = body("{for cursor in 1..values.len{item:=values[cursor];var hole:=cursor;while hole>0&&values[hole-1]>item{values[hole]=values[hole-1];hole=hole-1};values[hole]=item};0}", 1)
    expect(&mut work, &mut f, 3, 5)
    f = body("{var a:=0;var b:=values.len-1;while a<b{item:=values[a];values[a]=values[b];values[b]=item;a=a+1;b=b-1};0}", 1)
    expect(&mut work, &mut f, 3, 4)
    f = body("{for cursor in 0..values.len{values[cursor]=values[cursor]+1};0}", 1)
    expect(&mut work, &mut f, 0, 2)
    f = body("{if false&&left+1>0{return 1}else{return 0}}", 1)
    expect(&mut work, &mut f, 0, 0)
}

@test fn no_i64_division_or_remainder_proof_is_created_from_the_i32_domain() {
    var work := ranges.new()
    for source in ["{wide+1}", "{wide-1}", "{wide*wide}", "{-wide}", "{wide/(-1)}", "{wide%(-1)}"] {
        var f := body(source, 2); expect(&mut work, &mut f, 0, 0)
    }
    for source in ["{left/right}", "{left%right}", "{if left>=0&&right>0{return left/right}else{return 0}}", "{if left>=0&&right>0{return left%right}else{return 0}}"] {
        var f := body(source, 1); expect(&mut work, &mut f, 0, 0)
    }
}

@test fn arithmetic_masks_are_transactional_budgeted_single_use_and_do_not_recount_old_bits() {
    var f := body("{if left>=-100&&left<=100&&right>=-10&&right<=10{return (left+right)*(left-right)}else{return 0}}", 1)
    var work := ranges.new()
    assert(ranges.analyze_into(&mut work, &f)); spent := ranges.units(&work)
    assert(ranges.arithmetic_count(&work) == 3)
    for budget in [0, 1, spent / 2, spent - 1] {
        ranges.set_budget(&mut work, budget)
        assert(!ranges.analyze_into(&mut work, &f) && ranges.status(&work) == 3)
        assert(ranges.arithmetic_count(&work) == 0 && ranges.read_count(&work) == 0 && ranges.store_count(&work) == 0)
        for node in 0..f.nodes.kinds.len { assert(ranges.proof_mask(&work, node) == 0 && f.nodes.proofs[node] == 0) }
    }
    ranges.set_budget(&mut work, 131072); expect(&mut work, &mut f, 3, 0)
    assert(ranges.arithmetic_count(&work) == 3 && ranges.status(&work) == 2)
    assert(ranges.analyze_into(&mut work, &f) && ranges.arithmetic_count(&work) == 0)
    for node in 0..f.nodes.kinds.len { assert(ranges.proof_mask(&work, node) == 0) }
    ranges.apply(&mut work, &mut f)
    for round in 0..3 {
        f = body("{left+1}", 1); expect(&mut work, &mut f, 0, 0)
        f = body("{left+0}", 1); expect(&mut work, &mut f, 1, 0)
        f = body("{wide+1}", 2); expect(&mut work, &mut f, 0, 0)
    }
}

@test fn scalar_only_and_zero_local_models_have_a_safe_generic_entry_path() {
    var work := ranges.new()
    input := lexer.scan("left {left+0}", false)
    names: []string = ["left"]; types: []i32 = [1]; positions: []i32 = [0]
    var f := ir.new()
    assert(parse.parse(&mut f, &input, 1, input.kinds.len - 2, &names, &types, &positions, 1))
    expect(&mut work, &mut f, 1, 0)
    for source in ["{2147483647+1}", "{-2147483648-1}", "{(2147483647*2147483647)*0}", "{1+2}"] {
        input := lexer.scan(source, false)
        empty_names: []string = []; empty_types: []i32 = []; empty_positions: []i32 = []
        assert(parse.parse(&mut f, &input, 0, input.kinds.len - 2, &empty_names, &empty_types, &empty_positions, 1))
        assert(f.local_types.len == 0)
        var expected := 0; if source == "{1+2}" { expected = 1 }
        expect(&mut work, &mut f, expected, 0)
    }
}
