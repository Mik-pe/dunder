import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_opt as frame
import ..selfhost.mir_memory as memory
import "fixtures/mir-pipeline-reference" as serial
import ..selfhost.mir_pipeline as pipeline

fn model(code: &arm.Code) -> mir.Function {
    none: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &none, 0)); f
}
fn add(code: &mut arm.Code, dst: i32, a: i32, b: i32) {
    arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst))
}
fn loop_code() -> arm.Code {
    var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    arm.emit(&mut code, 3942645791 + 0 * 65536 + 1 * 32); arm.branch(&mut code, done, 12)
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 0); arm.pop(&mut code, 1)
    add(&mut code, 0, 1, 0); arm.store(&mut code, 1, 0)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done); arm.load(&mut code, 1); arm.ret(&mut code); code
}
fn simple() -> arm.Code {
    var code := arm.new(); arm.imm(&mut code, 1, 5); arm.mov(&mut code, 2, 1)
    add(&mut code, 0, 4, 2); arm.emit(&mut code, 3596551104); code
}
fn same_stats(a: &pipeline.Stats, b: &pipeline.Stats) {
    assert(a.operations == b.operations && a.opaque == b.opaque)
    assert(a.optimized == b.optimized && a.promoted == b.promoted && a.removed_loads == b.removed_loads && a.removed_stores == b.removed_stores)
    assert(a.private_memory_ops == b.private_memory_ops && a.analysis_units == b.analysis_units && a.budget_refusals == b.budget_refusals)
    assert(a.ssa_optimized == b.ssa_optimized && a.ssa_cells == b.ssa_cells && a.ssa_values == b.ssa_values && a.ssa_parameters == b.ssa_parameters)
    assert(a.ssa_registers == b.ssa_registers && a.ssa_captures == b.ssa_captures && a.ssa_stack_groups == b.ssa_stack_groups)
    assert(a.ssa_removed_loads == b.ssa_removed_loads && a.ssa_removed_stores == b.ssa_removed_stores && a.ssa_removed_pushes == b.ssa_removed_pushes && a.ssa_removed_pops == b.ssa_removed_pops)
    assert(a.ssa_copies == b.ssa_copies && a.ssa_analysis_units == b.ssa_analysis_units && a.ssa_budget_refusals == b.ssa_budget_refusals)
    assert(a.values_optimized == b.values_optimized && a.value_rewrites == b.value_rewrites && a.value_deleted == b.value_deleted && a.value_immediates == b.value_immediates)
    assert(a.value_analysis_units == b.value_analysis_units && a.value_budget_refusals == b.value_budget_refusals)
}
fn same_status(a: &pipeline.Status, b: &pipeline.Status) {
    assert(a.error == b.error && a.frame_state == b.frame_state && a.value_state == b.value_state); same_stats(&a.stats, &b.stats)
}

fn same(a: &mir.Function, b: &mir.Function) {
    assert(a.valid == b.valid)
    assert(a.verified == b.verified)
    assert(a.optimizable == b.optimizable)
    assert(a.unknown_control == b.unknown_control)
    assert(a.platform == b.platform)
    assert(a.first_word == b.first_word)
    assert(a.first_label == b.first_label)
    assert(a.first_reloc == b.first_reloc)
    assert(a.first_import == b.first_import)
    assert(a.source_words == b.source_words)
    assert(a.source_labels == b.source_labels)
    assert(a.source_relocs == b.source_relocs)
    assert(a.source_imports == b.source_imports)
    assert(a.kinds.len == b.kinds.len); for i in 0..a.kinds.len { assert(a.kinds[i] == b.kinds[i]) }
    assert(a.opcodes.len == b.opcodes.len); for i in 0..a.opcodes.len { assert(a.opcodes[i] == b.opcodes[i]) }
    assert(a.dst.len == b.dst.len); for i in 0..a.dst.len { assert(a.dst[i] == b.dst[i]) }
    assert(a.a.len == b.a.len); for i in 0..a.a.len { assert(a.a[i] == b.a[i]) }
    assert(a.b.len == b.b.len); for i in 0..a.b.len { assert(a.b[i] == b.b[i]) }
    assert(a.c.len == b.c.len); for i in 0..a.c.len { assert(a.c[i] == b.c[i]) }
    assert(a.imm.len == b.imm.len); for i in 0..a.imm.len { assert(a.imm[i] == b.imm[i]) }
    assert(a.aux.len == b.aux.len); for i in 0..a.aux.len { assert(a.aux[i] == b.aux[i]) }
    assert(a.variant.len == b.variant.len); for i in 0..a.variant.len { assert(a.variant[i] == b.variant[i]) }
    assert(a.types.len == b.types.len); for i in 0..a.types.len { assert(a.types[i] == b.types[i]) }
    assert(a.place.len == b.place.len); for i in 0..a.place.len { assert(a.place[i] == b.place[i]) }
    assert(a.extensions.len == b.extensions.len); for i in 0..a.extensions.len { assert(a.extensions[i] == b.extensions[i]) }
    assert(a.effects.len == b.effects.len); for i in 0..a.effects.len { assert(a.effects[i] == b.effects[i]) }
    assert(a.flags.len == b.flags.len); for i in 0..a.flags.len { assert(a.flags[i] == b.flags[i]) }
    assert(a.abi.len == b.abi.len); for i in 0..a.abi.len { assert(a.abi[i] == b.abi[i]) }
    assert(a.reads.len == b.reads.len); for i in 0..a.reads.len { assert(a.reads[i] == b.reads[i]) }
    assert(a.writes.len == b.writes.len); for i in 0..a.writes.len { assert(a.writes[i] == b.writes[i]) }
    assert(a.clobbers.len == b.clobbers.len); for i in 0..a.clobbers.len { assert(a.clobbers[i] == b.clobbers[i]) }
    assert(a.origins.len == b.origins.len); for i in 0..a.origins.len { assert(a.origins[i] == b.origins[i]) }
    assert(a.raw_starts.len == b.raw_starts.len); for i in 0..a.raw_starts.len { assert(a.raw_starts[i] == b.raw_starts[i]) }
    assert(a.widths.len == b.widths.len); for i in 0..a.widths.len { assert(a.widths[i] == b.widths[i]) }
    assert(a.modes.len == b.modes.len); for i in 0..a.modes.len { assert(a.modes[i] == b.modes[i]) }
    assert(a.recipes.len == b.recipes.len); for i in 0..a.recipes.len { assert(a.recipes[i] == b.recipes[i]) }
    assert(a.stack_roles.len == b.stack_roles.len); for i in 0..a.stack_roles.len { assert(a.stack_roles[i] == b.stack_roles[i]) }
    assert(a.targets.len == b.targets.len); for i in 0..a.targets.len { assert(a.targets[i] == b.targets[i]) }
    assert(a.reloc_kinds.len == b.reloc_kinds.len); for i in 0..a.reloc_kinds.len { assert(a.reloc_kinds[i] == b.reloc_kinds[i]) }
    assert(a.import_ids.len == b.import_ids.len); for i in 0..a.import_ids.len { assert(a.import_ids[i] == b.import_ids[i]) }
    assert(a.order.len == b.order.len); for i in 0..a.order.len { assert(a.order[i] == b.order[i]) }
    assert(a.raw.len == b.raw.len); for i in 0..a.raw.len { assert(a.raw[i] == b.raw[i]) }
    assert(a.place_kinds.len == b.place_kinds.len); for i in 0..a.place_kinds.len { assert(a.place_kinds[i] == b.place_kinds[i]) }
    assert(a.place_offsets.len == b.place_offsets.len); for i in 0..a.place_offsets.len { assert(a.place_offsets[i] == b.place_offsets[i]) }
    assert(a.place_widths.len == b.place_widths.len); for i in 0..a.place_widths.len { assert(a.place_widths[i] == b.place_widths[i]) }
    assert(a.place_extensions.len == b.place_extensions.len); for i in 0..a.place_extensions.len { assert(a.place_extensions[i] == b.place_extensions[i]) }
    assert(a.place_escaped.len == b.place_escaped.len); for i in 0..a.place_escaped.len { assert(a.place_escaped[i] == b.place_escaped[i]) }
    assert(a.place_table.len == b.place_table.len); for i in 0..a.place_table.len { assert(a.place_table[i] == b.place_table[i]) }
    assert(a.place_probes == b.place_probes)
    assert(a.block_starts.len == b.block_starts.len); for i in 0..a.block_starts.len { assert(a.block_starts[i] == b.block_starts[i]) }
    assert(a.block_ends.len == b.block_ends.len); for i in 0..a.block_ends.len { assert(a.block_ends[i] == b.block_ends[i]) }
    assert(a.op_blocks.len == b.op_blocks.len); for i in 0..a.op_blocks.len { assert(a.op_blocks[i] == b.op_blocks[i]) }
    assert(a.edge_from.len == b.edge_from.len); for i in 0..a.edge_from.len { assert(a.edge_from[i] == b.edge_from[i]) }
    assert(a.edge_to.len == b.edge_to.len); for i in 0..a.edge_to.len { assert(a.edge_to[i] == b.edge_to[i]) }
    assert(a.edge_kinds.len == b.edge_kinds.len); for i in 0..a.edge_kinds.len { assert(a.edge_kinds[i] == b.edge_kinds[i]) }
    assert(a.edge_starts.len == b.edge_starts.len); for i in 0..a.edge_starts.len { assert(a.edge_starts[i] == b.edge_starts[i]) }
    assert(a.label_ids.len == b.label_ids.len); for i in 0..a.label_ids.len { assert(a.label_ids[i] == b.label_ids[i]) }
    assert(a.label_ops.len == b.label_ops.len); for i in 0..a.label_ops.len { assert(a.label_ops[i] == b.label_ops[i]) }
    assert(a.boundaries.len == b.boundaries.len); for i in 0..a.boundaries.len { assert(a.boundaries[i] == b.boundaries[i]) }
    assert(a.leaders.len == b.leaders.len); for i in 0..a.leaders.len { assert(a.leaders[i] == b.leaders[i]) }
    assert(a.visits == b.visits)
    assert(a.budget_exhausted == b.budget_exhausted)
}
@test fn shared_pipeline_matches_reference_for_every_switch_combination_and_reuses_all_scratch() {
    code := loop_code(); exits := pipeline.no_terminals(); var work := pipeline.new()
    for bits in 0..8 {
        var options := pipeline.options(); options.optimize = bits.bit_and(1) != 0
        options.source_objects = bits.bit_and(2) != 0; options.values = bits.bit_and(4) != 0
        var f := model(&code); var expected := model(&code)
        result := pipeline.run_into(&mut f, &mut work, &options, &exits); original := serial.run(&mut expected, &options, &exits)
        same_status(&result, &original); same(&f, &expected); assert(result.error == 0 && f.verified)
        if options.optimize { assert(result.stats.optimized == 1 && result.stats.promoted == 3) }
        else { assert(result.frame_state == 0 && result.value_state == 0) }
    }
}
@test fn unsupported_frame_does_not_suppress_the_independent_value_stage() {
    code := simple(); options := pipeline.options(); exits := pipeline.no_terminals(); var work := pipeline.new()
    var f := model(&code); var expected := model(&code)
    result := pipeline.run_into(&mut f, &mut work, &options, &exits); original := serial.run(&mut expected, &options, &exits)
    same_status(&result, &original); same(&f, &expected)
    assert(result.error == 0 && result.frame_state == -2 && result.stats.values_optimized == 1 && f.verified)
    assert(result.stats.value_rewrites == 1 && result.stats.value_deleted == 2)
    assert(result.stats.operations == f.order.len && result.stats.operations == 4 && result.stats.opaque == 0)
}
@test fn budget_refusals_leave_verified_baseline_and_publish_the_original_counters() {
    code := loop_code(); var options := pipeline.options(); options.frame_budget = 0; options.value_budget = 0
    exits := pipeline.no_terminals(); var work := pipeline.new(); var f := model(&code); var expected := model(&code)
    result := pipeline.run_into(&mut f, &mut work, &options, &exits); original := serial.run(&mut expected, &options, &exits)
    same_status(&result, &original); same(&f, &expected)
    assert(result.error == 0 && result.frame_state == -3 && result.value_state == -3 && f.verified)
    assert(result.stats.budget_refusals == 1 && result.stats.value_budget_refusals == 1 && result.stats.optimized == 0)
    var raw := model(&code); assert(verify.verify(&mut raw)); same(&f, &raw)
}
@test fn terminal_contract_is_explicit_versioned_and_never_leaks_across_reused_runs() {
    var code := arm.new(); target := arm.label(&mut code); arm.imm(&mut code, 0, 42); arm.branch(&mut code, target, 0)
    options := pipeline.options(); var exits := pipeline.no_terminals(); var work := pipeline.new()
    var f := model(&code); result := pipeline.run_into(&mut f, &mut work, &options, &exits)
    assert(result.error == 0 && result.value_state == -2 && f.modes[0] == 0)
    exits = pipeline.Terminals { version: 1, overflow: target, zero: target, assertion: target, io: target, bounds: target, float_trap: target }
    f = model(&code); var expected := model(&code)
    contracted := pipeline.run_into(&mut f, &mut work, &options, &exits); original := serial.run(&mut expected, &options, &exits)
    same_status(&contracted, &original); same(&f, &expected); assert(contracted.stats.value_deleted == 1 && f.modes[0] == 2)
    exits.version = 0; f = model(&code); raw := pipeline.run_into(&mut f, &mut work, &options, &exits)
    assert(raw.error == 0 && raw.value_state == -2 && raw.stats.value_deleted == 0 && f.modes[0] == 0)
    exits.version = 2; f = model(&code); invalid := pipeline.run_into(&mut f, &mut work, &options, &exits)
    assert(invalid.error == 6 && invalid.value_state == 0 && invalid.stats.value_analysis_units == 0 && f.verified)
    exits.version = 1; exits.bounds = -1; f = model(&code)
    malformed := pipeline.run_into(&mut f, &mut work, &options, &exits)
    assert(malformed.error == 6 && malformed.stats.value_deleted == 0 && f.modes[0] == 0)
}
@test fn initial_verification_is_mandatory_with_optimization_disabled() {
    code := simple(); var options := pipeline.options(); options.optimize = false
    exits := pipeline.no_terminals(); var work := pipeline.new()
    var f := model(&code); var expected := model(&code); f.variant[0] = 0; expected.variant[0] = 0
    result := pipeline.run_into(&mut f, &mut work, &options, &exits); original := serial.run(&mut expected, &options, &exits)
    same_status(&result, &original); same(&f, &expected)
    assert(result.error == 1 && result.frame_state == 0 && result.value_state == 0 && !f.verified)
    assert(result.stats.operations == 0 && result.stats.opaque == 0)
}
@test fn successful_opaque_baseline_counts_every_operation_without_rejecting_source() {
    var code := arm.new(); arm.emit(&mut code, 4294967295); arm.emit(&mut code, 3596551104)
    options := pipeline.options(); exits := pipeline.no_terminals(); var work := pipeline.new()
    var f := model(&code); var expected := model(&code)
    result := pipeline.run_into(&mut f, &mut work, &options, &exits); original := serial.run(&mut expected, &options, &exits)
    same_status(&result, &original); same(&f, &expected)
    assert(result.error == 0 && result.stats.operations == 2 && result.stats.opaque == 1 && f.verified && !f.optimizable)
}
@test fn final_value_budget_rollback_matches_the_previous_pipeline() {
    code := simple(); var options := pipeline.options(); exits := pipeline.no_terminals(); var work := pipeline.new()
    var f := model(&code); first := pipeline.run_into(&mut f, &mut work, &options, &exits)
    assert(first.error == 0 && first.value_state == 2)
    options.value_budget = i32(first.stats.value_analysis_units) - 1
    f = model(&code); var expected := model(&code)
    result := pipeline.run_into(&mut f, &mut work, &options, &exits); original := serial.run(&mut expected, &options, &exits)
    same_status(&result, &original); same(&f, &expected)
    assert(result.error == 0 && result.value_state == -3 && result.stats.values_optimized == 0 && f.verified)
}
