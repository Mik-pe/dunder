import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_liveness as live
import ..selfhost.mir_call_inputs as inputs

fn bit(reg: i32) -> i64 { i64(1).shl(reg) }
fn indirect(target: i32) -> mir.Function {
    var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 1)
    arm.emit(&mut code, 3594452992 + i64(target) * 32)
    arm.ret(&mut code)
    none: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &none, 0) && verify.verify(&mut f)); f
}
fn call_op(f: &mir.Function) -> i32 {
    for op in 0..f.kinds.len { if f.kinds[op] == 14 { return op } }; -1
}

@test fn source_inputs_release_only_non_argument_scratch() {
    f := indirect(17); op := call_op(&f); assert(op >= 0)
    var raw := live.new(); var source := live.new(); context := inputs.trusted_source_inputs_v1()
    assert(live.analyze_into(&mut raw, &f, 4194304))
    assert(live.analyze_with_inputs_into(&mut source, &f, &context, 4194304))
    assert(live.live_in(&raw, 0).bit_and(bit(9)) != 0)
    assert(live.live_in(&source, 0).bit_and(bit(9)) == 0)
    for reg in 0..9 { assert(live.live_in(&source, 0).bit_and(bit(reg)) != 0) }
    for reg in 16..29 { assert(live.live_in(&source, 0).bit_and(bit(reg)) != 0) }
    assert(live.live_in(&source, 0).bit_and(bit(32)) != 0)
    // No new preservation premise: the same original call clobbers and
    // post-call physical demand are used by both analyses.
    assert(f.reads[op] == -1 && f.clobbers[op] == -1 && f.writes[op] == 0)
    assert(live.live_after(&raw, op) == live.live_after(&source, op))
    assert(live.flags_after(&raw, op) == live.flags_after(&source, op))
}

@test fn indirect_target_is_an_input_even_when_it_uses_scratch() {
    f := indirect(9); context := inputs.trusted_source_inputs_v1(); var work := live.new()
    assert(live.analyze_with_inputs_into(&mut work, &f, &context, 4194304))
    assert(live.live_in(&work, 0).bit_and(bit(9)) != 0)
    assert(live.live_in(&work, 0).bit_and(bit(17)) == 0)
}

@test fn raw_context_matches_original_analysis_and_budget_reuse() {
    f := indirect(9); context := inputs.conservative(); var raw := live.new(); var explicit := live.new()
    assert(live.analyze_into(&mut raw, &f, 4194304))
    assert(live.analyze_with_inputs_into(&mut explicit, &f, &context, 4194304))
    assert(live.units(&raw) == live.units(&explicit))
    for block in 0..f.block_starts.len {
        assert(live.live_in(&raw, block) == live.live_in(&explicit, block))
        assert(live.live_out(&raw, block) == live.live_out(&explicit, block))
    }
    limit := live.units(&explicit)
    assert(!live.analyze_with_inputs_into(&mut explicit, &f, &context, limit - 1))
    assert(live.status(&explicit) == -3)
    assert(live.analyze_with_inputs_into(&mut explicit, &f, &context, limit))
    assert(live.units(&explicit) == limit)
}
