import ..selfhost.frontend.compile as compiler
import ..selfhost.frontend.lexer
import std.text as text

fn ownership_test_compile(source: string, platform: i32, enabled: bool, checking: bool) -> compiler.Result {
    none: []i32 = []; mut records := compiler.bindings(); mut config := compiler.configuration()
    config.ownership_enabled = enabled
    mut tokens := lexer.scan(source, false)
    compiler.compile_options(&mut tokens, platform, &none, &none, checking, false, &mut records, "", "", &config)
}
@test fn ordered_import_conflict_precedes_a_later_body_error() {
    source := "capability unsafe\n@extern(\"first\",\"collide\") unsafe fn one()\n@extern(\"second\",\"collide\") unsafe fn two()\nfn main(){unsafe { one(); two() }; unused := missing}\n"
    none: []i32 = []
    for checking in [false, true] {
        mut records := compiler.bindings()
        result := compiler.compile_mode(source, 1, &none, &none, checking, false, &mut records)
        assert(!result.ok && result.error == "ELF cannot bind one symbol to two libraries; select a handle with std.dl")
    }
}
@test fn caller_tokens_survive_repeated_floating_compilations() {
    mut input := lexer.scan("fn main() { x: f64 = 1.5; print(x.str()) }", false)
    count := input.kinds.len; last := input.starts[count - 1]
    mut records := compiler.bindings(); none: []i32 = []
    first := compiler.compile_tokens(&mut input, 0, &none, &none, false, false, &mut records)
    assert(first.ok && input.kinds.len == count && input.starts[count - 1] == last)
    again := compiler.compile_tokens(&mut input, 0, &none, &none, false, false, &mut records)
    assert(again.ok && input.kinds.len == count)
    assert(first.text.len == again.text.len)
    for i in 0..first.text.len { assert(first.text[i] == again.text[i]) }
}

@test fn raw_generic_declarations_bind_types_and_values_in_their_own_context() {
    source := "struct T { x: bool } enum Choice<T> { T(T), Empty } " +
        "fn same<T>(T: T) -> T { answer: T = T; answer } " +
        "fn test<T>(n: i32) -> i32 { T := 17; if n < 3 { return T }; 42 } " +
        "fn main() { v := Choice<i32>.T(same<i32>(42)); match v { .T(n) => { print(n) }, .Empty => {} }; print(test<bool>(1)) }"
    mut tokens := lexer.scan(source, false); mut records := compiler.bindings(); none: []i32 = []
    for platform in 0..4 {
        result := compiler.compile_tokens(&mut tokens, platform, &none, &none, false, false, &mut records)
        assert(result.ok)
    }
}

@test fn unused_templates_are_checked_without_emitting_a_function() {
    source := "fn main() { print(42) }"
    invalid := compiler.compile("fn unused<T>(x: T) -> i32 { n: i32 = true; x.size(n) } " + source)
    assert(!invalid.ok && invalid.error == "type mismatch: expected i32, got bool")
    for platform in 0..4 {
        plain := compiler.compile_for(source, platform)
        generic := compiler.compile_for(source + " fn unused<T>(x: T) -> i32 { n: i32 = 8; x.size(n) }", platform)
        assert(plain.ok && generic.ok && plain.text.len == generic.text.len)
        for i in 0..plain.text.len { assert(plain.text[i] == generic.text[i]) }
    }
}

@test fn string_operand_leases_are_removed_only_across_effect_free_rhs() {
    for platform in 0..4 {
        pure := "fn main(){left:=\"a\";right:=\"b\";print(left==right);print(left+right)}"
        before := ownership_test_compile(pure, platform, false, false)
        after := ownership_test_compile(pure, platform, true, false)
        assert(before.ok && after.ok)
        assert(after.text.len < before.text.len)
        calls := "fn rhs()->string{\"b\"} fn main(){print(\"a\"==rhs())}"
        kept := ownership_test_compile(calls, platform, true, false)
        original := ownership_test_compile(calls, platform, false, false)
        assert(kept.ok && original.ok)
        assert(kept.text.len == original.text.len)
        for i in 0..kept.text.len { assert(kept.text[i] == original.text[i]) }
    }
}
@test fn ownership_proofs_do_not_change_validation_or_binding_records() {
    none: []i32 = []
    for platform in 0..4 {
        for source in ["fn main(){print(\"a\"==true)}", "fn unused()->string{true} fn main(){print(\"a\"==\"b\")}", "fn main(){value:=\"a\";value=\"b\"}"] {
            off := ownership_test_compile(source, platform, false, false)
            on := ownership_test_compile(source, platform, true, false)
            checked := ownership_test_compile(source, platform, true, true)
            assert(!off.ok && !on.ok && !checked.ok)
            assert(off.error == on.error && off.offset == on.offset)
            assert(on.error == checked.error && on.offset == checked.offset)
        }
        source := "fn main(){left:=\"a\";right:=\"b\";print(left==right)}"
        mut off_tokens := lexer.scan(source, false); mut on_tokens := lexer.scan(source, false)
        mut off_records := compiler.bindings(); mut on_records := compiler.bindings()
        mut config := compiler.configuration(); config.ownership_enabled = false
        off := compiler.compile_options(&mut off_tokens, platform, &none, &none, true, true, &mut off_records, "", "", &config)
        config.ownership_enabled = true
        on := compiler.compile_options(&mut on_tokens, platform, &none, &none, true, true, &mut on_records, "", "", &config)
        assert(off.ok && on.ok && off.text.len == 0 && on.text.len == 0)
        assert(off_records.offsets.len == on_records.offsets.len)
        for i in 0..off_records.offsets.len {
            assert(off_records.offsets[i] == on_records.offsets[i] && off_records.names[i] == on_records.names[i] && off_records.types[i] == on_records.types[i])
        }
    }
}
@test fn rune_literals_emit_the_same_code_as_scalar_constants() {
    for platform in 0..4 {
        runes := compiler.compile_for("fn main(){print(`\\0` == `\\u{0}`);print(`å` == `\\u{e5}`);print(`🌍` == `\\u{1f30d}`)}", platform)
        integers := compiler.compile_for("fn main(){print(0 == 0);print(229 == 229);print(127757 == 127757)}", platform)
        assert(runes.ok && integers.ok && runes.text.len == integers.text.len)
        for i in 0..runes.text.len { assert(runes.text[i] == integers.text[i]) }
    }
}
@test fn compiler_checks_types_before_emitting_an_image() {
    none: []i32 = []
    for platform in 0..4 {
        mut records := compiler.bindings()
        checked := compiler.compile_mode("fn unused()->i32{values: [u8;4]=[7;4];i32(values[0])} fn main(){print(42)}", platform, &none, &none, true, false, &mut records)
        assert(checked.ok && checked.text.len == 0 && records.emitted == 0)
        invalid := "fn unused()->i32{true} fn main(){print(42)}"
        rejected := compiler.compile_mode(invalid, platform, &none, &none, true, false, &mut records)
        built := compiler.compile_for(invalid, platform)
        assert(!rejected.ok && rejected.error == built.error && rejected.offset == built.offset)
        for source in [
            "enum Values{Other} fn size(Values:&[]i64)->i32{Values.len} fn main(){values:[]i64=[1,2];print(size(&values))}",
            "struct Bound{} fn count(Bound:i32)->i32{mut result:=0;for i in 0..Bound{result=result+1};result} fn main(){print(count(3))}",
            "enum Values{Other} fn update(Values:&mut []i64){for i in 0..Values.len{Values[i]=Values[i]+1}} fn main(){mut values:[]i64=[1,2];update(&mut values);print(values[0])}"
        ] {
            for enabled in [false, true] {
                mut tokens := lexer.scan(source, false)
                result := compiler.compile_configured(&mut tokens, platform, &none, &none, true, false, &mut records, "", "", enabled)
                assert(result.ok)
            }
        }
    }
    assert(compiler.compile("fn add(x:i32,y:i32)->i32{x+y} fn main(){print(add(20,22))}").ok)
    assert(!compiler.compile("fn main(){x:=1;x=2}").ok)
    assert(!compiler.compile("fn main(){mut x:=1;x=true}").ok)
    assert(!compiler.compile("fn f(x:i32)->i32{} fn main(){}").ok)
    assert(!compiler.compile("fn unused()->i32{true} fn main(){print(42)}").ok)
    assert(!compiler.compile("fn main(){print(unknown)}").ok)
    assert(!compiler.compile("fn main(){print(2147483648)}").ok)
    assert(!compiler.compile("fn main(){if 1 {}}").ok)
    assert(!compiler.compile("fn main(){for i in 0..2{i=3}}").ok)
    assert(!compiler.compile("import sys\nfn main(){}").ok)
}

@test fn check_mode_accepts_libraries_and_checks_every_body_without_emission() {
    none: []i32 = []
    for platform in 0..4 {
        for source in [
            "",
            "// a library may contain only declarations\n",
            "pub struct Value{number:i32} pub enum State{Ready,Done}",
            "pub fn answer()->i32{42}",
            "fn first()->i32{second()} fn second()->i32{42}",
            "struct Value{number:i32} impl Value{pub fn number(&self)->i32{self.number}}"
        ] {
            mut records := compiler.bindings()
            checked := compiler.compile_mode(source, platform, &none, &none, true, false, &mut records)
            assert(checked.ok && checked.text.len == 0 && records.emitted == 0 && records.reused == 0 && records.mir_functions == 0)
            built := compiler.compile_for(source, platform)
            assert(!built.ok && built.error == "program needs main")
        }
        for source in ["pub fn unused()->i32{true}", "fn first()->i32{42} fn later()->i32{missing}"] {
            mut records := compiler.bindings()
            checked := compiler.compile_mode(source, platform, &none, &none, true, false, &mut records)
            assert(!checked.ok && checked.error != "program needs main" && checked.offset >= 0 && checked.offset <= source.len)
        }
        mut records := compiler.bindings()
        macos := compiler.compile_mode("pub fn selected(){if target_is(\"macos\"){missing}}", platform, &none, &none, true, false, &mut records)
        linux := compiler.compile_mode("pub fn selected(){if target_is(\"linux\"){missing}}", platform, &none, &none, true, false, &mut records)
        assert(macos.ok == (platform != 0) && linux.ok == (platform != 1 && platform != 2))
        for source in ["fn main(value:i32){}", "fn main()->bool{true}"] {
            for checking in [false, true] {
                result := compiler.compile_mode(source, platform, &none, &none, checking, false, &mut records)
                assert(!result.ok && result.error == "main must take no arguments and return i32 or ()")
            }
        }
    }
}

@test fn mut_is_the_only_mutability_keyword_and_var_is_an_identifier() {
    for platform in 0..4 {
        source := "fn next(var:i32)->i32{var+1} fn main(){mut var:=40;var=next(var);print(var)}"
        assert(compiler.compile_for(source, platform).ok)
        assert(compiler.compile_for("fn main(){var:=42;print(var)}", platform).ok)
        assert(!compiler.compile_for("fn main(){var x:=1;print(x)}", platform).ok)
        assert(!compiler.compile_for("fn main(){var x:i32=1;print(x)}", platform).ok)
    }
}

@test fn native_compiler_checks_collection_shapes_and_immutable_mutation() {
    assert(compiler.compile_for("fn main(){mut a:[i32;2]=[1,2]}", 1).ok)
    assert(!compiler.compile_for("fn main(){mut a:[i32;2]=[1]}", 1).ok)
    for platform in 0..4 {
        assert(compiler.compile_for("struct Box{value:i32} fn main(){mut a:[]Box=[];a.push(Box{value:42});print(a[0].value)}", platform).ok)
        assert(!compiler.compile_for("struct Box{value:i32} fn main(){a:[]Box=[];a.push(Box{value:42})}", platform).ok)
    }
    assert(!compiler.compile_for("fn main(){a:[]i32=[1];a.clear()}", 1).ok)
    assert(!compiler.compile_for("fn main(){a:[]i32=[1];a.reserve(8)}", 1).ok)
    assert(!compiler.compile_for("fn main(){a:[]i32=[1];x:=a.pop()}", 1).ok)
    assert(!compiler.compile_for("fn f(x:i32)->i32{x} fn main(){mut a:=1;f(a)=2}", 1).ok)
    assert(!compiler.compile_for("fn f()->i32{42} fn main(){f:=1;print(f())}", 1).ok)
    assert(!compiler.compile_for("fn main(){mut a:=true;(!a)=false}", 1).ok)
    assert(!compiler.compile_for("fn main(){mut a:=1;(-a)=2}", 1).ok)
    assert(compiler.compile_for("enum K{A,B} struct Box{values:[]i32,tag:K} fn main(){mut b:=Box{values:[1,2],tag:.A};b.values.push(3);b.tag=.B;print(b.values.len)}", 1).ok)
}
@test fn target_is_folds_at_compile_time_and_prunes_dead_extern_branches() {
    gated := "capability unsafe\n@extern(\"c\", \"unused_mac\")\nunsafe fn c_mac() -> i32\nfn pick() -> i32 {\n    if target_is(\"macos\") {\n        unsafe { _ := c_mac(); _ := static_bytes(\"macos\", 16) }\n        return 1\n    } else if target_is(\"linux\") {\n        return 2\n    } else {\n        return 3\n    }\n}\nfn main() { _ := pick() }\n"
    r0 := compiler.compile_for(gated, 0)
    r1 := compiler.compile_for(gated, 1)
    r2 := compiler.compile_for(gated, 2)
    r3 := compiler.compile_for(gated, 3)
    assert(r0.ok && r0.imports.symbols.len == 1 && r0.imports.symbols[0] == "unused_mac" && r0.imports.globals == 80)
    assert(r1.ok && r1.imports.symbols.len == 0 && r1.imports.globals == 0)
    assert(r2.ok && r2.imports.symbols.len == 0 && r2.imports.globals == 0)
    assert(r3.ok)

    predicates := [
        "macos", "arm64-macos", "aarch64-apple-darwin",
        "linux", "arm64-linux", "aarch64-unknown-linux-gnu",
        "x86_64-linux", "x86_64-unknown-linux-gnu",
        "arm64", "x86_64", "native",
        "wasm32", "wasm32-unknown-unknown"
    ]
    expected_bits := [
        "1110000010100",
        "0001110010100",
        "0001001101100",
        "0000000000011"
    ]
    for platform in 0..4 {
        for i in 0..predicates.len {
            p := predicates[i].clone()
            taken := "fn main() { if target_is(\"" + p + "\") { } else { missing_branch_symbol } }"
            assert(compiler.compile_for(taken, platform).ok == (expected_bits[platform][i..i + 1] == "1"))
        }
        compound := "fn main() { if !target_is(\"wasm32\") && (target_is(\"arm64\") || target_is(\"x86_64\")) { } else { missing_branch_symbol } }"
        assert(compiler.compile_for(compound, platform).ok == (platform != 3))
        if platform == 3 {
            assert(!compiler.compile_for("capability unsafe\nfn main() { if target_is(\"wasm32\") { unsafe { _ := static_bytes(\"native\", 16) } } }", platform).ok)
            assert(compiler.compile_for("capability unsafe\nfn main() { if target_is(\"native\") { unsafe { _ := static_bytes(\"native\", 16) } } }", platform).ok)
        } else {
            assert(compiler.compile_for("capability unsafe\nfn main() { if target_is(\"wasm32\") { unsafe { _ := static_bytes(\"native\", 16) } } }", platform).ok)
        }
    }
    assert(!compiler.compile_for("fn main() { if target_is(\"plan9\") { } }", 0).ok)
    assert(!compiler.compile_for("fn main() { x := \"linux\"; if target_is(x) { } }", 0).ok)
}

fn inline_test_compile(source: string, platform: i32, enabled: bool, scalar: bool, checking: bool, report: bool, records: &mut compiler.Bindings) -> compiler.Result {
    none: []i32 = []; mut tokens := lexer.scan(source, false); mut settings := compiler.configuration()
    settings.inline_enabled = enabled; settings.scalar_enabled = scalar
    compiler.compile_options(&mut tokens, platform, &none, &none, checking, report, &mut records, "", "", &settings)
}
@test fn inline_producer_preserves_authoritative_diagnostics_and_scalar_off_behavior() {
    for platform in 0..4 {
        for source in [
            "fn step(x:i32)->i32{x+1} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{mut y:=x;y=y+1;y} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{if x>0{return x};-x} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+1} fn main(){step:=1;print(step(2))}",
            "fn step(x:i32)->i32{x=2;x} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+2147483648} fn main(){print(step(2))}",
            "fn step(x:i32)->i32{x+missing} fn main(){}",
            "fn step(x:i32)->i32{if false{return true};x} fn main(){}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step(true))}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step(1,2))}",
            "fn step(x:i32)->i32{x+1} fn main(){print(step())}"
        ] {
            for checking in [false, true] {
                mut before := compiler.bindings(); mut after := compiler.bindings()
                old := inline_test_compile(source, platform, false, true, checking, false, &mut before)
                current := inline_test_compile(source, platform, true, true, checking, false, &mut after)
                assert(old.ok == current.ok && old.error == current.error && old.offset == current.offset)
                assert(before.modeled == after.modeled && before.optimized == after.optimized && before.emitted == after.emitted && before.fallbacks == after.fallbacks)
            }
        }
        mut before := compiler.bindings(); mut after := compiler.bindings()
        source := "fn step(x:i32)->i32{x+1} fn main(){print(step(2))}"
        old := inline_test_compile(source, platform, false, false, false, false, &mut before)
        disabled := inline_test_compile(source, platform, true, false, false, false, &mut after)
        assert(old.ok && disabled.ok && old.text.len == disabled.text.len)
        for at in 0..old.text.len { assert(old.text[at] == disabled.text[at]) }
    }
}
@test fn a_deferred_local_has_one_binding_across_all_exit_edges() {
    source := "fn run(n:i32)->i32{defer {saved:=n;print(saved)};if n==1{return 1};if n==2{return 2};3} fn main(){print(run(2))}"
    none: []i32 = []
    for checking in [true, false] {
        mut records := compiler.bindings()
        result := compiler.compile_mode(source, 0, &none, &none, checking, true, &mut records)
        assert(result.ok)
        mut reports := 0
        for name in records.names { if name == "saved" { reports = reports + 1 } }
        assert(reports == 1)
    }
}
@test fn inline_producer_does_not_duplicate_source_binding_reports() {
    source := "fn step(x:i32)->i32{x+1} fn main(){value:=3;print(step(value))}"
    for platform in 0..4 {
        mut before := compiler.bindings(); mut after := compiler.bindings()
        old := inline_test_compile(source, platform, false, true, false, true, &mut before)
        current := inline_test_compile(source, platform, true, true, false, true, &mut after)
        assert(old.ok && current.ok && before.offsets.len == after.offsets.len && before.modeled == after.modeled)
        assert(before.optimized == after.optimized && before.emitted == after.emitted)
        assert(before.inline_entries == 0 && before.inlined_calls == 0 && before.inline_tokens == 0)
        assert(after.inline_entries == 1 && after.inline_nodes == 3 && after.inline_units > 0 && after.inline_tokens > 0 && after.inline_tokens <= 32768)
        assert(after.inlined_calls == 1 && after.inlined_words > 0 && after.inlined_words <= after.inline_estimated_words && after.inline_estimated_words <= 65536)
        for at in 0..before.offsets.len {
            assert(before.offsets[at] == after.offsets[at] && before.names[at] == after.names[at] && before.types[at] == after.types[at])
        }
    }
}

fn inline_cache_test_compile(source: string, platform: i32, directory: string, records: &mut compiler.Bindings) -> compiler.Result {
    none: []i32 = []; mut tokens := lexer.scan(source, false); mut settings := compiler.configuration()
    settings.inline_enabled = true
    compiler.compile_options(&mut tokens, platform, &none, &none, false, false, &mut records, directory, "inline-dependencies-test:v2", &settings)
}
fn same_test_image(left: &compiler.Result, right: &compiler.Result) -> bool {
    if !left.ok || !right.ok || left.text.len != right.text.len { return false }
    for at in 0..left.text.len { if left.text[at] != right.text[at] { return false } }
    true
}
@test fn inline_fragments_restore_backward_dependencies_charges_and_private_body_identity() {
    for platform in 0..3 {
        directory := "build/inline-dependency-unit/" + platform.str()
        for source in ["fn step(x:i32)->i32{x+1} fn main(){print(step(8))}", "fn step(x:i32)->i32{x+2} fn main(){print(step(8))}"] {
            mut fresh := compiler.bindings(); mut first := compiler.bindings(); mut warm := compiler.bindings()
            reference := inline_cache_test_compile(source, platform, "", &mut fresh)
            initial := inline_cache_test_compile(source, platform, directory, &mut first)
            restored := inline_cache_test_compile(source, platform, directory, &mut warm)
            assert(same_test_image(&reference, &initial) && same_test_image(&reference, &restored))
            assert(warm.reused == 2 && warm.emitted == 0 && warm.modeled == 0 && warm.optimized == 0 && warm.fallbacks == 0)
            assert(warm.inlined_calls == 0 && warm.inlined_words == 0 && warm.inline_estimated_words == fresh.inline_estimated_words)
            assert(fresh.inlined_calls == 1 && fresh.inline_estimated_words > 0)
        }
        source := "fn main(){print(42)}"
        mut fresh := compiler.bindings(); mut first := compiler.bindings(); mut warm := compiler.bindings()
        reference := inline_cache_test_compile(source, platform, "", &mut fresh)
        initial := inline_cache_test_compile(source, platform, directory, &mut first)
        restored := inline_cache_test_compile(source, platform, directory, &mut warm)
        assert(same_test_image(&reference, &initial) && same_test_image(&reference, &restored))
        assert(warm.reused == 1 && warm.emitted == 0 && warm.inline_estimated_words == 0)
    }
}
fn inline_budget_test_source(first_count: i32) -> string {
    mut source := "fn step(x:i32)->i32{x+1} "
    for function in 0..20 {
        source = source + "fn consume" + function.str() + "()->i32{mut sum:=0;"
        mut count := 100; if function == 0 { count = first_count }
        for _ in 0..count { source = source + "sum=sum+step(1);" }
        source = source + "sum} "
    }
    source = source + "fn main(){mut total:=0;"
    for function in 0..20 { source = source + "total=total+consume" + function.str() + "();" }
    source + "print(total)}"
}
@test fn inline_budget_is_local_to_each_caller_across_partial_cache_hits() {
    directory := "build/inline-frontier-unit"
    mut previous_count := -1
    for count in [100, 5, 100] {
        source := inline_budget_test_source(count)
        mut fresh := compiler.bindings(); mut mixed := compiler.bindings(); mut warm := compiler.bindings()
        reference := inline_cache_test_compile(source, 0, "", &mut fresh)
        partial := inline_cache_test_compile(source, 0, directory, &mut mixed)
        restored := inline_cache_test_compile(source, 0, directory, &mut warm)
        assert(same_test_image(&reference, &partial) && same_test_image(&reference, &restored))
        assert(warm.reused == 22 && warm.emitted == 0 && warm.modeled == 0 && warm.fallbacks == 0)
        if previous_count >= 0 { assert(mixed.reused == 21) }
        previous_count = count
        assert(fresh.inline_estimated_words > 65536 && mixed.inline_estimated_words == fresh.inline_estimated_words && warm.inline_estimated_words == fresh.inline_estimated_words)
        assert(warm.inlined_calls == 0 && warm.inlined_words == 0 && fresh.inlined_calls > 0)
    }
}

@test fn all_emitted_source_functions_use_mir_without_changing_diagnostics_or_bindings() {
    none: []i32 = []
    for platform in 0..4 {
        for source in [
            "fn inc(x:i32)->i32{x+1} fn main(){print(inc(3))}",
            "fn inc(x:i32)->i32{x+1} fn main(){mut text:=\"x\";mut sum:=0;for i in 0..8{sum=sum+inc(i);text=text+\"z\"};print(text);print(sum)}",
            "fn change(values:&mut []i64){for i in 0..values.len{values[i]=values[i]+1}} fn main(){mut values:[]i64=[1,2];change(&mut values);print(values[0])}",
            "fn recurse(x:i32)->i32{if x==0{return 1};x*recurse(x-1)} fn main(){print(recurse(4))}"
        ] {
            for checking in [false, true] {
                mut plain := compiler.configuration(); plain.mir_opt_enabled = false; optimized := compiler.configuration()
                mut before := compiler.bindings(); mut after := compiler.bindings(); mut left := lexer.scan(source, false); mut right := lexer.scan(source, false)
                a := compiler.compile_options(&mut left, platform, &none, &none, checking, true, &mut before, "", "", &plain)
                b := compiler.compile_options(&mut right, platform, &none, &none, checking, true, &mut after, "", "", &optimized)
                assert(a.ok && b.ok && a.offset == b.offset && a.error == b.error && before.offsets.len == after.offsets.len)
                for at in 0..before.offsets.len { assert(before.offsets[at] == after.offsets[at] && before.names[at] == after.names[at] && before.types[at] == after.types[at]) }
                assert(before.mir_functions == after.mir_functions && before.mir_functions == before.emitted)
                if checking { assert(before.mir_operations == 0 && after.mir_operations == 0) }
                else { assert(before.mir_functions > 0 && before.mir_operations >= before.mir_functions && after.mir_operations >= after.mir_functions) }
            }
        }
    }
}

@test fn whole_function_optimizer_policy_and_actual_counters_follow_pass_execution() {
    source := "fn next(x:i32)->i32{x+1} fn main(){mut sum:=0;for i in 0..12{sum=sum+next(i)};print(sum)}"
    none: []i32 = []
    for platform in 0..4 {
        for mode in 0..3 {
            mut config := compiler.configuration(); config.mir_opt_enabled = mode != 0
            checking := mode == 2
            mut records := compiler.bindings(); mut tokens := lexer.scan(source, false)
            result := compiler.compile_options(&mut tokens, platform, &none, &none, checking, false, &mut records, "", "", &config)
            assert(result.ok)
            if mode != 1 {
                assert(!records.mir_optimization_enabled && records.mir_optimized == 0 && records.mir_promoted == 0)
                assert(records.mir_removed_loads == 0 && records.mir_removed_stores == 0 && records.mir_analysis_units == 0 && records.mir_budget_refusals == 0)
            } else {
                assert(records.mir_optimization_enabled && records.mir_functions == records.emitted && records.mir_functions > 0)
                assert(records.mir_analysis_units > 0)
                if records.mir_optimized > 0 { assert(records.mir_promoted > 0 && records.mir_removed_loads > 0 && records.mir_removed_stores > 0) }
                else { assert(records.mir_promoted == 0 && records.mir_removed_loads == 0 && records.mir_removed_stores == 0) }
            }
        }
    }
}

@test fn capability_frontend_diagnostics_report_helpful_errors() {
    unknown_io := compiler.compile_for("capability io\nfn main() {}", 0)
    assert(!unknown_io.ok && text.contains(unknown_io.error, "unknown module capability 'io'; did you mean 'stdio'?"))

    dup := compiler.compile_for("capability stdio, stdio\nfn main() {}", 0)
    assert(!dup.ok && dup.error == "duplicate module capability 'stdio'" && dup.offset == 18)

    space := compiler.compile_for("capability stdio filesystem\nfn main() {}", 0)
    assert(!space.ok && text.contains(space.error, "separate multiple capabilities with commas"))

    no_unsafe := compiler.compile_for("fn main() { unsafe {} }", 0)
    assert(!no_unsafe.ok && text.contains(no_unsafe.error, "module requires capability unsafe; add 'capability unsafe'"))

    req_unsafe := compiler.compile_for("@requires(unsafe) fn f() {} fn main() {}", 0)
    assert(!req_unsafe.ok && text.contains(req_unsafe.error, "@requires does not accept 'unsafe'"))

    req_dup := compiler.compile_for("@requires(stdio, stdio) fn f() {} fn main() {}", 0)
    assert(!req_dup.ok && req_dup.error == "duplicate @requires capability 'stdio'" && req_dup.offset == 17)
}

@test fn rune_arithmetic_rejected_and_comparisons_preserved() {
    for op in ["+", "-", "*", "/", "%"] {
        bad := compiler.compile_for("fn main() { _ := `a` " + op + " `b` }", 0)
        assert(!bad.ok && text.contains(bad.error, "arithmetic requires matching integer types"))
    }
    compound := compiler.compile_for("fn main() { mut r := `a`; r += `b` }", 0)
    assert(!compound.ok && text.contains(compound.error, "arithmetic requires matching integer types"))

    ok := compiler.compile_for("fn main() { assert(`a` < `b` && `a` <= `a` && `b` > `a` && `b` >= `b` && `a` == `a` && `a` != `b`) }", 0)
    assert(ok.ok)
}
