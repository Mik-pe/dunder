import ..selfhost.fragments as fragments
import ..selfhost.compiler_profile as profile
import std.text as text

@test fn disabled_cache_meter_has_no_arrays_clocks_or_updates() {
    var meter:=fragments.new_meter(-1)
    fragments.record_meter(&mut meter,4,10,20,99)
    fragments.record_meter(&mut meter,-1,-1,-1,-1)
    !meter.enabled && meter.clock_ok
    meter.elapsed.len==0 && meter.calls.len==0 && meter.work.len==0
    fragments.json_meter(&meter)=="{\"enabled\":false}"
    profile.new(-1).cache_detail==""
}
@test fn cache_meter_counts_work_but_never_fakes_unavailable_clock_data() {
    var meter:=fragments.new_meter(0)
    fragments.record_meter(&mut meter,4,10,30,128)
    fragments.record_meter(&mut meter,4,40,50,64)
    meter.elapsed[4]==30 && meter.calls[4]==2 && meter.work[4]==192
    valid:=fragments.json_meter(&meter)
    text.find(valid,"\"total\":30")>=0
    text.find(valid,"\"overlaps_parent\":\"fragment_cache\",\"included_in_covered\":false")>=0
    fragments.record_meter(&mut meter,2,-1,40,8)
    !meter.clock_ok && meter.calls[2]==1 && meter.work[2]==8
    invalid:=fragments.json_meter(&meter)
    text.find(invalid,"\"clock_ok\":false")>=0 && text.find(invalid,"\"total\":null")>=0
    for phase in 0..9{text.find(invalid,"\""+fragments.meter_phase(phase)+"\":null")>=0}
}
@test fn negative_work_or_invalid_stage_is_rejected_without_counter_mutation() {
    var meter:=fragments.new_meter(0)
    fragments.record_meter(&mut meter,1,0,1,-1)
    fragments.record_meter(&mut meter,9,0,1,1)
    !meter.clock_ok
    for stage in 0..9{meter.elapsed[stage]==0 && meter.calls[stage]==0 && meter.work[stage]==0}
}
@test fn nested_cache_detail_does_not_change_the_eleven_phase_partition() {
    var p:=profile.new(0)
    profile.record(&mut p,8,10,40,1)
    text.find(profile.json(&p,100),"\"covered\":30,\"other\":70")>=0
    var meter:=fragments.new_meter(0)
    fragments.record_meter(&mut meter,4,10,30,128)
    p.cache_detail=fragments.json_meter(&meter)
    result:=profile.json(&p,100)
    text.find(result,"\"covered\":30,\"other\":70")>=0
    text.find(result,"\"cache_detail\":{\"enabled\":true")>=0
    p.elapsed.len==11 && p.calls.len==11 && p.work.len==11
}
