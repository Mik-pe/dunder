import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_lower as lower
import ..selfhost.mir_pipeline as pipeline
import ..selfhost.mir_source as source
import ..selfhost.mir_task as worker

fn capture_body(batch: &mut worker.Batch, code: &mut arm.Code, entry: i32, value: i64) -> worker.Answer {
    ordinal := worker.batch_len(&batch)
    first := code.words.len; labels := code.labels.len; relocs := code.at.len
    sites: []i32 = []
    arm.mark(&mut code, entry); arm.begin_mir(&mut code, true)
    frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 0)
    arm.imm(&mut code, 0, value)
    done := arm.label(&mut code); arm.branch(&mut code, done, 0)
    arm.mark(&mut code, done); arm.ret(&mut code); arm.end_mir(&mut code)
    assert(source.capture(&mut batch.source, &code, first, labels, relocs, &sites, 0, entry))
    worker.add_item(&mut batch, ordinal, entry)

    var f := mir.new()
    assert(lift.lift(&mut f, &code, first, labels, relocs, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry))
    worker.execute(worker.Job { ordinal: ordinal, declaration: entry, function: f, options: batch.options, terminals: batch.terminals })
}
fn check_answer(batch: &worker.BatchAnswer, expected: &worker.Answer) {
    item := expected.ordinal
    assert(worker.answer_ordinal(&batch, item) == item && worker.answer_declaration(&batch, item) == expected.declaration)
    var data := lower.new_data(); var status := expected.status
    worker.unpack_answer(&batch, item, &mut data, &mut status)
    assert(status.error == 0 && status.stats.operations == expected.status.stats.operations)
    assert(data.first_word == expected.object.first_word && data.source_words == expected.object.source_words)
    assert(data.first_label == expected.object.first_label && data.source_labels == expected.object.source_labels)
    assert(data.first_reloc == expected.object.first_reloc && data.source_relocs == expected.object.source_relocs)
    assert(data.output.words.len == expected.object.output.words.len)
    for i in 0..data.output.words.len { assert(data.output.words[i] == expected.object.output.words[i]) }
    assert(data.output.at.len == expected.object.output.at.len)
    for i in 0..data.output.at.len {
        assert(data.output.at[i] == expected.object.output.at[i] && data.output.target[i] == expected.object.output.target[i] &&
            data.output.kinds[i] == expected.object.output.kinds[i])
    }
    assert(data.label_ids.len == expected.object.label_ids.len)
    for i in 0..data.label_ids.len {
        assert(data.label_ids[i] == expected.object.label_ids[i] && data.label_at[i] == expected.object.label_at[i])
    }
}
@test fn worker_lifts_function_ranges_and_reuses_its_workspace_after_refusal() {
    for ssa in [false, true] {
        var options := pipeline.options(); options.ssa = ssa
        var batch := worker.new_batch(options, pipeline.no_terminals()); var code := arm.new()
        entry_a := arm.label(&mut code); entry_b := arm.label(&mut code)
        arm.imm(&mut code, 0, 1)
        a := capture_body(&mut batch, &mut code, entry_a, 1234)
        b := capture_body(&mut batch, &mut code, entry_b, 5678)
        var workspace := worker.new_workspace()
        answer := worker.execute_batch(batch, &mut workspace)
        assert(worker.answer_len(&answer) == 2); check_answer(&answer, &a); check_answer(&answer, &b)

        batch.source.words[0] = -1
        partial := worker.execute_batch(batch, &mut workspace)
        var data := lower.new_data(); var status := a.status
        worker.unpack_answer(&partial, 0, &mut data, &mut status)
        assert(status.error == 10 && data.version == 0 && data.output.words.len == 0)
        check_answer(&partial, &b)

        worker.reset_batch(&mut batch)
        assert(worker.batch_len(&batch) == 0 && batch.source.words.len == 0)
        earlier := code.words.len
        entry_c := arm.label(&mut code)
        c := capture_body(&mut batch, &mut code, entry_c, 9)
        assert(batch.source.words.len == code.words.len - earlier)
        reused := worker.execute_batch(batch, &mut workspace); check_answer(&reused, &c)
    }
}
