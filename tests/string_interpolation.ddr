struct Message { text: string }
struct Point { x: i32, y: i32 }
enum Choice { Empty, Value(i32) }

fn record(trace: &mut []i32, value: i32) -> i32 {
    trace.push(value)
    value
}

fn replace(text: &mut string, next: string) -> string {
    text = next
    text
}

fn replace_message(message: &mut Message) -> string {
    message.text = "after" + 42.str()
    message.text
}

fn make_point(x: i32, y: i32) -> Point { Point { x: x, y: y } }
fn interpolate_return(value: i32) -> string { f"return {{{value}}}: å 🌍" }

pub fn literals_and_scalars() {
    name := "världen 🌍"
    signed: i64 = -9223372036854775807
    tiny: u8 = 255
    medium: u16 = 65535
    word: u32 = 4294967295
    wide: u64 = 18446744073709551615
    native: usize = 123
    single: f32 = 0.5
    double: f64 = 1.25
    assert(f"Hej {name}!" == "Hej världen 🌍!")
    assert(f'{42}/{signed}/{tiny}/{medium}/{word}/{wide}/{native}' ==
        "42/-9223372036854775807/255/65535/4294967295/18446744073709551615/123")
    assert(f"{true}/{false}/{`å`}/{single}/{double}" == "true/false/å/0.5/1.25")
    assert(f"" == "")
    assert(f"{{name}} {{}}" == "{name} {}")
    assert(f"\\\"\t\n\0{42}\u{1f30d}" == "\\\"\t\n\0" + "42🌍")
    assert(f"\x7b\u{7d}{42}" == "{}42")
    assert("{name}" == "{name}")
    assert('f"{name}"' == "f\"{name}\"")
}

pub fn nested_expressions() {
    values := [10, 20, 30]
    choice := Choice.Value(40)
    assert(f"{1 + 2 * 3}:{values[1]}:{make_point(3, 4).y}" == "7:20:4")
    assert("prefix/" + f"{if true { "yes" } else { "no" }}" + "/suffix" == "prefix/yes/suffix")
    assert(f"{match choice { .Empty => 0, .Value(value) => value + 2, }}" == "42")
    assert(f"outer {f'inner {40 + 2}'} end" == "outer inner 42 end")
    assert(f'{"same quote"} {"escaped"}' == "same quote escaped")
    assert(f"{40 /* } { ignored */ + 2}" == "42")
    assert(f"{
        40 // } ignored by the expression scanner
        + 2
    }" == "42")
}

pub fn evaluation_order() {
    var trace: []i32 = []
    result := f"{record(&mut trace, 1)}:{record(&mut trace, 2)}:{record(&mut trace, 3)}"
    assert(result == "1:2:3")
    assert(trace.len == 3 && trace[0] == 1 && trace[1] == 2 && trace[2] == 3)
    var changed := 40
    result2 := f"{changed}:{if record(&mut trace, 4) == 4 { record(&mut trace, 5) } else { record(&mut trace, 6) }}"
    assert(result2 == "40:5")
    assert(trace.len == 5 && trace[3] == 4 && trace[4] == 5)
}

pub fn ownership_across_holes() {
    for i in 0..1000 {
        var text := "before" + i.str()
        saved := f"{text}|{replace(&mut text, "after" + i.str())}|{text}"
        assert(saved == "before" + i.str() + "|after" + i.str() + "|after" + i.str())
        var message := Message { text: "before" + i.str() }
        projected := f"{message.text}:{replace_message(&mut message)}:{message.text}"
        assert(projected == "before" + i.str() + ":after42:after42")
        var values := ["before" + i.str()]
        element := f"{values[0]}:{replace(&mut values[0], "after")}:end"
        assert(element == "before" + i.str() + ":after:end")
    }
}

pub fn returned_interpolation() {
    var retained: []string = []
    for i in 0..2000 {
        value := interpolate_return(i)
        assert(value == "return {" + i.str() + "}: å 🌍")
        if i % 250 == 0 { retained.push(value) }
    }
    assert(retained.len == 8)
    for i in 0..retained.len {
        assert(retained[i] == "return {" + (i * 250).str() + "}: å 🌍")
    }
}

pub fn verify() {
    literals_and_scalars()
    nested_expressions()
    evaluation_order()
    ownership_across_holes()
    returned_interpolation()
}

@test fn interpolated_literals_and_scalar_types() { literals_and_scalars() }
@test fn interpolated_expressions_and_nesting() { nested_expressions() }
@test fn interpolation_evaluates_holes_once_in_source_order() { evaluation_order() }
@test fn interpolation_preserves_earlier_string_owners() { ownership_across_holes() }
@test fn interpolation_returns_survive_later_allocations() { returned_interpolation() }
