// Test consumers of detached objects. The production linker exercises its
// namespace/ownership checks; append below independently exposes every local
// relocation, label and import coordinate for comparison.
import ...selfhost.backend.arm64 as arm
import ...selfhost.mir.mir
import ...selfhost.mir.mir_lower as lower
import ...selfhost.mir.mir_link as link

// Link one lowered suffix after its original prefix, with a fresh coordinator
// and namespace. Publish both output tables only after the linker accepts the
// complete object. No part of the old suffix is replayed or committed in place.
pub fn link_suffix(object: &lower.FunctionObject, code: &mut arm.Code, sites: &mut []i32) -> bool {
    if !lower.object_ready(&object) { return false }
    first := lower.object_first_word(&object); reloc := lower.object_first_reloc(&object)
    imported := lower.object_first_import(&object)
    if first < 0 || first > code.words.len || reloc < 0 || reloc > code.at.len ||
        reloc > code.target.len || reloc > code.kinds.len || imported < 0 || imported > sites.len { return false }
    mut prefix := arm.new_for(code.platform)
    prefix.profile = code.profile; prefix.effect_epoch = code.effect_epoch
    for at in 0..first { prefix.words.push(code.words[at]) }
    mut owned := 0
    for id in 0..code.labels.len {
        while owned < lower.object_label_count(&object) && lower.object_label_id(&object, owned) < id { owned = owned + 1 }
        if owned < lower.object_label_count(&object) && lower.object_label_id(&object, owned) == id { prefix.labels.push(-1) }
        else { prefix.labels.push(code.labels[id]) }
    }
    for at in 0..reloc {
        prefix.at.push(code.at[at]); prefix.target.push(code.target[at]); prefix.kinds.push(code.kinds[at])
    }
    mut prefix_sites: []i32 = []
    for id in 0..imported { prefix_sites.push(sites[id]) }
    mut coordinator := link.new()
    if !link.begin(&mut coordinator, &prefix, &prefix_sites) ||
        !link.reserve_namespace(&mut coordinator, code.labels.len, sites.len) ||
        !link.seal_namespace(&mut coordinator, 1) || !link.append(&mut coordinator, &object, 0) ||
        !link.finalize(&mut coordinator) { return false }
    mut output := arm.new(); mut output_sites: []i32 = []
    link.export_code(&mut coordinator, &mut output); link.export_import_sites(&mut coordinator, &mut output_sites)
    code = output; sites = output_sites; true
}
pub fn lower_and_link(f: &mir.Function, code: &mut arm.Code, sites: &mut []i32) -> bool {
    mut object := lower.new_object()
    if !lower.lower_into(&mut object, &f) { return false }
    link_suffix(&object, &mut code, &mut sites)
}

pub fn append(object: &lower.FunctionObject, code: &mut arm.Code, sites: &mut []i32) {
    assert(lower.object_ready(&object) && lower.object_platform(&object) == code.platform)
    base := code.words.len
    assert(base <= 2147483647 - lower.object_word_count(&object))
    for i in 0..lower.object_label_count(&object) {
        id := lower.object_label_id(&object, i)
        assert(id >= 0 && id < code.labels.len)
        offset := lower.object_label_offset(&object, i)
        assert(offset >= -1 && offset <= lower.object_word_count(&object))
    }
    for i in 0..lower.object_reloc_count(&object) {
        at := lower.object_reloc_at(&object, i); target := lower.object_reloc_target(&object, i)
        assert(at >= 0 && at < lower.object_word_count(&object) && target >= 0 && target < code.labels.len)
    }
    for i in 0..lower.object_import_count(&object) {
        id := lower.object_import_id(&object, i); at := lower.object_import_byte_at(&object, i)
        assert(id >= 0 && id < sites.len && at >= 0 && at % 4 == 0 && base <= 536870911 - at / 4)
    }
    for i in 0..lower.object_word_count(&object) { code.words.push(lower.object_word(&object, i)) }
    for i in 0..lower.object_label_count(&object) {
        mut at := lower.object_label_offset(&object, i); if at >= 0 { at = base + at }
        code.labels[lower.object_label_id(&object, i)] = at
    }
    for i in 0..lower.object_reloc_count(&object) {
        code.at.push(base + lower.object_reloc_at(&object, i))
        code.target.push(lower.object_reloc_target(&object, i)); code.kinds.push(lower.object_reloc_kind(&object, i))
    }
    for i in 0..lower.object_import_count(&object) {
        sites[lower.object_import_id(&object, i)] = base * 4 + lower.object_import_byte_at(&object, i)
    }
}
pub fn same_i32(a: &[]i32, b: &[]i32) {
    assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) }
}
pub fn same_i64(a: &[]i64, b: &[]i64) {
    assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) }
}
pub fn copy_code(dst: &mut arm.Code, src: &arm.Code) {
    dst.words.clear(); dst.labels.clear(); dst.at.clear(); dst.target.clear(); dst.kinds.clear()
    for i in 0..src.words.len { dst.words.push(src.words[i]) }
    for i in 0..src.labels.len { dst.labels.push(src.labels[i]) }
    for i in 0..src.at.len { dst.at.push(src.at[i]); dst.target.push(src.target[i]); dst.kinds.push(src.kinds[i]) }
}
pub fn same_code(a: &arm.Code, b: &arm.Code) {
    assert(a.platform == b.platform)
    same_i64(&a.words, &b.words); same_i32(&a.labels, &b.labels)
    same_i32(&a.at, &b.at); same_i32(&a.target, &b.target); same_i32(&a.kinds, &b.kinds)
}
