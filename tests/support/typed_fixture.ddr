// Run optimizer fixtures through the production declaration and body checker.
// Positions in returned nodes refer to the original fixture token stream.
import ...selfhost.compile as compiler
import ...selfhost.lexer
import ...selfhost.opt_ir as ir
import ...selfhost.opt_verify as verify
import ...selfhost.opt_range as ranges
import ...selfhost.opt_inline as inline
import ...selfhost.opt_emit as emitter
import ...selfhost.record_take as takes

fn spelling(ty: i32) -> string {
    if ty == 0 { return "void" }; if ty == 1 { return "i32" }
    if ty == 2 { return "i64" }; if ty == 3 { return "bool" }
    if ty == 20 { return "&[]i64" }; if ty == 21 { return "&mut []i64" }
    ""
}
pub fn body(f: &mut ir.Function, input: &lexer.Tokens, first: i32, last: i32,
    names: &[]string, types: &[]i32, positions: &[]i32, ret: i32) -> bool {
    if names.len != types.len || names.len != positions.len || first < 0 || last < first || last >= input.kinds.len { return false }
    var signature := "fn subject("
    for p in 0..names.len {
        if p > 0 { signature = signature + "," }
        signature = signature + names[p] + ":" + spelling(types[p])
    }
    signature = signature + ")"
    if ret != 0 { signature = signature + " -> " + spelling(ret) }
    var tokens := lexer.scan(signature, false)
    end_kind := tokens.kinds.pop(); end_text := tokens.texts.pop(); end_start := tokens.starts.pop(); end_offset := tokens.ends.pop()
    body_at := tokens.kinds.len
    for at in first..last + 1 {
        tokens.kinds.push(input.kinds[at]); tokens.texts.push(input.texts[at])
        tokens.starts.push(signature.len + input.starts[at]); tokens.ends.push(signature.len + input.ends[at])
    }
    after := tokens.kinds.len; base := tokens.ends[after - 1]
    lexer.scan_into("\nfn main(){}", &mut tokens)
    for at in after..tokens.kinds.len { tokens.starts[at] = tokens.starts[at] + base; tokens.ends[at] = tokens.ends[at] + base }
    var session := compiler.new_session(); var config := compiler.configuration(); config.inline_enabled = false
    none: []i32 = []; var verifier := verify.new(); var range_work := ranges.new(); var catalog := inline.new()
    var inliner := inline.workspace(); var settings := emitter.options(); var records := takes.new()
    if !compiler.begin_into(&mut session, &mut tokens, 0, &none, &none, false, "", "", &config,
        &mut f, &mut verifier, &mut range_work, &mut catalog, &mut inliner, &mut settings, &mut records) { return false }
    view := inline.emission_view(&catalog)
    if !compiler.typed_body_into(&mut session, 0, &mut f, &view, &mut inliner) { return false }
    for node in 0..f.nodes.starts.len { f.nodes.starts[node] = f.nodes.starts[node] - body_at + first }
    for local in 0..f.local_at.len {
        if f.local_param[local] >= 0 { f.local_at[local] = positions[f.local_param[local]] }
        else { f.local_at[local] = f.local_at[local] - body_at + first }
    }
    true
}
