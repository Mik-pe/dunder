import std.fs as fs
import std.process as process

pub fn run_granted_echo(sh: &process.Executable, msg: string) -> string {
    out := sh.run(["-c", "printf '%s' \"$1\"", "sh", msg.clone()])
    assert(out.succeeded())
    out.stdout_text()
}

pub fn count_granted_dir(dir: &fs.ReadDir) -> i32 {
    match dir.list() {
        .Ok(entries) => entries.len,
        .Err(_) => { assert(false); 0 },
    }
}
