import .impl_counter as counter
import .impl_counter.Mode as Speed

impl counter.Counter {
    pub fn twice(&mut self) { self.add(self.amount()) }
    fn amount(&self) -> i32 { self.value() }
}

impl Speed {
    pub fn faster(n: i32) -> Self { Self.Fast(n + 1) }
}

impl counter.Box<T> {
    pub fn wrap(move value: T) -> Self { Self { value: move value } }
    pub fn refill(&self, move value: T) -> Self { Self::wrap(move value) }
}
