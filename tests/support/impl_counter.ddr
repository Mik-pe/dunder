pub opaque struct Counter {
    value: i32,
    tag: string,
}

pub enum Mode {
    Slow = 0,
    Fast(i32) = 1,
}

pub struct Box<T> { value: T }

pub fn value() -> i32 { 999 }
pub fn inc(x: i32) -> i32 { x + 100 }

impl Counter {
    pub fn new(initial: i32) -> Self {
        Self { value: initial, tag: "default" }
    }

    pub fn with_tag(initial: i32, move tag: string) -> Counter {
        Counter { value: initial, tag: tag }
    }

    pub fn value(&self) -> i32 {
        self.secret_offset() + self.value
    }

    fn secret_offset(&self) -> i32 { 0 }

    pub fn inc(&mut self) {
        self.value = self.value + 1
    }

    pub fn add(&mut self, delta: i32) {
        self.value = self.value + delta
    }

    pub fn merge(&mut self, other: &Self) {
        self.value = self.value + other.value
    }

    pub fn merge_mut(&mut self, other: &mut Counter) {
        self.value = self.value + other.value
        other.value = 0
    }

    pub fn into_parts(self) -> i32 {
        total := self.value + i32(self.tag.len)
        total
    }

    pub fn bump_and_finish(mut self, delta: i32) -> i32 {
        self.add(delta)
        self.value
    }

    pub fn label(&self) -> string {
        self.tag.clone()
    }
}

impl Mode {
    pub fn from_code(code: i32) -> Self {
        if code <= 0 { Self.Slow } else { Self.Fast(code) }
    }

    pub fn speed(&self) -> i32 {
        match self {
            Self.Slow => 1,
            Self.Fast(n) => n,
        }
    }
}
