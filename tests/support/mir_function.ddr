import ...selfhost.mir.mir

pub fn same(a: &mir.Function, b: &mir.Function) {
    assert(a.valid == b.valid)
    assert(a.verified == b.verified)
    assert(a.optimizable == b.optimizable)
    assert(a.unknown_control == b.unknown_control)
    assert(a.platform == b.platform)
    assert(a.first_word == b.first_word)
    assert(a.first_label == b.first_label)
    assert(a.first_reloc == b.first_reloc)
    assert(a.first_import == b.first_import)
    assert(a.source_types.eq(&b.source_types))
    assert(a.encoded.eq(&b.encoded))
    assert(a.source_words == b.source_words)
    assert(a.source_labels == b.source_labels)
    assert(a.source_relocs == b.source_relocs)
    assert(a.source_imports == b.source_imports)
    assert(a.kinds.eq(&b.kinds))
    assert(a.opcodes.eq(&b.opcodes))
    assert(a.dst.eq(&b.dst))
    assert(a.a.eq(&b.a))
    assert(a.b.eq(&b.b))
    assert(a.c.eq(&b.c))
    assert(a.imm.eq(&b.imm))
    assert(a.aux.eq(&b.aux))
    assert(a.variant.eq(&b.variant))
    assert(a.types.eq(&b.types))
    assert(a.place.eq(&b.place))
    assert(a.extensions.eq(&b.extensions))
    assert(a.effects.eq(&b.effects))
    assert(a.flags.eq(&b.flags))
    assert(a.abi.eq(&b.abi))
    assert(a.reads.eq(&b.reads))
    assert(a.writes.eq(&b.writes))
    assert(a.clobbers.eq(&b.clobbers))
    assert(a.origins.eq(&b.origins))
    assert(a.raw_starts.eq(&b.raw_starts))
    assert(a.widths.eq(&b.widths))
    assert(a.modes.eq(&b.modes))
    assert(a.recipes.eq(&b.recipes))
    assert(a.stack_roles.eq(&b.stack_roles))
    assert(a.targets.eq(&b.targets))
    assert(a.reloc_kinds.eq(&b.reloc_kinds))
    assert(a.import_ids.eq(&b.import_ids))
    assert(a.order.eq(&b.order))
    assert(a.raw.eq(&b.raw))
    assert(a.place_kinds.eq(&b.place_kinds))
    assert(a.place_offsets.eq(&b.place_offsets))
    assert(a.place_widths.eq(&b.place_widths))
    assert(a.place_extensions.eq(&b.place_extensions))
    assert(a.place_escaped.eq(&b.place_escaped))
    assert(a.place_table.eq(&b.place_table))
    assert(a.place_probes == b.place_probes)
    assert(a.block_starts.eq(&b.block_starts))
    assert(a.block_ends.eq(&b.block_ends))
    assert(a.op_blocks.eq(&b.op_blocks))
    assert(a.edge_from.eq(&b.edge_from))
    assert(a.edge_to.eq(&b.edge_to))
    assert(a.edge_kinds.eq(&b.edge_kinds))
    assert(a.edge_starts.eq(&b.edge_starts))
    assert(a.label_ids.eq(&b.label_ids))
    assert(a.label_ops.eq(&b.label_ops))
    assert(a.boundaries.eq(&b.boundaries))
    assert(a.leaders.eq(&b.leaders))
    assert(a.visits == b.visits)
    assert(a.budget_exhausted == b.budget_exhausted)
}
