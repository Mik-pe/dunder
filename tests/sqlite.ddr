capability filesystem
import ..stdlib.sqlite as sqlite
import std.json as json
import sys

fn must_exec(db: &sqlite.Database, sql: string, params: &[]string) {
    result := db.exec(sql, &params)
    if !result.ok { print(result.error) }
    assert(result.ok)
}

fn main() {
    none: []string = []
    path := sys.arg(1)
    opened := sqlite.Database::open(path, false)
    if !opened.ok { print(opened.error) }
    assert(opened.ok)
    mut db := opened.db
    must_exec(&db, "CREATE TABLE items(id INTEGER PRIMARY KEY, value TEXT NOT NULL, number INTEGER, real REAL, absent TEXT)", &none)
    values: []string = ["åäö 雪\0after", "9223372036854775807", "1.2345678901234567"]
    inserted := db.exec("INSERT INTO items(value,number,real) VALUES(?,?,?)", &values)
    if !inserted.ok { print(inserted.error) }
    assert(inserted.ok && inserted.changes == 1 && inserted.last_id == 1)
    empty: []string = [""]
    must_exec(&db, "INSERT INTO items(value) VALUES(?)", &empty)
    malicious: []string = ["x'); DROP TABLE items; --"]
    must_exec(&db, "INSERT INTO items(value) VALUES(?)", &malicious)
    rows := db.query("SELECT id,value,number,real,absent FROM items ORDER BY id", &none)
    if !rows.ok { print(rows.error) }
    assert(rows.ok && rows.rows.len == 3)
    first := json.Doc::parse_text(rows.rows[0])
    assert(first.ok)
    assert(first.get_i64(first.root, "id").value == 1)
    assert(first.get_str(first.root, "value").value == values[0])
    assert(first.get_i64(first.root, "number").value == 9223372036854775807)
    assert(first.kind(first.field(first.root, "absent")) == .Null)
    second := json.Doc::parse_text(rows.rows[1])
    assert(second.ok && second.get_str(second.root, "value").value == "")
    print(rows.rows[0])
    print(rows.rows[1])
    print(rows.rows[2])

    // A rejected request never executes its first statement. This includes
    // compile-time PRAGMAs, whose mutation can occur before sqlite3_step.
    rejected := db.exec("DELETE FROM items; DROP TABLE items", &none)
    assert(!rejected.ok)
    pragma := db.exec("PRAGMA cache_size=123; DELETE FROM items", &none)
    assert(!pragma.ok)
    cache := db.query("PRAGMA cache_size", &none)
    assert(cache.ok && cache.rows.len == 1)
    cache_doc := json.Doc::parse_text(cache.rows[0])
    assert(cache_doc.get_i64(cache_doc.root, "cache_size").value != 123)
    mismatch := db.exec("DELETE FROM items WHERE value=?", &none)
    assert(!mismatch.ok)
    mismatch_extra := db.exec("DELETE FROM items", &empty)
    assert(!mismatch_extra.ok)
    invalid := db.exec("DELETE FROM items\0", &none)
    assert(!invalid.ok)
    missing := db.query("SELECT missing FROM items", &none)
    assert(!missing.ok)
    readonly_query := db.query("DELETE FROM items", &none)
    assert(!readonly_query.ok)
    count := db.query("SELECT count(*) AS total FROM items", &none)
    count_doc := json.Doc::parse_text(count.rows[0])
    assert(count.ok && count_doc.get_i64(count_doc.root, "total").value == 3)

    // Semicolons in strings/comments and valid triggers remain one statement.
    must_exec(&db, "CREATE TABLE audit(value TEXT)", &none)
    must_exec(&db, "CREATE TRIGGER record_insert AFTER INSERT ON items BEGIN INSERT INTO audit(value) VALUES('semi;colon'); INSERT INTO audit(value) VALUES(new.value); END; /* final ; comment */", &none)
    must_exec(&db, "INSERT INTO items(value) VALUES('trigger'); -- trailing comment\n", &none)
    audit := db.query("SELECT value FROM audit ORDER BY rowid", &none)
    assert(audit.ok && audit.rows.len == 2)
    name := json.Doc::parse_text(audit.rows[0])
    assert(name.get_str(name.root, "value").value == "semi;colon")
    blob := db.query("SELECT X'0001' AS raw", &none)
    assert(!blob.ok)
    bad_utf8 := db.query("SELECT CAST(X'ff' AS TEXT) AS raw", &none)
    assert(!bad_utf8.ok)
    finite := db.query("SELECT 1e999 AS value", &none)
    assert(!finite.ok)
    large := db.query("WITH RECURSIVE n(x) AS(VALUES(0) UNION ALL SELECT x+1 FROM n WHERE x<10000) SELECT x FROM n", &none)
    assert(!large.ok)
    must_exec(&db, "CREATE TABLE binary_values(label TEXT, data BLOB, suffix TEXT)", &none)
    sides: []string = ["before", "after"]
    data: []u8 = [0, 1, 127, 128, 255]
    stored_blob := db.exec_blob("INSERT INTO binary_values(label,data,suffix) VALUES(?,?,?)", &sides, 2, &data)
    assert(stored_blob.ok && stored_blob.changes == 1)
    binary_rows := db.query("SELECT label,hex(data) AS data,suffix,typeof(data) AS kind FROM binary_values", &none)
    assert(binary_rows.ok && binary_rows.rows.len == 1)
    binary_doc := json.Doc::parse_text(binary_rows.rows[0])
    assert(binary_doc.get_str(binary_doc.root, "data").value == "00017F80FF")
    assert(binary_doc.get_str(binary_doc.root, "label").value == "before" && binary_doc.get_str(binary_doc.root, "suffix").value == "after")
    assert(binary_doc.get_str(binary_doc.root, "kind").value == "blob")
    empty_blob: []u8 = []
    assert(db.exec_blob("INSERT INTO binary_values(data) VALUES(?)", &none, 1, &empty_blob).ok)
    empty_rows := db.query("SELECT typeof(data) AS kind,length(data) AS size FROM binary_values WHERE rowid=2", &none)
    empty_doc := json.Doc::parse_text(empty_rows.rows[0])
    assert(empty_doc.get_str(empty_doc.root, "kind").value == "blob" && empty_doc.get_i64(empty_doc.root, "size").value == 0)
    assert(!db.exec_blob("DELETE FROM binary_values; SELECT ?", &none, 1, &data).ok)
    assert(!db.exec_blob("DELETE FROM binary_values", &none, 0, &data).ok)
    returned := db.execute_rows("INSERT INTO binary_values(label) VALUES('returned') RETURNING label", &none)
    assert(returned.ok && returned.rows.len == 1)
    returned_doc := json.Doc::parse_text(returned.rows[0])
    assert(returned_doc.get_str(returned_doc.root, "label").value == "returned")
    assert(db.close().ok && db.close().ok)
    assert(!db.query("SELECT 1", &none).ok)
    assert(!db.exec("SELECT 1", &none).ok)

    read_opened := sqlite.Database::open(path, true)
    assert(read_opened.ok)
    mut read_db := read_opened.db
    read_rows := read_db.query("SELECT count(*) AS total FROM items", &none)
    assert(read_rows.ok && read_rows.rows.len == 1)
    assert(!read_db.exec("DELETE FROM items", &none).ok)
    assert(read_db.close().ok)
    bad_open := sqlite.Database::open("invalid\0path", false)
    assert(!bad_open.ok)
    print("sqlite ok")
}
