import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_lower as lower
import ..selfhost.mir_liveness as live
import ..selfhost.mir_opt as opt

fn lifted(code: &arm.Code) -> mir.Function {
    none: []i32 = []; var f := mir.new()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &none, 0)); assert(verify.verify(&mut f)); f
}
fn compare(code: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut code, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn add(code: &mut arm.Code, d: i32, a: i32, b: i32) { arm.emit(&mut code, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(d)) }
fn loop_code(platform: i32) -> arm.Code {
    var code := arm.new_for(platform); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 3)
    arm.imm(&mut code, 0, 0); arm.store(&mut code, 0, 0); arm.store(&mut code, 1, 0)
    arm.imm(&mut code, 0, 10); arm.store(&mut code, 2, 0)
    head := arm.label(&mut code); done := arm.label(&mut code); arm.mark(&mut code, head)
    arm.load(&mut code, 0); arm.push(&mut code, 0); arm.load(&mut code, 2); arm.pop(&mut code, 1)
    compare(&mut code, 1, 0); arm.branch(&mut code, done, 12)
    arm.load(&mut code, 1); arm.push(&mut code, 0); arm.load(&mut code, 0); arm.pop(&mut code, 1)
    add(&mut code, 0, 1, 0); arm.store(&mut code, 1, 0)
    arm.load(&mut code, 0); arm.imm(&mut code, 1, 1); add(&mut code, 0, 0, 1); arm.store(&mut code, 0, 0)
    arm.branch(&mut code, head, 0); arm.mark(&mut code, done); arm.load(&mut code, 1); arm.ret(&mut code); code
}
@test fn whole_loop_places_become_resident_without_expression_stack_aliasing() {
    var work := opt.new(); var lowering := lower.new()
    for platform in 0..4 {
        var code := loop_code(platform); var f := lifted(&code); var none: []i32 = []
        assert(f.optimizable && opt.analyze_into(&mut work, &f))
        assert(opt.promoted(&work) == 3 && opt.removed_loads(&work) == 6 && opt.removed_stores(&work) == 5)
        assert(opt.loop_blocks(&work) == 2 && opt.barrier_count(&work) == 0)
        opt.apply(&mut work, &mut f); assert(opt.status(&work) == 2 && !f.verified)
        assert(verify.verify(&mut f)); assert(lower.prepare(&mut lowering, &f, &code, &none))
        lower.commit_code(&mut lowering, &mut code); lower.commit_imports(&mut lowering, &mut none)
        assert(code.words.len > 0)
        // Verify rewritten loop blocks contain no frame transfers; the fresh
        // preservation cells remain in entry/exit blocks outside that SCC.
        var liveness := live.new(); assert(live.analyze_into(&mut liveness, &f, 100000))
        for op in 0..f.kinds.len {
            if live.loop_block(&liveness, f.op_blocks[op]) {
                assert(f.kinds[op] != 7 && f.kinds[op] != 8)
            }
        }
    }
}
@test fn late_owned_initializer_backward_jump_is_not_a_loop() {
    var code := arm.new(); body := arm.label(&mut code); init := arm.label(&mut code)
    arm.branch(&mut code, init, 0); arm.mark(&mut code, body); arm.imm(&mut code, 0, 42); arm.ret(&mut code)
    arm.mark(&mut code, init); arm.imm(&mut code, 0, 0); arm.branch(&mut code, body, 0)
    f := lifted(&code); var work := live.new(); assert(live.analyze_into(&mut work, &f, 10000))
    for block in 0..f.block_starts.len { assert(live.reachable(&work, block) && !live.loop_block(&work, block)) }
}
@test fn physical_liveness_preserves_flags_and_separates_call_may_clobbers() {
    var code := arm.new(); next := arm.label(&mut code); called := arm.label(&mut code)
    arm.imm(&mut code, 0, 5); arm.imm(&mut code, 1, 7); compare(&mut code, 0, 1)
    arm.branch(&mut code, next, 2); arm.mov(&mut code, 2, 0); arm.mark(&mut code, next)
    arm.branch(&mut code, called, 1); arm.mov(&mut code, 3, 14); arm.ret(&mut code)
    f := lifted(&code); var work := live.new(); assert(live.analyze_into(&mut work, &f, 10000))
    assert(live.flags_after(&work, 2)); assert(live.live_after(&work, 0).bit_and(1) != 0)
    for op in 0..f.kinds.len {
        if f.kinds[op] == 14 { assert(f.writes[op] == 0 && f.clobbers[op] == -1) }
    }
}
@test fn budget_and_escape_fail_without_mutating_the_input_and_workspace_reuses() {
    code := loop_code(0); var f := lifted(&code); var work := opt.new()
    old_kinds := f.kinds; old_order := f.order; old_modes := f.modes; old_places := f.place_offsets
    assert(!opt.analyze_budget(&mut work, &f, 0) && opt.status(&work) == -3)
    assert(f.verified && f.kinds.len == old_kinds.len && f.order.len == old_order.len && f.place_offsets.len == old_places.len)
    for op in 0..f.kinds.len { assert(f.kinds[op] == old_kinds[op] && f.modes[op] == old_modes[op]) }
    for p in 0..f.place_kinds.len { f.place_escaped[p] = true }
    assert(verify.verify(&mut f)); assert(!opt.analyze_into(&mut work, &f) && opt.status(&work) == -2)
    f = lifted(&code); assert(opt.analyze_into(&mut work, &f)); opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
}
@test fn partial_width_and_overlapping_frame_places_never_become_raw_copies() {
    var work := opt.new()
    for size in 0..3 {
        var code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 2)
        for repeat in 0..8 {
            // STURB/H/W and LDURB/H/W at the same byte range need explicit
            // truncation/extension, which this full-cell promotion excludes.
            arm.emit(&mut code, 939524096 + i64(size) * 1073741824 + 504 * 4096 + 29 * 32)
            arm.emit(&mut code, 943718400 + i64(size) * 1073741824 + 504 * 4096 + 29 * 32 + 1)
        }
        arm.ret(&mut code); f := lifted(&code)
        assert(!opt.analyze_into(&mut work, &f) && opt.status(&work) == -2)
    }
    code := loop_code(0); var f := lifted(&code)
    overlapping := mir.add_place(&mut f, 1, -4, 8, 0); assert(verify.verify(&mut f))
    assert(opt.analyze_into(&mut work, &f) && opt.promoted(&work) == 2)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
    var retained := 0
    for op in 0..f.kinds.len {
        if (f.kinds[op] == 7 || f.kinds[op] == 8) && f.place_offsets[f.place[op]] == -8 { retained = retained + 1 }
    }
    assert(retained == 5)
}
@test fn arbitrary_sp_memory_and_nonstandard_returns_are_refused_atomically() {
    var work := opt.new(); var code := loop_code(0)
    // Append unreachable arbitrary SP memory: whole-function shape must still
    // be safe; this is not a source-region island around the hot loop.
    arm.emit(&mut code, 4181721088 + 31 * 32)
    f := lifted(&code); assert(!opt.analyze_into(&mut work, &f) && opt.status(&work) == -2)
    code = loop_code(0); arm.emit(&mut code, 3596551104)
    second := lifted(&code); assert(!opt.analyze_into(&mut work, &second) && opt.status(&work) == -2)
}
@test fn large_preservation_cells_declare_scratch_and_refuse_live_physical_values() {
    var work := opt.new(); var lowering := lower.new(); var none: []i32 = []
    for platform in 0..4 {
        var code := loop_code(platform); arm.frame(&mut code, 2, 64)
        var f := lifted(&code); assert(opt.analyze_into(&mut work, &f)); opt.apply(&mut work, &mut f)
        assert(verify.verify(&mut f)); assert(lower.prepare(&mut lowering, &f, &code, &none))
        lower.commit_code(&mut lowering, &mut code); lower.commit_imports(&mut lowering, &mut none)
        var large := 0
        for op in 0..f.kinds.len {
            if f.modes[op] == 1 && (f.kinds[op] == 7 || f.kinds[op] == 8) && f.imm[op] < -256 {
                large = large + 1; assert(f.c[op] == 9 && f.clobbers[op] == mir.variable_bit(9))
            }
        }
        assert(large == 6)
    }
    var code := loop_code(0); arm.frame(&mut code, 2, 64)
    code.words[4] = 2852127712 + 9 * 65536 // MOV x0,x9: incoming scratch is now actually live.
    f := lifted(&code); assert(!opt.analyze_into(&mut work, &f) && opt.status(&work) == -2)
}
@test fn return_liveouts_preserve_result_and_new_home_values_without_pinning_every_home() {
    code := loop_code(0); var f := lifted(&code); var work := opt.new(); var liveness := live.new()
    assert(opt.analyze_into(&mut work, &f) && opt.promoted(&work) == 3)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
    assert(live.analyze_into(&mut liveness, &f, 100000))
    var result := false; var restored := false
    for op in 0..f.kinds.len {
        if f.kinds[op] == 15 {
            for reg in 25..29 { assert(f.reads[op].bit_and(mir.variable_bit(reg)) != 0) }
            assert(f.reads[op].bit_and(1) != 0 && f.reads[op].bit_and(mir.variable_bit(31)) != 0)
        }
        if f.kinds[op] == 7 && f.modes[op] == 1 && f.dst[op] == 25 {
            restored = true; assert(live.live_after(&liveness, op).bit_and(mir.variable_bit(25)) != 0)
        }
        if f.kinds[op] == 2 && f.modes[op] == 1 && f.dst[op] == 0 {
            result = true; assert(live.live_after(&liveness, op).bit_and(1) != 0)
        }
    }
    assert(result && restored)
    // A real body operand still pins that physical register. Implicit ABI
    // liveouts alone do not; the three homes are now x26,x27,x28.
    var incoming := loop_code(0); incoming.words[4] = 2852127712 + 25 * 65536
    f = lifted(&incoming); assert(opt.analyze_into(&mut work, &f) && opt.promoted(&work) == 3)
    opt.apply(&mut work, &mut f); assert(verify.verify(&mut f))
    for op in 0..f.kinds.len { if f.modes[op] == 1 { assert(f.dst[op] != 25) } }
}
