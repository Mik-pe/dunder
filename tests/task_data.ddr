import ..selfhost.task_data as data

struct Schema {
    kinds: []i32, bases: []i32, starts: []i32, counts: []i32, fields: []i32,
    primitives: []i32, complete: []bool, c_layout: []bool, owners: []i32, classes: []i32,
}
fn schema() -> Schema { Schema { kinds: [], bases: [], starts: [], counts: [], fields: [],
    primitives: [], complete: [], c_layout: [], owners: [], classes: [] } }
fn add(s: &mut Schema, kind: i32, base: i32, primitive: i32, c_layout: bool, owner: i32, classification: i32) -> i32 {
    ty := s.kinds.len; s.kinds.push(kind); s.bases.push(base); s.starts.push(s.fields.len); s.counts.push(0)
    s.primitives.push(primitive); s.complete.push(true); s.c_layout.push(c_layout)
    s.owners.push(owner); s.classes.push(classification); ty
}
fn field(s: &mut Schema, ty: i32, child: i32) {
    assert(s.starts[ty] + s.counts[ty] == s.fields.len)
    s.fields.push(child); s.counts[ty] = s.counts[ty] + 1
}
fn sample() -> Schema {
    var s := schema()
    unit := add(&mut s, 0, 0, 1, false, -1, 0)
    number := add(&mut s, 0, 0, 3, false, -1, 0)
    text := add(&mut s, 0, 0, 5, false, -1, 0)
    pointer := add(&mut s, 0, 0, 14, false, -1, 0)
    tag := add(&mut s, 3, 0, 0, false, -1, 0); field(&mut s, tag, unit); field(&mut s, tag, unit)
    array := add(&mut s, 1, number, 0, false, -1, 0)
    fixed := add(&mut s, 6, number, 0, false, -1, 0); s.counts[fixed] = 4
    record := add(&mut s, 2, 0, 0, false, -1, 0); field(&mut s, record, array); field(&mut s, record, fixed)
    bad_record := add(&mut s, 2, 0, 0, false, -1, 0); field(&mut s, bad_record, text)
    payload := add(&mut s, 7, 0, 0, false, -1, 0)
    borrow := add(&mut s, 4, record, 0, false, -1, 0)
    function := add(&mut s, 9, 0, 0, false, -1, 0)
    scratch := add(&mut s, 20, 0, 0, false, -1, 0)
    task_id := add(&mut s, 22, 0, 0, false, -1, 0)
    record_array := add(&mut s, 1, record, 0, false, -1, 0)
    inline_record := add(&mut s, 2, 0, 0, true, -1, 0); field(&mut s, inline_record, number); field(&mut s, inline_record, fixed)
    bad_inline := add(&mut s, 2, 0, 0, true, -1, 0); field(&mut s, bad_inline, array)
    opaque_data := add(&mut s, 2, 0, 0, false, 7, 2); field(&mut s, opaque_data, array)
    opaque_unknown := add(&mut s, 2, 0, 0, false, 7, 1); field(&mut s, opaque_unknown, number)
    thread_bound := add(&mut s, 2, 0, 0, false, 7, 3); field(&mut s, thread_bound, number)
    cycle_a := add(&mut s, 2, 0, 0, false, -1, 0); field(&mut s, cycle_a, 21)
    cycle_b := add(&mut s, 2, 0, 0, false, -1, 0); field(&mut s, cycle_b, cycle_a)
    cycle_parent := add(&mut s, 2, 0, 0, false, -1, 0); field(&mut s, cycle_parent, cycle_a)
    iterator := add(&mut s, 10, number, 0, false, -1, 0)
    future_primitive := add(&mut s, 0, 0, 999, false, -1, 0)
    nested := add(&mut s, 2, 0, 0, false, -1, 0)
    field(&mut s, nested, record); field(&mut s, nested, inline_record); field(&mut s, nested, opaque_data)
    payload_record := add(&mut s, 2, 0, 0, false, -1, 0); field(&mut s, payload_record, payload)
    opaque_bad := add(&mut s, 2, 0, 0, false, 7, 2); field(&mut s, opaque_bad, text)
    opaque_inline := add(&mut s, 2, 0, 0, true, 7, 2); field(&mut s, opaque_inline, number)
    s
}
fn analyze(w: &mut data.Workspace, s: &Schema) -> bool {
    data.analyze_into(&mut w, &s.kinds, &s.bases, &s.starts, &s.counts, &s.fields,
        &s.primitives, &s.complete, &s.c_layout, &s.owners, &s.classes)
}
@test fn task_data_matches_actual_scalar_array_record_and_opaque_clone_contracts() {
    s := sample(); var w := data.new(); assert(analyze(&mut w, &s) && data.status(&w) == 1)
    allowed: []i32 = [0, 1, 4, 5, 6, 7, 15, 17, 25, 28]
    inline: []i32 = [1, 4, 6, 15, 28]
    for ty in 0..s.kinds.len {
        var expected := false; for member in allowed { if member == ty { expected = true } }
        assert(data.is_data(&w, ty) == expected)
        var expected_inline := false; for member in inline { if member == ty { expected_inline = true } }
        assert(data.inline_data(&w, ty) == expected_inline)
    }
    assert(data.reason(&w, 2) == 2 && data.reason(&w, 3) == 4)
    assert(data.reason(&w, 8) == 11 && data.reason(&w, 9) == 2)
    assert(data.reason(&w, 10) == 3 && data.reason(&w, 11) == 5 && data.reason(&w, 12) == 6)
    assert(data.reason(&w, 13) == 1 && data.reason(&w, 14) == 10)
    assert(data.reason(&w, 16) == 12 && data.reason(&w, 18) == 8 && data.reason(&w, 19) == 9)
    assert(data.reason(&w, 20) == 13 && data.reason(&w, 21) == 13 && data.reason(&w, 22) == 13)
    assert(data.reason(&w, 23) == 7 && data.reason(&w, 24) == 1)
    assert(data.reason(&w, 26) == 11 && data.reason(&w, 27) == 11)
    assert(!data.is_data(&w, -1) && !data.is_data(&w, s.kinds.len))
}
@test fn data_analysis_failure_is_closed_and_reused_workspace_recovers() {
    var s := sample(); var w := data.new(); assert(analyze(&mut w, &s)); units := data.units(&w)
    assert(!data.analyze_budget(&mut w, &s.kinds, &s.bases, &s.starts, &s.counts, &s.fields,
        &s.primitives, &s.complete, &s.c_layout, &s.owners, &s.classes, units - 1))
    assert(data.status(&w) == -2 && !data.is_data(&w, 1) && data.reason(&w, 1) == -1)
    assert(analyze(&mut w, &s) && data.is_data(&w, 1))
    original := s.fields[0]; s.fields[0] = s.kinds.len
    assert(!analyze(&mut w, &s) && data.status(&w) == -1 && !data.is_data(&w, 1))
    s.fields[0] = original; assert(analyze(&mut w, &s))
    owner := s.owners[17]; s.owners[17] = -1
    assert(!analyze(&mut w, &s) && data.status(&w) == -1)
    s.owners[17] = owner; assert(analyze(&mut w, &s) && data.is_data(&w, 17))
    s.kinds.push(0); assert(!analyze(&mut w, &s) && data.status(&w) == -1)
    removed := s.kinds.pop(); assert(analyze(&mut w, &s) && data.is_data(&w, 25))
}
@test fn incomplete_forward_types_never_masquerade_as_empty_data_records() {
    var s := sample(); var w := data.new()
    s.complete[7] = false
    assert(analyze(&mut w, &s) && !data.is_data(&w, 7) && data.reason(&w, 7) == 14)
    assert(!data.is_data(&w, 25) && data.reason(&w, 25) == 11)
    s.complete[7] = true
    assert(analyze(&mut w, &s) && data.is_data(&w, 7) && data.is_data(&w, 25))
}
@test fn resealing_a_changed_nominal_record_rechecks_its_shared_fields() {
    var s := schema(); number := add(&mut s, 0, 0, 3, false, -1, 0)
    text := add(&mut s, 0, 0, 5, false, -1, 0)
    record := add(&mut s, 2, 0, 0, false, -1, 0); s.complete[record] = false
    var w := data.new(); assert(analyze(&mut w, &s) && !data.is_data(&w, record))
    s.complete[record] = true
    assert(analyze(&mut w, &s) && data.is_data(&w, record))
    s.complete[record] = false; field(&mut s, record, text)
    assert(analyze(&mut w, &s) && !data.is_data(&w, record) && data.reason(&w, record) == 14)
    s.complete[record] = true
    assert(analyze(&mut w, &s) && !data.is_data(&w, record) && data.reason(&w, record) == 11)
    assert(data.is_data(&w, number))
}
@test fn forward_record_dependencies_and_cycles_use_linear_work() {
    var s := schema(); count := 1025
    for ty in 0..count {
        var kind := 2; var primitive := 0; if ty == count - 1 { kind = 0; primitive = 3 }
        added := add(&mut s, kind, 0, primitive, false, -1, 0)
        if ty < count - 1 { field(&mut s, ty, ty + 1) }
    }
    var w := data.new(); assert(analyze(&mut w, &s))
    for ty in 0..count { assert(data.is_data(&w, ty)) }
    assert(data.units(&w) < count * 64)
    s.kinds[count - 1] = 2; s.primitives[count - 1] = 0; field(&mut s, count - 1, 0)
    assert(analyze(&mut w, &s))
    for ty in 0..count { assert(!data.is_data(&w, ty) && data.reason(&w, ty) == 13) }
    assert(data.units(&w) < count * 64)
}
