import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_decode as decode
import ..selfhost.mir_retained as retained

fn all(f: &mir.Function) {
    var d := decode.new()
    for op in 0..f.kinds.len { assert(retained.validate(&mut d, &f, op)) }
}
fn lifted(code: &arm.Code, sites: &[]i32) -> mir.Function {
    var f := mir.new(); assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut f)); all(&f); f
}
@test fn raw_words_and_all_symbolic_units_redecode_exactly() {
    var code := arm.new(); prologue := arm.prologue(&mut code); arm.frame(&mut code, prologue, 64)
    arm.imm(&mut code, 0, -2147483648); arm.mov(&mut code, 1, 0)
    arm.load(&mut code, 2); arm.store(&mut code, 2, 1); arm.push(&mut code, 0); arm.pop(&mut code, 3)
    words: []i64 = [3573751839, 4294967295, 2594113536, 2657551328, 2657484831,
        505423872, 505427968, 505415680, 505419776, 505421824,
        505462784, 505495552, 505528320, 509755392, 505593856,
        2653028352, 2653093888, 2654470144, 2654535680,
        505790464, 505757696, 505724928, 505823232, 505692160,
        3506439200, 2868903968, 3405774880, 2600467488, 2591817728,
        2596077568, 448792576, 448791552, 448798720]
    for i in 0..words.len { arm.emit(&mut code, words[i]) }
    arm.ret(&mut code); sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds.len > 30)
    for kind in 0..21 {
        var symbolic := arm.new(); target := arm.label(&mut symbolic)
        arm.branch(&mut symbolic, target, kind); value := lifted(&symbolic, &sites)
        assert(value.recipes[0] == 4)
    }
    for marker in 0..2 {
        var imported := arm.new(); var first: i64 = 0; if marker == 1 { first = 4244635648 }
        arm.emit(&mut imported, first); arm.emit(&mut imported, 0)
        imports: []i32 = [0]; value := lifted(&imported, &imports)
        assert(value.recipes[0] == 5)
    }
}
fn change(f: &mut mir.Function, op: i32, field: i32) {
    if field == 0 { f.kinds[op] = f.kinds[op] + 1 }
    if field == 1 { f.opcodes[op] = f.opcodes[op] + 1 }
    if field == 2 { f.dst[op] = f.dst[op] + 1 }
    if field == 3 { f.a[op] = f.a[op] + 1 }
    if field == 4 { f.b[op] = f.b[op] + 1 }
    if field == 5 { f.c[op] = f.c[op] + 1 }
    if field == 6 { f.imm[op] = f.imm[op] + 1 }
    if field == 7 { f.aux[op] = f.aux[op] + 1 }
    if field == 8 { f.variant[op] = f.variant[op] + 1 }
    if field == 9 { f.types[op] = f.types[op] + 1 }
    if field == 10 { f.extensions[op] = f.extensions[op] + 1 }
    if field == 11 { f.effects[op] = f.effects[op] + 1 }
    if field == 12 { f.flags[op] = f.flags[op] + 1 }
    if field == 13 { f.abi[op] = f.abi[op] + 1 }
    if field == 14 { f.reads[op] = f.reads[op].bit_xor(1) }
    if field == 15 { f.writes[op] = f.writes[op].bit_xor(1) }
    if field == 16 { f.clobbers[op] = f.clobbers[op].bit_xor(1) }
    if field == 17 { f.place[op] = 0 }
}
@test fn changing_any_semantic_column_invalidates_retained_replay() {
    var code := arm.new(); arm.mov(&mut code, 0, 1); arm.ret(&mut code)
    sites: []i32 = []; var d := decode.new()
    for field in 0..18 {
        var f := lifted(&code, &sites); change(&mut f, 0, field)
        assert(!retained.validate(&mut d, &f, 0))
    }
    var changed := lifted(&code, &sites)
    changed.a[0] = 2; changed.reads[0] = mir.variable_bit(2)
    assert(!retained.validate(&mut d, &changed, 0))
    changed.modes[0] = 1; assert(retained.validate(&mut d, &changed, 0))
}
fn address(code: &mut arm.Code, slot: i32, reg: i32) {
    if slot < 511 { arm.emit(&mut code, 3506439072 + i64(slot + 1) * 8192 + i64(reg)); return }
    arm.imm(&mut code, reg, i64(slot + 1) * 8)
    arm.emit(&mut code, 3405775776 + i64(reg) * 65537)
}
@test fn complete_frame_recipes_validate_bytes_places_and_scratch() {
    slots: []i32 = [0, 31, 32, 510, 511, 100000]
    regs: []i32 = [0, 9, 29, 31]
    sites: []i32 = []
    for kind in 1..4 { for si in 0..slots.len { for ri in 0..regs.len {
        slot := slots[si]; reg := regs[ri]; if kind == 3 && reg == 31 { continue }
        var code := arm.new()
        if kind == 1 {
            if slot < 32 { arm.emit(&mut code, 4164944800 + i64(-(slot + 1) * 8).bit_and(511) * 4096 + i64(reg)) }
            else { address(&mut code, slot, 9); arm.emit(&mut code, 4181721376 + i64(reg)) }
        } else if kind == 2 { arm.store(&mut code, slot, reg) }
        else { address(&mut code, slot, reg) }
        starts: []i32 = [0]; ends: []i32 = [code.words.len]; kinds: []i32 = [kind]
        a: []i32 = [slot]; b: []i32 = [reg]; var f := mir.new()
        assert(lift.lift_spans(&mut f, &code, 0, 0, 0, &sites, 0, &starts, &ends, &kinds, &a, &b))
        all(&f); var d := decode.new()
        if f.place[0] >= 0 {
            p := f.place[0]; f.place_offsets[p] = f.place_offsets[p] - 8
            assert(!retained.validate(&mut d, &f, 0))
            f.place_offsets[p] = f.place_offsets[p] + 8
        }
        f.writes[0] = f.writes[0].bit_xor(512); assert(!retained.validate(&mut d, &f, 0))
    } } }
}
@test fn proof_recipe_cannot_be_inferred_from_mutable_effects() {
    var code := arm.new(); arm.load(&mut code, 0); sites: []i32 = []; var f := lifted(&code, &sites)
    assert(f.effects[0] == 3 && f.recipes[0] == 0)
    f.effects[0] = 2; var d := decode.new(); assert(!retained.validate(&mut d, &f, 0))
}
@test fn decoder_scratch_does_not_leak_prior_operands_or_places() {
    var d := decode.new(); decode.decode_into(&mut d, 4164944800, 0)
    assert(d.place_kind == 1)
    decode.decode_into(&mut d, 3573751839, 0)
    assert(d.kind == 18 && d.place_kind == -1 && d.dst == -1 && d.reads == 0 && d.clobbers == 0)
    decode.symbolic(&mut d, 1); assert(d.clobbers == -1)
    decode.decode_into(&mut d, 2852193248, 0)
    assert(d.clobbers == 0 && d.abi == 0)
}
