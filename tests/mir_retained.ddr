import support.mir_object_support as object_support
import ..selfhost.backend.arm64 as arm
import ..selfhost.mir.mir
import .fixtures.mir_machine as lift
import ..selfhost.mir.mir_verify as verify
import .fixtures.mir_machine_decode as decode
import ..selfhost.mir.mir_retained as retained
import ..selfhost.mir.mir_lower as lower

fn all(f: &mir.Function) {
    mut d := decode.new()
    for op in 0..f.kinds.len { assert(retained.validate(&mut d, &f, op)) }
}
fn lifted(code: &arm.Code, sites: &[]i32) -> mir.Function {
    mut f := mir.new(); assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    assert(verify.verify(&mut f)); all(&f); f
}
@test fn indexed_array_access_keeps_address_inputs_and_unknown_place() {
    mut code := arm.new()
    // LDR X0,[X9,X10,LSL #3]; STR X2,[X9,X10,LSL #3].
    arm.emit(&mut code, 4167727392); arm.emit(&mut code, 4163533090); arm.ret(&mut code)
    mut sites: []i32 = []; mut f := lifted(&code, &sites)
    address := mir.variable_bit(9).bit_or(mir.variable_bit(10))
    assert(f.kinds[0] == 7 && f.dst[0] == 0 && f.reads[0] == address && f.writes[0] == 1)
    assert(f.kinds[1] == 8 && f.reads[1] == address.bit_or(mir.variable_bit(2)) && f.writes[1] == 0)
    assert(f.place_kinds[f.place[0]] == 0 && f.place_kinds[f.place[1]] == 0)
    assert(f.effects[0] == 3 && f.effects[1] == 5)
    assert(object_support.lower_and_link(&f, &mut code, &mut sites))
    assert(code.words[0] == 4167727392 && code.words[1] == 4163533090)
    mut d := decode.new()
    for platform in [2, 3] {
        decode.word(&mut d, code.words[0], platform); assert(d.kind == 0)
    }
}
@test fn raw_words_and_all_symbolic_units_redecode_exactly() {
    mut code := arm.new(); prologue := arm.prologue(&mut code); arm.frame(&mut code, prologue, 64)
    arm.imm(&mut code, 0, -2147483648); arm.mov(&mut code, 1, 0)
    arm.load(&mut code, 2); arm.store(&mut code, 2, 1); arm.push(&mut code, 0); arm.pop(&mut code, 3)
    words: []i64 = [3573751839, 4294967295, 2594113536, 2657551328, 2657484831,
        505423872, 505427968, 505415680, 505419776, 505421824,
        505462784, 505495552, 505528320, 509755392, 505593856,
        2653028352, 2653093888, 2654470144, 2654535680,
        505790464, 505757696, 505724928, 505823232, 505692160,
        3506439200, 2868903968, 3405774880, 2600467488, 2591817728,
        2596077568, 448792576, 448791552, 448798720]
    for i in 0..words.len { arm.emit(&mut code, words[i]) }
    arm.ret(&mut code); sites: []i32 = []; f := lifted(&code, &sites)
    assert(f.kinds.len > 30)
    for kind in 0..21 {
        mut symbolic := arm.new(); target := arm.label(&mut symbolic)
        arm.branch(&mut symbolic, target, kind); value := lifted(&symbolic, &sites)
        assert(value.recipes[0] == 4)
    }
    for marker in 0..2 {
        mut imported := arm.new(); mut first: i64 = 0; if marker == 1 { first = 4244635648 }
        arm.emit(&mut imported, first); arm.emit(&mut imported, 0)
        imports: []i32 = [0]; value := lifted(&imported, &imports)
        assert(value.recipes[0] == 5)
    }
}
fn change(f: &mut mir.Function, op: i32, field: i32) {
    if field == 0 { f.kinds[op] = f.kinds[op] + 1 }
    if field == 1 { f.opcodes[op] = f.opcodes[op] + 1 }
    if field == 2 { f.dst[op] = f.dst[op] + 1 }
    if field == 3 { f.a[op] = f.a[op] + 1 }
    if field == 4 { f.b[op] = f.b[op] + 1 }
    if field == 5 { f.c[op] = f.c[op] + 1 }
    if field == 6 { f.imm[op] = f.imm[op] + 1 }
    if field == 7 { f.aux[op] = f.aux[op] + 1 }
    if field == 8 { f.variant[op] = f.variant[op] + 1 }
    if field == 9 { f.types[op] = f.types[op] + 1 }
    if field == 10 { f.extensions[op] = f.extensions[op] + 1 }
    if field == 11 { f.effects[op] = f.effects[op] + 1 }
    if field == 12 { f.flags[op] = f.flags[op] + 1 }
    if field == 13 { f.abi[op] = f.abi[op] + 1 }
    if field == 14 { f.reads[op] = f.reads[op].bit_xor(1) }
    if field == 15 { f.writes[op] = f.writes[op].bit_xor(1) }
    if field == 16 { f.clobbers[op] = f.clobbers[op].bit_xor(1) }
    if field == 17 { f.place[op] = 0 }
}
@test fn changing_any_semantic_column_invalidates_retained_replay() {
    mut code := arm.new(); arm.mov(&mut code, 0, 1); arm.ret(&mut code)
    mut sites: []i32 = []; mut d := decode.new()
    for field in 0..18 {
        mut f := lifted(&code, &sites); change(&mut f, 0, field)
        assert(!retained.validate(&mut d, &f, 0))
    }
    mut changed := lifted(&code, &sites)
    changed.a[0] = 2; changed.reads[0] = mir.variable_bit(2)
    assert(!retained.validate(&mut d, &changed, 0))
    changed.modes[0] = 1; assert(retained.validate(&mut d, &changed, 0))
    assert(verify.verify(&mut changed))
    assert(object_support.lower_and_link(&changed, &mut code, &mut sites))
    assert(code.words[0] == 2852258784)
}
fn frame_op(code: &mut arm.Code, kind: i32, slot: i32, reg: i32) {
    if kind == 1 { arm.load_into(&mut code, slot, reg) }
    else if kind == 2 { arm.store(&mut code, slot, reg) }
    else { arm.address(&mut code, slot) }
}
@test fn direct_frame_operations_match_emitter_outputs_and_validate_scratch() {
    for kind in 1..4 { for slot in [0, 31, 32, 510, 511, 8191, 100000] { for reg in [0, 9, 29, 31] {
        if kind == 3 && reg != 0 { continue }
        mut code := arm.new(); mut reference := arm.new()
        arm.begin_mir(&mut code, true)
        frame_op(&mut code, kind, slot, reg); frame_op(&mut reference, kind, slot, reg)
        sites: []i32 = []; mut f := lifted(&code, &sites); mut object := lower.new_object()
        assert(lower.lower_into(&mut object, &f) && lower.object_word_count(&object) == reference.words.len)
        for i in 0..reference.words.len { assert(lower.object_word(&object, i) == reference.words[i]) }
        if f.place[0] >= 0 {
            p := f.place[0]; f.place_offsets[p] = f.place_offsets[p] - 8
            assert(!verify.verify(&mut f)); f.place_offsets[p] = f.place_offsets[p] + 8
        }
        f.writes[0] = f.writes[0].bit_xor(512); assert(!verify.verify(&mut f))
    } } }
}
@test fn proof_recipe_cannot_be_inferred_from_mutable_effects() {
    mut code := arm.new(); arm.load(&mut code, 0); sites: []i32 = []; mut f := lifted(&code, &sites)
    assert(f.effects[0] == 3 && f.recipes[0] == 0)
    f.effects[0] = 2; mut d := decode.new(); assert(!retained.validate(&mut d, &f, 0))
}
@test fn retained_frame_proofs_follow_current_allocation_not_old_encoding() {
    for slot in 7..9 {
        mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 8)
        first := code.words.len; arm.begin_mir(&mut code, true); arm.load(&mut code, slot); arm.ret(&mut code)
        sites: []i32 = []; mut f := mir.new()
        assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
        all(&f); op := mir.boundary(&f, first)
        if slot == 7 {
            assert(f.effects[op] == 2)
            low := f.order[3]; f.modes[low] = 1; f.imm[low] = 0
            assert(!verify.verify(&mut f))
        } else {
            assert(f.effects[op] == 3)
            f.effects[op] = 2; assert(!verify.verify(&mut f))
        }
    }
}
@test fn exposed_frame_values_keep_annotations_potentially_trapping() {
    mut code := arm.new(); frame := arm.prologue(&mut code); arm.frame(&mut code, frame, 8)
    first := code.words.len; arm.begin_mir(&mut code, true); arm.load(&mut code, 0)
    arm.mov(&mut code, 1, 29); arm.ret(&mut code)
    sites: []i32 = []; mut f := mir.new()
    assert(lift.lift(&mut f, &code, 0, 0, 0, &sites, 0))
    all(&f); op := mir.boundary(&f, first)
    assert(f.place_escaped[f.place[op]] && f.effects[op] == 3)
    f.effects[op] = 2; mut d := decode.new(); assert(!verify.verify(&mut f))
}
@test fn decoder_scratch_does_not_leak_prior_operands_or_places() {
    mut d := decode.new(); decode.decode_into(&mut d, 4164944800, 0)
    assert(d.place_kind == 1)
    decode.decode_into(&mut d, 3573751839, 0)
    assert(d.kind == 18 && d.place_kind == -1 && d.dst == -1 && d.reads == 0 && d.clobbers == 0)
    decode.symbolic(&mut d, 1); assert(d.clobbers == -1)
    decode.decode_into(&mut d, 2852193248, 0)
    assert(d.clobbers == 0 && d.abi == 0)
}
