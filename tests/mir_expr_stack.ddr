import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_lower as lower
import ..selfhost.mir_liveness as live
import ..selfhost.mir_call_inputs as inputs
import ..selfhost.mir_terminals as terminals
import ..selfhost.mir_expr_stack as stack

fn add(c: &mut arm.Code, dst: i32, a: i32, b: i32) {
    arm.emit(&mut c, 2332033024 + i64(b) * 65536 + i64(a) * 32 + i64(dst))
}
fn compare(c: &mut arm.Code, a: i32, b: i32) { arm.emit(&mut c, 3942645791 + i64(b) * 65536 + i64(a) * 32) }
fn begin() -> arm.Code {
    var c := arm.new(); arm.begin_mir(&mut c, true)
    frame := arm.prologue(&mut c); arm.frame(&mut c, frame, 0); c
}
fn model(c: &arm.Code) -> mir.Function {
    var f := mir.new(); sites: []i32 = []
    assert(lift.lift_spans(&mut f, &c, 0, 0, 0, &sites, 0,
        &c.mir_starts, &c.mir_ends, &c.mir_kinds, &c.mir_a, &c.mir_b))
    assert(verify.verify(&mut f)); f
}
fn optimize(w: &mut stack.Workspace, f: &mut mir.Function, limit: i32) -> bool {
    context := stack.trusted_source_expression_storage_v1(); exits := terminals.no_terminals(); calls := inputs.conservative()
    stack.optimize_with_context_budget(&mut w, &mut f, &context, &exits, &calls, limit)
}
fn same(a: &mir.Function, b: &mir.Function) {
    assert(a.valid == b.valid && a.verified == b.verified && a.optimizable == b.optimizable)
    assert(a.kinds.len == b.kinds.len && a.order.len == b.order.len && a.raw.len == b.raw.len)
    assert(a.source_words == b.source_words && a.source_labels == b.source_labels && a.source_imports == b.source_imports)
    for op in 0..a.kinds.len {
        assert(a.kinds[op] == b.kinds[op] && a.opcodes[op] == b.opcodes[op] && a.modes[op] == b.modes[op])
        assert(a.dst[op] == b.dst[op] && a.a[op] == b.a[op] && a.b[op] == b.b[op] && a.c[op] == b.c[op])
        assert(a.imm[op] == b.imm[op] && a.aux[op] == b.aux[op] && a.types[op] == b.types[op])
        assert(a.place[op] == b.place[op] && a.extensions[op] == b.extensions[op])
        assert(a.reads[op] == b.reads[op] && a.writes[op] == b.writes[op] && a.clobbers[op] == b.clobbers[op])
        assert(a.flags[op] == b.flags[op] && a.effects[op] == b.effects[op] && a.abi[op] == b.abi[op])
        assert(a.targets[op] == b.targets[op] && a.reloc_kinds[op] == b.reloc_kinds[op] && a.import_ids[op] == b.import_ids[op])
        assert(a.recipes[op] == b.recipes[op] && a.stack_roles[op] == b.stack_roles[op])
        assert(a.origins[op] == b.origins[op] && a.widths[op] == b.widths[op] && a.raw_starts[op] == b.raw_starts[op])
    }
    for at in 0..a.order.len { assert(a.order[at] == b.order[at]) }
    for at in 0..a.raw.len { assert(a.raw[at] == b.raw[at]) }
}
fn word(bytes: &[]u8, pc: i32) -> i64 {
    assert(pc >= 0 && pc + 4 <= bytes.len && pc % 4 == 0)
    i64(bytes[pc]) + i64(bytes[pc + 1]) * 256 + i64(bytes[pc + 2]) * 65536 + i64(bytes[pc + 3]) * 16777216
}
fn signed(value: i64, width: i32) -> i64 {
    limit := i64(1).shl(width); if value >= limit / 2 { value - limit } else { value }
}
fn cell(address: i64) -> i32 { assert(address >= 0 && address < 8192 && address % 8 == 0); i32(address / 8) }
fn gp(regs: &[]i64, reg: i32) -> i64 { if reg == 31 { 0 } else { regs[reg] } }
// Independent final-byte interpreter. It deliberately knows only the closed
// emitted instruction set used by these fixtures and rejects every other word.
fn execute(bytes: &[]u8) -> i64 {
    var regs: []i64 = []; var mem: []i64 = []
    for reg in 0..32 { regs.push(i64(reg) * 997 + 3) }; regs[31] = 4096
    for slot in 0..1024 { mem.push(0) }
    fp := regs[29]; lr := regs[30]; var pc := 0; var equal := false; var fuel := 10000
    while fuel > 0 {
        fuel = fuel - 1; w := word(&bytes, pc); var next := pc + 4
        dst := i32(w.bit_and(31)); a := i32(w.shr(5).bit_and(31)); b := i32(w.shr(16).bit_and(31))
        if w == 2847898621 {
            regs[31] = regs[31] - 16; mem[cell(regs[31])] = regs[29]; mem[cell(regs[31] + 8)] = regs[30]
        } else if w == 2831252477 {
            regs[29] = mem[cell(regs[31])]; regs[30] = mem[cell(regs[31] + 8)]; regs[31] = regs[31] + 16
        } else if w.bit_and(4294967264) == 2847899616 {
            regs[31] = regs[31] - 16; mem[cell(regs[31])] = gp(&regs, dst); mem[cell(regs[31] + 8)] = 0
        } else if w.bit_and(4294967264) == 2831253472 {
            if dst != 31 { regs[dst] = mem[cell(regs[31])] }; regs[31] = regs[31] + 16
        } else if w == 3596551104 {
            assert(regs[31] == 4096 && regs[29] == fp && regs[30] == lr); return regs[0]
        } else if w == 3573751839 {
        } else if w.bit_and(4286578688) == 3531603968 {
            assert(dst != 31); regs[dst] = w.shr(5).bit_and(65535).shl(i32(w.shr(21).bit_and(3)) * 16)
        } else if w.bit_and(4292935648) == 2852127712 {
            assert(dst != 31); regs[dst] = gp(&regs, b)
        } else if w.bit_and(4286578688) == 2432696320 || w.bit_and(4286578688) == 3506438144 {
            value := w.shr(10).bit_and(4095).shl(i32(w.shr(22).bit_and(1)) * 12)
            if w.bit_and(1073741824) != 0 { regs[dst] = regs[a].wrapping_sub(value) }
            else { regs[dst] = regs[a].wrapping_add(value) }
        } else if w.bit_and(4292934656) == 2332033024 {
            assert(dst != 31); regs[dst] = gp(&regs, a).wrapping_add(gp(&regs, b))
        } else if w.bit_and(4292934687) == 3942645791 {
            equal = gp(&regs, a) == gp(&regs, b)
        } else if w.bit_and(4292873216) == 4160749568 || w.bit_and(4292873216) == 4164943872 {
            address := regs[a] + signed(w.shr(12).bit_and(511), 9)
            if w.bit_and(4194304) != 0 { assert(dst != 31); regs[dst] = mem[cell(address)] }
            else { mem[cell(address)] = gp(&regs, dst) }
        } else if w.bit_and(4290772992) == 4177526784 || w.bit_and(4290772992) == 4181721088 {
            address := regs[a] + w.shr(10).bit_and(4095) * 8
            if w.bit_and(4194304) != 0 { assert(dst != 31); regs[dst] = mem[cell(address)] }
            else { mem[cell(address)] = gp(&regs, dst) }
        } else if w.bit_and(4227858432) == 335544320 {
            next = pc + i32(signed(w.bit_and(67108863), 26)) * 4
        } else if w.bit_and(4278190096) == 1409286144 {
            cond := w.bit_and(15); assert(cond == 0 || cond == 1)
            if (cond == 0 && equal) || (cond == 1 && !equal) { next = pc + i32(signed(w.shr(5).bit_and(524287), 19)) * 4 }
        } else { assert(false) }
        pc = next
    }; assert(false); 0
}
fn equivalent(c: &mut arm.Code, baseline: &mut arm.Code, expected: i64, pushes: i32, pops: i32) {
    original := arm.finish(&mut baseline); var f := model(&c); var work := stack.new()
    assert(optimize(&mut work, &mut f, 4194304) && stack.status(&work) == 2 && f.verified && f.optimizable)
    assert(stack.removed_pushes(&work) == pushes && stack.removed_pops(&work) == pops)
    var lowering := lower.new(); var sites: []i32 = []
    assert(lower.prepare(&mut lowering, &f, &c, &sites))
    lower.commit_code(&mut lowering, &mut c); lower.commit_imports(&mut lowering, &mut sites)
    rewritten := arm.finish(&mut c)
    assert(execute(&original) == expected && execute(&rewritten) == expected)
}
fn nested() -> arm.Code {
    var c := begin(); arm.imm(&mut c, 0, 11); arm.push_temp(&mut c, 0)
    arm.imm(&mut c, 0, 7); arm.push_temp(&mut c, 0); arm.imm(&mut c, 0, 5)
    add(&mut c, 0, 0, 0); arm.pop_temp(&mut c, 1); add(&mut c, 0, 0, 1)
    arm.pop_temp(&mut c, 1); add(&mut c, 0, 0, 1); arm.ret(&mut c); arm.end_mir(&mut c); c
}
@test fn nested_values_survive_intervening_scalar_work() {
    var c := nested(); var baseline := nested(); equivalent(&mut c, &mut baseline, 28, 2, 2)
}
fn frame_work() -> arm.Code {
    var c := arm.new(); arm.begin_mir(&mut c, true); frame := arm.prologue(&mut c); arm.frame(&mut c, frame, 2)
    arm.imm(&mut c, 0, 5); arm.store(&mut c, 0, 0)
    arm.imm(&mut c, 0, 11); arm.push_temp(&mut c, 0)
    arm.load(&mut c, 0); arm.store(&mut c, 1, 0); arm.load(&mut c, 1)
    arm.pop_temp(&mut c, 1); add(&mut c, 0, 0, 1); arm.ret(&mut c); arm.end_mir(&mut c); c
}
@test fn proven_fp_helpers_are_disjoint_from_private_expression_units() {
    var c := frame_work(); var baseline := frame_work(); f := model(&c)
    for place in 0..f.place_kinds.len { if f.place_kinds[place] == 1 { assert(!f.place_escaped[place]) } }
    equivalent(&mut c, &mut baseline, 16, 1, 1)
}
fn diamond(flag: i64) -> arm.Code {
    var c := begin(); left := arm.label(&mut c); join := arm.label(&mut c)
    arm.imm(&mut c, 2, flag); arm.imm(&mut c, 3, 0); compare(&mut c, 2, 3); arm.branch(&mut c, left, 2)
    arm.imm(&mut c, 0, 11); arm.push_temp(&mut c, 0); arm.branch(&mut c, join, 0)
    arm.mark(&mut c, left); arm.imm(&mut c, 0, 21); arm.push_temp(&mut c, 0)
    arm.mark(&mut c, join); arm.imm(&mut c, 0, 99); arm.pop_temp(&mut c, 0)
    arm.ret(&mut c); arm.end_mir(&mut c); c
}
@test fn cfg_join_coalesces_alternative_push_definitions() {
    for flag in 0..2 {
        var c := diamond(i64(flag)); var baseline := diamond(i64(flag))
        var expected: i64 = 11; if flag == 0 { expected = 21 }
        equivalent(&mut c, &mut baseline, expected, 2, 1)
    }
}
fn split(flag: i64) -> arm.Code {
    var c := begin(); left := arm.label(&mut c); join := arm.label(&mut c)
    arm.imm(&mut c, 0, 13); arm.push_temp(&mut c, 0)
    arm.imm(&mut c, 2, flag); arm.imm(&mut c, 3, 0); compare(&mut c, 2, 3); arm.branch(&mut c, left, 2)
    arm.pop_temp(&mut c, 1); arm.imm(&mut c, 0, 10); add(&mut c, 0, 0, 1); arm.branch(&mut c, join, 0)
    arm.mark(&mut c, left); arm.pop_temp(&mut c, 1); arm.imm(&mut c, 0, 20); add(&mut c, 0, 0, 1)
    arm.mark(&mut c, join); arm.ret(&mut c); arm.end_mir(&mut c); c
}
@test fn one_definition_can_have_different_lifo_uses_on_cfg_paths() {
    for flag in 0..2 {
        var c := split(i64(flag)); var baseline := split(i64(flag))
        var expected: i64 = 23; if flag == 0 { expected = 33 }
        equivalent(&mut c, &mut baseline, expected, 1, 2)
    }
}
fn loop() -> arm.Code {
    var c := begin(); head := arm.label(&mut c)
    arm.imm(&mut c, 0, 1); arm.push_temp(&mut c, 0); arm.imm(&mut c, 2, 3); arm.imm(&mut c, 3, 0)
    arm.mark(&mut c, head); arm.pop_temp(&mut c, 0)
    arm.emit(&mut c, 2432697344); arm.push_temp(&mut c, 0) // add x0,x0,#1
    arm.emit(&mut c, 3506439234); compare(&mut c, 2, 3); arm.branch(&mut c, head, 3)
    arm.pop_temp(&mut c, 0); arm.ret(&mut c); arm.end_mir(&mut c); c
}
@test fn loop_carried_lifo_web_and_flags_preserve_result() {
    var c := loop(); var baseline := loop(); equivalent(&mut c, &mut baseline, 4, 2, 2)
}
@test fn raw_context_and_raw_origin_independently_refuse_elision() {
    c := nested(); var f := model(&c); before := model(&c); var work := stack.new()
    raw := stack.conservative(); exits := terminals.no_terminals(); calls := inputs.conservative()
    assert(!stack.optimize_with_context_budget(&mut work, &mut f, &raw, &exits, &calls, 4194304))
    assert(stack.status(&work) == -2); same(&f, &before)
    var unknown := begin(); arm.imm(&mut unknown, 0, 7); arm.push(&mut unknown, 0)
    arm.imm(&mut unknown, 0, 9); arm.pop(&mut unknown, 0); arm.ret(&mut unknown); arm.end_mir(&mut unknown)
    var unproven := model(&unknown); unchanged := model(&unknown)
    assert(!optimize(&mut work, &mut unproven, 4194304) && stack.status(&work) == 0); same(&unproven, &unchanged)
}
@test fn calls_outgoing_arguments_raw_memory_and_sp_observers_block_live_webs() {
    for kind in 0..4 {
        var c := begin(); callee := arm.label(&mut c)
        arm.imm(&mut c, 0, 7); arm.push_temp(&mut c, 0)
        if kind == 0 { arm.branch(&mut c, callee, 1) }
        if kind == 1 { arm.push(&mut c, 0); arm.branch(&mut c, callee, 1); arm.pop(&mut c, 9) }
        if kind == 2 { arm.emit(&mut c, 4181721186) } // ldr x2,[x3]
        if kind == 3 { arm.emit(&mut c, 2432697314) } // add x2,sp,#0
        arm.pop_temp(&mut c, 0); arm.ret(&mut c); arm.end_mir(&mut c)
        var f := model(&c); before := model(&c); var work := stack.new()
        assert(!optimize(&mut work, &mut f, 4194304)); assert(stack.status(&work) == 0 || stack.status(&work) == -2)
        same(&f, &before); assert(stack.removed_pushes(&work) == 0 && stack.copies(&work) == 0)
    }
}
@test fn unknown_inner_stack_access_keeps_outer_temp_address_and_fault() {
    var c := begin(); arm.imm(&mut c, 0, 7); arm.push_temp(&mut c, 0)
    arm.push(&mut c, 0); arm.pop(&mut c, 1); arm.pop_temp(&mut c, 0); arm.ret(&mut c); arm.end_mir(&mut c)
    var f := model(&c); before := model(&c); var work := stack.new()
    assert(!optimize(&mut work, &mut f, 4194304) && stack.status(&work) == 0); same(&f, &before)
}
@test fn observer_after_closed_interval_is_not_mistaken_for_safe_noreturn() {
    var c := nested(); for unused in 0..3 { removed := c.words.pop() }
    outside := arm.label(&mut c); arm.branch(&mut c, outside, 0)
    var f := model(&c); before := model(&c); var work := stack.new()
    assert(!optimize(&mut work, &mut f, 4194304) && stack.status(&work) == -2); same(&f, &before)
}
@test fn only_explicit_unobserving_external_terminals_allow_live_intervals() {
    var c := begin(); trap := arm.label(&mut c)
    arm.imm(&mut c, 0, 7); arm.push_temp(&mut c, 0); arm.imm(&mut c, 0, 9)
    compare(&mut c, 0, 0); arm.branch(&mut c, trap, 3); arm.pop_temp(&mut c, 0)
    arm.ret(&mut c); arm.end_mir(&mut c)
    var f := model(&c); before := model(&c); var work := stack.new()
    assert(!optimize(&mut work, &mut f, 4194304) && stack.status(&work) == -2); same(&f, &before)
    exits := terminals.TerminalContext { version: 1, overflow: trap, zero: trap, assertion: trap, io: trap, bounds: trap, float_trap: trap }
    calls := inputs.conservative(); context := stack.trusted_source_expression_storage_v1()
    assert(stack.optimize_with_context_budget(&mut work, &mut f, &context, &exits, &calls, 4194304))
    assert(stack.removed_pushes(&work) == 1 && stack.removed_pops(&work) == 1 && f.verified)
}
@test fn register_pressure_never_borrows_reserved_or_fp_state() {
    var c := begin()
    for reg in 0..18 { arm.imm(&mut c, reg, i64(reg) + 1) }
    arm.push_temp(&mut c, 0)
    for reg in 1..18 { add(&mut c, 0, 0, reg) }
    arm.pop_temp(&mut c, 0); arm.ret(&mut c); arm.end_mir(&mut c)
    var f := model(&c); before := model(&c); var work := stack.new()
    assert(!optimize(&mut work, &mut f, 4194304) && stack.status(&work) == 0); same(&f, &before)
}
@test fn bounded_refusal_is_atomic_and_reused_workspace_has_same_budget() {
    c := nested(); var f := model(&c); var work := stack.new()
    assert(optimize(&mut work, &mut f, 4194304)); cost := stack.units(&work)
    var refused := model(&c); before := model(&c)
    assert(!optimize(&mut work, &mut refused, cost - 1) && stack.status(&work) == -3)
    same(&refused, &before); assert(stack.placed(&work) == 0 && stack.removed_pops(&work) == 0)
    assert(optimize(&mut work, &mut refused, cost)); assert(stack.units(&work) == cost); same(&f, &refused)
}
@test fn caller_owned_fresh_physical_facts_use_the_same_plan() {
    c := nested(); var standalone := model(&c); var shared := model(&c); var a := stack.new(); var b := stack.new()
    var physical := live.new(); calls := inputs.conservative(); context := stack.trusted_source_expression_storage_v1()
    exits := terminals.no_terminals()
    assert(live.analyze_with_inputs_into(&mut physical, &shared, &calls, 4194304))
    assert(optimize(&mut a, &mut standalone, 4194304))
    assert(stack.optimize_with_liveness_budget(&mut b, &mut shared, &context, &exits, &physical, 4194304))
    assert(stack.units(&a) == stack.units(&b) + live.units(&physical)); same(&standalone, &shared)
}
@test fn immutable_facts_expose_nested_lifetimes_masks_scores_and_conflicts() {
    c := nested(); f := model(&c); before := model(&c); var work := stack.new(); var physical := live.new()
    calls := inputs.conservative(); context := stack.trusted_source_expression_storage_v1(); exits := terminals.no_terminals()
    assert(live.analyze_with_inputs_into(&mut physical, &f, &calls, 4194304))
    assert(stack.analyze_with_liveness_budget(&mut work, &f, &context, &exits, &physical, 4194304))
    assert(stack.status(&work) == 1 && stack.group_count(&work) == 2 && stack.conflict_count(&work) == 1)
    assert(stack.conflict_left(&work, 0) != stack.conflict_right(&work, 0))
    for group in 0..stack.group_count(&work) {
        assert(stack.allowed_mask(&work, group) != 0 && stack.allowed_mask(&work, group).bit_and(-262144) == 0)
        assert(stack.score(&work, group) == 2)
    }
    var defs := 0; var uses := 0
    for op in 0..f.kinds.len {
        if f.kinds[op] == 10 {
            group := stack.push_group(&work, op); assert(group >= 0 && stack.pop_group(&work, op) == -1)
            head := stack.after_head(&work, op); assert(stack.head_group(&work, head) == group)
            assert(stack.head_below(&work, head) == stack.before_head(&work, op)); defs = defs + 1
        } else if f.kinds[op] == 11 {
            group := stack.pop_group(&work, op); assert(group >= 0 && stack.push_group(&work, op) == -1)
            head := stack.before_head(&work, op); assert(stack.head_group(&work, head) == group)
            assert(stack.head_below(&work, head) == stack.after_head(&work, op)); uses = uses + 1
        } else { assert(stack.push_group(&work, op) == -1 && stack.pop_group(&work, op) == -1) }
    }
    assert(defs == 2 && uses == 2); same(&f, &before)
    assert(stack.removed_pushes(&work) == 0 && stack.copies(&work) == 0)
    cost := stack.units(&work)
    assert(!stack.analyze_with_liveness_budget(&mut work, &f, &context, &exits, &physical, cost - 1))
    assert(stack.status(&work) == -3 && stack.group_count(&work) == 0 && stack.before_head(&work, 0) == -1)
    same(&f, &before)
    assert(stack.analyze_with_liveness_budget(&mut work, &f, &context, &exits, &physical, cost))
    assert(stack.units(&work) == cost && stack.group_count(&work) == 2)
}
fn main() {}
