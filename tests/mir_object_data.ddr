import ..selfhost.arm64 as arm
import ..selfhost.mir
import ..selfhost.mir_lift as lift
import ..selfhost.mir_verify as verify
import ..selfhost.mir_lower as lower

fn model(platform: i32, kind: i32) -> mir.Function {
    var code := arm.new_for(platform); entry := arm.label(&mut code); outside := arm.label(&mut code)
    arm.mark(&mut code, outside); arm.emit(&mut code, 3573751839)
    first := code.words.len; labels := code.labels.len; arm.mark(&mut code, entry)
    body := arm.label(&mut code); init := arm.label(&mut code); end := arm.label(&mut code); pending := arm.label(&mut code)
    arm.branch(&mut code, init, 0); arm.mark(&mut code, body)
    arm.branch(&mut code, outside, kind); arm.branch(&mut code, end, kind)
    site := code.words.len * 4; arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0)
    arm.ret(&mut code); arm.mark(&mut code, init)
    arm.imm(&mut code, 0, -9223372036854775808); arm.branch(&mut code, body, 0); arm.mark(&mut code, end)
    sites: []i32 = [site]; var f := mir.new()
    assert(lift.lift(&mut f, &code, first, labels, 0, &sites, 0))
    assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f)); f
}
fn same(a: &lower.FunctionObject, b: &lower.FunctionObject) {
    assert(lower.object_ready(&a) && lower.object_ready(&b))
    assert(lower.object_platform(&a) == lower.object_platform(&b))
    assert(lower.object_first_word(&a) == lower.object_first_word(&b) && lower.object_word_end(&a) == lower.object_word_end(&b))
    assert(lower.object_first_label(&a) == lower.object_first_label(&b) && lower.object_label_end(&a) == lower.object_label_end(&b))
    assert(lower.object_first_reloc(&a) == lower.object_first_reloc(&b) && lower.object_reloc_end(&a) == lower.object_reloc_end(&b))
    assert(lower.object_first_import(&a) == lower.object_first_import(&b) && lower.object_import_end(&a) == lower.object_import_end(&b))
    assert(lower.object_word_count(&a) == lower.object_word_count(&b))
    for i in 0..lower.object_word_count(&a) { assert(lower.object_word(&a, i) == lower.object_word(&b, i)) }
    assert(lower.object_label_count(&a) == lower.object_label_count(&b))
    for i in 0..lower.object_label_count(&a) { assert(lower.object_label_id(&a, i) == lower.object_label_id(&b, i) && lower.object_label_offset(&a, i) == lower.object_label_offset(&b, i)) }
    assert(lower.object_reloc_count(&a) == lower.object_reloc_count(&b))
    for i in 0..lower.object_reloc_count(&a) { assert(lower.object_reloc_at(&a, i) == lower.object_reloc_at(&b, i) && lower.object_reloc_target(&a, i) == lower.object_reloc_target(&b, i) && lower.object_reloc_kind(&a, i) == lower.object_reloc_kind(&b, i)) }
    assert(lower.object_import_count(&a) == lower.object_import_count(&b))
    for i in 0..lower.object_import_count(&a) { assert(lower.object_import_id(&a, i) == lower.object_import_id(&b, i) && lower.object_import_byte_at(&a, i) == lower.object_import_byte_at(&b, i)) }
}
fn column(out: &mut []i64, values: &[]i32) {
    out.push(i64(values.len)); for i in 0..values.len { out.push(i64(values[i])) }
}
fn flag(value: bool) -> i64 { if value { return 1 }; 0 }
fn witness(d: &lower.ObjectData) -> []i64 {
    var out: []i64 = [i64(d.version), i64(d.first_word), i64(d.first_label), i64(d.first_reloc), i64(d.first_import),
        i64(d.source_words), i64(d.source_labels), i64(d.source_relocs), i64(d.source_imports), i64(d.output.platform),
        flag(d.output.checking), i64(d.output.virtual_words), i64(d.output.virtual_labels), flag(d.output.profile),
        d.output.effect_epoch, i64(d.output.effect_depth), flag(d.output.mir_capture), i64(d.output.words.len)]
    for i in 0..d.output.words.len { out.push(d.output.words[i]) }
    column(&mut out, &d.output.labels); column(&mut out, &d.output.at); column(&mut out, &d.output.target); column(&mut out, &d.output.kinds)
    column(&mut out, &d.output.mir_starts); column(&mut out, &d.output.mir_ends); column(&mut out, &d.output.mir_kinds); column(&mut out, &d.output.mir_a); column(&mut out, &d.output.mir_b)
    column(&mut out, &d.boundaries); column(&mut out, &d.label_ids); column(&mut out, &d.label_at); column(&mut out, &d.import_ids); column(&mut out, &d.import_at); out
}
fn unchanged(a: &[]i64, b: &[]i64) { assert(a.len == b.len); for i in 0..a.len { assert(a[i] == b[i]) } }

@test fn numeric_object_transport_matches_the_serial_walker_all_targets_and_relocations() {
    var data := lower.new_data(); var serial := lower.new_object(); var actual := lower.new_object()
    for platform in 0..4 { for kind in 0..21 {
        var f := model(platform, kind); assert(lower.lower_into(&mut serial, &f) && lower.lower_data_into(&mut data, &f))
        assert(data.version == 1 && data.output.labels.len == 0 && data.label_ids[0] == 0 && data.import_ids[0] == 0)
        before := witness(&data); assert(lower.from_data_into(&mut actual, &data)); after := witness(&data); unchanged(&before, &after)
        same(&serial, &actual); mir.reset(&mut f); lower.reset_data(&mut data); same(&serial, &actual)
    } }
}
@test fn explicit_boundaries_allow_tombstones_and_expanded_constants() {
    for platform in 0..4 {
        var code := arm.new_for(platform); entry := arm.label(&mut code); arm.mark(&mut code, entry)
        arm.imm(&mut code, 0, 7); arm.emit(&mut code, 2852193249); arm.emit(&mut code, 3596551104)
        sites: []i32 = []; var f := mir.new(); assert(lift.lift(&mut f, &code, 0, 1, 0, &sites, 0))
        assert(lift.own_entry(&mut f, &code, entry) && verify.verify(&mut f))
        f.modes[0] = 1; f.imm[0] = 1311768467294899695; f.modes[1] = 2; assert(verify.verify(&mut f))
        var data := lower.new_data(); var actual := lower.new_object(); var serial := lower.new_object()
        assert(lower.lower_data_into(&mut data, &f) && data.boundaries[1] == data.boundaries[2])
        assert(lower.from_data_into(&mut actual, &data) && lower.lower_into(&mut serial, &f)); same(&serial, &actual)
        // Original source span counts are not the emitted cardinalities.
        data.source_relocs = data.source_relocs + 3
        assert(lower.from_data_into(&mut actual, &data))
    }
}
@test fn malformed_data_never_publishes_an_object_or_changes_its_input() {
    f := model(0, 2); var good := lower.new_data(); assert(lower.lower_data_into(&mut good, &f))
    var object := lower.new_object()
    for invalid in 0..66 {
        assert(lower.from_data_into(&mut object, &good)); var bad := good
        if invalid == 0 { bad.version = 0 }; if invalid == 1 { bad.version = 2 }
        if invalid == 2 { bad.output.platform = -1 }; if invalid == 3 { bad.output.platform = 4 }
        if invalid == 4 { bad.output.checking = true }; if invalid == 5 { bad.output.virtual_words = 1 }
        if invalid == 6 { bad.output.virtual_labels = 1 }; if invalid == 7 { bad.output.profile = true }
        if invalid == 8 { bad.output.effect_epoch = 1 }; if invalid == 9 { bad.output.effect_depth = 1 }
        if invalid == 10 { bad.output.mir_capture = true }; if invalid == 11 { bad.output.labels.push(0) }
        if invalid == 12 { bad.output.mir_starts.push(0) }; if invalid == 13 { bad.output.mir_ends.push(0) }
        if invalid == 14 { bad.output.mir_kinds.push(0) }; if invalid == 15 { bad.output.mir_a.push(0) }; if invalid == 16 { bad.output.mir_b.push(0) }
        if invalid == 17 { bad.output.words.clear() }; if invalid == 18 { bad.output.words[0] = -1 }; if invalid == 19 { bad.output.words[0] = 4294967296 }
        if invalid == 20 { removed := bad.output.at.pop() }; if invalid == 21 { removed := bad.output.target.pop() }; if invalid == 22 { removed := bad.output.kinds.pop() }
        if invalid == 23 { removed := bad.label_at.pop() }; if invalid == 24 { removed := bad.import_at.pop() }; if invalid == 25 { removed := bad.import_ids.pop() }
        if invalid == 26 { bad.first_word = -1 }; if invalid == 27 { bad.source_words = bad.first_word }; if invalid == 28 { bad.source_words = 536870912 }
        if invalid == 29 { bad.first_label = -1 }; if invalid == 30 { bad.source_labels = bad.first_label - 1 }
        if invalid == 31 { bad.first_reloc = -1 }; if invalid == 32 { bad.source_relocs = bad.first_reloc - 1 }
        if invalid == 33 { bad.first_import = -1 }; if invalid == 34 { bad.source_imports = bad.first_import - 1 }
        if invalid == 35 { bad.import_ids[0] = 1 }; if invalid == 36 { bad.import_at[0] = -1 }; if invalid == 37 { bad.import_at[0] = 1 }
        if invalid == 38 { bad.import_at[0] = bad.output.words.len * 4 }; if invalid == 39 { bad.output.at[0] = -1 }
        if invalid == 40 { bad.output.at[0] = bad.output.words.len }; if invalid == 41 { bad.output.kinds[0] = 21 }
        if invalid == 42 { bad.output.target[0] = -1 }; if invalid == 43 { bad.output.target[0] = bad.source_labels }
        if invalid == 44 { bad.output.words[0] = 3573751839 }; if invalid == 45 { bad.output.words[bad.output.at[1] + 1] = 0 }
        if invalid == 46 { bad.label_ids[1] = bad.label_ids[0] }; if invalid == 47 { bad.label_ids[0] = -1 }; if invalid == 48 { bad.label_ids[0] = bad.source_labels }
        if invalid == 49 { bad.label_at[0] = -2 }; if invalid == 50 { bad.label_at[0] = bad.output.words.len + 1 }; if invalid == 51 { bad.label_at[0] = bad.output.at[1] + 1 }
        if invalid == 52 { removed := bad.label_ids.pop(); position := bad.label_at.pop() }; if invalid == 53 { bad.label_ids[0] = bad.label_ids[1] + 1 }
        if invalid == 54 { bad.boundaries.clear() }; if invalid == 55 { bad.boundaries[0] = 1 }
        if invalid == 56 { bad.boundaries[bad.boundaries.len - 1] = bad.output.words.len - 1 }; if invalid == 57 { bad.boundaries[1] = -1 }
        if invalid == 58 { bad.boundaries[2] = 0 }; if invalid == 59 { bad.boundaries[2] = bad.output.at[1] + 1 }
        if invalid == 60 { bad.boundaries[1] = 0 }
        if invalid == 61 { bad.import_at[0] = bad.output.at[0] * 4 }; if invalid == 62 { bad.output.at[1] = bad.output.at[0] }
        if invalid == 63 { bad.output.words[bad.import_at[0] / 4] = 3573751839 }; if invalid == 64 { bad.output.words[bad.import_at[0] / 4 + 1] = 3573751839 }
        if invalid == 65 { bad.boundaries[1] = bad.output.words.len + 1 }
        before := witness(&bad); accepted := lower.from_data_into(&mut object, &bad); if accepted { print(invalid) }; assert(!accepted && !lower.object_ready(&object))
        after := witness(&bad); unchanged(&before, &after)
    }
    assert(lower.from_data_into(&mut object, &good))
}
@test fn lowering_refusal_clears_partial_data_and_reuses_all_arenas() {
    var data := lower.new_data(); var f := model(0, 2); assert(lower.lower_data_into(&mut data, &f))
    // A malformed operation late enough to follow emitted words must not leave
    // a complete payload behind. A fresh valid lowering must still succeed.
    var bad := f; bad.modes[bad.order[bad.order.len - 1]] = 7
    assert(!lower.lower_data_into(&mut data, &bad) && data.version == 0 && data.output.words.len == 0 && data.boundaries.len == 0)
    var object := lower.new_object(); assert(!lower.from_data_into(&mut object, &data) && !lower.object_ready(&object))
    assert(lower.lower_data_into(&mut data, &f) && lower.from_data_into(&mut object, &data))
    lower.reset_data(&mut data); lower.reset_data(&mut data); assert(data.version == 0)
}
@test fn symbolic_spans_require_both_operation_endpoints_without_incidental_labels() {
    for symbolic in 0..2 { for shape in 0..4 {
        var data := lower.new_data(); data.version = 1
        data.output.words = [2852193249, 0, 0, 3596551104]
        data.first_word = 0; data.source_words = 4; data.first_label = 1; data.source_labels = 1
        data.label_ids = [0]; data.label_at = [0]
        if symbolic == 0 { data.import_ids = [0]; data.import_at = [4]; data.source_imports = 1 }
        else { data.output.words[2] = 3573751839; data.output.at = [1]; data.output.target = [0]; data.output.kinds = [2]; data.source_relocs = 1 }
        data.boundaries.push(0)
        if shape == 1 || shape == 3 { data.boundaries.push(1) }
        if shape == 2 || shape == 3 { data.boundaries.push(3) }
        data.boundaries.push(4)
        var object := lower.new_object(); accepted := lower.from_data_into(&mut object, &data)
        assert(accepted == (shape == 3) && lower.object_ready(&object) == accepted)
    } }
}
fn main() {}
