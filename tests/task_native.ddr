import ..selfhost.backend.arm64 as arm
import ..selfhost.backend.x86 as x86
import ..selfhost.runtime.runtime
import ..selfhost.tasks.task_native as task

@test fn unsupported_task_targets_and_profiling_leave_code_untouched() {
    for mode in 0..4 {
        mut platform := mode; mut profile := true
        if mode == 3 { platform = 3; profile = false }
        mut c := arm.new_for(platform); c.profile = profile
        rt := runtime.new(&mut c); worker := arm.label(&mut c)
        spec := task.TaskSpec { input_mode: 0, input_drop: -1, input_clone: -1, input_pod: false, worker: worker, result_clone: -1, result_drop: -1, result_pod_words: 0, workspace_pod_words: 0 }
        symbols := task.Symbols { symbol_count: 6, global_queue: 0, create_group: 1, submit: 2, wait: 3, release_group: 4, munmap: 5 }
        words := c.words.len; labels := c.labels.len; relocs := c.at.len
        out := task.emit(&mut c, &rt, &spec, &symbols)
        assert(!out.ok && out.error != "" && out.create == -1 && out.collect == -1 && out.discard == -1 && out.worker_entry == -1)
        assert(c.words.len == words && c.labels.len == labels && c.at.len == relocs && out.import_sites.len == 0)
        unmap := task.emit_unmap_pool(&mut c, &symbols)
        assert(!unmap.ok && unmap.error != "" && c.words.len == words && c.labels.len == labels && c.at.len == relocs)
    }
}

@test fn linux_posix_provider_accepts_arm64_and_x86_targets_and_lowers_x86() {
    assert(task.supported(0, false) && task.supported(1, false) && task.supported(2, false))
    assert(!task.supported(3, false) && !task.supported(0, true) && !task.supported(1, true) && !task.supported(2, true))
    for platform in 1..3 {
        mut c := arm.new_for(platform); rt := runtime.new(&mut c)
        worker := arm.label(&mut c); arm.mark(&mut c, worker); f := arm.prologue(&mut c); arm.frame(&mut c, f, 0); arm.ret(&mut c)
        spec := task.TaskSpec { input_mode: 0, input_drop: -1, input_clone: -1, input_pod: false, worker: worker, result_clone: -1, result_drop: -1, result_pod_words: 0, workspace_pod_words: 0 }
        symbols := task.posix_symbols(3, 0, 1, 2)
        out := task.emit(&mut c, &rt, &spec, &symbols)
        assert(out.ok && out.worker_entry >= 0 && out.create >= 0 && out.collect >= 0 && out.discard >= 0)
        assert(out.import_sites.len == 3 && out.import_slots[0] == 0 && out.import_slots[1] == 1 && out.import_slots[2] == 2)
        unmap := task.emit_unmap_pool(&mut c, &symbols)
        assert(unmap.ok && unmap.import_sites.len == 1 && unmap.import_slots[0] == 2)
        mut bad := task.posix_symbols(3, 0, 1, 2); bad.global_queue = 0
        assert(!task.emit(&mut c, &rt, &spec, &bad).ok)
        if platform == 2 {
            mut sites := out.import_sites.clone(); mut slots := out.import_slots.clone()
            sites.push(unmap.import_sites[0]); slots.push(unmap.import_slots[0])
            runtime.emit_runtime(&mut c, &rt)
            lowered := x86.finish(&c, c.words.len, &sites, &slots)
            assert(lowered.ok && lowered.imports.len == 4)
        }
    }
}
@test fn task_spec_accepts_label_and_import_zero_and_scalar_identity_sentinel() {
    mut c := arm.new(); zero := arm.label(&mut c); assert(zero == 0)
    rt := runtime.new(&mut c)
    spec := task.TaskSpec { input_mode: 0, input_drop: -1, input_clone: zero, input_pod: false, worker: zero, result_clone: -1, result_drop: -1, result_pod_words: 0, workspace_pod_words: 0 }
    symbols := task.Symbols { symbol_count: 6, global_queue: 0, create_group: 1, submit: 2, wait: 3, release_group: 4, munmap: 5 }
    out := task.emit(&mut c, &rt, &spec, &symbols)
    assert(out.ok && out.worker_entry >= 0 && out.create >= 0 && out.collect >= 0 && out.discard >= 0)
    assert(out.import_sites.len == 6 && out.import_slots.len == 6)
    for i in 0..6 {
        assert(out.import_slots[i] == i && out.import_sites[i] % 4 == 0)
        if i > 0 { assert(out.import_sites[i] > out.import_sites[i - 1]) }
    }
    assert(task.control_bytes() == 112 && task.pool_bytes() == 536870912)
}
@test fn task_emission_rejects_check_only_sinks_without_virtual_mutation() {
    mut c := arm.new_check(0); rt := runtime.new(&mut c); worker := arm.label(&mut c)
    spec := task.TaskSpec { input_mode: 0, input_drop: -1, input_clone: -1, input_pod: false, worker: worker, result_clone: -1, result_drop: -1, result_pod_words: 0, workspace_pod_words: 0 }
    symbols := task.Symbols { symbol_count: 6, global_queue: 0, create_group: 1, submit: 2, wait: 3, release_group: 4, munmap: 5 }
    words := arm.position(&c); labels := arm.label_count(&c)
    out := task.emit(&mut c, &rt, &spec, &symbols)
    assert(!out.ok && out.error != "" && arm.position(&c) == words && arm.label_count(&c) == labels)
}
@test fn invalid_task_specs_and_symbols_refuse_before_any_labels_or_words() {
    mut c := arm.new(); rt := runtime.new(&mut c); worker := arm.label(&mut c)
    mut spec := task.TaskSpec { input_mode: 0, input_drop: -1, input_clone: -1, input_pod: false, worker: worker, result_clone: -1, result_drop: -1, result_pod_words: 0, workspace_pod_words: 0 }
    mut symbols := task.Symbols { symbol_count: 6, global_queue: 0, create_group: 1, submit: 2, wait: 3, release_group: 4, munmap: 5 }
    words := c.words.len; labels := c.labels.len
    for mode in 0..17 {
        spec.input_mode = 0; spec.input_drop = -1
        spec.input_clone = -1; spec.worker = worker; spec.result_clone = -1
        symbols.symbol_count = 6; symbols.global_queue = 0; symbols.wait = 3; symbols.munmap = 5
        if mode == 0 { spec.input_clone = -2 }
        else if mode == 1 { spec.result_clone = -2 }
        else if mode == 2 { spec.worker = -1 }
        else if mode == 3 { spec.worker = labels }
        else if mode == 4 { symbols.global_queue = -1 }
        else if mode == 5 { symbols.munmap = symbols.wait }
        else if mode == 6 { spec.result_clone = labels }
        else if mode == 7 { symbols.symbol_count = 2 }
        else if mode == 8 { symbols.wait = 6 }
        else if mode == 9 { spec.input_mode = -1 }
        else if mode == 10 { spec.input_mode = 4 }
        else if mode == 11 { spec.input_drop = -2 }
        else if mode == 12 { spec.input_drop = labels }
        else if mode == 13 { spec.input_drop = worker }
        else if mode == 14 { spec.input_mode = 2; spec.input_drop = worker }
        else if mode == 15 { spec.input_mode = 3; spec.input_clone = worker }
        else { spec.input_mode = 1; spec.input_drop = worker }
        out := task.emit(&mut c, &rt, &spec, &symbols)
        assert(!out.ok && out.error != "" && c.words.len == words && c.labels.len == labels)
    }
}
fn main() {}
@test fn provider_helpers_cannot_be_inserted_into_source_mir() {
    mut c := arm.new(); rt := runtime.new(&mut c); worker := arm.label(&mut c)
    spec := task.TaskSpec { input_mode: 0, input_drop: -1, input_clone: -1, input_pod: false, worker: worker, result_clone: -1, result_drop: -1, result_pod_words: 0, workspace_pod_words: 0 }
    symbols := task.Symbols { symbol_count: 6, global_queue: 0, create_group: 1, submit: 2, wait: 3, release_group: 4, munmap: 5 }
    arm.begin_mir(&mut c, true); words := c.words.len; labels := c.labels.len
    out := task.emit(&mut c, &rt, &spec, &symbols)
    assert(!out.ok && out.error != "" && c.words.len == words && c.labels.len == labels && c.at.len == 0)
}

@test fn borrowed_task_input_modes_validate_explicit_clone_and_drop_labels() {
    for mode in 1..4 {
        mut c := arm.new(); rt := runtime.new(&mut c); worker := arm.label(&mut c)
        mut spec := task.TaskSpec { input_mode: mode, input_drop: -1, input_clone: -1, input_pod: false,
            worker: worker, result_clone: -1, result_drop: -1, result_pod_words: 0, workspace_pod_words: 0 }
        if mode > 1 { spec.input_drop = worker; spec.input_clone = worker }
        symbols := task.Symbols { symbol_count: 6, global_queue: 0, create_group: 1,
            submit: 2, wait: 3, release_group: 4, munmap: 5 }
        out := task.emit(&mut c, &rt, &spec, &symbols)
        assert(out.ok && out.import_sites.len == 6 && out.worker_entry >= 0)
    }
}
