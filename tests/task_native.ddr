import ..selfhost.arm64 as arm
import ..selfhost.runtime
import ..selfhost.task_native as task

@test fn unsupported_task_targets_and_profiling_leave_code_untouched() {
    for platform in 0..4 {
        var c := arm.new_for(platform); c.profile = platform == 0
        rt := runtime.new(&mut c); worker := arm.label(&mut c)
        spec := task.TaskSpec { input_clone: -1, worker: worker, result_clone: -1 }
        symbols := task.Symbols { symbol_count: 3, pthread_create: 0, pthread_join: 1, munmap: 2 }
        words := c.words.len; labels := c.labels.len; relocs := c.at.len
        out := task.emit(&mut c, &rt, &spec, &symbols)
        assert(!out.ok && out.error != "" && out.create == -1 && out.collect == -1 && out.discard == -1 && out.worker_entry == -1)
        assert(c.words.len == words && c.labels.len == labels && c.at.len == relocs && out.import_sites.len == 0)
    }
}
@test fn task_spec_accepts_label_and_import_zero_and_scalar_identity_sentinel() {
    var c := arm.new(); zero := arm.label(&mut c); assert(zero == 0)
    rt := runtime.new(&mut c)
    spec := task.TaskSpec { input_clone: zero, worker: zero, result_clone: -1 }
    symbols := task.Symbols { symbol_count: 3, pthread_create: 0, pthread_join: 1, munmap: 2 }
    out := task.emit(&mut c, &rt, &spec, &symbols)
    assert(out.ok && out.worker_entry >= 0 && out.create >= 0 && out.collect >= 0 && out.discard >= 0)
    assert(out.import_sites.len == 3 && out.import_slots.len == 3)
    for i in 0..3 {
        assert(out.import_slots[i] == i && out.import_sites[i] % 4 == 0)
        if i > 0 { assert(out.import_sites[i] > out.import_sites[i - 1]) }
    }
    assert(task.control_bytes() == 80 && task.pool_bytes() == 536870912)
}
@test fn task_emission_rejects_check_only_sinks_without_virtual_mutation() {
    var c := arm.new_check(0); rt := runtime.new(&mut c); worker := arm.label(&mut c)
    spec := task.TaskSpec { input_clone: -1, worker: worker, result_clone: -1 }
    symbols := task.Symbols { symbol_count: 3, pthread_create: 0, pthread_join: 1, munmap: 2 }
    words := arm.position(&c); labels := arm.label_count(&c)
    out := task.emit(&mut c, &rt, &spec, &symbols)
    assert(!out.ok && out.error != "" && arm.position(&c) == words && arm.label_count(&c) == labels)
}
@test fn invalid_task_specs_and_symbols_refuse_before_any_labels_or_words() {
    var c := arm.new(); rt := runtime.new(&mut c); worker := arm.label(&mut c)
    var spec := task.TaskSpec { input_clone: -1, worker: worker, result_clone: -1 }
    var symbols := task.Symbols { symbol_count: 3, pthread_create: 0, pthread_join: 1, munmap: 2 }
    words := c.words.len; labels := c.labels.len
    for mode in 0..9 {
        spec.input_clone = -1; spec.worker = worker; spec.result_clone = -1
        symbols.symbol_count = 3; symbols.pthread_create = 0; symbols.pthread_join = 1; symbols.munmap = 2
        if mode == 0 { spec.input_clone = -2 }
        else if mode == 1 { spec.result_clone = -2 }
        else if mode == 2 { spec.worker = -1 }
        else if mode == 3 { spec.worker = labels }
        else if mode == 4 { symbols.pthread_create = -1 }
        else if mode == 5 { symbols.munmap = symbols.pthread_join }
        else if mode == 6 { spec.result_clone = labels }
        else if mode == 7 { symbols.symbol_count = 2 }
        else { symbols.pthread_join = 3 }
        out := task.emit(&mut c, &rt, &spec, &symbols)
        assert(!out.ok && out.error != "" && c.words.len == words && c.labels.len == labels)
    }
}
fn main() {}
@test fn provider_helpers_cannot_be_inserted_into_source_mir() {
    var c := arm.new(); rt := runtime.new(&mut c); worker := arm.label(&mut c)
    spec := task.TaskSpec { input_clone: -1, worker: worker, result_clone: -1 }
    symbols := task.Symbols { symbol_count: 3, pthread_create: 0, pthread_join: 1, munmap: 2 }
    arm.begin_mir(&mut c, true); words := c.words.len; labels := c.labels.len
    out := task.emit(&mut c, &rt, &spec, &symbols)
    assert(!out.ok && out.error != "" && c.words.len == words && c.labels.len == labels && c.at.len == 0)
}
