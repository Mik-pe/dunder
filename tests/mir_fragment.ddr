import ..selfhost.arm64 as arm
import ..selfhost.mir_lower as lower
import ..selfhost.mir_link as link
import mir_object_support as support

fn range(code: &arm.Code, sites: &[]i32, first: i32, label: i32, reloc: i32, imported: i32, entry: i32) -> lower.FragmentRange {
    lower.FragmentRange { first_word: first, word_end: code.words.len, first_label: label, label_end: code.labels.len,
        first_reloc: reloc, reloc_end: code.at.len, first_import: imported, import_end: sites.len, entry: entry }
}
fn body(code: &mut arm.Code) {
    entry := arm.label(&mut code); outside := arm.label(&mut code); arm.mark(&mut code, outside)
    arm.branch(&mut code, outside, 0); arm.mark(&mut code, entry)
    end := arm.label(&mut code); unset := arm.label(&mut code)
    arm.branch(&mut code, outside, 2); arm.branch(&mut code, end, 0); arm.emit(&mut code, 3596551104)
    arm.mark(&mut code, end)
}
@test fn delayed_capture_excludes_future_namespace_and_owns_entry_end_unmarked_labels() {
    for platform in 0..4 {
        var code := arm.new_for(platform); body(&mut code); none: []i32 = []
        r := range(&code, &none, 1, 2, 1, 0, 0)
        // The next entry shares this function's end position. Position alone
        // cannot establish ownership. Neither future label belongs to r.
        next := arm.label(&mut code); arm.mark(&mut code, next)
        future := arm.label(&mut code); arm.emit(&mut code, 3573751839)
        arm.branch(&mut code, future, 20)
        before := code; var object := lower.new_object()
        assert(lower.capture_verified_fragment(&mut object, &code, &none, &r)); support.same_code(&code, &before)
        assert(lower.object_platform(&object) == platform && lower.object_word_count(&object) == r.word_end - 1)
        assert(lower.object_label_count(&object) == 3 && lower.object_label_id(&object, 0) == 0)
        assert(lower.object_label_offset(&object, 0) == 0 && lower.object_label_id(&object, 1) == 2)
        assert(lower.object_label_offset(&object, 1) == lower.object_word_count(&object))
        assert(lower.object_label_id(&object, 2) == 3 && lower.object_label_offset(&object, 2) == -1)
        assert(lower.object_first_label(&object) == 2 && lower.object_label_end(&object) == 4)
        assert(lower.object_reloc_count(&object) == 2 && lower.object_reloc_target(&object, 0) == 1)
        assert(lower.object_reloc_target(&object, 1) == 2 && lower.object_import_count(&object) == 0)
        code.words.clear(); code.labels.clear(); code.at.clear(); code.target.clear(); code.kinds.clear()
        assert(lower.object_word(&object, 0) == 0 && lower.object_reloc_at(&object, 1) == 2)
    }
}
@test fn all_relocation_kinds_keep_local_word_offsets_and_global_ids() {
    for platform in 0..4 { for kind in 0..21 {
        var code := arm.new_for(platform); entry := arm.label(&mut code); target := arm.label(&mut code)
        arm.emit(&mut code, 3573751839); arm.mark(&mut code, entry)
        arm.branch(&mut code, target, kind); arm.emit(&mut code, 3596551104)
        none: []i32 = []; r := range(&code, &none, 1, 2, 0, 0, entry)
        var object := lower.new_object(); assert(lower.capture_verified_fragment(&mut object, &code, &none, &r))
        assert(lower.object_reloc_at(&object, 0) == 0 && lower.object_reloc_target(&object, 0) == target)
        assert(lower.object_reloc_kind(&object, 0) == kind)
    } }
}
@test fn entry_inside_or_after_private_range_is_owned_exactly_once() {
    for after in 0..2 {
        var code := arm.new(); private := arm.label(&mut code); var entry := private
        if after != 0 { entry = arm.label(&mut code) }
        arm.emit(&mut code, 3573751839); arm.mark(&mut code, entry); arm.emit(&mut code, 3596551104)
        if after != 0 { arm.mark(&mut code, private) }
        none: []i32 = []; var r := range(&code, &none, 1, 0, 0, 0, entry); r.label_end = 1
        var object := lower.new_object(); assert(lower.capture_verified_fragment(&mut object, &code, &none, &r))
        assert(lower.object_label_count(&object) == after + 1 && lower.object_label_id(&object, 0) == 0)
        if after != 0 {
            assert(lower.object_label_offset(&object, 0) == 1 && lower.object_label_id(&object, 1) == entry)
            assert(lower.object_label_offset(&object, 1) == 0)
        } else { assert(lower.object_label_offset(&object, 0) == 0) }
    }
}
@test fn invalid_ranges_and_symbolic_slices_publish_no_object_and_preserve_input() {
    var valid := arm.new(); body(&mut valid); none: []i32 = []
    original := range(&valid, &none, 1, 2, 1, 0, 0); var object := lower.new_object()
    for bad in 0..30 {
        assert(lower.capture_verified_fragment(&mut object, &valid, &none, &original))
        var code := valid; var r := original
        if bad == 0 { r.first_word = -1 }
        if bad == 1 { r.word_end = r.first_word }
        if bad == 2 { r.word_end = code.words.len + 1 }
        if bad == 3 { r.first_label = -1 }
        if bad == 4 { r.label_end = code.labels.len + 1 }
        if bad == 5 { r.first_reloc = -1 }
        if bad == 6 { r.reloc_end = code.at.len + 1 }
        if bad == 7 { r.first_import = -1 }
        if bad == 8 { r.import_end = 1 }
        if bad == 9 { r.entry = -1 }
        if bad == 10 { r.entry = 1 }
        if bad == 11 { code.words[1] = -1 }
        if bad == 12 { code.words[1] = 4294967296 }
        if bad == 13 { code.words[1] = 3573751839 }
        if bad == 14 { code.words[2] = 0 }
        if bad == 15 { code.target[1] = code.labels.len }
        if bad == 16 { code.kinds[1] = 21 }
        if bad == 17 { code.at[2] = code.at[1] }
        if bad == 18 { code.labels[2] = 2 }
        if bad == 19 { code.labels[3] = -2 }
        if bad == 20 { code.labels[3] = 0 }
        if bad == 21 { code.labels[3] = code.words.len + 1 }
        if bad == 22 { r.first_reloc = 2 }
        if bad == 23 { r.reloc_end = 2 }
        if bad == 24 { removed := code.target.pop() }
        if bad == 25 { code.checking = true }
        if bad == 26 { code.mir_capture = true }
        if bad == 27 { code.effect_depth = 1 }
        if bad == 28 { code.platform = 4 }
        if bad == 29 { r.word_end = 2 }
        before := code
        assert(!lower.capture_verified_fragment(&mut object, &code, &none, &r))
        assert(!lower.object_ready(&object)); support.same_code(&code, &before)
    }
    assert(lower.capture_verified_fragment(&mut object, &valid, &none, &original))
}
@test fn imports_keep_global_site_indices_and_local_bytes_with_negative_symbol_slots() {
    for platform in 0..4 {
        var prefix := arm.new_for(platform); entry := arm.label(&mut prefix)
        arm.emit(&mut prefix, 0); arm.emit(&mut prefix, 0)
        prefix_sites: []i32 = [0]; slots: []i32 = [-9, 77, -12]
        var code := arm.new_for(platform); support.copy_code(&mut code, &prefix)
        arm.mark(&mut code, entry); arm.emit(&mut code, 4244635648); arm.emit(&mut code, 0)
        arm.emit(&mut code, 0); arm.emit(&mut code, 0); arm.emit(&mut code, 3596551104)
        sites: []i32 = [0, 8, 16]; r := range(&code, &sites, 2, 1, 0, 1, entry)
        var object := lower.new_object(); assert(lower.capture_verified_fragment(&mut object, &code, &sites, &r))
        assert(lower.object_import_count(&object) == 2 && lower.object_import_id(&object, 0) == 1)
        assert(lower.object_import_id(&object, 1) == 2 && lower.object_import_byte_at(&object, 0) == 0 && lower.object_import_byte_at(&object, 1) == 8)
        var w := link.new(); assert(link.begin(&mut w, &prefix, &prefix_sites) && link.reserve_namespace(&mut w, 1, 3))
        assert(link.append(&mut w, &object, 0) && link.seal_namespace(&mut w, 1) && link.finalize(&mut w))
        var merged := arm.new(); var actual: []i32 = []
        link.export_code(&mut w, &mut merged); link.export_import_sites(&mut w, &mut actual)
        support.same_code(&code, &merged); support.same_i32(&sites, &actual)
        assert(slots[0] == -9 && slots[1] == 77 && slots[2] == -12)
        for bad in 0..8 {
            var wrong := sites; var broken := code; var slice := r
            if bad == 0 { wrong[1] = -1 }
            if bad == 1 { wrong[1] = 9 }
            if bad == 2 { wrong[2] = 8 }
            if bad == 3 { broken.words[3] = 3573751839 }
            if bad == 4 { slice.first_import = 2 }
            if bad == 5 { slice.import_end = 2 }
            if bad == 6 { broken.at.push(2); broken.target.push(0); broken.kinds.push(0); slice.reloc_end = 1 }
            if bad == 7 { slice.first_word = 1; broken.labels[entry] = 1 }
            old := broken; assert(!lower.capture_verified_fragment(&mut object, &broken, &wrong, &slice))
            assert(!lower.object_ready(&object)); support.same_code(&old, &broken)
        }
    }
}
