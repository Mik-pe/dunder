// Stable byte hash; independent of locale and Unicode normalization.
@test {
    ("") -> 0
    ("a") -> 97
    hash("å") != hash("a")
    hash("🌍") == hash("🌍")
}
pub fn hash(text: string) -> i64 {
    var value: i64 = 0
    for byte in text.bytes() {
        value = (value * 131 + i64(byte)) % 2147483647
    }
    value
}
