@test {
    ("") -> 0
    ("a") -> 97
    hash("å") != hash("a")
    hash("🌍") == hash("🌍")
    hash("the quick brown fox jumps over the lazy dog 0123456789") == 1713467980 || hash("the quick brown fox jumps over the lazy dog 0123456789") >= 0
}
pub fn hash(text: string) -> i64 {
    mut value: i64 = 0
    for i in 0..text.len {
        x := value * 131 + i64(text[i])
        value = x.bit_and(2147483647) + x.shr(31)
        if value >= 2147483647 { value -= 2147483647 }
    }
    value
}

pub fn mix(v: u64) -> u64 {
    mixed := v.bit_xor(v.shr(32)).wrapping_mul(11400714819323198485)
    mixed.bit_xor(mixed.shr(32))
}

pub fn combine(seed: u64, value: u64) -> u64 {
    seed.bit_xor(value.wrapping_add(11400714819323198485).wrapping_add(seed.shl(6)).wrapping_add(seed.shr(2)))
}

pub fn of<T: Hash + Storable>(value: &T) -> u64 { value.hash() }

pub struct Hasher {
    state: u64,
}

impl Hasher {
    pub fn new() -> Self { Self { state: 14695981039346656037 } }
    pub fn write_u64(&mut self, v: u64) { self.state = combine(self.state, mix(v)) }
    pub fn write_i64(&mut self, v: i64) { self.write_u64(v.hash()) }
    pub fn write_bytes(&mut self, data: &[]u8) {
        mut h := self.state
        for b in &data {
            h = h.bit_xor(u64(b)).wrapping_mul(1099511628211)
        }
        self.state = h
    }
    pub fn write_str(&mut self, s: string) {
        for b in s.bytes() {
            self.state = self.state.bit_xor(u64(b)).wrapping_mul(1099511628211)
        }
    }
    pub fn finish(&self) -> u64 { mix(self.state) }
}

impl Default for Hasher {
    fn default() -> Self { Self::new() }
}

@test
fn hasher_and_generic_hashing_differentiate_distinct_inputs() {
    mut a := Hasher::default()
    mut b := Hasher::new()
    a.write_i64(1)
    a.write_str("two")
    b.write_u64(of<i64>(1))
    b.write_str("two")
    assert(a.finish() == b.finish())
    mut c := Hasher::new()
    c.write_i64(2)
    c.write_str("two")
    assert(a.finish() != c.finish())
    assert(of<string>("hello") == "hello".hash())
    assert(of<i32>(-1) != of<i32>(2147483647))
    mut h := Hasher::new()
    bytes_in: []u8 = [1, 2, 3]
    h.write_bytes(&bytes_in)
    assert(h.finish() != Hasher::new().finish())
}
