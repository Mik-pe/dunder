@test {
    ("") -> 0
    ("a") -> 97
    hash("å") != hash("a")
    hash("🌍") == hash("🌍")
    hash("the quick brown fox jumps over the lazy dog 0123456789") == 1713467980 || hash("the quick brown fox jumps over the lazy dog 0123456789") >= 0
}
pub fn hash(text: string) -> i64 {
    mut value: i64 = 0
    for i in 0..text.len {
        x := value * 131 + i64(text[i])
        value = x.bit_and(2147483647) + x.shr(31)
        if value >= 2147483647 { value -= 2147483647 }
    }
    value
}
