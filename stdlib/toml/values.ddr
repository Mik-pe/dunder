// TOML 1.0 string and scalar lexing. All positions are input byte offsets.
// Integers extend TOML's guaranteed i64 range with lossless positive u64.
// Dates and non-finite floats use explicit tags instead of losing their kinds.
import std.bytes
import std.json

pub struct Parsed { ok: bool, next: i32, error: string, value: string }
struct Digits { ok: bool, next: i32, count: i32 }

fn fail(at: i32, error: string) -> Parsed {
    Parsed { ok: false, next: at, error: error.clone(), value: "" }
}
fn done(at: i32, value: string) -> Parsed {
    Parsed { ok: true, next: at, error: "", value: value.clone() }
}
fn peek(input: string, at: i32) -> i32 {
    if at < 0 || at >= input.len { return -1 }
    input[at]
}
fn digit(byte: i32) -> i32 {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    -1
}
fn decimal(byte: i32) -> bool { byte >= 48 && byte <= 57 }
fn continuation(byte: i32) -> bool { byte >= 128 && byte <= 191 }

// Checking raw bytes here also locates invalid UTF-8 at its first input byte.
fn utf8_width(input: string, at: i32) -> i32 {
    a := peek(input, at)
    b := peek(input, at + 1)
    if a >= 194 && a <= 223 {
        if continuation(b) { return 2 }
        return 0
    }
    c := peek(input, at + 2)
    if a >= 224 && a <= 239 {
        if !continuation(b) || !continuation(c) { return 0 }
        if a == 224 && b < 160 { return 0 }
        if a == 237 && b >= 160 { return 0 }
        return 3
    }
    d := peek(input, at + 3)
    if a >= 240 && a <= 244 {
        if !continuation(b) || !continuation(c) || !continuation(d) { return 0 }
        if a == 240 && b < 144 { return 0 }
        if a == 244 && b >= 144 { return 0 }
        return 4
    }
    0
}

// Returns decoded text, not JSON. The caller quotes it when writing a value.
pub fn quoted(input: string, start: i32, key: bool) -> Parsed {
    quote := peek(input, start)
    if quote != 34 && quote != 39 { return fail(start, "expected a quoted string") }
    mut pos := start + 1
    mut multiline := false
    if peek(input, pos) == quote && peek(input, pos + 1) == quote {
        if key { return fail(start, "multiline strings are not permitted as keys") }
        multiline = true
        pos += 2
        if peek(input, pos) == 10 { pos += 1 }
        else if peek(input, pos) == 13 {
            if peek(input, pos + 1) != 10 { return fail(pos, "bare carriage return in string") }
            pos += 2
        }
    }
    mut output: []u8 = []
    while pos < input.len {
        byte := input[pos]
        if byte == quote {
            if !multiline { return done(pos + 1, bytes.decode(&output).value) }
            mut count := 1
            while peek(input, pos + count) == quote { count += 1 }
            if count >= 3 {
                if count > 5 { return fail(pos + 5, "too many closing quotes") }
                for _ in 0..count - 3 { output.push(u8(quote)) }
                return done(pos + count, bytes.decode(&output).value)
            }
        }
        if byte == 92 && quote == 34 {
            pos += 1
            escape := peek(input, pos)
            if multiline && (escape == 32 || escape == 9 || escape == 10 || escape == 13) {
                while peek(input, pos) == 32 || peek(input, pos) == 9 { pos += 1 }
                if peek(input, pos) != 10 && peek(input, pos) != 13 {
                    return fail(pos, "line-ending backslash requires a newline")
                }
                while true {
                    trimmed := peek(input, pos)
                    if trimmed == 32 || trimmed == 9 || trimmed == 10 { pos += 1 }
                    else if trimmed == 13 {
                        if peek(input, pos + 1) != 10 { return fail(pos, "bare carriage return in string") }
                        pos += 2
                    } else { break }
                }
                continue
            }
            if escape < 0 { return fail(pos, "unterminated string escape") }
            pos += 1
            if escape == 34 || escape == 92 { output.push(u8(escape)) }
            else if escape == 98 { output.push(8) }
            else if escape == 116 { output.push(9) }
            else if escape == 110 { output.push(10) }
            else if escape == 102 { output.push(12) }
            else if escape == 114 { output.push(13) }
            else if escape == 117 || escape == 85 {
                mut width := 4
                if escape == 85 { width = 8 }
                mut code: i64 = 0
                first := pos
                for _ in 0..width {
                    d := digit(peek(input, pos))
                    if d < 0 { return fail(pos, "invalid Unicode escape") }
                    code = code * 16 + i64(d)
                    pos += 1
                }
                if code > 1114111 || (code >= 55296 && code <= 57343) {
                    return fail(first, "Unicode escape is not a scalar value")
                }
                bytes.append_utf8(&mut output, rune(i32(code)).str())
            } else { return fail(pos - 1, "invalid string escape") }
        } else {
            if byte < 32 && byte != 9 && !(multiline && (byte == 10 || byte == 13)) {
                return fail(pos, "control byte in string")
            }
            if byte == 127 { return fail(pos, "control byte in string") }
            if byte == 13 {
                if !multiline { return fail(pos, "newline in single-line string") }
                if peek(input, pos + 1) != 10 { return fail(pos, "bare carriage return in string") }
                output.push(10)
                pos += 2
            } else if byte >= 128 {
                width := utf8_width(input, pos)
                if width == 0 { return fail(pos, "invalid UTF-8 in string") }
                for i in 0..width { output.push(u8(input[pos + i])) }
                pos += width
            } else {
                output.push(u8(byte))
                pos += 1
            }
        }
    }
    fail(pos, "unterminated string")
}

fn delimiter(byte: i32) -> bool {
    byte < 0 || byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 35 || byte == 44 || byte == 93 || byte == 125
}
fn digits(input: string, start: i32, end: i32, radix: i32) -> Digits {
    mut pos := start
    mut count := 0
    mut previous := false
    while pos < end {
        byte := input[pos]
        d := digit(byte)
        if d >= 0 && d < radix { count += 1; previous = true; pos += 1 }
        else if byte == 95 {
            following := digit(peek(input, pos + 1))
            if !previous || pos + 1 >= end || following < 0 || following >= radix {
                return Digits { ok: false, next: pos, count: count }
            }
            previous = false
            pos += 1
        } else { break }
    }
    Digits { ok: count > 0, next: pos, count: count }
}
fn cleaned(input: string, start: i32, end: i32) -> string {
    mut output: []u8 = []
    mut from := start
    if peek(input, from) == 43 { from += 1 }
    for i in from..end { if input[i] != 95 { output.push(u8(input[i])) } }
    bytes.decode(&output).value
}

fn unsigned_integer(input: string, start: i32, end: i32, radix: i32, negative: bool) -> Parsed {
    // Accumulate in an unsigned integer, including i64's negative magnitude.
    mut limit: u64 = 18446744073709551615
    if negative { limit = 9223372036854775808 }
    mut value: u64 = 0
    for i in start..end {
        if input[i] != 95 {
            d := u64(digit(input[i]))
            if value > (limit - d) / u64(radix) { return fail(i, "integer exceeds supported 64-bit range") }
            value = value * u64(radix) + d
        }
    }
    if radix == 10 { return done(end, cleaned(input, start, end)) }
    mut output: []u8 = []
    json.write_u64(&mut output, value)
    done(end, bytes.decode(&output).value)
}

fn decimal_number(input: string, start: i32, end: i32) -> Parsed {
    mut pos := start
    negative := peek(input, pos) == 45
    if negative || peek(input, pos) == 43 { pos += 1 }
    integral := pos
    whole := digits(input, pos, end, 10)
    if !whole.ok { return fail(whole.next, "expected decimal digits") }
    if whole.count > 1 && input[integral] == 48 { return fail(integral + 1, "leading zero in decimal number") }
    pos = whole.next
    mut floating := false
    if pos < end && input[pos] == 46 {
        floating = true
        fraction := digits(input, pos + 1, end, 10)
        if !fraction.ok { return fail(fraction.next, "expected fractional digits") }
        pos = fraction.next
    }
    if pos < end && (input[pos] == 101 || input[pos] == 69) {
        floating = true
        pos += 1
        if pos < end && (input[pos] == 43 || input[pos] == 45) { pos += 1 }
        exponent := digits(input, pos, end, 10)
        if !exponent.ok { return fail(exponent.next, "expected exponent digits") }
        pos = exponent.next
    }
    if pos != end { return fail(pos, "invalid scalar value") }
    // The JSON projection retains decimal spelling, even when an exponent
    // exceeds binary64. Do not round a configuration value through f64.
    if floating { return done(end, cleaned(input, start, end)) }
    magnitude := unsigned_integer(input, integral, end, 10, negative)
    if !magnitude.ok { return magnitude }
    // TOML has one integer zero. Keep unsigned configuration reads valid for
    // -0 too; floating-point -0.0 retains its sign on the separate path above.
    if magnitude.value == "0" { return done(end, "0") }
    done(end, cleaned(input, start, end))
}

fn fixed_decimal(input: string, start: i32, width: i32, end: i32) -> i32 {
    if start + width > end { return -1 }
    mut value := 0
    for i in start..start + width {
        if !decimal(input[i]) { return -1 }
        value = value * 10 + input[i] - 48
    }
    value
}
fn date_shape(input: string, start: i32, end: i32) -> bool {
    end - start >= 10 && peek(input, start + 4) == 45 && peek(input, start + 7) == 45
}
fn month_days(year: i32, month: i32) -> i32 {
    if month == 2 {
        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) { return 29 }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    31
}
fn date_time(input: string, start: i32, end: i32, has_date: bool) -> Parsed {
    mut pos := start
    mut tag := "$toml_time"
    if has_date {
        year := fixed_decimal(input, pos, 4, end)
        month := fixed_decimal(input, pos + 5, 2, end)
        day := fixed_decimal(input, pos + 8, 2, end)
        if year < 0 { return fail(pos, "invalid calendar year") }
        if month < 1 || month > 12 { return fail(pos + 5, "invalid calendar month") }
        if day < 1 || day > month_days(year, month) { return fail(pos + 8, "invalid calendar day") }
        pos += 10
        if pos == end { return done(end, "{\"$toml_date\":" + json.quote(input[start..end]) + "}") }
        if input[pos] != 84 && input[pos] != 116 && input[pos] != 32 { return fail(pos, "expected date-time separator") }
        pos += 1
        tag = "$toml_datetime"
    }
    hour := fixed_decimal(input, pos, 2, end)
    minute := fixed_decimal(input, pos + 3, 2, end)
    second := fixed_decimal(input, pos + 6, 2, end)
    if hour < 0 || hour > 23 { return fail(pos, "invalid time hour") }
    if peek(input, pos + 2) != 58 { return fail(pos + 2, "expected time colon") }
    if minute < 0 || minute > 59 { return fail(pos + 3, "invalid time minute") }
    if peek(input, pos + 5) != 58 { return fail(pos + 5, "expected time colon") }
    if second == 60 { return fail(pos + 6, "leap seconds are not supported") }
    if second < 0 || second > 59 { return fail(pos + 6, "invalid time second") }
    pos += 8
    if pos < end && input[pos] == 46 {
        pos += 1
        first := pos
        while pos < end && decimal(input[pos]) { pos += 1 }
        if first == pos { return fail(pos, "expected fractional second digits") }
    }
    if pos < end {
        if !has_date { return fail(pos, "local time cannot have an offset") }
        if input[pos] == 90 || input[pos] == 122 { pos += 1 }
        else if input[pos] == 43 || input[pos] == 45 {
            zone_hour := fixed_decimal(input, pos + 1, 2, end)
            zone_minute := fixed_decimal(input, pos + 4, 2, end)
            if zone_hour < 0 || zone_hour > 23 { return fail(pos + 1, "invalid offset hour") }
            if peek(input, pos + 3) != 58 { return fail(pos + 3, "expected offset colon") }
            if zone_minute < 0 || zone_minute > 59 { return fail(pos + 4, "invalid offset minute") }
            pos += 6
        } else { return fail(pos, "invalid date-time suffix") }
    }
    if pos != end { return fail(pos, "invalid date-time suffix") }
    mut output: []u8 = []
    for i in start..end {
        mut b := input[i]
        if has_date && i == start + 10 { b = 84 }
        if b == 122 { b = 90 }
        output.push(u8(b))
    }
    done(end, "{" + json.quote(tag) + ":" + json.quote(bytes.decode(&output).value) + "}")
}

// Returns the JSON spelling of exactly one TOML scalar, ending at a delimiter.
pub fn scalar(input: string, start: i32) -> Parsed {
    if start < 0 || start >= input.len { return fail(start, "expected a value") }
    mut end := start
    while end < input.len && !delimiter(input[end]) { end += 1 }
    if end == start { return fail(start, "expected a value") }
    // TOML permits one space in place of T. Consume it only for date tokens.
    if end == start + 10 && date_shape(input, start, end) && peek(input, end) == 32 && decimal(peek(input, end + 1)) {
        end += 1
        while end < input.len && !delimiter(input[end]) { end += 1 }
    }
    raw := input[start..end]
    if raw == "true" || raw == "false" { return done(end, raw) }
    if raw == "inf" || raw == "+inf" { return done(end, "{\"$toml_float\":\"inf\"}") }
    if raw == "-inf" { return done(end, "{\"$toml_float\":\"-inf\"}") }
    if raw == "nan" || raw == "+nan" || raw == "-nan" { return done(end, "{\"$toml_float\":\"nan\"}") }
    if date_shape(input, start, end) { return date_time(input, start, end, true) }
    if end - start >= 3 && peek(input, start + 2) == 58 { return date_time(input, start, end, false) }
    if end - start >= 2 && input[start] == 48 {
        mut radix := 0
        if input[start + 1] == 120 { radix = 16 }
        else if input[start + 1] == 111 { radix = 8 }
        else if input[start + 1] == 98 { radix = 2 }
        if radix != 0 {
            body := digits(input, start + 2, end, radix)
            if !body.ok || body.next != end { return fail(body.next, "invalid radix integer") }
            return unsigned_integer(input, start + 2, end, radix, false)
        }
    }
    decimal_number(input, start, end)
}
