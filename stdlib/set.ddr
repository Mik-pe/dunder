import std.hash as hashing

pub struct Set { keys: []string, slots: []i32, length: i32, used: i32 }
pub fn new() -> Set { Set { keys: [], slots: [], length: 0, used: 0 } }
pub fn length(values: &Set) -> i32 { values.length }
fn locate(values: &Set, key: string) -> i32 {
    capacity := values.slots.len
    if capacity == 0 { return -1 }
    var slot := i32(hashing.hash(key) % i64(capacity))
    for step in 0..capacity {
        state := values.slots[slot]
        if state == 0 { return -1 }
        if state == 1 && values.keys[slot] == key { return slot }
        slot = (slot + 1) % capacity
    }
    -1
}
pub fn contains(values: &Set, key: string) -> bool { locate(&values, key) >= 0 }
fn insert_slot(values: &mut Set, key: string) {
    capacity := values.slots.len
    var slot := i32(hashing.hash(key) % i64(capacity))
    while values.slots[slot] == 1 { slot = (slot + 1) % capacity }
    if values.slots[slot] == 0 { values.used = values.used + 1 }
    values.slots[slot] = 1
    values.keys[slot] = key
    values.length = values.length + 1
}
fn rehash(values: &mut Set, capacity: i32) {
    var fresh := new()
    fresh.keys.reserve(capacity)
    fresh.slots.reserve(capacity)
    for i in 0..capacity { fresh.keys.push(""); fresh.slots.push(0) }
    for i in 0..values.slots.len {
        if values.slots[i] == 1 { insert_slot(&mut fresh, values.keys[i]) }
    }
    values = fresh
}
pub fn reserve(values: &mut Set, entries: i32) {
    assert(entries >= 0)
    var capacity := 8
    while i64(capacity) * 7 < i64(entries) * 10 { capacity = capacity * 2 }
    if capacity > values.slots.len { rehash(&mut values, capacity) }
}
pub fn insert(values: &mut Set, key: string) -> bool {
    if contains(&values, key) { return false }
    capacity := values.slots.len
    if capacity == 0 { rehash(&mut values, 8) }
    else if (values.used + 1) * 10 >= capacity * 7 {
        if (values.length + 1) * 10 < capacity * 4 { rehash(&mut values, capacity) }
        else { rehash(&mut values, capacity * 2) }
    }
    insert_slot(&mut values, key)
    true
}
pub fn remove(values: &mut Set, key: string) -> bool {
    slot := locate(&values, key)
    if slot < 0 { return false }
    values.slots[slot] = 2
    values.keys[slot] = ""
    values.length = values.length - 1
    true
}
pub fn clear(values: &mut Set) {
    for i in 0..values.slots.len { values.slots[i] = 0; values.keys[i] = "" }
    values.length = 0
    values.used = 0
}
pub fn items(values: &Set) -> []string {
    var result: []string = []
    result.reserve(values.length)
    for i in 0..values.slots.len { if values.slots[i] == 1 { result.push(values.keys[i]) } }
    result
}
@test fn set_deduplicates_utf8_and_survives_tombstones() {
    var collisions := new()
    insert(&mut collisions, "a"); insert(&mut collisions, "i"); insert(&mut collisions, "q"); insert(&mut collisions, "y")
    remove(&mut collisions, "a")
    !insert(&mut collisions, "q")
    contains(&collisions, "y")
    length(&collisions) == 3
    var values := new()
    insert(&mut values, "")
    insert(&mut values, "🌍")
    !insert(&mut values, "🌍")
    for i in 0..1000 { insert(&mut values, i.str()) }
    length(&values) == 1002
    copy := values
    for i in 0..1000 { remove(&mut values, i.str()) }
    length(&values) == 2
    length(&copy) == 1002
    for i in 0..1000 { insert(&mut values, i.str()) }
    items(&values).len == 1002
    clear(&mut values)
    !contains(&values, "🌍")
    insert(&mut values, "after clear")
    length(&values) == 1
}
