pub const PI: f64 = 3.14159265358979323846

pub fn min(a: f64, b: f64) -> f64 {
    if a.is_nan() { return a }
    if a < b || (a == b && a.is_sign_negative()) { a } else { b }
}

pub fn max(a: f64, b: f64) -> f64 {
    if a.is_nan() { return a }
    if a > b || (a == b && !a.is_sign_negative()) { a } else { b }
}

fn quiet_nan() -> f64 { f64.from_bits(0x7ff8_0000_0000_0000) }

pub fn clamp(value: f64, low: f64, high: f64) -> f64 {
    if low.is_nan() { return low }
    if high.is_nan() { return high }
    if low > high { return quiet_nan() }
    if value < low { low } else if value > high { high } else { value }
}

fn product_bit(product: &[i64; 67], index: i32) -> i32 {
    i32(product[index / 24].shr(index % 24).bit_and(1))
}

// Payne–Hanek reduction. Multiply the exact significand by floor(2^1536 * 2/pi).
// The table stores little-endian 24-bit limbs so each product and carry fits i64.
fn reduce_large(x: f64) -> (i32, f64) {
    digits: [i64; 64] = [
        0x73a8c9, 0x1556ca, 0x310606, 0x4d7327, 0xffd880, 0x68408d, 0x5f14a0, 0x659985,
        0xe61b08, 0x91615e, 0x1da9e3, 0x9af436, 0xcfbc20, 0x6babf0, 0x46fc7b, 0x560330,
        0x8d5d08, 0x5fb11f, 0xea6bfb, 0x8a5292, 0x0739f7, 0xf17b3d, 0xc7ebe5, 0x7527ba,
        0x5fea2d, 0x3f669e, 0xb74f46, 0x27cb09, 0x367ecf, 0x6d1f6d, 0x8b5a0a, 0xef2f11,
        0x05980f, 0x97ffde, 0x3b1ff8, 0xbdf928, 0x845f8b, 0x39f49c, 0x398353, 0x3991d6,
        0x5f7e41, 0x7026b4, 0x84e99c, 0x2ebb44, 0x8235f5, 0xa73ee8, 0x1cb129, 0xfe1deb,
        0xd1921c, 0x2eea09, 0xe00649, 0x424dd2, 0x246e3a, 0xc561b7, 0xabdebb, 0xfe5163,
        0x439041, 0x95993c, 0xc0db62, 0xf534dd, 0x2757d1, 0x1529fc, 0x6e4e44, 0xa2f983,
    ]
    bits := x.to_bits()
    significand := bits.bit_and(0x000f_ffff_ffff_ffff).bit_or(0x0010_0000_0000_0000)
    exponent := i32(bits.shr(52)) - 1023
    point := 1536 + 52 - exponent
    mask: i64 = 0xff_ffff
    low := significand.bit_and(mask)
    middle := significand.shr(24).bit_and(mask)
    high := significand.shr(48)
    mut product: [i64; 67] = [0; 67]
    mut carry: i64 = 0
    // Only the two integer bits adjoining the binary point determine the quadrant.
    for i in 0..((point + 1) / 24 + 1) {
        mut sum := carry
        if i < digits.len { sum += low * digits[i] }
        if i >= 1 && i - 1 < digits.len { sum += middle * digits[i - 1] }
        if i >= 2 && i - 2 < digits.len { sum += high * digits[i - 2] }
        product[i] = sum.bit_and(mask)
        carry = sum.shr(24)
    }
    quadrant := product_bit(&product, point) + 2 * product_bit(&product, point + 1)
    round_up := product_bit(&product, point - 1) != 0
    if round_up {
        // Take the fixed-point complement before conversion to avoid cancellation near a multiple of pi/2.
        carry = 1
        for i in 0..((point + 23) / 24) {
            limb := mask - product[i] + carry
            product[i] = limb.bit_and(mask)
            carry = limb.shr(24)
        }
    }
    mut fraction := 0.0
    whole := point / 24
    for i in 0..whole { fraction = (fraction + f64(product[i])) / 16777216.0 }
    rest := point % 24
    if rest != 0 {
        scale := i64(1).shl(rest)
        fraction = (fraction + f64(product[whole].bit_and(scale - 1))) / f64(scale)
    }
    remainder := fraction * 1.5707963267948966
    if round_up { return ((quadrant + 1).bit_and(3), -remainder) }
    (quadrant, remainder)
}

fn reduce(x: f64) -> (i32, f64) {
    if x < 524288.0 {
        // The leading two parts of pi/2 have at most 33 significant bits.
        // Their products with the integer multiple are exact in this range.
        multiple := (x * 0.6366197723675814).round_ties_even()
        remainder := ((x - multiple * 1.5707963267341256) -
            multiple * 6.077100506303966e-11) - multiple * 2.0222662487959506e-21
        if remainder.abs() > 2.9103830456733704e-11 && remainder.abs() <= 0.7853981633974483 {
            return (i32(multiple).bit_and(3), remainder)
        }
    }
    reduce_large(x)
}

// Taylor kernels on [-pi/4, pi/4], evaluated with Horner's rule.
fn sine_kernel(x: f64) -> f64 {
    square := x * x
    mut coefficient := 2.8114572543455206e-15
    coefficient = -7.647163731819816e-13 + square * coefficient
    coefficient = 1.6059043836821613e-10 + square * coefficient
    coefficient = -2.505210838544172e-8 + square * coefficient
    coefficient = 2.7557319223985893e-6 + square * coefficient
    coefficient = -0.0001984126984126984 + square * coefficient
    coefficient = 0.008333333333333333 + square * coefficient
    coefficient = -0.16666666666666666 + square * coefficient
    x + (x * square) * coefficient
}

fn cosine_kernel(x: f64) -> f64 {
    square := x * x
    mut coefficient := -1.5619206968586225e-16
    coefficient = 4.779477332387385e-14 + square * coefficient
    coefficient = -1.1470745597729725e-11 + square * coefficient
    coefficient = 2.08767569878681e-9 + square * coefficient
    coefficient = -2.755731922398589e-7 + square * coefficient
    coefficient = 2.48015873015873e-5 + square * coefficient
    coefficient = -0.001388888888888889 + square * coefficient
    coefficient = 0.041666666666666664 + square * coefficient
    coefficient = -0.5 + square * coefficient
    1.0 + square * coefficient
}

enum Trig { Sine, Cosine, Tangent }

fn trig(angle: f64, operation: Trig) -> f64 {
    if !angle.is_finite() {
        return if angle.is_nan() { angle } else { quiet_nan() }
    }
    mut remainder := angle.abs()
    mut quadrant := 0
    if remainder > 0.7853981633974483 {
        (q, r) := reduce(remainder)
        quadrant = q
        remainder = r
    }
    if operation == Trig.Tangent {
        sine := sine_kernel(remainder)
        cosine := cosine_kernel(remainder)
        value := if quadrant.bit_and(1) == 0 { sine / cosine } else { -cosine / sine }
        return if angle.is_sign_negative() { -value } else { value }
    }
    if operation == Trig.Cosine { quadrant = (quadrant + 1).bit_and(3) }
    value := if quadrant.bit_and(1) == 0 { sine_kernel(remainder) } else { cosine_kernel(remainder) }
    negative := (quadrant >= 2) != (operation == Trig.Sine && angle.is_sign_negative())
    if negative { -value } else { value }
}

pub fn sin(angle: f64) -> f64 { trig(angle, .Sine) }
pub fn cos(angle: f64) -> f64 { trig(angle, .Cosine) }
pub fn tan(angle: f64) -> f64 { trig(angle, .Tangent) }

pub trait Trigonometry {
    fn sin(&self) -> Self
    fn cos(&self) -> Self
    fn tan(&self) -> Self
}

impl Trigonometry for f32 {
    fn sin(&self) -> f32 { f32(sin(f64(self))) }
    fn cos(&self) -> f32 { f32(cos(f64(self))) }
    fn tan(&self) -> f32 { f32(tan(f64(self))) }
}

impl Trigonometry for f64 {
    fn sin(&self) -> f64 { sin(self) }
    fn cos(&self) -> f64 { cos(self) }
    fn tan(&self) -> f64 { tan(self) }
}

@test fn trigonometric_methods_preserve_precision_and_sign() {
    x: f32 = -0.75
    a: f32 = x.sin()
    b: f32 = x.cos()
    c: f32 = x.tan()
    assert(a == f32(sin(f64(x))) && b == f32(cos(f64(x))) && c == f32(tan(f64(x))))
    y: f64 = -0.75
    assert(y.sin() == sin(y) && y.cos() == cos(y) && y.tan() == tan(y))
    zero: f32 = -0.0
    assert(zero.sin().is_sign_negative() && zero.tan().is_sign_negative())
}

const LN2_HIGH: f64 = 0.69314718036912381649
const LN2_LOW: f64 = 1.90821492927058770002e-10

fn scale_normal(exponent: i32) -> f64 { f64.from_bits(i64(exponent + 1023).shl(52)) }

fn positive_infinity() -> f64 { f64.from_bits(0x7ff0_0000_0000_0000) }

fn exp_parts(x: f64, tail: f64) -> f64 {
    if x.is_nan() { return x }
    if x > 710.0 { return positive_infinity() }
    if x < -746.0 { return 0.0 }
    multiple := (x * 1.4426950408889634).round_ties_even()
    r := (x - multiple * LN2_HIGH) + (tail - multiple * LN2_LOW)
    mut polynomial := 1.0
    mut k := 16
    while k >= 1 {
        polynomial = 1.0 + (r / f64(k)) * polynomial
        k -= 1
    }
    power := i32(multiple)
    if power > 1023 { return (polynomial * scale_normal(power - 1023)) * scale_normal(1023) }
    if power < -1022 { return (polynomial * scale_normal(power + 1022)) * scale_normal(-1022) }
    polynomial * scale_normal(power)
}

pub fn exp(x: f64) -> f64 { exp_parts(x, 0.0) }

fn product_error(a: f64, b: f64, product: f64) -> f64 {
    high_a := f64.from_bits(a.to_bits().bit_and(-134217728))
    high_b := f64.from_bits(b.to_bits().bit_and(-134217728))
    low_a := a - high_a
    low_b := b - high_b
    ((high_a * high_b - product + low_a * high_b) + high_a * low_b) + low_a * low_b
}

fn log_parts(x: f64) -> (f64, f64) {
    mut bits := x.to_bits()
    mut power := i32(bits.shr(52)) - 1023
    if power == -1023 {
        bits = (x * 18014398509481984.0).to_bits()
        power = i32(bits.shr(52)) - 1077
    }
    mut m := f64.from_bits(bits.bit_and(0x000f_ffff_ffff_ffff).bit_or(0x3ff0_0000_0000_0000))
    if m > 1.4142135623730951 { m *= 0.5; power += 1 }
    f := m - 1.0
    denominator := 1.0 + m
    s := f / denominator
    product := s * denominator
    correction := ((f - product - product_error(s, denominator, product)) -
        s * ((1.0 - denominator) + m)) / denominator
    square := s * s
    cube := s * square
    cube_low := product_error(s, square, cube) + s * product_error(s, s, square)
    third := cube / 3.0
    rounded := third * 3.0
    third_low := ((cube - rounded) - product_error(third, 3.0, rounded) + cube_low) / 3.0
    mut series := 0.0
    mut odd := 27
    while odd >= 5 {
        series = 1.0 / f64(odd) + square * series
        odd -= 2
    }
    large := f64(power) * LN2_HIGH
    linear := 2.0 * s
    head := large + linear
    cubic := 2.0 * third
    sum := head + cubic
    tail := ((large - head) + linear) + ((head - sum) + cubic) + f64(power) * LN2_LOW +
        2.0 * ((correction / (1.0 - square) + third_low) + (cube * square) * series)
    total := sum + tail
    (total, (sum - total) + tail)
}

pub fn log(x: f64) -> f64 {
    if x.is_nan() { return x }
    if x == 0.0 { return -positive_infinity() }
    if x < 0.0 { return quiet_nan() }
    if x.is_infinite() { return x }
    (value, _) := log_parts(x)
    value
}

pub fn pow(base: f64, exponent: f64) -> f64 {
    if exponent == 0.0 || base == 1.0 { return 1.0 }
    if exponent.is_nan() { return exponent }
    if base.is_nan() { return base }
    magnitude := base.abs()
    if exponent.is_infinite() {
        if magnitude == 1.0 { return 1.0 }
        return if (magnitude > 1.0) == (exponent > 0.0) { positive_infinity() } else { 0.0 }
    }
    integral := exponent == exponent.trunc()
    negative := base.is_sign_negative() && integral && exponent.abs() < 9007199254740992.0 &&
        i64(exponent).bit_and(1) != 0
    mut result := 0.0
    if magnitude == 0.0 || magnitude.is_infinite() {
        if (magnitude == 0.0) == (exponent < 0.0) { result = positive_infinity() }
    } else {
        if base < 0.0 && !integral { return quiet_nan() }
        if exponent == 1.0 { return base }
        if exponent == -1.0 { return 1.0 / base }
        if exponent == 2.0 { return base * base }
        if exponent == 0.5 { return base.sqrt() }
        (head, tail) := log_parts(magnitude)
        value := exponent * head
        if value > 710.0 { result = positive_infinity() }
        else if value >= -746.0 {
            result = exp_parts(value, product_error(exponent, head, value) + exponent * tail)
        }
    }
    if negative { -result } else { result }
}

fn atan_unit(ratio: f64) -> f64 {
    reduce := ratio > 0.414213562373095
    x := if reduce { (ratio - 1.0) / (ratio + 1.0) } else { ratio }
    square := x * x
    mut series := 0.0
    mut odd := 43
    while odd >= 3 {
        series = 1.0 / f64(odd) - square * series
        odd -= 2
    }
    angle := x - x * square * series
    if reduce { PI / 4.0 + angle } else { angle }
}

pub fn atan2(y: f64, x: f64) -> f64 {
    if y.is_nan() { return y }
    if x.is_nan() { return x }
    ax := x.abs()
    ay := y.abs()
    mut angle := 0.0
    if ay == 0.0 { angle = 0.0 }
    else if ax == ay { angle = PI / 4.0 }
    else if ay > ax { angle = PI / 2.0 - atan_unit(ax / ay) }
    else { angle = atan_unit(ay / ax) }
    if x.is_sign_negative() { angle = PI - angle }
    if y.is_sign_negative() { -angle } else { angle }
}

@test
fn atan2_handles_quadrants_and_axis_limits() {
    inf := f64.from_bits(0x7ff0_0000_0000_0000)
    assert(atan2(0.0, -0.0) == PI && atan2(-0.0, -0.0) == -PI)
    assert(atan2(-0.0, 1.0).is_sign_negative() && !atan2(0.0, 0.0).is_sign_negative())
    assert(atan2(1.0, 0.0) == PI / 2.0 && atan2(-inf, 1.0) == -PI / 2.0)
    assert(atan2(inf, -inf) == 3.0 * PI / 4.0 && atan2(-inf, inf) == -PI / 4.0)
    assert(atan2(-1.0, inf).is_sign_negative() && atan2(1.0, -inf) == PI)
    assert(atan2(quiet_nan(), 1.0).is_nan() && atan2(1.0, quiet_nan()).is_nan())
    assert(atan2(f64.from_bits(1), 1.0).to_bits() == 1)
    for angle in [-3.0, -2.4, -0.5, 0.1, 0.4, 0.75, 1.2, 2.0, 3.0] {
        assert((atan2(sin(angle), cos(angle)) - angle).abs() < 5e-16)
    }
}

fn total_order_bits_f64(x: f64) -> i64 {
    bits := x.to_bits()
    if bits < 0 { bits.bit_xor(9223372036854775807) } else { bits }
}

fn total_order_bits_f32(x: f32) -> i32 {
    bits := x.to_bits()
    if bits < 0 { bits.bit_xor(2147483647) } else { bits }
}

pub fn total_cmp_f64(a: &f64, b: &f64) -> Ordering {
    total_order_bits_f64(a).cmp(total_order_bits_f64(b))
}

pub fn total_cmp_f32(a: &f32, b: &f32) -> Ordering {
    total_order_bits_f32(a).cmp(total_order_bits_f32(b))
}

pub fn checked_add_i32(a: i32, b: i32) -> Result<i32, ()> {
    sum := i64(a) + i64(b)
    if sum < -2147483648 || sum > 2147483647 { return .Err }
    .Ok(i32(sum))
}

pub fn checked_sub_i32(a: i32, b: i32) -> Result<i32, ()> {
    diff := i64(a) - i64(b)
    if diff < -2147483648 || diff > 2147483647 { return .Err }
    .Ok(i32(diff))
}

pub fn checked_mul_i32(a: i32, b: i32) -> Result<i32, ()> {
    prod := i64(a) * i64(b)
    if prod < -2147483648 || prod > 2147483647 { return .Err }
    .Ok(i32(prod))
}

pub fn checked_div_i32(a: i32, b: i32) -> Result<i32, ()> {
    if b == 0 || (a == -2147483648 && b == -1) { return .Err }
    .Ok(a / b)
}

pub fn checked_rem_i32(a: i32, b: i32) -> Result<i32, ()> {
    if b == 0 || (a == -2147483648 && b == -1) { return .Err }
    .Ok(a % b)
}

pub fn checked_neg_i32(a: i32) -> Result<i32, ()> {
    if a == -2147483648 { return .Err }
    .Ok(-a)
}

fn i64_max() -> i64 { 9223372036854775807 }
fn i64_min() -> i64 { (-9223372036854775807) - 1 }

pub fn checked_add_i64(a: i64, b: i64) -> Result<i64, ()> {
    if b > 0 && a > i64_max() - b { return .Err }
    if b < 0 && a < i64_min() - b { return .Err }
    .Ok(a + b)
}

pub fn checked_sub_i64(a: i64, b: i64) -> Result<i64, ()> {
    if b < 0 && a > i64_max() + b { return .Err }
    if b > 0 && a < i64_min() + b { return .Err }
    .Ok(a - b)
}

pub fn checked_mul_i64(a: i64, b: i64) -> Result<i64, ()> {
    if a == 0 || b == 0 { return .Ok(0) }
    min := i64_min()
    max := i64_max()
    if a > 0 {
        if b > 0 {
            if a > max / b { return .Err }
        } else {
            if b < min / a { return .Err }
        }
    } else {
        if b > 0 {
            if a < min / b { return .Err }
        } else {
            if a == min || b == min { return .Err }
            if a < max / b { return .Err }
        }
    }
    .Ok(a * b)
}

pub fn checked_div_i64(a: i64, b: i64) -> Result<i64, ()> {
    if b == 0 || (a == i64_min() && b == -1) { return .Err }
    .Ok(a / b)
}

pub fn checked_rem_i64(a: i64, b: i64) -> Result<i64, ()> {
    if b == 0 || (a == i64_min() && b == -1) { return .Err }
    .Ok(a % b)
}

pub fn checked_neg_i64(a: i64) -> Result<i64, ()> {
    if a == i64_min() { return .Err }
    .Ok(-a)
}

pub fn checked_add_u32(a: u32, b: u32) -> Result<u32, ()> {
    sum := u64(a) + u64(b)
    if sum > u64(4294967295) { return .Err }
    .Ok(u32(sum))
}

pub fn checked_sub_u32(a: u32, b: u32) -> Result<u32, ()> {
    if a < b { return .Err }
    .Ok(a - b)
}

pub fn checked_mul_u32(a: u32, b: u32) -> Result<u32, ()> {
    prod := u64(a) * u64(b)
    if prod > u64(4294967295) { return .Err }
    .Ok(u32(prod))
}

pub fn checked_div_u32(a: u32, b: u32) -> Result<u32, ()> {
    if b == u32(0) { return .Err }
    .Ok(a / b)
}

pub fn checked_rem_u32(a: u32, b: u32) -> Result<u32, ()> {
    if b == u32(0) { return .Err }
    .Ok(a % b)
}

pub fn checked_add_u64(a: u64, b: u64) -> Result<u64, ()> {
    max := u64(0).wrapping_sub(u64(1))
    if a > max - b { return .Err }
    .Ok(a + b)
}

pub fn checked_sub_u64(a: u64, b: u64) -> Result<u64, ()> {
    if a < b { return .Err }
    .Ok(a - b)
}

pub fn checked_mul_u64(a: u64, b: u64) -> Result<u64, ()> {
    max := u64(0).wrapping_sub(u64(1))
    if b != u64(0) && a > max / b { return .Err }
    .Ok(a * b)
}

pub fn checked_div_u64(a: u64, b: u64) -> Result<u64, ()> {
    if b == u64(0) { return .Err }
    .Ok(a / b)
}

pub fn checked_rem_u64(a: u64, b: u64) -> Result<u64, ()> {
    if b == u64(0) { return .Err }
    .Ok(a % b)
}

pub fn checked_add_usize(a: usize, b: usize) -> Result<usize, ()> {
    max := usize(0).wrapping_sub(usize(1))
    if a > max - b { return .Err }
    .Ok(a + b)
}

pub fn checked_sub_usize(a: usize, b: usize) -> Result<usize, ()> {
    if a < b { return .Err }
    .Ok(a - b)
}

pub fn checked_mul_usize(a: usize, b: usize) -> Result<usize, ()> {
    max := usize(0).wrapping_sub(usize(1))
    if b != usize(0) && a > max / b { return .Err }
    .Ok(a * b)
}

pub fn checked_div_usize(a: usize, b: usize) -> Result<usize, ()> {
    if b == usize(0) { return .Err }
    .Ok(a / b)
}

pub fn checked_rem_usize(a: usize, b: usize) -> Result<usize, ()> {
    if b == usize(0) { return .Err }
    .Ok(a % b)
}

@test
fn total_cmp_orders_signed_zero_infinities_and_nans() {
    neg_nan := f64.from_bits(-2251799813685248)
    neg_inf := -1.0 / 0.0
    neg_zero := -0.0
    pos_zero := 0.0
    pos_inf := 1.0 / 0.0
    pos_nan := f64.from_bits(9221120237041090560)
    assert(total_cmp_f64(neg_nan, neg_inf) == Ordering.Less)
    assert(total_cmp_f64(neg_inf, -1.0) == Ordering.Less)
    assert(total_cmp_f64(-1.0, neg_zero) == Ordering.Less)
    assert(total_cmp_f64(neg_zero, pos_zero) == Ordering.Less)
    assert(total_cmp_f64(pos_zero, 1.0) == Ordering.Less)
    assert(total_cmp_f64(1.0, pos_inf) == Ordering.Less)
    assert(total_cmp_f64(pos_inf, pos_nan) == Ordering.Less)
    assert(total_cmp_f64(pos_nan, pos_nan) == Ordering.Equal)

    f_neg_zero := f32.from_bits(-2147483648)
    f_pos_zero := f32(0.0)
    assert(total_cmp_f32(f_neg_zero, f_pos_zero) == Ordering.Less)
    assert(total_cmp_f32(f32(1.5), f32(1.5)) == Ordering.Equal)
}

@test
fn checked_integer_arithmetic_detects_overflow_and_division_by_zero() {
    assert(checked_add_i32(2147483647, 0).unwrap_or(-1) == 2147483647)
    assert(checked_add_i32(2147483647, 1).is_err())
    assert(checked_add_i32(-2147483648, -1).is_err())
    assert(checked_sub_i32(-2147483648, 1).is_err())
    assert(checked_sub_i32(2147483647, -1).is_err())
    assert(checked_mul_i32(46341, 46341).is_err())
    assert(checked_mul_i32(-2147483648, -1).is_err())
    assert(checked_mul_i32(-2147483648, 1).unwrap_or(0) == -2147483648)
    assert(checked_div_i32(-2147483648, -1).is_err())
    assert(checked_div_i32(10, 0).is_err())
    assert(checked_rem_i32(-2147483648, -1).is_err())
    assert(checked_rem_i32(10, 0).is_err())
    assert(checked_neg_i32(-2147483648).is_err())
    assert(checked_neg_i32(-2147483647).unwrap_or(0) == 2147483647)

    max64 := i64_max()
    min64 := i64_min()
    assert(checked_add_i64(max64, 1).is_err())
    assert(checked_add_i64(min64, -1).is_err())
    assert(checked_add_i64(max64, min64).unwrap_or(0) == -1)
    assert(checked_sub_i64(min64, min64).unwrap_or(1) == 0)
    assert(checked_sub_i64(min64, 1).is_err())
    assert(checked_sub_i64(max64, -1).is_err())
    assert(checked_mul_i64(min64, -1).is_err())
    assert(checked_mul_i64(-1, min64).is_err())
    assert(checked_mul_i64(-1, max64).unwrap_or(0) == -max64)
    assert(checked_mul_i64(max64, -1).unwrap_or(0) == -max64)
    assert(checked_mul_i64(min64, 2).is_err())
    assert(checked_mul_i64(3037000500, 3037000500).is_err())
    assert(checked_mul_i64(-3037000500, -3037000500).is_err())
    assert(checked_mul_i64(min64, 0).unwrap_or(1) == 0)
    assert(checked_div_i64(min64, -1).is_err())
    assert(checked_div_i64(42, 0).is_err())
    assert(checked_rem_i64(min64, -1).is_err())
    assert(checked_rem_i64(42, 0).is_err())
    assert(checked_neg_i64(min64).is_err())
    assert(checked_neg_i64(-max64).unwrap_or(0) == max64)

    assert(checked_add_u32(4294967295, 1).is_err())
    assert(checked_sub_u32(3, 4).is_err())
    assert(checked_mul_u32(65536, 65536).is_err())
    assert(checked_div_u32(9, 0).is_err())
    assert(checked_rem_u32(9, 0).is_err())

    maxu64 := u64(0).wrapping_sub(u64(1))
    assert(checked_add_u64(maxu64, 1).is_err())
    assert(checked_sub_u64(1, 2).is_err())
    assert(checked_mul_u64(maxu64, 2).is_err())
    assert(checked_div_u64(9, 0).is_err())
    assert(checked_rem_u64(9, 0).is_err())

    maxusz := usize(0).wrapping_sub(usize(1))
    assert(checked_add_usize(maxusz, 1).is_err())
    assert(checked_sub_usize(1, 2).is_err())
    assert(checked_mul_usize(maxusz, 2).is_err())
    assert(checked_div_usize(9, 0).is_err())
    assert(checked_rem_usize(9, 0).is_err())
}
