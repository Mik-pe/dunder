capability unsafe

// POSIX dynamic loader. Paths and symbols are pointers to NUL-terminated bytes.
// Keep the handle open for the lifetime of every function pointer taken from it.
@extern("dl", "dlopen")
pub unsafe fn open(path: ptr, flags: i32) -> ptr

@extern("dl", "dlsym")
pub unsafe fn symbol(library: ptr, name: ptr) -> ptr

@extern("dl", "dlclose")
pub unsafe fn close(library: ptr) -> i32
