pub unsafe fn memory_equal(lhs: ptr, rhs: ptr, count: usize) -> bool { __sys_memory_equal(lhs, rhs, count) }
@thread_safe
pub unsafe fn memory_zero(dst: ptr, count: usize) { __sys_memory_zero(dst, count) }
@thread_safe
pub unsafe fn atomic_load_i64(p: ptr) -> i64 { __sys_atomic_load_i64(p) }
@thread_safe
pub unsafe fn atomic_store_i64(p: ptr, value: i64) { __sys_atomic_store_i64(p, value) }
@thread_safe
pub unsafe fn atomic_cas_i64(p: ptr, expected: i64, desired: i64) -> i64 { __sys_atomic_cas_i64(p, expected, desired) }
@thread_safe
pub unsafe fn atomic_fetch_add_i64(p: ptr, delta: i64) -> i64 { __sys_atomic_fetch_add_i64(p, delta) }
@thread_safe
