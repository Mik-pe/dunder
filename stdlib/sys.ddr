@requires(filesystem)
pub fn metadata(path: string) -> Metadata {
    if target_is("windows") { return windows_metadata(winfs.stat(path, true)) }
    __sys_metadata(path)
}
pub fn pid() -> i32 {
    if target_is("windows") { return winbase.pid() } else { return __sys_pid() }
}
pub fn now_ms() -> i64 {
    if target_is("windows") { return winbase.now_ms() } else { return __sys_now_ms() }
}
@thread_safe
pub fn sleep_ms(ms: i64) {
    if ms <= 0 { return }
    if target_is("windows") { winbase.sleep_ms(ms) }
    else {
        mut empty: []u8 = []
        _ := __sys_net_poll(&mut empty, 0, ms)
    }
}
pub fn arg_count() -> i32 { __sys_arg_count() }
pub fn arg(index: i32) -> string { __sys_arg(index) }
pub unsafe fn envp() -> ptr { __sys_envp() }
@thread_safe
pub unsafe fn linux_syscall(nr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 { __sys_linux_syscall(nr, a0, a1, a2, a3, a4, a5) }
@requires(filesystem)
pub fn make_executable(path: string) -> Status {
    if target_is("windows") { return win_status(winfs.stat(path, true).error) }
    __sys_make_executable(path)
}
@requires(filesystem)
pub fn write_u8(path: string, bytes: &[]u8) -> Status {
    if target_is("windows") { return win_write_file(path, &bytes, false) }
    __sys_write_u8(path, &bytes)
}
pub fn decode_u8(bytes: &[]u8) -> TextResult { __sys_decode_u8(&bytes) }
pub fn decode_u8_range(bytes: &[]u8, start: i64, length: i64) -> TextResult { __sys_decode_u8_range(&bytes, start, length) }
@requires(filesystem)
pub fn same_file(first: string, second: string) -> bool {
    if target_is("windows") { a := winfs.stat(first, true); b := winfs.stat(second, true); return a.error == 0 && b.error == 0 && a.dev == b.dev && a.ino == b.ino }
    __sys_same_file(first, second)
}
