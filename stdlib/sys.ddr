@test {
    (0) -> "ok"
    (2) -> "no such file or directory"
    (4) -> "interrupted"
    (28) -> "no space left on device"
    (92) -> "invalid UTF-8"
    (93) -> "unexpected end of file"
    (94) -> "write returned zero bytes"
    (12345) -> "OS error 12345"
}
pub fn error_message(error: i32) -> string {
    if error == 0 { return "ok" }
    if error == 2 { return "no such file or directory" }
    if error == 4 { return "interrupted" }
    if error == 5 { return "I/O error" }
    if error == 9 { return "bad file descriptor" }
    if error == 12 { return "out of memory" }
    if error == 13 { return "permission denied" }
    if error == 17 { return "already exists" }
    if error == 20 { return "not a directory" }
    if error == 21 { return "is a directory" }
    if error == 22 { return "invalid argument" }
    if error == 27 { return "file too large" }
    if error == 28 { return "no space left on device" }
    if error == 32 { return "broken pipe" }
    if error == 35 { return "temporarily unavailable" }
    if error == 36 { return "operation in progress" }
    if error == 40 { return "message too long" }
    if error == 45 { return "not supported" }
    if error == 47 { return "address family not supported" }
    if error == 48 { return "address already in use" }
    if error == 49 { return "cannot assign requested address" }
    if error == 51 { return "network is unreachable" }
    if error == 53 { return "connection aborted" }
    if error == 54 { return "connection reset" }
    if error == 57 { return "socket is not connected" }
    if error == 60 { return "timed out" }
    if error == 61 { return "connection refused" }
    if error == 63 { return "path too long" }
    if error == 65 { return "no route to host" }
    if error == 66 { return "directory not empty" }
    if error == 92 { return "invalid UTF-8" }
    if error == 93 { return "unexpected end of file" }
    if error == 94 { return "write returned zero bytes" }
    f"OS error {error}"
}

pub enum FileKind { Other = 0, File = 1, Directory = 2, Symlink = 3 }
pub enum IoError {
    Other(i32) = 0,
    NotFound = 2,
    Interrupted = 4,
    BadDescriptor = 9,
    OutOfMemory = 12,
    PermissionDenied = 13,
    AlreadyExists = 17,
    NotDirectory = 20,
    IsDirectory = 21,
    InvalidArgument = 22,
    TooLarge = 27,
    NoSpace = 28,
    BrokenPipe = 32,
    WouldBlock = 35,
    InProgress = 36,
    Unsupported = 45,
    AddressInUse = 48,
    ConnectionAborted = 53,
    ConnectionReset = 54,
    TimedOut = 60,
    ConnectionRefused = 61,
    NameTooLong = 63,
    NotEmpty = 66,
    InvalidUtf8 = 92,
    UnexpectedEof = 93,
    WriteZero = 94,
}
impl Status {
    pub fn into_result(&self) -> Result<(), IoError> {
        if self.ok { .Ok } else { .Err(IoError::from_code(self.error)) }
    }
}
impl TextResult {
    pub fn into_result(move self) -> Result<string, IoError> {
        if self.ok { .Ok(self.value) } else { .Err(IoError::from_code(self.error)) }
    }
}
impl BytesResult {
    pub fn into_result(move self) -> Result<[]u8, IoError> {
        if self.ok { .Ok(self.value) } else { .Err(IoError::from_code(self.error)) }
    }
}

@requires(filesystem)
pub fn read(path: string) -> Result<string, IoError> {
    read_text(path).into_result()
}
@requires(filesystem)
pub fn read_limit(path: string, max_bytes: i64) -> Result<string, IoError> {
    read_text_limit(path, max_bytes).into_result()
}
@requires(filesystem)
pub fn read_bytes(path: string) -> Result<[]u8, IoError> {
    read_u8(path).into_result()
}
@requires(filesystem)
pub fn read_bytes_limit(path: string, max_bytes: i64) -> Result<[]u8, IoError> {
    read_u8_limit(path, max_bytes).into_result()
}
@requires(filesystem)
pub fn write(path: string, text: string) -> Result<(), IoError> {
    write_text(path, text).into_result()
}
@requires(filesystem)
pub fn write_bytes(path: string, data: &[]u8) -> Result<(), IoError> {
    write_u8(path, &data).into_result()
}

pub fn file_kind(info: Metadata) -> FileKind { info.kind() }

impl Metadata {
    pub fn kind(&self) -> FileKind {
        if self.is_symlink { .Symlink }
        else if self.is_file { .File }
        else if self.is_dir { .Directory }
        else { .Other }
    }
    pub fn permissions(&self) -> u32 { self.mode.bit_and(u32(4095)) }
}

impl IoError {
    pub fn would_block() -> Self { .WouldBlock }
    pub fn is_would_block(&self) -> bool { self.code() == 35 }

    pub fn from_code(error: i32) -> Self {
        if error == 2 { return .NotFound }
        if error == 4 { return .Interrupted }
        if error == 9 { return .BadDescriptor }
        if error == 12 { return .OutOfMemory }
        if error == 13 { return .PermissionDenied }
        if error == 17 { return .AlreadyExists }
        if error == 20 { return .NotDirectory }
        if error == 21 { return .IsDirectory }
        if error == 22 { return .InvalidArgument }
        if error == 27 { return .TooLarge }
        if error == 28 { return .NoSpace }
        if error == 32 { return .BrokenPipe }
        if error == 35 { return .WouldBlock }
        if error == 36 { return .InProgress }
        if error == 45 { return .Unsupported }
        if error == 48 { return .AddressInUse }
        if error == 53 { return .ConnectionAborted }
        if error == 54 { return .ConnectionReset }
        if error == 60 { return .TimedOut }
        if error == 61 { return .ConnectionRefused }
        if error == 63 { return .NameTooLong }
        if error == 66 { return .NotEmpty }
        if error == 92 { return .InvalidUtf8 }
        if error == 93 { return .UnexpectedEof }
        if error == 94 { return .WriteZero }
        .Other(error)
    }

    pub fn code(&self) -> i32 {
        match self {
            .NotFound => 2,
            .Interrupted => 4,
            .BadDescriptor => 9,
            .OutOfMemory => 12,
            .PermissionDenied => 13,
            .AlreadyExists => 17,
            .NotDirectory => 20,
            .IsDirectory => 21,
            .InvalidArgument => 22,
            .TooLarge => 27,
            .NoSpace => 28,
            .BrokenPipe => 32,
            .WouldBlock => 35,
            .InProgress => 36,
            .Unsupported => 45,
            .AddressInUse => 48,
            .ConnectionAborted => 53,
            .ConnectionReset => 54,
            .TimedOut => 60,
            .ConnectionRefused => 61,
            .NameTooLong => 63,
            .NotEmpty => 66,
            .InvalidUtf8 => 92,
            .UnexpectedEof => 93,
            .WriteZero => 94,
            .Other(code) => code,
        }
    }

    pub fn message(&self) -> string { error_message(self.code()) }
}

pub fn error_from_code(error: i32) -> IoError { IoError::from_code(error) }

@test {
    (.NotFound) -> 2
    (.Interrupted) -> 4
    (.NoSpace) -> 28
    (.InvalidUtf8) -> 92
    (.UnexpectedEof) -> 93
    (.WriteZero) -> 94
    (.ConnectionReset) -> 54
    (.Other(12345)) -> 12345
    IoError::would_block().is_would_block()
    !IoError.NotFound.is_would_block()
    IoError::from_code(4) == IoError.Interrupted
    IoError::from_code(93) == IoError.UnexpectedEof
    IoError::from_code(63).code() == 63
    IoError::from_code(48).code() == 48
    IoError::from_code(54321).code() == 54321
    error_code(error_from_code(63)) == 63
    error_code(error_from_code(48)) == 48
    error_code(error_from_code(54321)) == 54321
}
pub fn error_code(error: IoError) -> i32 { error.code() }

pub fn io_error_message(error: IoError) -> string { error.message() }

impl Display for IoError {
    fn str(&self) -> string { self.message() }
}
impl Eq for IoError {
    fn eq(&self, other: &Self) -> bool { self.code() == other.code() }
}
impl Hash for IoError {
    fn hash(&self) -> u64 { self.code().hash() }
}

impl Display for FileKind {
    fn str(&self) -> string {
        match self {
            .Other => "Other",
            .File => "File",
            .Directory => "Directory",
            .Symlink => "Symlink",
        }
    }
}
impl Eq for FileKind {
    fn eq(&self, other: &Self) -> bool { self == other }
}
impl Hash for FileKind {
    fn hash(&self) -> u64 {
        v := match self { .Other => 0, .File => 1, .Directory => 2, .Symlink => 3 }
        v.hash()
    }
}

impl Eq for Status {
    fn eq(&self, other: &Self) -> bool { self.ok == other.ok && self.error == other.error }
}
