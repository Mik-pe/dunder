// macOS/Linux filesystem API. error is zero on success, otherwise a Dunder code.
// Known Linux errno values map to the original Darwin-compatible codes below.
// Unmapped Linux errno values use 10000 + errno; see docs/sys.md.
pub struct Status { ok: bool, error: i32 }
pub struct TextResult { ok: bool, value: string, error: i32 }
pub struct BytesResult { ok: bool, value: []u8, error: i32 }
pub struct Metadata { ok: bool, size: i64, is_file: bool, is_dir: bool, error: i32 }

pub fn read_text(path: string) -> TextResult { __sys_read_text(path) }
pub fn read_u8_into(path: string, out: &mut []u8, max_bytes: i64) -> Status { __sys_read_u8(path, &mut out, max_bytes) }
pub fn read_u8_limit(path: string, max_bytes: i64) -> BytesResult {
    if max_bytes < 0 { return BytesResult { ok: false, value: [], error: 22 } }
    for attempt in 0..4 {
        info := metadata(path)
        if !info.ok { return BytesResult { ok: false, value: [], error: info.error } }
        if info.is_dir { return BytesResult { ok: false, value: [], error: 21 } }
        if info.size > max_bytes || info.size > 2147483640 {
            return BytesResult { ok: false, value: [], error: 27 }
        }
        var buf: []u8 = []
        buf.reserve(i32(info.size) + 1)
        st := read_u8_into(path, &mut buf, max_bytes)
        if st.ok { return BytesResult { ok: true, value: buf, error: 0 } }
        if st.error != 35 { return BytesResult { ok: false, value: [], error: st.error } }
    }
    BytesResult { ok: false, value: [], error: 35 }
}
pub fn read_u8(path: string) -> BytesResult { read_u8_limit(path, 67108864) }
pub fn write_text(path: string, text: string) -> Status { __sys_write_text(path, text) }
pub fn write_stderr(text: string) -> Status { __sys_write_stderr(text) }
pub fn eprint(text: string) -> Status { write_stderr(text + "\n") }
pub fn append_text(path: string, text: string) -> Status { __sys_append_text(path, text) }
pub fn mkdir(path: string) -> Status { __sys_mkdir(path) }
pub fn rename(from: string, to: string) -> Status { __sys_rename(from, to) }
pub fn remove_file(path: string) -> Status { __sys_remove_file(path) }
pub fn remove_dir(path: string) -> Status { __sys_remove_dir(path) }
pub fn metadata(path: string) -> Metadata { __sys_metadata(path) }
pub fn pid() -> i32 { __sys_pid() }
pub fn now_ms() -> i64 { __sys_now_ms() }
pub fn arg_count() -> i32 { __sys_arg_count() }
pub fn arg(index: i32) -> string { __sys_arg(index) }
pub fn write_bytes(path: string, bytes: &[]i32) -> Status { __sys_write_bytes(path, &bytes) }
pub fn make_executable(path: string) -> Status { __sys_make_executable(path) }
pub fn write_u8(path: string, bytes: &[]u8) -> Status { __sys_write_u8(path, &bytes) }
pub fn decode_u8(bytes: &[]u8) -> TextResult { __sys_decode_u8(&bytes) }
pub fn decode_u8_range(bytes: &[]u8, start: i64, length: i64) -> TextResult { __sys_decode_u8_range(&bytes, start, length) }
pub fn decode_utf8(bytes: &[]i32) -> TextResult { __sys_decode_utf8(&bytes) }
pub fn same_file(first: string, second: string) -> bool { __sys_same_file(first, second) }
pub fn net_listen(ipv4: i64, port: i64, backlog: i64) -> i64 { __sys_net_listen(ipv4, port, backlog) }
pub fn net_accept(listen_fd: i32) -> i64 { __sys_net_accept(listen_fd) }
pub fn net_connect(ipv4: i64, port: i64) -> i64 { __sys_net_connect(ipv4, port) }
pub fn net_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_read(fd, &mut out, max_bytes) }
pub fn net_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 { __sys_net_write(fd, &data, offset, length) }
pub fn net_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 { __sys_net_poll(&mut fds, nfds, timeout_ms) }
pub fn net_set_nonblocking(fd: i32, enabled: bool) -> i64 { __sys_net_set_nonblocking(fd, enabled) }
pub fn net_set_nodelay(fd: i32, enabled: bool) -> i64 { __sys_net_set_nodelay(fd, enabled) }
pub fn net_local_port(fd: i32) -> i64 { __sys_net_local_port(fd) }
pub fn net_shutdown_write(fd: i32) -> i64 { __sys_net_shutdown_write(fd) }
pub fn net_close(fd: i32) -> i64 { __sys_net_close(fd) }

@test {
    (0) -> "ok"
    (2) -> "no such file or directory"
    (92) -> "invalid UTF-8"
    (12345) -> "OS error 12345"
}
pub fn error_message(error: i32) -> string {
    if error == 0 { return "ok" }
    if error == 2 { return "no such file or directory" }
    if error == 5 { return "I/O error" }
    if error == 9 { return "bad file descriptor" }
    if error == 12 { return "out of memory" }
    if error == 13 { return "permission denied" }
    if error == 17 { return "already exists" }
    if error == 20 { return "not a directory" }
    if error == 21 { return "is a directory" }
    if error == 22 { return "invalid argument" }
    if error == 27 { return "file too large" }
    if error == 32 { return "broken pipe" }
    if error == 35 { return "temporarily unavailable" }
    if error == 36 { return "operation in progress" }
    if error == 45 { return "not supported" }
    if error == 48 { return "address already in use" }
    if error == 53 { return "connection aborted" }
    if error == 54 { return "connection reset" }
    if error == 60 { return "timed out" }
    if error == 61 { return "connection refused" }
    if error == 63 { return "path too long" }
    if error == 66 { return "directory not empty" }
    if error == 92 { return "invalid UTF-8" }
    "OS error " + error.str()
}

pub enum FileKind { Other = 0, File = 1, Directory = 2 }
pub enum IoError {
    Other(i32) = 0,
    NotFound = 2,
    BadDescriptor = 9,
    OutOfMemory = 12,
    PermissionDenied = 13,
    AlreadyExists = 17,
    NotDirectory = 20,
    IsDirectory = 21,
    InvalidArgument = 22,
    TooLarge = 27,
    BrokenPipe = 32,
    Changed = 35,
    InProgress = 36,
    Unsupported = 45,
    AddressInUse = 48,
    ConnectionAborted = 53,
    ConnectionReset = 54,
    TimedOut = 60,
    ConnectionRefused = 61,
    NameTooLong = 63,
    NotEmpty = 66,
    InvalidUtf8 = 92,
}
pub enum ReadResult { Ok(string), Err(IoError) }

pub fn read(path: string) -> ReadResult {
    result := read_text(path)
    if result.ok { .Ok(result.value) }
    else { .Err(error_from_code(result.error)) }
}

pub fn file_kind(info: Metadata) -> FileKind {
    if info.is_file { .File }
    else if info.is_dir { .Directory }
    else { .Other }
}

pub fn error_from_code(error: i32) -> IoError {
    if error == 2 { return .NotFound }
    if error == 9 { return .BadDescriptor }
    if error == 12 { return .OutOfMemory }
    if error == 13 { return .PermissionDenied }
    if error == 17 { return .AlreadyExists }
    if error == 20 { return .NotDirectory }
    if error == 21 { return .IsDirectory }
    if error == 22 { return .InvalidArgument }
    if error == 27 { return .TooLarge }
    if error == 32 { return .BrokenPipe }
    if error == 35 { return .Changed }
    if error == 36 { return .InProgress }
    if error == 45 { return .Unsupported }
    if error == 48 { return .AddressInUse }
    if error == 53 { return .ConnectionAborted }
    if error == 54 { return .ConnectionReset }
    if error == 60 { return .TimedOut }
    if error == 61 { return .ConnectionRefused }
    if error == 63 { return .NameTooLong }
    if error == 66 { return .NotEmpty }
    if error == 92 { return .InvalidUtf8 }
    .Other(error)
}

@test {
    (.NotFound) -> 2
    (.InvalidUtf8) -> 92
    (.ConnectionReset) -> 54
    (.Other(12345)) -> 12345
    error_code(error_from_code(63)) == 63
    error_code(error_from_code(48)) == 48
    error_code(error_from_code(54321)) == 54321
}
pub fn error_code(error: IoError) -> i32 {
    match error {
        .NotFound => 2,
        .BadDescriptor => 9,
        .OutOfMemory => 12,
        .PermissionDenied => 13,
        .AlreadyExists => 17,
        .NotDirectory => 20,
        .IsDirectory => 21,
        .InvalidArgument => 22,
        .TooLarge => 27,
        .BrokenPipe => 32,
        .Changed => 35,
        .InProgress => 36,
        .Unsupported => 45,
        .AddressInUse => 48,
        .ConnectionAborted => 53,
        .ConnectionReset => 54,
        .TimedOut => 60,
        .ConnectionRefused => 61,
        .NameTooLong => 63,
        .NotEmpty => 66,
        .InvalidUtf8 => 92,
        .Other(code) => code,
    }
}

pub fn io_error_message(error: IoError) -> string { error_message(error_code(error)) }
