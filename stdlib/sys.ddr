capability unsafe, filesystem, stdio
pub struct Status { ok: bool, error: i32 }
pub struct TextResult { ok: bool, value: string, error: i32 }
pub struct BytesResult { ok: bool, value: []u8, error: i32 }
pub struct Metadata {
    ok: bool,
    size: i64,
    is_file: bool,
    is_dir: bool,
    error: i32,
    is_symlink: bool,
    mode: u32,
    uid: u32,
    gid: u32,
    nlink: u64,
    dev: u64,
    ino: u64,
    mtime: i64,
}

@requires(filesystem)
pub fn read_text(path: string) -> TextResult { __sys_read_text(path) }
@requires(filesystem)
pub fn read_text_limit(path: string, max_bytes: i64) -> TextResult {
    raw := read_u8_limit(path, max_bytes)
    if !raw.ok { return TextResult { ok: false, value: "", error: raw.error } }
    decode_u8(&raw.value)
}
@requires(filesystem)
pub fn read_u8_into(path: string, out: &mut []u8, max_bytes: i64) -> Status { __sys_read_u8(path, &mut out, max_bytes) }
@requires(filesystem)
pub fn read_u8_limit(path: string, max_bytes: i64) -> BytesResult {
    if max_bytes < 0 { return BytesResult { ok: false, value: [], error: 22 } }
    for attempt in 0..4 {
        info := metadata(path)
        if !info.ok { return BytesResult { ok: false, value: [], error: info.error } }
        if info.is_dir { return BytesResult { ok: false, value: [], error: 21 } }
        if info.size > max_bytes || info.size > 2147483640 {
            return BytesResult { ok: false, value: [], error: 27 }
        }
        mut buf: []u8 = []
        buf.reserve(i32(info.size) + 1)
        st := read_u8_into(path, &mut buf, max_bytes)
        if st.ok { return BytesResult { ok: true, value: buf, error: 0 } }
        if st.error != 35 { return BytesResult { ok: false, value: [], error: st.error } }
    }
    BytesResult { ok: false, value: [], error: 35 }
}
@requires(filesystem)
pub fn read_u8(path: string) -> BytesResult { read_u8_limit(path, 268435456) }
@requires(filesystem)
pub fn write_text(path: string, text: string) -> Status { __sys_write_text(path, text) }
@requires(stdio)
pub fn write_stderr(text: string) -> Status { __sys_write_stderr(text) }
@requires(stdio)
pub fn eprint(text: string) -> Status { write_stderr(text + "\n") }
@requires(filesystem)
pub fn append_text(path: string, text: string) -> Status { __sys_append_text(path, text) }
@requires(filesystem)
pub fn mkdir(path: string) -> Status { __sys_mkdir(path) }
@requires(filesystem)
pub fn rename(from: string, to: string) -> Status { __sys_rename(from, to) }
@requires(filesystem)
pub fn remove_file(path: string) -> Status { __sys_remove_file(path) }
@requires(filesystem)
pub fn remove_dir(path: string) -> Status { __sys_remove_dir(path) }
@requires(filesystem)
pub fn metadata(path: string) -> Metadata { __sys_metadata(path) }
pub fn pid() -> i32 { __sys_pid() }
pub fn now_ms() -> i64 { __sys_now_ms() }
@thread_safe
pub fn sleep_ms(ms: i64) {
    if ms <= 0 { return }
    mut empty: []u8 = []
    _ := __sys_net_poll(&mut empty, 0, ms)
}
pub fn arg_count() -> i32 { __sys_arg_count() }
pub fn arg(index: i32) -> string { __sys_arg(index) }
pub unsafe fn envp() -> ptr { __sys_envp() }
@thread_safe
pub unsafe fn linux_syscall(nr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 { __sys_linux_syscall(nr, a0, a1, a2, a3, a4, a5) }
@requires(filesystem)
pub fn make_executable(path: string) -> Status { __sys_make_executable(path) }
@requires(filesystem)
pub fn write_u8(path: string, bytes: &[]u8) -> Status { __sys_write_u8(path, &bytes) }
pub fn decode_u8(bytes: &[]u8) -> TextResult { __sys_decode_u8(&bytes) }
pub fn decode_u8_range(bytes: &[]u8, start: i64, length: i64) -> TextResult { __sys_decode_u8_range(&bytes, start, length) }
@requires(filesystem)
pub fn same_file(first: string, second: string) -> bool { __sys_same_file(first, second) }
@thread_safe
pub unsafe fn memory_copy(destination: ptr, source: ptr, count: usize) { __sys_memory_copy(destination, source, count) }
@thread_safe
pub unsafe fn memory_equal(lhs: ptr, rhs: ptr, count: usize) -> bool { __sys_memory_equal(lhs, rhs, count) }
@thread_safe
pub unsafe fn memory_zero(dst: ptr, count: usize) { __sys_memory_zero(dst, count) }
@thread_safe
pub unsafe fn atomic_load_i64(p: ptr) -> i64 { __sys_atomic_load_i64(p) }
@thread_safe
pub unsafe fn atomic_store_i64(p: ptr, value: i64) { __sys_atomic_store_i64(p, value) }
@thread_safe
pub unsafe fn atomic_cas_i64(p: ptr, expected: i64, desired: i64) -> i64 { __sys_atomic_cas_i64(p, expected, desired) }
@thread_safe
pub unsafe fn atomic_fetch_add_i64(p: ptr, delta: i64) -> i64 { __sys_atomic_fetch_add_i64(p, delta) }
pub unsafe fn pool_alloc_try(size: usize) -> ptr { __sys_pool_alloc_try(size) }
pub unsafe fn pool_free(p: ptr) { __sys_pool_free(p) }
pub fn bytes_extend(output: &mut []u8, input: &[]u8, start: i32, end: i32) { __sys_bytes_extend(&mut output, &input, start, end) }
pub fn bytes_append_text(output: &mut []u8, text: string) { __sys_bytes_append_text(&mut output, text) }
@thread_safe
pub unsafe fn fd_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_read(fd, &mut out, max_bytes) }
@thread_safe
pub unsafe fn fd_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 { __sys_fd_write(fd, &data, offset, length) }
@thread_safe
pub unsafe fn fd_close(fd: i32) -> i64 { __sys_net_close(fd) }
@thread_safe
pub unsafe fn fd_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 { __sys_net_poll(&mut fds, nfds, timeout_ms) }
@thread_safe
pub unsafe fn fd_set_nonblocking(fd: i32, enabled: bool) -> i64 { __sys_net_set_nonblocking(fd, enabled) }
@requires(network)
pub fn net_listen(ipv4: i64, port: i64, backlog: i64) -> i64 { __sys_net_listen(ipv4, port, backlog) }
@requires(network)
pub fn net_accept(listen_fd: i32) -> i64 { __sys_net_accept(listen_fd) }
@requires(network)
pub fn net_connect(ipv4: i64, port: i64) -> i64 { __sys_net_connect(ipv4, port) }
@requires(network)
@thread_safe
pub fn net_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_read(fd, &mut out, max_bytes) }
@requires(network)
pub fn net_peek(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 { __sys_net_peek(fd, &mut out, max_bytes) }
@requires(network)
pub fn net_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 { __sys_net_write(fd, &data, offset, length) }
@requires(network)
@thread_safe
pub fn net_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 { __sys_net_poll(&mut fds, nfds, timeout_ms) }
@requires(network)
@thread_safe
pub fn net_set_nonblocking(fd: i32, enabled: bool) -> i64 { __sys_net_set_nonblocking(fd, enabled) }
@requires(network)
pub fn net_set_nodelay(fd: i32, enabled: bool) -> i64 { __sys_net_set_nodelay(fd, enabled) }
@requires(network)
pub fn net_local_port(fd: i32) -> i64 { __sys_net_local_port(fd) }
@requires(network)
pub fn net_shutdown_write(fd: i32) -> i64 { __sys_net_shutdown_write(fd) }
@requires(network)
@thread_safe
pub fn net_close(fd: i32) -> i64 { __sys_net_close(fd) }

@test {
    (0) -> "ok"
    (2) -> "no such file or directory"
    (4) -> "interrupted"
    (28) -> "no space left on device"
    (92) -> "invalid UTF-8"
    (93) -> "unexpected end of file"
    (94) -> "write returned zero bytes"
    (12345) -> "OS error 12345"
}
pub fn error_message(error: i32) -> string {
    if error == 0 { return "ok" }
    if error == 2 { return "no such file or directory" }
    if error == 4 { return "interrupted" }
    if error == 5 { return "I/O error" }
    if error == 9 { return "bad file descriptor" }
    if error == 12 { return "out of memory" }
    if error == 13 { return "permission denied" }
    if error == 17 { return "already exists" }
    if error == 20 { return "not a directory" }
    if error == 21 { return "is a directory" }
    if error == 22 { return "invalid argument" }
    if error == 27 { return "file too large" }
    if error == 28 { return "no space left on device" }
    if error == 32 { return "broken pipe" }
    if error == 35 { return "temporarily unavailable" }
    if error == 36 { return "operation in progress" }
    if error == 40 { return "message too long" }
    if error == 45 { return "not supported" }
    if error == 47 { return "address family not supported" }
    if error == 48 { return "address already in use" }
    if error == 49 { return "cannot assign requested address" }
    if error == 51 { return "network is unreachable" }
    if error == 53 { return "connection aborted" }
    if error == 54 { return "connection reset" }
    if error == 57 { return "socket is not connected" }
    if error == 60 { return "timed out" }
    if error == 61 { return "connection refused" }
    if error == 63 { return "path too long" }
    if error == 65 { return "no route to host" }
    if error == 66 { return "directory not empty" }
    if error == 92 { return "invalid UTF-8" }
    if error == 93 { return "unexpected end of file" }
    if error == 94 { return "write returned zero bytes" }
    f"OS error {error}"
}

pub enum FileKind { Other = 0, File = 1, Directory = 2, Symlink = 3 }
pub enum IoError {
    Other(i32) = 0,
    NotFound = 2,
    Interrupted = 4,
    BadDescriptor = 9,
    OutOfMemory = 12,
    PermissionDenied = 13,
    AlreadyExists = 17,
    NotDirectory = 20,
    IsDirectory = 21,
    InvalidArgument = 22,
    TooLarge = 27,
    NoSpace = 28,
    BrokenPipe = 32,
    WouldBlock = 35,
    InProgress = 36,
    Unsupported = 45,
    AddressInUse = 48,
    ConnectionAborted = 53,
    ConnectionReset = 54,
    TimedOut = 60,
    ConnectionRefused = 61,
    NameTooLong = 63,
    NotEmpty = 66,
    InvalidUtf8 = 92,
    UnexpectedEof = 93,
    WriteZero = 94,
}
@requires(filesystem)
pub fn read(path: string) -> Result<string, IoError> {
    result := read_text(path)
    if result.ok { .Ok(result.value) }
    else { .Err(error_from_code(result.error)) }
}
@requires(filesystem)
pub fn read_bytes(path: string) -> Result<[]u8, IoError> {
    result := read_u8(path)
    if result.ok { .Ok(result.value) }
    else { .Err(error_from_code(result.error)) }
}
@requires(filesystem)
pub fn write(path: string, text: string) -> Result<(), IoError> {
    st := write_text(path, text)
    if st.ok { .Ok }
    else { .Err(error_from_code(st.error)) }
}
@requires(filesystem)
pub fn write_bytes(path: string, data: &[]u8) -> Result<(), IoError> {
    st := write_u8(path, &data)
    if st.ok { .Ok }
    else { .Err(error_from_code(st.error)) }
}

pub fn file_kind(info: Metadata) -> FileKind { info.kind() }

impl Metadata {
    pub fn kind(&self) -> FileKind {
        if self.is_symlink { .Symlink }
        else if self.is_file { .File }
        else if self.is_dir { .Directory }
        else { .Other }
    }
    pub fn permissions(&self) -> u32 { self.mode.bit_and(u32(4095)) }
}

impl IoError {
    pub fn would_block() -> Self { .WouldBlock }
    pub fn is_would_block(&self) -> bool { self.code() == 35 }

    pub fn from_code(error: i32) -> Self {
        if error == 2 { return .NotFound }
        if error == 4 { return .Interrupted }
        if error == 9 { return .BadDescriptor }
        if error == 12 { return .OutOfMemory }
        if error == 13 { return .PermissionDenied }
        if error == 17 { return .AlreadyExists }
        if error == 20 { return .NotDirectory }
        if error == 21 { return .IsDirectory }
        if error == 22 { return .InvalidArgument }
        if error == 27 { return .TooLarge }
        if error == 28 { return .NoSpace }
        if error == 32 { return .BrokenPipe }
        if error == 35 { return .WouldBlock }
        if error == 36 { return .InProgress }
        if error == 45 { return .Unsupported }
        if error == 48 { return .AddressInUse }
        if error == 53 { return .ConnectionAborted }
        if error == 54 { return .ConnectionReset }
        if error == 60 { return .TimedOut }
        if error == 61 { return .ConnectionRefused }
        if error == 63 { return .NameTooLong }
        if error == 66 { return .NotEmpty }
        if error == 92 { return .InvalidUtf8 }
        if error == 93 { return .UnexpectedEof }
        if error == 94 { return .WriteZero }
        .Other(error)
    }

    pub fn code(&self) -> i32 {
        match self {
            .NotFound => 2,
            .Interrupted => 4,
            .BadDescriptor => 9,
            .OutOfMemory => 12,
            .PermissionDenied => 13,
            .AlreadyExists => 17,
            .NotDirectory => 20,
            .IsDirectory => 21,
            .InvalidArgument => 22,
            .TooLarge => 27,
            .NoSpace => 28,
            .BrokenPipe => 32,
            .WouldBlock => 35,
            .InProgress => 36,
            .Unsupported => 45,
            .AddressInUse => 48,
            .ConnectionAborted => 53,
            .ConnectionReset => 54,
            .TimedOut => 60,
            .ConnectionRefused => 61,
            .NameTooLong => 63,
            .NotEmpty => 66,
            .InvalidUtf8 => 92,
            .UnexpectedEof => 93,
            .WriteZero => 94,
            .Other(code) => code,
        }
    }

    pub fn message(&self) -> string { error_message(self.code()) }
}

pub fn error_from_code(error: i32) -> IoError { IoError::from_code(error) }

@test {
    (.NotFound) -> 2
    (.Interrupted) -> 4
    (.NoSpace) -> 28
    (.InvalidUtf8) -> 92
    (.UnexpectedEof) -> 93
    (.WriteZero) -> 94
    (.ConnectionReset) -> 54
    (.Other(12345)) -> 12345
    IoError::would_block().is_would_block()
    !IoError.NotFound.is_would_block()
    IoError::from_code(4) == IoError.Interrupted
    IoError::from_code(93) == IoError.UnexpectedEof
    IoError::from_code(63).code() == 63
    IoError::from_code(48).code() == 48
    IoError::from_code(54321).code() == 54321
    error_code(error_from_code(63)) == 63
    error_code(error_from_code(48)) == 48
    error_code(error_from_code(54321)) == 54321
}
pub fn error_code(error: IoError) -> i32 { error.code() }

pub fn io_error_message(error: IoError) -> string { error.message() }

impl Display for IoError {
    fn str(&self) -> string { self.message() }
}
impl Eq for IoError {
    fn eq(&self, other: &Self) -> bool { self.code() == other.code() }
}
impl Hash for IoError {
    fn hash(&self) -> u64 { self.code().hash() }
}

impl Display for FileKind {
    fn str(&self) -> string {
        match self {
            .Other => "Other",
            .File => "File",
            .Directory => "Directory",
            .Symlink => "Symlink",
        }
    }
}
impl Eq for FileKind {
    fn eq(&self, other: &Self) -> bool { self == other }
}
impl Hash for FileKind {
    fn hash(&self) -> u64 {
        v := match self { .Other => 0, .File => 1, .Directory => 2, .Symlink => 3 }
        v.hash()
    }
}

impl Eq for Status {
    fn eq(&self, other: &Self) -> bool { self.ok == other.ok && self.error == other.error }
}
