pub fn bytes_equal(lhs: &[]u8, rhs: &[]u8) -> bool { __sys_bytes_equal(&lhs, &rhs) }
pub fn bytes_extend(output: &mut []u8, input: &[]u8, start: i32, end: i32) { __sys_bytes_extend(&mut output, &input, start, end) }
pub fn bytes_append_text(output: &mut []u8, text: string) { __sys_bytes_append_text(&mut output, text) }
@thread_safe
pub unsafe fn fd_read(fd: i32, out: &mut []u8, max_bytes: i64) -> i64 {
    if target_is("windows") { return win_read_chunk(fd, &mut out, max_bytes) }
    __sys_net_read(fd, &mut out, max_bytes)
}
@thread_safe
pub unsafe fn fd_write(fd: i32, data: &[]u8, offset: i64, length: i64) -> i64 {
    mut n := __sys_fd_write(fd, &data, offset, length)
    if target_is("windows") {
        while n == -1 {
            error := winfs.crt_error()
            if error != 4 { return -i64(error) }
            n = __sys_fd_write(fd, &data, offset, length)
        }
    }
    n
}
@thread_safe
pub unsafe fn fd_close(fd: i32) -> i64 {
    if target_is("windows") { return i64(winfs.close(fd)) }
    __sys_net_close(fd)
}
@thread_safe
pub unsafe fn fd_poll(fds: &mut []u8, nfds: i64, timeout_ms: i64) -> i64 {
    if target_is("windows") { return winpipe.poll(&mut fds, nfds, timeout_ms) }
    else { return __sys_net_poll(&mut fds, nfds, timeout_ms) }
}
@thread_safe
pub unsafe fn fd_set_nonblocking(fd: i32, enabled: bool) -> i64 {
    if target_is("windows") { return winpipe.nonblocking(fd, enabled) }
    else { return __sys_net_set_nonblocking(fd, enabled) }
}
