@c_layout struct FileInfo {
    attrs: u32, created_low: u32, created_high: u32, access_low: u32, access_high: u32,
    modified_low: u32, modified_high: u32, volume: u32, size_high: u32, size_low: u32,
    links: u32, index_high: u32, index_low: u32,
}
@c_layout struct FindData {
    attrs: u32, created_low: u32, created_high: u32, access_low: u32, access_high: u32,
    modified_low: u32, modified_high: u32, size_high: u32, size_low: u32, reserved1: u32, reserved2: u32,
    name: [u16; 260], short_name: [u16; 14],
}
pub struct Info {
    error: i32, size: i64, directory: bool, link: bool, mode: u32, dev: u64, ino: u64, nlink: u64, mtime: i64,
}

fn failed(error: i32) -> Info {
    Info { error: error, size: 0, directory: false, link: false, mode: 0, dev: 0, ino: 0, nlink: 0, mtime: 0 }
}
fn invalid(handle: ptr) -> bool { unsafe { return usize(handle) == usize(0).wrapping_sub(usize(1)) } }
fn pair(high: u32, low: u32) -> u64 { u64(high).shl(32).bit_or(u64(low)) }

fn portable_error(code: u32) -> i32 {
    if code == 2 || code == 3 || code == 18 { return 2 }
    if code == 5 || code == 32 || code == 33 || code == 1314 { return 13 }
    if code == 6 { return 9 }
    if code == 8 || code == 14 { return 12 }
    if code == 80 || code == 183 { return 17 }
    if code == 87 || code == 123 { return 22 }
    if code == 109 { return 32 }
    if code == 112 { return 28 }
    if code == 145 { return 66 }
    if code == 206 { return 63 }
    if code == 267 { return 20 }
    5
}
unsafe fn error() -> i32 { portable_error(last_error()) }
@test {
    (0) -> 5
    (9) -> 9
    (11) -> 35
    (36) -> 11
    (38) -> 63
    (41) -> 66
    (42) -> 92
    (140) -> 35
}
fn portable_crt_error(e: i32) -> i32 {
    if e == 11 || e == 140 { return 35 }
    if e == 36 { return 11 }
    if e == 38 { return 63 }
    if e == 41 { return 66 }
    if e == 42 { return 92 }
    if e <= 0 { return 5 }
    e
}
@thread_safe
pub unsafe fn crt_error() -> i32 { portable_crt_error(load_i32(crt_errno())) }
unsafe fn status(ok: i32) -> i32 { if ok != 0 { return 0 }; error() }
unsafe fn handle_info(handle: ptr) -> Info {
    mut buf: FileInfo = zeroed()
    if file_information(handle, addr(&mut buf)) == 0 { return failed(error()) }
    dir := buf.attrs.bit_and(u32(16)) != u32(0)
    link := buf.attrs.bit_and(u32(1024)) != u32(0)
    mut mode := if dir { u32(16877) } else { u32(33206) }
    if link { mode = u32(41471) }
    if buf.attrs.bit_and(u32(1)) != u32(0) { mode = mode.bit_and(u32(4294967149)) }
    size := pair(buf.size_high, buf.size_low)
    if size > u64(9223372036854775807) { return failed(27) }
    Info { error: 0, size: i64(size), directory: dir, link: link, mode: mode, dev: u64(buf.volume),
        ino: pair(buf.index_high, buf.index_low), nlink: u64(buf.links),
        mtime: i64(pair(buf.modified_high, buf.modified_low) / u64(10000000)) - 11644473600 }
}
unsafe fn inspect(path: string, follow: bool) -> (ptr, i32) {
    raw := win.path(path)
    if raw.len <= 1 { return (ptr(0), 22) }
    flags := if follow { u32(33554432) } else { u32(35651584) }
    h := create_file(addr(&raw[0]), u32(128), u32(7), ptr(0), u32(3), flags, ptr(0))
    if invalid(h) { return (ptr(0), error()) }
    (h, 0)
}
@requires(filesystem) @thread_safe
pub fn stat(path: string, follow: bool) -> Info {
    unsafe {
        (h, e) := inspect(path, follow)
        if e != 0 { return failed(e) }
        out := handle_info(h)
        _ := close_handle(h)
        return out
    }
}
@requires(filesystem) @thread_safe
pub fn fstat(fd: i32) -> Info {
    unsafe {
        if fd < 0 { return failed(9) }
        h := to_handle(fd)
        if invalid(h) { return failed(9) }
        return handle_info(h)
    }
}
@requires(filesystem) @thread_safe
pub fn open(path: string, read: bool, write: bool, create: bool, truncate: bool, append: bool, exclusive: bool, nofollow: bool) -> i32 {
    raw := win.path(path)
    if raw.len <= 1 || (!read && !write) || (truncate && !write) { return -22 }
    mut access := u32(0)
    if read { access = u32(2147483648) }
    if append && !truncate { access = access.bit_or(u32(4)) } else if write { access = access.bit_or(u32(1073741824)) }
    mut how := u32(3)
    if exclusive { how = u32(1) } else if create && truncate { how = u32(2) }
    else if create { how = u32(4) } else if truncate { how = u32(5) }
    mut flags := u32(128)
    if nofollow {
        flags = flags.bit_or(u32(2097152))
        if truncate && !exclusive { how = if create { u32(4) } else { u32(3) } }
    }
    unsafe {
        h := create_file(addr(&raw[0]), access, u32(7), ptr(0), how, flags, ptr(0))
        if invalid(h) { return -error() }
        if nofollow {
            info := handle_info(h)
            if info.error != 0 || info.link {
                _ := close_handle(h)
                if info.link { return -62 }
                return -info.error
            }
            if truncate && !exclusive && truncate_file(h) == 0 {
                e := error(); _ := close_handle(h); return -e
            }
        }
        mut fd_flags := 32768
        if append { fd_flags += 8 }
        if read && write { fd_flags += 2 } else if write { fd_flags += 1 }
        fd := to_fd(h, fd_flags)
        if fd < 0 { e := crt_error(); _ := close_handle(h); return -e }
        return fd
    }
}
@thread_safe
pub unsafe fn close(fd: i32) -> i32 { if fd < 0 { return -9 }; if close_fd(fd) != 0 { return -crt_error() }; 0 }
@thread_safe
pub unsafe fn read(fd: i32, data: ptr, count: i32) -> i32 {
    if fd < 0 { return -9 }
    if fd <= 2 && set_mode(fd, 32768) < 0 { return -crt_error() }
    n := read_fd(fd, data, u32(count))
    if n < 0 { return -crt_error() }; n
}
@thread_safe
pub unsafe fn write(fd: i32, data: ptr, count: i32) -> i32 {
    if fd < 0 { return -9 }
    if fd <= 2 && set_mode(fd, 32768) < 0 { return -crt_error() }
    n := write_fd(fd, data, u32(count))
    if n < 0 { return -crt_error() }; n
}
@thread_safe
pub unsafe fn seek(fd: i32, offset: i64, whence: i32) -> i64 {
    if fd < 0 { return -9 }
    n := seek_fd(fd, offset, whence)
    if n < 0 { return -i64(crt_error()) }; n
}
@thread_safe
pub unsafe fn flush(fd: i32) -> i32 { if fd < 0 { return -9 }; if flush_fd(fd) != 0 { return -crt_error() }; 0 }

pub enum Change { CreateDir, Delete, RemoveDir }
@requires(filesystem) @thread_safe
pub fn change(path: string, op: Change) -> i32 {
    raw := win.path(path)
    if raw.len <= 1 { return 22 }
    unsafe {
        p := addr(&raw[0])
        if op == .CreateDir { return status(create_dir(p, ptr(0))) }
        if op == .RemoveDir { return status(remove_directory(p)) }
        return status(delete_file(p))
    }
}
@requires(filesystem) @thread_safe
pub fn rename(source: string, dest: string, link: bool) -> i32 {
    a := win.path(source); b := win.path(dest)
    if a.len <= 1 || b.len <= 1 { return 22 }
    unsafe {
        if link { return status(hard_link(addr(&b[0]), addr(&a[0]), ptr(0))) }
        return status(move_file(addr(&a[0]), addr(&b[0]), u32(9)))
    }
}

fn normal(path: string) -> string {
    mut first := 0
    mut out := ""
    if path.len >= 8 && path[0..8] == "\\\\?\\UNC\\" { first = 8; out = "//" }
    else if path.len >= 4 && path[0..4] == "\\\\?\\" { first = 4 }
    for i in first..path.len {
        if path[i] == 92 { out = out + path[first..i] + "/"; first = i + 1 }
    }
    out + path[first..path.len]
}

enum PathQuery { Current, Temp, Final }
unsafe fn query(which: PathQuery, handle: ptr) -> (string, i32) {
    mut buf: [u16; 32768] = [0; 32768]
    p := addr(&mut buf[0])
    mut n := u32(0)
    if which == .Current { n = current_dir(u32(32768), p) }
    else if which == .Temp { n = temp_path(u32(32768), p) }
    else { n = final_path(handle, p, u32(32768), u32(0)) }
    if n == u32(0) { return ("", error()) }
    if n >= u32(32768) { return ("", 63) }
    decoded := win.text(p, i32(n))
    if decoded == "" { return ("", 84) }
    (normal(decoded), 0)
}
@requires(filesystem) @thread_safe
pub fn cwd() -> (string, i32) { unsafe { return query(.Current, ptr(0)) } }
@requires(filesystem) @thread_safe
pub fn temp() -> (string, i32) { unsafe { return query(.Temp, ptr(0)) } }
@requires(filesystem) @thread_safe
pub fn realpath(path: string) -> (string, i32) {
    unsafe {
        (h, e) := inspect(path, true)
        if e != 0 { return ("", e) }
        result := query(.Final, h)
        _ := close_handle(h)
        return result
    }
}
@requires(filesystem) @thread_safe
pub fn list(path: string) -> ([]string, i32) {
    mut names: []string = []
    if path.len == 0 { return (names, 22) }
    slash := if path[path.len - 1] == 47 || path[path.len - 1] == 92 { "" } else { "/" }
    raw := win.path(path + slash + "*")
    if raw.len == 0 { return (names, 22) }
    unsafe {
        mut row: FindData = zeroed()
        h := find_first(addr(&raw[0]), addr(&mut row))
        if invalid(h) {
            e := error()
            if e == 2 {
                info := stat(path, true)
                if info.error == 0 && info.directory { return (names, 0) }
            }
            return (names, e)
        }
        defer { _ := find_close(h) }
        while true {
            mut n := 0
            while n < 260 && row.name[n] != u16(0) { n += 1 }
            if n > 0 {
                name := win.text(addr(&row.name[0]), n)
                if name == "" { return (names, 84) }
                if name != "." && name != ".." { names.push(move name) }
            }
            if find_next(h, addr(&mut row)) == 0 {
                last := last_error()
                if last != u32(18) { return (names, portable_error(last)) }
                break
            }
        }
    }
    (names, 0)
}

@extern("kernel32.dll", "CreateSymbolicLinkW") @thread_safe
unsafe fn create_link(link: ptr, target: ptr, flags: u32) -> u8
@requires(filesystem) @thread_safe
pub fn symlink(target: string, dest: string, directory: bool) -> i32 {
    a := win.path(target); b := win.path(dest)
    if a.len <= 1 || b.len <= 1 { return 22 }
    flags := if directory { u32(1) } else { u32(0) }
    unsafe {
        if create_link(addr(&b[0]), addr(&a[0]), flags.bit_or(u32(2))) != u8(0) { return 0 }
        last := last_error()
        if last != u32(87) { return portable_error(last) }
        return status(i32(create_link(addr(&b[0]), addr(&a[0]), flags)))
    }
}
pub fn temp_token(attempt: i32) -> u64 {
    u64(base.now_ms()).shl(16).bit_xor(u64(base.pid()).shl(32)).bit_xor(u64(attempt))
}
