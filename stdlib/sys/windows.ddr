capability unsafe

import std.sys.winpath as winpath

@extern("kernel32.dll", "WideCharToMultiByte")
@thread_safe
unsafe fn to_utf8(page: u32, flags: u32, input: ptr, units: i32, output: ptr, capacity: i32, default_char: ptr, used_default: ptr) -> i32

pub fn path(value: string) -> []u16 { winpath.path(value) }

pub unsafe fn text(data: ptr, count: i32) -> string {
    if count <= 0 { return "" }
    length := to_utf8(u32(65001), u32(128), data, count, ptr(0), 0, ptr(0), ptr(0))
    if length <= 0 { return "" }
    mut bytes: []u8 = []
    bytes.reserve(length)
    for _ in 0..length { bytes.push(0) }
    if to_utf8(u32(65001), u32(128), data, count, addr(&mut bytes[0]), length, ptr(0), ptr(0)) != length { return "" }
    __sys_copy_valid_utf8(&bytes)
}
