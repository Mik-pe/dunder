capability unsafe

import std.sys.winpath as winpath
import std.sys.winutf8 as winutf8

pub fn path(value: string) -> []u16 { winpath.path(value) }

pub unsafe fn text(data: ptr, count: i32) -> string {
    encoded := winutf8.bytes(data, count)
    if encoded.len == 0 { return "" }
    __sys_copy_valid_utf8(&encoded)
}
