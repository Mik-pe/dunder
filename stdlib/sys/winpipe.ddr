capability unsafe

@extern("c", "_get_osfhandle") @thread_safe unsafe fn handle(fd: i32) -> i64
@extern("kernel32", "GetFileType") @thread_safe unsafe fn file_type(h: ptr) -> u32
@extern("kernel32", "GetLastError") @thread_safe unsafe fn last_error() -> u32
@extern("kernel32", "GetTickCount64") @thread_safe unsafe fn ticks() -> i64
@extern("kernel32", "Sleep") @thread_safe unsafe fn sleep(ms: u32)
@extern("kernel32", "WaitForSingleObject") @thread_safe unsafe fn wait(h: ptr, timeout: u32) -> u32
@extern("kernel32", "PeekNamedPipe") @thread_safe unsafe fn peek(h: ptr, data: ptr, n: u32, read: ptr, avail: ptr, left: ptr) -> i32
@extern("kernel32", "SetNamedPipeHandleState") @thread_safe unsafe fn set_state(h: ptr, mode: ptr, count: ptr, timeout: ptr) -> i32

@thread_safe
pub unsafe fn nonblocking(fd: i32, enabled: bool) -> i64 {
    if fd < 0 { return -9 }
    raw := handle(fd)
    if raw == -1 { return -9 }
    h := ptr(usize(raw))
    if file_type(h) != 3 { return if enabled { -45 } else { 0 } }
    mut mode := if enabled { u32(1) } else { u32(0) }
    if set_state(h, addr(&mut mode), ptr(0), ptr(0)) != 0 { return 0 }
    -45
}

@thread_safe
unsafe fn ready(fd: i32, events: u16) -> u16 {
    if fd < 0 { return 0 }
    raw := handle(fd)
    if raw == -1 { return 32 }
    h := ptr(usize(raw)); kind := file_type(h)
    if kind == 0 { return 32 }
    mut result := events.bit_and(4)
    if events.bit_and(1) == 0 { return result }
    if kind == 3 {
        mut count := u32(0)
        if peek(h, ptr(0), 0, ptr(0), addr(&mut count), ptr(0)) == 0 {
            if last_error() == 109 || last_error() == 232 { return result.bit_or(16) }
            return result.bit_or(8)
        }
        if count > 0 { result = result.bit_or(1) }
    } else if kind == 1 || wait(h, 0) == 0 { result = result.bit_or(1) }
    result
}

@thread_safe
pub unsafe fn poll(fds: &mut []u8, nfds: i64, timeout: i64) -> i64 {
    if nfds < 0 || nfds > i64(fds.len / 8) { return -22 }
    start := ticks()
    while true {
        mut count := 0
        for i in 0..i32(nfds) {
            at := i * 8
            raw := addr(&mut fds[at])
            revents := ready(i32(load_u32(raw)), load_u16(ptr(usize(raw) + 4)))
            store_u16(ptr(usize(raw) + 6), revents)
            if revents != 0 { count += 1 }
        }
        if count > 0 || timeout == 0 || (timeout > 0 && ticks() - start >= timeout) { return i64(count) }
        sleep(1)
    }
    -5
}
