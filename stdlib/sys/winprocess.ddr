pub struct Spawn {
    pid: i32, process: ptr, job: ptr, input: i32, output: i32, error_output: i32, error: i32,
}

pub struct Streams { input: i32, output: i32, error_output: i32, output_path: string }

unsafe fn error_code() -> i32 {
    raw := last_error()
    if raw == 2 || raw == 3 { return 2 }
    if raw == 5 || raw == 32 { return 13 }
    if raw == 6 { return 9 }
    if raw == 8 || raw == 14 { return 12 }
    if raw == 87 || raw == 123 { return 22 }
    if raw == 109 || raw == 232 { return 32 }
    if raw == 193 { return 8 }
    5
}

pub fn command_line(argv0: string, args: &[]string, encode: fn(string) -> []u16) -> []u16 {
    first := encode(argv0)
    if first.len < 2 { return [] }
    mut line: []u16 = [34]
    for i in 0..first.len - 1 {
        if first[i] == 34 { return [] }
        line.push(first[i])
    }
    line.push(34)
    for arg in &args {
        value := encode(arg)
        if value.len == 0 { return [] }
        line.push(32); line.push(34)
        mut slashes := 0
        for i in 0..value.len - 1 {
            unit := value[i]
            if unit == 92 { slashes += 1; continue }
            if unit == 34 { slashes = slashes * 2 + 1 }
            for _ in 0..slashes { line.push(92) }
            slashes = 0
            line.push(unit)
        }
        for _ in 0..slashes * 2 { line.push(92) }
        line.push(34)
        if line.len >= 32767 { return [] }
    }
    if line.len >= 32767 { return [] }
    line.push(0)
    line
}

fn env_key(entry: &[]u16) -> i32 {
    for i in 1..entry.len { if entry[i] == 61 { return i } }
    entry.len - 1
}

unsafe fn insert_entry(entries: &mut [][]u16, move value: []u16, key_len: i32, remove: bool) {
    mut pos := 0
    while pos < entries.len {
        existing := &entries[pos]
        order := compare(addr(&existing[0]), env_key(&existing), addr(&value[0]), key_len, 1)
        if order == 2 {
            if remove { _ := entries.remove(pos) } else { entries[pos] = move value }
            return
        }
        if order == 3 { break }
        pos += 1
    }
    if remove { return }
    entries.push(move value)
    mut i := entries.len - 1
    while i > pos { entries.swap(i - 1, i); i -= 1 }
}

pub unsafe fn environment(keys: &[]string, vals: &[]string, unset: &[]bool, inherit: bool, encode: fn(string) -> []u16) -> []u16 {
    if keys.len != vals.len || vals.len != unset.len { return [0] }
    if keys.len == 0 && inherit { return [] }
    mut entries: [][]u16 = []
    if inherit {
        block := get_environment()
        if usize(block) == 0 { return [0] }
        mut offset := usize(0)
        while load_u16(ptr(usize(block) + offset)) != 0 {
            mut entry: []u16 = []
            while true {
                unit := load_u16(ptr(usize(block) + offset)); offset += 2
                entry.push(unit)
                if unit == 0 { break }
            }
            key_len := env_key(&entry)
            insert_entry(&mut entries, move entry, key_len, false)
        }
        _ := release_environment(block)
    }
    for i in 0..keys.len {
        mut entry := encode(keys[i])
        if entry.len < 2 { return [0] }
        key_len := entry.len - 1
        for j in 0..key_len { if entry[j] == 61 { return [0] } }
        _ := entry.pop(); entry.push(61)
        value := encode(vals[i])
        if value.len == 0 { return [0] }
        for v in &value { entry.push(v) }
        insert_entry(&mut entries, move entry, key_len, unset[i])
    }
    mut out: []u16 = []
    for entry in &entries { for unit in &entry { out.push(unit) } }
    if out.len == 0 { out.push(0) }
    out.push(0)
    out
}

unsafe fn valid(handle: ptr) -> bool { usize(handle) != 0 && i64(usize(handle)) != -1 }
pub unsafe fn close(handle: ptr) { if valid(handle) { _ := close_handle(handle) } }

unsafe fn owned_copy(handle: ptr) -> ptr {
    mut copy := ptr(0)
    current := current_process()
    if duplicate(current, handle, current, addr(&mut copy), 0, 1, 2) == 0 { return ptr(0) }
    copy
}

unsafe fn stream(mode: i32, index: i32, file: &[]u16, child: &mut ptr, parent: &mut i32) -> bool {
    mut raw := ptr(0)
    if mode == 0 {
        raw = std_handle(-10 - index)
        if valid(raw) { child = owned_copy(raw); return valid(child) }
    }
    if mode == 1 {
        mut reader := ptr(0); mut writer := ptr(0)
        if create_pipe(addr(&mut reader), addr(&mut writer), ptr(0), 65536) == 0 { return false }
        mut child_end := writer; mut parent_end := reader; mut fd_flags := 32768
        if index == 0 { child_end = reader; parent_end = writer; fd_flags += 1 }
        child = owned_copy(child_end); close(child_end)
        if !valid(child) { close(parent_end); return false }
        if index == 0 {
            mut nowait := u32(1)
            if set_state(parent_end, addr(&mut nowait), ptr(0), ptr(0)) == 0 { close(parent_end); return false }
        }
        parent = own_fd(i64(usize(parent_end)), fd_flags)
        if parent < 0 { close(parent_end); return false }
        return true
    }
    nul: [u16; 4] = [78, 85, 76, 0]
    mut name := addr(&nul[0]); mut disposition := u32(3)
    if mode == 3 { if file.len < 2 { return false }; name = addr(&file[0]); disposition = 2 }
    access := if index == 0 { u32(2147483648) } else { u32(1073741824) }
    raw = create_file(name, access, 3, ptr(0), disposition, 128, ptr(0))
    if !valid(raw) { return false }
    child = owned_copy(raw); close(raw)
    valid(child)
}

pub unsafe fn start(program: string, argv0: string, args: &[]string, cwd: string, env: &[]u16, streams: &Streams, search: bool, encode: fn(string) -> []u16) -> Spawn {
    mut result := Spawn { pid: -1, process: ptr(0), job: ptr(0), input: -1, output: -1, error_output: -1, error: 22 }
    mut full_program := program.clone()
    if !search && cwd != "" && program.len > 0 && program[0] != 47 && program[0] != 92 && (program.len < 2 || program[1] != 58) {
        full_program = cwd + "/" + program
    }
    program_w := encode(full_program); mut command := command_line(argv0, &args, encode)
    directory := encode(cwd); file := encode(streams.output_path)
    if program_w.len < 2 || command.len == 0 || directory.len == 0 || file.len == 0 || env.len == 1 { return result }
    mut application := addr(&program_w[0])
    mut resolved: []u16 = []
    if search {
        mut search_dirs := ptr(0)
        if env.len > 0 {
            path_key: [u16; 4] = [80, 65, 84, 72]
            mut begin := 0
            while begin < env.len && env[begin] != 0 {
                mut end := begin
                while end < env.len && env[end] != 0 { end += 1 }
                if end - begin > 5 && env[begin + 4] == 61 && compare(addr(&env[begin]), 4, addr(&path_key[0]), 4, 1) == 2 {
                    search_dirs = addr(&env[begin + 5]); break
                }
                begin = end + 1
            }
            if usize(search_dirs) == 0 { result.error = 2; return result }
        }
        extension: [u16; 5] = [46, 101, 120, 101, 0]
        needed := search_file(search_dirs, application, addr(&extension[0]), 0, ptr(0), ptr(0))
        if needed == 0 || needed > 32767 { result.error = error_code(); return result }
        resolved.reserve(i32(needed)); for _ in 0..i32(needed) { resolved.push(0) }
        count := search_file(search_dirs, application, addr(&extension[0]), needed, addr(&mut resolved[0]), ptr(0))
        if count == 0 || count >= needed { result.error = error_code(); return result }
        application = addr(&resolved[0])
    }
    mut directory_ptr := ptr(0); if directory.len > 1 { directory_ptr = addr(&directory[0]) }
    mut env_ptr := ptr(0); if env.len > 0 { env_ptr = addr(&env[0]) }
    mut child: [ptr; 3] = [ptr(0); 3]
    mut parents: [i32; 3] = [-1; 3]
    defer {
        for i in 0..3 { close(child[i]); if parents[i] >= 0 { _ := close_fd(parents[i]) } }
    }
    modes: [i32; 3] = [streams.input, streams.output, streams.error_output]
    for i in 0..3 {
        if i == 2 && modes[i] == 4 { child[i] = owned_copy(child[1]); if !valid(child[i]) { result.error = error_code(); return result } }
        else if !stream(modes[i], i, &file, &mut child[i], &mut parents[i]) { result.error = error_code(); return result }
    }
    mut size := usize(0)
    _ := init_attributes(ptr(0), 1, 0, addr(&mut size))
    if size == 0 { result.error = error_code(); return result }
    heap := get_heap()
    storage := heap_alloc(heap, 0, size)
    if usize(storage) == 0 { result.error = 12; return result }
    defer { _ := heap_free(heap, 0, storage) }
    if init_attributes(storage, 1, 0, addr(&mut size)) == 0 { result.error = error_code(); return result }
    defer { delete_attributes(storage) }
    if set_attribute(storage, 0, usize(131074), addr(&child[0]), usize(24), ptr(0), ptr(0)) == 0 { result.error = error_code(); return result }
    mut startup: [u64; 14] = [0; 14]
    startup[0] = 112
    store_u32(ptr(usize(addr(&mut startup[0])) + 60), u32(256))
    for i in 0..3 { startup[10 + i] = u64(usize(child[i])) }
    startup[13] = u64(usize(storage))
    mut info: [u64; 3] = [0; 3]
    job := create_job(ptr(0), ptr(0))
    if !valid(job) { result.error = error_code(); return result }
    if create_process(application, addr(&mut command[0]), ptr(0), ptr(0), 1, u32(525316), env_ptr, directory_ptr, addr(&mut startup[0]), addr(&mut info[0])) == 0 {
        result.error = error_code(); close(job); return result
    }
    proc := ptr(usize(info[0])); thread := ptr(usize(info[1]))
    defer { close(thread) }
    if assign_job(job, proc) == 0 || resume_thread(thread) == u32(4294967295) {
        result.error = error_code(); _ := terminate_process(proc, 126); _ := wait_object(proc, u32(4294967295))
        close(proc); close(job); return result
    }
    result.pid = i32(info[2]); result.process = proc; result.job = job
    result.input = parents[0]; result.output = parents[1]; result.error_output = parents[2]; result.error = 0
    for i in 0..3 { parents[i] = -1 }
    result
}

pub unsafe fn wait(process: ptr, timeout: i64, code: &mut i32) -> i32 {
    millis := if timeout < 0 { u32(4294967295) } else if timeout > 4294967294 { u32(4294967294) } else { u32(timeout) }
    status := wait_object(process, millis)
    if status == 258 { return 0 }
    if status != 0 || exit_code(process, addr(&mut code)) == 0 { return -1 }
    1
}

pub unsafe fn kill(job: ptr, status: i32) -> bool { terminate_job(job, u32(status)) != 0 }

pub unsafe fn available(fd: i32) -> i64 {
    mut count := u32(0)
    if peek_pipe(ptr(usize(fd_handle(fd))), ptr(0), 0, ptr(0), addr(&mut count), ptr(0)) != 0 { return i64(count) }
    if last_error() == 109 { return -1 }
    -i64(error_code()) - 1
}

pub unsafe fn read(fd: i32, data: ptr, count: i32) -> i64 {
    available_bytes := available(fd)
    if available_bytes <= 0 { return if available_bytes == 0 { -35 } else { available_bytes + 1 } }
    n := if available_bytes < i64(count) { u32(available_bytes) } else { u32(count) }
    mut got := u32(0)
    if read_file(ptr(usize(fd_handle(fd))), data, n, addr(&mut got), ptr(0)) == 0 { return -i64(error_code()) }
    i64(got)
}

pub unsafe fn write(fd: i32, data: ptr, count: usize) -> i64 {
    n := if count > 65536 { u32(65536) } else { u32(count) }
    mut done := u32(0)
    if write_file(ptr(usize(fd_handle(fd))), data, n, addr(&mut done), ptr(0)) == 0 { return -i64(error_code()) }
    if done == 0 && n > 0 { return -35 }
    i64(done)
}

pub unsafe fn lock_file(name: &[]u16, timeout_ms: i64) -> i32 {
    if name.len < 2 { return -1 }
    start := ticks()
    while true {
        h := create_file(addr(&name[0]), u32(3221225472), 0, ptr(0), 3, 128, ptr(0))
        if valid(h) {
            fd := own_fd(i64(usize(h)), 32770)
            if fd < 0 { close(h) }
            return fd
        }
        if last_error() != 32 || timeout_ms <= 0 || ticks() - start >= timeout_ms { break }
        sleep(10)
    }
    -1
}
