import std.utf16 as utf16

pub fn path(value: string) -> []u16 { utf16.terminated(value) }

@test fn windows_paths_preserve_scalars_and_reject_embedded_zeroes() {
    units := path("Ö🌍")
    assert(units.len == 4 && units[0] == 214 && units[1] == 55356 && units[2] == 57101 && units[3] == 0)
    empty := path("")
    assert(empty.len == 1 && empty[0] == 0)
    assert(path("a\0b").len == 0)
}
