pub fn path(value: string) -> []u16 {
    mut units: []u16 = []
    for scalar in value.runes() {
        code := i32(scalar)
        if code == 0 { return [] }
        if code < 65536 { units.push(u16(code)) }
        else {
            pair := code - 65536
            units.push(u16(55296 + pair.shr(10)))
            units.push(u16(56320 + pair.bit_and(1023)))
        }
    }
    units.push(u16(0))
    units
}

@test fn windows_paths_preserve_scalars_and_reject_embedded_zeroes() {
    units := path("Ö🌍")
    assert(units.len == 4 && units[0] == 214 && units[1] == 55356 && units[2] == 57101 && units[3] == 0)
    empty := path("")
    assert(empty.len == 1 && empty[0] == 0)
    assert(path("a\0b").len == 0)
}
