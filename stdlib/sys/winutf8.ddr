capability unsafe

@extern("kernel32.dll", "WideCharToMultiByte")
@thread_safe
unsafe fn to_utf8(page: u32, flags: u32, input: ptr, units: i32, output: ptr, capacity: i32, default_char: ptr, used_default: ptr) -> i32

pub unsafe fn bytes(data: ptr, count: i32) -> []u8 {
    if count <= 0 { return [] }
    length := to_utf8(u32(65001), u32(128), data, count, ptr(0), 0, ptr(0), ptr(0))
    if length <= 0 { return [] }
    mut result: []u8 = []
    result.reserve(length)
    for _ in 0..length { result.push(0) }
    if to_utf8(u32(65001), u32(128), data, count, addr(&mut result[0]), length, ptr(0), ptr(0)) != length { return [] }
    result
}
