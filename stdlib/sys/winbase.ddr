capability unsafe

@link("kernel32")
extern "system" {
    @link_name("GetTickCount64") @thread_safe
    fn elapsed() -> u64
    @link_name("GetCurrentProcessId") @thread_safe
    fn process_id() -> u32
    @link_name("Sleep") @thread_safe
    fn pause(millis: u32)
}

@thread_safe
pub fn now_ms() -> i64 { unsafe { return i64(elapsed()) }; 0 }
@thread_safe
pub fn pid() -> i32 { unsafe { return i32(process_id()) }; 0 }
@thread_safe
pub fn sleep_ms(millis: i64) {
    mut remaining := millis
    while remaining > 0 {
        part := if remaining > 4294967294 { i64(4294967294) } else { remaining }
        unsafe { pause(u32(part)) }
        remaining -= part
    }
}
