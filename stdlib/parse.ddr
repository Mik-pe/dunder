pub struct Integer { ok: bool, value: i64, error: i32 }
pub struct Unsigned { ok: bool, value: u64, error: i32 }

fn radix_digit(byte: i32, radix: i32) -> i32 {
    if byte >= 48 && byte <= 57 {
        d := byte - 48
        if d < radix { return d }
        return -1
    }
    if radix == 16 {
        if byte >= 65 && byte <= 70 { return byte - 55 }
        if byte >= 97 && byte <= 102 { return byte - 87 }
    }
    -1
}

fn parse_signed_range(text: string, start: i32, end: i32, radix: i32) -> Integer {
    if start < 0 || end < start || end > text.len || start == end { return Integer { ok: false, value: 0, error: 1 } }
    var cursor := start
    var negative := false
    if text[cursor] == 45 || text[cursor] == 43 { negative = text[cursor] == 45; cursor = cursor + 1 }
    if cursor == end { return Integer { ok: false, value: 0, error: 1 } }
    var limit: i64 = -9223372036854775807
    if negative { limit = -9223372036854775808 }
    var value: i64 = 0
    while cursor < end {
        d := radix_digit(text[cursor], radix)
        if d < 0 { return Integer { ok: false, value: 0, error: 1 } }
        if value < limit / i64(radix) { return Integer { ok: false, value: 0, error: 2 } }
        value = value * i64(radix)
        if value < limit + i64(d) { return Integer { ok: false, value: 0, error: 2 } }
        value = value - i64(d)
        cursor = cursor + 1
    }
    if !negative { value = -value }
    Integer { ok: true, value: value, error: 0 }
}

fn parse_unsigned_range(text: string, start: i32, end: i32, radix: i32) -> Unsigned {
    if start < 0 || end < start || end > text.len || start == end { return Unsigned { ok: false, value: 0, error: 1 } }
    var max_div: u64 = 1844674407370955161
    var max_rem := 5
    if radix == 16 { max_div = 1152921504606846975; max_rem = 15 }
    var value: u64 = 0
    for i in start..end {
        d := radix_digit(text[i], radix)
        if d < 0 { return Unsigned { ok: false, value: 0, error: 1 } }
        if value > max_div || (value == max_div && d > max_rem) {
            return Unsigned { ok: false, value: 0, error: 2 }
        }
        value = value * u64(radix) + u64(d)
    }
    Unsigned { ok: true, value: value, error: 0 }
}

// error: 1=invalid spelling, 2=overflow. Strict ASCII decimal, optional sign.
pub fn integer(text: string) -> Integer {
    if text.len == 0 { return Integer { ok: false, value: 0, error: 1 } }
    var cursor := 0
    var negative := false
    if text[0] == 45 || text[0] == 43 { negative = text[0] == 45; cursor = 1 }
    if cursor == text.len { return Integer { ok: false, value: 0, error: 1 } }
    var limit: i64 = -9223372036854775807
    if negative { limit = -9223372036854775808 }
    var value: i64 = 0
    var previous_digit := false
    while cursor < text.len {
        byte := text[cursor]
        if byte == 95 {
            if !previous_digit || cursor + 1 == text.len || text[cursor + 1] < 48 || text[cursor + 1] > 57 { return Integer { ok: false, value: 0, error: 1 } }
            previous_digit = false
        } else {
            if byte < 48 || byte > 57 { return Integer { ok: false, value: 0, error: 1 } }
            if value < limit / 10 { return Integer { ok: false, value: 0, error: 2 } }
            value = value * 10
            if value < limit + i64(byte - 48) { return Integer { ok: false, value: 0, error: 2 } }
            value = value - i64(byte - 48)
            previous_digit = true
        }
        cursor = cursor + 1
    }
    if !negative { value = -value }
    Integer { ok: true, value: value, error: 0 }
}
pub fn hex(text: string) -> Integer { parse_signed_range(text, 0, text.len, 16) }
pub fn i64_range(text: string, start: i32, end: i32) -> Integer { parse_signed_range(text, start, end, 10) }
pub fn u64_range(text: string, start: i32, end: i32) -> Unsigned { parse_unsigned_range(text, start, end, 10) }
pub fn hex_u64_range(text: string, start: i32, end: i32) -> Unsigned { parse_unsigned_range(text, start, end, 16) }

@test fn decimal_parser_covers_limits_separators_and_errors() {
    integer("42").value == 42
    integer("-9223372036854775808").value == -9223372036854775808
    integer("9223372036854775807").value == 9223372036854775807
    integer("42_000").value == 42000
    integer("+0").ok
    integer("9223372036854775808").error == 2
    integer("-9223372036854775809").error == 2
    !integer("1__2").ok
    !integer("1_").ok
    !integer(" 2").ok
    !integer("+").ok
    !integer("").ok
    hex("1a2B").value == 6699
    hex("-ff").value == -255
    !hex("1_2").ok
    i64_range("len:1024;", 4, 8).value == 1024
    u64_range("len:18446744073709551615;", 4, 24).value == 18446744073709551615
    u64_range("18446744073709551616", 0, 20).error == 2
    hex_u64_range("chunk=deadbeef;", 6, 14).value == 3735928559
}
