pub fn is_absolute(p: string) -> bool {
    p.len > 0 && p[0] == 47
}

fn trimmed_end(p: string) -> i32 {
    mut end := p.len
    while end > 1 && p[end - 1] == 47 { end -= 1 }
    end
}

pub fn join(base: string, child: string) -> string {
    if child.len == 0 { return base.clone() }
    if is_absolute(child) || base.len == 0 { return child.clone() }
    end := trimmed_end(base)
    if end == 1 && base[0] == 47 { return "/" + child }
    mut start := 0
    while start < child.len && child[start] == 47 { start += 1 }
    if start >= child.len { return base[0..end] }
    base[0..end] + "/" + child[start..child.len]
}

pub fn basename(p: string) -> string {
    if p.len == 0 { return "" }
    end := trimmed_end(p)
    if end == 1 && p[0] == 47 { return "/" }
    mut i := end - 1
    while i >= 0 {
        if p[i] == 47 { return p[(i + 1)..end] }
        i -= 1
    }
    p[0..end]
}

pub fn dirname(p: string) -> string {
    if p.len == 0 { return "." }
    end := trimmed_end(p)
    if end == 1 && p[0] == 47 { return "/" }
    mut i := end - 1
    while i >= 0 {
        if p[i] == 47 {
            mut slash := i
            while slash > 1 && p[slash - 1] == 47 { slash -= 1 }
            if slash == 0 { return "/" }
            return p[0..slash]
        }
        i -= 1
    }
    "."
}

pub fn extension(p: string) -> Option<string> {
    name := basename(p)
    if name == "" || name == "/" || name == "." || name == ".." { return .None }
    mut dot := -1
    mut i := name.len - 1
    while i > 0 {
        if name[i] == 46 { dot = i; break }
        i -= 1
    }
    if dot <= 0 || dot >= name.len - 1 { return .None }
    .Some(name[(dot + 1)..name.len])
}

pub fn stem(p: string) -> string {
    name := basename(p)
    if name == "" || name == "/" || name == "." || name == ".." { return name }
    mut dot := -1
    mut i := name.len - 1
    while i > 0 {
        if name[i] == 46 { dot = i; break }
        i -= 1
    }
    if dot <= 0 || dot >= name.len - 1 { return name }
    name[0..dot]
}

pub fn with_extension(p: string, ext: string) -> string {
    if p.len == 0 { return "" }
    name := basename(p)
    if name == "" || name == "/" { return p.clone() }
    end := trimmed_end(p)
    mut has_slash := false
    for i in 0..end {
        if p[i] == 47 { has_slash = true; break }
    }
    base_name := stem(name)
    mut clean := ext.clone()
    if clean.len > 0 && clean[0] == 46 { clean = clean[1..clean.len] }
    updated := if clean.len == 0 { base_name } else { base_name + "." + clean }
    if !has_slash { return updated }
    join(dirname(p), updated)
}

pub fn normalize(p: string) -> string {
    if p.len == 0 { return "" }
    abs := is_absolute(p)
    mut parts: []string = []
    mut i := 0
    while i < p.len {
        while i < p.len && p[i] == 47 { i += 1 }
        if i >= p.len { break }
        start := i
        while i < p.len && p[i] != 47 { i += 1 }
        seg := p[start..i]
        if seg == "." { continue }
        if seg == ".." {
            if parts.len > 0 && parts[parts.len - 1] != ".." {
                _ := parts.pop()
            } else if !abs {
                parts.push("..")
            }
            continue
        }
        parts.push(move seg)
    }
    if parts.len == 0 {
        if abs { return "/" }
        return "."
    }
    mut out := if abs { "/" } else { "" }
    for idx in 0..parts.len {
        if idx > 0 { out += "/" }
        out += parts[idx]
    }
    out
}

@test fn path_join_dirname_and_basename_cases() {
    assert(is_absolute("/usr/bin"))
    assert(!is_absolute("usr/bin"))
    assert(!is_absolute(""))

    assert(join("/usr", "local/bin") == "/usr/local/bin")
    assert(join("/usr/", "bin") == "/usr/bin")
    assert(join("/", "etc") == "/etc")
    assert(join("a/b", "") == "a/b")
    assert(join("", "a/b") == "a/b")
    assert(join("/a/b", "/c/d") == "/c/d")

    assert(dirname("/usr/lib") == "/usr")
    assert(dirname("/usr/") == "/")
    assert(dirname("/usr") == "/")
    assert(dirname("/") == "/")
    assert(dirname("usr") == ".")
    assert(dirname("") == ".")
    assert(dirname("a/b/c") == "a/b")
    assert(dirname("a/b/") == "a")

    assert(basename("/usr/lib") == "lib")
    assert(basename("/usr/") == "usr")
    assert(basename("/") == "/")
    assert(basename("usr") == "usr")
    assert(basename("") == "")
    assert(basename("a/b/c") == "c")
}

@test fn path_extension_stem_and_normalize_cases() {
    assert(extension("archive.tar.gz") == .Some("gz"))
    assert(extension("main.ddr") == .Some("ddr"))
    assert(extension("a.b/c") == .None)
    assert(extension(".gitignore") == .None)
    assert(extension("foo.") == .None)
    assert(extension("/") == .None)
    assert(extension("") == .None)

    assert(stem("archive.tar.gz") == "archive.tar")
    assert(stem("/dir/.bashrc") == ".bashrc")
    assert(stem("/dir/file.txt") == "file")
    assert(stem("plain") == "plain")

    assert(with_extension("foo.txt", "md") == "foo.md")
    assert(with_extension("foo.txt", ".md") == "foo.md")
    assert(with_extension("/tmp/foo.txt", "") == "/tmp/foo")
    assert(with_extension("sub/file", "ddr") == "sub/file.ddr")

    assert(normalize("/a/b/../c/./d/") == "/a/c/d")
    assert(normalize("/../..") == "/")
    assert(normalize("a/b/../../..") == "..")
    assert(normalize("./a//b/") == "a/b")
    assert(normalize("./.") == ".")
    assert(normalize("") == "")
}
