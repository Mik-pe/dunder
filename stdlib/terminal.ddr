capability unsafe, stdio
import sys

@extern("c", "tcgetattr") unsafe fn tcgetattr(fd: i32, state: ptr) -> i32
@extern("c", "tcsetattr") unsafe fn tcsetattr(fd: i32, action: i32, state: ptr) -> i32
@extern("c", "cfmakeraw") unsafe fn cfmakeraw(state: ptr)
@extern("c", "__error") unsafe fn errno_address() -> ptr
@c_variadic(2)
@extern("c", "ioctl") unsafe fn ioctl(fd: i32, request: usize, data: ptr) -> i32
@c_variadic(2)
@extern("c", "fcntl") unsafe fn fcntl(fd: i32, op: i32, arg: i32) -> i32
@extern("c", "close") unsafe fn close_fd(fd: i32) -> i32
@extern("kernel32", "GetStdHandle") unsafe fn std_handle(id: i32) -> ptr
@extern("kernel32", "GetCurrentProcess") unsafe fn current_process() -> ptr
@extern("kernel32", "DuplicateHandle") unsafe fn duplicate(from: ptr, handle: ptr, to: ptr, copy: ptr, access: u32, inherit: i32, flags: u32) -> i32
@extern("kernel32", "CloseHandle") unsafe fn close_handle(handle: ptr) -> i32
@extern("kernel32", "GetConsoleMode") unsafe fn get_mode(handle: ptr, state: ptr) -> i32
@extern("kernel32", "SetConsoleMode") unsafe fn set_mode(handle: ptr, state: u32) -> i32
@extern("kernel32", "GetConsoleScreenBufferInfo") unsafe fn screen_info(handle: ptr, info: ptr) -> i32

pub struct Size { columns: i32, rows: i32 }

@requires(stdio)
pub fn size() -> Result<Size, sys.IoError> {
    mut window: [u16; 4] = [0; 4]
    unsafe {
        if target_is("macos") {
            if ioctl(1, 0x40087468, addr(&mut window[0])) != 0 { return .Err(sys.IoError::from_code(load_i32(errno_address()))) }
        } else if target_is("linux") {
            status := sys.linux_syscall(29, 1, 0x5413, i64(usize(addr(&mut window[0]))), 0, 0, 0)
            if status < 0 { return .Err(sys.IoError::from_code(i32(-status))) }
        } else if target_is("windows") {
            mut info: [i16; 11] = [0; 11]
            if screen_info(std_handle(-11), addr(&mut info[0])) == 0 { return .Err(.BadDescriptor) }
            return .Ok(Size { columns: i32(info[7]) - i32(info[5]) + 1, rows: i32(info[8]) - i32(info[6]) + 1 })
        } else { return .Err(.Unsupported) }
    }
    .Ok(Size { columns: i32(window[1]), rows: i32(window[0]) })
}

@resource(dispose)
pub opaque struct RawMode { saved: [u64; 16], handle: i64, active: bool }

impl RawMode {
    @requires(stdio)
    pub fn enter() -> Result<Self, sys.IoError> {
        mut mode := Self { saved: [0; 16], handle: -1, active: false }
        unsafe {
            if target_is("windows") {
                current := current_process()
                mut handle := ptr(0)
                if duplicate(current, std_handle(-10), current, addr(&mut handle), 0, 0, 2) == 0 { return .Err(.BadDescriptor) }
                mode.handle = i64(usize(handle))
                if get_mode(handle, addr(&mut mode.saved[0])) == 0 ||
                    set_mode(handle, u32(mode.saved[0]).bit_and(u32(0x47).bit_not()).bit_or(0x80)) == 0 { return .Err(.BadDescriptor) }
            } else if target_is("macos") {
                fd := fcntl(0, 67, 3)
                if fd < 0 { return .Err(sys.IoError::from_code(load_i32(errno_address()))) }
                mode.handle = i64(fd)
                if tcgetattr(fd, addr(&mut mode.saved[0])) != 0 { return .Err(sys.IoError::from_code(load_i32(errno_address()))) }
                mut raw := mode.saved.clone()
                cfmakeraw(addr(&mut raw[0]))
                if tcsetattr(fd, 0, addr(&raw[0])) != 0 { return .Err(sys.IoError::from_code(load_i32(errno_address()))) }
            } else if target_is("linux") {
                mode.handle = sys.linux_syscall(25, 0, 1030, 3, 0, 0, 0)
                if mode.handle < 0 { return .Err(sys.IoError::from_code(i32(-mode.handle))) }
                got := sys.linux_syscall(29, mode.handle, 0x5401, i64(usize(addr(&mut mode.saved[0]))), 0, 0, 0)
                if got < 0 { return .Err(sys.IoError::from_code(i32(-got))) }
                mut raw := mode.saved.clone()
                p := usize(addr(&mut raw[0]))
                store_u32(ptr(p), load_u32(ptr(p)).bit_and(u32(0x5eb).bit_not()))
                store_u32(ptr(p + 4), load_u32(ptr(p + 4)).bit_and(u32(1).bit_not()))
                store_u32(ptr(p + 8), load_u32(ptr(p + 8)).bit_and(u32(0x130).bit_not()).bit_or(0x30))
                store_u32(ptr(p + 12), load_u32(ptr(p + 12)).bit_and(u32(0x804b).bit_not()))
                store_u8(ptr(p + 22), 0); store_u8(ptr(p + 23), 1)
                set := sys.linux_syscall(29, mode.handle, 0x5402, i64(p), 0, 0, 0)
                if set < 0 { return .Err(sys.IoError::from_code(i32(-set))) }
            } else { return .Err(.Unsupported) }
        }
        mode.active = true
        .Ok(move mode)
    }

    pub fn restore(&mut self) -> Result<(), sys.IoError> {
        if !self.active { return .Ok }
        unsafe {
            if target_is("windows") {
                if set_mode(ptr(usize(self.handle)), u32(self.saved[0])) == 0 { return .Err(.BadDescriptor) }
            } else if target_is("macos") {
                if tcsetattr(i32(self.handle), 0, addr(&self.saved[0])) != 0 { return .Err(sys.IoError::from_code(load_i32(errno_address()))) }
            } else if target_is("linux") {
                status := sys.linux_syscall(29, self.handle, 0x5402, i64(usize(addr(&self.saved[0]))), 0, 0, 0)
                if status < 0 { return .Err(sys.IoError::from_code(i32(-status))) }
            }
        }
        self.active = false
        .Ok
    }

    fn dispose(&mut self) {
        if self.handle < 0 { return }
        _ := self.restore()
        unsafe {
            if target_is("windows") { _ := close_handle(ptr(usize(self.handle))) }
            else if target_is("macos") { _ := close_fd(i32(self.handle)) }
            else if target_is("linux") { _ := sys.linux_syscall(57, self.handle, 0, 0, 0, 0, 0) }
        }
        self.handle = -1
    }
}
