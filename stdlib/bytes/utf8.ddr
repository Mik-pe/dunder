import sys

pub fn append_scalar(output: &mut []u8, scalar: rune) {
    cp := i32(scalar)
    if cp < 0x80 { output.push(u8(cp)); return }
    if cp < 0x800 { output.push(u8(0xc0 + cp.shr(6))) }
    else {
        if cp < 0x10000 { output.push(u8(0xe0 + cp.shr(12))) }
        else {
            output.push(u8(0xf0 + cp.shr(18)))
            output.push(u8(0x80 + cp.shr(12).bit_and(63)))
        }
        output.push(u8(0x80 + cp.shr(6).bit_and(63)))
    }
    output.push(u8(0x80 + cp.bit_and(63)))
}

pub fn decode(input: &[]u8) -> Result<string, sys.IoError> { decode_range(&input, 0, input.len) }
pub fn decode_range(input: &[]u8, start: i32, end: i32) -> Result<string, sys.IoError> {
    if start < 0 || end < start || end > input.len {
        return .Err(.InvalidArgument)
    }
    decoded := sys.decode_u8_range(&input, i64(start), i64(end - start))
    if decoded.ok { .Ok(decoded.value) } else { .Err(sys.IoError::from_code(decoded.error)) }
}

@derive(Eq)
pub enum Prefix { Scalar(rune, i32), Incomplete, Invalid }

pub fn decode_prefix(input: &[]u8) -> Prefix {
    if input.len == 0 { return .Incomplete }
    first := i32(input[0])
    if first < 128 { return .Scalar(rune(first), 1) }
    if first < 0xc2 || first > 0xf4 { return .Invalid }
    size := if first < 0xe0 { 2 } else if first < 0xf0 { 3 } else { 4 }
    mut scalar := first.bit_and(127.shr(size))
    for i in 1..size {
        if i == input.len { return .Incomplete }
        byte := i32(input[i])
        if byte < 0x80 || byte > 0xbf { return .Invalid }
        if i == 1 && ((first == 0xe0 && byte < 0xa0) || (first == 0xed && byte >= 0xa0) ||
            (first == 0xf0 && byte < 0x90) || (first == 0xf4 && byte >= 0x90)) { return .Invalid }
        scalar = scalar.shl(6).bit_or(byte.bit_and(63))
    }
    .Scalar(rune(scalar), size)
}

@test fn prefix_waits_only_for_possible_scalars() {
    for scalar in [0, 127, 128, 2047, 2048, 0xd7ff, 0xe000, 0xffff, 0x10000, 0x10ffff] {
        mut encoded: []u8 = []
        append_scalar(&mut encoded, rune(scalar))
        assert(encoded == rune(scalar).str().bytes())
        for split in 0..encoded.len { assert(decode_prefix(&encoded[..split]) == .Incomplete) }
        assert(decode_prefix(&encoded) == .Scalar(rune(scalar), encoded.len))
    }
    invalid: [][]u8 = [[u8(0x80)], [u8(0xff)], [u8(0xc0)], [u8(0xe0), 0x9f], [u8(0xed), 0xa0],
                [u8(0xf0), 0x8f], [u8(0xf4), 0x90], [u8(0xf5)], [u8(0xe2), 65], [u8(0xf0), 0x90, 0]]
    for bad in &invalid {
        assert(decode_prefix(&bad) == .Invalid)
    }
    both: []u8 = [0xc3, 0xa5, 0xff]
    assert(decode_prefix(&both) == .Scalar(rune(229), 2))
}
