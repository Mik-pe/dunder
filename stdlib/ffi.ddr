capability unsafe

// Foundation module for C/OS FFI interop.
// Wave 2 will add C primitive type aliases here (c_char, c_schar, c_uchar,
// c_short, c_ushort, c_int, c_uint, c_long, c_ulong, c_longlong, c_ulonglong,
// c_void) once i8 and isize are added to the compiler.

import std.bytes as bytes
import std.bytes.utf8 as utf8
import std.utf16 as utf16
import sys

pub extern type c_void

@thread_safe
pub fn null<T>() -> *const T {
    unsafe { __ffi_from_addr(usize(0)) }
}

@thread_safe
pub fn null_mut<T>() -> *mut T {
    unsafe { __ffi_from_addr(usize(0)) }
}

@thread_safe
pub unsafe fn from_addr<T>(address: usize) -> *const T {
    __ffi_from_addr(address)
}

@thread_safe
pub unsafe fn from_addr_mut<T>(address: usize) -> *mut T {
    __ffi_from_addr(address)
}

@thread_safe
pub unsafe fn from_ptr<T>(raw: ptr) -> *const T {
    __ffi_from_addr(raw)
}

@thread_safe
pub unsafe fn from_ptr_mut<T>(raw: ptr) -> *mut T {
    __ffi_from_addr(raw)
}

@thread_safe
pub unsafe fn zeroed<T>() -> T {
    __ffi_zeroed()
}

@extern("macos", "c", "__error")
@extern("linux", "c", "__errno_location")
@extern("windows", "msvcrt.dll", "_errno")
@thread_safe
unsafe fn c_errno_ptr() -> ptr

@extern("windows", "kernel32.dll", "GetLastError")
@thread_safe
unsafe fn win_get_last_error() -> u32

@thread_safe
pub fn c_char_size() -> usize { usize(1) }

@thread_safe
pub fn c_short_size() -> usize { usize(2) }

@thread_safe
pub fn c_int_size() -> usize { usize(4) }

@thread_safe
pub fn c_long_size() -> usize {
    if target_is("windows") || target_is("wasm32") { return usize(4) }
    usize(8)
}

@thread_safe
pub fn c_longlong_size() -> usize { usize(8) }

@thread_safe
pub fn c_ptr_size() -> usize { size_of(ptr) }

@thread_safe
pub unsafe fn errno() -> i32 {
    if target_is("macos") || target_is("linux") || target_is("windows") {
        return load_i32(c_errno_ptr())
    }
    0
}

@thread_safe
pub unsafe fn set_errno(value: i32) {
    if target_is("macos") || target_is("linux") || target_is("windows") {
        store_i32(c_errno_ptr(), value)
    }
}

@thread_safe
pub unsafe fn last_os_error() -> i32 {
    if target_is("windows") {
        return i32(win_get_last_error())
    } else if target_is("macos") || target_is("linux") {
        return load_i32(c_errno_ptr())
    }
    0
}

pub struct NulError {
    position: i32,
}

impl NulError {
    @thread_safe
    pub fn position(&self) -> i32 { self.position }
}

impl Eq for NulError {
    fn eq(&self, other: &Self) -> bool { self.position == other.position }
}

impl Display for NulError {
    fn str(&self) -> string { f"interior NUL at index {self.position}" }
}

pub opaque struct CString {
    bytes: []u8,
}

impl CString {
    @thread_safe
    pub fn new(value: string) -> Result<Self, NulError> {
        for i in 0..value.len {
            if value[i] == 0 { return .Err(NulError { position: i }) }
        }
        mut out: []u8 = []
        out.reserve(value.len + 1)
        bytes.append_utf8(&mut out, value)
        out.push(0)
        .Ok(Self { bytes: move out })
    }

    @thread_safe
    pub fn from_bytes(data: &[]u8) -> Result<Self, NulError> {
        for i in 0..data.len {
            if data[i] == 0 { return .Err(NulError { position: i }) }
        }
        mut out: []u8 = []
        out.reserve(data.len + 1)
        bytes.extend(&mut out, &data)
        out.push(0)
        .Ok(Self { bytes: move out })
    }

    @thread_safe
    pub fn as_ptr(&self) -> ptr {
        unsafe { return addr(&self.bytes[0]) }
    }

    @thread_safe
    pub fn as_bytes(&self) -> &[]u8 from self {
        unsafe { return bytes_view(&self, addr(&self.bytes[0]), usize(self.bytes.len - 1)) }
    }

    @thread_safe
    pub fn as_bytes_with_nul(&self) -> &[]u8 from self { &self.bytes }

    @thread_safe
    pub fn len(&self) -> i32 { self.bytes.len - 1 }

    @thread_safe
    pub fn is_empty(&self) -> bool { self.bytes.len <= 1 }

    @thread_safe
    pub fn to_string(&self) -> Result<string, sys.IoError> {
        bytes.decode_range(&self.bytes, 0, self.bytes.len - 1)
    }
}

impl Eq for CString {
    fn eq(&self, other: &Self) -> bool { bytes.equal(&self.bytes, &other.bytes) }
}

@thread_safe
pub unsafe fn c_strlen(p: ptr) -> usize {
    if usize(p) == usize(0) { return usize(0) }
    mut n: usize = usize(0)
    while load_u8(ptr(usize(p) + n)) != u8(0) { n += usize(1) }
    n
}

@thread_safe
pub unsafe fn c_strnlen(p: ptr, limit: usize) -> usize {
    if usize(p) == usize(0) { return usize(0) }
    mut n: usize = usize(0)
    while n < limit && load_u8(ptr(usize(p) + n)) != u8(0) { n += usize(1) }
    n
}

@thread_safe
unsafe fn copy_c_bytes(p: ptr, length: usize) -> []u8 {
    mut raw: []u8 = []
    if length == usize(0) { return raw }
    raw.reserve(i32(length))
    mut i: usize = usize(0)
    while i < length {
        raw.push(load_u8(ptr(usize(p) + i)))
        i += usize(1)
    }
    raw
}

@thread_safe
fn decode_utf8_lossy(raw: &[]u8) -> string {
    match bytes.decode(&raw) {
        .Ok(value) => { return value },
        .Err(_) => {},
    }
    mut out: []u8 = []
    out.reserve(raw.len + 16)
    mut pos := 0
    while pos < raw.len {
        b0 := i32(raw[pos])
        if b0 < 0x80 {
            out.push(u8(b0))
            pos += 1
        } else if b0 >= 0xc2 && b0 <= 0xdf && pos + 1 < raw.len {
            b1 := i32(raw[pos + 1])
            if b1 >= 0x80 && b1 <= 0xbf {
                out.push(u8(b0))
                out.push(u8(b1))
                pos += 2
            } else {
                utf8.append_scalar(&mut out, rune(0xfffd))
                pos += 1
            }
        } else if b0 >= 0xe0 && b0 <= 0xef && pos + 2 < raw.len {
            b1 := i32(raw[pos + 1])
            b2 := i32(raw[pos + 2])
            valid_b1 := if b0 == 0xe0 { b1 >= 0xa0 && b1 <= 0xbf }
                else if b0 == 0xed { b1 >= 0x80 && b1 <= 0x9f }
                else { b1 >= 0x80 && b1 <= 0xbf }
            if valid_b1 && b2 >= 0x80 && b2 <= 0xbf {
                out.push(u8(b0))
                out.push(u8(b1))
                out.push(u8(b2))
                pos += 3
            } else {
                utf8.append_scalar(&mut out, rune(0xfffd))
                pos += 1
            }
        } else if b0 >= 0xf0 && b0 <= 0xf4 && pos + 3 < raw.len {
            b1 := i32(raw[pos + 1])
            b2 := i32(raw[pos + 2])
            b3 := i32(raw[pos + 3])
            valid_b1 := if b0 == 0xf0 { b1 >= 0x90 && b1 <= 0xbf }
                else if b0 == 0xf4 { b1 >= 0x80 && b1 <= 0x8f }
                else { b1 >= 0x80 && b1 <= 0xbf }
            if valid_b1 && b2 >= 0x80 && b2 <= 0xbf && b3 >= 0x80 && b3 <= 0xbf {
                out.push(u8(b0))
                out.push(u8(b1))
                out.push(u8(b2))
                out.push(u8(b3))
                pos += 4
            } else {
                utf8.append_scalar(&mut out, rune(0xfffd))
                pos += 1
            }
        } else {
            utf8.append_scalar(&mut out, rune(0xfffd))
            pos += 1
        }
    }
    bytes.decode(&out).unwrap_or_default()
}

@thread_safe
pub unsafe fn from_cstr(p: ptr) -> Option<string> {
    if usize(p) == usize(0) { return .None }
    n := c_strlen(p)
    if n > usize(2147483647) { return .None }
    raw := copy_c_bytes(p, n)
    match bytes.decode(&raw) {
        .Ok(value) => .Some(value),
        .Err(_) => .None,
    }
}

@thread_safe
pub unsafe fn from_cstr_bounded(p: ptr, max_bytes: usize) -> Option<string> {
    if usize(p) == usize(0) { return .None }
    n := c_strnlen(p, max_bytes)
    if n == max_bytes && load_u8(ptr(usize(p) + n)) != u8(0) { return .None }
    if n > usize(2147483647) { return .None }
    raw := copy_c_bytes(p, n)
    match bytes.decode(&raw) {
        .Ok(value) => .Some(value),
        .Err(_) => .None,
    }
}

@thread_safe
pub unsafe fn from_cstr_lossy(p: ptr) -> Option<string> {
    if usize(p) == usize(0) { return .None }
    n := c_strlen(p)
    if n > usize(2147483647) { return .None }
    raw := copy_c_bytes(p, n)
    .Some(decode_utf8_lossy(&raw))
}

pub opaque struct WString {
    units: []u16,
}

@thread_safe
fn decode_utf16_slice(units: &[]u16, start: i32, end: i32, lossy: bool) -> Option<string> {
    if start < 0 || end < start || end > units.len { return .None }
    mut out: []u8 = []
    out.reserve(end - start)
    mut i := start
    while i < end {
        u := i32(units[i])
        if u >= 0xd800 && u <= 0xdbff {
            if i + 1 < end {
                lo := i32(units[i + 1])
                if lo >= 0xdc00 && lo <= 0xdfff {
                    cp := 0x10000 + (u - 0xd800).shl(10) + (lo - 0xdc00)
                    utf8.append_scalar(&mut out, rune(cp))
                    i += 2
                    continue
                }
            }
            if !lossy { return .None }
            utf8.append_scalar(&mut out, rune(0xfffd))
            i += 1
        } else if u >= 0xdc00 && u <= 0xdfff {
            if !lossy { return .None }
            utf8.append_scalar(&mut out, rune(0xfffd))
            i += 1
        } else {
            utf8.append_scalar(&mut out, rune(u))
            i += 1
        }
    }
    match bytes.decode(&out) {
        .Ok(value) => .Some(value),
        .Err(_) => .None,
    }
}

@thread_safe
pub fn decode_utf16(units: &[]u16) -> Option<string> {
    decode_utf16_slice(&units, 0, units.len, false)
}

@thread_safe
pub fn decode_utf16_lossy(units: &[]u16) -> string {
    decode_utf16_slice(&units, 0, units.len, true).unwrap_or_default()
}

impl WString {
    @thread_safe
    pub fn new(value: string) -> Result<Self, NulError> {
        for i in 0..value.len {
            if value[i] == 0 { return .Err(NulError { position: i }) }
        }
        mut units: []u16 = []
        utf16.append(&mut units, value.as_str())
        units.push(u16(0))
        .Ok(Self { units: move units })
    }

    @thread_safe
    pub fn from_units(data: &[]u16) -> Result<Self, NulError> {
        for i in 0..data.len {
            if data[i] == u16(0) { return .Err(NulError { position: i }) }
        }
        mut units: []u16 = []
        units.reserve(data.len + 1)
        for u in &data { units.push(u) }
        units.push(u16(0))
        .Ok(Self { units: move units })
    }

    @thread_safe
    pub fn as_ptr(&self) -> ptr {
        unsafe { return addr(&self.units[0]) }
    }

    @thread_safe
    pub fn as_units_with_nul(&self) -> &[]u16 from self { &self.units }

    @thread_safe
    pub fn len(&self) -> i32 { self.units.len - 1 }

    @thread_safe
    pub fn is_empty(&self) -> bool { self.units.len <= 1 }

    @thread_safe
    pub fn to_string(&self) -> Option<string> {
        decode_utf16_slice(&self.units, 0, self.units.len - 1, false)
    }
}

impl Eq for WString {
    fn eq(&self, other: &Self) -> bool {
        if self.units.len != other.units.len { return false }
        for i in 0..self.units.len {
            if self.units[i] != other.units[i] { return false }
        }
        true
    }
}

@thread_safe
pub unsafe fn c_wstrlen(p: ptr) -> usize {
    if usize(p) == usize(0) { return usize(0) }
    mut n: usize = usize(0)
    while load_u16(ptr(usize(p) + n * usize(2))) != u16(0) { n += usize(1) }
    n
}

@thread_safe
pub unsafe fn from_wstr(p: ptr) -> Option<string> {
    if usize(p) == usize(0) { return .None }
    n := c_wstrlen(p)
    if n > usize(2147483647) { return .None }
    mut units: []u16 = []
    units.reserve(i32(n))
    mut i: usize = usize(0)
    while i < n {
        units.push(load_u16(ptr(usize(p) + i * usize(2))))
        i += usize(1)
    }
    decode_utf16(&units)
}

@thread_safe
pub unsafe fn from_wstr_lossy(p: ptr) -> Option<string> {
    if usize(p) == usize(0) { return .None }
    n := c_wstrlen(p)
    if n > usize(2147483647) { return .None }
    mut units: []u16 = []
    units.reserve(i32(n))
    mut i: usize = usize(0)
    while i < n {
        units.push(load_u16(ptr(usize(p) + i * usize(2))))
        i += usize(1)
    }
    .Some(decode_utf16_lossy(&units))
}

@test fn cstring_and_wstring_round_trip() {
    cs := CString::new("hej åäö 🌍").unwrap()
    assert(cs.len() == 15 && !cs.is_empty())
    assert(cs.as_bytes().len == 15 && cs.as_bytes_with_nul().len == 16)
    assert(cs.as_bytes_with_nul()[15] == u8(0))
    assert(cs.to_string() == .Ok("hej åäö 🌍"))
    assert(CString::new("a\0b") == .Err(NulError { position: 1 }))

    ws := WString::new("Ö🌍").unwrap()
    assert(ws.len() == 3 && !ws.is_empty())
    assert(ws.as_units_with_nul().len == 4 && ws.as_units_with_nul()[3] == u16(0))
    assert(ws.to_string() == .Some("Ö🌍"))
    assert(WString::new("a\0b") == .Err(NulError { position: 1 }))

    unsafe {
        assert(from_cstr(ptr(0)) == .None)
        assert(from_cstr_lossy(ptr(0)) == .None)
        assert(from_cstr(cs.as_ptr()) == .Some("hej åäö 🌍"))
        assert(from_wstr(ptr(0)) == .None)
        assert(from_wstr(ws.as_ptr()) == .Some("Ö🌍"))
    }
}
