capability unsafe

// Fixed Objective-C method prototypes. The selected method's signature determines
// how ARM64 passes booleans, floating values and homogeneous CoreGraphics records.
@c_layout
pub struct Pair { x: f64, y: f64 }
@c_layout
pub struct Rect { x: f64, y: f64, w: f64, h: f64 }

@extern("/usr/lib/libobjc.A.dylib", "objc_getClass")
pub unsafe fn class_named(name: ptr) -> ptr

@extern("/usr/lib/libobjc.A.dylib", "sel_registerName")
pub unsafe fn selector(name: ptr) -> ptr

@extern("/usr/lib/libobjc.A.dylib", "objc_allocateClassPair")
pub unsafe fn allocate_class(parent: ptr, name: ptr, bytes: usize) -> ptr

@extern("/usr/lib/libobjc.A.dylib", "objc_registerClassPair")
pub unsafe fn register_class(value: ptr)

@extern("/usr/lib/libobjc.A.dylib", "class_addMethod")
pub unsafe fn add_method(value: ptr, selector: ptr, imp: extern fn(ptr, ptr, ptr), encoding: ptr) -> u8

@extern("/usr/lib/libobjc.A.dylib", "objc_msgSend")
unsafe fn raw_get(object: ptr, method: ptr) -> ptr
pub unsafe fn get(object: ptr, name: ptr) -> ptr { raw_get(object, selector(name)) }

