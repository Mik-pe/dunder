pub unsafe fn named_string(bytes: ptr) -> ptr {
    get_object(class_named(cstr("NSString")), cstr("stringWithUTF8String:"), bytes)
}
pub unsafe fn new_object(name: ptr) -> ptr { get(class_named(name), cstr("new")) }
pub unsafe fn release(object: ptr) { action(object, cstr("release")) }
pub unsafe fn pool() -> ptr { new_object(cstr("NSAutoreleasePool")) }
pub unsafe fn drain(object: ptr) { action(object, cstr("drain")) }

@extern("/usr/lib/libobjc.A.dylib", "class_addMethod")
pub unsafe fn add_terminate(value: ptr, selector: ptr, imp: extern fn(ptr, ptr, ptr) -> usize, encoding: ptr) -> u8

@extern("/usr/lib/libobjc.A.dylib", "objc_disposeClassPair")
pub unsafe fn dispose_class(value: ptr)

@extern("/usr/lib/libobjc.A.dylib", "objc_msgSend")
pub unsafe fn activation_policy(application: ptr, selector: ptr, policy: usize) -> u8
