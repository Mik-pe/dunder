capability unsafe
import std.macos.objc as o

@c_layout
pub struct State {
    application: ptr, rootPool: ptr, delegateClass: ptr, mode: ptr,
    createDevice: extern fn() -> ptr, now: extern fn() -> f64,
    window: ptr, view: ptr, layer: ptr, delegate: ptr,
    device: ptr, queue: ptr, pipeline: ptr, buffer: ptr,
    generation: i64, active: i32, closed: i32, frames: i64, vertexCount: usize,
    width: i32, height: i32, pixelWidth: i32, pixelHeight: i32,
    scale: f64, logicalWidth: f64, logicalHeight: f64,
    start: f64, x: f64, y: f64, down: i32, key: i32, resized: i32,
    clear: o.Rect,
}

pub unsafe fn state() -> ptr {
    assert(size_of(State) <= 512)
    static_bytes("macos", 512)
}

unsafe fn shader_source() -> ptr {
    o.named_string(cstr("#include <metal_stdlib>\nusing namespace metal;\nstruct Vertex { float4 position; float4 color; };\nstruct Output { float4 position [[position]]; float4 color; };\nvertex Output vertex_main(uint index [[vertex_id]], constant Vertex* vertices [[buffer(0)]]) { Output v; v.position = vertices[index].position; v.color = vertices[index].color; return v; }\nfragment float4 fragment_main(Output v [[stage_in]]) { return v.color; }"))
}

pub unsafe fn setup(s: &mut State) -> bool {
    s.device = s.createDevice()
    if s.device == ptr(0) { return false }
    s.queue = o.get(s.device, cstr("newCommandQueue"))
    if s.queue == ptr(0) { return false }
    var error := ptr(0)
    library := o.three_objects(s.device, cstr("newLibraryWithSource:options:error:"), shader_source(), ptr(0), addr(&mut error))
    if library == ptr(0) { return false }
    vertex := o.get_object(library, cstr("newFunctionWithName:"), o.named_string(cstr("vertex_main")))
    fragment := o.get_object(library, cstr("newFunctionWithName:"), o.named_string(cstr("fragment_main")))
    descriptor := o.new_object(cstr("MTLRenderPipelineDescriptor"))
    if vertex != ptr(0) && fragment != ptr(0) && descriptor != ptr(0) {
        o.set_object(descriptor, cstr("setVertexFunction:"), vertex)
        o.set_object(descriptor, cstr("setFragmentFunction:"), fragment)
        attachment := o.get_index(o.get(descriptor, cstr("colorAttachments")), cstr("objectAtIndexedSubscript:"), 0)
        o.set_word(attachment, cstr("setPixelFormat:"), 80)
        o.set_flag(attachment, cstr("setBlendingEnabled:"), 1)
        o.set_word(attachment, cstr("setSourceRGBBlendFactor:"), 4)
        o.set_word(attachment, cstr("setDestinationRGBBlendFactor:"), 5)
        o.set_word(attachment, cstr("setSourceAlphaBlendFactor:"), 1)
        o.set_word(attachment, cstr("setDestinationAlphaBlendFactor:"), 5)
        s.pipeline = o.two_objects(s.device, cstr("newRenderPipelineStateWithDescriptor:error:"), descriptor, addr(&mut error))
    }
    o.release(descriptor)
    o.release(fragment)
    o.release(vertex)
    o.release(library)
    s.pipeline != ptr(0)
}

unsafe fn present(s: &mut State) -> bool {
    drawable := o.get(s.layer, cstr("nextDrawable"))
    if drawable == ptr(0) { return true }
    pass := o.get(o.class_named(cstr("MTLRenderPassDescriptor")), cstr("renderPassDescriptor"))
    attachment := o.get_index(o.get(pass, cstr("colorAttachments")), cstr("objectAtIndexedSubscript:"), 0)
    o.set_object(attachment, cstr("setTexture:"), o.get(drawable, cstr("texture")))
    o.set_word(attachment, cstr("setLoadAction:"), 2)
    o.set_word(attachment, cstr("setStoreAction:"), 1)
    o.set_rect(attachment, cstr("setClearColor:"), s.clear)
    command := o.get(s.queue, cstr("commandBuffer"))
    encoder := o.get_object(command, cstr("renderCommandEncoderWithDescriptor:"), pass)
    if encoder == ptr(0) { return false }
    o.set_object(encoder, cstr("setRenderPipelineState:"), s.pipeline)
    o.set_word(encoder, cstr("setCullMode:"), 0)
    if s.vertexCount != 0 {
        o.bind_buffer(encoder, cstr("setVertexBuffer:offset:atIndex:"), s.buffer, 0, 0)
        o.draw(encoder, cstr("drawPrimitives:vertexStart:vertexCount:"), 3, 0, s.vertexCount)
    }
    o.action(encoder, cstr("endEncoding"))
    o.set_object(command, cstr("presentDrawable:"), drawable)
    o.action(command, cstr("commit"))
    o.action(command, cstr("waitUntilCompleted"))
    if o.get_word(command, cstr("status")) != 4 || o.get(command, cstr("error")) != ptr(0) { return false }
    s.frames = s.frames + 1
    true
}

pub unsafe fn render(s: &mut State) -> bool {
    if s.active == 0 || s.closed != 0 || s.pixelWidth == 0 || s.pixelHeight == 0 { return true }
    if o.get_flag(s.window, cstr("isVisible")) == 0 || o.get_flag(s.window, cstr("isMiniaturized")) != 0 { return true }
    pool := o.pool()
    ok := present(&mut s)
    o.drain(pool)
    ok
}

pub unsafe fn upload(s: &mut State, data: &[]f32, red: f64, green: f64, blue: f64) -> bool {
    var next := ptr(0)
    if data.len != 0 {
        next = o.buffer(s.device, cstr("newBufferWithBytes:length:options:"), addr(&data[0]), usize(data.len) * 4, 0)
        if next == ptr(0) { return false }
    }
    o.release(s.buffer)
    s.buffer = next
    s.vertexCount = usize(data.len / 8)
    s.clear = o.Rect {x: red, y: green, w: blue, h: 1.0}
    true
}
