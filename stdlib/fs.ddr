pub opaque struct ReadFile { path: string }
pub opaque struct WriteFile { path: string }
pub opaque struct ReadDir { root: string }

impl ReadFile {
    @requires(filesystem)
    pub fn grant(move path: string) -> Self { Self { path: path } }
    pub fn read(&self) -> sys.TextResult { sys.read_text(self.path) }
    pub fn read_bytes(&self) -> sys.BytesResult { sys.read_u8(self.path) }
    pub fn read_bytes_limit(&self, max_bytes: i64) -> sys.BytesResult { sys.read_u8_limit(self.path, max_bytes) }
    pub fn read_bytes_into(&self, out: &mut []u8, max_bytes: i64) -> sys.Status { sys.read_u8_into(self.path, &mut out, max_bytes) }
    pub fn metadata(&self) -> sys.Metadata { sys.metadata(self.path) }
    pub fn open(&self) -> Result<FileReader, sys.IoError> {
        match os_open_fd(self.path, OpenOptions::read_only()) {
            .Ok(fd) => .Ok(FileReader { fd: fd }),
            .Err(e) => .Err(e),
        }
    }
}

impl WriteFile {
    @requires(filesystem)
    pub fn grant(move path: string) -> Self { Self { path: path } }
    pub fn write(&self, text: string) -> sys.Status { sys.write_text(self.path, text) }
    pub fn append(&self, text: string) -> sys.Status { sys.append_text(self.path, text) }
    pub fn write_bytes(&self, bytes: &[]u8) -> sys.Status { sys.write_u8(self.path, &bytes) }
    pub fn create(&self) -> Result<FileWriter, sys.IoError> {
        match os_open_fd(self.path, OpenOptions::create_truncate()) {
            .Ok(fd) => .Ok(FileWriter { fd: fd }),
            .Err(e) => .Err(e),
        }
    }
    pub fn open_append(&self) -> Result<FileWriter, sys.IoError> {
        match os_open_fd(self.path, OpenOptions::append_only()) {
            .Ok(fd) => .Ok(FileWriter { fd: fd }),
            .Err(e) => .Err(e),
        }
    }
}

pub struct OpenOptions {
    read: bool,
    write: bool,
    create: bool,
    truncate: bool,
    append: bool,
    create_new: bool,
    nofollow: bool,
    mode: i32,
}

impl OpenOptions {
    pub fn read_only() -> Self {
        Self { read: true, write: false, create: false, truncate: false, append: false, create_new: false, nofollow: false, mode: 420 }
    }
    pub fn write_only() -> Self {
        Self { read: false, write: true, create: false, truncate: false, append: false, create_new: false, nofollow: false, mode: 420 }
    }
    pub fn create_truncate() -> Self {
        Self { read: false, write: true, create: true, truncate: true, append: false, create_new: false, nofollow: false, mode: 420 }
    }
    pub fn append_only() -> Self {
        Self { read: false, write: true, create: true, truncate: false, append: true, create_new: false, nofollow: false, mode: 420 }
    }
    pub fn read_write() -> Self {
        Self { read: true, write: true, create: false, truncate: false, append: false, create_new: false, nofollow: false, mode: 420 }
    }
    pub fn set_create(&mut self, enabled: bool) { self.create = enabled }
    pub fn set_truncate(&mut self, enabled: bool) { self.truncate = enabled }
    pub fn set_append(&mut self, enabled: bool) { self.append = enabled }
    pub fn set_create_new(&mut self, enabled: bool) { self.create_new = enabled }
    pub fn set_nofollow(&mut self, enabled: bool) { self.nofollow = enabled }
    pub fn set_mode(&mut self, mode: i32) { self.mode = mode }
}

@resource(dispose)
pub opaque struct FileReader { fd: i32 }

@resource(dispose)
pub opaque struct FileWriter { fd: i32 }

@resource(dispose)
pub opaque struct File { fd: i32 }

fn os_close_fd(fd: i32) -> Result<(), sys.IoError> {
    if fd < 0 { return .Ok }
    if !target_is("native") { return .Err(.Unsupported) }
    mut n: i64 = 0
    unsafe { n = sys.fd_close(fd) }
    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
    .Ok
}

fn os_open_fd(path: string, opts: OpenOptions) -> Result<i32, sys.IoError> {
    if !target_is("native") { return .Err(.Unsupported) }
    if !opts.read && !opts.write { return .Err(.InvalidArgument) }
    if opts.truncate && !opts.write { return .Err(.InvalidArgument) }
    mut raw_path: []u8 = []
    path_err := c_path(path, &mut raw_path)
    if path_err != 0 { return .Err(sys.IoError::from_code(path_err)) }
    mut base_flags := 0
    if opts.read && opts.write { base_flags = 2 }
    else if opts.write { base_flags = 1 }
    if target_is("macos") {
        mut flags := base_flags + 16777216 // O_CLOEXEC
        if opts.create || opts.create_new { flags += 512 }
        if opts.create_new { flags += 2048 }
        if opts.truncate { flags += 1024 }
        if opts.append { flags += 8 }
        if opts.nofollow { flags += 256 }
        unsafe {
            fd := c_open_mode(addr(&raw_path[0]), flags, opts.mode)
            if fd < 0 { return .Err(sys.IoError::from_code(portable_errno(load_i32(c_errno_ptr()), true))) }
            return .Ok(fd)
        }
    } else if target_is("linux") {
        mut flags := base_flags + 524288 // O_CLOEXEC
        if opts.create || opts.create_new { flags += 64 }
        if opts.create_new { flags += 128 }
        if opts.truncate { flags += 512 }
        if opts.append { flags += 1024 }
        if opts.nofollow {
            if target_is("arm64") { flags += 32768 }
            else if target_is("x86_64") { flags += 131072 }
        }
        unsafe {
            // openat(AT_FDCWD=-100, path, flags, mode) = ARM64 syscall 56 (mapped on x86_64)
            r := sys.linux_syscall(56, -100, i64(usize(addr(&raw_path[0]))), i64(flags), i64(opts.mode), 0, 0)
            if r < 0 { return .Err(sys.IoError::from_code(portable_errno(i32(-r), false))) }
            return .Ok(i32(r))
        }
    }
    .Err(.Unsupported)
}

fn seek_whence_and_offset(pos: io.SeekFrom) -> (i32, i64) {
    match pos {
        .Start(n) => (0, n),
        .Current(n) => (1, n),
        .End(n) => (2, n),
    }
}

fn os_lseek(fd: i32, pos: io.SeekFrom) -> Result<i64, sys.IoError> {
    if fd < 0 { return .Err(.BadDescriptor) }
    if !target_is("native") { return .Err(.Unsupported) }
    (whence, offset) := seek_whence_and_offset(pos)
    if target_is("macos") {
        unsafe {
            r := c_lseek(fd, offset, whence)
            if r < 0 { return .Err(sys.IoError::from_code(portable_errno(load_i32(c_errno_ptr()), true))) }
            return .Ok(r)
        }
    } else if target_is("linux") {
        unsafe {
            // lseek(fd, offset, whence) = ARM64 syscall 62 (mapped on x86_64)
            r := sys.linux_syscall(62, i64(fd), offset, i64(whence), 0, 0, 0)
            if r < 0 && r >= -4095 { return .Err(sys.IoError::from_code(portable_errno(i32(-r), false))) }
            return .Ok(r)
        }
    }
    .Err(.Unsupported)
}

fn os_fsync(fd: i32) -> Result<(), sys.IoError> {
    if fd < 0 { return .Err(.BadDescriptor) }
    if !target_is("native") { return .Err(.Unsupported) }
    if target_is("macos") {
        unsafe {
            if c_fsync(fd) != 0 { return .Err(sys.IoError::from_code(portable_errno(load_i32(c_errno_ptr()), true))) }
            return .Ok
        }
    } else if target_is("linux") {
        unsafe {
            // fsync(fd) = ARM64 syscall 82 (mapped on x86_64)
            r := sys.linux_syscall(82, i64(fd), 0, 0, 0, 0, 0)
            if r < 0 { return .Err(sys.IoError::from_code(portable_errno(i32(-r), false))) }
            return .Ok
        }
    }
    .Err(.Unsupported)
}

impl FileReader {
    @requires(filesystem)
    pub fn open(path: string) -> Result<Self, sys.IoError> {
        match os_open_fd(path, OpenOptions::read_only()) {
            .Ok(fd) => .Ok(Self { fd: fd }),
            .Err(e) => .Err(e),
        }
    }
    pub fn fd(&self) -> i32 { self.fd }
    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> { os_fstat(self.fd) }
    pub fn close(&mut self) -> Result<(), sys.IoError> {
        fd := self.fd
        self.fd = -1
        os_close_fd(fd)
    }
    fn dispose(&mut self) {
        if self.fd >= 0 {
            unsafe { _ := sys.fd_close(self.fd) }
            self.fd = -1
        }
    }
}

impl io.Read for FileReader {
    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        mut r: Result<i32, sys.IoError> = .Ok(0)
        unsafe { r = io.fd_read_chunk(self.fd, &mut out, max_bytes) }
        r
    }
}

impl io.Seek for FileReader {
    fn seek(&mut self, pos: io.SeekFrom) -> Result<i64, sys.IoError> {
        os_lseek(self.fd, pos)
    }
}

impl FileWriter {
    @requires(filesystem)
    pub fn create(path: string) -> Result<Self, sys.IoError> {
        match os_open_fd(path, OpenOptions::create_truncate()) {
            .Ok(fd) => .Ok(Self { fd: fd }),
            .Err(e) => .Err(e),
        }
    }
    @requires(filesystem)
    pub fn open_append(path: string) -> Result<Self, sys.IoError> {
        match os_open_fd(path, OpenOptions::append_only()) {
            .Ok(fd) => .Ok(Self { fd: fd }),
            .Err(e) => .Err(e),
        }
    }
    pub fn fd(&self) -> i32 { self.fd }
    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> { os_fstat(self.fd) }
    pub fn set_permissions(&self, mode: u32) -> Result<(), sys.IoError> { os_fchmod(self.fd, mode) }
    pub fn sync(&self) -> Result<(), sys.IoError> { os_fsync(self.fd) }
    pub fn close(&mut self) -> Result<(), sys.IoError> {
        fd := self.fd
        self.fd = -1
        os_close_fd(fd)
    }
    fn dispose(&mut self) {
        if self.fd >= 0 {
            unsafe { _ := sys.fd_close(self.fd) }
            self.fd = -1
        }
    }
}

impl io.Write for FileWriter {
    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        mut r: Result<i32, sys.IoError> = .Ok(0)
        unsafe { r = io.fd_write_chunk(self.fd, &data) }
        r
    }
    fn flush(&mut self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        .Ok
    }
}

impl io.Seek for FileWriter {
    fn seek(&mut self, pos: io.SeekFrom) -> Result<i64, sys.IoError> {
        os_lseek(self.fd, pos)
    }
}

impl File {
    @requires(filesystem)
    pub fn open(path: string, opts: OpenOptions) -> Result<Self, sys.IoError> {
        match os_open_fd(path, opts) {
            .Ok(fd) => .Ok(Self { fd: fd }),
            .Err(e) => .Err(e),
        }
    }
    @requires(filesystem)
    pub fn open_read(path: string) -> Result<Self, sys.IoError> {
        File::open(path, OpenOptions::read_only())
    }
    @requires(filesystem)
    pub fn create(path: string) -> Result<Self, sys.IoError> {
        File::open(path, OpenOptions::create_truncate())
    }
    pub fn fd(&self) -> i32 { self.fd }
    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> { os_fstat(self.fd) }
    pub fn set_permissions(&self, mode: u32) -> Result<(), sys.IoError> { os_fchmod(self.fd, mode) }
    pub fn sync(&self) -> Result<(), sys.IoError> { os_fsync(self.fd) }
    pub fn close(&mut self) -> Result<(), sys.IoError> {
        fd := self.fd
        self.fd = -1
        os_close_fd(fd)
    }
    fn dispose(&mut self) {
        if self.fd >= 0 {
            unsafe { _ := sys.fd_close(self.fd) }
            self.fd = -1
        }
    }
}

impl io.Read for File {
    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        mut r: Result<i32, sys.IoError> = .Ok(0)
        unsafe { r = io.fd_read_chunk(self.fd, &mut out, max_bytes) }
        r
    }
}

impl io.Write for File {
    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        mut r: Result<i32, sys.IoError> = .Ok(0)
        unsafe { r = io.fd_write_chunk(self.fd, &data) }
        r
    }
    fn flush(&mut self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        .Ok
    }
}

impl io.Seek for File {
    fn seek(&mut self, pos: io.SeekFrom) -> Result<i64, sys.IoError> {
        os_lseek(self.fd, pos)
    }
}

impl ReadDir {
    @requires(filesystem)
    pub fn grant(move root: string) -> Self { Self { root: root } }

    pub fn resolve_read(&self, relative: string) -> Result<ReadFile, sys.IoError> {
        if relative.len == 0 || self.root.len == 0 { return .Err(.InvalidArgument) }
        if relative[0] == 47 { return .Err(.InvalidArgument) }
        mut seg_start := 0
        for i in 0..relative.len {
            b := relative[i]
            if b == 0 || b == 92 { return .Err(.InvalidArgument) }
            if b == 47 {
                seg_len := i - seg_start
                if seg_len == 0 { return .Err(.InvalidArgument) }
                if seg_len == 1 && relative[seg_start] == 46 { return .Err(.InvalidArgument) }
                if seg_len == 2 && relative[seg_start] == 46 && relative[seg_start + 1] == 46 {
                    return .Err(.InvalidArgument)
                }
                seg_start = i + 1
            }
        }
        tail_len := relative.len - seg_start
        if tail_len == 0 { return .Err(.InvalidArgument) }
        if tail_len == 1 && relative[seg_start] == 46 { return .Err(.InvalidArgument) }
        if tail_len == 2 && relative[seg_start] == 46 && relative[seg_start + 1] == 46 {
            return .Err(.InvalidArgument)
        }
        if self.root[self.root.len - 1] == 47 {
            return .Ok(ReadFile { path: self.root + relative })
        }
        .Ok(ReadFile { path: f"{self.root}/{relative}" })
    }

    pub fn list(&self) -> Result<[]string, sys.IoError> {
        if self.root.len == 0 { return .Err(.InvalidArgument) }
        list_dir_internal(self.root)
    }
}

fn c_path(path: string, out: &mut []u8) -> i32 {
    out.clear()
    if path.len == 0 { return 22 }
    if path.len > 1023 { return 63 }
    out.reserve(path.len + 1)
    for b in path.bytes() {
        if b == 0 { out.clear(); return 22 }
        out.push(u8(b))
    }
    out.push(0)
    0
}

fn portable_errno(raw: i32, is_darwin: bool) -> i32 {
    if raw <= 0 { return 5 }
    if is_darwin { return raw }
    if raw == 1 || raw == 2 || raw == 4 || raw == 5 || raw == 9 || raw == 12 ||
       raw == 13 || raw == 17 || raw == 20 || raw == 21 || raw == 22 ||
       raw == 27 || raw == 28 || raw == 30 || raw == 32 { return raw }
    if raw == 11 { return 35 }
    if raw == 36 { return 63 }
    if raw == 39 { return 66 }
    if raw == 84 { return 92 }
    if raw == 95 { return 45 }
    if raw == 98 { return 48 }
    if raw == 103 { return 53 }
    if raw == 104 { return 54 }
    if raw == 110 { return 60 }
    if raw == 111 { return 61 }
    if raw == 115 { return 36 }
    10000 + raw
}

unsafe fn host_is_darwin() -> i32 {
    _ := static_bytes("native", 16)
    mut uts: [u64; 256] = [0; 256]
    if c_uname(addr(&mut uts[0])) != 0 { return -1 }
    os := load_u8(addr(&uts[0]))
    if os == 68 { return 1 }
    if os == 76 { return 0 }
    -1
}

unsafe fn read_errno() -> i32 {
    _ := static_bytes("native", 16)
    darwin := host_is_darwin()
    if darwin < 0 { return 45 }
    mut sym_name := cstr("__errno_location")
    if darwin == 1 { sym_name = cstr("__error") }
    h := dl.open(ptr(0), 2)
    if usize(h) == 0 { return 5 }
    sym := dl.symbol(h, sym_name)
    if usize(sym) == 0 { _ := dl.close(h); return 5 }
    loc_fn: extern fn() -> ptr = ffi_fn(sym)
    ep := loc_fn()
    raw := load_i32(ep)
    _ := dl.close(h)
    portable_errno(raw, darwin == 1)
}

unsafe fn decode_cstr(p: ptr) -> sys.TextResult {
    if usize(p) == 0 { return sys.TextResult { ok: false, value: "", error: 22 } }
    mut out: []u8 = []
    mut i: usize = 0
    while i < 4096 {
        b := load_u8(ptr(usize(p) + i))
        if b == 0 { return bytes.decode(&out) }
        out.push(b)
        i += 1
    }
    sys.TextResult { ok: false, value: "", error: 63 }
}

@requires(filesystem)
pub fn cwd() -> sys.TextResult {
    unsafe {
        _ := static_bytes("native", 16)
        mut buf: [u8; 4096] = [0; 4096]
        p := c_getcwd(addr(&mut buf[0]), 4096)
        if usize(p) == 0 {
            return sys.TextResult { ok: false, value: "", error: read_errno() }
        }
        return decode_cstr(p)
    }
    sys.TextResult { ok: false, value: "", error: 45 }
}

@requires(filesystem)
pub fn realpath(path: string) -> sys.TextResult {
    mut raw: []u8 = []
    perr := c_path(path, &mut raw)
    if perr != 0 { return sys.TextResult { ok: false, value: "", error: perr } }
    unsafe {
        _ := static_bytes("native", 16)
        mut buf: [u8; 4096] = [0; 4096]
        p := c_realpath(addr(&raw[0]), addr(&mut buf[0]))
        if usize(p) == 0 {
            return sys.TextResult { ok: false, value: "", error: read_errno() }
        }
        return decode_cstr(p)
    }
    sys.TextResult { ok: false, value: "", error: 45 }
}

@requires(filesystem)
pub fn is_symlink(path: string) -> bool {
    mut raw: []u8 = []
    if c_path(path, &mut raw) != 0 { return false }
    mut scratch: u8 = 0
    unsafe {
        _ := static_bytes("native", 16)
        return c_readlink(addr(&raw[0]), addr(&mut scratch), 1) >= 0
    }
    false
}

@requires(filesystem)
pub fn symlink(target: string, link_path: string) -> sys.Status {
    mut raw_target: []u8 = []
    mut raw_link: []u8 = []
    e1 := c_path(target, &mut raw_target)
    if e1 != 0 { return sys.Status { ok: false, error: e1 } }
    e2 := c_path(link_path, &mut raw_link)
    if e2 != 0 { return sys.Status { ok: false, error: e2 } }
    unsafe {
        _ := static_bytes("native", 16)
        if c_symlink(addr(&raw_target[0]), addr(&raw_link[0])) == 0 {
            return sys.Status { ok: true, error: 0 }
        }
        return sys.Status { ok: false, error: read_errno() }
    }
    sys.Status { ok: false, error: 45 }
}

@requires(filesystem)
pub fn hard_link(existing: string, link_path: string) -> sys.Status {
    mut raw_existing: []u8 = []
    mut raw_link: []u8 = []
    e1 := c_path(existing, &mut raw_existing)
    if e1 != 0 { return sys.Status { ok: false, error: e1 } }
    e2 := c_path(link_path, &mut raw_link)
    if e2 != 0 { return sys.Status { ok: false, error: e2 } }
    unsafe {
        _ := static_bytes("native", 16)
        if c_link(addr(&raw_existing[0]), addr(&raw_link[0])) == 0 {
            return sys.Status { ok: true, error: 0 }
        }
        return sys.Status { ok: false, error: read_errno() }
    }
    sys.Status { ok: false, error: 45 }
}

@requires(filesystem)
pub fn mkdir_all(path: string) -> sys.Status {
    if path.len == 0 { return sys.Status { ok: false, error: 22 } }
    if path.len > 1023 { return sys.Status { ok: false, error: 63 } }
    for b in path.bytes() { if b == 0 { return sys.Status { ok: false, error: 22 } } }
    info := sys.metadata(path)
    if info.ok {
        if info.is_dir { return sys.Status { ok: true, error: 0 } }
        return sys.Status { ok: false, error: 17 }
    }
    mut i := 0
    if path[0] == 47 { i = 1 }
    while i <= path.len {
        if i == path.len || path[i] == 47 {
            if i > 0 {
                prefix := path[0..i]
                if prefix != "." && prefix != ".." {
                    pinfo := sys.metadata(prefix)
                    if !pinfo.ok {
                        st := sys.mkdir(prefix)
                        if !st.ok && st.error != 17 { return st }
                        check := sys.metadata(prefix)
                        if !check.ok || !check.is_dir {
                            return sys.Status { ok: false, error: 17 }
                        }
                    } else if !pinfo.is_dir {
                        return sys.Status { ok: false, error: 20 }
                    }
                }
            }
        }
        i += 1
    }
    sys.Status { ok: true, error: 0 }
}

@requires(filesystem)
pub fn temp_dir(prefix: string) -> sys.TextResult {
    for b in prefix.bytes() {
        if b == 0 || b == 47 {
            return sys.TextResult { ok: false, value: "", error: 22 }
        }
    }
    unsafe {
        _ := static_bytes("native", 16)
        mut base := "/tmp"
        env_p := c_getenv(cstr("TMPDIR"))
        if usize(env_p) != 0 {
            dec := decode_cstr(env_p)
            if dec.ok && dec.value.len > 0 && dec.value.len < 900 {
                base = dec.value
            }
        }
        while base.len > 1 && base[base.len - 1] == 47 {
            base = base[0..base.len - 1]
        }
        full := f"{base}/{prefix}XXXXXX"
        mut tmpl: []u8 = []
        perr := c_path(full, &mut tmpl)
        if perr != 0 { return sys.TextResult { ok: false, value: "", error: perr } }
        created := c_mkdtemp(addr(&mut tmpl[0]))
        if usize(created) == 0 {
            return sys.TextResult { ok: false, value: "", error: read_errno() }
        }
        return bytes.decode_range(&tmpl, 0, tmpl.len - 1)
    }
    sys.TextResult { ok: false, value: "", error: 45 }
}

fn list_dir_internal(path: string) -> Result<[]string, sys.IoError> {
    mut raw: []u8 = []
    perr := c_path(path, &mut raw)
    if perr != 0 { return .Err(sys.IoError::from_code(perr)) }
    mut names: []string = []
    unsafe {
        _ := static_bytes("native", 16)
        darwin := host_is_darwin()
        if darwin < 0 { return .Err(.Unsupported) }
        mut name_at := 19
        mut errno_sym := cstr("__errno_location")
        if darwin == 1 { name_at = 21; errno_sym = cstr("__error") }
        h := dl.open(ptr(0), 2)
        if usize(h) == 0 { return .Err(sys.IoError::from_code(5)) }
        sym := dl.symbol(h, errno_sym)
        if usize(sym) == 0 { _ := dl.close(h); return .Err(sys.IoError::from_code(5)) }
        errno_fn: extern fn() -> ptr = ffi_fn(sym)
        errno_ptr := errno_fn()
        _ := dl.close(h)

        dir := c_opendir(addr(&raw[0]))
        if usize(dir) == 0 {
            err := portable_errno(load_i32(errno_ptr), darwin == 1)
            return .Err(sys.IoError::from_code(err))
        }
        mut raw_name: []u8 = []
        mut read_err := 0
        while true {
            store_i32(errno_ptr, 0)
            entry := c_readdir(dir)
            if usize(entry) == 0 {
                e := load_i32(errno_ptr)
                if e != 0 { read_err = portable_errno(e, darwin == 1) }
                break
            }
            rec_len := i32(load_u16(ptr(usize(entry) + 16)))
            raw_name.clear()
            for off in name_at..rec_len {
                b := load_u8(ptr(usize(entry) + usize(off)))
                if b == 0 { break }
                raw_name.push(b)
            }
            dec := bytes.decode(&raw_name)
            if !dec.ok { read_err = 92; break }
            if dec.value != "" && dec.value != "." && dec.value != ".." {
                names.push(move dec.value)
            }
        }
        closed := c_closedir(dir)
        if read_err != 0 { return .Err(sys.IoError::from_code(read_err)) }
        if closed != 0 {
            return .Err(sys.IoError::from_code(portable_errno(load_i32(errno_ptr), darwin == 1)))
        }
    }
    array.sort<string>(&mut names)
    .Ok(names)
}

@requires(filesystem)
pub fn list_dir(path: string) -> Result<[]string, sys.IoError> { list_dir_internal(path) }

@requires(filesystem)
pub fn remove_all(path: string) -> sys.Status {
    if path.len == 0 || path == "/" || path == "." || path == ".." {
        return sys.Status { ok: false, error: 22 }
    }
    if is_symlink(path) {
        return sys.remove_file(path)
    }
    info := sys.metadata(path)
    if !info.ok {
        if info.error == 2 { return sys.Status { ok: true, error: 0 } }
        return sys.Status { ok: false, error: info.error }
    }
    if !info.is_dir {
        return sys.remove_file(path)
    }
    entries := match list_dir(path) {
        .Ok(items) => items,
        .Err(err) => { return sys.Status { ok: false, error: err.code() } },
    }
    mut prefix := path.clone()
    if prefix[prefix.len - 1] != 47 { prefix += "/" }
    for item in &entries {
        st := remove_all(prefix + item)
        if !st.ok { return st }
    }
    sys.remove_dir(path)
}


fn fs_cstr_bytes(p: string) -> []u8 {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, p)
    out.push(0)
    out
}

fn fs_err_from_errno(raw_errno: i32) -> sys.IoError {
    sys.IoError::from_code(portable_errno(raw_errno, target_is("macos")))
}

fn parse_stat_buf(buf: &[]u8) -> sys.Metadata {
    mut ok := false
    mut size: i64 = 0
    mut mode: u32 = u32(0)
    mut uid: u32 = u32(0)
    mut gid: u32 = u32(0)
    mut nlink: u64 = u64(0)
    mut dev: u64 = u64(0)
    mut ino: u64 = u64(0)
    mut mtime: i64 = 0
    if target_is("macos") && buf.len >= 144 {
        ok = true
        dev = u64(bytes.u32_le(&buf, 0))
        mode = u32(bytes.u16_le(&buf, 4))
        nlink = u64(bytes.u16_le(&buf, 6))
        ino = bytes.u64_le(&buf, 8)
        uid = u32(bytes.u32_le(&buf, 16))
        gid = u32(bytes.u32_le(&buf, 20))
        mtime = bytes.i64_le(&buf, 48)
        size = bytes.i64_le(&buf, 96)
    } else if target_is("linux") && target_is("arm64") && buf.len >= 128 {
        ok = true
        dev = bytes.u64_le(&buf, 0)
        ino = bytes.u64_le(&buf, 8)
        mode = u32(bytes.u32_le(&buf, 16))
        nlink = u64(bytes.u32_le(&buf, 20))
        uid = u32(bytes.u32_le(&buf, 24))
        gid = u32(bytes.u32_le(&buf, 28))
        size = bytes.i64_le(&buf, 48)
        mtime = bytes.i64_le(&buf, 88)
    } else if target_is("linux") && target_is("x86_64") && buf.len >= 144 {
        ok = true
        dev = bytes.u64_le(&buf, 0)
        ino = bytes.u64_le(&buf, 8)
        nlink = bytes.u64_le(&buf, 16)
        mode = u32(bytes.u32_le(&buf, 24))
        uid = u32(bytes.u32_le(&buf, 28))
        gid = u32(bytes.u32_le(&buf, 32))
        size = bytes.i64_le(&buf, 48)
        mtime = bytes.i64_le(&buf, 88)
    }
    fmt := i32(mode).bit_and(61440)
    is_file := ok && fmt == 32768
    is_dir := ok && fmt == 16384
    is_symlink := ok && fmt == 40960
    sys.Metadata {
        ok: ok,
        size: size,
        is_file: is_file,
        is_dir: is_dir,
        error: 0,
        is_symlink: is_symlink,
        mode: mode,
        uid: uid,
        gid: gid,
        nlink: nlink,
        dev: dev,
        ino: ino,
        mtime: mtime,
    }
}

fn os_stat(file_path: string, follow: bool) -> Result<sys.Metadata, sys.IoError> {
    if !target_is("native") { return .Err(.Unsupported) }
    raw := fs_cstr_bytes(file_path)
    mut buf: []u8 = []
    bytes.pad(&mut buf, 160)
    if target_is("macos") {
        unsafe {
            rc := if follow { c_stat(addr(&raw[0]), addr(&mut buf[0])) } else { c_lstat(addr(&raw[0]), addr(&mut buf[0])) }
            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }
            return .Ok(parse_stat_buf(&buf))
        }
    } else if target_is("linux") {
        flags := if follow { 0 } else { 256 }
        unsafe {
            rc := sys.linux_syscall(79, -100, i64(usize(addr(&raw[0]))), i64(usize(addr(&mut buf[0]))), i64(flags), 0, 0)
            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }
            return .Ok(parse_stat_buf(&buf))
        }
    }
    .Err(.Unsupported)
}

fn os_fstat(fd: i32) -> Result<sys.Metadata, sys.IoError> {
    if fd < 0 { return .Err(.InvalidArgument) }
    if !target_is("native") { return .Err(.Unsupported) }
    mut buf: []u8 = []
    bytes.pad(&mut buf, 160)
    if target_is("macos") {
        unsafe {
            rc := c_fstat(fd, addr(&mut buf[0]))
            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }
            return .Ok(parse_stat_buf(&buf))
        }
    } else if target_is("linux") {
        unsafe {
            rc := sys.linux_syscall(80, i64(fd), i64(usize(addr(&mut buf[0]))), 0, 0, 0, 0)
            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }
            return .Ok(parse_stat_buf(&buf))
        }
    }
    .Err(.Unsupported)
}

fn os_chmod(file_path: string, mode: u32) -> Result<(), sys.IoError> {
    if !target_is("native") { return .Err(.Unsupported) }
    raw := fs_cstr_bytes(file_path)
    masked := mode.bit_and(u32(4095))
    if target_is("macos") {
        unsafe {
            rc := c_chmod(addr(&raw[0]), masked)
            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }
            return .Ok
        }
    } else if target_is("linux") {
        unsafe {
            rc := sys.linux_syscall(53, -100, i64(usize(addr(&raw[0]))), i64(masked), 0, 0, 0)
            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }
            return .Ok
        }
    }
    .Err(.Unsupported)
}

fn os_fchmod(fd: i32, mode: u32) -> Result<(), sys.IoError> {
    if fd < 0 { return .Err(.InvalidArgument) }
    if !target_is("native") { return .Err(.Unsupported) }
    masked := mode.bit_and(u32(4095))
    if target_is("macos") {
        unsafe {
            rc := c_fchmod(fd, masked)
            if rc != 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }
            return .Ok
        }
    } else if target_is("linux") {
        unsafe {
            rc := sys.linux_syscall(52, i64(fd), i64(masked), 0, 0, 0, 0)
            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }
            return .Ok
        }
    }
    .Err(.Unsupported)
}

fn os_unlink_path(file_path: string) -> Result<(), sys.IoError> {
    st := sys.remove_file(file_path)
    if !st.ok { return .Err(sys.IoError::from_code(st.error)) }
    .Ok
}

@requires(filesystem)
fn os_rename_path(old_path: string, new_path: string) -> Result<(), sys.IoError> {
    st := sys.rename(old_path, new_path)
    if !st.ok { return .Err(sys.IoError::from_code(st.error)) }
    .Ok
}

fn os_write_all_fd(fd: i32, data: &[]u8) -> Result<(), sys.IoError> {
    if fd < 0 { return .Err(.InvalidArgument) }
    if !target_is("native") { return .Err(.Unsupported) }
    mut sent := 0
    while sent < data.len {
        rem := data.len - sent
        mut n: i64 = 0
        if target_is("macos") {
            unsafe {
                n = fs_c_write(fd, addr(&data[sent]), usize(rem))
                if n < 0 {
                    e := load_i32(c_errno_ptr())
                    if e == 4 { continue }
                    return .Err(fs_err_from_errno(e))
                }
            }
        } else if target_is("linux") {
            unsafe {
                n = sys.linux_syscall(64, i64(fd), i64(usize(addr(&data[sent]))), i64(rem), 0, 0, 0)
                if n < 0 {
                    e := i32(-n)
                    if e == 4 { continue }
                    return .Err(fs_err_from_errno(e))
                }
            }
        }
        if n == 0 { return .Err(.UnexpectedEof) }
        sent += i32(n)
    }
    .Ok
}

@requires(filesystem)
pub fn metadata(file_path: string) -> Result<sys.Metadata, sys.IoError> {
    os_stat(file_path, true)
}

@requires(filesystem)
pub fn lstat(file_path: string) -> Result<sys.Metadata, sys.IoError> {
    os_stat(file_path, false)
}

@requires(filesystem)
pub fn chmod(file_path: string, mode: u32) -> Result<(), sys.IoError> {
    os_chmod(file_path, mode)
}

@requires(filesystem)
pub fn sync_dir(dir_path: string) -> Result<(), sys.IoError> {
    if !target_is("native") { return .Err(.Unsupported) }
    meta := os_stat(dir_path, true)?
    if !meta.is_dir { return .Err(sys.IoError::from_code(20)) }
    raw := fs_cstr_bytes(dir_path)
    mut fd := -1
    if target_is("macos") {
        unsafe {
            fd = c_open_mode(addr(&raw[0]), 17825792, 0) // O_RDONLY | O_CLOEXEC | O_DIRECTORY
            if fd < 0 { return .Err(fs_err_from_errno(load_i32(c_errno_ptr()))) }
        }
    } else if target_is("linux") {
        flags := if target_is("arm64") { 524288 + 16384 } else { 524288 + 65536 }
        unsafe {
            rc := sys.linux_syscall(56, -100, i64(usize(addr(&raw[0]))), i64(flags), 0, 0, 0)
            if rc < 0 { return .Err(fs_err_from_errno(i32(-rc))) }
            fd = i32(rc)
        }
    }
    res := os_fsync(fd)
    _ := os_close_fd(fd)
    res
}

fn fs_hex_u64(v: u64) -> string {
    digits := "0123456789abcdef"
    mut out: []u8 = []
    mut i := 15
    while i >= 0 {
        nibble := i32(v.shr(i * 4).bit_and(u64(15)))
        out.push(u8(digits[nibble]))
        i -= 1
    }
    dec := bytes.decode(&out)
    assert(dec.ok)
    dec.value
}

unsafe fn fs_tmp_seq_ptr() -> ptr {
    static_bytes("native", 8)
}

fn fs_next_tmp_token(attempt: i32) -> u64 {
    mut seq: u64 = u64(attempt) + u64(1)
    if target_is("native") {
        unsafe {
            p := fs_tmp_seq_ptr()
            cur := load_i64(p) + 1
            store_i64(p, cur)
            seq = u64(cur)
        }
    }
    mut x := u64(time.unix_now_ms()).bit_xor(u64(time.monotonic_ms()).shl(17)).bit_xor(seq.shl(33)).bit_xor(u64(sys.pid()).shl(49)).bit_xor(u64(attempt))
    x = x.bit_xor(x.shr(12))
    x = x.bit_xor(x.shl(25))
    x = x.bit_xor(x.shr(27))
    x
}

@resource(dispose)
pub opaque struct TempFile {
    fd: i32,
    file_path: string,
    persisted: bool,
}

impl TempFile {
    pub fn path(&self) -> string { self.file_path.clone() }
    pub fn fd(&self) -> i32 { self.fd }
    pub fn metadata(&self) -> Result<sys.Metadata, sys.IoError> { os_fstat(self.fd) }
    pub fn set_permissions(&self, mode: u32) -> Result<(), sys.IoError> { os_fchmod(self.fd, mode) }
    pub fn write_all(&self, data: &[]u8) -> Result<(), sys.IoError> { os_write_all_fd(self.fd, &data) }
    pub fn write_text(&self, content: string) -> Result<(), sys.IoError> {
        raw := bytes.from_text(content)
        self.write_all(&raw)
    }
    pub fn sync(&self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Err(.InvalidArgument) }
        os_fsync(self.fd)
    }
    @requires(filesystem)
    pub fn persist(&mut self, dest: string) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Err(.InvalidArgument) }
        os_fsync(self.fd)?
        _ := os_close_fd(self.fd)
        self.fd = -1
        os_rename_path(self.file_path, dest)?
        self.persisted = true
        sync_dir(path.dirname(dest))
    }
    pub fn keep(&mut self) -> Result<string, sys.IoError> {
        if self.fd >= 0 {
            os_fsync(self.fd)?
            _ := os_close_fd(self.fd)
            self.fd = -1
        }
        self.persisted = true
        .Ok(self.file_path.clone())
    }
    pub fn close(&mut self) -> Result<(), sys.IoError> {
        if self.fd >= 0 {
            _ := os_close_fd(self.fd)
            self.fd = -1
        }
        if !self.persisted && self.file_path.len > 0 {
            self.persisted = true
            _ := os_unlink_path(self.file_path)
        }
        .Ok
    }
    fn dispose(&mut self) {
        _ := self.close()
    }
}

@requires(filesystem)
pub fn temp_file(dir: string, prefix: string) -> Result<TempFile, sys.IoError> {
    if !target_is("native") { return .Err(.Unsupported) }
    base_dir := if dir.len == 0 { "." } else { dir.clone() }
    safe_prefix := if prefix.len == 0 { "tmp-" } else { prefix.clone() }
    mut opts := OpenOptions::read_write()
    opts.set_create_new(true)
    opts.set_nofollow(true)
    opts.set_mode(384)
    for attempt in 0..64 {
        candidate := path.join(base_dir, safe_prefix + fs_hex_u64(fs_next_tmp_token(attempt)) + ".tmp")
        match os_open_fd(candidate, opts) {
            .Ok(fd) => {
                match os_fchmod(fd, u32(384)) {
                    .Ok(_) => {},
                    .Err(e) => {
                        _ := os_close_fd(fd)
                        _ := os_unlink_path(candidate)
                        return .Err(e)
                    },
                }
                return .Ok(TempFile { fd: fd, file_path: candidate, persisted: false })
            },
            .Err(err) => {
                if !sys.metadata(candidate).ok { return .Err(err) }
            },
        }
    }
    .Err(.AlreadyExists)
}

@requires(filesystem)
pub fn write_private_atomic(file_path: string, data: &[]u8) -> Result<(), sys.IoError> {
    dir := path.dirname(file_path)
    base := path.basename(file_path)
    mut tf := temp_file(dir, "." + base + ".tmp-")?
    tf.set_permissions(u32(384))?
    tf.write_all(&data)?
    tf.persist(file_path)
}

@requires(filesystem)
pub fn write_private_text_atomic(file_path: string, content: string) -> Result<(), sys.IoError> {
    raw := bytes.from_text(content)
    write_private_atomic(file_path, &raw)
}
