capability filesystem, unsafe
import std.array as array
import std.bytes as bytes
import std.dl as dl
import sys

@extern("c", "uname")
unsafe fn c_uname(output: ptr) -> i32
@extern("c", "opendir")
unsafe fn c_opendir(path: ptr) -> ptr
@extern("c", "readdir")
unsafe fn c_readdir(directory: ptr) -> ptr
@extern("c", "closedir")
unsafe fn c_closedir(directory: ptr) -> i32
@extern("c", "readlink")
unsafe fn c_readlink(path: ptr, buffer: ptr, capacity: usize) -> i64
@extern("c", "symlink")
unsafe fn c_symlink(target: ptr, link_path: ptr) -> i32
@extern("c", "link")
unsafe fn c_link(existing: ptr, link_path: ptr) -> i32
@extern("c", "realpath")
unsafe fn c_realpath(path: ptr, dst: ptr) -> ptr
@extern("c", "getcwd")
unsafe fn c_getcwd(dst: ptr, size: usize) -> ptr
@extern("c", "mkdtemp")
unsafe fn c_mkdtemp(tmpl: ptr) -> ptr
@extern("c", "getenv")
unsafe fn c_getenv(name: ptr) -> ptr

pub opaque struct ReadFile { path: string }
pub opaque struct WriteFile { path: string }
pub opaque struct ReadDir { root: string }
pub struct OpenFileResult { ok: bool, file: ReadFile, error: i32 }
pub struct DirEntriesResult { ok: bool, entries: []string, error: i32 }

@requires(filesystem)
pub fn grant_read(path: string) -> ReadFile { ReadFile { path: path } }

@requires(filesystem)
pub fn grant_write(path: string) -> WriteFile { WriteFile { path: path } }

@requires(filesystem)
pub fn grant_dir(root: string) -> ReadDir { ReadDir { root: root } }

fn invalid_open() -> OpenFileResult {
    OpenFileResult { ok: false, file: ReadFile { path: "" }, error: 22 }
}

pub fn resolve_read(dir: &ReadDir, relative: string) -> OpenFileResult {
    if relative.len == 0 || dir.root.len == 0 { return invalid_open() }
    if relative[0] == 47 { return invalid_open() }
    var seg_start := 0
    for i in 0..relative.len {
        b := relative[i]
        if b == 0 || b == 92 { return invalid_open() }
        if b == 47 {
            seg_len := i - seg_start
            if seg_len == 0 { return invalid_open() }
            if seg_len == 1 && relative[seg_start] == 46 { return invalid_open() }
            if seg_len == 2 && relative[seg_start] == 46 && relative[seg_start + 1] == 46 {
                return invalid_open()
            }
            seg_start = i + 1
        }
    }
    tail_len := relative.len - seg_start
    if tail_len == 0 { return invalid_open() }
    if tail_len == 1 && relative[seg_start] == 46 { return invalid_open() }
    if tail_len == 2 && relative[seg_start] == 46 && relative[seg_start + 1] == 46 {
        return invalid_open()
    }
    var prefix := dir.root
    if prefix[prefix.len - 1] != 47 { prefix += "/" }
    OpenFileResult { ok: true, file: ReadFile { path: prefix + relative }, error: 0 }
}

pub fn read(file: &ReadFile) -> sys.TextResult { sys.read_text(file.path) }
pub fn read_bytes(file: &ReadFile) -> sys.BytesResult { sys.read_u8(file.path) }
pub fn read_bytes_limit(file: &ReadFile, max_bytes: i64) -> sys.BytesResult { sys.read_u8_limit(file.path, max_bytes) }
pub fn read_bytes_into(file: &ReadFile, out: &mut []u8, max_bytes: i64) -> sys.Status { sys.read_u8_into(file.path, &mut out, max_bytes) }
pub fn metadata(file: &ReadFile) -> sys.Metadata { sys.metadata(file.path) }
pub fn write(file: &WriteFile, text: string) -> sys.Status { sys.write_text(file.path, text) }
pub fn append(file: &WriteFile, text: string) -> sys.Status { sys.append_text(file.path, text) }
pub fn write_bytes(file: &WriteFile, bytes: &[]u8) -> sys.Status { sys.write_u8(file.path, &bytes) }

fn c_path(path: string, out: &mut []u8) -> i32 {
    out.clear()
    if path.len == 0 { return 22 }
    if path.len > 1023 { return 63 }
    out.reserve(path.len + 1)
    for b in path.bytes() {
        if b == 0 { out.clear(); return 22 }
        out.push(u8(b))
    }
    out.push(0)
    0
}

fn portable_errno(raw: i32, is_darwin: bool) -> i32 {
    if raw <= 0 { return 5 }
    if is_darwin { return raw }
    if raw == 1 || raw == 2 || raw == 4 || raw == 5 || raw == 9 || raw == 12 ||
       raw == 13 || raw == 17 || raw == 20 || raw == 21 || raw == 22 ||
       raw == 27 || raw == 28 || raw == 30 || raw == 32 { return raw }
    if raw == 11 { return 35 }
    if raw == 36 { return 63 }
    if raw == 39 { return 66 }
    if raw == 84 { return 92 }
    if raw == 95 { return 45 }
    if raw == 98 { return 48 }
    if raw == 103 { return 53 }
    if raw == 104 { return 54 }
    if raw == 110 { return 60 }
    if raw == 111 { return 61 }
    if raw == 115 { return 36 }
    10000 + raw
}

unsafe fn host_is_darwin() -> i32 {
    _ := static_bytes("native", 16)
    var uts: [u64; 256] = [0; 256]
    if c_uname(addr(&mut uts[0])) != 0 { return -1 }
    os := load_u8(addr(&uts[0]))
    if os == 68 { return 1 }
    if os == 76 { return 0 }
    -1
}

unsafe fn read_errno() -> i32 {
    _ := static_bytes("native", 16)
    darwin := host_is_darwin()
    if darwin < 0 { return 45 }
    var sym_name := cstr("__errno_location")
    if darwin == 1 { sym_name = cstr("__error") }
    h := dl.open(ptr(0), 2)
    if usize(h) == 0 { return 5 }
    sym := dl.symbol(h, sym_name)
    if usize(sym) == 0 { _ := dl.close(h); return 5 }
    loc_fn: extern fn() -> ptr = ffi_fn(sym)
    ep := loc_fn()
    raw := load_i32(ep)
    _ := dl.close(h)
    portable_errno(raw, darwin == 1)
}

unsafe fn decode_cstr(p: ptr) -> sys.TextResult {
    if usize(p) == 0 { return sys.TextResult { ok: false, value: "", error: 22 } }
    var out: []u8 = []
    var i: usize = 0
    while i < 4096 {
        b := load_u8(ptr(usize(p) + i))
        if b == 0 { return bytes.decode(&out) }
        out.push(b)
        i = i + 1
    }
    sys.TextResult { ok: false, value: "", error: 63 }
}

@requires(filesystem)
pub fn cwd() -> sys.TextResult {
    unsafe {
        _ := static_bytes("native", 16)
        var buf: [u8; 4096] = [0; 4096]
        p := c_getcwd(addr(&mut buf[0]), 4096)
        if usize(p) == 0 {
            return sys.TextResult { ok: false, value: "", error: read_errno() }
        }
        return decode_cstr(p)
    }
    sys.TextResult { ok: false, value: "", error: 45 }
}

@requires(filesystem)
pub fn realpath(path: string) -> sys.TextResult {
    var raw: []u8 = []
    perr := c_path(path, &mut raw)
    if perr != 0 { return sys.TextResult { ok: false, value: "", error: perr } }
    unsafe {
        _ := static_bytes("native", 16)
        var buf: [u8; 4096] = [0; 4096]
        p := c_realpath(addr(&raw[0]), addr(&mut buf[0]))
        if usize(p) == 0 {
            return sys.TextResult { ok: false, value: "", error: read_errno() }
        }
        return decode_cstr(p)
    }
    sys.TextResult { ok: false, value: "", error: 45 }
}

@requires(filesystem)
pub fn is_symlink(path: string) -> bool {
    var raw: []u8 = []
    if c_path(path, &mut raw) != 0 { return false }
    var scratch: u8 = 0
    unsafe {
        _ := static_bytes("native", 16)
        return c_readlink(addr(&raw[0]), addr(&mut scratch), 1) >= 0
    }
    false
}

@requires(filesystem)
pub fn symlink(target: string, link_path: string) -> sys.Status {
    var raw_target: []u8 = []
    var raw_link: []u8 = []
    e1 := c_path(target, &mut raw_target)
    if e1 != 0 { return sys.Status { ok: false, error: e1 } }
    e2 := c_path(link_path, &mut raw_link)
    if e2 != 0 { return sys.Status { ok: false, error: e2 } }
    unsafe {
        _ := static_bytes("native", 16)
        if c_symlink(addr(&raw_target[0]), addr(&raw_link[0])) == 0 {
            return sys.Status { ok: true, error: 0 }
        }
        return sys.Status { ok: false, error: read_errno() }
    }
    sys.Status { ok: false, error: 45 }
}

@requires(filesystem)
pub fn hard_link(existing: string, link_path: string) -> sys.Status {
    var raw_existing: []u8 = []
    var raw_link: []u8 = []
    e1 := c_path(existing, &mut raw_existing)
    if e1 != 0 { return sys.Status { ok: false, error: e1 } }
    e2 := c_path(link_path, &mut raw_link)
    if e2 != 0 { return sys.Status { ok: false, error: e2 } }
    unsafe {
        _ := static_bytes("native", 16)
        if c_link(addr(&raw_existing[0]), addr(&raw_link[0])) == 0 {
            return sys.Status { ok: true, error: 0 }
        }
        return sys.Status { ok: false, error: read_errno() }
    }
    sys.Status { ok: false, error: 45 }
}

@requires(filesystem)
pub fn mkdir_all(path: string) -> sys.Status {
    if path.len == 0 { return sys.Status { ok: false, error: 22 } }
    if path.len > 1023 { return sys.Status { ok: false, error: 63 } }
    for b in path.bytes() { if b == 0 { return sys.Status { ok: false, error: 22 } } }
    info := sys.metadata(path)
    if info.ok {
        if info.is_dir { return sys.Status { ok: true, error: 0 } }
        return sys.Status { ok: false, error: 17 }
    }
    var i := 0
    if path[0] == 47 { i = 1 }
    while i <= path.len {
        if i == path.len || path[i] == 47 {
            if i > 0 {
                prefix := path[0..i]
                if prefix != "." && prefix != ".." {
                    pinfo := sys.metadata(prefix)
                    if !pinfo.ok {
                        st := sys.mkdir(prefix)
                        if !st.ok && st.error != 17 { return st }
                        check := sys.metadata(prefix)
                        if !check.ok || !check.is_dir {
                            return sys.Status { ok: false, error: 17 }
                        }
                    } else if !pinfo.is_dir {
                        return sys.Status { ok: false, error: 20 }
                    }
                }
            }
        }
        i = i + 1
    }
    sys.Status { ok: true, error: 0 }
}

@requires(filesystem)
pub fn temp_dir(prefix: string) -> sys.TextResult {
    for b in prefix.bytes() {
        if b == 0 || b == 47 {
            return sys.TextResult { ok: false, value: "", error: 22 }
        }
    }
    unsafe {
        _ := static_bytes("native", 16)
        var base := "/tmp"
        env_p := c_getenv(cstr("TMPDIR"))
        if usize(env_p) != 0 {
            dec := decode_cstr(env_p)
            if dec.ok && dec.value.len > 0 && dec.value.len < 900 {
                base = dec.value
            }
        }
        while base.len > 1 && base[base.len - 1] == 47 {
            base = base[0..base.len - 1]
        }
        full := base + "/" + prefix + "XXXXXX"
        var tmpl: []u8 = []
        perr := c_path(full, &mut tmpl)
        if perr != 0 { return sys.TextResult { ok: false, value: "", error: perr } }
        created := c_mkdtemp(addr(&mut tmpl[0]))
        if usize(created) == 0 {
            return sys.TextResult { ok: false, value: "", error: read_errno() }
        }
        return bytes.decode_range(&tmpl, 0, tmpl.len - 1)
    }
    sys.TextResult { ok: false, value: "", error: 45 }
}

fn list_dir_internal(path: string) -> DirEntriesResult {
    var raw: []u8 = []
    perr := c_path(path, &mut raw)
    if perr != 0 { return DirEntriesResult { ok: false, entries: [], error: perr } }
    var names: []string = []
    unsafe {
        _ := static_bytes("native", 16)
        darwin := host_is_darwin()
        if darwin < 0 { return DirEntriesResult { ok: false, entries: [], error: 45 } }
        var name_at := 19
        var errno_sym := cstr("__errno_location")
        if darwin == 1 { name_at = 21; errno_sym = cstr("__error") }
        h := dl.open(ptr(0), 2)
        if usize(h) == 0 { return DirEntriesResult { ok: false, entries: [], error: 5 } }
        sym := dl.symbol(h, errno_sym)
        if usize(sym) == 0 { _ := dl.close(h); return DirEntriesResult { ok: false, entries: [], error: 5 } }
        errno_fn: extern fn() -> ptr = ffi_fn(sym)
        errno_ptr := errno_fn()
        _ := dl.close(h)

        dir := c_opendir(addr(&raw[0]))
        if usize(dir) == 0 {
            err := portable_errno(load_i32(errno_ptr), darwin == 1)
            return DirEntriesResult { ok: false, entries: [], error: err }
        }
        var raw_name: []u8 = []
        var read_err := 0
        while true {
            store_i32(errno_ptr, 0)
            entry := c_readdir(dir)
            if usize(entry) == 0 {
                e := load_i32(errno_ptr)
                if e != 0 { read_err = portable_errno(e, darwin == 1) }
                break
            }
            rec_len := i32(load_u16(ptr(usize(entry) + 16)))
            raw_name.clear()
            for off in name_at..rec_len {
                b := load_u8(ptr(usize(entry) + usize(off)))
                if b == 0 { break }
                raw_name.push(b)
            }
            dec := bytes.decode(&raw_name)
            if !dec.ok { read_err = 92; break }
            if dec.value != "" && dec.value != "." && dec.value != ".." {
                names.push(dec.value)
            }
        }
        closed := c_closedir(dir)
        if read_err != 0 { return DirEntriesResult { ok: false, entries: [], error: read_err } }
        if closed != 0 {
            return DirEntriesResult { ok: false, entries: [], error: portable_errno(load_i32(errno_ptr), darwin == 1) }
        }
    }
    array.sort_strings(&mut names)
    DirEntriesResult { ok: true, entries: names, error: 0 }
}

@requires(filesystem)
pub fn list_dir(path: string) -> DirEntriesResult { list_dir_internal(path) }

pub fn list_read_dir(dir: &ReadDir) -> DirEntriesResult {
    if dir.root.len == 0 { return DirEntriesResult { ok: false, entries: [], error: 22 } }
    list_dir_internal(dir.root)
}

@requires(filesystem)
pub fn remove_all(path: string) -> sys.Status {
    if path.len == 0 || path == "/" || path == "." || path == ".." {
        return sys.Status { ok: false, error: 22 }
    }
    if is_symlink(path) {
        return sys.remove_file(path)
    }
    info := sys.metadata(path)
    if !info.ok {
        if info.error == 2 { return sys.Status { ok: true, error: 0 } }
        return sys.Status { ok: false, error: info.error }
    }
    if !info.is_dir {
        return sys.remove_file(path)
    }
    listing := list_dir(path)
    if !listing.ok { return sys.Status { ok: false, error: listing.error } }
    var prefix := path
    if prefix[prefix.len - 1] != 47 { prefix += "/" }
    for item in listing.entries {
        st := remove_all(prefix + item)
        if !st.ok { return st }
    }
    sys.remove_dir(path)
}
