import std.bytes as bytes
import std.parse as parse

pub enum Kind {
    Invalid = 0,
    Null = 1,
    Bool = 2,
    Number = 3,
    String = 4,
    Array = 5,
    Object = 6,
}

pub struct Doc {
    ok: bool,
    error: string,
    offset: i32,
    root: i32,
    input: []u8,
    kinds: []u8,
    starts: []i32,
    ends: []i32,
    escaped: []bool,
    first_child: []i32,
    next_sibling: []i32,
    key_starts: []i32,
    key_ends: []i32,
    key_escaped: []bool,
    counts: []i32,
}

pub struct JsonError {
    message: string,
    offset: i32,
}

impl JsonError {
    pub fn new(message: string, offset: i32) -> Self {
        Self { message: message.clone(), offset: offset }
    }
}

impl Display for JsonError {
    fn str(&self) -> string {
        if self.offset >= 0 {
            return self.message + " at byte " + self.offset.str()
        }
        self.message.clone()
    }
}

impl Eq for JsonError {
    fn eq(&self, other: &Self) -> bool {
        self.offset == other.offset && self.message == other.message
    }
}

pub fn write_str(out: &mut []u8, value: string) {
    hex := "0123456789abcdef"
    out.reserve(out.len + value.len + 2)
    out.push(b'"')
    for b in value.bytes() {
        if b == 34 { out.push(b'\\'); out.push(b'"') }
        else if b == 92 { out.push(b'\\'); out.push(b'\\') }
        else if b == 8 { out.push(b'\\'); out.push(b'b') }
        else if b == 12 { out.push(b'\\'); out.push(b'f') }
        else if b == 10 { out.push(b'\\'); out.push(b'n') }
        else if b == 13 { out.push(b'\\'); out.push(b'r') }
        else if b == 9 { out.push(b'\\'); out.push(b't') }
        else if b < 32 {
            bytes.append_utf8(&mut out, "\\u00")
            out.push(u8(hex[b / 16]))
            out.push(u8(hex[b % 16]))
        } else {
            out.push(u8(b))
        }
    }
    out.push(b'"')
}

pub fn quote(value: string) -> string {
    mut out: []u8 = []
    write_str(&mut out, value)
    bytes.decode(&out).value
}

pub fn write_i64(out: &mut []u8, value: i64) { bytes.append_decimal(&mut out, value) }

pub fn write_u64(out: &mut []u8, value: u64) {
    if value == 0 { out.push(b'0'); return }
    start := out.len
    mut v := value
    while v > 0 {
        d := i32(v % 10)
        out.push(u8(48 + d))
        v /= 10
    }
    mut left := start
    mut right := out.len - 1
    while left < right {
        out.swap(left, right)
        left += 1
        right -= 1
    }
}

pub fn write_bool(out: &mut []u8, value: bool) {
    if value { bytes.append_utf8(&mut out, "true") }
    else { bytes.append_utf8(&mut out, "false") }
}

pub fn write_f64(out: &mut []u8, value: f64) -> bool {
    if !value.is_finite() { return false }
    bytes.append_utf8(&mut out, value.str())
    true
}

pub fn write_null(out: &mut []u8) { bytes.append_utf8(&mut out, "null") }

fn sep_key(out: &mut []u8, first: &mut bool, key: string) {
    if !first { out.push(b',') }
    first = false
    write_str(&mut out, key)
    out.push(b':')
}

pub fn sep_elem(out: &mut []u8, first: &mut bool) {
    if !first { out.push(b',') }
    first = false
}

pub fn begin_obj(out: &mut []u8) -> bool { out.push(b'{'); true }
pub fn end_obj(out: &mut []u8) { out.push(b'}') }
pub fn begin_arr(out: &mut []u8) -> bool { out.push(b'['); true }
pub fn end_arr(out: &mut []u8) { out.push(b']') }

pub fn field_str(out: &mut []u8, first: &mut bool, key: string, value: string) {
    sep_key(&mut out, &mut first, key); write_str(&mut out, value)
}
pub fn field_i64(out: &mut []u8, first: &mut bool, key: string, value: i64) {
    sep_key(&mut out, &mut first, key); write_i64(&mut out, value)
}
pub fn field_i32(out: &mut []u8, first: &mut bool, key: string, value: i32) {
    sep_key(&mut out, &mut first, key); write_i64(&mut out, i64(value))
}
pub fn field_u64(out: &mut []u8, first: &mut bool, key: string, value: u64) {
    sep_key(&mut out, &mut first, key); write_u64(&mut out, value)
}
pub fn field_f64(out: &mut []u8, first: &mut bool, key: string, value: f64) -> bool {
    if !value.is_finite() { return false }
    sep_key(&mut out, &mut first, key)
    write_f64(&mut out, value)
}
pub fn field_bool(out: &mut []u8, first: &mut bool, key: string, value: bool) {
    sep_key(&mut out, &mut first, key); write_bool(&mut out, value)
}
pub fn field_null(out: &mut []u8, first: &mut bool, key: string) {
    sep_key(&mut out, &mut first, key); write_null(&mut out)
}
pub fn begin_field_obj(out: &mut []u8, first: &mut bool, key: string) -> bool {
    sep_key(&mut out, &mut first, key); begin_obj(&mut out)
}
pub fn begin_field_arr(out: &mut []u8, first: &mut bool, key: string) -> bool {
    sep_key(&mut out, &mut first, key); begin_arr(&mut out)
}

pub fn finish_text(out: &[]u8) -> string { bytes.decode(&out).value }

enum WriteState { Root, Done, ArrayFirst, ArrayMore, ObjectFirst, ObjectMore, ObjectValue }

pub struct Writer {
    output: []u8,
    stack: []WriteState,
    failed: bool,
    error: string,
}

impl Writer {
    pub fn new() -> Self { Self { output: [], stack: [.Root], failed: false, error: "" } }

    fn fail(&mut self, message: string) {
        if !self.failed {
            self.failed = true
            self.error = message.clone()
        }
    }

    fn start_value(&mut self) -> bool {
        if self.failed { return false }
        top := self.stack.len - 1
        state := self.stack[top]
        match state {
            .Root => { self.stack[top] = .Done },
            .ArrayFirst => { self.stack[top] = .ArrayMore },
            .ArrayMore => { self.output.push(b',') },
            .ObjectValue => { self.stack[top] = .ObjectMore },
            _ => { self.fail("unexpected JSON value position"); return false },
        }
        true
    }

    pub fn object(&mut self) {
        if !self.start_value() { return }
        self.output.push(b'{')
        self.stack.push(.ObjectFirst)
    }

    pub fn array(&mut self) {
        if !self.start_value() { return }
        self.output.push(b'[')
        self.stack.push(.ArrayFirst)
    }

    pub fn key(&mut self, name: string) {
        if self.failed { return }
        top := self.stack.len - 1
        state := self.stack[top]
        if state == .ObjectMore {
            self.output.push(b',')
        } else if state != .ObjectFirst {
            self.fail("unexpected JSON object key")
            return
        }
        write_str(&mut self.output, name)
        self.output.push(b':')
        self.stack[top] = .ObjectValue
    }

    pub fn end(&mut self) {
        if self.failed { return }
        state := self.stack[self.stack.len - 1]
        if state == .ObjectFirst || state == .ObjectMore {
            self.output.push(b'}')
        } else if state == .ArrayFirst || state == .ArrayMore {
            self.output.push(b']')
        } else {
            self.fail("unexpected JSON container end")
            return
        }
        _ := self.stack.pop()
    }

    pub fn string(&mut self, value: string) {
        if self.start_value() { write_str(&mut self.output, value) }
    }

    pub fn integer(&mut self, value: i64) {
        if self.start_value() { write_i64(&mut self.output, value) }
    }

    pub fn unsigned(&mut self, value: u64) {
        if self.start_value() { write_u64(&mut self.output, value) }
    }

    pub fn decimal(&mut self, value: f64) {
        if self.start_value() && !write_f64(&mut self.output, value) {
            self.fail("non-finite float cannot be encoded as JSON")
        }
    }

    pub fn boolean(&mut self, value: bool) {
        if self.start_value() { write_bool(&mut self.output, value) }
    }

    pub fn null(&mut self) {
        if self.start_value() { write_null(&mut self.output) }
    }

    pub fn finish(&self) -> Result<string, JsonError> {
        if self.failed {
            msg := if self.error != "" { self.error.clone() } else { "invalid JSON writer state" }
            return .Err(JsonError::new(msg, -1))
        }
        if self.stack.len != 1 || self.stack[0] != .Done {
            return .Err(JsonError::new("incomplete JSON value", -1))
        }
        .Ok(finish_text(&self.output))
    }

    pub fn finish_bytes(&self) -> Result<[]u8, JsonError> {
        if self.failed {
            msg := if self.error != "" { self.error.clone() } else { "invalid JSON writer state" }
            return .Err(JsonError::new(msg, -1))
        }
        if self.stack.len != 1 || self.stack[0] != .Done {
            return .Err(JsonError::new("incomplete JSON value", -1))
        }
        .Ok(self.output.clone())
    }
}

impl Default for Writer {
    fn default() -> Self { Writer::new() }
}

impl Eq for Kind {
    fn eq(&self, other: &Self) -> bool { self == other }
}

impl Display for Kind {
    fn str(&self) -> string {
        match self {
            .Invalid => "Invalid",
            .Null => "Null",
            .Bool => "Bool",
            .Number => "Number",
            .String => "String",
            .Array => "Array",
            .Object => "Object",
        }
    }
}

pub trait Encode {
    fn encode_json(&self, out: &mut Writer)
}

impl Encode for bool {
    fn encode_json(&self, out: &mut Writer) { out.boolean(self) }
}
impl Encode for i32 {
    fn encode_json(&self, out: &mut Writer) { out.integer(i64(self)) }
}
impl Encode for i64 {
    fn encode_json(&self, out: &mut Writer) { out.integer(self) }
}
impl Encode for u8 {
    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }
}
impl Encode for u16 {
    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }
}
impl Encode for u32 {
    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }
}
impl Encode for u64 {
    fn encode_json(&self, out: &mut Writer) { out.unsigned(self) }
}
impl Encode for usize {
    fn encode_json(&self, out: &mut Writer) { out.unsigned(u64(self)) }
}
impl Encode for f32 {
    fn encode_json(&self, out: &mut Writer) { out.decimal(f64(self)) }
}
impl Encode for f64 {
    fn encode_json(&self, out: &mut Writer) { out.decimal(self) }
}
impl Encode for string {
    fn encode_json(&self, out: &mut Writer) { out.string(self) }
}
impl Encode for []T where T: Encode {
    fn encode_json(&self, out: &mut Writer) {
        out.array()
        for i in 0..self.len { self[i].encode_json(&mut out) }
        out.end()
    }
}
impl Encode for Option<T> where T: Encode {
    fn encode_json(&self, out: &mut Writer) {
        match self {
            .Some(v) => v.encode_json(&mut out),
            .None => out.null(),
        }
    }
}

pub fn encode<T: Encode + Storable>(w: &mut Writer, value: &T) {
    value.encode_json(&mut w)
}

pub fn field_value<T: Encode + Storable>(w: &mut Writer, name: string, value: &T) {
    w.key(name)
    value.encode_json(&mut w)
}

pub fn to_string<T: Encode + Storable>(value: &T) -> Result<string, JsonError> {
    mut w := Writer::new()
    value.encode_json(&mut w)
    w.finish()
}

pub fn to_bytes<T: Encode + Storable>(value: &T) -> Result<[]u8, JsonError> {
    mut w := Writer::new()
    value.encode_json(&mut w)
    w.finish_bytes()
}

struct Parser {
    pos: i32,
    depth: i32,
}

fn is_ws(b: u8) -> bool {
    b == b' ' || b == b'\t' || b == b'\n' || b == b'\r'
}

fn skip_ws(input: &[]u8, p: &mut Parser) {
    while p.pos < input.len && is_ws(input[p.pos]) {
        p.pos += 1
    }
}

fn fail_doc(doc: &mut Doc, at: i32, move msg: string) {
    if doc.ok {
        doc.ok = false
        doc.offset = at
        doc.error = msg
    }
}

fn hex_val(b: u8) -> i32 {
    if b >= b'0' && b <= b'9' { return i32(b - b'0') }
    if b >= b'a' && b <= b'f' { return i32(b - b'a') + 10 }
    if b >= b'A' && b <= b'F' { return i32(b - b'A') + 10 }
    -1
}

fn alloc_node(doc: &mut Doc, kind: u8, start: i32, end: i32, esc: bool) -> i32 {
    id := doc.kinds.len
    doc.kinds.push(kind)
    doc.starts.push(start)
    doc.ends.push(end)
    doc.escaped.push(esc)
    doc.first_child.push(-1)
    doc.next_sibling.push(-1)
    doc.key_starts.push(0)
    doc.key_ends.push(0)
    doc.key_escaped.push(false)
    doc.counts.push(0)
    id
}

struct StrSpan { ok: bool, start: i32, end: i32, escaped: bool }

fn scan_string(doc: &mut Doc, p: &mut Parser) -> StrSpan {
    if p.pos >= doc.input.len || doc.input[p.pos] != b'"' {
        fail_doc(&mut doc, p.pos, "expected '\"'")
        return StrSpan { ok: false, start: 0, end: 0, escaped: false }
    }
    p.pos += 1
    start := p.pos
    mut has_esc := false
    while p.pos < doc.input.len {
        b := doc.input[p.pos]
        if b == b'"' {
            end := p.pos
            p.pos += 1
            return StrSpan { ok: true, start: start, end: end, escaped: has_esc }
        }
        if b < 32 {
            fail_doc(&mut doc, p.pos, "unescaped control character in JSON string")
            return StrSpan { ok: false, start: 0, end: 0, escaped: false }
        }
        if b == b'\\' {
            has_esc = true
            p.pos += 1
            if p.pos >= doc.input.len {
                fail_doc(&mut doc, p.pos, "unterminated escape sequence")
                return StrSpan { ok: false, start: 0, end: 0, escaped: false }
            }
            esc := doc.input[p.pos]
            if esc == b'"' || esc == b'\\' || esc == b'/' || esc == b'b' ||
               esc == b'f' || esc == b'n' || esc == b'r' || esc == b't' {
                p.pos += 1
            } else if esc == b'u' {
                if p.pos + 4 >= doc.input.len {
                    fail_doc(&mut doc, p.pos, "incomplete \\uXXXX escape")
                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }
                }
                mut cp := 0
                for k in 1..5 {
                    hv := hex_val(doc.input[p.pos + k])
                    if hv < 0 {
                        fail_doc(&mut doc, p.pos + k, "invalid hex digit in \\uXXXX escape")
                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }
                    }
                    cp = cp * 16 + hv
                }
                p.pos += 5
                if cp >= 0xD800 && cp <= 0xDBFF {
                    if p.pos + 5 >= doc.input.len || doc.input[p.pos] != b'\\' || doc.input[p.pos + 1] != b'u' {
                        fail_doc(&mut doc, p.pos, "missing low surrogate in UTF-16 pair")
                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }
                    }
                    mut low := 0
                    for k in 2..6 {
                        hv := hex_val(doc.input[p.pos + k])
                        if hv < 0 {
                            fail_doc(&mut doc, p.pos + k, "invalid hex digit in low surrogate")
                            return StrSpan { ok: false, start: 0, end: 0, escaped: false }
                        }
                        low = low * 16 + hv
                    }
                    if low < 0xDC00 || low > 0xDFFF {
                        fail_doc(&mut doc, p.pos, "invalid low surrogate range")
                        return StrSpan { ok: false, start: 0, end: 0, escaped: false }
                    }
                    p.pos += 6
                } else if cp >= 0xDC00 && cp <= 0xDFFF {
                    fail_doc(&mut doc, p.pos - 5, "lone low surrogate")
                    return StrSpan { ok: false, start: 0, end: 0, escaped: false }
                }
            } else {
                fail_doc(&mut doc, p.pos, "invalid escape character")
                return StrSpan { ok: false, start: 0, end: 0, escaped: false }
            }
        } else {
            p.pos += 1
        }
    }
    fail_doc(&mut doc, p.pos, "unterminated JSON string")
    StrSpan { ok: false, start: 0, end: 0, escaped: false }
}

fn scan_number(doc: &mut Doc, p: &mut Parser) -> i32 {
    start := p.pos
    if p.pos < doc.input.len && doc.input[p.pos] == b'-' { p.pos += 1 }
    if p.pos >= doc.input.len {
        fail_doc(&mut doc, start, "invalid number")
        return -1
    }
    if doc.input[p.pos] == b'0' {
        p.pos += 1
        if p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {
            fail_doc(&mut doc, p.pos, "leading zero in JSON number")
            return -1
        }
    } else if doc.input[p.pos] >= b'1' && doc.input[p.pos] <= b'9' {
        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {
            p.pos += 1
        }
    } else {
        fail_doc(&mut doc, p.pos, "expected digit in JSON number")
        return -1
    }
    if p.pos < doc.input.len && doc.input[p.pos] == b'.' {
        p.pos += 1
        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {
            fail_doc(&mut doc, p.pos, "expected digit after decimal point")
            return -1
        }
        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {
            p.pos += 1
        }
    }
    if p.pos < doc.input.len && (doc.input[p.pos] == b'e' || doc.input[p.pos] == b'E') {
        p.pos += 1
        if p.pos < doc.input.len && (doc.input[p.pos] == b'+' || doc.input[p.pos] == b'-') {
            p.pos += 1
        }
        if p.pos >= doc.input.len || doc.input[p.pos] < b'0' || doc.input[p.pos] > b'9' {
            fail_doc(&mut doc, p.pos, "expected exponent digit")
            return -1
        }
        while p.pos < doc.input.len && doc.input[p.pos] >= b'0' && doc.input[p.pos] <= b'9' {
            p.pos += 1
        }
    }
    alloc_node(&mut doc, 3, start, p.pos, false)
}

fn scan_container(doc: &mut Doc, p: &mut Parser, object: bool) -> i32 {
    start := p.pos
    p.pos += 1
    mut kind: u8 = 5
    mut closing := b']'
    if object { kind = 6; closing = b'}' }
    node := alloc_node(&mut doc, kind, start, start, false)
    skip_ws(&doc.input, &mut p)
    if p.pos < doc.input.len && doc.input[p.pos] == closing {
        p.pos += 1
        doc.ends[node] = p.pos
        return node
    }
    p.depth += 1
    mut previous := -1
    mut count := 0
    while doc.ok {
        mut child := -1
        if object {
            skip_ws(&doc.input, &mut p)
            key := scan_string(&mut doc, &mut p)
            if !key.ok { break }
            if !bytes.decode_range(&doc.input, key.start, key.end).ok {
                fail_doc(&mut doc, key.start, "invalid UTF-8 in JSON key")
                break
            }
            skip_ws(&doc.input, &mut p)
            if p.pos >= doc.input.len || doc.input[p.pos] != b':' {
                fail_doc(&mut doc, p.pos, "expected ':' after object key")
                break
            }
            p.pos += 1
            child = scan_value(&mut doc, &mut p)
            if child < 0 || !doc.ok { break }
            doc.key_starts[child] = key.start
            doc.key_ends[child] = key.end
            doc.key_escaped[child] = key.escaped
        } else {
            child = scan_value(&mut doc, &mut p)
            if child < 0 || !doc.ok { break }
        }
        if previous < 0 { doc.first_child[node] = child }
        else { doc.next_sibling[previous] = child }
        previous = child
        count += 1
        skip_ws(&doc.input, &mut p)
        if p.pos < doc.input.len && doc.input[p.pos] == b',' {
            p.pos += 1
            continue
        }
        if p.pos < doc.input.len && doc.input[p.pos] == closing {
            p.pos += 1
            doc.ends[node] = p.pos
            doc.counts[node] = count
            p.depth -= 1
            return node
        }
        if object { fail_doc(&mut doc, p.pos, "expected ',' or '}' in JSON object") }
        else { fail_doc(&mut doc, p.pos, "expected ',' or ']' in JSON array") }
        break
    }
    p.depth -= 1
    -1
}

fn scan_value(doc: &mut Doc, p: &mut Parser) -> i32 {
    skip_ws(&doc.input, &mut p)
    if p.pos >= doc.input.len {
        fail_doc(&mut doc, p.pos, "unexpected end of JSON input")
        return -1
    }
    if p.depth >= 256 {
        fail_doc(&mut doc, p.pos, "JSON nesting depth exceeds 256")
        return -1
    }
    b := doc.input[p.pos]
    if b == b'"' {
        sp := scan_string(&mut doc, &mut p)
        if !sp.ok { return -1 }
        if !bytes.decode_range(&doc.input, sp.start, sp.end).ok {
            fail_doc(&mut doc, sp.start, "invalid UTF-8 in JSON string")
            return -1
        }
        return alloc_node(&mut doc, 4, sp.start, sp.end, sp.escaped)
    }
    if b == b'{' || b == b'[' { return scan_container(&mut doc, &mut p, b == b'{') }
    if b == b't' {
        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, "true") {
            node := alloc_node(&mut doc, 2, p.pos, p.pos + 4, false)
            p.pos += 4
            return node
        }
        fail_doc(&mut doc, p.pos, "invalid literal")
        return -1
    }
    if b == b'f' {
        if bytes.equals_text(&doc.input, p.pos, p.pos + 5, "false") {
            node := alloc_node(&mut doc, 2, p.pos, p.pos + 5, false)
            p.pos += 5
            return node
        }
        fail_doc(&mut doc, p.pos, "invalid literal")
        return -1
    }
    if b == b'n' {
        if bytes.equals_text(&doc.input, p.pos, p.pos + 4, "null") {
            node := alloc_node(&mut doc, 1, p.pos, p.pos + 4, false)
            p.pos += 4
            return node
        }
        fail_doc(&mut doc, p.pos, "invalid literal")
        return -1
    }
    if b == b'-' || (b >= b'0' && b <= b'9') {
        return scan_number(&mut doc, &mut p)
    }
    fail_doc(&mut doc, p.pos, "unexpected character in JSON")
    -1
}

fn push_codepoint_utf8(out: &mut []u8, cp: i32) {
    if cp <= 0x7F {
        out.push(u8(cp))
    } else if cp <= 0x7FF {
        out.push(u8(0xC0.bit_or(cp.shr(6))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    } else if cp <= 0xFFFF {
        out.push(u8(0xE0.bit_or(cp.shr(12))))
        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    } else {
        out.push(u8(0xF0.bit_or(cp.shr(18))))
        out.push(u8(0x80.bit_or(cp.shr(12).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    }
}

fn unescape_span(input: &[]u8, start: i32, end: i32, has_esc: bool) -> Option<string> {
    if !has_esc {
        dec := bytes.decode_range(&input, start, end)
        if dec.ok { return .Some(dec.value) }
        return .None
    }
    mut out: []u8 = []
    out.reserve(end - start)
    mut i := start
    while i < end {
        b := input[i]
        if b != b'\\' {
            out.push(b)
            i += 1
            continue
        }
        i += 1
        esc := input[i]
        if esc == b'"' { out.push(b'"'); i += 1 }
        else if esc == b'\\' { out.push(b'\\'); i += 1 }
        else if esc == b'/' { out.push(b'/'); i += 1 }
        else if esc == b'b' { out.push(8); i += 1 }
        else if esc == b'f' { out.push(12); i += 1 }
        else if esc == b'n' { out.push(10); i += 1 }
        else if esc == b'r' { out.push(13); i += 1 }
        else if esc == b't' { out.push(9); i += 1 }
        else if esc == b'u' {
            mut cp := 0
            for k in 1..5 { cp = cp * 16 + hex_val(input[i + k]) }
            i += 5
            if cp >= 0xD800 && cp <= 0xDBFF {
                mut low := 0
                for k in 2..6 { low = low * 16 + hex_val(input[i + k]) }
                i += 6
                cp = 0x10000 + (cp - 0xD800).shl(10) + (low - 0xDC00)
            }
            push_codepoint_utf8(&mut out, cp)
        } else {
            return .None
        }
    }
    dec := bytes.decode(&out)
    if dec.ok { .Some(dec.value) } else { .None }
}

impl Doc {
    pub fn parse_bytes(move input: []u8) -> Self {
        est := input.len / 8 + 8
        mut doc := Self {
            ok: true, error: "", offset: 0, root: -1,
            input: input, kinds: [], starts: [], ends: [], escaped: [],
            first_child: [], next_sibling: [], key_starts: [], key_ends: [], key_escaped: [], counts: [],
        }
        doc.kinds.reserve(est); doc.starts.reserve(est); doc.ends.reserve(est)
        mut p := Parser { pos: 0, depth: 0 }
        root := scan_value(&mut doc, &mut p)
        if !doc.ok { return doc }
        skip_ws(&doc.input, &mut p)
        if p.pos != doc.input.len {
            fail_doc(&mut doc, p.pos, "trailing characters after JSON value")
            return doc
        }
        doc.root = root
        doc
    }

    pub fn parse_text(text: string) -> Self {
        mut raw: []u8 = []
        bytes.append_utf8(&mut raw, text)
        Self::parse_bytes(move raw)
    }

    pub fn parse_utf8(move input: []u8) -> Result<Self, JsonError> {
        doc := Self::parse_bytes(move input)
        if !doc.ok { return .Err(JsonError::new(doc.error.clone(), doc.offset)) }
        .Ok(doc)
    }

    pub fn parse(text: string) -> Result<Self, JsonError> {
        doc := Self::parse_text(text)
        if !doc.ok { return .Err(JsonError::new(doc.error.clone(), doc.offset)) }
        .Ok(doc)
    }

    pub fn error_info(&self) -> Option<JsonError> {
        if self.ok { return .None }
        .Some(JsonError::new(self.error.clone(), self.offset))
    }

    pub fn node_offset(&self, node: i32) -> i32 {
        if self.ok && node >= 0 && node < self.starts.len { return self.starts[node] }
        self.offset
    }

    pub fn kind(&self, node: i32) -> Kind {
        if !self.ok || node < 0 || node >= self.kinds.len { return .Invalid }
        k := self.kinds[node]
        if k == 1 { return .Null }
        if k == 2 { return .Bool }
        if k == 3 { return .Number }
        if k == 4 { return .String }
        if k == 5 { return .Array }
        if k == 6 { return .Object }
        .Invalid
    }

    pub fn count(&self, node: i32) -> i32 {
        if !self.ok || node < 0 || node >= self.counts.len { return 0 }
        self.counts[node]
    }

    fn key_matches(&self, child: i32, key: string) -> bool {
        ks := self.key_starts[child]
        ke := self.key_ends[child]
        if !self.key_escaped[child] {
            return bytes.equals_text(&self.input, ks, ke, key)
        }
        match unescape_span(&self.input, ks, ke, true) {
            .Some(v) => v == key,
            .None => false,
        }
    }

    pub fn field(&self, obj: i32, key: string) -> i32 {
        if self.kind(obj) != .Object { return -1 }
        mut found := -1
        mut cur := self.first_child[obj]
        while cur >= 0 {
            if self.key_matches(cur, key) { found = cur }
            cur = self.next_sibling[cur]
        }
        found
    }

    pub fn at(&self, arr: i32, index: i32) -> i32 {
        if self.kind(arr) != .Array || index < 0 || index >= self.counts[arr] { return -1 }
        mut cur := self.first_child[arr]
        for _ in 0..index { cur = self.next_sibling[cur] }
        cur
    }

    pub fn key_at(&self, obj: i32, index: i32) -> Option<string> {
        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] {
            return .None
        }
        mut cur := self.first_child[obj]
        for _ in 0..index { cur = self.next_sibling[cur] }
        unescape_span(&self.input, self.key_starts[cur], self.key_ends[cur], self.key_escaped[cur])
    }

    pub fn val_at(&self, obj: i32, index: i32) -> i32 {
        if self.kind(obj) != .Object || index < 0 || index >= self.counts[obj] { return -1 }
        mut cur := self.first_child[obj]
        for _ in 0..index { cur = self.next_sibling[cur] }
        cur
    }

    pub fn as_bool(&self, node: i32) -> Option<bool> {
        if self.kind(node) != .Bool { return .None }
        .Some(self.input[self.starts[node]] == b't')
    }

    pub fn as_i64(&self, node: i32) -> Option<i64> {
        if self.kind(node) != .Number { return .None }
        parsed := parse.i64_range(bytes.decode_range(&self.input, self.starts[node], self.ends[node]).value, 0, self.ends[node] - self.starts[node])
        if parsed.ok { .Some(parsed.value) } else { .None }
    }

    pub fn as_u64(&self, node: i32) -> Option<u64> {
        if self.kind(node) != .Number { return .None }
        s := self.starts[node]; e := self.ends[node]
        if s < e && self.input[s] == b'-' { return .None }
        parsed := parse.u64_range(bytes.decode_range(&self.input, s, e).value, 0, e - s)
        if parsed.ok { .Some(parsed.value) } else { .None }
    }

    pub fn as_f64(&self, node: i32) -> Option<f64> {
        if self.kind(node) != .Number { return .None }
        parsed := parse.Float64::parse(self.raw_span(node))
        if parsed.ok { .Some(parsed.value) } else { .None }
    }

    pub fn as_str(&self, node: i32) -> Option<string> {
        if self.kind(node) != .String { return .None }
        unescape_span(&self.input, self.starts[node], self.ends[node], self.escaped[node])
    }

    pub fn raw_span(&self, node: i32) -> string {
        if !self.ok || node < 0 || node >= self.starts.len { return "" }
        bytes.decode_range(&self.input, self.starts[node], self.ends[node]).value
    }

    pub fn raw_json(&self, node: i32) -> string {
        if !self.ok || node < 0 || node >= self.starts.len { return "" }
        if self.kinds[node] == 4 {
            return bytes.decode_range(&self.input, self.starts[node] - 1, self.ends[node] + 1).value
        }
        bytes.decode_range(&self.input, self.starts[node], self.ends[node]).value
    }

    pub fn get_bool(&self, obj: i32, key: string) -> Option<bool> { self.as_bool(self.field(obj, key)) }
    pub fn get_i64(&self, obj: i32, key: string) -> Option<i64> { self.as_i64(self.field(obj, key)) }
    pub fn get_u64(&self, obj: i32, key: string) -> Option<u64> { self.as_u64(self.field(obj, key)) }
    pub fn get_f64(&self, obj: i32, key: string) -> Option<f64> { self.as_f64(self.field(obj, key)) }
    pub fn get_str(&self, obj: i32, key: string) -> Option<string> { self.as_str(self.field(obj, key)) }
}

pub trait Decode {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError>
}

impl Decode for bool {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        match doc.as_bool(node) {
            .Some(v) => .Ok(v),
            .None => .Err(JsonError::new("expected JSON boolean", doc.node_offset(node))),
        }
    }
}

impl Decode for i64 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON integer", doc.node_offset(node)))
        }
        match doc.as_i64(node) {
            .Some(v) => .Ok(v),
            .None => .Err(JsonError::new("invalid i64 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for i32 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON integer", doc.node_offset(node)))
        }
        match doc.as_i64(node) {
            .Some(v) => {
                if v < -2147483648 || v > 2147483647 {
                    return .Err(JsonError::new("i32 out of range", doc.node_offset(node)))
                }
                .Ok(i32(v))
            },
            .None => .Err(JsonError::new("invalid i32 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for u64 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON unsigned integer", doc.node_offset(node)))
        }
        match doc.as_u64(node) {
            .Some(v) => .Ok(v),
            .None => .Err(JsonError::new("invalid u64 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for u8 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON unsigned integer", doc.node_offset(node)))
        }
        match doc.as_u64(node) {
            .Some(v) => {
                if v > 255 {
                    return .Err(JsonError::new("u8 out of range", doc.node_offset(node)))
                }
                .Ok(u8(v))
            },
            .None => .Err(JsonError::new("invalid u8 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for u16 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON unsigned integer", doc.node_offset(node)))
        }
        match doc.as_u64(node) {
            .Some(v) => {
                if v > 65535 {
                    return .Err(JsonError::new("u16 out of range", doc.node_offset(node)))
                }
                .Ok(u16(v))
            },
            .None => .Err(JsonError::new("invalid u16 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for u32 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON unsigned integer", doc.node_offset(node)))
        }
        match doc.as_u64(node) {
            .Some(v) => {
                if v > 4294967295 {
                    return .Err(JsonError::new("u32 out of range", doc.node_offset(node)))
                }
                .Ok(u32(v))
            },
            .None => .Err(JsonError::new("invalid u32 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for usize {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON unsigned integer", doc.node_offset(node)))
        }
        match doc.as_u64(node) {
            .Some(v) => {
                casted := usize(v)
                if u64(casted) != v {
                    return .Err(JsonError::new("usize out of range", doc.node_offset(node)))
                }
                .Ok(casted)
            },
            .None => .Err(JsonError::new("invalid usize JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for f64 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON number", doc.node_offset(node)))
        }
        match doc.as_f64(node) {
            .Some(v) => .Ok(v),
            .None => .Err(JsonError::new("invalid f64 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for f32 {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Number {
            return .Err(JsonError::new("expected JSON number", doc.node_offset(node)))
        }
        match doc.as_f64(node) {
            .Some(v) => {
                f := f32(v)
                if !f.is_finite() {
                    return .Err(JsonError::new("f32 out of range", doc.node_offset(node)))
                }
                .Ok(f)
            },
            .None => .Err(JsonError::new("invalid f32 JSON number", doc.node_offset(node))),
        }
    }
}

impl Decode for string {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .String {
            return .Err(JsonError::new("expected JSON string", doc.node_offset(node)))
        }
        match doc.as_str(node) {
            .Some(v) => .Ok(v),
            .None => .Err(JsonError::new("invalid JSON string", doc.node_offset(node))),
        }
    }
}

impl Decode for []T where T: Decode {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if doc.kind(node) != .Array {
            return .Err(JsonError::new("expected JSON array", doc.node_offset(node)))
        }
        mut out: []T = []
        out.reserve(doc.count(node))
        mut cur := doc.first_child[node]
        while cur >= 0 {
            item := T::decode_json(&doc, cur)
            match move item {
                .Ok(v) => { out.push(move v) },
                .Err(e) => { return .Err(e) },
            }
            cur = doc.next_sibling[cur]
        }
        .Ok(out)
    }
}

impl Decode for Option<T> where T: Decode {
    fn decode_json(doc: &Doc, node: i32) -> Result<Self, JsonError> {
        if node < 0 || doc.kind(node) == .Null {
            return .Ok(.None)
        }
        match T::decode_json(&doc, node) {
            .Ok(v) => .Ok(.Some(v)),
            .Err(e) => .Err(e),
        }
    }
}

pub fn decode<T: Decode + Storable>(doc: &Doc, node: i32) -> Result<T, JsonError> {
    T::decode_json(&doc, node)
}

pub fn decode_field<T: Decode + Storable>(doc: &Doc, obj: i32, key: string) -> Result<T, JsonError> {
    if doc.kind(obj) != .Object {
        return .Err(JsonError::new("expected JSON object", doc.node_offset(obj)))
    }
    f := doc.field(obj, key)
    match T::decode_json(&doc, f) {
        .Ok(v) => .Ok(v),
        .Err(e) => {
            if f < 0 {
                return .Err(JsonError::new("missing field '" + key + "'", doc.node_offset(obj)))
            }
            .Err(e)
        }
    }
}

pub fn from_bytes<T: Decode + Storable>(move raw: []u8) -> Result<T, JsonError> {
    match Doc::parse_utf8(move raw) {
        .Ok(doc) => T::decode_json(&doc, doc.root),
        .Err(e) => .Err(e),
    }
}

pub fn from_str<T: Decode + Storable>(text: string) -> Result<T, JsonError> {
    match Doc::parse(text) {
        .Ok(doc) => T::decode_json(&doc, doc.root),
        .Err(e) => .Err(e),
    }
}

@test fn json_writer_manages_nesting_and_round_trips_numbers() {
    mut w := Writer::new()
    w.object()
    w.key("dir")
    w.array()
    w.decimal(-0.0)
    w.decimal(5e-324)
    w.decimal(1.7976931348623157e308)
    w.integer(-99)
    w.unsigned(18446744073709551615)
    w.null()
    w.boolean(true)
    w.object()
    w.end()
    w.end()
    w.key("name")
    w.string("quote \"🌍\"")
    w.end()
    encoded := w.finish()
    assert(encoded.is_ok())
    doc := Doc::parse_text(encoded.unwrap())
    assert(doc.ok)
    dir := doc.field(doc.root, "dir")
    assert(doc.count(dir) == 8)
    assert(doc.as_f64(doc.at(dir, 0)).unwrap().to_bits() == -9223372036854775808)
    assert(doc.as_f64(doc.at(dir, 1)).unwrap().to_bits() == 1)
    assert(doc.as_f64(doc.at(dir, 2)).unwrap().to_bits() == 0x7fefffffffffffff)
    assert(doc.as_f64(doc.at(dir, 3)).unwrap() == -99.0)
    assert(doc.as_u64(doc.at(dir, 4)).unwrap() == 18446744073709551615)
    assert(doc.as_f64(doc.at(dir, 5)).is_none())
    assert(doc.as_bool(doc.at(dir, 6)).unwrap())
    assert(doc.kind(doc.at(dir, 7)) == .Object)
    assert(doc.get_str(doc.root, "name").unwrap() == "quote \"🌍\"")

    numbers := Doc::parse_text("{\"negativeZero\":-0,\"tooLarge\":1e309,\"finite\":-12.5e-1}")
    assert(numbers.ok)
    assert(numbers.get_f64(numbers.root, "negativeZero").unwrap().is_sign_negative())
    assert(numbers.get_f64(numbers.root, "tooLarge").is_none())
    assert(numbers.get_f64(numbers.root, "missing").is_none())
    assert(numbers.get_f64(numbers.root, "finite").unwrap() == -1.25)
    assert(numbers.get_i64(numbers.root, "finite").is_none())
}

@test fn json_writer_rejects_invalid_sequences_and_nonfinite_values() {
    mut unfinished := Writer::new()
    assert(unfinished.finish().is_err())
    unfinished.object()
    unfinished.key("missing")
    assert(unfinished.finish().is_err())
    unfinished.end()
    unfinished.integer(1)
    assert(unfinished.finish().is_err())

    mut roots := Writer::new()
    roots.null()
    assert(roots.finish() == .Ok("null"))
    roots.null()
    assert(roots.finish().is_err())

    mut nonfinite := Writer::new()
    nonfinite.array()
    nonfinite.decimal(1.0 / 0.0)
    nonfinite.end()
    assert(nonfinite.finish().is_err())

    mut output: []u8 = []
    mut first := begin_obj(&mut output)
    assert(!field_f64(&mut output, &mut first, "nan", 0.0 / 0.0))
    assert(first && output.len == 1)
    assert(field_f64(&mut output, &mut first, "number", 1.25))
    end_obj(&mut output)
    assert(finish_text(&output) == "{\"number\":1.25}")
}

@test
fn json_doc_impl_methods_work() {
    doc := Doc::parse_text("{\"k\":\"v\",\"xs\":[1,2]}")
    assert(doc.ok)
    assert(doc.get_str(doc.root, "k") == .Some("v"))
    assert(doc.key_at(doc.root, 0) == .Some("k"))
    xs := doc.field(doc.root, "xs")
    assert(doc.count(xs) == 2)
    assert(doc.as_i64(doc.at(xs, 1)) == .Some(2))
}

@test
fn json_writer_and_zero_dom_parser_handle_nesting_unicode_and_errors() {
    mut out: []u8 = []
    mut first := begin_obj(&mut out)
    field_str(&mut out, &mut first, "kind", "runtime_profile")
    field_i32(&mut out, &mut first, "version", 1)
    field_bool(&mut out, &mut first, "ok", true)
    field_u64(&mut out, &mut first, "max_u64", 18446744073709551615)
    field_str(&mut out, &mut first, "msg", "rad1\n\"åäö\" 🌍")
    mut af := begin_field_arr(&mut out, &mut first, "items")
    sep_elem(&mut out, &mut af); write_i64(&mut out, -42)
    sep_elem(&mut out, &mut af); write_null(&mut out)
    end_arr(&mut out)
    end_obj(&mut out)

    doc := Doc::parse_bytes(out.clone())
    assert(doc.ok)
    assert(doc.get_str(doc.root, "kind") == .Some("runtime_profile"))
    assert(doc.get_i64(doc.root, "version") == .Some(1))
    assert(doc.get_bool(doc.root, "ok") == .Some(true))
    assert(doc.get_u64(doc.root, "max_u64") == .Some(18446744073709551615))
    assert(doc.get_str(doc.root, "msg") == .Some("rad1\n\"åäö\" 🌍"))
    items := doc.field(doc.root, "items")
    assert(doc.count(items) == 2)
    assert(doc.as_i64(doc.at(items, 0)) == .Some(-42))
    assert(doc.kind(doc.at(items, 1)) == .Null)
    out.clear()
    assert(doc.get_str(doc.root, "kind") == .Some("runtime_profile"))

    sur := Doc::parse_text("{\"a\":1,\"a\":2,\"globe\":\"\\uD83C\\uDF0D\"}")
    assert(sur.ok)
    assert(sur.get_i64(sur.root, "a") == .Some(2))
    assert(sur.get_str(sur.root, "globe") == .Some("🌍"))

    assert(Doc::parse("{\"a\":01}").is_err())
    assert(Doc::parse("{\"a\":1} trailing").is_err())
    assert(Doc::parse("\"\\uD800\"").is_err())

    mut w := Writer::default()
    w.object()
    field_value<i32>(&mut w, "count", 7)
    field_value<[]string>(&mut w, "tags", &["a", "b"])
    w.end()
    assert(w.finish() == .Ok("{\"count\":7,\"tags\":[\"a\",\"b\"]}"))
    assert(to_string<[]i32>(&[1, 2, 3]) == .Ok("[1,2,3]"))
    assert(Kind.Array.str() == "Array" && Kind.Null == Kind.Null)

    raw_doc := Doc::parse_text("{\"s\":\"a\\n\\\"å🌍\\\"\",\"n\":-12.50,\"b\":true,\"z\":null,\"a\":[1, 2],\"o\":{\"k\":1}}")
    assert(raw_doc.ok)
    s_node := raw_doc.field(raw_doc.root, "s")
    assert(raw_doc.raw_span(s_node) == "a\\n\\\"å🌍\\\"")
    assert(raw_doc.raw_json(s_node) == "\"a\\n\\\"å🌍\\\"\"")
    assert(Doc::parse_text(raw_doc.raw_json(s_node)).get_str(0, "").is_none() &&
        Doc::parse_text(raw_doc.raw_json(s_node)).as_str(0) == .Some("a\n\"å🌍\""))
    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, "n")) == "-12.50")
    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, "b")) == "true")
    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, "z")) == "null")
    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, "a")) == "[1, 2]")
    assert(raw_doc.raw_json(raw_doc.field(raw_doc.root, "o")) == "{\"k\":1}")
    assert(raw_doc.raw_json(-1) == "" && raw_doc.raw_span(-1) == "")
    mut bad_escaped: []u8 = [b'"', b'\\', b'n', 0xff, b'"']
    assert(Doc::parse_utf8(move bad_escaped).is_err())
}

@test
fn json_decode_primitives_arrays_and_options() {
    assert(from_str<bool>("true") == .Ok(true))
    assert(from_str<i32>("-42") == .Ok(-42))
    assert(from_str<u8>("255") == .Ok(u8(255)))
    assert(from_str<u8>("256").is_err())
    assert(from_str<u8>("-1").is_err())
    assert(from_str<i32>("3000000000").is_err())
    assert(from_str<string>("\"hello\\n\"") == .Ok("hello\n"))
    assert(from_str<[]i32>("[1,2,3]") == .Ok([1, 2, 3]))
    assert(from_str<Option<i32>>("null") == .Ok(.None))
    assert(from_str<Option<i32>>("9") == .Ok(.Some(9)))
    assert(from_str<Option<i32>>("{").is_err())
    opt_some: Option<i32> = .Some(5)
    opt_none: Option<i32> = .None
    assert(to_string<Option<i32>>(&opt_some) == .Ok("5"))
    assert(to_string<Option<i32>>(&opt_none) == .Ok("null"))
    raw: []u8 = [b'[', b'1', b',', b'2', b']']
    assert(from_bytes<[]i32>(move raw) == .Ok([1, 2]))
}
