fn c_string(value: string) -> []u8 {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, value)
    out.push(0)
    out
}

unsafe fn copy_text(value: ptr, length: i32) -> string {
    mut out: []u8 = []
    if length < 0 || (length > 0 && value == ptr(0)) { return "" }
    out.reserve(length)
    for i in 0..length { out.push(load_u8(ptr(usize(value) + usize(i)))) }
    decoded := bytes.decode(&out)
    // SQLite permits arbitrary bytes in TEXT. The JSON interface rejects them
    // before exposing a row instead of silently replacing invalid UTF-8.
    if !decoded.ok { return "" }
    decoded.value
}

unsafe fn copy_c_string(value: ptr) -> string {
    if value == ptr(0) { return "" }
    mut length := 0
    while length < 1048576 {
        if load_u8(ptr(usize(value) + usize(length))) == 0 { return copy_text(value, length) }
        length += 1
    }
    ""
}

unsafe fn failure(db: ptr) -> string {
    if db == ptr(0) { return "SQLite could not allocate a connection" }
    "SQLite: " + copy_c_string(sql_errmsg(db))
}

fn tail_empty(sql: string, start: i32) -> bool {
    mut i := start
    while i < sql.len {
        byte := sql[i]
        if byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 || byte == 32 || byte == 59 {
            i += 1
        } else if i + 1 < sql.len && byte == 45 && sql[i + 1] == 45 {
            i += 2
            while i < sql.len && sql[i] != 10 { i += 1 }
        } else if i + 1 < sql.len && byte == 47 && sql[i + 1] == 42 {
            i += 2
            while i + 1 < sql.len && !(sql[i] == 42 && sql[i + 1] == 47) { i += 1 }
            if i + 1 >= sql.len { return true }
            i += 2
        } else { return false }
    }
    true
}

// sqlite3_complete recognizes trigger bodies without preparing anything. Check
// each possible terminator before prepare: several PRAGMAs act at prepare time.
// Thus an invalid multi-statement request cannot change even pragma state.
unsafe fn single_statement(sql: string) -> bool {
    mut prefix: []u8 = []
    prefix.reserve(sql.len + 1)
    mut state := 0 // single/double/backtick/bracket quoting and SQL comments
    mut i := 0
    mut terminators := 0
    while i < sql.len {
        byte := sql[i]
        prefix.push(u8(byte))
        if state >= 1 && state <= 3 {
            mut quote := 39
            if state == 2 { quote = 34 }
            if state == 3 { quote = 96 }
            if byte == quote {
                if i + 1 < sql.len && sql[i + 1] == quote {
                    i += 1
                    prefix.push(u8(quote))
                } else { state = 0 }
            }
        } else if state == 4 {
            if byte == 93 { state = 0 }
        } else if state == 5 {
            if byte == 10 { state = 0 }
        } else if state == 6 {
            if byte == 42 && i + 1 < sql.len && sql[i + 1] == 47 {
                i += 1
                prefix.push(47)
                state = 0
            }
        } else if byte == 39 { state = 1 }
        else if byte == 34 { state = 2 }
        else if byte == 96 { state = 3 }
        else if byte == 91 { state = 4 }
        else if byte == 45 && i + 1 < sql.len && sql[i + 1] == 45 {
            state = 5
        } else if byte == 47 && i + 1 < sql.len && sql[i + 1] == 42 {
            state = 6
        } else if byte == 59 {
            terminators += 1
            if terminators > 256 { return false }
            prefix.push(0)
            complete := sql_complete(addr(&prefix[0]))
            _ := prefix.pop()
            if complete == 1 { return tail_empty(sql, i + 1) }
        }
        i += 1
    }
    true
}

unsafe fn prepare(db: ptr, sql: string, params: &[]string) -> Prepared {
    if db == ptr(0) { return Prepared { ok: false, statement: ptr(0), error: "SQLite connection is closed" } }
    if sql.len > 1048576 || params.len > 1024 {
        return Prepared { ok: false, statement: ptr(0), error: "SQLite statement or parameter count exceeds its limit" }
    }
    for byte in sql.bytes() {
        if byte == 0 { return Prepared { ok: false, statement: ptr(0), error: "SQLite statement contains NUL" } }
    }
    if !single_statement(sql) {
        return Prepared { ok: false, statement: ptr(0), error: "SQLite calls require one statement" }
    }
    raw := c_string(sql)
    mut statement := ptr(0)
    mut tail := ptr(0)
    code := sql_prepare_v2(db, addr(&raw[0]), raw.len, addr(&mut statement), addr(&mut tail))
    if code != 0 {
        message := failure(db)
        if statement != ptr(0) { _ := sql_finalize(statement) }
        return Prepared { ok: false, statement: ptr(0), error: message }
    }
    if tail != ptr(0) {
        start := usize(addr(&raw[0]))
        position := usize(tail)
        if position < start || position > start + usize(sql.len) {
            if statement != ptr(0) { _ := sql_finalize(statement) }
            return Prepared { ok: false, statement: ptr(0), error: "SQLite returned an invalid statement tail" }
        }
        if !tail_empty(sql, i32(position - start)) {
            if statement != ptr(0) { _ := sql_finalize(statement) }
            return Prepared { ok: false, statement: ptr(0), error: "SQLite calls require one statement" }
        }
    }
    mut expected := 0
    if statement != ptr(0) { expected = sql_bind_parameter_count(statement) }
    if expected != params.len {
        if statement != ptr(0) { _ := sql_finalize(statement) }
        return Prepared { ok: false, statement: ptr(0), error: "SQLite parameter count mismatch" }
    }
    for i in 0..params.len {
        if params[i].len > 16777216 {
            _ := sql_finalize(statement)
            return Prepared { ok: false, statement: ptr(0), error: "SQLite parameter exceeds its byte limit" }
        }
        parameter := c_string(params[i])
        // TRANSIENT copies immediately; even empty text has a non-null pointer.
        transient := ptr(18446744073709551615)
        bound := sql_bind_text(statement, i + 1, addr(&parameter[0]), parameter.len - 1, transient)
        if bound != 0 {
            message := failure(db)
            _ := sql_finalize(statement)
            return Prepared { ok: false, statement: ptr(0), error: message }
        }
    }
    Prepared { ok: true, statement: statement, error: "" }
}

impl Database {
    @requires(filesystem)
    pub fn open(path: string, read_only: bool) -> OpenResult {
        if path.len == 0 || path.len > 4096 {
            unsafe { return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: "invalid SQLite path" } }
        }
        for byte in path.bytes() {
            if byte == 0 {
                unsafe { return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: "SQLite path contains NUL" } }
            }
        }
        raw := c_string(path)
        unsafe {
            mut handle := ptr(0)
            mut flags := 65542 // READWRITE | CREATE | FULLMUTEX
            if read_only { flags = 65537 } // READONLY | FULLMUTEX
            code := sql_open_v2(addr(&raw[0]), addr(&mut handle), flags, ptr(0))
            if code != 0 {
                message := failure(handle)
                if handle != ptr(0) { _ := sql_close(handle) }
                return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: message }
            }
            if sql_busy_timeout(handle, 5000) != 0 {
                message := failure(handle)
                _ := sql_close(handle)
                return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: message }
            }
            db := Self { handle: handle }
            if read_only {
                empty: []string = []
                result := db.exec("PRAGMA query_only=ON", &empty)
                if !result.ok {
                    _ := sql_close(handle)
                    return OpenResult { ok: false, db: Self { handle: ptr(0) }, error: result.error }
                }
            }
            return OpenResult { ok: true, db: db, error: "" }
        }
        unsafe { OpenResult { ok: false, db: Self { handle: ptr(0) }, error: "SQLite requires a native target" } }
    }

    pub fn close(&mut self) -> CloseResult {
        unsafe {
            if self.handle == ptr(0) { return CloseResult { ok: true, error: "" } }
            code := sql_close(self.handle)
            if code != 0 { return CloseResult { ok: false, error: failure(self.handle) } }
            self.handle = ptr(0)
        }
        CloseResult { ok: true, error: "" }
    }

    pub fn exec(&self, sql: string, params: &[]string) -> ExecResult {
        unsafe {
            prepared := prepare(self.handle, sql, &params)
            if !prepared.ok { return ExecResult { ok: false, changes: 0, last_id: 0, error: prepared.error } }
            statement := prepared.statement
            if statement != ptr(0) {
                defer { _ := sql_finalize(statement) }
                mut step := sql_step(statement)
                while step == 100 { step = sql_step(statement) }
                if step != 101 { return ExecResult { ok: false, changes: 0, last_id: 0, error: failure(self.handle) } }
            }
            return ExecResult { ok: true, changes: sql_changes64(self.handle), last_id: sql_last_insert_rowid(self.handle), error: "" }
        }
        ExecResult { ok: false, changes: 0, last_id: 0, error: "SQLite requires a native target" }
    }

    // Rows are independent JSON objects. Integers retain all 64 bits, finite
    // doubles retain their value, and TEXT is decoded using its actual byte
    // count. BLOB is deliberately rejected; callers must explicitly hex it.
    pub fn query(&self, sql: string, params: &[]string) -> QueryResult {
        unsafe {
            prepared := prepare(self.handle, sql, &params)
            if !prepared.ok { return QueryResult { ok: false, rows: [], error: prepared.error } }
            statement := prepared.statement
            if statement == ptr(0) { return QueryResult { ok: true, rows: [], error: "" } }
            defer { _ := sql_finalize(statement) }
            if sql_stmt_readonly(statement) == 0 {
                return QueryResult { ok: false, rows: [], error: "SQLite query requires a read-only statement; use exec for writes" }
            }
            columns := sql_column_count(statement)
            mut rows: []string = []
            mut total: i64 = 0
            mut step := sql_step(statement)
            while step == 100 {
                if rows.len >= 10000 { return QueryResult { ok: false, rows: [], error: "SQLite query exceeds 10000 rows" } }
                mut output: []u8 = []
                output.push(b'{')
                for column in 0..columns {
                    if column > 0 { output.push(b',') }
                    name := copy_c_string(sql_column_name(statement, column))
                    json.write_str(&mut output, name)
                    output.push(b':')
                    kind := sql_column_type(statement, column)
                    if kind == 1 {
                        json.write_i64(&mut output, sql_column_int64(statement, column))
                    } else if kind == 2 {
                        value := sql_column_double(statement, column)
                        if !value.is_finite() { return QueryResult { ok: false, rows: [], error: "SQLite non-finite REAL cannot be represented as JSON" } }
                        spelling := value.str()
                        bytes.append_utf8(&mut output, spelling)
                        mut decimal := false
                        for byte in spelling.bytes() {
                            if byte == 46 || byte == 69 || byte == 101 { decimal = true }
                        }
                        if !decimal { bytes.append_utf8(&mut output, ".0") }
                    } else if kind == 3 {
                        pointer := sql_column_text(statement, column)
                        length := sql_column_bytes(statement, column)
                        if length < 0 || length > 16777216 || (length > 0 && pointer == ptr(0)) {
                            return QueryResult { ok: false, rows: [], error: "SQLite text exceeds its byte limit" }
                        }
                        mut raw: []u8 = []
                        raw.reserve(length)
                        for i in 0..length { raw.push(load_u8(ptr(usize(pointer) + usize(i)))) }
                        decoded := bytes.decode(&raw)
                        if !decoded.ok { return QueryResult { ok: false, rows: [], error: "SQLite TEXT contains invalid UTF-8" } }
                        json.write_str(&mut output, decoded.value)
                    } else if kind == 5 {
                        json.write_null(&mut output)
                    } else {
                        return QueryResult { ok: false, rows: [], error: "SQLite BLOB requires explicit encoding in the query" }
                    }
                }
                output.push(b'}')
                total += i64(output.len)
                if total > 67108864 { return QueryResult { ok: false, rows: [], error: "SQLite result exceeds 64 MiB" } }
                row := bytes.decode(&output).value
                rows.push(move row)
                step = sql_step(statement)
            }
            if step != 101 { return QueryResult { ok: false, rows: [], error: failure(self.handle) } }
            return QueryResult { ok: true, rows: rows, error: "" }
        }
        QueryResult { ok: false, rows: [], error: "SQLite requires a native target" }
    }
}
