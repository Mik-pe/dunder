capability filesystem, unsafe

// SQLite connections and prepared statements keep C ownership behind an opaque handle.
// SQL and parameters are UTF-8; text lengths always use SQLite byte counts, never strlen.
import std.bytes as bytes
import std.json as json

@resource
pub opaque struct Database { handle: ptr }
pub struct OpenResult { ok: bool, db: Database, error: string }
pub struct QueryResult { ok: bool, rows: []string, error: string }
pub struct ExecResult { ok: bool, changes: i64, last_id: i64, error: string }
pub struct CloseResult { ok: bool, error: string }

struct Prepared { ok: bool, statement: ptr, error: string }

@extern("/usr/lib/libsqlite3.dylib", "sqlite3_open_v2")
unsafe fn mac_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32
@extern("libsqlite3.so.0", "sqlite3_open_v2")
unsafe fn linux_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32
unsafe fn sql_open_v2(path: ptr, db: ptr, flags: i32, vfs: ptr) -> i32 {
    if target_is("macos") { return mac_open_v2(path, db, flags, vfs) }
    if target_is("linux") { return linux_open_v2(path, db, flags, vfs) }
    -1
}

