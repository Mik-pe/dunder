fn status_from_i64(raw: i64) -> sys.Status {
    if raw < 0 { return sys.Status { ok: false, error: i32(-raw) } }
    sys.Status { ok: true, error: 0 }
}

@thread_safe
fn fd_local_addr(fd: i32) -> Result<SocketAddr, sys.IoError> {
    if fd < 0 { return .Err(.BadDescriptor) }
    mut sa: [u8; 128] = [0; 128]
    mut len_buf: [u8; 4] = [128, 0, 0, 0]
    unsafe {
        rc := os_getsockname(fd, addr(&mut sa[0]), addr(&mut len_buf[0]))
        if rc < 0 { return .Err(sys.IoError::from_code(i32(-rc))) }
        return decode_sockaddr_ptr(addr(&sa[0]), load_u32(addr(&len_buf[0])))
    }
    .Err(.Unsupported)
}

@thread_safe
fn fd_peer_addr(fd: i32) -> Result<SocketAddr, sys.IoError> {
    if fd < 0 { return .Err(.BadDescriptor) }
    mut sa: [u8; 128] = [0; 128]
    mut len_buf: [u8; 4] = [128, 0, 0, 0]
    unsafe {
        rc := os_getpeername(fd, addr(&mut sa[0]), addr(&mut len_buf[0]))
        if rc < 0 { return .Err(sys.IoError::from_code(i32(-rc))) }
        return decode_sockaddr_ptr(addr(&sa[0]), load_u32(addr(&len_buf[0])))
    }
    .Err(.Unsupported)
}

@thread_safe
fn fd_set_timeout(fd: i32, read_dir: bool, timeout_ms: i64) -> sys.Status {
    if fd < 0 { return sys.Status { ok: false, error: 9 } }
    if timeout_ms < 0 { return sys.Status { ok: false, error: 22 } }
    mut rc: i64 = 0
    unsafe { rc = os_setsockopt_timeout(fd, read_dir, timeout_ms) }
    status_from_i64(rc)
}

fn fd_read_append(fd: i32, out: &mut []u8, max_bytes: i32, peek: bool) -> Result<i64, sys.IoError> {
    if max_bytes <= 0 { return .Ok(0) }
    out.reserve(out.len + max_bytes)
    n := if peek { sys.net_peek(fd, &mut out, i64(max_bytes)) } else { sys.net_read(fd, &mut out, i64(max_bytes)) }
    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
    .Ok(n)
}

fn fd_write_range(fd: i32, data: &[]u8, offset: i32, length: i32) -> Result<i64, sys.IoError> {
    n := sys.net_write(fd, &data, i64(offset), i64(length))
    if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
    .Ok(n)
}

@thread_safe
unsafe fn copy_c_str(value: ptr) -> string {
    if usize(value) == 0 { return "DNS resolution error" }
    mut raw: []u8 = []
    for i in 0..512 {
        b := load_u8(ptr(usize(value) + usize(i)))
        if b == 0 { break }
        raw.push(b)
    }
    decoded := bytes.decode(&raw)
    if decoded.ok { return decoded.value }
    "DNS resolution error"
}

impl TcpListener {
    @requires(network)
    pub fn listen(addr: i64, port: i32, backlog: i32) -> Result<Self, sys.IoError> {
        raw := sys.net_listen(addr, i64(port), i64(backlog))
        if raw < 0 { return .Err(sys.IoError::from_code(i32(-raw))) }
        .Ok(Self { fd: i32(raw) })
    }

    @requires(network)
    @thread_safe
    pub fn listen_addr(endpoint: SocketAddr, backlog: i32) -> Result<Self, sys.IoError> {
        domain := addr_family(endpoint.ip)
        mut fd := -45
        unsafe { fd = os_socket(domain, 1, 0) }
        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }
        mut listener := Self { fd: fd }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut brc: i64 = 0
        unsafe {
            _ := os_setsockopt_reuseaddr(listener.fd, 1)
            brc = os_bind(listener.fd, addr(&sa[0]), sa_len)
        }
        if brc < 0 {
            _ := listener.close()
            return .Err(sys.IoError::from_code(i32(-brc)))
        }
        mut q := backlog
        if q <= 0 { q = 128 }
        mut lrc: i64 = 0
        unsafe { lrc = os_listen(listener.fd, q) }
        if lrc < 0 {
            _ := listener.close()
            return .Err(sys.IoError::from_code(i32(-lrc)))
        }
        .Ok(listener)
    }

    pub fn fd(&self) -> i32 { self.fd }

    pub fn local_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_local_addr(self.fd) }

    pub fn local_port(&self) -> i32 {
        match self.local_addr() {
            .Ok(a) => i32(a.port),
            .Err(_) => -1,
        }
    }

    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))
    }

    pub fn accept(&self) -> Result<TcpStream, sys.IoError> {
        raw := sys.net_accept(self.fd)
        if raw < 0 { return .Err(sys.IoError::from_code(i32(-raw))) }
        .Ok(TcpStream { fd: i32(raw) })
    }

    fn dispose(&self) {
        if self.fd >= 0 { _ := sys.net_close(self.fd) }
    }

    pub fn close(&mut self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(self.fd))
        self.fd = -1
        st
    }
}

impl TcpStream {
    @requires(network)
    pub fn connect(addr: i64, port: i32) -> Result<Self, sys.IoError> {
        raw := sys.net_connect(addr, i64(port))
        if raw < 0 { return .Err(sys.IoError::from_code(i32(-raw))) }
        .Ok(Self { fd: i32(raw) })
    }

    @requires(network)
    @thread_safe
    pub fn connect_addr(endpoint: SocketAddr) -> Result<Self, sys.IoError> {
        if endpoint.port == 0 { return .Err(.InvalidArgument) }
        domain := addr_family(endpoint.ip)
        mut fd := -45
        unsafe { fd = os_socket(domain, 1, 0) }
        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }
        mut stream := Self { fd: fd }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut rc: i64 = 0
        unsafe { rc = os_connect(stream.fd, addr(&sa[0]), sa_len) }
        if rc < 0 {
            _ := stream.close()
            return .Err(sys.IoError::from_code(i32(-rc)))
        }
        .Ok(stream)
    }

    @requires(network)
    @thread_safe
    pub fn connect_timeout(endpoint: SocketAddr, timeout_ms: i32) -> Result<Self, sys.IoError> {
        if timeout_ms < 0 || endpoint.port == 0 { return .Err(.InvalidArgument) }
        domain := addr_family(endpoint.ip)
        mut fd := -45
        unsafe { fd = os_socket(domain, 1, 0) }
        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }
        mut stream := Self { fd: fd }
        nb := stream.set_nonblocking(true)
        if !nb.ok {
            _ := stream.close()
            return .Err(sys.IoError::from_code(nb.error))
        }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut rc: i64 = 0
        unsafe { rc = os_connect_nonblocking(stream.fd, addr(&sa[0]), sa_len) }
        if rc == 0 {
            restored := stream.set_nonblocking(false)
            if !restored.ok {
                _ := stream.close()
                return .Err(sys.IoError::from_code(restored.error))
            }
            return .Ok(stream)
        }
        if rc != -36 {
            _ := stream.close()
            return .Err(sys.IoError::from_code(i32(-rc)))
        }
        deadline := sys.now_ms() + i64(timeout_ms)
        mut ps := PollSet::new()
        mut first := true
        while true {
            mut remaining := deadline - sys.now_ms()
            if remaining <= 0 {
                if !first || timeout_ms > 0 {
                    _ := stream.close()
                    return .Err(.TimedOut)
                }
                remaining = 0
            }
            first = false
            ps.clear()
            ps.add(stream.fd, poll_out())
            mut delay := remaining
            if delay > 2147483647 { delay = 2147483647 }
            match ps.poll(i32(delay)) {
                .Err(err) => {
                    if err == .Interrupted { continue }
                    _ := stream.close()
                    return .Err(err)
                },
                .Ok(ready) => {
                    if ready == 0 {
                        _ := stream.close()
                        return .Err(.TimedOut)
                    }
                },
            }
            mut so_err := 0
            unsafe { so_err = os_getsockopt_error(stream.fd) }
            if so_err != 0 {
                _ := stream.close()
                return .Err(sys.IoError::from_code(so_err))
            }
            restored := stream.set_nonblocking(false)
            if !restored.ok {
                _ := stream.close()
                return .Err(sys.IoError::from_code(restored.error))
            }
            return .Ok(stream)
        }
        _ := stream.close()
        .Err(.TimedOut)
    }

    @requires(network)
    pub fn connect_host(host: string, port: u16, timeout_ms: i32) -> Result<Self, sys.IoError> {
        if timeout_ms < 0 || port == 0 { return .Err(.InvalidArgument) }
        addrs := match resolve(host, port) {
            .Ok(list) => list,
            .Err(_) => { return .Err(.NotFound) },
        }
        if addrs.len == 0 { return .Err(.NotFound) }
        deadline := sys.now_ms() + i64(timeout_ms)
        mut last_err := sys.IoError.ConnectionRefused
        for i in 0..addrs.len {
            remaining := deadline - sys.now_ms()
            if i > 0 && remaining <= 0 {
                last_err = .TimedOut
                break
            }
            mut budget: i64 = remaining
            if budget < 0 { budget = 0 }
            if budget > 2147483647 { budget = 2147483647 }
            match Self::connect_timeout(addrs[i], i32(budget)) {
                .Ok(s) => { return .Ok(s) },
                .Err(err) => { last_err = err },
            }
        }
        .Err(last_err)
    }

    pub fn fd(&self) -> i32 { self.fd }

    pub fn local_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_local_addr(self.fd) }

    pub fn peer_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_peer_addr(self.fd) }

    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))
    }

    pub fn set_nodelay(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nodelay(self.fd, enabled))
    }

    pub fn set_read_timeout(&self, timeout_ms: i64) -> sys.Status {
        fd_set_timeout(self.fd, true, timeout_ms)
    }

    pub fn set_write_timeout(&self, timeout_ms: i64) -> sys.Status {
        fd_set_timeout(self.fd, false, timeout_ms)
    }

    pub fn read_append(&self, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {
        fd_read_append(self.fd, &mut out, max_bytes, false)
    }

    pub fn peek_append(&self, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {
        fd_read_append(self.fd, &mut out, max_bytes, true)
    }

    pub fn write_range(&self, data: &[]u8, offset: i32, length: i32) -> Result<i64, sys.IoError> {
        fd_write_range(self.fd, &data, offset, length)
    }

    pub fn write_all(&self, data: &[]u8) -> sys.Status {
        mut off := 0
        while off < data.len {
            n := sys.net_write(self.fd, &data, i64(off), i64(data.len - off))
            if n < 0 { return sys.Status { ok: false, error: i32(-n) } }
            if n == 0 { return sys.Status { ok: false, error: 5 } }
            off += i32(n)
        }
        sys.Status { ok: true, error: 0 }
    }

    @thread_safe
    pub fn shutdown_read(&self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: false, error: 9 } }
        mut rc: i64 = 0
        unsafe { rc = os_shutdown(self.fd, 0) }
        status_from_i64(rc)
    }

    pub fn shutdown_write(&self) -> sys.Status {
        status_from_i64(sys.net_shutdown_write(self.fd))
    }

    @thread_safe
    pub fn shutdown_both(&self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: false, error: 9 } }
        mut rc: i64 = 0
        unsafe { rc = os_shutdown(self.fd, 2) }
        status_from_i64(rc)
    }

    fn dispose(&self) {
        if self.fd >= 0 { _ := sys.net_close(self.fd) }
    }

    pub fn close(&mut self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(self.fd))
        self.fd = -1
        st
    }
}

impl io.Read for TcpStream {
    @thread_safe
    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        mut r: Result<i32, sys.IoError> = .Ok(0)
        unsafe { r = io.fd_read_chunk(self.fd, &mut out, max_bytes) }
        r
    }
}

impl io.Write for TcpStream {
    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        if data.len == 0 { return .Ok(0) }
        n := sys.net_write(self.fd, &data, 0, i64(data.len))
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        .Ok(i32(n))
    }

    fn flush(&mut self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        .Ok
    }
}

impl PollSet {
    pub fn new() -> Self {
        Self { fds: [], events: [], revents: [], scratch: [] }
    }

    pub fn clear(&mut self) {
        self.fds.clear()
        self.events.clear()
        self.revents.clear()
    }

    pub fn add(&mut self, fd: i32, events: i32) {
        self.fds.push(fd)
        self.events.push(events)
        self.revents.push(0)
    }

    pub fn poll(&mut self, timeout_ms: i32) -> Result<i32, sys.IoError> {
        count := self.fds.len
        assert(self.events.len == count && self.revents.len == count)
        need := count * 8
        if self.scratch.len < need {
            self.scratch.reserve(need)
            while self.scratch.len < need { self.scratch.push(0) }
        }
        for i in 0..count {
            base := i * 8
            u := i64(self.fds[i]).bit_and(0xffffffff)
            self.scratch[base] = u8(u.bit_and(0xff))
            self.scratch[base + 1] = u8(u.shr(8).bit_and(0xff))
            self.scratch[base + 2] = u8(u.shr(16).bit_and(0xff))
            self.scratch[base + 3] = u8(u.shr(24).bit_and(0xff))
            ev := i64(self.events[i]).bit_and(0xffff)
            self.scratch[base + 4] = u8(ev.bit_and(0xff))
            self.scratch[base + 5] = u8(ev.shr(8).bit_and(0xff))
            self.scratch[base + 6] = 0
            self.scratch[base + 7] = 0
        }
        n := sys.net_poll(&mut self.scratch, i64(count), i64(timeout_ms))
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        for i in 0..count {
            base := i * 8
            lo := i32(self.scratch[base + 6])
            hi := i32(self.scratch[base + 7])
            self.revents[i] = lo + hi.shl(8)
        }
        .Ok(i32(n))
    }
}

impl Default for PollSet {
    fn default() -> Self { PollSet::new() }
}

impl StreamSet {
    pub fn new() -> Self { Self { fds: [] } }
    pub fn len(&self) -> i32 { self.fds.len }
    pub fn fd(&self, slot: i32) -> i32 { self.fds[slot] }

    pub fn insert(&mut self, move s: TcpStream) -> i32 {
        mut stream := s
        fd := stream.fd
        assert(fd >= 0)
        stream.fd = -1
        for i in 0..self.fds.len {
            if self.fds[i] < 0 {
                self.fds[i] = fd
                return i
            }
        }
        self.fds.push(fd)
        self.fds.len - 1
    }

    fn dispose(&self) {
        for fd in self.fds {
            if fd >= 0 { _ := sys.net_close(fd) }
        }
    }

    pub fn read_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_read_append(fd, &mut out, max_bytes, false)
    }

    pub fn peek_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_read_append(fd, &mut out, max_bytes, true)
    }

    pub fn write_range(&self, slot: i32, data: &[]u8, offset: i32, length: i32) -> Result<i64, sys.IoError> {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_write_range(fd, &data, offset, length)
    }

    @thread_safe
    pub fn shutdown_read(&self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        mut rc: i64 = 0
        unsafe { rc = os_shutdown(fd, 0) }
        status_from_i64(rc)
    }

    pub fn shutdown_write(&self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        status_from_i64(sys.net_shutdown_write(fd))
    }

    @thread_safe
    pub fn shutdown_both(&self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        mut rc: i64 = 0
        unsafe { rc = os_shutdown(fd, 2) }
        status_from_i64(rc)
    }

    pub fn local_addr(&self, slot: i32) -> Result<SocketAddr, sys.IoError> {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_local_addr(fd)
    }

    pub fn peer_addr(&self, slot: i32) -> Result<SocketAddr, sys.IoError> {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_peer_addr(fd)
    }

    pub fn set_read_timeout(&self, slot: i32, timeout_ms: i64) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_set_timeout(fd, true, timeout_ms)
    }

    pub fn set_write_timeout(&self, slot: i32, timeout_ms: i64) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_set_timeout(fd, false, timeout_ms)
    }

    pub fn close(&mut self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        if fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(fd))
        self.fds[slot] = -1
        st
    }

    pub fn close_all(&mut self) {
        for i in 0..self.fds.len {
            if self.fds[i] >= 0 {
                _ := sys.net_close(self.fds[i])
                self.fds[i] = -1
            }
        }
    }
}

impl Default for StreamSet {
    fn default() -> Self { StreamSet::new() }
}

impl UdpSocket {
    @requires(network)
    @thread_safe
    pub fn bind(endpoint: SocketAddr) -> Result<Self, sys.IoError> {
        domain := addr_family(endpoint.ip)
        mut fd := -45
        unsafe { fd = os_socket(domain, 2, 0) }
        if fd < 0 { return .Err(sys.IoError::from_code(-fd)) }
        mut sock := Self { fd: fd }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut brc: i64 = 0
        unsafe { brc = os_bind(sock.fd, addr(&sa[0]), sa_len) }
        if brc < 0 {
            _ := sock.close()
            return .Err(sys.IoError::from_code(i32(-brc)))
        }
        .Ok(sock)
    }

    pub fn fd(&self) -> i32 { self.fd }

    pub fn local_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_local_addr(self.fd) }

    pub fn local_port(&self) -> i32 {
        match self.local_addr() {
            .Ok(a) => i32(a.port),
            .Err(_) => -1,
        }
    }

    pub fn peer_addr(&self) -> Result<SocketAddr, sys.IoError> { fd_peer_addr(self.fd) }

    @thread_safe
    pub fn connect(&self, endpoint: SocketAddr) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: false, error: 9 } }
        if endpoint.port == 0 { return sys.Status { ok: false, error: 22 } }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut rc: i64 = 0
        unsafe { rc = os_connect(self.fd, addr(&sa[0]), sa_len) }
        status_from_i64(rc)
    }

    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))
    }

    pub fn set_read_timeout(&self, timeout_ms: i64) -> sys.Status {
        fd_set_timeout(self.fd, true, timeout_ms)
    }

    pub fn set_write_timeout(&self, timeout_ms: i64) -> sys.Status {
        fd_set_timeout(self.fd, false, timeout_ms)
    }

    @thread_safe
    pub fn send_to_range(&self, data: &[]u8, offset: i32, length: i32, endpoint: SocketAddr) -> Result<i64, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        if offset < 0 || length < 0 || offset > data.len || length > data.len - offset || endpoint.port == 0 {
            return .Err(.InvalidArgument)
        }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut scratch: u8 = 0
        mut n: i64 = 0
        unsafe {
            buf_ptr := if length > 0 { addr(&data[offset]) } else { addr(&mut scratch) }
            n = os_sendto(self.fd, buf_ptr, usize(length), addr(&sa[0]), sa_len)
        }
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        .Ok(n)
    }

    pub fn send_to(&self, data: &[]u8, endpoint: SocketAddr) -> Result<i64, sys.IoError> {
        self.send_to_range(&data, 0, data.len, endpoint)
    }

    @thread_safe
    pub fn send(&self, data: &[]u8) -> Result<i64, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        mut scratch: u8 = 0
        mut n: i64 = 0
        unsafe {
            buf_ptr := if data.len > 0 { addr(&data[0]) } else { addr(&mut scratch) }
            n = os_sendto(self.fd, buf_ptr, usize(data.len), ptr(0), 0)
        }
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        .Ok(n)
    }

    @thread_safe
    fn recv_from_internal(&self, out: &mut []u8, max_bytes: i32, peek: bool) -> Result<(i64, SocketAddr), sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        if max_bytes < 0 { return .Err(.InvalidArgument) }
        if max_bytes == 0 { return .Ok((0, zero_addr())) }
        mut cap := max_bytes
        if cap > 65535 { cap = 65535 }
        mut scratch: []u8 = []
        bytes.pad(&mut scratch, cap)
        mut sa: [u8; 128] = [0; 128]
        mut len_buf: [u8; 4] = [128, 0, 0, 0]
        flags := if peek { 2 } else { 0 }
        mut n: i64 = 0
        unsafe {
            n = os_recvfrom(self.fd, addr(&mut scratch[0]), usize(cap), flags, addr(&mut sa[0]), addr(&mut len_buf[0]))
        }
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        mut got := i32(n)
        if got > cap { got = cap }
        if got > 0 { bytes.extend_range(&mut out, &scratch, 0, got) }
        mut from := zero_addr()
        unsafe {
            sa_len := load_u32(addr(&len_buf[0]))
            if sa_len >= 8 {
                match decode_sockaddr_ptr(addr(&sa[0]), sa_len) {
                    .Ok(a) => { from = a },
                    .Err(_) => {},
                }
            }
        }
        .Ok((n, from))
    }

    pub fn recv_from_append(&self, out: &mut []u8, max_bytes: i32) -> Result<(i64, SocketAddr), sys.IoError> {
        self.recv_from_internal(&mut out, max_bytes, false)
    }

    pub fn peek_from_append(&self, out: &mut []u8, max_bytes: i32) -> Result<(i64, SocketAddr), sys.IoError> {
        self.recv_from_internal(&mut out, max_bytes, true)
    }

    pub fn recv_append(&self, out: &mut []u8, max_bytes: i32) -> Result<i64, sys.IoError> {
        res := self.recv_from_internal(&mut out, max_bytes, false)?
        .Ok(res.0)
    }

    fn dispose(&self) {
        if self.fd >= 0 { _ := sys.net_close(self.fd) }
    }

    pub fn close(&mut self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(self.fd))
        self.fd = -1
        st
    }
}

@requires(network)
@thread_safe
pub fn resolve(host: string, port: u16) -> Result<[]SocketAddr, string> {
    if host.len == 0 || host.len > 1024 {
        return .Err(sys.error_message(22))
    }
    for b in host.bytes() {
        if b == 0 {
            return .Err(sys.error_message(22))
        }
    }
    match IpAddr::parse(host) {
        .Ok(ip) => {
            return .Ok([SocketAddr::new(ip, port)])
        },
        .Err(_) => {},
    }
    if target_is("macos") || target_is("linux") {
        mut host_c: []u8 = []
        bytes.append_utf8(&mut host_c, host)
        host_c.push(0)
        svc := i32(port).str()
        mut svc_c: []u8 = []
        bytes.append_utf8(&mut svc_c, svc)
        svc_c.push(0)
        mut hints: [u8; 48] = [0; 48]
        hints[8] = 1
        mut res_buf: [u8; 8] = [0; 8]
        unsafe {
            rc := c_getaddrinfo(addr(&host_c[0]), addr(&svc_c[0]), addr(&hints[0]), addr(&mut res_buf[0]))
            if rc != 0 {
                return .Err(copy_c_str(c_gai_strerror(rc)))
            }
            head := load_ptr(addr(&res_buf[0]))
            defer { if usize(head) != 0 { c_freeaddrinfo(head) } }
            mut addrs: []SocketAddr = []
            mut cur := head
            mut steps := 0
            while usize(cur) != 0 && steps < 1024 {
                steps += 1
                ai_addrlen := load_u32(ptr(usize(cur) + 16))
                ai_addr := if target_is("macos") {
                    load_ptr(ptr(usize(cur) + 32))
                } else {
                    load_ptr(ptr(usize(cur) + 24))
                }
                if usize(ai_addr) != 0 {
                    match decode_sockaddr_ptr(ai_addr, ai_addrlen) {
                        .Ok(a) => {
                            mut cand := a
                            cand.port = port
                            mut dup := false
                            for existing in &addrs {
                                if existing == cand { dup = true; break }
                            }
                            if !dup { addrs.push(cand) }
                        },
                        .Err(_) => {},
                    }
                }
                cur = load_ptr(ptr(usize(cur) + 40))
            }
            if addrs.len == 0 {
                return .Err("no addresses resolved")
            }
            return .Ok(addrs)
        }
    }
    .Err(sys.error_message(45))
}
