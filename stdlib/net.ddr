    }

    pub fn clear(&mut self) {
        self.fds.clear()
        self.events.clear()
        self.revents.clear()
    }

    pub fn add(&mut self, fd: i32, events: i32) {
        self.fds.push(fd)
        self.events.push(events)
        self.revents.push(0)
    }

    pub fn poll(&mut self, timeout_ms: i32) -> IoResult {
        count := self.fds.len
        assert(self.events.len == count && self.revents.len == count)
        need := count * 8
        if self.scratch.len < need {
            self.scratch.reserve(need)
            while self.scratch.len < need { self.scratch.push(0) }
        }
        for i in 0..count {
            base := i * 8
            u := i64(self.fds[i]).bit_and(0xffffffff)
            self.scratch[base] = u8(u.bit_and(0xff))
            self.scratch[base + 1] = u8(u.shr(8).bit_and(0xff))
            self.scratch[base + 2] = u8(u.shr(16).bit_and(0xff))
            self.scratch[base + 3] = u8(u.shr(24).bit_and(0xff))
            ev := i64(self.events[i]).bit_and(0xffff)
            self.scratch[base + 4] = u8(ev.bit_and(0xff))
            self.scratch[base + 5] = u8(ev.shr(8).bit_and(0xff))
            self.scratch[base + 6] = 0
            self.scratch[base + 7] = 0
        }
        n := sys.net_poll(&mut self.scratch, i64(count), i64(timeout_ms))
        if n < 0 {
            err := i32(-n)
            return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }
        }
        for i in 0..count {
            base := i * 8
            lo := i32(self.scratch[base + 6])
            hi := i32(self.scratch[base + 7])
            self.revents[i] = lo + hi.shl(8)
        }
        IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }
    }
}

impl Default for PollSet {
    fn default() -> Self { PollSet::new() }
}

impl StreamSet {
    pub fn new() -> Self { Self { fds: [] } }
    pub fn len(&self) -> i32 { self.fds.len }
    pub fn fd(&self, slot: i32) -> i32 { self.fds[slot] }

    pub fn insert(&mut self, move s: TcpStream) -> i32 {
        mut stream := s
        fd := stream.fd
        assert(fd >= 0)
        stream.fd = -1
        for i in 0..self.fds.len {
            if self.fds[i] < 0 {
                self.fds[i] = fd
                return i
            }
        }
        self.fds.push(fd)
        self.fds.len - 1
    }

    fn dispose(&self) {
        for fd in self.fds {
            if fd >= 0 { _ := sys.net_close(fd) }
        }
    }

    pub fn read_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_read_append(fd, &mut out, max_bytes, false)
    }

    pub fn peek_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_read_append(fd, &mut out, max_bytes, true)
    }

    pub fn write_range(&self, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_write_range(fd, &data, offset, length)
    }

    pub fn shutdown_read(&self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        mut rc: i64 = 0
        unsafe { rc = os_shutdown(fd, 0) }
        status_from_i64(rc)
    }

    pub fn shutdown_write(&self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        status_from_i64(sys.net_shutdown_write(fd))
    }

    pub fn local_addr(&self, slot: i32) -> AddrResult {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_local_addr(fd)
    }

    pub fn peer_addr(&self, slot: i32) -> AddrResult {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_peer_addr(fd)
    }

    pub fn set_read_timeout(&self, slot: i32, timeout_ms: i64) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_set_timeout(fd, true, timeout_ms)
    }

    pub fn set_write_timeout(&self, slot: i32, timeout_ms: i64) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_set_timeout(fd, false, timeout_ms)
    }

    pub fn close(&mut self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        if fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(fd))
        self.fds[slot] = -1
        st
    }

    pub fn close_all(&mut self) {
        for i in 0..self.fds.len {
            if self.fds[i] >= 0 {
                _ := sys.net_close(self.fds[i])
                self.fds[i] = -1
            }
        }
    }
}

impl Default for StreamSet {
    fn default() -> Self { StreamSet::new() }
}

impl UdpSocket {
    @requires(network)
    pub fn bind(endpoint: SocketAddr) -> UdpBindResult {
        domain := addr_family(endpoint.ip)
        mut fd := -45
        unsafe { fd = os_socket(domain, 2, 0) }
        if fd < 0 {
            return UdpBindResult { ok: false, socket: Self { fd: -1 }, error: -fd }
        }
        mut sock := Self { fd: fd }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut brc: i64 = 0
        unsafe { brc = os_bind(sock.fd, addr(&sa[0]), sa_len) }
        if brc < 0 {
            _ := sock.close()
            return UdpBindResult { ok: false, socket: Self { fd: -1 }, error: i32(-brc) }
        }
        UdpBindResult { ok: true, socket: sock, error: 0 }
    }

    pub fn fd(&self) -> i32 { self.fd }

    pub fn local_addr(&self) -> AddrResult { fd_local_addr(self.fd) }

    pub fn local_port(&self) -> i32 {
        res := self.local_addr()
        if !res.ok { return -1 }
        i32(res.addr.port)
    }

    pub fn peer_addr(&self) -> AddrResult { fd_peer_addr(self.fd) }

    pub fn connect(&self, endpoint: SocketAddr) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: false, error: 9 } }
        if endpoint.port == 0 { return sys.Status { ok: false, error: 22 } }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut rc: i64 = 0
        unsafe { rc = os_connect(self.fd, addr(&sa[0]), sa_len) }
        status_from_i64(rc)
    }

    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))
    }

    pub fn set_read_timeout(&self, timeout_ms: i64) -> sys.Status {
        fd_set_timeout(self.fd, true, timeout_ms)
    }

    pub fn set_write_timeout(&self, timeout_ms: i64) -> sys.Status {
        fd_set_timeout(self.fd, false, timeout_ms)
    }

    pub fn send_to_range(&self, data: &[]u8, offset: i32, length: i32, endpoint: SocketAddr) -> IoResult {
        if self.fd < 0 {
            return IoResult { ok: false, would_block: false, eof: false, count: 0, error: 9 }
        }
        if offset < 0 || length < 0 || offset > data.len || length > data.len - offset || endpoint.port == 0 {
            return IoResult { ok: false, would_block: false, eof: false, count: 0, error: 22 }
        }
        mut sa: [u8; 32] = [0; 32]
        sa_len := encode_sockaddr(endpoint, &mut sa)
        mut scratch: u8 = 0
        mut n: i64 = 0
        unsafe {
            buf_ptr := if length > 0 { addr(&data[offset]) } else { addr(&mut scratch) }
            n = os_sendto(self.fd, buf_ptr, usize(length), addr(&sa[0]), sa_len)
        }
        if n < 0 {
            err := i32(-n)
            return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }
        }
        IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }
    }

    pub fn send_to(&self, data: &[]u8, endpoint: SocketAddr) -> IoResult {
        self.send_to_range(&data, 0, data.len, endpoint)
    }

    pub fn send(&self, data: &[]u8) -> IoResult {
        if self.fd < 0 {
            return IoResult { ok: false, would_block: false, eof: false, count: 0, error: 9 }
        }
        mut scratch: u8 = 0
        mut n: i64 = 0
        unsafe {
            buf_ptr := if data.len > 0 { addr(&data[0]) } else { addr(&mut scratch) }
            n = os_sendto(self.fd, buf_ptr, usize(data.len), ptr(0), 0)
        }
        if n < 0 {
            err := i32(-n)
            return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }
        }
        IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }
    }

    fn recv_from_internal(&self, out: &mut []u8, max_bytes: i32, peek: bool) -> UdpRecvResult {
        if self.fd < 0 {
            return UdpRecvResult { ok: false, would_block: false, count: 0, from: zero_addr(), error: 9 }
        }
        if max_bytes < 0 {
            return UdpRecvResult { ok: false, would_block: false, count: 0, from: zero_addr(), error: 22 }
        }
        if max_bytes == 0 {
            return UdpRecvResult { ok: true, would_block: false, count: 0, from: zero_addr(), error: 0 }
        }
        mut cap := max_bytes
        if cap > 65535 { cap = 65535 }
        mut scratch: []u8 = []
        bytes.pad(&mut scratch, cap)
        mut sa: [u8; 128] = [0; 128]
        mut len_buf: [u8; 4] = [128, 0, 0, 0]
        flags := if peek { 2 } else { 0 }
        mut n: i64 = 0
        unsafe {
            n = os_recvfrom(self.fd, addr(&mut scratch[0]), usize(cap), flags, addr(&mut sa[0]), addr(&mut len_buf[0]))
        }
        if n < 0 {
            err := i32(-n)
            return UdpRecvResult { ok: false, would_block: err == 35, count: 0, from: zero_addr(), error: err }
        }
        mut got := i32(n)
        if got > cap { got = cap }
        if got > 0 { bytes.extend_range(&mut out, &scratch, 0, got) }
        mut from := zero_addr()
        unsafe {
            sa_len := load_u32(addr(&len_buf[0]))
            if sa_len >= 8 {
                decoded := decode_sockaddr_ptr(addr(&sa[0]), sa_len)
                if decoded.ok { from = decoded.addr }
            }
        }
        UdpRecvResult { ok: true, would_block: false, count: n, from: from, error: 0 }
    }

    pub fn recv_from_append(&self, out: &mut []u8, max_bytes: i32) -> UdpRecvResult {
        self.recv_from_internal(&mut out, max_bytes, false)
    }

    pub fn peek_from_append(&self, out: &mut []u8, max_bytes: i32) -> UdpRecvResult {
        self.recv_from_internal(&mut out, max_bytes, true)
    }

    pub fn recv_append(&self, out: &mut []u8, max_bytes: i32) -> IoResult {
        res := self.recv_from_internal(&mut out, max_bytes, false)
        if !res.ok {
            return IoResult { ok: false, would_block: res.would_block, eof: false, count: 0, error: res.error }
        }
        IoResult { ok: true, would_block: false, eof: false, count: res.count, error: 0 }
    }

    fn dispose(&self) {
        if self.fd >= 0 { _ := sys.net_close(self.fd) }
    }

    pub fn close(&mut self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(self.fd))
        self.fd = -1
        st
    }
}

@requires(network)
pub fn resolve(host: string, port: u16) -> ResolveResult {
    if host.len == 0 || host.len > 1024 {
        return ResolveResult { ok: false, addrs: [], error: 22, error_message: sys.error_message(22) }
    }
    for b in host.bytes() {
        if b == 0 {
            return ResolveResult { ok: false, addrs: [], error: 22, error_message: sys.error_message(22) }
        }
    }
    match IpAddr::parse(host) {
        .Ok(ip) => {
            return ResolveResult { ok: true, addrs: [SocketAddr::new(ip, port)], error: 0, error_message: "" }
        },
        .Err(_) => {},
    }
    if target_is("macos") || target_is("linux") {
        mut host_c: []u8 = []
        bytes.append_utf8(&mut host_c, host)
        host_c.push(0)
        svc := i32(port).str()
        mut svc_c: []u8 = []
        bytes.append_utf8(&mut svc_c, svc)
        svc_c.push(0)
        mut hints: [u8; 48] = [0; 48]
        hints[8] = 1
        mut res_buf: [u8; 8] = [0; 8]
        unsafe {
            rc := c_getaddrinfo(addr(&host_c[0]), addr(&svc_c[0]), addr(&hints[0]), addr(&mut res_buf[0]))
            if rc != 0 {
                return ResolveResult { ok: false, addrs: [], error: rc, error_message: copy_c_str(c_gai_strerror(rc)) }
            }
            head := load_ptr(addr(&res_buf[0]))
            defer { if usize(head) != 0 { c_freeaddrinfo(head) } }
            mut addrs: []SocketAddr = []
            mut cur := head
            mut steps := 0
            while usize(cur) != 0 && steps < 1024 {
                steps += 1
                ai_addrlen := load_u32(ptr(usize(cur) + 16))
                ai_addr := if target_is("macos") {
                    load_ptr(ptr(usize(cur) + 32))
                } else {
                    load_ptr(ptr(usize(cur) + 24))
                }
                if usize(ai_addr) != 0 {
                    decoded := decode_sockaddr_ptr(ai_addr, ai_addrlen)
                    if decoded.ok {
                        mut cand := decoded.addr
                        cand.port = port
                        mut dup := false
                        for existing in &addrs {
                            if existing == cand { dup = true; break }
                        }
                        if !dup { addrs.push(cand) }
                    }
                }
                cur = load_ptr(ptr(usize(cur) + 40))
            }
            if addrs.len == 0 {
                return ResolveResult { ok: false, addrs: [], error: 2, error_message: "no addresses resolved" }
            }
            return ResolveResult { ok: true, addrs: addrs, error: 0, error_message: "" }
        }
    }
    ResolveResult { ok: false, addrs: [], error: 45, error_message: sys.error_message(45) }
}

@requires(network)
pub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult { TcpListener::listen(addr, port, backlog) }
@requires(network)
pub fn listen_addr(addr: SocketAddr, backlog: i32) -> ListenResult { TcpListener::listen_addr(addr, backlog) }

@requires(network)
pub fn connect(addr: i64, port: i32) -> ConnectResult { TcpStream::connect(addr, port) }
@requires(network)
pub fn connect_addr(addr: SocketAddr) -> ConnectResult { TcpStream::connect_addr(addr) }
@requires(network)
pub fn connect_timeout(addr: SocketAddr, timeout_ms: i32) -> ConnectResult { TcpStream::connect_timeout(addr, timeout_ms) }
@requires(network)
pub fn connect_host(host: string, port: u16, timeout_ms: i32) -> ConnectResult { TcpStream::connect_host(host, port, timeout_ms) }

@requires(network)
pub fn bind_udp(addr: SocketAddr) -> UdpBindResult { UdpSocket::bind(addr) }

pub fn listener_fd(l: &TcpListener) -> i32 { l.fd() }
pub fn stream_fd(s: &TcpStream) -> i32 { s.fd() }
pub fn local_port(l: &TcpListener) -> i32 { l.local_port() }
pub fn listener_local_addr(l: &TcpListener) -> AddrResult { l.local_addr() }
pub fn stream_local_addr(s: &TcpStream) -> AddrResult { s.local_addr() }
pub fn stream_peer_addr(s: &TcpStream) -> AddrResult { s.peer_addr() }
pub fn set_listener_nonblocking(l: &TcpListener, enabled: bool) -> sys.Status { l.set_nonblocking(enabled) }
pub fn accept(l: &TcpListener) -> AcceptResult { l.accept() }
pub fn close_listener(l: &mut TcpListener) -> sys.Status { l.close() }
pub fn set_nonblocking(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nonblocking(enabled) }
pub fn set_nodelay(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nodelay(enabled) }
pub fn set_read_timeout(s: &TcpStream, timeout_ms: i64) -> sys.Status { s.set_read_timeout(timeout_ms) }
pub fn set_write_timeout(s: &TcpStream, timeout_ms: i64) -> sys.Status { s.set_write_timeout(timeout_ms) }
pub fn read_append(s: &TcpStream, out: &mut []u8, max_bytes: i32) -> IoResult { s.read_append(&mut out, max_bytes) }
pub fn peek_append(s: &TcpStream, out: &mut []u8, max_bytes: i32) -> IoResult { s.peek_append(&mut out, max_bytes) }
pub fn write_range(s: &TcpStream, data: &[]u8, offset: i32, length: i32) -> IoResult { s.write_range(&data, offset, length) }
pub fn write_all(s: &TcpStream, data: &[]u8) -> sys.Status { s.write_all(&data) }
pub fn shutdown_read(s: &TcpStream) -> sys.Status { s.shutdown_read() }
pub fn shutdown_write(s: &TcpStream) -> sys.Status { s.shutdown_write() }
pub fn shutdown_both(s: &TcpStream) -> sys.Status { s.shutdown_both() }
pub fn close(s: &mut TcpStream) -> sys.Status { s.close() }

pub fn poll_set() -> PollSet { PollSet::new() }
pub fn poll_clear(ps: &mut PollSet) { ps.clear() }
pub fn poll_add(ps: &mut PollSet, fd: i32, events: i32) { ps.add(fd, events) }
pub fn poll(ps: &mut PollSet, timeout_ms: i32) -> IoResult { ps.poll(timeout_ms) }

pub fn stream_set() -> StreamSet { StreamSet::new() }
pub fn set_len(set: &StreamSet) -> i32 { set.len() }
pub fn set_fd(set: &StreamSet, slot: i32) -> i32 { set.fd(slot) }
pub fn set_insert(set: &mut StreamSet, move s: TcpStream) -> i32 { set.insert(move s) }
pub fn set_read_append(set: &StreamSet, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult { set.read_append(slot, &mut out, max_bytes) }
pub fn set_peek_append(set: &StreamSet, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult { set.peek_append(slot, &mut out, max_bytes) }
pub fn set_write_range(set: &StreamSet, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult { set.write_range(slot, &data, offset, length) }
pub fn set_shutdown_read(set: &StreamSet, slot: i32) -> sys.Status { set.shutdown_read(slot) }
pub fn set_shutdown_write(set: &StreamSet, slot: i32) -> sys.Status { set.shutdown_write(slot) }
pub fn set_local_addr(set: &StreamSet, slot: i32) -> AddrResult { set.local_addr(slot) }
pub fn set_peer_addr(set: &StreamSet, slot: i32) -> AddrResult { set.peer_addr(slot) }
pub fn set_close(set: &mut StreamSet, slot: i32) -> sys.Status { set.close(slot) }
pub fn set_close_all(set: &mut StreamSet) { set.close_all() }
