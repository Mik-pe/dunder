@thread_safe
unsafe fn os_setsockopt_timeout(fd: i32, read_dir: bool, timeout_ms: i64) -> i64 {
    secs := timeout_ms / 1000
    usecs := (timeout_ms % 1000) * 1000
    mut tv: [u8; 16] = [0; 16]
    for i in 0..8 { tv[i] = u8(secs.shr(i * 8).bit_and(255)) }
    if target_is("macos") {
        u32_usecs := i32(usecs)
        for i in 0..4 { tv[8 + i] = u8(u32_usecs.shr(i * 8).bit_and(255)) }
        opt := if read_dir { 4102 } else { 4101 }
        if c_setsockopt(fd, 65535, opt, addr(&tv[0]), 16) < 0 { return i64(-macos_errno()) }
        return 0
    } else if target_is("linux") {
        for i in 0..8 { tv[8 + i] = u8(usecs.shr(i * 8).bit_and(255)) }
        opt := if read_dir { 20 } else { 21 }
        r := sys.linux_syscall(208, i64(fd), 1, i64(opt), i64(usize(addr(&tv[0]))), 16, 0)
        if r < 0 { return i64(-portable_errno(i32(-r), false)) }
        return 0
    }
