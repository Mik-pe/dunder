capability network
import sys

pub fn poll_in() -> i32 { 1 }
pub fn poll_out() -> i32 { 4 }
pub fn poll_err() -> i32 { 8 }
pub fn poll_hup() -> i32 { 16 }
pub fn poll_nval() -> i32 { 32 }
pub fn err_would_block() -> i32 { 35 }

pub fn ipv4(a: i32, b: i32, c: i32, d: i32) -> i64 {
    assert(a >= 0 && a <= 255 && b >= 0 && b <= 255 && c >= 0 && c <= 255 && d >= 0 && d <= 255)
    (i64(a).shl(24)).bit_or(i64(b).shl(16)).bit_or(i64(c).shl(8)).bit_or(i64(d))
}
pub fn loopback() -> i64 { ipv4(127, 0, 0, 1) }
pub fn any_addr() -> i64 { 0 }

@resource
pub opaque struct TcpListener { fd: i32 }
@resource
pub opaque struct TcpStream { fd: i32 }
@resource
pub opaque struct StreamSet { fds: []i32 }

pub struct ListenResult { ok: bool, listener: TcpListener, error: i32 }
pub struct AcceptResult { ok: bool, would_block: bool, stream: TcpStream, error: i32 }
pub struct ConnectResult { ok: bool, stream: TcpStream, error: i32 }
pub struct IoResult { ok: bool, would_block: bool, eof: bool, count: i64, error: i32 }
pub struct PollSet {
    fds: []i32,
    events: []i32,
    revents: []i32,
    scratch: []u8,
}

fn status_from_i64(raw: i64) -> sys.Status {
    if raw < 0 { return sys.Status { ok: false, error: i32(-raw) } }
    sys.Status { ok: true, error: 0 }
}

fn fd_read_append(fd: i32, out: &mut []u8, max_bytes: i32) -> IoResult {
    if max_bytes <= 0 {
        return IoResult { ok: true, would_block: false, eof: false, count: 0, error: 0 }
    }
    out.reserve(out.len + max_bytes)
    n := sys.net_read(fd, &mut out, i64(max_bytes))
    if n < 0 {
        err := i32(-n)
        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }
    }
    IoResult { ok: true, would_block: false, eof: n == 0, count: n, error: 0 }
}

fn fd_write_range(fd: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {
    n := sys.net_write(fd, &data, i64(offset), i64(length))
    if n < 0 {
        err := i32(-n)
        return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }
    }
    IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }
}

impl TcpListener {
    @requires(network)
    pub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult {
        raw := sys.net_listen(addr, i64(port), i64(backlog))
        if raw < 0 {
            return ListenResult { ok: false, listener: Self { fd: -1 }, error: i32(-raw) }
        }
        ListenResult { ok: true, listener: Self { fd: i32(raw) }, error: 0 }
    }

    pub fn fd(&self) -> i32 { self.fd }

    pub fn local_port(&self) -> i32 {
        raw := sys.net_local_port(self.fd)
        if raw < 0 { return -1 }
        i32(raw)
    }

    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))
    }

    pub fn accept(&self) -> AcceptResult {
        raw := sys.net_accept(self.fd)
        if raw < 0 {
            err := i32(-raw)
            return AcceptResult { ok: false, would_block: err == 35, stream: TcpStream { fd: -1 }, error: err }
        }
        AcceptResult { ok: true, would_block: false, stream: TcpStream { fd: i32(raw) }, error: 0 }
    }

    pub fn close(&mut self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(self.fd))
        self.fd = -1
        st
    }
}

impl TcpStream {
    @requires(network)
    pub fn connect(addr: i64, port: i32) -> ConnectResult {
        raw := sys.net_connect(addr, i64(port))
        if raw < 0 {
            return ConnectResult { ok: false, stream: Self { fd: -1 }, error: i32(-raw) }
        }
        ConnectResult { ok: true, stream: Self { fd: i32(raw) }, error: 0 }
    }

    pub fn fd(&self) -> i32 { self.fd }

    pub fn set_nonblocking(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nonblocking(self.fd, enabled))
    }

    pub fn set_nodelay(&self, enabled: bool) -> sys.Status {
        status_from_i64(sys.net_set_nodelay(self.fd, enabled))
    }

    pub fn read_append(&self, out: &mut []u8, max_bytes: i32) -> IoResult {
        fd_read_append(self.fd, &mut out, max_bytes)
    }

    pub fn write_range(&self, data: &[]u8, offset: i32, length: i32) -> IoResult {
        fd_write_range(self.fd, &data, offset, length)
    }

    pub fn write_all(&self, data: &[]u8) -> sys.Status {
        mut off := 0
        while off < data.len {
            n := sys.net_write(self.fd, &data, i64(off), i64(data.len - off))
            if n < 0 { return sys.Status { ok: false, error: i32(-n) } }
            if n == 0 { return sys.Status { ok: false, error: 5 } }
            off += i32(n)
        }
        sys.Status { ok: true, error: 0 }
    }

    pub fn shutdown_write(&self) -> sys.Status {
        status_from_i64(sys.net_shutdown_write(self.fd))
    }

    pub fn close(&mut self) -> sys.Status {
        if self.fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(self.fd))
        self.fd = -1
        st
    }
}

impl PollSet {
    pub fn new() -> Self {
        Self { fds: [], events: [], revents: [], scratch: [] }
    }

    pub fn clear(&mut self) {
        self.fds.clear()
        self.events.clear()
        self.revents.clear()
    }

    pub fn add(&mut self, fd: i32, events: i32) {
        self.fds.push(fd)
        self.events.push(events)
        self.revents.push(0)
    }

    pub fn poll(&mut self, timeout_ms: i32) -> IoResult {
        count := self.fds.len
        assert(self.events.len == count && self.revents.len == count)
        need := count * 8
        if self.scratch.len < need {
            self.scratch.reserve(need)
            while self.scratch.len < need { self.scratch.push(0) }
        }
        for i in 0..count {
            base := i * 8
            u := i64(self.fds[i]).bit_and(0xffffffff)
            self.scratch[base] = u8(u.bit_and(0xff))
            self.scratch[base + 1] = u8(u.shr(8).bit_and(0xff))
            self.scratch[base + 2] = u8(u.shr(16).bit_and(0xff))
            self.scratch[base + 3] = u8(u.shr(24).bit_and(0xff))
            ev := i64(self.events[i]).bit_and(0xffff)
            self.scratch[base + 4] = u8(ev.bit_and(0xff))
            self.scratch[base + 5] = u8(ev.shr(8).bit_and(0xff))
            self.scratch[base + 6] = 0
            self.scratch[base + 7] = 0
        }
        n := sys.net_poll(&mut self.scratch, i64(count), i64(timeout_ms))
        if n < 0 {
            err := i32(-n)
            return IoResult { ok: false, would_block: err == 35, eof: false, count: 0, error: err }
        }
        for i in 0..count {
            base := i * 8
            lo := i32(self.scratch[base + 6])
            hi := i32(self.scratch[base + 7])
            self.revents[i] = lo + hi.shl(8)
        }
        IoResult { ok: true, would_block: false, eof: false, count: n, error: 0 }
    }
}

impl StreamSet {
    pub fn new() -> Self { Self { fds: [] } }
    pub fn len(&self) -> i32 { self.fds.len }
    pub fn fd(&self, slot: i32) -> i32 { self.fds[slot] }

    pub fn insert(&mut self, move s: TcpStream) -> i32 {
        assert(s.fd >= 0)
        fd := s.fd
        for i in 0..self.fds.len {
            if self.fds[i] < 0 {
                self.fds[i] = fd
                return i
            }
        }
        self.fds.push(fd)
        self.fds.len - 1
    }

    pub fn read_append(&self, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_read_append(fd, &mut out, max_bytes)
    }

    pub fn write_range(&self, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult {
        fd := self.fds[slot]
        assert(fd >= 0)
        fd_write_range(fd, &data, offset, length)
    }

    pub fn shutdown_write(&self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        assert(fd >= 0)
        status_from_i64(sys.net_shutdown_write(fd))
    }

    pub fn close(&mut self, slot: i32) -> sys.Status {
        fd := self.fds[slot]
        if fd < 0 { return sys.Status { ok: true, error: 0 } }
        st := status_from_i64(sys.net_close(fd))
        self.fds[slot] = -1
        st
    }

    pub fn close_all(&mut self) {
        for i in 0..self.fds.len {
            if self.fds[i] >= 0 {
                unused := sys.net_close(self.fds[i])
                self.fds[i] = -1
            }
        }
    }
}

@requires(network)
pub fn listen(addr: i64, port: i32, backlog: i32) -> ListenResult { TcpListener::listen(addr, port, backlog) }

@requires(network)
pub fn connect(addr: i64, port: i32) -> ConnectResult { TcpStream::connect(addr, port) }

pub fn listener_fd(l: &TcpListener) -> i32 { l.fd() }
pub fn stream_fd(s: &TcpStream) -> i32 { s.fd() }
pub fn local_port(l: &TcpListener) -> i32 { l.local_port() }
pub fn set_listener_nonblocking(l: &TcpListener, enabled: bool) -> sys.Status { l.set_nonblocking(enabled) }
pub fn accept(l: &TcpListener) -> AcceptResult { l.accept() }
pub fn close_listener(l: &mut TcpListener) -> sys.Status { l.close() }
pub fn set_nonblocking(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nonblocking(enabled) }
pub fn set_nodelay(s: &TcpStream, enabled: bool) -> sys.Status { s.set_nodelay(enabled) }
pub fn read_append(s: &TcpStream, out: &mut []u8, max_bytes: i32) -> IoResult { s.read_append(&mut out, max_bytes) }
pub fn write_range(s: &TcpStream, data: &[]u8, offset: i32, length: i32) -> IoResult { s.write_range(&data, offset, length) }
pub fn write_all(s: &TcpStream, data: &[]u8) -> sys.Status { s.write_all(&data) }
pub fn shutdown_write(s: &TcpStream) -> sys.Status { s.shutdown_write() }
pub fn close(s: &mut TcpStream) -> sys.Status { s.close() }

pub fn poll_set() -> PollSet { PollSet::new() }
pub fn poll_clear(ps: &mut PollSet) { ps.clear() }
pub fn poll_add(ps: &mut PollSet, fd: i32, events: i32) { ps.add(fd, events) }
pub fn poll(ps: &mut PollSet, timeout_ms: i32) -> IoResult { ps.poll(timeout_ms) }

pub fn stream_set() -> StreamSet { StreamSet::new() }
pub fn set_len(set: &StreamSet) -> i32 { set.len() }
pub fn set_fd(set: &StreamSet, slot: i32) -> i32 { set.fd(slot) }
pub fn set_insert(set: &mut StreamSet, move s: TcpStream) -> i32 { set.insert(move s) }
pub fn set_read_append(set: &StreamSet, slot: i32, out: &mut []u8, max_bytes: i32) -> IoResult { set.read_append(slot, &mut out, max_bytes) }
pub fn set_write_range(set: &StreamSet, slot: i32, data: &[]u8, offset: i32, length: i32) -> IoResult { set.write_range(slot, &data, offset, length) }
pub fn set_shutdown_write(set: &StreamSet, slot: i32) -> sys.Status { set.shutdown_write(slot) }
pub fn set_close(set: &mut StreamSet, slot: i32) -> sys.Status { set.close(slot) }
pub fn set_close_all(set: &mut StreamSet) { set.close_all() }
