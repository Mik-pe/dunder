pub fn poll_in() -> i32 { 1 }
pub fn poll_out() -> i32 { 4 }
pub fn poll_err() -> i32 { 8 }
pub fn poll_hup() -> i32 { 16 }
pub fn poll_nval() -> i32 { 32 }
pub fn err_would_block() -> i32 { 35 }

pub fn ipv4(a: i32, b: i32, c: i32, d: i32) -> i64 {
    assert(a >= 0 && a <= 255 && b >= 0 && b <= 255 && c >= 0 && c <= 255 && d >= 0 && d <= 255)
    (i64(a).shl(24)).bit_or(i64(b).shl(16)).bit_or(i64(c).shl(8)).bit_or(i64(d))
}
pub fn loopback() -> i64 { ipv4(127, 0, 0, 1) }
pub fn any_addr() -> i64 { 0 }

pub enum IpAddr {
    V4(u8, u8, u8, u8),
    V6(u16, u16, u16, u16, u16, u16, u16, u16),
}

pub struct SocketAddr {
    ip: IpAddr,
    port: u16,
    scope_id: u32,
}

@resource(dispose)
pub opaque struct TcpListener { fd: i32 }
impl Sendable for TcpListener {}
@resource(dispose)
pub opaque struct TcpStream { fd: i32 }
impl Sendable for TcpStream {}
@resource(dispose)
pub opaque struct StreamSet { fds: []i32 }
@resource(dispose)
pub opaque struct UdpSocket { fd: i32 }
impl Sendable for UdpSocket {}

pub struct PollSet {
    fds: []i32,
    events: []i32,
    revents: []i32,
    scratch: []u8,
}

fn zero_addr() -> SocketAddr {
    SocketAddr { ip: IpAddr.V4(0, 0, 0, 0), port: 0, scope_id: 0 }
}

fn addr_family(ip: IpAddr) -> i32 {
    match ip {
        .V4(_, _, _, _) => 2,
        .V6(_, _, _, _, _, _, _, _) => if target_is("macos") { 30 } else { 10 },
    }
}

fn parse_ipv4_octets(input: string, out: &mut [u8; 4]) -> bool {
    parts := text.split(input, ".")
    if parts.len != 4 { return false }
    for idx in 0..4 {
        p := &parts[idx]
        if p.len == 0 || p.len > 3 { return false }
        if p.len > 1 && p[0] == 48 { return false }
        mut val := 0
        for b in p.bytes() {
            if b < 48 || b > 57 { return false }
            val = val * 10 + (b - 48)
        }
        if val > 255 { return false }
        out[idx] = u8(val)
    }
    true
}

fn parse_hex_group(seg: &string, out: &mut u16) -> bool {
    if seg.len == 0 || seg.len > 4 { return false }
    mut val := 0
    for b in seg.bytes() {
        mut d := -1
        if b >= 48 && b <= 57 { d = b - 48 }
        else if b >= 97 && b <= 102 { d = b - 87 }
        else if b >= 65 && b <= 70 { d = b - 55 }
        else { return false }
        val = val * 16 + d
    }
    out = u16(val)
    true
}

fn parse_ipv6_half(part: string, allow_v4: bool, groups: &mut []u16) -> bool {
    if part.len == 0 { return true }
    segs := text.split(part, ":")
    for i in 0..segs.len {
        seg := &segs[i]
        if seg.len == 0 { return false }
        if allow_v4 && i == segs.len - 1 && text.contains(seg, ".") {
            mut v4: [u8; 4] = [0; 4]
            if !parse_ipv4_octets(seg.clone(), &mut v4) { return false }
            groups.push(u16(i32(v4[0]).shl(8).bit_or(i32(v4[1]))))
            groups.push(u16(i32(v4[2]).shl(8).bit_or(i32(v4[3]))))
        } else {
            mut g: u16 = 0
            if !parse_hex_group(&seg, &mut g) { return false }
            groups.push(g)
        }
    }
    true
}

fn parse_ipv6(input: string) -> Result<IpAddr, string> {
    if input.len < 2 || input.len > 45 { return .Err("invalid IPv6 address") }
    dc := match text.find(input, "::") {
        .Some(pos) => pos,
        .None => {
            mut groups: []u16 = []
            if !parse_ipv6_half(input, true, &mut groups) || groups.len != 8 {
                return .Err("invalid IPv6 address")
            }
            return .Ok(IpAddr.V6(groups[0], groups[1], groups[2], groups[3], groups[4], groups[5], groups[6], groups[7]))
        },
    }
    if dc + 2 < input.len && input[dc + 2] == 58 { return .Err("invalid IPv6 address") }
    rest := input[(dc + 2)..input.len]
    if text.contains(rest, "::") { return .Err("invalid IPv6 address") }
    head_str := input[0..dc]
    mut head: []u16 = []
    if !parse_ipv6_half(head_str, false, &mut head) { return .Err("invalid IPv6 address") }
    mut tail: []u16 = []
    if !parse_ipv6_half(rest, true, &mut tail) { return .Err("invalid IPv6 address") }
    if head.len + tail.len >= 8 { return .Err("invalid IPv6 address") }
    mut full: [u16; 8] = [0; 8]
    for i in 0..head.len { full[i] = head[i] }
    tail_off := 8 - tail.len
    for i in 0..tail.len { full[tail_off + i] = tail[i] }
    .Ok(IpAddr.V6(full[0], full[1], full[2], full[3], full[4], full[5], full[6], full[7]))
}

fn append_hex_u16(out: &mut []u8, value: u16) {
    hex := "0123456789abcdef"
    v := i32(value)
    if v == 0 {
        out.push(b'0')
        return
    }
    mut started := false
    for shift in [12, 8, 4, 0] {
        nib := v.shr(shift).bit_and(15)
        if nib != 0 || started {
            started = true
            out.push(u8(hex[nib]))
        }
    }
}

fn format_ipv6(g: &[]u16) -> string {
    mut best_start := -1
    mut best_len := 0
    mut cur_start := -1
    mut cur_len := 0
    for i in 0..8 {
        if g[i] == 0 {
            if cur_start < 0 { cur_start = i; cur_len = 1 }
            else { cur_len += 1 }
            if cur_len > best_len { best_start = cur_start; best_len = cur_len }
        } else {
            cur_start = -1
            cur_len = 0
        }
    }
    mut out: []u8 = []
    if best_len >= 2 {
        for i in 0..best_start {
            if i > 0 { out.push(b':') }
            append_hex_u16(&mut out, g[i])
        }
        bytes.append_utf8(&mut out, "::")
        after := best_start + best_len
        for i in after..8 {
            if i > after { out.push(b':') }
            append_hex_u16(&mut out, g[i])
        }
    } else {
        for i in 0..8 {
            if i > 0 { out.push(b':') }
            append_hex_u16(&mut out, g[i])
        }
    }
    bytes.decode(&out).value
}

fn parse_u16_port(input: string, out: &mut u16) -> bool {
    if input.len == 0 || input.len > 5 { return false }
    if input.len > 1 && input[0] == 48 { return false }
    mut val := 0
    for b in input.bytes() {
        if b < 48 || b > 57 { return false }
        val = val * 10 + (b - 48)
    }
    if val > 65535 { return false }
    out = u16(val)
    true
}

fn parse_u32_decimal(input: string, out: &mut u32) -> bool {
    if input.len == 0 || input.len > 10 { return false }
    if input.len > 1 && input[0] == 48 { return false }
    mut val: i64 = 0
    for b in input.bytes() {
        if b < 48 || b > 57 { return false }
        val = val * 10 + i64(b - 48)
        if val > 4294967295 { return false }
    }
    out = u32(val)
    true
}

impl IpAddr {
    pub fn v4(a: u8, b: u8, c: u8, d: u8) -> Self { .V4(a, b, c, d) }

    pub fn v4_from_i64(raw: i64) -> Self {
        .V4(
            u8(raw.shr(24).bit_and(255)),
            u8(raw.shr(16).bit_and(255)),
            u8(raw.shr(8).bit_and(255)),
            u8(raw.bit_and(255))
        )
    }

    pub fn v6(s0: u16, s1: u16, s2: u16, s3: u16, s4: u16, s5: u16, s6: u16, s7: u16) -> Self {
        .V6(s0, s1, s2, s3, s4, s5, s6, s7)
    }

    pub fn v6_bytes(raw: &[]u8) -> Result<Self, string> {
        if raw.len != 16 { return .Err("IPv6 address requires 16 bytes") }
        .Ok(.V6(
            u16(i32(raw[0]).shl(8).bit_or(i32(raw[1]))),
            u16(i32(raw[2]).shl(8).bit_or(i32(raw[3]))),
            u16(i32(raw[4]).shl(8).bit_or(i32(raw[5]))),
            u16(i32(raw[6]).shl(8).bit_or(i32(raw[7]))),
            u16(i32(raw[8]).shl(8).bit_or(i32(raw[9]))),
            u16(i32(raw[10]).shl(8).bit_or(i32(raw[11]))),
            u16(i32(raw[12]).shl(8).bit_or(i32(raw[13]))),
            u16(i32(raw[14]).shl(8).bit_or(i32(raw[15])))
        ))
    }

    pub fn localhost_v4() -> Self { .V4(127, 0, 0, 1) }
    pub fn unspecified_v4() -> Self { .V4(0, 0, 0, 0) }
    pub fn localhost_v6() -> Self { .V6(0, 0, 0, 0, 0, 0, 0, 1) }
    pub fn unspecified_v6() -> Self { .V6(0, 0, 0, 0, 0, 0, 0, 0) }

    pub fn is_v4(&self) -> bool {
        match self {
            .V4(_, _, _, _) => true,
            .V6(_, _, _, _, _, _, _, _) => false,
        }
    }

    pub fn is_v6(&self) -> bool { !self.is_v4() }

    pub fn is_loopback(&self) -> bool {
        match self {
            .V4(a, _, _, _) => a == 127,
            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {
                s0 == 0 && s1 == 0 && s2 == 0 && s3 == 0 && s4 == 0 && s5 == 0 && s6 == 0 && s7 == 1
            },
        }
    }

    pub fn is_unspecified(&self) -> bool {
        match self {
            .V4(a, b, c, d) => a == 0 && b == 0 && c == 0 && d == 0,
            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {
                s0 == 0 && s1 == 0 && s2 == 0 && s3 == 0 && s4 == 0 && s5 == 0 && s6 == 0 && s7 == 0
            },
        }
    }

    pub fn to_v4_i64(&self) -> Result<i64, string> {
        match self {
            .V4(a, b, c, d) => .Ok(ipv4(i32(a), i32(b), i32(c), i32(d))),
            .V6(_, _, _, _, _, _, _, _) => .Err("cannot convert IPv6 address to IPv4 integer"),
        }
    }

    pub fn parse(input: string) -> Result<Self, string> {
        if input.len == 0 { return .Err("empty IP address") }
        if text.contains(input, ":") { return parse_ipv6(input) }
        mut v4: [u8; 4] = [0; 4]
        if !parse_ipv4_octets(input, &mut v4) { return .Err("invalid IPv4 address") }
        .Ok(.V4(v4[0], v4[1], v4[2], v4[3]))
    }
}

impl Eq for IpAddr {
    fn eq(&self, other: &Self) -> bool {
        match self {
            .V4(a0, a1, a2, a3) => match other {
                .V4(b0, b1, b2, b3) => a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3,
                .V6(_, _, _, _, _, _, _, _) => false,
            },
            .V6(a0, a1, a2, a3, a4, a5, a6, a7) => match other {
                .V4(_, _, _, _) => false,
                .V6(b0, b1, b2, b3, b4, b5, b6, b7) => {
                    a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3 &&
                    a4 == b4 && a5 == b5 && a6 == b6 && a7 == b7
                },
            },
        }
    }
}

impl Hash for IpAddr {
    fn hash(&self) -> u64 {
        match self {
            .V4(a, b, c, d) => {
                v := u64(a).shl(24).bit_or(u64(b).shl(16)).bit_or(u64(c).shl(8)).bit_or(u64(d))
                v.hash().bit_xor(u64(11400714819323198485))
            },
            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {
                mut h := u64(14695981039346656037)
                for seg in [s0, s1, s2, s3, s4, s5, s6, s7] {
                    h = h.bit_xor(seg.hash()).wrapping_mul(1099511628211)
                }
                h.hash()
            },
        }
    }
}

impl Display for IpAddr {
    fn str(&self) -> string {
        match self {
            .V4(a, b, c, d) => f"{a}.{b}.{c}.{d}",
            .V6(s0, s1, s2, s3, s4, s5, s6, s7) => format_ipv6(&[s0, s1, s2, s3, s4, s5, s6, s7]),
        }
    }
}

impl SocketAddr {
    pub fn new(ip: IpAddr, port: u16) -> Self { Self { ip: ip, port: port, scope_id: 0 } }

    pub fn new_v6(ip: IpAddr, port: u16, scope_id: u32) -> Self {
        Self { ip: ip, port: port, scope_id: if ip.is_v6() { scope_id } else { 0 } }
    }

    pub fn v4(a: u8, b: u8, c: u8, d: u8, port: u16) -> Self {
        Self { ip: IpAddr.V4(a, b, c, d), port: port, scope_id: 0 }
    }

    pub fn v6(s0: u16, s1: u16, s2: u16, s3: u16, s4: u16, s5: u16, s6: u16, s7: u16, port: u16) -> Self {
        Self { ip: IpAddr.V6(s0, s1, s2, s3, s4, s5, s6, s7), port: port, scope_id: 0 }
    }

    pub fn loopback_v4(port: u16) -> Self { Self { ip: IpAddr::localhost_v4(), port: port, scope_id: 0 } }
    pub fn loopback_v6(port: u16) -> Self { Self { ip: IpAddr::localhost_v6(), port: port, scope_id: 0 } }
    pub fn any_v4(port: u16) -> Self { Self { ip: IpAddr::unspecified_v4(), port: port, scope_id: 0 } }
    pub fn any_v6(port: u16) -> Self { Self { ip: IpAddr::unspecified_v6(), port: port, scope_id: 0 } }
    pub fn is_v4(&self) -> bool { self.ip.is_v4() }
    pub fn is_v6(&self) -> bool { self.ip.is_v6() }

    pub fn parse(input: string) -> Result<Self, string> {
        if input.len < 3 { return .Err("invalid socket address") }
        if input[0] == 91 {
            close := match text.find(input, "]") {
                .Some(pos) => pos,
                .None => { return .Err("invalid IPv6 socket address") },
            }
            if close < 2 || close + 2 >= input.len || input[close + 1] != 58 {
                return .Err("invalid IPv6 socket address")
            }
            inner := input[1..close]
            port_str := input[(close + 2)..input.len]
            mut port: u16 = 0
            if !parse_u16_port(port_str, &mut port) { return .Err("invalid socket port") }
            mut ip_part := ""
            mut scope_id: u32 = 0
            match text.find(inner, "%") {
                .Some(pct) => {
                    ip_part = inner[0..pct]
                    scope_part := inner[(pct + 1)..inner.len]
                    if !parse_u32_decimal(scope_part, &mut scope_id) {
                        return .Err("invalid IPv6 scope id")
                    }
                },
                .None => {
                    ip_part = move inner
                },
            }
            match IpAddr::parse(ip_part) {
                .Ok(ip) => {
                    if !ip.is_v6() { return .Err("bracketed socket address requires IPv6") }
                    return .Ok(SocketAddr { ip: ip, port: port, scope_id: scope_id })
                },
                .Err(err) => { return .Err(err) },
            }
        }
        colon := match text.find(input, ":") {
            .Some(pos) => pos,
            .None => { return .Err("invalid socket address") },
        }
        if colon <= 0 || colon + 1 >= input.len { return .Err("invalid socket address") }
        ip_part := input[0..colon]
        port_part := input[(colon + 1)..input.len]
        if text.contains(port_part, ":") { return .Err("IPv6 socket address requires brackets") }
        mut port: u16 = 0
        if !parse_u16_port(port_part, &mut port) { return .Err("invalid socket port") }
        match IpAddr::parse(ip_part) {
            .Ok(ip) => {
                if !ip.is_v4() { return .Err("invalid IPv4 socket address") }
                .Ok(SocketAddr { ip: ip, port: port, scope_id: 0 })
            },
            .Err(err) => .Err(err),
        }
    }
}

impl Eq for SocketAddr {
    fn eq(&self, other: &Self) -> bool {
        self.ip == other.ip && self.port == other.port && self.scope_id == other.scope_id
    }
}

impl Hash for SocketAddr {
    fn hash(&self) -> u64 {
        mut h := self.ip.hash()
        h = h.bit_xor(self.port.hash().wrapping_mul(11400714819323198485))
        h.bit_xor(self.scope_id.hash().wrapping_mul(14029467366897019727))
    }
}

impl Display for SocketAddr {
    fn str(&self) -> string {
        match self.ip {
            .V4(_, _, _, _) => f"{self.ip}:{self.port}",
            .V6(_, _, _, _, _, _, _, _) => {
                if self.scope_id != 0 {
                    f"[{self.ip}%{self.scope_id}]:{self.port}"
                } else {
                    f"[{self.ip}]:{self.port}"
                }
            },
        }
    }
}

fn portable_errno(raw: i32, is_darwin: bool) -> i32 {
    if raw <= 0 { return 5 }
    if is_darwin { return raw }
    if raw == 1 || raw == 2 || raw == 4 || raw == 5 || raw == 9 || raw == 12 ||
       raw == 13 || raw == 17 || raw == 20 || raw == 21 || raw == 22 ||
       raw == 23 || raw == 24 || raw == 27 || raw == 28 || raw == 30 || raw == 32 { return raw }
    if raw == 11 { return 35 }
    if raw == 36 { return 63 }
    if raw == 39 { return 66 }
    if raw == 84 { return 92 }
    if raw == 90 { return 40 }
    if raw == 95 { return 45 }
    if raw == 97 { return 47 }
    if raw == 98 { return 48 }
    if raw == 99 { return 49 }
    if raw == 101 { return 51 }
    if raw == 103 { return 53 }
    if raw == 104 { return 54 }
    if raw == 107 { return 57 }
    if raw == 110 { return 60 }
    if raw == 111 { return 61 }
    if raw == 113 { return 65 }
    if raw == 115 { return 36 }
    10000 + raw
}

@thread_safe
unsafe fn macos_errno() -> i32 {
    if target_is("macos") { return portable_errno(load_i32(c_errno_ptr()), true) }
    45
}

fn encode_sockaddr(endpoint: SocketAddr, buf: &mut [u8; 32]) -> u32 {
    for i in 0..32 { buf[i] = 0 }
    p := i32(endpoint.port)
    buf[2] = u8(p.shr(8).bit_and(255))
    buf[3] = u8(p.bit_and(255))
    match endpoint.ip {
        .V4(a, b, c, d) => {
            if target_is("macos") {
                buf[0] = 16
                buf[1] = 2
            } else {
                buf[0] = 2
                buf[1] = 0
            }
            buf[4] = a
            buf[5] = b
            buf[6] = c
            buf[7] = d
            u32(16)
        },
        .V6(s0, s1, s2, s3, s4, s5, s6, s7) => {
            if target_is("macos") {
                buf[0] = 28
                buf[1] = 30
            } else {
                buf[0] = 10
                buf[1] = 0
            }
            segs: [u16; 8] = [s0, s1, s2, s3, s4, s5, s6, s7]
            for i in 0..8 {
                v := i32(segs[i])
                buf[8 + i * 2] = u8(v.shr(8).bit_and(255))
                buf[9 + i * 2] = u8(v.bit_and(255))
            }
            sc := i64(endpoint.scope_id)
            buf[24] = u8(sc.bit_and(255))
            buf[25] = u8(sc.shr(8).bit_and(255))
            buf[26] = u8(sc.shr(16).bit_and(255))
            buf[27] = u8(sc.shr(24).bit_and(255))
            u32(28)
        },
    }
}

@thread_safe
unsafe fn decode_sockaddr_ptr(sa: ptr, sa_len: u32) -> Result<SocketAddr, sys.IoError> {
    if usize(sa) == 0 || sa_len < 8 {
        return .Err(.InvalidArgument)
    }
    family := if target_is("macos") {
        i32(load_u8(ptr(usize(sa) + 1)))
    } else {
        i32(load_u8(sa)).bit_or(i32(load_u8(ptr(usize(sa) + 1))).shl(8))
    }
    port := u16(i32(load_u8(ptr(usize(sa) + 2))).shl(8).bit_or(i32(load_u8(ptr(usize(sa) + 3)))))
    if family == 2 {
        ip := IpAddr.V4(
            load_u8(ptr(usize(sa) + 4)),
            load_u8(ptr(usize(sa) + 5)),
            load_u8(ptr(usize(sa) + 6)),
            load_u8(ptr(usize(sa) + 7))
        )
        return .Ok(SocketAddr { ip: ip, port: port, scope_id: 0 })
    }
    v6_family := if target_is("macos") { 30 } else { 10 }
    if family == v6_family && sa_len >= 28 {
        mut segs: [u16; 8] = [0; 8]
        for i in 0..8 {
            hi := i32(load_u8(ptr(usize(sa) + usize(8 + i * 2))))
            lo := i32(load_u8(ptr(usize(sa) + usize(9 + i * 2))))
            segs[i] = u16(hi.shl(8).bit_or(lo))
        }
        mut sc: i64 = 0
        for i in 0..4 {
            sc = sc.bit_or(i64(load_u8(ptr(usize(sa) + usize(24 + i)))).shl(i * 8))
        }
        ip := IpAddr.V6(segs[0], segs[1], segs[2], segs[3], segs[4], segs[5], segs[6], segs[7])
        return .Ok(SocketAddr { ip: ip, port: port, scope_id: u32(sc) })
    }
    .Err(sys.IoError::from_code(47))
}

@thread_safe
unsafe fn os_socket(domain: i32, kind: i32, protocol: i32) -> i32 {
    if target_is("macos") {
