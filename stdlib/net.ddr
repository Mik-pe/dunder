        if fd < 0 { return -macos_errno() }
        _ := c_ioctl(fd, 536897025)
        mut one: [u8; 4] = [1, 0, 0, 0]
        _ := c_setsockopt(fd, 65535, 4130, addr(&one[0]), 4)
        return fd
    } else if target_is("linux") {
