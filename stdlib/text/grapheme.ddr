import std.bytes.utf8
import std.text.grapheme_data as data

const CR: i32 = 1
const LF: i32 = 2
const CONTROL: i32 = 3
const EXTEND: i32 = 4
const ZWJ: i32 = 5
const RI: i32 = 6
const PREPEND: i32 = 7
const SPACING_MARK: i32 = 8
const L: i32 = 9
const V: i32 = 10
const T: i32 = 11
const LV: i32 = 12
const LVT: i32 = 13

fn properties(cp: i32) -> i32 {
    if cp >= 0xac00 && cp <= 0xd7a3 { return if (cp - 0xac00) % 28 == 0 { LV } else { LVT } }
    ranges := data.RANGES
    mut low := 0
    mut high := ranges.len / 6
    while low + 1 < high {
        mid := (low + high) / 2
        at := mid * 6
        mut first := 0
        for i in at..(at + 4) { first = first * 64 + i32(ranges[i]) - 35 }
        if cp < first { high = mid } else { low = mid }
    }
    (i32(ranges[low * 6 + 4]) - 35) * 64 + i32(ranges[low * 6 + 5]) - 35
}

fn control(kind: i32) -> bool { kind >= CR && kind <= CONTROL }

fn boundary(previous: i32, next: i32, indic_link: bool, emoji_join: bool, odd_regional: bool) -> bool {
    kind := next.bit_and(15)
    if previous == CR && kind == LF { return false }
    if control(previous) || control(kind) { return true }
    if previous == L && (kind == L || kind == V || kind == LV || kind == LVT) { return false }
    if (previous == LV || previous == V) && (kind == V || kind == T) { return false }
    if (previous == LVT || previous == T) && kind == T { return false }
    if kind == EXTEND || kind == ZWJ || kind == SPACING_MARK || previous == PREPEND { return false }
    if indic_link && next.bit_and(48) == 16 { return false }
    if emoji_join && next.bit_and(64) != 0 { return false }
    !(kind == RI && odd_regional)
}

pub fn next_boundary(value: &str, start: i32) -> i32 {
    bytes := value.as_bytes()
    mut pos := start
    mut previous := 0
    mut indic := 0
    mut emoji := false
    mut emoji_join := false
    mut odd_regional := false
    while pos < value.len {
        scalar := utf8.decode_prefix(&bytes[pos..])
        match scalar {
            .Scalar(cp, size) => {
                next := properties(i32(cp))
                if pos > start && boundary(previous, next, indic == 2, emoji_join, odd_regional) { break }
                previous = next.bit_and(15)
                incb := next.bit_and(48)
                if incb == 16 { indic = 1 } else if incb == 48 && indic != 0 { indic = 2 } else if incb != 32 { indic = 0 }
                emoji_join = previous == ZWJ && emoji
                emoji = next.bit_and(64) != 0 || (previous == EXTEND && emoji)
                odd_regional = previous == RI && !odd_regional
                pos += size
            },
            _ => { assert(false) },
        }
    }
    pos
}
