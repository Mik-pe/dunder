// Compact binary wire codec over []u8. Zero heap allocations during encoding,
// explicit bounds checking during decoding, portable across native and wasm32.
import std.bytes as bytes
import sys

pub struct Reader {
    pos: i32,
    ok: bool,
    error: i32, // 0=ok, 1=truncated, 2=overflow/varint, 92=invalid UTF-8
}

pub fn reader() -> Reader { Reader { pos: 0, ok: true, error: 0 } }

pub fn remaining(buf: &[]u8, r: &Reader) -> i32 {
    if !r.ok || r.pos > buf.len { return 0 }
    buf.len - r.pos
}

pub fn finish(buf: &[]u8, r: &Reader) -> bool {
    r.ok && r.pos == buf.len
}

fn fail_read(r: &mut Reader, err: i32) {
    if r.ok { r.ok = false; r.error = err }
}

pub fn put_u8(out: &mut []u8, v: u8) { out.push(v) }

pub fn put_bool(out: &mut []u8, v: bool) {
    if v { out.push(1) } else { out.push(0) }
}

pub fn put_u16_le(out: &mut []u8, v: u16) {
    bytes.append_le(&mut out, i64(v), 2)
}

pub fn put_i32_le(out: &mut []u8, v: i32) {
    bytes.append_le(&mut out, i64(v), 4)
}

pub fn put_u32_le(out: &mut []u8, v: u32) {
    bytes.append_le(&mut out, i64(v), 4)
}

pub fn put_i64_le(out: &mut []u8, v: i64) {
    bytes.append_le(&mut out, v, 8)
}

pub fn put_u64_le(out: &mut []u8, v: u64) {
    for i in 0..8 {
        out.push(u8(v.shr(i * 8).bit_and(255)))
    }
}

pub fn put_f32(out: &mut []u8, v: f32) {
    bits := v.to_bits()
    bytes.append_le(&mut out, i64(bits), 4)
}

pub fn put_f64(out: &mut []u8, v: f64) {
    bits := v.to_bits()
    bytes.append_le(&mut out, bits, 8)
}

// Unsigned LEB128 varint (1..10 bytes).
pub fn put_uvarint(out: &mut []u8, value: u64) {
    var v := value
    while v >= 128 {
        out.push(u8(v.bit_and(127).bit_or(128)))
        v = v.shr(7)
    }
    out.push(u8(v))
}

// ZigZag-encoded signed varint so small negative and positive numbers take 1 byte.
pub fn put_varint(out: &mut []u8, value: i64) {
    var zz: u64 = 0
    if value < 0 {
        // (-value - 1) * 2 + 1 without signed overflow on i64::MIN
        zz = u64(-(value + 1)).shl(1).bit_or(1)
    } else {
        zz = u64(value).shl(1)
    }
    put_uvarint(&mut out, zz)
}

pub fn put_bytes(out: &mut []u8, data: &[]u8) {
    put_uvarint(&mut out, u64(data.len))
    bytes.extend(&mut out, &data)
}

pub fn put_str(out: &mut []u8, text: string) {
    put_uvarint(&mut out, u64(text.len))
    bytes.append_utf8(&mut out, text)
}

pub fn read_u8(buf: &[]u8, r: &mut Reader) -> u8 {
    if !r.ok { return 0 }
    if r.pos >= buf.len { fail_read(&mut r, 1); return 0 }
    b := buf[r.pos]
    r.pos += 1
    b
}

pub fn read_bool(buf: &[]u8, r: &mut Reader) -> bool {
    b := read_u8(&buf, &mut r)
    if !r.ok { return false }
    if b == 0 { return false }
    if b == 1 { return true }
    fail_read(&mut r, 2)
    false
}

pub fn read_u16_le(buf: &[]u8, r: &mut Reader) -> u16 {
    if !r.ok { return 0 }
    if r.pos + 2 > buf.len { fail_read(&mut r, 1); return 0 }
    v := u16(bytes.u16_le(&buf, r.pos))
    r.pos += 2
    v
}

pub fn read_i32_le(buf: &[]u8, r: &mut Reader) -> i32 {
    if !r.ok { return 0 }
    if r.pos + 4 > buf.len { fail_read(&mut r, 1); return 0 }
    raw := bytes.u32_le(&buf, r.pos)
    r.pos += 4
    if raw >= 2147483648 { return i32(raw - 4294967296) }
    i32(raw)
}

pub fn read_u32_le(buf: &[]u8, r: &mut Reader) -> u32 {
    if !r.ok { return 0 }
    if r.pos + 4 > buf.len { fail_read(&mut r, 1); return 0 }
    raw := bytes.u32_le(&buf, r.pos)
    r.pos += 4
    u32(raw)
}

pub fn read_i64_le(buf: &[]u8, r: &mut Reader) -> i64 {
    if !r.ok { return 0 }
    if r.pos + 8 > buf.len { fail_read(&mut r, 1); return 0 }
    v := bytes.i64_le(&buf, r.pos)
    r.pos += 8
    v
}

pub fn read_u64_le(buf: &[]u8, r: &mut Reader) -> u64 {
    if !r.ok { return 0 }
    if r.pos + 8 > buf.len { fail_read(&mut r, 1); return 0 }
    v := bytes.u64_le(&buf, r.pos)
    r.pos += 8
    v
}

pub fn read_f32(buf: &[]u8, r: &mut Reader) -> f32 {
    bits := read_i32_le(&buf, &mut r)
    if !r.ok { return 0.0 }
    f32.from_bits(bits)
}

pub fn read_f64(buf: &[]u8, r: &mut Reader) -> f64 {
    bits := read_i64_le(&buf, &mut r)
    if !r.ok { return 0.0 }
    f64.from_bits(bits)
}

pub fn read_uvarint(buf: &[]u8, r: &mut Reader) -> u64 {
    if !r.ok { return 0 }
    var result: u64 = 0
    var shift := 0
    for i in 0..10 {
        if r.pos >= buf.len { fail_read(&mut r, 1); return 0 }
        b := buf[r.pos]
        r.pos += 1
        if i == 9 && b > 1 { fail_read(&mut r, 2); return 0 }
        result = result.bit_or(u64(b.bit_and(127)).shl(shift))
        if b < 128 { return result }
        shift += 7
    }
    fail_read(&mut r, 2)
    0
}

pub fn read_varint(buf: &[]u8, r: &mut Reader) -> i64 {
    zz := read_uvarint(&buf, &mut r)
    if !r.ok { return 0 }
    half := zz.shr(1)
    if zz.bit_and(1) != 0 {
        return -i64(half) - 1
    }
    i64(half)
}

pub fn read_bytes(buf: &[]u8, r: &mut Reader) -> []u8 {
    if !r.ok { return [] }
    n := read_uvarint(&buf, &mut r)
    if !r.ok { return [] }
    if n > u64(buf.len - r.pos) { fail_read(&mut r, 1); return [] }
    count := i32(n)
    var out: []u8 = []
    bytes.extend_range(&mut out, &buf, r.pos, r.pos + count)
    r.pos += count
    out
}

pub fn read_str(buf: &[]u8, r: &mut Reader) -> string {
    if !r.ok { return "" }
    n := read_uvarint(&buf, &mut r)
    if !r.ok { return "" }
    if n > u64(buf.len - r.pos) { fail_read(&mut r, 1); return "" }
    count := i32(n)
    dec := bytes.decode_range(&buf, r.pos, r.pos + count)
    if !dec.ok { fail_read(&mut r, 92); return "" }
    r.pos += count
    dec.value
}

@test
fn wire_round_trips_scalars_strings_extremes_and_rejects_truncation() {
    var buf: []u8 = []
    put_bool(&mut buf, true)
    put_bool(&mut buf, false)
    put_i32_le(&mut buf, -2147483648)
    put_u32_le(&mut buf, 4294967295)
    put_i64_le(&mut buf, -9223372036854775808)
    put_u64_le(&mut buf, 18446744073709551615)
    put_varint(&mut buf, 0)
    put_varint(&mut buf, -1)
    put_varint(&mut buf, 42)
    put_varint(&mut buf, -9223372036854775808)
    put_varint(&mut buf, 9223372036854775807)
    put_f64(&mut buf, -3.5)
    put_str(&mut buf, "dunder åäö 🌍")
    var raw: []u8 = [0, 255, 17]
    put_bytes(&mut buf, &raw)

    var r := reader()
    assert(read_bool(&buf, &mut r))
    assert(!read_bool(&buf, &mut r))
    assert(read_i32_le(&buf, &mut r) == -2147483648)
    assert(read_u32_le(&buf, &mut r) == 4294967295)
    assert(read_i64_le(&buf, &mut r) == -9223372036854775808)
    assert(read_u64_le(&buf, &mut r) == 18446744073709551615)
    assert(read_varint(&buf, &mut r) == 0)
    assert(read_varint(&buf, &mut r) == -1)
    assert(read_varint(&buf, &mut r) == 42)
    assert(read_varint(&buf, &mut r) == -9223372036854775808)
    assert(read_varint(&buf, &mut r) == 9223372036854775807)
    assert(read_f64(&buf, &mut r) == -3.5)
    assert(read_str(&buf, &mut r) == "dunder åäö 🌍")
    got := read_bytes(&buf, &mut r)
    assert(got.len == 3 && got[0] == 0 && got[1] == 255 && got[2] == 17)
    assert(finish(&buf, &r))

    // Extra read past end marks truncated error without trapping.
    _ := read_u8(&buf, &mut r)
    assert(!r.ok && r.error == 1)
}
