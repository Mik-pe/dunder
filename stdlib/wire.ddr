import std.bytes as bytes

pub struct Reader {
    pos: i32,
    ok: bool,
    error: i32,
}

impl Reader {
    pub fn new() -> Self { Self { pos: 0, ok: true, error: 0 } }

    pub fn remaining(&self, buf: &[]u8) -> i32 {
        if !self.ok || self.pos > buf.len { return 0 }
        buf.len - self.pos
    }

    pub fn finish(&self, buf: &[]u8) -> bool {
        self.ok && self.pos == buf.len
    }

    fn fail_read(&mut self, err: i32) {
        if self.ok { self.ok = false; self.error = err }
    }

    pub fn read_u8(&mut self, buf: &[]u8) -> u8 {
        if !self.ok { return 0 }
        if self.pos >= buf.len { self.fail_read(1); return 0 }
        b := buf[self.pos]
        self.pos += 1
        b
    }

    pub fn read_bool(&mut self, buf: &[]u8) -> bool {
        b := self.read_u8(&buf)
        if !self.ok { return false }
        if b == 0 { return false }
        if b == 1 { return true }
        self.fail_read(2)
        false
    }

    pub fn read_u16_le(&mut self, buf: &[]u8) -> u16 {
        if !self.ok { return 0 }
        if self.pos + 2 > buf.len { self.fail_read(1); return 0 }
        v := u16(bytes.u16_le(&buf, self.pos))
        self.pos += 2
        v
    }

    pub fn read_i32_le(&mut self, buf: &[]u8) -> i32 {
        if !self.ok { return 0 }
        if self.pos + 4 > buf.len { self.fail_read(1); return 0 }
        value := bytes.i32_le(&buf, self.pos)
        self.pos += 4
        value
    }

    pub fn read_u32_le(&mut self, buf: &[]u8) -> u32 {
        if !self.ok { return 0 }
        if self.pos + 4 > buf.len { self.fail_read(1); return 0 }
        raw := bytes.u32_le(&buf, self.pos)
        self.pos += 4
        u32(raw)
    }

    pub fn read_i64_le(&mut self, buf: &[]u8) -> i64 {
        if !self.ok { return 0 }
        if self.pos + 8 > buf.len { self.fail_read(1); return 0 }
        v := bytes.i64_le(&buf, self.pos)
        self.pos += 8
        v
    }

    pub fn read_u64_le(&mut self, buf: &[]u8) -> u64 {
        if !self.ok { return 0 }
        if self.pos + 8 > buf.len { self.fail_read(1); return 0 }
        v := bytes.u64_le(&buf, self.pos)
        self.pos += 8
        v
    }

    pub fn read_f32(&mut self, buf: &[]u8) -> f32 {
        bits := self.read_i32_le(&buf)
        if !self.ok { return 0.0 }
        f32.from_bits(bits)
    }

    pub fn read_f64(&mut self, buf: &[]u8) -> f64 {
        bits := self.read_i64_le(&buf)
        if !self.ok { return 0.0 }
        f64.from_bits(bits)
    }

    pub fn read_uvarint(&mut self, buf: &[]u8) -> u64 {
        if !self.ok { return 0 }
        mut result: u64 = 0
        mut shift := 0
        for i in 0..10 {
            if self.pos >= buf.len { self.fail_read(1); return 0 }
            b := buf[self.pos]
            self.pos += 1
            if i == 9 && b > 1 { self.fail_read(2); return 0 }
            result = result.bit_or(u64(b.bit_and(127)).shl(shift))
            if b < 128 { return result }
            shift += 7
        }
        self.fail_read(2)
        0
    }

    pub fn read_varint(&mut self, buf: &[]u8) -> i64 {
        zz := self.read_uvarint(&buf)
        if !self.ok { return 0 }
        half := zz.shr(1)
        if zz.bit_and(1) != 0 {
            return -i64(half) - 1
        }
        i64(half)
    }

    fn read_count(&mut self, buf: &[]u8) -> i32 {
        n := self.read_uvarint(&buf)
        if !self.ok { return -1 }
        if n > u64(buf.len - self.pos) { self.fail_read(1); return -1 }
        i32(n)
    }

    pub fn read_bytes(&mut self, buf: &[]u8) -> []u8 {
        count := self.read_count(&buf)
        if count < 0 { return [] }
        mut out: []u8 = []
        bytes.extend_range(&mut out, &buf, self.pos, self.pos + count)
        self.pos += count
        out
    }

    pub fn read_str(&mut self, buf: &[]u8) -> string {
        count := self.read_count(&buf)
        if count < 0 { return "" }
        dec := match bytes.decode_range(&buf, self.pos, self.pos + count) {
            .Ok(value) => value,
            .Err(_) => { self.fail_read(92); return "" },
        }
        self.pos += count
        dec
    }
}

pub fn put_u8(out: &mut []u8, v: u8) { out.push(v) }

pub fn put_bool(out: &mut []u8, v: bool) {
    if v { out.push(1) } else { out.push(0) }
}

pub fn put_u16_le(out: &mut []u8, v: u16) {
    bytes.append_le(&mut out, i64(v), 2)
}

pub fn put_i32_le(out: &mut []u8, v: i32) {
    bytes.append_le(&mut out, i64(v), 4)
}

pub fn put_u32_le(out: &mut []u8, v: u32) {
    bytes.append_le(&mut out, i64(v), 4)
}

pub fn put_i64_le(out: &mut []u8, v: i64) {
    bytes.append_le(&mut out, v, 8)
}

pub fn put_u64_le(out: &mut []u8, v: u64) {
    for i in 0..8 {
        out.push(u8(v.shr(i * 8).bit_and(255)))
    }
}

pub fn put_f32(out: &mut []u8, v: f32) {
    bits := v.to_bits()
    bytes.append_le(&mut out, i64(bits), 4)
}

pub fn put_f64(out: &mut []u8, v: f64) {
    bits := v.to_bits()
    bytes.append_le(&mut out, bits, 8)
}

pub fn put_uvarint(out: &mut []u8, value: u64) {
    mut v := value
    while v >= 128 {
        out.push(u8(v.bit_and(127).bit_or(128)))
        v = v.shr(7)
    }
    out.push(u8(v))
}

pub fn put_varint(out: &mut []u8, value: i64) {
    mut zz: u64 = 0
    if value < 0 {
        zz = u64(-(value + 1)).shl(1).bit_or(1)
    } else {
        zz = u64(value).shl(1)
    }
    put_uvarint(&mut out, zz)
}

pub fn put_bytes(out: &mut []u8, data: &[]u8) {
    put_uvarint(&mut out, u64(data.len))
    bytes.extend(&mut out, &data)
}

pub fn put_str(out: &mut []u8, text: string) {
    put_uvarint(&mut out, u64(text.len))
    bytes.append_utf8(&mut out, text)
}

impl Default for Reader {
    fn default() -> Self { Self::new() }
}

pub trait Encode {
    fn encode_wire(&self, out: &mut []u8)
}

pub trait Decode {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32>
}

impl Encode for bool {
    fn encode_wire(&self, out: &mut []u8) { put_bool(&mut out, self) }
}
impl Decode for bool {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_bool(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for u8 {
    fn encode_wire(&self, out: &mut []u8) { put_u8(&mut out, self) }
}
impl Decode for u8 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_u8(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for u16 {
    fn encode_wire(&self, out: &mut []u8) { put_u16_le(&mut out, self) }
}
impl Decode for u16 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_u16_le(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for u32 {
    fn encode_wire(&self, out: &mut []u8) { put_u32_le(&mut out, self) }
}
impl Decode for u32 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_u32_le(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for u64 {
    fn encode_wire(&self, out: &mut []u8) { put_u64_le(&mut out, self) }
}
impl Decode for u64 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_u64_le(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for i32 {
    fn encode_wire(&self, out: &mut []u8) { put_i32_le(&mut out, self) }
}
impl Decode for i32 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_i32_le(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for i64 {
    fn encode_wire(&self, out: &mut []u8) { put_i64_le(&mut out, self) }
}
impl Decode for i64 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_i64_le(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for f32 {
    fn encode_wire(&self, out: &mut []u8) { put_f32(&mut out, self) }
}
impl Decode for f32 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_f32(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for f64 {
    fn encode_wire(&self, out: &mut []u8) { put_f64(&mut out, self) }
}
impl Decode for f64 {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_f64(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for string {
    fn encode_wire(&self, out: &mut []u8) { put_str(&mut out, self) }
}
impl Decode for string {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        v := r.read_str(&buf)
        if !r.ok { return .Err(r.error) }
        .Ok(v)
    }
}

impl Encode for []T where T: Encode {
    fn encode_wire(&self, out: &mut []u8) {
        put_uvarint(&mut out, u64(self.len))
        for i in 0..self.len { self[i].encode_wire(&mut out) }
    }
}
impl Decode for []T where T: Decode {
    fn decode_wire(r: &mut Reader, buf: &[]u8) -> Result<Self, i32> {
        raw := r.read_uvarint(&buf)
        if !r.ok { return .Err(r.error) }
        if raw > u64(r.remaining(&buf)) { r.fail_read(1); return .Err(1) }
        count := i32(raw)
        mut out: []T = []
        out.reserve(count)
        for _ in 0..count {
            item := T::decode_wire(&mut r, &buf)
            match move item {
                .Ok(v) => { out.push(move v) },
                .Err(err) => { return .Err(err) },
            }
        }
        .Ok(out)
    }
}

pub fn encode<T: Encode + Storable>(out: &mut []u8, value: &T) {
    value.encode_wire(&mut out)
}

pub fn decode<T: Decode + Storable>(r: &mut Reader, buf: &[]u8) -> Result<T, i32> {
    T::decode_wire(&mut r, &buf)
}

@test
fn wire_reader_methods_round_trip() {
    mut buf: []u8 = []
    put_varint(&mut buf, -7)
    put_str(&mut buf, "hi")
    mut r := Reader::new()
    assert(r.remaining(&buf) > 0)
    assert(r.read_varint(&buf) == -7)
    assert(r.read_str(&buf) == "hi")
    assert(r.finish(&buf))
}

@test
fn wire_round_trips_scalars_strings_extremes_and_rejects_truncation() {
    mut buf: []u8 = []
    put_bool(&mut buf, true)
    put_bool(&mut buf, false)
    put_i32_le(&mut buf, -2147483648)
    put_u32_le(&mut buf, 4294967295)
    put_i64_le(&mut buf, -9223372036854775808)
    put_u64_le(&mut buf, 18446744073709551615)
    put_varint(&mut buf, 0)
    put_varint(&mut buf, -1)
    put_varint(&mut buf, 42)
    put_varint(&mut buf, -9223372036854775808)
    put_varint(&mut buf, 9223372036854775807)
    put_f64(&mut buf, -3.5)
    put_str(&mut buf, "dunder åäö 🌍")
    mut raw: []u8 = [0, 255, 17]
    put_bytes(&mut buf, &raw)

    mut r := Reader::new()
    assert(r.read_bool(&buf))
    assert(!r.read_bool(&buf))
    assert(r.read_i32_le(&buf) == -2147483648)
    assert(r.read_u32_le(&buf) == 4294967295)
    assert(r.read_i64_le(&buf) == -9223372036854775808)
    assert(r.read_u64_le(&buf) == 18446744073709551615)
    assert(r.read_varint(&buf) == 0)
    assert(r.read_varint(&buf) == -1)
    assert(r.read_varint(&buf) == 42)
    assert(r.read_varint(&buf) == -9223372036854775808)
    assert(r.read_varint(&buf) == 9223372036854775807)
    assert(r.read_f64(&buf) == -3.5)
    assert(r.read_str(&buf) == "dunder åäö 🌍")
    got := r.read_bytes(&buf)
    assert(got.len == 3 && got[0] == 0 && got[1] == 255 && got[2] == 17)
    assert(r.finish(&buf))

    _ := r.read_u8(&buf)
    assert(!r.ok && r.error == 1)

    mut encoded: []u8 = []
    encode<[]string>(&mut encoded, &["alpha", "åäö"])
    encode<i32>(&mut encoded, -42)
    mut dec := Reader::default()
    match decode<[]string>(&mut dec, &encoded) {
        .Ok(xs) => assert(xs == ["alpha", "åäö"]),
        .Err(_) => assert(false),
    }
    assert(decode<i32>(&mut dec, &encoded) == .Ok(-42))
    assert(dec.finish(&encoded))
}
