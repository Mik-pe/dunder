pub fn min<T: Ord + Storable>(move a: T, move b: T) -> T {
    if a.cmp(b) != Ordering.Greater { a } else { b }
}

pub fn max<T: Ord + Storable>(move a: T, move b: T) -> T {
    if a.cmp(b) != Ordering.Less { a } else { b }
}

pub fn clamp<T: Ord + Storable>(move value: T, move low: T, move high: T) -> T {
    assert(low.cmp(high) != Ordering.Greater)
    if value.cmp(low) == Ordering.Less { return low }
    if value.cmp(high) == Ordering.Greater { return high }
    value
}

pub struct Reverse<T> where T: Storable {
    value: T,
}

impl Reverse<T> {
    pub fn new(move value: T) -> Self { Self { value: value } }
    pub fn into_inner(move self) -> T { self.value }
}

impl Eq for Reverse<T> where T: Eq {
    fn eq(&self, other: &Self) -> bool { self.value.eq(other.value) }
}

impl Ord for Reverse<T> where T: Ord {
    fn cmp(&self, other: &Self) -> Ordering { other.value.cmp(self.value) }
}

impl Hash for Reverse<T> where T: Hash {
    fn hash(&self) -> u64 { self.value.hash() }
}

impl Display for Reverse<T> where T: Display {
    fn str(&self) -> string { self.value.str() }
}

impl Default for Reverse<T> where T: Default {
    fn default() -> Self { Self { value: T::default() } }
}

impl Sendable for Reverse<T> where T: Sendable {}

@test
fn ordering_and_bounds_cover_min_max_clamp_and_reverse() {
    assert(min<i32>(3, 7) == 3)
    assert(min<i32>(7, 3) == 3)
    assert(max<i32>(3, 7) == 7)
    assert(max<string>("alpha", "beta") == "beta")
    assert(min<string>("alpha", "beta") == "alpha")
    assert(clamp<i64>(-5, 0, 10) == 0)
    assert(clamp<i64>(5, 0, 10) == 5)
    assert(clamp<i64>(25, 0, 10) == 10)

    a := Reverse<i32>::new(10)
    b := Reverse<i32>::new(20)
    assert(a > b)
    assert(b < a)
    assert(a != b)
    assert(a == Reverse<i32>::new(10))
    assert(a.str() == "10")
    assert(Reverse<i32>::default().into_inner() == 0)
    assert(Ordering.Less < Ordering.Equal && Ordering.Equal < Ordering.Greater)
    assert(Ordering.Less.str() == "Less")
    assert(Ordering::default() == Ordering.Equal)
}
