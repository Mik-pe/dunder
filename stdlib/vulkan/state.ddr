capability unsafe

import std.vulkan.api as vk
import std.vulkan.sdl as sdl

@c_layout
pub struct Buffer {
    handle: ptr,
    memory: ptr,
    mapped: ptr,
}

@c_layout
pub struct MemoryProperties {
    typeCount: u32,
    // 32 VkMemoryType entries, each propertyFlags followed by heapIndex.
    types: [u32; 64],
    heapCount: u32,
    heaps: [u64; 32],
}

// VkPhysicalDeviceProperties has a stable Vulkan 1.0 layout. Reserve aligned
// space for its limits and sparse properties; only its deviceName is consumed.
@c_layout
pub struct Properties {
    apiVersion: u32, driverVersion: u32, vendorID: u32, deviceID: u32, deviceType: u32,
    deviceName: [u8; 256],
    rest: [u64; 128],
}

@c_layout
pub struct Renderer {
    api: vk.Api,
    loader: ptr,
    instance: ptr,
    physical: ptr,
    device: ptr,
    queue: ptr,
    family: u32,
    properties: Properties,
    memoryProperties: MemoryProperties,
    pool: ptr,
    command: ptr,
    image: ptr,
    imageMemory: ptr,
    imageView: ptr,
    renderPass: ptr,
    framebuffer: ptr,
    pipelineLayout: ptr,
    pipeline: ptr,
    vertexShader: ptr,
    fragmentShader: ptr,
    vertex: Buffer,
    readback: Buffer,
    width: i32,
    height: i32,
    frames: i64,
    firstPoll: u32,
    startMillis: i64,
    window: sdl.Window,
}
