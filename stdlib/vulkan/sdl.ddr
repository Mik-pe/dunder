capability unsafe

import std.dl as dl

// SDL owns the window, input and final software blit. Vulkan supplies the pixels.
@c_layout
pub struct Window {
    library: ptr,
    handle: ptr,
    id: u32,
    initialized: u32,
    closed: u32,
    resized: u32,
    down: u32,
    key: i32,
    x: i32,
    y: i32,
    width: i32,
    height: i32,
    InitSubSystem: extern fn(u32) -> i32,
    QuitSubSystem: extern fn(u32),
    CreateWindow: extern fn(ptr, i32, i32, i32, i32, u32) -> ptr,
    DestroyWindow: extern fn(ptr),
    GetWindowSurface: extern fn(ptr) -> ptr,
    CreateRGBSurfaceFrom: extern fn(ptr, i32, i32, i32, i32, u32, u32, u32, u32) -> ptr,
    UpperBlitScaled: extern fn(ptr, ptr, ptr, ptr) -> i32,
    UpdateWindowSurface: extern fn(ptr) -> i32,
    FreeSurface: extern fn(ptr),
    PollEvent: extern fn(ptr) -> i32,
    GetWindowSize: extern fn(ptr, ptr, ptr),
    GetWindowID: extern fn(ptr) -> u32,
    SetSurfaceBlendMode: extern fn(ptr, i32) -> i32,
}

unsafe fn load(w: &mut Window) -> bool {
    w.library = dl.open(cstr("libSDL2-2.0.so.0"), 2)
    if w.library == ptr(0) { return false }
    var symbol := ptr(0)
    symbol = dl.symbol(w.library, cstr("SDL_InitSubSystem"))
    if symbol == ptr(0) { return false }
    w.InitSubSystem = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_QuitSubSystem"))
    if symbol == ptr(0) { return false }
    w.QuitSubSystem = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_CreateWindow"))
    if symbol == ptr(0) { return false }
    w.CreateWindow = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_DestroyWindow"))
    if symbol == ptr(0) { return false }
    w.DestroyWindow = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_GetWindowSurface"))
    if symbol == ptr(0) { return false }
    w.GetWindowSurface = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_CreateRGBSurfaceFrom"))
    if symbol == ptr(0) { return false }
    w.CreateRGBSurfaceFrom = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_UpperBlitScaled"))
    if symbol == ptr(0) { return false }
    w.UpperBlitScaled = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_UpdateWindowSurface"))
    if symbol == ptr(0) { return false }
    w.UpdateWindowSurface = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_FreeSurface"))
    if symbol == ptr(0) { return false }
    w.FreeSurface = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_PollEvent"))
    if symbol == ptr(0) { return false }
    w.PollEvent = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_GetWindowSize"))
    if symbol == ptr(0) { return false }
    w.GetWindowSize = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_GetWindowID"))
    if symbol == ptr(0) { return false }
    w.GetWindowID = ffi_fn(symbol)
    symbol = dl.symbol(w.library, cstr("SDL_SetSurfaceBlendMode"))
    if symbol == ptr(0) { return false }
    w.SetSurfaceBlendMode = ffi_fn(symbol)
    true
}

pub unsafe fn open(w: &mut Window, title: string, width: i32, height: i32) -> bool {
    if title.len > 4095 { return false }
    var name: []u8 = []
    name.reserve(title.len + 1)
    for byte in title.bytes() {
        if byte == 0 { return false }
        name.push(u8(byte))
    }
    name.push(0)
    if !load(&mut w) { return false }
    if w.InitSubSystem(32) != 0 { return false }
    w.initialized = 1
    w.handle = w.CreateWindow(addr(&name[0]), 805240832, 805240832, width, height, 36)
    if w.handle == ptr(0) { return false }
    w.id = w.GetWindowID(w.handle)
    w.width = width
    w.height = height
    w.resized = 1
    true
}

pub unsafe fn close(w: &mut Window) {
    if w.handle != ptr(0) { w.DestroyWindow(w.handle) }
    if w.initialized != 0 { w.QuitSubSystem(32) }
    if w.library != ptr(0) { closed := dl.close(w.library) }
}

pub unsafe fn poll(w: &mut Window) {
    w.key = -1
    w.resized = 0
    if w.closed != 0 { return }
    // SDL_Event is a tagged 56-byte union on 64-bit targets. One control
    // event per frame preserves key and button transitions for the caller.
    var event: [u64; 7] = [0; 7]
    base := addr(&mut event[0])
    for i in 0..256 {
        if w.PollEvent(base) == 0 { break }
        kind := load_u32(base)
        if kind == 256 { w.closed = 1; w.down = 0; break }
        if load_u32(ptr(usize(base) + 8)) == w.id {
            if kind == 512 {
                action := load_u8(ptr(usize(base) + 12))
                if action == 14 { w.closed = 1; w.down = 0; break }
                if action == 5 || action == 6 { w.resized = 1; break }
                if action == 13 { w.down = 0; break }
            }
            if kind == 768 { w.key = load_i32(ptr(usize(base) + 20)); break }
            if kind == 1024 || ((kind == 1025 || kind == 1026) && load_u8(ptr(usize(base) + 16)) == 1) {
                w.x = load_i32(ptr(usize(base) + 20))
                w.y = load_i32(ptr(usize(base) + 24))
                if kind == 1024 { w.down = u32(i32(load_u32(ptr(usize(base) + 16))).bit_and(1)) }
                else { w.down = u32(load_u8(ptr(usize(base) + 17))) }
                break
            }
        }
    }
    w.GetWindowSize(w.handle, addr(&mut w.width), addr(&mut w.height))
}

pub unsafe fn present(w: &Window, pixels: ptr, width: i32, height: i32) -> bool {
    surface := w.GetWindowSurface(w.handle)
    if surface == ptr(0) { return false }
    image := w.CreateRGBSurfaceFrom(pixels, width, height, 32, width * 4, 255, 65280, 16711680, 4278190080)
    if image == ptr(0) { return false }
    var ok := w.SetSurfaceBlendMode(image, 0) == 0
    if ok { ok = w.UpperBlitScaled(image, ptr(0), surface, ptr(0)) == 0 }
    w.FreeSurface(image)
    ok && w.UpdateWindowSurface(w.handle) == 0
}
