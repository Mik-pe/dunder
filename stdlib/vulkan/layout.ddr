// Native Vulkan structures passed by address. Field names match the Vulkan headers.

@c_layout
pub struct ApplicationInfo {
    sType: u32,
    pNext: ptr,
    pApplicationName: ptr,
    applicationVersion: u32,
    pEngineName: ptr,
    engineVersion: u32,
    apiVersion: u32,
}

@c_layout
pub struct InstanceCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    pApplicationInfo: ptr,
    enabledLayerCount: u32,
    ppEnabledLayerNames: ptr,
    enabledExtensionCount: u32,
    ppEnabledExtensionNames: ptr,
}

@c_layout
pub struct DeviceQueueCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    queueFamilyIndex: u32,
    queueCount: u32,
    pQueuePriorities: ptr,
}

@c_layout
pub struct DeviceCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    queueCreateInfoCount: u32,
    pQueueCreateInfos: ptr,
    enabledLayerCount: u32,
    ppEnabledLayerNames: ptr,
    enabledExtensionCount: u32,
    ppEnabledExtensionNames: ptr,
    pEnabledFeatures: ptr,
}

@c_layout
pub struct CommandPoolCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    queueFamilyIndex: u32,
}

@c_layout
pub struct CommandBufferAllocateInfo {
    sType: u32,
    pNext: ptr,
    commandPool: ptr,
    level: u32,
    commandBufferCount: u32,
}

@c_layout
pub struct ImageCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    imageType: u32,
    format: u32,
    extent: Extent3D,
    mipLevels: u32,
    arrayLayers: u32,
    samples: u32,
    tiling: u32,
    usage: u32,
    sharingMode: u32,
    queueFamilyIndexCount: u32,
    pQueueFamilyIndices: ptr,
    initialLayout: u32,
}

@c_layout
pub struct Extent3D {
    width: u32,
    height: u32,
    depth: u32,
}

@c_layout
pub struct MemoryRequirements {
    size: u64,
    alignment: u64,
    memoryTypeBits: u32,
}

@c_layout
pub struct MemoryAllocateInfo {
    sType: u32,
    pNext: ptr,
    allocationSize: u64,
    memoryTypeIndex: u32,
}

@c_layout
pub struct ImageViewCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    image: ptr,
    viewType: u32,
    format: u32,
    components: ComponentMapping,
    subresourceRange: ImageSubresourceRange,
}

@c_layout
pub struct ComponentMapping {
    r: u32,
    g: u32,
    b: u32,
    a: u32,
}

@c_layout
pub struct ImageSubresourceRange {
    aspectMask: u32,
    baseMipLevel: u32,
    levelCount: u32,
    baseArrayLayer: u32,
    layerCount: u32,
}

@c_layout
pub struct AttachmentDescription {
    flags: u32,
    format: u32,
    samples: u32,
    loadOp: u32,
    storeOp: u32,
    stencilLoadOp: u32,
    stencilStoreOp: u32,
    initialLayout: u32,
    finalLayout: u32,
}

@c_layout
pub struct AttachmentReference {
    attachment: u32,
    layout: u32,
}

@c_layout
pub struct SubpassDescription {
    flags: u32,
    pipelineBindPoint: u32,
    inputAttachmentCount: u32,
    pInputAttachments: ptr,
    colorAttachmentCount: u32,
    pColorAttachments: ptr,
    pResolveAttachments: ptr,
    pDepthStencilAttachment: ptr,
    preserveAttachmentCount: u32,
    pPreserveAttachments: ptr,
}

@c_layout
pub struct SubpassDependency {
    srcSubpass: u32,
    dstSubpass: u32,
    srcStageMask: u32,
    dstStageMask: u32,
    srcAccessMask: u32,
    dstAccessMask: u32,
    dependencyFlags: u32,
}

@c_layout
pub struct RenderPassCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    attachmentCount: u32,
    pAttachments: ptr,
    subpassCount: u32,
    pSubpasses: ptr,
    dependencyCount: u32,
    pDependencies: ptr,
}

@c_layout
pub struct FramebufferCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    renderPass: ptr,
    attachmentCount: u32,
    pAttachments: ptr,
    width: u32,
    height: u32,
    layers: u32,
}

@c_layout
pub struct ShaderModuleCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    codeSize: usize,
    pCode: ptr,
}

@c_layout
pub struct PipelineLayoutCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    setLayoutCount: u32,
    pSetLayouts: ptr,
    pushConstantRangeCount: u32,
    pPushConstantRanges: ptr,
}

@c_layout
pub struct PipelineShaderStageCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    stage: u32,
    module: ptr,
    pName: ptr,
    pSpecializationInfo: ptr,
}

@c_layout
pub struct VertexInputBindingDescription {
    binding: u32,
    stride: u32,
    inputRate: u32,
}

@c_layout
pub struct VertexInputAttributeDescription {
    location: u32,
    binding: u32,
    format: u32,
    offset: u32,
}

@c_layout
pub struct PipelineVertexInputStateCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    vertexBindingDescriptionCount: u32,
    pVertexBindingDescriptions: ptr,
    vertexAttributeDescriptionCount: u32,
    pVertexAttributeDescriptions: ptr,
}

@c_layout
pub struct PipelineInputAssemblyStateCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    topology: u32,
    primitiveRestartEnable: u32,
}

@c_layout
pub struct PipelineViewportStateCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    viewportCount: u32,
    pViewports: ptr,
    scissorCount: u32,
    pScissors: ptr,
}

@c_layout
pub struct Viewport {
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    minDepth: f32,
    maxDepth: f32,
}

@c_layout
pub struct Rect2D {
    offset: Offset2D,
    extent: Extent2D,
}

@c_layout
pub struct Offset2D {
    x: i32,
    y: i32,
}

@c_layout
pub struct Extent2D {
    width: u32,
    height: u32,
}

@c_layout
pub struct PipelineRasterizationStateCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    depthClampEnable: u32,
    rasterizerDiscardEnable: u32,
    polygonMode: u32,
    cullMode: u32,
    frontFace: u32,
    depthBiasEnable: u32,
    depthBiasConstantFactor: f32,
    depthBiasClamp: f32,
    depthBiasSlopeFactor: f32,
    lineWidth: f32,
}

@c_layout
pub struct PipelineMultisampleStateCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    rasterizationSamples: u32,
    sampleShadingEnable: u32,
    minSampleShading: f32,
    pSampleMask: ptr,
    alphaToCoverageEnable: u32,
    alphaToOneEnable: u32,
}

@c_layout
pub struct PipelineColorBlendStateCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    logicOpEnable: u32,
    logicOp: u32,
    attachmentCount: u32,
    pAttachments: ptr,
    blendConstants: [f32; 4],
}

@c_layout
pub struct PipelineColorBlendAttachmentState {
    blendEnable: u32,
    srcColorBlendFactor: u32,
    dstColorBlendFactor: u32,
    colorBlendOp: u32,
    srcAlphaBlendFactor: u32,
    dstAlphaBlendFactor: u32,
    alphaBlendOp: u32,
    colorWriteMask: u32,
}

@c_layout
pub struct GraphicsPipelineCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    stageCount: u32,
    pStages: ptr,
    pVertexInputState: ptr,
    pInputAssemblyState: ptr,
    pTessellationState: ptr,
    pViewportState: ptr,
    pRasterizationState: ptr,
    pMultisampleState: ptr,
    pDepthStencilState: ptr,
    pColorBlendState: ptr,
    pDynamicState: ptr,
    layout: ptr,
    renderPass: ptr,
    subpass: u32,
    basePipelineHandle: ptr,
    basePipelineIndex: i32,
}

@c_layout
pub struct BufferCreateInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    size: u64,
    usage: u32,
    sharingMode: u32,
    queueFamilyIndexCount: u32,
    pQueueFamilyIndices: ptr,
}

@c_layout
pub struct CommandBufferBeginInfo {
    sType: u32,
    pNext: ptr,
    flags: u32,
    pInheritanceInfo: ptr,
}

@c_layout
pub struct RenderPassBeginInfo {
    sType: u32,
    pNext: ptr,
    renderPass: ptr,
    framebuffer: ptr,
    renderArea: Rect2D,
    clearValueCount: u32,
    pClearValues: ptr,
}

@c_layout
pub struct BufferImageCopy {
    bufferOffset: u64,
    bufferRowLength: u32,
    bufferImageHeight: u32,
    imageSubresource: ImageSubresourceLayers,
    imageOffset: Offset3D,
    imageExtent: Extent3D,
}

@c_layout
pub struct ImageSubresourceLayers {
    aspectMask: u32,
    mipLevel: u32,
    baseArrayLayer: u32,
    layerCount: u32,
}

@c_layout
pub struct Offset3D {
    x: i32,
    y: i32,
    z: i32,
}

@c_layout
pub struct MemoryBarrier {
    sType: u32,
    pNext: ptr,
    srcAccessMask: u32,
    dstAccessMask: u32,
}

@c_layout
pub struct SubmitInfo {
    sType: u32,
    pNext: ptr,
    waitSemaphoreCount: u32,
    pWaitSemaphores: ptr,
    pWaitDstStageMask: ptr,
    commandBufferCount: u32,
    pCommandBuffers: ptr,
    signalSemaphoreCount: u32,
    pSignalSemaphores: ptr,
}

