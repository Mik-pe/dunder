capability unsafe

import std.vulkan.layout as vk
import std.vulkan.state as state

unsafe fn create_device(r: &mut state.Renderer) -> bool {
    var app: vk.ApplicationInfo = zeroed()
    app.apiVersion = 4194304
    var instance: vk.InstanceCreateInfo = zeroed()
    instance.sType = 1
    instance.pApplicationInfo = addr(&app)
    if r.api.CreateInstance(addr(&instance), ptr(0), addr(&mut r.instance)) != 0 { return false }

    // The first available device is sufficient. VK_INCOMPLETE is expected
    // when another device exists after the first one.
    var count: u32 = 1
    status := r.api.EnumeratePhysicalDevices(r.instance, addr(&mut count), addr(&mut r.physical))
    if (status != 0 && status != 5) || count == 0 { return false }
    r.api.GetPhysicalDeviceProperties(r.physical, addr(&mut r.properties))
    r.api.GetPhysicalDeviceMemoryProperties(r.physical, addr(&mut r.memoryProperties))
    // QueueFamilyProperties contains six u32 words, with flags and count first.
    var families: [u32; 192] = [0; 192]
    count = 32
    r.api.GetPhysicalDeviceQueueFamilyProperties(r.physical, addr(&mut count), addr(&mut families[0]))
    var family := 0
    while family < i32(count) {
        if i32(families[family * 6]).bit_and(1) != 0 && families[family * 6 + 1] > 0 { break }
        family = family + 1
    }
    if family == i32(count) { return false }
    r.family = u32(family)
    priority: f32 = 1.0
    var q: vk.DeviceQueueCreateInfo = zeroed()
    q.sType = 2
    q.queueFamilyIndex = r.family
    q.queueCount = 1
    q.pQueuePriorities = addr(&priority)
    var device: vk.DeviceCreateInfo = zeroed()
    device.sType = 3
    device.queueCreateInfoCount = 1
    device.pQueueCreateInfos = addr(&q)
    if r.api.CreateDevice(r.physical, addr(&device), ptr(0), addr(&mut r.device)) != 0 { return false }
    r.api.GetDeviceQueue(r.device, r.family, 0, addr(&mut r.queue))
    var pool: vk.CommandPoolCreateInfo = zeroed()
    pool.sType = 39
    pool.flags = 2
    pool.queueFamilyIndex = r.family
    if r.api.CreateCommandPool(r.device, addr(&pool), ptr(0), addr(&mut r.pool)) != 0 { return false }
    var command: vk.CommandBufferAllocateInfo = zeroed()
    command.sType = 40
    command.commandPool = r.pool
    command.commandBufferCount = 1
    r.api.AllocateCommandBuffers(r.device, addr(&command), addr(&mut r.command)) == 0
}

unsafe fn allocate(r: &state.Renderer, requirements: &vk.MemoryRequirements, flags: i32, output: ptr) -> bool {
    var i := 0
    while i < i32(r.memoryProperties.typeCount) {
        bits := i32(requirements.memoryTypeBits)
        if bits.bit_and(i32(1).shl(i)) != 0 && i32(r.memoryProperties.types[i * 2]).bit_and(flags) == flags {
            var alloc: vk.MemoryAllocateInfo = zeroed()
            alloc.sType = 5
            alloc.allocationSize = requirements.size
            alloc.memoryTypeIndex = u32(i)
            return r.api.AllocateMemory(r.device, addr(&alloc), ptr(0), output) == 0
        }
        i = i + 1
    }
    false
}

unsafe fn buffer(r: &state.Renderer, b: &mut state.Buffer, size: u64, usage: u32) -> bool {
    var info: vk.BufferCreateInfo = zeroed()
    info.sType = 12
    info.size = size
    info.usage = usage
    if r.api.CreateBuffer(r.device, addr(&info), ptr(0), addr(&mut b.handle)) != 0 { return false }
    var requirements: vk.MemoryRequirements = zeroed()
    r.api.GetBufferMemoryRequirements(r.device, b.handle, addr(&mut requirements))
    if !allocate(&r, &requirements, 6, addr(&mut b.memory)) { return false }
    if r.api.BindBufferMemory(r.device, b.handle, b.memory, 0) != 0 { return false }
    r.api.MapMemory(r.device, b.memory, 0, size, 0, addr(&mut b.mapped)) == 0
}

pub unsafe fn setup(r: &mut state.Renderer) -> bool {
    if !create_device(&mut r) { return false }
    var image: vk.ImageCreateInfo = zeroed()
    image.sType = 14
    image.imageType = 1
    image.format = 37
    image.extent = vk.Extent3D {width: u32(r.width), height: u32(r.height), depth: 1}
    image.mipLevels = 1
    image.arrayLayers = 1
    image.samples = 1
    image.usage = 17
    if r.api.CreateImage(r.device, addr(&image), ptr(0), addr(&mut r.image)) != 0 { return false }
    var requirements: vk.MemoryRequirements = zeroed()
    r.api.GetImageMemoryRequirements(r.device, r.image, addr(&mut requirements))
    if !allocate(&r, &requirements, 0, addr(&mut r.imageMemory)) { return false }
    if r.api.BindImageMemory(r.device, r.image, r.imageMemory, 0) != 0 { return false }
    var view: vk.ImageViewCreateInfo = zeroed()
    view.sType = 15
    view.image = r.image
    view.viewType = 1
    view.format = 37
    view.subresourceRange.aspectMask = 1
    view.subresourceRange.levelCount = 1
    view.subresourceRange.layerCount = 1
    if r.api.CreateImageView(r.device, addr(&view), ptr(0), addr(&mut r.imageView)) != 0 { return false }
    // Both mapped allocations remain valid until queue idle and teardown.
    if !buffer(&r, ref_at(addr(&mut r.vertex)), 3200000, 128) { return false }
    buffer(&r, ref_at(addr(&mut r.readback)), u64(r.width * r.height * 4), 2)
}

pub unsafe fn destroy(r: &mut state.Renderer) {
    if r.device != ptr(0) {
        waited := r.api.DeviceWaitIdle(r.device)
        if r.vertex.mapped != ptr(0) { r.api.UnmapMemory(r.device, r.vertex.memory) }
        if r.readback.mapped != ptr(0) { r.api.UnmapMemory(r.device, r.readback.memory) }
        // Vulkan destruction commands accept VK_NULL_HANDLE for optional objects.
        r.api.DestroyBuffer(r.device, r.vertex.handle, ptr(0))
        r.api.DestroyBuffer(r.device, r.readback.handle, ptr(0))
        r.api.DestroyFramebuffer(r.device, r.framebuffer, ptr(0))
        r.api.DestroyPipeline(r.device, r.pipeline, ptr(0))
        r.api.DestroyPipelineLayout(r.device, r.pipelineLayout, ptr(0))
        r.api.DestroyShaderModule(r.device, r.vertexShader, ptr(0))
        r.api.DestroyShaderModule(r.device, r.fragmentShader, ptr(0))
        r.api.DestroyRenderPass(r.device, r.renderPass, ptr(0))
        r.api.DestroyImageView(r.device, r.imageView, ptr(0))
        r.api.DestroyImage(r.device, r.image, ptr(0))
        r.api.FreeMemory(r.device, r.vertex.memory, ptr(0))
        r.api.FreeMemory(r.device, r.readback.memory, ptr(0))
        r.api.FreeMemory(r.device, r.imageMemory, ptr(0))
        r.api.DestroyCommandPool(r.device, r.pool, ptr(0))
        r.api.DestroyDevice(r.device, ptr(0))
    }
    if r.instance != ptr(0) { r.api.DestroyInstance(r.instance, ptr(0)) }
}
