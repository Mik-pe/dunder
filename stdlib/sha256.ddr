import std.bytes as bytes
fn push_word(out: &mut []u8, v: i64) {
    out.push(u8(v.shr(24).bit_and(255)))
    out.push(u8(v.shr(16).bit_and(255)))
    out.push(u8(v.shr(8).bit_and(255)))
    out.push(u8(v.bit_and(255)))
}
// Hash a contiguous range without copying full message blocks.
pub fn digest_range(input: &[]u8, start: i32, length: i32) -> []u8 {
    assert(start >= 0 && start <= input.len && length >= 0 && length <= input.len - start)
    constants: [i64; 64] = [
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
    ]
    var h0: i64 = 1779033703; var h1: i64 = 3144134277
    var h2: i64 = 1013904242; var h3: i64 = 2773480762
    var h4: i64 = 1359893119; var h5: i64 = 2600822924
    var h6: i64 = 528734635; var h7: i64 = 1541459225
    full := length / 64
    remainder := length % 64
    var tail_length := 64
    if remainder >= 56 { tail_length = 128 }
    var tail: [u8; 128] = [0; 128]
    for i in 0..remainder { tail[i] = input[start + full * 64 + i] }
    tail[remainder] = 128
    bits := i64(length) * 8
    for i in 0..8 { tail[tail_length - 1 - i] = u8(bits.shr(i * 8).bit_and(255)) }

    var w: [i64; 64] = [0; 64]
    for block in 0..full + tail_length / 64 {
        if block < full {
            base := start + block * 64
            for i in 0..16 {
                at := base + 4 * i
                w[i] = i64(input[at]).shl(24).bit_or(i64(input[at + 1]).shl(16)).bit_or(i64(input[at + 2]).shl(8)).bit_or(i64(input[at + 3]))
            }
        } else {
            base := (block - full) * 64
            for i in 0..16 {
                at := base + 4 * i
                w[i] = i64(tail[at]).shl(24).bit_or(i64(tail[at + 1]).shl(16)).bit_or(i64(tail[at + 2]).shl(8)).bit_or(i64(tail[at + 3]))
            }
        }
        for i in 16..64 {
            a := w[i - 15]
            b := w[i - 2]
            // Repeating a 32-bit word in both halves makes each rotate a shift.
            doubled_a := a.bit_or(a.shl(32))
            doubled_b := b.bit_or(b.shl(32))
            s0 := doubled_a.shr(7).bit_xor(doubled_a.shr(18)).bit_xor(a.shr(3)).bit_and(4294967295)
            s1 := doubled_b.shr(17).bit_xor(doubled_b.shr(19)).bit_xor(b.shr(10)).bit_and(4294967295)
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1).bit_and(4294967295)
        }
        var a := h0; var b := h1; var c := h2; var d := h3
        var e := h4; var f := h5; var g := h6; var h := h7
        for i in 0..64 {
            doubled_e := e.bit_or(e.shl(32))
            doubled_a := a.bit_or(a.shl(32))
            s1 := doubled_e.shr(6).bit_xor(doubled_e.shr(11)).bit_xor(doubled_e.shr(25)).bit_and(4294967295)
            choose := g.bit_xor(e.bit_and(f.bit_xor(g)))
            first := h + s1 + choose + constants[i] + w[i]
            s0 := doubled_a.shr(2).bit_xor(doubled_a.shr(13)).bit_xor(doubled_a.shr(22)).bit_and(4294967295)
            majority := a.bit_and(b).bit_or(c.bit_and(a.bit_or(b)))
            second := s0 + majority
            h = g; g = f; f = e; e = (d + first).bit_and(4294967295)
            d = c; c = b; b = a; a = (first + second).bit_and(4294967295)
        }
        h0 = (h0 + a).bit_and(4294967295); h1 = (h1 + b).bit_and(4294967295)
        h2 = (h2 + c).bit_and(4294967295); h3 = (h3 + d).bit_and(4294967295)
        h4 = (h4 + e).bit_and(4294967295); h5 = (h5 + f).bit_and(4294967295)
        h6 = (h6 + g).bit_and(4294967295); h7 = (h7 + h).bit_and(4294967295)
    }
    var result: []u8 = []
    result.reserve(32)
    push_word(&mut result, h0); push_word(&mut result, h1); push_word(&mut result, h2); push_word(&mut result, h3)
    push_word(&mut result, h4); push_word(&mut result, h5); push_word(&mut result, h6); push_word(&mut result, h7)
    result
}
pub fn digest_bytes(input: &[]u8) -> []u8 {
    digest_range(&input, 0, input.len)
}
fn widen(input: &[]u8) -> []i32 {
    var result: []i32 = []
    result.reserve(input.len)
    for byte in input { result.push(i32(byte)) }
    result
}
pub fn digest(input: &[]i32) -> []i32 {
    var packed: []u8 = []
    packed.reserve(input.len)
    for byte in input {
        assert(byte >= 0 && byte <= 255)
        packed.push(u8(byte))
    }
    digest := digest_bytes(&packed)
    widen(&digest)
}
pub fn text(input: string) -> []i32 {
    var packed: []u8 = []
    packed.reserve(input.len)
    bytes.append_utf8(&mut packed, input)
    digest := digest_bytes(&packed)
    widen(&digest)
}
@test fn sha256_matches_empty_abc_and_multi_block_reference_vectors() {
    empty := text("")
    bytes.hex(&empty) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    abc := text("abc")
    bytes.hex(&abc) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    long := text("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    bytes.hex(&long) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
}
@test fn packed_ranges_match_sha256_at_padding_boundaries() {
    var input: []u8 = []
    for i in 0..132 { input.push(u8(i)) }
    lengths := [0, 55, 56, 63, 64, 65, 128]
    expected := [
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "4653ce834ad1216507f784697481e2134214fb99e203b0e247d86b941b660707",
        "1d742f4c8c512b0d2811d426f99ccdc16103332fac6c1ae4ffaa27535b2875bb",
        "191b2ec5f9d8dd469ce7ddc71e282a89ea317915b2f4b40e7138a7795ba1191f",
        "795430e15796923a557f9da1d980ec9db341e9acd6da682e1cd86303ce6b0b08",
        "40a81d14a50081b4fdf29d5fb626e24cafdc507026f2de40dec3b0370a0e591e",
        "db0d88f6150bf6e6a5d4ac9507b9a7a6b0d144e07e2e9ab67be9fe741788550c"
    ]
    for i in 0..lengths.len {
        packed := digest_range(&input, 3, lengths[i])
        wide := widen(&packed)
        assert(bytes.hex(&wide) == expected[i])
    }
}
