import std.bytes as bytes
fn word(value: i64) -> i64 { value.bit_and(4294967295) }
fn rotate(value: i64, count: i32) -> i64 { word(value.shr(count).bit_or(value.shl(32 - count))) }
// The compression input, SHA padding and digest are octets throughout.
pub fn digest_bytes(input: &[]u8) -> []u8 {
    constants: [i64; 64] = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
    var state: [i64; 8] = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
    var data := input
    bit_length := i64(data.len) * 8
    data.push(128)
    while data.len % 64 != 56 { data.push(0) }
    for i in 0..8 { data.push(u8(bit_length.shr((7 - i) * 8).bit_and(255))) }
    var start := 0
    while start < data.len {
        var w: [i64; 64] = [0; 64]
        for i in 0..16 {
            offset := start + i * 4
            w[i] = i64(data[offset]) * 16777216 + i64(data[offset + 1]) * 65536 + i64(data[offset + 2]) * 256 + i64(data[offset + 3])
        }
        for i in 16..64 {
            a := w[i - 15]
            b := w[i - 2]
            s0 := rotate(a, 7).bit_xor(rotate(a, 18)).bit_xor(a.shr(3))
            s1 := rotate(b, 17).bit_xor(rotate(b, 19)).bit_xor(b.shr(10))
            w[i] = word(w[i - 16] + s0 + w[i - 7] + s1)
        }
        var a := state[0]; var b := state[1]; var c := state[2]; var d := state[3]
        var e := state[4]; var f := state[5]; var g := state[6]; var h := state[7]
        for i in 0..64 {
            s1 := rotate(e, 6).bit_xor(rotate(e, 11)).bit_xor(rotate(e, 25))
            choose := e.bit_and(f).bit_xor(e.bit_not().bit_and(g))
            first := h + s1 + choose + constants[i] + w[i]
            s0 := rotate(a, 2).bit_xor(rotate(a, 13)).bit_xor(rotate(a, 22))
            majority := a.bit_and(b).bit_xor(a.bit_and(c)).bit_xor(b.bit_and(c))
            second := s0 + majority
            h = g; g = f; f = e; e = word(d + first)
            d = c; c = b; b = a; a = word(first + second)
        }
        state[0] = word(state[0] + a); state[1] = word(state[1] + b)
        state[2] = word(state[2] + c); state[3] = word(state[3] + d)
        state[4] = word(state[4] + e); state[5] = word(state[5] + f)
        state[6] = word(state[6] + g); state[7] = word(state[7] + h)
        start = start + 64
    }
    var result: []u8 = []
    result.reserve(32)
    for value in state { for i in 0..4 { result.push(u8(value.shr((3 - i) * 8).bit_and(255))) } }
    result
}
fn widen(input: &[]u8) -> []i32 {
    var result: []i32 = []
    result.reserve(input.len)
    for byte in input { result.push(i32(byte)) }
    result
}
pub fn digest(input: &[]i32) -> []i32 {
    var packed: []u8 = []
    packed.reserve(input.len)
    for byte in input {
        assert(byte >= 0 && byte <= 255)
        packed.push(u8(byte))
    }
    digest := digest_bytes(&packed)
    widen(&digest)
}
pub fn text(input: string) -> []i32 {
    var packed: []u8 = []
    bytes.append_utf8(&mut packed, input)
    digest := digest_bytes(&packed)
    widen(&digest)
}
@test fn sha256_matches_empty_abc_and_multi_block_reference_vectors() {
    empty := text("")
    bytes.hex(&empty) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    abc := text("abc")
    bytes.hex(&abc) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    long := text("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    bytes.hex(&long) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
}
