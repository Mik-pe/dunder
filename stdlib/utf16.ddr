pub fn append(output: &mut []u16, value: &str) {
    for scalar in value.runes() {
        code := i32(scalar)
        if code < 65536 { output.push(u16(code)) }
        else {
            pair := code - 65536
            output.push(u16(55296 + pair.shr(10)))
            output.push(u16(56320 + pair.bit_and(1023)))
        }
    }
}

pub fn terminated(value: string) -> []u16 {
    mut units: []u16 = []
    for i in 0..value.len { if value[i] == 0 { return [] } }
    append(&mut units, value.as_str())
    units.push(u16(0))
    units
}

@test fn append_preserves_zeros_and_supplementary_scalars() {
    mut result: []u16 = [7]
    append(&mut result, "")
    append(&mut result, "Ö🌍")
    append(&mut result, "a\0b")
    assert(result == [u16(7), 214, 55356, 57101, 97, 0, 98])
}
