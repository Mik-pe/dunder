import sys
// Packed byte storage is useful for files, UTF-8 and binary protocols.
pub fn packed() -> []u8 { [] }
pub fn append_utf8(output: &mut []u8, text: string) {
    output.reserve(output.len + text.len)
    for byte in text.bytes() { output.push(u8(byte)) }
}
pub fn extend(output: &mut []u8, input: &[]u8) {
    output.reserve(output.len + input.len)
    var i := 0
    while i < input.len { output.push(input[i]); i = i + 1 }
}
pub fn pad(output: &mut []u8, count: i32) {
    assert(count >= 0)
    output.reserve(output.len + count)
    for i in 0..count { output.push(0) }
}
pub fn append_le(output: &mut []u8, value: i64, width: i32) {
    assert(width >= 1 && width <= 8)
    for i in 0..width { output.push(u8(value.shr(i * 8).bit_and(255))) }
}
pub fn set_be(output: &mut []u8, offset: i32, value: i64, width: i32) {
    assert(width >= 1 && width <= 8 && offset >= 0 && offset <= output.len - width)
    for i in 0..width { output[offset + width - 1 - i] = u8(value.shr(i * 8).bit_and(255)) }
}
pub fn decode(input: &[]u8) -> sys.TextResult { sys.decode_u8(&input) }
pub fn decode_range(input: &[]u8, start: i32, end: i32) -> sys.TextResult {
    if start < 0 || end < start || end > input.len {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    sys.decode_u8_range(&input, i64(start), i64(end - start))
}
pub fn find_byte(input: &[]u8, start: i32, end: i32, needle: u8) -> i32 {
    var from := start
    if from < 0 { from = 0 }
    var limit := end
    if limit > input.len { limit = input.len }
    if from >= limit { return -1 }
    for i in from..limit {
        if input[i] == needle { return i }
    }
    -1
}
pub fn find_crlf(input: &[]u8, start: i32, end: i32) -> i32 {
    var from := start
    if from < 0 { from = 0 }
    var limit := end
    if limit > input.len { limit = input.len }
    if limit - from < 2 { return -1 }
    for i in from..(limit - 1) {
        if input[i] == b'\r' && input[i + 1] == b'\n' { return i }
    }
    -1
}
pub fn find_double_crlf(input: &[]u8, start: i32, end: i32) -> i32 {
    var from := start
    if from < 0 { from = 0 }
    var limit := end
    if limit > input.len { limit = input.len }
    if limit - from < 4 { return -1 }
    for i in from..(limit - 3) {
        if input[i] == b'\r' && input[i + 1] == b'\n' && input[i + 2] == b'\r' && input[i + 3] == b'\n' {
            return i
        }
    }
    -1
}
pub fn equals_text(input: &[]u8, start: i32, end: i32, expected: string) -> bool {
    if start < 0 || end < start || end > input.len || end - start != expected.len { return false }
    for i in 0..expected.len {
        if i32(input[start + i]) != expected[i] { return false }
    }
    true
}
pub fn equals_ascii_ci(input: &[]u8, start: i32, end: i32, expected_lower: string) -> bool {
    if start < 0 || end < start || end > input.len || end - start != expected_lower.len { return false }
    for i in 0..expected_lower.len {
        var b := i32(input[start + i])
        if b >= 65 && b <= 90 { b += 32 }
        if b != expected_lower[i] { return false }
    }
    true
}
pub fn extend_range(output: &mut []u8, input: &[]u8, start: i32, end: i32) {
    assert(start >= 0 && start <= end && end <= input.len)
    output.reserve(output.len + (end - start))
    for i in start..end { output.push(input[i]) }
}
pub fn consume_prefix(buf: &mut []u8, count: i32) {
    if count <= 0 { return }
    if count >= buf.len { buf.clear(); return }
    remaining := buf.len - count
    for i in 0..remaining { buf[i] = buf[i + count] }
    for i in 0..count { _ := buf.pop() }
}
pub fn append_decimal(output: &mut []u8, value: i64) {
    if value == 0 { output.push(b'0'); return }
    var v := value
    if v < 0 { output.push(b'-') }
    start := output.len
    while v != 0 {
        var d := v % 10
        if d < 0 { d = -d }
        output.push(u8(48 + i32(d)))
        v /= 10
    }
    var left := start
    var right := output.len - 1
    while left < right {
        tmp := output[left]
        output[left] = output[right]
        output[right] = tmp
        left += 1
        right -= 1
    }
}

pub fn hex_u8(input: &[]u8) -> string {
    digits := "0123456789abcdef"
    var output: []u8 = []
    output.reserve(input.len * 2)
    for b in input {
        val := i32(b)
        output.push(u8(digits[val / 16]))
        output.push(u8(digits[val % 16]))
    }
    result := decode(&output)
    assert(result.ok)
    result.value
}
pub fn u16_le(input: &[]u8, offset: i32) -> i32 {
    assert(offset >= 0 && offset <= input.len - 2)
    i32(input[offset]).bit_or(i32(input[offset + 1]).shl(8))
}
pub fn u32_le(input: &[]u8, offset: i32) -> i64 {
    assert(offset >= 0 && offset <= input.len - 4)
    a := i64(input[offset]).bit_or(i64(input[offset + 1]).shl(8))
    b := i64(input[offset + 2]).shl(16).bit_or(i64(input[offset + 3]).shl(24))
    a.bit_or(b)
}
pub fn i64_le(input: &[]u8, offset: i32) -> i64 {
    assert(offset >= 0 && offset <= input.len - 8)
    var v: i64 = 0
    for i in 0..8 {
        v = v.bit_or(i64(input[offset + i]).shl(i * 8))
    }
    v
}
pub fn u64_le(input: &[]u8, offset: i32) -> u64 {
    assert(offset >= 0 && offset <= input.len - 8)
    var v: u64 = 0
    for i in 0..8 {
        v = v.bit_or(u64(input[offset + i]).shl(i * 8))
    }
    v
}

pub fn new() -> []i32 { [] }
pub fn utf8(input: &[]i32) -> sys.TextResult { sys.decode_utf8(&input) }
pub fn append_text(output: &mut []i32, text: string) {
    output.reserve(output.len + text.len)
    for byte in text.bytes() { output.push(byte) }
}
pub fn append(output: &mut []i32, input: &[]i32) {
    output.reserve(output.len + input.len)
    var i := 0
    while i < input.len { assert(input[i] >= 0 && input[i] <= 255); output.push(input[i]); i = i + 1 }
}
pub fn zeros(output: &mut []i32, count: i32) {
    assert(count >= 0)
    output.reserve(output.len + count)
    for i in 0..count { output.push(0) }
}
pub fn u32le(output: &mut []i32, value: i64) {
    assert(value >= 0 && value <= 4294967295)
    var remaining := value
    for i in 0..4 { output.push(i32(remaining % 256)); remaining = remaining / 256 }
}
pub fn u64le(output: &mut []i32, value: i64) {
    for i in 0..8 { output.push(i32(value.shr(i * 8).bit_and(255))) }
}
pub fn set_u32le(output: &mut []i32, offset: i32, value: i64) {
    assert(value >= 0 && value <= 4294967295)
    assert(offset >= 0 && offset <= output.len - 4)
    var remaining := value
    for i in 0..4 { output[offset + i] = i32(remaining % 256); remaining = remaining / 256 }
}
pub fn set_u32be(output: &mut []i32, offset: i32, value: i64) {
    assert(value >= 0 && value <= 4294967295)
    assert(offset >= 0 && offset <= output.len - 4)
    var remaining := value
    for i in 0..4 { output[offset + 3 - i] = i32(remaining % 256); remaining = remaining / 256 }
}
pub fn set_u64be(output: &mut []i32, offset: i32, value: i64) {
    assert(offset >= 0 && offset <= output.len - 8)
    for i in 0..8 { output[offset + 7 - i] = i32(value.shr(i * 8).bit_and(255)) }
}
pub fn hex(input: &[]i32) -> string {
    digits := "0123456789abcdef"
    var output: []u8 = []
    output.reserve(input.len * 2)
    var i := 0
    while i < input.len {
        byte := input[i]
        assert(byte >= 0 && byte <= 255)
        output.push(u8(digits[byte / 16]))
        output.push(u8(digits[byte % 16]))
        i = i + 1
    }
    result := decode(&output)
    assert(result.ok)
    result.value
}
@test fn byte_encoding_is_explicit_and_round_trips_bits() {
    var output := new()
    u32le(&mut output, 4278255360)
    hex(&output) == "00ff00ff"
    set_u32be(&mut output, 0, 16909060)
    hex(&output) == "01020304"
    output.clear()
    u64le(&mut output, -1)
    hex(&output) == "ffffffffffffffff"
    output.clear()
    append_text(&mut output, "å")
    hex(&output) == "c3a5"
}
