import sys
pub fn new() -> []i32 { [] }
pub fn utf8(input: &[]i32) -> sys.TextResult { sys.decode_utf8(&input) }
pub fn append_text(output: &mut []i32, text: string) {
    output.reserve(output.len + text.len)
    for byte in text.bytes() { output.push(byte) }
}
pub fn append(output: &mut []i32, input: &[]i32) {
    output.reserve(output.len + input.len)
    var i := 0
    while i < input.len { assert(input[i] >= 0 && input[i] <= 255); output.push(input[i]); i = i + 1 }
}
pub fn zeros(output: &mut []i32, count: i32) {
    assert(count >= 0)
    output.reserve(output.len + count)
    for i in 0..count { output.push(0) }
}
pub fn u32le(output: &mut []i32, value: i64) {
    assert(value >= 0 && value <= 4294967295)
    var remaining := value
    for i in 0..4 { output.push(i32(remaining % 256)); remaining = remaining / 256 }
}
pub fn u64le(output: &mut []i32, value: i64) {
    for i in 0..8 { output.push(i32(value.shr(i * 8).bit_and(255))) }
}
pub fn set_u32le(output: &mut []i32, offset: i32, value: i64) {
    assert(value >= 0 && value <= 4294967295)
    assert(offset >= 0 && offset <= output.len - 4)
    var remaining := value
    for i in 0..4 { output[offset + i] = i32(remaining % 256); remaining = remaining / 256 }
}
pub fn set_u32be(output: &mut []i32, offset: i32, value: i64) {
    assert(value >= 0 && value <= 4294967295)
    assert(offset >= 0 && offset <= output.len - 4)
    var remaining := value
    for i in 0..4 { output[offset + 3 - i] = i32(remaining % 256); remaining = remaining / 256 }
}
pub fn set_u64be(output: &mut []i32, offset: i32, value: i64) {
    assert(offset >= 0 && offset <= output.len - 8)
    for i in 0..8 { output[offset + 7 - i] = i32(value.shr(i * 8).bit_and(255)) }
}
pub fn hex(input: &[]i32) -> string {
    digits := "0123456789abcdef"
    var output: []i32 = []
    output.reserve(input.len * 2)
    var i := 0
    while i < input.len {
        byte := input[i]
        assert(byte >= 0 && byte <= 255)
        output.push(digits[byte / 16])
        output.push(digits[byte % 16])
        i = i + 1
    }
    result := utf8(&output)
    assert(result.ok)
    result.value
}
@test fn byte_encoding_is_explicit_and_round_trips_bits() {
    var output := new()
    u32le(&mut output, 4278255360)
    hex(&output) == "00ff00ff"
    set_u32be(&mut output, 0, 16909060)
    hex(&output) == "01020304"
    output.clear()
    u64le(&mut output, -1)
    hex(&output) == "ffffffffffffffff"
    output.clear()
    append_text(&mut output, "å")
    hex(&output) == "c3a5"
}
