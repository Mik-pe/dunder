// Dynamic storage is provided by []T; these algorithms are ordinary Dunder.
pub fn ints() -> []i64 { [] }
pub fn strings() -> []string { [] }
pub fn sum(values: &[]i64) -> i64 {
    var result: i64 = 0
    var i := 0
    while i < values.len { result = result + values[i]; i = i + 1 }
    result
}
pub fn reverse(values: &mut []i64) {
    var left := 0
    var right := values.len - 1
    while left < right {
        value := values[left]
        values[left] = values[right]
        values[right] = value
        left = left + 1
        right = right - 1
    }
}
pub fn sort(values: &mut []i64) {
    for i in 1..values.len {
        value := values[i]
        var j := i
        while j > 0 && values[j - 1] > value { values[j] = values[j - 1]; j = j - 1 }
        values[j] = value
    }
}
pub fn append(values: &mut []i64, extra: &[]i64) {
    values.reserve(values.len + extra.len)
    var i := 0
    while i < extra.len { values.push(extra[i]); i = i + 1 }
}
@test fn dynamic_algorithms_preserve_independent_values() {
    var values: []i64 = [3, -1, 9, 0, 3]
    copy := values
    sort(&mut values)
    values[0] == -1
    values[4] == 9
    reverse(&mut values)
    values[0] == 9
    sum(&values) == 14
    append(&mut values, &copy)
    values.len == 10
    sum(&values) == 28
    copy[0] == 3
}
