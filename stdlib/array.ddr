pub fn ints() -> []i64 { [] }
pub fn strings() -> []string { [] }
pub fn sum(values: &[]i64) -> i64 {
    mut result: i64 = 0
    mut i := 0
    while i + 4 <= values.len {
        result = result + values[i] + values[i + 1] + values[i + 2] + values[i + 3]
        i = i + 4
    }
    while i < values.len {
        result = result + values[i]
        i = i + 1
    }
    result
}
pub fn reverse(values: &mut []i64) {
    mut left := 0
    mut right := values.len - 1
    while left < right {
        values.swap(left, right)
        left += 1
        right -= 1
    }
}
fn insertion_sort_ints(values: &mut []i64, low: i32, high: i32) {
    mut i := low + 1
    while i < high {
        key := values[i]
        mut j := i
        while j > low && values[j - 1] > key {
            values[j] = values[j - 1]
            j = j - 1
        }
        values[j] = key
        i = i + 1
    }
}
fn heapsort_ints(values: &mut []i64, low: i32, high: i32) {
    count := high - low
    if count <= 1 { return }
    mut start := count / 2
    mut end := count
    while end > 1 {
        mut root := 0
        mut v: i64 = 0
        if start > 0 {
            start = start - 1
            root = start
            v = values[low + root]
        } else {
            end = end - 1
            root = 0
            v = values[low + end]
            values[low + end] = values[low]
        }
        half := end / 2
        while root < half {
            mut child := root * 2 + 1
            if child + 1 < end && values[low + child] < values[low + child + 1] { child = child + 1 }
            c := values[low + child]
            if v >= c { break }
            values[low + root] = c
            root = child
        }
        values[low + root] = v
    }
}
fn partition_ints(values: &mut []i64, low: i32, high: i32) -> i32 {
    mid := low + (high - low) / 2
    last := high - 1
    mut a := values[low]
    mut b := values[mid]
    mut c := values[last]
    if a > b { t := a; a = b; b = t; values[low] = a; values[mid] = b }
    if b > c {
        t := b; b = c; c = t; values[mid] = b; values[last] = c
        if a > b { u := a; a = b; b = u; values[low] = a; values[mid] = b }
    }
    pivot := b
    mut i := low + 1
    mut j := last - 1
    while true {
        while values[i] < pivot { i = i + 1 }
        while values[j] > pivot { j = j - 1 }
        if i >= j { return j }
        vi := values[i]
        values[i] = values[j]
        values[j] = vi
        i = i + 1
        j = j - 1
    }
    j
}
fn introsort_ints(values: &mut []i64, low_start: i32, high_end: i32, depth_limit: i32) {
    mut low := low_start
    mut high := high_end
    mut depth := depth_limit
    while high - low > 32 {
        if depth <= 0 {
            heapsort_ints(&mut values, low, high)
            return
        }
        depth -= 1
        split := partition_ints(&mut values, low, high) + 1
        if split - low < high - split {
            introsort_ints(&mut values, low, split, depth)
            low = split
        } else {
            introsort_ints(&mut values, split, high, depth)
            high = split
        }
    }
    insertion_sort_ints(&mut values, low, high)
}
pub fn sort(values: &mut []i64) {
    if values.len <= 1 { return }
    mut depth := 0
    mut span := values.len
    while span > 1 { span /= 2; depth += 2 }
    introsort_ints(&mut values, 0, values.len, depth)
}
fn sift_strings(values: &mut []string, start: i32, end: i32) {
    mut root := start
    half := end / 2
    while root < half {
        mut child := root * 2 + 1
        if child + 1 < end && values[child] < values[child + 1] { child += 1 }
        if values[root] >= values[child] { return }
        values.swap(root, child)
        root = child
    }
}
pub fn sort_strings(values: &mut []string) {
    if values.len <= 24 {
        mut i := 1
        while i < values.len {
            mut j := i
            while j > 0 && values[j - 1] > values[j] {
                values.swap(j - 1, j)
                j -= 1
            }
            i += 1
        }
        return
    }
    mut start := values.len / 2
    while start > 0 {
        start -= 1
        sift_strings(&mut values, start, values.len)
    }
    mut end := values.len - 1
    while end > 0 {
        values.swap(0, end)
        sift_strings(&mut values, 0, end)
        end -= 1
    }
}
pub fn append(values: &mut []i64, extra: &[]i64) {
    values.reserve(values.len + extra.len)
    for value in &extra { values.push(value) }
}
@test fn dynamic_algorithms_preserve_independent_values() {
    mut values: []i64 = [3, -1, 9, 0, 3]
    copy := values.clone()
    sort(&mut values)
    values[0] == -1
    values[4] == 9
    reverse(&mut values)
    values[0] == 9
    sum(&values) == 14
    append(&mut values, &copy)
    values.len == 10
    sum(&values) == 28
    copy[0] == 3
}
@test fn string_sort_handles_empty_values_unicode_duplicates_and_copies() {
    mut values: []string = ["🌍", "å", "", "a", "a", "\0", "ä"]
    original := values.clone()
    sort_strings(&mut values)
    values[0] == ""
    values[1] == "\0"
    values[2] == "a"
    values[3] == "a"
    values[4] == "ä"
    values[5] == "å"
    values[6] == "🌍"
    original[0] == "🌍"
    mut empty: []string = []
    sort_strings(&mut empty)
    empty.len == 0
    mut one: []string = ["one"]
    sort_strings(&mut one)
    one[0] == "one"
}

@test fn integer_sort_handles_boundaries_duplicates_and_input_order() {
    mut empty: []i64 = []
    sort(&mut empty)
    assert(empty.len == 0)
    mut one: []i64 = [-9223372036854775808]
    sort(&mut one)
    assert(one.len == 1 && one[0] == -9223372036854775808)

    mut values: []i64 = [9223372036854775807, 0, -1, -9223372036854775808, 1, 0]
    expected: []i64 = [-9223372036854775808, -1, 0, 0, 1, 9223372036854775807]
    sort(&mut values)
    for i in 0..expected.len { assert(values[i] == expected[i]) }
    sort(&mut values)
    for i in 0..expected.len { assert(values[i] == expected[i]) }

    mut descending: []i64 = []
    for i in 0..4097 { descending.push(i64(2048 - i)) }
    sort(&mut descending)
    for i in 0..descending.len { assert(descending[i] == i64(i - 2048)) }

    mut equal: []i64 = []
    for i in 0..257 { equal.push(-7) }
    sort(&mut equal)
    assert(equal.len == 257)
    for value in equal { assert(value == -7) }
}
