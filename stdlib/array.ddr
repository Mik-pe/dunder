// Dynamic storage is provided by []T; these algorithms are ordinary Dunder.
pub fn ints() -> []i64 { [] }
pub fn strings() -> []string { [] }
pub fn sum(values: &[]i64) -> i64 {
    var result: i64 = 0
    var i := 0
    while i < values.len { result = result + values[i]; i = i + 1 }
    result
}
pub fn reverse(values: &mut []i64) {
    var left := 0
    var right := values.len - 1
    while left < right {
        value := values[left]
        values[left] = values[right]
        values[right] = value
        left = left + 1
        right = right - 1
    }
}
pub fn sort(values: &mut []i64) {
    for i in 1..values.len {
        value := values[i]
        var j := i
        while j > 0 && values[j - 1] > value { values[j] = values[j - 1]; j = j - 1 }
        values[j] = value
    }
}
// In-place heapsort, ordered by UTF-8 bytes like ordinary string comparisons.
// O(n log n), without allocating a second array or recursive stack frames.
fn sift_strings(values: &mut []string, start: i32, end: i32) {
    var root := start
    while root < end / 2 {
        var child := root * 2 + 1
        if child + 1 < end && values[child] < values[child + 1] { child = child + 1 }
        if values[root] >= values[child] { return }
        value := values[root]
        values[root] = values[child]
        values[child] = value
        root = child
    }
}
pub fn sort_strings(values: &mut []string) {
    var start := values.len / 2
    while start > 0 {
        start = start - 1
        sift_strings(&mut values, start, values.len)
    }
    var end := values.len - 1
    while end > 0 {
        value := values[0]
        values[0] = values[end]
        values[end] = value
        sift_strings(&mut values, 0, end)
        end = end - 1
    }
}
pub fn append(values: &mut []i64, extra: &[]i64) {
    values.reserve(values.len + extra.len)
    var i := 0
    while i < extra.len { values.push(extra[i]); i = i + 1 }
}
@test fn dynamic_algorithms_preserve_independent_values() {
    var values: []i64 = [3, -1, 9, 0, 3]
    copy := values
    sort(&mut values)
    values[0] == -1
    values[4] == 9
    reverse(&mut values)
    values[0] == 9
    sum(&values) == 14
    append(&mut values, &copy)
    values.len == 10
    sum(&values) == 28
    copy[0] == 3
}
@test fn string_sort_handles_empty_values_unicode_duplicates_and_copies() {
    var values: []string = ["🌍", "å", "", "a", "a", "\0", "ä"]
    original := values
    sort_strings(&mut values)
    values[0] == ""
    values[1] == "\0"
    values[2] == "a"
    values[3] == "a"
    values[4] == "ä"
    values[5] == "å"
    values[6] == "🌍"
    original[0] == "🌍"
    var empty: []string = []
    sort_strings(&mut empty)
    empty.len == 0
    var one: []string = ["one"]
    sort_strings(&mut one)
    one[0] == "one"
}
