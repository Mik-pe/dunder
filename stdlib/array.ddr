pub fn ints() -> []i64 { [] }
pub fn strings() -> []string { [] }

pub fn sum(values: &[]i64) -> i64 {
    mut result: i64 = 0
    mut i := 0
    while i + 4 <= values.len {
        result = result + values[i] + values[i + 1] + values[i + 2] + values[i + 3]
        i = i + 4
    }
    while i < values.len {
        result = result + values[i]
        i = i + 1
    }
    result
}

pub fn swap_remove<T: Storable>(values: &mut []T, index: i32) -> T {
    values.swap(index, values.len - 1)
    values.pop()
}

@test fn swap_remove_transfers_the_element_and_fills_the_gap() {
    mut names: []string = ["a", "b", "c", "d"]
    assert(swap_remove(&mut names, 1) == "b" && names == ["a", "d", "c"])
    assert(swap_remove(&mut names, 2) == "c" && names == ["a", "d"])
    assert(swap_remove(&mut names, 0) == "a" && names == ["d"])
    assert(swap_remove(&mut names, 0) == "d" && names.len == 0)
}

pub fn reverse<T: Storable>(values: &mut []T) {
    if values.len <= 1 { return }
    mut left := 0
    mut right := values.len - 1
    while left < right {
        values.swap(left, right)
        left += 1
        right -= 1
    }
}

fn insertion_sort<T: Ord + Storable>(values: &mut []T, low: i32, high: i32) {
    mut i := low + 1
    while i < high {
        mut j := i
        while j > low && values[j - 1].cmp(values[j]) == Ordering.Greater {
            values.swap(j - 1, j)
            j -= 1
        }
        i += 1
    }
}

fn sift_down<T: Ord + Storable>(values: &mut []T, low: i32, start: i32, count: i32) {
    mut root := start
    half := count / 2
    while root < half {
        mut child := root * 2 + 1
        if child + 1 < count && values[low + child].cmp(values[low + child + 1]) == Ordering.Less {
            child += 1
        }
        if values[low + root].cmp(values[low + child]) != Ordering.Less { return }
        values.swap(low + root, low + child)
        root = child
    }
}

fn heapsort<T: Ord + Storable>(values: &mut []T, low: i32, high: i32) {
    count := high - low
    if count <= 1 { return }
    mut start := count / 2
    while start > 0 {
        start -= 1
        sift_down<T>(&mut values, low, start, count)
    }
    mut end := count
    while end > 1 {
        end -= 1
        values.swap(low, low + end)
        sift_down<T>(&mut values, low, 0, end)
    }
}

fn partition<T: Ord + Storable>(values: &mut []T, low: i32, high: i32) -> i32 {
    mid := low + (high - low) / 2
    last := high - 1
    if values[low].cmp(values[mid]) == Ordering.Greater { values.swap(low, mid) }
    if values[mid].cmp(values[last]) == Ordering.Greater {
        values.swap(mid, last)
        if values[low].cmp(values[mid]) == Ordering.Greater { values.swap(low, mid) }
    }
    pivot := last - 1
    values.swap(mid, pivot)
    mut i := low
    mut j := pivot
    while true {
        i += 1
        while values[i].cmp(values[pivot]) == Ordering.Less { i += 1 }
        j -= 1
        while j > low && values[j].cmp(values[pivot]) == Ordering.Greater { j -= 1 }
        if i >= j { break }
        values.swap(i, j)
    }
    values.swap(i, pivot)
    i
}

fn introsort<T: Ord + Storable>(values: &mut []T, low_start: i32, high_end: i32, depth_limit: i32) {
    mut low := low_start
    mut high := high_end
    mut depth := depth_limit
    while high - low > 24 {
        if depth <= 0 {
            heapsort<T>(&mut values, low, high)
            return
        }
        depth -= 1
        pivot := partition<T>(&mut values, low, high)
        if pivot - low < high - (pivot + 1) {
            introsort<T>(&mut values, low, pivot, depth)
            low = pivot + 1
        } else {
            introsort<T>(&mut values, pivot + 1, high, depth)
            high = pivot
        }
    }
    insertion_sort<T>(&mut values, low, high)
}

pub fn sort<T: Ord + Storable>(values: &mut []T) {
    if values.len <= 1 { return }
    mut depth := 0
    mut span := values.len
    while span > 1 { span /= 2; depth += 2 }
    introsort<T>(&mut values, 0, values.len, depth)
}

fn insertion_sort_by<T: Storable>(values: &mut []T, low: i32, high: i32, compare: &Fn(&T, &T) -> Ordering) {
    mut i := low + 1
    while i < high {
        mut j := i
        while j > low && compare(values[j - 1], values[j]) == Ordering.Greater {
            values.swap(j - 1, j)
            j -= 1
        }
        i += 1
    }
}

fn sift_down_by<T: Storable>(values: &mut []T, low: i32, start: i32, count: i32, compare: &Fn(&T, &T) -> Ordering) {
    mut root := start
    half := count / 2
    while root < half {
        mut child := root * 2 + 1
        if child + 1 < count && compare(values[low + child], values[low + child + 1]) == Ordering.Less {
            child += 1
        }
        if compare(values[low + root], values[low + child]) != Ordering.Less { return }
        values.swap(low + root, low + child)
        root = child
    }
}

fn heapsort_by<T: Storable>(values: &mut []T, low: i32, high: i32, compare: &Fn(&T, &T) -> Ordering) {
    count := high - low
    if count <= 1 { return }
    mut start := count / 2
    while start > 0 {
        start -= 1
        sift_down_by<T>(&mut values, low, start, count, compare)
    }
    mut end := count
    while end > 1 {
        end -= 1
        values.swap(low, low + end)
        sift_down_by<T>(&mut values, low, 0, end, compare)
    }
}

fn partition_by<T: Storable>(values: &mut []T, low: i32, high: i32, compare: &Fn(&T, &T) -> Ordering) -> i32 {
    mid := low + (high - low) / 2
    last := high - 1
    if compare(values[low], values[mid]) == Ordering.Greater { values.swap(low, mid) }
    if compare(values[mid], values[last]) == Ordering.Greater {
        values.swap(mid, last)
        if compare(values[low], values[mid]) == Ordering.Greater { values.swap(low, mid) }
    }
    pivot := last - 1
    values.swap(mid, pivot)
    mut i := low
    mut j := pivot
    while true {
        i += 1
        while compare(values[i], values[pivot]) == Ordering.Less { i += 1 }
        j -= 1
        while j > low && compare(values[j], values[pivot]) == Ordering.Greater { j -= 1 }
        if i >= j { break }
        values.swap(i, j)
    }
    values.swap(i, pivot)
    i
}

fn introsort_by<T: Storable>(values: &mut []T, low_start: i32, high_end: i32, depth_limit: i32, compare: &Fn(&T, &T) -> Ordering) {
    mut low := low_start
    mut high := high_end
    mut depth := depth_limit
    while high - low > 24 {
        if depth <= 0 {
            heapsort_by<T>(&mut values, low, high, compare)
            return
        }
        depth -= 1
        pivot := partition_by<T>(&mut values, low, high, compare)
        if pivot - low < high - (pivot + 1) {
            introsort_by<T>(&mut values, low, pivot, depth, compare)
            low = pivot + 1
        } else {
            introsort_by<T>(&mut values, pivot + 1, high, depth, compare)
            high = pivot
        }
    }
    insertion_sort_by<T>(&mut values, low, high, compare)
}

pub fn sort_by<T: Storable>(values: &mut []T, compare: &Fn(&T, &T) -> Ordering) {
    if values.len <= 1 { return }
    mut depth := 0
    mut span := values.len
    while span > 1 { span /= 2; depth += 2 }
    introsort_by<T>(&mut values, 0, values.len, depth, compare)
}

pub fn is_sorted<T: Ord + Storable>(values: &[]T) -> bool {
    mut i := 1
    while i < values.len {
        if values[i - 1].cmp(values[i]) == Ordering.Greater { return false }
        i += 1
    }
    true
}

pub fn binary_search<T: Ord + Storable>(values: &[]T, target: &T) -> Result<i32, i32> {
    mut low := 0
    mut high := values.len
    while low < high {
        mid := low + (high - low) / 2
        ord := values[mid].cmp(target)
        if ord == Ordering.Less { low = mid + 1 }
        else if ord == Ordering.Greater { high = mid }
        else { return .Ok(mid) }
    }
    .Err(low)
}

pub fn contains<T: Eq + Storable>(values: &[]T, target: &T) -> bool {
    index_of<T>(&values, target).is_some()
}

pub fn index_of<T: Eq + Storable>(values: &[]T, target: &T) -> Option<i32> {
    for i in 0..values.len {
        if values[i].eq(target) { return .Some(i) }
    }
    .None
}

pub fn equal<T: Eq + Storable>(lhs: &[]T, rhs: &[]T) -> bool {
    if lhs.len != rhs.len { return false }
    for i in 0..lhs.len {
        if !lhs[i].eq(rhs[i]) { return false }
    }
    true
}

pub fn min_index<T: Ord + Storable>(values: &[]T) -> Option<i32> {
    if values.len == 0 { return .None }
    mut best := 0
    for i in 1..values.len {
        if values[i].cmp(values[best]) == Ordering.Less { best = i }
    }
    .Some(best)
}

pub fn max_index<T: Ord + Storable>(values: &[]T) -> Option<i32> {
    if values.len == 0 { return .None }
    mut best := 0
    for i in 1..values.len {
        if values[i].cmp(values[best]) == Ordering.Greater { best = i }
    }
    .Some(best)
}

pub fn dedup<T: Eq + Storable>(values: &mut []T) {
    if values.len <= 1 { return }
    mut write := 1
    for read in 1..values.len {
        if !values[read].eq(values[write - 1]) {
            if write != read { values.swap(write, read) }
            write += 1
        }
    }
    while values.len > write { _ := values.pop() }
}

pub fn append<T: Clone + Storable>(values: &mut []T, extra: &[]T) {
    values.reserve(values.len + extra.len)
    for i in 0..extra.len { values.push(extra[i].clone()) }
}

pub fn append_move<T: Storable>(values: &mut []T, move extra: []T) {
    values.reserve(values.len + extra.len)
    for item in move extra { values.push(move item) }
}

@test fn append_move_preserves_elements_and_empty_arrays() {
    mut values: [][]i32 = []
    append_move(&mut values, [[1, 2], [3]])
    append_move(&mut values, [])
    assert(values == [[1, 2], [3]])
}

pub fn fill<T: Clone + Storable>(values: &mut []T, value: &T) {
    for i in 0..values.len { values[i] = value.clone() }
}

pub fn resize<T: Clone + Storable>(values: &mut []T, new_len: i32, value: &T) {
    assert(new_len >= 0)
    if new_len <= values.len { values.truncate(new_len); return }
    values.reserve(new_len)
    while values.len < new_len { values.push(value.clone()) }
}

pub fn join<T: Display + Storable>(values: &[]T, sep: string) -> string {
    mut out := ""
    for i in 0..values.len {
        if i > 0 { out += sep }
        out += values[i].str()
    }
    out
}

fn desc_i64(a: &i64, b: &i64) -> Ordering { b.cmp(a) }

@test fn resize_preserves_storage_and_the_prefix_after_shrinking() {
    mut values: []string = ["first", "old", "last"]
    capacity := values.cap()
    resize(&mut values, 1, "fill")
    assert(values.cap() == capacity && values == ["first"])
    resize(&mut values, 1, "ignored")
    resize(&mut values, 3, "new")
    assert(values == ["first", "new", "new"] && values.cap() == capacity)
    resize(&mut values, 0, "")
    resize(&mut values, 0, "")
    assert(values.len == 0 && values.cap() == capacity)
}

@test fn dynamic_algorithms_preserve_independent_values() {
    mut values: []i64 = [3, -1, 9, 0, 3]
    copy := values.clone()
    sort<i64>(&mut values)
    assert(values[0] == -1 && values[4] == 9)
    assert(is_sorted<i64>(&values))
    reverse<i64>(&mut values)
    assert(values[0] == 9)
    assert(!is_sorted<i64>(&values))
    assert(sum(&values) == 14)
    append<i64>(&mut values, &copy)
    assert(values.len == 10 && sum(&values) == 28 && copy[0] == 3)
}

@test fn string_sort_handles_empty_values_unicode_duplicates_and_copies() {
    mut values: []string = ["🌍", "å", "", "a", "a", "\0", "ä"]
    original := values.clone()
    sort<string>(&mut values)
    assert(values == ["", "\0", "a", "a", "ä", "å", "🌍"])
    assert(original[0] == "🌍")
    assert(contains<string>(&values, "å"))
    assert(index_of<string>(&values, "a") == .Some(2))
    assert(index_of<string>(&values, "missing") == .None)
    assert(join<string>(&["x", "y", "z"], ",") == "x,y,z")
    dedup<string>(&mut values)
    assert(values == ["", "\0", "a", "ä", "å", "🌍"])
    mut empty: []string = []
    sort<string>(&mut empty)
    assert(empty.len == 0)
    mut one: []string = ["one"]
    sort<string>(&mut one)
    assert(one[0] == "one")
}

@test fn integer_sort_and_search_cover_boundaries_and_compounds() {
    mut empty: []i64 = []
    sort<i64>(&mut empty)
    assert(empty.len == 0 && min_index<i64>(&empty) == .None && max_index<i64>(&empty) == .None)
    mut one: []i64 = [-9223372036854775808]
    sort<i64>(&mut one)
    assert(one.len == 1 && one[0] == -9223372036854775808)

    mut values: []i64 = [9223372036854775807, 0, -1, -9223372036854775808, 1, 0]
    expected: []i64 = [-9223372036854775808, -1, 0, 0, 1, 9223372036854775807]
    sort<i64>(&mut values)
    assert(equal<i64>(&values, &expected))
    assert(min_index<i64>(&values) == .Some(0) && max_index<i64>(&values) == .Some(5))
    assert(binary_search<i64>(&values, 1) == .Ok(4))
    assert(binary_search<i64>(&values, 2) == .Err(5))
    sort_by<i64>(&mut values, desc_i64)
    assert(values[0] == 9223372036854775807 && values[5] == -9223372036854775808)

    mut descending: []i64 = []
    for i in 0..4097 { descending.push(i64(2048 - i)) }
    sort<i64>(&mut descending)
    assert(is_sorted<i64>(&descending))
    for i in 0..descending.len { assert(descending[i] == i64(i - 2048)) }

    mut pairs: [](i32, string) = [(2, "b"), (1, "b"), (1, "a")]
    sort<(i32, string)>(&mut pairs)
    assert(pairs == [(1, "a"), (1, "b"), (2, "b")])

    mut filled: []i32 = [1, 2]
    resize<i32>(&mut filled, 4, 9)
    assert(filled == [1, 2, 9, 9])
    fill<i32>(&mut filled, 5)
    assert(filled == [5, 5, 5, 5])
    assert(join<i32>(&filled, "-") == "5-5-5-5")
}
