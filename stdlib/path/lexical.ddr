import std.text as text

fn has_drive(p: string) -> bool {
    if p.len < 2 || p[1] != 58 { return false }
    letter := p[0]
    (letter >= 65 && letter <= 90) || (letter >= 97 && letter <= 122)
}

fn windows_slashes(p: string) -> string {
    mut out := ""
    mut start := 0
    for i in 0..p.len {
        if p[i] == 92 {
            out += p[start..i] + "/"
            start = i + 1
        }
    }
    if start == 0 { return p.clone() }
    out + p[start..p.len]
}

fn slash_form(p: string) -> string {
    if (target_is("native") && !target_is("macos") && !target_is("linux")) || has_drive(p) || text.starts_with(p, "\\\\") {
        return windows_slashes(p)
    }
    p.clone()
}

fn root_end(p: string) -> i32 {
    if has_drive(p) {
        return if p.len >= 3 && p[2] == 47 { 3 } else { 2 }
    }
    if p.len == 0 || p[0] != 47 { return 0 }
    if p.len < 4 || p[1] != 47 || p[2] == 47 { return 1 }
    mut end := 2
    while end < p.len && p[end] != 47 { end += 1 }
    if end == p.len || end + 1 == p.len || p[end + 1] == 47 { return 1 }
    end += 1
    while end < p.len && p[end] != 47 { end += 1 }
    end
}

pub fn root(p: string) -> string {
    value := slash_form(p)
    value[0..root_end(value)]
}

pub fn is_absolute(p: string) -> bool {
    if p.len == 0 { return false }
    if has_drive(p) { return p.len >= 3 && (p[2] == 47 || p[2] == 92) }
    p[0] == 47 || text.starts_with(p, "\\\\") || ((target_is("native") && !target_is("macos") && !target_is("linux")) && p[0] == 92)
}

fn trimmed_end(p: string) -> i32 {
    root := root_end(p)
    mut end := p.len
    while end > root && p[end - 1] == 47 { end -= 1 }
    end
}

pub fn join(base: string, child: string) -> string {
    parent := slash_form(base)
    if child.len == 0 { return parent }
    part := if has_drive(parent) || text.starts_with(parent, "//") { windows_slashes(child) } else { slash_form(child) }
    if is_absolute(part) || has_drive(part) || parent.len == 0 { return part }
    end := trimmed_end(parent)
    if parent[end - 1] == 47 || (end == 2 && has_drive(parent)) { return parent[0..end] + part }
    parent[0..end] + "/" + part
}

pub fn basename(p: string) -> string {
    value := slash_form(p)
    end := trimmed_end(value)
    root := root_end(value)
    if end == root { return value[0..end] }
    mut i := end
    while i > root && value[i - 1] != 47 { i -= 1 }
    value[i..end]
}

pub fn dirname(p: string) -> string {
    value := slash_form(p)
    root := root_end(value)
    mut end := trimmed_end(value)
    while end > root && value[end - 1] != 47 { end -= 1 }
    while end > root && value[end - 1] == 47 { end -= 1 }
    if end == 0 { return "." }
    value[0..end]
}

pub fn stem(p: string) -> string {
    name := basename(p)
    if name == "" || name == "." || name == ".." || root_end(name) == name.len { return name }
    mut dot := -1
    mut i := name.len - 1
    while i > 0 {
        if name[i] == 46 { dot = i; break }
        i -= 1
    }
    if dot <= 0 || dot >= name.len - 1 { return name }
    name[0..dot]
}

pub fn with_extension(p: string, ext: string) -> string {
    value := slash_form(p)
    end := trimmed_end(value)
    if end == root_end(value) { return value }
    name := basename(value)
    base_name := stem(name)
    mut clean := ext.clone()
    if clean.len > 0 && clean[0] == 46 { clean = clean[1..clean.len] }
    updated := if clean.len == 0 { base_name } else { base_name + "." + clean }
    value[0..end - name.len] + updated
}

pub fn normalize(p: string) -> string {
    if p.len == 0 { return "" }
    value := slash_form(p)
    abs := is_absolute(value)
    root := root_end(value)
    mut parts: []string = []
    mut i := root
    while i < value.len {
        while i < value.len && value[i] == 47 { i += 1 }
        if i >= value.len { break }
        start := i
        while i < value.len && value[i] != 47 { i += 1 }
        seg := value[start..i]
        if seg == "." { continue }
        if seg == ".." {
            if parts.len > 0 && parts[parts.len - 1] != ".." {
                _ := parts.pop()
            } else if !abs {
                parts.push("..")
            }
            continue
        }
        parts.push(move seg)
    }
    if parts.len == 0 {
        if root > 0 { return value[0..root] }
        return "."
    }
    mut out := value[0..root]
    if root > 3 && out[root - 1] != 47 { out += "/" }
    for idx in 0..parts.len {
        if idx > 0 { out += "/" }
        out += parts[idx]
    }
    out
}
