import std/hash as hashing

pub struct Map {
    keys: []string,
    values: []i64,
    slots: []i32,
    length: i32,
    used: i32,
}
pub enum Lookup { Missing, Found(i64) }

pub fn new() -> Map { Map { keys: [], values: [], slots: [], length: 0, used: 0 } }
pub fn length(table: &Map) -> i32 { table.length }

fn locate(table: &Map, key: string) -> i32 {
    capacity := table.slots.len
    if capacity == 0 { return -1 }
    var slot := i32(hashing.hash(key) % i64(capacity))
    for step in 0..capacity {
        state := table.slots[slot]
        if state == 0 { return -1 }
        if state == 1 && table.keys[slot] == key { return slot }
        slot = (slot + 1) % capacity
    }
    -1
}
pub fn contains(table: &Map, key: string) -> bool { locate(&table, key) >= 0 }
pub fn get(table: &Map, key: string) -> Lookup {
    slot := locate(&table, key)
    if slot < 0 { .Missing } else { .Found(table.values[slot]) }
}
pub fn get_or(table: &Map, key: string, fallback: i64) -> i64 {
    slot := locate(&table, key)
    if slot < 0 { fallback } else { table.values[slot] }
}
fn insert_slot(table: &mut Map, key: string, value: i64) {
    capacity := table.slots.len
    var slot := i32(hashing.hash(key) % i64(capacity))
    while table.slots[slot] == 1 { slot = (slot + 1) % capacity }
    if table.slots[slot] == 0 { table.used = table.used + 1 }
    table.slots[slot] = 1
    table.keys[slot] = key
    table.values[slot] = value
    table.length = table.length + 1
}
fn rehash(table: &mut Map, capacity: i32) {
    var fresh := new()
    fresh.keys.reserve(capacity)
    fresh.values.reserve(capacity)
    fresh.slots.reserve(capacity)
    for i in 0..capacity { fresh.keys.push(""); fresh.values.push(0); fresh.slots.push(0) }
    for i in 0..table.slots.len {
        if table.slots[i] == 1 { insert_slot(&mut fresh, table.keys[i], table.values[i]) }
    }
    table = fresh
}
pub fn reserve(table: &mut Map, entries: i32) {
    assert(entries >= 0)
    var capacity := 8
    while i64(capacity) * 7 < i64(entries) * 10 { capacity = capacity * 2 }
    if capacity > table.slots.len { rehash(&mut table, capacity) }
}
pub fn put(table: &mut Map, key: string, value: i64) {
    existing := locate(&table, key)
    if existing >= 0 { table.values[existing] = value; return }
    capacity := table.slots.len
    if capacity == 0 { rehash(&mut table, 8) }
    else if (table.used + 1) * 10 >= capacity * 7 {
        if (table.length + 1) * 10 < capacity * 4 { rehash(&mut table, capacity) }
        else { rehash(&mut table, capacity * 2) }
    }
    insert_slot(&mut table, key, value)
}
pub fn remove(table: &mut Map, key: string) -> bool {
    slot := locate(&table, key)
    if slot < 0 { return false }
    table.slots[slot] = 2
    table.keys[slot] = ""
    table.values[slot] = 0
    table.length = table.length - 1
    true
}
pub fn clear(table: &mut Map) {
    for i in 0..table.slots.len { table.slots[i] = 0; table.keys[i] = ""; table.values[i] = 0 }
    table.length = 0
    table.used = 0
}
pub fn keys(table: &Map) -> []string {
    var result: []string = []
    result.reserve(table.length)
    for i in 0..table.slots.len { if table.slots[i] == 1 { result.push(table.keys[i]) } }
    result
}

@test fn map_handles_growth_collisions_updates_removal_and_copies() {
    var collisions := new()
    put(&mut collisions, "a", 1); put(&mut collisions, "i", 2); put(&mut collisions, "q", 3); put(&mut collisions, "y", 4)
    remove(&mut collisions, "a")
    put(&mut collisions, "q", 99)
    length(&collisions) == 3
    get_or(&collisions, "q", 0) == 99
    get_or(&collisions, "y", 0) == 4
    put(&mut collisions, "", -1); put(&mut collisions, "\0", -2)
    get_or(&collisions, "", 0) == -1
    get_or(&collisions, "\0", 0) == -2
    var table := new()
    put(&mut table, "", -1)
    put(&mut table, "å 🌍", 42)
    for i in 0..1000 { put(&mut table, i.str(), i64(i) * 3) }
    length(&table) == 1002
    for i in 0..1000 { get_or(&table, i.str(), -1) == i64(i) * 3 }
    snapshot := table
    put(&mut table, "å 🌍", 99)
    get_or(&snapshot, "å 🌍", 0) == 42
    for i in 0..1000 { remove(&mut table, i.str()) }
    length(&table) == 2
    !remove(&mut table, "missing")
    for i in 0..1000 { put(&mut table, i.str(), i64(i)) }
    keys(&table).len == 1002
    match get(&table, "å 🌍") { .Found(value) => { value == 99 }, .Missing => { assert(false) } }
    clear(&mut table)
    length(&table) == 0
    !contains(&table, "")
    put(&mut table, "again", 7)
    get_or(&table, "again", 0) == 7
}
