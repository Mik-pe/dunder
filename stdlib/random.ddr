capability unsafe

import sys

@link("c")
extern "C" {
    @link_name("arc4random_buf")
    @thread_safe
    fn mac_random(data: ptr, count: usize)
}

@link("bcrypt")
extern "system" {
    @link_name("BCryptGenRandom")
    @thread_safe
    fn win_random(algorithm: ptr, data: ptr, count: u32, flags: u32) -> i32
}

@link("wasi_snapshot_preview1")
extern "C" {
    @link_name("random_get")
    @thread_safe
    fn wasi_random(data: ptr, count: usize) -> i32
}

@thread_safe
pub fn fill(data: &mut []u8) -> Result<(), sys.IoError> {
    if data.len == 0 { return .Ok }
    unsafe {
        if target_is("macos") {
            mac_random(addr(&mut data[0]), usize(data.len))
            return .Ok
        }
        if target_is("linux") {
            mut at := 0
            while at < data.len {
                n := sys.linux_syscall(278, i64(usize(addr(&mut data[at]))), i64(data.len - at), 0, 0, 0, 0)
                if n == -4 { continue }
                if n == -38 { return .Err(.Unsupported) }
                if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
                if n == 0 { return .Err(.UnexpectedEof) }
                at += i32(n)
            }
            return .Ok
        }
        if target_is("windows") {
            status := win_random(ptr(0), addr(&mut data[0]), u32(data.len), u32(2))
            if status != 0 { return .Err(.Other(status)) }
            return .Ok
        }
        if target_is("wasi") {
            status := wasi_random(addr(&mut data[0]), usize(data.len))
            if status != 0 { return .Err(.Other(status)) }
            return .Ok
        }
    }
    .Err(.Unsupported)
}

@thread_safe
pub fn bytes(count: i32) -> Result<[]u8, sys.IoError> {
    if count < 0 { return .Err(.InvalidArgument) }
    if count > 1048576 { return .Err(.TooLarge) }
    if target_is("wasm32-unknown-unknown") && count > 0 { return .Err(.Unsupported) }
    mut data: []u8 = []
    match data.try_reserve(count) {
        .Ok => {},
        .InvalidCapacity => { return .Err(.TooLarge) },
        .OutOfMemory => { return .Err(.OutOfMemory) },
    }
    for _ in 0..count { data.push(0) }
    fill(&mut data)?
    .Ok(data)
}
