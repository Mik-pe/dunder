capability unsafe
import std.macos.appkit as appkit
import std.macos.objc as objc
import std.macos.renderer as metal

// Native macOS window + Metal triangle-list presentation.
// Window is a validated resource ID. Copies refer to the same native window.
pub struct Window { id: i64 }
pub struct OpenResult { ok: bool, window: Window, error: string }
pub struct Frame {
    closed: bool,
    width: i32,
    height: i32,
    pixel_width: i32,
    pixel_height: i32,
    scale: f64,
    time: f64,
    pointer_x: f64,
    pointer_y: f64,
    pointer_down: bool,
    key: i32,
    resized: bool,
}
pub struct DrawResult { ok: bool, error: string, frames: i64 }

fn open_error(message: string) -> OpenResult { OpenResult { ok: false, window: Window {id: 0}, error: message } }

unsafe fn open_window(s: &mut metal.State, title: string, width: i32, height: i32) -> OpenResult {
    if width < 1 || width > 16384 || height < 1 || height > 16384 {
        return open_error("Window dimensions must be between 1 and 16384 points")
    }
    if s.active != 0 { return open_error("A native macOS window is already open") }
    if !appkit.initialize(&mut s) { return open_error("Native macOS graphics are unavailable") }
    pool := objc.pool()
    ready := metal.setup(&mut s) && appkit.configure(&mut s, title, width, height)
    if !ready { appkit.destroy(&mut s) }
    objc.drain(pool)
    if !ready { return open_error("Could not create the native macOS window or Metal device") }
    OpenResult {ok: true, window: Window {id: s.generation}, error: ""}
}
pub fn open(title: string, width: i32, height: i32) -> OpenResult {
    unsafe { return open_window(ref_at(metal.state()), title, width, height) }
}

fn matches_window(s: &metal.State, window: Window) -> bool { s.active != 0 && window.id == s.generation }

unsafe fn poll_window(s: &mut metal.State, window: Window) -> Frame {
    if !matches_window(&s, window) {
        return Frame {closed:true, width:0, height:0, pixel_width:0, pixel_height:0, scale:0.0, time:0.0,
                      pointer_x:0.0, pointer_y:0.0, pointer_down:false, key:-1, resized:false}
    }
    appkit.poll(&mut s)
    frame := Frame {closed:s.closed != 0, width:s.width, height:s.height, pixel_width:s.pixelWidth,
                   pixel_height:s.pixelHeight, scale:s.scale, time:s.now() - s.start,
                   pointer_x:s.x, pointer_y:s.y, pointer_down:s.down != 0, key:s.key, resized:s.resized != 0}
    s.resized = 0
    frame
}
pub fn poll(window: Window) -> Frame {
    unsafe { return poll_window(ref_at(metal.state()), window) }
}

unsafe fn draw_window(s: &mut metal.State, window: Window, vertices: &[]f32, red: f64, green: f64, blue: f64) -> DrawResult {
    if !matches_window(&s, window) { return DrawResult {ok:false, frames:0, error:"invalid or expired window handle"} }
    if s.closed != 0 { return DrawResult {ok:false, frames:s.frames, error:"window is closed"} }
    if vertices.len > 800000 || vertices.len % 24 != 0 {
        return DrawResult {ok:false, frames:s.frames, error:"vertices must be a triangle list of eight f32 values per vertex (max 100000 vertices)"}
    }
    pool := objc.pool()
    if !metal.upload(&mut s, &vertices, red, green, blue) {
        objc.drain(pool)
        return DrawResult {ok:false, frames:s.frames, error:"Metal vertex buffer allocation failed"}
    }
    rendered := metal.render(&mut s)
    objc.drain(pool)
    if !rendered { return DrawResult {ok:false, frames:s.frames, error:"Metal command buffer failed"} }
    DrawResult {ok:true, frames:s.frames, error:""}
}
pub fn draw(window: Window, vertices: &[]f32, red: f64, green: f64, blue: f64) -> DrawResult {
    unsafe { return draw_window(ref_at(metal.state()), window, &vertices, red, green, blue) }
}
unsafe fn close_window(s: &mut metal.State, window: Window) {
    if matches_window(&s, window) {
        pool := objc.pool()
        appkit.destroy(&mut s)
        objc.drain(pool)
    }
}
pub fn close(window: Window) { unsafe { close_window(ref_at(metal.state()), window) } }

// Geometry is ordinary Dunder. Positions are Metal clip coordinates: +Y up.
// Each vertex is [x, y, 0, 1, red, green, blue, alpha]. Colors use straight alpha.
pub struct Point { x: f32, y: f32 }
pub struct Color { red: f32, green: f32, blue: f32, alpha: f32 }

pub fn rgb(red: f32, green: f32, blue: f32) -> Color {
    Color { red: red, green: green, blue: blue, alpha: 1.0 }
}
pub fn rgba(red: f32, green: f32, blue: f32, alpha: f32) -> Color {
    Color { red: red, green: green, blue: blue, alpha: alpha }
}
pub fn vertex(vertices: &mut []f32, point: Point, color: Color) {
    vertices.push(point.x)
    vertices.push(point.y)
    vertices.push(0.0)
    vertices.push(1.0)
    vertices.push(color.red)
    vertices.push(color.green)
    vertices.push(color.blue)
    vertices.push(color.alpha)
}
pub fn triangle(vertices: &mut []f32, a: Point, b: Point, c: Point, color: Color) {
    vertex(&mut vertices, a, color)
    vertex(&mut vertices, b, color)
    vertex(&mut vertices, c, color)
}
pub fn gradient_triangle(vertices: &mut []f32, a: Point, b: Point, c: Point, ca: Color, cb: Color, cc: Color) {
    vertex(&mut vertices, a, ca)
    vertex(&mut vertices, b, cb)
    vertex(&mut vertices, c, cc)
}

// x/y is the lower-left corner; width/height are clip-coordinate extents.
pub fn quad(vertices: &mut []f32, x: f32, y: f32, width: f32, height: f32, color: Color) {
    a := Point { x: x, y: y }
    b := Point { x: x + width, y: y }
    c := Point { x: x + width, y: y + height }
    d := Point { x: x, y: y + height }
    triangle(&mut vertices, a, b, c, color)
    triangle(&mut vertices, a, c, d, color)
}

@test fn geometry_emits_interleaved_triangle_lists() {
    var vertices: []f32 = []
    a := Point { x: -0.5, y: -0.5 }
    b := Point { x: 0.5, y: -0.5 }
    c := Point { x: 0.0, y: 0.5 }
    gradient_triangle(&mut vertices, a, b, c, rgb(1.0, 0.0, 0.0), rgb(0.0, 1.0, 0.0), rgba(0.0, 0.0, 1.0, 0.5))
    vertices.len == 24
    vertices[0] == -0.5
    vertices[2] == 0.0
    vertices[3] == 1.0
    vertices[4] == 1.0
    vertices[8] == 0.5
    vertices[13] == 1.0
    vertices[17] == 0.5
    vertices[22] == 1.0
    vertices[23] == 0.5
    vertices.clear()
    quad(&mut vertices, -1.0, -1.0, 2.0, 2.0, rgb(0.2, 0.3, 0.4))
    vertices.len == 48
    vertices[0] == -1.0
    vertices[9] == -1.0
    vertices[16] == 1.0
    vertices[17] == 1.0
    vertices[40] == -1.0
    vertices[41] == 1.0
}
