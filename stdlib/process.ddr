capability unsafe, process
import std.bytes as bytes
import std.dl as dl
import std.text as text
import sys

@extern("c", "uname")
unsafe fn c_uname(output: ptr) -> i32
@extern("c", "fork")
unsafe fn c_fork() -> i32
@extern("c", "execve")
unsafe fn c_execve(path: ptr, argv: ptr, envp: ptr) -> i32
@extern("c", "_exit")
unsafe fn c_exit(code: i32)
@extern("c", "pipe")
unsafe fn c_pipe(fds: ptr) -> i32
@extern("c", "dup2")
unsafe fn c_dup2(oldfd: i32, newfd: i32) -> i32
@extern("c", "close")
unsafe fn c_close(fd: i32) -> i32
@extern("c", "chdir")
unsafe fn c_chdir(path: ptr) -> i32
@extern("c", "waitpid")
unsafe fn c_waitpid(pid: i32, status: ptr, options: i32) -> i32
@extern("c", "kill")
unsafe fn c_kill(pid: i32, sig: i32) -> i32
@extern("c", "setpgid")
unsafe fn c_setpgid(pid: i32, pgid: i32) -> i32
@extern("c", "read")
unsafe fn c_read(fd: i32, buf: ptr, count: usize) -> i64
@extern("c", "write")
unsafe fn c_write(fd: i32, buf: ptr, count: usize) -> i64
@extern("c", "ioctl")
unsafe fn c_ioctl(fd: i32, req: usize) -> i32
@extern("c", "fopen")
unsafe fn c_fopen(path: ptr, mode: ptr) -> ptr
@extern("c", "fileno")
unsafe fn c_fileno(file: ptr) -> i32
@extern("c", "fclose")
unsafe fn c_fclose(file: ptr) -> i32
@extern("c", "getenv")
unsafe fn c_getenv(name: ptr) -> ptr
@extern("c", "signal")
unsafe fn c_signal(sig: i32, handler: ptr) -> ptr

pub enum EnvMode { Inherit = 0, Clear = 1 }
pub enum Stdio { Inherit = 0, Pipe = 1, Null = 2 }

pub opaque struct Executable { program: string }

pub struct Command {
    program: string,
    args: []string,
    cwd: string,
    env_mode: EnvMode,
    env_keys: []string,
    env_vals: []string,
    env_unset: []bool,
    stdin_mode: Stdio,
    stdout_mode: Stdio,
    stderr_mode: Stdio,
    stdin_data: []u8,
    timeout_ms: i64,
    max_output_bytes: i64,
}

pub struct Output {
    ok: bool,
    error: i32,
    code: i32,
    signal: i32,
    timed_out: bool,
    stdout: []u8,
    stderr: []u8,
}

pub opaque struct Child {
    pid: i32,
    pgid: i32,
    stdin_fd: i32,
    stdout_fd: i32,
    stderr_fd: i32,
    reaped: bool,
    code: i32,
    signal: i32,
}

pub struct SpawnResult { ok: bool, child: Child, error: i32 }
pub struct WaitResult { ok: bool, exited: bool, timed_out: bool, code: i32, signal: i32, error: i32 }

@requires(process)
pub fn grant(program: string) -> Executable { Executable { program: program } }

pub fn executable_path(exe: &Executable) -> string { exe.program }

pub fn command(program: string, args: []string) -> Command {
    Command {
        program: program,
        args: args,
        cwd: "",
        env_mode: .Inherit,
        env_keys: [],
        env_vals: [],
        env_unset: [],
        stdin_mode: .Null,
        stdout_mode: .Pipe,
        stderr_mode: .Pipe,
        stdin_data: [],
        timeout_ms: 0,
        max_output_bytes: 67108864,
    }
}

pub fn add_arg(cmd: &mut Command, arg: string) { cmd.args.push(arg) }

pub fn add_args(cmd: &mut Command, args: &[]string) {
    for a in args { cmd.args.push(a) }
}

pub fn set_cwd(cmd: &mut Command, cwd: string) { cmd.cwd = cwd }

pub fn clear_env(cmd: &mut Command) {
    cmd.env_mode = .Clear
    cmd.env_keys.clear()
    cmd.env_vals.clear()
    cmd.env_unset.clear()
}

pub fn set_env(cmd: &mut Command, key: string, value: string) {
    for i in 0..cmd.env_keys.len {
        if cmd.env_keys[i] == key {
            cmd.env_vals[i] = value
            cmd.env_unset[i] = false
            return
        }
    }
    cmd.env_keys.push(key)
    cmd.env_vals.push(value)
    cmd.env_unset.push(false)
}

pub fn unset_env(cmd: &mut Command, key: string) {
    for i in 0..cmd.env_keys.len {
        if cmd.env_keys[i] == key {
            cmd.env_vals[i] = ""
            cmd.env_unset[i] = true
            return
        }
    }
    cmd.env_keys.push(key)
    cmd.env_vals.push("")
    cmd.env_unset.push(true)
}

pub fn inherit_stdio(cmd: &mut Command) {
    cmd.stdin_mode = .Inherit
    cmd.stdout_mode = .Inherit
    cmd.stderr_mode = .Inherit
}

pub fn set_stdio(cmd: &mut Command, stdin_mode: Stdio, stdout_mode: Stdio, stderr_mode: Stdio) {
    cmd.stdin_mode = stdin_mode
    cmd.stdout_mode = stdout_mode
    cmd.stderr_mode = stderr_mode
}

pub fn set_stdin(cmd: &mut Command, data: &[]u8) {
    cmd.stdin_mode = .Pipe
    cmd.stdin_data.clear()
    bytes.extend(&mut cmd.stdin_data, &data)
}

pub fn set_stdin_text(cmd: &mut Command, input: string) {
    cmd.stdin_mode = .Pipe
    cmd.stdin_data.clear()
    bytes.append_utf8(&mut cmd.stdin_data, input)
}

pub fn set_timeout(cmd: &mut Command, timeout_ms: i64) { cmd.timeout_ms = timeout_ms }

pub fn succeeded(out: &Output) -> bool {
    out.ok && !out.timed_out && out.signal == 0 && out.code == 0
}

pub fn stdout_utf8(out: &Output) -> sys.TextResult { bytes.decode(&out.stdout) }
pub fn stderr_utf8(out: &Output) -> sys.TextResult { bytes.decode(&out.stderr) }

pub fn stdout_text(out: &Output) -> string {
    dec := bytes.decode(&out.stdout)
    if dec.ok { return dec.value }
    ""
}

pub fn stderr_text(out: &Output) -> string {
    dec := bytes.decode(&out.stderr)
    if dec.ok { return dec.value }
    ""
}

fn portable_errno(raw: i32, is_darwin: bool) -> i32 {
    if raw <= 0 { return 5 }
    if is_darwin { return raw }
    if raw == 1 || raw == 2 || raw == 4 || raw == 5 || raw == 8 || raw == 9 || raw == 12 ||
       raw == 13 || raw == 17 || raw == 20 || raw == 21 || raw == 22 ||
       raw == 27 || raw == 28 || raw == 30 || raw == 32 { return raw }
    if raw == 11 { return 35 }
    if raw == 36 { return 63 }
    if raw == 39 { return 66 }
    if raw == 84 { return 92 }
    if raw == 95 { return 45 }
    if raw == 98 { return 48 }
    if raw == 103 { return 53 }
    if raw == 104 { return 54 }
    if raw == 110 { return 60 }
    if raw == 111 { return 61 }
    if raw == 115 { return 36 }
    10000 + raw
}

pub fn host_os() -> string {
    unsafe {
        _ := static_bytes("native", 16)
        var uts: [u64; 256] = [0; 256]
        if c_uname(addr(&mut uts[0])) != 0 { return "unknown" }
        os := load_u8(addr(&uts[0]))
        if os == 68 { return "macos" }
        if os == 76 { return "linux" }
    }
    "unknown"
}

pub fn host_arch() -> string {
    unsafe {
        _ := static_bytes("native", 16)
        var uts: [u64; 256] = [0; 256]
        if c_uname(addr(&mut uts[0])) != 0 { return "unknown" }
        os := load_u8(addr(&uts[0]))
        var mach_off: usize = 260
        if os == 68 { mach_off = 1024 }
        base := usize(addr(&uts[0])) + mach_off
        var raw: []u8 = []
        for i in 0..32 {
            b := load_u8(ptr(base + usize(i)))
            if b == 0 { break }
            raw.push(b)
        }
        m := bytes.decode(&raw).value
        if m == "arm64" || m == "aarch64" { return "arm64" }
        if m == "x86_64" || m == "amd64" { return "x86_64" }
        return m
    }
    "unknown"
}

pub fn host_target() -> string {
    arch := host_arch()
    os := host_os()
    if os == "macos" && arch == "arm64" { return "arm64-macos" }
    if os == "linux" && arch == "arm64" { return "arm64-linux" }
    if os == "linux" && arch == "x86_64" { return "x86_64-linux" }
    arch + "-" + os
}

@requires(process)
pub fn env(name: string) -> sys.TextResult {
    if name.len == 0 { return sys.TextResult { ok: false, value: "", error: 22 } }
    var key: []u8 = []
    for b in name.bytes() {
        if b == 0 || b == 61 { return sys.TextResult { ok: false, value: "", error: 22 } }
        key.push(u8(b))
    }
    key.push(0)
    unsafe {
        _ := static_bytes("native", 16)
        p := c_getenv(addr(&key[0]))
        if usize(p) == 0 {
            return sys.TextResult { ok: false, value: "", error: 2 }
        }
        var out: []u8 = []
        var i: usize = 0
        while i < 1048576 {
            b := load_u8(ptr(usize(p) + i))
            if b == 0 { return bytes.decode(&out) }
            out.push(b)
            i = i + 1
        }
    }
    sys.TextResult { ok: false, value: "", error: 27 }
}

@requires(process)
pub fn env_or(name: string, fallback: string) -> string {
    res := env(name)
    if res.ok { return res.value }
    fallback
}

fn push_cstr(blob: &mut []u8, offsets: &mut []i32, value: string) -> bool {
    offsets.push(blob.len)
    blob.reserve(blob.len + value.len + 1)
    for b in value.bytes() {
        if b == 0 { return false }
        blob.push(u8(b))
    }
    blob.push(0)
    true
}

unsafe fn set_cloexec(fd: i32, is_darwin: bool) -> bool {
    var req: usize = 21585 // Linux FIOCLEX = 0x5451
    if is_darwin { req = 536897025 } // Darwin FIOCLEX = 0x20006601
    c_ioctl(fd, req) == 0
}

unsafe fn resolve_errno_ptr(is_darwin: bool) -> ptr {
    var sym_name := cstr("__errno_location")
    if is_darwin { sym_name = cstr("__error") }
    h := dl.open(ptr(0), 2)
    if usize(h) == 0 { return ptr(0) }
    sym := dl.symbol(h, sym_name)
    if usize(sym) == 0 { _ := dl.close(h); return ptr(0) }
    loc_fn: extern fn() -> ptr = ffi_fn(sym)
    ep := loc_fn()
    _ := dl.close(h)
    ep
}

unsafe fn parent_environ(is_darwin: bool) -> ptr {
    h := dl.open(ptr(0), 2)
    if usize(h) == 0 { return ptr(0) }
    var envp := ptr(0)
    if is_darwin {
        sym := dl.symbol(h, cstr("_NSGetEnviron"))
        if usize(sym) != 0 {
            get_env: extern fn() -> ptr = ffi_fn(sym)
            cell := get_env()
            if usize(cell) != 0 { envp = load_ptr(cell) }
        }
    } else {
        sym := dl.symbol(h, cstr("environ"))
        if usize(sym) != 0 { envp = load_ptr(sym) }
    }
    _ := dl.close(h)
    envp
}

fn key_overridden(keys: &[]string, raw_entry: &[]u8, eq_pos: i32) -> bool {
    for k in keys {
        if bytes.equals_text(&raw_entry, 0, eq_pos, k) { return true }
    }
    false
}

fn effective_path(cmd: &Command, is_darwin: bool) -> string {
    for i in 0..cmd.env_keys.len {
        if cmd.env_keys[i] == "PATH" {
            if cmd.env_unset[i] { return "" }
            return cmd.env_vals[i]
        }
    }
    if cmd.env_mode == .Clear { return "" }
    unsafe {
        p := c_getenv(cstr("PATH"))
        if usize(p) == 0 { return "/usr/bin:/bin" }
        var out: []u8 = []
        var idx: usize = 0
        while idx < 65536 {
            b := load_u8(ptr(usize(p) + idx))
            if b == 0 { break }
            out.push(b)
            idx = idx + 1
        }
        dec := bytes.decode(&out)
        if dec.ok { return dec.value }
    }
    _ := is_darwin
    "/usr/bin:/bin"
}

fn dead_child() -> Child {
    Child { pid: -1, pgid: -1, stdin_fd: -1, stdout_fd: -1, stderr_fd: -1, reaped: true, code: -1, signal: 0 }
}

fn spawn_internal(program: string, cmd: &Command) -> SpawnResult {
    if program.len == 0 {
        return SpawnResult { ok: false, child: dead_child(), error: 22 }
    }
    for i in 0..cmd.env_keys.len {
        k := cmd.env_keys[i]
        if k.len == 0 || text.find(k, "=") >= 0 {
            return SpawnResult { ok: false, child: dead_child(), error: 22 }
        }
    }

    is_darwin := host_os() == "macos"

    // 1. Pre-build argv, candidate executable paths, cwd, and envp BEFORE fork()
    // so the child performs zero heap allocations between fork() and execve().
    var str_blob: []u8 = []
    var arg_offsets: []i32 = []
    if !push_cstr(&mut str_blob, &mut arg_offsets, program) {
        return SpawnResult { ok: false, child: dead_child(), error: 22 }
    }
    for a in cmd.args {
        if !push_cstr(&mut str_blob, &mut arg_offsets, a) {
            return SpawnResult { ok: false, child: dead_child(), error: 22 }
        }
    }

    var cand_offsets: []i32 = []
    if text.find(program, "/") >= 0 {
        cand_offsets.push(arg_offsets[0])
    } else {
        search_path := effective_path(&cmd, is_darwin)
        if search_path.len > 0 {
            for dir in text.split(search_path, ":") {
                var prefix := dir
                if prefix == "" { prefix = "." }
                else if prefix[prefix.len - 1] != 47 { prefix += "/" }
                var candidate := prefix + program
                if prefix == "." { candidate = "./" + program }
                if !push_cstr(&mut str_blob, &mut cand_offsets, candidate) {
                    return SpawnResult { ok: false, child: dead_child(), error: 22 }
                }
            }
        }
    }
    if cand_offsets.len == 0 {
        return SpawnResult { ok: false, child: dead_child(), error: 2 }
    }

    var cwd_offset := -1
    if cmd.cwd.len > 0 {
        var tmp_off: []i32 = []
        if !push_cstr(&mut str_blob, &mut tmp_off, cmd.cwd) {
            return SpawnResult { ok: false, child: dead_child(), error: 22 }
        }
        cwd_offset = tmp_off[0]
    }

    var env_blob: []u8 = []
    var env_offsets: []i32 = []
    unsafe {
        _ := static_bytes("native", 16)
        if cmd.env_mode == .Inherit {
            envp_parent := parent_environ(is_darwin)
            if usize(envp_parent) != 0 {
                var idx: usize = 0
                var entry_buf: []u8 = []
                while idx < 16384 {
                    ep := load_ptr(ptr(usize(envp_parent) + idx * size_of(ptr)))
                    if usize(ep) == 0 { break }
                    entry_buf.clear()
                    var eq := -1
                    var j: usize = 0
                    while j < 1048576 {
                        b := load_u8(ptr(usize(ep) + j))
                        if b == 0 { break }
                        if b == 61 && eq < 0 { eq = i32(j) }
                        entry_buf.push(b)
                        j = j + 1
                    }
                    if eq > 0 && !key_overridden(&cmd.env_keys, &entry_buf, eq) {
                        env_offsets.push(env_blob.len)
                        bytes.extend(&mut env_blob, &entry_buf)
                        env_blob.push(0)
                    }
                    idx = idx + 1
                }
            }
        }
    }
    for i in 0..cmd.env_keys.len {
        if !cmd.env_unset[i] {
            if !push_cstr(&mut env_blob, &mut env_offsets, cmd.env_keys[i] + "=" + cmd.env_vals[i]) {
                return SpawnResult { ok: false, child: dead_child(), error: 22 }
            }
        }
    }
    if env_blob.len == 0 { env_blob.push(0) }

    unsafe {
        _ := static_bytes("native", 16)
        errno_ptr := resolve_errno_ptr(is_darwin)
        if usize(errno_ptr) == 0 {
            return SpawnResult { ok: false, child: dead_child(), error: 5 }
        }

        // Ignoring SIGPIPE in parent prevents broken child stdin pipes from killing parent;
        // the child resets SIGPIPE to SIG_DFL before execve.
        _ := c_signal(13, ptr(1))

        var argv: []ptr = []
        for off in arg_offsets { argv.push(addr(&str_blob[off])) }
        argv.push(ptr(0))

        var candidates: []ptr = []
        for off in cand_offsets { candidates.push(addr(&str_blob[off])) }

        var envp: []ptr = []
        for off in env_offsets { envp.push(addr(&env_blob[off])) }
        envp.push(ptr(0))

        var cwd_ptr := ptr(0)
        if cwd_offset >= 0 { cwd_ptr = addr(&str_blob[cwd_offset]) }

        var err_fds: [i32; 2] = [-1, -1]
        if c_pipe(addr(&mut err_fds[0])) != 0 {
            return SpawnResult { ok: false, child: dead_child(), error: portable_errno(load_i32(errno_ptr), is_darwin) }
        }
        _ := set_cloexec(err_fds[0], is_darwin)
        _ := set_cloexec(err_fds[1], is_darwin)

        var in_fds: [i32; 2] = [-1, -1]
        var out_fds: [i32; 2] = [-1, -1]
        var err_out_fds: [i32; 2] = [-1, -1]
        var null_read := ptr(0)
        var null_write := ptr(0)
        var setup_err := 0

        if cmd.stdin_mode == .Pipe {
            if c_pipe(addr(&mut in_fds[0])) != 0 { setup_err = portable_errno(load_i32(errno_ptr), is_darwin) }
            else { _ := set_cloexec(in_fds[1], is_darwin) }
        } else if cmd.stdin_mode == .Null {
            null_read = c_fopen(cstr("/dev/null"), cstr("rb"))
            if usize(null_read) == 0 { setup_err = portable_errno(load_i32(errno_ptr), is_darwin) }
        }

        if setup_err == 0 && cmd.stdout_mode == .Pipe {
            if c_pipe(addr(&mut out_fds[0])) != 0 { setup_err = portable_errno(load_i32(errno_ptr), is_darwin) }
            else { _ := set_cloexec(out_fds[0], is_darwin) }
        } else if setup_err == 0 && cmd.stdout_mode == .Null {
            null_write = c_fopen(cstr("/dev/null"), cstr("wb"))
            if usize(null_write) == 0 { setup_err = portable_errno(load_i32(errno_ptr), is_darwin) }
        }

        if setup_err == 0 && cmd.stderr_mode == .Pipe {
            if c_pipe(addr(&mut err_out_fds[0])) != 0 { setup_err = portable_errno(load_i32(errno_ptr), is_darwin) }
            else { _ := set_cloexec(err_out_fds[0], is_darwin) }
        } else if setup_err == 0 && cmd.stderr_mode == .Null && usize(null_write) == 0 {
            null_write = c_fopen(cstr("/dev/null"), cstr("wb"))
            if usize(null_write) == 0 { setup_err = portable_errno(load_i32(errno_ptr), is_darwin) }
        }

        if setup_err != 0 {
            if err_fds[0] >= 0 { _ := c_close(err_fds[0]) }
            if err_fds[1] >= 0 { _ := c_close(err_fds[1]) }
            if in_fds[0] >= 0 { _ := c_close(in_fds[0]) }
            if in_fds[1] >= 0 { _ := c_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := c_close(out_fds[0]) }
            if out_fds[1] >= 0 { _ := c_close(out_fds[1]) }
            if err_out_fds[0] >= 0 { _ := c_close(err_out_fds[0]) }
            if err_out_fds[1] >= 0 { _ := c_close(err_out_fds[1]) }
            if usize(null_read) != 0 { _ := c_fclose(null_read) }
            if usize(null_write) != 0 { _ := c_fclose(null_write) }
            return SpawnResult { ok: false, child: dead_child(), error: setup_err }
        }

        var null_rfd := -1
        if usize(null_read) != 0 { null_rfd = c_fileno(null_read) }
        var null_wfd := -1
        if usize(null_write) != 0 { null_wfd = c_fileno(null_write) }

        argv_ptr := addr(&argv[0])
        envp_ptr := addr(&envp[0])

        pid := c_fork()
        if pid < 0 {
            fork_err := portable_errno(load_i32(errno_ptr), is_darwin)
            _ := c_close(err_fds[0]); _ := c_close(err_fds[1])
            if in_fds[0] >= 0 { _ := c_close(in_fds[0]); _ := c_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := c_close(out_fds[0]); _ := c_close(out_fds[1]) }
            if err_out_fds[0] >= 0 { _ := c_close(err_out_fds[0]); _ := c_close(err_out_fds[1]) }
            if usize(null_read) != 0 { _ := c_fclose(null_read) }
            if usize(null_write) != 0 { _ := c_fclose(null_write) }
            return SpawnResult { ok: false, child: dead_child(), error: fork_err }
        }

        if pid == 0 {
            _ := c_setpgid(0, 0)
            _ := c_close(err_fds[0])
            if in_fds[1] >= 0 { _ := c_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := c_close(out_fds[0]) }
            if err_out_fds[0] >= 0 { _ := c_close(err_out_fds[0]) }

            var child_err := 0
            if usize(cwd_ptr) != 0 {
                if c_chdir(cwd_ptr) != 0 {
                    child_err = portable_errno(load_i32(errno_ptr), is_darwin)
                }
            }
            if child_err == 0 && in_fds[0] >= 0 {
                if c_dup2(in_fds[0], 0) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }
                if in_fds[0] > 2 { _ := c_close(in_fds[0]) }
            } else if child_err == 0 && null_rfd >= 0 {
                if c_dup2(null_rfd, 0) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }
            }
            if child_err == 0 && out_fds[1] >= 0 {
                if c_dup2(out_fds[1], 1) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }
                if out_fds[1] > 2 { _ := c_close(out_fds[1]) }
            } else if child_err == 0 && cmd.stdout_mode == .Null && null_wfd >= 0 {
                if c_dup2(null_wfd, 1) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }
            }
            if child_err == 0 && err_out_fds[1] >= 0 {
                if c_dup2(err_out_fds[1], 2) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }
                if err_out_fds[1] > 2 { _ := c_close(err_out_fds[1]) }
            } else if child_err == 0 && cmd.stderr_mode == .Null && null_wfd >= 0 {
                if c_dup2(null_wfd, 2) < 0 { child_err = portable_errno(load_i32(errno_ptr), is_darwin) }
            }
            if null_rfd > 2 { _ := c_close(null_rfd) }
            if null_wfd > 2 { _ := c_close(null_wfd) }

            // Restore default SIGPIPE disposition before execve.
            _ := c_signal(13, ptr(0))

            if child_err == 0 {
                var saw_perm := false
                var last_e := 2
                for ci in 0..candidates.len {
                    _ := c_execve(candidates[ci], argv_ptr, envp_ptr)
                    e := portable_errno(load_i32(errno_ptr), is_darwin)
                    if e == 13 { saw_perm = true }
                    if e != 2 && e != 20 { last_e = e }
                }
                if saw_perm { child_err = 13 } else { child_err = last_e }
            }

            var msg: [u8; 4] = [
                u8(child_err.bit_and(255)),
                u8(child_err.shr(8).bit_and(255)),
                u8(child_err.shr(16).bit_and(255)),
                u8(child_err.shr(24).bit_and(255)),
            ]
            _ := c_write(err_fds[1], addr(&msg[0]), 4)
            _ := c_close(err_fds[1])
            c_exit(127)
            return SpawnResult { ok: false, child: dead_child(), error: 127 }
        }

        // Parent side
        _ := c_setpgid(pid, pid)
        _ := c_close(err_fds[1])
        if in_fds[0] >= 0 { _ := c_close(in_fds[0]) }
        if out_fds[1] >= 0 { _ := c_close(out_fds[1]) }
        if err_out_fds[1] >= 0 { _ := c_close(err_out_fds[1]) }
        if usize(null_read) != 0 { _ := c_fclose(null_read) }
        if usize(null_write) != 0 { _ := c_fclose(null_write) }

        var err_buf: [u8; 4] = [0, 0, 0, 0]
        var err_got := 0
        while err_got < 4 {
            n := c_read(err_fds[0], ptr(usize(addr(&mut err_buf[0])) + usize(err_got)), usize(4 - err_got))
            if n == 0 { break }
            if n < 0 {
                e := load_i32(errno_ptr)
                if e == 4 { continue }
                break
            }
            err_got += i32(n)
        }
        _ := c_close(err_fds[0])

        if err_got == 4 {
            exec_lo := i32(err_buf[0]).bit_or(i32(err_buf[1]).shl(8))
            exec_hi := i32(err_buf[2]).shl(16).bit_or(i32(err_buf[3]).shl(24))
            exec_err := exec_lo.bit_or(exec_hi)
            var wstatus := 0
            while c_waitpid(pid, addr(&mut wstatus), 0) < 0 {
                if load_i32(errno_ptr) != 4 { break }
            }
            if in_fds[1] >= 0 { _ := c_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := c_close(out_fds[0]) }
            if err_out_fds[0] >= 0 { _ := c_close(err_out_fds[0]) }
            return SpawnResult { ok: false, child: dead_child(), error: exec_err }
        }

        if in_fds[1] >= 0 { _ := sys.net_set_nonblocking(in_fds[1], true) }
        if out_fds[0] >= 0 { _ := sys.net_set_nonblocking(out_fds[0], true) }
        if err_out_fds[0] >= 0 { _ := sys.net_set_nonblocking(err_out_fds[0], true) }

        return SpawnResult {
            ok: true,
            child: Child {
                pid: pid,
                pgid: pid,
                stdin_fd: in_fds[1],
                stdout_fd: out_fds[0],
                stderr_fd: err_out_fds[0],
                reaped: false,
                code: 0,
                signal: 0,
            },
            error: 0,
        }
    }
    SpawnResult { ok: false, child: dead_child(), error: 45 }
}

fn decode_wait_status(child: &mut Child, wstatus: i32) {
    child.reaped = true
    sig := wstatus.bit_and(127)
    if sig != 0 {
        child.signal = sig
        child.code = 128 + sig
    } else {
        child.signal = 0
        child.code = wstatus.shr(8).bit_and(255)
    }
}

pub fn child_pid(child: &Child) -> i32 { child.pid }

pub fn close_stdin(child: &mut Child) {
    if child.stdin_fd >= 0 {
        _ := sys.net_close(child.stdin_fd)
        child.stdin_fd = -1
    }
}

pub fn close_pipes(child: &mut Child) {
    close_stdin(&mut child)
    if child.stdout_fd >= 0 { _ := sys.net_close(child.stdout_fd); child.stdout_fd = -1 }
    if child.stderr_fd >= 0 { _ := sys.net_close(child.stderr_fd); child.stderr_fd = -1 }
}

fn signal_group(child: &Child, sig: i32) -> sys.Status {
    if child.reaped || child.pid <= 0 { return sys.Status { ok: true, error: 0 } }
    unsafe {
        _ := static_bytes("native", 16)
        if c_kill(-child.pgid, sig) == 0 || c_kill(child.pid, sig) == 0 {
            return sys.Status { ok: true, error: 0 }
        }
    }
    sys.Status { ok: true, error: 0 }
}

pub fn terminate(child: &mut Child) -> sys.Status { signal_group(&child, 15) }
pub fn kill(child: &mut Child) -> sys.Status { signal_group(&child, 9) }

pub fn try_wait(child: &mut Child) -> WaitResult {
    if child.reaped {
        return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }
    }
    unsafe {
        _ := static_bytes("native", 16)
        var wstatus := 0
        r := c_waitpid(child.pid, addr(&mut wstatus), 1)
        if r == child.pid {
            decode_wait_status(&mut child, wstatus)
            return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }
        }
        if r == 0 {
            return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }
        }
    }
    WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }
}

pub fn wait(child: &mut Child, timeout_ms: i64) -> WaitResult {
    if child.reaped {
        close_pipes(&mut child)
        return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }
    }
    unsafe {
        _ := static_bytes("native", 16)
        var wstatus := 0
        if timeout_ms <= 0 {
            while true {
                r := c_waitpid(child.pid, addr(&mut wstatus), 0)
                if r == child.pid {
                    decode_wait_status(&mut child, wstatus)
                    close_pipes(&mut child)
                    return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }
                }
                if r < 0 && c_kill(child.pid, 0) != 0 { break }
            }
            close_pipes(&mut child)
            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }
        }

        start := sys.now_ms()
        while true {
            r := c_waitpid(child.pid, addr(&mut wstatus), 1)
            if r == child.pid {
                decode_wait_status(&mut child, wstatus)
                close_pipes(&mut child)
                return WaitResult { ok: true, exited: true, timed_out: false, code: child.code, signal: child.signal, error: 0 }
            }
            now := sys.now_ms()
            if now - start >= timeout_ms {
                _ := kill(&mut child)
                while c_waitpid(child.pid, addr(&mut wstatus), 0) < 0 {
                    if c_kill(child.pid, 0) != 0 { break }
                }
                decode_wait_status(&mut child, wstatus)
                child.code = 124
                close_pipes(&mut child)
                return WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: child.signal, error: 60 }
            }
            sys.sleep_ms(2)
        }
    }
    WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }
}

fn read_pipe(fd: &mut i32, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
    if fd < 0 { return 0 }
    if max_bytes <= 0 { return 0 }
    var poll_buf: []u8 = []
    bytes.append_le(&mut poll_buf, i64(fd), 4)
    bytes.append_le(&mut poll_buf, 1, 2)
    bytes.append_le(&mut poll_buf, 0, 2)
    var chunk := 65536
    if max_bytes < 65536 { chunk = i32(max_bytes) }
    out.reserve(out.len + chunk)
    n := sys.net_read(fd, &mut out, max_bytes)
    if n > 0 { return n }
    if n == 0 { _ := sys.net_close(fd); fd = -1; return 0 }
    if n != -35 { return n }
    if timeout_ms == 0 { return -35 }
    pr := sys.net_poll(&mut poll_buf, 1, timeout_ms)
    if pr < 0 { return pr }
    if pr == 0 { return -35 }
    n2 := sys.net_read(fd, &mut out, max_bytes)
    if n2 == 0 { _ := sys.net_close(fd); fd = -1; return 0 }
    n2
}

pub fn read_stdout(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
    read_pipe(&mut child.stdout_fd, &mut out, max_bytes, timeout_ms)
}

pub fn read_stderr(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
    read_pipe(&mut child.stderr_fd, &mut out, max_bytes, timeout_ms)
}

pub fn read_stdout_line(child: &mut Child, timeout_ms: i64) -> sys.TextResult {
    start := sys.now_ms()
    var line: []u8 = []
    while line.len < 65536 {
        var rem: i64 = -1
        if timeout_ms > 0 {
            elapsed := sys.now_ms() - start
            if elapsed >= timeout_ms {
                return sys.TextResult { ok: false, value: "", error: 60 }
            }
            rem = timeout_ms - elapsed
        }
        before := line.len
        n := read_stdout(&mut child, &mut line, 1, rem)
        if n == 0 {
            if line.len == 0 { return sys.TextResult { ok: false, value: "", error: 5 } }
            break
        }
        if n == -35 {
            return sys.TextResult { ok: false, value: "", error: 60 }
        }
        if n < 0 {
            return sys.TextResult { ok: false, value: "", error: i32(-n) }
        }
        if line.len > before && line[line.len - 1] == b'\n' {
            break
        }
    }
    var end := line.len
    if end > 0 && line[end - 1] == b'\n' { end -= 1 }
    if end > 0 && line[end - 1] == b'\r' { end -= 1 }
    bytes.decode_range(&line, 0, end)
}

pub fn write_stdin(child: &mut Child, data: &[]u8) -> sys.Status {
    if child.stdin_fd < 0 { return sys.Status { ok: false, error: 9 } }
    if data.len == 0 { return sys.Status { ok: true, error: 0 } }
    is_darwin := host_os() == "macos"
    unsafe {
        _ := static_bytes("native", 16)
        errno_ptr := resolve_errno_ptr(is_darwin)
        var off := 0
        var poll_buf: []u8 = []
        while off < data.len {
            p := ptr(usize(addr(&data[0])) + usize(off))
            n := c_write(child.stdin_fd, p, usize(data.len - off))
            if n > 0 { off += i32(n); continue }
            e := portable_errno(load_i32(errno_ptr), is_darwin)
            if e == 4 { continue }
            if e == 35 {
                poll_buf.clear()
                bytes.append_le(&mut poll_buf, i64(child.stdin_fd), 4)
                bytes.append_le(&mut poll_buf, 4, 2)
                bytes.append_le(&mut poll_buf, 0, 2)
                _ := sys.net_poll(&mut poll_buf, 1, 100)
                continue
            }
            return sys.Status { ok: false, error: e }
        }
    }
    sys.Status { ok: true, error: 0 }
}

fn exec_internal(program: string, cmd: &Command) -> Output {
    var actual := cmd
    if actual.stdin_data.len > 0 { actual.stdin_mode = .Pipe }
    sp := spawn_internal(program, &actual)
    if !sp.ok {
        return Output {
            ok: false, error: sp.error, code: 127, signal: 0, timed_out: false,
            stdout: [], stderr: [],
        }
    }
    var child := sp.child
    var out_bytes: []u8 = []
    var err_bytes: []u8 = []
    var in_off := 0
    if actual.stdin_mode == .Pipe && actual.stdin_data.len == 0 {
        close_stdin(&mut child)
    }

    is_darwin := host_os() == "macos"
    start := sys.now_ms()
    var poll_buf: []u8 = []
    var fd_roles: []i32 = []

    while child.stdin_fd >= 0 || child.stdout_fd >= 0 || child.stderr_fd >= 0 {
        if actual.timeout_ms > 0 && sys.now_ms() - start >= actual.timeout_ms {
            _ := kill(&mut child)
            w := wait(&mut child, 1000)
            return Output {
                ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,
                stdout: out_bytes, stderr: err_bytes,
            }
        }

        poll_buf.clear()
        fd_roles.clear()
        if child.stdin_fd >= 0 {
            bytes.append_le(&mut poll_buf, i64(child.stdin_fd), 4)
            bytes.append_le(&mut poll_buf, 4, 2)
            bytes.append_le(&mut poll_buf, 0, 2)
            fd_roles.push(0)
        }
        if child.stdout_fd >= 0 {
            bytes.append_le(&mut poll_buf, i64(child.stdout_fd), 4)
            bytes.append_le(&mut poll_buf, 1, 2)
            bytes.append_le(&mut poll_buf, 0, 2)
            fd_roles.push(1)
        }
        if child.stderr_fd >= 0 {
            bytes.append_le(&mut poll_buf, i64(child.stderr_fd), 4)
            bytes.append_le(&mut poll_buf, 1, 2)
            bytes.append_le(&mut poll_buf, 0, 2)
            fd_roles.push(2)
        }

        var wait_ms: i64 = -1
        if actual.timeout_ms > 0 {
            rem := actual.timeout_ms - (sys.now_ms() - start)
            if rem <= 0 { continue }
            wait_ms = rem
        }
        _ := sys.net_poll(&mut poll_buf, i64(fd_roles.len), wait_ms)

        for idx in 0..fd_roles.len {
            revents := bytes.u16_le(&poll_buf, idx * 8 + 6)
            if revents == 0 { continue }
            role := fd_roles[idx]
            if role == 0 && child.stdin_fd >= 0 {
                unsafe {
                    _ := static_bytes("native", 16)
                    errno_ptr := resolve_errno_ptr(is_darwin)
                    while in_off < actual.stdin_data.len {
                        p := ptr(usize(addr(&actual.stdin_data[0])) + usize(in_off))
                        n := c_write(child.stdin_fd, p, usize(actual.stdin_data.len - in_off))
                        if n > 0 { in_off += i32(n); continue }
                        e := portable_errno(load_i32(errno_ptr), is_darwin)
                        if e == 4 { continue }
                        if e != 35 { in_off = actual.stdin_data.len }
                        break
                    }
                }
                if in_off >= actual.stdin_data.len { close_stdin(&mut child) }
            } else if role == 1 && child.stdout_fd >= 0 {
                while child.stdout_fd >= 0 {
                    if i64(out_bytes.len) >= actual.max_output_bytes {
                        _ := kill(&mut child)
                        _ := wait(&mut child, 1000)
                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }
                    }
                    out_bytes.reserve(out_bytes.len + 16384)
                    n := sys.net_read(child.stdout_fd, &mut out_bytes, 65536)
                    if n > 0 { continue }
                    if n == 0 || n != -35 {
                        _ := sys.net_close(child.stdout_fd)
                        child.stdout_fd = -1
                    }
                    break
                }
            } else if role == 2 && child.stderr_fd >= 0 {
                while child.stderr_fd >= 0 {
                    if i64(err_bytes.len) >= actual.max_output_bytes {
                        _ := kill(&mut child)
                        _ := wait(&mut child, 1000)
                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }
                    }
                    err_bytes.reserve(err_bytes.len + 16384)
                    n := sys.net_read(child.stderr_fd, &mut err_bytes, 65536)
                    if n > 0 { continue }
                    if n == 0 || n != -35 {
                        _ := sys.net_close(child.stderr_fd)
                        child.stderr_fd = -1
                    }
                    break
                }
            }
        }
    }

    var rem_wait: i64 = 0
    if actual.timeout_ms > 0 {
        rem_wait = actual.timeout_ms - (sys.now_ms() - start)
        if rem_wait <= 0 { rem_wait = 1 }
    }
    w := wait(&mut child, rem_wait)
    if w.timed_out {
        return Output {
            ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,
            stdout: out_bytes, stderr: err_bytes,
        }
    }
    Output {
        ok: w.ok, error: w.error, code: w.code, signal: w.signal, timed_out: false,
        stdout: out_bytes, stderr: err_bytes,
    }
}

@requires(process)
pub fn exec(cmd: &Command) -> Output { exec_internal(cmd.program, &cmd) }

@requires(process)
pub fn run(program: string, args: []string) -> Output {
    cmd := command(program, args)
    exec_internal(program, &cmd)
}

@requires(process)
pub fn run_in(program: string, args: []string, cwd: string) -> Output {
    var cmd := command(program, args)
    cmd.cwd = cwd
    exec_internal(program, &cmd)
}

@requires(process)
pub fn status(program: string, args: []string) -> WaitResult {
    var cmd := command(program, args)
    inherit_stdio(&mut cmd)
    sp := spawn_internal(program, &cmd)
    if !sp.ok {
        return WaitResult { ok: false, exited: false, timed_out: false, code: 127, signal: 0, error: sp.error }
    }
    var child := sp.child
    wait(&mut child, 0)
}

@requires(process)
pub fn spawn(cmd: &Command) -> SpawnResult { spawn_internal(cmd.program, &cmd) }

pub fn exec_granted(exe: &Executable, cmd: &Command) -> Output { exec_internal(exe.program, &cmd) }

pub fn run_granted(exe: &Executable, args: []string) -> Output {
    cmd := command(exe.program, args)
    exec_internal(exe.program, &cmd)
}

pub fn spawn_granted(exe: &Executable, cmd: &Command) -> SpawnResult { spawn_internal(exe.program, &cmd) }
