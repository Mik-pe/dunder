fn key_overridden(keys: &[]string, raw_entry: &[]u8, eq_pos: i32) -> bool {
    for k in &keys {
        if bytes.equals_text(&raw_entry, 0, eq_pos, k) { return true }
    }
    false
}

fn effective_path(cmd: &Command) -> string {
    for i in 0..cmd.env_keys.len {
        if cmd.env_keys[i] == "PATH" {
            if cmd.env_unset[i] { return "" }
            return cmd.env_vals[i].clone()
        }
    }
    if cmd.env_mode == .Clear { return "" }
    unsafe {
        mut p := ptr(0)
        if target_is("macos") {
            p = c_getenv(cstr("PATH"))
        } else if target_is("linux") {
            p = lookup_env_cstr(sys.envp(), "PATH")
        } else {
            _ := sys.pid()
        }
        if usize(p) == 0 { return "/usr/bin:/bin" }
        mut out: []u8 = []
        mut idx: usize = 0
        while idx < 65536 {
            b := load_u8(ptr(usize(p) + idx))
            if b == 0 { break }
            out.push(b)
            idx += 1
        }
        dec := bytes.decode(&out)
        if dec.ok { return dec.value }
    }
    "/usr/bin:/bin"
}

fn dead_child() -> Child {
    Child { pid: -1, pgid: -1, stdin_fd: -1, stdout_fd: -1, stderr_fd: -1, reaped: true, code: -1, signal: 0 }
}

fn spawn_internal(program: string, args: &[]string, cmd: &Command, stdin_mode: Stdio) -> SpawnResult {
    if program.len == 0 {
        return SpawnResult { ok: false, child: dead_child(), error: 22 }
    }
    for k in cmd.env_keys {
        if k.len == 0 || text.find(k, "=") >= 0 {
            return SpawnResult { ok: false, child: dead_child(), error: 22 }
        }
    }

    mut str_blob: []u8 = []
    mut arg_offsets: []i32 = []
    if !push_cstr(&mut str_blob, &mut arg_offsets, program) {
        return SpawnResult { ok: false, child: dead_child(), error: 22 }
    }
    for a in &args {
        if !push_cstr(&mut str_blob, &mut arg_offsets, a) {
            return SpawnResult { ok: false, child: dead_child(), error: 22 }
        }
    }

    mut cand_offsets: []i32 = []
    if text.find(program, "/") >= 0 {
        cand_offsets.push(arg_offsets[0])
    } else {
        search_path := effective_path(&cmd)
        if search_path.len > 0 {
            for dir in text.split(search_path, ":") {
                mut prefix := dir
                if prefix == "" { prefix = "." }
                else if prefix[prefix.len - 1] != 47 { prefix += "/" }
                mut candidate := prefix + program
                if prefix == "." { candidate = "./" + program }
                if !push_cstr(&mut str_blob, &mut cand_offsets, candidate) {
                    return SpawnResult { ok: false, child: dead_child(), error: 22 }
                }
            }
        }
    }
    if cand_offsets.len == 0 {
        return SpawnResult { ok: false, child: dead_child(), error: 2 }
    }

    mut cwd_offset := -1
    if cmd.cwd.len > 0 {
        mut tmp_off: []i32 = []
        if !push_cstr(&mut str_blob, &mut tmp_off, cmd.cwd) {
            return SpawnResult { ok: false, child: dead_child(), error: 22 }
        }
        cwd_offset = tmp_off[0]
    }

    mut env_blob: []u8 = []
    mut env_offsets: []i32 = []
    unsafe {
        if cmd.env_mode == .Inherit {
            envp_parent := parent_environ()
            if usize(envp_parent) != 0 {
                mut idx: usize = 0
                mut entry_buf: []u8 = []
                while idx < 16384 {
                    ep := load_ptr(ptr(usize(envp_parent) + idx * size_of(ptr)))
                    if usize(ep) == 0 { break }
                    entry_buf.clear()
                    mut eq := -1
                    mut j: usize = 0
                    while j < 1048576 {
                        b := load_u8(ptr(usize(ep) + j))
                        if b == 0 { break }
                        if b == 61 && eq < 0 { eq = i32(j) }
                        entry_buf.push(b)
                        j += 1
                    }
                    if eq > 0 && !key_overridden(&cmd.env_keys, &entry_buf, eq) {
                        env_offsets.push(env_blob.len)
                        bytes.extend(&mut env_blob, &entry_buf)
                        env_blob.push(0)
                    }
                    idx += 1
                }
            }
        }
    }
    for i in 0..cmd.env_keys.len {
        if !cmd.env_unset[i] {
            if !push_cstr(&mut env_blob, &mut env_offsets, f"{cmd.env_keys[i]}={cmd.env_vals[i]}") {
                return SpawnResult { ok: false, child: dead_child(), error: 22 }
            }
        }
    }
    if env_blob.len == 0 { env_blob.push(0) }

    unsafe {
        os_signal_pipe(true)

        mut argv: []ptr = []
        for off in &arg_offsets { argv.push(addr(&str_blob[off])) }
        argv.push(ptr(0))

        mut candidates: []ptr = []
        for off in &cand_offsets { candidates.push(addr(&str_blob[off])) }

        mut envp: []ptr = []
        for off in &env_offsets { envp.push(addr(&env_blob[off])) }
        envp.push(ptr(0))

        mut cwd_ptr := ptr(0)
        if cwd_offset >= 0 { cwd_ptr = addr(&str_blob[cwd_offset]) }

        mut err_fds: [i32; 2] = [-1, -1]
        err_pipe := os_pipe_cloexec(addr(&mut err_fds[0]))
        if err_pipe != 0 {
            return SpawnResult { ok: false, child: dead_child(), error: err_pipe }
        }

        mut in_fds: [i32; 2] = [-1, -1]
        mut out_fds: [i32; 2] = [-1, -1]
        mut err_out_fds: [i32; 2] = [-1, -1]
        mut null_read := NullFd { fd: -1, stream: ptr(0) }
        mut null_write := NullFd { fd: -1, stream: ptr(0) }
        mut setup_err := 0

        if stdin_mode == .Pipe {
            setup_err = os_pipe_cloexec(addr(&mut in_fds[0]))
        } else if stdin_mode == .Null {
            null_read = os_open_devnull(false, &mut setup_err)
        }

        if setup_err == 0 && cmd.stdout_mode == .Pipe {
            setup_err = os_pipe_cloexec(addr(&mut out_fds[0]))
        } else if setup_err == 0 && cmd.stdout_mode == .Null {
            null_write = os_open_devnull(true, &mut setup_err)
        }

        if setup_err == 0 && cmd.stderr_mode == .Pipe {
            setup_err = os_pipe_cloexec(addr(&mut err_out_fds[0]))
        } else if setup_err == 0 && cmd.stderr_mode == .Null && null_write.fd < 0 {
            null_write = os_open_devnull(true, &mut setup_err)
        }

        if setup_err != 0 {
            if err_fds[0] >= 0 { _ := os_close(err_fds[0]) }
            if err_fds[1] >= 0 { _ := os_close(err_fds[1]) }
            if in_fds[0] >= 0 { _ := os_close(in_fds[0]) }
            if in_fds[1] >= 0 { _ := os_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := os_close(out_fds[0]) }
            if out_fds[1] >= 0 { _ := os_close(out_fds[1]) }
            if err_out_fds[0] >= 0 { _ := os_close(err_out_fds[0]) }
            if err_out_fds[1] >= 0 { _ := os_close(err_out_fds[1]) }
            os_close_devnull(&mut null_read)
            os_close_devnull(&mut null_write)
            return SpawnResult { ok: false, child: dead_child(), error: setup_err }
        }

        null_rfd := null_read.fd
        null_wfd := null_write.fd

        argv_ptr := addr(&argv[0])
        envp_ptr := addr(&envp[0])

        pid := os_fork()
        if pid < 0 {
            fork_err := -pid
            _ := os_close(err_fds[0]); _ := os_close(err_fds[1])
            if in_fds[0] >= 0 { _ := os_close(in_fds[0]); _ := os_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := os_close(out_fds[0]); _ := os_close(out_fds[1]) }
            if err_out_fds[0] >= 0 { _ := os_close(err_out_fds[0]); _ := os_close(err_out_fds[1]) }
            os_close_devnull(&mut null_read)
            os_close_devnull(&mut null_write)
            return SpawnResult { ok: false, child: dead_child(), error: fork_err }
        }

        if pid == 0 {
            _ := os_setpgid(0, 0)
            _ := os_close(err_fds[0])
            if in_fds[1] >= 0 { _ := os_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := os_close(out_fds[0]) }
            if err_out_fds[0] >= 0 { _ := os_close(err_out_fds[0]) }

            mut child_err := 0
            if usize(cwd_ptr) != 0 {
                r := os_chdir(cwd_ptr)
                if r < 0 { child_err = -r }
            }
            if child_err == 0 && in_fds[0] >= 0 {
                r := os_dup2(in_fds[0], 0)
                if r < 0 { child_err = -r }
                if in_fds[0] > 2 { _ := os_close(in_fds[0]) }
            } else if child_err == 0 && null_rfd >= 0 {
                r := os_dup2(null_rfd, 0)
                if r < 0 { child_err = -r }
            }
            if child_err == 0 && out_fds[1] >= 0 {
                r := os_dup2(out_fds[1], 1)
                if r < 0 { child_err = -r }
                if out_fds[1] > 2 { _ := os_close(out_fds[1]) }
            } else if child_err == 0 && cmd.stdout_mode == .Null && null_wfd >= 0 {
                r := os_dup2(null_wfd, 1)
                if r < 0 { child_err = -r }
            }
            if child_err == 0 && err_out_fds[1] >= 0 {
                r := os_dup2(err_out_fds[1], 2)
                if r < 0 { child_err = -r }
                if err_out_fds[1] > 2 { _ := os_close(err_out_fds[1]) }
            } else if child_err == 0 && cmd.stderr_mode == .Null && null_wfd >= 0 {
                r := os_dup2(null_wfd, 2)
                if r < 0 { child_err = -r }
            }
            if null_rfd > 2 { _ := os_close(null_rfd) }
            if null_wfd > 2 { _ := os_close(null_wfd) }

            os_signal_pipe(false)
            if child_err == 0 { child_err = os_clear_signal_mask() }

            if child_err == 0 {
                mut saw_perm := false
                mut last_e := 2
                for ci in 0..candidates.len {
                    e := -os_execve(candidates[ci], argv_ptr, envp_ptr)
                    if e == 13 { saw_perm = true }
                    if e != 2 && e != 20 { last_e = e }
                }
                if saw_perm { child_err = 13 } else { child_err = last_e }
            }

            mut msg: [u8; 4] = [
                u8(child_err.bit_and(255)),
                u8(child_err.shr(8).bit_and(255)),
                u8(child_err.shr(16).bit_and(255)),
                u8(child_err.shr(24).bit_and(255)),
            ]
            _ := os_write(err_fds[1], addr(&msg[0]), 4)
            _ := os_close(err_fds[1])
            os_exit(127)
            return SpawnResult { ok: false, child: dead_child(), error: 127 }
        }

        _ := os_setpgid(pid, pid)
        _ := os_close(err_fds[1])
        if in_fds[0] >= 0 { _ := os_close(in_fds[0]) }
        if out_fds[1] >= 0 { _ := os_close(out_fds[1]) }
        if err_out_fds[1] >= 0 { _ := os_close(err_out_fds[1]) }
        os_close_devnull(&mut null_read)
        os_close_devnull(&mut null_write)

        mut err_buf: [u8; 4] = [0, 0, 0, 0]
        mut err_got := 0
        while err_got < 4 {
            n := os_read(err_fds[0], ptr(usize(addr(&mut err_buf[0])) + usize(err_got)), usize(4 - err_got))
            if n == 0 { break }
            if n < 0 {
                if n == -4 { continue }
                break
            }
            err_got += i32(n)
        }
        _ := os_close(err_fds[0])

        if err_got == 4 {
            exec_lo := i32(err_buf[0]).bit_or(i32(err_buf[1]).shl(8))
            exec_hi := i32(err_buf[2]).shl(16).bit_or(i32(err_buf[3]).shl(24))
            exec_err := exec_lo.bit_or(exec_hi)
            mut wstatus := 0
            while true {
                wr := os_waitpid(pid, addr(&mut wstatus), 0)
                if wr >= 0 || wr != -4 { break }
            }
            if in_fds[1] >= 0 { _ := os_close(in_fds[1]) }
            if out_fds[0] >= 0 { _ := os_close(out_fds[0]) }
            if err_out_fds[0] >= 0 { _ := os_close(err_out_fds[0]) }
            return SpawnResult { ok: false, child: dead_child(), error: exec_err }
        }

        if in_fds[1] >= 0 { _ := sys.net_set_nonblocking(in_fds[1], true) }
        if out_fds[0] >= 0 { _ := sys.net_set_nonblocking(out_fds[0], true) }
        if err_out_fds[0] >= 0 { _ := sys.net_set_nonblocking(err_out_fds[0], true) }

        return SpawnResult {
            ok: true,
            child: Child {
                pid: pid,
                pgid: pid,
                stdin_fd: in_fds[1],
                stdout_fd: out_fds[0],
                stderr_fd: err_out_fds[0],
                reaped: false,
                code: 0,
                signal: 0,
            },
            error: 0,
        }
    }
    SpawnResult { ok: false, child: dead_child(), error: 45 }
}

fn decode_wait_status(child: &mut Child, wstatus: i32) {
    child.reaped = true
    sig := wstatus.bit_and(127)
    if sig != 0 {
        child.signal = sig
        child.code = 128 + sig
    } else {
        child.signal = 0
        child.code = wstatus.shr(8).bit_and(255)
    }
}

fn append_poll_fd(out: &mut []u8, fd: i32, events: i64) {
    bytes.append_le(&mut out, i64(fd), 4)
    bytes.append_le(&mut out, events, 2)
    bytes.append_le(&mut out, 0, 2)
}

impl Child {
    pub fn pid(&self) -> i32 { self.pid }

    pub fn close_stdin(&mut self) {
        if self.stdin_fd >= 0 {
            _ := sys.net_close(self.stdin_fd)
            self.stdin_fd = -1
        }
    }

    pub fn close_pipes(&mut self) {
        self.close_stdin()
        if self.stdout_fd >= 0 { _ := sys.net_close(self.stdout_fd); self.stdout_fd = -1 }
        if self.stderr_fd >= 0 { _ := sys.net_close(self.stderr_fd); self.stderr_fd = -1 }
    }

    pub fn take_stdin(&mut self) -> Result<ChildStdin, sys.IoError> {
        if self.stdin_fd < 0 { return .Err(.BadDescriptor) }
        fd := self.stdin_fd
        self.stdin_fd = -1
        _ := sys.net_set_nonblocking(fd, false)
        .Ok(ChildStdin { fd: fd })
    }

    pub fn take_stdout(&mut self) -> Result<ChildStdout, sys.IoError> {
        if self.stdout_fd < 0 { return .Err(.BadDescriptor) }
        fd := self.stdout_fd
        self.stdout_fd = -1
        _ := sys.net_set_nonblocking(fd, false)
        .Ok(ChildStdout { fd: fd })
    }

    pub fn take_stderr(&mut self) -> Result<ChildStderr, sys.IoError> {
        if self.stderr_fd < 0 { return .Err(.BadDescriptor) }
        fd := self.stderr_fd
        self.stderr_fd = -1
        _ := sys.net_set_nonblocking(fd, false)
        .Ok(ChildStderr { fd: fd })
    }

    fn signal_group(&self, sig: i32) -> sys.Status {
        if self.reaped || self.pid <= 0 { return sys.Status { ok: true, error: 0 } }
        unsafe {
            if os_kill(-self.pgid, sig) == 0 || os_kill(self.pid, sig) == 0 {
                return sys.Status { ok: true, error: 0 }
            }
        }
        sys.Status { ok: true, error: 0 }
    }

    pub fn terminate(&mut self) -> sys.Status { self.signal_group(15) }
    pub fn kill(&mut self) -> sys.Status { self.signal_group(9) }

    pub fn try_wait(&mut self) -> WaitResult {
        if self.reaped {
            return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }
        }
        unsafe {
            mut wstatus := 0
            r := os_waitpid(self.pid, addr(&mut wstatus), 1)
            if r == self.pid {
                decode_wait_status(&mut self, wstatus)
                return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }
            }
            if r == 0 {
                return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }
            }
        }
        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }
    }

    pub fn wait(&mut self, timeout_ms: i64) -> WaitResult {
        if self.reaped {
            self.close_pipes()
            return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }
        }
        unsafe {
            mut wstatus := 0
            if timeout_ms <= 0 {
                while true {
                    r := os_waitpid(self.pid, addr(&mut wstatus), 0)
                    if r == self.pid {
                        decode_wait_status(&mut self, wstatus)
                        self.close_pipes()
                        return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }
                    }
                    if r < 0 && os_kill(self.pid, 0) != 0 { break }
                }
                self.close_pipes()
                return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }
            }

            start := sys.now_ms()
            while true {
                r := os_waitpid(self.pid, addr(&mut wstatus), 1)
                if r == self.pid {
                    decode_wait_status(&mut self, wstatus)
                    self.close_pipes()
                    return WaitResult { ok: true, exited: true, timed_out: false, code: self.code, signal: self.signal, error: 0 }
                }
                now := sys.now_ms()
                if now - start >= timeout_ms {
                    _ := self.kill()
                    while true {
                        wr := os_waitpid(self.pid, addr(&mut wstatus), 0)
                        if wr >= 0 || os_kill(self.pid, 0) != 0 { break }
                    }
                    decode_wait_status(&mut self, wstatus)
                    self.code = 124
                    self.close_pipes()
                    return WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: self.signal, error: 60 }
                }
                sys.sleep_ms(2)
            }
        }
        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }
    }

    pub fn read_stdout(&mut self, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
        read_pipe(&mut self.stdout_fd, &mut out, max_bytes, timeout_ms)
    }

    pub fn read_stderr(&mut self, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
        read_pipe(&mut self.stderr_fd, &mut out, max_bytes, timeout_ms)
    }

    pub fn read_stdout_line(&mut self, timeout_ms: i64) -> sys.TextResult {
        start := sys.now_ms()
        mut line: []u8 = []
        while line.len < 65536 {
            mut rem: i64 = -1
            if timeout_ms > 0 {
                elapsed := sys.now_ms() - start
                if elapsed >= timeout_ms {
                    return sys.TextResult { ok: false, value: "", error: 60 }
                }
                rem = timeout_ms - elapsed
            }
            before := line.len
            n := self.read_stdout(&mut line, 1, rem)
            if n == 0 {
                if line.len == 0 { return sys.TextResult { ok: false, value: "", error: 5 } }
                break
            }
            if n == -35 {
                return sys.TextResult { ok: false, value: "", error: 60 }
            }
            if n < 0 {
                return sys.TextResult { ok: false, value: "", error: i32(-n) }
            }
            if line.len > before && line[line.len - 1] == b'\n' {
                break
            }
        }
        mut end := line.len
        if end > 0 && line[end - 1] == b'\n' { end -= 1 }
        if end > 0 && line[end - 1] == b'\r' { end -= 1 }
        bytes.decode_range(&line, 0, end)
    }

    pub fn write_stdin(&mut self, data: &[]u8) -> sys.Status {
        if self.stdin_fd < 0 { return sys.Status { ok: false, error: 9 } }
        if data.len == 0 { return sys.Status { ok: true, error: 0 } }
        unsafe {
            mut off := 0
            mut poll_buf: []u8 = []
            while off < data.len {
                p := ptr(usize(addr(&data[0])) + usize(off))
                n := os_write(self.stdin_fd, p, usize(data.len - off))
                if n > 0 { off += i32(n); continue }
                e := i32(-n)
                if e == 4 { continue }
                if e == 35 {
                    poll_buf.clear()
                    append_poll_fd(&mut poll_buf, self.stdin_fd, 4)
                    _ := sys.net_poll(&mut poll_buf, 1, 100)
                    continue
                }
                return sys.Status { ok: false, error: e }
            }
        }
        sys.Status { ok: true, error: 0 }
    }
}

pub fn child_pid(child: &Child) -> i32 { child.pid() }
pub fn close_stdin(child: &mut Child) { child.close_stdin() }
pub fn close_pipes(child: &mut Child) { child.close_pipes() }
pub fn terminate(child: &mut Child) -> sys.Status { child.terminate() }
pub fn kill(child: &mut Child) -> sys.Status { child.kill() }
pub fn try_wait(child: &mut Child) -> WaitResult { child.try_wait() }
pub fn wait(child: &mut Child, timeout_ms: i64) -> WaitResult { child.wait(timeout_ms) }

fn read_pipe(fd: &mut i32, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
    if fd < 0 { return 0 }
    if max_bytes <= 0 { return 0 }
    mut poll_buf: []u8 = []
    append_poll_fd(&mut poll_buf, fd, 1)
    mut chunk := 65536
    if max_bytes < 65536 { chunk = i32(max_bytes) }
    out.reserve(out.len + chunk)
    n := sys.net_read(fd, &mut out, max_bytes)
    if n > 0 { return n }
    if n == 0 { _ := sys.net_close(fd); fd = -1; return 0 }
    if n != -35 { return n }
    if timeout_ms == 0 { return -35 }
    pr := sys.net_poll(&mut poll_buf, 1, timeout_ms)
    if pr < 0 { return pr }
    if pr == 0 { return -35 }
    n2 := sys.net_read(fd, &mut out, max_bytes)
    if n2 == 0 { _ := sys.net_close(fd); fd = -1; return 0 }
    n2
}

pub fn read_stdout(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
    child.read_stdout(&mut out, max_bytes, timeout_ms)
}

pub fn read_stderr(child: &mut Child, out: &mut []u8, max_bytes: i64, timeout_ms: i64) -> i64 {
    child.read_stderr(&mut out, max_bytes, timeout_ms)
}

pub fn read_stdout_line(child: &mut Child, timeout_ms: i64) -> sys.TextResult {
    child.read_stdout_line(timeout_ms)
}

pub fn write_stdin(child: &mut Child, data: &[]u8) -> sys.Status { child.write_stdin(&data) }

fn exec_internal(program: string, args: &[]string, cmd: &Command) -> Output {
    mut stdin_mode := cmd.stdin_mode
    if cmd.stdin_data.len > 0 { stdin_mode = .Pipe }
    sp := spawn_internal(program, &args, &cmd, stdin_mode)
    if !sp.ok {
        return Output {
            ok: false, error: sp.error, code: 127, signal: 0, timed_out: false,
            stdout: [], stderr: [],
        }
    }
    mut child := sp.child
    mut out_bytes: []u8 = []
    mut err_bytes: []u8 = []
    mut in_off := 0
    if stdin_mode == .Pipe && cmd.stdin_data.len == 0 {
        close_stdin(&mut child)
    }

    start := sys.now_ms()
    mut poll_buf: []u8 = []
    mut fd_roles: []i32 = []

    while child.stdin_fd >= 0 || child.stdout_fd >= 0 || child.stderr_fd >= 0 {
        if cmd.timeout_ms > 0 && sys.now_ms() - start >= cmd.timeout_ms {
            _ := kill(&mut child)
            w := wait(&mut child, 1000)
            return Output {
                ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,
                stdout: out_bytes, stderr: err_bytes,
            }
        }

        poll_buf.clear()
        fd_roles.clear()
        if child.stdin_fd >= 0 {
            append_poll_fd(&mut poll_buf, child.stdin_fd, 4)
            fd_roles.push(0)
        }
        if child.stdout_fd >= 0 {
            append_poll_fd(&mut poll_buf, child.stdout_fd, 1)
            fd_roles.push(1)
        }
        if child.stderr_fd >= 0 {
            append_poll_fd(&mut poll_buf, child.stderr_fd, 1)
            fd_roles.push(2)
        }

        mut wait_ms: i64 = -1
        if cmd.timeout_ms > 0 {
            rem := cmd.timeout_ms - (sys.now_ms() - start)
            if rem <= 0 { continue }
            wait_ms = rem
        }
        _ := sys.net_poll(&mut poll_buf, i64(fd_roles.len), wait_ms)

        for idx in 0..fd_roles.len {
            revents := bytes.u16_le(&poll_buf, idx * 8 + 6)
            if revents == 0 { continue }
            role := fd_roles[idx]
            if role == 0 && child.stdin_fd >= 0 {
                unsafe {
                    while in_off < cmd.stdin_data.len {
                        p := ptr(usize(addr(&cmd.stdin_data[0])) + usize(in_off))
                        n := os_write(child.stdin_fd, p, usize(cmd.stdin_data.len - in_off))
                        if n > 0 { in_off += i32(n); continue }
                        if n == -4 { continue }
                        if n != -35 { in_off = cmd.stdin_data.len }
                        break
                    }
                }
                if in_off >= cmd.stdin_data.len { close_stdin(&mut child) }
            } else if role == 1 && child.stdout_fd >= 0 {
                while child.stdout_fd >= 0 {
                    if i64(out_bytes.len) >= cmd.max_output_bytes {
                        _ := kill(&mut child)
                        _ := wait(&mut child, 1000)
                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }
                    }
                    out_bytes.reserve(out_bytes.len + 16384)
                    n := sys.net_read(child.stdout_fd, &mut out_bytes, 65536)
                    if n > 0 { continue }
                    if n == 0 || n != -35 {
                        _ := sys.net_close(child.stdout_fd)
                        child.stdout_fd = -1
                    }
                    break
                }
            } else if role == 2 && child.stderr_fd >= 0 {
                while child.stderr_fd >= 0 {
                    if i64(err_bytes.len) >= cmd.max_output_bytes {
                        _ := kill(&mut child)
                        _ := wait(&mut child, 1000)
                        return Output { ok: false, error: 27, code: 125, signal: 9, timed_out: false, stdout: out_bytes, stderr: err_bytes }
                    }
                    err_bytes.reserve(err_bytes.len + 16384)
                    n := sys.net_read(child.stderr_fd, &mut err_bytes, 65536)
                    if n > 0 { continue }
                    if n == 0 || n != -35 {
                        _ := sys.net_close(child.stderr_fd)
                        child.stderr_fd = -1
                    }
                    break
                }
            }
        }
    }

    mut rem_wait: i64 = 0
    if cmd.timeout_ms > 0 {
        rem_wait = cmd.timeout_ms - (sys.now_ms() - start)
        if rem_wait <= 0 { rem_wait = 1 }
    }
    w := wait(&mut child, rem_wait)
    if w.timed_out {
        return Output {
            ok: false, error: 60, code: 124, signal: w.signal, timed_out: true,
            stdout: out_bytes, stderr: err_bytes,
        }
    }
    Output {
        ok: w.ok, error: w.error, code: w.code, signal: w.signal, timed_out: false,
        stdout: out_bytes, stderr: err_bytes,
    }
}

@requires(process)
pub fn exec(cmd: &Command) -> Output { cmd.exec() }

@requires(process)
pub fn run(program: string, args: []string) -> Output {
    cmd := command("", [])
    exec_internal(program, &args, &cmd)
}

@requires(process)
pub fn run_in(program: string, args: []string, cwd: string) -> Output {
    mut cmd := command("", [])
    cmd.cwd = cwd.clone()
    exec_internal(program, &args, &cmd)
}

@requires(process)
pub fn status(program: string, args: []string) -> WaitResult {
    mut cmd := command("", [])
    cmd.inherit_stdio()
    sp := spawn_internal(program, &args, &cmd, cmd.stdin_mode)
    if !sp.ok {
        return WaitResult { ok: false, exited: false, timed_out: false, code: 127, signal: 0, error: sp.error }
    }
    mut child := sp.child
    child.wait(0)
}

@requires(process)
pub fn replace(program: string, args: &[]string) -> sys.Status {
    replace_as(program, program, &args)
}

@requires(process)
pub fn replace_as(program: string, argv0: string, args: &[]string) -> sys.Status {
    if program.len == 0 || argv0.len == 0 { return sys.Status { ok: false, error: 22 } }
    mut blob: []u8 = []
    mut arg_offsets: []i32 = []
    if !push_cstr(&mut blob, &mut arg_offsets, argv0) {
        return sys.Status { ok: false, error: 22 }
    }
    for arg in &args {
        if !push_cstr(&mut blob, &mut arg_offsets, arg) {
            return sys.Status { ok: false, error: 22 }
        }
    }
    mut candidate_offsets: []i32 = []
    mut program_offsets: []i32 = []
    if !push_cstr(&mut blob, &mut program_offsets, program) {
        return sys.Status { ok: false, error: 22 }
    }
    if text.find(program, "/") >= 0 {
        candidate_offsets.push(program_offsets[0])
    } else {
        path := env("PATH")
        mut search_path := "/usr/bin:/bin"
        if path.ok { search_path = path.value }
        for directory in text.split(search_path, ":") {
            candidate := if directory.len == 0 { f"./{program}" } else { f"{directory}/{program}" }
            if !push_cstr(&mut blob, &mut candidate_offsets, candidate) {
                return sys.Status { ok: false, error: 22 }
            }
        }
    }
    unsafe {
        mut argv: []ptr = []
        for offset in &arg_offsets { argv.push(addr(&blob[offset])) }
        argv.push(ptr(0))
        environ := parent_environ()
        mut failure := 2
        for offset in &candidate_offsets {
            code := -os_execve(addr(&blob[offset]), addr(&argv[0]), environ)
            if code == 13 { failure = 13 }
            else if code != 2 && code != 20 { return sys.Status { ok: false, error: code } }
        }
        sys.Status { ok: false, error: failure }
    }
}

@requires(process)
pub fn spawn(cmd: &Command) -> SpawnResult { cmd.spawn() }

pub fn exec_granted(exe: &Executable, cmd: &Command) -> Output { exe.exec(&cmd) }

pub fn run_granted(exe: &Executable, args: []string) -> Output { exe.run(args) }

pub fn spawn_granted(exe: &Executable, cmd: &Command) -> SpawnResult { exe.spawn(&cmd) }

@resource
pub opaque struct ChildSet {
    cap: i32,
    count: i32,
    active: []bool,
    pids: []i32,
    pgids: []i32,
    stdin_fds: []i32,
    stdout_fds: []i32,
    stderr_fds: []i32,
    reaped: []bool,
    codes: []i32,
    signals: []i32,
    poll_buf: []u8,
}

fn drain_fd_all(fd: &mut i32, out: &mut []u8) {
    while fd >= 0 {
        out.reserve(out.len + 16384)
        n := sys.net_read(fd, &mut out, 65536)
        if n > 0 { continue }
        if n == 0 { _ := sys.net_close(fd); fd = -1 }
        break
    }
}

impl ChildSet {
    pub fn new(capacity: i32) -> Self {
        assert(capacity > 0 && capacity <= 1024)
        mut s := Self {
            cap: capacity, count: 0, active: [], pids: [], pgids: [],
            stdin_fds: [], stdout_fds: [], stderr_fds: [],
            reaped: [], codes: [], signals: [], poll_buf: [],
        }
        for _ in 0..capacity {
            s.active.push(false)
            s.pids.push(-1)
            s.pgids.push(-1)
            s.stdin_fds.push(-1)
            s.stdout_fds.push(-1)
            s.stderr_fds.push(-1)
            s.reaped.push(false)
            s.codes.push(0)
            s.signals.push(0)
        }
        s
    }

    pub fn len(&self) -> i32 { self.count }

    pub fn is_active(&self, slot: i32) -> bool {
        slot >= 0 && slot < self.cap && self.active[slot]
    }

    pub fn insert(&mut self, child: &mut Child) -> i32 {
        if child.pid <= 0 { return -1 }
        for slot in 0..self.cap {
            if !self.active[slot] {
                self.active[slot] = true
                self.pids[slot] = child.pid
                self.pgids[slot] = child.pgid
                self.stdin_fds[slot] = child.stdin_fd
                self.stdout_fds[slot] = child.stdout_fd
                self.stderr_fds[slot] = child.stderr_fd
                self.reaped[slot] = child.reaped
                self.codes[slot] = child.code
                self.signals[slot] = child.signal
                self.count += 1
                child.pid = -1
                child.pgid = -1
                child.stdin_fd = -1
                child.stdout_fd = -1
                child.stderr_fd = -1
                child.reaped = true
                return slot
            }
        }
        -1
    }

    pub fn try_insert(&mut self, move child: Child) -> Result<i32, Child> {
        mut owner := child
        slot := self.insert(&mut owner)
        if slot < 0 { return .Err(owner) }
        .Ok(slot)
    }

    pub fn drain(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) {
        if slot < 0 || slot >= self.cap || !self.active[slot] { return }
        mut out_fd := self.stdout_fds[slot]
        drain_fd_all(&mut out_fd, &mut stdout_out)
        self.stdout_fds[slot] = out_fd
        mut err_fd := self.stderr_fds[slot]
        drain_fd_all(&mut err_fd, &mut stderr_out)
        self.stderr_fds[slot] = err_fd
    }

    fn release_slot(&mut self, slot: i32) {
        if self.stdin_fds[slot] >= 0 { _ := sys.net_close(self.stdin_fds[slot]); self.stdin_fds[slot] = -1 }
        if self.stdout_fds[slot] >= 0 { _ := sys.net_close(self.stdout_fds[slot]); self.stdout_fds[slot] = -1 }
        if self.stderr_fds[slot] >= 0 { _ := sys.net_close(self.stderr_fds[slot]); self.stderr_fds[slot] = -1 }
        self.active[slot] = false
        self.pids[slot] = -1
        self.count -= 1
    }

    pub fn poll_io(&mut self, timeout_ms: i64) -> i32 {
        if self.count <= 0 { return 0 }
        self.poll_buf.clear()
        mut nfds := 0
        mut has_pipeless := false
        for slot in 0..self.cap {
            if !self.active[slot] { continue }
            out_fd := self.stdout_fds[slot]
            err_fd := self.stderr_fds[slot]
            if out_fd >= 0 {
                append_poll_fd(&mut self.poll_buf, out_fd, 1)
                nfds += 1
            }
            if err_fd >= 0 {
                append_poll_fd(&mut self.poll_buf, err_fd, 1)
                nfds += 1
            }
            if out_fd < 0 && err_fd < 0 { has_pipeless = true }
        }
        mut wait_ms := timeout_ms
        if has_pipeless && (wait_ms < 0 || wait_ms > 1) { wait_ms = 1 }
        if nfds == 0 {
            if wait_ms > 0 { sys.sleep_ms(wait_ms) }
            return 0
        }
        i32(sys.net_poll(&mut self.poll_buf, i64(nfds), wait_ms))
    }

    pub fn wait_any(&mut self, timeout_ms: i64) -> i32 {
        self.poll_io(timeout_ms)
    }

    pub fn try_wait(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {
        if slot < 0 || slot >= self.cap || !self.active[slot] {
            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }
        }
        self.drain(slot, &mut stdout_out, &mut stderr_out)
        if self.reaped[slot] {
            code := self.codes[slot]
            sig := self.signals[slot]
            self.release_slot(slot)
            return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }
        }
        unsafe {
            pid := self.pids[slot]
            mut wstatus := 0
            mut r := os_waitpid(pid, addr(&mut wstatus), 1)
            if r == 0 && self.stdout_fds[slot] < 0 && self.stderr_fds[slot] < 0 {
                os_usleep_50()
                r = os_waitpid(pid, addr(&mut wstatus), 1)
            }
            if r == pid {
                self.drain(slot, &mut stdout_out, &mut stderr_out)
                self.release_slot(slot)
                sig := wstatus.bit_and(127)
                mut code := wstatus.shr(8).bit_and(255)
                if sig != 0 { code = 128 + sig }
                return WaitResult { ok: true, exited: true, timed_out: false, code: code, signal: sig, error: 0 }
            }
            if r == 0 {
                return WaitResult { ok: true, exited: false, timed_out: false, code: 0, signal: 0, error: 0 }
            }
        }
        self.release_slot(slot)
        WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 5 }
    }

    pub fn kill_reap(&mut self, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult {
        if slot < 0 || slot >= self.cap || !self.active[slot] {
            return WaitResult { ok: false, exited: false, timed_out: false, code: -1, signal: 0, error: 22 }
        }
        unsafe {
            pid := self.pids[slot]
            pgid := self.pgids[slot]
            if (pgid <= 0 || os_kill(-pgid, 9) != 0) && pid > 0 {
                _ := os_kill(pid, 9)
            }
            mut wstatus := 0
            while os_waitpid(pid, addr(&mut wstatus), 0) < 0 {
                if os_kill(pid, 0) != 0 { break }
            }
        }
        self.drain(slot, &mut stdout_out, &mut stderr_out)
        self.release_slot(slot)
        WaitResult { ok: false, exited: true, timed_out: true, code: 124, signal: 9, error: 60 }
    }

    pub fn kill_all(&mut self) {
        mut sink_out: []u8 = []
        mut sink_err: []u8 = []
        for slot in 0..self.cap {
            if self.active[slot] {
                _ := self.kill_reap(slot, &mut sink_out, &mut sink_err)
                sink_out.clear()
                sink_err.clear()
            }
        }
    }
}

pub fn set_new(capacity: i32) -> ChildSet { ChildSet::new(capacity) }
pub fn set_len(set: &ChildSet) -> i32 { set.len() }
pub fn set_active(set: &ChildSet, slot: i32) -> bool { set.is_active(slot) }
pub fn set_insert(set: &mut ChildSet, child: &mut Child) -> i32 { set.insert(&mut child) }
pub fn set_drain(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) { set.drain(slot, &mut stdout_out, &mut stderr_out) }
pub fn set_poll_io(set: &mut ChildSet, timeout_ms: i64) -> i32 { set.poll_io(timeout_ms) }
pub fn set_wait_any(set: &mut ChildSet, timeout_ms: i64) -> i32 { set.poll_io(timeout_ms) }
pub fn set_try_wait(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult { set.try_wait(slot, &mut stdout_out, &mut stderr_out) }
pub fn set_kill_reap(set: &mut ChildSet, slot: i32, stdout_out: &mut []u8, stderr_out: &mut []u8) -> WaitResult { set.kill_reap(slot, &mut stdout_out, &mut stderr_out) }
pub fn set_kill_all(set: &mut ChildSet) { set.kill_all() }
