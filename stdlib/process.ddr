pub enum EnvMode { Inherit = 0, Clear = 1 }
pub enum Stdio { Inherit = 0, Pipe = 1, Null = 2 }

pub opaque struct Executable { program: string }

pub struct Command {
    program: string,
    args: []string,
    cwd: string,
    env_mode: EnvMode,
    env_keys: []string,
    env_vals: []string,
    env_unset: []bool,
    stdin_mode: Stdio,
    stdout_mode: Stdio,
    stderr_mode: Stdio,
    stdin_data: []u8,
    timeout_ms: i64,
    max_output_bytes: i64,
}

pub struct Output {
    ok: bool,
    error: i32,
    code: i32,
    signal: i32,
    timed_out: bool,
    stdout: []u8,
    stderr: []u8,
}

@resource
pub opaque struct Child {
    pid: i32,
    pgid: i32,
    stdin_fd: i32,
    stdout_fd: i32,
    stderr_fd: i32,
    reaped: bool,
    code: i32,
    signal: i32,
}

@resource(dispose)
pub opaque struct ChildStdin { fd: i32 }

@resource(dispose)
pub opaque struct ChildStdout { fd: i32 }

@resource(dispose)
pub opaque struct ChildStderr { fd: i32 }

fn set_pipe_nonblocking(fd: i32, enabled: bool) -> Result<(), sys.IoError> {
    if fd < 0 { return .Err(.BadDescriptor) }
    r := sys.net_set_nonblocking(fd, enabled)
    if r < 0 { return .Err(sys.IoError::from_code(i32(-r))) }
    .Ok
}

impl ChildStdin {
    pub fn fd(&self) -> i32 { self.fd }
    pub fn set_nonblocking(&self, enabled: bool) -> Result<(), sys.IoError> { set_pipe_nonblocking(self.fd, enabled) }
    pub fn close(&mut self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Ok }
        fd := self.fd
        self.fd = -1
        n := sys.fd_close(fd)
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        .Ok
    }
    fn dispose(&mut self) {
        if self.fd >= 0 {
            _ := sys.fd_close(self.fd)
            self.fd = -1
        }
    }
}

impl ChildStdout {
    pub fn fd(&self) -> i32 { self.fd }
    pub fn set_nonblocking(&self, enabled: bool) -> Result<(), sys.IoError> { set_pipe_nonblocking(self.fd, enabled) }
    pub fn close(&mut self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Ok }
        fd := self.fd
        self.fd = -1
        n := sys.fd_close(fd)
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        .Ok
    }
    fn dispose(&mut self) {
        if self.fd >= 0 {
            _ := sys.fd_close(self.fd)
            self.fd = -1
        }
    }
}

impl ChildStderr {
    pub fn fd(&self) -> i32 { self.fd }
    pub fn set_nonblocking(&self, enabled: bool) -> Result<(), sys.IoError> { set_pipe_nonblocking(self.fd, enabled) }
    pub fn close(&mut self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Ok }
        fd := self.fd
        self.fd = -1
        n := sys.fd_close(fd)
        if n < 0 { return .Err(sys.IoError::from_code(i32(-n))) }
        .Ok
    }
    fn dispose(&mut self) {
        if self.fd >= 0 {
            _ := sys.fd_close(self.fd)
            self.fd = -1
        }
    }
}

impl io.Write for ChildStdin {
    fn write(&mut self, data: &[]u8) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        io.fd_write_chunk(self.fd, &data)
    }
    fn flush(&mut self) -> Result<(), sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        .Ok
    }
}

impl io.Read for ChildStdout {
    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        io.fd_read_chunk(self.fd, &mut out, max_bytes)
    }
}

impl io.Read for ChildStderr {
    fn read(&mut self, out: &mut []u8, max_bytes: i32) -> Result<i32, sys.IoError> {
        if self.fd < 0 { return .Err(.BadDescriptor) }
        io.fd_read_chunk(self.fd, &mut out, max_bytes)
    }
}

pub struct SpawnResult { ok: bool, child: Child, error: i32 }
pub struct WaitResult { ok: bool, exited: bool, timed_out: bool, code: i32, signal: i32, error: i32 }

impl Executable {
    @requires(process)
    pub fn grant(move program: string) -> Self { Self { program: program } }
    pub fn path(&self) -> string { self.program.clone() }
    pub fn exec(&self, cmd: &Command) -> Output { exec_internal(self.program, &cmd.args, &cmd) }

    pub fn run(&self, args: []string) -> Output {
        cmd := Command::new("", [])
        exec_internal(self.program, &args, &cmd)
    }

    pub fn spawn(&self, cmd: &Command) -> SpawnResult {
        spawn_internal(self.program, &cmd.args, &cmd, cmd.stdin_mode)
    }
}

impl Command {
    pub fn new(move program: string, move args: []string) -> Self {
        Self {
            program: program,
            args: args,
            cwd: "",
            env_mode: .Inherit,
            env_keys: [],
            env_vals: [],
            env_unset: [],
            stdin_mode: .Null,
            stdout_mode: .Pipe,
            stderr_mode: .Pipe,
            stdin_data: [],
            timeout_ms: 0,
            max_output_bytes: 67108864,
        }
    }

    pub fn add_arg(&mut self, move arg: string) { self.args.push(move arg) }

    pub fn add_args(&mut self, move args: []string) {
        self.args.reserve(self.args.len + args.len)
        for a in move args { self.args.push(move a) }
    }

    pub fn set_cwd(&mut self, move cwd: string) { self.cwd = cwd }

    pub fn clear_env(&mut self) {
        self.env_mode = .Clear
        self.env_keys.clear()
        self.env_vals.clear()
        self.env_unset.clear()
    }

    pub fn set_env(&mut self, move key: string, move value: string) {
        for i in 0..self.env_keys.len {
            if self.env_keys[i] == key {
                self.env_vals[i] = value
                self.env_unset[i] = false
                return
            }
        }
        self.env_keys.push(move key)
        self.env_vals.push(move value)
        self.env_unset.push(false)
    }

    pub fn unset_env(&mut self, move key: string) {
        for i in 0..self.env_keys.len {
            if self.env_keys[i] == key {
                self.env_vals[i] = ""
                self.env_unset[i] = true
                return
            }
        }
        self.env_keys.push(move key)
        self.env_vals.push("")
        self.env_unset.push(true)
    }

    pub fn inherit_stdio(&mut self) {
        self.stdin_mode = .Inherit
        self.stdout_mode = .Inherit
        self.stderr_mode = .Inherit
    }

    pub fn set_stdio(&mut self, stdin_mode: Stdio, stdout_mode: Stdio, stderr_mode: Stdio) {
        self.stdin_mode = stdin_mode
        self.stdout_mode = stdout_mode
        self.stderr_mode = stderr_mode
    }

    pub fn set_stdin(&mut self, move data: []u8) {
        self.stdin_mode = .Pipe
        self.stdin_data = data
    }

    pub fn set_stdin_text(&mut self, input: string) {
        self.stdin_mode = .Pipe
        self.stdin_data.clear()
        bytes.append_utf8(&mut self.stdin_data, input)
    }

    pub fn set_timeout(&mut self, timeout_ms: i64) { self.timeout_ms = timeout_ms }

    @requires(process)
    pub fn exec(&self) -> Output { exec_internal(self.program, &self.args, &self) }

    @requires(process)
    pub fn spawn(&self) -> SpawnResult { spawn_internal(self.program, &self.args, &self, self.stdin_mode) }
}

impl Output {
    pub fn succeeded(&self) -> bool {
        self.ok && !self.timed_out && self.signal == 0 && self.code == 0
    }

    pub fn stdout_utf8(&self) -> sys.TextResult { bytes.decode(&self.stdout) }
    pub fn stderr_utf8(&self) -> sys.TextResult { bytes.decode(&self.stderr) }

    pub fn stdout_text(&self) -> string {
        dec := bytes.decode(&self.stdout)
        if dec.ok { return dec.value }
        ""
    }

    pub fn stderr_text(&self) -> string {
        dec := bytes.decode(&self.stderr)
        if dec.ok { return dec.value }
        ""
    }
}

@requires(process)
pub fn grant(move program: string) -> Executable { Executable::grant(move program) }

pub fn executable_path(exe: &Executable) -> string { exe.path() }

pub fn command(move program: string, move args: []string) -> Command { Command::new(move program, move args) }

pub fn add_arg(cmd: &mut Command, move arg: string) { cmd.add_arg(move arg) }

pub fn add_args(cmd: &mut Command, move args: []string) { cmd.add_args(move args) }

pub fn set_cwd(cmd: &mut Command, move cwd: string) { cmd.set_cwd(move cwd) }

pub fn clear_env(cmd: &mut Command) { cmd.clear_env() }

pub fn set_env(cmd: &mut Command, move key: string, move value: string) { cmd.set_env(move key, move value) }

pub fn unset_env(cmd: &mut Command, move key: string) { cmd.unset_env(move key) }

pub fn inherit_stdio(cmd: &mut Command) { cmd.inherit_stdio() }

pub fn set_stdio(cmd: &mut Command, stdin_mode: Stdio, stdout_mode: Stdio, stderr_mode: Stdio) {
    cmd.set_stdio(stdin_mode, stdout_mode, stderr_mode)
}

pub fn set_stdin(cmd: &mut Command, move data: []u8) { cmd.set_stdin(move data) }

pub fn set_stdin_text(cmd: &mut Command, input: string) { cmd.set_stdin_text(input) }

pub fn set_timeout(cmd: &mut Command, timeout_ms: i64) { cmd.set_timeout(timeout_ms) }

pub fn succeeded(out: &Output) -> bool { out.succeeded() }

pub fn stdout_utf8(out: &Output) -> sys.TextResult { out.stdout_utf8() }
pub fn stderr_utf8(out: &Output) -> sys.TextResult { out.stderr_utf8() }

pub fn stdout_text(out: &Output) -> string { out.stdout_text() }

pub fn stderr_text(out: &Output) -> string { out.stderr_text() }

fn portable_errno(raw: i32, is_darwin: bool) -> i32 {
    if raw <= 0 { return 5 }
    if is_darwin { return raw }
    if raw == 1 || raw == 2 || raw == 4 || raw == 5 || raw == 8 || raw == 9 || raw == 12 ||
       raw == 13 || raw == 17 || raw == 20 || raw == 21 || raw == 22 ||
       raw == 27 || raw == 28 || raw == 30 || raw == 32 { return raw }
    if raw == 11 { return 35 }
    if raw == 36 { return 63 }
    if raw == 39 { return 66 }
    if raw == 84 { return 92 }
    if raw == 95 { return 45 }
    if raw == 98 { return 48 }
    if raw == 103 { return 53 }
    if raw == 104 { return 54 }
    if raw == 110 { return 60 }
    if raw == 111 { return 61 }
    if raw == 115 { return 36 }
    10000 + raw
}

unsafe fn lookup_env_cstr(envp: ptr, name: string) -> ptr {
    if usize(envp) == 0 || name.len == 0 { return ptr(0) }
    mut idx: usize = 0
    while idx < 65536 {
        entry := load_ptr(ptr(usize(envp) + idx * 8))
        if usize(entry) == 0 { break }
        mut match_key := true
        mut i := 0
        while i < name.len {
            b := load_u8(ptr(usize(entry) + usize(i)))
            if b == 0 || i32(b) != name[i] {
                match_key = false
                break
            }
            i += 1
        }
        if match_key && load_u8(ptr(usize(entry) + usize(name.len))) == 61 {
            return ptr(usize(entry) + usize(name.len) + 1)
        }
        idx += 1
    }
    ptr(0)
}

unsafe fn macos_errno() -> i32 {
    if target_is("macos") { return portable_errno(load_i32(c_errno_ptr()), true) }
    5
}

pub fn host_os() -> string {
    if target_is("macos") {
        unsafe {
            mut uts: [u64; 256] = [0; 256]
            if c_uname(addr(&mut uts[0])) != 0 { return "unknown" }
            if load_u8(addr(&uts[0])) == 68 { return "macos" }
        }
        return "unknown"
    } else if target_is("linux") {
        unsafe {
            mut uts: [u64; 64] = [0; 64]
            if sys.linux_syscall(160, i64(usize(addr(&mut uts[0]))), 0, 0, 0, 0, 0) != 0 { return "unknown" }
            if load_u8(addr(&uts[0])) == 76 { return "linux" }
        }
        return "unknown"
    }
    _ := sys.pid()
    "unknown"
}

pub fn host_arch() -> string {
    if target_is("macos") {
        unsafe {
            mut uts: [u64; 256] = [0; 256]
            if c_uname(addr(&mut uts[0])) != 0 { return "unknown" }
            if load_u8(addr(&uts[0])) != 68 { return "unknown" }
            base := usize(addr(&uts[0])) + 1024
            mut raw: []u8 = []
            for i in 0..32 {
                b := load_u8(ptr(base + usize(i)))
                if b == 0 { break }
                raw.push(b)
            }
            m := bytes.decode(&raw).value
            if m == "arm64" || m == "aarch64" { return "arm64" }
            if m == "x86_64" || m == "amd64" { return "x86_64" }
            return m
        }
    } else if target_is("linux") {
        unsafe {
            mut uts: [u64; 64] = [0; 64]
            if sys.linux_syscall(160, i64(usize(addr(&mut uts[0]))), 0, 0, 0, 0, 0) != 0 { return "unknown" }
            base := usize(addr(&uts[0])) + 260
            mut raw: []u8 = []
            for i in 0..32 {
                b := load_u8(ptr(base + usize(i)))
                if b == 0 { break }
                raw.push(b)
            }
            m := bytes.decode(&raw).value
            if m == "arm64" || m == "aarch64" { return "arm64" }
            if m == "x86_64" || m == "amd64" { return "x86_64" }
            return m
        }
    }
    _ := sys.pid()
    "unknown"
}

pub fn host_target() -> string {
    arch := host_arch()
    os := host_os()
    f"{arch}-{os}"
}

fn ceil_quota(quota: i64, period: i64) -> i32 {
    if quota <= 0 || period <= 0 { return 0 }
    mut count := (quota + period - 1) / period
    if count < 1 { count = 1 }
    if count > 256 { count = 256 }
    i32(count)
}

fn parse_positive_token(raw: string) -> i64 {
    parsed := decimal.integer(raw)
    if !parsed.ok || parsed.value <= 0 { return 0 }
    parsed.value
}

fn parse_cpu_max(raw: string) -> i32 {
    trimmed := text.trim(raw)
    if trimmed == "" { return 0 }
    lines := text.split(trimmed, "\n")
    first := text.trim(lines[0])
    if first == "" { return 0 }
    parts := text.split(first, " ")
    if parts.len < 2 || parts[0] == "max" { return 0 }
    mut tokens: []string = []
    for part in &parts {
        item := text.trim(part)
        if item != "" { tokens.push(move item) }
    }
    if tokens.len < 2 || tokens[0] == "max" { return 0 }
    ceil_quota(parse_positive_token(tokens[0]), parse_positive_token(tokens[1]))
}

fn parse_cfs_quota(quota_raw: string, period_raw: string) -> i32 {
    quota_parsed := decimal.integer(text.trim(quota_raw))
    if !quota_parsed.ok || quota_parsed.value <= 0 { return 0 }
    period := parse_positive_token(text.trim(period_raw))
    ceil_quota(quota_parsed.value, period)
}

fn read_linux_sysfile(path: string) -> string {
    if target_is("linux") {
        mut cpath: []u8 = []
        cpath.reserve(path.len + 1)
        for b in path.bytes() {
            if b == 0 { return "" }
            cpath.push(u8(b))
        }
        cpath.push(0)
        unsafe {
            fd := sys.linux_syscall(56, -100, i64(usize(addr(&cpath[0]))), 0, 0, 0, 0)
            if fd < 0 { return "" }
            mut buf: [u8; 256] = [0; 256]
            mut total := 0
            while total < 255 {
                r := sys.linux_syscall(63, fd, i64(usize(addr(&buf[0])) + usize(total)), i64(255 - total), 0, 0, 0)
                if r == -4 { continue }
                if r <= 0 { break }
                total += i32(r)
            }
            _ := sys.linux_syscall(57, fd, 0, 0, 0, 0, 0)
            if total <= 0 { return "" }
            mut out: []u8 = []
            out.reserve(total)
            for i in 0..total { out.push(buf[i]) }
            decoded := sys.decode_u8(&out)
            if decoded.ok { return decoded.value }
        }
    }
    ""
}

fn cgroup_cpu_limit() -> i32 {
    v2 := read_linux_sysfile("/sys/fs/cgroup/cpu.max")
    if v2 != "" {
        limit := parse_cpu_max(v2)
        if limit > 0 { return limit }
    }
    v1_quota := read_linux_sysfile("/sys/fs/cgroup/cpu/cpu.cfs_quota_us")
    v1_period := read_linux_sysfile("/sys/fs/cgroup/cpu/cpu.cfs_period_us")
    if v1_quota != "" && v1_period != "" {
        return parse_cfs_quota(v1_quota, v1_period)
    }
    0
}

fn parse_cpu_list(raw: string) -> i32 {
    trimmed := text.trim(raw)
    if trimmed == "" { return 0 }
    parts := text.split(trimmed, ",")
    mut total: i64 = 0
    for part in &parts {
        item := text.trim(part)
        if item == "" { return 0 }
        bounds := text.split(item, "-")
        if bounds.len == 1 {
            v := decimal.integer(bounds[0])
            if !v.ok || v.value < 0 { return 0 }
            total += 1
        } else if bounds.len == 2 {
            lo := decimal.integer(text.trim(bounds[0]))
            hi := decimal.integer(text.trim(bounds[1]))
            if !lo.ok || !hi.ok || lo.value < 0 || hi.value < lo.value { return 0 }
            total += hi.value - lo.value + 1
        } else {
            return 0
        }
    }
    if total <= 0 { return 0 }
    if total > 256 { return 256 }
    i32(total)
}

pub fn host_cpus() -> i32 {
    if target_is("macos") {
        unsafe {
            n := c_sysconf(58)
            if n >= 1 && n <= 256 { return i32(n) }
            if n > 256 { return 256 }
        }
        return 1
    } else if target_is("linux") {
        mut count := 0
        unsafe {
            mut mask: [u64; 32] = [0; 32]
            r := sys.linux_syscall(123, 0, 256, i64(usize(addr(&mut mask[0]))), 0, 0, 0)
            if r > 0 {
                nbytes := i32(r)
                base := usize(addr(&mask[0]))
                for i in 0..nbytes {
                    mut b := i32(load_u8(ptr(base + usize(i))))
                    while b != 0 {
                        if b.bit_and(1) != 0 { count += 1 }
                        b = b.shr(1)
                    }
                }
            }
        }
        if count <= 0 {
            online := read_linux_sysfile("/sys/devices/system/cpu/online")
            if online != "" { count = parse_cpu_list(online) }
        }
        cg := cgroup_cpu_limit()
        if cg > 0 && (count <= 0 || cg < count) { count = cg }
        if count >= 1 && count <= 256 { return count }
        if count > 256 { return 256 }
        return 1
    }
    _ := sys.pid()
    1
}

unsafe fn decode_env_value(value: ptr) -> sys.TextResult {
    if usize(value) == 0 { return sys.TextResult { ok: false, value: "", error: 2 } }
    mut out: []u8 = []
    for i in 0..1048576 {
        b := load_u8(ptr(usize(value) + usize(i)))
        if b == 0 { return bytes.decode(&out) }
        out.push(b)
    }
    sys.TextResult { ok: false, value: "", error: 27 }
}

@requires(process)
pub fn env(name: string) -> sys.TextResult {
    if name.len == 0 { return sys.TextResult { ok: false, value: "", error: 22 } }
    mut key: []u8 = []
    for b in name.bytes() {
        if b == 0 || b == 61 { return sys.TextResult { ok: false, value: "", error: 22 } }
        key.push(u8(b))
    }
    key.push(0)
    if target_is("macos") {
        unsafe { return decode_env_value(c_getenv(addr(&key[0]))) }
    } else if target_is("linux") {
        unsafe { return decode_env_value(lookup_env_cstr(sys.envp(), name)) }
    }
    _ := sys.pid()
    sys.TextResult { ok: false, value: "", error: 45 }
}

@requires(process)
pub fn env_or(name: string, fallback: string) -> string {
    res := env(name)
    if res.ok { return res.value }
    fallback.clone()
}

fn push_cstr(blob: &mut []u8, offsets: &mut []i32, value: string) -> bool {
    offsets.push(blob.len)
    blob.reserve(blob.len + value.len + 1)
    for b in value.bytes() {
        if b == 0 { return false }
        blob.push(u8(b))
    }
    blob.push(0)
    true
}

struct NullFd { fd: i32, stream: ptr }

unsafe fn parent_environ() -> ptr {
    if target_is("macos") {
        cell := c_ns_get_environ()
        if usize(cell) != 0 { return load_ptr(cell) }
        return ptr(0)
    } else if target_is("linux") {
        return sys.envp()
    }
    _ := sys.pid()
    ptr(0)
}

unsafe fn os_signal_pipe(ignore: bool) {
    if target_is("macos") {
        mut handler := ptr(0)
        if ignore { handler = ptr(1) }
        _ := c_signal(13, handler)
