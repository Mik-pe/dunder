@extern("/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib", "RAND_bytes")
unsafe fn mac_rand(output: ptr, count: i32) -> i32
@extern("libcrypto.so.3", "RAND_bytes")
unsafe fn linux_rand(output: ptr, count: i32) -> i32
unsafe fn c_rand(output: ptr, count: i32) -> i32 {
    if target_is("macos") { return mac_rand(output, count) }
    if target_is("linux") { return linux_rand(output, count) }
    -1
}

