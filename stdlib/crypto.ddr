capability unsafe

// Native cryptography uses the system OpenSSL and Argon2 libraries. No custom
// cipher or password hash implementation is hidden in an application shim.
import std.bytes as bytes
import std.parse as parse
import std.sha256 as sha256
import std.text as text

pub struct BytesResult { ok: bool, value: []u8, error: string }
pub struct TextResult { ok: bool, value: string, error: string }
pub struct SealResult { ok: bool, ciphertext: []u8, tag: []u8, error: string }

@extern("/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib", "RAND_bytes")
unsafe fn mac_rand(output: ptr, count: i32) -> i32
@extern("libcrypto.so.3", "RAND_bytes")
unsafe fn linux_rand(output: ptr, count: i32) -> i32
unsafe fn c_rand(output: ptr, count: i32) -> i32 {
    if target_is("macos") { return mac_rand(output, count) }
    if target_is("linux") { return linux_rand(output, count) }
    -1
}

@extern("/opt/homebrew/opt/argon2/lib/libargon2.dylib", "argon2id_hash_encoded")
unsafe fn mac_argon_hash(time: u32, memory: u32, parallel: u32, password: ptr, password_len: usize, salt: ptr, salt_len: usize, hash_len: usize, output: ptr, output_len: usize) -> i32
@extern("libargon2.so.1", "argon2id_hash_encoded")
unsafe fn linux_argon_hash(time: u32, memory: u32, parallel: u32, password: ptr, password_len: usize, salt: ptr, salt_len: usize, hash_len: usize, output: ptr, output_len: usize) -> i32
unsafe fn c_argon_hash(time: u32, memory: u32, parallel: u32, password: ptr, password_len: usize, salt: ptr, salt_len: usize, hash_len: usize, output: ptr, output_len: usize) -> i32 {
    if target_is("macos") { return mac_argon_hash(time, memory, parallel, password, password_len, salt, salt_len, hash_len, output, output_len) }
    if target_is("linux") { return linux_argon_hash(time, memory, parallel, password, password_len, salt, salt_len, hash_len, output, output_len) }
    -1
}

