pub fn valid() -> [](string, string, string) {
    [
        ("borrowed_input_snapshot", "fn work(n:&i64)->i64{n}\nfn main(){mut n:i64=41;task scope j(1){id:=spawn j work(n);n=0;print(await j(id))};print(n)}", "41\n0\n"),
        ("shared_snapshot", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn main(){mut w:=World{values:[40,42]};task scope j(2,shared w.clone()){a:=spawn j lookup(1);w.values[0]=9;w.values.clear();b:=spawn j lookup(0);print(await! j(b));print(await! j(a))}}", "40\n42\n"),
        ("owned_and_shared", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn main(){task scope j(1,initialize,shared World{values:[11]}){a:=spawn j update(0);b:=spawn j update(0);print(await! j(a));print(await! j(b))}}", "1\n2\n"),
        ("shared_clone", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn copy(world:&World)->[]i32{mut v:=world.values.clone();v[0]=100;v}\nfn job(i:i32,world:&World)->[]i32{copy(&world)}\nfn main(){mut w:=World{values:[41]};task scope j(1,shared w.clone()){a:=spawn j job(0);b:=spawn j lookup(0);print((await! j(a))[0]);print(await! j(b))};print(w.values[0])}", "100\n41\n41\n"),
        ("persistent_workspace", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){first:=spawn j collect(11);second:=spawn j collect(22);mut a:=await! j(first);a[0]=99;out:=await! j(second);print(out[0]);print(out[1]);n:=spawn j count(3);print(await j(n))};task scope j(1,initialize){n:=spawn j count(0);print(await! j(n))}}", "11\n22\n12\n7\n"),
        ("isolated_workspaces", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(2,initialize){a:=spawn j collect(41);b:=spawn j collect(43);left:=await! j(a);right:=await! j(b);assert(left.len==1&&right.len==1);print(left[0]);print(right[0]);c:=spawn j count(0);d:=spawn j count(0);print(await j(c));print(await j(d))}}", "41\n43\n8\n8\n"),
        ("scalar_repeat", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope jobs(2){id:=spawn jobs work(7);copy:=id;print(await jobs(id));print(await jobs(copy))}}", "49\n49\n"),
        ("key_fifo", "fn work(n:i64)->i64 { n*n }\nfn main(){mut ids:[]TaskID<i64> = [];task scope jobs(1){for i in 0..20{ids.push(spawn jobs work(i64(i)))};mut sum:i64=0;for id in ids{sum=sum+await jobs(id)};print(sum)}}", "2470\n"),
        ("snapshot_copies", "fn work(move a:[]i64)->[]i64{mut b:=a;b[0]=b[0]+1;b}\nfn main(){mut a:[]i64=[41];task scope j(2){id:=spawn j work(a.clone());a[0]=0;mut first:=await! j(id);snapshot:=first.clone();first[0]=99;print(snapshot[0]);print(first[0]);print(a[0])}}", "42\n99\n0\n"),
        ("records", "struct Job{a:[]i64,n:i64}\nstruct Answer{a:[]i64,n:i64}\nfn work(x:Job)->Answer{mut a:=x.a.clone();a[0]=a[0]+x.n;Answer{a:a,n:x.n}}\nfn main(){mut a:[]i64=[40];mut x:=Job{a:a,n:2};task scope j(1){id:=spawn j work(x);x.a[0]=0;mut y:=await! j(id);snapshot:=y.clone();y.a[0]=99;print(snapshot.a[0]);print(y.a[0])}}", "42\n99\n"),
        ("nested_return", "fn work(n:i64)->[]i64{[n,n+1]}\nfn result()->[]i64{task scope outer(2){a:=spawn outer work(40);task scope inner(1){b:=spawn inner work(42);ignored:=await! outer(a);return await! inner(b)}}}\nfn main(){mut a:=result();a[0]=a[0]+1;print(a[0]);print(a[1])}", "43\n43\n"),
        ("tail_return", "fn work(n:i64)->[]i64{[n]}\nfn result()->[]i64{task scope jobs(1){id:=spawn jobs work(42);await! jobs(id)}}\nfn main(){print(result()[0])}", "42\n"),
        ("break_continue", "fn work(n:i64)->i64 { n*n }\nfn main(){mut sum:i64=0;for i in 0..6{task scope j(2){id:=spawn j work(i64(i));if i==1{continue};if i==4{break};sum=sum+await j(id)}};print(sum)}", "13\n"),
        ("discard_owned", "fn work(n:i64)->[]i64{[n]}\nfn main(){for i in 0..10{task scope j(2){a:=spawn j work(i64(i));b:=spawn j work(i64(i+1))}};print(42)}", "42\n"),
        ("local_borrow", "fn add(n:&mut i64){n=n+1}\nfn work(n:i64)->i64{mut x:=n;add(&mut x);x}\nfn main(){task scope j(1){id:=spawn j work(41);print(await j(id))}}", "42\n"),
        ("local_string", "fn work(n:i64)->i64{s:=n.str();assert(s.len>0);n+1}\nfn main(){task scope j(1){id:=spawn j work(41);print(await j(id))}}", "42\n"),
        ("local_runes_bytes", "fn work(n:i64)->i64{s:=n.str();a:=s.runes();b:=s.bytes();i64(a.len+b.len)}\nfn main(){task scope j(1){id:=spawn j work(42);print(await j(id))}}", "4\n"),
        ("local_formatter", "fn work(n:f64)->i64{s:=n.str();assert(s.len>0);42}\nfn main(){task scope j(1){id:=spawn j work(3.5);print(await j(id))}}", "42\n"),
        ("bool", "fn work(n:bool)->bool{!n}\nfn main(){task scope j(1){id:=spawn j work(false);assert(await j(id));print(42)}}", "42\n"),
        ("unit", "fn work(n:i64){assert(n==42)}\nfn main(){task scope j(1){id:=spawn j work(42);await j(id);await j(id)};print(42)}", "42\n"),
        ("tag_enum", "enum Tag{A,B}\nfn work(n:Tag)->Tag{n}\nfn main(){task scope j(1){id:=spawn j work(Tag.B);assert(await j(id)==Tag.B);print(42)}}", "42\n"),
        ("bool_array", "fn work(move a:[]bool)->[]bool{mut b:=a;b[0]=!b[0];b}\nfn main(){mut a:[]bool=[false];task scope j(1){id:=spawn j work(a.clone());a[0]=true;mut first:=await! j(id);snapshot:=first.clone();first[0]=false;assert(snapshot[0]);print(42)}}", "42\n"),
        ("fixed_array", "fn work(move a:[u8;4])->[u8;4]{mut b:=a;b[0]=u8(42);b}\nfn main(){mut a:[u8;4]=[u8(1);4];task scope j(1){id:=spawn j work(a.clone());a[0]=u8(0);print(i32((await! j(id))[0]));print(i32(a[0]))}}", "42\n0\n"),
        ("c_record", "@c_layout struct Pair{a:i32,b:i64}\nfn work(p:Pair)->Pair{Pair{a:p.a+1,b:p.b+2}}\nfn main(){mut p:=Pair{a:40,b:40};task scope j(1){id:=spawn j work(p);p.a=0;answer:=await j(id);print(answer.a);print(answer.b)}}", "41\n42\n"),
        ("float_results", "fn work(n:f64)->f64{n+0.5}\nfn main(){task scope j(2){a:=spawn j work(2.0);b:=spawn j work(6.5);assert(await j(a)==2.5);assert(await j(b)==7.0);print(42)}}", "42\n"),
        ("empty_scope", "fn main(){task scope jobs(1){mut x:=0;x=x+1;print(x)}}", "1\n"),
        ("scope_shadowing", "fn work(n:i64)->i64{n}\nfn main(){mut jobs:i32=2;task scope jobs(jobs){id:=spawn jobs work(42);{mut jobs:=7;print(jobs)};print(await jobs(id))};print(jobs)}", "7\n42\n2\n"),
        ("consume_cached", "fn work(n:i64)->i64{n}\nfn result()->i64{task scope j(1){a:=spawn j work(40);b:=spawn j work(41);c:=await j(a);assert(c==40);x:=await! j(a);return x+2}}\nfn main(){print(result())}", "42\n"),
        ("consume_active_unit", "fn work(x:i32){assert(x==1)}\nfn main(){task scope j(1){k:=spawn j work(1);await! j(k)};print(42)}", "42\n"),
        ("arena_pool_stress", "struct WorkItem{values:[]i32,seed:i32}\nstruct WorkOut{items:[]i32,total:i64}\nfn work(item:WorkItem)->WorkOut{s:=item.seed.str();mut out:[]i32=[];mut total:i64=i64(s.len);for v in item.values{w:=v+item.seed;out.push(w);total=total+i64(w)};WorkOut{items:out,total:total}}\nfn main(){mut sum:i64=0;for wave in 0..2{task scope jobs(4){mut keys:[]TaskID<WorkOut> = [];mut read:=0;for j in 0..120{i:=wave*120+j;keys.push(spawn jobs work(WorkItem{values:[i,i+1,i+2],seed:i+10}));if keys.len-read>=4{ans:=await! jobs(keys[read]);read=read+1;sum=sum+ans.total+i64(ans.items[0]+ans.items[2])}};while read<keys.len{ans:=await! jobs(keys[read]);read=read+1;sum=sum+ans.total+i64(ans.items[0]+ans.items[2])}}};print(sum)}", "300630\n"),
        ("string_roundtrip", "fn greet(name:string)->string{\"hi \"+name+\"!\"}\nfn main(){mut s:=\"dunder\";task scope j(2){a:=spawn j greet(s);b:=spawn j greet(\"world\");s=\"mutated\";print(await! j(a));print(await! j(b))};print(s)}", "hi dunder!\nhi world!\nmutated\n"),
        ("string_move_and_array", "fn join_all(move parts:[]string)->[]string{mut out:=parts;out.push(\"end\");out}\nfn main(){mut parts:[]string=[\"a\",\"bc\"];task scope j(2){k:=spawn j join_all(parts.clone());parts[0]=\"z\";res:=await! j(k);print(res.len);print(res[0]+\"-\"+res[1]+\"-\"+res[2])};print(parts[0])}", "3\na-bc-end\nz\n"),
        ("struct_and_nested_arrays", "struct Item{label:string,nums:[]i32}\nfn transform(items:[]Item)->[]Item{mut out:[]Item=[];for it in &items{mut ns:=it.nums.clone();ns.push(it.label.len);out.push(Item{label:it.label+\"!\",nums:ns})};out}\nfn main(){mut items:[]Item=[Item{label:\"ok\",nums:[1]},Item{label:\"yes\",nums:[2,3]}];task scope j(2){k:=spawn j transform(items);items[0].label=\"changed\";res:=await! j(k);print(res[0].label);print(res[0].nums[1]);print(res[1].label);print(res[1].nums[2])};print(items[0].label)}", "ok!\n2\nyes!\n3\nchanged\n"),
        ("result_payload_enum", "fn parse_pos(n:i32)->Result<string,string>{if n>=0{return .Ok(\"ok:\"+n.str())};.Err(\"neg:\"+n.str())}\nfn main(){task scope j(2){a:=spawn j parse_pos(42);b:=spawn j parse_pos(-3);match await! j(a){.Ok(v)=>{print(v)},.Err(e)=>{print(e)}};match await! j(b){.Ok(v)=>{print(v)},.Err(e)=>{print(e)}}}}", "ok:42\nneg:-3\n"),
        ("copyable_payload_enum", "enum Reply{Num(i32),Empty}\nfn make(n:i32)->Reply{if n>0{return .Num(n*2)};.Empty}\nfn main(){task scope j(2){a:=spawn j make(21);b:=spawn j make(0);r1:=await j(a);r2:=await! j(a);match r1{.Num(v)=>{print(v)},.Empty=>{print(-1)}};match r2{.Num(v)=>{print(v)},.Empty=>{print(-1)}};match await! j(b){.Num(v)=>{print(v)},.Empty=>{print(0)}}}}", "42\n42\n0\n"),
        ("shared_string_and_enum_concurrent", "enum Tag{Ok(i32),Fail(string)}\nstruct World{prefix:string,labels:[]string,tag:Tag}\nfn work(i:i32,world:&World)->string{p:=world.prefix.clone();l:=world.labels[i%world.labels.len].clone();mut extra:=\"\";match world.tag{.Ok(n)=>{extra=n.str()},.Fail(e)=>{extra=e.clone()}};p+\":\"+l+\":\"+extra+\":\"+i.str()}\nfn main(){mut w:=World{prefix:\"pre\",labels:[\"alpha\",\"beta\",\"gamma\"],tag:.Ok(7)};task scope j(4,shared w){mut keys:[]TaskID<string> = [];for i in 0..24{keys.push(spawn j work(i))};w.prefix=\"gone\";w.labels.clear();mut hits:=0;for i in 0..24{out:=await! j(keys[i]);if i==0{print(out)};if i==23{print(out)};if out.len>0{hits=hits+1}};print(hits)};print(w.prefix)}", "pre:alpha:7:0\npre:gamma:7:23\n24\ngone\n"),
    ]
}

pub fn invalid() -> [](string, string, string) {
    [
        ("shared_mut_argument", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn bad(i:i32,w:&mut World)->i32{0}\nfn main(){task scope j(1,shared World{values:[1]}){id:=spawn j bad(0)}}", "read-only parameter for this shared input"),
        ("shared_mutation", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn bad(i:i32,w:&World)->i32{w.values[0]=9;0}\nfn main(){task scope j(1,shared World{values:[1]}){id:=spawn j bad(0)}}", "mutable"),
        ("shared_ptr", "struct World{p:ptr}\nfn run(p:ptr){w:=World{p:p};task scope j(1,shared w){}}\nfn main(){}", "shared task input requires isolated Data"),
        ("shared_opaque", "opaque struct World{a:i64}\nfn main(){task scope j(1,shared World{a:1}){}}", "shared task input requires isolated Data"),
        ("shared_value_argument", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn copy(i:i32,move w:World)->i32{0}\nfn main(){task scope j(1,shared World{values:[1]}){id:=spawn j copy(0)}}", "read-only parameter for this shared input"),
        ("effectful_initializer", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{print(1);Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){}}", "initializer has effects outside"),
        ("workspace_shape", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){id:=spawn j invalid(1)}}\nfn invalid(x:i32,s:&mut []i64)->i32{x}", "mutable parameter for this workspace"),
        ("missing_workspace_parameter", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){id:=spawn j invalid(1)}}\nfn invalid(x:i32)->i32{x}", "mutable parameter for this workspace"),
        ("workspace_resource", "struct State{address:ptr}\nfn factory()->State{factory()}\nfn main(){task scope j(2,factory){}}", "workspace contains a value outside isolated storage"),
        ("workspace_initializer_args", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,count){}}", "initializer without parameters"),
        ("workspace_initializer_scalar", "fn factory()->i32{42}\nfn main(){task scope j(1,factory){}}", "initializer must return an owned record"),
        ("input_ptr", "fn work(n:ptr)->i64{1}\nfn run(p:ptr){task scope j(1){id:=spawn j work(p)}}\nfn main(){}", "input must be isolated Data"),
        ("result_ptr", "fn work(n:i64)->ptr{work(n)}\nfn main(){task scope j(1){id:=spawn j work(1)}}", "result must be isolated Data"),
        ("payload_enum_ptr", "enum E{A(ptr)}\nfn work(n:E)->i64{1}\nfn run(p:ptr){e:=E.A(p);task scope j(1){id:=spawn j work(e)}}\nfn main(){}", "input must be isolated Data"),
        ("opaque", "opaque struct E{n:i64}\nfn work(n:E)->E{n}\nfn main(){task scope j(1){id:=spawn j work(E{n:1})}}", "input must be isolated Data"),
        ("borrow_input", "fn work(n:&mut i64)->i64{n}\nfn main(){mut n:i64=1;task scope j(1){id:=spawn j work(&mut n)}}", "task input cannot borrow mutable parent storage"),
        ("key_input", "fn leaf(n:i64)->i64{n}\nfn work(n:TaskID<i64>)->i64{1}\nfn main(){task scope j(1){a:=spawn j leaf(1);b:=spawn j work(a)}}", "input must be isolated Data"),
        ("print_dead", "fn work(n:i64)->i64{if false{print(n)};n}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "effects outside"),
        ("after_return_effect", "fn work(n:i64)->i64{return n;print(9);n}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "effects outside"),
        ("method_argument_effect", "fn bad(n:i64)->i64{print(n);n}\nfn work(n:i64)->i64{n.wrapping_add(bad(n))}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "effects outside"),
        ("short_circuit_effect", "fn bad(n:i64)->bool{print(n);true}\nfn work(n:i64)->i64{x:=false&&bad(n);n}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "effects outside"),
        ("print_transitive", "fn bad(n:i64)->i64{print(n);n}\nfn work(n:i64)->i64{bad(n)}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "call chain: work ("),
        ("ambient", "import std.sys as sys\nfn work(n:i64)->i64{i64(sys.pid())+n}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "<stdlib/sys.ddr>:"),
        ("unsafe_empty", "capability unsafe\nfn work(n:i64)->i64{unsafe{};n}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "effects outside"),
        ("unknown_indirect", "fn leaf(n:i64)->i64{n}\nfn work(n:i64)->i64{f:=leaf;f(n)}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "effects outside"),
        ("nested_spawn", "fn leaf(n:i64)->i64{n}\nfn work(n:i64)->i64{task scope nested(1){id:=spawn nested leaf(n);await nested(id)}}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "effects outside"),
        ("unsafe_worker", "capability unsafe\nunsafe fn work(n:i64)->i64{n}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "one safe by-value"),
        ("two_arguments", "fn work(a:i64,b:i64)->i64{a+b}\nfn main(){task scope jobs(2){id:=spawn jobs work(7);print(await jobs(id))}}\n", "one safe by-value"),
        ("scope_escape", "fn main(){task scope j(1){copy:=j}}", "scope capability"),
        ("scope_borrow", "fn use(n:&i64){}\nfn main(){task scope j(1){use(&j)}}", "scope capability"),
        ("missing_scope", "fn work(n:i64)->i64 { n*n }\nfn main(){id:=spawn missing work(1)}", "live task scope"),
        ("wrong_key", "fn main(){task scope j(1){x:=await j(7)}}", "typed TaskID"),
        ("wrong_key_type", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope j(1){id:TaskID<i32> = spawn j work(1)}}", "type mismatch"),
        ("key_arithmetic", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope j(1){id:=spawn j work(1);x:=id+id}}", "arithmetic requires"),
        ("capacity_type", "fn main(){task scope j(true){}}", "type mismatch"),
        ("named_worker_shadow", "fn work(n:i64)->i64 { n*n }\nfn main(){f:=work;task scope j(1){id:=spawn j f(1)}}", "named Dunder"),
    ]
}

pub fn traps() -> [](string, string, i32) {
    [
        ("read_consumed_alias", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope j(2){k:=spawn j work(7);alias:=k;print(await! j(k));print(await j(alias))}}", 112),
        ("consume_twice", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope j(1){k:=spawn j work(7);print(await! j(k));print(await! j(k))}}", 112),
        ("zero_limit", "fn main(){task scope j(0){}}", 112),
        ("negative_limit", "fn main(){task scope j(-1){}}", 112),
        ("wrong_scope", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope outer(1){id:=spawn outer work(1);task scope inner(1){value:=await inner(id)}}}", 112),
        ("expired_scope", "fn work(n:i64)->i64 { n*n }\nfn old()->TaskID<i64>{task scope j(1){return spawn j work(1)}}\nfn main(){id:=old();task scope j(1){value:=await j(id)}}", 112),
        ("scope_reentry", "fn work(n:i64)->i64 { n*n }\nfn main(){mut ids:[]TaskID<i64> = [];for i in 0..2{task scope j(1){id:=spawn j work(1);if i==1{value:=await j(ids[0])};ids.push(id)}}}", 112),
    ]
}
