pub fn valid() -> [](string, string, string) {
    [
        ("borrowed_input_snapshot", "fn work(n:&i64)->i64{n}\nfn main(){mut n:i64=41;task scope j(1){id:=j.spawn(work,n);n=0;print(id.join())};print(n)}", "41\n0\n"),
        ("await_any_borrowed_keys", "fn work(n:i32)->i32{n}\nfn main(){task scope j(1){mut ids:[]Task<i32> = [];print(j.wait_any(&mut ids));ids.push(j.spawn(work,42));print(j.wait_any(&ids));print(j.wait_any(&mut ids));print(ids.remove(0).join())}}", "-1\n0\n0\n42\n"),
        ("shared_snapshot", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn main(){mut w:=World{values:[40,42]};task scope j(2,shared w.clone()){a:=j.spawn(lookup,1);w.values[0]=9;w.values.clear();b:=j.spawn(lookup,0);print(b.join());print(a.join())}}", "40\n42\n"),
        ("owned_and_shared", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn main(){task scope j(1,initialize,shared World{values:[11]}){a:=j.spawn(update,0);b:=j.spawn(update,0);print(a.join());print(b.join())}}", "1\n2\n"),
        ("shared_clone", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn copy(world:&World)->[]i32{mut v:=world.values.clone();v[0]=100;v}\nfn job(i:i32,world:&World)->[]i32{copy(&world)}\nfn main(){mut w:=World{values:[41]};task scope j(1,shared w.clone()){a:=j.spawn(job,0);b:=j.spawn(lookup,0);print(a.join()[0]);print(b.join())};print(w.values[0])}", "100\n41\n41\n"),
        ("persistent_workspace", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){first:=j.spawn(collect,11);second:=j.spawn(collect,22);mut a:=first.join();a[0]=99;out:=second.join();print(out[0]);print(out[1]);n:=j.spawn(count,3);print(n.join())};task scope j(1,initialize){n:=j.spawn(count,0);print(n.join())}}", "11\n22\n12\n7\n"),
        ("isolated_workspaces", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(2,initialize){a:=j.spawn(collect,41);b:=j.spawn(collect,43);left:=a.join();right:=b.join();assert(left.len==1&&right.len==1);print(left[0]);print(right[0]);c:=j.spawn(count,0);d:=j.spawn(count,0);print(c.join());print(d.join())}}", "41\n43\n8\n8\n"),
        ("scalar_repeat", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope jobs(2){a:=jobs.spawn(work,7);b:=jobs.spawn(work,7);print(a.join());print(b.join())}}", "49\n49\n"),
        ("key_fifo", "fn work(n:i64)->i64 { n*n }\nfn main(){mut ids:[]Task<i64> = [];task scope jobs(1){for i in 0..20{ids.push(jobs.spawn(work,i64(i)))};mut sum:i64=0;for t in move ids{sum=sum+t.join()};print(sum)}}", "2470\n"),
        ("snapshot_copies", "fn work(move a:[]i64)->[]i64{mut b:=a;b[0]=b[0]+1;b}\nfn main(){mut a:[]i64=[41];task scope j(2){id:=j.spawn(work,a.clone());a[0]=0;mut first:=id.join();snapshot:=first.clone();first[0]=99;print(snapshot[0]);print(first[0]);print(a[0])}}", "42\n99\n0\n"),
        ("records", "struct Job{a:[]i64,n:i64}\nstruct Answer{a:[]i64,n:i64}\nfn work(x:Job)->Answer{mut a:=x.a.clone();a[0]=a[0]+x.n;Answer{a:a,n:x.n}}\nfn main(){mut a:[]i64=[40];mut x:=Job{a:a,n:2};task scope j(1){id:=j.spawn(work,x);x.a[0]=0;mut y:=id.join();snapshot:=y.clone();y.a[0]=99;print(snapshot.a[0]);print(y.a[0])}}", "42\n99\n"),
        ("nested_return", "fn work(n:i64)->[]i64{[n,n+1]}\nfn result()->[]i64{task scope outer(2){a:=outer.spawn(work,40);task scope inner(1){b:=inner.spawn(work,42);ignored:=a.join();return b.join()}}}\nfn main(){mut a:=result();a[0]=a[0]+1;print(a[0]);print(a[1])}", "43\n43\n"),
        ("tail_return", "fn work(n:i64)->[]i64{[n]}\nfn result()->[]i64{task scope jobs(1){id:=jobs.spawn(work,42);id.join()}}\nfn main(){print(result()[0])}", "42\n"),
        ("break_continue", "fn work(n:i64)->i64 { n*n }\nfn main(){mut sum:i64=0;for i in 0..6{task scope j(2){id:=j.spawn(work,i64(i));if i==1{continue};if i==4{break};sum=sum+id.join()}};print(sum)}", "13\n"),
        ("discard_owned", "fn work(n:i64)->[]i64{[n]}\nfn main(){for i in 0..10{task scope j(2){a:=j.spawn(work,i64(i));b:=j.spawn(work,i64(i+1))}};print(42)}", "42\n"),
        ("local_borrow", "fn add(n:&mut i64){n=n+1}\nfn work(n:i64)->i64{mut x:=n;add(&mut x);x}\nfn main(){task scope j(1){id:=j.spawn(work,41);print(id.join())}}", "42\n"),
        ("local_string", "fn work(n:i64)->i64{s:=n.str();assert(s.len>0);n+1}\nfn main(){task scope j(1){id:=j.spawn(work,41);print(id.join())}}", "42\n"),
        ("local_runes_bytes", "fn work(n:i64)->i64{s:=n.str();a:=s.runes();b:=s.bytes();i64(a.len+b.len)}\nfn main(){task scope j(1){id:=j.spawn(work,42);print(id.join())}}", "4\n"),
        ("local_formatter", "fn work(n:f64)->i64{s:=n.str();assert(s.len>0);42}\nfn main(){task scope j(1){id:=j.spawn(work,3.5);print(id.join())}}", "42\n"),
        ("bool", "fn work(n:bool)->bool{!n}\nfn main(){task scope j(1){id:=j.spawn(work,false);assert(id.join());print(42)}}", "42\n"),
        ("unit", "fn work(n:i64){assert(n==42)}\nfn main(){task scope j(1){id:=j.spawn(work,42);id.join();j.spawn(work,42)};print(42)}", "42\n"),
        ("tag_enum", "enum Tag{A,B}\nfn work(n:Tag)->Tag{n}\nfn main(){task scope j(1){id:=j.spawn(work,Tag.B);assert(id.join()==Tag.B);print(42)}}", "42\n"),
        ("bool_array", "fn work(move a:[]bool)->[]bool{mut b:=a;b[0]=!b[0];b}\nfn main(){mut a:[]bool=[false];task scope j(1){id:=j.spawn(work,a.clone());a[0]=true;mut first:=id.join();snapshot:=first.clone();first[0]=false;assert(snapshot[0]);print(42)}}", "42\n"),
        ("fixed_array", "fn work(move a:[u8;4])->[u8;4]{mut b:=a;b[0]=u8(42);b}\nfn main(){mut a:[u8;4]=[u8(1);4];task scope j(1){id:=j.spawn(work,a.clone());a[0]=u8(0);print(i32(id.join()[0]));print(i32(a[0]))}}", "42\n0\n"),
        ("c_record", "@repr(C) struct Pair{a:i32,b:i64}\nfn work(p:Pair)->Pair{Pair{a:p.a+1,b:p.b+2}}\nfn main(){mut p:=Pair{a:40,b:40};task scope j(1){id:=j.spawn(work,p);p.a=0;answer:=id.join();print(answer.a);print(answer.b)}}", "41\n42\n"),
        ("float_results", "fn work(n:f64)->f64{n+0.5}\nfn main(){task scope j(2){a:=j.spawn(work,2.0);b:=j.spawn(work,6.5);assert(a.join()==2.5);assert(b.join()==7.0);print(42)}}", "42\n"),
        ("empty_scope", "fn main(){task scope jobs(1){mut x:=0;x=x+1;print(x)}}", "1\n"),
        ("scope_shadowing", "fn work(n:i64)->i64{n}\nfn main(){mut jobs:i32=2;task scope jobs(jobs){id:=jobs.spawn(work,42);{mut jobs:=7;print(jobs)};print(id.join())};print(jobs)}", "7\n42\n2\n"),
        ("multiple_independent_joins", "fn work(n:i64)->i64{n}\nfn result()->i64{task scope j(1){a:=j.spawn(work,40);b:=j.spawn(work,42);c:=a.join();assert(c==40);return b.join()}}\nfn main(){print(result())}", "42\n"),
        ("consume_active_unit", "fn work(x:i32){assert(x==1)}\nfn main(){task scope j(1){k:=j.spawn(work,1);k.join()};print(42)}", "42\n"),
        ("arena_pool_stress", "struct WorkItem{values:[]i32,seed:i32}\nstruct WorkOut{items:[]i32,total:i64}\nfn work(item:WorkItem)->WorkOut{s:=item.seed.str();mut out:[]i32=[];mut total:i64=i64(s.len);for v in item.values{w:=v+item.seed;out.push(w);total=total+i64(w)};WorkOut{items:out,total:total}}\nfn main(){mut sum:i64=0;for wave in 0..2{task scope jobs(4){mut keys:[]Task<WorkOut> = [];mut spawned:=0;for j in 0..120{i:=wave*120+j;keys.push(jobs.spawn(work,WorkItem{values:[i,i+1,i+2],seed:i+10}));spawned=spawned+1;if keys.len>=4{ans:=keys.remove(0).join();sum=sum+ans.total+i64(ans.items[0]+ans.items[2])}};while keys.len>0{ans:=keys.remove(0).join();sum=sum+ans.total+i64(ans.items[0]+ans.items[2])};assert(spawned==120)}};print(sum)}", "300630\n"),
        ("string_roundtrip", "fn greet(name:string)->string{\"hi \"+name+\"!\"}\nfn main(){mut s:=\"dunder\";task scope j(2){a:=j.spawn(greet,s);b:=j.spawn(greet,\"world\");s=\"mutated\";print(a.join());print(b.join())};print(s)}", "hi dunder!\nhi world!\nmutated\n"),
        ("string_move_and_array", "fn join_all(move parts:[]string)->[]string{mut out:=parts;out.push(\"end\");out}\nfn main(){mut parts:[]string=[\"a\",\"bc\"];task scope j(2){k:=j.spawn(join_all,parts.clone());parts[0]=\"z\";res:=k.join();print(res.len);print(res[0]+\"-\"+res[1]+\"-\"+res[2])};print(parts[0])}", "3\na-bc-end\nz\n"),
        ("struct_and_nested_arrays", "struct Item{label:string,nums:[]i32}\nfn transform(items:[]Item)->[]Item{mut out:[]Item=[];for it in &items{mut ns:=it.nums.clone();ns.push(it.label.len);out.push(Item{label:it.label+\"!\",nums:ns})};out}\nfn main(){mut items:[]Item=[Item{label:\"ok\",nums:[1]},Item{label:\"yes\",nums:[2,3]}];task scope j(2){k:=j.spawn(transform,items);items[0].label=\"changed\";res:=k.join();print(res[0].label);print(res[0].nums[1]);print(res[1].label);print(res[1].nums[2])};print(items[0].label)}", "ok!\n2\nyes!\n3\nchanged\n"),
        ("result_payload_enum", "fn parse_pos(n:i32)->Result<string,string>{if n>=0{return .Ok(\"ok:\"+n.str())};.Err(\"neg:\"+n.str())}\nfn main(){task scope j(2){a:=j.spawn(parse_pos,42);b:=j.spawn(parse_pos,-3);match a.join(){.Ok(v)=>{print(v)},.Err(e)=>{print(e)}};match b.join(){.Ok(v)=>{print(v)},.Err(e)=>{print(e)}}}}", "ok:42\nneg:-3\n"),
        ("copyable_payload_enum", "enum Reply{Num(i32),Empty}\nfn make(n:i32)->Reply{if n>0{return .Num(n*2)};.Empty}\nfn main(){task scope j(2){a:=j.spawn(make,21);b:=j.spawn(make,21);c:=j.spawn(make,0);r1:=a.join();r2:=b.join();match r1{.Num(v)=>{print(v)},.Empty=>{print(-1)}};match r2{.Num(v)=>{print(v)},.Empty=>{print(-1)}};match c.join(){.Num(v)=>{print(v)},.Empty=>{print(0)}}}}", "42\n42\n0\n"),
        ("shared_string_and_enum_concurrent", "enum Tag{Ok(i32),Fail(string)}\nstruct World{prefix:string,labels:[]string,tag:Tag}\nfn work(i:i32,world:&World)->string{p:=world.prefix.clone();l:=world.labels[i%world.labels.len].clone();mut extra:=\"\";match world.tag{.Ok(n)=>{extra=n.str()},.Fail(e)=>{extra=e.clone()}};p+\":\"+l+\":\"+extra+\":\"+i.str()}\nfn main(){mut w:=World{prefix:\"pre\",labels:[\"alpha\",\"beta\",\"gamma\"],tag:.Ok(7)};task scope j(4,shared w){mut keys:[]Task<string> = [];for i in 0..24{keys.push(j.spawn(work,i))};w.prefix=\"gone\";w.labels.clear();mut hits:=0;mut idx:=0;for k in move keys{out:=k.join();if idx==0{print(out)};if idx==23{print(out)};if out.len>0{hits=hits+1};idx=idx+1};print(hits)};print(w.prefix)}", "pre:alpha:7:0\npre:gamma:7:23\n24\ngone\n"),
        ("task_handle_basic", "fn sum(xs:[]i32)->i32{mut s:=0;for x in &xs{s=s+x};s}\nfn main(){task scope jobs{first:=jobs.spawn(sum,[1,2,3]);second:=jobs.spawn(sum,[10,20]);print(first.join());print(second.join())}}", "6\n30\n"),
        ("task_handle_clauses_and_shared", "struct Cfg{bias:i64}\nfn add_bias(v:i64,cfg:&Cfg)->i64{print(v+cfg.bias);v+cfg.bias}\nfn main(){task scope jobs(shared Cfg{bias:5}) with (stdio) arena 2097152{t:=jobs.spawn(add_bias,37);print(t.join()+0)}}", "42\n42\n"),
        ("task_handle_collections_and_wait_any", "fn work(n:i64)->i64{n*n}\nfn finish<T>(move t:Task<T>)->T{t.join()}\nfn main(){task scope jobs{mut pending:[]Task<i64> = [];assert(jobs.wait_any(pending)==-1);pending.push(jobs.spawn(work,3));pending.push(jobs.spawn(work,4));pending.push(jobs.spawn(work,5));mut sum:i64=0;while pending.len>0{idx:=jobs.wait_any(&pending);sum=sum+pending.remove(idx).join()};print(sum);mut rest:[]Task<i64> = [jobs.spawn(work,6),jobs.spawn(work,7)];assert(jobs.wait_any(rest)>=0);mut s2:i64=0;for t in move rest{s2=s2+t.join()};print(s2);g:=jobs.spawn(work,8);print(finish(move g))}}", "50\n85\n64\n"),
        ("task_handle_option_nested_and_field", "struct Holder{t:Task<i64>}\nfn work(n:i64)->i64{n+1}\nfn void_w(n:i64){assert(n>0)}\nfn opt_res(b:bool)->i64{task scope j{mut ot:Option<Task<i64>> = if b{.Some(j.spawn(work,40))}else{.None};match ot{.Some(h) if b=>h.join(),.Some(h)=>{_:=h.join();0},.None=>-1}}}\nfn main(){task scope outer{o1:=outer.spawn(work,10);o2:=outer.spawn(work,20);task scope inner{print(o1.join());h:=Holder{t:outer.spawn(work,30)};print(h.t.join())};print(o2.join());u:=outer.spawn(void_w,1);u.join();outer.spawn(void_w,2);_:=outer.spawn(work,41).join()};print(opt_res(true));print(opt_res(false))}", "11\n31\n21\n41\n-1\n"),
        ("task_handle_workspace_and_shared", "struct Workspace{values:[]i32}\nstruct World{base:i32}\nfn initialize()->Workspace{Workspace{values:[]}}\nfn step(x:i32,ws:&mut Workspace,w:&World)->i32{ws.values.push(x+w.base);ws.values.len}\nfn main(){task scope jobs(1,initialize,shared World{base:10}){a:=jobs.spawn(step,1);b:=jobs.spawn(step,2);print(a.join());print(b.join())}}", "1\n2\n"),
        ("task_handle_generic_parenthesized", "fn work(n:i64)->i64{n*2}\nfn pass<T>(move x:T)->T{x}\nfn main(){task scope jobs{print((jobs.spawn(work,21)).join());print(pass<Task<i64>>(jobs.spawn(work,10)).join())}}", "42\n20\n"),
    ]
}

pub fn invalid() -> [](string, string, string) {
    [
        ("shared_mut_argument", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn bad(i:i32,w:&mut World)->i32{0}\nfn main(){task scope j(1,shared World{values:[1]}){id:=j.spawn(bad,0)}}", "read-only parameter for this shared input"),
        ("shared_mutation", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn bad(i:i32,w:&World)->i32{w.values[0]=9;0}\nfn main(){task scope j(1,shared World{values:[1]}){id:=j.spawn(bad,0)}}", "mutable"),
        ("shared_ptr", "struct World{p:ptr}\nfn run(p:ptr){w:=World{p:p};task scope j(1,shared w){}}\nfn main(){}", "shared task input requires isolated Data"),
        ("shared_opaque", "opaque struct World{a:i64}\nfn main(){task scope j(1,shared World{a:1}){}}", "shared task input requires isolated Data"),
        ("shared_value_argument", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nstruct World{values:[]i32}\nfn lookup(i:i32, world:&World)->i32{world.values[i]}\nfn update(i:i32, ws:&mut Workspace, world:&World)->i32{ws.values.push(world.values[i]);ws.values.len}\nfn copy(i:i32,move w:World)->i32{0}\nfn main(){task scope j(1,shared World{values:[1]}){id:=j.spawn(copy,0)}}", "read-only parameter for this shared input"),
        ("effectful_initializer", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{print(1);Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){}}", "initializer has effects outside"),
        ("workspace_shape", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){id:=j.spawn(invalid,1)}}\nfn invalid(x:i32,s:&mut []i64)->i32{x}", "mutable parameter for this workspace"),
        ("missing_workspace_parameter", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,initialize){id:=j.spawn(invalid,1)}}\nfn invalid(x:i32)->i32{x}", "mutable parameter for this workspace"),
        ("workspace_resource", "struct State{address:ptr}\nfn factory()->State{factory()}\nfn main(){task scope j(2,factory){}}", "workspace contains a value outside isolated storage"),
        ("workspace_initializer_args", "struct Workspace{values:[]i32,label:string}\nfn initialize()->Workspace{Workspace{values:[],label:\"workers\"}}\nfn collect(x:i32, ws:&mut Workspace)->[]i32{ws.values.push(x);ws.values.clone()}\nfn count(x:i32, ws:&mut Workspace)->i32{ws.values.len+x+ws.label.len}\nfn main(){task scope j(1,count){}}", "initializer without parameters"),
        ("workspace_initializer_scalar", "fn factory()->i32{42}\nfn main(){task scope j(1,factory){}}", "initializer must return an owned record"),
        ("input_ptr", "fn work(n:ptr)->i64{1}\nfn run(p:ptr){task scope j(1){id:=j.spawn(work,p)}}\nfn main(){}", "input must be isolated Data"),
        ("result_ptr", "fn work(n:i64)->ptr{work(n)}\nfn main(){task scope j(1){id:=j.spawn(work,1)}}", "result must be isolated Data"),
        ("payload_enum_ptr", "enum E{A(ptr)}\nfn work(n:E)->i64{1}\nfn run(p:ptr){e:=E.A(p);task scope j(1){id:=j.spawn(work,e)}}\nfn main(){}", "input must be isolated Data"),
        ("opaque", "opaque struct E{n:i64}\nfn work(n:E)->E{n}\nfn main(){task scope j(1){id:=j.spawn(work,E{n:1})}}", "input must be isolated Data"),
        ("borrow_input", "fn work(n:&mut i64)->i64{n}\nfn main(){mut n:i64=1;task scope j(1){id:=j.spawn(work,&mut n)}}", "task input cannot borrow mutable parent storage"),
        ("print_dead", "fn work(n:i64)->i64{if false{print(n)};n}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("after_return_effect", "fn work(n:i64)->i64{return n;print(9);n}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("after_return_transitive_effect", "fn emit(){print(9)}\nfn work(n:i64)->i64{return n;emit();n}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("method_argument_effect", "fn bad(n:i64)->i64{print(n);n}\nfn work(n:i64)->i64{n.wrapping_add(bad(n))}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("short_circuit_effect", "fn bad(n:i64)->bool{print(n);true}\nfn work(n:i64)->i64{x:=false&&bad(n);n}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("print_transitive", "fn bad(n:i64)->i64{print(n);n}\nfn work(n:i64)->i64{bad(n)}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "call chain: work ("),
        ("ambient", "import std.sys as sys\nfn work(n:i64)->i64{i64(sys.pid())+n}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "<stdlib/sys.ddr>:"),
        ("unsafe_empty", "capability unsafe\nfn work(n:i64)->i64{unsafe{};n}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("unknown_indirect", "fn leaf(n:i64)->i64{n}\nfn work(n:i64)->i64{f:=leaf;f(n)}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("nested_spawn", "fn leaf(n:i64)->i64{n}\nfn work(n:i64)->i64{task scope nested(1){id:=nested.spawn(leaf,n);id.join()}}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "effects outside"),
        ("unsafe_worker", "capability unsafe\nunsafe fn work(n:i64)->i64{n}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "one safe by-value"),
        ("two_arguments", "fn work(a:i64,b:i64)->i64{a+b}\nfn main(){task scope jobs(2){id:=jobs.spawn(work,7);print(id.join())}}\n", "one safe by-value"),
        ("scope_escape", "fn main(){task scope j(1){copy:=j}}", "scope capability"),
        ("quoted_scope_name", "fn main(){task scope \"jobs\"(1){print(1)}}", "expected task scope name"),
        ("reserved_scope_name", "fn main(){task scope return(1){print(1)}}", "expected task scope name"),
        ("scope_borrow", "fn use(n:&i64){}\nfn main(){task scope j(1){use(&j)}}", "scope capability"),
        ("missing_scope", "fn work(n:i64)->i64 { n*n }\nfn main(){_:=missing.spawn(work,1)}", "unknown local"),
        ("wait_any_non_task", "fn main(){task scope j{xs:[]i64=[1];_:=j.wait_any(&xs)}}", "wait_any requires"),
        ("wrong_handle_type", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope j(1){id:Task<i32> = j.spawn(work,1)}}", "type mismatch"),
        ("handle_arithmetic", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope j(1){id:=j.spawn(work,1);x:=id+id}}", "arithmetic requires"),
        ("capacity_type", "fn main(){task scope j(true){}}", "type mismatch"),
        ("named_worker_shadow", "fn work(n:i64)->i64 { n*n }\nfn main(){f:=work;task scope j(1){id:=j.spawn(f,1)}}", "named Dunder"),
        ("task_double_join", "fn work(n:i64)->i64{n}\nfn main(){task scope j{a:=j.spawn(work,1);_:=a.join();_:=a.join()}}", "use of moved value 'a'"),
        ("task_move_then_join", "fn work(n:i64)->i64{n}\nfn main(){task scope j{a:=j.spawn(work,1);b:=a;_:=a.join()}}", "use of moved value 'a'"),
        ("task_push_without_move", "fn work(n:i64)->i64{n}\nfn main(){task scope j{a:=j.spawn(work,1);mut ts:[]Task<i64> = [];ts.push(a)}}", "push requires 'move value'"),
        ("task_clone_rejected", "fn work(n:i64)->i64{n}\nfn main(){task scope j{a:=j.spawn(work,1);_:=a.clone()}}", "Task handles cannot be cloned"),
        ("task_borrowed_ref_join", "fn work(n:i64)->i64{n}\nfn main(){task scope j{a:=j.spawn(work,1);r:=&a;_:=r.join()}}", "cannot move out of a borrowed value"),
        ("task_borrowed_param_join", "fn take(r:&Task<i64>)->i64{r.join()}\nfn main(){}", "cannot move out of a borrowed value"),
        ("task_borrowed_for_ref_join", "fn work(n:i64)->i64{n}\nfn main(){task scope j{mut ts:[]Task<i64> = [j.spawn(work,1)];for t in &ts{_:=t.join()}}}", "cannot move out of a borrowed value"),
        ("task_borrowed_for_join", "fn work(n:i64)->i64{n}\nfn main(){task scope j{mut ts:[]Task<i64> = [j.spawn(work,1)];for t in ts{_:=t.join()}}}", "cannot move out of a borrowed value"),
        ("task_indexed_join", "fn work(n:i64)->i64{n}\nfn main(){task scope j{mut ts:[]Task<i64> = [j.spawn(work,1)];_:=ts[0].join()}}", "cannot move out of an indexed element"),
        ("task_input_to_worker", "fn bad(t:Task<i64>)->i64{1}\nfn work(n:i64)->i64{n}\nfn main(){task scope j{a:=j.spawn(work,1);_:=j.spawn(bad,move a)}}", "input must be isolated Data"),
        ("task_join_inside_worker", "fn work(n:i64)->i64{task scope inner{a:=inner.spawn(leaf,n);a.join()}}\nfn leaf(n:i64)->i64{n}\nfn main(){task scope j{_:=j.spawn(work,1)}}", "effects outside"),
        ("task_unknown_scope_method", "fn main(){task scope j{_:=j.foo()}}", "unknown task scope method"),
        ("task_unknown_handle_method", "fn work(n:i64)->i64{n}\nfn main(){task scope j{a:=j.spawn(work,1);_:=a.foo()}}", "unknown method 'foo' on Task"),
        ("legacy_spawn_rejected", "fn work(n:i64)->i64{n}\nfn main(){task scope j{_:=spawn j work(1)}}", "unknown local 'spawn'"),
        ("legacy_await_rejected", "fn work(n:i64)->i64{n}\nfn main(){task scope j{t:=j.spawn(work,1);_:=await j(t)}}", "unknown local 'await'"),
        ("legacy_await_any_rejected", "fn main(){task scope j{mut ts:[]Task<i64> = [];_:=await_any j(&ts)}}", "unknown local 'await_any'"),
        ("legacy_taskid_rejected", "fn main(){mut ts:[]TaskID<i64> = []}", "unknown generic type 'TaskID'"),
    ]
}

pub fn traps() -> [](string, string, i32) {
    [
        ("zero_limit", "fn main(){task scope j(0){}}", 112),
        ("negative_limit", "fn main(){task scope j(-1){}}", 112),
        ("expired_task_handle_join", "fn work(n:i64)->i64 { n*n }\nfn old()->Task<i64>{task scope j{return j.spawn(work,7)}}\nfn main(){t:=old();print(t.join())}", 112),
        ("scope_reentry", "fn work(n:i64)->i64 { n*n }\nfn main(){mut ts:[]Task<i64> = [];for i in 0..2{task scope j(1){t:=j.spawn(work,1);if i==1{_:=ts.remove(0).join()};ts.push(move t)}}}", 112),
        ("wrong_scope_wait_any", "fn work(n:i64)->i64 { n*n }\nfn main(){task scope outer(1){mut ts:[]Task<i64> = [outer.spawn(work,1)];task scope inner(1){_:=inner.wait_any(&ts)}}}", 112),
    ]
}
