capability filesystem

import .harness as harness
import .mir_oracle as oracle
import std.json as json
import std.parse as parse
import std.text as text
import sys

pub enum Suite { Ssa, Regions, Expression }

pub struct Export {
    ok: bool,
    before: oracle.Model,
    after: oracle.Model,
    before_text: string,
    after_text: string,
    counters: Map<string, i64>,
    changed: bool,
    helpers: []i64,
}

impl Export {
    pub fn count(&self, key: string) -> i64 { self.counters.at(key) }

    pub fn write_counters(&self, writer: &mut json.Writer) {
        writer.object()
        writer.key("changed")
        writer.boolean(self.changed)
        for i in 0..self.counters.len() {
            writer.key(self.counters.key_at(i))
            writer.integer(self.counters.value_at(i))
        }
        writer.end()
    }
}

pub struct Traffic {
    ok: bool,
    loads: i64,
    stores: i64,
    pushes: i64,
    pops: i64,
}

impl Traffic {
    pub fn write(&self, writer: &mut json.Writer) {
        writer.object()
        writer.key("loads")
        writer.integer(self.loads)
        writer.key("stores")
        writer.integer(self.stores)
        writer.key("pushes")
        writer.integer(self.pushes)
        writer.key("pops")
        writer.integer(self.pops)
        writer.end()
    }
}

fn between(raw: string, start: string, end: string) -> string {
    left := text.find(raw, start)
    if left < 0 { return "" }
    tail := raw[(left + start.len)..raw.len]
    right := text.find(tail, end)
    if right < 0 { return "" }
    tail[0..right]
}

fn after(raw: string, marker: string) -> string {
    at := text.find(raw, marker)
    if at < 0 { return "" }
    raw[(at + marker.len)..raw.len]
}

fn phase(raw: string) -> oracle.Model {
    at := text.find(raw, "META1\n")
    if at < 0 || text.trim(after(raw, "ENDMETA\n")).len != 0 || between(raw, "META1\n", "ENDMETA\n").len == 0 {
        return oracle.decode("")
    }
    oracle.decode(raw[0..at])
}

pub fn decode(raw: string, suite: Suite) -> Export {
    mut result := Export { ok: false, before: oracle.decode(""), after: oracle.decode(""), before_text: "",
                           after_text: "", changed: false, counters: Map<string, i64>::new(), helpers: [] }
    prefix := if suite == .Expression { "STACKCOUNTERS\n" } else { "COUNTERS\n" }
    counters_text := after(raw, prefix)
    result.before_text = between(raw, "ORIGINAL\n", "RESULT\n")
    result.after_text = between(raw, "RESULT\n", prefix)
    result.before = phase(result.before_text)
    result.after = phase(result.after_text)
    if !result.before.ok || !result.after.ok { return result }
    counter_names: []string = if suite == .Expression {
        ["status", "units", "placed", "pushes", "pops", "copies", "loads", "stores", "captures", "words"]
    } else {
        ["status", "units", "cells", "removed_loads", "removed_stores", "copies", "parameters",
         "values", "registers", "removed_pushes", "removed_pops", "words"]
    }
    rows := harness.lines(counters_text)
    extra := if suite == .Regions { 3 } else { 1 }
    if rows.len != counter_names.len + extra || (rows[0] != "true" && rows[0] != "false") { return result }
    result.changed = rows[0] == "true"
    for i in 0..counter_names.len {
        n := parse.integer(rows[i + 1])
        if !n.ok { return result }
        result.counters.put(counter_names[i].clone(), n.value)
    }
    if suite != .Expression {
        metadata := harness.lines(between(result.before_text, "META1\n", "ENDMETA\n"))
        if metadata.len < 10 { return result }
        first := parse.integer(metadata[5])
        source := parse.integer(metadata[9])
        if !first.ok || !source.ok { return result }
        result.counters.put("before_words", source.value - first.value)
    }
    if suite == .Regions {
        if rows[rows.len - 2] != "CAPTURES" { return result }
        captures := parse.integer(rows[rows.len - 1])
        if !captures.ok { return result }
        result.counters.put("captures", captures.value)
    }
    if suite != .Ssa {
        helpers := harness.lines(between(raw, "HELPERS\n", "ENDHELPERS\n"))
        if helpers.len != 3 { return result }
        for helper in helpers {
            value := parse.integer(helper)
            if !value.ok { return result }
            result.helpers.push(value.value)
        }
    }
    result.ok = true
    result
}

pub fn traffic(model: &oracle.Model) -> Traffic {
    mut counts := Traffic { ok: false, loads: 0, stores: 0, pushes: 0, pops: 0 }
    for op in model.operations {
        if op.mode == 2 { continue }
        for reg in [op.dst, op.a, op.b, op.c] {
            if reg < -1 || reg > 63 { return counts }
        }
        if op.kind == 7 { counts.loads += 1 }
        else if op.kind == 8 { counts.stores += 1 }
        else if op.kind == 10 { counts.pushes += 1 }
        else if op.kind == 11 { counts.pops += 1 }
    }
    counts.ok = true
    counts
}

pub fn equal_ops(a: &oracle.Operation, b: &oracle.Operation) -> bool {
    a.kind == b.kind && a.opcode == b.opcode && a.dst == b.dst && a.a == b.a && a.b == b.b && a.c == b.c &&
        a.imm == b.imm && a.aux == b.aux && a.type == b.type && a.place == b.place && a.extension == b.extension &&
        a.effects == b.effects && a.flags == b.flags && a.abi == b.abi && a.reads == b.reads &&
        a.writes == b.writes && a.clobbers == b.clobbers && a.mode == b.mode && a.target == b.target
}

fn identifier_byte(c: i32) -> bool { (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 }

fn schema_names(declaration: string) -> Map<string, bool> {
    mut names := Map<string, bool>::new()
    for line in move harness.lines(declaration) {
        comment := text.find(line, "//")
        finish := if comment < 0 { line.len } else { comment }
        for i in 0..finish {
            if line[i] != 58 { continue }
            mut end := i
            while end > 0 && (line[end - 1] == 32 || line[end - 1] == 9) { end -= 1 }
            mut start := end
            while start > 0 && identifier_byte(line[start - 1]) { start -= 1 }
            if start < end { names.put(line[start..end], true) }
        }
    }
    names
}

fn witnessed_names(body: string) -> Map<string, bool> {
    mut names := Map<string, bool>::new()
    for i in 0..(body.len - 2) {
        if body[i] != 102 || body[i + 1] != 46 || (i > 0 && identifier_byte(body[i - 1])) { continue }
        start := i + 2
        mut end := start
        while end < body.len && identifier_byte(body[end]) { end += 1 }
        if start < end { names.put(body[start..end], true) }
    }
    names
}

pub fn schema_field_count(path: string, witness: string, standalone: bool) -> i32 {
    source := sys.read_text(path)
    support := sys.read_text(witness)
    if !source.ok || !support.ok { _ := harness.fail("cannot read MIR Function or rollback witness"); return -1 }
    names := schema_names(between(source.value, "pub struct Function {", "\n}"))
    body := if standalone { between(support.value, "fn metadata(", "\nfn main()") } else { after(support.value, "pub fn metadata(") }
    observed := witnessed_names(body)
    mut ok := names.len() > 0
    for i in 0..names.len() {
        field := names.key_at(i)
        if !observed.contains(field) { _ := harness.fail(f"rollback witness does not observe Function.{field}"); ok = false }
    }
    for i in 0..observed.len() {
        field := observed.key_at(i)
        if !names.contains(field) { _ := harness.fail(f"rollback witness observes unknown Function.{field}"); ok = false }
    }
    if ok { names.len() } else { -1 }
}
