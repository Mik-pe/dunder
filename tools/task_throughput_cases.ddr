import .mir_contracts as contracts
import std.bytes as bytes
import std.json as json

pub fn capacities() -> []i32 { [1, 2, 4] }

pub fn capacity_order(round: i32) -> []i32 {
    order := round % 6
    if order == 0 { return [1, 2, 4] }
    if order == 1 { return [1, 4, 2] }
    if order == 2 { return [2, 1, 4] }
    if order == 3 { return [2, 4, 1] }
    if order == 4 { return [4, 1, 2] }
    [4, 2, 1]
}

pub struct Work { count: i32, length: i32 }

pub fn small_cases(cpu: bool) -> []Work {
    if cpu { return [Work { count: 0, length: 0 }, Work { count: 16, length: 0 }] }
    [Work { count: 0, length: 9 }, Work { count: 2, length: 0 },
     Work { count: 2, length: 1 }, Work { count: 2, length: 9 }]
}

fn reduce(value: i64) -> i64 {
    modulus: i64 = 2147483647
    folded := value.bit_and(modulus) + value.shr(31)
    if folded >= modulus { return folded - modulus }
    folded
}

fn number(output: &mut []u8, value: i64) {
    bytes.append_decimal(&mut output, value)
    output.push(b'\n')
}

fn cpu_results(output: &mut []u8, count: i32) {
    for job in 0..32 {
        mut state := i64(job) * 7919 + 1729
        mut sum: i64 = 0
        for _ in 0..count {
            state = reduce(state * 1664525 + 1013904223)
            sum += state
        }
        number(&mut output, sum)
        number(&mut output, state)
    }
}

fn array_ends(output: &mut []u8, length: i32, coefficient: i64, constant: i64) {
    mut sum: i64 = 0
    mut first: i64 = 0
    mut last: i64 = 0
    for i in 0..length {
        initial := (i64(i) * 17 + 1729) % 1009
        last = reduce(coefficient * initial + constant)
        if i == 0 { first = last }
        sum += last * i64(i + 1)
    }
    number(&mut output, sum)
    number(&mut output, first)
    number(&mut output, last)
}

fn array_results(output: &mut []u8, count: i32, length: i32) {
    mut coefficient: i64 = 1
    for _ in 0..count { coefficient = reduce(coefficient * 48271) }
    for job in 0..32 {
        mut constant: i64 = 0
        for cycle in 0..count { constant = reduce(constant * 48271 + i64(job) + i64(cycle)) }
        array_ends(&mut output, length, coefficient, constant)
    }
    array_ends(&mut output, length, 1, 0)
}

pub fn expected(cpu: bool, work: &Work) -> string {
    mut output: []u8 = []
    if cpu { cpu_results(&mut output, work.count) }
    else { array_results(&mut output, work.count, work.length) }
    bytes.decode(&output).unwrap_or_default()
}

pub fn serial_source(cohort: string, work: string, name: string, cpu: bool) -> string {
    module := contracts.relative(work, cohort + "/" + name + "_worker")
    header := "import " + json.quote(module) + " as kernel\nimport std.sys as sys\nimport std.parse as parse\n"
    if cpu {
        return header +
            "fn main() {\n" +
            "    count := i32(parse.integer(sys.arg(1)).value)\n" +
            "    for job in 0..32 {\n" +
            "        result := kernel.run(kernel.Request { seed: 1729 + i64(job) * 7919, steps: count })\n" +
            "        print(result.checksum)\n" +
            "        print(result.last)\n" +
            "    }\n" +
            "}\n"
    }
    header +
        "fn main() {\n" +
        "    count := i32(parse.integer(sys.arg(1)).value)\n" +
        "    length := i32(parse.integer(sys.arg(2)).value)\n" +
        "    mut values: []i64 = []\n" +
        "    for i in 0..length {\n" +
        "        values.push((i64(i) * 17 + 1729) % 1009)\n" +
        "    }\n" +
        "    for job in 0..32 {\n" +
        "        result := kernel.run(kernel.Request { values: values.clone(), passes: count, job: i64(job) })\n" +
        "        print(result.checksum)\n" +
        "        print(result.first)\n" +
        "        print(result.last)\n" +
        "    }\n" +
        "    mut checksum: i64 = 0\n" +
        "    for i in 0..values.len {\n" +
        "        checksum += values[i] * i64(i + 1)\n" +
        "    }\n" +
        "    print(checksum)\n" +
        "    if values.len > 0 {\n" +
        "        print(values[0])\n" +
        "        print(values[values.len - 1])\n" +
        "    } else {\n" +
        "        print(0)\n" +
        "        print(0)\n" +
        "    }\n" +
        "}\n"
}
