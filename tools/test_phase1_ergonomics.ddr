capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import sys

fn check_invalid_cases(compiler: string, work: string) -> bool {
    cases: [](string, string) = [
        ("pub struct Box { pub value: i32 }\nfn main() {}", "remove 'pub' from the field"),
        ("fn main() { value: i32 = 1; _ := value.missing() }", "unknown integer method 'missing'"),
        // mut move invalid
        ("fn bad(mut x: &i32) {}\nfn main() {}", "mutable parameter requires 'mut move' or '&mut'"),
        ("fn bad(mut x: &mut i32) {}\nfn main() {}", "mutable parameter requires 'mut move' or '&mut'"),
        // unsafe divergence negative
        ("capability unsafe\nfn bad(flag: bool) -> i32 { unsafe { if flag { return 1 } } }\nfn main() {}", "function can finish without returning"),
        // as_bytes borrow conflict
        ("fn main() { mut s := \"abc\"; b := s.as_bytes(); s += \"!\"; print(b.len) }", "borrow"),
        // disjoint field borrow conflict on same field
        ("struct Pair { a: i32, b: i32 }\nimpl Pair { fn bad(&mut self) { mutate(&mut self.a, &mut self.a) } }\nfn mutate(x: &mut i32, y: &mut i32) {}\nfn main() {}", "must not alias"),
        // local &mut invalid cases
        ("fn main() { mut x := 1; mut r := &mut x; r = 2 }", "local borrows cannot be rebound"),
        ("fn main() { mut x := 1; r := &mut x; print(x); r = 2 }", "borrow"),
        ("fn main() { mut x := 1; r1 := &mut x; r2 := &mut x; r1 = 1; r2 = 2 }", "borrow"),
        ("fn bad(a: &i32) -> &mut i32 { &mut a }\nfn main() {}", "a returned mutable borrow requires a mutable input parameter"),
        // struct destructuring negative cases
        ("struct S { a: i32, b: i32 }\nfn main() { s := S { a: 1, b: 2 }; S { a } := s }", "struct pattern must name every field or end with '..'"),
        ("struct S { a: i32, b: i32 }\nfn main() { s := S { a: 1, b: 2 }; S { a, a } := s }", "duplicate field 'a'"),
        ("@resource(dispose)\nstruct Res { n: i32 }\nimpl Res { fn dispose(&mut self) {} }\nfn mk() -> Res { Res { n: 1 } }\nfn main() { r := mk(); Res { n } := r }", "destructuring a move-only struct requires"),
        ("import .res_mod as rm\nfn main() { r := rm.mk(); rm.Res { n } := move r }", "cannot destructure @resource type outside its declaring module"),
        // broader match negative cases
        ("fn main() { x := 1; _ := match x { 1 => 10 } }", "non-exhaustive match"),
        ("fn main() { x := \"a\"; _ := match x { \"a\" => 1 } }", "non-exhaustive match"),
        ("fn main() { x := true; _ := match x { true => 1 } }", "non-exhaustive match"),
        ("fn main() { x := 1; _ := match x { 1 => 10, 1 => 20, _ => 30 } }", "unreachable match pattern"),
        ("fn main() { x := \"a\"; _ := match x { \"a\" => 1, \"a\" => 2, _ => 3 } }", "unreachable match pattern"),
        ("fn main() { x := true; _ := match x { true => 1, false => 2, true => 3 } }", "unreachable match pattern"),
        ("fn main() { t: (i32, bool) = (1, true); _ := match t { (_, true) => 1, (1, true) => 2, (_, false) => 3 } }", "unreachable match pattern"),
        ("enum E { A(i32), B(bool) }\nfn main() { e := E.A(1); match e { .A(x) | .B(x) => {} } }", "or-pattern alternatives must bind the same names with the same types"),
        ("enum E { A(i32), B(i32) }\nfn main() { e := E.A(1); match e { .A(x) | .B(y) => {} } }", "or-pattern alternatives must bind the same names with the same types"),
        ("fn main() { t: (i32, i32, i32) = (1, 2, 3); _ := match t { (.., x, ..) => x } }", "only one '..' wildcard"),
        // generic methods negative cases
        ("struct P { v: i32 }\nimpl P { fn tag<U>(&self, u: U) -> i32 { self.v } }\nfn main() { p := P { v: 1 }; _ := p.tag<i32, bool>(2) }", "wrong number of type arguments"),
        ("struct P { v: i32 }\nimpl P { fn mk<U>() -> i32 { 0 } }\nfn main() { _ := P::mk() }", "cannot infer type arguments"),
        ("struct P { v: i32 }\nstruct NoEq { n: i32 }\nimpl P { fn eq_check<U>(&self, a: &U, b: &U) -> bool where U: Eq { a.eq(b) } }\nfn main() { p := P { v: 1 }; _ := p.eq_check(&NoEq { n: 1 }, &NoEq { n: 2 }) }", "does not implement required trait 'Eq'"),
        // @derive negative cases
        ("@derive(Default)\nenum E { A, B }\nfn main() {}", "cannot derive Default for enum"),
        ("@derive(CloneFoo)\nstruct S { x: i32 }\nfn main() {}", "unknown derive trait"),
        ("@derive(Eq, Eq)\nstruct S { x: i32 }\nfn main() {}", "duplicate trait 'Eq'"),
        ("@derive(Eq)\nfn f() {}\nfn main() {}", "@derive can only be applied to a struct or enum"),
        ("struct NoEq { a: i32 }\n@derive(Eq)\nstruct Bad { n: NoEq }\nfn main() { a := Bad { n: NoEq { a: 1 } }; b := Bad { n: NoEq { a: 1 } }; _ := a.eq(&b) }", "unknown method 'eq'"),
    ]
    res_mod_code := "@resource(dispose)\npub struct Res { n: i32 }\nimpl Res { fn dispose(&mut self) {} }\npub fn mk() -> Res { Res { n: 1 } }\n"
    if !sys.write_text(work + "/res_mod.ddr", res_mod_code).ok { return false }
    harness.check_rejected_specializations(compiler, work, &cases)
}

fn check_positive_program(compiler: string, work: string) -> bool {
    mod_code := "import std.alloc\n" +
        "@derive(Eq, Hash, Display, Default)\n" +
        "pub struct ExportedPoint { x: i32, y: i32 }\n" +
        "pub fn make_exported(x: i32, y: i32) -> ExportedPoint { ExportedPoint { x, y } }\n" +
        "@derive(Eq, Hash, Display)\n" +
        "pub struct ExportedBox<T> { val: T }\n" +
        "impl ExportedBox<T> {\n" +
        "    pub fn new(move val: T) -> Self { ExportedBox<T> { val } }\n" +
        "    pub fn map<U>(&self, f: fn(&T) -> U) -> ExportedBox<U> { ExportedBox<U> { val: f(&self.val) } }\n" +
        "    pub fn pair_with<U>(move a: T, move b: U) -> (T, U) { (a, b) }\n" +
        "}\n" +
        "@resource(dispose)\n" +
        "pub struct SecretRes { log: []i32, tag: i32 }\n" +
        "impl SecretRes {\n" +
        "    pub fn new(tag: i32, move log: []i32) -> Self { SecretRes { log, tag } }\n" +
        "    pub fn into_tag_no_dispose(mut move self) -> i32 {\n" +
        "        self.tag += 1\n" +
        "        Self { tag, .. } := move self\n" +
        "        tag\n" +
        "    }\n" +
        "    fn dispose(&mut self) {\n" +
        "        self.log.push(999)\n" +
        "    }\n" +
        "}\n"
    if !sys.write_text(work + "/p1mod.ddr", mod_code).ok { return false }

    main_code := "capability unsafe\n" +
        "import std.alloc as alloc\n" +
        "import std.Map\n" +
        "import .p1mod as p1\n" +
        "struct Point { x: i32, y: i32 }\n" +
        "struct Pair { a: i32, b: i32 }\n" +
        "impl Pair {\n" +
        "    fn bump_both(&mut self) { bump(&mut self.a, &mut self.b) }\n" +
        "    fn first_mut(&mut self) -> &mut i32 { &mut self.a }\n" +
        "    fn pick_mut(&mut self, left: bool) -> &mut i32 { if left { &mut self.a } else { &mut self.b } }\n" +
        "    fn make<U>(x: i32, move u: U) -> (Pair, U) { (Pair { a: x, b: x }, u) }\n" +
        "    fn combine<U>(&self, u: U, f: fn(i32, U) -> U) -> U { f(self.a + self.b, u) }\n" +
        "}\n" +
        "fn bump(x: &mut i32, y: &mut i32) { x += 1; y += 2 }\n" +
        "fn add_mut_move(mut move x: i32, move mut v: []i32) -> i32 { x += 10; v.push(x); v.len + x }\n" +
        "struct ResTracker { items: []i32 }\n" +
        "impl ResTracker {\n" +
        "    fn take_self(mut move self, d: i32) -> i32 { self.items.push(d); self.items.len }\n" +
        "}\n" +
        "fn always_ret_unsafe(flag: bool) -> i32 {\n" +
        "    unsafe {\n" +
        "        if flag { return 11 }\n" +
        "        return 22\n" +
        "    }\n" +
        "}\n" +
        "fn match_ret_unsafe(n: i32) -> i32 {\n" +
        "    match n {\n" +
        "        0 => unsafe { return 100 },\n" +
        "        1 => return 101,\n" +
        "        _ => {},\n" +
        "    }\n" +
        "    n + 50\n" +
        "}\n" +
        "struct NonDefaultAlloc { bias: usize, frees: i32 }\n" +
        "impl NonDefaultAlloc {\n" +
        "    fn new(bias: usize) -> Self { NonDefaultAlloc { bias, frees: 0 } }\n" +
        "}\n" +
        "impl alloc.RawAllocator for NonDefaultAlloc {\n" +
        "    unsafe fn alloc(&mut self, layout: alloc.Layout) -> Result<alloc.Block, alloc.AllocError> {\n" +
        "        mut g := alloc.Global::new()\n" +
        "        g.alloc(layout)\n" +
        "    }\n" +
        "    unsafe fn dealloc(&mut self, block: alloc.Block, layout: alloc.Layout) {\n" +
        "        self.frees += 1\n" +
        "        mut g := alloc.Global::new()\n" +
        "        g.dealloc(block, layout)\n" +
        "    }\n" +
        "}\n" +
        "@derive(Eq, Hash, Display, Default)\n" +
        "struct EmptyStruct {}\n" +
        "@derive(Eq, Hash, Default)\n" +
        "struct Key { id: i32, name: string, tags: []i32, pair: (i32, bool) }\n" +
        "@derive(Eq, Hash, Display, Default)\n" +
        "struct GenPair<T, U> where T: Eq { first: T, second: U }\n" +
        "@derive(Eq, Hash, Display)\n" +
        "enum Color { Red, Green, Blue }\n" +
        "@derive(Eq, Hash, Display)\n" +
        "enum SinglePayload { Only(i32) }\n" +
        "@derive(Eq, Hash, Display)\n" +
        "enum Expr { Zero, Num(i32), Pair(i32, string) }\n" +
        "enum Multi { Empty, Quad(i32, string, bool, i32), Alt(i32, string) }\n" +
        "fn main() {\n" +
        "    // 1. Field shorthand\n" +
        "    x := 3; y := 4\n" +
        "    pt := Point { x, y }\n" +
        "    pt2 := Point { x, y: y + 10 }\n" +
        "    assert(pt.x == 3 && pt.y == 4 && pt2.y == 14)\n" +
        "    // 2. mut move params\n" +
        "    assert(add_mut_move(5, [1, 2]) == 18)\n" +
        "    assert(ResTracker { items: [7] }.take_self(8) == 2)\n" +
        "    // 3. unsafe divergence & expressions\n" +
        "    assert(always_ret_unsafe(true) == 11 && always_ret_unsafe(false) == 22)\n" +
        "    assert(match_ret_unsafe(0) == 100 && match_ret_unsafe(1) == 101 && match_ret_unsafe(2) == 52)\n" +
        "    uval := unsafe { 40 } + 2\n" +
        "    assert(uval == 42)\n" +
        "    // 4. string.as_bytes()\n" +
        "    txt := \"åA\"\n" +
        "    bs := txt.as_bytes()\n" +
        "    assert(bs.len == 3 && bs[0] == u8(195) && bs[1] == u8(165) && bs[2] == u8(65))\n" +
        "    empty_s := \"\"\n" +
        "    assert(empty_s.as_bytes().len == 0)\n" +
        "    // 5. []T.truncate(n)\n" +
        "    mut nums: []i32 = [10, 20, 30, 40]\n" +
        "    nums.truncate(10)\n" +
        "    assert(nums.len == 4)\n" +
        "    nums.truncate(2)\n" +
        "    assert(nums.len == 2 && nums[0] == 10 && nums[1] == 20)\n" +
        "    nums.truncate(0)\n" +
        "    assert(nums.len == 0)\n" +
        "    mut strs: []string = [\"one\", \"two\", \"three\"]\n" +
        "    strs.truncate(1)\n" +
        "    assert(strs.len == 1 && strs[0] == \"one\")\n" +
        "    // 6. disjoint field borrows behind &mut self + Pair\n" +
        "    mut pr := Pair { a: 1, b: 2 }\n" +
        "    pr.bump_both()\n" +
        "    assert(pr.a == 2 && pr.b == 4)\n" +
        "    // 7. local &mut bindings + returned &mut + reborrow\n" +
        "    mut val := 10\n" +
        "    rv := &mut val\n" +
        "    rv += 5\n" +
        "    assert(val == 15)\n" +
        "    la := &mut pr.a\n" +
        "    lb := &mut pr.b\n" +
        "    la = 20\n" +
        "    lb = 30\n" +
        "    assert(pr.a == 20 && pr.b == 30)\n" +
        "    sub := &mut pr.a\n" +
        "    sub2 := &mut sub\n" +
        "    sub2 += 5\n" +
        "    assert(pr.a == 25)\n" +
        "    fm := pr.first_mut()\n" +
        "    fm = 77\n" +
        "    pm := pr.pick_mut(false)\n" +
        "    pm = 88\n" +
        "    assert(pr.a == 77 && pr.b == 88)\n" +
        "    // 8. @resource destructuring + alloc without Default\n" +
        "    sr := p1.SecretRes::new(41, [1])\n" +
        "    assert(sr.into_tag_no_dispose() == 42)\n" +
        "    mut ob := alloc.OwnedBuf<NonDefaultAlloc>::new(NonDefaultAlloc::new(usize(1)))\n" +
        "    _ := ob.extend_bytes(\"hi\".as_bytes())\n" +
        "    alloc_back := ob.into_allocator()\n" +
        "    assert(alloc_back.bias == usize(1) && alloc_back.frees == 1)\n" +
        "    mut ar := alloc.Arena<NonDefaultAlloc>::new(NonDefaultAlloc::new(usize(2)))\n" +
        "    _ := ar.push_bytes(\"hello\".as_bytes())\n" +
        "    fr := ar.freeze()\n" +
        "    assert(fr.allocator().bias == usize(2) && fr.total_bytes() == usize(5))\n" +
        "    // Struct destructuring rename + mut + ..\n" +
        "    Pair { a: mut da, .. } := pr\n" +
        "    da += 1\n" +
        "    assert(da == 78)\n" +
        "    // 9. broader match\n" +
        "    assert(match -2 { -2 => 10, 0 | 1 => 20, other => other + 1 } == 10)\n" +
        "    assert(match 1 { -2 => 10, 0 | 1 => 20, _ => 30 } == 20)\n" +
        "    assert(match u8(5) { 5 => true, _ => false })\n" +
        "    assert(match true { true => 1, false => 2 } == 1)\n" +
        "    assert(match `z` { `a` | `z` => 9, _ => 0 } == 9)\n" +
        "    assert(match \"hello\" { \"hi\" | \"hello\" => 1, _ => 0 } == 1)\n" +
        "    tup4: (i32, i32, i32, i32) = (1, 2, 3, 4)\n" +
        "    assert(match tup4 { (0, ..) => 0, (1, .., last) => last, _ => 9 } == 4)\n" +
        "    m1 := Multi.Quad(10, \"ok\", true, 99)\n" +
        "    assert(match m1 { .Empty => 0, .Quad(head, .., tail) => head + tail, .Alt(_, _) => -1 } == 109)\n" +
        "    m2: Multi = .Alt(7, \"seven\")\n" +
        "    assert(match m2 { .Quad(v, _, _, _) | .Alt(v, _) => v, .Empty => 0 } == 7)\n" +
        "    // 10. generic methods in impl blocks\n" +
        "    tup := Pair::make<string>(5, \"hi\")\n" +
        "    assert(tup.0.a == 5 && tup.1 == \"hi\")\n" +
        "    tup2 := Pair::make(6, true)\n" +
        "    assert(tup2.0.b == 6 && tup2.1)\n" +
        "    assert(pr.combine<i32>(3, fn(a: i32, b: i32) -> i32 { a + b }) == 168)\n" +
        "    assert(pr.combine(\"!\", fn(n: i32, s: string) -> string { n.str() + s }) == \"165!\")\n" +
        "    eb := p1.ExportedBox<i32>::new(21)\n" +
        "    eb2 := eb.map(fn(v: &i32) -> i32 { v * 2 })\n" +
        "    eb3 := eb2.map<string>(fn(v: &i32) -> string { v.str() })\n" +
        "    assert(eb3.val == \"42\")\n" +
        "    ep := p1.ExportedBox<i32>::pair_with<bool>(1, true)\n" +
        "    ep2 := p1.ExportedBox::pair_with(\"a\", 2)\n" +
        "    assert(ep.0 == 1 && ep.1 && ep2.0 == \"a\" && ep2.1 == 2)\n" +
        "    // 11. @derive(Eq, Hash, Display, Default)\n" +
        "    es1 := EmptyStruct::default(); es2 := EmptyStruct {}\n" +
        "    assert(es1.eq(&es2) && es1.str() == \"EmptyStruct {}\" && es1.hash() == es2.hash())\n" +
        "    k1 := Key { id: 1, name: \"k\", tags: [1, 2], pair: (3, true) }\n" +
        "    k2 := Key { id: 1, name: \"k\", tags: [1, 2], pair: (3, true) }\n" +
        "    k3 := Key::default()\n" +
        "    assert(k1.eq(&k2) && k1.hash() == k2.hash() && !k1.eq(&k3))\n" +
        "    assert(k3.id == 0 && k3.name == \"\" && k3.tags.len == 0 && k3.pair.0 == 0 && !k3.pair.1)\n" +
        "    mut mp: Map<Key, i32> = Map::new()\n" +
        "    mp.put(move k1, 42)\n" +
        "    assert(mp.get_or(k2, 0) == 42)\n" +
        "    gp1 := GenPair<i32, string>::default()\n" +
        "    gp2 := GenPair<i32, string> { first: 0, second: \"\" }\n" +
        "    assert(gp1.eq(&gp2) && gp1.str() == \"GenPair { first: 0, second:  }\")\n" +
        "    assert(Color.Red.eq(&Color.Red) && !Color.Red.eq(&Color.Blue) && Color.Green.str() == \"Green\")\n" +
        "    sp1 := SinglePayload.Only(9); sp2 := SinglePayload.Only(9)\n" +
        "    assert(sp1.eq(&sp2) && sp1.str() == \"Only(9)\")\n" +
        "    e1 := Expr.Pair(5, \"x\"); e2 := Expr.Pair(5, \"x\"); e3 := Expr.Zero\n" +
        "    assert(e1.eq(&e2) && !e1.eq(&e3) && e1.hash() == e2.hash() && e1.str() == \"Pair(5, x)\" && e3.str() == \"Zero\")\n" +
        "    exp1 := p1.make_exported(7, 8); exp2 := p1.ExportedPoint::default()\n" +
        "    assert(exp1.str() == \"ExportedPoint { x: 7, y: 8 }\" && exp2.x == 0)\n" +
        "    print(42)\n" +
        "}\n"
    main_path := work + "/phase1_main.ddr"
    if !sys.write_text(main_path, main_code).ok { return false }
    if !harness.run_specialization_matrix(compiler, main_path, work, "42\n") { return false }

    // Also test runtime negative bounds check on []T.truncate(-1)
    bounds_path := work + "/trunc_neg.ddr"
    bounds_bin := work + "/trunc_neg"
    if !sys.write_text(bounds_path, "fn main() { mut v: []i32 = [1, 2]; v.truncate(-1) }\n").ok { return false }
    mut out := harness.empty_output()
    if !harness.run_checked_timeout(compiler, ["build", bounds_path.clone(), "-o", bounds_bin.clone()], work, 0, false, 120000, &mut out) { return false }
    res := harness.exec_cmd(bounds_bin, [], work, false, 10000)
    if res.code == 0 && res.signal == 0 { return harness.fail("expected negative truncate length to trap at runtime") }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    check_invalid_cases(cli.compiler, work) && check_positive_program(cli.compiler, work)
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-phase1-")
    if !tmp.ok { return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
