capability filesystem, stdio

import sys
import std.bytes as bytes
import std.map as maps
import std.parse as parse
import std.text as text

enum Source { Breaks, Indic, Pictographs, Width, Ignorable, PrependedMarks, Hangul, Emoji, Variation, JoiningGroup, JoiningType, Mark, DefaultIgnorable }

fn body(line: string) -> string {
    text.trim(line[0..text.find(line, "#").unwrap_or(line.len)])
}

fn put_range(table: &mut []i32, interval: string, value: i32, mask: i32, omit_marks: bool) {
    ends := text.split(interval, "..")
    first := parse.hex(ends[0])
    last := parse.hex(ends[ends.len - 1])
    assert(first.ok && last.ok && first.value <= last.value && last.value < i64(table.len))
    for i in i32(first.value)..i32(last.value + 1) {
        if !omit_marks || table[i].bit_and(4096) == 0 { table[i] = table[i].bit_and(mask.bit_not()).bit_or(value) }
    }
}

fn load_file(table: &mut []i32, path: string, source: Source) {
    classes := ["Other", "CR", "LF", "Control", "Extend", "ZWJ", "Regional_Indicator", "Prepend", "SpacingMark", "L", "V", "T", "LV", "LVT"]
    for raw in text.split(sys.read(path).unwrap(), "\n") {
        fields := text.split(body(raw), ";")
        if fields.len < 2 { continue }
        interval := text.trim(fields[0])
        prop := text.trim(fields[1])
        match source {
            .Breaks => {
                mut index := 0
                while index < classes.len && classes[index] != prop { index += 1 }
                assert(index < classes.len)
                put_range(&mut table, interval, index, 15, false)
            },
            .Indic if prop == "InCB" => {
                state := match text.trim(fields[2]) { "Consonant" => 1, "Extend" => 2, "Linker" => 3, _ => 0, }
                put_range(&mut table, interval, state * 16, 48, false)
            },
            .Pictographs if prop == "Extended_Pictographic" => { put_range(&mut table, interval, 64, 64, false) },
            .Width if prop == "W" || prop == "F" => { put_range(&mut table, interval, 256, 384, false) },
            .Ignorable if prop == "Default_Ignorable_Code_Point" || prop == "Grapheme_Extend" => { put_range(&mut table, interval, 0, 384, false) },
            .PrependedMarks if prop == "Prepended_Concatenation_Mark" => { put_range(&mut table, interval, 4096, 4096, false) },
            .Hangul if prop == "Prepend" => { put_range(&mut table, interval, 0, 384, true) },
            .Hangul if (prop == "V" || prop == "T") && parse.hex(text.split(interval, "..")[0]).value < 0x10000 => {
                put_range(&mut table, interval, 0, 384, false)
            },
            .Emoji if prop == "Emoji_Presentation" => { put_range(&mut table, interval, 512, 512, false) },
            .Emoji if prop == "Emoji_Modifier_Base" => { put_range(&mut table, interval, 1024, 1024, false) },
            .Variation => {
                pair := text.split(interval, " ")
                if pair.len == 2 && pair[1] == "FE0F" { put_range(&mut table, pair[0], 2048, 2048, false) }
            },
            .JoiningGroup if prop == "Lam" || prop == "Alef" => { put_range(&mut table, interval, if prop == "Lam" { 1 } else { 2 }, 3, false) },
            .JoiningType if prop == "T" => { put_range(&mut table, interval, 4, 4, false) },
            .Mark if prop == "Mn" || prop == "Mc" || prop == "Me" => { put_range(&mut table, interval, 8, 8, false) },
            .DefaultIgnorable if prop == "Default_Ignorable_Code_Point" => { put_range(&mut table, interval, 16, 16, false) },
            _ => {},
        }
    }
}

fn append_pair(out: &mut []u8, value: i32) {
    assert(value >= 0 && value < 4096)
    out.push(u8(35 + value / 64))
    out.push(u8(35 + value % 64))
}

fn intern(dict: &mut maps.Map<string, i32>, data: &mut []u8, block: &[]u8) -> i32 {
    key := bytes.decode(&block).unwrap()
    index := dict.index_of(key)
    if index >= 0 { return index }
    next := dict.len()
    _ := dict.put_new(move key, next)
    for b in block { data.push(b) }
    next
}

fn function(name: string, data: &[]u8) -> string {
    "pub fn " + name + "() -> string { r\"" + bytes.decode(&data).unwrap() + "\" }\n"
}

fn encode(table: &[]i32) -> string {
    mut latin1: []u8 = []
    for cp in 0..256 { append_pair(&mut latin1, table[cp].bit_and(4095)) }
    mut ranks: []i32 = []
    for _ in 0..4096 { ranks.push(-1) }
    for prop in table { ranks[prop.bit_and(4095)] = 0 }
    mut values: []u8 = []
    for i in 0..4096 {
        if ranks[i] >= 0 { ranks[i] = values.len / 2; assert(ranks[i] < 64); append_pair(&mut values, i) }
    }
    mut group_ids := maps.Map<string, i32>::new()
    mut page_ids := maps.Map<string, i32>::new()
    mut states: []u8 = []
    mut groups: []u8 = []
    mut pages: []u8 = []
    mut group: []u8 = []
    mut page: []u8 = []
    for i in 0..table.len {
        group.push(u8(35 + ranks[table[i].bit_and(4095)]))
        if group.len == 32 {
            append_pair(&mut page, intern(&mut group_ids, &mut states, &group))
            group.clear()
        }
        if page.len == 64 {
            append_pair(&mut pages, intern(&mut page_ids, &mut groups, &page))
            page.clear()
        }
    }
    function("latin1", &latin1) + function("pages", &pages) + function("groups", &groups) + function("states", &states) + function("values", &values)
}

fn joining_ranges(new: string, widths: &[]i32) -> string {
    mut flags: []i32 = []
    flags.reserve(widths.len)
    for _ in 0..widths.len { flags.push(0) }
    load_file(&mut flags, new + "extracted/DerivedJoiningGroup.txt", .JoiningGroup)
    load_file(&mut flags, new + "extracted/DerivedJoiningType.txt", .JoiningType)
    load_file(&mut flags, new + "extracted/DerivedGeneralCategory.txt", .Mark)
    load_file(&mut flags, new + "DerivedCoreProperties.txt", .DefaultIgnorable)
    for i in 0..flags.len {
        f := flags[i]
        flags[i] = f.bit_and(3)
        if f.bit_and(4) != 0 && widths[i].bit_and(384) == 0 { flags[i] += 4 }
        if f.bit_and(24) == 24 { flags[i] += 8 }
    }
    mut out: []u8 = []
    mut start := 0
    while start < flags.len {
        mut end := start + 1
        while end < flags.len && flags[end] == flags[start] { end += 1 }
        if flags[start] != 0 {
            for cp in [start, end - 1] {
                append_pair(&mut out, cp / 4096)
                append_pair(&mut out, cp % 4096)
            }
            out.push(u8(35 + flags[start]))
        }
        start = end
    }
    function("joining", &out)
}

fn main() -> i32 {
    if sys.arg_count() != 3 { print("unicode UCD-17-directory UCD-18-directory"); return 1 }
    old := sys.arg(1) + "/"
    new := sys.arg(2) + "/"
    mut table: []i32 = []
    table.reserve(0x110000)
    for _ in 0..0x110000 { table.push(128) }
    load_file(&mut table, old + "auxiliary/GraphemeBreakProperty.txt", .Breaks)
    load_file(&mut table, old + "DerivedCoreProperties.txt", .Indic)
    load_file(&mut table, old + "emoji/emoji-data.txt", .Pictographs)
    load_file(&mut table, new + "EastAsianWidth.txt", .Width)
    load_file(&mut table, new + "DerivedCoreProperties.txt", .Ignorable)
    load_file(&mut table, new + "PropList.txt", .PrependedMarks)
    load_file(&mut table, new + "auxiliary/GraphemeBreakProperty.txt", .Hangul)
    load_file(&mut table, new + "emoji/emoji-data.txt", .Emoji)
    load_file(&mut table, new + "emoji/emoji-variation-sequences.txt", .Variation)
    for cp in [0x605, 0x70f, 0x890, 0x891, 0x8e2, 0xa8fa] { table[cp] = table[cp].bit_and(384.bit_not()) }
    points := [0x2d7f, 0xff9e, 0xff9f, 0x115f, 0x17a4, 0x17d8]
    widths := [1, 2, 2, 2, 2, 3]
    for i in 0..points.len { cp := points[i]; table[cp] = table[cp].bit_and(384.bit_not()).bit_or(widths[i] * 128) }
    assert(sys.write("stdlib/terminal/width_data.ddr", encode(&table) + joining_ranges(new, &table)).is_ok())
    0
}
