capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

fn invalid_cases() -> [](string, string) {
    [
        ("n := 3; f := fn() -> i32 { n }", "unknown local 'n'"),
        ("n := 3; f := fn[n: bool]() -> bool { n }", "type mismatch"),
        ("n := 3; f := fn[n]() -> i32 { n }", "expected a closure capture"),
        ("n := 3; f := fn[n: i32, n: i32]() -> i32 { n }", "duplicate closure capture"),
        ("n := 3; f := fn[n: i32](n: i32) -> i32 { n }", "duplicate local name"),
        ("n := 3; f := fn[n: &i32]() -> i32 { n }", "cannot store a borrowed reference"),
        ("mut n := 3; f := fn[n: i32]() { n = 4 }", "mutable stored value"),
        ("s := \"a\"; f := fn[s: string]() -> i32 { s.len }; print(s)", "use of moved value"),
        ("n := 3; f := fn[n: i32]() -> &i32 { &n }", "shared input parameter"),
        ("n := 3; f: fn(bool) -> i32 = fn[n: i32](x: i32) -> i32 { x+n }", "type mismatch"),
        ("f := fn(x: i32) -> i32 { true }", "type mismatch"),
    ]
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    values := cli.root + "/tests/fixtures/closures/values.ddr"
    image := work + "/values"
    host := process.host_target()
    mut targets := harness.targets()
    targets.push("wasm32")
    mut result := harness.empty_output()

    for target in targets {
        for optimized in [true, false] {
            workers := if optimized { "4" } else { "1" }
            mut args: []string = ["build", values.clone(), "--target", target.clone(), "-o", image.clone(), "--jobs", workers]
            if !optimized {
                args.push("--mir=off")
                args.push("--scalar-opt=off")
            }
            if !harness.run_checked(cli.compiler, args, work, 0, false, &mut result) { return false }
            if target == host || target == "wasm32" {
                if !harness.run_target_image(target, image, work, &mut result) { return false }
                if result.stdout_text() != "42\n" {
                    return harness.fail(f"{target} closure output: {result.stdout_text()}")
                }
            }
        }
    }

    if !harness.run_checked(cli.compiler, ["build", values, "--runtime-profile", "-o", image.clone()], work, 0, false, &mut result) ||
       !harness.run_checked(image, [], work, 0, false, &mut result) { return false }
    profile := json.Doc::parse_text(result.stderr_text())
    counters := profile.field(profile.root, "counters")
    fresh := profile.get_i64(counters, "fresh_allocations")
    reused := profile.get_i64(counters, "reused_allocations")
    if result.stdout_text() != "42\n" || !fresh.ok || fresh.value >= 64 || !reused.ok || reused.value < 256 {
        return harness.fail(f"unexpected closure profile: {result.stderr_text()}")
    }

    source := work + "/invalid.ddr"
    for case in move invalid_cases() {
        (body, message) := case
        code := "fn main() { " + body + " }\n"
        if !sys.write_text(source, code).ok { return harness.fail(f"cannot write {source}") }
        if !harness.check_agent_error(cli.compiler, source, message, work) ||
           !harness.run_checked(cli.compiler, ["build", source.clone(), "--jobs", "4", "-o", image.clone()], work, 1, false, &mut result) {
            return false
        }
        if !text.contains(result.stderr_text(), message) {
            return harness.fail(f"missing {message} for {body}: {result.stderr_text()}")
        }
    }

    suite := work + "/suite.ddr"
    if !sys.write_text(suite, "@test fn literals() { n := 40; f := fn[n: i32](x: i32) -> i32 { x + n }; assert(f(2) == 42) }\n").ok {
        return harness.fail(f"cannot write {suite}")
    }
    if !harness.run_checked(cli.compiler, ["test", suite, "-o", work + "/suite"], work, 0, false, &mut result) { return false }
    if !text.contains(result.stdout_text(), "literals") {
        return harness.fail(f"closure test missing from suite output: {result.stdout_text()}")
    }

    extra := work + "/extra_closures.ddr"
    extra_src := "fn take(move a: []i32) -> i32 { a.len }\n" +
        "fn mk() -> fn(move []i32) -> i32 { take }\n" +
        "trait Get { fn getter(&self) -> fn() -> i32 }\n" +
        "struct Boxed { n: i32 }\n" +
        "impl Get for Boxed {\n" +
        "    fn getter(&self) -> fn() -> i32 { fn[self: Self]() -> i32 { self.n } }\n" +
        "}\n" +
        "struct Wrap<T> { item: T }\n" +
        "impl Wrap<T> {\n" +
        "    fn maker() -> fn(T) -> Self { fn(v: T) -> Self { Self { item: v } } }\n" +
        "}\n" +
        "@resource(dispose)\n" +
        "struct Token { id: i32 }\n" +
        "impl Token { fn dispose(&self) { print(self.id) } }\n" +
        "fn main() {\n" +
        "    assert(mk()([1, 2, 3]) == 3)\n" +
        "    b := Boxed { n: 42 }\n" +
        "    assert(b.getter()() == 42)\n" +
        "    w := Wrap<i32>::maker()(42)\n" +
        "    assert(w.item == 42)\n" +
        "    f := fn(x: i32) -> Result<i32, string> { .Ok(x) }\n" +
        "    assert(f(42) == .Ok(42))\n" +
        "    {\n" +
        "        t := Token { id: 99 }\n" +
        "        c := fn[t: Token]() -> i32 { t.id }\n" +
        "        g := c\n" +
        "        assert(c() == 99 && g() == 99)\n" +
        "    }\n" +
        "    print(42)\n" +
        "}\n"
    if !sys.write_text(extra, extra_src).ok { return harness.fail(f"cannot write {extra}") }
    extra_targets: []string = [host.clone(), "wasm32"]
    for target in extra_targets {
        if !harness.run_checked(cli.compiler, ["build", extra.clone(), "--target", target.clone(), "-o", image.clone()], work, 0, false, &mut result) ||
           !harness.run_target_image(target, image, work, &mut result) ||
           result.stdout_text() != "99\n42\n" {
            return harness.fail(f"{target} extra closure checks failed: {result.stdout_text()}")
        }
    }

    print("Closure calls, ownership, target builds and diagnostics passed.")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-closures-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
