capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

fn invalid_cases() -> [](string, string, string) {
    [
        ("n := 3; f := fn() -> i32 { n }", "unknown local 'n'", ""),
        ("n := 3; f := fn[n: bool]() -> bool { n }", "type mismatch", ""),
        ("n := 3; f := fn[n: ]() -> i32 { n }", "expected closure capture type", ""),
        ("n := 3; f := fn[n: i32, n: i32]() -> i32 { n }", "duplicate closure capture", ""),
        ("n := 3; f := fn[n: i32](n: i32) -> i32 { n }", "duplicate local name", ""),
        ("n := 3; f := fn[n: &i32]() -> i32 { n }", "cannot store a borrowed reference", ""),
        ("mut n := 3; f := fn[n: i32]() { n = 4 }", "mutable stored value", ""),
        ("s := \"a\"; f := fn[s: string]() -> i32 { s.len }; print(s)", "use of moved value", ""),
        ("n := 3; f := fn[n: i32]() -> &i32 { &n }", "shared input parameter", ""),
        ("n := 3; f: fn(bool) -> i32 = fn[n: i32](x: i32) -> i32 { x + n }", "type mismatch", ""),
        ("n := 3; f: fn() -> i32 = fn[n: i32]() -> i32 { n }", "type mismatch", "capturing closures cannot convert to raw function pointers"),
        ("x := 1; f: Fn() -> i32 = fn[&x]() -> i32 { x }; _ := f()", "type mismatch", "borrowed closure cannot escape"),
        ("x := 1; mut xs: []Fn() -> i32 = []; xs.push(fn[&x]() -> i32 { x })", "type mismatch", "borrowed closure cannot escape"),
        ("mut x := 1; cb := fn[&x]() -> i32 { x }; x = 2; _ := cb()", "borrowed", ""),
        ("mut x := 1; cb := fn[&mut x, &mut x]() { x += 1 }; cb()", "duplicate closure capture", ""),
        ("mut x := 1; r := &x; cb := fn[&mut x, &r]() { _ := r; x += 1 }; cb()", "borrowed", ""),
        ("mut n := 0; f := fn[mut n: i32]() -> i32 { n += 1; n }; _ := f()", "calling an FnMut closure requires 'mut' or '&mut'", ""),
        ("a := 1; cb := fn[&a]() -> i32 { a }; _ := cb.clone()", "borrowed closure cannot be cloned", ""),
        ("mut a := 1; f := fn[mut a]() -> i32 { a += 1; a }; _ := f.clone()", "FnMut/FnOnce closures cannot be cloned", ""),
        ("a := 1; f := move fn[a]() -> i32 { a }; _ := f.clone()", "FnMut/FnOnce closures cannot be cloned", ""),
        ("a := 1; f := move fn[a]() -> i32 { a }; _ := f(); _ := f()", "use of moved value", ""),
        ("a := 1; cb: &Fn() -> i32 = fn[a]() -> i32 { a }; _ := cb()", "local borrow requires a named owner", ""),
        ("f := fn(x: i32) -> i32 { true }", "type mismatch", ""),
    ]
}

fn invalid_modules() -> [](string, string) {
    [
        ("fn mk() -> &Fn() -> i32 { x := 1; fn[&x]() -> i32 { x } }\nfn main() { _ := mk() }\n", "borrow"),
        ("fn apply_mut(cb: &mut FnMut(&mut i32), v: &mut i32) { cb(&mut v) }\nfn main() { mut x := 1; apply_mut(fn[&mut x](v: &mut i32) { v += 1 }, &mut x) }\n", "mutable arguments must not alias"),
        ("fn apply_shared_mut(cb: &mut FnMut(&mut i32), v: &mut i32) { cb(&mut v) }\nfn main() { mut x := 1; apply_shared_mut(fn[&x](v: &mut i32) { v += x }, &mut x) }\n", "mutable arguments must not alias"),
        ("fn take_copy<T: Copy>(x: T) {}\nfn main() { a := 1; f := fn[a]() -> i32 { a }; take_copy<Fn() -> i32>(f) }\n", "Copy"),
    ]
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    values := cli.root + "/tests/fixtures/closures/values.ddr"
    image := work + "/values"
    host := process.host_target()
    mut targets := harness.targets()
    targets.push("wasm32")
    mut result := harness.empty_output()

    for target in targets {
        for optimized in [true, false] {
            workers := if optimized { "4" } else { "1" }
            mut args: []string = ["build", values.clone(), "--target", target.clone(), "-o", image.clone(), "--jobs", workers]
            if !optimized {
                args.push("--mir=off")
                args.push("--scalar-opt=off")
            }
            if !harness.run_checked(cli.compiler, args, work, 0, false, &mut result) { return false }
            if target == host || target == "wasm32" {
                if !harness.run_target_image(target, image, work, &mut result) { return false }
                if result.stdout_text() != "42\n" {
                    return harness.fail(f"{target} closure output: {result.stdout_text()}")
                }
            }
        }
    }

    if !harness.run_checked(cli.compiler, ["build", values, "--runtime-profile", "-o", image.clone()], work, 0, false, &mut result) ||
    !harness.run_checked(image, [], work, 0, false, &mut result) { return false }
    profile := json.Doc::parse_text(result.stderr_text())
    counters := profile.field(profile.root, "counters")
    fresh := profile.get_i64(counters, "fresh_allocations")
    reused := profile.get_i64(counters, "reused_allocations")
    if result.stdout_text() != "42\n" || !fresh.ok || fresh.value >= 64 || !reused.ok || reused.value < 256 {
        return harness.fail(f"unexpected closure profile: {result.stderr_text()}")
    }

    source := work + "/invalid.ddr"
    for case in move invalid_cases() {
        (body, message, note) := case
        code := "fn main() { " + body + " }\n"
        if !sys.write_text(source, code).ok { return harness.fail(f"cannot write {source}") }
        if !harness.check_agent_error(cli.compiler, source, message, work) ||
        !harness.run_checked(cli.compiler, ["build", source.clone(), "--jobs", "4", "-o", image.clone()], work, 1, false, &mut result) {
            return false
        }
        if !text.contains(result.stderr_text(), message) {
            return harness.fail(f"missing {message} for {body}: {result.stderr_text()}")
        }
        if note != "" && !text.contains(result.stderr_text(), note) {
            return harness.fail(f"missing note {note} for {body}: {result.stderr_text()}")
        }
    }
    for mcase in move invalid_modules() {
        (mcode, message) := mcase
        if !sys.write_text(source, mcode).ok { return harness.fail(f"cannot write {source}") }
        if !harness.check_agent_error(cli.compiler, source, message, work) ||
        !harness.run_checked(cli.compiler, ["build", source.clone(), "--jobs", "4", "-o", image.clone()], work, 1, false, &mut result) {
            return false
        }
        if !text.contains(result.stderr_text(), message) {
            return harness.fail(f"missing {message} for module case:\n{mcode}\ngot:\n{result.stderr_text()}")
        }
    }

    suite := work + "/suite.ddr"
    if !sys.write_text(suite, "@test fn literals() { n := 40; f := fn[n](x: i32) -> i32 { x + n }; assert(f(2) == 42) }\n").ok {
        return harness.fail(f"cannot write {suite}")
    }
    if !harness.run_checked(cli.compiler, ["test", suite, "-o", work + "/suite"], work, 0, false, &mut result) { return false }
    if !text.contains(result.stdout_text(), "literals") {
        return harness.fail(f"closure test missing from suite output: {result.stdout_text()}")
    }

    extra := work + "/extra_closures.ddr"
    extra_src := "import std.array as array\n\n" +
    "fn take(move a: []i32) -> i32 { a.len }\n" +
    "fn mk() -> fn(move []i32) -> i32 { take }\n" +
    "fn require_copy<T: Copy>(x: T) -> T { x }\n" +
    "fn add1(x: i32) -> i32 { x + 1 }\n" +
    "fn call_ref(cb: &Fn(i32) -> i32, x: i32) -> i32 { cb(x) }\n" +
    "fn call_mut(cb: &mut FnMut(i32) -> i32, x: i32) -> i32 { cb(x) }\n" +
    "fn call_once(move cb: FnOnce(i32) -> i32, x: i32) -> i32 { cb(x) }\n" +
    "struct MutHolder { f: FnMut(i32) -> i32 }\n" +
    "struct OnceHolder { f: FnOnce(i32) -> i32 }\n" +
    "trait Get { fn getter(&self) -> Fn() -> i32 }\n" +
    "struct Boxed { n: i32 }\n" +
    "impl Get for Boxed {\n" +
    "    fn getter(&self) -> Fn() -> i32 { fn[self]() -> i32 { self.n } }\n" +
    "}\n" +
    "struct Wrap<T> { item: T }\n" +
    "impl Wrap<T> {\n" +
    "    fn maker() -> fn(T) -> Self { fn(v: T) -> Self { Self { item: v } } }\n" +
    "}\n" +
    "@resource(dispose)\n" +
    "struct Token { id: i32 }\n" +
    "impl Token { fn dispose(&self) { print(self.id) } }\n" +
    "fn main() {\n" +
    "    assert(mk()([1, 2, 3]) == 3)\n" +
    "    b := Boxed { n: 42 }\n" +
    "    assert(b.getter()() == 42)\n" +
    "    w := Wrap<i32>::maker()(42)\n" +
    "    assert(w.item == 42)\n" +
    "    f := fn(x: i32) -> Result<i32, string> { .Ok(x) }\n" +
    "    assert(f(42) == .Ok(42))\n" +
    "    // Raw fn stays Copy even when Fn with identical signature exists in the same program\n" +
    "    base := 10\n" +
    "    owned_fn := fn[base](x: i32) -> i32 { x + base }\n" +
    "    cloned_fn := owned_fn.clone()\n" +
    "    assert(cloned_fn(5) == 15)\n" +
    "    raw_copy := require_copy<fn(i32) -> i32>(add1)\n" +
    "    assert(raw_copy(41) == 42)\n" +
    "    // Inferred captures, nesting, FnMut, and Storable collections/options/structs\n" +
    "    step := 2\n" +
    "    mut count := 0\n" +
    "    mut counter := fn[mut count, step: i32](x: i32) -> i32 { count += x + step; count }\n" +
    "    assert(counter(1) == 3 && call_mut(&mut counter, 2) == 7)\n" +
    "    mut mvec: []FnMut(i32) -> i32 = [counter]\n" +
    "    assert(mvec[0](3) == 12)\n" +
    "    mh := MutHolder { f: fn[mut count](x: i32) -> i32 { count += x; count } }\n" +
    "    mut mopt: Option<FnMut(i32) -> i32> = .Some(mh.f)\n" +
    "    match move mopt {\n" +
    "        .Some(mut mf) => { assert(mf(4) == 4) },\n" +
    "        .None => { assert(false) },\n" +
    "    }\n" +
    "    nested := fn[base](x: i32) -> Fn(i32) -> i32 { fn[base, x](y: i32) -> i32 { base + x + y } }\n" +
    "    assert(nested(20)(12) == 42)\n" +
    "    // All 7 callable coercions\n" +
    "    assert(call_ref(add1, 41) == 42)\n" +
    "    assert(call_mut(add1, 41) == 42)\n" +
    "    owned_from_raw: Fn(i32) -> i32 = add1\n" +
    "    assert(owned_from_raw(41) == 42)\n" +
    "    mut mut_from_raw: FnMut(i32) -> i32 = add1\n" +
    "    assert(mut_from_raw(41) == 42)\n" +
    "    once_from_raw: FnOnce(i32) -> i32 = add1\n" +
    "    assert(call_once(move once_from_raw, 41) == 42)\n" +
    "    assert(call_ref(owned_fn, 32) == 42)\n" +
    "    assert(call_mut(owned_fn, 32) == 42)\n" +
    "    mut tmp_seed := 1\n" +
    "    assert(call_mut(fn[mut tmp_seed](x: i32) -> i32 { tmp_seed += x; tmp_seed }, 5) == 6)\n" +
    "    assert(call_mut(fn[&base](x: i32) -> i32 { base + x }, 32) == 42)\n" +
    "    assert(call_once(owned_fn, 32) == 42)\n" +
    "    assert(call_once(fn[mut tmp_seed](x: i32) -> i32 { tmp_seed + x }, 5) == 6)\n" +
    "    // Stack-borrowing closure with array.sort_by and Map callbacks\n" +
    "    mut xs: []i32 = [3, 1, 4, 2]\n" +
    "    desc := true\n" +
    "    array.sort_by<i32>(&mut xs, fn[&desc](a: &i32, b: &i32) -> Ordering {\n" +
    "        if desc { return b.cmp(a) }\n" +
    "        a.cmp(b)\n" +
    "    })\n" +
    "    assert(xs == [4, 3, 2, 1])\n" +
    "    mut hits := 0\n" +
    "    mut m := Map<string, i32>::new()\n" +
    "    {\n" +
    "        e1 := m.entry_or_insert_with(\"k\", fn[&mut hits]() -> i32 { hits += 1; 10 })\n" +
    "        assert(e1 == 10)\n" +
    "    }\n" +
    "    assert(m.update(\"k\", fn[&mut hits](v: &mut i32) { hits += 1; v += 5 }))\n" +
    "    {\n" +
    "        e2 := m.entry_modify_or_insert(\"k\", fn[&mut hits](v: &mut i32) { hits += 1; v *= 2 }, 99)\n" +
    "        assert(e2 == 30)\n" +
    "    }\n" +
    "    assert(hits == 3 && m.get_or(\"k\", 0) == 30)\n" +
    "    // FnOnce consumes @resource once; uncalled dropped FnOnce disposes once\n" +
    "    {\n" +
    "        tok1 := Token { id: 77 }\n" +
    "        consume := move fn[tok1](x: i32) -> i32 { tok1.id + x }\n" +
    "        assert(consume(5) == 82)\n" +
    "    }\n" +
    "    {\n" +
    "        tok2 := Token { id: 88 }\n" +
    "        unused := move fn[tok2](x: i32) -> i32 { tok2.id + x }\n" +
    "        oh := OnceHolder { f: move unused }\n" +
    "        mut ovec: []FnOnce(i32) -> i32 = [move oh.f]\n" +
    "        assert(ovec.len == 1)\n" +
    "    }\n" +
    "    {\n" +
    "        t := Token { id: 99 }\n" +
    "        c := fn[t]() -> i32 { t.id }\n" +
    "        g := c\n" +
    "        assert(c() == 99 && g() == 99)\n" +
    "    }\n" +
    "    print(42)\n" +
    "}\n"
    if !sys.write_text(extra, extra_src).ok { return harness.fail(f"cannot write {extra}") }
    extra_targets: []string = [host.clone(), "wasm32"]
    for target in extra_targets {
        for optimized in [true, false] {
            workers := if optimized { "4" } else { "1" }
            mut args: []string = ["build", extra.clone(), "--target", target.clone(), "-o", image.clone(), "--jobs", workers]
            if !optimized {
                args.push("--mir=off")
                args.push("--scalar-opt=off")
            }
            if !harness.run_checked(cli.compiler, args, work, 0, false, &mut result) ||
            !harness.run_target_image(target, image, work, &mut result) ||
            result.stdout_text() != "77\n88\n99\n42\n" {
                return harness.fail(f"{target} (opt={optimized}) extra closure checks failed: {result.stdout_text()}")
            }
        }
    }

    zero := work + "/zero_alloc_closures.ddr"
    zero_src := "import std.array as array\n\n" +
    "fn inc(x: i32) -> i32 { x + 1 }\n" +
    "fn apply_raw(f: fn(i32) -> i32, x: i32) -> i32 { f(x) }\n" +
    "fn apply_ref(f: &Fn(i32) -> i32, x: i32) -> i32 { f(x) }\n" +
    "fn apply_mut(f: &mut FnMut(i32) -> i32, x: i32) -> i32 { f(x) }\n" +
    "fn main() {\n" +
    "    k := 1\n" +
    "    owned := fn[k](x: i32) -> i32 { x + k }\n" +
    "    mut sum := 0\n" +
    "    mut i := 0\n" +
    "    while i < 1000 {\n" +
    "        sum += apply_raw(inc, 1)\n" +
    "        sum += apply_ref(fn[&k](x: i32) -> i32 { x + k }, 1)\n" +
    "        mut acc := 0\n" +
    "        sum += apply_mut(fn[&mut acc, &k](x: i32) -> i32 { acc += x + k; acc }, 1)\n" +
    "        sum -= owned(0)\n" +
    "        i += 1\n" +
    "    }\n" +
    "    mut xs: []i32 = [4, 2, 3, 1]\n" +
    "    desc := false\n" +
    "    array.sort_by<i32>(&mut xs, fn[&desc](a: &i32, b: &i32) -> Ordering {\n" +
    "        if desc { return b.cmp(a) }\n" +
    "        a.cmp(b)\n" +
    "    })\n" +
    "    mut m := Map<string, i32>::new()\n" +
    "    m.put(\"a\", 1)\n" +
    "    for _ in 0..200 {\n" +
    "        assert(m.update(\"a\", fn[&mut sum](v: &mut i32) { v += 1; sum += 0 }))\n" +
    "    }\n" +
    "    assert(sum == 5000 && xs == [1, 2, 3, 4] && m.get_or(\"a\", 0) == 201)\n" +
    "    print(42)\n" +
    "}\n"
    if !sys.write_text(zero, zero_src).ok { return harness.fail(f"cannot write {zero}") }
    if !harness.run_checked(cli.compiler, ["build", zero, "--runtime-profile", "-o", image.clone()], work, 0, false, &mut result) ||
    !harness.run_checked(image, [], work, 0, false, &mut result) { return false }
    zprof := json.Doc::parse_text(result.stderr_text())
    zcounters := zprof.field(zprof.root, "counters")
    zfresh := zprof.get_i64(zcounters, "fresh_allocations")
    if result.stdout_text() != "42\n" || !zfresh.ok || zfresh.value >= 32 {
        return harness.fail(f"expected near-zero heap allocations for raw fn and borrowed closures: {result.stderr_text()}")
    }

    print("Closure calls, ownership, target builds and diagnostics passed.")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-closures-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
