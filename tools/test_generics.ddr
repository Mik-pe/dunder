capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.bytes as bytes
import sys

fn invalid_cases() -> [](string, string) {
    [
        ("fn id<T>(x: T) -> T { x } fn main() { _ := id<i32, bool>(42) }", "wrong number of type arguments"),
        ("fn missing<T>(x: T) -> T\nfn main() {}", "expected a generic declaration body"),
        ("struct Pair<T, T> { x: T } fn main() {}", "duplicate type parameter"),
        ("struct Pair<T> { x: T, x: i32 } fn main() {}", "duplicate struct field 'x'"),
        ("fn unused<T>(x: T, x: i32) {} fn main() {}", "duplicate parameter"),
        ("struct B<T>{v:T} impl B<T>{fn answer(){}} impl B<A>{fn answer(){}} fn main(){}", "duplicate method 'answer'"),
        ("struct Box<T> { x: T } impl Box<A, B> {} fn main() {}", "generic impl must match"),
        ("struct Marker<T> { n: i32 } fn main() { _ := Marker<Missing> { n: 0 } }", "unknown type 'Missing'"),
        ("fn wrong<T>(x: T) -> i32 { x } fn main() { _ := wrong<bool>(true) }", "type mismatch"),
        ("fn invalid<T>(x: T) -> i32 { x }\nfn nested<T>(x: T) -> i32 { invalid<T>(x) }\nfn main() { _ := nested<bool>(true) }", "instantiated at"),
        ("import .library as lib\nimport .other as other\nfn bad(move x: lib.Box<lib.Item>) -> lib.Box<other.Item> { x } fn main() {}", "type mismatch"),
        ("fn broken<T>(x: T) -> i32 { missing() } fn main() {}", "unknown function 'missing'"),
        ("fn unused<T>(x: T) -> i32 { true + 1 } fn main() {}", "type mismatch"),
        ("fn unused<T>(x: T) -> i32 { n := x.len; flag: bool = 1; n } fn main() {}", "type mismatch"),
        ("fn unused<T>(x: T) -> i32 { x.measure(true + 1) } fn main() {}", "type mismatch"),
        ("fn unused<T>(x: T) -> i32 { if x.a && (true + 1) { return 1 }; 42 } fn main() {}", "type mismatch"),
        ("fn unused<T>(x: T) { for n in x { bad: i32 = true; print(n) } } fn main() {}", "type mismatch"),
        ("fn unused<T>(x: T) { f := fn(n:T)->i32 { a:i32 = true; n.size(a) }; _ := f } fn main() {}", "type mismatch"),
        ("enum A<T> { V(T) } fn unused<T>(a: A<T>) -> i32 { match a { .V(x) => { bad: i32 = true; x.len } } } fn main() {}", "type mismatch"),
        ("struct B<T> { x: T } impl B<A> { fn unused(&self) -> bool { 42 } } fn main() {}", "type mismatch"),
        ("fn unused<T>(x: T) -> i32 {} fn main() {}", "function can finish without returning"),
        ("struct Bag<T> { value: Unavailable } fn main() {}", "unknown type 'Unavailable'"),
        ("struct Wrapper<T> { x: T } impl Wrapper<K> { fn bad(&self) -> i32 { self.x.len } } fn main() { _ := Wrapper<i32> { x: 1 }.bad() }", "unknown member 'len'"),
        ("struct Need<T> where T.size: fn(T) -> i32 { value: T } struct X {} impl X { fn size(&self) -> i32 { 0 } } fn main() { _ := Need<X> { value: X {} } }", "must be public and safe"),
        ("struct Need<T> where T.size: fn(T) -> i32 { value: T } struct X {} impl X { pub fn size(&self) -> bool { true } } fn main() { _ := Need<X> { value: X {} } }", "with signature"),
        ("fn constrained<T>(x: T) -> i32 where T.size: fn(T) -> i32 { 42 } fn main() { _ := constrained<i32>(1) }", "unknown method 'size'"),
        ("struct B<T> { v:T } impl B<A> where A.size: fn(A) -> i32 { fn use(&self) -> i32 { 42 } } fn main() { _ := B<i32> {v:1}.use() }", "unknown method 'size'"),
        ("struct Node<T> { child: Node<T> } fn f(x: Node<i32>) {} fn main() {}", "inline value type"),
        ("struct B<T> { v: T } fn bad(move a: B<fn(&i32, &i32) -> &i32 from 1>) -> B<fn(&i32, &i32) -> &i32 from 2> { a } fn main() {}", "type mismatch"),
        ("enum Odd<T> { Ok(T), Err } fn main() { x := Odd<i32>.Ok(1); _ := x? }", "'?' requires a Result"),
        ("enum Odd<T> { Some(T), Other } fn main() { mut n := 1; x: Odd<&i32> = .Some(&n); n = 2; match x { .Some(v) => print(v), .Other => print(0) } }", "borrow"),
        ("import .library as lib\nfn main() { _ := lib.secret<i32>(42) }", "is private"),
        ("import .library as lib\nfn main() { h := lib.Hidden<bool>::make(true); _ := h.value }", "an opaque struct"),
        ("import .library as lib\nfn main() { h := lib.Hidden<bool>::make(true); _ := h.internal() }", "is private"),
        ("fn grow<T>() { grow<[]T>() } fn main() { grow<i32>() }", "specialization nesting limit"),
        ("fn pick<T>() -> i32 { 0 } fn main() { _ := pick() }", "cannot infer type arguments for generic function 'pick'"),
        ("import .library as lib\nfn pick_mod<T>() -> i32 { 0 }\nfn main() { _ := pick_mod() }", "cannot infer type arguments for generic function 'pick_mod'"),
        ("fn id<T>(x: T) -> T { x } fn main() { f := id }", "generic function 'id' requires explicit type arguments"),
        ("import .library.T\nfn main() {}", "is private"),
        ("import .library.Missing\nfn main() {}", "module has no declaration 'Missing'"),
        ("import std.json.Missing\nfn main() {}", "module has no declaration 'Missing'"),
        ("import std.Map\nfn main() { mut m := Map::new(); _ := m.len() }", "cannot infer type arguments for 'Map::new'"),
    ]
}
fn identical_builds(compiler: string, source: string, work: string) -> bool {
    mut result := harness.empty_output()
    host := harness.target_name(harness.host_id())
    for target in harness.targets() {
        image := work + "/compare-" + target
        mut reference: []u8 = []
        rounds := if target == host { 4 } else { 2 }
        for i in 0..rounds {
            workers := if i == 0 || i == 3 { "1" } else { "4" }
            mut args: []string = ["build", source.clone(), "--target", target.clone(), "--jobs", workers, "-o", image.clone()]
            if i >= 2 { args.push("--incremental") }
            if !harness.run_checked_timeout(compiler, args, work, 0, false, 120000, &mut result) { return false }
            data := sys.read_u8(image)
            if !data.ok { return false }
            if i == 0 { reference = data.value }
            else if !bytes.equal(&reference, &data.value) { return harness.fail("generic images differ for " + target) }
        }
    }
    true
}

fn rotating_arguments(count: i32) -> string {
    mut declarations := ""; mut parameters := ""; mut rotated := ""; mut arguments := ""
    for i in 0..count {
        declarations += "struct Item" + i.str() + " {}\n"
        if i > 0 { parameters += ","; rotated += ","; arguments += "," }
        parameters += "T" + i.str(); rotated += "T" + ((i + 1) % count).str(); arguments += "Item" + i.str()
    }
    declarations + "fn rotate<" + parameters + ">(n:i32)->i32 { if n == 0 { return 42 }; rotate<" +
        rotated + ">(n-1) }\nfn main() { print(rotate<" + arguments + ">(2)) }\n"
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    fixtures := cli.root + "/tests/fixtures/generics/"
    library := sys.read_text(fixtures + "library.ddr")
    if !library.ok || !sys.write_text(work + "/library.ddr", library.value).ok { return false }
    if !sys.write_text(work + "/other.ddr", "pub struct Item { n: i32 }\n").ok { return false }
    cases := invalid_cases()
    if !identical_builds(cli.compiler, fixtures + "main.ddr", work) ||
        !harness.run_specialization_matrix(cli.compiler, fixtures + "main.ddr", work, "42\n") ||
        !harness.check_rejected_specializations(cli.compiler, work, &cases) { return false }
    path := work + "/edit.ddr"; image := work + "/edit"
    mut output := harness.empty_output()
    mut chain := "fn f0<T>() -> i32 { 42 }\n"
    for i in 1..71 { chain += "fn f" + i.str() + "<T>() -> i32 { f" + (i - 1).str() + "<T>() }\n" }
    chain += "fn main() { print(f70<i32>()) }\n"
    if !sys.write_text(path, chain).ok ||
       !harness.run_checked_timeout(cli.compiler, ["run", path.clone(), "-o", image.clone()], work, 0, false, 120000, &mut output) ||
       !harness.stdout_is(&output, "42\n", "finite generic call chain") { return false }
    if !sys.write_text(path, rotating_arguments(67)).ok ||
       !harness.run_checked_timeout(cli.compiler, ["run", path.clone(), "-o", image.clone()], work, 0, false, 120000, &mut output) ||
       !harness.stdout_is(&output, "42\n", "finite cycle of generic arguments") { return false }
    for n in [19, 42] {
        code := "fn answer<T>(x: T) -> i32 { " + n.str() + " } fn main() { print(answer<bool>(true)) }"
        if !sys.write_text(path, code).ok ||
            !harness.run_checked_timeout(cli.compiler, ["run", path.clone(), "--incremental", "--jobs", "4", "-o", image.clone()], work, 0, false, 120000, &mut output) ||
            !harness.stdout_is(&output, n.str() + "\n", "edited generic function") { return false }
    }
    inferred_src := work + "/inferred.ddr"
    inferred_code := "import std.array as array\n" +
        "import std.cmp as cmp\n" +
        "struct Box<T> { val: T }\n" +
        "fn id<T>(move x: T) -> T { x }\n" +
        "fn wrap<T>(move x: T) -> Box<T> { Box<T> { val: x } }\n" +
        "fn outer<T>(move x: T) -> Box<T> { wrap(move x) }\n" +
        "fn first_of<T: Clone>(items: &[]T) -> T { items[0].clone() }\n" +
        "fn from_default<T: Default>() -> T { T::default() }\n" +
        "fn pair_len<A, B>(a: &[]A, b: &[]B) -> i32 { a.len + b.len }\n" +
        "fn main() {\n" +
        "    mut nums: []i32 = [1, 2, 3]\n" +
        "    words: []string = [\"a\", \"b\"]\n" +
        "    array.reverse(&mut nums)\n" +
        "    assert(nums[0] == 3 && nums[2] == 1)\n" +
        "    assert(array.contains(&nums, 2) && !array.contains(&nums, 9))\n" +
        "    assert(array.index_of(&nums, 1).unwrap_or(-1) == 2)\n" +
        "    assert(cmp.min(10, 4) == 4 && cmp.max(i64(7), i64(12)) == 12)\n" +
        "    bx := outer(id(Box<i32> { val: 42 }))\n" +
        "    assert(bx.val.val == 42)\n" +
        "    def: i32 = from_default()\n" +
        "    assert(def == 0 && first_of(&nums) == 3 && pair_len(&nums, &words) == 5)\n" +
        "    print(42)\n" +
        "}\n"
    if !sys.write_text(inferred_src, inferred_code).ok ||
        !harness.run_specialization_matrix(cli.compiler, inferred_src, work, "42\n") { return false }
    direct_src := work + "/direct_imports.ddr"
    direct_code := "import std.Map\n" +
        "import std.Map as HashMap\n" +
        "import std.Set as IntSet\n" +
        "import std.json.Doc\n" +
        "import std.alloc.Pool\n" +
        "import .library.Box\n" +
        "import .library.Item\n" +
        "fn mk_map() -> HashMap<string, i32> { HashMap::new() }\n" +
        "fn doc_val(d: &Doc) -> i32 { if d.ok { i32(d.get_i64(d.root, \"n\").unwrap_or(0)) } else { 0 } }\n" +
        "fn main() {\n" +
        "    mut m: Map<string, i32> = Map::new()\n" +
        "    m.put(\"a\", 10)\n" +
        "    mut hm := mk_map()\n" +
        "    hm.put(\"b\", 2)\n" +
        "    mut s: IntSet<i32> = IntSet::new()\n" +
        "    _ := s.insert(5)\n" +
        "    b := Box::new(8)\n" +
        "    mut p: Pool<i32> = Pool::new()\n" +
        "    pid := p.insert(4)\n" +
        "    d := Doc::parse_text(\"{\\\"n\\\":10}\")\n" +
        "    mut it := Item { n: 0 }\n" +
        "    if it.n == 0 { it = Item { n: 3 } }\n" +
        "    total := m.get_or(\"a\", 0) + hm.get_or(\"b\", 0) + (if s.contains(5) { 5 } else { 0 }) + b.unwrap() + p.at(pid) + doc_val(&d) + it.n\n" +
        "    assert(total == 42)\n" +
        "    print(total)\n" +
        "}\n"
    if !sys.write_text(direct_src, direct_code).ok ||
        !harness.run_specialization_matrix(cli.compiler, direct_src, work, "42\n") { return false }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-generics-")
    if !tmp.ok { return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
