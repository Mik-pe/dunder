capability process, filesystem

import .harness as harness
import .native_probe as native
import .ownership_probe as probe
import .ownership_probe_cases as cases
import .probe_cli as cli
import std.fs as fs
import sys

fn workers(run: &probe.Run, target: string) -> []i32 {
    if target == "arm64-macos" && target == run.host { [1, 4] } else { [1] }
}

fn check_programs(run: &mut probe.Run, fixtures: string, inline_replace: bool, modes: &[][]string) -> bool {
    mut programs: [](string, string) = [("partial", "partial moves ok\n"), ("replace", "replace ok\n"), ("cleanup", "partial cleanup ok\n")]
    if inline_replace { programs.push(("inline", "inline replace ok\n")) }
    clones: []string = ["array_clone_calls", "record_clone_calls"]
    retains: []string = ["retain_calls"]
    mut result := harness.empty_output()
    root := run.root.clone()
    for program in move programs {
        (name, expected) := program
        source := f"{fixtures}/{name}.ddr"
        for target in harness.targets() {
            for policy in modes {
                for jobs in workers(&run, target) {
                    image := f"{run.work}/{name}-{target}-{run.builds}"
                    mut flags := probe.options(target, jobs, &policy)
                    flags.push("--runtime-profile")
                    if !run.build(source, image, &flags, root) { return false }
                    if !run.runners.can_run(target) { continue }
                    if !run.execute(target, image, [], 0, expected, &mut result) { return false }
                    record := probe.profile(&result)
                    if !record.ok || (name != "inline" && !probe.zero(&record, &clones)) ||
                       ((policy.len == 0 || name == "cleanup" || name == "inline") && !probe.zero(&record, &retains)) ||
                       (name == "cleanup" && !probe.bounded_reuse(&record, 10000)) { return false }
                }
            }
        }
    }
    true
}

fn check_sources(run: &mut probe.Run, modes: &[][]string) -> bool {
    types := cases.partial_types()
    for entry in move cases.partial_rejections() {
        (name, body, message) := entry
        source := f"{run.work}/invalid-{name}.ddr"
        if !probe.put(source, types + body + "\n") { return false }
        for target in harness.targets() {
            jobs := workers(&run, target)
            if !probe.checked_rejection(&mut run, source, message, target, &jobs, &modes) { return false }
        }
    }
    true
}

fn check_bounds(run: &mut probe.Run, modes: &[][]string) -> bool {
    source := run.work + "/bounds.ddr"
    program := "fn index()->i32{print(1);-1} fn fresh()->string{print(2);42.str()} " +
        "fn main(){mut v:[]string=[\"old\"];_:=replace(&mut v[index()],fresh());print(3)}\n"
    if !probe.put(source, program) { return false }
    root := run.root.clone()
    mut result := harness.empty_output()
    for target in harness.targets() {
        for policy in modes {
            for jobs in workers(&run, target) {
                image := f"{run.work}/bounds-{run.builds}"
                flags := probe.options(target, jobs, &policy)
                if !run.build(source, image, &flags, root) { return false }
                if run.runners.can_run(target) && !run.execute(target, image, [], 103, "1\n", &mut result) { return false }
            }
        }
    }
    true
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--runner"), cli.flag("--inline-replace")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_partial_moves COMPILER [--runner TARGET=COMMAND] [--inline-replace]")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    temp := fs.temp_dir("dunder-partial-moves-")
    if !temp.ok { _ := harness.fail("cannot create partial move test directory"); return 1 }
    defer { _ := fs.remove_all(temp.value) }
    work := probe.absolute_work(temp.value)
    if work.len == 0 { return 1 }
    mut run := probe.open(compiler, work, &args.all("--runner"))
    if !run.ready() { return 2 }
    fixtures := run.root + "/tests/fixtures/partial_moves"
    modes: [][]string = [[], native.direct_flags()]
    if !check_programs(&mut run, fixtures, args.has("--inline-replace"), &modes) ||
       !check_sources(&mut run, &modes) || !check_bounds(&mut run, &modes) { return 1 }
    print(f"partial moves: {run.builds} native images, {run.executions} target executions, {run.rejections} rejected contracts; field joins/backedges, replacement identity, bounded cleanup and diagnostic/publication parity passed")
    0
}
