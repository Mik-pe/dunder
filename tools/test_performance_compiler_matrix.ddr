capability filesystem, unsafe

import .benchmark_process as proc
import .compiler_matrix_runner as matrix
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.text as text
import sys

fn forbid_clock() -> i64 {
    assert(false)
    0
}

fn synthetic_clock() -> i64 {
    unsafe {
        state := static_bytes("native", 16)
        reads := load_i64(state)
        store_i64(state, reads + 1)
        assert(reads <= 1)
        10000000 + 3000000 * reads
    }
}

fn last_record(root: string) -> json.Doc {
    file := sys.read_text(root + "/commands.jsonl")
    assert(file.ok)
    lines := text.split(text.trim(file.value), "\n")
    doc := json.Doc::parse_text(lines[lines.len - 1])
    assert(doc.ok)
    doc
}

fn process_contracts(root: string) {
    mut runner := matrix.new(root, root, root, true)
    runner.clock = forbid_clock
    mut out := matrix.empty_capture()
    assert(runner.run(["/usr/bin/printf", "42\n"], "test dry", false, "42\n", true, &mut out))
    assert(bytes.equals_text(&out.stdout, 0, out.stdout.len, "42\n"))
    assert(out.elapsed == 0 && out.rss == 0)
    initial := last_record(root)
    assert(!initial.get_bool(initial.root, "measured").value)
    assert(initial.kind(initial.field(initial.root, "elapsed_ms")) == .Null)
    assert(initial.kind(initial.field(initial.root, "max_rss_bytes")) == .Null)
    assert(initial.get_i64(initial.root, "exit_code").value == 0)

    assert(!runner.run(["/usr/bin/printf", "7\n"], "wrong output", false, "8\n", true, &mut out))
    wrong := last_record(root)
    assert(wrong.get_str(wrong.root, "stdout").value == "7\n")
    assert(text.find(runner.error, "command/output failure") >= 0)

    assert(!runner.run([root + "/missing"], "failed launch", false, "", false, &mut out))
    missing := last_record(root)
    assert(missing.kind(missing.field(missing.root, "exit_code")) == .Null)
    assert(text.find(missing.get_str(missing.root, "error").value, "FileNotFoundError") >= 0)

    runner.timeout = 25
    assert(!runner.run(["/bin/sleep", "5"], "reap timed out process", false, "", false, &mut out))
    timeout := last_record(root)
    assert(timeout.get_i64(timeout.root, "exit_code").value == -9)
    assert(text.find(timeout.get_str(timeout.root, "error").value, "TimeoutError") >= 0)

    runner.timeout = 5000
    assert(runner.run(["/usr/bin/printf", "\\377\\342\\202!"], "lossy UTF-8", false, "", false, &mut out))
    malformed := last_record(root)
    assert(malformed.get_str(malformed.root, "stdout").value == "��!")
}

fn measured_contract(root: string) {
    mut runner := matrix.new(root, root, root, false)
    runner.clock = synthetic_clock
    mut out := matrix.empty_capture()
    assert(runner.run(["/usr/bin/printf", "sample"], "synthetic clock and wait4 byte fields", true, "sample", true, &mut out))
    assert(out.elapsed == 3000000 && out.rss > 0)
    assert(proc.rss_bytes(7) == (if target_is("macos") { 7 } else { 7168 }))
    doc := last_record(root)
    assert(doc.get_bool(doc.root, "measured").value)
    assert(doc.get_f64(doc.root, "elapsed_ms").value == 3.0)
    assert(doc.get_i64(doc.root, "max_rss_bytes").value == out.rss)
}

fn row(variant: string, round: i32, position: i32, elapsed_ms: i64) -> matrix.Row {
    matrix.Row { operation: "build", name: "hello", variant: variant.clone(), round: round,
                 position: position, elapsed: elapsed_ms * 1000000, rss: 100 + i64(round), sha256: "", bytes: 0 }
}

fn statistics() {
    mut counts: [i32; 27] = [0; 27]
    for round in 0..30 {
        order := matrix.order(3, round)
        assert(order[0] != order[1] && order[1] != order[2] && order[0] != order[2])
        code := order[0] * 9 + order[1] * 3 + order[2]
        counts[code] += 1
    }
    mut permutations := 0
    for count in counts {
        if count > 0 { assert(count == 5); permutations += 1 }
    }
    assert(permutations == 6)
    variants: []string = ["baseline", "candidate"]
    rows: []matrix.Row = [row("baseline", 0, 0, 1), row("candidate", 0, 1, 2), row("candidate", 1, 0, 5), row("baseline", 1, 1, 10)]
    assert(matrix.end_rounds(&rows, 0, 2, &variants))
    assert(!matrix.end_rounds(&rows, 0, 1, &variants))
    mut summaries: []matrix.Summary = []
    matrix.append_summaries(&rows, 0, &variants, &mut summaries)
    candidate := &summaries[1]
    assert(candidate.paired_ratio_median == 1.25)
    assert(candidate.paired_ratio_p95 == 2.0)
    assert(candidate.median_over_reference == 3.5 / 5.5)
    assert(candidate.p95_ms == 5.0 && candidate.max_rss_bytes == 101)
}

fn main() -> i32 {
    temp := fs.temp_dir("compiler-matrix-tests-")
    assert(temp.ok)
    defer { _ := fs.remove_all(temp.value) }
    process_contracts(temp.value)
    measured_contract(temp.value)
    statistics()
    print("compiler matrix runner ok")
    0
}
