capability process, filesystem

import .harness as harness
import .release_fixture as fixture
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn asset_names() -> []string {
    ["arm64-linux.gz", "arm64-linux.sha256", "arm64-macos.gz", "arm64-macos.sha256",
     "release.txt", "x86_64-linux.gz", "x86_64-linux.sha256"]
}

fn has(args: &[]string, value: string) -> bool {
    for arg in args { if arg == value { return true } }
    false
}

fn option_value(args: &[]string, name: string) -> string {
    for i in 0..(args.len - 1) {
        if args[i] == name { return args[i + 1].clone() }
    }
    ""
}

fn join_args(args: &[]string) -> string {
    mut output := ""
    for i in 0..args.len {
        if i > 0 { output = output + " " }
        output = output + args[i]
    }
    output
}

fn git_command(args: []string) -> process.Command {
    mut cmd := process.Command::new("git", args.clone())
    cmd.set_env("GIT_ALLOW_PROTOCOL", "file")
    cmd.set_timeout(90000)
    cmd
}

fn execute(cmd: &process.Command, status: i32, output: &mut process.Output) -> bool {
    result := cmd.exec()
    if !result.ok || result.timed_out || result.signal != 0 || result.code != status {
        return harness.fail(f"expected command status {status}, got {result.code} (signal {result.signal}, timeout {result.timed_out})\n{result.stdout_text()}\n{result.stderr_text()}")
    }
    output = result
    true
}

fn git_for(repo: string, tail: []string) -> process.Command {
    mut args: []string = ["-C", repo.clone()]
    for arg in tail { args.push(arg.clone()) }
    git_command(args)
}

fn git_run(repo: string, args: []string) -> bool {
    mut result := harness.empty_output()
    cmd := git_for(repo, args)
    execute(&cmd, 0, &mut result)
}

fn git_text(repo: string, args: []string) -> string {
    mut result := harness.empty_output()
    cmd := git_for(repo, args)
    if !execute(&cmd, 0, &mut result) { return "" }
    text.trim(result.stdout_text())
}

fn api(work: string, args: &[]string) -> bool {
    mut path := ""
    for arg in args {
        if text.starts_with(arg, "repos/Mik-pe/dunder/") { path = arg.clone(); break }
    }
    remote := work + "/remote"
    matching := "repos/Mik-pe/dunder/git/matching-refs/tags/"
    tag_info := "repos/Mik-pe/dunder/git/tags/"
    if text.starts_with(path, matching) {
        ref := "refs/tags/" + path[matching.len..path.len]
        command := git_for(remote, ["show-ref", "--verify", "--quiet", ref.clone()])
        result := command.exec()
        if result.ok && !result.timed_out && result.signal == 0 && result.code == 1 { return true }
        if !result.succeeded() { return harness.fail(f"cannot list tagged commit {ref}\n{result.stderr_text()}") }
        kind := git_text(remote, ["cat-file", "-t", ref.clone()])
        sha := git_text(remote, ["rev-parse", ref.clone()])
        if kind.len == 0 || sha.len == 0 { return false }
        print(kind + " " + sha)
    } else if text.starts_with(path, tag_info) {
        object := git_text(remote, ["cat-file", "-p", path[tag_info.len..path.len]])
        lines := harness.lines(object)
        if lines.len < 2 || !text.starts_with(lines[0], "object ") || !text.starts_with(lines[1], "type ") {
            return harness.fail(f"invalid annotated tag: {object}")
        }
        print(lines[1][5..lines[1].len] + " " + lines[0][7..lines[0].len])
    } else if path == "repos/Mik-pe/dunder/releases?per_page=100" {
        state := work + "/state"
        if sys.metadata(state).ok {
            content := sys.read_text(state)
            if !content.ok { return harness.fail("cannot read release fixture state") }
            print(content.value)
        }
    } else {
        return harness.fail(f"unexpected GitHub API request: {path}")
    }
    true
}

fn exact_assets(dir: string) -> bool {
    list := fs.list_dir(dir)
    expected := asset_names()
    if list.is_err() { return harness.fail(f"unexpected release assets at {dir}") }
    entries := list.unwrap()
    if entries.len != expected.len { return harness.fail(f"unexpected release assets at {dir}") }
    for i in 0..expected.len {
        if entries[i] != expected[i] { return harness.fail(f"unexpected release asset: {entries[i]}") }
    }
    true
}

fn release_action(work: string, args: &[]string) -> i32 {
    if args.len < 3 || option_value(&args, "--repo") != "Mik-pe/dunder" { return 1 }
    action := args[1].clone()
    tag := args[2].clone()
    state := work + "/state"
    assets := work + "/assets"
    record := sys.read_text(state)
    if action == "create" || action == "upload" || action == "edit" {
        if !sys.append_text(work + "/mutations", join_args(&args) + "\n").ok { return 1 }
    }
    if action == "create" {
        if !has(&args, "--draft") || !has(&args, "--verify-tag") || sys.metadata(state).ok { return 1 }
        commit := git_text(work + "/remote", ["rev-parse", "refs/tags/" + tag + "^{commit}"])
        if commit.len == 0 || commit != option_value(&args, "--target") || !sys.write_text(state, "draft").ok { return 1 }
    } else if action == "view" {
        if option_value(&args, "--json") == "isDraft" {
            if !record.ok { return 1 }
            print(if record.value == "draft" { "true" } else { "false" })
        } else {
            list := fs.list_dir(assets)
            if list.is_err() { return 1 }
            for name in list.unwrap() {
                print(name + " sha256:" + harness.sha256_file_hex(assets + "/" + name))
            }
        }
    } else if action == "upload" {
        if args.len < 4 || !record.ok || record.value != "draft" { return 1 }
        name := args[3].clone()
        known := asset_names()
        if !has(&known, name) { return 1 }
        destination := assets + "/" + name
        if !has(&args, "--clobber") && sys.metadata(destination).ok { return 1 }
        interrupted := work + "/interrupt"
        if name == "arm64-macos.gz" && sys.metadata(interrupted).ok {
            if !sys.write_text(destination, "").ok || !sys.remove_file(interrupted).ok { _ := harness.fail("cannot simulate interrupted upload") }
            return 1
        }
        if !fixture.copy_file(name, destination) { return 1 }
    } else if action == "download" {
        destination := option_value(&args, "--dir")
        list := fs.list_dir(assets)
        if list.is_err() || destination.len == 0 { return 1 }
        for name in list.unwrap() {
            if !fixture.copy_file(assets + "/" + name, destination + "/" + name) { return 1 }
        }
    } else if action == "edit" {
        if !record.ok || record.value != "draft" || !has(&args, "--draft=false") ||
           !exact_assets(assets) || !sys.write_text(state, "published").ok { return 1 }
    } else {
        _ := harness.fail(f"unexpected GitHub release action: {action}")
        return 1
    }
    0
}

fn github_fixture() -> i32 {
    work := process.env("DUNDER_TEST_RELEASE").unwrap_or("")
    if work.len == 0 || sys.arg_count() < 2 { return 1 }
    mut args: []string = []
    for i in 1..sys.arg_count() { args.push(sys.arg(i)) }
    if args[0] == "api" { return if api(work, &args) { 0 } else { 1 } }
    if args[0] == "release" { return release_action(work, &args) }
    _ := harness.fail("unexpected GitHub command")
    1
}

fn compiler_version(repo: string) -> string {
    source := sys.read_text(repo + "/selfhost/driver/cli.ddr")
    if !source.ok { return "" }
    at := text.find(source.value, "fn compiler_version").unwrap_or(-1)
    if at < 0 { return "" }
    declaration := source.value[at..source.value.len]
    chunks := text.split(declaration, "\"")
    if chunks.len < 3 { return "" }
    chunks[1].clone()
}

fn manifest_value(manifest: string, key: string) -> string {
    prefix := key + "="
    mut value := ""
    for line in move harness.lines(manifest) {
        if text.starts_with(line, prefix) { value = line[prefix.len..line.len] }
    }
    value
}

fn check_package(package: string, version: string, commit: string) -> bool {
    if !exact_assets(package) { return false }
    manifest := sys.read_text(package + "/release.txt")
    if !manifest.ok || manifest_value(manifest.value, "version") != version || manifest_value(manifest.value, "commit") != commit {
        return harness.fail("local release manifest does not describe the pinned revision")
    }
    mut out := harness.empty_output()
    for host in harness.targets() {
        archive := package + "/" + host + ".gz"
        compressed := harness.sha256_file_hex(archive)
        if compressed.len == 0 || !harness.run_checked("gzip", ["-dc", archive.clone()], "", 0, false, &mut out) { return false }
        expanded := harness.sha256_bytes_hex(&out.stdout)
        checksum := sys.read_text(package + "/" + host + ".sha256")
        if manifest_value(manifest.value, host + ".gz.sha256") != compressed ||
           manifest_value(manifest.value, host + ".sha256") != expanded ||
           !checksum.ok || checksum.value != compressed + "  " + host + ".gz\n" {
            return harness.fail(f"incorrect manifest hashes for {host}")
        }
    }
    true
}

fn release_script(repo: string, work: string, package: string, tag: string, publish: bool, expected: i32) -> bool {
    mut args: []string = [tag.clone(), "--outdir", package.clone()]
    if publish { args.push("--publish") }
    mut cmd := process.Command::new(repo + "/tools/release.sh", move args)
    cmd.set_env("DUNDER_TEST_RELEASE", work.clone())
    cmd.set_env("GIT_ALLOW_PROTOCOL", "file")
    cmd.set_env("PATH", work + ":" + process.env_or("PATH", "/usr/bin:/bin"))
    cmd.set_timeout(180000)
    mut out := harness.empty_output()
    execute(&cmd, expected, &mut out)
}

fn same_assets(package: string, assets: string) -> bool {
    for name in asset_names() {
        published := sys.read_u8(assets + "/" + name)
        if !published.ok || !fixture.same_bytes(package + "/" + name, &published.value) { return false }
    }
    true
}

fn run_suite(root: string, work: string, executable: string) -> bool {
    repo := work + "/repo"
    remote := work + "/remote"
    assets := work + "/assets"
    if !fs.mkdir_all(assets).ok || !fs.symlink(executable, work + "/gh").ok { return harness.fail("cannot prepare offline release fixture") }
    mut out := harness.empty_output()
    init := git_command(["init", "--bare", "-q", remote.clone()])
    clone := git_command(["clone", "--shared", "--no-checkout", "--no-tags", "-q", root.clone(), repo.clone()])
    if !execute(&init, 0, &mut out) || !execute(&clone, 0, &mut out) { return false }
    commit := git_text(root, ["rev-parse", "HEAD"])
    if commit.len == 0 ||
       !git_run(repo, ["checkout", "--detach", "-q", commit.clone()]) ||
       !git_run(repo, ["config", "user.name", "Release Fixture"]) ||
       !git_run(repo, ["config", "user.email", "fixture@invalid.example"]) ||
       !git_run(repo, ["config", "url." + fixture.file_url(remote) + ".insteadOf", "https://github.com/Mik-pe/dunder.git"]) ||
       !fixture.copy_file(root + "/tools/release.sh", repo + "/tools/release.sh") ||
       !sys.make_executable(repo + "/tools/release.sh").ok { return false }
    version := compiler_version(repo)
    if version.len == 0 { return harness.fail("cannot read release fixture compiler version") }
    tag := "v" + version
    package := work + "/local package"
    mutations := work + "/mutations"
    state := work + "/state"
    if !release_script(repo, work, package, tag + "-wrong", false, 1) || sys.metadata(package + "/release.txt").ok ||
       !release_script(repo, work, package, tag, false, 0) || sys.metadata(mutations).ok ||
       !check_package(package, version, commit) { return false }
    if !git_run(repo, ["tag", "-a", tag.clone(), "-m", "Test release", commit.clone()]) ||
       !git_run(repo, ["commit", "--allow-empty", "-qm", "Later local commit"]) ||
       !sys.write_text(repo + "/selfhost/driver/cli.ddr", "this uncommitted file must never be packaged").ok ||
       !sys.write_text(work + "/interrupt", "").ok || !release_script(repo, work, package, tag, true, 1) ||
       sys.read_text(state).value != "draft" { return harness.fail("interrupted release did not leave a draft") }
    ref := "refs/tags/" + tag
    local_tag := git_text(repo, ["rev-parse", ref.clone()])
    if local_tag.len == 0 || git_text(remote, ["rev-parse", ref.clone()]) != local_tag ||
       !release_script(repo, work, package, tag, true, 0) || sys.read_text(state).value != "published" ||
       !same_assets(package, assets) { return harness.fail("draft did not resume to a verified publication") }
    before := sys.read_u8(mutations)
    if !before.ok || !release_script(repo, work, package, tag, true, 0) ||
       !sys.write_text(assets + "/release.txt", "changed remotely").ok || !release_script(repo, work, package, tag, true, 1) ||
       !fixture.same_bytes(mutations, &before.value) { return false }
    print("PASS release packaging, draft recovery, published retry and remote mismatch")
    true
}

fn main() -> i32 {
    if harness.basename(sys.arg(0)) == "gh" { return github_fixture() }
    root := harness.find_root()
    executable := fs.realpath(sys.arg(0))
    if root.len == 0 || !executable.ok { _ := harness.fail("cannot locate release test executable or repository"); return 2 }
    temp := fs.temp_dir("dunder-release-test-")
    if !temp.ok { _ := harness.fail("cannot create release test directory"); return 1 }
    work := temp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(root, work, executable.value) { 0 } else { 1 }
}
