capability process, filesystem, stdio

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.text as text
import sys

fn u16_at(raw: &[]u8, off: i32) -> i32 {
    i32(bytes.u16_le(&raw, off))
}

fn u32_at(raw: &[]u8, off: i32) -> i64 {
    i64(bytes.u32_le(&raw, off))
}

fn has_ascii(raw: &[]u8, start: i32, limit: i32, needle: string) -> bool {
    if needle.len == 0 { return true }
    mut end := limit
    if end > raw.len { end = raw.len }
    if start < 0 || start + needle.len > end { return false }
    for pos in start..(end - needle.len + 1) {
        mut match_ok := true
        for k in 0..needle.len {
            if i32(raw[pos + k]) != needle[k] { match_ok = false; break }
        }
        if match_ok { return true }
    }
    false
}

fn rva_to_file(raw: &[]u8, sec_table_off: i32, num_sec: i32, rva: i64) -> i32 {
    for s in 0..num_sec {
        sh := sec_table_off + s * 40
        vsize := u32_at(&raw, sh + 8)
        vrva := u32_at(&raw, sh + 12)
        raw_sz := u32_at(&raw, sh + 16)
        raw_off := u32_at(&raw, sh + 20)
        mut span := vsize
        if raw_sz > span { span = raw_sz }
        if rva >= vrva && rva < vrva + span {
            return i32(raw_off + (rva - vrva))
        }
    }
    -1
}

fn read_cstr(raw: &[]u8, off: i32) -> string {
    if off < 0 || off >= raw.len { return "" }
    mut end := off
    while end < raw.len && raw[end] != 0 { end += 1 }
    decoded := bytes.decode_range(&raw, off, end)
    if decoded.ok { decoded.value } else { "" }
}

fn verify_pe_binary(path: string, expect_msvcrt: bool, expect_k32_extra: string, expect_data: bool) -> bool {
    res := sys.read_bytes(path)
    if res.is_err() { return harness.fail("failed reading PE binary: " + path) }
    raw := res.unwrap()
    if raw.len < 512 { return harness.fail("PE binary too small") }
    if raw[0] != u8(0x4d) || raw[1] != u8(0x5a) { return harness.fail("missing MZ header") }

    lfanew := i32(u32_at(&raw, 60))
    if lfanew != 128 || lfanew + 24 + 240 > raw.len { return harness.fail("invalid e_lfanew") }
    if raw[lfanew] != u8(0x50) || raw[lfanew + 1] != u8(0x45) || raw[lfanew + 2] != 0 || raw[lfanew + 3] != 0 {
        return harness.fail("missing PE signature")
    }
    if u16_at(&raw, lfanew + 4) != 0x8664 { return harness.fail("expected AMD64 Machine 0x8664") }
    num_sec := u16_at(&raw, lfanew + 6)
    if num_sec < 2 || num_sec > 3 { return harness.fail("unexpected PE section count: " + num_sec.str()) }
    if u16_at(&raw, lfanew + 20) != 240 { return harness.fail("expected 240-byte PE32+ optional header") }

    opt := lfanew + 24
    if u16_at(&raw, opt + 0) != 0x020B { return harness.fail("expected PE32+ Magic 0x020B") }
    if u32_at(&raw, opt + 16) != 4096 { return harness.fail("expected AddressOfEntryPoint 0x1000") }
    if u32_at(&raw, opt + 32) != 4096 { return harness.fail("expected SectionAlignment 0x1000") }
    if u32_at(&raw, opt + 36) != 512 { return harness.fail("expected FileAlignment 0x200") }
    if u32_at(&raw, opt + 60) != 512 { return harness.fail("expected SizeOfHeaders 0x200") }
    if u16_at(&raw, opt + 68) != 3 { return harness.fail("expected Console Subsystem 3") }

    imp_rva := u32_at(&raw, opt + 120)
    imp_sz := u32_at(&raw, opt + 124)
    iat_rva := u32_at(&raw, opt + 208)
    iat_sz := u32_at(&raw, opt + 212)
    if imp_rva == 0 || imp_sz < 40 || iat_rva == 0 || iat_sz < 40 {
        return harness.fail("missing Import Directory or IAT")
    }

    sec_off := opt + 240
    if !has_ascii(&raw, sec_off, sec_off + 8, ".text") { return harness.fail("missing .text section") }
    if !has_ascii(&raw, sec_off + 40, sec_off + 48, ".rdata") { return harness.fail("missing .rdata section") }
    if expect_data {
        if num_sec != 3 || !has_ascii(&raw, sec_off + 80, sec_off + 88, ".data") {
            return harness.fail("missing .data section for static_bytes")
        }
        if u32_at(&raw, sec_off + 80 + 8) < 64 {
            return harness.fail("unexpected .data virtual size for static_bytes(\"windows\", 64)")
        }
    }
    text_vsize := i32(u32_at(&raw, sec_off + 8))
    text_rva := i32(u32_at(&raw, sec_off + 12))
    text_raw_off := i32(u32_at(&raw, sec_off + 20))
    rdata_rva := u32_at(&raw, sec_off + 40 + 12)
    if text_rva != 4096 || rdata_rva % 4096 != 0 { return harness.fail("unaligned PE sections") }

    imp_off := rva_to_file(&raw, sec_off, num_sec, imp_rva)
    if imp_off < 0 { return harness.fail("Import Directory RVA unmapped") }

    mut saw_k32 := false
    mut saw_msvcrt := false
    mut saw_va := false
    mut saw_gsh := false
    mut saw_wf := false
    mut saw_ep := false
    mut saw_puts := false
    mut saw_extra := expect_k32_extra == ""
    mut desc := imp_off
    while desc + 20 <= raw.len {
        ilt_rva := u32_at(&raw, desc + 0)
        name_rva := u32_at(&raw, desc + 12)
        first_thunk := u32_at(&raw, desc + 16)
        if ilt_rva == 0 && name_rva == 0 && first_thunk == 0 { break }
        dll := read_cstr(&raw, rva_to_file(&raw, sec_off, num_sec, name_rva))
        if dll == "kernel32.dll" { saw_k32 = true }
        if dll == "msvcrt.dll" { saw_msvcrt = true }
        mut ilt_off := rva_to_file(&raw, sec_off, num_sec, ilt_rva)
        while ilt_off >= 0 && ilt_off + 8 <= raw.len {
            hn_rva := u32_at(&raw, ilt_off)
            if hn_rva == 0 { break }
            hn_off := rva_to_file(&raw, sec_off, num_sec, hn_rva)
            if hn_off < 0 { return harness.fail("unmapped Hint/Name RVA") }
            sym := read_cstr(&raw, hn_off + 2)
            if dll == "kernel32.dll" {
                if sym == "VirtualAlloc" { saw_va = true }
                if sym == "GetStdHandle" { saw_gsh = true }
                if sym == "WriteFile" { saw_wf = true }
                if sym == "ExitProcess" { saw_ep = true }
                if expect_k32_extra != "" && sym == expect_k32_extra { saw_extra = true }
            } else if dll == "msvcrt.dll" && sym == "puts" {
                saw_puts = true
            }
            ilt_off += 8
        }
        desc += 20
    }
    if !saw_k32 || !saw_va || !saw_gsh || !saw_wf || !saw_ep {
        return harness.fail("PE missing expected kernel32.dll runtime imports")
    }
    if expect_msvcrt && (!saw_msvcrt || !saw_puts) {
        return harness.fail("PE missing expected msvcrt.dll puts import")
    }
    if !saw_extra {
        return harness.fail("PE missing extra kernel32 import: " + expect_k32_extra)
    }

    // Verify all call [rip + disp32] (FF 15) in prelude/syscalls point inside IAT [iat_rva, iat_rva + iat_sz)
    mut ff15_hits := 0
    for pos in 0..(text_vsize - 6) {
        b0 := raw[text_raw_off + pos]
        b1 := raw[text_raw_off + pos + 1]
        if b0 == u8(0xff) && b1 == u8(0x15) {
            disp := i32(u32_at(&raw, text_raw_off + pos + 2))
            if disp >= 4096 && disp < 1048576 {
                target := i64(text_rva + pos + 6) + i64(disp)
                if target >= iat_rva && target < iat_rva + iat_sz {
                    ff15_hits += 1
                }
            }
        }
    }
    if ff15_hits < 3 {
        return harness.fail("expected >= 3 RIP-relative IAT calls pointing into IAT, got " + ff15_hits.str())
    }
    true
}

fn wasi_runner_js() -> string {
    "'use strict';\n" +
    "const assert = require('node:assert/strict');\n" +
    "const fs = require('node:fs');\n" +
    "const { WASI } = require('node:wasi');\n" +
    "const buf = fs.readFileSync(process.argv[2]);\n" +
    "const expectedRc = Number(process.argv[3] || '0');\n" +
    "assert.equal(WebAssembly.validate(buf), true, 'WebAssembly.validate failed');\n" +
    "const mod = new WebAssembly.Module(buf);\n" +
    "const imps = WebAssembly.Module.imports(mod);\n" +
    "assert.ok(imps.length > 0, 'expected WASI imports');\n" +
    "for (const imp of imps) {\n" +
    "  assert.equal(imp.module, 'wasi_snapshot_preview1', 'unexpected import module: ' + imp.module);\n" +
    "}\n" +
    "const exps = WebAssembly.Module.exports(mod).map(e => e.name);\n" +
    "assert.ok(exps.includes('_start'), 'missing _start export');\n" +
    "assert.ok(exps.includes('memory'), 'missing memory export');\n" +
    "const wasi = new WASI({ version: 'preview1', returnOnExit: true });\n" +
    "const instance = new WebAssembly.Instance(mod, wasi.getImportObject());\n" +
    "const rc = wasi.start(instance);\n" +
    "assert.equal(rc, expectedRc, 'unexpected WASI exit status: ' + rc);\n"
}

fn run_sys_limit_tests(work: string) -> bool {
    sample := work + "/limit_sample.txt"
    payload := "0123456789abcdef"
    if !sys.write_text(sample, payload).ok {
        return harness.fail("failed writing limit sample")
    }
    ok_txt := sys.read_limit(sample, 16)
    if ok_txt.is_err() || ok_txt.unwrap() != payload {
        return harness.fail("sys.read_limit(16) failed")
    }
    too_big_txt := sys.read_limit(sample, 10)
    match too_big_txt {
        .Ok(_) => { return harness.fail("expected sys.read_limit(10) to fail with TooLarge") },
        .Err(err) => {
            if err != .TooLarge { return harness.fail("expected TooLarge from sys.read_limit(10)") }
        },
    }
    ok_bytes := sys.read_bytes_limit(sample, 16)
    if ok_bytes.is_err() || ok_bytes.unwrap().len != 16 {
        return harness.fail("sys.read_bytes_limit(16) failed")
    }
    too_big_bytes := sys.read_bytes_limit(sample, 10)
    match too_big_bytes {
        .Ok(_) => { return harness.fail("expected sys.read_bytes_limit(10) to fail with TooLarge") },
        .Err(err) => {
            if err != .TooLarge { return harness.fail("expected TooLarge from sys.read_bytes_limit(10)") }
        },
    }
    def_txt := sys.read(sample)
    if def_txt.is_err() || def_txt.unwrap() != payload {
        return harness.fail("default sys.read failed")
    }
    true
}

fn run_wasi_tests(compiler: string, work: string) -> bool {
    runner := work + "/run_wasi.js"
    if !sys.write_text(runner, wasi_runner_js()).ok {
        return harness.fail("failed writing WASI runner script")
    }

    wasi_src := work + "/wasi_all.ddr"
    wasi_code := "capability unsafe\n\n" +
        "@extern(\"wasi_snapshot_preview1\", \"sched_yield\")\n" +
        "unsafe fn wasi_sched_yield() -> i32\n\n" +
        "struct Pair { a: i64, b: string }\n\n" +
        "fn target_tag() -> string {\n" +
        "    if target_is(\"wasi\") && target_is(\"wasm32\") && !target_is(\"linux\") { \"ok-wasi\" }\n" +
        "    else { \"bad-target\" }\n" +
        "}\n\n" +
        "fn main() {\n" +
        "    print(\"hello wasi\")\n" +
        "    print(i32(-42))\n" +
        "    min_i64: i64 = i64(-9223372036854775807) - i64(1)\n" +
        "    print(min_i64)\n" +
        "    print(u32(4000000000))\n" +
        "    print(u64(18446744073709551615))\n" +
        "    print(true)\n" +
        "    print(false)\n" +
        "    print('A')\n" +
        "    print('λ')\n" +
        "    print('🚀')\n" +
        "    print(f32(1.25))\n" +
        "    print(3.5)\n" +
        "    print(-2.25)\n" +
        "    print(0.0)\n" +
        "    mut nums: []i64 = [10, 20, 30]\n" +
        "    nums.push(12)\n" +
        "    mut sum: i64 = 0\n" +
        "    for v in &nums { sum += v }\n" +
        "    p := Pair { a: sum, b: \"heap-\" + target_tag() }\n" +
        "    adder := fn(x: i64) -> i64 { 100 + x }\n" +
        "    print(p.b)\n" +
        "    print(adder(p.a))\n" +
        "    print(unsafe { wasi_sched_yield() })\n" +
        "}\n"
    if !sys.write_text(wasi_src, wasi_code).ok {
        return harness.fail("failed writing wasi_all.ddr")
    }

    // Check default .wasm extension without -o
    mut build_out := harness.empty_output()
    if !harness.run_checked(compiler, ["build", wasi_src.clone(), "--target", "wasm32-wasi"], work, 0, false, &mut build_out) {
        return false
    }
    default_wasm := work + "/build/wasm32-wasi/wasi_all.wasm"
    if !sys.metadata(default_wasm).is_file {
        return harness.fail("expected default output build/wasm32-wasi/wasi_all.wasm")
    }

    mut node_out := harness.empty_output()
    if !harness.run_checked("node", ["--no-warnings", runner.clone(), default_wasm.clone(), "0"], work, 0, false, &mut node_out) {
        return false
    }
    expected := "hello wasi\n-42\n-9223372036854775808\n4000000000\n18446744073709551615\n" +
        "true\nfalse\nA\nλ\n🚀\n1.25\n3.5\n-2.25\n0\nheap-ok-wasi\n172\n0\n"
    if node_out.stdout_text() != expected {
        return harness.fail("unexpected WASI stdout:\n" + node_out.stdout_text() + "\nexpected:\n" + expected)
    }

    // Alias targets & non-zero exit status
    exit_src := work + "/wasi_exit.ddr"
    if !sys.write_text(exit_src, "fn main() -> i32 { 42 }\n").ok {
        return harness.fail("failed writing wasi_exit.ddr")
    }
    exit_wasm := work + "/wasi_exit_alias.wasm"
    if !harness.run_checked(compiler, ["build", exit_src.clone(), "--target", "wasi", "-o", exit_wasm.clone()], work, 0, false, &mut build_out) {
        return false
    }
    if !harness.run_checked("node", ["--no-warnings", runner.clone(), exit_wasm.clone(), "42"], work, 0, false, &mut node_out) {
        return false
    }
    if !harness.run_checked(compiler, ["build", exit_src, "--target", "wasm32-wasip1", "-o", work + "/wasip1.wasm"], work, 0, false, &mut build_out) {
        return false
    }

    // -g rejection on wasm32-wasi
    bad_dbg := harness.exec_cmd(compiler, ["build", wasi_src, "-g", "--target", "wasm32-wasi", "-o", work + "/bad.wasm"], work, false, 30000)
    if bad_dbg.code == 0 {
        return harness.fail("expected -g --target wasm32-wasi to fail")
    }
    true
}

fn run_windows_tests(compiler: string, work: string) -> bool {
    win_src := work + "/win_app.ddr"
    win_code := "capability unsafe\n" +
        "import std.bytes as bytes\n\n" +
        "@extern(\"c\", \"puts\")\n" +
        "unsafe fn c_puts(s: ptr) -> i32\n\n" +
        "@extern(\"kernel32.dll\", \"GetCurrentProcessId\")\n" +
        "unsafe fn win_pid() -> i32\n\n" +
        "fn main() {\n" +
        "    if target_is(\"windows\") && target_is(\"x86_64\") && !target_is(\"linux\") {\n" +
        "        buf := unsafe { static_bytes(\"windows\", 64) }\n" +
        "        _ := buf\n" +
        "        mut vals: []i64 = [10, 20, 30]\n" +
        "        vals.push(40)\n" +
        "        msg := \"hello win64\"\n" +
        "        print(msg)\n" +
        "        print(vals.len)\n" +
        "        pid := unsafe { win_pid() }\n" +
        "        _ := pid\n" +
        "        cstr := bytes.from_text(\"hi\\0\")\n" +
        "        _ := unsafe { c_puts(addr(&cstr[0])) }\n" +
        "    }\n" +
        "}\n"
    if !sys.write_text(win_src, win_code).ok {
        return harness.fail("failed writing win_app.ddr")
    }

    // Check default .exe extension without -o
    mut out := harness.empty_output()
    if !harness.run_checked(compiler, ["build", win_src.clone(), "--target", "x86_64-windows"], work, 0, false, &mut out) {
        return false
    }
    default_exe := work + "/build/x86_64-windows/win_app.exe"
    if !sys.metadata(default_exe).is_file {
        return harness.fail("expected default output build/x86_64-windows/win_app.exe")
    }
    if !verify_pe_binary(default_exe, true, "GetCurrentProcessId", true) { return false }

    // Alias target "windows" + pure Dunder binary (no explicit C externs)
    pure_src := work + "/win_pure.ddr"
    if !sys.write_text(pure_src, "fn main() { print(\"pure win64\") }\n").ok {
        return harness.fail("failed writing win_pure.ddr")
    }
    pure_exe := work + "/win_pure.exe"
    if !harness.run_checked(compiler, ["build", pure_src, "--target", "windows", "-o", pure_exe.clone()], work, 0, false, &mut out) {
        return false
    }
    if !verify_pe_binary(pure_exe, false, "", false) { return false }

    // -g rejection on x86_64-windows
    bad_dbg := harness.exec_cmd(compiler, ["build", win_src, "-g", "--target", "x86_64-windows", "-o", work + "/bad.exe"], work, false, 30000)
    if bad_dbg.code == 0 {
        return harness.fail("expected -g --target x86_64-windows to fail")
    }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if cli.extra_args.len > 0 { _ := sys.eprint("unexpected argument: " + cli.extra_args[0]); return 2 }

    tmp := fs.temp_dir("dunder-wasi-win-")
    if !tmp.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    work := tmp.value

    mut out := harness.empty_output()
    mut ok := harness.run_checked(cli.compiler, ["test", "selfhost/backend/pe.ddr"], cli.root, 0, false, &mut out)
    if ok {
        ok = harness.run_checked(cli.compiler, ["--list-targets"], cli.root, 0, false, &mut out)
        if ok {
            targets := out.stdout_text()
            if !text.contains(targets, "wasm32-wasi") || !text.contains(targets, "x86_64-windows") {
                ok = harness.fail("--list-targets missing wasm32-wasi or x86_64-windows:\n" + targets)
            }
        }
    }
    if ok { ok = run_sys_limit_tests(work) }
    if ok { ok = run_wasi_tests(cli.compiler, work) }
    if ok { ok = run_windows_tests(cli.compiler, work) }

    _ := fs.remove_all(work)
    if !ok { return 1 }
    print("PASS wasi and windows: WASI Preview 1 live execution, PE32+ image, and sys limits verified")
    0
}
