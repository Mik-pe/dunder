import .harness as harness
import std.parse as parse
import std.text as text

pub struct Operation {
    kind: i64,
    opcode: i64,
    dst: i64,
    a: i64,
    b: i64,
    c: i64,
    imm: i64,
    aux: i64,
    type: i64,
    place: i64,
    extension: i64,
    effects: i64,
    flags: i64,
    abi: i64,
    reads: i64,
    writes: i64,
    clobbers: i64,
    mode: i64,
    target: i64,
}

pub struct Place {
    kind: i64,
    offset: i64,
    width: i64,
}

pub struct Model {
    ok: bool,
    operations: []Operation,
    places: []Place,
    labels: Map<i64, i64>,
    order: []i32,
}

struct Cursor {
    pos: i32,
    ok: bool,
}

impl Cursor {
    fn expect(&mut self, lines: &[]string, value: string) {
        if self.pos >= lines.len || lines[self.pos] != value { self.ok = false }
        self.pos += 1
    }

    fn number(&mut self, lines: &[]string) -> i64 {
        if self.pos >= lines.len || !self.ok { self.ok = false; return 0 }
        parsed := parse.integer(lines[self.pos])
        self.pos += 1
        if !parsed.ok { self.ok = false }
        parsed.value
    }

    fn count(&mut self, lines: &[]string) -> i32 {
        n := self.number(&lines)
        if n < 0 || n >= 10000 { self.ok = false; return 0 }
        i32(n)
    }
}

pub fn decode(input: string) -> Model {
    lines := harness.lines(input)
    mut cursor := Cursor { pos: 0, ok: true }
    mut model := Model { ok: false, operations: [], places: [], labels: Map<i64, i64>::new(), order: [] }
    cursor.expect(&lines, "MIR1")
    operations := cursor.count(&lines)
    if operations == 0 { return model }
    for _ in 0..operations {
        model.operations.push(Operation {
            kind: cursor.number(&lines),
            opcode: cursor.number(&lines),
            dst: cursor.number(&lines),
            a: cursor.number(&lines),
            b: cursor.number(&lines),
            c: cursor.number(&lines),
            imm: cursor.number(&lines),
            aux: cursor.number(&lines),
            type: cursor.number(&lines),
            place: cursor.number(&lines),
            extension: cursor.number(&lines),
            effects: cursor.number(&lines),
            flags: cursor.number(&lines),
            abi: cursor.number(&lines),
            reads: cursor.number(&lines),
            writes: cursor.number(&lines),
            clobbers: cursor.number(&lines),
            mode: cursor.number(&lines),
            target: cursor.number(&lines),
        })
    }
    cursor.expect(&lines, "PLACES")
    for _ in 0..cursor.count(&lines) {
        model.places.push(Place { kind: cursor.number(&lines), offset: cursor.number(&lines), width: cursor.number(&lines) })
    }
    cursor.expect(&lines, "LABELS")
    for _ in 0..cursor.count(&lines) {
        label := cursor.number(&lines)
        position := cursor.number(&lines)
        model.labels.put(label, position)
    }
    cursor.expect(&lines, "ORDER")
    if cursor.count(&lines) != operations { return model }
    mut seen: []bool = []
    for _ in 0..operations { seen.push(false) }
    for _ in 0..operations {
        index := cursor.number(&lines)
        if !cursor.ok || index < 0 || index >= i64(operations) { return model }
        slot := i32(index)
        if seen[slot] { return model }
        seen[slot] = true
        model.order.push(slot)
    }
    cursor.expect(&lines, "END")
    model.ok = cursor.ok && cursor.pos == lines.len
    model
}

pub struct Differential {
    ok: bool,
    original: string,
    rewritten: string,
    counters: []i64,
}

pub fn differential(output: string, wanted: i32) -> Differential {
    mut result := Differential { ok: false, original: "", rewritten: "", counters: [] }
    original := text.find(output, "ORIGINAL\n")
    if original < 0 { return result }
    tail := output[original + 9..output.len]
    changed := text.find(tail, "RESULT\n")
    if changed < 0 { return result }
    result.original = tail[0..changed]
    rest := tail[changed + 7..tail.len]
    counters := text.find(rest, "COUNTERS\n")
    if counters < 0 { return result }
    result.rewritten = rest[0..counters]
    parts := harness.fields(rest[counters + 9..rest.len])
    if parts.len != wanted { return result }
    for part in parts {
        n := parse.integer(part)
        if !n.ok { return result }
        result.counters.push(n.value)
    }
    result.ok = true
    result
}

pub fn bits(value: i64) -> u64 {
    if value >= 0 { return u64(value) }
    minimum: i64 = -9223372036854775808
    high: u64 = 9223372036854775808
    u64(value - minimum) + high
}

fn mask(width: i32) -> u64 {
    if width == 64 { return u64(0).bit_not() }
    u64(1).shl(width) - 1
}

pub fn signed(value: u64, width: i32) -> i64 {
    low := value.bit_and(mask(width))
    sign := u64(1).shl(width - 1)
    if low < sign { return i64(low) }
    if width < 64 { return i64(low) - i64(u64(1).shl(width)) }
    minimum: i64 = -9223372036854775808
    minimum + i64(low - sign)
}

fn asr(value: u64, width: i32, shift: i32) -> u64 {
    extended := bits(signed(value, width))
    if shift == 0 { return extended }
    high := if extended.shr(63) != 0 { mask(64).shl(64 - shift) } else { u64(0) }
    extended.shr(shift).bit_or(high)
}

fn high_product(a: u64, b: u64, width: i32, is_signed: bool) -> u64 {
    if width == 32 {
        if is_signed { return asr(bits(signed(a, 32) * signed(b, 32)), 64, 32) }
        return (a * b).shr(32)
    }
    low := mask(32)
    x := a.bit_and(low)
    y := b.bit_and(low)
    upper_a := a.shr(32)
    upper_b := b.shr(32)
    first := x * y
    second := upper_a * y + first.shr(32)
    third := x * upper_b + second.bit_and(low)
    mut high := upper_a * upper_b + second.shr(32) + third.shr(32)
    if is_signed {
        if a.shr(63) != 0 { high = high.wrapping_sub(b) }
        if b.shr(63) != 0 { high = high.wrapping_sub(a) }
    }
    high
}

pub enum State { Complete, Gap, Exhausted }

pub struct Outcome {
    state: State,
    value: u64,
    steps: i32,
    reason: string,
}

pub struct Machine {
    variables: Map<i64, u64>,
    memory: Map<u64, u8>,
    coverage: Map<string, i32>,
    nzcv_ready: bool,
    negative: bool,
    zero: bool,
    carry: bool,
    overflow: bool,
    steps: i32,
    gap: string,
}

impl Machine {
    pub fn new() -> Self {
        mut machine := Self {
            variables: Map<i64, u64>::new(), memory: Map<u64, u8>::new(), coverage: Map<string, i32>::new(),
            nzcv_ready: false, negative: false, zero: false, carry: false, overflow: false,
            steps: 0, gap: "",
        }
        machine.write(29, 0, 64)
        machine.write(30, 0, 64)
        machine.write(31, 1048576, 64)
        machine
    }

    fn miss(&mut self, reason: string) {
        if self.gap.len == 0 { self.gap = reason.clone() }
    }

    pub fn read(&mut self, variable: i64) -> u64 {
        if variable == -1 { return 0 }
        if !self.variables.contains(variable) {
            self.miss(f"read of uninitialized variable {variable}")
            return 0
        }
        self.variables.at(variable)
    }

    pub fn write(&mut self, variable: i64, value: u64, width: i32) {
        if variable != -1 { self.variables.put(variable, value.bit_and(mask(width))) }
    }

    fn load(&mut self, address: u64, size: i32) -> u64 {
        if size < 1 || size > 8 { self.miss(f"unsupported memory width {size}"); return 0 }
        mut value: u64 = 0
        for i in 0..size {
            next := address.wrapping_add(u64(i))
            if !self.memory.contains(next) {
                self.miss(f"uninitialized memory [{address}, {address.wrapping_add(u64(size))})")
                return 0
            }
            byte := u64(self.memory.at(next))
            value = value.bit_or(byte.shl(8 * i))
        }
        value
    }

    pub fn store(&mut self, address: u64, value: u64, size: i32) {
        if size < 1 || size > 8 { self.miss(f"unsupported memory width {size}"); return }
        for i in 0..size {
            byte := u8(value.shr(8 * i).bit_and(255))
            self.memory.put(address.wrapping_add(u64(i)), byte)
        }
    }

    pub fn condition(&mut self, index: i64) -> bool {
        if !self.nzcv_ready { self.miss("NZCV read before definition"); return false }
        n := self.negative
        z := self.zero
        c := self.carry
        v := self.overflow
        choices := [z, !z, c, !c, n, !n, v, !v, c && !z, !c || z, n == v, n != v,
                    !z && n == v, z || n != v, true, true]
        if index < 0 || index >= i64(choices.len) { self.miss(f"unknown NZCV condition {index}"); return false }
        choices[i32(index)]
    }

    fn mark_flags(&mut self, opcode: i64, a: u64, b: u64, result: u64, width: i32) {
        sign := u64(1).shl(width - 1)
        a_negative := a.bit_and(sign) != 0
        b_negative := b.bit_and(sign) != 0
        self.negative = result.bit_and(sign) != 0
        self.zero = result == 0
        self.carry = false
        self.overflow = false
        if opcode == 1 {
            self.carry = result < a
            self.overflow = a_negative == b_negative && self.negative != a_negative
        } else if opcode == 2 {
            self.carry = a >= b
            self.overflow = a_negative != b_negative && self.negative != a_negative
        } else if opcode != 8 && opcode != 11 {
            self.miss(f"flag-setting binary opcode {opcode}")
        }
        self.nzcv_ready = true
    }

    pub fn binary(&mut self, op: &Operation, width: i32) -> u64 {
        limit := mask(width)
        a := self.read(op.a).bit_and(limit)
        raw := if op.b >= 0 { self.read(op.b) } else { bits(op.imm) }
        mut b := raw.bit_and(limit)
        code := op.opcode
        shift := i32(op.aux.bit_and(63))
        shift_kind := op.aux.shr(6).bit_and(3)
        if code == 1 || code == 2 || (code >= 8 && code <= 13) {
            if shift_kind == 0 { b = b.shl(shift).bit_and(limit) }
            else if shift_kind == 1 { b = b.shr(shift) }
            else if shift_kind == 2 { b = asr(b, width, shift).bit_and(limit) }
            else if shift > 0 {
                if shift >= width { self.miss("invalid semantic rotate width"); return 0 }
                b = b.shr(shift).bit_or(b.shl(width - shift)).bit_and(limit)
            }
        }
        amount := i32(b % u64(width))
        mut result: u64 = 0
        if code == 1 { result = a.wrapping_add(b) }
        else if code == 2 { result = a.wrapping_sub(b) }
        else if code == 3 { result = a.wrapping_mul(b) }
        else if code == 4 || code == 5 { result = high_product(a, b, width, code == 4) }
        else if code == 6 {
            if b != 0 {
                left := signed(a, width)
                right := signed(b, width)
                if left == -9223372036854775808 && right == -1 { result = a }
                else { result = bits(left / right) }
            }
        } else if code == 7 {
            if b != 0 { result = a / b }
        } else if code == 8 { result = a.bit_and(b) }
        else if code == 9 { result = a.bit_or(b) }
        else if code == 10 { result = a.bit_xor(b) }
        else if code == 11 { result = a.bit_and(b.bit_not()) }
        else if code == 12 { result = a.bit_or(b.bit_not()) }
        else if code == 13 { result = a.bit_xor(b.bit_not()) }
        else if code == 14 { result = a.shl(amount) }
        else if code == 15 { result = a.shr(amount) }
        else if code == 16 { result = asr(a, width, amount) }
        else if code == 17 { result = self.read(op.c).wrapping_add(a.wrapping_mul(b)) }
        else if code == 18 { result = self.read(op.c).wrapping_sub(a.wrapping_mul(b)) }
        else { self.miss(f"binary opcode {code}") }
        if op.flags.bit_and(2) != 0 { self.mark_flags(code, a, b, result.bit_and(limit), width) }
        result
    }

    fn unary(&mut self, op: &Operation, width: i32) -> u64 {
        value := self.read(op.a)
        if op.opcode == 3 {
            if op.aux < 0 || op.aux >= i64(width) { self.miss("invalid semantic insert bounds"); return 0 }
            return value.bit_and(u64(65535).shl(i32(op.aux)).bit_not()).bit_or(bits(op.imm))
        }
        if op.opcode != 1 && op.opcode != 2 { self.miss(f"unary opcode {op.opcode}"); return 0 }
        rotate := i32(op.aux.bit_and(63))
        top := op.aux.shr(6)
        if rotate >= width || top < 0 || top >= i64(width) { self.miss("invalid semantic bitfield bounds"); return 0 }
        mut count := i32(top) - rotate + 1
        mut result: u64 = 0
        if rotate <= i32(top) {
            result = value.shr(rotate).bit_and(mask(count))
        } else {
            count += width
            result = value.bit_and(mask(i32(top) + 1)).shl(width - rotate)
        }
        if op.opcode == 1 { return bits(signed(result, count)) }
        result
    }

    fn memory_op(&mut self, model: &Model, op: &Operation, width: i32) {
        if op.place < 0 || op.place >= i64(model.places.len) { self.miss(f"invalid memory place {op.place}"); return }
        place := &model.places[i32(op.place)]
        if place.offset != op.imm || place.width != op.aux { self.miss(f"memory place {op.place} disagrees with operation"); return }
        if op.aux < 1 || op.aux > 8 { self.miss(f"unsupported memory width {op.aux}"); return }
        base := if op.kind == 7 { self.read(op.a) } else { self.read(op.b) }
        address := base.wrapping_add(bits(op.imm))
        size := i32(op.aux)
        if op.kind == 7 {
            raw := self.load(address, size)
            value := if op.extension == 2 { bits(signed(raw, size * 8)) } else { raw }
            self.write(op.dst, value, width)
        } else {
            value := self.read(op.a)
            self.store(address, value, size)
        }
    }

    fn stack_op(&mut self, op: &Operation) {
        stack := self.read(31)
        if op.kind == 10 || op.effects == 36 {
            next := stack.wrapping_sub(16)
            first := if op.kind == 10 { self.read(op.a) } else { self.read(29) }
            second := if op.kind == 10 { u64(0) } else { self.read(30) }
            self.store(next, first, 8)
            self.store(next.wrapping_add(8), second, 8)
            self.write(31, next, 64)
        } else if op.kind == 11 || op.effects == 34 {
            first := self.load(stack, 8)
            if op.kind == 11 { self.write(op.dst, first, 64) }
            else {
                second := self.load(stack.wrapping_add(8), 8)
                self.write(29, first, 64)
                self.write(30, second, 64)
            }
            self.write(31, stack.wrapping_add(16), 64)
        } else { self.miss(f"ABI frame effects {op.effects}") }
    }

    fn branch(&mut self, model: &Model, op: &Operation, next: i64) -> i64 {
        mut taken := true
        if op.kind == 13 {
            if op.opcode == 1 { taken = self.condition(op.imm) }
            else if op.opcode == 2 || op.opcode == 3 { taken = (self.read(op.a) == 0) == (op.opcode == 2) }
            else { self.miss(f"conditional opcode {op.opcode}"); return next }
        }
        if !taken { return next }
        if !model.labels.contains(op.target) || model.labels.at(op.target) < 0 {
            self.miss(f"external branch {op.target}")
            return next
        }
        model.labels.at(op.target)
    }

    pub fn run(&mut self, model: &Model, fuel: i32) -> Outcome {
        mut position: i64 = 0
        if !model.ok { self.miss("invalid MIR model") }
        while position < i64(model.order.len) && self.gap.len == 0 {
            if self.steps >= fuel {
                return Outcome { state: .Exhausted, value: 0, steps: self.steps, reason: f"fuel={fuel}, position={position}" }
            }
            self.steps += 1
            op := &model.operations[model.order[i32(position)]]
            coverage := f"{op.kind}:{op.opcode}"
            previous := if self.coverage.contains(coverage) { i32(self.coverage.at(coverage)) } else { 0 }
            self.coverage.put(coverage.clone(), previous + 1)
            position += 1
            if op.mode == 2 { continue }
            width := if op.type == 1 { 32 } else { 64 }
            if op.kind == 1 { self.write(op.dst, bits(op.imm), width) }
            else if op.kind == 2 { value := self.read(op.a); self.write(op.dst, value, width) }
            else if op.kind == 3 { value := self.unary(&op, width); self.write(op.dst, value, width) }
            else if op.kind == 4 || op.kind == 5 || op.kind == 16 { value := self.binary(&op, width); self.write(op.dst, value, width) }
            else if op.kind == 6 {
                if op.a != -1 || op.b != -1 { self.miss("general Select operands outside closed CSET subset") }
                else { value: u64 = if self.condition(op.imm) { 1 } else { 0 }; self.write(op.dst, value, width) }
            } else if op.kind == 7 || op.kind == 8 { self.memory_op(&model, &op, width) }
            else if op.kind == 10 || op.kind == 11 || (op.kind == 21 && op.abi == 1) { self.stack_op(&op) }
            else if op.kind == 12 || op.kind == 13 { position = self.branch(&model, &op, position) }
            else if op.kind == 15 {
                value := self.read(0)
                if self.gap.len == 0 { return Outcome { state: .Complete, value: value, steps: self.steps, reason: "" } }
            } else if op.kind != 18 { self.miss(f"kind={op.kind}, opcode={op.opcode}, abi={op.abi}") }
        }
        if self.gap.len == 0 { self.miss("function fell off end without Return") }
        Outcome { state: .Gap, value: 0, steps: self.steps, reason: self.gap.clone() }
    }
}
