import .range_analysis_model as export

pub struct Input { arrays: [][]i64, n: i64, m: i64, x: i64, flag: bool, aliased: bool }

pub enum Control { Running, Return, Break, Continue, Trap, Exhausted, Failure }

pub struct Outcome { kind: Control, value: i64, has_value: bool }

pub struct Machine {
    fuel: i64,
    steps: i64,
    slots: []i64,
    arrays: [][]i64,
    state: Outcome,
    accesses: i64,
    bounds_nodes: []i32,
    arithmetic_nodes: []i32,
    new_nodes: []i32,
    error: string,
}

pub fn returned(value: i64) -> Outcome { Outcome { kind: .Return, value: value, has_value: true } }
pub fn trapped(code: i64) -> Outcome { Outcome { kind: .Trap, value: code, has_value: true } }

pub fn same(a: &Outcome, b: &Outcome) -> bool {
    a.kind == b.kind && a.has_value == b.has_value && (!a.has_value || a.value == b.value)
}

pub fn fits_i32(value: i64) -> bool { value >= -2147483648 && value <= 2147483647 }

fn magnitude(value: i64) -> u64 {
    if value < 0 { u64(-(value + 1)) + 1 } else { u64(value) }
}

struct Integer { value: i64, overflow: bool }

fn calculate_wide(op: i64, left: i64, right: i64) -> Integer {
    if op == 1 {
        wrapped := left.wrapping_add(right)
        overflow := (left >= 0 && right >= 0 && wrapped < 0) || (left < 0 && right < 0 && wrapped >= 0)
        return Integer { value: wrapped, overflow: overflow }
    }
    if op == 2 {
        wrapped := left.wrapping_sub(right)
        overflow := (left >= 0 && right < 0 && wrapped < 0) || (left < 0 && right >= 0 && wrapped >= 0)
        return Integer { value: wrapped, overflow: overflow }
    }
    negative := (left < 0) != (right < 0)
    maximum: u64 = if negative { 9223372036854775808 } else { 9223372036854775807 }
    multiplier := magnitude(right)
    overflow := multiplier != 0 && magnitude(left) > maximum / multiplier
    Integer { value: left.wrapping_mul(right), overflow: overflow }
}

fn evaluate(op: i64, ty: i32, left: i64, right: i64) -> Integer {
    if ty == 2 { return calculate_wide(op, left, right) }
    result := if op == 1 { left + right } else if op == 2 { left - right } else { left * right }
    Integer { value: result, overflow: !fits_i32(result) }
}

pub fn input_slot(input: &Input, parameter: i32) -> i64 {
    if parameter < 3 { return if input.aliased { 0 } else { i64(parameter) } }
    if parameter == 3 { return input.n }
    if parameter == 4 { return input.m }
    if parameter == 5 { return input.x }
    if input.flag { 1 } else { 0 }
}

impl Machine {
    fn fail(&mut self, message: string) -> i64 {
        self.state.kind = .Failure
        self.error = message.clone()
        0
    }

    fn trap(&mut self, code: i64) -> i64 {
        self.state = trapped(code)
        0
    }

    fn tick(&mut self) -> bool {
        if self.state.kind != .Running { return false }
        if self.steps >= self.fuel {
            self.state.kind = .Exhausted
            return false
        }
        self.steps += 1
        true
    }

    fn arithmetic(&mut self, node: &export.Node, at: i32, op: i64, left: i64, right: i64) -> i64 {
        if node.kind_type != 1 && node.kind_type != 2 { return self.fail(f"invalid arithmetic type at node {at}") }
        if node.kind_type == 1 && (!fits_i32(left) || !fits_i32(right)) {
            return self.fail(f"invalid i32 operand at node {at}")
        }
        outcome := evaluate(op, node.kind_type, left, right)
        if node.kind_type == 1 && node.proof.bit_and(1) != 0 {
            if outcome.overflow {
                return self.fail(f"UNSOUND ARITHMETIC PROOF at node {at}: operation {op}, operands {left}, {right}")
            }
            self.arithmetic_nodes.push(at)
            if node.pending_mask.bit_and(1) != 0 { self.new_nodes.push(at) }
        }
        if outcome.overflow { return self.trap(101) }
        outcome.value
    }

    fn access(&mut self, node: &export.Node, at: i32, index: i64) -> i32 {
        local := node.local
        if local < 0 || local >= self.slots.len { _ := self.fail(f"invalid array local at node {at}"); return -1 }
        slot := self.slots[local]
        if slot < 0 || slot >= i64(self.arrays.len) { _ := self.fail(f"invalid array root at node {at}"); return -1 }
        root := i32(slot)
        size := self.arrays[root].len
        valid := index >= 0 && index < i64(size)
        self.accesses += 1
        if node.proof.bit_and(2) != 0 {
            if !valid { _ := self.fail(f"UNSOUND BOUNDS PROOF at node {at}: index {index}, length {size}"); return -1 }
            self.bounds_nodes.push(at)
        }
        if !valid { _ := self.trap(103); return -1 }
        root
    }

    fn expression(&mut self, model: &export.Model, at: i32) -> i64 {
        if !self.tick() { return 0 }
        if at < 0 || at >= model.nodes.len { return self.fail(f"invalid expression index: {at}") }
        node := &model.nodes[at]
        kind := node.kind
        op := node.value
        if kind == 1 {
            if node.kind_type == 3 { return if op == 0 { 0 } else { 1 } }
            return op
        }
        if kind == 2 || kind == 5 {
            if node.local < 0 || node.local >= self.slots.len { return self.fail(f"invalid local at node {at}") }
            slot := self.slots[node.local]
            if kind == 2 { return slot }
            if slot < 0 || slot >= i64(self.arrays.len) { return self.fail(f"invalid length root at node {at}") }
            return i64(self.arrays[i32(slot)].len)
        }
        if kind == 6 {
            index := self.expression(&model, node.left)
            if self.state.kind != .Running { return 0 }
            slot := self.access(&node, at, index)
            if slot < 0 { return 0 }
            return self.arrays[slot][i32(index)]
        }
        if kind != 3 && kind != 4 { return self.fail(f"unknown expression kind {kind} at node {at}") }
        a := self.expression(&model, node.left)
        if self.state.kind != .Running { return 0 }
        if kind == 4 {
            if op == 2 { return if a == 0 { 1 } else { 0 } }
            if op != 1 { return self.fail(f"unknown unary operator {op} at node {at}") }
            return self.arithmetic(&node, at, 2, 0, a)
        }
        if op == 12 && a == 0 { return 0 }
        if op == 13 && a != 0 { return 1 }
        b := self.expression(&model, node.right)
        if self.state.kind != .Running { return 0 }
        if op >= 1 && op <= 3 { return self.arithmetic(&node, at, op, a, b) }
        if op == 4 || op == 5 {
            if b == 0 { return self.trap(102) }
            minimum: i64 = if node.kind_type == 1 { -2147483648 } else { -9223372036854775808 }
            if a == minimum && b == -1 { return self.trap(101) }
            return if op == 4 { a / b } else { a % b }
        }
        if op == 6 { return if a == b { 1 } else { 0 } }
        if op == 7 { return if a != b { 1 } else { 0 } }
        if op == 8 { return if a < b { 1 } else { 0 } }
        if op == 9 { return if a <= b { 1 } else { 0 } }
        if op == 10 { return if a > b { 1 } else { 0 } }
        if op == 11 { return if a >= b { 1 } else { 0 } }
        if op == 12 || op == 13 { return if b != 0 { 1 } else { 0 } }
        self.fail(f"unknown binary operator {op} at node {at}")
    }

    fn loop_next(&mut self) -> bool {
        if self.state.kind == .Continue { self.state.kind = .Running }
        if self.state.kind == .Break {
            self.state.kind = .Running
            return false
        }
        self.state.kind == .Running
    }

    fn statement(&mut self, model: &export.Model, at: i32) {
        if !self.tick() { return }
        if at < 0 || at >= model.nodes.len { _ := self.fail(f"invalid statement index: {at}"); return }
        node := &model.nodes[at]
        kind := node.kind
        if kind == 10 {
            mut child := node.left
            while child >= 0 && self.state.kind == .Running {
                self.statement(&model, child)
                if self.state.kind == .Running { child = model.nodes[child].next }
            }
        } else if kind == 11 || kind == 12 {
            value := self.expression(&model, node.left)
            if self.state.kind == .Running { self.slots[node.local] = value }
        } else if kind == 13 {
            condition := self.expression(&model, node.left)
            child := if condition != 0 { node.right } else { node.third }
            if child >= 0 && self.state.kind == .Running { self.statement(&model, child) }
        } else if kind == 14 {
            while self.expression(&model, node.left) != 0 && self.state.kind == .Running {
                self.statement(&model, node.right)
                if !self.loop_next() { break }
            }
        } else if kind == 19 {
            low := self.expression(&model, node.left)
            if self.state.kind != .Running { return }
            high := self.expression(&model, node.right)
            if self.state.kind != .Running { return }
            self.slots[node.local] = low
            while self.slots[node.local] < high {
                self.statement(&model, node.third)
                if !self.loop_next() { break }
                next := self.slots[node.local] + 1
                if !fits_i32(next) { _ := self.trap(101); break }
                self.slots[node.local] = next
            }
        } else if kind == 15 {
            if node.left < 0 { self.state.kind = .Return; return }
            result := self.expression(&model, node.left)
            if self.state.kind == .Running { self.state = returned(result) }
        } else if kind == 16 {
            self.state.kind = .Break
        } else if kind == 17 {
            self.state.kind = .Continue
        } else if kind == 18 {
            index := self.expression(&model, node.left)
            if self.state.kind != .Running { return }
            slot := self.access(&node, at, index)
            if slot < 0 { return }
            value := self.expression(&model, node.right)
            if self.state.kind == .Running { self.arrays[slot][i32(index)] = value }
        } else {
            _ := self.fail(f"unknown statement kind {kind} at node {at}")
        }
    }
}

pub fn run(model: &export.Model, input: &Input, fuel: i64) -> Machine {
    mut machine := Machine {
        fuel: fuel, steps: 0, slots: [], arrays: input.arrays.clone(), state: Outcome { kind: .Running, value: 0, has_value: false },
        accesses: 0, bounds_nodes: [], arithmetic_nodes: [], new_nodes: [], error: "",
    }
    machine.slots.reserve(model.locals.len)
    for local in model.locals {
        if local.param > 6 { _ := machine.fail(f"invalid parameter: {local.param}"); return machine }
        machine.slots.push(if local.param >= 0 { input_slot(&input, local.param) } else { 0 })
    }
    machine.statement(&model, model.root)
    if machine.state.kind == .Running { machine.state.kind = .Return }
    if machine.state.kind == .Break || machine.state.kind == .Continue { _ := machine.fail("loop control left root block") }
    machine
}

pub fn selfcheck() -> bool {
    empty: [][]i64 = [[], [], []]
    args := Input { arrays: empty.clone(), n: 0, m: 0, x: 0, flag: false, aliased: false }
    mut model := export.model()
    model.root = 2
    model.nodes = [export.node(1, 1, 0, -1, -1, 0), export.node(6, 2, 0, 0, -1, 2), export.node(15, 0, 0, 1, -1, 0)]
    model.locals = [export.Local { kind_type: 20, param: 0, mutable: 0, at: 0 }]
    bounds := run(&model, &args, 100)
    if bounds.state.kind != .Failure || bounds.error != "UNSOUND BOUNDS PROOF at node 1: index 0, length 0" { return false }
    checks: [](i32, i64, i64, i64) = [
        (3, 1, 2147483647, 1), (3, 2, -2147483648, 1), (3, 3, -2147483648, -1), (3, 3, 46341, 46341), (4, 1, -2147483648, 0),
    ]
    model.root = 3
    model.locals = []
    for check in checks {
        (kind, op, a, b) := check
        model.nodes = [export.node(1, 1, a, -1, -1, 0), export.node(1, 1, b, -1, -1, 0),
            export.node(kind, 1, op, 0, 1, 1), export.node(15, 0, 0, 2, -1, 0)]
        broken := run(&model, &args, 100)
        if broken.state.kind != .Failure { return false }
        model.nodes[2].proof = 0
        checked := run(&model, &args, 100)
        if checked.state.kind != .Trap || checked.state.value != 101 { return false }
    }
    model.root = 5
    model.nodes = [export.node(1, 1, 2147483647, -1, -1, 0), export.node(1, 1, 1, -1, -1, 0),
        export.node(3, 1, 1, 0, 1, 0), export.node(1, 1, 0, -1, -1, 0),
        export.node(3, 1, 3, 2, 3, 1), export.node(15, 0, 0, 4, -1, 0)]
    child := run(&model, &args, 100)
    if child.state.kind != .Trap || child.state.value != 101 || child.arithmetic_nodes.len != 0 { return false }
    model.root = 2
    model.nodes = [export.node(1, 3, 1, -1, -1, 0), export.node(10, 0, 0, -1, -1, 0), export.node(14, 0, 0, 0, 1, 0)]
    loop := run(&model, &args, 12)
    loop.state.kind == .Exhausted && !fits_i32(-2147483649) && !fits_i32(2147483648) &&
        evaluate(2, 2, -9223372036854775808, 1).overflow &&
        evaluate(1, 2, 9223372036854775807, 1).overflow &&
        evaluate(3, 2, -9223372036854775808, -1).overflow
}
