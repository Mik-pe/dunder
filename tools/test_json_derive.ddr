capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import sys

fn model_mod_source() -> string {
    "@derive(Encode, Decode)\n" +
    "pub struct RemoteConfig {\n" +
    "    host: string,\n" +
    "    port: u16,\n" +
    "    tls: bool,\n" +
    "}\n\n" +
    "@derive(Encode, Decode)\n" +
    "pub enum RemoteStatus {\n" +
    "    Offline,\n" +
    "    Online(u32),\n" +
    "    Detail(string, i32),\n" +
    "}\n"
}

fn alias_mod_source() -> string {
    "import std.json as json\n\n" +
    "@derive(json.Encode, json.Decode)\n" +
    "pub struct QualifiedItem {\n" +
    "    name: string,\n" +
    "    count: i32,\n" +
    "}\n\n" +
    "@derive(Encode, Decode)\n" +
    "pub struct UnqualifiedAlsoItem {\n" +
    "    flag: bool,\n" +
    "}\n"
}

fn named_mod_source() -> string {
    "import std.json.Encode\n" +
    "import std.json.Decode\n" +
    "import std.json.Writer\n" +
    "import std.json.Doc\n" +
    "import std.json.JsonError\n\n" +
    "@derive(Encode, Decode)\n" +
    "pub struct NamedItem {\n" +
    "    label: string,\n" +
    "    qty: u8,\n" +
    "}\n\n" +
    "pub fn roundtrip_named(move label: string, qty: u8) -> Result<NamedItem, JsonError> {\n" +
    "    item := NamedItem { label: label, qty: qty }\n" +
    "    mut w := Writer::new()\n" +
    "    item.encode_json(&mut w)\n" +
    "    encoded := w.finish()\n" +
    "    if encoded.is_err() { return .Err(encoded.unwrap_err()) }\n" +
    "    doc_res := Doc::parse(encoded.unwrap())\n" +
    "    if doc_res.is_err() { return .Err(doc_res.unwrap_err()) }\n" +
    "    doc := doc_res.unwrap()\n" +
    "    NamedItem::decode_json(&doc, doc.root)\n" +
    "}\n"
}

fn main_program_source() -> string {
    "import .model_mod as model_mod\n" +
    "import .alias_mod as alias_mod\n" +
    "import .named_mod as named_mod\n" +
    "import std.bytes as bytes\n" +
    "import std.json as json\n\n" +
    "@derive(Encode, Decode, Eq)\n" +
    "struct Empty {}\n\n" +
    "@derive(Encode, Decode)\n" +
    "struct User {\n" +
    "    id: i32,\n" +
    "    name: string,\n" +
    "    nickname: Option<string>,\n" +
    "    tags: []string,\n" +
    "    score: f64,\n" +
    "    active: bool,\n" +
    "}\n\n" +
    "@derive(Encode, Decode)\n" +
    "struct Team {\n" +
    "    title: string,\n" +
    "    lead: User,\n" +
    "    empty: Empty,\n" +
    "    opt_empty: Option<Empty>,\n" +
    "}\n\n" +
    "@derive(Encode, Decode)\n" +
    "struct Boxed<T> {\n" +
    "    label: string,\n" +
    "    item: T,\n" +
    "}\n\n" +
    "@derive(Encode, Decode)\n" +
    "struct BoundedBox<T: json.Encode + json.Decode> {\n" +
    "    val: T,\n" +
    "}\n\n" +
    "@derive(Encode, Decode, Eq)\n" +
    "enum Color {\n" +
    "    Red,\n" +
    "    Green,\n" +
    "    Blue,\n" +
    "}\n\n" +
    "@derive(Encode, Decode)\n" +
    "enum Event {\n" +
    "    Ping,\n" +
    "    Count(i32),\n" +
    "    Pair(string, bool),\n" +
    "    Triple(i32, string, bool),\n" +
    "}\n\n" +
    "@derive(Encode, Decode)\n" +
    "enum Choice<T, E> {\n" +
    "    Left(T),\n" +
    "    Right(E),\n" +
    "    Neither,\n" +
    "}\n\n" +
    "fn check_doc_and_errors() {\n" +
    "    e1 := json.JsonError::new(\"bad token\", 12)\n" +
    "    e2 := json.JsonError::new(\"bad token\", 12)\n" +
    "    e3 := json.JsonError::new(\"bad token\", 13)\n" +
    "    assert(e1.message == \"bad token\" && e1.offset == 12)\n" +
    "    assert(e1 == e2 && e1 != e3)\n" +
    "    assert(e1.str().len > 0)\n\n" +
    "    parsed := json.Doc::parse(\"{\\\"a\\\":true,\\\"b\\\":-7,\\\"c\\\":42,\\\"d\\\":1.5,\\\"s\\\":\\\"hi\\\"}\")\n" +
    "    assert(parsed.is_ok())\n" +
    "    doc := parsed.unwrap()\n" +
    "    assert(doc.error_info().is_none())\n" +
    "    assert(doc.node_offset(doc.root) == 0)\n" +
    "    assert(doc.get_bool(doc.root, \"a\") == .Some(true))\n" +
    "    assert(doc.get_i64(doc.root, \"b\") == .Some(-7))\n" +
    "    assert(doc.get_u64(doc.root, \"c\") == .Some(42))\n" +
    "    assert(doc.get_f64(doc.root, \"d\").is_some())\n" +
    "    assert(doc.get_str(doc.root, \"s\").unwrap() == \"hi\")\n" +
    "    assert(doc.get_str(doc.root, \"missing\").is_none())\n" +
    "    assert(doc.get_bool(doc.root, \"b\").is_none())\n" +
    "    assert(doc.key_at(doc.root, 0).unwrap() == \"a\")\n" +
    "    assert(doc.key_at(doc.root, 99).is_none())\n\n" +
    "    bad_doc := json.Doc::parse(\"{broken\")\n" +
    "    assert(bad_doc.is_err())\n" +
    "    perr := bad_doc.unwrap_err()\n" +
    "    assert(perr.message.len > 0 && perr.offset >= 0)\n\n" +
    "    utf8_ok := json.Doc::parse_utf8(bytes.from_text(\"{\\\"k\\\":99}\"))\n" +
    "    assert(utf8_ok.is_ok())\n" +
    "    d2 := utf8_ok.unwrap()\n" +
    "    assert(d2.get_i64(d2.root, \"k\") == .Some(99))\n\n" +
    "    utf8_bad := json.Doc::parse_utf8([255, 254])\n" +
    "    assert(utf8_bad.is_err())\n\n" +
    "    mut w := json.Writer::new()\n" +
    "    w.object(); w.key(\"k\"); w.string(\"v\"); w.end()\n" +
    "    assert(w.finish().unwrap() == \"{\\\"k\\\":\\\"v\\\"}\")\n" +
    "    assert(bytes.decode(&w.finish_bytes().unwrap()).unwrap() == \"{\\\"k\\\":\\\"v\\\"}\")\n\n" +
    "    mut bad_w := json.Writer::new()\n" +
    "    bad_w.object()\n" +
    "    assert(bad_w.finish().is_err())\n" +
    "    assert(bad_w.finish_bytes().is_err())\n" +
    "}\n\n" +
    "fn check_builtins_and_options() {\n" +
    "    assert(json.from_str<bool>(\"true\") == .Ok(true))\n" +
    "    assert(json.from_str<bool>(\"false\") == .Ok(false))\n" +
    "    assert(json.from_str<i32>(\"-123\") == .Ok(-123))\n" +
    "    assert(json.from_str<i64>(\"9000000000\") == .Ok(9000000000))\n" +
    "    assert(json.from_str<u8>(\"255\") == .Ok(255))\n" +
    "    assert(json.from_str<u16>(\"65535\") == .Ok(65535))\n" +
    "    assert(json.from_str<u32>(\"4294967295\") == .Ok(4294967295))\n" +
    "    assert(json.from_str<u64>(\"18446744073709551615\").is_ok())\n" +
    "    assert(json.from_str<usize>(\"1024\") == .Ok(1024))\n" +
    "    assert(json.from_str<f32>(\"1.5\").is_ok())\n" +
    "    assert(json.from_str<f64>(\"3.25\").is_ok())\n" +
    "    assert(json.from_str<string>(\"\\\"hello\\\"\").unwrap() == \"hello\")\n" +
    "    assert(json.from_bytes<i64>(bytes.from_text(\"123456\")) == .Ok(123456))\n" +
    "    arr := json.from_str<[]i32>(\"[1,2,3]\").unwrap()\n" +
    "    assert(arr.len == 3 && arr[0] == 1 && arr[2] == 3)\n" +
    "    assert(json.to_string(&arr).unwrap() == \"[1,2,3]\")\n" +
    "    assert(bytes.decode(&json.to_bytes(&arr).unwrap()).unwrap() == \"[1,2,3]\")\n\n" +
    "    // Range & type errors\n" +
    "    assert(json.from_str<u8>(\"256\").is_err())\n" +
    "    assert(json.from_str<u8>(\"-1\").is_err())\n" +
    "    assert(json.from_str<u16>(\"65536\").is_err())\n" +
    "    assert(json.from_str<u32>(\"4294967296\").is_err())\n" +
    "    assert(json.from_str<u64>(\"-1\").is_err())\n" +
    "    assert(json.from_str<i32>(\"9999999999\").is_err())\n" +
    "    assert(json.from_str<i32>(\"-9999999999\").is_err())\n" +
    "    assert(json.from_str<string>(\"123\").is_err())\n" +
    "    assert(json.from_str<bool>(\"\\\"true\\\"\").is_err())\n\n" +
    "    // Direct Option<T>::decode_json / encode_json\n" +
    "    mut w_some := json.Writer::new()\n" +
    "    opt_some: Option<i32> = .Some(77)\n" +
    "    opt_some.encode_json(&mut w_some)\n" +
    "    assert(w_some.finish().unwrap() == \"77\")\n" +
    "    mut w_none := json.Writer::new()\n" +
    "    opt_none: Option<i32> = .None\n" +
    "    opt_none.encode_json(&mut w_none)\n" +
    "    assert(w_none.finish().unwrap() == \"null\")\n\n" +
    "    d_some := json.Doc::parse(\"77\").unwrap()\n" +
    "    assert(Option<i32>::decode_json(&d_some, d_some.root).unwrap() == .Some(77))\n" +
    "    d_null := json.Doc::parse(\"null\").unwrap()\n" +
    "    assert(Option<i32>::decode_json(&d_null, d_null.root).unwrap() == .None)\n\n" +
    "    // Nested Option<Option<i32>> & []Option<User>\n" +
    "    nn: Option<Option<i32>> = .Some(.Some(9))\n" +
    "    nn_str := json.to_string(&nn).unwrap()\n" +
    "    assert(nn_str == \"9\")\n" +
    "    assert(json.from_str<Option<Option<i32>>>(nn_str).unwrap() == .Some(.Some(9)))\n" +
    "    assert(json.from_str<Option<Option<i32>>>(\"null\").unwrap().is_none())\n\n" +
    "    users: []Option<User> = [\n" +
    "        .Some(User { id: 1, name: \"Ada\", nickname: .Some(\"ace\"), tags: [\"sys\"], score: 9.5, active: true }),\n" +
    "        .None,\n" +
    "        .Some(User { id: 2, name: \"Bob\", nickname: .None, tags: [], score: 4.0, active: false }),\n" +
    "    ]\n" +
    "    users_json := json.to_string(&users).unwrap()\n" +
    "    dec_users := json.from_str<[]Option<User>>(users_json).unwrap()\n" +
    "    assert(dec_users.len == 3)\n" +
    "    assert(dec_users[0].is_some() && dec_users[1].is_none() && dec_users[2].is_some())\n" +
    "}\n\n" +
    "fn check_derives_and_modules() {\n" +
    "    // Empty struct\n" +
    "    e := Empty {}\n" +
    "    es := json.to_string(&e).unwrap()\n" +
    "    assert(es == \"{}\")\n" +
    "    assert(json.from_str<Empty>(es).unwrap() == Empty {})\n" +
    "    assert(json.from_str<Empty>(\"123\").is_err())\n\n" +
    "    // Nested struct\n" +
    "    lead := User { id: 10, name: \"Lin\", nickname: .Some(\"L\"), tags: [\"a\", \"b\"], score: 2.5, active: true }\n" +
    "    team := Team { title: \"Core\", lead: lead, empty: Empty {}, opt_empty: .Some(Empty {}) }\n" +
    "    team_json := json.to_string(&team).unwrap()\n" +
    "    team_dec := json.from_str<Team>(team_json).unwrap()\n" +
    "    assert(team_dec.title == \"Core\" && team_dec.lead.id == 10 && team_dec.lead.nickname.unwrap() == \"L\")\n" +
    "    assert(team_dec.lead.tags.len == 2 && team_dec.opt_empty.is_some())\n\n" +
    "    // Missing required field fails decode\n" +
    "    assert(json.from_str<User>(\"{\\\"id\\\":1}\").is_err())\n\n" +
    "    bad := json.from_str<Team>(\"{\\\"title\\\":\\\"t\\\",\\\"lead\\\":{\\\"id\\\":false}}\").unwrap_err()\n" +
    "    assert(bad.message == \"field 'lead': field 'id': expected JSON integer\" && bad.offset == 26)\n" +
    "    // Generic & bounded generic structs\n" +
    "    bx := Boxed<Color> { label: \"tint\", item: .Green }\n" +
    "    bx_dec := json.from_str<Boxed<Color>>(json.to_string(&bx).unwrap()).unwrap()\n" +
    "    assert(bx_dec.label == \"tint\" && bx_dec.item == .Green)\n\n" +
    "    bbx := BoundedBox<i32> { val: -55 }\n" +
    "    bbx_dec := json.from_str<BoundedBox<i32>>(json.to_string(&bbx).unwrap()).unwrap()\n" +
    "    assert(bbx_dec.val == -55)\n\n" +
    "    // Unit enum\n" +
    "    c := Color.Blue\n" +
    "    cs := json.to_string(&c).unwrap()\n" +
    "    assert(cs == \"\\\"Blue\\\"\")\n" +
    "    assert(json.from_str<Color>(cs).unwrap() == .Blue)\n" +
    "    assert(json.from_str<Color>(\"\\\"Yellow\\\"\").is_err())\n\n" +
    "    // Data enum\n" +
    "    evs: []Event = [.Ping, .Count(42), .Pair(\"ok\", true), .Triple(-3, \"hi\", false)]\n" +
    "    evs_json := json.to_string(&evs).unwrap()\n" +
    "    evs_dec := json.from_str<[]Event>(evs_json).unwrap()\n" +
    "    assert(evs_dec.len == 4)\n" +
    "    match evs_dec[0] { .Ping => {}, _ => assert(false) }\n" +
    "    match evs_dec[1] { .Count(v) => assert(v == 42), _ => assert(false) }\n" +
    "    match evs_dec[2] { .Pair(s, b) => assert(s == \"ok\" && b), _ => assert(false) }\n" +
    "    match evs_dec[3] { .Triple(x, y, z) => assert(x == -3 && y == \"hi\" && !z), _ => assert(false) }\n\n" +
    "    // Generic enum\n" +
    "    c1: Choice<i32, string> = .Left(19)\n" +
    "    c2: Choice<i32, string> = .Right(\"nope\")\n" +
    "    c3: Choice<i32, string> = .Neither\n" +
    "    match json.from_str<Choice<i32, string>>(json.to_string(&c1).unwrap()).unwrap() { .Left(n) => assert(n == 19), _ => assert(false) }\n" +
    "    match json.from_str<Choice<i32, string>>(json.to_string(&c2).unwrap()).unwrap() { .Right(s) => assert(s == \"nope\"), _ => assert(false) }\n" +
    "    match json.from_str<Choice<i32, string>>(json.to_string(&c3).unwrap()).unwrap() { .Neither => {}, _ => assert(false) }\n\n" +
    "    // Cross-module @derive(Encode, Decode) without import std.json\n" +
    "    rc := model_mod.RemoteConfig { host: \"localhost\", port: 8080, tls: true }\n" +
    "    rc_dec := json.from_str<model_mod.RemoteConfig>(json.to_string(&rc).unwrap()).unwrap()\n" +
    "    assert(rc_dec.host == \"localhost\" && rc_dec.port == 8080 && rc_dec.tls)\n\n" +
    "    rs := model_mod.RemoteStatus.Detail(\"up\", 200)\n" +
    "    match json.from_str<model_mod.RemoteStatus>(json.to_string(&rs).unwrap()).unwrap() {\n" +
    "        .Detail(reason, code) => assert(reason == \"up\" && code == 200),\n" +
    "        _ => assert(false),\n" +
    "    }\n\n" +
    "    // Alias module with @derive(json.Encode, json.Decode) and @derive(Encode, Decode)\n" +
    "    qi := alias_mod.QualifiedItem { name: \"q\", count: 3 }\n" +
    "    qi_dec := json.from_str<alias_mod.QualifiedItem>(json.to_string(&qi).unwrap()).unwrap()\n" +
    "    assert(qi_dec.name == \"q\" && qi_dec.count == 3)\n" +
    "    ui := alias_mod.UnqualifiedAlsoItem { flag: true }\n" +
    "    ui_dec := json.from_str<alias_mod.UnqualifiedAlsoItem>(json.to_string(&ui).unwrap()).unwrap()\n" +
    "    assert(ui_dec.flag)\n\n" +
    "    // Named symbol imports module\n" +
    "    ni_res := named_mod.roundtrip_named(\"widget\", 7)\n" +
    "    assert(ni_res.is_ok())\n" +
    "    ni := ni_res.unwrap()\n" +
    "    assert(ni.label == \"widget\" && ni.qty == 7)\n" +
    "}\n\n" +
    "fn main() -> i32 {\n" +
    "    check_doc_and_errors()\n" +
    "    check_builtins_and_options()\n" +
    "    check_derives_and_modules()\n" +
    "    print(\"PASS json_derive\")\n" +
    "    0\n" +
    "}\n"
}

fn invalid_cases() -> [](string, string) {
    [
        ("struct NoEnc { x: i32 }\n@derive(Encode)\nstruct BadEnc { inner: NoEnc }\nfn main() {}", "unknown method 'encode_json'"),
        ("struct NoDec { x: i32 }\n@derive(Decode)\nstruct BadDec { inner: NoDec }\nfn main() {}", "does not implement"),
        ("import std.json as json\nstruct Plain { a: i32 }\nfn main() { p := Plain { a: 1 }; _ := json.to_string(&p) }", "does not implement"),
        ("import std.json as json\nstruct Plain { a: i32 }\nfn main() { _ := json.from_str<Plain>(\"{}\") }", "does not implement"),
    ]
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if cli.extra_args.len > 0 { _ := sys.eprint("unexpected argument: " + cli.extra_args[0]); return 2 }

    tmp := fs.temp_dir("dunder-json-derive-")
    if !tmp.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    main_path := work + "/main.ddr"
    if !sys.write_text(work + "/model_mod.ddr", model_mod_source()).ok ||
       !sys.write_text(work + "/alias_mod.ddr", alias_mod_source()).ok ||
       !sys.write_text(work + "/named_mod.ddr", named_mod_source()).ok ||
       !sys.write_text(main_path, main_program_source()).ok {
        _ := sys.eprint("failed writing json_derive test sources")
        return 1
    }

    bin := work + "/json-derive-probe"
    mut out := harness.empty_output()
    if !harness.run_checked_timeout(cli.compiler, ["build", main_path.clone(), "-o", bin.clone()], work, 0, false, 60000, &mut out) {
        return 1
    }
    if !harness.run_checked_timeout(bin, [], work, 0, false, 60000, &mut out) {
        return 1
    }
    if !harness.stdout_is(&out, "PASS json_derive\n", "json derive output") {
        return 1
    }

    cases := invalid_cases()
    if !harness.check_rejected_specializations(cli.compiler, work, &cases) {
        return 1
    }

    print("PASS json derive: JsonError, Doc, Writer, Option<T>, Decode, @derive(Encode, Decode), cross-module & negative checks verified")
    0
}
