capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import sys

fn invalid_cases() -> [](string, string) {
    [
        ("const X: i16 = -32769\nfn main() {}", "integer literal out of range"),
        ("const X: i16 = 32767 + 1\nfn main() {}", "constant integer out of i16 range"),
        ("const X: i64 = -1 * -9223372036854775808\nfn main() {}", "constant multiplication overflows"),
        ("const X: i64 = -9223372036854775808 / -1\nfn main() {}", "constant division overflows"),
        ("const X: i32 = -2147483648 % -1\nfn main() {}", "constant remainder overflows"),
        ("const X: i64 = -9223372036854775808 % -1\nfn main() {}", "constant remainder overflows"),
        ("const X = i64(9223372036854775808.0)\nfn main() {}", "out of signed integer range"),
        ("const X = u64(18446744073709551616.0)\nfn main() {}", "out of unsigned range"),
        ("const X = 1\nfn main() { X = 2 }", "assignment requires a mutable stored value"),
        ("const TABLE: []i32 = [1, 2, 3]\nfn main() { TABLE[0] = 9 }", "assignment requires a mutable stored value"),
        ("const TABLE: []i32 = [1, 2, 3]\nfn take(v: &mut []i32) {}\nfn main() { take(&mut TABLE) }", "mutable borrow requires a named variable"),
        ("const TABLE: []i32 = [1, 2, 3]\nfn main() { TABLE.push(4) }", "array mutation requires a stored place"),
        ("const A: i32 = B + 1\nconst B: i32 = A + 1\nfn main() {}", "cyclic constant definition"),
        ("const N = 4\nfn N() -> i32 { 1 }\nfn main() {}", "duplicate declaration 'N'"),
        ("const N: [i32; 2] = [1, 2, 3]\nfn main() {}", "length mismatch"),
        ("import .consts_mod as m\nfn main() { _ := m.PRIV }", "private"),
    ]
}

fn positive_program() -> string {
    "import .consts_mod as m\n" +
    "const N: i32 = 4\n" +
    "const M = N * 2 + 1\n" +
    "const NEG: i32 = -2147483648\n" +
    "const BIG_I64: i64 = -9223372036854775807 - 1\n" +
    "const U8_V: u8 = u8(200) + u8(55)\n" +
    "const U64_V: u64 = u64(18446744073709551615)\n" +
    "const OK: bool = (N == 4 && M == 9) || false\n" +
    "const RUNE_V: rune = `å`\n" +
    "const F32_V: f32 = f32(1.5) + f32(2.25)\n" +
    "const F64_V: f64 = -3.5 * 2.0\n" +
    "const NEG_FLOAT: f32 = -1.5 * 2.0 + -0.25\n" +
    "const SIGN_ZERO = f64(f32.from_bits(-2147483648))\n" +
    "const NEG_LESS = NEG_FLOAT < f32(-3.0)\n" +
    "const I32_LOW = i32(-2147483648.9)\n" +
    "const U8_ZERO = u8(-0.75)\n" +
    "const U64_HIGH = u64(9223372036854775808.0)\n" +
    "const TIE_PLUS_ONE = f64(u64(9223372036854776833))\n" +
    "const GREET = \"hello\" + \" world\"\n" +
    "const EMPTY: []u8 = []\n" +
    "const BYTES: []u8 = [b'a', b'b', b'c', b'd']\n" +
    "const FIXED: [i32; N] = [10, 20, 30, 40]\n" +
    "const ZEROS = [0; M]\n" +
    "struct Packet { buf: [u8; N] }\n" +
    "fn sum_slice(s: &[]i32) -> i32 { mut t := 0; for v in s { t += v }; t }\n" +
    "fn sum_fixed(s: &[i32; 4]) -> i32 { s[0] + s[1] + s[2] + s[3] }\n" +
    "fn main() {\n" +
    "    assert(M == 9 && NEG < 0 && BIG_I64 < 0 && U8_V == u8(255))\n" +
    "    assert(U64_V / u64(3) > u64(0) && OK && RUNE_V == `å`)\n" +
    "    assert(F32_V == f32(3.75) && F64_V == -7.0 && GREET == \"hello world\")\n" +
    "    assert(NEG_LESS && NEG_FLOAT == f32(-3.25) && SIGN_ZERO.is_sign_negative())\n" +
    "    assert(I32_LOW == -2147483648 && U8_ZERO == u8(0) && U64_HIGH == u64(9223372036854775808))\n" +
    "    assert(TIE_PLUS_ONE.to_bits() == 4890909195324358657)\n" +
    "    assert(EMPTY.len == 0 && BYTES.len == 4 && BYTES[2] == b'c')\n" +
    "    assert(ZEROS.len == 9 && ZEROS[8] == 0)\n" +
    "    assert(m.PUB_VAL == 77 && m.PUB_TABLE[1] == 22)\n" +
    "    mut sum := 0\n" +
    "    for v in FIXED { sum += v }\n" +
    "    assert(sum == 100 && sum_fixed(&FIXED) == 100 && sum_slice(&FIXED[1..3]) == 50)\n" +
    "    mut copy := FIXED\n" +
    "    copy[0] = 5\n" +
    "    assert(copy[0] == 5 && FIXED[0] == 10)\n" +
    "    mut cloned := BYTES.clone()\n" +
    "    cloned.push(b'e')\n" +
    "    assert(cloned.len == 5 && BYTES.len == 4)\n" +
    "    pkt := Packet { buf: [BYTES[0], BYTES[1], BYTES[2], BYTES[3]] }\n" +
    "    assert(pkt.buf[3] == b'd')\n" +
    "    print(42)\n" +
    "}\n"
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    mod_src := "pub const PUB_VAL: i32 = 77\npub const PUB_TABLE: []i32 = [11, 22, 33]\nconst PRIV: i32 = 9\n"
    if !sys.write_text(work + "/consts_mod.ddr", mod_src).ok { return false }
    main_path := work + "/const_main.ddr"
    if !sys.write_text(main_path, positive_program()).ok { return false }
    if !harness.run_specialization_matrix(cli.compiler, main_path, work, "42\n") { return false }
    cases := invalid_cases()
    if !harness.check_rejected_specializations(cli.compiler, work, &cases) { return false }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-const-")
    if !tmp.ok { return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
