capability filesystem

import .harness as harness
import .range_analysis_model as export
import .range_analysis_oracle as oracle
import std.json as json
import sys

pub struct Counts {
    cases: i64, runs: i64, accesses: i64, reached_bounds: i64, reached_arithmetic: i64, reached_new: i64,
    checks: i64, new_checks: i64, incomplete: i64, maximum: i64, outcomes: [i64; 4],
}

pub fn counts() -> Counts {
    Counts { cases: 0, runs: 0, accesses: 0, reached_bounds: 0, reached_arithmetic: 0, reached_new: 0,
        checks: 0, new_checks: 0, incomplete: 0, maximum: 0, outcomes: [0, 0, 0, 0] }
}

impl Counts {
    pub fn add(&mut self, other: &Counts) {
        self.cases += other.cases
        self.runs += other.runs
        self.accesses += other.accesses
        self.reached_bounds += other.reached_bounds
        self.reached_arithmetic += other.reached_arithmetic
        self.reached_new += other.reached_new
        self.checks += other.checks
        self.new_checks += other.new_checks
        self.incomplete += other.incomplete
        if other.maximum > self.maximum { self.maximum = other.maximum }
        for i in 0..self.outcomes.len { self.outcomes[i] += other.outcomes[i] }
    }

    fn write_outcomes(&self, writer: &mut json.Writer) {
        writer.object()
        labels := ["return", "trap_101", "trap_102", "trap_103"]
        for i in 0..labels.len {
            if self.outcomes[i] != 0 { writer.key(labels[i]); writer.integer(self.outcomes[i]) }
        }
        writer.end()
    }

    fn write_case(&self, writer: &mut json.Writer) {
        writer.key("arithmetic_checks"); writer.integer(self.checks)
        writer.key("new_arithmetic_checks"); writer.integer(self.new_checks)
        writer.key("reached_arithmetic_nodes"); writer.integer(self.reached_arithmetic)
        writer.key("reached_new_arithmetic_nodes"); writer.integer(self.reached_new)
        writer.key("incomplete"); writer.integer(self.incomplete)
        writer.key("outcomes"); self.write_outcomes(&mut writer)
    }

    fn write_cohort(&self, writer: &mut json.Writer) {
        writer.object()
        writer.key("cases"); writer.integer(self.cases)
        writer.key("runs"); writer.integer(self.runs)
        writer.key("accesses"); writer.integer(self.accesses)
        writer.key("maximum_completed_fuel"); writer.integer(self.maximum)
        writer.key("reached_bounds_nodes"); writer.integer(self.reached_bounds)
        self.write_case(&mut writer)
        writer.end()
    }

    pub fn text(&self) -> string {
        mut writer := json.Writer::new()
        self.write_cohort(&mut writer)
        writer.finish().unwrap_or("")
    }
}

pub struct CaseResult {
    name: string, cohort: i32, source: string, models: []export.Model, bounds: []i64, arithmetic: []i64, counts: Counts,
}

pub struct Failure { name: string, mode: string, source: string, input: oracle.Input, model: export.Model, error: string }

pub struct Report {
    hashes: Map<string, string>, fuel: i64, cases: []CaseResult, cohorts: []Counts, selected: []bool, failure: Failure,
}

pub fn report(fuel: i64) -> Report {
    Report { hashes: Map<string, string>::new(), fuel: fuel, cases: [], cohorts: [counts(), counts()], selected: [false, false],
        failure: Failure { name: "", mode: "", source: "", input: oracle.Input { arrays: [], n: 0, m: 0, x: 0, flag: false, aliased: false },
            model: export.model(), error: "" } }
}

pub fn cohort_name(index: i32) -> string { if index == 0 { "bounds_original" } else { "arithmetic_boundaries" } }

pub fn model_name(index: i32) -> string {
    labels := ["raw_0", "raw_64", "raw_131072", "simplified_0", "simplified_64", "simplified_131072"]
    labels[index].clone()
}

impl Report {
    pub fn totals(&self) -> Counts {
        mut total := counts()
        for cohort in self.cohorts { total.add(&cohort) }
        total
    }
}

fn write_failure(failure: &Failure, writer: &mut json.Writer) {
    writer.object()
    writer.key("case"); writer.string(failure.name)
    writer.key("mode"); writer.string(failure.mode)
    writer.key("source"); writer.string(failure.source)
    writer.key("arguments"); writer.array()
    for i in 0..3 {
        writer.array()
        root := if failure.input.aliased { 0 } else { i }
        for value in failure.input.arrays[root] { writer.integer(value) }
        writer.end()
    }
    writer.integer(failure.input.n)
    writer.integer(failure.input.m)
    writer.integer(failure.input.x)
    writer.boolean(failure.input.flag)
    writer.end()
    writer.key("model"); failure.model.write(&mut writer)
    writer.key("error"); writer.string(failure.error)
    writer.end()
}

fn write_case(case: &CaseResult, writer: &mut json.Writer) {
    writer.object()
    writer.key("cohort"); writer.string(cohort_name(case.cohort))
    writer.key("source"); writer.string(case.source)
    writer.key("models"); writer.object()
    for i in 0..case.models.len {
        writer.key(model_name(i))
        case.models[i].write(&mut writer)
    }
    writer.end()
    writer.key("proof_nodes"); writer.object()
    for i in 0..case.bounds.len { writer.key(model_name(i)); writer.integer(case.bounds[i]) }
    writer.end()
    writer.key("arithmetic_proof_nodes"); writer.object()
    for i in 0..case.arithmetic.len { writer.key(model_name(i)); writer.integer(case.arithmetic[i]) }
    writer.end()
    writer.key("reached_proof_nodes"); writer.integer(case.counts.reached_bounds)
    case.counts.write_case(&mut writer)
    writer.end()
}

pub fn save(path: string, report: &Report, finished: bool) -> bool {
    if path.len == 0 { return true }
    total := report.totals()
    mut writer := json.Writer::new()
    writer.object()
    writer.key("complete"); writer.boolean(finished && total.incomplete == 0)
    writer.key("fuel"); writer.integer(report.fuel)
    writer.key("hashes"); writer.object()
    for i in 0..report.hashes.len() { writer.key(report.hashes.key_at(i)); writer.string(report.hashes.value_at(i)) }
    writer.end()
    writer.key("limitations"); writer.array()
    for limitation in ["finite frozen input domain", "fuel limit", "interpreter, not target machine code",
                       "same-storage root inputs overapproximate source borrow capabilities"] { writer.string(limitation) }
    writer.end()
    writer.key("cases"); writer.object()
    for case in report.cases { writer.key(case.name); write_case(&case, &mut writer) }
    writer.end()
    writer.key("cohorts"); writer.object()
    for i in 0..report.cohorts.len {
        if report.selected[i] { writer.key(cohort_name(i)); report.cohorts[i].write_cohort(&mut writer) }
    }
    writer.end()
    if finished {
        writer.key("runs"); writer.integer(total.runs)
        writer.key("accesses"); writer.integer(total.accesses)
        writer.key("reached_proof_nodes"); writer.integer(total.reached_bounds)
        writer.key("arithmetic_checks"); writer.integer(total.checks)
        writer.key("new_arithmetic_checks"); writer.integer(total.new_checks)
        writer.key("incomplete"); writer.integer(total.incomplete)
        writer.key("maximum_completed_fuel"); writer.integer(total.maximum)
    }
    if report.failure.error.len != 0 { writer.key("failure"); write_failure(&report.failure, &mut writer) }
    writer.end()
    document := writer.finish()
    (document.is_ok() && sys.write_text(path, document.unwrap_or("") + "\n").ok) || harness.fail(f"cannot write report {path}")
}
