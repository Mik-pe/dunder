capability process, filesystem

import .harness as harness
import std.fs as fs
import std.parse as parse
import std.process as process
import sys

fn splitlines(s: string) -> []string {
    var lines: []string = []
    var i := 0
    while i < s.len {
        start := i
        while i < s.len && s[i] != 10 && s[i] != 13 { i += 1 }
        lines.push(s[start..i])
        if i < s.len {
            if s[i] == 13 && i + 1 < s.len && s[i + 1] == 10 {
                i += 2
            } else {
                i += 1
            }
        }
    }
    lines
}

fn parse_counters(text_out: string, dst: &mut []i64) -> bool {
    dst.clear()
    lines := splitlines(text_out)
    if lines.len != 4 { return false }
    for line in lines {
        p := parse.integer(line)
        if !p.ok { return false }
        dst.push(p.value)
    }
    true
}

fn arithmetic_proofs(name: string) -> i32 {
    if name == "sum" { return 1 }
    if name == "insertion" { return 3 }
    if name == "reverse" { return 3 }
    if name == "unsafe_offset" { return 1 }
    if name == "break_exit" { return 1 }
    if name == "guarded_arithmetic" { return 4 }
    if name == "guarded_negate" { return 1 }
    if name == "parent_after_child" { return 1 }
    0
}

fn build_weighted() -> string {
    var out := ""
    for i in 0..8 {
        if i > 0 { out += "+" }
        out += "p0[" + i.str() + "]*" + (i + 1).str()
    }
    out
}

fn run_case(cli: &harness.BaseCli, work: string, emitter: string, host: i32, name: string, body: string, first: i32, arguments: &[]i32, expected: i32, status: i32, length: i32, reads: i32, stores: i32, cases_run: &mut i32) -> bool {
    source := work + "/" + name + ".ddr"
    if !sys.write_text(source, "p0 p1 p2 p3 p4 p5 p6 p7 " + body).ok {
        return harness.fail("failed to write " + source)
    }
    var res := harness.empty_output()
    var no_args: []string = []
    arithmetic := arithmetic_proofs(name)
    for target in 0..3 {
        var cnt_none: []i64 = []
        var cnt_range: []i64 = []
        var cnt_budget: []i64 = []
        var img_none: []u8 = []
        var img_range: []u8 = []
        var img_budget: []u8 = []
        for mode in ["none", "range", "budget"] {
            image := work + "/" + name + "-" + target.str() + "-" + mode
            var p_reads := 0
            var p_stores := 0
            var p_arith := 0
            if mode == "range" {
                p_reads = reads
                p_stores = stores
                p_arith = arithmetic
            }
            var args: []string = [source, image, target.str(), expected.str(), "2", first.str()]
            for a in arguments { args.push(a.str()) }
            args.push(length.str())
            args.push(mode)
            args.push(p_reads.str())
            args.push(p_stores.str())
            args.push(p_arith.str())
            if !harness.run_checked(emitter, args, work, 0, false, &mut res) {
                return false
            }
            out_str := process.stdout_text(&res)
            raw := sys.read_u8(image)
            if !raw.ok {
                return harness.fail("failed to read image: " + image)
            }
            if mode == "none" {
                if !parse_counters(out_str, &mut cnt_none) {
                    return harness.fail(name + "/" + target.str() + "/none: invalid counters: " + out_str)
                }
                img_none = raw.value
            } else if mode == "range" {
                if !parse_counters(out_str, &mut cnt_range) {
                    return harness.fail(name + "/" + target.str() + "/range: invalid counters: " + out_str)
                }
                img_range = raw.value
            } else {
                if !parse_counters(out_str, &mut cnt_budget) {
                    return harness.fail(name + "/" + target.str() + "/budget: invalid counters: " + out_str)
                }
                img_budget = raw.value
            }
            if target == host {
                if !harness.run_checked(image, no_args, work, status, false, &mut res) {
                    return false
                }
            }
        }
        if cnt_none[0] - cnt_range[0] != i64(reads + stores) {
            return harness.fail(name + "/" + target.str() + ": bounds checks removed mismatch")
        }
        if cnt_none[1] - cnt_range[1] != i64(2 * arithmetic) {
            return harness.fail(name + "/" + target.str() + ": i32 checks removed mismatch")
        }
        if cnt_none[2] != cnt_range[2] {
            return harness.fail(name + "/" + target.str() + ": zero checks changed")
        }
        if cnt_range[3] != i64(arithmetic) {
            return harness.fail(name + "/" + target.str() + ": arithmetic proof count mismatch")
        }
        if !harness.bytes_equal(&img_none, &img_budget) {
            return harness.fail(name + "/" + target.str() + ": budget fallback changed code")
        }
        changed := !harness.bytes_equal(&img_none, &img_range)
        expected_changed := (reads + stores + arithmetic) > 0
        if changed != expected_changed {
            return harness.fail(name + "/" + target.str() + ": proofs did not change emitted code")
        }
    }
    print("PASS " + name + " all three native targets; host executed; exact bounds/i32 removal; zero checks unchanged")
    cases_run += 1
    true
}

fn run_in_work(cli: &harness.BaseCli, work: string, cases_run: &mut i32) -> bool {
    emitter := work + "/emitter"
    var res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/range-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    host := harness.host_id()
    params: []i32 = [5, 0, 11, 13, 17, 19, 23, 29]
    args_neg1: []i32 = [5, -1, 11, 13, 17, 19, 23, 29]
    args_neg1_0: []i32 = [5, -1, 0, 13, 17, 19, 23, 29]
    args_0_0: []i32 = [5, 0, 0, 13, 17, 19, 23, 29]
    args_max: []i32 = [5, 2147483647, 11, 13, 17, 19, 23, 29]
    args_one: []i32 = [5, 1, 11, 13, 17, 19, 23, 29]
    args_five: []i32 = [5, 5, 11, 13, 17, 19, 23, 29]
    weighted := build_weighted()

    if !run_case(&cli, work, emitter, host, "sum", "{var cursor:=0;var total:i64=0;while cursor<p0.len{total=total+p0[cursor];cursor=cursor+1};total}", 20, &params, 42, 0, 8, 1, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "insertion", "{for cursor in 1..p0.len{item:=p0[cursor];var hole:=cursor;while hole>0&&p0[hole-1]>item{p0[hole]=p0[hole-1];hole=hole-1};p0[hole]=item};" + weighted + "}", 21, &params, 311, 0, 8, 3, 2, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "reverse", "{var left:=0;var right:=p0.len-1;while left<right{item:=p0[left];p0[left]=p0[right];p0[right]=item;left=left+1;right=right-1};" + weighted + "}", 21, &params, 159, 0, 8, 2, 2, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "increment", "{for cursor in 0..p0.len{p0[cursor]=p0[cursor]+1};var total:i64=0;for cursor in 0..p0.len{total=total+p0[cursor]};total}", 21, &params, 50, 0, 8, 2, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "guard_join", "{if p1>=0&&p1<p0.len{p0[p1]=p0[p1]+1};p0[p1]}", 21, &params, 4, 0, 8, 1, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "early_return", "{if p1<0||p1>=p0.len{return 0};p0[p1]}", 21, &args_neg1, 0, 0, 8, 1, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "lhs_first", "{p0[p1]=p0[0]/p2;0}", 21, &args_neg1_0, 0, 103, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "rhs_zero", "{if p1>=0&&p1<p0.len{p0[p1]=p0[p1]/p2};0}", 21, &args_0_0, 0, 102, 8, 1, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "rhs_bounds", "{if p1>=0&&p1<p0.len{p0[p1]=p0[p1+8]};0}", 21, &params, 0, 103, 8, 0, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "shortcircuit_order", "{if p0[p1]>0&&p1>=0&&p1<p0.len{p0[p1]=0};0}", 21, &args_neg1, 0, 103, 8, 0, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "unsafe_offset", "{for cursor in 0..p0.len{p0[cursor+1]=0};0}", 21, &params, 0, 103, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "index_overflow", "{p0[p1+1]=0;0}", 21, &args_max, 0, 101, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "snapshot", "{var high:=p0.len;for cursor in 0..high{high=0;p0[cursor]=0};for cursor in 0..p0.len{if p0[cursor]!=0{return 1}};0}", 21, &params, 0, 0, 8, 1, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "break_exit", "{for cursor in 0..p0.len{var target:=cursor;while target>0{target=target-1;if p1>0{target=-1;break};p0[target]=0};p0[target]=0};0}", 21, &args_one, 0, 103, 8, 0, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "empty", "{for cursor in 0..p0.len{p0[cursor]=p0[cursor]+1};0}", 21, &params, 0, 0, 0, 1, 1, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "negative_backedge", "{var cursor:=0;while cursor<p0.len{p0[cursor]=0;cursor=-1};0}", 21, &params, 0, 103, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "guarded_arithmetic", "{if p1>=-10&&p1<=10{small:=p1+3;squared:=small*small;negative:=-small;difference:=squared-negative;if difference==12{return 42}};0}", 20, &params, 42, 0, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "guarded_negate", "{if p1<=-2147483648{return 0};small:=-p1;if small == -5{return 42};0}", 20, &args_five, 42, 0, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "parent_after_child", "{if p1>=0{small:=(p1+1)*0;if small==0{return 42}};0}", 20, &args_max, 0, 101, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "bottom_product", "{small:=(2147483647*2147483647)*0;0}", 20, &params, 0, 101, 8, 0, 0, &mut cases_run) { return false }
    if !run_case(&cli, work, emitter, host, "bottom_add", "{small:=(2147483647+1)*0;0}", 20, &params, 0, 101, 8, 0, 0, &mut cases_run) { return false }

    for mode in ["idle", "twice", "shape", "budget-apply"] {
        guard_src := work + "/guard.ddr"
        if !sys.write_text(guard_src, "p0 p1 p2 p3 p4 p5 p6 p7 {for cursor in 0..p0.len{p0[cursor]=0};0}").ok {
            return harness.fail("failed to write " + guard_src)
        }
        var args: []string = [guard_src, work + "/unused", host.str(), "0", "2", "21"]
        for p in params { args.push(p.str()) }
        args.push("8")
        args.push(mode)
        args.push("0")
        args.push("0")
        args.push("0")
        if !harness.run_checked(emitter, args, work, 104, false, &mut res) {
            return false
        }
        print("PASS " + mode + " rejected")
    }
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len != 0 {
        return harness.fail("unexpected extra arguments")
    }
    td := fs.temp_dir("dunder-range-analysis-")
    if !td.ok { return harness.fail("temp_dir failed") }
    var cases_run := 0
    ok := run_in_work(&cli, td.value, &mut cases_run)
    _ := fs.remove_all(td.value)
    if !ok { return false }
    print(cases_run.str() + " runtime cases verified; invalid apply lifecycles rejected")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
