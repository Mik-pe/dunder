capability process, filesystem, stdio

import .harness as harness
import .native_probe as native
import .probe_cli as cli
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn check_runtime(runners: &native.Runners, target: string, image: string, root: string) -> bool {
    mut result := harness.empty_output()
    if !runners.run(target, image, [], root, 0, &mut result) { return false }
    output := result.stdout_text()
    lines := harness.lines(output)
    if result.stderr.len != 0 || lines.len != 2 || !text.starts_with(lines[0], "$argon2id$v=19$m=19456,t=2,p=1$") || lines[1] != "crypto ok" {
        return harness.fail(f"{target}: unexpected crypto output:\n{output}\n{result.stderr_text()}")
    }
    if target == process.host_target() {
        mut command := process.Command::new(image.clone(), ["missing-providers"])
        command.set_env("DUNDER_CRYPTO_LIB", image + ".missing")
        command.set_env("DUNDER_ARGON2_LIB", image + ".missing")
        missing := command.exec()
        if !missing.ok || missing.code != 0 || missing.signal != 0 || missing.stderr.len != 0 {
            return harness.fail("missing cryptographic providers: " + missing.stderr_text())
        }
    }
    true
}

fn check_random(compiler: string, root: string, work: string, runners: &native.Runners) -> bool {
    mut output := harness.empty_output()
    for target in ["arm64-macos", "arm64-linux", "x86_64-linux", "x86_64-windows", "wasm32", "wasm32-wasi"] {
        image := work + "/random-" + target
        if !harness.run_checked(compiler, ["build", root + "/tests/random.ddr", "--target", target.clone(), "-o", image.clone()], root, 0, false, &mut output) { return false }
        if text.ends_with(target, "-linux") {
            file := sys.read_u8(image)
            if !file.ok || !native.static_elf(&file.value) { return harness.fail(target + " random needs dynamic libraries") }
        }
        if runners.can_run(target) && !runners.run(target, image, [], root, 0, &mut output) { return false }
        if target == "wasm32" && !harness.run_wasm_image(image, root, 20, 0, 90000, &mut output) { return false }
    }
    true
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--runner")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_crypto <compiler> [--runner TARGET=COMMAND]")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    specs := args.all("--runner")
    runners := native.Runners::new(&specs)
    if runners.error.len != 0 { _ := sys.eprint(runners.error); return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("could not locate Dunder repository root"); return 1 }
    tmp := fs.temp_dir("dunder-crypto-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    counts := native.library_images(compiler, root, work, "crypto", root + "/tests/crypto.ddr", &runners, check_runtime)
    if !counts.ok || !check_random(compiler, root, work, &runners) { return 1 }
    print(f"crypto: {counts.builds} native images, {counts.executions} target executions; AES-GCM/HMAC/HKDF vectors, Argon2id, random, tampering and bounds passed")
    0
}
