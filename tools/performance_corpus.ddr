capability filesystem

import .harness as harness
import ..selfhost.frontend.lexer as lexer
import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.text as text
import sys

pub struct Kernel {
    name: string,
    arguments: []string,
    expected: string,
}

pub struct Corpus {
    path: string,
    lines: i64,
    source_bytes: i64,
    modules: i64,
    functions: i64,
    tokens: i64,
    sha256: string,
    error: string,
}

pub struct SourceHash {
    path: string,
    sha256: string,
}

pub struct Snapshot {
    files: []SourceHash,
    error: string,
}

fn kernel(name: string, iterations: i64, argument: string, expected: i64) -> Kernel {
    Kernel { name: name.clone(), arguments: [iterations.str(), argument.clone()], expected: expected.str() + "\n" }
}

pub fn runtime_cases(scale: i32) -> []Kernel {
    seed: i64 = 1729
    numeric_runs := i64(scale) * 1000000
    scan_runs := i64(scale) * 3000
    text_runs := i64(scale) * 2000
    sort_runs := i64(scale) * 120

    mut numeric: i64 = 0
    mut value := seed
    mut iteration: i64 = 0
    while iteration < numeric_runs {
        value = (value * 1664525 + 1013904223) % 2147483647
        numeric += value
        iteration += 1
    }

    mut values: []i64 = []
    mut sum: i64 = 0
    for i in 0..1024 {
        initial := (i64(i) * 17 + seed) % 1009
        values.push(initial)
        sum += initial
    }
    mut scan: i64 = 0
    iteration = 0
    while iteration < scan_runs {
        at := i32(iteration % 1024)
        sum += iteration - values[at]
        values[at] = iteration
        scan += sum
        iteration += 1
    }

    phrase := "Dunder läser UTF-8: åäö, Ελληνικά och 🌍.\nSäkra värden överlever sina anrop; loopar räknar byte och runor.\tNative kod utan externa byggverktyg. "
    sample := phrase + phrase + phrase + phrase
    mut scalars: i64 = 0
    mut words: i64 = 0
    mut inside := false
    for scalar in sample.runes() {
        point := i64(i32(scalar))
        scalars += point
        if point == 32 || point == 10 || point == 9 { inside = false }
        else if !inside { words += 1; inside = true }
    }

    mut sorted_result: i64 = 0
    iteration = 0
    while iteration < sort_runs {
        values.clear()
        for i in 0..256 { values.push((i64(255 - i) * 17 + seed + iteration) % 1009) }
        array.sort(&mut values)
        for i in 0..values.len { sorted_result += values[i] * i64(i + 1) }
        iteration += 1
    }
    [
        kernel("numeric", numeric_runs, seed.str(), numeric),
        kernel("scan", scan_runs, seed.str(), scan),
        kernel("text", text_runs, sample, (words * 1000000 + scalars) * text_runs),
        kernel("sort", sort_runs, seed.str(), sorted_result),
    ]
}

fn write_source(path: string, data: &[]u8) -> bool {
    sys.write_u8(path, &data).ok || harness.fail(f"cannot write {path}")
}

fn invalid_corpus(error: string) -> Corpus {
    Corpus { path: "", lines: 0, source_bytes: 0, modules: 0, functions: 0, tokens: 0, sha256: "", error: error.clone() }
}

pub fn generate(work: string) -> Corpus {
    root := work + "/corpus"
    if !sys.mkdir(root).ok { return invalid_corpus(f"cannot create {root}") }
    mut main: []u8 = []
    for module in 0..20 { bytes.append_utf8(&mut main, f"import m{module}\n") }
    bytes.append_utf8(&mut main, "fn main() {\n    mut total: i64 = 0\n")
    mut body: []u8 = []
    for _ in 0..96 { bytes.append_utf8(&mut body, "    value = value + 1\n") }
    mut source: []u8 = []
    for module in 0..20 {
        source.clear()
        for function in 0..50 {
            bytes.append_utf8(&mut source, f"pub fn item{function}(x: i64) -> i64 {{\n    mut value := x\n")
            bytes.extend(&mut source, &body)
            bytes.append_utf8(&mut source, "    return value\n}\n")
            argument := module * 50 + function
            bytes.append_utf8(&mut main, f"    total = total + m{module}.item{function}({argument})\n")
        }
        if !write_source(f"{root}/m{module}.ddr", &source) { return invalid_corpus("cannot generate workload module") }
    }
    bytes.append_utf8(&mut main, "    print(total)\n}\n")
    entry := root + "/main.ddr"
    if !write_source(entry, &main) { return invalid_corpus("cannot generate workload entry point") }

    files := fs.list_dir(root)
    if !files.ok { return invalid_corpus(f"cannot list {root}") }
    mut result := Corpus { path: entry, lines: 0, source_bytes: 0, modules: 0, functions: 0, tokens: 0, sha256: "", error: "" }
    mut serialized: []u8 = []
    for file in files.entries {
        document := sys.read_text(root + "/" + file)
        if !document.ok { return invalid_corpus(f"cannot read generated source: {file}") }
        for column in 0..document.value.len {
            if document.value[column] == 10 { result.lines += 1 }
        }
        result.source_bytes += i64(document.value.len)
        result.modules += 1
        tokens := lexer.scan(document.value, false)
        if !tokens.ok { return invalid_corpus(f"invalid generated source: {file}") }
        for i in 0..tokens.kinds.len {
            kind := tokens.kinds[i]
            if kind == .End || lexer.is_newline(kind) { continue }
            result.tokens += 1
            if tokens.texts[i] == "fn" { result.functions += 1 }
        }
        bytes.append_utf8(&mut serialized, document.value)
    }
    result.sha256 = harness.sha256_bytes_hex(&serialized)
    result
}

impl Corpus {
    pub fn write(&self, writer: &mut json.Writer) {
        writer.object()
        writer.key("lines"); writer.integer(self.lines)
        writer.key("source_bytes"); writer.integer(self.source_bytes)
        writer.key("modules"); writer.integer(self.modules)
        writer.key("functions"); writer.integer(self.functions)
        writer.key("tokens"); writer.integer(self.tokens)
        writer.key("sha256"); writer.string(self.sha256)
        writer.end()
    }
}

pub fn collect_ddr_paths(root: string, folder: string, descend: bool, paths: &mut []string) -> bool {
    contents := fs.list_dir(root + "/" + folder)
    if !contents.ok { return harness.fail(f"cannot list {folder}") }
    for name in contents.entries {
        path := folder + "/" + name
        metadata := sys.metadata(root + "/" + path)
        if metadata.is_dir && descend && !fs.is_symlink(root + "/" + path) {
            if !collect_ddr_paths(root, path, true, &mut paths) { return false }
        } else if metadata.is_file && text.ends_with(name, ".ddr") {
            paths.push(move path)
        }
    }
    true
}

pub fn snapshot(root: string) -> Snapshot {
    source_snapshot(root, false)
}

pub fn selfhost_snapshot(root: string) -> Snapshot {
    source_snapshot(root, true)
}

fn source_snapshot(root: string, nested_libraries: bool) -> Snapshot {
    mut files: []string = ["benchmarks/runtime/reference.c"]
    for folder in ["selfhost", "stdlib", "runtime", "benchmarks/runtime"] {
        descend := folder == "selfhost" || (nested_libraries && (folder == "stdlib" || folder == "runtime"))
        if !collect_ddr_paths(root, folder, descend, &mut files) {
            return Snapshot { files: [], error: "cannot enumerate source tree" }
        }
    }
    array.sort_strings(&mut files)
    mut hashes: []SourceHash = []
    for path in move files {
        sha256 := harness.sha256_file_hex(root + "/" + path)
        if sha256.len == 0 { return Snapshot { files: [], error: f"cannot hash {path}" } }
        hashes.push(SourceHash { path: path, sha256: sha256 })
    }
    Snapshot { files: hashes, error: "" }
}

pub fn same_sources(before: &[]SourceHash, after: &[]SourceHash) -> bool {
    if before.len != after.len { return false }
    for i in 0..before.len {
        if before[i].path != after[i].path || before[i].sha256 != after[i].sha256 { return false }
    }
    true
}

pub fn write_sources(hashes: &[]SourceHash, writer: &mut json.Writer) {
    writer.object()
    for hash in hashes {
        writer.key(hash.path)
        writer.string(hash.sha256)
    }
    writer.end()
}
