capability process, filesystem

import .harness as harness
import std.fs as fs
import std.parse as parse
import std.process as process
import sys

fn is_ws(b: i32) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

fn split_ws(s: string) -> []string {
    var out: []string = []
    var i := 0
    while i < s.len {
        while i < s.len && is_ws(s[i]) { i += 1 }
        if i >= s.len { break }
        start := i
        while i < s.len && !is_ws(s[i]) { i += 1 }
        out.push(s[start..i])
    }
    out
}

fn path_exists(path: string) -> bool {
    sys.metadata(path).ok || fs.is_symlink(path)
}

fn expected_status(selected: i32) -> i32 {
    if selected == 3 || selected == 5 || selected == 8 { return 101 }
    if selected == 4 { return 102 }
    0
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    emitter := work + "/emitter"
    var res := harness.empty_output()
    var no_args: []string = []
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/inline-catalog-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    host := harness.host_id()
    for selected in [0, 1, 2, 3, 4, 5, 6, 7, 8, 11, 12] {
        status := expected_status(selected)
        for target in 0..3 {
            for mode in ["off", "on"] {
                image := work + "/" + selected.str() + "-" + target.str() + "-" + mode
                if !harness.run_checked(emitter, [image, target.str(), mode, selected.str()], work, 0, false, &mut res) {
                    return false
                }
                fields := split_ws(process.stdout_text(&res))
                if fields.len != 2 {
                    return harness.fail("expected 2 integers from inline-catalog emitter, got: " + process.stdout_text(&res))
                }
                actual := parse.integer(fields[0])
                estimate := parse.integer(fields[1])
                if !actual.ok || !estimate.ok {
                    return harness.fail("invalid word count output: " + process.stdout_text(&res))
                }
                if !(actual.value > 0 && actual.value <= estimate.value) {
                    return harness.fail("word estimate did not bound emitted staging/expression")
                }
                if target == host {
                    if !harness.run_checked(image, no_args, work, status, false, &mut res) {
                        return false
                    }
                }
            }
        }
    }
    for refused in [9, 10] {
        image := work + "/refused-" + refused.str()
        if !harness.run_checked(emitter, [image, host.str(), "on", refused.str()], work, 0, false, &mut res) {
            return false
        }
        if path_exists(image) {
            return harness.fail("refused placement changed/published Code")
        }
    }
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len != 0 {
        return harness.fail("unexpected extra arguments")
    }
    td := fs.temp_dir("dunder-inline-catalog-")
    if !td.ok { return harness.fail("temp_dir failed") }
    ok := run_in_work(&cli, td.value)
    _ := fs.remove_all(td.value)
    if !ok { return false }
    print("inline catalog: native targets, rebased entries, word bounds, canonical homes, caller slots/ABI, traps and untouched fallback passed")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
