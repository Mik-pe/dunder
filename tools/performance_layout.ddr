capability filesystem, process, stdio

import .benchmark_commands as bench
import .benchmark_time as time
import .harness as harness
import std.fs as fs
import std.parse as parse
import sys

fn sample_weight(i: i32, seed: i32, elapsed: i32) -> i64 {
    t := match elapsed % 3 { 1 => 1, 2 => -1, _ => 0 }
    x := (i * 3 + seed) % 127 + t * (i % 11 - 5)
    y := (i * 5 + seed) % 61 + t * (i % 7 - 3)
    i64(i % 13 + 1) * i64(x + 17 * y)
}

fn expected(frames: i32, seed: i32) -> []u8 {
    mut value: i64 = 0
    for frame in 0..frames { value += sample_weight(frame % 4099, seed, frame + 1) }
    for i in 0..4099 { value += sample_weight(i, seed, frames) }
    bench.raw(value.str() + "\n")
}

fn measure(compiler: string, root: string, work: string, rounds: i32) -> bool {
    mut commands := bench.commands(work, 120000)
    names := ["columns", "rows"]
    frames := 101
    seed := 1729
    answer := expected(frames, seed)
    mut output := harness.empty_output()
    print("round,order,layout,build_ms,run_ms")
    for round in 0..rounds + 1 {
        for order in 0..2 {
            layout := &names[(round + order) % 2]
            source := root + "/benchmarks/layout/" + layout + ".ddr"
            image := work + "/" + layout + "-" + round.str()
            mut build_ns: i64 = 0
            mut run_ns: i64 = 0
            if !commands.run([compiler.clone(), "build", source.clone(), "--jobs", "1", "-o", image.clone()],
                             false, true, &mut output, &mut build_ns) { return false }
            if round == 0 {
                for warm_frames in 0..4 {
                    warm_answer := expected(warm_frames, 185)
                    if !commands.checked([image.clone(), warm_frames.str(), "185"], &warm_answer, false,
                                         &mut run_ns) { return false }
                }
            }
            if !commands.checked([image.clone(), frames.str(), seed.str()], &answer, true, &mut run_ns) { return false }
            if round > 0 {
                print(f"{round},{order},{layout},{time.fixed_ms(build_ns)},{time.fixed_ms(run_ns)}")
            }
            if !sys.remove_file(image).ok { return false }
        }
    }
    true
}

fn main() -> i32 {
    if sys.arg_count() < 2 || sys.arg_count() > 3 {
        _ := sys.eprint("usage: performance_layout COMPILER [ROUNDS]")
        return 2
    }
    rounds := if sys.arg_count() == 3 { parse.value<i32>(sys.arg(2)).unwrap_or(0) } else { 30 }
    if rounds < 1 || rounds > 1000 { _ := sys.eprint("rounds must be 1..1000"); return 2 }
    root := harness.find_root()
    if root == "" { _ := sys.eprint("cannot locate Dunder repository"); return 1 }
    compiler := fs.realpath(sys.arg(1))
    if !compiler.ok { _ := sys.eprint("cannot locate compiler"); return 1 }
    tmp := fs.temp_dir("dunder-layout-")
    if !tmp.ok { _ := sys.eprint("cannot create temporary directory"); return 1 }
    defer { _ := fs.remove_all(tmp.value) }
    if measure(compiler.value, root, tmp.value, rounds) { 0 } else { 1 }
}
