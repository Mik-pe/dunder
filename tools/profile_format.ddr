import .harness as harness
import std.json as json

pub struct Profile { record: json.Doc, counters: Map<string, u64>, error: string }

pub fn counter_names() -> []string {
    ["allocation_count", "requested_bytes", "size_class_payload_bytes", "fresh_allocations", "reused_allocations",
     "retain_calls", "release_calls", "array_clone_calls", "array_clone_bytes", "string_slice_calls", "string_slice_bytes",
     "record_construct_calls", "record_construct_bytes", "record_clone_calls", "record_clone_bytes", "copy_bytes"]
}

pub fn read(stderr: string) -> Profile {
    mut result := Profile { record: json.Doc::parse_text("null"), counters: Map<string, u64>::new(), error: "" }
    mut records := 0
    for line in harness.lines(stderr) {
        value := json.Doc::parse_text(line)
        if value.ok && value.get_str(value.root, "kind").unwrap_or("") == "runtime_profile" {
            result.record = value
            records += 1
        }
    }
    if records != 1 {
        result.error = f"expected exactly one runtime_profile record, got {records}"
        return result
    }
    root := result.record.root
    units := result.record.field(root, "units")
    counters := result.record.field(root, "counters")
    if result.record.get_i64(root, "version").unwrap_or(0) != 1 || result.record.count(units) != 2 ||
       result.record.get_str(units, "counts").unwrap_or("") != "events" || result.record.get_str(units, "bytes").unwrap_or("") != "bytes" ||
       result.record.get_str(root, "counter_arithmetic").unwrap_or("") != "uint64_modulo" ||
       result.record.get_i64(root, "allocation_header_bytes").unwrap_or(0) != 16 ||
       result.record.get_i64(root, "pool_header_bytes").unwrap_or(0) != 512 ||
       !result.record.get_bool(root, "requested_bytes_exclude_allocator_header").unwrap_or(false) ||
       !result.record.get_bool(root, "size_class_payload_excludes_header").unwrap_or(false) {
        result.error = "unsupported runtime profile semantics"
        return result
    }
    names := counter_names()
    if result.record.kind(counters) != .Object || result.record.count(counters) != names.len {
        result.error = "invalid uint64 runtime counters"
        return result
    }
    for name in names {
        counter := result.record.get_u64(counters, name)
        if counter.is_none() { result.error = f"invalid uint64 runtime counters: {name}"; return result }
        result.counters.put(name.clone(), counter.unwrap())
    }
    if result.counters.at("fresh_allocations").wrapping_add(result.counters.at("reused_allocations")) != result.counters.at("allocation_count") {
        result.error = "allocation classification does not match total"
    }
    result
}
