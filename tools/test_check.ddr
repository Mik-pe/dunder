capability process, filesystem

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

fn split_lines(s: string) -> []string {
    var out: []string = []
    if s.len == 0 { return out }
    raw := text.split(s, "\n")
    var limit := raw.len
    if limit > 0 && raw[limit - 1].len == 0 {
        limit -= 1
    }
    for i in 0..limit {
        var line := raw[i]
        if line.len > 0 && line[line.len - 1] == 13 {
            line = line[0..line.len - 1]
        }
        out.push(line)
    }
    out
}

fn build_cases(case_texts: &mut []string, case_expected: &mut []string) {
    composite := "\n@c_layout struct Packet { tag: u8, pair: [i32; 2] }\n" +
        "struct Box { text: string, values: []i32 }\n" +
        "enum Action { None, Value(Box) }\n" +
        "fn update(packet: &mut Packet) { packet.tag = 7; packet.pair[0] = 17 }\n" +
        "fn worker() -> i32 {\n" +
        "    var packet := Packet { tag: 1, pair: [1, 2] }\n" +
        "    update(&mut packet)\n" +
        "    var values: []i32 = [1, 2]\n" +
        "    values.push(packet.pair[0])\n" +
        "    fixed: [u8; 4] = [7; 4]\n" +
        "    var single: f32 = 0.5\n" +
        "    single = single + 0.25\n" +
        "    assert(single == 0.75)\n" +
        "    action := Action.Value(Box { text: \"å 🌍\", values: values })\n" +
        "    match action {\n" +
        "        .None => { return 0 },\n" +
        "        .Value(box) => { return i32(fixed[0]) + box.values[2] },\n" +
        "    }\n" +
        "}\n"

    foreign := "capability unsafe\n" +
        "@extern(\"probe\", \"echo\") unsafe fn echo(value: i32) -> i32\n" +
        "fn identity(value: i32) -> i32 { value }\n" +
        "fn worker() -> i32 {\n" +
        "    unsafe { callback_value := callback(identity); return echo(42) }\n" +
        "}\n"

    prefixes: []string = [composite, foreign]
    mains: []string = ["fn main(){print(worker())}", "fn main(){print(42)}"]
    for prefix in prefixes {
        for m in mains {
            case_texts.push(prefix + m)
            case_expected.push("")
        }
    }

    var large_buf: []u8 = []
    bytes.append_utf8(&mut large_buf, "fn worker()->i32{\n")
    for i in 0..768 {
        if i > 0 { large_buf.push(b'\n') }
        bytes.append_utf8(&mut large_buf, "value")
        bytes.append_decimal(&mut large_buf, i64(i))
        bytes.append_utf8(&mut large_buf, ":i32=")
        bytes.append_decimal(&mut large_buf, i64(i))
    }
    bytes.append_utf8(&mut large_buf, "\nvar sum:=value767\n")
    for i in 0..1024 {
        if i > 0 { large_buf.push(b'\n') }
        bytes.append_utf8(&mut large_buf, "sum=sum+1")
    }
    large := bytes.decode(&large_buf).value

    case_texts.push(large + "\nreturn sum\n}\nfn main(){print(42)}")
    case_expected.push("")

    case_texts.push(large + "\nsmall:u8=256\nreturn sum\n}\nfn main(){print(42)}")
    case_expected.push("unsigned integer literal out of range")

    err_bodies: []string = [
        "fn worker()->i32{true}",
        "fn worker(){value:=1;value=2}",
        "fn pair(a:&mut i32,b:&i32){}\nfn worker(){var x:=0;pair(&mut x,&x)}",
        "@c_layout struct Bad{value:string}\nfn worker(){}",
    ]
    err_msgs: []string = [
        "type mismatch",
        "assignment requires a mutable stored value",
        "mutable arguments must not alias",
        "C layouts can contain only unmanaged C fields",
    ]
    for i in 0..err_bodies.len {
        body := err_bodies[i]
        expected := err_msgs[i]
        var call_main := "fn main(){worker()}"
        if text.find(body, "worker()->i32") >= 0 {
            call_main = "fn main(){print(worker())}"
        }
        case_texts.push(body + "\n" + call_main)
        case_expected.push(expected)
        case_texts.push(body + "\nfn main(){}")
        case_expected.push(expected)
    }
}

fn check_case(compiler: string, source: string, expected: string, target: string, work: string, baseline: string) -> bool {
    var want_code := 0
    if expected.len > 0 { want_code = 1 }

    result := harness.exec_cmd(compiler, ["check", source, "--agent", "--target", target], work, true, 30000)
    stdout_str := process.stdout_text(&result)
    stderr_str := process.stderr_text(&result)
    if !result.ok || result.timed_out || result.signal != 0 || result.code != want_code {
        return harness.fail("check " + target + ": exited " + result.code.str() + "\n" + stdout_str + "\n" + stderr_str)
    }

    lines := split_lines(stdout_str)
    src_meta := sys.metadata(source)
    if !src_meta.ok { return harness.fail("metadata failed on " + source) }

    if expected.len > 0 {
        if lines.len != 1 {
            return harness.fail("wrong diagnostic record count: " + stdout_str)
        }
        doc := json.parse_text(lines[0])
        if !doc.ok || json.kind(&doc, doc.root) != .Object {
            return harness.fail("invalid diagnostic JSON: " + lines[0])
        }
        kind_f := json.get_str(&doc, doc.root, "kind")
        msg_f := json.get_str(&doc, doc.root, "message")
        start_f := json.get_i64(&doc, doc.root, "start")
        end_f := json.get_i64(&doc, doc.root, "end")
        if !kind_f.ok || kind_f.value != "error" || !msg_f.ok || text.find(msg_f.value, expected) < 0 {
            return harness.fail("wrong diagnostic: " + lines[0])
        }
        if !start_f.ok || !end_f.ok || start_f.value < 0 || start_f.value > end_f.value || end_f.value > src_meta.size {
            return harness.fail("invalid source span: " + lines[0])
        }
    } else {
        if lines.len == 0 {
            return harness.fail("missing successful check: empty stdout")
        }
        for li in 0..lines.len {
            doc := json.parse_text(lines[li])
            if !doc.ok || json.kind(&doc, doc.root) != .Object {
                return harness.fail("invalid check record JSON: " + lines[li])
            }
            if li == lines.len - 1 {
                kind_f := json.get_str(&doc, doc.root, "kind")
                if !kind_f.ok || kind_f.value != "ok" {
                    return harness.fail("missing successful check: " + stdout_str)
                }
            }
        }
    }

    if baseline.len > 0 {
        old := harness.exec_cmd(baseline, ["check", source, "--agent", "--target", target], work, true, 30000)
        if !old.ok || old.timed_out || old.signal != 0 || old.code != result.code ||
           !harness.bytes_equal(&old.stdout, &result.stdout) || !harness.bytes_equal(&old.stderr, &result.stderr) {
            return harness.fail("changed check output for " + harness.basename(source) + " " + target)
        }
    }

    image := work + "/image"
    var prev_marker: []u8 = []
    bytes.append_utf8(&mut prev_marker, "previous output")
    if !sys.write_u8(image, &prev_marker).ok {
        return harness.fail("write_u8 failed on " + image)
    }

    built := harness.exec_cmd(compiler, ["build", source, "--target", target, "-o", image], work, true, 30000)
    if !built.ok || built.timed_out || built.signal != 0 || built.code != result.code {
        return harness.fail("check/build disagree for " + harness.basename(source) + " " + target + ": " + process.stderr_text(&built))
    }

    if expected.len > 0 {
        img_now := sys.read_u8(image)
        if text.find(process.stderr_text(&built), expected) < 0 || !img_now.ok || !harness.bytes_equal(&img_now.value, &prev_marker) {
            return harness.fail("build lost diagnostic/output preservation: " + process.stderr_text(&built))
        }
    } else if baseline.len > 0 {
        prev_img := work + "/baseline-image"
        old_b := harness.exec_cmd(baseline, ["build", source, "--target", target, "-o", prev_img], work, true, 30000)
        prev_bytes := sys.read_u8(prev_img)
        new_bytes := sys.read_u8(image)
        if !old_b.ok || old_b.timed_out || old_b.signal != 0 || old_b.code != 0 ||
           !prev_bytes.ok || !new_bytes.ok || !harness.bytes_equal(&prev_bytes.value, &new_bytes.value) {
            return harness.fail("normal build changed for " + harness.basename(source) + " " + target + ": " + process.stderr_text(&old_b))
        }
    }
    true
}

fn run_all(cli: &harness.BaseCli, work: string, out_count: &mut i32) -> bool {
    var case_texts: []string = []
    var case_expected: []string = []
    build_cases(&mut case_texts, &mut case_expected)
    all_targets := harness.targets()
    var count := 0
    for number in 0..case_texts.len {
        source := work + "/case-" + number.str() + ".ddr"
        if !sys.write_text(source, case_texts[number]).ok {
            return harness.fail("write_text failed on " + source)
        }
        for target in all_targets {
            if !check_case(cli.compiler, source, case_expected[number], target, work, cli.baseline) {
                return false
            }
            count += 1
        }
    }
    out_count = count
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-check-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    var count := 0
    ok := run_all(&cli, tmp.value, &mut count)
    _ := fs.remove_all(tmp.value)
    if !ok { return false }
    print(count.str() + " all-target check/build contracts passed")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
