capability process, filesystem, stdio

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.text as text
import sys

fn build_cases(case_texts: &mut []string, case_expected: &mut []string) {
    composite := "\n@c_layout struct Packet { tag: u8, pair: [i32; 2] }\n" +
        "struct Box { text: string, values: []i32 }\n" +
        "enum Action { None, Value(Box) }\n" +
        "fn update(packet: &mut Packet) { packet.tag = 7; packet.pair[0] = 17 }\n" +
        "fn worker() -> i32 {\n" +
        "    mut packet := Packet { tag: 1, pair: [1, 2] }\n" +
        "    update(&mut packet)\n" +
        "    mut values: []i32 = [1, 2]\n" +
        "    values.push(packet.pair[0])\n" +
        "    fixed: [u8; 4] = [7; 4]\n" +
        "    mut single: f32 = 0.5\n" +
        "    single = single + 0.25\n" +
        "    assert(single == 0.75)\n" +
        "    action := Action.Value(Box { text: \"å 🌍\", values: values })\n" +
        "    match action {\n" +
        "        .None => { return 0 },\n" +
        "        .Value(box) => { return i32(fixed[0]) + box.values[2] },\n" +
        "    }\n" +
        "}\n"

    foreign := "capability unsafe\n" +
        "@extern(\"probe\", \"echo\") unsafe fn echo(value: i32) -> i32\n" +
        "fn identity(value: i32) -> i32 { value }\n" +
        "fn worker() -> i32 {\n" +
        "    unsafe { callback_value := callback(identity); return echo(42) }\n" +
        "}\n"

    prefixes: []string = [composite, foreign]
    mains: []string = ["fn main(){print(worker())}", "fn main(){print(42)}"]
    for prefix in prefixes {
        for m in mains {
            case_texts.push(prefix + m)
            case_expected.push("")
        }
    }

    mut large_buf: []u8 = []
    bytes.append_utf8(&mut large_buf, "fn worker()->i32{\n")
    for i in 0..768 {
        if i > 0 { large_buf.push(b'\n') }
        bytes.append_utf8(&mut large_buf, "value")
        bytes.append_decimal(&mut large_buf, i64(i))
        bytes.append_utf8(&mut large_buf, ":i32=")
        bytes.append_decimal(&mut large_buf, i64(i))
    }
    bytes.append_utf8(&mut large_buf, "\nmut sum:=value767\n")
    for i in 0..1024 {
        if i > 0 { large_buf.push(b'\n') }
        bytes.append_utf8(&mut large_buf, "sum=sum+1")
    }
    large := bytes.decode(&large_buf).value

    case_texts.push(large + "\nreturn sum\n}\nfn main(){print(42)}")
    case_expected.push("")

    case_texts.push(large + "\nsmall:u8=256\nreturn sum\n}\nfn main(){print(42)}")
    case_expected.push("unsigned integer literal out of range")

    err_bodies: []string = [
        "fn worker()->i32{true}",
        "fn worker(){value:=1;value=2}",
        "fn pair(a:&mut i32,b:&i32){}\nfn worker(){mut x:=0;pair(&mut x,&x)}",
        "@c_layout struct Bad{value:string}\nfn worker(){}",
    ]
    err_msgs: []string = [
        "type mismatch",
        "assignment requires a mutable stored value",
        "mutable arguments must not alias",
        "C layouts can contain only unmanaged C fields",
    ]
    for i in 0..err_bodies.len {
        body := err_bodies[i].clone()
        expected := err_msgs[i].clone()
        mut call_main := "fn main(){worker()}"
        if text.contains(body, "worker()->i32") {
            call_main = "fn main(){print(worker())}"
        }
        case_texts.push(body + "\n" + call_main)
        case_expected.push(expected.clone())
        case_texts.push(body + "\nfn main(){}")
        case_expected.push(move expected)
    }
}

fn check_case(compiler: string, source: string, expected: string, target: string, work: string, baseline: string) -> bool {
    mut want_code := 0
    if expected.len > 0 { want_code = 1 }

    result := harness.exec_cmd(compiler, ["check", source.clone(), "--agent", "--target", target.clone()], work, true, 30000)
    stdout_str := result.stdout_text()
    stderr_str := result.stderr_text()
    if !result.ok || result.timed_out || result.signal != 0 || result.code != want_code {
        return harness.fail("check " + target + ": exited " + result.code.str() + "\n" + stdout_str + "\n" + stderr_str)
    }

    lines := harness.lines(stdout_str)
    src_meta := sys.metadata(source)
    if !src_meta.ok { return harness.fail("metadata failed on " + source) }

    if expected.len > 0 {
        if lines.len < 2 {
            return harness.fail("wrong diagnostic record count: " + stdout_str)
        }
        mut found := false
        for li in 0..lines.len {
            doc := json.Doc::parse_text(lines[li])
            if !doc.ok || doc.kind(doc.root) != .Object {
                return harness.fail("invalid diagnostic JSON: " + lines[li])
            }
            kind_f := doc.get_str(doc.root, "kind")
            if !kind_f.ok { return harness.fail("missing diagnostic kind: " + lines[li]) }
            if li == lines.len - 1 && kind_f.value != "failed" {
                return harness.fail("missing failed diagnostic footer: " + stdout_str)
            }
            if kind_f.value == "error" && !found {
                code_f := doc.get_str(doc.root, "code")
                msg_f := doc.get_str(doc.root, "message")
                start_f := doc.get_i64(doc.root, "start")
                end_f := doc.get_i64(doc.root, "end")
                if !code_f.ok || code_f.value == "E1000" || !msg_f.ok ||
                   !start_f.ok || !end_f.ok || start_f.value < 0 || start_f.value > end_f.value || end_f.value > src_meta.size {
                    return harness.fail("wrong diagnostic: " + lines[li])
                }
                if text.contains(msg_f.value, expected) { found = true }
            }
        }
        if !found { return harness.fail("wrong diagnostic: " + stdout_str) }
    } else {
        if lines.len == 0 {
            return harness.fail("missing successful check: empty stdout")
        }
        for li in 0..lines.len {
            doc := json.Doc::parse_text(lines[li])
            if !doc.ok || doc.kind(doc.root) != .Object {
                return harness.fail("invalid check record JSON: " + lines[li])
            }
            if li == lines.len - 1 {
                kind_f := doc.get_str(doc.root, "kind")
                if !kind_f.ok || kind_f.value != "ok" {
                    return harness.fail("missing successful check: " + stdout_str)
                }
            }
        }
    }

    if baseline.len > 0 {
        old := harness.exec_cmd(baseline, ["check", source.clone(), "--agent", "--target", target.clone()], work, true, 30000)
        if !old.ok || old.timed_out || old.signal != 0 || old.code != result.code ||
           !bytes.equal(&old.stdout, &result.stdout) || !bytes.equal(&old.stderr, &result.stderr) {
            return harness.fail("changed check output for " + harness.basename(source) + " " + target)
        }
    }

    image := work + "/image"
    mut prev_marker: []u8 = []
    bytes.append_utf8(&mut prev_marker, "previous output")
    if !sys.write_u8(image, &prev_marker).ok {
        return harness.fail("write_u8 failed on " + image)
    }

    built := harness.exec_cmd(compiler, ["build", source.clone(), "--target", target.clone(), "-o", image.clone()], work, true, 30000)
    if !built.ok || built.timed_out || built.signal != 0 || built.code != result.code {
        return harness.fail("check/build disagree for " + harness.basename(source) + " " + target + ": " + built.stderr_text())
    }

    if expected.len > 0 {
        img_now := sys.read_u8(image)
        if !text.contains(built.stderr_text(), expected) || !img_now.ok || !bytes.equal(&img_now.value, &prev_marker) {
            return harness.fail("build lost diagnostic/output preservation: " + built.stderr_text())
        }
    } else if baseline.len > 0 {
        prev_img := work + "/baseline-image"
        old_b := harness.exec_cmd(baseline, ["build", source.clone(), "--target", target.clone(), "-o", prev_img.clone()], work, true, 30000)
        prev_bytes := sys.read_u8(prev_img)
        new_bytes := sys.read_u8(image)
        if !old_b.ok || old_b.timed_out || old_b.signal != 0 || old_b.code != 0 ||
           !prev_bytes.ok || !new_bytes.ok || !bytes.equal(&prev_bytes.value, &new_bytes.value) {
            return harness.fail("normal build changed for " + harness.basename(source) + " " + target + ": " + old_b.stderr_text())
        }
    }
    true
}

fn check_library(compiler: string, source: string, expected: string, error_path: string, target: string, work: string) -> bool {
    image := source[0..source.len - 4]
    marker := "previous library output"
    if !sys.write_text(image, marker).ok { return harness.fail("cannot prepare library output") }
    mut expected_code := 0
    if expected.len > 0 { expected_code = 1 }
    checked := harness.exec_cmd(compiler, ["check", source.clone(), "--agent", "--target", target.clone()], work, true, 30000)
    lines := harness.lines(checked.stdout_text())
    if !checked.ok || checked.timed_out || checked.signal != 0 || checked.code != expected_code || lines.len == 0 {
        return harness.fail("library check failed: " + checked.stdout_text() + checked.stderr_text())
    }
    for line in lines { if !json.Doc::parse_text(line).ok { return harness.fail("invalid library check JSON: " + line) } }
    doc := json.Doc::parse_text(lines[lines.len - 1])
    if expected.len == 0 {
        if doc.get_str(doc.root, "kind").value != "ok" { return harness.fail("missing successful library check") }
        plain := harness.exec_cmd(compiler, ["check", source.clone(), "--target", target.clone()], work, true, 30000)
        if !plain.ok || plain.timed_out || plain.signal != 0 || plain.code != 0 || !text.starts_with(plain.stdout_text(), "checked ") {
            return harness.fail("plain library check failed: " + plain.stderr_text())
        }
    } else {
        if lines.len < 2 || doc.get_str(doc.root, "kind").value != "failed" {
            return harness.fail("wrong library diagnostic: " + checked.stdout_text())
        }
        metadata := sys.metadata(error_path)
        mut matched := false
        for line in lines {
            ldoc := json.Doc::parse_text(line)
            if ldoc.get_str(ldoc.root, "kind").value != "error" { continue }
            code_f := ldoc.get_str(ldoc.root, "code")
            path := ldoc.get_str(ldoc.root, "path")
            start := ldoc.get_i64(ldoc.root, "start"); end := ldoc.get_i64(ldoc.root, "end")
            if !code_f.ok || code_f.value == "E1000" || !path.ok || !sys.same_file(path.value, error_path) ||
                !start.ok || !end.ok || !metadata.ok || start.value < 0 || start.value > end.value || end.value > metadata.size {
                return harness.fail("wrong library diagnostic: " + line)
            }
            if text.contains(ldoc.get_str(ldoc.root, "message").value, expected) { matched = true }
        }
        if !matched {
            return harness.fail("wrong library diagnostic: " + checked.stdout_text())
        }
    }
    unchanged := sys.read_text(image)
    if !unchanged.ok || unchanged.value != marker || sys.metadata(work + "/build/.dunder-cache").ok {
        return harness.fail("library check wrote an image or cache")
    }
    built := harness.exec_cmd(compiler, ["build", source.clone(), "--target", target.clone(), "-o", image.clone()], work, true, 30000)
    preserved := sys.read_text(image)
    if !built.ok || built.timed_out || built.signal != 0 || built.code != 1 ||
        !text.contains(built.stderr_text(), "program needs main") || !preserved.ok || preserved.value != marker {
        return harness.fail("building a library did not require main: " + built.stderr_text())
    }
    true
}

fn run_all(cli: &harness.BaseCli, work: string, out_count: &mut i32) -> bool {
    mut case_texts: []string = []
    mut case_expected: []string = []
    build_cases(&mut case_texts, &mut case_expected)
    all_targets := harness.targets()
    mut count := 0
    for number in 0..case_texts.len {
        source := work + "/case-" + number.str() + ".ddr"
        if !sys.write_text(source, case_texts[number]).ok {
            return harness.fail("write_text failed on " + source)
        }
        for target in all_targets {
            if !check_case(cli.compiler, source, case_expected[number], target, work, cli.baseline) {
                return false
            }
            count += 1
        }
    }
    valid_library := work + "/library_valid.ddr"
    invalid_library := work + "/library_invalid.ddr"
    if !sys.write_text(valid_library, "pub fn answer()->i32{42}").ok ||
        !sys.write_text(invalid_library, "pub fn answer()->i32{42}\nfn unused()->i32{true}").ok {
        return harness.fail("cannot prepare imported libraries")
    }
    libraries: []string = ["", "// declaration-only library\n", "pub struct Value{number:i32} pub enum State{Ready,Done}",
        "pub fn answer()->i32{42}", "fn first()->i32{second()} fn second()->i32{42}",
        "import library_valid\npub fn answer()->i32{library_valid.answer()}", "pub fn unused()->i32{true}",
        "import library_invalid\npub fn answer()->i32{42}"]
    for number in 0..libraries.len {
        source := work + "/library-" + number.str() + ".ddr"
        if !sys.write_text(source, libraries[number]).ok { return harness.fail("cannot prepare library source") }
        mut expected := ""; mut error_path := source.clone()
        if number >= 6 { expected = "type mismatch" }
        if number == 7 { error_path = invalid_library.clone() }
        for target in all_targets {
            if !check_library(cli.compiler, source, expected, error_path, target, work) { return false }
            count += 1
        }
    }
    ran := harness.exec_cmd(cli.compiler, ["run", work + "/library-3.ddr"], work, true, 30000)
    if !ran.ok || ran.timed_out || ran.signal != 0 || ran.code != 1 || !text.contains(ran.stderr_text(), "program needs main") {
        return harness.fail("running a library did not require main: " + ran.stderr_text())
    }
    out_count = count
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-check-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    mut count := 0
    ok := run_all(&cli, tmp.value, &mut count)
    _ := fs.remove_all(tmp.value)
    if !ok { return false }
    print(count.str() + " all-target check/build contracts passed")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
