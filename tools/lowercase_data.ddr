capability filesystem
import sys
import std.array
import std.bytes
import std.parse
import std.text

fn scalar(field: string) -> i32 {
    parsed := parse.hex(text.trim(field))
    assert(parsed.ok && parsed.value >= 0 && parsed.value <= 0x10ffff)
    i32(parsed.value)
}

fn load_mappings(dir: string, offsets: &mut []i32) {
    for line in text.split(sys.read(dir + "/UnicodeData.txt").unwrap(), "\n") {
        if line == "" { continue }
        fields := text.split(line, ";")
        assert(fields.len == 15)
        if fields[13] != "" {
            cp := scalar(fields[0])
            offsets[cp] = scalar(fields[13]) - cp
        }
    }
    mut dotted := false
    mut sigma := false
    for line in text.split(sys.read(dir + "/SpecialCasing.txt").unwrap(), "\n") {
        fields := text.split(line[0..text.find(line, "#").unwrap_or(line.len)], ";")
        if fields.len < 5 { continue }
        cp := scalar(fields[0])
        condition := text.trim(fields[4])
        mapping := text.trim(fields[1])
        if condition == "" {
            if cp == 0x130 { assert(mapping == "0069 0307"); dotted = true }
            else { offsets[cp] = scalar(mapping) - cp }
        } else if condition == "Final_Sigma" {
            assert(cp == 0x3a3 && mapping == "03C2")
            sigma = true
        } else {
            language := text.split(condition, " ")[0].clone()
            assert(language == "tr" || language == "az" || language == "lt")
        }
    }
    assert(dotted && sigma && offsets[0x130] == 0x69 - 0x130)
}

fn load_context(dir: string, flags: &mut []u8) {
    for line in text.split(sys.read(dir + "/DerivedCoreProperties.txt").unwrap(), "\n") {
        fields := text.split(line[0..text.find(line, "#").unwrap_or(line.len)], ";")
        if fields.len < 2 { continue }
        property := text.trim(fields[1])
        if property != "Cased" && property != "Case_Ignorable" { continue }
        bounds := text.split(text.trim(fields[0]), "..")
        first := scalar(bounds[0])
        last := scalar(bounds[bounds.len - 1])
        bit := if property == "Cased" { 1 } else { 2 }
        for cp in first..(last + 1) { flags[cp] = u8(i32(flags[cp]).bit_or(bit)) }
    }
}

fn pack(output: &mut []u8, value: i32) {
    for shift in [18, 12, 6, 0] { output.push(u8(35 + value.shr(shift).bit_and(63))) }
}

fn main() {
    assert(sys.arg_count() == 3)
    dir := sys.arg(1)
    mut offsets: []i32 = []
    zero := 0
    array.resize<i32>(&mut offsets, 0x110000, &zero)
    mut flags: []u8 = []
    bytes.pad(&mut flags, 0x110000)
    load_mappings(dir, &mut offsets)
    load_context(dir, &mut flags)
    mut encoded: []u8 = []
    for cp in 0..flags.len {
        if cp > 0 && flags[cp] == flags[cp - 1] && offsets[cp] == offsets[cp - 1] { continue }
        pack(&mut encoded, cp)
        pack(&mut encoded, offsets[cp] + 0x110000)
        encoded.push(35 + flags[cp])
    }
    assert(sys.write_text(sys.arg(2), "pub const RANGES: string = r\"" + bytes.decode(&encoded).unwrap() + "\"\n").ok)
}
