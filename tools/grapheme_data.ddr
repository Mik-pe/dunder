capability filesystem
import sys
import std.bytes
import std.parse
import std.text

fn load(table: &mut []u8, path: string, column: i32) {
    classes := ["Other", "CR", "LF", "Control", "Extend", "ZWJ", "Regional_Indicator", "Prepend", "SpacingMark", "L", "V", "T", "LV", "LVT"]
    for line in text.split(sys.read(path).unwrap(), "\n") {
        fields := text.split(line[0..text.find(line, "#").unwrap_or(line.len)], ";")
        if fields.len < 2 { continue }
        name := text.trim(fields[1])
        mut prop := 0
        if column == 0 {
            for i in 0..classes.len { if classes[i] == name { prop = i } }
            assert(prop > 0)
            if prop >= 12 { continue }
        } else if column == 1 {
            if name != "InCB" { continue }
            prop = match text.trim(fields[2]) { "Consonant" => 16, "Extend" => 32, "Linker" => 48, _ => { assert(false); 0 } }
        } else {
            if name != "Extended_Pictographic" { continue }
            prop = 64
        }
        bounds := text.split(text.trim(fields[0]), "..")
        first := parse.hex(bounds[0]); last := parse.hex(bounds[bounds.len - 1])
        assert(first.ok && last.ok && first.value >= 0 && last.value < i64(table.len))
        for cp in i32(first.value)..i32(last.value + 1) { table[cp] = u8(i32(table[cp]).bit_or(prop)) }
    }
}

fn main() {
    assert(sys.arg_count() == 3)
    dir := sys.arg(1)
    mut properties: []u8 = []
    bytes.pad(&mut properties, 0x110000)
    load(&mut properties, dir + "/GraphemeBreakProperty.txt", 0)
    load(&mut properties, dir + "/DerivedCoreProperties.txt", 1)
    load(&mut properties, dir + "/emoji-data.txt", 2)
    mut encoded: []u8 = []
    for cp in 0..properties.len {
        if cp > 0 && properties[cp] == properties[cp - 1] { continue }
        for shift in [18, 12, 6, 0] { encoded.push(u8(35 + cp.shr(shift).bit_and(63))) }
        value := i32(properties[cp])
        encoded.push(u8(35 + value.shr(6))); encoded.push(u8(35 + value.bit_and(63)))
    }
    assert(sys.write_text(sys.arg(2), "pub const RANGES: string = r\"" + bytes.decode(&encoded).unwrap() + "\"\n").ok)
}
