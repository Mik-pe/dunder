capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.text as text
import sys

fn check_selfhost_unit_suites(compiler: string, root: string) -> bool {
    mut res := harness.empty_output()
    if !harness.run_checked_timeout(compiler, ["test", "selfhost/frontend/parser.ddr", "--jobs", "1"], root, 0, false, 60000, &mut res) {
        return false
    }
    if !text.contains(res.stdout_text(), "20 passed, 0 failed") {
        return harness.fail("unexpected parser test summary:\n" + res.stdout_text())
    }
    if !harness.run_checked_timeout(compiler, ["test", "selfhost/driver/fmt.ddr", "--jobs", "1"], root, 0, false, 60000, &mut res) {
        return false
    }
    if !text.contains(res.stdout_text(), "22 passed, 0 failed") {
        return harness.fail("unexpected fmt test summary:\n" + res.stdout_text())
    }
    true
}

fn check_init_and_clean(compiler: string, work: string) -> bool {
    mut res := harness.empty_output()

    // 1. Binary package init + check/run/test/fmt
    if !harness.run_checked_timeout(compiler, ["init", "my_app"], work, 0, false, 30000, &mut res) {
        return false
    }
    app_dir := work + "/my_app"
    if !sys.metadata(app_dir + "/dunder.toml").ok ||
    !sys.metadata(app_dir + "/src/main.ddr").ok ||
    !sys.metadata(app_dir + "/tests/suite.ddr").ok ||
    !sys.metadata(app_dir + "/.gitignore").ok {
        return harness.fail("dunder init my_app missed expected files")
    }
    if !harness.run_checked_timeout(compiler, ["check", "--jobs", "1"], app_dir, 0, false, 30000, &mut res) ||
    !harness.run_checked_timeout(compiler, ["run", "--jobs", "1"], app_dir, 0, false, 30000, &mut res) {
        return false
    }
    if res.stdout_text() != "Hello from my_app!\n" {
        return harness.fail("unexpected my_app output: " + res.stdout_text())
    }
    if !harness.run_checked_timeout(compiler, ["test", "--jobs", "1"], app_dir, 0, false, 30000, &mut res) ||
    !harness.run_checked_timeout(compiler, ["fmt", "--check"], app_dir, 0, false, 30000, &mut res) {
        return false
    }

    // 2. Duplicate init & invalid package name errors
    if !harness.run_checked_timeout(compiler, ["init"], app_dir, 1, false, 30000, &mut res) {
        return false
    }
    if !text.contains(res.stderr_text(), "already exists") {
        return harness.fail("expected duplicate init error, got:\n" + res.stderr_text())
    }
    if !harness.run_checked_timeout(compiler, ["init", "123bad"], work, 2, false, 30000, &mut res) {
        return false
    }
    if !text.contains(res.stderr_text(), "invalid package name") {
        return harness.fail("expected invalid package name error, got:\n" + res.stderr_text())
    }

    // 3. Library package init + check/test/fmt
    if !harness.run_checked_timeout(compiler, ["init", "my_lib", "--lib"], work, 0, false, 30000, &mut res) {
        return false
    }
    lib_dir := work + "/my_lib"
    if !sys.metadata(lib_dir + "/src/lib.ddr").ok {
        return harness.fail("dunder init --lib missed src/lib.ddr")
    }
    if !harness.run_checked_timeout(compiler, ["check", "--jobs", "1"], lib_dir, 0, false, 30000, &mut res) ||
    !harness.run_checked_timeout(compiler, ["test", "--jobs", "1"], lib_dir, 0, false, 30000, &mut res) ||
    !harness.run_checked_timeout(compiler, ["fmt", "--check"], lib_dir, 0, false, 30000, &mut res) {
        return false
    }

    // 4. dunder clean preserving build/.dunder and removing everything on --all
    if !fs.mkdir_all(app_dir + "/build/.dunder").ok ||
    !fs.mkdir_all(app_dir + "/build/sub").ok ||
    !sys.write_text(app_dir + "/build/.dunder/sentinel", "keep\n").ok ||
    !sys.write_text(app_dir + "/build/artifact.out", "trash\n").ok ||
    !sys.write_text(app_dir + "/build/sub/obj.o", "obj\n").ok {
        return harness.fail("cannot prepare build artifacts for dunder clean")
    }
    if !harness.run_checked_timeout(compiler, ["clean"], app_dir, 0, false, 30000, &mut res) {
        return false
    }
    if !sys.metadata(app_dir + "/build/.dunder/sentinel").ok {
        return harness.fail("dunder clean removed build/.dunder/sentinel")
    }
    if sys.metadata(app_dir + "/build/artifact.out").ok || sys.metadata(app_dir + "/build/sub").ok {
        return harness.fail("dunder clean did not remove build artifacts")
    }
    if !harness.run_checked_timeout(compiler, ["clean", "--all"], app_dir, 0, false, 30000, &mut res) {
        return false
    }
    if sys.metadata(app_dir + "/build").ok {
        return harness.fail("dunder clean --all did not remove build directory")
    }
    if !harness.run_checked_timeout(compiler, ["clean"], app_dir, 0, false, 30000, &mut res) {
        return false
    }
    true
}

fn check_fmt_cli(compiler: string, work: string) -> bool {
    fmt_dir := work + "/fmt_proj"
    if !fs.mkdir_all(fmt_dir + "/sub").ok ||
    !fs.mkdir_all(fmt_dir + "/build").ok ||
    !fs.mkdir_all(fmt_dir + "/.hidden").ok {
        return harness.fail("cannot create fmt_proj directories")
    }
    sample_path := fmt_dir + "/sub/sample.ddr"
    ugly_src := "struct Pair<T>{first:T,second:T}\n" +
    "fn   add(a:i32,b:i32)->i32{a+b}\n" +
    "pub fn main( ){\n" +
    "mut items:[]i32=[1,2]\n" +
    "items.push( add( 3,4 ) )\n" +
    "p:=Pair<i32>{first:items[2],second:0}\n" +
    "if p.first>0&&items.len==3{print(p.first)}\n" +
    "else{print(0)}\n" +
    "}\n"
    if !sys.write_text(sample_path, ugly_src).ok ||
    !sys.write_text(fmt_dir + "/build/ignored.ddr", "fn broken {\n").ok ||
    !sys.write_text(fmt_dir + "/.hidden/ignored.ddr", "fn broken {\n").ok {
        return harness.fail("cannot write fmt fixtures")
    }

    mut res := harness.empty_output()
    // --check rejects unformatted file
    if !harness.run_checked_timeout(compiler, ["fmt", "--check", sample_path.clone()], fmt_dir, 1, false, 30000, &mut res) {
        return false
    }
    // --stdout prints formatted source without modifying sample.ddr
    if !harness.run_checked_timeout(compiler, ["fmt", "--stdout", sample_path.clone()], fmt_dir, 0, false, 30000, &mut res) {
        return false
    }
    stdout_formatted := res.stdout_text()
    after_stdout := sys.read_text(sample_path)
    if !after_stdout.ok || after_stdout.value != ugly_src {
        return harness.fail("dunder fmt --stdout mutated input file")
    }
    // Recursive directory fmt skips build/ and .hidden/, formats sub/sample.ddr cleanly
    if !harness.run_checked_timeout(compiler, ["fmt", fmt_dir.clone()], work, 0, false, 30000, &mut res) {
        return false
    }
    after_inplace := sys.read_text(sample_path)
    if !after_inplace.ok || after_inplace.value != stdout_formatted {
        return harness.fail("in-place formatted output differed from --stdout")
    }
    // Idempotency & compile/run of formatted code
    if !harness.run_checked_timeout(compiler, ["fmt", "--check", fmt_dir.clone()], work, 0, false, 30000, &mut res) ||
    !harness.run_checked_timeout(compiler, ["run", sample_path.clone(), "--jobs", "1"], work, 0, false, 30000, &mut res) {
        return false
    }
    if res.stdout_text() != "7\n" {
        return harness.fail("formatted sample program produced unexpected output: " + res.stdout_text())
    }

    // Broken syntax must fail cleanly without modifying the file
    broken_path := fmt_dir + "/broken.ddr"
    broken_src := "fn broken( { x := }\n"
    if !sys.write_text(broken_path, broken_src).ok {
        return harness.fail("cannot write broken.ddr")
    }
    if !harness.run_checked_timeout(compiler, ["fmt", broken_path.clone()], work, 1, false, 30000, &mut res) {
        return false
    }
    if !text.contains(res.stderr_text(), ":1:") {
        return harness.fail("expected line:col diagnostic from dunder fmt on broken syntax:\n" + res.stderr_text())
    }
    after_broken := sys.read_text(broken_path)
    if !after_broken.ok || after_broken.value != broken_src {
        return harness.fail("dunder fmt mutated file on syntax error")
    }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-phase3-")
    if !tmp.ok { return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    ok := check_selfhost_unit_suites(cli.compiler, cli.root) &&
    check_init_and_clean(cli.compiler, work) &&
    check_fmt_cli(cli.compiler, work)
    if ok { 0 } else { 1 }
}
