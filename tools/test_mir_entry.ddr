capability process, filesystem

import .harness as harness
import std.fs as fs
import std.parse as parse
import std.process as process
import std.text as text
import sys

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    host := harness.host_id()
    emitter := work + "/emitter"
    var res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/mir-entry-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    for size in ["small", "large"] {
        for target in 0..3 {
            for mode in ["off", "on"] {
                image := work + "/" + size + "-" + target.str() + "-" + mode
                if !harness.run_checked(emitter, [image, target.str(), size, mode], work, 0, false, &mut res) {
                    return false
                }
                out_str := text.trim(process.stdout_text(&res))
                parsed := parse.integer(out_str)
                var expected_homes: i64 = 0
                if mode == "on" { expected_homes = 3 }
                if !parsed.ok || parsed.value != expected_homes {
                    return harness.fail("expected emitter stdout " + expected_homes.str() + ", got: " + out_str)
                }
                var status := 0
                if cli.expect_bug && mode == "on" { status = 104 }
                if target == host {
                    if !harness.run_checked(image, [], work, status, false, &mut res) {
                        return false
                    }
                }
            }
        }
        print("PASS " + size + " known prior frame bits; three native targets; host observed-before-store")
    }
    var suffix := ""
    if cli.expect_bug { suffix = " (old bug reproduced)" }
    print("12 entry-preservation images verified" + suffix)
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected extra argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-mir-entry-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    work := tmp.value
    ok := run_in_work(&cli, work)
    _ := fs.remove_all(work)
    ok
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok {
        _ := sys.eprint(cli.error)
        return 2
    }
    if !run_suite(&cli) {
        return 1
    }
    0
}
