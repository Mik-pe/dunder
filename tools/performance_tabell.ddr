capability filesystem

import std.array as array
import std.bytes as bytes
import sys

pub struct Fixture {
    csv: string,
    expected: string,
}

fn field(output: &mut []u8, value: string) {
    mut quote := false
    for i in 0..value.len {
        byte := value[i]
        if byte == 44 || byte == 34 || byte == 13 || byte == 10 { quote = true; break }
    }
    if !quote { bytes.append_utf8(&mut output, value); return }
    output.push(b'"')
    for i in 0..value.len {
        byte := u8(value[i])
        if byte == b'"' { output.push(b'"') }
        output.push(byte)
    }
    output.push(b'"')
}

pub fn generate(work: string) -> Fixture {
    labels := ["Stockholm", "Örebro", "Malmö", "Team, A", "Team \"B\"", "Umeå"]
    mut totals := Map<string, i64>::new()
    mut groups: []string = []
    mut csv: []u8 = []
    bytes.append_utf8(&mut csv, "team,cents,memo\r\n")
    for row in 0..32768 {
        label := labels[row % labels.len].clone()
        group := f"{label} {row % 67}"
        amount := i64(row % 101 - 50) * 1234567
        field(&mut csv, group)
        bytes.append_utf8(&mut csv, f",{amount},order {row}\r\n")
        if totals.contains(group) {
            total := totals.at(group) + amount
            totals.put(group.clone(), total)
        } else {
            totals.put(group.clone(), amount)
            groups.push(group.clone())
        }
    }
    array.sort<string>(&mut groups)
    mut expected: []u8 = []
    bytes.append_utf8(&mut expected, "group,total\n")
    for group in groups {
        field(&mut expected, group)
        bytes.append_utf8(&mut expected, f",{totals.at(group)}\n")
    }
    path := work + "/expenses.csv"
    if !sys.write_u8(path, &csv).ok { return Fixture { csv: "", expected: "" } }
    Fixture { csv: path, expected: bytes.decode(&expected).value }
}
