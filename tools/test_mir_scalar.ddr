capability process, filesystem

import .harness as harness
import .mir_oracle as oracle
import .probe_cli as cli
import std.fs as fs
import std.parse as parse
import sys

struct Case {
    name: string,
    operation: oracle.Operation,
    inputs: [u64; 3],
}

fn op(kind: i64, opcode: i64, ty: i64) -> oracle.Operation {
    b: i64 = if kind == 4 || kind == 5 { 2 } else { -1 }
    c: i64 = if opcode == 17 || opcode == 18 { 3 } else { -1 }
    dst: i64 = if kind == 5 { -1 } else { 4 }
    a: i64 = if kind == 6 { -1 } else { 1 }
    flags: i64 = if kind == 5 { 2 } else if kind == 6 { 1 } else { 0 }
    oracle.Operation {
        kind: kind, opcode: opcode, type: ty, dst: dst, a: a, b: b, c: c, imm: 0, aux: 0, flags: flags,
        place: 0, extension: 0, effects: 0, abi: 0, reads: 0, writes: 0, clobbers: 0, mode: 1, target: 0,
    }
}

fn case_of(name: string, operation: oracle.Operation, values: [u64; 3]) -> Case {
    Case { name: name.clone(), operation: operation, inputs: values.clone() }
}

fn cases_for_width(ty: i64, width: i32, cases: &mut []Case) {
    minimum: i64 = if width == 32 { -2147483648 } else { -9223372036854775808 }
    random_left: u64 = if width == 32 { 17147831702675529619 } else { 10499215904105914403 }
    random_right: u64 = if width == 32 { 3355794886371676591 } else { 14225837055830754294 }
    pairs: [(u64, u64); 4] = [(7, 3), (oracle.bits(-1), 0), (oracle.bits(minimum), oracle.bits(-1)), (random_left, random_right)]
    for opcode in 1..19 {
        if ty == 1 && (opcode == 4 || opcode == 5) { continue }
        for pair in pairs {
            cases.push(case_of(f"binary-{width}-{opcode}", op(4, i64(opcode), ty), [pair.0, pair.1, oracle.bits(-17)]))
        }
    }
    for opcode in [1, 2, 8, 11] {
        for pair in pairs {
            cases.push(case_of(f"nzcv-{width}-{opcode}", op(5, i64(opcode), ty), [pair.0, pair.1, 0]))
        }
    }
    for opcode in [1, 2, 8, 9, 10, 11, 12, 13] {
        kinds := if opcode >= 8 { 4 } else { 3 }
        for shift_kind in 0..kinds {
            mut instruction := op(4, i64(opcode), ty)
            instruction.aux = i64((width - 1).bit_or(shift_kind.shl(6)))
            cases.push(case_of(f"shifted-{width}-{opcode}-{shift_kind}", instruction, [oracle.bits(-4611686018427387905), 0x8000000180000003, 0]))
        }
    }
    for opcode in [1, 2] {
        for immediate in [1, 4095, 4096, 16773120] {
            mut instruction := op(4, i64(opcode), ty)
            instruction.b = -1
            instruction.imm = i64(immediate)
            instruction.flags = 2
            cases.push(case_of(f"immediate-{width}-{opcode}-{immediate}", instruction, [oracle.bits(-1), 0, 0]))
        }
    }
    for opcode in [1, 2] {
        ranges: [(i32, i32); 3] = [(0, width - 1), (7, 15), (width - 1, width - 1)]
        for span in ranges {
            mut instruction := op(3, i64(opcode), ty)
            instruction.aux = i64(span.0.bit_or(span.1.shl(6)))
            cases.push(case_of(f"bitfield-{width}-{opcode}-{span.0}-{span.1}", instruction, [oracle.bits(-9223372034707292161), 0, 0]))
        }
    }
    mut wrapping := op(3, 2, ty)
    wrapping.aux = 333
    cases.push(case_of(f"unsigned-wrapping-field-{width}", wrapping, [oracle.bits(-1), 0, 0]))
    for unit in 0..(width / 16) {
        shift := unit * 16
        for dst in [1, 4] {
            mut instruction := op(3, 3, ty)
            instruction.dst = i64(dst)
            instruction.aux = i64(shift)
            instruction.imm = oracle.signed(u64(0xbeef).shl(shift), 64)
            cases.push(case_of(f"insert-{width}-{shift}-dst{dst}", instruction, [oracle.bits(-4919131752989213765), 0, 0]))
        }
    }
    conditions: [(u64, u64); 3] = [(7, 3), (oracle.bits(-1), 0), (0, 0)]
    for condition in 0..14 {
        for pair in conditions {
            mut instruction := op(6, 0, ty)
            instruction.imm = i64(condition)
            cases.push(case_of(f"select-{width}-{condition}", instruction, [pair.0, pair.1, 0]))
        }
    }
    for source in ["left-zero", "right-zero", "both-zero"] {
        mut instruction := op(4, 1, ty)
        instruction.a = if source == "right-zero" { 1 } else { -1 }
        instruction.b = if source == "left-zero" { 2 } else { -1 }
        cases.push(case_of(f"zr-{width}-{source}", instruction, [91, 137, 0]))
    }
    for dst in [1, 2, 3] {
        mut instruction := op(4, 18, ty)
        instruction.dst = i64(dst)
        cases.push(case_of(f"alias-dst-{width}-{dst}", instruction, [91, 137, oracle.bits(-17)]))
    }
}

fn cases() -> []Case {
    mut result: []Case = []
    cases_for_width(1, 32, &mut result)
    cases_for_width(2, 64, &mut result)
    pairs: [(u64, u64); 4] = [(oracle.bits(-2147483648), oracle.bits(-1)),
        (0x1234567880000000, 0x76543210ffffffff), (oracle.bits(-2147483648), 0), (oracle.bits(-2147483647), oracle.bits(-1))]
    for dst in [1, 2, 4] {
        for pair in pairs {
            mut instruction := op(4, 6, 1)
            instruction.dst = i64(dst)
            result.push(case_of(f"divide-w32-full-result-dst{dst}", instruction, [pair.0, pair.1, 0]))
        }
    }
    result
}

fn expected(item: &Case) -> (bool, i64, i32) {
    operation := item.operation
    mut ret := op(15, 1, 2)
    ret.mode = 0
    model := oracle.Model { ok: true, operations: [operation, ret], places: [], labels: Map<i64, i64>::new(), order: [0, 1] }
    mut machine := oracle.Machine::new()
    machine.write(0, 0, 64)
    for i in 0..3 { machine.write(i64(i + 1), item.inputs[i], 64) }
    machine.write(4, 1084818905618843912, 64)
    if operation.kind == 6 {
        comparison := op(5, 2, operation.type)
        width := if operation.type == 1 { 32 } else { 64 }
        _ := machine.binary(&comparison, width)
    }
    outcome := machine.run(&model, 10000)
    if outcome.state != .Complete {
        _ := harness.fail(f"{item.name}: independent oracle: {outcome.reason}")
        return (false, 0, 0)
    }
    value := if operation.dst >= 0 { machine.read(operation.dst) } else { u64(0) }
    mut conditions := 0
    if operation.flags == 2 {
        for i in 0..14 {
            if machine.condition(i64(i)) { conditions = conditions.bit_or(1.shl(i)) }
        }
    }
    (machine.gap.len == 0, oracle.signed(value, 64), conditions)
}

fn check(item: &Case, index: i32, emitter: string, work: string, host: i32) -> bool {
    (ok, value, conditions) := expected(&item)
    if !ok { return false }
    instruction := &item.operation
    mut result := harness.empty_output()
    for target in 0..3 {
        image := f"{work}/scalar-image-{index}-{target}"
        mut args: []string = [image.clone(), target.str(), instruction.kind.str(), instruction.opcode.str(), instruction.type.str(),
                              instruction.dst.str(), instruction.a.str(), instruction.b.str(), instruction.c.str(),
                              instruction.imm.str(), instruction.aux.str(), instruction.flags.str()]
        for input in item.inputs { args.push(oracle.signed(input, 64).str()) }
        args.push(value.str())
        args.push(conditions.str())
        if !harness.run_checked_timeout(emitter, args, work, 0, false, 60000, &mut result) ||
           (target == host && !harness.run_checked_timeout(image, [], work, 0, false, 60000, &mut result)) {
            return harness.fail(f"scalar case {index} {item.name}")
        }
        if !fs.remove_all(image).ok { return harness.fail(f"cannot remove {image}") }
    }
    true
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--limit")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_mir_scalar <compiler> [--limit N]")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("could not locate Dunder repository root"); return 1 }
    corpus := cases()
    mut limit := corpus.len
    if args.has("--limit") {
        count := parse.integer(args.last("--limit", ""))
        if !count.ok { _ := sys.eprint("--limit requires an integer"); return 2 }
        size := if count.value < 0 { i64(corpus.len) + count.value } else { count.value }
        if size < 0 { limit = 0 }
        else if size < i64(limit) { limit = i32(size) }
    }
    tmp := fs.temp_dir("dunder-mir-scalar-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    emitter := work + "/emitter"
    mut result := harness.empty_output()
    if !harness.run_checked_timeout(compiler, ["build", root + "/tests/fixtures/mir-scalar-emitter.ddr", "-o", emitter.clone()],
                                     work, 0, false, 60000, &mut result) { return 1 }
    host := harness.host_id()
    for i in 0..limit {
        if !check(&corpus[i], i, emitter, work, host) { return 1 }
        done := i + 1
        if done % 50 == 0 { print(f"PASS {done}/{limit} scalar cases") }
    }
    print(f"{limit} independent scalar/NZCV cases; {limit * 3} images built; {limit} native executions passed")
    0
}
