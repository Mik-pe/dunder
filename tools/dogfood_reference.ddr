import .profile_source_scan as lexer
import std.array as array
import std.text as text

pub struct Expected { stdout: string, error: string }
struct Number { code: i32, value: i64 }

fn expected(values: &[]i64) -> Expected {
    mut stdout := ""
    for value in values { stdout += value.str() + "\n" }
    Expected { stdout: stdout, error: "" }
}

fn failed(message: string) -> Expected { Expected { stdout: "", error: message.clone() } }

fn magnitude(value: i64) -> u64 {
    if value < 0 { u64(-(value + 1)) + 1 } else { u64(value) }
}

fn signed(value: u64, negative: bool) -> i64 {
    if negative && value > 0 { -i64(value - 1) - 1 } else { i64(value) }
}

fn decimal(line: string) -> Number {
    if line.len == 0 { return Number { code: 1, value: 0 } }
    negative := line[0] == i32(b'-')
    start := if negative || line[0] == i32(b'+') { 1 } else { 0 }
    if start == line.len { return Number { code: 1, value: 0 } }
    limit: u64 = if negative { 9223372036854775808 } else { 9223372036854775807 }
    mut value: u64 = 0
    mut previous := false
    for i in start..line.len {
        byte := line[i]
        if byte == i32(b'_') {
            if !previous || i + 1 == line.len || line[i + 1] < i32(b'0') || line[i + 1] > i32(b'9') {
                return Number { code: 1, value: 0 }
            }
            previous = false
        } else if byte >= i32(b'0') && byte <= i32(b'9') {
            digit := u64(byte - i32(b'0'))
            if value > (limit - digit) / 10 { return Number { code: 2, value: 0 } }
            value = value * 10 + digit
            previous = true
        } else { return Number { code: 1, value: 0 } }
    }
    Number { code: 0, value: signed(value, negative) }
}

fn weighted_sum(seed: i64, coefficient: i64, offset: i64, output: &mut []i64) -> bool {
    negative := seed < 0
    opposite := negative != (offset < 0)
    limit: u64 = if negative { 9223372036854775808 } else { 9223372036854775807 }
    bias := magnitude(offset)
    cap := if opposite { limit + bias } else { limit - bias }
    value := magnitude(seed)
    slope := u64(coefficient)
    if value > cap / slope { return false }
    product := value * slope
    if !opposite { output.push(signed(product + bias, negative)) }
    else if product >= bias { output.push(signed(product - bias, negative)) }
    else { output.push(signed(bias - product, !negative)) }
    true
}

fn pod(count: i32, seed: i64) -> Expected {
    mut original: i64 = 0
    mut changed: i64 = 0
    mut refined: i64 = 0
    mut refine_coefficient: i64 = 0
    for i in 0..count {
        offset := i64(i % 97)
        tag := i64(i % 11)
        left := offset * 17 + tag
        right := offset - 11
        weight := tag * 2 + 1
        ok := (seed % 3 + offset) % 3 != 0
        bonus: i64 = if ok { 7 } else { -7 }
        direction: i64 = if ok { 1 } else { -1 }
        original += left * 3 + right * 5 + weight * 11 + bonus
        changed += (left + 29) * 3 + (right - 13) * 5 + (weight + 3) * 11 - bonus
        refined += (left + right) * direction * 3 + (left - right) * 5 + (weight + 2) * 11 + bonus
        refine_coefficient += direction * 54 + 80
    }
    coefficient := i64(count) * 56
    mut values: []i64 = []
    if !weighted_sum(seed, coefficient, original, &mut values) ||
       !weighted_sum(seed, coefficient, original, &mut values) ||
       !weighted_sum(seed, coefficient, changed, &mut values) ||
       !weighted_sum(seed, refine_coefficient, refined, &mut values) { return failed("reference checksum exceeds i64") }
    expected(&values)
}

fn decimals(count: i32, raw: string) -> Expected {
    mut decoded: []Number = []
    for line in move text.split(raw, "\n") { decoded.push(decimal(line)) }
    mut values: []i64 = [0, 0, 0, 0, 0, 0]
    for cycle in 0..count {
        for i in 0..decoded.len {
            number := decoded[(i + cycle) % decoded.len]
            weight := i64(i + 1)
            values[number.code] += 1
            if number.code == 0 {
                residue := number.value % 1000003
                values[3] += residue
                values[4] += residue * weight
            }
            values[5] += i64(number.code) * weight
        }
    }
    expected(&values)
}

fn lex(count: i32, raw: string) -> Expected {
    scanned := lexer.scan(raw)
    if scanned.error.len > 0 { return failed(scanned.error) }
    mut names := Map<string, i64>::new()
    mut kinds: i64 = 0
    mut spans: i64 = 0
    mut ids: i64 = 0
    mut content: i64 = 0
    for i in 0..scanned.tokens.len {
        item := &scanned.tokens[i]
        weight := i64(i + 1)
        kinds += i64(item.kind) * weight
        spans += i64(item.start) * 3 + i64(item.end) * 5
        if item.kind == 1 || item.kind == 2 {
            if !names.contains(item.spelling) { names.put(item.spelling.clone(), i64(names.len() + 1)) }
            ids += names.at(item.spelling) * weight
        }
        for byte in item.spelling.bytes() { content = (content * 131 + i64(byte)) % 2147483647 }
    }
    repeat := i64(count)
    values: []i64 = [i64(scanned.tokens.len) * repeat, kinds * repeat, spans * repeat,
                     ids * i64((count + 1) / 2), content * repeat]
    expected(&values)
}

fn symbols(count: i32, raw: string) -> Expected {
    keys := text.split(raw, "\n")
    mut sorted := keys.clone()
    array.sort<string>(&mut sorted)
    for i in 0..sorted.len {
        if sorted[i] == "not a stored symbol!" || (i > 0 && sorted[i] == sorted[i - 1]) {
            return failed("symbol input must have unique keys and exclude missing sentinel")
        }
    }
    mut current: i64 = 0
    mut snapshots: i64 = 0
    mut lengths: i64 = 0
    mut removed: i64 = 0
    for cycle in 0..count {
        for i in 0..keys.len {
            base := i64(i) * 17 + i64(cycle)
            original := if i % 3 == 0 { -base - 7 } else { base }
            erased := i % 4 == 0
            replaced := i % 5 == 0
            if erased { removed += 1 }
            if !erased || replaced { lengths += 1 }
            value := if replaced { i64(cycle) - i64(i) * 9 } else if erased { 999983 } else { original }
            current += value * i64(i + 1)
            snapshots += original * i64(i + 1)
        }
    }
    values: []i64 = [current, snapshots, lengths, removed, i64(count) * 999983]
    expected(&values)
}

pub fn calculate(name: string, count: i32, seed: i64, raw: string) -> Expected {
    if name == "pod" { return pod(count, seed) }
    if name == "decimal" { return decimals(count, raw) }
    if name == "lexer" { return lex(count, raw) }
    symbols(count, raw)
}
