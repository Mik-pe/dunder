capability process, filesystem

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.parse as parse
import std.process as process
import std.text as text
import sys

fn code_size(image: &[]u8, target: i32) -> i64 {
    if target != 0 {
        return i64(image.len)
    }
    if image.len < 32 { return -1 }
    ncmds := i32(bytes.u32_le(&image, 16))
    if ncmds < 0 { return -1 }
    var at := 32
    for _ in 0..ncmds {
        if at < 0 || at + 8 > image.len { return -1 }
        command := bytes.u32_le(&image, at)
        size := i32(bytes.u32_le(&image, at + 4))
        if size < 8 || at + size > image.len { return -1 }
        if command == 25 {
            if at + 72 > image.len { return -1 }
            nsects := i32(bytes.u32_le(&image, at + 64))
            if nsects < 0 { return -1 }
            for section in 0..nsects {
                start := at + 72 + section * 80
                if start < 0 || start + 80 > image.len { return -1 }
                var name_end := start + 16
                while name_end > start && image[name_end - 1] == 0 {
                    name_end -= 1
                }
                if bytes.equals_text(&image, start, name_end, "__text") {
                    return i64(bytes.u64_le(&image, start + 40))
                }
            }
        }
        at += size
    }
    -1
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    emitter := work + "/emitter"
    var res := harness.empty_output()
    var no_args: []string = []
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/machine-ir-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    host := harness.host_id()
    for expected in [42, 41] {
        for target in 0..3 {
            var img_none: []u8 = []
            var img_compact: []u8 = []
            var img_split: []u8 = []
            for mode in ["none", "compact", "split"] {
                image := work + "/" + expected.str() + "-" + target.str() + "-" + mode
                if !harness.run_checked(emitter, [image, target.str(), mode, expected.str()], work, 0, false, &mut res) {
                    return false
                }
                removed := parse.integer(text.trim(process.stdout_text(&res)))
                var expected_removed: i64 = 8
                if mode == "none" { expected_removed = 0 }
                if !removed.ok || removed.value != expected_removed {
                    return harness.fail(target.str() + "/" + mode + ": unexpected removed words: " + process.stdout_text(&res))
                }
                raw := sys.read_u8(image)
                if !raw.ok {
                    return harness.fail("failed to read image: " + image)
                }
                if mode == "none" {
                    img_none = raw.value
                } else if mode == "compact" {
                    img_compact = raw.value
                } else {
                    img_split = raw.value
                }
                if target == host {
                    var expected_rc := 104
                    if expected == 42 { expected_rc = 0 }
                    if !harness.run_checked(image, no_args, work, expected_rc, false, &mut res) {
                        return false
                    }
                }
            }
            if !harness.bytes_equal(&img_compact, &img_split) {
                return harness.fail(expected.str() + "/" + target.str() + ": split/convenience image mismatch")
            }
            size_none := code_size(&img_none, target)
            size_compact := code_size(&img_compact, target)
            if size_none < 0 || size_compact < 0 {
                return harness.fail("missing Mach-O __text section")
            }
            reduction := size_none - size_compact
            if reduction <= 0 {
                return harness.fail(expected.str() + "/" + target.str() + ": code did not shrink")
            }
            if target == 0 || target == 1 {
                if reduction != 32 {
                    return harness.fail(expected.str() + "/" + target.str() + ": expected reduction 32, got " + reduction.str())
                }
            }
            print("PASS expected=" + expected.str() + " target=" + target.str() + " real words removed; split/convenience identical")
        }
    }
    for mode in ["duplicate-code", "duplicate-imports", "grow-code", "grow-imports"] {
        bad_res := harness.exec_cmd(emitter, [work + "/" + mode, host.str(), mode, "42"], work, false, 10000)
        if !bad_res.ok || bad_res.timed_out {
            return harness.fail(mode + ": execution failed or timed out")
        }
        if bad_res.code == 0 && bad_res.signal == 0 {
            return harness.fail(mode + ": invalid commit lifecycle accepted")
        }
        print("PASS " + mode + " rejected")
    }
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len != 0 {
        return harness.fail("unexpected extra arguments")
    }
    td := fs.temp_dir("dunder-machine-ir-")
    if !td.ok { return harness.fail("temp_dir failed") }
    ok := run_in_work(&cli, td.value)
    _ := fs.remove_all(td.value)
    if !ok { return false }
    print("All three native target images built; host executed success/trap cases; invalid commits rejected")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
