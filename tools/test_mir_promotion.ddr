capability process, filesystem

import .harness as harness
import std.fs as fs
import std.parse as parse
import std.process as process
import sys

fn is_ws(b: i32) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

fn split_ws(s: string) -> []string {
    var out: []string = []
    var i := 0
    while i < s.len {
        while i < s.len && is_ws(s[i]) { i += 1 }
        if i >= s.len { break }
        start := i
        while i < s.len && !is_ws(s[i]) { i += 1 }
        out.push(s[start..i])
    }
    out
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    host := harness.host_id()
    emitter := work + "/emitter"
    var res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/mir-promotion-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    for selected in 0..12 {
        var status := 0
        if selected == 8 { status = 101 }
        else if selected == 10 { status = 102 }
        for target in 0..4 {
            for mode in ["off", "on"] {
                image := work + "/" + selected.str() + "-" + target.str() + "-" + mode
                if !harness.run_checked(emitter, [image, target.str(), selected.str(), mode], work, 0, false, &mut res) {
                    return false
                }
                fields := split_ws(process.stdout_text(&res))
                if fields.len != 2 {
                    return harness.fail("expected 2 fields from mir-promotion-emitter, got " + fields.len.str())
                }
                p_homes := parse.integer(fields[0])
                p_mem := parse.integer(fields[1])
                if !p_homes.ok || !p_mem.ok {
                    return harness.fail("invalid integer output from mir-promotion-emitter: " + process.stdout_text(&res))
                }
                homes := p_homes.value
                memory := p_mem.value
                if homes < 0 || homes > 4 {
                    return harness.fail("homes out of range [0..4]: " + homes.str())
                }
                if mode == "on" {
                    if homes <= 0 {
                        return harness.fail("expected homes > 0 when mode == on")
                    }
                    if selected != 1 && memory != 0 {
                        return harness.fail("expected memory == 0 for selected=" + selected.str() + " target=" + target.str() + ", got " + memory.str())
                    }
                } else {
                    if homes != 0 || memory <= 0 {
                        return harness.fail("expected homes == 0 and memory > 0 when mode == off, got homes=" + homes.str() + " memory=" + memory.str())
                    }
                }
                if target == host {
                    if !harness.run_checked(image, [], work, status, false, &mut res) {
                        return false
                    }
                }
                if target == 3 {
                    var wasm_status := 0
                    if status != 0 { wasm_status = 125 }
                    if !harness.run_wasm_contract(cli.root, image, work, wasm_status, false) {
                        return false
                    }
                }
            }
        }
        print("PASS " + selected.str() + " all targets; native/Wasm executed; preserved homes and original result")
    }
    print("96 whole-function MIR images verified")
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected extra argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-mir-promotion-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    work := tmp.value
    ok := run_in_work(&cli, work)
    _ := fs.remove_all(work)
    ok
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok {
        _ := sys.eprint(cli.error)
        return 2
    }
    if !run_suite(&cli) {
        return 1
    }
    0
}
