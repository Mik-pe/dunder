capability filesystem, process

import .benchmark_host as provenance
import .harness as harness
import .performance_corpus as corpus
import .profile_compiler_records as records
import .profile_compiler_sources as sources
import .profile_format as format
import .report_json as report
import std.array as array
import std.json as json
import std.process as process
import sys

pub struct Binary { path: string, sha256: string }

pub struct Options {
    root: string,
    directory: string,
    native_target: string,
    compiler: Binary,
    rounds: i32,
    timeout: i64,
    cases: []string,
    expected_stdout: string,
    program_args: []string,
    input_files: []string,
}

pub struct Observation { round: i32, observer: string, image: Binary, size: i64, record: json.Doc }

pub struct Case {
    name: string,
    source: string,
    validation: string,
    files: sources.Graph,
    observations: []Observation,
    sha256: string,
}

struct Command {
    purpose: string,
    argv: []string,
    cwd: string,
    prefix: string,
    returned: bool,
    status: i32,
    timed_out: bool,
}

pub struct Run {
    host: provenance.Host,
    selfhost_source: string,
    source_identity: Binary,
    allocation_compiler: Binary,
    generated: corpus.Corpus,
    files: sources.Inventory,
    has_inventory: bool,
    custom_reference: Binary,
    runtime_inputs: []string,
    cases: []Case,
    commands: []Command,
    failure: string,
    complete: bool,
}

fn empty_binary() -> Binary { Binary { path: "", sha256: "" } }

pub fn run(move host: provenance.Host, selfhost_source: string) -> Run {
    Run {
        host: host, selfhost_source: selfhost_source.clone(), source_identity: empty_binary(),
        allocation_compiler: empty_binary(), custom_reference: empty_binary(),
        generated: corpus.Corpus { path: "", lines: 0, source_bytes: 0, modules: 0, functions: 0, tokens: 0, sha256: "", error: "" },
        files: sources.inventory(), has_inventory: false, runtime_inputs: [], cases: [], commands: [], failure: "", complete: false,
    }
}

fn strings(writer: &mut json.Writer, values: &[]string) {
    writer.array()
    for value in values { writer.string(value) }
    writer.end()
}

fn binary(writer: &mut json.Writer, image: &Binary) {
    writer.object()
    writer.key("path"); writer.string(image.path)
    writer.key("sha256"); writer.string(image.sha256)
    writer.end()
}

fn write_command(writer: &mut json.Writer, command: &Command) {
    writer.object()
    writer.key("purpose"); writer.string(command.purpose)
    writer.key("argv"); strings(&mut writer, &command.argv)
    writer.key("cwd"); writer.string(command.cwd)
    writer.key("environment"); writer.object()
    writer.key("PATH"); writer.string("/no-external-tools")
    writer.end()
    writer.key("stdin"); writer.string("null")
    writer.key("stdout"); writer.string(command.prefix + ".stdout")
    writer.key("stderr"); writer.string(command.prefix + ".stderr")
    if command.timed_out {
        writer.key("timed_out"); writer.boolean(true)
        writer.key("returncode"); writer.null()
    } else if command.returned {
        writer.key("returncode"); writer.integer(i64(command.status))
    }
    writer.end()
}

fn write_case(writer: &mut json.Writer, case: &Case) -> bool {
    writer.object()
    writer.key("source"); writer.string(case.source)
    writer.key("validation"); writer.string(case.validation)
    writer.key("source_files"); strings(&mut writer, &case.files.files)
    writer.key("source_bytes"); writer.integer(case.files.size)
    writer.key("observations"); writer.array()
    for item in case.observations {
        writer.object()
        writer.key("round"); writer.integer(i64(item.round))
        writer.key("observer"); writer.string(item.observer)
        writer.key("image"); writer.string(item.image.path)
        writer.key("image_sha256"); writer.string(item.image.sha256)
        writer.key("image_bytes"); writer.integer(item.size)
        writer.key("record")
        if !report.write_value(&item.record, item.record.root, &mut writer) { return false }
        writer.end()
    }
    writer.end()
    if case.sha256.len > 0 { writer.key("image_sha256"); writer.string(case.sha256) }
    writer.end()
    true
}

impl Run {
    pub fn fail(&mut self, message: string) -> bool {
        if self.failure.len == 0 { self.failure = message.clone() }
        harness.fail(message)
    }

    pub fn checkpoint(&self, options: &Options) -> bool {
        mut writer := json.Writer::new()
        writer.object()
        writer.key("protocol"); writer.string("dunder-compiler-attribution-v1")
        writer.key("complete"); writer.boolean(self.complete)
        writer.key("host"); self.host.write(&mut writer)
        writer.key("native_target"); writer.string(options.native_target)
        writer.key("rounds"); writer.integer(i64(options.rounds))
        writer.key("input_compiler"); binary(&mut writer, &options.compiler)
        writer.key("selfhost_source"); writer.string(self.selfhost_source)
        writer.key("observer_policy"); writer.string("compiler clocks and executed allocation traffic collected in separate processes")
        writer.key("scope"); writer.string("attribution only; profiled durations and counters are not uninstrumented latency or C acceptance measurements")
        if self.source_identity.path.len > 0 {
            writer.key("source_identity_image"); binary(&mut writer, &self.source_identity)
        }
        if self.generated.sha256.len > 0 { writer.key("generated_corpus"); self.generated.write(&mut writer) }
        if self.allocation_compiler.path.len > 0 {
            writer.key("allocation_compiler"); binary(&mut writer, &self.allocation_compiler)
        }
        if self.custom_reference.path.len > 0 {
            writer.key("custom_reference"); writer.object()
            writer.key("path"); writer.string(self.custom_reference.path)
            writer.key("sha256"); writer.string(self.custom_reference.sha256)
            writer.key("program_args"); strings(&mut writer, &options.program_args)
            writer.end()
        }
        if self.has_inventory {
            self.files.write(&mut writer)
            writer.key("additional_runtime_inputs"); strings(&mut writer, &self.runtime_inputs)
        }
        writer.key("cases"); writer.object()
        for case in self.cases {
            writer.key(case.name)
            if !write_case(&mut writer, &case) { return harness.fail(f"cannot encode observation for {case.name}") }
        }
        writer.end()
        writer.key("commands"); writer.array()
        for command in self.commands { write_command(&mut writer, &command) }
        writer.end()
        if self.failure.len > 0 { writer.key("failure"); writer.string(self.failure) }
        writer.end()
        doc := writer.finish()
        final := options.directory + "/metadata.json"
        temporary := final + ".tmp"
        (doc.ok && sys.write_text(temporary, doc.value + "\n").ok && sys.rename(temporary, final).ok) ||
            harness.fail("cannot checkpoint metadata.json")
    }

    pub fn call(&mut self, options: &Options, purpose: string, move argv: []string, cwd: string, output: &mut process.Output) -> bool {
        mut args: []string = []
        for i in 1..argv.len { args.push(argv[i].clone()) }
        mut command := process.command(argv[0].clone(), move args)
        command.set_cwd(cwd.clone())
        command.clear_env()
        command.set_env("PATH", "/no-external-tools")
        command.set_stdio(.Null, .Pipe, .Pipe)
        command.set_timeout(options.timeout)
        at := self.commands.len
        prefix := f"raw/{at + 1:04}"
        self.commands.push(Command { purpose: purpose.clone(), argv: move argv, cwd: cwd.clone(), prefix: prefix.clone(),
            returned: false, status: 0, timed_out: false })
        if !self.checkpoint(&options) { return self.fail("cannot record command before execution") }
        capture := command.exec()
        logs := options.directory + "/" + prefix
        self.commands[at].timed_out = capture.timed_out
        self.commands[at].returned = capture.ok || capture.signal > 0
        status := if capture.signal > 0 { -capture.signal } else { capture.code }
        self.commands[at].status = status
        if !sys.write_u8(logs + ".stdout", &capture.stdout).ok || !sys.write_u8(logs + ".stderr", &capture.stderr).ok {
            return self.fail(f"{purpose}: cannot write raw output")
        }
        if !self.checkpoint(&options) { return self.fail("cannot checkpoint command result") }
        if capture.timed_out { return self.fail(f"{purpose}: timed out; see {prefix}.stderr") }
        if !capture.succeeded() {
            if !capture.ok && capture.signal == 0 { return self.fail(f"{purpose}: process error {capture.error}; see {prefix}.stderr") }
            return self.fail(f"{purpose}: exit {status}; see {prefix}.stderr")
        }
        output = capture
        true
    }
}

fn sortable(value: u64) -> i64 {
    midpoint: u64 = 9223372036854775808
    if value < midpoint { -9223372036854775808 + i64(value) } else { i64(value - midpoint) }
}

fn original(value: i64) -> u64 {
    midpoint: u64 = 9223372036854775808
    if value < 0 { u64(value - (-9223372036854775808)) } else { u64(value) + midpoint }
}

fn phase_median(case: &Case, phase: string, writer: &mut json.Writer) {
    mut durations: []i64 = []
    for item in case.observations {
        if item.observer != "clock" { continue }
        detail := item.record.field(item.record.root, "compiler_detail")
        value := if phase == "other" { item.record.get_i64(detail, "other").value }
                 else { item.record.get_i64(item.record.field(detail, "phases"), phase).value }
        durations.push(value)
    }
    array.sort(&mut durations)
    middle := durations.len / 2
    if durations.len % 2 == 1 { writer.integer(durations[middle]) }
    else { writer.decimal((f64(durations[middle - 1]) + f64(durations[middle])) * 0.5) }
}

fn allocation_median(case: &Case, key: string) -> u64 {
    mut values: []i64 = []
    for item in case.observations {
        if item.observer != "allocation" { continue }
        node := item.record.field(item.record.root, "counters")
        values.push(sortable(item.record.get_u64(node, key).value))
    }
    array.sort(&mut values)
    original(values[(values.len - 1) / 2])
}

pub fn summarize(options: &Options, cases: &[]Case) -> bool {
    mut writer := json.Writer::new()
    writer.object()
    for case in cases {
        writer.key(case.name); writer.object()
        writer.key("image_sha256"); writer.string(case.sha256)
        writer.key("rounds"); writer.integer(i64(options.rounds))
        writer.key("clock_detail_median_ns"); writer.object()
        for phase in move records.phases() {
            writer.key(phase.name)
            phase_median(&case, phase.name, &mut writer)
        }
        writer.end()
        writer.key("clock_other_median_ns"); phase_median(&case, "other", &mut writer)
        writer.key("allocation_counter_median_low"); writer.object()
        for key in move format.counter_names() {
            writer.key(key)
            writer.unsigned(allocation_median(&case, key))
        }
        writer.end()
        writer.key("validation"); writer.string(case.validation)
        writer.end()
    }
    writer.end()
    doc := writer.finish()
    (doc.ok && sys.write_text(options.directory + "/summary.json", doc.value + "\n").ok) || harness.fail("cannot write summary.json")
}
