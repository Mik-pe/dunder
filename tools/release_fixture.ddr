capability filesystem

import .harness as harness
import std.bytes as bytes
import sys

pub fn file_url(path: string) -> string {
    hex := "0123456789ABCDEF"
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "file://")
    for value in path.bytes() {
        if (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
           value == 45 || value == 46 || value == 47 || value == 95 || value == 126 {
            out.push(u8(value))
        } else {
            out.push(b'%')
            out.push(hex[i32(value) / 16])
            out.push(hex[i32(value) % 16])
        }
    }
    bytes.decode(&out).unwrap_or_default()
}

pub fn copy_file(source: string, destination: string) -> bool {
    input := sys.read_u8(source)
    (input.ok && sys.write_u8(destination, &input.value).ok) || harness.fail(f"cannot copy {source} to {destination}")
}

pub fn same_bytes(path: string, expected: &[]u8) -> bool {
    actual := sys.read_u8(path)
    (actual.ok && bytes.equal(&actual.value, &expected)) || harness.fail(f"unexpected bytes at {path}")
}
