capability filesystem, process, stdio
import .benchmark_process as process
import .benchmark_time as time
import .harness
import std.bytes
import std.fs
import std.parse
import std.text
import sys

fn build(args: &[]string, project: string, work: string, cache: string, stage: string, jobs: string, round: i32) {
    result := process.capture_cached(&args, project, work, cache, true, 120000, time.now_ns)
    if !result.observed_exit || result.status != 0 || result.error != "" {
        _ := sys.eprint(result.error + bytes.decode(&result.stderr).unwrap_or_default())
        assert(false)
    }
    print(f"{round},{jobs},{stage},{result.elapsed},{result.rss}")
}

fn checksum(image: string, project: string, work: string, value: i32) {
    result := process.capture(&[image.clone()], project, work, false, 15000, time.now_ns)
    assert(result.observed_exit && result.status == 0 && bytes.equals_text(&result.stdout, 0, result.stdout.len, value.str() + "\n"))
}

fn measure(compiler: string, project: string, rounds: i32, mode: string, work: string) {
    mixed := mode == "mixed"
    entry := work + "/input"
    if mixed {
        assert(fs.mkdir_all(entry).ok)
        for path in fs.list_dir(project).unwrap() {
            if text.ends_with(path, ".ddr") || path == "dunder.toml" {
                assert(sys.write_text(entry + "/" + path, sys.read(project + "/" + path).unwrap()).ok)
            }
        }
    }
    cwd := if mixed { entry.clone() } else { project.clone() }
    initial := if mixed { sys.read(cwd + "/m0.ddr").unwrap() } else { "" }
    shared := if mixed { sys.read(cwd + "/shared.ddr").unwrap() } else { "" }
    reordered := text.replace(shared, "scale: i64, offset: i64", "offset: i64, scale: i64")
    if mixed { assert(reordered != shared) }
    mut reference := ""
    print("round,jobs,case,elapsed_ns,max_rss_bytes")
    for round in 1..rounds + 1 {
        for position in 0..2 {
            single := (round + position) % 2 == 0
            jobs := if single { "1" } else { "auto" }
            batch := work + "/sample-" + round.str() + "-" + jobs
            cache := batch + "/cache"
            image := batch + "/out/program"
            if mixed {
                assert(sys.write_text(cwd + "/m0.ddr", initial).ok)
                assert(sys.write_text(cwd + "/shared.ddr", shared).ok)
            }
            assert(fs.mkdir_all(batch + "/out").ok && fs.mkdir_all(cache).ok)
            mut args: []string = [compiler.clone(), "build"]
            if mode == "selfhost" { args.push("selfhost/main.ddr") }
            if single { args.push("--jobs"); args.push("1") }
            args.push("-o"); args.push(image.clone())
            build(&args, cwd, work, cache, "clean", jobs, round)
            hash := harness.sha256_file_hex(image)
            assert(hash.len == 64)
            if reference == "" {
                reference = hash.clone()
                if mode == "selfhost" {
                    assert(hash == harness.sha256_file_hex(compiler))
                    probe := process.capture(&[image.clone(), "--version"], project, work, false, 15000, time.now_ns)
                    assert(probe.observed_exit && probe.status == 0 && text.starts_with(bytes.decode(&probe.stdout).unwrap(), "dunder "))
                }
                _ := sys.eprint("clean image bytes " + sys.metadata(image).size.str())
            }
            assert(reference == hash)
            if mixed { checksum(image, cwd, work, 474148) }
            if mode != "selfhost" {
                build(&args, cwd, work, cache, "unchanged", jobs, round)
                assert(harness.sha256_file_hex(image) == reference)
            }
            if mixed {
                leaf := text.replace(initial, "    score\n}\nfn sample1(", f"    score + {round}\n}}\nfn sample1(")
                assert(leaf != initial && sys.write_text(cwd + "/m0.ddr", leaf).ok)
                build(&args, cwd, work, cache, "private-edit", jobs, round)
                checksum(image, cwd, work, 474148 + round)
                changed := text.replace(leaf, "fn adjustment() -> i64 { 1 }", f"fn adjustment() -> i64 {{ {round + 1} }}")
                assert(changed != leaf && sys.write_text(cwd + "/m0.ddr", changed).ok)
                build(&args, cwd, work, cache, "private-inline-edit", jobs, round)
                checksum(image, cwd, work, 474148 + 51 * round)
                assert(sys.write_text(cwd + "/shared.ddr", reordered).ok)
                build(&args, cwd, work, cache, "shared-layout", jobs, round)
                checksum(image, cwd, work, 474148 + 51 * round)
                layout_hash := harness.sha256_file_hex(image)
                assert(fs.remove_all(cache).ok && fs.mkdir_all(cache).ok && sys.remove_file(image).ok)
                build(&args, cwd, work, cache, "layout-clean-control", jobs, round)
                assert(harness.sha256_file_hex(image) == layout_hash)
            }
            assert(fs.remove_all(batch).ok)
        }
    }
    _ := sys.eprint("clean image SHA-256 " + reference)
}

fn main() -> i32 {
    if sys.arg_count() < 3 || sys.arg_count() > 5 {
        _ := sys.eprint("usage: performance_project COMPILER PROJECT [ROUNDS] [project|mixed|selfhost]")
        return 2
    }
    compiler := fs.realpath(sys.arg(1)).value
    project := fs.realpath(sys.arg(2)).value
    rounds := if sys.arg_count() >= 4 { parse.value<i32>(sys.arg(3)).unwrap_or(0) } else { 30 }
    mode := if sys.arg_count() == 5 { sys.arg(4) } else { "project" }
    assert(rounds > 0 && (mode == "mixed" || mode == "project" || mode == "selfhost"))
    work := fs.temp_dir("dunder-project-measure-")
    assert(work.ok)
    defer { _ := fs.remove_all(work.value) }
    measure(compiler, project, rounds, mode, work.value)
    0
}
