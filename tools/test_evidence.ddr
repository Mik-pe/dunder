capability process, filesystem

import .harness as harness
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

pub struct CommandRecord {
    argv: []string,
    exit: i32,
    stdout: string,
    stderr: string,
}

pub struct Journal {
    commands: []CommandRecord,
    cwd: string,
    timeout_ms: i64,
}

impl Journal {
    pub fn new(cwd: string, timeout_ms: i64) -> Self {
        Self { commands: [], cwd: cwd.clone(), timeout_ms: timeout_ms }
    }

    pub fn run(&mut self, program: string, args: []string, output: &mut process.Output) -> bool {
        self.run_expected(program, args, 0, &mut output)
    }

    pub fn run_expected(&mut self, program: string, args: []string, expected: i32, output: &mut process.Output) -> bool {
        result := harness.exec_cmd(program, args, self.cwd, false, self.timeout_ms)
        mut argv: []string = [program.clone()]
        for arg in args { argv.push(arg.clone()) }
        exit := if result.signal == 0 { result.code } else { -result.signal }
        self.commands.push(CommandRecord { argv: argv, exit: exit, stdout: result.stdout_text(), stderr: result.stderr_text() })
        if !result.ok || result.timed_out || result.signal != 0 || result.code != expected {
            _ := harness.fail(f"{program} exited {exit} (timed out: {result.timed_out})\nstdout: {result.stdout_text()}\nstderr: {result.stderr_text()}")
            return false
        }
        output = result
        true
    }

    pub fn write_to(&self, writer: &mut json.Writer, argv_key: string) {
        self.write_to_keys(&mut writer, argv_key, "exit")
    }

    pub fn write_to_keys(&self, writer: &mut json.Writer, argv_key: string, status_key: string) {
        writer.array()
        for record in self.commands {
            writer.object()
            writer.key(argv_key)
            writer.array()
            for arg in record.argv { writer.string(arg) }
            writer.end()
            writer.key(status_key)
            writer.integer(i64(record.exit))
            writer.key("stdout")
            writer.string(record.stdout)
            writer.key("stderr")
            writer.string(record.stderr)
            writer.end()
        }
        writer.end()
    }
}

pub fn save(path: string, writer: &json.Writer) -> bool {
    result := writer.finish()
    (result.is_ok() && sys.write_text(path, result.unwrap_or("") + "\n").ok) || harness.fail(f"cannot write {path}")
}

pub fn create_run(base: string) -> string {
    if !fs.mkdir_all(base).ok {
        _ := harness.fail(f"cannot create {base}")
        return ""
    }
    mut result := harness.empty_output()
    if !harness.run_checked("mktemp", ["-d", base + "/run-XXXXXX"], "", 0, false, &mut result) { return "" }
    path := result.stdout_text()
    if text.ends_with(path, "\n") { return path[0..path.len - 1] }
    path
}

pub fn write_source_digests(writer: &mut json.Writer, root: string, paths: &[]string) {
    writer.object()
    for path in paths {
        writer.key(path)
        writer.string(harness.sha256_file_hex(root + "/" + path))
    }
    writer.end()
}
