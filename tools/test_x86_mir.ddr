capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn multi_feature_fixture() -> string {
    "import std.bytes as bytes\n" +
    "import std.text as text\n\n" +
    "const BASE_OFFSET: i64 = 1000\n" +
    "const WEIGHTS: [i64; 4] = [3, 5, 7, 11]\n\n" +
    "enum Action {\n" +
    "    Add,\n" +
    "    Scale,\n" +
    "    Mix,\n" +
    "}\n\n" +
    "struct Pair {\n" +
    "    hi: u64,\n" +
    "    lo: i64,\n" +
    "    score: f64,\n" +
    "    tag: Action,\n" +
    "}\n\n" +
    "fn fib(n: i64) -> i64 {\n" +
    "    if n <= 1 { return n }\n" +
    "    fib(n - 1) + fib(n - 2)\n" +
    "}\n\n" +
    "fn apply_action(tag: Action, a: i64, b: i32) -> i64 {\n" +
    "    match tag {\n" +
    "        .Add => a + i64(b),\n" +
    "        .Scale => a * i64(b) + i64(b + 3),\n" +
    "        .Mix => (a - i64(b)) * 2 + BASE_OFFSET,\n" +
    "    }\n" +
    "}\n\n" +
    "fn float_probe(x: f64, y: f32) -> i64 {\n" +
    "    a := x * 1.5 + f64(y) / 2.0\n" +
    "    b := x - f64(y)\n" +
    "    if a > b { i64(a * 10.0) } else { i64(b) }\n" +
    "}\n\n" +
    "fn unsigned_probe(seed: u64) -> u64 {\n" +
    "    mut acc := seed.wrapping_add(u64(42))\n" +
    "    acc = acc.wrapping_mul(u64(17))\n" +
    "    acc = acc.wrapping_sub(u64(9))\n" +
    "    q := (acc + u64(99)) / u64(7)\n" +
    "    r := acc % u64(13)\n" +
    "    if q >= u64(5) { q - u64(3) + r } else { acc }\n" +
    "}\n\n" +
    "fn helper_note(msg: string) -> i32 {\n" +
    "    if text.contains(msg, \"mir\") { 1 } else { 0 }\n" +
    "}\n\n" +
    "fn main() -> i32 {\n" +
    "    mut total: i64 = 0\n" +
    "    defer {\n" +
    "        if total == -999999 { print(\"unreachable\") }\n" +
    "    }\n" +
    "    factor := 3\n" +
    "    closure := fn[factor](v: i64) -> i64 { v * i64(factor) + 7 }\n" +
    "    mut items: []i64 = []\n" +
    "    for i in 0..8 {\n" +
    "        items.push(closure(i64(i)) + WEIGHTS[i % 4])\n" +
    "    }\n" +
    "    mut raw: []u8 = []\n" +
    "    bytes.append_utf8(&mut raw, \"x86-mir-probe\")\n" +
    "    decoded := bytes.decode(&raw)\n" +
    "    mut tag := Action.Add\n" +
    "    for i in 0..items.len {\n" +
    "        if i % 3 == 1 { tag = .Scale }\n" +
    "        else if i % 3 == 2 { tag = .Mix }\n" +
    "        else { tag = .Add }\n" +
    "        p := Pair { hi: unsigned_probe(u64(items[i])), lo: apply_action(tag, items[i], i32(i + 2)), score: f64(i) * 0.25, tag: tag }\n" +
    "        total += i64(p.hi % u64(1000)) + p.lo + float_probe(p.score + 2.5, f32(i + 1))\n" +
    "    }\n" +
    "    total += fib(6) + i64(helper_note(decoded.value))\n" +
    "    print(total)\n" +
    "    0\n" +
    "}\n"
}

fn check_elf64_x86_64(path: string) -> bool {
    meta := sys.metadata(path)
    if !meta.ok || !meta.is_file || meta.size < 64 {
        return harness.fail("ELF too small or missing: " + path)
    }
    opened := fs.File::open_read(path)
    if opened.is_err() { return harness.fail("failed to open compiled binary: " + path) }
    mut file := opened.unwrap()
    mut img: []u8 = []
    mut read_err := false
    while img.len < 64 {
        chunk := file.read(&mut img, 64 - img.len)
        if chunk.is_err() { read_err = true; break }
        if chunk.unwrap() == 0 { break }
    }
    _ := file.close()
    if read_err || img.len < 64 { return harness.fail("failed to read ELF header: " + path) }
    if img[0] != 127 || img[1] != 69 || img[2] != 76 || img[3] != 70 {
        return harness.fail("bad ELF magic in " + path)
    }
    if img[4] != 2 { return harness.fail("expected ELF64 class in " + path) }
    if img[5] != 1 { return harness.fail("expected little-endian ELF in " + path) }
    if img[18] != 62 || img[19] != 0 {
        return harness.fail("expected EM_X86_64 (62) in " + path)
    }
    true
}

fn check_bytes_equal(a_path: string, b_path: string, label: string) -> bool {
    a := sys.read_u8(a_path)
    b := sys.read_u8(b_path)
    if !a.ok || !b.ok { return harness.fail("cannot read binaries for comparison: " + label) }
    if a.value.len != b.value.len {
        return harness.fail(f"{label}: byte length mismatch ({a.value.len} vs {b.value.len})")
    }
    for i in 0..a.value.len {
        if a.value[i] != b.value[i] {
            return harness.fail(f"{label}: byte mismatch at offset {i}")
        }
    }
    true
}

fn span_contains(buf: &[]u8, start: i32, end: i32, needle: string) -> bool {
    n := needle.len
    if n == 0 { return true }
    if end - start < n { return false }
    mut pos := start
    while pos + n <= end {
        mut k := 0
        while k < n && buf[pos + k] == needle[k] { k += 1 }
        if k == n { return true }
        pos += 1
    }
    false
}

fn span_uses_phys_reg(buf: &[]u8, start: i32, end: i32) -> bool {
    span_contains(&buf, start, end, "%rbx") || span_contains(&buf, start, end, "%rbp")
}

fn check_objdump_clean(elf_path: string, label: string, require_phys_reg: bool) -> bool {
    mut out := harness.empty_output()
    if !harness.run_checked("/usr/bin/objdump", ["-d", "--start-address=0x401000", elf_path.clone()], "", 0, false, &mut out) {
        return false
    }
    buf := &out.stdout
    mut in_text := false
    mut decoded := 0
    mut saw_phys := false
    mut saw_exit_code := false
    mut saw_syscall := false
    mut start := 0
    while start < buf.len {
        mut end := start
        while end < buf.len && buf[end] != 10 { end += 1 }
        if !in_text {
            if span_contains(&buf, start, end, "401000:") { in_text = true }
            else { start = end + 1; continue }
        }
        if span_contains(&buf, start, end, "<unknown>") || span_contains(&buf, start, end, "(bad)") {
            err_txt := out.stdout_text()
            return harness.fail(f"{label}: invalid instruction in .text: {err_txt[start..end]}")
        }
        if span_contains(&buf, start, end, ":") {
            decoded += 1
            if span_uses_phys_reg(&buf, start, end) { saw_phys = true }
        }
        if span_contains(&buf, start, end, "$0x6e, %edi") || span_contains(&buf, start, end, "$110, %edi") {
            saw_exit_code = true
            saw_syscall = false
        } else if saw_exit_code && span_contains(&buf, start, end, "syscall") {
            saw_syscall = true
        } else if saw_syscall && span_contains(&buf, start, end, "ud2") {
            break
        } else {
            saw_exit_code = false
            saw_syscall = false
        }
        start = end + 1
    }
    if !in_text || decoded == 0 {
        return harness.fail(f"{label}: failed to locate .text at 401000 in objdump")
    }
    if !saw_syscall {
        return harness.fail(f"{label}: failed to locate stack-overflow trap stub terminator (0x6e/syscall/ud2)")
    }
    if require_phys_reg && !saw_phys {
        return harness.fail(f"{label}: expected active physical x86-64 registers (%rbx/%rbp) in .text")
    }
    true
}

fn check_objdump_clean_streamed(elf_path: string, label: string, require_phys_reg: bool) -> bool {
    script := "/usr/bin/objdump -d --start-address=0x401000 \"$1\" | /usr/bin/awk '\n" +
        "/401000:/ { in_text=1 }\n" +
        "!in_text { next }\n" +
        "/<unknown>|\\(bad\\)/ { bad++; if (bad <= 3) print \"BAD:\" $0 }\n" +
        "/:/ { decoded++ }\n" +
        "/%rbx|%rbp/ { phys++ }\n" +
        "/\\$0x6e, %edi|\\$110, %edi/ { exit_code=1; sc=0; next }\n" +
        "exit_code && /syscall/ { sc=1; next }\n" +
        "sc && /ud2/ { found_end=1; exit }\n" +
        "{ exit_code=0; sc=0 }\n" +
        "END { printf \"SUMMARY in_text=%d found_end=%d decoded=%d phys=%d bad=%d\\n\", in_text, found_end, decoded, phys, bad }\n" +
        "'"
    mut out := harness.empty_output()
    if !harness.run_checked("/bin/sh", ["-c", script, "objdump_check", elf_path.clone()], "", 0, false, &mut out) {
        return false
    }
    txt := out.stdout_text()
    if text.contains(txt, "BAD:") || !text.contains(txt, "SUMMARY in_text=1 found_end=1 ") || !text.contains(txt, " bad=0") {
        return harness.fail(f"{label}: streamed objdump check failed:\n{txt}")
    }
    if require_phys_reg && text.contains(txt, " phys=0 ") {
        return harness.fail(f"{label}: expected active physical x86-64 registers (%rbx/%rbp) in .text:\n{txt}")
    }
    true
}

fn build_x86(compiler: string, src: string, out: string, jobs: i32, incremental: bool, cwd: string) -> bool {
    mut args: []string = ["build", src.clone(), "--target", "x86_64-linux", "--jobs", jobs.str(), "-o", out.clone()]
    if incremental { args.push("--incremental") }
    mut res := harness.empty_output()
    harness.run_checked(compiler, args, cwd, 0, false, &mut res)
}

fn copy_text(src: string, dst: string) -> bool {
    r := sys.read_u8(src)
    if !r.ok { return harness.fail("failed to read " + src) }
    if !sys.write_u8(dst, &r.value).ok { return harness.fail("failed to write " + dst) }
    true
}

fn verify_corpus_item(compiler: string, work: string, name: string, src_in_work: string) -> bool {
    item_dir := work + "/item-" + name
    if !fs.mkdir_all(item_dir).ok { return harness.fail("mkdir_all failed: " + item_dir) }
    out_j1 := item_dir + "/out-j1"
    out_j4 := item_dir + "/out-j4"
    out_cold := item_dir + "/out-cold"
    out_warm := item_dir + "/out-warm"

    if !build_x86(compiler, src_in_work, out_j1, 1, false, item_dir) { return false }
    if !build_x86(compiler, src_in_work, out_j4, 4, false, item_dir) { return false }
    if !build_x86(compiler, src_in_work, out_cold, 4, true, item_dir) { return false }
    if !build_x86(compiler, src_in_work, out_warm, 4, true, item_dir) { return false }

    if !check_elf64_x86_64(out_j1) { return false }
    if !check_bytes_equal(out_j1, out_j4, name + " j1 vs j4") { return false }
    if !check_bytes_equal(out_j1, out_cold, name + " j1 vs cold-inc") { return false }
    if !check_bytes_equal(out_j1, out_warm, name + " j1 vs warm-inc") { return false }
    if !check_objdump_clean(out_j1, name, true) { return false }
    true
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    // 1. examples/hello.ddr -> valid ELF64 + clean objdump
    hello_src := cli.root + "/examples/hello.ddr"
    hello_bin := work + "/hello"
    if !build_x86(cli.compiler, hello_src, hello_bin, 1, false, cli.root) { return false }
    if !check_elf64_x86_64(hello_bin) { return false }
    if !check_objdump_clean(hello_bin, "hello", true) { return false }

    // 2. benchmarks/runtime/{numeric, scan, sort}.ddr and synthetic feature_probe.ddr
    bench_names := ["numeric", "scan", "sort"]
    for name in bench_names {
        orig := cli.root + "/benchmarks/runtime/" + name + ".ddr"
        bench_bin := work + "/" + name + "-orig"
        if !build_x86(cli.compiler, orig, bench_bin, 4, false, cli.root) { return false }
        if !check_elf64_x86_64(bench_bin) { return false }
        if !check_objdump_clean(bench_bin, name, true) { return false }
    }

    feat_dir := work + "/iso-feature"
    if !fs.mkdir_all(feat_dir).ok { return harness.fail("mkdir_all failed") }
    feat_src := feat_dir + "/feature_probe.ddr"
    if !sys.write_text(feat_src, multi_feature_fixture()).ok {
        return harness.fail("failed to write feature_probe.ddr")
    }
    if !verify_corpus_item(cli.compiler, work, "feature_probe", feat_src) { return false }

    // 3. selfhost/main_parallel.ddr --target x86_64-linux
    prebuilt := process.env("DUNDER_X86_SELFHOST_BIN").unwrap_or("")
    if prebuilt.len > 0 && sys.metadata(prebuilt).is_file {
        if !check_elf64_x86_64(prebuilt) { return false }
    } else {
        sh_bin := work + "/dunder-selfhost-x86"
        if !build_x86(cli.compiler, cli.root + "/selfhost/main_parallel.ddr", sh_bin, 4, false, cli.root) {
            return false
        }
        if !check_elf64_x86_64(sh_bin) { return false }
    }

    print("PASS test-x86-mir: hello, numeric, scan, sort, feature_probe, and selfhost/main_parallel verified (ELF64, objdump clean, j1==j4==cold==warm)")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok {
        _ := sys.eprint(cli.error)
        return 2
    }
    if cli.extra_args.len > 0 {
        _ := sys.eprint("unexpected extra argument: " + cli.extra_args[0])
        return 2
    }
    tmp := fs.temp_dir("dunder-x86-mir-")
    if !tmp.ok {
        _ := sys.eprint("temp_dir failed")
        return 1
    }
    work := tmp.value
    ok := run_in_work(&cli, work)
    _ := fs.remove_all(work)
    if !ok { return 1 }
    0
}
