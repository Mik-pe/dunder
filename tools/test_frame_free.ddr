capability process, filesystem

import .harness as harness
import std.fs as fs
import std.parse as parse
import std.process as process
import sys

fn is_ws(b: i32) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

fn split_ws(s: string) -> []string {
    var out: []string = []
    var i := 0
    while i < s.len {
        while i < s.len && is_ws(s[i]) { i += 1 }
        if i >= s.len { break }
        start := i
        while i < s.len && !is_ws(s[i]) { i += 1 }
        out.push(s[start..i])
    }
    out
}

fn expected_status(selected: i32) -> i32 {
    if selected == 5 || selected == 7 || selected == 8 || selected == 9 { return 101 }
    if selected == 6 { return 102 }
    0
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    emitter := work + "/emitter"
    var res := harness.empty_output()
    var no_args: []string = []
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/frame-free-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    host := harness.host_id()
    for selected in 0..11 {
        status := expected_status(selected)
        for target in 0..3 {
            var words_off: i64 = 0
            var words_on: i64 = 0
            var img_off: []u8 = []
            var img_on: []u8 = []
            for mode in ["off", "on"] {
                image := work + "/" + selected.str() + "-" + target.str() + "-" + mode
                if !harness.run_checked(emitter, [image, target.str(), mode, selected.str()], work, 0, false, &mut res) {
                    return false
                }
                fields := split_ws(process.stdout_text(&res))
                if fields.len != 2 {
                    return harness.fail("expected 2 integers from frame-free emitter, got: " + process.stdout_text(&res))
                }
                words := parse.integer(fields[0])
                frameless := parse.integer(fields[1])
                if !words.ok || !frameless.ok {
                    return harness.fail("invalid emitter output: " + process.stdout_text(&res))
                }
                eligible := target < 2 && selected != 10 && mode == "on"
                var expected_frameless: i64 = 0
                if eligible { expected_frameless = 1 }
                if frameless.value != expected_frameless {
                    return harness.fail(selected.str() + "/" + target.str() + "/" + mode + ": wrong frame policy")
                }
                raw := sys.read_u8(image)
                if !raw.ok {
                    return harness.fail("failed to read image: " + image)
                }
                if mode == "off" {
                    words_off = words.value
                    img_off = raw.value
                } else {
                    words_on = words.value
                    img_on = raw.value
                }
                if target == host {
                    var ran := harness.empty_output()
                    if !harness.run_checked(image, no_args, work, status, false, &mut ran) {
                        return false
                    }
                    if ran.stdout.len != 0 || ran.stderr.len != 0 {
                        return harness.fail("unexpected target output: stdout=" + process.stdout_text(&ran) + " stderr=" + process.stderr_text(&ran))
                    }
                }
            }
            if target < 2 && selected != 10 {
                if words_on >= words_off {
                    return harness.fail(selected.str() + "/" + target.str() + ": frame omission did not shrink code")
                }
            } else if words_on != words_off || !harness.bytes_equal(&img_on, &img_off) {
                return harness.fail(selected.str() + "/" + target.str() + ": fallback code changed")
            }
        }
    }
    print("frame-free: all native targets built; host ABI, cycles, normalization, loops, spills and traps passed")
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len != 0 {
        return harness.fail("unexpected extra arguments")
    }
    td := fs.temp_dir("dunder-frame-free-")
    if !td.ok { return harness.fail("temp_dir failed") }
    ok := run_in_work(&cli, td.value)
    _ := fs.remove_all(td.value)
    ok
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
