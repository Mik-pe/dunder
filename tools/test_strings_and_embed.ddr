capability process, filesystem, stdio

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.text as text
import sys

fn strings_program() -> string {
    // Builds a Dunder program exercising raw strings, multiline dedent, raw multiline, and f"""..."""
    "const RAW_SINGLE: string = r\"path\\with\\slashes\\n\"\n" +
    "const RAW_HASH: string = r#\"quote \"here\" and r\"\" inside\"#\n" +
    "const RAW_HASH2: string = r##\"outer r#\"inner\"# end\"##\n" +
    "const MULTI_DEDENT: string = \"\"\"\n" +
    "        line1\n" +
    "          indented\n" +
    "\n" +
    "        escaped=\\n\\\"ok\\\"\n" +
    "        \"\"\"\n\n" +
    "@test fn strings_work_in_test_mode() {\n" +
    "    r_s := r'single\\raw\\quote\"'\n" +
    "    assert(r_s == \"single\\\\raw\\\\quote\\\"\")\n" +
    "    multi_raw := r#\"\"\"\n" +
    "        keep \\slashes\n" +
    "        and \"\"\" inside\n" +
    "        \"\"\"#\n" +
    "    assert(multi_raw == \"keep \\\\slashes\\nand \\\"\\\"\\\" inside\")\n" +
    "}\n\n" +
    "fn main() {\n" +
    "    assert(RAW_SINGLE == \"path\\\\with\\\\slashes\\\\n\")\n" +
    "    assert(RAW_HASH == \"quote \\\"here\\\" and r\\\"\\\" inside\")\n" +
    "    assert(RAW_HASH2 == \"outer r#\\\"inner\\\"# end\")\n" +
    "    assert(MULTI_DEDENT == \"line1\\n  indented\\n\\nescaped=\\n\\\"ok\\\"\")\n" +
    "\n" +
    "    raw_nl := r\"first line\nsecond line\\t\"\n" +
    "    assert(raw_nl == \"first line\\nsecond line\\\\t\")\n" +
    "\n" +
    "    inline_m := \"\"\"hello \"a\" and \"b\" ok\"\"\"\n" +
    "    assert(inline_m == \"hello \\\"a\\\" and \\\"b\\\" ok\")\n" +
    "    q1 := \"\"\"say \"hi\"\"\"\"\"\n" +
    "    assert(q1 == \"say \\\"hi\\\"\\\"\")\n" +
    "    q2 := \"\"\"tail \"\"\"\"\"\n" +
    "    assert(q2 == \"tail \\\"\\\"\")\n" +
    "\n" +
    "    empty_b := \"\"\"\n" +
    "        \"\"\"\n" +
    "    assert(empty_b == \"\")\n" +
    "\n" +
    "    // Interpolation multiline with braces, multiline expr inside hole, and dedent\n" +
    "    name := \"dunder\"\n" +
    "    val := 7\n" +
    "    fm := f\"\"\"\n" +
    "        hello {name} {{\n" +
    "        sum={val +\n" +
    "        5} }}\n" +
    "        \"\"\"\n" +
    "    assert(fm == \"hello dunder {\\nsum=12 }\")\n" +
    "    print(\"STR_OK\")\n" +
    "}\n"
}

fn pkg_nested_source() -> string {
    "pub const NESTED_SQL: string = @embed_file(\"assets/init.sql\")\n" +
    "pub const NESTED_MAGIC: [u8; 4] = @embed_bytes(\"assets/magic.bin\")\n\n" +
    "pub fn check_nested() -> bool {\n" +
    "    direct_sql := @embed_file(\"assets/init.sql\")\n" +
    "    direct_blob := @embed_bytes(\"assets/blob.bin\")\n" +
    "    direct_empty := @embed_bytes(\"assets/empty.bin\")\n" +
    "    if direct_sql != NESTED_SQL { return false }\n" +
    "    if direct_empty.len != 0 { return false }\n" +
    "    if NESTED_MAGIC[0] != b'D' || NESTED_MAGIC[3] != b'R' { return false }\n" +
    "    mut sum := 0\n" +
    "    for b in @embed_bytes(\"assets/magic.bin\") { sum += i32(b) }\n" +
    "    if sum != i32(b'D') + i32(b'N') + i32(b'D') + i32(b'R') { return false }\n" +
    "    direct_blob.len == 5 && direct_blob[0] == u8(0) && direct_blob[1] == u8(255) && direct_blob[2] == u8(254) && direct_blob[4] == u8(65)\n" +
    "}\n"
}

fn pkg_main_source() -> string {
    "import .sub.nested as nested\n" +
    "import std.bytes as bytes\n\n" +
    "const ROOT_SQL: string = @embed_file(\"assets/init.sql\")\n" +
    "const ROOT_BLOB: []u8 = @embed_bytes(\"assets/blob.bin\")\n" +
    "const EMPTY_BYTES: []u8 = @embed_bytes(\"assets/empty.bin\")\n" +
    "const LARGE_BYTES: []u8 = @embed_bytes(\"assets/large.bin\")\n\n" +
    "@test fn embed_works_in_test_mode() {\n" +
    "    assert(ROOT_SQL == nested.NESTED_SQL)\n" +
    "    assert(ROOT_BLOB.len == 5 && ROOT_BLOB[1] == u8(255))\n" +
    "    assert(EMPTY_BYTES.len == 0)\n" +
    "    assert(LARGE_BYTES.len == 65536)\n" +
    "    local_copy := @embed_bytes(\"assets/blob.bin\")\n" +
    "    root_copy := ROOT_BLOB\n" +
    "    assert(bytes.equal(&local_copy, &root_copy))\n" +
    "    assert(nested.check_nested())\n" +
    "}\n\n" +
    "fn main() {\n" +
    "    assert(nested.check_nested())\n" +
    "    assert(ROOT_SQL == @embed_file(\"assets/init.sql\"))\n" +
    "    root_copy := ROOT_BLOB\n" +
    "    blob_a := @embed_bytes(\"assets/blob.bin\")\n" +
    "    blob_b := @embed_bytes(\"assets/blob.bin\")\n" +
    "    assert(bytes.equal(&blob_a, &root_copy) && bytes.equal(&blob_b, &root_copy))\n" +
    "    assert(EMPTY_BYTES.len == 0)\n" +
    "    assert(LARGE_BYTES.len == 65536 && LARGE_BYTES[0] == u8(17) && LARGE_BYTES[65535] == u8(171))\n" +
    "    print(ROOT_SQL)\n" +
    "    print(i32(ROOT_BLOB[3]))\n" +
    "}\n"
}

fn standalone_source() -> string {
    "const TXT: string = @embed_file(\"local.txt\")\n" +
    "const RAW: []u8 = @embed_bytes(\"local.bin\")\n\n" +
    "fn main() {\n" +
    "    assert(TXT == \"standalone-ok\")\n" +
    "    assert(RAW.len == 3 && RAW[0] == u8(0) && RAW[1] == u8(255) && RAW[2] == u8(42))\n" +
    "    print(\"STANDALONE_OK\")\n" +
    "}\n"
}

fn fmt_sample_source() -> string {
    "const SQL:string=@embed_file(\"assets/init.sql\")\n" +
    "const RAW:string=r#\"a \"b\" c\"#\n" +
    "const MULTI:string=\"\"\"\n" +
    "    hello\n" +
    "    world\n" +
    "    \"\"\"\n" +
    "fn main(){x:=@embed_bytes(\"assets/magic.bin\");print(SQL)}\n"
}

fn check_pkg_negative(compiler: string, pkg: string, rel_file: string, code: string, expected_err: string) -> bool {
    path := pkg + "/neg_probe.ddr"
    if !sys.write_text(path, code).ok {
        return harness.fail(f"cannot write negative test file {path}")
    }
    res := harness.exec_cmd(compiler, ["check", path.clone()], pkg, false, 30000)
    if res.ok && res.code == 0 {
        return harness.fail(f"expected failure containing '{expected_err}' for {rel_file}, but check succeeded")
    }
    combined := res.stderr_text() + "\n" + res.stdout_text()
    if !text.contains(combined, expected_err) {
        return harness.fail(f"expected '{expected_err}' for {rel_file}, got:\n{combined}")
    }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    // 1. Raw & multiline strings + test mode + fmt
    str_path := work + "/strings.ddr"
    str_src := strings_program()
    if !sys.write_text(str_path, str_src).ok { return harness.fail("write strings.ddr") }

    mut out := harness.empty_output()
    str_bin := work + "/strings-bin"
    if !harness.run_checked_timeout(cli.compiler, ["build", str_path.clone(), "-o", str_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(str_bin, [], work, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "STR_OK\n", "strings runtime output") { return false }
    if !harness.run_checked_timeout(cli.compiler, ["test", str_path.clone()], work, 0, false, 60000, &mut out) { return false }

    // Format idempotency with raw/multiline strings and @embed_*
    fmt_path := work + "/fmt_sample.ddr"
    if !sys.write_text(fmt_path, fmt_sample_source()).ok { return harness.fail("write fmt_sample.ddr") }
    if !harness.run_checked_timeout(cli.compiler, ["fmt", "--stdout", fmt_path.clone()], work, 0, false, 60000, &mut out) { return false }
    formatted_1 := out.stdout_text()
    if !sys.write_text(fmt_path, formatted_1.clone()).ok { return harness.fail("rewrite fmt_sample.ddr") }
    if !harness.run_checked_timeout(cli.compiler, ["fmt", "--check", fmt_path.clone()], work, 0, false, 60000, &mut out) { return false }

    // 2. Package @embed_file / @embed_bytes
    outside := work + "/outside.txt"
    if !sys.write_text(outside, "secret-outside").ok { return harness.fail("write outside.txt") }

    pkg := work + "/pkg"
    if !fs.mkdir_all(pkg + "/src/sub").ok || !fs.mkdir_all(pkg + "/assets").ok { return harness.fail("mkdir pkg") }
    if !sys.write_text(pkg + "/dunder.toml", "name = \"embed_pkg\"\nroot = \"src/main.ddr\"\n").ok { return harness.fail("write dunder.toml") }
    if !sys.write_text(pkg + "/assets/init.sql", "SELECT 1;").ok { return harness.fail("write init.sql") }
    if !sys.write_u8(pkg + "/assets/blob.bin", &[u8(0), u8(255), u8(254), u8(77), u8(65)]).ok { return harness.fail("write blob.bin") }
    if !sys.write_u8(pkg + "/assets/magic.bin", &[b'D', b'N', b'D', b'R']).ok { return harness.fail("write magic.bin") }
    empty_u8: []u8 = []
    if !sys.write_u8(pkg + "/assets/empty.bin", &empty_u8).ok { return harness.fail("write empty.bin") }
    mut big: []u8 = []
    big.reserve(65536)
    for bi in 0..65536 { big.push(if bi == 65535 { u8(171) } else { u8(17) }) }
    if !sys.write_u8(pkg + "/assets/large.bin", &big).ok { return harness.fail("write large.bin") }
    if !fs.symlink(outside, pkg + "/assets/escape_link.txt").ok { return harness.fail("symlink escape fixture") }
    if !sys.write_text(pkg + "/src/sub/nested.ddr", pkg_nested_source()).ok { return harness.fail("write nested.ddr") }
    if !sys.write_text(pkg + "/src/main.ddr", pkg_main_source()).ok { return harness.fail("write main.ddr") }

    // Build & run package (serial and --jobs 4 determinism)
    bin_j1 := work + "/pkg-j1"
    bin_j4 := work + "/pkg-j4"
    if !harness.run_checked_timeout(cli.compiler, ["build", pkg + "/src/main.ddr", "--jobs", "1", "-o", bin_j1.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(cli.compiler, ["build", pkg + "/src/main.ddr", "--jobs", "4", "-o", bin_j4.clone()], work, 0, false, 60000, &mut out) { return false }
    b1 := sys.read_u8(bin_j1)
    b4 := sys.read_u8(bin_j4)
    if !b1.ok || !b4.ok || !bytes.equal(&b1.value, &b4.value) { return harness.fail("parallel @embed builds differ") }

    if !harness.run_checked_timeout(bin_j1, [], work, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "SELECT 1;\n77\n", "embed pkg output v1") { return false }

    // Run @test inside package (!token_offsets path)
    if !harness.run_checked_timeout(cli.compiler, ["test", pkg + "/src/main.ddr"], work, 0, false, 60000, &mut out) { return false }

    // Cross-compile targets
    for target in ["arm64-linux", "x86_64-linux", "wasm32-wasi"] {
        if !harness.run_checked_timeout(cli.compiler, ["build", pkg + "/src/main.ddr", "--target", target.clone(), "-o", work + "/pkg-" + target], work, 0, false, 60000, &mut out) {
            return false
        }
    }

    // Incremental cache invalidation when embedded files change without touching .ddr sources
    inc_bin := work + "/pkg-inc"
    if !harness.run_checked_timeout(cli.compiler, ["build", pkg + "/src/main.ddr", "--incremental", "-o", inc_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(inc_bin, [], work, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "SELECT 1;\n77\n", "incremental embed v1") { return false }

    if !sys.write_text(pkg + "/assets/init.sql", "SELECT 2;").ok { return harness.fail("update init.sql") }
    if !sys.write_u8(pkg + "/assets/blob.bin", &[u8(0), u8(255), u8(254), u8(99), u8(65)]).ok { return harness.fail("update blob.bin") }
    if !harness.run_checked_timeout(cli.compiler, ["build", pkg + "/src/main.ddr", "--incremental", "-o", inc_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(inc_bin, [], work, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "SELECT 2;\n99\n", "incremental embed v2") { return false }

    // Restore init.sql/blob.bin before negative checks
    if !sys.write_text(pkg + "/assets/init.sql", "SELECT 1;").ok { return harness.fail("restore init.sql") }

    // 3. Standalone script without dunder.toml
    solo := work + "/solo"
    if !fs.mkdir_all(solo).ok { return harness.fail("mkdir solo") }
    if !sys.write_text(solo + "/local.txt", "standalone-ok").ok { return harness.fail("write local.txt") }
    if !sys.write_u8(solo + "/local.bin", &[u8(0), u8(255), u8(42)]).ok { return harness.fail("write local.bin") }
    if !sys.write_text(solo + "/main.ddr", standalone_source()).ok { return harness.fail("write solo main.ddr") }
    solo_bin := work + "/solo-bin"
    if !harness.run_checked_timeout(cli.compiler, ["build", solo + "/main.ddr", "-o", solo_bin.clone()], solo, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(solo_bin, [], solo, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "STANDALONE_OK\n", "standalone embed output") { return false }

    // 4. Negative checks (confinement, errors, invalid strings)
    if !check_pkg_negative(cli.compiler, pkg, "parent escape", "const S: string = @embed_file(\"../outside.txt\")\nfn main() {}\n", "stay within the package root") { return false }
    if !check_pkg_negative(cli.compiler, pkg, "abs path", "const S: string = @embed_file(\"/etc/hosts\")\nfn main() {}\n", "relative to the package root") { return false }
    if !check_pkg_negative(cli.compiler, pkg, "symlink escape", "const S: string = @embed_file(\"assets/escape_link.txt\")\nfn main() {}\n", "escapes the package root") { return false }
    if !check_pkg_negative(cli.compiler, pkg, "missing file", "const S: string = @embed_file(\"assets/missing.sql\")\nfn main() {}\n", "file not found") { return false }
    if !check_pkg_negative(cli.compiler, pkg, "directory embed", "const B: []u8 = @embed_bytes(\"assets\")\nfn main() {}\n", "not a regular file") { return false }
    if !check_pkg_negative(cli.compiler, pkg, "non-utf8 embed_file", "const S: string = @embed_file(\"assets/blob.bin\")\nfn main() {}\n", "not valid UTF-8") { return false }
    if !check_pkg_negative(cli.compiler, pkg, "non-literal arg", "fn main() { p := \"assets/init.sql\"; _ := @embed_file(p) }\n", "expects a string literal path") { return false }

    inv: [](string, string) = [
        ("fn main() {\n    s := \"\"\"\n  bad\n    \"\"\"\n}\n", "indented less than closing delimiter"),
        ("fn main() { _ := r#\"open }\n", "unterminated raw string literal"),
        ("fn main() { _ := \"\"\"open }\n", "unterminated multiline string literal"),
    ]
    if !harness.check_rejected_specializations(cli.compiler, work, &inv) { return false }

    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if cli.extra_args.len > 0 { _ := sys.eprint("unexpected argument: " + cli.extra_args[0]); return 2 }
    tmp := fs.temp_dir("dunder-strings-embed-")
    if !tmp.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if !run_suite(&cli, work) { return 1 }
    print("PASS strings and embed: raw, multiline dedent, f\"\"\", @embed_file/@embed_bytes, cross-target, incremental, confinement verified")
    0
}
