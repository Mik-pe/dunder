capability unsafe

import std.array as array

@extern("c", "clock_gettime")
unsafe fn clock_gettime(clock: i32, time: ptr) -> i32

@c_layout struct Timespec { seconds: i64, nanoseconds: i64 }

pub fn now_ns() -> i64 {
    mut time := Timespec { seconds: 0, nanoseconds: 0 }
    clock := if target_is("macos") { 8 } else { 1 }
    unsafe {
        if clock_gettime(clock, addr(&mut time)) != 0 { return -1 }
    }
    time.seconds * 1000000000 + time.nanoseconds
}

pub fn milliseconds(nanoseconds: i64) -> f64 { f64(nanoseconds) / 1000000.0 }

pub fn fixed_ms(nanoseconds: i64) -> string {
    f"{nanoseconds / 1000000}.{nanoseconds % 1000000:06}"
}

pub struct Distribution { median: f64, p95: f64 }

pub fn distribution(move nanoseconds: []i64) -> Distribution {
    mut sorted := nanoseconds
    array.sort<i64>(&mut sorted)
    n := sorted.len
    assert(n > 0)
    middle := n / 2
    median := (milliseconds(sorted[(n - 1) / 2]) + milliseconds(sorted[middle])) * 0.5
    p95 := i32((i64(n) * 95 + 99) / 100) - 1
    Distribution { median: median, p95: milliseconds(sorted[p95]) }
}

pub fn median_ratio(move ratio_bits: []i64) -> f64 {
    mut sorted := ratio_bits
    array.sort<i64>(&mut sorted)
    n := sorted.len
    assert(n > 0)
    (f64.from_bits(sorted[(n - 1) / 2]) + f64.from_bits(sorted[n / 2])) * 0.5
}
