capability process, filesystem, stdio

import .harness as harness
import .test_evidence as evidence
import std.json as json
import std.parse as parse
import sys

struct Image {
    target: string,
    form: string,
    equal: i32,
    mode: string,
    call_flags: i32,
    compare_flags_live: bool,
    compare_removed: bool,
    value_deleted: i64,
    expected_observer_result: i32,
    sha256: string,
}

struct Evidence {
    journal: evidence.Journal,
    images: []Image,
    executions: i32,
}

fn check_case(lines: &[]string, flags: i32, control: bool, mode: string) -> bool {
    if lines.len != 12 { return false }
    live := if flags == 3 { "true" } else { "false" }
    removed := if control { "true" } else { "false" }
    if lines[0] != flags.str() || lines[1] != live || lines[2] != live || lines[3] != removed ||
       lines[6] != "-1" || lines[7] != "0" || lines[8] != "-1" || lines[9] != "1" || lines[10] != "2" || lines[11] != "true" {
        return false
    }
    deleted := parse.integer(lines[5])
    deleted.ok && (mode != "value" || (lines[4] == "true" && deleted.value >= 1))
}

fn run_suite(cli: &harness.BaseCli, work: string, flags: i32, report: &mut Evidence) -> bool {
    host := harness.host_id()
    targets := harness.targets()
    emitter := work + "/emitter"
    file := cli.root + "/tests/fixtures/mir-call-flags-emitter.ddr"
    mut result := harness.empty_output()
    if !report.journal.run(cli.compiler, ["build", file, "-o", emitter.clone()], &mut result) { return false }
    for target in 0..targets.len {
        name := targets[target].clone()
        for form in ["direct", "indirect"] {
            for equal in 0..2 {
                for mode in ["off", "value", "liveness-control"] {
                    image := f"{work}/{name}-{form}-{equal}-{mode}"
                    if !report.journal.run(emitter, [image.clone(), target.str(), form.clone(), mode.clone(), equal.str()], &mut result) { return false }
                    output := result.stdout_text()
                    lines := harness.lines(output)
                    control := mode == "liveness-control" && flags == 2
                    if !check_case(&lines, flags, control, mode) {
                        return harness.fail(f"{name} {form} {mode}: unexpected flag, liveness or retained contract:\n{output}")
                    }
                    expected := if control { 1 - equal } else { equal }
                    report.images.push(Image {
                        target: name.clone(), form: form.clone(), equal: equal, mode: mode.clone(),
                        call_flags: flags, compare_flags_live: flags == 3, compare_removed: control,
                        value_deleted: parse.integer(lines[5]).value, expected_observer_result: expected,
                        sha256: harness.sha256_file_hex(image),
                    })
                    if target == host {
                        if !report.journal.run(image, [], &mut result) || !harness.stdout_is(&result, expected.str() + "\n", image) { return false }
                        report.executions += 1
                    }
                }
            }
        }
    }
    true
}

fn save(cli: &harness.BaseCli, work: string, flags: i32, passed: bool, report: &Evidence) -> bool {
    mut commands := json.Writer::new()
    report.journal.write_to(&mut commands, "command")
    commands_ok := evidence.save(work + "/commands.json", &commands)

    mut writer := json.Writer::new()
    writer.object()
    writer.key("result")
    writer.string(if passed { "passed" } else { "failed" })
    writer.key("expected_call_flags")
    writer.integer(i64(flags))
    writer.key("compiler_sha256")
    writer.string(harness.sha256_file_hex(cli.compiler))
    writer.key("source_sha256")
    sources: []string = [
        "tests/fixtures/mir_machine_decode.ddr", "selfhost/mir/mir_retained.ddr", "selfhost/mir/mir_liveness.ddr",
        "selfhost/mir/mir_value_prop.ddr", "tests/fixtures/mir-call-flags-emitter.ddr",
    ]
    evidence.write_source_digests(&mut writer, cli.root, &sources)
    writer.key("images")
    writer.array()
    for image in report.images {
        writer.object()
        writer.key("target")
        writer.string(image.target)
        writer.key("form")
        writer.string(image.form)
        writer.key("equal")
        writer.integer(i64(image.equal))
        writer.key("mode")
        writer.string(image.mode)
        writer.key("call_flags")
        writer.integer(i64(image.call_flags))
        writer.key("compare_flags_live")
        writer.boolean(image.compare_flags_live)
        writer.key("compare_removed")
        writer.boolean(image.compare_removed)
        writer.key("value_deleted")
        writer.integer(image.value_deleted)
        writer.key("expected_observer_result")
        writer.integer(i64(image.expected_observer_result))
        writer.key("sha256")
        writer.string(image.sha256)
        writer.end()
    }
    writer.end()
    host := harness.target_name(harness.host_id())
    writer.key("executions")
    writer.object()
    writer.key(host)
    writer.integer(i64(report.executions))
    writer.end()
    writer.key("host_target")
    writer.string(host)
    writer.key("cross_built_only")
    writer.array()
    for target in harness.targets() {
        if target != host { writer.string(target) }
    }
    writer.end()
    writer.key("production_value_pass")
    writer.string("productive; Compare retained, observer result preserved before and after fix")
    writer.key("liveness_control")
    writer.string("test-only demonstration; not a production pass or claimed production miscompile")
    writer.end()
    evidence.save(work + "/summary.json", &writer) && commands_ok
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    mut flags := 3
    if cli.extra_args.len > 0 {
        if cli.extra_args.len != 2 || cli.extra_args[0] != "--expected-call-flags" ||
           (cli.extra_args[1] != "2" && cli.extra_args[1] != "3") {
            _ := sys.eprint("usage: test_mir_call_flags <compiler> [--output path] [--expected-call-flags 2|3]")
            return 2
        }
        if cli.extra_args[1] == "2" { flags = 2 }
    }
    base := if cli.output_dir.len > 0 { cli.output_dir.clone() } else { cli.root + "/build/mir-call-flags" }
    work := evidence.create_run(base)
    if work.len == 0 { return 1 }
    mut report := Evidence { journal: evidence.Journal::new(cli.root, 120000), images: [], executions: 0 }
    passed := run_suite(&cli, work, flags, &mut report)
    saved := save(&cli, work, flags, passed, &report)
    status := if passed && saved { "PASS" } else { "FAIL" }
    print(f"{status} raw call flags: {work}")
    if passed && saved { 0 } else { 1 }
}
