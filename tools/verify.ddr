capability process, filesystem

import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.parse as parse
import std.process as process
import std.text as text
import sys

struct Jobs {
    names: []string,
    progs: []string,
    arg_start: []i32,
    arg_end: []i32,
    all_args: []string,
    deps: []i32,
    is_fast: []bool,
}

fn new_jobs() -> Jobs {
    Jobs {
        names: [], progs: [], arg_start: [], arg_end: [],
        all_args: [], deps: [], is_fast: [],
    }
}

fn add_job(j: &mut Jobs, name: string, prog: string, move args: []string, dep: i32, fast: bool) -> i32 {
    id := j.names.len
    j.names.push(name.clone())
    j.progs.push(prog.clone())
    j.arg_start.push(j.all_args.len)
    for a in move args { j.all_args.push(move a) }
    j.arg_end.push(j.all_args.len)
    j.deps.push(dep)
    j.is_fast.push(fast)
    id
}

fn add_ddr_suite_args(j: &mut Jobs, compiler: string, root: string, work: string, name: string, source: string, fast: bool, move extra: []string) {
    bin_path := work + "/tool-" + name
    src_path := root + "/tools/" + source + ".ddr"
    mut args: []string = ["run", src_path, "--jobs", "1", "-o", bin_path, "--", compiler.clone()]
    for arg in move extra { args.push(move arg) }
    _ := add_job(&mut j, name, compiler, move args, -1, fast)
}

fn add_ddr_suite(j: &mut Jobs, compiler: string, root: string, work: string, name: string, source: string, fast: bool) {
    add_ddr_suite_args(&mut j, compiler, root, work, name, source, fast, [])
}

fn add_ddr_tool(j: &mut Jobs, compiler: string, root: string, work: string, tool_name: string, fast: bool) {
    add_ddr_suite(&mut j, compiler, root, work, tool_name, tool_name, fast)
}

fn add_unit_test(j: &mut Jobs, compiler: string, root: string, work: string, mod_name: string, unit_jobs: string, fast: bool) {
    out_dir := work + "/unit-" + mod_name
    src_path := root + "/tests/" + mod_name + ".ddr"
    _ := add_job(&mut j, "unit:" + mod_name, compiler,
        ["test", src_path, "--jobs", unit_jobs.clone(), "-o", out_dir], -1, fast)
}

fn format_sec(ms: i64) -> string {
    sec := ms / 1000
    tenths := (ms % 1000) / 100
    sec.str() + "." + tenths.str() + "s"
}

fn matches_filters(name: string, filters: &[]string) -> bool {
    if filters.len == 0 { return true }
    for f in filters {
        if text.find(name, f) >= 0 { return true }
    }
    false
}

fn main() -> i32 {
    t_start := sys.now_ms()
    mut compiler_arg := ""
    mut serial_arg := ""
    mut mir_reports_arg := ""
    mut fast_only := false
    mut max_workers := process.host_cpus()
    mut filters: []string = []

    argc := sys.arg_count()
    mut ai := 1
    while ai < argc {
        a := sys.arg(ai)
        if a == "--fast" {
            fast_only = true
        } else if a == "--full" {
            fast_only = false
        } else if a == "--jobs" {
            if ai + 1 >= argc { _ := sys.eprint("--jobs requires a value"); return 2 }
            ai += 1
            parsed := parse.integer(sys.arg(ai))
            if !parsed.ok || parsed.value < 1 || parsed.value > 256 {
                _ := sys.eprint("--jobs must be between 1 and 256")
                return 2
            }
            max_workers = i32(parsed.value)
        } else if a == "--filter" {
            if ai + 1 >= argc { _ := sys.eprint("--filter requires a substring"); return 2 }
            ai += 1
            filters.push(sys.arg(ai))
        } else if a == "--serial-compiler" {
            if ai + 1 >= argc { _ := sys.eprint("--serial-compiler requires a path"); return 2 }
            ai += 1
            serial_arg = sys.arg(ai)
        } else if a == "--mir-reports" {
            if ai + 1 >= argc { _ := sys.eprint("--mir-reports requires a directory"); return 2 }
            ai += 1
            mir_reports_arg = sys.arg(ai)
        } else if text.starts_with(a, "-") {
            _ := sys.eprint("unknown option: " + a)
            return 2
        } else if compiler_arg.len == 0 {
            compiler_arg = a
        } else {
            _ := sys.eprint("unexpected positional argument: " + a)
            return 2
        }
        ai += 1
    }

    if compiler_arg.len == 0 {
        _ := sys.eprint("usage: verify <compiler> [--fast] [--filter substr] [--jobs N] [--serial-compiler path] [--mir-reports dir]")
        return 2
    }

    comp_rp := fs.realpath(compiler_arg)
    if !comp_rp.ok {
        _ := sys.eprint("compiler not found: " + compiler_arg)
        return 1
    }
    compiler := comp_rp.value

    cwd_rp := fs.cwd()
    if !cwd_rp.ok { _ := sys.eprint("cwd failed"); return 1 }
    mut root := cwd_rp.value
    if !sys.metadata(root + "/selfhost/main.ddr").is_file {
        parent_rp := fs.realpath(root + "/..")
        if parent_rp.ok && sys.metadata(parent_rp.value + "/selfhost/main.ddr").is_file {
            root = parent_rp.value
        }
    }

    tmp_res := fs.temp_dir("dunder-verify-")
    if !tmp_res.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    work := tmp_res.value
    defer { _ := fs.remove_all(work) }

    mut mir_reports := mir_reports_arg
    if mir_reports.len == 0 {
        mir_reports = work + "/mir-reports"
        if !fs.mkdir_all(mir_reports).ok {
            _ := sys.eprint("failed creating mir_reports dir")
            return 1
        }
    }

    mut serial_compiler := ""
    if serial_arg.len > 0 {
        srp := fs.realpath(serial_arg)
        if srp.ok { serial_compiler = srp.value }
    } else {
        default_serial := root + "/build/selfhost/arm64-macos/dunder-serial"
        if sys.metadata(default_serial).is_file { serial_compiler = default_serial }
    }

    mut jobs := new_jobs()

    _ := add_job(&mut jobs, "test-release", "python3", [root + "/tools/test-release.py"], -1, false)
    _ := add_job(&mut jobs, "test-const-div", "python3", [root + "/tools/test-const-div.py", compiler.clone(), "--verify-selection"], -1, false)
    _ := add_job(&mut jobs, "test-optimizer", "python3", [root + "/tools/test-optimizer.py", compiler.clone(), "--verify-selection"], -1, false)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir:oracle", "test_mir", false, ["--only", "oracle"])
    _ := add_job(&mut jobs, "test-mir-ssa", "python3", [root + "/tools/test-mir-ssa.py", compiler.clone(), "--report", root + "/build/mir-ssa-integrated.json"], -1, false)
    _ := add_job(&mut jobs, "test-mir-expr", "python3", [root + "/tools/test-mir-expr.py", compiler.clone(), "--output", mir_reports + "/expression", "--report", mir_reports + "/expression.json"], -1, false)
    _ := add_job(&mut jobs, "test-range-analysis", "python3", [root + "/tools/test-range-analysis.py", compiler.clone()], -1, false)
    _ := add_job(&mut jobs, "test-cli", "python3", [root + "/tools/test-cli.py", compiler.clone()], -1, false)
    _ := add_job(&mut jobs, "test-mir-regions", "python3", [root + "/tools/test-mir-regions.py", compiler.clone(), "--output", mir_reports + "/regions", "--report", mir_reports + "/regions.json"], -1, false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-mir-scalar", "test_mir_scalar", false)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir:source", "test_mir", false, ["--only", "source"])
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-pipeline", "test_mir_pipeline", false,
        ["--report", root + "/build/mir-pipeline-integrated.json"])
    _ := add_job(&mut jobs, "test-register-comparisons", "python3", [root + "/tools/test-register-comparisons.py", compiler.clone()], -1, false)
    _ := add_job(&mut jobs, "test-inline-producer", "python3", [root + "/tools/test-inline-producer.py", compiler.clone()], -1, false)
    _ := add_job(&mut jobs, "test-runtime-contracts", "python3", [root + "/tools/test-runtime-contracts.py", compiler.clone()], -1, false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-opt-emitter", "test_opt_emitter", false)
    _ := add_job(&mut jobs, "test-utf8-next", "python3", [root + "/tools/test-utf8-next.py", compiler.clone()], -1, false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-array-addresses", "test_array_addresses", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_range_emitter", false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-mir-values", "test_mir_values", false)
    if serial_compiler.len > 0 {
        _ := add_job(&mut jobs, "test-parallel-compiler", "python3",
            [root + "/tools/test-parallel-compiler.py", compiler.clone(), "--baseline", serial_compiler.clone(), "--output", root + "/build/parallel-compiler-qa"], -1, false)
    } else {
        _ := add_job(&mut jobs, "test-parallel-compiler", "python3",
            [root + "/tools/test-parallel-compiler.py", compiler.clone(), "--output", root + "/build/parallel-compiler-qa"], -1, false)
    }
    _ := add_job(&mut jobs, "test-task-source", "python3", [root + "/tools/test-task-source.py", compiler.clone()], -1, false)
    if process.host_target() == "arm64-macos" {
        add_ddr_suite_args(&mut jobs, compiler, root, work, "test-task-scope", "test_task_darwin", false, ["--scope"])
        add_ddr_suite(&mut jobs, compiler, root, work, "test-task-native", "test_task_darwin", false)
    } else if !fast_only {
        print("BLOCKED native task Mach-O dylib probes: require ARM64/macOS")
    }
    if process.host_target() == "arm64-macos" {
        add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-frame-exits", "test_mir_frame_exits", false,
            ["--output", root + "/build/mir-frame-exits-integrated"])
    } else if !fast_only {
        print("BLOCKED MIR frame-exit native observer: requires ARM64/macOS; portable unit coverage remains enabled")
    }
    add_ddr_suite(&mut jobs, compiler, root, work, "test-fragment-dependencies", "test_fragment_dependencies", false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-record-take", "test_record_take", false)
    _ := add_job(&mut jobs, "test-runtime-profile", "python3", [root + "/tools/test-runtime-profile.py", compiler.clone()], -1, false)
    _ := add_job(&mut jobs, "test-record-take-source", "python3", [root + "/tools/test-record-take-source.py", compiler.clone()], -1, false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-compiler-session", "test_compiler_session", false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-mir-fragments", "test_mir_fragments", false)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-inline-streaming", "test_inline_streaming", false)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-call-flags", "test_mir_call_flags", false,
        ["--output", root + "/build/mir-call-flags-integrated"])
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-object-data", "test_mir_object_data", false,
        ["--output", mir_reports + "/object-data"])
    add_ddr_suite(&mut jobs, compiler, root, work, "test-ownership-leases", "test_ownership_leases", false)
    _ := add_job(&mut jobs, "test-ssa-source", "python3", [root + "/tools/test-ssa-source.py", compiler.clone()], -1, false)
    _ := add_job(&mut jobs, "profile-dogfood", "python3", [root + "/tools/profile-dogfood.py", "check", compiler.clone()], -1, false)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-stack-origin", "test_mir_stack_origin", false,
        ["--output", mir_reports + "/stack-origin"])
    _ := add_job(&mut jobs, "test-upgrade", "python3", [root + "/tools/test-upgrade.py", compiler.clone()], -1, false)
    _ := add_job(&mut jobs, "test-interpolation", "python3", [root + "/tools/test-interpolation.py", compiler.clone()], -1, true)
    _ := add_job(&mut jobs, "test-math", "python3", [root + "/tools/test-math.py", compiler.clone()], -1, true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-syntax-bridge", "test_syntax_bridge", true)
    _ := add_job(&mut jobs, "test-assert-diagnostics", "python3", [root + "/tools/test-assert-diagnostics.py", compiler.clone()], -1, true)
    _ := add_job(&mut jobs, "test-terminal-flow", "python3", [root + "/tools/test-terminal-flow.py", compiler.clone()], -1, true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-closures", "test_closures", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-generics", "test_generics", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-results", "test_results", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-collections", "test_collections", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-value-blocks", "test_value_blocks", true)
    _ := add_job(&mut jobs, "test-git-dependencies", "python3", [root + "/tools/test-git-dependencies.py", compiler.clone()], -1, true)
    _ := add_job(&mut jobs, "test-array-moves", "python3", [root + "/tools/test-array-moves.py", compiler.clone()], -1, true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-aggregate-arrays", "test_aggregate_arrays", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-memory-bytes", "test_memory_bytes", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-stdlib-ownership", "test_stdlib_ownership", true)
    _ := add_job(&mut jobs, "test-http", "python3", [root + "/tools/test-http.py", "--compiler", compiler.clone()], -1, true)
    _ := add_job(&mut jobs, "test-http-client", "python3", [root + "/tools/test-http-client.py", compiler.clone()], -1, true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-sqlite", "test_sqlite", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-crypto", "test_crypto", true)
    _ := add_job(&mut jobs, "test-toml", "python3", [root + "/tools/test-toml.py", compiler.clone()], -1, true)
    _ := add_job(&mut jobs, "test-process-replace", "python3", [root + "/tools/test-process-replace.py", compiler.clone()], -1, true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-process-signals", "test_process_signals", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-process-environment", "test_process_environment", true)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-resource-moves", "test_resource_moves", true)
    _ := add_job(&mut jobs, "test-partial-moves", "python3", [root + "/tools/test-partial-moves.py", compiler.clone(), "--inline-replace"], -1, true)
    _ := add_job(&mut jobs, "test-local-borrows", "python3", [root + "/tools/test-local-borrows.py", compiler.clone()], -1, true)
    _ := add_job(&mut jobs, "test-returned-borrows", "python3", [root + "/tools/test-returned-borrows.py", compiler.clone()], -1, true)
    _ := add_job(&mut jobs, "test-resource-ownership", "python3", [root + "/tools/test-resource-ownership.py", compiler.clone()], -1, true)

    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_promotion", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_frame_free", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_inline_catalog", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_memory", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_array_capacity", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_expression_emitter", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_link", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_objects", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_entry", false)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_native", false)

    unit_jobs := "__UNIT_JOBS__"

    add_unit_test(&mut jobs, compiler, root, work, "budget", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "suite", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "impl_blocks", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "compile_frontend", unit_jobs, true)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_diagnostics", true)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_check", true)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_conditionals", true)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_resolver", true)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_ffi", true)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_files", true)

    add_unit_test(&mut jobs, compiler, root, work, "mir", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "mir_branch", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "mir_verify", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "mir_lower", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "mir_object", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_pipeline", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "mir_task", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "mir_call_inputs", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_liveness_inputs", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa_cells", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa_sparse", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_frame_exits", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_stack_origin", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_expr_stack", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa_joint", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "task_data", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "task_effects", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "task_native", unit_jobs, true)
    add_unit_test(&mut jobs, compiler, root, work, "task_scope_emit", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_retained", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_dataflow", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_preserve", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_scalar", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_memory", unit_jobs, false)
    add_unit_test(&mut jobs, compiler, root, work, "mir_value_prop", unit_jobs, false)

    total_defined := jobs.names.len
    mut selected: []bool = []
    for j in 0..total_defined {
        mut keep := true
        if fast_only && !jobs.is_fast[j] { keep = false }
        if !matches_filters(jobs.names[j], &filters) { keep = false }
        selected.push(keep)
    }
    for j in 0..total_defined {
        if selected[j] && jobs.deps[j] >= 0 {
            selected[jobs.deps[j]] = true
        }
    }

    mut total_selected := 0
    mut state: []i32 = []
    mut elapsed_ms: []i64 = []
    for j in 0..total_defined {
        elapsed_ms.push(0)
        if selected[j] { state.push(1); total_selected += 1 }
        else { state.push(0) }
    }

    if total_selected == 0 {
        _ := sys.eprint("no suites matched selection")
        return 2
    }

    mut pool_cap := max_workers
    if pool_cap > total_selected { pool_cap = total_selected }
    mut child_jobs := max_workers / pool_cap
    if child_jobs < 1 { child_jobs = 1 }
    if process.host_target() != "arm64-macos" { child_jobs = 1 }
    for k in 0..jobs.all_args.len {
        if jobs.all_args[k] == "__UNIT_JOBS__" { jobs.all_args[k] = child_jobs.str() }
    }
    mut pool := process.set_new(pool_cap)
    defer { process.set_kill_all(&mut pool) }

    mut slot_job: []i32 = []
    mut slot_start: []i64 = []
    mut slot_out: []string = []
    mut slot_err: []string = []
    for _ in 0..pool_cap {
        slot_job.push(-1)
        slot_start.push(0)
        slot_out.push("")
        slot_err.push("")
    }

    mut raw_out: []u8 = []
    mut raw_err: []u8 = []
    mut completed := 0
    mut failed := 0
    timeout_limit_ms: i64 = 240000

    while completed < total_selected {
        for j in 0..total_defined {
            if state[j] == 1 && jobs.deps[j] >= 0 && state[jobs.deps[j]] == 4 {
                state[j] = 4
                completed += 1
                failed += 1
                print("[" + completed.str() + "/" + total_selected.str() + "] FAIL " + jobs.names[j] + " (prerequisite failed)")
            }
        }
        if completed >= total_selected { break }

        for j in 0..total_defined {
            if process.set_len(&pool) >= pool_cap { break }
            if state[j] != 1 { continue }
            if jobs.deps[j] >= 0 && state[jobs.deps[j]] != 3 { continue }

            mut cmd_args: []string = []
            for k in jobs.arg_start[j]..jobs.arg_end[j] {
                cmd_args.push(jobs.all_args[k].clone())
            }
            mut cmd := process.command(jobs.progs[j].clone(), move cmd_args)
            process.set_cwd(&mut cmd, root.clone())
            process.set_env(&mut cmd, "DUNDER_CHILD_JOBS", child_jobs.str())
            sp := process.spawn(&cmd)
            if !sp.ok {
                if (sp.error == 35 || sp.error == 12 || sp.error == 24 || sp.error == 23) && process.set_len(&pool) > 0 {
                    break
                }
                state[j] = 4
                completed += 1
                failed += 1
                print("[" + completed.str() + "/" + total_selected.str() + "] FAIL " + jobs.names[j] + " (spawn error " + sp.error.str() + ")")
                continue
            }
            mut child := sp.child
            slot := process.set_insert(&mut pool, &mut child)
            assert(slot >= 0)
            state[j] = 2
            slot_job[slot] = j
            slot_start[slot] = sys.now_ms()
            slot_out[slot] = ""
            slot_err[slot] = ""
        }

        if process.set_len(&pool) == 0 { continue }

        _ := process.set_wait_any(&mut pool, 50)
        now := sys.now_ms()

        for slot in 0..pool_cap {
            if !process.set_active(&pool, slot) { continue }
            j := slot_job[slot]
            raw_out.clear()
            raw_err.clear()
            mut w := process.set_try_wait(&mut pool, slot, &mut raw_out, &mut raw_err)
            if !w.exited && now - slot_start[slot] >= timeout_limit_ms {
                w = process.set_kill_reap(&mut pool, slot, &mut raw_out, &mut raw_err)
            }
            if raw_out.len > 0 {
                dec_o := bytes.decode(&raw_out)
                if dec_o.ok { slot_out[slot] += dec_o.value }
            }
            if raw_err.len > 0 {
                dec_e := bytes.decode(&raw_err)
                if dec_e.ok { slot_err[slot] += dec_e.value }
            }
            if w.exited {
                dur := sys.now_ms() - slot_start[slot]
                elapsed_ms[j] = dur
                completed += 1
                if w.ok && !w.timed_out && w.signal == 0 && w.code == 0 {
                    state[j] = 3
                    print("[" + completed.str() + "/" + total_selected.str() + "] PASS " + jobs.names[j] + " (" + dur.str() + "ms)")
                } else {
                    state[j] = 4
                    failed += 1
                    print("[" + completed.str() + "/" + total_selected.str() + "] FAIL " + jobs.names[j] + " (exit " + w.code.str() + ", " + dur.str() + "ms)")
                    out_trim := text.trim(slot_out[slot])
                    err_trim := text.trim(slot_err[slot])
                    if out_trim.len > 0 { print(out_trim) }
                    if err_trim.len > 0 { print(err_trim) }
                }
                slot_job[slot] = -1
            }
        }
    }

    wall_ms := sys.now_ms() - t_start

    mut ranked: []i64 = []
    for j in 0..total_defined {
        if selected[j] {
            ranked.push(elapsed_ms[j] * 10000 + i64(j))
        }
    }
    array.sort(&mut ranked)
    array.reverse(&mut ranked)
    mut top_summary := ""
    mut limit := 5
    if ranked.len < limit { limit = ranked.len }
    for ti in 0..limit {
        packed := ranked[ti]
        jid := i32(packed % 10000)
        jms := packed / 10000
        if ti > 0 { top_summary += ", " }
        top_summary += jobs.names[jid] + "=" + format_sec(jms)
    }

    passed := total_selected - failed
    if failed == 0 {
        print("PASS " + passed.str() + "/" + total_selected.str() + " suites in " + format_sec(wall_ms) + " (" + pool_cap.str() + " workers; slowest: " + top_summary + ")")
        return 0
    }
    print("FAIL " + failed.str() + "/" + total_selected.str() + " suites failed in " + format_sec(wall_ms))
    1
}
