capability process, filesystem, stdio

import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.parse as parse
import std.process as process
import std.text as text
import sys

struct Jobs {
    names: []string,
    progs: []string,
    arg_start: []i32,
    arg_end: []i32,
    all_args: []string,
    deps: []i32,
    tiers: []i32,
}

fn new_jobs() -> Jobs {
    Jobs {
        names: [], progs: [], arg_start: [], arg_end: [],
        all_args: [], deps: [], tiers: [],
    }
}

fn add_job(j: &mut Jobs, name: string, prog: string, move args: []string, dep: i32, tier: i32) -> i32 {
    id := j.names.len
    j.names.push(name.clone())
    j.progs.push(prog.clone())
    j.arg_start.push(j.all_args.len)
    for a in move args { j.all_args.push(move a) }
    j.arg_end.push(j.all_args.len)
    j.deps.push(dep)
    j.tiers.push(tier)
    id
}

fn add_ddr_suite_args(j: &mut Jobs, compiler: string, root: string, work: string, name: string, source: string, tier: i32, move extra: []string) {
    bin_path := work + "/tool-" + name
    src_path := root + "/tools/" + source + ".ddr"
    mut args: []string = ["run", src_path, "--jobs", "1", "-o", bin_path, "--", compiler.clone()]
    for arg in move extra { args.push(move arg) }
    _ := add_job(&mut j, name, compiler, move args, -1, tier)
}

fn add_ddr_suite(j: &mut Jobs, compiler: string, root: string, work: string, name: string, source: string, tier: i32) {
    add_ddr_suite_args(&mut j, compiler, root, work, name, source, tier, [])
}

fn add_ddr_tool(j: &mut Jobs, compiler: string, root: string, work: string, tool_name: string, tier: i32) {
    add_ddr_suite(&mut j, compiler, root, work, tool_name, tool_name, tier)
}

fn add_unit_test(j: &mut Jobs, compiler: string, root: string, work: string, mod_name: string, unit_jobs: string, tier: i32) {
    out_dir := work + "/unit-" + mod_name
    src_path := root + "/tests/" + mod_name + ".ddr"
    _ := add_job(&mut j, "unit:" + mod_name, compiler,
        ["test", src_path, "--jobs", unit_jobs.clone(), "-o", out_dir], -1, tier)
}

fn format_sec(ms: i64) -> string {
    sec := ms / 1000
    tenths := (ms % 1000) / 100
    sec.str() + "." + tenths.str() + "s"
}

fn matches_filters(name: string, filters: &[]string) -> bool {
    if filters.len == 0 { return true }
    for f in filters {
        if text.contains(name, f) { return true }
    }
    false
}

fn main() -> i32 {
    t_start := sys.now_ms()
    mut compiler_arg := ""
    mut serial_arg := ""
    mut mir_reports_arg := ""
    mut max_tier := 1
    mut fast_only := false
    mut include_release := false
    mut max_workers := process.host_cpus()
    mut filters: []string = []

    argc := sys.arg_count()
    mut ai := 1
    while ai < argc {
        a := sys.arg(ai)
        if a == "--fast" {
            max_tier = 0
            fast_only = true
        } else if a == "--full" {
            max_tier = 1
            fast_only = false
        } else if a == "--exhaustive" {
            max_tier = 2
            fast_only = false
        } else if a == "--release" {
            include_release = true
        } else if a == "--all" {
            max_tier = 3
            include_release = true
            fast_only = false
        } else if a == "--jobs" {
            if ai + 1 >= argc { _ := sys.eprint("--jobs requires a value"); return 2 }
            ai += 1
            parsed := parse.integer(sys.arg(ai))
            if !parsed.ok || parsed.value < 1 || parsed.value > 256 {
                _ := sys.eprint("--jobs must be between 1 and 256")
                return 2
            }
            max_workers = i32(parsed.value)
        } else if a == "--filter" {
            if ai + 1 >= argc { _ := sys.eprint("--filter requires a substring"); return 2 }
            ai += 1
            filters.push(sys.arg(ai))
        } else if a == "--serial-compiler" {
            if ai + 1 >= argc { _ := sys.eprint("--serial-compiler requires a path"); return 2 }
            ai += 1
            serial_arg = sys.arg(ai)
        } else if a == "--mir-reports" {
            if ai + 1 >= argc { _ := sys.eprint("--mir-reports requires a directory"); return 2 }
            ai += 1
            mir_reports_arg = sys.arg(ai)
        } else if text.starts_with(a, "-") {
            _ := sys.eprint("unknown option: " + a)
            return 2
        } else if compiler_arg.len == 0 {
            compiler_arg = a
        } else {
            _ := sys.eprint("unexpected positional argument: " + a)
            return 2
        }
        ai += 1
    }

    if compiler_arg.len == 0 {
        _ := sys.eprint("usage: verify <compiler> [--fast|--full|--exhaustive|--release|--all] [--filter substr] [--jobs N] [--serial-compiler path] [--mir-reports dir]")
        return 2
    }

    comp_rp := fs.realpath(compiler_arg)
    if !comp_rp.ok {
        _ := sys.eprint("compiler not found: " + compiler_arg)
        return 1
    }
    compiler := comp_rp.value

    cwd_rp := fs.cwd()
    if !cwd_rp.ok { _ := sys.eprint("cwd failed"); return 1 }
    mut root := cwd_rp.value
    if !sys.metadata(root + "/selfhost/main.ddr").is_file {
        parent_rp := fs.realpath(root + "/..")
        if parent_rp.ok && sys.metadata(parent_rp.value + "/selfhost/main.ddr").is_file {
            root = parent_rp.value
        }
    }

    tmp_res := fs.temp_dir("dunder-verify-")
    if !tmp_res.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    work := tmp_res.value
    defer { _ := fs.remove_all(work) }

    mut mir_reports := mir_reports_arg
    if mir_reports.len == 0 {
        mir_reports = work + "/mir-reports"
    }
    if !fs.mkdir_all(mir_reports).ok {
        _ := sys.eprint("failed creating mir_reports dir")
        return 1
    }

    mut serial_compiler := ""
    if serial_arg.len > 0 {
        srp := fs.realpath(serial_arg)
        if srp.ok { serial_compiler = srp.value }
    } else {
        default_serial := root + "/build/selfhost/arm64-macos/dunder-serial"
        if sys.metadata(default_serial).is_file { serial_compiler = default_serial }
    }

    mut jobs := new_jobs()
    unit_jobs := "__UNIT_JOBS__"

    // Tier 0 (--fast) and Tier 1 (default/--full) ordered longest-first (LPT).
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-optimizer", "test_optimizer", 1, ["--verify-selection"])
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-const-div", "test_const_div", 1, ["--verify-selection"])
    _ := add_job(&mut jobs, "test-cli", "python3", [root + "/tools/test-cli.py", compiler.clone()], -1, 1)
    _ := add_job(&mut jobs, "test-git-dependencies", "python3", [root + "/tools/test-git-dependencies.py", compiler.clone()], -1, 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-stdlib-ownership", "test_stdlib_ownership", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-assert-diagnostics", "test_assert_diagnostics", 0)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir:source", "test_mir", 1, ["--only", "source"])
    add_ddr_suite(&mut jobs, compiler, root, work, "test-runtime-contracts", "test_runtime_contracts", 1)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-resource-ownership", "test_resource_ownership", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-local-borrows", "test_local_borrows", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-task-source", "test_task_source", 1)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-utf8-next", "test_utf8_next", 1)
    _ := add_job(&mut jobs, "test-http-client", "python3", [root + "/tools/test-http-client.py", compiler.clone()], -1, 0)
    mut parallel_args: []string = ["--output", work + "/parallel-compiler-qa"]
    if serial_compiler.len > 0 {
        parallel_args.push("--baseline")
        parallel_args.push(serial_compiler.clone())
    }
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-parallel-compiler", "test_parallel_compiler", 1, move parallel_args)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-array-moves", "test_array_moves", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-interpolation", "test_interpolation", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-aggregate-arrays", "test_aggregate_arrays", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-terminal-flow", "test_terminal_flow", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-generics", "test_generics", 0)
    add_unit_test(&mut jobs, compiler, root, work, "suite", unit_jobs, 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-memory-bytes", "test_memory_bytes", 0)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-partial-moves", "test_partial_moves", 0, ["--inline-replace"])
    add_unit_test(&mut jobs, compiler, root, work, "compile_frontend", unit_jobs, 0)
    if process.host_target() == "arm64-macos" {
        add_ddr_suite_args(&mut jobs, compiler, root, work, "test-task-scope", "test_task_darwin", 1, ["--scope"])
        add_ddr_suite(&mut jobs, compiler, root, work, "test-task-native", "test_task_darwin", 1)
    } else if max_tier >= 1 {
        print("BLOCKED native task Mach-O dylib probes: require ARM64/macOS")
    }
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-record-take-source", "test_record_take", 1, ["--source"])
    add_ddr_suite(&mut jobs, compiler, root, work, "test-syntax-bridge", "test_syntax_bridge", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-traits", "test_traits", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-phase1-ergonomics", "test_phase1_ergonomics", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-phase2-stdlib-ffi", "test_phase2_stdlib_ffi", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-phase3-frontend-tools", "test_phase3_frontend_tools", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-runtime-profile", "test_runtime_profile", 1)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-returned-borrows", "test_returned_borrows", 0)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_conditionals", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-io", "test_io", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-alloc", "test_alloc", 0)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_diagnostics", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-compiler-session", "test_compiler_session", 1)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-stdlib-units", "test_stdlib_units", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-value-blocks", "test_value_blocks", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-examples", "test_examples", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-ssa-source", "test_ssa_source", 1)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-resource-moves", "test_resource_moves", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-process-environment", "test_process_environment", 0)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_native", 1)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_ffi", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-collections", "test_collections", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-results", "test_results", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-http", "test_http", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-upgrade", "test_upgrade", 1)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-sqlite", "test_sqlite", 0)
    _ := add_job(&mut jobs, "profile-dogfood", compiler,
        ["run", root + "/tools/profile_dogfood.ddr", "--jobs", "1", "-o", work + "/tool-profile-dogfood",
         "--", "check", compiler.clone()], -1, 1)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_check", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-crypto", "test_crypto", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-process-replace", "test_process_replace", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-math", "test_math", 0)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_files", 0)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_resolver", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-const", "test_const", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-closures", "test_closures", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-iterators", "test_iterators", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-pod-values", "test_pod_values", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-whole-inline", "test_whole_inline", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-process-signals", "test_process_signals", 0)
    _ := add_job(&mut jobs, "test-toml", "python3", [root + "/tools/test-toml.py", compiler.clone()], -1, 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-mir-scalar", "test_mir_scalar", 1)
    add_unit_test(&mut jobs, compiler, root, work, "net", "1", 0)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-performance-compiler-matrix", "test_performance_compiler_matrix", 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_task", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_pipeline", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa_sparse", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_expr_stack", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_object", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa_joint", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_branch", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_dataflow", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_frame_exits", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_stack_origin", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_call_inputs", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_lower", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_retained", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_value_prop", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_ssa_cells", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_preserve", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_memory", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "task_native", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_verify", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "mir_liveness_inputs", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "task_scope_emit", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "mir_scalar", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "task_data", unit_jobs, 1)
    add_unit_test(&mut jobs, compiler, root, work, "budget", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "impl_blocks", unit_jobs, 0)
    add_unit_test(&mut jobs, compiler, root, work, "task_effects", unit_jobs, 1)

    // Tier 2 (--exhaustive): deep synthetic MIR oracle and emitter probes.
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-ssa", "test_mir_ssa", 2,
        ["--report", mir_reports + "/mir-ssa-integrated.json"])
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir:oracle", "test_mir", 2, ["--only", "oracle"])
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-expr", "test_mir_ssa", 2,
        ["--suite", "expression", "--output", mir_reports + "/expression", "--report", mir_reports + "/expression.json"])
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-regions", "test_mir_ssa", 2,
        ["--suite", "regions", "--output", mir_reports + "/regions", "--report", mir_reports + "/regions.json"])
    add_ddr_suite(&mut jobs, compiler, root, work, "test-register-comparisons", "test_register_comparisons", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-opt-emitter", "test_opt_emitter", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-inline-producer", "test_inline_producer", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-array-addresses", "test_array_addresses", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_range_emitter", 2)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-pipeline", "test_mir_pipeline", 2,
        ["--report", mir_reports + "/mir-pipeline-integrated.json"])
    add_ddr_suite(&mut jobs, compiler, root, work, "test-mir-values", "test_mir_values", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_array_capacity", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_frame_free", 2)
    if process.host_target() == "arm64-macos" {
        add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-frame-exits", "test_mir_frame_exits", 2,
            ["--output", mir_reports + "/mir-frame-exits-integrated"])
    } else if max_tier >= 2 {
        print("BLOCKED MIR frame-exit native observer: requires ARM64/macOS; portable unit coverage remains enabled")
    }
    add_ddr_tool(&mut jobs, compiler, root, work, "test_inline_catalog", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-range-analysis", "test_range_analysis", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_promotion", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_expression_emitter", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-record-take", "test_record_take", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_memory", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_objects", 2)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-object-data", "test_mir_object_data", 2,
        ["--output", mir_reports + "/object-data"])
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_link", 2)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-call-flags", "test_mir_call_flags", 2,
        ["--output", mir_reports + "/mir-call-flags-integrated"])
    add_ddr_suite(&mut jobs, compiler, root, work, "test-inline-streaming", "test_inline_streaming", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-mir-fragments", "test_mir_fragments", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-ownership-leases", "test_ownership_leases", 2)
    add_ddr_suite(&mut jobs, compiler, root, work, "test-fragment-dependencies", "test_fragment_dependencies", 2)
    add_ddr_tool(&mut jobs, compiler, root, work, "test_mir_entry", 2)
    add_ddr_suite_args(&mut jobs, compiler, root, work, "test-mir-stack-origin", "test_mir_stack_origin", 2,
        ["--output", mir_reports + "/stack-origin"])

    // Tier 3 (--release / --all): full release bootstrap/packaging matrix.
    _ := add_job(&mut jobs, "test-release", compiler,
        ["run", root + "/tools/test_release.ddr", "--jobs", "1", "-o", work + "/tool-test-release"], -1, 3)

    total_defined := jobs.names.len
    mut selected: []bool = []
    for j in 0..total_defined {
        t := jobs.tiers[j]
        mut keep := true
        if filters.len > 0 {
            if fast_only && t > 0 { keep = false }
            if !matches_filters(jobs.names[j], &filters) { keep = false }
        } else {
            if t == 3 {
                if !include_release && max_tier < 3 { keep = false }
            } else if t > max_tier {
                keep = false
            }
        }
        selected.push(keep)
    }
    for j in 0..total_defined {
        if selected[j] && jobs.deps[j] >= 0 {
            selected[jobs.deps[j]] = true
        }
    }

    mut total_selected := 0
    mut state: []i32 = []
    mut elapsed_ms: []i64 = []
    for j in 0..total_defined {
        elapsed_ms.push(0)
        if selected[j] { state.push(1); total_selected += 1 }
        else { state.push(0) }
    }

    if total_selected == 0 {
        _ := sys.eprint("no suites matched selection")
        return 2
    }

    mut pool_cap := max_workers
    if pool_cap > total_selected { pool_cap = total_selected }
    mut child_jobs := max_workers / pool_cap
    if child_jobs < 1 { child_jobs = 1 }
    if process.host_target() != "arm64-macos" { child_jobs = 1 }
    for k in 0..jobs.all_args.len {
        if jobs.all_args[k] == "__UNIT_JOBS__" { jobs.all_args[k] = child_jobs.str() }
    }
    mut pool := process.ChildSet::new(pool_cap)
    defer { pool.kill_all() }

    mut slot_job: []i32 = []
    mut slot_start: []i64 = []
    mut slot_out: []string = []
    mut slot_err: []string = []
    for _ in 0..pool_cap {
        slot_job.push(-1)
        slot_start.push(0)
        slot_out.push("")
        slot_err.push("")
    }

    mut raw_out: []u8 = []
    mut raw_err: []u8 = []
    mut completed := 0
    mut failed := 0
    timeout_limit_ms: i64 = 240000

    while completed < total_selected {
        for j in 0..total_defined {
            if state[j] == 1 && jobs.deps[j] >= 0 && state[jobs.deps[j]] == 4 {
                state[j] = 4
                completed += 1
                failed += 1
                print("[" + completed.str() + "/" + total_selected.str() + "] FAIL " + jobs.names[j] + " (prerequisite failed)")
            }
        }
        if completed >= total_selected { break }

        for j in 0..total_defined {
            if pool.len() >= pool_cap { break }
            if state[j] != 1 { continue }
            if jobs.deps[j] >= 0 && state[jobs.deps[j]] != 3 { continue }

            mut cmd_args: []string = []
            for k in jobs.arg_start[j]..jobs.arg_end[j] {
                cmd_args.push(jobs.all_args[k].clone())
            }
            mut cmd := process.Command::new(jobs.progs[j].clone(), move cmd_args)
            cmd.set_cwd(root.clone())
            cmd.set_env("DUNDER_CHILD_JOBS", child_jobs.str())
            sp := cmd.spawn()
            if sp.is_err() {
                err_code := sp.unwrap_err().code()
                if (err_code == 35 || err_code == 12 || err_code == 24 || err_code == 23) && pool.len() > 0 {
                    break
                }
                state[j] = 4
                completed += 1
                failed += 1
                print("[" + completed.str() + "/" + total_selected.str() + "] FAIL " + jobs.names[j] + " (spawn error " + err_code.str() + ")")
                continue
            }
            mut child := sp.unwrap()
            slot := pool.insert(&mut child)
            assert(slot >= 0)
            state[j] = 2
            slot_job[slot] = j
            slot_start[slot] = sys.now_ms()
            slot_out[slot] = ""
            slot_err[slot] = ""
        }

        if pool.len() == 0 { continue }

        _ := pool.poll_io(50)
        now := sys.now_ms()

        for slot in 0..pool_cap {
            if !pool.is_active(slot) { continue }
            j := slot_job[slot]
            raw_out.clear()
            raw_err.clear()
            mut w := pool.try_wait(slot, &mut raw_out, &mut raw_err)
            if !w.exited && now - slot_start[slot] >= timeout_limit_ms {
                w = pool.kill_reap(slot, &mut raw_out, &mut raw_err)
            }
            if raw_out.len > 0 {
                dec_o := bytes.decode(&raw_out)
                if dec_o.ok { slot_out[slot] += dec_o.value }
            }
            if raw_err.len > 0 {
                dec_e := bytes.decode(&raw_err)
                if dec_e.ok { slot_err[slot] += dec_e.value }
            }
            if w.exited {
                dur := sys.now_ms() - slot_start[slot]
                elapsed_ms[j] = dur
                completed += 1
                if w.ok && !w.timed_out && w.signal == 0 && w.code == 0 {
                    state[j] = 3
                    print("[" + completed.str() + "/" + total_selected.str() + "] PASS " + jobs.names[j] + " (" + dur.str() + "ms)")
                } else {
                    state[j] = 4
                    failed += 1
                    print("[" + completed.str() + "/" + total_selected.str() + "] FAIL " + jobs.names[j] + " (exit " + w.code.str() + ", " + dur.str() + "ms)")
                    out_trim := text.trim(slot_out[slot])
                    err_trim := text.trim(slot_err[slot])
                    if out_trim.len > 0 { print(out_trim) }
                    if err_trim.len > 0 { print(err_trim) }
                }
                slot_job[slot] = -1
            }
        }
    }

    wall_ms := sys.now_ms() - t_start

    mut ranked: []i64 = []
    for j in 0..total_defined {
        if selected[j] {
            ranked.push(elapsed_ms[j] * 10000 + i64(j))
        }
    }
    array.sort<i64>(&mut ranked)
    array.reverse<i64>(&mut ranked)
    mut top_summary := ""
    mut limit := 5
    if ranked.len < limit { limit = ranked.len }
    for ti in 0..limit {
        packed := ranked[ti]
        jid := i32(packed % 10000)
        jms := packed / 10000
        if ti > 0 { top_summary += ", " }
        top_summary += jobs.names[jid] + "=" + format_sec(jms)
    }

    passed := total_selected - failed
    if failed == 0 {
        print("PASS " + passed.str() + "/" + total_selected.str() + " suites in " + format_sec(wall_ms) + " (" + pool_cap.str() + " workers; slowest: " + top_summary + ")")
        return 0
    }
    print("FAIL " + failed.str() + "/" + total_selected.str() + " suites failed in " + format_sec(wall_ms))
    1
}
