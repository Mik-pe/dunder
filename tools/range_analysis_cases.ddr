import .range_analysis_oracle as oracle
import std.array as array

pub struct Case { name: string, body: string }

pub fn bounds() -> []Case {
    [
        Case { name: "sum", body: "{mut total:i64=0;for i in 0..a.len{total=total+a[i]};return total}" },
        Case { name: "fill", body: "{for i in 0..a.len{a[i]=x};return x}" },
        Case { name: "sort", body: "{for i in 1..a.len{value:=a[i];mut j:=i;while j>0&&a[j-1]>value{a[j]=a[j-1];j=j-1};a[j]=value};return x}" },
        Case { name: "reverse", body: "{mut l:=0;mut r:=a.len-1;while l<r{value:=a[l];a[l]=a[r];a[r]=value;l=l+1;r=r-1};return x}" },
        Case { name: "while_mutation", body: "{mut i:=0;while i<a.len{a[i]=a[i]+1;i=i+1};return x}" },
        Case { name: "snapshot_grows", body: "{mut high:=a.len;for i in 0..high{high=high+1;a[i]=x};return x}" },
        Case { name: "snapshot_shrinks", body: "{mut high:=a.len;for i in 0..high{high=0;a[i]=x};return x}" },
        Case { name: "snapshot_low_shadow", body: "{mut i:=n;for i in i..a.len{if i<0{break};a[i]=x};return x}" },
        Case { name: "nested", body: "{for i in 0..a.len{for j in 0..c.len{if j==1{continue};if j==3{break};c[j]=a[i]}};return x}" },
        Case { name: "continue_break", body: "{mut i:=0;while i<a.len{if i==1{i=i+1;continue};a[i]=x;if i==3{break};i=i+1};return x}" },
        Case { name: "early_return", body: "{for i in 0..a.len{if i==n{return a[i]};a[i]=x};return x}" },
        Case { name: "if_else", body: "{mut i:=n;if flag{if i>=0&&i<a.len{a[i]=x}}else{if i>=0&&i<c.len{c[i]=x}};return x}" },
        Case { name: "negation_guard", body: "{if !(n<0||n>=a.len){a[n]=x};return x}" },
        Case { name: "or_join", body: "{if (n>=0&&n<a.len)||(m>=0&&m<a.len){a[n]=x};return x}" },
        Case { name: "cross_root", body: "{for i in 0..a.len{c[i]=a[i]+b[i]};return x}" },
        Case { name: "two_root_guard", body: "{if n>=0&&n<a.len&&n<b.len{a[n]=b[n]};return x}" },
        Case { name: "wrong_guard_root", body: "{if n>=0&&n<b.len{a[n]=x};return x}" },
        Case { name: "offsets", body: "{for i in 1..a.len{a[i]=a[i-1]};return x}" },
        Case { name: "offset_upper", body: "{for i in 0..a.len{a[i]=a[i+1]};return x}" },
        Case { name: "negative", body: "{for i in -1..a.len{a[i]=x};return x}" },
        Case { name: "mutated_induction", body: "{mut i:=0;while i<a.len{i=i-1;return a[i]};return x}" },
        Case { name: "mutated_before_read", body: "{mut i:=n;if i>=0&&i<a.len{i=m;a[i]=x};return x}" },
        Case { name: "killed_relation", body: "{mut i:=0;mut guard:=0;while i<a.len&&guard<4{guard=guard+1;if flag{i=m};if i<0||i>=a.len{break};a[i]=x;i=i+1};return x}" },
        Case { name: "backedge", body: "{mut i:=0;while i<a.len{a[i]=x;i=i+2};return x}" },
        Case { name: "empty_high_traps", body: "{for i in 1..n/0{a[i]=x};return x}" },
        Case { name: "low_trap_first", body: "{for i in n/0..m+1{a[i]=x};return x}" },
        Case { name: "high_overflow", body: "{for i in n..m+1{if i<0||i>=a.len{break};a[i]=x};return x}" },
        Case { name: "checked_index", body: "{if n>=0&&n<a.len{a[n+2147483647]=x};return x}" },
        Case { name: "store_order", body: "{a[n]=x/0;return x}" },
        Case { name: "index_order", body: "{a[n+1]=x/0;return x}" },
        Case { name: "load_order", body: "{a[n]=b[m];return x}" },
        Case { name: "short_and", body: "{if n>=0&&n<a.len&&a[n]>0{a[n]=x};return x}" },
        Case { name: "short_or", body: "{if n<0||n>=a.len||a[n]>0{return x};a[n]=x;return x}" },
        Case { name: "wide_overflow", body: "{if n>=0&&n<a.len{a[n]=x+1};return x}" },
        Case { name: "wide_negate", body: "{if n>=0&&n<a.len{a[n]=-x};return x}" },
        Case { name: "wide_min_div", body: "{if n>=0&&n<a.len{a[n]=x/(-1)};return x}" },
        Case { name: "wide_min_rem", body: "{if n>=0&&n<a.len{a[n]=x%(-1)};return x}" },
        Case { name: "nested_shadow", body: "{for i in 0..a.len{{i:=n;if i>=0&&i<c.len{c[i]=x}};a[i]=x};return x}" },
        Case { name: "signed_latch_high", body: "{for i in 2147483646..2147483647{if i<a.len{a[i]=x}};return x}" },
        Case { name: "signed_latch_low", body: "{for i in -2147483648..-2147483647{if i>=0&&i<a.len{a[i]=x}};return x}" },
        Case { name: "generated_a_-2", body: "{if n>=0&&n<a.len{if n+(-2)>=0&&n+(-2)<a.len{a[n]=a[n+(-2)]}};return x}" },
        Case { name: "generated_b_-2", body: "{if n>=0&&n<a.len{if n+(-2)>=0&&n+(-2)<b.len{a[n]=b[n+(-2)]}};return x}" },
        Case { name: "generated_c_-2", body: "{if n>=0&&n<a.len{if n+(-2)>=0&&n+(-2)<c.len{a[n]=c[n+(-2)]}};return x}" },
        Case { name: "generated_a_-1", body: "{if n>=0&&n<a.len{if n+(-1)>=0&&n+(-1)<a.len{a[n]=a[n+(-1)]}};return x}" },
        Case { name: "generated_b_-1", body: "{if n>=0&&n<a.len{if n+(-1)>=0&&n+(-1)<b.len{a[n]=b[n+(-1)]}};return x}" },
        Case { name: "generated_c_-1", body: "{if n>=0&&n<a.len{if n+(-1)>=0&&n+(-1)<c.len{a[n]=c[n+(-1)]}};return x}" },
        Case { name: "generated_a_0", body: "{if n>=0&&n<a.len{if n+(0)>=0&&n+(0)<a.len{a[n]=a[n+(0)]}};return x}" },
        Case { name: "generated_b_0", body: "{if n>=0&&n<a.len{if n+(0)>=0&&n+(0)<b.len{a[n]=b[n+(0)]}};return x}" },
        Case { name: "generated_c_0", body: "{if n>=0&&n<a.len{if n+(0)>=0&&n+(0)<c.len{a[n]=c[n+(0)]}};return x}" },
        Case { name: "generated_a_1", body: "{if n>=0&&n<a.len{if n+(1)>=0&&n+(1)<a.len{a[n]=a[n+(1)]}};return x}" },
        Case { name: "generated_b_1", body: "{if n>=0&&n<a.len{if n+(1)>=0&&n+(1)<b.len{a[n]=b[n+(1)]}};return x}" },
        Case { name: "generated_c_1", body: "{if n>=0&&n<a.len{if n+(1)>=0&&n+(1)<c.len{a[n]=c[n+(1)]}};return x}" },
        Case { name: "generated_a_2", body: "{if n>=0&&n<a.len{if n+(2)>=0&&n+(2)<a.len{a[n]=a[n+(2)]}};return x}" },
        Case { name: "generated_b_2", body: "{if n>=0&&n<a.len{if n+(2)>=0&&n+(2)<b.len{a[n]=b[n+(2)]}};return x}" },
        Case { name: "generated_c_2", body: "{if n>=0&&n<a.len{if n+(2)>=0&&n+(2)<c.len{a[n]=c[n+(2)]}};return x}" },
    ]
}

pub fn arithmetic() -> []Case {
    [
        Case { name: "i32_add", body: "{value:=n+m;return x}" },
        Case { name: "i32_sub", body: "{value:=n-m;return x}" },
        Case { name: "i32_mul", body: "{value:=n*m;return x}" },
        Case { name: "i32_neg", body: "{value:=-n;return x}" },
        Case { name: "i32_guarded_add", body: "{if n>=-10&&n<=10&&m>=-10&&m<=10{value:=n+m};return x}" },
        Case { name: "i32_guarded_sub", body: "{if n>=-10&&n<=10&&m>=-10&&m<=10{value:=n-m};return x}" },
        Case { name: "i32_guarded_mul", body: "{if n>=-46340&&n<=46340&&m>=-46340&&m<=46340{value:=n*m};return x}" },
        Case { name: "i32_unsafe_mul_guard", body: "{if n>=-46341&&n<=46341&&m>=-46341&&m<=46341{value:=n*m};return x}" },
        Case { name: "i32_guarded_neg", body: "{if n>-2147483648{value:=-n};return x}" },
        Case { name: "i32_child_add_then_zero", body: "{value:=(n+1)*0;return x}" },
        Case { name: "i32_child_sub_then_restore", body: "{value:=(n-1)+1;return x}" },
        Case { name: "i32_double_neg", body: "{value:=-(-n);return x}" },
        Case { name: "i32_const_child_mul_zero", body: "{value:=(2147483647*2147483647)*0;return x}" },
        Case { name: "i32_const_zero_mul_child", body: "{value:=0*(2147483647*2147483647);return x}" },
        Case { name: "i32_const_child_mul_neg", body: "{value:=-(2147483647*2147483647);return x}" },
        Case { name: "i32_const_child_mul_add", body: "{value:=(2147483647*2147483647)+1;return x}" },
        Case { name: "i32_const_child_mul_sub", body: "{value:=1-(2147483647*2147483647);return x}" },
        Case { name: "i32_const_min_mul_zero", body: "{value:=(-2147483648*(-1))*0;return x}" },
        Case { name: "i32_const_min_neg_zero", body: "{value:=(-(-2147483648))*0;return x}" },
        Case { name: "i32_const_child_add_zero", body: "{value:=(2147483647+1)*0;return x}" },
        Case { name: "i32_const_child_sub_zero", body: "{value:=(-2147483648-1)*0;return x}" },
        Case { name: "i32_const_child_before_divisor", body: "{value:=(2147483647*2147483647)/(n+1);return x}" },
        Case { name: "i32_bounds_after_child", body: "{if n>=0&&n<a.len{value:=(n+m)*0;a[value]=x};return x}" },
        Case { name: "i32_later_backedge", body: "{mut value:=n;for i in 0..3{value=value+1};return x}" },
        Case { name: "i32_guarded_backedge", body: "{if n<=2147483645{mut value:=n;for i in 0..3{value=value+1}};return x}" },
        Case { name: "i32_later_multiply", body: "{mut value:=n;mut i:=0;while i<3{value=value*2;i=i+1};return x}" },
        Case { name: "i32_short_or", body: "{if flag||n+1>0{if n>=0&&n<a.len{a[n]=x}};return x}" },
        Case { name: "i32_short_and", body: "{if !flag&&n*m>=0{if n>=0&&n<a.len{a[n]=x}};return x}" },
        Case { name: "i32_unreachable", body: "{if false{value:=n+1};return x}" },
        Case { name: "i32_budget_prefix", body: "{if n>=0&&n<100{mut value:=n;for i in 0..8{value=value+1};if value<a.len{a[value]=x}};return x}" },
        Case { name: "i64_checked_add", body: "{value:=x+1;return value}" },
        Case { name: "i64_checked_sub", body: "{value:=x-1;return value}" },
        Case { name: "i64_checked_mul", body: "{value:=x*3;return value}" },
        Case { name: "i64_checked_neg", body: "{value:=-x;return value}" },
    ]
}

fn values(length: i32, step: i32, offset: i32, modulus: i32, center: i32) -> []i64 {
    mut result: []i64 = []
    for i in 0..length { result.push(i64((i * step + offset) % modulus - center)) }
    result
}

fn wide_values() -> []i64 { [-9223372036854775808, -9223372036854775807, -1, 0, 1, 9223372036854775807] }

pub fn bounds_inputs() -> []oracle.Input {
    xs := wide_values()
    small: []i64 = [-2, -1, 0, 1, 2, 3, 4]
    mut result: []oracle.Input = []
    for la in 0..4 {
        a := values(la, 11, la * 3, 17, 8)
        for lb in 0..4 {
            b := values(lb, 7, lb, 13, 6)
            for lc in 0..4 {
                c := values(lc, 3, lc, 11, 5)
                for n in small {
                    for m in small {
                        for flag in [false, true] {
                            flag_value: i64 = if flag { 1 } else { 0 }
                            offset := (i64(la + lb + lc) + n + m + flag_value) % i64(xs.len)
                            i := i32((offset + i64(xs.len)) % i64(xs.len))
                            result.push(oracle.Input { arrays: [a.clone(), b.clone(), c.clone()],
                                n: n, m: m, x: xs[i], flag: flag, aliased: false })
                        }
                    }
                }
            }
        }
    }
    edges: []i64 = [-2147483648, -2147483647, 2147483646, 2147483647]
    for n in edges {
        for m in edges {
            for x in edges {
                result.push(oracle.Input { arrays: [[3, -1, 5], [], [9]], n: n, m: m, x: x, flag: false, aliased: false })
            }
        }
    }
    for length in 0..4 {
        a := values(length, 1, 0, 4, 0)
        result.push(oracle.Input { arrays: [a, [], []], n: i64(length - 1), m: 0, x: 7, flag: true, aliased: true })
    }
    result
}

pub fn arithmetic_inputs() -> []oracle.Input {
    limits: []i64 = [-2147483648, -2147483647, -2147483646, -1073741824,
        -65536, -46341, -46340, -2, -1, 0, 1, 2, 46340, 46341, 65536, 1073741823, 2147483645, 2147483646, 2147483647]
    arrays: [][][]i64 = [[[], [], []], [[3, -1, 7], [9], [5, 8]], [[0, -3], [4, 6, 9], []]]
    xs := wide_values()
    mut result: []oracle.Input = []
    for n in limits {
        for m in limits {
            for group in arrays {
                for flag in [false, true] {
                    value := xs[result.len % xs.len]
                    result.push(oracle.Input { arrays: group.clone(), n: n, m: m, x: value, flag: flag, aliased: false })
                }
            }
        }
    }
    result
}

pub struct Expected { present: bool, state: oracle.Outcome, array: []i64 }

fn expected(state: oracle.Outcome, move data: []i64) -> Expected {
    Expected { present: true, state: state, array: data }
}

fn scalar_result(input: &oracle.Input, value: i64) -> Expected {
    expected(oracle.returned(value), input.arrays[0].clone())
}

fn trap_result(input: &oracle.Input, status: i64) -> Expected {
    expected(oracle.trapped(status), input.arrays[0].clone())
}

pub fn reference(name: string, input: &oracle.Input) -> Expected {
    n := input.n
    m := input.m
    x := input.x
    a := &input.arrays[0]
    valid := n >= 0 && n < i64(a.len)
    if name == "sum" {
        mut value: i64 = 0
        for item in a { value += item }
        return scalar_result(&input, value)
    }
    if name == "fill" || name == "sort" || name == "reverse" {
        mut result := a.clone()
        if name == "fill" {
            for i in 0..result.len { result[i] = x }
        } else if name == "sort" { array.sort<i64>(&mut result) }
        else {
            for i in 0..result.len { result[i] = a[a.len - 1 - i] }
        }
        return expected(oracle.returned(x), move result)
    }
    if name == "store_order" || name == "index_order" {
        if name == "index_order" && n == 2147483647 { return trap_result(&input, 101) }
        at := if name == "index_order" { n + 1 } else { n }
        return trap_result(&input, if at >= 0 && at < i64(a.len) { 102 } else { 103 })
    }
    if name == "empty_high_traps" || name == "low_trap_first" { return trap_result(&input, 102) }
    if name == "checked_index" {
        if !valid { return scalar_result(&input, x) }
        return trap_result(&input, if n == 0 { 103 } else { 101 })
    }
    if name == "short_and" || name == "short_or" {
        mut result := a.clone()
        if valid && ((a[i32(n)] > 0) == (name == "short_and")) { result[i32(n)] = x }
        return expected(oracle.returned(x), move result)
    }
    minimum: i64 = -9223372036854775808
    maximum: i64 = 9223372036854775807
    if name == "wide_overflow" || name == "wide_negate" || name == "wide_min_div" || name == "wide_min_rem" {
        if !valid { return scalar_result(&input, x) }
        if (name == "wide_overflow" && x == maximum) || (name != "wide_overflow" && x == minimum) {
            return trap_result(&input, 101)
        }
        mut result := a.clone()
        result[i32(n)] = if name == "wide_overflow" { x + 1 } else if name == "wide_min_rem" { 0 } else { -x }
        return expected(oracle.returned(x), move result)
    }
    if name == "i32_add" || name == "i32_sub" || name == "i32_mul" || name == "i32_neg" {
        value := if name == "i32_add" { n + m } else if name == "i32_sub" { n - m } else if name == "i32_mul" { n * m } else { -n }
        if value < -2147483648 || value > 2147483647 { return trap_result(&input, 101) }
        return scalar_result(&input, x)
    }
    if name == "i64_checked_add" {
        if x == maximum { return trap_result(&input, 101) }
        return scalar_result(&input, x + 1)
    }
    if name == "i64_checked_sub" {
        if x == minimum { return trap_result(&input, 101) }
        return scalar_result(&input, x - 1)
    }
    if name == "i64_checked_mul" {
        if x < minimum / 3 || x > maximum / 3 { return trap_result(&input, 101) }
        return scalar_result(&input, x * 3)
    }
    if name == "i64_checked_neg" {
        if x == minimum { return trap_result(&input, 101) }
        return scalar_result(&input, -x)
    }
    if name.len >= 10 && name[0..10] == "i32_const_" { return trap_result(&input, 101) }
    Expected { present: false, state: oracle.returned(0), array: [] }
}
