capability process, filesystem

import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.parse as parse
import std.process as process
import std.text as text
import sys

fn main() -> i32 {
    var compiler_arg := ""
    var report_arg := ""
    var rounds := 30
    count := sys.arg_count()
    var i := 1
    while i < count {
        a := sys.arg(i)
        if a == "--rounds" {
            if i + 1 >= count { _ := sys.eprint("missing value after --rounds"); return 2 }
            i += 1
            parsed := parse.integer(sys.arg(i))
            if !parsed.ok || parsed.value < 1 { _ := sys.eprint("rounds must be positive"); return 2 }
            rounds = i32(parsed.value)
        } else if compiler_arg.len == 0 {
            compiler_arg = a
        } else if report_arg.len == 0 {
            report_arg = a
        } else {
            _ := sys.eprint("unexpected argument: " + a)
            return 2
        }
        i += 1
    }
    if compiler_arg.len == 0 || report_arg.len == 0 {
        _ := sys.eprint("usage: agent_bench <compiler> <report.csv> [--rounds N]")
        return 2
    }
    comp := fs.realpath(compiler_arg)
    if !comp.ok { _ := sys.eprint("compiler not found: " + compiler_arg); return 1 }
    compiler := comp.value

    tmp := fs.temp_dir("dunder-agent-bench-")
    if !tmp.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    project := tmp.value
    defer { _ := fs.remove_all(project) }

    var csv_out: []u8 = []
    bytes.append_utf8(&mut csv_out, "round,case,elapsed_ms\n")

    var samp_check: []i64 = []
    var samp_one: []i64 = []
    var samp_none: []i64 = []

    case_names: []string = ["check-agent", "one-affected", "no-change"]

    for index in 0..(rounds + 1) {
        var src: []u8 = []
        bytes.append_utf8(&mut src, "fn main(){}\n")
        for n in 0..20 {
            var val := 1 + n
            if n == 0 { val = 1 + index }
            bytes.append_utf8(&mut src, "fn value" + n.str() + "()->i32{" + val.str() + "}\n")
        }
        for n in 0..20 {
            bytes.append_utf8(&mut src, "@test fn group" + n.str() + "(){assert(value" + n.str() + "()>0)}\n")
        }
        if !sys.write_u8(project + "/main.ddr", &src).ok {
            _ := sys.eprint("failed writing generated main.ddr")
            return 1
        }

        for ci in 0..3 {
            var args: []string = ["check", "main.ddr", "--agent"]
            if ci > 0 { args = ["test", "main.ddr", "--affected"] }
            t0 := sys.now_ms()
            res := process.run_in(compiler, args, project)
            elapsed := sys.now_ms() - t0
            if !process.succeeded(&res) {
                _ := sys.eprint(case_names[ci] + " failed: " + process.stderr_text(&res))
                return 1
            }
            if index == 0 { continue }
            out_txt := process.stdout_text(&res)
            if ci == 1 && (text.find(out_txt, "1 passed, 0 failed") < 0 || text.find(out_txt, "19 unaffected") < 0) {
                _ := sys.eprint("unexpected one-affected output: " + out_txt)
                return 1
            }
            if ci == 2 && text.find(out_txt, "20 unaffected") < 0 {
                _ := sys.eprint("unexpected no-change output: " + out_txt)
                return 1
            }
            bytes.append_utf8(&mut csv_out, index.str() + "," + case_names[ci] + "," + elapsed.str() + "\n")
            if ci == 0 { samp_check.push(elapsed) }
            else if ci == 1 { samp_one.push(elapsed) }
            else { samp_none.push(elapsed) }
        }
    }

    if !sys.write_u8(report_arg, &csv_out).ok {
        _ := sys.eprint("failed writing report CSV: " + report_arg)
        return 1
    }

    array.sort(&mut samp_check)
    array.sort(&mut samp_one)
    array.sort(&mut samp_none)
    p95_idx := (rounds * 95 + 99) / 100 - 1
    print("check-agent median=" + samp_check[rounds / 2].str() + "ms p95=" + samp_check[p95_idx].str() + "ms")
    print("one-affected median=" + samp_one[rounds / 2].str() + "ms p95=" + samp_one[p95_idx].str() + "ms")
    print("no-change median=" + samp_none[rounds / 2].str() + "ms p95=" + samp_none[p95_idx].str() + "ms")
    0
}
