import .harness as harness
import std.json as json
import std.parse as parse

pub struct Node {
    kind: i32, kind_type: i32, left: i32, right: i32, third: i32, next: i32,
    value: i64, local: i32, proof: i64, effect: i64, start: i64, pending: i64, pending_mask: i64,
}

pub struct Local { kind_type: i32, param: i32, mutable: i64, at: i64 }

pub struct Model {
    root: i32, ret: i32, params: i32, nodes: []Node, locals: []Local,
    status: i64, units: i64, reads: i64, stores: i64, arithmetic: i64, error: string,
}

pub fn model() -> Model {
    Model {
        root: -1, ret: 0, params: 0, nodes: [], locals: [],
        status: 0, units: 0, reads: 0, stores: 0, arithmetic: 0, error: "",
    }
}

pub fn node(kind: i32, kind_type: i32, value: i64, left: i32, right: i32, proof: i64) -> Node {
    Node {
        kind: kind, kind_type: kind_type, left: left, right: right, third: -1, next: -1,
        value: value, local: 0, proof: proof, effect: 0, start: 0, pending: 0, pending_mask: 0,
    }
}

fn failure(message: string) -> Model {
    mut result := model()
    result.error = message.clone()
    result
}

fn index(value: i64) -> bool { value >= -1 && value <= 2147483647 }

pub fn decode(output: string) -> Model {
    lines := harness.lines(output)
    if lines.len < 13 { return failure("invalid export header") }
    mut values: []i64 = []
    values.reserve(lines.len)
    for line in lines {
        parsed := parse.integer(line)
        if !parsed.ok { return failure("invalid integer in export") }
        values.push(parsed.value)
    }
    if values[0] != 2 || !index(values[1]) || !index(values[2]) || !index(values[3]) {
        return failure("invalid export header")
    }
    nodes := values[4]
    locals := values[5]
    if nodes < 0 || locals < 0 || nodes > i64(lines.len) || locals > i64(lines.len) ||
       i64(lines.len) != 13 + nodes * 13 + locals * 4 { return failure("invalid export size") }
    mut result := model()
    result.root = i32(values[1])
    result.ret = i32(values[2])
    result.params = i32(values[3])
    result.status = values[6]
    result.units = values[7]
    result.reads = values[8]
    result.stores = values[9]
    result.arithmetic = values[12]
    if result.status < 2 || result.status > 4 || result.units < 0 || result.units > 131072 {
        return failure("invalid exported status or work")
    }
    mut at := 13
    mut counts: [i64; 3] = [0, 0, 0]
    for _ in 0..i32(nodes) {
        for column in [0, 1, 2, 3, 4, 5, 7] {
            if !index(values[at + column]) { return failure("invalid node link or type in export") }
        }
        item := Node {
            kind: i32(values[at]), kind_type: i32(values[at + 1]), left: i32(values[at + 2]),
            right: i32(values[at + 3]), third: i32(values[at + 4]), next: i32(values[at + 5]),
            value: values[at + 6], local: i32(values[at + 7]), proof: values[at + 8], effect: values[at + 9],
            start: values[at + 10], pending: values[at + 11], pending_mask: values[at + 12],
        }
        if item.pending_mask < 0 || item.pending_mask > 3 ||
           item.pending != (if item.pending_mask.bit_and(2) != 0 { 1 } else { 0 }) {
            return failure("invalid pending proof mask")
        }
        if result.status != 2 && item.pending_mask != 0 { return failure("failed analysis leaked proofs") }
        if item.pending != 0 {
            if item.proof.bit_and(2) == 0 { return failure("missing committed bounds proof") }
            if item.kind == 6 { counts[0] += 1 }
            else if item.kind == 18 { counts[1] += 1 }
            else { return failure("pending bounds proof on non-access node") }
        }
        if item.pending_mask.bit_and(1) != 0 {
            arithmetic := (item.kind == 3 && item.value >= 1 && item.value <= 3) || (item.kind == 4 && item.value == 1)
            if item.kind_type != 1 || item.proof.bit_and(1) == 0 || !arithmetic {
                return failure("pending arithmetic proof on unchecked operation")
            }
            counts[2] += 1
        }
        result.nodes.push(item)
        at += 13
    }
    if counts[0] != result.reads || counts[1] != result.stores || counts[2] != result.arithmetic {
        return failure("exported proof totals do not match nodes")
    }
    for _ in 0..i32(locals) {
        if !index(values[at]) || !index(values[at + 1]) { return failure("invalid local descriptor") }
        result.locals.push(Local { kind_type: i32(values[at]), param: i32(values[at + 1]),
            mutable: values[at + 2], at: values[at + 3] })
        at += 4
    }
    result
}

impl Model {
    pub fn write(&self, writer: &mut json.Writer) {
        writer.object()
        writer.key("root"); writer.integer(i64(self.root))
        writer.key("ret"); writer.integer(i64(self.ret))
        writer.key("params"); writer.integer(i64(self.params))
        writer.key("status"); writer.integer(self.status)
        writer.key("units"); writer.integer(self.units)
        writer.key("reads"); writer.integer(self.reads)
        writer.key("stores"); writer.integer(self.stores)
        writer.key("arithmetic"); writer.integer(self.arithmetic)
        writer.key("nodes"); writer.array()
        for n in self.nodes {
            writer.object()
            writer.key("kind"); writer.integer(i64(n.kind))
            writer.key("type"); writer.integer(i64(n.kind_type))
            writer.key("left"); writer.integer(i64(n.left))
            writer.key("right"); writer.integer(i64(n.right))
            writer.key("third"); writer.integer(i64(n.third))
            writer.key("next"); writer.integer(i64(n.next))
            writer.key("value"); writer.integer(n.value)
            writer.key("local"); writer.integer(i64(n.local))
            writer.key("proof"); writer.integer(n.proof)
            writer.key("effect"); writer.integer(n.effect)
            writer.key("start"); writer.integer(n.start)
            writer.key("pending"); writer.integer(n.pending)
            writer.key("pending_mask"); writer.integer(n.pending_mask)
            writer.end()
        }
        writer.end()
        writer.key("locals"); writer.array()
        for local in self.locals {
            writer.object()
            writer.key("type"); writer.integer(i64(local.kind_type))
            writer.key("param"); writer.integer(i64(local.param))
            writer.key("mutable"); writer.integer(local.mutable)
            writer.key("at"); writer.integer(local.at)
            writer.end()
        }
        writer.end()
        writer.end()
    }
}
