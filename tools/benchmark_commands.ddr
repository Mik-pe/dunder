capability process, unsafe

import .benchmark_time as time
import .harness as harness
import std.bytes as bytes
import std.process as process
import sys

@extern("c", "snprintf")
@c_variadic(3)
unsafe fn format_float(buffer: ptr, length: usize, format: ptr, value: f64) -> i32

@extern("c", "gnu_get_libc_version")
unsafe fn libc_version() -> ptr

pub struct Commands {
    cwd: string,
    timeout: i64,
    error: string,
}

pub fn commands(cwd: string, timeout: i64) -> Commands {
    Commands { cwd: cwd.clone(), timeout: timeout, error: "" }
}

impl Commands {
    pub fn fail(&mut self, error: string) -> bool {
        if self.error.len == 0 { self.error = error.clone() }
        harness.fail(error)
    }

    pub fn run(&mut self, argv: []string, inherit_environment: bool, measured: bool,
               output: &mut process.Output, elapsed: &mut i64) -> bool {
        if argv.len == 0 { return self.fail("missing executable") }
        mut args: []string = []
        for i in 1..argv.len { args.push(argv[i].clone()) }
        mut command := process.command(argv[0].clone(), move args)
        command.set_cwd(self.cwd.clone())
        if !inherit_environment {
            command.clear_env()
            command.set_env("PATH", "/no-external-tools")
        }
        command.set_timeout(self.timeout)
        started := if measured { time.now_ns() } else { 0 }
        if started < 0 { return self.fail("monotonic clock unavailable") }
        result := command.exec()
        finished := if measured { time.now_ns() } else { 0 }
        if !result.succeeded() {
            return self.fail(f"{argv[0]} exited {result.code} (signal {result.signal}, timed out {result.timed_out})\n{result.stdout_text()}\n{result.stderr_text()}")
        }
        if measured && finished <= started { return self.fail("monotonic clock did not advance during the sample") }
        output = result
        elapsed = finished - started
        true
    }

    pub fn checked(&mut self, argv: []string, expected: &[]u8, measured: bool, elapsed: &mut i64) -> bool {
        mut output := harness.empty_output()
        if !self.run(argv, false, measured, &mut output, &mut elapsed) { return false }
        bytes.equal(&output.stdout, &expected) ||
            self.fail(f"{argv[0]}: consumer stdout differed\nexpected:\n{bytes.decode(&expected).value}\nobserved:\n{output.stdout_text()}")
    }
}

pub fn raw(text: string) -> []u8 {
    mut output: []u8 = []
    bytes.append_utf8(&mut output, text)
    output
}

pub fn fixed(value: f64, precision: i32) -> string {
    mut buffer: [u8; 512] = [0; 512]
    unsafe {
        format := if precision == 0 { cstr("%.0f") } else if precision == 2 { cstr("%.2f") }
                  else if precision == 3 { cstr("%.3f") } else { cstr("%.6f") }
        length := format_float(addr(&mut buffer[0]), usize(buffer.len), format, value)
        if length <= 0 || length >= buffer.len { return "" }
        mut result: []u8 = []
        result.reserve(length)
        for i in 0..length { result.push(buffer[i]) }
        bytes.decode(&result).value
    }
}

pub fn glibc() -> string {
    if target_is("linux") {
        unsafe {
            value := libc_version()
            mut version: []u8 = []
            for i in 0..64 {
                digit := load_u8(ptr(usize(value) + usize(i)))
                if digit == 0 { break }
                version.push(digit)
            }
            return bytes.decode(&version).value
        }
    }
    ""
}
