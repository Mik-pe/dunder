capability process, filesystem

import .harness as harness
import .probe_cli as cli
import std.fs as fs
import std.parse as parse
import std.text as text
import sys

struct Program {
    name: string,
    source: string,
    layout: string,
    args: [i64; 8],
    ret: i32,
    expected: i64,
    status: i32,
    length: i32,
}

struct Store {
    program: Program,
    pushes: i64,
    address: i64,
    direct: i64,
}

struct Probe {
    program: Program,
    masks: [i64; 2],
    words: [i64; 2],
}

fn balanced(leaves: i32) -> string {
    if leaves == 1 { return "p2" }
    half := leaves / 2
    "(" + balanced(half) + "+" + balanced(leaves - half) + ")"
}

fn store(name: string, source: string, layout: string, args: [i64; 8], expected: i64, status: i32, length: i32,
         pushes: i64, address: i64, direct: i64) -> Store {
    Store {
        program: Program { name: name.clone(), source: source.clone(), layout: layout.clone(), args: args.clone(),
                           ret: 2, expected: expected, status: status, length: length },
        pushes: pushes, address: address, direct: direct,
    }
}

fn probe(name: string, source: string, layout: string, args: [i64; 8], ret: i32, expected: i64,
         masks: [i64; 2], words: [i64; 2]) -> Probe {
    Probe {
        program: Program { name: name.clone(), source: source.clone(), layout: layout.clone(), args: args.clone(),
                           ret: ret, expected: expected, status: 0, length: 8 },
        masks: masks.clone(), words: words.clone(),
    }
}

fn normal_args() -> [i64; 8] { [5, 0, 11, 13, 17, 19, 23, 29] }

fn stores() -> []Store {
    normal := normal_args()
    mut padding := ""
    for i in 0..40 { padding += f"pad{i}:i64={i};" }
    [
        store("home_value", "{p0[p1]=p2;0}", "homes", normal, 0, 0, 8, 0, 0, 1),
        store("read_value", "{p0[p1]=p0[p1];0}", "homes", normal, 0, 0, 8, 0, 1, 0),
        store("nested_reads", "{p0[p1]=p0[p1+1]+p0[p1+2];p0[p1]}", "homes", normal, 4, 0, 8, 0, 1, 0),
        store("read_constdiv", "{p0[p1]=p0[p1]/3;p0[p1]}", "homes", normal, 1, 0, 8, 0, 1, 0),
        store("dynamic_div", "{p0[p1]=p2/p3;p0[p1]}", "homes", normal, 0, 0, 8, 0, 0, 0),
        store("multiply", "{p0[p1]=p0[p1]+p2*p3;p0[p1]}", "homes", normal, 146, 0, 8, 0, 1, 0),
        store("small_spills", "{p0[p1]=p0[p1]+p2;p0[p1]}", "spill", normal, 14, 0, 8, 0, 1, 0),
        store("large_spill_read", "{" + padding + "p0[p1]=p0[p1]+pad39;p0[p1]}", "spill", normal, 42, 0, 8, 1, 0, 0),
        store("large_spill_scalar", "{" + padding + "p0[p1]=pad39;p0[p1]}", "spill", normal, 39, 0, 8, 0, 0, 0),
        store("lhs_before_zero", "{p0[p1]=p0[0]/p2;0}", "homes", [5, -1, 0, 13, 17, 19, 23, 29], 0, 103, 8, 0, 1, 0),
        store("rhs_zero", "{p0[p1]=p0[p1]/p2;0}", "homes", [5, 0, 0, 13, 17, 19, 23, 29], 0, 102, 8, 0, 1, 0),
        store("rhs_bounds", "{p0[p1]=p0[p1+8];0}", "homes", normal, 0, 103, 8, 0, 1, 0),
        store("index_overflow", "{p0[p1+1]=p2;0}", "homes", [5, 2147483647, 11, 13, 17, 19, 23, 29], 0, 101, 8, 0, 0, 1),
        store("rhs_overflow", "{p0[p1]=p2+1;0}", "homes", [5, 0, 9223372036854775807, 13, 17, 19, 23, 29], 0, 101, 8, 0, 0, 0),
        store("empty", "{p0[p1]=p2;0}", "homes", normal, 0, 103, 0, 0, 0, 1),
        store("guarded", "{if p1>=0&&p1<p0.len{p0[p1]=p2};p0[p1]}", "homes", normal, 11, 0, 8, 0, 0, 1),
        store("walk512", "{p0[p1]=-(" + balanced(256) + ");p0[p1]}", "homes", [5, 0, 1, 13, 17, 19, 23, 29], -256, 0, 8, 0, 0, 0),
        store("walk513", "{p0[p1]=" + balanced(257) + ";p0[p1]}", "homes", [5, 0, 1, 13, 17, 19, 23, 29], 257, 0, 8, 1, 0, 0),
    ]
}

fn probes() -> []Probe {
    normal := normal_args()
    [
        probe("register_read", "{p0[p1]}", "homes", normal, 2, 3, [256, 256], [5, 5]),
        probe("proven_register_read", "{if p1>=0&&p1<p0.len{return p0[p1]};return 0}", "homes", normal, 2, 3, [256, 256], [5, 2]),
        probe("nested", "{p0[p1]+p0[p1+1]+p0[p1+2]}", "homes", normal, 2, 7, [256, 256], [-1, -1]),
        probe("compare_and", "{p1>=0&&p0[p1]>p2}", "homes", [5, 0, 0, 13, 17, 19, 23, 29], 3, 1, [256, 256], [-1, -1]),
        probe("short_skip", "{p1>=0&&p0[p1]>p2}", "homes", [5, -1, 0, 13, 17, 19, 23, 29], 3, 0, [256, 256], [-1, -1]),
        probe("constdiv", "{p2/3}", "homes", normal, 2, 3, [0, 0], [-1, -1]),
        probe("negative_constdiv", "{p2/(-3)}", "homes", normal, 2, -3, [0, 0], [-1, -1]),
        probe("dynamic_div", "{p2/p3}", "homes", [5, 0, 11, 2, 17, 19, 23, 29], 2, 5, [0, 0], [-1, -1]),
        probe("mul", "{p2*p3+p4}", "homes", normal, 2, 160, [0, 0], [-1, -1]),
        probe("read_div", "{(p0[p1]+p2)/3}", "homes", normal, 2, 4, [256, 256], [-1, -1]),
        probe("length", "{p0.len}", "homes", normal, 1, 8, [0, 0], [1, 1]),
        probe("virtual_large_physical_small", "{p0[p1]}", "mapped-small", normal, 2, 3, [256, 256], [8, 8]),
        probe("large_data", "{p0[p1]}", "mapped-data", normal, 2, 3, [768, 768], [10, 10]),
        probe("large_index", "{p0[p1]}", "mapped-index", normal, 2, 3, [768, 768], [10, 10]),
        probe("large_scalar", "{p2}", "mapped-value", normal, 2, 11, [512, 512], [3, 3]),
        probe("large_length", "{p0.len}", "mapped-length", normal, 1, 8, [512, 512], [3, 3]),
        probe("dead_length_spill", "{if p1>=0&&p1<p0.len{return p0[p1]};return 0}", "mapped-length", normal, 2, 3, [768, 256], [10, 4]),
    ]
}

fn emitter_args(program: &Program, source: string, image: string, target: i32, mode: string, proof: string) -> []string {
    mut args: []string = [source.clone(), image.clone(), target.str(), program.expected.str(), program.ret.str(), "21"]
    for param in program.args { args.push(param.str()) }
    args.push(program.length.str())
    args.push(mode.clone())
    args.push(program.layout.clone())
    args.push(proof.clone())
    args
}

fn generate(emitter: string, work: string, program: &Program, target: i32, host: i32, proof: string, mode: string) -> []i64 {
    source := f"{work}/{program.name}.ddr"
    image := f"{work}/{program.name}-{target}-{proof}-{mode}"
    args := emitter_args(&program, source, image, target, mode, proof)
    mut result := harness.empty_output()
    if !harness.run_checked_timeout(emitter, args, "", 0, false, 15000, &mut result) { return [] }
    lines := harness.lines(result.stdout_text())
    if lines.len != 10 { _ := harness.fail(f"{image}: expected ten fields: {result.stdout_text()}"); return [] }
    mut fields: []i64 = []
    for line in lines {
        number := parse.integer(line)
        if !number.ok { _ := harness.fail(f"{image}: invalid field {line}"); return [] }
        fields.push(number.value)
    }
    if target == host && !harness.run_checked_timeout(image, [], "", program.status, false, 10000, &mut result) { return [] }
    fields
}

fn write_source(work: string, program: &Program) -> bool {
    source := f"{work}/{program.name}.ddr"
    sys.write_text(source, "p0 p1 p2 p3 p4 p5 p6 p7 " + program.source).ok ||
        harness.fail(f"cannot write {source}")
}

fn check_store(emitter: string, work: string, item: &Store, host: i32) -> bool {
    if !write_source(work, &item.program) { return false }
    reads := i64(text.split(item.program.source, "p0[").len - 2)
    for target in 0..3 {
        for proof in ["off", "on"] {
            fields := generate(emitter, work, &item.program, target, host, proof, "function")
            if fields.len != 10 { return false }
            indexed := target != 2 && item.program.layout == "homes" && item.program.name != "index_overflow"
            loads: i64 = if target != 2 { reads } else { 0 }
            pushes: i64 = if indexed { 0 } else { item.pushes }
            address: i64 = if indexed { 0 } else { item.address }
            flag: i64 = if indexed { 1 } else { 0 }
            if fields[2] != pushes || fields[4] != address || fields[5] != item.direct || fields[8] != loads || fields[9] != flag {
                return harness.fail(f"store {item.program.name} target {target} proof {proof}: pushes/address/direct/loads/indexed {fields[2]}/{fields[4]}/{fields[5]}/{fields[8]}/{fields[9]}, expected {pushes}/{address}/{item.direct}/{loads}/{flag}")
            }
        }
    }
    print(f"PASS store {item.program.name} exact address/preservation words; three targets; native executed")
    true
}

fn check_probe(emitter: string, work: string, item: &Probe, host: i32) -> bool {
    if !write_source(work, &item.program) { return false }
    reads := i64(text.split(item.program.source, "p0[").len - 1)
    proof_modes := ["off", "on"]
    for target in 0..3 {
        for i in 0..2 {
            proof := proof_modes[i].clone()
            fields := generate(emitter, work, &item.program, target, host, proof, "probe")
            if fields.len != 10 { return false }
            loads: i64 = if target != 2 { reads } else { 0 }
            mask := item.masks[i]
            words := item.words[i]
            if fields[1].bit_and(768) != mask || fields[8] != loads || fields[9] != 0 ||
               (words >= 0 && fields[0] != words - loads) ||
               (mask.bit_and(256) == 0 && fields[6] != 0) || (mask.bit_and(512) == 0 && fields[7] != 0) {
                return harness.fail(f"probe {item.program.name} target {target} proof {proof}: mask {fields[1]}, words {fields[0]}, sentinels {fields[6]}/{fields[7]}, loads {fields[8]}, stores {fields[9]}; expected mask {mask}, loads {loads}, requested words {words}")
            }
        }
    }
    print(f"PASS probe {item.program.name} actual x8/x9 sentinels and write words; three targets")
    true
}

fn run_suite(compiler: string, root: string, work: string) -> bool {
    emitter := work + "/emitter"
    mut result := harness.empty_output()
    if !harness.run_checked_timeout(compiler, ["build", root + "/tests/fixtures/array-address-emitter.ddr", "-o", emitter.clone()],
                                     "", 0, false, 60000, &mut result) { return false }
    host := harness.host_id()
    store_cases := stores()
    probe_cases := probes()
    for i in 0..store_cases.len {
        if !check_store(emitter, work, &store_cases[i], host) { return false }
    }
    for i in 0..probe_cases.len {
        if !check_probe(emitter, work, &probe_cases[i], host) { return false }
    }
    conservative := Program { name: "unknown", source: "{p2}", layout: "homes", args: normal_args(),
                             ret: 2, expected: 11, status: 0, length: 8 }
    if !write_source(work, &conservative) { return false }
    for mode in ["unknown", "depth"] {
        args := emitter_args(&conservative, work + "/unknown.ddr", work + "/unused", 0, mode, "off")
        if !harness.run_checked_timeout(emitter, args, "", 0, false, 10000, &mut result) ||
           !harness.stdout_is(&result, "-1\n", mode) { return false }
        print(f"PASS conservative {mode}")
    }
    print(f"{store_cases.len} store cases + {probe_cases.len} scratch probes; all three target images; native executed")
    true
}

fn main() -> i32 {
    spec: []cli.Option = []
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_array_addresses <compiler>")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("could not locate Dunder repository root"); return 1 }
    tmp := fs.temp_dir("dunder-array-addresses-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    defer { _ := fs.remove_all(tmp.value) }
    if run_suite(compiler, root, tmp.value) { 0 } else { 1 }
}
