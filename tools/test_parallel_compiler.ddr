capability process, filesystem

import .harness as harness
import .native_probe as native
import .parallel_compiler_probe as pc
import .probe_cli as cli
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

struct Source { name: string, text: string, expected: string }

fn core() -> []Source {
    [
        Source { name: "arithmetic", text: "fn earlier(n:i64)->i64{mut total:i64=0;for i in 0..8{total=total+n+i64(i)};total}\nfn later(n:i64)->i64{earlier(n)+1}\nfn main(){print(later(2));print(later(5))}\n", expected: "45\n69\n" },
        Source { name: "owned", text: "struct Box{a:[]i64,n:i64}\nfn owned(n:i64)->Box{Box{a:[n,n+1,n+2],n:n}}\nfn mutate(a:&mut []i64)->i64{mut sum:i64=0;for i in 0..a.len{a[i]=a[i]+1;sum=sum+a[i]};sum}\nfn relay(n:i64)->Box{owned(n)}\nfn main(){x:=relay(5);mut a:=x.a.clone();print(mutate(&mut a));print(x.a[0]);print(a[2])}\n", expected: "21\n5\n8\n" },
        Source { name: "strings", text: "fn integer(n:i64)->string{n.str()}\nfn text(n:i64)->string{\"h🙂\\0\"+integer(n)}\nfn count(t:string)->i64{mut sum:i64=0;for r in t.runes(){sum=sum+1};sum}\nfn main(){t:=text(42);print(count(t));print(t.bytes().len);print(t==\"h🙂\\042\")}\n", expected: "5\n8\ntrue\n" },
    ]
}

fn task_source() -> string {
    "fn worker(x:i64)->[]i64{[x,x+1]}\nfn answer()->[]i64{task scope s(2){a:=spawn s worker(41);b:=spawn s worker(43);ignored:=await! s(b);return await! s(a)}}\nfn main(){a:=answer();print(a[0]);print(a[1])}\n"
}

fn cache_source() -> string {
    "fn private(x:i32)->i32{x+INC}\nfn first(x:i32)->i32{private(x)+private(x+1)}\nfn second(x:i32)->i32{private(x)*2}\nfn third(x:i32)->i32{mut s:=x;for i in 0..4{s=s+i};s}\nfn main(){print(first(1)+second(2)+third(0))}\n"
}

fn repeat(value: string, n: i32) -> string {
    mut result: []u8 = []
    result.reserve(value.len * n)
    for _ in 0..n { bytes.append_utf8(&mut result, value) }
    bytes.decode(&result).value
}

fn change(source: string, before: string, after: string) -> string {
    at := text.find(source, before).unwrap_or(-1)
    assert(at >= 0)
    source[0..at] + after + source[(at + before.len)..source.len]
}

fn build_frontend(probe: &mut pc.Probe, source: string, expected: string, owned: bool) -> bool {
    mut identity := ""
    for index in 0..probe.drivers.len {
        driver := probe.drivers[index].clone()
        image := harness.parent_dir(source) + "/" + driver.name
        mut output := harness.empty_output()
        if !probe.driver_run(&driver, "build", source, ["--timings=json", "-o", image.clone()], 0, &mut output) { return false }
        receipt := json.Doc::parse_text(output.stderr_text())
        entry := receipt.field(receipt.root, "frontend")
        workers := receipt.get_i64(entry, "workers_used")
        scalar := receipt.get_i64(entry, "scalar_bodies")
        general := receipt.get_i64(entry, "general_bodies")
        peak := receipt.get_i64(entry, "peak_total_jobs")
        windows := receipt.get_i64(entry, "windows")
        if workers.is_none() || scalar.is_none() || general.is_none() || peak.is_none() || windows.is_none() {
            return probe.fail(f"{source}: incomplete frontend counters for {driver.name}\n{output.stderr_text()}")
        }
        wv := workers.unwrap(); sv := scalar.unwrap(); gv := general.unwrap(); pv := peak.unwrap(); winv := windows.unwrap()
        mut valid := true
        jobs := i64(driver.jobs)
        if jobs == 1 { valid = wv == 0 && sv == 0 && gv == 0 && pv == 0 }
        else if jobs > 1 {
            if owned { valid = gv >= 6 && pv > 0 && pv <= jobs }
            else {
                bodies := sv + gv
                valid = sv >= 21 && sv <= 42 && wv >= 1 &&
                    pv >= wv && pv <= jobs && winv > 0 &&
                    winv <= bodies && bodies <= jobs * winv &&
                    (jobs != 4 || winv * 2 <= bodies)
            }
        }
        if !valid { return probe.fail(f"{source}: invalid frontend scheduling counters for {driver.name}\n{output.stderr_text()}") }
        sha := harness.sha256_file_hex(image)
        if (index > 0 && sha != identity) || sha.len == 0 { return probe.fail(f"{source}: frontend images differ") }
        identity = sha.clone()
        host := probe.host.clone()
        if index == 0 && !probe.execute(image, host, expected) { return false }
    }
    true
}

fn equal_diagnostic(probe: &mut pc.Probe, file: string, location: string, message: string) -> bool {
    mut expected := ""
    for index in 0..probe.drivers.len {
        driver := probe.drivers[index].clone()
        mut result := harness.empty_output()
        if !probe.driver_run(&driver, "build", file, [], 1, &mut result) { return false }
        diagnostic := result.stderr_text()
        if !text.contains(diagnostic, location) || !text.contains(diagnostic, message) ||
           (index > 0 && diagnostic != expected) {
            return probe.fail(f"{file}: incorrect diagnostic for {driver.name}\n{diagnostic}")
        }
        expected = diagnostic.clone()
    }
    true
}

fn reachable_frontend(probe: &mut pc.Probe) -> bool {
    mut code := ""
    pad := repeat("n=n+0;", 34)
    for i in 0..42 {
        code += "fn f" + i.str() + "(x:i32)->i32{mut n:=x;for j in 0..3{n=n+j};" + pad + "n+" + i.str() + "}\n"
    }
    code += "fn main(){mut n:=0;\n"
    for i in 0..42 { code += f"n=n+f{i}(1)\n" }
    code += "print(n)}"
    file := probe.fixture("reachable_frontend", code)
    if file.len == 0 || !build_frontend(&mut probe, file, "1029\n", false) { return false }
    edited := change(change(code, "n+7}", "n+false}"), "n+9}", "n+false}")
    if !pc.put(file, edited) || !equal_diagnostic(&mut probe, file, ":8:", "") { return false }
    code = ""
    for i in 0..12 { code += "fn g" + i.str() + "(s:string)->string{s+\"" + i.str() + "\"}\n" }
    code += "fn main(){mut s:=\"\";\n"
    for i in 0..12 { code += f"s=g{i}(s)\n" }
    code += "print(s)}"
    owned := probe.fixture("reachable_owned", code)
    if owned.len == 0 || !build_frontend(&mut probe, owned, "01234567891011\n", true) { return false }
    probe.counted("reachable_frontend", "worker_typed_functions", 42)
    true
}

fn diagnostics(probe: &mut pc.Probe) -> bool {
    specifications: [](string, string) = [
        ("reachable_error", "fn first(n:i64)->i64{mut s:i64=0;for i in 0..8{s=s+n};s}\nfn bad(n:i64)->i64{true}\nfn main(){print(first(1));print(bad(2))}\n"),
        ("unused_error", "fn first(n:i64)->i64{n+1}\nfn bad(n:i64)->i64{true}\nfn main(){print(first(41))}\n"),
        ("module_error", "import broken as m\nfn main(){print(m.good(1));print(m.bad(2))}\n"),
    ]
    for entry in specifications {
        name := entry.0.clone()
        file := probe.fixture(name, entry.1)
        if file.len == 0 { return false }
        mut error_file := file.clone()
        mut error_source := entry.1.clone()
        if name == "module_error" {
            error_file = harness.parent_dir(file) + "/broken.ddr"
            error_source = "pub fn good(x:i64)->i64{x+1}\npub fn bad(x:i64)->i64{true}\n"
            if !pc.put(error_file, error_source) { return false }
        }
        mut build := harness.empty_output()
        mut report := harness.empty_output()
        start := i64(text.find(error_source, "true").unwrap_or(-1))
        for index in 0..probe.drivers.len {
            driver := probe.drivers[index].clone()
            image := harness.parent_dir(file) + "/" + driver.name
            mut observed := harness.empty_output()
            if !probe.driver_run(&driver, "build", file, ["-o", image.clone()], 1, &mut observed) { return false }
            stderr := observed.stderr_text()
            if sys.metadata(image).ok || !text.contains(stderr, error_file + ":2:") || !text.contains(stderr, "type mismatch") ||
               (index > 0 && !pc.same_response(&build, &observed)) {
                return probe.fail(f"{file}: build diagnostic differs for {driver.name}\n{stderr}")
            }
            if index == 0 { build = observed }
            mut agent := harness.empty_output()
            if !probe.driver_run(&driver, "check", file, ["--agent"], 1, &mut agent) { return false }
            err := harness.agent_error_info(agent.stdout_text())
            if !err.ok || err.path != error_file || err.start != start || err.end != start + 4 || (index > 0 && !pc.same_response(&report, &agent)) {
                return probe.fail(f"{file}: agent diagnostic differs for {driver.name}\n{agent.stdout_text()}")
            }
            if index == 0 { report = agent }
        }
        probe.checked(name, "exact_source_diagnostic_equal")
    }
    true
}

fn dead_body_order(probe: &mut pc.Probe) -> bool {
    file := probe.fixture("dead_body_order", "fn first(v: i32) -> i32 { if v > 0 { return v } }\nfn second() -> bool { 1 }\nfn main() { print(0) }\n")
    if file.len == 0 { return false }
    first_diag := file + ":1:50: error[E3002]: function can finish without returning a value\n"
    second_diag := file + ":2:"
    mut baseline := harness.empty_output()
    for index in 0..probe.drivers.len {
        driver := probe.drivers[index].clone()
        image := harness.parent_dir(file) + "/" + driver.name
        mut output := harness.empty_output()
        if !probe.driver_run(&driver, "build", file, ["-o", image.clone()], 1, &mut output) { return false }
        stderr := output.stderr_text()
        p1 := text.find(stderr, first_diag).unwrap_or(-1)
        p2 := text.find(stderr, second_diag).unwrap_or(-1)
        if sys.metadata(image).ok || p1 < 0 || p2 <= p1 || !text.contains(stderr, "error[E3001]: type mismatch") ||
           !text.contains(stderr, "^") || (index > 0 && !pc.same_response(&baseline, &output)) {
            return probe.fail(f"{file}: wrong first declaration diagnostic\n{stderr}")
        }
        if index == 0 { baseline = output }
    }
    probe.checked("dead_body_order", "first_declaration_and_following_offset")
    true
}

fn worker_expression_depth(probe: &mut pc.Probe) -> bool {
    mut body := ""
    for i in 0..50 { body += f"mut _v{i}:i64={i};" }
    mut ballast: []u8 = []
    for i in 0..40 { bytes.append_utf8(&mut ballast, "fn body" + i.str() + "(){" + body + "}\n") }
    background := bytes.decode(&ballast).value
    for depth in [42, 43] {
        expression := repeat("1+(", depth) + "1" + repeat(")", depth)
        label := f"dead_depth_{depth}"
        file := probe.fixture(label, "fn unused()->i32{" + expression + "}\n" + background + "fn main(){print(42)}\n")
        if file.len == 0 { return false }
        expected := file + ":1:146: error[E1003]: expression nesting exceeds 128\n"
        mut baseline := harness.empty_output()
        for index in 0..probe.drivers.len {
            driver := probe.drivers[index].clone()
            image := harness.parent_dir(file) + "/" + driver.name
            mut output := harness.empty_output()
            if !probe.driver_run(&driver, "build", file, ["-o", image.clone()], if depth == 42 { 0 } else { 1 }, &mut output) { return false }
            if depth == 42 {
                host := probe.host.clone()
                if !probe.execute(image, host, "42\n") { return false }
            } else {
                stderr := output.stderr_text()
                if !text.contains(stderr, expected) || !text.contains(stderr, "^") || (index > 0 && !pc.same_response(&baseline, &output)) {
                    return probe.fail(f"{file}: wrong worker nesting diagnostic\n{stderr}")
                }
                if index == 0 { baseline = output }
            }
        }
        probe.counted(label, "expression_depth_boundary", depth)
    }
    true
}

fn globals_and_callback(probe: &mut pc.Probe) -> bool {
    file := probe.fixture("globals_callback", "")
    if file.len == 0 { return false }
    directory := harness.parent_dir(file)
    oracle := directory + "/oracle.c"
    if !pc.put(oracle, "int twice(int (*f)(int),int x){return f(x)+f(x+1);}\n") { return false }
    macos := probe.host == "arm64-macos"
    library := directory + (if macos { "/oracle.dylib" } else { "/oracle.so" })
    command := native.split_words(process.env_or("CC", "cc"))
    if !command.ok || command.args.len == 0 { return probe.fail("CC must be a C compiler command") }
    mut args: []string = []
    for i in 1..command.args.len { args.push(command.args[i].clone()) }
    args.push(if macos { "-dynamiclib" } else { "-shared" })
    args.push("-fPIC")
    args.push(move oracle)
    args.push("-o")
    args.push(library.clone())
    mut result := harness.empty_output()
    if !probe.run(command.args[0], args, directory, 0, &mut result) { return false }
    source := "capability unsafe\n@extern(" + json.quote(library) + ",\"twice\") unsafe fn twice(f:extern fn(i32)->i32,x:i32)->i32\n" +
        "fn step(x:i32)->i32{mut s:=x;for i in 0..2{s=s+1};s}\n" +
        "fn memory(x:i64)->i64{unsafe{p:=static_bytes(\"native\",32);store_i64(p,x);load_i64(p)}}\n" +
        "fn main(){unsafe{print(twice(callback(step),20));print(memory(42));print(\"literal\")}}\n"
    pc.put(file, source) && probe.matrix(file, "45\n42\nliteral\n", harness.targets(), [], false)
}

fn macho_signing(probe: &mut pc.Probe) -> bool {
    payload := repeat("0123456789abcdef", 17 * 1024)
    file := probe.fixture("macho_signing", "fn main(){value:=\"" + payload + "\";print(value.len)}\n")
    if file.len == 0 { return false }
    directory := harness.parent_dir(file)
    target := "arm64-macos"
    first := probe.images.len
    mut baseline := ""
    for index in [0, 1] {
        driver := probe.drivers[index].clone()
        image := directory + "/" + driver.name
        if !probe.build(&driver, file, target, image, []) { return false }
        if !pc.equal_image(&probe.images[first], &probe.images[probe.images.len - 1]) {
            return probe.fail("standalone signed images differ")
        }
        app := directory + "/" + driver.name + "-app/Payload.app"
        mut result := harness.empty_output()
        if !probe.driver_run(&driver, "build", file, ["--target", target.clone(), "--app", "-o", app.clone()], 0, &mut result) { return false }
        executable := app + "/Contents/MacOS/Payload"
        if sys.metadata(executable).size <= i64(payload.len) { return probe.fail(f"invalid bundle executable: {executable}") }
        fingerprint := harness.sha256_file_hex(executable)
        if fingerprint.len == 0 || (index > 0 && fingerprint != baseline) { return probe.fail("bundled signed images differ") }
        baseline = fingerprint.clone()
        if index == 0 && probe.host == target {
            for signed in [image.clone(), app.clone()] {
                if !probe.run("/usr/bin/codesign", ["--verify", "--strict", signed.clone()], directory, 0, &mut result) { return false }
            }
            if !probe.execute(executable, target, payload.len.str() + "\n") { return false }
        }
    }
    probe.checked("macho_signing", "standalone_and_bundle_images_equal")
    true
}

fn module_lexing(probe: &mut pc.Probe) -> bool {
    file := probe.fixture("module_lexing", "import alpha\nimport beta\nfn main(){label:=alpha.value();print(label);print(beta.number());print(beta.letter()==`ø`)}\n")
    if file.len == 0 { return false }
    directory := harness.parent_dir(file)
    alpha := directory + "/alpha.ddr"
    beta := directory + "/beta.ddr"
    padding := "//" + repeat("x", 20000) + "\n"
    if !pc.put(alpha, "pub fn value()->string{f\"å\\n{42:04x}\"}\n" + padding) ||
       !pc.put(beta, "pub fn number()->i32{i32(b'\\x41')}\npub fn letter()->rune{`ø`}\n" + padding) { return false }
    host := probe.host.clone()
    if !probe.matrix(file, "å\n002a\n65\ntrue\n", [host.clone()], [], true) { return false }
    if !pc.put(alpha, "import missing\n" + padding) || !pc.put(beta, "\"unterminated\n" + padding) ||
       !equal_diagnostic(&mut probe, file, alpha + ":1:", "cannot load module") { return false }
    if !pc.put(alpha, "pub fn value()->string{\"valid\"}\n" + padding) ||
       !equal_diagnostic(&mut probe, file, beta + ":2:1:", "unterminated") { return false }
    probe.checked("module_lexing", "first_module_error_preserved")
    true
}

fn saturation(probe: &mut pc.Probe) -> bool {
    mut source := "fn step(x:i32)->i32{x+1}\n"
    body := repeat("sum=sum+step(1);", 100)
    for i in 0..20 { source += "fn consume" + i.str() + "()->i32{mut sum:=0;" + body + "sum}\n" }
    source += "fn main(){mut total:=0;"
    for i in 0..20 { source += f"total=total+consume{i}();" }
    file := probe.fixture("inline_caller_budgets", source + "print(total)}\n")
    host := probe.host.clone()
    if !probe.matrix(file, "4000\n", [host.clone()], [], false) { return false }
    last := probe.images.len - 1
    calls := pc.counter(&probe.images[last], "inlining", "calls")
    words := pc.counter(&probe.images[last], "inlining", "estimated_words")
    counters := probe.images[last].counters.clone()
    valid := calls > 0 && calls < 2000 && calls % 20 == 0 && words > 65536 && words <= 81920
    probe.require(valid, f"expected independent bounded growth in all twenty callers\n{counters}")
}

fn remove_cache_entries(directory: string, needed: &[]string, removed: &mut []string) -> bool {
    contents := fs.list_dir(directory)
    if contents.is_err() { return false }
    for file in contents.unwrap() {
        child := directory + "/" + file
        info := sys.metadata(child)
        if info.is_dir && !fs.is_symlink(child) {
            if !remove_cache_entries(child, &needed, &mut removed) { return false }
        } else {
            for name in needed {
                if file != name { continue }
                if !sys.remove_file(child).ok { return false }
                removed.push(file.clone())
                break
            }
        }
    }
    true
}

fn remove_cache(probe: &mut pc.Probe, directory: string, needed: []string) -> bool {
    mut removed: []string = []
    if !remove_cache_entries(directory, &needed, &mut removed) || removed.len != needed.len {
        return probe.fail(f"{directory}: wrong number of final fragments removed")
    }
    for name in needed {
        mut count := 0
        for file in removed { if file == name { count += 1 } }
        if count != 1 { return probe.fail(f"{directory}: did not remove exactly one {name}") }
    }
    true
}

fn cache_many(probe: &mut pc.Probe) -> bool {
    mut source := ""
    for i in 0..16 { source += "fn m" + i.str() + "(x:i32)->i32{v:=x+" + i.str() + ";v*2}\n" }
    source += "fn main(){print("
    for i in 0..16 {
        if i > 0 { source += "+" }
        source += f"m{i}(1)"
    }
    source += ")}"
    file := probe.fixture("cache_parallel", source)
    if file.len == 0 { return false }
    directory := harness.parent_dir(file)
    host := probe.host.clone()
    build := directory + "/build"
    base := probe.images.len
    for index in [0, 1] {
        driver := probe.drivers[index].clone()
        _ := fs.remove_all(build)
        if !pc.put(file, source) { return false }
        path := directory + "/" + driver.name
        if !probe.build(&driver, file, host, path + "-cold", ["--incremental"]) ||
           !probe.build(&driver, file, host, path + "-warm", ["--incremental"]) { return false }
        warm := probe.images.len - 1
        warm_ok := pc.counter(&probe.images[warm], "functions", "reused") == 17 && pc.counter(&probe.images[warm], "mir", "functions") == 0
        if !probe.require(warm_ok, "warm cache did not reuse all 17 final fragments") { return false }
        mut needed: []string = []
        for fragment in 2..10 { needed.push(f"{fragment}.fn") }
        image := path + "-mixed"
        if !remove_cache(&mut probe, build, needed) || !probe.build(&driver, file, host, image, ["--incremental"]) { return false }
        mixed := probe.images.len - 1
        mixed_ok := pc.counter(&probe.images[mixed], "functions", "reused") == 9 && pc.counter(&probe.images[mixed], "functions", "emitted") == 8
        if !probe.require(mixed_ok, "mixed cache did not retain nine and rebuild eight fragments") ||
           (index == 0 && !probe.execute(image, host, "272\n")) { return false }
    }
    for stage in 0..3 {
        equal := pc.equal_image(&probe.images[base + stage], &probe.images[base + 3 + stage])
        if !probe.require(equal, f"parallel cache differs at stage {stage}") { return false }
    }
    true
}

fn cache(probe: &mut pc.Probe) -> bool {
    template := cache_source()
    normal := change(template, "INC", "1")
    edited := change(template, "INC", "2")
    file := probe.fixture("cache", normal)
    if file.len == 0 { return false }
    directory := harness.parent_dir(file)
    build := directory + "/build"
    host := probe.host.clone()
    first := probe.images.len
    for index in 0..probe.drivers.len {
        driver := probe.drivers[index].clone()
        _ := fs.remove_all(build)
        if !pc.put(file, normal) { return false }
        start := probe.images.len
        stages := ["cold", "warm", "mixed", "edited", "restored"]
        for offset in 0..stages.len {
            stage := stages[offset].clone()
            if stage == "mixed" && !remove_cache(&mut probe, build, ["1.fn", "3.fn"]) { return false }
            if stage == "edited" && !pc.put(file, edited) { return false }
            if stage == "restored" && !pc.put(file, normal) { return false }
            image := directory + "/" + driver.name + "-" + stage
            if !probe.build(&driver, file, host, image, ["--incremental"]) { return false }
            last := start + offset
            mutated := probe.images[last].sha256 != probe.images[start].sha256
            reused := pc.counter(&probe.images[last], "functions", "reused")
            generated := pc.counter(&probe.images[last], "mir", "functions")
            same_as_first := pc.equal_image(&probe.images[last], &probe.images[first + offset])
            if (stage == "cold" && (reused != 0 || generated <= 0)) ||
               (stage == "warm" && (reused <= 0 || generated != 0)) ||
               (stage == "mixed" && (reused <= 0 || generated <= 0)) ||
               mutated != (stage == "edited") || !same_as_first {
                return probe.fail(f"{driver.name}: invalid incremental result in {stage}, reused={reused}, MIR functions={generated}")
            }
            if index == 0 && (stage == "cold" || stage == "edited") &&
               !probe.execute(image, host, if stage == "edited" { "21\n" } else { "17\n" }) { return false }
        }
    }
    if !cache_many(&mut probe) { return false }
    probe.checked("cache", "cold_warm_mixed_private_edit_equal")
    true
}

fn parallel_check(probe: &mut pc.Probe) -> bool {
    mut helper := ""
    for i in 0..8 { helper += "pub fn h" + i.str() + "(x:i32)->i32{y:=x+" + i.str() + ";y+1}\n" }
    helper += "fn dead_h(a:string)->i32{n:=a.len;n}\n"
    mut source := "import helper\nfn dead_p(k:i64)->i64{m:=k+5;m*2}\n"
    for i in 0..16 { source += "fn f" + i.str() + "(x:i32)->i32{v:=helper.h" + (i % 8).str() + "(x);w:=v+" + i.str() + ";w}\n" }
    source += "fn main(){mut s:=0;"
    for i in 0..16 { source += f"s=s+f{i}(1);" }
    source += "print(s)}"
    file := probe.fixture("parallel_check", source)
    if file.len == 0 { return false }
    directory := harness.parent_dir(file)
    library := directory + "/lib.ddr"
    mut standalone := ""
    for i in 0..12 { standalone += "pub fn libfn" + i.str() + "(x:[]i32)->i32{n:=x.len+" + i.str() + ";n}\n" }
    if !pc.put(directory + "/helper.ddr", helper) || !pc.put(library, standalone) { return false }
    check_targets: []string = if probe.host == "arm64-macos" { ["arm64-macos", "x86_64-linux"] } else { [probe.host.clone(), "arm64-macos"] }
    for target in check_targets {
        for input in [file.clone(), library.clone()] {
            mut recorded := harness.empty_output()
            for index in 0..probe.drivers.len {
                driver := probe.drivers[index].clone()
                mut got := harness.empty_output()
                if !probe.bindings(&driver, input, target, [], &mut got) { return false }
                if index == 0 { recorded = got }
                else if !pc.same_response(&recorded, &got) {
                    return probe.fail(f"{target}: {input} source bindings differ for {driver.name}")
                }
            }
        }
    }
    changed := change(source, "fn dead_p(k:i64)->i64{m:=k+5;m*2}", "fn dead_p(k:i64)->i64{m:=k+false;m}")
    if !pc.put(file, changed) { return false }
    mut first := ""
    for index in 0..probe.drivers.len {
        driver := probe.drivers[index].clone()
        mut got := harness.empty_output()
        if !probe.driver_run(&driver, "check", file, ["--agent"], 1, &mut got) { return false }
        stdout := got.stdout_text()
        err := harness.agent_error_info(stdout)
        if !err.ok || (index > 0 && stdout != first) {
            return probe.fail(f"{file}: parallel check diagnostic differs for {driver.name}\n{stdout}")
        }
        first = stdout.clone()
    }
    probe.checked("parallel_check", "bindings_and_diagnostics_equal")
    true
}

fn exercise(probe: &mut pc.Probe) -> bool {
    suite := core()
    host := probe.host.clone()
    for idx in 0..suite.len {
        sample := &suite[idx]
        path := probe.fixture(sample.name, sample.text)
        t_list: []string = if idx == 0 { harness.targets() } else { [host.clone()] }
        if !probe.matrix(path, sample.expected, t_list, [], true) { return false }
    }
    if !reachable_frontend(&mut probe) || !diagnostics(&mut probe) || !dead_body_order(&mut probe) ||
       !worker_expression_depth(&mut probe) || !globals_and_callback(&mut probe) || !macho_signing(&mut probe) ||
       !module_lexing(&mut probe) || !saturation(&mut probe) || !cache(&mut probe) || !parallel_check(&mut probe) {
        return false
    }
    stages: [](string, []string) = [
        ("mir_off", ["--mir=off"]),
        ("mir_pass_off", ["--mir-opt=off"]),
        ("scalar_inline_off", ["--scalar-opt=off", "--inline-opt=off"]),
    ]
    for stage in stages {
        path := probe.fixture(stage.0, suite[1].text)
        if !probe.matrix(path, suite[1].expected, [host.clone()], stage.1, false) { return false }
    }
    path := probe.fixture("source_tasks", task_source())
    probe.matrix(path, "41\n42\n", harness.targets(), [], false)
}

fn new_run(output: string) -> string {
    if !fs.mkdir_all(output).ok { return "" }
    for attempt in 0..1000 {
        child := f"{output}/run-{sys.pid()}-{attempt}"
        status := sys.mkdir(child)
        if status.ok { return child }
        if status.error != 17 { return "" }
    }
    ""
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--baseline"), cli.option("--output")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_parallel_compiler COMPILER [--baseline SERIAL] [--output DIRECTORY]")
    if compiler.len == 0 { return if args.help { 0 } else { 2 } }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("cannot locate Dunder repository"); return 2 }
    mut baseline := ""
    if args.has("--baseline") {
        path := fs.realpath(args.last("--baseline", ""))
        if !path.ok { _ := harness.fail("cannot resolve serial compiler"); return 2 }
        baseline = path.value
    }
    mut identities: []pc.CompilerIdentity = []
    for tool in [compiler.clone(), baseline.clone()] {
        if tool.len == 0 || (identities.len > 0 && tool == identities[0].path) { continue }
        digest := harness.sha256_file_hex(tool)
        if digest.len == 0 { _ := harness.fail(f"cannot hash {tool}"); return 2 }
        identities.push(pc.CompilerIdentity { path: tool.clone(), sha256: digest })
    }
    digest := harness.sha256_file_hex(root + "/tools/test_parallel_compiler.ddr")
    if digest.len == 0 { _ := harness.fail("cannot fingerprint the test runner"); return 2 }
    directory := harness.resolve_or_abs(args.last("--output", root + "/build/parallel-compiler-qa"))
    run := new_run(directory)
    if run.len == 0 { _ := harness.fail(f"cannot create a fresh run directory under {directory}"); return 2 }
    mut probe := pc.create(run, compiler, baseline)
    mut passed := exercise(&mut probe)
    if passed {
        for item in identities {
            if harness.sha256_file_hex(item.path) != item.sha256 {
                passed = probe.fail(f"compiler changed during acceptance: {item.path}")
                break
            }
        }
    }
    wrote := pc.write_results(&probe, &identities, digest, passed)
    result := if passed && wrote { "PASS" } else { "FAIL" }
    print(f"{result} parallel compiler: {probe.images.len} images, {probe.executions} native executions; {run}")
    if passed && wrote { 0 } else { 1 }
}
