capability process, filesystem, stdio

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.text as text
import sys

fn repeat_ascii(ch: u8, n: i32) -> string {
    mut buf: []u8 = []
    buf.reserve(n)
    for _ in 0..n { buf.push(ch) }
    bytes.decode(&buf).unwrap()
}

fn run_all(cli: &harness.BaseCli, work: string) -> bool {
    host := harness.target_name(harness.host_id())
    all_targets := harness.targets()

    deep := work + "/deep.ddr"
    deep_src := "struct Cond{value:bool}\nfn value()->i32{if " +
                repeat_ascii(b'(', 60) + "Cond{value:[true][0]}.value" + repeat_ascii(b')', 60) +
                "{42}else{0}}\nfn main(){print(value())}\n"
    if !sys.write_text(deep, deep_src).ok {
        return harness.fail("write_text failed on " + deep)
    }

    contract_rp := fs.realpath(cli.root + "/tests/contracts/conditional_boundaries.ddr")
    if !contract_rp.ok {
        return harness.fail("missing tests/contracts/conditional_boundaries.ddr")
    }
    pos_sources: []string = [contract_rp.value, deep, cli.root + "/tests/fixtures/postfix_chains/main.ddr"]

    diagnostics := harness.fixture_diagnostics(cli.root)
    if !diagnostics.ok { return harness.fail("could not read fixture diagnostics") }
    err_dir := cli.root + "/tests/fixtures/conditional_errors"
    err_ls := fs.list_dir(err_dir)
    if err_ls.is_err() {
        return harness.fail("list_dir failed on " + err_dir)
    }
    mut err_sources: []string = []
    for name in err_ls.unwrap() {
        if text.ends_with(name, ".ddr") {
            rp := fs.realpath(err_dir + "/" + name)
            if !rp.ok { return harness.fail("realpath failed on " + name) }
            err_sources.push(move rp.value)
        }
    }

    mut previous: []u8 = []
    bytes.append_utf8(&mut previous, "previous successful output")

    modes: []string = ["on", "off"]
    for mode in modes {
        opt_flag := "--scalar-opt=" + mode
        for target in all_targets {
            for src in pos_sources {
                checked := harness.exec_cmd(cli.compiler, ["check", src.clone(), opt_flag.clone(), "--target", target.clone(), "--agent"], "", false, 30000)
                if !checked.ok || checked.timed_out || checked.signal != 0 || checked.code != 0 {
                    return harness.fail("check failed for " + src + " (" + mode + ", " + target + "): " + checked.stderr_text() + checked.stdout_text())
                }

                out_img := work + "/" + harness.stem(src) + "-" + mode + "-" + target
                built := harness.exec_cmd(cli.compiler, ["build", src.clone(), opt_flag.clone(), "--target", target.clone(), "-o", out_img.clone()], "", false, 30000)
                if !built.ok || built.timed_out || built.signal != 0 || built.code != 0 {
                    return harness.fail("build failed for " + src + " (" + mode + ", " + target + "): " + built.stderr_text())
                }

                if target == host {
                    run_res := harness.exec_cmd(out_img, [], "", false, 10000)
                    if !run_res.ok || run_res.timed_out || run_res.signal != 0 || run_res.code != 0 || run_res.stdout_text() != "42\n" {
                        return harness.fail("run failed for " + src + " (" + mode + ", " + target + "): " + run_res.stdout_text() + run_res.stderr_text())
                    }
                }
            }

            for err_src in err_sources {
                src_meta := sys.metadata(err_src)
                if !src_meta.ok { return harness.fail(f"could not stat {err_src}") }
                key := f"conditional_errors/{harness.basename(err_src)}"
                expected_opt := diagnostics.get_str(diagnostics.root, key)
                if expected_opt.is_none() { return harness.fail(f"missing diagnostic for {key}") }
                expected := expected_opt.unwrap()
                if expected.len == 0 { return harness.fail(f"missing diagnostic for {key}") }

                preserved := work + "/preserved-image"
                if !sys.write_u8(preserved, &previous).ok {
                    return harness.fail("write_u8 failed on " + preserved)
                }

                cmds: []string = ["check", "build"]
                for cmd_name in cmds {
                    mut args: []string = [cmd_name.clone(), err_src.clone(), opt_flag.clone(), "--target", target.clone()]
                    if cmd_name == "check" {
                        args.push("--agent")
                    } else {
                        args.push("-o")
                        args.push(preserved.clone())
                    }

                    failed := harness.exec_cmd(cli.compiler, args, "", false, 30000)
                    mut message := failed.stderr_text()
                    rejected := failed.ok && !failed.timed_out && failed.signal == 0 && failed.code == 1
                    if cmd_name == "check" {
                        stdout_str := failed.stdout_text()
                        lines := harness.lines(stdout_str)
                        if lines.len < 2 {
                            return harness.fail("invalid JSON diagnostic on " + err_src + ": " + stdout_str)
                        }
                        mut matched_msg := ""
                        for li in 0..lines.len {
                            doc := json.Doc::parse_text(lines[li])
                            if !doc.ok || doc.kind(doc.root) != .Object {
                                return harness.fail("invalid JSON diagnostic on " + err_src + ": " + lines[li])
                            }
                            kind_opt := doc.get_str(doc.root, "kind")
                            if kind_opt.is_none() { return harness.fail("missing fields in diagnostic on " + err_src) }
                            kind_f := kind_opt.unwrap()
                            if li == lines.len - 1 && kind_f != "failed" {
                                return harness.fail("missing failed diagnostic record on " + err_src)
                            }
                            if kind_f == "error" && matched_msg.len == 0 {
                                code_f := doc.get_str(doc.root, "code")
                                path_f := doc.get_str(doc.root, "path")
                                start_f := doc.get_i64(doc.root, "start")
                                end_f := doc.get_i64(doc.root, "end")
                                msg_f := doc.get_str(doc.root, "message")
                                note_f := doc.get_str(doc.root, "note")
                                if code_f.is_none() || path_f.is_none() || start_f.is_none() || end_f.is_none() || msg_f.is_none() {
                                    return harness.fail("missing fields in diagnostic on " + err_src)
                                }
                                if code_f.unwrap() == "E1000" {
                                    return harness.fail("missing fields in diagnostic on " + err_src)
                                }
                                rp := fs.realpath(path_f.unwrap())
                                if !rp.ok || rp.value != err_src {
                                    return harness.fail("diagnostic path mismatch on " + err_src)
                                }
                                start_v := start_f.unwrap()
                                end_v := end_f.unwrap()
                                if start_v < 0 || start_v > end_v || end_v > src_meta.size {
                                    return harness.fail("invalid span in diagnostic on " + err_src)
                                }
                                msg_v := msg_f.unwrap()
                                if text.contains(msg_v, expected) { matched_msg = msg_v }
                                else if note_f.is_some() {
                                    note_v := note_f.unwrap()
                                    if text.contains(note_v, expected) { matched_msg = note_v }
                                }
                            }
                        }
                        message = matched_msg
                    }

                    if !rejected || !text.contains(message, expected) {
                        return harness.fail(f"expected error '{expected}' on {err_src} ({cmd_name}), got: {message}")
                    }

                    pres_now := sys.read_u8(preserved)
                    if !pres_now.ok || !bytes.equal(&pres_now.value, &previous) {
                        return harness.fail("output not preserved on failed " + cmd_name + " for " + err_src)
                    }
                }
            }

            print("PASS " + target + " scalar-opt=" + mode + " constructors/groups/shadowing/diagnostics")
        }
    }
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-conditionals-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    ok := run_all(&cli, tmp.value)
    _ := fs.remove_all(tmp.value)
    if !ok { return false }
    print("All three native targets and both scalar modes checked/built; host executed; diagnostic outputs preserved")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
