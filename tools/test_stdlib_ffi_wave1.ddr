capability unsafe, filesystem, stdio

import std.bytes as bytes
import std.crypto as crypto
import std.dl as dl
import std.ffi as ffi
import std.fs as fs
import sys

fn test_ffi_cstring() {
    empty := ffi.CString::new("").unwrap()
    assert(empty.len() == 0 && empty.is_empty())
    assert(empty.as_bytes().len == 0)
    assert(empty.as_bytes_with_nul().len == 1 && empty.as_bytes_with_nul()[0] == u8(0))
    assert(empty.to_string() == .Ok(""))

    cs := ffi.CString::new("dunder åäö 🌍").unwrap()
    assert(cs.len() == 18 && !cs.is_empty())
    assert(cs.as_bytes().len == 18)
    assert(cs.as_bytes_with_nul().len == 19 && cs.as_bytes_with_nul()[18] == u8(0))
    assert(cs.to_string() == .Ok("dunder åäö 🌍"))
    assert(cs == ffi.CString::new("dunder åäö 🌍").unwrap())
    assert(cs != empty)

    // Interior NUL rejection
    assert(ffi.CString::new("\0") == .Err(ffi.NulError { position: 0 }))
    assert(ffi.CString::new("abc\0def") == .Err(ffi.NulError { position: 3 }))
    bad_bytes: []u8 = [65, 0, 66]
    assert(ffi.CString::from_bytes(&bad_bytes) == .Err(ffi.NulError { position: 1 }))

    // Non-UTF-8 CString and lossy decoding
    raw_bad: []u8 = [b'h', b'i', 0xff, b'!']
    non_utf8 := ffi.CString::from_bytes(&raw_bad).unwrap()
    assert(non_utf8.len() == 4)
    assert(non_utf8.to_string().is_err())

    unsafe {
        assert(ffi.c_strlen(ptr(0)) == usize(0))
        assert(ffi.c_strnlen(ptr(0), usize(8)) == usize(0))
        assert(ffi.from_cstr(ptr(0)) == .None)
        assert(ffi.from_cstr_bounded(ptr(0), usize(8)) == .None)
        assert(ffi.from_cstr_lossy(ptr(0)) == .None)

        assert(ffi.c_strlen(empty.as_ptr()) == usize(0))
        assert(ffi.c_strlen(cs.as_ptr()) == usize(18))
        assert(ffi.from_cstr(empty.as_ptr()) == .Some(""))
        assert(ffi.from_cstr(cs.as_ptr()) == .Some("dunder åäö 🌍"))
        assert(ffi.from_cstr_bounded(cs.as_ptr(), usize(18)) == .Some("dunder åäö 🌍"))
        assert(ffi.from_cstr_bounded(cs.as_ptr(), usize(5)) == .None)
        assert(ffi.from_cstr_lossy(cs.as_ptr()) == .Some("dunder åäö 🌍"))

        assert(ffi.from_cstr(non_utf8.as_ptr()) == .None)
        lossy := ffi.from_cstr_lossy(non_utf8.as_ptr()).unwrap()
        assert(lossy == "hi\u{fffd}!")
    }
}

fn test_ffi_wstring() {
    empty := ffi.WString::new("").unwrap()
    assert(empty.len() == 0 && empty.is_empty())
    assert(empty.as_units_with_nul().len == 1 && empty.as_units_with_nul()[0] == u16(0))
    assert(empty.to_string() == .Some(""))

    ws := ffi.WString::new("Ö🌍!").unwrap()
    assert(ws.len() == 4 && !ws.is_empty())
    assert(ws.as_units_with_nul().len == 5 && ws.as_units_with_nul()[4] == u16(0))
    assert(ws.to_string() == .Some("Ö🌍!"))
    assert(ws == ffi.WString::new("Ö🌍!").unwrap())
    assert(ws != empty)

    // Interior NUL rejection
    assert(ffi.WString::new("a\0b") == .Err(ffi.NulError { position: 1 }))
    bad_units: []u16 = [u16(65), u16(0), u16(66)]
    assert(ffi.WString::from_units(&bad_units) == .Err(ffi.NulError { position: 1 }))

    // Unpaired surrogate handling
    lone_hi: []u16 = [u16(65), u16(0xd800), u16(66)]
    assert(ffi.decode_utf16(&lone_hi) == .None)
    assert(ffi.decode_utf16_lossy(&lone_hi) == "A\u{fffd}B")
    lone_lo: []u16 = [u16(0xdc00)]
    assert(ffi.decode_utf16(&lone_lo) == .None)
    assert(ffi.decode_utf16_lossy(&lone_lo) == "\u{fffd}")
    ws_bad := ffi.WString::from_units(&lone_hi).unwrap()
    assert(ws_bad.to_string() == .None)

    unsafe {
        assert(ffi.c_wstrlen(ptr(0)) == usize(0))
        assert(ffi.from_wstr(ptr(0)) == .None)
        assert(ffi.from_wstr_lossy(ptr(0)) == .None)
        assert(ffi.c_wstrlen(ws.as_ptr()) == usize(4))
        assert(ffi.from_wstr(ws.as_ptr()) == .Some("Ö🌍!"))
        assert(ffi.from_wstr(ws_bad.as_ptr()) == .None)
        assert(ffi.from_wstr_lossy(ws_bad.as_ptr()) == .Some("A\u{fffd}B"))
    }
}

fn test_ffi_sizes_and_errno() {
    assert(ffi.c_char_size() == usize(1))
    assert(ffi.c_short_size() == usize(2))
    assert(ffi.c_int_size() == usize(4))
    assert(ffi.c_longlong_size() == usize(8))
    assert(ffi.c_ptr_size() == size_of(ptr))
    if target_is("windows") || target_is("wasm32") {
        assert(ffi.c_long_size() == usize(4))
    } else {
        assert(ffi.c_long_size() == usize(8))
    }
    if target_is("macos") || target_is("linux") {
        unsafe {
            ffi.set_errno(22)
            assert(ffi.errno() == 22)
            assert(ffi.last_os_error() == 22)
            ffi.set_errno(0)
            assert(ffi.errno() == 0)
        }
    }
}

fn test_dl_library() {
    assert(dl.mode_flags(.Lazy) == 1)
    assert(dl.mode_flags(.Now) == 2)
    assert(dl.LoadMode.Lazy == dl.LoadMode.Lazy && dl.LoadMode.Lazy != dl.LoadMode.Now)
    if target_is("native") {
        unsafe {
            assert(dl.Library::open("").is_err())
            assert(dl.Library::open("bad\0path").is_err())
            assert(dl.Library::open("/nonexistent/dunder_missing_wave1.so").is_err())
            missing: []string = ["/nonexistent/a.so", "/nonexistent/b.so"]
            assert(dl.Library::open_any(&missing, .Now).is_err())

            mut lib := dl.Library::current().unwrap()
            assert(lib.is_open() && usize(lib.raw_handle()) != usize(0))
            assert(lib.try_symbol("").is_none())
            assert(lib.try_symbol("bad\0sym").is_none())
            assert(lib.try_symbol("__dunder_nonexistent_wave1_sym__").is_none())
            assert(lib.symbol("__dunder_nonexistent_wave1_sym__").is_err())

            if target_is("macos") || target_is("linux") {
                abs_sym := lib.symbol("abs").unwrap()
                abs_fn: extern fn(i32) -> i32 = ffi_fn(abs_sym)
                assert(abs_fn(-42) == 42)
                syms := lib.load_symbols(&["abs", "strlen"]).unwrap()
                assert(syms.len == 2 && usize(syms[0]) != usize(0) && usize(syms[1]) != usize(0))
            }
            assert(lib.close())
            assert(!lib.is_open())
            assert(lib.close()) // idempotent
        }
        // Scope-exit RAII disposal check
        unsafe {
            scoped := dl.Library::current().unwrap()
            assert(scoped.is_open())
        }
    }
}

fn test_cached_crypto() {
    if !target_is("native") { return }
    key := crypto.random(32).unwrap()
    nonce := crypto.random(12).unwrap()
    aad := bytes.from_text("wave1-aad")
    payload := bytes.from_text("cached dynamic crypto payload")

    // Repeated calls exercise the cached library handle and symbol slots.
    for _ in 0..12 {
        sealed := crypto.aes256_gcm_seal(&key, &nonce, &aad, &payload).unwrap()
        opened := crypto.aes256_gcm_open(&key, &nonce, &aad, &sealed.ciphertext, &sealed.tag).unwrap()
        assert(bytes.equal(&opened, &payload))
    }
    kp := crypto.ed25519_keygen().unwrap()
    for _ in 0..8 {
        sig := crypto.ed25519_sign(&kp.private_key, &payload).unwrap()
        assert(crypto.ed25519_verify(&kp.public_key, &payload, &sig))
    }
    hashed := crypto.argon2id_hash("wave1-pass").unwrap()
    assert(crypto.argon2id_verify("wave1-pass", hashed))
    assert(!crypto.argon2id_verify("wrong-pass", hashed))
}

fn test_fs_errno() {
    missing := "/nonexistent_dunder_wave1_dir_4294967291"
    assert(fs.list_dir(missing) == .Err(.NotFound))
    rp := fs.realpath(missing)
    assert(!rp.ok && rp.error == 2)
    assert(fs.ReadFile::grant(missing.clone()).open().is_err())

    tmp := fs.temp_dir("dunder-wave1-fs-")
    assert(tmp.ok)
    dir := tmp.value
    defer { _ := fs.remove_all(dir) }

    f1 := dir + "/b.txt"
    f2 := dir + "/a.txt"
    assert(sys.write(f1, "one").is_ok())
    assert(sys.write(f2, "two").is_ok())
    entries := fs.list_dir(dir).unwrap()
    assert(entries == ["a.txt", "b.txt"])
    assert(fs.list_dir(f1) == .Err(.NotDirectory))
    resolved := fs.realpath(f1)
    assert(resolved.ok && resolved.value.len > 0)
}

fn main() {
    test_ffi_cstring()
    test_ffi_wstring()
    test_ffi_sizes_and_errno()
    test_dl_library()
    test_cached_crypto()
    test_fs_errno()
    print("stdlib FFI wave1 ok")
}
