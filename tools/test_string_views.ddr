capability process, filesystem, stdio

import .harness as harness
import .profile_format as profile
import std.fs as fs
import sys

fn positive_program() -> string {
    r"""
    import std.text.view as tv

    fn sum_bytes(v: &str) -> i32 {
        mut acc := 0
        for b in v.bytes() { acc += i32(b) }
        acc
    }

    fn tail_view(s: &string, skip: i32) -> &str {
        &s[skip..]
    }

    fn pick_view(a: &str, b: &str, first: bool) -> &str from a {
        _ := b
        if first { return a }
        &a[0..2]
    }

    fn pick_left(a: &str, b: &str, first: bool) -> &str from a {
        _ := b
        if first { return a }
        tv.trim(a)
    }

    fn id_str<T>(x: T, y: &str) -> i32 {
        _ := x
        y.len
    }

    fn check_all() {
        raw := "ab" + "c"
        b0: u8 = raw[0]
        assert(b0 == b'a' && raw[1] == b'b' && raw[2] == b'c')

        raw_bytes: []u8 = raw.bytes()
        assert(raw_bytes.len == 3 && raw_bytes[0] == b'a' && raw_bytes[2] == b'c')

        mut enum_sum := 0
        for (i, b) in raw.bytes().enumerate() {
            enum_sum += i * 100 + i32(b)
        }
        assert(enum_sum == 97 + 198 + 299)

        // Creation forms and coercion
        v_full := raw.as_str()
        v_explicit: &str = &raw
        assert(v_full == "abc" && v_explicit == raw)
        assert(v_full.len == 3 && len(v_full) == 3)
        assert(v_full[0] == b'a' && v_full[2] == b'c')
        assert(id_str(1, raw) == 3 && id_str(2, v_full) == 3)

        vb: &[]u8 = v_full.as_bytes()
        assert(vb.len == 3 && vb[1] == b'b')
        v_same: &str = v_full.as_str()
        assert(v_same == v_full)

        owned1 := v_full.clone()
        owned2 := v_full.str()
        owned3 := v_full.to_string()
        assert(owned1 == "abc" && owned2 == "abc" && owned3 == "abc")

        // Comparisons (&str vs &str, &str vs string, string vs &str)
        other := "abd" + ""
        assert(v_full == v_explicit && !(v_full != v_explicit))
        assert(v_full == raw && raw == v_full)
        assert(v_full != other && v_full < other && v_full <= other)
        assert(other > v_full && other >= v_full)
        assert(raw < v_full.as_str() == false && raw <= v_full)

        // Formatting and print
        assert(f"{v_full}" == "abc")
        assert(f"[{v_full:>5}]" == "[  abc]")
        assert(f"[{v_full:<5}]" == "[abc  ]")
        print(v_full)

        // UTF-8 slicing, nested slicing, and iteration
        utf := "  å🌍:ok  " + ""
        s_mid := &utf[2..8]
        s_left := &utf[..2]
        s_right := &utf[8..]
        s_incl := &s_mid[0..=1]
        assert(s_left == "  " && s_mid == "å🌍" && s_right == ":ok  " && s_incl == "å")
        assert(sum_bytes(s_incl) == 195 + 165)

        mut vb_list: []u8 = v_full.bytes()
        assert(vb_list.len == 3 && vb_list[1] == b'b')
        vr_list: []rune = s_mid.runes()
        assert(vr_list.len == 2 && vr_list[0] == `å` && vr_list[1] == `🌍`)

        mut r_acc := 0
        for r in s_mid.runes() { r_acc += i32(r) }
        assert(r_acc == i32(`å`) + i32(`🌍`))

        mut b_acc := 0
        for (i, b) in s_incl.bytes().enumerate() { b_acc += (i + 1) * i32(b) }
        assert(b_acc == 195 + 2 * 165)

        // Borrowed returns & std.text.view helpers
        tv_tail := tail_view(&utf, 2)
        assert(tv_tail == "å🌍:ok  ")
        picked := pick_view(s_mid, s_right, false)
        assert(picked == "å" && pick_view(s_mid, s_right, true) == "å🌍")

        trimmed := tv.trim(utf)
        assert(trimmed == "å🌍:ok")
        assert(tv.trim_start("  \tå") == "å")
        assert(tv.trim_end("å\r\n ") == "å")
        assert(tv.starts_with(trimmed, "å🌍") && !tv.starts_with(trimmed, "🌍"))
        assert(tv.ends_with(trimmed, ":ok") && !tv.ends_with(trimmed, "no"))
        assert(tv.contains(trimmed, "🌍:") && !tv.contains(trimmed, "zz"))
        assert(tv.find(trimmed, ":").unwrap_or(-1) == 6)
        assert(tv.find(trimmed, "missing").is_none())
        assert(tv.strip_prefix(trimmed, "å🌍") == ":ok")
        assert(tv.strip_prefix(trimmed, "zz") == trimmed)
        assert(tv.strip_suffix(trimmed, ":ok") == "å🌍")
        assert(tv.before(trimmed, ":") == "å🌍")
        assert(tv.after(trimmed, ":") == "ok")
        assert(pick_left("  hi ", "other", false) == "hi")
    }

    @test fn test_str_views() {
        check_all()
    }

    fn main() {
        check_all()
        print("VIEWS_OK")
    }
    """
}

fn profile_program() -> string {
    r"""
    import std.text.view as tv

    fn main() {
        line := "  key=å🌍;tail  "
        mut acc := 0
        for _ in 0..10000 {
            t := tv.trim(line)
            left := tv.before(t, ";")
            k := tv.before(left, "=")
            v := tv.after(left, "=")
            if tv.starts_with(v, "å") && tv.ends_with(v, "🌍") && k == "key" && v != "nope" {
                sub := &v[2..]
                acc += i32(sub[0]) + k.len
                for b in v.bytes() { acc += i32(b) }
            }
        }
        print(acc)
    }
    """
}

fn trap_oob_program() -> string {
    r"""
    fn main() {
        s := "hello" + "!"
        n := s.len + 10
        v := &s[0..n]
        print(v.len)
    }
    """
}

fn trap_utf8_program() -> string {
    r"""
    fn main() {
        s := "å🌍" + ""
        mid := 1
        v := &s[0..mid]
        print(v.len)
    }
    """
}

fn cross_program() -> string {
    r"""
    import std.text.view as tv

    fn head_eq(s: &str, prefix: &str) -> bool {
        tv.starts_with(tv.trim(s), prefix)
    }

    fn main() {
        msg := "  hello=å🌍  "
        b := msg[2]
        assert(b == b'h')
        t := tv.trim(msg)
        assert(head_eq(msg, "hello"))
        assert(tv.after(t, "=") == "å🌍")
        print(tv.before(t, "="))
    }
    """
}

fn check_rejected(compiler: string, work: string, tag: string, code: string) -> bool {
    path := f"{work}/neg_{tag}.ddr"
    if !sys.write_text(path, code).ok { return harness.fail(f"write {path}") }
    res := harness.exec_cmd(compiler, ["check", path.clone()], work, false, 30000)
    if res.ok && res.code == 0 {
        return harness.fail(f"expected compile failure for {tag}, but check succeeded:\n{code}")
    }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    mut out := harness.empty_output()

    // 1 & 2 & 3 & 4: positive program (build, run, test)
    pos_path := work + "/views_ok.ddr"
    pos_bin := work + "/views_ok"
    if !sys.write_text(pos_path, positive_program()).ok { return harness.fail("write views_ok.ddr") }
    if !harness.run_checked_timeout(cli.compiler, ["build", pos_path.clone(), "-o", pos_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(pos_bin, [], work, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "abc\nVIEWS_OK\n", "views_ok output") { return false }
    if !harness.run_checked_timeout(cli.compiler, ["test", pos_path.clone()], work, 0, false, 60000, &mut out) { return false }

    // 5: zero-allocation proof via --runtime-profile
    prof_path := work + "/views_profile.ddr"
    prof_bin := work + "/views_profile"
    if !sys.write_text(prof_path, profile_program()).ok { return harness.fail("write views_profile.ddr") }
    if !harness.run_checked_timeout(cli.compiler, ["build", prof_path.clone(), "--runtime-profile", "-o", prof_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(prof_bin.clone(), [], work, 0, false, 60000, &mut out) { return false }
    prof := profile.read(out.stderr_text())
    if prof.error != "" { return harness.fail(f"runtime profile parse failed: {prof.error}") }
    allocs := prof.counters.at("allocation_count")
    slices := prof.counters.at("string_slice_calls")
    if allocs != 0 || slices != 0 {
        return harness.fail(f"expected 0 allocations and 0 string_slice_calls for &str loop, got allocs={allocs}, slice={slices}")
    }

    // 6: runtime traps (103 bounds, 106 utf8 boundary)
    oob_path := work + "/trap_oob.ddr"
    oob_bin := work + "/trap_oob"
    if !sys.write_text(oob_path, trap_oob_program()).ok { return harness.fail("write trap_oob.ddr") }
    if !harness.run_checked_timeout(cli.compiler, ["build", oob_path.clone(), "-o", oob_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(oob_bin, [], work, 103, false, 30000, &mut out) { return false }

    utf_path := work + "/trap_utf8.ddr"
    utf_bin := work + "/trap_utf8"
    if !sys.write_text(utf_path, trap_utf8_program()).ok { return harness.fail("write trap_utf8.ddr") }
    if !harness.run_checked_timeout(cli.compiler, ["build", utf_path.clone(), "-o", utf_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(utf_bin, [], work, 106, false, 30000, &mut out) { return false }

    // 7: negative compile-time rejections
    negatives: [](string, string) = [
        ("bare_param", "fn f(x: str) { _ := x }\nfn main() {}\n"),
        ("bare_local", "fn main() { x: str = \"a\" }\n"),
        ("bare_ret", "fn f() -> str { \"a\" }\nfn main() {}\n"),
        ("mut_ref_str", "fn f(x: &mut str) { _ := x }\nfn main() {}\n"),
        ("struct_field", "struct S { v: &str }\nfn bad(s: &string) -> S { S { v: s.as_str() } }\nfn main() {}\n"),
        ("enum_payload", "enum E { A(&str) }\nfn bad(s: &string) -> E { .A(s.as_str()) }\nfn main() {}\n"),
        ("array_elem", "fn main() { a: []&str = []; _ := a }\n"),
        ("option_elem", "fn f(s: &string) -> Option<&str> { .Some(&s[0..1]) }\nfn main() {}\n"),
        ("map_value", "fn f(m: Map<string, &str>) { _ := m }\nfn main() {}\n"),
        ("escape_local", "fn bad() -> &str { s := \"hi\" + \"!\"; s.as_str() }\nfn main() {}\n"),
        ("mutate_under_borrow", "fn main() { mut s := \"abc\" + \"def\"; v := &s[0..3]; s = \"xyz\"; print(v) }\n"),
        ("move_under_borrow", "fn sink(move s: string) {}\nfn main() { s := \"abc\" + \"def\"; v := s.as_str(); sink(move s); print(v) }\n"),
        ("temp_borrow", "fn main() { v := (\"a\" + \"b\").as_str(); print(v) }\n"),
        ("plus_op", "fn bad(a: &str, b: &str) -> string { a + b }\nfn main() {}\n"),
    ]
    for entry in move negatives {
        (tag, code) := entry
        if !check_rejected(cli.compiler, work, tag, code) { return false }
    }

    // 8: cross-target builds (x86_64-linux, arm64-linux, wasm32-wasi)
    cross_path := work + "/cross_views.ddr"
    if !sys.write_text(cross_path, cross_program()).ok { return harness.fail("write cross_views.ddr") }
    for target in ["x86_64-linux", "arm64-linux", "wasm32-wasi"] {
        if !harness.run_checked_timeout(cli.compiler, ["build", cross_path.clone(), "--target", target.clone(), "-o", f"{work}/cross_{target}"], work, 0, false, 60000, &mut out) {
            return false
        }
    }

    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if cli.extra_args.len > 0 { _ := sys.eprint("unexpected argument: " + cli.extra_args[0]); return 2 }
    tmp := fs.temp_dir("dunder-string-views-")
    if !tmp.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if !run_suite(&cli, work) { return 1 }
    print("PASS string views: u8 indexing/bytes(), &str views, std.text.view, 0-alloc proof, traps 103/106, negative checks, and cross-targets verified")
    0
}
