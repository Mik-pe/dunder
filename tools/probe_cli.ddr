capability filesystem

import std.fs as fs
import std.text as text
import sys

pub struct Option {
    name: string,
    takes_value: bool,
}

struct Value {
    name: string,
    text: string,
}

pub struct Arguments {
    positionals: []string,
    values: []Value,
    help: bool,
    error: string,
}

impl Arguments {
    pub fn has(&self, name: string) -> bool {
        for value in self.values {
            if value.name == name { return true }
        }
        false
    }

    pub fn last(&self, name: string, default_value: string) -> string {
        for i in 0..self.values.len {
            at := self.values.len - i - 1
            if self.values[at].name == name { return self.values[at].text.clone() }
        }
        default_value.clone()
    }

    pub fn all(&self, name: string) -> []string {
        mut found: []string = []
        for value in self.values {
            if value.name == name { found.push(value.text.clone()) }
        }
        found
    }
}

pub fn flag(name: string) -> Option {
    Option { name: name.clone(), takes_value: false }
}

pub fn option(name: string) -> Option {
    Option { name: name.clone(), takes_value: true }
}

pub fn parse(spec: &[]Option) -> Arguments {
    mut args := Arguments { positionals: [], values: [], help: false, error: "" }
    mut options := true
    mut i := 1
    count := sys.arg_count()
    while i < count {
        token := sys.arg(i)
        i += 1
        if options && token == "--" {
            options = false
        } else if options && (token == "-h" || token == "--help") {
            args.help = true
            return args
        } else if options && token != "-" && text.starts_with(token, "-") {
            equal := text.find(token, "=")
            name := if equal < 0 { token.clone() } else { token[0..equal] }
            mut match_index := -1
            for j in 0..spec.len {
                if spec[j].name == name { match_index = j; break }
            }
            if match_index < 0 {
                args.error = f"unknown argument: {name}"
                return args
            }
            mut value := ""
            if spec[match_index].takes_value {
                if equal >= 0 {
                    value = token[(equal + 1)..token.len]
                } else if i < count {
                    value = sys.arg(i)
                    if value != "-" && text.starts_with(value, "-") {
                        args.error = f"{name} requires a value"
                        return args
                    }
                    i += 1
                } else {
                    args.error = f"{name} requires a value"
                    return args
                }
            } else if equal >= 0 {
                args.error = f"{name} does not take a value"
                return args
            }
            args.values.push(Value { name: name, text: value })
        } else {
            args.positionals.push(move token)
        }
    }
    args
}

pub fn compiler(args: &Arguments, usage: string) -> string {
    if args.help {
        print(usage)
        return ""
    }
    if args.error.len != 0 {
        _ := sys.eprint(args.error + "\n" + usage)
        return ""
    }
    if args.positionals.len != 1 {
        _ := sys.eprint("provide one compiler path\n" + usage)
        return ""
    }
    found := fs.realpath(args.positionals[0])
    if !found.ok {
        _ := sys.eprint(f"compiler not found: {args.positionals[0]}")
        return ""
    }
    found.value
}
