capability process, filesystem, unsafe

import .harness as harness
import .probe_cli as cli
import std.bytes as bytes
import std.fs as fs
import std.parse as parse
import std.process as process
import sys

@extern("c", "sin")
unsafe fn macos_sin(x: f64) -> f64
@extern("c", "cos")
unsafe fn macos_cos(x: f64) -> f64
@extern("c", "tan")
unsafe fn macos_tan(x: f64) -> f64
@extern("c", "atan2")
unsafe fn macos_atan2(y: f64, x: f64) -> f64
@extern("c", "exp")
unsafe fn macos_exp(x: f64) -> f64
@extern("c", "log")
unsafe fn macos_log(x: f64) -> f64
@extern("c", "pow")
unsafe fn macos_pow(x: f64, y: f64) -> f64
@extern("libm.so.6", "sin")
unsafe fn linux_sin(x: f64) -> f64
@extern("libm.so.6", "cos")
unsafe fn linux_cos(x: f64) -> f64
@extern("libm.so.6", "tan")
unsafe fn linux_tan(x: f64) -> f64
@extern("libm.so.6", "atan2")
unsafe fn linux_atan2(y: f64, x: f64) -> f64
@extern("libm.so.6", "exp")
unsafe fn linux_exp(x: f64) -> f64
@extern("libm.so.6", "log")
unsafe fn linux_log(x: f64) -> f64
@extern("libm.so.6", "pow")
unsafe fn linux_pow(x: f64, y: f64) -> f64

struct MersenneTwister {
    state: [i64; 624],
    cursor: i32,
}

fn seeded(seed: i64) -> MersenneTwister {
    mut state: [i64; 624] = [0; 624]
    mask: i64 = 0xffffffff
    state[0] = 19650218
    for i in 1..624 {
        x := state[i - 1]
        state[i] = (1812433253 * x.bit_xor(x.shr(30)) + i64(i)).bit_and(mask)
    }
    mut i := 1
    for _ in 0..624 {
        x := state[i - 1]
        state[i] = (state[i].bit_xor(x.bit_xor(x.shr(30)) * 1664525) + seed).bit_and(mask)
        i += 1
        if i == 624 { state[0] = state[623]; i = 1 }
    }
    for _ in 0..623 {
        x := state[i - 1]
        state[i] = (state[i].bit_xor(x.bit_xor(x.shr(30)) * 1566083941) - i64(i)).bit_and(mask)
        i += 1
        if i == 624 { state[0] = state[623]; i = 1 }
    }
    state[0] = 0x80000000
    MersenneTwister { state: state, cursor: 624 }
}

impl MersenneTwister {
    fn word(&mut self) -> i64 {
        if self.cursor == 624 {
            for i in 0..624 {
                high := self.state[i].bit_and(0x80000000)
                low := self.state[(i + 1) % 624].bit_and(0x7fffffff)
                x := high.bit_or(low)
                twist: i64 = if x % 2 == 0 { 0 } else { 0x9908b0df }
                self.state[i] = self.state[(i + 397) % 624].bit_xor(x.shr(1)).bit_xor(twist)
            }
            self.cursor = 0
        }
        mut value := self.state[self.cursor]
        self.cursor += 1
        value = value.bit_xor(value.shr(11))
        value = value.bit_xor(value.shl(7).bit_and(0x9d2c5680))
        value = value.bit_xor(value.shl(15).bit_and(0xefc60000))
        value.bit_xor(value.shr(18))
    }

    fn mantissa(&mut self) -> i64 {
        low := self.word()
        high := self.word().shr(12)
        low.bit_or(high.shl(32))
    }
}

fn angles() -> []i64 {
    mut values: []i64 = [0, -9223372036854775808, 1, -9223372036854775807, 0x7fefffffffffffff, -4503599627370497]
    mut rng := seeded(0x73a8c9)
    for exponent in 0..2047 {
        value := i64(exponent).shl(52).bit_or(rng.mantissa())
        values.push(if exponent % 2 == 0 { value } else { -9223372036854775808 + value })
    }
    multiples: []f64 = [0.5, 1.0, 2.0, 3.0, 4.0, 17.0, 8192.0, 333772.0, 524288.0,
                       f64.from_bits(0x41d0000000000000), f64.from_bits(0x4340000000000000),
                       f64.from_bits(0x4630000000000000), f64.from_bits(0x5f30000000000000)]
    for multiple in multiples {
        pole := 1.5707963267948966 * multiple
        word := pole.to_bits()
        values.push(word - 1)
        values.push(word)
        values.push(word + 1)
        values.push((-pole).to_bits())
    }
    for endpoint in [0.414213562373095, 0.7853981633974483, 1.0, 2.414213562373095, 524288.0, 1e20, 1e100, 1e300,
                     709.782712893384, -708.3964185322641, -745.1332191019411] {
        word := endpoint.to_bits()
        values.push(word - 1)
        values.push(word)
        values.push(word + 1)
    }
    values
}

fn reference_power(base: f64, exponent: f64) -> f64 {
    unsafe {
        if target_is("macos") { return macos_pow(base, exponent) }
        if target_is("linux") { return linux_pow(base, exponent) }
    }
    0.0
}

fn source_program(values: &[]i64) -> []u8 {
    prefix := "import std.math as math\n" +
        "fn main() {\n" +
        "    nan := f64.from_bits(0x7ff8_0000_0000_002a)\n" +
        "    inf := f64.from_bits(0x7ff0_0000_0000_0000)\n" +
        "    assert(math.min(4.0, 7.0) == 4.0 && math.max(4.0, 7.0) == 7.0)\n" +
        "    assert(math.min(0.0, -0.0).is_sign_negative())\n" +
        "    assert(math.min(-0.0, 0.0).is_sign_negative())\n" +
        "    assert(!math.max(-0.0, 0.0).is_sign_negative())\n" +
        "    assert(!math.max(0.0, -0.0).is_sign_negative())\n" +
        "    assert(math.min(inf, 0.0) == 0.0 && math.max(-inf, 0.0) == 0.0)\n" +
        "    assert(math.min(1.0, nan).to_bits() == nan.to_bits())\n" +
        "    assert(math.max(nan, 1.0).to_bits() == nan.to_bits())\n" +
        "    assert(math.clamp(-4.0, 0.0, 1.0) == 0.0)\n" +
        "    assert(math.clamp(0.5, 0.0, 1.0) == 0.5 && math.clamp(3.0, 0.0, 1.0) == 1.0)\n" +
        "    assert(math.clamp(0.5, 1.0, 0.0).is_nan() && math.clamp(0.5, nan, 1.0).is_nan())\n" +
        "    assert(math.clamp(0.5, 0.0, nan).is_nan() && math.clamp(nan, 0.0, 1.0).is_nan())\n" +
        "    assert(math.clamp(-0.0, 0.0, 1.0).is_sign_negative())\n" +
        "    assert(math.sin(-0.0).is_sign_negative() && math.tan(-0.0).is_sign_negative() && math.cos(-0.0) == 1.0)\n" +
        "    assert(math.sin(inf).is_nan() && math.cos(-inf).is_nan() && math.tan(inf).is_nan())\n" +
        "    assert(math.atan2(inf, inf) == math.PI / 4.0 && math.atan2(-0.0, -1.0) == -math.PI)\n" +
        "    assert(math.exp(-inf) == 0.0 && math.exp(inf) == inf && math.exp(nan).is_nan() && math.exp(-0.0) == 1.0)\n" +
        "    assert(math.log(-0.0) == -inf && math.log(inf) == inf && math.log(-1.0).is_nan() && math.log(nan).is_nan())\n" +
        "    assert(math.pow(nan, 0.0) == 1.0 && math.pow(1.0, nan) == 1.0 && math.pow(-1.0, inf) == 1.0)\n" +
        "    assert(math.pow(-0.0, 3.0).to_bits() == (-0.0).to_bits() && math.pow(-0.0, -3.0) == -inf)\n" +
        "    assert(math.pow(-inf, -3.0).to_bits() == (-0.0).to_bits() && math.pow(-inf, 0.5) == inf)\n" +
        "    assert(math.pow(-2.0, 3.0) == -8.0 && math.pow(-2.0, 2.0) == 4.0 && math.pow(-2.0, 0.5).is_nan())\n" +
        "    assert(math.pow(1.5, inf) == inf && math.pow(0.5, inf) == 0.0 && math.pow(0.5, -inf) == inf)\n" +
        "    for x in [-42, 0, 1] { assert(x.abs() == (if x < 0 { -x } else { x })) }\n" +
        "    wide: i64 = -3000000000; assert(wide.abs() == 3000000000)\n" +
        "    assert(math.sin(nan).is_nan() && math.cos(nan).is_nan() && math.tan(nan).is_nan())\n" +
        "    assert(math.checked_add_i32(2147483647, 1).is_err() && math.checked_div_i32(-2147483648, -1).is_err())\n" +
        "    assert(math.checked_mul_i64(3037000500, 3037000500).is_err() && math.checked_add_i64(40, 2).unwrap_or(0) == 42)\n" +
        "    max_usize := usize(0).wrapping_sub(usize(1))\n" +
        "    assert(math.checked_add_usize(max_usize, usize(1)).is_err() && math.checked_sub_usize(usize(1), usize(2)).is_err())\n" +
        "    assert(math.checked_mul_usize(max_usize, usize(2)).is_err() && math.checked_div_usize(usize(9), usize(0)).is_err())\n"
    mut out: []u8 = []
    bytes.append_utf8(&mut out, prefix)
    for base in [0.125, 0.71, 0.9999999999999999, 1.0000000000000002, 1.1, 1.3408185199631601, 1.4142135623730951, 2.25, 17.0] {
        for exponent in [-1985.8023591679957, -1075.0, -97.25, -1.5, 0.01, 1.75, 4.0, 325.5, 1024.0, 4503599627370496.0] {
            expected := reference_power(base, exponent)
            bytes.append_utf8(&mut out, f"    verify_power({base.to_bits()}, {exponent.to_bits()}, {expected.to_bits()})\n")
        }
    }
    bytes.append_utf8(&mut out, f"    angles: [i64; {values.len}] = [\n")
    for word in values {
        bytes.append_utf8(&mut out, "        ")
        bytes.append_decimal(&mut out, word)
        bytes.append_utf8(&mut out, ",\n")
    }
    bytes.append_utf8(&mut out, "    ]\n" +
        "    for word in angles {\n" +
        "        angle := f64.from_bits(word)\n" +
        "        print(math.sin(angle).to_bits())\n" +
        "        print(math.cos(angle).to_bits())\n" +
        "        print(math.tan(angle).to_bits())\n" +
        "        print(math.atan2(angle, 1.0).to_bits())\n" +
        "        print(math.exp(angle).to_bits())\n" +
        "        print(math.log(angle.abs()).to_bits())\n" +
        "        print(math.pow(angle.abs(), 1.75).to_bits())\n" +
        "    }\n" +
        "}\n" +
        "fn verify_power(x: i64, y: i64, expected: i64) {\n" +
        "    actual := math.pow(f64.from_bits(x), f64.from_bits(y)).to_bits()\n" +
        "    assert((actual - expected).abs() <= 8)\n" +
        "}\n")
    out
}

fn reference(x: f64) -> [i64; 7] {
    unsafe {
        if target_is("macos") {
            [macos_sin(x).to_bits(), macos_cos(x).to_bits(), macos_tan(x).to_bits(), macos_atan2(x, 1.0).to_bits(),
                macos_exp(x).to_bits(), macos_log(x.abs()).to_bits(), macos_pow(x.abs(), 1.75).to_bits()]
        } else {
            [linux_sin(x).to_bits(), linux_cos(x).to_bits(), linux_tan(x).to_bits(), linux_atan2(x, 1.0).to_bits(),
                linux_exp(x).to_bits(), linux_log(x.abs()).to_bits(), linux_pow(x.abs(), 1.75).to_bits()]
        }
    }
}

fn validate(output: string, values: &[]i64, target: string, mode: string) -> bool {
    results := harness.lines(output)
    functions := ["sin", "cos", "tan", "atan2(y, 1)", "exp", "log(abs(x))", "pow(abs(x), 1.75)"]
    if results.len != functions.len * values.len {
        return harness.fail(f"{target} {mode}: expected {functions.len * values.len} bit patterns, got {results.len}")
    }
    mut maxima: [i64; 7] = [0; 7]
    for i in 0..values.len {
        angle := f64.from_bits(values[i])
        expected := reference(angle)
        for f in 0..functions.len {
            parsed := parse.integer(results[functions.len * i + f])
            if !parsed.ok { return harness.fail(f"{target} {mode}: invalid result for {functions[f]}({angle})") }
            actual := parsed.value
            wanted := expected[f]
            if (actual < 0) != (wanted < 0) {
                return harness.fail(f"{target} {mode}: {functions[f]}({angle}) returned bits {actual}, expected {wanted}")
            }
            distance := if actual >= wanted { actual - wanted } else { wanted - actual }
            if distance > 8 {
                return harness.fail(f"{target} {mode}: {functions[f]}({angle}) differed by {distance} ULPs, got bits {actual}, expected {wanted}")
            }
            if distance > maxima[f] { maxima[f] = distance }
        }
    }
    print(f"{target} {mode}: {values.len} inputs, peak ULP for sin/cos/tan/atan2/exp/log/pow [{maxima[0]}, {maxima[1]}, {maxima[2]}, {maxima[3]}, {maxima[4]}, {maxima[5]}, {maxima[6]}]")
    true
}

fn run_suite(compiler: string, work: string, host: string) -> bool {
    values := angles()
    source := work + "/math_cases.ddr"
    program := source_program(&values)
    if !sys.write_u8(source, &program).ok { return harness.fail(f"cannot write {source}") }
    wasm := "const fs = require('node:fs'); " +
        "const module = new WebAssembly.Module(fs.readFileSync(process.argv[1])); " +
        "const instance = new WebAssembly.Instance(module, {dunder: {print_i64: value => console.log(value.toString())}}); " +
        "instance.exports.main();"
    mut output := harness.empty_output()
    for target in ["arm64-macos", "arm64-linux", "x86_64-linux", "wasm32"] {
        image := work + "/" + target
        for mode in ["default", "direct"] {
            mut args: []string = ["build", source.clone(), "--target", target.clone(), "-o", image.clone()]
            if mode == "direct" { args.push("--mir=off"); args.push("--scalar-opt=off") }
            if !harness.run_checked_timeout(compiler, args, work, 0, false, 120000, &mut output) { return false }
            if target == host {
                if !harness.run_checked_timeout(image, [], work, 0, false, 120000, &mut output) { return false }
            } else if target == "wasm32" {
                if !harness.run_checked_timeout("node", ["-e", wasm.clone(), image.clone()], work, 0, false, 120000, &mut output) { return false }
            } else { continue }
            if !validate(output.stdout_text(), &values, target, mode) { return false }
        }
    }
    true
}

fn main() -> i32 {
    spec: []cli.Option = []
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_math COMPILER")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    host := process.host_target()
    if host.len == 0 { _ := harness.fail("unsupported native host"); return 2 }
    temp := fs.temp_dir("dunder-math-")
    if !temp.ok { _ := harness.fail("cannot create math test directory"); return 1 }
    work := temp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(compiler, work, host) { 0 } else { 1 }
}
