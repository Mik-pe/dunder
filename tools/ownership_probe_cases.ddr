pub fn local_types() -> string { "\nstruct Pair { left: []i32, right: []i32, number: i32, text: string }\nstruct Outer { pair: Pair, tail: []i32 }\nfn pair() -> Pair { Pair { left: [20, 22], right: [7], number: 42, text: \"dunder\" } }\nfn sum(values: &[]i32) -> i32 {\n    mut result := 0\n    for value in values { result += value }\n    result\n}\nfn read(value: &i32) -> i32 { value }\nfn text_length(value: &string) -> i32 { value.len }\n" }

pub fn local_rejections() -> [](string, string, string) {
    [
        ("move-owner", "fn main(){v:=pair();r:=&v.left;moved:=v;print(sum(r))}", "borrow"),
        ("move-field", "fn main(){v:=pair();r:=&v.left;moved:=v.left;print(sum(r))}", "borrow"),
        ("move-nested-parent", "fn main(){v:=Outer{pair:pair(),tail:[7]};r:=&v.pair.left;moved:=v.pair;print(sum(r))}", "borrow"),
        ("replace-owner", "fn main(){mut v:=pair();r:=&v.left;old:=replace(&mut v,pair());print(sum(r))}", "borrow"),
        ("replace-field", "fn main(){mut v:=pair();r:=&v.left;old:=replace(&mut v.left,[42]);print(sum(r))}", "borrow"),
        ("write-field", "fn main(){mut v:=pair();r:=&v.left;v.left=[42];print(sum(r))}", "borrow"),
        ("write-element", "fn main(){mut v:[]i32=[20,22];r:=&v[0];v[0]=21;print(r)}", "borrow"),
        ("write-other-element", "fn main(){mut v:[]i32=[20,22];r:=&v[0];v[1]=21;print(r)}", "borrow"),
        ("grow-owner", "fn main(){mut v:[]i32=[20,22];r:=&v[0..1];v.reserve(64);print(sum(r))}", "borrow"),
        ("pop-owner", "fn main(){mut v:[]i32=[20,22];r:=&v[0];old:=v.pop();print(r)}", "borrow"),
        ("mut-call", "fn write(v:&mut Pair){v.left=[42]} fn main(){mut v:=pair();r:=&v.left;write(&mut v);print(sum(r))}", "borrow"),
        ("mutable-alias", "fn main(){mut v:[]i32=[20,22];r:=&v;old:=replace(&mut r,[42])}", "mut"),
        ("alias-chain", "fn main(){mut v:[]i32=[20,22];r:=&v;s:=&r;v[0]=42;print(sum(s))}", "borrow"),
        ("lexical-after-last-read", "fn main(){mut v:[]i32=[42];r:=&v;print(sum(r));v[0]=7}", "borrow"),
        ("outer-loan-in-branch", "fn bad(flag:bool){mut v:[]i32=[42];r:=&v;if flag{v[0]=7};print(sum(r))} fn main(){}", "borrow"),
        ("outer-loan-in-loop", "fn main(){mut v:[]i32=[42];r:=&v;for i in 0..2{v[0]=i};print(sum(r))}", "borrow"),
        ("deferred-loan", "fn main(){mut v:[]i32=[42];r:=&v;defer{print(sum(r))};v[0]=7}", "borrow"),
        ("view-argument-mutation", "fn reset(v:&mut []i32)->i32{v=[99];0} fn take(v:&[]i32,n:i32)->i32{v[0]+n} fn main(){mut v:[]i32=[42];print(take(&v[0..1],reset(&mut v)))}", "borrow"),
        ("view-argument-move", "fn size(move v:[]i32)->i32{v.len} fn take(v:&[]i32,n:i32)->i32{v[0]+n} fn main(){v:[]i32=[42];print(take(&v[0..1],size(move v)))}", "borrow"),
        ("view-mutable-argument-first", "fn take(a:&mut []i32,b:&[]i32){} fn main(){mut v:[]i32=[42];take(&mut v,&v[0..1])}", "borrow"),
        ("view-mutable-argument-last", "fn take(a:&[]i32,b:&mut []i32){} fn main(){mut v:[]i32=[42];take(&v[0..1],&mut v)}", "borrow"),
        ("bound-mutates-source", "fn reset(v:&mut []i32)->i32{v=[99];0} fn main(){mut v:[]i32=[42];r:=&v[reset(&mut v)..1];print(sum(r))}", "borrow"),
        ("dynamic-bound-provenance", "fn lower(trace:&mut i32)->i32{trace+=1;0} fn main(){mut v:[]i32=[42];mut trace:=0;r:=&v[lower(&mut trace)..1];v[0]=7;print(sum(r))}", "borrow"),
        ("local-temporary-array", "fn main(){r:=&[20,22];print(sum(r))}", "borrow"),
        ("local-temporary-call", "fn fresh()->[]i32{[20,22]} fn main(){r:=&fresh();print(sum(r))}", "borrow"),
        ("local-mutable-reference", "fn main(){mut v:[]i32=[42];r:=&mut v;print(sum(r))}", "borrow"),
        ("return-reference-to-local", "fn bad(v:&i32)->&i32{local:=v+1;&local} fn main(){}", "returned borrow must come from its declared shared parameter"),
        ("return-borrowed-owner", "fn bad(v:[]i32)->[]i32{r:=&v;r} fn main(){}", "borrow"),
        ("return-borrowed-view", "fn bad(v:[]i32)->[]i32{r:=&v[0..v.len];r} fn main(){}", "borrow"),
        ("reference-field", "struct Bad{value:&i32} fn main(){}", "borrow"),
        ("reference-payload", "enum Bad{Value(&i32),Empty} fn main(){}", "payload"),
        ("reference-array", "fn main(){v:=42;items:[]&i32=[&v]}", "array elements must be storable values"),
        ("raw-exposing-callee", "fn expose(v:&[]i32)->ptr{unsafe{addr(&v[0])}} fn main(){v:[]i32=[42];r:=&v[0..1];p:=expose(r)}", "scoped borrow reaches a raw address"),
        ("raw-exposing-indirect", "fn expose(v:&i32)->ptr{unsafe{addr(&v)}} fn relay(f:fn(&i32)->ptr,v:&i32)->ptr{f(v)} fn main(){v:=42;r:=&v;p:=relay(expose,r)}", "scoped borrow reaches a raw address"),
    ]
}

pub fn local_faults() -> [](string, string, i32, string) {
    [
        ("array-negative-start", "values:[]i32=[42];r:=&values[-1..1];print(sum(r))", 103, ""),
        ("array-negative-end", "values:[]i32=[42];r:=&values[0..-1];print(sum(r))", 103, ""),
        ("array-reversed", "values:[]i32=[20,22];r:=&values[2..1];print(sum(r))", 103, ""),
        ("array-past-end", "values:[]i32=[42];r:=&values[0..2];print(sum(r))", 103, ""),
        ("text-past-end-before-unicode", "text:=\"å\";r:=&text[1..3];print(r.len)", 103, ""),
        ("text-start-boundary", "text:=\"å🌍\";r:=&text[1..6];print(r.len)", 106, ""),
        ("text-end-boundary", "text:=\"å🌍\";r:=&text[0..3];print(r.len)", 106, ""),
        ("text-empty-boundary", "text:=\"å\";r:=&text[1..1];print(r.len)", 106, ""),
        ("endpoints-before-call", "values:[]i32=[42];print(sum(&values[first()..last()]))", 103, "1\n2\n"),
    ]
}

pub fn task_rejections() -> [](string, string) {
    [
        ("await-owned-escape", "capability unsafe\nfn worker(n: i32) -> []i32 { [n] }\nfn expose(values: &[]i32) -> ptr { unsafe { addr(&values[0]) } }\nfn main() { task scope jobs(1) {\n    key := spawn jobs worker(42)\n    leaked := expose(&await! jobs(key))\n} }\n"),
        ("await-scalar-escape", "capability unsafe\nfn worker(n: i32) -> i32 { n }\nfn expose(value: &i32) -> ptr { unsafe { addr(&value) } }\nfn main() { task scope jobs(1) {\n    key := spawn jobs worker(42)\n    leaked := expose(&await jobs(key))\n} }\n"),
        ("spawn-key-escape", "capability unsafe\nfn worker(n: i32) -> i32 { n }\nfn expose(value: &TaskID<i32>) -> ptr { unsafe { addr(&value) } }\nfn main() { task scope jobs(1) {\n    leaked := expose(&spawn jobs worker(42))\n} }\n"),
    ]
}

pub fn partial_types() -> string { "\nstruct Pair { first: []i32, second: []i32, label: string }\nstruct Nested { pair: Pair, extra: []i32 }\n@resource struct Handle { identity: i32 }\nenum Payload { Numbers([]i32), Empty }\nstruct Mixed { payload: Payload, handle: Handle, tail: string }\nfn pair(a: i32, b: i32) -> Pair {\n    Pair { first: [a], second: [b], label: 42.str() }\n}\nfn total(value: Pair) -> i32 { value.first[0] + value.second[0] }\n" }

pub fn partial_rejections() -> [](string, string, string) {
    [
        ("field-twice", "fn main(){v:=pair(20,22);a:=v.first;b:=v.first}", "moved value"),
        ("whole-read", "fn main(){v:=pair(20,22);a:=v.first;print(total(v))}", "moved value"),
        ("whole-move", "fn main(){v:=pair(20,22);a:=v.first;b:=v}", "moved value"),
        ("whole-clone", "fn main(){v:=pair(20,22);a:=v.first;b:=v.clone()}", "moved value"),
        ("nested-parent", "fn main(){v:=Nested{pair:pair(20,22),extra:[7]};a:=v.pair.first;b:=v.pair}", "moved value"),
        ("moved-parent", "fn main(){v:=Nested{pair:pair(20,22),extra:[7]};a:=v.pair;b:=v.pair.first}", "moved value"),
        ("branch-field", "fn bad(flag:bool){v:=pair(20,22);if flag{a:=v.first};print(v.first[0])} fn main(){}", "moved value"),
        ("branch-whole", "fn bad(flag:bool){v:=pair(20,22);if flag{a:=v.first}else{b:=v.second};print(total(v))} fn main(){}", "moved value"),
        ("loop-new-field", "fn main(){v:=pair(20,22);for i in 0..2{a:=v.first}}", "moved value"),
        ("loop-new-nested", "fn main(){v:=Nested{pair:pair(20,22),extra:[7]};for i in 0..2{a:=v.pair.first}}", "moved value"),
        ("loop-partial-entry", "fn main(){v:=pair(20,22);a:=v.first;for i in 0..2{b:=v.second}}", "moved value"),
        ("continue-field", "fn main(){v:=pair(20,22);for i in 0..2{a:=v.first;continue}}", "moved value"),
        ("break-field", "fn main(){v:=pair(20,22);for i in 0..2{a:=v.first;break};print(v.first[0])}", "moved value"),
        ("borrowed-field", "fn bad(v:Pair)->[]i32{v.first} fn main(){}", "borrowed"),
        ("borrowed-mut-field", "fn bad(v:&mut Pair)->[]i32{v.first} fn main(){}", "borrowed"),
        ("defer-root", "fn main(){v:=pair(20,22);defer{print(v.second[0])};a:=v.first}", "captured by defer"),
        ("field-readonly", "fn main(){v:=pair(20,22);a:=v.first;v.first=[42]}", "mutable"),
        ("replace-readonly", "fn main(){v:[]i32=[42];old:=replace(&mut v,[7])}", "mut"),
        ("replace-shared", "fn bad(v:[]i32){old:=replace(&mut v,[7])} fn main(){}", "mut"),
        ("replace-type", "fn main(){mut v:[]i32=[42];old:=replace(&mut v,true)}", "type mismatch"),
        ("replace-explicit-move", "fn main(){mut a:[]i32=[42];b:[]i32=[7];old:=replace(&mut a,b)}", "move"),
        ("replace-borrowed-owner", "fn bad(a:[]i32,b:&mut []i32){old:=replace(&mut b,move a)} fn main(){}", "borrowed"),
        ("replace-moved-field", "fn main(){mut v:=pair(20,22);a:=v.first;old:=replace(&mut v.first,[7])}", "moved value"),
        ("replace-self-move", "fn main(){mut v:[]i32=[42];old:=replace(&mut v,move v)}", "borrow"),
        ("replace-root-move", "fn main(){mut v:=pair(20,22);old:=replace(&mut v.first,move v.second)}", "borrow"),
        ("replace-root-mutation", "fn change(v:&mut Pair)->[]i32{v.first=[1];[2]} fn main(){mut v:=pair(20,22);old:=replace(&mut v.first,change(&mut v))}", "borrow"),
        ("replace-argument-alias", "fn read(v:[]i32,n:i32)->i32{v[0]} fn main(){mut v:[]i32=[42];print(read(v,replace(&mut v,[7]).len))}", "borrowed by another argument"),
        ("replace-iterated", "fn main(){mut v:[]string=[\"a\"];for x in v{old:=replace(&mut v[0],\"b\")}}", "iterating"),
        ("replace-region", "fn main(){region area(64){mut v:[]i32=area.alloc(1);old:=replace(&mut v,[])}}", "region-backed"),
        ("replace-region-element", "fn main(){region area(64){mut v:[]i32=area.alloc(1);old:=replace(&mut v[0],7)}}", "region-backed"),
    ]
}

pub fn returned_helpers() -> string { "\nfn make_fields() -> views.Fields { views.Fields { data: [1, 2, 3], spare: [4], number: 5 } }\nfn combine(a: &[]i32, b: i32) -> i32 { a[0] + b }\nfn size(move v: []i32) -> i32 { v.len }\nfn reset(v: &mut []i32) -> i32 { v = [7]; 0 }\nfn write(v: &mut []i32, a: &[]i32) { v = [a[0]] }\nfn expose(v: &[]i32) -> ptr { unsafe { addr(&v[0]) } }\nfn observe(v: &[]i32) -> &[]i32 { unsafe { p := addr(&v[0]) }; v }\nstruct Box { v: []i32 }\nimpl Box { fn observe(&self) -> &[]i32 { unsafe { p := addr(&self.v[0]) }; &self.v } }\nfn identity(v: &[]i32) -> &[]i32 { v }\n" }

pub fn returned_declarations() -> [](string, string, string) {
    [
        ("local-owner", "fn bad(src: &i32) -> &i32 { local := src + 1; &local }", "returned borrow must come from its declared shared parameter"),
        ("local-alias", "fn bad(src: &[]i32) -> &[]i32 {\n        local := src.clone()\n        a := &local[0..local.len]\n        return a\n    }", "returned borrow must come from its declared shared parameter"),
        ("local-forward", "fn bad(src: &[]i32) -> &[]i32 {\n        local := src.clone()\n        return views.window(local, 0, 1)\n    }", "returned borrow must come from its declared shared parameter"),
        ("temporary-forward", "fn bad(src: &[]i32) -> &[]i32 {\n        return views.window(src.clone(), 0, 1)\n    }", "returned borrow must come from its declared shared parameter"),
        ("region-storage", "fn bad(src: &[]i32) -> &[]i32 {\n        region scratch(16) {\n            mut v: []i32 = scratch.alloc(1)\n            return views.window(&v, 0, 1)\n        }\n        return src\n    }", "returned borrow must come from its declared shared parameter"),
        ("raw-reference", "unsafe fn bad(src: &i32, p: ptr) -> &i32 { return ref_at(p) }", "returned borrow must come from its declared shared parameter"),
        ("widened-string-byte", "fn id(n: &i32) -> &i32 { n }\n    fn bad(text: &string) -> &i32 { id(text[0]) }", "returned borrow must come from its declared shared parameter"),
        ("different-source", "fn bad(a: &[]i32, b: &[]i32) -> &[]i32 from a { return b }", "returned borrow must come from its declared shared parameter"),
        ("different-index-source", "fn bad(a: &[]i32, b: &[]i32) -> &i32 from a {\n        return &b[a[0]]\n    }", "returned borrow must come from its declared shared parameter"),
        ("different-call-source", "fn bad(a: &[]i32, b: &[]i32) -> &[]i32 from a {\n        return views.prefer(b, a)\n    }", "returned borrow must come from its declared shared parameter"),
        ("different-branch-source", "fn bad(a: &[]i32, b: &[]i32, yes: bool) -> &[]i32 from a {\n        return if yes { &b[0..1] } else { &a[0..1] }\n    }", "returned borrow must come from its declared shared parameter"),
        ("different-match-source", "fn bad(a: &[]i32, b: &[]i32, s: views.Side) -> &[]i32 from a {\n        return match s { .Back => a, .Front => { nested := &b[0..1]; nested } }\n    }", "returned borrow must come from its declared shared parameter"),
        ("different-method-source", "struct Pair { data: []i32 }\n    impl Pair {\n        fn bad(&self, other: &Pair) -> &[]i32 from self { &other.data }\n    }", "returned borrow must come from its declared shared parameter"),
        ("missing-source", "fn bad() -> &i32 { local := 42; &local }", "requires a shared input"),
        ("ambiguous", "fn bad(a: &i32, b: &i32) -> &i32 { a }", "ambiguous returned borrow"),
        ("unknown-source", "fn bad(a: &i32) -> &i32 from missing { a }", "unknown returned borrow source"),
        ("moved-source", "fn bad(a: &[]i32, move b: []i32) -> &[]i32 from b { &b }", "requires a shared input"),
        ("exclusive-source", "fn bad(a: &i32, b: &mut i32) -> &i32 from b { &b }", "requires a shared input"),
        ("mutable-result", "fn bad(a: &mut i32) -> &mut i32 { &mut a }", "cannot return a mutable borrow"),
        ("foreign-result", "fn bad(f: extern fn(i32) -> &i32) {}", "C calls cannot return a Dunder borrow"),
        ("callback-source-index", "fn bad(f: fn(&i32, &i32) -> &i32 from 3) {}", "source parameter number is out of range"),
    ]
}

pub fn returned_clients() -> [](string, string, string) {
    [
        ("bound-temporary", "r := views.window([42], 0, 1); print(r[0])", "local borrow requires a named owner"),
        ("bound-temporary-field", "r := views.first(make_fields().data); print(r)", "local borrow requires a named owner"),
        ("mutation", "r := views.first(v); v[0] = 7; print(r)", "borrow"),
        ("reallocation", "r := views.window(v, 0, 1); v.reserve(128); print(r[0])", "borrow"),
        ("transitive-alias", "r := views.window(v, 0, 2); s := views.first(r); v.clear(); print(s)", "borrow"),
        ("move", "r := views.window(v, 0, 1); moved := v; print(r[0])", "borrow"),
        ("replaced-field", "r := views.window(f.data, 0, 1); f.data = [9]; print(r[0])", "borrow"),
        ("replaced-receiver", "r := f.middle(); f = make_fields(); print(r[0])", "borrow"),
        ("moved-parent", "r := views.first(f.data); moved := f; print(r)", "borrow"),
        ("other-argument-moves", "print(combine(views.window(v, 0, 1), size(move v)))", "borrow"),
        ("mut-argument-first", "write(&mut v, views.window(v, 0, 1))", "borrow"),
        ("mut-argument-last", "print(combine(views.window(v, 0, 1), reset(&mut v)))", "borrow"),
        ("index-mutates-source", "print(views.window(v, 0, 1)[reset(&mut v)])", "borrow"),
        ("loop-mutates-source", "for n in views.window(v, 0, 1) { v[0] = n }", "while iterating over it"),
        ("match-replaces-owner", "mut e := views.Envelope { message: .Text(\"dunder\") }\n    match views.envelope(e).message {\n        .Text(s) => { e = views.Envelope { message: .Empty }; print(s.len) },\n        .Empty => {},\n    }", "while iterating"),
        ("captured-in-defer", "r := views.first(v); defer { print(r) }; v[0] = 7", "borrow"),
        ("mismatched-signature", "choose: fn(&[]i32, &[]i32) -> &[]i32 from 2 = views.prefer", "type mismatch"),
        ("raw-through-return", "p := expose(views.window(v, 0, 1))", "scoped borrow reaches a raw address"),
        ("raw-through-temporary", "print(observe(make_fields().data).len)", "scoped borrow reaches a raw address"),
        ("raw-through-temporary-receiver", "print(Box { v: [42] }.observe().len)", "scoped borrow reaches a raw address"),
        ("task-result", "task scope jobs(1) { key := spawn jobs identity(v) }", "returned borrow"),
    ]
}

pub fn returned_faults() -> [](string, i32, string) {
    [
        ("order", 103, "1\n2\n"),
        ("reversed", 103, ""),
        ("past", 103, ""),
        ("utf8-start", 106, ""),
        ("utf8-end", 106, ""),
        ("utf8-empty", 106, ""),
        ("bounds-first", 103, ""),
    ]
}
