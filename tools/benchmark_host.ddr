capability filesystem, process

import .benchmark_commands as bench
import .harness as harness
import .native_probe as native
import .report_json as report
import std.json as json
import std.text as text
import sys

pub struct Host {
    parts: []string,
    hardware: string,
    has_hardware: bool,
    memory: string,
    revision: string,
    status: string,
}

pub fn host() -> Host {
    Host { parts: [], hardware: "", has_hardware: false, memory: "", revision: "", status: "" }
}

fn metadata_command(commands: &mut bench.Commands, argv: []string, output: &mut string) -> bool {
    mut result := harness.empty_output()
    mut ignored: i64 = 0
    if !commands.run(argv, true, false, &mut result, &mut ignored) { return false }
    output = report.text_output(&result.stdout)
    true
}

fn uname(commands: &mut bench.Commands, result: &mut Host) -> bool {
    for flag in ["-s", "-n", "-r", "-v", "-m", "-p"] {
        mut output := ""
        if !metadata_command(&mut commands, ["/usr/bin/uname", flag.clone()], &mut output) { return false }
        part := text.trim(output)
        result.parts.push(if flag == "-p" && part == "unknown" { "" } else { part.clone() })
    }
    true
}

pub fn describe(root: string, result: &mut Host) -> bool {
    mut commands := bench.commands(root, 120000)
    uname(&mut commands, &mut result)
}

pub fn collect(root: string, result: &mut Host) -> bool {
    mut commands := bench.commands(root, 120000)
    git := native.find_executable("git")
    if git.len == 0 { return commands.fail("git is needed for benchmark provenance") }
    mut revision := ""
    if !metadata_command(&mut commands, [git.clone(), "rev-parse", "HEAD"], &mut revision) { return false }
    result.revision = text.trim(revision)
    mut status := ""
    if !metadata_command(&mut commands, [git.clone(), "status", "--short"], &mut status) { return false }
    result.status = move status
    if !uname(&mut commands, &mut result) { return false }
    if target_is("macos") {
        mut hardware := ""
        if !metadata_command(&mut commands, ["/usr/sbin/sysctl", "machdep.cpu.brand_string", "hw.memsize"], &mut hardware) { return false }
        result.hardware = move hardware
        result.has_hardware = true
    }
    if target_is("linux") {
        if sys.metadata("/proc/cpuinfo").is_file {
            file := sys.read_text("/proc/cpuinfo")
            if !file.ok { return commands.fail("cannot read /proc/cpuinfo") }
            mut hardware := ""
            for line in text.split(file.value, "\n") {
                if text.starts_with(line, "model name") || text.starts_with(line, "Hardware") {
                    if hardware.len > 0 { hardware += "\n" }
                    hardware += line
                    if hardware.len >= 4096 { hardware = hardware[0..4096]; break }
                }
            }
            result.hardware = move hardware
            result.has_hardware = true
        }
    }
    if sys.metadata("/proc/meminfo").is_file {
        file := sys.read_text("/proc/meminfo")
        if !file.ok { return commands.fail("cannot read /proc/meminfo") }
        end := text.find(file.value, "\n")
        result.memory = if end >= 0 { file.value[0..end] } else { file.value.clone() }
    }
    true
}

impl Host {
    pub fn write(&self, writer: &mut json.Writer) {
        writer.object()
        keys := ["system", "node", "release", "version", "machine", "processor"]
        for i in 0..keys.len { writer.key(keys[i]); writer.string(self.parts[i]) }
        writer.end()
    }
}
