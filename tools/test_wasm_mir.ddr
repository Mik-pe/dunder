capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn structured_probe_source() -> string {
    "fn fib(n: i64) -> i64 {\n" +
    "    if n <= 1 { return n }\n" +
    "    fib(n - 1) + fib(n - 2)\n" +
    "}\n\n" +
    "fn sum_nested(limit: i32) -> i64 {\n" +
    "    mut total: i64 = 0\n" +
    "    mut i := 0\n" +
    "    while i < limit {\n" +
    "        mut j := 0\n" +
    "        while j < 10 {\n" +
    "            j += 1\n" +
    "            if j % 2 == 0 { continue }\n" +
    "            if j > 7 { break }\n" +
    "            total += i64(i * 10 + j)\n" +
    "        }\n" +
    "        i += 1\n" +
    "    }\n" +
    "    total\n" +
    "}\n\n" +
    "fn scalar_mix(a: i32, b: u32, c: u64, d: f64) -> i64 {\n" +
    "    x := i64((a * 7 - 5) / 3 + a % 4)\n" +
    "    bu := b.shl(2).bit_xor(b.shr(1))\n" +
    "    cu := ((c.wrapping_mul(u64(13)) + u64(99)) / u64(7)).bit_xor(c % u64(5))\n" +
    "    f := d * 2.5 + 1.25 - 0.5\n" +
    "    x + i64(bu) + i64(cu % u64(1000)) + i64(f * 4.0)\n" +
    "}\n\n" +
    "fn main() {\n" +
    "    print(fib(9))\n" +
    "    print(sum_nested(6))\n" +
    "    print(scalar_mix(19, u32(11), u64(37), 3.0))\n" +
    "    print(true)\n" +
    "}\n"
}

fn multi_feature_fixture() -> string {
    "import std.bytes as bytes\n" +
    "import std.text as text\n\n" +
    "const BASE_OFFSET: i64 = 1000\n" +
    "const WEIGHTS: [i64; 4] = [3, 5, 7, 11]\n\n" +
    "enum Action {\n" +
    "    Add,\n" +
    "    Scale,\n" +
    "    Mix,\n" +
    "}\n\n" +
    "struct Pair {\n" +
    "    hi: u64,\n" +
    "    lo: i64,\n" +
    "    score: f64,\n" +
    "    tag: Action,\n" +
    "}\n\n" +
    "fn fib(n: i64) -> i64 {\n" +
    "    if n <= 1 { return n }\n" +
    "    fib(n - 1) + fib(n - 2)\n" +
    "}\n\n" +
    "fn apply_action(tag: Action, a: i64, b: i32) -> i64 {\n" +
    "    match tag {\n" +
    "        .Add => a + i64(b),\n" +
    "        .Scale => a * i64(b) + i64(b + 3),\n" +
    "        .Mix => (a - i64(b)) * 2 + BASE_OFFSET,\n" +
    "    }\n" +
    "}\n\n" +
    "fn float_probe(x: f64, y: f32) -> i64 {\n" +
    "    a := x * 1.5 + f64(y) / 2.0\n" +
    "    b := x - f64(y)\n" +
    "    if a > b { i64(a * 10.0) } else { i64(b) }\n" +
    "}\n\n" +
    "fn unsigned_probe(seed: u64) -> u64 {\n" +
    "    mut acc := seed.wrapping_add(u64(42))\n" +
    "    acc = acc.wrapping_mul(u64(17))\n" +
    "    acc = acc.wrapping_sub(u64(9))\n" +
    "    q := (acc + u64(99)) / u64(7)\n" +
    "    r := acc % u64(13)\n" +
    "    if q >= u64(5) { q - u64(3) + r } else { acc }\n" +
    "}\n\n" +
    "fn helper_note(msg: string) -> i32 {\n" +
    "    if text.contains(msg, \"mir\") { 1 } else { 0 }\n" +
    "}\n\n" +
    "fn main() -> i32 {\n" +
    "    mut total: i64 = 0\n" +
    "    defer {\n" +
    "        if total == -999999 { print(\"unreachable\") }\n" +
    "    }\n" +
    "    factor := 3\n" +
    "    closure := fn[factor](v: i64) -> i64 { v * i64(factor) + 7 }\n" +
    "    mut items: []i64 = []\n" +
    "    for i in 0..8 {\n" +
    "        items.push(closure(i64(i)) + WEIGHTS[i % 4])\n" +
    "    }\n" +
    "    mut raw: []u8 = []\n" +
    "    bytes.append_utf8(&mut raw, \"wasm-mir-probe\")\n" +
    "    decoded := bytes.decode(&raw).unwrap()\n" +
    "    mut tag := Action.Add\n" +
    "    for i in 0..items.len {\n" +
    "        if i % 3 == 1 { tag = .Scale }\n" +
    "        else if i % 3 == 2 { tag = .Mix }\n" +
    "        else { tag = .Add }\n" +
    "        p := Pair { hi: unsigned_probe(u64(items[i])), lo: apply_action(tag, items[i], i32(i + 2)), score: f64(i) * 0.25, tag: tag }\n" +
    "        total += i64(p.hi % u64(1000)) + p.lo + float_probe(p.score + 2.5, f32(i + 1))\n" +
    "    }\n" +
    "    total += fib(6) + i64(helper_note(decoded))\n" +
    "    print(total)\n" +
    "    print(decoded)\n" +
    "    print(helper_note(decoded) == 1)\n" +
    "    0\n" +
    "}\n"
}

fn wasm_runner_js() -> string {
    "'use strict';\n" +
    "const assert = require('node:assert/strict');\n" +
    "const fs = require('node:fs');\n" +
    "const bytes = fs.readFileSync(process.argv[2]);\n" +
    "const mode = process.argv[3] || 'run';\n" +
    "const mod = new WebAssembly.Module(bytes);\n" +
    "let instance;\n" +
    "const emit = v => process.stdout.write(String(v) + '\\n');\n" +
    "const host = {\n" +
    "  print_i32: emit,\n" +
    "  print_i64: emit,\n" +
    "  print_u32: v => emit(v >>> 0),\n" +
    "  print_u64: v => emit(BigInt.asUintN(64, v)),\n" +
    "  print_bool: v => emit(v === 0 ? 'false' : 'true'),\n" +
    "  print_rune: v => emit(String.fromCodePoint(v)),\n" +
    "  print_f32: emit,\n" +
    "  print_f64: emit,\n" +
    "  print_string: ptr => {\n" +
    "    const mem = instance.exports.memory.buffer;\n" +
    "    const addr = ptr >>> 0;\n" +
    "    const len = Number(new DataView(mem).getBigUint64(addr, true));\n" +
    "    const slice = new Uint8Array(mem, addr + 8, len);\n" +
    "    emit(new TextDecoder('utf-8', { fatal: true }).decode(slice));\n" +
    "  },\n" +
    "};\n" +
    "instance = new WebAssembly.Instance(mod, { dunder: host });\n" +
    "if (mode === 'trap') {\n" +
    "  assert.throws(() => instance.exports.main(), WebAssembly.RuntimeError);\n" +
    "} else {\n" +
    "  const rc = instance.exports.main();\n" +
    "  assert.ok(rc === undefined || rc === 0, 'unexpected main exit ' + rc);\n" +
    "}\n"
}

fn wasm_inspector_js() -> string {
    "'use strict';\n" +
    "const assert = require('node:assert/strict');\n" +
    "const fs = require('node:fs');\n" +
    "const buf = fs.readFileSync(process.argv[2]);\n" +
    "const mode = process.argv[3] || 'all';\n" +
    "assert.equal(WebAssembly.validate(buf), true, 'WebAssembly.validate failed');\n" +
    "let p = 8;\n" +
    "function uleb() {\n" +
    "  let val = 0, shift = 0;\n" +
    "  while (true) {\n" +
    "    const byte = buf[p++];\n" +
    "    val |= (byte & 0x7f) << shift;\n" +
    "    if ((byte & 0x80) === 0) return val >>> 0;\n" +
    "    shift += 7;\n" +
    "  }\n" +
    "}\n" +
    "function skipLeb() { while ((buf[p++] & 0x80) !== 0) {} }\n" +
    "let codeStart = -1, codeEnd = -1;\n" +
    "while (p < buf.length) {\n" +
    "  const secId = buf[p++];\n" +
    "  const secLen = uleb();\n" +
    "  if (secId === 10) { codeStart = p; codeEnd = p + secLen; break; }\n" +
    "  p += secLen;\n" +
    "}\n" +
    "assert.ok(codeStart >= 0, 'missing Code section');\n" +
    "p = codeStart;\n" +
    "const funcCount = uleb();\n" +
    "let mirFuncs = 0, localOpsGe8 = 0, structuredOps = 0, totalBrTables = 0, mirBrTables = 0;\n" +
    "for (let fi = 0; fi < funcCount; fi++) {\n" +
    "  const bodyLen = uleb();\n" +
    "  const bodyEnd = p + bodyLen;\n" +
    "  const declCount = uleb();\n" +
    "  let i64Locals = 0, i32Locals = 0;\n" +
    "  for (let d = 0; d < declCount; d++) {\n" +
    "    const cnt = uleb();\n" +
    "    const ty = buf[p++];\n" +
    "    if (ty === 0x7e) i64Locals += cnt;\n" +
    "    else if (ty === 0x7f) i32Locals += cnt;\n" +
    "  }\n" +
    "  const isMirStructured = (i32Locals === 0 && i64Locals >= 8);\n" +
    "  if (isMirStructured) mirFuncs++;\n" +
    "  let fnBrTables = 0;\n" +
    "  while (p < bodyEnd) {\n" +
    "    const op = buf[p++];\n" +
    "    if (op === 0x02 || op === 0x03 || op === 0x04) {\n" +
    "      if (op === 0x02 || op === 0x03) structuredOps++;\n" +
    "      skipLeb();\n" +
    "    } else if (op === 0x0c || op === 0x0d || op === 0x10) {\n" +
    "      if (op === 0x0d) structuredOps++;\n" +
    "      skipLeb();\n" +
    "    } else if (op === 0x0e) {\n" +
    "      fnBrTables++;\n" +
    "      const n = uleb();\n" +
    "      for (let k = 0; k <= n; k++) skipLeb();\n" +
    "    } else if (op === 0x11) {\n" +
    "      skipLeb(); skipLeb();\n" +
    "    } else if (op >= 0x20 && op <= 0x24) {\n" +
    "      const idx = uleb();\n" +
    "      if ((op === 0x20 || op === 0x21) && idx >= 8) localOpsGe8++;\n" +
    "    } else if (op >= 0x28 && op <= 0x3e) {\n" +
    "      skipLeb(); skipLeb();\n" +
    "    } else if (op === 0x3f || op === 0x40) {\n" +
    "      skipLeb();\n" +
    "    } else if (op === 0x41 || op === 0x42) {\n" +
    "      skipLeb();\n" +
    "    } else if (op === 0x43) {\n" +
    "      p += 4;\n" +
    "    } else if (op === 0x44) {\n" +
    "      p += 8;\n" +
    "    } else if (op === 0xfc) {\n" +
    "      const sub = uleb();\n" +
    "      if (sub === 10 || sub === 8 || sub === 12) { skipLeb(); skipLeb(); }\n" +
    "      else if (sub === 11) { skipLeb(); }\n" +
    "    }\n" +
    "  }\n" +
    "  assert.equal(p, bodyEnd, 'instruction decode desync in fn #' + fi);\n" +
    "  totalBrTables += fnBrTables;\n" +
    "  if (isMirStructured) mirBrTables += fnBrTables;\n" +
    "}\n" +
    "assert.equal(p, codeEnd, 'code section length mismatch');\n" +
    "assert.ok(mirFuncs > 0, 'expected MIR functions with locals >= 8');\n" +
    "assert.ok(localOpsGe8 > 0, 'expected local.get/local.set >= 8');\n" +
    "if (mode !== 'straight') assert.ok(structuredOps > 0, 'expected block/loop/br_if ops');\n" +
    "assert.equal(mirBrTables, 0, 'MIR structured functions should emit zero br_table');\n" +
    "if (mode === 'all' || mode === 'straight') assert.equal(totalBrTables, 0, 'expected zero br_table across whole module, got ' + totalBrTables);\n"
}

fn check_bytes_equal(a_path: string, b_path: string, label: string) -> bool {
    a := sys.read_u8(a_path)
    b := sys.read_u8(b_path)
    if !a.ok || !b.ok { return harness.fail("cannot read binaries for comparison: " + label) }
    if a.value.len != b.value.len {
        return harness.fail(f"{label}: byte length mismatch ({a.value.len} vs {b.value.len})")
    }
    for i in 0..a.value.len {
        if a.value[i] != b.value[i] {
            return harness.fail(f"{label}: byte mismatch at offset {i}")
        }
    }
    true
}

fn build_wasm(compiler: string, src: string, out: string, jobs: i32, incremental: bool, cwd: string) -> bool {
    mut args: []string = ["build", src.clone(), "--target", "wasm32", "--jobs", jobs.str(), "-o", out.clone()]
    if incremental { args.push("--incremental") }
    mut res := harness.empty_output()
    harness.run_checked(compiler, args, cwd, 0, false, &mut res)
}

fn run_wasm_node(runner_path: string, wasm_path: string, mode: string, out: &mut process.Output) -> bool {
    harness.run_checked("node", [runner_path.clone(), wasm_path.clone(), mode.clone()], "", 0, false, &mut out)
}

fn inspect_wasm_node(inspector_path: string, wasm_path: string, mode: string) -> bool {
    mut out := harness.empty_output()
    harness.run_checked("node", [inspector_path.clone(), wasm_path.clone(), mode.clone()], "", 0, false, &mut out)
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    runner := work + "/run_wasm.js"
    inspector := work + "/inspect_wasm.js"
    if !sys.write_text(runner, wasm_runner_js()).ok { return harness.fail("write runner failed") }
    if !sys.write_text(inspector, wasm_inspector_js()).ok { return harness.fail("write inspector failed") }

    mut out := harness.empty_output()

    // 1. examples/hello.ddr -> validate, zero br_table, exact stdout "42\ntrue\n"
    hello_wasm := work + "/hello.wasm"
    if !build_wasm(cli.compiler, cli.root + "/examples/hello.ddr", hello_wasm, 1, false, cli.root) { return false }
    if !inspect_wasm_node(inspector, hello_wasm, "straight") { return false }
    if !run_wasm_node(runner, hello_wasm, "run", &mut out) { return false }
    if !harness.stdout_is(&out, "42\ntrue\n", "hello wasm32") { return false }

    samples := work + "/samples.wasm"
    if !build_wasm(cli.compiler, cli.root + "/tests/fixtures/ffi/wasm-samples.ddr", samples, 1, false, cli.root) ||
       !run_wasm_node(runner, samples, "run", &mut out) ||
       !harness.stdout_is(&out, "-32768\n", "signed i16 through Wasm callback") { return false }

    // 2. Pure structured-control-flow fixture -> zero br_table across whole module + matches host output
    host := process.host_target()
    s_src := work + "/structured_probe.ddr"
    s_wasm := work + "/structured_probe.wasm"
    s_host := work + "/structured_probe_host"
    if !sys.write_text(s_src, structured_probe_source()).ok { return harness.fail("write structured_probe failed") }
    if !build_wasm(cli.compiler, s_src, s_wasm, 1, false, work) { return false }
    if !inspect_wasm_node(inspector, s_wasm, "all") { return false }
    if !run_wasm_node(runner, s_wasm, "run", &mut out) { return false }
    wasm_s_out := out.stdout_text()
    mut host_out := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", s_src.clone(), "--target", host.clone(), "-o", s_host.clone()], work, 0, false, &mut host_out) { return false }
    if !harness.run_checked(s_host, [], work, 0, false, &mut host_out) { return false }
    if !harness.stdout_is(&host_out, wasm_s_out, "structured_probe wasm32 vs host") { return false }

    // 3. Multi-feature fixture -> j1 == j4 == cold == warm determinism + Node execution + bytecode inspection
    feat_dir := work + "/item-feature"
    if !fs.mkdir_all(feat_dir).ok { return harness.fail("mkdir_all failed") }
    feat_src := feat_dir + "/feature.ddr"
    if !sys.write_text(feat_src, multi_feature_fixture()).ok { return harness.fail("write feature failed") }
    out_j1 := feat_dir + "/out-j1.wasm"
    out_j4 := feat_dir + "/out-j4.wasm"
    out_cold := feat_dir + "/out-cold.wasm"
    out_warm := feat_dir + "/out-warm.wasm"
    out_host := feat_dir + "/out-host"
    if !build_wasm(cli.compiler, feat_src, out_j1, 1, false, feat_dir) { return false }
    if !build_wasm(cli.compiler, feat_src, out_j4, 4, false, feat_dir) { return false }
    if !build_wasm(cli.compiler, feat_src, out_cold, 4, true, feat_dir) { return false }
    if !build_wasm(cli.compiler, feat_src, out_warm, 4, true, feat_dir) { return false }
    if !check_bytes_equal(out_j1, out_j4, "feature j1 vs j4") { return false }
    if !check_bytes_equal(out_j1, out_cold, "feature j1 vs cold-inc") { return false }
    if !check_bytes_equal(out_j1, out_warm, "feature j1 vs warm-inc") { return false }
    if !inspect_wasm_node(inspector, out_j1, "mir") { return false }
    if !run_wasm_node(runner, out_j1, "run", &mut out) { return false }
    wasm_f_out := out.stdout_text()
    if !text.contains(wasm_f_out, "wasm-mir-probe\ntrue\n") {
        return harness.fail("unexpected feature wasm stdout: " + wasm_f_out)
    }
    if !harness.run_checked(cli.compiler, ["build", feat_src.clone(), "--target", host.clone(), "-o", out_host.clone()], feat_dir, 0, false, &mut host_out) { return false }
    if !harness.run_checked(out_host, [], feat_dir, 0, false, &mut host_out) { return false }
    if !harness.stdout_is(&host_out, wasm_f_out, "feature wasm32 vs host") { return false }

    // 4. 4 trap fixtures -> each compiles to wasm32 and traps with WebAssembly.RuntimeError in Node.js
    trap_cases: [](string, string) = [
        ("div_zero", "fn div(a: i64, b: i64) -> i64 { a / b }\nfn main() { print(div(10, 0)) }\n"),
        ("signed_overflow", "fn add(a: i64, b: i64) -> i64 { a + b }\nfn main() { print(add(9223372036854775807, 1)) }\n"),
        ("oob_index", "fn main() { xs: []i64 = [1, 2, 3]; idx := 5; print(xs[idx]) }\n"),
        ("assert_false", "fn main() { x := 3; assert(x == 4) }\n"),
    ]
    for tc in move trap_cases {
        (name, src_code) := tc
        t_src := work + "/trap_" + name + ".ddr"
        t_wasm := work + "/trap_" + name + ".wasm"
        if !sys.write_text(t_src, src_code).ok { return harness.fail("write trap failed: " + name) }
        if !build_wasm(cli.compiler, t_src, t_wasm, 1, false, work) { return false }
        if !run_wasm_node(runner, t_wasm, "trap", &mut out) { return false }
    }

    print("PASS test-wasm-mir: hello, structured_probe, multi-feature (j1==j4==cold==warm, zero br_table, locals>=8), and 4 RuntimeError traps verified")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok {
        _ := sys.eprint(cli.error)
        return 2
    }
    if cli.extra_args.len > 0 {
        _ := sys.eprint("unexpected extra argument: " + cli.extra_args[0])
        return 2
    }
    tmp := fs.temp_dir("dunder-wasm-mir-")
    if !tmp.ok {
        _ := sys.eprint("temp_dir failed")
        return 1
    }
    work := tmp.value
    ok := run_in_work(&cli, work)
    _ := fs.remove_all(work)
    if !ok { return 1 }
    0
}
