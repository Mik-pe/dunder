capability stdio
import std.io
import std.time

struct Sample { wall_ns: i64, deadline_ns: i64, raw_ns: i64 }

fn sample() -> Sample {
    wall := time.unix_now()
    deadline := time.MonotonicClock.Deadline.now_ns()
    raw := time.MonotonicClock.Raw.now_ns()
    assert(deadline >= 0 && raw >= 0)
    Sample { wall_ns: wall.secs * 1000000000 + i64(wall.nanos), deadline_ns: deadline, raw_ns: raw }
}

fn show(label: string, s: &Sample) {
    print(f"{label} wall_ns={s.wall_ns} deadline_ns={s.deadline_ns} raw_ns={s.raw_ns}")
}

fn main() -> i32 {
    print("Put the computer to sleep, wake it, then press Enter.")
    before := sample()
    show("before", &before)
    mut input := io.stdin()
    mut byte: []u8 = []
    if input.read(&mut byte, 1).unwrap() != 1 { return 1 }
    after := sample()
    show("after", &after)
    elapsed := Sample {
        wall_ns: after.wall_ns - before.wall_ns,
        deadline_ns: after.deadline_ns - before.deadline_ns,
        raw_ns: after.raw_ns - before.raw_ns,
    }
    show("elapsed", &elapsed)
    0
}
