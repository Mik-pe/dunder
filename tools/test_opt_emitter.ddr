capability process, filesystem

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import sys

struct Case {
    name: string,
    code: string,
    ret: i32,
    first: i32,
    parameters: [i64; 8],
    value: i64,
    status: i32,
    length: i32,
}

fn parameters(a: i64, b: i64, c: i64) -> [i64; 8] {
    [a, b, c, 13, 17, 19, 23, 29]
}

fn test_case(name: string, code: string, ret: i32, first: i32, args: [i64; 8], value: i64, status: i32, length: i32) -> Case {
    Case { name: name.clone(), code: code.clone(), ret: ret, first: first, parameters: args.clone(), value: value, status: status, length: length }
}

fn pressure(in_loop: bool) -> string {
    mut code := "{"
    for i in 0..40 { code = code + f"a{i}:i64={i + 1};" }
    if in_loop {
        code = code + "mut total:i64=0;for i in 0..3{total=total"
        for i in 0..40 { code = code + f"+a{i}" }
        code = code + "};total+"
    }
    code = code + "p0"
    for i in 1..8 { code = code + f"+p{i}" }
    if !in_loop {
        for i in 0..40 { code = code + f"+a{i}" }
    }
    code + "}"
}

fn all_cases() -> []Case {
    standard := parameters(5, 7, 11)
    mut weighted := "p0[0]*1"
    for i in 1..8 { weighted = weighted + f"+p0[{i}]*{i + 1}" }
    [
        test_case("params", "{p4+p0+p7}", 2, 2, standard, 51, 0, 8),
        test_case("i32_sign", "{p0}", 1, 1, parameters(4294967295, 7, 11), -1, 0, 8),
        test_case("nested", "{(p0+p1)*(p2-p3)+p7}", 2, 2, standard, 5, 0, 8),
        test_case("if_then", "{mut answer:i64=0;if p0<p1{answer=p2}else{answer=p3};answer}", 2, 2, standard, 11, 0, 8),
        test_case("if_else", "{mut answer:i64=0;if p0>p1{answer=p2}else{answer=p3};answer}", 2, 2, standard, 13, 0, 8),
        test_case("loop", "{mut i:=0;mut result:i64=0;while i<10{result=result+3;i=i+1};result}", 2, 2, standard, 30, 0, 8),
        test_case("flow", "{mut i:=0;mut result:=0;while i<10{i=i+1;if i==2{continue};result=result+i;if i==5{break}};result}", 1, 2, standard, 13, 0, 8),
        test_case("sum", "{mut i:=0;mut result:i64=0;while i<p0.len{result=result+p0[i];i=i+1};result}", 2, 20, standard, 42, 0, 8),
        test_case("empty", "{mut i:=0;mut result:i64=0;while i<p0.len{result=result+p0[i];i=i+1};result}", 2, 20, standard, 0, 0, 0),
        test_case("last", "{p0[p1]}", 2, 20, standard, 6, 0, 8),
        test_case("negative", "{p0[p1]}", 2, 20, parameters(5, -1, 11), 0, 103, 8),
        test_case("upper", "{p0[p1]}", 2, 20, parameters(5, 8, 11), 0, 103, 8),
        test_case("short_and", "{false && p0/p1>0}", 3, 2, parameters(5, 0, 11), 0, 0, 8),
        test_case("short_or", "{true || p0/p1>0}", 3, 2, parameters(5, 0, 11), 1, 0, 8),
        test_case("bool", "{(p0<p1 && p2<p3) || !(p4<p5)}", 3, 2, standard, 1, 0, 8),
        test_case("wide", "{9223372036854775807}", 2, 2, standard, 9223372036854775807, 0, 8),
        test_case("i64_overflow", "{p0+1}", 2, 2, parameters(9223372036854775807, 7, 11), 0, 101, 8),
        test_case("i32_overflow", "{p0+1}", 1, 1, parameters(2147483647, 7, 11), 0, 101, 8),
        test_case("add_signed_width", "{mut v:=p0;v=v-4096;v}", 1, 1, parameters(-1, 7, 11), -4097, 0, 8),
        test_case("add_shifted_rhs", "{mut v:=p0;v=v- -16773120;v}", 2, 2, standard, 16773125, 0, 8),
        test_case("add_shifted_lhs", "{4096+(p0*p1)}", 2, 2, standard, 4131, 0, 8),
        test_case("sub_register_order", "{mut v:=p1;v=(p0*p2)-v;v}", 2, 2, standard, 48, 0, 8),
        test_case("large_negative_fallback", "{p0- -9223372036854775808}", 2, 2, parameters(-3, 7, 11), 9223372036854775805, 0, 8),
        test_case("sub_negative_overflow", "{mut v:=p0;v=v- -4096;v}", 1, 1, parameters(2147483647, 7, 11), 0, 101, 8),
        test_case("add_negative_underflow", "{mut v:=p0;v=v+ -4096;v}", 2, 2, parameters(-9223372036854775808, 7, 11), 0, 101, 8),
        test_case("div_overflow", "{p0/p1}", 2, 2, parameters(-9223372036854775808, -1, 11), 0, 101, 8),
        test_case("rem_overflow", "{p0%p1}", 2, 2, parameters(-9223372036854775808, -1, 11), 0, 101, 8),
        test_case("zero", "{p0/p1}", 2, 2, parameters(5, 0, 11), 0, 102, 8),
        test_case("void", "{mut answer:i64=5;}", 0, 2, standard, 0, 0, 8),
        test_case("bare_return", "{return}", 0, 2, standard, 0, 0, 8),
        test_case("pressure", pressure(false), 2, 2, standard, 944, 0, 8),
        test_case("store_rhs_reads", "{p0[p1]=p0[p1+1]+p0[p1+2];p0[p1]}", 2, 21, parameters(5, 0, 11), 4, 0, 8),
        test_case("store_index", "{p0[p1+1]=p0[p1];p0[p1+1]}", 2, 21, parameters(5, 1, 11), -7, 0, 8),
        test_case("store_lhs_fault_first", "{p0[p1]=p0[0]/p2;0}", 2, 21, parameters(5, -1, 0), 0, 103, 8),
        test_case("store_rhs_zero", "{p0[p1]=p0[0]/p2;0}", 2, 21, parameters(5, 0, 0), 0, 102, 8),
        test_case("store_rhs_bounds", "{p0[p1]=p0[p1+8];0}", 2, 21, parameters(5, 0, 11), 0, 103, 8),
        test_case("store_index_overflow", "{p0[p1+1]=0;0}", 2, 21, parameters(5, 2147483647, 11), 0, 101, 8),
        test_case("store_empty", "{p0[p1]=0;0}", 2, 21, parameters(5, 0, 11), 0, 103, 0),
        test_case("for_signed", "{mut total:=0;for i in -3..4{total=total+i};total}", 1, 2, standard, 0, 0, 8),
        test_case("for_empty", "{mut total:=0;for i in 5..5{total=total+1};total}", 1, 2, standard, 0, 0, 8),
        test_case("for_reversed", "{mut total:=0;for i in 5..2{total=total+1};total}", 1, 2, standard, 0, 0, 8),
        test_case("for_flow", "{mut total:=0;for i in 0..8{if i==2{continue};if i==6{break};total=total+i};total}", 1, 2, standard, 13, 0, 8),
        test_case("for_nested", "{mut total:=0;for i in 0..4{for j in 0..3{if j==1{continue};total=total+i}};total}", 1, 2, standard, 12, 0, 8),
        test_case("for_with_while", "{mut total:=0;for i in 0..4{mut j:=0;while j<3{j=j+1;if j==2{continue};total=total+i};if i==1{continue};total=total+10};total}", 1, 2, standard, 42, 0, 8),
        test_case("for_return", "{for i in 0..4{if i==2{return i}};return -1}", 1, 2, standard, 2, 0, 8),
        test_case("for_max", "{mut total:=0;for i in 2147483646..2147483647{total=total+1};total}", 1, 2, standard, 1, 0, 8),
        test_case("for_min", "{mut total:=0;for i in -2147483648..-2147483647{total=total+1};total}", 1, 2, standard, 1, 0, 8),
        test_case("for_high_snapshot", "{mut high:=4;mut total:=0;for i in 0..high{high=0;total=total+1};total}", 1, 2, standard, 4, 0, 8),
        test_case("for_bound_home_reuse", "{outer:=5;mut total:=0;for i in outer-1..outer{total=total+i};total}", 1, 2, standard, 4, 0, 8),
        test_case("for_shadow_bounds", "{mut i:=5;mut total:=0;for i in i-1..i+1{total=total+i};total+i}", 1, 2, standard, 14, 0, 8),
        test_case("for_low_fault_first", "{for i in (p0+1)..(p0/0){};0}", 2, 1, parameters(2147483647, 7, 11), 0, 101, 8),
        test_case("for_high_fault", "{for i in 5..(p0/0){};0}", 2, 1, standard, 0, 102, 8),
        test_case("for_mutation", "{mut i:=0;for i in 0..p0.len{p0[i]=p0[i]+1};mut total:i64=0;while i<p0.len{total=total+p0[i];i=i+1};total}", 2, 21, standard, 50, 0, 8),
        test_case("for_sort", "{for i in 1..p0.len{value:=p0[i];mut j:=i;while j>0 && p0[j-1]>value{p0[j]=p0[j-1];j=j-1};p0[j]=value};" + weighted + "}", 2, 21, standard, 311, 0, 8),
        test_case("for_reverse", "{for i in 0..4{value:=p0[i];p0[i]=p0[7-i];p0[7-i]=value};" + weighted + "}", 2, 21, standard, 159, 0, 8),
        test_case("for_pressure", pressure(true), 2, 2, standard, 2584, 0, 8),
    ]
}

fn check_case(item: &Case, emitter: string, work: string, host: i32) -> bool {
    source := f"{work}/{item.name}.ddr"
    if !sys.write_text(source, "p0 p1 p2 p3 p4 p5 p6 p7 " + item.code).ok { return harness.fail(f"cannot write {source}") }
    mut result := harness.empty_output()
    for target in 0..3 {
        image := f"{work}/{item.name}-{target}"
        wrapper := image + ".wrapper"
        for mode in ["wrapper", "prepared"] {
            destination := if mode == "wrapper" { wrapper.clone() } else { image.clone() }
            mut args: []string = [source.clone(), destination, target.str(), item.value.str(), item.ret.str(), item.first.str()]
            for arg in item.parameters { args.push(arg.str()) }
            args.push(item.length.str())
            args.push(mode.clone())
            if !harness.run_checked_timeout(emitter, args, "", 0, false, 20000, &mut result) { return false }
        }
        old := sys.read_u8(wrapper)
        new := sys.read_u8(image)
        if !old.ok || !new.ok || !bytes.equal(&old.value, &new.value) {
            return harness.fail(f"{item.name} target {target}: prepared/wrapper image mismatch")
        }
        if target == host && !harness.run_checked_timeout(image, [], "", item.status, false, 10000, &mut result) { return false }
    }
    print(f"PASS {item.name}")
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    emitter := work + "/harness"
    mut result := harness.empty_output()
    if !harness.run_checked_timeout(cli.compiler, ["build", cli.root + "/tests/fixtures/scalar-emitter.ddr", "-o", emitter.clone()], "", 0, false, 60000, &mut result) {
        return false
    }
    host := harness.host_id()
    cases := all_cases()
    for i in 0..cases.len {
        if !check_case(&cases[i], emitter, work, host) { return false }
    }
    print(f"{cases.len} cases native executed; wrapper/prepared images byte-identical on all three targets")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-opt-emitter-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
