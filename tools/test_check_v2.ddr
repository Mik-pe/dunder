// End-to-end test suite for `dunder check --check-v2` (Phase 1 Milestone 1D).
// Verifies that the new HIR + HL-MIR2 pipeline rejects ALL Phase 0 soundness exploits (S-1..S-13)
// plus the two new 1.0 soundness checks (variance/invariance & dropck) and non-lending Iterator,
// accepts ALL 3 usability cliffs (C-1, C-2, C-3) plus valid 1.0 constructs, and supports --agent.

capability process, filesystem

import .harness as harness
import .probe_cli as cli
import std.bytes as bytes
import std.fs as fs
import std.process as process
import std.text as text
import sys

struct CheckJob {
    name: string,
    path: string,
    cwd: string,
    expect_code: i32,
    expected_code: string,
    agent_mode: bool,
}

fn stdlib_corpus_files() -> []string {
    [
        "stdlib/alloc.ddr",
        "stdlib/array.ddr",
        "stdlib/base64.ddr",
        "stdlib/bytes.ddr",
        "stdlib/bytes/utf8.ddr",
        "stdlib/cmp.ddr",
        "stdlib/crypto.ddr",
        "stdlib/dl.ddr",
        "stdlib/ffi.ddr",
        "stdlib/fs.ddr",
        "stdlib/hash.ddr",
        "stdlib/io.ddr",
        "stdlib/json.ddr",
        "stdlib/map.ddr",
        "stdlib/math.ddr",
        "stdlib/net.ddr",
        "stdlib/parse.ddr",
        "stdlib/parse/decimal.ddr",
        "stdlib/path.ddr",
        "stdlib/path/lexical.ddr",
        "stdlib/process.ddr",
        "stdlib/random.ddr",
        "stdlib/set.ddr",
        "stdlib/sha256.ddr",
        "stdlib/signal.ddr",
        "stdlib/sync.ddr",
        "stdlib/sys/winbase.ddr",
        "stdlib/sys/winfs.ddr",
        "stdlib/sys/winpath.ddr",
        "stdlib/sys/winpipe.ddr",
        "stdlib/sys/winprocess.ddr",
        "stdlib/sys/winutf8.ddr",
        "stdlib/terminal.ddr",
        "stdlib/terminal/width.ddr",
        "stdlib/terminal/width_data.ddr",
        "stdlib/text.ddr",
        "stdlib/text/grapheme.ddr",
        "stdlib/text/grapheme_data.ddr",
        "stdlib/text/lowercase_data.ddr",
        "stdlib/text/view.ddr",
        "stdlib/time.ddr",
        "stdlib/toml.ddr",
        "stdlib/toml/tree.ddr",
        "stdlib/toml/values.ddr",
        "stdlib/utf16.ddr",
        "stdlib/wire.ddr",
    ]
}

fn verify_job_result(job: &CheckJob, code: i32, signal: i32, timed_out: bool, stdout_s: string, stderr_s: string) -> bool {
    if timed_out || signal != 0 || code != job.expect_code {
        return harness.fail(f"{job.name}: expected exit {job.expect_code}, got exit {code} (signal {signal}, timed_out {timed_out})\nstdout:\n{stdout_s}\nstderr:\n{stderr_s}")
    }
    combined := stderr_s + stdout_s
    if text.contains(combined, "E9001") {
        return harness.fail(f"{job.name}: check --check-v2 emitted unexpected E9001 mir_verify error\n{combined}")
    }
    if job.expect_code == 1 {
        if job.expected_code.len > 0 && !text.contains(combined, job.expected_code) {
            return harness.fail(f"{job.name}: check --check-v2 diagnostic missing '{job.expected_code}'\n{combined}")
        }
    } else if job.agent_mode {
        if !text.contains(stdout_s, "\"kind\":\"ok\"") && !text.contains(stdout_s, "\"kind\": \"ok\"") {
            return harness.fail(f"{job.name}: check --check-v2 --agent missing ok json:\n{stdout_s}")
        }
    } else {
        if !text.contains(stdout_s, "checked (v2)") {
            return harness.fail(f"{job.name}: expected 'checked (v2)' banner, got:\n{stdout_s}")
        }
    }
    true
}

fn rejected_cases() -> [](string, string, string) {
    [
        // S-1: Option<&mut T> call aliasing
        ("s1_opt_mut_str_alias",
            "fn clash(dst: Option<&mut string>, view: &str) -> i32 { match move dst { .Some(s) => { s = \"replaced\" }, .None => {} }; view.len }\n" +
            "fn main() { mut s := \"hello\" + \" world\"; _ := clash(.Some(&mut s), s.as_str()) }",
            "E4003"),
        ("s1_opt_mut_slice_alias",
            "fn clash(dst: Option<&mut []i32>, view: &[]i32) -> i32 { match move dst { .Some(v) => { v.clear() }, .None => {} }; view.len }\n" +
            "fn main() { mut v: []i32 = [1, 2, 3]; _ := clash(.Some(&mut v), &v[0..2]) }",
            "E4003"),

        // S-2: std.alloc opacity (E2006)
        ("s2_alloc_ownedbuf_opaque",
            "import std.alloc as alloc\n" +
            "fn main() {\n" +
            "    mut b := alloc.OwnedBuf<alloc.Global>::with_capacity(alloc.Global {}, usize(8)).unwrap()\n" +
            "    b.len = usize(4096)\n" +
            "}",
            "E2006"),
        ("s2_alloc_layout_opaque",
            "import std.alloc as alloc\n" +
            "fn main() {\n" +
            "    mut l := alloc.Layout::bytes(usize(8)).unwrap()\n" +
            "    l.size = usize(99)\n" +
            "}",
            "E2006"),

        // S-3: &mut alias intra-expression aliasing
        ("s3_mut_alias_call",
            "fn grow(v: &mut []i32) -> i32 { for i in 0..32 { v.push(i) }; v.len }\n" +
            "fn use_both(a: &i32, b: i32) -> i32 { a + b }\n" +
            "fn bounce(r: &mut []i32) -> i32 { use_both(&r[0], grow(&mut r)) }\n" +
            "fn main() { mut v: []i32 = [10]; _ := bounce(&mut v) }",
            "E4003"),
        ("s3_mut_alias_slice",
            "fn grow(v: &mut []i32) -> i32 { for i in 0..32 { v.push(i) }; 1 }\n" +
            "fn bounce(r: &mut []i32) -> i32 { sl := &r[0..grow(&mut r)]; sl.len }\n" +
            "fn main() { mut v: []i32 = [10, 20]; _ := bounce(&mut v) }",
            "E4003"),
        ("s3_mut_alias_struct",
            "struct Pair { a: &i32, b: i32 }\n" +
            "fn grow(v: &mut []i32) -> i32 { for i in 0..32 { v.push(i) }; v.len }\n" +
            "fn bounce(r: &mut []i32) -> i32 { p := Pair { a: &r[0], b: grow(&mut r) }; p.a + p.b }\n" +
            "fn main() { mut v: []i32 = [10]; _ := bounce(&mut v) }",
            "E4003"),

        // S-4: temporary Iterator with stored borrow
        ("s4_temp_graphemes_uaf",
            "import std.text as text\n" +
            "fn main() {\n" +
            "    mut s := \"alpha\" + \"-beta\"\n" +
            "    for g in text.graphemes(s.as_str()) {\n" +
            "        s = \"overwritten\"\n" +
            "        _ := g.as_str().len\n" +
            "    }\n" +
            "}",
            "E4003"),
        ("s4_temp_custom_iter_uaf",
            "struct Cursor { items: &[]i32, idx: i32 }\n" +
            "impl Iterator for Cursor {\n" +
            "    fn next(&mut self) -> Option<&i32> from self.items {\n" +
            "        if self.idx >= self.items.len { return .None }\n" +
            "        i := self.idx; self.idx += 1\n" +
            "        .Some(&self.items[i])\n" +
            "    }\n" +
            "}\n" +
            "fn scan(xs: &[]i32) -> Cursor from xs { Cursor { items: xs, idx: 0 } }\n" +
            "fn main() {\n" +
            "    mut v: []i32 = [1, 2, 3]\n" +
            "    for x in scan(&v) { v.clear(); _ := x }\n" +
            "}",
            "E4003"),

        // S-5: defer early-exit use-after-move (return / ? / break / continue)
        ("s5_defer_return_uam",
            "fn run(flag: bool) {\n" +
            "    mut s: []i32 = [1, 2, 3]\n" +
            "    _ := move s\n" +
            "    defer { _ := s[0] }\n" +
            "    if flag { return }\n" +
            "    s = [4, 5, 6]\n" +
            "}\n" +
            "fn main() { run(false); run(true) }",
            "E4001"),
        ("s5_defer_try_uam",
            "fn might_fail(yes: bool) -> Result<i32, i32> { if yes { return .Err(1) }; .Ok(0) }\n" +
            "fn run(yes: bool) -> Result<i32, i32> {\n" +
            "    mut s: []i32 = [1, 2, 3]\n" +
            "    _ := move s\n" +
            "    defer { _ := s[0] }\n" +
            "    _ := might_fail(yes)?\n" +
            "    s = [4, 5, 6]\n" +
            "    .Ok(0)\n" +
            "}\n" +
            "fn main() { _ := run(true) }",
            "E4001"),
        ("s5_defer_break_uam",
            "fn main() {\n" +
            "    for i in 0..2 {\n" +
            "        mut s: []i32 = [1, 2, 3]\n" +
            "        _ := move s\n" +
            "        defer { _ := s[0] }\n" +
            "        if i == 0 { break }\n" +
            "        s = [4, 5, 6]\n" +
            "    }\n" +
            "}",
            "E4001"),
        ("s5_defer_continue_uam",
            "fn main() {\n" +
            "    for i in 0..2 {\n" +
            "        mut s: []i32 = [1, 2, 3]\n" +
            "        _ := move s\n" +
            "        defer { _ := s[0] }\n" +
            "        if i == 0 { continue }\n" +
            "        s = [4, 5, 6]\n" +
            "    }\n" +
            "}",
            "E4001"),

        // S-6: &str == / != UAF
        ("s6_str_eq_uaf",
            "fn nuke(s: &mut string) -> &str from s { s = \"other\"; s.as_str() }\n" +
            "fn main() {\n" +
            "    mut s := \"hello\" + \"-world\"\n" +
            "    _ := s.as_str() == nuke(&mut s)\n" +
            "}",
            "E4003"),
        ("s6_str_ne_uaf",
            "fn nuke(s: &mut string) -> &str from s { s = \"other\"; s.as_str() }\n" +
            "fn main() {\n" +
            "    mut s := \"hello\" + \"-world\"\n" +
            "    _ := s.as_str() != nuke(&mut s)\n" +
            "}",
            "E4003"),

        // S-9: @resource(dispose) safe destructuring
        ("s9_destructure_dispose",
            "@resource(dispose)\n" +
            "struct Guard { id: i32 }\n" +
            "impl Guard { fn dispose(&mut self) {} }\n" +
            "fn main() {\n" +
            "    g := Guard { id: 1 }\n" +
            "    Guard { id } := move g\n" +
            "    _ := id\n" +
            "}",
            "E4001"),

        // S-10: Sendable / Sync / Published / task scope shared
        ("s10_safe_sendable_resource",
            "@resource(dispose)\n" +
            "pub opaque struct Res { x: i32 }\n" +
            "impl Res { fn dispose(&mut self) {} }\n" +
            "impl Sendable for Res {}\n" +
            "fn main() {}",
            "E5001"),
        ("s10_safe_sync_resource",
            "@resource(dispose)\n" +
            "pub opaque struct Res { x: i32 }\n" +
            "impl Res { fn dispose(&mut self) {} }\n" +
            "impl Sync for Res {}\n" +
            "fn main() {}",
            "E5001"),
        ("s10_unsafe_impl_needs_cap",
            "@resource(dispose)\n" +
            "pub opaque struct Res { x: i32 }\n" +
            "impl Res { fn dispose(&mut self) {} }\n" +
            "unsafe impl Sendable for Res {}\n" +
            "fn main() {}",
            "E5001"),
        ("s10_published_file_not_sync",
            "capability filesystem\n" +
            "import std.fs as fs\n" +
            "import std.sync as sync\n" +
            "fn bad(move f: fs.File) { _ := sync.Published<fs.File>::new(move f) }\n" +
            "fn main() {}",
            "E5004"),
        ("s10_published_tcp_not_sync",
            "capability network\n" +
            "import std.net as net\n" +
            "import std.sync as sync\n" +
            "fn bad(move s: net.TcpStream) { _ := sync.Published<net.TcpStream>::new(move s) }\n" +
            "fn main() {}",
            "E5004"),
        ("s10_shared_task_not_sync",
            "capability unsafe\n" +
            "@resource(dispose)\n" +
            "pub opaque struct SendOnly { fd: i32 }\n" +
            "impl SendOnly { fn dispose(&mut self) {} }\n" +
            "unsafe impl Sendable for SendOnly {}\n" +
            "struct Wrap { r: SendOnly }\n" +
            "fn worker(n: i32, w: &Wrap) -> i32 { n + w.r.fd }\n" +
            "fn main() {\n" +
            "    w := Wrap { r: SendOnly { fd: 1 } }\n" +
            "    task scope j(1, shared w) { _ := j.spawn(worker, 2) }\n" +
            "}",
            "E5004"),
        ("s10_safe_opaque_ptr_rejected",
            "opaque struct Bad { p: ptr }\n" +
            "impl Sync for Bad {}\n" +
            "fn main() {}",
            "E5004"),

        // S-11: Fn closure capturing non-Clone @resource
        ("s11_fn_captures_resource",
            "@resource(dispose)\n" +
            "struct Token { id: i32 }\n" +
            "impl Token { fn dispose(&mut self) {} }\n" +
            "fn main() {\n" +
            "    t := Token { id: 1 }\n" +
            "    f := fn[t: Token]() -> i32 { t.id }\n" +
            "    f2 := f.clone()\n" +
            "    _ := f() + f2()\n" +
            "}",
            "E3099"),

        // S-12: scratch borrow raw-address escape via closure (E4005)
        ("s12_scratch_closure_escape",
            "capability unsafe\n" +
            "fn main() {\n" +
            "    dummy := 0\n" +
            "    unsafe {\n" +
            "        mut escaped := ptr(0)\n" +
            "        region scratch(256) {\n" +
            "            mut a: []i32 = scratch.alloc(4)\n" +
            "            a[0] = 42\n" +
            "            f := fn[&dummy](p: &i32) -> ptr { unsafe { addr(&p) } }\n" +
            "            escaped = f(&a[0])\n" +
            "        }\n" +
            "        _ := escaped\n" +
            "    }\n" +
            "}",
            "E4005"),

        // S-13: sys.net_close without unsafe
        ("s13_sys_net_close_unsafe",
            "capability network\n" +
            "import sys\n" +
            "fn main() { _ := sys.net_close(1) }",
            "E5001"),

        // Cliff 1 negative control: aliasing through match-moved &mut binding rejected
        ("c1_match_move_mut_alias_rejected",
            "fn clash(a: &mut []i32, b: &[]i32) -> i32 { a.push(1); b.len }\n" +
            "fn main() {\n" +
            "    mut xs: []i32 = [1, 2]\n" +
            "    opt: Option<&mut []i32> = .Some(&mut xs)\n" +
            "    match move opt {\n" +
            "        .Some(m) => { _ := clash(&mut m, &m) },\n" +
            "        .None => {},\n" +
            "    }\n" +
            "}",
            "E4003"),

        // NEW 1.0 Soundness Check 1: Variance/invariance `&mut Holder` smuggling
        ("v10_invariance_mut_holder_smuggling",
            "struct Holder { r: &i32 }\n" +
            "fn main() {\n" +
            "    outer := 1\n" +
            "    mut h := Holder { r: &outer }\n" +
            "    {\n" +
            "        inner := 2\n" +
            "        hm := &mut h\n" +
            "        hm.r = &inner\n" +
            "    }\n" +
            "    _ := h.r\n" +
            "}",
            "E4003"),

        // NEW 1.0 Soundness Check 2: dropck (`@resource(dispose)` holding `&T` outliving target)
        ("v10_dropck_dispose_guard_dangling",
            "@resource(dispose)\n" +
            "struct Guard { r: &i32 }\n" +
            "impl Guard { fn dispose(&mut self) { _ := self.r } }\n" +
            "fn main() {\n" +
            "    a := 1\n" +
            "    mut g := Guard { r: &a }\n" +
            "    b := 2\n" +
            "    g = Guard { r: &b }\n" +
            "}",
            "E4003"),

        // Non-lending Iterator enforcement
        ("v10_lending_iterator_rejected",
            "struct BadIter { items: &[]i32, idx: i32 }\n" +
            "impl Iterator for BadIter {\n" +
            "    fn next(&mut self) -> Option<&i32> from self {\n" +
            "        if self.idx >= self.items.len { return .None }\n" +
            "        .Some(&self.items[self.idx])\n" +
            "    }\n" +
            "}\n" +
            "fn main() {}",
            "E4003"),

        // V2-S1: Mutability enforcement (LF_MUT & `&T` / `&[]T` vs `&mut T`)
        ("v2s1_shared_ref_alias_uaf",
            "fn uaf(a: &[]i32, b: &[]i32) -> i32 {\n" +
            "    a.clear()\n" +
            "    for k in 0..10 { a.push(k) }\n" +
            "    b[0]\n" +
            "}\n" +
            "fn main() { arr: []i32 = [42, 43]; _ := uaf(&arr, &arr) }",
            "E4002"),
        ("v2s1_mutate_immut_local",
            "fn main() { x := 1; x = 2; _ := x }",
            "E4002"),
        ("v2s1_mut_ref_immut_local",
            "fn main() { x := 1; r := &mut x; r = 2; _ := x }",
            "E4002"),
        ("v2s1_write_through_shared_ref",
            "fn bad(x: &i32) { x = 2 }\n" +
            "fn main() { a := 1; bad(&a) }",
            "E4002"),
        ("v2s1_upgrade_shared_to_mut",
            "fn bad(x: &i32) -> &mut i32 from x { &mut x }\n" +
            "fn main() { a := 1; r := bad(&a); r = 2 }",
            "E4002"),
        ("v2s1_return_mut_from_shared_slice",
            "fn bad(a: &[]i32) -> &mut []i32 from a { &mut a }\n" +
            "fn main() { a: []i32 = [1, 2]; r := bad(&a); r.clear() }",
            "E4002"),
        ("v2s1_mutate_immut_field_and_elem",
            "struct S { x: i32 }\n" +
            "fn main() { s := S { x: 1 }; s.x = 2; _ := s.x }",
            "E4002"),
        ("v2s1_mutate_immut_array_elem",
            "fn main() { arr: []i32 = [1, 2]; arr[0] = 99; _ := arr[0] }",
            "E4002"),
        ("v2s1_arr_swap_immut_slice",
            "fn bad(v: &[]i32) { v.swap(0, 1) }\n" +
            "fn main() { arr: []i32 = [1, 2]; bad(&arr) }",
            "E4002"),
        ("v2s1_arr_remove_immut_slice",
            "fn bad(v: &[]i32) -> i32 { v.remove(0) }\n" +
            "fn main() { arr: []i32 = [1, 2]; _ := bad(&arr) }",
            "E4002"),
        ("v2s1_arr_truncate_immut_slice",
            "fn bad(v: &[]i32) { v.truncate(0) }\n" +
            "fn main() { arr: []i32 = [1, 2]; bad(&arr) }",
            "E4002"),
        ("v2s1_arr_swap_immut_local",
            "fn main() { arr: []i32 = [1, 2]; arr.swap(0, 1) }",
            "E4002"),

        // V2-S2: Transitive reborrow chains (&T, &[]T, fields, multi-level &mut, &&[]T)
        ("v2s2_shared_reborrow_chain_uaf",
            "fn main() {\n" +
            "    mut v: []i32 = [42, 43, 44]\n" +
            "    r1 := &v\n" +
            "    p := &r1[0]\n" +
            "    v.clear()\n" +
            "    _ := p\n" +
            "}",
            "E4003"),
        ("v2s2_shared_field_reborrow_uaf",
            "struct Pair { left: []i32, right: []i32 }\n" +
            "fn main() {\n" +
            "    mut pair := Pair { left: [42, 43], right: [1] }\n" +
            "    r1 := &pair\n" +
            "    p := &r1.left\n" +
            "    pair.left.clear()\n" +
            "    _ := p[0]\n" +
            "}",
            "E4003"),
        ("v2s2_subslice_reborrow_uaf",
            "fn main() {\n" +
            "    mut v: []i32 = [42, 43, 44, 45]\n" +
            "    s1 := &v[0..4]\n" +
            "    s2 := &s1[0..2]\n" +
            "    v.clear()\n" +
            "    _ := s2[0]\n" +
            "}",
            "E4003"),
        ("v2s2_mut_reborrow_2level_uaf",
            "fn main() {\n" +
            "    mut v: []i32 = [42, 43, 44]\n" +
            "    r1 := &mut v\n" +
            "    r2 := &mut r1\n" +
            "    p := &r2[0]\n" +
            "    v.clear()\n" +
            "    _ := p\n" +
            "}",
            "E4003"),
        ("v2s2_shared_alias_chain_uaf",
            "fn main() {\n" +
            "    mut v: []i32 = [42, 43, 44]\n" +
            "    r1 := &v\n" +
            "    r2 := &r1\n" +
            "    v.clear()\n" +
            "    _ := r2[0]\n" +
            "}",
            "E4003"),

        // V2-S3: Return `from` contracts & synthetic parameter loans
        ("v2s3_from_wrong_param",
            "fn bad(a: &[]i32, b: &[]i32) -> &[]i32 from a { b }\n" +
            "fn main() { a: []i32 = [1]; b: []i32 = [2]; _ := bad(&a, &b)[0] }",
            "E4003"),
        ("v2s3_return_ambiguous_no_from",
            "fn bad(a: &[]i32, b: &[]i32) -> &[]i32 { b }\n" +
            "fn main() { a: []i32 = [1]; mut b: []i32 = [2]; r := bad(&a, &b); b = [9]; _ := r[0] }",
            "E4003"),
        ("v2s3_from_wrong_field",
            "struct Pair { left: &str, right: &str }\n" +
            "impl Pair { fn wrong(&self) -> &str from self.left { self.right } }\n" +
            "fn main() { a := \"a\" + \"1\"; mut b := \"b\" + \"2\"; p := Pair { left: a.as_str(), right: b.as_str() }; r := p.wrong(); b = \"x\"; _ := r }",
            "E4003"),
        ("v2s3_from_field_returns_owned",
            "struct Mixed { left: &str, owned: string }\n" +
            "impl Mixed { fn wrong(&self) -> &str from self.left { self.owned.as_str() } }\n" +
            "fn main() { a := \"a\" + \"1\"; mut m := Mixed { left: a.as_str(), owned: \"hi\" + \"!\" }; r := m.wrong(); m.owned = \"x\"; _ := r }",
            "E4003"),

        // V2-S4: Reject returning borrows of Copy / by-value parameters
        ("v2s4_return_byval_param_ref",
            "fn bad(x: i32) -> &i32 { &x }\n" +
            "fn main() { _ := bad(42) }",
            "E4003"),
        ("v2s4_return_byval_fixed_arr_ref",
            "fn bad(s: [i32; 4]) -> &i32 { &s[0] }\n" +
            "fn main() { a: [i32; 4] = [1, 2, 3, 4]; _ := bad(a) }",
            "E4003"),

        // V2-S5: `if` expression returning borrows from multiple branches
        ("v2s5_if_two_borrows_mutate_b",
            "fn main() {\n" +
            "    mut a: []i32 = [1, 2]\n" +
            "    mut b: []i32 = [42, 43]\n" +
            "    r := if false { &a[0..2] } else { &b[0..2] }\n" +
            "    b.clear()\n" +
            "    _ := r[0]\n" +
            "}",
            "E4003"),

        // V2-S6: Generic `impl Sendable / Sync` post-monomorphization verification
        ("v2s6_generic_impl_sendable_bypass",
            "@resource(dispose)\n" +
            "struct NotSend { x: i32 }\n" +
            "impl NotSend { fn dispose(&mut self) {} }\n" +
            "pub opaque struct GenericSend<T> { val: T }\n" +
            "impl GenericSend<T> { pub fn new(move v: T) -> Self { Self { val: v } } }\n" +
            "impl Sendable for GenericSend<T> {}\n" +
            "fn worker(move g: GenericSend<NotSend>) -> i32 { 0 }\n" +
            "fn main() {\n" +
            "    g := GenericSend<NotSend>::new(NotSend { x: 42 })\n" +
            "    task scope j(1) { t := j.spawn(worker, move g); _ := t.join() }\n" +
            "}",
            "E5004"),
        ("v2s6_generic_impl_sync_bypass",
            "capability unsafe\n" +
            "@resource(dispose)\n" +
            "pub opaque struct NotSync { x: i32 }\n" +
            "impl NotSync { fn dispose(&mut self) {} }\n" +
            "unsafe impl Sendable for NotSync {}\n" +
            "pub opaque struct GenericWrap<T> { val: T }\n" +
            "impl GenericWrap<T> { pub fn new(move v: T) -> Self { Self { val: v } } }\n" +
            "impl Sendable for GenericWrap<T> where T: Sendable {}\n" +
            "impl Sync for GenericWrap<T> {}\n" +
            "fn worker(i: i32, w: &GenericWrap<NotSync>) -> i32 { i }\n" +
            "fn main() {\n" +
            "    g := GenericWrap<NotSync>::new(NotSync { x: 42 })\n" +
            "    task scope j(2, shared move g) { t := j.spawn(worker, 1); _ := t.join() }\n" +
            "}",
            "E5004"),

        // Lowering regressions (must reject cleanly without E9001)
        ("v2_lower_replace_borrow_escape",
            "struct View { r: &[]i32 }\n" +
            "fn main() {\n" +
            "    a: []i32 = [1, 2]\n" +
            "    mut v := View { r: &a }\n" +
            "    { b: []i32 = [42, 43]; _ := replace(&mut v, View { r: &b }) }\n" +
            "    _ := v.r[0]\n" +
            "}",
            "E4003"),
        ("v2_lower_opt_mut_borrowed_closure",
            "fn clash(move a: Option<&mut []i32>, f: &Fn() -> i32) {\n" +
            "    _ := f()\n" +
            "    match move a { .Some(m) => { m = [1, 2] }, .None => {} }\n" +
            "    _ := f()\n" +
            "}\n" +
            "fn main() { mut arr: []i32 = [42, 43]; clash(.Some(&mut arr), fn[&arr]() -> i32 { arr[0] }) }",
            "E4003"),
        ("v2_lower_opt_mut_generic_fnptr",
            "fn take_opt(move a: Option<&mut string>) { match move a { .Some(m) => { m = \"short\" }, .None => {} } }\n" +
            "fn clash<T>(move a: T, view: &str, f: fn(move T)) { f(move a); _ := view }\n" +
            "fn main() { mut s := \"HELLO_\" + \"WORLD\"; clash<Option<&mut string>>(.Some(&mut s), &s[0..5], take_opt) }",
            "E4003"),
        ("v2_lower_scratch_returned_fn_escape",
            "capability unsafe\n" +
            "fn make_escaper(dummy: i32) -> Fn(&i32) -> ptr {\n" +
            "    fn[dummy: i32](p: &i32) -> ptr { unsafe { addr(&p) } }\n" +
            "}\n" +
            "fn main() {\n" +
            "    unsafe {\n" +
            "        mut escaped := ptr(0)\n" +
            "        region scratch(256) {\n" +
            "            mut a: []i32 = scratch.alloc(4)\n" +
            "            a[0] = 42\n" +
            "            f := make_escaper(0)\n" +
            "            escaped = f(&a[0])\n" +
            "        }\n" +
            "        _ := escaped\n" +
            "    }\n" +
            "}",
            "E4005"),

        // Phase 1b soundness regressions (TwoPhaseMut strictness & builtin mutability)
        ("p1b_two_phase_post_activation_ret_uaf",
            "fn get_mut(v: &mut []i32, n: i32) -> &mut i32 from v { _ := n; &mut v[0] }\n" +
            "fn main() {\n" +
            "    mut v: []i32 = [1, 2]\n" +
            "    r := get_mut(&mut v, v.len)\n" +
            "    _ := v[0]\n" +
            "    _ := r\n" +
            "}",
            "E4003"),
        ("p1b_two_phase_double_mut_arg",
            "fn both(a: &mut []i32, b: &mut []i32) { a.push(1); b.push(2) }\n" +
            "fn main() { mut v: []i32 = [1]; both(&mut v, &mut v) }",
            "E4003"),
        ("p1b_two_phase_mut_and_shared_arg",
            "fn clash(a: &mut []i32, b: &i32) -> i32 { a.clear(); b }\n" +
            "fn main() { mut v: []i32 = [1, 2]; _ := clash(&mut v, &v[0]) }",
            "E4003"),
        ("p1b_two_phase_nested_mut_during_reserve",
            "fn bump(a: &mut []i32, n: i32) { a.push(n) }\n" +
            "fn grow(a: &mut []i32) -> i32 { a.push(9); a.len }\n" +
            "fn main() { mut v: []i32 = [1]; bump(&mut v, grow(&mut v)) }",
            "E4003"),
        ("p1b_immut_map_put_rejected",
            "fn bad(m: &Map<string, i64>) { m.put(\"a\", 1) }\n" +
            "fn main() { m := Map<string, i64>::new(); bad(&m) }",
            "E4002"),
        ("p1b_immut_slice_as_mut_ptr_rejected",
            "capability unsafe\n" +
            "fn bad(s: &[]u8) { unsafe { _ := s.as_mut_ptr() } }\n" +
            "fn main() { a: []u8 = [1, 2]; bad(&a) }",
            "E4002"),
    ]
}

fn accepted_cases() -> [](string, string) {
    [
        // Cliff 1: match move Option<&mut []T> -> m.clear(), m.push(), bump(&mut m)
        ("cliff1_match_move_opt_mut",
            "fn bump(xs: &mut []i32) { xs.push(99) }\n" +
            "fn main() {\n" +
            "    mut xs: []i32 = [1, 2, 3]\n" +
            "    opt: Option<&mut []i32> = .Some(&mut xs)\n" +
            "    match move opt {\n" +
            "        .Some(m) => {\n" +
            "            m.clear()\n" +
            "            m.push(42)\n" +
            "            bump(&mut m)\n" +
            "        },\n" +
            "        .None => {},\n" +
            "    }\n" +
            "    assert(xs.len == 2)\n" +
            "}"),

        // Cliff 2: Struct field name after dead borrow released at last CFG use
        ("cliff2_struct_field_after_dead_borrow",
            "struct Foo { r: i32 }\n" +
            "fn main() {\n" +
            "    mut v: []i32 = [1, 2]\n" +
            "    r := &v[0]\n" +
            "    _ := r\n" +
            "    v.push(3)\n" +
            "    f := Foo { r: 1 }\n" +
            "    _ := f.r\n" +
            "}"),

        // Cliff 3: Disjoint if/else branch (borrow used only in else -> mutation allowed in then!)
        ("cliff3_disjoint_if_else_branch",
            "fn main() {\n" +
            "    mut v: []i32 = [1, 2]\n" +
            "    r := &v[0]\n" +
            "    c := true\n" +
            "    if c {\n" +
            "        v.push(3)\n" +
            "    } else {\n" +
            "        print(r)\n" +
            "    }\n" +
            "}"),

        // Valid `mut r: &i32` rebinding (origin kill unlocks `a` immediately after `r = &b`)
        ("ok_mut_ref_rebinding",
            "fn main() {\n" +
            "    mut a := 1\n" +
            "    b := 2\n" +
            "    mut r := &a\n" +
            "    r = &b\n" +
            "    a = 99\n" +
            "    _ := r\n" +
            "}"),

        // Valid TwoPhaseMut (`v.push(v.len)`)
        ("ok_two_phase_mut_push_len",
            "fn main() {\n" +
            "    mut v: []i32 = [1, 2]\n" +
            "    v.push(v.len)\n" +
            "}"),

        // Valid generics, traits, closures, defer, region, task scope, may_dangle plain view
        ("ok_generics_traits_closures_defer_region_task",
            "pub opaque struct SafeBox { label: string, count: i32 }\n" +
            "impl Sendable for SafeBox {}\n" +
            "impl Sync for SafeBox {}\n" +
            "struct PlainView { r: &i32 }\n" +
            "fn id<T>(x: T) -> T { x }\n" +
            "fn main() {\n" +
            "    a := id(7)\n" +
            "    s := id(\"ok\")\n" +
            "    mut b := 10\n" +
            "    mut pv := PlainView { r: &a }\n" +
            "    pv = PlainView { r: &b }\n" +
            "    f := fn[&a](k: i32) -> i32 { a + k }\n" +
            "    _ := f(3)\n" +
            "    defer { _ := s.len }\n" +
            "    region scratch(128) {\n" +
            "        mut tmp: []i32 = scratch.alloc(4)\n" +
            "        tmp[0] = 1\n" +
            "    }\n" +
            "    box := SafeBox { label: \"x\", count: 1 }\n" +
            "    task scope w(1, shared box) { _ := 1 }\n" +
            "}"),
        // Valid std.sync Published<AtomicI64> (rt4_published_atomic_ok)
        ("ok_rt4_published_atomic_sync",
            "import std.sync as sync\n" +
            "fn reader(move p: sync.Published<sync.AtomicI64>) -> i64 {\n" +
            "    g := p.read()\n" +
            "    g.get().fetch_add(1)\n" +
            "}\n" +
            "fn main() {\n" +
            "    p := sync.Published<sync.AtomicI64>::new(sync.AtomicI64::new(40))\n" +
            "    task scope j(2) {\n" +
            "        a := j.spawn(reader, p.clone_handle())\n" +
            "        b := j.spawn(reader, p.clone_handle())\n" +
            "        _ := a.join() + b.join()\n" +
            "    }\n" +
            "    g := p.read()\n" +
            "    _ := g.get().load()\n" +
            "}"),

        // Phase 1b positive regressions
        ("p1b_ok_free_fn_two_phase_borrow",
            "fn bump(v: &mut []i32, n: i32) { v.push(n) }\n" +
            "fn main() { mut v: []i32 = [1, 2]; bump(&mut v, v.len) }"),
        ("p1b_ok_replace_struct_field",
            "struct BoxS { s: string }\n" +
            "fn main() {\n" +
            "    mut b := BoxS { s: \"old\" + \"!\" }\n" +
            "    old := replace(&mut b.s, \"new\")\n" +
            "    _ := old.len + b.s.len\n" +
            "}"),
        ("p1b_ok_short_circuit_and_move",
            "fn eat(move s: string) { _ := s.len }\n" +
            "fn run(cond: bool) {\n" +
            "    s := \"hi\" + \"!\"\n" +
            "    if cond && { eat(move s); return } {}\n" +
            "    _ := s.len\n" +
            "}\n" +
            "fn main() { run(false) }"),
        ("p1b_ok_match_move_guard_fallthrough",
            "fn main() {\n" +
            "    opt: Option<string> = .Some(\"hello\" + \"!\")\n" +
            "    res := match move opt {\n" +
            "        .Some(s) if s.len > 99 => s,\n" +
            "        .Some(s) => s,\n" +
            "        .None => \"\",\n" +
            "    }\n" +
            "    _ := res.len\n" +
            "}"),
        ("p1b_ok_fnmut_closure_reborrow",
            "import std.array as array\n" +
            "fn main() {\n" +
            "    mut cells: []i32 = [1]\n" +
            "    mut calls := 0\n" +
            "    make := fn[&mut calls]() -> i32 { calls += 1; calls }\n" +
            "    array.resize_with(&mut cells, 4, &mut make)\n" +
            "    array.resize_with(&mut cells, 1, &mut make)\n" +
            "    _ := calls\n" +
            "}"),
        ("p1b_ok_assoc_fn_value",
            "struct Pt { x: i32, y: i32 }\n" +
            "impl Pt {\n" +
            "    fn new(x: i32, y: i32) -> Pt { Pt { x: x, y: y } }\n" +
            "    fn get_x(&self) -> i32 { self.x }\n" +
            "}\n" +
            "fn main() {\n" +
            "    ctor := Pt::new\n" +
            "    p := ctor(4, 6)\n" +
            "    getter := Pt::get_x\n" +
            "    _ := getter(&p)\n" +
            "}"),
    ]
}

fn main() -> i32 {
    spec: []cli.Option = []
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_check_v2 COMPILER")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("could not locate dunder repository root"); return 1 }

    tmp := fs.temp_dir("dunder-check-v2-")
    if !tmp.ok { _ := harness.fail("cannot create check-v2 test directory"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    // Build LPT-ordered job list: heaviest corpus gate (`selfhost/main.ddr`) FIRST so it overlaps with all other checks!
    mut jobs: []CheckJob = []
    jobs.push(CheckJob {
        name: "corpus:selfhost/main.ddr",
        path: f"{root}/selfhost/main.ddr",
        cwd: root.clone(),
        expect_code: 0,
        expected_code: "",
        agent_mode: false,
    })

    stdlib_files := stdlib_corpus_files()
    for i in 0..stdlib_files.len {
        rel := stdlib_files[i].clone()
        jobs.push(CheckJob {
            name: f"corpus:{rel}",
            path: f"{root}/{rel}",
            cwd: root.clone(),
            expect_code: 0,
            expected_code: "",
            agent_mode: false,
        })
    }

    neg := rejected_cases()
    for i in 0..neg.len {
        (name, source, expected_code) := neg[i].clone()
        path := f"{work}/{name}.ddr"
        if !sys.write_text(path, source + "\n").ok { _ := harness.fail(f"cannot write {path}"); return 1 }
        jobs.push(CheckJob {
            name: move name,
            path: move path,
            cwd: work.clone(),
            expect_code: 1,
            expected_code: move expected_code,
            agent_mode: false,
        })
    }

    pos := accepted_cases()
    for i in 0..pos.len {
        (name, source) := pos[i].clone()
        path := f"{work}/{name}.ddr"
        if !sys.write_text(path, source + "\n").ok { _ := harness.fail(f"cannot write {path}"); return 1 }
        jobs.push(CheckJob {
            name: move name,
            path: move path,
            cwd: work.clone(),
            expect_code: 0,
            expected_code: "",
            agent_mode: false,
        })
    }

    // Verify --agent mode works cleanly with --check-v2
    agent_path := f"{work}/agent_ok.ddr"
    if !sys.write_text(agent_path, "fn main() { x := 1; _ := x }\n").ok {
        _ := harness.fail("cannot write agent_ok.ddr"); return 1
    }
    jobs.push(CheckJob {
        name: "agent_ok",
        path: move agent_path,
        cwd: work.clone(),
        expect_code: 0,
        expected_code: "",
        agent_mode: true,
    })

    // Run all jobs concurrently using fork-safe single-threaded ChildPool
    mut pool_cap := process.host_cpus()
    if pool_cap < 2 { pool_cap = 2 }
    if pool_cap > 8 { pool_cap = 8 }
    mut pool := process.ChildSet::new(pool_cap)
    mut slot_job: []i32 = []
    mut slot_start: []i64 = []
    mut slot_out: []string = []
    mut slot_err: []string = []
    for _ in 0..pool_cap {
        slot_job.push(-1)
        slot_start.push(0)
        slot_out.push("")
        slot_err.push("")
    }

    mut next_idx := 0
    mut completed := 0
    mut failed := 0
    mut raw_out: []u8 = []
    mut raw_err: []u8 = []

    while completed < jobs.len {
        while next_idx < jobs.len && pool.len() < pool_cap {
            j := next_idx
            mut cmd_args: []string = ["check", "--check-v2"]
            if jobs[j].agent_mode { cmd_args.push("--agent") }
            cmd_args.push(jobs[j].path.clone())
            cmd_args.push("--jobs")
            cmd_args.push("1")
            mut cmd := process.Command::new(compiler.clone(), move cmd_args)
            cmd.set_cwd(jobs[j].cwd.clone())
            sp := cmd.spawn()
            if sp.is_err() {
                if pool.len() > 0 { break }
                _ := harness.fail(f"{jobs[j].name}: spawn failed")
                return 1
            }
            mut child := sp.unwrap()
            slot := pool.insert(&mut child)
            assert(slot >= 0)
            slot_job[slot] = j
            slot_start[slot] = sys.now_ms()
            slot_out[slot] = ""
            slot_err[slot] = ""
            next_idx += 1
        }

        if pool.len() == 0 { continue }
        _ := pool.poll_io(5)
        now := sys.now_ms()

        for slot in 0..pool_cap {
            if !pool.is_active(slot) { continue }
            j := slot_job[slot]
            raw_out.clear()
            raw_err.clear()
            mut w := pool.try_wait(slot, &mut raw_out, &mut raw_err)
            if !w.exited && now - slot_start[slot] >= i64(60000) {
                w = pool.kill_reap(slot, &mut raw_out, &mut raw_err)
            }
            if raw_out.len > 0 { slot_out[slot] += bytes.decode(&raw_out).unwrap_or_default() }
            if raw_err.len > 0 { slot_err[slot] += bytes.decode(&raw_err).unwrap_or_default() }
            if w.exited {
                completed += 1
                if !verify_job_result(&jobs[j], w.code, w.signal, w.timed_out, slot_out[slot].clone(), slot_err[slot].clone()) {
                    failed += 1
                }
                slot_job[slot] = -1
            }
        }
    }

    if failed > 0 { return 1 }
    print(f"check-v2 ok: {completed} end-to-end checks passed (incl. selfhost/main.ddr + {stdlib_files.len} stdlib modules) on {process.host_target()}")
    0
}
