capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import sys

fn invalid_cases() -> [](string, string) {
    [
        ("fn main() { x := 3? }", "'?' requires a Result operand"),
        ("fn value() -> Result<i32, string> { .Ok(1) } fn main() { x := value()? }",
         "'?' requires a Result operand and a function returning Result"),
        ("fn value() -> Result<i32, string> { .Err(\"no\") } " +
         "fn other() -> Result<i32, i32> { .Ok(value()?) } fn main() { _ := other() }", "same error type"),
        ("fn other(x: Result<string, i32>) -> Result<string, i32> { .Ok(x?) } fn main() { _ := other(.Ok(\"v\")) }",
         "cannot move out of a borrowed value"),
        ("fn other(move x: Result<string, i32>) -> Result<i32, i32> " +
         "{ s := x?; match x { .Ok(_) => { assert(false) }, .Err(_) => { assert(false) } }; .Ok(s.len) } " +
         "fn main() { _ := other(.Ok(\"x\")) }", "use of moved value"),
        ("fn unit() -> Result<(), i32> { .Ok } fn deferred() -> Result<(), i32> { defer { unit()? }; .Ok } " +
         "fn main() { _ := deferred() }", "not allowed inside defer"),
        ("fn main() { x: Result<&i32, string> = .Err(\"no\") }", "enum payloads must be storable values"),
        ("fn main() { x: Result<i32, bool> = .Err(\"no\") }", "type mismatch"),
        ("fn main() { x: Result<i32, bool> = .Ok(1); match x { .Ok(_) => {} } }", "non-exhaustive"),
    ]
}

fn reordered_specializations(compiler: string, work: string) -> bool {
    path := work + "/reordered.ddr"
    image := work + "/reordered"
    words := "words := Result<[]string, i32>.Ok([\"word\"])"
    numbers := "numbers := Result<[]i32, i32>.Ok([1])"
    suffix := "; print(19) }\n" +
              "fn second() { value := Result<[]i32, i32>.Ok([1]); print(23) }\n" +
              "fn main() { first(); second() }\n"
    mut output := harness.empty_output()
    for ordered in [true, false] {
        body := if ordered { words + "; " + numbers } else { numbers + "; " + words }
        if !sys.write_text(path, "fn first() { " + body + suffix).ok { return harness.fail(f"cannot write {path}") }
        if !harness.run_checked_timeout(compiler, ["build", path.clone(), "--incremental", "--inline-opt=off", "-o", image.clone()], work, 0, false, 120000, &mut output) ||
           !harness.run_checked_timeout(image, [], work, 0, false, 120000, &mut output) ||
           !harness.stdout_is(&output, "19\n23\n", "reordered Result specializations") { return false }
    }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    source := cli.root + "/tests/fixtures/results.ddr"
    output := "11\n50\n50\n1\n2\n51\n3\n4\n52\n53\n5\n42\n"
    cases := invalid_cases()
    if !harness.run_specialization_matrix(cli.compiler, source, work, output) ||
       !reordered_specializations(cli.compiler, work) ||
       !harness.check_rejected_specializations(cli.compiler, work, &cases) { return false }
    print("PASS Result propagation on native and Wasm, four target builds, cached builds and diagnostics")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-results-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
