import .harness as harness
import .profile_format as allocations
import std.json as json

pub struct Phase { name: string, work_key: string }
pub struct Timing { record: json.Doc, error: string }

pub fn phases() -> []Phase {
    [
        Phase { name: "declarations", work_key: "declarations_functions" },
        Phase { name: "model_parse", work_key: "model_parse_tokens" },
        Phase { name: "verify_pre", work_key: "verify_pre_nodes" },
        Phase { name: "simplify", work_key: "simplify_visits" },
        Phase { name: "verify_post", work_key: "verify_post_nodes" },
        Phase { name: "allocation", work_key: "allocation_frame_values" },
        Phase { name: "scalar_emit", work_key: "scalar_emit_words" },
        Phase { name: "legacy_body", work_key: "legacy_body_tokens" },
        Phase { name: "fragment_cache", work_key: "fragment_cache_operations" },
        Phase { name: "finalize", work_key: "finalize_bytes" },
        Phase { name: "range_analysis", work_key: "range_analysis_operations" },
        Phase { name: "mir_pipeline", work_key: "mir_pipeline_operations" },
    ]
}

fn nonnegative(doc: &json.Doc, at: i32, key: string) -> bool {
    value := doc.get_i64(at, key)
    value.is_some() && value.unwrap_or(-1) >= 0
}

fn counters(doc: &json.Doc, at: i32, keys: &[]string, extra: i32) -> bool {
    if doc.kind(at) != .Object || doc.count(at) != keys.len + extra { return false }
    for key in keys { if !nonnegative(&doc, at, key) { return false } }
    true
}

fn sum(doc: &json.Doc, at: i32, keys: &[]string) -> i64 {
    mut total: i64 = 0
    for key in keys {
        value := doc.get_i64(at, key).unwrap_or(0)
        if value > 9223372036854775807 - total { return -1 }
        total += value
    }
    total
}

fn timing_error(doc: &json.Doc, target: string) -> string {
    root := doc.root
    if doc.get_i64(root, "version") != .Some(1) || doc.get_str(root, "operation") != .Some("build") ||
       doc.get_str(root, "scope") != .Some("compiler_pipeline") || doc.get_str(root, "clock") != .Some("monotonic") ||
       doc.get_bool(root, "clock_ok") != .Some(true) || doc.get_str(root, "unit") != .Some("ns") ||
       doc.get_str(root, "target") != .Some(target.clone()) { return "unsupported compiler timing schema or unavailable host clock" }
    pipeline: []string = ["module_load_lex_resolve", "build_setup", "compiler", "image_format_sign", "publication"]
    build := doc.field(root, "phases")
    if !counters(&doc, build, &pipeline, 0) { return "invalid pipeline phase counters or keys" }
    function_keys: []string = ["reused", "emitted"]
    if !counters(&doc, doc.field(root, "functions"), &function_keys, 0) { return "invalid function counters or keys" }
    if doc.get_i64(root, "modules").unwrap_or(0) < 1 { return "invalid module count" }
    total := doc.get_i64(root, "total")
    if total.is_none() || total.unwrap_or(-1) < 0 || total.unwrap_or(-1) != sum(&doc, build, &pipeline) { return "pipeline phases do not partition total" }
    skipped := doc.field(root, "skipped_phases")
    if doc.kind(skipped) != .Array || doc.count(skipped) != 0 { return "successful build unexpectedly skipped a phase" }
    optimizer := doc.field(root, "optimizer")
    if doc.get_bool(optimizer, "enabled").is_none() { return "missing optimizer state" }
    optimizer_keys: []string = ["modeled", "emitted", "rewrites", "proven_bounds", "fallbacks"]
    if !counters(&doc, optimizer, &optimizer_keys, 1) { return "invalid optimizer counters or keys" }
    detail := doc.field(root, "compiler_detail")
    if doc.get_bool(detail, "enabled") != .Some(true) || doc.get_bool(detail, "clock_ok") != .Some(true) ||
       doc.get_str(detail, "unit") != .Some("ns") { return "missing compiler details or unavailable compiler clock" }
    mut names: []string = []
    mut work_names: []string = []
    phase_specs := phases()
    for phase in phase_specs {
        names.push(phase.name.clone())
        work_names.push(phase.work_key.clone())
    }
    durations := doc.field(detail, "phases")
    calls := doc.field(detail, "calls")
    work := doc.field(detail, "work")
    if !counters(&doc, durations, &names, 0) { return "invalid compiler phase counters or keys" }
    if !counters(&doc, calls, &names, 0) { return "invalid compiler phase call counters or keys" }
    if !counters(&doc, work, &work_names, 0) { return "invalid compiler work counters or keys" }
    if !nonnegative(&doc, detail, "covered") || !nonnegative(&doc, detail, "other") {
        return "missing covered/other duration; null is not zero"
    }
    covered := doc.get_i64(detail, "covered").unwrap_or(0)
    other := doc.get_i64(detail, "other").unwrap_or(0)
    compiler := doc.get_i64(build, "compiler").unwrap_or(0)
    if covered != sum(&doc, durations, &names) || covered > compiler || compiler - covered != other {
        return "compiler details do not partition compiler interval"
    }
    if doc.get_i64(calls, "declarations") != .Some(1) || doc.get_i64(calls, "finalize") != .Some(1) {
        return "expected one declaration and finalization interval"
    }
    for phase in phase_specs {
        if doc.get_i64(calls, phase.name) == .Some(0) &&
           (doc.get_i64(durations, phase.name).unwrap_or(0) != 0 || doc.get_i64(work, phase.work_key).unwrap_or(0) != 0) {
            return f"uncalled phase {phase.name} has time/work"
        }
    }
    ""
}

pub fn clock(stderr: string, target: string) -> Timing {
    lines := harness.lines(stderr)
    if lines.len != 1 {
        return Timing { record: json.Doc::parse_text("null"),
                        error: f"expected one timings JSON line, got {lines.len}; observers must remain separate" }
    }
    record := json.Doc::parse_text(lines[0])
    error := if !record.ok || record.get_str(record.root, "kind") != .Some("timings") {
        "expected timings record"
    } else { timing_error(&record, target) }
    Timing { record: record, error: error }
}

pub fn allocation(stderr: string) -> allocations.Profile {
    lines := harness.lines(stderr)
    mut report := allocations.read(stderr)
    if lines.len != 1 {
        report.error = f"expected one runtime_profile JSON line, got {lines.len}; observers must remain separate"
    }
    report
}
