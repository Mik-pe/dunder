capability process, filesystem

import .harness as harness
import .mir_oracle as oracle
import .test_evidence as evidence
import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

pub struct Input {
    case_id: i32,
    value: i64,
    condition: i64,
}

pub struct Proof {
    ok: bool,
    before: oracle.Outcome,
    after: oracle.Outcome,
}

pub struct Image {
    input: Input,
    policy: i32,
    target: i32,
    mode: string,
    sha256: string,
    executed: bool,
    trap: bool,
    proof: Proof,
    counters: []i64,
}

pub struct Run {
    images: []Image,
    executions: i32,
    pairs: i32,
    gaps: i32,
    emitter_sha256: string,
}

impl Run {
    pub fn new() -> Self { Self { images: [], executions: 0, pairs: 0, gaps: 0, emitter_sha256: "" } }

    pub fn record(&mut self, move image: Image) {
        if image.executed { self.executions += 1 }
        if image.proof.before.state == .Gap { self.gaps += 1 }
        else { self.pairs += 1 }
        self.images.push(move image)
    }
}

pub fn expected(input: Input) -> i64 {
    case_id := input.case_id
    value := input.value
    if case_id == 0 { return value.wrapping_add(5) }
    if case_id == 1 || case_id == 3 { return value.wrapping_add(11) }
    if case_id == 2 { return value.wrapping_add(if input.condition == 0 { 12 } else { 11 }) }
    if case_id == 4 { return value.wrapping_add(3) }
    if case_id == 5 { return value.bit_and(0xffffffff) }
    if case_id == 6 { return value.wrapping_add(input.condition).bit_and(0xffffffff) }
    if case_id == 7 || case_id == 10 || case_id == 12 { return value.wrapping_add(1) }
    if case_id == 8 { return value.wrapping_add(99) }
    if case_id == 9 { return value.wrapping_add(17) }
    if case_id == 11 { return 0 }
    assert(case_id == 13)
    value
}

pub fn traps(input: Input) -> bool { input.case_id == 10 && input.value == 9223372036854775807 }

fn interpret(model: &oracle.Model, input: Input, seed_stack: bool) -> oracle.Outcome {
    mut machine := oracle.Machine::new()
    if seed_stack {
        for reg in 0..29 { machine.write(i64(reg), 0, 64) }
        for address in 1044480..1048832 { machine.store(u64(address), 0, 1) }
    }
    machine.write(0, oracle.bits(input.condition), 64)
    machine.write(4, oracle.bits(input.value), 64)
    machine.run(&model, 10000)
}

fn expected_outcome(result: &oracle.Outcome, input: Input, trap: bool, value: i64) -> bool {
    if result.state == .Complete { return !trap && result.value == oracle.bits(value) }
    if result.state != .Gap { return false }
    if input.case_id == 8 { return text.find(result.reason, "kind=14") >= 0 }
    trap && text.find(result.reason, "external branch") >= 0
}

pub fn check(before: &oracle.Model, after: &oracle.Model, input: Input, seed_stack: bool) -> Proof {
    pre := interpret(&before, input, seed_stack)
    post := interpret(&after, input, seed_stack)
    trap := traps(input)
    value := expected(input)
    good := pre.state == post.state && expected_outcome(&pre, input, trap, value) &&
            expected_outcome(&post, input, trap, value)
    if !good {
        _ := harness.fail(f"case {input.case_id} input {input.value} condition {input.condition}: expected {value}, before {oracle.signed(pre.value, 64)} {pre.reason}, after {oracle.signed(post.value, 64)} {post.reason}")
    }
    Proof { ok: good, before: pre, after: post }
}

pub fn call(program: string, args: []string, work: string, status: i32, timeout: i64, out: &mut process.Output) -> bool {
    harness.run_checked_timeout(program, args, work, status, false, timeout, &mut out)
}

fn write_outcome(writer: &mut json.Writer, state: &oracle.Outcome) {
    writer.object()
    if state.state == .Complete {
        writer.key("result")
        writer.integer(oracle.signed(state.value, 64))
    } else {
        writer.key("coverage_gap")
        writer.string(state.reason)
    }
    writer.key("steps")
    writer.integer(i64(state.steps))
    writer.end()
}

pub fn write_images(writer: &mut json.Writer, images: &[]Image, counter_names: &[]string, pipeline: bool) {
    writer.array()
    for image in images {
        writer.object()
        writer.key("case")
        writer.integer(i64(image.input.case_id))
        writer.key("input")
        writer.integer(image.input.value)
        writer.key("condition")
        writer.integer(image.input.condition)
        writer.key("target")
        writer.integer(i64(image.target))
        writer.key("mode")
        writer.string(image.mode)
        writer.key("sha256")
        writer.string(image.sha256)
        writer.key("executed")
        writer.boolean(image.executed)
        writer.key("before")
        write_outcome(&mut writer, &image.proof.before)
        writer.key("after")
        write_outcome(&mut writer, &image.proof.after)
        if pipeline {
            writer.key("policy")
            writer.integer(i64(image.policy))
            writer.key("counters")
            writer.object()
        } else {
            writer.key("trap")
            writer.boolean(image.trap)
        }
        for i in 0..counter_names.len {
            writer.key(counter_names[i])
            writer.integer(image.counters[i])
        }
        if pipeline { writer.end() }
        writer.end()
    }
    writer.end()
}

fn write_sorted_ascii(out: &mut []u8, doc: &json.Doc, node: i32) {
    kind := doc.kind(node)
    if kind == .Object {
        out.push(b'{')
        mut keys: []string = []
        for i in 0..doc.count(node) {
            key := doc.key_at(node, i)
            assert(key.ok)
            keys.push(move key.value)
        }
        array.sort_strings(&mut keys)
        for i in 0..keys.len {
            if i > 0 { bytes.append_utf8(&mut out, ", ") }
            json.write_str(&mut out, keys[i])
            bytes.append_utf8(&mut out, ": ")
            write_sorted_ascii(&mut out, &doc, doc.field(node, keys[i]))
        }
        out.push(b'}')
    } else if kind == .Array {
        out.push(b'[')
        for i in 0..doc.count(node) {
            if i > 0 { bytes.append_utf8(&mut out, ", ") }
            write_sorted_ascii(&mut out, &doc, doc.at(node, i))
        }
        out.push(b']')
    } else if kind == .String {
        value := doc.as_str(node)
        assert(value.ok)
        for byte in value.value.bytes() { assert(byte < 128) }
        json.write_str(&mut out, value.value)
    } else {
        ascii := doc.raw_span(node)
        for byte in ascii.bytes() { assert(byte < 128) }
        bytes.append_utf8(&mut out, ascii)
    }
}

pub fn manifest(images: &[]Image, counter_names: &[]string, pipeline: bool) -> string {
    mut writer := json.Writer::new()
    write_images(&mut writer, &images, &counter_names, pipeline)
    rendered := writer.finish()
    assert(rendered.ok)
    doc := json.Doc::parse_text(rendered.value)
    assert(doc.ok)
    mut out: []u8 = []
    write_sorted_ascii(&mut out, &doc, doc.root)
    harness.sha256_bytes_hex(&out)
}

pub fn save(path: string, writer: &json.Writer) -> bool {
    parent := harness.parent_dir(path)
    if parent.len > 0 && !fs.mkdir_all(parent).ok { return harness.fail(f"cannot create {parent}") }
    evidence.save(path, &writer)
}
