capability process, filesystem, stdio

import .harness as harness
import .native_probe as native
import .probe_cli as cli
import .test_evidence as evidence
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

struct PathStep {
    is_index: bool,
    key: string,
    index: i32,
}

struct LexemeCheck {
    path: []PathStep,
    spelling: string,
}

struct Case {
    name: string,
    source: []u8,
    ok: bool,
    expected_json: string,
    expected_tagged: bool,
    lexemes: []LexemeCheck,
    diagnostic: string,
    invalid_utf8: bool,
    location: bool,
    oracle: string,
}

struct CanonDecimal {
    ok: bool,
    neg: bool,
    is_zero: bool,
    digits: string,
    exp: i64,
}

struct LineSpan {
    start: i32,
    end: i32,
}

struct BuildResult {
    ok: bool,
    builds: i32,
    images: []string,
    digests: []string,
}

fn input_limit() -> i32 { 4194304 }
fn node_limit() -> i32 { 100000 }

fn hex2_lower(v: i32) -> string {
    digits := "0123456789abcdef"
    mut out: []u8 = [u8(digits[(v / 16) % 16]), u8(digits[v % 16])]
    bytes.decode(&out).unwrap()
}

fn pad4(n: i32) -> string {
    s := n.str()
    if s.len >= 4 { return s }
    text.pad_left(s, 4, "0")
}

fn repeat_str(piece: string, count: i32) -> string {
    mut out: []u8 = []
    out.reserve(piece.len * count)
    for _ in 0..count { bytes.append_utf8(&mut out, piece) }
    bytes.decode(&out).unwrap()
}

fn join_x(count: i32) -> string {
    mut out: []u8 = []
    if count > 0 { out.reserve(count * 2 - 1) }
    for i in 0..count {
        if i > 0 { out.push(b'.') }
        out.push(b'x')
    }
    bytes.decode(&out).unwrap()
}

fn make_comment_bytes(x_count: i32) -> []u8 {
    mut out: []u8 = []
    out.reserve(x_count + 1)
    out.push(b'#')
    for _ in 0..x_count { out.push(b'x') }
    out
}

fn make_zeros_source(zero_count: i32) -> []u8 {
    mut out: []u8 = []
    out.reserve(zero_count * 2 + 4)
    bytes.append_utf8(&mut out, "v=[")
    for i in 0..zero_count {
        if i > 0 { out.push(b',') }
        out.push(b'0')
    }
    out.push(b']')
    out
}

fn make_zeros_expected_json(zero_count: i32) -> string {
    mut out: []u8 = []
    out.reserve(zero_count * 2 + 8)
    bytes.append_utf8(&mut out, "{\"v\":[")
    for i in 0..zero_count {
        if i > 0 { out.push(b',') }
        out.push(b'0')
    }
    bytes.append_utf8(&mut out, "]}")
    bytes.decode(&out).unwrap()
}

fn key_step(key: string) -> PathStep {
    PathStep { is_index: false, key: key.clone(), index: 0 }
}

fn index_step(index: i32) -> PathStep {
    PathStep { is_index: true, key: "", index: index }
}

fn single_v_lexeme(spelling: string) -> []LexemeCheck {
    [LexemeCheck { path: [key_step("v")], spelling: spelling.clone() }]
}

fn clean_float_spelling(spelling: string) -> string {
    mut out: []u8 = []
    out.reserve(spelling.len)
    mut start := 0
    if spelling.len > 0 && spelling[0] == b'+' { start = 1 }
    for i in start..spelling.len {
        b := spelling[i]
        if b != b'_' { out.push(b) }
    }
    bytes.decode(&out).unwrap()
}

fn add_valid(cases: &mut []Case, name: string, text_src: string, expected_json: string,
             move lexemes: []LexemeCheck, oracle: string) {
    cases.push(Case {
        name: name.clone(),
        source: bytes.from_text(text_src),
        ok: true,
        expected_json: expected_json.clone(),
        expected_tagged: false,
        lexemes: lexemes,
        diagnostic: "",
        invalid_utf8: false,
        location: true,
        oracle: oracle.clone(),
    })
}

fn add_valid_plain(cases: &mut []Case, name: string, text_src: string, expected_json: string) {
    add_valid(&mut cases, name, text_src, expected_json, [], "TOML 1.0 specification")
}

fn add_valid_str(cases: &mut []Case, name: string, text_src: string, expected_val: string) {
    add_valid_plain(&mut cases, name, text_src, "{\"v\":" + json.quote(expected_val) + "}")
}

fn add_invalid(cases: &mut []Case, name: string, text_src: string,
               diagnostic: string, location: bool, oracle: string) {
    cases.push(Case {
        name: name.clone(),
        source: bytes.from_text(text_src),
        ok: false,
        expected_json: "",
        expected_tagged: false,
        lexemes: [],
        diagnostic: diagnostic.clone(),
        invalid_utf8: false,
        location: location,
        oracle: oracle.clone(),
    })
}

fn add_invalid_plain(cases: &mut []Case, name: string, text_src: string) {
    add_invalid(&mut cases, name, text_src, "", true, "TOML 1.0 specification")
}

fn add_invalid_bytes(cases: &mut []Case, name: string, move raw: []u8,
                     diagnostic: string, location: bool, oracle: string) {
    cases.push(Case {
        name: name.clone(),
        source: raw,
        ok: false,
        expected_json: "",
        expected_tagged: false,
        lexemes: [],
        diagnostic: diagnostic.clone(),
        invalid_utf8: false,
        location: location,
        oracle: oracle.clone(),
    })
}

fn grammar_cases() -> []Case {
    mut cases: []Case = []

    add_valid_plain(&mut cases, "empty", "", "{}")
    add_valid_plain(&mut cases, "comments",
        "# comment\n\t # tab\n a = '# string' # end\n",
        "{\"a\":\"# string\"}")
    add_valid_plain(&mut cases, "crlf",
        "# comment\r\na = 1\r\n[b]\r\nc = [true,\r\nfalse,]\r\n",
        "{\"a\":1,\"b\":{\"c\":[true,false]}}")
    add_valid_plain(&mut cases, "keys",
        "bare-key_0 = true\n1234 = \"digits\"\n\"\" = \"empty\"\n\"127.0.0.1\" = \"quoted\"\n'quoted \"key\"' = \"literal\"\n\"雪🌍\" = \"unicode\"\n\"escaped\\u0020key\" = 42\n",
        "{\"bare-key_0\":true,\"1234\":\"digits\",\"\":\"empty\",\"127.0.0.1\":\"quoted\",\"quoted \\\"key\\\"\":\"literal\",\"雪🌍\":\"unicode\",\"escaped key\":42}")
    add_valid_plain(&mut cases, "dotted-keys",
        "name = \"Orange\"\nphysical.color = \"orange\"\nphysical . shape = \"round\"\nsite.\"google.com\" = true\n3.14159 = \"pi\"\n",
        "{\"name\":\"Orange\",\"physical\":{\"color\":\"orange\",\"shape\":\"round\"},\"site\":{\"google.com\":true},\"3\":{\"14159\":\"pi\"}}")
    add_valid_plain(&mut cases, "dotted-out-of-order",
        "apple.type='fruit'\norange.type='fruit'\napple.skin='thin'\norange.skin='thick'\n",
        "{\"apple\":{\"type\":\"fruit\",\"skin\":\"thin\"},\"orange\":{\"type\":\"fruit\",\"skin\":\"thick\"}}")
    add_valid_plain(&mut cases, "dotted-empty-segments",
        "\"\".\"\" = 1\n\"a.b\".'c.d' = 2\n",
        "{\"\":{\"\":1},\"a.b\":{\"c.d\":2}}")
    add_valid_plain(&mut cases, "tables",
        "[dog.\"tater.man\"]\ntype.name = \"pug\"\n[dog]\nage = 2\n[empty]\n[dog.\"tater.man\".empty]\n",
        "{\"dog\":{\"tater.man\":{\"type\":{\"name\":\"pug\"},\"empty\":{}},\"age\":2},\"empty\":{}}")
    add_valid_plain(&mut cases, "implicit-table-later-declared",
        "[a.b.c]\nx=1\n[a]\ny=2\n[a.b]\nz=3\n",
        "{\"a\":{\"b\":{\"c\":{\"x\":1},\"z\":3},\"y\":2}}")
    add_valid_plain(&mut cases, "dotted-key-then-subtable",
        "fruit.apple.color='red'\n[fruit.apple.texture]\nsmooth=true\n",
        "{\"fruit\":{\"apple\":{\"color\":\"red\",\"texture\":{\"smooth\":true}}}}")
    add_valid_plain(&mut cases, "table-relative-dotted",
        "[a]\nb.c=1\nb.d=2\n[a.e]\nf=3\n",
        "{\"a\":{\"b\":{\"c\":1,\"d\":2},\"e\":{\"f\":3}}}")
    add_valid_plain(&mut cases, "arrays",
        "mixed = [1, \"two\", false, [3, 4], {x = 5}]\nempty = []\nnested = [[1, 2], [3], []]\ncommented = [\n  1, # first\n  # full line\n  2,\n]\n",
        "{\"mixed\":[1,\"two\",false,[3,4],{\"x\":5}],\"empty\":[],\"nested\":[[1,2],[3],[]],\"commented\":[1,2]}")
    add_valid_plain(&mut cases, "inline-table",
        "a = { x = 1, nested.y = true, nested.z = 'ok', empty = {} }\nb = [{x=1}, {x=2}]\n",
        "{\"a\":{\"x\":1,\"nested\":{\"y\":true,\"z\":\"ok\"},\"empty\":{}},\"b\":[{\"x\":1},{\"x\":2}]}")
    add_valid_plain(&mut cases, "inline-multiline-value",
        "a = {text = \"\"\"\nfirst\nsecond\"\"\", list = [\n1,\n2,\n]}\n",
        "{\"a\":{\"text\":\"first\\nsecond\",\"list\":[1,2]}}")
    add_valid_plain(&mut cases, "inline-sibling-table",
        "a={b=1}\nc=2\n[d]\ne=3\n",
        "{\"a\":{\"b\":1},\"c\":2,\"d\":{\"e\":3}}")
    add_valid_plain(&mut cases, "aot",
        "[[products]]\nname = \"Hammer\"\nsku = 738594937\n[[products]]\n[[products]]\nname = \"Nail\"\nsku = 284758393\ncolor = \"gray\"\n",
        "{\"products\":[{\"name\":\"Hammer\",\"sku\":738594937},{},{\"name\":\"Nail\",\"sku\":284758393,\"color\":\"gray\"}]}")
    add_valid_plain(&mut cases, "aot-nested",
        "[[fruits]]\nname = \"apple\"\n[fruits.physical]\ncolor = \"red\"\n[[fruits.varieties]]\nname = \"red delicious\"\n[[fruits.varieties]]\nname = \"granny smith\"\n[[fruits]]\nname = \"banana\"\n[[fruits.varieties]]\nname = \"plantain\"\n",
        "{\"fruits\":[{\"name\":\"apple\",\"physical\":{\"color\":\"red\"},\"varieties\":[{\"name\":\"red delicious\"},{\"name\":\"granny smith\"}]},{\"name\":\"banana\",\"varieties\":[{\"name\":\"plantain\"}]}]}")
    add_valid_plain(&mut cases, "aot-most-recent-parent",
        "[[a]]\n[a.b]\nx=1\n[[a.b.c]]\nv=2\n[[a]]\n[a.b]\nx=3\n[[a.b.c]]\nv=4\n",
        "{\"a\":[{\"b\":{\"x\":1,\"c\":[{\"v\":2}]}},{\"b\":{\"x\":3,\"c\":[{\"v\":4}]}}]}")
    add_valid_plain(&mut cases, "aot-independent-empty-elements",
        "[[a]]\n[[a.b]]\n[[a.b]]\n[[a]]\n[[a.b]]\n",
        "{\"a\":[{\"b\":[{},{}]},{\"b\":[{}]}]}")
    add_valid_plain(&mut cases, "array-table-literal-remains-value",
        "a=[{x=1},{x=2}]\n",
        "{\"a\":[{\"x\":1},{\"x\":2}]}")

    add_valid_str(&mut cases, "string/basic",
        "v = \"I'm a string. \\\"quoted\\\". Name\\tJos\\u00E9\\nLocation\\tSF.\"",
        "I'm a string. \"quoted\". Name\tJos\u00e9\nLocation\tSF.")
    add_valid_str(&mut cases, "string/basic-escapes",
        "v = \"\\b\\t\\n\\f\\r\\\"\\\\\\u0000\\u001f\\u007f\"",
        "\x08\t\n\x0c\r\"\\\0\x1f\x7f")
    add_valid_str(&mut cases, "string/literal",
        "v = 'C:\\Users\\nodejs\\templates'",
        "C:\\Users\\nodejs\\templates")
    add_valid_str(&mut cases, "string/literal-regex",
        "v = '<\\i\\c*\\s*>'",
        "<\\i\\c*\\s*>")
    add_valid_str(&mut cases, "string/multiline-basic",
        "v = \"\"\"\nRoses are red\nViolets are blue\"\"\"",
        "Roses are red\nViolets are blue")
    add_valid_str(&mut cases, "string/multiline-literal",
        "v = '''\nThe first newline is\ntrimmed.\n  Other whitespace remains.\n'''",
        "The first newline is\ntrimmed.\n  Other whitespace remains.\n")
    add_valid_str(&mut cases, "string/multiline-continuation",
        "v = \"\"\"\nThe quick brown \\\n\n  fox jumps over \\ \t\n    the lazy dog.\\\n  \"\"\"",
        "The quick brown fox jumps over the lazy dog.")
    add_valid_str(&mut cases, "string/multiline-tab",
        "v = \"\"\"\tvalue\n\tend\"\"\"",
        "\tvalue\n\tend")
    add_valid_str(&mut cases, "string/literal-backslash-newline",
        "v = '''a\\\nb'''",
        "a\\\nb")
    add_valid_str(&mut cases, "string/literal-quotes",
        "v = '''I [dw]on't need \\d{2} apples'''",
        "I [dw]on't need \\d{2} apples")
    add_valid_str(&mut cases, "string/unicode-scalars",
        "v = \"\\u0000\\u007f\\u0080\\u07ff\\u0800\\ud7ff\\ue000\\uffff\\U00010000\\U0010ffff\"",
        "\0\x7f\u0080\u07ff\u0800\ud7ff\ue000\uffff\u{10000}\u{10ffff}")
    add_valid_str(&mut cases, "string/unicode-direct",
        "v = \"\u00e9 e\u0301 \u0395\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ac \u96ea \u{1f30d}\"",
        "\u00e9 e\u0301 \u0395\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ac \u96ea \u{1f30d}")
    add_valid_str(&mut cases, "string/basic-tab", "v = \"a\tb\"", "a\tb")
    add_valid_str(&mut cases, "string/literal-tab", "v = 'a\tb'", "a\tb")
    add_valid_str(&mut cases, "string/multiline-crlf", "v = \"\"\"\r\none\r\ntwo\"\"\"", "one\ntwo")
    add_valid_str(&mut cases, "string/multiline-literal-crlf", "v = '''\r\none\r\ntwo'''", "one\ntwo")

    delimiters: [](string, string, string) = [
        ("\"\"\"", "\"", "basic"),
        ("'''", "'", "literal"),
    ]
    for di in 0..delimiters.len {
        delim := delimiters[di].0.clone()
        quote := delimiters[di].1.clone()
        label := delimiters[di].2.clone()
        for count in 0..3 {
            qs := repeat_str(quote, count)
            add_valid_str(&mut cases, f"string/{label}-terminal-{count}-quotes",
                "v=" + delim + "word" + qs + delim, "word" + qs)
            add_valid_str(&mut cases, f"string/{label}-internal-{count}-quotes",
                "v=" + delim + "left" + qs + "right" + delim, "left" + qs + "right")
        }
        add_valid_str(&mut cases, f"string/{label}-empty", "v=" + delim + delim, "")
    }

    bin64 := "0b" + repeat_str("1", 64)
    integers: [](string, string) = [
        ("0", "0"),
        ("+0", "0"),
        ("-0", "0"),
        ("1", "1"),
        ("+99", "99"),
        ("-17", "-17"),
        ("1_000", "1000"),
        ("5_349_221", "5349221"),
        ("0xDEAD_BEEF", "3735928559"),
        ("0o755", "493"),
        ("0b1101_0010", "210"),
        ("0x0000_FF", "255"),
        ("0o0007", "7"),
        ("0b0001", "1"),
        ("9007199254740991", "9007199254740991"),
        ("9007199254740992", "9007199254740992"),
        ("9007199254740993", "9007199254740993"),
        ("9223372036854775807", "9223372036854775807"),
        ("-9223372036854775808", "-9223372036854775808"),
        ("9223372036854775808", "9223372036854775808"),
        ("18446744073709551615", "18446744073709551615"),
        ("0xffff_ffff_ffff_ffff", "18446744073709551615"),
        ("0o1777777777777777777777", "18446744073709551615"),
        (bin64, "18446744073709551615"),
    ]
    for index in 0..integers.len {
        spelling := integers[index].0.clone()
        canonical := integers[index].1.clone()
        oracle := if index >= 19 { "Dunder positive-u64 extension" } else { "TOML 1.0 specification" }
        add_valid(&mut cases, f"integer/{index}-{spelling}", "v=" + spelling,
            "{\"v\":" + canonical + "}", single_v_lexeme(canonical), oracle)
    }

    floats: []string = [
        "1.0", "+1.0", "-0.0", "+0.0", "0.0", "3.1415", "1e2",
        "1E+02", "1e-2", "-1.234E-12", "6.626e-34", "1_000.0_1E+0_2",
        "0e00", "-0e0", "1.7976931348623157e308", "5e-324",
        "1e10000", "1e-10000", "1.2345678901234567890123456789",
    ]
    for index in 0..floats.len {
        spelling := floats[index].clone()
        cleaned := clean_float_spelling(spelling)
        add_valid(&mut cases, f"float/{index}-{spelling}", "v=" + spelling,
            "{\"v\":" + cleaned + "}", single_v_lexeme(cleaned), "TOML 1.0 specification")
    }
    specials: [](string, string) = [
        ("inf", "inf"), ("+inf", "inf"), ("-inf", "-inf"),
        ("nan", "nan"), ("+nan", "nan"), ("-nan", "nan"),
    ]
    for index in 0..specials.len {
        spelling := specials[index].0.clone()
        tag_val := specials[index].1.clone()
        add_valid_plain(&mut cases, "float/" + spelling, "v=" + spelling,
            "{\"v\":{\"$toml_float\":\"" + tag_val + "\"}}")
    }

    mut nested_lex: []LexemeCheck = [
        LexemeCheck { path: [key_step("v"), index_step(0)], spelling: "9007199254740993" },
        LexemeCheck { path: [key_step("v"), index_step(1)], spelling: "1.0" },
        LexemeCheck { path: [key_step("v"), index_step(2), key_step("x")], spelling: "18446744073709551615" },
        LexemeCheck { path: [key_step("v"), index_step(2), key_step("y")], spelling: "1e2" },
    ]
    add_valid(&mut cases, "numbers-in-nested-values",
        "v=[9007199254740993, 1.0, {x=18446744073709551615, y=1e2}]",
        "{\"v\":[9007199254740993,1.0,{\"x\":18446744073709551615,\"y\":1e2}]}",
        move nested_lex, "TOML 1.0 specification")

    temporals: [](string, string, string) = [
        ("1979-05-27", "date", "1979-05-27"),
        ("2000-02-29", "date", "2000-02-29"),
        ("0001-01-01", "date", "0001-01-01"),
        ("9999-12-31", "date", "9999-12-31"),
        ("07:32:00", "time", "07:32:00"),
        ("00:00:00.000000000", "time", "00:00:00.000000000"),
        ("23:59:59.1234567890123456789", "time", "23:59:59.1234567890123456789"),
        ("1979-05-27T07:32:00Z", "datetime", "1979-05-27T07:32:00Z"),
        ("1979-05-27t07:32:00z", "datetime", "1979-05-27T07:32:00Z"),
        ("1979-05-27 07:32:00Z", "datetime", "1979-05-27T07:32:00Z"),
        ("1979-05-27T00:32:00-07:00", "datetime", "1979-05-27T00:32:00-07:00"),
        ("1979-05-27T07:32:00.999999999+23:59", "datetime", "1979-05-27T07:32:00.999999999+23:59"),
        ("1979-05-27T07:32:00-00:00", "datetime", "1979-05-27T07:32:00-00:00"),
        ("1979-05-27T07:32:00", "datetime", "1979-05-27T07:32:00"),
        ("1979-05-27 07:32:00.000000000", "datetime", "1979-05-27T07:32:00.000000000"),
    ]
    for index in 0..temporals.len {
        spelling := temporals[index].0.clone()
        kind := temporals[index].1.clone()
        normalized := temporals[index].2.clone()
        add_valid_plain(&mut cases, f"temporal/{index}", "v=" + spelling,
            "{\"v\":{\"$toml_" + kind + "\":" + json.quote(normalized) + "}}")
    }
    add_valid(&mut cases, "temporal/year-zero-date", "v=0000-01-01",
        "{\"v\":{\"$toml_date\":\"0000-01-01\"}}", [],
        "RFC 3339 lexical year and Dunder public contract")
    add_valid(&mut cases, "temporal/year-zero-datetime", "v=0000-02-29T00:00:00Z",
        "{\"v\":{\"$toml_datetime\":\"0000-02-29T00:00:00Z\"}}", [],
        "RFC 3339 lexical year and Dunder public contract")

    invalids: [](string, string) = [
        ("missing-key", "=1"),
        ("missing-value", "a="),
        ("missing-equals", "a 1"),
        ("missing-key-value-newline", "a=1 b=2"),
        ("bare-value", "1"),
        ("bare-unicode-key", "雪=1"),
        ("bare-space-key", "a b=1"),
        ("bare-plus-key", "+a=1"),
        ("empty-dotted-key", "a..b=1"),
        ("leading-dot", ".a=1"),
        ("trailing-dot", "a.=1"),
        ("dotted-newline", "a.\nb=1"),
        ("quoted-key-multiline", "\"\"\"key\"\"\"=1"),
        ("duplicate-key", "a=1\na=2"),
        ("quoted-duplicate", "a=1\n'a'=2"),
        ("escaped-duplicate", "a=1\n\"\\u0061\"=2"),
        ("scalar-to-table", "a=1\na.b=2"),
        ("table-to-scalar", "a.b=1\na=2"),
        ("duplicate-table", "[a]\n[a]"),
        ("dotted-table-redefined", "a.b=1\n[a]"),
        ("dotted-child-redefined", "a.b.c=1\n[a.b]"),
        ("header-scalar-conflict", "a=1\n[a]"),
        ("header-array-conflict", "a=[]\n[a]"),
        ("inline-extension-dotted", "a={b=1}\na.c=2"),
        ("inline-extension-header", "a={b=1}\n[a.c]"),
        ("inline-child-extension", "a={b={c=1}}\n[a.b.d]"),
        ("inline-root-redefinition", "a={}\n[a]"),
        ("inline-dotted-duplicate", "a={b.c=1,b.c=2}"),
        ("inline-nested-conflict", "a={b=1,b.c=2}"),
        ("inline-sealed-sibling", "a={b={c=1},b.d=2}"),
        ("inline-trailing-comma", "a={b=1,}"),
        ("inline-newline", "a={\nb=1}"),
        ("inline-comment", "a={b=1,# comment\nc=2}"),
        ("inline-missing-comma", "a={b=1 c=2}"),
        ("array-missing-comma", "a=[1 2]"),
        ("array-leading-comma", "a=[,1]"),
        ("array-double-comma", "a=[1,,2]"),
        ("array-missing-close", "a=[1,2"),
        ("array-table-to-aot", "a=[]\n[[a]]"),
        ("inline-array-to-aot", "a=[{}]\n[[a]]"),
        ("table-to-aot", "[a]\n[[a]]"),
        ("aot-to-table", "[[a]]\n[a]"),
        ("aot-to-scalar", "[[a]]\n[a.b]\na=1\n[a]\n"),
        ("aot-child-scalar-conflict", "[[a]]\nb=1\n[[a.b]]"),
        ("aot-inline-sealed", "[[a]]\nb={}\n[a.b.c]"),
        ("aot-static-array-extension", "[[a]]\nb=[]\n[[a.b]]"),
        ("header-missing-close", "[a"),
        ("header-extra-close", "[a]]"),
        ("header-extra-text", "[a] junk"),
        ("header-newline", "[a\n]"),
        ("aot-missing-close", "[[a]"),
        ("aot-extra-close", "[[a]]]"),
        ("header-empty", "[]"),
        ("aot-empty", "[[]]"),
        ("basic-unclosed", "a=\"unterminated"),
        ("literal-unclosed", "a='unterminated"),
        ("basic-newline", "a=\"line\nbreak\""),
        ("literal-newline", "a='line\nbreak'"),
        ("basic-bare-cr", "a=\"a\rb\""),
        ("literal-bare-cr", "a='a\rb'"),
        ("multiline-bare-cr", "a=\"\"\"a\rb\"\"\""),
        ("multiline-literal-bare-cr", "a='''a\rb'''"),
        ("basic-unknown-escape", "a=\"\\q\""),
        ("basic-x-escape", "a=\"\\x41\""),
        ("basic-escape-eof", "a=\"\\"),
        ("basic-short-unicode", "a=\"\\u123\""),
        ("basic-invalid-unicode", "a=\"\\uZZZZ\""),
        ("basic-surrogate-high", "a=\"\\uD800\""),
        ("basic-surrogate-low", "a=\"\\uDFFF\""),
        ("basic-surrogate-pair", "a=\"\\uD83C\\uDF0D\""),
        ("basic-over-unicode", "a=\"\\U00110000\""),
        ("basic-newline-escape", "a=\"a\\\nb\""),
        ("multiline-backslash-space-no-newline", "a=\"\"\"x\\  y\"\"\""),
        ("multiline-comment-continuation", "a=\"\"\"x\\ #comment\ny\"\"\""),
        ("extra-basic-quote", "a=\"\"\"x\"\"\"\"\"\""),
        ("extra-literal-quote", "a='''x''''''"),
        ("bare-cr", "a=1\rb=2"),
        ("formfeed-whitespace", "a=\x0c1"),
        ("bom", "\u{feff}a=1"),
        ("null-value", "a=null"),
        ("true-case", "a=True"),
        ("false-prefix", "a=falsehood"),
        ("false-suffix", "a=false0"),
    ]
    for i in 0..invalids.len {
        add_invalid_plain(&mut cases, invalids[i].0, invalids[i].1)
    }

    invalid_numbers: []string = [
        "00", "01", "+01", "-01", "_1", "1_", "1__0", "0_x1",
        "0x", "0x_1", "0x1_", "0xGG", "0XFF", "-0x1", "+0x1",
        "0o8", "0O7", "0b2", "0B1", "0b_1", "0o_1", "0x1__2",
        ".1", "1.", "+.1", "1.e2", "01.0", "00e1", "1e", "1e+",
        "1e-", "1_e2", "1e_2", "1e+_2", "1.0_", "1._0", "1.0__2",
        "1.0e1_", "1f", "1e2x", "Inf", "NaN", "infinity", "nanx",
        "--1", "+-1", "1+2", "0x1p0",
    ]
    for i in 0..invalid_numbers.len {
        sp := invalid_numbers[i].clone()
        add_invalid_plain(&mut cases, "number-invalid/" + sp, "v=" + sp)
    }

    bin65 := "0b1" + repeat_str("0", 64)
    range_invalids: []string = [
        "-9223372036854775809",
        "18446744073709551616",
        "0x10000000000000000",
        "0o2000000000000000000000",
        bin65,
    ]
    for i in 0..range_invalids.len {
        sp := range_invalids[i].clone()
        add_invalid(&mut cases, "number-range/" + sp, "v=" + sp,
            "integer|range|overflow", true, "Dunder public limits/range contract")
    }

    invalid_temporals: []string = [
        "1979-00-01", "1979-13-01", "1979-02-29", "1900-02-29", "1979-04-31",
        "1979-01-00", "1979-01-32", "1979-1-01", "1979-01-1",
        "24:00:00", "00:60:00", "00:00:60", "00:00:61", "1:00:00", "00:00",
        "00:00:00.", "00:00:00.1_2", "00:00:00Z",
        "1979-05-27T24:00:00Z", "1979-05-27T00:00:00+24:00",
        "1979-05-27T00:00:00+00:60", "1979-05-27T00:00:00+0:00",
        "1979-05-27T00:00:00+0000", "1979-05-27T00:00:00ZZ",
        "1979-05-27T00:00:00.Z", "1979-05-27T00:00:00Zx",
        "1979-05-27  00:00:00Z", "1979-05-27\t00:00:00Z",
    ]
    for i in 0..invalid_temporals.len {
        sp := invalid_temporals[i].clone()
        add_invalid_plain(&mut cases, "temporal-invalid/" + sp, "v=" + sp)
    }
    add_invalid(&mut cases, "temporal/unsupported-leap-second", "v=2016-12-31T23:59:60Z",
        "second|time|date", true, "Dunder public limits/range contract")

    mut ctrl_vals: []i32 = []
    for v in 0..9 { ctrl_vals.push(v) }
    for v in 11..32 { ctrl_vals.push(v) }
    ctrl_vals.push(127)
    contexts: [](string, string, string) = [
        ("comment", "a=1\n# forbidden ", ""),
        ("basic", "a=\"", "\""),
        ("literal", "a='", "'"),
        ("multiline", "a=\"\"\"", "\"\"\""),
        ("multiline-literal", "a='''", "'''"),
    ]
    for vi in 0..ctrl_vals.len {
        v := ctrl_vals[vi]
        hx := hex2_lower(v)
        for ci in 0..contexts.len {
            mut raw: []u8 = []
            bytes.append_utf8(&mut raw, contexts[ci].1)
            raw.push(u8(v))
            bytes.append_utf8(&mut raw, contexts[ci].2)
            add_invalid_bytes(&mut cases, f"control/{contexts[ci].0}-{hx}", move raw,
                "", true, "TOML 1.0 specification")
        }
    }

    add_valid_plain(&mut cases, "limit/depth-array-64",
        "v=" + repeat_str("[", 63) + "0" + repeat_str("]", 63),
        "{\"v\":" + repeat_str("[", 63) + "0" + repeat_str("]", 63) + "}")
    add_invalid(&mut cases, "limit/depth-array-65",
        "v=" + repeat_str("[", 64) + "0" + repeat_str("]", 64),
        "depth|nest", true, "Dunder public limits/range contract")

    add_valid_plain(&mut cases, "limit/depth-inline-64",
        "v=" + repeat_str("{x=", 63) + "0" + repeat_str("}", 63),
        "{\"v\":" + repeat_str("{\"x\":", 63) + "0" + repeat_str("}", 63) + "}")
    add_invalid(&mut cases, "limit/depth-inline-65",
        "v=" + repeat_str("{x=", 64) + "0" + repeat_str("}", 64),
        "depth|nest", true, "Dunder public limits/range contract")

    add_valid_plain(&mut cases, "limit/depth-dotted-64",
        join_x(64) + "=0",
        repeat_str("{\"x\":", 64) + "0" + repeat_str("}", 64))
    add_invalid(&mut cases, "limit/depth-dotted-65",
        join_x(65) + "=0",
        "depth|nest", true, "Dunder public limits/range contract")

    add_valid_plain(&mut cases, "limit/depth-table-64",
        "[" + join_x(64) + "]",
        repeat_str("{\"x\":", 64) + "{}" + repeat_str("}", 64))
    add_invalid(&mut cases, "limit/depth-table-65",
        "[" + join_x(65) + "]",
        "depth|nest", true, "Dunder public limits/range contract")

    mut aot_buf: []u8 = []
    for depth in 1..33 {
        if depth > 1 { aot_buf.push(b'\n') }
        bytes.append_utf8(&mut aot_buf, "[[")
        bytes.append_utf8(&mut aot_buf, join_x(depth))
        bytes.append_utf8(&mut aot_buf, "]]")
    }
    aot := bytes.decode(&aot_buf).unwrap()
    add_valid_plain(&mut cases, "limit/depth-aot-64", aot,
        repeat_str("{\"x\":[", 32) + "{}" + repeat_str("]}", 32))
    add_invalid(&mut cases, "limit/depth-aot-value-65", aot + "\nv=0",
        "depth|nest", true, "Dunder public limits/range contract")
    add_invalid(&mut cases, "limit/depth-aot-66", aot + "\n[[" + join_x(33) + "]]",
        "depth|nest", true, "Dunder public limits/range contract")

    cases.push(Case {
        name: "limit/input-exact-4MiB",
        source: make_comment_bytes(input_limit() - 1),
        ok: true,
        expected_json: "{}",
        expected_tagged: false,
        lexemes: [],
        diagnostic: "",
        invalid_utf8: false,
        location: true,
        oracle: "Dunder public limits/range contract",
    })
    add_invalid_bytes(&mut cases, "limit/input-over-4MiB", make_comment_bytes(input_limit()),
        "4.*MiB|4194304|input.*limit|input.*large", false, "Dunder public limits/range contract")

    cases.push(Case {
        name: "limit/nodes-exact-100000",
        source: make_zeros_source(node_limit() - 2),
        ok: true,
        expected_json: make_zeros_expected_json(node_limit() - 2),
        expected_tagged: false,
        lexemes: [],
        diagnostic: "",
        invalid_utf8: false,
        location: true,
        oracle: "Dunder public limits/range contract",
    })
    add_invalid_bytes(&mut cases, "limit/nodes-over-100000", make_zeros_source(node_limit() - 1),
        "node|value.*limit|too many values", true, "Dunder public limits/range contract")

    cases
}

fn hex_nibble(b: u8) -> i32 {
    if b >= b'0' && b <= b'9' { return i32(b - b'0') }
    if b >= b'a' && b <= b'f' { return i32(b - b'a') + 10 }
    if b >= b'A' && b <= b'F' { return i32(b - b'A') + 10 }
    -1
}

fn push_utf8_cp(out: &mut []u8, cp: i32) {
    if cp <= 0x7F {
        out.push(u8(cp))
    } else if cp <= 0x7FF {
        out.push(u8(0xC0.bit_or(cp.shr(6))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    } else if cp <= 0xFFFF {
        out.push(u8(0xE0.bit_or(cp.shr(12))))
        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    } else {
        out.push(u8(0xF0.bit_or(cp.shr(18))))
        out.push(u8(0x80.bit_or(cp.shr(12).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.shr(6).bit_and(0x3F))))
        out.push(u8(0x80.bit_or(cp.bit_and(0x3F))))
    }
}

fn unescape_json_span(input: &[]u8, start: i32, end: i32, has_esc: bool) -> Option<string> {
    if !has_esc {
        return bytes.decode_range(&input, start, end).ok()
    }
    mut out: []u8 = []
    out.reserve(end - start)
    mut i := start
    while i < end {
        b := input[i]
        if b != b'\\' {
            out.push(b)
            i += 1
            continue
        }
        i += 1
        esc := input[i]
        if esc == b'"' { out.push(b'"'); i += 1 }
        else if esc == b'\\' { out.push(b'\\'); i += 1 }
        else if esc == b'/' { out.push(b'/'); i += 1 }
        else if esc == b'b' { out.push(8); i += 1 }
        else if esc == b'f' { out.push(12); i += 1 }
        else if esc == b'n' { out.push(10); i += 1 }
        else if esc == b'r' { out.push(13); i += 1 }
        else if esc == b't' { out.push(9); i += 1 }
        else if esc == b'u' {
            mut cp := 0
            for k in 1..5 { cp = cp * 16 + hex_nibble(input[i + k]) }
            i += 5
            if cp >= 0xD800 && cp <= 0xDBFF {
                mut low := 0
                for k in 2..6 { low = low * 16 + hex_nibble(input[i + k]) }
                i += 6
                cp = 0x10000 + (cp - 0xD800).shl(10) + (low - 0xDC00)
            }
            push_utf8_cp(&mut out, cp)
        } else {
            return .None
        }
    }
    bytes.decode(&out).ok()
}

fn json_child_key(doc: &json.Doc, child: i32) -> Option<string> {
    unescape_json_span(&doc.input, doc.key_starts[child], doc.key_ends[child], doc.key_escaped[child])
}

fn check_no_duplicate_keys(doc: &json.Doc, node: i32, err: &mut string) -> bool {
    kind := doc.kind(node)
    if kind == .Object {
        count := doc.count(node)
        if count == 0 { return true }
        if count == 1 {
            child := doc.first_child[node]
            return check_no_duplicate_keys(&doc, child, &mut err)
        }
        mut seen := Map<string, i32>::new()
        seen.reserve(count)
        mut cur := doc.first_child[node]
        while cur >= 0 {
            k := json_child_key(&doc, cur)
            if k.is_none() { err = "invalid JSON object key"; return false }
            ks := k.unwrap()
            if !seen.put_new(ks.clone(), cur) {
                err = f"duplicate JSON output key '{ks}'"
                return false
            }
            if !check_no_duplicate_keys(&doc, cur, &mut err) { return false }
            cur = doc.next_sibling[cur]
        }
        return true
    }
    if kind == .Array {
        mut cur := doc.first_child[node]
        while cur >= 0 {
            if !check_no_duplicate_keys(&doc, cur, &mut err) { return false }
            cur = doc.next_sibling[cur]
        }
        return true
    }
    true
}

fn collect_json_numbers(doc: &json.Doc, node: i32, out: &mut []string) {
    kind := doc.kind(node)
    if kind == .Number {
        out.push(doc.raw_span(node))
        return
    }
    if kind == .Array || kind == .Object {
        mut cur := doc.first_child[node]
        while cur >= 0 {
            collect_json_numbers(&doc, cur, &mut out)
            cur = doc.next_sibling[cur]
        }
    }
}

fn is_json_float_span(span: string) -> bool {
    for i in 0..span.len {
        b := span[i]
        if b == b'.' || b == b'e' || b == b'E' { return true }
    }
    false
}

fn parse_decimal(s: string) -> CanonDecimal {
    bad := CanonDecimal { ok: false, neg: false, is_zero: false, digits: "", exp: 0 }
    if s.len == 0 { return bad }
    mut i := 0
    mut neg := false
    if s[i] == b'-' { neg = true; i += 1 }
    else if s[i] == b'+' { i += 1 }
    mut raw_digits: []u8 = []
    raw_digits.reserve(s.len)
    mut saw_dot := false
    mut frac_count: i64 = 0
    while i < s.len {
        b := s[i]
        if b >= b'0' && b <= b'9' {
            raw_digits.push(b)
            if saw_dot { frac_count += 1 }
            i += 1
        } else if b == b'.' && !saw_dot {
            saw_dot = true
            i += 1
        } else {
            break
        }
    }
    if raw_digits.len == 0 { return bad }
    mut exp: i64 = 0
    if i < s.len && (s[i] == b'e' || s[i] == b'E') {
        i += 1
        mut exp_neg := false
        if i < s.len && s[i] == b'-' { exp_neg = true; i += 1 }
        else if i < s.len && s[i] == b'+' { i += 1 }
        if i >= s.len || s[i] < b'0' || s[i] > b'9' { return bad }
        while i < s.len && s[i] >= b'0' && s[i] <= b'9' {
            if exp > 100000000000000 { return bad }
            exp = exp * 10 + i64(s[i] - b'0')
            i += 1
        }
        if exp_neg { exp = -exp }
    }
    if i != s.len { return bad }
    mut start := 0
    while start < raw_digits.len && raw_digits[start] == b'0' { start += 1 }
    if start == raw_digits.len {
        return CanonDecimal { ok: true, neg: neg, is_zero: true, digits: "0", exp: 0 }
    }
    mut end := raw_digits.len
    while end > start && raw_digits[end - 1] == b'0' { end -= 1 }
    trailing_zeros := i64(raw_digits.len - end)
    sig := bytes.decode_range(&raw_digits, start, end).unwrap()
    CanonDecimal { ok: true, neg: neg, is_zero: false, digits: sig, exp: exp - frac_count + trailing_zeros }
}

fn decimals_equal(a: &CanonDecimal, b: &CanonDecimal, check_zero_sign: bool) -> bool {
    if !a.ok || !b.ok { return false }
    if a.is_zero || b.is_zero {
        if a.is_zero != b.is_zero { return false }
        if check_zero_sign { return a.neg == b.neg }
        return true
    }
    a.neg == b.neg && a.exp == b.exp && a.digits == b.digits
}

fn is_ascii_digit(b: u8) -> bool { b >= b'0' && b <= b'9' }

fn normalize_temporal(spelling: string) -> string {
    mut buf: []u8 = []
    buf.reserve(spelling.len)
    for i in 0..spelling.len {
        mut b := spelling[i]
        if b == b't' || b == b' ' { b = b'T' }
        else if b == b'z' { b = b'Z' }
        buf.push(b)
    }
    mut s := bytes.decode(&buf).unwrap()
    if text.ends_with(s, "+00:00") || text.ends_with(s, "-00:00") {
        s = s[0..(s.len - 6)] + "Z"
    }
    mut tz_start := s.len
    if s.len >= 1 && s[s.len - 1] == b'Z' {
        tz_start = s.len - 1
    } else if s.len >= 6 &&
              (s[s.len - 6] == b'+' || s[s.len - 6] == b'-') &&
              is_ascii_digit(s[s.len - 5]) && is_ascii_digit(s[s.len - 4]) &&
              s[s.len - 3] == b':' &&
              is_ascii_digit(s[s.len - 2]) && is_ascii_digit(s[s.len - 1]) {
        tz_start = s.len - 6
    }
    mut dot := -1
    for i in 0..tz_start {
        if s[i] == b'.' { dot = i; break }
    }
    if dot < 0 || dot + 1 >= tz_start { return s }
    for i in (dot + 1)..tz_start {
        if !is_ascii_digit(s[i]) { return s }
    }
    mut frac_end := tz_start
    while frac_end > dot + 1 && s[frac_end - 1] == b'0' { frac_end -= 1 }
    if frac_end == dot + 1 {
        return s[0..dot] + s[tz_start..s.len]
    }
    s[0..frac_end] + s[tz_start..s.len]
}

fn object_map(doc: &json.Doc, obj: i32) -> Map<string, i32> {
    mut m := Map<string, i32>::new()
    m.reserve(doc.count(obj))
    mut cur := doc.first_child[obj]
    while cur >= 0 {
        k := json_child_key(&doc, cur)
        if k.is_some() { m.put(k.unwrap(), cur) }
        cur = doc.next_sibling[cur]
    }
    m
}

fn compare_direct(act_doc: &json.Doc, act_node: i32, exp_doc: &json.Doc, exp_node: i32, path: string, err: &mut string) -> bool {
    ak := act_doc.kind(act_node)
    ek := exp_doc.kind(exp_node)
    if ak != ek {
        err = f"{path}: kind mismatch (expected {ek.str()}, got {ak.str()})"
        return false
    }
    if ek == .Null { return true }
    if ek == .Bool {
        if act_doc.as_bool(act_node) != exp_doc.as_bool(exp_node) {
            err = f"{path}: bool mismatch (expected {exp_doc.raw_span(exp_node)}, got {act_doc.raw_span(act_node)})"
            return false
        }
        return true
    }
    if ek == .String {
        av := act_doc.as_str(act_node)
        ev := exp_doc.as_str(exp_node)
        if av != ev {
            err = f"{path}: string mismatch (expected {exp_doc.raw_json(exp_node)}, got {act_doc.raw_json(act_node)})"
            return false
        }
        return true
    }
    if ek == .Number {
        a_span := act_doc.raw_span(act_node)
        e_span := exp_doc.raw_span(exp_node)
        a_float := is_json_float_span(a_span)
        e_float := is_json_float_span(e_span)
        if a_float != e_float {
            err = f"{path}: numeric kind mismatch (expected {e_span}, got {a_span})"
            return false
        }
        a_dec := parse_decimal(a_span)
        e_dec := parse_decimal(e_span)
        if !decimals_equal(&a_dec, &e_dec, e_float) {
            err = f"{path}: numeric value mismatch (expected {e_span}, got {a_span})"
            return false
        }
        return true
    }
    if ek == .Array {
        ac := act_doc.count(act_node)
        ec := exp_doc.count(exp_node)
        if ac != ec {
            err = f"{path}: array length mismatch (expected {ec}, got {ac})"
            return false
        }
        mut acur := act_doc.first_child[act_node]
        mut ecur := exp_doc.first_child[exp_node]
        mut idx := 0
        while ecur >= 0 {
            if !compare_direct(&act_doc, acur, &exp_doc, ecur, f"{path}[{idx}]", &mut err) { return false }
            acur = act_doc.next_sibling[acur]
            ecur = exp_doc.next_sibling[ecur]
            idx += 1
        }
        return true
    }
    if ek == .Object {
        ac := act_doc.count(act_node)
        ec := exp_doc.count(exp_node)
        if ac != ec {
            err = f"{path}: object size mismatch (expected {ec}, got {ac})"
            return false
        }
        if ec == 0 { return true }
        if ec == 1 {
            acur := act_doc.first_child[act_node]
            ecur := exp_doc.first_child[exp_node]
            ak_opt := json_child_key(&act_doc, acur)
            ek_opt := json_child_key(&exp_doc, ecur)
            if ak_opt != ek_opt {
                ek_s := ek_opt.unwrap_or("?")
                ak_s := ak_opt.unwrap_or("?")
                err = f"{path}: object key mismatch (expected {ek_s}, got {ak_s})"
                return false
            }
            ek_s := ek_opt.unwrap_or("?")
            return compare_direct(&act_doc, acur, &exp_doc, ecur, f"{path}.{ek_s}", &mut err)
        }
        amap := object_map(&act_doc, act_node)
        mut ecur := exp_doc.first_child[exp_node]
        while ecur >= 0 {
            ek_opt := json_child_key(&exp_doc, ecur)
            if ek_opt.is_none() { err = f"{path}: invalid expected key"; return false }
            key := ek_opt.unwrap()
            anode := amap.get_or(key.clone(), -1)
            if anode < 0 {
                err = f"{path}: missing key '{key}'"
                return false
            }
            if !compare_direct(&act_doc, anode, &exp_doc, ecur, f"{path}.{key}", &mut err) { return false }
            ecur = exp_doc.next_sibling[ecur]
        }
        return true
    }
    err = f"{path}: invalid JSON node kind"
    false
}

fn expect_tagged_scalar_obj(act_doc: &json.Doc, act_node: i32, tag: string, path: string, err: &mut string) -> Option<string> {
    if act_doc.kind(act_node) != .Object || act_doc.count(act_node) != 1 {
        err = f"{path}: expected tagged object {tag}, got {act_doc.raw_json(act_node)}"
        return .None
    }
    child := act_doc.first_child[act_node]
    key_opt := json_child_key(&act_doc, child)
    if key_opt != .Some(tag.clone()) || act_doc.kind(child) != .String {
        err = f"{path}: expected tagged string {tag}, got {act_doc.raw_json(act_node)}"
        return .None
    }
    act_doc.as_str(child)
}

fn compare_tagged(act_doc: &json.Doc, act_node: i32, exp_doc: &json.Doc, exp_node: i32, path: string, err: &mut string) -> bool {
    ek := exp_doc.kind(exp_node)
    if ek == .Array {
        if act_doc.kind(act_node) != .Array {
            err = f"{path}: expected array, got {act_doc.kind(act_node).str()}"
            return false
        }
        ac := act_doc.count(act_node)
        ec := exp_doc.count(exp_node)
        if ac != ec {
            err = f"{path}: array length mismatch (expected {ec}, got {ac})"
            return false
        }
        mut acur := act_doc.first_child[act_node]
        mut ecur := exp_doc.first_child[exp_node]
        mut idx := 0
        while ecur >= 0 {
            if !compare_tagged(&act_doc, acur, &exp_doc, ecur, f"{path}[{idx}]", &mut err) { return false }
            acur = act_doc.next_sibling[acur]
            ecur = exp_doc.next_sibling[ecur]
            idx += 1
        }
        return true
    }
    if ek != .Object {
        err = f"{path}: unexpected non-object in tagged toml-test JSON"
        return false
    }

    // Check if exp_node is a tagged leaf: {"type": "<kind>", "value": "<spelling>"}.
    if exp_doc.count(exp_node) == 2 {
        t_node := exp_doc.field(exp_node, "type")
        v_node := exp_doc.field(exp_node, "value")
        if t_node >= 0 && v_node >= 0 && exp_doc.kind(t_node) == .String && exp_doc.kind(v_node) == .String {
            kind := exp_doc.as_str(t_node).unwrap_or("")
            spelling := exp_doc.as_str(v_node).unwrap_or("")
            if kind == "string" {
                if act_doc.kind(act_node) != .String || act_doc.as_str(act_node) != .Some(spelling.clone()) {
                    err = f"{path}: string mismatch (expected {json.quote(spelling)}, got {act_doc.raw_json(act_node)})"
                    return false
                }
                return true
            }
            if kind == "bool" {
                if spelling != "true" && spelling != "false" {
                    err = f"{path}: invalid expected bool '{spelling}'"
                    return false
                }
                expected_b := spelling == "true"
                if act_doc.kind(act_node) != .Bool || act_doc.as_bool(act_node) != .Some(expected_b) {
                    err = f"{path}: bool mismatch (expected {spelling}, got {act_doc.raw_json(act_node)})"
                    return false
                }
                return true
            }
            if kind == "integer" {
                if act_doc.kind(act_node) != .Number {
                    err = f"{path}: expected integer number, got {act_doc.raw_json(act_node)}"
                    return false
                }
                a_span := act_doc.raw_span(act_node)
                if is_json_float_span(a_span) {
                    err = f"{path}: expected integer, got float {a_span}"
                    return false
                }
                a_dec := parse_decimal(a_span)
                e_dec := parse_decimal(spelling)
                if !decimals_equal(&a_dec, &e_dec, false) {
                    err = f"{path}: integer mismatch (expected {spelling}, got {a_span})"
                    return false
                }
                return true
            }
            if kind == "float" {
                low := text.lower(spelling)
                if low == "inf" || low == "+inf" || low == "infinity" || low == "+infinity" {
                    got := expect_tagged_scalar_obj(&act_doc, act_node, "$toml_float", path, &mut err)
                    if got.is_none() { return false }
                    got_s := got.unwrap()
                    if got_s != "inf" {
                        err = f"{path}: expected +inf, got {got_s}"
                        return false
                    }
                    return true
                }
                if low == "-inf" || low == "-infinity" {
                    got := expect_tagged_scalar_obj(&act_doc, act_node, "$toml_float", path, &mut err)
                    if got.is_none() { return false }
                    got_s := got.unwrap()
                    if got_s != "-inf" {
                        err = f"{path}: expected -inf, got {got_s}"
                        return false
                    }
                    return true
                }
                if low == "nan" || low == "+nan" || low == "-nan" {
                    got := expect_tagged_scalar_obj(&act_doc, act_node, "$toml_float", path, &mut err)
                    if got.is_none() { return false }
                    got_s := got.unwrap()
                    if got_s != "nan" {
                        err = f"{path}: expected nan, got {got_s}"
                        return false
                    }
                    return true
                }
                if act_doc.kind(act_node) != .Number {
                    err = f"{path}: expected float number, got {act_doc.raw_json(act_node)}"
                    return false
                }
                a_span := act_doc.raw_span(act_node)
                if !is_json_float_span(a_span) {
                    err = f"{path}: expected float, got integer {a_span}"
                    return false
                }
                a_dec := parse_decimal(a_span)
                e_dec := parse_decimal(spelling)
                if !decimals_equal(&a_dec, &e_dec, true) {
                    err = f"{path}: float mismatch (expected {spelling}, got {a_span})"
                    return false
                }
                return true
            }
            mut tag := ""
            if kind == "datetime" || kind == "datetime-local" { tag = "$toml_datetime" }
            else if kind == "date-local" { tag = "$toml_date" }
            else if kind == "time-local" { tag = "$toml_time" }
            else {
                err = f"{path}: unknown toml-test tag type '{kind}'"
                return false
            }
            got_opt := expect_tagged_scalar_obj(&act_doc, act_node, tag, path, &mut err)
            if got_opt.is_none() { return false }
            got_s := got_opt.unwrap()
            if normalize_temporal(got_s) != normalize_temporal(spelling) {
                err = f"{path}: temporal mismatch (expected {spelling}, got {got_s})"
                return false
            }
            return true
        }
    }

    // Regular table object.
    if act_doc.kind(act_node) != .Object {
        err = f"{path}: expected object, got {act_doc.kind(act_node).str()}"
        return false
    }
    ac := act_doc.count(act_node)
    ec := exp_doc.count(exp_node)
    if ac != ec {
        err = f"{path}: object size mismatch (expected {ec}, got {ac})"
        return false
    }
    if ec == 0 { return true }
    if ec == 1 {
        acur := act_doc.first_child[act_node]
        ecur := exp_doc.first_child[exp_node]
        ak_opt := json_child_key(&act_doc, acur)
        ek_opt := json_child_key(&exp_doc, ecur)
        if ak_opt != ek_opt {
            ek_s := ek_opt.unwrap_or("?")
            ak_s := ak_opt.unwrap_or("?")
            err = f"{path}: object key mismatch (expected {ek_s}, got {ak_s})"
            return false
        }
        ek_s := ek_opt.unwrap_or("?")
        return compare_tagged(&act_doc, acur, &exp_doc, ecur, f"{path}.{ek_s}", &mut err)
    }
    amap := object_map(&act_doc, act_node)
    mut ecur := exp_doc.first_child[exp_node]
    while ecur >= 0 {
        ek_opt := json_child_key(&exp_doc, ecur)
        if ek_opt.is_none() { err = f"{path}: invalid expected key"; return false }
        key := ek_opt.unwrap()
        anode := amap.get_or(key.clone(), -1)
        if anode < 0 {
            err = f"{path}: missing key '{key}'"
            return false
        }
        if !compare_tagged(&act_doc, anode, &exp_doc, ecur, f"{path}.{key}", &mut err) { return false }
        ecur = exp_doc.next_sibling[ecur]
    }
    true
}

fn line_byte_lengths(raw: &[]u8) -> []i32 {
    mut lengths: []i32 = []
    mut start := 0
    for i in 0..raw.len {
        if raw[i] == 10 {
            lengths.push(i - start)
            start = i + 1
        }
    }
    lengths.push(raw.len - start)
    lengths
}

fn check_location(error_msg: string, source: &[]u8, err: &mut string) -> bool {
    prefix := "TOML line "
    at_opt := text.find(error_msg, prefix)
    if at_opt.is_none() {
        err = f"missing 'TOML line L, column C: ...' location in diagnostic: {error_msg}"
        return false
    }
    mut i := at_opt.unwrap() + prefix.len
    if i >= error_msg.len || error_msg[i] < b'1' || error_msg[i] > b'9' {
        err = f"invalid line number in diagnostic: {error_msg}"
        return false
    }
    mut line := 0
    while i < error_msg.len && is_ascii_digit(error_msg[i]) {
        line = line * 10 + i32(error_msg[i] - b'0')
        i += 1
    }
    col_sep := ", column "
    if i + col_sep.len > error_msg.len || error_msg[i..(i + col_sep.len)] != col_sep {
        err = f"missing ', column ' in diagnostic: {error_msg}"
        return false
    }
    i += col_sep.len
    if i >= error_msg.len || error_msg[i] < b'1' || error_msg[i] > b'9' {
        err = f"invalid column number in diagnostic: {error_msg}"
        return false
    }
    mut column := 0
    while i < error_msg.len && is_ascii_digit(error_msg[i]) {
        column = column * 10 + i32(error_msg[i] - b'0')
        i += 1
    }
    if i + 2 >= error_msg.len || error_msg[i] != b':' || error_msg[i + 1] != b' ' || error_msg[i + 2] == b'\n' {
        err = f"missing diagnostic message after location: {error_msg}"
        return false
    }
    lengths := line_byte_lengths(&source)
    if line < 1 || line > lengths.len {
        err = f"diagnostic line {line} exceeds source line count {lengths.len}: {error_msg}"
        return false
    }
    max_col := lengths[line - 1] + 1
    if column < 1 || column > max_col {
        err = f"diagnostic column {column} exceeds line {line} byte length+1 ({max_col}): {error_msg}"
        return false
    }
    true
}

fn matches_diagnostic(error_msg: string, pattern: string) -> bool {
    err_l := text.lower(error_msg)
    pat_l := text.lower(pattern)
    alts := text.split(pat_l, "|")
    for alt in &alts {
        pieces := text.split(alt, ".*")
        mut cursor := 0
        mut all_ok := true
        for piece in &pieces {
            if piece.len == 0 { continue }
            tail := err_l[cursor..err_l.len]
            match text.find(tail, piece) {
                .Some(off) => { cursor = cursor + off + piece.len },
                .None => { all_ok = false; break },
            }
        }
        if all_ok { return true }
    }
    false
}

fn check_lexemes(doc: &json.Doc, lexemes: &[]LexemeCheck, err: &mut string) -> bool {
    for li in 0..lexemes.len {
        mut node := doc.root
        for si in 0..lexemes[li].path.len {
            step := &lexemes[li].path[si]
            if step.is_index {
                node = doc.at(node, step.index)
            } else {
                node = doc.field(node, step.key)
            }
            if node < 0 {
                err = f"lexeme path lookup failed for expected spelling '{lexemes[li].spelling}'"
                return false
            }
        }
        if doc.kind(node) != .Number {
            err = f"lexeme target is not a number (expected '{lexemes[li].spelling}')"
            return false
        }
        got := doc.raw_span(node)
        if got != lexemes[li].spelling {
            err = f"lexeme mismatch: expected '{lexemes[li].spelling}', got '{got}'"
            return false
        }
    }
    true
}

fn verify_case(c: &Case, rec: &json.Doc, err: &mut string) -> bool {
    source_ok_opt := rec.get_bool(rec.root, "source_ok")
    ok_opt := rec.get_bool(rec.root, "ok")
    json_ok_opt := rec.get_bool(rec.root, "json_ok")
    error_opt := rec.get_str(rec.root, "error")
    json_str_opt := rec.get_str(rec.root, "json")
    nums_node := rec.field(rec.root, "numbers")

    if source_ok_opt.is_none() || ok_opt.is_none() || json_ok_opt.is_none() ||
       error_opt.is_none() || json_str_opt.is_none() || rec.kind(nums_node) != .Array {
        err = "malformed driver result record"
        return false
    }
    source_ok := source_ok_opt.unwrap()
    ok := ok_opt.unwrap()
    json_ok := json_ok_opt.unwrap()
    rec_error := error_opt.unwrap()
    rec_json := json_str_opt.unwrap()

    if source_ok == c.invalid_utf8 {
        err = f"source_ok={source_ok} disagrees with invalid_utf8={c.invalid_utf8}"
        return false
    }
    if ok != c.ok {
        err = f"ok={ok} disagrees with expected ok={c.ok} (oracle: {c.oracle}, error: {rec_error})"
        return false
    }
    if !c.ok {
        if rec_json.len != 0 || rec.count(nums_node) != 0 {
            err = "rejected case emitted non-empty json or numbers"
            return false
        }
        if json_ok {
            err = "rejected case reported json_ok=true"
            return false
        }
        if rec_error.len == 0 {
            err = "rejected case produced empty diagnostic"
            return false
        }
        if c.invalid_utf8 {
            if !text.contains(rec_error, "UTF-8") {
                err = f"invalid UTF-8 diagnostic missing 'UTF-8': {rec_error}"
                return false
            }
        } else if c.location {
            if !check_location(rec_error, &c.source, &mut err) { return false }
        }
        if c.diagnostic.len > 0 && !matches_diagnostic(rec_error, c.diagnostic) {
            err = f"diagnostic '{rec_error}' did not match expected pattern '{c.diagnostic}'"
            return false
        }
        return true
    }

    if !source_ok || rec_error.len != 0 {
        err = f"accepted case reported source_ok={source_ok} or non-empty error '{rec_error}'"
        return false
    }
    if !json_ok {
        err = "accepted case reported json_ok=false"
        return false
    }

    act_doc := json.Doc::parse_text(rec_json)
    if !act_doc.ok {
        err = f"driver emitted invalid JSON: {act_doc.error}"
        return false
    }
    if !check_no_duplicate_keys(&act_doc, act_doc.root, &mut err) { return false }

    mut numeric_spans: []string = []
    collect_json_numbers(&act_doc, act_doc.root, &mut numeric_spans)
    rec_num_count := rec.count(nums_node)
    if numeric_spans.len != rec_num_count {
        err = f"numeric span count mismatch (parsed {numeric_spans.len}, driver reported {rec_num_count})"
        return false
    }
    mut ncur := rec.first_child[nums_node]
    mut ni := 0
    while ncur >= 0 {
        got_n := rec.as_str(ncur)
        if got_n != .Some(numeric_spans[ni].clone()) {
            got_s := got_n.unwrap_or("?")
            err = f"numeric span {ni} mismatch (parsed '{numeric_spans[ni]}', driver '{got_s}')"
            return false
        }
        ncur = rec.next_sibling[ncur]
        ni += 1
    }

    exp_doc := json.Doc::parse_text(c.expected_json)
    if !exp_doc.ok {
        err = f"internal error: invalid expected JSON for {c.name}: {exp_doc.error}"
        return false
    }
    if c.expected_tagged {
        if !compare_tagged(&act_doc, act_doc.root, &exp_doc, exp_doc.root, "$", &mut err) { return false }
    } else {
        if !compare_direct(&act_doc, act_doc.root, &exp_doc, exp_doc.root, "$", &mut err) { return false }
    }

    if c.lexemes.len > 0 && !check_lexemes(&act_doc, &c.lexemes, &mut err) { return false }
    true
}

fn load_contract_cases(path: string, cases: &mut []Case) -> bool {
    raw := sys.read_u8(path)
    if !raw.ok { return harness.fail(f"cannot read contract fixture {path}") }
    doc := json.Doc::parse_bytes(move raw.value)
    if !doc.ok || doc.kind(doc.root) != .Object {
        return harness.fail(f"invalid contract fixture JSON {path}: {doc.error}")
    }
    items := doc.field(doc.root, "cases")
    if doc.kind(items) != .Array {
        return harness.fail(f"contract fixture {path} missing 'cases' array")
    }
    prefix := "contract/" + harness.stem(path) + "/"
    mut cur := doc.first_child[items]
    while cur >= 0 {
        if doc.kind(cur) != .Object { return harness.fail(f"invalid case entry in {path}") }
        name_opt := doc.get_str(cur, "name")
        text_opt := doc.get_str(cur, "text")
        ok_opt := doc.get_bool(cur, "parse_ok")
        if name_opt.is_none() || text_opt.is_none() || ok_opt.is_none() {
            return harness.fail(f"contract case missing name/text/parse_ok in {path}")
        }
        full_name := prefix + name_opt.unwrap()
        src_text := text_opt.unwrap()
        if ok_opt.unwrap() {
            exp_opt := doc.get_str(cur, "expected_json")
            if exp_opt.is_none() {
                return harness.fail(f"valid contract case {full_name} missing expected_json")
            }
            exp_s := exp_opt.unwrap()
            exp_doc := json.Doc::parse_text(exp_s)
            mut dup_err := ""
            if !exp_doc.ok || !check_no_duplicate_keys(&exp_doc, exp_doc.root, &mut dup_err) {
                return harness.fail(f"invalid expected_json in {full_name}: {exp_doc.error} {dup_err}")
            }
            add_valid(&mut cases, full_name, src_text, exp_s, [], "fixture JSON")
        } else {
            add_invalid(&mut cases, full_name, src_text, "", true, "fixture rejection")
        }
        cur = doc.next_sibling[cur]
    }
    true
}

fn load_upstream_cases(dir: string, cases: &mut []Case) -> bool {
    resolved := fs.realpath(dir)
    if !resolved.ok { return harness.fail(f"upstream corpus directory not found: {dir}") }
    mut root := resolved.value
    if sys.metadata(root + "/tests").is_dir { root = root + "/tests" }
    manifest_path := root + "/files-toml-1.0.0"
    manifest := sys.read_text(manifest_path)
    if !manifest.ok {
        return harness.fail(f"missing upstream manifest {manifest_path}")
    }
    entries := harness.lines(manifest.value)
    for entry in &entries {
        if !text.ends_with(entry, ".toml") { continue }
        file_path := root + "/" + entry
        raw := sys.read_u8(file_path)
        if !raw.ok { return harness.fail(f"cannot read upstream fixture {file_path}") }
        is_valid := text.starts_with(entry, "valid/")
        decoded := bytes.decode(&raw.value)
        if decoded.is_err() {
            if is_valid {
                return harness.fail(f"valid upstream fixture has invalid UTF-8: {entry}")
            }
            cases.push(Case {
                name: "upstream/" + entry,
                source: move raw.value,
                ok: false,
                expected_json: "",
                expected_tagged: false,
                lexemes: [],
                diagnostic: "",
                invalid_utf8: true,
                location: true,
                oracle: "toml-test invalid UTF-8 / Dunder string creation boundary",
            })
            continue
        }
        if is_valid {
            json_path := file_path[0..(file_path.len - 5)] + ".json"
            exp_text := sys.read_text(json_path)
            if !exp_text.ok {
                return harness.fail(f"missing upstream expected JSON {json_path}")
            }
            exp_doc := json.Doc::parse_text(exp_text.value)
            if !exp_doc.ok {
                return harness.fail(f"invalid upstream expected JSON {json_path}: {exp_doc.error}")
            }
            cases.push(Case {
                name: "upstream/" + entry,
                source: move raw.value,
                ok: true,
                expected_json: move exp_text.value,
                expected_tagged: true,
                lexemes: [],
                diagnostic: "",
                invalid_utf8: false,
                location: true,
                oracle: "toml-test typed JSON",
            })
        } else {
            cases.push(Case {
                name: "upstream/" + entry,
                source: move raw.value,
                ok: false,
                expected_json: "",
                expected_tagged: false,
                lexemes: [],
                diagnostic: "",
                invalid_utf8: false,
                location: true,
                oracle: "toml-test TOML 1.0 manifest",
            })
        }
    }
    true
}

fn create_temp_work(root: string) -> string {
    base := root + "/build"
    if !fs.mkdir_all(base).ok { return "" }
    pid := sys.pid()
    now := sys.now_ms()
    for attempt in 0..1000 {
        candidate := f"{base}/toml-acceptance-{pid}-{now}-{attempt}"
        st := sys.mkdir(candidate)
        if st.ok {
            rp := fs.realpath(candidate)
            if rp.ok { return rp.value }
            return candidate
        }
        if st.error != 17 { return "" }
    }
    ""
}

fn build_drivers_and_stage_cases(compiler: string, root: string, work: string,
                                 cases: &[]Case, paths: &mut []string,
                                 compute_digests: bool) -> BuildResult {
    targets := harness.targets()
    driver_src := root + "/tests/fixtures/toml-driver.ddr"
    mut images: []string = []
    mut digests: []string = []
    for target in &targets {
        images.push(work + "/toml-driver-" + target)
        digests.push("")
    }

    mut pool := process.ChildSet::new(targets.len)
    defer { pool.kill_all() }

    mut slot_target: []i32 = []
    mut slot_start: []i64 = []
    mut slot_out: []string = []
    mut slot_err: []string = []
    for _ in 0..targets.len {
        slot_target.push(-1)
        slot_start.push(0)
        slot_out.push("")
        slot_err.push("")
    }

    for ti in 0..targets.len {
        mut cmd := process.Command::new(compiler.clone(), [
            "build", driver_src.clone(),
            "--target", targets[ti].clone(),
            "--jobs", "1",
            "-o", images[ti].clone(),
        ])
        cmd.set_cwd(root.clone())
        sp := cmd.spawn()
        if sp.is_err() {
            _ := harness.fail(f"failed to spawn build for {targets[ti]} (error {sp.unwrap_err().code()})")
            return BuildResult { ok: false, builds: 0, images: images, digests: digests }
        }
        mut child := sp.unwrap()
        slot := pool.insert(&mut child)
        assert(slot >= 0)
        slot_target[slot] = ti
        slot_start[slot] = sys.now_ms()
    }

    paths.reserve(cases.len)
    for i in 0..cases.len {
        path := f"{work}/case-{pad4(i)}.toml"
        if !sys.write_u8(path, &cases[i].source).ok {
            _ := harness.fail(f"cannot write case file {path}")
            return BuildResult { ok: false, builds: 0, images: images, digests: digests }
        }
        paths.push(move path)
    }

    mut raw_out: []u8 = []
    mut raw_err: []u8 = []
    mut done := 0
    timeout_ms: i64 = 300000
    while done < targets.len {
        _ := pool.poll_io(50)
        now := sys.now_ms()
        for slot in 0..targets.len {
            if !pool.is_active(slot) { continue }
            ti := slot_target[slot]
            raw_out.clear()
            raw_err.clear()
            mut w := pool.try_wait(slot, &mut raw_out, &mut raw_err)
            if !w.exited && now - slot_start[slot] >= timeout_ms {
                w = pool.kill_reap(slot, &mut raw_out, &mut raw_err)
            }
            if raw_out.len > 0 {
                slot_out[slot] += bytes.decode(&raw_out).unwrap_or_default()
            }
            if raw_err.len > 0 {
                slot_err[slot] += bytes.decode(&raw_err).unwrap_or_default()
            }
            if w.exited {
                done += 1
                if !w.ok || w.timed_out || w.signal != 0 || w.code != 0 {
                    _ := harness.fail(f"build toml-driver for {targets[ti]} failed (code={w.code}, signal={w.signal}, timed_out={w.timed_out})\nstdout: {slot_out[slot]}\nstderr: {slot_err[slot]}")
                    return BuildResult { ok: false, builds: done, images: images, digests: digests }
                }
                if !sys.metadata(images[ti]).is_file {
                    _ := harness.fail(f"built image missing for {targets[ti]}: {images[ti]}")
                    return BuildResult { ok: false, builds: done, images: images, digests: digests }
                }
                if compute_digests {
                    digests[ti] = harness.sha256_file_hex(images[ti])
                }
            }
        }
    }

    BuildResult { ok: true, builds: targets.len, images: images, digests: digests }
}

fn split_lf_bytes(data: &[]u8, end_exclusive: i32) -> []LineSpan {
    mut spans: []LineSpan = []
    mut start := 0
    for i in 0..end_exclusive {
        if data[i] == 10 {
            spans.push(LineSpan { start: start, end: i })
            start = i + 1
        }
    }
    spans.push(LineSpan { start: start, end: end_exclusive })
    spans
}

fn write_manifest(work: string, cases: &[]Case, paths: &[]string) -> string {
    mut w := json.Writer::new()
    w.array()
    for i in 0..cases.len {
        w.object()
        w.key("name"); w.string(cases[i].name)
        w.key("source_file"); w.string(harness.basename(paths[i]))
        w.key("source_sha256"); w.string(harness.sha256_bytes_hex(&cases[i].source))
        w.key("parse_ok"); w.boolean(cases[i].ok)
        w.key("invalid_utf8"); w.boolean(cases[i].invalid_utf8)
        w.key("oracle"); w.string(cases[i].oracle)
        w.end()
    }
    w.end()
    res := w.finish()
    if res.is_err() { return "" }
    text_out := res.unwrap() + "\n"
    if !sys.write_text(work + "/cases.json", text_out).ok { return "" }
    raw := bytes.from_text(text_out)
    harness.sha256_bytes_hex(&raw)
}

fn write_summary_or_receipt(path: string, schema: string, compiler: string, root: string,
                            cases: &[]Case, builds: i32, executions: i32, assertions: i32,
                            targets: &[]string, image_digests: &[]string,
                            executed_targets: &[]string, manifest_sha: string,
                            corpus_dirs: &[]string) -> bool {
    parent := harness.parent_dir(path)
    if parent.len > 0 && !fs.mkdir_all(parent).ok {
        return harness.fail(f"cannot create directory {parent}")
    }
    mut accepted := 0
    mut rejected := 0
    mut utf8_boundaries := 0
    for i in 0..cases.len {
        if cases[i].ok { accepted += 1 } else { rejected += 1 }
        if cases[i].invalid_utf8 { utf8_boundaries += 1 }
    }
    mut w := json.Writer::new()
    w.object()
    if schema.len > 0 {
        w.key("schema"); w.string(schema)
        w.key("passed"); w.boolean(true)
        w.key("host_target"); w.string(process.host_target())
    }
    w.key("cases"); w.integer(i64(cases.len))
    w.key("accepted"); w.integer(i64(accepted))
    w.key("rejected"); w.integer(i64(rejected))
    w.key("utf8_boundaries"); w.integer(i64(utf8_boundaries))
    w.key("images_built"); w.integer(i64(builds))
    w.key("targets_executed"); w.integer(i64(executions))
    w.key("case_assertions"); w.integer(i64(assertions))
    w.key("executed_targets")
    w.array()
    for t in executed_targets { w.string(t) }
    w.end()
    w.key("compiler"); w.string(compiler)
    w.key("compiler_sha256"); w.string(harness.sha256_file_hex(compiler))
    w.key("driver_source_sha256"); w.string(harness.sha256_file_hex(root + "/tests/fixtures/toml-driver.ddr"))
    if manifest_sha.len > 0 {
        w.key("case_manifest_sha256"); w.string(manifest_sha)
    }
    w.key("image_sha256")
    w.object()
    for i in 0..targets.len {
        w.key(targets[i]); w.string(image_digests[i])
    }
    w.end()
    w.key("known_policy")
    w.array()
    w.string("positive integers through u64 max")
    w.string("year 0000 retained lexically")
    w.string("leap seconds rejected with a diagnostic")
    w.end()
    w.key("upstream")
    if corpus_dirs.len == 0 {
        w.null()
    } else if corpus_dirs.len == 1 {
        w.string(corpus_dirs[0])
    } else {
        w.array()
        for d in corpus_dirs { w.string(d) }
        w.end()
    }
    w.end()
    evidence.save(path, &w)
}

fn main() -> i32 {
    spec: []cli.Option = [
        cli.option("--corpus"),
        cli.option("--toml-test"),
        cli.option("--runner"),
        cli.option("--contracts"),
        cli.option("--work"),
        cli.option("--only"),
        cli.option("--receipt"),
    ]
    usage := "usage: test_toml <compiler> [--corpus DIR] [--toml-test DIR] [--runner TARGET=COMMAND] [--contracts PATH] [--work DIR] [--only SUBSTR] [--receipt PATH]"
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, usage)
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }

    runner_specs := args.all("--runner")
    runners := native.Runners::new(&runner_specs)
    if runners.error.len != 0 {
        _ := sys.eprint(runners.error)
        return 2
    }

    root := harness.find_root()
    if root.len == 0 {
        _ := harness.fail("could not locate Dunder repository root")
        return 1
    }

    mut cases := grammar_cases()
    default_corpus := root + "/tests/fixtures/toml-workflow-corpus.json"
    if sys.metadata(default_corpus).is_file {
        if !load_contract_cases(default_corpus, &mut cases) { return 1 }
    }
    contracts := args.all("--contracts")
    for contract_path in &contracts {
        if !load_contract_cases(contract_path, &mut cases) { return 1 }
    }

    mut corpus_dirs: []string = []
    corpus_opt := args.all("--corpus")
    for d in &corpus_opt { corpus_dirs.push(d.clone()) }
    toml_test_opt := args.all("--toml-test")
    for d in &toml_test_opt { corpus_dirs.push(d.clone()) }
    for d in &corpus_dirs {
        if !load_upstream_cases(d, &mut cases) { return 1 }
    }

    only_filter := args.last("--only", "")
    if only_filter.len > 0 {
        mut filtered: []Case = []
        for c in move cases {
            if text.contains(c.name, only_filter) { filtered.push(move c) }
        }
        cases = move filtered
    }

    if cases.len == 0 {
        _ := harness.fail("no selected TOML cases")
        return 1
    }
    mut seen_names := Map<string, bool>::new()
    seen_names.reserve(cases.len)
    for i in 0..cases.len {
        if !seen_names.put_new(cases[i].name.clone(), true) {
            _ := harness.fail(f"duplicate case name: {cases[i].name}")
            return 1
        }
    }

    work_arg := args.last("--work", "")
    receipt_path := args.last("--receipt", "")
    keep_work := work_arg.len > 0
    mut work := ""
    if keep_work {
        work = harness.resolve_or_abs(work_arg)
        if !fs.mkdir_all(work).ok {
            _ := harness.fail(f"cannot create work directory {work}")
            return 1
        }
        rp := fs.realpath(work)
        if rp.ok { work = rp.value }
    } else {
        work = create_temp_work(root)
        if work.len == 0 {
            _ := harness.fail("cannot create temporary work directory under build/")
            return 1
        }
    }
    defer {
        if !keep_work { _ := fs.remove_all(work) }
    }

    want_digests := keep_work || receipt_path.len > 0
    mut paths: []string = []
    built := build_drivers_and_stage_cases(compiler, root, work, &cases, &mut paths, want_digests)
    if !built.ok { return 1 }

    mut manifest_sha := ""
    if keep_work {
        manifest_sha = write_manifest(work, &cases, &paths)
        if manifest_sha.len == 0 {
            _ := harness.fail("cannot write cases.json manifest")
            return 1
        }
    }

    mut invalid_utf8_count := 0
    for i in 0..cases.len {
        if cases[i].invalid_utf8 { invalid_utf8_count += 1 }
    }

    targets := harness.targets()
    mut executed_targets: []string = []
    mut executions := 0
    mut assertions := 0
    mut output := harness.empty_output()

    for ti in 0..targets.len {
        target := targets[ti].clone()
        if !runners.can_run(target) { continue }
        executed_targets.push(target.clone())

        mut saved_records: []u8 = []
        mut first_saved := true
        if keep_work { saved_records.push(b'[') }

        mut start := 0
        while start < cases.len {
            mut batch_end := start + 100
            if batch_end > cases.len { batch_end = cases.len }
            mut batch_paths: []string = []
            batch_paths.reserve(batch_end - start)
            for idx in start..batch_end { batch_paths.push(paths[idx].clone()) }

            if !runners.run(target, built.images[ti], batch_paths, root, 0, &mut output) {
                return 1
            }
            if output.stderr.len != 0 {
                _ := harness.fail(f"{target}: unexpected stderr from toml-driver:\n{output.stderr_text()}")
                return 1
            }
            if output.stdout.len == 0 || output.stdout[output.stdout.len - 1] != 10 {
                _ := harness.fail(f"{target}: batch at {start} missing LF protocol terminator")
                return 1
            }

            // Protocol records are strictly LF-delimited bytes (U+0085/U+2028/U+2029 inside JSON are not boundaries).
            spans := split_lf_bytes(&output.stdout, output.stdout.len - 1)
            expected_lines := batch_end - start
            if spans.len != expected_lines {
                _ := harness.fail(f"{target}: batch at {start} returned {spans.len} lines, expected {expected_lines}")
                return 1
            }

            for offset in 0..expected_lines {
                idx := start + offset
                mut line_bytes: []u8 = []
                line_bytes.reserve(spans[offset].end - spans[offset].start)
                bytes.extend_range(&mut line_bytes, &output.stdout, spans[offset].start, spans[offset].end)
                if keep_work {
                    if !first_saved { saved_records.push(b',') }
                    first_saved = false
                    bytes.append_utf8(&mut saved_records, "{\"case\":")
                    json.write_str(&mut saved_records, cases[idx].name)
                    bytes.append_utf8(&mut saved_records, ",\"record\":")
                    bytes.extend(&mut saved_records, &line_bytes)
                    saved_records.push(b'}')
                }
                rec_doc := json.Doc::parse_bytes(move line_bytes)
                mut check_err := ""
                if !rec_doc.ok || rec_doc.kind(rec_doc.root) != .Object ||
                   !check_no_duplicate_keys(&rec_doc, rec_doc.root, &mut check_err) {
                    _ := harness.fail(f"{target} {cases[idx].name}: invalid driver JSON record: {rec_doc.error} {check_err}")
                    return 1
                }
                if rec_doc.get_str(rec_doc.root, "file") != .Some(paths[idx].clone()) {
                    _ := harness.fail(f"{target} {cases[idx].name}: file field mismatch")
                    return 1
                }
                if !verify_case(&cases[idx], &rec_doc, &mut check_err) {
                    _ := harness.fail(f"{target} {cases[idx].name}: {check_err}")
                    return 1
                }
                assertions += 1
            }
            start = batch_end
        }

        if keep_work {
            saved_records.push(b']')
            saved_records.push(b'\n')
            if !sys.write_u8(work + "/results-" + target + ".json", &saved_records).ok {
                _ := harness.fail(f"cannot write results-{target}.json")
                return 1
            }
        }
        executions += 1
        print(f"PASS {target}: {cases.len - invalid_utf8_count} TOML parser cases, {invalid_utf8_count} UTF-8 input-boundary cases")
    }

    if keep_work {
        if !write_summary_or_receipt(work + "/summary.json", "", compiler, root, &cases,
                                     built.builds, executions, assertions, &targets, &built.digests,
                                     &executed_targets, manifest_sha, &corpus_dirs) {
            return 1
        }
    }
    if receipt_path.len > 0 {
        if !write_summary_or_receipt(receipt_path, "dunder-toml-verification/v1", compiler, root, &cases,
                                     built.builds, executions, assertions, &targets, &built.digests,
                                     &executed_targets, manifest_sha, &corpus_dirs) {
            return 1
        }
    }

    print(f"TOML: {built.builds} images built once each; {executions} target runtimes, {assertions} case results; exact numeric kinds/spans, Unicode, tables, arrays of tables, sealing, diagnostics and limits passed")
    0
}
