capability process, filesystem

import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import std.sha256 as sha256
import std.text as text
import sys

pub struct BaseCli {
    ok: bool,
    compiler: string,
    root: string,
    baseline: string,
    source_root: string,
    output_dir: string,
    cc: string,
    graphics: bool,
    expect_bug: bool,
    extra_args: []string,
    error: string,
}

fn is_dunder_root(dir: string) -> bool {
    if dir.len == 0 { return false }
    for file in ["selfhost/main.ddr", "stdlib/modules.txt", "tools/verify-selfhost.sh"] {
        entry := sys.metadata(f"{dir}/{file}")
        if !entry.ok || !entry.is_file { return false }
    }
    true
}

pub fn parent_dir(path: string) -> string {
    mut end := path.len
    while end > 1 && path[end - 1] == 47 { end -= 1 }
    mut i := end - 1
    while i >= 0 {
        if path[i] == 47 {
            if i == 0 { return "/" }
            return path[0..i]
        }
        i -= 1
    }
    ""
}

pub fn basename(path: string) -> string {
    mut end := path.len
    while end > 1 && path[end - 1] == 47 { end -= 1 }
    mut i := end - 1
    while i >= 0 {
        if path[i] == 47 {
            return path[(i + 1)..end]
        }
        i -= 1
    }
    path[0..end]
}

pub fn stem(path: string) -> string {
    name := basename(path)
    mut i := name.len - 1
    while i > 0 {
        if name[i] == 46 { return name[0..i] }
        i -= 1
    }
    name
}

fn root_ancestor(move start: string) -> string {
    mut directory := start
    for _ in 0..8 {
        if is_dunder_root(directory) { return directory }
        parent := parent_dir(directory)
        if parent.len == 0 || parent == directory { break }
        directory = parent
    }
    ""
}

pub fn find_root() -> string {
    cwd := fs.cwd()
    if cwd.ok {
        root := root_ancestor(move cwd.value)
        if root.len > 0 { return root }
    }
    executable := fs.realpath(sys.arg(0))
    if executable.ok { return root_ancestor(parent_dir(executable.value)) }
    ""
}

pub fn resolve_or_abs(path: string) -> string {
    rp := fs.realpath(path)
    if rp.ok { return rp.value }
    if path.len > 0 && path[0] == 47 { return path.clone() }
    cur := fs.cwd()
    if cur.ok { return cur.value + "/" + path }
    path.clone()
}

fn invalid_cli(move root: string, move source_root: string, move cc: string, move error: string) -> BaseCli {
    BaseCli {
        ok: false, compiler: "", root: root, baseline: "", source_root: source_root,
        output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: error,
    }
}

pub fn parse_cli() -> BaseCli {
    root := find_root()
    mut compiler := ""
    mut baseline := ""
    mut source_root := root.clone()
    mut output_dir := ""
    mut cc := process.env_or("CC", "cc")
    mut graphics := false
    mut expect_bug := false
    mut extras: []string = []

    count := sys.arg_count()
    mut i := 1
    while i < count {
        arg := sys.arg(i)
        if arg == "--graphics" {
            graphics = true
        } else if arg == "--expect-bug" {
            expect_bug = true
        } else if arg == "--baseline" || arg == "--source-root" || arg == "--output" || arg == "--cc" {
            i += 1
            if i >= count {
                return invalid_cli(move root, move source_root, move cc, f"missing argument after {arg}")
            }
            value := sys.arg(i)
            if arg == "--baseline" {
                path := fs.realpath(value)
                if !path.ok {
                    return invalid_cli(move root, move source_root, move cc, f"baseline compiler not found: {value}")
                }
                baseline = path.value
            } else if arg == "--source-root" {
                source_root = resolve_or_abs(value)
            } else if arg == "--output" {
                output_dir = resolve_or_abs(value)
            } else {
                cc = value
            }
        } else if compiler.len == 0 {
            rp := fs.realpath(arg)
            if !rp.ok {
                return invalid_cli(move root, move source_root, move cc, f"compiler not found: {arg}")
            }
            compiler = rp.value
        } else {
            extras.push(move arg)
        }
        i += 1
    }
    if compiler.len == 0 {
        return invalid_cli(move root, move source_root, move cc, "missing compiler path argument")
    }
    if root.len == 0 {
        return invalid_cli("", "", move cc, "could not locate dunder repository root")
    }
    BaseCli {
        ok: true,
        compiler: compiler,
        root: root,
        baseline: baseline,
        source_root: source_root,
        output_dir: output_dir,
        cc: cc,
        graphics: graphics,
        expect_bug: expect_bug,
        extra_args: extras,
        error: "",
    }
}

pub fn host_id() -> i32 {
    t := process.host_target()
    if t == "arm64-macos" { return 0 }
    if t == "arm64-linux" { return 1 }
    2
}

pub fn target_name(id: i32) -> string {
    if id == 0 { return "arm64-macos" }
    if id == 1 { return "arm64-linux" }
    if id == 2 { return "x86_64-linux" }
    ""
}

pub fn targets() -> []string {
    ["arm64-macos", "arm64-linux", "x86_64-linux"]
}

pub fn fail(msg: string) -> bool {
    _ := sys.eprint("FAIL: " + msg)
    false
}

fn is_space(byte: i32) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13
}

pub fn fields(s: string) -> []string {
    mut out: []string = []
    mut i := 0
    while i < s.len {
        while i < s.len && is_space(s[i]) { i += 1 }
        if i >= s.len { break }
        start := i
        while i < s.len && !is_space(s[i]) { i += 1 }
        out.push(s[start..i])
    }
    out
}

pub fn lines(s: string) -> []string {
    mut result: []string = []
    mut start := 0
    for i in 0..s.len {
        if s[i] == 10 {
            end := if i > start && s[i - 1] == 13 { i - 1 } else { i }
            result.push(s[start..end])
            start = i + 1
        }
    }
    if start < s.len {
        end := if s[s.len - 1] == 13 { s.len - 1 } else { s.len }
        result.push(s[start..end])
    }
    result
}

pub fn sha256_bytes_hex(data: &[]u8) -> string {
    dig := sha256.digest_bytes(&data)
    bytes.hex_u8(&dig)
}

pub fn sha256_file_hex(path: string) -> string {
    r := sys.read_u8(path)
    assert(r.ok)
    sha256_bytes_hex(&r.value)
}

pub fn copy_ddr_files(src_dir: string, dst_dir: string) -> bool {
    ls := fs.list_dir(src_dir)
    if !ls.ok { return fail("list_dir failed on " + src_dir) }
    for name in ls.entries {
        if text.ends_with(name, ".ddr") {
            data := sys.read_u8(src_dir + "/" + name)
            if !data.ok { return fail("read_u8 failed on " + name) }
            if !sys.write_u8(dst_dir + "/" + name, &data.value).ok {
                return fail("write_u8 failed on " + name)
            }
        }
    }
    true
}

pub fn fixture_diagnostics(root: string) -> json.Doc {
    data := sys.read_u8(f"{root}/tests/fixtures/diagnostics.json")
    json.Doc::parse_bytes(move data.value)
}

pub fn collect_error_fixtures(root: string) -> []string {
    mut out: []string = []
    fix_dir := root + "/tests/fixtures"
    dirs := fs.list_dir(fix_dir)
    if !dirs.ok { return out }
    for d in dirs.entries {
        if text.ends_with(d, "_errors") {
            sub := fix_dir + "/" + d
            files := fs.list_dir(sub)
            if files.ok {
                for f in files.entries {
                    if text.ends_with(f, ".ddr") {
                        rp := fs.realpath(sub + "/" + f)
                        if rp.ok { out.push(move rp.value) }
                    }
                }
            }
        }
    }
    array.sort_strings(&mut out)
    out
}

pub fn exec_cmd(program: string, args: []string, cwd: string, empty_path: bool, timeout_ms: i64) -> process.Output {
    mut cmd := process.command(program.clone(), args.clone())
    if cwd.len > 0 { process.set_cwd(&mut cmd, cwd.clone()) }
    if empty_path {
        process.clear_env(&mut cmd)
        process.set_env(&mut cmd, "PATH", "")
    }
    process.set_timeout(&mut cmd, timeout_ms)
    process.exec(&cmd)
}

pub fn run_checked(program: string, args: []string, cwd: string, expected_code: i32, empty_path: bool, out_res: &mut process.Output) -> bool {
    run_checked_timeout(program, args, cwd, expected_code, empty_path, 90000, &mut out_res)
}

pub fn run_checked_timeout(program: string, args: []string, cwd: string, expected_code: i32, empty_path: bool, timeout_ms: i64, out_res: &mut process.Output) -> bool {
    res := exec_cmd(program, args, cwd, empty_path, timeout_ms)
    if !res.ok || res.timed_out || res.signal != 0 || res.code != expected_code {
        mut command := program.clone()
        for arg in args { command = command + " " + arg }
        return fail(f"{command} exited {res.code} (signal {res.signal}, timed out: {res.timed_out}), expected {expected_code}\nstdout: {process.stdout_text(&res)}\nstderr: {process.stderr_text(&res)}")
    }
    out_res = res
    true
}

pub fn empty_output() -> process.Output {
    process.Output { ok: false, error: 0, code: 0, signal: 0, timed_out: false, stdout: [], stderr: [] }
}

pub fn run_target_image(target: string, image: string, cwd: string, out_res: &mut process.Output) -> bool {
    run_target_image_timeout(target, image, cwd, 90000, &mut out_res)
}

fn run_target_image_timeout(target: string, image: string, cwd: string, timeout_ms: i64, out_res: &mut process.Output) -> bool {
    if target == "wasm32" {
        loader := "const fs = require('node:fs'); " +
            "const instance = new WebAssembly.Instance(new WebAssembly.Module(fs.readFileSync(process.argv[1])), " +
            "{dunder: {print_i32: console.log, print_text: () => {}}}); instance.exports.main();"
        return run_checked_timeout("node", ["-e", loader, image.clone()], cwd, 0, false, timeout_ms, &mut out_res)
    }
    run_checked_timeout(image, [], cwd, 0, false, timeout_ms, &mut out_res)
}

pub fn check_agent_error(compiler: string, path: string, expected: string, cwd: string) -> bool {
    check_agent_error_timeout(compiler, path, expected, cwd, 90000)
}

fn check_agent_error_timeout(compiler: string, path: string, expected: string, cwd: string, timeout_ms: i64) -> bool {
    mut checked := empty_output()
    if !run_checked_timeout(compiler, ["check", path.clone(), "--agent", "--jobs", "4"], cwd, 1, false, timeout_ms, &mut checked) { return false }
    report := process.stdout_text(&checked)
    doc := json.Doc::parse_text(report)
    kind := doc.get_str(doc.root, "kind")
    message := doc.get_str(doc.root, "message")
    source := doc.get_str(doc.root, "path")
    start := doc.get_i64(doc.root, "start")
    end := doc.get_i64(doc.root, "end")
    file := sys.metadata(path)
    if !doc.ok || !kind.ok || kind.value != "error" || !message.ok || text.find(message.value, expected) < 0 ||
       !source.ok || source.value != path || !start.ok || !end.ok || start.value < 0 || start.value >= end.value ||
       !file.ok || end.value > file.size {
        return fail(f"expected {expected} with a source span in {path}: {report}")
    }
    true
}

pub fn stdout_is(result: &process.Output, expected: string, context: string) -> bool {
    actual := process.stdout_text(&result)
    actual == expected || fail(f"{context}: expected stdout {expected}, got {actual}")
}

pub fn run_specialization_matrix(compiler: string, source: string, work: string, expected: string) -> bool {
    host := process.host_target()
    mut all_targets := targets()
    all_targets.push("wasm32")
    mut result := empty_output()
    for target in all_targets {
        image := work + "/" + target
        for optimized in [true, false] {
            workers := if optimized && target == host { "4" } else { "1" }
            mut args: []string = ["build", source.clone(), "--target", target.clone(), "--jobs", workers, "-o", image.clone()]
            if !optimized {
                args.push("--mir=off")
                args.push("--scalar-opt=off")
                args.push("--ownership-opt=off")
            }
            if !run_checked_timeout(compiler, args, work, 0, false, 120000, &mut result) { return false }
            if target == host || target == "wasm32" {
                if !run_target_image_timeout(target, image, work, 120000, &mut result) || !stdout_is(&result, expected, target) { return false }
            }
        }
    }
    cached := work + "/incremental.ddr"
    data := sys.read_u8(source)
    if !data.ok || !sys.write_u8(cached, &data.value).ok { return fail(f"cannot copy {source} to {cached}") }
    for _ in 0..2 {
        if !run_checked_timeout(compiler, ["run", cached.clone(), "--incremental", "--jobs", "4"], work, 0, false, 120000, &mut result) ||
           !stdout_is(&result, expected, "incremental") { return false }
    }
    true
}

pub fn check_rejected_specializations(compiler: string, work: string, cases: &[](string, string)) -> bool {
    image := work + "/previous-image"
    mut result := empty_output()
    for index in 0..cases.len {
        code := cases[index].0 + "\n"
        message := cases[index].1.clone()
        path := f"{work}/invalid-{index}.ddr"
        if !sys.write_text(path, code).ok || !sys.write_text(image, "previous image").ok {
            return fail(f"cannot prepare specialization diagnostic {index}")
        }
        if !check_agent_error_timeout(compiler, path, message, work, 120000) ||
           !run_checked_timeout(compiler, ["build", path.clone(), "-o", image.clone()], work, 1, false, 120000, &mut result) { return false }
        if text.find(process.stderr_text(&result), message) < 0 {
            return fail(f"missing {message} in {path}: {process.stderr_text(&result)}")
        }
        previous := sys.read_text(image)
        if !previous.ok || previous.value != "previous image" { return fail(f"rejected build changed {image}") }
    }
    true
}
