capability process, filesystem

import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.process as process
import std.sha256 as sha256
import std.text as text
import sys

pub struct BaseCli {
    ok: bool,
    compiler: string,
    root: string,
    baseline: string,
    source_root: string,
    output_dir: string,
    cc: string,
    graphics: bool,
    expect_bug: bool,
    extra_args: []string,
    error: string,
}

fn is_dunder_root(dir: string) -> bool {
    if dir.len == 0 { return false }
    a := sys.metadata(dir + "/selfhost/main.ddr")
    b := sys.metadata(dir + "/stdlib/modules.txt")
    c := sys.metadata(dir + "/tools/verify-selfhost.sh")
    a.ok && a.is_file && b.ok && b.is_file && c.ok && c.is_file
}

pub fn parent_dir(path: string) -> string {
    var end := path.len
    while end > 1 && path[end - 1] == 47 { end -= 1 }
    var i := end - 1
    while i >= 0 {
        if path[i] == 47 {
            if i == 0 { return "/" }
            return path[0..i]
        }
        i -= 1
    }
    ""
}

pub fn basename(path: string) -> string {
    var end := path.len
    while end > 1 && path[end - 1] == 47 { end -= 1 }
    var i := end - 1
    while i >= 0 {
        if path[i] == 47 {
            return path[(i + 1)..end]
        }
        i -= 1
    }
    path[0..end]
}

pub fn stem(path: string) -> string {
    name := basename(path)
    var i := name.len - 1
    while i > 0 {
        if name[i] == 46 { return name[0..i] }
        i -= 1
    }
    name
}

pub fn find_root() -> string {
    cur := fs.cwd()
    if cur.ok {
        var d := cur.value
        for _ in 0..8 {
            if is_dunder_root(d) { return d }
            next := parent_dir(d)
            if next.len == 0 || next == d { break }
            d = next
        }
    }
    arg0 := fs.realpath(sys.arg(0))
    if arg0.ok {
        var d := parent_dir(arg0.value)
        for _ in 0..8 {
            if is_dunder_root(d) { return d }
            next := parent_dir(d)
            if next.len == 0 || next == d { break }
            d = next
        }
    }
    ""
}

pub fn resolve_or_abs(path: string) -> string {
    rp := fs.realpath(path)
    if rp.ok { return rp.value }
    if path.len > 0 && path[0] == 47 { return path }
    cur := fs.cwd()
    if cur.ok { return cur.value + "/" + path }
    path
}

pub fn parse_cli() -> BaseCli {
    root := find_root()
    var compiler := ""
    var baseline := ""
    var source_root := root
    var output_dir := ""
    var cc := process.env_or("CC", "cc")
    var graphics := false
    var expect_bug := false
    var extras: []string = []

    count := sys.arg_count()
    var i := 1
    while i < count {
        a := sys.arg(i)
        if a == "--graphics" {
            graphics = true
        } else if a == "--expect-bug" {
            expect_bug = true
        } else if a == "--baseline" {
            if i + 1 >= count {
                return BaseCli { ok: false, compiler: "", root: root, baseline: "", source_root: source_root, output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "missing argument after --baseline" }
            }
            i += 1
            rp := fs.realpath(sys.arg(i))
            if !rp.ok {
                return BaseCli { ok: false, compiler: "", root: root, baseline: "", source_root: source_root, output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "baseline compiler not found: " + sys.arg(i) }
            }
            baseline = rp.value
        } else if a == "--source-root" {
            if i + 1 >= count {
                return BaseCli { ok: false, compiler: "", root: root, baseline: "", source_root: source_root, output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "missing argument after --source-root" }
            }
            i += 1
            source_root = resolve_or_abs(sys.arg(i))
        } else if a == "--output" {
            if i + 1 >= count {
                return BaseCli { ok: false, compiler: "", root: root, baseline: "", source_root: source_root, output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "missing argument after --output" }
            }
            i += 1
            output_dir = resolve_or_abs(sys.arg(i))
        } else if a == "--cc" {
            if i + 1 >= count {
                return BaseCli { ok: false, compiler: "", root: root, baseline: "", source_root: source_root, output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "missing argument after --cc" }
            }
            i += 1
            cc = sys.arg(i)
        } else if compiler.len == 0 {
            rp := fs.realpath(a)
            if !rp.ok {
                return BaseCli { ok: false, compiler: "", root: root, baseline: "", source_root: source_root, output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "compiler not found: " + a }
            }
            compiler = rp.value
        } else {
            extras.push(a)
        }
        i += 1
    }
    if compiler.len == 0 {
        return BaseCli { ok: false, compiler: "", root: root, baseline: "", source_root: source_root, output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "missing compiler path argument" }
    }
    if root.len == 0 {
        return BaseCli { ok: false, compiler: "", root: "", baseline: "", source_root: "", output_dir: "", cc: cc, graphics: false, expect_bug: false, extra_args: [], error: "could not locate dunder repository root" }
    }
    BaseCli {
        ok: true,
        compiler: compiler,
        root: root,
        baseline: baseline,
        source_root: source_root,
        output_dir: output_dir,
        cc: cc,
        graphics: graphics,
        expect_bug: expect_bug,
        extra_args: extras,
        error: "",
    }
}

pub fn host_id() -> i32 {
    t := process.host_target()
    if t == "arm64-macos" { return 0 }
    if t == "arm64-linux" { return 1 }
    2
}

pub fn target_name(id: i32) -> string {
    if id == 0 { return "arm64-macos" }
    if id == 1 { return "arm64-linux" }
    if id == 2 { return "x86_64-linux" }
    "wasm32"
}

pub fn targets() -> []string {
    ["arm64-macos", "arm64-linux", "x86_64-linux", "wasm32"]
}

pub fn fail(msg: string) -> bool {
    _ := sys.eprint("FAIL: " + msg)
    false
}

pub fn bytes_equal(a: &[]u8, b: &[]u8) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len {
        if a[i] != b[i] { return false }
    }
    true
}

pub fn sha256_bytes_hex(data: &[]u8) -> string {
    dig := sha256.digest_bytes(&data)
    bytes.hex_u8(&dig)
}

pub fn sha256_file_hex(path: string) -> string {
    r := sys.read_u8(path)
    assert(r.ok)
    sha256_bytes_hex(&r.value)
}

pub fn copy_ddr_files(src_dir: string, dst_dir: string) -> bool {
    ls := fs.list_dir(src_dir)
    if !ls.ok { return fail("list_dir failed on " + src_dir) }
    for name in ls.entries {
        if text.ends_with(name, ".ddr") {
            data := sys.read_u8(src_dir + "/" + name)
            if !data.ok { return fail("read_u8 failed on " + name) }
            if !sys.write_u8(dst_dir + "/" + name, &data.value).ok {
                return fail("write_u8 failed on " + name)
            }
        }
    }
    true
}

pub fn collect_error_fixtures(root: string) -> []string {
    var out: []string = []
    fix_dir := root + "/tests/fixtures"
    dirs := fs.list_dir(fix_dir)
    if !dirs.ok { return out }
    for d in dirs.entries {
        if text.ends_with(d, "_errors") {
            sub := fix_dir + "/" + d
            files := fs.list_dir(sub)
            if files.ok {
                for f in files.entries {
                    if text.ends_with(f, ".ddr") {
                        rp := fs.realpath(sub + "/" + f)
                        if rp.ok { out.push(rp.value) }
                    }
                }
            }
        }
    }
    array.sort_strings(&mut out)
    out
}

pub fn exec_cmd(program: string, args: []string, cwd: string, empty_path: bool, timeout_ms: i64) -> process.Output {
    var cmd := process.command(program, args)
    if cwd.len > 0 { process.set_cwd(&mut cmd, cwd) }
    if empty_path {
        process.clear_env(&mut cmd)
        process.set_env(&mut cmd, "PATH", "")
    }
    process.set_timeout(&mut cmd, timeout_ms)
    process.exec(&cmd)
}

pub fn run_checked(program: string, args: []string, cwd: string, expected_code: i32, empty_path: bool, out_res: &mut process.Output) -> bool {
    res := exec_cmd(program, args, cwd, empty_path, 90000)
    if !res.ok || res.timed_out || res.signal != 0 || res.code != expected_code {
        return fail(program + " exited " + res.code.str() + " (signal " + res.signal.str() + "), expected " + expected_code.str() + "\nstdout: " + process.stdout_text(&res) + "\nstderr: " + process.stderr_text(&res))
    }
    out_res = res
    true
}

pub fn js_runtime() -> string {
    env_rt := process.env_or("DUNDER_JS", "")
    if env_rt.len > 0 { return env_rt }
    for dir in text.split(process.env_or("PATH", ""), ":") {
        if dir.len > 0 && sys.metadata(dir + "/bun").is_file { return dir + "/bun" }
    }
    home := process.env_or("HOME", "")
    if home.len > 0 {
        for cand in [home + "/.local/share/mise/shims/bun", home + "/.local/bin/bun", home + "/.bun/bin/bun"] {
            if sys.metadata(cand).is_file { return cand }
        }
    }
    "node"
}

pub fn run_wasm_contract(root: string, image: string, cwd: string, expected_code: i32, repeat: bool) -> bool {
    var args: []string = [root + "/tools/runtime-contract-wasm.cjs", image]
    if repeat { args.push("--repeat") }
    var res := process.Output { ok: false, error: 0, code: 0, signal: 0, timed_out: false, stdout: [], stderr: [] }
    run_checked(js_runtime(), args, cwd, expected_code, false, &mut res)
}

pub fn empty_output() -> process.Output {
    process.Output { ok: false, error: 0, code: 0, signal: 0, timed_out: false, stdout: [], stderr: [] }
}
