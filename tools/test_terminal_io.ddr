capability unsafe, stdio, process
import std.bytes
import std.process
import std.terminal
import sys

@link("c")
extern "C" {
    fn openpty(master: ptr, slave: ptr, name: ptr, mode: ptr, size: ptr) -> i32
    fn tcgetattr(fd: i32, state: ptr) -> i32
    fn fstat(fd: i32, state: ptr) -> i32
}

fn attributes(fd: i32) -> [u64; 16] {
    mut state: [u64; 16] = [0; 16]
    unsafe { assert(tcgetattr(fd, addr(&mut state[0])) == 0) }
    state
}

fn identity(fd: i32) -> (u64, u64) {
    mut state: [u64; 32] = [0; 32]
    unsafe { assert(fstat(fd, addr(&mut state[0])) == 0) }
    (state[0], state[1])
}

fn same_mode(a: &[u64; 16], b: &[u64; 16]) -> bool {
    for i in 0..16 {
        difference := a[i].bit_xor(b[i])
        if target_is("macos") && i == 3 {
            if difference.bit_and(u64(0x20000000).bit_not()) != 0 { return false }
        } else if difference != 0 { return false }
    }
    true
}

fn raw_on(fd: i32) -> bool {
    before := attributes(fd)
    _guard := terminal.RawMode::enter_on(i64(fd)).unwrap()
    !same_mode(&before, &attributes(fd))
}

fn child() -> i32 {
    size := terminal.size().unwrap()
    before := attributes(0)
    _guard := terminal.RawMode::enter().unwrap()
    assert(!same_mode(&attributes(0), &before))
    print(size.columns)
    return size.rows
}

fn main() -> i32 {
    if sys.arg_count() > 1 && sys.arg(1) == "--child" { return child() }
    if sys.arg_count() > 1 && sys.arg(1) == "--help" { return 0 }
    mut master: [i32; 2] = [-1; 2]
    mut slave: [i32; 2] = [-1; 2]
    mut saved: [u64; 16] = [0; 16]
    mut children: []process.Child = []
    stdin := identity(0); stdout := identity(1); stderr := identity(2)
    defer {
        unsafe { for fd in &master { if fd >= 0 { _ := sys.fd_close(fd) } }; for fd in &slave { if fd >= 0 { _ := sys.fd_close(fd) } } }
    }
    for i in 0..2 {
        size: [u16; 4] = [u16(21 + i), u16(81 + i), if i == 0 { u16(65535) } else { u16(0) }, if i == 0 { u16(0) } else { u16(719) }]
        unsafe { assert(openpty(addr(&mut master[i]), addr(&mut slave[i]), ptr(0), ptr(0), addr(&size[0])) == 0) }
        if i == 0 { saved = attributes(slave[i]) } else { assert(same_mode(&saved, &attributes(slave[i]))) }
        extent := terminal.window_size(i64(slave[i])).unwrap()
        assert(extent.columns == 81 + i && extent.rows == 21 + i)
        assert(extent.pixel_width == i32(size[2]) && extent.pixel_height == i32(size[3]))
        assert(raw_on(slave[i]))
        assert(same_mode(&saved, &attributes(slave[i])))
        cmd := process.Command::new(sys.arg(0), ["--child"])
        handle := usize(slave[i])
        children.push(cmd.spawn_with_handles(.Some(handle), .Some(handle), .Some(handle)).unwrap())
    }
    for i in 0..2 {
        status := children[i].wait(5000)
        assert(status.ok && status.exited && status.code == 21 + i)
        mut output: []u8 = []
        output.reserve(32)
        unsafe { assert(sys.fd_read(master[i], &mut output, 32) == 3) }
        assert(bytes.decode(&output).unwrap() == (81 + i).str() + "\n")
        line := bytes.from_text("q\n")
        mut readback: []u8 = []
        readback.reserve(16)
        unsafe {
            assert(sys.fd_write(master[i], &line, 0, 2) == 2)
            assert(sys.fd_read(slave[i], &mut readback, 16) == 2)
        }
        assert(bytes.equal(&line, &readback) && same_mode(&saved, &attributes(slave[i])))
    }
    assert(identity(0) == stdin && identity(1) == stdout && identity(2) == stderr)
    print("PASS terminal size, raw mode restoration and independent child descriptors")
    0
}
