capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn ranges_and_enumerate_program() -> string {
    "capability unsafe\n" +
    "fn sum_range_val(r: range) -> i32 {\n" +
    "    mut total := 0\n" +
    "    for x in r { total += x }\n" +
    "    total\n" +
    "}\n" +
    "fn closed(lo: i32, hi: i32) -> range { lo..=hi }\n" +
    "fn open(lo: i32, hi: i32) -> range { lo..hi }\n" +
    "fn range_count(r: range) -> i32 { mut n := 0; for _ in r { n += 1; if n > 3 { break } }; n }\n" +
    "struct DropLog { drops: i32 }\n" +
    "fn log_drop(log: &mut DropLog) { log.drops += 1 }\n" +
    "@resource(dispose)\n" +
    "struct Token {\n" +
    "    id: i32,\n" +
    "    log: ptr,\n" +
    "}\n" +
    "impl Token {\n" +
    "    fn make(id: i32, log: &mut DropLog) -> Self {\n" +
    "        unsafe { Self { id: id, log: addr(&mut log) } }\n" +
    "    }\n" +
    "    fn dispose(&self) {\n" +
    "        if self.id >= 0 {\n" +
    "            unsafe { log_drop(ref_at(self.log)) }\n" +
    "        }\n" +
    "    }\n" +
    "}\n" +
    "fn take_token(move t: Token) -> i32 { t.id }\n" +
    "fn main() {\n" +
    "    mut inc := 0\n" +
    "    for i in 0..=5 { inc += i }\n" +
    "    assert(inc == 15)\n" +
    "    mut single := 0\n" +
    "    for i in 4..=4 { single += i }\n" +
    "    assert(single == 4)\n" +
    "    mut empty := 0\n" +
    "    for i in 5..=3 { empty += i + 1 }\n" +
    "    assert(empty == 0)\n" +
    "    mut neg := 0\n" +
    "    for i in -2..=2 { neg += i }\n" +
    "    assert(neg == 0)\n" +
    "    mut near_max_sum: i64 = 0\n" +
    "    mut near_max_count := 0\n" +
    "    for i in 2147483645..=2147483647 {\n" +
    "        near_max_sum += i64(i)\n" +
    "        near_max_count += 1\n" +
    "    }\n" +
    "    assert(near_max_count == 3)\n" +
    "    assert(near_max_sum == i64(2147483645) + i64(2147483646) + i64(2147483647))\n" +
    "    assert(range_count(closed(2147483646, 2147483647)) == 2)\n" +
    "    assert(sum_range_val(closed(2147483647, 2147483647)) == 2147483647)\n" +
    "    assert(range_count(closed(2147483647, -2147483648)) == 0)\n" +
    "    assert(range_count(closed(-2147483648, 2147483647)) == 4)\n" +
    "    assert(range_count(closed(-2147483648, -2147483648)) == 1)\n" +
    "    assert(range_count(open(-2147483648, -2147483648)) == 0)\n" +
    "    assert(range_count(open(0, -2147483648)) == 0)\n" +
    "    assert(range_count(open(-2147483648, -2147483647)) == 1)\n" +
    "    mut brk := 0\n" +
    "    for i in 1..=10 {\n" +
    "        if i == 2 { continue }\n" +
    "        brk += i\n" +
    "        if i == 4 { break }\n" +
    "    }\n" +
    "    assert(brk == 1 + 3 + 4)\n" +
    "    stored_r := 1..=4\n" +
    "    assert(sum_range_val(stored_r) == 10)\n" +
    "    mut r_enum := 0\n" +
    "    for (idx, v) in (10..=12).enumerate() { r_enum += (idx + 1) * v }\n" +
    "    assert(r_enum == 1 * 10 + 2 * 11 + 3 * 12)\n" +
    "    mut r_imp := 0\n" +
    "    for (idx, v) in 10..=12 { r_imp += idx * 100 + v }\n" +
    "    assert(r_imp == 10 + 111 + 212)\n" +
    "    nums := [10, 20, 30, 40]\n" +
    "    mut view_sum := 0\n" +
    "    for (i, n) in &nums[1..3] { view_sum += (i + 1) * n }\n" +
    "    assert(view_sum == 80)\n" +
    "    for n in &nums[..=0] { view_sum += n }\n" +
    "    for n in &nums[4..] { assert(false) }\n" +
    "    assert(view_sum == 90)\n" +
    "    s1 := &nums[1..=3]\n" +
    "    assert(s1.len == 3 && s1[0] == 20 && s1[2] == 40)\n" +
    "    s2 := &nums[..=1]\n" +
    "    assert(s2.len == 2 && s2[0] == 10 && s2[1] == 20)\n" +
    "    s3 := &nums[3..=2]\n" +
    "    assert(s3.len == 0)\n" +
    "    word := \"hello\"\n" +
    "    assert(word[1..=3] == \"ell\")\n" +
    "    wview := &word[0..=1]\n" +
    "    assert(wview.len == 2 && wview[0] == b'h' && wview[1] == b'e')\n" +
    "    words := [\"alpha\", \"beta\", \"gamma\"]\n" +
    "    mut arr_imp := 0\n" +
    "    for (i, w) in &words { arr_imp += (i + 1) * w.len }\n" +
    "    assert(arr_imp == 1 * 5 + 2 * 4 + 3 * 5)\n" +
    "    mut arr_exp := 0\n" +
    "    for (i, w) in words.enumerate() { arr_exp += i * 10 + w.len }\n" +
    "    assert(arr_exp == 5 + 14 + 25)\n" +
    "    mut arr_ref_exp := 0\n" +
    "    for (i, n) in (&nums).enumerate() { arr_ref_exp += i + n }\n" +
    "    assert(arr_ref_exp == 106)\n" +
    "    fixed: [i32; 3] = [7, 8, 9]\n" +
    "    mut fix_sum := 0\n" +
    "    for (i, v) in &fixed { fix_sum += (i + 1) * v }\n" +
    "    assert(fix_sum == 1 * 7 + 2 * 8 + 3 * 9)\n" +
    "    mut owned_words := [\"one\", \"two\"]\n" +
    "    mut moved_len := 0\n" +
    "    for (i, s) in (move owned_words).enumerate() { moved_len += i + s.len }\n" +
    "    assert(moved_len == 0 + 3 + 1 + 3)\n" +
    "    mut iter_arr := [\"aa\", \"bbb\"]\n" +
    "    mut iter_sum := 0\n" +
    "    for (i, s) in iter_arr.iter().enumerate() { iter_sum += i * 10 + s.len }\n" +
    "    assert(iter_sum == 2 + 13)\n" +
    "    mut iter_mv := [\"aa\", \"bbb\"]\n" +
    "    mut iter_mv_sum := 0\n" +
    "    for (i, s) in (move iter_mv).iter().enumerate() { iter_mv_sum += i * 10 + s.len }\n" +
    "    assert(iter_mv_sum == 2 + 13)\n" +
    "    u := \"aå🌍\"\n" +
    "    mut byte_acc := 0\n" +
    "    for (i, b) in \"ab\".bytes() { byte_acc += (i + 1) * i32(b) }\n" +
    "    assert(byte_acc == 97 + 2 * 98)\n" +
    "    mut rune_idx: []i32 = []\n" +
    "    mut rune_cp: []i32 = []\n" +
    "    for (i, r) in u.runes() { rune_idx.push(i); rune_cp.push(i32(r)) }\n" +
    "    assert(rune_idx == [0, 1, 2] && rune_cp == [97, 229, 127757])\n" +
    "    mut rune_exp: []i32 = []\n" +
    "    for (i, r) in \"aå🌍\".runes().enumerate() { rune_exp.push(i + i32(r)) }\n" +
    "    assert(rune_exp == [97, 230, 127759])\n" +
    "    pairs: [](i32, string) = [(3, \"x\"), (5, \"yy\")]\n" +
    "    mut pair_acc := 0\n" +
    "    for (n, label) in &pairs { pair_acc += n * label.len }\n" +
    "    assert(pair_acc == 3 + 10)\n" +
    "    mut pair_enum := 0\n" +
    "    for (idx, item) in pairs.enumerate() { pair_enum += (idx + 1) * item.0 + item.1.len }\n" +
    "    assert(pair_enum == (1 * 3 + 1) + (2 * 5 + 2))\n" +
    "    triples: [](i32, string, bool) = [(2, \"ok\", true), (4, \"no\", false)]\n" +
    "    mut tri_acc := 0\n" +
    "    for (n, s, flag) in &triples { if flag { tri_acc += n + s.len } }\n" +
    "    assert(tri_acc == 4)\n" +
    "    mut partial_sum := 0\n" +
    "    for (n, _) in &pairs { partial_sum += n }\n" +
    "    for (_, s) in &pairs { partial_sum += s.len }\n" +
    "    assert(partial_sum == 3 + 5 + 1 + 2)\n" +
    "    mut log := DropLog { drops: 0 }\n" +
    "    {\n" +
    "        mut res_pairs: [](i32, Token) = [(1, Token::make(10, &mut log)), (2, Token::make(20, &mut log)), (3, Token::make(30, &mut log))]\n" +
    "        mut kept := 0\n" +
    "        for (n, tok) in move res_pairs {\n" +
    "            if n == 1 { continue }\n" +
    "            kept += n + take_token(move tok)\n" +
    "            if n == 2 { break }\n" +
    "        }\n" +
    "        assert(kept == 22)\n" +
    "    }\n" +
    "    assert(log.drops == 3)\n" +
    "    print(42)\n" +
    "}\n"
}

fn map_set_and_iterator_program() -> string {
    "capability unsafe\n" +
    "fn v() -> i32 { 999 }\n" +
    "struct DropLog { drops: i32 }\n" +
    "fn log_drop(log: &mut DropLog) { log.drops += 1 }\n" +
    "@resource(dispose)\n" +
    "struct Item {\n" +
    "    id: i32,\n" +
    "    log: ptr,\n" +
    "}\n" +
    "impl Item {\n" +
    "    fn make(id: i32, log: &mut DropLog) -> Self {\n" +
    "        unsafe { Self { id: id, log: addr(&mut log) } }\n" +
    "    }\n" +
    "    fn clone_with(&self, log: &mut DropLog) -> Self {\n" +
    "        Item::make(self.id, &mut log)\n" +
    "    }\n" +
    "    fn dispose(&self) {\n" +
    "        if self.id >= 0 {\n" +
    "            unsafe { log_drop(ref_at(self.log)) }\n" +
    "        }\n" +
    "    }\n" +
    "}\n" +
    "impl Eq for Item { fn eq(&self, other: &Self) -> bool { self.id == other.id } }\n" +
    "impl Hash for Item { fn hash(&self) -> u64 { self.id.hash() } }\n" +
    "struct Counter { cur: i32, stop: i32 }\n" +
    "impl Iterator for Counter {\n" +
    "    fn next(&mut self) -> Option<i32> {\n" +
    "        if self.cur >= self.stop { return .None }\n" +
    "        val := self.cur\n" +
    "        self.cur += 1\n" +
    "        .Some(val)\n" +
    "    }\n" +
    "}\n" +
    "struct Repeat<T> { count: i32, value: T }\n" +
    "impl Iterator for Repeat<T> where T: Clone {\n" +
    "    fn next(&mut self) -> Option<T> {\n" +
    "        if self.count <= 0 { return .None }\n" +
    "        self.count -= 1\n" +
    "        .Some(self.value.clone())\n" +
    "    }\n" +
    "}\n" +
    "struct PairIter { cur: i32 }\n" +
    "impl Iterator for PairIter {\n" +
    "    fn next(&mut self) -> Option<(i32, string)> {\n" +
    "        if self.cur >= 3 { return .None }\n" +
    "        i := self.cur\n" +
    "        self.cur += 1\n" +
    "        .Some((i, \"p\" + i.str()))\n" +
    "    }\n" +
    "}\n" +
    "struct ItemIter { next_id: i32, stop: i32, log: ptr }\n" +
    "impl Iterator for ItemIter {\n" +
    "    fn next(&mut self) -> Option<Item> {\n" +
    "        if self.next_id >= self.stop { return .None }\n" +
    "        id := self.next_id\n" +
    "        self.next_id += 1\n" +
    "        unsafe { .Some(Item { id: id, log: self.log }) }\n" +
    "    }\n" +
    "}\n" +
    "fn sum_iter<I>(move it: I) -> i32 where I: Iterator {\n" +
    "    mut sum := 0\n" +
    "    for x in move it { sum += x }\n" +
    "    sum\n" +
    "}\n" +
    "fn sum_iter_mut<I>(it: &mut I) -> i32 where I: Iterator {\n" +
    "    mut sum := 0\n" +
    "    for x in &mut it { sum += x }\n" +
    "    sum\n" +
    "}\n" +
    "fn make_map() -> Map<string, i32> {\n" +
    "    mut m := Map<string, i32>::new()\n" +
    "    m.put(\"aa\", 2)\n" +
    "    m.put(\"bbb\", 5)\n" +
    "    m\n" +
    "}\n" +
    "fn make_set() -> Set<string> {\n" +
    "    mut s := Set<string>::new()\n" +
    "    _ := s.insert(\"one\")\n" +
    "    _ := s.insert(\"three\")\n" +
    "    s\n" +
    "}\n" +
    "fn main() {\n" +
    "    assert(v() == 999)\n" +
    "    empty_m := Map<string, i32>::new()\n" +
    "    mut empty_count := 0\n" +
    "    for (k, val) in &empty_m { empty_count += k.len + val }\n" +
    "    assert(empty_count == 0)\n" +
    "    mut m := make_map()\n" +
    "    mut map_sum := 0\n" +
    "    // Verify `v` shadows top-level fn `v` inside `for (k, v)`.\n" +
    "    for (k, v) in &m { map_sum += k.len * 10 + v }\n" +
    "    assert(map_sum == 2 * 10 + 2 + 3 * 10 + 5)\n" +
    "    mut map_implicit := 0\n" +
    "    for (k, _) in m { map_implicit += k.len }\n" +
    "    assert(map_implicit == 5)\n" +
    "    mut fresh_sum := 0\n" +
    "    for (k, v) in make_map() { fresh_sum += k.len + v }\n" +
    "    assert(fresh_sum == 12)\n" +
    "    mut moved_sum := 0\n" +
    "    for (_, v) in move m { moved_sum += v }\n" +
    "    assert(moved_sum == 7)\n" +
    "    mut log := DropLog { drops: 0 }\n" +
    "    {\n" +
    "        mut rm := Map<string, Item>::new()\n" +
    "        rm.put(\"first\", Item::make(10, &mut log))\n" +
    "        rm.put(\"second\", Item::make(20, &mut log))\n" +
    "        rm.put(\"third\", Item::make(30, &mut log))\n" +
    "        mut borrow_ids := 0\n" +
    "        for (k, item) in &rm { borrow_ids += k.len + item.id }\n" +
    "        assert(borrow_ids == 5 + 6 + 5 + 60 && log.drops == 0)\n" +
    "        mut seen := 0\n" +
    "        for (k, item) in move rm {\n" +
    "            seen += 1\n" +
    "            assert(item.id >= 10 && k.len > 0)\n" +
    "            if seen == 2 { break }\n" +
    "        }\n" +
    "    }\n" +
    "    assert(log.drops == 3)\n" +
    "    mut s := make_set()\n" +
    "    mut set_chars := 0\n" +
    "    for item in &s { set_chars += item.len }\n" +
    "    for item in s { set_chars += item.len }\n" +
    "    assert(set_chars == 16)\n" +
    "    mut set_enum := 0\n" +
    "    for (i, item) in s.enumerate() { set_enum += i + item.len }\n" +
    "    assert(set_enum == 0 + 1 + 3 + 5)\n" +
    "    mut set_moved := 0\n" +
    "    for (i, item) in move s { set_moved += i + item.len }\n" +
    "    assert(set_moved == 9)\n" +
    "    mut tset := Set<(i32, string)>::new()\n" +
    "    _ := tset.insert((3, \"ab\"))\n" +
    "    _ := tset.insert((7, \"c\"))\n" +
    "    mut tsum := 0\n" +
    "    for (n, txt) in &tset { tsum += n + txt.len }\n" +
    "    for (idx, pair) in tset.enumerate() { tsum += idx * 10 + pair.0 + pair.1.len }\n" +
    "    for (n, txt) in move tset { tsum += n + txt.len }\n" +
    "    assert(tsum == 13 + 23 + 13)\n" +
    "    mut rs := Set<Item>::new()\n" +
    "    _ := rs.insert(Item::make(1, &mut log))\n" +
    "    _ := rs.insert(Item::make(2, &mut log))\n" +
    "    for _ in move rs { break }\n" +
    "    assert(log.drops == 5)\n" +
    "    mut cnt := Counter { cur: 1, stop: 6 }\n" +
    "    mut snap_sum := 0\n" +
    "    for x in cnt { snap_sum += x }\n" +
    "    assert(snap_sum == 15 && cnt.cur == 1)\n" +
    "    mut first_half := 0\n" +
    "    for x in &mut cnt {\n" +
    "        first_half += x\n" +
    "        if x == 3 { break }\n" +
    "    }\n" +
    "    assert(first_half == 6 && cnt.cur == 4)\n" +
    "    mut second_half := 0\n" +
    "    for (i, x) in (&mut cnt).enumerate() { second_half += i * 10 + x }\n" +
    "    assert(second_half == (0 + 4) + (10 + 5) && cnt.cur == 6)\n" +
    "    rep := Repeat<string> { count: 3, value: \"hi\" }\n" +
    "    mut rep_cat := \"\"\n" +
    "    for (i, word) in rep.clone() { rep_cat += i.str() + \":\" + word + \",\" }\n" +
    "    assert(rep_cat == \"0:hi,1:hi,2:hi,\")\n" +
    "    mut rep_moved := 0\n" +
    "    for word in move rep { rep_moved += word.len }\n" +
    "    assert(rep_moved == 6)\n" +
    "    mut pi := PairIter { cur: 0 }\n" +
    "    mut psum := 0\n" +
    "    for (idx, tag) in &mut pi { psum += idx + tag.len }\n" +
    "    assert(psum == 0 + 1 + 2 + 6)\n" +
    "    mut ii := unsafe { ItemIter { next_id: 1, stop: 5, log: addr(&mut log) } }\n" +
    "    mut isum := 0\n" +
    "    for it in &mut ii {\n" +
    "        if it.id == 2 { continue }\n" +
    "        isum += it.id\n" +
    "        if it.id == 3 { break }\n" +
    "    }\n" +
    "    assert(isum == 4 && log.drops == 8)\n" +
    "    for _ in move ii {}\n" +
    "    assert(log.drops == 9)\n" +
    "    c1 := Counter { cur: 2, stop: 5 }\n" +
    "    mut c2 := Counter { cur: 10, stop: 13 }\n" +
    "    assert(sum_iter<Counter>(move c1) == 9)\n" +
    "    assert(sum_iter_mut<Counter>(&mut c2) == 33 && c2.cur == 13)\n" +
    "    print(77)\n" +
    "}\n"
}

fn invalid_cases() -> [](string, string, string) {
    [
        ("mut xs := [1, 2]; for x in &xs[0..1] { xs[1] = x }", "cannot assign to a collection while iterating", ""),
        ("mut xs := [1, 2]; for x in &mut xs { _ := x }", "for loop requires & rather than &mut", ""),
        ("mut xs := [1, 2]; for (a, b, c) in &xs { _ := a }", "for tuple pattern expects a 3-element tuple", ""),
        ("xs := [1, 2]; _ := &xs[..=]", "inclusive slice '..=' requires an upper bound", ""),
        ("m := Map<string, i32>::new(); for k in &m { _ := k }", "iterating a Map binds key and value", ""),
        ("m := Map<string, i32>::new(); for (i, kv) in (&m).enumerate() { _ := i }", "enumerate() is not supported directly on Map", ""),
        ("mut m := Map<string, i32>::new(); m.put(\"a\", 1); for (k, v) in &mut m { _ := v }", "for loop requires & rather than &mut", ""),
        ("mut m := Map<string, i32>::new(); m.put(\"a\", 1); for (k, _) in &m { m.put(\"b\", 2) }", "cannot mutate a collection while iterating", ""),
        ("mut s := Set<i32>::new(); _ := s.insert(1); for x in &s { _ := s.insert(2) }", "cannot mutate a collection while iterating", ""),
    ]
}

fn invalid_modules() -> [](string, string, string) {
    [
        ("capability unsafe\nfn expose(v: &[]i64) -> ptr { unsafe { addr(&v[0]) } }\nfn main() { region arena(128) { r: []i64 = arena.alloc(1); _ := expose(&r) } }\n", "scratch borrow reaches a raw address", ""),
        ("struct S { n: i32 }\nimpl Iterator for S {}\nfn main() {}\n", "missing trait method 'next'", ""),
        ("struct S { n: i32 }\nimpl Iterator for S { fn next(&self) -> Option<i32> { .None } }\nfn main() {}\n", "Iterator::next receiver must be '&mut self'", ""),
        ("struct S { n: i32 }\nimpl Iterator for S { fn next(&mut self, x: i32) -> Option<i32> { .None } }\nfn main() {}\n", "Iterator::next must take only '&mut self'", ""),
        ("struct S { n: i32 }\nimpl Iterator for S { fn next(&mut self) -> i32 { 0 } }\nfn main() {}\n", "Iterator::next must return 'Option<T>'", ""),
        ("struct S { n: i32 }\nimpl Iterator for S { fn helper(&self) {} fn next(&mut self) -> Option<i32> { .None } }\nfn main() {}\n", "is not a member of trait 'Iterator'", ""),
        ("struct S { n: i32 }\nimpl Iterator for S { fn next(&mut self) -> Option<i32> { .None } }\nimpl Iterator for S { fn next(&mut self) -> Option<i32> { .None } }\nfn main() {}\n", "duplicate implementation of trait 'Iterator'", ""),
        ("impl Iterator for i32 { fn next(&mut self) -> Option<i32> { .None } }\nfn main() {}\n", "cannot implement built-in trait 'Iterator'", ""),
        ("capability unsafe\nstruct S { n: i32 }\nimpl Iterator for S { unsafe fn next(&mut self) -> Option<i32> { .None } }\nfn main() {}\n", "Iterator::next must be safe", ""),
        ("struct C { n: i32 }\nimpl Iterator for C { fn next(&mut self) -> Option<i32> { .None } }\nfn main() { c := C { n: 0 }; for x in &c { _ := x } }\n", "Iterator requires an owned value or '&mut'", ""),
        ("struct C { n: i32 }\nimpl Iterator for C { fn next(&mut self) -> Option<i32> { .None } }\nfn main() { mut c := C { n: 0 }; for x in &mut c { _ := c.next() } }\n", "cannot mutate a collection while iterating over it", ""),
        ("struct C { n: i32 }\nimpl Iterator for C { fn next(&mut self) -> Option<i32> { .None } }\nfn main() { mut c := C { n: 0 }; for x in &mut c { for y in &mut c { _ := y } } }\n", "cannot mutably borrow an Iterator while iterating", ""),
        ("@resource(dispose)\nstruct M { n: i32 }\nimpl M { fn dispose(&self) {} }\nimpl Iterator for M { fn next(&mut self) -> Option<i32> { .None } }\nfn main() { m := M { n: 0 }; for x in m { _ := x } }\n", "iterating a move-only Iterator requires 'move value'", ""),
        ("struct HasNext { n: i32 }\nimpl HasNext { pub fn next(&mut self) -> Option<i32> { .None } }\nfn main() { mut h := HasNext { n: 0 }; for x in &mut h { _ := x } }\n", "for &mut requires a type implementing Iterator", "move 'next' into 'impl Iterator for"),
        ("struct HasNext { n: i32 }\nimpl HasNext { pub fn next(&mut self) -> Option<i32> { .None } }\nfn main() { h := HasNext { n: 0 }; for x in h { _ := x } }\n", "for requires a range, array, Map, Set, or Iterator", "move 'next' into 'impl Iterator for"),
    ]
}

fn check_program(cli: &harness.BaseCli, work: string, label: string, src_text: string, expected_out: string) -> bool {
    path := work + "/" + label + ".ddr"
    image := work + "/" + label
    if !sys.write_text(path, src_text).ok { return harness.fail(f"cannot write {path}") }
    host := process.host_target()
    mut targets := harness.targets()
    targets.push("wasm32")
    mut result := harness.empty_output()
    for target in targets {
        for optimized in [true, false] {
            if !optimized && target != host { continue }
            mut args: []string = ["build", path.clone(), "--target", target.clone(), "-o", image.clone(), "--jobs", "1"]
            if !optimized {
                args.push("--mir=off")
                args.push("--scalar-opt=off")
            }
            if !harness.run_checked(cli.compiler, args, work, 0, false, &mut result) { return false }
            if target == host || target == "wasm32" {
                if !harness.run_target_image(target, image, work, &mut result) { return false }
                if result.stdout_text() != expected_out + "\n" {
                    return harness.fail(f"{label} ({target}, opt={optimized}) output: {result.stdout_text()}")
                }
            }
        }
    }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    if !check_program(&cli, work, "ranges_enum", ranges_and_enumerate_program(), "42") { return false }
    if !check_program(&cli, work, "map_set_iter", map_set_and_iterator_program(), "77") { return false }

    // Cross-module Iterator implementation + consumption
    mod_dir := work + "/cross_iter"
    if !fs.mkdir_all(mod_dir).ok { return harness.fail("cannot create cross_iter dir") }
    if !sys.write_text(mod_dir + "/dunder.toml", "name = \"cross_iter\"\nroot = \"main.ddr\"\n").ok { return harness.fail("cannot write dunder.toml") }
    if !sys.write_text(mod_dir + "/seq.ddr",
        "pub struct Step { cur: i32, limit: i32, step: i32 }\n" +
        "impl Step { pub fn range_by(start: i32, limit: i32, step: i32) -> Self { Self { cur: start, limit: limit, step: step } } }\n" +
        "impl Iterator for Step {\n" +
        "    fn next(&mut self) -> Option<i32> {\n" +
        "        if self.cur >= self.limit { return .None }\n" +
        "        v := self.cur\n" +
        "        self.cur += self.step\n" +
        "        .Some(v)\n" +
        "    }\n" +
        "}\n").ok { return harness.fail("cannot write seq.ddr") }
    if !sys.write_text(mod_dir + "/main.ddr",
        "import .seq as seq\n" +
        "fn main() {\n" +
        "    mut s := seq.Step::range_by(1, 10, 3)\n" +
        "    mut total := 0\n" +
        "    for (i, v) in (&mut s).enumerate() { total += (i + 1) * v }\n" +
        "    assert(total == 1 * 1 + 2 * 4 + 3 * 7)\n" +
        "    print(\"CROSS_OK\")\n" +
        "}\n").ok { return harness.fail("cannot write main.ddr") }
    mut res := harness.empty_output()
    cimg := work + "/cross_bin"
    if !harness.run_checked(cli.compiler, ["build", mod_dir + "/main.ddr", "--jobs", "1", "-o", cimg.clone()], mod_dir, 0, false, &mut res) ||
    !harness.run_checked(cimg, [], mod_dir, 0, false, &mut res) {
        return false
    }
    if res.stdout_text() != "CROSS_OK\n" { return harness.fail(f"cross_iter output: {res.stdout_text()}") }

    source := work + "/invalid.ddr"
    image := work + "/invalid_bin"
    mut case_idx := 0
    for case in move invalid_cases() {
        (body, message, note) := case
        code := "fn main() { " + body + " }\n"
        if !sys.write_text(source, code).ok { return harness.fail(f"cannot write {source}") }
        if !harness.run_checked(cli.compiler, ["check", source.clone(), "--jobs", "1"], work, 1, false, &mut res) {
            return false
        }
        if !text.contains(res.stderr_text(), message) {
            return harness.fail(f"missing '{message}' for {body}: {res.stderr_text()}")
        }
        if note != "" && !text.contains(res.stderr_text(), note) {
            return harness.fail(f"missing note '{note}' for {body}: {res.stderr_text()}")
        }
        if case_idx < 2 {
            if !harness.check_agent_error(cli.compiler, source, message, work) ||
               !harness.run_checked(cli.compiler, ["build", source.clone(), "--jobs", "1", "-o", image.clone()], work, 1, false, &mut res) {
                return false
            }
        }
        case_idx += 1
    }
    mut mcase_idx := 0
    for mcase in move invalid_modules() {
        (mcode, message, note) := mcase
        if !sys.write_text(source, mcode).ok { return harness.fail(f"cannot write {source}") }
        if !harness.run_checked(cli.compiler, ["check", source.clone(), "--jobs", "1"], work, 1, false, &mut res) {
            return false
        }
        if !text.contains(res.stderr_text(), message) {
            return harness.fail(f"missing '{message}' for module:\n{mcode}\ngot:\n{res.stderr_text()}")
        }
        if note != "" && !text.contains(res.stderr_text(), note) {
            return harness.fail(f"missing note '{note}' for module:\n{mcode}\ngot:\n{res.stderr_text()}")
        }
        if mcase_idx < 2 {
            if !harness.check_agent_error(cli.compiler, source, message, work) ||
               !harness.run_checked(cli.compiler, ["build", source.clone(), "--jobs", "1", "-o", image.clone()], work, 1, false, &mut res) {
                return false
            }
        }
        mcase_idx += 1
    }

    print("Ranges, enumerate, Map/Set iteration, Iterator protocol and diagnostics passed.")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-iterators-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
