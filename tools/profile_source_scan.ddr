import std.bytes as bytes
import std.text as text

pub struct Token { kind: i32, spelling: string, start: i32, end: i32 }

pub struct Scan { tokens: []Token, error: string }

fn token(kind: i32, spelling: string, start: i32, end: i32) -> Token {
    Token { kind: kind, spelling: spelling.clone(), start: start, end: end }
}

fn failed(message: string) -> Scan { Scan { tokens: [], error: message.clone() } }

fn alphabetic(c: i32) -> bool {
    (c >= i32(b'a') && c <= i32(b'z')) || (c >= i32(b'A') && c <= i32(b'Z')) || c == i32(b'_') || c >= 128
}

fn digit(c: i32) -> bool { c >= i32(b'0') && c <= i32(b'9') }

fn digits(source: string, start: i32) -> i32 {
    mut at := start
    while at < source.len && (digit(source[at]) || source[at] == i32(b'_')) { at += 1 }
    at
}

fn at_byte(source: string, at: i32) -> i32 {
    if at < source.len { source[at] } else { -1 }
}

fn number(source: string, start: i32) -> (i32, i32) {
    mut end := digits(source, start + 1)
    mut kind := 3
    if at_byte(source, end) == i32(b'.') && digit(at_byte(source, end + 1)) {
        end = digits(source, end + 2)
        kind = 4
    }
    marker := at_byte(source, end)
    if marker == i32(b'e') || marker == i32(b'E') {
        sign := at_byte(source, end + 1)
        first := if sign == i32(b'+') || sign == i32(b'-') { end + 2 } else { end + 1 }
        if digit(at_byte(source, first)) {
            end = digits(source, first + 1)
            kind = 4
        }
    }
    (kind, end)
}

fn hex_digit(c: i32) -> i32 {
    if digit(c) { return c - i32(b'0') }
    if c >= i32(b'a') && c <= i32(b'f') { return c - i32(b'a') + 10 }
    if c >= i32(b'A') && c <= i32(b'F') { return c - i32(b'A') + 10 }
    -1
}

fn hexadecimal(source: string, start: i32, end: i32) -> i32 {
    if start >= end || end > source.len { return -1 }
    mut value := 0
    for at in start..end {
        d := hex_digit(source[at])
        if d < 0 || value > 0x10ffff / 16 { return -1 }
        value = value * 16 + d
    }
    if value > 0x10ffff { return -1 }
    value
}

fn append_scalar(value: i32, output: &mut []u8) -> bool {
    if value < 0 || (value >= 0xd800 && value <= 0xdfff) { return false }
    if value < 0x80 {
        output.push(u8(value))
    } else if value < 0x800 {
        output.push(u8(0xc0 + value / 64))
        output.push(u8(0x80 + value % 64))
    } else if value < 0x10000 {
        output.push(u8(0xe0 + value / 4096))
        output.push(u8(0x80 + value / 64 % 64))
        output.push(u8(0x80 + value % 64))
    } else {
        output.push(u8(0xf0 + value / 262144))
        output.push(u8(0x80 + value / 4096 % 64))
        output.push(u8(0x80 + value / 64 % 64))
        output.push(u8(0x80 + value % 64))
    }
    true
}

fn quoted(source: string, start: i32, output: &mut string) -> i32 {
    delimiter := source[start]
    mut encoded: []u8 = []
    mut at := start + 1
    while at < source.len {
        c := source[at]
        at += 1
        if c == delimiter {
            decoded := bytes.decode(&encoded)
            if !decoded.ok { return -1 }
            output = decoded.value
            return at
        }
        if c == i32(b'\n') || c == i32(b'\r') { return -1 }
        if c != i32(b'\\') {
            encoded.push(u8(c))
            continue
        }
        escape := at_byte(source, at)
        at += 1
        if escape == i32(b'x') {
            value := hexadecimal(source, at, at + 2)
            if value < 0 { return -1 }
            encoded.push(u8(value))
            at += 2
        } else if escape == i32(b'u') {
            mut first := at
            mut end := at + 4
            if at_byte(source, at) == i32(b'{') {
                first = at + 1
                end = first
                while end < source.len && source[end] != i32(b'}') { end += 1 }
                if end == source.len { return -1 }
                at = end + 1
            } else { at = end }
            if !append_scalar(hexadecimal(source, first, end), &mut encoded) { return -1 }
        } else {
            mut value := escape
            if escape == i32(b'n') { value = i32(b'\n') }
            else if escape == i32(b'r') { value = i32(b'\r') }
            else if escape == i32(b't') { value = i32(b'\t') }
            else if escape == i32(b'0') { value = 0 }
            else if escape != i32(b'\\') && escape != 34 && escape != 39 && escape != 96 { return -1 }
            encoded.push(u8(value))
        }
    }
    -1
}

fn comment(source: string, start: i32, depth: i32, tokens: &mut []Token) -> i32 {
    mut at := start + 2
    mut nesting := 1
    while at < source.len {
        c := source[at]
        next := at_byte(source, at + 1)
        if c == i32(b'/') && next == i32(b'*') { nesting += 1; at += 2 }
        else if c == i32(b'*') && next == i32(b'/') {
            nesting -= 1
            at += 2
            if nesting == 0 { return at }
        } else {
            if c == i32(b'\n') && depth == 0 { tokens.push(token(8, "\n", at, at + 1)) }
            at += 1
        }
    }
    -1
}

fn symbol(source: string, start: i32) -> i32 {
    if start + 1 < source.len && source[start + 1] < 128 {
        pair := source[start..(start + 2)]
        if text.contains(" := -> => == != <= >= && || .. ", " " + pair + " ") { return start + 2 }
    }
    for c in "()[]{}:=,.;@+*/%<>!&-".bytes() {
        if source[start] == c { return start + 1 }
    }
    -1
}

pub fn scan(source: string) -> Scan {
    mut tokens: []Token = []
    mut at := 0
    mut depth := 0
    while at < source.len {
        start := at
        c := source[at]
        next := at_byte(source, at + 1)
        if c == i32(b' ') || c == i32(b'\t') || c == i32(b'\r') {
            at += 1
        } else if c == i32(b'/') && next == i32(b'/') {
            while at < source.len && source[at] != i32(b'\n') { at += 1 }
        } else if c == i32(b'/') && next == i32(b'*') {
            at = comment(source, at, depth, &mut tokens)
            if at < 0 { return failed("unclosed comment") }
        } else if c == i32(b'\n') {
            at += 1
            if depth == 0 { tokens.push(token(8, "\n", start, at)) }
        } else if alphabetic(c) {
            at += 1
            while at < source.len && (alphabetic(source[at]) || digit(source[at])) { at += 1 }
            spelling := source[start..at]
            keywords := " fn pub mut move if else while for in return break continue struct enum match import as true false defer "
            kind := if text.contains(keywords, " " + spelling + " ") { 2 } else { 1 }
            tokens.push(token(kind, spelling, start, at))
        } else if digit(c) {
            (kind, end) := number(source, start)
            at = end
            tokens.push(token(kind, source[start..at], start, at))
        } else if c == 34 || c == 39 || c == 96 {
            mut spelling := ""
            at = quoted(source, start, &mut spelling)
            if at < 0 { return failed(f"unsupported quote or escape in lexer input at byte {start}") }
            tokens.push(token(if c == 96 { 6 } else { 5 }, spelling, start, at))
        } else {
            at = symbol(source, start)
            if at < 0 { return failed(f"unrecognized lexer input at byte {start}") }
            if c == i32(b'(') || c == i32(b'[') { depth += 1 }
            else if (c == i32(b')') || c == i32(b']')) && depth > 0 { depth -= 1 }
            tokens.push(token(7, source[start..at], start, at))
        }
    }
    tokens.push(token(0, "", source.len, source.len))
    Scan { tokens: tokens, error: "" }
}
