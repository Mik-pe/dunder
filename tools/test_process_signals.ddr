capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

struct Options {
    compiler: string,
    binary: string,
    receipt: string,
    help: bool,
    error: string,
}

fn options() -> Options {
    mut args := Options { compiler: "", binary: "", receipt: "", help: false, error: "" }
    count := sys.arg_count()
    mut index := 1
    mut positional := false
    while index < count {
        arg := sys.arg(index)
        if !positional && arg == "--" {
            positional = true
        } else if !positional && (arg == "--help" || arg == "-h") {
            args.help = true
            return args
        } else if !positional && text.starts_with(arg, "--") {
            equal := text.find(arg, "=").unwrap_or(-1)
            flag := if equal >= 0 { arg[0..equal] } else { arg.clone() }
            if flag != "--binary" && flag != "--receipt" {
                args.error = f"unknown argument: {flag}"
                return args
            }
            mut value := ""
            if equal >= 0 {
                value = arg[(equal + 1)..arg.len]
            } else {
                index += 1
                if index < count { value = sys.arg(index) }
            }
            if value.len == 0 || (equal < 0 && text.starts_with(value, "-")) {
                args.error = f"{flag} requires a path"
                return args
            }
            if flag == "--binary" { args.binary = value } else { args.receipt = value }
        } else if args.compiler.len == 0 && (positional || !text.starts_with(arg, "-")) {
            args.compiler = arg
        } else {
            args.error = f"unexpected argument: {arg}"
            return args
        }
        index += 1
    }
    if (args.compiler.len == 0) == (args.binary.len == 0) { args.error = "provide a compiler or --binary" }
    args
}

fn write_receipt(path: string, host: string, builds: i32, executed: &[]string) -> bool {
    mut report := json.Writer::new()
    report.object()
    report.key("schema")
    report.string("dunder-process-signal-verification/v1")
    report.key("host_target")
    report.string(host)
    report.key("builds")
    report.integer(i64(builds))
    report.key("executions")
    report.integer(i64(executed.len))
    report.key("binaries")
    report.array()
    for digest in executed { report.string(digest) }
    report.end()
    report.key("passed")
    report.boolean(true)
    report.end()
    result := report.finish()
    parent := harness.parent_dir(path)
    if result.is_err() || (parent.len > 0 && !fs.mkdir_all(parent).ok) || !sys.write_text(path, result.unwrap_or("") + "\n").ok {
        return harness.fail(f"cannot write receipt {path}")
    }
    true
}

fn run_suite(opts: &Options, work: string) -> bool {
    host := process.host_target()
    mut builds := 0
    mut runnable: []string = []
    if opts.binary.len > 0 {
        binary := fs.realpath(opts.binary)
        if !binary.ok { return harness.fail(f"binary not found: {opts.binary}") }
        runnable.push(move binary.value)
    } else {
        compiler := fs.realpath(opts.compiler)
        if !compiler.ok { return harness.fail(f"compiler not found: {opts.compiler}") }
        root := harness.find_root()
        if root.len == 0 { return harness.fail("could not locate dunder repository root") }
        source := root + "/tests/process_signal_mask.ddr"
        mut result := harness.empty_output()
        for target in harness.targets() {
            for mode in 0..2 {
                image := f"{work}/signals-{target}-{mode}"
                mut args: []string = ["build", source.clone(), "--target", target.clone(), "--jobs", "1", "-o", image.clone()]
                if mode == 1 {
                    args.push("--scalar-opt=off")
                    args.push("--ownership-opt=off")
                    args.push("--mir=off")
                }
                if !harness.run_checked(compiler.value, args, root, 0, false, &mut result) { return false }
                builds += 1
                if target == host { runnable.push(image.clone()) }
            }
        }
    }
    mut executed: []string = []
    for image in runnable {
        result := harness.exec_cmd(image, [], "", false, 10000)
        output := result.stdout_text()
        if !result.succeeded() || output != "process signal masks ok\n" || result.stderr.len != 0 {
            return harness.fail(f"{image} exited {result.code} (signal {result.signal})\nstdout: {output}\nstderr: {result.stderr_text()}")
        }
        executed.push(harness.sha256_file_hex(image))
    }
    if opts.receipt.len > 0 && !write_receipt(opts.receipt, host, builds, &executed) { return false }
    print(f"Process signals: {builds} native builds, {executed.len} live executions passed")
    true
}

fn main() -> i32 {
    opts := options()
    usage := "usage: test_process_signals [compiler | --binary path] [--receipt path]"
    if opts.help { print(usage); return 0 }
    if opts.error.len > 0 { _ := sys.eprint(usage + "\n" + opts.error); return 2 }
    tmp := fs.temp_dir("dunder-process-signals-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&opts, work) { 0 } else { 1 }
}
