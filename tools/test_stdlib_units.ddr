capability process, filesystem

import sys
import .harness as harness
import .probe_cli as cli
import std.parse
import std.text

fn check_sys_errors() -> bool {
    if sys.error_message(0) != "ok" { return harness.fail("sys.error_message(0)") }
    if sys.error_message(2) != "no such file or directory" { return harness.fail("sys.error_message(2)") }
    if sys.error_message(4) != "interrupted" { return harness.fail("sys.error_message(4)") }
    if sys.error_message(28) != "no space left on device" { return harness.fail("sys.error_message(28)") }
    if sys.error_message(92) != "invalid UTF-8" { return harness.fail("sys.error_message(92)") }
    if sys.error_message(93) != "unexpected end of file" { return harness.fail("sys.error_message(93)") }
    if sys.error_message(94) != "write returned zero bytes" { return harness.fail("sys.error_message(94)") }
    if sys.error_message(12345) != "OS error 12345" { return harness.fail("sys.error_message(12345)") }
    if sys.error_code(.NotFound) != 2 { return harness.fail("IoError.NotFound") }
    if sys.error_code(.Interrupted) != 4 { return harness.fail("IoError.Interrupted") }
    if sys.error_code(.NoSpace) != 28 { return harness.fail("IoError.NoSpace") }
    if sys.error_code(.InvalidUtf8) != 92 { return harness.fail("IoError.InvalidUtf8") }
    if sys.error_code(.UnexpectedEof) != 93 { return harness.fail("IoError.UnexpectedEof") }
    if sys.error_code(.WriteZero) != 94 { return harness.fail("IoError.WriteZero") }
    if sys.error_code(.ConnectionReset) != 54 { return harness.fail("IoError.ConnectionReset") }
    if sys.error_code(.Other(12345)) != 12345 { return harness.fail("IoError.Other") }
    if !sys.IoError::would_block().is_would_block() { return harness.fail("IoError::would_block") }
    if sys.IoError.NotFound.is_would_block() { return harness.fail("IoError.NotFound.is_would_block") }
    if !(sys.IoError::from_code(4) == sys.IoError.Interrupted) { return harness.fail("from_code(4)") }
    if !(sys.IoError::from_code(93) == sys.IoError.UnexpectedEof) { return harness.fail("from_code(93)") }
    if sys.IoError::from_code(63).code() != 63 { return harness.fail("from_code(63)") }
    if sys.IoError::from_code(48).code() != 48 { return harness.fail("from_code(48)") }
    if sys.IoError::from_code(54321).code() != 54321 { return harness.fail("from_code(54321)") }
    if sys.error_code(sys.error_from_code(63)) != 63 { return harness.fail("error_from_code(63)") }
    if sys.error_code(sys.error_from_code(48)) != 48 { return harness.fail("error_from_code(48)") }
    if sys.error_code(sys.error_from_code(54321)) != 54321 { return harness.fail("error_from_code(54321)") }
    true
}

fn grapheme_cases(root: string) -> bool {
    cases := sys.read(root + "/tests/fixtures/unicode-17/GraphemeBreakTest.txt").unwrap()
    mut checked := 0
    for line in text.split(cases, "\n") {
        body := text.trim(line[0..text.find(line, "#").unwrap_or(line.len)])
        if body == "" { continue }
        mut input := ""
        mut breaks: []i32 = []
        for field in text.split(body, " ") {
            if field == "÷" { breaks.push(input.len) }
            else if field != "×" && field != "" {
                scalar := parse.hex(field)
                assert(scalar.ok)
                input += rune(i32(scalar.value)).str()
            }
        }
        mut i := 0
        for part in text.graphemes(input) {
            if i + 1 >= breaks.len || part.start() != breaks[i] || part.end() != breaks[i + 1] ||
                part.as_str() != input[breaks[i]..breaks[i + 1]] { return harness.fail(body) }
            i += 1
        }
        if i + 1 != breaks.len { return harness.fail(body) }
        checked += 1
    }
    checked == 766 || harness.fail("unexpected Unicode 17 grapheme test count")
}

fn main() -> i32 {
    spec: []cli.Option = []
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_stdlib_units COMPILER")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("cannot locate repository root"); return 2 }
    if !grapheme_cases(root) || !check_sys_errors() { return 1 }

    modules: []string = [
        "stdlib/array.ddr",
        "stdlib/base64.ddr",
        "stdlib/bytes.ddr",
        "stdlib/bytes/utf8.ddr",
        "stdlib/cmp.ddr",
        "stdlib/hash.ddr",
        "stdlib/json.ddr",
        "stdlib/math.ddr",
        "stdlib/parse.ddr",
        "stdlib/path.ddr",
        "stdlib/sha256.ddr",
        "stdlib/text.ddr",
        "stdlib/time.ddr",
        "stdlib/toml/tree.ddr",
        "stdlib/wire.ddr",
    ]
    mut out := harness.empty_output()
    for mod in &modules {
        if !harness.run_checked_timeout(compiler, ["test", root + "/" + mod, "--jobs", "1"], root, 0, false, 60000, &mut out) {
            return 1
        }
    }
    print(f"stdlib units: {modules.len} modules + sys passed")
    0
}
