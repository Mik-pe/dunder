capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn build_helper_mod_source() -> string {
    "capability unsafe\n" +
    "import std.ffi as ffi\n\n" +
    "@repr(C)\n" +
    "pub struct MockInterface {\n" +
    "    name: *const ffi.c_char,\n" +
    "    version: i32,\n" +
    "    method_count: i32,\n" +
    "}\n\n" +
    "pub extern type OpaqueIface\n\n" +
    "@link(\"oracle\")\n" +
    "extern \"C\" {\n" +
    "    pub static demo_interface: MockInterface\n" +
    "    @link_name(\"demo_interface\")\n" +
    "    pub static demo_opaque: OpaqueIface\n" +
    "    pub static mut global_counter: ffi.c_int\n" +
    "    pub fn read_global_counter() -> ffi.c_int\n" +
    "    pub fn inspect_interface_ptr(iface: *const MockInterface) -> ffi.c_int\n" +
    "}\n"
}

fn build_main_source() -> string {
    "capability unsafe\n" +
    "import std.ffi as ffi\n" +
    "import .ffi_mod as m\n\n" +
    "@repr(C)\n" +
    "struct Pair { a: i32, b: f64 }\n\n" +
    "@repr(C)\n" +
    "union ValueU { i: i32, f: f32 }\n\n" +
    "@repr(i32)\n" +
    "enum Mode { Zero = 0, Ten = 10 }\n\n" +
    "@link(\"c\")\n" +
    "extern \"C\" {\n" +
    "    fn snprintf(buf: *mut ffi.c_char, cap: usize, fmt: *const ffi.c_char, ...) -> ffi.c_int\n" +
    "    @link_name(\"strlen\")\n" +
    "    fn c_strlen(s: *const ffi.c_char) -> usize\n" +
    "    fn strcmp(a: *const ffi.c_char, b: *const ffi.c_char) -> ffi.c_int\n" +
    "    @weak\n" +
    "    fn __dunder_nonexistent_weak_sym_98765() -> ffi.c_int\n" +
    "    @weak\n" +
    "    static __dunder_nonexistent_weak_data_98765: ffi.c_int\n" +
    "}\n\n" +
    "@link(\n" +
    "    macos = \"/nonexistent/libdunder_weak_missing_98765.dylib\",\n" +
    "    linux = \"libdunder_weak_missing_98765.so.99\",\n" +
    "    weak = true,\n" +
    ")\n" +
    "extern \"C\" {\n" +
    "    fn __dunder_missing_lib_fn_98765() -> ffi.c_int\n" +
    "}\n\n" +
    "@link(\"oracle\")\n" +
    "extern \"C\" {\n" +
    "    @link_name(\"c_oracle_combine\")\n" +
    "    fn combine(p: Pair, u: ValueU, m: Mode) -> ffi.c_int\n" +
    "    fn run_on_pthread(cb: extern \"C\" fn(i32, i32) -> i32, x: i32, y: i32) -> ffi.c_int\n" +
    "    fn run_struct_cb_on_pthread(cb: extern \"C\" fn(Pair) -> Pair, input: Pair) -> Pair\n" +
    "    fn invoke_opt_cb(cb: Option<extern \"C\" fn(i32) -> i32>, x: i32) -> ffi.c_int\n" +
    "    fn call_reentrant(cb: extern \"C\" fn(i32) -> i32, n: i32) -> ffi.c_int\n" +
    "}\n\n" +
    "@link(framework = \"Foundation\")\n" +
    "extern \"C\" {\n" +
    "    static NSDefaultRunLoopMode: *const ffi.c_void\n" +
    "}\n\n" +
    "@link(macos = \"objc\")\n" +
    "extern \"C\" {\n" +
    "    fn sel_registerName(name: *const ffi.c_char) -> *mut ffi.c_void\n" +
    "    fn sel_getName(sel: *mut ffi.c_void) -> *const ffi.c_char\n" +
    "}\n\n" +
    "extern \"C\" fn add_scaled(a: i32, b: i32) -> i32 {\n" +
    "    a * 10 + b\n" +
    "}\n\n" +
    "extern \"C\" fn transform_pair(p: Pair) -> Pair {\n" +
    "    Pair { a: p.a + 100, b: p.b * 2.0 }\n" +
    "}\n\n" +
    "extern \"C\" fn inc_one(x: i32) -> i32 {\n" +
    "    x + 1\n" +
    "}\n\n" +
    "extern \"C\" fn reentrant_sum(n: i32) -> i32 {\n" +
    "    if n <= 0 { return 0 }\n" +
    "    unsafe { n + call_reentrant(reentrant_sum, n - 1) }\n" +
    "}\n\n" +
    "fn main() {\n" +
    "    unsafe {\n" +
    "        // 1. @link(\"c\") + real ... C variadics + @link_name\n" +
    "        mut buf: [ffi.c_char; 64] = [0; 64]\n" +
    "        n0 := snprintf(buf.as_mut_ptr(), 64, c\"plain\".as_ptr())\n" +
    "        assert(n0 == 5 && c_strlen(buf.as_ptr()) == 5 && strcmp(buf.as_ptr(), c\"plain\".as_ptr()) == 0)\n" +
    "        n1 := snprintf(buf.as_mut_ptr(), 64, c\"%s=%d+%.1f\".as_ptr(), c\"sum\".as_ptr(), i32(42), 3.5)\n" +
    "        assert(n1 == 10 && strcmp(buf.as_ptr(), c\"sum=42+3.5\".as_ptr()) == 0)\n" +
    "        n2 := snprintf(buf.as_mut_ptr(), 64, c\"%d:%d:%d:%d\".as_ptr(), i32(1), i32(2), i32(3), i32(4))\n" +
    "        assert(n2 == 7 && strcmp(buf.as_ptr(), c\"1:2:3:4\".as_ptr()) == 0)\n\n" +
    "        // 2. @link(\"oracle\") + @link_name + @repr(C) struct/union/open enum\n" +
    "        cval := combine(Pair { a: 5, b: 4.0 }, ValueU { i: 7 }, Mode.Ten)\n" +
    "        assert(cval == 26)\n\n" +
    "        // 3. Extern data globals: struct static (addr_of + field reads), opaque static, static mut\n" +
    "        iface_ptr := addr_of(&m.demo_interface)\n" +
    "        assert(!iface_ptr.is_null())\n" +
    "        assert(m.inspect_interface_ptr(iface_ptr) == 52)\n" +
    "        assert(m.demo_interface.version == 5 && m.demo_interface.method_count == 2)\n" +
    "        assert(c_strlen(m.demo_interface.name) == 18)\n" +
    "        opaque_ptr := addr_of(&m.demo_opaque)\n" +
    "        assert(opaque_ptr.addr() == iface_ptr.addr())\n\n" +
    "        assert(m.global_counter == 100 && m.read_global_counter() == 100)\n" +
    "        m.global_counter = 250\n" +
    "        assert(m.global_counter == 250 && m.read_global_counter() == 250)\n" +
    "        m.global_counter += 17\n" +
    "        assert(m.global_counter == 267 && m.read_global_counter() == 267)\n" +
    "        ctr_ptr := addr_of(&mut m.global_counter)\n" +
    "        ctr_ptr.write(333)\n" +
    "        assert(m.global_counter == 333 && m.read_global_counter() == 333)\n\n" +
    "        // 4. Top-level extern \"C\" fn callbacks on foreign pthread + Option<extern \"C\" fn> + reentrancy\n" +
    "        assert(add_scaled(3, 4) == 34)\n" +
    "        assert(run_on_pthread(add_scaled, 4, 7) == 47)\n" +
    "        rp := run_struct_cb_on_pthread(transform_pair, Pair { a: 7, b: 3.5 })\n" +
    "        assert(rp.a == 107 && rp.b == 7.0)\n" +
    "        assert(invoke_opt_cb(.None, 41) == -999)\n" +
    "        assert(invoke_opt_cb(.Some(inc_one), 41) == 42)\n" +
    "        assert(call_reentrant(reentrant_sum, 5) == 15)\n\n" +
    "        // 5. Real macOS Foundation framework + ObjC + extern static pointer global\n" +
    "        if target_is(\"macos\") {\n" +
    "            assert(!addr_of(&NSDefaultRunLoopMode).is_null())\n" +
    "            mode_ptr := NSDefaultRunLoopMode\n" +
    "            assert(!mode_ptr.is_null())\n" +
    "            sel := sel_registerName(c\"description\".as_ptr())\n" +
    "            assert(!sel.is_null())\n" +
    "            sel_name := sel_getName(sel)\n" +
    "            assert(strcmp(sel_name, c\"description\".as_ptr()) == 0)\n" +
    "        }\n\n" +
    "        // 6. Weak symbols and weak missing library resolve to NULL without startup crash\n" +
    "        assert(usize(__dunder_nonexistent_weak_sym_98765) == 0)\n" +
    "        assert(addr_of(&__dunder_nonexistent_weak_data_98765).is_null())\n" +
    "        assert(usize(__dunder_missing_lib_fn_98765) == 0)\n" +
    "    }\n" +
    "    print(\"ffi extern blocks ok\")\n" +
    "}\n"
}

fn build_cross_source() -> string {
    "capability unsafe\n" +
    "import std.ffi as ffi\n\n" +
    "@link(framework = \"Foundation\")\n" +
    "extern \"C\" {\n" +
    "    static NSDefaultRunLoopMode: *const ffi.c_void\n" +
    "}\n\n" +
    "@link(\"d3d12\", delay = true)\n" +
    "extern \"system\" {\n" +
    "    @link_ordinal(1)\n" +
    "    fn DummyOrdFn(x: u32) -> i32\n" +
    "}\n\n" +
    "@link(macos = \"c\", linux = \"c\", windows = \"c\")\n" +
    "extern \"C\" {\n" +
    "    fn snprintf(buf: *mut ffi.c_char, cap: usize, fmt: *const ffi.c_char, ...) -> ffi.c_int\n" +
    "}\n\n" +
    "extern \"C\" fn cb_double(x: i32) -> i32 { x * 2 }\n\n" +
    "fn main() {\n" +
    "    f: extern \"C\" fn(i32) -> i32 = cb_double\n" +
    "    _ := f\n" +
    "    if target_is(\"macos\") {\n" +
    "        unsafe { _ := NSDefaultRunLoopMode }\n" +
    "    }\n" +
    "    if target_is(\"windows\") {\n" +
    "        unsafe { _ := DummyOrdFn(1) }\n" +
    "    }\n" +
    "    if target_is(\"native\") {\n" +
    "        unsafe {\n" +
    "            mut buf: [ffi.c_char; 16] = [0; 16]\n" +
    "            _ := snprintf(buf.as_mut_ptr(), 16, c\"%d\".as_ptr(), i32(7))\n" +
    "        }\n" +
    "    }\n" +
    "}\n"
}

fn check_compile_fail(cli: &harness.BaseCli, directory: string, name: string, source: string, expect_substr: string) -> bool {
    path := directory + "/neg_" + name + ".ddr"
    exe := directory + "/neg_" + name
    if !sys.write_text(path, source).ok { return harness.fail("failed writing " + path) }
    res := harness.exec_cmd(cli.compiler, ["build", path, "-o", exe], directory, true, 30000)
    if res.code == 0 {
        return harness.fail("negative test '" + name + "' unexpectedly compiled!")
    }
    combined := res.stdout_text() + "\n" + res.stderr_text()
    if !text.contains(combined, expect_substr) {
        return harness.fail("negative test '" + name + "' missing expected diagnostic '" + expect_substr + "', got:\n" + combined)
    }
    true
}

fn check_native_libs_allowlist(cli: &harness.BaseCli, directory: string) -> bool {
    dep_dir := directory + "/dep_pkg"
    app_bad := directory + "/app_bad"
    app_ok := directory + "/app_ok"
    if !fs.mkdir_all(dep_dir + "/src").ok || !fs.mkdir_all(app_bad + "/src").ok || !fs.mkdir_all(app_ok + "/src").ok {
        return harness.fail("failed creating allowlist test dirs")
    }
    if !sys.write_text(dep_dir + "/dunder.toml", "name = \"dep_pkg\"\nversion = \"0.1.0\"\nroot = \"src/lib.ddr\"\n").ok {
        return harness.fail("failed writing dep dunder.toml")
    }
    dep_src := "capability unsafe\nimport std.ffi as ffi\n@link(\"vulkan\")\nextern \"C\" {\n    pub fn vk_stub() -> ffi.c_int\n}\npub fn ok() -> i32 { 1 }\n"
    if !sys.write_text(dep_dir + "/src/lib.ddr", dep_src).ok {
        return harness.fail("failed writing dep lib.ddr")
    }
    app_src := "import dep_pkg\nfn main() { assert(dep_pkg.ok() == 1) }\n"

    // Disallowed: dependency has unsafe capability, but native_libs does not include "vulkan"
    if !sys.write_text(app_bad + "/dunder.toml",
        "name = \"app_bad\"\nversion = \"0.1.0\"\nroot = \"src/main.ddr\"\n[dependencies]\ndep_pkg = { path = \"../dep_pkg\", capabilities = [\"unsafe\"] }\n").ok ||
       !sys.write_text(app_bad + "/src/main.ddr", app_src.clone()).ok {
        return harness.fail("failed writing app_bad")
    }
    bad_res := harness.exec_cmd(cli.compiler, ["check", app_bad + "/src/main.ddr"], app_bad, true, 30000)
    if bad_res.code == 0 {
        return harness.fail("expected native_libs allowlist to reject @link(\"vulkan\") in dependency")
    }
    bad_combined := bad_res.stdout_text() + "\n" + bad_res.stderr_text()
    if !text.contains(bad_combined, "native_libs") || !text.contains(bad_combined, "vulkan") {
        return harness.fail("unexpected native_libs diagnostic:\n" + bad_combined)
    }

    // Allowed: native_libs = ["vulkan"]
    if !sys.write_text(app_ok + "/dunder.toml",
        "name = \"app_ok\"\nversion = \"0.1.0\"\nroot = \"src/main.ddr\"\n[dependencies]\ndep_pkg = { path = \"../dep_pkg\", capabilities = [\"unsafe\"], native_libs = [\"vulkan\"] }\n").ok ||
       !sys.write_text(app_ok + "/src/main.ddr", app_src).ok {
        return harness.fail("failed writing app_ok")
    }
    mut out := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["check", app_ok + "/src/main.ddr"], app_ok, 0, true, &mut out) {
        return harness.fail("expected native_libs = [\"vulkan\"] to pass check:\n" + out.stderr_text())
    }
    true
}

fn run_all(cli: &harness.BaseCli, directory: string) -> bool {
    fixtures := cli.root + "/tests/fixtures/ffi"
    mac := process.host_os() == "macos"
    proj := directory + "/proj"
    if !fs.mkdir_all(proj + "/src").ok { return harness.fail("failed creating proj/src") }

    lib_file := if mac { "libextern_oracle.dylib" } else { "libextern_oracle.so" }
    lib_path := proj + "/" + lib_file
    mut res := harness.empty_output()
    mut cc_args: []string = ["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-fPIC", "-pthread"]
    if mac {
        cc_args.push("-dynamiclib")
        cc_args.push("-install_name")
        cc_args.push("@rpath/" + lib_file)
    } else {
        cc_args.push("-shared")
        cc_args.push("-Wl,-soname," + lib_file)
    }
    cc_args.push(fixtures + "/extern_blocks_oracle.c")
    cc_args.push("-o")
    cc_args.push(lib_path.clone())
    if !harness.run_checked(cli.cc, cc_args, proj, 0, false, &mut res) {
        return false
    }

    manifest_src := "name = \"extern_blocks_demo\"\n" +
        "version = \"0.1.0\"\n" +
        "root = \"src/main.ddr\"\n\n" +
        "[target.arm64-macos.native]\n" +
        "rpath = [\"@executable_path\"]\n" +
        "[target.arm64-macos.native.libs.oracle]\n" +
        "path = \"@rpath/" + lib_file + "\"\n\n" +
        "[target.arm64-linux.native]\n" +
        "rpath = [\"$ORIGIN\"]\n" +
        "[target.arm64-linux.native.libs.oracle]\n" +
        "soname = \"" + lib_file + "\"\n\n" +
        "[target.x86_64-linux.native]\n" +
        "rpath = [\"$ORIGIN\"]\n" +
        "[target.x86_64-linux.native.libs.oracle]\n" +
        "soname = \"" + lib_file + "\"\n"
    if !sys.write_text(proj + "/dunder.toml", manifest_src).ok ||
       !sys.write_text(proj + "/src/ffi_mod.ddr", build_helper_mod_source()).ok ||
       !sys.write_text(proj + "/src/main.ddr", build_main_source()).ok {
        return harness.fail("failed writing proj sources")
    }

    exe := proj + "/extern_blocks_demo"
    for mode in 0..3 {
        mut args: []string = ["build", proj + "/src/main.ddr", "-o", exe.clone()]
        if mode == 1 { args.push("--scalar-opt=off"); args.push("--ownership-opt=off"); args.push("--mir=off") }
        if mode == 2 { args.push("--jobs"); args.push("4") }
        if !harness.run_checked(cli.compiler, args, proj, 0, true, &mut res) { return false }
        if !harness.run_checked(exe.clone(), [], proj, 0, true, &mut res) { return false }
        if res.stdout_text() != "ffi extern blocks ok\n" || res.stderr.len > 0 {
            return harness.fail(f"extern_blocks mode {mode} unexpected output: stdout={res.stdout_text()} stderr={res.stderr_text()}")
        }
    }
    // Exercise parallel frontend validation & codegen workers (--jobs 4) with many functions using
    // ffi.c_* aliases, @repr(C) union, @repr(i32) open enum, and extern static globals!
    mut par_src := "capability unsafe\nimport std.ffi as ffi\nimport .ffi_mod as m\n\n" +
        "@repr(C)\nunion ParU { i: ffi.c_int, u: ffi.c_uint }\n\n" +
        "@repr(i32)\nenum ParE { A = 1, B = 2 }\n\n"
    for k in 0..24 {
        par_src += f"fn par_worker_{k}(x: ffi.c_int) -> ffi.c_long {{\n" +
            f"    mut u := ParU {{ i: x + {k} }}\n" +
            f"    e := ParE::from_raw(x)\n" +
            f"    unsafe {{\n" +
            f"        mut ch: ffi.c_char = 0\n" +
            f"        _ := ch\n" +
            f"        base := m.demo_interface.version + m.global_counter\n" +
            f"        out: ffi.c_long = i64(u.i + e.to_raw() + base)\n" +
            f"        out\n" +
            f"    }}\n" +
            f"}}\n"
    }
    par_src += "fn main() {\n    mut total: ffi.c_long = 0\n"
    for k in 0..24 {
        par_src += f"    total = total + par_worker_{k}(1)\n"
    }
    par_src += "    assert(total > 0)\n    print(\"parallel ffi ok\")\n}\n"
    par_path := proj + "/src/parallel_ffi.ddr"
    par_exe := proj + "/parallel_ffi"
    if !sys.write_text(par_path, par_src).ok { return harness.fail("failed writing parallel_ffi.ddr") }
    if !harness.run_checked(cli.compiler, ["check", par_path.clone(), "--jobs", "4"], proj, 0, true, &mut res) { return false }
    if !harness.run_checked(cli.compiler, ["build", par_path, "--jobs", "4", "-o", par_exe.clone()], proj, 0, true, &mut res) { return false }
    if !harness.run_checked(par_exe, [], proj, 0, true, &mut res) { return false }
    if res.stdout_text() != "parallel ffi ok\n" || res.stderr.len > 0 {
        return harness.fail("parallel_ffi unexpected output: " + res.stdout_text() + " / " + res.stderr_text())
    }

    // Check native_libs dependency allowlist for @link(...)
    if !check_native_libs_allowlist(&cli, directory) { return false }

    // Negative fail-closed tests
    if !check_compile_fail(&cli, directory, "call_without_unsafe",
        "capability unsafe\nimport std.ffi as ffi\n@link(\"c\") extern \"C\" { fn strlen(s: *const ffi.c_char) -> usize }\nfn main() { _ := strlen(c\"hi\".as_ptr()) }\n",
        "call requires unsafe") { return false }

    if !check_compile_fail(&cli, directory, "static_read_without_unsafe",
        "capability unsafe\nimport std.ffi as ffi\n@link(\"c\") extern \"C\" { static mut environ: *mut ffi.c_void }\nfn main() { _ := environ }\n",
        "requires unsafe") { return false }

    if !check_compile_fail(&cli, directory, "static_write_without_unsafe",
        "capability unsafe\nimport std.ffi as ffi\n@link(\"c\") extern \"C\" { static mut counter: i32 }\nfn main() { counter = 1 }\n",
        "requires unsafe") { return false }

    if !check_compile_fail(&cli, directory, "immut_static_write",
        "capability unsafe\n@link(\"c\") extern \"C\" { static readonly_val: i32 }\nfn main() { unsafe { readonly_val = 2 } }\n",
        "cannot assign to immutable extern static") { return false }

    if !check_compile_fail(&cli, directory, "immut_static_addr_mut",
        "capability unsafe\n@link(\"c\") extern \"C\" { static readonly_val: i32 }\nfn main() { unsafe { _ := addr_of(&mut readonly_val) } }\n",
        "cannot take mutable address of immutable extern static") { return false }

    if !check_compile_fail(&cli, directory, "opaque_static_by_val",
        "capability unsafe\nextern type OpaqueG\n@link(\"c\") extern \"C\" { static g: OpaqueG }\nfn main() { unsafe { _ := g } }\n",
        "cannot read opaque extern static") { return false }

    if !check_compile_fail(&cli, directory, "extern_block_no_cap",
        "@link(\"c\") extern \"C\" { fn getpid() -> i32 }\nfn main() {}\n",
        "capability unsafe") { return false }

    if !check_compile_fail(&cli, directory, "extern_fn_no_cap",
        "extern \"C\" fn cb(x: i32) -> i32 { x }\nfn main() { _ := cb }\n",
        "capability unsafe") { return false }

    if !check_compile_fail(&cli, directory, "variadic_unpromoted_u8",
        "capability unsafe\nimport std.ffi as ffi\n@link(\"c\") extern \"C\" { fn snprintf(b: *mut ffi.c_char, n: usize, f: *const ffi.c_char, ...) -> ffi.c_int }\nfn main() { unsafe { mut b: [ffi.c_char; 8] = [0; 8]; x: u8 = 5; _ := snprintf(b.as_mut_ptr(), 8, c\"%d\".as_ptr(), x) } }\n",
        "explicitly converted to i32 or u32") { return false }

    if !check_compile_fail(&cli, directory, "variadic_unpromoted_f32",
        "capability unsafe\nimport std.ffi as ffi\n@link(\"c\") extern \"C\" { fn snprintf(b: *mut ffi.c_char, n: usize, f: *const ffi.c_char, ...) -> ffi.c_int }\nfn main() { unsafe { mut b: [ffi.c_char; 8] = [0; 8]; x: f32 = 1.5; _ := snprintf(b.as_mut_ptr(), 8, c\"%f\".as_ptr(), x) } }\n",
        "explicitly converted to f64") { return false }

    if !check_compile_fail(&cli, directory, "extern_cb_requires_cap",
        "capability unsafe\n@requires(filesystem)\nextern \"C\" fn fs_cb(x: i32) -> i32 { x }\nfn main() { f := fs_cb; _ := f }\n",
        "capability") { return false }

    // Cross-target compilation checks (x86_64-windows, wasm32, wasm32-wasi)
    cross_src := directory + "/cross_extern_blocks.ddr"
    if !sys.write_text(cross_src, build_cross_source()).ok {
        return harness.fail("failed writing cross_extern_blocks.ddr")
    }
    for target in ["x86_64-windows", "wasm32", "wasm32-wasi"] {
        out := directory + "/cross_" + target + ".bin"
        if !harness.run_checked(cli.compiler, ["build", cross_src.clone(), "--target", target.clone(), "-o", out], directory, 0, true, &mut res) {
            return harness.fail("cross-compile failed for target " + target + ":\n" + res.stderr_text())
        }
    }
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 { return harness.fail("unexpected argument: " + cli.extra_args[0]) }
    tmp := fs.temp_dir("dunder-ffi-extern-blocks-")
    if !tmp.ok { return harness.fail("temp_dir failed") }
    ok := run_all(&cli, tmp.value)
    _ := fs.remove_all(tmp.value)
    if !ok { return false }
    print("PASS test-ffi-extern-blocks (@link extern blocks, ... variadics, extern static globals, top-level extern fn callbacks, macOS frameworks/ObjC, weak symbols/libs, native_libs allowlist, negative tests, cross-targets)")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if run_suite(&cli) { 0 } else { 1 }
}
