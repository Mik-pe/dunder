capability process, filesystem, network, stdio

import .harness as harness
import std.fs as fs
import sys

fn http_web_test_source(work_dir: string) -> string {
    "capability filesystem, network, unsafe\n\n" +
    "import http\n" +
    "import std.bytes as bytes\n" +
    "import std.net as net\n" +
    "import std.parse as parse\n" +
    "import std.sync as sync\n" +
    "import std.time as time\n" +
    "import sys\n\n" +
    "struct WebHandler {\n" +
    "    tag: string,\n" +
    "}\n\n" +
    "impl http.Handler for WebHandler {\n" +
    "    fn handle(&self, req: &http.Request) -> http.Response {\n" +
    "        path := http.target_path(req.target)\n" +
    "        if path == \"/hello\" {\n" +
    "            qp := http.parse_query(http.target_query(req.target)).unwrap()\n" +
    "            b := http.param_get(&qp, \"b\").unwrap_or(\"\")\n" +
    "            return http.Response::text(200, self.tag + \":\" + b)\n" +
    "                .with_header(\"X-Path\", path)\n" +
    "        }\n" +
    "        if path == \"/echo\" || path == \"/chunked\" {\n" +
    "            txt := bytes.decode(&req.body).unwrap()\n" +
    "            return http.Response::text(200, path + \"=\" + txt)\n" +
    "        }\n" +
    "        http.Response::text(404, \"not found\")\n" +
    "    }\n" +
    "}\n\n" +
    "fn check_web_primitives() {\n" +
    "    // Response builder\n" +
    "    mut cookie_cfg := http.SetCookie::new(\"sid\", \"abc123\")\n" +
    "    cookie_cfg.path = \"/\"\n" +
    "    cookie_cfg.http_only = true\n" +
    "    cookie_cfg.secure = true\n" +
    "    cookie_cfg.max_age = .Some(3600)\n" +
    "    cookie_cfg.same_site = .Some(.Lax)\n" +
    "    resp := http.Response::json(201, \"{\\\"ok\\\":true}\")\n" +
    "        .with_header(\"X-One\", \"1\")\n" +
    "        .with_cookie(&cookie_cfg)\n" +
    "    wire := bytes.decode(&http.encode_response(&resp, false, true).unwrap()).unwrap()\n" +
    "    assert(wire.len > 0)\n" +
    "    assert(wire[0..21] == \"HTTP/1.1 201 Created\\r\")\n" +
    "    // Forbidden override header & HEAD omission & 204 body omission\n" +
    "    bad := http.Response::text(200, \"x\").with_header(\"Content-Length\", \"99\")\n" +
    "    assert(http.encode_response(&bad, false, true).is_err())\n" +
    "    head_wire := bytes.decode(&http.encode_response(&http.Response::text(200, \"secret\"), true, false).unwrap()).unwrap()\n" +
    "    assert(head_wire[0..16] == \"HTTP/1.1 200 OK\\r\")\n" +
    "    assert(head_wire[head_wire.len - 4..head_wire.len] == \"\\r\\n\\r\\n\")\n" +
    "    r204 := http.Response::empty(204)\n" +
    "    w204 := bytes.decode(&http.encode_response(&r204, false, true).unwrap()).unwrap()\n" +
    "    assert(w204 == \"HTTP/1.1 204 No Content\\r\\nConnection: keep-alive\\r\\n\\r\\n\")\n\n" +
    "    // Connection keep-alive helpers\n" +
    "    req11 := http.Request { ok: true, status: 200, method: \"GET\", target: \"/\", header_names: [\"host\"], header_values: [\"localhost\"], body: [], error: \"\" }\n" +
    "    assert(http.should_keep_alive(&req11, 1))\n" +
    "    assert(!http.should_keep_alive(&req11, 0))\n" +
    "    req11_close := http.Request { ok: true, status: 200, method: \"GET\", target: \"/\", header_names: [\"host\", \"connection\"], header_values: [\"localhost\", \"upgrade, Close\"], body: [], error: \"\" }\n" +
    "    assert(http.connection_wants_close(&req11_close) && !http.should_keep_alive(&req11_close, 1))\n" +
    "    req10_ka := http.Request { ok: true, status: 200, method: \"GET\", target: \"/\", header_names: [\"connection\"], header_values: [\"Keep-Alive\"], body: [], error: \"\" }\n" +
    "    assert(http.connection_wants_keep_alive(&req10_ka) && http.should_keep_alive(&req10_ka, 0))\n\n" +
    "    // Percent and form encoding\n" +
    "    assert(http.percent_encode(\"hello world/åäö?\") == \"hello%20world%2F%C3%A5%C3%A4%C3%B6%3F\")\n" +
    "    assert(http.percent_decode(\"hello%20world%2F%C3%A5%C3%A4%C3%B6%3F\").unwrap() == \"hello world/åäö?\")\n" +
    "    assert(http.percent_decode(\"bad%2\").is_err())\n" +
    "    assert(http.percent_decode(\"bad%ZZ\").is_err())\n" +
    "    assert(http.percent_decode(\"%FF\").is_err())\n" +
    "    assert(http.percent_decode_bytes(\"%FF%00\").unwrap().len == 2)\n" +
    "    assert(http.form_encode_component(\"a + b\") == \"a%20%2B%20b\" || http.form_encode_component(\"a + b\") == \"a+%2B+b\")\n" +
    "    assert(http.form_decode(\"a+%2B+b\").unwrap() == \"a + b\")\n\n" +
    "    // Query and urlencoded forms\n" +
    "    assert(http.target_path(\"/items?tag=a&tag=b\") == \"/items\")\n" +
    "    assert(http.target_query(\"/items?tag=a&tag=b\") == \"tag=a&tag=b\")\n" +
    "    qparams := http.parse_query(\"?tag=hello+world&tag=two&&flag\").unwrap()\n" +
    "    assert(http.param_get(&qparams, \"tag\").unwrap() == \"hello world\")\n" +
    "    all_tags := http.param_get_all(&qparams, \"tag\")\n" +
    "    assert(all_tags.len == 2 && all_tags[0] == \"hello world\" && all_tags[1] == \"two\")\n" +
    "    assert(http.param_get(&qparams, \"flag\").unwrap() == \"\")\n" +
    "    enc_form := http.encode_form_urlencoded(&qparams)\n" +
    "    form_body := bytes.from_text(enc_form)\n" +
    "    fparams := http.parse_form_urlencoded(&form_body).unwrap()\n" +
    "    assert(http.param_get(&fparams, \"tag\").unwrap() == \"hello world\")\n\n" +
    "    // Cookies & SetCookie\n" +
    "    creq := http.Request { ok: true, status: 200, method: \"GET\", target: \"/\", header_names: [\"cookie\", \"cookie\"], header_values: [\"a=1; b=\\\"two\\\"\", \"c=3\"], body: [], error: \"\" }\n" +
    "    cookies := http.parse_cookies(&creq)\n" +
    "    assert(cookies.len == 3 && http.cookie(&creq, \"a\").unwrap() == \"1\" && http.cookie(&creq, \"b\").unwrap() == \"two\" && http.cookie(&creq, \"c\").unwrap() == \"3\")\n" +
    "    assert(cookie_cfg.format().unwrap() == \"sid=abc123; Path=/; Max-Age=3600; Secure; HttpOnly; SameSite=Lax\")\n" +
    "    bad_cookie := http.SetCookie::new(\"bad;name\", \"v\")\n" +
    "    assert(bad_cookie.format().is_err())\n\n" +
    "    // Authorization Basic / Bearer\n" +
    "    breq := http.Request { ok: true, status: 200, method: \"GET\", target: \"/\", header_names: [\"authorization\"], header_values: [http.format_bearer(\"tok_123\")], body: [], error: \"\" }\n" +
    "    assert(http.parse_bearer(&breq).unwrap() == \"tok_123\")\n" +
    "    areq := http.Request { ok: true, status: 200, method: \"GET\", target: \"/\", header_names: [\"authorization\"], header_values: [http.format_basic(\"alice\", \"s:e:c\")], body: [], error: \"\" }\n" +
    "    creds := http.parse_basic(&areq).unwrap()\n" +
    "    assert(creds.username == \"alice\" && creds.password == \"s:e:c\")\n\n" +
    "    // HTML escaping\n" +
    "    assert(http.escape_html(\"<script a=\\\"1\\\" b='2'>&å</script>\") == \"&lt;script a=&quot;1&quot; b=&#x27;2&#x27;&gt;&amp;å&lt;/script&gt;\")\n" +
    "}\n\n" +
    "fn recv_one_http_response(stream: &net.TcpStream, head: bool, buf: &mut []u8) -> (i32, string, string) {\n" +
    "    while true {\n" +
    "        hdr_end := bytes.find_double_crlf(&buf, 0, buf.len).unwrap_or(-1)\n" +
    "        if hdr_end >= 0 {\n" +
    "            head_txt := bytes.decode_range(&buf, 0, hdr_end).unwrap()\n" +
    "            mut clen := 0\n" +
    "            mut conn := \"\"\n" +
    "            // Parse status line + headers\n" +
    "            mut pos := 0\n" +
    "            first_nl := bytes.find_crlf(&buf, 0, hdr_end + 2).unwrap()\n" +
    "            status_line := bytes.decode_range(&buf, 0, first_nl).unwrap()\n" +
    "            status := i32(parse.integer(status_line[9..12]).value)\n" +
    "            pos = first_nl + 2\n" +
    "            while pos < hdr_end {\n" +
    "                nl := bytes.find_crlf(&buf, pos, hdr_end + 2).unwrap()\n" +
    "                line := bytes.decode_range(&buf, pos, nl).unwrap()\n" +
    "                pos = nl + 2\n" +
    "                if line.len > 15 && (line[0..15] == \"Content-Length:\" || line[0..15] == \"content-length:\") {\n" +
    "                    mut vstart := 15\n" +
    "                    while vstart < line.len && line[vstart] == 32 { vstart += 1 }\n" +
    "                    clen = i32(parse.integer(line[vstart..line.len]).value)\n" +
    "                } else if line.len > 11 && (line[0..11] == \"Connection:\" || line[0..11] == \"connection:\") {\n" +
    "                    mut vstart := 11\n" +
    "                    while vstart < line.len && line[vstart] == 32 { vstart += 1 }\n" +
    "                    conn = line[vstart..line.len]\n" +
    "                }\n" +
    "            }\n" +
    "            body_start := hdr_end + 4\n" +
    "            need := body_start + (if head { 0 } else { clen })\n" +
    "            while buf.len < need {\n" +
    "                rd := stream.read_append(&mut buf, 4096)\n" +
    "                if rd.is_err() || rd.unwrap() <= 0 { break }\n" +
    "            }\n" +
    "            assert(buf.len >= need)\n" +
    "            body := if head || clen == 0 { \"\" } else { bytes.decode_range(&buf, body_start, body_start + clen).unwrap() }\n" +
    "            bytes.consume_prefix(&mut buf, need)\n" +
    "            _ := head_txt\n" +
    "            return (status, conn, body)\n" +
    "        }\n" +
    "        rd := stream.read_append(&mut buf, 4096)\n" +
    "        assert(!rd.is_err() && rd.unwrap() > 0)\n" +
    "    }\n" +
    "    (0, \"\", \"\")\n" +
    "}\n\n" +
    "struct ClientArgs { port: i32, cancel: sync.CancelToken }\n\n" +
    "fn serve_client_driver(move args: ClientArgs) -> i64 {\n" +
    "    t0 := time.monotonic_ms()\n" +
    "    // 1. Keep-alive connection with 4 sequential requests\n" +
    "    mut s := net.TcpStream::connect(net.loopback(), args.port).unwrap()\n" +
    "    _ := s.set_read_timeout(5000)\n" +
    "    mut rx: []u8 = []\n" +
    "    assert(s.write_all(&bytes.from_text(\"GET /hello?b=hi+there HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\")).ok)\n" +
    "    r1 := recv_one_http_response(&s, false, &mut rx)\n" +
    "    assert(r1.0 == 200 && r1.1 == \"keep-alive\" && r1.2 == \"srv:hi there\")\n\n" +
    "    assert(s.write_all(&bytes.from_text(\"POST /echo HTTP/1.1\\r\\nHost: localhost\\r\\nContent-Length: 5\\r\\n\\r\\nworld\")).ok)\n" +
    "    r2 := recv_one_http_response(&s, false, &mut rx)\n" +
    "    assert(r2.0 == 200 && r2.1 == \"keep-alive\" && r2.2 == \"/echo=world\")\n\n" +
    "    assert(s.write_all(&bytes.from_text(\"POST /chunked HTTP/1.1\\r\\nHost: localhost\\r\\nTransfer-Encoding: chunked\\r\\n\\r\\n3\\r\\nabc\\r\\n0\\r\\nDigest: ok\\r\\n\\r\\n\")).ok)\n" +
    "    r3 := recv_one_http_response(&s, false, &mut rx)\n" +
    "    assert(r3.0 == 200 && r3.1 == \"keep-alive\" && r3.2 == \"/chunked=abc\")\n\n" +
    "    assert(s.write_all(&bytes.from_text(\"HEAD /hello?b=z HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n\")).ok)\n" +
    "    r4 := recv_one_http_response(&s, true, &mut rx)\n" +
    "    assert(r4.0 == 200 && r4.1 == \"close\" && r4.2 == \"\")\n" +
    "    mut eof_buf: []u8 = []\n" +
    "    eof := s.read_append(&mut eof_buf, 64)\n" +
    "    assert(!eof.is_err() && eof.unwrap() == 0)\n" +
    "    _ := s.close()\n\n" +
    "    // 2. Open 16 simultaneous idle keep-alive sockets while workers == 2\n" +
    "    mut idle_set := net.StreamSet::new()\n" +
    "    for _ in 0..16 {\n" +
    "        st := net.TcpStream::connect(net.loopback(), args.port).unwrap()\n" +
    "        _ := st.set_read_timeout(5000)\n" +
    "        assert(st.write_all(&bytes.from_text(\"GET /hello?b=idle HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\")).ok)\n" +
    "        mut tmp_rx: []u8 = []\n" +
    "        rr := recv_one_http_response(&st, false, &mut tmp_rx)\n" +
    "        assert(rr.0 == 200 && rr.2 == \"srv:idle\")\n" +
    "        _ := idle_set.insert(move st)\n" +
    "    }\n\n" +
    "    // 3. 17th request completes promptly despite 16 open idle sockets\n" +
    "    mut extra := net.TcpStream::connect(net.loopback(), args.port).unwrap()\n" +
    "    _ := extra.set_read_timeout(5000)\n" +
    "    assert(extra.write_all(&bytes.from_text(\"GET /hello?b=fast HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n\")).ok)\n" +
    "    mut erx: []u8 = []\n" +
    "    r17 := recv_one_http_response(&extra, false, &mut erx)\n" +
    "    assert(r17.0 == 200 && r17.2 == \"srv:fast\")\n" +
    "    _ := extra.close()\n\n" +
    "    // 4. Cancel wakes PollSet immediately while 16 idle sockets are still open\n" +
    "    args.cancel.cancel()\n" +
    "    idle_set.close_all()\n" +
    "    time.monotonic_ms() - t0\n" +
    "}\n\n" +
    "fn check_graceful_close_socket() {\n" +
    "    mut listener := net.TcpListener::listen(net.loopback(), 0, 8).unwrap()\n" +
    "    port := listener.local_port()\n" +
    "    mut client := net.TcpStream::connect(net.loopback(), port).unwrap()\n" +
    "    mut srv := listener.accept().unwrap()\n" +
    "    assert(client.write_all(&bytes.from_text(\"trailing\")).ok)\n" +
    "    _ := client.shutdown_write()\n" +
    "    http.graceful_close(&srv, 1000)\n" +
    "    _ := client.close()\n" +
    "    _ := srv.close()\n" +
    "    _ := listener.close()\n" +
    "}\n\n" +
    "struct IoWorkerArgs { work_rx: sync.Receiver<http.RequestJob>, done_tx: sync.Sender<http.ResponseJob>, file_path: string }\n\n" +
    "fn fs_io_worker(move args: IoWorkerArgs) -> i32 {\n" +
    "    while true {\n" +
    "        match args.work_rx.recv() {\n" +
    "            .Some(job) => {\n" +
    "                content := sys.read(args.file_path).unwrap()\n" +
    "                resp := http.Response::text(200, content + \":\" + job.request.target)\n" +
    "                if !args.done_tx.send(http.ResponseJob { conn_id: job.conn_id, generation: job.generation, response: resp }) { break }\n" +
    "            },\n" +
    "            .None => break,\n" +
    "        }\n" +
    "    }\n" +
    "    1\n" +
    "}\n\n" +
    "struct ChClientArgs { port: i32, cancel: sync.CancelToken }\n\n" +
    "fn serve_channel_client(move args: ChClientArgs) -> i32 {\n" +
    "    mut st := net.TcpStream::connect(net.loopback(), args.port).unwrap()\n" +
    "    _ := st.set_read_timeout(5000)\n" +
    "    assert(st.write_all(&bytes.from_text(\"GET /io-check HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n\")).ok)\n" +
    "    mut rx: []u8 = []\n" +
    "    r := recv_one_http_response(&st, false, &mut rx)\n" +
    "    assert(r.0 == 200 && r.2 == \"file-payload:/io-check\")\n" +
    "    _ := st.close()\n" +
    "    args.cancel.cancel()\n" +
    "    1\n" +
    "}\n\n" +
    "fn check_serve_and_serve_channel() {\n" +
    "    // A. Generic http.serve<WebHandler>\n" +
    "    mut listener := net.TcpListener::listen(net.loopback(), 0, 64).unwrap()\n" +
    "    port := listener.local_port()\n" +
    "    cancel := sync.CancelToken::new()\n" +
    "    mut cfg := http.ServerConfig::default()\n" +
    "    cfg.workers = 2\n" +
    "    cfg.keep_alive_timeout_ms = 30000\n" +
    "    handler := WebHandler { tag: \"srv\" }\n" +
    "    mut client_elapsed: i64 = 0\n" +
    "    t_srv_start := time.monotonic_ms()\n" +
    "    task scope cli(1) with (network) {\n" +
    "        cid := cli.spawn(serve_client_driver, ClientArgs { port: port, cancel: cancel.clone_handle() })\n" +
    "        assert(http.serve<WebHandler>(&listener, &cfg, &cancel, &handler).is_ok())\n" +
    "        client_elapsed = cid.join()\n" +
    "    }\n" +
    "    total_elapsed := time.monotonic_ms() - t_srv_start\n" +
    "    assert(total_elapsed - client_elapsed < 1000)\n" +
    "    _ := listener.close()\n\n" +
    "    // B. http.serve_channel with caller-owned task scope with (filesystem, network)\n" +
    "    data_file := \"" + work_dir + "/served.txt\"\n" +
    "    assert(sys.write_text(data_file, \"file-payload\").ok)\n" +
    "    mut l2 := net.TcpListener::listen(net.loopback(), 0, 16).unwrap()\n" +
    "    p2 := l2.local_port()\n" +
    "    c2 := sync.CancelToken::new()\n" +
    "    ch_work := sync.channel<http.RequestJob>(16)\n" +
    "    ch_done := sync.channel<http.ResponseJob>(16)\n" +
    "    task scope workers(2) with (filesystem, network) {\n" +
    "        wid := workers.spawn(fs_io_worker, IoWorkerArgs { work_rx: ch_work.1.clone_receiver(), done_tx: ch_done.0.clone_sender(), file_path: data_file.clone() })\n" +
    "        cid := workers.spawn(serve_channel_client, ChClientArgs { port: p2, cancel: c2.clone_handle() })\n" +
    "        assert(http.serve_channel(&l2, &cfg, &c2, &ch_work.0, &ch_done.1).is_ok())\n" +
    "        ch_work.0.close()\n" +
    "        ch_done.1.close()\n" +
    "        assert(wid.join() == 1)\n" +
    "        assert(cid.join() == 1)\n" +
    "    }\n" +
    "    _ := l2.close()\n" +
    "}\n\n" +
    "fn main() -> i32 {\n" +
    "    check_web_primitives()\n" +
    "    check_graceful_close_socket()\n" +
    "    check_serve_and_serve_channel()\n" +
    "    print(\"PASS http_web\")\n" +
    "    0\n" +
    "}\n"
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if cli.extra_args.len > 0 { _ := sys.eprint("unexpected argument: " + cli.extra_args[0]); return 2 }

    tmp := fs.temp_dir("dunder-http-web-")
    if !tmp.ok { _ := sys.eprint("temp_dir failed"); return 1 }
    work := tmp.value

    pkg_toml := "name = \"http-web-probe\"\nroot = \"main.ddr\"\n\n[dependencies]\nhttp = { path = \"" + cli.root + "/packages/http\", capabilities = [\"network\", \"unsafe\"], native_libs = [\"c\"] }\n"
    if !sys.write_text(work + "/dunder.toml", pkg_toml).ok || !sys.write_text(work + "/main.ddr", http_web_test_source(work)).ok {
        _ := fs.remove_all(work)
        _ := sys.eprint("failed writing http_web test package")
        return 1
    }

    bin := work + "/http-web-probe"
    mut out := harness.empty_output()
    mut ok := harness.run_checked(cli.compiler, ["build", work + "/main.ddr", "-o", bin.clone()], work, 0, false, &mut out)
    if ok {
        ok = harness.run_checked(bin, [], work, 0, false, &mut out)
    }
    _ := fs.remove_all(work)
    if !ok { return 1 }
    print("PASS http web: Response, keep-alive, web primitives, PollSet::waker multiplexed server, and serve_channel verified")
    0
}
