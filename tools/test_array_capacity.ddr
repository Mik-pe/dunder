capability process, filesystem

import .harness as harness
import std.fs as fs
import std.process as process
import sys

fn probe(cli: &harness.BaseCli, work: string, emitter: string, host: i32, name: string, mode: string, argument: string, status: i32, expected_out: string, repeat: bool) -> bool {
    var res := harness.empty_output()
    var no_args: []string = []
    for target in 0..4 {
        image := work + "/" + name + "-" + target.str()
        if !harness.run_checked(emitter, [image, target.str(), mode, argument], work, 0, false, &mut res) {
            return false
        }
        if target != host && target != 3 {
            continue
        }
        if target == host {
            if !harness.run_checked(image, no_args, work, status, false, &mut res) {
                return false
            }
        } else {
            var wasm_args: []string = [cli.root + "/tools/runtime-contract-wasm.cjs", image]
            if repeat { wasm_args.push("--repeat") }
            var expected_wasm := status
            if status != 0 { expected_wasm = 125 }
            if !harness.run_checked("node", wasm_args, work, expected_wasm, false, &mut res) {
                return false
            }
        }
        got_out := process.stdout_text(&res)
        if got_out != expected_out {
            return harness.fail(name + "-" + target.str() + ": unexpected stdout: got '" + got_out + "', expected '" + expected_out + "'")
        }
    }
    print("PASS " + name + ": all target images built; host/Wasm executed")
    true
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    emitter := work + "/emitter"
    var res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/array-capacity-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    host := harness.host_id()
    if !probe(&cli, work, emitter, host, "growth-boundaries", "math", "", 0, "", false) {
        return false
    }
    invalid_counts: []i64 = [-1, -2147483648, -9223372036854775808, 2147483648, 4294967295, 9223372036854775807]
    for count in invalid_counts {
        c_str := count.str()
        for mode in ["growth-invalid", "reserve-invalid"] {
            if !probe(&cli, work, emitter, host, mode + "-" + c_str, mode, c_str, 109, "", false) {
                return false
            }
        }
    }
    if !probe(&cli, work, emitter, host, "push-at-i32-max", "push-limit", "", 109, "", false) {
        return false
    }
    if !probe(&cli, work, emitter, host, "packed-clones-conversions", "program", cli.root + "/tests/fixtures/array-capacity-values.ddr", 0, "42\n", true) {
        return false
    }
    for count in [-1, 2147483647] {
        c_str := count.str()
        source := work + "/source-trap-" + c_str + ".ddr"
        if !sys.write_text(source, "fn main(){var a:[]u8=[];print(41);a.reserve(" + c_str + ");print(42)}\n").ok {
            return harness.fail("failed to write " + source)
        }
        if !probe(&cli, work, emitter, host, "source-capacity-trap-" + c_str, "program", source, 109, "41\n", false) {
            return false
        }
    }
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len != 0 {
        return harness.fail("unexpected extra arguments")
    }
    td := fs.temp_dir("dunder-array-capacity-")
    if !td.ok { return harness.fail("temp_dir failed") }
    ok := run_in_work(&cli, td.value)
    _ := fs.remove_all(td.value)
    if !ok { return false }
    print("Managed array bounds: shared growth math, reserve/push guards and ordinary values passed; cross-native images built but not executed")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
