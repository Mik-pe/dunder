capability process, filesystem

import .harness as harness
import .native_probe as native
import .probe_cli as cli
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

fn build_flags(target: string, jobs: string, direct: bool) -> []string {
    mut args: []string = ["--target", target.clone(), "--jobs", jobs.clone()]
    if direct {
        for flag in move native.direct_flags() { args.push(move flag) }
    }
    args
}

fn add_flags(args: &mut []string, flags: &[]string) {
    for flag in flags { args.push(flag.clone()) }
}

fn check_errors(compiler: string, work: string, target: string, jobs: string, total: &mut i32) -> bool {
    image := work + "/preserved-image"
    marker := "previous valid image"
    mut result := harness.empty_output()
    cases := invalid_cases()
    for i in 0..cases.len {
        (name, body, expected) := cases[i].clone()
        source := f"{work}/{name}.ddr"
        needs_net := text.contains(body, "net.")
        needs_proc := text.contains(body, "process.")
        mut prefix := ""
        if needs_net && needs_proc { prefix += "capability network, process\n" }
        else if needs_net { prefix += "capability network\n" }
        else if needs_proc { prefix += "capability process\n" }
        if needs_net { prefix += "import std.net as net\n" }
        if needs_proc { prefix += "import std.process as process\n" }
        if !sys.write_text(source, prefix + body + "\n").ok { return harness.fail(f"cannot write {source}") }
        modes := if i < 2 { 2 } else { 1 }
        for mode in 0..modes {
            flags := build_flags(target, jobs, mode == 1)
            mut check: []string = ["check", source.clone(), "--agent"]
            add_flags(&mut check, &flags)
            if !harness.run_checked(compiler, check, work, 1, false, &mut result) { return false }
            message := harness.agent_error_message(result.stdout_text(), source, expected, "")
            if message.len == 0 { return false }
            if i < 2 {
                if !sys.write_text(image, marker).ok { return harness.fail(f"cannot prepare {image}") }
                mut build: []string = ["build", source.clone(), "-o", image.clone()]
                add_flags(&mut build, &flags)
                if !harness.run_checked(compiler, build, work, 1, false, &mut result) { return false }
                restored := sys.read_text(image)
                if !text.contains(result.stderr_text(), message) || !restored.ok || restored.value != marker {
                    return harness.fail(f"{target}/{name}: build changed its diagnostic or previous output\n{result.stderr_text()}")
                }
            }
            total += 1
        }
    }
    true
}

fn check_fixtures(compiler: string, root: string, work: string, target: string, host: string, jobs: string, total: &mut i32) -> bool {
    cases: [](string, string) = [("resource-ownership", "resource handles ok\n"), ("resource-transfers", "resource transfers ok\n")]
    mut result := harness.empty_output()
    for fixture in move cases {
        (name, expected) := fixture
        source := f"{root}/tests/fixtures/{name}.ddr"
        if target == host && !harness.run_checked(compiler, ["check", source.clone(), "--target", target.clone(), "--jobs", jobs.clone()], root, 0, false, &mut result) {
            return false
        }
        modes := if target == host { 2 } else { 1 }
        for mode in 0..modes {
            image := f"{work}/{name}-{target}-{mode}"
            mut args: []string = ["build", source.clone(), "--runtime-profile", "-o", image.clone()]
            flags := build_flags(target, jobs, mode == 1)
            add_flags(&mut args, &flags)
            if !harness.run_checked(compiler, args, root, 0, false, &mut result) { return false }
            if target != host { continue }
            if !harness.run_target_image(target, image, work, &mut result) || !harness.stdout_is(&result, expected, name) { return false }
            profile := json.Doc::parse_text(result.stderr_text())
            counters := profile.field(profile.root, "counters")
            array := profile.get_i64(counters, "array_clone_calls")
            record := profile.get_i64(counters, "record_clone_calls")
            if array.is_none() || array.unwrap() != 0 || (name == "resource-transfers" && (record.is_none() || record.unwrap() != 0)) {
                return harness.fail(f"{image}: unexpected resource copies\n{result.stderr_text()}")
            }
            total += 1
        }
    }
    true
}

fn check_cleanups(compiler: string, root: string, work: string, host: string, jobs: string, total: &mut i32) -> bool {
    expected := "27\n28\n29\n10\n11\n12\n13\n14\n15\n16\n17\n18\n0\n19\n26\n21\n22\n25\n23\n24\n20\n"
    source := root + "/tests/fixtures/resource-cleanup.ddr"
    mut result := harness.empty_output()
    for target in ["arm64-macos", "arm64-linux", "x86_64-linux", "wasm32"] {
        modes := if target == host { 2 } else { 1 }
        for mode in 0..modes {
            image := f"{work}/cleanup-{target}-{mode}"
            mut args: []string = ["build", source.clone(), "-o", image.clone()]
            workers := if target == host { jobs.clone() } else { "1" }
            flags := build_flags(target, workers, mode == 1)
            add_flags(&mut args, &flags)
            if !harness.run_checked(compiler, args, work, 0, false, &mut result) { return false }
            if target == host || target == "wasm32" {
                if !harness.run_target_image(target, image, work, &mut result) || !harness.stdout_is(&result, expected, image) { return false }
                total += 1
            }
        }
    }
    copy := work + "/cleanup-cached.ddr"
    source_data := sys.read_u8(source)
    if !source_data.ok || !sys.write_u8(copy, &source_data.value).ok { return harness.fail(f"cannot copy {source}") }
    for _ in 0..2 {
        if !harness.run_checked(compiler, ["run", copy.clone(), "--incremental", "--jobs", jobs.clone()], work, 0, false, &mut result) ||
           !harness.stdout_is(&result, expected, copy) { return false }
        total += 1
    }
    true
}

fn run_suite(compiler: string, root: string, work: string, host: string, jobs: string) -> bool {
    mut checked := 0
    mut executed := 0
    host_workers := if host == "arm64-macos" { jobs.clone() } else { "1" }
    if !check_errors(compiler, work, host, host_workers, &mut checked) { return false }
    for target in harness.targets() {
        workers := if host == "arm64-macos" && host == target { jobs.clone() } else { "1" }
        if !check_fixtures(compiler, root, work, target, host, workers, &mut executed) { return false }
    }
    if !check_cleanups(compiler, root, work, host, jobs, &mut executed) { return false }
    if !check_no_clone_hints(compiler, work, host, jobs, &mut checked) { return false }
    print(f"PASS resource ownership: {checked} diagnostic/build pairs, {executed} host executions")
    true
}

fn check_no_clone_hints(compiler: string, work: string, target: string, jobs: string, total: &mut i32) -> bool {
    cases: [](string, string, string) = [
        ("resource-borrowed-match", "fn f(r: Result<process.Child, string>) -> process.Child { match r { .Ok(c) => c, .Err(_) => f(r) } } fn main() {}", "cannot move a borrowed pattern binding"),
        ("resource-push-without-move", "@resource struct H { fd: i32 } fn main() { h := H { fd: 1 }; mut items: []H = []; items.push(h) }", "push requires 'move value' or a fresh owned expression"),
        ("resource-defer-move", "@resource struct H { fd: i32 } fn main() { h := H { fd: 1 }; defer { print(h.fd) }; moved := h }", "cannot move a value captured by defer"),
    ]
    mut result := harness.empty_output()
    for row in move cases {
        (name, body, expected) := row
        source := f"{work}/noclone-{name}.ddr"
        if !sys.write_text(source, "import std.process as process\n" + body + "\n").ok { return harness.fail(f"cannot write {source}") }
        flags := build_flags(target, jobs, false)
        mut check: []string = ["check", source.clone(), "--agent"]
        add_flags(&mut check, &flags)
        if !harness.run_checked(compiler, check, work, 1, false, &mut result) { return false }
        message := harness.agent_error_message(result.stdout_text(), source, expected, "")
        if message.len == 0 { return false }
        if text.contains(message, "clone") {
            return harness.fail(f"{name}: resource diagnostic must not suggest clone: {message}")
        }
        total += 1
    }
    true
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--jobs")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_resource_ownership COMPILER [--jobs 1|4]")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    jobs := args.last("--jobs", "1")
    if jobs != "1" && jobs != "4" { _ := harness.fail("--jobs must be 1 or 4"); return 2 }
    host := process.host_target()
    root := harness.find_root()
    if root.len == 0 || host.len == 0 { _ := harness.fail("cannot determine repository or target"); return 2 }
    tmp := fs.temp_dir("dunder-resource-ownership-")
    if !tmp.ok { _ := harness.fail("cannot create resource ownership test directory"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(compiler, root, work, host, jobs) { 0 } else { 1 }
}

fn invalid_cases() -> [](string, string, string) {
    [
        ("listener-move", "fn main(){opened:=net.TcpListener::listen(net.loopback(),0,4);a:=opened.unwrap();b:=a;print(a.fd())}", "moved value"),
        ("stream-move", "fn f(move a:net.TcpStream){b:=a;print(a.fd())} fn main(){}", "moved value"),
        ("udp-move", "fn f(move a:net.UdpSocket){b:=a;print(a.fd())} fn main(){}", "moved value"),
        ("child-move", "fn f(move a:process.Child){b:=a;print(a.pid())} fn main(){}", "moved value"),
        ("listener-clone", "fn f(a:net.TcpListener){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("stream-clone", "fn f(a:net.TcpStream){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("udp-clone", "fn f(a:net.UdpSocket){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("child-clone", "fn f(a:process.Child){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("stream-set-clone", "fn f(a:net.StreamSet){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("child-set-clone", "fn f(a:process.ChildSet){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("record-clone", "struct Owner{s:net.TcpStream} fn f(a:Owner){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("enum-clone", "enum Owner{Live(net.TcpListener),Empty} fn f(a:Owner){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("nested-record-clone", "struct Inner{s:net.StreamSet} struct Outer{i:Inner} fn f(a:Outer){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("nested-enum-clone", "struct Inner{c:process.ChildSet} enum Outer{Live(Inner),Empty} fn f(a:Outer){b:=a.clone()} fn main(){}", "resource values cannot be cloned"),
        ("borrowed-return", "fn f(a:net.TcpListener)->net.TcpListener{a} fn main(){}", "borrowed"),
        ("borrowed-store", "fn f(a:process.Child){b:=a} fn main(){}", "borrowed"),
        ("constructor-move", "struct Owner{s:net.TcpStream} fn f(move a:net.TcpStream){b:=Owner{s:a};print(a.fd())} fn main(){}", "moved value"),
        ("call-move", "fn take(move a:process.Child){} fn f(move a:process.Child){take(move a);print(a.pid())} fn main(){}", "moved value"),
        ("task-input-borrow", "@resource struct R{fd:i32} fn work(r:R)->i32{r.fd} fn main(){r:=R{fd:42};task scope j(1){id:=j.spawn(work,r);print(id.join())}}", "isolated Data"),
        ("task-input-move", "@resource struct R{fd:i32} fn work(move r:R)->i32{r.fd} fn main(){r:=R{fd:42};task scope j(1){id:=j.spawn(work,move r);print(id.join())}}", "isolated Data"),
        ("task-result", "@resource struct R{fd:i32} fn work(n:i32)->R{R{fd:n}} fn main(){task scope j(1){id:=j.spawn(work,42);r:=id.join()}}", "isolated Data"),
        ("task-world", "@resource struct R{fd:i32} struct W{r:R} fn work(n:i32,w:&W)->i32{w.r.fd+n} fn main(){world:=W{r:R{fd:1}};task scope j(1,shared world){id:=j.spawn(work,41);print(id.join())}}", "isolated Data"),
        ("task-workspace", "@resource struct R{fd:i32} fn init()->R{R{fd:42}} fn work(n:i32,w:&mut R)->i32{w.fd+n} fn main(){task scope j(1,init){id:=j.spawn(work,0);print(id.join())}}", "isolated storage"),
        ("cleanup-missing", "@resource(drop) struct R{x:i32} fn main(){}", "cleanup requires a private safe method"),
        ("cleanup-consuming", "@resource(drop) struct R{x:i32} impl R{fn drop(self){}} fn main(){}", "cleanup requires a private safe method"),
        ("cleanup-return", "@resource(drop) struct R{x:i32} impl R{fn drop(&self)->i32{0}} fn main(){}", "cleanup requires a private safe method"),
        ("cleanup-public", "@resource(drop) struct R{x:i32} impl R{pub fn drop(&self){}} fn main(){}", "cleanup requires a private safe method"),
        ("cleanup-c-layout", "@resource(drop) @c_layout struct R{x:i32} impl R{fn drop(&self){}} fn main(){}", "@resource cannot be combined with @c_layout"),
        ("cleanup-direct", "@resource(drop) struct R{x:i32} impl R{fn drop(&self){}} fn main(){r:=R{x:1};r.drop()}", "cleanup methods are called automatically"),
        ("cleanup-partial-move", "@resource(drop) struct R{x:[]i32} impl R{fn drop(&self){}} fn main(){r:=R{x:[1]};a:=r.x}", "cannot move out of a resource with automatic cleanup"),
        ("cleanup-temporary-move", "@resource(drop) struct R{x:[]i32} impl R{fn drop(&self){}} fn r()->R{R{x:[1]}} fn main(){a:=r().x}", "cannot move out"),
        ("cleanup-scratch", "@resource(drop) struct R{x:i32} impl R{fn drop(&self){}} fn main(){region arena(256){mut r:[]R=arena.alloc(1);r[0]=R{x:42}}}", "scratch elements must be numeric, bool, rune or plain value records"),
        ("manual-scratch", "@resource struct R{x:i32} fn main(){region arena(256){mut r:[]R=arena.alloc(1);r[0]=R{x:42}}}", "scratch elements must be numeric, bool, rune or plain value records"),
        ("cleanup-task-effect", "@resource(drop) struct R{x:i32} impl R{fn drop(&self){print(self.x)}} fn work(n:i32)->i32{r:=R{x:n};n} fn main(){task scope j(1){id:=j.spawn(work,42);print(id.join())}}", "effects outside"),
    ]
}
