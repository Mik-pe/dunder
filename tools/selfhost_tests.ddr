capability process, filesystem

import std.fs as fs
import std.parse as parse
import std.process as process
import std.text as text
import sys

fn main() -> i32 {
    var suite_arg := ""
    var timeout_ms: i64 = 5000
    count := sys.arg_count()
    var i := 1
    while i < count {
        a := sys.arg(i)
        if a == "--timeout-ms" {
            if i + 1 >= count { _ := sys.eprint("missing value after --timeout-ms"); return 2 }
            i += 1
            parsed := parse.integer(sys.arg(i))
            if !parsed.ok || parsed.value <= 0 { _ := sys.eprint("--timeout-ms must be positive"); return 2 }
            timeout_ms = parsed.value
        } else if suite_arg.len == 0 {
            suite_arg = a
        } else {
            _ := sys.eprint("unexpected argument: " + a)
            return 2
        }
        i += 1
    }
    if suite_arg.len == 0 {
        _ := sys.eprint("usage: selfhost_tests <suite-executable> [--timeout-ms N]")
        return 2
    }
    rp := fs.realpath(suite_arg)
    if !rp.ok {
        _ := sys.eprint("suite executable not found: " + suite_arg)
        return 1
    }
    suite := rp.value

    var list_cmd := process.command(suite, ["--list"])
    process.set_timeout(&mut list_cmd, timeout_ms)
    listing := process.exec(&list_cmd)
    if !process.succeeded(&listing) {
        _ := sys.eprint("failed listing test groups: " + process.stderr_text(&listing))
        return 1
    }

    lines := text.split(text.trim(process.stdout_text(&listing)), "\n")
    var passed := 0
    var failed := 0
    for idx in 0..lines.len {
        line := lines[idx]
        if line.len == 0 { continue }
        sp := text.find(line, " ")
        if sp <= 0 || line[0..sp] != idx.str() || sp + 1 >= line.len {
            _ := sys.eprint("invalid group listing: " + line)
            return 1
        }
        name := line[(sp + 1)..line.len]
        var cmd := process.command(suite, [idx.str()])
        process.set_timeout(&mut cmd, timeout_ms)
        res := process.exec(&cmd)
        if res.timed_out {
            print("FAIL " + name + " (timeout)")
            failed += 1
            continue
        }
        if process.succeeded(&res) {
            print("PASS " + name)
            passed += 1
        } else {
            print("FAIL " + name + " (exit " + res.code.str() + ")")
            out_txt := text.trim(process.stdout_text(&res))
            err_txt := text.trim(process.stderr_text(&res))
            if out_txt.len > 0 { print(out_txt) }
            if err_txt.len > 0 { print(err_txt) }
            failed += 1
        }
    }
    print(passed.str() + " passed, " + failed.str() + " failed")
    if failed > 0 { return 1 }
    0
}
