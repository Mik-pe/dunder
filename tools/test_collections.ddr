capability process, filesystem

import .harness as harness
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn invalid_cases() -> [](string, string) {
    [
        ("fn main() { _ := Map<i32>::new() }", "Map expects a key and a value type"),
        ("fn main() { _ := Map<i32, i32, i32>::new() }", "Map expects a key and a value type"),
        ("fn main() { _ := Set<i32, i64>::new() }", "Set expects one element type"),
        ("fn main() { _ := Map<string, &i32>::new() }", "keys and values must be storable"),
        ("fn main() { _ := Map<string, ()>::new() }", "keys and values must be storable"),
        ("struct Key { id: i32 } fn main() { _ := Set<Key>::new() }", "unknown method 'key_hash'"),
        ("struct Key { id: i32 } impl Key { pub fn key_hash(&self) -> u64 { 0 } } fn main() { _ := Map<Key, i32>::new() }", "unknown method 'key_eq'"),
        ("fn main() { t := Map<i32, bool>::new(); print(t.entries.len) }", "an opaque struct"),
        ("fn main() { mut t := Map<i32, string>::new(); t.put(1, \"old\"); value := t.at(1); t.put(1, \"new\"); print(value) }", "while it is borrowed"),
        ("@resource struct Handle { fd: i32 } fn main() { t := Map<i32, Handle>::new(); _ := t.clone() }", "resource values cannot be cloned"),
        ("@resource struct Handle { fd: i32 } fn main() { mut t := Map<i32, Handle>::new(); h := Handle {fd:1}; t.put(2, h); print(h.fd) }", "move"),
    ]
}

fn verify_output(result: &process.Output, label: string) -> bool {
    actual := process.stdout_text(&result)
    actual == "1\n12\n2\n11\n13\n14\n6\n14\n42\n" || harness.fail(f"{label} collection output: {actual}")
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    source := cli.root + "/tests/fixtures/collections.ddr"
    host := process.host_target()
    mut targets := harness.targets()
    targets.push("wasm32")
    mut result := harness.empty_output()

    for target in targets {
        image := work + "/" + target
        for optimized in [true, false] {
            workers := if optimized && target == host { "4" } else { "1" }
            mut args: []string = ["build", source.clone(), "--target", target.clone(), "--jobs", workers, "-o", image.clone()]
            if !optimized {
                args.push("--mir=off")
                args.push("--scalar-opt=off")
                args.push("--ownership-opt=off")
            }
            if !harness.run_checked(cli.compiler, args, work, 0, false, &mut result) { return false }
            if target == host || target == "wasm32" {
                if !harness.run_target_image(target, image, work, &mut result) || !verify_output(&result, target) { return false }
            }
        }
    }

    cached := work + "/cached.ddr"
    data := sys.read_u8(source)
    if !data.ok || !sys.write_u8(cached, &data.value).ok { return harness.fail(f"cannot copy {source} to {cached}") }
    for _ in 0..2 {
        if !harness.run_checked(cli.compiler, ["run", cached.clone(), "--jobs", "4", "--incremental"], work, 0, false, &mut result) ||
           !verify_output(&result, "incremental") { return false }
    }

    image := work + "/existing"
    cases := invalid_cases()
    for index in 0..cases.len {
        code := cases[index].0 + "\n"
        message := cases[index].1.clone()
        path := f"{work}/invalid-{index}.ddr"
        if !sys.write_text(path, code).ok || !sys.write_text(image, "previous image").ok {
            return harness.fail(f"cannot prepare collection diagnostic {index}")
        }
        if !harness.check_agent_error(cli.compiler, path, message, work) ||
           !harness.run_checked(cli.compiler, ["build", path.clone(), "-o", image.clone()], work, 1, false, &mut result) { return false }
        if text.find(process.stderr_text(&result), message) < 0 {
            return harness.fail(f"missing {message} in {path}: {process.stderr_text(&result)}")
        }
        previous := sys.read_text(image)
        if !previous.ok || previous.value != "previous image" { return harness.fail(f"rejected build changed {image}") }
    }
    print("PASS specialized collections across four targets, native and Wasm cleanup, and diagnostics")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-collections-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
