capability process, filesystem

import .harness as harness
import std.fs as fs
import sys

fn invalid_cases() -> [](string, string) {
    [
        ("fn main() { _ := Map<i32>::new() }", "Map expects a key and a value type"),
        ("fn main() { _ := Map<i32, i32, i32>::new() }", "Map expects a key and a value type"),
        ("fn main() { _ := Set<i32, i64>::new() }", "Set expects one element type"),
        ("fn main() { _ := Map<string, &i32>::new() }", "keys and values must be storable"),
        ("fn main() { _ := Map<string, ()>::new() }", "keys and values must be storable"),
        ("struct Key { id: i32 } impl Key { pub fn key_eq(&self, other: Self) -> bool { true } } fn main() { _ := Set<Key>::new() }", "unknown method 'key_hash'"),
        ("struct Key { id: i32 } impl Key { pub fn key_hash(&self) -> u64 { 0 } } fn main() { _ := Map<Key, i32>::new() }", "unknown method 'key_eq'"),
        ("fn main() { t := Map<i32, bool>::new(); print(t.entries.len) }", "an opaque struct"),
        ("fn main() { mut t := Map<i32, string>::new(); t.put(1, \"old\"); value := t.at(1); t.put(1, \"new\"); print(value) }", "while it is borrowed"),
        ("@resource struct Handle { fd: i32 } fn main() { t := Map<i32, Handle>::new(); _ := t.clone() }", "resource values cannot be cloned"),
        ("@resource struct Handle { fd: i32 } fn main() { mut t := Map<i32, Handle>::new(); h := Handle {fd:1}; t.put(2, h); print(h.fd) }", "move"),
    ]
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    source := cli.root + "/tests/fixtures/collections.ddr"
    output := "1\n12\n2\n11\n13\n14\n6\n14\n42\n"
    cases := invalid_cases()
    if !harness.run_specialization_matrix(cli.compiler, source, work, output) ||
       !harness.check_rejected_specializations(cli.compiler, work, &cases) { return false }
    print("PASS specialized collections across four targets, native and Wasm cleanup, and diagnostics")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-collections-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
