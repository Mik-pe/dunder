capability process, filesystem, stdio

import .harness as harness
import std.array
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

fn escape_ddr_string(s: string) -> string {
    mut out: []u8 = []
    out.reserve(s.len + 8)
    for b in s.bytes() {
        if b == 92 {
            out.push(b'\\')
            out.push(b'\\')
        } else if b == 34 {
            out.push(b'\\')
            out.push(b'"')
        } else {
            out.push(u8(b))
        }
    }
    bytes.decode(&out).unwrap()
}

fn replace_all(s: string, needle: string, replacement: string) -> string {
    parts := text.split(s, needle)
    mut out: []u8 = []
    out.reserve(s.len + 64)
    for i in 0..parts.len {
        if i > 0 {
            bytes.append_utf8(&mut out, replacement)
        }
        bytes.append_utf8(&mut out, parts[i])
    }
    bytes.decode(&out).unwrap()
}

fn invalid_sources() -> []string {
    mut out: []string = []
    unsafe_hdr := "capability unsafe\n"
    external := "@extern(\"c\",\"abs\") unsafe fn external(x:i32)->i32\n"
    decls: []string = [external.clone(), "unsafe fn external(x:i32)->i32{x}\n"]
    for decl in decls {
        out.push(unsafe_hdr + decl + "fn main()->i32{f:=external;f(7)}")
        out.push(unsafe_hdr + decl + "fn main(){f:fn(i32)->i32=external}")
    }
    out.push(external + "fn main(){}")
    out.push("fn main(){unsafe{p:=ptr(0)}}")
    out.push(unsafe_hdr + "fn main(){p:=ptr(0)}")
    out.push(unsafe_hdr + "fn main(){unsafe{p:=ptr(0)};q:=ptr(1)}")
    out.push(unsafe_hdr + "@extern(\"c\",\"f\") fn f()\nfn main(){}")

    fields: []string = ["string", "[]u8", "[u8;0]", "fn(i32)->i32", "Normal"]
    for field in fields {
        out.push("struct Normal{v:i32}\n@c_layout struct Bad{f:" + field + "}\nfn main(){}")
    }

    parameters: []string = ["string", "[]u8", "&i32", "fn(i32)->i32"]
    for parameter in parameters {
        out.push(unsafe_hdr + "@c_layout struct Record{a:i32}\n" +
                 "@extern(\"c\",\"bad\") unsafe fn foreign(x:" + parameter + ")\nfn main(){}")
    }

    out.push(unsafe_hdr + "fn main(){unsafe{p:=cstr(\"zero\\0byte\")}}")
    out.push(unsafe_hdr + "@extern(\"\",\"symbol\") unsafe fn f()\nfn main(){}")
    out.push(unsafe_hdr + "@extern(\"c\",\"\") unsafe fn f()\nfn main(){}")
    out.push("fn main(){small:u8=256}")
    out.push("fn main(){small:u8=-1}")
    out
}

fn variadic_errors() -> [](string, string) {
    external := "@extern(\"c\", \"abs\") unsafe fn foreign(value:i32)->i32\n"
    declaration := "@c_variadic(1) @extern(\"c\",\"f\") unsafe fn foreign(fixed:i32,value:"
    empty_main := "fn main(){}\n"
    mut cases: [](string, string) = [
        ("@c_variadic(-1) " + external + empty_main, "nonnegative fixed parameter count"),
        ("@c_variadic(2) " + external + empty_main, "invalid C variadic fixed parameter count"),
        ("@c_variadic(999999) " + external + empty_main, "invalid C variadic fixed parameter count"),
        ("@c_variadic(\"one\") " + external + empty_main, "nonnegative fixed parameter count"),
        ("@c_variadic() " + external + empty_main, "nonnegative fixed parameter count"),
        ("@c_variadic(1) @c_variadic(1) " + external + empty_main, "duplicate @c_variadic"),
        ("@c_variadic(1) unsafe fn foreign(value:i32)->i32{value}\n" + empty_main, "@c_variadic requires an @extern"),
    ]
    for parameter in ["f32", "u8", "u16", "i16"] {
        cases.push((declaration + parameter + ")\n" + empty_main, "require promoted scalar types"))
    }
    cases.push(("@c_layout struct Pair{a:f64,b:f64}\n" + declaration + "Pair)\n" + empty_main, "require promoted scalar types"))
    for body in ["f:extern fn(i32)->i32=foreign", "first:=foreign;f:extern fn(i32)->i32=first"] {
        cases.push(("@c_variadic(1) " + external + "fn main(){unsafe{" + body + "}}\n", "type mismatch"))
    }
    cases.push(("@c_variadic(1) @extern(\"c\",\"f\") unsafe fn first(a:i32,b:i32)->i32\n" +
                "@c_variadic(2) @extern(\"c\",\"f\") unsafe fn second(a:i32,b:i32)->i32\n" +
                "fn main(){unsafe{mut call:=first;call=second}}\n", "type mismatch"))
    cases
}

fn check_variadic_errors(cli: &harness.BaseCli, directory: string, source: string, rejected: &mut i32) -> bool {
    cases := variadic_errors()
    mut result := harness.empty_output()
    for i in 0..cases.len {
        if !sys.write_text(source, "capability unsafe\n" + cases[i].0).ok {
            return harness.fail(f"cannot write variadic case {i}")
        }
        if !harness.run_checked(cli.compiler, ["check", source.clone()], directory, 1, true, &mut result) { return false }
        if !text.contains(result.stderr_text(), cases[i].1) {
            return harness.fail(f"variadic case {i}: expected {cases[i].1}, got {result.stderr_text()}")
        }
        rejected += 1
    }
    unsupported := "capability unsafe\n@c_variadic(1) @extern(\"c\", \"abs\") unsafe fn foreign(value:i32)->i32\nfn main(){}\n"
    if !sys.write_text(source, unsupported).ok { return harness.fail("cannot write Wasm variadic case") }
    if !harness.run_checked(cli.compiler, ["check", source.clone(), "--target", "wasm32"], directory, 1, true, &mut result) { return false }
    if !text.contains(result.stderr_text(), "require a native target") {
        return harness.fail(f"expected a native-target diagnostic: {result.stderr_text()}")
    }
    rejected += 1
    true
}

fn run_all(cli: &harness.BaseCli, directory: string, out_rejected: &mut i32) -> bool {
    fixtures := cli.root + "/tests/fixtures/ffi"
    mac := process.host_os() == "macos"
    mut library := directory + "/probe.so"
    mut shared_flag := "-shared"
    if mac {
        library = directory + "/probe.dylib"
        shared_flag = "-dynamiclib"
    }

    mut res := harness.empty_output()
    if !harness.run_checked(cli.cc, ["-std=c11", "-Werror", "-pthread", "-fPIC", shared_flag.clone(), fixtures + "/oracle.c", "-o", library.clone()], directory, 0, false, &mut res) {
        return false
    }

    source := directory + "/input.ddr"
    executable := directory + "/program"
    tmpl := sys.read_text(fixtures + "/native.ddr.in")
    if !tmpl.ok {
        return harness.fail("could not read native.ddr.in")
    }
    libname := escape_ddr_string(library)
    if !sys.write_text(source, replace_all(tmpl.value, "@LIB@", libname)).ok {
        return harness.fail("write_text failed on " + source)
    }

    if !harness.run_checked(cli.compiler, ["build", source.clone(), "--runtime-profile", "-o", executable.clone()], directory, 0, true, &mut res) {
        return false
    }
    clean := sys.read_u8(executable)
    if !clean.ok { return harness.fail("cannot read clean callback image") }
    for pass in 0..2 {
        if !harness.run_checked(cli.compiler, ["build", source.clone(), "--incremental", "--timings=json",
            "--runtime-profile", "-o", executable.clone()], directory, 0, true, &mut res) { return false }
        timing := json.Doc::parse_text(res.stderr_text())
        reused := timing.get_i64(timing.field(timing.root, "functions"), "reused").unwrap_or(-1)
        image := sys.read_u8(executable)
        if !image.ok || !bytes.equal(&clean.value, &image.value) || (pass == 0 && reused != 0) || (pass == 1 && reused <= 0) {
            return harness.fail("incremental callback build failed reuse or changed the executable")
        }
    }
    if !harness.run_checked(executable, [], directory, 0, true, &mut res) {
        return false
    }
    if res.stdout_text() != "native ABI ok\n" {
        return harness.fail("native ABI probe did not finish: " + res.stdout_text())
    }
    report := json.Doc::parse_text(res.stderr_text())
    fresh := report.get_i64(report.field(report.root, "counters"), "fresh_allocations")
    if fresh.is_none() || fresh.unwrap_or(99) >= 64 {
        return harness.fail("foreign aggregate results were not reclaimed: " + res.stderr_text())
    }

    variadic_library := directory + "/variadic" + if mac { ".dylib" } else { ".so" }
    if !harness.run_checked(cli.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", "-fPIC", shared_flag,
        fixtures + "/variadic-oracle.c", "-o", variadic_library.clone()], directory, 0, false, &mut res) {
        return false
    }
    variadic_template := sys.read_text(fixtures + "/variadic.ddr.in")
    if !variadic_template.ok { return harness.fail("could not read variadic.ddr.in") }
    if !sys.write_text(source, replace_all(variadic_template.value, "@LIB@", escape_ddr_string(variadic_library))).ok {
        return harness.fail("write_text failed on variadic probe")
    }
    for mode in 0..2 {
        mut args: []string = ["build", source.clone(), "-o", executable.clone()]
        if mode == 1 { args.push("--scalar-opt=off"); args.push("--ownership-opt=off"); args.push("--mir=off") }
        if !harness.run_checked(cli.compiler, args, directory, 0, true, &mut res) { return false }
        if !harness.run_checked(executable, [], directory, 0, true, &mut res) { return false }
        if res.stdout_text() != "variadic ABI ok\n" || res.stderr.len > 0 {
            return harness.fail(f"unexpected variadic ABI output: {res.stdout_text()}\n{res.stderr_text()}")
        }
    }
    if !check_variadic_errors(&cli, directory, source, &mut out_rejected) { return false }

    worker_src := "capability unsafe\n" +
                  "@extern(\"" + libname + "\", \"on_worker\") unsafe fn on_worker(f:extern fn())\n" +
                  "fn noop() {}\n" +
                  "fn main() { unsafe { on_worker(callback(noop)) } }\n"
    if !sys.write_text(source, worker_src).ok {
        return harness.fail("write_text failed on worker probe")
    }
    if !harness.run_checked(cli.compiler, ["build", source.clone(), "-o", executable.clone()], directory, 0, true, &mut res) {
        return false
    }
    if !harness.run_checked(executable, [], directory, 0, true, &mut res) {
        return false
    }

    mut types: []string = []
    mut arguments: []string = []
    for i in 0..520 {
        types.push(f"a{i}:i64")
        arguments.push("0")
    }
    frame := "capability unsafe\n@extern(\"c\",\"frame\") unsafe fn frame(" + array.join(&types, ",") +
             ")\nfn main(){unsafe{frame(" + array.join(&arguments, ",") + ")}}"
    if !sys.write_text(source, frame).ok { return harness.fail("cannot write C argument frame probe") }
    if !harness.run_checked(cli.compiler, ["check", source.clone(), "--target", "arm64-macos"], directory, 0, true, &mut res) {
        return harness.fail("large C argument frame should succeed: " + res.stderr_text())
    }

    rejected := invalid_sources()
    for index in 0..rejected.len {
        if !sys.write_text(source, rejected[index]).ok {
            return harness.fail("write_text failed on invalid case #" + index.str())
        }
        if !harness.run_checked(cli.compiler, ["check", source.clone()], directory, 1, true, &mut res) {
            return false
        }
        if !text.contains(res.stderr_text(), "error[") {
            return harness.fail("missing source diagnostic #" + index.str() + ": " + res.stderr_text())
        }
    }

    if !sys.write_text(source, "fn main(){limit:u64=18446744073709551615;wide:usize=4294967296}").ok {
        return harness.fail("write_text failed on usize probe")
    }
    if !harness.run_checked(cli.compiler, ["check", source.clone()], directory, 0, true, &mut res) {
        return false
    }

    non_hfa_src := "capability unsafe\n@c_layout struct Record{a:i32}\n" +
        "@extern(\"c\",\"foreign\") unsafe fn foreign(x:Record)\nfn main(){}"
    if !sys.write_text(source, non_hfa_src).ok { return harness.fail("cannot write non-HFA probe") }
    for tgt in ["wasm32"] {
        if !harness.run_checked(cli.compiler, ["check", source.clone(), "--target", tgt.clone()], directory, 1, true, &mut res) {
            return false
        }
        if !text.contains(res.stderr_text(), "error[") {
            return harness.fail("missing non-HFA rejection on " + tgt + ": " + res.stderr_text())
        }
        out_rejected += 1
    }
    for tgt in ["arm64-macos", "arm64-linux", "x86_64-linux", "x86_64-windows"] {
        if !harness.run_checked(cli.compiler, ["check", source.clone(), "--target", tgt.clone()], directory, 0, true, &mut res) {
            return false
        }
    }

    gated_non_hfa_src := "capability unsafe\n@c_layout struct Record{a:i32}\n" +
        "@extern(\"arm64\", \"c\", \"foreign\") unsafe fn foreign(x:Record)\n" +
        "fn main(){ if target_is(\"arm64\") { unsafe { foreign(Record{a:1}) } } }"
    if !sys.write_text(source, gated_non_hfa_src).ok { return harness.fail("cannot write gated non-HFA probe") }
    for tgt in ["x86_64-linux", "wasm32"] {
        if !harness.run_checked(cli.compiler, ["check", source.clone(), "--target", tgt.clone()], directory, 0, true, &mut res) {
            return false
        }
    }

    live_ffi_fn_src := "capability unsafe\n@c_layout struct Record{a:i32}\n" +
        "fn main(){ unsafe { f: extern fn(Record) = ffi_fn(ptr(0)); f(Record{a:1}) } }"
    if !sys.write_text(source, live_ffi_fn_src).ok { return harness.fail("cannot write live ffi_fn non-HFA probe") }
    if !harness.run_checked(cli.compiler, ["check", source.clone(), "--target", "x86_64-linux"], directory, 0, true, &mut res) {
        return false
    }

    out_rejected += rejected.len
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-ffi-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    mut count := 0
    ok := run_all(&cli, tmp.value, &mut count)
    _ := fs.remove_all(tmp.value)
    if !ok { return false }
    print("native layout, mixed/variadic C args, HFA, reentrant and foreign-thread callbacks passed; " + count.str() + " invalid programs rejected")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
