capability process, filesystem

import .harness as harness
import std.bytes as bytes
import std.json as json
import std.text as text
import sys

pub struct Diagnostic {
    ok: bool,
    start: i64,
    end: i64,
    message: string,
}

fn contains_case_insensitive(got: string, expected: string) -> bool {
    if expected.len == 0 { return true }
    mut data: []u8 = []
    bytes.append_utf8(&mut data, got)
    for i in 0..(data.len - expected.len + 1) {
        if bytes.equals_ascii_ci(&data, i, i + expected.len, expected) { return true }
    }
    false
}

pub fn inspect(report: string, source: string, expected: string, ignore_case: bool) -> Diagnostic {
    records := harness.lines(report)
    file := sys.metadata(source)
    mut result := Diagnostic { ok: false, start: -1, end: -1, message: "" }
    if records.len == 0 || !file.ok {
        _ := harness.fail(f"invalid source diagnostic for {source}\n{report}")
        return result
    }
    for idx in 0..records.len {
        doc := json.Doc::parse_text(records[idx])
        kind := doc.get_str(doc.root, "kind")
        if !doc.ok || doc.kind(doc.root) != .Object || !kind.ok || (idx == records.len - 1 && kind.value != "failed") {
            _ := harness.fail(f"invalid source diagnostic for {source}\n{report}")
            return Diagnostic { ok: false, start: -1, end: -1, message: "" }
        }
        if kind.value == "error" && !result.ok {
            code := doc.get_str(doc.root, "code")
            start := doc.get_i64(doc.root, "start")
            end := doc.get_i64(doc.root, "end")
            detail := doc.get_str(doc.root, "message")
            matches := if !detail.ok { false } else if ignore_case { contains_case_insensitive(detail.value, expected) } else { text.contains(detail.value, expected) }
            if code.ok && code.value != "E1000" && doc.get_str(doc.root, "path").value == source &&
               start.ok && end.ok && start.value >= 0 && end.value >= start.value && end.value <= file.size && matches {
                result = Diagnostic { ok: true, start: start.value, end: end.value, message: detail.value }
            }
        }
    }
    if !result.ok { _ := harness.fail(f"invalid source diagnostic for {source}\n{report}") }
    result
}

pub fn preserves_output(compiler: string, work: string, source: string, flags: &[]string, message: string) -> bool {
    image := work + "/previous-image"
    if !sys.write_text(image, "previous image").ok { return harness.fail(f"cannot prepare {image}") }
    mut args: []string = ["build", source.clone()]
    for flag in flags { args.push(flag.clone()) }
    args.push("-o")
    args.push(image.clone())
    mut output := harness.empty_output()
    if !harness.run_checked(compiler, args, work, 1, false, &mut output) { return false }
    saved := sys.read_text(image)
    (text.contains(output.stderr_text(), message) && saved.ok && saved.value == "previous image") ||
        harness.fail(f"{source}: rejection changed diagnostic or existing output\n{output.stderr_text()}")
}
