capability process, filesystem, stdio

import .harness as harness
import .native_probe as native
import .probe_cli as cli
import .test_evidence as evidence
import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import std.text as text
import sys

struct Probe {
    name: string,
    source: string,
    status: i32,
}

struct Image {
    name: string,
    target: string,
    mode: string,
    digest: string,
}

struct Result {
    checks: i32,
    static_elf: i32,
    native_runs: i32,
    wasm_runs: i32,
    rejections: i32,
    images: []Image,
}

fn wasm_code() -> string {
    "const fs = require('node:fs');\n" +
    "const module_ = new WebAssembly.Module(fs.readFileSync(process.argv[2]));\n" +
    "if (WebAssembly.Module.imports(module_).length !== 0) {\n" +
    "    throw new Error('memory-only image acquired host imports');\n" +
    "}\n" +
    "const entry = new WebAssembly.Instance(module_, {}).exports.main;\n" +
    "const expectTrap = process.argv[3] === 'trap';\n" +
    "try {\n" +
    "    const status = entry();\n" +
    "    if (expectTrap) throw new Error('invalid range returned normally: ' + status);\n" +
    "    if (status !== 0) throw new Error('program returned ' + status);\n" +
    "} catch (error) {\n" +
    "    if (!(expectTrap && error instanceof WebAssembly.RuntimeError)) throw error;\n" +
    "}\n"
}

fn valid_sources(fixtures: string, work: string) -> []Probe {
    mut probes: []Probe = []
    for name in ["memory", "append"] {
        path := work + "/" + name + ".ddr"
        data := sys.read_u8(fixtures + "/" + name + ".ddr")
        if !data.ok || !sys.write_u8(path, &data.value).ok { return [] }
        probes.push(Probe { name: name.clone(), source: path, status: 0 })
    }
    template := sys.read_text(fixtures + "/range.ddr.in")
    if !template.ok { return [] }
    marker := text.find(template.value, "@CALL@").unwrap_or(-1)
    if marker < 0 { return [] }
    head := template.value[0..marker]
    tail := template.value[(marker + 6)..template.value.len]
    ranges: [](string, string, i32) = [
        ("negative-start", "sys.bytes_extend(&mut output, &source, -1, 0)", 103),
        ("negative-end", "sys.bytes_extend(&mut output, &source, 0, -1)", 103),
        ("reversed", "sys.bytes_extend(&mut output, &source, 3, 2)", 103),
        ("past-end", "sys.bytes_extend(&mut output, &source, 0, 5)", 103),
        ("empty-past-end", "sys.bytes_extend(&mut output, &source, 5, 5)", 103),
        ("extreme-range", "sys.bytes_extend(&mut output, &source, -2147483648, 2147483647)", 103),
        ("checked-range", "bytes.extend_range(&mut output, &source, -1, 4)", 104),
    ]
    for i in 0..ranges.len {
        path := work + "/" + ranges[i].0 + ".ddr"
        if !sys.write_text(path, head + ranges[i].1 + tail).ok { return [] }
        probes.push(Probe { name: ranges[i].0.clone(), source: path, status: ranges[i].2 })
    }
    probes
}

fn dunder_source(body: string, imports: string, unsafe_block: bool) -> string {
    prefix := "capability unsafe\n" + imports + "\nfn main(){\n"
    (if unsafe_block { prefix + "unsafe{" + body + "}" } else { prefix + body }) + "\n}\n"
}

fn diagnostic_cases() -> [](string, string, string) {
    mut cases: [](string, string, string) = []
    sys_import := "import std.sys as sys"
    operations: [](string, string, string) = [
        ("few", "ptr(0), ptr(0)", "wrong argument count"),
        ("many", "ptr(0), ptr(0), usize(0), ptr(0)", "too many arguments"),
        ("lhs-type", "i64(0), ptr(0), usize(0)", "type mismatch: expected ptr, got i64"),
        ("rhs-type", "ptr(0), usize(0), usize(0)", "type mismatch: expected ptr, got usize"),
        ("count-type", "ptr(0), ptr(0), u64(0)", "type mismatch: expected usize, got u64"),
    ]
    args := "(ptr(0), ptr(0), usize(0))"
    for operation in ["copy", "equal"] {
        function := "sys.memory_" + operation
        for i in 0..operations.len {
            program := dunder_source(function + "(" + operations[i].1 + ")", sys_import, true)
            cases.push((operation + "-" + operations[i].0, program.clone(), operations[i].2.clone()))
        }
        cases.push((operation + "-unsafe", dunder_source(function + args, sys_import, false), "requires unsafe"))
        cases.push(("bytes-" + operation + "-unsafe",
                    dunder_source("bytes." + operation + "_memory" + args, "import std.bytes as bytes", false), "requires unsafe"))
    }
    prefix := "mut output: []u8 = [0]; input: []u8 = [1]; "
    strings: [](string, string, string) = [
        ("extend-few", "sys.bytes_extend(&mut output, &input, 0)", "wrong argument count"),
        ("extend-many", "sys.bytes_extend(&mut output, &input, 0, 1, 1)", "too many arguments"),
        ("extend-output", "mut wrong: []i32 = [0]; sys.bytes_extend(&mut wrong, &input, 0, 1)", "type mismatch"),
        ("extend-input", "wrong: []i32 = [0]; sys.bytes_extend(&mut output, &wrong, 0, 1)", "type mismatch"),
        ("extend-mutable", "sys.bytes_extend(&output, &input, 0, 1)", "mutable parameter"),
        ("extend-start", "sys.bytes_extend(&mut output, &input, i64(0), 1)", "type mismatch: expected i32, got i64"),
        ("extend-end", "sys.bytes_extend(&mut output, &input, 0, usize(1))", "type mismatch: expected i32, got usize"),
        ("append-few", "sys.bytes_append_text(&mut output)", "wrong argument count"),
        ("append-many", "sys.bytes_append_text(&mut output, \"\", 0)", "too many arguments"),
        ("append-output", "mut wrong: []i32 = [0]; sys.bytes_append_text(&mut wrong, \"\")", "type mismatch"),
        ("append-text", "sys.bytes_append_text(&mut output, &input)", "type mismatch"),
        ("append-mutable", "sys.bytes_append_text(&output, \"\")", "mutable parameter"),
    ]
    for i in 0..strings.len {
        cases.push((strings[i].0.clone(), dunder_source(prefix + strings[i].1, sys_import, false), strings[i].2.clone()))
    }
    reserved: [](string, string) = [
        ("memory-copy", "__sys_memory_copy" + args), ("memory-equal", "__sys_memory_equal" + args),
        ("bytes-extend", prefix + "__sys_bytes_extend(&mut output, &input, 0, 1)"),
        ("bytes-append", prefix + "__sys_bytes_append_text(&mut output, \"\")"),
        ("copy-valid-utf8", prefix + "__sys_copy_valid_utf8(&input)"),
    ]
    for i in 0..reserved.len {
        cases.push(("reserved-" + reserved[i].0, dunder_source(reserved[i].1, "", true), "reserved compiler identifier"))
    }
    cases
}

fn contains_ascii_ci(output: string, expected: string) -> bool {
    mut data: []u8 = []
    bytes.append_utf8(&mut data, output)
    for i in 0..(data.len - expected.len + 1) {
        if bytes.equals_ascii_ci(&data, i, i + expected.len, expected) { return true }
    }
    false
}

fn mode_options(target: string, mode: string) -> []string {
    mut flags: []string = ["--target", target.clone()]
    if mode == "mir" { flags.push("--mir=on") }
    else {
        for flag in move native.direct_flags() { flags.push(move flag) }
        flags.push("--inline-opt=off")
    }
    flags
}

struct Suite {
    compiler: string,
    work: string,
    node: string,
    wasm_runner: string,
    runners: native.Runners,
}

fn check_program(suite: &Suite, probe: &Probe, targets: &[]string, full_matrix: bool, counts: &mut Result) -> bool {
    mut result := harness.empty_output()
    host := process.host_target()
    for target in targets {
        if !full_matrix && target != host && target != "wasm32" { continue }
        modes: []string = if full_matrix && (target == host || target == "wasm32") { ["mir", "direct"] } else { ["mir"] }
        for mode in modes {
            image := f"{suite.work}/{probe.name}-{target}-{mode}"
            options := mode_options(target, mode)
            mut build: []string = ["build", probe.source.clone(), "--jobs", "1", "-o", image.clone()]
            if full_matrix {
                mut check: []string = ["check", probe.source.clone(), "--agent"]
                for flag in options { check.push(flag.clone()) }
                if !harness.run_checked(suite.compiler, check, suite.work, 0, false, &mut result) ||
                   !harness.agent_ok(&result) { return false }
                counts.checks += 1
            }
            for flag in options { build.push(flag.clone()) }
            if !harness.run_checked(suite.compiler, build, suite.work, 0, false, &mut result) { return false }
            data := sys.read_u8(image)
            if !data.ok || !native.image_header(&data.value, target) { return harness.fail(f"{image}: invalid {target} image header") }
            if text.ends_with(target, "-linux") {
                if !native.static_elf(&data.value) { return harness.fail(f"{image}: memory-only ELF acquired dynamic dependencies") }
                counts.static_elf += 1
            }
            counts.images.push(Image { name: probe.name.clone(), target: target.clone(), mode: mode.clone(), digest: harness.sha256_bytes_hex(&data.value) })
            if target == "wasm32" {
                action := if probe.status != 0 { "trap" } else { "ok" }
                if !harness.run_checked(suite.node, [suite.wasm_runner.clone(), image.clone(), action], suite.work, 0, false, &mut result) { return false }
                if result.stdout.len != 0 || result.stderr.len != 0 { return harness.fail(f"{image}: unexpected Wasm output") }
                counts.wasm_runs += 1
            } else if suite.runners.can_run(target) {
                if !suite.runners.run(target, image, [], suite.work, probe.status, &mut result) { return false }
                if probe.status == 0 && (result.stdout.len != 0 || result.stderr.len != 0) { return harness.fail(f"{image}: unexpected native output") }
                counts.native_runs += 1
            }
        }
    }
    true
}

fn check_diagnostics(suite: &Suite, counts: &mut Result) -> bool {
    cases := diagnostic_cases()
    mut result := harness.empty_output()
    image := suite.work + "/rejected-image"
    host := process.host_target()
    pairs: [](string, string) = [(host.clone(), "mir"), (host.clone(), "direct"), ("wasm32", "mir")]
    for i in 0..cases.len {
        source := f"{suite.work}/reject-{cases[i].0}.ddr"
        expected := cases[i].2.clone()
        if !sys.write_text(source, cases[i].1).ok { return harness.fail(f"cannot write {source}") }
        limit := if i < 2 { pairs.len } else { 1 }
        for p in 0..limit {
            target := pairs[p].0.clone()
            mode := pairs[p].1.clone()
            options := mode_options(target, mode)
            mut check: []string = ["check", source.clone(), "--agent"]
            for flag in options { check.push(flag.clone()) }
            if !harness.run_checked(suite.compiler, check, suite.work, 1, false, &mut result) { return false }
            reports := harness.lines(result.stdout_text())
            if reports.len < 2 { return harness.fail(f"{source}: missing agent diagnostic") }
            mut matched := false
            for ri in 0..reports.len {
                doc := json.Doc::parse_text(reports[ri])
                kind_f := doc.get_str(doc.root, "kind")
                if !doc.ok || doc.kind(doc.root) != .Object || kind_f.is_none() {
                    return harness.fail(f"{source} {target} {mode}: invalid agent JSON: {reports[ri]}")
                }
                kind_s := kind_f.unwrap()
                if ri == reports.len - 1 && kind_s != "failed" {
                    return harness.fail(f"{source} {target} {mode}: missing failed record: {result.stdout_text()}")
                }
                if kind_s == "error" && !matched {
                    code_f := doc.get_str(doc.root, "code")
                    message := doc.get_str(doc.root, "message")
                    if code_f.is_none() || code_f.unwrap() == "E1000" || message.is_none() {
                        return harness.fail(f"{source} {target} {mode}: invalid error record: {reports[ri]}")
                    }
                    if contains_ascii_ci(message.unwrap(), expected) { matched = true }
                }
            }
            if !matched {
                return harness.fail(f"{source} {target} {mode}: expected {expected}: {result.stdout_text()}")
            }
            if i < 3 {
                mut build: []string = ["build", source.clone(), "--jobs", "1", "-o", image.clone()]
                for flag in options { build.push(flag.clone()) }
                if !sys.write_text(image, "previous image").ok || !harness.run_checked(suite.compiler, build, suite.work, 1, false, &mut result) { return false }
                previous := sys.read_text(image)
                if !previous.ok || previous.value != "previous image" || !contains_ascii_ci(result.stderr_text(), expected) {
                    return harness.fail(f"{source}: failed build altered output or diagnostic:\n{result.stderr_text()}")
                }
            }
            counts.rejections += 1
        }
    }
    true
}

fn fixture_hashes(fixtures: string) -> [](string, string) {
    listing := fs.list_dir(fixtures)
    assert(listing.is_ok())
    mut names := listing.unwrap()
    array.sort<string>(&mut names)
    mut hashes: [](string, string) = []
    for name in names {
        source := fixtures + "/" + name
        if sys.metadata(source).is_file { hashes.push((name.clone(), harness.sha256_file_hex(source))) }
    }
    hashes
}

fn write_receipt(path: string, suite: &Suite, sources: &[](string, string), counts: &Result) -> bool {
    directory := harness.parent_dir(path)
    if directory.len > 0 && !fs.mkdir_all(directory).ok { return harness.fail(f"cannot create {directory}") }
    mut writer := json.Writer::new()
    writer.object()
    writer.key("schema")
    writer.string("dunder-memory-bytes-verification/v1")
    writer.key("passed")
    writer.boolean(true)
    writer.key("host_target")
    writer.string(process.host_target())
    writer.key("native_execution_targets")
    writer.array()
    for target in ["arm64-linux", "arm64-macos", "x86_64-linux"] {
        if suite.runners.can_run(target) { writer.string(target) }
    }
    writer.end()
    writer.key("compiler_sha256")
    writer.string(harness.sha256_file_hex(suite.compiler))
    writer.key("sources")
    writer.object()
    for i in 0..sources.len {
        writer.key(sources[i].0)
        writer.string(sources[i].1)
    }
    writer.end()
    writer.key("checks")
    writer.integer(i64(counts.checks))
    writer.key("images")
    writer.integer(i64(counts.images.len))
    writer.key("native_executions")
    writer.integer(i64(counts.native_runs))
    writer.key("wasm_executions")
    writer.integer(i64(counts.wasm_runs))
    writer.key("static_elf_images")
    writer.integer(i64(counts.static_elf))
    writer.key("diagnostic_contracts")
    writer.integer(i64(counts.rejections))
    writer.key("image_hashes")
    writer.array()
    for image in counts.images {
        writer.object()
        writer.key("fixture")
        writer.string(image.name)
        writer.key("target")
        writer.string(image.target)
        writer.key("mode")
        writer.string(image.mode)
        writer.key("sha256")
        writer.string(image.digest)
        writer.end()
    }
    writer.end()
    writer.end()
    evidence.save(path, &writer)
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--runner"), cli.option("--node"), cli.option("--receipt")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_memory_bytes <compiler> [--runner TARGET=COMMAND] [--node PATH] [--receipt PATH]")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    node := native.find_executable(args.last("--node", "node"))
    if node.len == 0 { _ := sys.eprint("Node is required to execute the Wasm memory contracts"); return 2 }
    specs := args.all("--runner")
    runners := native.Runners::new(&specs)
    if runners.error.len != 0 { _ := sys.eprint(runners.error); return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("could not locate Dunder repository root"); return 1 }
    fixtures := root + "/tests/fixtures/memory_bytes"
    receipt := args.last("--receipt", "")
    sources := if receipt.len > 0 { fixture_hashes(fixtures) } else { [] }
    tmp := fs.temp_dir("dunder-memory-bytes-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    defer { _ := fs.remove_all(tmp.value) }
    work := fs.realpath(tmp.value)
    if !work.ok { return 1 }
    runner := work.value + "/run-wasm.cjs"
    if !sys.write_text(runner, wasm_code()).ok { return 1 }
    probes := valid_sources(fixtures, work.value)
    if probes.len == 0 { _ := harness.fail("cannot prepare memory byte probes"); return 1 }
    suite := Suite { compiler: compiler, work: work.value, node: node, wasm_runner: runner, runners: runners }
    mut counts := Result { checks: 0, static_elf: 0, native_runs: 0, wasm_runs: 0, rejections: 0, images: [] }
    mut targets := harness.targets()
    targets.push("wasm32")
    for i in 0..probes.len {
        if !check_program(&suite, &probes[i], &targets, i < 3, &mut counts) { return 1 }
    }
    if !check_diagnostics(&suite, &mut counts) { return 1 }
    if receipt.len > 0 && !write_receipt(receipt, &suite, &sources, &counts) { return 1 }
    print(f"Memory bytes: {counts.checks} checks, {counts.images.len} images ({counts.static_elf} static ELF), {counts.native_runs} native executions ({suite.runners.targets()}), {counts.wasm_runs} Wasm executions, {counts.rejections} check/build diagnostic contracts passed")
    0
}
