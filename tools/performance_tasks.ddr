capability process, filesystem

import .benchmark_time as time
import .harness as harness
import .native_probe as native
import .probe_cli as cli
import .task_throughput_cases as tasks
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.parse as parse
import std.process as process
import std.text as text
import sys

enum Mode { Check, Calibrate, Measure }

struct Options {
    mode: Mode,
    label: string,
    compiler: string,
    serial: string,
    manifest: string,
    report: string,
    cases: []string,
    flags: []string,
    rounds: i32,
    target: f64,
}

struct Hash {
    path: string,
    sha256: string,
}

struct Host {
    names: []string,
    values: []string,
    revision: string,
    working_tree: string,
    hardware: string,
}

struct Command {
    args: []string,
    timed: bool,
    stdout: string,
}

struct Runner {
    work: string,
    error: string,
    commands: []Command,
}

impl Runner {
    fn fail(&mut self, error: string) -> bool {
        if self.error.len == 0 { self.error = error.clone() }
        harness.fail(error)
    }

    fn run(&mut self, program: string, args: []string, timed: bool, stdout: &mut string, nanos: &mut i64) -> bool {
        mut command := process.Command::new(program.clone(), args.clone())
        command.set_cwd(self.work.clone())
        command.clear_env()
        command.set_env("PATH", "/no-external-tools")
        command.set_timeout(180000)
        started := if timed { time.now_ns() } else { 0 }
        if started < 0 { return self.fail("monotonic clock unavailable") }
        output := command.exec()
        finished := if timed { time.now_ns() } else { 0 }
        if !output.succeeded() || output.stderr.len > 0 {
            return self.fail(f"{program} exited {output.code} (signal {output.signal}, timed out {output.timed_out})\n{output.stdout_text()}\n{output.stderr_text()}")
        }
        if timed && finished <= started { return self.fail("monotonic clock did not advance during the sample") }
        decoded := output.stdout_utf8()
        if !decoded.ok { return self.fail(f"{program} produced invalid UTF-8") }
        mut argv: []string = [program.clone()]
        for arg in args { argv.push(arg.clone()) }
        self.commands.push(Command { args: argv, timed: timed, stdout: decoded.value.clone() })
        stdout = decoded.value
        nanos = finished - started
        true
    }

    fn build(&mut self, compiler: string, source: string, path: string, flags: []string) -> bool {
        mut args: []string = ["build", source.clone(), "-o", path.clone()]
        for flag in flags { args.push(flag.clone()) }
        mut out := ""
        mut elapsed: i64 = 0
        self.run(compiler, args, false, &mut out, &mut elapsed)
    }

    fn validate(&mut self, image: string, inputs: []string, expected: string, timed: bool, nanos: &mut i64) -> bool {
        mut actual := ""
        if !self.run(image, inputs, timed, &mut actual, &mut nanos) { return false }
        if actual == expected { return true }
        self.fail(f"{image}: independent result mismatch\nexpected:\n{expected}observed:\n{actual}")
    }
}

struct Workload {
    name: string,
    cpu: bool,
    size: tasks.Work,
    maximum: i32,
    image: string,
    sha256: string,
    bytes: i64,
    checked: bool,
    expected: string,
}

struct Row {
    name: string,
    round: i32,
    position: i32,
    capacity: i32,
    nanos: i64,
    image_sha256: string,
}

struct Summary {
    name: string,
    capacity: i32,
    samples: i32,
    median: f64,
    p95: f64,
    speedup: f64,
}

struct Sizing {
    name: string,
    count: i32,
    minimum_ms: f64,
    elapsed_ms: f64,
    target_ms: f64,
    proposed: i32,
}

struct Results {
    work: []Workload,
    rows: []Row,
    summaries: []Summary,
    sizing: []Sizing,
}

fn workload_args(cpu: bool, size: &tasks.Work, capacity: i32) -> []string {
    mut inputs: []string = []
    if capacity > 0 { inputs.push(capacity.str()) }
    inputs.push(size.count.str())
    if !cpu { inputs.push(size.length.str()) }
    inputs
}

fn check(runner: &mut Runner, case: &Workload, serial: string, cohort: string) -> bool {
    direct := runner.work + "/" + case.name + "-serial"
    if serial.len > 0 {
        source := direct + ".ddr"
        content := tasks.serial_source(cohort, runner.work, case.name, case.cpu)
        if !sys.write_text(source, content).ok { return runner.fail(f"cannot write {source}") }
        if !runner.build(serial, source, direct, []) { return false }
    }
    mut elapsed: i64 = 0
    for sample in tasks.small_cases(case.cpu) {
        expected := tasks.expected(case.cpu, &sample)
        for capacity in tasks.capacities() {
            if !runner.validate(case.image, workload_args(case.cpu, &sample, capacity), expected, false, &mut elapsed) { return false }
        }
        if serial.len > 0 && !runner.validate(direct, workload_args(case.cpu, &sample, 0), expected, false, &mut elapsed) {
            return false
        }
    }
    print(f"PASS {case.name} independent results at capacity1/2/4; empty/snapshot cases")
    true
}

fn calibrate(runner: &mut Runner, case: &Workload, target: f64, sizing: &mut []Sizing) -> bool {
    minimal := tasks.Work { count: 0, length: case.size.length }
    expected := tasks.expected(case.cpu, &minimal)
    mut low: i64 = 0
    mut high: i64 = 0
    if !runner.validate(case.image, workload_args(case.cpu, &minimal, 1), expected, true, &mut low) ||
       !runner.validate(case.image, workload_args(case.cpu, &case.size, 1), case.expected, true, &mut high) { return false }
    minimum := time.milliseconds(low)
    elapsed := time.milliseconds(high)
    if minimum >= target * 0.1 {
        return runner.fail("minimum-work cost exceeds 10% of sizing target; choose a larger target before freezing")
    }
    if high <= low { return runner.fail("sizing observation does not separate work from minimum-work cost") }
    remaining := target - minimum
    work := elapsed - minimum
    scaled := f64(case.size.count) * (if remaining > 1.0 { remaining } else { 1.0 }) / work
    mut proposed := case.maximum
    if scaled < f64(case.maximum) {
        whole := i32(scaled)
        proposed = if f64(whole) < scaled { whole + 1 } else { whole }
        if proposed < 1 { proposed = 1 }
    }
    sizing.push(Sizing {
        name: case.name.clone(), count: case.size.count, minimum_ms: minimum, elapsed_ms: elapsed,
        target_ms: target, proposed: proposed,
    })
    print(f"SIZING {case.name} proposed common count {proposed} (not a latency distribution)")
    true
}

fn summarize(rows: &[]Row, start: i32, rounds: i32, name: string) -> []Summary {
    mut output: []Summary = []
    for capacity in tasks.capacities() {
        mut times: []i64 = []
        mut ratios: []i64 = []
        for round in 0..rounds {
            mut one: i64 = 0
            mut current: i64 = 0
            for position in 0..3 {
                at := start + round * 3 + position
                if rows[at].capacity == 1 { one = rows[at].nanos }
                if rows[at].capacity == capacity { current = rows[at].nanos }
            }
            times.push(current)
            ratio := time.milliseconds(one) / time.milliseconds(current)
            ratios.push(ratio.to_bits())
        }
        stats := time.distribution(move times)
        output.push(Summary {
            name: name.clone(), capacity: capacity, samples: rounds, median: stats.median,
            p95: stats.p95, speedup: time.median_ratio(move ratios),
        })
    }
    output
}

fn measure(runner: &mut Runner, case: &Workload, rounds: i32, results: &mut Results) -> bool {
    start := results.rows.len
    for round in 0..rounds {
        order := tasks.capacity_order(round)
        for position in 0..order.len {
            capacity := order[position]
            mut elapsed: i64 = 0
            if !runner.validate(case.image, workload_args(case.cpu, &case.size, capacity), case.expected, true, &mut elapsed) {
                return false
            }
            results.rows.push(Row {
                name: case.name.clone(), round: round, position: position, capacity: capacity,
                nanos: elapsed, image_sha256: case.sha256.clone(),
            })
        }
    }
    for summary in move summarize(&results.rows, start, rounds, case.name) {
        results.summaries.push(move summary)
    }
    print(f"COMPLETE {case.name} {rounds} fresh processes per capacity")
    true
}

fn run_workload(runner: &mut Runner, options: &Options, manifest: &json.Doc, cohort: string, name: string, results: &mut Results) -> bool {
    cpu := name == "cpu"
    settings := manifest.field(manifest.field(manifest.root, "cases"), name)
    count := manifest.get_i64(settings, if cpu { "steps" } else { "passes" })
    length := if cpu { Option<i64>.Some(0) } else { manifest.get_i64(settings, "length") }
    maximum := if cpu { 8000000 } else { 8192 }
    if count.is_none() || length.is_none() {
        return runner.fail(f"{name}: missing work count")
    }
    cv := count.unwrap(); lv := length.unwrap()
    if cv < 1 || cv > i64(maximum) || lv < 0 || lv > 4096 {
        return runner.fail(f"{name}: work count out of range")
    }
    if options.mode != .Check && !cpu && lv == 0 { return runner.fail("measured array work must be nonempty") }
    size := tasks.Work { count: i32(cv), length: i32(lv) }
    image := runner.work + "/" + name
    if !runner.build(options.compiler, cohort + "/" + name + ".ddr", image, options.flags) { return false }
    binary := sys.read_u8(image)
    if !binary.ok { return runner.fail(f"cannot read {image}") }
    hash := harness.sha256_bytes_hex(&binary.value)
    expected := if options.mode == .Check { "" } else { tasks.expected(cpu, &size) }
    offset := results.work.len
    case := Workload {
        name: name.clone(), cpu: cpu, size: size, maximum: maximum, image: image.clone(), sha256: hash.clone(),
        bytes: i64(binary.value.len), checked: false, expected: expected,
    }
    results.work.push(case.clone())
    if options.mode == .Check {
        if !check(&mut runner, &case, options.serial, cohort) { return false }
        results.work[offset].checked = true
    } else {
        mut elapsed: i64 = 0
        for capacity in tasks.capacities() {
            if !runner.validate(image, workload_args(cpu, &size, capacity), case.expected, false, &mut elapsed) { return false }
        }
        if options.mode == .Calibrate {
            if !calibrate(&mut runner, &case, options.target, &mut results.sizing) { return false }
        } else {
            if !measure(&mut runner, &case, options.rounds, &mut results) { return false }
        }
    }
    harness.sha256_file_hex(image) == hash || runner.fail("runtime image changed")
}

fn track(path: string, hashes: &mut []Hash) -> bool {
    for saved in hashes {
        if saved.path == path { return true }
    }
    hash := harness.sha256_file_hex(path)
    if hash.len == 0 { return harness.fail(f"cannot hash {path}") }
    hashes.push(Hash { path: path.clone(), sha256: hash })
    true
}

fn lookup(hashes: &[]Hash, path: string) -> string {
    for saved in hashes {
        if saved.path == path { return saved.sha256.clone() }
    }
    ""
}

fn track_inputs(root: string, cohort: string, options: &Options, hashes: &mut []Hash) -> bool {
    for path in [options.manifest.clone(), options.compiler.clone(),
                 root + "/tools/performance_tasks.ddr", root + "/tools/task_throughput_cases.ddr", root + "/tools/benchmark_time.ddr"] {
        if !track(path, &mut hashes) { return false }
    }
    if options.serial.len > 0 && !track(options.serial, &mut hashes) { return false }
    entries := fs.list_dir(cohort)
    if entries.is_err() { return harness.fail(f"cannot list {cohort}") }
    for path in entries.unwrap() {
        if text.ends_with(path, ".ddr") && !track(cohort + "/" + path, &mut hashes) { return false }
    }
    true
}

fn stable(hashes: &[]Hash, runner: &mut Runner) -> bool {
    for saved in hashes {
        if harness.sha256_file_hex(saved.path) != saved.sha256 {
            return runner.fail(f"compiler/source/manifest changed during run: {saved.path}")
        }
    }
    true
}

fn host_details(root: string, host: &mut Host) -> bool {
    git := native.find_executable("git")
    if git.len == 0 { return harness.fail("git is needed for benchmark provenance") }
    mut output := harness.empty_output()
    if !harness.run_checked(git, ["rev-parse", "HEAD"], root, 0, false, &mut output) { return false }
    host.revision = text.trim(output.stdout_text())
    if !harness.run_checked(git, ["status", "--short"], root, 0, false, &mut output) { return false }
    host.working_tree = text.trim(output.stdout_text())
    if !harness.run_checked("/usr/sbin/sysctl", ["machdep.cpu.brand_string", "hw.memsize", "hw.ncpu"], root, 0, false, &mut output) {
        return false
    }
    host.hardware = text.trim(output.stdout_text())
    selectors: []string = ["-s", "-n", "-r", "-v", "-m", "-p"]
    for flag in selectors {
        if !harness.run_checked("/usr/bin/uname", [flag.clone()], root, 0, false, &mut output) { return false }
        host.values.push(text.trim(output.stdout_text()))
    }
    true
}

fn write_capacities(writer: &mut json.Writer) {
    writer.array()
    for capacity in tasks.capacities() { writer.integer(i64(capacity)) }
    writer.end()
}

fn write_strings(writer: &mut json.Writer, values: &[]string) {
    writer.array()
    for value in values { writer.string(value) }
    writer.end()
}

fn write_work(writer: &mut json.Writer, workloads: &[]Workload, mode: Mode) {
    writer.object()
    for item in workloads {
        writer.key(item.name)
        writer.object()
        writer.key("binary_sha256"); writer.string(item.sha256)
        writer.key("binary_bytes"); writer.integer(item.bytes)
        writer.key("count"); writer.integer(i64(item.size.count))
        writer.key("length"); writer.integer(i64(item.size.length))
        writer.key("jobs"); writer.integer(32)
        writer.key("batch_width"); writer.integer(4)
        writer.key("capacities"); write_capacities(&mut writer)
        if item.checked {
            writer.key("checked_scenarios")
            writer.array()
            for visited in tasks.small_cases(item.cpu) {
                writer.array()
                writer.integer(i64(visited.count))
                writer.integer(i64(visited.length))
                writer.end()
            }
            writer.end()
        }
        if mode != .Check { writer.key("expected_stdout"); writer.string(item.expected) }
        writer.end()
    }
    writer.end()
}

fn metadata(options: &Options, host: &Host, hashes: &[]Hash, manifest: &json.Doc,
            runner: &Runner, results: &Results, complete: bool) -> string {
    mut writer := json.Writer::new()
    writer.object()
    writer.key("protocol"); writer.string("dunder-source-task-throughput-v1")
    writer.key("mode"); writer.string(options.label)
    writer.key("complete"); writer.boolean(complete)
    writer.key("host"); writer.object()
    for i in 0..host.names.len {
        writer.key(host.names[i]); writer.string(host.values[i])
    }
    writer.end()
    writer.key("revision"); writer.string(host.revision)
    writer.key("working_tree"); writer.string(host.working_tree)
    writer.key("hardware"); writer.string(host.hardware)
    writer.key("compiler"); writer.string(options.compiler)
    writer.key("compiler_sha256"); writer.string(lookup(&hashes, options.compiler))
    writer.key("compiler_flags"); write_strings(&mut writer, &options.flags)
    writer.key("manifest"); writer.null()
    writer.key("manifest_sha256"); writer.string(lookup(&hashes, options.manifest))
    writer.key("inputs_sha256"); writer.object()
    for item in hashes { writer.key(item.path); writer.string(item.sha256) }
    writer.end()
    writer.key("environment"); writer.object()
    writer.key("PATH"); writer.string("/no-external-tools")
    writer.end()
    writer.key("commands")
    writer.array()
    for command in runner.commands {
        writer.object()
        writer.key("command"); write_strings(&mut writer, &command.args)
        writer.key("timed"); writer.boolean(command.timed)
        writer.key("stdout"); writer.string(command.stdout)
        writer.key("status"); writer.integer(0)
        writer.end()
    }
    writer.end()
    writer.key("workloads"); write_work(&mut writer, &results.work, options.mode)
    limits: []string = [
        "Source language task throughput on ARM64macOS, not parallel compiler speedup",
        "Capacity1 is one-worker task scheduling, not a direct-call serial baseline",
        "No C comparison or addition to the four-kernel C acceptance suite",
        "Whole process wall time includes input/setup/clones/start/join/output/scope teardown",
        "Thread placement, frequency and OS scheduling are uncontrolled; report host and paired distributions",
    ]
    writer.key("limitations"); write_strings(&mut writer, &limits)
    if options.mode == .Measure {
        writer.key("rounds"); writer.integer(i64(options.rounds))
        writer.key("order"); writer.string("all six capacity permutations rotate; each occurs5 times at30 rounds")
        writer.key("warmup"); writer.string("one checked unrecorded fresh process per capacity before each case")
    }
    if !complete { writer.key("error"); writer.string(runner.error) }
    writer.end()

    encoded := writer.finish()
    if encoded.is_err() { return "" }
    encoded_str := encoded.unwrap()
    document := json.Doc::parse_text(encoded_str)
    node := document.field(document.root, "manifest")
    if node < 0 { return "" }
    encoded_str[0..document.starts[node]] + manifest.raw_span(manifest.root) + encoded_str[document.ends[node]..encoded_str.len] + "\n"
}

fn decimal(value: f64) -> string {
    mut raw: []u8 = []
    if !json.write_f64(&mut raw, value) { return "" }
    number := bytes.decode(&raw).value
    if !text.contains(number, ".") && !text.contains(number, "e") { return number + ".0" }
    number
}

fn write_table(path: string, content: &[]u8) -> bool {
    sys.write_u8(path, &content).ok || harness.fail(f"cannot write {path}")
}

fn write_samples(directory: string, rows: &[]Row, summaries: &[]Summary) -> bool {
    if rows.len > 0 {
        mut csv: []u8 = []
        bytes.append_utf8(&mut csv, "case,round,order,capacity,elapsed_ms,binary_sha256\r\n")
        for row in rows {
            value := time.fixed_ms(row.nanos)
            bytes.append_utf8(&mut csv, f"{row.name},{row.round},{row.position},{row.capacity},{value},{row.image_sha256}\r\n")
        }
        if !write_table(directory + "/samples.csv", &csv) { return false }
    }
    if summaries.len > 0 {
        mut csv: []u8 = []
        bytes.append_utf8(&mut csv, "case,capacity,samples,median_ms,p95_ms,median_paired_speedup_over_capacity1\r\n")
        for row in summaries {
            median := decimal(row.median)
            p95 := decimal(row.p95)
            speedup := decimal(row.speedup)
            bytes.append_utf8(&mut csv, f"{row.name},{row.capacity},{row.samples},{median},{p95},{speedup}\r\n")
        }
        if !write_table(directory + "/summary.csv", &csv) { return false }
    }
    true
}

struct Edit { start: i32, end: i32, value: string }

fn replace(doc: &json.Doc, node: i32, value: string, edits: &mut []Edit) {
    assert(node >= 0)
    quotes := if doc.kind(node) == .String { 1 } else { 0 }
    edits.push(Edit { start: doc.starts[node] - quotes, end: doc.ends[node] + quotes, value: value.clone() })
}

fn write_sizing(directory: string, doc: &json.Doc, rows: &[]Sizing, compiler_hash: string) -> bool {
    mut writer := json.Writer::new()
    writer.object()
    writer.key("compiler_sha256"); writer.string(compiler_hash)
    writer.key("observations"); writer.array()
    mut edits: []Edit = []
    mut csv: []u8 = []
    bytes.append_utf8(&mut csv, "case,count,minimum_work_ms,elapsed_ms,target_ms,proposed_count\r\n")
    for row in rows {
        writer.object()
        writer.key("case"); writer.string(row.name)
        writer.key("count"); writer.integer(i64(row.count))
        writer.key("minimum_work_ms"); writer.decimal(row.minimum_ms)
        writer.key("elapsed_ms"); writer.decimal(row.elapsed_ms)
        writer.key("target_ms"); writer.decimal(row.target_ms)
        writer.key("proposed_count"); writer.integer(i64(row.proposed))
        writer.end()
        group := doc.field(doc.field(doc.root, "cases"), row.name)
        node := doc.field(group, if row.name == "cpu" { "steps" } else { "passes" })
        replace(&doc, node, row.proposed.str(), &mut edits)
        minimum := decimal(row.minimum_ms)
        elapsed := decimal(row.elapsed_ms)
        target := decimal(row.target_ms)
        bytes.append_utf8(&mut csv, f"{row.name},{row.count},{minimum},{elapsed},{target},{row.proposed}\r\n")
    }
    writer.end()
    writer.key("note"); writer.string("Review these common counts, then set frozen=true before paired measurement.")
    writer.end()
    note := writer.finish()
    if note.is_err() { return harness.fail("cannot serialize calibration") }
    note_str := note.unwrap()
    mut missing := ""
    frozen := doc.field(doc.root, "frozen")
    if frozen < 0 { missing += ",\"frozen\":false" }
    else { replace(&doc, frozen, "false", &mut edits) }
    sizing := doc.field(doc.root, "sizing")
    if sizing < 0 { missing += ",\"sizing\":" + note_str }
    else { replace(&doc, sizing, note_str, &mut edits) }
    if missing.len > 0 {
        close := doc.ends[doc.root] - 1
        edits.push(Edit { start: close, end: close, value: missing })
    }
    for i in 1..edits.len {
        mut at := i
        while at > 0 && edits[at - 1].start > edits[at].start {
            edits.swap(at - 1, at)
            at -= 1
        }
    }
    mut next := doc.starts[doc.root]
    mut revised: []u8 = []
    for edit in edits {
        bytes.extend_range(&mut revised, &doc.input, next, edit.start)
        bytes.append_utf8(&mut revised, edit.value)
        next = edit.end
    }
    bytes.extend_range(&mut revised, &doc.input, next, doc.ends[doc.root])
    revised.push(b'\n')
    if rows.len > 0 && !write_table(directory + "/calibration.csv", &csv) { return false }
    write_table(directory + "/recommended-workloads.json", &revised)
}

fn save(options: &Options, host: &Host, hashes: &[]Hash, manifest: &json.Doc,
        runner: &Runner, results: &Results, complete: bool) -> bool {
    directory := options.report.clone()
    if directory.len == 0 { return true }
    if !write_samples(directory, &results.rows, &results.summaries) { return false }
    if options.mode == .Calibrate && !write_sizing(directory, &manifest, &results.sizing, lookup(&hashes, options.compiler)) {
        return false
    }
    encoded := metadata(&options, &host, &hashes, &manifest, &runner, &results, complete)
    if encoded.len == 0 || !sys.write_text(directory + "/metadata.json", encoded).ok {
        return harness.fail("cannot write metadata.json")
    }
    true
}

fn exercise(root: string, cohort: string, options: &Options, manifest: &json.Doc) -> i32 {
    mut hashes: []Hash = []
    if !track_inputs(root, cohort, &options, &mut hashes) { return 1 }
    mut host := Host { names: ["system", "node", "release", "version", "machine", "processor"], values: [],
                       revision: "", working_tree: "", hardware: "" }
    if !host_details(root, &mut host) { return 1 }
    temp := fs.temp_dir("dunder-task-throughput-")
    if !temp.ok { _ := harness.fail("cannot create temporary work directory"); return 1 }
    defer { _ := fs.remove_all(temp.value) }
    work := fs.realpath(temp.value)
    if !work.ok { _ := harness.fail("cannot resolve temporary work directory"); return 1 }
    mut runner := Runner { work: work.value, error: "", commands: [] }
    mut results := Results { work: [], rows: [], summaries: [], sizing: [] }
    mut complete := true
    for name in options.cases {
        if !run_workload(&mut runner, &options, &manifest, cohort, name, &mut results) {
            complete = false
            break
        }
    }
    if complete { complete = stable(&hashes, &mut runner) }
    if save(&options, &host, &hashes, &manifest, &runner, &results, complete) && complete { return 0 }
    1
}

fn geometry(doc: &json.Doc) -> bool {
    if !doc.ok || doc.get_str(doc.root, "protocol") != .Some("dunder-source-task-throughput-v1") ||
       doc.get_i64(doc.root, "jobs") != .Some(32) || doc.get_i64(doc.root, "batch_width") != .Some(4) { return false }
    entries := doc.field(doc.root, "capacities")
    expected := tasks.capacities()
    if doc.kind(entries) != .Array || doc.count(entries) != expected.len { return false }
    for i in 0..expected.len {
        if doc.as_i64(doc.at(entries, i)) != .Some(i64(expected[i])) { return false }
    }
    true
}

fn absolute(path: string, label: string) -> string {
    resolved := fs.realpath(path)
    if resolved.ok { return resolved.value }
    _ := harness.fail(f"cannot resolve {label}: {path}")
    ""
}

fn argument_error(message: string) -> i32 {
    _ := harness.fail(message)
    2
}

fn main() -> i32 {
    spec: []cli.Option = [
        cli.option("--report"), cli.option("--manifest"), cli.option("--case"), cli.option("--compiler-flag"),
        cli.option("--reference-compiler"), cli.option("--target-ms"), cli.option("--rounds"),
    ]
    args := cli.parse(&spec)
    usage := "usage: performance_tasks check COMPILER [--report PATH] [--reference-compiler COMPILER]\n" +
             "       performance_tasks calibrate COMPILER REPORT [--target-ms MS]\n" +
             "       performance_tasks measure COMPILER REPORT [--rounds N]\n" +
             "       all modes: [--manifest PATH] [--case cpu|array] [--compiler-flag FLAG]"
    if args.help { print(usage); return 0 }
    if args.error.len > 0 { return argument_error(args.error) }
    if args.positionals.len < 2 { return argument_error(usage) }
    label := args.positionals[0].clone()
    if label != "check" && label != "calibrate" && label != "measure" { return argument_error(usage) }
    mode: Mode = if label == "check" { .Check } else if label == "calibrate" { .Calibrate } else { .Measure }
    positions := if mode == .Check { 2 } else { 3 }
    if args.positionals.len != positions ||
       (mode != .Check && (args.has("--report") || args.has("--reference-compiler"))) ||
       (mode != .Calibrate && args.has("--target-ms")) || (mode != .Measure && args.has("--rounds")) {
        return argument_error(usage)
    }
    if !target_is("arm64-macos") { return argument_error("the current source task implementation requires ARM64 macOS") }
    rounds := parse.integer(args.last("--rounds", "30"))
    if !rounds.ok || rounds.value < 1 || rounds.value > 2147483647 { return argument_error("--rounds must be positive") }
    target_ms := parse.Float64::parse(args.last("--target-ms", "250"))
    if !target_ms.ok || !target_ms.value.is_finite() || target_ms.value < 100.0 {
        return argument_error("--target-ms must be finite and at least 100")
    }

    root := harness.find_root()
    if root.len == 0 { return argument_error("cannot locate the Dunder source repository") }
    cohort := root + "/benchmarks/tasks"
    compiler := absolute(args.positionals[1], "compiler")
    if compiler.len == 0 { return 2 }
    mut serial := ""
    if args.has("--reference-compiler") {
        serial = absolute(args.last("--reference-compiler", ""), "reference compiler")
        if serial.len == 0 { return 2 }
    }
    manifest_path := absolute(args.last("--manifest", cohort + "/workloads.json"), "manifest")
    if manifest_path.len == 0 { return 2 }
    raw := sys.read_u8(manifest_path)
    if !raw.ok { return argument_error("cannot read task workload manifest") }
    manifest := json.Doc::parse_bytes(move raw.value)
    if !geometry(&manifest) { return argument_error("manifest protocol/geometry differs from the frozen source program") }
    if mode == .Measure && manifest.get_bool(manifest.root, "frozen") != .Some(true) {
        return argument_error("measurement requires reviewed frozen work counts; calibrate once first")
    }

    mut cases: []string = []
    for name in move args.all("--case") {
        if name != "cpu" && name != "array" { return argument_error(f"unknown task case: {name}") }
        mut found := false
        for existing in cases {
            if existing == name { found = true; break }
        }
        if !found { cases.push(move name) }
    }
    if cases.len == 0 { cases = ["cpu", "array"] }
    mut report := if mode == .Check { args.last("--report", "") } else { args.positionals[2].clone() }
    if report.len > 0 {
        report = harness.resolve_or_abs(report)
        if !fs.mkdir_all(report).ok { return argument_error("cannot create report directory") }
        empty := match fs.list_dir(report) {
            .Ok(items) => items.len == 0,
            .Err(_) => false,
        }
        if !empty { return argument_error("report directory must be empty") }
    }
    options := Options {
        mode: mode, label: label, compiler: compiler, serial: serial, manifest: manifest_path, report: report,
        cases: cases, flags: args.all("--compiler-flag"), rounds: i32(rounds.value), target: target_ms.value,
    }
    exercise(root, cohort, &options, &manifest)
}
