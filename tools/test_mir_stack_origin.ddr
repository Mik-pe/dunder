capability process, filesystem

import .harness as harness
import .test_evidence as evidence
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.process as process
import sys

struct Image {
    target: i32,
    origin: string,
    path: string,
    sha256: string,
    execution: string,
}

struct Receipt {
    path: string,
    compiler: string,
    compiler_sha256: string,
    emitter_source_sha256: string,
    journal: evidence.Journal,
    images: []Image,
}

impl Receipt {
    fn save(&self, complete: bool) -> bool {
        mut writer := json.Writer::new()
        writer.object()
        writer.key("protocol")
        writer.string("mir-stack-origin-v1")
        writer.key("timings")
        writer.string("none")
        writer.key("compiler")
        writer.string(self.compiler)
        writer.key("compiler_sha256")
        writer.string(self.compiler_sha256)
        writer.key("emitter_source_sha256")
        writer.string(self.emitter_source_sha256)
        writer.key("commands")
        self.journal.write_to(&mut writer, "argv")
        writer.key("images")
        writer.array()
        for image in self.images {
            writer.object()
            writer.key("target")
            writer.integer(i64(image.target))
            writer.key("origin")
            writer.string(image.origin)
            writer.key("path")
            writer.string(image.path)
            writer.key("sha256")
            writer.string(image.sha256)
            writer.key("execution")
            writer.string(image.execution)
            writer.end()
        }
        writer.end()
        writer.key("complete")
        writer.boolean(complete)
        writer.end()
        evidence.save(self.path, &writer)
    }

    fn run(&mut self, program: string, args: []string, out: &mut process.Output) -> bool {
        ok := self.journal.run(program, args, &mut out)
        self.save(false) && ok
    }
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    host := harness.host_id()
    source := cli.root + "/tests/fixtures/mir-stack-origin-emitter.ddr"
    emitter := work + "/emitter"
    mut receipt := Receipt {
        path: work + "/receipt.json", compiler: cli.compiler.clone(),
        compiler_sha256: harness.sha256_file_hex(cli.compiler), emitter_source_sha256: harness.sha256_file_hex(source),
        journal: evidence.Journal::new(cli.root, 30000), images: [],
    }
    mut result := harness.empty_output()
    if !receipt.run(cli.compiler, ["build", source, "-o", emitter.clone()], &mut result) { return false }
    for target in 0..3 {
        mut raw: []u8 = []
        for origin in ["raw", "temp"] {
            path := f"{work}/valid-{target}-{origin}"
            if !receipt.run(emitter, [path.clone(), target.str(), origin.clone(), "valid"], &mut result) { return false }
            data := sys.read_u8(path)
            if !data.ok { return harness.fail(f"cannot read {path}") }
            digest := harness.sha256_bytes_hex(&data.value)
            mut execution := "cross-built only; no execution claim"
            if target == host {
                if !receipt.run(path, [], &mut result) || !harness.stdout_is(&result, "42\n", path) { return false }
                if result.stderr.len != 0 { return harness.fail(f"{path}: {result.stderr_text()}") }
                execution = "host passed:42"
            }
            receipt.images.push(Image { target: target, origin: origin.clone(), path: path, sha256: digest, execution: execution })
            if !receipt.save(false) { return false }
            if origin == "raw" {
                raw = data.value
            } else if !bytes.equal(&raw, &data.value) {
                return harness.fail(f"target {target}: raw and temp images differ")
            }
        }
    }
    if harness.sha256_file_hex(cli.compiler) != receipt.compiler_sha256 { return harness.fail("compiler changed during verification") }
    if !receipt.save(true) { return false }
    print("PASS:6 exact raw/temp target images; native host success; no timings")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if cli.output_dir.len == 0 || cli.extra_args.len != 0 {
        _ := sys.eprint("usage: test_mir_stack_origin <compiler> --output <empty directory>")
        return 2
    }
    if !fs.mkdir_all(cli.output_dir).ok { _ := harness.fail(f"cannot create {cli.output_dir}"); return 1 }
    path := fs.realpath(cli.output_dir)
    contents := fs.list_dir(cli.output_dir)
    if !path.ok || !contents.ok || contents.entries.len != 0 {
        _ := harness.fail("preserve earlier outcomes; choose an empty directory")
        return 1
    }
    if run_suite(&cli, path.value) { 0 } else { 1 }
}
