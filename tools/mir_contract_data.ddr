pub struct ScalarCase {
    name: string,
    a: i64,
    b: i64,
    expected: i64,
}

fn scalar(name: string, a: i64, b: i64, expected: i64) -> ScalarCase {
    ScalarCase { name: name.clone(), a: a, b: b, expected: expected }
}

