capability process, filesystem

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn check_grants(compiler: string, root: string, project: string, out_count: &mut i32) -> bool {
    fixtures := root + "/tests/fixtures/fs_handles"
    if !harness.copy_ddr_files(fixtures, project) { return false }

    content := "hämtad 🌍\n"
    src_file := project + "/källa.txt"
    if !sys.write_text(src_file, content).ok {
        return harness.fail("failed to write källa.txt")
    }

    image := project + "/copy"
    build_args: []string = ["build", "main.ddr", "-o", image]
    var res := harness.empty_output()
    if !harness.run_checked(compiler, build_args, project, 0, false, &mut res) {
        return false
    }

    prev_read := sys.read_u8(image)
    if !prev_read.ok {
        return harness.fail("failed to read built copy image")
    }
    previous := prev_read.value

    if !harness.run_checked(image, [], project, 0, false, &mut res) {
        return false
    }

    var expected_bytes: []u8 = []
    bytes.append_utf8(&mut expected_bytes, content + "✓\n")
    got_res := sys.read_u8(project + "/resultat.txt")
    if !got_res.ok || !harness.bytes_equal(&got_res.value, &expected_bytes) {
        return harness.fail("destination contents differ from delegated read/write")
    }

    arbete_path := project + "/arbete"
    src_after := sys.read_text(src_file)
    if sys.metadata(arbete_path).ok || fs.is_symlink(arbete_path) || !src_after.ok || src_after.value != content {
        return harness.fail("directory cleanup or source preservation failed")
    }

    worker_path := project + "/worker.ddr"
    orig_worker := sys.read_text(worker_path)
    if !orig_worker.ok {
        return harness.fail("failed to read worker.ddr")
    }

    bodies: []string = [
        "x := fs.grant_read(\"other\")",
        "target := fs.grant_write",
        "forged := fs.WriteFile { path: \"other\" }",
        "path := input.path",
        "input.path = \"other\"",
        "change(&mut input.path)",
        "result := fs.write(&input, \"wrong grant\")",
        "unsafe { p := ptr(0) }",
        "exe := process.grant(\"/bin/sh\")",
        "out := process.run(\"/bin/sh\", [])",
        "forged := process.Executable { program: \"/bin/sh\" }",
    ]
    messages: []string = [
        "capability filesystem",
        "capability filesystem",
        "opaque struct",
        "opaque struct",
        "opaque struct",
        "opaque struct",
        "type mismatch",
        "capability unsafe",
        "capability process",
        "capability process",
        "opaque struct",
    ]
    needs_proc_import: []bool = [
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        true,
        true,
        true,
    ]

    for idx in 0..bodies.len {
        var prefix := ""
        if needs_proc_import[idx] {
            prefix = "import std.process\n"
        }
        patched := prefix + orig_worker.value + "\nfn change(value:&mut string){}\n" +
                   "fn other(input:&mut fs.ReadFile){ " + bodies[idx] + " }\n"
        if !sys.write_text(worker_path, patched).ok {
            return harness.fail("failed to write patched worker.ddr")
        }

        for cmd_idx in 0..2 {
            var cmd_args: []string = ["check", "main.ddr"]
            if cmd_idx == 1 {
                cmd_args = ["build", "main.ddr", "-o", image]
            }
            out := harness.exec_cmd(compiler, cmd_args, project, false, 30000)
            err_txt := process.stderr_text(&out)
            if !out.ok || out.timed_out || out.signal != 0 || out.code != 1 ||
               text.find(err_txt, "worker.ddr:") < 0 || text.find(err_txt, messages[idx]) < 0 {
                return harness.fail(bodies[idx] + ": exited " + out.code.str() + " stderr: " + err_txt)
            }
        }

        now_img := sys.read_u8(image)
        if !now_img.ok || !harness.bytes_equal(&now_img.value, &previous) {
            return harness.fail("a failed build replaced the valid native image")
        }
    }

    out_count = bodies.len
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-files-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    var count := 0
    ok := check_grants(cli.compiler, cli.root, tmp.value, &mut count)
    _ := fs.remove_all(tmp.value)
    if !ok { return false }
    print("PASS delegated file copy, directory cleanup and " + count.str() + " authority checks")
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
