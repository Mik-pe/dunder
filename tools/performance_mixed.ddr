capability filesystem
import .performance_corpus as corpus
import std.bytes
import std.fs
import sys

fn line(out: &mut []u8, value: string) {
    bytes.append_utf8(&mut out, value)
    out.push(10)
}

fn main() {
    assert(sys.arg_count() == 2)
    root := sys.arg(1)
    assert(fs.mkdir_all(root).ok && fs.list_dir(root).unwrap().len == 0)
    assert(sys.write_text(root + "/dunder.toml", "name = \"mixed\"\nroot = \"main.ddr\"\n").ok)
    assert(sys.write_text(root + "/shared.ddr",
        "pub struct Settings { scale: i64, offset: i64 }\npub fn weigh(values: &[]i64, settings: &Settings, index: i32) -> i64 {\n    values[index] * settings.scale + settings.offset\n}\n").ok)
    mut entry: []u8 = []
    for m in 0..20 { line(&mut entry, f"import m{m}") }
    line(&mut entry, "fn main() {")
    line(&mut entry, "    mut sum: i64 = 0")
    mut reference: i64 = 0
    for m in 0..20 {
        mut source: []u8 = []
        line(&mut source, "import shared")
        line(&mut source, "fn adjustment() -> i64 { 1 }")
        for f in 0..50 {
            seed := m * 50 + f
            scale := seed % 13 + 1
            offset := seed % 37
            line(&mut source, f"fn sample{f}(values: &[]i64) -> i64 {{")
            line(&mut source, f"    config := shared.Settings {{ scale: {scale}, offset: {offset} }}")
            line(&mut source, "    mut score := adjustment()")
            mut score: i64 = 1
            for part in 0..13 {
                idx := (seed + part * 3) % 5
                step := (seed * 7 + part) % 19 + 1
                value := i64((idx + 1) * scale + offset)
                line(&mut source, f"    part{part} := shared.weigh(&values, &config, {idx})")
                line(&mut source, f"    if part{part} % 3 == 0 {{")
                line(&mut source, f"        score += part{part} + {step}")
                line(&mut source, "    } else {")
                line(&mut source, f"        score += part{part} - {step}")
                line(&mut source, "    }")
                line(&mut source, f"    for lane in 0..{1 + idx % 3} {{")
                line(&mut source, "        score += i64(lane)")
                line(&mut source, "    }")
                score += if value % 3 == 0 { value + i64(step) } else { value - i64(step) }
                for lane in 0..(1 + idx % 3) { score += i64(lane) }
            }
            line(&mut source, "    score")
            line(&mut source, "}")
            reference += score
        }
        line(&mut source, "pub fn run() -> i64 {")
        line(&mut source, "    values: []i64 = [1, 2, 3, 4, 5]")
        line(&mut source, "    mut total: i64 = 0")
        for f in 0..50 { line(&mut source, f"    total += sample{f}(&values)") }
        line(&mut source, "    total")
        line(&mut source, "}")
        assert(sys.write_u8(f"{root}/m{m}.ddr", &source).ok)
        line(&mut entry, f"    sum += m{m}.run()")
    }
    line(&mut entry, "    print(sum)")
    line(&mut entry, "}")
    assert(sys.write_u8(root + "/main.ddr", &entry).ok)
    generated := corpus.describe_generated(root, root + "/main.ddr")
    assert(generated.error == "")
    print(f"checksum={reference} lines={generated.lines} bytes={generated.source_bytes} modules={generated.modules} functions={generated.functions} tokens={generated.tokens} sha256={generated.sha256}")
}
