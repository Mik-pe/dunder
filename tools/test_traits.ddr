capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.bytes as bytes
import sys

fn valid_library() -> string {
    "pub trait Describe {\n" +
    "    fn describe(&self) -> string\n" +
    "}\n" +
    "pub trait Ordered: Describe {\n" +
    "    fn rank(&self) -> i32\n" +
    "}\n" +
    "pub trait Factory {\n" +
    "    fn make() -> Self\n" +
    "}\n" +
    "pub opaque struct SecretBox {\n" +
    "    label: string,\n" +
    "    count: i32,\n" +
    "}\n" +
    "impl SecretBox {\n" +
    "    pub fn new(move label: string, count: i32) -> Self { Self { label: label, count: count } }\n" +
    "    pub fn summary(&self) -> string { self.label + \":\" + self.count.str() }\n" +
    "}\n" +
    "impl Sendable for SecretBox {}\n" +
    "pub opaque struct Unclassified {\n" +
    "    n: i32,\n" +
    "}\n" +
    "impl Unclassified {\n" +
    "    pub fn new(n: i32) -> Self { Self { n: n } }\n" +
    "}\n" +
    "pub struct ImportedItem { value: i32 }\n"
}

fn valid_program() -> string {
    "import .trait_lib as lib\n\n" +
    "trait LocalShow {\n" +
    "    fn show(&self) -> string\n" +
    "}\n" +
    "trait BorrowLabel {\n" +
    "    fn label(&self) -> &string from self\n" +
    "}\n" +
    "trait Counter {\n" +
    "    fn bump(&mut self, by: i32) -> i32\n" +
    "}\n" +
    "trait Marker {}\n" +
    "trait Combined: lib.Describe + LocalShow {\n" +
    "    fn tag(&self) -> i32\n" +
    "}\n\n" +
    "struct Widget { name: string, weight: i32 }\n" +
    "impl lib.Describe for Widget {\n" +
    "    fn describe(&self) -> string { \"Widget(\" + self.name + \")\" }\n" +
    "}\n" +
    "impl lib.Ordered for Widget {\n" +
    "    fn rank(&self) -> i32 { self.weight }\n" +
    "}\n" +
    "impl lib.Factory for Widget {\n" +
    "    fn make() -> Self { Self { name: \"default\", weight: 10 } }\n" +
    "}\n" +
    "impl LocalShow for Widget {\n" +
    "    fn show(&self) -> string { self.name.clone() }\n" +
    "}\n" +
    "impl BorrowLabel for Widget {\n" +
    "    fn label(&self) -> &string from self { &self.name }\n" +
    "}\n" +
    "impl Counter for Widget {\n" +
    "    fn bump(&mut self, by: i32) -> i32 { self.weight = self.weight + by; self.weight }\n" +
    "}\n" +
    "impl Combined for Widget {\n" +
    "    fn tag(&self) -> i32 { self.weight + 1 }\n" +
    "}\n" +
    "impl Marker for Widget {}\n" +
    "impl Sendable for Widget {}\n\n" +
    "impl LocalShow for i32 {\n" +
    "    fn show(&self) -> string { \"int:\" + self.str() }\n" +
    "}\n" +
    "impl LocalShow for lib.ImportedItem {\n" +
    "    fn show(&self) -> string { \"imp:\" + self.value.str() }\n" +
    "}\n\n" +
    "struct Holder<T> { item: T }\n" +
    "impl LocalShow for Holder<T> where T: LocalShow {\n" +
    "    fn show(&self) -> string { \"[\" + self.item.show() + \"]\" }\n" +
    "}\n" +
    "impl lib.Describe for Holder<T> where T: lib.Describe {\n" +
    "    fn describe(&self) -> string { \"Holder(\" + self.item.describe() + \")\" }\n" +
    "}\n" +
    "struct Plain { x: i32 }\n\n" +
    "@resource struct Handle { fd: i32 }\n\n" +
    "trait Greeting: Clone {\n" +
    "    fn who(&self) -> string\n" +
    "    fn clone_greeting(&self) -> Self {\n" +
    "        self.clone()\n" +
    "    }\n" +
    "    fn greet(&self) -> string {\n" +
    "        \"hello \" + self.who()\n" +
    "    }\n" +
    "}\n" +
    "struct Person { id: i32, name: string }\n" +
    "impl Greeting for Person {\n" +
    "    fn who(&self) -> string { self.name.clone() }\n" +
    "}\n" +
    "struct Polite { name: string }\n" +
    "impl Greeting for Polite {\n" +
    "    fn who(&self) -> string { self.name.clone() }\n" +
    "    fn greet(&self) -> string { \"greetings \" + self.who() }\n" +
    "}\n" +
    "struct Point { x: i32, y: i32 }\n" +
    "impl Eq for Point {\n" +
    "    fn eq(&self, other: &Self) -> bool { self.x == other.x && self.y == other.y }\n" +
    "}\n" +
    "impl Ord for Point {\n" +
    "    fn cmp(&self, other: &Self) -> Ordering {\n" +
    "        cx := self.x.cmp(other.x)\n" +
    "        if cx != Ordering.Equal { return cx }\n" +
    "        self.y.cmp(other.y)\n" +
    "    }\n" +
    "}\n" +
    "impl Hash for Point {\n" +
    "    fn hash(&self) -> u64 { self.x.hash().bit_xor(self.y.hash().wrapping_mul(11400714819323198485)) }\n" +
    "}\n" +
    "impl Display for Point {\n" +
    "    fn str(&self) -> string { \"(\" + self.x.str() + \",\" + self.y.str() + \")\" }\n" +
    "}\n" +
    "impl Default for Point {\n" +
    "    fn default() -> Self { Self { x: 0, y: 0 } }\n" +
    "}\n\n" +
    "fn clone_any<T: Clone + Storable>(x: &T) -> T { x.clone() }\n" +
    "fn copy_any<T: Copy + Storable>(x: T) -> T { x }\n" +
    "fn check_display<T: Display + Storable>(x: &T) -> string { x.str() }\n" +
    "fn check_default<T: Default + Storable>() -> T { T::default() }\n" +
    "fn check_hash<T: Hash + Storable>(x: &T) -> u64 { x.hash() }\n" +
    "fn render<T: lib.Ordered + LocalShow>(x: T) -> string {\n" +
    "    x.describe() + \"#\" + x.rank().str() + \"=\" + x.show()\n" +
    "}\n" +
    "fn build_one<T>() -> T where T: lib.Factory + Sendable {\n" +
    "    T::make()\n" +
    "}\n" +
    "fn check_sendable<T>(move x: T) -> T where T: Sendable + Storable { x }\n" +
    "fn show_any<T: LocalShow>(x: T) -> string { x.show() }\n" +
    "fn borrow_any<T: BorrowLabel>(x: &T) -> &string from x { x.label() }\n" +
    "fn bump_any<T: Counter>(x: &mut T, by: i32) -> i32 { x.bump(by) }\n\n" +
    "fn main() {\n" +
    "    mut w := build_one<Widget>()\n" +
    "    assert(render<Widget>(w) == \"Widget(default)#10=default\")\n" +
    "    assert(borrow_any<Widget>(&w) == \"default\")\n" +
    "    assert(bump_any<Widget>(&mut w, 5) == 15)\n" +
    "    assert(w.tag() == 16)\n" +
    "    n := 7\n" +
    "    assert(show_any<i32>(n) == \"int:7\")\n" +
    "    imp := lib.ImportedItem { value: 9 }\n" +
    "    assert(show_any<lib.ImportedItem>(imp) == \"imp:9\")\n" +
    "    // Conditional conformance: Holder<i32> implements LocalShow, Holder<Widget> implements lib.Describe, Holder<Plain> compiles without either\n" +
    "    h1 := Holder<i32> { item: 5 }\n" +
    "    assert(show_any<Holder<i32>>(h1) == \"[int:5]\")\n" +
    "    hw := Holder<Widget> { item: Widget { name: \"ok\", weight: 1 } }\n" +
    "    assert(hw.describe() == \"Holder(Widget(ok))\")\n" +
    "    h2 := Holder<Plain> { item: Plain { x: 3 } }\n" +
    "    assert(h2.item.x == 3)\n" +
    "    // Sendable opaque struct from another module\n" +
    "    sb := check_sendable<lib.SecretBox>(lib.SecretBox::new(\"ok\", 4))\n" +
    "    assert(sb.summary() == \"ok:4\")\n" +
    "    // Map<string, i32> and Set<string> are conditionally Sendable; Map<string, Handle> still compiles for single-threaded use\n" +
    "    mut m := Map<string, i32>::new()\n" +
    "    m.put(\"a\", 42)\n" +
    "    m2 := check_sendable<Map<string, i32>>(move m)\n" +
    "    assert(m2.at(\"a\") == 42)\n" +
    "    mut s := Set<string>::new()\n" +
    "    _ := s.insert(\"hi\")\n" +
    "    s2 := check_sendable<Set<string>>(move s)\n" +
    "    assert(s2.contains(\"hi\"))\n" +
    "    mut handles := Map<string, Handle>::new()\n" +
    "    handles.put(\"fd\", Handle { fd: 1 })\n" +
    "    assert(handles.len() == 1)\n" +
    "    // Built-in Clone and Copy\n" +
    "    cloned_p := clone_any<Point>(&Point { x: 3, y: 4 })\n" +
    "    assert(cloned_p == Point { x: 3, y: 4 })\n" +
    "    assert(clone_any<string>(\"abc\") == \"abc\")\n" +
    "    assert(clone_any<[]i32>(&[1, 2]) == [1, 2])\n" +
    "    assert(copy_any<Point>(Point { x: 8, y: 9 }) == Point { x: 8, y: 9 })\n" +
    "    assert(copy_any<f64>(1.5) == 1.5)\n" +
    "    assert(check_display<f64>(&2.5) == \"2.5\")\n" +
    "    assert(check_default<f64>() == 0.0)\n" +
    "    // Default trait methods (inherited, overridden, generic Self: Clone)\n" +
    "    alice := Person { id: 1, name: \"Alice\" }\n" +
    "    assert(alice.greet() == \"hello Alice\")\n" +
    "    alice2 := alice.clone_greeting()\n" +
    "    assert(alice2.who() == \"Alice\" && alice.who() == \"Alice\")\n" +
    "    bob := Polite { name: \"Bob\" }\n" +
    "    assert(bob.greet() == \"greetings Bob\")\n" +
    "    // Core traits + operators (preserving non-Copy values via borrow)\n" +
    "    p0 := check_default<Point>()\n" +
    "    p1 := Point { x: 1, y: 2 }\n" +
    "    p2 := Point { x: 1, y: 3 }\n" +
    "    assert(p0 == Point { x: 0, y: 0 } && p1 != p2 && p1 < p2 && p1 <= p1 && p2 > p1 && p2 >= p2)\n" +
    "    assert(f\"{p1}\" == \"(1,2)\" && check_display<Point>(&p1) == \"(1,2)\")\n" +
    "    assert(check_hash<Point>(&p1) != check_hash<Point>(&p2))\n" +
    "    // Compound types: []T, (A, B), (A, B, C), nested, Map/Set keys, Result\n" +
    "    v1: []i32 = [1, 2]\n" +
    "    v2: []i32 = [1, 3]\n" +
    "    assert(v1 == [1, 2] && v1 != v2 && v1 < v2 && v1.len == 2)\n" +
    "    assert(v1.hash() != v2.hash() && v1.eq(&[1, 2]))\n" +
    "    nested1: [][]i32 = [[1], [2, 3]]\n" +
    "    nested2: [][]i32 = [[1], [2, 4]]\n" +
    "    assert(nested1 < nested2 && nested1 != nested2)\n" +
    "    t1: (i32, string) = (1, \"a\")\n" +
    "    t2: (i32, string) = (1, \"b\")\n" +
    "    assert(t1 < t2 && t1 != t2 && t1.1 == \"a\")\n" +
    "    t3: (i32, string, bool) = (1, \"a\", true)\n" +
    "    assert(t3 == (1, \"a\", true) && t3 != (1, \"a\", false))\n" +
    "    assert(check_default<(i32, string)>() == (0, \"\"))\n" +
    "    mut cmp_map := Map<[]i32, (string, i32)>::new()\n" +
    "    cmp_map.put([1, 2], (\"ok\", 5))\n" +
    "    assert(cmp_map.at([1, 2]) == (\"ok\", 5))\n" +
    "    mut cmp_map2 := Map<[]i32, (string, i32)>::new()\n" +
    "    cmp_map2.put([1, 2], (\"ok\", 5))\n" +
    "    assert(cmp_map == cmp_map2 && cmp_map.len() == 1)\n" +
    "    mut pair_set := Set<(i32, string)>::new()\n" +
    "    _ := pair_set.insert((1, \"one\"))\n" +
    "    _ := pair_set.insert((2, \"two\"))\n" +
    "    assert(pair_set.contains((1, \"one\")) && pair_set.len() == 2)\n" +
    "    r_ok: Result<Point, string> = .Ok(Point { x: 2, y: 3 })\n" +
    "    r_err: Result<Point, string> = .Err(\"bad\")\n" +
    "    r_unit: Result<Point, ()> = .Err\n" +
    "    r_unit_ok: Result<(), Point> = .Ok\n" +
    "    assert(r_ok.is_ok() && !r_ok.is_err() && r_err.is_err() && r_unit.is_err() && r_unit_ok.is_ok())\n" +
    "    assert(r_ok == .Ok(Point { x: 2, y: 3 }) && r_ok != r_err)\n" +
    "    assert(f\"{r_ok}\" == \"Ok((2,3))\" && f\"{r_err}\" == \"Err(bad)\")\n" +
    "    assert(r_err.clone().unwrap_or(Point { x: 9, y: 9 }) == Point { x: 9, y: 9 })\n" +
    "    assert(r_err.unwrap_or_default() == Point { x: 0, y: 0 })\n" +
    "    print(42)\n" +
    "}\n"
}

fn task_traits_program() -> string {
    "import .trait_lib as lib\n\n" +
    "fn echo<T: Sendable>(move x: T) -> T { x }\n" +
    "fn par_echo<T: Sendable>(move x: T) -> T {\n" +
    "    task scope s(1) {\n" +
    "        id := spawn s echo<T>(move x)\n" +
    "        await! s(id)\n" +
    "    }\n" +
    "}\n" +
    "fn inspect_box(b: lib.SecretBox) -> string { b.summary() }\n" +
    "fn lookup_map(key: string, table: &Map<string, []string>) -> Result<string, string> {\n" +
    "    if table.contains(key) {\n" +
    "        items := table.at(key)\n" +
    "        return .Ok(items[0].clone() + \"+\" + items[1].clone())\n" +
    "    }\n" +
    "    .Err(\"missing:\" + key)\n" +
    "}\n" +
    "fn merge_set(move s: Set<string>) -> Set<string> {\n" +
    "    mut out := s\n" +
    "    _ := out.insert(\"worker\")\n" +
    "    out\n" +
    "}\n" +
    "struct RichWork { cache: Map<string, i32>, last: Result<string, i32> }\n" +
    "fn make_rich() -> RichWork { RichWork { cache: Map<string, i32>::new(), last: .Err(0) } }\n" +
    "fn count_key(k: string, ws: &mut RichWork) -> i32 {\n" +
    "    mut next := 1\n" +
    "    if ws.cache.contains(k) { next = ws.cache.at(k) + 1 }\n" +
    "    ws.cache.put(k.clone(), next)\n" +
    "    ws.last = .Ok(k.clone())\n" +
    "    next\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut table := Map<string, []string>::new()\n" +
    "    table.put(\"k1\", [\"alpha\", \"one\"])\n" +
    "    table.put(\"k2\", [\"beta\", \"two\"])\n" +
    "    mut s := Set<string>::new()\n" +
    "    _ := s.insert(\"main\")\n" +
    "    print(par_echo<string>(\"generic-scope\"))\n" +
    "    task scope plain(4) {\n" +
    "        a := spawn plain echo<string>(\"hello\")\n" +
    "        b := spawn plain inspect_box(lib.SecretBox::new(\"box\", 7))\n" +
    "        e := spawn plain merge_set(move s)\n" +
    "        print(await! plain(a))\n" +
    "        print(await! plain(b))\n" +
    "        got := await! plain(e)\n" +
    "        assert(got.contains(\"main\") && got.contains(\"worker\") && got.len() == 2)\n" +
    "        print(got.len())\n" +
    "    }\n" +
    "    task scope jobs(4, shared table) {\n" +
    "        c := spawn jobs lookup_map(\"k1\")\n" +
    "        d := spawn jobs lookup_map(\"nope\")\n" +
    "        table.clear()\n" +
    "        match await! jobs(c) { .Ok(v) => { print(v) }, .Err(err) => { print(err) } }\n" +
    "        match await! jobs(d) { .Ok(v) => { print(v) }, .Err(err) => { print(err) } }\n" +
    "    }\n" +
    "    task scope stateful(1, make_rich) {\n" +
    "        r1 := spawn stateful count_key(\"hit\")\n" +
    "        r2 := spawn stateful count_key(\"hit\")\n" +
    "        assert(await stateful(r1) == 1 && await stateful(r2) == 2)\n" +
    "        print(\"ws-ok\")\n" +
    "    }\n" +
    "    assert(table.len() == 0)\n" +
    "}\n"
}

fn stdlib_traits_program() -> string {
    "capability network\n\n" +
    "import std.array as array\n" +
    "import std.cmp as cmp\n" +
    "import std.hash as hash\n" +
    "import std.json as json\n" +
    "import std.math as math\n" +
    "import std.net as net\n" +
    "import std.parse as parse\n" +
    "import std.sys as sys\n" +
    "import std.toml.tree as tree\n" +
    "import std.wire as wire\n\n" +
    "struct Item { name: string, score: i32 }\n" +
    "impl Display for Item {\n" +
    "    fn str(&self) -> string { self.name + \":\" + self.score.str() }\n" +
    "}\n" +
    "impl json.Encode for Item {\n" +
    "    fn encode_json(&self, out: &mut json.Writer) {\n" +
    "        out.object()\n" +
    "        json.field_value<string>(&mut out, \"name\", &self.name)\n" +
    "        json.field_value<i32>(&mut out, \"score\", &self.score)\n" +
    "        out.end()\n" +
    "    }\n" +
    "}\n" +
    "impl wire.Encode for Item {\n" +
    "    fn encode_wire(&self, out: &mut []u8) {\n" +
    "        wire.put_str(&mut out, self.name)\n" +
    "        wire.put_i32_le(&mut out, self.score)\n" +
    "    }\n" +
    "}\n" +
    "impl wire.Decode for Item {\n" +
    "    fn decode_wire(r: &mut wire.Reader, buf: &[]u8) -> Result<Self, i32> {\n" +
    "        name := r.read_str(&buf)\n" +
    "        if !r.ok { return .Err(r.error) }\n" +
    "        score := r.read_i32_le(&buf)\n" +
    "        if !r.ok { return .Err(r.error) }\n" +
    "        .Ok(Item { name: name, score: score })\n" +
    "    }\n" +
    "}\n" +
    "impl parse.FromStr for Item {\n" +
    "    fn from_str(text: string) -> Result<Self, string> {\n" +
    "        n := parse.value<i32>(text)\n" +
    "        match move n {\n" +
    "            .Ok(v) => { return .Ok(Item { name: \"n\", score: v }) },\n" +
    "            .Err(e) => { return .Err(e) },\n" +
    "        }\n" +
    "        .Err(\"unreachable\")\n" +
    "    }\n" +
    "}\n" +
    "fn take_sendable<T: Sendable>(move x: T) -> T { x }\n\n" +
    "fn main() {\n" +
    "    // std.cmp & std.array\n" +
    "    assert(cmp.min<i32>(2, 5) == 2 && cmp.max<string>(\"a\", \"z\") == \"z\")\n" +
    "    assert(cmp.clamp<i32>(99, 0, 10) == 10)\n" +
    "    assert(cmp.Reverse<i32>::new(1) > cmp.Reverse<i32>::new(2))\n" +
    "    mut nums: []i32 = [3, 1, 2, 2]\n" +
    "    array.sort<i32>(&mut nums)\n" +
    "    assert(nums == [1, 2, 2, 3] && array.is_sorted<i32>(&nums))\n" +
    "    assert(array.binary_search<i32>(&nums, 2).is_ok())\n" +
    "    assert(array.contains<i32>(&nums, 3) && array.index_of<i32>(&nums, 2).unwrap_or(-1) == 1)\n" +
    "    assert(array.min_index<i32>(&nums).unwrap_or(-1) == 0 && array.max_index<i32>(&nums).unwrap_or(-1) == 3)\n" +
    "    array.dedup<i32>(&mut nums)\n" +
    "    assert(nums == [1, 2, 3])\n" +
    "    array.reverse<i32>(&mut nums)\n" +
    "    assert(nums == [3, 2, 1] && array.join<i32>(&nums, \",\") == \"3,2,1\")\n" +
    "    mut xs: []f64 = [1.0, -0.0, 0.0, -2.5]\n" +
    "    array.sort_by<f64>(&mut xs, math.total_cmp_f64)\n" +
    "    assert(xs[0] == -2.5 && xs[3] == 1.0)\n" +
    "    // std.hash\n" +
    "    mut h1 := hash.Hasher::new(); h1.write_str(\"a\"); h1.write_i64(7)\n" +
    "    mut h2 := hash.Hasher::new(); h2.write_str(\"a\"); h2.write_i64(8)\n" +
    "    assert(h1.finish() != h2.finish() && hash.of<[]i32>(&nums) != 0)\n" +
    "    // std.json\n" +
    "    items: []Item = [Item { name: \"å\", score: 7 }]\n" +
    "    json_res := json.to_string<[]Item>(&items)\n" +
    "    assert(json_res.ok && json_res.value == \"[{\\\"name\\\":\\\"å\\\",\\\"score\\\":7}]\")\n" +
    "    mut w := json.Writer::default(); json.encode<Item>(&mut w, &items[0])\n" +
    "    w_res := w.finish()\n" +
    "    assert(w_res.ok && w_res.value == \"{\\\"name\\\":\\\"å\\\",\\\"score\\\":7}\")\n" +
    "    assert(json.Kind.Object == json.Kind.Object && f\"{json.Kind.Object}\" == \"Object\")\n" +
    "    // std.wire\n" +
    "    mut buf: []u8 = []\n" +
    "    wire.encode<[]Item>(&mut buf, &items)\n" +
    "    mut wr := wire.Reader::default()\n" +
    "    decoded := wire.decode<[]Item>(&mut wr, &buf)\n" +
    "    match move decoded {\n" +
    "        .Ok(got) => assert(got.len == 1 && got[0].name == \"å\" && got[0].score == 7 && wr.finish(&buf)),\n" +
    "        .Err(_) => assert(false),\n" +
    "    }\n" +
    "    // std.parse\n" +
    "    assert(parse.value<i32>(\"-42\") == .Ok(-42))\n" +
    "    parsed_item := parse.value<Item>(\"19\")\n" +
    "    assert(parsed_item.is_ok() && parsed_item.unwrap_or(Item { name: \"\", score: 0 }).score == 19)\n" +
    "    // std.sys, std.toml.tree, std.net\n" +
    "    assert(sys.IoError.NotFound == sys.IoError.NotFound && sys.IoError.NotFound.str().len > 0)\n" +
    "    assert(sys.FileKind.Directory == sys.FileKind.Directory && f\"{sys.FileKind.Directory}\" == \"Directory\")\n" +
    "    assert(sys.Status { ok: true, error: 0 } == sys.Status { ok: true, error: 0 })\n" +
    "    t := take_sendable<tree.Tree>(tree.Tree::default())\n" +
    "    assert(tree.render(&t).json == \"{}\")\n" +
    "    ip := net.IpAddr::parse(\"::1\").unwrap_or(net.IpAddr::unspecified_v6())\n" +
    "    sa := net.SocketAddr::parse(\"[::1]:8080\").unwrap_or(net.SocketAddr::any_v6(0))\n" +
    "    sa_sent := take_sendable<net.SocketAddr>(sa)\n" +
    "    assert(ip == net.IpAddr::localhost_v6() && ip.str() == \"::1\")\n" +
    "    assert(sa_sent == net.SocketAddr::loopback_v6(8080) && f\"{sa_sent}\" == \"[::1]:8080\")\n" +
    "    mut addr_map := Map<net.SocketAddr, i32>::new()\n" +
    "    addr_map.put(sa_sent, 7)\n" +
    "    mut ip_set := Set<net.IpAddr>::new()\n" +
    "    _ := ip_set.insert(ip)\n" +
    "    assert(addr_map.at(sa) == 7 && ip_set.contains(net.IpAddr::localhost_v6()))\n" +
    "    mut ps := net.PollSet::default()\n" +
    "    ps.clear()\n" +
    "    sset := net.StreamSet::default()\n" +
    "    assert(sset.len() == 0)\n" +
    "    // Display via print(value)\n" +
    "    print(Item { name: \"ok\", score: 9 })\n" +
    "}\n"
}

fn local_shadow_program() -> string {
    "struct Hash { tag: i32 }\n" +
    "fn main() {\n" +
    "    h := Hash { tag: 7 }\n" +
    "    mut m := Map<string, i32>::new()\n" +
    "    m.put(\"k\", h.tag)\n" +
    "    assert(m.at(\"k\") == 7)\n" +
    "    print(h.tag)\n" +
    "}\n"
}

fn invalid_cases() -> [](string, string) {
    [
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S {}\nfn main() {}", "missing trait method 'f'"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { fn f(&self) -> bool { true } }\nfn main() {}", "signature does not match"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { fn f(&self) -> i32 { 1 }\n fn extra(&self) {} }\nfn main() {}", "not a member of this trait"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { pub fn f(&self) -> i32 { 1 } }\nfn main() {}", "omit 'pub'"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { fn f(&self) -> i32 { 1 } }\nimpl T for S { fn f(&self) -> i32 { 2 } }\nfn main() {}", "duplicate implementation"),
        ("trait A {}\ntrait B: A {}\nstruct S {}\nimpl B for S {}\nfn main() {}", "requires supertrait"),
        ("trait A: B {}\ntrait B: A {}\nfn main() {}", "cyclic trait"),
        ("trait Bad { fn f(&self) -> MissingType }\nfn main() {}", "unknown type 'MissingType'"),
        ("trait BadDef { fn f(&self) -> i32 { true } }\nstruct S {}\nimpl BadDef for S {}\nfn main() {}", "type mismatch: expected i32, got bool"),
        ("trait T { pub fn f(&self) }\nfn main() {}", "cannot have 'pub'"),
        ("import .trait_lib as lib\nimpl lib.Describe for i32 { fn describe(&self) -> string { \"x\" } }\nfn main() {}", "cannot implement an imported trait"),
        ("import .trait_lib as lib\nimpl lib.Describe for lib.ImportedItem { fn describe(&self) -> string { \"x\" } }\nfn main() {}", "cannot implement an imported trait"),
        ("import .trait_lib as lib\nimpl Sendable for lib.Unclassified {}\nfn main() {}", "cannot implement built-in trait 'Sendable'"),
        ("impl Sendable for i32 {}\nfn main() {}", "cannot implement built-in trait 'Sendable'"),
        ("struct S { x: i32 }\nimpl Clone for S {}\nfn main() {}", "structural built-in trait and cannot be manually implemented"),
        ("struct S { x: i32 }\nimpl Copy for S {}\nfn main() {}", "structural built-in trait and cannot be manually implemented"),
        ("opaque struct BadOpaque { p: ptr }\nimpl Sendable for BadOpaque {}\nfn main() {}", "cannot implement Sendable"),
        ("@resource struct R { fd: i32 }\nimpl Sendable for R {}\nfn main() {}", "cannot implement Sendable"),
        ("struct S { x: i32 }\nimpl Sendable for S { fn f(&self) {} }\nfn main() {}", "marker trait and cannot contain methods"),
        ("trait Show { fn show(&self) -> string }\nfn f<T: Show>(x: T) -> string { x.show() }\nstruct No {}\nfn main() { _ := f<No>(No {}) }", "does not implement required trait"),
        ("trait Show { fn show(&self) -> string }\nstruct Holder<T> { item: T }\nimpl Show for Holder<T> where T: Show { fn show(&self) -> string { self.item.show() } }\nstruct No {}\nfn f<T: Show>(x: T) -> string { x.show() }\nfn main() { _ := f<Holder<No>>(Holder<No> { item: No {} }) }", "does not implement required trait"),
        ("@resource struct R { fd: i32 }\nfn f<T: Clone>(x: T) -> T { x.clone() }\nfn main() { _ := f<R>(R { fd: 1 }) }", "non-cloneable"),
        ("import std.net as net\nfn f<T: Clone>(x: &T) -> T { x.clone() }\nfn bad(u: &net.UdpSocket) -> net.UdpSocket { f<net.UdpSocket>(u) }\nfn main() {}", "non-cloneable"),
        ("import std.net as net\nfn f<T: Sendable>(move x: T) -> T { x }\nfn bad(move u: net.UdpSocket) -> net.UdpSocket { f<net.UdpSocket>(move u) }\nfn main() {}", "does not satisfy Sendable"),
        ("fn f<T: Copy>(x: T) -> T { x }\nfn main() { _ := f<string>(\"a\") }", "does not satisfy Copy"),
        ("fn f<T: Copy>(x: T) -> T { x }\nfn main() { _ := f<[]i32>([1]) }", "does not satisfy Copy"),
        ("fn need_eq<T: Eq>(a: T) -> bool { a == a }\nfn main() { _ := need_eq<f64>(1.0) }", "does not implement required trait 'Eq'"),
        ("fn need_ord<T: Ord>(a: T) -> bool { a < a }\nfn main() { _ := need_ord<f32>(1.0) }", "does not implement required trait 'Ord'"),
        ("fn need_hash<T: Hash>(a: T) -> u64 { a.hash() }\nfn main() { _ := need_hash<f64>(1.0) }", "does not implement required trait 'Hash'"),
        ("struct NoEq { x: i32 }\nfn main() { a := NoEq { x: 1 }; b := NoEq { x: 2 }; print(a == b) }", "does not implement Eq"),
        ("struct NoOrd { x: i32 }\nimpl Eq for NoOrd { fn eq(&self, other: &Self) -> bool { self.x == other.x } }\nfn main() { a := NoOrd { x: 1 }; b := NoOrd { x: 2 }; print(a < b) }", "does not implement Ord"),
        ("struct NoDisp { x: i32 }\nfn main() { print(NoDisp { x: 1 }) }", "print requires a scalar value or Display implementation"),
        ("@resource struct R { fd: i32 }\nfn f<T: Sendable>(move x: T) -> T { x }\nfn main() { _ := f<R>(R { fd: 1 }) }", "does not satisfy Sendable"),
        ("@resource struct R { fd: i32 }\nfn f<T: Sendable>(move x: T) -> T { x }\nfn main() { m := Map<string, R>::new(); _ := f<Map<string, R>>(move m) }", "does not satisfy Sendable"),
        ("import .trait_lib as lib\nfn f<T: Sendable>(move x: T) -> T { x }\nfn main() { _ := f<lib.Unclassified>(lib.Unclassified::new(1)) }", "does not satisfy Sendable"),
        ("fn f<T: Sendable>(x: T) -> T { x }\nfn main() { _ := f<&i32>(&1) }", "does not satisfy Sendable"),
        ("opaque struct BadGen<T> { p: ptr, v: T }\nimpl Sendable for BadGen<T> where T: Sendable {}\nfn main() { _ := BadGen<i32> { p: zeroed(ptr), v: 1 } }", "cannot implement Sendable"),
        ("trait Sendable {}\nfn main() {}", "reserved"),
        ("trait Clone {}\nfn main() {}", "reserved"),
        ("trait Copy {}\nfn main() {}", "reserved"),
    ]
}

fn identical_builds(compiler: string, source: string, work: string) -> bool {
    mut result := harness.empty_output()
    for target in harness.targets() {
        image := work + "/traits-" + target
        mut reference: []u8 = []
        for i in 0..3 {
            workers := if i == 0 { "1" } else { "4" }
            mut args: []string = ["build", source.clone(), "--target", target.clone(), "--jobs", workers, "-o", image.clone()]
            if i == 2 { args.push("--incremental") }
            if !harness.run_checked_timeout(compiler, args, work, 0, false, 120000, &mut result) { return false }
            data := sys.read_u8(image)
            if !data.ok { return false }
            if i == 0 { reference = data.value }
            else if !bytes.equal(&reference, &data.value) { return harness.fail("trait images differ for " + target) }
        }
    }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    if !sys.write_text(work + "/trait_lib.ddr", valid_library()).ok { return false }
    main_path := work + "/traits_main.ddr"
    if !sys.write_text(main_path, valid_program()).ok { return false }
    if !identical_builds(cli.compiler, main_path, work) { return false }
    if !harness.run_specialization_matrix(cli.compiler, main_path, work, "42\n") { return false }
    task_path := work + "/traits_task.ddr"
    if !sys.write_text(task_path, task_traits_program()).ok { return false }
    mut out := harness.empty_output()
    task_bin := work + "/traits_task_bin"
    if !harness.run_checked_timeout(cli.compiler, ["build", task_path.clone(), "-o", task_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(task_bin, [], work, 0, false, 60000, &mut out) { return false }
    expected := "generic-scope\nhello\nbox:7\n2\nalpha+one\nmissing:nope\nws-ok\n"
    if !harness.stdout_is(&out, expected, "task traits output") { return false }
    // Also verify cross-compilation of the task+traits program for Linux targets
    for target in ["arm64-linux", "x86_64-linux"] {
        if !harness.run_checked_timeout(cli.compiler, ["build", task_path.clone(), "--target", target.clone(), "-o", work + "/traits_task_" + target], work, 0, false, 60000, &mut out) {
            return false
        }
    }
    stdlib_path := work + "/traits_stdlib.ddr"
    if !sys.write_text(stdlib_path, stdlib_traits_program()).ok { return false }
    stdlib_bin := work + "/traits_stdlib_bin"
    if !harness.run_checked_timeout(cli.compiler, ["build", stdlib_path.clone(), "-o", stdlib_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(stdlib_bin, [], work, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "ok:9\n", "stdlib traits output") { return false }
    shadow_path := work + "/traits_shadow.ddr"
    if !sys.write_text(shadow_path, local_shadow_program()).ok { return false }
    shadow_bin := work + "/traits_shadow_bin"
    if !harness.run_checked_timeout(cli.compiler, ["build", shadow_path.clone(), "-o", shadow_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(shadow_bin, [], work, 0, false, 60000, &mut out) { return false }
    if !harness.stdout_is(&out, "7\n", "local shadow traits output") { return false }
    cases := invalid_cases()
    if !harness.check_rejected_specializations(cli.compiler, work, &cases) { return false }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-traits-")
    if !tmp.ok { return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if !run_suite(&cli, work) { return 1 }
    print("traits ok")
    0
}
