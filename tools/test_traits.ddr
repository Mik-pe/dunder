capability process, filesystem

import .harness as harness
import std.fs as fs
import std.bytes as bytes
import sys

fn valid_library() -> string {
    "pub trait Describe {\n" +
    "    fn describe(&self) -> string\n" +
    "}\n" +
    "pub trait Ordered: Describe {\n" +
    "    fn rank(&self) -> i32\n" +
    "}\n" +
    "pub trait Factory {\n" +
    "    fn make() -> Self\n" +
    "}\n" +
    "pub opaque struct SecretBox {\n" +
    "    label: string,\n" +
    "    count: i32,\n" +
    "}\n" +
    "impl SecretBox {\n" +
    "    pub fn new(move label: string, count: i32) -> Self { Self { label: label, count: count } }\n" +
    "    pub fn summary(&self) -> string { self.label + \":\" + self.count.str() }\n" +
    "}\n" +
    "impl Sendable for SecretBox {}\n" +
    "pub opaque struct Unclassified {\n" +
    "    n: i32,\n" +
    "}\n" +
    "impl Unclassified {\n" +
    "    pub fn new(n: i32) -> Self { Self { n: n } }\n" +
    "}\n" +
    "pub struct ImportedItem { value: i32 }\n"
}

fn valid_program() -> string {
    "import .trait_lib as lib\n\n" +
    "trait LocalShow {\n" +
    "    fn show(&self) -> string\n" +
    "}\n" +
    "trait BorrowLabel {\n" +
    "    fn label(&self) -> &string from self\n" +
    "}\n" +
    "trait Counter {\n" +
    "    fn bump(&mut self, by: i32) -> i32\n" +
    "}\n" +
    "trait Marker {}\n" +
    "trait Combined: lib.Describe + LocalShow {\n" +
    "    fn tag(&self) -> i32\n" +
    "}\n\n" +
    "struct Widget { name: string, weight: i32 }\n" +
    "impl lib.Describe for Widget {\n" +
    "    fn describe(&self) -> string { \"Widget(\" + self.name + \")\" }\n" +
    "}\n" +
    "impl lib.Ordered for Widget {\n" +
    "    fn rank(&self) -> i32 { self.weight }\n" +
    "}\n" +
    "impl lib.Factory for Widget {\n" +
    "    fn make() -> Self { Self { name: \"default\", weight: 10 } }\n" +
    "}\n" +
    "impl LocalShow for Widget {\n" +
    "    fn show(&self) -> string { self.name.clone() }\n" +
    "}\n" +
    "impl BorrowLabel for Widget {\n" +
    "    fn label(&self) -> &string from self { &self.name }\n" +
    "}\n" +
    "impl Counter for Widget {\n" +
    "    fn bump(&mut self, by: i32) -> i32 { self.weight = self.weight + by; self.weight }\n" +
    "}\n" +
    "impl Combined for Widget {\n" +
    "    fn tag(&self) -> i32 { self.weight + 1 }\n" +
    "}\n" +
    "impl Marker for Widget {}\n" +
    "impl Sendable for Widget {}\n\n" +
    "impl LocalShow for i32 {\n" +
    "    fn show(&self) -> string { \"int:\" + self.str() }\n" +
    "}\n" +
    "impl LocalShow for lib.ImportedItem {\n" +
    "    fn show(&self) -> string { \"imp:\" + self.value.str() }\n" +
    "}\n\n" +
    "struct Holder<T> { item: T }\n" +
    "impl LocalShow for Holder<T> where T: LocalShow {\n" +
    "    fn show(&self) -> string { \"[\" + self.item.show() + \"]\" }\n" +
    "}\n" +
    "impl lib.Describe for Holder<T> where T: lib.Describe {\n" +
    "    fn describe(&self) -> string { \"Holder(\" + self.item.describe() + \")\" }\n" +
    "}\n" +
    "struct Plain { x: i32 }\n\n" +
    "@resource struct Handle { fd: i32 }\n\n" +
    "fn render<T: lib.Ordered + LocalShow>(x: T) -> string {\n" +
    "    x.describe() + \"#\" + x.rank().str() + \"=\" + x.show()\n" +
    "}\n" +
    "fn build_one<T>() -> T where T: lib.Factory + Sendable {\n" +
    "    T::make()\n" +
    "}\n" +
    "fn check_sendable<T>(move x: T) -> T where T: Sendable + Storable { x }\n" +
    "fn show_any<T: LocalShow>(x: T) -> string { x.show() }\n" +
    "fn borrow_any<T: BorrowLabel>(x: &T) -> &string from x { x.label() }\n" +
    "fn bump_any<T: Counter>(x: &mut T, by: i32) -> i32 { x.bump(by) }\n\n" +
    "fn main() {\n" +
    "    mut w := build_one<Widget>()\n" +
    "    assert(render<Widget>(w) == \"Widget(default)#10=default\")\n" +
    "    assert(borrow_any<Widget>(&w) == \"default\")\n" +
    "    assert(bump_any<Widget>(&mut w, 5) == 15)\n" +
    "    assert(w.tag() == 16)\n" +
    "    n := 7\n" +
    "    assert(show_any<i32>(n) == \"int:7\")\n" +
    "    imp := lib.ImportedItem { value: 9 }\n" +
    "    assert(show_any<lib.ImportedItem>(imp) == \"imp:9\")\n" +
    "    // Conditional conformance: Holder<i32> implements LocalShow, Holder<Widget> implements lib.Describe, Holder<Plain> compiles without either\n" +
    "    h1 := Holder<i32> { item: 5 }\n" +
    "    assert(show_any<Holder<i32>>(h1) == \"[int:5]\")\n" +
    "    hw := Holder<Widget> { item: Widget { name: \"ok\", weight: 1 } }\n" +
    "    assert(hw.describe() == \"Holder(Widget(ok))\")\n" +
    "    h2 := Holder<Plain> { item: Plain { x: 3 } }\n" +
    "    assert(h2.item.x == 3)\n" +
    "    // Sendable opaque struct from another module\n" +
    "    sb := check_sendable<lib.SecretBox>(lib.SecretBox::new(\"ok\", 4))\n" +
    "    assert(sb.summary() == \"ok:4\")\n" +
    "    // Map<string, i32> and Set<string> are conditionally Sendable; Map<string, Handle> still compiles for single-threaded use\n" +
    "    mut m := Map<string, i32>::new()\n" +
    "    m.put(\"a\", 42)\n" +
    "    m2 := check_sendable<Map<string, i32>>(move m)\n" +
    "    assert(m2.at(\"a\") == 42)\n" +
    "    mut s := Set<string>::new()\n" +
    "    _ := s.insert(\"hi\")\n" +
    "    s2 := check_sendable<Set<string>>(move s)\n" +
    "    assert(s2.contains(\"hi\"))\n" +
    "    mut handles := Map<string, Handle>::new()\n" +
    "    handles.put(\"fd\", Handle { fd: 1 })\n" +
    "    assert(handles.len() == 1)\n" +
    "    print(42)\n" +
    "}\n"
}

fn task_traits_program() -> string {
    "import .trait_lib as lib\n\n" +
    "fn echo<T: Sendable>(move x: T) -> T { x }\n" +
    "fn par_echo<T: Sendable>(move x: T) -> T {\n" +
    "    task scope s(1) {\n" +
    "        id := spawn s echo<T>(move x)\n" +
    "        await! s(id)\n" +
    "    }\n" +
    "}\n" +
    "fn inspect_box(b: lib.SecretBox) -> string { b.summary() }\n" +
    "fn lookup_map(key: string, table: &Map<string, []string>) -> Result<string, string> {\n" +
    "    if table.contains(key) {\n" +
    "        items := table.at(key)\n" +
    "        return .Ok(items[0].clone() + \"+\" + items[1].clone())\n" +
    "    }\n" +
    "    .Err(\"missing:\" + key)\n" +
    "}\n" +
    "fn merge_set(move s: Set<string>) -> Set<string> {\n" +
    "    mut out := s\n" +
    "    _ := out.insert(\"worker\")\n" +
    "    out\n" +
    "}\n" +
    "struct RichWork { cache: Map<string, i32>, last: Result<string, i32> }\n" +
    "fn make_rich() -> RichWork { RichWork { cache: Map<string, i32>::new(), last: .Err(0) } }\n" +
    "fn count_key(k: string, ws: &mut RichWork) -> i32 {\n" +
    "    mut next := 1\n" +
    "    if ws.cache.contains(k) { next = ws.cache.at(k) + 1 }\n" +
    "    ws.cache.put(k.clone(), next)\n" +
    "    ws.last = .Ok(k.clone())\n" +
    "    next\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut table := Map<string, []string>::new()\n" +
    "    table.put(\"k1\", [\"alpha\", \"one\"])\n" +
    "    table.put(\"k2\", [\"beta\", \"two\"])\n" +
    "    mut s := Set<string>::new()\n" +
    "    _ := s.insert(\"main\")\n" +
    "    print(par_echo<string>(\"generic-scope\"))\n" +
    "    task scope plain(4) {\n" +
    "        a := spawn plain echo<string>(\"hello\")\n" +
    "        b := spawn plain inspect_box(lib.SecretBox::new(\"box\", 7))\n" +
    "        e := spawn plain merge_set(move s)\n" +
    "        print(await! plain(a))\n" +
    "        print(await! plain(b))\n" +
    "        got := await! plain(e)\n" +
    "        assert(got.contains(\"main\") && got.contains(\"worker\") && got.len() == 2)\n" +
    "        print(got.len())\n" +
    "    }\n" +
    "    task scope jobs(4, shared table) {\n" +
    "        c := spawn jobs lookup_map(\"k1\")\n" +
    "        d := spawn jobs lookup_map(\"nope\")\n" +
    "        table.clear()\n" +
    "        match await! jobs(c) { .Ok(v) => { print(v) }, .Err(err) => { print(err) } }\n" +
    "        match await! jobs(d) { .Ok(v) => { print(v) }, .Err(err) => { print(err) } }\n" +
    "    }\n" +
    "    task scope stateful(1, make_rich) {\n" +
    "        r1 := spawn stateful count_key(\"hit\")\n" +
    "        r2 := spawn stateful count_key(\"hit\")\n" +
    "        assert(await stateful(r1) == 1 && await stateful(r2) == 2)\n" +
    "        print(\"ws-ok\")\n" +
    "    }\n" +
    "    assert(table.len() == 0)\n" +
    "}\n"
}

fn invalid_cases() -> [](string, string) {
    [
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S {}\nfn main() {}", "missing trait method 'f'"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { fn f(&self) -> bool { true } }\nfn main() {}", "signature does not match"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { fn f(&self) -> i32 { 1 }\n fn extra(&self) {} }\nfn main() {}", "not a member of this trait"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { pub fn f(&self) -> i32 { 1 } }\nfn main() {}", "omit 'pub'"),
        ("trait T { fn f(&self) -> i32 }\nstruct S {}\nimpl T for S { fn f(&self) -> i32 { 1 } }\nimpl T for S { fn f(&self) -> i32 { 2 } }\nfn main() {}", "duplicate implementation"),
        ("trait A {}\ntrait B: A {}\nstruct S {}\nimpl B for S {}\nfn main() {}", "requires supertrait"),
        ("trait A: B {}\ntrait B: A {}\nfn main() {}", "cyclic trait"),
        ("trait Bad { fn f(&self) -> MissingType }\nfn main() {}", "unknown type 'MissingType'"),
        ("trait T { fn f(&self) -> i32 { 1 } }\nfn main() {}", "cannot have a body"),
        ("trait T { pub fn f(&self) }\nfn main() {}", "cannot have 'pub'"),
        ("import .trait_lib as lib\nimpl lib.Describe for i32 { fn describe(&self) -> string { \"x\" } }\nfn main() {}", "cannot implement an imported trait"),
        ("import .trait_lib as lib\nimpl lib.Describe for lib.ImportedItem { fn describe(&self) -> string { \"x\" } }\nfn main() {}", "cannot implement an imported trait"),
        ("import .trait_lib as lib\nimpl Sendable for lib.Unclassified {}\nfn main() {}", "cannot implement built-in trait 'Sendable'"),
        ("impl Sendable for i32 {}\nfn main() {}", "cannot implement built-in trait 'Sendable'"),
        ("opaque struct BadOpaque { p: ptr }\nimpl Sendable for BadOpaque {}\nfn main() {}", "cannot implement Sendable"),
        ("@resource struct R { fd: i32 }\nimpl Sendable for R {}\nfn main() {}", "cannot implement Sendable"),
        ("struct S { x: i32 }\nimpl Sendable for S { fn f(&self) {} }\nfn main() {}", "marker trait and cannot contain methods"),
        ("trait Show { fn show(&self) -> string }\nfn f<T: Show>(x: T) -> string { x.show() }\nstruct No {}\nfn main() { _ := f<No>(No {}) }", "does not implement required trait"),
        ("trait Show { fn show(&self) -> string }\nstruct Holder<T> { item: T }\nimpl Show for Holder<T> where T: Show { fn show(&self) -> string { self.item.show() } }\nstruct No {}\nfn f<T: Show>(x: T) -> string { x.show() }\nfn main() { _ := f<Holder<No>>(Holder<No> { item: No {} }) }", "does not implement required trait"),
        ("@resource struct R { fd: i32 }\nfn f<T: Sendable>(move x: T) -> T { x }\nfn main() { _ := f<R>(R { fd: 1 }) }", "does not satisfy Sendable"),
        ("@resource struct R { fd: i32 }\nfn f<T: Sendable>(move x: T) -> T { x }\nfn main() { m := Map<string, R>::new(); _ := f<Map<string, R>>(move m) }", "does not satisfy Sendable"),
        ("import .trait_lib as lib\nfn f<T: Sendable>(move x: T) -> T { x }\nfn main() { _ := f<lib.Unclassified>(lib.Unclassified::new(1)) }", "does not satisfy Sendable"),
        ("fn f<T: Sendable>(x: T) -> T { x }\nfn main() { _ := f<&i32>(&1) }", "does not satisfy Sendable"),
        ("opaque struct BadGen<T> { p: ptr, v: T }\nimpl Sendable for BadGen<T> where T: Sendable {}\nfn main() { _ := BadGen<i32> { p: zeroed(ptr), v: 1 } }", "cannot implement Sendable"),
        ("trait Sendable {}\nfn main() {}", "reserved"),
    ]
}

fn identical_builds(compiler: string, source: string, work: string) -> bool {
    mut result := harness.empty_output()
    for target in harness.targets() {
        image := work + "/traits-" + target
        mut reference: []u8 = []
        for i in 0..3 {
            workers := if i == 0 { "1" } else { "4" }
            mut args: []string = ["build", source.clone(), "--target", target.clone(), "--jobs", workers, "-o", image.clone()]
            if i == 2 { args.push("--incremental") }
            if !harness.run_checked_timeout(compiler, args, work, 0, false, 120000, &mut result) { return false }
            data := sys.read_u8(image)
            if !data.ok { return false }
            if i == 0 { reference = data.value }
            else if !bytes.equal(&reference, &data.value) { return harness.fail("trait images differ for " + target) }
        }
    }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    if !sys.write_text(work + "/trait_lib.ddr", valid_library()).ok { return false }
    main_path := work + "/traits_main.ddr"
    if !sys.write_text(main_path, valid_program()).ok { return false }
    if !identical_builds(cli.compiler, main_path, work) { return false }
    if !harness.run_specialization_matrix(cli.compiler, main_path, work, "42\n") { return false }
    task_path := work + "/traits_task.ddr"
    if !sys.write_text(task_path, task_traits_program()).ok { return false }
    mut out := harness.empty_output()
    task_bin := work + "/traits_task_bin"
    if !harness.run_checked_timeout(cli.compiler, ["build", task_path.clone(), "-o", task_bin.clone()], work, 0, false, 60000, &mut out) { return false }
    if !harness.run_checked_timeout(task_bin, [], work, 0, false, 60000, &mut out) { return false }
    expected := "generic-scope\nhello\nbox:7\n2\nalpha+one\nmissing:nope\nws-ok\n"
    if !harness.stdout_is(&out, expected, "task traits output") { return false }
    // Also verify cross-compilation of the task+traits program for Linux targets
    for target in ["arm64-linux", "x86_64-linux"] {
        if !harness.run_checked_timeout(cli.compiler, ["build", task_path.clone(), "--target", target.clone(), "-o", work + "/traits_task_" + target], work, 0, false, 60000, &mut out) {
            return false
        }
    }
    cases := invalid_cases()
    if !harness.check_rejected_specializations(cli.compiler, work, &cases) { return false }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-traits-")
    if !tmp.ok { return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if !run_suite(&cli, work) { return 1 }
    print("traits ok")
    0
}
