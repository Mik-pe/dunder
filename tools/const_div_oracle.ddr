import .mir_oracle as bits

struct Wide {
    high: u64,
    low: u64,
}

pub struct Plan {
    kind: i64,
    magic: i64,
    shift: i32,
    add: bool,
    negative: bool,
}

pub fn minimum(width: i32) -> i64 {
    if width == 64 { return -9223372036854775808 }
    -i64(1).shl(width - 1)
}

pub fn maximum(width: i32) -> i64 { -(minimum(width) + 1) }

fn magnitude(n: i64) -> u64 {
    if n < 0 { return u64(0).wrapping_sub(bits.bits(n)) }
    u64(n)
}

fn signed_magnitude(n: u64, negative: bool) -> i64 {
    bits.signed(if negative { u64(0).wrapping_sub(n) } else { n }, 64)
}

pub fn quotient(n: i64, divisor: i64, width: i32) -> i64 {
    numerator := magnitude(n)
    denominator := magnitude(divisor)
    mut remainder: u64 = 0
    mut result: u64 = 0
    for step in 0..width {
        shift := width - step - 1
        remainder = remainder.shl(1).bit_or(numerator.shr(shift).bit_and(1))
        if remainder >= denominator {
            remainder -= denominator
            result = result.bit_or(u64(1).shl(shift))
        }
    }
    signed_magnitude(result, (n < 0) != (divisor < 0))
}

fn product(a: u64, b: u64) -> Wide {
    mask: u64 = 0xffffffff
    a_lower := a.bit_and(mask)
    b_lower := b.bit_and(mask)
    a_upper := a.shr(32)
    b_upper := b.shr(32)
    lower := a_lower * b_lower
    left := a_upper * b_lower + lower.shr(32)
    right := a_lower * b_upper + left.bit_and(mask)
    Wide { high: a_upper * b_upper + left.shr(32) + right.shr(32), low: right.shl(32).bit_or(lower.bit_and(mask)) }
}

fn power(bit: i32) -> Wide {
    if bit >= 64 { return Wide { high: u64(1).shl(bit - 64), low: 0 } }
    Wide { high: 0, low: u64(1).shl(bit) }
}

fn less(a: &Wide, b: &Wide) -> bool { a.high < b.high || (a.high == b.high && a.low < b.low) }

fn subtract(a: &Wide, b: &Wide) -> Wide {
    borrow: u64 = if a.low < b.low { 1 } else { 0 }
    Wide { high: a.high - b.high - borrow, low: a.low.wrapping_sub(b.low) }
}

fn width_mask(width: i32) -> u64 {
    if width == 64 { return u64(0).bit_not() }
    u64(1).shl(width) - 1
}

pub fn certificate(plan: &Plan, divisor: i64, width: i32) -> bool {
    low := minimum(width)
    high := maximum(width)
    if plan.magic < low || plan.magic > high || plan.shift < 0 || plan.shift >= width ||
       plan.negative != (divisor < 0) { return false }
    absolute := magnitude(divisor)
    expected := if divisor == 0 { 1 } else if absolute == 1 { 2 } else if divisor == low { 4 }
                else if absolute.bit_and(absolute - 1) == 0 { 3 } else { 5 }
    if plan.kind != i64(expected) { return false }
    if plan.kind == 3 { return absolute == u64(1).shl(plan.shift) }
    if plan.kind != 5 { return true }
    multiplier := bits.bits(plan.magic).bit_and(width_mask(width))
    if plan.add != (plan.magic < 0) || multiplier == 0 { return false }
    multiplied := product(multiplier, absolute)
    reference := power(width + plan.shift)
    if !less(&reference, &multiplied) { return false }
    error := subtract(&multiplied, &reference)
    limit := power(plan.shift + 1)
    !less(&limit, &error)
}

fn asr(value: i64, shift: i32) -> i64 {
    if shift == 0 { return value }
    mut shifted := bits.bits(value).shr(shift)
    if value < 0 { shifted = shifted.bit_or(u64(0).bit_not().shl(64 - shift)) }
    bits.signed(shifted, 64)
}

fn signed_product_hi(a: i64, b: i64, width: i32) -> i64 {
    if width < 64 { return asr(a * b, width) }
    aa := bits.bits(a)
    bb := bits.bits(b)
    mut upper := product(aa, bb).high
    if a < 0 { upper = upper.wrapping_sub(bb) }
    if b < 0 { upper = upper.wrapping_sub(aa) }
    bits.signed(upper, 64)
}

fn evaluate(plan: &Plan, n: i64, divisor: i64, width: i32) -> i64 {
    if divisor == 0 { return 102 }
    low := minimum(width)
    if n == low && divisor == -1 { return 101 }
    if plan.kind == 2 { return if plan.negative { -n } else { n } }
    if plan.kind == 4 { return if n == low { 1 } else { 0 } }
    mut result: i64 = 0
    if plan.kind == 3 {
        bias := if n < 0 { i64(u64(1).shl(plan.shift) - 1) } else { i64(0) }
        result = asr(n + bias, plan.shift)
    } else {
        upper := signed_product_hi(n, plan.magic, width)
        base := if plan.add { bits.signed(bits.bits(upper.wrapping_add(n)), width) } else { upper }
        result = asr(base, plan.shift)
        if n < 0 { result += 1 }
    }
    if plan.negative { -result } else { result }
}

pub fn conforms(plan: &Plan, numerator: i64, divisor: i64, width: i32) -> bool {
    observed := evaluate(&plan, numerator, divisor, width)
    if divisor == 0 { return observed == 102 }
    low := minimum(width)
    if numerator == low && divisor == -1 { return observed == 101 }
    expected := quotient(numerator, divisor, width)
    if observed != expected || observed < low || observed > maximum(width) { return false }
    remainder := numerator - observed * divisor
    magnitude(remainder) < magnitude(divisor) && (remainder == 0 || (remainder < 0) == (numerator < 0))
}
