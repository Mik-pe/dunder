capability process, filesystem

import .harness as harness
import std.fs as fs
import std.parse as parse
import std.process as process
import sys

fn is_ws(b: i32) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

fn split_ws(s: string) -> []string {
    var out: []string = []
    var i := 0
    while i < s.len {
        while i < s.len && is_ws(s[i]) { i += 1 }
        if i >= s.len { break }
        start := i
        while i < s.len && !is_ws(s[i]) { i += 1 }
        out.push(s[start..i])
    }
    out
}

fn strings_equal(a: &[]string, b: &[]string) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len {
        if a[i] != b[i] { return false }
    }
    true
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    host := harness.host_id()
    emitter := work + "/emitter"
    var res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", cli.root + "/tests/fixtures/mir-memory-emitter.ddr", "-o", emitter], work, 0, false, &mut res) {
        return false
    }
    policies := ["legacy", "raw", "source"]
    for selected in 0..8 {
        source_active := selected != 3 && selected != 4
        for target in 0..3 {
            var img_legacy: []u8 = []
            var img_raw: []u8 = []
            var img_source: []u8 = []
            var cnt_legacy: []string = []
            var cnt_raw: []string = []

            for p_idx in 0..policies.len {
                policy := policies[p_idx]
                image := work + "/" + selected.str() + "-" + target.str() + "-" + policy
                if !harness.run_checked(emitter, [image, target.str(), selected.str(), policy], work, 0, false, &mut res) {
                    return false
                }
                lines := split_ws(process.stdout_text(&res))
                if lines.len != 6 {
                    return harness.fail("expected 6 tokens from mir-memory-emitter, got " + lines.len.str())
                }
                ready := lines[0] == "true"
                p_homes := parse.integer(lines[1])
                p_skipped := parse.integer(lines[2])
                p_frame := parse.integer(lines[3])
                p_obj := parse.integer(lines[4])
                p_sync := parse.integer(lines[5])
                if !p_homes.ok || !p_skipped.ok || !p_frame.ok || !p_obj.ok || !p_sync.ok {
                    return harness.fail("invalid integer counter in mir-memory-emitter output")
                }
                homes := p_homes.value
                skipped := p_skipped.value
                frame_ops := p_frame.value
                object_ops := p_obj.value
                synchronized := p_sync.value

                if object_ops != 2 {
                    return harness.fail("expected object_ops == 2, got " + object_ops.str())
                }
                if policy == "source" && source_active {
                    if !ready || homes <= 0 || skipped != 2 {
                        return harness.fail("source policy expected ready && homes > 0 && skipped == 2")
                    }
                    if (selected == 0 || selected == 2 || selected == 6 || selected == 7) && frame_ops != 0 {
                        return harness.fail("expected frame_ops == 0 for selected=" + selected.str())
                    }
                    if selected == 5 && (homes != 2 || frame_ops <= 0) {
                        return harness.fail("expected homes == 2 && frame_ops > 0 for selected=5")
                    }
                    if (selected == 1 || selected == 2) && synchronized != 1 {
                        return harness.fail("expected synchronized == 1 for selected=" + selected.str())
                    }
                } else {
                    if ready || homes != 0 || skipped != 0 || synchronized != 0 || frame_ops <= 0 {
                        return harness.fail("fallback policy expected !ready && zero homes/skipped/synchronized && frame_ops > 0")
                    }
                }

                raw_img := sys.read_u8(image)
                if !raw_img.ok {
                    return harness.fail("failed to read emitted image: " + image)
                }
                if p_idx == 0 {
                    img_legacy = raw_img.value
                    cnt_legacy = lines
                } else if p_idx == 1 {
                    img_raw = raw_img.value
                    cnt_raw = lines
                } else {
                    img_source = raw_img.value
                }

                if target == host {
                    if !harness.run_checked(image, [], work, 0, false, &mut res) {
                        return false
                    }
                }
            }

            if !harness.bytes_equal(&img_legacy, &img_raw) || !strings_equal(&cnt_legacy, &cnt_raw) {
                return harness.fail("legacy vs raw mismatch for selected=" + selected.str() + " target=" + target.str())
            }
            diff_source_raw := !harness.bytes_equal(&img_source, &img_raw)
            if diff_source_raw != source_active {
                return harness.fail("unexpected source vs raw equality for selected=" + selected.str() + " target=" + target.str())
            }
        }
        print("PASS " + selected.str() + " native targets; host executed; raw identity, object reads/writes, calls and homes")
    }
    print("72 private-memory images verified; no timing series")
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected extra argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-mir-memory-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    work := tmp.value
    ok := run_in_work(&cli, work)
    _ := fs.remove_all(work)
    ok
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok {
        _ := sys.eprint(cli.error)
        return 2
    }
    if !run_suite(&cli) {
        return 1
    }
    0
}
