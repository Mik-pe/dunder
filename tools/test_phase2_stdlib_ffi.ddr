capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.process as process
import std.text as text
import sys

fn check_invalid_cases(compiler: string, work: string) -> bool {
    cases: [](string, string) = [
        // @extern map / platform attribute validation
        ("capability unsafe\n@extern(\"bogus_target\", \"c\", \"abs\") unsafe fn f(x: i32) -> i32\nfn main() {}", "unknown @extern target 'bogus_target'"),
        ("capability unsafe\n@extern(symbol = \"abs\", bogus_target = \"c\") unsafe fn f(x: i32) -> i32\nfn main() {}", "unknown @extern target 'bogus_target'"),
        ("capability unsafe\n@extern(\"macos\", \"c\", \"abs\") @extern(\"linux\", \"c\", \"abs\") unsafe fn f(x: i32) -> i32\n@extern(\"macos\", \"c\", \"abs\") unsafe fn g(x: i32) -> i32\nfn main() {}", "ok"),
        ("capability unsafe\n@extern(\"native\", \"c\", \"abs\")\n@extern(\"native\", \"c\", \"labs\")\nunsafe fn f(x: i32) -> i32\nfn main() {}", "duplicate @extern binding for this target"),
        ("capability unsafe\n@extern(symbol = \"abs\", native = \"c\", native = \"c\") unsafe fn f(x: i32) -> i32\nfn main() {}", "duplicate @extern binding for this target"),
        ("capability unsafe\n@extern(symbol = \"abs\", default = \"c\", default = \"c\") unsafe fn f(x: i32) -> i32\nfn main() {}", "duplicate 'default' in @extern"),
        ("capability unsafe\n@extern(macos = \"c\") unsafe fn f(x: i32) -> i32\nfn main() {}", "@extern map requires 'symbol'"),
        // sys capability enforcement
        ("import sys\nfn main() { _ := sys.read_text(\"a\") }", "requires capability filesystem"),
        ("import sys\nfn main() { _ := sys.metadata(\"a\") }", "requires capability filesystem"),
        ("import sys\nfn main() { _ := sys.write_text(\"a\", \"b\") }", "requires capability filesystem"),
        ("import sys\nfn main() { _ := sys.read(\"a\") }", "requires capability filesystem"),
        ("import sys\nfn main() { _ := sys.write(\"a\", \"b\") }", "requires capability filesystem"),
        ("import sys\nfn main() { _ := sys.read_bytes(\"a\") }", "requires capability filesystem"),
        ("import sys\nfn main() { d: []u8 = []\n_ := sys.write_bytes(\"a\", &d) }", "requires capability filesystem"),
        ("import sys\nfn main() { _ := sys.eprint(\"hi\") }", "requires capability stdio"),
        ("import sys\nfn main() { _ := sys.write_stderr(\"hi\") }", "requires capability stdio"),
    ]
    mut reject_cases: [](string, string) = []
    for i in 0..cases.len {
        if cases[i].1 != "ok" { reject_cases.push(cases[i].clone()) }
    }
    if !harness.check_rejected_specializations(compiler, work, &reject_cases) { return false }

    // Calling unavailable @extern binding rejected per target
    only_mac := work + "/only_mac.ddr"
    only_lin := work + "/only_linux.ddr"
    if !sys.write_text(only_mac, "capability unsafe\n@extern(\"macos\", \"c\", \"abs\") unsafe fn only_mac(x: i32) -> i32\nfn main() { unsafe { _ := only_mac(-1) } }\n").ok ||
       !sys.write_text(only_lin, "capability unsafe\n@extern(\"linux\", \"c\", \"abs\") unsafe fn only_linux(x: i32) -> i32\nfn main() { unsafe { _ := only_linux(-1) } }\n").ok {
        return harness.fail("cannot write unavailable @extern fixtures")
    }
    mut res := harness.empty_output()
    if !harness.run_checked_timeout(compiler, ["check", only_mac.clone(), "--target", "arm64-linux", "--agent"], work, 1, false, 60000, &mut res) {
        return false
    }
    if harness.agent_error_message(res.stdout_text(), only_mac, "has no @extern binding for this target", "").len == 0 {
        return false
    }
    if !harness.run_checked_timeout(compiler, ["check", only_lin.clone(), "--target", "arm64-macos", "--agent"], work, 1, false, 60000, &mut res) {
        return false
    }
    if harness.agent_error_message(res.stdout_text(), only_lin, "has no @extern binding for this target", "").len == 0 {
        return false
    }
    true
}

fn check_portable_matrix(compiler: string, work: string) -> bool {
    code := "import std.array as array\n" +
        "import std.bytes as bytes\n" +
        "import std.sha256 as sha256\n" +
        "import std.text as text\n" +
        "import std.Map\n" +
        "import std.Set\n" +
        "import sys\n\n" +
        "fn get_or_panic(flag: bool) -> i32 {\n" +
        "    if flag { 42 } else { panic(\"diverged\") }\n" +
        "}\n\n" +
        "fn opt_chain(a: Option<i32>, b: Option<i32>) -> Option<i32> {\n" +
        "    x := a?\n" +
        "    y := b?\n" +
        "    .Some(x + y)\n" +
        "}\n\n" +
        "fn res_chain(move a: Result<i32, string>, move b: Result<i32, string>) -> Result<i32, string> {\n" +
        "    x := a?\n" +
        "    y := b?\n" +
        "    .Ok(x * y)\n" +
        "}\n\n" +
        "fn mk_ok(v: i32) -> Result<i32, string> { .Ok(v) }\n" +
        "fn mk_err(move s: string) -> Result<i32, string> { .Err(s) }\n\n" +
        "fn inc_mut(v: &mut i32) { v = v + 10 }\n" +
        "fn bump_vec(v: &mut []i32) { v.push(99) }\n" +
        "fn mk_vec() -> []i32 { [7, 8] }\n\n" +
        "fn main() {\n" +
        "    // 1. panic diverging\n" +
        "    assert(get_or_panic(true) == 42)\n" +
        "    // 2. Option<T> combinators, traits, and ?\n" +
        "    o1: Option<i32> = .Some(20)\n" +
        "    o2: Option<i32> = .Some(22)\n" +
        "    none_opt: Option<i32> = .None\n" +
        "    assert(o1.is_some() && !o1.is_none() && none_opt.is_none())\n" +
        "    assert(opt_chain(o1, o2) == .Some(42))\n" +
        "    assert(opt_chain(o1, none_opt) == .None)\n" +
        "    assert(none_opt.unwrap_or(9) == 9)\n" +
        "    assert(none_opt.unwrap_or_else(fn() -> i32 { 11 }) == 11)\n" +
        "    assert(none_opt.unwrap_or_default() == 0)\n" +
        "    assert(o1.unwrap() == 20)\n" +
        "    assert(o2.expect(\"present\") == 22)\n" +
        "    assert(o1.map(fn(move x: i32) -> i32 { x + 1 }) == .Some(21))\n" +
        "    assert(o1.and_then(fn(move x: i32) -> Option<string> { .Some(x.str()) }) == .Some(\"20\"))\n" +
        "    assert(o1.ok_or(\"err\") == .Ok(20))\n" +
        "    assert(none_opt.ok_or_else(fn() -> string { \"lazy\" }) == .Err(\"lazy\"))\n" +
        "    assert(o1 < o2 && o1.str() == \"Some(20)\" && none_opt.str() == \"None\" && Option<i32>::default() == .None)\n" +
        "    assert(o1.hash() != none_opt.hash())\n" +
        "    // 3. Result<T, E> combinators and ?\n" +
        "    assert(res_chain(mk_ok(6), mk_ok(7)) == .Ok(42))\n" +
        "    assert(res_chain(mk_ok(6), mk_err(\"bad\")) == .Err(\"bad\"))\n" +
        "    assert(mk_ok(6).unwrap() == 6 && mk_err(\"bad\").unwrap_err() == \"bad\")\n" +
        "    assert(mk_ok(7).expect(\"ok\") == 7)\n" +
        "    assert(mk_ok(6).map(fn(move x: i32) -> i32 { x + 2 }) == .Ok(8))\n" +
        "    assert(mk_err(\"bad\").map_err(fn(move e: string) -> i32 { e.len }) == .Err(3))\n" +
        "    assert(mk_ok(6).and_then(fn(move x: i32) -> Result<i32, string> { .Ok(x * 2) }) == .Ok(12))\n" +
        "    assert(mk_ok(6).ok() == .Some(6) && mk_err(\"bad\").err() == .Some(\"bad\"))\n" +
        "    assert(mk_err(\"bad\").unwrap_or(9) == 9)\n" +
        "    assert(mk_err(\"bad\").unwrap_or_else(fn(move e: string) -> i32 { e.len }) == 3)\n" +
        "    assert(mk_err(\"bad\").unwrap_or_default() == 0)\n" +
        "    assert(mk_ok(6).is_ok() && !mk_ok(6).is_err() && mk_err(\"bad\").is_err())\n" +
        "    // 4. Map get -> Option, get_mut, at_mut, value_at_mut, update, entry_*, take*, Set take*\n" +
        "    mut m: Map<string, i32> = Map::new()\n" +
        "    m.put(\"a\", 1)\n" +
        "    assert(m.get(\"a\") == .Some(1) && m.get(\"z\") == .None)\n" +
        "    idx := m.find_index(\"a\").unwrap()\n" +
        "    r0 := m.value_at_mut(idx)\n" +
        "    r0 = 5\n" +
        "    assert(m.get(\"a\") == .Some(5))\n" +
        "    r1 := m.at_mut(\"a\")\n" +
        "    r1 = 6\n" +
        "    assert(m.get(\"a\") == .Some(6))\n" +
        "    r2 := m.get_mut(\"a\")\n" +
        "    r2 = 12\n" +
        "    assert(m.get(\"a\") == .Some(12))\n" +
        "    assert(m.update(\"a\", inc_mut) && !m.update(\"missing\", inc_mut))\n" +
        "    assert(m.get(\"a\") == .Some(22))\n" +
        "    e1 := m.entry_or_insert(\"b\", 3)\n" +
        "    e1 = e1 + 4\n" +
        "    assert(m.get(\"b\") == .Some(7))\n" +
        "    e2 := m.entry_or_default(\"c\")\n" +
        "    assert(e2 == 0)\n" +
        "    e2 = 9\n" +
        "    assert(m.get(\"c\") == .Some(9))\n" +
        "    assert(m.take(\"c\") == .Some(9) && m.take(\"c\") == .None)\n" +
        "    assert(m.take_key(\"b\") == .Some(\"b\") && m.take_key(\"b\") == .None)\n" +
        "    assert(m.take_key_at(99) == .None)\n" +
        "    mut vm: Map<string, []i32> = Map::new()\n" +
        "    vm.entry_or_insert_with(\"k\", mk_vec).push(9)\n" +
        "    assert(vm.entry_modify_or_insert(\"k\", bump_vec, [1]).len == 4)\n" +
        "    mut set_s: Set<string> = Set::new()\n" +
        "    _ := set_s.insert(\"x\"); _ := set_s.insert(\"y\")\n" +
        "    assert(set_s.take(\"x\") == .Some(\"x\") && set_s.take(\"z\") == .None)\n" +
        "    assert(set_s.take_at(0) == .Some(\"y\") && set_s.take_at(0) == .None)\n" +
        "    // 5. Unified pure stdlib APIs + IoError.WouldBlock\n" +
        "    raw: []u8 = bytes.from_text(\"GET /\\r\\n\\r\\n\")\n" +
        "    assert(bytes.find_byte(&raw, 0, raw.len, b'/') == .Some(4))\n" +
        "    assert(bytes.find_crlf(&raw, 0, raw.len) == .Some(5))\n" +
        "    assert(bytes.find_double_crlf(&raw, 0, raw.len) == .Some(5))\n" +
        "    d := sha256.digest(&bytes.from_text(\"abc\"))\n" +
        "    assert(bytes.hex(&d) == sha256.hex_text(\"abc\"))\n" +
        "    assert(sha256.digest_text(\"abc\") == d)\n" +
        "    assert(text.find(\"hello\", \"ll\") == .Some(2) && text.find(\"hello\", \"x\") == .None)\n" +
        "    xs: []i32 = [3, 1, 9, 2]\n" +
        "    assert(array.index_of(&xs, 9) == .Some(2) && array.index_of(&xs, 99) == .None)\n" +
        "    assert(array.min_index(&xs) == .Some(1) && array.max_index(&xs) == .Some(2))\n" +
        "    wb := sys.IoError.WouldBlock\n" +
        "    assert(wb.code() == 35 && wb.is_would_block())\n" +
        "    print(42)\n" +
        "}\n"
    portable_path := work + "/phase2_portable.ddr"
    if !sys.write_text(portable_path, code).ok { return false }
    harness.run_specialization_matrix(compiler, portable_path, work, "42\n")
}

fn check_runtime_traps(compiler: string, work: string) -> bool {
    cases: [](string, string, string) = [
        ("panic", "fn main() { panic(\"boom-phase2\") }", "boom-phase2"),
        ("opt_unwrap", "fn main() { x: Option<i32> = .None; _ := x.unwrap() }", "called Option::unwrap() on None"),
        ("opt_expect", "fn main() { x: Option<i32> = .None; _ := x.expect(\"custom-opt-panic\") }", "custom-opt-panic"),
        ("res_unwrap", "fn main() { r: Result<i32, string> = .Err(\"bad\"); _ := r.unwrap() }", "called Result::unwrap() on Err"),
        ("res_unwrap_err", "fn main() { r: Result<i32, string> = .Ok(1); _ := r.unwrap_err() }", "called Result::unwrap_err() on Ok"),
    ]
    mut out := harness.empty_output()
    for i in 0..cases.len {
        src := f"{work}/trap_{cases[i].0}.ddr"
        bin := f"{work}/trap_{cases[i].0}"
        if !sys.write_text(src, cases[i].1 + "\n").ok { return harness.fail(f"cannot write {src}") }
        if !harness.run_checked_timeout(compiler, ["build", src.clone(), "-o", bin.clone()], work, 0, false, 60000, &mut out) {
            return false
        }
        res := harness.exec_cmd(bin, [], work, false, 10000)
        if res.code == 0 && res.signal == 0 {
            return harness.fail(f"expected trap for {cases[i].0}, exited 0")
        }
        if !text.contains(res.stderr_text(), cases[i].2) {
            return harness.fail(f"missing panic message '{cases[i].2}' in stderr for {cases[i].0}: {res.stderr_text()}")
        }
    }
    true
}

fn check_host_extern_and_crypto(compiler: string, root: string, work: string) -> bool {
    // 1. @extern priority & uncalled unavailable binding
    ext_src := work + "/extern_select.ddr"
    ext_bin := work + "/extern_select"
    host := process.host_target()
    exact_tag := "\"" + host + "\""
    other_tag := if host == "arm64-macos" { "\"arm64-linux\"" } else { "\"arm64-macos\"" }
    ext_code := "capability unsafe\n" +
        "@extern(\"c\", \"__nonexistent_phase2_default\")\n" +
        "@extern(\"macos\", \"c\", \"__nonexistent_phase2_family\")\n" +
        "@extern(\"linux\", \"c\", \"__nonexistent_phase2_family\")\n" +
        "@extern(" + exact_tag + ", \"c\", \"abs\")\n" +
        "unsafe fn host_abs(x: i32) -> i32\n\n" +
        "@extern(symbol = \"abs\", default = \"c\", macos = \"c\", linux = \"c\", " + exact_tag + " = \"c\")\n" +
        "unsafe fn map_abs(x: i32) -> i32\n\n" +
        "@extern(" + other_tag + ", \"c\", \"__never_called_other_target\")\n" +
        "unsafe fn never_called(ms: u32)\n\n" +
        "fn main() {\n" +
        "    unsafe {\n" +
        "        assert(host_abs(-19) == 19)\n" +
        "        assert(map_abs(-23) == 23)\n" +
        "    }\n" +
        "    print(42)\n" +
        "}\n"
    if !sys.write_text(ext_src, ext_code).ok { return harness.fail("cannot write extern_select.ddr") }
    mut out := harness.empty_output()
    if !harness.run_checked_timeout(compiler, ["build", ext_src.clone(), "-o", ext_bin.clone()], work, 0, false, 60000, &mut out) ||
       !harness.run_target_image(host, ext_bin, work, &mut out) ||
       !harness.stdout_is(&out, "42\n", "@extern priority selection") {
        return false
    }

    // 2. Unified sys/fs/net/process OS sample + dynamic std.crypto + otool -L check
    os_src := work + "/os_crypto.ddr"
    os_bin := work + "/os_crypto"
    crypto_mod := root + "/stdlib/crypto.ddr"
    _ := crypto_mod
    os_code := "capability filesystem, network, process, stdio\n" +
        "import std.bytes as bytes\n" +
        "import std.crypto as crypto\n" +
        "import std.fs as fs\n" +
        "import std.net as net\n" +
        "import std.process as process\n" +
        "import sys\n\n" +
        "fn main() {\n" +
        "    tmp := fs.temp_dir(\"dunder-p2-os-\")\n" +
        "    assert(tmp.ok)\n" +
        "    dir := tmp.value\n" +
        "    defer { _ := fs.remove_all(dir) }\n" +
        "    file := dir + \"/msg.txt\"\n" +
        "    assert(sys.write(file, \"hej\").is_ok())\n" +
        "    assert(sys.read(file) == .Ok(\"hej\"))\n" +
        "    raw: []u8 = [1, 2, 3]\n" +
        "    assert(sys.write_bytes(dir + \"/raw.bin\", &raw).is_ok())\n" +
        "    assert(sys.read_bytes(dir + \"/raw.bin\") == .Ok([1, 2, 3]))\n" +
        "    assert(fs.list_dir(dir).unwrap().len == 2)\n" +
        "    rdir := fs.ReadDir::grant(dir.clone())\n" +
        "    assert(rdir.list().unwrap().len == 2)\n" +
        "    assert(rdir.resolve_read(\"msg.txt\").is_ok())\n" +
        "    assert(process.env(\"__NO_SUCH_DUNDER_ENV__\").is_none())\n" +
        "    cmd := process.Command::new(\"/bin/echo\", [\"ok\"])\n" +
        "    assert(cmd.exec().stdout_text() == \"ok\\n\")\n" +
        "    listener := net.TcpListener::listen(net.loopback(), 0, 4).unwrap()\n" +
        "    client := net.TcpStream::connect(net.loopback(), listener.local_port()).unwrap()\n" +
        "    srv := listener.accept().unwrap()\n" +
        "    payload := bytes.from_text(\"ping\")\n" +
        "    assert(client.write_all(&payload).ok && client.shutdown_write().ok)\n" +
        "    mut got: []u8 = []\n" +
        "    assert(srv.read_append(&mut got, 16) == .Ok(i64(4)))\n" +
        "    rnd := crypto.random(16).unwrap()\n" +
        "    assert(rnd.len == 16)\n" +
        "    key := crypto.random(32).unwrap()\n" +
        "    nonce := crypto.random(12).unwrap()\n" +
        "    aad: []u8 = []\n" +
        "    sealed := crypto.aes256_gcm_seal(&key, &nonce, &aad, &payload).unwrap()\n" +
        "    assert(crypto.aes256_gcm_open(&key, &nonce, &aad, &sealed.ciphertext, &sealed.tag) == .Ok(payload.clone()))\n" +
        "    assert(crypto.hkdf_sha256(&key, &aad, &payload, 32).unwrap().len == 32)\n" +
        "    kp := crypto.ed25519_keygen().unwrap()\n" +
        "    sig := crypto.ed25519_sign(&kp.private_key, &payload).unwrap()\n" +
        "    assert(crypto.ed25519_verify(&kp.public_key, &payload, &sig))\n" +
        "    pw := crypto.argon2id_hash(\"phase2-pw\").unwrap()\n" +
        "    assert(crypto.argon2id_verify(\"phase2-pw\", pw) && !crypto.argon2id_verify(\"nope\", pw))\n" +
        "    print(42)\n" +
        "}\n"
    // Build using repo root or copy stdlib? Put inside work only works if stdlib paths are found;
    // wait: standard `import std.*` resolves from built-in stdlib bundled or beside binary!
    // Wait: let's check `sys.read` & `crypto` with standard `dunder build`.
    if !sys.write_text(os_src, os_code).ok { return harness.fail("cannot write os_crypto.ddr") }
    if !harness.run_checked_timeout(compiler, ["build", os_src.clone(), "-o", os_bin.clone()], work, 0, false, 60000, &mut out) ||
       !harness.run_target_image(host, os_bin, work, &mut out) ||
       !harness.stdout_is(&out, "42\n", "os_crypto sample") {
        return false
    }
    if process.host_os() == "macos" {
        mut ot := harness.empty_output()
        if !harness.run_checked("/usr/bin/otool", ["-L", os_bin.clone()], work, 0, false, &mut ot) {
            return false
        }
        libs := ot.stdout_text()
        if text.contains(libs, "homebrew") || text.contains(libs, "libcrypto") || text.contains(libs, "libargon2") {
            return harness.fail(f"dynamic crypto binary unexpectedly linked OpenSSL/Argon2 directly:\n{libs}")
        }
    }
    true
}

fn check_package_capability_caps(compiler: string, work: string) -> bool {
    cap_root := work + "/caps"
    leaf_dir := cap_root + "/leaf_net"
    mid_dir := cap_root + "/mid"
    leaf_fs_dir := cap_root + "/leaf_fs"
    denied_dir := cap_root + "/denied"
    granted_dir := cap_root + "/granted"
    trans_dir := cap_root + "/transitive"
    for d in [leaf_dir.clone(), mid_dir.clone(), leaf_fs_dir.clone(), denied_dir.clone(), granted_dir.clone(), trans_dir.clone()] {
        if !fs.mkdir_all(d).ok { return harness.fail(f"cannot create {d}") }
    }
    if !sys.write_text(leaf_dir + "/dunder.toml", "name = \"leaf_net\"\nversion = \"0.1.0\"\nroot = \"lib.ddr\"\n").ok ||
       !sys.write_text(leaf_dir + "/lib.ddr", "capability network\npub fn val() -> i32 { 42 }\n").ok {
        return harness.fail("cannot prepare leaf_net")
    }
    // Case A: default empty capabilities rejects dependency network capability
    if !sys.write_text(denied_dir + "/dunder.toml", "name = \"denied\"\nversion = \"0.1.0\"\nroot = \"main.ddr\"\n[dependencies]\nleaf_net = { path = \"../leaf_net\" }\n").ok ||
       !sys.write_text(denied_dir + "/main.ddr", "import leaf_net\nfn main() { print(leaf_net.val()) }\n").ok {
        return harness.fail("cannot prepare denied package")
    }
    mut res := harness.empty_output()
    if !harness.run_checked_timeout(compiler, ["check", "main.ddr"], denied_dir, 1, false, 30000, &mut res) {
        return false
    }
    if !text.contains(res.stderr_text(), "requests capability 'network', which is not granted in dunder.toml") {
        return harness.fail(f"missing capability cap rejection:\n{res.stderr_text()}")
    }
    // Case B: explicit grant permits dependency capability
    if !sys.write_text(granted_dir + "/dunder.toml", "name = \"granted\"\nversion = \"0.1.0\"\nroot = \"main.ddr\"\n[dependencies]\nleaf_net = { path = \"../leaf_net\", capabilities = [\"network\"] }\n").ok ||
       !sys.write_text(granted_dir + "/main.ddr", "import leaf_net\nfn main() { print(leaf_net.val()) }\n").ok {
        return harness.fail("cannot prepare granted package")
    }
    if !harness.run_checked_timeout(compiler, ["check", "main.ddr"], granted_dir, 0, false, 30000, &mut res) {
        return false
    }
    granted_bin := work + "/granted_bin"
    if !harness.run_checked_timeout(compiler, ["build", "main.ddr", "-o", granted_bin.clone()], granted_dir, 0, false, 30000, &mut res) ||
       !harness.run_target_image(process.host_target(), granted_bin, granted_dir, &mut res) ||
       !harness.stdout_is(&res, "42\n", "granted capability dependency") {
        return false
    }
    // Case C: transitive dependency cannot escalate beyond caller's grant
    if !sys.write_text(leaf_fs_dir + "/dunder.toml", "name = \"leaf_fs\"\nversion = \"0.1.0\"\nroot = \"lib.ddr\"\n").ok ||
       !sys.write_text(leaf_fs_dir + "/lib.ddr", "capability filesystem\npub fn val() -> i32 { 9 }\n").ok ||
       !sys.write_text(mid_dir + "/dunder.toml", "name = \"mid\"\nversion = \"0.1.0\"\nroot = \"lib.ddr\"\n[dependencies]\nleaf_fs = { path = \"../leaf_fs\", capabilities = [\"network\", \"filesystem\"] }\n").ok ||
       !sys.write_text(mid_dir + "/lib.ddr", "capability network\nimport leaf_fs\npub fn val() -> i32 { leaf_fs.val() }\n").ok ||
       !sys.write_text(trans_dir + "/dunder.toml", "name = \"trans\"\nversion = \"0.1.0\"\nroot = \"main.ddr\"\n[dependencies]\nmid = { path = \"../mid\", capabilities = [\"network\"] }\n").ok ||
       !sys.write_text(trans_dir + "/main.ddr", "import mid\nfn main() { print(mid.val()) }\n").ok {
        return harness.fail("cannot prepare transitive capability fixture")
    }
    if !harness.run_checked_timeout(compiler, ["check", "main.ddr"], trans_dir, 1, false, 30000, &mut res) {
        return false
    }
    if !text.contains(res.stderr_text(), "requests capability 'filesystem', which is not granted in dunder.toml") {
        return harness.fail(f"missing transitive capability cap rejection:\n{res.stderr_text()}")
    }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-phase2-")
    if !tmp.ok { return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    ok := check_invalid_cases(cli.compiler, work) &&
          check_portable_matrix(cli.compiler, work) &&
          check_runtime_traps(cli.compiler, work) &&
          check_host_extern_and_crypto(cli.compiler, cli.root, work) &&
          check_package_capability_caps(cli.compiler, work)
    if ok { 0 } else { 1 }
}
