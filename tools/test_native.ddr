capability process, filesystem

import .harness as harness
import std.bytes as bytes
import std.fs as fs
import std.process as process
import std.sha256 as sha256
import std.text as text
import sys

fn base64_encode(input: &[]u8) -> string {
    alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var out: []u8 = []
    out.reserve(((input.len + 2) / 3) * 4)
    var i := 0
    while i < input.len {
        left := input.len - i
        a := i32(input[i])
        var b := 0
        var c := 0
        if left > 1 { b = i32(input[i + 1]) }
        if left > 2 { c = i32(input[i + 2]) }
        out.push(u8(alphabet[a / 4]))
        out.push(u8(alphabet[(a % 4) * 16 + b / 16]))
        if left > 1 { out.push(u8(alphabet[(b % 16) * 4 + c / 64])) } else { out.push(b'=') }
        if left > 2 { out.push(u8(alphabet[c % 64])) } else { out.push(b'=') }
        i += 3
    }
    bytes.decode(&out).value
}

fn find_from(haystack: string, needle: string, from: i32) -> i32 {
    if from < 0 || from > haystack.len { return -1 }
    if needle.len == 0 { return from }
    var pos := from
    while pos + needle.len <= haystack.len {
        var k := 0
        while k < needle.len && haystack[pos + k] == needle[k] { k += 1 }
        if k == needle.len { return pos }
        pos += 1
    }
    -1
}

fn skip_xml_ws(s: string, pos: i32) -> i32 {
    var p := pos
    while p < s.len && (s[p] == 32 || s[p] == 9 || s[p] == 10 || s[p] == 13) {
        p += 1
    }
    p
}

fn xml_escape(s: string) -> string {
    var out: []u8 = []
    for b in s.bytes() {
        if b == 38 { bytes.append_utf8(&mut out, "&amp;") }
        else if b == 60 { bytes.append_utf8(&mut out, "&lt;") }
        else if b == 62 { bytes.append_utf8(&mut out, "&gt;") }
        else if b == 34 { bytes.append_utf8(&mut out, "&quot;") }
        else if b == 39 { bytes.append_utf8(&mut out, "&apos;") }
        else { out.push(u8(b)) }
    }
    bytes.decode(&out).value
}

fn xml_unescape(s: string) -> sys.TextResult {
    var out: []u8 = []
    var i := 0
    while i < s.len {
        if s[i] == 38 {
            semi := find_from(s, ";", i + 1)
            if semi < 0 { return sys.TextResult { ok: false, value: "", error: 22 } }
            ent := s[i..(semi + 1)]
            if ent == "&amp;" { out.push(b'&') }
            else if ent == "&lt;" { out.push(b'<') }
            else if ent == "&gt;" { out.push(b'>') }
            else if ent == "&quot;" { out.push(b'"') }
            else if ent == "&apos;" { out.push(b'\'') }
            else { return sys.TextResult { ok: false, value: "", error: 22 } }
            i = semi + 1
        } else {
            out.push(u8(s[i]))
            i += 1
        }
    }
    bytes.decode(&out)
}

fn plist_valid_envelope(xml_text: string) -> bool {
    text.starts_with(xml_text, "<?xml") && text.find(xml_text, "<plist") >= 0 && text.find(xml_text, "</plist>") >= 0
}

fn plist_get_string(xml_text: string, key: string) -> sys.TextResult {
    if !plist_valid_envelope(xml_text) {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    tag := "<key>" + xml_escape(key) + "</key>"
    at := find_from(xml_text, tag, 0)
    if at < 0 { return sys.TextResult { ok: false, value: "", error: 2 } }
    val_pos := skip_xml_ws(xml_text, at + tag.len)
    open_tag := "<string>"
    if find_from(xml_text, open_tag, val_pos) != val_pos {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    content_start := val_pos + open_tag.len
    content_end := find_from(xml_text, "</string>", content_start)
    if content_end < 0 {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    xml_unescape(xml_text[content_start..content_end])
}

fn plist_files2_hash2_b64(xml_text: string, rel_path: string) -> sys.TextResult {
    if !plist_valid_envelope(xml_text) {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    f2 := find_from(xml_text, "<key>files2</key>", 0)
    if f2 < 0 { return sys.TextResult { ok: false, value: "", error: 2 } }
    d_open := skip_xml_ws(xml_text, f2 + 17)
    if find_from(xml_text, "<dict>", d_open) != d_open {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    entry_key := "<key>" + xml_escape(rel_path) + "</key>"
    ek_pos := find_from(xml_text, entry_key, d_open + 6)
    if ek_pos < 0 { return sys.TextResult { ok: false, value: "", error: 2 } }
    ed_open := skip_xml_ws(xml_text, ek_pos + entry_key.len)
    if find_from(xml_text, "<dict>", ed_open) != ed_open {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    ed_close := find_from(xml_text, "</dict>", ed_open + 6)
    if ed_close < 0 { return sys.TextResult { ok: false, value: "", error: 22 } }
    h2_pos := find_from(xml_text, "<key>hash2</key>", ed_open + 6)
    if h2_pos < 0 || h2_pos >= ed_close {
        return sys.TextResult { ok: false, value: "", error: 2 }
    }
    data_open := skip_xml_ws(xml_text, h2_pos + 16)
    if find_from(xml_text, "<data>", data_open) != data_open {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    b64_start := data_open + 6
    b64_end := find_from(xml_text, "</data>", b64_start)
    if b64_end < 0 || b64_end > ed_close {
        return sys.TextResult { ok: false, value: "", error: 22 }
    }
    var clean: []u8 = []
    for i in b64_start..b64_end {
        ch := xml_text[i]
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            clean.push(u8(ch))
        }
    }
    bytes.decode(&clean)
}

fn run_native_cmd(program: string, args: []string, cwd: string, expected_code: i32, no_external_path: bool, out_res: &mut process.Output) -> bool {
    var cmd := process.command(program, args)
    process.set_cwd(&mut cmd, cwd)
    if no_external_path {
        process.set_env(&mut cmd, "PATH", "/no-external-tools")
    }
    process.set_timeout(&mut cmd, 60000)
    res := process.exec(&cmd)
    var accepted := false
    if expected_code < 0 {
        accepted = res.ok && !res.timed_out && res.signal == 0 && res.code > 0
    } else {
        accepted = res.ok && !res.timed_out && res.signal == 0 && res.code == expected_code
    }
    stdout_s := process.stdout_text(&res)
    stderr_s := process.stderr_text(&res)
    if !accepted {
        return harness.fail(program + " exited " + res.code.str() + " (signal " + res.signal.str() + "), expected " + expected_code.str() + "\nstdout: " + stdout_s + "\nstderr: " + stderr_s)
    }
    if text.find(stderr_s, "VUID-") >= 0 || text.find(stderr_s, "Validation Error") >= 0 {
        return harness.fail(stderr_s)
    }
    out_res = res
    true
}

fn build_cmd(cli: &harness.BaseCli, work: string, source: string, output: string, flags: []string, expected_code: i32, out_res: &mut process.Output) -> bool {
    var args: []string = ["build", source, "-o", output]
    for f in flags { args.push(f) }
    run_native_cmd(cli.compiler, args, work, expected_code, true, &mut out_res)
}

fn check_elf(image: &[]u8, machine: i32, interpreter: string) -> bool {
    if image.len < 64 {
        return harness.fail("ELF image shorter than 64-byte header")
    }
    if image[0] != 0x7f || image[1] != b'E' || image[2] != b'L' || image[3] != b'F' || image[4] != 2 || image[5] != 1 {
        return harness.fail("invalid ELF64 little-endian magic")
    }
    if bytes.u16_le(&image, 18) != machine {
        return harness.fail("unexpected ELF e_machine: " + bytes.u16_le(&image, 18).str() + ", expected " + machine.str())
    }
    table := bytes.i64_le(&image, 32)
    stride := bytes.u16_le(&image, 54)
    count := bytes.u16_le(&image, 56)
    if table < 0 || stride < 56 || count <= 0 || table + i64(count) * i64(stride) > i64(image.len) {
        return harness.fail("invalid ELF program header table bounds")
    }
    var saw_gnu_stack := false
    var saw_dynamic := false
    var interp_count := 0
    for i in 0..count {
        base := i32(table) + i * stride
        kind := bytes.u32_le(&image, base)
        flags := bytes.u32_le(&image, base + 4)
        offset := bytes.i64_le(&image, base + 8)
        size := bytes.i64_le(&image, base + 32)
        if kind == 1 && flags.bit_and(3) == 3 {
            return harness.fail("PT_LOAD segment violates W^X (flags=" + flags.str() + ")")
        }
        if kind == 0x6474e551 && flags == 6 {
            saw_gnu_stack = true
        }
        if kind == 3 {
            interp_count += 1
            want_len := interpreter.len + 1
            if offset < 0 || size != i64(want_len) || offset + size > i64(image.len) {
                return harness.fail("invalid PT_INTERP bounds or size")
            }
            off32 := i32(offset)
            if !bytes.equals_text(&image, off32, off32 + interpreter.len, interpreter) || image[off32 + interpreter.len] != 0 {
                return harness.fail("unexpected PT_INTERP string")
            }
        }
        if kind == 2 {
            saw_dynamic = true
        }
    }
    if !saw_gnu_stack {
        return harness.fail("missing PT_GNU_STACK (0x6474e551) with flags == 6")
    }
    if interp_count != 1 {
        return harness.fail("expected exactly 1 PT_INTERP segment, got " + interp_count.str())
    }
    if !saw_dynamic {
        return harness.fail("missing PT_DYNAMIC segment")
    }
    true
}

fn check_bundle(cli: &harness.BaseCli, work: string) -> bool {
    is_mac := process.host_os() == "macos"
    source := work + "/bundle.ddr"
    if !sys.write_text(source, "import sys\nfn main()->i32{print(sys.arg(1));return 17}\n").ok {
        return harness.fail("failed to write bundle.ddr")
    }
    app := work + "/Atlas & Light.app"
    app_stem := harness.stem(app)
    contents := app + "/Contents"
    binary := contents + "/MacOS/" + app_stem
    res_dir := contents + "/Resources"
    resource := res_dir + "/art.bin"
    info := contents + "/Info.plist"
    seal := contents + "/_CodeSignature/CodeResources"

    if !fs.mkdir_all(res_dir).ok {
        return harness.fail("failed to create bundle Resources dir")
    }
    var art: []u8 = []
    for b in 0..256 { art.push(u8(b)) }
    if !sys.write_u8(resource, &art).ok {
        return harness.fail("failed to write art.bin")
    }

    var res := harness.empty_output()
    if !build_cmd(&cli, work, source, app, ["--target", "arm64-macos", "--app"], 0, &mut res) {
        return false
    }

    info_text := sys.read_text(info)
    if !info_text.ok {
        return harness.fail("failed to read Info.plist")
    }
    exec_val := plist_get_string(info_text.value, "CFBundleExecutable")
    pkg_val := plist_get_string(info_text.value, "CFBundlePackageType")
    if !exec_val.ok || exec_val.value != app_stem || !pkg_val.ok || pkg_val.value != "APPL" {
        return harness.fail("Info.plist metadata mismatch")
    }

    bin_bytes := sys.read_u8(binary)
    if !bin_bytes.ok || bin_bytes.value.len < 4 || bin_bytes.value[0] != 0xcf || bin_bytes.value[1] != 0xfa || bin_bytes.value[2] != 0xed || bin_bytes.value[3] != 0xfe {
        return harness.fail("Mach-O 0xcffaedfe magic header check failed")
    }

    res_bytes := sys.read_u8(resource)
    seal_text := sys.read_text(seal)
    if !res_bytes.ok || !seal_text.ok {
        return harness.fail("failed to read art.bin or CodeResources")
    }
    res_digest := sha256.digest_bytes(&res_bytes.value)
    expected_b64 := base64_encode(&res_digest)
    seal_b64 := plist_files2_hash2_b64(seal_text.value, "Resources/art.bin")
    if !seal_b64.ok || seal_b64.value != expected_b64 {
        return harness.fail("CodeResources hash2 mismatch for Resources/art.bin")
    }

    if is_mac {
        if !run_native_cmd("/usr/bin/codesign", ["--verify", "--strict", app], work, 0, false, &mut res) {
            return false
        }
        if !run_native_cmd(binary, ["argument"], work, 17, false, &mut res) {
            return false
        }
        if process.stdout_text(&res) != "argument\n" {
            return harness.fail("unexpected bundle executable stdout: " + process.stdout_text(&res))
        }
        if !sys.write_text(resource, "changed").ok {
            return harness.fail("failed to tamper art.bin")
        }
        if !run_native_cmd("/usr/bin/codesign", ["--verify", "--strict", app], work, -1, false, &mut res) {
            return false
        }
        if !build_cmd(&cli, work, source, app, ["--target", "arm64-macos", "--app"], 0, &mut res) {
            return false
        }
        if !run_native_cmd("/usr/bin/codesign", ["--verify", "--strict", app], work, 0, false, &mut res) {
            return false
        }
    }

    b_bin := sys.read_u8(binary)
    b_info := sys.read_u8(info)
    b_seal := sys.read_u8(seal)
    if !b_bin.ok || !b_info.ok || !b_seal.ok {
        return harness.fail("failed to snapshot bundle files before negative tests")
    }

    if !sys.write_text(source, "fn main(){ missing_symbol() }\n").ok {
        return harness.fail("failed to write broken bundle.ddr")
    }
    if !build_cmd(&cli, work, source, app, ["--target", "arm64-macos", "--app"], -1, &mut res) {
        return false
    }
    if text.find(process.stderr_text(&res), "missing_symbol") < 0 {
        return harness.fail("expected missing_symbol in build stderr")
    }
    a1_bin := sys.read_u8(binary)
    a1_info := sys.read_u8(info)
    a1_seal := sys.read_u8(seal)
    if !a1_bin.ok || !a1_info.ok || !a1_seal.ok ||
       !harness.bytes_equal(&b_bin.value, &a1_bin.value) ||
       !harness.bytes_equal(&b_info.value, &a1_info.value) ||
       !harness.bytes_equal(&b_seal.value, &a1_seal.value) {
        return harness.fail("bundle files modified after failed compile")
    }

    if !sys.write_text(source, "fn main(){print(42)}\n").ok {
        return harness.fail("failed to rewrite bundle.ddr")
    }
    if !fs.symlink(source, res_dir + "/linked").ok {
        return harness.fail("failed to create symlink in bundle Resources")
    }
    if !build_cmd(&cli, work, source, app, ["--target", "arm64-macos", "--app"], -1, &mut res) {
        return false
    }
    if text.find(process.stderr_text(&res), "symbolic link") < 0 {
        return harness.fail("expected symbolic link rejection in build stderr")
    }
    a2_bin := sys.read_u8(binary)
    a2_info := sys.read_u8(info)
    a2_seal := sys.read_u8(seal)
    if !a2_bin.ok || !a2_info.ok || !a2_seal.ok ||
       !harness.bytes_equal(&b_bin.value, &a2_bin.value) ||
       !harness.bytes_equal(&b_info.value, &a2_info.value) ||
       !harness.bytes_equal(&b_seal.value, &a2_seal.value) {
        return harness.fail("bundle files modified after symlink rejection")
    }

    var suffix := " (cross-build)"
    if is_mac {
        suffix = "; macOS verified signature, tamper detection, reseal and executable"
    }
    print("PASS app bundle: metadata, binary resource seal and failed rebuild preservation" + suffix)
    true
}

fn check_graphics(cli: &harness.BaseCli, work: string, live: bool) -> bool {
    is_mac := process.host_os() == "macos"
    var res := harness.empty_output()

    for name in ["macos", "vulkan"] {
        probe := work + "/unexpected.ddr"
        if !sys.write_text(probe, "import std." + name + "\nfn main(){}\n").ok {
            return harness.fail("failed to write unexpected.ddr")
        }
        if !build_cmd(&cli, work, probe, work + "/unexpected", [], -1, &mut res) {
            return false
        }
        if text.find(process.stderr_text(&res), "std/" + name + ".ddr") < 0 {
            return harness.fail("expected std/" + name + ".ddr in rejection stderr")
        }
    }

    linux_ffi := work + "/linux_ffi.ddr"
    if !sys.write_text(linux_ffi,
        "capability unsafe\n" +
        "@extern(\"c\", \"calloc\") unsafe fn allocate(count: usize, bytes: usize) -> ptr\n" +
        "fn main() {\n" +
        "    unsafe {\n" +
        "        p := static_bytes(\"linux\", 16)\n" +
        "        _ := allocate\n" +
        "        if p == ptr(0) { return }\n" +
        "    }\n" +
        "}\n"
    ).ok {
        return harness.fail("failed to write linux_ffi.ddr")
    }

    mac_bundle := work + "/mac_bundle.ddr"
    if !sys.write_text(mac_bundle,
        "capability unsafe\n" +
        "fn main() {\n" +
        "    unsafe {\n" +
        "        p := static_bytes(\"macos\", 16)\n" +
        "        if p == ptr(0) { print(0) }\n" +
        "    }\n" +
        "}\n"
    ).ok {
        return harness.fail("failed to write mac_bundle.ddr")
    }

    rej_sources := [linux_ffi, mac_bundle]
    rej_targets := ["arm64-macos", "arm64-linux"]
    for i in 0..rej_sources.len {
        if !build_cmd(&cli, work, rej_sources[i], work + "/unexpected", ["--target", rej_targets[i]], -1, &mut res) {
            return false
        }
        if text.find(process.stderr_text(&res), "requires the selected native platform") < 0 {
            return harness.fail("expected platform-gated static_bytes diagnostic")
        }
        if sys.metadata(work + "/unexpected").ok || fs.is_symlink(work + "/unexpected") {
            return harness.fail("unexpected output artifact created on rejected build")
        }
    }

    linux_targets := ["arm64-linux", "x86_64-linux"]
    linux_machines := [183, 62]
    linux_interps := ["/lib/ld-linux-aarch64.so.1", "/lib64/ld-linux-x86-64.so.2"]
    for i in 0..linux_targets.len {
        target := linux_targets[i]
        path := work + "/" + target
        if !build_cmd(&cli, work, linux_ffi, path, ["--target", target], 0, &mut res) {
            return false
        }
        img1 := sys.read_u8(path)
        if !img1.ok {
            return harness.fail("failed to read ELF image: " + path)
        }
        if !check_elf(&img1.value, linux_machines[i], linux_interps[i]) {
            return false
        }
        if !build_cmd(&cli, work, linux_ffi, path, ["--target", target], 0, &mut res) {
            return false
        }
        img2 := sys.read_u8(path)
        if !img2.ok || !harness.bytes_equal(&img1.value, &img2.value) {
            return harness.fail("ELF cross-build is not byte-identical on rebuild for " + target)
        }
    }

    mac_app := work + "/Triangle.app"
    mac_res_dir := mac_app + "/Contents/Resources"
    mac_resource := mac_res_dir + "/shader.bin"
    if !fs.mkdir_all(mac_res_dir).ok {
        return harness.fail("failed to create Triangle.app Resources dir")
    }
    if !sys.write_text(mac_resource, "metal-shader").ok {
        return harness.fail("failed to write shader.bin")
    }
    if !build_cmd(&cli, work, mac_bundle, mac_app, ["--target", "arm64-macos", "--app"], 0, &mut res) {
        return false
    }
    tri_plist := sys.read_text(mac_app + "/Contents/Info.plist")
    if !tri_plist.ok {
        return harness.fail("failed to read Triangle.app Info.plist")
    }
    tri_exec := plist_get_string(tri_plist.value, "CFBundleExecutable")
    if !tri_exec.ok || tri_exec.value != "Triangle" {
        return harness.fail("Triangle.app CFBundleExecutable mismatch")
    }
    tri_bin_meta := sys.metadata(mac_app + "/Contents/MacOS/Triangle")
    if !tri_bin_meta.ok || !tri_bin_meta.is_file {
        return harness.fail("Triangle.app executable missing")
    }
    shader_check := sys.read_text(mac_resource)
    if !shader_check.ok || shader_check.value != "metal-shader" {
        return harness.fail("Triangle.app shader.bin resource mismatch")
    }
    if is_mac {
        if !run_native_cmd("/usr/bin/codesign", ["--verify", "--strict", mac_app], work, 0, false, &mut res) {
            return false
        }
        if !run_native_cmd(mac_app + "/Contents/MacOS/Triangle", [], work, 0, false, &mut res) {
            return false
        }
        if process.stdout_text(&res) != "" {
            return harness.fail("expected empty stdout from Triangle.app, got: " + process.stdout_text(&res))
        }
    }

    print("PASS platform-gated static_bytes, C-FFI ELF cross-builds, and macOS .app bundle")
    if live {
        print("Graphics demos now live in dunder-hundmat; run tools/test-graphics.py --graphics there.")
    }
    true
}

fn run_in_work(cli: &harness.BaseCli, work: string) -> bool {
    if !check_bundle(&cli, work) { return false }
    if !check_graphics(&cli, work, cli.graphics) { return false }
    true
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    if cli.extra_args.len > 0 {
        return harness.fail("unexpected extra argument: " + cli.extra_args[0])
    }
    tmp := fs.temp_dir("dunder-native-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    work := tmp.value
    ok := run_in_work(&cli, work)
    _ := fs.remove_all(work)
    ok
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok {
        _ := sys.eprint(cli.error)
        return 2
    }
    if !run_suite(&cli) {
        return 1
    }
    0
}
