capability process, filesystem, stdio

import .harness as harness
import .native_probe as native
import .probe_cli as cli
import std.fs as fs
import std.text as text
import sys

fn check_runtime(runners: &native.Runners, target: string, image: string, root: string) -> bool {
    mut result := harness.empty_output()
    if !runners.run(target, image, [image + ".db"], root, 0, &mut result) { return false }
    output := result.stdout_text()
    if text.trim(output) != "sqlite ok" || result.stderr.len != 0 {
        return harness.fail(f"{target}: unexpected SQLite output:\n{output}\n{result.stderr_text()}")
    }
    true
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--runner")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_sqlite <compiler> [--runner TARGET=COMMAND]")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    specs := args.all("--runner")
    runners := native.Runners::new(&specs)
    if runners.error.len != 0 { _ := sys.eprint(runners.error); return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("could not locate Dunder repository root"); return 1 }
    tmp := fs.temp_dir("dunder-sqlite-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    counts := native.library_images(compiler, root, work, "sqlite", root + "/packages/sqlite/tests/main.ddr", &runners, check_runtime)
    if !counts.ok { return 1 }
    print(f"sqlite: {counts.builds} native images, {counts.executions} target executions; SqlValue, direct Row reads, Result/SqliteError, exec_batch, Transaction auto-rollback, and @resource(dispose) passed")
    0
}
