capability process, filesystem, stdio

import .harness as harness
import .native_probe as native
import .probe_cli as cli
import std.fs as fs
import std.json as json
import std.text as text
import sys

fn check_row(line: string, index: i32) -> bool {
    doc := json.Doc::parse_text(line)
    root := doc.root
    id := doc.get_i64(root, "id")
    value := doc.get_str(root, "value")
    expected := ["åäö 雪\0after", "", "x'); DROP TABLE items; --"]
    if !doc.ok || doc.count(root) != 5 || !id.ok || id.value != i64(index + 1) ||
       !value.ok || value.value != expected[index] || doc.kind(doc.field(root, "absent")) != .Null {
        return false
    }
    number_node := doc.field(root, "number")
    real_node := doc.field(root, "real")
    if index != 0 { return doc.kind(number_node) == .Null && doc.kind(real_node) == .Null }
    number := doc.as_i64(number_node)
    real := doc.as_f64(real_node)
    spelling := doc.raw_span(real_node)
    number.ok && number.value == 9223372036854775807 && real.ok && real.value == 1.2345678901234567 &&
        (text.contains(spelling, ".") || text.contains(spelling, "e") || text.contains(spelling, "E"))
}

fn check_runtime(runners: &native.Runners, target: string, image: string, root: string) -> bool {
    mut result := harness.empty_output()
    if !runners.run(target, image, [image + ".db"], root, 0, &mut result) { return false }
    output := result.stdout_text()
    lines := harness.lines(output)
    if lines.len != 4 || lines[3] != "sqlite ok" || result.stderr.len != 0 {
        return harness.fail(f"{target}: unexpected SQLite output:\n{output}\n{result.stderr_text()}")
    }
    for i in 0..3 {
        if !check_row(lines[i], i) { return harness.fail(f"{target}: unexpected SQLite row {i + 1}: {lines[i]}") }
    }
    true
}

fn main() -> i32 {
    spec: []cli.Option = [cli.option("--runner")]
    args := cli.parse(&spec)
    compiler := cli.compiler(&args, "usage: test_sqlite <compiler> [--runner TARGET=COMMAND]")
    if args.help { return 0 }
    if compiler.len == 0 { return 2 }
    specs := args.all("--runner")
    runners := native.Runners::new(&specs)
    if runners.error.len != 0 { _ := sys.eprint(runners.error); return 2 }
    root := harness.find_root()
    if root.len == 0 { _ := harness.fail("could not locate Dunder repository root"); return 1 }
    tmp := fs.temp_dir("dunder-sqlite-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    counts := native.library_images(compiler, root, work, "sqlite", &runners, check_runtime)
    if !counts.ok { return 1 }
    print(f"sqlite: {counts.builds} native images, {counts.executions} target executions; parameter binding, exact types/UTF-8, statement boundaries, triggers, read-only handles, limits and cleanup passed")
    0
}
