capability process, filesystem, stdio

import .harness as harness
import std.fs as fs
import std.json as json
import std.process as process
import sys

fn pod_core_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "struct Big16 {\n" +
    "    f0: i64, f1: i64, f2: i64, f3: i64, f4: i64, f5: i64, f6: i64, f7: i64,\n" +
    "    f8: i64, f9: i64, f10: i64, f11: i64, f12: i64, f13: i64, f14: i64, f15: i64,\n" +
    "}\n" +
    "struct TooBig17 {\n" +
    "    f0: i64, f1: i64, f2: i64, f3: i64, f4: i64, f5: i64, f6: i64, f7: i64,\n" +
    "    f8: i64, f9: i64, f10: i64, f11: i64, f12: i64, f13: i64, f14: i64, f15: i64, f16: i64,\n" +
    "}\n" +
    "enum Mode { Fast, Slow }\n" +
    "fn double_it(n: i32) -> i32 { n * 2 }\n" +
    "struct Flags { ok: bool, mode: Mode, count: u64, ch: rune, cb: fn(i32) -> i32 }\n" +
    "impl Point {\n" +
    "    fn make(x: i32, y: i32) -> Point { Point { x: x, y: y } }\n" +
    "    fn translate(&self, dx: i32, dy: i32) -> Point { Point { x: self.x + dx, y: self.y + dy } }\n" +
    "    fn scale(&self, k: i32) -> Point { Point { x: self.x * k, y: self.y * k } }\n" +
    "    fn swap_axes(&mut self) { self = Point { x: self.y, y: self.x } }\n" +
    "    fn add_consume(self: Point, other: Point) -> Point { Point { x: self.x + other.x, y: self.y + other.y } }\n" +
    "}\n" +
    "fn consume_pair(move a: Point, move b: Point) -> i32 { a.x * 1000 + a.y * 100 + b.x * 10 + b.y }\n" +
    "fn fib_pair(n: i32) -> Point {\n" +
    "    if n <= 0 { return Point { x: 0, y: 1 } }\n" +
    "    prev := fib_pair(n - 1)\n" +
    "    Point { x: prev.y, y: prev.x + prev.y }\n" +
    "}\n" +
    "fn early_with_defer(v: i32) -> Point {\n" +
    "    mut p := Point { x: v, y: v + 1 }\n" +
    "    defer { p.x = 999; p.y = 888 }\n" +
    "    if v < 0 { return Point { x: -1, y: -2 } }\n" +
    "    return p\n" +
    "}\n" +
    "fn choice_pod(sel: i32) -> Point {\n" +
    "    if sel == 0 { Point { x: 1, y: 2 } }\n" +
    "    else if sel == 1 { return Point { x: 3, y: 4 } }\n" +
    "    else { match sel { 2 => Point { x: 5, y: 6 }, _ => { Point { x: 7, y: 8 } } } }\n" +
    "}\n" +
    "fn many_args(a: i32, p1: Point, b: i32, p2: Point, c: i32, p3: Point, d: i32, move p4: Point, e: i32, move p5: Point) -> Point {\n" +
    "    Point { x: a + p1.x + b + p2.x + c + p3.x + d + p4.x + e + p5.x,\n" +
    "            y: p1.y + p2.y + p3.y + p4.y + p5.y }\n" +
    "}\n" +
    "fn set_big16(v: i64) -> Big16 {\n" +
    "    Big16 { f0: v, f1: v+1, f2: v+2, f3: v+3, f4: v+4, f5: v+5, f6: v+6, f7: v+7,\n" +
    "            f8: v+8, f9: v+9, f10: v+10, f11: v+11, f12: v+12, f13: v+13, f14: v+14, f15: v+15 }\n" +
    "}\n" +
    "fn take_big17(b: TooBig17) -> i64 { b.f0 + b.f16 }\n" +
    "fn apply_cb(cb: fn(move Point, i32) -> Point, move p: Point, k: i32) -> Point { cb(move p, k) }\n" +
    "fn step_point(move p: Point, k: i32) -> Point { Point { x: p.x + k, y: p.y + k } }\n" +
    "fn call_spilled_closure(f: &Fn(i32, Point, i32, Point, i32, Point, i32, Point, Point) -> Point) -> Point {\n" +
    "    p := Point { x: 1, y: 2 }\n" +
    "    f(10, p, 20, p, 30, p, 40, p, Point { x: 5, y: 6 })\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut p := Point { x: 1, y: 2 }\n" +
    "    snap_res := consume_pair(p.clone(), replace(&mut p, Point { x: 3, y: 4 }))\n" +
    "    assert(snap_res == 1 * 1000 + 2 * 100 + 1 * 10 + 2)\n" +
    "    assert(p.x == 3 && p.y == 4)\n" +
    "    prev_swapped := replace(&mut p, Point { x: p.y * 2, y: p.x * 2 })\n" +
    "    assert(prev_swapped.x == 3 && prev_swapped.y == 4 && p.x == 8 && p.y == 6)\n" +
    "    p = p\n" +
    "    assert(p.x == 8 && p.y == 6)\n" +
    "    p = Point { x: p.y, y: p.x }\n" +
    "    assert(p.x == 6 && p.y == 8)\n" +
    "    p.swap_axes()\n" +
    "    assert(p.x == 8 && p.y == 6)\n" +
    "    fib := fib_pair(7)\n" +
    "    assert(fib.x == 13 && fib.y == 21)\n" +
    "    d1 := early_with_defer(10)\n" +
    "    d2 := early_with_defer(-5)\n" +
    "    assert(d1.x == 10 && d1.y == 11 && d2.x == -1 && d2.y == -2)\n" +
    "    c0 := choice_pod(0); c1 := choice_pod(1); c2 := choice_pod(2); c3 := choice_pod(9)\n" +
    "    assert(c0.x == 1 && c1.x == 3 && c2.x == 5 && c3.x == 7)\n" +
    "    proj := Point::make(3, 4).translate(2, 1).scale(5)\n" +
    "    assert(proj.x == 25 && proj.y == 25)\n" +
    "    assert(Point::make(10, 20).add_consume(Point { x: 1, y: 2 }).x == 11)\n" +
    "    mut loop_acc := Point { x: 0, y: 0 }\n" +
    "    for i in 0..8 {\n" +
    "        cur := Point { x: i, y: i * 2 }\n" +
    "        if i == 2 { continue }\n" +
    "        if i == 5 { break }\n" +
    "        loop_acc = Point { x: loop_acc.x + cur.x, y: loop_acc.y + cur.y }\n" +
    "    }\n" +
    "    assert(loop_acc.x == 8 && loop_acc.y == 16)\n" +
    "    spilled := many_args(1, p, 2, p, 3, p, 4, move p, 5, Point { x: 2, y: 3 })\n" +
    "    assert(spilled.x == 1+8+2+8+3+8+4+8+5+2 && spilled.y == 6+6+6+6+3)\n" +
    "    b16 := set_big16(10)\n" +
    "    assert(b16.f0 == 10 && b16.f15 == 25)\n" +
    "    b17 := TooBig17 { f0: 1, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0, f16: 99 }\n" +
    "    assert(take_big17(b17) == 100)\n" +
    "    fl := Flags { ok: true, mode: Mode.Fast, count: u64(42), ch: rune(90), cb: double_it }\n" +
    "    assert(fl.ok && fl.mode == Mode.Fast && fl.count == u64(42) && fl.ch == rune(90) && fl.cb(21) == 42)\n" +
    "    assert(apply_cb(step_point, Point { x: 4, y: 5 }, 3).x == 7)\n" +
    "    mut base_p := Point { x: 100, y: 200 }\n" +
    "    sp_res := call_spilled_closure(fn[&base_p](a: i32, p1: Point, b: i32, p2: Point, c: i32, p3: Point, d: i32, p4: Point, p5: Point) -> Point {\n" +
    "        Point { x: base_p.x + a + p1.x + b + p2.x + c + p3.x + d + p4.x + p5.x, y: base_p.y + p5.y }\n" +
    "    })\n" +
    "    assert(sp_res.x == 209 && sp_res.y == 206)\n" +
    "    mut mc := Point { x: 1, y: 2 }\n" +
    "    mut clo_mut: FnMut(i32) -> Point = fn[mut mc](dx: i32) -> Point {\n" +
    "        mc = Point { x: mc.x + dx, y: mc.y + dx * 2 }\n" +
    "        mc\n" +
    "    }\n" +
    "    r1 := clo_mut(5)\n" +
    "    r2 := clo_mut(3)\n" +
    "    assert(r1.x == 6 && r1.y == 12 && r2.x == 9 && r2.y == 18)\n" +
    "    cap_once := Point { x: 55, y: 66 }\n" +
    "    clo_once: FnOnce() -> Point = move fn[cap_once]() -> Point { cap_once }\n" +
    "    r3 := clo_once()\n" +
    "    assert(r3.x == 55 && r3.y == 66)\n" +
    "    mut sc := Point { x: 11, y: 22 }\n" +
    "    sc_fn: &Fn() -> i32 = fn[&sc]() -> i32 { sc.x + sc.y }\n" +
    "    assert(sc_fn() == 33)\n" +
    "    owned_fn: Fn() -> i32 = fn[sc]() -> i32 { sc.x + sc.y }\n" +
    "    assert(owned_fn() == 33)\n" +
    "    sm_fn: &mut FnMut(i32) -> Point = fn[&mut sc](dy: i32) -> Point {\n" +
    "        sc.y += dy\n" +
    "        sc\n" +
    "    }\n" +
    "    r4 := sm_fn(8)\n" +
    "    assert(r4.x == 11 && r4.y == 30 && sc.y == 30)\n" +
    "    print(42)\n" +
    "}\n"
}

fn pod_containers_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "struct Outer { p: Point, name: string }\n" +
    "@resource(dispose)\n" +
    "struct Guarded {\n" +
    "    p: Point,\n" +
    "    marker: i32,\n" +
    "}\n" +
    "impl Guarded {\n" +
    "    fn dispose(&self) { assert(self.marker == 77) }\n" +
    "}\n" +
    "struct PodIter { cur: i32, end: i32 }\n" +
    "impl Iterator for PodIter {\n" +
    "    fn next(&mut self) -> Option<Point> {\n" +
    "        if self.cur >= self.end { return .None }\n" +
    "        v := Point { x: self.cur, y: self.cur * 10 }\n" +
    "        self.cur += 1\n" +
    "        .Some(v)\n" +
    "    }\n" +
    "}\n" +
    "fn maybe_point(ok: bool, x: i32) -> Option<Point> {\n" +
    "    if ok { return .Some(Point { x: x, y: x + 1 }) }\n" +
    "    .None\n" +
    "}\n" +
    "fn forward_opt(ok: bool, x: i32) -> Option<Point> {\n" +
    "    p := maybe_point(ok, x)?\n" +
    "    .Some(Point { x: p.x * 2, y: p.y * 2 })\n" +
    "}\n" +
    "fn res_pod(ok: bool, v: i32) -> Result<Point, Point> {\n" +
    "    if ok { return .Ok(Point { x: v, y: v + 1 }) }\n" +
    "    .Err(Point { x: -v, y: -v - 1 })\n" +
    "}\n" +
    "fn forward_res(ok: bool, v: i32) -> Result<Point, Point> {\n" +
    "    p := res_pod(ok, v)?\n" +
    "    .Ok(Point { x: p.x + 100, y: p.y + 200 })\n" +
    "}\n" +
    "fn forward_pod_err(v: i32) -> Result<i32, Point> {\n" +
    "    _ := res_pod(false, v)?\n" +
    "    .Ok(1)\n" +
    "}\n" +
    "fn bump_pod(p: &mut Point, dx: i32) {\n" +
    "    p = Point { x: p.x + dx, y: p.y + dx * 2 }\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut arr: []Point = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]\n" +
    "    arr.push(Point { x: 5, y: 6 })\n" +
    "    arr[0].x = 10\n" +
    "    bump_pod(&mut arr[1], 7)\n" +
    "    assert(arr[0].x == 10 && arr[1].x == 10 && arr[1].y == 18)\n" +
    "    old_e1 := replace(&mut arr[1], Point { x: 30, y: 40 })\n" +
    "    assert(old_e1.x == 10 && old_e1.y == 18 && arr[1].x == 30)\n" +
    "    arr.swap(0, 2)\n" +
    "    assert(arr[0].x == 5 && arr[2].x == 10)\n" +
    "    popped := arr.pop()\n" +
    "    assert(popped.x == 10 && popped.y == 2 && arr.len == 2)\n" +
    "    rem := arr.remove(0)\n" +
    "    assert(rem.x == 5 && rem.y == 6 && arr.len == 1 && arr[0].x == 30)\n" +
    "    mut arr_copy := arr.clone()\n" +
    "    arr_copy[0].x = 999\n" +
    "    assert(arr[0].x == 30 && arr_copy[0].x == 999)\n" +
    "    mut sum_v := 0\n" +
    "    for it in arr_copy { sum_v += it.x + it.y }\n" +
    "    for it in &arr_copy { sum_v += it.x }\n" +
    "    for (idx, it) in (move arr_copy).enumerate() { sum_v += idx * 100 + it.y }\n" +
    "    assert(sum_v == (999 + 40) + 999 + 40)\n" +
    "    rep := [Point { x: 2, y: 3 }; 3]\n" +
    "    assert(rep.len == 3 && rep[0].x == 2 && rep[2].y == 3)\n" +
    "    mut rep_mut := rep.clone()\n" +
    "    rep_mut[1].x = 88\n" +
    "    assert(rep[1].x == 2 && rep_mut[1].x == 88)\n" +
    "    mut outer := Outer { p: Point { x: 1, y: 2 }, name: \"tag\" }\n" +
    "    outer.p.x = 77\n" +
    "    assert(outer.p.x == 77)\n" +
    "    old_op := replace(&mut outer.p, Point { x: 11, y: 12 })\n" +
    "    assert(old_op.x == 77 && outer.p.x == 11)\n" +
    "    outer_clone := outer.clone()\n" +
    "    outer.p = Point { x: 21, y: 22 }\n" +
    "    assert(outer.p.x == 21 && outer_clone.p.x == 11)\n" +
    "    Outer { p: ext_p, name: ext_name } := move outer\n" +
    "    assert(ext_p.x == 21 && ext_p.y == 22 && ext_name == \"tag\")\n" +
    "    Guarded { p: gp, .. } := Guarded { p: Point { x: 31, y: 32 }, marker: 77 }\n" +
    "    assert(gp.x == 31 && gp.y == 32)\n" +
    "    tup: (Point, string, Point) = (Point { x: 4, y: 5 }, \"mid\", Point { x: 6, y: 7 })\n" +
    "    (tp0, ts, tp1) := move tup\n" +
    "    assert(tp0.x == 4 && ts == \"mid\" && tp1.y == 7)\n" +
    "    match forward_opt(true, 15) {\n" +
    "        .Some(op) => { assert(op.x == 30 && op.y == 32) },\n" +
    "        .None => { assert(false) },\n" +
    "    }\n" +
    "    assert(match forward_opt(false, 1) { .Some(_) => false, .None => true })\n" +
    "    opt_borrow := maybe_point(true, 5)\n" +
    "    match &opt_borrow {\n" +
    "        .Some(bp) => { assert(bp.x == 5 && bp.y == 6) },\n" +
    "        .None => { assert(false) },\n" +
    "    }\n" +
    "    match forward_res(true, 9) {\n" +
    "        .Ok(rp) => { assert(rp.x == 109 && rp.y == 210) },\n" +
    "        .Err(_) => { assert(false) },\n" +
    "    }\n" +
    "    match forward_pod_err(7) {\n" +
    "        .Ok(_) => { assert(false) },\n" +
    "        .Err(ep) => { assert(ep.x == -7 && ep.y == -8) },\n" +
    "    }\n" +
    "    mut mp := Map<string, Point>::new()\n" +
    "    mp.put(\"a\", Point { x: 1, y: 2 })\n" +
    "    mp.put(\"b\", Point { x: 3, y: 4 })\n" +
    "    assert(mp.update(\"a\", fn[](vp: &mut Point) { vp.x += 10 }))\n" +
    "    assert(mp.at(\"a\").x == 11)\n" +
    "    mut map_acc := 0\n" +
    "    for (k, mv) in &mp { map_acc += k.len + mv.x + mv.y }\n" +
    "    for (_, mv) in move mp { map_acc += mv.x }\n" +
    "    assert(map_acc == (1 + 11 + 2) + (1 + 3 + 4) + 11 + 3)\n" +
    "    mut it := PodIter { cur: 1, end: 4 }\n" +
    "    mut it_sum := 0\n" +
    "    for pv in it { it_sum += pv.x + pv.y }\n" +
    "    assert(it.cur == 1 && it_sum == (1 + 10) + (2 + 20) + (3 + 30))\n" +
    "    mut it2_sum := 0\n" +
    "    for pv in &mut it { it2_sum += pv.x }\n" +
    "    assert(it.cur == 4 && it2_sum == 6)\n" +
    "    region scratch_buf(256) {\n" +
    "        mut sarr: []Point = scratch_buf.alloc(2)\n" +
    "        sarr[0] = Point { x: 40, y: 50 }\n" +
    "        assert(sarr[0].x == 40 && sarr[0].y == 50)\n" +
    "        bump_pod(&mut sarr[0], 2)\n" +
    "        assert(sarr[0].x == 42 && sarr[0].y == 54)\n" +
    "    }\n" +
    "    print(77)\n" +
    "}\n"
}

fn pod_tasks_program() -> string {
    "struct Job { x: i32, y: i32 }\n" +
    "struct WsPod { count: i64, acc: i64 }\n" +
    "struct SharedPod { mul: i32, bias: i32 }\n" +
    "fn init_ws() -> WsPod { WsPod { count: 0, acc: 100 } }\n" +
    "fn worker_val(move j: Job) -> Job { Job { x: j.x * 2, y: j.y + 5 } }\n" +
    "fn worker_ref(j: &Job, ws: &mut WsPod, sp: &SharedPod) -> Job {\n" +
    "    ws.count += 1\n" +
    "    ws.acc += i64(j.x + j.y)\n" +
    "    Job { x: j.x * sp.mul + i32(ws.count), y: j.y + sp.bias + i32(ws.acc) }\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut j := Job { x: 10, y: 20 }\n" +
    "    task scope s1(2) {\n" +
    "        t1 := s1.spawn(worker_val, j.clone())\n" +
    "        j.x = 0\n" +
    "        r_once := t1.join()\n" +
    "        assert(r_once.x == 20 && r_once.y == 25)\n" +
    "    }\n" +
    "    task scope s2(1, init_ws, shared SharedPod { mul: 3, bias: 7 }) {\n" +
    "        a := s2.spawn(worker_ref, Job { x: 4, y: 5 })\n" +
    "        b := s2.spawn(worker_ref, Job { x: 6, y: 7 })\n" +
    "        ra := a.join()\n" +
    "        rb := b.join()\n" +
    "        assert(ra.x == 4 * 3 + 1 && ra.y == 5 + 7 + 109)\n" +
    "        assert(rb.x == 6 * 3 + 2 && rb.y == 7 + 7 + 122)\n" +
    "    }\n" +
    "    print(99)\n" +
    "}\n"
}

fn zero_alloc_program() -> string {
    "struct Vec2 { x: i64, y: i64 }\n" +
    "struct Wide8 { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64 }\n" +
    "fn add_vec(a: Vec2, b: Vec2) -> Vec2 { Vec2 { x: a.x + b.x, y: a.y + b.y } }\n" +
    "fn step_mut(v: &mut Vec2, w: &Wide8) { v = Vec2 { x: v.x + w.a, y: v.y + w.h } }\n" +
    "fn main() {\n" +
    "    mut acc := Vec2 { x: 0, y: 0 }\n" +
    "    w := Wide8 { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 2 }\n" +
    "    for i in 0..1000 {\n" +
    "        cur := Vec2 { x: i64(i), y: i64(i) }\n" +
    "        acc = add_vec(acc.clone(), cur)\n" +
    "        step_mut(&mut acc, &w)\n" +
    "    }\n" +
    "    assert(acc.x == 499500 + 1000 && acc.y == 499500 + 2000)\n" +
    "    print(acc.x + acc.y)\n" +
    "}\n"
}

fn check_program(cli: &harness.BaseCli, work: string, label: string, src_text: string, expected_out: string, include_wasm: bool) -> bool {
    path := work + "/" + label + ".ddr"
    image := work + "/" + label
    if !sys.write_text(path, src_text).ok { return harness.fail(f"cannot write {path}") }
    host := process.host_target()
    mut targets := harness.targets()
    if include_wasm { targets.push("wasm32") }
    mut result := harness.empty_output()
    for target in targets {
        for mode in 0..3 {
            if mode > 0 && target != host { continue }
            mut args: []string = ["build", path.clone(), "--target", target.clone(), "-o", image.clone(), "--jobs", "1"]
            if mode == 1 {
                args.push("--mir=off")
                args.push("--scalar-opt=off")
            } else if mode == 2 {
                args.push("--mir-ssa=off")
            }
            if !harness.run_checked(cli.compiler, args, work, 0, false, &mut result) { return false }
            if target == host || target == "wasm32" {
                if !harness.run_target_image(target, image, work, &mut result) { return false }
                if result.stdout_text() != expected_out + "\n" {
                    return harness.fail(f"{label} ({target}, mode={mode}) output: {result.stdout_text()}")
                }
            }
        }
    }
    true
}

fn run_suite(cli: &harness.BaseCli, work: string) -> bool {
    if !check_program(&cli, work, "pod_core", pod_core_program(), "42", true) { return false }
    if !check_program(&cli, work, "pod_containers", pod_containers_program(), "77", true) { return false }
    if !check_program(&cli, work, "pod_tasks", pod_tasks_program(), "99", false) { return false }

    // Trap ordering with POD value printed immediately prior
    trap_src := "struct Point { x: i32, y: i32 }\n" +
    "fn make(x: i32, y: i32) -> Point { Point { x: x, y: y } }\n" +
    "fn main() { p := make(123, 0); print(p.x); print(1 / p.y) }\n"
    trap_path := work + "/pod_trap.ddr"
    trap_img := work + "/pod_trap"
    if !sys.write_text(trap_path, trap_src).ok { return harness.fail("cannot write pod_trap.ddr") }
    mut res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", trap_path, "-o", trap_img.clone()], work, 0, false, &mut res) { return false }
    res = harness.exec_cmd(trap_img, [], work, false, 30000)
    if !res.ok || res.timed_out || (res.code == 0 && res.signal == 0) || res.stdout_text() != "123\n" {
        return harness.fail(f"expected trap exit with '123\\n', got code={res.code} sig={res.signal} out={res.stdout_text()}")
    }

    // Zero heap allocation proof for stack POD structs
    zero_path := work + "/pod_zero.ddr"
    zero_img := work + "/pod_zero"
    if !sys.write_text(zero_path, zero_alloc_program()).ok { return harness.fail("cannot write pod_zero.ddr") }
    if !harness.run_checked(cli.compiler, ["build", zero_path, "--runtime-profile", "-o", zero_img.clone()], work, 0, false, &mut res) ||
    !harness.run_checked(zero_img, [], work, 0, false, &mut res) { return false }
    prof := json.Doc::parse_text(res.stderr_text())
    counters := prof.field(prof.root, "counters")
    allocs := prof.get_u64(counters, "allocation_count")
    rec_c := prof.get_u64(counters, "record_construct_calls")
    rec_k := prof.get_u64(counters, "record_clone_calls")
    if res.stdout_text() != "1002000\n" || allocs != .Some(u64(0)) || rec_c != .Some(u64(0)) || rec_k != .Some(u64(0)) {
        return harness.fail(f"expected zero heap allocations for stack POD loop: {res.stderr_text()}")
    }

    if !check_empty_variants_zero_alloc(&cli, work) || !check_plain_enum_abi(&cli, work) ||
       !check_phase2a_pod_types(&cli, work) || !check_phase2b_unboxed(&cli, work) ||
       !check_phase2c_fixed(&cli, work) { return false }
    print("POD stack values, hidden return ABI, container boxing, tasks and zero-allocation checks passed.")
    true
}

fn empty_variants_zero_alloc_program() -> string {
    "enum CopyTag {\n" +
    "    Zero,\n" +
    "    One(i32),\n" +
    "    Two,\n" +
    "    Three,\n" +
    "    Four,\n" +
    "    Five(i32, i32),\n" +
    "    Six,\n" +
    "    Seven,\n" +
    "}\n" +
    "enum OwnedTag {\n" +
    "    Z0,\n" +
    "    Items([]i32),\n" +
    "    Z2,\n" +
    "    Z3,\n" +
    "    Z4,\n" +
    "    Text(string),\n" +
    "    Z6,\n" +
    "    Z7,\n" +
    "}\n" +
    "fn score_copy(v: CopyTag) -> i64 {\n" +
    "    match v {\n" +
    "        .Zero => 1,\n" +
    "        .One(n) => i64(n),\n" +
    "        .Two => 2,\n" +
    "        .Three => 3,\n" +
    "        .Four => 4,\n" +
    "        .Five(a, b) => i64(a + b),\n" +
    "        .Six => 6,\n" +
    "        .Seven => 7,\n" +
    "    }\n" +
    "}\n" +
    "fn score_owned(v: &OwnedTag) -> i64 {\n" +
    "    match v {\n" +
    "        .Z0 => 1,\n" +
    "        .Items(xs) => i64(xs.len),\n" +
    "        .Z2 => 2,\n" +
    "        .Z3 => 3,\n" +
    "        .Z4 => 4,\n" +
    "        .Text(s) => i64(s.len),\n" +
    "        .Z6 => 6,\n" +
    "        .Z7 => 7,\n" +
    "    }\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut sum: i64 = 0\n" +
    "    mut cur_c: CopyTag = .Zero\n" +
    "    mut cur_o: OwnedTag = .Z0\n" +
    "    for i in 0..12000 {\n" +
    "        k := i % 6\n" +
    "        cur_c = if k == 0 { .Zero } else if k == 1 { .Two } else if k == 2 { .Three } else if k == 3 { .Four } else if k == 4 { .Six } else { .Seven }\n" +
    "        sum += score_copy(cur_c)\n" +
    "        cur_o = if k == 0 { .Z0 } else if k == 1 { .Z2 } else if k == 2 { .Z3 } else if k == 3 { .Z4 } else if k == 4 { .Z6 } else { .Z7 }\n" +
    "        dup_o := cur_o.clone()\n" +
    "        sum += score_owned(&dup_o)\n" +
    "    }\n" +
    "    print(sum)\n" +
    "}\n"
}

fn plain_enum_abi_program() -> string {
    "enum Kind { Alpha, Beta, Gamma, Delta }\n" +
    "fn kind_code(k: Kind) -> i32 {\n" +
    "    match k {\n" +
    "        .Alpha => 10,\n" +
    "        .Beta => 20,\n" +
    "        .Gamma => 30,\n" +
    "        .Delta => 40,\n" +
    "    }\n" +
    "}\n" +
    "fn bump_local(mut k: Kind) -> i32 {\n" +
    "    before := kind_code(k)\n" +
    "    k = .Gamma\n" +
    "    before + kind_code(k)\n" +
    "}\n" +
    "fn apply(cb: fn(Kind) -> i32, k: Kind) -> i32 { cb(k) }\n" +
    "fn next_kind(k: Kind) -> Kind {\n" +
    "    match k {\n" +
    "        .Alpha => .Beta,\n" +
    "        .Beta => .Gamma,\n" +
    "        .Gamma => .Delta,\n" +
    "        .Delta => .Alpha,\n" +
    "    }\n" +
    "}\n" +
    "fn sum_four(a: Kind, b: Kind, c: Kind, d: Kind) -> i32 {\n" +
    "    kind_code(a) + kind_code(b) + kind_code(c) + kind_code(d)\n" +
    "}\n" +
    "fn main() {\n" +
    "    orig: Kind = .Alpha\n" +
    "    local_sum := bump_local(orig)\n" +
    "    assert(local_sum == 40)\n" +
    "    assert(kind_code(orig) == 10)\n" +
    "    cb: fn(Kind) -> i32 = kind_code\n" +
    "    assert(apply(cb, next_kind(orig)) == 20)\n" +
    "    assert(sum_four(.Alpha, .Beta, .Gamma, .Delta) == 100)\n" +
    "    print(local_sum + apply(cb, .Beta) + sum_four(.Alpha, .Beta, .Gamma, .Delta))\n" +
    "}\n"
}

fn plain_enum_task_program() -> string {
    "enum Kind { Alpha, Beta, Gamma, Delta }\n" +
    "fn kind_code(k: Kind) -> i32 {\n" +
    "    match k {\n" +
    "        .Alpha => 10,\n" +
    "        .Beta => 20,\n" +
    "        .Gamma => 30,\n" +
    "        .Delta => 40,\n" +
    "    }\n" +
    "}\n" +
    "fn main() {\n" +
    "    task scope pool(2) {\n" +
    "        first := pool.spawn(kind_code, .Gamma)\n" +
    "        second := pool.spawn(kind_code, .Delta)\n" +
    "        assert(first.join() == 30)\n" +
    "        print(second.join())\n" +
    "    }\n" +
    "}\n"
}

fn check_empty_variants_zero_alloc(cli: &harness.BaseCli, work: string) -> bool {
    path := work + "/enum_empty_zero.ddr"
    image := work + "/enum_empty_zero"
    if !sys.write_text(path, empty_variants_zero_alloc_program()).ok { return harness.fail("cannot write enum_empty_zero.ddr") }
    mut res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", path, "--runtime-profile", "-o", image.clone()], work, 0, false, &mut res) ||
       !harness.run_checked(image, [], work, 0, false, &mut res) { return false }
    prof := json.Doc::parse_text(res.stderr_text())
    counters := prof.field(prof.root, "counters")
    allocs := prof.get_u64(counters, "allocation_count")
    rec_c := prof.get_u64(counters, "record_construct_calls")
    rec_k := prof.get_u64(counters, "record_clone_calls")
    if res.stdout_text() != "92000\n" || allocs != .Some(u64(0)) || rec_c != .Some(u64(0)) || rec_k != .Some(u64(0)) {
        return harness.fail(f"expected zero heap allocations for fieldless enum variants: stdout={res.stdout_text()} stderr={res.stderr_text()}")
    }
    true
}

fn check_plain_enum_abi(cli: &harness.BaseCli, work: string) -> bool {
    check_program(&cli, work, "plain_enum_abi", plain_enum_abi_program(), "160", true) &&
    check_program(&cli, work, "plain_enum_task", plain_enum_task_program(), "40", false)
}

fn nested_pod_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "impl Eq for Point { fn eq(&self, other: &Self) -> bool { self.x == other.x && self.y == other.y } }\n" +
    "impl Hash for Point { fn hash(&self) -> u64 { self.x.hash().bit_xor(self.y.hash().wrapping_mul(2654435761)) } }\n" +
    "struct Rect { min: Point, max: Point }\n" +
    "struct TaggedRect { label: i64, bounds: Rect, active: bool }\n" +
    "struct BoxHolder { label: string, rect: Rect }\n" +
    "fn rect_max(r: &Rect) -> &Point from r { &r.max }\n" +
    "fn shift_pt(p: &mut Point, dx: i32, dy: i32) { p.x += dx; p.y += dy }\n" +
    "fn make_pair(r: &Rect) -> (Point, Point) { (r.min, r.max) }\n" +
    "fn area_sum(t: &TaggedRect) -> i64 {\n" +
    "    w := i64(t.bounds.max.x - t.bounds.min.x)\n" +
    "    h := i64(t.bounds.max.y - t.bounds.min.y)\n" +
    "    if t.active { t.label + w * h } else { t.label }\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut r := Rect { min: Point { x: 1, y: 2 }, max: Point { x: 10, y: 12 } }\n" +
    "    shift_pt(&mut r.max, 2, 3)\n" +
    "    mref := rect_max(&r)\n" +
    "    assert(mref.x == 12 && mref.y == 15)\n" +
    "    swap(&mut r.min, &mut r.max)\n" +
    "    assert(r.min.x == 12 && r.min.y == 15 && r.max.x == 1 && r.max.y == 2)\n" +
    "    prev_min := replace(&mut r.min, Point { x: 3, y: 4 })\n" +
    "    assert(prev_min.x == 12 && prev_min.y == 15)\n" +
    "    Rect { min, max } := r\n" +
    "    assert(min.x == 3 && min.y == 4 && max.x == 1 && max.y == 2)\n" +
    "    pair := make_pair(&Rect { min: Point { x: 2, y: 3 }, max: Point { x: 7, y: 9 } })\n" +
    "    (pa, pb) := pair\n" +
    "    assert(pa.x == 2 && pa.y == 3 && pb.x == 7 && pb.y == 9)\n" +
    "    t := TaggedRect { label: 10, bounds: Rect { min: Point { x: 1, y: 1 }, max: Point { x: 4, y: 5 } }, active: true }\n" +
    "    assert(area_sum(&t) == 22)\n" +
    "    mut rects: []Rect = []\n" +
    "    rects.push(Rect { min: Point { x: 1, y: 2 }, max: Point { x: 5, y: 6 } })\n" +
    "    rects.push(Rect { min: Point { x: 3, y: 4 }, max: Point { x: 8, y: 9 } })\n" +
    "    mut sum := 0\n" +
    "    for it in &rects { sum += it.min.x + it.max.y }\n" +
    "    assert(sum == 1 + 6 + 3 + 9)\n" +
    "    for it in &mut rects { it.max.x += 10 }\n" +
    "    mut rects_dup := rects.clone()\n" +
    "    rects_dup[0].max.x = 999\n" +
    "    assert(rects[0].max.x == 15 && rects_dup[0].max.x == 999)\n" +
    "    popped := rects_dup.pop()\n" +
    "    assert(popped.max.x == 18)\n" +
    "    h1 := BoxHolder { label: \"box\" + 1.str(), rect: Rect { min: Point { x: 2, y: 4 }, max: Point { x: 6, y: 8 } } }\n" +
    "    mut h2 := h1.clone()\n" +
    "    h2.rect.min.x = 50\n" +
    "    assert(h1.rect.min.x == 2 && h2.rect.min.x == 50)\n" +
    "    mut tset := Set<(Point, Point)>::new()\n" +
    "    _ := tset.insert((Point { x: 1, y: 2 }, Point { x: 3, y: 4 }))\n" +
    "    mut set_sum := 0\n" +
    "    for (sa, sb) in &tset { set_sum += sa.x + sb.y }\n" +
    "    for (sa, sb) in move tset { set_sum += sa.y + sb.x }\n" +
    "    assert(set_sum == 5 + 5)\n" +
    "    print(88)\n" +
    "}\n"
}

fn pod_enum_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "enum Color { Default, RGB(u8, u8, u8) }\n" +
    "enum Shape { Empty, Dot(Point), Box(Point, Point) }\n" +
    "struct Styled { fg: Color, bg: Color, bold: bool }\n" +
    "struct NamedColor { tag: string, color: Color }\n" +
    "fn fg_ref(s: &Styled) -> &Color from s { &s.fg }\n" +
    "fn recolor(c: &mut Color, next: Color) { c = next }\n" +
    "fn color_score(c: &Color) -> i32 {\n" +
    "    match c {\n" +
    "        .Default | .RGB(0, 0, 0) => 1,\n" +
    "        .RGB(r, g, b) => i32(r) + i32(g) + i32(b),\n" +
    "    }\n" +
    "}\n" +
    "fn shape_score(s: Shape) -> i32 {\n" +
    "    match s {\n" +
    "        .Empty => 0,\n" +
    "        .Dot(p) => p.x + p.y,\n" +
    "        .Box(a, b) => a.x + a.y + b.x + b.y,\n" +
    "    }\n" +
    "}\n" +
    "fn check_inner(ok: bool) -> Result<i32, ()> {\n" +
    "    if ok { .Ok(20) } else { .Err }\n" +
    "}\n" +
    "fn check_code(ok: bool) -> Result<i32, i32> {\n" +
    "    if ok { .Ok(10) } else { .Err(404) }\n" +
    "}\n" +
    "fn promote_res(ok: bool) -> Result<u64, ()> {\n" +
    "    v := check_inner(ok)?\n" +
    "    .Ok(u64(v + 5))\n" +
    "}\n" +
    "fn promote_code(ok: bool) -> Result<u64, i32> {\n" +
    "    v := check_code(ok)?\n" +
    "    .Ok(u64(v + 1))\n" +
    "}\n" +
    "fn pair_opt(v: Option<i32>) -> Option<(i32, i32)> {\n" +
    "    x := v?\n" +
    "    .Some((x, x * 2))\n" +
    "}\n" +
    "fn eval_opt(o: &Option<(i32, i32)>) -> i32 {\n" +
    "    match o {\n" +
    "        .Some((x, y)) if y > x => x * 10 + y,\n" +
    "        .Some((x, y)) => x + y,\n" +
    "        .None => -1,\n" +
    "    }\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut c1: Color = .Default\n" +
    "    assert(color_score(&c1) == 1)\n" +
    "    recolor(&mut c1, .RGB(10, 20, 30))\n" +
    "    assert(color_score(&c1) == 60)\n" +
    "    z: Color = .RGB(0, 0, 0)\n" +
    "    assert(color_score(&z) == 1)\n" +
    "    s := Styled { fg: .RGB(1, 2, 3), bg: .Default, bold: true }\n" +
    "    assert(color_score(fg_ref(&s)) == 6 && s.bold)\n" +
    "    sh := Shape.Box(Point { x: 1, y: 2 }, Point { x: 3, y: 4 })\n" +
    "    assert(shape_score(sh) == 10)\n" +
    "    assert(match promote_res(true) { .Ok(n) => n, .Err => 0 } == u64(25))\n" +
    "    assert(match promote_res(false) { .Ok(n) => n, .Err => u64(9) } == u64(9))\n" +
    "    assert(match promote_code(false) { .Ok(_) => 0, .Err(c) => c } == 404)\n" +
    "    p1 := pair_opt(.Some(4))\n" +
    "    p2 := pair_opt(.None)\n" +
    "    assert(eval_opt(&p1) == 48 && eval_opt(&p2) == -1)\n" +
    "    mut cs: []Color = []\n" +
    "    cs.push(.Default)\n" +
    "    cs.push(.RGB(5, 6, 7))\n" +
    "    mut cs_dup := cs.clone()\n" +
    "    cs_dup[0] = .RGB(9, 9, 9)\n" +
    "    assert(color_score(&cs[0]) == 1 && color_score(&cs_dup[0]) == 27)\n" +
    "    assert(color_score(&cs_dup.pop()) == 18)\n" +
    "    nc1 := NamedColor { tag: \"tint\" + 1.str(), color: .RGB(4, 5, 6) }\n" +
    "    mut nc2 := nc1.clone()\n" +
    "    nc2.color = .Default\n" +
    "    assert(color_score(&nc1.color) == 15 && color_score(&nc2.color) == 1)\n" +
    "    print(77)\n" +
    "}\n"
}

fn pod_nested_task_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "struct Rect { min: Point, max: Point }\n" +
    "enum Color { Default, RGB(u8, u8, u8) }\n" +
    "struct RectWs { count: i64, last: Rect }\n" +
    "fn init_ws() -> RectWs {\n" +
    "    RectWs { count: 0, last: Rect { min: Point { x: 0, y: 0 }, max: Point { x: 0, y: 0 } } }\n" +
    "}\n" +
    "fn paint_ws(r: &Rect, ws: &mut RectWs, tint: &Point) -> Option<Color> {\n" +
    "    ws.count += 1\n" +
    "    ws.last = Rect { min: r.min, max: r.max }\n" +
    "    if ws.count == 0 { return .None }\n" +
    "    .Some(.RGB(u8(r.min.x + tint.x), u8(r.max.y + tint.y), u8(ws.count)))\n" +
    "}\n" +
    "fn paint_shared(r: &Rect, tint: &Point) -> Option<Color> {\n" +
    "    .Some(.RGB(u8(r.min.x + tint.x), u8(r.max.y + tint.y), 9))\n" +
    "}\n" +
    "fn step_ws_only(ws: &mut RectWs, tint: &Point) -> Rect {\n" +
    "    ws.count += 1\n" +
    "    Rect { min: Point { x: tint.x, y: tint.y }, max: Point { x: tint.x + i32(ws.count), y: tint.y + 10 } }\n" +
    "}\n" +
    "fn main() {\n" +
    "    r := Rect { min: Point { x: 3, y: 4 }, max: Point { x: 8, y: 10 } }\n" +
    "    task scope s1(1, init_ws, shared Point { x: 2, y: 5 }) {\n" +
    "        a := s1.spawn(paint_ws, r)\n" +
    "        b := s1.spawn(step_ws_only)\n" +
    "        ra := a.join()\n" +
    "        rb := b.join()\n" +
    "        match ra {\n" +
    "            .Some(.RGB(cr, cg, cb)) => assert(cr == 5 && cg == 15 && cb == 1),\n" +
    "            _ => assert(false),\n" +
    "        }\n" +
    "        assert(rb.min.x == 2 && rb.min.y == 5 && rb.max.x == 4 && rb.max.y == 15)\n" +
    "    }\n" +
    "    task scope s2(2, shared Point { x: 7, y: 11 }) {\n" +
    "        c := s2.spawn(paint_shared, r)\n" +
    "        rc := c.join()\n" +
    "        match rc {\n" +
    "            .Some(.RGB(cr, cg, cb)) => assert(cr == 10 && cg == 21 && cb == 9),\n" +
    "            _ => assert(false),\n" +
    "        }\n" +
    "    }\n" +
    "    print(55)\n" +
    "}\n"
}

fn phase2a_zero_alloc_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "struct Rect { min: Point, max: Point }\n" +
    "enum Color { Default, RGB(u8, u8, u8) }\n" +
    "struct Styled { fg: Color, bg: Color, bold: bool }\n" +
    "struct CoordIter { cur: i32, limit: i32 }\n" +
    "impl Iterator for CoordIter {\n" +
    "    fn next(&mut self) -> Option<(i32, i32)> {\n" +
    "        if self.cur >= self.limit { return .None }\n" +
    "        i := self.cur\n" +
    "        self.cur += 1\n" +
    "        .Some((i, i + 1))\n" +
    "    }\n" +
    "}\n" +
    "fn step_color(i: i32) -> Color {\n" +
    "    if i % 3 == 0 { .Default } else { .RGB(u8(i % 200), u8((i + 1) % 200), u8((i + 2) % 200)) }\n" +
    "}\n" +
    "fn mix_styled(s: Styled, extra: &Color) -> i64 {\n" +
    "    fgv := match s.fg { .Default => i64(1), .RGB(r, g, b) => i64(r) + i64(g) + i64(b) }\n" +
    "    exv := match extra { .Default => i64(2), .RGB(r, _, _) => i64(r) }\n" +
    "    fgv + exv + (if s.bold { i64(3) } else { i64(0) })\n" +
    "}\n" +
    "fn opt_step(i: i32) -> Option<i32> {\n" +
    "    if i % 4 == 0 { .None } else { .Some(i % 7) }\n" +
    "}\n" +
    "fn res_step(i: i32) -> Result<u64, ()> {\n" +
    "    x := if i % 5 == 0 { Result<i32, ()>.Err } else { .Ok(i % 9) }?\n" +
    "    .Ok(u64(x + 1))\n" +
    "}\n" +
    "fn bump_rect(r: &mut Rect, d: i32) { r.max.x = r.min.x + d }\n" +
    "fn main() {\n" +
    "    mut sum: i64 = 0\n" +
    "    mut it1 := CoordIter { cur: 0, limit: 253440 }\n" +
    "    for (x, y) in &mut it1 { sum += i64(x % 5) + i64(y % 5) }\n" +
    "    mut it2 := CoordIter { cur: 0, limit: 253440 }\n" +
    "    while true {\n" +
    "        match it2.next() {\n" +
    "            .Some((x, y)) => { sum += i64(x % 3) + i64(y % 3) },\n" +
    "            .None => break,\n" +
    "        }\n" +
    "    }\n" +
    "    mut last_c: Color = .Default\n" +
    "    mut last_r := Rect { min: Point { x: 0, y: 0 }, max: Point { x: 1, y: 1 } }\n" +
    "    for i in 0..10001 {\n" +
    "        c := step_color(i)\n" +
    "        last_c = c\n" +
    "        st := Styled { fg: last_c, bg: .Default, bold: (i % 2 == 0) }\n" +
    "        sum += mix_styled(st, &last_c)\n" +
    "        cur_r := Rect { min: Point { x: i % 11, y: 2 }, max: Point { x: 3, y: 4 } }\n" +
    "        last_r = cur_r\n" +
    "        bump_rect(&mut last_r, 7)\n" +
    "        sum += i64(last_r.max.x)\n" +
    "        sum += i64(opt_step(i).unwrap_or(0))\n" +
    "        sum += match res_step(i) { .Ok(v) => i64(v), .Err => 0 }\n" +
    "    }\n" +
    "    assert(sum > 0)\n" +
    "    print(sum)\n" +
    "}\n"
}

fn check_phase2a_pod_types(cli: &harness.BaseCli, work: string) -> bool {
    if !check_program(&cli, work, "pod_nested", nested_pod_program(), "88", true) { return false }
    if !check_program(&cli, work, "pod_enum", pod_enum_program(), "77", true) { return false }
    if !check_program(&cli, work, "pod_nested_tasks", pod_nested_task_program(), "55", false) { return false }

    path := work + "/phase2a_zero.ddr"
    image := work + "/phase2a_zero"
    if !sys.write_text(path, phase2a_zero_alloc_program()).ok { return harness.fail("cannot write phase2a_zero.ddr") }
    mut res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", path, "--runtime-profile", "-o", image.clone()], work, 0, false, &mut res) ||
       !harness.run_checked(image, [], work, 0, false, &mut res) { return false }
    prof := json.Doc::parse_text(res.stderr_text())
    counters := prof.field(prof.root, "counters")
    allocs := prof.get_u64(counters, "allocation_count")
    rec_c := prof.get_u64(counters, "record_construct_calls")
    rec_k := prof.get_u64(counters, "record_clone_calls")
    if allocs != .Some(u64(0)) || rec_c != .Some(u64(0)) || rec_k != .Some(u64(0)) {
        return harness.fail(f"expected zero heap allocations for Phase 2A POD types/enums/iterators: {res.stderr_text()}")
    }
    true
}

fn unboxed_containers_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "impl Eq for Point { fn eq(&self, other: &Self) -> bool { self.x == other.x && self.y == other.y } }\n" +
    "impl Hash for Point { fn hash(&self) -> u64 { self.x.hash().bit_xor(self.y.hash().wrapping_mul(2654435761)) } }\n" +
    "struct Rect { min: Point, max: Point }\n" +
    "enum Color { Default, RGB(u8, u8, u8) }\n" +
    "fn cscore(c: &Color) -> i32 {\n" +
    "    match c { .Default => 1, .RGB(r, g, b) => i32(r) + i32(g) + i32(b) }\n" +
    "}\n" +
    "fn sum_slice(s: &[]Rect) -> i32 {\n" +
    "    mut acc := 0\n" +
    "    for r in s { acc += r.min.x + r.max.y }\n" +
    "    acc\n" +
    "}\n" +
    "fn sum_cslice(s: &[]Color) -> i32 {\n" +
    "    mut acc := 0\n" +
    "    for c in s { acc += cscore(&c) }\n" +
    "    acc\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut rs: []Rect = []\n" +
    "    rs.push(Rect { min: Point { x: 1, y: 2 }, max: Point { x: 3, y: 4 } })\n" +
    "    for i in 1..25 {\n" +
    "        rs.push(rs[0])\n" +
    "        rs[rs.len - 1].max.x += i\n" +
    "    }\n" +
    "    assert(rs.len == 25 && rs[0].min.x == 1 && rs[24].max.x == 27)\n" +
    "    assert(sum_slice(&rs[1..4]) == 3 * (1 + 4))\n" +
    "    assert((&rs[..]).len == 25 && (&rs[1..4])[1].max.x == 5)\n" +
    "    p_last := rs.pop()\n" +
    "    assert(p_last.max.x == 27 && rs.len == 24)\n" +
    "    r_first := rs.remove(0)\n" +
    "    r_mid := rs.remove(5)\n" +
    "    r_end := rs.remove(rs.len - 1)\n" +
    "    assert(r_first.max.x == 3 && r_mid.max.x == 9 && r_end.max.x == 26 && rs.len == 21)\n" +
    "    rs.swap(0, rs.len - 1)\n" +
    "    assert(rs[0].max.x == 25 && rs[rs.len - 1].max.x == 4)\n" +
    "    rs.swap(0, 1)\n" +
    "    assert(rs[0].max.x == 5 && rs[1].max.x == 25)\n" +
    "    mut rs_other := Rect { min: Point { x: 1, y: 2 }, max: Point { x: 77, y: 88 } }\n" +
    "    swap(&mut rs[0], &mut rs_other)\n" +
    "    assert(rs[0].max.x == 77 && rs_other.max.x == 5)\n" +
    "    swap(&mut rs[0], &mut rs_other)\n" +
    "    old0 := replace(&mut rs[0], Rect { min: Point { x: 9, y: 10 }, max: Point { x: 11, y: 12 } })\n" +
    "    assert(old0.max.x == 5 && rs[0].max.x == 11)\n" +
    "    mut rs_clone := rs.clone()\n" +
    "    rs_clone[0].min.x = 999\n" +
    "    assert(rs[0].min.x == 9 && rs_clone[0].min.x == 999)\n" +
    "    rs_clone.truncate(4)\n" +
    "    assert(rs_clone.len == 4 && rs_clone[3].max.x == 7)\n" +
    "    rs_clone.clear()\n" +
    "    assert(rs_clone.len == 0)\n" +
    "    mut rs_for := rs.clone()\n" +
    "    for r in &mut rs_for { r.max.x += 1 }\n" +
    "    assert(rs_for[0].max.x == 12 && rs[0].max.x == 11)\n" +
    "    mut fsum := 0\n" +
    "    for r in rs { fsum += r.min.x }\n" +
    "    for (idx, r) in (move rs_for).enumerate() { if idx == 0 { fsum += r.max.x } }\n" +
    "    assert(fsum > 0)\n" +
    "    mut cs: []Color = []\n" +
    "    for i in 0..18 {\n" +
    "        if i % 2 == 0 { cs.push(.Default) } else { cs.push(.RGB(u8(i), 1, 2)) }\n" +
    "    }\n" +
    "    assert(sum_cslice(&cs[0..3]) == 1 + (1 + 1 + 2) + 1)\n" +
    "    assert(cscore(&cs.remove(1)) == 4 && cscore(&cs.pop()) == 20)\n" +
    "    mut cs2 := cs.clone()\n" +
    "    cs2[0] = .RGB(7, 8, 9)\n" +
    "    assert(cscore(&cs[0]) == 1 && cscore(&cs2[0]) == 24)\n" +
    "    mut empty_cs: [Color; 0] = [.Default; 0]\n" +
    "    assert(empty_cs.len == 0)\n" +
    "    mut fp: [Point; 3] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 6 }]\n" +
    "    fp.swap(0, 2)\n" +
    "    assert(fp[0].x == 5 && fp[2].x == 1)\n" +
    "    mut fpsum := 0\n" +
    "    for p in fp { fpsum += p.x + p.y }\n" +
    "    assert(fpsum == 21)\n" +
    "    mut ip: [](i32, i32) = [(1, 2), (3, 4)]\n" +
    "    mut pp: [](Point, Point) = [(Point { x: 1, y: 2 }, Point { x: 3, y: 4 }), (Point { x: 5, y: 6 }, Point { x: 7, y: 8 })]\n" +
    "    mut tsum := 0\n" +
    "    for (a, b) in &ip { tsum += a + b }\n" +
    "    for (a, b) in move ip { tsum += a * b }\n" +
    "    for (a, b) in &pp { tsum += a.x + b.y }\n" +
    "    for (a, b) in move pp { tsum += a.y + b.x }\n" +
    "    assert(tsum == (3 + 7) + (2 + 12) + (5 + 13) + (5 + 13))\n" +
    "    mut mpc := Map<Point, Color>::new()\n" +
    "    k1 := Point { x: 1, y: 2 }; k2 := Point { x: 3, y: 4 }\n" +
    "    mpc.put(k1, .RGB(10, 20, 30))\n" +
    "    mpc.put(k2, .Default)\n" +
    "    _ := mpc.entry_or_insert(Point { x: 5, y: 6 }, .RGB(1, 2, 3))\n" +
    "    assert(cscore(mpc.at(k1)) == 60)\n" +
    "    assert(mpc.update(k2, fn[](c: &mut Color) { c = .RGB(4, 5, 6) }))\n" +
    "    mut mpc2 := mpc.clone()\n" +
    "    assert(mpc2.remove(k1) && mpc.get(k1).is_some())\n" +
    "    match mpc2.take(k2) {\n" +
    "        .Some(c) => assert(cscore(&c) == 15),\n" +
    "        .None => assert(false),\n" +
    "    }\n" +
    "    mut msum := 0\n" +
    "    for (mk, mv) in &mpc { msum += mk.x + cscore(&mv) }\n" +
    "    for (mk, mv) in move mpc { msum += mk.y + cscore(&mv) }\n" +
    "    assert(msum == (1 + 60 + 3 + 15 + 5 + 6) + (2 + 60 + 4 + 15 + 6 + 6))\n" +
    "    mut mir := Map<i32, Rect>::new()\n" +
    "    mir.put(1, Rect { min: Point { x: 2, y: 3 }, max: Point { x: 4, y: 5 } })\n" +
    "    assert(mir.at(1).max.y == 5)\n" +
    "    mut pset := Set<(Point, Point)>::new()\n" +
    "    _ := pset.insert((Point { x: 2, y: 3 }, Point { x: 4, y: 5 }))\n" +
    "    _ := pset.insert((Point { x: 6, y: 7 }, Point { x: 8, y: 9 }))\n" +
    "    mut ssum := 0\n" +
    "    for (sa, sb) in &pset { ssum += sa.x + sb.y }\n" +
    "    for (sa, sb) in move pset { ssum += sa.y + sb.x }\n" +
    "    assert(ssum == (2 + 5 + 6 + 9) + (3 + 4 + 7 + 8))\n" +
    "    print(66)\n" +
    "}\n"
}

fn unboxed_containers_task_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "struct Rect { min: Point, max: Point }\n" +
    "enum Color { Default, RGB(u8, u8, u8) }\n" +
    "fn scale_rects(move items: []Rect) -> []Rect {\n" +
    "    mut out := move items\n" +
    "    for r in &mut out {\n" +
    "        r.min.x += 10\n" +
    "        r.max.y += 20\n" +
    "    }\n" +
    "    out\n" +
    "}\n" +
    "fn sum_colors(cols: &[]Color) -> Rect {\n" +
    "    mut acc := 0\n" +
    "    for c in cols {\n" +
    "        acc += match c { .Default => 1, .RGB(r, g, b) => i32(r) + i32(g) + i32(b) }\n" +
    "    }\n" +
    "    Rect { min: Point { x: acc, y: cols.len }, max: Point { x: acc + 1, y: acc + 2 } }\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut rects: []Rect = [Rect { min: Point { x: 1, y: 2 }, max: Point { x: 3, y: 4 } },\n" +
    "                         Rect { min: Point { x: 5, y: 6 }, max: Point { x: 7, y: 8 } }]\n" +
    "    cols: []Color = [.Default, .RGB(3, 4, 5), .RGB(1, 2, 3)]\n" +
    "    task scope pool(2) {\n" +
    "        t1 := pool.spawn(scale_rects, move rects)\n" +
    "        t2 := pool.spawn(sum_colors, cols)\n" +
    "        r1 := t1.join()\n" +
    "        r2 := t2.join()\n" +
    "        assert(r1.len == 2 && r1[0].min.x == 11 && r1[1].max.y == 28)\n" +
    "        assert(r2.min.x == 19 && r2.min.y == 3 && r2.max.y == 21)\n" +
    "    }\n" +
    "    print(44)\n" +
    "}\n"
}

fn phase2b_unboxed_profile_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "impl Eq for Point { fn eq(&self, other: &Self) -> bool { self.x == other.x && self.y == other.y } }\n" +
    "impl Hash for Point { fn hash(&self) -> u64 { self.x.hash().bit_xor(self.y.hash().wrapping_mul(2654435761)) } }\n" +
    "enum Color { Default, RGB(u8, u8, u8) }\n" +
    "fn main() {\n" +
    "    mut pts: []Point = []\n" +
    "    pts.reserve(10000)\n" +
    "    for i in 0..10000 {\n" +
    "        pts.push(Point { x: i, y: i + 1 })\n" +
    "    }\n" +
    "    mut sum: i64 = 0\n" +
    "    for p in &pts { sum += i64(p.x + p.y) }\n" +
    "    for p in &mut pts { p.x += 1 }\n" +
    "    sl := &pts[100..200]\n" +
    "    sum += i64(sl[0].x + sl[99].y)\n" +
    "    pts.swap(0, 1)\n" +
    "    _ := replace(&mut pts[0], Point { x: 7, y: 8 })\n" +
    "    for _ in 0..100 { sum += i64(pts.pop().x) }\n" +
    "    for _ in 0..10 { sum += i64(pts.remove(0).y) }\n" +
    "    mut pts_dup := pts.clone()\n" +
    "    sum += i64(pts_dup[0].x)\n" +
    "    pts_dup.clear()\n" +
    "    pts.clear()\n" +
    "    mut cols: []Color = []\n" +
    "    cols.reserve(10000)\n" +
    "    for i in 0..10000 {\n" +
    "        if i % 2 == 0 { cols.push(.Default) } else { cols.push(.RGB(u8(i % 200), 1, 2)) }\n" +
    "    }\n" +
    "    for _ in 0..100 {\n" +
    "        c := cols.pop()\n" +
    "        sum += match c { .Default => i64(1), .RGB(r, g, b) => i64(r) + i64(g) + i64(b) }\n" +
    "    }\n" +
    "    mut mp := Map<Point, Color>::new()\n" +
    "    mp.reserve(256)\n" +
    "    for i in 0..100 {\n" +
    "        mp.put(Point { x: i, y: i * 2 }, if i % 2 == 0 { .Default } else { .RGB(u8(i), 2, 3) })\n" +
    "    }\n" +
    "    for i in 0..100 {\n" +
    "        c := mp.at(Point { x: i, y: i * 2 })\n" +
    "        sum += match c { .Default => i64(1), .RGB(r, g, b) => i64(r) + i64(g) + i64(b) }\n" +
    "    }\n" +
    "    assert(mp.update(Point { x: 5, y: 10 }, fn[](c: &mut Color) { c = .RGB(9, 9, 9) }))\n" +
    "    for i in 0..10 { _ := mp.remove(Point { x: i, y: i * 2 }) }\n" +
    "    for (k, v) in &mp {\n" +
    "        sum += i64(k.x) + match v { .Default => i64(1), .RGB(r, g, b) => i64(r) + i64(g) + i64(b) }\n" +
    "    }\n" +
    "    assert(sum > 0)\n" +
    "    print(sum)\n" +
    "}\n"
}

fn check_phase2b_unboxed(cli: &harness.BaseCli, work: string) -> bool {
    if !check_program(&cli, work, "pod_unboxed_containers", unboxed_containers_program(), "66", true) { return false }
    if !check_program(&cli, work, "pod_unboxed_tasks", unboxed_containers_task_program(), "44", false) { return false }

    path := work + "/phase2b_profile.ddr"
    image := work + "/phase2b_profile"
    if !sys.write_text(path, phase2b_unboxed_profile_program()).ok { return harness.fail("cannot write phase2b_profile.ddr") }
    mut res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", path, "--runtime-profile", "-o", image.clone()], work, 0, false, &mut res) ||
       !harness.run_checked(image, [], work, 0, false, &mut res) { return false }
    prof := json.Doc::parse_text(res.stderr_text())
    counters := prof.field(prof.root, "counters")
    allocs := prof.get_u64(counters, "allocation_count")
    rec_c := prof.get_u64(counters, "record_construct_calls")
    rec_b := prof.get_u64(counters, "record_construct_bytes")
    rec_k := prof.get_u64(counters, "record_clone_calls")
    ok_allocs := match allocs { .Some(n) => n <= u64(15), .None => false }
    if !ok_allocs || rec_c != .Some(u64(1)) || rec_b != .Some(u64(24)) || rec_k != .Some(u64(0)) {
        return harness.fail(f"expected unboxed POD containers with <= 15 allocs, 1 map header (24B), and 0 record clones: {res.stderr_text()}")
    }
    true
}

fn pod_fixed_arrays_program() -> string {
    "const LUT: [f64; 2] = [3.0, 4.0]\n" +
    "struct Point { x: i32, y: i32 }\n" +
    "enum Mode { Idle, Active }\n" +
    "struct Modes { list: [Mode; 3], count: i32 }\n" +
    "struct Mat2 { rows: [[f64; 2]; 2] }\n" +
    "enum Cell { Empty, Pos([f64; 2]) }\n" +
    "@c_layout struct C3 { a: [f32; 3], b: i32 }\n" +
    "@c_layout struct C5 { a: [u8; 5], b: u32 }\n" +
    "struct Named { tag: string, pos: [f64; 2] }\n" +
    "enum Msg { Pos([f64; 2]), Text(string) }\n" +
    "struct BigCopy { a: [f64; 2], b: [i32; 100] }\n" +
    "fn dot2(a: [f64; 2], b: [f64; 2]) -> f64 { a[0] * b[0] + a[1] * b[1] }\n" +
    "fn scale2(a: [f64; 2], s: f64) -> [f64; 2] { [a[0] * s, a[1] * s] }\n" +
    "fn bump2(a: &mut [f64; 2], d: f64) { a[0] = a[0] + d; a[1] = a[1] + d }\n" +
    "fn opt_arr(ok: bool) -> Option<[f64; 2]> { if ok { .Some([7.0, 8.0]) } else { .None } }\n" +
    "fn res_arr(ok: bool) -> Result<[f64; 2], [f32; 3]> {\n" +
    "    if ok { return .Ok([1.0, 2.0]) }\n" +
    "    .Err([f32(3.0), f32(4.0), f32(5.0)])\n" +
    "}\n" +
    "fn maybe_sum(ok: bool) -> Result<f64, [f32; 3]> {\n" +
    "    v := res_arr(ok)?\n" +
    "    .Ok(v[0] + v[1])\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut a: [f64; 2] = [1.5, 2.5]\n" +
    "    mut b := a\n" +
    "    b[0] = 99.0\n" +
    "    assert(a[0] == 1.5 && a[1] == 2.5 && b[0] == 99.0 && b.len == 2 && len(a) == 2)\n" +
    "    assert(dot2(a, LUT) == 1.5 * 3.0 + 2.5 * 4.0)\n" +
    "    bump2(&mut b, 1.0)\n" +
    "    assert(b[0] == 100.0 && b[1] == 3.5 && a[0] == 1.5)\n" +
    "    b.swap(0, 1)\n" +
    "    assert(b[0] == 3.5 && b[1] == 100.0)\n" +
    "    mut lut_copy := LUT\n" +
    "    lut_copy[0] = 12.0\n" +
    "    assert(LUT[0] == 3.0 && lut_copy[0] == 12.0)\n" +
    "    local_lut: [i32; 4] = [1, 2, 3, 4]\n" +
    "    assert(local_lut[2] == 3 && LUT.len == 2)\n" +
    "    mut s_acc := 0.0\n" +
    "    for x in a { s_acc += x }\n" +
    "    for x in &a { s_acc += x }\n" +
    "    for x in move a { s_acc += x }\n" +
    "    for x in LUT { s_acc += x }\n" +
    "    for x in &b[0..2] { s_acc += x }\n" +
    "    snap := a.clone().iter()\n" +
    "    a[0] = 0.0\n" +
    "    for x in snap { s_acc += x }\n" +
    "    assert(s_acc == 4.0 * 3.0 + 7.0 + 103.5 + 4.0)\n" +
    "    scaled := scale2(LUT, 2.0)\n" +
    "    assert(scaled[0] == 6.0 && scaled[1] == 8.0)\n" +
    "    mut f4: [f32; 4] = [f32(1.0), f32(2.0), f32(3.0), f32(4.0)]\n" +
    "    f4_c := f4\n" +
    "    f4[3] = f32(40.0)\n" +
    "    assert(f4_c[3] == f32(4.0) && f4[3] == f32(40.0))\n" +
    "    mut b16 := [u8(0); 16]\n" +
    "    b16[15] = u8(250)\n" +
    "    b16_c := b16\n" +
    "    b16[0] = u8(9)\n" +
    "    assert(b16_c[0] == u8(0) && b16_c[15] == u8(250) && b16[0] == u8(9))\n" +
    "    mut tbl8 := [10, 20, 30, 40, 50, 60, 70, 80]\n" +
    "    tbl8_c := tbl8\n" +
    "    tbl8[4] = 999\n" +
    "    assert(tbl8_c[4] == 50 && tbl8[4] == 999)\n" +
    "    mut pts4 := [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 6 }, Point { x: 7, y: 8 }]\n" +
    "    pts4_c := pts4\n" +
    "    pts4[2].x = 55\n" +
    "    assert(pts4_c[2].x == 5 && pts4[2].x == 55)\n" +
    "    rep3 := [Point { x: 2, y: 3 }; 3]\n" +
    "    assert(rep3[0].x == 2 && rep3[2].y == 3)\n" +
    "    mut mat := Mat2 { rows: [[1.0, 2.0], [3.0, 4.0]] }\n" +
    "    mat_c := mat\n" +
    "    mat.rows[1][0] = 33.0\n" +
    "    assert(mat_c.rows[1][0] == 3.0 && mat.rows[1][0] == 33.0)\n" +
    "    mut c_enum := Cell.Pos([5.0, 6.0])\n" +
    "    c_enum_c := c_enum\n" +
    "    c_enum = .Empty\n" +
    "    match c_enum_c { .Pos(v) => assert(v[0] == 5.0 && v[1] == 6.0), .Empty => assert(false) }\n" +
    "    assert(match c_enum { .Empty => true, .Pos(_) => false })\n" +
    "    modes := Modes { list: [.Idle, .Active, .Idle], count: 3 }\n" +
    "    assert(modes.list[0] == .Idle && modes.list[1] == .Active && modes.count == 3)\n" +
    "    match opt_arr(true) { .Some(v) => assert(v[0] == 7.0 && v[1] == 8.0), .None => assert(false) }\n" +
    "    match maybe_sum(false) { .Ok(_) => assert(false), .Err(e) => assert(e[2] == f32(5.0)) }\n" +
    "    // Odd-byte [f32; 3] (12B) and [u8; 5] (5B) inside @c_layout must never clobber adjacent fields\n" +
    "    mut c3 := C3 { a: [f32(1.0), f32(2.0), f32(3.0)], b: 777 }\n" +
    "    mut c3_other := C3 { a: [f32(4.0), f32(5.0), f32(6.0)], b: 888 }\n" +
    "    c3.a = [f32(10.0), f32(20.0), f32(30.0)]\n" +
    "    assert(c3.b == 777 && c3.a[2] == f32(30.0))\n" +
    "    prev3 := replace(&mut c3.a, [f32(7.0), f32(8.0), f32(9.0)])\n" +
    "    assert(prev3[0] == f32(10.0) && c3.b == 777 && c3.a[1] == f32(8.0))\n" +
    "    swap(&mut c3.a, &mut c3_other.a)\n" +
    "    assert(c3.b == 777 && c3_other.b == 888 && c3.a[0] == f32(4.0) && c3_other.a[0] == f32(7.0))\n" +
    "    C3 { a: d3, b: b3 } := c3\n" +
    "    assert(d3[2] == f32(6.0) && b3 == 777)\n" +
    "    mut c5 := C5 { a: [u8(1), u8(2), u8(3), u8(4), u8(5)], b: u32(123456789) }\n" +
    "    c5.a = [u8(9), u8(8), u8(7), u8(6), u8(5)]\n" +
    "    assert(c5.b == u32(123456789) && c5.a[0] == u8(9) && c5.a[4] == u8(5))\n" +
    "    // Containers & boxed fixed arrays in non-POD types\n" +
    "    mut vecs: [][f64; 2] = [[1.0, 2.0], [3.0, 4.0]]\n" +
    "    vecs.push([5.0, 6.0])\n" +
    "    vecs[1][0] = 30.0\n" +
    "    assert(vecs.pop()[1] == 6.0 && vecs[1][0] == 30.0)\n" +
    "    mut mp := Map<i32, [f64; 2]>::new()\n" +
    "    mp.put(1, [9.0, 10.0])\n" +
    "    assert(mp.at(1)[1] == 10.0)\n" +
    "    mut named := Named { tag: \"k\" + 1.str(), pos: [11.0, 12.0] }\n" +
    "    mut named_c := named.clone()\n" +
    "    named.pos = [91.0, 92.0]\n" +
    "    named_ext := named.pos\n" +
    "    assert(named_ext[0] == 91.0 && named_c.pos[0] == 11.0)\n" +
    "    msg := Msg.Pos([13.0, 14.0])\n" +
    "    msg_c := msg.clone()\n" +
    "    match &msg_c { .Pos(pv) => assert(pv[0] == 13.0 && pv[1] == 14.0), .Text(_) => assert(false) }\n" +
    "    mut big := BigCopy { a: [1.0, 2.0], b: [5; 100] }\n" +
    "    mut big_c := big\n" +
    "    big.b[0] = 999\n" +
    "    assert(big_c.b[0] == 5 && big.b[0] == 999 && big_c.a[1] == 2.0)\n" +
    "    mut big100 := [7; 100]\n" +
    "    big100_c := big100\n" +
    "    big100[99] = 42\n" +
    "    assert(big100_c[99] == 7 && big100[99] == 42)\n" +
    "    mut z := 10\n" +
    "    prefix_typed: [i64; 3] = [1, 2, i64(z)]\n" +
    "    assert(prefix_typed[0] == i64(1) && prefix_typed[2] == i64(10))\n" +
    "    print(55)\n" +
    "}\n"
}

fn pod_fixed_tasks_program() -> string {
    "struct NonPodWs { log: string, vec: [f64; 2] }\n" +
    "struct SharedCfg { scale: [f64; 2] }\n" +
    "fn init_ws() -> NonPodWs { NonPodWs { log: \"ok\" + 1.str(), vec: [2.0, 3.0] } }\n" +
    "fn worker_val(move v: [f64; 2]) -> [f64; 2] { [v[0] * 10.0, v[1] + 5.0] }\n" +
    "fn worker_ref(v: &[f64; 2], ws: &mut NonPodWs, sc: &SharedCfg) -> [f64; 2] {\n" +
    "    ws.vec[0] = ws.vec[0] + v[0]\n" +
    "    [ws.vec[0] * sc.scale[0], v[1] + sc.scale[1]]\n" +
    "}\n" +
    "fn main() {\n" +
    "    mut arr: [f64; 2] = [3.0, 4.0]\n" +
    "    task scope s1(2) {\n" +
    "        t := s1.spawn(worker_val, move arr)\n" +
    "        arr[0] = 0.0\n" +
    "        r := t.join()\n" +
    "        assert(r[0] == 30.0 && r[1] == 9.0)\n" +
    "    }\n" +
    "    task scope s2(1, init_ws, shared SharedCfg { scale: [2.0, 10.0] }) {\n" +
    "        t1 := s2.spawn(worker_ref, [5.0, 6.0])\n" +
    "        t2 := s2.spawn(worker_ref, [1.0, 2.0])\n" +
    "        r1 := t1.join()\n" +
    "        r2 := t2.join()\n" +
    "        assert(r1[0] == 14.0 && r1[1] == 16.0)\n" +
    "        assert(r2[0] == 16.0 && r2[1] == 12.0)\n" +
    "    }\n" +
    "    task scope jobs {\n" +
    "        h := jobs.spawn(worker_val, [3.0, 4.0])\n" +
    "        rh := h.join()\n" +
    "        assert(rh[0] == 30.0 && rh[1] == 9.0)\n" +
    "    }\n" +
    "    print(33)\n" +
    "}\n"
}

fn phase2c_fixed_profile_program() -> string {
    "struct Point { x: i32, y: i32 }\n" +
    "struct Mat2 { rows: [[f64; 2]; 2] }\n" +
    "enum Cell { Empty, Pos([f64; 2]) }\n" +
    "fn dot(a: [f64; 2], b: [f64; 2]) -> f64 { a[0] * b[0] + a[1] * b[1] }\n" +
    "fn step(v: [f64; 2]) -> [f64; 2] { [v[0] + 1.0, v[1] + 2.0] }\n" +
    "fn main() {\n" +
    "    mut acc := 0.0\n" +
    "    mut v: [f64; 2] = [1.0, 2.0]\n" +
    "    for i in 0..10001 {\n" +
    "        c := v\n" +
    "        v = step(c)\n" +
    "        for x in &c[0..2] { acc += x }\n" +
    "        for x in c { acc += x }\n" +
    "        acc += dot(c, v)\n" +
    "        if i % 10 == 0 {\n" +
    "            f4: [f32; 4] = [f32(1.0), f32(2.0), f32(3.0), f32(4.0)]\n" +
    "            f3: [f32; 3] = [f32(5.0), f32(6.0), f32(7.0)]\n" +
    "            pts4 := [Point { x: 1, y: 2 }; 4]\n" +
    "            m := Mat2 { rows: [c, [3.0, 4.0]] }\n" +
    "            cell := Cell.Pos(c)\n" +
    "            acc += f64(f4[0] + f3[2]) + f64(pts4[3].y) + m.rows[1][1]\n" +
    "            match cell { .Pos(p) => { acc += p[0] }, .Empty => {} }\n" +
    "        }\n" +
    "    }\n" +
    "    assert(acc > 0.0)\n" +
    "    print(10001)\n" +
    "}\n"
}

fn check_phase2c_fixed(cli: &harness.BaseCli, work: string) -> bool {
    if !check_program(&cli, work, "pod_fixed_arrays", pod_fixed_arrays_program(), "55", true) { return false }
    if !check_program(&cli, work, "pod_fixed_tasks", pod_fixed_tasks_program(), "33", false) { return false }

    path := work + "/phase2c_profile.ddr"
    image := work + "/phase2c_profile"
    if !sys.write_text(path, phase2c_fixed_profile_program()).ok { return harness.fail("cannot write phase2c_profile.ddr") }
    mut res := harness.empty_output()
    if !harness.run_checked(cli.compiler, ["build", path, "--runtime-profile", "-o", image.clone()], work, 0, false, &mut res) ||
       !harness.run_checked(image, [], work, 0, false, &mut res) { return false }
    prof := json.Doc::parse_text(res.stderr_text())
    counters := prof.field(prof.root, "counters")
    allocs := prof.get_u64(counters, "allocation_count")
    rec_c := prof.get_u64(counters, "record_construct_calls")
    rec_k := prof.get_u64(counters, "record_clone_calls")
    arr_k := prof.get_u64(counters, "array_clone_calls")
    if res.stdout_text() != "10001\n" || allocs != .Some(u64(0)) || rec_c != .Some(u64(0)) ||
       rec_k != .Some(u64(0)) || arr_k != .Some(u64(0)) {
        return harness.fail(f"expected zero allocations and clones for 10,001 [f64; 2] copies: {res.stderr_text()}")
    }
    true
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    tmp := fs.temp_dir("dunder-pod-values-")
    if !tmp.ok { _ := harness.fail("temp_dir failed"); return 1 }
    work := tmp.value
    defer { _ := fs.remove_all(work) }
    if run_suite(&cli, work) { 0 } else { 1 }
}
