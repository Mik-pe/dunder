capability process, filesystem, stdio

import .harness as harness
import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.text as text
import sys

fn expected_message(diagnostics: &json.Doc, fixtures: string, source: string) -> string {
    if text.starts_with(source, fixtures) {
        key := source[fixtures.len..source.len]
        expected := diagnostics.get_str(diagnostics.root, key)
        if expected.is_some() { return expected.unwrap() }
    }
    input := sys.read_text(source)
    if !input.ok { return "" }
    mut message := ""
    for line in harness.lines(input.value) {
        if text.starts_with(line, "// error: ") {
            if message.len > 0 { return "" }
            if line.len == 10 { return "" }
            message = line[10..line.len]
        }
    }
    message
}

fn check_fixture(compiler: string, source: string, work: string, expected: string) -> string {
    if expected.len == 0 { return f"missing diagnostic for {source}" }
    src_meta := sys.metadata(source)
    if !src_meta.ok || !src_meta.is_file { return f"could not stat {source}" }

    mut previous: []u8 = []
    bytes.append_utf8(&mut previous, "previous successful output")
    output := work + "/image"
    suite := work + "/suite"
    if !fs.mkdir_all(suite).ok { return "mkdir_all failed on " + suite }
    receipt := suite + "/keep"
    if !sys.write_u8(receipt, &previous).ok { return "write_u8 failed on " + receipt }

    modes: []string = ["check", "build", "build-tests", "test"]
    for command in modes {
        if !sys.write_u8(output, &previous).ok { return "write_u8 failed on " + output }
        mut args: []string = [command.clone(), source.clone()]
        if command == "check" {
            args.push("--agent")
        } else if command == "test" {
            args.push("-o")
            args.push(suite.clone())
        } else {
            args.push("-o")
            args.push(output.clone())
        }

        res := harness.exec_cmd(compiler, args, work, false, 30000)
        stdout_str := res.stdout_text()
        stderr_str := res.stderr_text()
        mut message := stderr_str
        exit_code := res.code
        rejected := res.ok && !res.timed_out && res.signal == 0 && exit_code == 1

        if command == "check" && rejected {
            lines := harness.lines(stdout_str)
            if lines.len == 0 { return "invalid diagnostic JSON: " + stdout_str }
            mut matched_msg := ""
            for li in 0..lines.len {
                doc := json.Doc::parse_text(lines[li])
                if !doc.ok || doc.kind(doc.root) != .Object {
                    return "invalid diagnostic JSON: " + stdout_str
                }
                kind_f := doc.get_str(doc.root, "kind")
                if kind_f.is_none() { return "invalid diagnostic fields: " + lines[li] }
                kind_s := kind_f.unwrap()
                if li == lines.len - 1 && kind_s != "failed" {
                    return "missing failed diagnostic footer: " + stdout_str
                }
                if kind_s == "error" && matched_msg.len == 0 {
                    code_f := doc.get_str(doc.root, "code")
                    path_f := doc.get_str(doc.root, "path")
                    start_f := doc.get_i64(doc.root, "start")
                    end_f := doc.get_i64(doc.root, "end")
                    msg_f := doc.get_str(doc.root, "message")
                    note_f := doc.get_str(doc.root, "note")
                    if code_f.is_none() || path_f.is_none() || start_f.is_none() || end_f.is_none() || msg_f.is_none() {
                        return "invalid diagnostic fields: " + lines[li]
                    }
                    code_v := code_f.unwrap()
                    if code_v == "E1000" { return "invalid diagnostic fields: " + lines[li] }
                    path_v := path_f.unwrap()
                    start_v := start_f.unwrap(); end_v := end_f.unwrap()
                    msg_v := msg_f.unwrap()
                    rp := fs.realpath(path_v)
                    if !rp.ok || rp.value != source {
                        return "diagnostic path mismatch: " + path_v + " vs " + source
                    }
                    if start_v < 0 || start_v > end_v || end_v > src_meta.size {
                        return "invalid diagnostic span: " + lines[li]
                    }
                    if text.contains(msg_v, expected) { matched_msg = msg_v }
                    else if note_f.is_some() {
                        note_v := note_f.unwrap()
                        if text.contains(note_v, expected) { matched_msg = note_v }
                    }
                }
            }
            if matched_msg.len == 0 {
                return "missing matching error in agent JSON: " + stdout_str
            }
            message = matched_msg
        }

        if !rejected || !text.contains(message, expected) {
            return command + " exited " + exit_code.str() + ": " + message + "\n" + stdout_str
        }

        out_now := sys.read_u8(output)
        rec_now := sys.read_u8(receipt)
        suite_ok := match fs.list_dir(suite) {
            .Ok(entries) => entries.len == 1 && entries[0] == "keep",
            .Err(_) => false,
        }
        if !out_now.ok || !bytes.equal(&out_now.value, &previous) ||
           !rec_now.ok || !bytes.equal(&rec_now.value, &previous) ||
           !suite_ok {
            return command + " modified existing output"
        }
    }
    ""
}

pub fn run_suite(cli: &harness.BaseCli) -> bool {
    mut sources: []string = []
    if cli.extra_args.len > 0 {
        for raw in cli.extra_args {
            if text.starts_with(raw, "-") {
                return harness.fail("unknown option: " + raw)
            }
            rp := fs.realpath(raw)
            if !rp.ok {
                return harness.fail("compile-fail fixture not found: " + raw)
            }
            sources.push(move rp.value)
        }
        array.sort<string>(&mut sources)
    } else {
        sources = harness.collect_error_fixtures(cli.root)
    }
    if sources.len == 0 {
        return harness.fail("no compile-fail fixtures found")
    }

    fixtures := f"{cli.root}/tests/fixtures/"
    diagnostics := harness.fixture_diagnostics(cli.root)
    if !diagnostics.ok { return harness.fail("could not read fixture diagnostics") }
    tmp := fs.temp_dir("dunder-diagnostics-")
    if !tmp.ok {
        return harness.fail("temp_dir failed")
    }
    mut failed := 0
    for source in sources {
        name := harness.basename(source)
        expected := expected_message(&diagnostics, fixtures, source)
        err := check_fixture(cli.compiler, source, tmp.value, expected)
        if err.len == 0 {
            print("PASS " + name)
        } else {
            print("FAIL " + name + " " + err)
            failed += 1
        }
    }
    _ := fs.remove_all(tmp.value)
    print((sources.len - failed).str() + " passed, " + failed.str() + " failed")
    failed == 0
}

fn main() -> i32 {
    cli := harness.parse_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite(&cli) { return 1 }
    0
}
