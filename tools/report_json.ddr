import std.array as array
import std.bytes as bytes
import std.json as json

pub fn write_value(doc: &json.Doc, node: i32, writer: &mut json.Writer) -> bool {
    kind := doc.kind(node)
    if kind == .Object {
        mut keys: []string = []
        for i in 0..doc.count(node) {
            k := doc.key_at(node, i)
            if k.is_none() { return false }
            keys.push(k.unwrap())
        }
        array.sort<string>(&mut keys)
        writer.object()
        for key in keys {
            writer.key(key)
            if !write_value(&doc, doc.field(node, key), &mut writer) { return false }
        }
        writer.end()
    } else if kind == .Array {
        writer.array()
        for i in 0..doc.count(node) {
            if !write_value(&doc, doc.at(node, i), &mut writer) { return false }
        }
        writer.end()
    } else if kind == .Bool { writer.boolean(doc.as_bool(node).unwrap_or(false)) }
    else if kind == .Number {
        integer := doc.as_i64(node)
        if integer.is_some() { writer.integer(integer.unwrap()) }
        else {
            positive := doc.as_u64(node)
            if positive.is_none() { return false }
            writer.unsigned(positive.unwrap())
        }
    } else if kind == .String { writer.string(doc.as_str(node).unwrap_or("")) }
    else if kind == .Null { writer.null() }
    else { return false }
    true
}

fn utf8_width(lead: i32) -> i32 {
    if lead >= 194 && lead <= 223 { return 2 }
    if lead >= 224 && lead <= 239 { return 3 }
    if lead >= 240 && lead <= 244 { return 4 }
    0
}

pub fn text_output(raw: &[]u8) -> string {
    match bytes.decode(&raw) { .Ok(text) => { return text }, .Err(_) => {} }
    mut encoded: []u8 = []
    mut at := 0
    while at < raw.len {
        lead := i32(raw[at])
        if lead < 128 {
            encoded.push(raw[at])
            at += 1
            continue
        }
        width := utf8_width(lead)
        mut length := 1
        while length < width && at + length < raw.len {
            next := i32(raw[at + length])
            if next < 128 || next > 191 { break }
            if length == 1 && ((lead == 224 && next < 160) || (lead == 237 && next >= 160) ||
                               (lead == 240 && next < 144) || (lead == 244 && next >= 144)) { break }
            length += 1
        }
        if length == width { bytes.extend_range(&mut encoded, &raw, at, at + length) }
        else { bytes.append_utf8(&mut encoded, "�") }
        at += length
    }
    bytes.decode(&encoded).unwrap_or_default()
}
