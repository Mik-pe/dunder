fn add(a: i32, b: i32) -> i32 {
    return a + b
}

fn double(value: i32) -> i32 {
    return value * 2
}

fn negate(value: i32) -> i32 {
    return -value
}

fn choose(negative: bool) -> fn(i32) -> i32 {
    if negative {
        return negate
    }
    return double
}

fn apply(transform: fn(i32) -> i32, value: i32) -> i32 {
    return transform(value)
}

fn show(answer: i32) {
    print(answer)
    return
}

fn main() -> i32 {
    answer := add(40, 2)
    transform := choose(false)
    show(answer)
    print(apply(transform, 21))
    print(choose(true)(answer))
    return 0
}
