capability unsafe

import std.ffi as ffi

@repr(C)
struct Timespec {
    seconds: i64,
    nanos: i64,
}

@link("c")
extern "C" {
    fn strlen(s: *const ffi.c_char) -> usize
    fn snprintf(buf: *mut ffi.c_char, cap: usize, fmt: *const ffi.c_char, ...) -> ffi.c_int
    fn clock_gettime(clock: ffi.c_int, out: *mut Timespec) -> ffi.c_int
}

fn main() {
    if target_is("macos") || target_is("linux") {
        unsafe {
            len := strlen(c"dunder".as_ptr())
            assert(len == 6)

            mut buf: [ffi.c_char; 64] = [0; 64]
            written := snprintf(buf.as_mut_ptr(), 64, c"%s=%d".as_ptr(), c"len".as_ptr(), i32(len))
            assert(written == 5 && strlen(buf.as_ptr()) == 5)

            mut ts: Timespec = ffi.zeroed<Timespec>()
            clock: i32 = if target_is("macos") { 6 } else { 1 }
            assert(clock_gettime(clock, addr_of(&mut ts)) == 0)
            assert(ts.seconds >= 0 && ts.nanos >= 0 && ts.nanos < 1000000000)
        }
    }
    print("ffi ok")
}
