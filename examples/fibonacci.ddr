fn fibonacci(n: i32) -> i64 {
    var previous: i64 = 0
    var current: i64 = 1
    var i := 0
    while i < n {
        next := previous + current
        previous = current
        current = next
        i = i + 1
    }
    return previous
}

fn main() {
    n := 20
    result := fibonacci(n)
    print(result)
    print(result == 6765)
}
