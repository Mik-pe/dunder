fn fibonacci(n: i32) -> i64 {
    mut previous: i64 = 0
    mut current: i64 = 1
    for _ in 0..n {
        next := previous + current
        previous = current
        current = next
    }
    previous
}

fn main() {
    n := 20
    result := fibonacci(n)
    print(result)
    print(result == 6765)
}
