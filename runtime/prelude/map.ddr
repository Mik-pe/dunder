struct __dunder_module_map_entry<K, V> { key: K, value: V, slot: i32, hash: u64 }
opaque struct Map<K, V> where storable(K), storable(V),
    K.key_hash: fn(K) -> u64, K.key_eq: fn(K, K) -> bool {
    entries: []__dunder_module_map_entry<K, V>, slots: []i32, used: i32
}

impl Map<K, V> {
    pub fn new() -> Self { Self { entries: [], slots: [], used: 0 } }
    pub fn len(&self) -> i32 { self.entries.len }

    fn slot_for(&self, key: K, hash: u64) -> i32 {
        capacity := self.slots.len
        if capacity == 0 { return -1 }
        mut slot := i32(hash % u64(capacity))
        for _ in 0..capacity {
            index := self.slots[slot]
            if index == -1 { return -1 }
            if index >= 0 && self.entries[index].hash == hash && self.entries[index].key.key_eq(key) { return slot }
            slot = (slot + 1) % capacity
        }
        -1
    }

    fn vacant(&self, hash: u64) -> i32 {
        capacity := self.slots.len
        mut slot := i32(hash % u64(capacity))
        while self.slots[slot] >= 0 { slot = (slot + 1) % capacity }
        slot
    }

    fn rehash(&mut self, capacity: i32) {
        self.slots.clear()
        self.slots.reserve(capacity)
        for _ in 0..capacity { self.slots.push(-1) }
        for index in 0..self.entries.len {
            slot := self.vacant(self.entries[index].hash)
            self.slots[slot] = index
            self.entries[index].slot = slot
        }
        self.used = self.entries.len
    }

    pub fn reserve(&mut self, count: i32) {
        assert(count >= 0)
        self.entries.reserve(count)
        mut capacity := 8
        while i64(capacity) * 7 < i64(count) * 10 { capacity *= 2 }
        if capacity > self.slots.len { self.rehash(capacity) }
    }

    pub fn index_of(&self, key: K) -> i32 {
        slot := self.slot_for(key, key.key_hash())
        if slot >= 0 { self.slots[slot] } else { -1 }
    }
    pub fn contains(&self, key: K) -> bool { self.index_of(key) >= 0 }

    pub fn key_at(&self, index: i32) -> &K from self { &self.entries[index].key }
    pub fn value_at(&self, index: i32) -> &V from self { &self.entries[index].value }

    pub fn at(&self, key: K) -> &V from self {
        index := self.index_of(key)
        assert(index >= 0)
        &self.entries[index].value
    }

    pub fn put(&mut self, move key: K, move value: V) {
        hash := key.key_hash()
        existing := self.slot_for(key, hash)
        if existing >= 0 {
            index := self.slots[existing]
            self.entries[index].value = value
            return
        }
        capacity := self.slots.len
        if capacity == 0 { self.rehash(8) }
        else if (i64(self.used) + 1) * 10 >= i64(capacity) * 7 {
            if (i64(self.entries.len) + 1) * 10 < i64(capacity) * 4 { self.rehash(capacity) }
            else { self.rehash(capacity * 2) }
        }
        slot := self.vacant(hash)
        if self.slots[slot] == -1 { self.used += 1 }
        self.slots[slot] = self.entries.len
        self.entries.push(__dunder_module_map_entry<K, V> { key:key, value:value, slot:slot, hash:hash })
    }

    fn remove_entry(&mut self, index: i32) -> __dunder_module_map_entry<K, V> {
        last := self.entries.len - 1
        self.entries.swap(index, last)
        entry := self.entries.pop()
        self.slots[entry.slot] = -2
        if index < last { self.slots[self.entries[index].slot] = index }
        entry
    }

    pub fn take(&mut self, key: K) -> Result<V, ()> {
        index := self.index_of(key)
        if index < 0 { return .Err }
        entry := self.remove_entry(index)
        .Ok(entry.value)
    }

    fn take_key(&mut self, key: K) -> Result<K, ()> {
        index := self.index_of(key)
        self.take_key_at(index)
    }

    fn take_key_at(&mut self, index: i32) -> Result<K, ()> {
        if index < 0 || index >= self.entries.len { return .Err }
        entry := self.remove_entry(index)
        .Ok(entry.key)
    }

    pub fn remove(&mut self, key: K) -> bool {
        index := self.index_of(key)
        if index < 0 { return false }
        _ := self.remove_entry(index)
        true
    }

    pub fn clear(&mut self) {
        self.entries.clear()
        self.slots.clear()
        self.used = 0
    }
}
