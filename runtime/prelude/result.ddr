pub enum Result<T, E> { Ok(T), Err(E) }

impl Result<T, E> {
    pub fn is_ok(&self) -> bool {
        match self {
            .Ok(_) => true,
            .Err(_) => false,
        }
    }

    pub fn is_err(&self) -> bool {
        match self {
            .Ok(_) => false,
            .Err(_) => true,
        }
    }

    pub fn unwrap_or(move self, move fallback: T) -> T {
        match move self {
            .Ok(value) => value,
            .Err(_) => fallback,
        }
    }

    pub fn ok(move self) -> Option<T> {
        match move self {
            .Ok(value) => .Some(value),
            .Err(_) => .None,
        }
    }

    pub fn err(move self) -> Option<E> {
        match move self {
            .Ok(_) => .None,
            .Err(err) => .Some(err),
        }
    }
}

impl Result<T, E> where T: Storable {
    pub fn unwrap_or_else(move self, f: &mut FnMut(move E) -> T) -> T {
        match move self {
            .Ok(value) => value,
            .Err(err) => f(move err),
        }
    }
}

impl Result<T, E> where T: Default {
    pub fn unwrap_or_default(move self) -> T {
        match move self {
            .Ok(value) => value,
            .Err(_) => T::default(),
        }
    }
}

impl Eq for Result<T, E> where T: Eq, E: Eq {
    fn eq(&self, other: &Self) -> bool {
        match self {
            .Ok(a) => match other { .Ok(b) => a.eq(b), .Err(_) => false },
            .Err(a) => match other { .Ok(_) => false, .Err(b) => a.eq(b) },
        }
    }
}

impl Ord for Result<T, E> where T: Ord, E: Ord {
    fn cmp(&self, other: &Self) -> Ordering {
        match self {
            .Ok(a) => match other { .Ok(b) => a.cmp(b), .Err(_) => Ordering.Less },
            .Err(a) => match other { .Ok(_) => Ordering.Greater, .Err(b) => a.cmp(b) },
        }
    }
}

impl Hash for Result<T, E> where T: Hash, E: Hash {
    fn hash(&self) -> u64 {
        match self {
            .Ok(v) => v.hash().bit_xor(u64(11400714819323198485)),
            .Err(e) => e.hash().bit_xor(u64(14029467366897019727)),
        }
    }
}

impl Display for Result<T, E> where T: Display, E: Display {
    fn str(&self) -> string {
        match self {
            .Ok(v) => "Ok(" + v.str() + ")",
            .Err(e) => "Err(" + e.str() + ")",
        }
    }
}
