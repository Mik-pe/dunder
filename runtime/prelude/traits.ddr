    }
}
impl Display for Ordering {
    fn str(&self) -> string {
        match self {
            .Less => "Less",
            .Equal => "Equal",
            .Greater => "Greater",
        }
    }
}
impl Default for Ordering {
    fn default() -> Self { Ordering.Equal }
}

