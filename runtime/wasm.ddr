// Private scalar ABI for the Wasm emitter. Each block has an 8-byte header.
// Size classes share the linear heap between shadow frames, strings and arrays.
capability unsafe
@extern("wasm-runtime", "cursor") unsafe fn heap_cursor() -> usize
@extern("wasm-runtime", "set_cursor") unsafe fn set_heap_cursor(n:usize)
@extern("wasm-runtime", "pages") unsafe fn pages() -> usize
@extern("wasm-runtime", "grow") unsafe fn grow(n:usize) -> i32
@extern("wasm-runtime", "copy") unsafe fn copy_bytes(to:ptr, from:ptr, n:usize)
@extern("wasm-runtime", "fill") unsafe fn fill_bytes(to:ptr, byte:i32, n:usize)

unsafe fn at(p:ptr, n:usize)->ptr {ptr(usize(p)+n)}
unsafe fn alloc(n:usize)->ptr {
    assert(n<=1073741824)
    var cap:usize=16
    var bin:usize=8
    while cap<n {cap=cap*2;bin=bin+4}
    var block:=load_ptr(ptr(bin))
    if usize(block)!=0 {
        store_ptr(ptr(bin),load_ptr(at(block,4)))
    } else {
        block=ptr(heap_cursor())
        top:=usize(block)+8+cap
        required:=(top-1)/65536+1
        have:=pages()
        if required>have {assert(grow(required-have)!= -1)}
        set_heap_cursor(top)
    }
    store_usize(block,bin)
    return at(block,8)
}
unsafe fn free(p:ptr) {
    if usize(p)==0 {return}
    block:=ptr(usize(p)-8)
    bin:=load_usize(block)
    assert(bin>=8 && bin<=112)
    store_ptr(at(block,4),load_ptr(ptr(bin)))
    store_usize(block,0)
    store_ptr(ptr(bin),block)
}
unsafe fn str_retain(s:ptr)->ptr {
    if usize(s)!=0 {
        refcount:=ptr(usize(s)-8)
        n:=load_u32(refcount)
        if n!=0 {store_u32(refcount,n+1)}
    }
    return s
}
unsafe fn str_release(s:ptr) {
    if usize(s)==0 {return}
    refcount:=ptr(usize(s)-8)
    n:=load_u32(refcount)
    if n==1 {free(refcount)}
    else if n>1 {store_u32(refcount,n-1)}
}
unsafe fn str_alloc(n:usize)->ptr {
    block:=alloc(n+17)
    store_u32(block,1)
    s:=at(block,8)
    store_usize(s,n)
    store_u32(at(s,4),0)
    store_u8(at(s,n+8),0)
    return s
}
unsafe fn strlen(s:ptr)->usize {if usize(s)==0 {return 0};return load_usize(s)}
unsafe fn str_concat(a:ptr,b:ptr)->ptr {
    n:=strlen(a); m:=strlen(b); s:=str_alloc(n+m)
    if n>0 {copy_bytes(at(s,8),at(a,8),n)}
    if m>0 {copy_bytes(at(s,8+n),at(b,8),m)}
    return s
}
unsafe fn str_cmp(a:ptr,b:ptr)->i32 {
    n:=strlen(a);m:=strlen(b);var i:usize=0
    while i<n && i<m {
        x:=load_u8(at(a,8+i)); y:=load_u8(at(b,8+i))
        if x!=y {return i32(x)-i32(y)};i=i+1
    }
    if n<m {return -1};if n>m {return 1};return 0
}
unsafe fn str_slice(s:ptr, start:i32, end:i32)->ptr {
    n:=strlen(s)
    assert(start>=0 && end>=start && usize(end)<=n)
    a:=usize(start);b:=usize(end)
    if a<n {assert(load_u8(at(s,a+8)).bit_and(192)!=128)}
    if b<n {assert(load_u8(at(s,b+8)).bit_and(192)!=128)}
    result:=str_alloc(b-a)
    if a<b {copy_bytes(at(result,8),at(s,a+8),b-a)}
    return result
}
unsafe fn rune_width(byte:u8)->usize {
    if byte<128 {return 1};if byte<224 {return 2};if byte<240 {return 3};return 4
}
unsafe fn rune_at_byte(s:ptr, offset:usize)->i32 {
    p:=at(s,offset+8);first:=load_u8(p);width:=rune_width(first)
    if width==1 {return i32(first)}
    var mask:u8=31;if width==3 {mask=15}else if width==4 {mask=7}
    var cp:=i32(first.bit_and(mask))
    var j:usize=1
    while j<width {cp=cp*64+i32(load_u8(at(p,j)).bit_and(63));j=j+1}
    return cp
}
unsafe fn runes(s:ptr, ordinal:i32, length:bool)->i32 {
    n:=strlen(s);var offset:usize=0;var i:=0
    while offset<n {
        if !length && ordinal==i {return rune_at_byte(s,offset)}
        offset=offset+rune_width(load_u8(at(s,offset+8)));i=i+1
    }
    assert(length);return i
}
unsafe fn str_int(bits:u64, negative:bool)->ptr {
    var n:=bits
    if negative {n=u64(0).wrapping_sub(n)}
    var tmp:=n;var digits:usize=1
    while tmp>=10 {digits=digits+1;tmp=tmp/10}
    var size:=digits;if negative {size=size+1}
    s:=str_alloc(size);var cursor:=size+8
    while digits>0 {
        cursor=cursor-1;store_u8(at(s,cursor),48+u8(n%10))
        n=n/10;digits=digits-1
    }
    if negative {store_u8(at(s,8),45)};return s
}
unsafe fn str_rune(cp:i32)->ptr {
    assert(cp>=0 && cp<=1114111 && (cp<55296 || cp>57343))
    if cp<128 {s:=str_alloc(1);store_u8(at(s,8),u8(cp));return s}
    var n:usize=2;var prefix:=192
    if cp>=65536 {n=4;prefix=240}else if cp>=2048 {n=3;prefix=224}
    s:=str_alloc(n);var value:=cp;var i:=n
    while i>1 {i=i-1;store_u8(at(s,8+i),u8(128+value%64));value=value/64}
    store_u8(at(s,8),u8(prefix+value));return s
}
// Descriptors retain the existing 0, 8, 16 byte offsets. Their data pointer
// and usable length/capacity values fit the wasm32 address space.
unsafe fn dyn_reserve(d:ptr, n:i32, stride:usize) {
    assert(n>=0)
    want:=usize(n)
    if want<=load_usize(at(d,16)) {return}
    var cap:usize=8
    while cap<want {cap=cap*2}
    data:=alloc(cap*stride)
    old:=load_ptr(d);used:=load_usize(at(d,8))*stride
    if used>0 {copy_bytes(data,old,used)}
    free(old);store_ptr(d,data);store_usize(at(d,16),cap)
}
unsafe fn dyn_clear(d:ptr, strings:bool,stride:usize) {
    n:=load_usize(at(d,8))
    if strings {
        base:=load_ptr(d);var i:usize=0
        while i<n {str_release(load_ptr(at(base,i*stride)));i=i+1}
    }
    store_usize(at(d,8),0)
}
unsafe fn dyn_drop(d:ptr, strings:bool,stride:usize) {
    dyn_clear(d,strings,stride);free(load_ptr(d));fill_bytes(d,0,24)
}
unsafe fn dyn_clone(d:ptr, strings:bool, stride:usize) {
    src:=load_ptr(d);n:=load_usize(at(d,8))
    fill_bytes(d,0,24)
    if n==0 {return}
    data:=alloc(n*stride);copy_bytes(data,src,n*stride)
    store_ptr(d,data);store_usize(at(d,8),n);store_usize(at(d,16),n)
    if strings {var i:usize=0;while i<n {kept:=str_retain(load_ptr(at(data,i*stride)));i=i+1}}
}
fn main() {}
