// Shortest round-trip decimal formatting from IEEE bits, written in Dunder.
// Exact decimal integers describe the value and its rounding interval.
// Try increasing significant-digit counts; accept a decimal only inside
// that interval, including midpoint ties only for an even significand.
pub fn format_float_bits(raw: i64, single: bool) -> string {
    var bits := raw
    var negative := false
    var unit: i64 = 4503599627370496
    var bias := 1023
    var fraction_bits := 52
    var exponent_limit := 2047
    var precision := 17
    if single {
        unit = 8388608
        bias = 127
        fraction_bits = 23
        exponent_limit = 255
        precision = 9
        if bits >= 2147483648 { negative = true; bits = bits - 2147483648 }
    } else if bits < 0 {
        negative = true
        bits = bits - i64(-9223372036854775808)
    }
    var sign := ""
    if negative { sign = "-" }
    exponent_field := i32(bits / unit)
    if exponent_field == exponent_limit {
        if bits % unit != 0 { return "nan" }
        return sign + "inf"
    }
    if bits == 0 { return sign + "0.0" }
    var mantissa := bits % unit
    var exponent := 1 - bias - fraction_bits
    if exponent_field != 0 {
        mantissa = mantissa + unit
        exponent = exponent_field - bias - fraction_bits
    }
    even := mantissa % 2 == 0
    var digits := [0; 2400]
    var sizes := [0; 3]
    var scales := [0; 3]
    for variant in 0..3 {
        var coefficient := mantissa
        var power := exponent
        if variant == 1 {
            coefficient = mantissa * 2 - 1
            power = exponent - 1
            if mantissa == unit && exponent_field > 1 {
                coefficient = mantissa * 4 - 1
                power = exponent - 2
            }
        }
        if variant == 2 { coefficient = mantissa * 2 + 1; power = exponent - 1 }
        base := variant * 800
        var size := 0
        while coefficient != 0 {
            digits[base + size] = i32(coefficient % 10)
            coefficient = coefficient / 10
            size = size + 1
        }
        var factor := 2
        var steps := power
        if power < 0 { factor = 5; steps = -power; scales[variant] = -power }
        for step in 0..steps {
            var carry := 0
            for j in 0..size {
                next := digits[base + j] * factor + carry
                digits[base + j] = next % 10
                carry = next / 10
            }
            if carry != 0 { digits[base + size] = carry; size = size + 1 }
        }
        sizes[variant] = size
    }
    var prefix: i64 = 0
    var chosen: i64 = 0
    var decimal_power := 0
    var found := false
    for count in 1..precision + 1 {
        value_index := sizes[0] - count
        var digit := 0
        if value_index >= 0 { digit = digits[value_index] }
        prefix = prefix * 10 + i64(digit)
        var round_up := false
        if value_index > 0 {
            next := digits[value_index - 1]
            var tail := false
            for j in 0..value_index - 1 { if digits[j] != 0 { tail = true } }
            round_up = next > 5 || (next == 5 && (tail || prefix % 2 != 0))
        }
        power := sizes[0] - scales[0] - count
        for attempt in 0..2 {
            var candidate := prefix
            if (attempt == 0 && round_up) || (attempt == 1 && !round_up) { candidate = candidate + 1 }
            spelling := candidate.str()
            var accepted := true
            for boundary in 1..3 {
                order := spelling.len + power
                bound_order := sizes[boundary] - scales[boundary]
                var comparison := 0
                if order < bound_order { comparison = -1 }
                if order > bound_order { comparison = 1 }
                if order == bound_order {
                    var length := sizes[boundary]
                    if spelling.len > length { length = spelling.len }
                    for j in 0..length {
                        var a := 0
                        var b := 0
                        if j < spelling.len { a = spelling[j] - 48 }
                        if j < sizes[boundary] { b = digits[boundary * 800 + sizes[boundary] - 1 - j] }
                        if a < b { comparison = -1; break }
                        if a > b { comparison = 1; break }
                    }
                }
                if boundary == 1 && (comparison < 0 || (comparison == 0 && !even)) { accepted = false }
                if boundary == 2 && (comparison > 0 || (comparison == 0 && !even)) { accepted = false }
            }
            if accepted { chosen = candidate; decimal_power = power; found = true; break }
        }
        if found { break }
    }
    assert(found)
    while chosen % 10 == 0 { chosen = chosen / 10; decimal_power = decimal_power + 1 }
    spelling := chosen.str()
    order := spelling.len + decimal_power - 1
    if order < -4 || order >= 16 {
        var result := sign + spelling[0..1]
        if spelling.len > 1 { result = result + "." + spelling[1..spelling.len] }
        result = result + "e"
        if order >= 0 { result = result + "+" }
        return result + order.str()
    }
    if decimal_power >= 0 {
        var result := sign + spelling
        for i in 0..decimal_power { result = result + "0" }
        return result + ".0"
    }
    point := spelling.len + decimal_power
    if point > 0 { return sign + spelling[0..point] + "." + spelling[point..spelling.len] }
    var result := sign + "0."
    for i in 0..-point { result = result + "0" }
    result + spelling
}
