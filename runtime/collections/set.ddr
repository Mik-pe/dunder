opaque struct SpecSet { table: SpecBacking }

impl SpecSet {
    pub fn new() -> Self { Self { table: SpecBacking::new() } }
    pub fn len(&self) -> i32 { self.table.len() }
    pub fn reserve(&mut self, count: i32) { self.table.reserve(count) }
    pub fn contains(&self, key: SpecKey) -> bool { self.table.contains(key) }
    pub fn at(&self, index: i32) -> &SpecKey from self { self.table.key_at(index) }

    pub fn insert(&mut self, move key: SpecKey) -> bool {
        if self.table.contains(key) { return false }
        self.table.put(move key, true)
        true
    }

    pub fn take(&mut self, key: SpecKey) -> Result<SpecKey, ()> { self.table.take_key(key) }
    pub fn take_at(&mut self, index: i32) -> Result<SpecKey, ()> { self.table.take_key_at(index) }
    pub fn remove(&mut self, key: SpecKey) -> bool { self.table.remove(key) }
    pub fn clear(&mut self) { self.table.clear() }
}
