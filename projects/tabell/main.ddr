import sys
import report

fn main() -> i32 {
    if sys.arg_count() == 2 && sys.arg(1) == "--help" {
        print("Usage: tabell FILE.csv GROUP_COLUMN SUM_COLUMN\nGroup CSV rows and sum signed i64 amounts. Output columns: group,total.")
        return 0
    }
    if sys.arg_count() != 4 {
        diagnostic := sys.eprint("Usage: tabell FILE.csv GROUP_COLUMN SUM_COLUMN")
        return 2
    }
    path := sys.arg(1)
    source := sys.read_text(path)
    if !source.ok {
        diagnostic := sys.eprint("tabell: " + path + ": " + sys.error_message(source.error))
        return 1
    }
    result := report.summarize(source.value, sys.arg(2), sys.arg(3))
    if !result.ok {
        diagnostic := sys.eprint("tabell: line " + result.line.str() + ": " + result.error)
        return 1
    }
    print(result.output)
    0
}
