import std.bytes

// Read one record at a time; quoted fields may span physical lines.
pub struct Reader { source: string, cursor: i32, line: i32 }
pub struct Row {
    ok: bool,
    done: bool,
    fields: []string,
    line: i32,
    error: string,
}

pub fn reader(source: string) -> Reader {
    var cursor := 0
    if source.len >= 3 && source[0] == 239 && source[1] == 187 && source[2] == 191 {
        cursor = 3
    }
    Reader { source: source, cursor: cursor, line: 1 }
}

fn decoded(field: &[]i32) -> string {
    result := bytes.utf8(&field)
    assert(result.ok)
    result.value
}

fn invalid(line: i32, message: string) -> Row {
    Row { ok: false, done: false, fields: [], line: line, error: message }
}

pub fn next(input: &mut Reader) -> Row {
    if input.cursor == input.source.len {
        return Row { ok: true, done: true, fields: [], line: input.line, error: "" }
    }
    start_line := input.line
    var fields: []string = []
    var field: []i32 = []
    // 0=start of field, 1=unquoted field, 2=quoted field, 3=closing quote seen.
    var state := 0
    while input.cursor < input.source.len {
        byte := input.source[input.cursor]
        if state == 2 {
            if byte == 34 {
                if input.cursor + 1 < input.source.len && input.source[input.cursor + 1] == 34 {
                    field.push(34)
                    input.cursor = input.cursor + 2
                } else {
                    state = 3
                    input.cursor = input.cursor + 1
                }
            } else if byte == 13 || byte == 10 {
                field.push(byte)
                input.cursor = input.cursor + 1
                if byte == 13 && input.cursor < input.source.len && input.source[input.cursor] == 10 {
                    field.push(10)
                    input.cursor = input.cursor + 1
                }
                input.line = input.line + 1
            } else {
                field.push(byte)
                input.cursor = input.cursor + 1
            }
        } else if byte == 44 {
            fields.push(decoded(&field))
            field.clear()
            state = 0
            input.cursor = input.cursor + 1
        } else if byte == 13 || byte == 10 {
            fields.push(decoded(&field))
            input.cursor = input.cursor + 1
            if byte == 13 && input.cursor < input.source.len && input.source[input.cursor] == 10 {
                input.cursor = input.cursor + 1
            }
            input.line = input.line + 1
            return Row { ok: true, done: false, fields: fields, line: start_line, error: "" }
        } else if state == 3 {
            return invalid(input.line, "unexpected character after closing quote")
        } else if byte == 34 {
            if state != 0 { return invalid(input.line, "quote inside an unquoted field") }
            state = 2
            input.cursor = input.cursor + 1
        } else {
            field.push(byte)
            state = 1
            input.cursor = input.cursor + 1
        }
    }
    if state == 2 { return invalid(input.line, "unterminated quoted field") }
    fields.push(decoded(&field))
    Row { ok: true, done: false, fields: fields, line: start_line, error: "" }
}

pub fn write_field(output: &mut []i32, value: string) {
    var quoted := false
    for byte in value.bytes() {
        if byte == 44 || byte == 34 || byte == 10 || byte == 13 { quoted = true }
    }
    if quoted { output.push(34) }
    for byte in value.bytes() {
        output.push(byte)
        if quoted && byte == 34 { output.push(34) }
    }
    if quoted { output.push(34) }
}

@test fn csv_quotes_newlines_empty_fields_and_eof() {
    var input := reader("a,b,c\r\n\"å,🌍\",\"say \"\"hej\"\"\",\"one\r\ntwo\"\r\n,,")
    header := next(&mut input)
    header.ok && !header.done && header.fields.len == 3 && header.line == 1
    row := next(&mut input)
    row.ok && row.fields.len == 3 && row.line == 2
    row.fields[0] == "å,🌍"
    row.fields[1] == "say \"hej\""
    row.fields[2] == "one\r\ntwo"
    blank := next(&mut input)
    blank.ok && blank.fields.len == 3 && blank.line == 4
    blank.fields[0] == "" && blank.fields[1] == "" && blank.fields[2] == ""
    next(&mut input).done
}

@test fn csv_bom_and_malformed_records() {
    var bom := reader("\u{feff}a,b\n")
    next(&mut bom).fields[0] == "a"
    next(&mut bom).done
    bad: []string = ["\"unfinished", "x\"y,z", "\"closed\"x,z", "\"a\" \n"]
    for source in bad {
        var input := reader(source)
        !next(&mut input).ok
    }
    var empty := reader("")
    next(&mut empty).done
    var quoted := reader("\"\"")
    next(&mut quoted).fields[0] == ""
}

@test fn csv_writer_round_trips_special_fields() {
    values: []string = ["", "plain", "å 🌍", "a,b", "say \"hej\"", "a\nb", "a\rb", "a\0b"]
    for value in values {
        var output: []i32 = []
        write_field(&mut output, value)
        // A comma keeps the empty first field distinguishable from an empty file.
        output.push(44)
        var input := reader(decoded(&output))
        row := next(&mut input)
        row.ok && row.fields.len == 2
        row.fields[0] == value
    }
}
