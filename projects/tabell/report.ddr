import csv
import std.map
import std.array
import std.bytes
import std.parse

pub struct Report { ok: bool, output: string, line: i32, error: string }

fn invalid(line: i32, message: string) -> Report {
    Report { ok: false, output: "", line: line, error: message }
}

fn decimal(value: string) -> parse.Integer {
    if value.len == 0 { return parse.Integer { ok: false, value: 0, error: 1 } }
    var start := 0
    if value[0] == 43 || value[0] == 45 { start = 1 }
    if start == value.len { return parse.Integer { ok: false, value: 0, error: 1 } }
    for i in start..value.len {
        if value[i] < 48 || value[i] > 57 {
            return parse.Integer { ok: false, value: 0, error: 1 }
        }
    }
    parse.integer(value)
}

fn fits(left: i64, right: i64) -> bool {
    if right > 0 { return left <= 9223372036854775807 - right }
    if right < 0 { return left >= -9223372036854775808 - right }
    true
}

pub fn summarize(source: string, group_column: string, sum_column: string) -> Report {
    var input := csv.reader(source)
    header := csv.next(&mut input)
    if !header.ok { return invalid(header.line, header.error) }
    if header.done { return invalid(1, "CSV header is missing") }
    var seen := map.new()
    var group_index := -1
    var sum_index := -1
    for i in 0..header.fields.len {
        name := header.fields[i]
        if name.len == 0 { return invalid(1, "empty column name") }
        if map.contains(&seen, name) { return invalid(1, "duplicate column: " + name) }
        map.put(&mut seen, name, i64(i))
        if name == group_column { group_index = i }
        if name == sum_column { sum_index = i }
    }
    if group_index < 0 { return invalid(1, "column not found: " + group_column) }
    if sum_index < 0 { return invalid(1, "column not found: " + sum_column) }
    var totals := map.new()
    while true {
        row := csv.next(&mut input)
        if !row.ok { return invalid(row.line, row.error) }
        if row.done { break }
        if row.fields.len != header.fields.len {
            return invalid(row.line, "expected " + header.fields.len.str() + " fields, got " + row.fields.len.str())
        }
        amount := decimal(row.fields[sum_index])
        if !amount.ok {
            if amount.error == 2 { return invalid(row.line, "integer out of i64 range in column " + sum_column) }
            return invalid(row.line, "invalid integer in column " + sum_column)
        }
        group := row.fields[group_index]
        previous := map.get_or(&totals, group, 0)
        if !fits(previous, amount.value) { return invalid(row.line, "group total exceeds i64 range") }
        map.put(&mut totals, group, previous + amount.value)
    }
    var groups := map.keys(&totals)
    array.sort_strings(&mut groups)
    var output: []i32 = []
    bytes.append_text(&mut output, "group,total")
    for group in groups {
        output.push(10)
        csv.write_field(&mut output, group)
        output.push(44)
        bytes.append_text(&mut output, map.get_or(&totals, group, 0).str())
    }
    decoded := bytes.utf8(&output)
    assert(decoded.ok)
    Report { ok: true, output: decoded.value, line: 0, error: "" }
}

@test fn reports_group_sort_and_escape_utf8() {
    source := "team,cents,note\nÖrebro,25,x\nAlpha,-2,y\n\"Team, A\",3,z\nAlpha,12,w\n"
    result := summarize(source, "team", "cents")
    result.ok
    result.output == "group,total\nAlpha,10\n\"Team, A\",3\nÖrebro,25"
    summarize("team,cents\n", "team", "cents").output == "group,total"
    summarize("team,cents\n,2\n,3", "team", "cents").output == "group,total\n,5"
}

@test fn reports_reject_invalid_headers_rows_and_amounts() {
    !summarize("", "team", "cents").ok
    !summarize("team,team\n", "team", "team").ok
    !summarize("team,\n", "team", "").ok
    !summarize("team,cents\n", "missing", "cents").ok
    !summarize("team,cents\n", "team", "missing").ok
    !summarize("team,cents\na,1,extra", "team", "cents").ok
    !summarize("team,cents\na", "team", "cents").ok
    bad: []string = ["", "+", " 2", "2 ", "1_000", "1.2", "å", "9223372036854775808", "-9223372036854775809"]
    for amount in bad { !summarize("team,cents\na," + amount, "team", "cents").ok }
    malformed := summarize("team,cents\n\"unterminated", "team", "cents")
    !malformed.ok && malformed.line == 2 && malformed.output == ""
}

@test fn reports_detect_overflow_before_publishing() {
    maximum := summarize("team,cents\na,9223372036854775807\na,0", "team", "cents")
    maximum.ok && maximum.output == "group,total\na,9223372036854775807"
    minimum := summarize("team,cents\na,-9223372036854775808", "team", "cents")
    minimum.ok && minimum.output == "group,total\na,-9223372036854775808"
    positive := summarize("team,cents\na,9223372036854775807\na,1", "team", "cents")
    !positive.ok && positive.line == 3 && positive.output == ""
    negative := summarize("team,cents\na,-9223372036854775808\na,-1", "team", "cents")
    !negative.ok && negative.line == 3
    summarize("team,cents\na,-9223372036854775808\na,9223372036854775807", "team", "cents").output == "group,total\na,-1"
}
